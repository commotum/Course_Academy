  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/id #uuid \"108afb82-07aa-5829-92db-533a4a1bdee4\"] [:db/add \"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/type :answer.type/math] [:db/add \"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/validate] [:db/add \"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/id #uuid \"d3c656a2-a96b-50c8-930c-79df5dc92847\"] [:db/add \"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/key \"field-1\"] [:db/add \"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/type :answer-field.type/blank] [:db/add \"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/choices \"108afb82-07aa-5829-92db-533a4a1bdee4\"] [:db/add \"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/correct \"108afb82-07aa-5829-92db-533a4a1bdee4\"] [:db/ensure \"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/validate] [:db/add \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/id #uuid \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\"] [:db/add \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 3 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 3 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/difficulty :question.difficulty/easy] [:db/add \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/answer-fields \"d3c656a2-a96b-50c8-930c-79df5dc92847\"] [:db/ensure \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\"] [:db/add \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/id #uuid \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\"] [:db/add \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/type :answer.type/math] [:db/add \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/value \"- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(5 x \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/validate] [:db/add \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/id #uuid \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\"] [:db/add \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/key \"field-1\"] [:db/add \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/type :answer-field.type/blank] [:db/add \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/choices \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\"] [:db/add \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/correct \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\"] [:db/ensure \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/validate] [:db/add \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/id #uuid \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\"] [:db/add \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\cos{\\\\left(5 x \\\\right)}}{\\\\sin{\\\\left(5 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(5 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5 \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\cos{\\\\left(5 x \\\\right)}}{\\\\sin{\\\\left(5 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(5 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/difficulty :question.difficulty/easy] [:db/add \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/answer-fields \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\"] [:db/ensure \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\"] [:db/add \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/id #uuid \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\"] [:db/add \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/type :answer.type/math] [:db/add \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/value \"-2\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/validate] [:db/add \"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/id #uuid \"02bebe9d-1e9c-5670-8559-3f4e479a7833\"] [:db/add \"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/key \"field-1\"] [:db/add \"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/type :answer-field.type/blank] [:db/add \"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/choices \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\"] [:db/add \"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/correct \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\"] [:db/ensure \"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/validate] [:db/add \"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/id #uuid \"a8cca768-4d1c-5860-a67e-55a670ba3a27\"] [:db/add \"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{8 \\\\sin{\\\\left(4 x \\\\right)}}{\\\\cos{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(4 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 4 \\\\sin{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{8 \\\\sin{\\\\left(4 x \\\\right)}}{\\\\cos{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/difficulty :question.difficulty/easy] [:db/add \"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/answer-fields \"02bebe9d-1e9c-5670-8559-3f4e479a7833\"] [:db/ensure \"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"a8cca768-4d1c-5860-a67e-55a670ba3a27\"] [:db/add \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/id #uuid \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\"] [:db/add \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/type :answer.type/math] [:db/add \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/validate] [:db/add \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/id #uuid \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\"] [:db/add \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/key \"field-1\"] [:db/add \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/type :answer-field.type/blank] [:db/add \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/choices \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\"] [:db/add \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/correct \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\"] [:db/ensure \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/validate] [:db/add \"bd806ccf-016b-540c-abc3-e432791013a0\" :question/id #uuid \"bd806ccf-016b-540c-abc3-e432791013a0\"] [:db/add \"bd806ccf-016b-540c-abc3-e432791013a0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{6 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"bd806ccf-016b-540c-abc3-e432791013a0\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 4 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{6 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"bd806ccf-016b-540c-abc3-e432791013a0\" :question/difficulty :question.difficulty/easy] [:db/add \"bd806ccf-016b-540c-abc3-e432791013a0\" :question/answer-fields \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\"] [:db/ensure \"bd806ccf-016b-540c-abc3-e432791013a0\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"bd806ccf-016b-540c-abc3-e432791013a0\"] [:db/add \"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/id #uuid \"750d6834-4969-5e8e-b1a6-653a022f84a6\"] [:db/add \"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/type :answer.type/math] [:db/add \"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/validate] [:db/add \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/id #uuid \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\"] [:db/add \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/key \"field-1\"] [:db/add \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/type :answer-field.type/blank] [:db/add \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/choices \"750d6834-4969-5e8e-b1a6-653a022f84a6\"] [:db/add \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/correct \"750d6834-4969-5e8e-b1a6-653a022f84a6\"] [:db/ensure \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/validate] [:db/add \"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/id #uuid \"3107f410-73e0-556c-972e-d2e0e2ce60a1\"] [:db/add \"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/difficulty :question.difficulty/easy] [:db/add \"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/answer-fields \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\"] [:db/ensure \"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"3107f410-73e0-556c-972e-d2e0e2ce60a1\"] [:db/add \"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/id #uuid \"b30378af-9e64-5862-9388-b0ac09f501e1\"] [:db/add \"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/type :answer.type/math] [:db/add \"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/validate] [:db/add \"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/id #uuid \"67c3da68-4eda-5884-aa69-139b3f7565ce\"] [:db/add \"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/key \"field-1\"] [:db/add \"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/type :answer-field.type/blank] [:db/add \"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/choices \"b30378af-9e64-5862-9388-b0ac09f501e1\"] [:db/add \"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/correct \"b30378af-9e64-5862-9388-b0ac09f501e1\"] [:db/ensure \"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/validate] [:db/add \"74afbb13-580e-502a-aebe-96d884b75a04\" :question/id #uuid \"74afbb13-580e-502a-aebe-96d884b75a04\"] [:db/add \"74afbb13-580e-502a-aebe-96d884b75a04\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x \\\\right)}}{\\\\sin{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"74afbb13-580e-502a-aebe-96d884b75a04\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(4 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\cos{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x \\\\right)}}{\\\\sin{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"74afbb13-580e-502a-aebe-96d884b75a04\" :question/difficulty :question.difficulty/easy] [:db/add \"74afbb13-580e-502a-aebe-96d884b75a04\" :question/answer-fields \"67c3da68-4eda-5884-aa69-139b3f7565ce\"] [:db/ensure \"74afbb13-580e-502a-aebe-96d884b75a04\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"74afbb13-580e-502a-aebe-96d884b75a04\"] [:db/add \"33508499-ed71-5b55-9836-8de60b78372c\" :answer/id #uuid \"33508499-ed71-5b55-9836-8de60b78372c\"] [:db/add \"33508499-ed71-5b55-9836-8de60b78372c\" :answer/type :answer.type/math] [:db/add \"33508499-ed71-5b55-9836-8de60b78372c\" :answer/value \"\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(3 x \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"33508499-ed71-5b55-9836-8de60b78372c\" :answer/validate] [:db/add \"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/id #uuid \"45939e87-0a0a-5c0b-91e7-263eff72a11d\"] [:db/add \"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/key \"field-1\"] [:db/add \"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/type :answer-field.type/blank] [:db/add \"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/choices \"33508499-ed71-5b55-9836-8de60b78372c\"] [:db/add \"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/correct \"33508499-ed71-5b55-9836-8de60b78372c\"] [:db/ensure \"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/validate] [:db/add \"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/id #uuid \"c6d6cd27-37d2-58db-bac2-18138e4d4737\"] [:db/add \"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 5 \\\\sin{\\\\left(3 x \\\\right)}}{\\\\cos{\\\\left(3 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(3 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 3 \\\\sin{\\\\left(3 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 5 \\\\sin{\\\\left(3 x \\\\right)}}{\\\\cos{\\\\left(3 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{5}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{5}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(3 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/difficulty :question.difficulty/easy] [:db/add \"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/answer-fields \"45939e87-0a0a-5c0b-91e7-263eff72a11d\"] [:db/ensure \"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"c6d6cd27-37d2-58db-bac2-18138e4d4737\"] [:db/add \"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/id #uuid \"f889d838-03c2-5ae0-8c66-22e111d47a66\"] [:db/add \"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/type :answer.type/math] [:db/add \"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [:db/ensure \"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/validate] [:db/add \"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/id #uuid \"8bd37964-9015-5064-9fbe-2e52274439c3\"] [:db/add \"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/key \"field-1\"] [:db/add \"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/type :answer-field.type/blank] [:db/add \"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/choices \"f889d838-03c2-5ae0-8c66-22e111d47a66\"] [:db/add \"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/correct \"f889d838-03c2-5ae0-8c66-22e111d47a66\"] [:db/ensure \"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/validate] [:db/add \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/id #uuid \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\"] [:db/add \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 2 \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/difficulty :question.difficulty/easy] [:db/add \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/answer-fields \"8bd37964-9015-5064-9fbe-2e52274439c3\"] [:db/ensure \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\"] [:db/add \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/id #uuid \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\"] [:db/add \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/type :answer.type/math] [:db/add \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/value \"- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5\\\\right|\\\\right)\"] [:db/ensure \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/validate] [:db/add \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/id #uuid \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\"] [:db/add \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/key \"field-1\"] [:db/add \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/type :answer-field.type/blank] [:db/add \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/choices \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\"] [:db/add \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/correct \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\"] [:db/ensure \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/validate] [:db/add \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/id #uuid \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\"] [:db/add \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}}{2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/worked-solution \"Let $u=2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 16 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}}{2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/difficulty :question.difficulty/moderate] [:db/add \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/answer-fields \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\"] [:db/ensure \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\"] [:db/add \"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/id #uuid \"ba872194-8fd3-555d-b72c-661799e80ea9\"] [:db/add \"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/type :answer.type/math] [:db/add \"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/value \"- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\"] [:db/ensure \"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/validate] [:db/add \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/id #uuid \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\"] [:db/add \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/key \"field-1\"] [:db/add \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/type :answer-field.type/blank] [:db/add \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/choices \"ba872194-8fd3-555d-b72c-661799e80ea9\"] [:db/add \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/correct \"ba872194-8fd3-555d-b72c-661799e80ea9\"] [:db/ensure \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/validate] [:db/add \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/id #uuid \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\"] [:db/add \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 9 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/worked-solution \"Let $u=4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=16 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 9 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{9}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{9}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/difficulty :question.difficulty/moderate] [:db/add \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/answer-fields \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\"] [:db/ensure \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\"] [:db/add \"3e5390db-5116-5562-a668-6167295df915\" :answer/id #uuid \"3e5390db-5116-5562-a668-6167295df915\"] [:db/add \"3e5390db-5116-5562-a668-6167295df915\" :answer/type :answer.type/math] [:db/add \"3e5390db-5116-5562-a668-6167295df915\" :answer/value \"- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|3 \\\\tan{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"3e5390db-5116-5562-a668-6167295df915\" :answer/validate] [:db/add \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/id #uuid \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\"] [:db/add \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/key \"field-1\"] [:db/add \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/type :answer-field.type/blank] [:db/add \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/choices \"3e5390db-5116-5562-a668-6167295df915\"] [:db/add \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/correct \"3e5390db-5116-5562-a668-6167295df915\"] [:db/ensure \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/validate] [:db/add \"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/id #uuid \"ff200dd1-fe83-56c2-99de-32813b5e0f55\"] [:db/add \"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\sec^{2}{\\\\left(5 x \\\\right)}}{3 \\\\tan{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/worked-solution \"Let $u=3 \\\\tan{\\\\left(5 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=15 \\\\sec^{2}{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\sec^{2}{\\\\left(5 x \\\\right)}}{3 \\\\tan{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|3 \\\\tan{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/difficulty :question.difficulty/moderate] [:db/add \"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/answer-fields \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\"] [:db/ensure \"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"ff200dd1-fe83-56c2-99de-32813b5e0f55\"] [:db/add \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/id #uuid \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\"] [:db/add \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/type :answer.type/math] [:db/add \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/value \"- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4\\\\right|\\\\right)\"] [:db/ensure \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/validate] [:db/add \"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/id #uuid \"33486198-73f6-503a-b8bb-2e256c2fda6d\"] [:db/add \"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/key \"field-1\"] [:db/add \"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/type :answer-field.type/blank] [:db/add \"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/choices \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\"] [:db/add \"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/correct \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\"] [:db/ensure \"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/validate] [:db/add \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/id #uuid \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\"] [:db/add \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/worked-solution \"Let $u=3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 36 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{36}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{36}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/difficulty :question.difficulty/moderate] [:db/add \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/answer-fields \"33486198-73f6-503a-b8bb-2e256c2fda6d\"] [:db/ensure \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\"] [:db/add \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/id #uuid \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\"] [:db/add \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/type :answer.type/math] [:db/add \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/value \"- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\"] [:db/ensure \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/validate] [:db/add \"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/id #uuid \"a907b5be-b375-5822-96b0-7411cf15610d\"] [:db/add \"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/key \"field-1\"] [:db/add \"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/type :answer-field.type/blank] [:db/add \"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/choices \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\"] [:db/add \"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/correct \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\"] [:db/ensure \"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/validate] [:db/add \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/id #uuid \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\"] [:db/add \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/worked-solution \"Let $u=3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 30 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/difficulty :question.difficulty/moderate] [:db/add \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/answer-fields \"a907b5be-b375-5822-96b0-7411cf15610d\"] [:db/ensure \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\"] [:db/add \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/id #uuid \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\"] [:db/add \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/type :answer.type/math] [:db/add \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\"] [:db/ensure \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/validate] [:db/add \"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/id #uuid \"ee098494-f33c-59b7-b94e-0fafab3d0352\"] [:db/add \"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/key \"field-1\"] [:db/add \"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/type :answer-field.type/blank] [:db/add \"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/choices \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\"] [:db/add \"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/correct \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\"] [:db/ensure \"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/validate] [:db/add \"80742553-f898-5e65-bfb0-514b09ac805c\" :question/id #uuid \"80742553-f898-5e65-bfb0-514b09ac805c\"] [:db/add \"80742553-f898-5e65-bfb0-514b09ac805c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"80742553-f898-5e65-bfb0-514b09ac805c\" :question/worked-solution \"Let $u=3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=24 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"80742553-f898-5e65-bfb0-514b09ac805c\" :question/difficulty :question.difficulty/moderate] [:db/add \"80742553-f898-5e65-bfb0-514b09ac805c\" :question/answer-fields \"ee098494-f33c-59b7-b94e-0fafab3d0352\"] [:db/ensure \"80742553-f898-5e65-bfb0-514b09ac805c\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"80742553-f898-5e65-bfb0-514b09ac805c\"] [:db/add \"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/id #uuid \"b5f95172-21b8-5321-9277-26491c7d5476\"] [:db/add \"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/type :answer.type/math] [:db/add \"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/value \"- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\"] [:db/ensure \"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/validate] [:db/add \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/id #uuid \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\"] [:db/add \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/key \"field-1\"] [:db/add \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/type :answer-field.type/blank] [:db/add \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/choices \"b5f95172-21b8-5321-9277-26491c7d5476\"] [:db/add \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/correct \"b5f95172-21b8-5321-9277-26491c7d5476\"] [:db/ensure \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/validate] [:db/add \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/id #uuid \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\"] [:db/add \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{7 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}}{\\\\csc{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 2 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{7 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}}{\\\\csc{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/difficulty :question.difficulty/moderate] [:db/add \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/answer-fields \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\"] [:db/ensure \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\"] [:db/add \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/id #uuid \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\"] [:db/add \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/type :answer.type/math] [:db/add \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/value \"- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|2 \\\\sec{\\\\left(5 x \\\\right)} + 5\\\\right|\\\\right)\"] [:db/ensure \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/validate] [:db/add \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/id #uuid \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\"] [:db/add \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/key \"field-1\"] [:db/add \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/type :answer-field.type/blank] [:db/add \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/choices \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\"] [:db/add \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/correct \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\"] [:db/ensure \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/validate] [:db/add \"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/id #uuid \"6864c6d3-f922-56eb-9ad3-b877d706345d\"] [:db/add \"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 7 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}}{2 \\\\sec{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/worked-solution \"Let $u=2 \\\\sec{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=10 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 7 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}}{2 \\\\sec{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|2 \\\\sec{\\\\left(5 x \\\\right)} + 5\\\\right|\\\\right)+C.\\n$$\"] [:db/add \"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/difficulty :question.difficulty/moderate] [:db/add \"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/answer-fields \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\"] [:db/ensure \"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"6864c6d3-f922-56eb-9ad3-b877d706345d\"] [:db/add \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/id #uuid \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\"] [:db/add \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/type :answer.type/math] [:db/add \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{9}\\\\right)\\\\right)\"] [:db/ensure \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/validate] [:db/add \"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/id #uuid \"6ad6f867-c4de-57ca-867b-905db4c575e7\"] [:db/add \"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/key \"field-1\"] [:db/add \"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/type :answer-field.type/blank] [:db/add \"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/choices \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\"] [:db/add \"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/correct \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\"] [:db/ensure \"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/validate] [:db/add \"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/id #uuid \"afc505b2-eb23-556b-b4bb-186a13d68208\"] [:db/add \"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{24}} \\\\frac{- 4 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [:db/add \"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/worked-solution \"Let $u=4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=32 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\pi}{24}&\\\\Longrightarrow u=\\\\frac{13}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{24}} \\\\frac{- 4 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{8}\\\\left(\\\\int_{3}^{\\\\frac{13}{3}} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{\\\\frac{13}{3}}\\\\right)=- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{3}\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{9}\\\\right)\\\\right).\\n$$\"] [:db/add \"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/difficulty :question.difficulty/hard] [:db/add \"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/answer-fields \"6ad6f867-c4de-57ca-867b-905db4c575e7\"] [:db/ensure \"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"afc505b2-eb23-556b-b4bb-186a13d68208\"] [:db/add \"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/id #uuid \"a94eddf6-1425-58d6-a235-ddad7d086b2c\"] [:db/add \"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/type :answer.type/math] [:db/add \"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/value \"- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(\\\\frac{11}{3 + 4 \\\\sqrt{2}}\\\\right)\\\\right)\"] [:db/ensure \"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/validate] [:db/add \"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/id #uuid \"900ffda1-c3be-5455-8830-200e5e62cdd6\"] [:db/add \"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/key \"field-1\"] [:db/add \"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/type :answer-field.type/blank] [:db/add \"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/choices \"a94eddf6-1425-58d6-a235-ddad7d086b2c\"] [:db/add \"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/correct \"a94eddf6-1425-58d6-a235-ddad7d086b2c\"] [:db/ensure \"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/validate] [:db/add \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/id #uuid \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\"] [:db/add \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{6}} \\\\frac{- 7 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}}{4 \\\\sec{\\\\left(2 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [:db/add \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/worked-solution \"Let $u=4 \\\\sec{\\\\left(2 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=3 + 4 \\\\sqrt{2}\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=11\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{6}} \\\\frac{- 7 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}}{4 \\\\sec{\\\\left(2 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{8}\\\\left(\\\\int_{3 + 4 \\\\sqrt{2}}^{11} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{7}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3 + 4 \\\\sqrt{2}}^{11}\\\\right)=- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(11\\\\right)-\\\\ln\\\\left(3 + 4 \\\\sqrt{2}\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(\\\\frac{11}{3 + 4 \\\\sqrt{2}}\\\\right)\\\\right).\\n$$\"] [:db/add \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/difficulty :question.difficulty/hard] [:db/add \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/answer-fields \"900ffda1-c3be-5455-8830-200e5e62cdd6\"] [:db/ensure \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\"] [:db/add \"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/id #uuid \"1fd79a3a-dabb-5107-8381-850631f7217c\"] [:db/add \"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/type :answer.type/math] [:db/add \"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{9}{5}\\\\right)\\\\right)\"] [:db/ensure \"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/validate] [:db/add \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/id #uuid \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\"] [:db/add \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/key \"field-1\"] [:db/add \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/type :answer-field.type/blank] [:db/add \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/choices \"1fd79a3a-dabb-5107-8381-850631f7217c\"] [:db/add \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/correct \"1fd79a3a-dabb-5107-8381-850631f7217c\"] [:db/ensure \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/validate] [:db/add \"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/id #uuid \"1892def1-facb-5b2a-adbe-376640d37b4e\"] [:db/add \"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{10}} \\\\frac{- 5 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [:db/add \"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/worked-solution \"Let $u=4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=40 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=5\\\\\\\\x=\\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=9\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{10}} \\\\frac{- 5 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{8}\\\\left(\\\\int_{5}^{9} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{5}^{9}\\\\right)=- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(5\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{9}{5}\\\\right)\\\\right).\\n$$\"] [:db/add \"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/difficulty :question.difficulty/hard] [:db/add \"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/answer-fields \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\"] [:db/ensure \"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"1892def1-facb-5b2a-adbe-376640d37b4e\"] [:db/add \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/id #uuid \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\"] [:db/add \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/type :answer.type/math] [:db/add \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(\\\\frac{6}{7}\\\\right)\\\\right)\"] [:db/ensure \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/validate] [:db/add \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/id #uuid \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\"] [:db/add \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/key \"field-1\"] [:db/add \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/type :answer-field.type/blank] [:db/add \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/choices \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\"] [:db/add \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/correct \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\"] [:db/ensure \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/validate] [:db/add \"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/id #uuid \"ef1173f3-df57-500d-84bc-a6ebe384b05c\"] [:db/add \"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{30}}^{\\\\frac{\\\\pi}{10}} \\\\frac{3 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}}{\\\\csc{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [:db/add \"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 5 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{30}&\\\\Longrightarrow u=7\\\\\\\\x=\\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=6\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{30}}^{\\\\frac{\\\\pi}{10}} \\\\frac{3 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}}{\\\\csc{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{5}\\\\left(\\\\int_{7}^{6} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{5}\\\\left(\\\\left[\\\\ln u\\\\right]_{7}^{6}\\\\right)=- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(6\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(\\\\frac{6}{7}\\\\right)\\\\right).\\n$$\"] [:db/add \"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/difficulty :question.difficulty/hard] [:db/add \"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/answer-fields \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\"] [:db/ensure \"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"ef1173f3-df57-500d-84bc-a6ebe384b05c\"] [:db/add \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/id #uuid \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\"] [:db/add \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/type :answer.type/math] [:db/add \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/value \"- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(\\\\frac{5}{8}\\\\right)\\\\right)\"] [:db/ensure \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/validate] [:db/add \"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/id #uuid \"4278d7ed-fc23-59ba-9e70-1886365f8541\"] [:db/add \"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/key \"field-1\"] [:db/add \"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/type :answer-field.type/blank] [:db/add \"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/choices \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\"] [:db/add \"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/correct \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\"] [:db/ensure \"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/validate] [:db/add \"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/id #uuid \"e036cff3-c45f-5085-9516-dfa7e50ba67f\"] [:db/add \"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{8}} \\\\frac{7 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [:db/add \"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/worked-solution \"Let $u=3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 36 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=8\\\\\\\\x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{8}} \\\\frac{7 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{36}\\\\left(\\\\int_{8}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{7}{36}\\\\left(\\\\left[\\\\ln u\\\\right]_{8}^{5}\\\\right)=- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(\\\\frac{5}{8}\\\\right)\\\\right).\\n$$\"] [:db/add \"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/difficulty :question.difficulty/hard] [:db/add \"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/answer-fields \"4278d7ed-fc23-59ba-9e70-1886365f8541\"] [:db/ensure \"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"e036cff3-c45f-5085-9516-dfa7e50ba67f\"] [:db/add \"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/id #uuid \"7eefa18c-1953-51cb-bd13-36a64b329850\"] [:db/add \"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/type :answer.type/math] [:db/add \"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/value \"- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(\\\\frac{1}{2}\\\\right)\\\\right)\"] [:db/ensure \"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/validate] [:db/add \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/id #uuid \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\"] [:db/add \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/key \"field-1\"] [:db/add \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/type :answer-field.type/blank] [:db/add \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/choices \"7eefa18c-1953-51cb-bd13-36a64b329850\"] [:db/add \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/correct \"7eefa18c-1953-51cb-bd13-36a64b329850\"] [:db/ensure \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/validate] [:db/add \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/id #uuid \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\"] [:db/add \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} \\\\frac{3 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}}{4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [:db/add \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/worked-solution \"Let $u=4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 16 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=8\\\\\\\\x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} \\\\frac{3 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}}{4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{16}\\\\left(\\\\int_{8}^{4} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{16}\\\\left(\\\\left[\\\\ln u\\\\right]_{8}^{4}\\\\right)=- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(4\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(\\\\frac{1}{2}\\\\right)\\\\right).\\n$$\"] [:db/add \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/difficulty :question.difficulty/hard] [:db/add \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/answer-fields \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\"] [:db/ensure \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\"] [:db/add \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/id #uuid \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\"] [:db/add \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/type :answer.type/math] [:db/add \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/value \"- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(\\\\frac{5}{3}\\\\right)\\\\right)\"] [:db/ensure \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/validate] [:db/add \"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/id #uuid \"0ad22e38-745f-532b-9c6f-88d37bae9b52\"] [:db/add \"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/key \"field-1\"] [:db/add \"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/type :answer-field.type/blank] [:db/add \"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/choices \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\"] [:db/add \"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/correct \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\"] [:db/ensure \"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/validate] [:db/add \"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/id #uuid \"b4a85ff2-6d2d-574f-934b-31afc699e06c\"] [:db/add \"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\sqrt{\\\\pi}}{4}} \\\\frac{- 6 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}}{2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [:db/add \"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/worked-solution \"Let $u=2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=16 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\sqrt{\\\\pi}}{4}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\sqrt{\\\\pi}}{4}} \\\\frac{- 6 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}}{2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{8}\\\\left(\\\\int_{3}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{5}\\\\right)=- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(\\\\frac{5}{3}\\\\right)\\\\right).\\n$$\"] [:db/add \"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/difficulty :question.difficulty/hard] [:db/add \"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/answer-fields \"0ad22e38-745f-532b-9c6f-88d37bae9b52\"] [:db/ensure \"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"b4a85ff2-6d2d-574f-934b-31afc699e06c\"] [:db/add \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/id #uuid \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\"] [:db/add \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/type :answer.type/math] [:db/add \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\tan{\\\\left(4 x \\\\right)} + 2-2\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\\\\right)\"] [:db/ensure \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/validate] [:db/add \"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/id #uuid \"aab7748b-d307-575f-a1ca-60b716c8fe2e\"] [:db/add \"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/key \"field-1\"] [:db/add \"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/type :answer-field.type/blank] [:db/add \"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/choices \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\"] [:db/add \"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/correct \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\"] [:db/ensure \"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/validate] [:db/add \"31af3e89-444a-5351-ab86-623f9917660d\" :question/id #uuid \"31af3e89-444a-5351-ab86-623f9917660d\"] [:db/add \"31af3e89-444a-5351-ab86-623f9917660d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{\\\\tan{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [:db/add \"31af3e89-444a-5351-ab86-623f9917660d\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(4 x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSince $\\\\tan{\\\\left(4 x \\\\right)}=u-2$, the remaining quotient is\\n\\n$$\\n\\\\frac{u-2}{u}=1-\\\\frac{2}{u}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{\\\\tan{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int 1 - \\\\frac{2}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\int 1 - \\\\frac{2}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{4}\\\\left(u-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\tan{\\\\left(4 x \\\\right)} + 2-2\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\\\\right)+C.\\n$$\"] [:db/add \"31af3e89-444a-5351-ab86-623f9917660d\" :question/difficulty :question.difficulty/hard] [:db/add \"31af3e89-444a-5351-ab86-623f9917660d\" :question/answer-fields \"aab7748b-d307-575f-a1ca-60b716c8fe2e\"] [:db/ensure \"31af3e89-444a-5351-ab86-623f9917660d\" :question/validate] [:db/add 17592186068918 :knowledge-point/questions \"31af3e89-444a-5351-ab86-623f9917660d\"] [:db/add \"generator\" :question-generator/id #uuid \"0410c7a8-bc55-5402-b03c-564f9f5071d7\"] [:db/add \"generator\" :question-generator/script \"generators/4b/4b2e25b742b9774b1ca671527404155a24785563eb88306aece872c5951d48a5/generator.py\"] [:db/add 17592186068918 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186068918 :knowledge-point/validate]] \"assertions\" [[\"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/id #uuid \"108afb82-07aa-5829-92db-533a4a1bdee4\"] [\"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/type :answer.type/math] [\"108afb82-07aa-5829-92db-533a4a1bdee4\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [\"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/id #uuid \"d3c656a2-a96b-50c8-930c-79df5dc92847\"] [\"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/key \"field-1\"] [\"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/type :answer-field.type/blank] [\"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/choices \"108afb82-07aa-5829-92db-533a4a1bdee4\"] [\"d3c656a2-a96b-50c8-930c-79df5dc92847\" :answer-field/correct \"108afb82-07aa-5829-92db-533a4a1bdee4\"] [\"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/id #uuid \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\"] [\"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 3 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 3 \\\\cos{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(2 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/difficulty :question.difficulty/easy] [\"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\" :question/answer-fields \"d3c656a2-a96b-50c8-930c-79df5dc92847\"] [17592186068918 :knowledge-point/questions \"d18d2d0d-fcf4-5a07-8a57-6df7fafbc007\"] [\"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/id #uuid \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\"] [\"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/type :answer.type/math] [\"1781e2dd-9f8d-516f-8851-d2ce8c04531a\" :answer/value \"- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(5 x \\\\right)}\\\\right|\\\\right)\"] [\"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/id #uuid \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\"] [\"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/key \"field-1\"] [\"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/type :answer-field.type/blank] [\"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/choices \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\"] [\"a684ef73-2cee-5b36-8f8b-9f7e97862a21\" :answer-field/correct \"1781e2dd-9f8d-516f-8851-d2ce8c04531a\"] [\"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/id #uuid \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\"] [\"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\cos{\\\\left(5 x \\\\right)}}{\\\\sin{\\\\left(5 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(5 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5 \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\cos{\\\\left(5 x \\\\right)}}{\\\\sin{\\\\left(5 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{6}{5}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(5 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/difficulty :question.difficulty/easy] [\"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\" :question/answer-fields \"a684ef73-2cee-5b36-8f8b-9f7e97862a21\"] [17592186068918 :knowledge-point/questions \"85f9dec2-2bed-5b96-9584-ac2b0b6c1efc\"] [\"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/id #uuid \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\"] [\"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/type :answer.type/math] [\"3a88d3f8-c8dd-572a-9d01-aa79fca55046\" :answer/value \"-2\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\"] [\"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/id #uuid \"02bebe9d-1e9c-5670-8559-3f4e479a7833\"] [\"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/key \"field-1\"] [\"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/type :answer-field.type/blank] [\"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/choices \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\"] [\"02bebe9d-1e9c-5670-8559-3f4e479a7833\" :answer-field/correct \"3a88d3f8-c8dd-572a-9d01-aa79fca55046\"] [\"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/id #uuid \"a8cca768-4d1c-5860-a67e-55a670ba3a27\"] [\"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{8 \\\\sin{\\\\left(4 x \\\\right)}}{\\\\cos{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(4 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 4 \\\\sin{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{8 \\\\sin{\\\\left(4 x \\\\right)}}{\\\\cos{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/difficulty :question.difficulty/easy] [\"a8cca768-4d1c-5860-a67e-55a670ba3a27\" :question/answer-fields \"02bebe9d-1e9c-5670-8559-3f4e479a7833\"] [17592186068918 :knowledge-point/questions \"a8cca768-4d1c-5860-a67e-55a670ba3a27\"] [\"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/id #uuid \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\"] [\"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/type :answer.type/math] [\"2c95693f-2a78-56bb-95f9-a66f2650f9d7\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [\"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/id #uuid \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\"] [\"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/key \"field-1\"] [\"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/type :answer-field.type/blank] [\"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/choices \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\"] [\"069ae5f6-7161-5806-b00a-7d25ff5a6e31\" :answer-field/correct \"2c95693f-2a78-56bb-95f9-a66f2650f9d7\"] [\"bd806ccf-016b-540c-abc3-e432791013a0\" :question/id #uuid \"bd806ccf-016b-540c-abc3-e432791013a0\"] [\"bd806ccf-016b-540c-abc3-e432791013a0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{6 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"bd806ccf-016b-540c-abc3-e432791013a0\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 4 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{6 \\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"bd806ccf-016b-540c-abc3-e432791013a0\" :question/difficulty :question.difficulty/easy] [\"bd806ccf-016b-540c-abc3-e432791013a0\" :question/answer-fields \"069ae5f6-7161-5806-b00a-7d25ff5a6e31\"] [17592186068918 :knowledge-point/questions \"bd806ccf-016b-540c-abc3-e432791013a0\"] [\"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/id #uuid \"750d6834-4969-5e8e-b1a6-653a022f84a6\"] [\"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/type :answer.type/math] [\"750d6834-4969-5e8e-b1a6-653a022f84a6\" :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [\"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/id #uuid \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\"] [\"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/key \"field-1\"] [\"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/type :answer-field.type/blank] [\"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/choices \"750d6834-4969-5e8e-b1a6-653a022f84a6\"] [\"e336733f-ee9e-54b8-9050-d4b000b0a6fa\" :answer-field/correct \"750d6834-4969-5e8e-b1a6-653a022f84a6\"] [\"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/id #uuid \"3107f410-73e0-556c-972e-d2e0e2ce60a1\"] [\"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/difficulty :question.difficulty/easy] [\"3107f410-73e0-556c-972e-d2e0e2ce60a1\" :question/answer-fields \"e336733f-ee9e-54b8-9050-d4b000b0a6fa\"] [17592186068918 :knowledge-point/questions \"3107f410-73e0-556c-972e-d2e0e2ce60a1\"] [\"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/id #uuid \"b30378af-9e64-5862-9388-b0ac09f501e1\"] [\"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/type :answer.type/math] [\"b30378af-9e64-5862-9388-b0ac09f501e1\" :answer/value \"\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x \\\\right)}\\\\right|\\\\right)\"] [\"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/id #uuid \"67c3da68-4eda-5884-aa69-139b3f7565ce\"] [\"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/key \"field-1\"] [\"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/type :answer-field.type/blank] [\"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/choices \"b30378af-9e64-5862-9388-b0ac09f501e1\"] [\"67c3da68-4eda-5884-aa69-139b3f7565ce\" :answer-field/correct \"b30378af-9e64-5862-9388-b0ac09f501e1\"] [\"74afbb13-580e-502a-aebe-96d884b75a04\" :question/id #uuid \"74afbb13-580e-502a-aebe-96d884b75a04\"] [\"74afbb13-580e-502a-aebe-96d884b75a04\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x \\\\right)}}{\\\\sin{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"74afbb13-580e-502a-aebe-96d884b75a04\" :question/worked-solution \"Let $u=\\\\sin{\\\\left(4 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\cos{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\cos{\\\\left(4 x \\\\right)}}{\\\\sin{\\\\left(4 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{9}{4}\\\\left(\\\\ln\\\\left|\\\\sin{\\\\left(4 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"74afbb13-580e-502a-aebe-96d884b75a04\" :question/difficulty :question.difficulty/easy] [\"74afbb13-580e-502a-aebe-96d884b75a04\" :question/answer-fields \"67c3da68-4eda-5884-aa69-139b3f7565ce\"] [17592186068918 :knowledge-point/questions \"74afbb13-580e-502a-aebe-96d884b75a04\"] [\"33508499-ed71-5b55-9836-8de60b78372c\" :answer/id #uuid \"33508499-ed71-5b55-9836-8de60b78372c\"] [\"33508499-ed71-5b55-9836-8de60b78372c\" :answer/type :answer.type/math] [\"33508499-ed71-5b55-9836-8de60b78372c\" :answer/value \"\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(3 x \\\\right)}\\\\right|\\\\right)\"] [\"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/id #uuid \"45939e87-0a0a-5c0b-91e7-263eff72a11d\"] [\"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/key \"field-1\"] [\"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/type :answer-field.type/blank] [\"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/choices \"33508499-ed71-5b55-9836-8de60b78372c\"] [\"45939e87-0a0a-5c0b-91e7-263eff72a11d\" :answer-field/correct \"33508499-ed71-5b55-9836-8de60b78372c\"] [\"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/id #uuid \"c6d6cd27-37d2-58db-bac2-18138e4d4737\"] [\"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 5 \\\\sin{\\\\left(3 x \\\\right)}}{\\\\cos{\\\\left(3 x \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(3 x \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 3 \\\\sin{\\\\left(3 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 5 \\\\sin{\\\\left(3 x \\\\right)}}{\\\\cos{\\\\left(3 x \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{5}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{5}{3}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{5}{3}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(3 x \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/difficulty :question.difficulty/easy] [\"c6d6cd27-37d2-58db-bac2-18138e4d4737\" :question/answer-fields \"45939e87-0a0a-5c0b-91e7-263eff72a11d\"] [17592186068918 :knowledge-point/questions \"c6d6cd27-37d2-58db-bac2-18138e4d4737\"] [\"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/id #uuid \"f889d838-03c2-5ae0-8c66-22e111d47a66\"] [\"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/type :answer.type/math] [\"f889d838-03c2-5ae0-8c66-22e111d47a66\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)\"] [\"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/id #uuid \"8bd37964-9015-5064-9fbe-2e52274439c3\"] [\"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/key \"field-1\"] [\"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/type :answer-field.type/blank] [\"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/choices \"f889d838-03c2-5ae0-8c66-22e111d47a66\"] [\"8bd37964-9015-5064-9fbe-2e52274439c3\" :answer-field/correct \"f889d838-03c2-5ae0-8c66-22e111d47a66\"] [\"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/id #uuid \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\"] [\"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/worked-solution \"Let $u=\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 2 \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- \\\\sin{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|\\\\cos{\\\\left(2 x - \\\\frac{\\\\pi}{6} \\\\right)}\\\\right|\\\\right)+C.\\n$$\"] [\"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/difficulty :question.difficulty/easy] [\"02afba5b-6298-5f27-a3bd-f58e8fe06b67\" :question/answer-fields \"8bd37964-9015-5064-9fbe-2e52274439c3\"] [17592186068918 :knowledge-point/questions \"02afba5b-6298-5f27-a3bd-f58e8fe06b67\"] [\"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/id #uuid \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\"] [\"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/type :answer.type/math] [\"69bcd6d2-c71b-5ab8-9a79-87c67636a907\" :answer/value \"- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5\\\\right|\\\\right)\"] [\"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/id #uuid \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\"] [\"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/key \"field-1\"] [\"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/type :answer-field.type/blank] [\"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/choices \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\"] [\"777376a0-3c60-5f8b-b5e0-9b879194c0d7\" :answer-field/correct \"69bcd6d2-c71b-5ab8-9a79-87c67636a907\"] [\"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/id #uuid \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\"] [\"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}}{2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/worked-solution \"Let $u=2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 16 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5 \\\\cot{\\\\left(4 x \\\\right)} \\\\csc^{2}{\\\\left(4 x \\\\right)}}{2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{5}{16}\\\\left(\\\\ln\\\\left|2 \\\\cot^{2}{\\\\left(4 x \\\\right)} + 5\\\\right|\\\\right)+C.\\n$$\"] [\"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/difficulty :question.difficulty/moderate] [\"a2a645f1-bf99-5a74-a0e5-18e8d6774434\" :question/answer-fields \"777376a0-3c60-5f8b-b5e0-9b879194c0d7\"] [17592186068918 :knowledge-point/questions \"a2a645f1-bf99-5a74-a0e5-18e8d6774434\"] [\"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/id #uuid \"ba872194-8fd3-555d-b72c-661799e80ea9\"] [\"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/type :answer.type/math] [\"ba872194-8fd3-555d-b72c-661799e80ea9\" :answer/value \"- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\"] [\"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/id #uuid \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\"] [\"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/key \"field-1\"] [\"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/type :answer-field.type/blank] [\"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/choices \"ba872194-8fd3-555d-b72c-661799e80ea9\"] [\"cd29a3c0-4a2f-5105-a406-bf870fb3962f\" :answer-field/correct \"ba872194-8fd3-555d-b72c-661799e80ea9\"] [\"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/id #uuid \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\"] [\"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 9 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/worked-solution \"Let $u=4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=16 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 9 \\\\sin{\\\\left(2 x \\\\right)} \\\\cos{\\\\left(2 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{9}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{9}{16}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{9}{16}\\\\left(\\\\ln\\\\left|4 \\\\sin^{2}{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"] [\"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/difficulty :question.difficulty/moderate] [\"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\" :question/answer-fields \"cd29a3c0-4a2f-5105-a406-bf870fb3962f\"] [17592186068918 :knowledge-point/questions \"0c4ef409-febd-5faa-ad6d-4b74d9f54cc5\"] [\"3e5390db-5116-5562-a668-6167295df915\" :answer/id #uuid \"3e5390db-5116-5562-a668-6167295df915\"] [\"3e5390db-5116-5562-a668-6167295df915\" :answer/type :answer.type/math] [\"3e5390db-5116-5562-a668-6167295df915\" :answer/value \"- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|3 \\\\tan{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\"] [\"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/id #uuid \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\"] [\"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/key \"field-1\"] [\"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/type :answer-field.type/blank] [\"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/choices \"3e5390db-5116-5562-a668-6167295df915\"] [\"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\" :answer-field/correct \"3e5390db-5116-5562-a668-6167295df915\"] [\"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/id #uuid \"ff200dd1-fe83-56c2-99de-32813b5e0f55\"] [\"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\sec^{2}{\\\\left(5 x \\\\right)}}{3 \\\\tan{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/worked-solution \"Let $u=3 \\\\tan{\\\\left(5 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=15 \\\\sec^{2}{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\sec^{2}{\\\\left(5 x \\\\right)}}{3 \\\\tan{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\ln\\\\left|3 \\\\tan{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/difficulty :question.difficulty/moderate] [\"ff200dd1-fe83-56c2-99de-32813b5e0f55\" :question/answer-fields \"91c359bc-a2a5-559a-a927-f5ea7dd2bf36\"] [17592186068918 :knowledge-point/questions \"ff200dd1-fe83-56c2-99de-32813b5e0f55\"] [\"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/id #uuid \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\"] [\"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/type :answer.type/math] [\"e82deb29-5eec-5d80-8648-e95dbb2dc25e\" :answer/value \"- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4\\\\right|\\\\right)\"] [\"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/id #uuid \"33486198-73f6-503a-b8bb-2e256c2fda6d\"] [\"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/key \"field-1\"] [\"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/type :answer-field.type/blank] [\"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/choices \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\"] [\"33486198-73f6-503a-b8bb-2e256c2fda6d\" :answer-field/correct \"e82deb29-5eec-5d80-8648-e95dbb2dc25e\"] [\"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/id #uuid \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\"] [\"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/worked-solution \"Let $u=3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 36 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{36}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{36}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{5}{36}\\\\left(\\\\ln\\\\left|3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"] [\"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/difficulty :question.difficulty/moderate] [\"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\" :question/answer-fields \"33486198-73f6-503a-b8bb-2e256c2fda6d\"] [17592186068918 :knowledge-point/questions \"8783cedb-a9ef-5b45-ae64-c8d4a06e861f\"] [\"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/id #uuid \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\"] [\"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/type :answer.type/math] [\"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\" :answer/value \"- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)\"] [\"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/id #uuid \"a907b5be-b375-5822-96b0-7411cf15610d\"] [\"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/key \"field-1\"] [\"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/type :answer-field.type/blank] [\"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/choices \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\"] [\"a907b5be-b375-5822-96b0-7411cf15610d\" :answer-field/correct \"aedbaf5f-c7c0-5f86-a67a-e13ab60ef615\"] [\"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/id #uuid \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\"] [\"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{9 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/worked-solution \"Let $u=3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 30 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{9 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{10}\\\\left(\\\\ln\\\\left|3 \\\\cos^{2}{\\\\left(5 x \\\\right)} + 3\\\\right|\\\\right)+C.\\n$$\"] [\"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/difficulty :question.difficulty/moderate] [\"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\" :question/answer-fields \"a907b5be-b375-5822-96b0-7411cf15610d\"] [17592186068918 :knowledge-point/questions \"3f2d23a6-bc05-5891-a41a-a0ec9b709b67\"] [\"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/id #uuid \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\"] [\"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/type :answer.type/math] [\"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\"] [\"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/id #uuid \"ee098494-f33c-59b7-b94e-0fafab3d0352\"] [\"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/key \"field-1\"] [\"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/type :answer-field.type/blank] [\"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/choices \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\"] [\"ee098494-f33c-59b7-b94e-0fafab3d0352\" :answer-field/correct \"06cf4afd-d7f8-51b6-91c4-df6686bb24bb\"] [\"80742553-f898-5e65-bfb0-514b09ac805c\" :question/id #uuid \"80742553-f898-5e65-bfb0-514b09ac805c\"] [\"80742553-f898-5e65-bfb0-514b09ac805c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 6 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"80742553-f898-5e65-bfb0-514b09ac805c\" :question/worked-solution \"Let $u=3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=24 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 6 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\ln\\\\left|3 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)+C.\\n$$\"] [\"80742553-f898-5e65-bfb0-514b09ac805c\" :question/difficulty :question.difficulty/moderate] [\"80742553-f898-5e65-bfb0-514b09ac805c\" :question/answer-fields \"ee098494-f33c-59b7-b94e-0fafab3d0352\"] [17592186068918 :knowledge-point/questions \"80742553-f898-5e65-bfb0-514b09ac805c\"] [\"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/id #uuid \"b5f95172-21b8-5321-9277-26491c7d5476\"] [\"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/type :answer.type/math] [\"b5f95172-21b8-5321-9277-26491c7d5476\" :answer/value \"- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)\"] [\"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/id #uuid \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\"] [\"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/key \"field-1\"] [\"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/type :answer-field.type/blank] [\"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/choices \"b5f95172-21b8-5321-9277-26491c7d5476\"] [\"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\" :answer-field/correct \"b5f95172-21b8-5321-9277-26491c7d5476\"] [\"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/id #uuid \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\"] [\"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{7 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}}{\\\\csc{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 2 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{7 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}}{\\\\csc{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7}{2}\\\\left(\\\\ln\\\\left|\\\\csc{\\\\left(2 x \\\\right)} + 4\\\\right|\\\\right)+C.\\n$$\"] [\"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/difficulty :question.difficulty/moderate] [\"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\" :question/answer-fields \"dfc81122-c29c-505e-b9f1-0c7b7aaa7f80\"] [17592186068918 :knowledge-point/questions \"1d16dcd1-db05-5c2e-982a-f9fdb9432f85\"] [\"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/id #uuid \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\"] [\"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/type :answer.type/math] [\"8a89fb17-7727-5d3f-bb4c-9699e30d529d\" :answer/value \"- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|2 \\\\sec{\\\\left(5 x \\\\right)} + 5\\\\right|\\\\right)\"] [\"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/id #uuid \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\"] [\"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/key \"field-1\"] [\"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/type :answer-field.type/blank] [\"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/choices \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\"] [\"f9366ac6-a00f-592f-9b86-7a32fb585c4a\" :answer-field/correct \"8a89fb17-7727-5d3f-bb4c-9699e30d529d\"] [\"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/id #uuid \"6864c6d3-f922-56eb-9ad3-b877d706345d\"] [\"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- 7 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}}{2 \\\\sec{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/worked-solution \"Let $u=2 \\\\sec{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=10 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- 7 \\\\tan{\\\\left(5 x \\\\right)} \\\\sec{\\\\left(5 x \\\\right)}}{2 \\\\sec{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{10}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7}{10}\\\\left(\\\\ln\\\\left|2 \\\\sec{\\\\left(5 x \\\\right)} + 5\\\\right|\\\\right)+C.\\n$$\"] [\"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/difficulty :question.difficulty/moderate] [\"6864c6d3-f922-56eb-9ad3-b877d706345d\" :question/answer-fields \"f9366ac6-a00f-592f-9b86-7a32fb585c4a\"] [17592186068918 :knowledge-point/questions \"6864c6d3-f922-56eb-9ad3-b877d706345d\"] [\"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/id #uuid \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\"] [\"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/type :answer.type/math] [\"3c831a5f-58a0-5dce-a633-b588a9bbfa48\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{9}\\\\right)\\\\right)\"] [\"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/id #uuid \"6ad6f867-c4de-57ca-867b-905db4c575e7\"] [\"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/key \"field-1\"] [\"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/type :answer-field.type/blank] [\"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/choices \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\"] [\"6ad6f867-c4de-57ca-867b-905db4c575e7\" :answer-field/correct \"3c831a5f-58a0-5dce-a633-b588a9bbfa48\"] [\"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/id #uuid \"afc505b2-eb23-556b-b4bb-186a13d68208\"] [\"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{24}} \\\\frac{- 4 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [\"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/worked-solution \"Let $u=4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=32 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\pi}{24}&\\\\Longrightarrow u=\\\\frac{13}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{24}} \\\\frac{- 4 \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{4 \\\\tan^{2}{\\\\left(4 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{8}\\\\left(\\\\int_{3}^{\\\\frac{13}{3}} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{\\\\frac{13}{3}}\\\\right)=- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{3}\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{13}{9}\\\\right)\\\\right).\\n$$\"] [\"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/difficulty :question.difficulty/hard] [\"afc505b2-eb23-556b-b4bb-186a13d68208\" :question/answer-fields \"6ad6f867-c4de-57ca-867b-905db4c575e7\"] [17592186068918 :knowledge-point/questions \"afc505b2-eb23-556b-b4bb-186a13d68208\"] [\"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/id #uuid \"a94eddf6-1425-58d6-a235-ddad7d086b2c\"] [\"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/type :answer.type/math] [\"a94eddf6-1425-58d6-a235-ddad7d086b2c\" :answer/value \"- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(\\\\frac{11}{3 + 4 \\\\sqrt{2}}\\\\right)\\\\right)\"] [\"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/id #uuid \"900ffda1-c3be-5455-8830-200e5e62cdd6\"] [\"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/key \"field-1\"] [\"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/type :answer-field.type/blank] [\"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/choices \"a94eddf6-1425-58d6-a235-ddad7d086b2c\"] [\"900ffda1-c3be-5455-8830-200e5e62cdd6\" :answer-field/correct \"a94eddf6-1425-58d6-a235-ddad7d086b2c\"] [\"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/id #uuid \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\"] [\"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{6}} \\\\frac{- 7 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}}{4 \\\\sec{\\\\left(2 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [\"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/worked-solution \"Let $u=4 \\\\sec{\\\\left(2 x \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=3 + 4 \\\\sqrt{2}\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=11\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{6}} \\\\frac{- 7 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}}{4 \\\\sec{\\\\left(2 x \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{8}\\\\left(\\\\int_{3 + 4 \\\\sqrt{2}}^{11} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{7}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3 + 4 \\\\sqrt{2}}^{11}\\\\right)=- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(11\\\\right)-\\\\ln\\\\left(3 + 4 \\\\sqrt{2}\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{7}{8}\\\\left(\\\\ln\\\\left(\\\\frac{11}{3 + 4 \\\\sqrt{2}}\\\\right)\\\\right).\\n$$\"] [\"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/difficulty :question.difficulty/hard] [\"046e63fb-5a4e-50f5-a8d9-2f71bedde598\" :question/answer-fields \"900ffda1-c3be-5455-8830-200e5e62cdd6\"] [17592186068918 :knowledge-point/questions \"046e63fb-5a4e-50f5-a8d9-2f71bedde598\"] [\"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/id #uuid \"1fd79a3a-dabb-5107-8381-850631f7217c\"] [\"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/type :answer.type/math] [\"1fd79a3a-dabb-5107-8381-850631f7217c\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{9}{5}\\\\right)\\\\right)\"] [\"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/id #uuid \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\"] [\"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/key \"field-1\"] [\"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/type :answer-field.type/blank] [\"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/choices \"1fd79a3a-dabb-5107-8381-850631f7217c\"] [\"1e9873d4-75e4-5c47-9787-4995cb8c94fb\" :answer-field/correct \"1fd79a3a-dabb-5107-8381-850631f7217c\"] [\"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/id #uuid \"1892def1-facb-5b2a-adbe-376640d37b4e\"] [\"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{10}} \\\\frac{- 5 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [\"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/worked-solution \"Let $u=4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=40 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=5\\\\\\\\x=\\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=9\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{10}} \\\\frac{- 5 \\\\sin{\\\\left(5 x \\\\right)} \\\\cos{\\\\left(5 x \\\\right)}}{4 \\\\sin^{2}{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{8}\\\\left(\\\\int_{5}^{9} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{5}^{9}\\\\right)=- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(5\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{1}{8}\\\\left(\\\\ln\\\\left(\\\\frac{9}{5}\\\\right)\\\\right).\\n$$\"] [\"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/difficulty :question.difficulty/hard] [\"1892def1-facb-5b2a-adbe-376640d37b4e\" :question/answer-fields \"1e9873d4-75e4-5c47-9787-4995cb8c94fb\"] [17592186068918 :knowledge-point/questions \"1892def1-facb-5b2a-adbe-376640d37b4e\"] [\"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/id #uuid \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\"] [\"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/type :answer.type/math] [\"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\" :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(\\\\frac{6}{7}\\\\right)\\\\right)\"] [\"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/id #uuid \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\"] [\"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/key \"field-1\"] [\"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/type :answer-field.type/blank] [\"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/choices \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\"] [\"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\" :answer-field/correct \"ee1ea4d1-ebd2-5960-99c5-42e133a1f2d0\"] [\"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/id #uuid \"ef1173f3-df57-500d-84bc-a6ebe384b05c\"] [\"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{30}}^{\\\\frac{\\\\pi}{10}} \\\\frac{3 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}}{\\\\csc{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [\"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/worked-solution \"Let $u=\\\\csc{\\\\left(5 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 5 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{30}&\\\\Longrightarrow u=7\\\\\\\\x=\\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=6\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{30}}^{\\\\frac{\\\\pi}{10}} \\\\frac{3 \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}}{\\\\csc{\\\\left(5 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{5}\\\\left(\\\\int_{7}^{6} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{5}\\\\left(\\\\left[\\\\ln u\\\\right]_{7}^{6}\\\\right)=- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(6\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{5}\\\\left(\\\\ln\\\\left(\\\\frac{6}{7}\\\\right)\\\\right).\\n$$\"] [\"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/difficulty :question.difficulty/hard] [\"ef1173f3-df57-500d-84bc-a6ebe384b05c\" :question/answer-fields \"c28a2fd8-bb61-5eb7-b6e4-f05bd195b60e\"] [17592186068918 :knowledge-point/questions \"ef1173f3-df57-500d-84bc-a6ebe384b05c\"] [\"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/id #uuid \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\"] [\"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/type :answer.type/math] [\"4ed2e109-2fdc-545a-92d0-cde0858b7f62\" :answer/value \"- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(\\\\frac{5}{8}\\\\right)\\\\right)\"] [\"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/id #uuid \"4278d7ed-fc23-59ba-9e70-1886365f8541\"] [\"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/key \"field-1\"] [\"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/type :answer-field.type/blank] [\"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/choices \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\"] [\"4278d7ed-fc23-59ba-9e70-1886365f8541\" :answer-field/correct \"4ed2e109-2fdc-545a-92d0-cde0858b7f62\"] [\"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/id #uuid \"e036cff3-c45f-5085-9516-dfa7e50ba67f\"] [\"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{8}} \\\\frac{7 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [\"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/worked-solution \"Let $u=3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 36 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=8\\\\\\\\x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{8}} \\\\frac{7 \\\\sin{\\\\left(4 x \\\\right)} \\\\cos^{2}{\\\\left(4 x \\\\right)}}{3 \\\\cos^{3}{\\\\left(4 x \\\\right)} + 5}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{36}\\\\left(\\\\int_{8}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{7}{36}\\\\left(\\\\left[\\\\ln u\\\\right]_{8}^{5}\\\\right)=- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{7}{36}\\\\left(\\\\ln\\\\left(\\\\frac{5}{8}\\\\right)\\\\right).\\n$$\"] [\"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/difficulty :question.difficulty/hard] [\"e036cff3-c45f-5085-9516-dfa7e50ba67f\" :question/answer-fields \"4278d7ed-fc23-59ba-9e70-1886365f8541\"] [17592186068918 :knowledge-point/questions \"e036cff3-c45f-5085-9516-dfa7e50ba67f\"] [\"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/id #uuid \"7eefa18c-1953-51cb-bd13-36a64b329850\"] [\"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/type :answer.type/math] [\"7eefa18c-1953-51cb-bd13-36a64b329850\" :answer/value \"- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(\\\\frac{1}{2}\\\\right)\\\\right)\"] [\"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/id #uuid \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\"] [\"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/key \"field-1\"] [\"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/type :answer-field.type/blank] [\"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/choices \"7eefa18c-1953-51cb-bd13-36a64b329850\"] [\"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\" :answer-field/correct \"7eefa18c-1953-51cb-bd13-36a64b329850\"] [\"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/id #uuid \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\"] [\"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} \\\\frac{3 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}}{4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [\"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/worked-solution \"Let $u=4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- 16 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=8\\\\\\\\x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} \\\\frac{3 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc^{2}{\\\\left(2 x \\\\right)}}{4 \\\\cot^{2}{\\\\left(2 x \\\\right)} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{16}\\\\left(\\\\int_{8}^{4} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{16}\\\\left(\\\\left[\\\\ln u\\\\right]_{8}^{4}\\\\right)=- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(4\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{16}\\\\left(\\\\ln\\\\left(\\\\frac{1}{2}\\\\right)\\\\right).\\n$$\"] [\"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/difficulty :question.difficulty/hard] [\"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\" :question/answer-fields \"b0f62e20-9626-5c5d-8afe-b26bc1a6ab7c\"] [17592186068918 :knowledge-point/questions \"e43e7b17-97a3-5745-a8dc-5da2f3be6e02\"] [\"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/id #uuid \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\"] [\"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/type :answer.type/math] [\"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\" :answer/value \"- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(\\\\frac{5}{3}\\\\right)\\\\right)\"] [\"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/id #uuid \"0ad22e38-745f-532b-9c6f-88d37bae9b52\"] [\"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/key \"field-1\"] [\"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/type :answer-field.type/blank] [\"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/choices \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\"] [\"0ad22e38-745f-532b-9c6f-88d37bae9b52\" :answer-field/correct \"fa860e43-7ad5-5b4b-bc93-ba4ab7a582d8\"] [\"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/id #uuid \"b4a85ff2-6d2d-574f-934b-31afc699e06c\"] [\"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\sqrt{\\\\pi}}{4}} \\\\frac{- 6 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}}{2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\"] [\"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/worked-solution \"Let $u=2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=16 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=3\\\\\\\\x=\\\\frac{\\\\sqrt{\\\\pi}}{4}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\sqrt{\\\\pi}}{4}} \\\\frac{- 6 x \\\\sec^{2}{\\\\left(4 x^{2} \\\\right)}}{2 \\\\tan{\\\\left(4 x^{2} \\\\right)} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{8}\\\\left(\\\\int_{3}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nBoth new bounds are positive, so absolute values may be omitted. Evaluate:\\n\\n$$\\n- \\\\frac{3}{8}\\\\left(\\\\left[\\\\ln u\\\\right]_{3}^{5}\\\\right)=- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\\n\\nUsing $\\\\ln A-\\\\ln B=\\\\ln(A/B)$ gives\\n\\n$$\\n- \\\\frac{3}{8}\\\\left(\\\\ln\\\\left(\\\\frac{5}{3}\\\\right)\\\\right).\\n$$\"] [\"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/difficulty :question.difficulty/hard] [\"b4a85ff2-6d2d-574f-934b-31afc699e06c\" :question/answer-fields \"0ad22e38-745f-532b-9c6f-88d37bae9b52\"] [17592186068918 :knowledge-point/questions \"b4a85ff2-6d2d-574f-934b-31afc699e06c\"] [\"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/id #uuid \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\"] [\"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/type :answer.type/math] [\"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\tan{\\\\left(4 x \\\\right)} + 2-2\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\\\\right)\"] [\"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/id #uuid \"aab7748b-d307-575f-a1ca-60b716c8fe2e\"] [\"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/key \"field-1\"] [\"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/type :answer-field.type/blank] [\"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/choices \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\"] [\"aab7748b-d307-575f-a1ca-60b716c8fe2e\" :answer-field/correct \"eaafea93-dc58-5ce7-8cdf-fd742c465cc8\"] [\"31af3e89-444a-5351-ab86-623f9917660d\" :question/id #uuid \"31af3e89-444a-5351-ab86-623f9917660d\"] [\"31af3e89-444a-5351-ab86-623f9917660d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{- \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{\\\\tan{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\"] [\"31af3e89-444a-5351-ab86-623f9917660d\" :question/worked-solution \"Let $u=\\\\tan{\\\\left(4 x \\\\right)} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 \\\\sec^{2}{\\\\left(4 x \\\\right)}.\\n$$\\n\\nSince $\\\\tan{\\\\left(4 x \\\\right)}=u-2$, the remaining quotient is\\n\\n$$\\n\\\\frac{u-2}{u}=1-\\\\frac{2}{u}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{- \\\\tan{\\\\left(4 x \\\\right)} \\\\sec^{2}{\\\\left(4 x \\\\right)}}{\\\\tan{\\\\left(4 x \\\\right)} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int 1 - \\\\frac{2}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\int 1 - \\\\frac{2}{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{4}\\\\left(u-2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\tan{\\\\left(4 x \\\\right)} + 2-2\\\\left(\\\\ln\\\\left|\\\\tan{\\\\left(4 x \\\\right)} + 2\\\\right|\\\\right)\\\\right)+C.\\n$$\"] [\"31af3e89-444a-5351-ab86-623f9917660d\" :question/difficulty :question.difficulty/hard] [\"31af3e89-444a-5351-ab86-623f9917660d\" :question/answer-fields \"aab7748b-d307-575f-a1ca-60b716c8fe2e\"] [17592186068918 :knowledge-point/questions \"31af3e89-444a-5351-ab86-623f9917660d\"] [\"generator\" :question-generator/id #uuid \"0410c7a8-bc55-5402-b03c-564f9f5071d7\"] [\"generator\" :question-generator/script \"generators/4b/4b2e25b742b9774b1ca671527404155a24785563eb88306aece872c5951d48a5/generator.py\"] [17592186068918 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186068918 :knowledge-point/question-generator 17592186487553]]}",
