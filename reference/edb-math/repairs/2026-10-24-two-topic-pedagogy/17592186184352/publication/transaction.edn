ee429d8e-d3da-5a8c-acea-e2ca7da3b753" :answer/validate] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/id #uuid "ee65aef4-0270-5704-bdc9-d3954e42566b"] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/key "answer"] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/type :answer-field.type/radio] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/choices "996ef1ea-508b-5cbc-a563-f119a4a5ff24"] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/choices "20cacbd5-8945-583e-8192-cf2d065bcf18"] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/choices "9ad36c5c-70f5-534c-9642-deb259eebfa0"] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/choices "36693298-24d1-5942-b04c-e7dece135391"] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/choices "ee429d8e-d3da-5a8c-acea-e2ca7da3b753"] [:db/add "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/correct "20cacbd5-8945-583e-8192-cf2d065bcf18"] [:db/ensure "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/validate] [:db/add "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d" :question/id #uuid "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d"] [:db/add "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d" :question/problem "Use the substitution $u=x^{2} + 1$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} x e^{x^{2} + 1}\\,\\mathrm{d}x\n$$"] [:db/add "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d" :question/worked-solution "Let $u=x^{2} + 1$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=\\sqrt{\\ln{\\left(2 \\right)}}&\\Longrightarrow u=\\ln{\\left(2 \\right)} + 1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} x e^{x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d" :question/difficulty :question.difficulty/easy] [:db/add "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d" :question/answer-fields "ee65aef4-0270-5704-bdc9-d3954e42566b"] [:db/ensure "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d"] [:db/add "5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb" :answer/id #uuid "5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb"] [:db/add "5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb" :answer/type :answer.type/math] [:db/add "5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb" :answer/value "9\\left(\\int_{2}^{\\ln{\\left(2 \\right)} + 2} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb" :answer/validate] [:db/add "554be830-f89b-5dc6-a2f4-385303f45f89" :answer/id #uuid "554be830-f89b-5dc6-a2f4-385303f45f89"] [:db/add "554be830-f89b-5dc6-a2f4-385303f45f89" :answer/type :answer.type/math] [:db/add "554be830-f89b-5dc6-a2f4-385303f45f89" :answer/value "3\\left(\\int_{2}^{\\ln{\\left(2 \\right)} + 2} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "554be830-f89b-5dc6-a2f4-385303f45f89" :answer/validate] [:db/add "b394f9fe-09e5-5bd3-80ae-94634067b463" :answer/id #uuid "b394f9fe-09e5-5bd3-80ae-94634067b463"] [:db/add "b394f9fe-09e5-5bd3-80ae-94634067b463" :answer/type :answer.type/math] [:db/add "b394f9fe-09e5-5bd3-80ae-94634067b463" :answer/value "-3\\left(\\int_{2}^{\\ln{\\left(2 \\right)} + 2} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "b394f9fe-09e5-5bd3-80ae-94634067b463" :answer/validate] [:db/add "e2ad99a2-1680-5735-9622-475d6cadf211" :answer/id #uuid "e2ad99a2-1680-5735-9622-475d6cadf211"] [:db/add "e2ad99a2-1680-5735-9622-475d6cadf211" :answer/type :answer.type/math] [:db/add "e2ad99a2-1680-5735-9622-475d6cadf211" :answer/value "6\\left(\\int_{2}^{\\ln{\\left(2 \\right)} + 2} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "e2ad9