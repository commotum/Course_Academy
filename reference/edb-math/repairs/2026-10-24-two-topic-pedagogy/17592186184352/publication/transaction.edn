eft(2 \\right)}&\\Longrightarrow u=\\ln{\\left(2 \\right)} + 2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\ln{\\left(2 \\right)}} 3 e^{x + 2}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{2}^{\\ln{\\left(2 \\right)} + 2} e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n3\\left(\\int_{2}^{\\ln{\\left(2 \\right)} + 2} e^{u}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "ffe3571c-83fb-57c7-a2fb-20b07ea00b69" :question/difficulty :question.difficulty/easy] [:db/add "ffe3571c-83fb-57c7-a2fb-20b07ea00b69" :question/answer-fields "bea9c115-78b4-512c-891b-a01c46406ccc"] [:db/ensure "ffe3571c-83fb-57c7-a2fb-20b07ea00b69" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "ffe3571c-83fb-57c7-a2fb-20b07ea00b69"] [:db/add "1d2cc3bd-449b-51d2-9b3f-7058a9173358" :answer/id #uuid "1d2cc3bd-449b-51d2-9b3f-7058a9173358"] [:db/add "1d2cc3bd-449b-51d2-9b3f-7058a9173358" :answer/type :answer.type/math] [:db/add "1d2cc3bd-449b-51d2-9b3f-7058a9173358" :answer/value "\\frac{72}{\\ln{\\left(3 \\right)}}"] [:db/ensure "1d2cc3bd-449b-51d2-9b3f-7058a9173358" :answer/validate] [:db/add "d9f78162-d59e-5a3c-b279-66ccfe2509f4" :answer-field/id #uuid "d9f78162-d59e-5a3c-b279-66ccfe2509f4"] [:db/add "d9f78162-d59e-5a3c-b279-66ccfe2509f4" :answer-field/key "answer"] [:db/add "d9f78162-d59e-5a3c-b279-66ccfe2509f4" :answer-field/type :answer-field.type/blank] [:db/add "d9f78162-d59e-5a3c-b279-66ccfe2509f4" :answer-field/choices "1d2cc3bd-449b-51d2-9b3f-7058a9173358"] [:db/add "d9f78162-d59e-5a3c-b279-66ccfe2509f4" :answer-field/correct "1d2cc3bd-449b-51d2-9b3f-7058a9173358"] [:db/ensure "d9f78162-d59e-5a3c-b279-66ccfe2509f4" :answer-field/validate] [:db/add "1493bcad-9473-5e45-a62f-7de7e087075a" :question/id #uuid "1493bcad-9473-5e45-a62f-7de7e087075a"] [:db/add "1493bcad-9473-5e45-a62f-7de7e087075a" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C$.\n\n{{answer}}"] [:db/add "1493bcad-9473-5e45-a62f-7de7e087075a" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\int_{2}^{4} 3^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{2}^{4}=\\left(\\frac{81}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{72}{\\ln{\\left(3 \\right)}}.\n$$"] [:db/add "1493bcad-9473-5e45-a62f-7de7e087075a" :question/difficulty :question.difficulty/moderate] [:db/add "1493bcad-9473-5e45-a62f-7de7e087075a" :question/answer-fields "d9f78162-d59e-5a3c-b279-66ccfe2509f4"] [:db/ensure "1493bcad-9473-5e45-a62f-7de7e087075a" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "1493bcad-9473-5e45-a62f-7de7e087075a"] [:db/add "14a46496-5ff9-51ee-9ccd-43838a42ba6a" :answer/id #uuid "14a46496-5ff9-51ee-9ccd-43838a42ba6a"] [:db/add "14a46496-5ff9-51ee-9ccd-43838a42ba6a" :answer/type :answer.type/math] [:db/add "14a46496-5ff9-51ee-9ccd-43838a42ba6a" :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}"] [:db/ensure "14a46496-5ff9-51ee-9ccd-43838a42ba6a" :answer/validate] [:db/add "9d5573ee-eb16-563d-899a-ac5f0a12eab4" :answer-field/id #uuid "9d5573ee-eb16-563d-899a-ac5f0a12eab4"] [:db/add "9d5573ee-eb16-563d-899a-ac5f0a12eab4" :answer-field/key "answer"] [:db/add "9d5573ee-eb16-563d-899a-ac5f0a12eab4" :answer-field/type :answer-field.type/blank] [:db/add "9d5573ee-eb16-563d-899a-ac5f0a12eab4" :answer-field/choices "14a46496-5ff9-51ee-9ccd-43838a42ba6a"] [:db/add "9d5573ee-eb16-563d-899a-ac5f0a12eab4" :answer-field/correct "14a46496-5ff9-51ee-9ccd-43838a42ba6a"] [:db/ensure "9d5573ee-eb16-563d-899a-ac5f0a12eab4" :answer-field/validate] [:db/add "fc2e3839-7680-53ae-9065-634be947461c" :question/id #uuid "fc2e3839-7680-53ae-9065-634be947461c"] [:db/add "fc2e3839-7680-53ae-9065-634be947461c" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2^{x + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}"] [:db/add "fc2e3839-7680-53ae-9065-634be947461c" :question/worked-solution "Let $u=x + 1$. Then $\\mathrm{d}u=(1)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2^{x + 1}\\,\\mathrm{d}x\\\\&=\\int_{1}^{2} 2^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{1}^{2}=\\left(\\frac{4}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "fc2e3839-7680-53ae-9065-634be947461c" :question/difficulty :question.difficulty/moderate] [:db/add "fc2e3839-7680-53ae-9065-634be947461c" :question/answer-fields "9d5573ee-eb16-563d-899a-ac5f0a12eab4"] [:db/ensure "fc2e3839-7680-53ae-9065-634be947461c" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "fc2e3839-7680-53ae-9065-634be947461c"] [:db/add "e8cfb12c-f07f-5a9e-94e2-928dbd81d370" :answer/id #uuid "e8cfb12c-f07f-5a9e-94e2-928dbd81d370"] [:db/add "e8cfb12c-f07f-5a9e-94e2-928dbd81d370" :answer/type :answer.type/math] [:db/add "e8cfb12c-f07f-5a9e-94e2-928dbd81d370" :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}"] [:db/ensure "e8cfb12c-f07f-5a9e-94e2-928dbd81d370" :answer/validate] [:db/add "620c9bdc-8093-5f25-9500-d270d9cda170" :answer-field/id #uuid "620c9bdc-8093-5f25-9500-d270d9cda170"] [:db/add "620c9bdc-8093-5f25-9500-d270d9cda170" :answer-field/key "answer"] [:db/add "620c9bdc-8093-5f25-9500-d270d9cda170" :answer-field/type :answer-field.type/blank] [:db/add "620c9bdc-8093-5f25-9500-d270d9cda170" :answer-field/choices "e8cfb12c-f07f-5a9e-94e2-928dbd81d370"] [:db/add "620c9bdc-8093-5f25-9500-d270d9cda170" :answer-field/correct "e8cfb12c-f07f-5a9e-94e2-928dbd81d370"] [:db/ensure "620c9bdc-8093-5f25-9500-d270d9cda170" :answer-field/validate] [:db/add "c915b145-2c27-5f81-8c56-1312ac8cac36" :question/id #uuid "c915b145-2c27-5f81-8c56-1312ac8cac36"] [:db/add "c915b145-2c27-5f81-8c56-1312ac8cac36" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2 \\cdot 2^{2 x^{2} + 1} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}"] [:db/add "c915b145-2c27-5f81-8c56-1312ac8cac36" :question/worked-solution "Let $u=2 x^{2} + 1$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=3\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2 \\cdot 2^{2 x^{2} + 1} x\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{1}^{3} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{1}^{3}\\right)=\\frac{1}{2}\\left(\\left(\\frac{8}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "c915b145-2c27-5f81-8c56-1312ac8cac36" :question/difficulty :question.difficulty/moderate] [:db/add "c915b145-2c27-5f81-8c56-1312ac8cac36" :question/answer-fields "620c9bdc-8093-5f25-9500-d270d9cda170"] [:db/ensure "c915b145-2c27-5f81-8c56-1312ac8cac36" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "c915b145-2c27-5f81-8c56-1312ac8cac36"] [:db/add "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04" :answer/id #uuid "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04"] [:db/add "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04" :answer/type :answer.type/math] [:db/add "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04" :answer/value "\\frac{6}{\\ln{\\left(2 \\right)}}"] [:db/ensure "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04" :answer/validate] [:db/add "f976d41f-e7d5-5275-80bf-872c50e89f5d" :answer-field/id #uuid "f976d41f-e7d5-5275-80bf-872c50e89f5d"] [:db/add "f976d41f-e7d5-5275-80bf-872c50e89f5d" :answer-field/key "answer"] [:db/add "f976d41f-e7d5-5275-80bf-872c50e89f5d" :answer-field/type :answer-field.type/blank] [:db/add "f976d41f-e7d5-5275-80bf-872c50e89f5d" :answer-field/choices "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04"] [:db/add "f976d41f-e7d5-5275-80bf-872c50e89f5d" :answer-field/correct "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04"] [:db/ensure "f976d41f-e7d5-5275-80bf-872c50e89f5d" :answer-field/validate] [:db/add "20519125-738d-55d8-b32b-ce8805e91f82" :question/id #uuid "20519125-738d-55d8-b32b-ce8805e91f82"] [:db/add "20519125-738d-55d8-b32b-ce8805e91f82" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2^{2 x + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}"] [:db/add "20519125-738d-55d8-b32b-ce8805e91f82" :question/worked-solution "Let $u=2 x + 2$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2^{2 x + 2}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{2}^{4} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{2}^{4}\\right)=\\frac{1}{2}\\left(\\left(\\frac{16}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{4}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{6}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "20519125-738d-55d8-b32b-ce8805e91f82" :question/difficulty :question.difficulty/moderate] [:db/add "20519125-738d-55d8-b32b-ce8805e91f82" :question/answer-fields "f976d41f-e7d5-5275-80bf-872c50e89f5d"] [:db/ensure "20519125-738d-55d8-b32b-ce8805e91f82" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "20519125-738d-55d8-b32b-ce8805e91f82"] [:db/add "66d5bff0-8694-5744-baa6-4a14ba1d6d8b" :answer/id #uuid "66d5bff0-8694-5744-baa6-4a14ba1d6d8b"] [:db/add "66d5bff0-8694-5744-baa6-4a14ba1d6d8b" :answer/type :answer.type/math] [:db/add "66d5bff0-8694-5744-baa6-4a14ba1d6d8b" :answer/value "\\frac{18}{\\ln{\\left(3 \\right)}}"] [:db/ensure "66d5bff0-8694-5744-baa6-4a14ba1d6d8b" :answer/validate] [:db/add "49953bb8-af90-58f8-969d-7e0b1dfe201b" :answer-field/id #uuid "49953bb8-af90-58f8-969d-7e0b1dfe201b"] [:db/add "49953bb8-af90-58f8-969d-7e0b1dfe201b" :answer-field/key "answer"] [:db/add "49953bb8-af90-58f8-969d-7e0b1dfe201b" :answer-field/type :answer-field.type/blank] [:db/add "49953bb8-af90-58f8-969d-7e0b1dfe201b" :answer-field/choices "66d5bff0-8694-5744-baa6-4a14ba1d6d8b"] [:db/add "49953bb8-af90-58f8-969d-7e0b1dfe201b" :answer-field/correct "66d5bff0-8694-5744-baa6-4a14ba1d6d8b"] [:db/ensure "49953bb8-af90-58f8-969d-7e0b1dfe201b" :answer-field/validate] [:db/add "3f17baf9-fc2a-53b6-a35f-0b08e79be71d" :question/id #uuid "3f17baf9-fc2a-53b6-a35f-0b08e79be71d"] [:db/add "3f17baf9-fc2a-53b6-a35f-0b08e79be71d" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C$.\n\n{{answer}}"] [:db/add "3f17baf9-fc2a-53b6-a35f-0b08e79be71d" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int_{2}^{4} 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{1}{4}\\left(\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{2}^{4}\\right)=\\frac{1}{4}\\left(\\left(\\frac{81}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{18}{\\ln{\\left(3 \\right)}}.\n$$"] [:db/add "3f17baf9-fc2a-53b6-a35f-0b08e79be71d" :question/difficulty :question.difficulty/moderate] [:db/add "3f17baf9-fc2a-53b6-a35f-0b08e79be71d" :question/answer-fields "49953bb8-af90-58f8-969d-7e0b1dfe201b"] [:db/ensure "3f17baf9-fc2a-53b6-a35f-0b08e79be71d" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "3f17baf9-fc2a-53b6-a35f-0b08e79be71d"] [:db/add "b5c82e9f-45e9-56f1-b2b3-587a314f0438" :answer/id #uuid "b5c82e9f-45e9-56f1-b2b3-587a314f0438"] [:db/add "b5c82e9f-45e9-56f1-b2b3-587a314f0438" :answer/type :answer.type/math] [:db/add "b5c82e9f-45e9-56f1-b2b3-587a314f0438" :answer/value "\\frac{12}{\\ln{\\left(3 \\right)}}"] [:db/ensure "b5c82e9f-45e9-56f1-b2b3-587a314f0438" :answer/validate] [:db/add "206f288e-0cac-5598-8c44-c001ad2ed7d0" :answer-field/id #uuid "206f288e-0cac-5598-8c44-c001ad2ed7d0"] [:db/add "206f288e-0cac-5598-8c44-c001ad2ed7d0" :answer-field/key "answer"] [:db/add "206f288e-0cac-5598-8c44-c001ad2ed7d0" :answer-field/type :answer-field.type/blank] [:db/add "206f288e-0cac-5598-8c44-c001ad2ed7d0" :answer-field/choices "b5c82e9f-45e9-56f1-b2b3-587a314f0438"] [:db/add "206f288e-0cac-5598-8c44-c001ad2ed7d0" :answer-field/correct "b5c82e9f-45e9-56f1-b2b3-587a314f0438"] [:db/ensure "206f288e-0cac-5598-8c44-c001ad2ed7d0" :answer-field/validate] [:db/add "64a67543-fe94-530d-98d5-f76b2adaf312" :question/id #uuid "64a67543-fe94-530d-98d5-f76b2adaf312"] [:db/add "64a67543-fe94-530d-98d5-f76b2adaf312" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2 \\cdot 3^{x + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C$.\n\n{{answer}}"] [:db/add "64a67543-fe94-530d-98d5-f76b2adaf312" :question/worked-solution "Let $u=x + 1$. Then $\\mathrm{d}u=(1)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2 \\cdot 3^{x + 1}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{1}^{2} 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{1}^{2}\\right)=2\\left(\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{3}{\\ln{\\left(3 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{12}{\\ln{\\left(3 \\right)}}.\n$$"] [:db/add "64a67543-fe94-530d-98d5-f76b2adaf312" :question/difficulty :question.difficulty/moderate] [:db/add "64a67543-fe94-530d-98d5-f76b2adaf312" :question/answer-fields "206f288e-0cac-5598-8c44-c001ad2ed7d0"] [:db/ensure "64a67543-fe94-530d-98d5-f76b2adaf312" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "64a67543-fe94-530d-98d5-f76b2adaf312"] [:db/add "dc2e004d-8080-52a5-b013-fa11bc1abf70" :answer/id #uuid "dc2e004d-8080-52a5-b013-fa11bc1abf70"] [:db/add "dc2e004d-8080-52a5-b013-fa11bc1abf70" :answer/type :answer.type/math] [:db/add "dc2e004d-8080-52a5-b013-fa11bc1abf70" :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}"] [:db/ensure "dc2e004d-8080-52a5-b013-fa11bc1abf70" :answer/validate] [:db/add "be02bd4a-0fb8-5c53-b6bd-9807b05d127c" :answer-field/id #uuid "be02bd4a-0fb8-5c53-b6bd-9807b05d127c"] [:db/add "be02bd4a-0fb8-5c53-b6bd-9807b05d127c" :answer-field/key "answer"] [:db/add "be02bd4a-0fb8-5c53-b6bd-9807b05d127c" :answer-field/type :answer-field.type/blank] [:db/add "be02bd4a-0fb8-5c53-b6bd-9807b05d127c" :answer-field/choices "dc2e004d-8080-52a5-b013-fa11bc1abf70"] [:db/add "be02bd4a-0fb8-5c53-b6bd-9807b05d127c" :answer-field/correct "dc2e004d-8080-52a5-b013-fa11bc1abf70"] [:db/ensure "be02bd4a-0fb8-5c53-b6bd-9807b05d127c" :answer-field/validate] [:db/add "c76d7b6c-51f9-5398-95b8-ed5e30775bc6" :question/id #uuid "c76d7b6c-51f9-5398-95b8-ed5e30775bc6"] [:db/add "c76d7b6c-51f9-5398-95b8-ed5e30775bc6" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 2^{x^{2}} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}"] [:db/add "c76d7b6c-51f9-5398-95b8-ed5e30775bc6" :question/worked-solution "Let $u=x^{2}$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=1&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 2^{x^{2}} x\\,\\mathrm{d}x\\\\&=2\\left(\\int_{0}^{1} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{0}^{1}\\right)=2\\left(\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{1}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "c76d7b6c-51f9-5398-95b8-ed5e30775bc6" :question/difficulty :question.difficulty/moderate] [:db/add "c76d7b6c-51f9-5398-95b8-ed5e30775bc6" :question/answer-fields "be02bd4a-0fb8-5c53-b6bd-9807b05d127c"] [:db/ensure "c76d7b6c-51f9-5398-95b8-ed5e30775bc6" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "c76d7b6c-51f9-5398-95b8-ed5e30775bc6"] [:db/add "ff9f14c6-e7db-596d-9618-7617d39ec406" :answer/id #uuid "ff9f14c6-e7db-596d-9618-7617d39ec406"] [:db/add "ff9f14c6-e7db-596d-9618-7617d39ec406" :answer/type :answer.type/math] [:db/add "ff9f14c6-e7db-596d-9618-7617d39ec406" :answer/value "\\frac{80}{\\ln{\\left(5 \\right)}}"] [:db/ensure "ff9f14c6-e7db-596d-9618-7617d39ec406" :answer/validate] [:db/add "c496f9ed-0027-5df2-9228-5afcf3c033e4" :answer-field/id #uuid "c496f9ed-0027-5df2-9228-5afcf3c033e4"] [:db/add "c496f9ed-0027-5df2-9228-5afcf3c033e4" :answer-field/key "answer"] [:db/add "c496f9ed-0027-5df2-9228-5afcf3c033e4" :answer-field/type :answer-field.type/blank] [:db/add "c496f9ed-0027-5df2-9228-5afcf3c033e4" :answer-field/choices "ff9f14c6-e7db-596d-9618-7617d39ec406"] [:db/add "c496f9ed-0027-5df2-9228-5afcf3c033e4" :answer-field/correct "ff9f14c6-e7db-596d-9618-7617d39ec406"] [:db/ensure "c496f9ed-0027-5df2-9228-5afcf3c033e4" :answer-field/validate] [:db/add "90f1394b-b3e3-58ff-b7a5-aad48e825ede" :question/id #uuid "90f1394b-b3e3-58ff-b7a5-aad48e825ede"] [:db/add "90f1394b-b3e3-58ff-b7a5-aad48e825ede" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 5^{x + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C$.\n\n{{answer}}"] [:db/add "90f1394b-b3e3-58ff-b7a5-aad48e825ede" :question/worked-solution "Let $u=x + 1$. Then $\\mathrm{d}u=(1)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 5^{x + 1}\\,\\mathrm{d}x\\\\&=4\\left(\\int_{1}^{2} 5^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n4\\left(\\left[\\frac{5^{u}}{\\ln{\\left(5 \\right)}}\\right]_{1}^{2}\\right)=4\\left(\\left(\\frac{25}{\\ln{\\left(5 \\right)}}\\right)-\\left(\\frac{5}{\\ln{\\left(5 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{80}{\\ln{\\left(5 \\right)}}.\n$$"] [:db/add "90f1394b-b3e3-58ff-b7a5-aad48e825ede" :question/difficulty :question.difficulty/moderate] [:db/add "90f1394b-b3e3-58ff-b7a5-aad48e825ede" :question/answer-fields "c496f9ed-0027-5df2-9228-5afcf3c033e4"] [:db/ensure "90f1394b-b3e3-58ff-b7a5-aad48e825ede" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "90f1394b-b3e3-58ff-b7a5-aad48e825ede"] [:db/add "6e710d08-5bd0-5455-8321-ac9cf801861d" :answer/id #uuid "6e710d08-5bd0-5455-8321-ac9cf801861d"] [:db/add "6e710d08-5bd0-5455-8321-ac9cf801861d" :answer/type :answer.type/math] [:db/add "6e710d08-5bd0-5455-8321-ac9cf801861d" :answer/value "3\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)"] [:db/ensure "6e710d08-5bd0-5455-8321-ac9cf801861d" :answer/validate] [:db/add "d0ebddaa-9572-5fd7-a266-26fe46eb85cb" :answer-field/id #uuid "d0ebddaa-9572-5fd7-a266-26fe46eb85cb"] [:db/add "d0ebddaa-9572-5fd7-a266-26fe46eb85cb" :answer-field/key "answer"] [:db/add "d0ebddaa-9572-5fd7-a266-26fe46eb85cb" :answer-field/type :answer-field.type/blank] [:db/add "d0ebddaa-9572-5fd7-a266-26fe46eb85cb" :answer-field/choices "6e710d08-5bd0-5455-8321-ac9cf801861d"] [:db/add "d0ebddaa-9572-5fd7-a266-26fe46eb85cb" :answer-field/correct "6e710d08-5bd0-5455-8321-ac9cf801861d"] [:db/ensure "d0ebddaa-9572-5fd7-a266-26fe46eb85cb" :answer-field/validate] [:db/add "1091cf45-3b7c-52f0-96e3-7f79a1caef3d" :question/id #uuid "1091cf45-3b7c-52f0-96e3-7f79a1caef3d"] [:db/add "1091cf45-3b7c-52f0-96e3-7f79a1caef3d" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}"] [:db/add "1091cf45-3b7c-52f0-96e3-7f79a1caef3d" :question/worked-solution "Let $u=2 e^{x} + 3$. Then $\\mathrm{d}u=(2 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=7\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=9\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{7}^{9} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{7}^{9}\\right)=3\\left(\\left(\\ln{\\left(9 \\right)}\\right)-\\left(\\ln{\\left(7 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right).\n$$"] [:db/add "1091cf45-3b7c-52f0-96e3-7f79a1caef3d" :question/difficulty :question.difficulty/hard] [:db/add "1091cf45-3b7c-52f0-96e3-7f79a1caef3d" :question/answer-fields "d0ebddaa-9572-5fd7-a266-26fe46eb85cb"] [:db/ensure "1091cf45-3b7c-52f0-96e3-7f79a1caef3d" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "1091cf45-3b7c-52f0-96e3-7f79a1caef3d"] [:db/add "6b908837-766f-5bfd-b27c-083bbab38bd6" :answer/id #uuid "6b908837-766f-5bfd-b27c-083bbab38bd6"] [:db/add "6b908837-766f-5bfd-b27c-083bbab38bd6" :answer/type :answer.type/math] [:db/add "6b908837-766f-5bfd-b27c-083bbab38bd6" :answer/value "3\\left(\\ln\\left(5\\right)-\\ln\\left(4\\right)\\right)"] [:db/ensure "6b908837-766f-5bfd-b27c-083bbab38bd6" :answer/validate] [:db/add "239ff20c-752b-51a5-82e6-f986bc7883a3" :answer-field/id #uuid "239ff20c-752b-51a5-82e6-f986bc7883a3"] [:db/add "239ff20c-752b-51a5-82e6-f986bc7883a3" :answer-field/key "answer"] [:db/add "239ff20c-752b-51a5-82e6-f986bc7883a3" :answer-field/type :answer-field.type/blank] [:db/add "239ff20c-752b-51a5-82e6-f986bc7883a3" :answer-field/choices "6b908837-766f-5bfd-b27c-083bbab38bd6"] [:db/add "239ff20c-752b-51a5-82e6-f986bc7883a3" :answer-field/correct "6b908837-766f-5bfd-b27c-083bbab38bd6"] [:db/ensure "239ff20c-752b-51a5-82e6-f986bc7883a3" :answer-field/validate] [:db/add "3a37439d-e797-5de6-ae99-2c1a68201323" :question/id #uuid "3a37439d-e797-5de6-ae99-2c1a68201323"] [:db/add "3a37439d-e797-5de6-ae99-2c1a68201323" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{3 e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}"] [:db/add "3a37439d-e797-5de6-ae99-2c1a68201323" :question/worked-solution "Let $u=e^{x} + 2$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=4\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=5\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{3 e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{4}^{5} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{4}^{5}\\right)=3\\left(\\left(\\ln{\\left(5 \\right)}\\right)-\\left(\\ln{\\left(4 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(5\\right)-\\ln\\left(4\\right)\\right).\n$$"] [:db/add "3a37439d-e797-5de6-ae99-2c1a68201323" :question/difficulty :question.difficulty/hard] [:db/add "3a37439d-e797-5de6-ae99-2c1a68201323" :question/answer-fields "239ff20c-752b-51a5-82e6-f986bc7883a3"] [:db/ensure "3a37439d-e797-5de6-ae99-2c1a68201323" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "3a37439d-e797-5de6-ae99-2c1a68201323"] [:db/add "e805574d-111d-5acb-9f10-2e8e06520b7e" :answer/id #uuid "e805574d-111d-5acb-9f10-2e8e06520b7e"] [:db/add "e805574d-111d-5acb-9f10-2e8e06520b7e" :answer/type :answer.type/math] [:db/add "e805574d-111d-5acb-9f10-2e8e06520b7e" :answer/value "2\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)"] [:db/ensure "e805574d-111d-5acb-9f10-2e8e0652