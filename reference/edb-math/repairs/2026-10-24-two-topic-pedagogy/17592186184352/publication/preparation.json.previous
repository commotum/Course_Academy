-field/choices \"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\"] [:db/add \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"3f30ae78-7958-56b5-8269-99571ff177bf\"] [:db/add \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"acf50591-a0c3-5342-b6a5-d93fb7909e0a\"] [:db/add \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"7a942d42-f286-5365-8191-58ec155c08a2\"] [:db/add \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/correct \"acf50591-a0c3-5342-b6a5-d93fb7909e0a\"] [:db/ensure \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/validate] [:db/add \"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/id #uuid \"cbb1ce86-4054-5654-9040-b3e8073157c6\"] [:db/add \"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/difficulty :question.difficulty/easy] [:db/add \"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/answer-fields \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\"] [:db/ensure \"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"cbb1ce86-4054-5654-9040-b3e8073157c6\"] [:db/add \"f6262f90-037e-59c7-a8e7-bbda7fb45016\" :answer/id #uuid \"f6262f90-037e-59c7-a8e7-bbda7fb45016\"] [:db/add \"f6262f90-037e-59c7-a8e7-bbda7fb45016\" :answer/type :answer.type/math] [:db/add \"f6262f90-037e-59c7-a8e7-bbda7fb45016\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f6262f90-037e-59c7-a8e7-bbda7fb45016\" :answer/validate] [:db/add \"07c83705-0d24-567d-94ec-8364b10213c2\" :answer/id #uuid \"07c83705-0d24-567d-94ec-8364b10213c2\"] [:db/add \"07c83705-0d24-567d-94ec-8364b10213c2\" :answer/type :answer.type/math] [:db/add \"07c83705-0d24-567d-94ec-8364b10213c2\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"07c83705-0d24-567d-94ec-8364b10213c2\" :answer/validate] [:db/add \"81440b68-80c1-509e-a962-c5d1804cbb07\" :answer/id #uuid \"81440b68-80c1-509e-a962-c5d1804cbb07\"] [:db/add \"81440b68-80c1-509e-a962-c5d1804cbb07\" :answer/type :answer.type/math] [:db/add \"81440b68-80c1-509e-a962-c5d1804cbb07\" :answer/value \"\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"81440b68-80c1-509e-a962-c5d1804cbb07\" :answer/validate] [:db/add \"958cd4ec-d43c-5b72-bb9b-baccda93a090\" :answer/id #uuid \"958cd4ec-d43c-5b72-bb9b-baccda93a090\"] [:db/add \"958cd4ec-d43c-5b72-bb9b-baccda93a090\" :answer/type :answer.type/math] [:db/add \"958cd4ec-d43c-5b72-bb9b-baccda93a090\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"958cd4ec-d43c-5b72-bb9b-baccda93a090\" :answer/validate] [:db/add \"a45f2b55-d7a1-51a2-affe-f0a4037d6085\" :answer/id #uuid \"a45f2b55-d7a1-51a2-affe-f0a4037d6085\"] [:db/add \"a45f2b55-d7a1-51a2-affe-f0a4037d6085\" :answer/type :answer.type/math] [:db/add \"a45f2b55-d7a1-51a2-affe-f0a4037d6085\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a45f2b55-d7a1-51a2-affe-f0a4037d6085\" :answer/validate] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/id #uuid \"3c455d4a-5ebf-5800-a325-9753b611a643\"] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/key \"answer\"] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/type :answer-field.type/radio] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"f6262f90-037e-59c7-a8e7-bbda7fb45016\"] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"07c83705-0d24-567d-94ec-8364b10213c2\"] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"81440b68-80c1-509e-a962-c5d1804cbb07\"] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"958cd4ec-d43c-5b72-bb9b-baccda93a090\"] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"a45f2b55-d7a1-51a2-affe-f0a4037d6085\"] [:db/add \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/correct \"f6262f90-037e-59c7-a8e7-bbda7fb45016\"] [:db/ensure \"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/validate] [:db/add \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/id #uuid \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\"] [:db/add \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/difficulty :question.difficulty/easy] [:db/add \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/answer-fields \"3c455d4a-5ebf-5800-a325-9753b611a643\"] [:db/ensure \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\"] [:db/add \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\" :answer/id #uuid \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\"] [:db/add \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\" :answer/type :answer.type/math] [:db/add \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\" :answer/value \"\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\" :answer/validate] [:db/add \"24b8943e-5297-5675-b60c-bf220399c22c\" :answer/id #uuid \"24b8943e-5297-5675-b60c-bf220399c22c\"] [:db/add \"24b8943e-5297-5675-b60c-bf220399c22c\" :answer/type :answer.type/math] [:db/add \"24b8943e-5297-5675-b60c-bf220399c22c\" :answer/value \"3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"24b8943e-5297-5675-b60c-bf220399c22c\" :answer/validate] [:db/add \"fbf52402-9f94-587d-8aa9-29beb597adc5\" :answer/id #uuid \"fbf52402-9f94-587d-8aa9-29beb597adc5\"] [:db/add \"fbf52402-9f94-587d-8aa9-29beb597adc5\" :answer/type :answer.type/math] [:db/add \"fbf52402-9f94-587d-8aa9-29beb597adc5\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"fbf52402-9f94-587d-8aa9-29beb597adc5\" :answer/validate] [:db/add \"09a3806a-d