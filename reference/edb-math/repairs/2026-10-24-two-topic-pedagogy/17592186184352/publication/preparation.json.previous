pe/radio] [\"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"f6262f90-037e-59c7-a8e7-bbda7fb45016\"] [\"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"07c83705-0d24-567d-94ec-8364b10213c2\"] [\"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"81440b68-80c1-509e-a962-c5d1804cbb07\"] [\"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"958cd4ec-d43c-5b72-bb9b-baccda93a090\"] [\"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/choices \"a45f2b55-d7a1-51a2-affe-f0a4037d6085\"] [\"3c455d4a-5ebf-5800-a325-9753b611a643\" :answer-field/correct \"f6262f90-037e-59c7-a8e7-bbda7fb45016\"] [\"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/id #uuid \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\"] [\"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [\"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/difficulty :question.difficulty/easy] [\"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\" :question/answer-fields \"3c455d4a-5ebf-5800-a325-9753b611a643\"] [17592186184352 :knowledge-point/questions \"fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a\"] [\"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\" :answer/id #uuid \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\"] [\"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\" :answer/type :answer.type/math] [\"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\" :answer/value \"\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [\"24b8943e-5297-5675-b60c-bf220399c22c\" :answer/id #uuid \"24b8943e-5297-5675-b60c-bf220399c22c\"] [\"24b8943e-5297-5675-b60c-bf220399c22c\" :answer/type :answer.type/math] [\"24b8943e-5297-5675-b60c-bf220399c22c\" :answer/value \"3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"fbf52402-9f94-587d-8aa9-29beb597adc5\" :answer/id #uuid \"fbf52402-9f94-587d-8aa9-29beb597adc5\"] [\"fbf52402-9f94-587d-8aa9-29beb597adc5\" :answer/type :answer.type/math] [\"fbf52402-9f94-587d-8aa9-29beb597adc5\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"09a3806a-da14-51f2-ac99-f1ae51ab0c88\" :answer/id #uuid \"09a3806a-da14-51f2-ac99-f1ae51ab0c88\"] [\"09a3806a-da14-51f2-ac99-f1ae51ab0c88\" :answer/type :answer.type/math] [\"09a3806a-da14-51f2-ac99-f1ae51ab0c88\" :answer/value \"-1\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"7964119e-4ee6-53c5-a66c-7833976fa0ca\" :answer/id #uuid \"7964119e-4ee6-53c5-a66c-7833976fa0ca\"] [\"7964119e-4ee6-53c5-a66c-7833976fa0ca\" :answer/type :answer.type/math] [\"7964119e-4ee6-53c5-a66c-7833976fa0ca\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/id #uuid \"4bb5da61-71b0-5e43-b045-d064df7b43c9\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/key \"answer\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/type :answer-field.type/radio] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/choices \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/choices \"24b8943e-5297-5675-b60c-bf220399c22c\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/choices \"fbf52402-9f94-587d-8aa9-29beb597adc5\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/choices \"09a3806a-da14-51f2-ac99-f1ae51ab0c88\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/choices \"7964119e-4ee6-53c5-a66c-7833976fa0ca\"] [\"4bb5da61-71b0-5e43-b045-d064df7b43c9\" :answer-field/correct \"d3f1e416-dea5-58f5-ab4c-e982ecb8d9ba\"] [\"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/id #uuid \"79daf5c8-5977-553f-b226-69bc4633b3d2\"] [\"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/difficulty :question.difficulty/easy] [\"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/answer-fields \"4bb5da61-71b0-5e43-b045-d064df7b43c9\"] [17592186184352 :knowledge-point/questions \"79daf5c8-5977-553f-b226-69bc4633b3d2\"] [\"178b88f4-a634-5a6a-8d90-c61a9682fc29\" :answer/id #uuid \"178b88f4-a634-5a6a-8d90-c61a9682fc29\"] [\"178b88f4-a634-5a6a-8d90-c61a9682fc29\" :answer/type :answer.type/math] [\"178b88f4-a634-5a6a-8d90-c61a9682fc29\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\" :answer/id #uuid \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\"] [\"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\" :answer/type :answer.type/math] [\"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\" :answer/value \"3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c09e91c3-c664-506c-9729-5ff7cb009b2c\" :answer/id #uuid \"c09e91c3-c664-506c-9729-5ff7cb009b2c\"] [\"c09e91c3-c664-506c-9729-5ff7cb009b2c\" :answer/type :answer.type/math] [\"c09e91c3-c664-506c-9729-5ff7cb009b2c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"043d30ad-6728-5bbc-9248-c82ba987aba9\" :answer/id #uuid \"043d30ad-6728-5bbc-9248-c82ba987aba9\"] [\"043d30ad-6728-5bbc-9248-c82ba987aba9\" :answer/type :answer.type/math] [\"043d30ad-6728-5bbc-9248-c82ba987aba9\" :answer/value \"\\\\frac{9}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"051bca3e-782f-5b8e-92a5-0b131354d6b0\" :answer/id #uuid \"051bca3e-782f-5b8e-92a5-0b131354d6b0\"] [\"051bca3e-782f-5b8e-92a5-0b131354d6b0\" :answer/type :answer.type/math] [\"051bca3e-782f-5b8e-92a5-0b131354d6b0\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/id #uuid \"1eea9427-756f-5914-aab9-5b73e1e7ee99\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/key \"answer\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/type :answer-field.type/radio] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"178b88f4-a634-5a6a-8d90-c61a9682fc29\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"c09e91c3-c664-506c-9729-5ff7cb009b2c\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"043d30ad-6728-5bbc-9248-c82ba987aba9\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"051bca3e-782f-5b8e-92a5-0b131354d6b0\"] [\"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/correct \"051bca3e-782f-5b8e-92a5-0b131354d6b0\"] [\"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/id #uuid \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\"] [\"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [\"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/difficulty :question.difficulty/easy] [\"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/answer-fields \"1eea9427-756f-5914-aab9-5b73e1e7ee99\"] [17592186184352 :knowledge-point/questions \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\"] [\"996ef1ea-508b-5cbc-a563-f119a4a5ff24\" :answer/id #uuid \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\"] [\"996ef1ea-508b-5cbc-a563-f119a4a5ff24\" :answer/type :answer.type/math] [\"996ef1ea-508b-5cbc-a563-f119a4a5ff24\" :answer/value \"\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\"] [\"20cacbd5-8945-583e-8192-cf2d065bcf18\" :answer/id #uuid \"20cacbd5-8945-583e-8192-cf2d065bcf18\"] [\"20cacbd5-8945-583e-8192-cf2d065bcf18\" :answer/type :answer.type/math] [\"20cacbd5-8945-583e-8192-cf2d065bcf18\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"9ad36c5c-70f5-534c-9642-deb259eebfa0\" :answer/id #uuid \"9ad36c5c-70f5-534c-9642-deb259eebfa0\"] [\"9ad36c5c-70f5-534c-9642-deb259eebfa0\" :answer/type :answer.type/math] [\"9ad36c5c-70f5-534c-9642-deb259eebfa0\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"36693298-24d1-5942-b04c-e7dece135391\" :answer/id #uuid \"36693298-24d1-5942-b04c-e7dece135391\"] [\"36693298-24d1-5942-b04c-e7dece135391\" :answer/type :answer.type/math] [\"36693298-24d1-5942-b04c-e7dece135391\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\" :answer/id #uuid \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\"] [\"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\" :answer/type :answer.type/math] [\"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/id #uuid \"ee65aef4-0270-5704-bdc9-d3954e42566b\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/key \"answer\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/type :answer-field.type/radio] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"20cacbd5-8945-583e-8192-cf2d065bcf18\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"9ad36c5c-70f5-534c-9642-deb259eebfa0\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"36693298-24d1-5942-b04c-e7dece135391\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\"] [\"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/correct \"20cacbd5-8945-583e-8192-cf2d065bcf18\"] [\"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/id #uuid \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\"] [\"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/problem \"Use the substitution $u=x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/difficulty :question.difficulty/easy] [\"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/answer-fields \"ee65aef4-0270-5704-bdc9-d3954e42566b\"] [17592186184352 :knowledge-point/questions \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\"] [\"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\" :answer/id #uuid \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\"] [\"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\" :answer/type :answer.type/math] [\"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\" :answer/value \"9\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"554be830-f89b-5dc6-a2f4-385303f45f89\" :answer/id #uuid \"554be830-f89b-5dc6-a2f4-385303f45f89\"] [\"554be830-f89b-5dc6-a2f4-385303f45f89\" :answer/type :answer.type/math] [\"554be830-f89b-5dc6-a2f4-385303f45f89\" :answer/value \"3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b394f9fe-09e5-5bd3-80ae-94634067b463\" :answer/id #uuid \"b394f9fe-09e5-5bd3-80ae-94634067b463\"] [\"b394f9fe-09e5-5bd3-80ae-94634067b463\" :answer/type :answer.type/math] [\"b394f9fe-09e5-5bd3-80ae-94634067b463\" :answer/value \"-3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e2ad99a2-1680-5735-9622-475d6cadf211\" :answer/id #uuid \"e2ad99a2-1680-5735-9622-475d6cadf211\"] [\"e2ad99a2-1680-5735-9622-475d6cadf211\" :answer/type :answer.type/math] [\"e2ad99a2-1680-5735-9622-475d6cadf211\" :answer/value \"6\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\" :answer/id #uuid \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\"] [\"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\" :answer/type :answer.type/math] [\"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/id #uuid \"bea9c115-78b4-512c-891b-a01c46406ccc\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/key \"answer\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/type :answer-field.type/radio] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"554be830-f89b-5dc6-a2f4-385303f45f89\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"b394f9fe-09e5-5bd3-80ae-94634067b463\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"e2ad99a2-1680-5735-9622-475d6cadf211\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\"] [\"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/correct \"554be830-f89b-5dc6-a2f4-385303f45f89\"] [\"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/id #uuid \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\"] [\"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/problem \"Use the substitution $u=x + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [\"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/worked-solution \"Let $u=x + 2$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/difficulty :question.difficulty/easy] [\"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/answer-fields \"bea9c115-78b4-512c-891b-a01c46406ccc\"] [17592186184352 :knowledge-point/questions \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\"] [\"1d2cc3bd-449b-51d2-9b3f-7058a9173358\" :answer/id #uuid \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\"] [\"1d2cc3bd-449b-51d2-9b3f-7058a9173358\" :answer/type :answer.type/math] [\"1d2cc3bd-449b-51d2-9b3f-7058a9173358\" :answer/value \"\\\\frac{72}{\\\\ln{\\\\left(3 \\\\right)}}\"] [\"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/id #uuid \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\"] [\"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/key \"answer\"] [\"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/type :answer-field.type/blank] [\"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/choices \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\"] [\"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/correct \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\"] [\"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/id #uuid \"1493bcad-9473-5e45-a62f-7de7e087075a\"] [\"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 4 \\\\cdot 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/worked-solution \"Let $u=2 x^{2} + 2$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=1&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 4 \\\\cdot 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{2}^{4} 3^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right]_{2}^{4}=\\\\left(\\\\frac{81}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)-\\\\left(\\\\frac{9}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{72}{\\\\ln{\\\\left(3 \\\\right)}}.\\n$$\"] [\"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/difficulty :question.difficulty/moderate] [\"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/answer-fields \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\"] [17592186184352 :knowledge-point/questions \"1493bcad-9473-5e45-a62f-7de7e087075a\"] [\"14a46496-5ff9-51ee-9ccd-43838a42ba6a\" :answer/id #uuid \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\"] [\"14a46496-5ff9-51ee-9ccd-43838a42ba6a\" :answer/type :answer.type/math] [\"14a46496-5ff9-51ee-9ccd-43838a42ba6a\" :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\"] [\"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/id #uuid \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\"] [\"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/key \"answer\"] [\"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/type :answer-field.type/blank] [\"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/choices \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\"] [\"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/correct \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\"] [\"fc2e3839-7680-53ae-9065-634be947461c\" :question/id #uuid \"fc2e3839-7680-53ae-9065-634be947461c\"] [\"fc2e3839-7680-53ae-9065-634be947461c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"fc2e3839-7680-53ae-9065-634be947461c\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{1}^{2} 2^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{1}^{2}=\\\\left(\\\\frac{4}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [\"fc2e3839-7680-53ae-9065-634be947461c\" :question/difficulty :question.difficulty/moderate] [\"fc2e3839-7680-53ae-9065-634be947461c\" :question/answer-fields \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\"] [17592186184352 :knowledge-point/questions \"fc2e3839-7680-53ae-9065-634be947461c\"] [\"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\" :answer/id #uuid \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\"] [\"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\" :answer/type :answer.type/math] [\"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\" :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\"] [\"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/id #uuid \"620c9bdc-8093-5f25-9500-d270d9cda170\"] [\"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/key \"answer\"] [\"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/type :answer-field.type/blank] [\"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/choices \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\"] [\"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/correct \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\"] [\"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/id #uuid \"c915b145-2c27-5f81-8c56-1312ac8cac36\"] [\"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2 \\\\cdot 2^{2 x^{2} + 1} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=3\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2 \\\\cdot 2^{2 x^{2} + 1} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{3} 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{1}^{3}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(\\\\frac{8}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [\"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/difficulty :question.difficulty/moderate] [\"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/answer-fields \"620c9bdc-8093-5f25-9500-d270d9cda170\"] [17592186184352 :knowledge-point/questions \"c915b145-2c27-5f81-8c56-1312ac8cac36\"] [\"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\" :answer/id #uuid \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\"] [\"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\" :answer/type :answer.type/math] [\"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\" :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}\"] [\"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/id #uuid \"f976d41f-e7d5-5275-80bf-872c50e89f5d\"] [\"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/key \"answer\"] [\"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/type :answer-field.type/blank] [\"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/choices \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\"] [\"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/correct \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\"] [\"20519125-738d-55d8-b32b-ce8805e91f82\" :question/id #uuid \"20519125-738d-55d8-b32b-ce8805e91f82\"] [\"20519125-738d-55d8-b32b-ce8805e91f82\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2^{2 x + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"20519125-738d-55d8-b32b-ce8805e91f82\" :question/worked-solution \"Let $u=2 x + 2$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=1&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2^{2 x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{2}^{4} 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{2}^{4}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(\\\\frac{16}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{4}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [\"20519125-738d-55d8-b32b-ce8805e91f82\" :question/difficulty :question.difficulty/moderate] [\"20519125-738d-55d8-b32b-ce8805e91f82\" :question/answer-fields \"f976d41f-e7d5-5275-80bf-872c50e89f5d\"] [17592186184352 :knowledge-point/questions \"20519125-738d-55d8-b32b-ce8805e91f82\"] [\"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\" :answer/id #uuid \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\"] [\"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\" :answer/type :answer.type/math] [\"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\" :answer/value \"\\\\frac{18}{\\\\ln{\\\\left(3 \\\\right)}}\"] [\"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/id #uuid \"49953bb8-af90-58f8-969d-7e0b1dfe201b\"] [\"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/key \"answer\"] [\"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/type :answer-field.type/blank] [\"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/choices \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\"] [\"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/correct \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\"] [\"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/id #uuid \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\"] [\"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/worked-solution \"Let $u=2 x^{2} + 2$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=1&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int_{2}^{4} 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\left[\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right]_{2}^{4}\\\\right)=\\\\frac{1}{4}\\\\left(\\\\left(\\\\frac{81}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)-\\\\left(\\\\frac{9}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{18}{\\\\ln{\\\\left(3 \\\\right)}}.\\n$$\"] [\"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/difficulty :question.difficulty/moderate] [\"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/answer-fields \"49953bb8-af90-58f8-969d-7e0b1dfe201b\"] [17592186184352 :knowledge-point/questions \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\"] [\"b5c82e9f-45e9-56f1-b2b3-587a314f0438\" :answer/id #uuid \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\"] [\"b5c82e9f-45e9-56f1-b2b3-587a314f0438\" :answer/type :answer.type/math] [\"b5c82e9f-45e9-56f1-b2b3-587a314f0438\" :answer/value \"\\\\frac{12}{\\\\ln{\\\\left(3 \\\\right)}}\"] [\"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/id #uuid \"206f288e-0cac-5598-8c44-c001ad2ed7d0\"] [\"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/key \"answer\"] [\"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/type :answer-field.type/blank] [\"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/choices \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\"] [\"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/correct \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\"] [\"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/id #uuid \"64a67543-fe94-530d-98d5-f76b2adaf312\"] [\"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2 \\\\cdot 3^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2 \\\\cdot 3^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{1}^{2} 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right]_{1}^{2}\\\\right)=2\\\\left(\\\\left(\\\\frac{9}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)-\\\\left(\\\\frac{3}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{12}{\\\\ln{\\\\left(3 \\\\right)}}.\\n$$\"] [\"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/difficulty :question.difficulty/moderate] [\"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/answer-fields \"206f288e-0cac-5598-8c44-c001ad2ed7d0\"] [17592186184352 :knowledge-point/questions \"64a67543-fe94-530d-98d5-f76b2adaf312\"] [\"dc2e004d-8080-52a5-b013-fa11bc1abf70\" :answer/id #uuid \"dc2e004d-8080-52a5-b013-fa11bc1abf70\"] [\"dc2e004d-8080-52a5-b013-fa11bc1abf70\" :answer/type :answer.type/math] [\"dc2e004d-8080-52a5-b013-fa11bc1abf70\" :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\"] [\"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/id #uuid \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\"] [\"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/key \"answer\"] [\"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/type :answer-field.type/blank] [\"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/choices \"dc2e004d-8080-52a5-b013-fa11bc1abf70\"] [\"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/correct \"dc2e004d-8080-52a5-b013-fa11bc1abf70\"] [\"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/id #uuid \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\"] [\"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 4 \\\\cdot 2^{x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=1&\\\\Longrightarrow u=1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 4 \\\\cdot 2^{x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{1} 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{0}^{1}\\\\right)=2\\\\left(\\\\left(\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [\"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/difficulty :question.difficulty/moderate] [\"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/answer-fields \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\"] [17592186184352 :knowledge-point/questions \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\"] [\"ff9f14c6-e7db-596d-9618-7617d39ec406\" :answer/id #uuid \"ff9f14c6-e7db-596d-9618-7617d39ec406\"] [\"ff9f14c6-e7db-596d-9618-7617d39ec406\" :answer/type :answer.type/math] [\"ff9f14c6-e7db-596d-9618-7617d39ec406\" :answer/value \"\\\\frac{80}{\\\\ln{\\\\left(5 \\\\right)}}\"] [\"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/id #uuid \"c496f9ed-0027-5df2-9228-5afcf3c033e4\"] [\"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/key \"answer\"] [\"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/type :answer-field.type/blank] [\"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/choices \"ff9f14c6-e7db-596d-9618-7617d39ec406\"] [\"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/correct \"ff9f14c6-e7db-596d-9618-7617d39ec406\"] [\"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/id #uuid \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\"] [\"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 4 \\\\cdot 5^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}}\"] [\"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 4 \\\\cdot 5^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{2} 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n4\\\\left(\\\\left[\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right]_{1}^{2}\\\\right)=4\\\\left(\\\\left(\\\\frac{25}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)-\\\\left(\\\\frac{5}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{80}{\\\\ln{\\\\left(5 \\\\right)}}.\\n$$\"] [\"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/difficulty :question.difficulty/moderate] [\"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/answer-fields \"c496f9ed-0027-5df2-9228-5afcf3c033e4\"] [17592186184352 :knowledge-point/questions \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\"] [\"6e710d08-5bd0-5455-8321-ac9cf801861d\" :answer/id #uuid \"6e710d08-5bd0-5455-8321-ac9cf801861d\"] [\"6e710d08-5bd0-5455-8321-ac9cf801861d\" :answer/type :answer.type/math] [\"6e710d08-5bd0-5455-8321-ac9cf801861d\" :answer/value \"3\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right)\"] [\"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/id #uuid \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\"] [\"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/key \"answer\"] [\"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/type :answer-field.type/blank] [\"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/choices \"6e710d08-5bd0-5455-8321-ac9cf801861d\"] [\"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/correct \"6e710d08-5bd0-5455-8321-ac9cf801861d\"] [\"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/id #uuid \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\"] [\"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/worked-solution \"Let $u=2 e^{x} + 3$. Then $\\\\mathrm{d}u=(2 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=7\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=9\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{7}^{9} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{7}^{9}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(9 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(7 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right).\\n$$\"] [\"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/difficulty :question.difficulty/hard] [\"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/answer-fields \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\"] [17592186184352 :knowledge-point/questions \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\"] [\"6b908837-766f-5bfd-b27c-083bbab38bd6\" :answer/id #uuid \"6b908837-766f-5bfd-b27c-083bbab38bd6\"] [\"6b908837-766f-5bfd-b27c-083bbab38bd6\" :answer/type :answer.type/math] [\"6b908837-766f-5bfd-b27c-083bbab38bd6\" :answer/value \"3\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right)\\\\right)\"] [\"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/id #uuid \"239ff20c-752b-51a5-82e6-f986bc7883a3\"] [\"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/key \"answer\"] [\"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/type :answer-field.type/blank] [\"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/choices \"6b908837-766f-5bfd-b27c-083bbab38bd6\"] [\"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/correct \"6b908837-766f-5bfd-b27c-083bbab38bd6\"] [\"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/id #uuid \"3a37439d-e797-5de6-ae99-2c1a68201323\"] [\"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{3 e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/worked-solution \"Let $u=e^{x} + 2$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=4\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{3 e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{4}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{4}^{5}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(5 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(4 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right)\\\\right).\\n$$\"] [\"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/difficulty :question.difficulty/hard] [\"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/answer-fields \"239ff20c-752b-51a5-82e6-f986bc7883a3\"] [17592186184352 :knowledge-point/questions \"3a37439d-e797-5de6-ae99-2c1a68201323\"] [\"e805574d-111d-5acb-9f10-2e8e06520b7e\" :answer/id #uuid \"e805574d-111d-5acb-9f10-2e8e06520b7e\"] [\"e805574d-111d-5acb-9f10-2e8e06520b7e\" :answer/type :answer.type/math] [\"e805574d-111d-5acb-9f10-2e8e06520b7e\" :answer/value \"2\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right)\"] [\"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/id #uuid \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\"] [\"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/key \"answer\"] [\"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/type :answer-field.type/blank] [\"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/choices \"e805574d-111d-5acb-9f10-2e8e06520b7e\"] [\"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/correct \"e805574d-111d-5acb-9f10-2e8e06520b7e\"] [\"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/id #uuid \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\"] [\"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/worked-solution \"Let $u=2 e^{x} + 3$. Then $\\\\mathrm{d}u=(2 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=7\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=9\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{7}^{9} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{7}^{9}\\\\right)=2\\\\left(\\\\left(\\\\ln{\\\\left(9 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(7 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n2\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right).\\n$$\"] [\"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/difficulty :question.difficulty/hard] [\"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/answer-fields \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\"] [17592186184352 :knowledge-point/questions \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\"] [\"a3a5ef0d-2584-596d-a969-b4816c2e220f\" :answer/id #uuid \"a3a5ef0d-2584-596d-a969-b4816c2e220f\"] [\"a3a5ef0d-2584-596d-a969-b4816c2e220f\" :answer/type :answer.type/math] [\"a3a5ef0d-2584-596d-a969-b4816c2e220f\" :answer/value \"3\\\\left(\\\\ln\\\\left(11\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right)\"] [\"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/id #uuid \"6aada5ef-5b85-585e-acee-e36006fe1520\"] [\"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/key \"answer\"] [\"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/type :answer-field.type/blank] [\"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/choices \"a3a5ef0d-2584-596d-a969-b4816c2e220f\"] [\"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/correct \"a3a5ef0d-2584-596d-a969-b4816c2e220f\"] [\"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/id #uuid \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\"] [\"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/worked-solution \"Let $u=3 e^{x} + 2$. Then $\\\\mathrm{d}u=(3 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=8\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=11\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{8}^{11} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{8}^{11}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(11 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(8 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(11\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\"] [\"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/difficulty :question.difficulty/hard] [\"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/answer-fields \"6aada5ef-5b85-585e-acee-e36006fe1520\"] [17592186184352 :knowledge-point/questions \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\"] [\"5a764233-b2f3-5e90-b360-28f68e4e845e\" :answer/id #uuid \"5a764233-b2f3-5e90-b360-28f68e4e845e\"] [\"5a764233-b2f3-5e90-b360-28f68e4e845e\" :answer/type :answer.type/math] [\"5a764233-b2f3-5e90-b360-28f68e4e845e\" :answer/value \"4\\\\left(\\\\ln\\\\left(4\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right)\"] [\"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/id #uuid \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\"] [\"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/key \"answer\"] [\"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/type :answer-field.type/blank] [\"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/choices \"5a764233-b2f3-5e90-b360-28f68e4e845e\"] [\"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/correct \"5a764233-b2f3-5e90-b360-28f68e4e845e\"] [\"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/id #uuid \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\"] [\"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/worked-solution \"Let $u=e^{x} + 1$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=3\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{3}^{4} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n4\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{3}^{4}\\\\right)=4\\\\left(\\\\left(\\\\ln{\\\\left(4 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(3 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n4\\\\left(\\\\ln\\\\left(4\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\"] [\"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/difficulty :question.difficulty/hard] [\"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/answer-fields \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\"] [17592186184352 :knowledge-point/questions \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\"] [\"5f29c0bd-afd6-595d-a791-b40ce5f73018\" :answer/id #uuid \"5f29c0bd-afd6-595d-a791-b40ce5f73018\"] [\"5f29c0bd-afd6-595d-a791-b40ce5f73018\" :answer/type :answer.type/math] [\"5f29c0bd-afd6-595d-a791-b40ce5f73018\" :answer/value \"3\\\\left(\\\\ln\\\\left(12\\\\right)-\\\\ln\\\\left(9\\\\right)\\\\right)\"] [\"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/id #uuid \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\"] [\"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/key \"answer\"] [\"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/type :answer-field.type/blank] [\"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/choices \"5f29c0bd-afd6-595d-a791-b40ce5f73018\"] [\"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/correct \"5f29c0bd-afd6-595d-a791-b40ce5f73018\"] [\"3a151c81-c4e9-5302-89d7-30f533727337\" :question/id #uuid \"3a151c81-c4e9-5302-89d7-30f533727337\"] [\"3a151c81-c4e9-5302-89d7-30f533727337\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"3a151c81-c4e9-5302-89d7-30f533727337\" :question/worked-solution \"Let $u=3 e^{x} + 3$. Then $\\\\mathrm{d}u=(3 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=9\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=12\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{9}^{12} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{9}^{12}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(12 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(9 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(12\\\\right)-\\\\ln\\\\left(9\\\\right)\\\\right).\\n$$\"] [\"3a151c81-c4e9-5302-89d7-30f533727337\" :question/difficulty :question.difficulty/hard] [\"3a151c81-c4e9-5302-89d7-30f533727337\" :question/answer-fields \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\"] [17592186184352 :knowledge-point/questions \"3a151c81-c4e9-5302-89d7-30f533727337\"] [\"4e7abd27-c793-5130-9281-c0e31e3590bb\" :answer/id #uuid \"4e7abd27-c793-5130-9281-c0e31e3590bb\"] [\"4e7abd27-c793-5130-9281-c0e31e3590bb\" :answer/type :answer.type/math] [\"4e7abd27-c793-5130-9281-c0e31e3590bb\" :answer/value \"\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right)\"] [\"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/id #uuid \"a76d7558-16bc-538f-bbb9-c370677b70cf\"] [\"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/key \"answer\"] [\"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/type :answer-field.type/blank] [\"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/choices \"4e7abd27-c793-5130-9281-c0e31e3590bb\"] [\"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/correct \"4e7abd27-c793-5130-9281-c0e31e3590bb\"] [\"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/id #uuid \"f311eb5f-107f-5276-825f-873dacb83ed0\"] [\"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/worked-solution \"Let $u=e^{x} + 2$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=4\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{4}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{4}^{5}=\\\\left(\\\\ln{\\\\left(5 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(4 \\\\right)}\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right).\\n$$\"] [\"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/difficulty :question.difficulty/hard] [\"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/answer-fields \"a76d7558-16bc-538f-bbb9-c370677b70cf\"] [17592186184352 :knowledge-point/questions \"f311eb5f-107f-5276-825f-873dacb83ed0\"] [\"65be0e3e-ffb9-5082-8469-f46219ca3e10\" :answer/id #uuid \"65be0e3e-ffb9-5082-8469-f46219ca3e10\"] [\"65be0e3e-ffb9-5082-8469-f46219ca3e10\" :answer/type :answer.type/math] [\"65be0e3e-ffb9-5082-8469-f46219ca3e10\" :answer/value \"3\\\\left(\\\\ln\\\\left(7\\\\right)-\\\\ln\\\\left(5\\\\right)\\\\right)\"] [\"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/id #uuid \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\"] [\"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/key \"answer\"] [\"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/type :answer-field.type/blank] [\"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/choices \"65be0e3e-ffb9-5082-8469-f46219ca3e10\"] [\"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/correct \"65be0e3e-ffb9-5082-8469-f46219ca3e10\"] [\"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/id #uuid \"98ccf776-cbef-59ff-bad2-21baea608c07\"] [\"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [\"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/worked-solution \"Let $u=2 e^{x} + 1$. Then $\\\\mathrm{d}u=(2 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=5\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=7\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{5}^{7} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{5}^{7}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(7 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(5 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(7\\\\right)-\\\\ln\\\\left(5\\\\right)\\\\right).\\n$$\"] [\"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/difficulty :question.difficulty/hard] [\"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/answer-fields \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\"] [17592186184352 :knowledge-point/questions \"98ccf776-cbef-59ff-bad2-21baea608c07\"] [\"generator\" :question-generator/id #uuid \"899f47a9-534d-5b24-8f10-a6a7afb049e1\"] [\"generator\" :question-generator/script \"generators/ee/ee9da33b5dfe6b737a0b9d3cdee3ca287b58d1baf4a66ce8dcbf919b38b169f4/generator.py\"] [17592186184352 :knowledge-point/question-generator \"generator\"]] \"retractions\" []}",
