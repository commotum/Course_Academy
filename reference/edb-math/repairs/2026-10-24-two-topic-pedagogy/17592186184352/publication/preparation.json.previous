  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\" :answer/id #uuid \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\"] [:db/add \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\" :answer/type :answer.type/math] [:db/add \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\" :answer/validate] [:db/add \"8e50e073-4439-5954-8601-35f71817d36c\" :answer/id #uuid \"8e50e073-4439-5954-8601-35f71817d36c\"] [:db/add \"8e50e073-4439-5954-8601-35f71817d36c\" :answer/type :answer.type/math] [:db/add \"8e50e073-4439-5954-8601-35f71817d36c\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"8e50e073-4439-5954-8601-35f71817d36c\" :answer/validate] [:db/add \"14821592-dcfc-5bda-b697-e8c065e996ce\" :answer/id #uuid \"14821592-dcfc-5bda-b697-e8c065e996ce\"] [:db/add \"14821592-dcfc-5bda-b697-e8c065e996ce\" :answer/type :answer.type/math] [:db/add \"14821592-dcfc-5bda-b697-e8c065e996ce\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"14821592-dcfc-5bda-b697-e8c065e996ce\" :answer/validate] [:db/add \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\" :answer/id #uuid \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\"] [:db/add \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\" :answer/type :answer.type/math] [:db/add \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\" :answer/value \"\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\" :answer/validate] [:db/add \"3b294e75-d590-5756-bf3d-1917af5537f3\" :answer/id #uuid \"3b294e75-d590-5756-bf3d-1917af5537f3\"] [:db/add \"3b294e75-d590-5756-bf3d-1917af5537f3\" :answer/type :answer.type/math] [:db/add \"3b294e75-d590-5756-bf3d-1917af5537f3\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"3b294e75-d590-5756-bf3d-1917af5537f3\" :answer/validate] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/id #uuid \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\"] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/key \"answer\"] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/type :answer-field.type/radio] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\"] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"8e50e073-4439-5954-8601-35f71817d36c\"] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"14821592-dcfc-5bda-b697-e8c065e996ce\"] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\"] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"3b294e75-d590-5756-bf3d-1917af5537f3\"] [:db/add \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/correct \"3b294e75-d590-5756-bf3d-1917af5537f3\"] [:db/ensure \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/validate] [:db/add \"f63df859-feae-5a0d-b265-058c2043e45e\" :question/id #uuid \"f63df859-feae-5a0d-b265-058c2043e45e\"] [:db/add \"f63df859-feae-5a0d-b265-058c2043e45e\" :question/problem \"Use the substitution $u=2 x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"f63df859-feae-5a0d-b265-058c2043e45e\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=1 + \\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"f63df859-feae-5a0d-b265-058c2043e45e\" :question/difficulty :question.difficulty/easy] [:db/add \"f63df859-feae-5a0d-b265-058c2043e45e\" :question/answer-fields \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\"] [:db/ensure \"f63df859-feae-5a0d-b265-058c2043e45e\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"f63df859-feae-5a0d-b265-058c2043e45e\"] [:db/add \"6cf6996d-5ec3-584e-975c-587892f7556a\" :answer/id #uuid \"6cf6996d-5ec3-584e-975c-587892f7556a\"] [:db/add \"6cf6996d-5ec3-584e-975c-587892f7556a\" :answer/type :answer.type/math] [:db/add \"6cf6996d-5ec3-584e-975c-587892f7556a\" :answer/value \"8\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6cf6996d-5ec3-584e-975c-587892f7556a\" :answer/validate] [:db/add \"2f411cee-34cd-5e43-b660-895da178df5a\" :answer/id #uuid \"2f411cee-34cd-5e43-b660-895da178df5a\"] [:db/add \"2f411cee-34cd-5e43-b660-895da178df5a\" :answer/type :answer.type/math] [:db/add \"2f411cee-34cd-5e43-b660-895da178df5a\" :answer/value \"-4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"2f411cee-34cd-5e43-b660-895da178df5a\" :answer/validate] [:db/add \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\" :answer/id #uuid \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\"] [:db/add \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\" :answer/type :answer.type/math] [:db/add \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\" :answer/value \"2\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\" :answer/validate] [:db/add \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\" :answer/id #uuid \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\"] [:db/add \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\" :answer/type :answer.type/math] [:db/add \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\" :answer/value \"12\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\" :answer/validate] [:db/add \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\" :answer/id #uuid \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\"] [:db/add \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\" :answer/type :answer.type/math] [:db/add \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\" :answer/value \"4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\" :answer/validate] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/id #uuid \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\"] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/key \"answer\"] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/type :answer-field.type/radio] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"6cf6996d-5ec3-584e-975c-587892f7556a\"] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"2f411cee-34cd-5e43-b660-895da178df5a\"] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\"] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\"] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\"] [:db/add \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/correct \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\"] [:db/ensure \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/validate] [:db/add \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/id #uuid \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\"] [:db/add \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/problem \"Use the substitution $u=x + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/difficulty :question.difficulty/easy] [:db/add \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/answer-fields \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\"] [:db/ensure \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\"] [:db/add \"0c7fe7a5-27b9-562d-8405-612baecc779a\" :answer/id #uuid \"0c7fe7a5-27b9-562d-8405-612baecc779a\"] [:db/add \"0c7fe7a5-27b9-562d-8405-612baecc779a\" :answer/type :answer.type/math] [:db/add \"0c7fe7a5-27b9-562d-8405-612baecc779a\" :answer/value \"-2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0c7fe7a5-27b9-562d-8405-612baecc779a\" :answer/validate] [:db/add \"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\" :answer/id #uuid \"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\"] [:db/add \"4