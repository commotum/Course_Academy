add \"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/difficulty :question.difficulty/easy] [:db/add \"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/answer-fields \"4bb5da61-71b0-5e43-b045-d064df7b43c9\"] [:db/ensure \"79daf5c8-5977-553f-b226-69bc4633b3d2\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"79daf5c8-5977-553f-b226-69bc4633b3d2\"] [:db/add \"178b88f4-a634-5a6a-8d90-c61a9682fc29\" :answer/id #uuid \"178b88f4-a634-5a6a-8d90-c61a9682fc29\"] [:db/add \"178b88f4-a634-5a6a-8d90-c61a9682fc29\" :answer/type :answer.type/math] [:db/add \"178b88f4-a634-5a6a-8d90-c61a9682fc29\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"178b88f4-a634-5a6a-8d90-c61a9682fc29\" :answer/validate] [:db/add \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\" :answer/id #uuid \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\"] [:db/add \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\" :answer/type :answer.type/math] [:db/add \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\" :answer/value \"3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\" :answer/validate] [:db/add \"c09e91c3-c664-506c-9729-5ff7cb009b2c\" :answer/id #uuid \"c09e91c3-c664-506c-9729-5ff7cb009b2c\"] [:db/add \"c09e91c3-c664-506c-9729-5ff7cb009b2c\" :answer/type :answer.type/math] [:db/add \"c09e91c3-c664-506c-9729-5ff7cb009b2c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c09e91c3-c664-506c-9729-5ff7cb009b2c\" :answer/validate] [:db/add \"043d30ad-6728-5bbc-9248-c82ba987aba9\" :answer/id #uuid \"043d30ad-6728-5bbc-9248-c82ba987aba9\"] [:db/add \"043d30ad-6728-5bbc-9248-c82ba987aba9\" :answer/type :answer.type/math] [:db/add \"043d30ad-6728-5bbc-9248-c82ba987aba9\" :answer/value \"\\\\frac{9}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"043d30ad-6728-5bbc-9248-c82ba987aba9\" :answer/validate] [:db/add \"051bca3e-782f-5b8e-92a5-0b131354d6b0\" :answer/id #uuid \"051bca3e-782f-5b8e-92a5-0b131354d6b0\"] [:db/add \"051bca3e-782f-5b8e-92a5-0b131354d6b0\" :answer/type :answer.type/math] [:db/add \"051bca3e-782f-5b8e-92a5-0b131354d6b0\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"051bca3e-782f-5b8e-92a5-0b131354d6b0\" :answer/validate] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/id #uuid \"1eea9427-756f-5914-aab9-5b73e1e7ee99\"] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/key \"answer\"] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/type :answer-field.type/radio] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"178b88f4-a634-5a6a-8d90-c61a9682fc29\"] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"e1bda3c3-7af8-55f9-b8e0-f516a59be07e\"] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"c09e91c3-c664-506c-9729-5ff7cb009b2c\"] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"043d30ad-6728-5bbc-9248-c82ba987aba9\"] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/choices \"051bca3e-782f-5b8e-92a5-0b131354d6b0\"] [:db/add \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/correct \"051bca3e-782f-5b8e-92a5-0b131354d6b0\"] [:db/ensure \"1eea9427-756f-5914-aab9-5b73e1e7ee99\" :answer-field/validate] [:db/add \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/id #uuid \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\"] [:db/add \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/difficulty :question.difficulty/easy] [:db/add \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/answer-fields \"1eea9427-756f-5914-aab9-5b73e1e7ee99\"] [:db/ensure \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"77ae44f5-acc3-5106-8cc3-42cbe5ce2407\"] [:db/add \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\" :answer/id #uuid \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\"] [:db/add \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\" :answer/type :answer.type/math] [:db/add \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\" :answer/value \"\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\" :answer/validate] [:db/add \"20cacbd5-8945-583e-8192-cf2d065bcf18\" :answer/id #uuid \"20cacbd5-8945-583e-8192-cf2d065bcf18\"] [:db/add \"20cacbd5-8945-583e-8192-cf2d065bcf18\" :answer/type :answer.type/math] [:db/add \"20cacbd5-8945-583e-8192-cf2d065bcf18\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"20cacbd5-8945-583e-8192-cf2d065bcf18\" :answer/validate] [:db/add \"9ad36c5c-70f5-534c-9642-deb259eebfa0\" :answer/id #uuid \"9ad36c5c-70f5-534c-9642-deb259eebfa0\"] [:db/add \"9ad36c5c-70f5-534c-9642-deb259eebfa0\" :answer/type :answer.type/math] [:db/add \"9ad36c5c-70f5-534c-9642-deb259eebfa0\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"9ad36c5c-70f5-534c-9642-deb259eebfa0\" :answer/validate] [:db/add \"36693298-24d1-5942-b04c-e7dece135391\" :answer/id #uuid \"36693298-24d1-5942-b04c-e7dece135391\"] [:db/add \"36693298-24d1-5942-b04c-e7dece135391\" :answer/type :answer.type/math] [:db/add \"36693298-24d1-5942-b04c-e7dece135391\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"36693298-24d1-5942-b04c-e7dece135391\" :answer/validate] [:db/add \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\" :answer/id #uuid \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\"] [:db/add \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\" :answer/type :answer.type/math] [:db/add \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\" :answer/validate] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/id #uuid \"ee65aef4-0270-5704-bdc9-d3954e42566b\"] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/key \"answer\"] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/type :answer-field.type/radio] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"996ef1ea-508b-5cbc-a563-f119a4a5ff24\"] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"20cacbd5-8945-583e-8192-cf2d065bcf18\"] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"9ad36c5c-70f5-534c-9642-deb259eebfa0\"] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"36693298-24d1-5942-b04c-e7dece135391\"] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/choices \"ee429d8e-d3da-5a8c-acea-e2ca7da3b753\"] [:db/add \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/correct \"20cacbd5-8945-583e-8192-cf2d065bcf18\"] [:db/ensure \"ee65aef4-0270-5704-bdc9-d3954e42566b\" :answer-field/validate] [:db/add \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/id #uuid \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\"] [:db/add \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/problem \"Use the substitution $u=x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/difficulty :question.difficulty/easy] [:db/add \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/answer-fields \"ee65aef4-0270-5704-bdc9-d3954e42566b\"] [:db/ensure \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d\"] [:db/add \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\" :answer/id #uuid \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\"] [:db/add \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\" :answer/type :answer.type/math] [:db/add \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\" :answer/value \"9\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\" :answer/validate] [:db/add \"554be830-f89b-5dc6-a2f4-385303f45f89\" :answer/id #uuid \"554be830-f89b-5dc6-a2f4-385303f45f89\"] [:db/add \"554be830-f89b-5dc6-a2f4-385303f45f89\" :answer/type :answer.type/math] [:db/add \"554be830-f89b-5dc6-a2f4-385303f45f89\" :answer/value \"3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"554be830-f89b-5dc6-a2f4-385303f45f89\" :answer/validate] [:db/add \"b394f9fe-09e5-5bd3-80ae-94634067b463\" :answer/id #uuid \"b394f9fe-09e5-5bd3-80ae-94634067b463\"] [:db/add \"b394f9fe-09e5-5bd3-80ae-94634067b463\" :answer/type :answer.type/math] [:db/add \"b394f9fe-09e5-5bd3-80ae-94634067b463\" :answer/value \"-3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b394f9fe-09e5-5bd3-80ae-94634067b463\" :answer/validate] [:db/add \"e2ad99a2-1680-5735-9622-475d6cadf211\" :answer/id #uuid \"e2ad99a2-1680-5735-9622-475d6cadf211\"] [:db/add \"e2ad99a2-1680-5735-9622-475d6cadf211\" :answer/type :answer.type/math] [:db/add \"e2ad99a2-1680-5735-9622-475d6cadf211\" :answer/value \"6\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e2ad99a2-1680-5735-9622-475d6cadf211\" :answer/validate] [:db/add \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\" :answer/id #uuid \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\"] [:db/add \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\" :answer/type :answer.type/math] [:db/add \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\" :answer/validate] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/id #uuid \"bea9c115-78b4-512c-891b-a01c46406ccc\"] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/key \"answer\"] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/type :answer-field.type/radio] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"5b74a0fc-9c73-5cd5-b8bd-d31cf25460cb\"] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"554be830-f89b-5dc6-a2f4-385303f45f89\"] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"b394f9fe-09e5-5bd3-80ae-94634067b463\"] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"e2ad99a2-1680-5735-9622-475d6cadf211\"] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/choices \"2504bbab-4a2f-5c57-b9ea-838ddb3c27b1\"] [:db/add \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/correct \"554be830-f89b-5dc6-a2f4-385303f45f89\"] [:db/ensure \"bea9c115-78b4-512c-891b-a01c46406ccc\" :answer-field/validate] [:db/add \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/id #uuid \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\"] [:db/add \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/problem \"Use the substitution $u=x + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/worked-solution \"Let $u=x + 2$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/difficulty :question.difficulty/easy] [:db/add \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/answer-fields \"bea9c115-78b4-512c-891b-a01c46406ccc\"] [:db/ensure \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"ffe3571c-83fb-57c7-a2fb-20b07ea00b69\"] [:db/add \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\" :answer/id #uuid \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\"] [:db/add \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\" :answer/type :answer.type/math] [:db/add \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\" :answer/value \"\\\\frac{72}{\\\\ln{\\\\left(3 \\\\right)}}\"] [:db/ensure \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\" :answer/validate] [:db/add \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/id #uuid \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\"] [:db/add \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/key \"answer\"] [:db/add \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/type :answer-field.type/blank] [:db/add \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/choices \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\"] [:db/add \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/correct \"1d2cc3bd-449b-51d2-9b3f-7058a9173358\"] [:db/ensure \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\" :answer-field/validate] [:db/add \"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/id #uuid \"1493bcad-9473-5e45-a62f-7de7e087075a\"] [:db/add \"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 4 \\\\cdot 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/worked-solution \"Let $u=2 x^{2} + 2$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=1&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 4 \\\\cdot 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{2}^{4} 3^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right]_{2}^{4}=\\\\left(\\\\frac{81}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)-\\\\left(\\\\frac{9}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{72}{\\\\ln{\\\\left(3 \\\\right)}}.\\n$$\"] [:db/add \"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/difficulty :question.difficulty/moderate] [:db/add \"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/answer-fields \"d9f78162-d59e-5a3c-b279-66ccfe2509f4\"] [:db/ensure \"1493bcad-9473-5e45-a62f-7de7e087075a\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"1493bcad-9473-5e45-a62f-7de7e087075a\"] [:db/add \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\" :answer/id #uuid \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\"] [:db/add \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\" :answer/type :answer.type/math] [:db/add \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\" :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\"] [:db/ensure \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\" :answer/validate] [:db/add \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/id #uuid \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\"] [:db/add \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/key \"answer\"] [:db/add \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/type :answer-field.type/blank] [:db/add \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/choices \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\"] [:db/add \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/correct \"14a46496-5ff9-51ee-9ccd-43838a42ba6a\"] [:db/ensure \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\" :answer-field/validate] [:db/add \"fc2e3839-7680-53ae-9065-634be947461c\" :question/id #uuid \"fc2e3839-7680-53ae-9065-634be947461c\"] [:db/add \"fc2e3839-7680-53ae-9065-634be947461c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"fc2e3839-7680-53ae-9065-634be947461c\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{1}^{2} 2^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{1}^{2}=\\\\left(\\\\frac{4}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [:db/add \"fc2e3839-7680-53ae-9065-634be947461c\" :question/difficulty :question.difficulty/moderate] [:db/add \"fc2e3839-7680-53ae-9065-634be947461c\" :question/answer-fields \"9d5573ee-eb16-563d-899a-ac5f0a12eab4\"] [:db/ensure \"fc2e3839-7680-53ae-9065-634be947461c\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"fc2e3839-7680-53ae-9065-634be947461c\"] [:db/add \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\" :answer/id #uuid \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\"] [:db/add \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\" :answer/type :answer.type/math] [:db/add \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\" :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\"] [:db/ensure \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\" :answer/validate] [:db/add \"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/id #uuid \"620c9bdc-8093-5f25-9500-d270d9cda170\"] [:db/add \"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/key \"answer\"] [:db/add \"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/type :answer-field.type/blank] [:db/add \"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/choices \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\"] [:db/add \"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/correct \"e8cfb12c-f07f-5a9e-94e2-928dbd81d370\"] [:db/ensure \"620c9bdc-8093-5f25-9500-d270d9cda170\" :answer-field/validate] [:db/add \"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/id #uuid \"c915b145-2c27-5f81-8c56-1312ac8cac36\"] [:db/add \"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2 \\\\cdot 2^{2 x^{2} + 1} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=3\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2 \\\\cdot 2^{2 x^{2} + 1} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{3} 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{1}^{3}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(\\\\frac{8}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [:db/add \"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/difficulty :question.difficulty/moderate] [:db/add \"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/answer-fields \"620c9bdc-8093-5f25-9500-d270d9cda170\"] [:db/ensure \"c915b145-2c27-5f81-8c56-1312ac8cac36\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"c915b145-2c27-5f81-8c56-1312ac8cac36\"] [:db/add \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\" :answer/id #uuid \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\"] [:db/add \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\" :answer/type :answer.type/math] [:db/add \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\" :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}\"] [:db/ensure \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\" :answer/validate] [:db/add \"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/id #uuid \"f976d41f-e7d5-5275-80bf-872c50e89f5d\"] [:db/add \"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/key \"answer\"] [:db/add \"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/type :answer-field.type/blank] [:db/add \"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/choices \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\"] [:db/add \"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/correct \"8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04\"] [:db/ensure \"f976d41f-e7d5-5275-80bf-872c50e89f5d\" :answer-field/validate] [:db/add \"20519125-738d-55d8-b32b-ce8805e91f82\" :question/id #uuid \"20519125-738d-55d8-b32b-ce8805e91f82\"] [:db/add \"20519125-738d-55d8-b32b-ce8805e91f82\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2^{2 x + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"20519125-738d-55d8-b32b-ce8805e91f82\" :question/worked-solution \"Let $u=2 x + 2$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=1&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2^{2 x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{2}^{4} 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{2}^{4}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(\\\\frac{16}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{4}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [:db/add \"20519125-738d-55d8-b32b-ce8805e91f82\" :question/difficulty :question.difficulty/moderate] [:db/add \"20519125-738d-55d8-b32b-ce8805e91f82\" :question/answer-fields \"f976d41f-e7d5-5275-80bf-872c50e89f5d\"] [:db/ensure \"20519125-738d-55d8-b32b-ce8805e91f82\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"20519125-738d-55d8-b32b-ce8805e91f82\"] [:db/add \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\" :answer/id #uuid \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\"] [:db/add \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\" :answer/type :answer.type/math] [:db/add \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\" :answer/value \"\\\\frac{18}{\\\\ln{\\\\left(3 \\\\right)}}\"] [:db/ensure \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\" :answer/validate] [:db/add \"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/id #uuid \"49953bb8-af90-58f8-969d-7e0b1dfe201b\"] [:db/add \"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/key \"answer\"] [:db/add \"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/type :answer-field.type/blank] [:db/add \"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/choices \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\"] [:db/add \"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/correct \"66d5bff0-8694-5744-baa6-4a14ba1d6d8b\"] [:db/ensure \"49953bb8-af90-58f8-969d-7e0b1dfe201b\" :answer-field/validate] [:db/add \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/id #uuid \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\"] [:db/add \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/worked-solution \"Let $u=2 x^{2} + 2$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=1&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 3^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int_{2}^{4} 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\left[\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right]_{2}^{4}\\\\right)=\\\\frac{1}{4}\\\\left(\\\\left(\\\\frac{81}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)-\\\\left(\\\\frac{9}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{18}{\\\\ln{\\\\left(3 \\\\right)}}.\\n$$\"] [:db/add \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/difficulty :question.difficulty/moderate] [:db/add \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/answer-fields \"49953bb8-af90-58f8-969d-7e0b1dfe201b\"] [:db/ensure \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"3f17baf9-fc2a-53b6-a35f-0b08e79be71d\"] [:db/add \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\" :answer/id #uuid \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\"] [:db/add \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\" :answer/type :answer.type/math] [:db/add \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\" :answer/value \"\\\\frac{12}{\\\\ln{\\\\left(3 \\\\right)}}\"] [:db/ensure \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\" :answer/validate] [:db/add \"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/id #uuid \"206f288e-0cac-5598-8c44-c001ad2ed7d0\"] [:db/add \"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/key \"answer\"] [:db/add \"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/type :answer-field.type/blank] [:db/add \"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/choices \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\"] [:db/add \"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/correct \"b5c82e9f-45e9-56f1-b2b3-587a314f0438\"] [:db/ensure \"206f288e-0cac-5598-8c44-c001ad2ed7d0\" :answer-field/validate] [:db/add \"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/id #uuid \"64a67543-fe94-530d-98d5-f76b2adaf312\"] [:db/add \"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 2 \\\\cdot 3^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 2 \\\\cdot 3^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{1}^{2} 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right]_{1}^{2}\\\\right)=2\\\\left(\\\\left(\\\\frac{9}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)-\\\\left(\\\\frac{3}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{12}{\\\\ln{\\\\left(3 \\\\right)}}.\\n$$\"] [:db/add \"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/difficulty :question.difficulty/moderate] [:db/add \"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/answer-fields \"206f288e-0cac-5598-8c44-c001ad2ed7d0\"] [:db/ensure \"64a67543-fe94-530d-98d5-f76b2adaf312\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"64a67543-fe94-530d-98d5-f76b2adaf312\"] [:db/add \"dc2e004d-8080-52a5-b013-fa11bc1abf70\" :answer/id #uuid \"dc2e004d-8080-52a5-b013-fa11bc1abf70\"] [:db/add \"dc2e004d-8080-52a5-b013-fa11bc1abf70\" :answer/type :answer.type/math] [:db/add \"dc2e004d-8080-52a5-b013-fa11bc1abf70\" :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\"] [:db/ensure \"dc2e004d-8080-52a5-b013-fa11bc1abf70\" :answer/validate] [:db/add \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/id #uuid \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\"] [:db/add \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/key \"answer\"] [:db/add \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/type :answer-field.type/blank] [:db/add \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/choices \"dc2e004d-8080-52a5-b013-fa11bc1abf70\"] [:db/add \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/correct \"dc2e004d-8080-52a5-b013-fa11bc1abf70\"] [:db/ensure \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\" :answer-field/validate] [:db/add \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/id #uuid \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\"] [:db/add \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 4 \\\\cdot 2^{x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=1&\\\\Longrightarrow u=1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 4 \\\\cdot 2^{x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{1} 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right]_{0}^{1}\\\\right)=2\\\\left(\\\\left(\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)-\\\\left(\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(2 \\\\right)}}.\\n$$\"] [:db/add \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/difficulty :question.difficulty/moderate] [:db/add \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/answer-fields \"be02bd4a-0fb8-5c53-b6bd-9807b05d127c\"] [:db/ensure \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"c76d7b6c-51f9-5398-95b8-ed5e30775bc6\"] [:db/add \"ff9f14c6-e7db-596d-9618-7617d39ec406\" :answer/id #uuid \"ff9f14c6-e7db-596d-9618-7617d39ec406\"] [:db/add \"ff9f14c6-e7db-596d-9618-7617d39ec406\" :answer/type :answer.type/math] [:db/add \"ff9f14c6-e7db-596d-9618-7617d39ec406\" :answer/value \"\\\\frac{80}{\\\\ln{\\\\left(5 \\\\right)}}\"] [:db/ensure \"ff9f14c6-e7db-596d-9618-7617d39ec406\" :answer/validate] [:db/add \"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/id #uuid \"c496f9ed-0027-5df2-9228-5afcf3c033e4\"] [:db/add \"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/key \"answer\"] [:db/add \"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/type :answer-field.type/blank] [:db/add \"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/choices \"ff9f14c6-e7db-596d-9618-7617d39ec406\"] [:db/add \"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/correct \"ff9f14c6-e7db-596d-9618-7617d39ec406\"] [:db/ensure \"c496f9ed-0027-5df2-9228-5afcf3c033e4\" :answer-field/validate] [:db/add \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/id #uuid \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\"] [:db/add \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{1} 4 \\\\cdot 5^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}}\"] [:db/add \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=1&\\\\Longrightarrow u=2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{1} 4 \\\\cdot 5^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{2} 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n4\\\\left(\\\\left[\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right]_{1}^{2}\\\\right)=4\\\\left(\\\\left(\\\\frac{25}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)-\\\\left(\\\\frac{5}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{80}{\\\\ln{\\\\left(5 \\\\right)}}.\\n$$\"] [:db/add \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/difficulty :question.difficulty/moderate] [:db/add \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/answer-fields \"c496f9ed-0027-5df2-9228-5afcf3c033e4\"] [:db/ensure \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"90f1394b-b3e3-58ff-b7a5-aad48e825ede\"] [:db/add \"6e710d08-5bd0-5455-8321-ac9cf801861d\" :answer/id #uuid \"6e710d08-5bd0-5455-8321-ac9cf801861d\"] [:db/add \"6e710d08-5bd0-5455-8321-ac9cf801861d\" :answer/type :answer.type/math] [:db/add \"6e710d08-5bd0-5455-8321-ac9cf801861d\" :answer/value \"3\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right)\"] [:db/ensure \"6e710d08-5bd0-5455-8321-ac9cf801861d\" :answer/validate] [:db/add \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/id #uuid \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\"] [:db/add \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/key \"answer\"] [:db/add \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/type :answer-field.type/blank] [:db/add \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/choices \"6e710d08-5bd0-5455-8321-ac9cf801861d\"] [:db/add \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/correct \"6e710d08-5bd0-5455-8321-ac9cf801861d\"] [:db/ensure \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\" :answer-field/validate] [:db/add \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/id #uuid \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\"] [:db/add \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/worked-solution \"Let $u=2 e^{x} + 3$. Then $\\\\mathrm{d}u=(2 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=7\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=9\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{7}^{9} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{7}^{9}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(9 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(7 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right).\\n$$\"] [:db/add \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/difficulty :question.difficulty/hard] [:db/add \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/answer-fields \"d0ebddaa-9572-5fd7-a266-26fe46eb85cb\"] [:db/ensure \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"1091cf45-3b7c-52f0-96e3-7f79a1caef3d\"] [:db/add \"6b908837-766f-5bfd-b27c-083bbab38bd6\" :answer/id #uuid \"6b908837-766f-5bfd-b27c-083bbab38bd6\"] [:db/add \"6b908837-766f-5bfd-b27c-083bbab38bd6\" :answer/type :answer.type/math] [:db/add \"6b908837-766f-5bfd-b27c-083bbab38bd6\" :answer/value \"3\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right)\\\\right)\"] [:db/ensure \"6b908837-766f-5bfd-b27c-083bbab38bd6\" :answer/validate] [:db/add \"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/id #uuid \"239ff20c-752b-51a5-82e6-f986bc7883a3\"] [:db/add \"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/key \"answer\"] [:db/add \"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/type :answer-field.type/blank] [:db/add \"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/choices \"6b908837-766f-5bfd-b27c-083bbab38bd6\"] [:db/add \"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/correct \"6b908837-766f-5bfd-b27c-083bbab38bd6\"] [:db/ensure \"239ff20c-752b-51a5-82e6-f986bc7883a3\" :answer-field/validate] [:db/add \"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/id #uuid \"3a37439d-e797-5de6-ae99-2c1a68201323\"] [:db/add \"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{3 e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/worked-solution \"Let $u=e^{x} + 2$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=4\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{3 e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{4}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{4}^{5}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(5 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(4 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right)\\\\right).\\n$$\"] [:db/add \"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/difficulty :question.difficulty/hard] [:db/add \"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/answer-fields \"239ff20c-752b-51a5-82e6-f986bc7883a3\"] [:db/ensure \"3a37439d-e797-5de6-ae99-2c1a68201323\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"3a37439d-e797-5de6-ae99-2c1a68201323\"] [:db/add \"e805574d-111d-5acb-9f10-2e8e06520b7e\" :answer/id #uuid \"e805574d-111d-5acb-9f10-2e8e06520b7e\"] [:db/add \"e805574d-111d-5acb-9f10-2e8e06520b7e\" :answer/type :answer.type/math] [:db/add \"e805574d-111d-5acb-9f10-2e8e06520b7e\" :answer/value \"2\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right)\"] [:db/ensure \"e805574d-111d-5acb-9f10-2e8e06520b7e\" :answer/validate] [:db/add \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/id #uuid \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\"] [:db/add \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/key \"answer\"] [:db/add \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/type :answer-field.type/blank] [:db/add \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/choices \"e805574d-111d-5acb-9f10-2e8e06520b7e\"] [:db/add \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/correct \"e805574d-111d-5acb-9f10-2e8e06520b7e\"] [:db/ensure \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\" :answer-field/validate] [:db/add \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/id #uuid \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\"] [:db/add \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/worked-solution \"Let $u=2 e^{x} + 3$. Then $\\\\mathrm{d}u=(2 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=7\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=9\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{2 e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{7}^{9} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{7}^{9}\\\\right)=2\\\\left(\\\\left(\\\\ln{\\\\left(9 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(7 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n2\\\\left(\\\\ln\\\\left(9\\\\right)-\\\\ln\\\\left(7\\\\right)\\\\right).\\n$$\"] [:db/add \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/difficulty :question.difficulty/hard] [:db/add \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/answer-fields \"35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f\"] [:db/ensure \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"4f6d06be-9e6e-5976-ac37-0dfb6633c901\"] [:db/add \"a3a5ef0d-2584-596d-a969-b4816c2e220f\" :answer/id #uuid \"a3a5ef0d-2584-596d-a969-b4816c2e220f\"] [:db/add \"a3a5ef0d-2584-596d-a969-b4816c2e220f\" :answer/type :answer.type/math] [:db/add \"a3a5ef0d-2584-596d-a969-b4816c2e220f\" :answer/value \"3\\\\left(\\\\ln\\\\left(11\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right)\"] [:db/ensure \"a3a5ef0d-2584-596d-a969-b4816c2e220f\" :answer/validate] [:db/add \"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/id #uuid \"6aada5ef-5b85-585e-acee-e36006fe1520\"] [:db/add \"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/key \"answer\"] [:db/add \"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/type :answer-field.type/blank] [:db/add \"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/choices \"a3a5ef0d-2584-596d-a969-b4816c2e220f\"] [:db/add \"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/correct \"a3a5ef0d-2584-596d-a969-b4816c2e220f\"] [:db/ensure \"6aada5ef-5b85-585e-acee-e36006fe1520\" :answer-field/validate] [:db/add \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/id #uuid \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\"] [:db/add \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/worked-solution \"Let $u=3 e^{x} + 2$. Then $\\\\mathrm{d}u=(3 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=8\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=11\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{8}^{11} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{8}^{11}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(11 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(8 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(11\\\\right)-\\\\ln\\\\left(8\\\\right)\\\\right).\\n$$\"] [:db/add \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/difficulty :question.difficulty/hard] [:db/add \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/answer-fields \"6aada5ef-5b85-585e-acee-e36006fe1520\"] [:db/ensure \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"c09871ce-c995-5c32-9eb1-6b8e224d3a60\"] [:db/add \"5a764233-b2f3-5e90-b360-28f68e4e845e\" :answer/id #uuid \"5a764233-b2f3-5e90-b360-28f68e4e845e\"] [:db/add \"5a764233-b2f3-5e90-b360-28f68e4e845e\" :answer/type :answer.type/math] [:db/add \"5a764233-b2f3-5e90-b360-28f68e4e845e\" :answer/value \"4\\\\left(\\\\ln\\\\left(4\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right)\"] [:db/ensure \"5a764233-b2f3-5e90-b360-28f68e4e845e\" :answer/validate] [:db/add \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/id #uuid \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\"] [:db/add \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/key \"answer\"] [:db/add \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/type :answer-field.type/blank] [:db/add \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/choices \"5a764233-b2f3-5e90-b360-28f68e4e845e\"] [:db/add \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/correct \"5a764233-b2f3-5e90-b360-28f68e4e845e\"] [:db/ensure \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\" :answer-field/validate] [:db/add \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/id #uuid \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\"] [:db/add \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/worked-solution \"Let $u=e^{x} + 1$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=3\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=4\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{3}^{4} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n4\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{3}^{4}\\\\right)=4\\\\left(\\\\left(\\\\ln{\\\\left(4 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(3 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n4\\\\left(\\\\ln\\\\left(4\\\\right)-\\\\ln\\\\left(3\\\\right)\\\\right).\\n$$\"] [:db/add \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/difficulty :question.difficulty/hard] [:db/add \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/answer-fields \"423d8c4d-d609-5dd5-aa88-7aeb5927d885\"] [:db/ensure \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"5ed82884-6c8c-5ce4-b237-91d8e5608eef\"] [:db/add \"5f29c0bd-afd6-595d-a791-b40ce5f73018\" :answer/id #uuid \"5f29c0bd-afd6-595d-a791-b40ce5f73018\"] [:db/add \"5f29c0bd-afd6-595d-a791-b40ce5f73018\" :answer/type :answer.type/math] [:db/add \"5f29c0bd-afd6-595d-a791-b40ce5f73018\" :answer/value \"3\\\\left(\\\\ln\\\\left(12\\\\right)-\\\\ln\\\\left(9\\\\right)\\\\right)\"] [:db/ensure \"5f29c0bd-afd6-595d-a791-b40ce5f73018\" :answer/validate] [:db/add \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/id #uuid \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\"] [:db/add \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/key \"answer\"] [:db/add \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/type :answer-field.type/blank] [:db/add \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/choices \"5f29c0bd-afd6-595d-a791-b40ce5f73018\"] [:db/add \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/correct \"5f29c0bd-afd6-595d-a791-b40ce5f73018\"] [:db/ensure \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\" :answer-field/validate] [:db/add \"3a151c81-c4e9-5302-89d7-30f533727337\" :question/id #uuid \"3a151c81-c4e9-5302-89d7-30f533727337\"] [:db/add \"3a151c81-c4e9-5302-89d7-30f533727337\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"3a151c81-c4e9-5302-89d7-30f533727337\" :question/worked-solution \"Let $u=3 e^{x} + 3$. Then $\\\\mathrm{d}u=(3 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=9\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=12\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{9 e^{x}}{3 e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{9}^{12} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{9}^{12}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(12 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(9 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(12\\\\right)-\\\\ln\\\\left(9\\\\right)\\\\right).\\n$$\"] [:db/add \"3a151c81-c4e9-5302-89d7-30f533727337\" :question/difficulty :question.difficulty/hard] [:db/add \"3a151c81-c4e9-5302-89d7-30f533727337\" :question/answer-fields \"fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe\"] [:db/ensure \"3a151c81-c4e9-5302-89d7-30f533727337\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"3a151c81-c4e9-5302-89d7-30f533727337\"] [:db/add \"4e7abd27-c793-5130-9281-c0e31e3590bb\" :answer/id #uuid \"4e7abd27-c793-5130-9281-c0e31e3590bb\"] [:db/add \"4e7abd27-c793-5130-9281-c0e31e3590bb\" :answer/type :answer.type/math] [:db/add \"4e7abd27-c793-5130-9281-c0e31e3590bb\" :answer/value \"\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right)\"] [:db/ensure \"4e7abd27-c793-5130-9281-c0e31e3590bb\" :answer/validate] [:db/add \"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/id #uuid \"a76d7558-16bc-538f-bbb9-c370677b70cf\"] [:db/add \"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/key \"answer\"] [:db/add \"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/type :answer-field.type/blank] [:db/add \"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/choices \"4e7abd27-c793-5130-9281-c0e31e3590bb\"] [:db/add \"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/correct \"4e7abd27-c793-5130-9281-c0e31e3590bb\"] [:db/ensure \"a76d7558-16bc-538f-bbb9-c370677b70cf\" :answer-field/validate] [:db/add \"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/id #uuid \"f311eb5f-107f-5276-825f-873dacb83ed0\"] [:db/add \"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/worked-solution \"Let $u=e^{x} + 2$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=4\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=5\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{e^{x}}{e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{4}^{5} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{4}^{5}=\\\\left(\\\\ln{\\\\left(5 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(4 \\\\right)}\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\ln\\\\left(5\\\\right)-\\\\ln\\\\left(4\\\\right).\\n$$\"] [:db/add \"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/difficulty :question.difficulty/hard] [:db/add \"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/answer-fields \"a76d7558-16bc-538f-bbb9-c370677b70cf\"] [:db/ensure \"f311eb5f-107f-5276-825f-873dacb83ed0\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"f311eb5f-107f-5276-825f-873dacb83ed0\"] [:db/add \"65be0e3e-ffb9-5082-8469-f46219ca3e10\" :answer/id #uuid \"65be0e3e-ffb9-5082-8469-f46219ca3e10\"] [:db/add \"65be0e3e-ffb9-5082-8469-f46219ca3e10\" :answer/type :answer.type/math] [:db/add \"65be0e3e-ffb9-5082-8469-f46219ca3e10\" :answer/value \"3\\\\left(\\\\ln\\\\left(7\\\\right)-\\\\ln\\\\left(5\\\\right)\\\\right)\"] [:db/ensure \"65be0e3e-ffb9-5082-8469-f46219ca3e10\" :answer/validate] [:db/add \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/id #uuid \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\"] [:db/add \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/key \"answer\"] [:db/add \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/type :answer-field.type/blank] [:db/add \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/choices \"65be0e3e-ffb9-5082-8469-f46219ca3e10\"] [:db/add \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/correct \"65be0e3e-ffb9-5082-8469-f46219ca3e10\"] [:db/ensure \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\" :answer-field/validate] [:db/add \"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/id #uuid \"98ccf776-cbef-59ff-bad2-21baea608c07\"] [:db/add \"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{\\\\ln 3}=3$.\\n\\n{{answer}}\"] [:db/add \"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/worked-solution \"Let $u=2 e^{x} + 1$. Then $\\\\mathrm{d}u=(2 e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=5\\\\\\\\x=\\\\ln{\\\\left(3 \\\\right)}&\\\\Longrightarrow u=7\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\ln{\\\\left(2 \\\\right)}}^{\\\\ln{\\\\left(3 \\\\right)}} \\\\frac{6 e^{x}}{2 e^{x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{5}^{7} \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nApply the supplied primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[\\\\ln\\\\left|u\\\\right|\\\\right]_{5}^{7}\\\\right)=3\\\\left(\\\\left(\\\\ln{\\\\left(7 \\\\right)}\\\\right)-\\\\left(\\\\ln{\\\\left(5 \\\\right)}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3\\\\left(\\\\ln\\\\left(7\\\\right)-\\\\ln\\\\left(5\\\\right)\\\\right).\\n$$\"] [:db/add \"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/difficulty :question.difficulty/hard] [:db/add \"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/answer-fields \"b2f64048-00f5-5c3b-9ce2-109de29f04b3\"] [:db/ensure \"98ccf776-cbef-59ff-bad2-21baea608c07\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"98ccf776-cbef-59ff-bad2-21baea608c07\"] [:db/add \"generator\" :question-generator/id #uuid \"899f47a9-534d-5b24-8f10-a6a7afb049e1\"] [:db/add \"generator\" :question-generator/script \"generators/ee/ee9da33b5dfe6b737a0b9d3cdee3ca287b58d1baf4a66ce8dcbf919b38b169f4/generator.py\"] [:db/add 17592186184352 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186184352 :knowledge-point/validate]] \"assertions\" [[\"83fa61f7-f59b-58d0-b70c-040bd7a434dd\" :answer/id #uuid \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\"] [\"83fa61f7-f59b-58d0-b70c-040bd7a434dd\" :answer/type :answer.type/math] [\"83fa61f7-f59b-58d0-b70c-040bd7a434dd\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"8e50e073-4439-5954-8601-35f71817d36c\" :answer/id #uuid \"8e50e073-4439-5954-8601-35f71817d36c\"] [\"8e50e073-4439-5954-8601-35f71817d36c\" :answer/type :answer.type/math] [\"8e50e073-4439-5954-8601-35f71817d36c\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"14821592-dcfc-5bda-b697-e8c065e996ce\" :answer/id #uuid \"14821592-dcfc-5bda-b697-e8c065e996ce\"] [\"14821592-dcfc-5bda-b697-e8c065e996ce\" :answer/type :answer.type/math] [\"14821592-dcfc-5bda-b697-e8c065e996ce\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\" :answer/id #uuid \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\"] [\"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\" :answer/type :answer.type/math] [\"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\" :answer/value \"\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [\"3b294e75-d590-5756-bf3d-1917af5537f3\" :answer/id #uuid \"3b294e75-d590-5756-bf3d-1917af5537f3\"] [\"3b294e75-d590-5756-bf3d-1917af5537f3\" :answer/type :answer.type/math] [\"3b294e75-d590-5756-bf3d-1917af5537f3\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/id #uuid \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/key \"answer\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/type :answer-field.type/radio] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"83fa61f7-f59b-58d0-b70c-040bd7a434dd\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"8e50e073-4439-5954-8601-35f71817d36c\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"14821592-dcfc-5bda-b697-e8c065e996ce\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"dde3e1f4-3028-56ef-bcbc-1ca403bd42ba\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/choices \"3b294e75-d590-5756-bf3d-1917af5537f3\"] [\"25d02d4e-f000-50c2-bb1d-8bbd055737ee\" :answer-field/correct \"3b294e75-d590-5756-bf3d-1917af5537f3\"] [\"f63df859-feae-5a0d-b265-058c2043e45e\" :question/id #uuid \"f63df859-feae-5a0d-b265-058c2043e45e\"] [\"f63df859-feae-5a0d-b265-058c2043e45e\" :question/problem \"Use the substitution $u=2 x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"f63df859-feae-5a0d-b265-058c2043e45e\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=1 + \\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"f63df859-feae-5a0d-b265-058c2043e45e\" :question/difficulty :question.difficulty/easy] [\"f63df859-feae-5a0d-b265-058c2043e45e\" :question/answer-fields \"25d02d4e-f000-50c2-bb1d-8bbd055737ee\"] [17592186184352 :knowledge-point/questions \"f63df859-feae-5a0d-b265-058c2043e45e\"] [\"6cf6996d-5ec3-584e-975c-587892f7556a\" :answer/id #uuid \"6cf6996d-5ec3-584e-975c-587892f7556a\"] [\"6cf6996d-5ec3-584e-975c-587892f7556a\" :answer/type :answer.type/math] [\"6cf6996d-5ec3-584e-975c-587892f7556a\" :answer/value \"8\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2f411cee-34cd-5e43-b660-895da178df5a\" :answer/id #uuid \"2f411cee-34cd-5e43-b660-895da178df5a\"] [\"2f411cee-34cd-5e43-b660-895da178df5a\" :answer/type :answer.type/math] [\"2f411cee-34cd-5e43-b660-895da178df5a\" :answer/value \"-4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"36a8e2f7-f978-534f-b874-d1e004a7aaa5\" :answer/id #uuid \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\"] [\"36a8e2f7-f978-534f-b874-d1e004a7aaa5\" :answer/type :answer.type/math] [\"36a8e2f7-f978-534f-b874-d1e004a7aaa5\" :answer/value \"2\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"4f1a2b97-8de2-52e4-9533-56f22bb26d91\" :answer/id #uuid \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\"] [\"4f1a2b97-8de2-52e4-9533-56f22bb26d91\" :answer/type :answer.type/math] [\"4f1a2b97-8de2-52e4-9533-56f22bb26d91\" :answer/value \"12\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\" :answer/id #uuid \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\"] [\"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\" :answer/type :answer.type/math] [\"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\" :answer/value \"4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/id #uuid \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/key \"answer\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/type :answer-field.type/radio] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"6cf6996d-5ec3-584e-975c-587892f7556a\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"2f411cee-34cd-5e43-b660-895da178df5a\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"36a8e2f7-f978-534f-b874-d1e004a7aaa5\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"4f1a2b97-8de2-52e4-9533-56f22bb26d91\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/choices \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\"] [\"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\" :answer-field/correct \"d3ba5524-fc3d-50c8-a2c1-9c249c0f62ea\"] [\"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/id #uuid \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\"] [\"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/problem \"Use the substitution $u=x + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/difficulty :question.difficulty/easy] [\"9a6ff84e-e750-5aa7-9f84-c61045cf777c\" :question/answer-fields \"e1f809ca-a5d1-58af-9fdd-380bbfa03d9f\"] [17592186184352 :knowledge-point/questions \"9a6ff84e-e750-5aa7-9f84-c61045cf777c\"] [\"0c7fe7a5-27b9-562d-8405-612baecc779a\" :answer/id #uuid \"0c7fe7a5-27b9-562d-8405-612baecc779a\"] [\"0c7fe7a5-27b9-562d-8405-612baecc779a\" :answer/type :answer.type/math] [\"0c7fe7a5-27b9-562d-8405-612baecc779a\" :answer/value \"-2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\" :answer/id #uuid \"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\"] [\"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\" :answer/type :answer.type/math] [\"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\" :answer/value \"6\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"3f30ae78-7958-56b5-8269-99571ff177bf\" :answer/id #uuid \"3f30ae78-7958-56b5-8269-99571ff177bf\"] [\"3f30ae78-7958-56b5-8269-99571ff177bf\" :answer/type :answer.type/math] [\"3f30ae78-7958-56b5-8269-99571ff177bf\" :answer/value \"\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [\"acf50591-a0c3-5342-b6a5-d93fb7909e0a\" :answer/id #uuid \"acf50591-a0c3-5342-b6a5-d93fb7909e0a\"] [\"acf50591-a0c3-5342-b6a5-d93fb7909e0a\" :answer/type :answer.type/math] [\"acf50591-a0c3-5342-b6a5-d93fb7909e0a\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"7a942d42-f286-5365-8191-58ec155c08a2\" :answer/id #uuid \"7a942d42-f286-5365-8191-58ec155c08a2\"] [\"7a942d42-f286-5365-8191-58ec155c08a2\" :answer/type :answer.type/math] [\"7a942d42-f286-5365-8191-58ec155c08a2\" :answer/value \"4\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/id #uuid \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/key \"answer\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/type :answer-field.type/radio] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"0c7fe7a5-27b9-562d-8405-612baecc779a\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"3f30ae78-7958-56b5-8269-99571ff177bf\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"acf50591-a0c3-5342-b6a5-d93fb7909e0a\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/choices \"7a942d42-f286-5365-8191-58ec155c08a2\"] [\"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\" :answer-field/correct \"acf50591-a0c3-5342-b6a5-d93fb7909e0a\"] [\"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/id #uuid \"cbb1ce86-4054-5654-9040-b3e8073157c6\"] [\"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/difficulty :question.difficulty/easy] [\"cbb1ce86-4054-5654-9040-b3e8073157c6\" :question/answer-fields \"de6d7507-7b4b-57ef-95b5-7ef96cc8d94f\"] 