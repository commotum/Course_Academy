928}] :answer-field/correct {:answer/id #uuid "50f90dfe-d802-574a-8ed8-759b5057b926" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266869} :answer-field/id #uuid "db7fea76-3c9e-5620-891f-f29f43564753" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268797}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8b4cba33-ddfb-53fe-af87-4270187c1909" :question/math-academy-id "q-13751" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5{e}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}{e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡3} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{5}{2}(3-1) \\\\  & =\\frac{5}{2}(2) \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5bf8a0-a538-5131-b32d-777d76c86e0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3\\ln 2}" :db/id #edb/ref 17592186183061} {:answer/id #uuid "00154e8b-a47a-59a6-9e54-9aee8af6344c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6\\ln 2}" :db/id #edb/ref 17592186183062} {:answer/id #uuid "3185e3f8-9923-5b43-9df1-2a552956c3a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6\\ln 2}" :db/id #edb/ref 17592186183063} {:answer/id #uuid "42546591-d960-5ea6-822b-c544d4094b17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2\\ln 2}" :db/id #edb/ref 17592186183064} {:answer/id #uuid "79a4d23b-d2d8-5bbc-814e-532fcf20645f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8\\ln 2}" :db/id #edb/ref 17592186183065}] :answer-field/id #uuid "95360911-bf76-5292-82a2-81c244f28aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183060}] :question/id #uuid "3c1f6565-c9e4-53b3-bf2f-682503382e07" :question/math-academy-id "q-30977" :question/problem "Evaluate the integral $$\n\\displaystyle \\int_{0}^{1}x2^{3x^{2}}dx.\n$$"} {:db/id #edb/ref 17592186297313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "819b16a3-f7a6-565b-b3ef-3936ba7715f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186295964} {:answer/id #uuid "887f9f69-8383-56d4-b68c-b8cfc625db4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186296002} {:answer/id #uuid "ccfd95ae-9589-58f8-99d6-dc27d8a4b715" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186296340} {:answer/id #uuid "d14bc0b9-fea2-545e-9860-0eceaf4fb7d1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296368} {:answer/id #uuid "f5ac6476-516e-5949-a1aa-b0dc8472989d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186296571}] :answer-field/correct {:answer/id #uuid "887f9f69-8383-56d4-b68c-b8cfc625db4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186296002} :answer-field/id #uuid "87845b5e-5ef2-542f-81a3-6d45bf09aa5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296913}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d27a3338-cb0f-5ca8-99dd-ea66c994efb5" :question/math-academy-id "q-30953" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=2{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡5}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2\\operatorname{ln}⁡5$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}{e}^{2{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{20}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{20}{e}^{u}\\,{|}_{0}^{2\\operatorname{ln}⁡5} \\\\  & =\\frac{1}{20}({e}^{2\\operatorname{ln}⁡5}-{e}^{0}) \\\\  & =\\frac{1}{20}(25-1) \\\\  & =\\frac{24}{20} \\\\  & =\\frac{6}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ccece4-65c4-5e5c-8817-3a18dce11af4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186295310} {:answer/id #uuid "84942b44-5495-5682-952a-911af4e4422c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡2}{3}" :db/id #edb/ref 17592186295978} {:answer/id #uuid "bfed6b15-aecc-5150-b7ae-098abfc895f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡2}{4}" :db/id #edb/ref 17592186296281} {:answer/id #uuid "c1be6811-0f82-5ed6-a4cb-46cd3b3d2590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296291} {:answer/id #uuid "cebdb2d9-074e-514a-9533-ddadbb7aad7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296351}] :answer-field/correct {:answer/id #uuid "c1be6811-0f82-5ed6-a4cb-46cd3b3d2590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296291} :answer-field/id #uuid "f8639f62-79b8-5cc0-8a72-d453dd46c5a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7481f370-fa2c-5189-a8ea-31c09e902fb8" :question/math-academy-id "q-30978" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{4}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}{4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}\\,{|}_{0}^{1} \\\\  & =\\frac{1}{2\\operatorname{ln}⁡4}(4-1) \\\\  & =\\frac{3}{2\\operatorname{ln}⁡4} \\\\  & =\\frac{3}{4\\operatorname{ln}⁡2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd2ee4a-9bd2-5dd9-bf3f-33b0c730a0e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186317699}] :answer-field/correct {:answer/id #uuid "2bd2ee4a-9bd2-5dd9-bf3f-33b0c730a0e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186317699} :answer-field/id #uuid "4ab28277-8243-5753-94c4-46d003e744e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318588}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03065e0a-3e2d-519b-9716-a27401bbed9d" :question/math-academy-id "q-346400" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{0}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{1}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(3-1) \\\\  & =\\frac{2}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a45e9d32-be80-51d7-b4d0-0082a4e9941a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186319882}] :answer-field/correct {:answer/id #uuid "a45e9d32-be80-51d7-b4d0-0082a4e9941a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186319882} :answer-field/id #uuid "e8bd78c3-38e4-5e76-9e6e-43ae4383b2eb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320645}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5669eaaa-dc6f-518c-94e2-a518478a7aa8" :question/math-academy-id "q-350740" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}+\\operatorname{ln}⁡2.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡2}$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡2$ | $4\\operatorname{ln}⁡2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}{e}^{u}\\,{|}_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2} \\\\  & =\\frac{1}{6}({e}^{4\\operatorname{ln}⁡2}-{e}^{\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{6}(16-2) \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f28b6429-4e66-5c8e-bb3f-5daf1daa32a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186320115}] :answer-field/correct {:answer/id #uuid "f28b6429-4e66-5c8e-bb3f-5daf1daa32a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186320115} :answer-field/id #uuid "174ca392-0304-5d05-b095-f15caadd5198" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320215}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5411d5fe-3637-5792-875a-d180b054e392" :question/math-academy-id "q-350743" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=2x+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x & ={\\int }_{1}^{3}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{1}^{3} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{3}-{3}^{1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(27-3) \\\\  & =\\frac{24}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bae22f-c29c-57f9-8e20-c50243b1f0f5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}\\left(\\frac{16}{7}\\right)" :db/id #edb/ref 17592186319463}] :answer-field/correct {:answer/id #uuid "18bae22f-c29c-57f9-8e20-c50243b1f0f5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}\\left(\\frac{16}{7}\\right)" :db/id #edb/ref 17592186319463} :answer-field/id #uuid "2ea49404-1273-5753-90c5-6d44c92c292b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320273}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "951fb591-2a64-51d6-a9bd-1ec21eaafe23" :question/math-academy-id "q-350751" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{e}^{x}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{x}\\,⟹\\,\\text{d}u=3{e}^{x}\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $\\operatorname{ln}⁡2$ | $\\operatorname{ln}⁡5$ |\n| --- | --- | --- |\n| $u$ | $7$ | $16$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{4}{3{e}^{x}+1}\\cdot 3{e}^{x}\\,\\text{d}x \\\\  & ={\\int }_{7}^{16}\\frac{4}{u}\\cdot \\,\\text{d}u \\\\  & =4{\\int }_{7}^{16}\\frac{1}{u}\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡|u|\\,{|}_{7}^{16} \\\\  & =4(\\operatorname{ln}⁡(16)-\\operatorname{ln}⁡(7)) \\\\  & =4\\operatorname{ln}⁡\\left(\\frac{16}{7}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186608214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a6451b-a04e-5424-95e0-ae56be129001" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26}{3}" :db/id #edb/ref 17592186607961} {:answer/id #uuid "94690ad0-d739-55f6-ac9d-9dc3576b64cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186607976} {:answer/id #uuid "9701597e-08b1-5e0d-a435-680d10de4650" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{6}" :db/id #edb/ref 17592186607983} {:answer/id #uuid "ae5ec5aa-483b-5010-8086-97f7bd646db3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186608009} {:answer/id #uuid "fd68ec79-2ca6-5501-9c03-063ed7a2a24d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{6}" :db/id #edb/ref 17592186608087}] :answer-field/correct {:answer/id #uuid "84a6451b-a04e-5424-95e0-ae56be129001" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26}{3}" :db/id #edb/ref 17592186607961} :answer-field/id #uuid "8829197f-1f69-56f1-a9e9-7d8daf594f9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608125}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "abccef89-be65-544a-a90d-e214a5be7183" :question/math-academy-id "q-30947" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}2x{e}^{3{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{3}\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $3\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}2x{e}^{3{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}{e}^{3{x}^{2}}\\cdot 2x\\,\\text{d}x \\\\  & ={\\int }_{0}^{3\\operatorname{ln}⁡3}{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{0}^{3\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}\\,{|}_{0}^{3\\operatorname{ln}⁡3} \\\\  & =\\frac{1}{3}({e}^{3\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{1}{3}({3}^{3}-1) \\\\  & =\\frac{1}{3}(27-1) \\\\  & =\\frac{26}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186627714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158f6da0-5a06-5168-856b-cc91f1475541" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186627133} {:answer/id #uuid "29056c93-7a46-5bad-b7ed-f96eb4d222b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186627164} {:answer/id #uuid "5782f199-9bda-541c-aa3b-3cfd908c9071" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186627241} {:answer/id #uuid "5a9dc582-8e68-50bd-9671-e81de6c58436" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186627248} {:answer/id #uuid "bd3c3c7c-ee8f-5fd8-9f4a-dad2af3ea9f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186627403}] :answer-field/correct {:answer/id #uuid "29056c93-7a46-5bad-b7ed-f96eb4d222b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186627164} :answer-field/id #uuid "3c7d1fbe-e3cb-5274-a242-c947f78275d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186627568}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a5f7af17-ee7d-5acb-82dd-5d6d5422661e" :question/math-academy-id "q-30954" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡8}}x{e}^{{x}^{2}/3}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=\\frac{{x}^{2}}{3}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{3}x\\,⟹\\,\\frac{3}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡8}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\operatorname{ln}⁡8}{3}$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡8}}x{e}^{{x}^{2}/3}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡8}}{e}^{{x}^{2}/3}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{(\\operatorname{ln}⁡8)/3}{e}^{u}\\cdot \\frac{3}{2}\\,\\text{d}u \\\\  & =\\frac{3}{2}{\\int }_{0}^{(\\operatorname{ln}⁡8)/3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{3}{2}{e}^{u}\\,{|}_{0}^{(\\operatorname{ln}⁡8)/3} \\\\  & =\\frac{3}{2}({e}^{(\\operatorname{ln}⁡8)/3}-{e}^{0}) \\\\  & =\\frac{3}{2}(\\sqrt[3]{8}-1) \\\\  & =\\frac{3}{2}(2-1) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating Definite Integrals"}]}
