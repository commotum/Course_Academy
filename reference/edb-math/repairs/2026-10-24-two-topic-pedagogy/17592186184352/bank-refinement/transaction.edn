1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "76f7ab34-158b-5e28-b158-c95c23947019" :question/difficulty :question.difficulty/easy] [:db/add "76f7ab34-158b-5e28-b158-c95c23947019" :question/answer-fields "713fac61-ef34-51fb-817e-d09d93c50f98"] [:db/ensure "76f7ab34-158b-5e28-b158-c95c23947019" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "76f7ab34-158b-5e28-b158-c95c23947019"] [:db/add "b3f88e14-20f8-5580-b051-c32251fa8458" :answer/id #uuid "b3f88e14-20f8-5580-b051-c32251fa8458"] [:db/add "b3f88e14-20f8-5580-b051-c32251fa8458" :answer/type :answer.type/math] [:db/add "b3f88e14-20f8-5580-b051-c32251fa8458" :answer/value "4\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "b3f88e14-20f8-5580-b051-c32251fa8458" :answer/validate] [:db/add "892abda1-3beb-54b5-be50-3794091e0b4a" :answer/id #uuid "892abda1-3beb-54b5-be50-3794091e0b4a"] [:db/add "892abda1-3beb-54b5-be50-3794091e0b4a" :answer/type :answer.type/math] [:db/add "892abda1-3beb-54b5-be50-3794091e0b4a" :answer/value "\\frac{4}{3}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "892abda1-3beb-54b5-be50-3794091e0b4a" :answer/validate] [:db/add "68f2aa6c-a141-50f1-b436-14e663c4a9f2" :answer/id #uuid "68f2aa6c-a141-50f1-b436-14e663c4a9f2"] [:db/add "68f2aa6c-a141-50f1-b436-14e663c4a9f2" :answer/type :answer.type/math] [:db/add "68f2aa6c-a141-50f1-b436-14e663c4a9f2" :answer/value "12\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "68f2aa6c-a141-50f1-b436-14e663c4a9f2" :answer/validate] [:db/add "d902dad2-758c-5116-b6fa-7a24cf480ab8" :answer/id #uuid "d902dad2-758c-5116-b6fa-7a24cf480ab8"] [:db/add "d902dad2-758c-5116-b6fa-7a24cf480ab8" :answer/type :answer.type/math] [:db/add "d902dad2-758c-5116-b6fa-7a24cf480ab8" :answer/value "-8\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)"] [:db/ensure "d902dad2-758c-5116-b