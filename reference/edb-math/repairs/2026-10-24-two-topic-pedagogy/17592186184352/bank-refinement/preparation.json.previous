db/add \"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"fe4b6e97-c5d7-5288-bd23-256fad4057bd\"] [:db/add \"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"1a9217bf-0966-5d73-be18-6a16f3d4bc52\"] [:db/add \"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"d359e514-7ef1-5527-b155-52639697395d\"] [:db/add \"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"915745e1-460a-57cc-aef8-ec82802a8f18\"] [:db/add \"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/correct \"93bbc09e-f842-560b-ac12-2acd6733ae28\"] [:db/ensure \"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/validate] [:db/add \"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/id #uuid \"53bd9046-a0c9-5aa2-9147-c7683893ad69\"] [:db/add \"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/difficulty :question.difficulty/easy] [:db/add \"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/answer-fields \"88a007b6-0dbf-51de-8960-f63825b3a10c\"] [:db/ensure \"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"53bd9046-a0c9-5aa2-9147-c7683893ad69\"] [:db/add \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\" :answer/id #uuid \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\"] [:db/add \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\" :answer/type :answer.type/math] [:db/add \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\" :answer/validate] [:db/add \"47ba7e27-d95f-53da-9fa3-092d1065fce5\" :answer/id #uuid \"47ba7e27-d95f-53da-9fa3-092d1065fce5\"] [:db/add \"47ba7e27-d95f-53da-9fa3-092d1065fce5\" :answer/type :answer.type/math] [:db/add \"47ba7e27-d95f-53da-9fa3-092d1065fce5\" :answer/value \"\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"47ba7e27-d95f-53da-9fa3-092d1065fce5\" :answer/validate] [:db/add \"1a051e72-0189-5d67-9af5-1825d0c9a576\" :answer/id #uuid \"1a051e72-0189-5d67-9af5-1825d0c9a576\"] [:db/add \"1a051e72-0189-5d67-9af5-1825d0c9a576\" :answer/type :answer.type/math] [:db/add \"1a051e72-0189-5d67-9af5-1825d0c9a576\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"1a051e72-0189-5d67-9af5-1825d0c9a576\" :answer/validate] [:db/add \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\" :answer/id #uuid \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\"] [:db/add \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\" :answer/type :answer.type/math] [:db/add \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\" :answer/validate] [:db/add \"01edcfb0-1be4-5a08-a733-b778047e9f93\" :answer/id #uuid \"01edcfb0-1be4-5a08-a733-b778047e9f93\"] [:db/add \"01edcfb0-1be4-5a08-a733-b778047e9f93\" :answer/type :answer.type/math] [:db/add \"01edcfb0-1be4-5a08-a733-b778047e9f93\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"01edcfb0-1be4-5a08-a733-b778047e9f93\" :answer/validate] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/id #uuid \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\"] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/key \"answer\"] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/type :answer-field.type/radio] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\"] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"47ba7e27-d95f-53da-9fa3-092d1065fce5\"] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"1a051e72-0189-5d67-9af5-1825d0c9a576\"] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\"] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"01edcfb0-1be4-5a08-a733-b778047e9f93\"] [:db/add \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/correct \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\"] [:db/ensure \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/validate] [:db/add \"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/id #uuid \"52e02874-77ba-5369-b00d-24ca76a8bc3e\"] [:db/add \"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/difficulty :question.difficulty/easy] [:db/add \"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/answer-fields \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\"] [:db/ensure \"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"52e02874-77ba-5369-b00d-24ca76a8bc3e\"] [:db/add \"199834a8-15c7-5192-8598-d7b4fe32b3e5\" :answer/id #uuid \"199834a8-15c7-5192-8598-d7b4fe32b3e5\"] [:db/add \"199834a8-15c7-5192-8598-d7b4fe32b3e5\" :answer/type :answer.type/math] [:db/add \"199834a8-15c7-5192-8598-d7b4fe32b3e5\" :answer/value \"-1\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"199834a8-15c7-5192-8598-d7b4fe32b3e5\" :answer/validate] [:db/add \"e6e77070-9eb8-52c3-8cb1-ff98baac7736\" :answer/id #uuid \"e6e77070-9eb8-52c3-8cb1-ff98baac7736\"] [:db/add \"e6e77070-9eb8-52c3-8cb1-ff98baac7736\" :answer/type :answer.type/math] [:db/add \"e6e77070-9eb8-52c3-8cb1-ff98baac7736\" :answer/value \"-3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e6e77070-9eb8-52c3-8cb1-ff98baac7736\" :answer/validate] [:db/add \"dda6465f-4977-552d-a47c-45412648ecb3\" :answer/id #uuid \"dda6465f-4977-552d-a47c-45412648ecb3\"] [:db/add \"dda6465f-4977-552d-a47c-45412648ecb3\" :answer/type :answer.type/math] [:db/add \"dda6465f-4977-552d-a47c-45412648ecb3\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"dda6465f-4977-55