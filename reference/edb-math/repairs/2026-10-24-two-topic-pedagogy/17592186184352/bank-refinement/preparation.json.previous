  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"e083781d-f59e-57f7-8b88-45c3635074f1\" :answer/id #uuid \"e083781d-f59e-57f7-8b88-45c3635074f1\"] [:db/add \"e083781d-f59e-57f7-8b88-45c3635074f1\" :answer/type :answer.type/math] [:db/add \"e083781d-f59e-57f7-8b88-45c3635074f1\" :answer/value \"-1\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e083781d-f59e-57f7-8b88-45c3635074f1\" :answer/validate] [:db/add \"6e5b6957-7d12-560b-921c-cd818f7f1540\" :answer/id #uuid \"6e5b6957-7d12-560b-921c-cd818f7f1540\"] [:db/add \"6e5b6957-7d12-560b-921c-cd818f7f1540\" :answer/type :answer.type/math] [:db/add \"6e5b6957-7d12-560b-921c-cd818f7f1540\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6e5b6957-7d12-560b-921c-cd818f7f1540\" :answer/validate] [:db/add \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\" :answer/id #uuid \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\"] [:db/add \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\" :answer/type :answer.type/math] [:db/add \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\" :answer/validate] [:db/add \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\" :answer/id #uuid \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\"] [:db/add \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\" :answer/type :answer.type/math] [:db/add \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\" :answer/validate] [:db/add \"068e39e7-31c1-5e97-be76-23a2af3433d2\" :answer/id #uuid \"068e39e7-31c1-5e97-be76-23a2af3433d2\"] [:db/add \"068e39e7-31c1-5e97-be76-23a2af3433d2\" :answer/type :answer.type/math] [:db/add \"068e39e7-31c1-5e97-be76-23a2af3433d2\" :answer/value \"2\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"068e39e7-31c1-5e97-be76-23a2af3433d2\" :answer/validate] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/id #uuid \"713fac61-ef34-51fb-817e-d09d93c50f98\"] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/key \"answer\"] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/type :answer-field.type/radio] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"e083781d-f59e-57f7-8b88-45c3635074f1\"] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"6e5b6957-7d12-560b-921c-cd818f7f1540\"] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\"] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\"] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"068e39e7-31c1-5e97-be76-23a2af3433d2\"] [:db/add \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/correct \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\"] [:db/ensure \"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/validate] [:db/add \"76f7ab34-158b-5e28-b158-c95c23947019\" :question/id #uuid \"76f7ab34-158b-5e28-b158-c95c23947019\"] [:db/add \"76f7ab34-158b-5e28-b158-c95c23947019\" :question/problem \"Use the substitution $u=2 x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"76f7ab34-158b-5e28-b158-c95c23947019\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=1 + \\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"76f7ab34-158b-5e28-b158-c95c23947019\" :question/difficulty :question.difficulty/easy] [:db/add \"76f7ab34-158b-5e28-b158-c95c23947019\" :question/answer-fields \"713fac61-ef34-51fb-817e-d09d93c50f98\"] [:db/ensure \"76f7ab34-158b-5e28-b158-c95c23947019\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"76f7ab34-158b-5e28-b158-c95c23947019\"] [:db/add \"b3f88e14-20f8-5580-b051-c32251fa8458\" :answer/id #uuid \"b3f88e14-20f8-5580-b051-c32251fa8458\"] [:db/add \"b3f88e14-20f8-5580-b051-c32251fa8458\" :answer/type :answer.type/math] [:db/add \"b3f88e14-20f8-5580-b051-c32251fa8458\" :answer/value \"4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b3f88e14-20f8-5580-b051-c32251fa8458\" :answer/validate] [:db/add \"892abda1-3beb-54b5-be50-3794091e0b4a\" :answer/id #uuid \"892abda1-3beb-54b5-be50-3794091e0b4a\"] [:db/add \"892abda1-3beb-54b5-be50-3794091e0b4a\" :answer/type :answer.type/math] [:db/add \"892abda1-3beb-54b5-be50-3794091e0b4a\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"892abda1-3beb-54b5-be50-3794091e0b4a\" :answer/validate] [:db/add \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\" :answer/id #uuid \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\"] [:db/add \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\" :answer/type :answer.type/math] [:db/add \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\" :answer/value \"12\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\" :answer/validate] [:db/add \"d902dad2-758c-5116-b6fa-7a24cf480ab8\" :answer/id #uuid \"d902dad2-758c-5116-b6fa-7a24cf480ab8\"] [:db/add \"d902dad2-758c-5116-b6fa-7a24cf480ab8\" :answer/type :answer.type/math] [:db/add \"d902dad2-758c-5116-b6fa-7a24cf480ab8\" :answer/value \"-8\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d902dad2-758c-5116-b6fa-7a24cf480ab8\" :answer/validate] [:db/add \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\" :answer/id #uuid \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\"] [:db/add \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\" :answer/type :answer.type/math] [:db/add \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\" :answer/value \"8\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\" :answer/validate] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/id #uuid \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\"] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/key \"answer\"] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/type :answer-field.type/radio] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"b3f88e14-20f8-5580-b051-c32251fa8458\"] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"892abda1-3beb-54b5-be50-3794091e0b4a\"] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\"] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"d902dad2-758c-5116-b6fa-7a24cf480ab8\"] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\"] [:db/add \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/correct \"b3f88e14-20f8-5580-b051-c32251fa8458\"] [:db/ensure \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/validate] [:db/add \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/id #uuid \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\"] [:db/add \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/problem \"Use the substitution $u=x + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/difficulty :question.difficulty/easy] [:db/add \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/answer-fields \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\"] [:db/ensure \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\"] [:db/add \"93bbc09e-f842-560b-ac12-2acd6733ae28\" :answer/id #uuid \"93bbc09e-f842-560b-ac12-2acd6733ae28\"] [:db/add \"93bbc09e-f842-560b-ac12-2acd6733ae28\" :answer/type :answer.type/math] [:db/add \"93bbc09e-f842-560b-ac12-2acd6733ae28\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"93bbc09e-f842-560b-ac12-2acd6733ae28\" :answer/validate] [:db/add \"fe4b6e97-c5d7-5288-bd23-256fad4057bd\" :answer/id #uuid \"fe4b6e97-c5d7-5288-bd23-256fad40