5-ac94-e0d97819ed0d\"] [:db/add \"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/difficulty :question.difficulty/easy] [:db/add \"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/answer-fields \"a8dfa04e-c89e-595c-9e56-25d05f83cac4\"] [:db/ensure \"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"df68770e-204f-5785-ac94-e0d97819ed0d\"] [:db/add \"6741cb8e-88a0-5ce1-976c-237d3ec49113\" :answer/id #uuid \"6741cb8e-88a0-5ce1-976c-237d3ec49113\"] [:db/add \"6741cb8e-88a0-5ce1-976c-237d3ec49113\" :answer/type :answer.type/math] [:db/add \"6741cb8e-88a0-5ce1-976c-237d3ec49113\" :answer/value \"3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6741cb8e-88a0-5ce1-976c-237d3ec49113\" :answer/validate] [:db/add \"8e31ec6b-6202-5f44-826d-864aebcbda07\" :answer/id #uuid \"8e31ec6b-6202-5f44-826d-864aebcbda07\"] [:db/add \"8e31ec6b-6202-5f44-826d-864aebcbda07\" :answer/type :answer.type/math] [:db/add \"8e31ec6b-6202-5f44-826d-864aebcbda07\" :answer/value \"\\\\frac{9}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"8e31ec6b-6202-5f44-826d-864aebcbda07\" :answer/validate] [:db/add \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\" :answer/id #uuid \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\"] [:db/add \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\" :answer/type :answer.type/math] [:db/add \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\" :answer/value \"-3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\" :answer/validate] [:db/add \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\" :answer/id #uuid \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\"] [:db/add \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\" :answer/type :answer.type/math] [:db/add \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\" :answer/validate] [:db/add \"a930e23a-ba33-5764-b728-ef56fda55b85\" :answer/id #uuid \"a930e23a-ba33-5764-b728-ef56fda55b85\"] [:db/add \"a930e23a-ba33-5764-b728-ef56fda55b85\" :answer/type :answer.type/math] [:db/add \"a930e23a-ba33-5764-b728-ef56fda55b85\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a930e23a-ba33-5764-b728-ef56fda55b85\" :answer/validate] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/id #uuid \"bf4d12c4-daec-568d-a743-88e4a6fbb320\"] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/key \"answer\"] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/type :answer-field.type/radio] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"6741cb8e-88a0-5ce1-976c-237d3ec49113\"] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"8e31ec6b-6202-5f44-826d-864aebcbda07\"] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\"] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\"] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"a930e23a-ba33-5764-b728-ef56fda55b85\"] [:db/add \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/correct \"a930e23a-ba33-5764-b728-ef56fda55b85\"] [:db/ensure \"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/validate] [:db/add \"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/id #uuid \"15afb047-7ab9-5689-8017-2b19eb22c6ce\"] [:db/add \"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/difficulty :question.difficulty/easy] [:db/add \"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/answer-fields \"bf4d12c4-daec-568d-a743-88e4a6fbb320\"] [:db/ensure \"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"15afb047-7ab9-5689-8017-2b19eb22c6ce\"] [:db/add \"1f25d427-cd19-5c12-ab57-65a29c84b094\" :answer/id #uuid \"1f25d427-cd19-5c12-ab57-65a29c84b094\"] [:db/add \"1f25d427-cd19-5c12-ab57-65a29c84b094\" :answer/type :answer.type/math] [:db/add \"1f25d427-cd19-5c12-ab57-65a29c84b094\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"1f25d427-cd19-5c12-ab57-65a29c84b094\" :answer/validate] [:db/add \"f44e02e1-d06f-5224-acac-0442b3d22e19\" :answer/id #uuid \"f44e02e1-d06f-5224-acac-0442b3d22e19\"] [:db/add \"f44e02e1-d06f-5224-acac-0442b3d22e19\" :answer/type :answer.type/math] [:db/add \"f44e02e1-d06f-5224-acac-0442b3d22e19\" :answer/value \"2\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f44e02e1-d06f-5224-acac-0442b3d22e19\" :answer/validate] [:db/add \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\" :answer/id #uuid \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\"] [:db/add \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\" :answer/type :answer.type/math] [:db/add \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\" :answer/validate] [:db/add \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\" :answer/id #uuid \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\"] [:db/add \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\" :answer/type :answer.type/math] [:db/add \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\" :answer/validate] [:db/add \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\" :answer/id #uuid \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\"] [:db/add \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\" :answer/type :answer.type/math] [:db/add \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\" :answer/validate] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/id #uuid \"0940ea7b-77fe-5dff-b178-39085ba3d487\"] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/key \"answer\"] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/type :answer-field.type/radio] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"1f25d427-cd19-5c12-ab57-65a29c84b094\"] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"f44e02e1-d06f-5224-acac-0442b3d22e19\"] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\"] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\"] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\"] [:db/add \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/correct \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\"] [:db/ensure \"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/validate] [:db/add \"918aae66-2616-5579-b040-086f3e44e133\" :question/id #uuid \"918aae66-2616-5579-b040-086f3e44e133\"] [:db/add \"918aae66-2616-5579-b040-086f3e44e133\" :question/problem \"Use the substitution $u=x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"918aae66-2616-5579-b040-086f3e44e133\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"918aae66-2616-5579-b040-086f3e44e133\" :question/difficulty :question.difficulty/easy] [:db/add \"918aae66-2616-5579-b040-086f3e44e133\" :question/answer-fields \"0940ea7b-77fe-5dff-b178-39085ba3d487\"] [:db/ensure \"918aae66-2616-5579-b040-086f3e44e133\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"918aae66-2616-5579-b040-086f3e44e133\"] [:db/add \"35793bcb-5557-56d7-8333-59d88d526e20\" :answer/id #uuid \"35793bcb-5557-56d7-8333-59d88d526e20\"] [:db/add \"35793bcb-5557-56d7-8333-59d88d526e20\" :answer/type :answer.type/math] [:db/add \"35793bcb-5557-56d7-8333-59d88d526e20\" :answer/value \"6\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"35793bcb-5557-56d7-8333-59d88d526e20\" :answer/validate] [:db/add \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\" :answer/id #uuid \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\"] [:db/add \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\" :answer/type :answer.type/math] [:db/add \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\" :answer/value \"\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\" :answer/validate] [:db/add \"bb044171-5255-5057-b5a0-5f668d3a5586\" :answer/id #uuid \"bb044171-5255-5057-b5a0-5f668d3a5586\"] [:db/add \"bb044171-5255-5057-b5a0-5f668d3a5586\" :answer/type :answer.type/math] [:db/add \"bb044171-5255-5057-b5a0-5f668d3a5586\" :answer/value \"-9\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"bb044171-5255-5057-b5a0-5f668d3a5586\" :answer/validate] [:db/add \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\" :answer/id #uuid \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\"] [:db/add \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\" :answer/type :answer.type/math] [:db/add \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\" :answer/value \"3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\" :answer/validate] [:db/add \"c1af244a-1e63-5104-a874-6082ca45acad\" :answer/id #uuid \"c1af244a-1e63-5104-a874-6082ca45acad\"] [:db/add \"c1af244a-1e63-5104-a874-6082ca45acad\" :answer/type :answer.type/math] [:db/add \"c1af244a-1e63-5104-a874-6082ca45acad\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c1af244a-1e63-5104-a874-6082ca45acad\" :answer/validate] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/id #uuid \"ca691ac6-c678-571a-a6df-f3d1703c46df\"] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/key \"answer\"] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/type :answer-field.type/radio] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"35793bcb-5557-56d7-8333-59d88d526e20\"] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\"] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"bb044171-5255-5057-b5a0-5f668d3a5586\"] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\"] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"c1af244a-1e63-5104-a874-6082ca45acad\"] [:db/add \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/correct \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\"] [:db/ensure \"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/validate] [:db/add \"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/id #uuid \"b307b28c-7447-5305-a106-a972e7d5a9ca\"] [:db/add \"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/problem \"Use the substitution $u=x + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/worked-solution \"Let $u=x + 2$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/difficulty :question.difficulty/easy] [:db/add \"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/answer-fields \"ca691ac6-c678-571a-a6df-f3d1703c46df\"] [:db/ensure \"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"b307b28c-7447-5305-a106-a972e7d5a9ca\"] [:db/add \"generator\" :question-generator/id #uuid \"0d77e88d-b0ed-58b3-a582-648c57486271\"] [:db/add \"generator\" :question-generator/script \"generators/37/37402cb3521a8ab2a4f5800c6d697c6fe3c49fcd27a819b91e03f524c90985c2/generator.py\"] [:db/add 17592186184352 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186184352 :knowledge-point/validate]] \"assertions\" [[\"e083781d-f59e-57f7-8b88-45c3635074f1\" :answer/id #uuid \"e083781d-f59e-57f7-8b88-45c3635074f1\"] [\"e083781d-f59e-57f7-8b88-45c3635074f1\" :answer/type :answer.type/math] [\"e083781d-f59e-57f7-8b88-45c3635074f1\" :answer/value \"-1\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"6e5b6957-7d12-560b-921c-cd818f7f1540\" :answer/id #uuid \"6e5b6957-7d12-560b-921c-cd818f7f1540\"] [\"6e5b6957-7d12-560b-921c-cd818f7f1540\" :answer/type :answer.type/math] [\"6e5b6957-7d12-560b-921c-cd818f7f1540\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"f916ce3a-9570-5558-a7c1-f97fb12ac57c\" :answer/id #uuid \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\"] [\"f916ce3a-9570-5558-a7c1-f97fb12ac57c\" :answer/type :answer.type/math] [\"f916ce3a-9570-5558-a7c1-f97fb12ac57c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"56a9b563-e91f-5d45-a704-1e52a68f8b1a\" :answer/id #uuid \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\"] [\"56a9b563-e91f-5d45-a704-1e52a68f8b1a\" :answer/type :answer.type/math] [\"56a9b563-e91f-5d45-a704-1e52a68f8b1a\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"068e39e7-31c1-5e97-be76-23a2af3433d2\" :answer/id #uuid \"068e39e7-31c1-5e97-be76-23a2af3433d2\"] [\"068e39e7-31c1-5e97-be76-23a2af3433d2\" :answer/type :answer.type/math] [\"068e39e7-31c1-5e97-be76-23a2af3433d2\" :answer/value \"2\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/id #uuid \"713fac61-ef34-51fb-817e-d09d93c50f98\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/key \"answer\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/type :answer-field.type/radio] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"e083781d-f59e-57f7-8b88-45c3635074f1\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"6e5b6957-7d12-560b-921c-cd818f7f1540\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"f916ce3a-9570-5558-a7c1-f97fb12ac57c\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/choices \"068e39e7-31c1-5e97-be76-23a2af3433d2\"] [\"713fac61-ef34-51fb-817e-d09d93c50f98\" :answer-field/correct \"56a9b563-e91f-5d45-a704-1e52a68f8b1a\"] [\"76f7ab34-158b-5e28-b158-c95c23947019\" :question/id #uuid \"76f7ab34-158b-5e28-b158-c95c23947019\"] [\"76f7ab34-158b-5e28-b158-c95c23947019\" :question/problem \"Use the substitution $u=2 x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"76f7ab34-158b-5e28-b158-c95c23947019\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=1 + \\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"76f7ab34-158b-5e28-b158-c95c23947019\" :question/difficulty :question.difficulty/easy] [\"76f7ab34-158b-5e28-b158-c95c23947019\" :question/answer-fields \"713fac61-ef34-51fb-817e-d09d93c50f98\"] [17592186184352 :knowledge-point/questions \"76f7ab34-158b-5e28-b158-c95c23947019\"] [\"b3f88e14-20f8-5580-b051-c32251fa8458\" :answer/id #uuid \"b3f88e14-20f8-5580-b051-c32251fa8458\"] [\"b3f88e14-20f8-5580-b051-c32251fa8458\" :answer/type :answer.type/math] [\"b3f88e14-20f8-5580-b051-c32251fa8458\" :answer/value \"4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"892abda1-3beb-54b5-be50-3794091e0b4a\" :answer/id #uuid \"892abda1-3beb-54b5-be50-3794091e0b4a\"] [\"892abda1-3beb-54b5-be50-3794091e0b4a\" :answer/type :answer.type/math] [\"892abda1-3beb-54b5-be50-3794091e0b4a\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"68f2aa6c-a141-50f1-b436-14e663c4a9f2\" :answer/id #uuid \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\"] [\"68f2aa6c-a141-50f1-b436-14e663c4a9f2\" :answer/type :answer.type/math] [\"68f2aa6c-a141-50f1-b436-14e663c4a9f2\" :answer/value \"12\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d902dad2-758c-5116-b6fa-7a24cf480ab8\" :answer/id #uuid \"d902dad2-758c-5116-b6fa-7a24cf480ab8\"] [\"d902dad2-758c-5116-b6fa-7a24cf480ab8\" :answer/type :answer.type/math] [\"d902dad2-758c-5116-b6fa-7a24cf480ab8\" :answer/value \"-8\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\" :answer/id #uuid \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\"] [\"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\" :answer/type :answer.type/math] [\"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\" :answer/value \"8\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/id #uuid \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/key \"answer\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/type :answer-field.type/radio] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"b3f88e14-20f8-5580-b051-c32251fa8458\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"892abda1-3beb-54b5-be50-3794091e0b4a\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"68f2aa6c-a141-50f1-b436-14e663c4a9f2\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"d902dad2-758c-5116-b6fa-7a24cf480ab8\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/choices \"bd0e0110-6d8d-5287-9a53-ac2e6ab5e0f1\"] [\"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\" :answer-field/correct \"b3f88e14-20f8-5580-b051-c32251fa8458\"] [\"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/id #uuid \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\"] [\"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/problem \"Use the substitution $u=x + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/difficulty :question.difficulty/easy] [\"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\" :question/answer-fields \"ab71f5c6-e9cf-5e82-8d1f-8371caf8b48b\"] [17592186184352 :knowledge-point/questions \"9ed8106b-68d7-5bb0-a76d-0890cdd4946f\"] [\"93bbc09e-f842-560b-ac12-2acd6733ae28\" :answer/id #uuid \"93bbc09e-f842-560b-ac12-2acd6733ae28\"] [\"93bbc09e-f842-560b-ac12-2acd6733ae28\" :answer/type :answer.type/math] [\"93bbc09e-f842-560b-ac12-2acd6733ae28\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"fe4b6e97-c5d7-5288-bd23-256fad4057bd\" :answer/id #uuid \"fe4b6e97-c5d7-5288-bd23-256fad4057bd\"] [\"fe4b6e97-c5d7-5288-bd23-256fad4057bd\" :answer/type :answer.type/math] [\"fe4b6e97-c5d7-5288-bd23-256fad4057bd\" :answer/value \"-6\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"1a9217bf-0966-5d73-be18-6a16f3d4bc52\" :answer/id #uuid \"1a9217bf-0966-5d73-be18-6a16f3d4bc52\"] [\"1a9217bf-0966-5d73-be18-6a16f3d4bc52\" :answer/type :answer.type/math] [\"1a9217bf-0966-5d73-be18-6a16f3d4bc52\" :answer/value \"6\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d359e514-7ef1-5527-b155-52639697395d\" :answer/id #uuid \"d359e514-7ef1-5527-b155-52639697395d\"] [\"d359e514-7ef1-5527-b155-52639697395d\" :answer/type :answer.type/math] [\"d359e514-7ef1-5527-b155-52639697395d\" :answer/value \"-2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"915745e1-460a-57cc-aef8-ec82802a8f18\" :answer/id #uuid \"915745e1-460a-57cc-aef8-ec82802a8f18\"] [\"915745e1-460a-57cc-aef8-ec82802a8f18\" :answer/type :answer.type/math] [\"915745e1-460a-57cc-aef8-ec82802a8f18\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/id #uuid \"88a007b6-0dbf-51de-8960-f63825b3a10c\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/key \"answer\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/type :answer-field.type/radio] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"93bbc09e-f842-560b-ac12-2acd6733ae28\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"fe4b6e97-c5d7-5288-bd23-256fad4057bd\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"1a9217bf-0966-5d73-be18-6a16f3d4bc52\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"d359e514-7ef1-5527-b155-52639697395d\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/choices \"915745e1-460a-57cc-aef8-ec82802a8f18\"] [\"88a007b6-0dbf-51de-8960-f63825b3a10c\" :answer-field/correct \"93bbc09e-f842-560b-ac12-2acd6733ae28\"] [\"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/id #uuid \"53bd9046-a0c9-5aa2-9147-c7683893ad69\"] [\"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/difficulty :question.difficulty/easy] [\"53bd9046-a0c9-5aa2-9147-c7683893ad69\" :question/answer-fields \"88a007b6-0dbf-51de-8960-f63825b3a10c\"] [17592186184352 :knowledge-point/questions \"53bd9046-a0c9-5aa2-9147-c7683893ad69\"] [\"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\" :answer/id #uuid \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\"] [\"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\" :answer/type :answer.type/math] [\"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"47ba7e27-d95f-53da-9fa3-092d1065fce5\" :answer/id #uuid \"47ba7e27-d95f-53da-9fa3-092d1065fce5\"] [\"47ba7e27-d95f-53da-9fa3-092d1065fce5\" :answer/type :answer.type/math] [\"47ba7e27-d95f-53da-9fa3-092d1065fce5\" :answer/value \"\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [\"1a051e72-0189-5d67-9af5-1825d0c9a576\" :answer/id #uuid \"1a051e72-0189-5d67-9af5-1825d0c9a576\"] [\"1a051e72-0189-5d67-9af5-1825d0c9a576\" :answer/type :answer.type/math] [\"1a051e72-0189-5d67-9af5-1825d0c9a576\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ee641f51-06a5-528a-96e2-661a5fa0c5bf\" :answer/id #uuid \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\"] [\"ee641f51-06a5-528a-96e2-661a5fa0c5bf\" :answer/type :answer.type/math] [\"ee641f51-06a5-528a-96e2-661a5fa0c5bf\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"01edcfb0-1be4-5a08-a733-b778047e9f93\" :answer/id #uuid \"01edcfb0-1be4-5a08-a733-b778047e9f93\"] [\"01edcfb0-1be4-5a08-a733-b778047e9f93\" :answer/type :answer.type/math] [\"01edcfb0-1be4-5a08-a733-b778047e9f93\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/id #uuid \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/key \"answer\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/type :answer-field.type/radio] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"603bf00c-aa10-51d0-bef7-2bc0638ac2d3\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"47ba7e27-d95f-53da-9fa3-092d1065fce5\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"1a051e72-0189-5d67-9af5-1825d0c9a576\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/choices \"01edcfb0-1be4-5a08-a733-b778047e9f93\"] [\"f6a873b5-f9e6-5b03-b5d9-359c64a54162\" :answer-field/correct \"ee641f51-06a5-528a-96e2-661a5fa0c5bf\"] [\"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/id #uuid \"52e02874-77ba-5369-b00d-24ca76a8bc3e\"] [\"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [\"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/difficulty :question.difficulty/easy] [\"52e02874-77ba-5369-b00d-24ca76a8bc3e\" :question/answer-fields \"f6a873b5-f9e6-5b03-b5d9-359c64a54162\"] [17592186184352 :knowledge-point/questions \"52e02874-77ba-5369-b00d-24ca76a8bc3e\"] [\"199834a8-15c7-5192-8598-d7b4fe32b3e5\" :answer/id #uuid \"199834a8-15c7-5192-8598-d7b4fe32b3e5\"] [\"199834a8-15c7-5192-8598-d7b4fe32b3e5\" :answer/type :answer.type/math] [\"199834a8-15c7-5192-8598-d7b4fe32b3e5\" :answer/value \"-1\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e6e77070-9eb8-52c3-8cb1-ff98baac7736\" :answer/id #uuid \"e6e77070-9eb8-52c3-8cb1-ff98baac7736\"] [\"e6e77070-9eb8-52c3-8cb1-ff98baac7736\" :answer/type :answer.type/math] [\"e6e77070-9eb8-52c3-8cb1-ff98baac7736\" :answer/value \"-3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"dda6465f-4977-552d-a47c-45412648ecb3\" :answer/id #uuid \"dda6465f-4977-552d-a47c-45412648ecb3\"] [\"dda6465f-4977-552d-a47c-45412648ecb3\" :answer/type :answer.type/math] [\"dda6465f-4977-552d-a47c-45412648ecb3\" :answer/value \"2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"32dc258b-d39c-53d2-95fb-2d88894bc396\" :answer/id #uuid \"32dc258b-d39c-53d2-95fb-2d88894bc396\"] [\"32dc258b-d39c-53d2-95fb-2d88894bc396\" :answer/type :answer.type/math] [\"32dc258b-d39c-53d2-95fb-2d88894bc396\" :answer/value \"4\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0deafa5f-05fb-5a8d-bc4e-c2b3fa47fc3f\" :answer/id #uuid \"0deafa5f-05fb-5a8d-bc4e-c2b3fa47fc3f\"] [\"0deafa5f-05fb-5a8d-bc4e-c2b3fa47fc3f\" :answer/type :answer.type/math] [\"0deafa5f-05fb-5a8d-bc4e-c2b3fa47fc3f\" :answer/value \"\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/id #uuid \"a8dfa04e-c89e-595c-9e56-25d05f83cac4\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/key \"answer\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/type :answer-field.type/radio] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/choices \"199834a8-15c7-5192-8598-d7b4fe32b3e5\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/choices \"e6e77070-9eb8-52c3-8cb1-ff98baac7736\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/choices \"dda6465f-4977-552d-a47c-45412648ecb3\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/choices \"32dc258b-d39c-53d2-95fb-2d88894bc396\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/choices \"0deafa5f-05fb-5a8d-bc4e-c2b3fa47fc3f\"] [\"a8dfa04e-c89e-595c-9e56-25d05f83cac4\" :answer-field/correct \"0deafa5f-05fb-5a8d-bc4e-c2b3fa47fc3f\"] [\"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/id #uuid \"df68770e-204f-5785-ac94-e0d97819ed0d\"] [\"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/difficulty :question.difficulty/easy] [\"df68770e-204f-5785-ac94-e0d97819ed0d\" :question/answer-fields \"a8dfa04e-c89e-595c-9e56-25d05f83cac4\"] [17592186184352 :knowledge-point/questions \"df68770e-204f-5785-ac94-e0d97819ed0d\"] [\"6741cb8e-88a0-5ce1-976c-237d3ec49113\" :answer/id #uuid \"6741cb8e-88a0-5ce1-976c-237d3ec49113\"] [\"6741cb8e-88a0-5ce1-976c-237d3ec49113\" :answer/type :answer.type/math] [\"6741cb8e-88a0-5ce1-976c-237d3ec49113\" :answer/value \"3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"8e31ec6b-6202-5f44-826d-864aebcbda07\" :answer/id #uuid \"8e31ec6b-6202-5f44-826d-864aebcbda07\"] [\"8e31ec6b-6202-5f44-826d-864aebcbda07\" :answer/type :answer.type/math] [\"8e31ec6b-6202-5f44-826d-864aebcbda07\" :answer/value \"\\\\frac{9}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"43e1c96c-50a1-5512-8229-4a3e1fcfe504\" :answer/id #uuid \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\"] [\"43e1c96c-50a1-5512-8229-4a3e1fcfe504\" :answer/type :answer.type/math] [\"43e1c96c-50a1-5512-8229-4a3e1fcfe504\" :answer/value \"-3\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\" :answer/id #uuid \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\"] [\"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\" :answer/type :answer.type/math] [\"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"a930e23a-ba33-5764-b728-ef56fda55b85\" :answer/id #uuid \"a930e23a-ba33-5764-b728-ef56fda55b85\"] [\"a930e23a-ba33-5764-b728-ef56fda55b85\" :answer/type :answer.type/math] [\"a930e23a-ba33-5764-b728-ef56fda55b85\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/id #uuid \"bf4d12c4-daec-568d-a743-88e4a6fbb320\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/key \"answer\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/type :answer-field.type/radio] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"6741cb8e-88a0-5ce1-976c-237d3ec49113\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"8e31ec6b-6202-5f44-826d-864aebcbda07\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"43e1c96c-50a1-5512-8229-4a3e1fcfe504\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"d12681f5-ecff-584a-a9d5-3f9cef6cf34c\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/choices \"a930e23a-ba33-5764-b728-ef56fda55b85\"] [\"bf4d12c4-daec-568d-a743-88e4a6fbb320\" :answer-field/correct \"a930e23a-ba33-5764-b728-ef56fda55b85\"] [\"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/id #uuid \"15afb047-7ab9-5689-8017-2b19eb22c6ce\"] [\"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\"] [\"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/difficulty :question.difficulty/easy] [\"15afb047-7ab9-5689-8017-2b19eb22c6ce\" :question/answer-fields \"bf4d12c4-daec-568d-a743-88e4a6fbb320\"] [17592186184352 :knowledge-point/questions \"15afb047-7ab9-5689-8017-2b19eb22c6ce\"] [\"1f25d427-cd19-5c12-ab57-65a29c84b094\" :answer/id #uuid \"1f25d427-cd19-5c12-ab57-65a29c84b094\"] [\"1f25d427-cd19-5c12-ab57-65a29c84b094\" :answer/type :answer.type/math] [\"1f25d427-cd19-5c12-ab57-65a29c84b094\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"f44e02e1-d06f-5224-acac-0442b3d22e19\" :answer/id #uuid \"f44e02e1-d06f-5224-acac-0442b3d22e19\"] [\"f44e02e1-d06f-5224-acac-0442b3d22e19\" :answer/type :answer.type/math] [\"f44e02e1-d06f-5224-acac-0442b3d22e19\" :answer/value \"2\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\" :answer/id #uuid \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\"] [\"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\" :answer/type :answer.type/math] [\"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\" :answer/id #uuid \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\"] [\"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\" :answer/type :answer.type/math] [\"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"900e3c46-273d-505c-9f8c-1a1ecffdc85e\" :answer/id #uuid \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\"] [\"900e3c46-273d-505c-9f8c-1a1ecffdc85e\" :answer/type :answer.type/math] [\"900e3c46-273d-505c-9f8c-1a1ecffdc85e\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/id #uuid \"0940ea7b-77fe-5dff-b178-39085ba3d487\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/key \"answer\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/type :answer-field.type/radio] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"1f25d427-cd19-5c12-ab57-65a29c84b094\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"f44e02e1-d06f-5224-acac-0442b3d22e19\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"6a647c01-afdc-5bed-b6a4-2827ea0bb5bd\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/choices \"900e3c46-273d-505c-9f8c-1a1ecffdc85e\"] [\"0940ea7b-77fe-5dff-b178-39085ba3d487\" :answer-field/correct \"662101b1-ae8e-5549-8e7f-1b491cc4a7e2\"] [\"918aae66-2616-5579-b040-086f3e44e133\" :question/id #uuid \"918aae66-2616-5579-b040-086f3e44e133\"] [\"918aae66-2616-5579-b040-086f3e44e133\" :question/problem \"Use the substitution $u=x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"918aae66-2616-5579-b040-086f3e44e133\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"918aae66-2616-5579-b040-086f3e44e133\" :question/difficulty :question.difficulty/easy] [\"918aae66-2616-5579-b040-086f3e44e133\" :question/answer-fields \"0940ea7b-77fe-5dff-b178-39085ba3d487\"] [17592186184352 :knowledge-point/questions \"918aae66-2616-5579-b040-086f3e44e133\"] [\"35793bcb-5557-56d7-8333-59d88d526e20\" :answer/id #uuid \"35793bcb-5557-56d7-8333-59d88d526e20\"] [\"35793bcb-5557-56d7-8333-59d88d526e20\" :answer/type :answer.type/math] [\"35793bcb-5557-56d7-8333-59d88d526e20\" :answer/value \"6\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bfba1f10-b3af-5f34-b69d-69634fc52ba8\" :answer/id #uuid \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\"] [\"bfba1f10-b3af-5f34-b69d-69634fc52ba8\" :answer/type :answer.type/math] [\"bfba1f10-b3af-5f34-b69d-69634fc52ba8\" :answer/value \"\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\"] [\"bb044171-5255-5057-b5a0-5f668d3a5586\" :answer/id #uuid \"bb044171-5255-5057-b5a0-5f668d3a5586\"] [\"bb044171-5255-5057-b5a0-5f668d3a5586\" :answer/type :answer.type/math] [\"bb044171-5255-5057-b5a0-5f668d3a5586\" :answer/value \"-9\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\" :answer/id #uuid \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\"] [\"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\" :answer/type :answer.type/math] [\"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\" :answer/value \"3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c1af244a-1e63-5104-a874-6082ca45acad\" :answer/id #uuid \"c1af244a-1e63-5104-a874-6082ca45acad\"] [\"c1af244a-1e63-5104-a874-6082ca45acad\" :answer/type :answer.type/math] [\"c1af244a-1e63-5104-a874-6082ca45acad\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/id #uuid \"ca691ac6-c678-571a-a6df-f3d1703c46df\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/key \"answer\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/type :answer-field.type/radio] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"35793bcb-5557-56d7-8333-59d88d526e20\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"bfba1f10-b3af-5f34-b69d-69634fc52ba8\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"bb044171-5255-5057-b5a0-5f668d3a5586\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/choices \"c1af244a-1e63-5104-a874-6082ca45acad\"] [\"ca691ac6-c678-571a-a6df-f3d1703c46df\" :answer-field/correct \"ebbcd5a7-7a54-5a4e-8b72-f33d8e5f553a\"] [\"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/id #uuid \"b307b28c-7447-5305-a106-a972e7d5a9ca\"] [\"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/problem \"Use the substitution $u=x + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [\"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/worked-solution \"Let $u=x + 2$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/difficulty :question.difficulty/easy] [\"b307b28c-7447-5305-a106-a972e7d5a9ca\" :question/answer-fields \"ca691ac6-c678-571a-a6df-f3d1703c46df\"] [17592186184352 :knowledge-point/questions \"b307b28c-7447-5305-a106-a972e7d5a9ca\"] [\"generator\" :question-generator/id #uuid \"0d77e88d-b0ed-58b3-a582-648c57486271\"] [\"generator\" :question-generator/script \"generators/37/37402cb3521a8ab2a4f5800c6d697c6fe3c49fcd27a819b91e03f524c90985c2/generator.py\"] [17592186184352 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186184352 :knowledge-point/question-generator 17592186679631]]}",
