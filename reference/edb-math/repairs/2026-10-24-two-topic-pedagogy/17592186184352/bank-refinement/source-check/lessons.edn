#{[{:activity/expected-seconds 1020.0 :activity/first-step {:db/id #edb/ref 17592186185245} :activity/id #uuid "aa1811b2-1877-5406-b70c-b443bbb27d74" :activity/scope {:db/id #edb/ref 17592186048245} :activity/steps [{:db/id #edb/ref 17592186185245 :step/content {:db/id #edb/ref 17592186185377 :tutorial/content "Suppose that we want to calculate $$\n\\displaystyle \\int 2x e^{x^2}\\,\\textrm d x.\n$$\n\nNotice that if we let $u = x^2,$ then both $u$ and its derivative $u'=2x$ appear in the integrand:\n\n$$\n\\int \\underbrace{2x}_{u'} e^{\\overbrace{x^2}^u}\\,\\textrm d x\n$$\n\nIntegrals like this can always be solved using substitution.\n\nLet $u=x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d} u}{\\textrm{d}x } = 2x \\quad\\Longrightarrow\\quad \\textrm d u = 2x\\,\\textrm d x.\n$$\n\nWe now substitute our expressions into the integral and evaluate it as follows:\n\n$$\n\\begin{aligned}\\int 2x{e}^{{x}^{2}}\\,\\text{d}x & =\\int {e}^{{x}^{2}}\\,\\underbrace{2x\\,\\text{d}x}_{\\text{d}u} \\\\  & =\\int {e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}+C \\\\  & ={e}^{{x}^{2}}+C\\end{aligned}\n$$" :tutorial/id #uuid "9226f656-035c-5db8-bbf9-a6e27c1a663b" :tutorial/math-academy-id 8917 :tutorial/title "Introduction"} :step/id #uuid "a49b7ac0-3197-5f23-ade2-615672647bff" :step/math-academy-id 617462 :step/next {:db/id #edb/ref 17592186185246}} {:db/id #edb/ref 17592186185246 :step/content {:db/id #edb/ref 17592186184349 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183945 :question/id #uuid "3e9586ee-12d1-5dbb-81f6-0f0a4998e00a" :question/math-academy-id "e-14402" :question/problem "Calculate  $$\n\\displaystyle{\\int x^2 e^{x^3+1}\\, \\textrm{d}x }.\n$$" :question/worked-solution "Let's introduce the new variable $u = x^3+1.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 3x^2\\quad\\Longrightarrow\\quad\\dfrac 1 3 \\textrm{d}u = x^2 \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{{x}^{3}+1}\\cdot \\,{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{{x}^{3}+1}+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050101}] :knowledge-point/question-generator {:db/id #edb/ref 17592186680342} :knowledge-point/questions [{:db/id #edb/ref 17592186184470} {:db/id #edb/ref 17592186184836} {:db/id #edb/ref 17592186250123} {:db/id #edb/ref 17592186290509} {:db/id #edb/ref 17592186342054} {:db/id #edb/ref 17592186342055} {:db/id #edb/ref 17592186342084} {:db/id #edb/ref 17592186608223} {:db/id #edb/ref 17592186679213} {:db/id #edb/ref 17592186679214} {:db/id #edb/ref 17592186679235} {:db/id #edb/ref 17592186679244} {:db/id #edb/ref 17592186679248} {:db/id #edb/ref 17592186679250} {:db/id #edb/ref 17592186679255} {:db/id #edb/ref 17592186679258} {:db/id #edb/ref 17592186679259} {:db/id #edb/ref 17592186679267} {:db/id #edb/ref 17592186679269} {:db/id #edb/ref 17592186679273} {:db/id #edb/ref 17592186679274} {:db/id #edb/ref 17592186679277} {:db/id #edb/ref 17592186679278} {:db/id #edb/ref 17592186679281} {:db/id #edb/ref 17592186679285} {:db/id #edb/ref 17592186679289} {:db/id #edb/ref 17592186679291} {:db/id #edb/ref 17592186679296} {:db/id #edb/ref 17592186679302} {:db/id #edb/ref 17592186679305} {:db/id #edb/ref 17592186679306} {:db/id #edb/ref 17592186679307} {:db/id #edb/ref 17592186680292} {:db/id #edb/ref 17592186680302} {:db/id #edb/ref 17592186680304} {:db/id #edb/ref 17592186680315} {:db/id #edb/ref 17592186680327} {:db/id #edb/ref 17592186680336} {:db/id #edb/ref 17592186680339} {:db/id #edb/ref 17592186680340}] :knowledge-point/title "Integrating Products Containing the Exponential Function"} :step/id #uuid "bd0c74ad-978d-5743-bba6-2d7fbac9c0f0" :step/math-academy-id 617463 :step/next {:db/id #edb/ref 17592186185247}} {:db/id #edb/ref 17592186185247 :step/content {:db/id #edb/ref 17592186184350 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183946 :question/id #uuid "ab4772a2-f980-5ad7-a377-34e34b95be83" :question/math-academy-id "e-14403" :question/problem "Calculate  $$\n\\displaystyle \\int x^3\\,{3^{1-x^4}} \\, \\textrm{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u= 1-x^4.$ Differentiating gives \n\n$$\n\\dfrac{ \\textrm{d}u}{ \\textrm{d}x} = -4x^3\\quad\\Longrightarrow\\quad x^3 \\, \\textrm{d}x = -\\dfrac{1}{4} \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int {x^3\\,{3^{1-x^4}} }\\, \\textrm{d}x \n&=\\int {{3^{1-x^4}}\\cdot x^3 }\\, \\textrm{d}x \\\\[5pt]\n&=  \\int {3^{u}} \\cdot \\left(-\\dfrac{1}{4}\\right) \\textrm{d}u\\\\[5pt]\n                                                     &= -\\dfrac{1}{4}\\int {3^{u}}  \\textrm{d}u\\\\[5pt]\n                                                     &=  -\\dfrac{1}{4}\\cdot\\dfrac{3^{u}}{\\ln 3} + C\\\\[5pt]\n                                                     &=   -\\dfrac{3^{1-x^4}}{4\\ln 3}+ C.\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/question-generator {:db/id #edb/ref 17592186680399} :knowledge-point/questions [{:db/id #edb/ref 17592186184746} {:db/id #edb/ref 17592186184837} {:db/id #edb/ref 17592186290291} {:db/id #edb/ref 17592186297397} {:db/id #edb/ref 17592186297400} {:db/id #edb/ref 17592186342056} {:db/id #edb/ref 17592186342085} {:db/id #edb/ref 17592186342086} {:db/id #edb/ref 17592186491366} {:db/id #edb/ref 17592186491371} {:db/id #edb/ref 17592186491375} {:db/id #edb/ref 17592186491376} {:db/id #edb/ref 17592186608170} {:db/id #edb/ref 17592186627673} {:db/id #edb/ref 17592186679317} {:db/id #edb/ref 17592186679320} {:db/id #edb/ref 17592186679326} {:db/id #edb/ref 17592186679331} {:db/id #edb/ref 17592186679335} {:db/id #edb/ref 17592186679339} {:db/id #edb/ref 17592186679341} {:db/id #edb/ref 17592186679350} {:db/id #edb/ref 17592186679351} {:db/id #edb/ref 17592186679353} {:db/id #edb/ref 17592186679355} {:db/id #edb/ref 17592186679358} {:db/id #edb/ref 17592186679362} {:db/id #edb/ref 17592186679366} {:db/id #edb/ref 17592186679371} {:db/id #edb/ref 17592186679373} {:db/id #edb/ref 17592186679378} {:db/id #edb/ref 17592186679382} {:db/id #edb/ref 17592186679384} {:db/id #edb/ref 17592186679389} {:db/id #edb/ref 17592186679391} {:db/id #edb/ref 17592186679401} {:db/id #edb/ref 17592186679403} {:db/id #edb/ref 17592186679419} {:db/id #edb/ref 17592186680358} {:db/id #edb/ref 17592186680367} {:db/id #edb/ref 17592186680371} {:db/id #edb/ref 17592186680376} {:db/id #edb/ref 17592186680380} {:db/id #edb/ref 17592186680381} {:db/id #edb/ref 17592186680387} {:db/id #edb/ref 17592186680398}] :knowledge-point/title "Integrating Products Containing Other Exponential Functions"} :step/id #uuid "cdb3da71-c0a3-5ec4-b208-5c3565e9b4a2" :step/math-academy-id 617466 :step/next {:db/id #edb/ref 17592186185248}} {:db/id #edb/ref 17592186185248 :step/content {:db/id #edb/ref 17592186184351 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183947 :question/id #uuid "70fd3433-e905-5643-8e55-0bdf774d781e" :question/math-academy-id "e-14404" :question/problem "Calculate  $$\n\\displaystyle \\int \\dfrac {e^{2x}} {e^{2x} + 1} \\, \\textrm{d}x.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u = e^{2x}+1.$ Differentiating gives \n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 2e^{2x}\\quad\\Longrightarrow\\quad\n\\dfrac{1}{2}\\, \\textrm{d}u = e^{2x} \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}}{{e}^{2x}+1}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}+1}\\cdot {e}^{2x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{e}^{2x}+1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({e}^{2x}+1)+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that $e^{2x} + 1 > 0$ for all $x.$"} :knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049443}] :knowledge-point/question-generator {:db/id #edb/ref 17592186680456} :knowledge-point/questions [{:db/id #edb/ref 17592186184451} {:db/id #edb/ref 17592186184452} {:db/id #edb/ref 17592186234356} {:db/id #edb/ref 17592186250127} {:db/id #edb/ref 17592186297410} {:db/id #edb/ref 17592186297411} {:db/id #edb/ref 17592186332748} {:db/id #edb/ref 17592186342057} {:db/id #edb/ref 17592186608168} {:db/id #edb/ref 17592186608178} {:db/id #edb/ref 17592186627685} {:db/id #edb/ref 17592186664062} {:db/id #edb/ref 17592186679422} {:db/id #edb/ref 17592186679429} {:db/id #edb/ref 17592186679430} {:db/id #edb/ref 17592186679437} {:db/id #edb/ref 17592186679439} {:db/id #edb/ref 17592186679440} {:db/id #edb/ref 17592186679448} {:db/id #edb/ref 17592186679449} {:db/id #edb/ref 17592186679458} {:db/id #edb/ref 17592186679461} {:db/id #edb/ref 17592186679464} {:db/id #edb/ref 17592186679466} {:db/id #edb/ref 17592186679474} {:db/id #edb/ref 17592186679478} {:db/id #edb/ref 17592186679495} {:db/id #edb/ref 17592186679496} {:db/id #edb/ref 17592186679498} {:db/id #edb/ref 17592186679499} {:db/id #edb/ref 17592186679501} {:db/id #edb/ref 17592186679507} {:db/id #edb/ref 17592186679516} {:db/id #edb/ref 17592186679518} {:db/id #edb/ref 17592186679522} {:db/id #edb/ref 17592186679524} {:db/id #edb/ref 17592186680406} {:db/id #edb/ref 17592186680407} {:db/id #edb/ref 17592186680409} {:db/id #edb/ref 17592186680410} {:db/id #edb/ref 17592186680411} {:db/id #edb/ref 17592186680412} {:db/id #edb/ref 17592186680413} {:db/id #edb/ref 17592186680446}] :knowledge-point/title "More Complex Cases"} :step/id #uuid "0802b913-79fa-5d3d-8382-234e10ea0f58" :step/math-academy-id 617469 :step/next {:db/id #edb/ref 17592186185249}} {:db/id #edb/ref 17592186185249 :step/content {:db/id #edb/ref 17592186185378 :tutorial/content "Let's evaluate the following definite integral:\n\n$$\n\\displaystyle{\\int_{0}^{3} xe^{x^{2}}\\, \\textrm{d}x}\n$$\n\nWe'll use the change of variable method, which comprises three steps:\n\n**Step1:**  Change of variable in the integrand.\n\nLet's introduce the new variable $u = x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{ \\textrm{d}x} = 2x \n\\qquad\\Longrightarrow\\qquad\n\\dfrac{1}{2}\\textrm{d}u = x \\, \\textrm{d}x.\n$$\n\n**Step 2:** Find the new limits of integration.\n\nWe create a table below to change our limits of integration from $x$ to $u{:}$\n\n| $x$ | $0$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $9$ |\n\n**Step 3:** Evaluate the integral in the new variable $u.$ \n\n$$\n\\begin{aligned}{\\int }_{0}^{3}x{e}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{3}{e}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{9}{e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{9}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}{e}^{u}\\,{|}_{0}^{9} \\\\  & =\\frac{1}{2}({e}^{9}-{e}^{0}) \\\\  & =\\frac{{e}^{9}-1}{2}.\\end{aligned}\n$$" :tutorial/id #uuid "bbb334a5-065c-52a9-a7b5-f78e618cecce" :tutorial/math-academy-id 8930 :tutorial/title "Definite Integrals"} :step/id #uuid "6f33a62b-a563-598b-ba74-c42ee3a5459f" :step/math-academy-id 617472 :step/next {:db/id #edb/ref 17592186185250}} {:db/id #edb/ref 17592186185250 :step/content {:db/id #edb/ref 17592186184352 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183948 :question/id #uuid "a99e8d2c-1934-57a9-9a6a-578ec9230f6f" :question/math-academy-id "e-14407" :question/problem "Evaluate the integral $$\n\\displaystyle{\\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}.\n$$" :question/worked-solution "Let's introduce the new variable $u=-2x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x\n\\qquad\\Longrightarrow\\qquad\n-4 \\, \\textrm{d}u=16x \\, \\textrm{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}16x{e}^{-2{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}{e}^{-2{x}^{2}}\\cdot 16x\\,\\text{d}x \\\\  & ={\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\cdot (-4\\,\\text{d}u) \\\\  & =-4{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\,\\text{d}u \\\\  & =-4{e}^{u}\\,{|}_{0}^{-2\\operatorname{ln}⁡4} \\\\  & =-4({e}^{-2\\operatorname{ln}⁡4}-{e}^{0}) \\\\  & =-4(\\frac{1}{16}-1) \\\\  & =4\\left(\\frac{15}{16}\\right) \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332}] :knowledge-point/question-generator {:db/id #edb/ref 17592186679631} :knowledge-point/questions [{:db/id #edb/ref 17592186184471} {:db/id #edb/ref 17592186184741} {:db/id #edb/ref 17592186297313} {:db/id #edb/ref 17592186297315} {:db/id #edb/ref 17592186319097} {:db/id #edb/ref 17592186320737} {:db/id #edb/ref 17592186320738} {:db/id #edb/ref 17592186320739} {:db/id #edb/ref 17592186608214} {:db/id #edb/ref 17592186627714} {:db/id #edb/ref 17592186679532} {:db/id #edb/ref 17592186679534} {:db/id #edb/ref 17592186679539} {:db/id #edb/ref 17592186679550} {:db/id #edb/ref 17592186679551} {:db/id #edb/ref 17592186679554} {:db/id #edb/ref 17592186679557} {:db/id #edb/ref 17592186679563} {:db/id #edb/ref 17592186679567} {:db/id #edb/ref 17592186679570} {:db/id #edb/ref 17592186679577} {:db/id #edb/ref 17592186679579} {:db/id #edb/ref 17592186679585} {:db/id #edb/ref 17592186679587} {:db/id #edb/ref 17592186679589} {:db/id #edb/ref 17592186679601} {:db/id #edb/ref 17592186679604} {:db/id #edb/ref 17592186679605} {:db/id #edb/ref 17592186679606} {:db/id #edb/ref 17592186679621} {:db/id #edb/ref 17592186679623} {:db/id #edb/ref 17592186679625} {:db/id #edb/ref 17592186679627} {:db/id #edb/ref 17592186679630}] :knowledge-point/title "Evaluating Definite Integrals"} :step/id #uuid "ab2daff4-1514-590f-826c-3d19e01eb4c5" :step/math-academy-id 617473}] :activity/title "Integrating Exponential Functions Using Substitution" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186184369}]}
