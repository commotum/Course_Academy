ac{x}{5})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=5\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{25}\\cdot 5=\\frac{3}{5}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{x^{2} + 25}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{3}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{3}{5}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C.\n$$"] [:db/add "7ba4ceb2-ab79-5b8e-adf9-4bb8d212d3af" :question/difficulty :question.difficulty/moderate] [:db/add "7ba4ceb2-ab79-5b8e-adf9-4bb8d212d3af" :question/answer-fields "e1160fca-76ee-5407-b809-2b5d7f3c52ba"] [:db/ensure "7ba4ceb2-ab79-5b8e-adf9-4bb8d212d3af" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "7ba4ceb2-ab79-5b8e-adf9-4bb8d212d3af"] [:db/add "7a4d0810-6cf3-56d0-9772-7eac212bf316" :answer/id #uuid "7a4d0810-6cf3-56d0-9772-7eac212bf316"] [:db/add "7a4d0810-6cf3-56d0-9772-7eac212bf316" :answer/type :answer.type/math] [:db/add "7a4d0810-6cf3-56d0-9772-7eac212bf316" :answer/value "\\frac{2}{3}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "7a4d0810-6cf3-56d0-9772-7eac212bf316" :answer/validate] [:db/add "d7491f01-532b-56f0-afbb-c29db8b366d9" :answer/id #uuid "d7491f01-532b-56f0-afbb-c29db8b366d9"] [:db/add "d7491f01-532b-56f0-afbb-c29db8b366d9" :answer/type :answer.type/math] [:db/add "d7491f01-532b-56f0-afbb-c29db8b366d9" :answer/value "\\frac{2}{3}\\left(\\arctan{\\left(\\frac{2 x}{3} \\right)}\\right)+C"] [:db/ensure "d7491f01-532b-56f0-afbb-c29db8b366d9" :answer/validate] [:db/add "9f43b749-be72-57e5-b073-b15a36dba311" :answer/id #uuid "9f43b749-be72-57e5-b073-b15a36dba311"] [:db/add "9f43b749-be72-57e5-b073-b15a36dba311" :answer/type :answer.type/math] [:db/add "9f43b749-be72-57e5-b073-b15a36dba311" :answer/value "- \\frac{2}{3}\\left(\\arctan{\\left(\\frac{x}{3} \\right)}\\right)+C"] [:db/ensure "9f43b749-be72-57e5-b073-b15a36dba311" :answer/validate] [:db/add "7d8ccf6e-59b0-59c9-86a5-597544afbd0d" :answer/id #uuid "7d8ccf6e-59b0-59c9-86a5-597544afbd0d"] [:db/add "7d8ccf6e-59b0-59c9-86a5-597544afbd0d" :answer/type :answer.type/math] [:db/add "7d8ccf6e-59b0-59c9-86a5-597544afbd0d" :answer/value "\\frac{4}{3}\\left(\\arctan{\\left(\\frac{x}{3} \\right)}\\right)+C"] [:db/ensure "7d8ccf6e-59b0-59c9-86a5-597544afbd0d" :answer/validate] [:db/add "bfd1e3af-c14a-5c16-8680-bd22de9b6b19" :answer/id #uuid "bfd1e3af-c14a-5c16-8680-bd22de9b6b19"] [:db/add "bfd1e3af-c14a-5c16-8680-bd22de9b6b19" :answer/type :answer.type/math] [:db/add "bfd1e3af-c14a-5c16-8680-bd22de9b6b19" :answer/value "\\frac{2}{3}\\left(\\arctan{\\left(\\frac{x}{3} \\right)}\\right)+C"] [:db/ensure "bfd1e3af-c14a-5c16-8680-bd22de9b6b19" :answer/validate] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/id #uuid "c05e2926-a3df-564c-9a81-3198a5fa9d12"] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/key "answer"] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/type :answer-field.type/radio] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/choices "7a4d0810-6cf3-56d0-9772-7eac212bf316"] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/choices "d7491f01-532b-56f0-afbb-c29db8b366d9"] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/choices "9f43b749-be72-57e5-b073-b15a36dba311"] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/choices "7d8ccf6e-59b0-59c9-86a5-597544afbd0d"] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/choices "bfd1e3af-c14a-5c16-8680-bd22de9b6b19"] [:db/add "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/correct "bfd1e3af-c14a-5c16-8680-bd22de9b6b19"] [:db/ensure "c05e2926-a3df-564c-9a81-3198a5fa9d12" :answer-field/validate] [:db/add "e30a0122-aed9-523f-9764-d1adfe496a5c" :question/id #uuid "e30a0122-aed9-523f-9764-d1adfe496a5c"] [:db/add "e30a0122-aed9-523f-9764-d1adfe496a5c" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{x^{2} + 9}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "e30a0122-aed9-523f-9764-d1adfe496a5c" :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 9=9\\left(1+(\\frac{x}{3})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{2}{9}\\cdot 3=\\frac{2}{3}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{x^{2} + 9}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{2}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{2}{3}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{3}\\left(\\arctan{\\left(\\frac{x}{3} \\right)}\\right)+C.\n$$"] [:db/add "e30a0122-aed9-523f-9764-d1adfe496a5c" :question/difficulty :question.difficulty/moderate] [:db/add "e30a0122-aed9-523f-9764-d1adfe496a5c" :question/answer-fields "c05e2926-a3df-564c-9a81-3198a5fa9d12"] [:db/ensure "e30a0122-aed9-523f-9764-d1adfe496a5c" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "e30a0122-aed9-523f-9764-d1adfe496a5c"] [:db/add "75e2aae8-994e-53c6-8ed0-11dbd406f441" :answer/id #uuid "75e2aae8-994e-53c6-8ed0-11dbd406f441"] [:db/add "75e2aae8-994e-53c6-8ed0-11dbd406f441" :answer/type :answer.type/math] [:db/add "75e2aae8-994e-53c6-8ed0-11dbd406f441" :answer/value "- \\frac{1}{2}\\left(\\arctan{\\left(2 x \\right)}\\right)+C"] [:db/ensure "75e2aae8-994e-53c6-8ed0-11dbd406f441" :answer/validate] [:db/add "a69bc09e-3024-5a2e-a39c-d54a069854d5" :answer/id 