-8381-c92b8ae7dbc9" :answer-field/choices "f964ae08-3936-5e96-a5d9-bdd196cf32b7"] [:db/add "98428769-6168-527b-8381-c92b8ae7dbc9" :answer-field/correct "ae7e7654-34b0-5c4c-8fec-319230ba48c9"] [:db/ensure "98428769-6168-527b-8381-c92b8ae7dbc9" :answer-field/validate] [:db/add "d724029a-f29d-53a5-9193-1e3742bd1461" :question/id #uuid "d724029a-f29d-53a5-9193-1e3742bd1461"] [:db/add "d724029a-f29d-53a5-9193-1e3742bd1461" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "d724029a-f29d-53a5-9193-1e3742bd1461" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{16}\\cdot 4=\\frac{1}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\arctan{\\left(\\frac{x}{4} \\right)}\\right)+C.\n$$"] [:db/add "d724029a-f29d-53a5-9193-1e3742bd1461" :question/difficulty :question.difficulty/moderate] [:db/add "d724029a-f29d-53a5-9193-1e3742bd1461" :question/answer-fields "98428769-6168-527b-8381-c92b8ae7dbc9"] [:db/ensure "d724029a-f29d-53a5-9193-1e3742bd1461" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "d724029a-f29d-53a5-9193-1e3742bd1461"] [:db/add "f67e09f1-403e-57c8-8023-e3ff5077ebe1" :answer/id #uuid "f67e09f1-403e-57c8-8023-e3ff5077e