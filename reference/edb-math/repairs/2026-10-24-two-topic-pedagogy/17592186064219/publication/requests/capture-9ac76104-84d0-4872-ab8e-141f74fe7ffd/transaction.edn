t(2 x \\right)}\\right)+C.\n$$"] [:db/add "f681176b-4e5e-5148-be04-c5b9ef998f7b" :question/difficulty :question.difficulty/hard] [:db/add "f681176b-4e5e-5148-be04-c5b9ef998f7b" :question/answer-fields "816313fa-5f98-5c3a-828a-9f848e85539b"] [:db/ensure "f681176b-4e5e-5148-be04-c5b9ef998f7b" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "f681176b-4e5e-5148-be04-c5b9ef998f7b"] [:db/add "b803e232-a7b2-5df9-8df2-69c21d155af6" :answer/id #uuid "b803e232-a7b2-5df9-8df2-69c21d155af6"] [:db/add "b803e232-a7b2-5df9-8df2-69c21d155af6" :answer/type :answer.type/math] [:db/add "b803e232-a7b2-5df9-8df2-69c21d155af6" :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C"] [:db/ensure "b803e232-a7b2-5df9-8df2-69c21d155af6" :answer/validate] [:db/add "ecea85df-c350-56f7-aa01-661e96f3d540" :answer/id #uuid "ecea85df-c350-56f7-aa01-661e96f3d540"] [:db/add "ecea85df-c350-56f7-aa01-661e96f3d540" :answer/type :answer.type/math] [:db/add "ecea85df-c350-56f7-aa01-661e96f3d540" :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "ecea85df-c350-56f7-aa01-661e96f3d540" :answer/validate] [:db/add "fa6dcb2e-ab06-5d32-af91-201dc60ff6bb" :answer/id #uuid "fa6dcb2e-ab06-5d32-af91-201dc60ff6bb"] [:db/add "fa6dcb2e-ab06-5d32-af91-201dc60ff6bb" :answer/type :answer.type/math] [:db/add "fa6dcb2e-ab06-5d32-af91-201dc60ff6bb" :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C"] [:db/ensure "fa6dcb2e-ab06-5d32-af91-201dc60ff6bb" :answer/validate] [:db/add "abcc45e3-4991-5d38-b599-c4a622f1b4fc" :answer/id #uuid "abcc45e3-4991-5d38-b599-c4a622f1b4fc"] [:db/add "abcc45e3-4991-5d38-b599-c4a622f1b4fc" :answer/type :answer.type/math] [:db/add "abcc45e3-4991-5d38-b599-c4a622f1b4fc" :answer/value "- \\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C"] [:db/ensure "abcc45e3-4991-5d38-b599-c4a622f1b4fc" :answer/validate] [:db/add "bd9a9b95-3d27-59b9-9581-00b5c6acc9f3" :ans