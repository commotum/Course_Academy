swer/id #uuid "aed18aad-4d47-5f7f-989e-a8aade8ecc0e"] [:db/add "aed18aad-4d47-5f7f-989e-a8aade8ecc0e" :answer/type :answer.type/math] [:db/add "aed18aad-4d47-5f7f-989e-a8aade8ecc0e" :answer/value "\\arctan{\\left(x \\right)}+C"] [:db/ensure "aed18aad-4d47-5f7f-989e-a8aade8ecc0e" :answer/validate] [:db/add "a9d95a2e-542e-596e-a08a-bcf7fcb05e2d" :answer/id #uuid "a9d95a2e-542e-596e-a08a-bcf7fcb05e2d"] [:db/add "a9d95a2e-542e-596e-a08a-bcf7fcb05e2d" :answer/type :answer.type/math] [:db/add "a9d95a2e-542e-596e-a08a-bcf7fcb05e2d" :answer/value "-2\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "a9d95a2e-542e-596e-a08a-bcf7fcb05e2d" :answer/validate] [:db/add "bf23db17-4d09-5ccd-ac54-bb36c8f51305" :answer/id #uuid "bf23db17-4d09-5ccd-ac54-bb36c8f51305"] [:db/add "bf23db17-4d09-5ccd-ac54-bb36c8f51305" :answer/type :answer.type/math] [:db/add "bf23db17-4d09-5ccd-ac54-bb36c8f51305" :answer/value "2\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "bf23db17-4d09-5ccd-ac54-bb36c8f51305" :answer/validate] [:db/add "0479fbb0-008e-5c66-b5ca-648b9ad05085" :answer/id #uuid "0479fbb0-008e-5c66-b5ca-648b9ad05085"] [:db/add "0479fbb0-008e-5c66-b5ca-648b9ad05085" :answer/type :answer.type/math] [:db/add "0479fbb0-008e-5c66-b5ca-648b9ad05085" :answer/value "2\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "0479fbb0-008e-5c66-b5ca-648b9ad05085" :answer/validate] [:db/add "eaf17396-fbf6-5bb6-a992-37c813dd39e2" :answer/id #uuid "eaf17396-fbf6-5bb6-a992-37c813dd39e2"] [:db/add "eaf17396-fbf6-5bb6-a992-37c813dd39e2" :answer/type :answer.type/math] [:db/add "eaf17396-fbf6-5bb6-a992-37c813dd39e2" :answer/value "\\arctan{\\left(\\frac{x}{2} \\right)}+C"] [:db/ensure "eaf17396-fbf6-5bb6-a992-37c813dd39e2" :answer/validate] [:db/add "93c8398c-67a6-5380-93e3-b4970fc200c4" :answer-field/id #uuid "93c8398c-67a6-5380-93e3-b4970fc200c4"] [:db/add "93c8398c-67a6-5380-93e3-b4970fc200c4" :answer-field/key "answer"] [:db/add "93c8398c-67a6-5380-93e3-b49