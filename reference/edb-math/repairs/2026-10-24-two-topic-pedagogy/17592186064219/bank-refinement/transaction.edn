4e2-560c-961a-a0cc2456807a" :question/difficulty :question.difficulty/moderate] [:db/add "374f0a15-44e2-560c-961a-a0cc2456807a" :question/answer-fields "93c8398c-67a6-5380-93e3-b4970fc200c4"] [:db/ensure "374f0a15-44e2-560c-961a-a0cc2456807a" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "374f0a15-44e2-560c-961a-a0cc2456807a"] [:db/add "24115da5-fa1e-518d-97a3-073655adcc17" :answer/id #uuid "24115da5-fa1e-518d-97a3-073655adcc17"] [:db/add "24115da5-fa1e-518d-97a3-073655adcc17" :answer/type :answer.type/math] [:db/add "24115da5-fa1e-518d-97a3-073655adcc17" :answer/value "\\frac{3}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C"] [:db/ensure "24115da5-fa1e-518d-97a3-073655adcc17" :answer/validate] [:db/add "9cda0f1f-186d-5025-9244-be8198899caf" :answer/id #uuid "9cda0f1f-186d-5025-9244-be8198899caf"] [:db/add "9cda0f1f-186d-5025-9244-be8198899caf" :answer/type :answer.type/math] [:db/add "9cda0f1f-186d-5025-9244-be8198899caf" :answer/value "\\frac{6}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C"] [:db/ensure "9cda0f1f-186d-5025-9244-be8198899caf" :answer/validate] [:db/add "10dd5c4c-5769-5607-9cee-b0c0674d7673" :answer/id #uuid "10dd5c4c-5769-5607-9cee-b0c0674d7673"] [:db/add "10dd5c4c-5769-5607-9cee-b0c0674d7673" :answer/type :answer.type/math] [:db/add "10dd5c4c-5769-5607-9cee-b0c0674d7673" :answer/value "\\frac{3}{10}\\left(\\arctan{\\left(\\frac{2 x}{5} \\right)}\\right)+C"] [:db/ensure "10dd5c4c-5769-5607-9cee-b0c0674d7673" :answer/validate] [:db/add "7e0f4fa4-41e5-58dd-b9cb-afeb34781278" :answer/id #uuid "7e0f4fa4-41e5-58dd-b9cb-afeb34781278"] [:db/add "7e0f4fa4-41e5-58dd-b9cb-afeb34781278" :answer/type :answer.type/math] [:db/add "7e0f4fa4-41e5-58dd-b9cb-afeb34781278" :answer/value "\\frac{3}{10}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C"] [:db/ensure "7e0f4fa4-41e5-58dd-b9cb-afeb34781278" :answer/validate] [:db/add "f14e87dd-502f-56c4-9be5-9cd60a273a1e" :answer/id #uuid "f14e87dd-502f-56c4-9be5-9cd6