"0ea27e05-c360-5117-af78-66005d892e0d"] [:db/add "c014dc67-2f00-5dd4-9396-1c264e8d0b09" :answer/id #uuid "c014dc67-2f00-5dd4-9396-1c264e8d0b09"] [:db/add "c014dc67-2f00-5dd4-9396-1c264e8d0b09" :answer/type :answer.type/math] [:db/add "c014dc67-2f00-5dd4-9396-1c264e8d0b09" :answer/value "\\frac{1}{8}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "c014dc67-2f00-5dd4-9396-1c264e8d0b09" :answer/validate] [:db/add "df0856bd-8f13-5d07-a9d8-b38c175f921f" :answer/id #uuid "df0856bd-8f13-5d07-a9d8-b38c175f921f"] [:db/add "df0856bd-8f13-5d07-a9d8-b38c175f921f" :answer/type :answer.type/math] [:db/add "df0856bd-8f13-5d07-a9d8-b38c175f921f" :answer/value "\\frac{1}{2}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "df0856bd-8f13-5d07-a9d8-b38c175f921f" :answer/validate] [:db/add "d62d7bce-ab62-5ca7-9265-39a31e28ea4a" :answer/id #uuid "d62d7bce-ab62-5ca7-9265-39a31e28ea4a"] [:db/add "d62d7bce-ab62-5ca7-9265-39a31e28ea4a" :answer/type :answer.type/math] [:db/add "d62d7bce-ab62-5ca7-9265-39a31e28ea4a" :answer/value "\\frac{1}{4}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "d62d7bce-ab62-5ca7-9265-39a31e28ea4a" :answer/validate] [:db/add "30870f00-6eb4-5005-b39d-bd2b371b5e39" :answer/id #uuid "30870f00-6eb4-5005-b39d-bd2b371b5e39"] [:db/add "30870f00-6eb4-5005-b39d-bd2b371b5e39" :answer/type :answer.type/math] [:db/add "30870f00-6eb4-5005-b39d-bd2b371b5e39" :answer/value "- \\frac{1}{4}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "30870f00-6eb4-5005-b39d-bd2b371b5e39" :answer/validate] [:db/add "64ffc532-3c93-53b6-bea2-30e3d2dc9611" :answer/id #uuid "64ffc532-3c93-53b6-bea2-30e3d2dc9611"] [:db/add "64ffc532-3c93-53b6-bea2-30e3d2dc9611" :answer/type :answer.type/math] [:db/add "64ffc532-3c93-53b6-bea2-30e3d2dc9611" :answer/value "\\frac{1}{4}\\left(\\arctan{\\left(\\frac{8 x}{3} \\right)}\\right)+C"] [:db/ensure "64ffc532-3c93-53b6-bea2-30e3d2dc9611" :answer/validate] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/id #uuid "d98c8949-a406-5f3d-8656-75cc22299dc2"] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/key "answer"] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/type :answer-field.type/radio] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/choices "c014dc67-2f00-5dd4-9396-1c264e8d0b09"] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/choices "df0856bd-8f13-5d07-a9d8-b38c175f921f"] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/choices "d62d7bce-ab62-5ca7-9265-39a31e28ea4a"] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/choices "30870f00-6eb4-5005-b39d-bd2b371b5e39"] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/choices "64ffc532-3c93-53b6-bea2-30e3d2dc9611"] [:db/add "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/correct "d62d7bce-ab62-5ca7-9265-39a31e28ea4a"] [:db/ensure "d98c8949-a406-5f3d-8656-75cc22299dc2" :answer-field/validate] [:db/add "3ce826a6-cc72-5c44-a14b-a18a76123544" :question/id #uuid "3ce826a6-cc72-5c44-a14b-a18a76123544"] [:db/add "3ce826a6-cc72-5c44-a14b-a18a76123544" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{16 x^{2} + 9}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "3ce826a6-cc72-5c44-a14b-a18a76123544" :question/worked-solution "Let $u=\\frac{4 x}{3}$. Then $\\mathrm{d}u=(\\frac{4}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n16 x^{2} + 9=9\\left(1+(\\frac{4 x}{3})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{3}{4}\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{3}\\cdot \\frac{3}{4}=\\frac{1}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{16 x^{2} + 9}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C.\n$$"] [:db/add "3ce826a6-cc72-5c44-a14b-a18a76123544" :question/difficulty :question.difficulty/hard] [:db/add "3ce826a6-cc72-5c44-a14b-a18a76123544" :question/answer-fields "d98c8949-a406-5f3d-8656-75cc22299dc2"] [:db/ensure "3ce826a6-cc72-5c44-a14b-a18a76123544" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "3ce826a6-cc72-5c44-a14b-a18a76123544"] [:db/add "03f43d10-6363-5daa-9f57-0c9f9794129e" :answer/id #uuid "03f43d10-6363-5daa-9f57-0c9f9794129e"] [:db/add "03f43d10-6363-5daa-9f57-0c9f9794129e" :answer/type :answer.type/math] [:db/add "03f43d10-6363-5daa-9f57-0c9f9794129e" :answer/value "\\frac{3}{10}\\left(\\arctan{\\left(\\frac{4 x}{5} \\right)}\\right)+C"] [:db/ensure "03f43d10-6363-5daa-9f57-0c9f9794129e" :answer/validate] [:db/add "cc2db800-0639-56aa-b9a0-6f25568c950d" :answer/id #uuid "cc2db800-0639-56aa-b9a0-6f25568c950d"] [:db/add "cc2db800-0639-56aa-b9a0-6f25568c950d" :answer/type :answer.type/math] [:db/add "cc2db800-0639-56aa-b9a0-6f25568c950d" :answer/value "\\frac{3}{20}\\left(\\arctan{\\left(\\frac{4 x}{5} \\right)}\\right)+C"] [:db/ensure "cc2db800-0639-56aa-b9a0-6f25568c950d" :answer/validate] [:db/add "f963c707-7e03-581b-acd5-29a0406ef440" :answer/id #uuid "f963c707-7e03-581b-acd5-29a0406ef440"] [:db/add "f963c707-7e03-581b-acd5-29a0406ef440" :answer/type :answer.type/math] [:db/add "f963c707-7e03-581b-acd5-29a0406ef440" :answer/value "\\frac{3}{20}\\left(\\arctan{\\left(\\frac{8 x}{5} \\right)}\\right)+C"] [:db/ensure "f963c707-7e03-581b-acd5-29a0406ef440" :answer/validate] [:db/add "0c323f7a-6d7a-5fee-b0d2-4bb795193606" :answer/id #uuid "0c323f7a-6d7a-5fee-b0d2-4bb795193606"] [:db/add "0c323f7a-6d7a-5fee-b0d2-4bb795193606" :answer/type 