rac{x}{2} \\right)}\\right)+C"] [:db/ensure "87fa5563-f417-5d51-8a3d-a5842c43bb8c" :answer/validate] [:db/add "f5413108-bf64-5157-9550-88b263f9602b" :answer/id #uuid "f5413108-bf64-5157-9550-88b263f9602b"] [:db/add "f5413108-bf64-5157-9550-88b263f9602b" :answer/type :answer.type/math] [:db/add "f5413108-bf64-5157-9550-88b263f9602b" :answer/value "\\frac{1}{2}\\left(\\arctan{\\left(\\frac{x}{4} \\right)}\\right)+C"] [:db/ensure "f5413108-bf64-5157-9550-88b263f9602b" :answer/validate] [:db/add "8549c6b1-f338-576d-8685-9bcd787ee1f2" :answer/id #uuid "8549c6b1-f338-576d-8685-9bcd787ee1f2"] [:db/add "8549c6b1-f338-576d-8685-9bcd787ee1f2" :answer/type :answer.type/math] [:db/add "8549c6b1-f338-576d-8685-9bcd787ee1f2" :answer/value "\\frac{1}{8}\\left(\\arctan{\\left(\\frac{x}{4} \\right)}\\right)+C"] [:db/ensure "8549c6b1-f338-576d-8685-9bcd787ee1f2" :answer/validate] [:db/add "f33c2287-60e1-5faa-9c8b-0f8f3ee907d8" :answer/id #uuid "f33c2287-60e1-5faa-9c8b-0f8f3ee907d8"] [:db/add "f33c2287-60e1-5faa-9c8b-0f8f3ee907d8" :answer/type :answer.type/math] [:db/add "f33c2287-60e1-5faa-9c8b-0f8f3ee907d8" :answer/value "- \\frac{1}{4}\\left(\\arctan{\\left(\\frac{x}{4} \\right)}\\right)+C"] [:db/ensure "f33c2287-60e1-5faa-9c8b-0f8f3ee907d8" :answer/validate] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/id #uuid "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27"] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/key "answer"] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/type :answer-field.type/radio] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/choices "3acc0448-fd2a-5247-b1e9-1a752ed090ff"] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/choices "87fa5563-f417-5d51-8a3d-a5842c43bb8c"] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/choices "f5413108-bf64-5157-9550-88b263f9602b"] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/choices "8549c6b1-f338-576d-8685-9bcd787ee1f2"] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/choices "f33c2287-60e1-5faa-9c8b-0f8f3ee907d8"] [:db/add "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/correct "3acc0448-fd2a-5247-b1e9-1a752ed090ff"] [:db/ensure "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27" :answer-field/validate] [:db/add "c468e5fa-6518-52c9-a916-9de209e84e3a" :question/id #uuid "c468e5fa-6518-52c9-a916-9de209e84e3a"] [:db/add "c468e5fa-6518-52c9-a916-9de209e84e3a" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "c468e5fa-6518-52c9-a916-9de209e84e3a" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{16}\\cdot 4=\\frac{1}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\arctan{\\left(\\frac{x}{4} \\right)}\\right)+C.\n$$"] [:db/add "c468e5fa-6518-52c9-a916-9de209e84e3a" :question/difficulty :question.difficulty/moderate] [:db/add "c468e5fa-6518-52c9-a916-9de209e84e3a" :question/answer-fields "d13cd7b7-42b0-5d2e-b3d1-075e1f26da27"] [:db/ensure "c468e5fa-6518-52c9-a916-9de209e84e3a" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "c468e5fa-6518-52c9-a916-9de209e84e3a"] [:db/add "2098c3eb-7c54-5dd1-85e5-8accd1cb5227" :answer/id #uuid "2098c3eb-7c54-5dd1-85e5-8accd1cb5227"] [:db/add "2098c3eb-7c54-5dd1-85e5-8accd1cb5227" :answer/type :answer.type/math] [:db/add "2098c3eb-7c54-5dd1-85e5-8accd1cb5227" :answer/value "\\frac{4}{5}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "2098c3eb-7c54-5dd1-85e5-8accd1cb5227" :answer/validate] [:db/add "72abfe11-1ac4-594b-bfca-5781f2d86621" :answer/id #uuid "72abfe11-1ac4-594b-bfca-5781f2d86621"] [:db/add "72abfe11-1ac4-594b-bfca-5781f2d86621" :answer/type :answer.type/math] [:db/add "72abfe11-1ac4-594b-bfca-5781f2d86621" :answer/value "\\frac{8}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C"] [:db/ensure "72abfe11-1ac4-594b-bfca-5781f2d86621" :answer/validate] [:db/add "2907bc60-6e8a-56b5-857d-03327fa2c2e6" :answer/id #uuid "2907bc60-6e8a-56b5-857d-03327fa2c2e6"] [:db/add "2907bc60-6e8a-56b5-857d-03327fa2c2e6" :answer/type :answer.type/math] [:db/add "2907bc60-6e8a-56b5-857d-03327fa2c2e6" :answer/value "\\frac{4}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C"] [:db/ensure "2907bc60-6e8a-56b5-857d-03327fa2c2e6" :answer/validate] [:db/add "bde6f376-c854-5b67-93e8-19d710f17e43" :answer/id #uuid "bde6f376-c854-5b67-93e8-19d710f17e43"] [:db/add "bde6f376-c854-5b67-93e8-19d710f17e43" :answer/type :answer.type/math] [:db/add "bde6f376-c854-5b67-93e8-19d710f17e43" :answer/value "\\frac{8}{5}\\left(\\arctan{\\left(\\frac{2 x}{5} \\right)}\\right)+C"] [:db/ensure "bde6f376-c854-5b67-93e8-19d710f17e43" :answer/validate] [:db/add "56fd3fae-8f97-53c2-a77f-fd0ee915e481" :answer/id #uuid "56fd3fae-8f97-53c2-a77f-fd0ee915e481"] [:db/add "56fd3fae-8f97-53c2-a77f-fd0ee915e481" :answer/type :answer.type/math] [:db/add "56fd3fae-8f97-53c2-a77f-fd0ee915e481" :answer/value "\\frac{4}{5}\\left(\\arctan{\\left(\\frac{x}{10} \\right)}\\right)+C"] [:db/ensure "56fd3fae-8f97-53c2-a77f-fd0ee915e481" :answer/validate] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/id #uuid "fa055404-8fc2-54a3-bb66-b71c838e17ea"] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/key "answer"] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/type :answer-field.type/radio] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/choices "2098c3eb-7c54-5dd1-85e5-8accd1cb5227"] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/choices "72abfe11-1ac4-594b-bfca-5781f2d86621"] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/choices "2907bc60-6e8a-56b5-857d-03327fa2c2e6"] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/choices "bde6f376-c854-5b67-93e8-19d710f17e43"] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/choices "56fd3fae-8f97-53c2-a77f-fd0ee915e481"] [:db/add "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/correct "2907bc60-6e8a-56b5-857d-03327fa2c2e6"] [:db/ensure "fa055404-8fc2-54a3-bb66-b71c838e17ea" :answer-field/validate] [:db/add "66af0e53-591d-587e-aee6-693863873082" :question/id #uuid "66af0e53-591d-587e-aee6-693863873082"] [:db/add "66af0e53-591d-587e-aee6-693863873082" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{x^{2} + 25}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "66af0e53-591d-587e-aee6-693863873082" :question/worked-solution "Let $u=\\frac{x}{5}$. Then $\\mathrm{d}u=(\\frac{1}{5})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 25=25\\left(1+(\\frac{x}{5})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=5\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{25}\\cdot 5=\\frac{4}{5}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{x^{2} + 25}\\,\\mathrm{d}x\\\\&=\\frac{4}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{4}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{4}{5}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C.\n$$"] [:db/add "66af0e53-591d-587e-aee6-693863873082" :question/difficulty :question.difficulty/moderate] [:db/add "66af0e53-591d-587e-aee6-693863873082" :question/answer-fields "fa055404-8fc2-54a3-bb66-b71c838e17ea"] [:db/ensure "66af0e53-591d-587e-aee6-693863873082" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "66af0e53-591d-587e-aee6-693863873082"] [:db/add "e5dc4260-37b8-5d44-9a14-3814a3e50d32" :answer/id #uuid "e5dc4260-37b8-5d44-9a14-3814a3e50d32"] [:db/add "e5dc4260-37b8-5d44-9a14-3814a3e50d32" :answer/type :answer.type/math] [:db/add "e5dc4260-37b8-5d44-9a14-3814a3e50d32" :answer/value "\\frac{3}{2}\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "e5dc4260-37b8-5d44-9a14-3814a3e50d32" :answer/validate] [:db/add "469ae50d-f195-54eb-8f7d-56878e62c271" :answer/id #uuid "469ae50d-f195-54eb-8f7d-56878e62c271"] [:db/add "469ae50d-f195-54eb-8f7d-56878e62c271" :answer/type :answer.type/math] [:db/add "469ae50d-f195-54eb-8f7d-56878e62c271" :answer/value "\\frac{3}{2}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "469ae50d-f195-54eb-8f7d-56878e62c271" :answer/validate] [:db/add "9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1" :answer/id #uuid "9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1"] [:db/add "9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1" :answer/type :answer.type/math] [:db/add "9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1" :answer/value "- \\frac{3}{2}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1" :answer/validate] [:db/add "8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c" :answer/id #uuid "8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c"] [:db/add "8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c" :answer/type :answer.type/math] [:db/add "8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c" :answer/value "3\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c" :answer/vali