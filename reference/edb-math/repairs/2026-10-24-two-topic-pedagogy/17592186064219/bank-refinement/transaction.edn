0-e442-5ada-8836-756efab9051f" :question/answer-fields "aa633258-5a00-5129-a81e-a47342fe3075"] [:db/ensure "b0cc5f00-e442-5ada-8836-756efab9051f" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "b0cc5f00-e442-5ada-8836-756efab9051f"] [:db/add "f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab" :answer/id #uuid "f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab"] [:db/add "f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab" :answer/type :answer.type/math] [:db/add "f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab" :answer/value "- \\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab" :answer/validate] [:db/add "650426ac-8551-55ce-b37d-729a06c6a9fb" :answer/id #uuid "650426ac-8551-55ce-b37d-729a06c6a9fb"] [:db/add "650426ac-8551-55ce-b37d-729a06c6a9fb" :answer/type :answer.type/math] [:db/add "650426ac-8551-55ce-b37d-729a06c6a9fb" :answer/value "\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "650426ac-8551-55ce-b37d-729a06c6a9fb" :answer/validate] [:db/add "6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39" :answer/id #uuid "6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39"] [:db/add "6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39" :answer/type :answer.type/math] [:db/add "6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39" :answer/value "\\frac{1}{8}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39" :answer/validate] [:db/add "269c2889-72b7-5b8e-979b-cd96fa4104fb" :answer/id #uuid "269c2889-72b7-5b8e-979b-cd96fa4104fb"] [:db/add "269c2889-72b7-5b8e-979b-cd96fa4104fb" :answer/type :answer.type/math] [:db/add "269c2889-72b7-5b8e-979b-cd96fa4104fb" :answer/value "- \\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "269c2889-72b7-5b8e-979b-cd96fa4104fb" :answer/validate] [:db/add "76d4b423-515e-55e4-811a-88eba44b91b1" :answer/id #uuid "76d4b423-515e-55e4-811a-88eba44b91b1"] [:db/add "76d4b423-515e-55e4-811a-88eba44b91b1" :answer/type :answer.type/math] [: