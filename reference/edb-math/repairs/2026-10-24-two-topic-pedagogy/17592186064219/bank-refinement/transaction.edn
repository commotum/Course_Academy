 \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "16009ab5-a679-5c44-b2eb-746d0fc16291" :question/difficulty :question.difficulty/easy] [:db/add "16009ab5-a679-5c44-b2eb-746d0fc16291" :question/answer-fields "a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd"] [:db/ensure "16009ab5-a679-5c44-b2eb-746d0fc16291" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "16009ab5-a679-5c44-b2eb-746d0fc16291"] [:db/add "c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4" :answer/id #uuid "c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4"] [:db/add "c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4" :answer/type :answer.type/math] [:db/add "c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4" :answer/value "\\frac{2}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4" :answer/validate] [:db/add "561e9854-4b58-5e69-8555-dc68db74eff2" :answer/id #uuid "561e9854-4b58-5e69-8555-dc68db74eff2"] [:db/add "561e9854-4b58-5e69-8555-dc68db74eff2" :answer/type :answer.type/math] [:db/add "561e9854-4b58-5e69-8555-dc68db74eff2" :answer/value "\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "561e9854-4b58-5e69-8555-dc68db74eff2" :answer/validate] [:db/add "5e155647-82db-522f-8149-0265ba86d1f4" :answer/id #uuid "5e155647-82db-522f-8149-0265ba86d1f4"] [:db/add "5e155647-82db-522f-8149-0265ba86d1f4" :answer/type :answer.type/math] [:db/add "5e155647-82db-522f-8149-0265ba86d1f4" :answer/value "\\frac{1}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "5e155647-82db-522f-8149-0265ba86d1f4" :answer/validate] [:db/add "354e5a1d-6239-596d-8864-9794bb81c6b2" :answer/id #uuid "354e5a1d-6239-596d-8864-9794bb81c6b2"] [:db/add "354e5a1d-6239-596d-8864-9794bb81c6b2" :answer/type :answer.type/math] [:db/add "354e5a1d-6239-596d-8864-9794bb81c6b2" :answer/value "2\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "354e5a1d-6239-596d-8864-9794bb81c6b2" :answer/validate] [:db/add "da312fe9-d1d7-5185-923b-f7d