n{\\left(2 x \\right)}\\right)+C.\n$$"] [:db/add "a308e958-b4cd-5526-a857-73e4e190217a" :question/difficulty :question.difficulty/hard] [:db/add "a308e958-b4cd-5526-a857-73e4e190217a" :question/answer-fields "8baff00d-4a0c-5ed9-8a90-c55e91e07248"] [:db/ensure "a308e958-b4cd-5526-a857-73e4e190217a" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "a308e958-b4cd-5526-a857-73e4e190217a"] [:db/add "6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7" :answer/id #uuid "6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7"] [:db/add "6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7" :answer/type :answer.type/math] [:db/add "6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7" :answer/value "- \\frac{1}{6}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7" :answer/validate] [:db/add "44e12667-4a90-5b47-b510-7f195553a03c" :answer/id #uuid "44e12667-4a90-5b47-b510-7f195553a03c"] [:db/add "44e12667-4a90-5b47-b510-7f195553a03c" :answer/type :answer.type/math] [:db/add "44e12667-4a90-5b47-b510-7f195553a03c" :answer/value "\\frac{1}{12}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C"] [:db/ensure "44e12667-4a90-5b47-b510-7f195553a03c" :answer/validate] [:db/add "65cbc094-856a-5af4-9be8-c42bab87c75b" :answer/id #uuid "65cbc094-856a-5af4-9be8-c42bab87c75b"] [:db/add "65cbc094-856a-5af4-9be8-c42bab87c75b" :answer/type :answer.type/math] [:db/add "65cbc094-856a-5af4-9be8-c42bab87c75b" :answer/value "- \\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C"] [:db/ensure "65cbc094-856a-5af4-9be8-c42bab87c75b" :answer/validate] [:db/add "fda0219e-c2e9-5cc1-8e39-a1df867b186f" :answer/id #uuid "fda0219e-c2e9-5cc1-8e39-a1df867b186f"] [:db/add "fda0219e-c2e9-5cc1-8e39-a1df867b186f" :answer/type :answer.type/math] [:db/add "fda0219e-c2e9-5cc1-8e39-a1df867b186f" :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C"] [:db/ensure "fda0219e-c2e9-5cc1-8e39-a1df867b186f" :answer/validate] [:db/add "67fc66f2-b3f7-5044-8211-2ffab214