  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"59b92c79-2953-5a73-9464-a9e75ff21136\" :answer/id #uuid \"59b92c79-2953-5a73-9464-a9e75ff21136\"] [:db/add \"59b92c79-2953-5a73-9464-a9e75ff21136\" :answer/type :answer.type/math] [:db/add \"59b92c79-2953-5a73-9464-a9e75ff21136\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"59b92c79-2953-5a73-9464-a9e75ff21136\" :answer/validate] [:db/add \"9e44a9fc-1ef8-569e-939a-e12792e55080\" :answer/id #uuid \"9e44a9fc-1ef8-569e-939a-e12792e55080\"] [:db/add \"9e44a9fc-1ef8-569e-939a-e12792e55080\" :answer/type :answer.type/math] [:db/add \"9e44a9fc-1ef8-569e-939a-e12792e55080\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"9e44a9fc-1ef8-569e-939a-e12792e55080\" :answer/validate] [:db/add \"e6701675-ef00-5467-867a-5476aefd2ee7\" :answer/id #uuid \"e6701675-ef00-5467-867a-5476aefd2ee7\"] [:db/add \"e6701675-ef00-5467-867a-5476aefd2ee7\" :answer/type :answer.type/math] [:db/add \"e6701675-ef00-5467-867a-5476aefd2ee7\" :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"e6701675-ef00-5467-867a-5476aefd2ee7\" :answer/validate] [:db/add \"a023b23e-3d62-5ddd-9469-9ea07ca10534\" :answer/id #uuid \"a023b23e-3d62-5ddd-9469-9ea07ca10534\"] [:db/add \"a023b23e-3d62-5ddd-9469-9ea07ca10534\" :answer/type :answer.type/math] [:db/add \"a023b23e-3d62-5ddd-9469-9ea07ca10534\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a023b23e-3d62-5ddd-9469-9ea07ca10534\" :answer/validate] [:db/add \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\" :answer/id #uuid \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\"] [:db/add \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\" :answer/type :answer.type/math] [:db/add \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\" :answer/validate] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/id #uuid \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\"] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/key \"answer\"] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/type :answer-field.type/radio] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"59b92c79-2953-5a73-9464-a9e75ff21136\"] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"9e44a9fc-1ef8-569e-939a-e12792e55080\"] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"e6701675-ef00-5467-867a-5476aefd2ee7\"] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"a023b23e-3d62-5ddd-9469-9ea07ca10534\"] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\"] [:db/add \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/correct \"e6701675-ef00-5467-867a-5476aefd2ee7\"] [:db/ensure \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/validate] [:db/add \"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/id #uuid \"e71b6dde-1c12-54b1-92fd-83bba7e53414\"] [:db/add \"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/difficulty :question.difficulty/easy] [:db/add \"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/answer-fields \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\"] [:db/ensure \"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"e71b6dde-1c12-54b1-92fd-83bba7e53414\"] [:db/add \"589e6b4c-061f-566b-8eb2-af6b447262e0\" :answer/id #uuid \"589e6b4c-061f-566b-8eb2-af6b447262e0\"] [:db/add \"589e6b4c-061f-566b-8eb2-af6b447262e0\" :answer/type :answer.type/math] [:db/add \"589e6b4c-061f-566b-8eb2-af6b447262e0\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"589e6b4c-061f-566b-8eb2-af6b447262e0\" :answer/validate] [:db/add \"e7f083e6-4824-5617-b202-dc52880caff3\" :answer/id #uuid \"e7f083e6-4824-5617-b202-dc52880caff3\"] [:db/add \"e7f083e6-4824-5617-b202-dc52880caff3\" :answer/type :answer.type/math] [:db/add \"e7f083e6-4824-5617-b202-dc52880caff3\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e7f083e6-4824-5617-b202-dc52880caff3\" :answer/validate] [:db/add \"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\" :answer/id #uuid \"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\"] [:db/add \"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\" :answer/type :answer.type/math] [:db/add \"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\" :answer/validate] [:db/add \"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\" :answer/id #uuid \"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\"] [:db/add \"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\" :answer/type :answer.type/math] [:db/add \"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"4cb99639-aff0-5cfa-81ff-c