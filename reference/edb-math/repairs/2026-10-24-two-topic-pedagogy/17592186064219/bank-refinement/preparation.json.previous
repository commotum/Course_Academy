\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/difficulty :question.difficulty/easy] [:db/add \"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/answer-fields \"aa633258-5a00-5129-a81e-a47342fe3075\"] [:db/ensure \"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"b0cc5f00-e442-5ada-8836-756efab9051f\"] [:db/add \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\" :answer/id #uuid \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\"] [:db/add \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\" :answer/type :answer.type/math] [:db/add \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\" :answer/validate] [:db/add \"650426ac-8551-55ce-b37d-729a06c6a9fb\" :answer/id #uuid \"650426ac-8551-55ce-b37d-729a06c6a9fb\"] [:db/add \"650426ac-8551-55ce-b37d-729a06c6a9fb\" :answer/type :answer.type/math] [:db/add \"650426ac-8551-55ce-b37d-729a06c6a9fb\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"650426ac-8551-55ce-b37d-729a06c6a9fb\" :answer/validate] [:db/add \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\" :answer/id #uuid \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\"] [:db/add \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\" :answer/type :answer.type/math] [:db/add \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\" :answer/validate] [:db/add \"269c2889-72b7-5b8e-979b-cd96fa4104fb\" :answer/id #uuid \"269c2889-72b7-5b8e-979b-cd96fa4104fb\"] [:db/add \"269c2889-72b7-5b8e-979b-cd96fa4104fb\" :answer/type :answer.type/math] [:db/add \"269c2889-72b7-5b8e-979b-cd96fa4104fb\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"269c2889-72b7-5b8e-979b-cd96fa4104fb\" :answer/validate] [:db/add \"76d4b423-515e-55e4-811a-88eba44b91b1\" :answer/id #uuid \"76d4b423-515e-55e4-811a-88eba44b91b1\"] [:db/add \"76d4b423-515e-55e4-811a-88eba44b91b1\" :answer/type :answer.type/math] [:db/add \"76d4b423-515e-55e4-811a-88eba44b91b1\" :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"76d4b423-515e-55e4-811a-88eba44b91b1\" :answer/validate] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/id #uuid \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\"] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/key \"answer\"] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/type :answer-field.type/radio] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\"] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"650426ac-8551-55ce-b37d-729a06c6a9fb\"] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\"] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"269c2889-72b7-5b8e-979b-cd96fa4104fb\"] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"76d4b423-515e-55e4-811a-88eba44b91b1\"] [:db/add \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/correct \"650426ac-8551-55ce-b37d-729a06c6a9fb\"] [:db/ensure \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/validate] [:db/add \"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/id #uuid \"16009ab5-a679-5c44-b2eb-746d0fc16291\"] [:db/add \"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/difficulty :question.difficulty/easy] [:db/add \"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/answer-fields \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\"] [:db/ensure \"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"16009ab5-a679-5c44-b2eb-746d0fc16291\"] [:db/add \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\" :answer/id #uuid \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\"] [:db/add \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\" :answer/type :answer.type/math] [:db/add \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\" :answer/validate] [:db/add \"561e9854-4b58-5e69-8555-dc68db74eff2\" :answer/id #uuid \"561e9854-4b58-5e69-8555-dc68db74eff2\"] [:db/add \"561e9854-4b58-5e69-8555-dc68db74eff2\" :answer/type :answer.type/math] [:db/add \"561e9854-4b58-5e69-8555-dc68db74eff2\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"561e9854-4b58-5e69-8555-dc68db74eff2\" :answer/validate] [:db/add \"5e155647-82db-522f-8149-0265ba86d1f4\" :answer/id #uuid \"5e155647-82db-522f-8149-0265ba86d1f4\"] [:db/add \"5e155647-82db-522f-8149-0265ba86d1f4\" :answer/type :answer.type/math] [:db/add \"5e155647-82db-522f-8149-0265ba86d1f4\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5e155647-82db-522f-8149-0265ba86d1f4\" :answer/validate] [:db/add \"354e5a1d-6239-596d-8864-9794bb81c6b2\" :answer/id #uuid \"354e5a1d-6239-596d-8864-9794bb81c6b2\"] [:db/add \"354e5a1d-6239-596d-8864-9794bb81c6b2\" :answer/type :answer.type/math] [:db/add \"354e5a1d-6239-596d-8864-9794bb81c6b2\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"354e5a1d-6239-596d-8864-9794bb81c6b2\" :answer/validate] [:db/add \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\" :answer/id #uuid \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\"] [:db/add \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\" :answer/type :answer.type/math] [:db/add \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\" :answer/validate] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/id #uuid \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\"] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/key \"answer\"] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/type :answer-field.type/radio] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\"] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"561e9854-4b58-5e69-8555-dc68db74eff2\"] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"5e155647-82db-522f-8149-0265ba86d1f4\"] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"354e5a1d-6239-596d-8864-9794bb81c6b2\"] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\"] [:db/add \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/correct \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\"] [:db/ensure \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/validate] [:db/add \"742eb033-7af1-5b39-afdc-28b695c36434\" :question/id #uuid \"742eb033-7af1-5b39-afdc-28b695c36434\"] [:db/add \"742eb033-7af1-5b39-afdc-28b695c36434\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"742eb033-7af1-5b39-afdc-28b695c36434\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"742eb033-7af1-5b39-afdc-28b695c36434\" :question/difficulty :question.difficulty/easy] [:db/add \"742eb033-7af1-5b39-afdc-28b695c36434\" :question/answer-fields \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\"] [:db/ensure \"742eb033-7af1-5b39-afdc-28b695c36434\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"742eb033-7af1-5b39-afdc-28b695c36434\"] [:db/add \"b8456012-0c9a-5ed2-9800-9d64dd88e451\" :answer/id #uuid \"b8456012-0c9a-5ed2-9800-9d64dd88e451\"] [:db/add \"b8456012-0c9a-5ed2-9800-9d64dd88e451\" :answer/type :answer.type/math] [:db/add \"b8456012-0c9a-5ed2-9800-9d64dd88e451\" :answer/value \"- \\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b8456012-0c9a-5ed2-9800-9d64dd88e451\" :answer/validate] [:db/add \"03572d80-e12b-53dc-a298-597fae2c389c\" :answer/id #uuid \"03572d80-e12b-53dc-a298-597fae2c389c\"] [:db/add \"03572d80-e12b-53dc-a298-597fae2c389c\" :answer/type :answer.type/math] [:db/add \"03572d80-e12b-53dc-a298-597fae2c389c\" :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"03572d80-e12b-53dc-a298-597fae2c389c\" :answer/validate] [:db/add \"06d15fad-b91d-538d-8776-aa0171a60866\" :answer/id #uuid \"06d15fad-b91d-538d-8776-aa0171a60866\"] [:db/add \"06d15fad-b91d-538d-8776-aa0171a60866\" :answer/type :answer.type/math] [:db/add \"06d15fad-b91d-538d-8776-aa0171a60866\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"06d15fad-b91d-538d-8776-aa0171a60866\" :answer/validate] [:db/add \"c5d976d2-91cd-5267-a006-4262ea01d269\" :answer/id #uuid \"c5d976d2-91cd-5267-a006-4262ea01d269\"] [:db/add \"c5d976d2-91cd-5267-a006-4262ea01d269\" :answer/type :answer.type/math] [:db/add \"c5d976d2-91cd-5267-a006-4262ea01d269\" :answer/value \"\\\\frac{1}{15}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c5d976d2-91cd-5267-a006-4262ea01d269\" :answer/validate] [:db/add \"074cde7a-f303-517c-9737-d49937610f37\" :answer/id #uuid \"074cde7a-f303-517c-9737-d49937610f37\"] [:db/add \"074cde7a-f303-517c-9737-d49937610f37\" :answer/type :answer.type/math] [:db/add \"074cde7a-f303-517c-9737-d49937610f37\" :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"074cde7a-f303-517c-9737-d49937610f37\" :answer/validate] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/id #uuid \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\"] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/key \"answer\"] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/type :answer-field.type/radio] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"b8456012-0c9a-5ed2-9800-9d64dd88e451\"] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"03572d80-e12b-53dc-a298-597fae2c389c\"] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"06d15fad-b91d-538d-8776-aa0171a60866\"] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"c5d976d2-91cd-5267-a006-4262ea01d269\"] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"074cde7a-f303-517c-9737-d49937610f37\"] [:db/add \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/correct \"03572d80-e12b-53dc-a298-597fae2c389c\"] [:db/ensure \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/validate] [:db/add \"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/id #uuid \"ffc217a5-b1b2-51be-9f8a-39195f4970de\"] [:db/add \"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/difficulty :question.difficulty/easy] [:db/add \"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/answer-fields \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\"] [:db/ensure \"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"ffc217a5-b1b2-51be-9f8a-39195f4970de\"] [:db/add \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\" :answer/id #uuid \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\"] [:db/add \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\" :answer/type :answer.type/math] [:db/add \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\" :answer/value \"\\\\frac{12}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\" :answer/validate] [:db/add \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\" :answer/id #uuid \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\"] [:db/add \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\" :answer/type :answer.type/math] [:db/add \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\" :answer/value \"- \\\\frac{9}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\" :answer/validate] [:db/add \"ab68c3cd-e916-5326-9e3c-826758ed9380\" :answer/id #uuid \"ab68c3cd-e916-5326-9e3c-826758ed9380\"] [:db/add \"ab68c3cd-e916-5326-9e3c-826758ed9380\" :answer/type :answer.type/math] [:db/add \"ab68c3cd-e916-5326-9e3c-826758ed9380\" :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"ab68c3cd-e916-5326-9e3c-826758ed9380\" :answer/validate] [:db/add \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\" :answer/id #uuid \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\"] [:db/add \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\" :answer/type :answer.type/math] [:db/add \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\" :answer/value \"\\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\" :answer/validate] [:db/add \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\" :answer/id #uuid \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\"] [:db/add \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\" :answer/type :answer.type/math] [:db/add \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\" :answer/validate] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/id #uuid \"5b600c66-96d7-5ed6-8a86-07c8240bde90\"] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/key \"answer\"] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/type :answer-field.type/radio] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\"] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\"] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"ab68c3cd-e916-5326-9e3c-826758ed9380\"] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\"] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\"] [:db/add \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/correct \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\"] [:db/ensure \"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/validate] [:db/add \"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/id #uuid \"326877fc-3e06-5e0f-b995-2979b1ac80f1\"] [:db/add \"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/difficulty :question.difficulty/easy] [:db/add \"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/answer-fields \"5b600c66-96d7-5ed6-8a86-07c8240bde90\"] [:db/ensure \"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"326877fc-3e06-5e0f-b995-2979b1ac80f1\"] [:db/add \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\" :answer/id #uuid \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\"] [:db/add \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\" :answer/type :answer.type/math] [:db/add \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\" :answer/validate] [:db/add \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\" :answer/id #uuid \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\"] [:db/add \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\" :answer/type :answer.type/math] [:db/add \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\" :answer/validate] [:db/add \"d7149571-0bdc-5032-80f8-1ff25d70960c\" :answer/id #uuid \"d7149571-0bdc-5032-80f8-1ff25d70960c\"] [:db/add \"d7149571-0bdc-5032-80f8-1ff25d70960c\" :answer/type :answer.type/math] [:db/add \"d7149571-0bdc-5032-80f8-1ff25d70960c\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d7149571-0bdc-5032-80f8-1ff25d70960c\" :answer/validate] [:db/add \"1fca9c08-3365-5833-9024-465f8d9ad0b5\" :answer/id #uuid \"1fca9c08-3365-5833-9024-465f8d9ad0b5\"] [:db/add \"1fca9c08-3365-5833-9024-465f8d9ad0b5\" :answer/type :answer.type/math] [:db/add \"1fca9c08-3365-5833-9024-465f8d9ad0b5\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"1fca9c08-3365-5833-9024-465f8d9ad0b5\" :answer/validate] [:db/add \"c5191998-230b-522a-8fc6-3b49c5b0a12d\" :answer/id #uuid \"c5191998-230b-522a-8fc6-3b49c5b0a12d\"] [:db/add \"c5191998-230b-522a-8fc6-3b49c5b0a12d\" :answer/type :answer.type/math] [:db/add \"c5191998-230b-522a-8fc6-3b49c5b0a12d\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c5191998-230b-522a-8fc6-3b49c5b0a12d\" :answer/validate] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/id #uuid \"0a24272e-22c8-5464-990e-f2ad65525a53\"] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/key \"answer\"] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/type :answer-field.type/radio] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\"] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\"] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"d7149571-0bdc-5032-80f8-1ff25d70960c\"] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"1fca9c08-3365-5833-9024-465f8d9ad0b5\"] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"c5191998-230b-522a-8fc6-3b49c5b0a12d\"] [:db/add \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/correct \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\"] [:db/ensure \"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/validate] [:db/add \"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/id #uuid \"56046fbb-ce1f-55ee-91ec-49b9c175761d\"] [:db/add \"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/difficulty :question.difficulty/easy] [:db/add \"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/answer-fields \"0a24272e-22c8-5464-990e-f2ad65525a53\"] [:db/ensure \"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"56046fbb-ce1f-55ee-91ec-49b9c175761d\"] [:db/add \"3300feb1-71d9-55c9-ae23-496ab14ad212\" :answer/id #uuid \"3300feb1-71d9-55c9-ae23-496ab14ad212\"] [:db/add \"3300feb1-71d9-55c9-ae23-496ab14ad212\" :answer/type :answer.type/math] [:db/add \"3300feb1-71d9-55c9-ae23-496ab14ad212\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"3300feb1-71d9-55c9-ae23-496ab14ad212\" :answer/validate] [:db/add \"f713ea60-0699-5812-8465-53b23b5ce654\" :answer/id #uuid \"f713ea60-0699-5812-8465-53b23b5ce654\"] [:db/add \"f713ea60-0699-5812-8465-53b23b5ce654\" :answer/type :answer.type/math] [:db/add \"f713ea60-0699-5812-8465-53b23b5ce654\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f713ea60-0699-5812-8465-53b23b5ce654\" :answer/validate] [:db/add \"41b22fb4-5986-5108-9468-4d9a520d5fd6\" :answer/id #uuid \"41b22fb4-5986-5108-9468-4d9a520d5fd6\"] [:db/add \"41b22fb4-5986-5108-9468-4d9a520d5fd6\" :answer/type :answer.type/math] [:db/add \"41b22fb4-5986-5108-9468-4d9a520d5fd6\" :answer/value \"- \\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"41b22fb4-5986-5108-9468-4d9a520d5fd6\" :answer/validate] [:db/add \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\" :answer/id #uuid \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\"] [:db/add \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\" :answer/type :answer.type/math] [:db/add \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\" :answer/validate] [:db/add \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\" :answer/id #uuid \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\"] [:db/add \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\" :answer/type :answer.type/math] [:db/add \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\" :answer/value \"\\\\frac{3}{16}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\" :answer/validate] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/id #uuid \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\"] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/key \"answer\"] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/type :answer-field.type/radio] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"3300feb1-71d9-55c9-ae23-496ab14ad212\"] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"f713ea60-0699-5812-8465-53b23b5ce654\"] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"41b22fb4-5986-5108-9468-4d9a520d5fd6\"] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\"] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\"] [:db/add \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/correct \"f713ea60-0699-5812-8465-53b23b5ce654\"] [:db/ensure \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/validate] [:db/add \"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/id #uuid \"be980eab-200a-5d87-8dad-ba24bca2cf9f\"] [:db/add \"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/difficulty :question.difficulty/easy] [:db/add \"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/answer-fields \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\"] [:db/ensure \"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"be980eab-200a-5d87-8dad-ba24bca2cf9f\"] [:db/add \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\" :answer/id #uuid \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\"] [:db/add \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\" :answer/type :answer.type/math] [:db/add \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\" :answer/validate] [:db/add \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\" :answer/id #uuid \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\"] [:db/add \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\" :answer/type :answer.type/math] [:db/add \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\" :answer/validate] [:db/add \"f5413108-bf64-5157-9550-88b263f9602b\" :answer/id #uuid \"f5413108-bf64-5157-9550-88b263f9602b\"] [:db/add \"f5413108-bf64-5157-9550-88b263f9602b\" :answer/type :answer.type/math] [:db/add \"f5413108-bf64-5157-9550-88b263f9602b\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"f5413108-bf64-5157-9550-88b263f9602b\" :answer/validate] [:db/add \"8549c6b1-f338-576d-8685-9bcd787ee1f2\" :answer/id #uuid \"8549c6b1-f338-576d-8685-9bcd787ee1f2\"] [:db/add \"8549c6b1-f338-576d-8685-9bcd787ee1f2\" :answer/type :answer.type/math] [:db/add \"8549c6b1-f338-576d-8685-9bcd787ee1f2\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"8549c6b1-f338-576d-8685-9bcd787ee1f2\" :answer/validate] [:db/add \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\" :answer/id #uuid \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\"] [:db/add \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\" :answer/type :answer.type/math] [:db/add \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\" :answer/validate] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/id #uuid \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\"] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/key \"answer\"] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/type :answer-field.type/radio] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\"] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\"] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"f5413108-bf64-5157-9550-88b263f9602b\"] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"8549c6b1-f338-576d-8685-9bcd787ee1f2\"] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\"] [:db/add \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/correct \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\"] [:db/ensure \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/validate] [:db/add \"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/id #uuid \"c468e5fa-6518-52c9-a916-9de209e84e3a\"] [:db/add \"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 16=16\\\\left(1+(\\\\frac{x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{16}\\\\cdot 4=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/difficulty :question.difficulty/moderate] [:db/add \"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/answer-fields \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\"] [:db/ensure \"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"c468e5fa-6518-52c9-a916-9de209e84e3a\"] [:db/add \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\" :answer/id #uuid \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\"] [:db/add \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\" :answer/type :answer.type/math] [:db/add \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\" :answer/validate] [:db/add \"72abfe11-1ac4-594b-bfca-5781f2d86621\" :answer/id #uuid \"72abfe11-1ac4-594b-bfca-5781f2d86621\"] [:db/add \"72abfe11-1ac4-594b-bfca-5781f2d86621\" :answer/type :answer.type/math] [:db/add \"72abfe11-1ac4-594b-bfca-5781f2d86621\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"72abfe11-1ac4-594b-bfca-5781f2d86621\" :answer/validate] [:db/add \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\" :answer/id #uuid \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\"] [:db/add \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\" :answer/type :answer.type/math] [:db/add \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\" :answer/validate] [:db/add \"bde6f376-c854-5b67-93e8-19d710f17e43\" :answer/id #uuid \"bde6f376-c854-5b67-93e8-19d710f17e43\"] [:db/add \"bde6f376-c854-5b67-93e8-19d710f17e43\" :answer/type :answer.type/math] [:db/add \"bde6f376-c854-5b67-93e8-19d710f17e43\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"bde6f376-c854-5b67-93e8-19d710f17e43\" :answer/validate] [:db/add \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\" :answer/id #uuid \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\"] [:db/add \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\" :answer/type :answer.type/math] [:db/add \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{10} \\\\right)}\\\\right)+C\"] [:db/ensure \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\" :answer/validate] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/id #uuid \"fa055404-8fc2-54a3-bb66-b71c838e17ea\"] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/key \"answer\"] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/type :answer-field.type/radio] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\"] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"72abfe11-1ac4-594b-bfca-5781f2d86621\"] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\"] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"bde6f376-c854-5b67-93e8-19d710f17e43\"] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\"] [:db/add \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/correct \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\"] [:db/ensure \"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/validate] [:db/add \"66af0e53-591d-587e-aee6-693863873082\" :question/id #uuid \"66af0e53-591d-587e-aee6-693863873082\"] [:db/add \"66af0e53-591d-587e-aee6-693863873082\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"66af0e53-591d-587e-aee6-693863873082\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 25=25\\\\left(1+(\\\\frac{x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{25}\\\\cdot 5=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"66af0e53-591d-587e-aee6-693863873082\" :question/difficulty :question.difficulty/moderate] [:db/add \"66af0e53-591d-587e-aee6-693863873082\" :question/answer-fields \"fa055404-8fc2-54a3-bb66-b71c838e17ea\"] [:db/ensure \"66af0e53-591d-587e-aee6-693863873082\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"66af0e53-591d-587e-aee6-693863873082\"] [:db/add \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\" :answer/id #uuid \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\"] [:db/add \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\" :answer/type :answer.type/math] [:db/add \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\" :answer/validate] [:db/add \"469ae50d-f195-54eb-8f7d-56878e62c271\" :answer/id #uuid \"469ae50d-f195-54eb-8f7d-56878e62c271\"] [:db/add \"469ae50d-f195-54eb-8f7d-56878e62c271\" :answer/type :answer.type/math] [:db/add \"469ae50d-f195-54eb-8f7d-56878e62c271\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"469ae50d-f195-54eb-8f7d-56878e62c271\" :answer/validate] [:db/add \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\" :answer/id #uuid \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\"] [:db/add \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\" :answer/type :answer.type/math] [:db/add \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\" :answer/validate] [:db/add \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\" :answer/id #uuid \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\"] [:db/add \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\" :answer/type :answer.type/math] [:db/add \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\" :answer/value \"3\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\" :answer/validate] [:db/add \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\" :answer/id #uuid \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\"] [:db/add \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\" :answer/type :answer.type/math] [:db/add \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\" :answer/value \"3\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\" :answer/validate] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/id #uuid \"ced10082-f000-5a52-9d26-469ef3fe713a\"] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/key \"answer\"] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/type :answer-field.type/radio] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\"] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"469ae50d-f195-54eb-8f7d-56878e62c271\"] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\"] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\"] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\"] [:db/add \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/correct \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\"] [:db/ensure \"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/validate] [:db/add \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/id #uuid \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\"] [:db/add \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 4=4\\\\left(1+(\\\\frac{x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 2=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/difficulty :question.difficulty/moderate] [:db/add \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/answer-fields \"ced10082-f000-5a52-9d26-469ef3fe713a\"] [:db/ensure \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\"] [:db/add \"e48839bb-a08d-553d-a166-44a9e81381cb\" :answer/id #uuid \"e48839bb-a08d-553d-a166-44a9e81381cb\"] [:db/add \"e48839bb-a08d-553d-a166-44a9e81381cb\" :answer/type :answer.type/math] [:db/add \"e48839bb-a08d-553d-a166-44a9e81381cb\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"e48839bb-a08d-553d-a166-44a9e81381cb\" :answer/validate] [:db/add \"e37eec64-6d81-5a37-805b-2334fba3f964\" :answer/id #uuid \"e37eec64-6d81-5a37-805b-2334fba3f964\"] [:db/add \"e37eec64-6d81-5a37-805b-2334fba3f964\" :answer/type :answer.type/math] [:db/add \"e37eec64-6d81-5a37-805b-2334fba3f964\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"e37eec64-6d81-5a37-805b-2334fba3f964\" :answer/validate] [:db/add \"85ced902-7e5b-5863-b87a-db75f313d705\" :answer/id #uuid \"85ced902-7e5b-5863-b87a-db75f313d705\"] [:db/add \"85ced902-7e5b-5863-b87a-db75f313d705\" :answer/type :answer.type/math] [:db/add \"85ced902-7e5b-5863-b87a-db75f313d705\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"85ced902-7e5b-5863-b87a-db75f313d705\" :answer/validate] [:db/add \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\" :answer/id #uuid \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\"] [:db/add \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\" :answer/type :answer.type/math] [:db/add \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{6} \\\\right)}\\\\right)+C\"] [:db/ensure \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\" :answer/validate] [:db/add \"c7a805ae-96a0-53e2-9028-7c4a8600043e\" :answer/id #uuid \"c7a805ae-96a0-53e2-9028-7c4a8600043e\"] [:db/add \"c7a805ae-96a0-53e2-9028-7c4a8600043e\" :answer/type :answer.type/math] [:db/add \"c7a805ae-96a0-53e2-9028-7c4a8600043e\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"c7a805ae-96a0-53e2-9028-7c4a8600043e\" :answer/validate] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/id #uuid \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\"] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/key \"answer\"] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/type :answer-field.type/radio] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"e48839bb-a08d-553d-a166-44a9e81381cb\"] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"e37eec64-6d81-5a37-805b-2334fba3f964\"] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"85ced902-7e5b-5863-b87a-db75f313d705\"] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\"] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"c7a805ae-96a0-53e2-9028-7c4a8600043e\"] [:db/add \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/correct \"e48839bb-a08d-553d-a166-44a9e81381cb\"] [:db/ensure \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/validate] [:db/add \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/id #uuid \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\"] [:db/add \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 9=9\\\\left(1+(\\\\frac{x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{9}\\\\cdot 3=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/difficulty :question.difficulty/moderate] [:db/add \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/answer-fields \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\"] [:db/ensure \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\"] [:db/add \"52cfadef-31f4-5a14-a352-b40bcaffdc83\" :answer/id #uuid \"52cfadef-31f4-5a14-a352-b40bcaffdc83\"] [:db/add \"52cfadef-31f4-5a14-a352-b40bcaffdc83\" :answer/type :answer.type/math] [:db/add \"52cfadef-31f4-5a14-a352-b40bcaffdc83\" :answer/value \"\\\\arctan{\\\\left(x \\\\right)}+C\"] [:db/ensure \"52cfadef-31f4-5a14-a352-b40bcaffdc83\" :answer/validate] [:db/add \"db39502e-7b4f-5ae9-b5bf-8832191681b0\" :answer/id #uuid \"db39502e-7b4f-5ae9-b5bf-8832191681b0\"] [:db/add \"db39502e-7b4f-5ae9-b5bf-8832191681b0\" :answer/type :answer.type/math] [:db/add \"db39502e-7b4f-5ae9-b5bf-8832191681b0\" :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"db39502e-7b4f-5ae9-b5bf-8832191681b0\" :answer/validate] [:db/add \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\" :answer/id #uuid \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\"] [:db/add \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\" :answer/type :answer.type/math] [:db/add \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}+C\"] [:db/ensure \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\" :answer/validate] [:db/add \"c34cc510-f9d8-5086-957d-0d30f18e98ef\" :answer/id #uuid \"c34cc510-f9d8-5086-957d-0d30f18e98ef\"] [:db/add \"c34cc510-f9d8-5086-957d-0d30f18e98ef\" :answer/type :answer.type/math] [:db/add \"c34cc510-f9d8-5086-957d-0d30f18e98ef\" :answer/value \"-1\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"c34cc510-f9d8-5086-957d-0d30f18e98ef\" :answer/validate] [:db/add \"d274c212-cef8-5498-b381-aa043f0a7eb2\" :answer/id #uuid \"d274c212-cef8-5498-b381-aa043f0a7eb2\"] [:db/add \"d274c212-cef8-5498-b381-aa043f0a7eb2\" :answer/type :answer.type/math] [:db/add \"d274c212-cef8-5498-b381-aa043f0a7eb2\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{8} \\\\right)}+C\"] [:db/ensure \"d274c212-cef8-5498-b381-aa043f0a7eb2\" :answer/validate] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/id #uuid \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\"] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/key \"answer\"] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/type :answer-field.type/radio] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"52cfadef-31f4-5a14-a352-b40bcaffdc83\"] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"db39502e-7b4f-5ae9-b5bf-8832191681b0\"] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\"] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"c34cc510-f9d8-5086-957d-0d30f18e98ef\"] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"d274c212-cef8-5498-b381-aa043f0a7eb2\"] [:db/add \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/correct \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\"] [:db/ensure \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/validate] [:db/add \"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/id #uuid \"5afb6ae5-f525-5383-88b8-04b2b2268858\"] [:db/add \"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 16=16\\\\left(1+(\\\\frac{x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot 4=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}+C.\\n$$\"] [:db/add \"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/difficulty :question.difficulty/moderate] [:db/add \"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/answer-fields \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\"] [:db/ensure \"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"5afb6ae5-f525-5383-88b8-04b2b2268858\"] [:db/add \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\" :answer/id #uuid \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\"] [:db/add \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\" :answer/type :answer.type/math] [:db/add \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\" :answer/value \"\\\\arctan{\\\\left(x \\\\right)}+C\"] [:db/ensure \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\" :answer/validate] [:db/add \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\" :answer/id #uuid \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\"] [:db/add \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\" :answer/type :answer.type/math] [:db/add \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\" :answer/value \"-2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\" :answer/validate] [:db/add \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\" :answer/id #uuid \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\"] [:db/add \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\" :answer/type :answer.type/math] [:db/add \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\" :answer/value \"2\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\" :answer/validate] [:db/add \"0479fbb0-008e-5c66-b5ca-648b9ad05085\" :answer/id #uuid \"0479fbb0-008e-5c66-b5ca-648b9ad05085\"] [:db/add \"0479fbb0-008e-5c66-b5ca-648b9ad05085\" :answer/type :answer.type/math] [:db/add \"0479fbb0-008e-5c66-b5ca-648b9ad05085\" :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"0479fbb0-008e-5c66-b5ca-648b9ad05085\" :answer/validate] [:db/add \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\" :answer/id #uuid \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\"] [:db/add \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\" :answer/type :answer.type/math] [:db/add \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}+C\"] [:db/ensure \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\" :answer/validate] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/id #uuid \"93c8398c-67a6-5380-93e3-b4970fc200c4\"] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/key \"answer\"] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/type :answer-field.type/radio] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\"] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\"] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\"] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"0479fbb0-008e-5c66-b5ca-648b9ad05085\"] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\"] [:db/add \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/correct \"0479fbb0-008e-5c66-b5ca-648b9ad05085\"] [:db/ensure \"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/validate] [:db/add \"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/id #uuid \"374f0a15-44e2-560c-961a-a0cc2456807a\"] [:db/add \"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 4=4\\\\left(1+(\\\\frac{x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 2=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/difficulty :question.difficulty/moderate] [:db/add \"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/answer-fields \"93c8398c-67a6-5380-93e3-b4970fc200c4\"] [:db/ensure \"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"374f0a15-44e2-560c-961a-a0cc2456807a\"] [:db/add \"24115da5-fa1e-518d-97a3-073655adcc17\" :answer/id #uuid \"24115da5-fa1e-518d-97a3-073655adcc17\"] [:db/add \"24115da5-fa1e-518d-97a3-073655adcc17\" :answer/type :answer.type/math] [:db/add \"24115da5-fa1e-518d-97a3-073655adcc17\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"24115da5-fa1e-518d-97a3-073655adcc17\" :answer/validate] [:db/add \"9cda0f1f-186d-5025-9244-be8198899caf\" :answer/id #uuid \"9cda0f1f-186d-5025-9244-be8198899caf\"] [:db/add \"9cda0f1f-186d-5025-9244-be8198899caf\" :answer/type :answer.type/math] [:db/add \"9cda0f1f-186d-5025-9244-be8198899caf\" :answer/value \"\\\\frac{6}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"9cda0f1f-186d-5025-9244-be8198899caf\" :answer/validate] [:db/add \"10dd5c4c-5769-5607-9cee-b0c0674d7673\" :answer/id #uuid \"10dd5c4c-5769-5607-9cee-b0c0674d7673\"] [:db/add \"10dd5c4c-5769-5607-9cee-b0c0674d7673\" :answer/type :answer.type/math] [:db/add \"10dd5c4c-5769-5607-9cee-b0c0674d7673\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"10dd5c4c-5769-5607-9cee-b0c0674d7673\" :answer/validate] [:db/add \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\" :answer/id #uuid \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\"] [:db/add \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\" :answer/type :answer.type/math] [:db/add \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\" :answer/validate] [:db/add \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\" :answer/id #uuid \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\"] [:db/add \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\" :answer/type :answer.type/math] [:db/add \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{10} \\\\right)}\\\\right)+C\"] [:db/ensure \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\" :answer/validate] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/id #uuid \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\"] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/key \"answer\"] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/type :answer-field.type/radio] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"24115da5-fa1e-518d-97a3-073655adcc17\"] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"9cda0f1f-186d-5025-9244-be8198899caf\"] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"10dd5c4c-5769-5607-9cee-b0c0674d7673\"] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\"] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\"] [:db/add \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/correct \"24115da5-fa1e-518d-97a3-073655adcc17\"] [:db/ensure \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/validate] [:db/add \"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/id #uuid \"a54a704d-0604-583c-9a79-ad7771ee3a92\"] [:db/add \"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 25=25\\\\left(1+(\\\\frac{x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{25}\\\\cdot 5=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/difficulty :question.difficulty/moderate] [:db/add \"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/answer-fields \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\"] [:db/ensure \"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"a54a704d-0604-583c-9a79-ad7771ee3a92\"] [:db/add \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\" :answer/id #uuid \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\"] [:db/add \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\" :answer/type :answer.type/math] [:db/add \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\" :answer/validate] [:db/add \"10652b96-1c98-5d6a-b88e-5615c48f9f59\" :answer/id #uuid \"10652b96-1c98-5d6a-b88e-5615c48f9f59\"] [:db/add \"10652b96-1c98-5d6a-b88e-5615c48f9f59\" :answer/type :answer.type/math] [:db/add \"10652b96-1c98-5d6a-b88e-5615c48f9f59\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"10652b96-1c98-5d6a-b88e-5615c48f9f59\" :answer/validate] [:db/add \"8f6e7476-7343-5864-a233-ad2f35780322\" :answer/id #uuid \"8f6e7476-7343-5864-a233-ad2f35780322\"] [:db/add \"8f6e7476-7343-5864-a233-ad2f35780322\" :answer/type :answer.type/math] [:db/add \"8f6e7476-7343-5864-a233-ad2f35780322\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"8f6e7476-7343-5864-a233-ad2f35780322\" :answer/validate] [:db/add \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\" :answer/id #uuid \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\"] [:db/add \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\" :answer/type :answer.type/math] [:db/add \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\" :answer/validate] [:db/add \"27dcbd12-e676-5752-9e1b-97852310195b\" :answer/id #uuid \"27dcbd12-e676-5752-9e1b-97852310195b\"] [:db/add \"27dcbd12-e676-5752-9e1b-97852310195b\" :answer/type :answer.type/math] [:db/add \"27dcbd12-e676-5752-9e1b-97852310195b\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"27dcbd12-e676-5752-9e1b-97852310195b\" :answer/validate] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/id #uuid \"5529bbbd-486c-5333-b3f0-c2b0966c6906\"] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/key \"answer\"] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/type :answer-field.type/radio] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\"] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"10652b96-1c98-5d6a-b88e-5615c48f9f59\"] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"8f6e7476-7343-5864-a233-ad2f35780322\"] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\"] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"27dcbd12-e676-5752-9e1b-97852310195b\"] [:db/add \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/correct \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\"] [:db/ensure \"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/validate] [:db/add \"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/id #uuid \"04273c07-61db-5c6f-ab5e-ed62a376e378\"] [:db/add \"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 9=9\\\\left(1+(\\\\frac{x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{9}\\\\cdot 3=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/difficulty :question.difficulty/moderate] [:db/add \"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/answer-fields \"5529bbbd-486c-5333-b3f0-c2b0966c6906\"] [:db/ensure \"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"04273c07-61db-5c6f-ab5e-ed62a376e378\"] [:db/add \"cf7f9bd4-3000-552f-86c9-f8421db9c068\" :answer/id #uuid \"cf7f9bd4-3000-552f-86c9-f8421db9c068\"] [:db/add \"cf7f9bd4-3000-552f-86c9-f8421db9c068\" :answer/type :answer.type/math] [:db/add \"cf7f9bd4-3000-552f-86c9-f8421db9c068\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"cf7f9bd4-3000-552f-86c9-f8421db9c068\" :answer/validate] [:db/add \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\" :answer/id #uuid \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\"] [:db/add \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\" :answer/type :answer.type/math] [:db/add \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\" :answer/validate] [:db/add \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\" :answer/id #uuid \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\"] [:db/add \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\" :answer/type :answer.type/math] [:db/add \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\" :answer/validate] [:db/add \"042db0ac-edc0-5704-a363-301b14e7f963\" :answer/id #uuid \"042db0ac-edc0-5704-a363-301b14e7f963\"] [:db/add \"042db0ac-edc0-5704-a363-301b14e7f963\" :answer/type :answer.type/math] [:db/add \"042db0ac-edc0-5704-a363-301b14e7f963\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"042db0ac-edc0-5704-a363-301b14e7f963\" :answer/validate] [:db/add \"5d089b64-7bf0-5842-aa42-4775b3d32980\" :answer/id #uuid \"5d089b64-7bf0-5842-aa42-4775b3d32980\"] [:db/add \"5d089b64-7bf0-5842-aa42-4775b3d32980\" :answer/type :answer.type/math] [:db/add \"5d089b64-7bf0-5842-aa42-4775b3d32980\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"5d089b64-7bf0-5842-aa42-4775b3d32980\" :answer/validate] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/id #uuid \"314b4635-a9da-5e01-98b0-acd17aa10beb\"] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/key \"answer\"] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/type :answer-field.type/radio] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"cf7f9bd4-3000-552f-86c9-f8421db9c068\"] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\"] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\"] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"042db0ac-edc0-5704-a363-301b14e7f963\"] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"5d089b64-7bf0-5842-aa42-4775b3d32980\"] [:db/add \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/correct \"5d089b64-7bf0-5842-aa42-4775b3d32980\"] [:db/ensure \"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/validate] [:db/add \"0ea27e05-c360-5117-af78-66005d892e0d\" :question/id #uuid \"0ea27e05-c360-5117-af78-66005d892e0d\"] [:db/add \"0ea27e05-c360-5117-af78-66005d892e0d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"0ea27e05-c360-5117-af78-66005d892e0d\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 4=4\\\\left(1+(2 x)^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"0ea27e05-c360-5117-af78-66005d892e0d\" :question/difficulty :question.difficulty/hard] [:db/add \"0ea27e05-c360-5117-af78-66005d892e0d\" :question/answer-fields \"314b4635-a9da-5e01-98b0-acd17aa10beb\"] [:db/ensure \"0ea27e05-c360-5117-af78-66005d892e0d\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"0ea27e05-c360-5117-af78-66005d892e0d\"] [:db/add \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\" :answer/id #uuid \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\"] [:db/add \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\" :answer/type :answer.type/math] [:db/add \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\" :answer/validate] [:db/add \"df0856bd-8f13-5d07-a9d8-b38c175f921f\" :answer/id #uuid \"df0856bd-8f13-5d07-a9d8-b38c175f921f\"] [:db/add \"df0856bd-8f13-5d07-a9d8-b38c175f921f\" :answer/type :answer.type/math] [:db/add \"df0856bd-8f13-5d07-a9d8-b38c175f921f\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"df0856bd-8f13-5d07-a9d8-b38c175f921f\" :answer/validate] [:db/add \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\" :answer/id #uuid \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\"] [:db/add \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\" :answer/type :answer.type/math] [:db/add \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\" :answer/validate] [:db/add \"30870f00-6eb4-5005-b39d-bd2b371b5e39\" :answer/id #uuid \"30870f00-6eb4-5005-b39d-bd2b371b5e39\"] [:db/add \"30870f00-6eb4-5005-b39d-bd2b371b5e39\" :answer/type :answer.type/math] [:db/add \"30870f00-6eb4-5005-b39d-bd2b371b5e39\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"30870f00-6eb4-5005-b39d-bd2b371b5e39\" :answer/validate] [:db/add \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\" :answer/id #uuid \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\"] [:db/add \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\" :answer/type :answer.type/math] [:db/add \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\" :answer/validate] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/id #uuid \"d98c8949-a406-5f3d-8656-75cc22299dc2\"] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/key \"answer\"] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/type :answer-field.type/radio] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\"] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"df0856bd-8f13-5d07-a9d8-b38c175f921f\"] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\"] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"30870f00-6eb4-5005-b39d-bd2b371b5e39\"] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\"] [:db/add \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/correct \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\"] [:db/ensure \"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/validate] [:db/add \"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/id #uuid \"3ce826a6-cc72-5c44-a14b-a18a76123544\"] [:db/add \"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 9=9\\\\left(1+(\\\\frac{4 x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/difficulty :question.difficulty/hard] [:db/add \"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/answer-fields \"d98c8949-a406-5f3d-8656-75cc22299dc2\"] [:db/ensure \"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"3ce826a6-cc72-5c44-a14b-a18a76123544\"] [:db/add \"03f43d10-6363-5daa-9f57-0c9f9794129e\" :answer/id #uuid \"03f43d10-6363-5daa-9f57-0c9f9794129e\"] [:db/add \"03f43d10-6363-5daa-9f57-0c9f9794129e\" :answer/type :answer.type/math] [:db/add \"03f43d10-6363-5daa-9f57-0c9f9794129e\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"03f43d10-6363-5daa-9f57-0c9f9794129e\" :answer/validate] [:db/add \"cc2db800-0639-56aa-b9a0-6f25568c950d\" :answer/id #uuid \"cc2db800-0639-56aa-b9a0-6f25568c950d\"] [:db/add \"cc2db800-0639-56aa-b9a0-6f25568c950d\" :answer/type :answer.type/math] [:db/add \"cc2db800-0639-56aa-b9a0-6f25568c950d\" :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"cc2db800-0639-56aa-b9a0-6f25568c950d\" :answer/validate] [:db/add \"f963c707-7e03-581b-acd5-29a0406ef440\" :answer/id #uuid \"f963c707-7e03-581b-acd5-29a0406ef440\"] [:db/add \"f963c707-7e03-581b-acd5-29a0406ef440\" :answer/type :answer.type/math] [:db/add \"f963c707-7e03-581b-acd5-29a0406ef440\" :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"f963c707-7e03-581b-acd5-29a0406ef440\" :answer/validate] [:db/add \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\" :answer/id #uuid \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\"] [:db/add \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\" :answer/type :answer.type/math] [:db/add \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\" :answer/value \"\\\\frac{3}{40}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\" :answer/validate] [:db/add \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\" :answer/id #uuid \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\"] [:db/add \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\" :answer/type :answer.type/math] [:db/add \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\" :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\" :answer/validate] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/id #uuid \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\"] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/key \"answer\"] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/type :answer-field.type/radio] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"03f43d10-6363-5daa-9f57-0c9f9794129e\"] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"cc2db800-0639-56aa-b9a0-6f25568c950d\"] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"f963c707-7e03-581b-acd5-29a0406ef440\"] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\"] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\"] [:db/add \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/correct \"cc2db800-0639-56aa-b9a0-6f25568c950d\"] [:db/ensure \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/validate] [:db/add \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/id #uuid \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\"] [:db/add \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 25=25\\\\left(1+(\\\\frac{4 x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{25}\\\\cdot \\\\frac{5}{4}=\\\\frac{3}{20}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{20}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{20}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/difficulty :question.difficulty/hard] [:db/add \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/answer-fields \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\"] [:db/ensure \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\"] [:db/add \"e67e530c-d28e-54f4-8748-5520d3b08f18\" :answer/id #uuid \"e67e530c-d28e-54f4-8748-5520d3b08f18\"] [:db/add \"e67e530c-d28e-54f4-8748-5520d3b08f18\" :answer/type :answer.type/math] [:db/add \"e67e530c-d28e-54f4-8748-5520d3b08f18\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"e67e530c-d28e-54f4-8748-5520d3b08f18\" :answer/validate] [:db/add \"28ade528-30f0-5553-8e66-9ea3e481b310\" :answer/id #uuid \"28ade528-30f0-5553-8e66-9ea3e481b310\"] [:db/add \"28ade528-30f0-5553-8e66-9ea3e481b310\" :answer/type :answer.type/math] [:db/add \"28ade528-30f0-5553-8e66-9ea3e481b310\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"28ade528-30f0-5553-8e66-9ea3e481b310\" :answer/validate] [:db/add \"41ceda2b-bb0e-5f91-8644-6e27b958d398\" :answer/id #uuid \"41ceda2b-bb0e-5f91-8644-6e27b958d398\"] [:db/add \"41ceda2b-bb0e-5f91-8644-6e27b958d398\" :answer/type :answer.type/math] [:db/add \"41ceda2b-bb0e-5f91-8644-6e27b958d398\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"41ceda2b-bb0e-5f91-8644-6e27b958d398\" :answer/validate] [:db/add \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\" :answer/id #uuid \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\"] [:db/add \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\" :answer/type :answer.type/math] [:db/add \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\" :answer/validate] [:db/add \"9244c46c-ed63-5ef5-b25d-ca51e142b429\" :answer/id #uuid \"9244c46c-ed63-5ef5-b25d-ca51e142b429\"] [:db/add \"9244c46c-ed63-5ef5-b25d-ca51e142b429\" :answer/type :answer.type/math] [:db/add \"9244c46c-ed63-5ef5-b25d-ca51e142b429\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"9244c46c-ed63-5ef5-b25d-ca51e142b429\" :answer/validate] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/id #uuid \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\"] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/key \"answer\"] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/type :answer-field.type/radio] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"e67e530c-d28e-54f4-8748-5520d3b08f18\"] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"28ade528-30f0-5553-8e66-9ea3e481b310\"] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"41ceda2b-bb0e-5f91-8644-6e27b958d398\"] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\"] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"9244c46c-ed63-5ef5-b25d-ca51e142b429\"] [:db/add \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/correct \"e67e530c-d28e-54f4-8748-5520d3b08f18\"] [:db/ensure \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/validate] [:db/add \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/id #uuid \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\"] [:db/add \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 4=4\\\\left(1+(\\\\frac{3 x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/difficulty :question.difficulty/hard] [:db/add \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/answer-fields \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\"] [:db/ensure \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\"] [:db/add \"c7d761cd-609b-56d3-8734-276b3937faee\" :answer/id #uuid \"c7d761cd-609b-56d3-8734-276b3937faee\"] [:db/add \"c7d761cd-609b-56d3-8734-276b3937faee\" :answer/type :answer.type/math] [:db/add \"c7d761cd-609b-56d3-8734-276b3937faee\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"c7d761cd-609b-56d3-8734-276b3937faee\" :answer/validate] [:db/add \"febb7a28-a313-51d0-9039-8dd29f8fddf6\" :answer/id #uuid \"febb7a28-a313-51d0-9039-8dd29f8fddf6\"] [:db/add \"febb7a28-a313-51d0-9039-8dd29f8fddf6\" :answer/type :answer.type/math] [:db/add \"febb7a28-a313-51d0-9039-8dd29f8fddf6\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"febb7a28-a313-51d0-9039-8dd29f8fddf6\" :answer/validate] [:db/add \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\" :answer/id #uuid \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\"] [:db/add \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\" :answer/type :answer.type/math] [:db/add \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\" :answer/validate] [:db/add \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\" :answer/id #uuid \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\"] [:db/add \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\" :answer/type :answer.type/math] [:db/add \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\" :answer/value \"\\\\frac{1}{16}\\\\left(\\\\arctan{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\" :answer/validate] [:db/add \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\" :answer/id #uuid \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\"] [:db/add \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\" :answer/type :answer.type/math] [:db/add \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\" :answer/validate] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/id #uuid \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\"] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/key \"answer\"] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/type :answer-field.type/radio] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"c7d761cd-609b-56d3-8734-276b3937faee\"] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"febb7a28-a313-51d0-9039-8dd29f8fddf6\"] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\"] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\"] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\"] [:db/add \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/correct \"febb7a28-a313-51d0-9039-8dd29f8fddf6\"] [:db/ensure \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/validate] [:db/add \"a308e958-b4cd-5526-a857-73e4e190217a\" :question/id #uuid \"a308e958-b4cd-5526-a857-73e4e190217a\"] [:db/add \"a308e958-b4cd-5526-a857-73e4e190217a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"a308e958-b4cd-5526-a857-73e4e190217a\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 4=4\\\\left(1+(2 x)^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{8}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"a308e958-b4cd-5526-a857-73e4e190217a\" :question/difficulty :question.difficulty/hard] [:db/add \"a308e958-b4cd-5526-a857-73e4e190217a\" :question/answer-fields \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\"] [:db/ensure \"a308e958-b4cd-5526-a857-73e4e190217a\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"a308e958-b4cd-5526-a857-73e4e190217a\"] [:db/add \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\" :answer/id #uuid \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\"] [:db/add \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\" :answer/type :answer.type/math] [:db/add \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\" :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\" :answer/validate] [:db/add \"44e12667-4a90-5b47-b510-7f195553a03c\" :answer/id #uuid \"44e12667-4a90-5b47-b510-7f195553a03c\"] [:db/add \"44e12667-4a90-5b47-b510-7f195553a03c\" :answer/type :answer.type/math] [:db/add \"44e12667-4a90-5b47-b510-7f195553a03c\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"44e12667-4a90-5b47-b510-7f195553a03c\" :answer/validate] [:db/add \"65cbc094-856a-5af4-9be8-c42bab87c75b\" :answer/id #uuid \"65cbc094-856a-5af4-9be8-c42bab87c75b\"] [:db/add \"65cbc094-856a-5af4-9be8-c42bab87c75b\" :answer/type :answer.type/math] [:db/add \"65cbc094-856a-5af4-9be8-c42bab87c75b\" :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"65cbc094-856a-5af4-9be8-c42bab87c75b\" :answer/validate] [:db/add \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\" :answer/id #uuid \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\"] [:db/add \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\" :answer/type :answer.type/math] [:db/add \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\" :answer/validate] [:db/add \"67fc66f2-b3f7-5044-8211-2ffab2146d50\" :answer/id #uuid \"67fc66f2-b3f7-5044-8211-2ffab2146d50\"] [:db/add \"67fc66f2-b3f7-5044-8211-2ffab2146d50\" :answer/type :answer.type/math] [:db/add \"67fc66f2-b3f7-5044-8211-2ffab2146d50\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"67fc66f2-b3f7-5044-8211-2ffab2146d50\" :answer/validate] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/id #uuid \"3e4e95df-caf6-5361-91ae-90efa9338dbb\"] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/key \"answer\"] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/type :answer-field.type/radio] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\"] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"44e12667-4a90-5b47-b510-7f195553a03c\"] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"65cbc094-856a-5af4-9be8-c42bab87c75b\"] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\"] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"67fc66f2-b3f7-5044-8211-2ffab2146d50\"] [:db/add \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/correct \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\"] [:db/ensure \"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/validate] [:db/add \"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/id #uuid \"e0709212-5bdd-58e3-9994-272e5bc71470\"] [:db/add \"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/worked-solution \"Let $u=\\\\frac{3 x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 16=16\\\\left(1+(\\\\frac{3 x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{4}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{8}\\\\cdot \\\\frac{4}{3}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/difficulty :question.difficulty/hard] [:db/add \"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/answer-fields \"3e4e95df-caf6-5361-91ae-90efa9338dbb\"] [:db/ensure \"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"e0709212-5bdd-58e3-9994-272e5bc71470\"] [:db/add \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\" :answer/id #uuid \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\"] [:db/add \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\" :answer/type :answer.type/math] [:db/add \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\" :answer/validate] [:db/add \"5dae9b1b-02f7-56df-bda5-d9430830fa85\" :answer/id #uuid \"5dae9b1b-02f7-56df-bda5-d9430830fa85\"] [:db/add \"5dae9b1b-02f7-56df-bda5-d9430830fa85\" :answer/type :answer.type/math] [:db/add \"5dae9b1b-02f7-56df-bda5-d9430830fa85\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"5dae9b1b-02f7-56df-bda5-d9430830fa85\" :answer/validate] [:db/add \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\" :answer/id #uuid \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\"] [:db/add \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\" :answer/type :answer.type/math] [:db/add \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\" :answer/validate] [:db/add \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\" :answer/id #uuid \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\"] [:db/add \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\" :answer/type :answer.type/math] [:db/add \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\" :answer/validate] [:db/add \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\" :answer/id #uuid \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\"] [:db/add \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\" :answer/type :answer.type/math] [:db/add \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\" :answer/validate] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/id #uuid \"ded46afd-2fa4-5c07-9b94-69916e04b49e\"] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/key \"answer\"] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/type :answer-field.type/radio] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\"] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"5dae9b1b-02f7-56df-bda5-d9430830fa85\"] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\"] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\"] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\"] [:db/add \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/correct \"5dae9b1b-02f7-56df-bda5-d9430830fa85\"] [:db/ensure \"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/validate] [:db/add \"55bd73ee-d454-5588-844c-b8bda488729c\" :question/id #uuid \"55bd73ee-d454-5588-844c-b8bda488729c\"] [:db/add \"55bd73ee-d454-5588-844c-b8bda488729c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"55bd73ee-d454-5588-844c-b8bda488729c\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 4=4\\\\left(1+(\\\\frac{3 x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"55bd73ee-d454-5588-844c-b8bda488729c\" :question/difficulty :question.difficulty/hard] [:db/add \"55bd73ee-d454-5588-844c-b8bda488729c\" :question/answer-fields \"ded46afd-2fa4-5c07-9b94-69916e04b49e\"] [:db/ensure \"55bd73ee-d454-5588-844c-b8bda488729c\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"55bd73ee-d454-5588-844c-b8bda488729c\"] [:db/add \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\" :answer/id #uuid \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\"] [:db/add \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\" :answer/type :answer.type/math] [:db/add \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\" :answer/validate] [:db/add \"3f03ac11-7a82-5c09-9079-684083d15035\" :answer/id #uuid \"3f03ac11-7a82-5c09-9079-684083d15035\"] [:db/add \"3f03ac11-7a82-5c09-9079-684083d15035\" :answer/type :answer.type/math] [:db/add \"3f03ac11-7a82-5c09-9079-684083d15035\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"3f03ac11-7a82-5c09-9079-684083d15035\" :answer/validate] [:db/add \"56d7db6e-245f-55e1-8d82-21fa80d199ba\" :answer/id #uuid \"56d7db6e-245f-55e1-8d82-21fa80d199ba\"] [:db/add \"56d7db6e-245f-55e1-8d82-21fa80d199ba\" :answer/type :answer.type/math] [:db/add \"56d7db6e-245f-55e1-8d82-21fa80d199ba\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"56d7db6e-245f-55e1-8d82-21fa80d199ba\" :answer/validate] [:db/add \"77593972-8883-57cf-8bf9-41d5bf9a74ec\" :answer/id #uuid \"77593972-8883-57cf-8bf9-41d5bf9a74ec\"] [:db/add \"77593972-8883-57cf-8bf9-41d5bf9a74ec\" :answer/type :answer.type/math] [:db/add \"77593972-8883-57cf-8bf9-41d5bf9a74ec\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"77593972-8883-57cf-8bf9-41d5bf9a74ec\" :answer/validate] [:db/add \"62b9cde0-3fb7-5728-9982-049c9e377fdc\" :answer/id #uuid \"62b9cde0-3fb7-5728-9982-049c9e377fdc\"] [:db/add \"62b9cde0-3fb7-5728-9982-049c9e377fdc\" :answer/type :answer.type/math] [:db/add \"62b9cde0-3fb7-5728-9982-049c9e377fdc\" :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"62b9cde0-3fb7-5728-9982-049c9e377fdc\" :answer/validate] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/id #uuid \"ce5c2999-7798-568b-92d7-f217b8df4f9b\"] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/key \"answer\"] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/type :answer-field.type/radio] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\"] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"3f03ac11-7a82-5c09-9079-684083d15035\"] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"56d7db6e-245f-55e1-8d82-21fa80d199ba\"] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"77593972-8883-57cf-8bf9-41d5bf9a74ec\"] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"62b9cde0-3fb7-5728-9982-049c9e377fdc\"] [:db/add \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/correct \"77593972-8883-57cf-8bf9-41d5bf9a74ec\"] [:db/ensure \"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/validate] [:db/add \"97955500-8434-5f88-8942-e141fc073cf5\" :question/id #uuid \"97955500-8434-5f88-8942-e141fc073cf5\"] [:db/add \"97955500-8434-5f88-8942-e141fc073cf5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{4 x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"97955500-8434-5f88-8942-e141fc073cf5\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n4 x^{2} + 9=9\\\\left(1+(\\\\frac{2 x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{9}\\\\cdot \\\\frac{3}{2}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{4 x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"97955500-8434-5f88-8942-e141fc073cf5\" :question/difficulty :question.difficulty/hard] [:db/add \"97955500-8434-5f88-8942-e141fc073cf5\" :question/answer-fields \"ce5c2999-7798-568b-92d7-f217b8df4f9b\"] [:db/ensure \"97955500-8434-5f88-8942-e141fc073cf5\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"97955500-8434-5f88-8942-e141fc073cf5\"] [:db/add \"generator\" :question-generator/id #uuid \"6c857893-8561-5e61-bb52-232142c36c03\"] [:db/add \"generator\" :question-generator/script \"generators/45/45c1f4f2e4c5ddda586912c6e776c98a565b705098d610c4f974ab416fcf4959/generator.py\"] [:db/add 17592186064219 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186064219 :knowledge-point/validate]] \"assertions\" [[\"59b92c79-2953-5a73-9464-a9e75ff21136\" :answer/id #uuid \"59b92c79-2953-5a73-9464-a9e75ff21136\"] [\"59b92c79-2953-5a73-9464-a9e75ff21136\" :answer/type :answer.type/math] [\"59b92c79-2953-5a73-9464-a9e75ff21136\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"9e44a9fc-1ef8-569e-939a-e12792e55080\" :answer/id #uuid \"9e44a9fc-1ef8-569e-939a-e12792e55080\"] [\"9e44a9fc-1ef8-569e-939a-e12792e55080\" :answer/type :answer.type/math] [\"9e44a9fc-1ef8-569e-939a-e12792e55080\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e6701675-ef00-5467-867a-5476aefd2ee7\" :answer/id #uuid \"e6701675-ef00-5467-867a-5476aefd2ee7\"] [\"e6701675-ef00-5467-867a-5476aefd2ee7\" :answer/type :answer.type/math] [\"e6701675-ef00-5467-867a-5476aefd2ee7\" :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\"] [\"a023b23e-3d62-5ddd-9469-9ea07ca10534\" :answer/id #uuid \"a023b23e-3d62-5ddd-9469-9ea07ca10534\"] [\"a023b23e-3d62-5ddd-9469-9ea07ca10534\" :answer/type :answer.type/math] [\"a023b23e-3d62-5ddd-9469-9ea07ca10534\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\" :answer/id #uuid \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\"] [\"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\" :answer/type :answer.type/math] [\"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/id #uuid \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/key \"answer\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/type :answer-field.type/radio] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"59b92c79-2953-5a73-9464-a9e75ff21136\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"9e44a9fc-1ef8-569e-939a-e12792e55080\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"e6701675-ef00-5467-867a-5476aefd2ee7\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"a023b23e-3d62-5ddd-9469-9ea07ca10534\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/choices \"a8ed6929-af20-5ee3-94d2-e55eb1b7090a\"] [\"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\" :answer-field/correct \"e6701675-ef00-5467-867a-5476aefd2ee7\"] [\"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/id #uuid \"e71b6dde-1c12-54b1-92fd-83bba7e53414\"] [\"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/difficulty :question.difficulty/easy] [\"e71b6dde-1c12-54b1-92fd-83bba7e53414\" :question/answer-fields \"a54a34ef-96c2-5a3d-be8a-e34bdf1cc6ac\"] [17592186064219 :knowledge-point/questions \"e71b6dde-1c12-54b1-92fd-83bba7e53414\"] [\"589e6b4c-061f-566b-8eb2-af6b447262e0\" :answer/id #uuid \"589e6b4c-061f-566b-8eb2-af6b447262e0\"] [\"589e6b4c-061f-566b-8eb2-af6b447262e0\" :answer/type :answer.type/math] [\"589e6b4c-061f-566b-8eb2-af6b447262e0\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e7f083e6-4824-5617-b202-dc52880caff3\" :answer/id #uuid \"e7f083e6-4824-5617-b202-dc52880caff3\"] [\"e7f083e6-4824-5617-b202-dc52880caff3\" :answer/type :answer.type/math] [\"e7f083e6-4824-5617-b202-dc52880caff3\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\" :answer/id #uuid \"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\"] [\"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\" :answer/type :answer.type/math] [\"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\" :answer/id #uuid \"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\"] [\"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\" :answer/type :answer.type/math] [\"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"af14d712-ac43-5622-a9c7-2e43e4a3f42d\" :answer/id #uuid \"af14d712-ac43-5622-a9c7-2e43e4a3f42d\"] [\"af14d712-ac43-5622-a9c7-2e43e4a3f42d\" :answer/type :answer.type/math] [\"af14d712-ac43-5622-a9c7-2e43e4a3f42d\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/id #uuid \"aa633258-5a00-5129-a81e-a47342fe3075\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/key \"answer\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/type :answer-field.type/radio] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/choices \"589e6b4c-061f-566b-8eb2-af6b447262e0\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/choices \"e7f083e6-4824-5617-b202-dc52880caff3\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/choices \"dc60e3c6-f6c9-57ec-9309-1806ff30b3c9\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/choices \"4cb99639-aff0-5cfa-81ff-ce25b8b2847a\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/choices \"af14d712-ac43-5622-a9c7-2e43e4a3f42d\"] [\"aa633258-5a00-5129-a81e-a47342fe3075\" :answer-field/correct \"af14d712-ac43-5622-a9c7-2e43e4a3f42d\"] [\"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/id #uuid \"b0cc5f00-e442-5ada-8836-756efab9051f\"] [\"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/difficulty :question.difficulty/easy] [\"b0cc5f00-e442-5ada-8836-756efab9051f\" :question/answer-fields \"aa633258-5a00-5129-a81e-a47342fe3075\"] [17592186064219 :knowledge-point/questions \"b0cc5f00-e442-5ada-8836-756efab9051f\"] [\"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\" :answer/id #uuid \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\"] [\"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\" :answer/type :answer.type/math] [\"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"650426ac-8551-55ce-b37d-729a06c6a9fb\" :answer/id #uuid \"650426ac-8551-55ce-b37d-729a06c6a9fb\"] [\"650426ac-8551-55ce-b37d-729a06c6a9fb\" :answer/type :answer.type/math] [\"650426ac-8551-55ce-b37d-729a06c6a9fb\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\" :answer/id #uuid \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\"] [\"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\" :answer/type :answer.type/math] [\"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"269c2889-72b7-5b8e-979b-cd96fa4104fb\" :answer/id #uuid \"269c2889-72b7-5b8e-979b-cd96fa4104fb\"] [\"269c2889-72b7-5b8e-979b-cd96fa4104fb\" :answer/type :answer.type/math] [\"269c2889-72b7-5b8e-979b-cd96fa4104fb\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"76d4b423-515e-55e4-811a-88eba44b91b1\" :answer/id #uuid \"76d4b423-515e-55e4-811a-88eba44b91b1\"] [\"76d4b423-515e-55e4-811a-88eba44b91b1\" :answer/type :answer.type/math] [\"76d4b423-515e-55e4-811a-88eba44b91b1\" :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/id #uuid \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/key \"answer\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/type :answer-field.type/radio] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"f2bd59b3-1ec6-5d52-8101-00d9b2fc40ab\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"650426ac-8551-55ce-b37d-729a06c6a9fb\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"6de61f1c-c2ae-5aa3-a38b-75cfb28f5d39\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"269c2889-72b7-5b8e-979b-cd96fa4104fb\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/choices \"76d4b423-515e-55e4-811a-88eba44b91b1\"] [\"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\" :answer-field/correct \"650426ac-8551-55ce-b37d-729a06c6a9fb\"] [\"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/id #uuid \"16009ab5-a679-5c44-b2eb-746d0fc16291\"] [\"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/difficulty :question.difficulty/easy] [\"16009ab5-a679-5c44-b2eb-746d0fc16291\" :question/answer-fields \"a8af65d6-c47b-5cc5-8e69-5f48ddbf96cd\"] [17592186064219 :knowledge-point/questions \"16009ab5-a679-5c44-b2eb-746d0fc16291\"] [\"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\" :answer/id #uuid \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\"] [\"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\" :answer/type :answer.type/math] [\"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"561e9854-4b58-5e69-8555-dc68db74eff2\" :answer/id #uuid \"561e9854-4b58-5e69-8555-dc68db74eff2\"] [\"561e9854-4b58-5e69-8555-dc68db74eff2\" :answer/type :answer.type/math] [\"561e9854-4b58-5e69-8555-dc68db74eff2\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"5e155647-82db-522f-8149-0265ba86d1f4\" :answer/id #uuid \"5e155647-82db-522f-8149-0265ba86d1f4\"] [\"5e155647-82db-522f-8149-0265ba86d1f4\" :answer/type :answer.type/math] [\"5e155647-82db-522f-8149-0265ba86d1f4\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"354e5a1d-6239-596d-8864-9794bb81c6b2\" :answer/id #uuid \"354e5a1d-6239-596d-8864-9794bb81c6b2\"] [\"354e5a1d-6239-596d-8864-9794bb81c6b2\" :answer/type :answer.type/math] [\"354e5a1d-6239-596d-8864-9794bb81c6b2\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\" :answer/id #uuid \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\"] [\"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\" :answer/type :answer.type/math] [\"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/id #uuid \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/key \"answer\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/type :answer-field.type/radio] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"561e9854-4b58-5e69-8555-dc68db74eff2\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"5e155647-82db-522f-8149-0265ba86d1f4\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"354e5a1d-6239-596d-8864-9794bb81c6b2\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/choices \"da312fe9-d1d7-5185-923b-f7d5dcfacc1e\"] [\"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\" :answer-field/correct \"c0ebdc51-7cf3-56ca-bbfc-30acfd2cd4c4\"] [\"742eb033-7af1-5b39-afdc-28b695c36434\" :question/id #uuid \"742eb033-7af1-5b39-afdc-28b695c36434\"] [\"742eb033-7af1-5b39-afdc-28b695c36434\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"742eb033-7af1-5b39-afdc-28b695c36434\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"742eb033-7af1-5b39-afdc-28b695c36434\" :question/difficulty :question.difficulty/easy] [\"742eb033-7af1-5b39-afdc-28b695c36434\" :question/answer-fields \"cab4cb9a-b95d-50ac-b7e6-e02d0f8a4f10\"] [17592186064219 :knowledge-point/questions \"742eb033-7af1-5b39-afdc-28b695c36434\"] [\"b8456012-0c9a-5ed2-9800-9d64dd88e451\" :answer/id #uuid \"b8456012-0c9a-5ed2-9800-9d64dd88e451\"] [\"b8456012-0c9a-5ed2-9800-9d64dd88e451\" :answer/type :answer.type/math] [\"b8456012-0c9a-5ed2-9800-9d64dd88e451\" :answer/value \"- \\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"03572d80-e12b-53dc-a298-597fae2c389c\" :answer/id #uuid \"03572d80-e12b-53dc-a298-597fae2c389c\"] [\"03572d80-e12b-53dc-a298-597fae2c389c\" :answer/type :answer.type/math] [\"03572d80-e12b-53dc-a298-597fae2c389c\" :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"06d15fad-b91d-538d-8776-aa0171a60866\" :answer/id #uuid \"06d15fad-b91d-538d-8776-aa0171a60866\"] [\"06d15fad-b91d-538d-8776-aa0171a60866\" :answer/type :answer.type/math] [\"06d15fad-b91d-538d-8776-aa0171a60866\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c5d976d2-91cd-5267-a006-4262ea01d269\" :answer/id #uuid \"c5d976d2-91cd-5267-a006-4262ea01d269\"] [\"c5d976d2-91cd-5267-a006-4262ea01d269\" :answer/type :answer.type/math] [\"c5d976d2-91cd-5267-a006-4262ea01d269\" :answer/value \"\\\\frac{1}{15}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"074cde7a-f303-517c-9737-d49937610f37\" :answer/id #uuid \"074cde7a-f303-517c-9737-d49937610f37\"] [\"074cde7a-f303-517c-9737-d49937610f37\" :answer/type :answer.type/math] [\"074cde7a-f303-517c-9737-d49937610f37\" :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/id #uuid \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/key \"answer\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/type :answer-field.type/radio] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"b8456012-0c9a-5ed2-9800-9d64dd88e451\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"03572d80-e12b-53dc-a298-597fae2c389c\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"06d15fad-b91d-538d-8776-aa0171a60866\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"c5d976d2-91cd-5267-a006-4262ea01d269\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/choices \"074cde7a-f303-517c-9737-d49937610f37\"] [\"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\" :answer-field/correct \"03572d80-e12b-53dc-a298-597fae2c389c\"] [\"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/id #uuid \"ffc217a5-b1b2-51be-9f8a-39195f4970de\"] [\"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/difficulty :question.difficulty/easy] [\"ffc217a5-b1b2-51be-9f8a-39195f4970de\" :question/answer-fields \"0ddd1bc8-8e8a-59e9-817a-0158e0db1652\"] [17592186064219 :knowledge-point/questions \"ffc217a5-b1b2-51be-9f8a-39195f4970de\"] [\"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\" :answer/id #uuid \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\"] [\"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\" :answer/type :answer.type/math] [\"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\" :answer/value \"\\\\frac{12}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\" :answer/id #uuid \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\"] [\"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\" :answer/type :answer.type/math] [\"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\" :answer/value \"- \\\\frac{9}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ab68c3cd-e916-5326-9e3c-826758ed9380\" :answer/id #uuid \"ab68c3cd-e916-5326-9e3c-826758ed9380\"] [\"ab68c3cd-e916-5326-9e3c-826758ed9380\" :answer/type :answer.type/math] [\"ab68c3cd-e916-5326-9e3c-826758ed9380\" :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\" :answer/id #uuid \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\"] [\"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\" :answer/type :answer.type/math] [\"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\" :answer/value \"\\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\" :answer/id #uuid \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\"] [\"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\" :answer/type :answer.type/math] [\"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/id #uuid \"5b600c66-96d7-5ed6-8a86-07c8240bde90\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/key \"answer\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/type :answer-field.type/radio] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"c99c5a1f-5f1b-5b5b-89f8-ed4623469310\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"edefa6b9-fcf4-53e4-ae9b-54fce19fa1f2\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"ab68c3cd-e916-5326-9e3c-826758ed9380\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"d0562ee8-52ac-5f1c-a9a6-4023dd43bf5c\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/choices \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\"] [\"5b600c66-96d7-5ed6-8a86-07c8240bde90\" :answer-field/correct \"085916fc-1f5a-54fe-9dde-6dbe8cf969a7\"] [\"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/id #uuid \"326877fc-3e06-5e0f-b995-2979b1ac80f1\"] [\"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/difficulty :question.difficulty/easy] [\"326877fc-3e06-5e0f-b995-2979b1ac80f1\" :question/answer-fields \"5b600c66-96d7-5ed6-8a86-07c8240bde90\"] [17592186064219 :knowledge-point/questions \"326877fc-3e06-5e0f-b995-2979b1ac80f1\"] [\"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\" :answer/id #uuid \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\"] [\"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\" :answer/type :answer.type/math] [\"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ae5cc8dc-7890-5b47-99fe-591cfcb30377\" :answer/id #uuid \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\"] [\"ae5cc8dc-7890-5b47-99fe-591cfcb30377\" :answer/type :answer.type/math] [\"ae5cc8dc-7890-5b47-99fe-591cfcb30377\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d7149571-0bdc-5032-80f8-1ff25d70960c\" :answer/id #uuid \"d7149571-0bdc-5032-80f8-1ff25d70960c\"] [\"d7149571-0bdc-5032-80f8-1ff25d70960c\" :answer/type :answer.type/math] [\"d7149571-0bdc-5032-80f8-1ff25d70960c\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"1fca9c08-3365-5833-9024-465f8d9ad0b5\" :answer/id #uuid \"1fca9c08-3365-5833-9024-465f8d9ad0b5\"] [\"1fca9c08-3365-5833-9024-465f8d9ad0b5\" :answer/type :answer.type/math] [\"1fca9c08-3365-5833-9024-465f8d9ad0b5\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c5191998-230b-522a-8fc6-3b49c5b0a12d\" :answer/id #uuid \"c5191998-230b-522a-8fc6-3b49c5b0a12d\"] [\"c5191998-230b-522a-8fc6-3b49c5b0a12d\" :answer/type :answer.type/math] [\"c5191998-230b-522a-8fc6-3b49c5b0a12d\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/id #uuid \"0a24272e-22c8-5464-990e-f2ad65525a53\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/key \"answer\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/type :answer-field.type/radio] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"ae5cc8dc-7890-5b47-99fe-591cfcb30377\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"d7149571-0bdc-5032-80f8-1ff25d70960c\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"1fca9c08-3365-5833-9024-465f8d9ad0b5\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/choices \"c5191998-230b-522a-8fc6-3b49c5b0a12d\"] [\"0a24272e-22c8-5464-990e-f2ad65525a53\" :answer-field/correct \"d6aa1618-f73a-5a42-b3d6-fcba96a4753c\"] [\"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/id #uuid \"56046fbb-ce1f-55ee-91ec-49b9c175761d\"] [\"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/difficulty :question.difficulty/easy] [\"56046fbb-ce1f-55ee-91ec-49b9c175761d\" :question/answer-fields \"0a24272e-22c8-5464-990e-f2ad65525a53\"] [17592186064219 :knowledge-point/questions \"56046fbb-ce1f-55ee-91ec-49b9c175761d\"] [\"3300feb1-71d9-55c9-ae23-496ab14ad212\" :answer/id #uuid \"3300feb1-71d9-55c9-ae23-496ab14ad212\"] [\"3300feb1-71d9-55c9-ae23-496ab14ad212\" :answer/type :answer.type/math] [\"3300feb1-71d9-55c9-ae23-496ab14ad212\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"f713ea60-0699-5812-8465-53b23b5ce654\" :answer/id #uuid \"f713ea60-0699-5812-8465-53b23b5ce654\"] [\"f713ea60-0699-5812-8465-53b23b5ce654\" :answer/type :answer.type/math] [\"f713ea60-0699-5812-8465-53b23b5ce654\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"41b22fb4-5986-5108-9468-4d9a520d5fd6\" :answer/id #uuid \"41b22fb4-5986-5108-9468-4d9a520d5fd6\"] [\"41b22fb4-5986-5108-9468-4d9a520d5fd6\" :answer/type :answer.type/math] [\"41b22fb4-5986-5108-9468-4d9a520d5fd6\" :answer/value \"- \\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\" :answer/id #uuid \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\"] [\"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\" :answer/type :answer.type/math] [\"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\" :answer/id #uuid \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\"] [\"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\" :answer/type :answer.type/math] [\"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\" :answer/value \"\\\\frac{3}{16}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/id #uuid \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/key \"answer\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/type :answer-field.type/radio] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"3300feb1-71d9-55c9-ae23-496ab14ad212\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"f713ea60-0699-5812-8465-53b23b5ce654\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"41b22fb4-5986-5108-9468-4d9a520d5fd6\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"fe8d5958-6c41-50b0-a38a-06ddfac5eee7\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/choices \"0d6fd1a1-f470-5d2a-8d5f-6422b07caf2a\"] [\"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\" :answer-field/correct \"f713ea60-0699-5812-8465-53b23b5ce654\"] [\"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/id #uuid \"be980eab-200a-5d87-8dad-ba24bca2cf9f\"] [\"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\"] [\"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/difficulty :question.difficulty/easy] [\"be980eab-200a-5d87-8dad-ba24bca2cf9f\" :question/answer-fields \"8b03a8da-3194-5dc8-8c1e-a9acbe73fd73\"] [17592186064219 :knowledge-point/questions \"be980eab-200a-5d87-8dad-ba24bca2cf9f\"] [\"3acc0448-fd2a-5247-b1e9-1a752ed090ff\" :answer/id #uuid \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\"] [\"3acc0448-fd2a-5247-b1e9-1a752ed090ff\" :answer/type :answer.type/math] [\"3acc0448-fd2a-5247-b1e9-1a752ed090ff\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"87fa5563-f417-5d51-8a3d-a5842c43bb8c\" :answer/id #uuid \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\"] [\"87fa5563-f417-5d51-8a3d-a5842c43bb8c\" :answer/type :answer.type/math] [\"87fa5563-f417-5d51-8a3d-a5842c43bb8c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"f5413108-bf64-5157-9550-88b263f9602b\" :answer/id #uuid \"f5413108-bf64-5157-9550-88b263f9602b\"] [\"f5413108-bf64-5157-9550-88b263f9602b\" :answer/type :answer.type/math] [\"f5413108-bf64-5157-9550-88b263f9602b\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"8549c6b1-f338-576d-8685-9bcd787ee1f2\" :answer/id #uuid \"8549c6b1-f338-576d-8685-9bcd787ee1f2\"] [\"8549c6b1-f338-576d-8685-9bcd787ee1f2\" :answer/type :answer.type/math] [\"8549c6b1-f338-576d-8685-9bcd787ee1f2\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\" :answer/id #uuid \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\"] [\"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\" :answer/type :answer.type/math] [\"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/id #uuid \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/key \"answer\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/type :answer-field.type/radio] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"87fa5563-f417-5d51-8a3d-a5842c43bb8c\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"f5413108-bf64-5157-9550-88b263f9602b\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"8549c6b1-f338-576d-8685-9bcd787ee1f2\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/choices \"f33c2287-60e1-5faa-9c8b-0f8f3ee907d8\"] [\"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\" :answer-field/correct \"3acc0448-fd2a-5247-b1e9-1a752ed090ff\"] [\"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/id #uuid \"c468e5fa-6518-52c9-a916-9de209e84e3a\"] [\"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 16=16\\\\left(1+(\\\\frac{x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{16}\\\\cdot 4=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/difficulty :question.difficulty/moderate] [\"c468e5fa-6518-52c9-a916-9de209e84e3a\" :question/answer-fields \"d13cd7b7-42b0-5d2e-b3d1-075e1f26da27\"] [17592186064219 :knowledge-point/questions \"c468e5fa-6518-52c9-a916-9de209e84e3a\"] [\"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\" :answer/id #uuid \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\"] [\"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\" :answer/type :answer.type/math] [\"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"72abfe11-1ac4-594b-bfca-5781f2d86621\" :answer/id #uuid \"72abfe11-1ac4-594b-bfca-5781f2d86621\"] [\"72abfe11-1ac4-594b-bfca-5781f2d86621\" :answer/type :answer.type/math] [\"72abfe11-1ac4-594b-bfca-5781f2d86621\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"2907bc60-6e8a-56b5-857d-03327fa2c2e6\" :answer/id #uuid \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\"] [\"2907bc60-6e8a-56b5-857d-03327fa2c2e6\" :answer/type :answer.type/math] [\"2907bc60-6e8a-56b5-857d-03327fa2c2e6\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"bde6f376-c854-5b67-93e8-19d710f17e43\" :answer/id #uuid \"bde6f376-c854-5b67-93e8-19d710f17e43\"] [\"bde6f376-c854-5b67-93e8-19d710f17e43\" :answer/type :answer.type/math] [\"bde6f376-c854-5b67-93e8-19d710f17e43\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"56fd3fae-8f97-53c2-a77f-fd0ee915e481\" :answer/id #uuid \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\"] [\"56fd3fae-8f97-53c2-a77f-fd0ee915e481\" :answer/type :answer.type/math] [\"56fd3fae-8f97-53c2-a77f-fd0ee915e481\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{10} \\\\right)}\\\\right)+C\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/id #uuid \"fa055404-8fc2-54a3-bb66-b71c838e17ea\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/key \"answer\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/type :answer-field.type/radio] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"2098c3eb-7c54-5dd1-85e5-8accd1cb5227\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"72abfe11-1ac4-594b-bfca-5781f2d86621\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"bde6f376-c854-5b67-93e8-19d710f17e43\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/choices \"56fd3fae-8f97-53c2-a77f-fd0ee915e481\"] [\"fa055404-8fc2-54a3-bb66-b71c838e17ea\" :answer-field/correct \"2907bc60-6e8a-56b5-857d-03327fa2c2e6\"] [\"66af0e53-591d-587e-aee6-693863873082\" :question/id #uuid \"66af0e53-591d-587e-aee6-693863873082\"] [\"66af0e53-591d-587e-aee6-693863873082\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"66af0e53-591d-587e-aee6-693863873082\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 25=25\\\\left(1+(\\\\frac{x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{25}\\\\cdot 5=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"66af0e53-591d-587e-aee6-693863873082\" :question/difficulty :question.difficulty/moderate] [\"66af0e53-591d-587e-aee6-693863873082\" :question/answer-fields \"fa055404-8fc2-54a3-bb66-b71c838e17ea\"] [17592186064219 :knowledge-point/questions \"66af0e53-591d-587e-aee6-693863873082\"] [\"e5dc4260-37b8-5d44-9a14-3814a3e50d32\" :answer/id #uuid \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\"] [\"e5dc4260-37b8-5d44-9a14-3814a3e50d32\" :answer/type :answer.type/math] [\"e5dc4260-37b8-5d44-9a14-3814a3e50d32\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"469ae50d-f195-54eb-8f7d-56878e62c271\" :answer/id #uuid \"469ae50d-f195-54eb-8f7d-56878e62c271\"] [\"469ae50d-f195-54eb-8f7d-56878e62c271\" :answer/type :answer.type/math] [\"469ae50d-f195-54eb-8f7d-56878e62c271\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\" :answer/id #uuid \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\"] [\"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\" :answer/type :answer.type/math] [\"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\" :answer/id #uuid \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\"] [\"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\" :answer/type :answer.type/math] [\"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\" :answer/value \"3\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"d0ab10b2-cc80-53b1-959d-1ac1491a0268\" :answer/id #uuid \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\"] [\"d0ab10b2-cc80-53b1-959d-1ac1491a0268\" :answer/type :answer.type/math] [\"d0ab10b2-cc80-53b1-959d-1ac1491a0268\" :answer/value \"3\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/id #uuid \"ced10082-f000-5a52-9d26-469ef3fe713a\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/key \"answer\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/type :answer-field.type/radio] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"469ae50d-f195-54eb-8f7d-56878e62c271\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"9dfbe32a-ffae-56fe-9a3f-8ec11302a8d1\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"8fbb18ae-a571-5ebb-b89d-a8a8e7f28b5c\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/choices \"d0ab10b2-cc80-53b1-959d-1ac1491a0268\"] [\"ced10082-f000-5a52-9d26-469ef3fe713a\" :answer-field/correct \"e5dc4260-37b8-5d44-9a14-3814a3e50d32\"] [\"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/id #uuid \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\"] [\"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 4=4\\\\left(1+(\\\\frac{x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 2=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/difficulty :question.difficulty/moderate] [\"f4645490-4961-5a1e-9ae3-88ccb9bec06b\" :question/answer-fields \"ced10082-f000-5a52-9d26-469ef3fe713a\"] [17592186064219 :knowledge-point/questions \"f4645490-4961-5a1e-9ae3-88ccb9bec06b\"] [\"e48839bb-a08d-553d-a166-44a9e81381cb\" :answer/id #uuid \"e48839bb-a08d-553d-a166-44a9e81381cb\"] [\"e48839bb-a08d-553d-a166-44a9e81381cb\" :answer/type :answer.type/math] [\"e48839bb-a08d-553d-a166-44a9e81381cb\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"e37eec64-6d81-5a37-805b-2334fba3f964\" :answer/id #uuid \"e37eec64-6d81-5a37-805b-2334fba3f964\"] [\"e37eec64-6d81-5a37-805b-2334fba3f964\" :answer/type :answer.type/math] [\"e37eec64-6d81-5a37-805b-2334fba3f964\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"85ced902-7e5b-5863-b87a-db75f313d705\" :answer/id #uuid \"85ced902-7e5b-5863-b87a-db75f313d705\"] [\"85ced902-7e5b-5863-b87a-db75f313d705\" :answer/type :answer.type/math] [\"85ced902-7e5b-5863-b87a-db75f313d705\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\" :answer/id #uuid \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\"] [\"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\" :answer/type :answer.type/math] [\"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{6} \\\\right)}\\\\right)+C\"] [\"c7a805ae-96a0-53e2-9028-7c4a8600043e\" :answer/id #uuid \"c7a805ae-96a0-53e2-9028-7c4a8600043e\"] [\"c7a805ae-96a0-53e2-9028-7c4a8600043e\" :answer/type :answer.type/math] [\"c7a805ae-96a0-53e2-9028-7c4a8600043e\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/id #uuid \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/key \"answer\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/type :answer-field.type/radio] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"e48839bb-a08d-553d-a166-44a9e81381cb\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"e37eec64-6d81-5a37-805b-2334fba3f964\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"85ced902-7e5b-5863-b87a-db75f313d705\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"1fd2f30a-8b8d-52fd-9d5c-60c2fca885cb\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/choices \"c7a805ae-96a0-53e2-9028-7c4a8600043e\"] [\"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\" :answer-field/correct \"e48839bb-a08d-553d-a166-44a9e81381cb\"] [\"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/id #uuid \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\"] [\"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 9=9\\\\left(1+(\\\\frac{x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{9}\\\\cdot 3=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/difficulty :question.difficulty/moderate] [\"11b24a5c-cc96-5edb-a57b-0143caf1ec14\" :question/answer-fields \"d56a72bc-d1a2-5c31-89aa-ed31f2db491b\"] [17592186064219 :knowledge-point/questions \"11b24a5c-cc96-5edb-a57b-0143caf1ec14\"] [\"52cfadef-31f4-5a14-a352-b40bcaffdc83\" :answer/id #uuid \"52cfadef-31f4-5a14-a352-b40bcaffdc83\"] [\"52cfadef-31f4-5a14-a352-b40bcaffdc83\" :answer/type :answer.type/math] [\"52cfadef-31f4-5a14-a352-b40bcaffdc83\" :answer/value \"\\\\arctan{\\\\left(x \\\\right)}+C\"] [\"db39502e-7b4f-5ae9-b5bf-8832191681b0\" :answer/id #uuid \"db39502e-7b4f-5ae9-b5bf-8832191681b0\"] [\"db39502e-7b4f-5ae9-b5bf-8832191681b0\" :answer/type :answer.type/math] [\"db39502e-7b4f-5ae9-b5bf-8832191681b0\" :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\" :answer/id #uuid \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\"] [\"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\" :answer/type :answer.type/math] [\"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}+C\"] [\"c34cc510-f9d8-5086-957d-0d30f18e98ef\" :answer/id #uuid \"c34cc510-f9d8-5086-957d-0d30f18e98ef\"] [\"c34cc510-f9d8-5086-957d-0d30f18e98ef\" :answer/type :answer.type/math] [\"c34cc510-f9d8-5086-957d-0d30f18e98ef\" :answer/value \"-1\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"d274c212-cef8-5498-b381-aa043f0a7eb2\" :answer/id #uuid \"d274c212-cef8-5498-b381-aa043f0a7eb2\"] [\"d274c212-cef8-5498-b381-aa043f0a7eb2\" :answer/type :answer.type/math] [\"d274c212-cef8-5498-b381-aa043f0a7eb2\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{8} \\\\right)}+C\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/id #uuid \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/key \"answer\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/type :answer-field.type/radio] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"52cfadef-31f4-5a14-a352-b40bcaffdc83\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"db39502e-7b4f-5ae9-b5bf-8832191681b0\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"c34cc510-f9d8-5086-957d-0d30f18e98ef\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/choices \"d274c212-cef8-5498-b381-aa043f0a7eb2\"] [\"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\" :answer-field/correct \"67d6a5f3-5ed1-5d2c-a467-7fb1c0e47048\"] [\"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/id #uuid \"5afb6ae5-f525-5383-88b8-04b2b2268858\"] [\"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 16=16\\\\left(1+(\\\\frac{x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot 4=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}+C.\\n$$\"] [\"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/difficulty :question.difficulty/moderate] [\"5afb6ae5-f525-5383-88b8-04b2b2268858\" :question/answer-fields \"1f39e523-df8e-5d75-b6fd-6a9dfa6183c2\"] [17592186064219 :knowledge-point/questions \"5afb6ae5-f525-5383-88b8-04b2b2268858\"] [\"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\" :answer/id #uuid \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\"] [\"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\" :answer/type :answer.type/math] [\"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\" :answer/value \"\\\\arctan{\\\\left(x \\\\right)}+C\"] [\"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\" :answer/id #uuid \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\"] [\"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\" :answer/type :answer.type/math] [\"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\" :answer/value \"-2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"bf23db17-4d09-5ccd-ac54-bb36c8f51305\" :answer/id #uuid \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\"] [\"bf23db17-4d09-5ccd-ac54-bb36c8f51305\" :answer/type :answer.type/math] [\"bf23db17-4d09-5ccd-ac54-bb36c8f51305\" :answer/value \"2\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"0479fbb0-008e-5c66-b5ca-648b9ad05085\" :answer/id #uuid \"0479fbb0-008e-5c66-b5ca-648b9ad05085\"] [\"0479fbb0-008e-5c66-b5ca-648b9ad05085\" :answer/type :answer.type/math] [\"0479fbb0-008e-5c66-b5ca-648b9ad05085\" :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"eaf17396-fbf6-5bb6-a992-37c813dd39e2\" :answer/id #uuid \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\"] [\"eaf17396-fbf6-5bb6-a992-37c813dd39e2\" :answer/type :answer.type/math] [\"eaf17396-fbf6-5bb6-a992-37c813dd39e2\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}+C\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/id #uuid \"93c8398c-67a6-5380-93e3-b4970fc200c4\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/key \"answer\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/type :answer-field.type/radio] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"aed18aad-4d47-5f7f-989e-a8aade8ecc0e\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"a9d95a2e-542e-596e-a08a-bcf7fcb05e2d\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"bf23db17-4d09-5ccd-ac54-bb36c8f51305\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"0479fbb0-008e-5c66-b5ca-648b9ad05085\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/choices \"eaf17396-fbf6-5bb6-a992-37c813dd39e2\"] [\"93c8398c-67a6-5380-93e3-b4970fc200c4\" :answer-field/correct \"0479fbb0-008e-5c66-b5ca-648b9ad05085\"] [\"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/id #uuid \"374f0a15-44e2-560c-961a-a0cc2456807a\"] [\"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 4=4\\\\left(1+(\\\\frac{x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 2=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/difficulty :question.difficulty/moderate] [\"374f0a15-44e2-560c-961a-a0cc2456807a\" :question/answer-fields \"93c8398c-67a6-5380-93e3-b4970fc200c4\"] [17592186064219 :knowledge-point/questions \"374f0a15-44e2-560c-961a-a0cc2456807a\"] [\"24115da5-fa1e-518d-97a3-073655adcc17\" :answer/id #uuid \"24115da5-fa1e-518d-97a3-073655adcc17\"] [\"24115da5-fa1e-518d-97a3-073655adcc17\" :answer/type :answer.type/math] [\"24115da5-fa1e-518d-97a3-073655adcc17\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"9cda0f1f-186d-5025-9244-be8198899caf\" :answer/id #uuid \"9cda0f1f-186d-5025-9244-be8198899caf\"] [\"9cda0f1f-186d-5025-9244-be8198899caf\" :answer/type :answer.type/math] [\"9cda0f1f-186d-5025-9244-be8198899caf\" :answer/value \"\\\\frac{6}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"10dd5c4c-5769-5607-9cee-b0c0674d7673\" :answer/id #uuid \"10dd5c4c-5769-5607-9cee-b0c0674d7673\"] [\"10dd5c4c-5769-5607-9cee-b0c0674d7673\" :answer/type :answer.type/math] [\"10dd5c4c-5769-5607-9cee-b0c0674d7673\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\" :answer/id #uuid \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\"] [\"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\" :answer/type :answer.type/math] [\"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"f14e87dd-502f-56c4-9be5-9cd60a273a1e\" :answer/id #uuid \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\"] [\"f14e87dd-502f-56c4-9be5-9cd60a273a1e\" :answer/type :answer.type/math] [\"f14e87dd-502f-56c4-9be5-9cd60a273a1e\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{10} \\\\right)}\\\\right)+C\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/id #uuid \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/key \"answer\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/type :answer-field.type/radio] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"24115da5-fa1e-518d-97a3-073655adcc17\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"9cda0f1f-186d-5025-9244-be8198899caf\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"10dd5c4c-5769-5607-9cee-b0c0674d7673\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"7e0f4fa4-41e5-58dd-b9cb-afeb34781278\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/choices \"f14e87dd-502f-56c4-9be5-9cd60a273a1e\"] [\"fc6bdcd4-f3bd-51e3-8051-1406462241a8\" :answer-field/correct \"24115da5-fa1e-518d-97a3-073655adcc17\"] [\"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/id #uuid \"a54a704d-0604-583c-9a79-ad7771ee3a92\"] [\"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 25=25\\\\left(1+(\\\\frac{x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{25}\\\\cdot 5=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/difficulty :question.difficulty/moderate] [\"a54a704d-0604-583c-9a79-ad7771ee3a92\" :question/answer-fields \"fc6bdcd4-f3bd-51e3-8051-1406462241a8\"] [17592186064219 :knowledge-point/questions \"a54a704d-0604-583c-9a79-ad7771ee3a92\"] [\"2a34f19d-e1e0-5037-b8b6-8b91237539bc\" :answer/id #uuid \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\"] [\"2a34f19d-e1e0-5037-b8b6-8b91237539bc\" :answer/type :answer.type/math] [\"2a34f19d-e1e0-5037-b8b6-8b91237539bc\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"10652b96-1c98-5d6a-b88e-5615c48f9f59\" :answer/id #uuid \"10652b96-1c98-5d6a-b88e-5615c48f9f59\"] [\"10652b96-1c98-5d6a-b88e-5615c48f9f59\" :answer/type :answer.type/math] [\"10652b96-1c98-5d6a-b88e-5615c48f9f59\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"8f6e7476-7343-5864-a233-ad2f35780322\" :answer/id #uuid \"8f6e7476-7343-5864-a233-ad2f35780322\"] [\"8f6e7476-7343-5864-a233-ad2f35780322\" :answer/type :answer.type/math] [\"8f6e7476-7343-5864-a233-ad2f35780322\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"c32d8665-4c48-545b-aaa4-e8bfca5a1657\" :answer/id #uuid \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\"] [\"c32d8665-4c48-545b-aaa4-e8bfca5a1657\" :answer/type :answer.type/math] [\"c32d8665-4c48-545b-aaa4-e8bfca5a1657\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"27dcbd12-e676-5752-9e1b-97852310195b\" :answer/id #uuid \"27dcbd12-e676-5752-9e1b-97852310195b\"] [\"27dcbd12-e676-5752-9e1b-97852310195b\" :answer/type :answer.type/math] [\"27dcbd12-e676-5752-9e1b-97852310195b\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/id #uuid \"5529bbbd-486c-5333-b3f0-c2b0966c6906\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/key \"answer\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/type :answer-field.type/radio] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"2a34f19d-e1e0-5037-b8b6-8b91237539bc\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"10652b96-1c98-5d6a-b88e-5615c48f9f59\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"8f6e7476-7343-5864-a233-ad2f35780322\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/choices \"27dcbd12-e676-5752-9e1b-97852310195b\"] [\"5529bbbd-486c-5333-b3f0-c2b0966c6906\" :answer-field/correct \"c32d8665-4c48-545b-aaa4-e8bfca5a1657\"] [\"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/id #uuid \"04273c07-61db-5c6f-ab5e-ed62a376e378\"] [\"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 9=9\\\\left(1+(\\\\frac{x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{9}\\\\cdot 3=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/difficulty :question.difficulty/moderate] [\"04273c07-61db-5c6f-ab5e-ed62a376e378\" :question/answer-fields \"5529bbbd-486c-5333-b3f0-c2b0966c6906\"] [17592186064219 :knowledge-point/questions \"04273c07-61db-5c6f-ab5e-ed62a376e378\"] [\"cf7f9bd4-3000-552f-86c9-f8421db9c068\" :answer/id #uuid \"cf7f9bd4-3000-552f-86c9-f8421db9c068\"] [\"cf7f9bd4-3000-552f-86c9-f8421db9c068\" :answer/type :answer.type/math] [\"cf7f9bd4-3000-552f-86c9-f8421db9c068\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"2872334f-71fb-5bb6-bfd5-1d2597cdc370\" :answer/id #uuid \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\"] [\"2872334f-71fb-5bb6-bfd5-1d2597cdc370\" :answer/type :answer.type/math] [\"2872334f-71fb-5bb6-bfd5-1d2597cdc370\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"3abb76b7-63b0-5fae-8d7e-b570c1717f59\" :answer/id #uuid \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\"] [\"3abb76b7-63b0-5fae-8d7e-b570c1717f59\" :answer/type :answer.type/math] [\"3abb76b7-63b0-5fae-8d7e-b570c1717f59\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"042db0ac-edc0-5704-a363-301b14e7f963\" :answer/id #uuid \"042db0ac-edc0-5704-a363-301b14e7f963\"] [\"042db0ac-edc0-5704-a363-301b14e7f963\" :answer/type :answer.type/math] [\"042db0ac-edc0-5704-a363-301b14e7f963\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"5d089b64-7bf0-5842-aa42-4775b3d32980\" :answer/id #uuid \"5d089b64-7bf0-5842-aa42-4775b3d32980\"] [\"5d089b64-7bf0-5842-aa42-4775b3d32980\" :answer/type :answer.type/math] [\"5d089b64-7bf0-5842-aa42-4775b3d32980\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/id #uuid \"314b4635-a9da-5e01-98b0-acd17aa10beb\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/key \"answer\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/type :answer-field.type/radio] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"cf7f9bd4-3000-552f-86c9-f8421db9c068\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"2872334f-71fb-5bb6-bfd5-1d2597cdc370\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"3abb76b7-63b0-5fae-8d7e-b570c1717f59\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"042db0ac-edc0-5704-a363-301b14e7f963\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/choices \"5d089b64-7bf0-5842-aa42-4775b3d32980\"] [\"314b4635-a9da-5e01-98b0-acd17aa10beb\" :answer-field/correct \"5d089b64-7bf0-5842-aa42-4775b3d32980\"] [\"0ea27e05-c360-5117-af78-66005d892e0d\" :question/id #uuid \"0ea27e05-c360-5117-af78-66005d892e0d\"] [\"0ea27e05-c360-5117-af78-66005d892e0d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"0ea27e05-c360-5117-af78-66005d892e0d\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 4=4\\\\left(1+(2 x)^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [\"0ea27e05-c360-5117-af78-66005d892e0d\" :question/difficulty :question.difficulty/hard] [\"0ea27e05-c360-5117-af78-66005d892e0d\" :question/answer-fields \"314b4635-a9da-5e01-98b0-acd17aa10beb\"] [17592186064219 :knowledge-point/questions \"0ea27e05-c360-5117-af78-66005d892e0d\"] [\"c014dc67-2f00-5dd4-9396-1c264e8d0b09\" :answer/id #uuid \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\"] [\"c014dc67-2f00-5dd4-9396-1c264e8d0b09\" :answer/type :answer.type/math] [\"c014dc67-2f00-5dd4-9396-1c264e8d0b09\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"df0856bd-8f13-5d07-a9d8-b38c175f921f\" :answer/id #uuid \"df0856bd-8f13-5d07-a9d8-b38c175f921f\"] [\"df0856bd-8f13-5d07-a9d8-b38c175f921f\" :answer/type :answer.type/math] [\"df0856bd-8f13-5d07-a9d8-b38c175f921f\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\" :answer/id #uuid \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\"] [\"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\" :answer/type :answer.type/math] [\"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"30870f00-6eb4-5005-b39d-bd2b371b5e39\" :answer/id #uuid \"30870f00-6eb4-5005-b39d-bd2b371b5e39\"] [\"30870f00-6eb4-5005-b39d-bd2b371b5e39\" :answer/type :answer.type/math] [\"30870f00-6eb4-5005-b39d-bd2b371b5e39\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"64ffc532-3c93-53b6-bea2-30e3d2dc9611\" :answer/id #uuid \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\"] [\"64ffc532-3c93-53b6-bea2-30e3d2dc9611\" :answer/type :answer.type/math] [\"64ffc532-3c93-53b6-bea2-30e3d2dc9611\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/id #uuid \"d98c8949-a406-5f3d-8656-75cc22299dc2\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/key \"answer\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/type :answer-field.type/radio] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"c014dc67-2f00-5dd4-9396-1c264e8d0b09\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"df0856bd-8f13-5d07-a9d8-b38c175f921f\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"30870f00-6eb4-5005-b39d-bd2b371b5e39\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/choices \"64ffc532-3c93-53b6-bea2-30e3d2dc9611\"] [\"d98c8949-a406-5f3d-8656-75cc22299dc2\" :answer-field/correct \"d62d7bce-ab62-5ca7-9265-39a31e28ea4a\"] [\"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/id #uuid \"3ce826a6-cc72-5c44-a14b-a18a76123544\"] [\"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 9=9\\\\left(1+(\\\\frac{4 x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/difficulty :question.difficulty/hard] [\"3ce826a6-cc72-5c44-a14b-a18a76123544\" :question/answer-fields \"d98c8949-a406-5f3d-8656-75cc22299dc2\"] [17592186064219 :knowledge-point/questions \"3ce826a6-cc72-5c44-a14b-a18a76123544\"] [\"03f43d10-6363-5daa-9f57-0c9f9794129e\" :answer/id #uuid \"03f43d10-6363-5daa-9f57-0c9f9794129e\"] [\"03f43d10-6363-5daa-9f57-0c9f9794129e\" :answer/type :answer.type/math] [\"03f43d10-6363-5daa-9f57-0c9f9794129e\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"cc2db800-0639-56aa-b9a0-6f25568c950d\" :answer/id #uuid \"cc2db800-0639-56aa-b9a0-6f25568c950d\"] [\"cc2db800-0639-56aa-b9a0-6f25568c950d\" :answer/type :answer.type/math] [\"cc2db800-0639-56aa-b9a0-6f25568c950d\" :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"f963c707-7e03-581b-acd5-29a0406ef440\" :answer/id #uuid \"f963c707-7e03-581b-acd5-29a0406ef440\"] [\"f963c707-7e03-581b-acd5-29a0406ef440\" :answer/type :answer.type/math] [\"f963c707-7e03-581b-acd5-29a0406ef440\" :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\"] [\"0c323f7a-6d7a-5fee-b0d2-4bb795193606\" :answer/id #uuid \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\"] [\"0c323f7a-6d7a-5fee-b0d2-4bb795193606\" :answer/type :answer.type/math] [\"0c323f7a-6d7a-5fee-b0d2-4bb795193606\" :answer/value \"\\\\frac{3}{40}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\" :answer/id #uuid \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\"] [\"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\" :answer/type :answer.type/math] [\"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\" :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/id #uuid \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/key \"answer\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/type :answer-field.type/radio] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"03f43d10-6363-5daa-9f57-0c9f9794129e\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"cc2db800-0639-56aa-b9a0-6f25568c950d\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"f963c707-7e03-581b-acd5-29a0406ef440\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"0c323f7a-6d7a-5fee-b0d2-4bb795193606\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/choices \"ea62bf9d-a1b9-586b-a30f-ff13d1f327cc\"] [\"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\" :answer-field/correct \"cc2db800-0639-56aa-b9a0-6f25568c950d\"] [\"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/id #uuid \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\"] [\"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 25=25\\\\left(1+(\\\\frac{4 x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{25}\\\\cdot \\\\frac{5}{4}=\\\\frac{3}{20}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{20}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{20}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/difficulty :question.difficulty/hard] [\"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\" :question/answer-fields \"b35235ad-dc60-54fd-b6c8-a9f265e7bb94\"] [17592186064219 :knowledge-point/questions \"3fcdfdfc-02d3-5240-acf8-6d2463fd38f7\"] [\"e67e530c-d28e-54f4-8748-5520d3b08f18\" :answer/id #uuid \"e67e530c-d28e-54f4-8748-5520d3b08f18\"] [\"e67e530c-d28e-54f4-8748-5520d3b08f18\" :answer/type :answer.type/math] [\"e67e530c-d28e-54f4-8748-5520d3b08f18\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"28ade528-30f0-5553-8e66-9ea3e481b310\" :answer/id #uuid \"28ade528-30f0-5553-8e66-9ea3e481b310\"] [\"28ade528-30f0-5553-8e66-9ea3e481b310\" :answer/type :answer.type/math] [\"28ade528-30f0-5553-8e66-9ea3e481b310\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"41ceda2b-bb0e-5f91-8644-6e27b958d398\" :answer/id #uuid \"41ceda2b-bb0e-5f91-8644-6e27b958d398\"] [\"41ceda2b-bb0e-5f91-8644-6e27b958d398\" :answer/type :answer.type/math] [\"41ceda2b-bb0e-5f91-8644-6e27b958d398\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"e072f18c-bb82-5789-9baf-fe35ff4f8a13\" :answer/id #uuid \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\"] [\"e072f18c-bb82-5789-9baf-fe35ff4f8a13\" :answer/type :answer.type/math] [\"e072f18c-bb82-5789-9baf-fe35ff4f8a13\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"9244c46c-ed63-5ef5-b25d-ca51e142b429\" :answer/id #uuid \"9244c46c-ed63-5ef5-b25d-ca51e142b429\"] [\"9244c46c-ed63-5ef5-b25d-ca51e142b429\" :answer/type :answer.type/math] [\"9244c46c-ed63-5ef5-b25d-ca51e142b429\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/id #uuid \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/key \"answer\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/type :answer-field.type/radio] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"e67e530c-d28e-54f4-8748-5520d3b08f18\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"28ade528-30f0-5553-8e66-9ea3e481b310\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"41ceda2b-bb0e-5f91-8644-6e27b958d398\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"e072f18c-bb82-5789-9baf-fe35ff4f8a13\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/choices \"9244c46c-ed63-5ef5-b25d-ca51e142b429\"] [\"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\" :answer-field/correct \"e67e530c-d28e-54f4-8748-5520d3b08f18\"] [\"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/id #uuid \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\"] [\"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 4=4\\\\left(1+(\\\\frac{3 x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/difficulty :question.difficulty/hard] [\"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\" :question/answer-fields \"0faf9fd4-a04e-5eb0-991f-2443a2f7f221\"] [17592186064219 :knowledge-point/questions \"0659bd20-fc90-57d9-99e5-b2b3ea9b8df3\"] [\"c7d761cd-609b-56d3-8734-276b3937faee\" :answer/id #uuid \"c7d761cd-609b-56d3-8734-276b3937faee\"] [\"c7d761cd-609b-56d3-8734-276b3937faee\" :answer/type :answer.type/math] [\"c7d761cd-609b-56d3-8734-276b3937faee\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"febb7a28-a313-51d0-9039-8dd29f8fddf6\" :answer/id #uuid \"febb7a28-a313-51d0-9039-8dd29f8fddf6\"] [\"febb7a28-a313-51d0-9039-8dd29f8fddf6\" :answer/type :answer.type/math] [\"febb7a28-a313-51d0-9039-8dd29f8fddf6\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"7fb6aeca-b8aa-5033-bed7-a306faa6358a\" :answer/id #uuid \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\"] [\"7fb6aeca-b8aa-5033-bed7-a306faa6358a\" :answer/type :answer.type/math] [\"7fb6aeca-b8aa-5033-bed7-a306faa6358a\" :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\" :answer/id #uuid \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\"] [\"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\" :answer/type :answer.type/math] [\"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\" :answer/value \"\\\\frac{1}{16}\\\\left(\\\\arctan{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\" :answer/id #uuid \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\"] [\"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\" :answer/type :answer.type/math] [\"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/id #uuid \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/key \"answer\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/type :answer-field.type/radio] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"c7d761cd-609b-56d3-8734-276b3937faee\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"febb7a28-a313-51d0-9039-8dd29f8fddf6\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"7fb6aeca-b8aa-5033-bed7-a306faa6358a\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"5c819ffa-b4ca-5028-89d8-5056ac6d6a0a\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/choices \"5d6d2aaf-afbf-5feb-aae3-8d3784daf1a1\"] [\"8baff00d-4a0c-5ed9-8a90-c55e91e07248\" :answer-field/correct \"febb7a28-a313-51d0-9039-8dd29f8fddf6\"] [\"a308e958-b4cd-5526-a857-73e4e190217a\" :question/id #uuid \"a308e958-b4cd-5526-a857-73e4e190217a\"] [\"a308e958-b4cd-5526-a857-73e4e190217a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"a308e958-b4cd-5526-a857-73e4e190217a\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 4=4\\\\left(1+(2 x)^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{8}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [\"a308e958-b4cd-5526-a857-73e4e190217a\" :question/difficulty :question.difficulty/hard] [\"a308e958-b4cd-5526-a857-73e4e190217a\" :question/answer-fields \"8baff00d-4a0c-5ed9-8a90-c55e91e07248\"] [17592186064219 :knowledge-point/questions \"a308e958-b4cd-5526-a857-73e4e190217a\"] [\"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\" :answer/id #uuid \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\"] [\"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\" :answer/type :answer.type/math] [\"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\" :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"44e12667-4a90-5b47-b510-7f195553a03c\" :answer/id #uuid \"44e12667-4a90-5b47-b510-7f195553a03c\"] [\"44e12667-4a90-5b47-b510-7f195553a03c\" :answer/type :answer.type/math] [\"44e12667-4a90-5b47-b510-7f195553a03c\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [\"65cbc094-856a-5af4-9be8-c42bab87c75b\" :answer/id #uuid \"65cbc094-856a-5af4-9be8-c42bab87c75b\"] [\"65cbc094-856a-5af4-9be8-c42bab87c75b\" :answer/type :answer.type/math] [\"65cbc094-856a-5af4-9be8-c42bab87c75b\" :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [\"fda0219e-c2e9-5cc1-8e39-a1df867b186f\" :answer/id #uuid \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\"] [\"fda0219e-c2e9-5cc1-8e39-a1df867b186f\" :answer/type :answer.type/math] [\"fda0219e-c2e9-5cc1-8e39-a1df867b186f\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [\"67fc66f2-b3f7-5044-8211-2ffab2146d50\" :answer/id #uuid \"67fc66f2-b3f7-5044-8211-2ffab2146d50\"] [\"67fc66f2-b3f7-5044-8211-2ffab2146d50\" :answer/type :answer.type/math] [\"67fc66f2-b3f7-5044-8211-2ffab2146d50\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/id #uuid \"3e4e95df-caf6-5361-91ae-90efa9338dbb\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/key \"answer\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/type :answer-field.type/radio] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"6c25e1c8-7bd0-588e-b45e-19f7bfbdeaa7\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"44e12667-4a90-5b47-b510-7f195553a03c\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"65cbc094-856a-5af4-9be8-c42bab87c75b\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/choices \"67fc66f2-b3f7-5044-8211-2ffab2146d50\"] [\"3e4e95df-caf6-5361-91ae-90efa9338dbb\" :answer-field/correct \"fda0219e-c2e9-5cc1-8e39-a1df867b186f\"] [\"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/id #uuid \"e0709212-5bdd-58e3-9994-272e5bc71470\"] [\"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/worked-solution \"Let $u=\\\\frac{3 x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 16=16\\\\left(1+(\\\\frac{3 x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{4}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{8}\\\\cdot \\\\frac{4}{3}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/difficulty :question.difficulty/hard] [\"e0709212-5bdd-58e3-9994-272e5bc71470\" :question/answer-fields \"3e4e95df-caf6-5361-91ae-90efa9338dbb\"] [17592186064219 :knowledge-point/questions \"e0709212-5bdd-58e3-9994-272e5bc71470\"] [\"83cf66b3-5ed6-50d4-9274-88b625dd6f55\" :answer/id #uuid \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\"] [\"83cf66b3-5ed6-50d4-9274-88b625dd6f55\" :answer/type :answer.type/math] [\"83cf66b3-5ed6-50d4-9274-88b625dd6f55\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"5dae9b1b-02f7-56df-bda5-d9430830fa85\" :answer/id #uuid \"5dae9b1b-02f7-56df-bda5-d9430830fa85\"] [\"5dae9b1b-02f7-56df-bda5-d9430830fa85\" :answer/type :answer.type/math] [\"5dae9b1b-02f7-56df-bda5-d9430830fa85\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"dc439a9b-733f-5aaa-99a4-c9ce25be3862\" :answer/id #uuid \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\"] [\"dc439a9b-733f-5aaa-99a4-c9ce25be3862\" :answer/type :answer.type/math] [\"dc439a9b-733f-5aaa-99a4-c9ce25be3862\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\" :answer/id #uuid \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\"] [\"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\" :answer/type :answer.type/math] [\"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [\"a8505aa0-8b17-525d-86c4-e4b86969a8d5\" :answer/id #uuid \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\"] [\"a8505aa0-8b17-525d-86c4-e4b86969a8d5\" :answer/type :answer.type/math] [\"a8505aa0-8b17-525d-86c4-e4b86969a8d5\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/id #uuid \"ded46afd-2fa4-5c07-9b94-69916e04b49e\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/key \"answer\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/type :answer-field.type/radio] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"83cf66b3-5ed6-50d4-9274-88b625dd6f55\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"5dae9b1b-02f7-56df-bda5-d9430830fa85\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"dc439a9b-733f-5aaa-99a4-c9ce25be3862\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"636e0cfc-2db5-5e5c-ac32-a6d3e46f6a0a\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/choices \"a8505aa0-8b17-525d-86c4-e4b86969a8d5\"] [\"ded46afd-2fa4-5c07-9b94-69916e04b49e\" :answer-field/correct \"5dae9b1b-02f7-56df-bda5-d9430830fa85\"] [\"55bd73ee-d454-5588-844c-b8bda488729c\" :question/id #uuid \"55bd73ee-d454-5588-844c-b8bda488729c\"] [\"55bd73ee-d454-5588-844c-b8bda488729c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"55bd73ee-d454-5588-844c-b8bda488729c\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 4=4\\\\left(1+(\\\\frac{3 x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"55bd73ee-d454-5588-844c-b8bda488729c\" :question/difficulty :question.difficulty/hard] [\"55bd73ee-d454-5588-844c-b8bda488729c\" :question/answer-fields \"ded46afd-2fa4-5c07-9b94-69916e04b49e\"] [17592186064219 :knowledge-point/questions \"55bd73ee-d454-5588-844c-b8bda488729c\"] [\"2f2778a5-dce7-50fd-9922-4bf37496ceb6\" :answer/id #uuid \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\"] [\"2f2778a5-dce7-50fd-9922-4bf37496ceb6\" :answer/type :answer.type/math] [\"2f2778a5-dce7-50fd-9922-4bf37496ceb6\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"3f03ac11-7a82-5c09-9079-684083d15035\" :answer/id #uuid \"3f03ac11-7a82-5c09-9079-684083d15035\"] [\"3f03ac11-7a82-5c09-9079-684083d15035\" :answer/type :answer.type/math] [\"3f03ac11-7a82-5c09-9079-684083d15035\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"56d7db6e-245f-55e1-8d82-21fa80d199ba\" :answer/id #uuid \"56d7db6e-245f-55e1-8d82-21fa80d199ba\"] [\"56d7db6e-245f-55e1-8d82-21fa80d199ba\" :answer/type :answer.type/math] [\"56d7db6e-245f-55e1-8d82-21fa80d199ba\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"77593972-8883-57cf-8bf9-41d5bf9a74ec\" :answer/id #uuid \"77593972-8883-57cf-8bf9-41d5bf9a74ec\"] [\"77593972-8883-57cf-8bf9-41d5bf9a74ec\" :answer/type :answer.type/math] [\"77593972-8883-57cf-8bf9-41d5bf9a74ec\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"62b9cde0-3fb7-5728-9982-049c9e377fdc\" :answer/id #uuid \"62b9cde0-3fb7-5728-9982-049c9e377fdc\"] [\"62b9cde0-3fb7-5728-9982-049c9e377fdc\" :answer/type :answer.type/math] [\"62b9cde0-3fb7-5728-9982-049c9e377fdc\" :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/id #uuid \"ce5c2999-7798-568b-92d7-f217b8df4f9b\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/key \"answer\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/type :answer-field.type/radio] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"2f2778a5-dce7-50fd-9922-4bf37496ceb6\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"3f03ac11-7a82-5c09-9079-684083d15035\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"56d7db6e-245f-55e1-8d82-21fa80d199ba\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"77593972-8883-57cf-8bf9-41d5bf9a74ec\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/choices \"62b9cde0-3fb7-5728-9982-049c9e377fdc\"] [\"ce5c2999-7798-568b-92d7-f217b8df4f9b\" :answer-field/correct \"77593972-8883-57cf-8bf9-41d5bf9a74ec\"] [\"97955500-8434-5f88-8942-e141fc073cf5\" :question/id #uuid \"97955500-8434-5f88-8942-e141fc073cf5\"] [\"97955500-8434-5f88-8942-e141fc073cf5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{4 x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"97955500-8434-5f88-8942-e141fc073cf5\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n4 x^{2} + 9=9\\\\left(1+(\\\\frac{2 x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{9}\\\\cdot \\\\frac{3}{2}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{4 x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"97955500-8434-5f88-8942-e141fc073cf5\" :question/difficulty :question.difficulty/hard] [\"97955500-8434-5f88-8942-e141fc073cf5\" :question/answer-fields \"ce5c2999-7798-568b-92d7-f217b8df4f9b\"] [17592186064219 :knowledge-point/questions \"97955500-8434-5f88-8942-e141fc073cf5\"] [\"generator\" :question-generator/id #uuid \"6c857893-8561-5e61-bb52-232142c36c03\"] [\"generator\" :question-generator/script \"generators/45/45c1f4f2e4c5ddda586912c6e776c98a565b705098d610c4f974ab416fcf4959/generator.py\"] [17592186064219 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186064219 :knowledge-point/question-generator 17592186678936]]}",
