  "before_edn": "{:db/id 17592186064219 :knowledge-point/canonical-example {:db/id 17592186064091 :question/id #uuid \"3e89a278-54ab-59a6-adb6-38f43c0fbe9a\" :question/math-academy-id \"e-471\" :question/problem \"Calculate the integral  $$\\n\\\\displaystyle{\\\\int \\\\dfrac{3}{2 + 50x^2} \\\\, \\\\textrm{d}x }.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\dfrac{3}{2 + 50x^2} \\\\, \\\\textrm{d}x = \\\\int \\\\dfrac{3}{2(1 + 25x^2)} = \\\\dfrac 3 2 \\\\int \\\\dfrac{1}{1+25x^2}\\\\,\\\\textrm d x.\\n$$\\n\\nThis integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^2}\\\\textrm{d}u =\\\\arctan u +C.\\n$$\\n\\nThe only difference is that instead of $u^2$ as the variable, we have $25x^2 = (5x)^2.$\\n\\nSo, let's substitute $u=5x.$ Differentiating, we get\\n\\n$$\\n\\\\dfrac{\\\\textrm{d}u}{\\\\textrm{d}x}=5\\\\quad\\\\Longrightarrow\\\\quad \\\\dfrac 1 5\\\\,\\\\textrm d u = \\\\textrm d x.\\n$$\\n\\nWe can now write the integral in terms of $u,$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{3}{2+50{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{3}{2}\\\\int \\\\frac{1}{1+25{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{3}{2}\\\\int \\\\frac{1}{1+(5x)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{3}{2}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\,\\\\,\\\\cdot \\\\frac{1}{5}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{10}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{10}\\\\cdot \\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{3}{10}\\\\operatorname{arctan}⁡5x+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"227abe29-6e31-5afd-b0ca-3b8ed7d8c287\" :knowledge-point/question-generator {:db/id 17592186678936 :question-generator/id #uuid \"f245c96b-ecc2-5a45-9594-8ada989eacd5\" :question-generator/script \"generators/d1/d1642e2df2b045d44b6dc7b41337b8d60b8b1a67e6b026841240d7cc66819e23/generator.py\"} :knowledge-point/questions [{:db/id 17592186064874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3b3f469d-d785-54c0-8500-e4f4c541c311\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\operatorname{arctan}⁡(3x)+C\" :db/id 17592186330478} {:answer/id #uuid \"44fe7e54-fa6e-59d5-8a26-f4f36bb5501f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(3x)}{3}+C\" :db/id 17592186330572} {:answer/id #uuid \"848d8e79-5f9b-50c9-a7a2-c023a98ccebf\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arcsin}⁡(3x)+C\" :db/id 17592186331128} {:answer/id #uuid \"be85cd80-7bd6-5b67-8980-2e785a3889ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡(3x)+C\" :db/id 17592186331634} {:answer/id #uuid \"fb4584df-c775-5f4a-a59c-6d2f35a59525\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(3x)}{3}+C\" :db/id 17592186332157}] :answer-field/correct {:answer/id #uuid \"be85cd80-7bd6-5b67-8980-2e785a3889ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡(3x)+C\" :db/id 17592186331634} :answer-field/id #uuid \"3e5cefbe-1794-5312-8f1f-f28eb36bbc55\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332307}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"5ff7c3e1-6732-5fb3-bcd2-7ed1aeab0712\" :question/math-academy-id \"q-49540\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{6}{1+9{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $9{x}^{2}=(3x)^{2}.$\\n\\nSo. let's substitute $u=3x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{3}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{6}{1+9{x}^{2}}\\\\,\\\\text{d}x & =6\\\\int \\\\frac{1}{1+(3x)^{2}}\\\\text{d}x \\\\\\\\  & =6\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{3}\\\\text{d}u) \\\\\\\\  & =2\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u \\\\\\\\  & =2\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =2\\\\operatorname{arctan}⁡(3x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186064876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0edb1c73-87ee-58c2-a730-43e7f693d596\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{9}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\" :db/id 17592186330078} {:answer/id #uuid \"26074d64-e780-5986-be16-fa82ceeb0164\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{3}\\\\right)+C\" :db/id 17592186330281} {:answer/id #uuid \"3ec2d31d-3894-565f-9b91-3bc180c6d541\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{3}\\\\right)+C\" :db/id 17592186330506} {:answer/id #uuid \"581c2751-ecf3-5021-a41f-a828e408e3cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\" :db/id 17592186330735} {:answer/id #uuid \"59dbc6dd-87a6-5e93-99fe-8c88f23299aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\" :db/id 17592186330753}] :answer-field/correct {:answer/id #uuid \"3ec2d31d-3894-565f-9b91-3bc180c6d541\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{3}\\\\right)+C\" :db/id 17592186330506} :answer-field/id #uuid \"ef0aa3c5-1f7e-5feb-b2ae-0f439aa2181d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332622}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ea76ea1f-1600-5c9d-b198-b9fb197580ab\" :question/math-academy-id \"q-49548\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{9+{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's rewrite our integral as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{9+{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{9\\\\cdot (1+{x}^{2}/9)}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+{x}^{2}/9}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+(x/3)^{2}}\\\\,\\\\text{d}x\\\\end{aligned}\\n$$\\n\\nThis integral resembles the basic integral for inverse tangent\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\\\left(\\\\frac{x}{3}\\\\right)}^{2}.$\\n\\nSo, let's substitute $u=\\\\frac{x}{3}.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{3}\\\\,⟹\\\\,\\\\text{d}x=3\\\\,\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{9+{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+(x/3)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (3\\\\,\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{3}\\\\int \\\\frac{\\\\text{d}u}{1+{u}^{2}} \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{3}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"10b46bc9-97cb-5bce-918b-8b92646973b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{6}\\\\right)+C\" :db/id 17592186247570} {:answer/id #uuid \"1b1e75f2-49eb-5a5d-9cee-c6ed60930c7d\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡(6x)+C\" :db/id 17592186247668} {:answer/id #uuid \"3de5bd43-5bd8-5d01-8064-06ac8fdb185f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡(x)+C\" :db/id 17592186247970} {:answer/id #uuid \"c07e9314-0212-563d-818b-d17717a081be\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{6}\\\\right)+C\" :db/id 17592186249137} {:answer/id #uuid \"c7202512-7634-5743-96f4-8104d0655a3a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡(6x)+C\" :db/id 17592186249191}] :answer-field/correct {:answer/id #uuid \"c7202512-7634-5743-96f4-8104d0655a3a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡(6x)+C\" :db/id 17592186249191} :answer-field/id #uuid \"c3dd683c-9379-5f34-9cdb-095ffd9b03f3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186250005}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c6b1e250-deab-5051-9d86-76fdce192937\" :question/math-academy-id \"q-114033\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{3}{1+36{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $36{x}^{2}=(6x)^{2}.$\\n\\nSo, let's substitute $u=6x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=6\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{6}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{3}{1+36{x}^{2}}\\\\,\\\\text{d}x & =3\\\\int \\\\frac{1}{1+(6x)^{2}}\\\\text{d}x \\\\\\\\  & =3\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{6}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{arctan}⁡(6x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0539dfbd-c13f-5910-83ae-6847aafc2ffa\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{arctan}⁡(\\\\sqrt{5}x)+C\" :db/id 17592186247464} {:answer/id #uuid \"0e2ff00e-68bf-502d-98ea-81a253a73c45\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{5}}{5}\\\\operatorname{arctan}⁡(\\\\sqrt{5}x)+C\" :db/id 17592186247554} {:answer/id #uuid \"4cfc5510-a085-5eb9-b318-bbda8928e434\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{5}\\\\operatorname{arctan}⁡(\\\\sqrt{5}x)+C\" :db/id 17592186248113} {:answer/id #uuid \"5be141d4-f3ae-5dbe-a3ed-b73522cecff5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{5}}{5}\\\\operatorname{arctan}⁡(x)+C\" :db/id 17592186248256} {:answer/id #uuid \"b327e315-fd5b-5fed-a846-f91465502aee\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{5}}{5}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{5}\\\\right)+C\" :db/id 17592186249029}] :answer-field/correct {:answer/id #uuid \"0e2ff00e-68bf-502d-98ea-81a253a73c45\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{5}}{5}\\\\operatorname{arctan}⁡(\\\\sqrt{5}x)+C\" :db/id 17592186247554} :answer-field/id #uuid \"692c144a-767b-5856-8997-1c4aa1c3ede5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249853}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2983a03c-228c-5295-a88a-957cc5ef8213\" :question/math-academy-id \"q-114035\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{1+5{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $5{x}^{2}=(\\\\sqrt{5}x)^{2}.$\\n\\nThus, let's substitute $u=\\\\sqrt{5}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{5}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{5}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{1+5{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{1+(\\\\sqrt{5}x)^{2}}\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{\\\\sqrt{5}}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{\\\\sqrt{5}}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u \\\\\\\\  & =\\\\frac{\\\\sqrt{5}}{5}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{\\\\sqrt{5}}{5}\\\\operatorname{arctan}⁡(\\\\sqrt{5}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0a9072ff-4248-5c96-aa34-ca722a5750b4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}\\\\operatorname{arctan}⁡(x)+C\" :db/id 17592186247515} {:answer/id #uuid \"5c681104-b0e2-5a5b-8f09-f83ae1045726\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}\\\\operatorname{arctan}⁡(\\\\sqrt{3}x)+C\" :db/id 17592186248265} {:answer/id #uuid \"69b6f3a0-9094-584b-a375-09202334d54b\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{arctan}⁡(\\\\sqrt{3}x)+C\" :db/id 17592186248367} {:answer/id #uuid \"8be15631-a51f-557d-9b64-882be871c95f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{\\\\sqrt{3}x}{3}\\\\right)+C\" :db/id 17592186248677} {:answer/id #uuid \"ff4d3d45-5080-5430-90e3-c1923ab5f66b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}\\\\operatorname{arctan}⁡(\\\\sqrt{3}x)+C\" :db/id 17592186249659}] :answer-field/correct {:answer/id #uuid \"ff4d3d45-5080-5430-90e3-c1923ab5f66b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}\\\\operatorname{arctan}⁡(\\\\sqrt{3}x)+C\" :db/id 17592186249659} :answer-field/id #uuid \"f08c78cb-9c6d-566a-a639-9975746cefc1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186250089}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"ac34d6b4-de07-59e6-a640-adcba3a25634\" :question/math-academy-id \"q-114036\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{1+3{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $3{x}^{2}=(\\\\sqrt{3}x)^{2}.$\\n\\nSo, let's substitute $u=\\\\sqrt{3}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{3}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{3}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{1+3{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{1+(\\\\sqrt{3}x)^{2}}\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{\\\\sqrt{3}}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{\\\\sqrt{3}}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{3}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{3}\\\\operatorname{arctan}⁡(\\\\sqrt{3}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"253eba90-1471-5899-a022-f2a6a0dcc2f4\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{2}\\\\operatorname{arctan}⁡(\\\\sqrt{2}x)+C\" :db/id 17592186247751} {:answer/id #uuid \"5d35edcf-35aa-5569-a7e5-3873e6df59f4\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡(\\\\sqrt{2}x)+C\" :db/id 17592186248273} {:answer/id #uuid \"ae194557-e33c-5111-90ab-ccce8ece805c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\operatorname{arctan}⁡(\\\\sqrt{2}x)+C\" :db/id 17592186248979} {:answer/id #uuid \"e3d2ca92-2b60-5ab0-85fd-763ef78c1cc2\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{2}\\\\operatorname{arctan}⁡(2x)+C\" :db/id 17592186249431} {:answer/id #uuid \"f394bc85-f9c8-541e-bb77-70203902c090\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\operatorname{arctan}⁡(\\\\sqrt{2}x)+C\" :db/id 17592186249555}] :answer-field/correct {:answer/id #uuid \"253eba90-1471-5899-a022-f2a6a0dcc2f4\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{2}\\\\operatorname{arctan}⁡(\\\\sqrt{2}x)+C\" :db/id 17592186247751} :answer-field/id #uuid \"69de4702-78ad-579a-9c5d-8bfd3d6340aa\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249854}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c1b0abe8-8c03-503e-a61e-925a200b4441\" :question/math-academy-id \"q-114040\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{4}{1+2{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $2{x}^{2}=(\\\\sqrt{2}x)^{2}.$\\n\\nSo, let's substitute $u=\\\\sqrt{2}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{2}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{2}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{4}{1+2{x}^{2}}\\\\,\\\\text{d}x & =4\\\\int \\\\frac{1}{1+(\\\\sqrt{2}x)^{2}}\\\\text{d}x \\\\\\\\  & =4\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{\\\\sqrt{2}}\\\\text{d}u) \\\\\\\\  & =\\\\frac{4}{\\\\sqrt{2}}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u \\\\\\\\  & =\\\\frac{4\\\\sqrt{2}}{2}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =2\\\\sqrt{2}\\\\operatorname{arctan}⁡(\\\\sqrt{2}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"483c26c4-9591-5693-b37b-d4073beefda6\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡(4x)+C\" :db/id 17592186248071} {:answer/id #uuid \"bb8b07a0-116b-518d-9a1d-972a85844f64\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{4}\\\\right)+C\" :db/id 17592186249098} {:answer/id #uuid \"c32179fe-c467-592c-9f69-b60802a05b4e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{4}\\\\right)+C\" :db/id 17592186249159} {:answer/id #uuid \"d304c17e-5ea8-5a66-93d7-6a99599f2090\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{4}\\\\right)+C\" :db/id 17592186249297} {:answer/id #uuid \"fd94393a-c5bd-52f0-be8f-368ed42e2eb6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{4}\\\\right)+C\" :db/id 17592186249644}] :answer-field/correct {:answer/id #uuid \"d304c17e-5ea8-5a66-93d7-6a99599f2090\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{4}\\\\right)+C\" :db/id 17592186249297} :answer-field/id #uuid \"204c0449-cb8b-5901-a89b-496c8ed2dd4b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249729}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a9cca3e1-79d8-525d-a321-dda6d6f0fe18\" :question/math-academy-id \"q-114045\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{8}{16+{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's rewrite our integral as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{8}{16+{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{8}{16\\\\cdot (1+{x}^{2}/16)}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{1}{1+{x}^{2}/16}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{1}{1+(x/4)^{2}}\\\\,\\\\text{d}x\\\\end{aligned}\\n$$\\n\\nThis integral resembles the basic integral for inverse tangent\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\\\left(\\\\frac{x}{4}\\\\right)}^{2}.$\\n\\nSo, let's substitute $u=\\\\frac{x}{4}.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{4}\\\\,⟹\\\\,\\\\text{d}x=4\\\\,\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{8}{16+{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{1}{2}\\\\int \\\\frac{1}{1+(x/4)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (4\\\\,\\\\text{d}u) \\\\\\\\  & =2\\\\int \\\\frac{\\\\text{d}u}{1+{u}^{2}} \\\\\\\\  & =2\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =2\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{4}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"245b618d-7b28-597c-b19b-5c843eb6c7f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{9}\\\\operatorname{arctan}⁡(x)+C\" :db/id 17592186247741} {:answer/id #uuid \"52fe1c8c-100b-5622-9e05-9387df536621\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡(9x)+C\" :db/id 17592186248173} {:answer/id #uuid \"a0850bb9-1690-5ca5-b8a2-6fbde9a42a7c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{9}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\" :db/id 17592186248858} {:answer/id #uuid \"b7508ec8-5378-54d4-bd32-a71a1b47afaa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\" :db/id 17592186249065} {:answer/id #uuid \"bbaf321e-a0ba-506b-a6c1-81f09db011a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"9\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\" :db/id 17592186249099}] :answer-field/correct {:answer/id #uuid \"b7508ec8-5378-54d4-bd32-a71a1b47afaa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\" :db/id 17592186249065} :answer-field/id #uuid \"835d8e84-7024-5e35-bbe8-a87537867361\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249899}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4e7b39f3-407b-599d-a487-d698e967777b\" :question/math-academy-id \"q-114046\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{9}{81+{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's rewrite our integral as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{9}{81+{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{9}{81\\\\cdot (1+{x}^{2}/81)}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+{x}^{2}/81}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+(x/9)^{2}}\\\\,\\\\text{d}x\\\\end{aligned}\\n$$\\n\\nThis integral resembles the basic integral for inverse tangent\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\n The only difference is that instead of ${u}^{2}$ as the variable, we have ${\\\\left(\\\\frac{x}{9}\\\\right)}^{2}.$\\n\\nSo, let's substitute $u=\\\\frac{x}{9}.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{9}\\\\,⟹\\\\,\\\\text{d}x=9\\\\,\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{9}{81+{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+(x/9)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{9}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (9\\\\,\\\\text{d}u) \\\\\\\\  & =\\\\int \\\\frac{\\\\text{d}u}{1+{u}^{2}} \\\\\\\\  & =\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{9}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186290591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"486b0a70-7e05-52ff-8487-81ba071e0a3a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(4x)}{4}+C\" :db/id 17592186288533} {:answer/id #uuid \"69127801-3533-5a03-b74d-9ec2a87d6eb9\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\operatorname{arctan}⁡(4x)+C\" :db/id 17592186288771} {:answer/id #uuid \"e96eb19b-978a-5ee7-bb01-e9ab119611d8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(16x)}{16}+C\" :db/id 17592186289582} {:answer/id #uuid \"ef828203-a491-5804-b360-380890b2c51b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(4x)}{16}+C\" :db/id 17592186289611} {:answer/id #uuid \"f5a54489-77bd-54ff-ae37-733d7622bf54\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(8x)}{8}+C\" :db/id 17592186289652}] :answer-field/correct {:answer/id #uuid \"486b0a70-7e05-52ff-8487-81ba071e0a3a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(4x)}{4}+C\" :db/id 17592186288533} :answer-field/id #uuid \"5ebda31b-7ff5-5da1-8d90-6d8cb199795a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186289933}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"f3817a61-9f5a-501b-a646-24bc46868497\" :question/math-academy-id \"q-2504\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{1+16{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $16{x}^{2}=(4x)^{2}.$\\n\\nSo, let's substitute $u=4x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{4}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{1+16{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{1+(4x)^{2}}\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{4}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{4}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{\\\\operatorname{arctan}⁡(4x)}{4}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186290600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"15325872-4e2f-544f-9dec-000683e3691e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(x)}{25}+C\" :db/id 17592186288177} {:answer/id #uuid \"164243e9-717c-580d-9d74-331ac357f68c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(5x)}{5}+C\" :db/id 17592186288180} {:answer/id #uuid \"6b7d4913-276e-5926-8683-f107a4d1158c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(25x)}{25}+C\" :db/id 17592186288790} {:answer/id #uuid \"87403b08-b913-5b5b-af1b-47f906da3828\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(5x)}{5}+C\" :db/id 17592186288944} {:answer/id #uuid \"90b08433-72df-5a70-8a55-aec7b22f8981\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(25x)}{25}+C\" :db/id 17592186289001}] :answer-field/correct {:answer/id #uuid \"164243e9-717c-580d-9d74-331ac357f68c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(5x)}{5}+C\" :db/id 17592186288180} :answer-field/id #uuid \"589b96c3-feba-5f82-b690-a05fef9d4fc1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186289916}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"d025ad08-0459-5553-af22-02ed776a0b57\" :question/math-academy-id \"q-2507\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{1+25{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\\n\\nSo, let's substitute $u=5x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=5\\\\,⟹\\\\,\\\\frac{1}{5}\\\\,\\\\text{d}u=\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{1+25{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{1+(5x)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{1+{u}^{2}}\\\\,\\\\cdot (\\\\frac{1}{5}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{5}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{5}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{\\\\operatorname{arctan}⁡(5x)}{5}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"024f569b-84cc-57ef-8f4d-9dc8de0df792\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{2}\\\\right)+C\" :db/id 17592186329984} {:answer/id #uuid \"12e1d549-32b5-52ba-8653-965154243838\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{2}\\\\right)+C\" :db/id 17592186330111} {:answer/id #uuid \"3bd86b9e-f501-52cd-b1cc-9ff1facc3fb7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡x+C\" :db/id 17592186330482} {:answer/id #uuid \"6428015d-361f-5b50-9364-a1602259dd12\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡(2x)+C\" :db/id 17592186330841} {:answer/id #uuid \"fbaac824-d193-5f69-9c43-16185bc76ba0\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡(2x)+C\" :db/id 17592186332162}] :answer-field/correct {:answer/id #uuid \"024f569b-84cc-57ef-8f4d-9dc8de0df792\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{2}\\\\right)+C\" :db/id 17592186329984} :answer-field/id #uuid \"21cb126f-fb81-5a2d-8f46-32591eb308f3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332250}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"00f3edb2-19bb-54fa-b405-1ba68902442b\" :question/math-academy-id \"q-49505\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{4+{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's rewrite our integral as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{4+{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{4\\\\cdot (1+{x}^{2}/4)}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{1}{1+{x}^{2}/4}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{1}{1+(x/2)^{2}}\\\\,\\\\text{d}x\\\\end{aligned}\\n$$\\n\\nThis integral resembles the basic integral for inverse tangent\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\\\left(\\\\frac{x}{2}\\\\right)}^{2}.$ \\n\\nSo, let's substitute $u=\\\\frac{x}{2}.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{2}\\\\,⟹\\\\,\\\\text{d}x=2\\\\,\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{4+{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{1}{4}\\\\int \\\\frac{1}{1+(x/2)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (2\\\\,\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{\\\\text{d}u}{1+{u}^{2}} \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{2}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"22bf65d9-1368-5c83-bc06-2f787ae31aed\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{5}\\\\right)+C\" :db/id 17592186330249} {:answer/id #uuid \"b84605c3-6d64-59e4-a03f-63d799bb1439\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\operatorname{arcsin}⁡(5x)+C\" :db/id 17592186331577} {:answer/id #uuid \"c163d792-fcdb-58ce-be5c-05660a506b28\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\operatorname{arcsin}⁡\\\\left(\\\\frac{x}{5}\\\\right)+C\" :db/id 17592186331666} {:answer/id #uuid \"c187c878-5877-5b0a-ab41-952209abe59c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\operatorname{arctan}⁡(5x)+C\" :db/id 17592186331668} {:answer/id #uuid \"e20ac18c-ab7a-518f-8d37-1b59b1612d09\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{5}\\\\right)+C\" :db/id 17592186331949}] :answer-field/correct {:answer/id #uuid \"22bf65d9-1368-5c83-bc06-2f787ae31aed\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{5}\\\\right)+C\" :db/id 17592186330249} :answer-field/id #uuid \"4a6a8623-72fb-5f8a-9e38-396d560f8321\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332330}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"73d1e60d-39c3-527b-ad50-26d30b66cdba\" :question/math-academy-id \"q-49550\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{25+{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's rewrite our integral as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{25+{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{25\\\\cdot (1+{x}^{2}/25)}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{25}\\\\int \\\\frac{1}{1+{x}^{2}/25}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{25}\\\\int \\\\frac{1}{1+(x/5)^{2}}\\\\,\\\\text{d}x\\\\end{aligned}\\n$$\\n\\nThis integral resembles the basic integral for inverse tangent\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\\\left(\\\\frac{x}{5}\\\\right)}^{2}.$\\n\\nSo, let's substitute $u=\\\\frac{x}{5}.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{5}\\\\,⟹\\\\,\\\\text{d}x=5\\\\,\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{25+{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{1}{25}\\\\int \\\\frac{1}{1+(x/5)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{25}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (5\\\\,\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{5}\\\\int \\\\frac{\\\\text{d}u}{1+{u}^{2}} \\\\\\\\  & =\\\\frac{1}{5}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{1}{5}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{5}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0218ebee-f46b-52a3-af27-002bd2e16fdd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡\\\\left(\\\\frac{x}{8}\\\\right)}{4}+C\" :db/id 17592186329977} {:answer/id #uuid \"2d0a098d-fa78-5f98-bfe7-2e76cd1fe7ba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{4}\\\\right)}{4}+C\" :db/id 17592186330349} {:answer/id #uuid \"3e1c856a-d31e-5281-a2a6-f20cbee86a40\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(8x)}{8}+C\" :db/id 17592186330499} {:answer/id #uuid \"6da04d85-0964-58d1-bd80-e9e62694fa8d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{8}\\\\right)}{4}+C\" :db/id 17592186330930} {:answer/id #uuid \"e57ddc07-4a02-59ea-b4b1-dd526c6b3d82\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{8}\\\\right)}{8}+C\" :db/id 17592186331971}] :answer-field/correct {:answer/id #uuid \"6da04d85-0964-58d1-bd80-e9e62694fa8d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{8}\\\\right)}{4}+C\" :db/id 17592186330930} :answer-field/id #uuid \"d448c3a1-6bd6-56fc-a1f7-e15ec5601f57\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332573}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e79ee700-e1a2-5377-9595-991fdfcefa49\" :question/math-academy-id \"q-49551\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{2}{64+{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's rewrite our integral as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{2}{64+{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{2}{64\\\\cdot (1+{x}^{2}/64)}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{2}{64}\\\\int \\\\frac{1}{1+{x}^{2}/64}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{32}\\\\int \\\\frac{1}{1+(x/8)^{2}}\\\\,\\\\text{d}x\\\\end{aligned}\\n$$\\n\\n \\n\\nThis integral resembles the basic integral for inverse tangent\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\\\left(\\\\frac{x}{8}\\\\right)}^{2}.$\\n\\nSo, let's substitute $u=\\\\frac{x}{8}.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{8}\\\\,⟹\\\\,\\\\text{d}x=8\\\\,\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{2}{64+{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{1}{32}\\\\int \\\\frac{1}{1+(x/8)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{32}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (8\\\\,\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{\\\\text{d}u}{1+{u}^{2}} \\\\\\\\  & =\\\\frac{1}{4}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{1}{4}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{8}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186342065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"26b8753a-d28b-5470-8f73-93050c06c08a\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡(6x)+C\" :db/id 17592186339465} {:answer/id #uuid \"6b85678e-6139-5d36-af17-0b94102122cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{6}\\\\right)+C\" :db/id 17592186340081} {:answer/id #uuid \"a2fa1f1a-bb6b-520e-bae1-d824104a01c9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{6}\\\\right)+C\" :db/id 17592186340605} {:answer/id #uuid \"ab8d3b36-56c7-55f4-abd1-ab704350e9ec\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡(6x)+C\" :db/id 17592186340693} {:answer/id #uuid \"fb91a9c0-e0c4-502a-ae2f-5e69dfe1bc66\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{6}\\\\right)+C\" :db/id 17592186341351}] :answer-field/correct {:answer/id #uuid \"6b85678e-6139-5d36-af17-0b94102122cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{6}\\\\right)+C\" :db/id 17592186340081} :answer-field/id #uuid \"1611e707-c42e-5085-bbf5-4935f8f58d88\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341418}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"93802a48-b09b-52e0-870e-185ec5edc9c1\" :question/math-academy-id \"q-73714\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{3}{36+{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's rewrite our integral as follows:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{3}{36+{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{3}{36\\\\cdot (1+{x}^{2}/36)}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{12}\\\\int \\\\frac{1}{1+{x}^{2}/36}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{12}\\\\int \\\\frac{1}{1+(x/6)^{2}}\\\\,\\\\text{d}x\\\\end{aligned}\\n$$\\n\\nThis integral resembles the basic integral for inverse tangent\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\\\left(\\\\frac{x}{6}\\\\right)}^{2}.$\\n\\nSo, let's substitute $u=\\\\frac{x}{6}.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{6}\\\\,⟹\\\\,\\\\text{d}x=6\\\\,\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{3}{36+{x}^{2}}\\\\,\\\\text{d}x & =\\\\frac{1}{12}\\\\int \\\\frac{1}{1+(x/6)^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\frac{1}{12}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (6\\\\,\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{\\\\text{d}u}{1+{u}^{2}} \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{arctan}⁡\\\\left(\\\\frac{x}{6}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186368716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"bc0eaaa6-3c74-5955-ab7a-40c09fa2a964\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(2x)}{5}+C\" :db/id 17592186368718} {:answer/id #uuid \"6b672eef-fdca-5016-828c-47d6af33c13e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(2x)}{5}+C\" :db/id 17592186368719} {:answer/id #uuid \"ce69df23-6261-537f-bc31-f5d9599f5543\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{arctan}⁡x+C\" :db/id 17592186368720} {:answer/id #uuid \"b7c8552a-dd1c-59c6-825b-7bdb5b09d5cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{arcsin}⁡(2x)+C\" :db/id 17592186368721} {:answer/id #uuid \"250a9a15-df5f-58ee-9c74-d26e624f24b9\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{arctan}⁡(2x)+C\" :db/id 17592186368722}] :answer-field/correct {:answer/id #uuid \"250a9a15-df5f-58ee-9c74-d26e624f24b9\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{arctan}⁡(2x)+C\" :db/id 17592186368722} :answer-field/id #uuid \"4b4164c5-58af-56ae-8f11-f8cd84fa0fda\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186368717}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c6decd4b-7a1d-5fb8-8bf2-963b2f6581d8\" :question/math-academy-id \"q-73713\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{10}{1+4{x}^{2}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $4{x}^{2}=(2x)^{2}.$\\n\\nSo. let's substitute $u=2x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{2}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{10}{1+4{x}^{2}}\\\\,\\\\text{d}x & =10\\\\int \\\\frac{1}{1+(2x)^{2}}\\\\text{d}x \\\\\\\\  & =10\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{2}\\\\text{d}u) \\\\\\\\  & =5\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u \\\\\\\\  & =5\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =5\\\\operatorname{arctan}⁡(2x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186428006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3b31a011-34d6-54fb-97d3-f5fd61f6b537\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{6}\\\\operatorname{arctan}⁡(\\\\sqrt{6}x)+C\" :db/id 17592186427995} {:answer/id #uuid \"68c27e18-cd86-5136-97ff-930ab97daa47\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\operatorname{arctan}⁡(\\\\sqrt{6}x)+C\" :db/id 17592186427996} {:answer/id #uuid \"74bba607-5459-5096-9775-251242509188\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{6}\\\\operatorname{arctan}⁡(\\\\sqrt{6}x)+C\" :db/id 17592186427997} {:answer/id #uuid \"bbcb8ff0-bcc8-5c73-8990-398286767616\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{6}\\\\operatorname{arctan}⁡(6x)+C\" :db/id 17592186428001} {:answer/id #uuid \"ff2fa96a-ca7c-53d2-b91f-002c52d75021\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{6}\\\\operatorname{arctan}⁡(x)+C\" :db/id 17592186428003}] :answer-field/correct {:answer/id #uuid \"3b31a011-34d6-54fb-97d3-f5fd61f6b537\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{6}\\\\operatorname{arctan}⁡(\\\\sqrt{6}x)+C\" :db/id 17592186427995} :answer-field/id #uuid \"a430fc00-ecdb-5355-9c79-98aa358084c4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186428004}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"276f25e8-0fe6-5cab-8eeb-f55147c6c339\" :question/math-academy-id \"q-114039\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{1+6{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"This integral resembles the basic integral for inverse tangent,\\n\\n$$\\n\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u=\\\\operatorname{arctan}⁡u+C.\\n$$\\n\\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $6{x}^{2}=(\\\\sqrt{6}x)^{2}.$\\n\\nSo, let's substitute $u=\\\\sqrt{6}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{6}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{6}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{1+6{x}^{2}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{1+(\\\\sqrt{6}x)^{2}}\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{1+{u}^{2}}\\\\cdot (\\\\frac{1}{\\\\sqrt{6}}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{\\\\sqrt{6}}\\\\int \\\\frac{1}{1+{u}^{2}}\\\\text{d}u \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{6}\\\\operatorname{arctan}⁡u+C \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{6}\\\\operatorname{arctan}⁡(\\\\sqrt{6}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186676705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"04213b8c-a4f5-5d3a-9b15-2026b2773f38\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\" :db/id 17592186676706} {:answer/id #uuid \"24ff35a2-12cf-5cee-878e-d0b766426a14\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{729}+C\" :db/id 17592186676730} {:answer/id #uuid \"2b636129-5f39-51a3-84e5-2abd974c2009\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{9}+C\" :db/id 17592186676734} {:answer/id #uuid \"771066be-5b08-556f-82d9-049a0d3f3ddc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{81}+C\" :db/id 17592186676783} {:answer/id #uuid \"d8bc0d3a-5228-5caf-9e16-ef5c59b3a33b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\" :db/id 17592186676842}] :answer-field/correct {:answer/id #uuid \"d8bc0d3a-5228-5caf-9e16-ef5c59b3a33b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\" :db/id 17592186676842} :answer-field/id #uuid \"33c84b16-473c-5bf4-9598-3a717f823644\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676746}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"0328f6eb-ab94-54f1-a3fa-9db716e7cc30\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{x^{2} + 81}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 81=81(1+(\\\\frac{1}{81})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{9}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{9},\\\\qquad \\\\mathrm{d}x=(9)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{x^{2} + 81}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{8}{81}\\\\int \\\\frac{1}{1+(\\\\frac{x}{9})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{8}{81}(9)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8}{9}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{9}+C \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"63e93ad6-e0d0-5c38-a11b-a59fd1a7feb3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{21}+C\" :db/id 17592186676768} {:answer/id #uuid \"6915e116-1429-5a3d-90cb-b690b761d7f3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\operatorname{arctan}{\\\\left(6 x \\\\right)}}{21}+C\" :db/id 17592186676772} {:answer/id #uuid \"8615610f-6718-58b0-a5cc-3146d3e191c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\operatorname{arcsin}{\\\\left(6 x \\\\right)}}{21}+C\" :db/id 17592186676791} {:answer/id #uuid \"dbce6603-839a-5774-be2a-bd2c88ff96c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{24 \\\\operatorname{arctan}{\\\\left(6 x \\\\right)}}{7}+C\" :db/id 17592186676846} {:answer/id #uuid \"dbe0f613-0528-5577-bdd1-de1020e9994c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\operatorname{arctan}{\\\\left(6 x \\\\right)}}{7}+C\" :db/id 17592186676847}] :answer-field/correct {:answer/id #uuid \"6915e116-1429-5a3d-90cb-b690b761d7f3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\operatorname{arctan}{\\\\left(6 x \\\\right)}}{21}+C\" :db/id 17592186676772} :answer-field/id #uuid \"a3d30795-9bf1-5254-991e-6ab1bff62e9a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676806}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"08182b49-5105-5e47-82b6-061be00c1c00\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{252 x^{2} + 7}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n252 x^{2} + 7=7(1+(36)x^{2})\\n$$\\n\\nUse the linear substitution $u=6 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{6})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{252 x^{2} + 7}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{4}{7}\\\\int \\\\frac{1}{1+(6 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{4}{7}(\\\\frac{1}{6})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{2}{21}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{2 \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{21}+C \\\\\\\\  &= \\\\frac{2 \\\\operatorname{arctan}{\\\\left(6 x \\\\right)}}{21}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1396f0ef-e9ef-5af5-a333-a4d0c5e73f64\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}+C\" :db/id 17592186676719} {:answer/id #uuid \"1edc6b38-1c31-5835-92d0-b46e9fbae931\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676725} {:answer/id #uuid \"8a786436-9219-596e-a6f7-b41b5ab5f943\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{8}+C\" :db/id 17592186676797} {:answer/id #uuid \"8c4e8c8b-124e-5303-bdb6-3adc03547b5e\" :answer/type {:db/ident :answer.type/math} :answer/value \"24 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}+C\" :db/id 17592186676798} {:answer/id #uuid \"be1fd41f-de13-59ad-adea-a77d1673b296\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arcsin}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676823}] :answer-field/correct {:answer/id #uuid \"1edc6b38-1c31-5835-92d0-b46e9fbae931\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676725} :answer-field/id #uuid \"bff92d75-29b5-505e-9429-a2ff32acf0cf\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676825}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"29b02aca-6052-5e7a-87ee-eeebee2626d4\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{3}{64 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{3}{64 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 3\\\\int \\\\frac{1}{1+(8 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 3(\\\\frac{1}{8})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{3}{8}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{3 \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{3 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2ef8c30d-fd49-5779-9e5d-c7dd5a32f59e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{2} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{2} x}{7} \\\\right)}}{343}+C\" :db/id 17592186676740} {:answer/id #uuid \"42157c23-e7cf-53d6-a1f4-7ab4e415c97d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{2} x}{7} \\\\right)}}{49}+C\" :db/id 17592186676753} {:answer/id #uuid \"47b39529-65b9-5548-844f-982292e23a7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sqrt{2} \\\\operatorname{arcsin}{\\\\left(\\\\frac{\\\\sqrt{2} x}{7} \\\\right)}}{7}+C\" :db/id 17592186676754} {:answer/id #uuid \"8696acc0-a3e5-5d84-91ff-758690518877\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sqrt{2} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{7}+C\" :db/id 17592186676792} {:answer/id #uuid \"f2bacbd4-300f-5c95-9a1b-adb46900035f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sqrt{2} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{2} x}{7} \\\\right)}}{7}+C\" :db/id 17592186676866}] :answer-field/correct {:answer/id #uuid \"f2bacbd4-300f-5c95-9a1b-adb46900035f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sqrt{2} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{2} x}{7} \\\\right)}}{7}+C\" :db/id 17592186676866} :answer-field/id #uuid \"89dc5d2d-8f9e-5319-aac2-fdf6c46997c5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676796}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"2dc8364c-3b6b-5d4f-a269-88d33ebce849\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{2 x^{2} + 49}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n2 x^{2} + 49=49(1+(\\\\frac{2}{49})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{\\\\sqrt{2} x}{7}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{\\\\sqrt{2}}{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{7 \\\\sqrt{2}}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{2 x^{2} + 49}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{4}{49}\\\\int \\\\frac{1}{1+(\\\\frac{\\\\sqrt{2} x}{7})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{4}{49}(\\\\frac{7 \\\\sqrt{2}}{2})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{2 \\\\sqrt{2}}{7}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{2 \\\\sqrt{2} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{2 \\\\sqrt{2} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{2} x}{7} \\\\right)}}{7}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676761 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5ac2c4b5-4376-5a26-82cd-28b6e5fef581\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\" :db/id 17592186676765} {:answer/id #uuid \"a09fdd28-10ed-5146-a8c9-c78e47e3a98d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{3} \\\\operatorname{arcsin}{\\\\left(\\\\sqrt{3} x \\\\right)}}{3}+C\" :db/id 17592186676805} {:answer/id #uuid \"a7abed00-599b-52be-a273-794e20b361cd\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\" :db/id 17592186676808} {:answer/id #uuid \"b0bcc72f-effc-5119-94d9-67b8acd9060a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{3} x \\\\right)}}{3}+C\" :db/id 17592186676816} {:answer/id #uuid \"f58d9e97-798b-599a-9014-01605b801daf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{3}+C\" :db/id 17592186676868}] :answer-field/correct {:answer/id #uuid \"b0bcc72f-effc-5119-94d9-67b8acd9060a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{3} x \\\\right)}}{3}+C\" :db/id 17592186676816} :answer-field/id #uuid \"d4aefbc3-b1af-5b1a-a090-48229e2c59c1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676838}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"540dfc73-65b7-5e01-852a-1098e492d974\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{3 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{3} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{3},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{3}}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{3 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4\\\\int \\\\frac{1}{1+(\\\\sqrt{3} x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4(\\\\frac{\\\\sqrt{3}}{3})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4 \\\\sqrt{3}}{3}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{3}+C \\\\\\\\  &= \\\\frac{4 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{3} x \\\\right)}}{3}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0d7d4c0f-5fa0-5f80-a5f5-aa0c2d376c50\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\sqrt{5} \\\\operatorname{arcsin}{\\\\left(\\\\frac{\\\\sqrt{5} x}{5} \\\\right)}}{25}+C\" :db/id 17592186676715} {:answer/id #uuid \"337c7bc0-9365-59e3-b93d-e0a1ff845f7f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{5} x}{5} \\\\right)}}{25}+C\" :db/id 17592186676745} {:answer/id #uuid \"3f1d75d6-22d2-5ab9-b453-12fcf4cf7865\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\sqrt{5} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{25}+C\" :db/id 17592186676750} {:answer/id #uuid \"9062dee4-44ad-5aa7-8574-bc177ce99fb7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\sqrt{5} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{5} x}{5} \\\\right)}}{25}+C\" :db/id 17592186676799} {:answer/id #uuid \"addd6c3c-9125-51be-a9c6-c00adaaae570\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\sqrt{5} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{5} x}{5} \\\\right)}}{125}+C\" :db/id 17592186676812}] :answer-field/correct {:answer/id #uuid \"9062dee4-44ad-5aa7-8574-bc177ce99fb7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\sqrt{5} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{5} x}{5} \\\\right)}}{25}+C\" :db/id 17592186676799} :answer-field/id #uuid \"6cef7d9c-3561-501c-a199-09a77b88cc10\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676779}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"55e18530-4dec-572d-a88b-ac0dc3c3ec5b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{7}{5 x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n5 x^{2} + 25=25(1+(\\\\frac{1}{5})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{\\\\sqrt{5} x}{5}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{\\\\sqrt{5}}{5},\\\\qquad \\\\mathrm{d}x=(\\\\sqrt{5})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{7}{5 x^{2} + 25}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{25}\\\\int \\\\frac{1}{1+(\\\\frac{\\\\sqrt{5} x}{5})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{25}(\\\\sqrt{5})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{7 \\\\sqrt{5}}{25}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{7 \\\\sqrt{5} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{25}+C \\\\\\\\  &= \\\\frac{7 \\\\sqrt{5} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{5} x}{5} \\\\right)}}{25}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"17780bed-4359-5126-81c4-a87852eeacd3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}}{8}+C\" :db/id 17592186676723} {:answer/id #uuid \"55bbad3c-c50c-5e9a-8517-a624d325a0b3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(x \\\\right)}}{8}+C\" :db/id 17592186676762} {:answer/id #uuid \"af1b5b20-413d-532c-a91f-7a7a59b90f40\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}}{64}+C\" :db/id 17592186676813} {:answer/id #uuid \"c206a918-46b3-5b97-8ec2-e04b6ffd1b0f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{8} \\\\right)}}{8}+C\" :db/id 17592186676828} {:answer/id #uuid \"ed8ae318-a787-513f-8541-f627576c0f50\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}}{512}+C\" :db/id 17592186676861}] :answer-field/correct {:answer/id #uuid \"17780bed-4359-5126-81c4-a87852eeacd3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}}{8}+C\" :db/id 17592186676723} :answer-field/id #uuid \"bede5953-de93-55e7-9413-a0c2afad3313\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676824}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"5a03e52f-a789-58b8-8cc0-a47e970671ff\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{x^{2} + 64}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 64=64(1+(\\\\frac{1}{64})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{8}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{8},\\\\qquad \\\\mathrm{d}x=(8)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{x^{2} + 64}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{64}\\\\int \\\\frac{1}{1+(\\\\frac{x}{8})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{64}(8)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{8}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}}{8}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2e8e958b-c343-5170-816b-4e648ead370c\" :answer/type {:db/ident :answer.type/math} :answer/value \"16 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}+C\" :db/id 17592186676739} {:answer/id #uuid \"3f7c3f4c-d1c9-5343-98d1-9dc76c21ae47\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}+C\" :db/id 17592186676751} {:answer/id #uuid \"64f43cea-82e3-5cf1-9cbf-43842411bb39\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(x \\\\right)}}{4}+C\" :db/id 17592186676770} {:answer/id #uuid \"70e02059-973f-581c-a1d3-bc66b391d5bf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}{\\\\left(8 x \\\\right)}}{4}+C\" :db/id 17592186676781} {:answer/id #uuid \"9c524791-e707-5343-b791-1b1e03c75f52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{4}+C\" :db/id 17592186676802}] :answer-field/correct {:answer/id #uuid \"9c524791-e707-5343-b791-1b1e03c75f52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{4}+C\" :db/id 17592186676802} :answer-field/id #uuid \"b17f2626-b155-58de-9d66-8d6cd21bf664\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676818}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"785a58d5-601a-50af-b1f2-100d273d37ef\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{2}{64 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{2}{64 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 2\\\\int \\\\frac{1}{1+(8 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 2(\\\\frac{1}{8})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{4}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(u \\\\right)}}{4}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{4}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676795 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3136ef37-a6a8-58b1-8d37-940fe10b3ceb\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(x \\\\right)}+C\" :db/id 17592186676742} {:answer/id #uuid \"3b2d3090-8fca-5042-8512-98ecf1afe80a\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{2} \\\\right)}+C\" :db/id 17592186676748} {:answer/id #uuid \"647c93b4-4022-57a8-8a6f-d883df9071c3\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{2} \\\\right)}+C\" :db/id 17592186676769} {:answer/id #uuid \"c03d8122-5c29-5bb4-8edc-b5010de8b7e7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{2} \\\\right)}+C\" :db/id 17592186676826} {:answer/id #uuid \"f05464ff-866e-548c-a5c5-f724edae6e49\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{2} \\\\right)}+C\" :db/id 17592186676864}] :answer-field/correct {:answer/id #uuid \"f05464ff-866e-548c-a5c5-f724edae6e49\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{2} \\\\right)}+C\" :db/id 17592186676864} :answer-field/id #uuid \"4f5bcf49-2519-5a78-82d8-d2a7e774ebe6\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676758}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"893a3dea-aca6-502a-8459-3475a2d5f36c\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 4=4(1+(\\\\frac{1}{4})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{2}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{2},\\\\qquad \\\\mathrm{d}x=(2)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{x^{2} + 4}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 2\\\\int \\\\frac{1}{1+(\\\\frac{x}{2})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 2(2)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4 \\\\operatorname{arctan}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 4 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{2} \\\\right)}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"14641773-0758-5ae5-86d4-9b5f82c9f52c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{3} \\\\right)}+C\" :db/id 17592186676722} {:answer/id #uuid \"6c96749d-e150-5f73-8561-f38354710ccd\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arctan}{\\\\left(x \\\\right)}+C\" :db/id 17592186676778} {:answer/id #uuid \"af60df0d-917c-561e-809c-7fff1b6d8b01\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{3} \\\\right)}}{3}+C\" :db/id 17592186676814} {:answer/id #uuid \"b3c6de88-9b8f-54bc-97e1-1be360b15697\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{3} \\\\right)}+C\" :db/id 17592186676820} {:answer/id #uuid \"d68caef6-11a8-53cf-aef8-95fba99f9bbd\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{3} \\\\right)}+C\" :db/id 17592186676839}] :answer-field/correct {:answer/id #uuid \"d68caef6-11a8-53cf-aef8-95fba99f9bbd\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{3} \\\\right)}+C\" :db/id 17592186676839} :answer-field/id #uuid \"13f62dcd-6874-5653-bf6b-6cc7bfdeabac\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676721}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a3f2cb6b-15b8-5ca3-8303-5a5f3b19e4bd\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 9=9(1+(\\\\frac{1}{9})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{3}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{3},\\\\qquad \\\\mathrm{d}x=(3)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{x^{2} + 9}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{1+(\\\\frac{x}{3})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(3)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3 \\\\operatorname{arctan}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 3 \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{3} \\\\right)}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0769c362-ae23-56e8-9ec9-7f91d8e28adc\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676709} {:answer/id #uuid \"13abb57a-6a30-51a9-9be4-207da1cf738a\" :answer/type {:db/ident :answer.type/math} :answer/value \"18 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676720} {:answer/id #uuid \"6b7824b8-9a8c-5756-8476-bbac3d10265a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}}{2}+C\" :db/id 17592186676774} {:answer/id #uuid \"9dfd40ca-3b2f-5fe7-b919-2cb4abfd52b6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{2}+C\" :db/id 17592186676803} {:answer/id #uuid \"c41c9187-28fb-5a68-bc11-1ac2507b3cf1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arcsin}{\\\\left(2 x \\\\right)}}{2}+C\" :db/id 17592186676829}] :answer-field/correct {:answer/id #uuid \"6b7824b8-9a8c-5756-8476-bbac3d10265a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}}{2}+C\" :db/id 17592186676774} :answer-field/id #uuid \"a8f82dd4-2a36-5f47-8556-3c6a31591d63\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676810}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b184ca4c-53d9-5369-89fb-0039f0abbed1\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{1+(2 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{2})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9}{2}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{2}+C \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}}{2}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"005d9c54-9266-5ad7-9027-c1f978649698\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arctan}{\\\\left(3 x \\\\right)}}{7}+C\" :db/id 17592186676704} {:answer/id #uuid \"813d1154-44eb-5e02-8ecd-d8dc89caec0d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{27 \\\\operatorname{arctan}{\\\\left(3 x \\\\right)}}{7}+C\" :db/id 17592186676786} {:answer/id #uuid \"e0df5488-8162-525d-9423-9d533e200638\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{7}+C\" :db/id 17592186676850} {:answer/id #uuid \"e6923f62-a9bc-5fcf-96b2-d18caaa3229f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arctan}{\\\\left(3 x \\\\right)}}{7}+C\" :db/id 17592186676855} {:answer/id #uuid \"e91c1dff-d486-5d65-a46a-5ff5bfd1c7e6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arcsin}{\\\\left(3 x \\\\right)}}{7}+C\" :db/id 17592186676858}] :answer-field/correct {:answer/id #uuid \"005d9c54-9266-5ad7-9027-c1f978649698\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\operatorname{arctan}{\\\\left(3 x \\\\right)}}{7}+C\" :db/id 17592186676704} :answer-field/id #uuid \"ce568bb9-c592-5247-881c-e3509e33d4c4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676836}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b65f9d67-eac4-5c1b-ba55-093731e10653\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{63 x^{2} + 7}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n63 x^{2} + 7=7(1+(9)x^{2})\\n$$\\n\\nUse the linear substitution $u=3 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{63 x^{2} + 7}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{9}{7}\\\\int \\\\frac{1}{1+(3 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{9}{7}(\\\\frac{1}{3})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{3}{7}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{3 \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{3 \\\\operatorname{arctan}{\\\\left(3 x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"077df066-c1a9-5bdd-aba4-16684f634732\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{10} \\\\operatorname{arcsin}{\\\\left(\\\\sqrt{10} x \\\\right)}}{10}+C\" :db/id 17592186676710} {:answer/id #uuid \"3161d050-8c20-530d-a5d6-f952f5390501\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}+C\" :db/id 17592186676743} {:answer/id #uuid \"afe90c87-9ef0-5590-a880-7890c3b7c5a0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{10}+C\" :db/id 17592186676815} {:answer/id #uuid \"f9c317fa-bb92-55a0-a62a-26a5b44699c0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}}{10}+C\" :db/id 17592186676870} {:answer/id #uuid \"fcada423-3e25-587e-9326-43fadd6f5698\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}+C\" :db/id 17592186676871}] :answer-field/correct {:answer/id #uuid \"f9c317fa-bb92-55a0-a62a-26a5b44699c0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}}{10}+C\" :db/id 17592186676870} :answer-field/id #uuid \"e500327f-0b20-5c07-a644-e2c771db1482\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676852}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c8750434-5b20-5785-8484-983954e623d2\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{10 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{10} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{10},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{10}}{10})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{10 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{1+(\\\\sqrt{10} x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{\\\\sqrt{10}}{10})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\sqrt{10}}{10}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{10}+C \\\\\\\\  &= \\\\frac{\\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}}{10}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0438bd23-6c13-56c2-affd-2ac3c282ca73\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{8} \\\\right)}+C\" :db/id 17592186676707} {:answer/id #uuid \"5be60abd-8380-5e16-bb21-8ca5440497c0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}}{8}+C\" :db/id 17592186676766} {:answer/id #uuid \"856d11d6-0d10-53f1-84fb-098362206b3c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}+C\" :db/id 17592186676789} {:answer/id #uuid \"a01bd723-2e88-5b18-b635-5b6f088926d7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(x \\\\right)}+C\" :db/id 17592186676804} {:answer/id #uuid \"ec2c399f-c1a2-59ab-a76c-a167e2ae9f09\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}}{64}+C\" :db/id 17592186676859}] :answer-field/correct {:answer/id #uuid \"856d11d6-0d10-53f1-84fb-098362206b3c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}+C\" :db/id 17592186676789} :answer-field/id #uuid \"06b95b7d-9317-5427-b34d-9ac5f182aac0\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676708}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"d91f82e1-a5f1-59df-8ebb-04c941947778\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{x^{2} + 64}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 64=64(1+(\\\\frac{1}{64})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{8}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{8},\\\\qquad \\\\mathrm{d}x=(8)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{x^{2} + 64}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{8}\\\\int \\\\frac{1}{1+(\\\\frac{x}{8})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{8}(8)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arctan}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{8} \\\\right)}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"23fb85f4-ddbe-5cc9-ab0d-60e54e5923a5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{6} \\\\right)}+C\" :db/id 17592186676729} {:answer/id #uuid \"2d84c97a-224d-5ac1-be50-7e3484487e17\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(x \\\\right)}+C\" :db/id 17592186676737} {:answer/id #uuid \"518b04bb-d23e-57d4-a2ea-d6457c3396e9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{6} \\\\right)}}{36}+C\" :db/id 17592186676759} {:answer/id #uuid \"672ddfcb-f2e1-587d-8100-bcc793f9051c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{6} \\\\right)}}{6}+C\" :db/id 17592186676771} {:answer/id #uuid \"6b97cd79-8c0e-5fc4-b493-8be41aef252c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{6} \\\\right)}+C\" :db/id 17592186676775}] :answer-field/correct {:answer/id #uuid \"6b97cd79-8c0e-5fc4-b493-8be41aef252c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{6} \\\\right)}+C\" :db/id 17592186676775} :answer-field/id #uuid \"28f53a1f-aec7-56ce-a32a-047c289dbea1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676732}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"da5029da-63e2-508a-a4ed-eaf480260df3\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{6}{x^{2} + 36}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 36=36(1+(\\\\frac{1}{36})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{6}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{6},\\\\qquad \\\\mathrm{d}x=(6)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{6}{x^{2} + 36}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{6}\\\\int \\\\frac{1}{1+(\\\\frac{x}{6})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{6}(6)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arctan}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{6} \\\\right)}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"07c26e54-2294-5687-b4c5-58f8778f2ab7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{729}+C\" :db/id 17592186676712} {:answer/id #uuid \"23910027-5f13-5a3c-a6de-adda6a244240\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(x \\\\right)}}{9}+C\" :db/id 17592186676728} {:answer/id #uuid \"84377d13-d7eb-5c20-a86b-157b73f6458f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\" :db/id 17592186676788} {:answer/id #uuid \"ca7464c5-dcbc-552b-8052-445cd47479f7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{81}+C\" :db/id 17592186676833} {:answer/id #uuid \"e5fb92f8-0d6d-5ea0-9d2d-71d67d6a0775\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\" :db/id 17592186676854}] :answer-field/correct {:answer/id #uuid \"e5fb92f8-0d6d-5ea0-9d2d-71d67d6a0775\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\" :db/id 17592186676854} :answer-field/id #uuid \"f2b10e7e-0247-5cb6-93d0-182d84a3d991\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676865}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"dbb54453-224c-5927-8847-fd39bd2a8cdb\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{x^{2} + 81}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 81=81(1+(\\\\frac{1}{81})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{9}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{9},\\\\qquad \\\\mathrm{d}x=(9)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{x^{2} + 81}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{81}\\\\int \\\\frac{1}{1+(\\\\frac{x}{9})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{81}(9)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{9}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(u \\\\right)}}{9}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{9} \\\\right)}}{9}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"222dd6f4-b70d-53fe-9d18-4de408229685\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{3} x}{3} \\\\right)}}{9}+C\" :db/id 17592186676727} {:answer/id #uuid \"2817e13a-038f-58d5-b082-6b005cef9595\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{3} x}{3} \\\\right)}}{27}+C\" :db/id 17592186676731} {:answer/id #uuid \"2ca2ef99-5d02-54a2-af4e-eba2f7bbb221\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{9}+C\" :db/id 17592186676736} {:answer/id #uuid \"3cc982a9-0b51-5b09-97da-0bd0b7e71c5a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{3} x}{3} \\\\right)}}{9}+C\" :db/id 17592186676749} {:answer/id #uuid \"4ac19d27-e1ff-5965-bfd6-f263e47cc945\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{3} \\\\operatorname{arcsin}{\\\\left(\\\\frac{\\\\sqrt{3} x}{3} \\\\right)}}{9}+C\" :db/id 17592186676756}] :answer-field/correct {:answer/id #uuid \"3cc982a9-0b51-5b09-97da-0bd0b7e71c5a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{3} x}{3} \\\\right)}}{9}+C\" :db/id 17592186676749} :answer-field/id #uuid \"6a3a75ad-9c36-5dc3-95a6-45a3e5d1f11c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676773}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"dfd7646e-d2d1-5aa8-a418-f07224a77ff5\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{3 x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n3 x^{2} + 9=9(1+(\\\\frac{1}{3})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{\\\\sqrt{3} x}{3}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{\\\\sqrt{3}}{3},\\\\qquad \\\\mathrm{d}x=(\\\\sqrt{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{3 x^{2} + 9}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{5}{9}\\\\int \\\\frac{1}{1+(\\\\frac{\\\\sqrt{3} x}{3})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{5}{9}(\\\\sqrt{3})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{5 \\\\sqrt{3}}{9}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{5 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{9}+C \\\\\\\\  &= \\\\frac{5 \\\\sqrt{3} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{3} x}{3} \\\\right)}}{9}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"09a5a5c3-5963-5952-b70d-f29daf65f1c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6 \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{35}+C\" :db/id 17592186676714} {:answer/id #uuid \"1d3c4f76-2ae6-5021-bb8e-ffb58c3e150b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6 \\\\operatorname{arcsin}{\\\\left(7 x \\\\right)}}{35}+C\" :db/id 17592186676724} {:answer/id #uuid \"20b7442b-bcfb-526d-b0e6-7ba3cd23c511\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{5}+C\" :db/id 17592186676726} {:answer/id #uuid \"3115789a-63e7-53d3-b8d4-6e149d36c294\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{42 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{5}+C\" :db/id 17592186676741} {:answer/id #uuid \"c8241a16-47b5-5eb2-a0ce-16edb25d79ee\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{35}+C\" :db/id 17592186676831}] :answer-field/correct {:answer/id #uuid \"c8241a16-47b5-5eb2-a0ce-16edb25d79ee\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{35}+C\" :db/id 17592186676831} :answer-field/id #uuid \"85972465-831a-5959-bb43-67e737123888\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676790}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e24705b1-315a-5355-bc41-cabb19369d0b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{6}{245 x^{2} + 5}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n245 x^{2} + 5=5(1+(49)x^{2})\\n$$\\n\\nUse the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{6}{245 x^{2} + 5}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{6}{5}\\\\int \\\\frac{1}{1+(7 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{6}{5}(\\\\frac{1}{7})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{6}{35}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{6 \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{35}+C \\\\\\\\  &= \\\\frac{6 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{35}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"320d9c8f-5a9c-54a3-8244-a7f509bddcdd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{7} x}{6} \\\\right)}}{216}+C\" :db/id 17592186676744} {:answer/id #uuid \"611bf0ea-6eae-501a-aac7-6c59d056db52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arcsin}{\\\\left(\\\\frac{\\\\sqrt{7} x}{6} \\\\right)}}{42}+C\" :db/id 17592186676767} {:answer/id #uuid \"79d6305f-5afc-5a35-bb87-98d6dc9d7707\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{42}+C\" :db/id 17592186676785} {:answer/id #uuid \"91023144-4d51-5538-a368-feb111219811\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{7} x}{6} \\\\right)}}{42}+C\" :db/id 17592186676800} {:answer/id #uuid \"d777ad93-d0ad-5c26-9c7f-2358124a9722\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{7} x}{6} \\\\right)}}{36}+C\" :db/id 17592186676840}] :answer-field/correct {:answer/id #uuid \"91023144-4d51-5538-a368-feb111219811\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{7} x}{6} \\\\right)}}{42}+C\" :db/id 17592186676800} :answer-field/id #uuid \"6bbb539e-e5b6-53e7-8999-f4fb189180c8\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676776}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e89cba94-0b9c-53a6-bd8e-752f93d9ffc2\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{7 x^{2} + 36}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n7 x^{2} + 36=36(1+(\\\\frac{7}{36})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{\\\\sqrt{7} x}{6}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{\\\\sqrt{7}}{6},\\\\qquad \\\\mathrm{d}x=(\\\\frac{6 \\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{7 x^{2} + 36}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{5}{36}\\\\int \\\\frac{1}{1+(\\\\frac{\\\\sqrt{7} x}{6})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{5}{36}(\\\\frac{6 \\\\sqrt{7}}{7})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{5 \\\\sqrt{7}}{42}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{5 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{42}+C \\\\\\\\  &= \\\\frac{5 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\frac{\\\\sqrt{7} x}{6} \\\\right)}}{42}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"10370922-a81e-5c1d-90ed-592688a39e00\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{5}+C\" :db/id 17592186676717} {:answer/id #uuid \"2c282b7e-5b06-5e40-b967-3f76ee982529\" :answer/type {:db/ident :answer.type/math} :answer/value \"8 \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}+C\" :db/id 17592186676735} {:answer/id #uuid \"48de8ff9-8f2a-51fc-9817-bd73df8d0c95\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{10} \\\\operatorname{arcsin}{\\\\left(\\\\sqrt{10} x \\\\right)}}{5}+C\" :db/id 17592186676755} {:answer/id #uuid \"c50902df-30da-580b-9820-7cbc7b16912a\" :answer/type {:db/ident :answer.type/math} :answer/value \"8 \\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}+C\" :db/id 17592186676830} {:answer/id #uuid \"dd006627-a0f0-52de-9ea1-8fc081e7df81\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}}{5}+C\" :db/id 17592186676848}] :answer-field/correct {:answer/id #uuid \"dd006627-a0f0-52de-9ea1-8fc081e7df81\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}}{5}+C\" :db/id 17592186676848} :answer-field/id #uuid \"aca6f980-732b-5fcd-80e8-f202607f065d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676811}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"ec536a71-42ec-5ebc-9d40-b2754ac5878c\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{10 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{10} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{10},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{10}}{10})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{10 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{1+(\\\\sqrt{10} x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{\\\\sqrt{10}}{10})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4 \\\\sqrt{10}}{5}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4 \\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{5}+C \\\\\\\\  &= \\\\frac{4 \\\\sqrt{10} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{10} x \\\\right)}}{5}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"831c689c-2da1-5ad0-b643-c20f35616ef1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{7} \\\\right)}}{49}+C\" :db/id 17592186676787} {:answer/id #uuid \"883afc43-bee6-57e6-87e8-344f08fc7903\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{7} \\\\right)}}{7}+C\" :db/id 17592186676794} {:answer/id #uuid \"a7d75d86-11bf-5b13-b8d5-ede4fcf2dbd7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsin}{\\\\left(\\\\frac{x}{7} \\\\right)}+C\" :db/id 17592186676809} {:answer/id #uuid \"b5d5bdae-9c56-548b-916e-17e216ee0218\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(x \\\\right)}+C\" :db/id 17592186676821} {:answer/id #uuid \"d2ef1263-5631-591f-b9bf-9f3b133aa72b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{7} \\\\right)}+C\" :db/id 17592186676837}] :answer-field/correct {:answer/id #uuid \"d2ef1263-5631-591f-b9bf-9f3b133aa72b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(\\\\frac{x}{7} \\\\right)}+C\" :db/id 17592186676837} :answer-field/id #uuid \"0dd9a8e8-87de-50ad-8634-fa755e78f769\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676716}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ee64b443-9b0a-5350-bb7e-817a5e6da986\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{7}{x^{2} + 49}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\nx^{2} + 49=49(1+(\\\\frac{1}{49})x^{2})\\n$$\\n\\nUse the linear substitution $u=\\\\frac{x}{7}.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{7},\\\\qquad \\\\mathrm{d}x=(7)\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{7}{x^{2} + 49}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{7}\\\\int \\\\frac{1}{1+(\\\\frac{x}{7})^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{7}(7)\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arctan}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arctan}{\\\\left(\\\\frac{x}{7} \\\\right)}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"38104d99-89dc-5c65-91da-a38ea89cecd5\" :answer/type {:db/ident :answer.type/math} :answer/value \"20 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}+C\" :db/id 17592186676747} {:answer/id #uuid \"4dbf7579-c4a6-5e84-b316-e43a2c06c6d1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\operatorname{arcsin}{\\\\left(5 x \\\\right)}}{5}+C\" :db/id 17592186676757} {:answer/id #uuid \"c066d068-8f0f-5b8f-9079-684135eeaaa4\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}+C\" :db/id 17592186676827} {:answer/id #uuid \"ccab861f-97b1-5360-bb18-335589f6b68d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{5}+C\" :db/id 17592186676835} {:answer/id #uuid \"d81917ec-2137-583b-8e2a-6dba3b1cbb65\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}}{5}+C\" :db/id 17592186676841}] :answer-field/correct {:answer/id #uuid \"d81917ec-2137-583b-8e2a-6dba3b1cbb65\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}}{5}+C\" :db/id 17592186676841} :answer-field/id #uuid \"b0d76d60-375d-5a12-b771-5d768e620be3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676817}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"ef7b058e-fc6a-5813-9eb1-d41bf53d2867\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=5 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4\\\\int \\\\frac{1}{1+(5 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4(\\\\frac{1}{5})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4}{5}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4 \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{5}+C \\\\\\\\  &= \\\\frac{4 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}}{5}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1354a5c6-4986-51a0-a180-095d77f61a88\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(x \\\\right)}}{7}+C\" :db/id 17592186676718} {:answer/id #uuid \"522f0b49-36d3-5564-8587-88f69e0b4972\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{7} \\\\operatorname{arcsin}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\" :db/id 17592186676760} {:answer/id #uuid \"6e79f9b7-9587-51cb-9715-6d0667bfbe94\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\" :db/id 17592186676780} {:answer/id #uuid \"73505e5a-61de-522f-98f5-f372a4aff84d\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186676782} {:answer/id #uuid \"87246861-a0f8-5866-8f47-f2e094fd4e05\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186676793}] :answer-field/correct {:answer/id #uuid \"6e79f9b7-9587-51cb-9715-6d0667bfbe94\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\" :db/id 17592186676780} :answer-field/id #uuid \"6c913ac6-a686-52ea-8fea-4ea5396bf730\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676777}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"f49dc8f2-18d9-5ea1-864b-63e28786f067\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{7 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{7} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{7 x^{2} + 1}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4\\\\int \\\\frac{1}{1+(\\\\sqrt{7} x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4(\\\\frac{\\\\sqrt{7}}{7})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4 \\\\sqrt{7}}{7}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{4 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{4 \\\\sqrt{7} \\\\operatorname{arctan}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186676869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"07ad1890-2cae-51ec-85ca-7aff39f86cd9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(2 x \\\\right)}}{2}+C\" :db/id 17592186676711} {:answer/id #uuid \"3fb86f00-a7d3-5e1c-ab6a-eef0c1e19200\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(2 x \\\\right)}}{4}+C\" :db/id 17592186676752} {:answer/id #uuid \"9c11befe-819f-5bde-9b9b-0a8eae816193\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arctan}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676801} {:answer/id #uuid \"cbbee414-a342-56e0-8aec-8562cf05d4ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}{\\\\left(2 x \\\\right)}}{4}+C\" :db/id 17592186676834} {:answer/id #uuid \"e809e901-278c-58b4-87b5-87d3488d051b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(x \\\\right)}}{4}+C\" :db/id 17592186676856}] :answer-field/correct {:answer/id #uuid \"3fb86f00-a7d3-5e1c-ab6a-eef0c1e19200\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(2 x \\\\right)}}{4}+C\" :db/id 17592186676752} :answer-field/id #uuid \"e55d26c5-0fc0-52a8-8e03-1e3787dd3fa8\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676853}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f85c1197-a16c-562c-8e6f-5ec36344ebe3\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{8 x^{2} + 2}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"First factor the constant in the denominator:\\n\\n$$\\n8 x^{2} + 2=2(1+(4)x^{2})\\n$$\\n\\nUse the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arctan}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{8 x^{2} + 2}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{2}\\\\int \\\\frac{1}{1+(2 x)^{2}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{1}{2}(\\\\frac{1}{2})\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{4}\\\\int \\\\frac{1}{1+u^{2}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(u \\\\right)}}{4}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arctan}{\\\\left(2 x \\\\right)}}{4}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186678774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0828d66e-5e07-5f2b-b949-ebf7ea84e487\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678771} {:answer/id #uuid \"1d77ddcd-3fe6-572d-a877-3eebff19d0e9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678784} {:answer/id #uuid \"721ba121-1d99-5222-a5d4-240d8cddfa54\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678837} {:answer/id #uuid \"9307150f-c452-5ecd-ac84-2b71ef836d07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678862} {:answer/id #uuid \"a15e2513-a6df-5621-a5b2-3f3659f279e0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678870}] :answer-field/correct {:answer/id #uuid \"1d77ddcd-3fe6-572d-a877-3eebff19d0e9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678784} :answer-field/id #uuid \"af1eb895-a271-5c6f-82b1-19836b060167\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678880}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"0b04ba51-a09d-59d8-800c-a9f9a2586595\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4c1556d0-151d-5f41-8c3a-ee218dcfdf80\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678811} {:answer/id #uuid \"52c45dc3-30dd-53aa-b8f3-667ff2be361d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678817} {:answer/id #uuid \"756a8ddc-326b-5a32-941e-e425a433277f\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678840} {:answer/id #uuid \"948eada2-b615-5a51-8cc5-fd9fe61725e9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678863} {:answer/id #uuid \"dfe4ffa6-de38-562d-9bf4-f1904dda7934\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186678910}] :answer-field/correct {:answer/id #uuid \"52c45dc3-30dd-53aa-b8f3-667ff2be361d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678817} :answer-field/id #uuid \"b8613995-bd94-5b2a-8266-024798cec93f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678889}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"2c2bce04-d1e3-5f1d-bdce-22472d9c21e5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 4=4\\\\left(1+(\\\\frac{3 x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"232d27ea-930a-565a-875d-f68023a5ca43\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678787} {:answer/id #uuid \"3c8ff4ae-c9fe-5952-9c43-f7cdf215894d\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678804} {:answer/id #uuid \"9840a545-ee22-5b99-b4dd-cc8c75ac3005\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678865} {:answer/id #uuid \"b130ca0a-2533-5e9c-864a-ebb92e98aaa0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678881} {:answer/id #uuid \"c2a395f5-e921-58b5-8243-44ec93d99e0f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678897}] :answer-field/correct {:answer/id #uuid \"b130ca0a-2533-5e9c-864a-ebb92e98aaa0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678881} :answer-field/id #uuid \"fcff6ec7-0b9c-5bbd-a7dd-739136044bb7\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678933}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2ec1bd3a-f1d2-5889-a32f-fa1e4c67df66\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 4=4\\\\left(1+(\\\\frac{x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 2=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678803 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"00bd529d-5619-554b-98ef-bb9eda9ba34b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}+C\" :db/id 17592186678769} {:answer/id #uuid \"6ebb6278-fb1b-584b-875f-82787899a979\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678835} {:answer/id #uuid \"6f6fa036-2447-57ba-8a4d-a076b7f27808\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678836} {:answer/id #uuid \"7953de82-e5a2-515e-ba04-73ac79508cb8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}+C\" :db/id 17592186678842} {:answer/id #uuid \"e0ff5cad-6c11-5945-ad0f-af90c37cd586\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\arctan{\\\\left(x \\\\right)}+C\" :db/id 17592186678912}] :answer-field/correct {:answer/id #uuid \"00bd529d-5619-554b-98ef-bb9eda9ba34b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}+C\" :db/id 17592186678769} :answer-field/id #uuid \"c1310a9a-e39a-50df-8130-176f837e92a4\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678895}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"3c45b143-0142-5c16-8523-c40cf2bdae19\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 16=16\\\\left(1+(\\\\frac{x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot 4=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}+C.\\n$$\"} {:db/id 17592186678812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5e389db1-2d85-5e36-a218-ad88b7eb5510\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678822} {:answer/id #uuid \"7e724334-b972-5c48-8ba7-5510419c6c79\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678848} {:answer/id #uuid \"ad70f13e-1e63-5272-90e0-6561302e9a1c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678878} {:answer/id #uuid \"f67e09f1-403e-57c8-8023-e3ff5077ebe1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678925} {:answer/id #uuid \"fc30e8b5-8adf-593b-b56d-55d8e550186d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678932}] :answer-field/correct {:answer/id #uuid \"f67e09f1-403e-57c8-8023-e3ff5077ebe1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678925} :answer-field/id #uuid \"b5c6c5cb-db09-5e6a-a59f-5fe0515399f8\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678886}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4c75abf2-3c56-52f1-9ae3-4510d2d71ce0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 25=25\\\\left(1+(\\\\frac{x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{25}\\\\cdot 5=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"02456f98-038f-5ed0-acdd-f1c3d8deacbc\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678770} {:answer/id #uuid \"3a248562-1231-5a5e-a3ae-4e593809931e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678802} {:answer/id #uuid \"8acaf851-189e-5465-ba12-9e6ddae0822c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678858} {:answer/id #uuid \"aa03fc8b-26f9-5fd8-bb0a-1b4779a395d2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678875} {:answer/id #uuid \"e04af6d3-0e03-5b32-9bc8-c398dc26c38d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678911}] :answer-field/correct {:answer/id #uuid \"3a248562-1231-5a5e-a3ae-4e593809931e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678802} :answer-field/id #uuid \"5f002c17-a5ff-55eb-8281-188e54316537\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678823}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4eb29d6a-94bf-5b00-ab1f-82e6f676f794\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 9=9\\\\left(1+(\\\\frac{4 x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"183bdf7d-a3c0-5a2a-9e6a-36a8a79250f4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678783} {:answer/id #uuid \"4a829555-325c-5553-a7e4-85dd2173d6dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678809} {:answer/id #uuid \"68f2cba7-e10b-55c9-bde3-dcd3778ddda5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678831} {:answer/id #uuid \"81325cd9-e648-505e-b7a0-be144ce29220\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678851} {:answer/id #uuid \"f4cb449c-8fe7-52c5-87cf-eac7d45ef45d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678924}] :answer-field/correct {:answer/id #uuid \"81325cd9-e648-505e-b7a0-be144ce29220\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678851} :answer-field/id #uuid \"1750e3c6-f9f4-53a0-828d-47d268305482\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678782}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"658a0271-962a-52d8-9a16-cb7d2225a6e0\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0cac894f-1473-5bc8-8036-f73d594d790c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678775} {:answer/id #uuid \"164c9f9c-6bb2-505b-93dc-6c0ec6d1a722\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678781} {:answer/id #uuid \"2813c770-53fd-505c-8a74-327439bf7a9e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678790} {:answer/id #uuid \"88b3dbff-ff31-5337-875e-b9ba27838241\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678856} {:answer/id #uuid \"b6dfd8e2-4fde-52bc-bd13-87debc4899f6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\" :db/id 17592186678887}] :answer-field/correct {:answer/id #uuid \"164c9f9c-6bb2-505b-93dc-6c0ec6d1a722\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678781} :answer-field/id #uuid \"10fcfd93-aa5b-5845-b3b7-dfcd3603cc3d\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678778}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"67479a77-7ea9-5968-a20e-c449af8b91d7\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"abcc45e3-4991-5d38-b599-c4a622f1b4fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678877} {:answer/id #uuid \"b803e232-a7b2-5df9-8df2-69c21d155af6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678888} {:answer/id #uuid \"bd9a9b95-3d27-59b9-9581-00b5c6acc9f3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678891} {:answer/id #uuid \"ecea85df-c350-56f7-aa01-661e96f3d540\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678916} {:answer/id #uuid \"fa6dcb2e-ab06-5d32-af91-201dc60ff6bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678930}] :answer-field/correct {:answer/id #uuid \"fa6dcb2e-ab06-5d32-af91-201dc60ff6bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678930} :answer-field/id #uuid \"2a92e119-56af-5b6e-9ae4-011836f48d63\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678791}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"7a2f0386-5d91-5d21-89ac-b116944261ea\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{3 x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 16=16\\\\left(1+(\\\\frac{3 x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{4}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{8}\\\\cdot \\\\frac{4}{3}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"67a0376c-c630-5fc4-8771-3ca9ed7214cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678830} {:answer/id #uuid \"8da5362a-d288-5f11-9b3b-e9b62d156552\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678860} {:answer/id #uuid \"c24939c5-b63d-54ce-a232-af99f0da840a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678896} {:answer/id #uuid \"ca9d0fe8-b918-5c2a-a1d3-1a648dfc4099\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678900} {:answer/id #uuid \"d7e493d1-d97b-564e-9084-5f55b6b44649\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678908}] :answer-field/correct {:answer/id #uuid \"67a0376c-c630-5fc4-8771-3ca9ed7214cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678830} :answer-field/id #uuid \"e1160fca-76ee-5407-b809-2b5d7f3c52ba\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678913}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"7ba4ceb2-ab79-5b8e-adf9-4bb8d212d3af\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 25=25\\\\left(1+(\\\\frac{x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{25}\\\\cdot 5=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"12976fc3-72d6-56f2-b418-542e2d62445e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678779} {:answer/id #uuid \"2dacdcfc-59db-5e23-a8d7-84026d934f96\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678795} {:answer/id #uuid \"48c13269-fc62-5088-9886-bd98c2bccf5f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678808} {:answer/id #uuid \"51dadc25-fa13-5508-a524-2c038320ae7a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678816} {:answer/id #uuid \"5500a4be-c1e7-5653-860e-193181bf95ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678819}] :answer-field/correct {:answer/id #uuid \"2dacdcfc-59db-5e23-a8d7-84026d934f96\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678795} :answer-field/id #uuid \"f77b8b1d-6f00-595e-9f9e-9ddaa79e4674\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678927}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"84063140-5a6e-58c2-bb0d-aed925579fd8\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1e61d3c1-81fd-513d-9868-1d707b9a8486\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678785} {:answer/id #uuid \"383451ad-e19c-50cb-813b-3d24656afa30\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678799} {:answer/id #uuid \"7f0efd34-90cc-57ac-8db8-c893dccdce80\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{10}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678850} {:answer/id #uuid \"ef95aff5-684b-5c44-a469-4992d8d21f21\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678919} {:answer/id #uuid \"f35308e5-3221-5584-b8d3-417ea6e72ec4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678923}] :answer-field/correct {:answer/id #uuid \"f35308e5-3221-5584-b8d3-417ea6e72ec4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678923} :answer-field/id #uuid \"3cda87fb-b814-599d-b3c5-168ab16064eb\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678805}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"8942af7f-2778-5a92-adfe-c592fa9b1dc8\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6e3a7273-7cff-55ae-85af-733b12ff2f1a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186678834} {:answer/id #uuid \"75e2aae8-994e-53c6-8ed0-11dbd406f441\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186678841} {:answer/id #uuid \"a69bc09e-3024-5a2e-a39c-d54a069854d5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678872} {:answer/id #uuid \"ca191c18-3a3f-5582-bbc8-8eeab8516ccf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186678899} {:answer/id #uuid \"cd7d9498-dfd6-5c08-b1d7-e32a9db8ebe4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\arctan{\\\\left(2 x \\\\right)}+C\" :db/id 17592186678901}] :answer-field/correct {:answer/id #uuid \"6e3a7273-7cff-55ae-85af-733b12ff2f1a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186678834} :answer-field/id #uuid \"50febb24-d674-5ebb-9fba-764db720a20e\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678815}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"8cb9ae74-785b-5945-9fad-c291fd0cc3e9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 4=4\\\\left(1+(2 x)^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2d2cd18e-7191-5123-a5d2-2795d61febdc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678794} {:answer/id #uuid \"4acac8ec-6bff-513a-ab38-2972f328f5cd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678810} {:answer/id #uuid \"541cb1bf-afc8-5e47-94df-074ea9abb7e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678818} {:answer/id #uuid \"6e0a2526-158a-5a12-b2e4-3abc185acee0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678833} {:answer/id #uuid \"90d729f2-0cf2-53ee-bea3-7cd80ba13e3e\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678861}] :answer-field/correct {:answer/id #uuid \"4acac8ec-6bff-513a-ab38-2972f328f5cd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678810} :answer-field/id #uuid \"40f1d41e-6886-51cd-bfdc-1c92167dec8c\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678806}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"9996cb56-8bad-5f76-a15b-2ab32e8ff4a6\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"136b8547-68d2-5b6e-98d0-8e42188a6159\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678780} {:answer/id #uuid \"5685248d-fd97-5cd4-9e89-fc782d03f59a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678820} {:answer/id #uuid \"755c98a9-b985-5e1c-a002-b4af7a088984\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678839} {:answer/id #uuid \"7ee84d70-506d-5e27-90e8-4fd93e6c9033\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186678849} {:answer/id #uuid \"83d9fbe0-421e-5aac-b9eb-c57d2956a84d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678853}] :answer-field/correct {:answer/id #uuid \"755c98a9-b985-5e1c-a002-b4af7a088984\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678839} :answer-field/id #uuid \"2594effe-021e-55f3-a72f-333ef6c7c492\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678788}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a8629d5d-1e6e-54c2-aed2-982e5ac05452\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n9 x^{2} + 4=4\\\\left(1+(\\\\frac{3 x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{9 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"21fceb15-fb08-5014-b855-f61d5649e263\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678786} {:answer/id #uuid \"4eba47d0-4f61-533e-907e-c22de74c465a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678814} {:answer/id #uuid \"aa931078-fea9-5b2e-bcf5-e61508754df8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678876} {:answer/id #uuid \"d244f049-72cb-5a30-93a5-35dba62ed212\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678903} {:answer/id #uuid \"eef61d63-a43b-5994-9256-12c87331a530\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678918}] :answer-field/correct {:answer/id #uuid \"d244f049-72cb-5a30-93a5-35dba62ed212\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678903} :answer-field/id #uuid \"2fe03f5e-01d8-5558-8677-77f00483d1af\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678798}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b2f10f84-d7cc-5ef8-ab4f-8a0ed6f46f39\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{4 x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n4 x^{2} + 9=9\\\\left(1+(\\\\frac{2 x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{9}\\\\cdot \\\\frac{3}{2}=\\\\frac{1}{6}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{4 x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{6}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2aabb0c6-5e36-5f76-b52d-16a2abea4945\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678792} {:answer/id #uuid \"5f3a3f93-2c72-518a-bb88-c40518977824\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678825} {:answer/id #uuid \"a4a34dbe-5240-59f2-a611-64718c27c154\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678871} {:answer/id #uuid \"b337a466-c02b-5dc3-9162-c8648ae6259d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678884} {:answer/id #uuid \"bf3d84b8-da9b-5c45-8179-6bfd3ceba388\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\" :db/id 17592186678892}] :answer-field/correct {:answer/id #uuid \"5f3a3f93-2c72-518a-bb88-c40518977824\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678825} :answer-field/id #uuid \"97861162-0ade-5d95-9321-1da2721ad612\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678864}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b9b34dc1-da3d-542d-81f6-69e4f127f4cf\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6a77e68b-7b95-548b-887e-5813c7432a95\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678832} {:answer/id #uuid \"84962d44-a30d-508c-ac7e-3c596fea82d7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678855} {:answer/id #uuid \"ae7e7654-34b0-5c4c-8fec-319230ba48c9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678879} {:answer/id #uuid \"d5fb4d70-9003-5532-81ee-c8894132de5f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678905} {:answer/id #uuid \"f964ae08-3936-5e96-a5d9-bdd196cf32b7\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678929}] :answer-field/correct {:answer/id #uuid \"ae7e7654-34b0-5c4c-8fec-319230ba48c9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\" :db/id 17592186678879} :answer-field/id #uuid \"98428769-6168-527b-8381-c92b8ae7dbc9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678866}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"d724029a-f29d-53a5-9193-1e3742bd1461\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 16=16\\\\left(1+(\\\\frac{x}{4})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{16}\\\\cdot 4=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{x^{2} + 16}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"08adab42-ca20-51ee-87ab-e7f51cbe0cb0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678772} {:answer/id #uuid \"39921fc7-b8b9-548d-b06d-77f4211d3002\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678801} {:answer/id #uuid \"5f2d2d1e-385b-5d13-920a-d5cb7b2a01e0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678824} {:answer/id #uuid \"b298230a-1049-5d41-8f2e-94d615b198cf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678882} {:answer/id #uuid \"eecabed7-b925-57d6-af70-0bdc320abf88\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678917}] :answer-field/correct {:answer/id #uuid \"b298230a-1049-5d41-8f2e-94d615b198cf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678882} :answer-field/id #uuid \"79c8e0c4-8a29-5ee2-b296-0998fb723697\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678843}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"d9cf8597-7b44-591c-a8b6-d4ed51115f19\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 9=9\\\\left(1+(\\\\frac{x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{9}\\\\cdot 3=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7a4d0810-6cf3-56d0-9772-7eac212bf316\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678845} {:answer/id #uuid \"7d8ccf6e-59b0-59c9-86a5-597544afbd0d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678847} {:answer/id #uuid \"9f43b749-be72-57e5-b073-b15a36dba311\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678869} {:answer/id #uuid \"bfd1e3af-c14a-5c16-8680-bd22de9b6b19\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678893} {:answer/id #uuid \"d7491f01-532b-56f0-afbb-c29db8b366d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678907}] :answer-field/correct {:answer/id #uuid \"bfd1e3af-c14a-5c16-8680-bd22de9b6b19\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\" :db/id 17592186678893} :answer-field/id #uuid \"c05e2926-a3df-564c-9a81-3198a5fa9d12\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678894}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e30a0122-aed9-523f-9764-d1adfe496a5c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 9=9\\\\left(1+(\\\\frac{x}{3})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{9}\\\\cdot 3=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{x^{2} + 9}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2ef3a502-7f3b-5c57-9d7d-899b69c174c6\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678797} {:answer/id #uuid \"38381c6a-cc32-5e80-a57a-8aa141d23b66\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678800} {:answer/id #uuid \"615b28c0-70df-5553-9719-f4708f433236\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678826} {:answer/id #uuid \"d3b094e3-12c1-5c4e-acc3-ade73d648c56\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678904} {:answer/id #uuid \"fbae1f76-4d79-554d-8607-4733c05b1131\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678931}] :answer-field/correct {:answer/id #uuid \"fbae1f76-4d79-554d-8607-4733c05b1131\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186678931} :answer-field/id #uuid \"b549f067-9eab-535e-aca0-94511e920aed\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678885}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f2f4ede1-9811-5924-85a4-605fbf1587ed\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\nx^{2} + 4=4\\\\left(1+(\\\\frac{x}{2})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 2=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arctan{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5c7bca56-9a08-5580-b2a4-8be3e3b46efa\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678821} {:answer/id #uuid \"73f3739b-76b6-59a6-98c9-782d03342c20\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678838} {:answer/id #uuid \"a863748c-b7b0-57ed-a2d1-c4768c32c9f8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{10}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678874} {:answer/id #uuid \"d117ff90-57d3-57f3-869b-729814a6f15b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678902} {:answer/id #uuid \"e5ff479f-2bb2-5c6c-a7fc-d8d302a1d75f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678915}] :answer-field/correct {:answer/id #uuid \"73f3739b-76b6-59a6-98c9-782d03342c20\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\" :db/id 17592186678838} :answer-field/id #uuid \"47d58c50-ff4c-5c8f-9b31-f8bad55f8586\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678807}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f306ac68-3e8c-583f-a48d-a0b0b92cf68c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 25}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 25=25\\\\left(1+(\\\\frac{4 x}{5})^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{25}\\\\cdot \\\\frac{5}{4}=\\\\frac{3}{20}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 25}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{20}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{20}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{20}\\\\left(\\\\arctan{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"009d461a-81e5-5c4a-86e8-1eceababd226\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186678768} {:answer/id #uuid \"092dac53-237b-5993-baba-06ba8ada9a90\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186678773} {:answer/id #uuid \"10c3a494-71aa-57fe-8314-41bc180eb4fe\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186678777} {:answer/id #uuid \"f01d2378-9329-53d6-b7fa-65d1738f5493\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186678920} {:answer/id #uuid \"fecdcaff-afc5-5810-9931-130cb914f585\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186678935}] :answer-field/correct {:answer/id #uuid \"009d461a-81e5-5c4a-86e8-1eceababd226\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186678768} :answer-field/id #uuid \"816313fa-5f98-5c3a-828a-9f848e85539b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678852}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f681176b-4e5e-5148-be04-c5b9ef998f7b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n16 x^{2} + 4=4\\\\left(1+(2 x)^2\\\\right).\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{4}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{8}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{16 x^{2} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{8}\\\\left(\\\\arctan{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186678928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0cefdbf3-dbd9-5c95-a620-ed88f7ed699b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678776} {:answer/id #uuid \"66d28bce-2980-59ab-b44a-8b1458a31a0f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678828} {:answer/id #uuid \"988256fe-0609-594e-b87a-07b9f5fb6a43\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678867} {:answer/id #uuid \"c7d76108-afcf-5dd0-8d88-dae3556362a8\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678898} {:answer/id #uuid \"fe8ab63a-c653-5147-93a5-f4208670ee71\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\" :db/id 17592186678934}] :answer-field/correct {:answer/id #uuid \"fe8ab63a-c653-5147-93a5-f4208670ee71\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\" :db/id 17592186678934} :answer-field/id #uuid \"25bb5d92-55da-5bcb-b75a-f826a1e44b57\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678789}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"f8143c84-2a00-5282-9ca3-f2bfa106b4d0\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\n$$\"}] :knowledge-point/title \"Calculating Indefinite Integrals Using Substitution with Inverse Tangent\"}",
