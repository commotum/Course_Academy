|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"006b058a-8757-53b5-9e86-166b3bad3f57\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{4}+C\" :db/id 17592186676873} {:answer/id #uuid \"31a5ba68-5ac7-536c-8c41-f1a5e3abe4fd\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186676907} {:answer/id #uuid \"7f880d5c-a5a7-5504-b0fb-6f1cc67b05ee\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(16 x \\\\right)}+C\" :db/id 17592186676957} {:answer/id #uuid \"cf8e4da3-3b7a-5c40-80b9-cdaba7d45e44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{16}+C\" :db/id 17592186677010} {:answer/id #uuid \"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186677012}] :answer-field/correct {:answer/id #uuid \"d02f031d-3d68-5f84-adca-189e93f397fa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186677012} :answer-field/id #uuid \"74bbe62f-70cb-5fd0-962c-4bb2778265f0\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676945}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"76457b92-955f-57c1-a7b4-2de23b67fcb9\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{4}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{4}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 4(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"142408c4-a856-5ba3-9cb3-fdd989d60438\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186676886} {:answer/id #uuid \"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186676892} {:answer/id #uuid \"4b039ee6-7d56-5a1f-923a-48cd9541fb4e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186676923} {:answer/id #uuid \"c69ee190-e333-5892-a21c-1640d2670d8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}}{3}+C\" :db/id 17592186677006} {:answer/id #uuid \"e88d8113-27e3-54e9-aa5a-f4c0374e5bd7\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\" :db/id 17592186677024}] :answer-field/correct {:answer/id #uuid \"1d9079dc-e0e9-5883-9ee0-be4e84800886\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186676892} :answer-field/id #uuid \"e0a36f36-3cca-5caf-af0f-d26099a43110\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677016}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"84c7e966-96b7-5e2c-ab4c-0d93d8c57026\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=3 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|3 x|=3|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{3}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{3}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|3 x|\\\\sqrt{(3 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{3})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 3 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 3 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|3 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"30aa92c4-ebd0-55bf-9c66-85ea2a24fa20\" :answer/type {:db/ident :answer.type/math} :answer/value \"13 \\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\" :db/id 17592186676906} {:answer/id #uuid \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\" :db/id 17592186676914} {:answer/id #uuid \"50b95fae-4e0c-584b-8066-dbac126da0ec\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(169 x \\\\right)}+C\" :db/id 17592186676925} {:answer/id #uuid \"c47a4090-08a3-5435-9bb8-44f2b4199fd6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}}{169}+C\" :db/id 17592186677003} {:answer/id #uuid \"e6780705-5037-5ae0-94fe-1022c619a279\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}}{13}+C\" :db/id 17592186677021}] :answer-field/correct {:answer/id #uuid \"3a65b91e-5c21-5e2c-b3c6-a218b18b9bad\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\" :db/id 17592186676914} :answer-field/id #uuid \"e99fdc4d-6ccd-5f2c-9678-d7a78417090f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677025}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"8bc2e902-71e9-5912-9706-6f6dd6006240\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{13}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=13 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=13,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{13})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|13 x|=13|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{13}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{13}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 13\\\\int \\\\frac{1}{|13 x|\\\\sqrt{(13 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 13(\\\\frac{1}{13})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(13 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|13 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0f28e42b-8620-5ae1-8f04-805f88867c6c\" :answer/type {:db/ident :answer.type/math} :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676881} {:answer/id #uuid \"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676897} {:answer/id #uuid \"75d06d6f-6fe5-5d6f-9007-78758ffc948c\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\" :db/id 17592186676947} {:answer/id #uuid \"bc16c7b4-f2db-5f7c-a2ff-83546ce380d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676998} {:answer/id #uuid \"f3779970-0bfa-5296-b548-2b234032333d\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186677031}] :answer-field/correct {:answer/id #uuid \"228bf48b-6c00-5de6-bd83-cd4703885c3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676897} :answer-field/id #uuid \"77b14ff6-ee23-5c1a-82b3-746ee344c414\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676950}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8ec467ed-a842-5743-90ea-dc3e43a5c825\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|2 x|=2|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{2}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{2})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|2 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4062c6f4-8073-59e2-8572-082fb67e86cd\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186676918} {:answer/id #uuid \"54a15aad-5ed5-5e4d-ba7e-1c0422c019cd\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\sqrt{3} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\" :db/id 17592186676929} {:answer/id #uuid \"95e14540-a907-57a9-af56-5c13e9653546\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\sqrt{3} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\" :db/id 17592186676970} {:answer/id #uuid \"d6b5ffaf-8545-5b67-a43e-b06901fddd7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\" :db/id 17592186677014} {:answer/id #uuid \"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\" :db/id 17592186677027}] :answer-field/correct {:answer/id #uuid \"f03be629-e361-57e1-aa79-d89c4c2e71ea\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\" :db/id 17592186677027} :answer-field/id #uuid \"7c2ce00a-b685-5520-b2c9-cc2b514b71f2\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676953}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"9109a0e2-f715-5496-8bcd-2bf0c487318b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|x|\\\\sqrt{3 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{3} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{3},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{3}}{3})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{3} x|=\\\\sqrt{3}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{3}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|x|\\\\sqrt{3 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{3}\\\\int \\\\frac{1}{|\\\\sqrt{3} x|\\\\sqrt{(\\\\sqrt{3} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{3}(\\\\frac{\\\\sqrt{3}}{3})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{3} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{3} x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"13b0f660-67ce-59a2-9cf2-d36d0c375fff\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}}{100}+C\" :db/id 17592186676885} {:answer/id #uuid \"1d12d78c-c5a9-5229-adea-c3244ab0d11f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}}{10}+C\" :db/id 17592186676890} {:answer/id #uuid \"35f9913b-fc0f-5a49-9eda-f6cec6430dcd\" :answer/type {:db/ident :answer.type/math} :answer/value \"10 \\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\" :db/id 17592186676911} {:answer/id #uuid \"361c11c2-2fa8-565f-b175-a7e910e759d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(100 x \\\\right)}+C\" :db/id 17592186676912} {:answer/id #uuid \"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\" :db/id 17592186676985}] :answer-field/correct {:answer/id #uuid \"ac14cc1a-0019-5315-94d9-d5219638bc74\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\" :db/id 17592186676985} :answer-field/id #uuid \"d2cf0d9b-76d2-51ef-8dd1-3354fdaf72b5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677013}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"97af9687-66c6-579d-97d7-01feb5f40f72\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{10}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=10 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=10,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{10})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|10 x|=10|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{10}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{10}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 10\\\\int \\\\frac{1}{|10 x|\\\\sqrt{(10 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 10(\\\\frac{1}{10})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|10 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/type {:db/ident :answer.type/math} :answer/value \"7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186676874} {:answer/id #uuid \"26615563-e530-5544-b9f7-a24d5d7c3520\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{16}+C\" :db/id 17592186676898} {:answer/id #uuid \"87ac9755-9f76-571a-b175-02e2902b7b30\" :answer/type {:db/ident :answer.type/math} :answer/value \"28 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186676962} {:answer/id #uuid \"90251f4c-b8bc-5104-8144-8db40d11f9fe\" :answer/type {:db/ident :answer.type/math} :answer/value \"7 \\\\operatorname{arcsec}{\\\\left(16 x \\\\right)}+C\" :db/id 17592186676966} {:answer/id #uuid \"b18c1e92-4fd6-59c3-8c51-39c8501f69d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{4}+C\" :db/id 17592186676989}] :answer-field/correct {:answer/id #uuid \"0126e7ef-2ec7-5d7f-a8d7-582407009616\" :answer/type {:db/ident :answer.type/math} :answer/value \"7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186676874} :answer-field/id #uuid \"3e68b545-b7d2-58c5-8c66-984cc938eb0b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676916}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"9b337ff1-b6e2-5702-be8d-d982b1477cdc\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{7}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{7}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 28\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 28(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 7\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 7 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 7 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\" :db/id 17592186676919} {:answer/id #uuid \"5c828979-a664-5348-8e96-bb972e22d4d4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{42}+C\" :db/id 17592186676935} {:answer/id #uuid \"7be11b07-f96b-5a92-bd34-ccb6ddcb37ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\" :db/id 17592186676952} {:answer/id #uuid \"801ef18d-69aa-5378-b58a-91d4d3f3528c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{294}+C\" :db/id 17592186676958} {:answer/id #uuid \"f3049055-8ee7-5042-830b-a03fcd46e4c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(49 x \\\\right)}}{6}+C\" :db/id 17592186677030}] :answer-field/correct {:answer/id #uuid \"42e651b5-5ee7-5e53-9e60-c92338128ff0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\" :db/id 17592186676919} :answer-field/id #uuid \"9c355901-1679-5d66-ba00-1c7d5b2850b1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676974}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a1e5824f-e979-5164-8706-b0c5bb4e54bf\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{6|x|\\\\sqrt{49 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{6|x|\\\\sqrt{49 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{6}\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= \\\\frac{7}{6}(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{6}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{6}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{6}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\" :db/id 17592186676877} {:answer/id #uuid \"5c8f252f-19a7-51d6-bf28-81657f02c35f\" :answer/type {:db/ident :answer.type/math} :answer/value \"6 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\" :db/id 17592186676936} {:answer/id #uuid \"5dce131d-6dd3-5b85-9b63-176d037ffa33\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{6}+C\" :db/id 17592186676937} {:answer/id #uuid \"84724433-c0c0-532e-a461-3914e4459162\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{36}+C\" :db/id 17592186676959} {:answer/id #uuid \"b10591d8-d226-5f76-8227-953214d235b0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(36 x \\\\right)}+C\" :db/id 17592186676988}] :answer-field/correct {:answer/id #uuid \"0420b9b3-9028-5e27-bbba-45726475b49d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\" :db/id 17592186676877} :answer-field/id #uuid \"7f1fa66e-78d1-5a82-b8dc-d4104836048b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676955}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a30037a2-ab18-570c-bcd0-bd4c474b9e6f\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{6}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=6 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{6})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|6 x|=6|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{6}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{6}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 6\\\\int \\\\frac{1}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 6(\\\\frac{1}{6})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|6 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0208a87c-e72d-5553-95a3-88676b1900da\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{2}+C\" :db/id 17592186676875} {:answer/id #uuid \"20a8febd-4faa-5a89-a1b1-fc75ee1112f9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{4}+C\" :db/id 17592186676895} {:answer/id #uuid \"39669edf-52ed-591a-bc4f-05f46c11d86d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{8}+C\" :db/id 17592186676913} {:answer/id #uuid \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{2}+C\" :db/id 17592186676975} {:answer/id #uuid \"a63a8958-2bad-585b-b08f-b28fdffa096b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186676981}] :answer-field/correct {:answer/id #uuid \"a1ad18ec-e783-5a5d-ab40-fe59997cffab\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{2}+C\" :db/id 17592186676975} :answer-field/id #uuid \"95c1d718-179c-5ae2-9903-11398143c9ae\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676969}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a8e1e0d2-fc46-5618-9a39-5e6fdde9fc87\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{2|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=2 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|2 x|=2|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{2}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{2|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|2 x|\\\\sqrt{(2 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{2})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{2}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{2}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}}{2}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|2 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1e490206-6d56-5574-9453-0e68c12263f2\" :answer/type {:db/ident :answer.type/math} :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186676894} {:answer/id #uuid \"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186676904} {:answer/id #uuid \"59ce4e9f-cf5b-5371-8bdb-f1cbcc591855\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\" :db/id 17592186676934} {:answer/id #uuid \"9129a361-2e73-5adc-96c4-fa751e6d00a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}}{2}+C\" :db/id 17592186676968} {:answer/id #uuid \"c5017709-422a-585d-8e3d-c3340f483d10\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\operatorname{arctan}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186677004}] :answer-field/correct {:answer/id #uuid \"2e5efafe-ae73-5971-940e-1cb481b504a2\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\" :db/id 17592186676904} :answer-field/id #uuid \"f25faa23-2594-5f40-ab0a-2ecce21fbb68\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677028}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ad5586bd-92a8-50ea-bd0f-7fa1955e49e8\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=4 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|4 x|=4|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{4}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|4 x|\\\\sqrt{(4 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{4})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 2\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 2 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 2 \\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"792218b4-1e15-5c28-b955-ccc4600c533e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\" :db/id 17592186676951} {:answer/id #uuid \"a25ceb1a-ae7b-523e-8bb7-b1cce00f19ea\" :answer/type {:db/ident :answer.type/math} :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\" :db/id 17592186676978} {:answer/id #uuid \"a52357f1-a274-5f15-ace4-aa9303c50604\" :answer/type {:db/ident :answer.type/math} :answer/value \"5 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186676980} {:answer/id #uuid \"bb1874bf-30c9-586f-9061-209cdbe0411e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\" :db/id 17592186676996} {:answer/id #uuid \"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/type {:db/ident :answer.type/math} :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186677017}] :answer-field/correct {:answer/id #uuid \"e2cd009b-8c17-5c70-87e8-7659d526c59f\" :answer/type {:db/ident :answer.type/math} :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186677017} :answer-field/id #uuid \"15f2c563-ad1d-5843-a270-e994aa71edcb\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676888}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"bbd7d173-e034-5432-834c-943bd6bc824e\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{7} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{7} x|=\\\\sqrt{7}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{7}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 5 \\\\sqrt{7}\\\\int \\\\frac{1}{|\\\\sqrt{7} x|\\\\sqrt{(\\\\sqrt{7} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 5 \\\\sqrt{7}(\\\\frac{\\\\sqrt{7}}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{7} x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186677001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1e3c92a4-a7da-51b0-8625-d966303b5bd9\" :answer/type {:db/ident :answer.type/math} :answer/value \"20 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\" :db/id 17592186676893} {:answer/id #uuid \"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\" :db/id 17592186676994} {:answer/id #uuid \"c566ac9c-ddcc-5843-b570-313dfc0d0833\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}}{5}+C\" :db/id 17592186677005} {:answer/id #uuid \"e626e4b2-798b-511a-9112-b64176edcf02\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\" :db/id 17592186677019} {:answer/id #uuid \"fab2d188-b643-5b6e-a5ee-efa3c8f819df\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arctan}{\\\\left(5 x \\\\right)}+C\" :db/id 17592186677038}] :answer-field/correct {:answer/id #uuid \"ba9ea4eb-0793-5e14-bb35-81349da6a845\" :answer/type {:db/ident :answer.type/math} :answer/value \"4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\" :db/id 17592186676994} :answer-field/id #uuid \"d6e53eea-4a9c-579c-9473-40e52033ceba\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677015}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c2cb4fba-879b-5b01-9945-6bb60bed682b\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{20}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=5 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|5 x|=5|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{5}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{20}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 20\\\\int \\\\frac{1}{|5 x|\\\\sqrt{(5 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 20(\\\\frac{1}{5})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 4 \\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|5 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186677008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186676876} {:answer/id #uuid \"335a8d6a-b4ec-5193-a45f-51bf7646df64\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\" :db/id 17592186676908} {:answer/id #uuid \"6ec7ce1f-0eb4-59d3-a1a0-ac1e9f4398a9\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\sqrt{7} \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186676943} {:answer/id #uuid \"e645444e-55cd-5743-bd4c-ad58f4b945a5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}}{7}+C\" :db/id 17592186677020} {:answer/id #uuid \"f88a3601-88ce-58e0-8eaa-5fa3af7b4c28\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\" :db/id 17592186677034}] :answer-field/correct {:answer/id #uuid \"040ea9c9-e715-507d-902d-bb71351804ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\" :db/id 17592186676876} :answer-field/id #uuid \"e8606212-bc9b-52ae-8e0c-294774fd2b98\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677023}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"c8193b88-2105-5bfe-b1c9-66d6db09c1f6\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=\\\\sqrt{7} x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\sqrt{7},\\\\qquad \\\\mathrm{d}x=(\\\\frac{\\\\sqrt{7}}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|\\\\sqrt{7} x|=\\\\sqrt{7}|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{\\\\sqrt{7}}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|x|\\\\sqrt{7 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{7}\\\\int \\\\frac{1}{|\\\\sqrt{7} x|\\\\sqrt{(\\\\sqrt{7} x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9 \\\\sqrt{7}(\\\\frac{\\\\sqrt{7}}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 9 \\\\operatorname{arcsec}{\\\\left(\\\\sqrt{7} x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|\\\\sqrt{7} x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186677022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\" :db/id 17592186676899} {:answer/id #uuid \"2cfb56c8-c193-500d-8069-1875caf5cdec\" :answer/type {:db/ident :answer.type/math} :answer/value \"8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\" :db/id 17592186676902} {:answer/id #uuid \"a2305993-b75e-568a-b17f-56fd24469b05\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{7}+C\" :db/id 17592186676977} {:answer/id #uuid \"b05682a8-ee96-5382-b3bc-5a9f5f4c3460\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{49}+C\" :db/id 17592186676987} {:answer/id #uuid \"cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{7}+C\" :db/id 17592186677011}] :answer-field/correct {:answer/id #uuid \"26f6ae5e-13b1-5d98-ad21-85c5db855690\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\" :db/id 17592186676899} :answer-field/id #uuid \"71ec24ab-1b85-5c39-bff9-ac067e868069\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676944}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e7dddafc-acd5-5fc7-9ee2-2276b6e756b8\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{8}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=7 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=7,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{7})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|7 x|=7|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{7}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{8}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8\\\\int \\\\frac{1}{|7 x|\\\\sqrt{(7 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 8(\\\\frac{1}{7})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8}{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{7}+C \\\\\\\\  &= \\\\frac{8 \\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}}{7}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186677040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\" :db/id 17592186676882} {:answer/id #uuid \"4834c340-bc67-5aa0-8c75-aeeabb21803e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}}{15}+C\" :db/id 17592186676921} {:answer/id #uuid \"7f47e282-f70d-54a9-bb2f-de9b835c81b6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}}{225}+C\" :db/id 17592186676956} {:answer/id #uuid \"860f1311-ba28-51b2-8a6b-3ee81d4d44ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"15 \\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\" :db/id 17592186676961} {:answer/id #uuid \"c0dca4bf-534c-5c1e-9ec4-fff63a26e7ff\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(225 x \\\\right)}+C\" :db/id 17592186677000}] :answer-field/correct {:answer/id #uuid \"1073775f-1bbc-52ab-8c7e-572379bc0994\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\" :db/id 17592186676882} :answer-field/id #uuid \"33d2c788-e730-5daf-8cfa-322e2c30fcdb\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676909}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"feb12510-c969-520b-8bb7-8c2c49a14e5f\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{15}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=15 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=15,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{15})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|15 x|=15|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{15}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{15}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 15\\\\int \\\\frac{1}{|15 x|\\\\sqrt{(15 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 15(\\\\frac{1}{15})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(15 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|15 x|>1$; the constant may differ between those intervals.\"}] :knowledge-point/title \"Calculating Indefinite Integrals Using Substitution with Inverse Secant\"}",
