  "before_edn": "{:db/id 17592186064250 :knowledge-point/canonical-example {:db/id 17592186064101 :question/id #uuid \"56860611-869d-5035-bf8f-f568c774d78d\" :question/math-academy-id \"e-5014\" :question/problem \"$$\\n\\\\displaystyle {\\\\displaystyle \\\\int \\\\dfrac{5\\\\, \\\\textrm{d}x}{|5x|\\\\sqrt{(5x)^2-1}}  = }\\n$$\" :question/worked-solution \"This resembles the basic integral for $\\\\textrm{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^2-1}} \\\\textrm{d}u = \\\\textrm{arcsec}(u)+C.\\n$$\\n\\nLet $u = 5x.$ Then\\n\\n$$\\n\\\\dfrac{\\\\textrm{d}u}{\\\\textrm{d}x}=5\\n\\\\quad\\\\Longrightarrow\\\\quad\\n5\\\\,\\\\textrm{d}x = \\\\textrm{d}u.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{5\\\\,\\\\text{d}x}{|5x|\\\\sqrt{(5x)^{2}-1}} & =\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec}(u)+C \\\\\\\\  & =\\\\text{arcsec}(5x)+C.\\\\end{aligned}\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"8d18bdc7-9387-5b2d-98bd-015fa4a1eba7\" :knowledge-point/question-generator {:db/id 17592186677041 :question-generator/id #uuid \"7ff11018-92f2-5ce1-bd0a-135534338d0e\" :question-generator/script \"generators/8a/8a0c90144a6646880afd310214594dfeb8ddcf955e4d1aa7a69b728cc305a94f/generator.py\"} :knowledge-point/questions [{:db/id 17592186064941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"33cf2d14-d04d-51e3-b76e-64b8e1a665b6\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\text{arcsec}(8x)+C\" :db/id 17592186333465} {:answer/id #uuid \"3dc9dd34-b284-58b6-84db-345e4e630da9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(64x)+C\" :db/id 17592186333571} {:answer/id #uuid \"8f11fd04-9fa8-5d58-b9c9-6ab52adba008\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(8x)+C\" :db/id 17592186334264} {:answer/id #uuid \"d2244dec-f6d2-5e94-8b71-32f7eabc6720\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(8x)}{8}+C\" :db/id 17592186334825} {:answer/id #uuid \"d66dc866-442a-59b0-ad6e-365d928672f6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186334866}] :answer-field/correct {:answer/id #uuid \"8f11fd04-9fa8-5d58-b9c9-6ab52adba008\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(8x)+C\" :db/id 17592186334264} :answer-field/id #uuid \"ae92fcf7-e93b-597c-a9c2-a8feb16ae56b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186335558}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1c758c6a-6697-5dfb-b64a-bc653c6c226b\" :question/math-academy-id \"q-69476\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{8\\\\,\\\\text{d}x}{|8x|\\\\sqrt{(8x)^{2}-1}}=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{8\\\\,\\\\text{d}x}{|8x|\\\\sqrt{(8x)^{2}-1}}=8\\\\int \\\\frac{\\\\text{d}x}{|8x|\\\\sqrt{(8x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $8x.$\\n\\nSo, let's substitute $u=8x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=8\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{8}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}8\\\\int \\\\frac{1}{|8x|\\\\sqrt{(8x)^{2}-1}}\\\\text{d}x & =8\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{8}\\\\text{d}u) \\\\\\\\  & =\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(8x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186064952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"17153736-08a5-511b-8d66-3076de3a56f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186339331} {:answer/id #uuid \"287af432-ac1d-5bb0-9cce-df095ab56481\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(2x)}{4}+C\" :db/id 17592186339481} {:answer/id #uuid \"3031610e-8402-5eae-b837-b04a952ccb28\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186339548} {:answer/id #uuid \"741561ed-033d-5aff-8ad7-766c99be57a0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186340158} {:answer/id #uuid \"c8a5cb98-9b11-5ca7-8b96-437d604616ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(2x)}{2}+C\" :db/id 17592186340906}] :answer-field/correct {:answer/id #uuid \"3031610e-8402-5eae-b837-b04a952ccb28\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186339548} :answer-field/id #uuid \"79900759-4114-5519-b212-5c813256836c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341594}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a6fafd98-c438-5a64-a87a-7a2d0a58fd7e\" :question/math-academy-id \"q-73717\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{2}{|x|\\\\sqrt{4{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{2\\\\,\\\\text{d}x}{|x|\\\\sqrt{4{x}^{2}-1}}=4\\\\int \\\\frac{\\\\text{d}x}{|2x|\\\\sqrt{(2x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $2x.$\\n\\nSo, let's substitute $u=2x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{2}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{2}{|x|\\\\sqrt{4{x}^{2}-1}}\\\\,\\\\text{d}x & =4\\\\int \\\\frac{1}{|2x|\\\\sqrt{(2x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =4\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{2}\\\\text{d}u) \\\\\\\\  & =2\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =2\\\\,\\\\text{arcsec}\\\\,u+C \\\\\\\\  & =2\\\\,\\\\text{arcsec}(2x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2557c8c9-61d4-546a-b12e-2149e3cb0784\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186247753} {:answer/id #uuid \"4b9ffc95-a0ae-5868-bc4f-b4a2ff82ae20\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186248100} {:answer/id #uuid \"90d77fc7-cc8f-513f-84a7-ae393b51759b\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(5x)+C\" :db/id 17592186248710} {:answer/id #uuid \"da3de159-0af1-5109-a432-7a259afa945f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{5}\\\\,\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186249353} {:answer/id #uuid \"f5ce8cb5-8424-5bdb-b48e-afc1856f992f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(5x)+C\" :db/id 17592186249568}] :answer-field/correct {:answer/id #uuid \"2557c8c9-61d4-546a-b12e-2149e3cb0784\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186247753} :answer-field/id #uuid \"5bb9394d-1677-5845-bcf1-c7fd75b784b5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249835}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"721577ab-4fa8-5463-8c74-5d6cebd1decf\" :question/math-academy-id \"q-114051\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{|x|\\\\sqrt{5{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{|x|\\\\sqrt{5{x}^{2}-1}}=\\\\int \\\\frac{\\\\sqrt{5}}{|\\\\sqrt{5}x|\\\\sqrt{(\\\\sqrt{5}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{5}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{5}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{5}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{5}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{|x|\\\\sqrt{5{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{\\\\sqrt{5}}{|\\\\sqrt{5}x|\\\\sqrt{(\\\\sqrt{5}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\sqrt{5}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{5}}\\\\text{d}u) \\\\\\\\  & =\\\\sqrt{5}\\\\cdot \\\\frac{1}{\\\\sqrt{5}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(\\\\sqrt{5}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4d1c680b-da3e-532e-b768-23a73eed1830\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248115} {:answer/id #uuid \"76b64e00-cc9d-56bb-96a5-6ed308000d0f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}\\\\left(\\\\frac{x}{\\\\sqrt{2}}\\\\right)+C\" :db/id 17592186248469} {:answer/id #uuid \"81a2d087-34bd-5b98-b3f9-540414b7de9a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{2}x)+C\" :db/id 17592186248571} {:answer/id #uuid \"a16a9266-9795-55dc-8015-252092435b4f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\,\\\\text{arcsec}(\\\\sqrt{2}x)+C\" :db/id 17592186248867} {:answer/id #uuid \"f738a875-32bb-5a84-9c85-9b96cb51105b\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\text{arcsec}(\\\\sqrt{2}x)+C\" :db/id 17592186249583}] :answer-field/correct {:answer/id #uuid \"81a2d087-34bd-5b98-b3f9-540414b7de9a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{2}x)+C\" :db/id 17592186248571} :answer-field/id #uuid \"1add6643-9b56-5600-a0e9-cb809f1a9078\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249716}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"087bd91d-1f6c-594e-8ca6-46ed6f38b1d4\" :question/math-academy-id \"q-114052\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{|x|\\\\sqrt{2{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{|x|\\\\sqrt{2{x}^{2}-1}}=\\\\int \\\\frac{\\\\sqrt{2}}{|\\\\sqrt{2}x|\\\\sqrt{(\\\\sqrt{2}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{2}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{2}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{2}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{2}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{|x|\\\\sqrt{2{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{\\\\sqrt{2}}{|\\\\sqrt{2}x|\\\\sqrt{(\\\\sqrt{2}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\sqrt{2}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{2}}\\\\text{d}u) \\\\\\\\  & =\\\\sqrt{2}\\\\cdot \\\\frac{1}{\\\\sqrt{2}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(\\\\sqrt{2}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"30f7223b-3eec-5940-8deb-7bc6e19cac0d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}\\\\left(\\\\frac{x}{\\\\sqrt{3}}\\\\right)+C\" :db/id 17592186247868} {:answer/id #uuid \"3d76b2e3-b64f-5ff7-9e80-9f8479c9c899\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{3}x)+C\" :db/id 17592186247967} {:answer/id #uuid \"9bd42595-09d2-528a-bd27-8cbc87ecbf1d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}\\\\text{arcsec}(x)+C\" :db/id 17592186248810} {:answer/id #uuid \"def281e2-ae26-5545-95a5-a8332aa49347\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(3x)+C\" :db/id 17592186249402} {:answer/id #uuid \"f9f3a636-5c31-5b0d-9342-5cf8e8d5dd79\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186249601}] :answer-field/correct {:answer/id #uuid \"3d76b2e3-b64f-5ff7-9e80-9f8479c9c899\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{3}x)+C\" :db/id 17592186247967} :answer-field/id #uuid \"ad6f5e31-fa19-5c0b-8277-0506de476581\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249977}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"c9656774-7502-5500-b821-e655b8cd94a0\" :question/math-academy-id \"q-114053\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{|x|\\\\sqrt{3{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{|x|\\\\sqrt{3{x}^{2}-1}}=\\\\int \\\\frac{\\\\sqrt{3}}{|\\\\sqrt{3}x|\\\\sqrt{(\\\\sqrt{3}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{3}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{3}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{3}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{3}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{|x|\\\\sqrt{3{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{\\\\sqrt{3}}{|\\\\sqrt{3}x|\\\\sqrt{(\\\\sqrt{3}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\sqrt{3}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{3}}\\\\text{d}u) \\\\\\\\  & =\\\\sqrt{3}\\\\cdot \\\\frac{1}{\\\\sqrt{3}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(\\\\sqrt{3}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"00c4a36b-1ea2-5c73-8a8e-897727eb8f12\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{6}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186247419} {:answer/id #uuid \"1a99f5d4-adb5-558f-ab9d-871641a6895a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{6}x)+C\" :db/id 17592186247666} {:answer/id #uuid \"473a1c85-0e25-55e8-9960-af9d6576e38d\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\,\\\\text{arcsec}(\\\\sqrt{6}x)+C\" :db/id 17592186248058} {:answer/id #uuid \"612053c7-5fa5-581e-863a-77db7fe44da7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}\\\\left(\\\\frac{x}{\\\\sqrt{6}}\\\\right)+C\" :db/id 17592186248304} {:answer/id #uuid \"96a16219-09aa-5a3c-a6f7-b42ee02e1ec9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{6}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248763}] :answer-field/correct {:answer/id #uuid \"1a99f5d4-adb5-558f-ab9d-871641a6895a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{6}x)+C\" :db/id 17592186247666} :answer-field/id #uuid \"8b28b499-c249-529d-8a2e-50e60f8a5000\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249914}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"52263483-2d46-5846-98c2-2820b778b176\" :question/math-academy-id \"q-114054\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{|x|\\\\sqrt{6{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{|x|\\\\sqrt{6{x}^{2}-1}}=\\\\int \\\\frac{\\\\sqrt{6}}{|\\\\sqrt{6}x|\\\\sqrt{(\\\\sqrt{6}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{6}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{6}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{6}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{6}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{|x|\\\\sqrt{6{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{\\\\sqrt{6}}{|\\\\sqrt{6}x|\\\\sqrt{(\\\\sqrt{6}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\sqrt{6}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{6}}\\\\text{d}u) \\\\\\\\  & =\\\\sqrt{6}\\\\cdot \\\\frac{1}{\\\\sqrt{6}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(\\\\sqrt{6}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"345d0dd8-1722-50e6-996a-3145ed9fa4cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{7}x)+C\" :db/id 17592186247894} {:answer/id #uuid \"795dfd60-9293-54b9-a133-af67359f3625\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(7x)+C\" :db/id 17592186248490} {:answer/id #uuid \"a6deadf7-ef59-56ac-a86b-d7bdb56e7adc\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\sqrt{7}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248908} {:answer/id #uuid \"afa04312-a9ee-53e6-8294-76266301a3a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{7}}{7}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248999} {:answer/id #uuid \"d0c6dca0-cfeb-5ddf-b8cf-96bba1eee175\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\text{arcsec}(\\\\sqrt{7}x)+C\" :db/id 17592186249278}] :answer-field/correct {:answer/id #uuid \"d0c6dca0-cfeb-5ddf-b8cf-96bba1eee175\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\text{arcsec}(\\\\sqrt{7}x)+C\" :db/id 17592186249278} :answer-field/id #uuid \"ae56369a-9dc7-56a8-9b42-9abf878339d0\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249978}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"37dfb0c1-ed42-5302-8312-3364def8fc97\" :question/math-academy-id \"q-114055\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{7}{|x|\\\\sqrt{7{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{7}{|x|\\\\sqrt{7{x}^{2}-1}}\\\\text{d}x=\\\\int \\\\frac{7\\\\sqrt{7}}{|\\\\sqrt{7}x|\\\\sqrt{(\\\\sqrt{7}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{7}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{7}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{7}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{7}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{7}{|x|\\\\sqrt{7{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{7\\\\sqrt{7}}{|\\\\sqrt{7}x|\\\\sqrt{(\\\\sqrt{7}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =7\\\\sqrt{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{7}}\\\\text{d}u) \\\\\\\\  & =7\\\\sqrt{7}\\\\cdot \\\\frac{1}{\\\\sqrt{7}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =7\\\\,\\\\text{arcsec }u+C \\\\\\\\  & =7\\\\,\\\\text{arcsec}(\\\\sqrt{7}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"06349d8e-8391-574b-b6ee-d09717af159e\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\sqrt{8}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186247480} {:answer/id #uuid \"28b08c9d-77c7-5bea-8de3-24e47c4a6b22\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\text{arcsec}(\\\\sqrt{8}x)+C\" :db/id 17592186247786} {:answer/id #uuid \"4b4c8ae4-b8b1-5ed2-b232-73c90f37ed26\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{8}x)+C\" :db/id 17592186248097} {:answer/id #uuid \"97ffb8aa-ac92-5db2-a3d4-4a6b34576f59\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{8}}{8}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248778} {:answer/id #uuid \"b9b1dd01-2ffe-53eb-9456-1dfad676593b\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\text{arcsec}\\\\left(\\\\frac{x}{\\\\sqrt{8}}\\\\right)+C\" :db/id 17592186249084}] :answer-field/correct {:answer/id #uuid \"28b08c9d-77c7-5bea-8de3-24e47c4a6b22\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\text{arcsec}(\\\\sqrt{8}x)+C\" :db/id 17592186247786} :answer-field/id #uuid \"f124bfeb-924c-5974-b5d6-5bac9d8b7458\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186250090}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"d978df6a-8484-5ed1-885e-b4758185514d\" :question/math-academy-id \"q-114056\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{8}{|x|\\\\sqrt{8{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{8}{|x|\\\\sqrt{8{x}^{2}-1}}\\\\text{d}x=\\\\int \\\\frac{8\\\\sqrt{8}}{|\\\\sqrt{8}x|\\\\sqrt{(\\\\sqrt{8}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{8}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{8}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{8}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{8}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{8}{|x|\\\\sqrt{8{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{8\\\\sqrt{8}}{|\\\\sqrt{8}x|\\\\sqrt{(\\\\sqrt{8}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =8\\\\sqrt{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{8}}\\\\text{d}u) \\\\\\\\  & =8\\\\sqrt{8}\\\\cdot \\\\frac{1}{\\\\sqrt{8}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =8\\\\,\\\\text{arcsec }u+C \\\\\\\\  & =8\\\\,\\\\text{arcsec}(\\\\sqrt{8}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"20eeed43-06fc-5a51-a569-cc359295eeb2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(50x)+C\" :db/id 17592186247713} {:answer/id #uuid \"23a4faf6-7048-5692-877b-730a3aa48b44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(10x)+C\" :db/id 17592186247737} {:answer/id #uuid \"860a98b5-c89e-5a98-a319-70c942ace928\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\,\\\\text{arcsec}(10x)+C\" :db/id 17592186248619} {:answer/id #uuid \"c1ea824c-8f8e-5257-ae08-86f03dfd7210\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(10x)+C\" :db/id 17592186249149} {:answer/id #uuid \"d7024181-5209-53f4-9e77-1d70e6a37869\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186249324}] :answer-field/correct {:answer/id #uuid \"c1ea824c-8f8e-5257-ae08-86f03dfd7210\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(10x)+C\" :db/id 17592186249149} :answer-field/id #uuid \"1249c5e2-b95a-56a8-9562-7cfa27416496\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249702}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1386e5e4-c2d1-50fc-ab2e-40d086cf4081\" :question/math-academy-id \"q-114057\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{5}{|x|\\\\sqrt{100{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{100{x}^{2}-1}}\\\\text{d}x=\\\\int \\\\frac{50}{|10x|\\\\sqrt{(10x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $10x.$\\n\\nSo, let's substitute $u=10x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=10\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{10}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{5}{|x|\\\\sqrt{100{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{50}{|10x|\\\\sqrt{(10x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =50\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{10}\\\\text{d}u) \\\\\\\\  & =50\\\\cdot \\\\frac{1}{10}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =5\\\\,\\\\text{arcsec }u+C \\\\\\\\  & =5\\\\,\\\\text{arcsec}(10x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"26bff1d2-1a1f-5568-b606-c926ad4e222e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(4x)}{4}+C\" :db/id 17592186330288} {:answer/id #uuid \"38f382b6-b9e0-5d37-bb15-bf2017958200\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(4x)}{4}+C\" :db/id 17592186330460} {:answer/id #uuid \"88b1a168-dccc-5c24-aa5c-58eef11e4b53\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\text{arcsec}(4x)+C\" :db/id 17592186331165} {:answer/id #uuid \"8a671a08-acf6-51a4-a4b1-a79a1a8a1a19\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(16x)}{2}+C\" :db/id 17592186331179} {:answer/id #uuid \"c1c62bda-b0cb-5477-843f-9e7f08c270e5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186331672}] :answer-field/correct {:answer/id #uuid \"c1c62bda-b0cb-5477-843f-9e7f08c270e5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186331672} :answer-field/id #uuid \"2ed515ce-b125-59ef-ba87-1982f7680cc3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332279}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cd302e3c-b39d-509b-8801-010e64d93a57\" :question/math-academy-id \"q-49519\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{4|x|\\\\sqrt{16{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{4|x|\\\\sqrt{16{x}^{2}-1}}=\\\\int \\\\frac{\\\\text{d}x}{|4x|\\\\sqrt{(4x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $4x.$\\n\\nSo, let's substitute $u=4x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{4}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{4|x|\\\\sqrt{16{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{|4x|\\\\sqrt{(4x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{4}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{4}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(4x)}{4}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4b0edf81-9914-5a0f-b9b6-d58d70540093\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(x)}{3}+C\" :db/id 17592186330630} {:answer/id #uuid \"70cf07b2-a48c-5c20-b1ad-493648041c3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(9x)}{3}+C\" :db/id 17592186330962} {:answer/id #uuid \"9a56a3d4-f0db-5dee-8e1b-e1e7174dd979\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(3x)}{3}+C\" :db/id 17592186331338} {:answer/id #uuid \"a43c7a93-7056-56e0-adc4-8cc368c5eac5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(9x)}{3}+C\" :db/id 17592186331423} {:answer/id #uuid \"e8c453d1-3b22-5ee0-8261-9dc453f931aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(3x)}{3}+C\" :db/id 17592186331996}] :answer-field/correct {:answer/id #uuid \"e8c453d1-3b22-5ee0-8261-9dc453f931aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(3x)}{3}+C\" :db/id 17592186331996} :answer-field/id #uuid \"b3ccce72-f1f2-5395-8899-d57e02ead31c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332512}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"751e8889-464b-57e5-9446-01158bf809c1\" :question/math-academy-id \"q-49554\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{3|x|\\\\sqrt{9{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{3|x|\\\\sqrt{9{x}^{2}-1}}=\\\\int \\\\frac{\\\\text{d}x}{|3x|\\\\sqrt{(3x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $3x.$\\n\\nSo, let's substitute $u=3x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{3}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{3|x|\\\\sqrt{9{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{|3x|\\\\sqrt{(3x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{3}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{3}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{3}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(3x)}{3}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1afb9d8c-3f67-5355-93d6-a9093bad7dae\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(6x)}{6}+C\" :db/id 17592186330187} {:answer/id #uuid \"3226e3a9-ff07-580d-875b-1db26197856a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(36x)}{6}+C\" :db/id 17592186330391} {:answer/id #uuid \"d697edf8-7533-5458-807b-5604ad7429ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(6x)+C\" :db/id 17592186331847} {:answer/id #uuid \"d72cc629-030b-503a-b49e-63c0be8afa3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{6}+C\" :db/id 17592186331853} {:answer/id #uuid \"d885db49-c6b0-5c70-8dc4-c09546b4b009\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(36x)+C\" :db/id 17592186331870}] :answer-field/correct {:answer/id #uuid \"d72cc629-030b-503a-b49e-63c0be8afa3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{6}+C\" :db/id 17592186331853} :answer-field/id #uuid \"89604dd1-6f4e-5479-bb62-31a5924f3f5e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332441}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"8067bb84-25f1-5b9a-af1c-e522b42ac4cd\" :question/math-academy-id \"q-49555\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{6|x|\\\\sqrt{36{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{6|x|\\\\sqrt{36{x}^{2}-1}}=\\\\int \\\\frac{\\\\text{d}x}{|6x|\\\\sqrt{(6x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $6x.$\\n\\nSo, let's substitute $u=6x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=6\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{6}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{6|x|\\\\sqrt{36{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{|6x|\\\\sqrt{(6x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{6}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{6}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{6}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(6x)}{6}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186335976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4c842fc6-bdb7-5fd1-95ec-a8a6c5c213af\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(7x)+C\" :db/id 17592186333694} {:answer/id #uuid \"8817bce9-1d12-59f6-a5d1-e12cf7bf9ea0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(7x)}{7}+C\" :db/id 17592186334193} {:answer/id #uuid \"d4994be2-56ea-5429-8d7d-0f2980d19115\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(49x)}{7}+C\" :db/id 17592186334851} {:answer/id #uuid \"d5ef86d7-cffa-55cc-8343-9157ea5e011e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(7x)}{49}+C\" :db/id 17592186334864} {:answer/id #uuid \"eff32ea7-4fa2-5bab-91d2-777e88bff4bf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(49x)+C\" :db/id 17592186335089}] :answer-field/correct {:answer/id #uuid \"4c842fc6-bdb7-5fd1-95ec-a8a6c5c213af\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(7x)+C\" :db/id 17592186333694} :answer-field/id #uuid \"ebde86f4-5f82-5ab1-8866-0726b82f2be1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186335652}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1090f68a-a5e7-5187-bfa4-8579cbfba1e4\" :question/math-academy-id \"q-69475\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{7\\\\,\\\\text{d}x}{|7x|\\\\sqrt{(7x)^{2}-1}}=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{7\\\\,\\\\text{d}x}{|7x|\\\\sqrt{(7x)^{2}-1}}=7\\\\int \\\\frac{\\\\text{d}x}{|7x|\\\\sqrt{(7x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $7x.$\\n\\nSo, let's substitute $u=7x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=7\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{7}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}7\\\\int \\\\frac{1}{|7x|\\\\sqrt{(7x)^{2}-1}}\\\\text{d}x & =7\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{7}\\\\text{d}u) \\\\\\\\  & =\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(7x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186335977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"48ed7e88-42a3-5874-867c-a70eb196b8de\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(9x)+C\" :db/id 17592186333661} {:answer/id #uuid \"8bc52df5-2130-5724-8f9a-3900402db0a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(9x)}{3}+C\" :db/id 17592186334237} {:answer/id #uuid \"961ad6bb-bcc5-55c8-bf62-b1d0251abaec\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(9x)}{9}+C\" :db/id 17592186334325} {:answer/id #uuid \"d33c5bc0-c46c-505d-825e-d5fb312cca88\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(3x)}{81}+C\" :db/id 17592186334839} {:answer/id #uuid \"d9456840-7b87-506e-b8e7-b50a98cb1b55\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(3x)+C\" :db/id 17592186334895}] :answer-field/correct {:answer/id #uuid \"8bc52df5-2130-5724-8f9a-3900402db0a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(9x)}{3}+C\" :db/id 17592186334237} :answer-field/id #uuid \"2ae037e8-4b57-5061-96fb-95244295292c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186335317}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ea572027-5f6a-57b6-b534-919c7f5636f2\" :question/math-academy-id \"q-69477\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{3\\\\,\\\\text{d}x}{|9x|\\\\sqrt{(9x)^{2}-1}}=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{3\\\\,\\\\text{d}x}{|9x|\\\\sqrt{(9x)^{2}-1}}=3\\\\int \\\\frac{\\\\text{d}x}{|9x|\\\\sqrt{(9x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $9x.$\\n\\nSo, let's substitute $u=9x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=9\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{9}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}3\\\\int \\\\frac{1}{|9x|\\\\sqrt{(9x)^{2}-1}}\\\\text{d}x & =3\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{9}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{3}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{3}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(9x)}{3}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186342066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"12a76728-b839-5d06-89f1-9934eae3f027\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{6}+C\" :db/id 17592186339291} {:answer/id #uuid \"665fe7b3-58d5-51b3-a6e6-d098ccd5df2d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{36}+C\" :db/id 17592186340029} {:answer/id #uuid \"689ac8e4-68fd-56b3-a68a-d04dadd83f44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{2}+C\" :db/id 17592186340060} {:answer/id #uuid \"926a2dfc-a131-5563-ba53-5afa24278c9d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(36x)}{6}+C\" :db/id 17592186340442} {:answer/id #uuid \"e3ae6232-f8ce-5ece-a30d-6e27d814267f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(36x)+C\" :db/id 17592186341146}] :answer-field/correct {:answer/id #uuid \"689ac8e4-68fd-56b3-a68a-d04dadd83f44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{2}+C\" :db/id 17592186340060} :answer-field/id #uuid \"c6e02fde-8f73-598e-a892-0518e56b81c6\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341728}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8cd85d7e-9002-5474-aae0-35e5eb480c8e\" :question/math-academy-id \"q-73715\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{3\\\\,\\\\text{d}x}{|6x|\\\\sqrt{(6x)^{2}-1}}=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{3\\\\,\\\\text{d}x}{|6x|\\\\sqrt{(6x)^{2}-1}}=3\\\\int \\\\frac{\\\\text{d}x}{|6x|\\\\sqrt{(6x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $6x.$\\n\\nSo, let's substitute $u=6x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=6\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{6}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}3\\\\int \\\\frac{1}{|6x|\\\\sqrt{(6x)^{2}-1}}\\\\text{d}x & =3\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{6}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{2}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(6x)}{2}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186342067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5be9359f-ea8b-563c-9bb9-6b1a6826176f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186339961} {:answer/id #uuid \"64bf2439-df5c-5f13-8e13-540b1d44c9d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(4x)+C\" :db/id 17592186340020} {:answer/id #uuid \"81d073cc-887d-5b6a-aeab-6cecc28a4382\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\,\\\\text{arcsec}(4x)+C\" :db/id 17592186340297} {:answer/id #uuid \"95b7f420-0b28-5282-a657-40d893b628dd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arctan}(4x)}{4}+C\" :db/id 17592186340478} {:answer/id #uuid \"d5244b0b-6f4f-5504-8207-05f6294fbb10\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arctan}(4x)+C\" :db/id 17592186341015}] :answer-field/correct {:answer/id #uuid \"5be9359f-ea8b-563c-9bb9-6b1a6826176f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186339961} :answer-field/id #uuid \"d91ba1e9-1dd8-5d35-a35f-ac59fd9e8143\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341764}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"78df4070-47af-5dba-93f4-a34eb10c085e\" :question/math-academy-id \"q-73716\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{\\\\text{d}x}{|4x|\\\\sqrt{(4x)^{2}-1}}=\\n$$\" :question/worked-solution \"This integral resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $4x.$\\n\\nSo, let's substitute $u=4x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{4}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{|4x|\\\\sqrt{(4x)^{2}-1}}\\\\text{d}x & =\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{4}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{4}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(4x)}{4}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186342068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"14690a52-f522-5cec-90d3-9f420e7fc080\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arctan}(5x)+C\" :db/id 17592186339311} {:answer/id #uuid \"5da47576-8911-5b68-868f-555462fcef8e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(5x)}{5}+C\" :db/id 17592186339968} {:answer/id #uuid \"6ec5d84f-e713-5832-b748-a0e4c715f798\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arctan}(5x)}{5}+C\" :db/id 17592186340111} {:answer/id #uuid \"7b9a50aa-ecbb-5989-afe3-1d8c3cdb9d07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(5x)+C\" :db/id 17592186340239} {:answer/id #uuid \"99ab830d-95ff-5734-ab2f-bab2f3570815\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(5x)+C\" :db/id 17592186340514}] :answer-field/correct {:answer/id #uuid \"5da47576-8911-5b68-868f-555462fcef8e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(5x)}{5}+C\" :db/id 17592186339968} :answer-field/id #uuid \"0d389694-7fb3-5b9c-b985-67d93a5095c2\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341402}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"6b1a4da5-f80f-5816-895f-0dc3214bccc3\" :question/math-academy-id \"q-73718\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{5|x|\\\\sqrt{25{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{5|x|\\\\sqrt{25{x}^{2}-1}}=\\\\int \\\\frac{\\\\text{d}x}{|5x|\\\\sqrt{(5x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $5x.$\\n\\nSo, let's substitute $u=5x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=5\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{5}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{5|x|\\\\sqrt{25{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{|5x|\\\\sqrt{(5x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{5}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{5}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{5}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(5x)}{5}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186676884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"093e8ee9-6706-5ac0-9856-c97b4df6f556\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\" :db/id 17592186676879} {:answer/id #uuid \"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\" :db/id 17592186676903} {:answer/id #uuid \"520052f9-511f-5463-abd6-61c01b26c6c9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(81 x \\\\right)}+C\" :db/id 17592186676927} {:answer/id #uuid \"7616d1f3-8012-52d1-b910-e3117af611f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\" :db/id 17592186676948} {:answer/id #uuid \"f781316b-ad0d-5599-b0d1-a715216cc7e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{81}+C\" :db/id 17592186677032}] :answer-field/correct {:answer/id #uuid \"2d562848-1d97-52e5-9683-cb014d13bdb0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\" :db/id 17592186676903} :answer-field/id #uuid \"60467e61-e7b2-548a-a8c4-112122fa9c9b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676938}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"1330265e-12c1-57f0-82dd-95378d9f20b0\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=9 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{9})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|9 x|=9|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{9}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{9})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"20bf9841-2595-5f27-b0e8-1e9284708c28\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{8}+C\" :db/id 17592186676896} {:answer/id #uuid \"6e42acbb-4f56-56be-a048-fba84c7dc573\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676942} {:answer/id #uuid \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676954} {:answer/id #uuid \"b68e91f4-197a-5d0d-9aa6-776bde1a3333\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{64}+C\" :db/id 17592186676990} {:answer/id #uuid \"f2f477b1-1575-5b4e-ba38-698f5d0ef3a1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}+C\" :db/id 17592186677029}] :answer-field/correct {:answer/id #uuid \"7e019ca5-2476-5cb5-892a-c3f42ebb26e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676954} :answer-field/id #uuid \"f8007ccb-32ea-5c4e-8b8c-8bb848c4c191\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677033}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"184d3205-f072-5ec2-ae47-f41ae45b3346\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|8 x|=8|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{8}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{8})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"49ebbcc4-6039-5bf0-998a-dded9c3941e5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}}{14}+C\" :db/id 17592186676922} {:answer/id #uuid \"74cae605-ea8d-5ca5-8033-c10411a836ab\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}}{196}+C\" :db/id 17592186676946} {:answer/id #uuid \"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\" :db/id 17592186676984} {:answer/id #uuid \"c7a55cec-6a4f-5cd8-bd20-ddc037f3250e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(196 x \\\\right)}+C\" :db/id 17592186677007} {:answer/id #uuid \"eed14417-4f9a-5aae-9ec6-27bba65a8975\" :answer/type {:db/ident :answer.type/math} :answer/value \"14 \\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\" :db/id 17592186677026}] :answer-field/correct {:answer/id #uuid \"ab2399d7-22bf-5740-880c-727575b60c80\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\" :db/id 17592186676984} :answer-field/id #uuid \"3494f9ef-9b8c-50b2-931e-8e49eba77f3b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676910}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2c86da1f-3334-519e-bd8d-02dc5abc2552\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{14}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=14 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=14,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{14})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|14 x|=14|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{14}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{14}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 14\\\\int \\\\frac{1}{|14 x|\\\\sqrt{(14 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 14(\\\\frac{1}{14})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(14 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|14 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0e0be1ee-1432-52ae-9e94-69b713d648c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(121 x \\\\right)}+C\" :db/id 17592186676880} {:answer/id #uuid \"59b25816-1279-51cb-af04-13bca7bd5f42\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}}{121}+C\" :db/id 17592186676933} {:answer/id #uuid \"626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9\" :answer/type {:db/ident :answer.type/math} :answer/value \"11 \\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\" :db/id 17592186676939} {:answer/id #uuid \"b8d7fe7e-90a9-577a-92c4-5851d113ae44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}}{11}+C\" :db/id 17592186676992} {:answer/id #uuid \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\" :db/id 17592186677035}] :answer-field/correct {:answer/id #uuid \"f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\" :db/id 17592186677035} :answer-field/id #uuid \"c8f4c10b-4483-58bc-be77-10c8b0e9c52b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186677009}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2cb5a03d-f884-5440-bad0-52e5f286b6f3\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{11}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=11 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=11,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{11})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|11 x|=11|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{11}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{11}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 11\\\\int \\\\frac{1}{|11 x|\\\\sqrt{(11 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 11(\\\\frac{1}{11})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 1\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= \\\\operatorname{arcsec}{\\\\left(11 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|11 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\" :db/id 17592186676883} {:answer/id #uuid \"54c12a5d-b905-54d9-b018-d803a7bc0aa0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}+C\" :db/id 17592186676930} {:answer/id #uuid \"5926164f-fed6-5e3a-ba40-860db0a5ab38\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{81}+C\" :db/id 17592186676932} {:answer/id #uuid \"66282b24-49ba-5f84-8c44-21e0d0e0baaf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(9 x \\\\right)}}{9}+C\" :db/id 17592186676940} {:answer/id #uuid \"ba323a7e-319b-5495-ba14-d1d7a671d138\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{9}+C\" :db/id 17592186676993}] :answer-field/correct {:answer/id #uuid \"11627a8d-6425-5a99-b9f4-e08ef26dbb78\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\" :db/id 17592186676883} :answer-field/id #uuid \"3cbd97b4-beaa-5e69-b275-d9ff5a285259\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676915}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2ed62d92-c36a-50a5-9c81-caff226f716e\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=9 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{9})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|9 x|=9|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{9}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1\\\\int \\\\frac{1}{|9 x|\\\\sqrt{(9 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 1(\\\\frac{1}{9})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{1}{9}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{9}+C \\\\\\\\  &= \\\\frac{\\\\operatorname{arcsec}{\\\\left(9 x \\\\right)}}{9}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"52f20127-7026-51bd-b9eb-d3aaffbd7897\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{6}+C\" :db/id 17592186676928} {:answer/id #uuid \"a926cb91-61f3-563f-8349-379a686c3646\" :answer/type {:db/ident :answer.type/math} :answer/value \"30 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\" :db/id 17592186676983} {:answer/id #uuid \"bab46891-026f-5774-bdfe-32c494dd6b77\" :answer/type {:db/ident :answer.type/math} :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(36 x \\\\right)}+C\" :db/id 17592186676995} {:answer/id #uuid \"c3d34534-5046-50b0-a039-b5b4e49d9381\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}}{36}+C\" :db/id 17592186677002} {:answer/id #uuid \"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/type {:db/ident :answer.type/math} :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\" :db/id 17592186677036}] :answer-field/correct {:answer/id #uuid \"f8e644d1-662e-52e7-b469-8b247975de27\" :answer/type {:db/ident :answer.type/math} :answer/value \"5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\" :db/id 17592186677036} :answer-field/id #uuid \"6d4e21a5-098c-5819-b7c8-0666c70ecb95\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676941}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3feb255f-aeba-5dbb-91d6-6231c18cb161\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{36 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=6 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{6})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|6 x|=6|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{6}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{5}{|x|\\\\sqrt{36 x^{2} - 1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 30\\\\int \\\\frac{1}{|6 x|\\\\sqrt{(6 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 30(\\\\frac{1}{6})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C \\\\\\\\  &= 5 \\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|6 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"15e65e07-085b-550a-a717-82d2d0a4449f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{64}+C\" :db/id 17592186676887} {:answer/id #uuid \"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676891} {:answer/id #uuid \"b71fa791-be0c-5a48-a50c-ab3294c89e93\" :answer/type {:db/ident :answer.type/math} :answer/value \"9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}+C\" :db/id 17592186676991} {:answer/id #uuid \"e2e87151-dca4-5f40-a571-21cca555c271\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(x \\\\right)}}{8}+C\" :db/id 17592186677018} {:answer/id #uuid \"fc8cda26-f6db-5986-9ef8-10b89f69beda\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arctan}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186677039}] :answer-field/correct {:answer/id #uuid \"1d199601-926c-5873-9d3f-90aebc32fddf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\" :db/id 17592186676891} :answer-field/id #uuid \"4cebd2f9-e45b-5a2d-b6e5-c83b641f472b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186676924}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"445c17c5-47bb-5095-a41c-cf964b636e04\" :question/problem \"Evaluate the integral. Give an exact answer.\\n\\n$$\\n\\\\int \\\\frac{9}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Use the linear substitution $u=8 x.$ Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8,\\\\qquad \\\\mathrm{d}x=(\\\\frac{1}{8})\\\\,\\\\mathrm{d}u.\\n$$\\n\\nThe substitution factor is positive, so the absolute values satisfy\\n\\n$$\\n|u|=|8 x|=8|x|,\\\\qquad \\\\frac{1}{|x|}=\\\\frac{8}{|u|}.\\n$$\\n\\nApply the basic inverse-trigonometric integral:\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute and evaluate:\\n\\n$$\\n\\\\begin{aligned}& \\\\int \\\\frac{9}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9\\\\int \\\\frac{1}{|8 x|\\\\sqrt{(8 x)^{2}-1}}\\\\,\\\\mathrm{d}x \\\\\\\\  &= 9(\\\\frac{1}{8})\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9}{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{u^{2}-1}}\\\\,\\\\mathrm{d}u \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arcsec}{\\\\left(u \\\\right)}}{8}+C \\\\\\\\  &= \\\\frac{9 \\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}}{8}+C\\\\end{aligned}\\n$$\\n\\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals.\"} {:db/id 17592186676931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0508ef6a-4649-544f-ab1c-27e5adee2091\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}{\\\\left(7 x \\\\right)}}{7}+C\" :db/id 17592186676878} {:answer/id #uuid \"5104680c-2ea7-5a28-9524-a65df4157530\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(7 x \\\\right)}+C\" :db/