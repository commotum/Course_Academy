\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"f054d58c-180c-591b-ad06-4546c86b706b\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [\"f054d58c-180c-591b-ad06-4546c86b706b\" :question/difficulty :question.difficulty/moderate] [\"f054d58c-180c-591b-ad06-4546c86b706b\" :question/answer-fields \"b3e9108b-9b5d-5ac8-beba-3e637f2e5c1b\"] [17592186064250 :knowledge-point/questions \"f054d58c-180c-591b-ad06-4546c86b706b\"] [\"22234917-661d-55e6-bf15-1539dc6f1ca9\" :answer/id #uuid \"22234917-661d-55e6-bf15-1539dc6f1ca9\"] [\"22234917-661d-55e6-bf15-1539dc6f1ca9\" :answer/type :answer.type/math] [\"22234917-661d-55e6-bf15-1539dc6f1ca9\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"40598f69-d38c-580a-ac76-25dd1df1772e\" :answer/id #uuid \"40598f69-d38c-580a-ac76-25dd1df1772e\"] [\"40598f69-d38c-580a-ac76-25dd1df1772e\" :answer/type :answer.type/math] [\"40598f69-d38c-580a-ac76-25dd1df1772e\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"4c5be87a-280e-5e27-94d4-760eb3e4efab\" :answer/id #uuid \"4c5be87a-280e-5e27-94d4-760eb3e4efab\"] [\"4c5be87a-280e-5e27-94d4-760eb3e4efab\" :answer/type :answer.type/math] [\"4c5be87a-280e-5e27-94d4-760eb3e4efab\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"ba785ef5-5dfe-56a4-9972-ec65ecf92308\" :answer/id #uuid \"ba785ef5-5dfe-56a4-9972-ec65ecf92308\"] [\"ba785ef5-5dfe-56a4-9972-ec65ecf92308\" :answer/type :answer.type/math] [\"ba785ef5-5dfe-56a4-9972-ec65ecf92308\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"61ea967d-3662-5112-a401-c106190ec2d8\" :answer/id #uuid \"61ea967d-3662-5112-a401-c106190ec2d8\"] [\"61ea967d-3662-5112-a401-c106190ec2d8\" :answer/type :answer.type/math] [\"61ea967d-3662-5112-a401-c106190ec2d8\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/id #uuid \"d20f1c0e-2f95-59e8-aaf0-a406d464023a\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/key \"answer\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/type :answer-field.type/radio] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/choices \"22234917-661d-55e6-bf15-1539dc6f1ca9\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/choices \"40598f69-d38c-580a-ac76-25dd1df1772e\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/choices \"4c5be87a-280e-5e27-94d4-760eb3e4efab\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/choices \"ba785ef5-5dfe-56a4-9972-ec65ecf92308\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/choices \"61ea967d-3662-5112-a401-c106190ec2d8\"] [\"d20f1c0e-2f95-59e8-aaf0-a406d464023a\" :answer-field/correct \"40598f69-d38c-580a-ac76-25dd1df1772e\"] [\"f0669784-ec1f-5ea5-8858-d62b3e3c7a46\" :question/id #uuid \"f0669784-ec1f-5ea5-8858-d62b3e3c7a46\"] [\"f0669784-ec1f-5ea5-8858-d62b3e3c7a46\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"f0669784-ec1f-5ea5-8858-d62b3e3c7a46\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [\"f0669784-ec1f-5ea5-8858-d62b3e3c7a46\" :question/difficulty :question.difficulty/moderate] [\"f0669784-ec1f-5ea5-8858-d62b3e3c7a46\" :question/answer-fields \"d20f1c0e-2f95-59e8-aaf0-a406d464023a\"] [17592186064250 :knowledge-point/questions \"f0669784-ec1f-5ea5-8858-d62b3e3c7a46\"] [\"ed85456d-5678-5a66-b5ec-36790d6f87d7\" :answer/id #uuid \"ed85456d-5678-5a66-b5ec-36790d6f87d7\"] [\"ed85456d-5678-5a66-b5ec-36790d6f87d7\" :answer/type :answer.type/math] [\"ed85456d-5678-5a66-b5ec-36790d6f87d7\" :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"ac964986-401f-564c-b1a5-b2b673875903\" :answer/id #uuid \"ac964986-401f-564c-b1a5-b2b673875903\"] [\"ac964986-401f-564c-b1a5-b2b673875903\" :answer/type :answer.type/math] [\"ac964986-401f-564c-b1a5-b2b673875903\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"821b7127-b355-5427-a9ef-1b1dac049cab\" :answer/id #uuid \"821b7127-b355-5427-a9ef-1b1dac049cab\"] [\"821b7127-b355-5427-a9ef-1b1dac049cab\" :answer/type :answer.type/math] [\"821b7127-b355-5427-a9ef-1b1dac049cab\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"696e45a1-fd5f-57d8-9430-112536a04978\" :answer/id #uuid \"696e45a1-fd5f-57d8-9430-112536a04978\"] [\"696e45a1-fd5f-57d8-9430-112536a04978\" :answer/type :answer.type/math] [\"696e45a1-fd5f-57d8-9430-112536a04978\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\"] [\"fd8e0c30-f35d-5003-a4dd-9448e64631ad\" :answer/id #uuid \"fd8e0c30-f35d-5003-a4dd-9448e64631ad\"] [\"fd8e0c30-f35d-5003-a4dd-9448e64631ad\" :answer/type :answer.type/math] [\"fd8e0c30-f35d-5003-a4dd-9448e64631ad\" :answer/value \"\\\\frac{6}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/id #uuid \"4d199d5d-0de4-57e8-9e25-af029988c010\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/key \"answer\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/type :answer-field.type/radio] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/choices \"ed85456d-5678-5a66-b5ec-36790d6f87d7\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/choices \"ac964986-401f-564c-b1a5-b2b673875903\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/choices \"821b7127-b355-5427-a9ef-1b1dac049cab\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/choices \"696e45a1-fd5f-57d8-9430-112536a04978\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/choices \"fd8e0c30-f35d-5003-a4dd-9448e64631ad\"] [\"4d199d5d-0de4-57e8-9e25-af029988c010\" :answer-field/correct \"ac964986-401f-564c-b1a5-b2b673875903\"] [\"f1b7fa87-c039-55a3-9a9e-c5ff3a8013fa\" :question/id #uuid \"f1b7fa87-c039-55a3-9a9e-c5ff3a8013fa\"] [\"f1b7fa87-c039-55a3-9a9e-c5ff3a8013fa\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"f1b7fa87-c039-55a3-9a9e-c5ff3a8013fa\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [\"f1b7fa87-c039-55a3-9a9e-c5ff3a8013fa\" :question/difficulty :question.difficulty/moderate] [\"f1b7fa87-c039-55a3-9a9e-c5ff3a8013fa\" :question/answer-fields \"4d199d5d-0de4-57e8-9e25-af029988c010\"] [17592186064250 :knowledge-point/questions \"f1b7fa87-c039-55a3-9a9e-c5ff3a8013fa\"] [\"70e8de43-8fdf-5b62-a70c-558d5960567c\" :answer/id #uuid \"70e8de43-8fdf-5b62-a70c-558d5960567c\"] [\"70e8de43-8fdf-5b62-a70c-558d5960567c\" :answer/type :answer.type/math] [\"70e8de43-8fdf-5b62-a70c-558d5960567c\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"fd7d10e5-ea3f-530b-b2ab-a76c1cfd107c\" :answer/id #uuid \"fd7d10e5-ea3f-530b-b2ab-a76c1cfd107c\"] [\"fd7d10e5-ea3f-530b-b2ab-a76c1cfd107c\" :answer/type :answer.type/math] [\"fd7d10e5-ea3f-530b-b2ab-a76c1cfd107c\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"423cac0f-e0d4-5c82-a36c-3fd77bc79d7e\" :answer/id #uuid \"423cac0f-e0d4-5c82-a36c-3fd77bc79d7e\"] [\"423cac0f-e0d4-5c82-a36c-3fd77bc79d7e\" :answer/type :answer.type/math] [\"423cac0f-e0d4-5c82-a36c-3fd77bc79d7e\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"6b5c2a97-06ea-5deb-9a32-167c5fcf621d\" :answer/id #uuid \"6b5c2a97-06ea-5deb-9a32-167c5fcf621d\"] [\"6b5c2a97-06ea-5deb-9a32-167c5fcf621d\" :answer/type :answer.type/math] [\"6b5c2a97-06ea-5deb-9a32-167c5fcf621d\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"4256fa28-48a7-5d50-a4f2-714dd6256373\" :answer/id #uuid \"4256fa28-48a7-5d50-a4f2-714dd6256373\"] [\"4256fa28-48a7-5d50-a4f2-714dd6256373\" :answer/type :answer.type/math] [\"4256fa28-48a7-5d50-a4f2-714dd6256373\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/id #uuid \"13e879be-7fd7-5b58-aac6-1b0f6a224e96\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/key \"answer\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/type :answer-field.type/radio] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/choices \"70e8de43-8fdf-5b62-a70c-558d5960567c\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/choices \"fd7d10e5-ea3f-530b-b2ab-a76c1cfd107c\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/choices \"423cac0f-e0d4-5c82-a36c-3fd77bc79d7e\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/choices \"6b5c2a97-06ea-5deb-9a32-167c5fcf621d\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/choices \"4256fa28-48a7-5d50-a4f2-714dd6256373\"] [\"13e879be-7fd7-5b58-aac6-1b0f6a224e96\" :answer-field/correct \"423cac0f-e0d4-5c82-a36c-3fd77bc79d7e\"] [\"bfa0ba88-cd1a-5014-a502-27b6d9f6c943\" :question/id #uuid \"bfa0ba88-cd1a-5014-a502-27b6d9f6c943\"] [\"bfa0ba88-cd1a-5014-a502-27b6d9f6c943\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"bfa0ba88-cd1a-5014-a502-27b6d9f6c943\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $6\\\\cdot \\\\frac{1}{3}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [\"bfa0ba88-cd1a-5014-a502-27b6d9f6c943\" :question/difficulty :question.difficulty/hard] [\"bfa0ba88-cd1a-5014-a502-27b6d9f6c943\" :question/answer-fields \"13e879be-7fd7-5b58-aac6-1b0f6a224e96\"] [17592186064250 :knowledge-point/questions \"bfa0ba88-cd1a-5014-a502-27b6d9f6c943\"] [\"7919f065-684f-5162-84c1-326bee6ae511\" :answer/id #uuid \"7919f065-684f-5162-84c1-326bee6ae511\"] [\"7919f065-684f-5162-84c1-326bee6ae511\" :answer/type :answer.type/math] [\"7919f065-684f-5162-84c1-326bee6ae511\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"876f62f1-9b04-5c3d-8733-6432cf43bea5\" :answer/id #uuid \"876f62f1-9b04-5c3d-8733-6432cf43bea5\"] [\"876f62f1-9b04-5c3d-8733-6432cf43bea5\" :answer/type :answer.type/math] [\"876f62f1-9b04-5c3d-8733-6432cf43bea5\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"b7a75978-9c9e-57e7-9d29-c8315015fdcd\" :answer/id #uuid \"b7a75978-9c9e-57e7-9d29-c8315015fdcd\"] [\"b7a75978-9c9e-57e7-9d29-c8315015fdcd\" :answer/type :answer.type/math] [\"b7a75978-9c9e-57e7-9d29-c8315015fdcd\" :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"0af9ecf0-ad27-5c54-bcc2-d7c243cc178e\" :answer/id #uuid \"0af9ecf0-ad27-5c54-bcc2-d7c243cc178e\"] [\"0af9ecf0-ad27-5c54-bcc2-d7c243cc178e\" :answer/type :answer.type/math] [\"0af9ecf0-ad27-5c54-bcc2-d7c243cc178e\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"91a06352-fe59-5083-972f-300fef7dbc84\" :answer/id #uuid \"91a06352-fe59-5083-972f-300fef7dbc84\"] [\"91a06352-fe59-5083-972f-300fef7dbc84\" :answer/type :answer.type/math] [\"91a06352-fe59-5083-972f-300fef7dbc84\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/id #uuid \"2a5b0386-1523-52c2-8e5e-63a3e9478c59\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/key \"answer\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/type :answer-field.type/radio] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/choices \"7919f065-684f-5162-84c1-326bee6ae511\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/choices \"876f62f1-9b04-5c3d-8733-6432cf43bea5\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/choices \"b7a75978-9c9e-57e7-9d29-c8315015fdcd\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/choices \"0af9ecf0-ad27-5c54-bcc2-d7c243cc178e\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/choices \"91a06352-fe59-5083-972f-300fef7dbc84\"] [\"2a5b0386-1523-52c2-8e5e-63a3e9478c59\" :answer-field/correct \"876f62f1-9b04-5c3d-8733-6432cf43bea5\"] [\"2c09025a-e36a-5f98-8a3a-ecae05ef8ee0\" :question/id #uuid \"2c09025a-e36a-5f98-8a3a-ecae05ef8ee0\"] [\"2c09025a-e36a-5f98-8a3a-ecae05ef8ee0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"2c09025a-e36a-5f98-8a3a-ecae05ef8ee0\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{4}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [\"2c09025a-e36a-5f98-8a3a-ecae05ef8ee0\" :question/difficulty :question.difficulty/hard] [\"2c09025a-e36a-5f98-8a3a-ecae05ef8ee0\" :question/answer-fields \"2a5b0386-1523-52c2-8e5e-63a3e9478c59\"] [17592186064250 :knowledge-point/questions \"2c09025a-e36a-5f98-8a3a-ecae05ef8ee0\"] [\"ab0bce01-5c37-5eef-acfa-6c3ad9b30c48\" :answer/id #uuid \"ab0bce01-5c37-5eef-acfa-6c3ad9b30c48\"] [\"ab0bce01-5c37-5eef-acfa-6c3ad9b30c48\" :answer/type :answer.type/math] [\"ab0bce01-5c37-5eef-acfa-6c3ad9b30c48\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"23088978-2ce1-5552-a18e-32ab1b227133\" :answer/id #uuid \"23088978-2ce1-5552-a18e-32ab1b227133\"] [\"23088978-2ce1-5552-a18e-32ab1b227133\" :answer/type :answer.type/math] [\"23088978-2ce1-5552-a18e-32ab1b227133\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"ecfeba93-2ccd-5d4f-bebf-35393b80e906\" :answer/id #uuid \"ecfeba93-2ccd-5d4f-bebf-35393b80e906\"] [\"ecfeba93-2ccd-5d4f-bebf-35393b80e906\" :answer/type :answer.type/math] [\"ecfeba93-2ccd-5d4f-bebf-35393b80e906\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\"] [\"4d0cd5f7-073d-5d5a-b881-bdaaeaaf2053\" :answer/id #uuid \"4d0cd5f7-073d-5d5a-b881-bdaaeaaf2053\"] [\"4d0cd5f7-073d-5d5a-b881-bdaaeaaf2053\" :answer/type :answer.type/math] [\"4d0cd5f7-073d-5d5a-b881-bdaaeaaf2053\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"2867c5f9-486e-5412-9dc6-3f424ccb2821\" :answer/id #uuid \"2867c5f9-486e-5412-9dc6-3f424ccb2821\"] [\"2867c5f9-486e-5412-9dc6-3f424ccb2821\" :answer/type :answer.type/math] [\"2867c5f9-486e-5412-9dc6-3f424ccb2821\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/id #uuid \"37c1b041-26d8-547b-afc4-f26c60dc9ce0\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/key \"answer\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/type :answer-field.type/radio] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/choices \"ab0bce01-5c37-5eef-acfa-6c3ad9b30c48\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/choices \"23088978-2ce1-5552-a18e-32ab1b227133\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/choices \"ecfeba93-2ccd-5d4f-bebf-35393b80e906\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/choices \"4d0cd5f7-073d-5d5a-b881-bdaaeaaf2053\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/choices \"2867c5f9-486e-5412-9dc6-3f424ccb2821\"] [\"37c1b041-26d8-547b-afc4-f26c60dc9ce0\" :answer-field/correct \"4d0cd5f7-073d-5d5a-b881-bdaaeaaf2053\"] [\"e458c6a7-d57b-5820-90ef-f845411de6d9\" :question/id #uuid \"e458c6a7-d57b-5820-90ef-f845411de6d9\"] [\"e458c6a7-d57b-5820-90ef-f845411de6d9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e458c6a7-d57b-5820-90ef-f845411de6d9\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $10\\\\cdot \\\\frac{1}{5}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [\"e458c6a7-d57b-5820-90ef-f845411de6d9\" :question/difficulty :question.difficulty/hard] [\"e458c6a7-d57b-5820-90ef-f845411de6d9\" :question/answer-fields \"37c1b041-26d8-547b-afc4-f26c60dc9ce0\"] [17592186064250 :knowledge-point/questions \"e458c6a7-d57b-5820-90ef-f845411de6d9\"] [\"17e8cc9b-2090-546f-b5f6-63612df70c02\" :answer/id #uuid \"17e8cc9b-2090-546f-b5f6-63612df70c02\"] [\"17e8cc9b-2090-546f-b5f6-63612df70c02\" :answer/type :answer.type/math] [\"17e8cc9b-2090-546f-b5f6-63612df70c02\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"dc24f586-1089-577f-8c0e-7f39b8c84c5c\" :answer/id #uuid \"dc24f586-1089-577f-8c0e-7f39b8c84c5c\"] [\"dc24f586-1089-577f-8c0e-7f39b8c84c5c\" :answer/type :answer.type/math] [\"dc24f586-1089-577f-8c0e-7f39b8c84c5c\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432\" :answer/id #uuid \"c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432\"] [\"c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432\" :answer/type :answer.type/math] [\"c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432\" :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"b01a33d3-e49a-58de-8a8f-1f7783630836\" :answer/id #uuid \"b01a33d3-e49a-58de-8a8f-1f7783630836\"] [\"b01a33d3-e49a-58de-8a8f-1f7783630836\" :answer/type :answer.type/math] [\"b01a33d3-e49a-58de-8a8f-1f7783630836\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"93d5b36f-fd95-59e6-942a-e49927311fc9\" :answer/id #uuid \"93d5b36f-fd95-59e6-942a-e49927311fc9\"] [\"93d5b36f-fd95-59e6-942a-e49927311fc9\" :answer/type :answer.type/math] [\"93d5b36f-fd95-59e6-942a-e49927311fc9\" :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/id #uuid \"70a32f43-6d04-5912-9359-a8d23281df9b\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/key \"answer\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/type :answer-field.type/radio] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/choices \"17e8cc9b-2090-546f-b5f6-63612df70c02\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/choices \"dc24f586-1089-577f-8c0e-7f39b8c84c5c\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/choices \"c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/choices \"b01a33d3-e49a-58de-8a8f-1f7783630836\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/choices \"93d5b36f-fd95-59e6-942a-e49927311fc9\"] [\"70a32f43-6d04-5912-9359-a8d23281df9b\" :answer-field/correct \"dc24f586-1089-577f-8c0e-7f39b8c84c5c\"] [\"062650d4-1fa4-5f2c-84e7-e8520dfa7735\" :question/id #uuid \"062650d4-1fa4-5f2c-84e7-e8520dfa7735\"] [\"062650d4-1fa4-5f2c-84e7-e8520dfa7735\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"062650d4-1fa4-5f2c-84e7-e8520dfa7735\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $16\\\\cdot \\\\frac{1}{4}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [\"062650d4-1fa4-5f2c-84e7-e8520dfa7735\" :question/difficulty :question.difficulty/hard] [\"062650d4-1fa4-5f2c-84e7-e8520dfa7735\" :question/answer-fields \"70a32f43-6d04-5912-9359-a8d23281df9b\"] [17592186064250 :knowledge-point/questions \"062650d4-1fa4-5f2c-84e7-e8520dfa7735\"] [\"752db311-1066-5745-828f-5ec327c1bf77\" :answer/id #uuid \"752db311-1066-5745-828f-5ec327c1bf77\"] [\"752db311-1066-5745-828f-5ec327c1bf77\" :answer/type :answer.type/math] [\"752db311-1066-5745-828f-5ec327c1bf77\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [\"e84de875-40c5-5bdb-8a09-e48480956b35\" :answer/id #uuid \"e84de875-40c5-5bdb-8a09-e48480956b35\"] [\"e84de875-40c5-5bdb-8a09-e48480956b35\" :answer/type :answer.type/math] [\"e84de875-40c5-5bdb-8a09-e48480956b35\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}+C\"] [\"78ca4bd8-5225-5b04-8a27-8d8cf24f20ad\" :answer/id #uuid \"78ca4bd8-5225-5b04-8a27-8d8cf24f20ad\"] [\"78ca4bd8-5225-5b04-8a27-8d8cf24f20ad\" :answer/type :answer.type/math] [\"78ca4bd8-5225-5b04-8a27-8d8cf24f20ad\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"41296916-dadd-5bca-b6b4-0766d5545441\" :answer/id #uuid \"41296916-dadd-5bca-b6b4-0766d5545441\"] [\"41296916-dadd-5bca-b6b4-0766d5545441\" :answer/type :answer.type/math] [\"41296916-dadd-5bca-b6b4-0766d5545441\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [\"98955048-7c21-56c7-bf34-29aea44f1171\" :answer/id #uuid \"98955048-7c21-56c7-bf34-29aea44f1171\"] [\"98955048-7c21-56c7-bf34-29aea44f1171\" :answer/type :answer.type/math] [\"98955048-7c21-56c7-bf34-29aea44f1171\" :answer/value \"-1\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/id #uuid \"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/key \"answer\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/type :answer-field.type/radio] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/choices \"752db311-1066-5745-828f-5ec327c1bf77\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/choices \"e84de875-40c5-5bdb-8a09-e48480956b35\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/choices \"78ca4bd8-5225-5b04-8a27-8d8cf24f20ad\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/choices \"41296916-dadd-5bca-b6b4-0766d5545441\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/choices \"98955048-7c21-56c7-bf34-29aea44f1171\"] [\"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\" :answer-field/correct \"752db311-1066-5745-828f-5ec327c1bf77\"] [\"a18b62e4-bd0f-5ad5-a4da-6ae883771ad9\" :question/id #uuid \"a18b62e4-bd0f-5ad5-a4da-6ae883771ad9\"] [\"a18b62e4-bd0f-5ad5-a4da-6ae883771ad9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|2 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"a18b62e4-bd0f-5ad5-a4da-6ae883771ad9\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nBecause $2>0$, $|u|=2|x|$, so $|x|=|u|/2$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C.\\n$$\"] [\"a18b62e4-bd0f-5ad5-a4da-6ae883771ad9\" :question/difficulty :question.difficulty/hard] [\"a18b62e4-bd0f-5ad5-a4da-6ae883771ad9\" :question/answer-fields \"2838d84b-328c-5b8b-bbf8-043a80c2dbeb\"] [17592186064250 :knowledge-point/questions \"a18b62e4-bd0f-5ad5-a4da-6ae883771ad9\"] [\"3ce6bf5b-cf0f-5180-b4bf-631b1a709785\" :answer/id #uuid \"3ce6bf5b-cf0f-5180-b4bf-631b1a709785\"] [\"3ce6bf5b-cf0f-5180-b4bf-631b1a709785\" :answer/type :answer.type/math] [\"3ce6bf5b-cf0f-5180-b4bf-631b1a709785\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(x \\\\right)}+C\"] [\"d0da665b-b83b-5950-a555-b72bb07169c9\" :answer/id #uuid \"d0da665b-b83b-5950-a555-b72bb07169c9\"] [\"d0da665b-b83b-5950-a555-b72bb07169c9\" :answer/type :answer.type/math] [\"d0da665b-b83b-5950-a555-b72bb07169c9\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"bce79f81-d030-503c-a803-5412bb4059cc\" :answer/id #uuid \"bce79f81-d030-503c-a803-5412bb4059cc\"] [\"bce79f81-d030-503c-a803-5412bb4059cc\" :answer/type :answer.type/math] [\"bce79f81-d030-503c-a803-5412bb4059cc\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}+C\"] [\"cc2c6c38-3869-5854-bef0-07369ed45e1a\" :answer/id #uuid \"cc2c6c38-3869-5854-bef0-07369ed45e1a\"] [\"cc2c6c38-3869-5854-bef0-07369ed45e1a\" :answer/type :answer.type/math] [\"cc2c6c38-3869-5854-bef0-07369ed45e1a\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [\"c943b728-62d2-511e-a97a-4a0493bfe0ae\" :answer/id #uuid \"c943b728-62d2-511e-a97a-4a0493bfe0ae\"] [\"c943b728-62d2-511e-a97a-4a0493bfe0ae\" :answer/type :answer.type/math] [\"c943b728-62d2-511e-a97a-4a0493bfe0ae\" :answer/value \"-1\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/id #uuid \"ca7ef265-9e84-5525-8060-360e20887c13\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/key \"answer\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/type :answer-field.type/radio] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/choices \"3ce6bf5b-cf0f-5180-b4bf-631b1a709785\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/choices \"d0da665b-b83b-5950-a555-b72bb07169c9\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/choices \"bce79f81-d030-503c-a803-5412bb4059cc\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/choices \"cc2c6c38-3869-5854-bef0-07369ed45e1a\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/choices \"c943b728-62d2-511e-a97a-4a0493bfe0ae\"] [\"ca7ef265-9e84-5525-8060-360e20887c13\" :answer-field/correct \"cc2c6c38-3869-5854-bef0-07369ed45e1a\"] [\"40993577-26ec-5c2a-86d9-4cbecdb4a736\" :question/id #uuid \"40993577-26ec-5c2a-86d9-4cbecdb4a736\"] [\"40993577-26ec-5c2a-86d9-4cbecdb4a736\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"40993577-26ec-5c2a-86d9-4cbecdb4a736\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C.\\n$$\"] [\"40993577-26ec-5c2a-86d9-4cbecdb4a736\" :question/difficulty :question.difficulty/hard] [\"40993577-26ec-5c2a-86d9-4cbecdb4a736\" :question/answer-fields \"ca7ef265-9e84-5525-8060-360e20887c13\"] [17592186064250 :knowledge-point/questions \"40993577-26ec-5c2a-86d9-4cbecdb4a736\"] [\"47e15b9f-f50c-567d-a1f5-f944fe687c5d\" :answer/id #uuid \"47e15b9f-f50c-567d-a1f5-f944fe687c5d\"] [\"47e15b9f-f50c-567d-a1f5-f944fe687c5d\" :answer/type :answer.type/math] [\"47e15b9f-f50c-567d-a1f5-f944fe687c5d\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"a731f87b-217d-5532-bca4-d095f70ce817\" :answer/id #uuid \"a731f87b-217d-5532-bca4-d095f70ce817\"] [\"a731f87b-217d-5532-bca4-d095f70ce817\" :answer/type :answer.type/math] [\"a731f87b-217d-5532-bca4-d095f70ce817\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"252218ad-1c4a-5fdb-acf3-685f2dad3a6e\" :answer/id #uuid \"252218ad-1c4a-5fdb-acf3-685f2dad3a6e\"] [\"252218ad-1c4a-5fdb-acf3-685f2dad3a6e\" :answer/type :answer.type/math] [\"252218ad-1c4a-5fdb-acf3-685f2dad3a6e\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\"] [\"eab7f8bb-b962-515d-ae13-5b90b484af60\" :answer/id #uuid \"eab7f8bb-b962-515d-ae13-5b90b484af60\"] [\"eab7f8bb-b962-515d-ae13-5b90b484af60\" :answer/type :answer.type/math] [\"eab7f8bb-b962-515d-ae13-5b90b484af60\" :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"75324eed-948f-5ad8-9539-9da66354e951\" :answer/id #uuid \"75324eed-948f-5ad8-9539-9da66354e951\"] [\"75324eed-948f-5ad8-9539-9da66354e951\" :answer/type :answer.type/math] [\"75324eed-948f-5ad8-9539-9da66354e951\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/id #uuid \"c369d541-d031-5b92-b58f-6c2a22c6752d\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/key \"answer\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/type :answer-field.type/radio] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/choices \"47e15b9f-f50c-567d-a1f5-f944fe687c5d\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/choices \"a731f87b-217d-5532-bca4-d095f70ce817\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/choices \"252218ad-1c4a-5fdb-acf3-685f2dad3a6e\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/choices \"eab7f8bb-b962-515d-ae13-5b90b484af60\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/choices \"75324eed-948f-5ad8-9539-9da66354e951\"] [\"c369d541-d031-5b92-b58f-6c2a22c6752d\" :answer-field/correct \"47e15b9f-f50c-567d-a1f5-f944fe687c5d\"] [\"b663b9ed-8aa3-50e4-9703-f86bb3d5df61\" :question/id #uuid \"b663b9ed-8aa3-50e4-9703-f86bb3d5df61\"] [\"b663b9ed-8aa3-50e4-9703-f86bb3d5df61\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"b663b9ed-8aa3-50e4-9703-f86bb3d5df61\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $15\\\\cdot \\\\frac{1}{5}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [\"b663b9ed-8aa3-50e4-9703-f86bb3d5df61\" :question/difficulty :question.difficulty/hard] [\"b663b9ed-8aa3-50e4-9703-f86bb3d5df61\" :question/answer-fields \"c369d541-d031-5b92-b58f-6c2a22c6752d\"] [17592186064250 :knowledge-point/questions \"b663b9ed-8aa3-50e4-9703-f86bb3d5df61\"] [\"61b30356-4581-5a04-8e9e-e9f024e0634f\" :answer/id #uuid \"61b30356-4581-5a04-8e9e-e9f024e0634f\"] [\"61b30356-4581-5a04-8e9e-e9f024e0634f\" :answer/type :answer.type/math] [\"61b30356-4581-5a04-8e9e-e9f024e0634f\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"61691232-1c0b-5613-ba64-028cfeb6e4c5\" :answer/id #uuid \"61691232-1c0b-5613-ba64-028cfeb6e4c5\"] [\"61691232-1c0b-5613-ba64-028cfeb6e4c5\" :answer/type :answer.type/math] [\"61691232-1c0b-5613-ba64-028cfeb6e4c5\" :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"b29f38ea-83ae-5fe9-b85c-022cd5e0b555\" :answer/id #uuid \"b29f38ea-83ae-5fe9-b85c-022cd5e0b555\"] [\"b29f38ea-83ae-5fe9-b85c-022cd5e0b555\" :answer/type :answer.type/math] [\"b29f38ea-83ae-5fe9-b85c-022cd5e0b555\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"efbbcdac-6022-538c-b9c9-08cbc5bab89b\" :answer/id #uuid \"efbbcdac-6022-538c-b9c9-08cbc5bab89b\"] [\"efbbcdac-6022-538c-b9c9-08cbc5bab89b\" :answer/type :answer.type/math] [\"efbbcdac-6022-538c-b9c9-08cbc5bab89b\" :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"23ae40c8-dc38-59a6-bf33-5dcd76ff572b\" :answer/id #uuid \"23ae40c8-dc38-59a6-bf33-5dcd76ff572b\"] [\"23ae40c8-dc38-59a6-bf33-5dcd76ff572b\" :answer/type :answer.type/math] [\"23ae40c8-dc38-59a6-bf33-5dcd76ff572b\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/id #uuid \"4e83d6e8-b921-5001-9022-b4bf4f708392\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/key \"answer\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/type :answer-field.type/radio] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/choices \"61b30356-4581-5a04-8e9e-e9f024e0634f\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/choices \"61691232-1c0b-5613-ba64-028cfeb6e4c5\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/choices \"b29f38ea-83ae-5fe9-b85c-022cd5e0b555\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/choices \"efbbcdac-6022-538c-b9c9-08cbc5bab89b\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/choices \"23ae40c8-dc38-59a6-bf33-5dcd76ff572b\"] [\"4e83d6e8-b921-5001-9022-b4bf4f708392\" :answer-field/correct \"b29f38ea-83ae-5fe9-b85c-022cd5e0b555\"] [\"e0ca915f-85de-5d80-bc7b-4f29aece6b54\" :question/id #uuid \"e0ca915f-85de-5d80-bc7b-4f29aece6b54\"] [\"e0ca915f-85de-5d80-bc7b-4f29aece6b54\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e0ca915f-85de-5d80-bc7b-4f29aece6b54\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{3}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [\"e0ca915f-85de-5d80-bc7b-4f29aece6b54\" :question/difficulty :question.difficulty/hard] [\"e0ca915f-85de-5d80-bc7b-4f29aece6b54\" :question/answer-fields \"4e83d6e8-b921-5001-9022-b4bf4f708392\"] [17592186064250 :knowledge-point/questions \"e0ca915f-85de-5d80-bc7b-4f29aece6b54\"] [\"generator\" :question-generator/id #uuid \"81715594-f2a8-545e-be47-73da10178012\"] [\"generator\" :question-generator/script \"generators/05/0599fdcb3992b68a8349452a729dc6f86888dab8bf8590d92c455eec38d3bfdc/generator.py\"] [17592186064250 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186064250 :knowledge-point/question-generator 17592186677041]]}",
