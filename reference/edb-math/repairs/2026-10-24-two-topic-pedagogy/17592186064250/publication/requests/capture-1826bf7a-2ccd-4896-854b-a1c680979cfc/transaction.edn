athrm{d}u\\right)=\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(3 x \\right)}\\right)+C.\n$$"] [:db/add "81ad82b8-f4e0-58fa-accc-ffa4bebb139c" :question/difficulty :question.difficulty/moderate] [:db/add "81ad82b8-f4e0-58fa-accc-ffa4bebb139c" :question/answer-fields "6fb2c974-04f6-5efb-b7dc-3b38c233fb1b"] [:db/ensure "81ad82b8-f4e0-58fa-accc-ffa4bebb139c" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "81ad82b8-f4e0-58fa-accc-ffa4bebb139c"] [:db/add "5ddf65e8-eb2f-53be-ae83-c354ca054f8d" :answer/id #uuid "5ddf65e8-eb2f-53be-ae83-c354ca054f8d"] [:db/add "5ddf65e8-eb2f-53be-ae83-c354ca054f8d" :answer/type :answer.type/math] [:db/add "5ddf65e8-eb2f-53be-ae83-c354ca054f8d" :answer/value "\\frac{8}{5}\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "5ddf65e8-eb2f-53be-ae83-c354ca054f8d" :answer/validate] [:db/add "97ad9c8e-c2ce-5cb3-8b19-7f98b2f70e4d" :answer/id #uuid "97ad9c8e-c2ce-5cb3-8b19-7f98b2f70e4d"] [:db/add "97ad9c8e-c2ce-5cb3-8b19-7f98b2f70e4d" :answer/type :answer.type/math] [:db/add "97ad9c8e-c2ce-5cb3-8b19-7f98b2f70e4d" :answer/value "\\frac{4}{5}\\left(\\operatorname{arcsec}{\\left(x \\right)}\\right)+C"] [:db/ensure "97ad9c8e-c2ce-5cb3-8b19-7f98b2f70e4d" :answer/validate] [:db/add "c4ad03ca-167e-50ec-870b-d6819e0e5125" :answer/id #uuid "c4ad03ca-167e-50ec-870b-d6819e0e5125"] [:db/add "c4ad03ca-167e-50ec-870b-d6819e0e5125" :answer/type :answer.type/math] [:db/add "c4ad03ca-167e-50ec-870b-d6819e0e5125" :answer/value "- \\frac{4}{5}\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "c4ad03ca-167e-50ec-870b-d6819e0e5125" :answer/validate] [:db/add "6967a641-edd3-5a74-b591-85d1ab4da76f" :answer/id #uuid "6967a641-edd3-5a74-b591-85d1ab4da76f"] [:db/add "6967a641-edd3-5a74-b591-85d1ab4da76f" :answer/type :answer.type/math] [:db/add "6967a641-edd3-5a74-b591-85d1ab4da76f" :answer/value "\