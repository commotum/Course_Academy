 primitive:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(3 x \\right)}+C.\n$$"] [:db/add "40993577-26ec-5c2a-86d9-4cbecdb4a736" :question/difficulty :question.difficulty/hard] [:db/add "40993577-26ec-5c2a-86d9-4cbecdb4a736" :question/answer-fields "ca7ef265-9e84-5525-8060-360e20887c13"] [:db/ensure "40993577-26ec-5c2a-86d9-4cbecdb4a736" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "40993577-26ec-5c2a-86d9-4cbecdb4a736"] [:db/add "47e15b9f-f50c-567d-a1f5-f944fe687c5d" :answer/id #uuid "47e15b9f-f50c-567d-a1f5-f944fe687c5d"] [:db/add "47e15b9f-f50c-567d-a1f5-f944fe687c5d" :answer/type :answer.type/math] [:db/add "47e15b9f-f50c-567d-a1f5-f944fe687c5d" :answer/value "3\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "47e15b9f-f50c-567d-a1f5-f944fe687c5d" :answer/validate] [:db/add "a731f87b-217d-5532-bca4-d095f70ce817" :answer/id #uuid "a731f87b-217d-5532-bca4-d095f70ce817"] [:db/add "a731f87b-217d-5532-bca4-d095f70ce817" :answer/type :answer.type/math] [:db/add "a731f87b-217d-5532-bca4-d095f70ce817" :answer/value "6\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "a731f87b-217d-5532-bca4-d095f70ce817" :answer/validate] [:db/add "252218ad-1c4a-5fdb-acf3-685f2dad3a6e" :answer/id #uuid "252218ad-1c4a-5fdb-acf3-685f2dad3a6e"] [:db/add "252218ad-1c4a-5fdb-acf3-685f2dad3a6e" :answer/type :answer.type/math] [:db/add "252218ad-1c4a-5fdb-acf3-685f2dad3a6e" :answer/value "3\\left(\\operatorname{arcsec}{\\left(10 x \\right)}\\right)+C"] [:db/ensure "252218ad-1c4a-5fdb-acf3-685f2dad3a6e" :answer/validate] [:db/add "eab7f8bb-b962-515d-ae13-5b90b484af60" :answer/id #uuid "eab7f8bb-b962-515d-ae13-5b90b484af60"] [:db/add "eab7f8bb-b962-515d-ae13-5b90b484af60" :answer/type :answer.type/math] [:db/add "eab7f8bb-b962-515d-ae13-5b90b484af60" :answer/value "-3\\left(\\operatorna