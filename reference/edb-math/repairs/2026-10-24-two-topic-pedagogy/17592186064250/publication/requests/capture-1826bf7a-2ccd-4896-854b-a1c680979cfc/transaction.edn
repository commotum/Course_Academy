|\\sqrt{25 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n2\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=2\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C.\n$$"] [:db/add "e458c6a7-d57b-5820-90ef-f845411de6d9" :question/difficulty :question.difficulty/hard] [:db/add "e458c6a7-d57b-5820-90ef-f845411de6d9" :question/answer-fields "37c1b041-26d8-547b-afc4-f26c60dc9ce0"] [:db/ensure "e458c6a7-d57b-5820-90ef-f845411de6d9" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "e458c6a7-d57b-5820-90ef-f845411de6d9"] [:db/add "17e8cc9b-2090-546f-b5f6-63612df70c02" :answer/id #uuid "17e8cc9b-2090-546f-b5f6-63612df70c02"] [:db/add "17e8cc9b-2090-546f-b5f6-63612df70c02" :answer/type :answer.type/math] [:db/add "17e8cc9b-2090-546f-b5f6-63612df70c02" :answer/value "4\\left(\\operatorname{arcsec}{\\left(x \\right)}\\right)+C"] [:db/ensure "17e8cc9b-2090-546f-b5f6-63612df70c02" :answer/validate] [:db/add "dc24f586-1089-577f-8c0e-7f39b8c84c5c" :answer/id #uuid "dc24f586-1089-577f-8c0e-7f39b8c84c5c"] [:db/add "dc24f586-1089-577f-8c0e-7f39b8c84c5c" :answer/type :answer.type/math] [:db/add "dc24f586-1089-577f-8c0e-7f39b8c84c5c" :answer/value "4\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "dc24f586-1089-577f-8c0e-7f39b8c84c5c" :answer/validate] [:db/add "c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432" :answer/id #uuid "c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432"] [:db/add "c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432" :answer/type :answer.type/math] [:db/add "c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432" :answer/value "8\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "c9c5e16a-fe3c-5a7a-9b04-ffc25deaf432" :answer/validate] [:db/add "b01a33d3-e49a-58de-8a8f-1f7783630836" :answer/id