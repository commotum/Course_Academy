\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "129dd18f-6700-5ffb-9ca8-25a04326a78f" :question/difficulty :question.difficulty/easy] [:db/add "129dd18f-6700-5ffb-9ca8-25a04326a78f" :question/answer-fields "3db76bd0-786f-52f1-ae29-26420c6d4c60"] [:db/ensure "129dd18f-6700-5ffb-9ca8-25a04326a78f" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "129dd18f-6700-5ffb-9ca8-25a04326a78f"] [:db/add "a979c3cc-5cec-59fa-9c86-1af8788026cf" :answer/id #uuid "a979c3cc-5cec-59fa-9c86-1af8788026cf"] [:db/add "a979c3cc-5cec-59fa-9c86-1af8788026cf" :answer/type :answer.type/math] [:db/add "a979c3cc-5cec-59fa-9c86-1af8788026cf" :answer/value "\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)"] [:db/ensure "a979c3cc-5cec-59fa-9c86-1af8788026cf" :answer/validate] [:db/add "0858e303-d45b-544b-a82f-2b47d25c2485" :answer/id #uuid "0858e303-d45b-544b-a82f-2b47d25c2485"] [:db/add "0858e303-d45b-544b-a82f-2b47d25c2485" :answer/type :answer.type/math] [:db/add "0858e303-d45b-544b-a82f-2b47d25c2485" :answer/value "\\frac{3}{2}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)"] [:db/ensure "0858e303-d45b-544b-a82f-2b47d25c2485" :answer/validate] [:db/add "f9070c8e-98bb-537d-936c-b2fa536149cf" :answer/id #uuid "f9070c8e-98bb-537d-936c-b2fa536149cf"] [:db/add "f9070c8e-98bb-537d-936c-b2fa536149cf" :answer/type :answer.type/math] [:db/add "f9070c8e-98bb-537d-936c-b2fa536149cf" :answer/value "\\frac{9}{4}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)"] [:db/ensure "f9070c8e-98bb-537d-936c-b2fa536149cf" :answer/validate] [:db/add "76f48c92-d114-574e-949d-dfbbe632e2f7" :answer/id #uuid "76f48c92-d114-574e-949d-dfbbe632e2f7"] [:db/add "76f48c92-d114-574e-949d-dfbbe632e2f7" :answer/type :answer.type/math] [:db/add "76f48c92-d114-574e-949d-dfbbe632e2f7" :answer/value "\\frac{3}{8}\\left(\\int \\frac{1}{\\sqrt{u^{2}