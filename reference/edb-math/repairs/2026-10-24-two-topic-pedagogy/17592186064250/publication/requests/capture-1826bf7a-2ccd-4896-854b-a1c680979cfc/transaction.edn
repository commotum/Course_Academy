\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C.\n$$"] [:db/add "69248dc5-2b73-53df-a95f-0df952ca5485" :question/difficulty :question.difficulty/moderate] [:db/add "69248dc5-2b73-53df-a95f-0df952ca5485" :question/answer-fields "bc353288-5fbe-520a-92d8-6ad2def9f414"] [:db/ensure "69248dc5-2b73-53df-a95f-0df952ca5485" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "69248dc5-2b73-53df-a95f-0df952ca5485"] [:db/add "e923fc12-9cee-5e6f-b8ea-abccf7941fef" :answer/id #uuid "e923fc12-9cee-5e6f-b8ea-abccf7941fef"] [:db/add "e923fc12-9cee-5e6f-b8ea-abccf7941fef" :answer/type :answer.type/math] [:db/add "e923fc12-9cee-5e6f-b8ea-abccf7941fef" :answer/value "\\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "e923fc12-9cee-5e6f-b8ea-abccf7941fef" :answer/validate] [:db/add "2c2e2a1a-3cd6-5c4c-aebd-51d8adce6fcd" :answer/id #uuid "2c2e2a1a-3cd6-5c4c-aebd-51d8adce6fcd"] [:db/add "2c2e2a1a-3cd6-5c4c-aebd-51d8adce6fcd" :answer/type :answer.type/math] [:db/add "2c2e2a1a-3cd6-5c4c-aebd-51d8adce6fcd" :answer/value "- \\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "2c2e2a1a-3cd6-5c4c-aebd-51d8adce6fcd" :answer/validate] [:db/add "e740253a-8298-550f-879e-caa0ff00a294" :answer/id #uuid "e740253a-8298-550f-879e-caa0ff00a294"] [:db/add "e740253a-8298-550f-879e-caa0ff00a294" :answer/type :answer.type/math] [:db/add "e740253a-8298-550f-879e-caa0ff00a294" :answer/value "\\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(8 x \\right)}\\right)+C"] [:db/ensure "e740253a-8298-550f-879e-caa0ff00a294" :answer/validate] [:db/add "ae2a61db-1b69-5e72-b058-0c91779f9cde" :answer/id #uuid "ae2a61db-1b69-5e72-b058-0c91779f9cde"] [:db/add "ae2a61db-1b69-5e72-b058-0c91779f9cde" :answer/type :answer.type/math] [:db/add "ae2a61db-1b69-5e72-b058-0c91779f9cde" :answer/value "\\frac{3}{4}\\left