^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arcsec}{\\left(u \\right)}}{9}+C \\\\  &= \\frac{\\operatorname{arcsec}{\\left(9 x \\right)}}{9}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52f20127-7026-51bd-b9eb-d3aaffbd7897" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\operatorname{arcsec}{\\left(6 x \\right)}}{6}+C" :db/id #edb/ref 17592186676928} {:answer/id #uuid "a926cb91-61f3-563f-8349-379a686c3646" :answer/type {:db/ident :answer.type/math} :answer/value "30 \\operatorname{arcsec}{\\left(6 x \\right)}+C" :db/id #edb/ref 17592186676983} {:answer/id #uuid "bab46891-026f-5774-bdfe-32c494dd6b77" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\operatorname{arcsec}{\\left(36 x \\right)}+C" :db/id #edb/ref 17592186676995} {:answer/id #uuid "c3d34534-5046-50b0-a039-b5b4e49d9381" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\operatorname{arcsec}{\\left(6 x \\right)}}{36}+C" :db/id #edb/ref 17592186677002} {:answer/id #uuid "f8e644d1-662e-52e7-b469-8b247975de27" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\operatorname{arcsec}{\\left(6 x \\right)}+C" :db/id #edb/ref 17592186677036}] :answer-field/correct {:answer/id #uuid "f8e644d1-662e-52e7-b469-8b247975de27" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\operatorname{arcsec}{\\left(6 x \\right)}+C" :db/id #edb/ref 17592186677036} :answer-field/id #uuid "6d4e21a5-098c-5819-b7c8-0666c70ecb95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676941}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3feb255f-aeba-5dbb-91d6-6231c18cb161" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{5}{|x|\\sqrt{36 x^{2} - 1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=6 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6,\\qquad \\mathrm{d}x=(\\frac{1}{6})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|6 x|=6|x|,\\qquad \\frac{1}{|x|}=\\frac{6}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{5}{|x|\\sqrt{36 x^{2} - 1}}\\,\\mathrm{d}x \\\\  &= 30\\int \\frac{1}{|6 x|\\sqrt{(6 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 30(\\frac{1}{6})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 5\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 5 \\operatorname{arcsec}{\\left(u \\right)}+C \\\\  &= 5 \\operatorname{arcsec}{\\left(6 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|6 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15e65e07-085b-550a-a717-82d2d0a4449f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\operatorname{arcsec}{\\left(8 x \\right)}}{64}+C" :db/id #edb/ref 17592186676887} {:answer/id #uuid "1d199601-926c-5873-9d3f-90aebc32fddf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\operatorname{arcsec}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676891} {:answer/id #uuid "b71fa791-be0c-5a48-a50c-ab3294c89e93" :answer/type {:db/ident :answer.type/math} :answer/value "9 \\operatorname{arcsec}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676991} {:answer/id #uuid "e2e87151-dca4-5f40-a571-21cca555c271" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\operatorname{arcsec}{\\left(x \\right)}}{8}+C" :db/id #edb/ref 17592186677018} {:answer/id #uuid "fc8cda26-f6