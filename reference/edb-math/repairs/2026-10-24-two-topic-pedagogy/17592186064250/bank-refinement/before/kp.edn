\\int \\frac{2}{|2 x|\\sqrt{4 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(2 x \\right)}+C.\n$$"} {:db/id #edb/ref 17592186679070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6cf756-f438-5468-b2ac-a1a776c0186b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678950} {:answer/id #uuid "2edf2af8-329a-558f-9a49-44d53d51089a" :answer/type {:db/ident :answer.type/math} :answer/value "\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u" :db/id #edb/ref 17592186678966} {:answer/id #uuid "3e474cd7-7f34-5a64-bab1-3c3a2b0f75b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678972} {:answer/id #uuid "674b7b7c-6378-5abc-9d6c-fc9b19a1f412" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679002} {:answer/id #uuid "fe63a10d-a712-51b7-9c53-b15089294653" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679104}] :answer-field/correct {:answer/id #uuid "2edf2af8-329a-558f-9a49-44d53d51089a" :answer/type {:db/ident :answer.type/math} :answer/value "\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u" :db/id #edb/ref 17592186678966} :answer-field/id #uuid "01af17da-f496-51ca-bfbc-212a3fe55113" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field