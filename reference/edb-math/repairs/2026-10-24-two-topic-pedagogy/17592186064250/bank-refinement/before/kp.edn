{arcsec}{\\left(u \\right)}+C \\\\  &= 9 \\operatorname{arcsec}{\\left(\\sqrt{7} x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|\\sqrt{7} x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186677022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f6ae5e-13b1-5d98-ad21-85c5db855690" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\operatorname{arcsec}{\\left(7 x \\right)}}{7}+C" :db/id #edb/ref 17592186676899} {:answer/id #uuid "2cfb56c8-c193-500d-8069-1875caf5cdec" :answer/type {:db/ident :answer.type/math} :answer/value "8 \\operatorname{arcsec}{\\left(7 x \\right)}+C" :db/id #edb/ref 17592186676902} {:answer/id #uuid "a2305993-b75e-568a-b17f-56fd24469b05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\operatorname{arcsec}{\\left(x \\right)}}{7}+C" :db/id #edb/ref 17592186676977} {:answer/id #uuid "b05682a8-ee96-5382-b3bc-5a9f5f4c3460" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\operatorname{arcsec}{\\left(7 x \\right)}}{49}+C" :db/id #edb/ref 17592186676987} {:answer/id #uuid "cf98bfc5-b321-5f5f-9e9b-a7a3431c3b74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\operatorname{arctan}{\\left(7 x \\right)}}{7}+C" :db/id #edb/ref 17592186677011}] :answer-field/correct {:answer/id #uuid "26f6ae5e-13b1-5d98-ad21-85c5db855690" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\operatorname{arcsec}{\\left(7 x \\right)}}{7}+C" :db/id #edb/ref 17592186676899} :answer-field/id #uuid "71ec24ab-1b85-5c39-bff9-ac067e868069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676944}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e7dddafc-acd5-5fc7-9ee2-2276b6e756b8" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{8}{|7 x|\\sqrt{(7 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=7 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=7,\\qquad \\mathrm{d}x=(\\frac{1}{7})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|7 x|=7|x|,\\qquad \\frac{1}{|x|}=\\frac{7}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{8}{|7 x|\\sqrt{(7 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 8\\int \\frac{1}{|7 x|\\sqrt{(7 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 8(\\frac{1}{7})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{8}{7}\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{8 \\operatorname{arcsec}{\\left(u \\right)}}{7}+C \\\\  &= \\frac{8 \\operatorname{arcsec}{\\left(7 x \\right)}}{7}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186677040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1073775f-1bbc-52ab-8c7e-572379bc0994" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(15 x \\right)}+C" :db/id #edb/ref 17592186676882} {:answer/id #uuid "4834c340-bc67-5aa0-8c75-aeeabb21803e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(15 x \\right)}}{15}+C" :db/id #edb/ref 17592186676921} {:answer/id #uuid "7f47e282-f70d-54a9-bb2f-de9b835c81b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(15 x \\right)}}{225}+C" :db/id #edb/ref 17592186676956} {:answer/id #uuid "860f1311-ba28-51b2-8a6b-3ee81d4d44ef" :answer/type {:db/ident :answer.type/math} :answer/value "15 \\operatorname{arcsec}{\\left(15 x \\right)}+C" :db/id #edb/ref 17592186676961} {:answer/id #uuid "c0dc