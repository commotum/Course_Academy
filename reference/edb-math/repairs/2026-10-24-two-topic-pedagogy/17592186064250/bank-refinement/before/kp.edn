}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{5}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093e8ee9-6706-5ac0-9856-c97b4df6f556" :answer/type {:db/ident :answer.type/math} :answer/value "9 \\operatorname{arcsec}{\\left(9 x \\right)}+C" :db/id #edb/ref 17592186676879} {:answer/id #uuid "2d562848-1d97-52e5-9683-cb014d13bdb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(9 x \\right)}+C" :db/id #edb/ref 17592186676903} {:answer/id #uuid "520052f9-511f-5463-abd6-61c01b26c6c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(81 x \\right)}+C" :db/id #edb/ref 17592186676927} {:answer/id #uuid "7616d1f3-8012-52d1-b910-e3117af611f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(9 x \\right)}}{9}+C" :db/id #edb/ref 17592186676948} {:answer/id #uuid "f781316b-ad0d-5599-b0d1-a715216cc7e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(9 x \\right)}}{81}+C" :db/id #edb/ref 17592186677032}] :answer-field/correct {:answer/id #uuid "2d562848-1d97-52e5-9683-cb014d13bdb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(9 x \\right)}+C" :db/id #edb/ref 17592186676903} :answer-field/id #uuid "60467e61-e7b2-548a-a8c4-112122fa9c9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676938}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1330265e-12c1-57f0-82dd-95378d9f20b0" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{9}{|9 x|\\sqrt{(9 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=9 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9,\\qquad \\mathrm{d}x=(\\frac{1}{9})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|9 x|=9|x|,\\qquad \\frac{1}{|x|}=\\frac{9}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{9}{|9 x|\\sqrt{(9 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 9\\int \\frac{1}{|9 x|\\sqrt{(9 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 9(\\frac{1}{9})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 1\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\operatorname{arcsec}{\\left(u \\right)}+C \\\\  &= \\operatorname{arcsec}{\\left(9 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20bf9841-2595-5f27-b0e8-1e9284708c28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(x \\right)}}{8}+C" :db/id #edb/ref 17592186676896} {:answer/id #uuid "6e42acbb-4f56-56be-a048-fba84c7dc573" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676942} {:answer/id #uuid "7e019ca5-2476-5cb5-892a-c3f42ebb26e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676954} {:answer/id #uuid "b68e91f4-197a-5d0d-9aa6-776bde1a3333" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(8 x \\right)}}{64}+C" :db/id #edb/ref 17592186676990} {:answer/id #uuid "f2f477b1-1575-5b4e-ba38-698f5d0ef3a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186677029}] :answer-field/correct {:answer/id #uuid "7e019ca5-2476-5cb5-892a-c3f42ebb26e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676954} :answer-field/id #uuid "f8007ccb-32ea-5c4e-8b8c-8bb848c4c191" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677033}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "184d3205-f072-5ec2-ae47-f41ae45b3346" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{|8 x|\\sqrt{(8 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|8 x|=8|x|,\\qquad \\frac{1}{|x|}=\\frac{8}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{|8 x|\\sqrt{(8 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 1\\int \\frac{1}{|8 x|\\sqrt{(8 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 1(\\frac{1}{8})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{8}\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arcsec}{\\left(u \\right)}}{8}+C \\\\  &= \\frac{\\operatorname{arcsec}{\\left(8 x \\right)}}{8}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49ebbcc4-6039-5bf0-998a-dded9c3941e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(14 x \\right)}}{14}+C" :db/id #edb/ref 17592186676922} {:answer/id #uuid "74cae605-ea8d-5ca5-8033-c10411a836ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(14 x \\right)}}{196}+C" :db/id #edb/ref 17592186676946} {:answer/id #uuid "ab2399d7-22bf-5740-880c-727575b60c80" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(14 x \\right)}+C" :db/id #edb/ref 17592186676984} {:answer/id #uuid "c7a55cec-6a4f-5cd8-bd20-ddc037f3250e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(196 x \\right)}+C" :db/id #edb/ref 17592186677007} {:answer/id #uuid "eed14417-4f9a-5aae-9ec6-27bba65a8975" :answer/type {:db/ident :answer.type/math} :answer/value "14 \\operatorname{arcsec}{\\left(14 x \\right)}+C" :db/id #edb/ref 17592186677026}] :answer-field/correct {:answer/id #uuid "ab2399d7-22bf-5740-880c-727575b60c80" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(14 x \\right)}+C" :db/id #edb/ref 17592186676984} :answer-field/id #uuid "3494f9ef-9b8c-50b2-931e-8e49eba77f3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676910}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2c86da1f-3334-519e-bd8d-02dc5abc2552" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{14}{|14 x|\\sqrt{(14 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=14 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=14,\\qquad \\mathrm{d}x=(\\frac{1}{14})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|14 x|=14|x|,\\qquad \\frac{1}{|x|}=\\frac{14}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{14}{|14 x|\\sqrt{(14 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 14\\int \\frac{1}{|14 x|\\sqrt{(14 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 14(\\frac{1}{14})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 1\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\operatorname{arcsec}{\\left(u \\right)}+C \\\\  &= \\operatorname{arcsec}{\\left(14 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|14 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0be1ee-1432-52ae-9e94-69b713d648c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(121 x \\right)}+C" :db/id #edb/ref 17592186676880} {:answer/id #uuid "59b25816-1279-51cb-af04-13bca7bd5f42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(11 x \\right)}}{121}+C" :db/id #edb/ref 17592186676933} {:answer/id #uuid "626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9" :answer/type {:db/ident :answer.type/math} :answer/value "11 \\operatorname{arcsec}{\\left(11 x \\right)}+C" :db/id #edb/ref 17592186676939} {:answer/id #uuid "b8d7fe7e-90a9-577a-92c4-5851d113ae44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(11 x \\right)}}{11}+C" :db/id #edb/ref 17592186676992} {:answer/id #uuid "f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(11 x \\right)}+C" :db/id #edb/ref 17592186677035}] :answer-field/correct {:answer/id #uuid "f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(11 x \\right)}+C" :db/id #edb/ref 17592186677035} :answer-field/id #uuid "c8f4c10b-4483-58bc-be77-10c8b0e9c52b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677009}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2cb5a03d-f884-5440-bad0-52e5f286b6f3" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{11}{|11 x|\\sqrt{(11 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=11 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=11,\\qquad \\mathrm{d}x=(\\frac{1}{11})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|11 x|=11|x|,\\qquad \\frac{1}{|x|}=\\frac{11}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{11}{|11 x|\\sqrt{(11 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 11\\int \\frac{1}{|11 x|\\sqrt{(11 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 11(\\frac{1}{11})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 1\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\operatorname{arcsec}{\\left(u \\right)}+C \\\\  &= \\operatorname{arcsec}{\\left(11 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|11 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11627a8d-6425-5a99-b9f4-e08ef26dbb78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsec}{\\left(9 x \\right)}}{9}+C" :db/id #edb/ref 17592186676883} {:answer/id #uuid "54c12a5d-b905-54d9-b018-d803a7bc0aa0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}{\\left(9 x \\right)}+C" :db/id #edb/ref 17592186676930} {:answer/id #uuid "5926164f-fed6-5e3a-ba40-860db0a5ab38" :answe