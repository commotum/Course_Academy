\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "5a88e33b-bcc9-5d5e-854e-716b08caf25b" :question/difficulty :question.difficulty/easy] [:db/add "5a88e33b-bcc9-5d5e-854e-716b08caf25b" :question/answer-fields "dd581dc8-7072-5e17-a1d9-7722221a47a2"] [:db/ensure "5a88e33b-bcc9-5d5e-854e-716b08caf25b" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "5a88e33b-bcc9-5d5e-854e-716b08caf25b"] [:db/add "ee416b02-f6d8-5944-80fd-be5c1139ab5b" :answer/id #uuid "ee416b02-f6d8-5944-80fd-be5c1139ab5b"] [:db/add "ee416b02-f6d8-5944-80fd-be5c1139ab5b" :answer/type :answer.type/math] [:db/add "ee416b02-f6d8-5944-80fd-be5c1139ab5b" :answer/value "\\frac{3}{16}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)"] [:db/ensure "ee416b02-f6d8-5944-80fd-be5c1139ab5b" :answer/validate] [:db/add "bf2c5ecf-f3f2-5296-9a0c-c0709aac3499" :answer/id #uuid "bf2c5ecf-f3f2-5296-9a0c-c0709aac3499"] [:db/add "bf2c5ecf-f3f2-5296-9a0c-c0709aac3499" :answer/type :answer.type/math] [:db/add "bf2c5ecf-f3f2-5296-9a0c-c0709aac3499" :answer/value "\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)"] [:db/ensure "bf2c5ecf-f3f2-5296-9a0c-c0709aac3499" :answer/validate] [:db/add "73f79e13-5a4d-54bc-bc00-e8736a06220a" :answer/id #uuid "73f79e13-5a4d-54bc-bc00-e8736a06220a"] [:db/add "73f79e13-5a4d-54bc-bc00-e8736a06220a" :answer/type :answer.type/math] [:db/add "73f79e13-5a4d-54bc-bc00-e8736a06220a" :answer/value "\\frac{1}{4}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)"] [:db/ensure "73f79e13-5a4d-54bc-bc00-e8736a06220a" :answer/validate] [:db/add "60092078-6452-5e24-a9d5-9fa39bdb5e4b" :answer/id #uuid "60092078-6452-5e24-a9d5-9fa39bdb5e4b"] [:db/add "60092078-6452-5e24-a9d5-9fa39bdb5e4b" :answer/type :answer.type/math] [:db/add "60092078-6452-5e24-a9d5-9fa39bdb5e4b" :answer/value "- \\frac{9}{4}\\left(\\int \\frac{1}{\\sqrt{u