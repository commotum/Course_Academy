ght).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C.\n$$"] [:db/add "40b27085-34e6-58d6-ab38-f796eb2eb64b" :question/difficulty :question.difficulty/moderate] [:db/add "40b27085-34e6-58d6-ab38-f796eb2eb64b" :question/answer-fields "021c7d86-f00a-57fa-8bfe-7262334eefe1"] [:db/ensure "40b27085-34e6-58d6-ab38-f796eb2eb64b" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "40b27085-34e6-58d6-ab38-f796eb2eb64b"] [:db/add "35abe1d1-b7ba-531f-8f3e-5d308559245a" :answer/id #uuid "35abe1d1-b7ba-531f-8f3e-5d308559245a"] [:db/add "35abe1d1-b7ba-531f-8f3e-5d308559245a" :answer/type :answer.type/math] [:db/add "35abe1d1-b7ba-531f-8f3e-5d308559245a" :answer/value "\\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "35abe1d1-b7ba-531f-8f3e-5d308559245a" :answer/validate] [:db/add "9a476002-ac5f-52af-bf76-63871a1b23ee" :answer/id #uuid "9a476002-ac5f-52af-bf76-63871a1b23ee"] [:db/add "9a476002-ac5f-52af-bf76-63871a1b23ee" :answer/type :answer.type/math] [:db/add "9a476002-ac5f-52af-bf76-63871a1b23ee" :answer/value "\\frac{3}{8}\\left(\\operatorname{arcsec}{\\left(8 x \\right)}\\right)+C"] [:db/ensure "9a476002-ac5f-52af-bf76-63871a1b23ee" :answer/validate] [:db/add "61b87488-e1b1-56c7-8df9-6b876e4d81bd" :answer/id #uuid "61b87488-e1b1-56c7-8df9-6b876e4d81bd"] [:db/add "61b87488-e1b1-56c7-8df9-6b876e4d81bd" :answer/type :answer.type/math] [:db/add "61b87488-e1b1-56c7-8df9-6b876e4d81bd" :answer/value "\\frac{3}{2}\\left(\\operatorname{arcsec}{\\left(8 x \\right)}\\right)+C"] [:db/ensure "61b87488-e1b1-56c7-8df9-6b876e4d81bd" :answer/validate] [:db/add "37fa1250-948e-5d74-b739-568c930134a9" :answer/id #uuid "37fa1250-948e-5d74-b739-568c930134a9"] [:db