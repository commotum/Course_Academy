$$\n\\frac{4}{3}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(3 x \\right)}\\right)+C.\n$$"] [:db/add "9f5792d0-9c5b-52ee-9935-fa165bdce327" :question/difficulty :question.difficulty/moderate] [:db/add "9f5792d0-9c5b-52ee-9935-fa165bdce327" :question/answer-fields "00e82129-7eda-53bc-88cc-0e45dcbad61e"] [:db/ensure "9f5792d0-9c5b-52ee-9935-fa165bdce327" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "9f5792d0-9c5b-52ee-9935-fa165bdce327"] [:db/add "c232732a-db29-5875-8154-305ac841267d" :answer/id #uuid "c232732a-db29-5875-8154-305ac841267d"] [:db/add "c232732a-db29-5875-8154-305ac841267d" :answer/type :answer.type/math] [:db/add "c232732a-db29-5875-8154-305ac841267d" :answer/value "\\frac{4}{5}\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "c232732a-db29-5875-8154-305ac841267d" :answer/validate] [:db/add "ab63aa8c-62ba-5c8c-b205-9e1d92a9052c" :answer/id #uuid "ab63aa8c-62ba-5c8c-b205-9e1d92a9052c"] [:db/add "ab63aa8c-62ba-5c8c-b205-9e1d92a9052c" :answer/type :answer.type/math] [:db/add "ab63aa8c-62ba-5c8c-b205-9e1d92a9052c" :answer/value "\\frac{8}{5}\\left(\\operatorname{arcsec}{\\left(x \\right)}\\right)+C"] [:db/ensure "ab63aa8c-62ba-5c8c-b205-9e1d92a9052c" :answer/validate] [:db/add "d3b722ee-7fcd-5510-ba61-91bb9c65258e" :answer/id #uuid "d3b722ee-7fcd-5510-ba61-91bb9c65258e"] [:db/add "d3b722ee-7fcd-5510-ba61-91bb9c65258e" :answer/type :answer.type/math] [:db/add "d3b722ee-7fcd-5510-ba61-91bb9c65258e" :answer/value "- \\frac{4}{5}\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "d3b722ee-7fcd-5510-ba61-91bb9c65258e" :answer/validate] [:db/add "25b04917-3e2e-511f-af2b-c28a5d7511f5" :answer/id #uuid "25b04917-3e2e-511f-af2b-c28a5d7511f5"] [:db/add "25b04917-3e2e-511f-af2b-c28a5d7511f5" :answer/type :