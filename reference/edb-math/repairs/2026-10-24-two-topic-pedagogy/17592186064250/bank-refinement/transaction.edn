} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C$.\n\nWork on a connected interval where $|4 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "7557536f-4126-5553-aa32-304478d3cfce" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|4 x|>1$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{4}=\\frac{3}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{|4 x|\\sqrt{16 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=\\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C.\n$$"] [:db/add "7557536f-4126-5553-aa32-304478d3cfce" :question/difficulty :question.difficulty/moderate] [:db/add "7557536f-4126-5553-aa32-304478d3cfce" :question/answer-fields "32368e13-0345-5935-ade8-e3ec1338c7dc"] [:db/ensure "7557536f-4126-5553-aa32-304478d3cfce" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "7557536f-4126-5553-aa32-304478d3cfce"] [:db/add "9b09972a-d5da-5894-b5c6-29eda9816c52" :answer/id #uuid "9b09972a-d5da-5894-b5c6-29eda9816c52"] [:db/add "9b09972a-d5da-5894-b5c6-29eda9816c52" :answer/type :answer.type/math] [:db/add "9b09972a-d5da-5894-b5c6-29eda9816c52" :answer/value "- \\frac{2}{3}\\left(\\operatorname{arcsec}{\\left(x \\right)}\\right)+C"] [:db/ensure "9b09972a-d5da-5894-b5c6-29eda9816c52" :answer/validate] [:db/add "63879433-a599-50d9-af42-eabbbe9ff7a0" :answer/id #uuid "63879433-a599-50d9-af42-eabbbe9ff7a0"] [:db/add "63879433-a599-50d9-af42-eabbbe9ff7