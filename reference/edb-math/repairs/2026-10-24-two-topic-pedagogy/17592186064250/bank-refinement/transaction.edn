ulty :question.difficulty/hard] [:db/add "cbfeac20-e0ab-547c-9174-31fab0729907" :question/answer-fields "f2557e05-1d1d-59ae-bac0-cf51192b42a9"] [:db/ensure "cbfeac20-e0ab-547c-9174-31fab0729907" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "cbfeac20-e0ab-547c-9174-31fab0729907"] [:db/add "16b2d4ef-e63d-5505-b7d9-f37f61d625d9" :answer/id #uuid "16b2d4ef-e63d-5505-b7d9-f37f61d625d9"] [:db/add "16b2d4ef-e63d-5505-b7d9-f37f61d625d9" :answer/type :answer.type/math] [:db/add "16b2d4ef-e63d-5505-b7d9-f37f61d625d9" :answer/value "-2\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "16b2d4ef-e63d-5505-b7d9-f37f61d625d9" :answer/validate] [:db/add "8fe3a467-f753-5f74-9801-d0f11c60b24e" :answer/id #uuid "8fe3a467-f753-5f74-9801-d0f11c60b24e"] [:db/add "8fe3a467-f753-5f74-9801-d0f11c60b24e" :answer/type :answer.type/math] [:db/add "8fe3a467-f753-5f74-9801-d0f11c60b24e" :answer/value "2\\left(\\operatorname{arcsec}{\\left(10 x \\right)}\\right)+C"] [:db/ensure "8fe3a467-f753-5f74-9801-d0f11c60b24e" :answer/validate] [:db/add "3796c0ea-cde4-58eb-a226-0de3696f41e8" :answer/id #uuid "3796c0ea-cde4-58eb-a226-0de3696f41e8"] [:db/add "3796c0ea-cde4-58eb-a226-0de3696f41e8" :answer/type :answer.type/math] [:db/add "3796c0ea-cde4-58eb-a226-0de3696f41e8" :answer/value "2\\left(\\operatorname{arcsec}{\\left(\\frac{5 x}{2} \\right)}\\right)+C"] [:db/ensure "3796c0ea-cde4-58eb-a226-0de3696f41e8" :answer/validate] [:db/add "450ac2fe-1a99-5118-a833-347f59ea9da3" :answer/id #uuid "450ac2fe-1a99-5118-a833-347f59ea9da3"] [:db/add "450ac2fe-1a99-5118-a833-347f59ea9da3" :answer/type :answer.type/math] [:db/add "450ac2fe-1a99-5118-a833-347f59ea9da3" :answer/value "\\operatorname{arcsec}{\\left(10 x \\right)}+C"] [:db/ensure "450ac2fe-1a99-5118-a833-347f59ea9da3" :answer/validate] [:db/add "c59f6e77-cc20-5320-b7ce-d852ba60f52e" :answer/id #uuid "c59f6e77-cc20-5320-b7ce-d852ba60f52e"] [:db/add "c59f6e77-cc20-5320-b7ce-d852ba60f52e" :answer/type :answe