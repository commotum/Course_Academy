[:db/ensure \"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/validate] [:db/add \"7557536f-4126-5553-aa32-304478d3cfce\" :question/id #uuid \"7557536f-4126-5553-aa32-304478d3cfce\"] [:db/add \"7557536f-4126-5553-aa32-304478d3cfce\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"7557536f-4126-5553-aa32-304478d3cfce\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"7557536f-4126-5553-aa32-304478d3cfce\" :question/difficulty :question.difficulty/moderate] [:db/add \"7557536f-4126-5553-aa32-304478d3cfce\" :question/answer-fields \"32368e13-0345-5935-ade8-e3ec1338c7dc\"] [:db/ensure \"7557536f-4126-5553-aa32-304478d3cfce\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"7557536f-4126-5553-aa32-304478d3cfce\"] [:db/add \"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/id #uuid \"9b09972a-d5da-5894-b5c6-29eda9816c52\"] [:db/add \"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/type :answer.type/math] [:db/add \"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/validate] [:db/add \"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/id #uuid \"63879433-a599-50d9-af42-eabbbe9ff7a0\"] [:db/add \"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/type :answer.type/math] [:db/add \"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [:db/ensure \"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/validate] [:db/add \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/id #uuid \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\"] [:db/add \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/type :answer.type/math] [:db/add \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/validate] [:db/add \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/id #uuid \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\"] [:db/add \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/type :answer.type/math] [:db/add \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/validate] [:db/add \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/id #uuid \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\"] [:db/add \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/type :answer.type/math] [:db/add \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/validate] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/id #uuid \"16c44766-281e-567b-9905-b8d866c56e67\"] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/key \"answer\"] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/type :answer-field.type/radio] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"9b09972a-d5da-5894-b5c6-29eda9816c52\"] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"63879433-a599-50d9-af42-eabbbe9ff7a0\"] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\"] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\"] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\"] [:db/add \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/correct \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\"] [:db/ensure \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/validate] [:db/add \"8200acbd-0096-5a04-af42-dd11117a204a\" :question/id #uuid \"8200acbd-0096-5a04-af42-dd11117a204a\"] [:db/add \"8200acbd-0096-5a04-af42-dd11117a204a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"8200acbd-0096-5a04-af42-dd11117a204a\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"8200acbd-0096-5a04-af42-dd11117a204a\" :question/difficulty :question.difficulty/moderate] [:db/add \"8200acbd-0096-5a04-af42-dd11117a204a\" :question/answer-fields \"16c44766-281e-567b-9905-b8d866c56e67\"] [:db/ensure \"8200acbd-0096-5a04-af42-dd11117a204a\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"8200acbd-0096-5a04-af42-dd11117a204a\"] [:db/add \"83d848f7-df88-5583-a04b-708515325915\" :answer/id #uuid \"83d848f7-df88-5583-a04b-708515325915\"] [:db/add \"83d848f7-df88-5583-a04b-708515325915\" :answer/type :answer.type/math] [:db/add \"83d848f7-df88-5583-a04b-708515325915\" :answer/value \"\\\\frac{6}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"83d848f7-df88-5583-a04b-708515325915\" :answer/validate] [:db/add \"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/id #uuid \"1fd78838-add0-5184-a216-6e1e6e35e6fd\"] [:db/add \"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/type :answer.type/math] [:db/add \"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/validate] [:db/add \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/id #uuid \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\"] [:db/add \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/type :answer.type/math] [:db/add \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/validate] [:db/add \"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/id #uuid \"1b86c668-9c14-5fd7-b4a8-e830266452d1\"] [:db/add \"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/type :answer.type/math] [:db/add \"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [:db/ensure \"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/validate] [:db/add \"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/id #uuid \"08c60dee-8be6-5408-826e-7205668d1b78\"] [:db/add \"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/type :answer.type/math] [:db/add \"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [:db/ensure \"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/validate] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/id #uuid \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\"] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/key \"answer\"] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/type :answer-field.type/radio] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"83d848f7-df88-5583-a04b-708515325915\"] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"1fd78838-add0-5184-a216-6e1e6e35e6fd\"] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\"] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"1b86c668-9c14-5fd7-b4a8-e830266452d1\"] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"08c60dee-8be6-5408-826e-7205668d1b78\"] [:db/add \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/correct \"08c60dee-8be6-5408-826e-7205668d1b78\"] [:db/ensure \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/validate] [:db/add \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/id #uuid \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\"] [:db/add \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/difficulty :question.difficulty/moderate] [:db/add \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/answer-fields \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\"] [:db/ensure \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\"] [:db/add \"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/id #uuid \"5a75205a-6fec-50af-b81c-a92046480f5b\"] [:db/add \"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/type :answer.type/math] [:db/add \"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/validate] [:db/add \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/id #uuid \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\"] [:db/add \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/type :answer.type/math] [:db/add \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/validate] [:db/add \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/id #uuid \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\"] [:db/add \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/type :answer.type/math] [:db/add \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/validate] [:db/add \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/id #uuid \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\"] [:db/add \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/type :answer.type/math] [:db/add \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [:db/ensure \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/validate] [:db/add \"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/id #uuid \"c964a6ce-c06b-541d-819a-91229e5e003a\"] [:db/add \"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/type :answer.type/math] [:db/add \"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/validate] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/id #uuid \"9168c6ea-695d-5c34-9a06-19e028f21093\"] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/key \"answer\"] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/type :answer-field.type/radio] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"5a75205a-6fec-50af-b81c-a92046480f5b\"] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\"] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\"] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\"] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"c964a6ce-c06b-541d-819a-91229e5e003a\"] [:db/add \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/correct \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\"] [:db/ensure \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/validate] [:db/add \"f1f49f83-41db-5881-9619-52564f75d31c\" :question/id #uuid \"f1f49f83-41db-5881-9619-52564f75d31c\"] [:db/add \"f1f49f83-41db-5881-9619-52564f75d31c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"f1f49f83-41db-5881-9619-52564f75d31c\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $6\\\\cdot \\\\frac{1}{3}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"f1f49f83-41db-5881-9619-52564f75d31c\" :question/difficulty :question.difficulty/hard] [:db/add \"f1f49f83-41db-5881-9619-52564f75d31c\" :question/answer-fields \"9168c6ea-695d-5c34-9a06-19e028f21093\"] [:db/ensure \"f1f49f83-41db-5881-9619-52564f75d31c\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"f1f49f83-41db-5881-9619-52564f75d31c\"] [:db/add \"54529229-e39d-5828-9aaa-f10c52168335\" :answer/id #uuid \"54529229-e39d-5828-9aaa-f10c52168335\"] [:db/add \"54529229-e39d-5828-9aaa-f10c52168335\" :answer/type :answer.type/math] [:db/add \"54529229-e39d-5828-9aaa-f10c52168335\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"54529229-e39d-5828-9aaa-f10c52168335\" :answer/validate] [:db/add \"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/id #uuid \"4d67807f-f051-58a0-a4be-685c094bc679\"] [:db/add \"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/type :answer.type/math] [:db/add \"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [:db/ensure \"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/validate] [:db/add \"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/id #uuid \"ff03e90e-2efc-5b40-9dd7-08a938701e62\"] [:db/add \"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/type :answer.type/math] [:db/add \"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/validate] [:db/add \"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/id #uuid \"2807e6ed-28f0-59f1-b084-b1172e2711dd\"] [:db/add \"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/type :answer.type/math] [:db/add \"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/validate] [:db/add \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/id #uuid \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\"] [:db/add \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/type :answer.type/math] [:db/add \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/validate] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/id #uuid \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\"] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/key \"answer\"] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/type :answer-field.type/radio] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"54529229-e39d-5828-9aaa-f10c52168335\"] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"4d67807f-f051-58a0-a4be-685c094bc679\"] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"ff03e90e-2efc-5b40-9dd7-08a938701e62\"] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"2807e6ed-28f0-59f1-b084-b1172e2711dd\"] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\"] [:db/add \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/correct \"54529229-e39d-5828-9aaa-f10c52168335\"] [:db/ensure \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/validate] [:db/add \"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/id #uuid \"cbfeac20-e0ab-547c-9174-31fab0729907\"] [:db/add \"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{4}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/difficulty :question.difficulty/hard] [:db/add \"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/answer-fields \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\"] [:db/ensure \"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"cbfeac20-e0ab-547c-9174-31fab0729907\"] [:db/add \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/id #uuid \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\"] [:db/add \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/type :answer.type/math] [:db/add \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [:db/ensure \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/validate] [:db/add \"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/id #uuid \"8fe3a467-f753-5f74-9801-d0f11c60b24e\"] [:db/add \"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/type :answer.type/math] [:db/add \"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\"] [:db/ensure \"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/validate] [:db/add \"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/id #uuid \"3796c0ea-cde4-58eb-a226-0de3696f41e8\"] [:db/add \"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/type :answer.type/math] [:db/add \"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/validate] [:db/add \"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/id #uuid \"450ac2fe-1a99-5118-a833-347f59ea9da3\"] [:db/add \"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/type :answer.type/math] [:db/add \"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\"] [:db/ensure \"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/validate] [:db/add \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/id #uuid \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\"] [:db/add \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/type :answer.type/math] [:db/add \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [:db/ensure \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/validate] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/id #uuid \"bfd70697-b91d-5c47-a181-3da1acce89c9\"] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/key \"answer\"] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/type :answer-field.type/radio] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\"] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"8fe3a467-f753-5f74-9801-d0f11c60b24e\"] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"3796c0ea-cde4-58eb-a226-0de3696f41e8\"] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"450ac2fe-1a99-5118-a833-347f59ea9da3\"] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\"] [:db/add \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/correct \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\"] [:db/ensure \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/validate] [:db/add \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/id #uuid \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\"] [:db/add \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $10\\\\cdot \\\\frac{1}{5}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/difficulty :question.difficulty/hard] [:db/add \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/answer-fields \"bfd70697-b91d-5c47-a181-3da1acce89c9\"] [:db/ensure \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\"] [:db/add \"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/id #uuid \"513725b9-174c-57d6-b726-87c5f271d0ad\"] [:db/add \"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/type :answer.type/math] [:db/add \"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [:db/ensure \"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/validate] [:db/add \"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/id #uuid \"84bd64a7-02b2-590b-94bf-390d16a28f56\"] [:db/add \"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/type :answer.type/math] [:db/add \"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/validate] [:db/add \"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/id #uuid \"e734e59e-f86e-5bf3-89e2-d816b06704ab\"] [:db/add \"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/type :answer.type/math] [:db/add \"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/validate] [:db/add \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/id #uuid \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\"] [:db/add \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/type :answer.type/math] [:db/add \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/validate] [:db/add \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/id #uuid \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\"] [:db/add \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/type :answer.type/math] [:db/add \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/validate] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/id #uuid \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\"] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/key \"answer\"] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/type :answer-field.type/radio] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"513725b9-174c-57d6-b726-87c5f271d0ad\"] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"84bd64a7-02b2-590b-94bf-390d16a28f56\"] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"e734e59e-f86e-5bf3-89e2-d816b06704ab\"] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\"] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\"] [:db/add \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/correct \"84bd64a7-02b2-590b-94bf-390d16a28f56\"] [:db/ensure \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/validate] [:db/add \"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/id #uuid \"e5ce8791-8926-5237-bce9-217f5aba6353\"] [:db/add \"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $16\\\\cdot \\\\frac{1}{4}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/difficulty :question.difficulty/hard] [:db/add \"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/answer-fields \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\"] [:db/ensure \"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"e5ce8791-8926-5237-bce9-217f5aba6353\"] [:db/add \"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/id #uuid \"0e289e71-2a3b-558f-8969-f46ee6549e1b\"] [:db/add \"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/type :answer.type/math] [:db/add \"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/validate] [:db/add \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/id #uuid \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\"] [:db/add \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/type :answer.type/math] [:db/add \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/validate] [:db/add \"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/id #uuid \"5a9cc8c8-be9a-521e-a793-afe0886d5354\"] [:db/add \"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/type :answer.type/math] [:db/add \"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/validate] [:db/add \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/id #uuid \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\"] [:db/add \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/type :answer.type/math] [:db/add \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/value \"-1\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/validate] [:db/add \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/id #uuid \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\"] [:db/add \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/type :answer.type/math] [:db/add \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/validate] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/id #uuid \"7557fe38-875d-5795-99c4-a36c7fd5e097\"] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/key \"answer\"] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/type :answer-field.type/radio] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"0e289e71-2a3b-558f-8969-f46ee6549e1b\"] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\"] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"5a9cc8c8-be9a-521e-a793-afe0886d5354\"] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\"] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\"] [:db/add \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/correct \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\"] [:db/ensure \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/validate] [:db/add \"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/id #uuid \"fd18704b-c686-54f7-9804-c8dbf31969bd\"] [:db/add \"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|2 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nBecause $2>0$, $|u|=2|x|$, so $|x|=|u|/2$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C.\\n$$\"] [:db/add \"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/difficulty :question.difficulty/hard] [:db/add \"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/answer-fields \"7557fe38-875d-5795-99c4-a36c7fd5e097\"] [:db/ensure \"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"fd18704b-c686-54f7-9804-c8dbf31969bd\"] [:db/add \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/id #uuid \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\"] [:db/add \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/type :answer.type/math] [:db/add \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/validate] [:db/add \"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/id #uuid \"e4878e77-2010-58f8-8642-ba3d3a29ace6\"] [:db/add \"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/type :answer.type/math] [:db/add \"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/validate] [:db/add \"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/id #uuid \"1ff30185-c84c-5002-b862-7ddba735b925\"] [:db/add \"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/type :answer.type/math] [:db/add \"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/validate] [:db/add \"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/id #uuid \"b763cb42-886b-5194-8984-6a2638a66c26\"] [:db/add \"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/type :answer.type/math] [:db/add \"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}+C\"] [:db/ensure \"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/validate] [:db/add \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/id #uuid \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\"] [:db/add \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/type :answer.type/math] [:db/add \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [:db/ensure \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/validate] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/id #uuid \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\"] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/key \"answer\"] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/type :answer-field.type/radio] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\"] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"e4878e77-2010-58f8-8642-ba3d3a29ace6\"] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"1ff30185-c84c-5002-b862-7ddba735b925\"] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"b763cb42-886b-5194-8984-6a2638a66c26\"] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\"] [:db/add \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/correct \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\"] [:db/ensure \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/validate] [:db/add \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/id #uuid \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\"] [:db/add \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C.\\n$$\"] [:db/add \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/difficulty :question.difficulty/hard] [:db/add \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/answer-fields \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\"] [:db/ensure \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\"] [:db/add \"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/id #uuid \"2658604b-a626-5178-a760-4f6e99b1f804\"] [:db/add \"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/type :answer.type/math] [:db/add \"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [:db/ensure \"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/validate] [:db/add \"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/id #uuid \"fa2e53a6-5258-5f95-88f1-f13797ab2172\"] [:db/add \"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/type :answer.type/math] [:db/add \"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [:db/ensure \"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/validate] [:db/add \"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/id #uuid \"cb30fedb-fba5-5743-bc4f-0e48589d012b\"] [:db/add \"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/type :answer.type/math] [:db/add \"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/validate] [:db/add \"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/id #uuid \"1e5bc335-b7ee-5118-928d-e6feab31911e\"] [:db/add \"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/type :answer.type/math] [:db/add \"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/validate] [:db/add \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/id #uuid \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\"] [:db/add \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/type :answer.type/math] [:db/add \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/validate] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/id #uuid \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\"] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/key \"answer\"] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/type :answer-field.type/radio] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"2658604b-a626-5178-a760-4f6e99b1f804\"] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"fa2e53a6-5258-5f95-88f1-f13797ab2172\"] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"cb30fedb-fba5-5743-bc4f-0e48589d012b\"] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"1e5bc335-b7ee-5118-928d-e6feab31911e\"] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\"] [:db/add \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/correct \"2658604b-a626-5178-a760-4f6e99b1f804\"] [:db/ensure \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/validate] [:db/add \"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/id #uuid \"491e4c26-a08b-53a0-9c8a-2f14d053b450\"] [:db/add \"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $15\\\\cdot \\\\frac{1}{5}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/difficulty :question.difficulty/hard] [:db/add \"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/answer-fields \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\"] [:db/ensure \"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"491e4c26-a08b-53a0-9c8a-2f14d053b450\"] [:db/add \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/id #uuid \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\"] [:db/add \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/type :answer.type/math] [:db/add \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/validate] [:db/add \"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/id #uuid \"84490db6-6b93-5265-8ae3-8875e2514a2e\"] [:db/add \"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/type :answer.type/math] [:db/add \"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [:db/ensure \"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/validate] [:db/add \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/id #uuid \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\"] [:db/add \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/type :answer.type/math] [:db/add \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/validate] [:db/add \"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/id #uuid \"ad349545-f06c-5647-afae-19a519da2bbb\"] [:db/add \"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/type :answer.type/math] [:db/add \"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [:db/ensure \"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/validate] [:db/add \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/id #uuid \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\"] [:db/add \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/type :answer.type/math] [:db/add \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/validate] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/id #uuid \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\"] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/key \"answer\"] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/type :answer-field.type/radio] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\"] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"84490db6-6b93-5265-8ae3-8875e2514a2e\"] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\"] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"ad349545-f06c-5647-afae-19a519da2bbb\"] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\"] [:db/add \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/correct \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\"] [:db/ensure \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/validate] [:db/add \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/id #uuid \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\"] [:db/add \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{3}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/difficulty :question.difficulty/hard] [:db/add \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/answer-fields \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\"] [:db/ensure \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/validate] [:db/add 17592186064250 :knowledge-point/questions \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\"] [:db/add \"generator\" :question-generator/id #uuid \"1fb53caa-df0e-5c70-9c5b-f0d19d4416b4\"] [:db/add \"generator\" :question-generator/script \"generators/38/3863ea472908f17e1f0524d241f4c90b18b0bfe707b9a6d2914db21b43cc6db3/generator.py\"] [:db/add 17592186064250 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186064250 :knowledge-point/validate]] \"assertions\" [[\"07cda746-87cb-5523-93ce-d92d3a75a507\" :answer/id #uuid \"07cda746-87cb-5523-93ce-d92d3a75a507\"] [\"07cda746-87cb-5523-93ce-d92d3a75a507\" :answer/type :answer.type/math] [\"07cda746-87cb-5523-93ce-d92d3a75a507\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e3d6d198-0795-5155-a94f-e9ba7449736a\" :answer/id #uuid \"e3d6d198-0795-5155-a94f-e9ba7449736a\"] [\"e3d6d198-0795-5155-a94f-e9ba7449736a\" :answer/type :answer.type/math] [\"e3d6d198-0795-5155-a94f-e9ba7449736a\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\" :answer/id #uuid \"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\"] [\"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\" :answer/type :answer.type/math] [\"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"7a05fcc2-1905-5746-b765-f0093ad64183\" :answer/id #uuid \"7a05fcc2-1905-5746-b765-f0093ad64183\"] [\"7a05fcc2-1905-5746-b765-f0093ad64183\" :answer/type :answer.type/math] [\"7a05fcc2-1905-5746-b765-f0093ad64183\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"9636625a-1efe-52f4-8200-3a1031432e07\" :answer/id #uuid \"9636625a-1efe-52f4-8200-3a1031432e07\"] [\"9636625a-1efe-52f4-8200-3a1031432e07\" :answer/type :answer.type/math] [\"9636625a-1efe-52f4-8200-3a1031432e07\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/id #uuid \"dd581dc8-7072-5e17-a1d9-7722221a47a2\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/key \"answer\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/type :answer-field.type/radio] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/choices \"07cda746-87cb-5523-93ce-d92d3a75a507\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/choices \"e3d6d198-0795-5155-a94f-e9ba7449736a\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/choices \"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/choices \"7a05fcc2-1905-5746-b765-f0093ad64183\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/choices \"9636625a-1efe-52f4-8200-3a1031432e07\"] [\"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/correct \"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\"] [\"5a88e33b-bcc9-5d5e-854e-716b08caf25b\" :question/id #uuid \"5a88e33b-bcc9-5d5e-854e-716b08caf25b\"] [\"5a88e33b-bcc9-5d5e-854e-716b08caf25b\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"5a88e33b-bcc9-5d5e-854e-716b08caf25b\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"5a88e33b-bcc9-5d5e-854e-716b08caf25b\" :question/difficulty :question.difficulty/easy] [\"5a88e33b-bcc9-5d5e-854e-716b08caf25b\" :question/answer-fields \"dd581dc8-7072-5e17-a1d9-7722221a47a2\"] [17592186064250 :knowledge-point/questions \"5a88e33b-bcc9-5d5e-854e-716b08caf25b\"] [\"ee416b02-f6d8-5944-80fd-be5c1139ab5b\" :answer/id #uuid \"ee416b02-f6d8-5944-80fd-be5c1139ab5b\"] [\"ee416b02-f6d8-5944-80fd-be5c1139ab5b\" :answer/type :answer.type/math] [\"ee416b02-f6d8-5944-80fd-be5c1139ab5b\" :answer/value \"\\\\frac{3}{16}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\" :answer/id #uuid \"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\"] [\"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\" :answer/type :answer.type/math] [\"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"73f79e13-5a4d-54bc-bc00-e8736a06220a\" :answer/id #uuid \"73f79e13-5a4d-54bc-bc00-e8736a06220a\"] [\"73f79e13-5a4d-54bc-bc00-e8736a06220a\" :answer/type :answer.type/math] [\"73f79e13-5a4d-54bc-bc00-e8736a06220a\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"60092078-6452-5e24-a9d5-9fa39bdb5e4b\" :answer/id #uuid \"60092078-6452-5e24-a9d5-9fa39bdb5e4b\"] [\"60092078-6452-5e24-a9d5-9fa39bdb5e4b\" :answer/type :answer.type/math] [\"60092078-6452-5e24-a9d5-9fa39bdb5e4b\" :answer/value \"- \\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"78afbe40-2982-59b6-a929-b741df18ec7b\" :answer/id #uuid \"78afbe40-2982-59b6-a929-b741df18ec7b\"] [\"78afbe40-2982-59b6-a929-b741df18ec7b\" :answer/type :answer.type/math] [\"78afbe40-2982-59b6-a929-b741df18ec7b\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/id #uuid \"a62533c6-7811-5118-b3f3-09b68014a85a\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/key \"answer\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/type :answer-field.type/radio] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/choices \"ee416b02-f6d8-5944-80fd-be5c1139ab5b\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/choices \"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/choices \"73f79e13-5a4d-54bc-bc00-e8736a06220a\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/choices \"60092078-6452-5e24-a9d5-9fa39bdb5e4b\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/choices \"78afbe40-2982-59b6-a929-b741df18ec7b\"] [\"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/correct \"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\"] [\"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\" :question/id #uuid \"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\"] [\"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\" :question/difficulty :question.difficulty/easy] [\"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\" :question/answer-fields \"a62533c6-7811-5118-b3f3-09b68014a85a\"] [17592186064250 :knowledge-point/questions \"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\"] [\"bfaf2f4c-f15d-5675-9ff1-12e8c2ccd8d2\" :answer/id #uuid \"bfaf2f4c-f15d-5675-9ff1-12e8c2ccd8d2\"] [\"bfaf2f4c-f15d-5675-9ff1-12e8c2ccd8d2\" :answer/type :answer.type/math] [\"bfaf2f4c-f15d-5675-9ff1-12e8c2ccd8d2\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\" :answer/id #uuid \"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\"] [\"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\" :answer/type :answer.type/math] [\"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\"] [\"2ea2ff82-703c-54b1-92a1-8595617df0fd\" :answer/id #uuid \"2ea2ff82-703c-54b1-92a1-8595617df0fd\"] [\"2ea2ff82-703c-54b1-92a1-8595617df0fd\" :answer/type :answer.type/math] [\"2ea2ff82-703c-54b1-92a1-8595617df0fd\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"5b45ec8c-cc02-52b4-a17d-ac1aa6bc158d\" :answer/id #uuid \"5b45ec8c-cc02-52b4-a17d-ac1aa6bc158d\"] [\"5b45ec8c-cc02-52b4-a17d-ac1aa6bc158d\" :answer/type :answer.type/math] [\"5b45ec8c-cc02-52b4-a17d-ac1aa6bc158d\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"331b5cab-6236-5757-8d95-e849b6b2f857\" :answer/id #uuid \"331b5cab-6236-5757-8d95-e849b6b2f857\"] [\"331b5cab-6236-5757-8d95-e849b6b2f857\" :answer/type :answer.type/math] [\"331b5cab-6236-5757-8d95-e849b6b2f857\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/id #uuid \"8b55815a-5fe7-563c-b750-34ce11ba09ee\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/key \"answer\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/type :answer-field.type/radio] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/choices \"bfaf2f4c-f15d-5675-9ff1-12e8c2ccd8d2\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/choices \"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/choices \"2ea2ff82-703c-54b1-92a1-8595617df0fd\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/choices \"5b45ec8c-cc02-52b4-a17d-ac1aa6bc158d\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/choices \"331b5cab-6236-5757-8d95-e849b6b2f857\"] [\"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/correct \"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\"] [\"94bc0fd8-e241-534c-9870-ebf348fb3dca\" :question/id #uuid \"94bc0fd8-e241-534c-9870-ebf348fb3dca\"] [\"94bc0fd8-e241-534c-9870-ebf348fb3dca\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"94bc0fd8-e241-534c-9870-ebf348fb3dca\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"94bc0fd8-e241-534c-9870-ebf348fb3dca\" :question/difficulty :question.difficulty/easy] [\"94bc0fd8-e241-534c-9870-ebf348fb3dca\" :question/answer-fields \"8b55815a-5fe7-563c-b750-34ce11ba09ee\"] [17592186064250 :knowledge-point/questions \"94bc0fd8-e241-534c-9870-ebf348fb3dca\"] [\"e7fbdf1f-8fe3-5789-b214-1a40b7b2b6ee\" :answer/id #uuid \"e7fbdf1f-8fe3-5789-b214-1a40b7b2b6ee\"] [\"e7fbdf1f-8fe3-5789-b214-1a40b7b2b6ee\" :answer/type :answer.type/math] [\"e7fbdf1f-8fe3-5789-b214-1a40b7b2b6ee\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\" :answer/id #uuid \"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\"] [\"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\" :answer/type :answer.type/math] [\"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\"] [\"1282b5ae-e8e0-5fbd-91f3-9ef00f1ed768\" :answer/id #uuid \"1282b5ae-e8e0-5fbd-91f3-9ef00f1ed768\"] [\"1282b5ae-e8e0-5fbd-91f3-9ef00f1ed768\" :answer/type :answer.type/math] [\"1282b5ae-e8e0-5fbd-91f3-9ef00f1ed768\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"fc076000-db2a-5052-b4c4-0e2e2eca2e22\" :answer/id #uuid \"fc076000-db2a-5052-b4c4-0e2e2eca2e22\"] [\"fc076000-db2a-5052-b4c4-0e2e2eca2e22\" :answer/type :answer.type/math] [\"fc076000-db2a-5052-b4c4-0e2e2eca2e22\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0591c87c-b5fd-5b16-8be3-400aa1f889a5\" :answer/id #uuid \"0591c87c-b5fd-5b16-8be3-400aa1f889a5\"] [\"0591c87c-b5fd-5b16-8be3-400aa1f889a5\" :answer/type :answer.type/math] [\"0591c87c-b5fd-5b16-8be3-400aa1f889a5\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/id #uuid \"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/key \"answer\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/type :answer-field.type/radio] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/choices \"e7fbdf1f-8fe3-5789-b214-1a40b7b2b6ee\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/choices \"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/choices \"1282b5ae-e8e0-5fbd-91f3-9ef00f1ed768\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/choices \"fc076000-db2a-5052-b4c4-0e2e2eca2e22\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/choices \"0591c87c-b5fd-5b16-8be3-400aa1f889a5\"] [\"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/correct \"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\"] [\"7bb97d40-751e-5a89-8260-47ab1a2975f5\" :question/id #uuid \"7bb97d40-751e-5a89-8260-47ab1a2975f5\"] [\"7bb97d40-751e-5a89-8260-47ab1a2975f5\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"7bb97d40-751e-5a89-8260-47ab1a2975f5\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{4}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"7bb97d40-751e-5a89-8260-47ab1a2975f5\" :question/difficulty :question.difficulty/easy] [\"7bb97d40-751e-5a89-8260-47ab1a2975f5\" :question/answer-fields \"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\"] [17592186064250 :knowledge-point/questions \"7bb97d40-751e-5a89-8260-47ab1a2975f5\"] [\"bee9d946-5ccd-542f-bcec-8fddec40d364\" :answer/id #uuid \"bee9d946-5ccd-542f-bcec-8fddec40d364\"] [\"bee9d946-5ccd-542f-bcec-8fddec40d364\" :answer/type :answer.type/math] [\"bee9d946-5ccd-542f-bcec-8fddec40d364\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"cc55ef6e-03b9-592e-8942-663ffeec6c1e\" :answer/id #uuid \"cc55ef6e-03b9-592e-8942-663ffeec6c1e\"] [\"cc55ef6e-03b9-592e-8942-663ffeec6c1e\" :answer/type :answer.type/math] [\"cc55ef6e-03b9-592e-8942-663ffeec6c1e\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"933d89e5-33d4-5d8e-99e1-4a57c2894d42\" :answer/id #uuid \"933d89e5-33d4-5d8e-99e1-4a57c2894d42\"] [\"933d89e5-33d4-5d8e-99e1-4a57c2894d42\" :answer/type :answer.type/math] [\"933d89e5-33d4-5d8e-99e1-4a57c2894d42\" :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d384d25f-4a4f-5e6d-8419-95cdb4afd4f0\" :answer/id #uuid \"d384d25f-4a4f-5e6d-8419-95cdb4afd4f0\"] [\"d384d25f-4a4f-5e6d-8419-95cdb4afd4f0\" :answer/type :answer.type/math] [\"d384d25f-4a4f-5e6d-8419-95cdb4afd4f0\" :answer/value \"\\\\frac{4}{15}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"10d5ce71-080a-5c4f-a79a-5af969e4199f\" :answer/id #uuid \"10d5ce71-080a-5c4f-a79a-5af969e4199f\"] [\"10d5ce71-080a-5c4f-a79a-5af969e4199f\" :answer/type :answer.type/math] [\"10d5ce71-080a-5c4f-a79a-5af969e4199f\" :answer/value \"- \\\\frac{8}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\