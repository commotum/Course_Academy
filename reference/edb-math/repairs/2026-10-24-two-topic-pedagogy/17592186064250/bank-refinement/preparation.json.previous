\int \\\\frac{1}{|x|\\\\sqrt{6{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{\\\\sqrt{6}}{|\\\\sqrt{6}x|\\\\sqrt{(\\\\sqrt{6}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\sqrt{6}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{6}}\\\\text{d}u) \\\\\\\\  & =\\\\sqrt{6}\\\\cdot \\\\frac{1}{\\\\sqrt{6}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(\\\\sqrt{6}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"345d0dd8-1722-50e6-996a-3145ed9fa4cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{7}x)+C\" :db/id 17592186247894} {:answer/id #uuid \"795dfd60-9293-54b9-a133-af67359f3625\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(7x)+C\" :db/id 17592186248490} {:answer/id #uuid \"a6deadf7-ef59-56ac-a86b-d7bdb56e7adc\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\sqrt{7}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248908} {:answer/id #uuid \"afa04312-a9ee-53e6-8294-76266301a3a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{7}}{7}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248999} {:answer/id #uuid \"d0c6dca0-cfeb-5ddf-b8cf-96bba1eee175\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\text{arcsec}(\\\\sqrt{7}x)+C\" :db/id 17592186249278}] :answer-field/correct {:answer/id #uuid \"d0c6dca0-cfeb-5ddf-b8cf-96bba1eee175\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\text{arcsec}(\\\\sqrt{7}x)+C\" :db/id 17592186249278} :answer-field/id #uuid \"ae56369a-9dc7-56a8-9b42-9abf878339d0\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249978}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"37dfb0c1-ed42-5302-8312-3364def8fc97\" :question/math-academy-id \"q-114055\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{7}{|x|\\\\sqrt{7{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{7}{|x|\\\\sqrt{7{x}^{2}-1}}\\\\text{d}x=\\\\int \\\\frac{7\\\\sqrt{7}}{|\\\\sqrt{7}x|\\\\sqrt{(\\\\sqrt{7}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{7}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{7}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{7}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{7}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{7}{|x|\\\\sqrt{7{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{7\\\\sqrt{7}}{|\\\\sqrt{7}x|\\\\sqrt{(\\\\sqrt{7}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =7\\\\sqrt{7}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{7}}\\\\text{d}u) \\\\\\\\  & =7\\\\sqrt{7}\\\\cdot \\\\frac{1}{\\\\sqrt{7}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =7\\\\,\\\\text{arcsec }u+C \\\\\\\\  & =7\\\\,\\\\text{arcsec}(\\\\sqrt{7}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"06349d8e-8391-574b-b6ee-d09717af159e\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\sqrt{8}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186247480} {:answer/id #uuid \"28b08c9d-77c7-5bea-8de3-24e47c4a6b22\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\text{arcsec}(\\\\sqrt{8}x)+C\" :db/id 17592186247786} {:answer/id #uuid \"4b4c8ae4-b8b1-5ed2-b232-73c90f37ed26\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{8}x)+C\" :db/id 17592186248097} {:answer/id #uuid \"97ffb8aa-ac92-5db2-a3d4-4a6b34576f59\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{8}}{8}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248778} {:answer/id #uuid \"b9b1dd01-2ffe-53eb-9456-1dfad676593b\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\text{arcsec}\\\\left(\\\\frac{x}{\\\\sqrt{8}}\\\\right)+C\" :db/id 17592186249084}] :answer-field/correct {:answer/id #uuid \"28b08c9d-77c7-5bea-8de3-24e47c4a6b22\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\text{arcsec}(\\\\sqrt{8}x)+C\" :db/id 17592186247786} :answer-field/id #uuid \"f124bfeb-924c-5974-b5d6-5bac9d8b7458\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186250090}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"d978df6a-8484-5ed1-885e-b4758185514d\" :question/math-academy-id \"q-114056\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{8}{|x|\\\\sqrt{8{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{8}{|x|\\\\sqrt{8{x}^{2}-1}}\\\\text{d}x=\\\\int \\\\frac{8\\\\sqrt{8}}{|\\\\sqrt{8}x|\\\\sqrt{(\\\\sqrt{8}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{8}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{8}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{8}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{8}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{8}{|x|\\\\sqrt{8{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{8\\\\sqrt{8}}{|\\\\sqrt{8}x|\\\\sqrt{(\\\\sqrt{8}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =8\\\\sqrt{8}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{8}}\\\\text{d}u) \\\\\\\\  & =8\\\\sqrt{8}\\\\cdot \\\\frac{1}{\\\\sqrt{8}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =8\\\\,\\\\text{arcsec }u+C \\\\\\\\  & =8\\\\,\\\\text{arcsec}(\\\\sqrt{8}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"20eeed43-06fc-5a51-a569-cc359295eeb2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(50x)+C\" :db/id 17592186247713} {:answer/id #uuid \"23a4faf6-7048-5692-877b-730a3aa48b44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(10x)+C\" :db/id 17592186247737} {:answer/id #uuid \"860a98b5-c89e-5a98-a319-70c942ace928\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\,\\\\text{arcsec}(10x)+C\" :db/id 17592186248619} {:answer/id #uuid \"c1ea824c-8f8e-5257-ae08-86f03dfd7210\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(10x)+C\" :db/id 17592186249149} {:answer/id #uuid \"d7024181-5209-53f4-9e77-1d70e6a37869\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186249324}] :answer-field/correct {:answer/id #uuid \"c1ea824c-8f8e-5257-ae08-86f03dfd7210\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(10x)+C\" :db/id 17592186249149} :answer-field/id #uuid \"1249c5e2-b95a-56a8-9562-7cfa27416496\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249702}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1386e5e4-c2d1-50fc-ab2e-40d086cf4081\" :question/math-academy-id \"q-114057\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{5}{|x|\\\\sqrt{100{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{5}{|x|\\\\sqrt{100{x}^{2}-1}}\\\\text{d}x=\\\\int \\\\frac{50}{|10x|\\\\sqrt{(10x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $10x.$\\n\\nSo, let's substitute $u=10x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=10\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{10}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{5}{|x|\\\\sqrt{100{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{50}{|10x|\\\\sqrt{(10x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =50\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{10}\\\\text{d}u) \\\\\\\\  & =50\\\\cdot \\\\frac{1}{10}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =5\\\\,\\\\text{arcsec }u+C \\\\\\\\  & =5\\\\,\\\\text{arcsec}(10x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"26bff1d2-1a1f-5568-b606-c926ad4e222e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(4x)}{4}+C\" :db/id 17592186330288} {:answer/id #uuid \"38f382b6-b9e0-5d37-bb15-bf2017958200\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arctan}⁡(4x)}{4}+C\" :db/id 17592186330460} {:answer/id #uuid \"88b1a168-dccc-5c24-aa5c-58eef11e4b53\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\text{arcsec}(4x)+C\" :db/id 17592186331165} {:answer/id #uuid \"8a671a08-acf6-51a4-a4b1-a79a1a8a1a19\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(16x)}{2}+C\" :db/id 17592186331179} {:answer/id #uuid \"c1c62bda-b0cb-5477-843f-9e7f08c270e5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186331672}] :answer-field/correct {:answer/id #uuid \"c1c62bda-b0cb-5477-843f-9e7f08c270e5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186331672} :answer-field/id #uuid \"2ed515ce-b125-59ef-ba87-1982f7680cc3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332279}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cd302e3c-b39d-509b-8801-010e64d93a57\" :question/math-academy-id \"q-49519\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{4|x|\\\\sqrt{16{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{4|x|\\\\sqrt{16{x}^{2}-1}}=\\\\int \\\\frac{\\\\text{d}x}{|4x|\\\\sqrt{(4x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $4x.$\\n\\nSo, let's substitute $u=4x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{4}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{4|x|\\\\sqrt{16{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{|4x|\\\\sqrt{(4x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{4}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{4}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{4}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(4x)}{4}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4b0edf81-9914-5a0f-b9b6-d58d70540093\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(x)}{3}+C\" :db/id 17592186330630} {:answer/id #uuid \"70cf07b2-a48c-5c20-b1ad-493648041c3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(9x)}{3}+C\" :db/id 17592186330962} {:answer/id #uuid \"9a56a3d4-f0db-5dee-8e1b-e1e7174dd979\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(3x)}{3}+C\" :db/id 17592186331338} {:answer/id #uuid \"a43c7a93-7056-56e0-adc4-8cc368c5eac5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(9x)}{3}+C\" :db/id 17592186331423} {:answer/id #uuid \"e8c453d1-3b22-5ee0-8261-9dc453f931aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(3x)}{3}+C\" :db/id 17592186331996}] :answer-field/correct {:answer/id #uuid \"e8c453d1-3b22-5ee0-8261-9dc453f931aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(3x)}{3}+C\" :db/id 17592186331996} :answer-field/id #uuid \"b3ccce72-f1f2-5395-8899-d57e02ead31c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332512}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"751e8889-464b-57e5-9446-01158bf809c1\" :question/math-academy-id \"q-49554\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{1}{3|x|\\\\sqrt{9{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{3|x|\\\\sqrt{9{x}^{2}-1}}=\\\\int \\\\frac{\\\\text{d}x}{|3x|\\\\sqrt{(3x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $3x.$\\n\\nSo, let's substitute $u=3x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{3}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{3|x|\\\\sqrt{9{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{|3x|\\\\sqrt{(3x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{3}\\\\text{d}u) \\\\\\\\  & =\\\\frac{1}{3}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\frac{1}{3}\\\\text{arcsec }u+C \\\\\\\\  & =\\\\frac{\\\\text{arcsec}(3x)}{3}+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186332741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1afb9d8c-3f67-5355-93d6-a9093bad7dae\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{arcsin}⁡(6x)}{6}+C\" :db/id 17592186330187} {:answer/id #uuid \"3226e3a9-ff07-580d-875b-1db26197856a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(36x)}{6}+C\" :db/id 17592186330391} {:answer/id #uuid \"d697edf8-7533-5458-807b-5604ad7429ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(6x)+C\" :db/id 17592186331847} {:answer/id #uuid \"d72cc629-030b-503a-b49e-63c0be8afa3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{6}+C\" :db/id 17592186331853} {:answer/id #uuid \"d885db49-c6b0-5c70-8dc4-c09546b4b009\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(36x)+C\" :db/id 17592186331870}] :answer-field/correct {:answer/id #uuid \"d72cc629-030b-503a-b49e-63c0be8afa3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(6x)}{6}+C\" :db/id 17592186331853} :answe