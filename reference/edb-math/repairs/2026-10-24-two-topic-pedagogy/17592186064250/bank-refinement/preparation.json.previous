\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"7a8b5646-0d93-57dd-bce0-4189d3f0c2b9\" :question/difficulty :question.difficulty/easy] [\"7a8b5646-0d93-57dd-bce0-4189d3f0c2b9\" :question/answer-fields \"ad967691-4e47-55c5-954b-2976bd4e4f9c\"] [17592186064250 :knowledge-point/questions \"7a8b5646-0d93-57dd-bce0-4189d3f0c2b9\"] [\"be462b5e-5b40-5509-8d1c-2b219e3afd8a\" :answer/id #uuid \"be462b5e-5b40-5509-8d1c-2b219e3afd8a\"] [\"be462b5e-5b40-5509-8d1c-2b219e3afd8a\" :answer/type :answer.type/math] [\"be462b5e-5b40-5509-8d1c-2b219e3afd8a\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"fa7f6192-1c3e-5718-9359-76c99aeb88e0\" :answer/id #uuid \"fa7f6192-1c3e-5718-9359-76c99aeb88e0\"] [\"fa7f6192-1c3e-5718-9359-76c99aeb88e0\" :answer/type :answer.type/math] [\"fa7f6192-1c3e-5718-9359-76c99aeb88e0\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"6f92b6de-9a9e-580b-a58e-4a2e8748382b\" :answer/id #uuid \"6f92b6de-9a9e-580b-a58e-4a2e8748382b\"] [\"6f92b6de-9a9e-580b-a58e-4a2e8748382b\" :answer/type :answer.type/math] [\"6f92b6de-9a9e-580b-a58e-4a2e8748382b\" :answer/value \"- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"acfe1411-a20d-50b2-9786-78651d1d8b99\" :answer/id #uuid \"acfe1411-a20d-50b2-9786-78651d1d8b99\"] [\"acfe1411-a20d-50b2-9786-78651d1d8b99\" :answer/type :answer.type/math] [\"acfe1411-a20d-50b2-9786-78651d1d8b99\" :answer/value \"- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d4b7acfd-650c-5723-95d6-0142a81b2358\" :answer/id #uuid \"d4b7acfd-650c-5723-95d6-0142a81b2358\"] [\"d4b7acfd-650c-5723-95d6-0142a81b2358\" :answer/type :answer.type/math] [\"d4b7acfd-650c-5723-95d6-0142a81b2358\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/id #uuid \"2dc6375a-33b1-597f-8bdc-f368b50d332a\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/key \"answer\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/type :answer-field.type/radio] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/choices \"be462b5e-5b40-5509-8d1c-2b219e3afd8a\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/choices \"fa7f6192-1c3e-5718-9359-76c99aeb88e0\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/choices \"6f92b6de-9a9e-580b-a58e-4a2e8748382b\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/choices \"acfe1411-a20d-50b2-9786-78651d1d8b99\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/choices \"d4b7acfd-650c-5723-95d6-0142a81b2358\"] [\"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/correct \"be462b5e-5b40-5509-8d1c-2b219e3afd8a\"] [\"bb1a95f2-7242-5d0c-b87d-badd20589922\" :question/id #uuid \"bb1a95f2-7242-5d0c-b87d-badd20589922\"] [\"bb1a95f2-7242-5d0c-b87d-badd20589922\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"bb1a95f2-7242-5d0c-b87d-badd20589922\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{5}=\\\\frac{2}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"bb1a95f2-7242-5d0c-b87d-badd20589922\" :question/difficulty :question.difficulty/easy] [\"bb1a95f2-7242-5d0c-b87d-badd20589922\" :question/answer-fields \"2dc6375a-33b1-597f-8bdc-f368b50d332a\"] [17592186064250 :knowledge-point/questions \"bb1a95f2-7242-5d0c-b87d-badd20589922\"] [\"9c42b6f6-9782-54c6-b192-1cade00c9715\" :answer/id #uuid \"9c42b6f6-9782-54c6-b192-1cade00c9715\"] [\"9c42b6f6-9782-54c6-b192-1cade00c9715\" :answer/type :answer.type/math] [\"9c42b6f6-9782-54c6-b192-1cade00c9715\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e2c135f3-6e96-56c7-8c08-61da63dce8dc\" :answer/id #uuid \"e2c135f3-6e96-56c7-8c08-61da63dce8dc\"] [\"e2c135f3-6e96-56c7-8c08-61da63dce8dc\" :answer/type :answer.type/math] [\"e2c135f3-6e96-56c7-8c08-61da63dce8dc\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"9b0731ce-6786-56be-bb0a-e9b8f1a2dd58\" :answer/id #uuid \"9b0731ce-6786-56be-bb0a-e9b8f1a2dd58\"] [\"9b0731ce-6786-56be-bb0a-e9b8f1a2dd58\" :answer/type :answer.type/math] [\"9b0731ce-6786-56be-bb0a-e9b8f1a2dd58\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\"] [\"54f7586f-f527-51b7-88bc-73fb71733563\" :answer/id #uuid \"54f7586f-f527-51b7-88bc-73fb71733563\"] [\"54f7586f-f527-51b7-88bc-73fb71733563\" :answer/type :answer.type/math] [\"54f7586f-f527-51b7-88bc-73fb71733563\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"a654c3c1-4947-5c5f-a861-a0df2f21663e\" :answer/id #uuid \"a654c3c1-4947-5c5f-a861-a0df2f21663e\"] [\"a654c3c1-4947-5c5f-a861-a0df2f21663e\" :answer/type :answer.type/math] [\"a654c3c1-4947-5c5f-a861-a0df2f21663e\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/id #uuid \"9a0278f0-7eaf-5656-81fa-58702d8db23d\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/key \"answer\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/type :answer-field.type/radio] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/choices \"9c42b6f6-9782-54c6-b192-1cade00c9715\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/choices \"e2c135f3-6e96-56c7-8c08-61da63dce8dc\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/choices \"9b0731ce-6786-56be-bb0a-e9b8f1a2dd58\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/choices \"54f7586f-f527-51b7-88bc-73fb71733563\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/choices \"a654c3c1-4947-5c5f-a861-a0df2f21663e\"] [\"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/correct \"e2c135f3-6e96-56c7-8c08-61da63dce8dc\"] [\"a389fa12-c56e-5666-b913-2d1803b92aee\" :question/id #uuid \"a389fa12-c56e-5666-b913-2d1803b92aee\"] [\"a389fa12-c56e-5666-b913-2d1803b92aee\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"a389fa12-c56e-5666-b913-2d1803b92aee\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"a389fa12-c56e-5666-b913-2d1803b92aee\" :question/difficulty :question.difficulty/easy] [\"a389fa12-c56e-5666-b913-2d1803b92aee\" :question/answer-fields \"9a0278f0-7eaf-5656-81fa-58702d8db23d\"] [17592186064250 :knowledge-point/questions \"a389fa12-c56e-5666-b913-2d1803b92aee\"] [\"d337e478-9e3d-5fee-a8e2-b96923986bc6\" :answer/id #uuid \"d337e478-9e3d-5fee-a8e2-b96923986bc6\"] [\"d337e478-9e3d-5fee-a8e2-b96923986bc6\" :answer/type :answer.type/math] [\"d337e478-9e3d-5fee-a8e2-b96923986bc6\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"5f54c10e-b1d1-502a-887b-5f22b474dd2c\" :answer/id #uuid \"5f54c10e-b1d1-502a-887b-5f22b474dd2c\"] [\"5f54c10e-b1d1-502a-887b-5f22b474dd2c\" :answer/type :answer.type/math] [\"5f54c10e-b1d1-502a-887b-5f22b474dd2c\" :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"4c82403a-eca7-54a8-9c6f-185d871da9c4\" :answer/id #uuid \"4c82403a-eca7-54a8-9c6f-185d871da9c4\"] [\"4c82403a-eca7-54a8-9c6f-185d871da9c4\" :answer/type :answer.type/math] [\"4c82403a-eca7-54a8-9c6f-185d871da9c4\" :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"eaa26936-cc54-54db-ba96-50da2dc56209\" :answer/id #uuid \"eaa26936-cc54-54db-ba96-50da2dc56209\"] [\"eaa26936-cc54-54db-ba96-50da2dc56209\" :answer/type :answer.type/math] [\"eaa26936-cc54-54db-ba96-50da2dc56209\" :answer/value \"\\\\frac{1}{20}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"29b6b7ce-9447-5530-8b85-6f66725c310d\" :answer/id #uuid \"29b6b7ce-9447-5530-8b85-6f66725c310d\"] [\"29b6b7ce-9447-5530-8b85-6f66725c310d\" :answer/type :answer.type/math] [\"29b6b7ce-9447-5530-8b85-6f66725c310d\" :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/id #uuid \"00e551b0-4ea8-5b08-ad11-54101d321313\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/key \"answer\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/type :answer-field.type/radio] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/choices \"d337e478-9e3d-5fee-a8e2-b96923986bc6\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/choices \"5f54c10e-b1d1-502a-887b-5f22b474dd2c\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/choices \"4c82403a-eca7-54a8-9c6f-185d871da9c4\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/choices \"eaa26936-cc54-54db-ba96-50da2dc56209\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/choices \"29b6b7ce-9447-5530-8b85-6f66725c310d\"] [\"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/correct \"4c82403a-eca7-54a8-9c6f-185d871da9c4\"] [\"41707ce6-ae13-5f46-a338-b37dceac0ae7\" :question/id #uuid \"41707ce6-ae13-5f46-a338-b37dceac0ae7\"] [\"41707ce6-ae13-5f46-a338-b37dceac0ae7\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"41707ce6-ae13-5f46-a338-b37dceac0ae7\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"41707ce6-ae13-5f46-a338-b37dceac0ae7\" :question/difficulty :question.difficulty/easy] [\"41707ce6-ae13-5f46-a338-b37dceac0ae7\" :question/answer-fields \"00e551b0-4ea8-5b08-ad11-54101d321313\"] [17592186064250 :knowledge-point/questions \"41707ce6-ae13-5f46-a338-b37dceac0ae7\"] [\"a2c26a46-a940-5ebd-b1d4-1593d67186d0\" :answer/id #uuid \"a2c26a46-a940-5ebd-b1d4-1593d67186d0\"] [\"a2c26a46-a940-5ebd-b1d4-1593d67186d0\" :answer/type :answer.type/math] [\"a2c26a46-a940-5ebd-b1d4-1593d67186d0\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"312f0b64-0080-560c-8c94-b1307ebc782d\" :answer/id #uuid \"312f0b64-0080-560c-8c94-b1307ebc782d\"] [\"312f0b64-0080-560c-8c94-b1307ebc782d\" :answer/type :answer.type/math] [\"312f0b64-0080-560c-8c94-b1307ebc782d\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [\"93b49532-0f6a-5a43-8698-40eebc6646c1\" :answer/id #uuid \"93b49532-0f6a-5a43-8698-40eebc6646c1\"] [\"93b49532-0f6a-5a43-8698-40eebc6646c1\" :answer/type :answer.type/math] [\"93b49532-0f6a-5a43-8698-40eebc6646c1\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"791b8920-8fd6-521e-964b-9313f417245f\" :answer/id #uuid \"791b8920-8fd6-521e-964b-9313f417245f\"] [\"791b8920-8fd6-521e-964b-9313f417245f\" :answer/type :answer.type/math] [\"791b8920-8fd6-521e-964b-9313f417245f\" :answer/value \"-1\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"e6b6b55d-b4bd-5dd2-b9c9-79955938bd22\" :answer/id #uuid \"e6b6b55d-b4bd-5dd2-b9c9-79955938bd22\"] [\"e6b6b55d-b4bd-5dd2-b9c9-79955938bd22\" :answer/type :answer.type/math] [\"e6b6b55d-b4bd-5dd2-b9c9-79955938bd22\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/id #uuid \"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/key \"answer\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/type :answer-field.type/radio] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/choices \"a2c26a46-a940-5ebd-b1d4-1593d67186d0\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/choices \"312f0b64-0080-560c-8c94-b1307ebc782d\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/choices \"93b49532-0f6a-5a43-8698-40eebc6646c1\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/choices \"791b8920-8fd6-521e-964b-9313f417245f\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/choices \"e6b6b55d-b4bd-5dd2-b9c9-79955938bd22\"] [\"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/correct \"312f0b64-0080-560c-8c94-b1307ebc782d\"] [\"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\" :question/id #uuid \"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\"] [\"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|2 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C.\\n$$\"] [\"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\" :question/difficulty :question.difficulty/moderate] [\"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\" :question/answer-fields \"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\"] [17592186064250 :knowledge-point/questions \"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\"] [\"2dad638d-6795-5bba-a28c-d4dae1791941\" :answer/id #uuid \"2dad638d-6795-5bba-a28c-d4dae1791941\"] [\"2dad638d-6795-5bba-a28c-d4dae1791941\" :answer/type :answer.type/math] [\"2dad638d-6795-5bba-a28c-d4dae1791941\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"c454ddf1-b042-548b-979d-26163cd00889\" :answer/id #uuid \"c454ddf1-b042-548b-979d-26163cd00889\"] [\"c454ddf1-b042-548b-979d-26163cd00889\" :answer/type :answer.type/math] [\"c454ddf1-b042-548b-979d-26163cd00889\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"94df93dd-8a07-5cd0-9a0e-9ec4ca2f19e9\" :answer/id #uuid \"94df93dd-8a07-5cd0-9a0e-9ec4ca2f19e9\"] [\"94df93dd-8a07-5cd0-9a0e-9ec4ca2f19e9\" :answer/type :answer.type/math] [\"94df93dd-8a07-5cd0-9a0e-9ec4ca2f19e9\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"363e5719-bea1-5a90-b7cd-1a4c44850541\" :answer/id #uuid \"363e5719-bea1-5a90-b7cd-1a4c44850541\"] [\"363e5719-bea1-5a90-b7cd-1a4c44850541\" :answer/type :answer.type/math] [\"363e5719-bea1-5a90-b7cd-1a4c44850541\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"2337c541-befe-5e68-829f-fa9ded0fb13c\" :answer/id #uuid \"2337c541-befe-5e68-829f-fa9ded0fb13c\"] [\"2337c541-befe-5e68-829f-fa9ded0fb13c\" :answer/type :answer.type/math] [\"2337c541-befe-5e68-829f-fa9ded0fb13c\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/id #uuid \"00e82129-7eda-53bc-88cc-0e45dcbad61e\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/key \"answer\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/type :answer-field.type/radio] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/choices \"2dad638d-6795-5bba-a28c-d4dae1791941\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/choices \"c454ddf1-b042-548b-979d-26163cd00889\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/choices \"94df93dd-8a07-5cd0-9a0e-9ec4ca2f19e9\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/choices \"363e5719-bea1-5a90-b7cd-1a4c44850541\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/choices \"2337c541-befe-5e68-829f-fa9ded0fb13c\"] [\"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/correct \"2337c541-befe-5e68-829f-fa9ded0fb13c\"] [\"9f5792d0-9c5b-52ee-9935-fa165bdce327\" :question/id #uuid \"9f5792d0-9c5b-52ee-9935-fa165bdce327\"] [\"9f5792d0-9c5b-52ee-9935-fa165bdce327\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"9f5792d0-9c5b-52ee-9935-fa165bdce327\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [\"9f5792d0-9c5b-52ee-9935-fa165bdce327\" :question/difficulty :question.difficulty/moderate] [\"9f5792d0-9c5b-52ee-9935-fa165bdce327\" :question/answer-fields \"00e82129-7eda-53bc-88cc-0e45dcbad61e\"] [17592186064250 :knowledge-point/questions \"9f5792d0-9c5b-52ee-9935-fa165bdce327\"] [\"c232732a-db29-5875-8154-305ac841267d\" :answer/id #uuid \"c232732a-db29-5875-8154-305ac841267d\"] [\"c232732a-db29-5875-8154-305ac841267d\" :answer/type :answer.type/math] [\"c232732a-db29-5875-8154-305ac841267d\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"ab63aa8c-62ba-5c8c-b205-9e1d92a9052c\" :answer/id #uuid \"ab63aa8c-62ba-5c8c-b205-9e1d92a9052c\"] [\"ab63aa8c-62ba-5c8c-b205-9e1d92a9052c\" :answer/type :answer.type/math] [\"ab63aa8c-62ba-5c8c-b205-9e1d92a9052c\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"d3b722ee-7fcd-5510-ba61-91bb9c65258e\" :answer/id #uuid \"d3b722ee-7fcd-5510-ba61-91bb9c65258e\"] [\"d3b722ee-7fcd-5510-ba61-91bb9c65258e\" :answer/type :answer.type/math] [\"d3b722ee-7fcd-5510-ba61-91bb9c65258e\" :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"25b04917-3e2e-511f-af2b-c28a5d7511f5\" :answer/id #uuid \"25b04917-3e2e-511f-af2b-c28a5d7511f5\"] [\"25b04917-3e2e-511f-af2b-c28a5d7511f5\" :answer/type :answer.type/math] [\"25b04917-3e2e-511f-af2b-c28a5d7511f5\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\"] [\"e62a8238-b6cf-5f3a-80d9-d7b7a465c046\" :answer/id #uuid \"e62a8238-b6cf-5f3a-80d9-d7b7a465c046\"] [\"e62a8238-b6cf-5f3a-80d9-d7b7a465c046\" :answer/type :answer.type/math] [\"e62a8238-b6cf-5f3a-80d9-d7b7a465c046\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/id #uuid \"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/key \"answer\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/type :answer-field.type/radio] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/choices \"c232732a-db29-5875-8154-305ac841267d\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/choices \"ab63aa8c-62ba-5c8c-b205-9e1d92a9052c\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/choices \"d3b722ee-7fcd-5510-ba61-91bb9c65258e\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/choices \"25b04917-3e2e-511f-af2b-c28a5d7511f5\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/choices \"e62a8238-b6cf-5f3a-80d9-d7b7a465c046\"] [\"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/correct \"c232732a-db29-5875-8154-305ac841267d\"] [\"bacbded8-6884-5d02-af40-16c8adf1cd96\" :question/id #uuid \"bacbded8-6884-5d02-af40-16c8adf1cd96\"] [\"bacbded8-6884-5d02-af40-16c8adf1cd96\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"bacbded8-6884-5d02-af40-16c8adf1cd96\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{5}=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [\"bacbded8-6884-5d02-af40-16c8adf1cd96\" :question/difficulty :question.difficulty/moderate] [\"bacbded8-6884-5d02-af40-16c8adf1cd96\" :question/answer-fields \"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\"] [17592186064250 :knowledge-point/questions \"bacbded8-6884-5d02-af40-16c8adf1cd96\"] [\"40feda46-d342-5cef-ba12-30773f0d3723\" :answer/id #uuid \"40feda46-d342-5cef-ba12-30773f0d3723\"] [\"40feda46-d342-5cef-ba12-30773f0d3723\" :answer/type :answer.type/math] [\"40feda46-d342-5cef-ba12-30773f0d3723\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [\"56ef5604-2eb6-5198-9605-7786a819ee07\" :answer/id #uuid \"56ef5604-2eb6-5198-9605-7786a819ee07\"] [\"56ef5604-2eb6-5198-9605-7786a819ee07\" :answer/type :answer.type/math] [\"56ef5604-2eb6-5198-9605-7786a819ee07\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"c270fd30-ee22-5180-b732-d29668ca15e3\" :answer/id #uuid \"c270fd30-ee22-5180-b732-d29668ca15e3\"] [\"c270fd30-ee22-5180-b732-d29668ca15e3\" :answer/type :answer.type/math] [\"c270fd30-ee22-5180-b732-d29668ca15e3\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"59519cf4-e762-57cb-a030-105b00e1faac\" :answer/id #uuid \"59519cf4-e762-57cb-a030-105b00e1faac\"] [\"59519cf4-e762-57cb-a030-105b00e1faac\" :answer/type :answer.type/math] [\"59519cf4-e762-57cb-a030-105b00e1faac\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}+C\"] [\"0f571e69-41b4-528e-88d7-d84f2aa8259c\" :answer/id #uuid \"0f571e69-41b4-528e-88d7-d84f2aa8259c\"] [\"0f571e69-41b4-528e-88d7-d84f2aa8259c\" :answer/type :answer.type/math] [\"0f571e69-41b4-528e-88d7-d84f2aa8259c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/id #uuid \"ecf22287-e7ac-53c6-b876-fd2048726cd4\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/key \"answer\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/type :answer-field.type/radio] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/choices \"40feda46-d342-5cef-ba12-30773f0d3723\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/choices \"56ef5604-2eb6-5198-9605-7786a819ee07\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/choices \"c270fd30-ee22-5180-b732-d29668ca15e3\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/choices \"59519cf4-e762-57cb-a030-105b00e1faac\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/choices \"0f571e69-41b4-528e-88d7-d84f2aa8259c\"] [\"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/correct \"40feda46-d342-5cef-ba12-30773f0d3723\"] [\"0a802c2b-6d44-5e3b-8524-69c4811ecad9\" :question/id #uuid \"0a802c2b-6d44-5e3b-8524-69c4811ecad9\"] [\"0a802c2b-6d44-5e3b-8524-69c4811ecad9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"0a802c2b-6d44-5e3b-8524-69c4811ecad9\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C.\\n$$\"] [\"0a802c2b-6d44-5e3b-8524-69c4811ecad9\" :question/difficulty :question.difficulty/moderate] [\"0a802c2b-6d44-5e3b-8524-69c4811ecad9\" :question/answer-fields \"ecf22287-e7ac-53c6-b876-fd2048726cd4\"] [17592186064250 :knowledge-point/questions \"0a802c2b-6d44-5e3b-8524-69c4811ecad9\"] [\"1d070ab3-811f-5739-b6ab-63bd68171300\" :answer/id #uuid \"1d070ab3-811f-5739-b6ab-63bd68171300\"] [\"1d070ab3-811f-5739-b6ab-63bd68171300\" :answer/type :answer.type/math] [\"1d070ab3-811f-5739-b6ab-63bd68171300\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"1407ee65-2f79-586e-81a6-8fb7f82329e3\" :answer/id #uuid \"1407ee65-2f79-586e-81a6-8fb7f82329e3\"] [\"1407ee65-2f79-586e-81a6-8fb7f82329e3\" :answer/type :answer.type/math] [\"1407ee65-2f79-586e-81a6-8fb7f82329e3\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"29726943-6c48-5d78-9ab1-9d5e4826a361\" :answer/id #uuid \"29726943-6c48-5d78-9ab1-9d5e4826a361\"] [\"29726943-6c48-5d78-9ab1-9d5e4826a361\" :answer/type :answer.type/math] [\"29726943-6c48-5d78-9ab1-9d5e4826a361\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"dc598021-6c66-5115-ac71-3cd33ebc8da9\" :answer/id #uuid \"dc598021-6c66-5115-ac71-3cd33ebc8da9\"] [\"dc598021-6c66-5115-ac71-3cd33ebc8da9\" :answer/type :answer.type/math] [\"dc598021-6c66-5115-ac71-3cd33ebc8da9\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"f6e19d42-27e3-5b3a-beef-f63000b64093\" :answer/id #uuid \"f6e19d42-27e3-5b3a-beef-f63000b64093\"] [\"f6e19d42-27e3-5b3a-beef-f63000b64093\" :answer/type :answer.type/math] [\"f6e19d42-27e3-5b3a-beef-f63000b64093\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/id #uuid \"021c7d86-f00a-57fa-8bfe-7262334eefe1\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/key \"answer\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/type :answer-field.type/radio] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/choices \"1d070ab3-811f-5739-b6ab-63bd68171300\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/choices \"1407ee65-2f79-586e-81a6-8fb7f82329e3\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/choices \"29726943-6c48-5d78-9ab1-9d5e4826a361\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/choices \"dc598021-6c66-5115-ac71-3cd33ebc8da9\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/choices \"f6e19d42-27e3-5b3a-beef-f63000b64093\"] [\"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/correct \"f6e19d42-27e3-5b3a-beef-f63000b64093\"] [\"40b27085-34e6-58d6-ab38-f796eb2eb64b\" :question/id #uuid \"40b27085-34e6-58d6-ab38-f796eb2eb64b\"] [\"40b27085-34e6-58d6-ab38-f796eb2eb64b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"40b27085-34e6-58d6-ab38-f796eb2eb64b\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [\"40b27085-34e6-58d6-ab38-f796eb2eb64b\" :question/difficulty :question.difficulty/moderate] [\"40b27085-34e6-58d6-ab38-f796eb2eb64b\" :question/answer-fields \"021c7d86-f00a-57fa-8bfe-7262334eefe1\"] [17592186064250 :knowledge-point/questions \"40b27085-34e6-58d6-ab38-f796eb2eb64b\"] [\"35abe1d1-b7ba-531f-8f3e-5d308559245a\" :answer/id #uuid \"35abe1d1-b7ba-531f-8f3e-5d308559245a\"] [\"35abe1d1-b7ba-531f-8f3e-5d308559245a\" :answer/type :answer.type/math] [\"35abe1d1-b7ba-531f-8f3e-5d308559245a\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"9a476002-ac5f-52af-bf76-63871a1b23ee\" :answer/id #uuid \"9a476002-ac5f-52af-bf76-63871a1b23ee\"] [\"9a476002-ac5f-52af-bf76-63871a1b23ee\" :answer/type :answer.type/math] [\"9a476002-ac5f-52af-bf76-63871a1b23ee\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"61b87488-e1b1-56c7-8df9-6b876e4d81bd\" :answer/id #uuid \"61b87488-e1b1-56c7-8df9-6b876e4d81bd\"] [\"61b87488-e1b1-56c7-8df9-6b876e4d81bd\" :answer/type :answer.type/math] [\"61b87488-e1b1-56c7-8df9-6b876e4d81bd\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"37fa1250-948e-5d74-b739-568c930134a9\" :answer/id #uuid \"37fa1250-948e-5d74-b739-568c930134a9\"] [\"37fa1250-948e-5d74-b739-568c930134a9\" :answer/type :answer.type/math] [\"37fa1250-948e-5d74-b739-568c930134a9\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"8c089f0f-d3e5-58d7-ba9b-1056ffc774cc\" :answer/id #uuid \"8c089f0f-d3e5-58d7-ba9b-1056ffc774cc\"] [\"8c089f0f-d3e5-58d7-ba9b-1056ffc774cc\" :answer/type :answer.type/math] [\"8c089f0f-d3e5-58d7-ba9b-1056ffc774cc\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/id #uuid \"32368e13-0345-5935-ade8-e3ec1338c7dc\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/key \"answer\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/type :answer-field.type/radio] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/choices \"35abe1d1-b7ba-531f-8f3e-5d308559245a\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/choices \"9a476002-ac5f-52af-bf76-63871a1b23ee\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/choices \"61b87488-e1b1-56c7-8df9-6b876e4d81bd\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/choices \"37fa1250-948e-5d74-b739-568c930134a9\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/choices \"8c089f0f-d3e5-58d7-ba9b-1056ffc774cc\"] [\"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/correct \"35abe1d1-b7ba-531f-8f3e-5d308559245a\"] [\"7557536f-4126-5553-aa32-304478d3cfce\" :question/id #uuid \"7557536f-4126-5553-aa32-304478d3cfce\"] [\"7557536f-4126-5553-aa32-304478d3cfce\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"7557536f-4126-5553-aa32-304478d3cfce\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [\"7557536f-4126-5553-aa32-304478d3cfce\" :question/difficulty :question.difficulty/moderate] [\"7557536f-4126-5553-aa32-304478d3cfce\" :question/answer-fields \"32368e13-0345-5935-ade8-e3ec1338c7dc\"] [17592186064250 :knowledge-point/questions \"7557536f-4126-5553-aa32-304478d3cfce\"] [\"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/id #uuid \"9b09972a-d5da-5894-b5c6-29eda9816c52\"] [\"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/type :answer.type/math] [\"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/id #uuid \"63879433-a599-50d9-af42-eabbbe9ff7a0\"] [\"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/type :answer.type/math] [\"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/id #uuid \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\"] [\"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/type :answer.type/math] [\"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/id #uuid \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\"] [\"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/type :answer.type/math] [\"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/id #uuid \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\"] [\"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/type :answer.type/math] [\"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/id #uuid \"16c44766-281e-567b-9905-b8d866c56e67\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/key \"answer\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/type :answer-field.type/radio] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"9b09972a-d5da-5894-b5c6-29eda9816c52\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"63879433-a599-50d9-af42-eabbbe9ff7a0\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/choices \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\"] [\"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/correct \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\"] [\"8200acbd-0096-5a04-af42-dd11117a204a\" :question/id #uuid \"8200acbd-0096-5a04-af42-dd11117a204a\"] [\"8200acbd-0096-5a04-af42-dd11117a204a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"8200acbd-0096-5a04-af42-dd11117a204a\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [\"8200acbd-0096-5a04-af42-dd11117a204a\" :question/difficulty :question.difficulty/moderate] [\"8200acbd-0096-5a04-af42-dd11117a204a\" :question/answer-fields \"16c44766-281e-567b-9905-b8d866c56e67\"] [17592186064250 :knowledge-point/questions \"8200acbd-0096-5a04-af42-dd11117a204a\"] [\"83d848f7-df88-5583-a04b-708515325915\" :answer/id #uuid \"83d848f7-df88-5583-a04b-708515325915\"] [\"83d848f7-df88-5583-a04b-708515325915\" :answer/type :answer.type/math] [\"83d848f7-df88-5583-a04b-708515325915\" :answer/value \"\\\\frac{6}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/id #uuid \"1fd78838-add0-5184-a216-6e1e6e35e6fd\"] [\"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/type :answer.type/math] [\"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/id #uuid \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\"] [\"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/type :answer.type/math] [\"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\"] [\"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/id #uuid \"1b86c668-9c14-5fd7-b4a8-e830266452d1\"] [\"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/type :answer.type/math] [\"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/value \"\\\\frac{3}{10}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/id #uuid \"08c60dee-8be6-5408-826e-7205668d1b78\"] [\"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/type :answer.type/math] [\"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/id #uuid \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/key \"answer\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/type :answer-field.type/radio] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"83d848f7-df88-5583-a04b-708515325915\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"1fd78838-add0-5184-a216-6e1e6e35e6fd\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"1b86c668-9c14-5fd7-b4a8-e830266452d1\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/choices \"08c60dee-8be6-5408-826e-7205668d1b78\"] [\"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/correct \"08c60dee-8be6-5408-826e-7205668d1b78\"] [\"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/id #uuid \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\"] [\"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [\"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/difficulty :question.difficulty/moderate] [\"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/answer-fields \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\"] [17592186064250 :knowledge-point/questions \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\"] [\"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/id #uuid \"5a75205a-6fec-50af-b81c-a92046480f5b\"] [\"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/type :answer.type/math] [\"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/id #uuid \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\"] [\"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/type :answer.type/math] [\"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/id #uuid \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\"] [\"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/type :answer.type/math] [\"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/id #uuid \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\"] [\"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/type :answer.type/math] [\"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/id #uuid \"c964a6ce-c06b-541d-819a-91229e5e003a\"] [\"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/type :answer.type/math] [\"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/id #uuid \"9168c6ea-695d-5c34-9a06-19e028f21093\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/key \"answer\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/type :answer-field.type/radio] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"5a75205a-6fec-50af-b81c-a92046480f5b\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/choices \"c964a6ce-c06b-541d-819a-91229e5e003a\"] [\"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/correct \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\"] [\"f1f49f83-41db-5881-9619-52564f75d31c\" :question/id #uuid \"f1f49f83-41db-5881-9619-52564f75d31c\"] [\"f1f49f83-41db-5881-9619-52564f75d31c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"f1f49f83-41db-5881-9619-52564f75d31c\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $6\\\\cdot \\\\frac{1}{3}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [\"f1f49f83-41db-5881-9619-52564f75d31c\" :question/difficulty :question.difficulty/hard] [\"f1f49f83-41db-5881-9619-52564f75d31c\" :question/answer-fields \"9168c6ea-695d-5c34-9a06-19e028f21093\"] [17592186064250 :knowledge-point/questions \"f1f49f83-41db-5881-9619-52564f75d31c\"] [\"54529229-e39d-5828-9aaa-f10c52168335\" :answer/id #uuid \"54529229-e39d-5828-9aaa-f10c52168335\"] [\"54529229-e39d-5828-9aaa-f10c52168335\" :answer/type :answer.type/math] [\"54529229-e39d-5828-9aaa-f10c52168335\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/id #uuid \"4d67807f-f051-58a0-a4be-685c094bc679\"] [\"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/type :answer.type/math] [\"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/id #uuid \"ff03e90e-2efc-5b40-9dd7-08a938701e62\"] [\"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/type :answer.type/math] [\"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/id #uuid \"2807e6ed-28f0-59f1-b084-b1172e2711dd\"] [\"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/type :answer.type/math] [\"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/id #uuid \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\"] [\"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/type :answer.type/math] [\"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/id #uuid \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/key \"answer\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/type :answer-field.type/radio] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"54529229-e39d-5828-9aaa-f10c52168335\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"4d67807f-f051-58a0-a4be-685c094bc679\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"ff03e90e-2efc-5b40-9dd7-08a938701e62\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"2807e6ed-28f0-59f1-b084-b1172e2711dd\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/choices \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\"] [\"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/correct \"54529229-e39d-5828-9aaa-f10c52168335\"] [\"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/id #uuid \"cbfeac20-e0ab-547c-9174-31fab0729907\"] [\"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{4}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [\"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/difficulty :question.difficulty/hard] [\"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/answer-fields \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\"] [17592186064250 :knowledge-point/questions \"cbfeac20-e0ab-547c-9174-31fab0729907\"] [\"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/id #uuid \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\"] [\"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/type :answer.type/math] [\"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/id #uuid \"8fe3a467-f753-5f74-9801-d0f11c60b24e\"] [\"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/type :answer.type/math] [\"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\"] [\"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/id #uuid \"3796c0ea-cde4-58eb-a226-0de3696f41e8\"] [\"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/type :answer.type/math] [\"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\"] [\"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/id #uuid \"450ac2fe-1a99-5118-a833-347f59ea9da3\"] [\"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/type :answer.type/math] [\"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\"] [\"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/id #uuid \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\"] [\"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/type :answer.type/math] [\"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/id #uuid \"bfd70697-b91d-5c47-a181-3da1acce89c9\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/key \"answer\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/type :answer-field.type/radio] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"8fe3a467-f753-5f74-9801-d0f11c60b24e\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"3796c0ea-cde4-58eb-a226-0de3696f41e8\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"450ac2fe-1a99-5118-a833-347f59ea9da3\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/choices \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\"] [\"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/correct \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\"] [\"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/id #uuid \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\"] [\"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $10\\\\cdot \\\\frac{1}{5}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [\"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/difficulty :question.difficulty/hard] [\"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/answer-fields \"bfd70697-b91d-5c47-a181-3da1acce89c9\"] [17592186064250 :knowledge-point/questions \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\"] [\"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/id #uuid \"513725b9-174c-57d6-b726-87c5f271d0ad\"] [\"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/type :answer.type/math] [\"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\"] [\"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/id #uuid \"84bd64a7-02b2-590b-94bf-390d16a28f56\"] [\"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/type :answer.type/math] [\"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/id #uuid \"e734e59e-f86e-5bf3-89e2-d816b06704ab\"] [\"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/type :answer.type/math] [\"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/id #uuid \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\"] [\"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/type :answer.type/math] [\"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/id #uuid \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\"] [\"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/type :answer.type/math] [\"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/id #uuid \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/key \"answer\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/type :answer-field.type/radio] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"513725b9-174c-57d6-b726-87c5f271d0ad\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"84bd64a7-02b2-590b-94bf-390d16a28f56\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"e734e59e-f86e-5bf3-89e2-d816b06704ab\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/choices \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\"] [\"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/correct \"84bd64a7-02b2-590b-94bf-390d16a28f56\"] [\"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/id #uuid \"e5ce8791-8926-5237-bce9-217f5aba6353\"] [\"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $16\\\\cdot \\\\frac{1}{4}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"] [\"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/difficulty :question.difficulty/hard] [\"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/answer-fields \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\"] [17592186064250 :knowledge-point/questions \"e5ce8791-8926-5237-bce9-217f5aba6353\"] [\"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/id #uuid \"0e289e71-2a3b-558f-8969-f46ee6549e1b\"] [\"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/type :answer.type/math] [\"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/id #uuid \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\"] [\"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/type :answer.type/math] [\"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\"] [\"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/id #uuid \"5a9cc8c8-be9a-521e-a793-afe0886d5354\"] [\"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/type :answer.type/math] [\"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/id #uuid \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\"] [\"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/type :answer.type/math] [\"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/value \"-1\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/id #uuid \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\"] [\"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/type :answer.type/math] [\"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/id #uuid \"7557fe38-875d-5795-99c4-a36c7fd5e097\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/key \"answer\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/type :answer-field.type/radio] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"0e289e71-2a3b-558f-8969-f46ee6549e1b\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"5a9cc8c8-be9a-521e-a793-afe0886d5354\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/choices \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\"] [\"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/correct \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\"] [\"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/id #uuid \"fd18704b-c686-54f7-9804-c8dbf31969bd\"] [\"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|2 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nBecause $2>0$, $|u|=2|x|$, so $|x|=|u|/2$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C.\\n$$\"] [\"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/difficulty :question.difficulty/hard] [\"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/answer-fields \"7557fe38-875d-5795-99c4-a36c7fd5e097\"] [17592186064250 :knowledge-point/questions \"fd18704b-c686-54f7-9804-c8dbf31969bd\"] [\"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/id #uuid \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\"] [\"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/type :answer.type/math] [\"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\"] [\"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/id #uuid \"e4878e77-2010-58f8-8642-ba3d3a29ace6\"] [\"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/type :answer.type/math] [\"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/id #uuid \"1ff30185-c84c-5002-b862-7ddba735b925\"] [\"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/type :answer.type/math] [\"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/id #uuid \"b763cb42-886b-5194-8984-6a2638a66c26\"] [\"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/type :answer.type/math] [\"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/value \"\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}+C\"] [\"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/id #uuid \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\"] [\"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/type :answer.type/math] [\"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/id #uuid \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/key \"answer\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/type :answer-field.type/radio] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"e4878e77-2010-58f8-8642-ba3d3a29ace6\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"1ff30185-c84c-5002-b862-7ddba735b925\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"b763cb42-886b-5194-8984-6a2638a66c26\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/choices \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\"] [\"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/correct \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\"] [\"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/id #uuid \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\"] [\"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C.\\n$$\"] [\"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/difficulty :question.difficulty/hard] [\"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/answer-fields \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\"] [17592186064250 :knowledge-point/questions \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\"] [\"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/id #uuid \"2658604b-a626-5178-a760-4f6e99b1f804\"] [\"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/type :answer.type/math] [\"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/id #uuid \"fa2e53a6-5258-5f95-88f1-f13797ab2172\"] [\"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/type :answer.type/math] [\"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\"] [\"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/id #uuid \"cb30fedb-fba5-5743-bc4f-0e48589d012b\"] [\"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/type :answer.type/math] [\"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\"] [\"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/id #uuid \"1e5bc335-b7ee-5118-928d-e6feab31911e\"] [\"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/type :answer.type/math] [\"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/id #uuid \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\"] [\"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/type :answer.type/math] [\"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/id #uuid \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/key \"answer\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/type :answer-field.type/radio] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"2658604b-a626-5178-a760-4f6e99b1f804\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"fa2e53a6-5258-5f95-88f1-f13797ab2172\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"cb30fedb-fba5-5743-bc4f-0e48589d012b\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"1e5bc335-b7ee-5118-928d-e6feab31911e\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/choices \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\"] [\"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/correct \"2658604b-a626-5178-a760-4f6e99b1f804\"] [\"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/id #uuid \"491e4c26-a08b-53a0-9c8a-2f14d053b450\"] [\"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $15\\\\cdot \\\\frac{1}{5}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"] [\"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/difficulty :question.difficulty/hard] [\"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/answer-fields \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\"] [17592186064250 :knowledge-point/questions \"491e4c26-a08b-53a0-9c8a-2f14d053b450\"] [\"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/id #uuid \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\"] [\"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/type :answer.type/math] [\"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/id #uuid \"84490db6-6b93-5265-8ae3-8875e2514a2e\"] [\"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/type :answer.type/math] [\"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/id #uuid \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\"] [\"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/type :answer.type/math] [\"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/id #uuid \"ad349545-f06c-5647-afae-19a519da2bbb\"] [\"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/type :answer.type/math] [\"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\"] [\"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/id #uuid \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\"] [\"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/type :answer.type/math] [\"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/id #uuid \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/key \"answer\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/type :answer-field.type/radio] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"84490db6-6b93-5265-8ae3-8875e2514a2e\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"ad349545-f06c-5647-afae-19a519da2bbb\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/choices \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\"] [\"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/correct \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\"] [\"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/id #uuid \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\"] [\"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{3}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"] [\"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/difficulty :question.difficulty/hard] [\"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/answer-fields \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\"] [17592186064250 :knowledge-point/questions \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\"] [\"generator\" :question-generator/id #uuid \"1fb53caa-df0e-5c70-9c5b-f0d19d4416b4\"] [\"generator\" :question-generator/script \"generators/38/3863ea472908f17e1f0524d241f4c90b18b0bfe707b9a6d2914db21b43cc6db3/generator.py\"] [17592186064250 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186064250 :knowledge-point/question-generator 17592186679105]]}",
