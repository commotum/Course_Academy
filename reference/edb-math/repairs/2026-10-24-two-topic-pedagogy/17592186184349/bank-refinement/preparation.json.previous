[\"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/correct \"4727c2a5-bf5f-50d6-9005-5f068acf5d8e\"] [\"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/id #uuid \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\"] [\"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/problem \"Use the substitution $u=x^{3} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int x^{2} e^{x^{3} + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [\"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/worked-solution \"Let $u=x^{3} + 2$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} e^{x^{3} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/difficulty :question.difficulty/easy] [\"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/answer-fields \"a87e38d5-4938-5eab-820c-afbcc34cabfc\"] [17592186184349 :knowledge-point/questions \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\"] [\"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\" :answer/id #uuid \"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\"] [\"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\" :answer/type :answer.type/math] [\"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"59bc7859-4c6b-54c7-bc15-e8931e844c04\" :answer/id #uuid \"59bc7859-4c6b-54c7-bc15-e8931e844c04\"] [\"59bc7859-4c6b-54c7-bc15-e8931e844c04\" :answer/type :answer.type/math] [\"59bc7859-4c6b-54c7-bc15-e8931e844c04\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bd1775cc-e2af-5657-a218-6db875b609b2\" :answer/id #uuid \"bd1775cc-e2af-5657-a218-6db875b609b2\"] [\"bd1775cc-e2af-5657-a218-6db875b609b2\" :answer/type :answer.type/math] [\"bd1775cc-e2af-5657-a218-6db875b609b2\" :answer/value \"2