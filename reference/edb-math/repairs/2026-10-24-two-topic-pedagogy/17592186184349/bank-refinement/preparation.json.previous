                ":answer/value": "2\\left(\\int e^{u}\\,\\mathrm{d}u\\right)"
              },
              {
                ":answer/id": "e6bb703c-4a82-5658-b9de-057b5ee84977",
                ":answer/type": ":answer.type/math",
                ":answer/value": "- \\frac{1}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)"
