alidate] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/id #uuid \"a87e38d5-4938-5eab-820c-afbcc34cabfc\"] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/key \"answer\"] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/type :answer-field.type/radio] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/choices \"1567ada9-344a-597a-83a0-cf91edd005d3\"] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/choices \"4727c2a5-bf5f-50d6-9005-5f068acf5d8e\"] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/choices \"e4f7e472-200e-572b-9514-ee4c78739eff\"] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/choices \"7351e569-08e4-54b6-ab30-e2f300bc2306\"] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/choices \"f61c3de9-46d3-5e8d-a2fb-ab30d2965099\"] [:db/add \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/correct \"4727c2a5-bf5f-50d6-9005-5f068acf5d8e\"] [:db/ensure \"a87e38d5-4938-5eab-820c-afbcc34cabfc\" :answer-field/validate] [:db/add \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/id #uuid \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\"] [:db/add \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/problem \"Use the substitution $u=x^{3} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int x^{2} e^{x^{3} + 2}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/worked-solution \"Let $u=x^{3} + 2$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} e^{x^{3} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/difficulty :question.difficulty/easy] [:db/add \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/answer-fields \"a87e38d5-4938-5eab-820c-afbcc34cabfc\"] [:db/ensure \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\" :question/validate] [:db/add 17592186184349 :knowledge-point/questions \"f7131eaa-146e-51c1-a2fb-f1a082e72cea\"] [:db/add \"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\" :answer/id #uuid \"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\"] [:db/add \"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\" :answer/type :answer.type/math] [:db/add \"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"2c90b6df-19e0-5f7f-b549-9ace0f4c2c60\" :answer/validate] [:db/add \"59bc7859-4c6b-54c7-bc15-e8931e844c04\" :answer/id #uuid \"59bc7859-4c6b-54c7-bc15-e8931e844c04\"] [:db/add \"59bc7859-4c6b-54c7-bc15-e8931e844c04\" :answer/type :answer.type/math] [:db/add \"59bc7859-4c6b-54c7-bc15-e8931e844c04\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"59bc7859-4c6b-54c7-bc15-e8931e844c04\" :answer/validate] [:db/add \"bd1775cc-e2af-5657-a218-6db875b609b2\" :answer/id #uuid \"bd1775cc-e2af-5657-a218-6db875b609b2\"] [:db/add \"bd1775cc-e2af-5657-a218-6db875b609b2\" :answer/type :answer.type/math] [:db/add \"bd1775cc-e2af-5657-a218-6db875b609b2\" :answer/value \"2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"bd1775cc-e2af-5657-a218-6db875b609b2\" :answer/validate] [:db/add \"f79e9c8c-8d63-5600-bf58-caa6bb56a68b\" :answer/id #uuid \"f79e9c8c-8d63-5600-bf58-caa6bb56a68b\"] [:db/add \"f79e9c8c-8d63-5600-bf58-caa6bb56a68b\" :answer/type :answer.type/math] [:db/add \"f79e9c8c-8d63-5600-bf58-caa6bb56a68b\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f79e9c8c-8d63-5600-bf58-caa6bb56a68b\" :answer/validate] [:db/add \"af2e3528-a2a0-53f7-b587-310426d32c11\" :answer/id #uuid \"af2e3528-a2a0-53f7-b587-310426d32c11\"] [:db/add \"af2e3528-a2a0-53f7-b587-310426d32c11\" :answer/type :answer.type/mat