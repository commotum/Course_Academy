d \"53722b2b-4adb-5d23-ac2d-d7965936d505\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679239}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"c862bb61-dfd1-56ee-8043-177c32c4eb25\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x^{2} e^{1 - x^{3}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=1 - x^{3}$. Then $\\\\mathrm{d}u=(- 3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} e^{1 - x^{3}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{3}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(e^{1 - x^{3}}\\\\right)+C.\\n$$\"} {:db/id 17592186679289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"23a57400-e42f-58b7-901b-cab31a8d065d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679225} {:answer/id #uuid \"3b6cbaf7-6740-5159-af58-c021acd667db\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679231} {:answer/id #uuid \"89fbdeea-5086-5fdf-ad50-8d50bf501e72\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679257} {:answer/id #uuid \"aa3f3ff4-f094-5d03-a684-c7e26e57b289\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\" :db/id 17592186679275} {:answer/id #uuid \"fada3e63-dc1a-5ce8-af6a-3c4c48bd9b54\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679313}] :answer-field/correct {:answer/id #uuid \"fada3e63-dc1a-5ce8-af6a-3c4c48bd9b54\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679313} :answer-field/id #uuid \"eddf6c95-238c-5a7b-ba8a-65d6c7e10bd4\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679310}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"ce8c4ebb-e4d3-5771-842c-9a5ad69d8ff2\" :question/problem \"Use the substitution $u=x^{3} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int x^{2} e^{x^{3} + 2}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{3} + 2$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} e^{x^{3} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d53d5485-bd0c-5f6b-97f1-1731883693ba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(e^{2 x^{2} + 1}\\\\right)\" :db/id 17592186679295}] :answer-field/correct {:answer/id #uuid \"d53d5485-bd0c-5f6b-97f1-1731883693ba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(e^{2 x^{2} + 1}\\\\right)\" :db/id 17592186679295} :answer-field/id #uuid \"865976f7-0ae6-54b1-a3a5-2e4498202238\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679256}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"cf3721b0-d187-58ec-b5fe-d44cbe937121\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(e^{2 x^{2} + 1}\\\\right)+C.\\n$$\"} {:db/id 17592186679296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e089a252-0a60-55ff-818c-399ae692c533\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{3}\\\\left(e^{3 - 2 x^{3}}\\\\right)\" :db/id 17592186679301}] :answer-field/correct {:answer/id #uuid \"e089a252-0a60-55ff-818c-399ae692c533\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{3}\\\\left(e^{3 - 2 x^{3}}\\\\right)\" :db/id 17592186679301} :answer-field/id #uuid \"ea418b39-60b8-50d7-a170-89956e9a9780\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679308}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"d79e085c-6dcc-5bab-abc6-81362784f9c7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} e^{3 - 2 x^{3}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=3 - 2 x^{3}$. Then $\\\\mathrm{d}u=(- 6 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} e^{3 - 2 x^{3}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{3}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(e^{3 - 2 x^{3}}\\\\right)+C.\\n$$\"} {:db/id 17592186679302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ba2e9ceb-5f41-5831-874f-4c7b42d62b52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(e^{x^{2} + 3}\\\\right)\" :db/id 17592186679280}] :answer-field/correct {:answer/id #uuid \"ba2e9ceb-5f41-5831-874f-4c7b42d62b52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(e^{x^{2} + 3}\\\\right)\" :db/id 17592186679280} :answer-field/id #uuid \"1a1b786d-a729-5ae6-ac07-5371d96c0703\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679220}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e12ba108-828e-5d49-a112-8a7fc6da2538\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x e^{x^{2} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{2} + 3$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x e^{x^{2} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(e^{x^{2} + 3}\\\\right)+C.\\n$$\"} {:db/id 17592186679305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6961ed66-12ad-59a8-981a-ff3f279d7b1c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(e^{1 - 2 x^{2}}\\\\right)\" :db/id 17592186679249}] :answer-field/correct {:answer/id #uuid \"6961ed66-12ad-59a8-981a-ff3f279d7b1c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(e^{1 - 2 x^{2}}\\\\right)\" :db/id 17592186679249} :answer-field/id #uuid \"a2ad76e9-9fc2-597e-8fe1-5be7080832df\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679270}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e76c3cbd-bd17-57bc-ac12-6b04360d3aa6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x e^{1 - 2 x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=1 - 2 x^{2}$. Then $\\\\mathrm{d}u=(- 4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x e^{1 - 2 x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{2}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{2}\\\\left(e^{1 - 2 x^{2}}\\\\right)+C.\\n$$\"} {:db/id 17592186679306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e4e59a7d-4dba-5ea9-9f17-2f8b81b97511\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(e^{- x^{2}}\\\\right)\" :db/id 17592186679303}] :answer-field/correct {:answer/id #uuid \"e4e59a7d-4dba-5ea9-9f17-2f8b81b97511\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(e^{- x^{2}}\\\\right)\" :db/id 17592186679303} :answer-field/id #uuid \"14ef9f33-c043-52eb-a759-8bc389cf83d1\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679217}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e7e2ad84-e441-536b-9cb3-764deaafab27\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 x e^{- x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=- x^{2}$. Then $\\\\mathrm{d}u=(- 2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 x e^{- x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n-2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(e^{- x^{2}}\\\\right)+C.\\n$$\"} {:db/id 17592186679307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"437f1665-9174-56cd-afe9-d40705cdf224\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(e^{2 x^{2} + 2}\\\\right)\" :db/id 17592186679234}] :answer-field/correct {:answer/id #uuid \"437f1665-9174-56cd-afe9-d40705cdf224\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(e^{2 x^{2} + 2}\\\\right)\" :db/id 17592186679234} :answer-field/id #uuid \"1a960b19-9d30-5fff-9769-bfc8766836c3\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679221}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e85dd74f-6dd4-57d9-b36f-4d1d2828023a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x e^{2 x^{2} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x^{2} + 2$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x e^{2 x^{2} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(e^{2 x^{2} + 2}\\\\right)+C.\\n$$\"}] :knowledge-point/title \"Integrating Products Containing the Exponential Function\"}",
