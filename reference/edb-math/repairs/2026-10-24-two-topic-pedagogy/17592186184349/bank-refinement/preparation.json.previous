5ee84977\"] [\"e6bb703c-4a82-5658-b9de-057b5ee84977\" :answer/type :answer.type/math] [\"e6bb703c-4a82-5658-b9de-057b5ee84977\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0a3ec117-9cd9-5059-b704-25f5b9d239a5\" :answer/id #uuid \"0a3ec117-9cd9-5059-b704-25f5b9d239a5\"] [\"0a3ec117-9cd9-5059-b704-25f5b9d239a5\" :answer/type :answer.type/math] [\"0a3ec117-9cd9-5059-b704-25f5b9d239a5\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0d048478-c895-527f-8374-1d4e8523596c\" :answer/id #uuid \"0d048478-c895-527f-8374-1d4e8523596c\"] [\"0d048478-c895-527f-8374-1d4e8523596c\" :answer/type :answer.type/math] [\"0d048478-c895-527f-8374-1d4e8523596c\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b3fc57ab-5185-5c92-bdbf-c3ee86d59d7e\" :answer/id #uuid \"b3fc57ab-5185-5c92-bdbf-c3ee86d59d7e\"] [\"b3fc57ab-5185-5c92-bdbf-c3ee86d59d7e\" :answer/type :answer.type/math] [\"b3fc57ab-5185-5c92-bdbf-c3ee86d59d7e\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/id #uuid \"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/key \"answer\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/type :answer-field.type/radio] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/choices \"cdf5a320-3e0a-508e-93d1-271f6f3c1656\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/choices \"e6bb703c-4a82-5658-b9de-057b5ee84977\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/choices \"0a3ec117-9cd9-5059-b704-25f5b9d239a5\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/choices \"0d048478-c895-527f-8374-1d4e8523596c\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/choices \"b3fc57ab-5185-5c92-bdbf-c3ee86d59d7e\"] [\"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/correct \"0a3ec117-9cd9-5059-b704-25f5b9d239a5\"] [\"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/id #uuid \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\"] [\"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/difficulty :question.difficulty/easy] [\"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/answer-fields \"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\"] [17592186184349 :knowledge-point/questions \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\"] [\"generator\" :question-generator/id #uuid \"b5ec3ef0-b432-52ca-b332-fc927d928c7e\"] [\"generator\" :question-generator/script \"generators/0f/0f136e0f6839f0a542eb58fbdb989da4c0b22b3f0848cd37ab3d1a0ed8d27c50/generator.py\"] [17592186184349 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186184349 :knowledge-point/question-generator 17592186679315]]}",
