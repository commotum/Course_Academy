{x^{3}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"62512304-ffcd-570a-abbb-8178e0726d08\" :question/difficulty :question.difficulty/easy] [:db/add \"62512304-ffcd-570a-abbb-8178e0726d08\" :question/answer-fields \"349110d4-711a-5a2a-9959-61ac1fc46bd0\"] [:db/ensure \"62512304-ffcd-570a-abbb-8178e0726d08\" :question/validate] [:db/add 17592186184349 :knowledge-point/questions \"62512304-ffcd-570a-abbb-8178e0726d08\"] [:db/add \"c097c64e-1c3c-52da-9952-29fd3c4429dd\" :answer/id #uuid \"c097c64e-1c3c-52da-9952-29fd3c4429dd\"] [:db/add \"c097c64e-1c3c-52da-9952-29fd3c4429dd\" :answer/type :answer.type/math] [:db/add \"c097c64e-1c3c-52da-9952-29fd3c4429dd\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c097c64e-1c3c-52da-9952-29fd3c4429dd\" :answer/validate] [:db/add \"f43a1968-1979-5a42-9f24-4ef1644eadf9\" :answer/id #uuid \"f43a1968-1979-5a42-9f24-4ef1644eadf9\"] [:db/add \"f43a1968-1979-5a42-9f24-4ef1644eadf9\" :answer/type :answer.type/math] [:db/add \"f43a1968-1979-5a42-9f24-4ef1644eadf9\" :answer/value \"2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f43a1968-1979-5a42-9f24-4ef1644eadf9\" :answer/validate] [:db/add \"724db1c4-e186-5ba7-82cf-83916e4e61b0\" :answer/id #uuid \"724db1c4-e186-5ba7-82cf-83916e4e61b0\"] [:db/add \"724db1c4-e186-5ba7-82cf-83916e4e61b0\" :answer/type :answer.type/math] [:db/add \"724db1c4-e186-5ba7-82cf-83916e4e61b0\" :answer/value \"8\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"724db1c4-e186-5ba7-82cf-83916e4e61b0\" :answer/validate] [:db/add \"0e5ff3d8-7a3f-503c-8992-be9a1189581d\" :answer/id #uuid \"0e5ff3d8-7a3f-503c-8992-be9a1189581d\"] [:db/add \"0e5ff3d8-7a3f-503c-8992-be9a1189581d\" :answer/type :answer.type/math] [:db/add \"0e5ff3d8-7a