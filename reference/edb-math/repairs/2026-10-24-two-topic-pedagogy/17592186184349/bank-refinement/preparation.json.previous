 [:db/add \"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/correct \"0a3ec117-9cd9-5059-b704-25f5b9d239a5\"] [:db/ensure \"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\" :answer-field/validate] [:db/add \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/id #uuid \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\"] [:db/add \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/difficulty :question.difficulty/easy] [:db/add \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/answer-fields \"e3937ad0-18a8-5533-ae3d-07a1f29bcd84\"] [:db/ensure \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\" :question/validate] [:db/add 17592186184349 :knowledge-point/questions \"c22119ed-4d62-59b3-b608-2baf3eae6ef0\"] [:db/add \"generator\" :question-generator/id #uuid \"b5ec3ef0-b432-52ca-b332-fc927d928c7e\"] [:db/add \"generator\" :question-generator/script \"generators/0f/0f136e0f6839f0a542eb58fbdb989da4c0b22b3f0848cd37ab3d1a0ed8d27c50/generator.py\"] [:db/add 17592186184349 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186184349 :knowledge-point/validate]] \"assertions\" [[\"1567ada9-344a-597a-83a0-cf91edd005d3\" :answer/id #uuid \"1567ada9-344a-597a-83a0-cf91edd005d3\"] [\"1567ada9-344a-597a-83a0-cf91edd005d3\" :answer/type :answer.type/math] [\"1567ada9-344a-597a-83a0-cf91edd005d3\" :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\"] [\"47