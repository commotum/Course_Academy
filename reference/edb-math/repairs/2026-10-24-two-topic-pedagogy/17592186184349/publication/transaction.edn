367229" :answer/id #uuid "b6167697-9ec4-598c-a651-883782367229"] [:db/add "b6167697-9ec4-598c-a651-883782367229" :answer/type :answer.type/math] [:db/add "b6167697-9ec4-598c-a651-883782367229" :answer/value "\\frac{4}{3}\\left(e^{x^{3} + 1}\\right)"] [:db/ensure "b6167697-9ec4-598c-a651-883782367229" :answer/validate] [:db/add "230e0161-5fba-582c-8e8c-ffbdd8ee3008" :answer-field/id #uuid "230e0161-5fba-582c-8e8c-ffbdd8ee3008"] [:db/add "230e0161-5fba-582c-8e8c-ffbdd8ee3008" :answer-field/key "answer"] [:db/add "230e0161-5fba-582c-8e8c-ffbdd8ee3008" :answer-field/type :answer-field.type/blank] [:db/add "230e0161-5fba-582c-8e8c-ffbdd8ee3008" :answer-field/choices "b6167697-9ec4-598c-a651-883782367229"] [:db/add "230e0161-5fba-582c-8e8c-ffbdd8ee3008" :answer-field/correct "b6167697-9ec4-598c-a651-883782367229"] [:db/ensure "230e0161-5fba-582c-8e8c-ffbdd8ee3008" :answer-field/validate] [:db/add "b27cddd9-c8a7-5b75-a87c-cc587d429678" :question/id #uuid "b27cddd9-c8a7-5b75-a87c-cc587d429678"] [:db/add "b27cddd9-c8a7-5b75-a87c-cc587d429678" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 x^{2} e^{x^{3} + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int e^{u}\\,\\mathrm{d}u=e^{u}+C$.\n\n{{answer}} $+C$"] [:db/add "b27cddd9-c8a7-5b75-a87c-cc587d429678" :question/worked-solution "Let $u=x^{3} + 1$. Then $\\mathrm{d}u=(3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 x^{2} e^{x^{3} + 1}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{4}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(e^{x^{3} + 1}\\right)+C.\n$$"] [:db/add "b27cddd9-c8a7-5b75-a87c-cc587d429678" :question/difficulty :question.difficulty/moderate] [:db/add "b27cddd9-c8a7-5b75-a87c-cc587d429678" :question/answer-fields "230e0161-5fba-582c-8e8c-ffbdd8ee3008"] [:db/ensure "b27cddd9-c8a7-5b75-a87c-cc587d429678" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "b27cddd9-c8a7-5b75-a87c-cc587d429678"] [:db/add "f3830de4-a5af-52f9-856d-db0c6cc56d7e" :answer/id #uuid "f3830de4-a5af-52f9-856d-db0c6cc56d7e"] [:db/add "f3830de4-a5af-52f9-856d-db0c6cc56d7e" :answer/type :answer.type/math] [:db/add "f3830de4-a5af-52f9-856d-db0c6cc56d7e" :answer/value "e^{2 x^{2}}"] [:db/ensure "f3830de4-a5af-52f9-856d-db0c6cc56d7e" :answer/validate] [:db/add "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6" :answer-field/id #uuid "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6"] [:db/add "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6" :answer-field/key "answer"] [:db/add "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6" :answer-field/type :answer-field.type/blank] [:db/add "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6" :answer-field/choices "f3830de4-a5af-52f9-856d-db0c6cc56d7e"] [:db/add "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6" :answer-field/correct "f3830de4-a5af-52f9-856d-db0c6cc56d7e"] [:db/ensure "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6" :answer-field/validate] [:db/add "9dab4373-3bc8-5360-9d0f-9464e91bb20e" :question/id #uuid "9dab4373-3bc8-5360-9d0f-9464e91bb20e"] [:db/add "9dab4373-3bc8-5360-9d0f-9464e91bb20e" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 x e^{2 x^{2}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int e^{u}\\,\\mathrm{d}u=e^{u}+C$.\n\n{{answer}} $+C$"] [:db/add "9dab4373-3bc8-5360-9d0f-9464e91bb20e" :question/worked-solution "Let $u=2 x^{2}$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 x e^{2 x^{2}}\\,\\mathrm{d}x\\\\&=\\int e^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\nSubstitute back:\n\n$$\ne^{2 x^{2}}+C.\n$$"] [:db/add "9dab4373-3bc8-5360-9d0f-9464e91bb20e" :question/difficulty :question.difficulty/moderate] [:db/add "9dab4373-3bc8-5360-9d0f-9464e91bb20e" :question/answer-fields "1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6"] [:db/ensure "9dab4373-3bc8-5360-9d0f-9464e91bb20e" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "9dab4373-3bc8-5360-9d0f-9464e91bb20e"] [:db/add "9c33e52a-ef5c-5dca-bf52-8df13c19b1ce" :answer/id #uuid "9c33e52a-ef5c-5dca-bf52-8df13c19b1ce"] [:db/add "9c33e52a-ef5c-5dca-bf52-8df13c19b1ce" :answer/type :answer.type/math] [:db/add "9c33e52a-ef5c-5dca-bf52-8df13c19b1ce" :answer/value "\\frac{2}{3}\\left(e^{2 x^{3} + 1}\\right)"] [:db/ensure "9c33e52a-ef5c-5dca-bf52-8df13c19b1ce" :answer/validate] [:db/add "2fb711a7-75fa-5cfb-910d-a08ab701557b" :answer-field/id #uuid "2fb711a7-75fa-5cfb-910d-a08ab701557b"] [:db/add "2fb711a7-75fa-5cfb-910d-a08ab701557b" :answer-field/key "answer"] [:db/add "2fb711a7-75fa-5cfb-910d-a08ab701557b" :answer-field/type :answer-field.type/blank] [:db/add "2fb711a7-75fa-5cfb-910d-a08ab701557b" :answer-field/choices "9c33e52a-ef5c-5dca-bf52-8df13c19b1ce"] [:db/add "2fb711a7-75fa-5cfb-910d-a08ab701557b" :answer-field/correct "9c33e52a-ef5c-5dca-bf52-8df13c19b1ce"] [:db/ensure "2fb711a7-75fa-5cfb-910d-a08ab701557b" :answer-field/validate] [:db/add "06c9f2f2-081d-5e5e-8117-a35b1223b310" :question/id #uuid "06c9f2f2-081d-5e5e-8117-a35b1223b310"] [:db/add "06c9f2f2-081d-5e5e-8117-a35b1223b310" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 x^{2} e^{2 x^{3} + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int e^{u}\\,\\mathrm{d}u=e^{u}+C$.\n\n{{answer}} $+C$"] [:db/add "06c9f2f2-081d-5e5e-8117-a35b1223b310" :question/worked-solution "Let $u=2 x^{3} + 1$. Then $\\mathrm{d}u=(6 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 x^{2} e^{2 x^{3} + 1}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{2}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{2}{3}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{3}\\left(e^{2 x^{3} + 1}\\right)+C.\n$$"] [:db/add "06c9f2f2-081d-5e5e-8117-a35b1223b310" :question/difficulty :question.difficulty/moderate] [:db/add "06c9f2f2-081d-5e5e-8117-a35b1223b310" :question/answer-fields "2fb711a7-75fa-5cfb-910d-a08ab701557b"] [:db/ensure "06c9f2f2-081d-5e5e-8117-a35b1223b310" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "06c9f2f2-081d-5e5e-8117-a35b1223b310"] [:db/add "437f1665-9174-56cd-afe9-d40705cdf224" :answer/id #uuid "437f1665-9174-56cd-afe9-d40705cdf224"] [:db/add "437f1665-9174-56cd-afe9-d40705cdf224" :answer/type :answer.type/math] [:db/add "437f1665-9174-56cd-afe9-d40705cdf224" :answer/value "\\frac{1}{4}\\left(e^{2 x^{2} + 2}\\right)"] [:db/ensure "437f1665-9174-56cd-afe9-d40705cdf224" :answer/validate] [:db/add "1a960b19-9d30-5fff-9769-bfc8766836c3" :answer-field/id #uuid "1a960b19-9d30-5fff-9769-bfc8766836c3"] [:db/add "1a960b19-9d30-5fff-9769-bfc8766836c3" :answer-field/key "answer"] [:db/add "1a960b19-9d30-5fff-9769-bfc8766836c3" :answer-field/type :answer-field.type/blank] [:db/add "1a960b19-9d30-5fff-9769-bfc8766836c3" :answer-field/choices "437f1665-9174-56cd-afe9-d40705cdf224"] [:db/add "1a960b19-9d30-5fff-9769-bfc8766836c3" :answer-field/correct "437f1665-9174-56cd-afe9-d40705cdf224"] [:db/ensure "1a960b19-9d30-5fff-9769-bfc8766836c3" :answer-field/validate] [:db/add "e85dd74f-6dd4-57d9-b36f-4d1d2828023a" :question/id #uuid "e85dd74f-6dd4-57d9-b36f-4d1d2828023a"] [:db/add "e85dd74f-6dd4-57d9-b36f-4d1d2828023a" :question/problem "Find an antiderivative.\n\n$$\n\\int x e^{2 x^{2} + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int e^{u}\\,\\mathrm{d}u=e^{u}+C$.\n\n{{answer}} $+C$"] [:db/add "e85dd74f-6dd4-57d9-b36f-4d1d2828023a" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int x e^{2 x^{2} + 2}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(e^{2 x^{2} + 2}\\right)+C.\n$$"] [:db/add "e85dd74f-6dd4-57d9-b36f-4d1d2828023a" :question/difficulty :question.difficulty/moderate] [:db/add "e85dd74f-6dd4-57d9-b36f-4d1d2828023a" :question/answer-fields "1a960b19-9d30-5fff-9769-bfc8766836c3"] [:db/ensure "e85dd74f-6dd4-57d9-b36f-4d1d2828023a" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "e85dd74f-6dd4-57d9-b36f-4d1d2828023a"] [:db/add "cbc3a831-f582-5a3b-8016-0dcdfb035e2e" :answer/id #uuid "cbc3a831-f582-5a3b-8016-0dcdfb035e2e"] [:db/add "cbc3a831-f582-5a3b-8016-0dcdfb035e2e" :answer/type :answer.type/math] [:db/add "cbc3a831-f582-5a3b-8016-0dcdfb035e2e" :answer/value "- \\frac{3}{2}\\left(e^{3 - x^{2}}\\right)"] [:db/ensure "cbc3a831-f582-5a3b-8016-0dcdfb035e2e" :answer/validate] [:db/add "652bd61e-0e58-5a98-bedf-e549f8c598b4" :answer-field/id #uuid "652bd61e-0e58-5a98-bedf-e549f8c598b4"] [:db/add "652bd61e-0e58-5a98-bedf-e549f8c598b4" :answer-field/key "answer"] [:db/add "652bd61e-0e58-5a98-bedf-e549f8c598b4" :answer-field/type :answer-field.type/blank] [:db/add "652bd61e-0e58-5a98-bedf-e549f8c598b4" :answer-field/choices "cbc3a831-f582-5a3b-8016-0dcdfb035e2e"] [:db/add "652bd61e-0e58-5a98-bedf-e549f8c598b4" :answer-field/correct "cbc3a831-f582-5a3b-8016-0dcdfb035e2e"] [:db/ensure "652bd61e-0e58-5a98-bedf-e549f8c598b4" :answer-field/validate] [:db/add "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0" :question/id #uuid "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0"] [:db/add "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 x e^{3 - x^{2}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int e^{u}\\,\\mathrm{d}u=e^{u}+C$.\n\n{{answer}} $+C$"] [:db/add "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0" :question/worked-solution "Let $u=3 - x^{2}$. Then $\\mathrm{d}u=(- 2 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 x e^{3 - x^{2}}\\,\\mathrm{d}x\\\\&=- \\frac{3}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n- \\frac{3}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=- \\frac{3}{2}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{3}{2}\\left(e^{3 - x^{2}}\\right)+C.\n$$"] [:db/add "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0" :question/difficulty :question.difficulty/hard] [:db/add "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0" :question/answer-fields "652bd61e-0e58-5a98-bedf-e549f8c598b4"] [:db/ensure "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "b5d86a9f-bdbe-5022-a3bc-edac0eed87f0"] [:db/add "e089a252-0a60-55ff-818c-399ae692c533" :answer/id #uuid "e089a252-0a60-55ff-818c-399ae692c533"] [:db/add "e089a252-0a60-55ff-818c-399ae692c533" :answer/type :answer.type/math] [:db/add "e089a252-0a60-55ff-818c-399ae692c533" :answer/value "- \\frac{1}{3}\\left(e^{3 - 2 x^{3}}\\right)"] [:db/ensure "e089a252-0a60-55ff-818c-399ae692c533" :answer/validate] [:db/add "ea418b39-60b8-50d7-a170-89956e9a9780" :answer-field/id #uuid "ea418b39-60b8-50d7-a170-89956e9a9780"] [:db/add "ea418b39-60b8-50d7-a170-89956e9a9780" :answer-field/key "answer"] [:db/add "ea418b39-60b8-50d7-a170-89956e9a9780" :answer-field/type :answer-field.type/blank] [:db/add "ea418b39-60b8-50d7-a170-89956e9a9780" :answer-field/choices "e089a252-0a60-55ff-818c-399ae692c533"] [:db/add "ea418b39-60b8-50d7-a170-89956e9a9780" :answer-field/correct "e089a252-0a60-55ff-818c-399ae692c533"] [:db/ensure "ea418b39-60b8-50d7-a170-89956e9a9780" :answer-field/validate] [:db/add "d79e085c-6dcc-5bab-abc6-81362784f9c7" :question/id #uuid "d79e085c-6dcc-5bab-abc6-81362784f9c7"] [:db/add "d79e085c-6dcc-5bab-abc6-81362784f9c7" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 x^{2} e^{3 - 2 x^{3}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int e^{u}\\,\\mathrm{d}u=e^{u}+C$.\n\n{{answer}} $+C$"] [:db/add "d79e085c-6dcc-5bab-abc6-81362784f9c7" :question/worked-solution "Let $u=3 - 2 x^{3}$. Then $\\mathrm{d}u=(- 6 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 x^{2} e^{3 - 2 x^{3}}\\,\\mathrm{d}x\\\\&=- \\frac{1}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n- \\frac{1}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=- \\frac{1}{3}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{1}{3}\\left(e^{3 - 2 x^{3}}\\right)+C.\n$$"] [:db/add "d79e085c-6dcc-5bab-abc6-81362784f9c7" :question/difficulty :question.difficulty/hard] [:db/add "d79e085c-6dcc-5bab-abc6-81362784f9c7" :question/answer-fields "ea418b39-60b8-50d7-a170-89956e9a9780"] [:db/ensure "d79e085c-6dcc-5bab-abc6-81362784f9c7" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "d79e085c-6dcc-5bab-abc6-81362784f9c7"] [:db/add "6961ed66-12ad-59a8-981a-ff3f279d7b1c" :answer/id #uuid "6961ed66-12ad-59a8-981a-ff3f279d7b1c"] [:db/add "6961ed66-12ad-59a8-981a-ff3f279d7b1c" :answer/type :answer.type/math] [:db/add "6961ed66-12ad-59a8-981a-ff3f279d7b1c" :answer/value "- \\frac{1}{2}\\left(e^{1 - 2 x^{2}}\\right)"] [:db/ensure "6961ed66-12ad-59a8-981a-ff3f279d7b1c" :answer/validate] [:db/add "a2ad76e9-9fc2-597e-8fe1-5be7080832df" :answer-field/id #uuid "a2ad76e9-9fc2-597e-8fe1-5be7080832df"] [:db/add "a2ad76e9-9fc2-597e-8fe1-5be7080832df" :answer-field/key "answer"] [:db/add "a2ad76e9-9fc2-597e-8fe1-5be7080832df" :answer-field/type :answer-field.type/blank] [:db/add "a2ad76e9-9fc2-597e-8fe1-5be7080832df" :answer-field/choices "6961ed66-12ad-59a8-981a-ff3f279d7b1c"] [:db/add "a2ad76e9-9fc2-597e-8fe1-5be7080832df" :answer-field/correct "6961ed66-12ad-59a8-981a-ff3f279d7b1c"] [:db/ensure "a2ad76e9-9fc2-597e-8fe1-5be7080832df" :answer-field/validate] [:db/add "e76c3cbd-bd17-57bc-ac12-6b04360d3aa6" :question/id #uuid "e76c3cbd-bd17-57bc-ac12-6b04360d3aa6"] [:db/add "e76c3cbd-bd17-57bc-ac12-6b04360d3aa6" :question/problem "Find an antiderivative.\n\n$$\n\\i