#{[{:db/id #edb/ref 17592186184349 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183945 :question/id #uuid "3e9586ee-12d1-5dbb-81f6-0f0a4998e00a" :question/math-academy-id "e-14402" :question/problem "Calculate  $$\n\\displaystyle{\\int x^2 e^{x^3+1}\\, \\textrm{d}x }.\n$$" :question/worked-solution "Let's introduce the new variable $u = x^3+1.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 3x^2\\quad\\Longrightarrow\\quad\\dfrac 1 3 \\textrm{d}u = x^2 \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{{x}^{3}+1}\\cdot \\,{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{{x}^{3}+1}+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050101 :topic/difficulty 1.7766990018568227 :topic/id #uuid "2d31fc2e-19fe-50d4-bccf-d60b3f5db5c4" :topic/knowledge-points [{:db/id #edb/ref 17592186096655} {:db/id #edb/ref 17592186096656}] :topic/math-academy-id 1112 :topic/next [{:db/id #edb/ref 17592186048245}] :topic/title "Integrating Exponential Functions Using Linear Substitution"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186679315 :question-generator/id #uuid "841eb95a-6e32-5cac-85a0-9752923d34b6" :question-generator/script "generators/9a/9a1e9cd257170d1b8526c23ccb7327ae29df3b762e973622b908b87c56f6c9dd/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186184470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83d22492-39be-5818-b2f9-72466fc0f7d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}e^{x^{3} + 2} + C" :db/id #edb/ref 17592186180998} {:answer/id #uuid "a7ac4ca7-0b5d-5006-8e17-41afe089eb14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}e^{x^{3} + 2} + C"