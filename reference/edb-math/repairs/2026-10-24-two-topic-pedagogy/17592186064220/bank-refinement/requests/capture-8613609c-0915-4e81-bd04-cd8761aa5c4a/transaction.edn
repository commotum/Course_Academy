[[:db/add "590ee3ac-29da-5915-973b-2c0a2cd3ea67" :answer/id #uuid "590ee3ac-29da-5915-973b-2c0a2cd3ea67"] [:db/add "590ee3ac-29da-5915-973b-2c0a2cd3ea67" :answer/type :answer.type/math] [:db/add "590ee3ac-29da-5915-973b-2c0a2cd3ea67" :answer/value "- \\frac{6}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "590ee3ac-29da-5915-973b-2c0a2cd3ea67" :answer/validate] [:db/add "552fcb1f-a952-5d01-b8cc-ed3d8f0f902c" :answer/id #uuid "552fcb1f-a952-5d01-b8cc-ed3d8f0f902c"] [:db/add "552fcb1f-a952-5d01-b8cc-ed3d8f0f902c" :answer/type :answer.type/math] [:db/add "552fcb1f-a952-5d01-b8cc-ed3d8f0f902c" :answer/value "\\frac{12}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "552fcb1f-a952-5d01-b8cc-ed3d8f0f902c" :answer/validate] [:db/add "213bb1e0-aba2-54cf-9cef-b0f840c151f2" :answer/id #uuid "213bb1e0-aba2-54cf-9cef-b0f840c151f2"] [:db/add "213bb1e0-aba2-54cf-9cef-b0f840c151f2" :answer/type :answer.type/math] [:db/add "213bb1e0-aba2-54cf-9cef-b0f840c151f2" :answer/value "\\frac{3}{20}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "213bb1e0-aba2-54cf-9cef-b0f840c151f2" :answer/validate] [:db/add "94b403c1-50cf-5b1e-86ed-52ef879abe4a" :answer/id #uuid "94b403c1-50cf-5b1e-86ed-52ef879abe4a"] [:db/add "94b403c1-50cf-5b1e-86ed-52ef879abe4a" :answer/type :answer.type/math] [:db/add "94b403c1-50cf-5b1e-86ed-52ef879abe4a" :answer/value "\\frac{3}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "94b403c1-50cf-5b1e-86ed-52ef879abe4a" :answer/validate] [:db/add "f2d0c1d2-470b-51a8-99be-33c8f93733e1" :answer/id #uuid "f2d0c1d2-470b-51a8-99be-33c8f93733e1"] [:db/add "f2d0c1d2-470b-51a8-99be-33c8f93733e1" :answer/type :answer.type/math] [:db/add "f2d0c1d2-470b-51a8-99be-33c8f93733e1" :answer/value "\\frac{9}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u