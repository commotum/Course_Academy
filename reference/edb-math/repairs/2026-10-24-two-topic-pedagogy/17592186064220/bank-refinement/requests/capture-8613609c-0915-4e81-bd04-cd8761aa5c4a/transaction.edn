\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{3}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "72307b4e-6785-5b3a-956a-ba0b7f481f48" :question/difficulty :question.difficulty/easy] [:db/add "72307b4e-6785-5b3a-956a-ba0b7f481f48" :question/answer-fields "ec4b89b0-4bc1-5159-8fab-b3af69b98d88"] [:db/ensure "72307b4e-6785-5b3a-956a-ba0b7f481f48" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "72307b4e-6785-5b3a-956a-ba0b7f481f48"] [:db/add "e39b2ea7-21f3-51c2-ae7b-75867ed830c4" :answer/id #uuid "e39b2ea7-21f3-51c2-ae7b-75867ed830c4"] [:db/add "e39b2ea7-21f3-51c2-ae7b-75867ed830c4" :answer/type :answer.type/math] [:db/add "e39b2ea7-21f3-51c2-ae7b-75867ed830c4" :answer/value "\\frac{1}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "e39b2ea7-21f3-51c2-ae7b-75867ed830c4" :answer/validate] [:db/add "d9997f8b-70c8-5b6b-9adf-d116be5e2b18" :answer/id #uuid "d9997f8b-70c8-5b6b-9adf-d116be5e2b18"] [:db/add "d9997f8b-70c8-5b6b-9adf-d116be5e2b18" :answer/type :answer.type/math] [:db/add "d9997f8b-70c8-5b6b-9adf-d116be5e2b18" :answer/value "\\frac{2}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "d9997f8b-70c8-5b6b-9adf-d116be5e2b18" :answer/validate] [:db/add "8bde949c-ac2c-58ae-81b3-e150c37b1af1" :answer/id #uuid "8bde949c-ac2c-58ae-81b3-e150c37b1af1"] [:db/add "8bde949c-ac2c-58ae-81b3-e150c37b1af1" :answer/type :answer.type/math] [:db/add "8bde949c-ac2c-58ae-81b3-e150c37b1af1" :answer/value "\\frac{1}{6}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "8bde949c-ac2c-58ae-81b3-e150c37b1af1" :answer/validate] [:db/add "24086f52-5b57-5497-a236-fd260d1125a0" :answer/id #uuid "24086f52-5b57-5497-a236-fd260d1125a0"] [:db/add "24086f52-5b57-5497-a236-fd260d1125a0" :answer/type :answer.type/math] [:db/add "24086f52-5b57-5497-a236-fd260d1125a0" :answer/value "- \\frac{4}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "24086f52-5b57-5497-a236-fd260d1125a0" :answer/validate] [:db/add "0b2c0a56-e5bf-5fbb-8c37-fc3d0751d733" :answer/id #uuid "0b2c0a56-e5bf-5fbb-8c37-fc3d0751d733"] [:db/add "0b2c0a56-e5bf-5fbb-8c37-fc3d0751d733" :answer/type :answer.type/math] [:db/add "0b2c0a56-e5bf-5fbb-8c37-fc3d0751d733" :answer/value "\\frac{4}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "0b2c0a56-e5bf-5fbb-8c37-fc3d0751d733" :answer/validate] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/id #uuid "c58cda67-5ebf-5815-8fba-b00669eaf749"] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/key "answer"] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/type :answer-field.type/radio] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/choices "e39b2ea7-21f3-51c2-ae7b-75867ed830c4"] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/choices "d9997f8b-70c8-5b6b-9adf-d116be5e2b18"] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/choices "8bde949c-ac2c-58ae-81b3-e150c37b1af1"] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/choices "24086f52-5b57-5497-a236-fd260d1125a0"] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/choices "0b2c0a56-e5bf-5fbb-8c37-fc3d0751d733"] [:db/add "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/correct "d9997f8b-70c8-5b6b-9adf-d116be5e2b18"] [:db/ensure "c58cda67-5ebf-5815-8fba-b00669eaf749" :answer-field/validate] [:db/add "b9249072-7945-5b1f-a5ca-faccd3d7db88" :question/id #uuid "b9249072-7945-5b1f-a5ca-faccd3d7db88"] [:db/add "b9249072-7945-5b1f-a5ca-faccd3d7db88" :question/problem "Use the substitution $u=3 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{3}} \\frac{2}{9 x^{2} + 1}\\,\\mathrm{d}x\n$$"] [:db/add "b9249072-7945-5b1f-a5ca-faccd3d7db88" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{3}=\\frac{2}{3}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{3}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} \\frac{2}{9 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{2}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "b9249072-7945-5b1f-a5ca-faccd3d7db88" :question/difficulty :question.difficulty/easy] [:db/add "b9249072-7945-5b1f-a5ca-faccd3d7db88" :question/answer-fields "c58cda67-5ebf-5815-8fba-b00669eaf749"] [:db/ensure "b9249072-7945-5b1f-a5ca-faccd3d7db88" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "b9249072-7945-5b1f-a5ca-faccd3d7db88"] [:db/add "75d2a700-c9db-53c9-b311-71eff8038144" :answer/id #uuid "75d2a700-c9db-53c9-b311-71eff8038144"] [:db/add "75d2a700-c9db-53c9-b311-71eff8038144" :answer/type :answer.type/math] [:db/add "75d2a700-c9db-53c9-b311-71eff8038144" :answer/value "\\frac{1}{4}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "75d2a700-c9db-53c9-b311-71eff8038144" :answer/validate] [:db/add "274dc628-a5a7-5262-b684-c9e4e3bcf005" :answer/id #uuid "274dc628-a5a7-5262-b684-c9e4e3bcf005"] [:db/add "274dc628-a5a7-5262-b684-c9e4e3bcf005" :answer/type :answer.type/math] [:db/add "274dc628-a5a7-5262-b684-c9e4e3bcf005" :answer/value "-3\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "274dc628-a5a7-5262-b684-c9e4e3bcf005" :answer/validate] [:db/add "c0348e5d-0372-55ce-9d72-93104a898efe" :answer/id #uuid "c0348e5d-0372-55ce-9d72-93104a898efe"] [:db/add "c0348e5d-0372-55ce-9d72-93104a898efe" :answer/type :answer.type/math] [