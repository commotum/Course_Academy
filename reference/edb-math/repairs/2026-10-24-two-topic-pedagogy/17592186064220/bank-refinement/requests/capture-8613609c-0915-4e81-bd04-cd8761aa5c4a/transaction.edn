5-f2aa5e1e51b9"] [:db/add "62cceaea-b13f-5179-92a5-f2aa5e1e51b9" :question/problem "Use the substitution $u=5 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{10}} \\frac{2}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "62cceaea-b13f-5179-92a5-f2aa5e1e51b9" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{5}=\\frac{2}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{10}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{10}} \\frac{2}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{2}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{2}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "62cceaea-b13f-5179-92a5-f2aa5e1e51b9" :question/difficulty :question.difficulty/easy] [:db/add "62cceaea-b13f-5179-92a5-f2aa5e1e51b9" :question/answer-fields "5a0b6deb-b038-5974-8514-34af4bc3a28b"] [:db/ensure "62cceaea-b13f-5179-92a5-f2aa5e1e51b9" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "62cceaea-b13f-5179-92a5-f2aa5e1e51b9"] [:db/add "2c090cd3-c0c6-5e38-85f2-7478c68e0ae8" :answer/id #uuid "2c090cd3-c0c6-5e38-85f2-7478c68e0ae8"] [:db/add "2c090cd3-c0c6-5e38-85f2-7478c68e0ae8" :answer/type :answer.type/math] [:db/add "2c090cd3-c0c6-5e38-85f2-7478c68e0ae8" :answer/value "\\frac{1}{8}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "2c090cd3-c0c6-5e38-85f2-7478c68e0ae8" :answer/validate] [:db/add "2aeb26a0-e6e3-5188-9417-6267adb3f4f8" :answer/id #uuid "2aeb26a0-e6e3-5188-9417-6267adb3f4f8"] [:db/add "2aeb26a0-e6e3-5188-9417-6267adb3f4f8" :answer/type :answer.type/math] [:db/add "2aeb26a0-e6e3