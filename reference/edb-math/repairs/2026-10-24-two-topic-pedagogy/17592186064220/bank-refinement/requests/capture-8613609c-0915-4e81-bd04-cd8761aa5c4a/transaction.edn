80ff84fac9" :answer-field/validate] [:db/add "eaf81293-755d-5e09-8129-8d16222ce3b4" :question/id #uuid "eaf81293-755d-5e09-8129-8d16222ce3b4"] [:db/add "eaf81293-755d-5e09-8129-8d16222ce3b4" :question/problem "Use the substitution $u=2 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{4}} \\frac{2}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "eaf81293-755d-5e09-8129-8d16222ce3b4" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{2}=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{4}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{4}} \\frac{2}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\\\\&=\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\n$$"] [:db/add "eaf81293-755d-5e09-8129-8d16222ce3b4" :question/difficulty :question.difficulty/easy] [:db/add "eaf81293-755d-5e09-8129-8d16222ce3b4" :question/answer-fields "f51fbec3-1e78-5859-b46b-1880ff84fac9"] [:db/ensure "eaf81293-755d-5e09-8129-8d16222ce3b4" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "eaf81293-755d-5e09-8129-8d16222ce3b4"] [:db/add "ef9b8017-5293-5302-859c-691c0329147d" :answer/id #uuid "ef9b8017-5293-5302-859c-691c0329147d"] [:db/add "ef9b8017-5293-5302-859c-691c0329147d" :answer/type :answer.type/math] [:db/add "ef9b8017-5293-5302-859c-691c0329147d" :answer/value "\\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "ef9b8017-5293-5302-859c-691c0329147d" :answer/validate] [:db/add "5f948732-e92d-5a70-bc4d-18f89c96a234" :answer/id #uuid "5f948732-e92d-5a70-bc4d-18f89c96a234"] [:db/add "5f948732-e92d-5a70-bc4d-18f89c96a234" :answer/type :answer.type/math] [:db/add "5f948732-e92d-5a70-bc4d-18f89c96a234" :answer/value "\\frac{1}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "5f948732-e92d-5a70-bc4d-18f89c96a234" :answer/validate] [:db/add "dfa4a012-7797-547f-90c2-6b9fb60c8d29" :answer/id #uuid "dfa4a012-7797-547f-90c2-6b9fb60c8d29"] [:db/add "dfa4a012-7797-547f-90c2-6b9fb60c8d29" :answer/type :answer.type/math] [:db/add "dfa4a012-7797-547f-90c2-6b9fb60c8d29" :answer/value "-3\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "dfa4a012-7797-547f-90c2-6b9fb60c8d29" :answer/validate] [:db/add "aee33936-a65d-5b77-8bdf-a729e1364bce" :answer/id #uuid "aee33936-a65d-5b77-8bdf-a729e1364bce"] [:db/add "aee33936-a65d-5b77-8bdf-a729e1364bce" :answer/type :answer.type/math] [:db/add "aee33936-a65d-5b77-8bdf-a729e1364bce" :answer/value "- \\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "aee33936-a65d-5b77-8bdf-a729e1364bce" :answer/validate] [:db/add "33100aac-50de-58de-9226-e9a2e03cf619" :answer/id #uuid "33100aac-50de-58de-9226-e9a2e03cf619"] [:db/add "33100aac-50de-58de-9226-e9a2e03cf619" :answer/type :answer.type/math] [:db/add "33100aac-50de-58de-9226-e9a2e03cf619" :answer/value "3\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "33100aac-50de-58de-9226-e9a2e03cf619" :answer/validate] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/id #uuid "661dc090-4116-5835-a6fc-3208f0396a43"] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/key "answer"] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/type :answer-field.type/radio] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/choices "ef9b8017-5293-5302-859c-691c0329147d"] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/choices "5f948732-e92d-5a70-bc4d-18f89c96a234"] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/choices "dfa4a012-7797-547f-90c2-6b9fb60c8d29"] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/choices "aee33936-a65d-5b77-8bdf-a729e1364bce"] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/choices "33100aac-50de-58de-9226-e9a2e03cf619"] [:db/add "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/correct "ef9b8017-5293-5302-859c-691c0329147d"] [:db/ensure "661dc090-4116-5835-a6fc-3208f0396a43" :answer-field/validate] [:db/add "1739e8bf-8b59-5e41-9a78-b8eae08113ba" :question/id #uuid "1739e8bf-8b59-5e41-9a78-b8eae08113ba"] [:db/add "1739e8bf-8b59-5e41-9a78-b8eae08113ba" :question/problem "Use the substitution $u=2 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{2}} \\frac{3}{4 x^{2} + 1}\\,\\mathrm{d}x\n$$"] [:db/add "1739e8bf-8b59-5e41-9a78-b8eae08113ba" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{2}=\\frac{3}{2}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{2}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{2}} \\frac{3}{4 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "1739e8bf-8b59-5e41-9a78-b8eae08113ba" :question/difficulty :question.difficulty/easy] [:db/add "1739e8bf-8b59-5e41-9a78-b8eae08113ba" :question/answer-fields "661dc090-4116-5835-a6fc-3208f0396a43"] [:db/ensure "1739e8bf-8b59-5e41-9a78-b8eae08113ba" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "1739e8bf-8b59-5e41-9a78-b8eae08113ba"] [:db/add "c89f7cd5-99d3-53e9-82a1-fca98360253c" :answer/id #uuid "c89f7cd5-99d3-53e9-82a1-fca98360253c"] [:db/add "c89f7cd5-99d3-53e9-82a1-fca98360253c" :an