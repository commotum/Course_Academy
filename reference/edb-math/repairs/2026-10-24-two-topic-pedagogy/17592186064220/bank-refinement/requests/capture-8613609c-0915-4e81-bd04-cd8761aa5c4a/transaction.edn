athrm{d}u\\right).\n$$"] [:db/add "289cafeb-359b-591c-aa6c-1b558fe4c34b" :question/difficulty :question.difficulty/easy] [:db/add "289cafeb-359b-591c-aa6c-1b558fe4c34b" :question/answer-fields "f038215d-8bc0-543e-b0f2-45834a846ef8"] [:db/ensure "289cafeb-359b-591c-aa6c-1b558fe4c34b" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "289cafeb-359b-591c-aa6c-1b558fe4c34b"] [:db/add "d36e9edc-a7cc-51ce-9b66-c7fe4e007712" :answer/id #uuid "d36e9edc-a7cc-51ce-9b66-c7fe4e007712"] [:db/add "d36e9edc-a7cc-51ce-9b66-c7fe4e007712" :answer/type :answer.type/math] [:db/add "d36e9edc-a7cc-51ce-9b66-c7fe4e007712" :answer/value "\\frac{12}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "d36e9edc-a7cc-51ce-9b66-c7fe4e007712" :answer/validate] [:db/add "8831b9f9-d282-5391-89a7-7832f651a39a" :answer/id #uuid "8831b9f9-d282-5391-89a7-7832f651a39a"] [:db/add "8831b9f9-d282-5391-89a7-7832f651a39a" :answer/type :answer.type/math] [:db/add "8831b9f9-d282-5391-89a7-7832f651a39a" :answer/value "\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "8831b9f9-d282-5391-89a7-7832f651a39a" :answer/validate] [:db/add "e528e5f8-a327-5f4b-bf0c-b19d8b259e2d" :answer/id #uuid "e528e5f8-a327-5f4b-bf0c-b19d8b259e2d"] [:db/add "e528e5f8-a327-5f4b-bf0c-b19d8b259e2d" :answer/type :answer.type/math] [:db/add "e528e5f8-a327-5f4b-bf0c-b19d8b259e2d" :answer/value "- \\frac{6}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "e528e5f8-a327-5f4b-bf0c-b19d8b259e2d" :answer/validate] [:db/add "0b4aa0b1-d801-53fe-94df-29e4858ae740" :answer/id #uuid "0b4aa0b1-d801-53fe-94df-29e4858ae740"] [:db/add "0b4aa0b1-d801-53fe-94df-29e4858ae740" :answer/type :answer.type/math] [:db/add "0b4aa0b1-d801-53fe-94df-29e4858ae740" :answer/value "\\frac{3}{10}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "0b4aa0b1-d801-53fe-94df-29e4858ae740" :answer/validate] [:db/add "b85a2c7