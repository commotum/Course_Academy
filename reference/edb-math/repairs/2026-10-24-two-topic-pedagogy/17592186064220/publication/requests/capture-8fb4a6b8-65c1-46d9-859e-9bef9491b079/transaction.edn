[[:db/add "fad669bf-e90e-543e-be08-273a10645ddd" :answer/id #uuid "fad669bf-e90e-543e-be08-273a10645ddd"] [:db/add "fad669bf-e90e-543e-be08-273a10645ddd" :answer/type :answer.type/math] [:db/add "fad669bf-e90e-543e-be08-273a10645ddd" :answer/value "\\frac{3}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "fad669bf-e90e-543e-be08-273a10645ddd" :answer/validate] [:db/add "fb004aaa-7d4c-5eae-9eb7-e4d0823539b6" :answer/id #uuid "fb004aaa-7d4c-5eae-9eb7-e4d0823539b6"] [:db/add "fb004aaa-7d4c-5eae-9eb7-e4d0823539b6" :answer/type :answer.type/math] [:db/add "fb004aaa-7d4c-5eae-9eb7-e4d0823539b6" :answer/value "\\frac{3}{10}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "fb004aaa-7d4c-5eae-9eb7-e4d0823539b6" :answer/validate] [:db/add "9ead6177-d303-5cab-b8ea-a5219cccb094" :answer/id #uuid "9ead6177-d303-5cab-b8ea-a5219cccb094"] [:db/add "9ead6177-d303-5cab-b8ea-a5219cccb094" :answer/type :answer.type/math] [:db/add "9ead6177-d303-5cab-b8ea-a5219cccb094" :answer/value "\\frac{6}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "9ead6177-d303-5cab-b8ea-a5219cccb094" :answer/validate] [:db/add "6b59afd9-f2c2-5e5e-9970-6f992e37ea86" :answer/id #uuid "6b59afd9-f2c2-5e5e-9970-6f992e37ea86"] [:db/add "6b59afd9-f2c2-5e5e-9970-6f992e37ea86" :answer/type :answer.type/math] [:db/add "6b59afd9-f2c2-5e5e-9970-6f992e37ea86" :answer/value "\\frac{9}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "6b59afd9-f2c2-5e5e-9970-6f992e37ea86" :answer/validate] [:db/add "b1ec166a-a9bc-539d-9701-76c30fbff55b" :answer/id #uuid "b1ec166a-a9bc-539d-9701-76c30fbff55b"] [:db/add "b1ec166a-a9bc-539d-9701-76c30fbff55b" :answer/type :answer.type/math] [:db/add "b1ec166a-a9bc-539d-9701-76c30fbff55b" :answer/value "- \\frac{3}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "b1ec166a-a9bc-539d-9701-76c30fbff55b" :answer/validate] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/id #uuid "c10b5724-2833-5916-85d0-8f8b33bab82c"] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/key "answer"] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/type :answer-field.type/radio] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/choices "fad669bf-e90e-543e-be08-273a10645ddd"] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/choices "fb004aaa-7d4c-5eae-9eb7-e4d0823539b6"] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/choices "9ead6177-d303-5cab-b8ea-a5219cccb094"] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/choices "6b59afd9-f2c2-5e5e-9970-6f992e37ea86"] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/choices "b1ec166a-a9bc-539d-9701-76c30fbff55b"] [:db/add "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/correct "fad669bf-e90e-543e-be08-273a10645ddd"] [:db/ensure "c10b5724-2833-5916-85d0-8f8b33bab82c" :answer-field/validate] [:db/add "67653320-5f1a-514c-9009-48894d1fa597" :question/id #uuid "67653320-5f1a-514c-9009-48894d1fa597"] [:db/add "67653320-5f1a-514c-9009-48894d1fa597" :question/problem "Use the substitution $u=5 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{10}} \\frac{3}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\n$$"] [:db/add "67653320-5f1a-514c-9009-48894d1fa597" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{5}=\\frac{3}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{10}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{10}} \\frac{3}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{3}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "67653320-5f1a-514c-9009-48894d1fa597" :question/difficulty :question.difficulty/easy] [:db/add "67653320-5f1a-514c-9009-48894d1fa597" :question/answer-fields "c10b5724-2833-5916-85d0-8f8b33bab82c"] [:db/ensure "67653320-5f1a-514c-9009-48894d1fa597" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "67653320-5f1a-514c-9009-48894d1fa597"] [:db/add "03d5b975-d657-53f4-8d36-078f875960bb" :answer/id #uuid "03d5b975-d657-53f4-8d36-078f875960bb"] [:db/add "03d5b975-d657-53f4-8d36-078f875960bb" :answer/type :answer.type/math] [:db/add "03d5b975-d657-53f4-8d36-078f875960bb" :answer/value "\\frac{1}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "03d5b975-d657-53f4-8d36-078f875960bb" :answer/validate] [:db/add "d08db519-79ee-52a5-bffc-d68c86a11848" :answer/id #uuid "d08db519-79ee-52a5-bffc-d68c86a11848"] [:db/add "d08db519-79ee-52a5-bffc-d68c86a11848" :answer/type :answer.type/math] [:db/add "d08db519-79ee-52a5-bffc-d68c86a11848" :answer/value "\\frac{4}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "d08db519-79ee-52a5-bffc-d68c86a11848" :answer/validate] [:db/add "4f1fbc1f-a7b4-5aa0-aab7-92081dbdffa5" :answer/id #uuid "4f1fbc1f-a7b4-5aa0-aab7-92081dbdffa5"] [:db/add "4f1fbc1f-a7b4-5aa0-aab7-92081dbdffa5" :answer/type :answer.type/math] [:db/add "4f1fbc1f-a7b4-5aa0-aab7-92081dbdffa5" :answer/value "\\frac{2}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "4f1fbc1f-a7b4-5aa0-aab7-92081dbdffa5" :answer/validate] [:db/add "fe6e30ab-f88f-59d9-bc5e-71c102d0efd6" :answer/id #uuid "fe6e30ab-f88f-59d9-bc5e-71c102d0efd6"] [:db/add "fe6e30ab-f88f-59d9-bc5e-71c102d0efd6" :answer/type :answer.type/math] [:db/add "fe6e30ab-f88f-59d9-bc5e-71c102d0efd6" :answer/value "- \\frac{2}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "fe6e30ab-f88f-59d9-bc5e-71c102d0efd6" :answer/validate] [:db/add "6d7bdd9f-7915-5cbd-b87c-3174d06d5ecf" :answer/id #uuid "6d7bdd9f-7915-5cbd-b87c-3174d06d5ecf"] [:db/add "6d7bdd9f-7915-5cbd-b87c-3174d06d5ecf" :answer/type :answer.type/math] [:db/add "6d7bdd9f-7915-5cbd-b87c-3174d06d5ecf" :answer/value "2\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "6d7bdd9f-7915-5cbd-b87c-3174d06d5ecf" :answer/validate] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/id #uuid "9a365cf9-122e-523d-aa85-12038e67c5c1"] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/key "answer"] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/type :answer-field.type/radio] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/choices "03d5b975-d657-53f4-8d36-078f875960bb"] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/choices "d08db519-79ee-52a5-bffc-d68c86a11848"] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/choices "4f1fbc1f-a7b4-5aa0-aab7-92081dbdffa5"] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/choices "fe6e30ab-f88f-59d9-bc5e-71c102d0efd6"] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/choices "6d7bdd9f-7915-5cbd-b87c-3174d06d5ecf"] [:db/add "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/correct "4f1fbc1f-a7b4-5aa0-aab7-92081dbdffa5"] [:db/ensure "9a365cf9-122e-523d-aa85-12038e67c5c1" :answer-field/validate] [:db/add "ae0341c2-7c53-5699-a7a5-3b8f281ae54b" :question/id #uuid "ae0341c2-7c53-5699-a7a5-3b8f281ae54b"] [:db/add "ae0341c2-7c53-5699-a7a5-3b8f281ae54b" :question/problem "Use the substitution $u=3 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\frac{1}{3}} \\frac{2}{9 x^{2} + 1}\\,\\mathrm{d}x\n$$"] [:db/add "ae0341c2-7c53-5699-a7a5-3b8f281ae54b" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{3}=\\frac{2}{3}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{3}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} \\frac{2}{9 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{2}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "ae0341c2-7c53-5699-a7a5-3b8f281ae54b" :question/difficulty :question.difficulty/easy] [:db/add "ae0341c2-7c53-5699-a7a5-3b8f281ae54b" :question/answer-fields "9a365cf9-122e-523d-aa85-12038e67c5c1"] [:db/ensure "ae0341c2-7c53-5699-a7a5-3b8f281ae54b" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "ae0341c2-7c53-5699-a7a5-3b8f281ae54b"] [:db/add "377d4f69-27e2-54f3-a7e1-e385bb72ca97" :answer/id #uuid "377d4f69-27e2-54f3-a7e1-e385bb72ca97"] [:db/add "377d4f69-27e2-54f3-a7e1-e385bb72ca97" :answer/type :answer.type/math] [:db/add "377d4f69-27e2-54f3-a7e1-e385bb72ca97" :answer/value "\\frac{1}{2}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "377d4f69-27e2-54f3-a7e1-e385bb72ca97" :answer/validate] [:db/add "5de935b1-d3a2-5a43-a05c-9e9fbcd319db" :answer/id #uuid "5de935b1-d3a2-5a43-a05c-9e9fbcd319db"] [:db/add "5de935b1-d3a2-5a43-a05c-9e9fbcd319db" :answer/type :answer.type/math] [:db/add "5de935b1-d3a2-5a43-a05c-9e9fbcd319db" :answer/value "2\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "5de935b1-d3a2-5a43-a05c-9e9fbcd319db" :answer/validate] [:db/add "9340851e-1c58-561c-9176-5e23ee1c80dd" :answer/id #uuid "9340851e-1c58-561c-9176-5e23ee1c80dd"] [:db/add "9340851e-1c58-561c-9176-5e23ee1c80dd" :answer/type :answer.type/math] [:db/add "9340