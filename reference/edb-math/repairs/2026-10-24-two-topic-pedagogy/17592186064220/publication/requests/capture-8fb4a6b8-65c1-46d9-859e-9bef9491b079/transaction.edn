ed}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{5}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{5}} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"] [:db/add "c4504cb1-e783-5667-8405-915d01ad07f7" :question/difficulty :question.difficulty/easy] [:db/add "c4504cb1-e783-5667-8405-915d01ad07f7" :question/answer-fields "01f6e205-54d3-50aa-9865-a5450b0e94bf"] [:db/ensure "c4504cb1-e783-5667-8405-915d01ad07f7" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "c4504cb1-e783-5667-8405-915d01ad07f7"] [:db/add "821019bb-4994-56a5-8447-9fcd89362852" :answer/id #uuid "821019bb-4994-56a5-8447-9fcd89362852"] [:db/add "821019bb-4994-56a5-8447-9fcd89362852" :answer/type :answer.type/math] [:db/add "821019bb-4994-56a5-8447-9fcd89362852" :answer/value "2\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "821019bb-4994-56a5-8447-9fcd89362852" :answer/validate] [:db/add "6ec72688-32e4-5656-8061-411a0927fe7e" :answer/id #uuid "6ec72688-32e4-5656-8061-411a0927fe7e"] [:db/add "6ec72688-32e4-5656-8061-411a0927fe7e" :answer/type :answer.type/math] [:db/add "6ec72688-32e4-5656-8061-411a0927fe7e" :answer/value "\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u"] [:db/ensure "6ec72688-32e4-5656-8061-411a0927fe7e" :answer/validate] [:db/add "ab6b489b-2030-5270-bbbd-cd07e0af5b09" :answer/id #uuid "ab6b489b-2030-5270-bbbd-cd07e0af5b09"] [:db/add "ab6b489b-2030-5270-bbbd-cd07e0af5b09" :answer/type :answer.type/math] [:db/add "ab6b489b-2030-5270-bbbd-cd07e0af5b09" :answer/value "-1\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)"] [:db/ensure "ab6b489b-2030-5270-bbbd-cd07e0af5b09" :answer/vali