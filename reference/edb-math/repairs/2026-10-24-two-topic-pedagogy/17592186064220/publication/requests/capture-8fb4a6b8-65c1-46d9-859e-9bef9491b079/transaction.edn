2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{3}.\n$$"] [:db/add "f3812e4c-4072-5cbb-aae5-d8098598e7d2" :question/difficulty :question.difficulty/moderate] [:db/add "f3812e4c-4072-5cbb-aae5-d8098598e7d2" :question/answer-fields "fc25e429-ec91-5412-b340-a316818fb8a9"] [:db/ensure "f3812e4c-4072-5cbb-aae5-d8098598e7d2" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "f3812e4c-4072-5cbb-aae5-d8098598e7d2"] [:db/add "a0fc0013-4555-5cdc-9e01-c62bff3e2ff2" :answer/id #uuid "a0fc0013-4555-5cdc-9e01-c62bff3e2ff2"] [:db/add "a0fc0013-4555-5cdc-9e01-c62bff3e2ff2" :answer/type :answer.type/math] [:db/add "a0fc0013-4555-5cdc-9e01-c62bff3e2ff2" :answer/value "\\frac{\\pi}{3}"] [:db/ensure "a0fc0013-4555-5cdc-9e01-c62bff3e2ff2" :answer/validate] [:db/add "bdbaa2de-b165-5834-a0ac-d39437261aa1" :answer-field/id #uuid "bdbaa2de-b165-5834-a0ac-d39437261aa1"] [:db/add "bdbaa2de-b165-5834-a0ac-d39437261aa1" :answer-field/key "answer"] [:db/add "bdbaa2de-b165-5834-a0ac-d39437261aa1" :answer-field/type :answer-field.type/blank] [:db/add "bdbaa2de-b165-5834-a0ac-d39437261aa1" :answer-field/choices "a0fc0013-4555-5cdc-9e01-c62bff3e2ff2"] [:db/add "bdbaa2de-b165-5834-a0ac-d39437261aa1" :answer-field/correct "a0fc0013-4555-5cdc-9e01-c62bff3e2ff2"] [:db/ensure "bdbaa2de-b165-5834-a0ac-d39437261aa1" :answer-field/validate] [:db/add "aca9c0da-bf9d-5af9-86af-aa07acdced2e" :question/id #uuid "aca9c0da-bf9d-5af9-86af-aa07acdced2e"] [:db/add "aca9c0da-bf9d-5af9-86af-aa07acdced2e" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{3} \\frac{4}{x^{2} + 9}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\n{{answer}}"] [:db/add "aca9c0da-bf9d-5af9-86af-aa07acdced2e" :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 9=9\\left(1+(\\frac{x}{3})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{9}\\cdot 3=\\frac{4}{3}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=3&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{3} \\frac{4}{x^{2} + 9}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{4}{3}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{4}{3}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{3}.\n$$"] [:db/add "aca9c0da-bf9d-5af9-86af-aa07acdced2e" :question/difficulty :question.difficulty/moderate] [:db/add "aca9c0da-bf9d-5af9-86af-aa07acdced2e" :question/answer-fields "bdbaa2de-b165-5834-a0ac-d39437261aa1"] [:db/ensure "aca9c0da-bf9d-5af9-86af-aa07acdced2e" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "aca9c0da-bf9d-5af9-86af-aa07acdced2e"] [:db/add "19912f7a-c635-5395-99a4-013d98b0d958" :answer/id #uuid "19912f7a-c635-5395-99a4-013d98b0d958"] [:db/add "19912f7a-c635-5395-99a4-013d98b0d958" :answer/type :answer.type/math] [:db/add "19912f7a-c635-5395-99a4-013d98b0d958" :answer/value "\\frac{2 \\pi}{3}"] [:db/ensure "19912f7a-c635-5395-99a4-013d98b0d958" :answer/validate] [:db/add "be16bb1a-f6f4-5233-8a1c-d8524f048c88" :answer-field/id #uuid "be16bb1a-f6f4-5233-8a1c-d8524f048c88"] [:db/add "be16bb1a-f6f4-5233-8a1c-d8524f048c88" :answer-field/key "answer"] [:db/add "be16bb1a-f6f4-5233-8a1c-d8524f048c88" :answer-field/type :answer-field.type/blank] [:db/add "be16bb1a-f6f4-5233-8a1c-d8524f048c88" :answer-field/choices "19912f7a-c635-5395-99a4-013d98b0d958"] [:db/add "be16bb1a-f6f4-5233-8a1c-d8524f048c88" :answer-field/correct "19912f7a-c635-5395-99a4-013d98b0d958"] [:db/ensure "be16bb1a-f6f4-5233-8a1c-d8524f048c88" :answer-field/validate] [:db/add "3de4a265-dec4-55ca-a9f1-ffb48c66ba45" :question/id #uuid "3de4a265-dec4-55ca-a9f1-ffb48c66ba45"] [:db/add "3de4a265-dec4-55ca-a9f1-ffb48c66ba45" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-2}^{2} \\frac{2}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arcsin{\\left(- \\frac{1}{2} \\right)}=- \\frac{\\pi}{6},\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\n{{answer}}"] [:db/add "3de4a265-dec4-55ca-a9f1-ffb48c66ba45" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{16 - x^{2}}=4\\sqrt{1-(\\frac{x}{4})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{2}\\cdot 4=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-2&\\Longrightarrow u=- \\frac{1}{2}\\\\x=2&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-2}^{2} \\frac{2}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{1}{2}}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2 \\pi}{3}.\n$$"] [:db/add "3de4a265-dec4-55ca-a9f1-ffb48c66ba45" :question/difficulty :question.difficulty/hard] [:db/add "3de4a265-dec4-55ca-a9f1-ffb48c66ba45" :question/answer-fields "be16bb1a-f6f4-5233-8a1c-d8524f048c88"] [:db/ensure "3de4a265-dec4-55ca-a9f1-ffb48c66ba45" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "3de4a265-dec4-55ca-a9f1-ffb48c66ba45"] [:db/add "f87ba698-cc89-57d9-ac59-41c1cbb4d0ef" :answer/id #uuid "f87ba698-cc89-57d9-ac59-41c1cbb4d0ef"] [:db/add "f87ba698-cc89-57d9-ac59-41c1cbb4d0ef" :answer/type :answer.type/math] [:db/add "f87ba698-cc89-57d9-ac59-41c1cbb4d0ef" :answer/value "\\frac{\\pi}{8}"] [:db/ensure "f87ba698-cc89-57d9-ac59-41c1cbb4d0ef" :answer/validate] [:db/add "745a772a-8ffa-5ea4-98a4-1515869b1c21" :answer-field/id #uuid "745a772a-8ffa-5ea4-98a4-1515869b1c21"] [:db/add "745a772a-8ffa-5ea4-98a4-1515869b1c21" :answer-field/key "answer"] [:db/add "745a772a-8ffa-5ea4-98a4-1515869b1c21" :answer-field/type :answer-field.type/blank] [:db/add "745a772a-8ffa-5ea4-98a4-1515869b1c21" :answer-field/choices "f87ba698-cc89-57d9-ac59-41c1cbb4d0ef"] [:db/add "745a772a-8ffa-5ea4-98a4-1515869b1c21" :answer-field/correct "f87ba698-cc89-57d9-ac59-41c1cbb4d0ef"] [:db/ensure "745a772a-8ffa-5ea4-98a4-1515869b1c21" :answer-field/validate] [:db/add "efb73b4b-4caf-595e-afdb-63f4941357cf" :question/id #uuid "efb73b4b-4caf-595e-afdb-63f4941357cf"] [:db/add "efb73b4b-4caf-595e-afdb-63f4941357cf" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-4}^{4} \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\n{{answer}}"] [:db/add "efb73b4b-4caf-595e-afdb-63f4941357cf" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{16}\\cdot 4=\\frac{1}{4}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-4&\\Longrightarrow u=-1\\\\x=4&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-4}^{4} \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int_{-1}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{1}{4}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{1}\\right)=\\frac{1}{4}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{8}.\n$$"] [:db/add "efb73b4b-4caf-595e-afdb-63f4941357cf" :question/difficulty :question.difficulty/hard] [:db/add "efb73b4b-4caf-595e-afdb-63f4941357cf" :question/answer-fields "745a772a-8ffa-5ea4-98a4-1515869b1c21"] [:db/ensure "efb73b4b-4caf-595e-afdb-63f4941357cf" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "efb73b4b-4caf-595e-afdb-63f4941357cf"] [:db/add "cd50c84e-e76e-5b86-9c45-33afb043d39f" :answer/id #uuid "cd50c84e-e76e-5b86-9c45-33afb043d39f"] [:db/add "cd50c84e-e76e-5b86-9c45-33afb043d39f" :answer/type :answer.type/math] [:db/add "cd50c84e-e76e-5b86-9c45-33afb043d39f" :answer/value "\\frac{4 \\pi}{3}"] [:db/ensure "cd50c84e-e76e-5b86-9c45-33afb043d39f" :answer/validate] [:db/add "4d7e8cf9-9c61-5b9f-a08a-ea419798d119" :answer-field/id #uuid "4d7e8cf9-9c61-5b9f-a08a-ea419798d119"] [:db/add "4d7e8cf9-9c61-5b9f-a08a-ea419798d119" :answer-field/key "answer"] [:db/add "4d7e8cf9-9c61-5b9f-a08a-ea419798d119" :answer-field/type :answer-field.type/blank] [:db/add "4d7e8cf9-9c61-5b9f-a08a-ea419798d119" :answer-field/choices "cd50c84e-e76e-5b86-9c45-33afb043d39f"] [:db/add "4d7e8cf9-9c61-5b9f-a08a-ea419798d119" :answer-field/correct "cd50c84e-e76e-5b86-9c45-33afb043d39f"] [:db/ensure "4d7e8cf9-9c61-5b9f-a08a-ea419798d119" :answer-field/validate] [:db/add "6dc4c518-ea77-5d68-9ae9-a019b2654d65" :question/id #uuid "6dc4c518-ea77-5d68-9ae9-a019b2654d65"] [:db/add "6dc4c518-ea77-5d68-9ae9-a019b2654d65" :question/problem "Evaluate exactly.\n\n$$\n\\int_{- \\frac{3}{2}}^{\\frac{3}{2}} \\frac{4}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arcsin{\\left(- \\frac{1}{2} \\right)}=- \\frac{\\pi}{6},\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\n{{answer}}"] [:db/add "6dc4c518-ea77-5d68-9ae9-a019b2654d65" :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=3\\sqrt{1-(\\frac{x}{3})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{3}\\cdot 3=4$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=- \\frac{3}{2}&\\Longrightarrow u=- \\frac{1}{2}\\\\x=\\frac{3}{2}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{- \\frac{3}{2}}^{\\frac{3}{2}} \\frac{4}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\\\\&=4\\left(\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n4\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{1}{2}}^{\\frac{1}{2}}\\right)=4\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{4 \\pi}{3}.\n$$"] [:db/add "6dc4c518-ea77-5d68-9ae9-a019b2654d65" :question/difficulty :question.difficulty/hard] [:db/add "6dc4c518-ea77-5d68-9ae9-a019b2654d65" :question/answer-fields "4d7e8cf9-9c61-5b9f-a08a-ea419798d119"] [:db/ensure "6dc4c518-ea77-5d68-9ae9-a019b2654d65" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "6dc4c518-ea77-5d68-9ae9-a019b2654d65"] [:db/add "47cd604e-5003-5beb-a4a5-d9d85cb9390f" :answer/id #uuid "47cd604e-5003-5beb-a4a5-d9d85cb9390f"] [:db/add "47cd604e-5003-5beb-a4a5-d9d85cb9390f" :answer/type :answer.type/math] [:db/add "47cd604e-5003-5beb-a4a5-d9d85cb9390f" :answer/value "\\frac{\\pi}{2}"] [:db/ensure "47cd604e-5003-5beb-a4a5-d9d85cb9390f" :answer/validate] [:db/add "e94e8786-71eb-5b21-8a20-50168f744c66" :answer-field/id #uuid "e94e8786-71eb-5b21-8a20-50168f744c66"] [:db/add "e94e8786-71eb-5b21-8a20-50168f744c66" :answer-field/key "answer"] [:db/add "e94e8786-71eb-5b21-8a20-50168f744c66" :answer-field/type :answer-field.type/blank] [:db/add "e94e8786-71eb-5b21-8a20-50168f744c66" :answer-field/choices "47cd604e-5003-5beb-a4a5-d9d85cb9390f"] [:db/add "e94e8786-71eb-5b21-8a20-50168f744c66" :answer-field/correct "47cd604e-5003-5beb-a4a5-d9d85cb9390f"] [:db/ensure "e94e8786-71eb-5b21-8a20-50168f744c66" :answer-field/validate] [:db/add "45114a62-33d3-51ec-a7c8-28ce8b3500fa" :question/id #uuid "45114a62-33d3-51ec-a7c8-28ce8b3500fa"] [:db/add "45114a62-33d3-51ec-a7c8-28ce8b3500fa" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-3}^{3} \\frac{3}{x^{2} + 9}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\n{{answer}}"] [:db/add "45114a62-33d3-51ec-a7c8-28ce8b3500fa" :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 9=9\\left(1+(\\frac{x}{3})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{3}\\cdot 3=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-3&\\Longrightarrow u=-1\\\\x=3&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-3}^{3} \\frac{3}{x^{2} + 9}\\,\\mathrm{d}x\\\\&=\\int_{-1}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{1}=\\left(\\frac{\\pi}{4}\\right)-\\left(- \\frac{\\pi}{4}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{2}.\n$$"] [:db/add "45114a62-33d3-51ec-a7c8-28ce8b3500fa" :question/difficulty :question.difficulty/hard] [:db/add "45114a62-33d3-51ec-a7c8-28ce8b3500fa" :question/answer-fields "e94e8786-71eb-5b21-8a20-50168f744c66"] [:db/ensure "45114a62-33d3-51ec-a7c8-28ce8b3500fa" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "45114a62-33d3-51ec-a7c8-28ce8b3500fa"] [:db/add "9c9d69e0-30da-568c-aeb8-31c4ee2927ff" :answer/id #uuid "9c9d69e0-30da-568c-aeb8-31c4ee2927ff"] [:db/add "9c9d69e0-30da-568c-aeb8-31c4ee2927ff" :answer/type :answer.type/math] [:db/add "9c9d69e0-30da-568c-aeb8-31c4ee2927ff" :answer/value "\\pi"] [:db/ensure "9c9d69e0-30da-568c-aeb8-31c4ee2927ff" :answer/validate] [:db/add "c044c5e2-276b-5b67-8928-84c4a5cfbe6f" :answer-field/id #uuid "c044c5e2-276b-5b67-8928-84c4a5cfbe6f"] [:db/add "c044c5e2-276b-5b67-8928-84c4a5cfbe6f" :answer-field/key "answer"] [:db/add "c044c5e2-276b-5b67-8928-84c4a5cfbe6f" :answer-field/type :answer-field.type/blank] [:db/add "c044c5e2-276b-5b67-8928-84c4a5cfbe6f" :answer-field/choices "9c9d69e0-30da-568c-aeb8-31c4ee2927ff"] [:db/add "c044c5e2-276b-5b67-8928-84c4a5cfbe6f" :answer-field/correct "9c9d69e0-30da-568c-aeb8-31c4ee2927ff"] [:db/ensure "c044c5e2-276b-5b67-8928-84c4a5cfbe6f" :answer-field/validate] [:db/add "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8" :question/id #uuid "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8"] [:db/add "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-1}^{1} \\frac{3}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arcsin{\\left(- \\frac{1}{2} \\right)}=- \\frac{\\pi}{6},\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\n{{answer}}"] [:db/add "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8" :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{4 - x^{2}}=2\\sqrt{1-(\\frac{x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{2}\\cdot 2=3$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-1&\\Longrightarrow u=- \\frac{1}{2}\\\\x=1&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-1}^{1} \\frac{3}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{1}{2}}^{\\frac{1}{2}}\\right)=3\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\pi.\n$$"] [:db/add "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8" :question/difficulty :question.difficulty/hard] [:db/add "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8" :question/answer-fields "c044c5e2-276b-5b67-8928-84c4a5cfbe6f"] [:db/ensure "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "c4726a49-36ea-5eb2-a7dd-f6af9ac558b8"] [:db/add "c91e4652-47f8-5671-81db-f5c918eefb4a" :answer/id #uuid "c91e4652-47f8-5671-81db-f5c918eefb4a"] [:db/add "c91e4652-47f8-5671-81db-f5c918eefb4a" :answer/type :answer.type/math] [:db/add "c91e4652-47f8-5671-81db-f5c918eefb4a" :answer/value "\\frac{3 \\pi}{8}"] [:db/ensure "c91e4652-47f8-5671-81db-f5c918eefb4a" :answer/validate] [:db/add "0b7619d5-798e-51ec-a379-94d0401eb97d" :answer-field/id #uuid "0b7619d5-798e-51ec-a379-94d0401eb97d"] [:db/add "0b7619d5-798e-51ec-a379-94d0401eb97d" :answer-field/key "answer"] [:db/add "0b7619d5-798e-51ec-a379-94d0401eb97d" :answer-field/type :answer-field.type/blank] [:db/add "0b7619d5-798e-51ec-a379-94d0401eb97d" :answer-field/choices "c91e4652-47f8-5671-81db-f5c918eefb4a"] [:db/add "0b7619d5-798e-51ec-a379-94d0401eb97d" :answer-field/correct "c91e4652-47f8-5671-81db-f5c918eefb4a"] [:db/ensure "0b7619d5-798e-51ec-a379-94d0401eb97d" :answer-field/validate] [:db/add "bc78c8a6-488e-51bf-ac0e-c24a6281e74a" :question/id #uuid "bc78c8a6-488e-51bf-ac0e-c24a6281e74a"] [:db/add "bc78c8a6-488e-51bf-ac0e-c24a6281e74a" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-4}^{4} \\frac{3}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\n{{answer}}"] [:db/add "bc78c8a6-488e-51bf-ac0e-c24a6281e74a" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{16}\\cdot 4=\\frac{3}{4}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-4&\\Longrightarrow u=-1\\\\x=4&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-4}^{4} \\frac{3}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int_{-1}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{3}{4}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{1}\\right)=\\frac{3}{4}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3 \\pi}{8}.\n$$"] [:db/add "bc78c8a6-488e-51bf-ac0e-c24a6281e74a" :question/difficulty :question.difficulty/hard] [:db/add "bc78c8a6-488e-51bf-ac0e-c24a6281e74a" :question/answer-fields "0b7619d5-798e-51ec-a379-94d0401eb97d"] [:db/ensure "bc78c8a6-488e-51bf-ac0e-c24a6281e74a" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "bc78c8a6-488e-51bf-ac0e-c24a6281e74a"] [:db/add "bbc4eb12-c082-533c-91e3-42088827c6c9" :answer/id #uuid "bbc4eb12-c082-533c-91e3-42088827c6c9"] [:db/add "bbc4eb12-c082-533c-91e3-42088827c6c9" :answer/type :answer.type/math] [:db/add "bbc4eb12-c082-533c-91e3-42088827c6c9" :answer/value "\\frac{2 \\pi}{3}"] [:db/ensure "bbc4eb12-c082-533c-91e3-42088827c6c9" :answer/validate] [:db/add "f8ba04b5-b93a-5fbf-9837-f370a0a1420d" :answer-field/id #uuid "f8ba04b5-b93a-5fbf-9837-f370a0a1420d"] [:db/add "f8ba04b5-b93a-5fbf-9837-f370a0a1420d" :answer-field/key "answer"] [:db/add "f8ba04b5-b93a-5fbf-9837-f370a0a1420d" :answer-field/type :answer-field.type/blank] [:db/add "f8ba04b5-b93a-5fbf-9837-f370a0a1420d" :answer-field/choices "bbc4eb12-c082-533c-91e3-42088827c6c9"] [:db/add "f8ba04b5-b93a-5fbf-9837-f370a0a1420d" :answer-field/correct "bbc4eb12-c082-533c-91e3-42088827c6c9"] [:db/ensure "f8ba04b5-b93a-5fbf-9837-f370a0a1420d" :answer-field/validate] [:db/add "98784736-c266-5208-a6fc-c447c86d139a" :question/id #uuid "98784736-c266-5208-a6fc-c447c86d139a"] [:db/add "98784736-c266-5208-a6fc-c447c86d139a" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-1}^{1} \\frac{2}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\arcsin{\\left(- \\frac{1}{2} \\right)}=- \\frac{\\pi}{6},\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\n{{answer}}"] [:db/add "98784736-c266-5208-a6fc-c447c86d139a" :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{4 - x^{2}}=2\\sqrt{1-(\\frac{x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $1\\cdot 2=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-1&\\Longrightarrow u=- \\frac{1}{2}\\\\x=1&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-1}^{1} \\frac{2}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{1}{2}}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2 \\pi}{3}.\n$$"] [:db/add "98784736-c266-5208-a6fc-c447c86d139a" :question/difficulty :question.difficulty/hard] [:db/add "98784736-c266-5208-a6fc-c447c86d139a" :question/answer-fields "f8ba04b5-b93a-5fbf-9837-f370a0a1420d"] [:db/ensure "98784736-c266-5208-a6fc-c447c86d139a" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "98784736-c266-5208-a6fc-c447c86d139a"] [:db/add "974f4491-1b3e-5162-8762-b997c2ce7d0a" :answer/id #uuid "974f4491-1b3e-5162-8762-b997c2ce7d0a"] [:db/add "974f4491-1b3e-5162-8762-b997c2ce7d0a" :answer/type :answer.type/math] [:db/add "974f4491-1b3e-5162-8762-b997c2ce7d0a" :answer/value "\\frac{3 \\pi}{4}"] [:db/ensure "974f4491-1b3e-5162-8762-b997c2ce7d0a" :answer/validate] [:db/add "7b20481d-efa0-5d19-bace-b463c668fb4a" :answer-field/id #uuid "7b20481d-efa0-5d19-bace-b463c668fb4a"] [:db/add "7b20481d-efa0-5d19-bace-b463c668fb4a" :answer-field/key "answer"] [:db/add "7b20481d-efa0-5d19-bace-b463c668fb4a" :answer-field/type :answer-field.type/blank] [:db/add "7b20481d-efa0-5d19-bace-b463c668fb4a" :answer-field/choices "974f4491-1b3e-5162-8762-b997c2ce7d0a"] [:db/add "7b20481d-efa0-5d19-bace-b463c668fb4a" :answer-field/correct "974f4491-1b3e-5162-8762-b997c2ce7d0a"] [:db/ensure "7b20481d-efa0-5d19-bace-b463c668fb4a" :answer-field/valid