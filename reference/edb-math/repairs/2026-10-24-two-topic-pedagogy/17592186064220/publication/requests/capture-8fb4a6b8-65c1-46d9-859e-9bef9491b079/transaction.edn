hrm{d}u\\right).\n$$"] [:db/add "dcde486a-1e39-59b6-860e-7f24175326c3" :question/difficulty :question.difficulty/easy] [:db/add "dcde486a-1e39-59b6-860e-7f24175326c3" :question/answer-fields "417f0d82-5629-5869-bb12-64ec6d069d15"] [:db/ensure "dcde486a-1e39-59b6-860e-7f24175326c3" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "dcde486a-1e39-59b6-860e-7f24175326c3"] [:db/add "3e842c11-c7f3-564f-a933-92803d029ea8" :answer/id #uuid "3e842c11-c7f3-564f-a933-92803d029ea8"] [:db/add "3e842c11-c7f3-564f-a933-92803d029ea8" :answer/type :answer.type/math] [:db/add "3e842c11-c7f3-564f-a933-92803d029ea8" :answer/value "\\frac{9}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "3e842c11-c7f3-564f-a933-92803d029ea8" :answer/validate] [:db/add "47a44f18-f0ce-55ca-b079-1064dd752f1c" :answer/id #uuid "47a44f18-f0ce-55ca-b079-1064dd752f1c"] [:db/add "47a44f18-f0ce-55ca-b079-1064dd752f1c" :answer/type :answer.type/math] [:db/add "47a44f18-f0ce-55ca-b079-1064dd752f1c" :answer/value "\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "47a44f18-f0ce-55ca-b079-1064dd752f1c" :answer/validate] [:db/add "e7ca9f8b-2271-5493-9c33-abecf2b359aa" :answer/id #uuid "e7ca9f8b-2271-5493-9c33-abecf2b359aa"] [:db/add "e7ca9f8b-2271-5493-9c33-abecf2b359aa" :answer/type :answer.type/math] [:db/add "e7ca9f8b-2271-5493-9c33-abecf2b359aa" :answer/value "\\frac{6}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "e7ca9f8b-2271-5493-9c33-abecf2b359aa" :answer/validate] [:db/add "dafbb5d3-917d-5770-b4cd-9a5425b2287f" :answer/id #uuid "dafbb5d3-917d-5770-b4cd-9a5425b2287f"] [:db/add "dafbb5d3-917d-5770-b4cd-9a5425b2287f" :answer/type :answer.type/math] [:db/add "dafbb5d3-917d-5770-b4cd-9a5425b2287f" :answer/value "- \\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)"] [:db/ensure "dafbb5d3-917d-5770-b4cd-9a5425b2287f" :answer/validate] [:db/add "8f8d094b-7b