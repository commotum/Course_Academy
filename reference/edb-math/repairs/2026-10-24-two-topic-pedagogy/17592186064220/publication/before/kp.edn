csin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= \\frac{2}{5}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{15}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de17d22-ce4a-560a-97da-52aa819f6d27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{8}" :db/id #edb/ref 17592186677058}] :answer-field/correct {:answer/id #uuid "1de17d22-ce4a-560a-97da-52aa819f6d27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{8}" :db/id #edb/ref 17592186677058} :answer-field/id #uuid "8b06cdcb-17e2-5614-8223-3a8a95be3cd8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677113}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b8ad7c5d-7e92-54a2-a9ba-2d3f25475100" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{8 \\sqrt{3}}{3}} \\frac{6}{x^{2} + 64}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 64=64(1+(\\frac{1}{64})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{8}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{8},\\qquad \\mathrm{d}x=(8)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{8})(0)=0 \\\\ x=\\frac{8 \\sqrt{3}}{3}&\\Longrightarrow u=(\\frac{1}{8})(\\frac{8 \\sqrt{3}}{3})=\\frac{\\sqrt{3}}{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{8 \\sqrt{3}}{3}} \\frac{6}{x^{2} + 64}\\,\\mathrm{d}x \\\\  &= \\frac{3}{32}\\int_{0}^{\\frac{8 \\sqrt{3}}{3}} \\frac{1}{1+(\\frac{x}{8})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{32}(8)\\int_{0}^{\\frac{\\sqrt{3}}{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{4}\\int_{0}^{\\frac{\\sqrt{3}}{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{4}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{3}}{3}} \\\\  &= \\frac{3}{4}(\\operatorname{arctan}(\\frac{\\sqrt{3}}{3})-\\operatorname{arctan}(0)) \\\\  &= \\frac{3}{4}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2759c9ed-11ea-57ee-a0bd-9ad257122f12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186677065}] :answer-field/correct {:answer/id #uuid "2759c9ed-11ea-57ee-a0bd-9ad257122f12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186677065} :answer-field/id #uuid "8fcc298a-078c-5c60-b6a2-c6d4172da034" :answer-field/key "coefficient" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677120} {:answer-field/choices [{:answer/id #uuid "ccc64ea2-8f5a-54f2-9e68-90e50c57bc59" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186677163}] :answer-field/correct {:answer/id #uuid "ccc64ea2-8f5a-54f2-9e68-90e50c57bc59" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186677163} :answer-field/id #uuid "e5f1fd37-720c-5104-aaf1-071e70b68d8c" :answer-field/key "argument" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677188}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d5ffb59e-2be0-5b32-8138-13035a607668" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{2}{9}} \\frac{5}{81 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\n{{coefficient}} $\\operatorname{arctan}($ {{argument}} $)$" :question/worked-solution "Use the linear substitution $u=9 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9,\\qquad \\mathrm{d}x=(\\frac{1}{9})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(9)(0)=0 \\\\ x=\\frac{2}{9}&\\Longrightarrow u=(9)(\\frac{2}{9})=2\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{2}{9}} \\frac{5}{81 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 5\\int_{0}^{\\frac{2}{9}} \\frac{1}{1+(9 x)^{2}}\\,\\mathrm{d}x \\\\  &= 5(\\frac{1}{9})\\int_{0}^{2} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{5}{9}\\int_{0}^{2} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{5}{9}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{2} \\\\  &= \\frac{5}{9}(\\operatorname{arctan}(2)-\\operatorname{arctan}(0)) \\\\  &= \\frac{5}{9}((\\operatorname{arctan}{\\left(2 \\right)})-(0)) \\\\  &= \\frac{5 \\operatorname{arctan}{\\left(2 \\right)}}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "094fa516-728f-5be6-a4fe-f67ece9b8145" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{6} \\pi}{4}" :db/id #edb/ref 17592186677047}] :answer-field/correct {:answer/id #uuid "094fa516-728f-5be6-a4fe-f67ece9b8145" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{6} \\pi}{4}" :db/id #edb/ref 17592186677047} :answer-field/id #uuid "ee3d0bc0-f989-584a-ae0f-e17e36f20d73" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677190}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d97ef683-6715-5e81-a7d1-14b2ffc5e533" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\sqrt{6}}{4}}^{\\frac{3 \\sqrt{2}}{4}} \\frac{9}{\\sqrt{9 - 6 x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{9 - 6 x^{2}}=\\sqrt{9(1-(\\frac{2}{3})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{3},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{6}}{2})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\sqrt{6}}{4}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{3})(- \\frac{\\sqrt{6}}{4})=- \\frac{1}{2} \\\\ x=\\frac{3 \\sqrt{2}}{4}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{3})(\\frac{3 \\sqrt{2}}{4})=\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{\\sqrt{6}}{4}}^{\\frac{3 \\sqrt{2}}{4}} \\frac{9}{\\sqrt{9 - 6 x^{2}}}\\,\\mathrm{d}x \\\\  &= 3\\int_{- \\frac{\\sqrt{6}}{4}}^{\\frac{3 \\sqrt{2}}{4}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{6} x}{3})^{2}}}\\,\\mathrm{d}x \\\\  &= 3(\\frac{\\sqrt{6}}{2})\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{6}}{2}\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{6}}{2}[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\\\  &= \\frac{3 \\sqrt{6}}{2}(\\operatorname{arcsin}(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= \\frac{3 \\sqrt{6}}{2}((\\frac{\\pi}{3})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{3 \\sqrt{6} \\pi}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3879e69e-611a-5e48-af0d-b81d5085eba7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{288}" :db/id #edb/ref 17592186677081} {:answer/id #uuid "3c73aab7-f56a-5357-b2cd-6c75dfe0e5f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{24}" :db/id #edb/ref 17592186677083} {:answer/id #uuid "40638152-c07a-5845-b659-ed194dc93945" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{8}" :db/id #edb/ref 17592186677086} {:answer/id #uuid "48f997ef-3952-5d82-987d-59ddad9a4ab0" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{8}" :db/id #edb/ref 17592186677088} {:answer/id #uuid "fb5a079d-39a5-5990-8353-75942f5fb50c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{4}" :db/id #edb/ref 17592186677195}] :answer-field/correct {:answer/id #uuid "40638152-c07a-5845-b659-ed194dc93945" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{8}" :db/id #edb/ref 17592186677086} :answer-field/id #uuid "f3205561-4844-5231-9a76-4b12f71b281e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677191}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e13e5fe8-8cb3-5e53-84d4-dc9d70dae4ca" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{6} \\frac{3}{x^{2} + 36}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 36=36(1+(\\frac{1}{36})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{6},\\qquad \\mathrm{d}x=(6)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{6})(0)=0 \\\\ x=6&\\Longrightarrow u=(\\frac{1}{6})(6)=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{6} \\frac{3}{x^{2} + 36}\\,\\mathrm{d}x \\\\  &= \\frac{1}{12}\\int_{0}^{6} \\frac{1}{1+(\\frac{x}{6})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{12}(6)\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{2}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{2}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{1}{2}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{1}{2}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\pi}{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "168d4392-e6c0-51c7-a965-acadc2514a1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{8}" :db/id #edb/ref 17592186677055} {:answer/id #uuid "5f917a32-7963-5d6f-afcc-c9a117beb131" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{16}" :db/id #edb/ref 17592186677099} {:answer/id #uuid "8b30ca6b-ec84-5558-804b-cffd2d66e216" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{16}" :db/id #edb/ref 17592186677114} {:answer/id #uuid "ced38559-d73a-5251-a64c-bdd66fd6d35a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186677166} {:answer/id #uuid "dbaa1cec-9fad-5c4c-9b41-008695f4e480" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{128}" :db/id #edb/ref 17592186677174}] :answer-field/correct {:answer/id #uuid "8b30ca6b-ec84-5558-804b-cffd2d66e216" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{16}" :db/id #edb/ref 17592186677114} :answer-field/id #uuid "7f5c43e5-3673-5b00-8930-97762031a8dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677109}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e1c5c6fb-e670-586e-8a39-d5d94b3f065f" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{16}} \\frac{3}{\\sqrt{1 - 64 x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(8)(0)=0 \\\\ x=\\frac{1}{16}&\\Longrightarrow u=(8)(\\frac{1}{16})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{16}} \\frac{3}{\\sqrt{1 - 64 x^{2}}}\\,\\mathrm{d}x \\\\  &= 3\\int_{0}^{\\frac{1}{16}} \\frac{1}{\\sqrt{1-(8 x)^{2}}}\\,\\mathrm{d}x \\\\  &= 3(\\frac{1}{8})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{8}\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{8}[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= \\frac{3}{8}(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= \\frac{3}{8}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{16}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2afd7b19-eca2-5ee6-b883-ba3c32d3c286" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{9}" :db/id #edb/ref 17592186677071} {:answer/id #uuid "33b3be47-676e-5ece-9ce1-37cd7674fbcd" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{6} \\pi}{9}" :db/id #edb/ref 17592186677074} {:answer/id #uuid "3684568f-217d-59ef-b6af-389c35869a89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} \\pi}{18}" :db/id #edb/ref 17592186677080} {:answer/id #uuid "759e5427-78c7-5cb9-aa97-0a52c8ecd3d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186677105} {:answer/id #uuid "77ebe17d-2513-5cde-ae28-8040113f8496" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} \\pi}{9}" :db/id #edb/ref 17592186677107}] :answer-field/correct {:answer/id #uuid "77ebe17d-2513-5cde-ae28-8040113f8496" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} \\pi}{9}" :db/id #edb/ref 17592186677107} :answer-field/id #uuid "0f025f07-d47b-5049-b3e3-da3e27c754f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677051}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e251937d-16b7-5326-a140-cdc3ea29c25f" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{3 \\sqrt{2}} \\frac{2}{x^{2} + 6}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 6=6(1+(\\frac{1}{6})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{6},\\qquad \\mathrm{d}x=(\\sqrt{6})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{6}}{6})(0)=0 \\\\ x=3 \\sqrt{2}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{6})(3 \\sqrt{2})=\\sqrt{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{3 \\sqrt{2}} \\frac{2}{x^{2} + 6}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}\\int_{0}^{3 \\sqrt{2}} \\frac{1}{1+(\\frac{\\sqrt{6} x}{6})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}(\\sqrt{6})\\int_{0}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}\\int_{0}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{3}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{\\sqrt{3}} \\\\  &= \\frac{\\sqrt{6}}{3}(\\operatorname{arctan}(\\sqrt{3})-\\operatorname{arctan}(0)) \\\\  &= \\frac{\\sqrt{6}}{3}((\\frac{\\pi}{3})-(0)) \\\\  &= \\frac{\\sqrt{6} \\pi}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "123e3224-f470-5a1e-9a86-1c2e4cc2a51e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\pi}{3}" :db/id #edb/ref 17592186677053} {:answer/id #uuid "2227dc7c-2cb7-5aee-aa2f-3b4d2b7a95d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{9}" :db/id #edb/ref 17592186677060} {:answer/id #uuid "8b7753d6-ba04-5328-ac31-33c61adfc066" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\pi" :db/id #edb/ref 17592186677115} {:answer/id #uuid "8d780d79-735a-5941-8c9f-4801469c84c9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 \\pi}{3}" :db/id #edb/ref 17592186677117} {:answer/id #uuid "ddae6bea-2729-582d-a153-7fc9cd6edc01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186677176}] :answer-field/correct {:answer/id #uuid "ddae6bea-2729-582d-a153-7fc9cd6edc01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186677176} :answer-field/id #uuid "90be1365-ed16-5813-b9ee-ed8cc6b8c2ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677122}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e4cdc649-5543-52c4-9e7e-a603083141ff" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{-3}^{3} \\frac{2}{\\sqrt{36 - x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{36 - x^{2}}=\\sqrt{36(1-(\\frac{1}{36})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{6},\\qquad \\mathrm{d}x=(6)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=-3&\\Longrightarrow u=(\\frac{1}{6})(-3)=- \\frac{1}{2} \\\\ x=3&\\Longrightarrow u=(\\frac{1}{6})(3)=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{-3}^{3} \\frac{2}{\\sqrt{36 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}\\int_{-3}^{3} \\frac{1}{\\sqrt{1-(\\frac{x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}(6)\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{1}{2}} \\\\  &= 2(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= 2((\\frac{\\pi}{6})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{2 \\pi}{3}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Definite Integrals Using Substitution with Inverse Trigonometric Functions"}]}
