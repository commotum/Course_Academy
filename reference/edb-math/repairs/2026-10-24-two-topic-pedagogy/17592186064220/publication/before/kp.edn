}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}[\\operatorname{arctan}{\\left(u \\right)}]_{- \\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{\\sqrt{6}}{6}(\\operatorname{arctan}(1)-\\operatorname{arctan}(- \\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{\\sqrt{6}}{6}((\\frac{\\pi}{4})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{5 \\sqrt{6} \\pi}{72}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66ab3c07-aed9-5048-be41-aa6b32baf7e9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{10} \\pi}{10}" :db/id #edb/ref 17592186677100} {:answer/id #uuid "b2fb651a-cb3e-5812-8920-65d6a708aba9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\sqrt{10} \\pi}{5}" :db/id #edb/ref 17592186677137} {:answer/id #uuid "e3d3fca2-2f4b-5bb9-9152-d118b4c0a190" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{8}" :db/id #edb/ref 17592186677184} {:answer/id #uuid "f6f4d4a4-75e2-54f0-a2b8-e12175ae170b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{10} \\pi}{10}" :db/id #edb/ref 17592186677194} {:answer/id #uuid "fd4d363a-e4b7-53bf-85fa-46bfd12b2ff3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12 \\pi}{5}" :db/id #edb/ref 17592186677198}] :answer-field/correct {:answer/id #uuid "f6f4d4a4-75e2-54f0-a2b8-e12175ae170b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{10} \\pi}{10}" :db/id #edb/ref 17592186677194} :answer-field/id #uuid "15535d36-569d-5a66-912f-4328e0b08515" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677054}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "31069773-e2d9-58b9-845a-c488f05a3fd1" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{2 \\sqrt{10}}{5}}^{\\frac{2 \\sqrt{30}}{5}} \\frac{6}{\\sqrt{64 - 10 x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{64 - 10 x^{2}}=\\sqrt{64(1-(\\frac{5}{32})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{8}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{8},\\qquad \\mathrm{d}x=(\\frac{4 \\sqrt{10}}{5})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{2 \\sqrt{10}}{5}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{8})(- \\frac{2 \\sqrt{10}}{5})=- \\frac{1}{2} \\\\ x=\\frac{2 \\sqrt{30}}{5}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{8})(\\frac{2 \\sqrt{30}}{5})=\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{2 \\sqrt{10}}{5}}^{\\frac{2 \\sqrt{30}}{5}} \\frac{6}{\\sqrt{64 - 10 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{4}\\int_{- \\frac{2 \\sqrt{10}}{5}}^{\\frac{2 \\sqrt{30}}{5}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{8})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{4}(\\frac{4 \\sqrt{10}}{5})\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{10}}{5}\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\sqrt{10}}{5}[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{\\sqrt{3}}{2}} \\\\  &= \\frac{3 \\sqrt{10}}{5}(\\operatorname{arcsin}(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= \\frac{3 \\sqrt{10}}{5}((\\frac{\\pi}{3})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{3 \\sqrt{10} \\pi}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00551039-d607-5600-acd4-4dc4aef60bd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\pi}{6}" :db/id #edb/ref 17592186677042} {:answer/id #uuid "b6d5e3ae-feb8-5269-8089-cd58f1844709" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\pi}{3}" :db/id #edb/ref 17592186677143} {:answer/id #uuid "cc4e4223-fd94-5f6b-a213-4216edf8b5c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186677162} {:answer/id #uuid "e2796685-73b6-5e94-ae79-b8111f678b61" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{3}" :db/id #edb/ref 17592186677182} {:answer/id #uuid "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186677183}] :answer-field/correct {:answer/id #uuid "e31ba5e2-04d8-54e5-a488-c8bdb83fb3ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186677183} :answer-field/id #uuid "fdb23a87-6b16-5bae-8d50-4399319e99f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677199}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3678de14-c7a3-5309-a87e-827f356a473e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{2 - x^{2}}=\\sqrt{2(1-(\\frac{1}{2})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{2} x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{2}}{2},\\qquad \\mathrm{d}x=(\\sqrt{2})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{2}}{2})(0)=0 \\\\ x=\\frac{\\sqrt{2}}{2}&\\Longrightarrow u=(\\frac{\\sqrt{2}}{2})(\\frac{\\sqrt{2}}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\sqrt{2}\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{2} x}{2})^{2}}}\\,\\mathrm{d}x \\\\  &= \\sqrt{2}(\\sqrt{2})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= 2(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= 2((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{\\pi}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b08bd5-31bc-5c5a-ad01-1f39fa210754" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{10} \\pi}{3}" :db/id #edb/ref 17592186677045} {:answer/id #uuid "27f548bb-c49c-5514-862f-6732a1a79088" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{10} \\left(\\operatorname{arctan}{\\left(\\frac{1}{2} \\right)} + \\operatorname{arctan}{\\left(\\frac{\\sqrt{2}}{2} \\right)}\\right)}{5}" :db/id #edb/ref 17592186677067} {:answer/id #uuid "35e36aac-75f3-5dc4-9fb4-3e6fa1d1db11" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\pi" :db/id #edb/ref 17592186677077} {:answer/id #uuid "cbf674a6-5283-5813-b916-60b747375328" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\pi}{3}" :db/id #edb/ref 17592186677161} {:answer/id #uuid "fd2d7aad-0c09-5ccd-bdf2-b741e87a396f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10 \\pi}{27}" :db/id #edb/ref 17592186677197}] :answer-field/correct {:answer/id #uuid "cbf674a6-5283-5813-b916-60b747375328" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\pi}{3}" :db/id #edb/ref 17592186677161} :answer-field/id #uuid "c2f4f8ce-ed94-551d-89d9-8b2e56b37b4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677152}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4a24f09e-263b-5efe-ac71-a976bc84e3aa" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{8}{\\sqrt{81 - 10 x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{81 - 10 x^{2}}=\\sqrt{81(1-(\\frac{10}{81})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{9},\\qquad \\mathrm{d}x=(\\frac{9 \\sqrt{10}}{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{9 \\sqrt{10}}{20}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{9})(- \\frac{9 \\sqrt{10}}{20})=- \\frac{1}{2} \\\\ x=\\frac{9 \\sqrt{5}}{10}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{9})(\\frac{9 \\sqrt{5}}{10})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{8}{\\sqrt{81 - 10 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{9}\\int_{- \\frac{9 \\sqrt{10}}{20}}^{\\frac{9 \\sqrt{5}}{10}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{9})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{9}(\\frac{9 \\sqrt{10}}{10})\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\\\  &= \\frac{4 \\sqrt{10}}{5}(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= \\frac{4 \\sqrt{10}}{5}((\\frac{\\pi}{4})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{\\sqrt{10} \\pi}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "420aac5e-015a-5dcf-96c2-aa80b9e6f176" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{7} \\pi}{140}" :db/id #edb/ref 17592186677087} {:answer/id #uuid "8e4169e3-9262-5493-b315-2902bc48450b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{7} \\pi}{500}" :db/id #edb/ref 17592186677118} {:answer/id #uuid "8f897da0-c7c7-5ad7-bec0-4f2425e87fbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{7} \\pi}{140}" :db/id #edb/ref 17592186677119} {:answer/id #uuid "c74a561c-863a-573f-9341-b53ede55d47d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\pi}{28}" :db/id #edb/ref 17592186677154} {:answer/id #uuid "f5aeea5c-ba27-5f18-85d7-6f9fc18ce357" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7} \\pi}{420}" :db/id #edb/ref 17592186677193}] :answer-field/correct {:answer/id #uuid "8f897da0-c7c7-5ad7-bec0-4f2425e87fbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{7} \\pi}{140}" :db/id #edb/ref 17592186677119} :answer-field/id #uuid "76e776ca-23c1-5993-b4b0-77109e7c5373" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677106}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4eddb1ed-78dc-5c0e-a58a-4f6c59d0a7cf" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{9}{7 x^{2} + 25}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n7 x^{2} + 25=25(1+(\\frac{7}{25})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{7} x}{5}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{7}}{5},\\qquad \\mathrm{d}x=(\\frac{5 \\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{5 \\sqrt{21}}{21}&\\Longrightarrow u=(\\frac{\\sqrt{7}}{5})(\\frac{5 \\sqrt{21}}{21})=\\frac{\\sqrt{3}}{3} \\\\ x=\\frac{5 \\sqrt{7}}{7}&\\Longrightarrow u=(\\frac{\\sqrt{7}}{5})(\\frac{5 \\sqrt{7}}{7})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{9}{7 x^{2} + 25}\\,\\mathrm{d}x \\\\  &= \\frac{9}{25}\\int_{\\frac{5 \\sqrt{21}}{21}}^{\\frac{5 \\sqrt{7}}{7}} \\frac{1}{1+(\\frac{\\sqrt{7} x}{5})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{9}{25}(\\frac{5 \\sqrt{7}}{7})\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}[\\operatorname{arctan}{\\left(u \\right)}]_{\\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{9 \\sqrt{7}}{35}(\\operatorname{arctan}(1)-\\operatorname{arctan}(\\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{9 \\sqrt{7}}{35}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{3 \\sqrt{7} \\pi}{140}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186677167}] :answer-field/correct {:answer/id #uuid "cf36209d-dd8d-57a1-a765-f750e1391b98" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186677167} :answer-field/id #uuid "b352b4d8-ef8e-542f-94af-6fac013fa473" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677138}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "561f8902-181d-50e5-8116-48d2cb1ddaae" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\sqrt{5}} \\frac{4}{\\sqrt{10 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{10 - x^{2}}=\\sqrt{10(1-(\\frac{1}{10})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{10} x}{10}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{10}}{10},\\qquad \\mathrm{d}x=(\\sqrt{10})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(0)=0 \\\\ x=\\sqrt{5}&\\Longrightarrow u=(\\frac{\\sqrt{10}}{10})(\\sqrt{5})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\sqrt{5}} \\frac{4}{\\sqrt{10 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{2 \\sqrt{10}}{5}\\int_{0}^{\\sqrt{5}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{10} x}{10})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{2 \\sqrt{10}}{5}(\\sqrt{10})\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 4\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 4[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{2}}{2}} \\\\  &= 4(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 4((\\frac{\\pi}{4})-(0)) \\\\  &= \\pi\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\sqrt{3} \\pi}{54}" :db/id #edb/ref 17592186677200}] :answer-field/correct {:answer/id #uuid "fdc0d3f5-a51b-5597-9b0f-2b50228b93a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\sqrt{3} \\pi}{54}" :db/id #edb/ref 17592186677200} :answer-field/id #uuid "d1b888f5-5707-53a5-b970-7313bcf41529" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677168}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5880c807-c10d-50e8-9d88-c434c7630fa9" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- 3 \\sqrt{3}}^{9} \\frac{6}{3 x^{2} + 81}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n3 x^{2} + 81=81(1+(\\frac{1}{27})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{3} x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{3}}{9},\\qquad \\mathrm{d}x=(3 \\sqrt{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- 3 \\sqrt{3}&\\Longrightarrow u=(\\frac{\\sqrt{3}}{9})(- 3 \\sqrt{3})=-1 \\\\ x=9&\\Longrightarrow u=(\\frac{\\sqrt{3}}{9})(9)=\\sqrt{3}\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- 3 \\sqrt{3}}^{9} \\frac{6}{3 x^{2} + 81}\\,\\mathrm{d}x \\\\  &= \\frac{2}{27}\\int_{- 3 \\sqrt{3}}^{9} \\frac{1}{1+(\\frac{\\sqrt{3} x}{9})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{2}{27}(3 \\sqrt{3})\\int_{-1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{3}}{9}\\int_{-1}^{\\sqrt{3}} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{3}}{9}[\\operatorname{arctan}{\\left(u \\right)}]_{-1}^{\\sqrt{3}} \\\\  &= \\frac{2 \\sqrt{3}}{9}(\\operatorname{arctan}(\\sqrt{3})-\\operatorname{arctan}(-1)) \\\\  &= \\frac{2 \\sqrt{3}}{9}((\\frac{\\pi}{3})-(- \\frac{\\pi}{4})) \\\\  &= \\frac{7 \\sqrt{3} \\pi}{54}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ac5bda-af2a-567a-972e-4eaed79b2cb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{100}" :db/id #edb/ref 17592186677044} {:answer/id #uuid "a63b8559-c82f-598b-a90b-350bd66e1c91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{20}" :db/id #edb/ref 17592186677129} {:answer/id #uuid "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186677133} {:answer/id #uuid "ae1a1d8e-c665-5fe6-a286-59bed10b0dc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}{\\left(\\frac{\\sqrt{2}}{2} \\right)}" :db/id #edb/ref 17592186677135} {:answer/id #uuid "daced14b-3627-5e01-8e59-8270db580180" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{4}" :db/id #edb/ref 17592186677172}] :answer-field/correct {:answer/id #uuid "a864f77b-e61b-569b-b091-f06fcbea3c77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186677133} :answer-field/id #uuid "bd293653-c045-569e-88f6-fbf74712702f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677150}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "682222db-91f6-5331-b0ae-5361f8ce335b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{25 - x^{2}}=\\sqrt{25(1-(\\frac{1}{25})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{5}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{5},\\qquad \\mathrm{d}x=(5)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{5})(0)=0 \\\\ x=\\frac{5 \\sqrt{2}}{2}&\\Longrightarrow u=(\\frac{1}{5})(\\frac{5 \\sqrt{2}}{2})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{5}\\int_{0}^{\\frac{5 \\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{5})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{5}(5)\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 1\\int_{0}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 1[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{2}}{2}} \\\\  &= 1(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 1((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\pi}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35733d7a-08b3-5eb1-b623-b285be791351" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9 \\pi}{32}" :db/id #edb/ref 17592186677076} {:answer/id #uuid "bcc765d0-19d2-52d4-8cae-2b1ce27c3960" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{32}" :db/id #edb/ref 17592186677149} {:answer/id #uuid "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\pi}{32}" :db/id #edb/ref 17592186677159} {:answer/id #uuid "cbd0e262-e697-5db3-b587-5ac8bdb7b7be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\pi}{256}" :db/id #edb/ref 17592186677160} {:answer/id #uuid "dfafb482-d854-543e-90ed-7b48a0404ff0" :answer/type {:db/ident :answer.type/math} :answer/value "18 \\pi" :db/id #edb/ref 17592186677178}] :answer-field/correct {:answer/id #uuid "caff1140-af84-5fee-a20b-46dfa8dfd943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\pi}{32}" :db/id #edb/ref 17592186677159} :answer-field/id #uuid "234d093f-86d5-5259-9076-fc2ff176a74e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677062}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6871a209-fee3-5a51-a701-ff2bbca02c0a" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{8}} \\frac{9}{64 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(8)(0)=0 \\\\ x=\\frac{1}{8}&\\Longrightarrow u=(8)(\\frac{1}{8})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{8}} \\frac{9}{64 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 9\\int_{0}^{\\frac{1}{8}} \\frac{1}{1+(8 x)^{2}}\\,\\mathrm{d}x \\\\  &= 9(\\frac{1}{8})\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9}{8}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{9}{8}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{9}{8}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{9}{8}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{9 \\pi}{32}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b98030-d11f-5f99-938a-5366d17d6d1d" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 \\operatorname{arctan}{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186677052} {:answer/id #uuid "2984adf6-e7b5-5a90-8825-5cdf2f26581a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186677069} {:answer/id #uuid "356b89e1-d725-57e8-b073-eb5591c2bcc3" :answer/type {:db/ident :answer.type/math} :answer/value "8 \\operatorname{arctan}{\\left(3 \\right)}" :db/id #edb/ref 17592186677075} {:answer/id #uuid "9d065717-78b1-5e32-873d-9ec56ea739b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(\\frac{1}{3} \\right)}}{3}" :db/id #edb/ref 17592186677124} {:answer/id #uuid "fc523c34-26f5-5ee8-9c58-6eb37bbddad6" :answer/type {:db/ident :answer.type/math} :answer/value "48 \\operatorname{arctan}{\\left(3 \\right)}" :db/id #edb/ref 17592186677196}] :answer-field/correct {:answer/id #uuid "2984adf6-e7b5-5a90-8825-5cdf2f26581a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186677069} :answer-field/id #uuid "708a5c04-84ae-5fc7-8d2f-1654bd8d1621" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677103}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7f635271-ad06-57ec-ba14-197476f846bc" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{2}} \\frac{8}{36 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/worked-solution "Use the linear substitution $u=6 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6,\\qquad \\mathrm{d}x=(\\frac{1}{6})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(6)(0)=0 \\\\ x=\\frac{1}{2}&\\Longrightarrow u=(6)(\\frac{1}{2})=3\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{2}} \\frac{8}{36 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 8\\int_{0}^{\\frac{1}{2}} \\frac{1}{1+(6 x)^{2}}\\,\\mathrm{d}x \\\\  &= 8(\\frac{1}{6})\\int_{0}^{3} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{3}\\int_{0}^{3} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{3}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{3} \\\\  &= \\frac{4}{3}(\\operatorname{arctan}(3)-\\operatorname{arctan}(0)) \\\\  &= \\frac{4}{3}((\\operatorname{arctan}{\\left(3 \\right)})-(0)) \\\\  &= \\frac{4 \\operatorname{arctan}{\\left(3 \\right)}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed763b1-4372-543e-8ee2-dcc84046626c" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\pi}{18}" :db/id #edb/ref 17592186677072} {:answer/id #uuid "755143cd-5ed9-5e1b-8d5b-5cda84267c28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{6}" :db/id #edb/ref 17592186677104} {:answer/id #uuid "e43f83e7-80cb-56df-b32b-9031973aa5a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\operatorname{arctan}{\\left(\\frac{1}{2} \\right)}}{3}" :db/id #edb/ref 17592186677186} {:answer/id #uuid "ea5e3f07-99ff-540a-9cb5-d65bfdb3deaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{18}" :db/id #edb/ref 17592186677189} {:answer/id #uuid "ff22cf23-2c43-5d63-aaa0-e07be7fbd843" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{54}" :db/id #edb/ref 17592186677201}] :answer-field/correct {:answer/id #uuid "ea5e3f07-99ff-540a-9cb5-d65bfdb3deaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{18}" :db/id #edb/ref 17592186677189} :answer-field/id #uuid "b6d7a1bb-2b22-5fcb-95fb-9f44edd34200" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677144}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8d27d9cf-cb74-5840-b365-e7db0c04fb39" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{6}} \\frac{7}{\\sqrt{1 - 9 x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "Use the linear substitution $u=3 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3,\\qquad \\mathrm{d}x=(\\frac{1}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(3)(0)=0 \\\\ x=\\frac{1}{6}&\\Longrightarrow u=(3)(\\frac{1}{6})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{6}} \\frac{7}{\\sqrt{1 - 9 x^{2}}}\\,\\mathrm{d}x \\\\  &= 7\\int_{0}^{\\frac{1}{6}} \\frac{1}{\\sqrt{1-(3 x)^{2}}}\\,\\mathrm{d}x \\\\  &= 7(\\frac{1}{3})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{7}{3}\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{7}{3}[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= \\frac{7}{3}(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= \\frac{7}{3}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{7 \\pi}{18}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e664b4d-38a8-5ddc-9c88-53307ae3c5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{15}" :db/id #edb/ref 17592186677085}] :answer-field/correct {:answer/id #uuid "3e664b4d-38a8-5ddc-9c88-53307ae3c5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\pi}{15}" :db/id #edb/ref 17592186677085} :answer-field/id #uuid "aa4440e7-6f62-5402-bbe0-f2650309cdb7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677134}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a2d73b9e-ded5-5263-8f8f-f603b91d7e83" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{10}} \\frac{4}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "Use the linear substitution $u=5 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=5,\\qquad \\mathrm{d}x=(\\frac{1}{5})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(5)(0)=0 \\\\ x=\\frac{1}{10}&\\Longrightarrow u=(5)(\\frac{1}{10})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{10}} \\frac{4}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x \\\\  &= 4\\int_{0}^{\\frac{1}{10}} \\frac{1}{\\sqrt{1-(5 x)^{2}}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{1}{5})\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{5}\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{5}[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{1}{2}} \\\\  &= \\frac{4}{5}(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(0)) \\\\  &= \\frac{4}{5}((\\frac{\\pi}{6})-(0)) \\\\  &= \\frac{2 \\pi}{15}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd1c91ab-c520-5c89-9666-8520331af451" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{3}" :db/id #edb/ref 17592186677175}] :answer-field/correct {:answer/id #uuid "dd1c91ab-c520-5c89-9666-8520331af451" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7 \\pi}{3}" :db/id #edb/ref 17592186677175} :answer-field/id #uuid "c9da6c61-240b-51b8-87c9-710e48d7bbfa" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677157}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3b89a57-caff-5fb6-834c-90a2ee3c5896" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{7}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=\\sqrt{9(1-(\\frac{1}{9})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{3},\\qquad \\mathrm{d}x=(3)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(\\frac{1}{3})(0)=0 \\\\ x=\\frac{3 \\sqrt{3}}{2}&\\Longrightarrow u=(\\frac{1}{3})(\\frac{3 \\sqrt{3}}{2})=\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{7}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{3}\\int_{0}^{\\frac{3 \\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{3})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{3}(3)\\int_{0}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 7\\int_{0}^{\\frac{\\sqrt{3}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 7[\\operatorname{arcsin}{\\left(u \\right)}]_{0}^{\\frac{\\sqrt{3}}{2}} \\\\  &= 7(\\operatorname{arcsin}(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}(0)) \\\\  &= 7((\\frac{\\pi}{3})-(0)) \\\\  &= \\frac{7 \\pi}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5802f692-c0cd-5a7e-897b-1371d250ef1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{24}" :db/id #edb/ref 17592186677093} {:answer/id #uuid "80d3531a-3427-5af4-ba44-51c4c3208105" :answer/type {:db/ident :answer.type/math} :answer/value "12 \\pi" :db/id #edb/ref 17592186677111} {:answer/id #uuid "c7a337d6-4b80-5385-bb22-efe782a80c7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\pi}{3}" :db/id #edb/ref 17592186677155} {:answer/id #uuid "cdc8d03a-17cc-5e50-9b8a-ab499d73cb11" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\pi" :db/id #edb/ref 17592186677165} {:answer/id #uuid "d36c10cf-131b-534c-8641-5d5e441d82eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186677169}] :answer-field/correct {:answer/id #uuid "d36c10cf-131b-534c-8641-5d5e441d82eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186677169} :answer-field/id #uuid "c0d68d01-8a42-57ff-b972-69003f4877c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677151}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a497f451-04d7-5c60-a172-42abdf02370f" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{6}} \\frac{8}{36 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/worked-solution "Use the linear substitution $u=6 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6,\\qquad \\mathrm{d}x=(\\frac{1}{6})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(6)(0)=0 \\\\ x=\\frac{1}{6}&\\Longrightarrow u=(6)(\\frac{1}{6})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{6}} \\frac{8}{36 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 8\\int_{0}^{\\frac{1}{6}} \\frac{1}{1+(6 x)^{2}}\\,\\mathrm{d}x \\\\  &= 8(\\frac{1}{6})\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{3}\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{3}[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= \\frac{4}{3}(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= \\frac{4}{3}((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\pi}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "584e96b6-767c-5e14-899f-41a99d429ed3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25 \\sqrt{6} \\pi}{72}" :db/id #edb/ref 17592186677094} {:answer/id #uuid "78ee06fb-d3bd-5699-be5d-99abba240a16" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{6} \\pi}{72}" :db/id #edb/ref 17592186677108} {:answer/id #uuid "b534102c-0a28-5ffc-8498-8c551bd0cc23" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{6} \\pi}{72}" :db/id #edb/ref 17592186677141} {:answer/id #uuid "ca8e45df-9845-509b-a95f-6c7724735b22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\pi}{12}" :db/id #edb/ref 17592186677158} {:answer/id #uuid "cd0beb08-add5-50bf-82af-696f8e97dadb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\pi}{72}" :db/id #edb/ref 17592186677164}] :answer-field/correct {:answer/id #uuid "b534102c-0a28-5ffc-8498-8c551bd0cc23" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{6} \\pi}{72}" :db/id #edb/ref 17592186677141} :answer-field/id #uuid "c2f94dbd-24b0-502c-8bef-8dd471a94ea1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677153}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a4a4dc8e-8a02-5ef0-a5ce-5526bba8d539" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\sqrt{6}}{2}}^{\\sqrt{3}} \\frac{5}{\\sqrt{36 - 6 x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{36 - 6 x^{2}}=\\sqrt{36(1-(\\frac{1}{6})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{6},\\qquad \\mathrm{d}x=(\\sqrt{6})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\sqrt{6}}{2}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{6})(\\frac{\\sqrt{6}}{2})=\\frac{1}{2} \\\\ x=\\sqrt{3}&\\Longrightarrow u=(\\frac{\\sqrt{6}}{6})(\\sqrt{3})=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{\\sqrt{6}}{2}}^{\\sqrt{3}} \\frac{5}{\\sqrt{36 - 6 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{5}{6}\\int_{\\frac{\\sqrt{6}}{2}}^{\\sqrt{3}} \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{6} x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{5}{6}(\\sqrt{6})\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{5 \\sqrt{6}}{6}\\int_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{5 \\sqrt{6}}{6}[\\operatorname{arcsin}{\\left(u \\right)}]_{\\frac{1}{2}}^{\\frac{\\sqrt{2}}{2}} \\\\  &= \\frac{5 \\sqrt{6}}{6}(\\operatorname{arcsin}(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}(\\frac{1}{2})) \\\\  &= \\frac{5 \\sqrt{6}}{6}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{5 \\sqrt{6} \\pi}{72}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a0125b7-63f0-5ffe-9867-939dcd35b2af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186677070}] :answer-field/correct {:answer/id #uuid "2a0125b7-63f0-5ffe-9867-939dcd35b2af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186677070} :answer-field/id #uuid "e3ea9054-3361-5bd8-b506-dcb0dcac388a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677185}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a7b41060-9701-5ac8-9406-41c43c4a9895" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{9}} \\frac{9}{81 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "Use the linear substitution $u=9 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9,\\qquad \\mathrm{d}x=(\\frac{1}{9})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=(9)(0)=0 \\\\ x=\\frac{1}{9}&\\Longrightarrow u=(9)(\\frac{1}{9})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{0}^{\\frac{1}{9}} \\frac{9}{81 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 9\\int_{0}^{\\frac{1}{9}} \\frac{1}{1+(9 x)^{2}}\\,\\mathrm{d}x \\\\  &= 9(\\frac{1}{9})\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= 1\\int_{0}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= 1[\\operatorname{arctan}{\\left(u \\right)}]_{0}^{1} \\\\  &= 1(\\operatorname{arctan}(1)-\\operatorname{arctan}(0)) \\\\  &= 1((\\frac{\\pi}{4})-(0)) \\\\  &= \\frac{\\pi}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d602eba-c683-5422-ab3f-d225478a529e" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\pi" :db/id #edb/ref 17592186677098}] :answer-field/correct {:answer/id #uuid "5d602eba-c683-5422-ab3f-d225478a529e" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\pi" :db/id #edb/ref 17592186677098} :answer-field/id #uuid "56821200-ef2e-57da-b433-e28f4b7b7183" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186677092}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b68941c7-a358-52a8-9847-bc887dddfa00" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{7}{2}}^{\\frac{7}{2}} \\frac{6}{\\sqrt{49 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{49 - x^{2}}=\\sqrt{49(1-(\\frac{1}{49})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{7}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{7},\\qquad \\mathrm{d}x=(7)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{7}{2}&\\Longrightarrow u=(\\frac{1}{7})(- \\frac{7}{2})=- \\frac{1}{2} \\\\ x=\\frac{7}{2}&\\Longrightarrow u=(\\frac{1}{7})(\\frac{7}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nBoth transformed endpoints lie strictly between $-1$ and $1$, so the integrand is continuous throughout the interval.\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{7}{2}}^{\\frac{7}{2}} \\frac{6}{\\sqrt{49 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{6}{7}\\int_{- \\frac{7}{2}}^{\\frac{7}{2}} \\frac{1}{\\sqrt{1-(\\frac{x}{7})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{6}{7}(7)\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 6\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 6[\\operatorname{arcsin}{\\left(u \\right)}]_{- \\frac{1}{2}}^{\\frac{1}{2}} \\\\  &= 6(\\operatorname{arcsin}(\\frac{1}{2})-\\operatorname{arcsin}(- \\frac{1}{2})) \\\\  &= 6((\\frac{\\pi}{6})-(- \\frac{\\pi}{6})) \\\\  &= 2 \\pi\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193240cb-9bf1-5fc3-88c4-343eb2b3f61c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{256}" :db/id #edb/ref 17592186677056} {:answer/id #uuid "2303c723-3669-5376-b718-f0b6719d1697" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} \\pi}{288}" :db/id #edb/ref 17592186677061} {:answer/id #uuid "3e412948-a45d-5098-9434-a82895c83f16" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} \\pi}{96}" :db/id #edb/ref 17592186677084} {:answer/id #uuid "b3fa66f7-e082-5e62-acfc-3e26bc6ee6e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} \\pi}{32}" :db/id #edb/ref 17592186677139} {:answer/id #uuid "b40c90ad-24fd-5084-80a0-31c0f725200f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} \\pi}{2048}" :db/id #edb/ref 17592186677140}] :answer-field/correct {:answer/id #uuid "3e412948-a45d-5098-9434-a82895c83f16" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} \\pi}{96}" :db/id #edb/ref 17592186677084} :answer-field/id #uuid "a7792e2b-87fe-5b28-8d18-1c100112100d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186677130}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b7e7efd8-4daf-5a99-9901-08530da7dbd2" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{8}{3}}^{\\frac{8 \\sqrt{3}}{3}} \\frac{3}{3 x^{2} + 64}\\,\\mathrm{d}x\n$$" :question/worked-solution "First factor the constant in the denominator:\n\n$$\n3 x^{2} + 64=64(1+(\\frac{3}{64})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{3} x}{8}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{3}}{8},\\qquad \\mathrm{d}x=(\\frac{8 \\sqrt{3}}{3})\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{8}{3}&\\Longrightarrow u=(\\frac{\\sqrt{3}}{8})(\\frac{8}{3})=\\frac{\\sqrt{3}}{3} \\\\ x=\\frac{8 \\sqrt{3}}{3}&\\Longrightarrow u=(\\frac{\\sqrt{3}}{8})(\\frac{8 \\sqrt{3}}{3})=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{\\frac{8}{3}}^{\\frac{8 \\sqrt{3}}{3}} \\frac{3}{3 x^{2} + 64}\\,\\mathrm{d}x \\\\  &= \\frac{3}{64}\\int_{\\frac{8}{3}}^{\\frac{8 \\sqrt{3}}{3}} \\frac{1}{1+(\\frac{\\sqrt{3} x}{8})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{64}(\\frac{8 \\sqrt{3}}{3})\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{3}}{8}\\int_{\\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{3}}{8}[\\operatorname{arctan}{\\left(u \\right)}]_{\\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{\\sqrt{3}}{8}(\\operatorname{arctan}(1)-\\operatorname{arctan}(\\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{\\sqrt{3}}{8}((\\frac{\\pi}{4})-(\\frac{\\pi}{6})) \\\\  &= \\frac{\\sqrt{3} \\pi}{96}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186677146 :question/a