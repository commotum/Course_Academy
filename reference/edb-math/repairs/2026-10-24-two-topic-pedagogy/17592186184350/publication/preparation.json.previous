egral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 3^{x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/worked-solution \"Let $u=x^{2} + 2$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 3^{x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/difficulty :question.difficulty/easy] [:db/add \"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/answer-fields \"36170193-0701-5267-8518-2a08d460964f\"] [:db/ensure \"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\"] [:db/add \"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\" :answer/id #uuid \"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\"] [:db/add \"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\" :answer/type :answer.type/math] [:db/add \"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\" :answer/value \"3\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\" :answer/validate] [:db/add \"27b97f13-b399-50c8-a3d5-d275c073b91e\" :answer/id #uuid \"27b97f13-b399-50c8-a3d5-d275c073b91e\"] [:db/add \"27b97f13-b399-50c8-a3d5-d275c073b91e\" :answer/type :answer.type/math] [:db/add \"27b97f13-b399-50c8-a3d5-d275c073b91e\" :answer/value \"\\\\int 5^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"27b97f13-b399-50c8-a3d5-d275c073b91e\" :answer/validate] [:db/add \"da31f811-7d84-55ce-90a0-e2c88c2aac17\" :answer/id #uuid \"da31f811-7d84-55ce-90a0-e2c88c2aac17\"] [:db/add \"da31f811-7d84-55ce-90a0-e2c88c2aac17\" :answer/type :answer.type/math] [:db/add \"da31f811-7d84-55ce-90a0-e2c88c2aac17\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"da31f811-7d84-55ce-90a0-e2c88c2aac17\" :answer/validate] [:db/add \"0e2e9a14-a3ca-5393-92f7-764a555ded4e\" :answer/id #uuid \"0e2e9a14-a3ca-5393-92f7-764a555ded4e\"] [:db/add \"0e2e9a14-a3ca-5393-92f7-764a555ded4e\" :answer/type :answer.type/math] [:db/add \"0e2e9a14-a3ca-5393-92f7-764a555ded4e\" :answer/value \"-1\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0e2e9a14-a3ca-5393-92f7-764a555ded4e\" :answer/validate] [:db/add \"93821651-605c-5965-9350-4d3a62b4f791\" :answer/id #uuid \"93821651-605c-5965-9350-4d3a62b4f791\"] [:db/add \"93821651-605c-5965-9350-4d3a62b4f791\" :answer/type :answer.type/math] [:db/add \"93821651-605c-5965-9350-4d3a62b4f791\" :answer/value \"2\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"93821651-605c-5965-9350-4d3a62b4f791\" :answer/validate] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/id #uuid \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\"] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/key \"answer\"] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/type :answer-field.type/radio] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/choices \"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\"] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/choices \"27b97f13-b399-50c8-a3d5-d275c073b91e\"] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/choices \"da31f811-7d84-55ce-90a0-e2c88c2aac17\"] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/choices \"0e2e9a14-a3ca-5393-92f7-764a555ded4e\"] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/choices \"93821651-605c-5965-9350-4d3a62b4f791\"] [:db/add \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/correct \"27b97f13-b399-50c8-a3d5-d275c073b91e\"] [:db/ensure \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\" :answer-field/validate] [:db/add \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\" :question/id #uuid \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\"] [:db/add \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 5^{x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\" :question/worked-solution \"Let $u=x^{3}$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 5^{x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 5^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int 5^{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\" :question/difficulty :question.difficulty/easy] [:db/add \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\" :question/answer-fields \"6cd269fc-1596-5c60-a224-fc5781f6d7c8\"] [:db/ensure \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"cf1df7b7-519a-568e-8af7-e3c2c6f8a54c\"] [:db/add \"0023eb5f-e351-58cf-8ea0-d3be88ca622a\" :answer/id #uuid \"0023eb5f-e351-58cf-8ea0-d3be88ca622a\"] [:db/add \"0023eb5f-e351-58cf-8ea0-d3be88ca622a\" :answer/type :answer.type/math] [:db/add \"0023eb5f-e351-58cf-8ea0-d3be88ca622a\" :answer/value \"\\\\frac{9}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0023eb5f-e351-58cf-8ea0-d3be88ca622a\" :answer/validate] [:db/add \"46a9eca7-a47e-5791-9fc7-186a631991eb\" :answer/id #uuid \"46a9eca7-a47e-5791-9fc7-186a631991eb\"] [:db/add \"46a9eca7-a47e-5791-9fc7-186a631991eb\" :answer/type :answer.type/math] [:db/add \"46a9eca7-a47e-5791-9fc7-186a631991eb\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"46a9eca7-a47e-5791-9fc7-186a631991eb\" :answer/validate] [:db/add \"523e539f-a1ff-5c62-a6e3-4e51b9e9a6fe\" :answer/id #uuid \"523e539f-a1ff-5c62-a6e3-4e51b9e9a6fe\"] [:db/add \"523e539f-a1ff-5c62-a6e3-4e51b9e9a6fe\" :answer/type :answer.type/math] [:db/add \"523e539f-a1ff-5c62-a6e3-4e51b9e9a6fe\" :answer/value \"3\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"523e539f-a1ff-5c62-a6e3-4e51b9e9a6fe\" :answer/validate] [:db/add \"9dd51d92-ce65-50f7-ad0f-fe5d13ae2c54\" :answer/id #uuid \"9dd51d92-ce65-50f7-ad0f-fe5d13ae2c54\"] [:db/add \"9dd51d92-ce65-50f7-ad0f-fe5d13ae2c54\" :answer/type :answer.type/math] [:db/add \"9dd51d92-ce65-50f7-ad0f-fe5d13ae2c54\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"9dd51d92-ce65-50f7-ad0f-fe5d13ae2c54\" :answer/validate] [:db/add \"85eb1bb1-bdc1-5690-a641-f7ccc2fbd0c0\" :answer/id #uuid \"85eb1bb1-bdc1-5690-a641-f7ccc2fbd0c0\"] [:db/add \"85eb1bb1-bdc1-5690-a641-f7ccc2fbd0c0\" :answer/type :answer.type/math] [:db/add \"85eb1bb1-bdc1-5690-a641-f7ccc2fbd0c0\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"85eb1bb1-bdc1-5690-a641-f7ccc2fbd0c0\" :answer/validate] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/id #uuid \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\"] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/key \"answer\"] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/type :answer-field.type/radio] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/choices \"0023eb5f-e351-58cf-8ea0-d3be88ca622a\"] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/choices \"46a9eca7-a47e-5791-9fc7-186a631991eb\"] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/choices \"523e539f-a1ff-5c62-a6e3-4e51b9e9a6fe\"] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/choices \"9dd51d92-ce65-50f7-ad0f-fe5d13ae2c54\"] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/choices \"85eb1bb1-bdc1-5690-a641-f7ccc2fbd0c0\"] [:db/add \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/correct \"85eb1bb1-bdc1-5690-a641-f7ccc2fbd0c0\"] [:db/ensure \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\" :answer-field/validate] [:db/add \"21d347ea-9600-5edd-8e03-478cdd2db340\" :question/id #uuid \"21d347ea-9600-5edd-8e03-478cdd2db340\"] [:db/add \"21d347ea-9600-5edd-8e03-478cdd2db340\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 3^{x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"21d347ea-9600-5edd-8e03-478cdd2db340\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 3^{x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"21d347ea-9600-5edd-8e03-478cdd2db340\" :question/difficulty :question.difficulty/easy] [:db/add \"21d347ea-9600-5edd-8e03-478cdd2db340\" :question/answer-fields \"16b6b2e2-04c7-5e1d-bcfd-6998e46dcf7c\"] [:db/ensure \"21d347ea-9600-5edd-8e03-478cdd2db340\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"21d347ea-9600-5edd-8e03-478cdd2db340\"] [:db/add \"ac108f71-110d-5def-a988-7adf10aad264\" :answer/id #uuid \"ac108f71-110d-5def-a988-7adf10aad264\"] [:db/add \"ac108f71-110d-5def-a988-7adf10aad264\" :answer/type :answer.type/math] [:db/add \"ac108f71-110d-5def-a988-7adf10aad264\" :answer/value \"\\\\frac{5^{x^{2} + 2}}{\\\\ln{\\\\left(5 \\\\right)}}\"] [:db/ensure \"ac108f71-110d-5def-a988-7adf10aad264\" :answer/validate] [:db/add \"bea41166-803e-5e0b-8045-a5fea638bee2\" :answer-field/id #uuid \"bea41166-803e-5e0b-8045-a5fea638bee2\"] [:db/add \"bea41166-803e-5e0b-8045-a5fea638bee2\" :answer-field/key \"answer\"] [:db/add \"bea41166-803e-5e0b-8045-a5fea638bee2\" :answer-field/type :answer-field.type/blank] [:db/add \"bea41166-803e-5e0b-8045-a5fea638bee2\" :answer-field/choices \"ac108f71-110d-5def-a988-7adf10aad264\"] [:db/add \"bea41166-803e-5e0b-8045-a5fea638bee2\" :answer-field/correct \"ac108f71-110d-5def-a988-7adf10aad264\"] [:db/ensure \"bea41166-803e-5e0b-8045-a5fea638bee2\" :answer-field/validate] [:db/add \"a4503e29-3b4f-54ed-b64a-d669140a8811\" :question/id #uuid \"a4503e29-3b4f-54ed-b64a-d669140a8811\"] [:db/add \"a4503e29-3b4f-54ed-b64a-d669140a8811\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cdot 5^{x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"a4503e29-3b4f-54ed-b64a-d669140a8811\" :question/worked-solution \"Let $u=x^{2} + 2$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 5^{x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 5^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{5^{x^{2} + 2}}{\\\\ln{\\\\left(5 \\\\right)}}+C.\\n$$\"] [:db/add \"a4503e29-3b4f-54ed-b64a-d669140a8811\" :question/difficulty :question.difficulty/moderate] [:db/add \"a4503e29-3b4f-54ed-b64a-d669140a8811\" :question/answer-fields \"bea41166-803e-5e0b-8045-a5fea638bee2\"] [:db/ensure \"a4503e29-3b4f-54ed-b64a-d669140a8811\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"a4503e29-3b4f-54ed-b64a-d669140a8811\"] [:db/add \"5c86af66-2876-502b-abc7-d43867fae482\" :answer/id #uuid \"5c86af66-2876-502b-abc7-d43867fae482\"] [:db/add \"5c86af66-2876-502b-abc7-d43867fae482\" :answer/type :answer.type/math] [:db/add \"5c86af66-2876-502b-abc7-d43867fae482\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\frac{5^{x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\"] [:db/ensure \"5c86af66-2876-502b-abc7-d43867fae482\" :answer/validate] [:db/add \"489cadc9-f65a-56d8-80f7-12a41d63df3e\" :answer-field/id #uuid \"489cadc9-f65a-56d8-80f7-12a41d63df3e\"] [:db/add \"489cadc9-f65a-56d8-80f7-12a41d63df3e\" :answer-field/key \"answer\"] [:db/add \"489cadc9-f65a-56d8-80f7-12a41d63df3e\" :answer-field/type :answer-field.type/blank] [:db/add \"489cadc9-f65a-56d8-80f7-12a41d63df3e\" :answer-field/choices \"5c86af66-2876-502b-abc7-d43867fae482\"] [:db/add \"489cadc9-f65a-56d8-80f7-12a41d63df3e\" :answer-field/correct \"5c86af66-2876-502b-abc7-d43867fae482\"] [:db/ensure \"489cadc9-f65a-56d8-80f7-12a41d63df3e\" :answer-field/validate] [:db/add \"894188c0-5707-53e6-81a5-fc363874eea4\" :question/id #uuid \"894188c0-5707-53e6-81a5-fc363874eea4\"] [:db/add \"894188c0-5707-53e6-81a5-fc363874eea4\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 5^{x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"894188c0-5707-53e6-81a5-fc363874eea4\" :question/worked-solution \"Let $u=x^{3}$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 5^{x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\frac{5^{x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"894188c0-5707-53e6-81a5-fc363874eea4\" :question/difficulty :question.difficulty/moderate] [:db/add \"894188c0-5707-53e6-81a5-fc363874eea4\" :question/answer-fields \"489cadc9-f65a-56d8-80f7-12a41d63df3e\"] [:db/ensure \"894188c0-5707-53e6-81a5-fc363874eea4\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"894188c0-5707-53e6-81a5-fc363874eea4\"] [:db/add \"6480e7e6-3c5a-5fe2-940b-2ae030fe56fc\" :answer/id #uuid \"6480e7e6-3c5a-5fe2-940b-2ae030fe56fc\"] [:db/add \"6480e7e6-3c5a-5fe2-940b-2ae030fe56fc\" :answer/type :answer.type/math] [:db/add \"6480e7e6-3c5a-5fe2-940b-2ae030fe56fc\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\frac{3^{2 x^{2} + 1}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\"] [:db/ensure \"6480e7e6-3c5a-5fe2-940b-2ae030fe56fc\" :answer/validate] [:db/add \"a91505b9-7ccc-5893-8249-ac5c11097a17\" :answer-field/id #uuid \"a91505b9-7ccc-5893-8249-ac5c11097a17\"] [:db/add \"a91505b9-7ccc-5893-8249-ac5c11097a17\" :answer-field/key \"answer\"] [:db/add \"a91505b9-7ccc-5893-8249-ac5c11097a17\" :answer-field/type :answer-field.type/blank] [:db/add \"a91505b9-7ccc-5893-8249-ac5c11097a17\" :answer-field/choices \"6480e7e6-3c5a-5fe2-940b-2ae030fe56fc\"] [:db/add \"a91505b9-7ccc-5893-8249-ac5c11097a17\" :answer-field/correct \"6480e7e6-3c5a-5fe2-940b-2ae030fe56fc\"] [:db/ensure \"a91505b9-7ccc-5893-8249-ac5c11097a17\" :answer-field/validate] [:db/add \"77ac9561-e3f4-5545-80ac-69563b726f44\" :question/id #uuid \"77ac9561-e3f4-5545-80ac-69563b726f44\"] [:db/add \"77ac9561-e3f4-5545-80ac-69563b726f44\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3^{2 x^{2} + 1} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"77ac9561-e3f4-5545-80ac-69563b726f44\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3^{2 x^{2} + 1} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\frac{3^{2 x^{2} + 1}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"77ac9561-e3f4-5545-80ac-69563b726f44\" :question/difficulty :question.difficulty/moderate] [:db/add \"77ac9561-e3f4-5545-80ac-69563b726f44\" :question/answer-fields \"a91505b9-7ccc-5893-8249-ac5c11097a17\"] [:db/ensure \"77ac9561-e3f4-5545-80ac-69563b726f44\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"77ac9561-e3f4-5545-80ac-69563b726f44\"] [:db/add \"52cb5d68-fbce-54d3-a60a-d42f96fd9126\" :answer/id #uuid \"52cb5d68-fbce-54d3-a60a-d42f96fd9126\"] [:db/add \"52cb5d68-fbce-54d3-a60a-d42f96fd9126\" :answer/type :answer.type/math] [:db/add \"52cb5d68-fbce-54d3-a60a-d42f96fd9126\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\frac{3^{x^{3} + 1}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\"] [:db/ensure \"52cb5d68-fbce-54d3-a60a-d42f96fd9126\" :answer/validate] [:db/add \"7baf5f93-ef37-5cff-bc22-0299a3588633\" :answer-field/id #uuid \"7baf5f93-ef37-5cff-bc22-0299a3588633\"] [:db/add \"7baf5f93-ef37-5cff-bc22-0299a3588633\" :answer-field/key \"answer\"] [:db/add \"7baf5f93-ef37-5cff-bc22-0299a3588633\" :answer-field/type :answer-field.type/blank] [:db/add \"7baf5f93-ef37-5cff-bc22-0299a3588633\" :answer-field/choices \"52cb5d68-fbce-54d3-a60a-d42f96fd9126\"] [:db/add \"7baf5f93-ef37-5cff-bc22-0299a3588633\" :answer-field/correct \"52cb5d68-fbce-54d3-a60a-d42f96fd9126\"] [:db/ensure \"7baf5f93-ef37-5cff-bc22-0299a3588633\" :answer-field/validate] [:db/add \"57c43d75-4152-5819-a024-e6df0b92b572\" :question/id #uuid \"57c43d75-4152-5819-a024-e6df0b92b572\"] [:db/add \"57c43d75-4152-5819-a024-e6df0b92b572\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"57c43d75-4152-5819-a024-e6df0b92b572\" :question/worked-solution \"Let $u=x^{3} + 1$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\frac{3^{x^{3} + 1}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"57c43d75-4152-5819-a024-e6df0b92b572\" :question/difficulty :question.difficulty/moderate] [:db/add \"57c43d75-4152-5819-a024-e6df0b92b572\" :question/answer-fields \"7baf5f93-ef37-5cff-bc22-0299a3588633\"] [:db/ensure \"57c43d75-4152-5819-a024-e6df0b92b572\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"57c43d75-4152-5819-a024-e6df0b92b572\"] [:db/add \"c5db4d26-6b07-50a2-a7d0-f4f9c837d42c\" :answer/id #uuid \"c5db4d26-6b07-50a2-a7d0-f4f9c837d42c\"] [:db/add \"c5db4d26-6b07-50a2-a7d0-f4f9c837d42c\" :answer/type :answer.type/math] [:db/add \"c5db4d26-6b07-50a2-a7d0-f4f9c837d42c\" :answer/value \"\\\\frac{2^{2 x^{2} + 3}}{\\\\ln{\\\\left(2 \\\\right)}}\"] [:db/ensure \"c5db4d26-6b07-50a2-a7d0-f4f9c837d42c\" :answer/validate] [:db/add \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\" :answer-field/id #uuid \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\"] [:db/add \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\" :answer-field/key \"answer\"] [:db/add \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\" :answer-field/type :answer-field.type/blank] [:db/add \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\" :answer-field/choices \"c5db4d26-6b07-50a2-a7d0-f4f9c837d42c\"] [:db/add \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\" :answer-field/correct \"c5db4d26-6b07-50a2-a7d0-f4f9c837d42c\"] [:db/ensure \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\" :answer-field/validate] [:db/add \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\" :question/id #uuid \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\"] [:db/add \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cdot 2^{2 x^{2} + 3} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\" :question/worked-solution \"Let $u=2 x^{2} + 3$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 2^{2 x^{2} + 3} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 2^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2^{2 x^{2} + 3}}{\\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\"] [:db/add \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\" :question/difficulty :question.difficulty/moderate] [:db/add \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\" :question/answer-fields \"cff1a0bb-671b-5be7-84ec-d2b33702ef46\"] [:db/ensure \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2\"] [:db/add \"e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2\" :answer/id #uuid \"e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2\"] [:db/add \"e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2\" :answer/type :answer.type/math] [:db/add \"e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2\" :answer/value \"\\\\frac{2^{x^{3} + 1}}{\\\\ln{\\\\left(2 \\\\right)}}\"] [:db/ensure \"e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2\" :answer/validate] [:db/add \"bf71755d-a0d3-57b5-8763-4ac8ad145139\" :answer-field/id #uuid \"bf71755d-a0d3-57b5-8763-4ac8ad145139\"] [:db/add \"bf71755d-a0d3-57b5-8763-4ac8ad145139\" :answer-field/key \"answer\"] [:db/add \"bf71755d-a0d3-57b5-8763-4ac8ad145139\" :answer-field/type :answer-field.type/blank] [:db/add \"bf71755d-a0d3-57b5-8763-4ac8ad145139\" :answer-field/choices \"e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2\"] [:db/add \"bf71755d-a0d3-57b5-8763-4ac8ad145139\" :answer-field/correct \"e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2\"] [:db/ensure \"bf71755d-a0d3-57b5-8763-4ac8ad145139\" :answer-field/validate] [:db/add \"359d40d4-2220-5366-a978-a9a9a350a0f2\" :question/id #uuid \"359d40d4-2220-5366-a978-a9a9a350a0f2\"] [:db/add \"359d40d4-2220-5366-a978-a9a9a350a0f2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"359d40d4-2220-5366-a978-a9a9a350a0f2\" :question/worked-solution \"Let $u=x^{3} + 1$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 2^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2^{x^{3} + 1}}{\\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\"] [:db/add \"359d40d4-2220-5366-a978-a9a9a350a0f2\" :question/difficulty :question.difficulty/moderate] [:db/add \"359d40d4-2220-5366-a978-a9a9a350a0f2\" :question/answer-fields \"bf71755d-a0d3-57b5-8763-4ac8ad145139\"] [:db/ensure \"359d40d4-2220-5366-a978-a9a9a350a0f2\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"359d40d4-2220-5366-a978-a9a9a350a0f2\"] [:db/add \"40a6b836-8b7b-5337-8d7d-1d88337396c5\" :answer/id #uuid \"40a6b836-8b7b-5337-8d7d-1d88337396c5\"] [:db/add \"40a6b836-8b7b-5337-8d7d-1d88337396c5\" :answer/type :answer.type/math] [:db/add \"40a6b836-8b7b-5337-8d7d-1d88337396c5\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\frac{5^{2 x^{2} + 2}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\"] [:db/ensure \"40a6b836-8b7b-5337-8d7d-1d88337396c5\" :answer/validate] [:db/add \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\" :answer-field/id #uuid \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\"] [:db/add \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\" :answer-field/key \"answer\"] [:db/add \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\" :answer-field/type :answer-field.type/blank] [:db/add \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\" :answer-field/choices \"40a6b836-8b7b-5337-8d7d-1d88337396c5\"] [:db/add \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\" :answer-field/correct \"40a6b836-8b7b-5337-8d7d-1d88337396c5\"] [:db/ensure \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\" :answer-field/validate] [:db/add \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\" :question/id #uuid \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\"] [:db/add \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 5^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\" :question/worked-solution \"Let $u=2 x^{2} + 2$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 5^{2 x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\frac{5^{2 x^{2} + 2}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\" :question/difficulty :question.difficulty/moderate] [:db/add \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\" :question/answer-fields \"42fcc5c3-e7c7-5c41-8521-c50ff5ce56da\"] [:db/ensure \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"694f8a19-cddb-5b1e-b77b-8b9cd195c174\"] [:db/add \"a6377cc5-9826-54a6-899c-0b253c8e88ff\" :answer/id #uuid \"a6377cc5-9826-54a6-899c-0b253c8e88ff\"] [:db/add \"a6377cc5-9826-54a6-899c-0b253c8e88ff\" :answer/type :answer.type/math] [:db/add \"a6377cc5-9826-54a6-899c-0b253c8e88ff\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\frac{3^{x^{3} + 2}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\"] [:db/ensure \"a6377cc5-9826-54a6-899c-0b253c8e88ff\" :answer/validate] [:db/add \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\" :answer-field/id #uuid \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\"] [:db/add \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\" :answer-field/key \"answer\"] [:db/add \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\" :answer-field/type :answer-field.type/blank] [:db/add \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\" :answer-field/choices \"a6377cc5-9826-54a6-899c-0b253c8e88ff\"] [:db/add \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\" :answer-field/correct \"a6377cc5-9826-54a6-899c-0b253c8e88ff\"] [:db/ensure \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\" :answer-field/validate] [:db/add \"5c977eea-335e-5055-a868-1e56d5c6fe24\" :question/id #uuid \"5c977eea-335e-5055-a868-1e56d5c6fe24\"] [:db/add \"5c977eea-335e-5055-a868-1e56d5c6fe24\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cdot 3^{x^{3} + 2} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"5c977eea-335e-5055-a868-1e56d5c6fe24\" :question/worked-solution \"Let $u=x^{3} + 2$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 3^{x^{3} + 2} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\frac{3^{x^{3} + 2}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"5c977eea-335e-5055-a868-1e56d5c6fe24\" :question/difficulty :question.difficulty/moderate] [:db/add \"5c977eea-335e-5055-a868-1e56d5c6fe24\" :question/answer-fields \"c7179666-3e4a-56ab-bf40-d66e4adfe41a\"] [:db/ensure \"5c977eea-335e-5055-a868-1e56d5c6fe24\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"5c977eea-335e-5055-a868-1e56d5c6fe24\"] [:db/add \"9475f9e5-227c-5840-b910-548f1ff669d7\" :answer/id #uuid \"9475f9e5-227c-5840-b910-548f1ff669d7\"] [:db/add \"9475f9e5-227c-5840-b910-548f1ff669d7\" :answer/type :answer.type/math] [:db/add \"9475f9e5-227c-5840-b910-548f1ff669d7\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\frac{2^{2 - x^{3}}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\"] [:db/ensure \"9475f9e5-227c-5840-b910-548f1ff669d7\" :answer/validate] [:db/add \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\" :answer-field/id #uuid \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\"] [:db/add \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\" :answer-field/key \"answer\"] [:db/add \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\" :answer-field/type :answer-field.type/blank] [:db/add \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\" :answer-field/choices \"9475f9e5-227c-5840-b910-548f1ff669d7\"] [:db/add \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\" :answer-field/correct \"9475f9e5-227c-5840-b910-548f1ff669d7\"] [:db/ensure \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\" :answer-field/validate] [:db/add \"b6f971f5-bfd8-5a38-88b4-48e833781b26\" :question/id #uuid \"b6f971f5-bfd8-5a38-88b4-48e833781b26\"] [:db/add \"b6f971f5-bfd8-5a38-88b4-48e833781b26\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2^{2 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"b6f971f5-bfd8-5a38-88b4-48e833781b26\" :question/worked-solution \"Let $u=2 - x^{3}$. Then $\\\\mathrm{d}u=(- 3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2^{2 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{3}\\\\left(\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(\\\\frac{2^{2 - x^{3}}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"b6f971f5-bfd8-5a38-88b4-48e833781b26\" :question/difficulty :question.difficulty/hard] [:db/add \"b6f971f5-bfd8-5a38-88b4-48e833781b26\" :question/answer-fields \"bc4c58f1-54f1-5fc4-afa2-c408278c98da\"] [:db/ensure \"b6f971f5-bfd8-5a38-88b4-48e833781b26\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"b6f971f5-bfd8-5a38-88b4-48e833781b26\"] [:db/add \"b4ea0e12-5465-5b19-b1c3-69ed9b030d83\" :answer/id #uuid \"b4ea0e12-5465-5b19-b1c3-69ed9b030d83\"] [:db/add \"b4ea0e12-5465-5b19-b1c3-69ed9b030d83\" :answer/type :answer.type/math] [:db/add \"b4ea0e12-5465-5b19-b1c3-69ed9b030d83\" :answer/value \"-1\\\\left(\\\\frac{5^{- x^{2}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\"] [:db/ensure \"b4ea0e12-5465-5b19-b1c3-69ed9b030d83\" :answer/validate] [:db/add \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\" :answer-field/id #uuid \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\"] [:db/add \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\" :answer-field/key \"answer\"] [:db/add \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\" :answer-field/type :answer-field.type/blank] [:db/add \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\" :answer-field/choices \"b4ea0e12-5465-5b19-b1c3-69ed9b030d83\"] [:db/add \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\" :answer-field/correct \"b4ea0e12-5465-5b19-b1c3-69ed9b030d83\"] [:db/ensure \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\" :answer-field/validate] [:db/add \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\" :question/id #uuid \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\"] [:db/add \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cdot 5^{- x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\" :question/worked-solution \"Let $u=- x^{2}$. Then $\\\\mathrm{d}u=(- 2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 5^{- x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=-1\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n-1\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=-1\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-1\\\\left(\\\\frac{5^{- x^{2}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\" :question/difficulty :question.difficulty/hard] [:db/add \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\" :question/answer-fields \"76853170-18de-5b8b-a761-5d3ce2a7c6e6\"] [:db/ensure \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"87ae6f03-f3fc-53f8-aa77-a7cb5f12f6bf\"] [:db/add \"eec4844d-544c-5a57-b89c-ee1bd78d81e0\" :answer/id #uuid \"eec4844d-544c-5a57-b89c-ee1bd78d81e0\"] [:db/add \"eec4844d-544c-5a57-b89c-ee1bd78d81e0\" :answer/type :answer.type/math] [:db/add \"eec4844d-544c-5a57-b89c-ee1bd78d81e0\" :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\frac{5^{2 - x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\"] [:db/ensure \"eec4844d-544c-5a57-b89c-ee1bd78d81e0\" :answer/validate] [:db/add \"765fc159-0cc3-5241-954f-661bc69482ee\" :answer-field/id #uuid \"765fc159-0cc3-5241-954f-661bc69482ee\"] [:db/add \"765fc159-0cc3-5241-954f-661bc69482ee\" :answer-field/key \"answer\"] [:db/add \"765fc159-0cc3-5241-954f-661bc69482ee\" :answer-field/type :answer-field.type/blank] [:db/add \"765fc159-0cc3-5241-954f-661bc69482ee\" :answer-field/choices \"eec4844d-544c-5a57-b89c-ee1bd78d81e0\"] [:db/add \"765fc159-0cc3-5241-954f-661bc69482ee\" :answer-field/correct \"eec4844d-544c-5a57-b89c-ee1bd78d81e0\"] [:db/ensure \"765fc159-0cc3-5241-954f-661bc69482ee\" :answer-field/validate] [:db/add \"06647049-685d-571a-8830-feba3fbdbb67\" :question/id #uuid \"06647049-685d-571a-8830-feba3fbdbb67\"] [:db/add \"06647049-685d-571a-8830-feba3fbdbb67\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cdot 5^{2 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"06647049-685d-571a-8830-feba3fbdbb67\" :question/worked-solution \"Let $u=2 - x^{3}$. Then $\\\\mathrm{d}u=(- 3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 5^{2 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{4}{3}\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{4}{3}\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{4}{3}\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{4}{3}\\\\left(\\\\frac{5^{2 - x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"06647049-685d-571a-8830-feba3fbdbb67\" :question/difficulty :question.difficulty/hard] [:db/add \"06647049-685d-571a-8830-feba3fbdbb67\" :question/answer-fields \"765fc159-0cc3-5241-954f-661bc69482ee\"] [:db/ensure \"06647049-685d-571a-8830-feba3fbdbb67\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"06647049-685d-571a-8830-feba3fbdbb67\"] [:db/add \"c545166b-1d76-505b-b7d9-e9459c34c7e2\" :answer/id #uuid \"c545166b-1d76-505b-b7d9-e9459c34c7e2\"] [:db/add \"c545166b-1d76-505b-b7d9-e9459c34c7e2\" :answer/type :answer.type/math] [:db/add \"c545166b-1d76-505b-b7d9-e9459c34c7e2\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\frac{2^{2 - 2 x^{2}}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)\"] [:db/ensure \"c545166b-1d76-505b-b7d9-e9459c34c7e2\" :answer/validate] [:db/add \"ae9a65ac-96b4-5969-b5e5-4564837f3391\" :answer-field/id #uuid \"ae9a65ac-96b4-5969-b5e5-4564837f3391\"] [:db/add \"ae9a65ac-96b4-5969-b5e5-4564837f3391\" :answer-field/key \"answer\"] [:db/add \"ae9a65ac-96b4-5969-b5e5-4564837f3391\" :answer-field/type :answer-field.type/blank] [:db/add \"ae9a65ac-96b4-5969-b5e5-4564837f3391\" :answer-field/choices \"c545166b-1d76-505b-b7d9-e9459c34c7e2\"] [:db/add \"ae9a65ac-96b4-5969-b5e5-4564837f3391\" :answer-field/correct \"c545166b-1d76-505b-b7d9-e9459c34c7e2\"] [:db/ensure \"ae9a65ac-96b4-5969-b5e5-4564837f3391\" :answer-field/validate] [:db/add \"70dba298-7422-5458-8ab4-5b44d9c092a1\" :question/id #uuid \"70dba298-7422-5458-8ab4-5b44d9c092a1\"] [:db/add \"70dba298-7422-5458-8ab4-5b44d9c092a1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2^{2 - 2 x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 2^{u}\\\\,\\\\mathrm{d}u=\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"70dba298-7422-5458-8ab4-5b44d9c092a1\" :question/worked-solution \"Let $u=2 - 2 x^{2}$. Then $\\\\mathrm{d}u=(- 4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2^{2 - 2 x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{4}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{4}\\\\left(\\\\frac{2^{u}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{4}\\\\left(\\\\frac{2^{2 - 2 x^{2}}}{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"70dba298-7422-5458-8ab4-5b44d9c092a1\" :question/difficulty :question.difficulty/hard] [:db/add \"70dba298-7422-5458-8ab4-5b44d9c092a1\" :question/answer-fields \"ae9a65ac-96b4-5969-b5e5-4564837f3391\"] [:db/ensure \"70dba298-7422-5458-8ab4-5b44d9c092a1\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"70dba298-7422-5458-8ab4-5b44d9c092a1\"] [:db/add \"c2ceb825-fa44-5854-b42e-3b4184148c8b\" :answer/id #uuid \"c2ceb825-fa44-5854-b42e-3b4184148c8b\"] [:db/add \"c2ceb825-fa44-5854-b42e-3b4184148c8b\" :answer/type :answer.type/math] [:db/add \"c2ceb825-fa44-5854-b42e-3b4184148c8b\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\frac{3^{3 - x^{3}}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\"] [:db/ensure \"c2ceb825-fa44-5854-b42e-3b4184148c8b\" :answer/validate] [:db/add \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\" :answer-field/id #uuid \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\"] [:db/add \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\" :answer-field/key \"answer\"] [:db/add \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\" :answer-field/type :answer-field.type/blank] [:db/add \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\" :answer-field/choices \"c2ceb825-fa44-5854-b42e-3b4184148c8b\"] [:db/add \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\" :answer-field/correct \"c2ceb825-fa44-5854-b42e-3b4184148c8b\"] [:db/ensure \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\" :answer-field/validate] [:db/add \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\" :question/id #uuid \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\"] [:db/add \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3^{3 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\" :question/worked-solution \"Let $u=3 - x^{3}$. Then $\\\\mathrm{d}u=(- 3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3^{3 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{3}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{1}{3}\\\\left(\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{1}{3}\\\\left(\\\\frac{3^{3 - x^{3}}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\" :question/difficulty :question.difficulty/hard] [:db/add \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\" :question/answer-fields \"296ceb5b-a82e-5fa6-ac3d-49a3a7ffbdea\"] [:db/ensure \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"a6da3891-a1bf-5b36-84a6-61bca0fd27e8\"] [:db/add \"d92e785f-be6e-5edb-803b-594831df6ef0\" :answer/id #uuid \"d92e785f-be6e-5edb-803b-594831df6ef0\"] [:db/add \"d92e785f-be6e-5edb-803b-594831df6ef0\" :answer/type :answer.type/math] [:db/add \"d92e785f-be6e-5edb-803b-594831df6ef0\" :answer/value \"-2\\\\left(\\\\frac{5^{3 - x^{2}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\"] [:db/ensure \"d92e785f-be6e-5edb-803b-594831df6ef0\" :answer/validate] [:db/add \"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/id #uuid \"7842f175-6d4c-5182-878c-36f5e545549f\"] [:db/add \"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/key \"answer\"] [:db/add \"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/type :answer-field.type/blank] [:db/add \"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/choices \"d92e785f-be6e-5edb-803b-594831df6ef0\"] [:db/add \"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/correct \"d92e785f-be6e-5edb-803b-594831df6ef0\"] [:db/ensure \"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/validate] [:db/add \"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/id #uuid \"b39b33a3-0868-5afa-a7f0-d6de0292d950\"] [:db/add \"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cdot 5^{3 - x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/worked-solution \"Let $u=3 - x^{2}$. Then $\\\\mathrm{d}u=(- 2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 5^{3 - x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n-2\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(\\\\frac{5^{3 - x^{2}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/difficulty :question.difficulty/hard] [:db/add \"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/answer-fields \"7842f175-6d4c-5182-878c-36f5e545549f\"] [:db/ensure \"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"b39b33a3-0868-5afa-a7f0-d6de0292d950\"] [:db/add \"076392ee-af04-5bac-8151-da7924a5e9c0\" :answer/id #uuid \"076392ee-af04-5bac-8151-da7924a5e9c0\"] [:db/add \"076392ee-af04-5bac-8151-da7924a5e9c0\" :answer/type :answer.type/math] [:db/add \"076392ee-af04-5bac-8151-da7924a5e9c0\" :answer/value \"-1\\\\left(\\\\frac{5^{3 - x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\"] [:db/ensure \"076392ee-af04-5bac-8151-da7924a5e9c0\" :answer/validate] [:db/add \"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/id #uuid \"effd18c6-c626-5ab5-abdb-d310ee13edec\"] [:db/add \"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/key \"answer\"] [:db/add \"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/type :answer-field.type/blank] [:db/add \"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/choices \"076392ee-af04-5bac-8151-da7924a5e9c0\"] [:db/add \"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/correct \"076392ee-af04-5bac-8151-da7924a5e9c0\"] [:db/ensure \"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/validate] [:db/add \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/id #uuid \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\"] [:db/add \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 5^{3 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/worked-solution \"Let $u=3 - x^{3}$. Then $\\\\mathrm{d}u=(- 3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 5^{3 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=-1\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n-1\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=-1\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-1\\\\left(\\\\frac{5^{3 - x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/difficulty :question.difficulty/hard] [:db/add \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/answer-fields \"effd18c6-c626-5ab5-abdb-d310ee13edec\"] [:db/ensure \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\"] [:db/add \"dcaa310f-8326-5080-8e3e-b4568c4cf444\" :answer/id #uuid \"dcaa310f-8326-5080-8e3e-b4568c4cf444\"] [:db/add \"dcaa310f-8326-5080-8e3e-b4568c4cf444\" :answer/type :answer.type/math] [:db/add \"dcaa310f-8326-5080-8e3e-b4568c4cf444\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\frac{3^{1 - x^{2}}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\"] [:db/ensure \"dcaa310f-8326-5080-8e3e-b4568c4cf444\" :answer/validate] [:db/add \"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/id #uuid \"6c03e948-09d4-5749-b96f-c7687dee5821\"] [:db/add \"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/key \"answer\"] [:db/add \"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/type :answer-field.type/blank] [:db/add \"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/choices \"dcaa310f-8326-5080-8e3e-b4568c4cf444\"] [:db/add \"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/correct \"dcaa310f-8326-5080-8e3e-b4568c4cf444\"] [:db/ensure \"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/validate] [:db/add \"4539d50f-3d44-5455-9d59-040acab24270\" :question/id #uuid \"4539d50f-3d44-5455-9d59-040acab24270\"] [:db/add \"4539d50f-3d44-5455-9d59-040acab24270\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 3^{1 - x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [:db/add \"4539d50f-3d44-5455-9d59-040acab24270\" :question/worked-solution \"Let $u=1 - x^{2}$. Then $\\\\mathrm{d}u=(- 2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 3^{1 - x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\frac{3^{1 - x^{2}}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\"] [:db/add \"4539d50f-3d44-5455-9d59-040acab24270\" :question/difficulty :question.difficulty/hard] [:db/add \"4539d50f-3d44-5455-9d59-040acab24270\" :question/answer-fields \"6c03e948-09d4-5749-b96f-c7687dee5821\"] [:db/ensure \"4539d50f-3d44-5455-9d59-040acab24270\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"4539d50f-3d44-5455-9d59-040acab24270\"] [:db/add \"generator\" :question-generator/id #uuid \"d0595ae0-7181-5603-8622-4d2532bb1de7\"] [:db/add \"generator\" :question-generator/script \"generators/3a/3af5bd1b5f4118b125fb4ac4c31f55dc2e834dacd37f32af014d314b5aa1c989/generator.py\"] [:db/add 17592186184350 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186184350 :knowledge-point/validate]] \"assertions\" [[\"29f97d0e-b489-5943-a850-920e63bceba3\" :answer/id #uuid \"29f97d0e-b489-5943-a850-920e63bceba3\"] [\"29f97d0e-b489-5943-a850-920e63bceba3\" :answer/type :answer.type/math] [\"29f97d0e-b489-5943-a850-920e63bceba3\" :answer/value \"\\\\int 2^{u}\\\\,\\\\mathrm{d}u\"] [\"c9daf45b-4e2b-5266-989f-12ca3656c434\" :answer/id #uuid \"c9daf45b-4e2b-5266-989f-12ca3656c434\"] [\"c9daf45b-4e2b-5266-989f-12ca3656c434\" :answer/type :answer.type/math] [\"c9daf45b-4e2b-5266-989f-12ca3656c434\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"10340ecf-68a9-5299-920b-3dfc40efc7ac\" :answer/id #uuid \"10340ecf-68a9-5299-920b-3dfc40efc7ac\"] [\"10340ecf-68a9-5299-920b-3dfc40efc7ac\" :answer/type :answer.type/math] [\"10340ecf-68a9-5299-920b-3dfc40efc7ac\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"878d46f0-46ba-526c-ae3e-d063e2c392b4\" :answer/id #uuid \"878d46f0-46ba-526c-ae3e-d063e2c392b4\"] [\"878d46f0-46ba-526c-ae3e-d063e2c392b4\" :answer/type :answer.type/math] [\"878d46f0-46ba-526c-ae3e-d063e2c392b4\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\" :answer/id #uuid \"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\"] [\"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\" :answer/type :answer.type/math] [\"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/id #uuid \"46259390-3467-5d90-82d3-5fa6678d6d96\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/key \"answer\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/type :answer-field.type/radio] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"29f97d0e-b489-5943-a850-920e63bceba3\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"c9daf45b-4e2b-5266-989f-12ca3656c434\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"10340ecf-68a9-5299-920b-3dfc40efc7ac\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"878d46f0-46ba-526c-ae3e-d063e2c392b4\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\"] [\"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/correct \"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\"] [\"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/id #uuid \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\"] [\"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/problem \"Use the substitution $u=x^{3} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 2^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\n$$\"] [\"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/worked-solution \"Let $u=x^{3} + 1$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/difficulty :question.difficulty/easy] [\"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/answer-fields \"46259390-3467-5d90-82d3-5fa6678d6d96\"] [17592186184350 :knowledge-point/questions \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\"] [\"e281ce08-0131-51d6-a0d8-8c509a6cbd49\" :answer/id #uuid \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\"] [\"e281ce08-0131-51d6-a0d8-8c509a6cbd49\" :answer/type :answer.type/math] [\"e281ce08-0131-51d6-a0d8-8c509a6cbd49\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"f2f8bde6-4bed-56c1-9745-570c90ab8919\" :answer/id #uuid \"f2f8bde6-4bed-56c1-9745-570c90ab8919\"] [\"f2f8bde6-4bed-56c1-9745-570c90ab8919\" :answer/type :answer.type/math] [\"f2f8bde6-4bed-56c1-9745-570c90ab8919\" :answer/value \"-1\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d586a789-45a6-5ddd-b622-e798dc56bdd9\" :answer/id #uuid \"d586a789-45a6-5ddd-b622-e798dc56bdd9\"] [\"d586a789-45a6-5ddd-b622-e798dc56bdd9\" :answer/type :answer.type/math] [\"d586a789-45a6-5ddd-b622-e798dc56bdd9\" :answer/value \"2\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"4d998eaf-3eea-5f43-9300-99e8494bae6a\" :answer/id #uuid \"4d998eaf-3eea-5f43-9300-99e8494bae6a\"] [\"4d998eaf-3eea-5f43-9300-99e8494bae6a\" :answer/type :answer.type/math] [\"4d998eaf-3eea-5f43-9300-99e8494bae6a\" :answer/value \"3\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c7a5d344-6128-5833-a516-634c829cdedb\" :answer/id #uuid \"c7a5d344-6128-5833-a516-634c829cdedb\"] [\"c7a5d344-6128-5833-a516-634c829cdedb\" :answer/type :answer.type/math] [\"c7a5d344-6128-5833-a516-634c829cdedb\" :answer/value \"\\\\int 2^{u}\\\\,\\\\mathrm{d}u\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/id #uuid \"e2853105-0d8e-55ff-8abc-e1424d739ed4\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/key \"answer\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/type :answer-field.type/radio] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"f2f8bde6-4bed-56c1-9745-570c90ab8919\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"d586a789-45a6-5ddd-b622-e798dc56bdd9\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"4d998eaf-3eea-5f43-9300-99e8494bae6a\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"c7a5d344-6128-5833-a516-634c829cdedb\"] [\"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/correct \"c7a5d344-6128-5833-a516-634c829cdedb\"] [\"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/id #uuid \"0c73de47-9713-5b6e-894c-3ed9be7df95c\"] [\"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/problem \"Use the substitution $u=x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cdot 2^{x^{2} + 1} x\\\\,\\\\mathrm{d}x\\n$$\"] [\"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 2^{x^{2} + 1} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 2^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int 2^{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/difficulty :question.difficulty/easy] [\"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/answer-fields \"e2853105-0d8e-55ff-8abc-e1424d739ed4\"] [17592186184350 :knowledge-point/questions \"0c73de47-9713-5b6e-894c-3ed9be7df95c\"] [\"323cf067-d1d7-51cf-9d21-fede2ffadecd\" :answer/id #uuid \"323cf067-d1d7-51cf-9d21-fede2ffadecd\"] [\"323cf067-d1d7-51cf-9d21-fede2ffadecd\" :answer/type :answer.type/math] [\"323cf067-d1d7-51cf-9d21-fede2ffadecd\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"83b8692d-e69f-5dea-a7b0-96dc18ab5347\" :answer/id #uuid \"83b8692d-e69f-5dea-a7b0-96dc18ab5347\"] [\"83b8692d-e69f-5dea-a7b0-96dc18ab5347\" :answer/type :answer.type/math] [\"83b8692d-e69f-5dea-a7b0-96dc18ab5347\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b17f220c-29c4-585a-b837-fa461fde177f\" :answer/id #uuid \"b17f220c-29c4-585a-b837-fa461fde177f\"] [\"b17f220c-29c4-585a-b837-fa461fde177f\" :answer/type :answer.type/math] [\"b17f220c-29c4-585a-b837-fa461fde177f\" :answer/value \"2\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"39d8ea54-29d0-516a-8819-68e06e377e7c\" :answer/id #uuid \"39d8ea54-29d0-516a-8819-68e06e377e7c\"] [\"39d8ea54-29d0-516a-8819-68e06e377e7c\" :answer/type :answer.type/math] [\"39d8ea54-29d0-516a-8819-68e06e377e7c\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"74ee9d68-7a8f-5680-9864-d7eaceba9950\" :answer/id #uuid \"74ee9d68-7a8f-5680-9864-d7eaceba9950\"] [\"74ee9d68-7a8f-5680-9864-d7eaceba9950\" :answer/type :answer.type/math] [\"74ee9d68-7a8f-5680-9864-d7eaceba9950\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/id #uuid \"2a8958d1-1d02-502b-a31c-fc969a33dbde\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/key \"answer\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/type :answer-field.type/radio] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/choices \"323cf067-d1d7-51cf-9d21-fede2ffadecd\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/choices \"83b8692d-e69f-5dea-a7b0-96dc18ab5347\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/choices \"b17f220c-29c4-585a-b837-fa461fde177f\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/choices \"39d8ea54-29d0-516a-8819-68e06e377e7c\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/choices \"74ee9d68-7a8f-5680-9864-d7eaceba9950\"] [\"2a8958d1-1d02-502b-a31c-fc969a33dbde\" :answer-field/correct \"74ee9d68-7a8f-5680-9864-d7eaceba9950\"] [\"81810515-55b9-58ea-b180-0529b901424c\" :question/id #uuid \"81810515-55b9-58ea-b180-0529b901424c\"] [\"81810515-55b9-58ea-b180-0529b901424c\" :question/problem \"Use the substitution $u=x^{3} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cdot 2^{x^{3} + 2} x^{2}\\\\,\\\\mathrm{d}x\\n$$\"] [\"81810515-55b9-58ea-b180-0529b901424c\" :question/worked-solution \"Let $u=x^{3} + 2$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 2^{x^{3} + 2} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"81810515-55b9-58ea-b180-0529b901424c\" :question/difficulty :question.difficulty/easy] [\"81810515-55b9-58ea-b180-0529b901424c\" :question/answer-fields \"2a8958d1-1d02-502b-a31c-fc969a33dbde\"] [17592186184350 :knowledge-point/questions \"81810515-55b9-58ea-b180-0529b901424c\"] [\"8392d39e-0623-5ca3-921c-c3c070e8d472\" :answer/id #uuid \"8392d39e-0623-5ca3-921c-c3c070e8d472\"] [\"8392d39e-0623-5ca3-921c-c3c070e8d472\" :answer/type :answer.type/math] [\"8392d39e-0623-5ca3-921c-c3c070e8d472\" :answer/value \"4\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"24605152-3313-5d1c-ad86-37ab9db26e75\" :answer/id #uuid \"24605152-3313-5d1c-ad86-37ab9db26e75\"] [\"24605152-3313-5d1c-ad86-37ab9db26e75\" :answer/type :answer.type/math] [\"24605152-3313-5d1c-ad86-37ab9db26e75\" :answer/value \"6\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"09008a5f-7a88-5d8b-a5d3-93555465849e\" :answer/id #uuid \"09008a5f-7a88-5d8b-a5d3-93555465849e\"] [\"09008a5f-7a88-5d8b-a5d3-93555465849e\" :answer/type :answer.type/math] [\"09008a5f-7a88-5d8b-a5d3-93555465849e\" :answer/value \"\\\\int 2^{u}\\\\,\\\\mathrm{d}u\"] [\"a299ba8b-1