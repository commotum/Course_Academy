}^{{x}^{3}/5}\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {5}^{u}\\\\cdot \\\\frac{5}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{3}\\\\int {5}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5\\\\cdot {5}^{u}}{3\\\\operatorname{ln}⁡5}+C \\\\\\\\  & =\\\\frac{5\\\\cdot {5}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡5}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186491376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5bb07ccc-8034-5c4b-9c4f-a44588698eab\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{2}^{{x}^{3}}}{\\\\operatorname{ln}⁡2}+C\" :db/id 17592186491359} {:answer/id #uuid \"60514391-5620-5b83-8c5e-0d6ffac83b98\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\cdot {2}^{{x}^{3}/5}}{5\\\\operatorname{ln}⁡2}+C\" :db/id 17592186491361} {:answer/id #uuid \"705ba99e-76f9-52ef-8124-bd34da0cfa3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{2}^{{x}^{3}/5}}{3}+C\" :db/id 17592186491364} {:answer/id #uuid \"85383204-c2b8-510b-a6b3-dfe74bac8eed\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {2}^{{x}^{3}}}{\\\\operatorname{ln}⁡2}+C\" :db/id 17592186491365} {:answer/id #uuid \"da9e1053-6e09-5623-a0c4-ed38aee3e576\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {2}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡2}+C\" :db/id 17592186491372}] :answer-field/correct {:answer/id #uuid \"da9e1053-6e09-5623-a0c4-ed38aee3e576\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {2}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡2}+C\" :db/id 17592186491372} :answer-field/id #uuid \"f1b3b773-ff7e-5998-9728-4d0014b66294\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186491374}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"fb1b384a-3ea9-5f5b-b12e-a748efe97478\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int {x}^{2}{2}^{{x}^{3}/5}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=\\\\frac{{x}^{3}}{5}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{3}{5}{x}^{2}\\\\,⟹\\\\,\\\\frac{5}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int {x}^{2}{2}^{{x}^{3}/5}\\\\,\\\\text{d}x & =\\\\int {2}^{{x}^{3}/5}\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {2}^{u}\\\\cdot \\\\frac{5}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{3}\\\\int {2}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5\\\\cdot {2}^{u}}{3\\\\operatorname{ln}⁡2}+C \\\\\\\\  & =\\\\frac{5\\\\cdot {2}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡2}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186608170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"113c19f5-5415-5431-84bb-4cf05ebd6c6a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{7}^{5{x}^{4}+8}}{5\\\\operatorname{ln}⁡7}+C\" :db/id 17592186607824} {:answer/id #uuid \"2a595b0f-122f-5451-8d3c-d1e8cacef3e4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\cdot {7}^{5{x}^{4}+8}}{5}+C\" :db/id 17592186607850} {:answer/id #uuid \"5e6a81ea-3140-5e52-a57e-05e4a60adfef\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{7}^{5{x}^{4}}}{5}+C\" :db/id 17592186607926} {:answer/id #uuid \"62550e05-21d7-50db-8138-abf338232253\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\cdot {7}^{5{x}^{4}+8}}{5\\\\operatorname{ln}⁡7}+C\" :db/id 17592186607930} {:answer/id #uuid \"c3fc81f4-70bb-5198-bc0d-c1e70bc1f967\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8\\\\cdot {7}^{5{x}^{4}}}{\\\\operatorname{ln}⁡7}+C\" :db/id 17592186608021}] :answer-field/correct {:answer/id #uuid \"62550e05-21d7-50db-8138-abf338232253\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\cdot {7}^{5{x}^{4}+8}}{5\\\\operatorname{ln}⁡7}+C\" :db/id 17592186607930} :answer-field/id #uuid \"6e9aa4a4-c345-5286-b5eb-c97194e23824\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186608114}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1818bb85-17b7-51ba-b931-5efa349f8316\" :question/math-academy-id \"q-211992\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 8{x}^{3}\\\\,{7}^{5{x}^{4}+8}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=5{x}^{4}+8.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=20{x}^{3}\\\\,⟹\\\\,\\\\frac{1}{20}\\\\text{d}u={x}^{3}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 8{x}^{3}\\\\,{7}^{5{x}^{4}+8}\\\\,\\\\text{d}x & =\\\\int 8\\\\cdot {7}^{5{x}^{4}+8}\\\\cdot {x}^{3}\\\\,\\\\text{d}x \\\\\\\\  & =8\\\\int {7}^{u}\\\\cdot \\\\frac{1}{20}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{2}{5}\\\\int {7}^{u}\\\\text{d}u \\\\\\\\  & =\\\\frac{2\\\\cdot {7}^{u}}{5\\\\operatorname{ln}⁡7}+C \\\\\\\\  & =\\\\frac{2\\\\cdot {7}^{5{x}^{4}+8}}{5\\\\operatorname{ln}⁡7}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186627673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3ceae246-ddc9-52cf-99e5-59f0daec5870\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4\\\\cdot {5}^{{x}^{3}+2}}{3}+C\" :db/id 17592186627197} {:answer/id #uuid \"687c3dd0-4fc6-50fa-ab70-401817a2e61f\" :answer/type {:db/ident :answer.type/math} :answer/value \"{5}^{{x}^{3}+2}+C\" :db/id 17592186627268} {:answer/id #uuid \"90bafda4-6440-52b0-8d32-a8aaa5d7dae2\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\cdot {5}^{{x}^{3}+2}+C\" :db/id 17592186627339} {:answer/id #uuid \"cc707316-601c-5cbb-a8e4-04ded1784607\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{5}^{{x}^{3}+2}}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186627443} {:answer/id #uuid \"de8b2383-24af-5d24-883f-7a1ca5eecfbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4\\\\cdot {5}^{{x}^{3}+2}}{3\\\\operatorname{ln}⁡5}+C\" :db/id 17592186627478}] :answer-field/correct {:answer/id #uuid \"de8b2383-24af-5d24-883f-7a1ca5eecfbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4\\\\cdot {5}^{{x}^{3}+2}}{3\\\\operatorname{ln}⁡5}+C\" :db/id 17592186627478} :answer-field/id #uuid \"c37601c0-e66f-561f-8cf6-38f0e022e93c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186627634}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2b5e4e83-5c83-5254-88d2-449ee63bd301\" :question/math-academy-id \"q-73799\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 4{x}^{2}{5}^{{x}^{3}+2}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={x}^{3}+2.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{x}^{2}\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 4{x}^{2}{5}^{{x}^{3}+2}\\\\,\\\\text{d}x & =\\\\int 4\\\\cdot {5}^{{x}^{3}+2}\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =4\\\\int {5}^{u}\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{4}{3}\\\\int {5}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{4}{3}\\\\frac{{5}^{u}}{\\\\operatorname{ln}⁡5}+C \\\\\\\\  & =\\\\frac{4\\\\cdot {5}^{{x}^{3}+2}}{3\\\\operatorname{ln}⁡5}+C.\\\\end{aligned}\\n$$\"}] :knowledge-point/title \"Integrating Products Containing Other Exponential Functions\"}",
