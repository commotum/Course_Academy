\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 2^{x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"56f265b3-c51c-5736-be8a-2f258d133062\" :question/difficulty :question.difficulty/easy] [:db/add \"56f265b3-c51c-5736-be8a-2f258d133062\" :question/answer-fields \"90cb2d66-c3ef-5d56-b2a6-552d7ed51116\"] [:db/ensure \"56f265b3-c51c-5736-be8a-2f258d133062\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"56f265b3-c51c-5736-be8a-2f258d133062\"] [:db/add \"c253efa8-f6ff-57c5-a379-a21582515fa5\" :answer/id #uuid \"c253efa8-f6ff-57c5-a379-a21582515fa5\"] [:db/add \"c253efa8-f6ff-57c5-a379-a21582515fa5\" :answer/type :answer.type/math] [:db/add \"c253efa8-f6ff-57c5-a379-a21582515fa5\" :answer/value \"2\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c253efa8-f6ff-57c5-a379-a21582515fa5\" :answer/validate] [:db/add \"7d0db079-9e82-5a8d-b482-4833ddae2e29\" :answer/id #uuid \"7d0db079-9e82-5a8d-b482-4833ddae2e29\"] [:db/add \"7d0db079-9e82-5a8d-b482-4833ddae2e29\" :answer/type :answer.type/math] [:db/add \"7d0db079-9e82-5a8d-b482-4833ddae2e29\" :answer/value \"-1\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"7d0db079-9e82-5a8d-b482-4833ddae2e29\" :answer/validate] [:db/add \"8ab472d9-dca8-5825-80fe-4036a57f38e4\" :answer/id #uuid \"8ab472d9-dca8-5825-80fe-4036a57f38e4\"] [:db/add \"8ab472d9-dca8-5825-80fe-4036a57f38e4\" :answer/type :answer.type/math] [:db/add \"8ab472d9-dca8-5825-80fe-4036a57f38e4\" :answer/value \"\\\\int 3^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"8ab472d9-dca8-5825-80fe-4036a57f38e4\" :answer/validate] [:db/add \"887295bd-91dc-554a-8484-d91feb9f4383\" :answer/id #uuid \"887295bd-91dc-554a-8484-d91feb9f4383\"] [:db/add \"887295bd-91dc-554a-8484-d91feb9f4383\" :answer/type :answer.type/math] [:db/add \"887295bd-91d