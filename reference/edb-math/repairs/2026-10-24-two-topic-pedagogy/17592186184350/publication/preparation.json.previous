                ":answer/value": "\\int 2^{u}\\,\\mathrm{d}u"
              },
              {
                ":answer/id": "c9daf45b-4e2b-5266-989f-12ca3656c434",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\frac{2}{3}\\left(\\int 2^{u}\\,\\mathrm{d}u\\right)"
              },
              {
                ":answer/id": "10340ecf-68a9-5299-920b-3dfc40efc7ac",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\frac{1}{6}\\left(\\int 2^{u}\\,\\mathrm{d}u\\right)"
              },
