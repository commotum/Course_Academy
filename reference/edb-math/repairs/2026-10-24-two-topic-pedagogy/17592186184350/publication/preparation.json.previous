-36f5e545549f\" :answer-field/id #uuid \"7842f175-6d4c-5182-878c-36f5e545549f\"] [\"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/key \"answer\"] [\"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/type :answer-field.type/blank] [\"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/choices \"d92e785f-be6e-5edb-803b-594831df6ef0\"] [\"7842f175-6d4c-5182-878c-36f5e545549f\" :answer-field/correct \"d92e785f-be6e-5edb-803b-594831df6ef0\"] [\"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/id #uuid \"b39b33a3-0868-5afa-a7f0-d6de0292d950\"] [\"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cdot 5^{3 - x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [\"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/worked-solution \"Let $u=3 - x^{2}$. Then $\\\\mathrm{d}u=(- 2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 5^{3 - x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n-2\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=-2\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-2\\\\left(\\\\frac{5^{3 - x^{2}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [\"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/difficulty :question.difficulty/hard] [\"b39b33a3-0868-5afa-a7f0-d6de0292d950\" :question/answer-fields \"7842f175-6d4c-5182-878c-36f5e545549f\"] [17592186184350 :knowledge-point/questions \"b39b33a3-0868-5afa-a7f0-d6de0292d950\"] [\"076392ee-af04-5bac-8151-da7924a5e9c0\" :answer/id #uuid \"076392ee-af04-5bac-8151-da7924a5e9c0\"] [\"076392ee-af04-5bac-8151-da7924a5e9c0\" :answer/type :answer.type/math] [\"076392ee-af04-5bac-8151-da7924a5e9c0\" :answer/value \"-1\\\\left(\\\\frac{5^{3 - x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)\"] [\"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/id #uuid \"effd18c6-c626-5ab5-abdb-d310ee13edec\"] [\"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/key \"answer\"] [\"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/type :answer-field.type/blank] [\"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/choices \"076392ee-af04-5bac-8151-da7924a5e9c0\"] [\"effd18c6-c626-5ab5-abdb-d310ee13edec\" :answer-field/correct \"076392ee-af04-5bac-8151-da7924a5e9c0\"] [\"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/id #uuid \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\"] [\"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 5^{3 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 5^{u}\\\\,\\\\mathrm{d}u=\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [\"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/worked-solution \"Let $u=3 - x^{3}$. Then $\\\\mathrm{d}u=(- 3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 5^{3 - x^{3}} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=-1\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n-1\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)=-1\\\\left(\\\\frac{5^{u}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n-1\\\\left(\\\\frac{5^{3 - x^{3}}}{\\\\ln{\\\\left(5 \\\\right)}}\\\\right)+C.\\n$$\"] [\"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/difficulty :question.difficulty/hard] [\"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\" :question/answer-fields \"effd18c6-c626-5ab5-abdb-d310ee13edec\"] [17592186184350 :knowledge-point/questions \"2995d103-b950-5bc7-adcb-7c2d2a9f93b7\"] [\"dcaa310f-8326-5080-8e3e-b4568c4cf444\" :answer/id #uuid \"dcaa310f-8326-5080-8e3e-b4568c4cf444\"] [\"dcaa310f-8326-5080-8e3e-b4568c4cf444\" :answer/type :answer.type/math] [\"dcaa310f-8326-5080-8e3e-b4568c4cf444\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\frac{3^{1 - x^{2}}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)\"] [\"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/id #uuid \"6c03e948-09d4-5749-b96f-c7687dee5821\"] [\"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/key \"answer\"] [\"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/type :answer-field.type/blank] [\"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/choices \"dcaa310f-8326-5080-8e3e-b4568c4cf444\"] [\"6c03e948-09d4-5749-b96f-c7687dee5821\" :answer-field/correct \"dcaa310f-8326-5080-8e3e-b4568c4cf444\"] [\"4539d50f-3d44-5455-9d59-040acab24270\" :question/id #uuid \"4539d50f-3d44-5455-9d59-040acab24270\"] [\"4539d50f-3d44-5455-9d59-040acab24270\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 3^{1 - x^{2}} x\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int 3^{u}\\\\,\\\\mathrm{d}u=\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}+C$.\\n\\n{{answer}} $+C$\"] [\"4539d50f-3d44-5455-9d59-040acab24270\" :question/worked-solution \"Let $u=1 - x^{2}$. Then $\\\\mathrm{d}u=(- 2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 3^{1 - x^{2}} x\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(\\\\frac{3^{u}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\frac{3^{1 - x^{2}}}{\\\\ln{\\\\left(3 \\\\right)}}\\\\right)+C.\\n$$\"] [\"4539d50f-3d44-5455-9d59-040acab24270\" :question/difficulty :question.difficulty/hard] [\"4539d50f-3d44-5455-9d59-040acab24270\" :question/answer-fields \"6c03e948-09d4-5749-b96f-c7687dee5821\"] [17592186184350 :knowledge-point/questions \"4539d50f-3d44-5455-9d59-040acab24270\"] [\"generator\" :question-generator/id #uuid \"d0595ae0-7181-5603-8622-4d2532bb1de7\"] [\"generator\" :question-generator/script \"generators/3a/3af5bd1b5f4118b125fb4ac4c31f55dc2e834dacd37f32af014d314b5aa1c989/generator.py\"] [17592186184350 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186184350 :knowledge-point/question-generator 17592186491378]]}",
