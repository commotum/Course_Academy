  "before_edn": "{:db/id 17592186184350 :knowledge-point/canonical-example {:db/id 17592186183946 :question/id #uuid \"ab4772a2-f980-5ad7-a377-34e34b95be83\" :question/math-academy-id \"e-14403\" :question/problem \"Calculate  $$\\n\\\\displaystyle \\\\int x^3\\\\,{3^{1-x^4}} \\\\, \\\\textrm{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u= 1-x^4.$ Differentiating gives \\n\\n$$\\n\\\\dfrac{ \\\\textrm{d}u}{ \\\\textrm{d}x} = -4x^3\\\\quad\\\\Longrightarrow\\\\quad x^3 \\\\, \\\\textrm{d}x = -\\\\dfrac{1}{4} \\\\textrm{d}u.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\n\\\\int {x^3\\\\,{3^{1-x^4}} }\\\\, \\\\textrm{d}x \\n&=\\\\int {{3^{1-x^4}}\\\\cdot x^3 }\\\\, \\\\textrm{d}x \\\\\\\\[5pt]\\n&=  \\\\int {3^{u}} \\\\cdot \\\\left(-\\\\dfrac{1}{4}\\\\right) \\\\textrm{d}u\\\\\\\\[5pt]\\n                                                     &= -\\\\dfrac{1}{4}\\\\int {3^{u}}  \\\\textrm{d}u\\\\\\\\[5pt]\\n                                                     &=  -\\\\dfrac{1}{4}\\\\cdot\\\\dfrac{3^{u}}{\\\\ln 3} + C\\\\\\\\[5pt]\\n                                                     &=   -\\\\dfrac{3^{1-x^4}}{4\\\\ln 3}+ C.\\n\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"e8720b44-317d-590e-a251-bfcec97e0513\" :knowledge-point/question-generator {:db/id 17592186491378 :question-generator/id #uuid \"7a978f74-e6d4-5d3c-8f0d-44b05004043d\" :question-generator/script \"generate/scratch/17592186184350.py\"} :knowledge-point/questions [{:db/id 17592186184746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"82507a0e-9640-5f91-baac-ab6e9c5da3e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{8}^{3x}}{2\\\\operatorname{ln}⁡8}+C\" :db/id 17592186295968} {:answer/id #uuid \"90098dd5-289f-547e-b363-0c0f0a9af66e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{8}^{3{x}^{2}}}{\\\\operatorname{ln}⁡8}+C\" :db/id 17592186296038} {:answer/id #uuid \"b0881961-d42a-52bd-baff-db91f2644d0f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{8}^{3{x}^{2}}}{3\\\\operatorname{ln}⁡8}+C\" :db/id 17592186296198} {:answer/id #uuid \"bd10d05c-0dcf-50d3-bed0-8065b29b1c8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{x{8}^{3{x}^{2}}}{6\\\\operatorname{ln}⁡8}+C\" :db/id 17592186296263} {:answer/id #uuid \"ddd37029-5f4f-5d4c-b32f-36f0f45b0933\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{8}^{3{x}^{2}}}{6\\\\operatorname{ln}⁡8}+C\" :db/id 17592186296446}] :answer-field/correct {:answer/id #uuid \"ddd37029-5f4f-5d4c-b32f-36f0f45b0933\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{8}^{3{x}^{2}}}{6\\\\operatorname{ln}⁡8}+C\" :db/id 17592186296446} :answer-field/id #uuid \"f130d306-f973-5ac4-a801-416349e0b6ad\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186297127}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a383a3e5-774c-580f-ac7a-6d64870e5f9c\" :question/math-academy-id \"q-31420\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int x{8}^{3{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=6x\\\\,⟹\\\\,\\\\frac{1}{6}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int x{8}^{3{x}^{2}}\\\\,\\\\text{d}x & =\\\\int {8}^{3{x}^{2}}\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {8}^{u}\\\\cdot \\\\frac{1}{6}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{6}\\\\int {8}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{6}\\\\frac{{8}^{u}}{\\\\operatorname{ln}⁡8}+C \\\\\\\\  & =\\\\frac{{8}^{3{x}^{2}}}{6\\\\operatorname{ln}⁡8}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186184837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9b629301-1067-56d3-ab58-ad1143497b16\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3^{x^{3} - 5}}{2} + C\" :db/id 17592186183632} {:answer/id #uuid \"c2980156-3e48-54e4-ace1-4a5f3a97bdce\" :answer/type {:db/ident :answer.type/math} :answer/value \"3^{x^{3} - 5} + C\" :db/id 17592186183633} {:answer/id #uuid \"c82dea64-4532-5248-a8cd-de11704b9a4f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3^{x^{3} - 5}}{2\\\\ln 3} + C\" :db/id 17592186183634} {:answer/id #uuid \"22ab9fe2-60bf-59f9-90a4-89daca871a10\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3^{x^{3} - 5}}{\\\\ln 3} + C\" :db/id 17592186183635} {:answer/id #uuid \"439eb146-c976-58e3-a26b-dfdd872160f4\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cdot 3^{x^{3} - 5} + C\" :db/id 17592186183636}] :answer-field/id #uuid \"2fbafaee-57dd-530a-9c31-0773ad8a574d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186183631}] :question/id #uuid \"33727dd7-f9f9-5003-bd0e-141b31536141\" :question/math-academy-id \"q-73800\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int3x^{2}3^{x^{3} - 5}dx.\\n$$\"} {:db/id 17592186290291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"24d80916-0404-5166-b211-35cc9c85ea75\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\cdot {4}^{{x}^{3}/5}}{5\\\\operatorname{ln}⁡4}+C\" :db/id 17592186288269} {:answer/id #uuid \"9b48c261-f211-55b8-86ce-65dbc47a6b39\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {4}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡4}+C\" :db/id 17592186289073} {:answer/id #uuid \"deb27d2c-63a6-52ee-ac61-ec19277096f7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {4}^{{x}^{3}}}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186289515} {:answer/id #uuid \"f5046e80-74ea-5ad4-b54f-ccc24450d88b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{{x}^{3}/5}}{3}+C\" :db/id 17592186289648} {:answer/id #uuid \"f886d5cc-86ed-56db-a712-3e62673c928c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{{x}^{3}}}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186289667}] :answer-field/correct {:answer/id #uuid \"9b48c261-f211-55b8-86ce-65dbc47a6b39\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {4}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡4}+C\" :db/id 17592186289073} :answer-field/id #uuid \"cfc2fad4-566e-5ad0-af33-b685357811ca\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186290183}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"75248609-ed60-597e-bc9d-cd586fbf6b38\" :question/math-academy-id \"q-211989\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int {x}^{2}{4}^{{x}^{3}/5}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=\\\\frac{{x}^{3}}{5}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{3}{5}{x}^{2}\\\\,⟹\\\\,\\\\frac{5}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int {x}^{2}{4}^{{x}^{3}/5}\\\\,\\\\text{d}x & =\\\\int {4}^{{x}^{3}/5}\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {4}^{u}\\\\cdot \\\\frac{5}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{3}\\\\int {4}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5\\\\cdot {4}^{u}}{3\\\\operatorname{ln}⁡4}+C \\\\\\\\  & =\\\\frac{5\\\\cdot {4}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡4}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186297397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"057e7928-c32f-5f0e-b954-8c6430e1e8a5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{x-7}}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295291} {:answer/id #uuid \"156c7585-0e2b-5c0b-a8c0-28e3ea36cf59\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{x}}{2\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295392} {:answer/id #uuid \"1cb5b38c-ddae-51cd-8c03-e4ec4201cdbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{{x}^{2}-7}}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295432} {:answer/id #uuid \"522139ab-1225-59a8-b925-e83a6e2f7dbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{{x}^{2}-7}}{2\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295740} {:answer/id #uuid \"f0d4c693-b699-5083-ad7a-ed14a75b3087\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{{x}^{2}-7}}{2}+C\" :db/id 17592186296550}] :answer-field/correct {:answer/id #uuid \"522139ab-1225-59a8-b925-e83a6e2f7dbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{{x}^{2}-7}}{2\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295740} :answer-field/id #uuid \"55ef16e6-ce51-5b7c-aff0-0e1c6f8cca5f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186296807}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e54cfe97-3d02-5434-8c76-88bdc2adef2f\" :question/math-academy-id \"q-31419\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int x{4}^{{x}^{2}-7}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2x\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int x{4}^{{x}^{2}-7}\\\\,\\\\text{d}x & =\\\\int {4}^{{x}^{2}-7}\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {4}^{u}\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int {4}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\frac{{4}^{u}}{\\\\operatorname{ln}⁡4}+C \\\\\\\\  & =\\\\frac{{4}^{{x}^{2}-7}}{2\\\\operatorname{ln}⁡4}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186297400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1a2879d8-7c7a-50fa-a612-2158a074303b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\cdot {5}^{{x}^{2}/3}}{2\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295421} {:answer/id #uuid \"446d6f6b-3937-5a63-b3fa-83e9d85f38f3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{5}^{{x}^{2}/3}}{2}+C\" :db/id 17592186295656} {:answer/id #uuid \"76b75909-b4b4-509c-a410-8f2a9a6cafa5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\cdot {5}^{{x}^{2}/3}}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295913} {:answer/id #uuid \"a3e05d5a-8a2d-52b3-a74e-3a98e8fe08e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{5}^{{x}^{2}/3}}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186296133} {:answer/id #uuid \"cc7dd1d7-0db0-5c37-a6d8-dc779ebf3dda\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{5}^{x/3}}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186296339}] :answer-field/correct {:answer/id #uuid \"1a2879d8-7c7a-50fa-a612-2158a074303b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\cdot {5}^{{x}^{2}/3}}{2\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295421} :answer-field/id #uuid \"ec80f516-12d7-555c-b58d-0e0f793ebad4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186297117}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"bfc6c174-e76b-5577-8587-521bdbb4edc5\" :question/math-academy-id \"q-31426\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int x{5}^{{x}^{2}/3}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=\\\\frac{{x}^{2}}{3}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{2}{3}x\\\\,⟹\\\\,\\\\frac{3}{2}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int x{5}^{{x}^{2}/3}\\\\,\\\\text{d}x & =\\\\int {5}^{{x}^{2}/3}\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {5}^{u}\\\\cdot \\\\frac{3}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{2}\\\\int {5}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{2}\\\\frac{{5}^{u}}{\\\\operatorname{ln}⁡5}+C \\\\\\\\  & =\\\\frac{3\\\\cdot {5}^{{x}^{2}/3}}{2\\\\operatorname{ln}⁡5}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186342056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0e30d1c9-379a-579c-a3a5-a5bee4fb3754\" :answer/type {:db/ident :answer.type/math} :answer/value \"{4}^{4{x}^{2}-3}\\\\,\\\\operatorname{ln}⁡4+C\" :db/id 17592186339258} {:answer/id #uuid \"0f04899b-0ec3-50a1-be7a-dcc395b2881d\" :answer/type {:db/ident :answer.type/math} :answer/value \"{4}^{4{x}^{2}-3}+C\" :db/id 17592186339266} {:answer/id #uuid \"255a6113-656c-50d6-9c14-04c4c94f677f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\cdot {4}^{4{x}^{2}-3}}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186339447} {:answer/id #uuid \"2db15ac2-80e1-5699-9d1b-fd00eadf4537\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{4{x}^{2}-3}}{4\\\\operatorname{ln}⁡4}+C\" :db/id 17592186339528} {:answer/id #uuid \"ab0fc374-fdda-59a9-a595-b90087a31ae8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{4{x}^{2}-3}}{2\\\\operatorname{ln}⁡4}+C\" :db/id 17592186340685}] :answer-field/correct {:answer/id #uuid \"ab0fc374-fdda-59a9-a595-b90087a31ae8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{4}^{4{x}^{2}-3}}{2\\\\operatorname{ln}⁡4}+C\" :db/id 17592186340685} :answer-field/id #uuid \"aca77093-9c05-5c96-8ed6-aadc73e8ac2a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341681}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"d173a2c0-da03-5423-8e61-e66122941f23\" :question/math-academy-id \"q-73665\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 4x\\\\,{4}^{4{x}^{2}-3}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=4{x}^{2}-3.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=8x\\\\,⟹\\\\,\\\\frac{1}{8}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 4x\\\\,{4}^{4{x}^{2}-3}\\\\,\\\\text{d}x & =4\\\\int {4}^{4{x}^{2}-3}\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =4\\\\int {4}^{u}\\\\cdot \\\\frac{1}{8}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int {4}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{{4}^{u}}{2\\\\operatorname{ln}⁡4}+C \\\\\\\\  & =\\\\frac{{4}^{4{x}^{2}-3}}{2\\\\operatorname{ln}⁡4}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186342085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"44e44bb8-c154-53e8-a511-57d84dae10f6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{6}^{{x}^{2}+1}}{6}+C\" :db/id 17592186339739} {:answer/id #uuid \"a32f3101-bc9b-57c3-a094-68929983f9ba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{6}^{{x}^{2}+1}}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186340607} {:answer/id #uuid \"a81c8c34-1552-582a-811d-a1514ffd778a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{6}^{{x}^{2}+1}\\\\operatorname{ln}⁡6}{3}+C\" :db/id 17592186340653} {:answer/id #uuid \"d5de34d6-565f-582f-8f9b-77b59f891653\" :answer/type {:db/ident :answer.type/math} :answer/value \"{6}^{{x}^{2}+1}+C\" :db/id 17592186341022} {:answer/id #uuid \"ed24b164-7ced-54c2-88e8-5774ba6fa797\" :answer/type {:db/ident :answer.type/math} :answer/value \"{6}^{{x}^{2}+1}\\\\operatorname{ln}⁡3+C\" :db/id 17592186341220}] :answer-field/correct {:answer/id #uuid \"a32f3101-bc9b-57c3-a094-68929983f9ba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{6}^{{x}^{2}+1}}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186340607} :answer-field/id #uuid \"7d2b52af-df96-5841-9a6f-c75d274f62bf\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341599}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a36ba9a8-67c3-5fc7-baaa-4765eb971f95\" :question/math-academy-id \"q-73801\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 2x{6}^{{x}^{2}+1}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={x}^{2}+1.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2x\\\\,⟹\\\\,\\\\text{d}u=2x\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 2x{6}^{{x}^{2}+1}\\\\,\\\\text{d}x & =\\\\int {6}^{{x}^{2}+1}\\\\cdot 2x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {6}^{u}\\\\cdot \\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{{6}^{u}}{\\\\operatorname{ln}⁡6}+C \\\\\\\\  & =\\\\frac{{6}^{{x}^{2}+1}}{\\\\operatorname{ln}⁡6}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186342086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5a820745-fb0e-5679-b09e-f71dc31ac02a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\cdot {7}^{{x}^{2}-7}}{\\\\operatorname{ln}⁡7}+C\" :db/id 17592186339950} {:answer/id #uuid \"7fe72d04-d6a6-5411-990c-4da6836f38f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{7}^{{x}^{2}-7}}{2\\\\operatorname{ln}⁡7}+C\" :db/id 17592186340278} {:answer/id #uuid \"b52e44f1-74c6-506f-ab6c-8cfe82910425\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{7}^{{x}^{2}-7}\\\\operatorname{ln}⁡7}{2}+C\" :db/id 17592186340770} {:answer/id #uuid \"bffaf345-ce46-5b75-9f16-7441a4de004a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{7}^{{x}^{2}-7}}{2}+C\" :db/id 17592186340843} {:answer/id #uuid \"da447b58-addd-5846-8570-a5a39fd42ee5\" :answer/type {:db/ident :answer.type/math} :answer/value \"{7}^{{x}^{2}-7}+C\" :db/id 17592186341066}] :answer-field/correct {:answer/id #uuid \"7fe72d04-d6a6-5411-990c-4da6836f38f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{7}^{{x}^{2}-7}}{2\\\\operatorname{ln}⁡7}+C\" :db/id 17592186340278} :answer-field/id #uuid \"a80209d1-f637-5f60-b158-7892c3b85b26\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341672}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"202ad664-ec55-5adf-8b56-f5a9d840cb98\" :question/math-academy-id \"q-73802\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int x{7}^{{x}^{2}-7}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2x\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int x{7}^{{x}^{2}-7}\\\\,\\\\text{d}x & =\\\\int {7}^{{x}^{2}-7}\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {7}^{u}\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int {7}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\frac{{7}^{u}}{\\\\operatorname{ln}⁡7}+C \\\\\\\\  & =\\\\frac{{7}^{{x}^{2}-7}}{2\\\\operatorname{ln}⁡7}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186491366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1ae8d185-b4e6-5b45-af05-53694230da44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\cdot {6}^{{x}^{3}/5}}{5\\\\operatorname{ln}⁡6}+C\" :db/id 17592186491351} {:answer/id #uuid \"1e1b677f-fd02-5804-bcf2-39e010ec4ba3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {6}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡6}+C\" :db/id 17592186491352} {:answer/id #uuid \"3df2f4a4-0061-5e59-bc97-c3146e959360\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{6}^{{x}^{3}}}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186491355} {:answer/id #uuid \"c9c737ea-da84-5ba1-8445-d21d46327c2c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{6}^{{x}^{3}/5}}{3}+C\" :db/id 17592186491369} {:answer/id #uuid \"e993c8ae-6438-5f06-a1c2-4285e9a689b7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {6}^{{x}^{3}}}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186491373}] :answer-field/correct {:answer/id #uuid \"1e1b677f-fd02-5804-bcf2-39e010ec4ba3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {6}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡6}+C\" :db/id 17592186491352} :answer-field/id #uuid \"47eb7db3-acc4-58bb-8608-68c408bd0385\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186491356}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9b628f87-c642-53b2-a35d-dc7358bbfdba\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int {x}^{2}{6}^{{x}^{3}/5}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=\\\\frac{{x}^{3}}{5}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{3}{5}{x}^{2}\\\\,⟹\\\\,\\\\frac{5}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int {x}^{2}{6}^{{x}^{3}/5}\\\\,\\\\text{d}x & =\\\\int {6}^{{x}^{3}/5}\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {6}^{u}\\\\cdot \\\\frac{5}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{3}\\\\int {6}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5\\\\cdot {6}^{u}}{3\\\\operatorname{ln}⁡6}+C \\\\\\\\  & =\\\\frac{5\\\\cdot {6}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡6}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186491371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2689d407-b309-52d8-bb92-e6845cfba684\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{3}^{{x}^{3}}}{\\\\operatorname{ln}⁡3}+C\" :db/id 17592186491353} {:answer/id #uuid \"3873eb8d-4fec-5ca2-ac3e-e0e204840572\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {3}^{{x}^{3}}}{\\\\operatorname{ln}⁡3}+C\" :db/id 17592186491354} {:answer/id #uuid \"4f0d41d9-8560-51ef-af23-f55274c6e6e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {3}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡3}+C\" :db/id 17592186491357} {:answer/id #uuid \"5ae33479-9282-5e69-9eee-2456ebf514d1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{3}^{{x}^{3}/5}}{3}+C\" :db/id 17592186491358} {:answer/id #uuid \"67aac076-adef-50f3-a3d9-219048ee2389\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\cdot {3}^{{x}^{3}/5}}{5\\\\operatorname{ln}⁡3}+C\" :db/id 17592186491362}] :answer-field/correct {:answer/id #uuid \"4f0d41d9-8560-51ef-af23-f55274c6e6e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\cdot {3}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡3}+C\" :db/id 17592186491357} :answer-field/id #uuid \"d29e4d44-69c9-571b-8dd4-9a0cbc7d5998\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186491370}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"d4c4ed5a-84f3-5650-a7ac-dc968511cf7a\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int {x}^{2}{3}^{{x}^{3}/5}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=\\\\frac{{x}^{3}}{5}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{3}{5}{x}^{2}\\\\,⟹\\\\,\\\\frac{5}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int {x}^{2}{3}^{{x}^{3}/5}\\\\,\\\\text{d}x & =\\\\int {3}^{{x}^{3}/5}\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {3}^{u}\\\\cdot \\\\frac{5}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{3}\\\\int {3}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5\\\\cdot {3}^{u}}{3\\\\operatorname{ln}⁡3}+C \\\\\\\\  & =\\\\frac{5\\\\cdot {3}^{{x}^{3}/5}}{3\\\\operatorname{ln}⁡3}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186491375 :question/answer-fields [{:answ