                ":answer/type": ":answer.type/math",
                ":answer/value": "\\frac{5^{x^{2} + 2}}{\\ln{\\left(5 \\right)}}"
              }
            ],
            ":answer-field/correct": [
              ":answer/id",
              "ac108f71-110d-5def-a988-7adf10aad264"
            ]
          }
        ]
      },
