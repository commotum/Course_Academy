ces \"d16b3564-f8b9-529a-83e2-aecdeb0e7d8e\"] [\"36170193-0701-5267-8518-2a08d460964f\" :answer-field/choices \"faa93787-c135-592d-8ad9-42cd7970d931\"] [\"36170193-0701-5267-8518-2a08d460964f\" :answer-field/correct \"d16b3564-f8b9-529a-83e2-aecdeb0e7d8e\"] [\"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/id #uuid \"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\"] [\"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/problem \"Use the substitution $u=x^{2} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 3^{x^{2} + 2} x\\\\,\\\\mathrm{d}x\\n$$\"] [\"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/worked-solution \"Let $u=x^{2} + 2$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 3^{x^{2} + 2} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int 3^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/difficulty :question.difficulty/easy] [\"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\" :question/answer-fields \"36170193-0701-5267-8518-2a08d460964f\"] [17592186184350 :knowledge-point/questions \"95fbb44b-38e7-5ad0-a254-d785c1d5b1bd\"] [\"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\" :answer/id #uuid \"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\"] [\"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\" :answer/type :answer.type/math] [\"45e6363f-d2c8-52ff-9e3b-14e9b8abcce6\" :answer/value \"3\\\\left(\\\\int 5^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"27b97f13-b399-50c8-a3d5-d275c073b91e\" :answer/id #uuid \"27b97f13-b399-50c8-a3d5-d275c073b91e\"] [\"27b97f13-b399-50c8-a3d5-d275c073b91e\" :answer/type :answer.type/math] [\"27b97f13-b399-50c8-a3d5-d275c073b91e\" :answer/value \"\\\\int 5^{u}\\\\,\\\\mathrm{d}u\"] [\"da31f811-7d84-55ce-90a0-e2c88c2aac17\" :answer/id #uuid \"da31f811-7d84-55ce-90a0-e2c88c2aac17\"] [\"da31f811-7d84-55