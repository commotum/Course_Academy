validate] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/id #uuid \"46259390-3467-5d90-82d3-5fa6678d6d96\"] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/key \"answer\"] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/type :answer-field.type/radio] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"29f97d0e-b489-5943-a850-920e63bceba3\"] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"c9daf45b-4e2b-5266-989f-12ca3656c434\"] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"10340ecf-68a9-5299-920b-3dfc40efc7ac\"] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"878d46f0-46ba-526c-ae3e-d063e2c392b4\"] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/choices \"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\"] [:db/add \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/correct \"eb5ae8fd-d9a5-5210-b28f-313bc56352bd\"] [:db/ensure \"46259390-3467-5d90-82d3-5fa6678d6d96\" :answer-field/validate] [:db/add \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/id #uuid \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\"] [:db/add \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/problem \"Use the substitution $u=x^{3} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 2^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/worked-solution \"Let $u=x^{3} + 1$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2^{x^{3} + 1} x^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/difficulty :question.difficulty/easy] [:db/add \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/answer-fields \"46259390-3467-5d90-82d3-5fa6678d6d96\"] [:db/ensure \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"c86eaeec-6ebb-5ca2-b873-ed22e534b43c\"] [:db/add \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\" :answer/id #uuid \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\"] [:db/add \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\" :answer/type :answer.type/math] [:db/add \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\" :answer/validate] [:db/add \"f2f8bde6-4bed-56c1-9745-570c90ab8919\" :answer/id #uuid \"f2f8bde6-4bed-56c1-9745-570c90ab8919\"] [:db/add \"f2f8bde6-4bed-56c1-9745-570c90ab8919\" :answer/type :answer.type/math] [:db/add \"f2f8bde6-4bed-56c1-9745-570c90ab8919\" :answer/value \"-1\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f2f8bde6-4bed-56c1-9745-570c90ab8919\" :answer/validate] [:db/add \"d586a789-45a6-5ddd-b622-e798dc56bdd9\" :answer/id #uuid \"d586a789-45a6-5ddd-b622-e798dc56bdd9\"] [:db/add \"d586a789-45a6-5ddd-b622-e798dc56bdd9\" :answer/type :answer.type/math] [:db/add \"d586a789-45a6-5ddd-b622-e798dc56bdd9\" :answer/value \"2\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d586a789-45a6-5ddd-b622-e798dc56bdd9\" :answer/validate] [:db/add \"4d998eaf-3eea-5f43-9300-99e8494bae6a\" :answer/id #uuid \"4d998eaf-3eea-5f43-9300-99e8494bae6a\"] [:db/add \"4d998eaf-3eea-5f43-9300-99e8494bae6a\" :answer/type :answer.type/math] [:db/add \"4d998eaf-3eea-5f43-9300-99e8494bae6a\" :answer/value \"3\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"4d998eaf-3eea-5f43-9300-99e8494bae6a\" :answer/validate] [:db/add \"c7a5d344-6128-5833-a516-634c829cdedb\" :answer/id #uuid \"c7a5d344-6128-5833-a516-634c829cdedb\"] [:db/add \"c7a5d344-6128-5833-a516-634c829cdedb\" :answer/type :answer.type/math] [:db/add \"c7a5d344-6128-5833-a516-634c829cdedb\" :answer/value \"\\\\int 2^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"c7a5d344-6128-5833-a516-634c829cdedb\" :answer/validate] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/id #uuid \"e2853105-0d8e-55ff-8abc-e1424d739ed4\"] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/key \"answer\"] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/type :answer-field.type/radio] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"e281ce08-0131-51d6-a0d8-8c509a6cbd49\"] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"f2f8bde6-4bed-56c1-9745-570c90ab8919\"] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"d586a789-45a6-5ddd-b622-e798dc56bdd9\"] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"4d998eaf-3eea-5f43-9300-99e8494bae6a\"] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/choices \"c7a5d344-6128-5833-a516-634c829cdedb\"] [:db/add \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/correct \"c7a5d344-6128-5833-a516-634c829cdedb\"] [:db/ensure \"e2853105-0d8e-55ff-8abc-e1424d739ed4\" :answer-field/validate] [:db/add \"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/id #uuid \"0c73de47-9713-5b6e-894c-3ed9be7df95c\"] [:db/add \"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/problem \"Use the substitution $u=x^{2} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cdot 2^{x^{2} + 1} x\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 2^{x^{2} + 1} x\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int 2^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int 2^{u}\\\\,\\\\mathrm{d}u.\\n$$\"] [:db/add \"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/difficulty :question.difficulty/easy] [:db/add \"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/answer-fields \"e2853105-0d8e-55ff-8abc-e1424d739ed4\"] [:db/ensure \"0c73de47-9713-5b6e-894c-3ed9be7df95c\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"0c73de47-9713-5b6e-894c-3ed9be7df95c\"] [:db/add \"323cf067-d1d7-51cf-9d21-fede2ffadecd\" :answer/id #uuid \"323cf067-d1d7-51cf-9d21-fede2ffadecd\"] [:db/add \"323cf067-d1d7-51cf-9d21-fede2ffadecd\" :answer/type :answer.type/math] [:db/add \"323cf067-d1d7-51cf-9d21-fede2ffadecd\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"323cf067-d1d7-51cf-9d21-fede2ffadecd\" :answer/validate] [:db/add \"83b8692d-e69f-5dea-a7b0-96dc18ab5347\" :answer/id #uuid \"83b8692d-e69f-5dea-a7b0-96dc18ab5347\"] [:db/add \"83b8692d-e69f-5dea-a7b0-96dc18ab5347\" :answer/type :answer.type/math] [:db/add \"83b8692d-e69f-5dea-a7b0-96dc18ab5347\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"83b8692d-e69f-5dea-a7b0-96dc18ab5347\" :answer/validate] [:db/add \"b17f220c-29c4-585a-b837-fa461fde177f\" :answer/id #uuid \"b17f220c-29c4-585a-b837-fa461fde177f\"] [:db/add \"b17f220c-29c4-585a-b837-fa461fde177f\" :answer/type :answer.type/math] [:db/add \"b17f220c-29c4-585a-b837-fa461fde177f\" :answer/value \"2\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b17f220c-29c4-585a-b837-fa461fde177f\" :answer/validate] [:db/add \"39d8ea54-29d0-516a-8819-68e06e377e7c\" :answer/id #uuid \"39d8ea54-29d0-516a-8819-68e06e377e7c\"] [:db/add \"39d8ea54-29d0-516a-8819-68e06e377e7c\" :answer/type :answer.type/math] [:db/add \"39d8ea54-29d0-516a-8819-68e06e377e7c\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"39d8ea54-29d0-516a-8819-68e06e377e7c\" :answer/validate] [:db/add \"74ee9d68-7a8f-5680-9864-d7eaceba9950\" :answer/id #uuid \"74ee9d68-7a8f-5680-9864-d7eaceba99