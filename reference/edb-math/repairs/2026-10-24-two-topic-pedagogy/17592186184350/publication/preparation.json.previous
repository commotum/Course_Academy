\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"81810515-55b9-58ea-b180-0529b901424c\" :question/difficulty :question.difficulty/easy] [:db/add \"81810515-55b9-58ea-b180-0529b901424c\" :question/answer-fields \"2a8958d1-1d02-502b-a31c-fc969a33dbde\"] [:db/ensure \"81810515-55b9-58ea-b180-0529b901424c\" :question/validate] [:db/add 17592186184350 :knowledge-point/questions \"81810515-55b9-58ea-b180-0529b901424c\"] [:db/add \"8392d39e-0623-5ca3-921c-c3c070e8d472\" :answer/id #uuid \"8392d39e-0623-5ca3-921c-c3c070e8d472\"] [:db/add \"8392d39e-0623-5ca3-921c-c3c070e8d472\" :answer/type :answer.type/math] [:db/add \"8392d39e-0623-5ca3-921c-c3c070e8d472\" :answer/value \"4\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"8392d39e-0623-5ca3-921c-c3c070e8d472\" :answer/validate] [:db/add \"24605152-3313-5d1c-ad86-37ab9db26e75\" :answer/id #uuid \"24605152-3313-5d1c-ad86-37ab9db26e75\"] [:db/add \"24605152-3313-5d1c-ad86-37ab9db26e75\" :answer/type :answer.type/math] [:db/add \"24605152-3313-5d1c-ad86-37ab9db26e75\" :answer/value \"6\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"24605152-3313-5d1c-ad86-37ab9db26e75\" :answer/validate] [:db/add \"09008a5f-7a88-5d8b-a5d3-93555465849e\" :answer/id #uuid \"09008a5f-7a88-5d8b-a5d3-93555465849e\"] [:db/add \"09008a5f-7a88-5d8b-a5d3-93555465849e\" :answer/type :answer.type/math] [:db/add \"09008a5f-7a88-5d8b-a5d3-93555465849e\" :answer/value \"\\\\int 2^{u}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"09008a5f-7a88-5d8b-a5d3-93555465849e\" :answer/validate] [:db/add \"a299ba8b-18ee-5c25-84c3-dd78854f3599\" :answer/id #uuid \"a299ba8b-18ee-5c25-84c3-dd78854f3599\"] [:db/add \"a299ba8b-18ee-5c25-84c3-dd78854f3599\" :answer/type :answer.type/math] [:db/add \"a299ba8b-18ee-5c25-84c3-dd78854f3599\" :answer/value \"-2\\\\left(\\\\int 2^{u}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure 