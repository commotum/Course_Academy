d "57c43d75-4152-5819-a024-e6df0b92b572" :question/difficulty :question.difficulty/moderate] [:db/add "57c43d75-4152-5819-a024-e6df0b92b572" :question/answer-fields "7baf5f93-ef37-5cff-bc22-0299a3588633"] [:db/ensure "57c43d75-4152-5819-a024-e6df0b92b572" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "57c43d75-4152-5819-a024-e6df0b92b572"] [:db/add "c5db4d26-6b07-50a2-a7d0-f4f9c837d42c" :answer/id #uuid "c5db4d26-6b07-50a2-a7d0-f4f9c837d42c"] [:db/add "c5db4d26-6b07-50a2-a7d0-f4f9c837d42c" :answer/type :answer.type/math] [:db/add "c5db4d26-6b07-50a2-a7d0-f4f9c837d42c" :answer/value "\\frac{2^{2 x^{2} + 3}}{\\ln{\\left(2 \\right)}}"] [:db/ensure "c5db4d26-6b07-50a2-a7d0-f4f9c837d42c" :answer/validate] [:db/add "cff1a0bb-671b-5be7-84ec-d2b33702ef46" :answer-field/id #uuid "cff1a0bb-671b-5be7-84ec-d2b33702ef46"] [:db/add "cff1a0bb-671b-5be7-84ec-d2b33702ef46" :answer-field/key "answer"] [:db/add "cff1a0bb-671b-5be7-84ec-d2b33702ef46" :answer-field/type :answer-field.type/blank] [:db/add "cff1a0bb-671b-5be7-84ec-d2b33702ef46" :answer-field/choices "c5db4d26-6b07-50a2-a7d0-f4f9c837d42c"] [:db/add "cff1a0bb-671b-5be7-84ec-d2b33702ef46" :answer-field/correct "c5db4d26-6b07-50a2-a7d0-f4f9c837d42c"] [:db/ensure "cff1a0bb-671b-5be7-84ec-d2b33702ef46" :answer-field/validate] [:db/add "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2" :question/id #uuid "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2"] [:db/add "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cdot 2^{2 x^{2} + 3} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}} $+C$"] [:db/add "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2" :question/worked-solution "Let $u=2 x^{2} + 3$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cdot 2^{2 x^{2} + 3} x\\,\\mathrm{d}x\\\\&=\\int 2^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2^{2 x^{2} + 3}}{\\ln{\\left(2 \\right)}}+C.\n$$"] [:db/add "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2" :question/difficulty :question.difficulty/moderate] [:db/add "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2" :question/answer-fields "cff1a0bb-671b-5be7-84ec-d2b33702ef46"] [:db/ensure "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "fba4c2e2-2d31-5ed7-ae9c-3ba3a86c39e2"] [:db/add "e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2" :answer/id #uuid "e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2"] [:db/add "e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2" :answer/type :answer.type/math] [:db/add "e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2" :answer/value "\\frac{2^{x^{3} + 1}}{\\ln{\\left(2 \\right)}}"] [:db/ensure "e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2" :answer/validate] [:db/add "bf71755d-a0d3-57b5-8763-4ac8ad145139" :answer-field/id #uuid "bf71755d-a0d3-57b5-8763-4ac8ad145139"] [:db/add "bf71755d-a0d3-57b5-8763-4ac8ad145139" :answer-field/key "answer"] [:db/add "bf71755d-a0d3-57b5-8763-4ac8ad145139" :answer-field/type :answer-field.type/blank] [:db/add "bf71755d-a0d3-57b5-8763-4ac8ad145139" :answer-field/choices "e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2"] [:db/add "bf71755d-a0d3-57b5-8763-4ac8ad145139" :answer-field/correct "e2e9119d-3159-5ec4-8ead-e9dfd6a1caf2"] [:db/ensure "bf71755d-a0d3-57b5-8763-4ac8ad145139" :answer-field/validate] [:db/add "359d40d4-2220-5366-a978-a9a9a350a0f2" :question/id #uuid "359d40d4-2220-5366-a978-a9a9a350a0f2"] [:db/add "359d40d4-2220-5366-a978-a9a9a350a0f2" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 \\cdot 2^{x^{3} + 1} x^{2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}} $+C$"] [:db/add "359d40d4-2220-5366-a978-a9a9a350a0f2" :question/worked-solution "Let $u=x^{3} + 1$. Then $\\mathrm{d}u=(3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 \\cdot 2^{x^{3} + 1} x^{2}\\,\\mathrm{d}x\\\\&=\\int 2^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2^{x^{3} + 1}}{\\ln{\\left(2 \\right)}}+C.\n$$"] [:db/add "359d40d4-2220-5366-a978-a9a9a350a0f2" :question/difficulty :question.difficulty/moderate] [:db/add "359d40d4-2220-5366-a978-a9a9a350a0f2" :question/answer-fields "bf71755d-a0d3-57b5-8763-4ac8ad145139"] [:db/ensure "359d40d4-2220-5366-a978-a9a9a350a0f2" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "359d40d4-2220-5366-a978-a9a9a350a0f2"] [:db/add "40a6b836-8b7b-5337-8d7d-1d88337396c5" :answer/id #uuid "40a6b836-8b7b-5337-8d7d-1d88337396c5"] [:db/add "40a6b836-8b7b-5337-8d7d-1d88337396c5" :answer/type :answer.type/math] [:db/add "40a6b836-8b7b-5337-8d7d-1d88337396c5" :answer/value "\\frac{1}{4}\\left(\\frac{5^{2 x^{2} + 2}}{\\ln{\\left(5 \\right)}}\\right)"] [:db/ensure "40a6b836-8b7b-5337-8d7d-1d88337396c5" :answer/validate] [:db/add "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da" :answer-field/id #uuid "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da"] [:db/add "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da" :answer-field/key "answer"] [:db/add "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da" :answer-field/type :answer-field.type/blank] [:db/add "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da" :answer-field/choices "40a6b836-8b7b-5337-8d7d-1d88337396c5"] [:db/add "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da" :answer-field/correct "40a6b836-8b7b-5337-8d7d-1d88337396c5"] [:db/ensure "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da" :answer-field/validate] [:db/add "694f8a19-cddb-5b1e-b77b-8b9cd195c174" :question/id #uuid "694f8a19-cddb-5b1e-b77b-8b9cd195c174"] [:db/add "694f8a19-cddb-5b1e-b77b-8b9cd195c174" :question/problem "Find an antiderivative.\n\n$$\n\\int 5^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C$.\n\n{{answer}} $+C$"] [:db/add "694f8a19-cddb-5b1e-b77b-8b9cd195c174" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 5^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\frac{5^{u}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\frac{5^{2 x^{2} + 2}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$"] [:db/add "694f8a19-cddb-5b1e-b77b-8b9cd195c174" :question/difficulty :question.difficulty/moderate] [:db/add "694f8a19-cddb-5b1e-b77b-8b9cd195c174" :question/answer-fields "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da"] [:db/ensure "694f8a19-cddb-5b1e-b77b-8b9cd195c174" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "694f8a19-cddb-5b1e-b77b-8b9cd195c174"] [:db/add "a6377cc5-9826-54a6-899c-0b253c8e88ff" :answer/id #uuid "a6377cc5-9826-54a6-899c-0b253c8e88ff"] [:db/add "a6377cc5-9826-54a6-899c-0b253c8e88ff" :answer/type :answer.type/math] [:db/add "a6377cc5-9826-54a6-899c-0b253c8e88ff" :answer/value "\\frac{4}{3}\\left(\\frac{3^{x^{3} + 2}}{\\ln{\\left(3 \\right)}}\\right)"] [:db/ensure "a6377cc5-9826-54a6-899c-0b253c8e88ff" :answer/validate] [:db/add "c7179666-3e4a-56ab-bf40-d66e4adfe41a" :answer-field/id #uuid "c7179666-3e4a-56ab-bf40-d66e4adfe41a"] [:db/add "c7179666-3e4a-56ab-bf40-d66e4adfe41a" :answer-field/key "answer"] [:db/add "c7179666-3e4a-56ab-bf40-d66e4adfe41a" :answer-field/type :answer-field.type/blank] [:db/add "c7179666-3e4a-56ab-bf40-d66e4adfe41a" :answer-field/choices "a6377cc5-9826-54a6-899c-0b253c8e88ff"] [:db/add "c7179666-3e4a-56ab-bf40-d66e4adfe41a" :answer-field/correct "a6377cc5-9826-54a6-899c-0b253c8e88ff"] [:db/ensure "c7179666-3e4a-56ab-bf40-d66e4adfe41a" :answer-field/validate] [:db/add "5c977eea-335e-5055-a868-1e56d5c6fe24" :question/id #uuid "5c977eea-335e-5055-a868-1e56d5c6fe24"] [:db/add "5c977eea-335e-5055-a868-1e56d5c6fe24" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cdot 3^{x^{3} + 2} x^{2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C$.\n\n{{answer}} $+C$"] [:db/add "5c977eea-335e-5055-a868-1e56d5c6fe24" :question/worked-solution "Let $u=x^{3} + 2$. Then $\\mathrm{d}u=(3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cdot 3^{x^{3} + 2} x^{2}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{4}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(\\frac{3^{x^{3} + 2}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$"] [:db/add "5c977eea-335e-5055-a868-1e56d5c6fe24" :question/difficulty :question.difficulty/moderate] [:db/add "5c977eea-335e-5055-a868-1e56d5c6fe24" :question/answer-fields "c7179666-3e4a-56ab-bf40-d66e4adfe41a"] [:db/ensure "5c977eea-335e-5055-a868-1e56d5c6fe24" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "5c977eea-335e-5055-a868-1e56d5c6fe24"] [:db/add "9475f9e5-227c-5840-b910-548f1ff669d7" :answer/id #uuid "9475f9e5-227c-5840-b910-548f1ff669d7"] [:db/add "9475f9e5-227c-5840-b910-548f1ff669d7" :answer/type :answer.type/math] [:db/add "9475f9e5-227c-5840-b910-548f1ff669d7" :answer/value "- \\frac{1}{3}\\left(\\frac{2^{2 - x^{3}}}{\\ln{\\left(2 \\right)}}\\right)"] [:db/ensure "9475f9e5-227c-5840-b910-548f1ff669d7" :answer/validate] [:db/add "bc4c58f1-54f1-5fc4-afa2-c408278c98da" :answer-field/id #uuid "bc4c58f1-54f1-5fc4-afa2-c408278c98da"] [:db/add "bc4c58f1-54f1-5fc4-afa2-c408278c98da" :answer-field/key "answer"] [:db/add "bc4c58f1-54f1-5fc4-afa2-c408278c98da" :answer-field/type :ans