\cdot 3^{x^{3} + 1} x^{2}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{2}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right)=\\frac{2}{3}\\left(\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{3}\\left(\\frac{3^{x^{3} + 1}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6377cc5-9826-54a6-899c-0b253c8e88ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\left(\\frac{3^{x^{3} + 2}}{\\ln{\\left(3 \\right)}}\\right)" :db/id #edb/ref 17592186679383}] :answer-field/correct {:answer/id #uuid "a6377cc5-9826-54a6-899c-0b253c8e88ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\left(\\frac{3^{x^{3} + 2}}{\\ln{\\left(3 \\right)}}\\right)" :db/id #edb/ref 17592186679383} :answer-field/id #uuid "c7179666-3e4a-56ab-bf40-d66e4adfe41a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679399}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5c977eea-335e-5055-a868-1e56d5c6fe24" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cdot 3^{x^{3} + 2} x^{2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C$.\n\n{{answer}} $+C$" :question/worked-solution "Let $u=x^{3} + 2$. Then $\\mathrm{d}u=(3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cdot 3^{x^{3} + 2} x^{2}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{4}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(\\frac{3^{x^{3} + 2}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a6b836-8b7b-5337-8d7d-1d88337396c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\frac{5^{2 x^{2} + 2}}{\\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186679338}] :answer-field/correct {:answer/id #uuid "40a6b836-8b7b-5337-8d7d-1d88337396c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\frac{5^{2 x^{2} + 2}}{\\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186679338} :answer-field/id #uuid "42fcc5c3-e7c7-5c41-8521-c50ff5ce56da" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679340}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "694f8a19-cddb-5b1e-b77b-8b9cd195c174" :question/problem "Find an antiderivative.\n\n$$\n\\int 5^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C$.\n\n{{answer}} $+C$" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 5^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\frac{5^{u}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\frac{5^{2 x^{2} + 2}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c545166b-1d76-505b-b7d9-e9459c34c7e2" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{4}\\left(\\frac{2^{2 - 2 x^{2}}}{\\ln{\\left(2 \\right)}}\\right)" :db/id #edb/ref 17592186679397}] :answer-field/correct {:answer/id #uuid "c545166b-1d76-505b-b7d9-e9459c34c7e2"