int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\arcsin{\\left(\\frac{4 x}{3} \\right)}\\right)+C.\n$$"] [:db/add "cfdabf08-a69b-5abe-80f0-3c9106b581f1" :question/difficulty :question.difficulty/hard] [:db/add "cfdabf08-a69b-5abe-80f0-3c9106b581f1" :question/answer-fields "42330f75-fd38-52cb-80a9-3af5cce2a1ab"] [:db/ensure "cfdabf08-a69b-5abe-80f0-3c9106b581f1" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "cfdabf08-a69b-5abe-80f0-3c9106b581f1"] [:db/add "8c81ff3f-41ae-5271-9b29-60734641f927" :answer/id #uuid "8c81ff3f-41ae-5271-9b29-60734641f927"] [:db/add "8c81ff3f-41ae-5271-9b29-60734641f927" :answer/type :answer.type/math] [:db/add "8c81ff3f-41ae-5271-9b29-60734641f927" :answer/value "\\frac{1}{4}\\left(\\arcsin{\\left(4 x \\right)}\\right)+C"] [:db/ensure "8c81ff3f-41ae-5271-9b29-60734641f927" :answer/validate] [:db/add "cd3ac926-d581-5c5f-ba72-3322ccd4db3d" :answer/id #uuid "cd3ac926-d581-5c5f-ba72-3322ccd4db3d"] [:db/add "cd3ac926-d581-5c5f-ba72-3322ccd4db3d" :answer/type :answer.type/math] [:db/add "cd3ac926-d581-5c5f-ba72-3322ccd4db3d" :answer/value "- \\frac{1}{4}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C"] [:db/ensure "cd3ac926-d581-5c5f-ba72-3322ccd4db3d" :answer/validate] [:db/add "1d8822d2-d398-5247-b1e1-89c9fbaa9679" :answer/id #uuid "1d8822d2-d398-5247-b1e1-89c9fbaa9679"] [:db/add "1d8822d2-d398-5247-b1e1-89c9fbaa9679" :answer/type :answer.type/math] [:db/add "1d8822d2-d398-5247-b1e1-89c9fbaa9679" :answer/value "\\frac{1}{2}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C"] [:db/ensure "1d8822d2-d398-5247-b1e1-89c9fbaa9679" :answer/validate] [:db/add "eca0154b-2389-5640-8f69-7d0dca65c473" :answer/id #uuid "eca0154b-2389-5640-8f69-7d0dca65c473"] [:db/add "eca0154b-2389-5640-8f69