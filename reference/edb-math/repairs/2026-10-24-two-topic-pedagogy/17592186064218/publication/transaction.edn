dd "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/type :answer-field.type/radio] [:db/add "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/choices "e3a47d8d-3ef6-5933-8ab1-251e436ae64c"] [:db/add "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/choices "fb1c2227-8f5f-5bbe-8639-54cae4eeecd9"] [:db/add "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/choices "794542e2-c977-50b8-bbc4-5ccd21d90e77"] [:db/add "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/choices "4fd68a63-724f-574a-9786-f070580733ef"] [:db/add "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/choices "ac33763f-f131-5c90-880a-c09f293ca8ab"] [:db/add "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/correct "794542e2-c977-50b8-bbc4-5ccd21d90e77"] [:db/ensure "df13b46b-41af-526b-af54-045674b5bdef" :answer-field/validate] [:db/add "3c7be681-6a2d-5a04-a101-13d325e163c6" :question/id #uuid "3c7be681-6a2d-5a04-a101-13d325e163c6"] [:db/add "3c7be681-6a2d-5a04-a101-13d325e163c6" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{\\sqrt{4 - 16 x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "3c7be681-6a2d-5a04-a101-13d325e163c6" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{4 - 16 x^{2}}=2\\sqrt{1-(2 x)^2}.\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{2}\\cdot \\frac{1}{2}=\\frac{3}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{\\sqrt{4 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{3}{4}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{4}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C.\n$$"] [:db/add "3c7be681-6a2d-5a04-a101-13d325e163c6" :question/difficulty :question.difficulty/hard] [:db/add "3c7be681-6a2d-5a04-a101-13d325e163c6" :question/answer-fields "df13b46b-41af-526b-af54-045674b5bdef"] [:db/ensure "3c7be681-6a2d-5a04-a101-13d325e163c6" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "3c7be681-6a2d-5a04-a101-13d325e163c6"] [:db/add "generator" :question-generator/id #uuid "a1179086-44c6-5401-89a0-90db05f0228b"] [:db/add "generator" :question-generator/script "generators/47/4768c628b8460329222e9662c2d7f5d485467d218c62d3e9d0740b180c83de2e/generator.py"] [:db/add 17592186064218 :knowledge-point/question-generator "generator"] [:db/ensure 17592186064218 :knowledge-point/validate] [:db/cas 17592186676536 :question/retired nil true] [:db/cas 17592186676540 :question/retired nil true] [:db/cas 17592186676553 :question/retired nil true] [:db/cas 17592186676574 :question/retired nil true] [:db/cas 17592186676588 :question/retired nil true] [:db/cas 17592186676591 :question/retired nil true] [:db/cas 17592186676607 :question/retired nil true] [:db/cas 17592186676617 :question/retired nil true] [:db/cas 17592186676624 :question/retired nil true] [:db/cas 17592186676628 :question/retired nil true] [:db/cas 17592186676635 :question/retired nil true] [:db/cas 17592186676637 :question/retired nil true] [:db/cas 17592186676643 :question/retired nil true] [:db/cas 17592186676650 :question/retired nil true] [:db/cas 17592186676656 :question/retired nil true] [:db/cas 17592186676657 :question/retired nil true] [:db/cas 17592186676664 :question/retired nil true] [:db/cas 17592186676665 :question/retired nil true] [:db/cas 17592186676669 :question/retired nil true] [:db/cas 17592186676671 :question/retired nil true] [:db/cas 17592186676686 :question/retired nil true] [:db/cas 17592186676688 :question/retired nil true] [:db/cas 175921