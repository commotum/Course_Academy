hrm{d}u\\\\right)\"] [\"6b69c1df-5719-5660-bc08-94522be97370\" :answer/id #uuid \"6b69c1df-5719-5660-bc08-94522be97370\"] [\"6b69c1df-5719-5660-bc08-94522be97370\" :answer/type :answer.type/math] [\"6b69c1df-5719-5660-bc08-94522be97370\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"04f5c5dd-6688-5932-8348-558ae295d66c\" :answer/id #uuid \"04f5c5dd-6688-5932-8348-558ae295d66c\"] [\"04f5c5dd-6688-5932-8348-558ae295d66c\" :answer/type :answer.type/math] [\"04f5c5dd-6688-5932-8348-558ae295d66c\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"40bc2141-0918-55ec-a796-98de8e551029\" :answer/id #uuid \"40bc2141-0918-55ec-a796-98de8e551029\"] [\"40bc2141-0918-55ec-a796-98de8e551029\" :answer/type :answer.type/math] [\"40bc2141-0918-55ec-a796-98de8e551029\" :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\" :answer/id #uuid \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\"] [\"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\" :answer/type :answer.type/math] [\"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\" :answer/value \"\\\\frac{12}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/id #uuid \"d6400655-57d6-56de-9338-d26c5af23a59\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/key \"answer\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/type :answer-field.type/radio] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"afd5b943-d049-5eb8-b107-9e6bb8be855a\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"6b69c1df-5719-5660-bc08-94522be97370\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"04f5c5dd-6688-5932-8348-558ae295d66c\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"40bc2141-0918-55ec-a796-98de8e551029\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\"] [\"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/correct \"04f5c5dd-6688-5932-8348-558ae295d66c\"] [\"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/id #uuid \"a309d297-74a3-52d4-8716-b7be3f2a61d6\"] [\"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{5}=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/difficulty :question.difficulty/easy] [\"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/answer-fields \"d6400655-57d6-56de-9338-d26c5af23a59\"] [17592186064218 :knowledge-point/questions \"a309d297-74a3-52d4-8716-b7be3f2a61d6\"] [\"0d5c0687-4efd-5652-b3bd-594ec5837754\" :answer/id #uuid \"0d5c0687-4efd-5652-b3bd-594ec5837754\"] [\"0d5c0687-4efd-5652-b3bd-594ec5837754\" :answer/type :answer.type/math] [\"0d5c0687-4efd-5652-b3bd-594ec5837754\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\"] [\"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\" :answer/id #uuid \"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\"] [\"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\" :answer/type :answer.type/math] [\"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\" :answer/id #uuid \"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\"] [\"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\" :answer/type :answer.type/math] [\"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"49e263c4-69f7-5f57-aeb0-f901993f64fc\" :answer/id #uuid \"49e263c4-69f7-5f57-aeb0-f901993f64fc\"] [\"49e263c4-69f7-5f57-aeb0-f901993f64fc\" :answer/type :answer.type/math] [\"49e263c4-69f7-5f57-aeb0-f901993f64fc\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"5a479a26-0315-5344-b3d8-797bc080a5e3\" :answer/id #uuid \"5a479a26-0315-5344-b3d8-797bc080a5e3\"] [\"5a479a26-0315-5344-b3d8-797bc080a5e3\" :answer/type :answer.type/math] [\"5a479a26-0315-5344-b3d8-797bc080a5e3\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/id #uuid \"553ff056-bb9d-596c-ba3c-66c55b408913\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/key \"answer\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/type :answer-field.type/radio] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/choices \"0d5c0687-4efd-5652-b3bd-594ec5837754\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/choices \"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/choices \"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/choices \"49e263c4-69f7-5f57-aeb0-f901993f64fc\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/choices \"5a479a26-0315-5344-b3d8-797bc080a5e3\"] [\"553ff056-bb9d-596c-ba3c-66c55b408913\" :answer-field/correct \"0d5c0687-4efd-5652-b3bd-594ec5837754\"] [\"ef16e437-7fc0-5820-9ae9-b1f25d063281\" :question/id #uuid \"ef16e437-7fc0-5820-9ae9-b1f25d063281\"] [\"ef16e437-7fc0-5820-9ae9-b1f25d063281\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"ef16e437-7fc0-5820-9ae9-b1f25d063281\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"ef16e437-7fc0-5820-9ae9-b1f25d063281\" :question/difficulty :question.difficulty/easy] [\"ef16e437-7fc0-5820-9ae9-b1f25d063281\" :question/answer-fields \"553ff056-bb9d-596c-ba3c-66c55b408913\"] [17592186064218 :knowledge-point/questions \"ef16e437-7fc0-5820-9ae9-b1f25d063281\"] [\"4eb4ea72-34d2-5f3b-9c3b-c3d27341f193\" :answer/id #uuid \"4eb4ea72-34d2-5f3b-9c3b-c3d27341f193\"] [\"4eb4ea72-34d2-5f3b-9c3b-c3d27341f193\" :answer/type :answer.type/math] [\"4eb4ea72-34d2-5f3b-9c3b-c3d27341f193\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"75839238-b886-512f-8b47-7b2ddbba20d4\" :answer/id #uuid \"75839238-b886-512f-8b47-7b2ddbba20d4\"] [\"75839238-b886-512f-8b47-7b2ddbba20d4\" :answer/type :answer.type/math] [\"75839238-b886-512f-8b47-7b2ddbba20d4\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e4cb6f06-8ae1-5829-8a8d-d39e37ea10b3\" :answer/id #uuid \"e4cb6f06-8ae1-5829-8a8d-d39e37ea10b3\"] [\"e4cb6f06-8ae1-5829-8a8d-d39e37ea10b3\" :answer/type :answer.type/math] [\"e4cb6f06-8ae1-5829-8a8d-d39e37ea10b3\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"02698ce2-71f4-5e0d-b538-1005e2606968\" :answer/id #uuid \"02698ce2-71f4-5e0d-b538-1005e2606968\"] [\"02698ce2-71f4-5e0d-b538-1005e2606968\" :answer/type :answer.type/math] [\"02698ce2-71f4-5e0d-b538-1005e2606968\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"1b61a9ea-960e-5402-8629-607e81e316d6\" :answer/id #uuid \"1b61a9ea-960e-5402-8629-607e81e316d6\"] [\"1b61a9ea-960e-5402-8629-607e81e316d6\" :answer/type :answer.type/math] [\"1b61a9ea-960e-5402-8629-607e81e316d6\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/id #uuid \"37b9b6a2-92b8-5116-ae30-6cdf870392ee\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/key \"answer\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/type :answer-field.type/radio] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/choices \"4eb4ea72-34d2-5f3b-9c3b-c3d27341f193\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/choices \"75839238-b886-512f-8b47-7b2ddbba20d4\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/choices \"e4cb6f06-8ae1-5829-8a8d-d39e37ea10b3\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/choices \"02698ce2-71f4-5e0d-b538-1005e2606968\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/choices \"1b61a9ea-960e-5402-8629-607e81e316d6\"] [\"37b9b6a2-92b8-5116-ae30-6cdf870392ee\" :answer-field/correct \"1b61a9ea-960e-5402-8629-607e81e316d6\"] [\"7d601f7b-b5dd-5950-9934-aa9ea8fac819\" :question/id #uuid \"7d601f7b-b5dd-5950-9934-aa9ea8fac819\"] [\"7d601f7b-b5dd-5950-9934-aa9ea8fac819\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"7d601f7b-b5dd-5950-9934-aa9ea8fac819\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"7d601f7b-b5dd-5950-9934-aa9ea8fac819\" :question/difficulty :question.difficulty/easy] [\"7d601f7b-b5dd-5950-9934-aa9ea8fac819\" :question/answer-fields \"37b9b6a2-92b8-5116-ae30-6cdf870392ee\"] [17592186064218 :knowledge-point/questions \"7d601f7b-b5dd-5950-9934-aa9ea8fac819\"] [\"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\" :answer/id #uuid \"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\"] [\"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\" :answer/type :answer.type/math] [\"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\" :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"14d7fe58-cb78-5376-b60d-1710c7c0662a\" :answer/id #uuid \"14d7fe58-cb78-5376-b60d-1710c7c0662a\"] [\"14d7fe58-cb78-5376-b60d-1710c7c0662a\" :answer/type :answer.type/math] [\"14d7fe58-cb78-5376-b60d-1710c7c0662a\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e257c8e8-5775-556c-8eb5-b374de8783aa\" :answer/id #uuid \"e257c8e8-5775-556c-8eb5-b374de8783aa\"] [\"e257c8e8-5775-556c-8eb5-b374de8783aa\" :answer/type :answer.type/math] [\"e257c8e8-5775-556c-8eb5-b374de8783aa\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\" :answer/id #uuid \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\"] [\"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\" :answer/type :answer.type/math] [\"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\" :answer/value \"- \\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"547ac542-6f7d-5596-9293-e57946cc34eb\" :answer/id #uuid \"547ac542-6f7d-5596-9293-e57946cc34eb\"] [\"547ac542-6f7d-5596-9293-e57946cc34eb\" :answer/type :answer.type/math] [\"547ac542-6f7d-5596-9293-e57946cc34eb\" :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/id #uuid \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/key \"answer\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/type :answer-field.type/radio] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"14d7fe58-cb78-5376-b60d-1710c7c0662a\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"e257c8e8-5775-556c-8eb5-b374de8783aa\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"547ac542-6f7d-5596-9293-e57946cc34eb\"] [\"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/correct \"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\"] [\"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/id #uuid \"9877a1da-e8db-570d-b287-71b1a27bf31c\"] [\"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/difficulty :question.difficulty/easy] [\"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/answer-fields \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\"] [17592186064218 :knowledge-point/questions \"9877a1da-e8db-570d-b287-71b1a27bf31c\"] [\"1a7d2026-21a1-52ec-9b49-5220db72316a\" :answer/id #uuid \"1a7d2026-21a1-52ec-9b49-5220db72316a\"] [\"1a7d2026-21a1-52ec-9b49-5220db72316a\" :answer/type :answer.type/math] [\"1a7d2026-21a1-52ec-9b49-5220db72316a\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"6e9d6bf9-ce93-5519-891b-3931898ec663\" :answer/id #uuid \"6e9d6bf9-ce93-5519-891b-3931898ec663\"] [\"6e9d6bf9-ce93-5519-891b-3931898ec663\" :answer/type :answer.type/math] [\"6e9d6bf9-ce93-5519-891b-3931898ec663\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"14265516-ae65-532c-a184-fefd886b2e37\" :answer/id #uuid \"14265516-ae65-532c-a184-fefd886b2e37\"] [\"14265516-ae65-532c-a184-fefd886b2e37\" :answer/type :answer.type/math] [\"14265516-ae65-532c-a184-fefd886b2e37\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"5bc45f87-f239-562e-bfa0-5cddadaefef6\" :answer/id #uuid \"5bc45f87-f239-562e-bfa0-5cddadaefef6\"] [\"5bc45f87-f239-562e-bfa0-5cddadaefef6\" :answer/type :answer.type/math] [\"5bc45f87-f239-562e-bfa0-5cddadaefef6\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"0d992567-a619-5037-8f15-12c042da49ad\" :answer/id #uuid \"0d992567-a619-5037-8f15-12c042da49ad\"] [\"0d992567-a619-5037-8f15-12c042da49ad\" :answer/type :answer.type/math] [\"0d992567-a619-5037-8f15-12c042da49ad\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/id #uuid \"0773353a-1ec6-50c4-977d-1ad00bcff537\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/key \"answer\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/type :answer-field.type/radio] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"1a7d2026-21a1-52ec-9b49-5220db72316a\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"6e9d6bf9-ce93-5519-891b-3931898ec663\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"14265516-ae65-532c-a184-fefd886b2e37\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"5bc45f87-f239-562e-bfa0-5cddadaefef6\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"0d992567-a619-5037-8f15-12c042da49ad\"] [\"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/correct \"14265516-ae65-532c-a184-fefd886b2e37\"] [\"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/id #uuid \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\"] [\"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{3}\\\\cdot 3=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/difficulty :question.difficulty/moderate] [\"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/answer-fields \"0773353a-1ec6-50c4-977d-1ad00bcff537\"] [17592186064218 :knowledge-point/questions \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\"] [\"51e8012a-cb17-5de6-bb38-9993fe24bb83\" :answer/id #uuid \"51e8012a-cb17-5de6-bb38-9993fe24bb83\"] [\"51e8012a-cb17-5de6-bb38-9993fe24bb83\" :answer/type :answer.type/math] [\"51e8012a-cb17-5de6-bb38-9993fe24bb83\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"48199f27-9acc-5101-a844-84b9b9ec7b0f\" :answer/id #uuid \"48199f27-9acc-5101-a844-84b9b9ec7b0f\"] [\"48199f27-9acc-5101-a844-84b9b9ec7b0f\" :answer/type :answer.type/math] [\"48199f27-9acc-5101-a844-84b9b9ec7b0f\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"3e2e1306-8611-5f36-bc4d-5c4b599691be\" :answer/id #uuid \"3e2e1306-8611-5f36-bc4d-5c4b599691be\"] [\"3e2e1306-8611-5f36-bc4d-5c4b599691be\" :answer/type :answer.type/math] [\"3e2e1306-8611-5f36-bc4d-5c4b599691be\" :answer/value \"-4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"0ef95243-03d7-5f9b-9964-050a81aafe47\" :answer/id #uuid \"0ef95243-03d7-5f9b-9964-050a81aafe47\"] [\"0ef95243-03d7-5f9b-9964-050a81aafe47\" :answer/type :answer.type/math] [\"0ef95243-03d7-5f9b-9964-050a81aafe47\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"1cb92fee-7ade-511f-a001-e6edbcd1480c\" :answer/id #uuid \"1cb92fee-7ade-511f-a001-e6edbcd1480c\"] [\"1cb92fee-7ade-511f-a001-e6edbcd1480c\" :answer/type :answer.type/math] [\"1cb92fee-7ade-511f-a001-e6edbcd1480c\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/id #uuid \"908f8536-5dab-5a3b-a7e7-013a3e062230\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/key \"answer\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/type :answer-field.type/radio] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"51e8012a-cb17-5de6-bb38-9993fe24bb83\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"48199f27-9acc-5101-a844-84b9b9ec7b0f\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"3e2e1306-8611-5f36-bc4d-5c4b599691be\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"0ef95243-03d7-5f9b-9964-050a81aafe47\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"1cb92fee-7ade-511f-a001-e6edbcd1480c\"] [\"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/correct \"0ef95243-03d7-5f9b-9964-050a81aafe47\"] [\"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/id #uuid \"b7986f5c-b477-564a-b6a1-e6bc8f022405\"] [\"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot 3=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/difficulty :question.difficulty/moderate] [\"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/answer-fields \"908f8536-5dab-5a3b-a7e7-013a3e062230\"] [17592186064218 :knowledge-point/questions \"b7986f5c-b477-564a-b6a1-e6bc8f022405\"] [\"15788a7e-1a95-512a-95b5-65815c014108\" :answer/id #uuid \"15788a7e-1a95-512a-95b5-65815c014108\"] [\"15788a7e-1a95-512a-95b5-65815c014108\" :answer/type :answer.type/math] [\"15788a7e-1a95-512a-95b5-65815c014108\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\" :answer/id #uuid \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\"] [\"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\" :answer/type :answer.type/math] [\"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"108bf616-e497-5cfe-a43c-39590412ca4c\" :answer/id #uuid \"108bf616-e497-5cfe-a43c-39590412ca4c\"] [\"108bf616-e497-5cfe-a43c-39590412ca4c\" :answer/type :answer.type/math] [\"108bf616-e497-5cfe-a43c-39590412ca4c\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\" :answer/id #uuid \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\"] [\"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\" :answer/type :answer.type/math] [\"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\" :answer/id #uuid \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\"] [\"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\" :answer/type :answer.type/math] [\"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/id #uuid \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/key \"answer\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/type :answer-field.type/radio] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"15788a7e-1a95-512a-95b5-65815c014108\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"108bf616-e497-5cfe-a43c-39590412ca4c\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\"] [\"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/correct \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\"] [\"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/id #uuid \"84707fca-407c-5ae0-9f6b-a8be35d06a68\"] [\"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 2=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/difficulty :question.difficulty/moderate] [\"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/answer-fields \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\"] [17592186064218 :knowledge-point/questions \"84707fca-407c-5ae0-9f6b-a8be35d06a68\"] [\"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\" :answer/id #uuid \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\"] [\"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\" :answer/type :answer.type/math] [\"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"5927bcef-6929-518c-b557-26b60938610f\" :answer/id #uuid \"5927bcef-6929-518c-b557-26b60938610f\"] [\"5927bcef-6929-518c-b557-26b60938610f\" :answer/type :answer.type/math] [\"5927bcef-6929-518c-b557-26b60938610f\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"fa533c61-318d-5905-aed2-ca6068deae51\" :answer/id #uuid \"fa533c61-318d-5905-aed2-ca6068deae51\"] [\"fa533c61-318d-5905-aed2-ca6068deae51\" :answer/type :answer.type/math] [\"fa533c61-318d-5905-aed2-ca6068deae51\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"ec863435-7d34-562d-9caa-2fcaac69afa4\" :answer/id #uuid \"ec863435-7d34-562d-9caa-2fcaac69afa4\"] [\"ec863435-7d34-562d-9caa-2fcaac69afa4\" :answer/type :answer.type/math] [\"ec863435-7d34-562d-9caa-2fcaac69afa4\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"de3b79fe-7b63-5b59-8d76-3b9d1755333b\" :answer/id #uuid \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\"] [\"de3b79fe-7b63-5b59-8d76-3b9d1755333b\" :answer/type :answer.type/math] [\"de3b79fe-7b63-5b59-8d76-3b9d1755333b\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/id #uuid \"db182094-1a54-5f8a-aec9-d46031297fe7\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/key \"answer\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/type :answer-field.type/radio] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"5927bcef-6929-518c-b557-26b60938610f\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"fa533c61-318d-5905-aed2-ca6068deae51\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"ec863435-7d34-562d-9caa-2fcaac69afa4\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\"] [\"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/correct \"ec863435-7d34-562d-9caa-2fcaac69afa4\"] [\"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/id #uuid \"e9816c5f-db55-5531-9180-8cf55f866d1e\"] [\"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot 2=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/difficulty :question.difficulty/moderate] [\"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/answer-fields \"db182094-1a54-5f8a-aec9-d46031297fe7\"] [17592186064218 :knowledge-point/questions \"e9816c5f-db55-5531-9180-8cf55f866d1e\"] [\"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\" :answer/id #uuid \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\"] [\"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\" :answer/type :answer.type/math] [\"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\" :answer/id #uuid \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\"] [\"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\" :answer/type :answer.type/math] [\"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"b52ac15a-1522-5c8b-8137-8d58fe2ff645\" :answer/id #uuid \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\"] [\"b52ac15a-1522-5c8b-8137-8d58fe2ff645\" :answer/type :answer.type/math] [\"b52ac15a-1522-5c8b-8137-8d58fe2ff645\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"a03bf18e-2c63-5339-9629-bbc6189145c7\" :answer/id #uuid \"a03bf18e-2c63-5339-9629-bbc6189145c7\"] [\"a03bf18e-2c63-5339-9629-bbc6189145c7\" :answer/type :answer.type/math] [\"a03bf18e-2c63-5339-9629-bbc6189145c7\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"4277b4e6-49e4-5a56-809b-b79cd834fd13\" :answer/id #uuid \"4277b4e6-49e4-5a56-809b-b79cd834fd13\"] [\"4277b4e6-49e4-5a56-809b-b79cd834fd13\" :answer/type :answer.type/math] [\"4277b4e6-49e4-5a56-809b-b79cd834fd13\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/id #uuid \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/key \"answer\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/type :answer-field.type/radio] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"a03bf18e-2c63-5339-9629-bbc6189145c7\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"4277b4e6-49e4-5a56-809b-b79cd834fd13\"] [\"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/correct \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\"] [\"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/id #uuid \"cc8028db-87b5-52a1-8aac-9030f73664f7\"] [\"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - x^{2}}=5\\\\sqrt{1-(\\\\frac{x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{5}\\\\cdot 5=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/difficulty :question.difficulty/moderate] [\"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/answer-fields \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\"] [17592186064218 :knowledge-point/questions \"cc8028db-87b5-52a1-8aac-9030f73664f7\"] [\"ed78d76b-0f74-573a-86df-dfb499fa3e3c\" :answer/id #uuid \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\"] [\"ed78d76b-0f74-573a-86df-dfb499fa3e3c\" :answer/type :answer.type/math] [\"ed78d76b-0f74-573a-86df-dfb499fa3e3c\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"48e6410e-271b-5955-b68e-60ea6dbe2db5\" :answer/id #uuid \"48e6410e-271b-5955-b68e-60ea6dbe2db5\"] [\"48e6410e-271b-5955-b68e-60ea6dbe2db5\" :answer/type :answer.type/math] [\"48e6410e-271b-5955-b68e-60ea6dbe2db5\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"c94f431f-bba0-554b-951b-325adffcef03\" :answer/id #uuid \"c94f431f-bba0-554b-951b-325adffcef03\"] [\"c94f431f-bba0-554b-951b-325adffcef03\" :answer/type :answer.type/math] [\"c94f431f-bba0-554b-951b-325adffcef03\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"cbcacfdc-8075-5d49-8d42-fbcce88586aa\" :answer/id #uuid \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\"] [\"cbcacfdc-8075-5d49-8d42-fbcce88586aa\" :answer/type :answer.type/math] [\"cbcacfdc-8075-5d49-8d42-fbcce88586aa\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"1c6450a6-11ae-5cb6-8355-2a3f3658253b\" :answer/id #uuid \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\"] [\"1c6450a6-11ae-5cb6-8355-2a3f3658253b\" :answer/type :answer.type/math] [\"1c6450a6-11ae-5cb6-8355-2a3f3658253b\" :answer/value \"-4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/id #uuid \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/key \"answer\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/type :answer-field.type/radio] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"48e6410e-271b-5955-b68e-60ea6dbe2db5\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"c94f431f-bba0-554b-951b-325adffcef03\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\"] [\"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/correct \"48e6410e-271b-5955-b68e-60ea6dbe2db5\"] [\"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/id #uuid \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\"] [\"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 4=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/difficulty :question.difficulty/moderate] [\"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/answer-fields \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\"] [17592186064218 :knowledge-point/questions \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\"] [\"4c457006-6a85-5708-acba-32926a552ee4\" :answer/id #uuid \"4c457006-6a85-5708-acba-32926a552ee4\"] [\"4c457006-6a85-5708-acba-32926a552ee4\" :answer/type :answer.type/math] [\"4c457006-6a85-5708-acba-32926a552ee4\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\" :answer/id #uuid \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\"] [\"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\" :answer/type :answer.type/math] [\"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"d9e542fd-6abe-5edb-bcd7-fa02034ff443\" :answer/id #uuid \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\"] [\"d9e542fd-6abe-5edb-bcd7-fa02034ff443\" :answer/type :answer.type/math] [\"d9e542fd-6abe-5edb-bcd7-fa02034ff443\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"55dcf395-29a4-573b-921e-896c6c6467b0\" :answer/id #uuid \"55dcf395-29a4-573b-921e-896c6c6467b0\"] [\"55dcf395-29a4-573b-921e-896c6c6467b0\" :answer/type :answer.type/math] [\"55dcf395-29a4-573b-921e-896c6c6467b0\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\" :answer/id #uuid \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\"] [\"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\" :answer/type :answer.type/math] [\"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/id #uuid \"eb52a120-a923-5ff4-ad82-6db06b46316d\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/key \"answer\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/type :answer-field.type/radio] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"4c457006-6a85-5708-acba-32926a552ee4\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"55dcf395-29a4-573b-921e-896c6c6467b0\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\"] [\"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/correct \"4c457006-6a85-5708-acba-32926a552ee4\"] [\"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/id #uuid \"f2c2956c-0c43-5953-a81f-5536789cc765\"] [\"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 4=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/difficulty :question.difficulty/moderate] [\"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/answer-fields \"eb52a120-a923-5ff4-ad82-6db06b46316d\"] [17592186064218 :knowledge-point/questions \"f2c2956c-0c43-5953-a81f-5536789cc765\"] [\"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\" :answer/id #uuid \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\"] [\"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\" :answer/type :answer.type/math] [\"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"da0a0217-3467-50ce-8d39-f984c8c3c4ea\" :answer/id #uuid \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\"] [\"da0a0217-3467-50ce-8d39-f984c8c3c4ea\" :answer/type :answer.type/math] [\"da0a0217-3467-50ce-8d39-f984c8c3c4ea\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\" :answer/id #uuid \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\"] [\"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\" :answer/type :answer.type/math] [\"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"6b976a27-703a-5c45-aee1-8e171a3a6108\" :answer/id #uuid \"6b976a27-703a-5c45-aee1-8e171a3a6108\"] [\"6b976a27-703a-5c45-aee1-8e171a3a6108\" :answer/type :answer.type/math] [\"6b976a27-703a-5c45-aee1-8e171a3a6108\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"40e36773-b19c-53e4-8b18-e20e2eea849f\" :answer/id #uuid \"40e36773-b19c-53e4-8b18-e20e2eea849f\"] [\"40e36773-b19c-53e4-8b18-e20e2eea849f\" :answer/type :answer.type/math] [\"40e36773-b19c-53e4-8b18-e20e2eea849f\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/id #uuid \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/key \"answer\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/type :answer-field.type/radio] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"6b976a27-703a-5c45-aee1-8e171a3a6108\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"40e36773-b19c-53e4-8b18-e20e2eea849f\"] [\"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/correct \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\"] [\"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/id #uuid \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\"] [\"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot 4=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/difficulty :question.difficulty/moderate] [\"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/answer-fields \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\"] [17592186064218 :knowledge-point/questions \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\"] [\"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\" :answer/id #uuid \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\"] [\"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\" :answer/type :answer.type/math] [\"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"08b72347-1d8d-50a3-bb44-5acc1af00891\" :answer/id #uuid \"08b72347-1d8d-50a3-bb44-5acc1af00891\"] [\"08b72347-1d8d-50a3-bb44-5acc1af00891\" :answer/type :answer.type/math] [\"08b72347-1d8d-50a3-bb44-5acc1af00891\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"2dbcb0f3-a228-5d97-abb5-a77410bb0322\" :answer/id #uuid \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\"] [\"2dbcb0f3-a228-5d97-abb5-a77410bb0322\" :answer/type :answer.type/math] [\"2dbcb0f3-a228-5d97-abb5-a77410bb0322\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"a56b2967-5d58-588f-8aa2-576b19eb8329\" :answer/id #uuid \"a56b2967-5d58-588f-8aa2-576b19eb8329\"] [\"a56b2967-5d58-588f-8aa2-576b19eb8329\" :answer/type :answer.type/math] [\"a56b2967-5d58-588f-8aa2-576b19eb8329\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\" :answer/id #uuid \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\"] [\"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\" :answer/type :answer.type/math] [\"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/id #uuid \"b5f52558-6f4e-5657-8e84-5a29f96489e9\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/key \"answer\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/type :answer-field.type/radio] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"08b72347-1d8d-50a3-bb44-5acc1af00891\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"a56b2967-5d58-588f-8aa2-576b19eb8329\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\"] [\"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/correct \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\"] [\"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/id #uuid \"52f1aee4-b8af-504c-92b3-9b4debebc7db\"] [\"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/worked-solution \"Let $u=\\\\frac{2 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 4 x^{2}}=5\\\\sqrt{1-(\\\\frac{2 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{5}\\\\cdot \\\\frac{5}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/difficulty :question.difficulty/hard] [\"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/answer-fields \"b5f52558-6f4e-5657-8e84-5a29f96489e9\"] [17592186064218 :knowledge-point/questions \"52f1aee4-b8af-504c-92b3-9b4debebc7db\"] [\"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\" :answer/id #uuid \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\"] [\"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\" :answer/type :answer.type/math] [\"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C\"] [\"1acdab75-b682-5d89-ba17-ef276f394c2f\" :answer/id #uuid \"1acdab75-b682-5d89-ba17-ef276f394c2f\"] [\"1acdab75-b682-5d89-ba17-ef276f394c2f\" :answer/type :answer.type/math] [\"1acdab75-b682-5d89-ba17-ef276f394c2f\" :answer/value \"-1\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"828afea6-4215-56e4-94ab-9886a6888c55\" :answer/id #uuid \"828afea6-4215-56e4-94ab-9886a6888c55\"] [\"828afea6-4215-56e4-94ab-9886a6888c55\" :answer/type :answer.type/math] [\"828afea6-4215-56e4-94ab-9886a6888c55\" :answer/value \"\\\\arcsin{\\\\left(x \\\\right)}+C\"] [\"2f6f1436-fadd-5101-aa8b-be44f17bc594\" :answer/id #uuid \"2f6f1436-fadd-5101-aa8b-be44f17bc594\"] [\"2f6f1436-fadd-5101-aa8b-be44f17bc594\" :answer/type :answer.type/math] [\"2f6f1436-fadd-5101-aa8b-be44f17bc594\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}+C\"] [\"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\" :answer/id #uuid \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\"] [\"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\" :answer/type :answer.type/math] [\"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/id #uuid \"615685fd-3c77-5732-ab7a-0dd80584e0da\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/key \"answer\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/type :answer-field.type/radio] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"1acdab75-b682-5d89-ba17-ef276f394c2f\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"828afea6-4215-56e4-94ab-9886a6888c55\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"2f6f1436-fadd-5101-aa8b-be44f17bc594\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\"] [\"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/correct \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\"] [\"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/id #uuid \"95398754-8d8a-50d4-bfa4-4cf30d049a32\"] [\"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot \\\\frac{3}{4}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C.\\n$$\"] [\"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/difficulty :question.difficulty/hard] [\"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/answer-fields \"615685fd-3c77-5732-ab7a-0dd80584e0da\"] [17592186064218 :knowledge-point/questions \"95398754-8d8a-50d4-bfa4-4cf30d049a32\"] [\"fd6c2c84-bed1-5d08-abac-17fbbc982558\" :answer/id #uuid \"fd6c2c84-bed1-5d08-abac-17fbbc982558\"] [\"fd6c2c84-bed1-5d08-abac-17fbbc982558\" :answer/type :answer.type/math] [\"fd6c2c84-bed1-5d08-abac-17fbbc982558\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"885e4496-b864-582d-8ccb-3dac8e719b70\" :answer/id #uuid \"885e4496-b864-582d-8ccb-3dac8e719b70\"] [\"885e4496-b864-582d-8ccb-3dac8e719b70\" :answer/type :answer.type/math] [\"885e4496-b864-582d-8ccb-3dac8e719b70\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"bd8af89a-b0b5-5864-a25f-58ec78587fb0\" :answer/id #uuid \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\"] [\"bd8af89a-b0b5-5864-a25f-58ec78587fb0\" :answer/type :answer.type/math] [\"bd8af89a-b0b5-5864-a25f-58ec78587fb0\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(3 x \\\\right)}\\\\right)+C\"] [\"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\" :answer/id #uuid \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\"] [\"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\" :answer/type :answer.type/math] [\"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\" :answer/id #uuid \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\"] [\"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\" :answer/type :answer.type/math] [\"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/id #uuid \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/key \"answer\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/type :answer-field.type/radio] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"fd6c2c84-bed1-5d08-abac-17fbbc982558\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"885e4496-b864-582d-8ccb-3dac8e719b70\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\"] [\"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/correct \"fd6c2c84-bed1-5d08-abac-17fbbc982558\"] [\"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/id #uuid \"fc157b00-d7e7-54d0-826d-effc6b6af186\"] [\"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 9 x^{2}}=2\\\\sqrt{1-(\\\\frac{3 x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/difficulty :question.difficulty/hard] [\"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/answer-fields \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\"] [17592186064218 :knowledge-point/questions \"fc157b00-d7e7-54d0-826d-effc6b6af186\"] [\"b526d407-065c-533d-93e3-9ea5f1332b0e\" :answer/id #uuid \"b526d407-065c-533d-93e3-9ea5f1332b0e\"] [\"b526d407-065c-533d-93e3-9ea5f1332b0e\" :answer/type :answer.type/math] [\"b526d407-065c-533d-93e3-9ea5f1332b0e\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"c3001b48-6ddc-521b-af95-0c903c6503e9\" :answer/id #uuid \"c3001b48-6ddc-521b-af95-0c903c6503e9\"] [\"c3001b48-6ddc-521b-af95-0c903c6503e9\" :answer/type :answer.type/math] [\"c3001b48-6ddc-521b-af95-0c903c6503e9\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"5f5f6896-99ec-5450-b967-0f6484905f41\" :answer/id #uuid \"5f5f6896-99ec-5450-b967-0f6484905f41\"] [\"5f5f6896-99ec-5450-b967-0f6484905f41\" :answer/type :answer.type/math] [\"5f5f6896-99ec-5450-b967-0f6484905f41\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"5ac1e959-c44f-5d3b-a1af-13053534d0c2\" :answer/id #uuid \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\"] [\"5ac1e959-c44f-5d3b-a1af-13053534d0c2\" :answer/type :answer.type/math] [\"5ac1e959-c44f-5d3b-a1af-13053534d0c2\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}+C\"] [\"f504165f-c125-5f04-b99b-691c923b2e8c\" :answer/id #uuid \"f504165f-c125-5f04-b99b-691c923b2e8c\"] [\"f504165f-c125-5f04-b99b-691c923b2e8c\" :answer/type :answer.type/math] [\"f504165f-c125-5f04-b99b-691c923b2e8c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/id #uuid \"f37425f2-9e9d-529b-af95-954c964ee874\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/key \"answer\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/type :answer-field.type/radio] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"b526d407-065c-533d-93e3-9ea5f1332b0e\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"c3001b48-6ddc-521b-af95-0c903c6503e9\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"5f5f6896-99ec-5450-b967-0f6484905f41\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"f504165f-c125-5f04-b99b-691c923b2e8c\"] [\"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/correct \"b526d407-065c-533d-93e3-9ea5f1332b0e\"] [\"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/id #uuid \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\"] [\"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 16 x^{2}}=5\\\\sqrt{1-(\\\\frac{4 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{5}\\\\cdot \\\\frac{5}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/difficulty :question.difficulty/hard] [\"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/answer-fields \"f37425f2-9e9d-529b-af95-954c964ee874\"] [17592186064218 :knowledge-point/questions \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\"] [\"2b95f833-3727-5b82-a0b9-62d47a3cad6c\" :answer/id #uuid \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\"] [\"2b95f833-3727-5b82-a0b9-62d47a3cad6c\" :answer/type :answer.type/math] [\"2b95f833-3727-5b82-a0b9-62d47a3cad6c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"759df803-6604-5f74-8d24-995191965a98\" :answer/id #uuid \"759df803-6604-5f74-8d24-995191965a98\"] [\"759df803-6604-5f74-8d24-995191965a98\" :answer/type :answer.type/math] [\"759df803-6604-5f74-8d24-995191965a98\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [\"eb05b373-f44f-5b50-bd4f-6035726fa42a\" :answer/id #uuid \"eb05b373-f44f-5b50-bd4f-6035726fa42a\"] [\"eb05b373-f44f-5b50-bd4f-6035726fa42a\" :answer/type :answer.type/math] [\"eb05b373-f44f-5b50-bd4f-6035726fa42a\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"75420b2f-62f9-5911-8c27-602ceb2ddbd5\" :answer/id #uuid \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\"] [\"75420b2f-62f9-5911-8c27-602ceb2ddbd5\" :answer/type :answer.type/math] [\"75420b2f-62f9-5911-8c27-602ceb2ddbd5\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"18fa3ff5-c139-505f-930f-720705667266\" :answer/id #uuid \"18fa3ff5-c139-505f-930f-720705667266\"] [\"18fa3ff5-c139-505f-930f-720705667266\" :answer/type :answer.type/math] [\"18fa3ff5-c139-505f-930f-720705667266\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/id #uuid \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/key \"answer\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/type :answer-field.type/radio] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"759df803-6604-5f74-8d24-995191965a98\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"eb05b373-f44f-5b50-bd4f-6035726fa42a\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"18fa3ff5-c139-505f-930f-720705667266\"] [\"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/correct \"eb05b373-f44f-5b50-bd4f-6035726fa42a\"] [\"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/id #uuid \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\"] [\"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/difficulty :question.difficulty/hard] [\"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/answer-fields \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\"] [17592186064218 :knowledge-point/questions \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\"] [\"8c81ff3f-41ae-5271-9b29-60734641f927\" :answer/id #uuid \"8c81ff3f-41ae-5271-9b29-60734641f927\"] [\"8c81ff3f-41ae-5271-9b29-60734641f927\" :answer/type :answer.type/math] [\"8c81ff3f-41ae-5271-9b29-60734641f927\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\" :answer/id #uuid \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\"] [\"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\" :answer/type :answer.type/math] [\"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"1d8822d2-d398-5247-b1e1-89c9fbaa9679\" :answer/id #uuid \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\"] [\"1d8822d2-d398-5247-b1e1-89c9fbaa9679\" :answer/type :answer.type/math] [\"1d8822d2-d398-5247-b1e1-89c9fbaa9679\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"eca0154b-2389-5640-8f69-7d0dca65c473\" :answer/id #uuid \"eca0154b-2389-5640-8f69-7d0dca65c473\"] [\"eca0154b-2389-5640-8f69-7d0dca65c473\" :answer/type :answer.type/math] [\"eca0154b-2389-5640-8f69-7d0dca65c473\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"a912984b-e9a9-5928-9964-e95ce039ce3d\" :answer/id #uuid \"a912984b-e9a9-5928-9964-e95ce039ce3d\"] [\"a912984b-e9a9-5928-9964-e95ce039ce3d\" :answer/type :answer.type/math] [\"a912984b-e9a9-5928-9964-e95ce039ce3d\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/id #uuid \"b2441de9-3ddd-5f87-b0b9-544a72b51646\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/key \"answer\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/type :answer-field.type/radio] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"8c81ff3f-41ae-5271-9b29-60734641f927\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"eca0154b-2389-5640-8f69-7d0dca65c473\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"a912984b-e9a9-5928-9964-e95ce039ce3d\"] [\"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/correct \"a912984b-e9a9-5928-9964-e95ce039ce3d\"] [\"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/id #uuid \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\"] [\"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [\"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/difficulty :question.difficulty/hard] [\"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/answer-fields \"b2441de9-3ddd-5f87-b0b9-544a72b51646\"] [17592186064218 :knowledge-point/questions \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\"] [\"ca5b2f59-a145-587b-a4c1-a9609a57f58b\" :answer/id #uuid \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\"] [\"ca5b2f59-a145-587b-a4c1-a9609a57f58b\" :answer/type :answer.type/math] [\"ca5b2f59-a145-587b-a4c1-a9609a57f58b\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"18c0ccdc-170c-54ad-a845-5dc98b396090\" :answer/id #uuid \"18c0ccdc-170c-54ad-a845-5dc98b396090\"] [\"18c0ccdc-170c-54ad-a845-5dc98b396090\" :answer/type :answer.type/math] [\"18c0ccdc-170c-54ad-a845-5dc98b396090\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"4fb81696-331e-59ed-86c1-f465803f114c\" :answer/id #uuid \"4fb81696-331e-59ed-86c1-f465803f114c\"] [\"4fb81696-331e-59ed-86c1-f465803f114c\" :answer/type :answer.type/math] [\"4fb81696-331e-59ed-86c1-f465803f114c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\" :answer/id #uuid \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\"] [\"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\" :answer/type :answer.type/math] [\"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"30c69d46-ccea-5283-825f-948729033a54\" :answer/id #uuid \"30c69d46-ccea-5283-825f-948729033a54\"] [\"30c69d46-ccea-5283-825f-948729033a54\" :answer/type :answer.type/math] [\"30c69d46-ccea-5283-825f-948729033a54\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/id #uuid \"e0acea2b-037a-53c7-8970-eccae40b99e8\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/key \"answer\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/type :answer-field.type/radio] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"18c0ccdc-170c-54ad-a845-5dc98b396090\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"4fb81696-331e-59ed-86c1-f465803f114c\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"30c69d46-ccea-5283-825f-948729033a54\"] [\"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/correct \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\"] [\"39b99761-df6d-539c-9682-f60f84447665\" :question/id #uuid \"39b99761-df6d-539c-9682-f60f84447665\"] [\"39b99761-df6d-539c-9682-f60f84447665\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"39b99761-df6d-539c-9682-f60f84447665\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 4 x^{2}}=3\\\\sqrt{1-(\\\\frac{2 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{3}{2}=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"39b99761-df6d-539c-9682-f60f84447665\" :question/difficulty :question.difficulty/hard] [\"39b99761-df6d-539c-9682-f60f84447665\" :question/answer-fields \"e0acea2b-037a-53c7-8970-eccae40b99e8\"] [17592186064218 :knowledge-point/questions \"39b99761-df6d-539c-9682-f60f84447665\"] [\"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\" :answer/id #uuid \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\"] [\"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\" :answer/type :answer.type/math] [\"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\" :answer/id #uuid \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\"] [\"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\" :answer/type :answer.type/math] [\"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"794542e2-c977-50b8-bbc4-5ccd21d90e77\" :answer/id #uuid \"794542e2-c977-50b8-bbc4-5ccd21d90e77\"] [\"794542e2-c977-50b8-bbc4-5ccd21d90e77\" :answer/type :answer.type/math] [\"794542e2-c977-50b8-bbc4-5ccd21d90e77\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"4fd68a63-724f-574a-9786-f070580733ef\" :answer/id #uuid \"4fd68a63-724f-574a-9786-f070580733ef\"] [\"4fd68a63-724f-574a-9786-f070580733ef\" :answer/type :answer.type/math] [\"4fd68a63-724f-574a-9786-f070580733ef\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"ac33763f-f131-5c90-880a-c09f293ca8ab\" :answer/id #uuid \"ac33763f-f131-5c90-880a-c09f293ca8ab\"] [\"ac33763f-f131-5c90-880a-c09f293ca8ab\" :answer/type :answer.type/math] [\"ac33763f-f131-5c90-880a-c09f293ca8ab\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/id #uuid \"df13b46b-41af-526b-af54-045674b5bdef\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/key \"answer\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/type :answer-field.type/radio] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"794542e2-c977-50b8-bbc4-5ccd21d90e77\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"4fd68a63-724f-574a-9786-f070580733ef\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"ac33763f-f131-5c90-880a-c09f293ca8ab\"] [\"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/correct \"794542e2-c977-50b8-bbc4-5ccd21d90e77\"] [\"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/id #uuid \"3c7be681-6a2d-5a04-a101-13d325e163c6\"] [\"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [\"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/difficulty :question.difficulty/hard] [\"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/answer-fields \"df13b46b-41af-526b-af54-045674b5bdef\"] [17592186064218 :knowledge-point/questions \"3c7be681-6a2d-5a04-a101-13d325e163c6\"] [\"generator\" :question-generator/id #uuid \"a1179086-44c6-5401-89a0-90db05f0228b\"] [\"generator\" :question-generator/script \"generators/47/4768c628b8460329222e9662c2d7f5d485467d218c62d3e9d0740b180c83de2e/generator.py\"] [17592186064218 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186064218 :knowledge-point/question-generator 17592186676703]]}",
