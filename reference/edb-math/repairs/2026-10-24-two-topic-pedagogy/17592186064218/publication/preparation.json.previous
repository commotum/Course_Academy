  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"3968c072-6d48-5bec-a420-8439d836c6b2\" :answer/id #uuid \"3968c072-6d48-5bec-a420-8439d836c6b2\"] [:db/add \"3968c072-6d48-5bec-a420-8439d836c6b2\" :answer/type :answer.type/math] [:db/add \"3968c072-6d48-5bec-a420-8439d836c6b2\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"3968c072-6d48-5bec-a420-8439d836c6b2\" :answer/validate] [:db/add \"2c96687f-5c24-59ee-b156-32e668c87f16\" :answer/id #uuid \"2c96687f-5c24-59ee-b156-32e668c87f16\"] [:db/add \"2c96687f-5c24-59ee-b156-32e668c87f16\" :answer/type :answer.type/math] [:db/add \"2c96687f-5c24-59ee-b156-32e668c87f16\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"2c96687f-5c24-59ee-b156-32e668c87f16\" :answer/validate] [:db/add \"582505f8-ba15-5a46-b508-e81560ebe2f1\" :answer/id #uuid \"582505f8-ba15-5a46-b508-e81560ebe2f1\"] [:db/add \"582505f8-ba15-5a46-b508-e81560ebe2f1\" :answer/type :answer.type/math] [:db/add \"582505f8-ba15-5a46-b508-e81560ebe2f1\" :answer/value \"\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"582505f8-ba15-5a46-b508-e81560ebe2f1\" :answer/validate] [:db/add \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\" :answer/id #uuid \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\"] [:db/add \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\" :answer/type :answer.type/math] [:db/add \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\" :answer/validate] [:db/add \"94ce8c50-20be-53e5-afdf-217ef133e4a1\" :answer/id #uuid \"94ce8c50-20be-53e5-afdf-217ef133e4a1\"] [:db/add \"94ce8c50-20be-53e5-afdf-217ef133e4a1\" :answer/type :answer.type/math] [:db/add \"94ce8c50-20be-53e5-afdf-217ef133e4a1\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"94ce8c50-20be-53e5-afdf-217ef133e4a1\" :answer/validate] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/id #uuid \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\"] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/key \"answer\"] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/type :answer-field.type/radio] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"3968c072-6d48-5bec-a420-8439d836c6b2\"] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"2c96687f-5c24-59ee-b156-32e668c87f16\"] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"582505f8-ba15-5a46-b508-e81560ebe2f1\"] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\"] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"94ce8c50-20be-53e5-afdf-217ef133e4a1\"] [:db/add \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/correct \"94ce8c50-20be-53e5-afdf-217ef133e4a1\"] [:db/ensure \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/validate] [:db/add \"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/id #uuid \"c021fecf-8c5b-589c-8771-db1b81163d9d\"] [:db/add \"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/difficulty :question.difficulty/easy] [:db/add \"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/answer-fields \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\"] [:db/ensure \"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"c021fecf-8c5b-589c-8771-db1b81163d9d\"] [:db/add \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\" :answer/id #uuid \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\"] [:db/add \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\" :answer/type :answer.type/math] [:db/add \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\" :answer/value \"6\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\" :answer/validate] [:db/add \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\" :answer/id #uuid \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\"] [:db/add \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\" :answer/type :answer.type/math] [:db/add \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\" :answer/validate] [:db/add \"e331b53e-597e-5c3b-9200-ede00836568a\" :answer/id #uuid \"e331b53e-597e-5c3b-9200-ede00836568a\"] [:db/add \"e331b53e-597e-5c3b-9200-ede00836568a\" :answer/type :answer.type/math] [:db/add \"e331b53e-597e-5c3b-9200-ede00836568a\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"e331b53e-597e-5c3b-9200-ede00836568a\" :answer/validate] [:db/add \"c56f6fab-4e71-5ed0-a069-617265500c0a\" :answer/id #uuid \"c56f6fab-4e71-5ed0-a069-617265500c0a\"] [:db/add \"c56f6fab-4e71-5ed0-a069-617265500c0a\" :answer/type :answer.type/math] [:db/add \"c56f6fab-4e71-5ed0-a069-617265500c0a\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c56f6fab-4e71-5ed0-a069-617265500c0a\" :answer/validate] [:db/add \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\" :answer/id #uuid \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\"] [:db/add \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\" :answer/type :answer.type/math] [:db/add \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\" :answer/validate] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/id #uuid \"2b372f51-a7ea-583f-a5ed-d80be5885bec\"] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/key \"answer\"] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/type :answer-field.type/radio] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\"] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\"] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"e331b53e-597e-5c3b-9200-ede00836568a\"] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"c56f6fab-4e71-5ed0-a069-617265500c0a\"] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\"] [:db/add \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/correct \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\"] [:db/ensure \"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/validate] [:db/add \"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/id #uuid \"fb029deb-8ef6-58b3-a661-41132a65c264\"] [:db/add \"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/difficulty :question.difficulty/easy] [:db/add \"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/answer-fields \"2b372f51-a7ea-583f-a5ed-d80be5885bec\"] [:db/ensure \"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"fb029deb-8ef6-58b3-a661-41132a65c264\"] [:db/add \"b3039614-011a-5cd1-a53f-cd9c58c194cd\" :answer/id #uuid \"b3039614-011a-5cd1-a53f-cd9c58c194cd\"] [:db/add \"b3039614-011a-5cd1-a53f-cd9c58c194cd\" :answer/type :answer.type/math] [:db/add \"b3039614-011a-5cd1-a53f-cd9c58c194cd\" :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b3039614-011a-5cd1-a53f-cd9c58c194cd\" :answer/validate] [:db/add \"cfa93d76-404c-5faf-8767-da03396a0064\" :answer/id #uuid \"cfa93d76-404c-5faf-8767-da03396a0064\"] [:db/add \"cfa93d76-404c-5faf-8767-da03396a0064\" :answer/type :answer.type/math] [:db/add \"cfa93d76-404c-5faf-8767-da03396a0064\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"cfa93d76-404c-5faf-8767-da03396a0064\" :answer/validate] [:db/add \"341f18c5-a64d-51da-b3c9-0e33a31d3081\" :answer/id #uuid \"341f18c5-a64d-51da-b3c9-0e33a31d3081\"] [:db/add \"341f18c5-a64d-51da-b3c9-0e33a31d3081\" :answer/type :answer.type/math] [:db/add \"341f18c5-a64d-51da-b3c9-0e33a31d3081\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"341f18c5-a64d-51da-b3c9-0e33a31d3081\" :answer/validate] [:db/add \"5663ccb7-8a71-5fff-b639-20a8f8e96775\" :answer/id #uuid \"5663ccb7-8a71-5fff-b639-20a8f8e96775\"] [:db/add \"5663ccb7-8a71-5fff-b639-20a8f8e96775\" :answer/type :answer.type/math] [:db/add \"5663ccb7-8a71-5fff-b639-20a8f8e96775\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5663ccb7-8a71-5fff-b639-20a8f8e96775\" :answer/validate] [:db/add \"b182d25a-15aa-5336-98e9-a7f3132880e7\" :answer/id #uuid \"b182d25a-15aa-5336-98e9-a7f3132880e7\"] [:db/add \"b182d25a-15aa-5336-98e9-a7f3132880e7\" :answer/type :answer.type/math] [:db/add \"b182d25a-15aa-5336-98e9-a7f3132880e7\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b182d25a-15aa-5336-98e9-a7f3132880e7\" :answer/validate] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/id #uuid \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\"] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/key \"answer\"] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/type :answer-field.type/radio] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"b3039614-011a-5cd1-a53f-cd9c58c194cd\"] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"cfa93d76-404c-5faf-8767-da03396a0064\"] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"341f18c5-a64d-51da-b3c9-0e33a31d3081\"] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"5663ccb7-8a71-5fff-b639-20a8f8e96775\"] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"b182d25a-15aa-5336-98e9-a7f3132880e7\"] [:db/add \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/correct \"341f18c5-a64d-51da-b3c9-0e33a31d3081\"] [:db/ensure \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/validate] [:db/add \"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/id #uuid \"f6c30885-76ce-51d3-9a6a-a97590ca0793\"] [:db/add \"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/difficulty :question.difficulty/easy] [:db/add \"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/answer-fields \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\"] [:db/ensure \"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"f6c30885-76ce-51d3-9a6a-a97590ca0793\"] [:db/add \"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\" :answer/id #uuid \"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\"] [:db/add \"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\" :answer/type :answer.type/math] [:db/add \"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\" :answer/validate] [:db/add \"cb492358-2a4f-57b7-9846-8708615ffde4\" :answer/id #uuid \"cb492358-2a4f-57b7-9846-8708615ffde4\"] [:db/add \"cb492358-2a4f-57b7-9846-8708615ffde4\" :answer/type :answer.type/math] [:db/add \"cb492358-2a4f-57b7-9846-8708615ffde4\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"cb492358-2a4f-57b7-9846-8708615ffde4\" :answer/validate] [:db/add \"5d5ed854-b9ed-5219-a0b0-3d81f45a7377\" :answer/id #uuid \"5d5ed854-b9ed-5219-a0b0-3d81f45a7377\"] [:db/add \"5d5ed854-b9ed-5219-a0b0-3d81f45a7377\" :answer/type :answer.type/math] [:db/add \"5d5ed854-b9ed-5219-a0b0-3d81f45a7377\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5d5ed854-b9ed-5219-a0b0-3d81f45a7377\" :answer/validate] [:db/add \"780d3193-0695-532d-a668-4b169c1cf938\" :answer/id #uuid \"780d3193-0695-532d-a668-4b169c1cf938\"] [:db/add \"780d3193-0695-532d-a668-4b169c1cf938\" :answer/type :answer.type/math] [:db/add \"780d3193-0695-532d-a668-4b169c1cf938\" :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"780d3193-0695-532d-a668-4b169c1cf938\" :answer/validate] [:db/add \"40fc3281-0eea-5236-8a2b-11f0a488cfea\" :answer/id #uuid \"40fc3281-0eea-5236-8a2b-11f0a488cfea\"] [:db/add \"40fc3281-0eea-5236-8a2b-11f0a488cfea\" :answer/type :answer.type/math] [:db/add \"40fc3281-0eea-5236-8a2b-11f0a488cfea\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"40fc3281-0eea-5236-8a2b-11f0a488cfea\" :answer/validate] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/id #uuid \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\"] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/key \"answer\"] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/type :answer-field.type/radio] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/choices \"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\"] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/choices \"cb492358-2a4f-57b7-9846-8708615ffde4\"] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/choices \"5d5ed854-b9ed-5219-a0b0-3d81f45a7377\"] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/choices \"780d3193-0695-532d-a668-4b169c1cf938\"] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/choices \"40fc3281-0eea-5236-8a2b-11f0a488cfea\"] [:db/add \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/correct \"40fc3281-0eea-5236-8a2b-11f0a488cfea\"] [:db/ensure \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\" :answer-field/validate] [:db/add \"e12dc745-abce-5812-b492-6e0780c3315d\" :question/id #uuid \"e12dc745-abce-5812-b492-6e0780c3315d\"] [:db/add \"e12dc745-abce-5812-b492-6e0780c3315d\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"e12dc745-abce-5812-b492-6e0780c3315d\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"e12dc745-abce-5812-b492-6e0780c3315d\" :question/difficulty :question.difficulty/easy] [:db/add \"e12dc745-abce-5812-b492-6e0780c3315d\" :question/answer-fields \"3f3ca8c3-d2f3-52d4-af78-48dcee29b291\"] [:db/ensure \"e12dc745-abce-5812-b492-6e0780c3315d\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"e12dc745-abce-5812-b492-6e0780c3315d\"] [:db/add \"afd5b943-d049-5eb8-b107-9e6bb8be855a\" :answer/id #uuid \"afd5b943-d049-5eb8-b107-9e6bb8be855a\"] [:db/add \"afd5b943-d049-5eb8-b107-9e6bb8be855a\" :answer/type :answer.type/math] [:db/add \"afd5b943-d049-5eb8-b107-9e6bb8be855a\" :answer/value \"\\\\frac{8}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"afd5b943-d049-5eb8-b107-9e6bb8be855a\" :answer/validate] [:db/add \"6b69c1df-5719-5660-bc08-94522be97370\" :answer/id #uuid \"6b69c1df-5719-5660-bc08-94522be97370\"] [:db/add \"6b69c1df-5719-5660-bc08-94522be97370\" :answer/type :answer.type/math] [:db/add \"6b69c1df-5719-5660-bc08-94522be97370\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6b69c1df-5719-5660-bc08-94522be97370\" :answer/validate] [:db/add \"04f5c5dd-6688-5932-8348-558ae295d66c\" :answer/id #uuid \"04f5c5dd-6688-5932-8348-558ae295d66c\"] [:db/add \"04f5c5dd-6688-5932-8348-558ae295d66c\" :answer/type :answer.type/math] [:db/add \"04f5c5dd-6688-5932-8348-558ae295d66c\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"04f5c5dd-6688-5932-8348-558ae295d66c\" :answer/validate] [:db/add \"40bc2141-0918-55ec-a796-98de8e551029\" :answer/id #uuid \"40bc2141-0918-55ec-a796-98de8e551029\"] [:db/add \"40bc2141-0918-55ec-a796-98de8e551029\" :answer/type :answer.type/math] [:db/add \"40bc2141-0918-55ec-a796-98de8e551029\" :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"40bc2141-0918-55ec-a796-98de8e551029\" :answer/validate] [:db/add \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\" :answer/id #uuid \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\"] [:db/add \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\" :answer/type :answer.type/math] [:db/add \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\" :answer/value \"\\\\frac{12}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\" :answer/validate] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/id #uuid \"d6400655-57d6-56de-9338-d26c5af23a59\"] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/key \"answer\"] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/type :answer-field.type/radio] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"afd5b943-d049-5eb8-b107-9e6bb8be855a\"] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"6b69c1df-5719-5660-bc08-94522be97370\"] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"04f5c5dd-6688-5932-8348-558ae295d66c\"] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"40bc2141-0918-55ec-a796-98de8e551029\"] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/choices \"6eafb85e-ad4a-52a4-8a85-a3480937d1c9\"] [:db/add \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/correct \"04f5c5dd-6688-5932-8348-558ae295d66c\"] [:db/ensure \"d6400655-57d6-56de-9338-d26c5af23a59\" :answer-field/validate] [:db/add \"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/id #uuid \"a309d297-74a3-52d4-8716-b7be3f2a61d6\"] [:db/add \"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{5}=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/difficulty :question.difficulty/easy] [:db/add \"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/answer-fields \"d6400655-57d6-56de-9338-d26c5af23a59\"] [:db/ensure \"a309d297-74a3-52d4-8716-b7be3f2a61d6\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"a309d297-74a3-52d4-8716-b7be3f2a61d6\"] [:db/add \"0d5c0687-4efd-5652-b3bd-594ec5837754\" :answer/id #uuid \"0d5c0687-4efd-5652-b3bd-594ec5837754\"] [:db/add \"0d5c0687-4efd-5652-b3bd-594ec5837754\" :answer/type :answer.type/math] [:db/add \"0d5c0687-4efd-5652-b3bd-594ec5837754\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"0d5c0687-4efd-5652-b3bd-594ec5837754\" :answer/validate] [:db/add \"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\" :answer/id #uuid \"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\"] [:db/add \"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\" :answer/type :answer.type/math] [:db/add \"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"ace46999-c3dd-5fa3-86b2-3c8a780c40ac\" :answer/validate] [:db/add \"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\" :answer/id #uuid \"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\"] [:db/add \"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\" :answer/type :answer.type/math] [:db/add \"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d08a7364-3a5d-5686-af46-dbf0e52e9bbb\" :answer/validate] [:db/add \"49e263c4-69f7-5f57-aeb0-f901993f64fc\" :answer/id #uuid \"49e263c4-69f7-5f57-aeb0-f90