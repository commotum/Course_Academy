)\"] [:db/ensure \"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\" :answer/validate] [:db/add \"14d7fe58-cb78-5376-b60d-1710c7c0662a\" :answer/id #uuid \"14d7fe58-cb78-5376-b60d-1710c7c0662a\"] [:db/add \"14d7fe58-cb78-5376-b60d-1710c7c0662a\" :answer/type :answer.type/math] [:db/add \"14d7fe58-cb78-5376-b60d-1710c7c0662a\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"14d7fe58-cb78-5376-b60d-1710c7c0662a\" :answer/validate] [:db/add \"e257c8e8-5775-556c-8eb5-b374de8783aa\" :answer/id #uuid \"e257c8e8-5775-556c-8eb5-b374de8783aa\"] [:db/add \"e257c8e8-5775-556c-8eb5-b374de8783aa\" :answer/type :answer.type/math] [:db/add \"e257c8e8-5775-556c-8eb5-b374de8783aa\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e257c8e8-5775-556c-8eb5-b374de8783aa\" :answer/validate] [:db/add \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\" :answer/id #uuid \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\"] [:db/add \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\" :answer/type :answer.type/math] [:db/add \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\" :answer/value \"- \\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\" :answer/validate] [:db/add \"547ac542-6f7d-5596-9293-e57946cc34eb\" :answer/id #uuid \"547ac542-6f7d-5596-9293-e57946cc34eb\"] [:db/add \"547ac542-6f7d-5596-9293-e57946cc34eb\" :answer/type :answer.type/math] [:db/add \"547ac542-6f7d-5596-9293-e57946cc34eb\" :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"547ac542-6f7d-5596-9293-e57946cc34eb\" :answer/validate] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/id #uuid \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\"] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/key \"answer\"] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/type :answer-field.type/radio] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\"] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"14d7fe58-cb78-5376-b60d-1710c7c0662a\"] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"e257c8e8-5775-556c-8eb5-b374de8783aa\"] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"e0cd734a-beb6-57fe-8f5e-6f78c41eed1c\"] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/choices \"547ac542-6f7d-5596-9293-e57946cc34eb\"] [:db/add \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/correct \"8d1f2360-21bc-5f68-88a5-9081d8a5db6f\"] [:db/ensure \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\" :answer-field/validate] [:db/add \"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/id #uuid \"9877a1da-e8db-570d-b287-71b1a27bf31c\"] [:db/add \"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/difficulty :question.difficulty/easy] [:db/add \"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/answer-fields \"0b80b793-31e4-545c-98f5-2c930dc2ac0d\"] [:db/ensure \"9877a1da-e8db-570d-b287-71b1a27bf31c\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"9877a1da-e8db-570d-b287-71b1a27bf31c\"] [:db/add \"1a7d2026-21a1-52ec-9b49-5220db72316a\" :answer/id #uuid \"1a7d2026-21a1-52ec-9b49-5220db72316a\"] [:db/add \"1a7d2026-21a1-52ec-9b49-5220db72316a\" :answer/type :answer.type/math] [:db/add \"1a7d2026-21a1-52ec-9b49-5220db72316a\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"1a7d2026-21a1-52ec-9b49-5220db72316a\" :answer/validate] [:db/add \"6e9d6bf9-ce93-5519-891b-3931898ec663\" :answer/id #uuid \"6e9d6bf9-ce93-5519-891b-3931898ec663\"] [:db/add \"6e9d6bf9-ce93-5519-891b-3931898ec663\" :answer/type :answer.type/math] [:db/add \"6e9d6bf9-ce93-5519-891b-3931898ec663\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"6e9d6bf9-ce93-5519-891b-3931898ec663\" :answer/validate] [:db/add \"14265516-ae65-532c-a184-fefd886b2e37\" :answer/id #uuid \"14265516-ae65-532c-a184-fefd886b2e37\"] [:db/add \"14265516-ae65-532c-a184-fefd886b2e37\" :answer/type :answer.type/math] [:db/add \"14265516-ae65-532c-a184-fefd886b2e37\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"14265516-ae65-532c-a184-fefd886b2e37\" :answer/validate] [:db/add \"5bc45f87-f239-562e-bfa0-5cddadaefef6\" :answer/id #uuid \"5bc45f87-f239-562e-bfa0-5cddadaefef6\"] [:db/add \"5bc45f87-f239-562e-bfa0-5cddadaefef6\" :answer/type :answer.type/math] [:db/add \"5bc45f87-f239-562e-bfa0-5cddadaefef6\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"5bc45f87-f239-562e-bfa0-5cddadaefef6\" :answer/validate] [:db/add \"0d992567-a619-5037-8f15-12c042da49ad\" :answer/id #uuid \"0d992567-a619-5037-8f15-12c042da49ad\"] [:db/add \"0d992567-a619-5037-8f15-12c042da49ad\" :answer/type :answer.type/math] [:db/add \"0d992567-a619-5037-8f15-12c042da49ad\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"0d992567-a619-5037-8f15-12c042da49ad\" :answer/validate] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/id #uuid \"0773353a-1ec6-50c4-977d-1ad00bcff537\"] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/key \"answer\"] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/type :answer-field.type/radio] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"1a7d2026-21a1-52ec-9b49-5220db72316a\"] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"6e9d6bf9-ce93-5519-891b-3931898ec663\"] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"14265516-ae65-532c-a184-fefd886b2e37\"] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"5bc45f87-f239-562e-bfa0-5cddadaefef6\"] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/choices \"0d992567-a619-5037-8f15-12c042da49ad\"] [:db/add \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/correct \"14265516-ae65-532c-a184-fefd886b2e37\"] [:db/ensure \"0773353a-1ec6-50c4-977d-1ad00bcff537\" :answer-field/validate] [:db/add \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/id #uuid \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\"] [:db/add \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{3}\\\\cdot 3=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/difficulty :question.difficulty/moderate] [:db/add \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/answer-fields \"0773353a-1ec6-50c4-977d-1ad00bcff537\"] [:db/ensure \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"b1ca9dbc-ef6c-5002-b937-e30b39dc0a9b\"] [:db/add \"51e8012a-cb17-5de6-bb38-9993fe24bb83\" :answer/id #uuid \"51e8012a-cb17-5de6-bb38-9993fe24bb83\"] [:db/add \"51e8012a-cb17-5de6-bb38-9993fe24bb83\" :answer/type :answer.type/math] [:db/add \"51e8012a-cb17-5de6-bb38-9993fe24bb83\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"51e8012a-cb17-5de6-bb38-9993fe24bb83\" :answer/validate] [:db/add \"48199f27-9acc-5101-a844-84b9b9ec7b0f\" :answer/id #uuid \"48199f27-9acc-5101-a844-84b9b9ec7b0f\"] [:db/add \"48199f27-9acc-5101-a844-84b9b9ec7b0f\" :answer/type :answer.type/math] [:db/add \"48199f27-9acc-5101-a844-84b9b9ec7b0f\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"48199f27-9acc-5101-a844-84b9b9ec7b0f\" :answer/validate] [:db/add \"3e2e1306-8611-5f36-bc4d-5c4b599691be\" :answer/id #uuid \"3e2e1306-8611-5f36-bc4d-5c4b599691be\"] [:db/add \"3e2e1306-8611-5f36-bc4d-5c4b599691be\" :answer/type :answer.type/math] [:db/add \"3e2e1306-8611-5f36-bc4d-5c4b599691be\" :answer/value \"-4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"3e2e1306-8611-5f36-bc4d-5c4b599691be\" :answer/validate] [:db/add \"0ef95243-03d7-5f9b-9964-050a81aafe47\" :answer/id #uuid \"0ef95243-03d7-5f9b-9964-050a81aafe47\"] [:db/add \"0ef95243-03d7-5f9b-9964-050a81aafe47\" :answer/type :answer.type/math] [:db/add \"0ef95243-03d7-5f9b-9964-050a81aafe47\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"0ef95243-03d7-5f9b-9964-050a81aafe47\" :answer/validate] [:db/add \"1cb92fee-7ade-511f-a001-e6edbcd1480c\" :answer/id #uuid \"1cb92fee-7ade-511f-a001-e6edbcd1480c\"] [:db/add \"1cb92fee-7ade-511f-a001-e6edbcd1480c\" :answer/type :answer.type/math] [:db/add \"1cb92fee-7ade-511f-a001-e6edbcd1480c\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"1cb92fee-7ade-511f-a001-e6edbcd1480c\" :answer/validate] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/id #uuid \"908f8536-5dab-5a3b-a7e7-013a3e062230\"] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/key \"answer\"] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/type :answer-field.type/radio] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"51e8012a-cb17-5de6-bb38-9993fe24bb83\"] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"48199f27-9acc-5101-a844-84b9b9ec7b0f\"] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"3e2e1306-8611-5f36-bc4d-5c4b599691be\"] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"0ef95243-03d7-5f9b-9964-050a81aafe47\"] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/choices \"1cb92fee-7ade-511f-a001-e6edbcd1480c\"] [:db/add \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/correct \"0ef95243-03d7-5f9b-9964-050a81aafe47\"] [:db/ensure \"908f8536-5dab-5a3b-a7e7-013a3e062230\" :answer-field/validate] [:db/add \"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/id #uuid \"b7986f5c-b477-564a-b6a1-e6bc8f022405\"] [:db/add \"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot 3=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/difficulty :question.difficulty/moderate] [:db/add \"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/answer-fields \"908f8536-5dab-5a3b-a7e7-013a3e062230\"] [:db/ensure \"b7986f5c-b477-564a-b6a1-e6bc8f022405\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"b7986f5c-b477-564a-b6a1-e6bc8f022405\"] [:db/add \"15788a7e-1a95-512a-95b5-65815c014108\" :answer/id #uuid \"15788a7e-1a95-512a-95b5-65815c014108\"] [:db/add \"15788a7e-1a95-512a-95b5-65815c014108\" :answer/type :answer.type/math] [:db/add \"15788a7e-1a95-512a-95b5-65815c014108\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"15788a7e-1a95-512a-95b5-65815c014108\" :answer/validate] [:db/add \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\" :answer/id #uuid \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\"] [:db/add \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\" :answer/type :answer.type/math] [:db/add \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\" :answer/validate] [:db/add \"108bf616-e497-5cfe-a43c-39590412ca4c\" :answer/id #uuid \"108bf616-e497-5cfe-a43c-39590412ca4c\"] [:db/add \"108bf616-e497-5cfe-a43c-39590412ca4c\" :answer/type :answer.type/math] [:db/add \"108bf616-e497-5cfe-a43c-39590412ca4c\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"108bf616-e497-5cfe-a43c-39590412ca4c\" :answer/validate] [:db/add \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\" :answer/id #uuid \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\"] [:db/add \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\" :answer/type :answer.type/math] [:db/add \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\" :answer/validate] [:db/add \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\" :answer/id #uuid \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\"] [:db/add \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\" :answer/type :answer.type/math] [:db/add \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\" :answer/validate] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/id #uuid \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\"] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/key \"answer\"] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/type :answer-field.type/radio] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"15788a7e-1a95-512a-95b5-65815c014108\"] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"2cafee82-dcfb-58cf-9c2d-bdfde9adaead\"] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"108bf616-e497-5cfe-a43c-39590412ca4c\"] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"b1dc3a1c-fff6-5f5c-9449-e46c51e0d16c\"] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/choices \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\"] [:db/add \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/correct \"4aa4599a-e3d6-51fd-9d45-9f33f5c11d48\"] [:db/ensure \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\" :answer-field/validate] [:db/add \"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/id #uuid \"84707fca-407c-5ae0-9f6b-a8be35d06a68\"] [:db/add \"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 2=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/difficulty :question.difficulty/moderate] [:db/add \"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/answer-fields \"2deeb12d-6b8f-5d0a-add4-d355a28f68ed\"] [:db/ensure \"84707fca-407c-5ae0-9f6b-a8be35d06a68\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"84707fca-407c-5ae0-9f6b-a8be35d06a68\"] [:db/add \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\" :answer/id #uuid \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\"] [:db/add \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\" :answer/type :answer.type/math] [:db/add \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\" :answer/validate] [:db/add \"5927bcef-6929-518c-b557-26b60938610f\" :answer/id #uuid \"5927bcef-6929-518c-b557-26b60938610f\"] [:db/add \"5927bcef-6929-518c-b557-26b60938610f\" :answer/type :answer.type/math] [:db/add \"5927bcef-6929-518c-b557-26b60938610f\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"5927bcef-6929-518c-b557-26b60938610f\" :answer/validate] [:db/add \"fa533c61-318d-5905-aed2-ca6068deae51\" :answer/id #uuid \"fa533c61-318d-5905-aed2-ca6068deae51\"] [:db/add \"fa533c61-318d-5905-aed2-ca6068deae51\" :answer/type :answer.type/math] [:db/add \"fa533c61-318d-5905-aed2-ca6068deae51\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"fa533c61-318d-5905-aed2-ca6068deae51\" :answer/validate] [:db/add \"ec863435-7d34-562d-9caa-2fcaac69afa4\" :answer/id #uuid \"ec863435-7d34-562d-9caa-2fcaac69afa4\"] [:db/add \"ec863435-7d34-562d-9caa-2fcaac69afa4\" :answer/type :answer.type/math] [:db/add \"ec863435-7d34-562d-9caa-2fcaac69afa4\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"ec863435-7d34-562d-9caa-2fcaac69afa4\" :answer/validate] [:db/add \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\" :answer/id #uuid \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\"] [:db/add \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\" :answer/type :answer.type/math] [:db/add \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\" :answer/validate] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/id #uuid \"db182094-1a54-5f8a-aec9-d46031297fe7\"] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/key \"answer\"] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/type :answer-field.type/radio] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"7d67f4c6-5423-5e9b-8bd3-0c8f76153ac7\"] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"5927bcef-6929-518c-b557-26b60938610f\"] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"fa533c61-318d-5905-aed2-ca6068deae51\"] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"ec863435-7d34-562d-9caa-2fcaac69afa4\"] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/choices \"de3b79fe-7b63-5b59-8d76-3b9d1755333b\"] [:db/add \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/correct \"ec863435-7d34-562d-9caa-2fcaac69afa4\"] [:db/ensure \"db182094-1a54-5f8a-aec9-d46031297fe7\" :answer-field/validate] [:db/add \"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/id #uuid \"e9816c5f-db55-5531-9180-8cf55f866d1e\"] [:db/add \"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot 2=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/difficulty :question.difficulty/moderate] [:db/add \"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/answer-fields \"db182094-1a54-5f8a-aec9-d46031297fe7\"] [:db/ensure \"e9816c5f-db55-5531-9180-8cf55f866d1e\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"e9816c5f-db55-5531-9180-8cf55f866d1e\"] [:db/add \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\" :answer/id #uuid \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\"] [:db/add \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\" :answer/type :answer.type/math] [:db/add \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\" :answer/validate] [:db/add \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\" :answer/id #uuid \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\"] [:db/add \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\" :answer/type :answer.type/math] [:db/add \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\" :answer/validate] [:db/add \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\" :answer/id #uuid \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\"] [:db/add \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\" :answer/type :answer.type/math] [:db/add \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\" :answer/validate] [:db/add \"a03bf18e-2c63-5339-9629-bbc6189145c7\" :answer/id #uuid \"a03bf18e-2c63-5339-9629-bbc6189145c7\"] [:db/add \"a03bf18e-2c63-5339-9629-bbc6189145c7\" :answer/type :answer.type/math] [:db/add \"a03bf18e-2c63-5339-9629-bbc6189145c7\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"a03bf18e-2c63-5339-9629-bbc6189145c7\" :answer/validate] [:db/add \"4277b4e6-49e4-5a56-809b-b79cd834fd13\" :answer/id #uuid \"4277b4e6-49e4-5a56-809b-b79cd834fd13\"] [:db/add \"4277b4e6-49e4-5a56-809b-b79cd834fd13\" :answer/type :answer.type/math] [:db/add \"4277b4e6-49e4-5a56-809b-b79cd834fd13\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"4277b4e6-49e4-5a56-809b-b79cd834fd13\" :answer/validate] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/id #uuid \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\"] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/key \"answer\"] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/type :answer-field.type/radio] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"c72e4c50-5f97-5c8b-8104-6944e2d6f9c7\"] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\"] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"b52ac15a-1522-5c8b-8137-8d58fe2ff645\"] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"a03bf18e-2c63-5339-9629-bbc6189145c7\"] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/choices \"4277b4e6-49e4-5a56-809b-b79cd834fd13\"] [:db/add \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/correct \"413d29cc-13c9-5fc2-8467-4ac5d7d7f2fb\"] [:db/ensure \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\" :answer-field/validate] [:db/add \"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/id #uuid \"cc8028db-87b5-52a1-8aac-9030f73664f7\"] [:db/add \"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - x^{2}}=5\\\\sqrt{1-(\\\\frac{x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{5}\\\\cdot 5=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/difficulty :question.difficulty/moderate] [:db/add \"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/answer-fields \"2733d09f-e1ef-5b25-b7ed-75e0c24b669f\"] [:db/ensure \"cc8028db-87b5-52a1-8aac-9030f73664f7\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"cc8028db-87b5-52a1-8aac-9030f73664f7\"] [:db/add \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\" :answer/id #uuid \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\"] [:db/add \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\" :answer/type :answer.type/math] [:db/add \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\" :answer/validate] [:db/add \"48e6410e-271b-5955-b68e-60ea6dbe2db5\" :answer/id #uuid \"48e6410e-271b-5955-b68e-60ea6dbe2db5\"] [:db/add \"48e6410e-271b-5955-b68e-60ea6dbe2db5\" :answer/type :answer.type/math] [:db/add \"48e6410e-271b-5955-b68e-60ea6dbe2db5\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"48e6410e-271b-5955-b68e-60ea6dbe2db5\" :answer/validate] [:db/add \"c94f431f-bba0-554b-951b-325adffcef03\" :answer/id #uuid \"c94f431f-bba0-554b-951b-325adffcef03\"] [:db/add \"c94f431f-bba0-554b-951b-325adffcef03\" :answer/type :answer.type/math] [:db/add \"c94f431f-bba0-554b-951b-325adffcef03\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"c94f431f-bba0-554b-951b-325adffcef03\" :answer/validate] [:db/add \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\" :answer/id #uuid \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\"] [:db/add \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\" :answer/type :answer.type/math] [:db/add \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\" :answer/validate] [:db/add \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\" :answer/id #uuid \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\"] [:db/add \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\" :answer/type :answer.type/math] [:db/add \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\" :answer/value \"-4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\" :answer/validate] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/id #uuid \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\"] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/key \"answer\"] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/type :answer-field.type/radio] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"ed78d76b-0f74-573a-86df-dfb499fa3e3c\"] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"48e6410e-271b-5955-b68e-60ea6dbe2db5\"] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"c94f431f-bba0-554b-951b-325adffcef03\"] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"cbcacfdc-8075-5d49-8d42-fbcce88586aa\"] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/choices \"1c6450a6-11ae-5cb6-8355-2a3f3658253b\"] [:db/add \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/correct \"48e6410e-271b-5955-b68e-60ea6dbe2db5\"] [:db/ensure \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\" :answer-field/validate] [:db/add \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/id #uuid \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\"] [:db/add \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 4=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/difficulty :question.difficulty/moderate] [:db/add \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/answer-fields \"5df6d80a-9145-5b45-b0f6-b11cab1a6229\"] [:db/ensure \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"6580d3c9-1b2c-5dd3-9425-0ec2eeba4c53\"] [:db/add \"4c457006-6a85-5708-acba-32926a552ee4\" :answer/id #uuid \"4c457006-6a85-5708-acba-32926a552ee4\"] [:db/add \"4c457006-6a85-5708-acba-32926a552ee4\" :answer/type :answer.type/math] [:db/add \"4c457006-6a85-5708-acba-32926a552ee4\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"4c457006-6a85-5708-acba-32926a552ee4\" :answer/validate] [:db/add \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\" :answer/id #uuid \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\"] [:db/add \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\" :answer/type :answer.type/math] [:db/add \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\" :answer/validate] [:db/add \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\" :answer/id #uuid \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\"] [:db/add \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\" :answer/type :answer.type/math] [:db/add \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\" :answer/validate] [:db/add \"55dcf395-29a4-573b-921e-896c6c6467b0\" :answer/id #uuid \"55dcf395-29a4-573b-921e-896c6c6467b0\"] [:db/add \"55dcf395-29a4-573b-921e-896c6c6467b0\" :answer/type :answer.type/math] [:db/add \"55dcf395-29a4-573b-921e-896c6c6467b0\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"55dcf395-29a4-573b-921e-896c6c6467b0\" :answer/validate] [:db/add \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\" :answer/id #uuid \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\"] [:db/add \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\" :answer/type :answer.type/math] [:db/add \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\" :answer/validate] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/id #uuid \"eb52a120-a923-5ff4-ad82-6db06b46316d\"] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/key \"answer\"] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/type :answer-field.type/radio] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"4c457006-6a85-5708-acba-32926a552ee4\"] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"48aafd2f-c91d-50f0-a7cf-e73bec3c18ba\"] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"d9e542fd-6abe-5edb-bcd7-fa02034ff443\"] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"55dcf395-29a4-573b-921e-896c6c6467b0\"] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/choices \"8ded6cb8-42b0-5dc3-8c5c-e37a00db6219\"] [:db/add \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/correct \"4c457006-6a85-5708-acba-32926a552ee4\"] [:db/ensure \"eb52a120-a923-5ff4-ad82-6db06b46316d\" :answer-field/validate] [:db/add \"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/id #uuid \"f2c2956c-0c43-5953-a81f-5536789cc765\"] [:db/add \"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 4=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/difficulty :question.difficulty/moderate] [:db/add \"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/answer-fields \"eb52a120-a923-5ff4-ad82-6db06b46316d\"] [:db/ensure \"f2c2956c-0c43-5953-a81f-5536789cc765\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"f2c2956c-0c43-5953-a81f-5536789cc765\"] [:db/add \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\" :answer/id #uuid \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\"] [:db/add \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\" :answer/type :answer.type/math] [:db/add \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\" :answer/validate] [:db/add \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\" :answer/id #uuid \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\"] [:db/add \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\" :answer/type :answer.type/math] [:db/add \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\" :answer/validate] [:db/add \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\" :answer/id #uuid \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\"] [:db/add \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\" :answer/type :answer.type/math] [:db/add \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\" :answer/validate] [:db/add \"6b976a27-703a-5c45-aee1-8e171a3a6108\" :answer/id #uuid \"6b976a27-703a-5c45-aee1-8e171a3a6108\"] [:db/add \"6b976a27-703a-5c45-aee1-8e171a3a6108\" :answer/type :answer.type/math] [:db/add \"6b976a27-703a-5c45-aee1-8e171a3a6108\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"6b976a27-703a-5c45-aee1-8e171a3a6108\" :answer/validate] [:db/add \"40e36773-b19c-53e4-8b18-e20e2eea849f\" :answer/id #uuid \"40e36773-b19c-53e4-8b18-e20e2eea849f\"] [:db/add \"40e36773-b19c-53e4-8b18-e20e2eea849f\" :answer/type :answer.type/math] [:db/add \"40e36773-b19c-53e4-8b18-e20e2eea849f\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"40e36773-b19c-53e4-8b18-e20e2eea849f\" :answer/validate] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/id #uuid \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\"] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/key \"answer\"] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/type :answer-field.type/radio] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\"] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"da0a0217-3467-50ce-8d39-f984c8c3c4ea\"] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"5ad72e40-4fbc-5f3f-a0b9-6b1a48f7f191\"] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"6b976a27-703a-5c45-aee1-8e171a3a6108\"] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/choices \"40e36773-b19c-53e4-8b18-e20e2eea849f\"] [:db/add \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/correct \"2340bfbd-6513-5e5a-b825-ea1d0a903a8f\"] [:db/ensure \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\" :answer-field/validate] [:db/add \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/id #uuid \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\"] [:db/add \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot 4=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/difficulty :question.difficulty/moderate] [:db/add \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/answer-fields \"1ac28db8-fac2-59f8-b62d-91aeb124a07e\"] [:db/ensure \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"040cf90f-e9fa-56a3-ad4c-f1af4cb4bd99\"] [:db/add \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\" :answer/id #uuid \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\"] [:db/add \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\" :answer/type :answer.type/math] [:db/add \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\" :answer/validate] [:db/add \"08b72347-1d8d-50a3-bb44-5acc1af00891\" :answer/id #uuid \"08b72347-1d8d-50a3-bb44-5acc1af00891\"] [:db/add \"08b72347-1d8d-50a3-bb44-5acc1af00891\" :answer/type :answer.type/math] [:db/add \"08b72347-1d8d-50a3-bb44-5acc1af00891\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"08b72347-1d8d-50a3-bb44-5acc1af00891\" :answer/validate] [:db/add \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\" :answer/id #uuid \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\"] [:db/add \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\" :answer/type :answer.type/math] [:db/add \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\" :answer/validate] [:db/add \"a56b2967-5d58-588f-8aa2-576b19eb8329\" :answer/id #uuid \"a56b2967-5d58-588f-8aa2-576b19eb8329\"] [:db/add \"a56b2967-5d58-588f-8aa2-576b19eb8329\" :answer/type :answer.type/math] [:db/add \"a56b2967-5d58-588f-8aa2-576b19eb8329\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"a56b2967-5d58-588f-8aa2-576b19eb8329\" :answer/validate] [:db/add \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\" :answer/id #uuid \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\"] [:db/add \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\" :answer/type :answer.type/math] [:db/add \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\" :answer/validate] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/id #uuid \"b5f52558-6f4e-5657-8e84-5a29f96489e9\"] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/key \"answer\"] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/type :answer-field.type/radio] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\"] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"08b72347-1d8d-50a3-bb44-5acc1af00891\"] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"2dbcb0f3-a228-5d97-abb5-a77410bb0322\"] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"a56b2967-5d58-588f-8aa2-576b19eb8329\"] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/choices \"f90e2aa8-2afe-56fc-9184-76c2d0bf9936\"] [:db/add \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/correct \"ea9ec55f-b898-5c90-bac0-6ffe3c9144b0\"] [:db/ensure \"b5f52558-6f4e-5657-8e84-5a29f96489e9\" :answer-field/validate] [:db/add \"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/id #uuid \"52f1aee4-b8af-504c-92b3-9b4debebc7db\"] [:db/add \"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/worked-solution \"Let $u=\\\\frac{2 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 4 x^{2}}=5\\\\sqrt{1-(\\\\frac{2 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{5}\\\\cdot \\\\frac{5}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/difficulty :question.difficulty/hard] [:db/add \"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/answer-fields \"b5f52558-6f4e-5657-8e84-5a29f96489e9\"] [:db/ensure \"52f1aee4-b8af-504c-92b3-9b4debebc7db\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"52f1aee4-b8af-504c-92b3-9b4debebc7db\"] [:db/add \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\" :answer/id #uuid \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\"] [:db/add \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\" :answer/type :answer.type/math] [:db/add \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C\"] [:db/ensure \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\" :answer/validate] [:db/add \"1acdab75-b682-5d89-ba17-ef276f394c2f\" :answer/id #uuid \"1acdab75-b682-5d89-ba17-ef276f394c2f\"] [:db/add \"1acdab75-b682-5d89-ba17-ef276f394c2f\" :answer/type :answer.type/math] [:db/add \"1acdab75-b682-5d89-ba17-ef276f394c2f\" :answer/value \"-1\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"1acdab75-b682-5d89-ba17-ef276f394c2f\" :answer/validate] [:db/add \"828afea6-4215-56e4-94ab-9886a6888c55\" :answer/id #uuid \"828afea6-4215-56e4-94ab-9886a6888c55\"] [:db/add \"828afea6-4215-56e4-94ab-9886a6888c55\" :answer/type :answer.type/math] [:db/add \"828afea6-4215-56e4-94ab-9886a6888c55\" :answer/value \"\\\\arcsin{\\\\left(x \\\\right)}+C\"] [:db/ensure \"828afea6-4215-56e4-94ab-9886a6888c55\" :answer/validate] [:db/add \"2f6f1436-fadd-5101-aa8b-be44f17bc594\" :answer/id #uuid \"2f6f1436-fadd-5101-aa8b-be44f17bc594\"] [:db/add \"2f6f1436-fadd-5101-aa8b-be44f17bc594\" :answer/type :answer.type/math] [:db/add \"2f6f1436-fadd-5101-aa8b-be44f17bc594\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}+C\"] [:db/ensure \"2f6f1436-fadd-5101-aa8b-be44f17bc594\" :answer/validate] [:db/add \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\" :answer/id #uuid \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\"] [:db/add \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\" :answer/type :answer.type/math] [:db/add \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\" :answer/validate] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/id #uuid \"615685fd-3c77-5732-ab7a-0dd80584e0da\"] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/key \"answer\"] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/type :answer-field.type/radio] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\"] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"1acdab75-b682-5d89-ba17-ef276f394c2f\"] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"828afea6-4215-56e4-94ab-9886a6888c55\"] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"2f6f1436-fadd-5101-aa8b-be44f17bc594\"] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/choices \"403d2dc3-963b-5194-a2fb-f787dfc3d9fc\"] [:db/add \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/correct \"e79c0c7a-5a34-5d70-8576-7d4bdc57b10f\"] [:db/ensure \"615685fd-3c77-5732-ab7a-0dd80584e0da\" :answer-field/validate] [:db/add \"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/id #uuid \"95398754-8d8a-50d4-bfa4-4cf30d049a32\"] [:db/add \"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot \\\\frac{3}{4}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C.\\n$$\"] [:db/add \"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/difficulty :question.difficulty/hard] [:db/add \"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/answer-fields \"615685fd-3c77-5732-ab7a-0dd80584e0da\"] [:db/ensure \"95398754-8d8a-50d4-bfa4-4cf30d049a32\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"95398754-8d8a-50d4-bfa4-4cf30d049a32\"] [:db/add \"fd6c2c84-bed1-5d08-abac-17fbbc982558\" :answer/id #uuid \"fd6c2c84-bed1-5d08-abac-17fbbc982558\"] [:db/add \"fd6c2c84-bed1-5d08-abac-17fbbc982558\" :answer/type :answer.type/math] [:db/add \"fd6c2c84-bed1-5d08-abac-17fbbc982558\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"fd6c2c84-bed1-5d08-abac-17fbbc982558\" :answer/validate] [:db/add \"885e4496-b864-582d-8ccb-3dac8e719b70\" :answer/id #uuid \"885e4496-b864-582d-8ccb-3dac8e719b70\"] [:db/add \"885e4496-b864-582d-8ccb-3dac8e719b70\" :answer/type :answer.type/math] [:db/add \"885e4496-b864-582d-8ccb-3dac8e719b70\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"885e4496-b864-582d-8ccb-3dac8e719b70\" :answer/validate] [:db/add \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\" :answer/id #uuid \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\"] [:db/add \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\" :answer/type :answer.type/math] [:db/add \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(3 x \\\\right)}\\\\right)+C\"] [:db/ensure \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\" :answer/validate] [:db/add \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\" :answer/id #uuid \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\"] [:db/add \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\" :answer/type :answer.type/math] [:db/add \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\" :answer/validate] [:db/add \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\" :answer/id #uuid \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\"] [:db/add \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\" :answer/type :answer.type/math] [:db/add \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\" :answer/validate] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/id #uuid \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\"] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/key \"answer\"] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/type :answer-field.type/radio] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"fd6c2c84-bed1-5d08-abac-17fbbc982558\"] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"885e4496-b864-582d-8ccb-3dac8e719b70\"] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"bd8af89a-b0b5-5864-a25f-58ec78587fb0\"] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"9f99ecbe-eb5c-5e2d-be3e-2096e603573e\"] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/choices \"ec9975a3-6238-5b85-a2d3-e2d78704d3ea\"] [:db/add \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/correct \"fd6c2c84-bed1-5d08-abac-17fbbc982558\"] [:db/ensure \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\" :answer-field/validate] [:db/add \"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/id #uuid \"fc157b00-d7e7-54d0-826d-effc6b6af186\"] [:db/add \"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 9 x^{2}}=2\\\\sqrt{1-(\\\\frac{3 x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/difficulty :question.difficulty/hard] [:db/add \"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/answer-fields \"f3758b5c-f69f-5418-a0e7-81bbe4217ac8\"] [:db/ensure \"fc157b00-d7e7-54d0-826d-effc6b6af186\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"fc157b00-d7e7-54d0-826d-effc6b6af186\"] [:db/add \"b526d407-065c-533d-93e3-9ea5f1332b0e\" :answer/id #uuid \"b526d407-065c-533d-93e3-9ea5f1332b0e\"] [:db/add \"b526d407-065c-533d-93e3-9ea5f1332b0e\" :answer/type :answer.type/math] [:db/add \"b526d407-065c-533d-93e3-9ea5f1332b0e\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"b526d407-065c-533d-93e3-9ea5f1332b0e\" :answer/validate] [:db/add \"c3001b48-6ddc-521b-af95-0c903c6503e9\" :answer/id #uuid \"c3001b48-6ddc-521b-af95-0c903c6503e9\"] [:db/add \"c3001b48-6ddc-521b-af95-0c903c6503e9\" :answer/type :answer.type/math] [:db/add \"c3001b48-6ddc-521b-af95-0c903c6503e9\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"c3001b48-6ddc-521b-af95-0c903c6503e9\" :answer/validate] [:db/add \"5f5f6896-99ec-5450-b967-0f6484905f41\" :answer/id #uuid \"5f5f6896-99ec-5450-b967-0f6484905f41\"] [:db/add \"5f5f6896-99ec-5450-b967-0f6484905f41\" :answer/type :answer.type/math] [:db/add \"5f5f6896-99ec-5450-b967-0f6484905f41\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"5f5f6896-99ec-5450-b967-0f6484905f41\" :answer/validate] [:db/add \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\" :answer/id #uuid \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\"] [:db/add \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\" :answer/type :answer.type/math] [:db/add \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}+C\"] [:db/ensure \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\" :answer/validate] [:db/add \"f504165f-c125-5f04-b99b-691c923b2e8c\" :answer/id #uuid \"f504165f-c125-5f04-b99b-691c923b2e8c\"] [:db/add \"f504165f-c125-5f04-b99b-691c923b2e8c\" :answer/type :answer.type/math] [:db/add \"f504165f-c125-5f04-b99b-691c923b2e8c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"f504165f-c125-5f04-b99b-691c923b2e8c\" :answer/validate] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/id #uuid \"f37425f2-9e9d-529b-af95-954c964ee874\"] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/key \"answer\"] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/type :answer-field.type/radio] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"b526d407-065c-533d-93e3-9ea5f1332b0e\"] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"c3001b48-6ddc-521b-af95-0c903c6503e9\"] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"5f5f6896-99ec-5450-b967-0f6484905f41\"] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"5ac1e959-c44f-5d3b-a1af-13053534d0c2\"] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/choices \"f504165f-c125-5f04-b99b-691c923b2e8c\"] [:db/add \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/correct \"b526d407-065c-533d-93e3-9ea5f1332b0e\"] [:db/ensure \"f37425f2-9e9d-529b-af95-954c964ee874\" :answer-field/validate] [:db/add \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/id #uuid \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\"] [:db/add \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 16 x^{2}}=5\\\\sqrt{1-(\\\\frac{4 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{5}\\\\cdot \\\\frac{5}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/difficulty :question.difficulty/hard] [:db/add \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/answer-fields \"f37425f2-9e9d-529b-af95-954c964ee874\"] [:db/ensure \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"ddbdc2e4-b9b6-5696-a66c-c97aaad82d8e\"] [:db/add \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\" :answer/id #uuid \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\"] [:db/add \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\" :answer/type :answer.type/math] [:db/add \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\" :answer/validate] [:db/add \"759df803-6604-5f74-8d24-995191965a98\" :answer/id #uuid \"759df803-6604-5f74-8d24-995191965a98\"] [:db/add \"759df803-6604-5f74-8d24-995191965a98\" :answer/type :answer.type/math] [:db/add \"759df803-6604-5f74-8d24-995191965a98\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"759df803-6604-5f74-8d24-995191965a98\" :answer/validate] [:db/add \"eb05b373-f44f-5b50-bd4f-6035726fa42a\" :answer/id #uuid \"eb05b373-f44f-5b50-bd4f-6035726fa42a\"] [:db/add \"eb05b373-f44f-5b50-bd4f-6035726fa42a\" :answer/type :answer.type/math] [:db/add \"eb05b373-f44f-5b50-bd4f-6035726fa42a\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"eb05b373-f44f-5b50-bd4f-6035726fa42a\" :answer/validate] [:db/add \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\" :answer/id #uuid \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\"] [:db/add \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\" :answer/type :answer.type/math] [:db/add \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\" :answer/validate] [:db/add \"18fa3ff5-c139-505f-930f-720705667266\" :answer/id #uuid \"18fa3ff5-c139-505f-930f-720705667266\"] [:db/add \"18fa3ff5-c139-505f-930f-720705667266\" :answer/type :answer.type/math] [:db/add \"18fa3ff5-c139-505f-930f-720705667266\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"18fa3ff5-c139-505f-930f-720705667266\" :answer/validate] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/id #uuid \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\"] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/key \"answer\"] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/type :answer-field.type/radio] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"2b95f833-3727-5b82-a0b9-62d47a3cad6c\"] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"759df803-6604-5f74-8d24-995191965a98\"] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"eb05b373-f44f-5b50-bd4f-6035726fa42a\"] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"75420b2f-62f9-5911-8c27-602ceb2ddbd5\"] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/choices \"18fa3ff5-c139-505f-930f-720705667266\"] [:db/add \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/correct \"eb05b373-f44f-5b50-bd4f-6035726fa42a\"] [:db/ensure \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\" :answer-field/validate] [:db/add \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/id #uuid \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\"] [:db/add \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/difficulty :question.difficulty/hard] [:db/add \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/answer-fields \"42330f75-fd38-52cb-80a9-3af5cce2a1ab\"] [:db/ensure \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"cfdabf08-a69b-5abe-80f0-3c9106b581f1\"] [:db/add \"8c81ff3f-41ae-5271-9b29-60734641f927\" :answer/id #uuid \"8c81ff3f-41ae-5271-9b29-60734641f927\"] [:db/add \"8c81ff3f-41ae-5271-9b29-60734641f927\" :answer/type :answer.type/math] [:db/add \"8c81ff3f-41ae-5271-9b29-60734641f927\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"8c81ff3f-41ae-5271-9b29-60734641f927\" :answer/validate] [:db/add \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\" :answer/id #uuid \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\"] [:db/add \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\" :answer/type :answer.type/math] [:db/add \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\" :answer/validate] [:db/add \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\" :answer/id #uuid \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\"] [:db/add \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\" :answer/type :answer.type/math] [:db/add \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\" :answer/validate] [:db/add \"eca0154b-2389-5640-8f69-7d0dca65c473\" :answer/id #uuid \"eca0154b-2389-5640-8f69-7d0dca65c473\"] [:db/add \"eca0154b-2389-5640-8f69-7d0dca65c473\" :answer/type :answer.type/math] [:db/add \"eca0154b-2389-5640-8f69-7d0dca65c473\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"eca0154b-2389-5640-8f69-7d0dca65c473\" :answer/validate] [:db/add \"a912984b-e9a9-5928-9964-e95ce039ce3d\" :answer/id #uuid \"a912984b-e9a9-5928-9964-e95ce039ce3d\"] [:db/add \"a912984b-e9a9-5928-9964-e95ce039ce3d\" :answer/type :answer.type/math] [:db/add \"a912984b-e9a9-5928-9964-e95ce039ce3d\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"a912984b-e9a9-5928-9964-e95ce039ce3d\" :answer/validate] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/id #uuid \"b2441de9-3ddd-5f87-b0b9-544a72b51646\"] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/key \"answer\"] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/type :answer-field.type/radio] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"8c81ff3f-41ae-5271-9b29-60734641f927\"] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"cd3ac926-d581-5c5f-ba72-3322ccd4db3d\"] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"1d8822d2-d398-5247-b1e1-89c9fbaa9679\"] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"eca0154b-2389-5640-8f69-7d0dca65c473\"] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/choices \"a912984b-e9a9-5928-9964-e95ce039ce3d\"] [:db/add \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/correct \"a912984b-e9a9-5928-9964-e95ce039ce3d\"] [:db/ensure \"b2441de9-3ddd-5f87-b0b9-544a72b51646\" :answer-field/validate] [:db/add \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/id #uuid \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\"] [:db/add \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/difficulty :question.difficulty/hard] [:db/add \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/answer-fields \"b2441de9-3ddd-5f87-b0b9-544a72b51646\"] [:db/ensure \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"c14b75ae-9ec7-5de3-b766-eb57dc73f8cc\"] [:db/add \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\" :answer/id #uuid \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\"] [:db/add \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\" :answer/type :answer.type/math] [:db/add \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\" :answer/validate] [:db/add \"18c0ccdc-170c-54ad-a845-5dc98b396090\" :answer/id #uuid \"18c0ccdc-170c-54ad-a845-5dc98b396090\"] [:db/add \"18c0ccdc-170c-54ad-a845-5dc98b396090\" :answer/type :answer.type/math] [:db/add \"18c0ccdc-170c-54ad-a845-5dc98b396090\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"18c0ccdc-170c-54ad-a845-5dc98b396090\" :answer/validate] [:db/add \"4fb81696-331e-59ed-86c1-f465803f114c\" :answer/id #uuid \"4fb81696-331e-59ed-86c1-f465803f114c\"] [:db/add \"4fb81696-331e-59ed-86c1-f465803f114c\" :answer/type :answer.type/math] [:db/add \"4fb81696-331e-59ed-86c1-f465803f114c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"4fb81696-331e-59ed-86c1-f465803f114c\" :answer/validate] [:db/add \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\" :answer/id #uuid \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\"] [:db/add \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\" :answer/type :answer.type/math] [:db/add \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\" :answer/validate] [:db/add \"30c69d46-ccea-5283-825f-948729033a54\" :answer/id #uuid \"30c69d46-ccea-5283-825f-948729033a54\"] [:db/add \"30c69d46-ccea-5283-825f-948729033a54\" :answer/type :answer.type/math] [:db/add \"30c69d46-ccea-5283-825f-948729033a54\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"30c69d46-ccea-5283-825f-948729033a54\" :answer/validate] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/id #uuid \"e0acea2b-037a-53c7-8970-eccae40b99e8\"] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/key \"answer\"] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/type :answer-field.type/radio] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"ca5b2f59-a145-587b-a4c1-a9609a57f58b\"] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"18c0ccdc-170c-54ad-a845-5dc98b396090\"] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"4fb81696-331e-59ed-86c1-f465803f114c\"] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\"] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/choices \"30c69d46-ccea-5283-825f-948729033a54\"] [:db/add \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/correct \"e9506a52-47ef-56ab-9cf4-c2f213b2bcca\"] [:db/ensure \"e0acea2b-037a-53c7-8970-eccae40b99e8\" :answer-field/validate] [:db/add \"39b99761-df6d-539c-9682-f60f84447665\" :question/id #uuid \"39b99761-df6d-539c-9682-f60f84447665\"] [:db/add \"39b99761-df6d-539c-9682-f60f84447665\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"39b99761-df6d-539c-9682-f60f84447665\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 4 x^{2}}=3\\\\sqrt{1-(\\\\frac{2 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{3}{2}=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"39b99761-df6d-539c-9682-f60f84447665\" :question/difficulty :question.difficulty/hard] [:db/add \"39b99761-df6d-539c-9682-f60f84447665\" :question/answer-fields \"e0acea2b-037a-53c7-8970-eccae40b99e8\"] [:db/ensure \"39b99761-df6d-539c-9682-f60f84447665\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"39b99761-df6d-539c-9682-f60f84447665\"] [:db/add \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\" :answer/id #uuid \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\"] [:db/add \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\" :answer/type :answer.type/math] [:db/add \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\" :answer/validate] [:db/add \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\" :answer/id #uuid \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\"] [:db/add \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\" :answer/type :answer.type/math] [:db/add \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\" :answer/validate] [:db/add \"794542e2-c977-50b8-bbc4-5ccd21d90e77\" :answer/id #uuid \"794542e2-c977-50b8-bbc4-5ccd21d90e77\"] [:db/add \"794542e2-c977-50b8-bbc4-5ccd21d90e77\" :answer/type :answer.type/math] [:db/add \"794542e2-c977-50b8-bbc4-5ccd21d90e77\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"794542e2-c977-50b8-bbc4-5ccd21d90e77\" :answer/validate] [:db/add \"4fd68a63-724f-574a-9786-f070580733ef\" :answer/id #uuid \"4fd68a63-724f-574a-9786-f070580733ef\"] [:db/add \"4fd68a63-724f-574a-9786-f070580733ef\" :answer/type :answer.type/math] [:db/add \"4fd68a63-724f-574a-9786-f070580733ef\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"4fd68a63-724f-574a-9786-f070580733ef\" :answer/validate] [:db/add \"ac33763f-f131-5c90-880a-c09f293ca8ab\" :answer/id #uuid \"ac33763f-f131-5c90-880a-c09f293ca8ab\"] [:db/add \"ac33763f-f131-5c90-880a-c09f293ca8ab\" :answer/type :answer.type/math] [:db/add \"ac33763f-f131-5c90-880a-c09f293ca8ab\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ac33763f-f131-5c90-880a-c09f293ca8ab\" :answer/validate] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/id #uuid \"df13b46b-41af-526b-af54-045674b5bdef\"] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/key \"answer\"] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/type :answer-field.type/radio] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"e3a47d8d-3ef6-5933-8ab1-251e436ae64c\"] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"fb1c2227-8f5f-5bbe-8639-54cae4eeecd9\"] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"794542e2-c977-50b8-bbc4-5ccd21d90e77\"] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"4fd68a63-724f-574a-9786-f070580733ef\"] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/choices \"ac33763f-f131-5c90-880a-c09f293ca8ab\"] [:db/add \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/correct \"794542e2-c977-50b8-bbc4-5ccd21d90e77\"] [:db/ensure \"df13b46b-41af-526b-af54-045674b5bdef\" :answer-field/validate] [:db/add \"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/id #uuid \"3c7be681-6a2d-5a04-a101-13d325e163c6\"] [:db/add \"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/difficulty :question.difficulty/hard] [:db/add \"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/answer-fields \"df13b46b-41af-526b-af54-045674b5bdef\"] [:db/ensure \"3c7be681-6a2d-5a04-a101-13d325e163c6\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"3c7be681-6a2d-5a04-a101-13d325e163c6\"] [:db/add \"generator\" :question-generator/id #uuid \"a1179086-44c6-5401-89a0-90db05f0228b\"] [:db/add \"generator\" :question-generator/script \"generators/47/4768c628b8460329222e9662c2d7f5d485467d218c62d3e9d0740b180c83de2e/generator.py\"] [:db/add 17592186064218 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186064218 :knowledge-point/validate]] \"assertions\" [[\"3968c072-6d48-5bec-a420-8439d836c6b2\" :answer/id #uuid \"3968c072-6d48-5bec-a420-8439d836c6b2\"] [\"3968c072-6d48-5bec-a420-8439d836c6b2\" :answer/type :answer.type/math] [\"3968c072-6d48-5bec-a420-8439d836c6b2\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2c96687f-5c24-59ee-b156-32e668c87f16\" :answer/id #uuid \"2c96687f-5c24-59ee-b156-32e668c87f16\"] [\"2c96687f-5c24-59ee-b156-32e668c87f16\" :answer/type :answer.type/math] [\"2c96687f-5c24-59ee-b156-32e668c87f16\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"582505f8-ba15-5a46-b508-e81560ebe2f1\" :answer/id #uuid \"582505f8-ba15-5a46-b508-e81560ebe2f1\"] [\"582505f8-ba15-5a46-b508-e81560ebe2f1\" :answer/type :answer.type/math] [\"582505f8-ba15-5a46-b508-e81560ebe2f1\" :answer/value \"\\\\frac{9}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"f1ef4676-fdaa-585d-9802-5a1b130fb93a\" :answer/id #uuid \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\"] [\"f1ef4676-fdaa-585d-9802-5a1b130fb93a\" :answer/type :answer.type/math] [\"f1ef4676-fdaa-585d-9802-5a1b130fb93a\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"94ce8c50-20be-53e5-afdf-217ef133e4a1\" :answer/id #uuid \"94ce8c50-20be-53e5-afdf-217ef133e4a1\"] [\"94ce8c50-20be-53e5-afdf-217ef133e4a1\" :answer/type :answer.type/math] [\"94ce8c50-20be-53e5-afdf-217ef133e4a1\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/id #uuid \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/key \"answer\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/type :answer-field.type/radio] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"3968c072-6d48-5bec-a420-8439d836c6b2\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"2c96687f-5c24-59ee-b156-32e668c87f16\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"582505f8-ba15-5a46-b508-e81560ebe2f1\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"f1ef4676-fdaa-585d-9802-5a1b130fb93a\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/choices \"94ce8c50-20be-53e5-afdf-217ef133e4a1\"] [\"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\" :answer-field/correct \"94ce8c50-20be-53e5-afdf-217ef133e4a1\"] [\"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/id #uuid \"c021fecf-8c5b-589c-8771-db1b81163d9d\"] [\"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/difficulty :question.difficulty/easy] [\"c021fecf-8c5b-589c-8771-db1b81163d9d\" :question/answer-fields \"3e9a65a3-437c-5bff-b1cd-4390d744f6ec\"] [17592186064218 :knowledge-point/questions \"c021fecf-8c5b-589c-8771-db1b81163d9d\"] [\"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\" :answer/id #uuid \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\"] [\"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\" :answer/type :answer.type/math] [\"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\" :answer/value \"6\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"77f68c25-f592-5ee2-aaa4-f6da31de90a7\" :answer/id #uuid \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\"] [\"77f68c25-f592-5ee2-aaa4-f6da31de90a7\" :answer/type :answer.type/math] [\"77f68c25-f592-5ee2-aaa4-f6da31de90a7\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e331b53e-597e-5c3b-9200-ede00836568a\" :answer/id #uuid \"e331b53e-597e-5c3b-9200-ede00836568a\"] [\"e331b53e-597e-5c3b-9200-ede00836568a\" :answer/type :answer.type/math] [\"e331b53e-597e-5c3b-9200-ede00836568a\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\"] [\"c56f6fab-4e71-5ed0-a069-617265500c0a\" :answer/id #uuid \"c56f6fab-4e71-5ed0-a069-617265500c0a\"] [\"c56f6fab-4e71-5ed0-a069-617265500c0a\" :answer/type :answer.type/math] [\"c56f6fab-4e71-5ed0-a069-617265500c0a\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c1be3b21-7bf0-5812-9194-e45ca430ed5e\" :answer/id #uuid \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\"] [\"c1be3b21-7bf0-5812-9194-e45ca430ed5e\" :answer/type :answer.type/math] [\"c1be3b21-7bf0-5812-9194-e45ca430ed5e\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/id #uuid \"2b372f51-a7ea-583f-a5ed-d80be5885bec\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/key \"answer\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/type :answer-field.type/radio] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"c105b90b-ecb7-519a-a5b7-a96a06ae50fc\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"e331b53e-597e-5c3b-9200-ede00836568a\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"c56f6fab-4e71-5ed0-a069-617265500c0a\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/choices \"c1be3b21-7bf0-5812-9194-e45ca430ed5e\"] [\"2b372f51-a7ea-583f-a5ed-d80be5885bec\" :answer-field/correct \"77f68c25-f592-5ee2-aaa4-f6da31de90a7\"] [\"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/id #uuid \"fb029deb-8ef6-58b3-a661-41132a65c264\"] [\"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/difficulty :question.difficulty/easy] [\"fb029deb-8ef6-58b3-a661-41132a65c264\" :question/answer-fields \"2b372f51-a7ea-583f-a5ed-d80be5885bec\"] [17592186064218 :knowledge-point/questions \"fb029deb-8ef6-58b3-a661-41132a65c264\"] [\"b3039614-011a-5cd1-a53f-cd9c58c194cd\" :answer/id #uuid \"b3039614-011a-5cd1-a53f-cd9c58c194cd\"] [\"b3039614-011a-5cd1-a53f-cd9c58c194cd\" :answer/type :answer.type/math] [\"b3039614-011a-5cd1-a53f-cd9c58c194cd\" :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"cfa93d76-404c-5faf-8767-da03396a0064\" :answer/id #uuid \"cfa93d76-404c-5faf-8767-da03396a0064\"] [\"cfa93d76-404c-5faf-8767-da03396a0064\" :answer/type :answer.type/math] [\"cfa93d76-404c-5faf-8767-da03396a0064\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"341f18c5-a64d-51da-b3c9-0e33a31d3081\" :answer/id #uuid \"341f18c5-a64d-51da-b3c9-0e33a31d3081\"] [\"341f18c5-a64d-51da-b3c9-0e33a31d3081\" :answer/type :answer.type/math] [\"341f18c5-a64d-51da-b3c9-0e33a31d3081\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"5663ccb7-8a71-5fff-b639-20a8f8e96775\" :answer/id #uuid \"5663ccb7-8a71-5fff-b639-20a8f8e96775\"] [\"5663ccb7-8a71-5fff-b639-20a8f8e96775\" :answer/type :answer.type/math] [\"5663ccb7-8a71-5fff-b639-20a8f8e96775\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b182d25a-15aa-5336-98e9-a7f3132880e7\" :answer/id #uuid \"b182d25a-15aa-5336-98e9-a7f3132880e7\"] [\"b182d25a-15aa-5336-98e9-a7f3132880e7\" :answer/type :answer.type/math] [\"b182d25a-15aa-5336-98e9-a7f3132880e7\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/id #uuid \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/key \"answer\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/type :answer-field.type/radio] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"b3039614-011a-5cd1-a53f-cd9c58c194cd\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"cfa93d76-404c-5faf-8767-da03396a0064\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"341f18c5-a64d-51da-b3c9-0e33a31d3081\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"5663ccb7-8a71-5fff-b639-20a8f8e96775\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/choices \"b182d25a-15aa-5336-98e9-a7f3132880e7\"] [\"603a0ff4-a698-5d19-a0b4-7aef21b90edf\" :answer-field/correct \"341f18c5-a64d-51da-b3c9-0e33a31d3081\"] [\"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/id #uuid \"f6c30885-76ce-51d3-9a6a-a97590ca0793\"] [\"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/difficulty :question.difficulty/easy] [\"f6c30885-76ce-51d3-9a6a-a97590ca0793\" :question/answer-fields \"603a0ff4-a698-5d19-a0b4-7aef21b90edf\"] [17592186064218 :knowledge-point/questions \"f6c30885-76ce-51d3-9a6a-a97590ca0793\"] [\"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\" :answer/id #uuid \"c06c32aa-2404-5d8a-98e9-f0fe154c73cc\"] [\"c0