36c11\" :answer-field/correct \"72ac2255-de6b-5677-9fdb-2d0e668960c9\"] [:db/ensure \"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/validate] [:db/add \"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/id #uuid \"94bdb05f-43fe-5e78-b307-235e180d305b\"] [:db/add \"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 4=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/difficulty :question.difficulty/moderate] [:db/add \"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/answer-fields \"45395d8a-6aaa-567d-a6f9-d5037bc36c11\"] [:db/ensure \"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"94bdb05f-43fe-5e78-b307-235e180d305b\"] [:db/add \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\" :answer/id #uuid \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\"] [:db/add \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\" :answer/type :answer.type/math] [:db/add \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{8} \\\\right)}\\\\right)+C\"] [:db/ensure \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\" :answer/validate] [:db/add \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\" :answer/id #uuid \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\"] [:db/add \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\" :answer/type :answer.type/math] [:db/add \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\" :answer/validate] [:db/add \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\" :answer/id #uuid \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\"] [:db/add \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\" :answer/type :answer.type/math] [:db/add \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}+C\"] [:db/ensure \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\" :answer/validate] [:db/add \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\" :answer/id #uuid \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\"] [:db/add \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\" :answer/type :answer.type/math] [:db/add \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\" :answer/validate] [:db/add \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\" :answer/id #uuid \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\"] [:db/add \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\" :answer/type :answer.type/math] [:db/add \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\" :answer/validate] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/id #uuid \"6a93db62-009c-5ff9-a474-4b16d95b59e1\"] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/key \"answer\"] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/type :answer-field.type/radio] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\"] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\"] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\"] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\"] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\"] [:db/add \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/correct \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\"] [:db/ensure \"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/validate] [:db/add \"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/id #uuid \"1d205cfc-223d-5f12-94e3-54557487a6df\"] [:db/add \"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot 4=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/difficulty :question.difficulty/moderate] [:db/add \"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/answer-fields \"6a93db62-009c-5ff9-a474-4b16d95b59e1\"] [:db/ensure \"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"1d205cfc-223d-5f12-94e3-54557487a6df\"] [:db/add \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\" :answer/id #uuid \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\"] [:db/add \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\" :answer/type :answer.type/math] [:db/add \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\" :answer/validate] [:db/add \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\" :answer/id #uuid \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\"] [:db/add \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\" :answer/type :answer.type/math] [:db/add \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\" :answer/validate] [:db/add \"c6f9cfc9-045a-5c64-9b76-399092f18a17\" :answer/id #uuid \"c6f9cfc9-045a-5c64-9b76-399092f18a17\"] [:db/add \"c6f9cfc9-045a-5c64-9b76-399092f18a17\" :answer/type :answer.type/math] [:db/add \"c6f9cfc9-045a-5c64-9b76-399092f18a17\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}+C\"] [:db/ensure \"c6f9cfc9-045a-5c64-9b76-399092f18a17\" :answer/validate] [:db/add \"082e9f1c-b7f4-55f7-812a-806915841186\" :answer/id #uuid \"082e9f1c-b7f4-55f7-812a-806915841186\"] [:db/add \"082e9f1c-b7f4-55f7-812a-806915841186\" :answer/type :answer.type/math] [:db/add \"082e9f1c-b7f4-55f7-812a-806915841186\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"082e9f1c-b7f4-55f7-812a-806915841186\" :answer/validate] [:db/add \"a538a893-d9e5-5400-bada-2d743c13ef4b\" :answer/id #uuid \"a538a893-d9e5-5400-bada-2d743c13ef4b\"] [:db/add \"a538a893-d9e5-5400-bada-2d743c13ef4b\" :answer/type :answer.type/math] [:db/add \"a538a893-d9e5-5400-bada-2d743c13ef4b\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"a538a893-d9e5-5400-bada-2d743c13ef4b\" :answer/validate] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/id #uuid \"a972b44c-4443-5a49-ba25-77dd606919f5\"] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/key \"answer\"] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/type :answer-field.type/radio] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\"] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\"] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"c6f9cfc9-045a-5c64-9b76-399092f18a17\"] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"082e9f1c-b7f4-55f7-812a-806915841186\"] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"a538a893-d9e5-5400-bada-2d743c13ef4b\"] [:db/add \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/correct \"a538a893-d9e5-5400-bada-2d743c13ef4b\"] [:db/ensure \"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/validate] [:db/add \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/id #uuid \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\"] [:db/add \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/worked-solution \"Let $u=\\\\frac{2 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 4 x^{2}}=5\\\\sqrt{1-(\\\\frac{2 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{5}\\\\cdot \\\\frac{5}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/difficulty :question.difficulty/hard] [:db/add \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/answer-fields \"a972b44c-4443-5a49-ba25-77dd606919f5\"] [:db/ensure \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\"] [:db/add \"72b275dd-3871-5105-88f5-755d10a926ee\" :answer/id #uuid \"72b275dd-3871-5105-88f5-755d10a926ee\"] [:db/add \"72b275dd-3871-5105-88f5-755d10a926ee\" :answer/type :answer.type/math] [:db/add \"72b275dd-3871-5105-88f5-755d10a926ee\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C\"] [:db/ensure \"72b275dd-3871-5105-88f5-755d10a926ee\" :answer/validate] [:db/add \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\" :answer/id #uuid \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\"] [:db/add \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\" :answer/type :answer.type/math] [:db/add \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}+C\"] [:db/ensure \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\" :answer/validate] [:db/add \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\" :answer/id #uuid \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\"] [:db/add \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\" :answer/type :answer.type/math] [:db/add \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\" :answer/validate] [:db/add \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\" :answer/id #uuid \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\"] [:db/add \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\" :answer/type :answer.type/math] [:db/add \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\" :answer/value \"-1\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\" :answer/validate] [:db/add \"3b274588-c364-5780-82aa-be8327332f41\" :answer/id #uuid \"3b274588-c364-5780-82aa-be8327332f41\"] [:db/add \"3b274588-c364-5780-82aa-be8327332f41\" :answer/type :answer.type/math] [:db/add \"3b274588-c364-5780-82aa-be8327332f41\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"3b274588-c364-5780-82aa-be8327332f41\" :answer/validate] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/id #uuid \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\"] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/key \"answer\"] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/type :answer-field.type/radio] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"72b275dd-3871-5105-88f5-755d10a926ee\"] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\"] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\"] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\"] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"3b274588-c364-5780-82aa-be8327332f41\"] [:db/add \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/correct \"72b275dd-3871-5105-88f5-755d10a926ee\"] [:db/ensure \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/validate] [:db/add \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/id #uuid \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\"] [:db/add \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot \\\\frac{3}{4}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C.\\n$$\"] [:db/add \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/difficulty :question.difficulty/hard] [:db/add \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/answer-fields \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\"] [:db/ensure \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\"] [:db/add \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\" :answer/id #uuid \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\"] [:db/add \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\" :answer/type :answer.type/math] [:db/add \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\" :answer/validate] [:db/add \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\" :answer/id #uuid \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\"] [:db/add \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\" :answer/type :answer.type/math] [:db/add \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\" :answer/validate] [:db/add \"16d15460-c344-58be-bd6c-ff5c5aa66b99\" :answer/id #uuid \"16d15460-c344-58be-bd6c-ff5c5aa66b99\"] [:db/add \"16d15460-c344-58be-bd6c-ff5c5aa66b99\" :answer/type :answer.type/math] [:db/add \"16d15460-c344-58be-bd6c-ff5c5aa66b99\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"16d15460-c344-58be-bd6c-ff5c5aa66b99\" :answer/validate] [:db/add \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\" :answer/id #uuid \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\"] [:db/add \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\" :answer/type :answer.type/math] [:db/add \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\" :answer/validate] [:db/add \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\" :answer/id #uuid \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\"] [:db/add \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\" :answer/type :answer.type/math] [:db/add \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\" :answer/validate] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/id #uuid \"815fa613-54ca-5424-b2a4-b9796145743c\"] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/key \"answer\"] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/type :answer-field.type/radio] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\"] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\"] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"16d15460-c344-58be-bd6c-ff5c5aa66b99\"] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\"] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\"] [:db/add \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/correct \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\"] [:db/ensure \"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/validate] [:db/add \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/id #uuid \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\"] [:db/add \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 9 x^{2}}=2\\\\sqrt{1-(\\\\frac{3 x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/difficulty :question.difficulty/hard] [:db/add \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/answer-fields \"815fa613-54ca-5424-b2a4-b9796145743c\"] [:db/ensure \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\"] [:db/add \"ce1ef3f3-0241-5334-9309-241a050c9cc4\" :answer/id #uuid \"ce1ef3f3-0241-5334-9309-241a050c9cc4\"] [:db/add \"ce1ef3f3-0241-5334-9309-241a050c9cc4\" :answer/type :answer.type/math] [:db/add \"ce1ef3f3-0241-5334-9309-241a050c9cc4\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}+C\"] [:db/ensure \"ce1ef3f3-0241-5334-9309-241a050c9cc4\" :answer/validate] [:db/add \"2905b413-bec8-5457-a9ab-da7f8c1307bf\" :answer/id #uuid \"2905b413-bec8-5457-a9ab-da7f8c1307bf\"] [:db/add \"2905b413-bec8-5457-a9ab-da7f8c1307bf\" :answer/type :answer.type/math] [:db/add \"2905b413-bec8-5457-a9ab-da7f8c1307bf\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"2905b413-bec8-5457-a9ab-da7f8c1307bf\" :answer/validate] [:db/add \"8462dca9-837c-583e-ab33-49c85dc0a377\" :answer/id #uuid \"8462dca9-837c-583e-ab33-49c85dc0a377\"] [:db/add \"8462dca9-837c-583e-ab33-49c85dc0a377\" :answer/type :answer.type/math] [:db/add \"8462dca9-837c-583e-ab33-49c85dc0a377\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}+C\"] [:db/ensure \"8462dca9-837c-583e-ab33-49c85dc0a377\" :answer/validate] [:db/add \"fea94ca2-e2b2-5752-8974-5635eb448c92\" :answer/id #uuid \"fea94ca2-e2b2-5752-8974-5635eb448c92\"] [:db/add \"fea94ca2-e2b2-5752-8974-5635eb448c92\" :answer/type :answer.type/math] [:db/add \"fea94ca2-e2b2-5752-8974-5635eb448c92\" :answer/value \"\\\\arcsin{\\\\left(x \\\\right)}+C\"] [:db/ensure \"fea94ca2-e2b2-5752-8974-5635eb448c92\" :answer/validate] [:db/add \"45d77756-bddb-512e-9a28-12964b46ae37\" :answer/id #uuid \"45d77756-bddb-512e-9a28-12964b46ae37\"] [:db/add \"45d77756-bddb-512e-9a28-12964b46ae37\" :answer/type :answer.type/math] [:db/add \"45d77756-bddb-512e-9a28-12964b46ae37\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"45d77756-bddb-512e-9a28-12964b46ae37\" :answer/validate] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/id #uuid \"379132fc-afd1-53f3-a173-3ecc9499f99f\"] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/key \"answer\"] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/type :answer-field.type/radio] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"ce1ef3f3-0241-5334-9309-241a050c9cc4\"] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"2905b413-bec8-5457-a9ab-da7f8c1307bf\"] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"8462dca9-837c-583e-ab33-49c85dc0a377\"] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"fea94ca2-e2b2-5752-8974-5635eb448c92\"] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"45d77756-bddb-512e-9a28-12964b46ae37\"] [:db/add \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/correct \"2905b413-bec8-5457-a9ab-da7f8c1307bf\"] [:db/ensure \"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/validate] [:db/add \"1e4637a3-72fb-557e-85fd-0def49912217\" :question/id #uuid \"1e4637a3-72fb-557e-85fd-0def49912217\"] [:db/add \"1e4637a3-72fb-557e-85fd-0def49912217\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"1e4637a3-72fb-557e-85fd-0def49912217\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 16 x^{2}}=5\\\\sqrt{1-(\\\\frac{4 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{5}\\\\cdot \\\\frac{5}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"1e4637a3-72fb-557e-85fd-0def49912217\" :question/difficulty :question.difficulty/hard] [:db/add \"1e4637a3-72fb-557e-85fd-0def49912217\" :question/answer-fields \"379132fc-afd1-53f3-a173-3ecc9499f99f\"] [:db/ensure \"1e4637a3-72fb-557e-85fd-0def49912217\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"1e4637a3-72fb-557e-85fd-0def49912217\"] [:db/add \"153207b8-967f-5f59-bd12-ae5e22b97cd9\" :answer/id #uuid \"153207b8-967f-5f59-bd12-ae5e22b97cd9\"] [:db/add \"153207b8-967f-5f59-bd12-ae5e22b97cd9\" :answer/type :answer.type/math] [:db/add \"153207b8-967f-5f59-bd12-ae5e22b97cd9\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"153207b8-967f-5f59-bd12-ae5e22b97cd9\" :answer/validate] [:db/add \"ef592788-f5b1-52cd-b140-a0d340f1dea4\" :answer/id #uuid \"ef592788-f5b1-52cd-b140-a0d340f1dea4\"] [:db/add \"ef592788-f5b1-52cd-b140-a0d340f1dea4\" :answer/type :answer.type/math] [:db/add \"ef592788-f5b1-52cd-b140-a0d340f1dea4\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"ef592788-f5b1-52cd-b140-a0d340f1dea4\" :answer/validate] [:db/add \"97886b89-c7e2-528a-abad-310da5f5c168\" :answer/id #uuid \"97886b89-c7e2-528a-abad-310da5f5c168\"] [:db/add \"97886b89-c7e2-528a-abad-310da5f5c168\" :answer/type :answer.type/math] [:db/add \"97886b89-c7e2-528a-abad-310da5f5c168\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"97886b89-c7e2-528a-abad-310da5f5c168\" :answer/validate] [:db/add \"0b45d82d-d26e-5c68-a136-f5686a3380de\" :answer/id #uuid \"0b45d82d-d26e-5c68-a136-f5686a3380de\"] [:db/add \"0b45d82d-d26e-5c68-a136-f5686a3380de\" :answer/type :answer.type/math] [:db/add \"0b45d82d-d26e-5c68-a136-f5686a3380de\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"0b45d82d-d26e-5c68-a136-f5686a3380de\" :answer/validate] [:db/add \"1268b773-686b-5e87-a8e0-5956661826c7\" :answer/id #uuid \"1268b773-686b-5e87-a8e0-5956661826c7\"] [:db/add \"1268b773-686b-5e87-a8e0-5956661826c7\" :answer/type :answer.type/math] [:db/add \"1268b773-686b-5e87-a8e0-5956661826c7\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"1268b773-686b-5e87-a8e0-5956661826c7\" :answer/validate] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/id #uuid \"4669df1f-6248-51d1-a8f9-79221324ef5a\"] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/key \"answer\"] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/type :answer-field.type/radio] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"153207b8-967f-5f59-bd12-ae5e22b97cd9\"] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"ef592788-f5b1-52cd-b140-a0d340f1dea4\"] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"97886b89-c7e2-528a-abad-310da5f5c168\"] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"0b45d82d-d26e-5c68-a136-f5686a3380de\"] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"1268b773-686b-5e87-a8e0-5956661826c7\"] [:db/add \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/correct \"153207b8-967f-5f59-bd12-ae5e22b97cd9\"] [:db/ensure \"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/validate] [:db/add \"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/id #uuid \"012c056c-c0aa-58f3-aac2-230db4d8f0af\"] [:db/add \"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/difficulty :question.difficulty/hard] [:db/add \"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/answer-fields \"4669df1f-6248-51d1-a8f9-79221324ef5a\"] [:db/ensure \"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"012c056c-c0aa-58f3-aac2-230db4d8f0af\"] [:db/add \"40a499b3-4946-5824-9e23-c62411759546\" :answer/id #uuid \"40a499b3-4946-5824-9e23-c62411759546\"] [:db/add \"40a499b3-4946-5824-9e23-c62411759546\" :answer/type :answer.type/math] [:db/add \"40a499b3-4946-5824-9e23-c62411759546\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"40a499b3-4946-5824-9e23-c62411759546\" :answer/validate] [:db/add \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\" :answer/id #uuid \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\"] [:db/add \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\" :answer/type :answer.type/math] [:db/add \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\" :answer/validate] [:db/add \"37443c11-d637-5757-ac8e-24ae357fcae1\" :answer/id #uuid \"37443c11-d637-5757-ac8e-24ae357fcae1\"] [:db/add \"37443c11-d637-5757-ac8e-24ae357fcae1\" :answer/type :answer.type/math] [:db/add \"37443c11-d637-5757-ac8e-24ae357fcae1\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"37443c11-d637-5757-ac8e-24ae357fcae1\" :answer/validate] [:db/add \"653e40a6-e01b-596d-933b-71404bcfb65c\" :answer/id #uuid \"653e40a6-e01b-596d-933b-71404bcfb65c\"] [:db/add \"653e40a6-e01b-596d-933b-71404bcfb65c\" :answer/type :answer.type/math] [:db/add \"653e40a6-e01b-596d-933b-71404bcfb65c\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"653e40a6-e01b-596d-933b-71404bcfb65c\" :answer/validate] [:db/add \"6672914f-bf49-5394-b4b7-0024279d68b4\" :answer/id #uuid \"6672914f-bf49-5394-b4b7-0024279d68b4\"] [:db/add \"6672914f-bf49-5394-b4b7-0024279d68b4\" :answer/type :answer.type/math] [:db/add \"6672914f-bf49-5394-b4b7-0024279d68b4\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"6672914f-bf49-5394-b4b7-0024279d68b4\" :answer/validate] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/id #uuid \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\"] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/key \"answer\"] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/type :answer-field.type/radio] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"40a499b3-4946-5824-9e23-c62411759546\"] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\"] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"37443c11-d637-5757-ac8e-24ae357fcae1\"] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"653e40a6-e01b-596d-933b-71404bcfb65c\"] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"6672914f-bf49-5394-b4b7-0024279d68b4\"] [:db/add \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/correct \"6672914f-bf49-5394-b4b7-0024279d68b4\"] [:db/ensure \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/validate] [:db/add \"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/id #uuid \"ac7ccb86-e562-5c18-93ff-df4783c50a60\"] [:db/add \"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/difficulty :question.difficulty/hard] [:db/add \"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/answer-fields \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\"] [:db/ensure \"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"ac7ccb86-e562-5c18-93ff-df4783c50a60\"] [:db/add \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\" :answer/id #uuid \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\"] [:db/add \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\" :answer/type :answer.type/math] [:db/add \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\" :answer/validate] [:db/add \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\" :answer/id #uuid \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\"] [:db/add \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\" :answer/type :answer.type/math] [:db/add \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\" :answer/validate] [:db/add \"708e6670-ad76-5e90-9673-8ae030ce8b34\" :answer/id #uuid \"708e6670-ad76-5e90-9673-8ae030ce8b34\"] [:db/add \"708e6670-ad76-5e90-9673-8ae030ce8b34\" :answer/type :answer.type/math] [:db/add \"708e6670-ad76-5e90-9673-8ae030ce8b34\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"708e6670-ad76-5e90-9673-8ae030ce8b34\" :answer/validate] [:db/add \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\" :answer/id #uuid \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\"] [:db/add \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\" :answer/type :answer.type/math] [:db/add \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\" :answer/validate] [:db/add \"8fd89241-99ae-5981-9431-3b9928391c7b\" :answer/id #uuid \"8fd89241-99ae-5981-9431-3b9928391c7b\"] [:db/add \"8fd89241-99ae-5981-9431-3b9928391c7b\" :answer/type :answer.type/math] [:db/add \"8fd89241-99ae-5981-9431-3b9928391c7b\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"8fd89241-99ae-5981-9431-3b9928391c7b\" :answer/validate] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/id #uuid \"1df600e8-2b95-509c-9eca-984825d6041e\"] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/key \"answer\"] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/type :answer-field.type/radio] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\"] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\"] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"708e6670-ad76-5e90-9673-8ae030ce8b34\"] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\"] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"8fd89241-99ae-5981-9431-3b9928391c7b\"] [:db/add \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/correct \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\"] [:db/ensure \"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/validate] [:db/add \"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/id #uuid \"7ae327cb-d047-56a3-9c96-709a008c4721\"] [:db/add \"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 4 x^{2}}=3\\\\sqrt{1-(\\\\frac{2 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{3}{2}=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/difficulty :question.difficulty/hard] [:db/add \"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/answer-fields \"1df600e8-2b95-509c-9eca-984825d6041e\"] [:db/ensure \"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"7ae327cb-d047-56a3-9c96-709a008c4721\"] [:db/add \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\" :answer/id #uuid \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\"] [:db/add \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\" :answer/type :answer.type/math] [:db/add \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\" :answer/validate] [:db/add \"a55a9174-841e-598a-b517-1d80d865122a\" :answer/id #uuid \"a55a9174-841e-598a-b517-1d80d865122a\"] [:db/add \"a55a9174-841e-598a-b517-1d80d865122a\" :answer/type :answer.type/math] [:db/add \"a55a9174-841e-598a-b517-1d80d865122a\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"a55a9174-841e-598a-b517-1d80d865122a\" :answer/validate] [:db/add \"0371a3bb-446f-5960-8416-af922ddc43a7\" :answer/id #uuid \"0371a3bb-446f-5960-8416-af922ddc43a7\"] [:db/add \"0371a3bb-446f-5960-8416-af922ddc43a7\" :answer/type :answer.type/math] [:db/add \"0371a3bb-446f-5960-8416-af922ddc43a7\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"0371a3bb-446f-5960-8416-af922ddc43a7\" :answer/validate] [:db/add \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\" :answer/id #uuid \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\"] [:db/add \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\" :answer/type :answer.type/math] [:db/add \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\" :answer/validate] [:db/add \"843860d6-41f1-5f30-843b-e8b02e08b437\" :answer/id #uuid \"843860d6-41f1-5f30-843b-e8b02e08b437\"] [:db/add \"843860d6-41f1-5f30-843b-e8b02e08b437\" :answer/type :answer.type/math] [:db/add \"843860d6-41f1-5f30-843b-e8b02e08b437\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"843860d6-41f1-5f30-843b-e8b02e08b437\" :answer/validate] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/id #uuid \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\"] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/key \"answer\"] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/type :answer-field.type/radio] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\"] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"a55a9174-841e-598a-b517-1d80d865122a\"] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"0371a3bb-446f-5960-8416-af922ddc43a7\"] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\"] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"843860d6-41f1-5f30-843b-e8b02e08b437\"] [:db/add \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/correct \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\"] [:db/ensure \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/validate] [:db/add \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/id #uuid \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\"] [:db/add \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/difficulty :question.difficulty/hard] [:db/add \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/answer-fields \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\"] [:db/ensure \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\"] [:db/add \"generator\" :question-generator/id #uuid \"375f0522-9a06-5cd7-92e2-a3c425b1a5ad\"] [:db/add \"generator\" :question-generator/script \"generators/17/17f7f31f26b9110e439de9d747417d47f6c4466c77668cb94d9d01a09bc3370d/generator.py\"] [:db/add 17592186064218 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186064218 :knowledge-point/validate]] \"assertions\" [[\"0ec71766-d192-5c90-89d7-91ae321ef30c\" :answer/id #uuid \"0ec71766-d192-5c90-89d7-91ae321ef30c\"] [\"0ec71766-d192-5c90-89d7-91ae321ef30c\" :answer/type :answer.type/math] [\"0ec71766-d192-5c90-89d7-91ae321ef30c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"44b1e915-0981-58de-b94b-d283d648df63\" :answer/id #uuid \"44b1e915-0981-58de-b94b-d283d648df63\"] [\"44b1e915-0981-58de-b94b-d283d648df63\" :answer/type :answer.type/math] [\"44b1e915-0981-58de-b94b-d283d648df63\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b2851085-df3e-5ca2-9696-6da8ff2428a4\" :answer/id #uuid \"b2851085-df3e-5ca2-9696-6da8ff2428a4\"] [\"b2851085-df3e-5ca2-9696-6da8ff2428a4\" :answer/type :answer.type/math] [\"b2851085-df3e-5ca2-9696-6da8ff2428a4\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"773b64a7-9996-54f1-8193-ef2088314066\" :answer/id #uuid \"773b64a7-9996-54f1-8193-ef2088314066\"] [\"773b64a7-9996-54f1-8193-ef2088314066\" :answer/type :answer.type/math] [\"773b64a7-9996-54f1-8193-ef2088314066\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ef595ad1-8974-5bbb-ab2c-666f90782c31\" :answer/id #uuid \"ef595ad1-8974-5bbb-ab2c-666f90782c31\"] [\"ef595ad1-8974-5bbb-ab2c-666f90782c31\" :answer/type :answer.type/math] [\"ef595ad1-8974-5bbb-ab2c-666f90782c31\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/id #uuid \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/key \"answer\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/type :answer-field.type/radio] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"0ec71766-d192-5c90-89d7-91ae321ef30c\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"44b1e915-0981-58de-b94b-d283d648df63\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"b2851085-df3e-5ca2-9696-6da8ff2428a4\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"773b64a7-9996-54f1-8193-ef2088314066\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"ef595ad1-8974-5bbb-ab2c-666f90782c31\"] [\"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/correct \"b2851085-df3e-5ca2-9696-6da8ff2428a4\"] [\"cc411b53-59e8-5c6e-aca6-364024091383\" :question/id #uuid \"cc411b53-59e8-5c6e-aca6-364024091383\"] [\"cc411b53-59e8-5c6e-aca6-364024091383\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"cc411b53-59e8-5c6e-aca6-364024091383\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"cc411b53-59e8-5c6e-aca6-364024091383\" :question/difficulty :question.difficulty/easy] [\"cc411b53-59e8-5c6e-aca6-364024091383\" :question/answer-fields \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\"] [17592186064218 :knowledge-point/questions \"cc411b53-59e8-5c6e-aca6-364024091383\"] [\"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\" :answer/id #uuid \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\"] [\"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\" :answer/type :answer.type/math] [\"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"1edf25e3-43c9-5d64-8b73-446718306503\" :answer/id #uuid \"1edf25e3-43c9-5d64-8b73-446718306503\"] [\"1edf25e3-43c9-5d64-8b73-446718306503\" :answer/type :answer.type/math] [\"1edf25e3-43c9-5d64-8b73-446718306503\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\"] [\"23cc7e21-2293-5e9a-aecf-3b72005c8270\" :answer/id #uuid \"23cc7e21-2293-5e9a-aecf-3b72005c8270\"] [\"23cc7e21-2293-5e9a-aecf-3b72005c8270\" :answer/type :answer.type/math] [\"23cc7e21-2293-5e9a-aecf-3b72005c8270\" :answer/value \"-6\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\" :answer/id #uuid \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\"] [\"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\" :answer/type :answer.type/math] [\"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\" :answer/value \"8\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c40a28b9-4fd9-5866-baea-cca8477c94a1\" :answer/id #uuid \"c40a28b9-4fd9-5866-baea-cca8477c94a1\"] [\"c40a28b9-4fd9-5866-baea-cca8477c94a1\" :answer/type :answer.type/math] [\"c40a28b9-4fd9-5866-baea-cca8477c94a1\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/id #uuid \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/key \"answer\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/type :answer-field.type/radio] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"1edf25e3-43c9-5d64-8b73-446718306503\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"23cc7e21-2293-5e9a-aecf-3b72005c8270\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"c40a28b9-4fd9-5866-baea-cca8477c94a1\"] [\"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/correct \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\"] [\"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/id #uuid \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\"] [\"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/difficulty :question.difficulty/easy] [\"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/answer-fields \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\"] [17592186064218 :knowledge-point/questions \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\"] [\"af49752a-b950-5d80-85f5-ade0cffc0d52\" :answer/id #uuid \"af49752a-b950-5d80-85f5-ade0cffc0d52\"] [\"af49752a-b950-5d80-85f5-ade0cffc0d52\" :answer/type :answer.type/math] [\"af49752a-b950-5d80-85f5-ade0cffc0d52\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"0cf57161-9db0-582f-ad42-9fa5a01cebc7\" :answer/id #uuid \"0cf57161-9db0-582f-ad42-9fa5a01cebc7\"] [\"0cf57161-9db0-582f-ad42-9fa5a01cebc7\" :answer/type :answer.type/math] [\"0cf57161-9db0-582f-ad42-9fa5a01cebc7\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"3edcf90c-38ed-5987-938d-24b31c372b40\" :answer/id #uuid \"3edcf90c-38ed-5987-938d-24b31c372b40\"] [\"3edcf90c-38ed-5987-938d-24b31c372b40\" :answer/type :answer.type/math] [\"3edcf90c-38ed-5987-938d-24b31c372b40\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"71210dbb-cc49-5cee-9a0f-a866a03d74ff\" :answer/id #uuid \"71210dbb-cc49-5cee-9a0f-a866a03d74ff\"] [\"71210dbb-cc49-5cee-9a0f-a866a03d74ff\" :answer/type :answer.type/math] [\"71210dbb-cc49-5cee-9a0f-a866a03d74ff\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"7ce8ea50-1973-5336-8d55-8c495f505767\" :answer/id #uuid \"7ce8ea50-1973-5336-8d55-8c495f505767\"] [\"7ce8ea50-1973-5336-8d55-8c495f505767\" :answer/type :answer.type/math] [\"7ce8ea50-1973-5336-8d55-8c495f505767\" :answer/value \"\\\\frac{4}{9}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/id #uuid \"51b2a8d2-e243-5f8c-acba-9d233cc30221\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/key \"answer\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/type :answer-field.type/radio] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/choices \"af49752a-b950-5d80-85f5-ade0cffc0d52\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/choices \"0cf57161-9db0-582f-ad42-9fa5a01cebc7\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/choices \"3edcf90c-38ed-5987-938d-24b31c372b40\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/choices \"71210dbb-cc49-5cee-9a0f-a866a03d74ff\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/choices \"7ce8ea50-1973-5336-8d55-8c495f505767\"] [\"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/correct \"71210dbb-cc49-5cee-9a0f-a866a03d74ff\"] [\"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/id #uuid \"75404dba-6602-5d66-b29a-e1014ce296c1\"] [\"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/difficulty :question.difficulty/easy] [\"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/answer-fields \"51b2a8d2-e243-5f8c-acba-9d233cc30221\"] [17592186064218 :knowledge-point/questions \"75404dba-6602-5d66-b29a-e1014ce296c1\"] [\"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\" :answer/id #uuid \"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\"] [\"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\" :answer/type :answer.type/math] [\"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\" :answer/value \"\\\\frac{2}{9}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d1c2af6f-f794-5053-8144-609619370623\" :answer/id #uuid \"d1c2af6f-f794-5053-8144-609619370623\"] [\"d1c2af6f-f794-5053-8144-609619370623\" :answer/type :answer.type/math] [\"d1c2af6f-f794-5053-8144-609619370623\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\" :answer/id #uuid \"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\"] [\"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\" :answer/type :answer.type/math] [\"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"14243db0-bbde-59f7-b8ea-d934eacde8d1\" :answer/id #uuid \"14243db0-bbde-59f7-b8ea-d934eacde8d1\"] [\"14243db0-bbde-59f7-b8ea-d934eacde8d1\" :answer/type :answer.type/math] [\"14243db0-bbde-59f7-b8ea-d934eacde8d1\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b493e0e7-639c-5927-b58f-d6155fce743e\" :answer/id #uuid \"b493e0e7-639c-5927-b58f-d6155fce743e\"] [\"b493e0e7-639c-5927-b58f-d6155fce743e\" :answer/type :answer.type/math] [\"b493e0e7-639c-5927-b58f-d6155fce743e\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/id #uuid \"ba26dad2-a01c-562d-b7f3-35dc1ea80540\"] [\"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/key \"answer\"] [\"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/type :answer-field.type/radio] [\"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/choices \"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\"] [\"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/choices \"d1c2af6f-f794-5053-8144-609619370623\"] [\"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/choices \"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\"] [\"ba26dad2-