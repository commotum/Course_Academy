0a\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"1b98e7c2-8e9a-5655-8f51-36ea3c237e0a\"] [:db/add \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\" :answer/id #uuid \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\"] [:db/add \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\" :answer/type :answer.type/math] [:db/add \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\" :answer/validate] [:db/add \"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\" :answer/id #uuid \"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\"] [:db/add \"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\" :answer/type :answer.type/math] [:db/add \"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\" :answer/validate] [:db/add \"d23b8153-50af-504f-8179-02440ccb4aa8\" :answer/id #uuid \"d23b8153-50af-504f-8179-02440ccb4aa8\"] [:db/add \"d23b8153-50af-504f-8179-02440ccb4aa8\" :answer/type :answer.type/math] [:db/add \"d23b8153-50af-504f-8179-02440ccb4aa8\" :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d23b8153-50af-504f-8179-02440ccb4aa8\" :answer/validate] [:db/add \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\" :answer/id #uuid \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\"] [:db/add \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\" :answer/type :answer.type/math] [:db/add \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\" :answer/value \"- \\\\frac{8}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\" :answer/validate] [:db/add \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\" :answer/id #uuid \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\"] [:db/add \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\" :answer/type :answer.type/math] [:db/add \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\" :answer/value \"\\\\frac{4}{15}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\" :answer/validate] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/id #uuid \"24394dc3-8bd6-5cca-b27f-92d75519c509\"] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/key \"answer\"] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/type :answer-field.type/radio] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\"] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\"] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"d23b8153-50af-504f-8179-02440ccb4aa8\"] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\"] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\"] [:db/add \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/correct \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\"] [:db/ensure \"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/validate] [:db/add \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/id #uuid \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\"] [:db/add \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{5}=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/difficulty :question.difficulty/easy] [:db/add \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/answer-fields \"24394dc3-8bd6-5cca-b27f-92d75519c509\"] [:db/ensure \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\"] [:db/add \"c7de5f94-d383-59f2-afb0-2e6658404e89\" :answer/id #uuid \"c7de5f94-d383-59f2-afb0-2e6658404e89\"] [:db/add \"c7de5f94-d383-59f2-afb0-2e6658404e89\" :answer/type :answer.type/math] [:db/add \"c7de5f94-d383-59f2-afb0-2e6658404e89\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c7de5f94-d383-59f2-afb0-2e6658404e89\" :answer/validate] [:db/add \"5d209f08-3431-51bf-b9a5-ae14de27ce03\" :answer/id #uuid \"5d209f08-3431-51bf-b9a5-ae14de27ce03\"] [:db/add \"5d209f08-3431-51bf-b9a5-ae14de27ce03\" :answer/type :answer.type/math] [:db/add \"5d209f08-3431-51bf-b9a5-ae14de27ce03\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5d209f08-3431-51bf-b9a5-ae14de27ce03\" :answer/validate] [:db/add \"058cd583-6c53-5d2b-b8d7-02e6eb277852\" :answer/id #uuid \"058cd583-6c53-5d2b-b8d7-02e6eb277852\"] [:db/add \"058cd583-6c53-5d2b-b8d7-02e6eb277852\" :answer/type :answer.type/math] [:db/add \"058cd583-6c53-5d2b-b8d7-02e6eb277852\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"058cd583-6c53-5d2b-b8d7-02e6eb277852\" :answer/validate] [:db/add \"3eddb3b6-0335-5aff-b6e2-0eec073dab66\" :answer/id #uuid \"3eddb3