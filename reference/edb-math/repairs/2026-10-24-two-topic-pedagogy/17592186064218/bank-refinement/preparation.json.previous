"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\" :answer/type :answer.type/math] [\"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\" :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d23b8153-50af-504f-8179-02440ccb4aa8\" :answer/id #uuid \"d23b8153-50af-504f-8179-02440ccb4aa8\"] [\"d23b8153-50af-504f-8179-02440ccb4aa8\" :answer/type :answer.type/math] [\"d23b8153-50af-504f-8179-02440ccb4aa8\" :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"da56109e-3190-5fbb-9dd6-f680a3b2aec4\" :answer/id #uuid \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\"] [\"da56109e-3190-5fbb-9dd6-f680a3b2aec4\" :answer/type :answer.type/math] [\"da56109e-3190-5fbb-9dd6-f680a3b2aec4\" :answer/value \"- \\\\frac{8}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"39aa20fb-2ef4-5c0f-9571-45aae23494c0\" :answer/id #uuid \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\"] [\"39aa20fb-2ef4-5c0f-9571-45aae23494c0\" :answer/type :answer.type/math] [\"39aa20fb-2ef4-5c0f-9571-45aae23494c0\" :answer/value \"\\\\frac{4}{15}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/id #uuid \"24394dc3-8bd6-5cca-b27f-92d75519c509\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/key \"answer\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/type :answer-field.type/radio] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"4e4e65a2-5bc2-559e-ab33-6abdafab2f86\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"d23b8153-50af-504f-8179-02440ccb4aa8\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"da56109e-3190-5fbb-9dd6-f680a3b2aec4\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/choices \"39aa20fb-2ef4-5c0f-9571-45aae23494c0\"] [\"24394dc3-8bd6-5cca-b27f-92d75519c509\" :answer-field/correct \"d89d73e0-d0f9-58fa-924d-e222e09fbcef\"] [\"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/id #uuid \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\"] [\"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{5}=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/difficulty :question.difficulty/easy] [\"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\" :question/answer-fields \"24394dc3-8bd6-5cca-b27f-92d75519c509\"] [17592186064218 :knowledge-point/questions \"f083db3d-ffc1-58ac-8ad1-ed80d72bb001\"] [\"c7de5f94-d383-59f2-afb0-2e6658404e89\" :answer/id #uuid \"c7de5f94-d383-59f2-afb0-2e6658404e89\"] [\"c7de5f94-d383-59f2-afb0-2e6658404e89\" :answer/type :answer.type/math] [\"c7de5f94-d383-59f2-afb0-2e6658404e89\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"5d209f08-3431-51bf-b9a5-ae14de27ce03\" :answer/id #uuid \"5d209f08-3431-51bf-b9a5-ae14de27ce03\"] [\"5d209f08-3431-51bf-b9a5-ae14de27ce03\" :answer/type :answer.type/math] [\"5d209f08-3431-51bf-b9a5-ae14de27ce03\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"058cd583-6c53-5d2b-b8d7-02e6eb277852\" :answer/id #uuid \"058cd583-6c53-5d2b-b8d7-02e6eb277852\"] [\"058cd583-6c53-5d2b-b8d7-02e6eb277852\" :answer/type :answer.type/math] [\"058cd583-6c53-5d2b-b8d7-02e6eb277852\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"3eddb3b6-0335-5aff-b6e2-0eec073dab66\" :answer/id #uuid \"3eddb3b6-0335-5aff-b6e2-0eec073dab66\"] [\"3eddb3b6-0335-5aff-b6e2-0eec073dab66\" :answer/type :answer.type/math] [\"3eddb3b6-0335-5aff-b6e2-0eec073dab66\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\"] [\"a62c80df-e70e-5795-a7c8-1fa8866538a1\" :answer/id #uuid \"a62c80df-e70e-5795-a7c8-1fa8866538a1\"] [\"a62c80df-e70e-5795-a7c8-1fa8866538a1\" :answer/type :answer.type/math] [\"a62c80df-e70e-5795-a7c8-1fa8866538a1\" :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/id #uuid \"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/key \"answer\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/type :answer-field.type/radio] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/choices \"c7de5f94-d383-59f2-afb0-2e6658404e89\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/choices \"5d209f08-3431-51bf-b9a5-ae14de27ce03\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/choices \"058cd583-6c53-5d2b-b8d7-02e6eb277852\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/choices \"3eddb3b6-0335-5aff-b6e2-0eec073dab66\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/choices \"a62c80df-e70e-5795-a7c8-1fa8866538a1\"] [\"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\" :answer-field/correct \"3eddb3b6-0335-5aff-b6e2-0eec073dab66\"] [\"b46520e2-8393-5de1-be06-50725802fa84\" :question/id #uuid \"b46520e2-8393-5de1-be06-50725802fa84\"] [\"b46520e2-8393-5de1-be06-50725802fa84\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"b46520e2-8393-5de1-be06-50725802fa84\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\n$$\"] [\"b46520e2-8393-5de1-be06-50725802fa84\" :question/difficulty :question.difficulty/easy] [\"b46520e2-8393-5de1-be06-50725802fa84\" :question/answer-fields \"b03e80bb-34d2-5dc0-8f11-c8f0c17dc1e1\"] [17592186064218 :knowledge-point/questions \"b46520e2-8393-5de1-be06-50725802fa84\"] [\"cbdddafa-9be7-5e98-973b-dd4f3bb7695d\" :answer/id #uuid \"cbdddafa-9be7-5e98-973b-dd4f3bb7695d\"] [\"cbdddafa-9be7-5e98-973b-dd4f3bb7695d\" :answer/type :answer.type/math] [\"cbdddafa-9be7-5e98-973b-dd4f3bb7695d\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"ff80e381-e130-5fd9-a95c-788f8e47a8a8\" :answer/id #uuid \"ff80e381-e130-5fd9-a95c-788f8e47a8a8\"] [\"ff80e381-e130-5fd9-a95c-788f8e47a8a8\" :answer/type :answer.type/math] [\"ff80e381-e130-5fd9-a95c-788f8e47a8a8\" :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"e3711022-6630-5d01-8274-e51b51b64d42\" :answer/id #uuid \"e3711022-6630-5d01-8274-e51b51b64d42\"] [\"e3711022-6630-5d01-8274-e51b51b64d42\" :answer/type :answer.type/math] [\"e3711022-6630-5d01-8274-e51b51b64d42\" :answer/value \"\\\\frac{1}{16}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"72281e4d-d8e3-5aa3-806e-897099cb473b\" :answer/id #uuid \"72281e4d-d8e3-5aa3-806e-897099cb473b\"] [\"72281e4d-d8e3-5aa3-806e-897099cb473b\" :answer/type :answer.type/math] [\"72281e4d-d8e3-5aa3-806e-897099cb473b\" :answer/value \"\\\\frac{1}{12}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"6e7cfa1e-0fcf-5c6f-a38b-58c8d91d433e\" :answer/id #uuid \"6e7cfa1e-0fcf-5c6f-a38b-58c8d91d433e\"] [\"6e7cfa1e-0fcf-5c6f-a38b-58c8d91d433e\" :answer/type :answer.type/math] [\"6e7cfa1e-0fcf-5c6f-a38b-58c8d91d433e\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/id #uuid \"553a2ded-32b2-5bc1-94c6-af80b3f751a7\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/key \"answer\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/type :answer-field.type/radio] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/choices \"cbdddafa-9be7-5e98-973b-dd4f3bb7695d\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/choices \"ff80e381-e130-5fd9-a95c-788f8e47a8a8\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/choices \"e3711022-6630-5d01-8274-e51b51b64d42\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/choices \"72281e4d-d8e3-5aa3-806e-897099cb473b\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/choices \"6e7cfa1e-0fcf-5c6f-a38b-58c8d91d433e\"] [\"553a2ded-32b2-5bc1-94c6-af80b3f751a7\" :answer-field/correct \"6e7cfa1e-0fcf-5c6f-a38b-58c8d91d433e\"] [\"80642ecb-a7bf-5ecf-b181-2c9d86eed532\" :question/id #uuid \"80642ecb-a7bf-5ecf-b181-2c9d86eed532\"] [\"80642ecb-a7bf-5ecf-b181-2c9d86eed532\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"80642ecb-a7bf-5ecf-b181-2c9d86eed532\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"80642ecb-a7bf-5ecf-b181-2c9d86eed532\" :question/difficulty :question.difficulty/easy] [\"80642ecb-a7bf-5ecf-b181-2c9d86eed532\" :question/answer-fields \"553a2ded-32b2-5bc1-94c6-af80b3f751a7\"] [17592186064218 :knowledge-point/questions \"80642ecb-a7bf-5ecf-b181-2c9d86eed532\"] [\"efcb16f0-b034-54f8-be60-cacfde229ea4\" :answer/id #uuid \"efcb16f0-b034-54f8-be60-cacfde229ea4\"] [\"efcb16f0-b034-54f8-be60-cacfde229ea4\" :answer/type :answer.type/math] [\"efcb16f0-b034-54f8-be60-cacfde229ea4\" :answer/value \"\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"43a3c627-8420-553e-9775-8297c5519256\" :answer/id #uuid \"43a3c627-8420-553e-9775-8297c5519256\"] [\"43a3c627-8420-553e-9775-8297c5519256\" :answer/type :answer.type/math] [\"43a3c627-8420-553e-9775-8297c5519256\" :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"d41339c2-4319-5ac1-9edb-43963bb0bf1e\" :answer/id #uuid \"d41339c2-4319-5ac1-9edb-43963bb0bf1e\"] [\"d41339c2-4319-5ac1-9edb-43963bb0bf1e\" :answer/type :answer.type/math] [\"d41339c2-4319-5ac1-9edb-43963bb0bf1e\" :answer/value \"- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"88ae7e44-6ec9-5993-840d-775267630964\" :answer/id #uuid \"88ae7e44-6ec9-5993-840d-775267630964\"] [\"88ae7e44-6ec9-5993-840d-775267630964\" :answer/type :answer.type/math] [\"88ae7e44-6ec9-5993-840d-775267630964\" :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"c937b68c-882d-5db6-9845-e4f007fc9953\" :answer/id #uuid \"c937b68c-882d-5db6-9845-e4f007fc9953\"] [\"c937b68c-882d-5db6-9845-e4f007fc9953\" :answer/type :answer.type/math] [\"c937b68c-882d-5db6-9845-e4f007fc9953\" :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/id #uuid \"81dd724e-4227-52d4-815e-348f1b11afee\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/key \"answer\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/type :answer-field.type/radio] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/choices \"efcb16f0-b034-54f8-be60-cacfde229ea4\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/choices \"43a3c627-8420-553e-9775-8297c5519256\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/choices \"d41339c2-4319-5ac1-9edb-43963bb0bf1e\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/choices \"88ae7e44-6ec9-5993-840d-775267630964\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/choices \"c937b68c-882d-5db6-9845-e4f007fc9953\"] [\"81dd724e-4227-52d4-815e-348f1b11afee\" :answer-field/correct \"c937b68c-882d-5db6-9845-e4f007fc9953\"] [\"56d6cead-d259-5303-87fb-5e2111fe05f3\" :question/id #uuid \"56d6cead-d259-5303-87fb-5e2111fe05f3\"] [\"56d6cead-d259-5303-87fb-5e2111fe05f3\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [\"56d6cead-d259-5303-87fb-5e2111fe05f3\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{1 - 25 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [\"56d6cead-d259-5303-87fb-5e2111fe05f3\" :question/difficulty :question.difficulty/easy] [\"56d6cead-d259-5303-87fb-5e2111fe05f3\" :question/answer-fields \"81dd724e-4227-52d4-815e-348f1b11afee\"] [17592186064218 :knowledge-point/questions \"56d6cead-d259-5303-87fb-5e2111fe05f3\"] [\"2fa9a6cf-4858-559e-916a-a1315f3dfe2b\" :answer/id #uuid \"2fa9a6cf-4858-559e-916a-a1315f3dfe2b\"] [\"2fa9a6cf-4858-559e-916a-a1315f3dfe2b\" :answer/type :answer.type/math] [\"2fa9a6cf-4858-559e-916a-a1315f3dfe2b\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}+C\"] [\"6cded9ad-cc23-5579-9aa3-f736deb6117d\" :answer/id #uuid \"6cded9ad-cc23-5579-9aa3-f736deb6117d\"] [\"6cded9ad-cc23-5579-9aa3-f736deb6117d\" :answer/type :answer.type/math] [\"6cded9ad-cc23-5579-9aa3-f736deb6117d\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"315e4ff4-ec1d-56c7-aa23-df35250ec972\" :answer/id #uuid \"315e4ff4-ec1d-56c7-aa23-df35250ec972\"] [\"315e4ff4-ec1d-56c7-aa23-df35250ec972\" :answer/type :answer.type/math] [\"315e4ff4-ec1d-56c7-aa23-df35250ec972\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"0f3b0e8a-c465-5427-be23-1a85f3f636f8\" :answer/id #uuid \"0f3b0e8a-c465-5427-be23-1a85f3f636f8\"] [\"0f3b0e8a-c465-5427-be23-1a85f3f636f8\" :answer/type :answer.type/math] [\"0f3b0e8a-c465-5427-be23-1a85f3f636f8\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"4be62f24-c88a-59b7-b3bc-4d6b50594e21\" :answer/id #uuid \"4be62f24-c88a-59b7-b3bc-4d6b50594e21\"] [\"4be62f24-c88a-59b7-b3bc-4d6b50594e21\" :answer/type :answer.type/math] [\"4be62f24-c88a-59b7-b3bc-4d6b50594e21\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}+C\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/id #uuid \"14e877b1-eed4-58e5-a9a6-60c0c3a37664\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/key \"answer\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/type :answer-field.type/radio] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/choices \"2fa9a6cf-4858-559e-916a-a1315f3dfe2b\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/choices \"6cded9ad-cc23-5579-9aa3-f736deb6117d\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/choices \"315e4ff4-ec1d-56c7-aa23-df35250ec972\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/choices \"0f3b0e8a-c465-5427-be23-1a85f3f636f8\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/choices \"4be62f24-c88a-59b7-b3bc-4d6b50594e21\"] [\"14e877b1-eed4-58e5-a9a6-60c0c3a37664\" :answer-field/correct \"315e4ff4-ec1d-56c7-aa23-df35250ec972\"] [\"96100969-066d-5014-b021-b96b25f2b3b9\" :question/id #uuid \"96100969-066d-5014-b021-b96b25f2b3b9\"] [\"96100969-066d-5014-b021-b96b25f2b3b9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"96100969-066d-5014-b021-b96b25f2b3b9\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{3}\\\\cdot 3=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"96100969-066d-5014-b021-b96b25f2b3b9\" :question/difficulty :question.difficulty/moderate] [\"96100969-066d-5014-b021-b96b25f2b3b9\" :question/answer-fields \"14e877b1-eed4-58e5-a9a6-60c0c3a37664\"] [17592186064218 :knowledge-point/questions \"96100969-066d-5014-b021-b96b25f2b3b9\"] [\"857d92c7-90cb-55bf-8622-19f8dadfc3bb\" :answer/id #uuid \"857d92c7-90cb-55bf-8622-19f8dadfc3bb\"] [\"857d92c7-90cb-55bf-8622-19f8dadfc3bb\" :answer/type :answer.type/math] [\"857d92c7-90cb-55bf-8622-19f8dadfc3bb\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"77100392-83c2-53b8-8787-ea965743c68d\" :answer/id #uuid \"77100392-83c2-53b8-8787-ea965743c68d\"] [\"77100392-83c2-53b8-8787-ea965743c68d\" :answer/type :answer.type/math] [\"77100392-83c2-53b8-8787-ea965743c68d\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"da279c9f-69d6-5715-8bee-e28e55f1c47a\" :answer/id #uuid \"da279c9f-69d6-5715-8bee-e28e55f1c47a\"] [\"da279c9f-69d6-5715-8bee-e28e55f1c47a\" :answer/type :answer.type/math] [\"da279c9f-69d6-5715-8bee-e28e55f1c47a\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"55163330-bfe7-5529-9d4c-9debf1865250\" :answer/id #uuid \"55163330-bfe7-5529-9d4c-9debf1865250\"] [\"55163330-bfe7-5529-9d4c-9debf1865250\" :answer/type :answer.type/math] [\"55163330-bfe7-5529-9d4c-9debf1865250\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"88f73057-8300-5eed-8fce-c10dbefff77a\" :answer/id #uuid \"88f73057-8300-5eed-8fce-c10dbefff77a\"] [\"88f73057-8300-5eed-8fce-c10dbefff77a\" :answer/type :answer.type/math] [\"88f73057-8300-5eed-8fce-c10dbefff77a\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/id #uuid \"aec901a7-c5f6-5de8-a811-82f353c28823\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/key \"answer\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/type :answer-field.type/radio] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/choices \"857d92c7-90cb-55bf-8622-19f8dadfc3bb\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/choices \"77100392-83c2-53b8-8787-ea965743c68d\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/choices \"da279c9f-69d6-5715-8bee-e28e55f1c47a\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/choices \"55163330-bfe7-5529-9d4c-9debf1865250\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/choices \"88f73057-8300-5eed-8fce-c10dbefff77a\"] [\"aec901a7-c5f6-5de8-a811-82f353c28823\" :answer-field/correct \"da279c9f-69d6-5715-8bee-e28e55f1c47a\"] [\"ef6e80f4-b442-5ef9-b012-ef27f6c6b282\" :question/id #uuid \"ef6e80f4-b442-5ef9-b012-ef27f6c6b282\"] [\"ef6e80f4-b442-5ef9-b012-ef27f6c6b282\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"ef6e80f4-b442-5ef9-b012-ef27f6c6b282\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot 3=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"ef6e80f4-b442-5ef9-b012-ef27f6c6b282\" :question/difficulty :question.difficulty/moderate] [\"ef6e80f4-b442-5ef9-b012-ef27f6c6b282\" :question/answer-fields \"aec901a7-c5f6-5de8-a811-82f353c28823\"] [17592186064218 :knowledge-point/questions \"ef6e80f4-b442-5ef9-b012-ef27f6c6b282\"] [\"356aa473-84e1-5535-aaa2-aa2681447f42\" :answer/id #uuid \"356aa473-84e1-5535-aaa2-aa2681447f42\"] [\"356aa473-84e1-5535-aaa2-aa2681447f42\" :answer/type :answer.type/math] [\"356aa473-84e1-5535-aaa2-aa2681447f42\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"7b2b68e8-b944-599c-b112-ffad3b49ee2e\" :answer/id #uuid \"7b2b68e8-b944-599c-b112-ffad3b49ee2e\"] [\"7b2b68e8-b944-599c-b112-ffad3b49ee2e\" :answer/type :answer.type/math] [\"7b2b68e8-b944-599c-b112-ffad3b49ee2e\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"137bef25-0c9d-53eb-b93f-8dadcf9ad2e6\" :answer/id #uuid \"137bef25-0c9d-53eb-b93f-8dadcf9ad2e6\"] [\"137bef25-0c9d-53eb-b93f-8dadcf9ad2e6\" :answer/type :answer.type/math] [\"137bef25-0c9d-53eb-b93f-8dadcf9ad2e6\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"acddae16-70ca-5fa3-ac17-19f9dfc59096\" :answer/id #uuid \"acddae16-70ca-5fa3-ac17-19f9dfc59096\"] [\"acddae16-70ca-5fa3-ac17-19f9dfc59096\" :answer/type :answer.type/math] [\"acddae16-70ca-5fa3-ac17-19f9dfc59096\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}+C\"] [\"7a88937d-98b1-5a0a-a2ca-19e05052aaaf\" :answer/id #uuid \"7a88937d-98b1-5a0a-a2ca-19e05052aaaf\"] [\"7a88937d-98b1-5a0a-a2ca-19e05052aaaf\" :answer/type :answer.type/math] [\"7a88937d-98b1-5a0a-a2ca-19e05052aaaf\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/id #uuid \"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/key \"answer\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/type :answer-field.type/radio] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/choices \"356aa473-84e1-5535-aaa2-aa2681447f42\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/choices \"7b2b68e8-b944-599c-b112-ffad3b49ee2e\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/choices \"137bef25-0c9d-53eb-b93f-8dadcf9ad2e6\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/choices \"acddae16-70ca-5fa3-ac17-19f9dfc59096\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/choices \"7a88937d-98b1-5a0a-a2ca-19e05052aaaf\"] [\"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\" :answer-field/correct \"7b2b68e8-b944-599c-b112-ffad3b49ee2e\"] [\"a1b9c34c-5506-51fe-8360-e85d7783f504\" :question/id #uuid \"a1b9c34c-5506-51fe-8360-e85d7783f504\"] [\"a1b9c34c-5506-51fe-8360-e85d7783f504\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"a1b9c34c-5506-51fe-8360-e85d7783f504\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 2=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"a1b9c34c-5506-51fe-8360-e85d7783f504\" :question/difficulty :question.difficulty/moderate] [\"a1b9c34c-5506-51fe-8360-e85d7783f504\" :question/answer-fields \"7b3269e1-45a2-5b31-8ff8-ffe29be72b8f\"] [17592186064218 :knowledge-point/questions \"a1b9c34c-5506-51fe-8360-e85d7783f504\"] [\"07f2c3b5-a666-58aa-801f-8f96561d27b1\" :answer/id #uuid \"07f2c3b5-a666-58aa-801f-8f96561d27b1\"] [\"07f2c3b5-a666-58aa-801f-8f96561d27b1\" :answer/type :answer.type/math] [\"07f2c3b5-a666-58aa-801f-8f96561d27b1\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"5b3f02eb-d44e-552b-8e56-5bfcf92c87e4\" :answer/id #uuid \"5b3f02eb-d44e-552b-8e56-5bfcf92c87e4\"] [\"5b3f02eb-d44e-552b-8e56-5bfcf92c87e4\" :answer/type :answer.type/math] [\"5b3f02eb-d44e-552b-8e56-5bfcf92c87e4\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"7da8c8c1-b742-5ca6-a3f5-5c1edb13d182\" :answer/id #uuid \"7da8c8c1-b742-5ca6-a3f5-5c1edb13d182\"] [\"7da8c8c1-b742-5ca6-a3f5-5c1edb13d182\" :answer/type :answer.type/math] [\"7da8c8c1-b742-5ca6-a3f5-5c1edb13d182\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"b67a993a-4802-51da-8691-bb651164582d\" :answer/id #uuid \"b67a993a-4802-51da-8691-bb651164582d\"] [\"b67a993a-4802-51da-8691-bb651164582d\" :answer/type :answer.type/math] [\"b67a993a-4802-51da-8691-bb651164582d\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"bb3ec334-e96d-5437-8f99-389021fd2c33\" :answer/id #uuid \"bb3ec334-e96d-5437-8f99-389021fd2c33\"] [\"bb3ec334-e96d-5437-8f99-389021fd2c33\" :answer/type :answer.type/math] [\"bb3ec334-e96d-5437-8f99-389021fd2c33\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/id #uuid \"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/key \"answer\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/type :answer-field.type/radio] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/choices \"07f2c3b5-a666-58aa-801f-8f96561d27b1\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/choices \"5b3f02eb-d44e-552b-8e56-5bfcf92c87e4\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/choices \"7da8c8c1-b742-5ca6-a3f5-5c1edb13d182\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/choices \"b67a993a-4802-51da-8691-bb651164582d\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/choices \"bb3ec334-e96d-5437-8f99-389021fd2c33\"] [\"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\" :answer-field/correct \"07f2c3b5-a666-58aa-801f-8f96561d27b1\"] [\"e4c8e167-221b-5005-acc4-46a539f68550\" :question/id #uuid \"e4c8e167-221b-5005-acc4-46a539f68550\"] [\"e4c8e167-221b-5005-acc4-46a539f68550\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e4c8e167-221b-5005-acc4-46a539f68550\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot 2=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"e4c8e167-221b-5005-acc4-46a539f68550\" :question/difficulty :question.difficulty/moderate] [\"e4c8e167-221b-5005-acc4-46a539f68550\" :question/answer-fields \"bc859b12-ce5c-59f6-a573-b923ea5e7fb1\"] [17592186064218 :knowledge-point/questions \"e4c8e167-221b-5005-acc4-46a539f68550\"] [\"829f43d8-7cbe-57fe-bc49-f1315b3eb66b\" :answer/id #uuid \"829f43d8-7cbe-57fe-bc49-f1315b3eb66b\"] [\"829f43d8-7cbe-57fe-bc49-f1315b3eb66b\" :answer/type :answer.type/math] [\"829f43d8-7cbe-57fe-bc49-f1315b3eb66b\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"0d50adb3-edc2-5e17-9435-bc631c8b2465\" :answer/id #uuid \"0d50adb3-edc2-5e17-9435-bc631c8b2465\"] [\"0d50adb3-edc2-5e17-9435-bc631c8b2465\" :answer/type :answer.type/math] [\"0d50adb3-edc2-5e17-9435-bc631c8b2465\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\" :answer/id #uuid \"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\"] [\"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\" :answer/type :answer.type/math] [\"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"ca6a1d5b-1c71-5d9a-8798-689d17515cac\" :answer/id #uuid \"ca6a1d5b-1c71-5d9a-8798-689d17515cac\"] [\"ca6a1d5b-1c71-5d9a-8798-689d17515cac\" :answer/type :answer.type/math] [\"ca6a1d5b-1c71-5d9a-8798-689d17515cac\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"6f7199a1-2a8e-57a3-8c55-ddecd0ddc83e\" :answer/id #uuid \"6f7199a1-2a8e-57a3-8c55-ddecd0ddc83e\"] [\"6f7199a1-2a8e-57a3-8c55-ddecd0ddc83e\" :answer/type :answer.type/math] [\"6f7199a1-2a8e-57a3-8c55-ddecd0ddc83e\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{10} \\\\right)}\\\\right)+C\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/id #uuid \"115ff9eb-588c-5227-9552-be54ce05213b\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/key \"answer\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/type :answer-field.type/radio] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/choices \"829f43d8-7cbe-57fe-bc49-f1315b3eb66b\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/choices \"0d50adb3-edc2-5e17-9435-bc631c8b2465\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/choices \"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/choices \"ca6a1d5b-1c71-5d9a-8798-689d17515cac\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/choices \"6f7199a1-2a8e-57a3-8c55-ddecd0ddc83e\"] [\"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/correct \"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\"] [\"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/id #uuid \"ebbf711d-d552-58b8-b833-8a18f08425bc\"] [\"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - x^{2}}=5\\\\sqrt{1-(\\\\frac{x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{5}\\\\cdot 5=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/difficulty :question.difficulty/moderate] [\"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/answer-fields \"115ff9eb-588c-5227-9552-be54ce05213b\"] [17592186064218 :knowledge-point/questions \"ebbf711d-d552-58b8-b833-8a18f08425bc\"] [\"b2e7655b-d010-5e67-a3b2-543340e5e1e2\" :answer/id #uuid \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\"] [\"b2e7655b-d010-5e67-a3b2-543340e5e1e2\" :answer/type :answer.type/math] [\"b2e7655b-d010-5e67-a3b2-543340e5e1e2\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"542f7914-9bd1-5687-a1e3-0629bce86c3e\" :answer/id #uuid \"542f7914-9bd1-5687-a1e3-0629bce86c3e\"] [\"542f7914-9bd1-5687-a1e3-0629bce86c3e\" :answer/type :answer.type/math] [\"542f7914-9bd1-5687-a1e3-0629bce86c3e\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\" :answer/id #uuid \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\"] [\"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\" :answer/type :answer.type/math] [\"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"b80a0f06-252c-51c6-815c-a6a39f81bbaa\" :answer/id #uuid \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\"] [\"b80a0f06-252c-51c6-815c-a6a39f81bbaa\" :answer/type :answer.type/math] [\"b80a0f06-252c-51c6-815c-a6a39f81bbaa\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [\"19ea5306-8522-567e-a46a-9edda662e462\" :answer/id #uuid \"19ea5306-8522-567e-a46a-9edda662e462\"] [\"19ea5306-8522-567e-a46a-9edda662e462\" :answer/type :answer.type/math] [\"19ea5306-8522-567e-a46a-9edda662e462\" :answer/value \"-4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/id #uuid \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/key \"answer\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/type :answer-field.type/radio] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"542f7914-9bd1-5687-a1e3-0629bce86c3e\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"19ea5306-8522-567e-a46a-9edda662e462\"] [\"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/correct \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\"] [\"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/id #uuid \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\"] [\"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 4=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/difficulty :question.difficulty/moderate] [\"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/answer-fields \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\"] [17592186064218 :knowledge-point/questions \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\"] [\"c47c661f-037f-51b9-8d03-0be231871dcb\" :answer/id #uuid \"c47c661f-037f-51b9-8d03-0be231871dcb\"] [\"c47c661f-037f-51b9-8d03-0be231871dcb\" :answer/type :answer.type/math] [\"c47c661f-037f-51b9-8d03-0be231871dcb\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"52347b5d-701b-508d-9f0d-6db99534fc48\" :answer/id #uuid \"52347b5d-701b-508d-9f0d-6db99534fc48\"] [\"52347b5d-701b-508d-9f0d-6db99534fc48\" :answer/type :answer.type/math] [\"52347b5d-701b-508d-9f0d-6db99534fc48\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"49f61ff3-2254-54da-b1eb-a491bf3dfdd5\" :answer/id #uuid \"49f61ff3-2254-54da-b1eb-a491bf3dfdd5\"] [\"49f61ff3-2254-54da-b1eb-a491bf3dfdd5\" :answer/type :answer.type/math] [\"49f61ff3-2254-54da-b1eb-a491bf3dfdd5\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"72ac2255-de6b-5677-9fdb-2d0e668960c9\" :answer/id #uuid \"72ac2255-de6b-5677-9fdb-2d0e668960c9\"] [\"72ac2255-de6b-5677-9fdb-2d0e668960c9\" :answer/type :answer.type/math] [\"72ac2255-de6b-5677-9fdb-2d0e668960c9\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"f5905b5d-1dad-500a-b3c1-d3d38a24c291\" :answer/id #uuid \"f5905b5d-1dad-500a-b3c1-d3d38a24c291\"] [\"f5905b5d-1dad-500a-b3c1-d3d38a24c291\" :answer/type :answer.type/math] [\"f5905b5d-1dad-500a-b3c1-d3d38a24c291\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{8} \\\\right)}\\\\right)+C\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/id #uuid \"45395d8a-6aaa-567d-a6f9-d5037bc36c11\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/key \"answer\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/type :answer-field.type/radio] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/choices \"c47c661f-037f-51b9-8d03-0be231871dcb\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/choices \"52347b5d-701b-508d-9f0d-6db99534fc48\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/choices \"49f61ff3-2254-54da-b1eb-a491bf3dfdd5\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/choices \"72ac2255-de6b-5677-9fdb-2d0e668960c9\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/choices \"f5905b5d-1dad-500a-b3c1-d3d38a24c291\"] [\"45395d8a-6aaa-567d-a6f9-d5037bc36c11\" :answer-field/correct \"72ac2255-de6b-5677-9fdb-2d0e668960c9\"] [\"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/id #uuid \"94bdb05f-43fe-5e78-b307-235e180d305b\"] [\"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 4=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/difficulty :question.difficulty/moderate] [\"94bdb05f-43fe-5e78-b307-235e180d305b\" :question/answer-fields \"45395d8a-6aaa-567d-a6f9-d5037bc36c11\"] [17592186064218 :knowledge-point/questions \"94bdb05f-43fe-5e78-b307-235e180d305b\"] [\"81890c2f-78e2-5a08-b6c6-c6584837ddf2\" :answer/id #uuid \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\"] [\"81890c2f-78e2-5a08-b6c6-c6584837ddf2\" :answer/type :answer.type/math] [\"81890c2f-78e2-5a08-b6c6-c6584837ddf2\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{8} \\\\right)}\\\\right)+C\"] [\"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\" :answer/id #uuid \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\"] [\"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\" :answer/type :answer.type/math] [\"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\" :answer/id #uuid \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\"] [\"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\" :answer/type :answer.type/math] [\"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}+C\"] [\"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\" :answer/id #uuid \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\"] [\"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\" :answer/type :answer.type/math] [\"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\" :answer/id #uuid \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\"] [\"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\" :answer/type :answer.type/math] [\"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/id #uuid \"6a93db62-009c-5ff9-a474-4b16d95b59e1\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/key \"answer\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/type :answer-field.type/radio] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"81890c2f-78e2-5a08-b6c6-c6584837ddf2\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"fa9d47dc-a68c-55d4-b4e8-bf1a8b18a127\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"ac7c8aa5-681c-51eb-806f-778a3cf62aa4\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/choices \"f7b9a3c1-00d3-5717-b42b-9b6a43928c61\"] [\"6a93db62-009c-5ff9-a474-4b16d95b59e1\" :answer-field/correct \"dd3e0d5c-1889-51df-b42c-5c97a8acb8a5\"] [\"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/id #uuid \"1d205cfc-223d-5f12-94e3-54557487a6df\"] [\"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot 4=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [\"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/difficulty :question.difficulty/moderate] [\"1d205cfc-223d-5f12-94e3-54557487a6df\" :question/answer-fields \"6a93db62-009c-5ff9-a474-4b16d95b59e1\"] [17592186064218 :knowledge-point/questions \"1d205cfc-223d-5f12-94e3-54557487a6df\"] [\"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\" :answer/id #uuid \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\"] [\"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\" :answer/type :answer.type/math] [\"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [\"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\" :answer/id #uuid \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\"] [\"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\" :answer/type :answer.type/math] [\"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"c6f9cfc9-045a-5c64-9b76-399092f18a17\" :answer/id #uuid \"c6f9cfc9-045a-5c64-9b76-399092f18a17\"] [\"c6f9cfc9-045a-5c64-9b76-399092f18a17\" :answer/type :answer.type/math] [\"c6f9cfc9-045a-5c64-9b76-399092f18a17\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}+C\"] [\"082e9f1c-b7f4-55f7-812a-806915841186\" :answer/id #uuid \"082e9f1c-b7f4-55f7-812a-806915841186\"] [\"082e9f1c-b7f4-55f7-812a-806915841186\" :answer/type :answer.type/math] [\"082e9f1c-b7f4-55f7-812a-806915841186\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"a538a893-d9e5-5400-bada-2d743c13ef4b\" :answer/id #uuid \"a538a893-d9e5-5400-bada-2d743c13ef4b\"] [\"a538a893-d9e5-5400-bada-2d743c13ef4b\" :answer/type :answer.type/math] [\"a538a893-d9e5-5400-bada-2d743c13ef4b\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/id #uuid \"a972b44c-4443-5a49-ba25-77dd606919f5\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/key \"answer\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/type :answer-field.type/radio] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"ebd5a28d-82cf-5df3-9893-3d85eeeff7fa\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"34e122c0-3af1-5d6f-9f59-0b1fafedb19b\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"c6f9cfc9-045a-5c64-9b76-399092f18a17\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"082e9f1c-b7f4-55f7-812a-806915841186\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/choices \"a538a893-d9e5-5400-bada-2d743c13ef4b\"] [\"a972b44c-4443-5a49-ba25-77dd606919f5\" :answer-field/correct \"a538a893-d9e5-5400-bada-2d743c13ef4b\"] [\"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/id #uuid \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\"] [\"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/worked-solution \"Let $u=\\\\frac{2 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 4 x^{2}}=5\\\\sqrt{1-(\\\\frac{2 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{5}\\\\cdot \\\\frac{5}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/difficulty :question.difficulty/hard] [\"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\" :question/answer-fields \"a972b44c-4443-5a49-ba25-77dd606919f5\"] [17592186064218 :knowledge-point/questions \"2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5\"] [\"72b275dd-3871-5105-88f5-755d10a926ee\" :answer/id #uuid \"72b275dd-3871-5105-88f5-755d10a926ee\"] [\"72b275dd-3871-5105-88f5-755d10a926ee\" :answer/type :answer.type/math] [\"72b275dd-3871-5105-88f5-755d10a926ee\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C\"] [\"b32a694d-98fc-518d-8d6c-aaa87c826cd0\" :answer/id #uuid \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\"] [\"b32a694d-98fc-518d-8d6c-aaa87c826cd0\" :answer/type :answer.type/math] [\"b32a694d-98fc-518d-8d6c-aaa87c826cd0\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}+C\"] [\"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\" :answer/id #uuid \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\"] [\"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\" :answer/type :answer.type/math] [\"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\" :answer/id #uuid \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\"] [\"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\" :answer/type :answer.type/math] [\"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\" :answer/value \"-1\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"3b274588-c364-5780-82aa-be8327332f41\" :answer/id #uuid \"3b274588-c364-5780-82aa-be8327332f41\"] [\"3b274588-c364-5780-82aa-be8327332f41\" :answer/type :answer.type/math] [\"3b274588-c364-5780-82aa-be8327332f41\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/id #uuid \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/key \"answer\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/type :answer-field.type/radio] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"72b275dd-3871-5105-88f5-755d10a926ee\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"b32a694d-98fc-518d-8d6c-aaa87c826cd0\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"b32c75cc-0ac2-5c4b-979b-3d06f393a8cd\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"fa98060f-fb27-5f4d-9d7a-59b8066ccd78\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/choices \"3b274588-c364-5780-82aa-be8327332f41\"] [\"a05b84b7-cde5-5dcd-8b23-dd8470aad214\" :answer-field/correct \"72b275dd-3871-5105-88f5-755d10a926ee\"] [\"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/id #uuid \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\"] [\"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot \\\\frac{3}{4}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C.\\n$$\"] [\"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/difficulty :question.difficulty/hard] [\"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\" :question/answer-fields \"a05b84b7-cde5-5dcd-8b23-dd8470aad214\"] [17592186064218 :knowledge-point/questions \"94849f5f-2cf8-5cf1-8a7d-c7ccc0fffc35\"] [\"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\" :answer/id #uuid \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\"] [\"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\" :answer/type :answer.type/math] [\"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\" :answer/id #uuid \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\"] [\"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\" :answer/type :answer.type/math] [\"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"16d15460-c344-58be-bd6c-ff5c5aa66b99\" :answer/id #uuid \"16d15460-c344-58be-bd6c-ff5c5aa66b99\"] [\"16d15460-c344-58be-bd6c-ff5c5aa66b99\" :answer/type :answer.type/math] [\"16d15460-c344-58be-bd6c-ff5c5aa66b99\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\" :answer/id #uuid \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\"] [\"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\" :answer/type :answer.type/math] [\"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [\"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\" :answer/id #uuid \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\"] [\"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\" :answer/type :answer.type/math] [\"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/id #uuid \"815fa613-54ca-5424-b2a4-b9796145743c\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/key \"answer\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/type :answer-field.type/radio] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"5ff0da6f-b0b1-587a-ad37-ddaf219910f1\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"16d15460-c344-58be-bd6c-ff5c5aa66b99\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"1e1faca6-79c7-5000-b9b6-3ac601b2f9bc\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/choices \"4cc57df7-0fcb-50a2-8631-72fc23faf0e1\"] [\"815fa613-54ca-5424-b2a4-b9796145743c\" :answer-field/correct \"552c69bc-c59f-5d0a-bc7b-d9da24a5d29e\"] [\"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/id #uuid \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\"] [\"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 9 x^{2}}=2\\\\sqrt{1-(\\\\frac{3 x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [\"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/difficulty :question.difficulty/hard] [\"df9de8b9-2f01-568f-aeb5-4514cd0a2608\" :question/answer-fields \"815fa613-54ca-5424-b2a4-b9796145743c\"] [17592186064218 :knowledge-point/questions \"df9de8b9-2f01-568f-aeb5-4514cd0a2608\"] [\"ce1ef3f3-0241-5334-9309-241a050c9cc4\" :answer/id #uuid \"ce1ef3f3-0241-5334-9309-241a050c9cc4\"] [\"ce1ef3f3-0241-5334-9309-241a050c9cc4\" :answer/type :answer.type/math] [\"ce1ef3f3-0241-5334-9309-241a050c9cc4\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}+C\"] [\"2905b413-bec8-5457-a9ab-da7f8c1307bf\" :answer/id #uuid \"2905b413-bec8-5457-a9ab-da7f8c1307bf\"] [\"2905b413-bec8-5457-a9ab-da7f8c1307bf\" :answer/type :answer.type/math] [\"2905b413-bec8-5457-a9ab-da7f8c1307bf\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [\"8462dca9-837c-583e-ab33-49c85dc0a377\" :answer/id #uuid \"8462dca9-837c-583e-ab33-49c85dc0a377\"] [\"8462dca9-837c-583e-ab33-49c85dc0a377\" :answer/type :answer.type/math] [\"8462dca9-837c-583e-ab33-49c85dc0a377\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}+C\"] [\"fea94ca2-e2b2-5752-8974-5635eb448c92\" :answer/id #uuid \"fea94ca2-e2b2-5752-8974-5635eb448c92\"] [\"fea94ca2-e2b2-5752-8974-5635eb448c92\" :answer/type :answer.type/math] [\"fea94ca2-e2b2-5752-8974-5635eb448c92\" :answer/value \"\\\\arcsin{\\\\left(x \\\\right)}+C\"] [\"45d77756-bddb-512e-9a28-12964b46ae37\" :answer/id #uuid \"45d77756-bddb-512e-9a28-12964b46ae37\"] [\"45d77756-bddb-512e-9a28-12964b46ae37\" :answer/type :answer.type/math] [\"45d77756-bddb-512e-9a28-12964b46ae37\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/id #uuid \"379132fc-afd1-53f3-a173-3ecc9499f99f\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/key \"answer\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/type :answer-field.type/radio] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"ce1ef3f3-0241-5334-9309-241a050c9cc4\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"2905b413-bec8-5457-a9ab-da7f8c1307bf\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"8462dca9-837c-583e-ab33-49c85dc0a377\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"fea94ca2-e2b2-5752-8974-5635eb448c92\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/choices \"45d77756-bddb-512e-9a28-12964b46ae37\"] [\"379132fc-afd1-53f3-a173-3ecc9499f99f\" :answer-field/correct \"2905b413-bec8-5457-a9ab-da7f8c1307bf\"] [\"1e4637a3-72fb-557e-85fd-0def49912217\" :question/id #uuid \"1e4637a3-72fb-557e-85fd-0def49912217\"] [\"1e4637a3-72fb-557e-85fd-0def49912217\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"1e4637a3-72fb-557e-85fd-0def49912217\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 16 x^{2}}=5\\\\sqrt{1-(\\\\frac{4 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{5}\\\\cdot \\\\frac{5}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [\"1e4637a3-72fb-557e-85fd-0def49912217\" :question/difficulty :question.difficulty/hard] [\"1e4637a3-72fb-557e-85fd-0def49912217\" :question/answer-fields \"379132fc-afd1-53f3-a173-3ecc9499f99f\"] [17592186064218 :knowledge-point/questions \"1e4637a3-72fb-557e-85fd-0def49912217\"] [\"153207b8-967f-5f59-bd12-ae5e22b97cd9\" :answer/id #uuid \"153207b8-967f-5f59-bd12-ae5e22b97cd9\"] [\"153207b8-967f-5f59-bd12-ae5e22b97cd9\" :answer/type :answer.type/math] [\"153207b8-967f-5f59-bd12-ae5e22b97cd9\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"ef592788-f5b1-52cd-b140-a0d340f1dea4\" :answer/id #uuid \"ef592788-f5b1-52cd-b140-a0d340f1dea4\"] [\"ef592788-f5b1-52cd-b140-a0d340f1dea4\" :answer/type :answer.type/math] [\"ef592788-f5b1-52cd-b140-a0d340f1dea4\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [\"97886b89-c7e2-528a-abad-310da5f5c168\" :answer/id #uuid \"97886b89-c7e2-528a-abad-310da5f5c168\"] [\"97886b89-c7e2-528a-abad-310da5f5c168\" :answer/type :answer.type/math] [\"97886b89-c7e2-528a-abad-310da5f5c168\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"0b45d82d-d26e-5c68-a136-f5686a3380de\" :answer/id #uuid \"0b45d82d-d26e-5c68-a136-f5686a3380de\"] [\"0b45d82d-d26e-5c68-a136-f5686a3380de\" :answer/type :answer.type/math] [\"0b45d82d-d26e-5c68-a136-f5686a3380de\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"1268b773-686b-5e87-a8e0-5956661826c7\" :answer/id #uuid \"1268b773-686b-5e87-a8e0-5956661826c7\"] [\"1268b773-686b-5e87-a8e0-5956661826c7\" :answer/type :answer.type/math] [\"1268b773-686b-5e87-a8e0-5956661826c7\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/id #uuid \"4669df1f-6248-51d1-a8f9-79221324ef5a\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/key \"answer\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/type :answer-field.type/radio] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"153207b8-967f-5f59-bd12-ae5e22b97cd9\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"ef592788-f5b1-52cd-b140-a0d340f1dea4\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"97886b89-c7e2-528a-abad-310da5f5c168\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"0b45d82d-d26e-5c68-a136-f5686a3380de\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/choices \"1268b773-686b-5e87-a8e0-5956661826c7\"] [\"4669df1f-6248-51d1-a8f9-79221324ef5a\" :answer-field/correct \"153207b8-967f-5f59-bd12-ae5e22b97cd9\"] [\"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/id #uuid \"012c056c-c0aa-58f3-aac2-230db4d8f0af\"] [\"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/difficulty :question.difficulty/hard] [\"012c056c-c0aa-58f3-aac2-230db4d8f0af\" :question/answer-fields \"4669df1f-6248-51d1-a8f9-79221324ef5a\"] [17592186064218 :knowledge-point/questions \"012c056c-c0aa-58f3-aac2-230db4d8f0af\"] [\"40a499b3-4946-5824-9e23-c62411759546\" :answer/id #uuid \"40a499b3-4946-5824-9e23-c62411759546\"] [\"40a499b3-4946-5824-9e23-c62411759546\" :answer/type :answer.type/math] [\"40a499b3-4946-5824-9e23-c62411759546\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\" :answer/id #uuid \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\"] [\"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\" :answer/type :answer.type/math] [\"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"37443c11-d637-5757-ac8e-24ae357fcae1\" :answer/id #uuid \"37443c11-d637-5757-ac8e-24ae357fcae1\"] [\"37443c11-d637-5757-ac8e-24ae357fcae1\" :answer/type :answer.type/math] [\"37443c11-d637-5757-ac8e-24ae357fcae1\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"653e40a6-e01b-596d-933b-71404bcfb65c\" :answer/id #uuid \"653e40a6-e01b-596d-933b-71404bcfb65c\"] [\"653e40a6-e01b-596d-933b-71404bcfb65c\" :answer/type :answer.type/math] [\"653e40a6-e01b-596d-933b-71404bcfb65c\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"6672914f-bf49-5394-b4b7-0024279d68b4\" :answer/id #uuid \"6672914f-bf49-5394-b4b7-0024279d68b4\"] [\"6672914f-bf49-5394-b4b7-0024279d68b4\" :answer/type :answer.type/math] [\"6672914f-bf49-5394-b4b7-0024279d68b4\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/id #uuid \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/key \"answer\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/type :answer-field.type/radio] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"40a499b3-4946-5824-9e23-c62411759546\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"069833a3-d3b4-5a2c-8c1d-5e4831d5dd92\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"37443c11-d637-5757-ac8e-24ae357fcae1\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"653e40a6-e01b-596d-933b-71404bcfb65c\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/choices \"6672914f-bf49-5394-b4b7-0024279d68b4\"] [\"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\" :answer-field/correct \"6672914f-bf49-5394-b4b7-0024279d68b4\"] [\"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/id #uuid \"ac7ccb86-e562-5c18-93ff-df4783c50a60\"] [\"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [\"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/difficulty :question.difficulty/hard] [\"ac7ccb86-e562-5c18-93ff-df4783c50a60\" :question/answer-fields \"78a2c40b-4f5e-5b3d-a066-8a1ca5b2c47a\"] [17592186064218 :knowledge-point/questions \"ac7ccb86-e562-5c18-93ff-df4783c50a60\"] [\"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\" :answer/id #uuid \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\"] [\"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\" :answer/type :answer.type/math] [\"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [\"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\" :answer/id #uuid \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\"] [\"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\" :answer/type :answer.type/math] [\"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"708e6670-ad76-5e90-9673-8ae030ce8b34\" :answer/id #uuid \"708e6670-ad76-5e90-9673-8ae030ce8b34\"] [\"708e6670-ad76-5e90-9673-8ae030ce8b34\" :answer/type :answer.type/math] [\"708e6670-ad76-5e90-9673-8ae030ce8b34\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\" :answer/id #uuid \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\"] [\"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\" :answer/type :answer.type/math] [\"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [\"8fd89241-99ae-5981-9431-3b9928391c7b\" :answer/id #uuid \"8fd89241-99ae-5981-9431-3b9928391c7b\"] [\"8fd89241-99ae-5981-9431-3b9928391c7b\" :answer/type :answer.type/math] [\"8fd89241-99ae-5981-9431-3b9928391c7b\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/id #uuid \"1df600e8-2b95-509c-9eca-984825d6041e\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/key \"answer\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/type :answer-field.type/radio] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"fb8f1faa-f18a-5aa1-b0b0-c697df5e8afa\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"062ae717-b9a3-5334-9e9f-4ff3f9a033b6\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"708e6670-ad76-5e90-9673-8ae030ce8b34\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/choices \"8fd89241-99ae-5981-9431-3b9928391c7b\"] [\"1df600e8-2b95-509c-9eca-984825d6041e\" :answer-field/correct \"eca26aea-f8bf-50ad-ab59-cbc696e8cce6\"] [\"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/id #uuid \"7ae327cb-d047-56a3-9c96-709a008c4721\"] [\"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 4 x^{2}}=3\\\\sqrt{1-(\\\\frac{2 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{3}{2}=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [\"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/difficulty :question.difficulty/hard] [\"7ae327cb-d047-56a3-9c96-709a008c4721\" :question/answer-fields \"1df600e8-2b95-509c-9eca-984825d6041e\"] [17592186064218 :knowledge-point/questions \"7ae327cb-d047-56a3-9c96-709a008c4721\"] [\"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\" :answer/id #uuid \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\"] [\"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\" :answer/type :answer.type/math] [\"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"a55a9174-841e-598a-b517-1d80d865122a\" :answer/id #uuid \"a55a9174-841e-598a-b517-1d80d865122a\"] [\"a55a9174-841e-598a-b517-1d80d865122a\" :answer/type :answer.type/math] [\"a55a9174-841e-598a-b517-1d80d865122a\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"0371a3bb-446f-5960-8416-af922ddc43a7\" :answer/id #uuid \"0371a3bb-446f-5960-8416-af922ddc43a7\"] [\"0371a3bb-446f-5960-8416-af922ddc43a7\" :answer/type :answer.type/math] [\"0371a3bb-446f-5960-8416-af922ddc43a7\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [\"3d82ac58-ab3c-55ca-9839-8dec23d6c444\" :answer/id #uuid \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\"] [\"3d82ac58-ab3c-55ca-9839-8dec23d6c444\" :answer/type :answer.type/math] [\"3d82ac58-ab3c-55ca-9839-8dec23d6c444\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [\"843860d6-41f1-5f30-843b-e8b02e08b437\" :answer/id #uuid \"843860d6-41f1-5f30-843b-e8b02e08b437\"] [\"843860d6-41f1-5f30-843b-e8b02e08b437\" :answer/type :answer.type/math] [\"843860d6-41f1-5f30-843b-e8b02e08b437\" :answer/value \"\\\\frac{3}{8}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/id #uuid \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/key \"answer\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/type :answer-field.type/radio] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"a55a9174-841e-598a-b517-1d80d865122a\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"0371a3bb-446f-5960-8416-af922ddc43a7\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/choices \"843860d6-41f1-5f30-843b-e8b02e08b437\"] [\"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\" :answer-field/correct \"3d82ac58-ab3c-55ca-9839-8dec23d6c444\"] [\"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/id #uuid \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\"] [\"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [\"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/difficulty :question.difficulty/hard] [\"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\" :question/answer-fields \"a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c\"] [17592186064218 :knowledge-point/questions \"ee8bae68-8b87-5bfa-a2e9-30c73d312ff6\"] [\"generator\" :question-generator/id #uuid \"375f0522-9a06-5cd7-92e2-a3c425b1a5ad\"] [\"generator\" :question-generator/script \"generators/17/17f7f31f26b9110e439de9d747417d47f6c4466c77668cb94d9d01a09bc3370d/generator.py\"] [17592186064218 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186064218 :knowledge-point/question-generator 17592186678766]]}",
