] [:db/add \"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/correct \"71210dbb-cc49-5cee-9a0f-a866a03d74ff\"] [:db/ensure \"51b2a8d2-e243-5f8c-acba-9d233cc30221\" :answer-field/validate] [:db/add \"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/id #uuid \"75404dba-6602-5d66-b29a-e1014ce296c1\"] [:db/add \"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/difficulty :question.difficulty/easy] [:db/add \"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/answer-fields \"51b2a8d2-e243-5f8c-acba-9d233cc30221\"] [:db/ensure \"75404dba-6602-5d66-b29a-e1014ce296c1\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"75404dba-6602-5d66-b29a-e1014ce296c1\"] [:db/add \"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\" :answer/id #uuid \"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\"] [:db/add \"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\" :answer/type :answer.type/math] [:db/add \"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\" :answer/value \"\\\\frac{2}{9}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b\" :answer/validate] [:db/add \"d1c2af6f-f794-5053-8144-609619370623\" :answer/id #uuid \"d1c2af6f-f794-5053-8144-609619370623\"] [:db/add \"d1c2af6f-f794-5053-8144-609619370623\" :answer/type :answer.type/math] [:db/add \"d1c2af6f-f794-5053-8144-609619370623\" :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"d1c2af6f-f794-5053-8144-609619370623\" :answer/validate] [:db/add \"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\" :answer/id #uuid \"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\"] [:db/add \"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\" :answer/type :answer.type/math] [:db/add \"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"87cd4edc-62af-52dc-a632-9c5a1fd05ebc\" :answer/validate] [:db/add \"14243db0-bbde-59f7-b8ea-d934eacde8d1\" :answer/id #uuid \"14243db0-bbde-59f7-b8ea-d934eacde8d1\"] [:db/add \"14243db0-bbde-59f7-b8ea-d934eacde8d1\" :answer/type :answer.type/math] [:db/add \"14243db0-bbde-59f7-b8ea-d934eacde8d1\" :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"14243db0-bbde-59f7-b8ea-d934eacde8d1\" :answer/validate] [:db/add \"b493e0e7-639c-5927-b58f-d6155fce743e\" :answer/id #uuid \"b493e0e7-639c-5927-b58f-d6155fce743e\"] [:db/add \"b493e0e7-639c-5927-b58f-d6155fce743e\" :answer/type :answer.type/math] [:db/add \"b493e0e7-639c-5927-b58f-d6155fce743e\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b493e0e7-639c-5927-b58f-d6155fce743e\" :answer/validate] [:db/add \"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/id #uuid \"ba26dad2-a01c-562d-b7f3-35dc1ea80540\"] [:db/add \"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/key \"answer\"] [:db/add \"ba26dad2-a01c-562d-b7f3-35dc1ea80540\" :answer-field/type :answer-field.type/radio] [:db/add \"ba26dad2-a01c-5