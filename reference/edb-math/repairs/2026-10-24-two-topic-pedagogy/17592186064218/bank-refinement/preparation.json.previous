54ce05213b\" :answer-field/choices \"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\"] [:db/add \"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/choices \"ca6a1d5b-1c71-5d9a-8798-689d17515cac\"] [:db/add \"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/choices \"6f7199a1-2a8e-57a3-8c55-ddecd0ddc83e\"] [:db/add \"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/correct \"75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2\"] [:db/ensure \"115ff9eb-588c-5227-9552-be54ce05213b\" :answer-field/validate] [:db/add \"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/id #uuid \"ebbf711d-d552-58b8-b833-8a18f08425bc\"] [:db/add \"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - x^{2}}=5\\\\sqrt{1-(\\\\frac{x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{5}\\\\cdot 5=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/difficulty :question.difficulty/moderate] [:db/add \"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/answer-fields \"115ff9eb-588c-5227-9552-be54ce05213b\"] [:db/ensure \"ebbf711d-d552-58b8-b833-8a18f08425bc\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"ebbf711d-d552-58b8-b833-8a18f08425bc\"] [:db/add \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\" :answer/id #uuid \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\"] [:db/add \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\" :answer/type :answer.type/math] [:db/add \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\" :answer/validate] [:db/add \"542f7914-9bd1-5687-a1e3-0629bce86c3e\" :answer/id #uuid \"542f7914-9bd1-5687-a1e3-0629bce86c3e\"] [:db/add \"542f7914-9bd1-5687-a1e3-0629bce86c3e\" :answer/type :answer.type/math] [:db/add \"542f7914-9bd1-5687-a1e3-0629bce86c3e\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"542f7914-9bd1-5687-a1e3-0629bce86c3e\" :answer/validate] [:db/add \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\" :answer/id #uuid \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\"] [:db/add \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\" :answer/type :answer.type/math] [:db/add \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\" :answer/validate] [:db/add \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\" :answer/id #uuid \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\"] [:db/add \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\" :answer/type :answer.type/math] [:db/add \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\" :answer/validate] [:db/add \"19ea5306-8522-567e-a46a-9edda662e462\" :answer/id #uuid \"19ea5306-8522-567e-a46a-9edda662e462\"] [:db/add \"19ea5306-8522-567e-a46a-9edda662e462\" :answer/type :answer.type/math] [:db/add \"19ea5306-8522-567e-a46a-9edda662e462\" :answer/value \"-4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"19ea5306-8522-567e-a46a-9edda662e462\" :answer/validate] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/id #uuid \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\"] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/key \"answer\"] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/type :answer-field.type/radio] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\"] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"542f7914-9bd1-5687-a1e3-0629bce86c3e\"] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"0d3aa40d-f526-5deb-bdfd-e912a5b98c5c\"] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"b80a0f06-252c-51c6-815c-a6a39f81bbaa\"] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/choices \"19ea5306-8522-567e-a46a-9edda662e462\"] [:db/add \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/correct \"b2e7655b-d010-5e67-a3b2-543340e5e1e2\"] [:db/ensure \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\" :answer-field/validate] [:db/add \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/id #uuid \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\"] [:db/add \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 4=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/difficulty :question.difficulty/moderate] [:db/add \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/answer-fields \"f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78\"] [:db/ensure \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"3bcbd307-7eb0-5749-9f39-f59ad0eeb13c\"] [:db/add \"c47c661f-037f-51b9-8d03-0be231871dcb\" :answer/id #uuid \"c47c661f-037f-51b9-8d03-0be231871dcb\"] [:db/add \"c47c661f-037f-51b9-8d03-0be231871dcb\" :answer/type :answer.type/math] [:db/add \"c47c661f-037f-51b9-8d03-0be231871dcb\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"c47c661f-037f-51b9-8d03-0be231871dcb\" :answer/validate] [:db/add \"52347b5d-701b-508d-9f0d-6db99534fc48\" :answer/id #uuid \"52347b5d-701b-508d-9f0d-6db99534fc48\"] [:db/add \"52347b5d-701b-508d-9f0d-6db99534fc48\" :answer/type :answer.type/math] [:db/add \"52347b5d-701b-508d-9f0d-6db99534fc48\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"52347b5d-701b-508d-9f0d-6db99534fc48\" :answer/validate] [:db/add \"49f61ff3-2254-54da-b1eb-a491bf3dfdd5\" :answer/id #uuid \"49f61ff3-2254-54da-b