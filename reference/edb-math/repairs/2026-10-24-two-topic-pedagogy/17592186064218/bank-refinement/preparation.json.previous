  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"0ec71766-d192-5c90-89d7-91ae321ef30c\" :answer/id #uuid \"0ec71766-d192-5c90-89d7-91ae321ef30c\"] [:db/add \"0ec71766-d192-5c90-89d7-91ae321ef30c\" :answer/type :answer.type/math] [:db/add \"0ec71766-d192-5c90-89d7-91ae321ef30c\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0ec71766-d192-5c90-89d7-91ae321ef30c\" :answer/validate] [:db/add \"44b1e915-0981-58de-b94b-d283d648df63\" :answer/id #uuid \"44b1e915-0981-58de-b94b-d283d648df63\"] [:db/add \"44b1e915-0981-58de-b94b-d283d648df63\" :answer/type :answer.type/math] [:db/add \"44b1e915-0981-58de-b94b-d283d648df63\" :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"44b1e915-0981-58de-b94b-d283d648df63\" :answer/validate] [:db/add \"b2851085-df3e-5ca2-9696-6da8ff2428a4\" :answer/id #uuid \"b2851085-df3e-5ca2-9696-6da8ff2428a4\"] [:db/add \"b2851085-df3e-5ca2-9696-6da8ff2428a4\" :answer/type :answer.type/math] [:db/add \"b2851085-df3e-5ca2-9696-6da8ff2428a4\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"b2851085-df3e-5ca2-9696-6da8ff2428a4\" :answer/validate] [:db/add \"773b64a7-9996-54f1-8193-ef2088314066\" :answer/id #uuid \"773b64a7-9996-54f1-8193-ef2088314066\"] [:db/add \"773b64a7-9996-54f1-8193-ef2088314066\" :answer/type :answer.type/math] [:db/add \"773b64a7-9996-54f1-8193-ef2088314066\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"773b64a7-9996-54f1-8193-ef2088314066\" :answer/validate] [:db/add \"ef595ad1-8974-5bbb-ab2c-666f90782c31\" :answer/id #uuid \"ef595ad1-8974-5bbb-ab2c-666f90782c31\"] [:db/add \"ef595ad1-8974-5bbb-ab2c-666f90782c31\" :answer/type :answer.type/math] [:db/add \"ef595ad1-8974-5bbb-ab2c-666f90782c31\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"ef595ad1-8974-5bbb-ab2c-666f90782c31\" :answer/validate] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/id #uuid \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\"] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/key \"answer\"] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/type :answer-field.type/radio] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"0ec71766-d192-5c90-89d7-91ae321ef30c\"] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"44b1e915-0981-58de-b94b-d283d648df63\"] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"b2851085-df3e-5ca2-9696-6da8ff2428a4\"] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"773b64a7-9996-54f1-8193-ef2088314066\"] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/choices \"ef595ad1-8974-5bbb-ab2c-666f90782c31\"] [:db/add \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/correct \"b2851085-df3e-5ca2-9696-6da8ff2428a4\"] [:db/ensure \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\" :answer-field/validate] [:db/add \"cc411b53-59e8-5c6e-aca6-364024091383\" :question/id #uuid \"cc411b53-59e8-5c6e-aca6-364024091383\"] [:db/add \"cc411b53-59e8-5c6e-aca6-364024091383\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"cc411b53-59e8-5c6e-aca6-364024091383\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{1 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"cc411b53-59e8-5c6e-aca6-364024091383\" :question/difficulty :question.difficulty/easy] [:db/add \"cc411b53-59e8-5c6e-aca6-364024091383\" :question/answer-fields \"2e80ba22-bb42-55e2-8a66-bf30eeae5992\"] [:db/ensure \"cc411b53-59e8-5c6e-aca6-364024091383\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"cc411b53-59e8-5c6e-aca6-364024091383\"] [:db/add \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\" :answer/id #uuid \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\"] [:db/add \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\" :answer/type :answer.type/math] [:db/add \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\" :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\" :answer/validate] [:db/add \"1edf25e3-43c9-5d64-8b73-446718306503\" :answer/id #uuid \"1edf25e3-43c9-5d64-8b73-446718306503\"] [:db/add \"1edf25e3-43c9-5d64-8b73-446718306503\" :answer/type :answer.type/math] [:db/add \"1edf25e3-43c9-5d64-8b73-446718306503\" :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\"] [:db/ensure \"1edf25e3-43c9-5d64-8b73-446718306503\" :answer/validate] [:db/add \"23cc7e21-2293-5e9a-aecf-3b72005c8270\" :answer/id #uuid \"23cc7e21-2293-5e9a-aecf-3b72005c8270\"] [:db/add \"23cc7e21-2293-5e9a-aecf-3b72005c8270\" :answer/type :answer.type/math] [:db/add \"23cc7e21-2293-5e9a-aecf-3b72005c8270\" :answer/value \"-6\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"23cc7e21-2293-5e9a-aecf-3b72005c8270\" :answer/validate] [:db/add \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\" :answer/id #uuid \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\"] [:db/add \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\" :answer/type :answer.type/math] [:db/add \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\" :answer/value \"8\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\" :answer/validate] [:db/add \"c40a28b9-4fd9-5866-baea-cca8477c94a1\" :answer/id #uuid \"c40a28b9-4fd9-5866-baea-cca8477c94a1\"] [:db/add \"c40a28b9-4fd9-5866-baea-cca8477c94a1\" :answer/type :answer.type/math] [:db/add \"c40a28b9-4fd9-5866-baea-cca8477c94a1\" :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"c40a28b9-4fd9-5866-baea-cca8477c94a1\" :answer/validate] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/id #uuid \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\"] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/key \"answer\"] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/type :answer-field.type/radio] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\"] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"1edf25e3-43c9-5d64-8b73-446718306503\"] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"23cc7e21-2293-5e9a-aecf-3b72005c8270\"] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"fd2c6f9f-fc09-5d3c-ab51-fabb04ec91dd\"] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/choices \"c40a28b9-4fd9-5866-baea-cca8477c94a1\"] [:db/add \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/correct \"f6366d5e-ecb7-5c60-8d27-7983a72a9d19\"] [:db/ensure \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\" :answer-field/validate] [:db/add \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/id #uuid \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\"] [:db/add \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{1 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/difficulty :question.difficulty/easy] [:db/add \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/answer-fields \"bcafc017-1f62-5580-a0be-ab1037c4c9bb\"] [:db/ensure \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"45e3d0db-47e5-58aa-8ba9-c6cc749121ce\"] [:db/add \"af49752a-b950-5d80-85f5-ade0cffc0d52\" :answer/id #uuid \"af49752a-b950-5d80-85f5-ade0cffc0d52\"] [:db/add \"af49752a-b950-5d80-85f5-ade0cffc0d52\" :answer/type :answer.type/math] [:db/add \"af49752a-b950-5d80-85f5-ade0cffc0d52\" :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"af49752a-b950-5d80-85f5-ade0cffc0d52\" :answer/validate] [:db/add \"0cf57161-9db0-582f-ad42-9fa5a01cebc7\" :answer/id #uuid \"0cf57161-9db0-582f-ad42-9fa5a01cebc7\"] [:db/add \"0cf57161-9db0-582f-ad42-9fa5a01cebc7\" :answer/type :answer.type/math] [:db/add \"0cf57161-9db0-582f-ad42-9fa5a01cebc7\" :answer/value \"\\\\frac{8}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"0cf57161-9db0-582f-ad42-9fa5a01cebc7\" :answer/validate] [:db/add \"3edcf90c-38ed-5987-938d-24b31c372b40\" :answer/id #uuid \"3edcf90c-38ed-5987-938d-24b31c372b40\"] [:db/add \"3edcf90c-3