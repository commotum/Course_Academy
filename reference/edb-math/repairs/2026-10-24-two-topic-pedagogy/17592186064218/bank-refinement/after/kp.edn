}{4}\\left(\\arcsin{\\left(\\frac{4 x}{3} \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14243db0-bbde-59f7-b8ea-d934eacde8d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679738} {:answer/id #uuid "87cd4edc-62af-52dc-a632-9c5a1fd05ebc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679818} {:answer/id #uuid "a51a16dc-c9b7-5fcb-a5a0-98573ba8c15b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679829} {:answer/id #uuid "b493e0e7-639c-5927-b58f-d6155fce743e" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679845} {:answer/id #uuid "d1c2af6f-f794-5053-8144-609619370623" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679861}] :answer-field/correct {:answer/id #uuid "87cd4edc-62af-52dc-a632-9c5a1fd05ebc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679818} :answer-field/id #uuid "ba26dad2-a01c-562d-b7f3-35dc1ea80540" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679848}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1b98e7c2-8e9a-5655-8f51-36ea3c237e0a" :question/problem "Use the substitution $u=3 x$. Which integral is obtained?\n\n$$\n\\int \\frac{2}{\\sqrt{1 - 9 x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=3 x$. Then $\\mat