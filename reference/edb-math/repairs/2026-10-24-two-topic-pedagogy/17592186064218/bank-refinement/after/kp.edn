swer/id #uuid "2b389124-a26d-50e1-aa90-68db0abe6c2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}}{5}+C" :db/id #edb/ref 17592186676560} {:answer/id #uuid "6ce3c644-d7bd-5af0-90aa-621960980866" :answer/type {:db/ident :answer.type/math} :answer/value "8 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}+C" :db/id #edb/ref 17592186676603} {:answer/id #uuid "7a84aeb3-7c9d-5ea6-b305-0a4fa5dacfc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(x \\right)}}{5}+C" :db/id #edb/ref 17592186676608} {:answer/id #uuid "f1395054-873c-52c8-b347-999eeb014cf8" :answer/type {:db/ident :answer.type/math} :answer/value "8 \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}+C" :db/id #edb/ref 17592186676694} {:answer/id #uuid "f638c343-9c97-5913-bd31-5df078a1a1f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{5}+C" :db/id #edb/ref 17592186676696}] :answer-field/correct {:answer/id #uuid "f638c343-9c97-5913-bd31-5df078a1a1f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{5}+C" :db/id #edb/ref 17592186676696} :answer-field/id #uuid "00843716-9c25-5650-80f8-f7535717f15c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676535}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "44485569-fdd3-513f-8b31-23d9e8828d65" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{8}{\\sqrt{1 - 10 x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=\\sqrt{10} x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\sqrt{10},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{10}}{10})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{8}{\\sqrt{1 - 10 x^{2}}}\\,\\mathrm{d}x \\\\  &= 8\\int \\frac{1}{\\sqrt{1-(\\sqrt{10} x)^{2}}}\\,\\mathrm{d}x \\\\  &= 8(\\frac{\\sqrt{10}}{10})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(u \\right)}}{5}+C \\\\  &= \\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{5}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e58ef9-3e15-5d2e-a6a3-fc4b106cd550" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(8 x \\right)}}{64}+C" :db/id #edb/ref 17592186676549} {:answer/id #uuid "9f229753-a714-5933-9efc-b61a0f057af9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676632} {:answer/id #uuid "da8b5673-be99-5c3b-962e-baea82cff5d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}{\\left(x \\right)}}{64}+C" :db/id #edb/ref 17592186676675} {:answer/id #uuid "f017ada9-04c2-5a27-b963-04bb93956b3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676693} {:answer/id #uuid "fc9059d4-d6d5-5eba-9226-94220db01c44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}{\\left(8 x \\right)}}{64}+C" :db/id #edb/ref 17592186676701}] :answer-field/correct {:answer/id #uuid "fc9059d4-d6d5-5eba-9226-94220db01c44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}{\\left(8 x \\right)}}{64}+C" :db/id #edb/ref 17592186676701} :answer-fiel