\sqrt{1-(6x)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{36}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{36}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{36}\\operatorname{arcsin}⁡(6x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cd4706-704b-5191-9295-cd464731fc6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcsin}⁡(x)+C" :db/id #edb/ref 17592186247445} {:answer/id #uuid "3a38ccf5-fcac-5430-8dfa-c7d60a37aa2f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186247939} {:answer/id #uuid "4c9e9d8f-89aa-55a3-97cf-08796f3a38a7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186248109} {:answer/id #uuid "8f55739b-0baf-52ac-867b-fcfbf2995448" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248699} {:answer/id #uuid "bff3e8f2-1813-5dfd-b250-2a81a2e1016b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249130}] :answer-field/correct {:answer/id #uuid "bff3e8f2-1813-5dfd-b250-2a81a2e1016b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249130} :answer-field/id #uuid "66b8014f-e254-5931-890e-409b4231ae26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249851}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f4bd8aa-6ac8-5557-b597-a73e9dcdaedc" :question/math-academy-id "q-114024" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{4}{\\sqrt{1-2{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $2{x}^{2}=(\\sqrt{2}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{\\sqrt{1-2{x}^{2}}}\\,\\text{d}x & =4\\int \\frac{1}{\\sqrt{1-(\\sqrt{2}x)^{2}}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\frac{4}{\\sqrt{2}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{4\\sqrt{2}}{2}\\operatorname{arcsin}⁡u+C \\\\  & =2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c68f15c-76dd-5da9-8a8c-db134c0b26d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{81}\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 17592186247534} {:answer/id #uuid "2bcc6f85-a1b7-5000-88aa-4cd90bd376e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arcsin}⁡(x)+C" :db/id #edb/ref 17592186247814} {:answer/id #uuid "2d69f939-15a8-562a-9b01-f0a5d555430a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 17592186247827} {:answer/id #uuid "5ba3d36c-1859-5507-bd58-e1969bafd63a" :answer/type {:db/ident :answer.type/math} :answer/value "81\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 17592186248255} {:answer/id #uuid "cc5523a4-ec9b-5826-a4db-f3b2655b50e4" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 1759