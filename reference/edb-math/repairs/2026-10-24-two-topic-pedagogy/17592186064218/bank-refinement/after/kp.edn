actor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{\\sqrt{4 - 9 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{1}{3}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{3}\\left(\\arcsin{\\left(\\frac{3 x}{2} \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f2c3b5-a666-58aa-801f-8f96561d27b1" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\arcsin{\\left(\\frac{x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186679727} {:answer/id #uuid "5b3f02eb-d44e-552b-8e56-5bfcf92c87e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\arcsin{\\left(\\frac{x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186679785} {:answer/id #uuid "7da8c8c1-b742-5ca6-a3f5-5c1edb13d182" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\arcsin{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186679809} {:answer/id #uuid "b67a993a-4802-51da-8691-bb651164582d" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\left(\\arcsin{\\left(\\frac{x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186679846} {:answer/id #uuid "bb3ec334-e96d-5437-8f99-389021fd2c33" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\arcsin{\\left(\\frac{x}{4} \\right)}\\right)+C" :db/id #edb/ref 17592186679849}] :answer-field/correct {:answer/id #uuid "07f2c3b5-a666-58aa-801f-8f96561d27b1" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\arcsin{\\left(\\frac{x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186679727} :answer-field/id #uuid "bc859b12-ce5c-59f6-a573-b923ea5e7fb1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679850}] :question/difficu