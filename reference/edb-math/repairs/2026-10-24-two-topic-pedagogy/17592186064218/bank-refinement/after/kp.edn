ac{x}{9} \\right)}}{4}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c4591a-0088-5834-a563-f44a66bce641" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}+C" :db/id #edb/ref 17592186676558} {:answer/id #uuid "58f72fc4-f805-5a35-acfe-283e69f73462" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}+C" :db/id #edb/ref 17592186676586} {:answer/id #uuid "7eb0c0f6-fead-577e-adb0-01e2bd9f8186" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\operatorname{arcsin}{\\left(x \\right)}}{10}+C" :db/id #edb/ref 17592186676611} {:answer/id #uuid "88c6b615-b8be-51c5-a731-8dbc27f69f86" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{10}+C" :db/id #edb/ref 17592186676618} {:answer/id #uuid "a54a7a68-3cbc-5153-bdfb-83f4b687d385" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}}{10}+C" :db/id #edb/ref 17592186676634}] :answer-field/correct {:answer/id #uuid "88c6b615-b8be-51c5-a731-8dbc27f69f86" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{10}+C" :db/id #edb/ref 17592186676618} :answer-field/id #uuid "b62a0ac4-4910-5d87-9766-e2bf18b756a7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676649}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eb6f8ce4-1f1e-518a-95af-5865fb0347a5" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{\\sqrt{1 - 10 x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=\\sqrt{10} x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\sqrt{10},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{10}}{10})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{\\sqrt{1 - 10 x^{2}}}\\,\\mathrm{d}x \\\\  &= 1\\int \\frac{1}{\\sqrt{1-(\\sqrt{10} x)^{2}}}\\,\\mathrm{d}x \\\\  &= 1(\\frac{\\sqrt{10}}{10})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{10}}{10}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{10} \\operatorname{arcsin}{\\left(u \\right)}}{10}+C \\\\  &= \\frac{\\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{10}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bf6872b-7da0-5aa8-a2a3-6dfbb139754a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}}{7}+C" :db/id #edb/ref 17592186676546} {:answer/id #uuid "847e59e1-e3be-5d9d-8be7-63f32d39ed17" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sqrt{7} \\operatorname{arcsin}{\\left(\\sqrt{7} x \\right)}+C" :db/id #edb/ref 17592186676615} {:answer/id #uuid "8494d033-7069-5320-8d91-c79268ff4287" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arcsin}{\\left(\\sqrt{7} x \\right)}}{7}+C" :db/id #edb/ref 17592186676616} {:answer/id #uuid "9147250a-c384-5f07-81c6-b0b956f12fc2" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\operatorname{arcsin}{\\left(\\sqrt{7} x \\right)}+C" :db/id #edb/ref 17592186676621} {:answer/id #uuid "f62cd99d-7ab8-5483-9fe6-a98f7846d960" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arcsin}{\\left(x \\right)}}{7}+C" :db/id #edb/ref 17592186676695}] :answer-field/correct {:answer/id #uuid "8494d033-706