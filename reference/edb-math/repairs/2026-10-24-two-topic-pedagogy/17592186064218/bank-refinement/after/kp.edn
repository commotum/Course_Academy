b/ref 17592186679814} {:answer/id #uuid "ca6a1d5b-1c71-5d9a-8798-689d17515cac" :answer/type {:db/ident :answer.type/math} :answer/value "6\\left(\\arcsin{\\left(\\frac{x}{5} \\right)}\\right)+C" :db/id #edb/ref 17592186679857}] :answer-field/correct {:answer/id #uuid "75a2a86a-3aaf-5a4c-94fa-479b7a47a2a2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\arcsin{\\left(\\frac{x}{5} \\right)}\\right)+C" :db/id #edb/ref 17592186679800} :answer-field/id #uuid "115ff9eb-588c-5227-9552-be54ce05213b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679735}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ebbf711d-d552-58b8-b833-8a18f08425bc" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant." :question/worked-solution "Let $u=\\frac{x}{5}$. Then $\\mathrm{d}u=(\\frac{1}{5})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{25 - x^{2}}=5\\sqrt{1-(\\frac{x}{5})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=5\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{5}\\cdot 5=3$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{\\sqrt{25 - x^{2}}}\\,\\mathrm{d}x\\\\&=3\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n3\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=3\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n3\\left(\\arcsin{\\left(\\frac{x}{5} \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0371a3bb-446f-5960-8416-af922ddc43a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\left(\\arcsin{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186679723} {:answer/id #uuid "3d82ac58-ab3c-55ca-9839-8dec23d6c444" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C" :db/id #edb/ref 17592186679763} {:answer/id #uuid "5aa0c725-ad4f-588a-a2bd-85eeb2ce54c8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{4}\\left(\\arcsin{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186679784} {:answer/id #uuid "843860d6-41f1-5f30-843b-e8b02e08b437" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}\\left(\\arcsin{\\left(4 x \\right)}\\right)+C" :db/id #edb/ref 17592186679815} {:answer/id #uuid "a55a9174-841e-598a-b517-1d80d865122a" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{4}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C" :db/id #edb/ref 17592186679831}] :answer-field/correct {:answer/id #uuid "3d82ac58-ab3c-55ca-9839-8dec23d6c444" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C" :db/id #edb/ref 17592186679763} :answer-field/id #uuid "a1b0c1fc-b1e1-52ff-a29a-af9ccb31554c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679827}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ee8bae68-8b87-5bfa-a2e9-30c73d312ff6" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{\\sqrt{4 - 16 x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant." :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{4 - 16 x^{2}}=2\\sqrt{1-(2 x)^2}.\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{2}\\cdot \\frac{1}{2}=\\frac{3}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{\\sqrt{4 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{3}{4}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{4}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55163330-bfe7-5529-9d4c-9debf1865250" :answer/type {:db/ident :answer.type/math} :answer/value "8\\left(\\arcsin{\\left(\\frac{2 x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186679780} {:answer/id #uuid "77100392-83c2-53b8-8787-ea965743c68d" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\arcsin{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186679801} {:answer/id #uuid "857d92c7-90cb-55bf-8622-19f8dadfc3bb" :answer/type {:db/ident :answer.type/math} :answer/value "8\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186679817} {:answer/id #uuid "88f73057-8300-5eed-8fce-c10dbefff77a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\arcsin{\\left(\\frac{2 x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186679820} {:answer/id #uuid "da279c9f-69d6-5715-8bee-e28e55f1c47a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186679865}] :answer-field/correct {:answer/id #uuid "da279c9f-69d6-5715-8bee-e28e55f1c47a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186679865} :answer-field/id #uuid "aec901a7-c5f6-5de8-a811-82f353c28823" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679837}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ef6e80f4-b442-5ef9-b012-ef27f6c6b282" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant." :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=3\\sqrt{1-(\\frac{x}{3})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{3}\\cdot 3=4$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n4\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=4\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39aa20fb-2ef4-5c0f-9571-45aae23494c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{15}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679760} {:answer/id #uuid "4e4e65a2-5bc2-559e-ab33-6abdafab2f86" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679776} {:answer/id #uuid "d23b8153-50af-504f-8179-02440ccb4aa8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679862} {:answer/id #uuid "d89d73e0-d0f9-58fa-924d-e222e09fbcef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679864} {:answer/id #uuid "da56109e-3190-5fbb-9dd6-f680a3b2aec4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{8}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679866}] :answer-field/correct {:answer/id #uuid "d89d73e0-d0f9-58fa-924d-e222e09fbcef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679864} :answer-field/id #uuid "24394dc3-8bd6-5cca-b27f-92d75519c509" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679750}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f083db3d-ffc1-58ac-8ad1-ed80d72bb001" :question/problem "Use the substitution $u=5 x$. Which integral is obtained?\n\n$$\n\\int \\frac{4}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{5}=\\frac{4}{5}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{4}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{4}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\n$$"}] :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Sine"}]}
