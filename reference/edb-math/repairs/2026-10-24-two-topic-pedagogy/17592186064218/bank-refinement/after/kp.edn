{d}u \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{\\operatorname{arcsin}⁡(2x)}{2}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19438f52-8874-56fd-bb9f-7857344ac362" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡(7x)+C" :db/id #edb/ref 17592186330164} {:answer/id #uuid "27da08fc-35f0-56f1-acff-a755484fdd6c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186330305} {:answer/id #uuid "9871b94a-089f-5bbe-8ded-48924d04a46a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{arcsin}⁡\\left(\\frac{x}{7}\\right)}{7}+C" :db/id #edb/ref 17592186331310} {:answer/id #uuid "ab93e473-1608-50b7-b492-43d6a6d77578" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186331471} {:answer/id #uuid "ecbe9328-2d86-5c1a-b284-26c4a4a4a355" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡\\left(\\frac{x}{7}\\right)}{3}+C" :db/id #edb/ref 17592186332026}] :answer-field/correct {:answer/id #uuid "ab93e473-1608-50b7-b492-43d6a6d77578" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186331471} :answer-field/id #uuid "46fef57b-341f-5a8d-b8ea-18d737471bce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332317}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "20c23af2-eaef-5502-8cf2-7e2560ab8597" :question/math-academy-id "q-49547" :question/problem "$$\n\\displaystyle \\int \\frac{3}{\\sqrt{49-{x}^{2}}}\\,\\text{d}x=\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{\\sqrt{49-{x}^{2}}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{49\\cdot (1-{x}^{2}/49)}}\\,\\text{d}x \\\\  & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-{x}^{2}/49}}\\,\\text{d}x \\\\  & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-(x/7)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{7}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{7}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{7}\\,⟹\\,\\text{d}x=7\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{\\sqrt{49-{x}^{2}}}\\,\\text{d}x & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-(x/7)^{2}}}\\,\\text{d}x \\\\  & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (7\\,\\text{d}u) \\\\  & =3\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =3\\operatorname{arcsin}⁡u+C \\\\  & =3\\operatorname{arcsin}⁡\\left(\\frac{x}{7}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b38da3-5f2b-5083-b082-6baa6d33f014" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186247658} {:answer/id #uuid "812bcd0b-19c0-5f1f-bc5e-f010128ff079" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248565} {:answer/id #uuid "990243d0-e530-5c29-873f-06195a661663" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248789} {:answer/id #uuid "9987c0f9-6105-5ebc-a015-774c178a4474" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186248793} {:answe