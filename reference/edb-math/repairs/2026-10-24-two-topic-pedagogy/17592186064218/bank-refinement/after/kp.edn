}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{5} x}{5}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{5}}{5},\\qquad \\mathrm{d}x=(\\sqrt{5})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{\\frac{7}{4}}{\\sqrt{25 - 5 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{20}\\int \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{5} x}{5})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{20}(\\sqrt{5})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{7 \\sqrt{5}}{20}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{7 \\sqrt{5} \\operatorname{arcsin}{\\left(u \\right)}}{20}+C \\\\  &= \\frac{7 \\sqrt{5} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{5} x}{5} \\right)}}{20}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f664ff5-8ad0-5fbb-a886-4102a1c3c4e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{10} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{10} x}{5} \\right)}}{5}+C" :db/id #edb/ref 17592186676582} {:answer/id #uuid "69ae4778-cd6b-5818-b92e-5784218e6a03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arcsin}{\\left(\\frac{\\sqrt{10} x}{5} \\right)}}{5}+C" :db/id #edb/ref 17592186676602} {:answer/id #uuid "7b27ebf9-81c0-5186-b894-864e87744f47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{10} \\operatorname{arctan}{\\left(\\frac{\\sqrt{10} x}{5} \\right)}}{5}+C" :db/id #edb/ref 17592186676609} {:answer/id #uuid "af9ea903-410b-595e-b44f-e4a2c4960f1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{10} x}{5} \\right)}}{25}+C" :db/id #edb/ref 17592186676645} {:answer/id #uuid "ee1773d2-c55c-5fa1-ab0f-590df321fdcd" :answer/type 