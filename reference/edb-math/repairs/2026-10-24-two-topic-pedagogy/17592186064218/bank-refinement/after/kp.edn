\\sqrt{3}x)^{2}}}\\,\\text{d}x \\\\  & =8\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\frac{8}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{8\\sqrt{3}}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{8\\sqrt{3}}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f7287b7-7d12-512f-b0ba-3325188e895f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186247985} {:answer/id #uuid "498d825c-975f-5430-af03-04b1956050fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186248077} {:answer/id #uuid "6a2e0115-c9e2-5f60-b380-4494df13f6d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{25}\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186248371} {:answer/id #uuid "ac03fede-42cb-57af-9f79-80211eeaf7bc" :answer/type {:db/ident :answer.type/math} :answer/value "25\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248958} {:answer/id #uuid "b2e81403-1fcf-56ef-a15e-d472389956d6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186249026}] :answer-field/correct {:answer/id #uuid "b2e81403-1fcf-56ef-a15e-d472389956d6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186249026} :answer-field/id #uuid "f87d1651-2170-52b4-b32a-7d6f3076ecc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250110}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e7c70ecc-510e-5481-bfab-ec3f7c63aab2" :question/math-academy-id "q-114030" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{2}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x & =2\\int \\frac{1}{\\sqrt{25\\cdot (1-{x}^{2}/25)}}\\,\\text{d}x \\\\  & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-{x}^{2}/25}}\\,\\text{d}x \\\\  & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{5}\\right)}^{2}.$ \n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get  \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x \\\\  & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (5\\,\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =2\\operatorname{arcsin}⁡u+C \\\\  & =2\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2488cb64-1bbf-52da-a312-e3caf405d555" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247745} {:answer/id #uuid "38930a0c-015d-5696-ba08-428df9678156" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247929} {:answer/id #uuid "3fe37be6-22eb-55e9-ba87-4d2f7527adbf" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/r