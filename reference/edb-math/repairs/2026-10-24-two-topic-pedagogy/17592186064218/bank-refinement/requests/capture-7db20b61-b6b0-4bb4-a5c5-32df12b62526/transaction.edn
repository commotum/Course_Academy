d1-a8f9-79221324ef5a"] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/key "answer"] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/type :answer-field.type/radio] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/choices "153207b8-967f-5f59-bd12-ae5e22b97cd9"] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/choices "ef592788-f5b1-52cd-b140-a0d340f1dea4"] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/choices "97886b89-c7e2-528a-abad-310da5f5c168"] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/choices "0b45d82d-d26e-5c68-a136-f5686a3380de"] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/choices "1268b773-686b-5e87-a8e0-5956661826c7"] [:db/add "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/correct "153207b8-967f-5f59-bd12-ae5e22b97cd9"] [:db/ensure "4669df1f-6248-51d1-a8f9-79221324ef5a" :answer-field/validate] [:db/add "012c056c-c0aa-58f3-aac2-230db4d8f0af" :question/id #uuid "012c056c-c0aa-58f3-aac2-230db4d8f0af"] [:db/add "012c056c-c0aa-58f3-aac2-230db4d8f0af" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{\\sqrt{9 - 16 x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "012c056c-c0aa-58f3-aac2-230db4d8f0af" :question/worked-solution "Let $u=\\frac{4 x}{3}$. Then $\\mathrm{d}u=(\\frac{4}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{9 - 16 x^{2}}=3\\sqrt{1-(\\frac{4 x}{3})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{3}{4}\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{3}\\cdot \\frac{3}{4}=\\frac{1}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{\\sqrt{9 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\arcsin{\\left(\\frac{4 x}{3} \\right)}\\right)+C.\n$$"] [:db/add "012c056c-c0aa-58f3-aac2-230db4d8f0af" :question/difficulty :question.difficulty/hard] [:db/add "012c056c-c0aa-58f3-aac2-230db4d8f0af" :question/answer-fields "4669df1f-6248-51d1-a8f9-79221324ef5a"] [:db/ensure "012c056c-c0aa-58f3-aac2-230db4d8f0af" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "012c056c-c0aa-58f3-aac2-230db4d8f0af"] [:db/add "40a499b3-4946-5824-9e23-c62411759546" :answer/id #uuid "40a499b3-4946-5824-9e23-c62411759546"] [:db/add "40a499b3-4946-5824-9e23-c62411759546" :answer/type :answer.type/math] [:db/add "40a499b3-4946-5824-9e23-c62411759546" :answer/value "\\frac{1}{2}\\left(\\arcsin{\\left(2 x \\right)}\\right)+C"] [:db/ensure "40a499b3-4946-5824-9e23-c62411759546" :answer/validate] [:db/add "069833a3-d3b4-5a2c-8c1d-5e4831d5dd92" :answer/id #uuid "069833a3-d3b4-5a2c-8c1d-5e4831d5dd92"] [:db/add "069833a3-d3b4-5a2c-8c1d-5e4831d5dd92" :answer/type :answer.type/math] [:db/add "069833a3-d3b4-5a2c-8c1d-5e4831d5dd92" :answer/value "\\frac{1}{2}\\left(\\arcsin{\\left(x \\right)}\\right)+C"] [:db/ensure "069833a3-d3b4-5a2c-8c1d-5e4831d5dd92" :answer/validate] [:db/add "37443c11-d637-5757-ac8e-24ae357fcae1" :answer/id #uuid "37443c11-d637-5757-ac8e-24ae357fcae1"] [:db/add "37443c11-d637-5757-ac8e-24ae357fcae1" :answer/type :answer.type/math] [:db/add "37443c11-d637-5757-ac8e-24ae357fcae1" :answer/value "\\frac{1}{2}\\left(\\arcsin{\\left(4 x \\right)}\\right)+C"] [:db/ensure "37443c11-d637-5757-ac8e-24ae357fcae1" :answer/validate] [:db/add "653e40a6-e01b-596d-933b-71404bcfb65c" :answer/id #uuid "653e40a6-e01b-596d-933b-71404bcfb65c"] [:db/add "653e40a6-e01b-596d-933b-71404bcfb65c" :answer/type :answer.type/math] [:db/add "653e40a6-e01b-596d-933b-71404bcfb65c" :answ