swer.type/math] [:db/add "2fa9a6cf-4858-559e-916a-a1315f3dfe2b" :answer/value "\\arcsin{\\left(\\frac{x}{3} \\right)}+C"] [:db/ensure "2fa9a6cf-4858-559e-916a-a1315f3dfe2b" :answer/validate] [:db/add "6cded9ad-cc23-5579-9aa3-f736deb6117d" :answer/id #uuid "6cded9ad-cc23-5579-9aa3-f736deb6117d"] [:db/add "6cded9ad-cc23-5579-9aa3-f736deb6117d" :answer/type :answer.type/math] [:db/add "6cded9ad-cc23-5579-9aa3-f736deb6117d" :answer/value "2\\left(\\arcsin{\\left(\\frac{2 x}{3} \\right)}\\right)+C"] [:db/ensure "6cded9ad-cc23-5579-9aa3-f736deb6117d" :answer/validate] [:db/add "315e4ff4-ec1d-56c7-aa23-df35250ec972" :answer/id #uuid "315e4ff4-ec1d-56c7-aa23-df35250ec972"] [:db/add "315e4ff4-ec1d-56c7-aa23-df35250ec972" :answer/type :answer.type/math] [:db/add "315e4ff4-ec1d-56c7-aa23-df35250ec972" :answer/value "2\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C"] [:db/ensure "315e4ff4-ec1d-56c7-aa23-df35250ec972" :answer/validate] [:db/add "0f3b0e8a-c465-5427-be23-1a85f3f636f8" :answer/id #uuid "0f3b0e8a-c465-5427-be23-1a85f3f636f8"] [:db/add "0f3b0e8a-c465-5427-be23-1a85f3f636f8" :answer/type :answer.type/math] [:db/add "0f3b0e8a-c465-5427-be23-1a85f3f636f8" :answer/value "-2\\left(\\arcsin{\\left(x \\right)}\\right)+C"] [:db/ensure "0f3b0e8a-c465-5427-be23-1a85f3f636f8" :answer/validate] [:db/add "4be62f24-c88a-59b7-b3bc-4d6b50594e21" :answer/id #uuid "4be62f24-c88a-59b7-b3bc-4d6b50594e21"] [:db/add "4be62f24-c88a-59b7-b3bc-4d6b50594e21" :answer/type :answer.type/math] [:db/add "4be62f24-c88a-59b7-b3bc-4d6b50594e21" :answer/value "\\arcsin{\\left(\\frac{2 x}{3} \\right)}+C"] [:db/ensure "4be62f24-c88a-59b7-b3bc-4d6b50594e21" :answer/validate] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/id #uuid "14e877b1-eed4-58e5-a9a6-60c0c3a37664"] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/key "answer"] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/type :answer-field.type/radio] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/choices "2fa9a6cf-4858-559e-916a-a1315f3dfe2b"] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/choices "6cded9ad-cc23-5579-9aa3-f736deb6117d"] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/choices "315e4ff4-ec1d-56c7-aa23-df35250ec972"] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/choices "0f3b0e8a-c465-5427-be23-1a85f3f636f8"] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/choices "4be62f24-c88a-59b7-b3bc-4d6b50594e21"] [:db/add "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/correct "315e4ff4-ec1d-56c7-aa23-df35250ec972"] [:db/ensure "14e877b1-eed4-58e5-a9a6-60c0c3a37664" :answer-field/validate] [:db/add "96100969-066d-5014-b021-b96b25f2b3b9" :question/id #uuid "96100969-066d-5014-b021-b96b25f2b3b9"] [:db/add "96100969-066d-5014-b021-b96b25f2b3b9" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "96100969-066d-5014-b021-b96b25f2b3b9" :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=3\\sqrt{1-(\\frac{x}{3})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{2}{3}\\cdot 3=2$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n2\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=2\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C.\n$$"] [:db/add "96100969-066d-5014-b021-b96b25f2b3b9" :question/difficulty :question.difficulty/moderate] [:db/add "96100969-066d-5014-b021-b96b25f2b3b9" :question/answer-fields "14e877b1-eed4-58e5-a9a6-60c0c3a37664"] [:db/ensure "96100969-066d-5014-b021-b96b25f2b3b9" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "96100969-066d-5014-b021-b96b25f2b3b9"] [:db/add "857d92c7-90cb-55bf-8622-19f8dadfc3bb" :answer/id #uuid "857d92c7-90cb-55bf-8622-19f8dadfc3bb"] [:db/add "857d92c7-90cb-55bf-8622-19f8dadfc3bb" :answer/type :answer.type/math] [:db/add "857d92c7-90cb-55bf-8622-19f8dadfc3bb" :answer/value "8\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C"] [:db/ensure "857d92c7-90cb-55bf-8622-19f8dadfc3bb" :answer/validate] [:db/add "77100392-83c2-53b8-8787-ea965743c68d" :answer/id #uuid "77100392-83c2-53b8-8787-ea965743c68d"] [:db/add "77100392-83c2-53b8-8787-ea965743c68d" :answer/type :answer.type/math] [:db/add "77100392-83c2-53b8-8787-ea965743c68d" :answer/value "4\\left(\\arcsin{\\left(x \\right)}\\right)+C"] [:db/ensure "77100392-83c2-53b8-8787-ea965743c68d" :answer/validate] [:db/add "da279c9f-69d6-5715-8bee-e28e55f1c47a" :answer/id #uuid "da279c9f-69d6-5715-8bee-e28e55f1c47a"] [:db/add "da279c9f-69d6-5715-8bee-e28e55f1c47a" :answer/type :answer.type/math] [:db/add "da279c9f-69d6-5715-8bee-e28e55f1c47a" :answer/value "4\\left(\\arcsin{\\left(\\frac{x}{3} \\right)}\\right)+C"] [:db/ensure "da279c9f-69d6-5715-8bee-e28e55f1c47a" :answer/validate] [:db/add "55163330-bfe7-5529-9d4c-9debf1865250" :answer/id #uuid "55163330-bfe7-5529-9d4c-9debf1865250"] [:db/add "55163330-bfe7-5529-9d4c-9debf1865250" :answer/type :answer.type/math] [:db/add "55163330-bfe7-5529-9d4c-9debf1865250" :answer/value "8\\left(\\arcsin{\\left(\\frac{2 x}{3} \\right)}\\right)+C"] [:db/ensure "55163330-bfe7-5529-9d4c-9debf1865250" :answer/validate] [:db/add "88f73057-8300-5eed-8fce-c10dbefff77a" :answer/id #uuid "88f73057-8300-5eed-8fce-c10dbefff77a"] [:db/add "88f73057-8300-5eed-8fce-c10dbefff77a" :answer/type :answer.type/math] [:db/add "88f7305