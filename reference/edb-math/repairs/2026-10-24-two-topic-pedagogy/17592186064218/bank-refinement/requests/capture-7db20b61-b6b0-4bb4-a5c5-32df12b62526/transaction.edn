\n\n$$\n\\begin{aligned}&\\int \\frac{4}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n4\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=4\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\arcsin{\\left(\\frac{x}{4} \\right)}\\right)+C.\n$$"] [:db/add "3bcbd307-7eb0-5749-9f39-f59ad0eeb13c" :question/difficulty :question.difficulty/moderate] [:db/add "3bcbd307-7eb0-5749-9f39-f59ad0eeb13c" :question/answer-fields "f744ca99-c16f-5a9f-b4b6-91fd8f5bbd78"] [:db/ensure "3bcbd307-7eb0-5749-9f39-f59ad0eeb13c" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "3bcbd307-7eb0-5749-9f39-f59ad0eeb13c"] [:db/add "c47c661f-037f-51b9-8d03-0be231871dcb" :answer/id #uuid "c47c661f-037f-51b9-8d03-0be231871dcb"] [:db/add "c47c661f-037f-51b9-8d03-0be231871dcb" :answer/type :answer.type/math] [:db/add "c47c661f-037f-51b9-8d03-0be231871dcb" :answer/value "3\\left(\\arcsin{\\left(x \\right)}\\right)+C"] [:db/ensure "c47c661f-037f-51b9-8d03-0be231871dcb" :answer/validate] [:db/add "52347b5d-701b-508d-9f0d-6db99534fc48" :answer/id #uuid "52347b5d-701b-508d-9f0d-6db99534fc48"] [:db/add "52347b5d-701b-508d-9f0d-6db99534fc48" :answer/type :answer.type/math] [:db/add "52347b5d-701b-508d-9f0d-6db99534fc48" :answer/value "-3\\left(\\arcsin{\\left(\\frac{x}{4} \\right)}\\right)+C"] [:db/ensure "52347b5d-701b-508d-9f0d-6db99534fc48" :answer/validate] [:db/add "49f61ff3-2254-54da-b1eb-a491bf3dfdd5" :answer/id #uuid "49f61ff3-2254-54da-b1eb-a491bf3dfdd5"] [:db/add "49f61ff3-2254-54da-b1eb-a491bf3dfdd5" :answer/type :answer.type/math] [:db/add "49f61ff3-2254-54da-b1eb-a491bf3dfdd5" :answer/value "6\\left(\\arcsin{\\left(x \\right)}\\right)+C"] [:db/ensure "49f61ff3-2254-54da-b1eb-a491bf3dfdd5" :answer/validate] [:db/add "72ac2255-de6b-5677-9fdb-2d0e668960c9" :answer/id #uuid "72ac2255-de6b-5677-9fdb-2d0e668960c9"] [: