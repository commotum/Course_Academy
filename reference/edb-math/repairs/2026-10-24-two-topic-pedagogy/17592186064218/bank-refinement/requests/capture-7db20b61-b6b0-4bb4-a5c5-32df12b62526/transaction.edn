cf-5df3-9893-3d85eeeff7fa"] [:db/add "a972b44c-4443-5a49-ba25-77dd606919f5" :answer-field/choices "34e122c0-3af1-5d6f-9f59-0b1fafedb19b"] [:db/add "a972b44c-4443-5a49-ba25-77dd606919f5" :answer-field/choices "c6f9cfc9-045a-5c64-9b76-399092f18a17"] [:db/add "a972b44c-4443-5a49-ba25-77dd606919f5" :answer-field/choices "082e9f1c-b7f4-55f7-812a-806915841186"] [:db/add "a972b44c-4443-5a49-ba25-77dd606919f5" :answer-field/choices "a538a893-d9e5-5400-bada-2d743c13ef4b"] [:db/add "a972b44c-4443-5a49-ba25-77dd606919f5" :answer-field/correct "a538a893-d9e5-5400-bada-2d743c13ef4b"] [:db/ensure "a972b44c-4443-5a49-ba25-77dd606919f5" :answer-field/validate] [:db/add "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5" :question/id #uuid "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5"] [:db/add "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{\\sqrt{25 - 4 x^{2}}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5" :question/worked-solution "Let $u=\\frac{2 x}{5}$. Then $\\mathrm{d}u=(\\frac{2}{5})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{25 - 4 x^{2}}=5\\sqrt{1-(\\frac{2 x}{5})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{5}{2}\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{5}\\cdot \\frac{5}{2}=2$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{\\sqrt{25 - 4 x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n2\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=2\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\arcsin{\\left(\\frac{2 x}{5} \\right)}\\right)+C.\n$$"] [:db/add "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5" :question/difficulty :question.difficulty/hard] [:db/add "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5" :question/answer-fields "a972b44c-4443-5a49-ba25-77dd606919f5"] [:db/ensure "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "2a55d7ae-9d4b-5c96-84f9-d74247a5e8d5"] [:db/add "72b275dd-3871-5105-88f5-755d10a926ee" :answer/id #uuid "72b275dd-3871-5105-88f5-755d10a926ee"] [:db/add "72b275dd-3871-5105-88f5-755d10a926ee" :answer/type :answer.type/math] [:db/add "72b275dd-3871-5105-88f5-755d10a926ee" :answer/value "\\arcsin{\\left(\\frac{4 x}{3} \\right)}+C"] [:db/ensure "72b275dd-3871-5105-88f5-755d10a926ee" :answer/validate] [:db/add "b32a694d-98fc-518d-8d6c-aaa87c826cd0" :answer/id #uuid "b32a694d-98fc-518d-8d6c-aaa87c826cd0"] [:db/add "b32a694d-98fc-518d-8d6c-aaa87c826cd0" :answer/type :answer.type/math] [:db/add "b32a694d-98fc-518d-8d6c-aaa87c826cd0" :answer/value "\\arcsin{\\left(\\frac{2 x}{3} \\right)}+C"] [:db/ensure "b32a694d-98fc-518d-8d6c-aaa87c826cd0" :answer/validate] [:db/add "b32c75cc-0ac2-5c4b-979b-3d06f393a8cd" :answer/id #uuid "b32c75cc-0ac2-5c4b-979b-3d06f393a8cd"] [:db/add "b32c75cc-0ac2-5c4b-979b-3d06f393a8cd" :answer/type :answer.type/math] [:db/add "b32c75cc-0ac2-5c4b-979b-3d06f393a8cd" :answer/value "2\\left(\\arcsin{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "b32c75cc-0ac2-5c4b-979b-3d06f393a8cd" :answer/validate] [:db/add "fa98060f-fb27-5f4d-9d7a-59b8066ccd78" :answer/id #uuid "fa98060f-fb27-5f4d-9d7a-59b8066ccd78"] [:db/add "fa98060f-fb27-5f4d-9d7a-59b8066ccd78" :answer/type :answer.type/math] [:db/add "fa98060f-fb27-5f4d-9d7a-59b8066ccd78" :answer/value "-1\\left(\\arcsin{\\left(x \\right)}\\right)+C"] [:db/ensure "fa98060f-fb27-5f4d-9d7a-59b8066ccd78" :answer/validate] [:db/add "3b274588-c364-5780-82aa-be8327332f41" :answer/id #uuid "3b274588-c364-5780-82aa-be8327332f41"] [:db/add "3b274588-c364-5780-82aa-be8327332f41" :answer/type :answer.type/math] [:db/add "3b274588-c364-5780-82aa-be8327332f41