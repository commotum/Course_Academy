  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"5f9187f5-22ec-5e13-b86a-998e6cfcb208\" :answer/id #uuid \"5f9187f5-22ec-5e13-b86a-998e6cfcb208\"] [:db/add \"5f9187f5-22ec-5e13-b86a-998e6cfcb208\" :answer/type :answer.type/math] [:db/add \"5f9187f5-22ec-5e13-b86a-998e6cfcb208\" :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5f9187f5-22ec-5e13-b86a-998e6cfcb208\" :answer/validate] [:db/add \"1c95dfe4-db81-5259-aa60-815421fbd377\" :answer/id #uuid \"1c95dfe4-db81-5259-aa60-815421fbd377\"] [:db/add \"1c95dfe4-db81-5259-aa60-815421fbd377\" :answer/type :answer.type/math] [:db/add \"1c95dfe4-db81-5259-aa60-815421fbd377\" :answer/value \"\\\\frac{3}{2 \\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"1c95dfe4-db81-5259-aa60-815421fbd377\" :answer/validate] [:db/add \"f3397fd6-64bf-5ecf-911a-8e5aba594a85\" :answer/id #uuid \"f3397fd6-64bf-5ecf-911a-8e5aba594a85\"] [:db/add \"f3397fd6-64bf-5ecf-911a-8e5aba594a85\" :answer/type :answer.type/math] [:db/add \"f3397fd6-64bf-5ecf-911a-8e5aba594a85\" :answer/value \"- \\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"f3397fd6-64bf-5ecf-911a-8e5aba594a85\" :answer/validate] [:db/add \"5102527f-8dc0-5dd6-a34d-b228066149de\" :answer/id #uuid \"5102527f-8dc0-5dd6-a34d-b228066149de\"] [:db/add \"5102527f-8dc0-5dd6-a34d-b228066149de\" :answer/type :answer.type/math] [:db/add \"5102527f-8dc0-5dd6-a34d-b228066149de\" :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"5102527f-8dc0-5dd6-a34d-b228066149de\" :answer/validate] [:db/add \"53c7c3e1-48cd-50d6-98b7-0913f873b41d\" :answer/id #uuid \"53c7c3e1-48cd-50d6-98b7-0913f873b41d\"] [:db/add \"53c7c3e1-48cd-50d6-98b7-0913f873b41d\" :answer/type :answer.type/math] [:db/add \"53c7c3e1-48cd-50d6-98b7-0913f873b41d\" :answer/value \"\\\\frac{9}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"53c7c3e1-48cd-50d6-98b7-0913f873b41d\" :answer/validate] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/id #uuid \"9c9260c8-ddb4-529f-afa3-95f155a1d130\"] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/key \"answer\"] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/type :answer-field.type/radio] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/choices \"5f9187f5-22ec-5e13-b86a-998e6cfcb208\"] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/choices \"1c95dfe4-db81-5259-aa60-815421fbd377\"] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/choices \"f3397fd6-64bf-5ecf-911a-8e5aba594a85\"] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/choices \"5102527f-8dc0-5dd6-a34d-b228066149de\"] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/choices \"53c7c3e1-48cd-50d6-98b7-0913f873b41d\"] [:db/add \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/correct \"5102527f-8dc0-5dd6-a34d-b228066149de\"] [:db/ensure \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/validate] [:db/add \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\" :question/id #uuid \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\"] [:db/add \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\" :question/problem \"Use the substitution $u=2^{x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\"] [:db/add \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\" :question/worked-solution \"Let $u=2^{x} + 2$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"] [:db/add \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\" :question/difficulty :question.difficulty/easy] [:db/add \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\" :question/answer-fields \"9c9260c8-ddb4-529f-afa3-95f155a1d130\"] [:db/ensure \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\"] [:db/add \"1b356308-7f73-522c-8bcd-159b18b21749\" :answer/id #uuid \"1b356308-7f73-522c-8bcd-159b18b21749\"] [:db/add \"1b356308-7f73-522c-8bcd-159b18b21749\" :answer/type :answer.type/math] [:db/add \"1b356308-7f73-522c-8bcd-159b18b21749\" :answer/value \"3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"1b356308-7f73-522c-8bcd-159b18b21749\" :answer/validate] [:db/add \"03291e69-301a-5e36-a8ee-5af9f62b63b0\" :answer/id #uuid \"03291e69-301a-5e36-a8ee-5af9f62b63b0\"] [:db/add \"03291e69-301a-5e36-a8ee-5af9f62b63b0\" :answer/type :answer.type/math] [:db/add \"03291e69-301a-5e36-a8ee-5af9f62b63b0\" :answer/value \"-3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"03291e69-301a-5e36-a8ee-5af9f62b63b0\" :answer/validate] [:db/add \"daf8c088-8328-59ff-bd2d-7625b285ab5c\" :answer/id #uuid \"daf8c088-8328-59ff-bd2d-7625b285ab5c\"] [:db/add \"daf8c088-8328-59ff-bd2d-7625b285ab5c\" :answer/type :answer.type/math] [:db/add \"daf8c088-8328-59ff-bd2d-7625b285ab5c\" :answer/value \"9\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\"] [:db/ensure \"daf8c088-8328-59ff-bd2d-7625b285ab5c\" :answer/validate] [:db/add \"4f9eeb44-05c8-5aa5-876d-8e0b4c3f60dc\" :answer/id #uuid \"4f9eeb44-05c8-5aa5-876d-8e0b4c3f60dc\"] [:db/add \"4f9eeb44-05c8-5aa5-876d-8e0b4c3f60dc\" :answer/type :answer.type/math] [:db/add \"4f9eeb44-05c8-5aa5-876d-8e0b4c3f60dc\" :answer/value \"6\\\