42ad51810" :question/worked-solution "Let $u=e^{2 x} + 2$. Then $\\mathrm{d}u=(2 e^{2 x})\\,\\mathrm{d}x$.\n\nWork where $e^{2 x} + 2>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 \\left(e^{2 x} + 2\\right)^{2} e^{2 x}\\,\\mathrm{d}x\\\\&=\\int u^{2}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\int u^{2}\\,\\mathrm{d}u.\n$$"] [:db/add "3607a00c-ed00-5182-88fc-30842ad51810" :question/difficulty :question.difficulty/easy] [:db/add "3607a00c-ed00-5182-88fc-30842ad51810" :question/answer-fields "a26b5c34-17e1-5280-8d13-b4e435154956"] [:db/ensure "3607a00c-ed00-5182-88fc-30842ad51810" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "3607a00c-ed00-5182-88fc-30842ad51810"] [:db/add "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0" :answer/id #uuid "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0"] [:db/add "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0" :answer/type :answer.type/math] [:db/add "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0" :answer/value "\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 \\left(3^{x} + 4\\right)^{\\frac{3}{2}}}{3}\\right)"] [:db/ensure "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0" :answer/validate] [:db/add "a79080ff-3a68-56f4-bd9c-22a0870f1b37" :answer-field/id #uuid "a79080ff-3a68-56f4-bd9c-22a0870f1b37"] [:db/add "a79080ff-3a68-56f4-bd9c-22a0870f1b37" :answer-field/key "answer"] [:db/add "a79080ff-3a68-56f4-bd9c-22a0870f1b37" :answer-field/type :answer-field.type/blank] [:db/add "a79080ff-3a68-56f4-bd9c-22a0870f1b37" :answer-field/choices "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0"] [:db/add "a79080ff-3a68-56f4-bd9c-22a0870f1b37" :answer-field/correct "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0"] [:db/ensure "a79080ff-3a68-56f4-bd9c-22a0870f1b37" :answer-field/validate] [:db/add "0156d36e-072e-5215-9c38-b10ce4b47e6d" :question/id #uuid "0156d36e-072e-5215-9c38-b10ce4b47e6d"] [:db/add "0156d36e-072e-5215-9c38-b10ce4b47e6d" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cdot 3^{x} \\sqrt{3^{x} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sqrt{u}\\,\\mathrm{d}u=\\frac{2 u^{\\frac{3}{2}}}{3}+C$.\n\nWork where $3^{x} + 4>0$.\n\n{{answer}} $+C$"] [:db/add "0156d36e-072e-5215-9c38-b10ce4b47e6d" :question/worked-solution "Let $u=3^{x} + 4$. Then $\\mathrm{d}u=(3^{x} \\ln{\\left(3 \\right)})\\,\\mathrm{d}x$.\n\nWork where $3^{x} + 4>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cdot 3^{x} \\sqrt{3^{x} + 4}\\,\\mathrm{d}x\\\\&=\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right)=\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 u^{\\frac{3}{2}}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 \\left(3^{x} + 4\\right)^{\\frac{3}{2}}}{3}\\right)+C.\n$$"] [:db/add "0156d36e-072e-5215-9c38-b10ce4b47e6d" :question/difficulty :question.difficulty/moderate] [:db/add "0156d36e-072e-5215-9c38-b10ce4b47e6d" :question/answer-fields "a79080ff-3a68-56f4-bd9c-22a0870f1b37"] [:db/ensure "0156d36e-072e-5215-9c38-b10ce4b47e6d" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "0156d36e-072e-5215-9c38-b10ce4b47e6d"] [:db/add "ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02" :answer/id #uuid "ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02"] [:db/add "ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02" :answer/type :answer.type/math] [:db/add "ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02" :answer/value "\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 2\\right|\\right)"] [:db/ensure "ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02" :answer/validate] [:db/add "cd09eb4b-c664-50f9-8113-b56c9880d85e" :answer-field/id #uuid "cd09eb4b-c664-50f9-8113-b56c9880d85e"] [:db/add "cd09eb4b-c664-50f9-8113-b56c9880d85e" :answer-field/key "answer"] [:db/add "cd09eb4b-c664-50f9-8113-b56c9880d85e" :answer-field/type :answer-field.type/blank] [:db/add "cd09eb4b-c664-50f9-8113-b56c9880d85e" :answer-field/choices "ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02"] [:db/add "cd09eb4b-c664-50f9-8113-b56c9880d85e" :answer-field/correct "ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02"] [:db/ensure "cd09eb4b-c664-50f9-8113-b56c9880d85e" :answer-field/validate] [:db/add "eaed86d4-f4ba-55c4-8957-65e72c41413d" :question/id #uuid "eaed86d4-f4ba-55c4-8957-65e72c41413d"] [:db/add "eaed86d4-f4ba-55c4-8957-65e72c41413d" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 \\cdot 5^{x}}{5^{x} + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "eaed86d4-f4ba-55c4-8957-65e72c41413d" :question/worked-solution "Let $u=5^{x} + 2$. Then $\\mathrm{d}u=(5^{x} \\ln{\\left(5 \\right)})\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 \\cdot 5^{x}}{5^{x} + 2}\\,\\mathrm{d}x\\\\&=\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 2\\right|\\right)+C.\n$$"] [:db/add "eaed86d4-f4ba-55c4-8957-65e72c41413d" :question/difficulty :question.difficulty/moderate] [:db/add "eaed86d4-f4ba-55c4-8957-65e72c41413d" :question/answer-fields "cd09eb4b-c664-50f9-8113-b56c9880d85e"] [:db/ensure "eaed86d4-f4ba-55c4-8957-65e72c41413d" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "eaed86d4-f4ba-55c4-8957-65e72c41413d"] [:db/add "d8ce16e4-e6e9-5770-bd52-c528f41d4c34" :answer/id #uuid "d8ce16e4-e6e9-5770-bd52-c528f41d4c34"] [:db/add "d8ce16e4-e6e9-5770-bd52-c528f41d4c34" :answer/type :answer.type/math] [:db/add "d8ce16e4-e6e9-5770-bd52-c528f41d4c34" :answer/value "4\\left(\\ln\\left|e^{x} + 1\\right|\\right)"] [:db/ensure "d8ce16e4-e6e9-5770-bd52-c528f41d4c34" :answer/validate] [:db/add "e044980f-df8c-5ebc-9aab-7e314954a789" :answer-field/id #uuid "e044980f-df8c-5ebc-9aab-7e314954a789"] [:db/add "e044980f-df8c-5ebc-9aab-7e314954a789" :answer-field/key "answer"] [:db/add "e044980f-df8c-5ebc-9aab-7e314954a789" :answer-field/type :answer-field.type/blank] [:db/add "e044980f-df8c-5ebc-9aab-7e314954a789" :answer-field/choices "d8ce16e4-e6e9-5770-bd52-c528f41d4c34"] [:db/add "e044980f-df8c-5ebc-9aab-7e314954a789" :answer-field/correct "d8ce16e4-e6e9-5770-bd52-c528f41d4c34"] [:db/ensure "e044980f-df8c-5ebc-9aab-7e314954a789" :answer-field/validate] [:db/add "234b841b-ddf2-5537-9f3b-c343ab766392" :question/id #uuid "234b841b-ddf2-5537-9f3b-c343ab766392"] [:db/add "234b841b-ddf2-5537-9f3b-c343ab766392" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "234b841b-ddf2-5537-9f3b-c343ab766392" :question/worked-solution "Let $u=e^{x} + 1$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=4\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\ln\\left|e^{x} + 1\\right|\\right)+C.\n$$"] [:db/add "234b841b-ddf2-5537-9f3b-c343ab766392" :question/difficulty :question.difficulty/moderate] [:db/add "234b841b-ddf2-5537-9f3b-c343ab766392" :question/answer-fields "e044980f-df8c-5ebc-9aab-7e314954a789"] [:db/ensure "234b841b-ddf2-5537-9f3b-c343ab766392" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "234b841b-ddf2-5537-9f3b-c343ab766392"] [:db/add "3320dec6-8b4f-590e-8dcb-0742047d4bbe" :answer/id #uuid "3320dec6-8b4f-590e-8dcb-0742047d4bbe"] [:db/add "3320dec6-8b4f-590e-8dcb-0742047d4bbe" :answer/type :answer.type/math] [:db/add "3320dec6-8b4f-590e-8dcb-0742047d4bbe" :answer/value "2\\left(\\frac{2 \\left(e^{2 x} + 1\\right)^{\\frac{3}{2}}}{3}\\right)"] [:db/ensure "3320dec6-8b4f-590e-8dcb-0742047d4bbe" :answer/validate] [:db/add "947510be-5291-5029-825b-05037b47652f" :answer-field/id #uuid "947510be-5291-5029-825b-05037b47652f"] [:db/add "947510be-5291-5029-825b-05037b47652f" :answer-field/key "answer"] [:db/add "947510be-5291-5029-825b-05037b47652f" :answer-field/type :answer-field.type/blank] [:db/add "947510be-5291-5029-825b-05037b47652f" :answer-field/choices "3320dec6-8b4f-590e-8dcb-0742047d4bbe"] [:db/add "947510be-5291-5029-825b-05037b47652f" :answer-field/correct "3320dec6-8b4f-590e-8dcb-0742047d4bbe"] [:db/ensure "947510be-5291-5029-825b-05037b47652f" :answer-field/validate] [:db/add "69d1eec5-81a3-5284-a785-7a97dc40fb64" :question/id #uuid "69d1eec5-81a3-5284-a785-7a97dc40fb64"] [:db/add "69d1eec5-81a3-5284-a785-7a97dc40fb64" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\sqrt{e^{2 x} + 1} e^{2 x}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sqrt{u}\\,\\mathrm{d}u=\\frac{2 u^{\\frac{3}{2}}}{3}+C$.\n\nWork where $e^{2 x} + 1>0$.\n\n{{answer}} $+C$"] [:db/add "69d1eec5-81a3-5284-a785-7a97dc40fb64" :question/worked-solution "Let $u=e^{2 x} + 1$. Then $\\mathrm{d}u=(2 e^{2 x})\\,\\mathrm{d}x$.\n\nWork where $e^{2 x} + 1>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\sqrt{e^{2 x} + 1} e^{2 x}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n2\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right)=2\\left(\\frac{2 u^{\\frac{3}{2}}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\frac{2 \\left(e^{2 x} + 1\\right)^{\\frac{3}{2}}}{3}\\right)+C.\n$$"] [:db/add "69d1eec5-81a3-5284-a785-7a97dc40fb64" :question/difficulty :question.difficulty/moderate] [:db/add "69d1eec5-81a3-5284-a785-7a97dc40fb64" :question/answer-fields "947510be-5291-5029-825b-05037b47652f"] [:db/ensure "69d1eec5-81a3-5284-a785-7a97dc40fb64" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "69d1eec5-81a3-5284-a785-7a97dc40fb64"] [:db/add "e180d782-4de4-56af-b422-90495e9d1e10" :answer/id #uuid "e180d782-4de4-56af-b422-90495e9d1e10"] [:db/add "e180d782-4de4-56af-b422-90495e9d1e10" :answer/type :answer.type/math] [:db/add "e180d782-4de4-56af-b422-90495e9d1e10" :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{2^{x} + 2}\\right)"] [:db/ensure "e180d782-4de4-56af-b422-90495e9d1e10" :answer/validate] [:db/add "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f" :answer-field/id #uuid "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f"] [:db/add "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f" :answer-field/key "answer"] [:db/add "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f" :answer-field/type :answer-field.type/blank] [:db/add "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f" :answer-field/choices "e180d782-4de4-56af-b422-90495e9d1e10"] [:db/add "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f" :answer-field/correct "e180d782-4de4-56af-b422-90495e9d1e10"] [:db/ensure "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f" :answer-field/validate] [:db/add "11ef6d40-0a09-58bb-8363-01217a52d0ea" :question/id #uuid "11ef6d40-0a09-58bb-8363-01217a52d0ea"] [:db/add "11ef6d40-0a09-58bb-8363-01217a52d0ea" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 \\cdot 2^{x}}{\\sqrt{2^{x} + 2}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u=2 \\sqrt{u}+C$.\n\nWork where $2^{x} + 2>0$.\n\n{{answer}} $+C$"] [:db/add "11ef6d40-0a09-58bb-8363-01217a52d0ea" :question/worked-solution "Let $u=2^{x} + 2$. Then $\\mathrm{d}u=(2^{x} \\ln{\\left(2 \\right)})\\,\\mathrm{d}x$.\n\nWork where $2^{x} + 2>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 \\cdot 2^{x}}{\\sqrt{2^{x} + 2}}\\,\\mathrm{d}x\\\\&=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right)=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{2^{x} + 2}\\right)+C.\n$$"] [:db/add "11ef6d40-0a09-58bb-8363-01217a52d0ea" :question/difficulty :question.difficulty/moderate] [:db/add "11ef6d40-0a09-58bb-8363-01217a52d0ea" :question/answer-fields "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f"] [:db/ensure "11ef6d40-0a09-58bb-8363-01217a52d0ea" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "11ef6d40-0a09-58bb-8363-01217a52d0ea"] [:db/add "8156d017-3401-5bd3-a0d0-6313ab57906c" :answer/id #uuid "8156d017-3401-5bd3-a0d0-6313ab57906c"] [:db/add "8156d017-3401-5bd3-a0d0-6313ab57906c" :answer/type :answer.type/math] [:db/add "8156d017-3401-5bd3-a0d0-6313ab57906c" :answer/value "3\\left(2 \\sqrt{e^{x} + 3}\\right)"] [:db/ensure "8156d017-3401-5bd3-a0d0-6313ab57906c" :answer/validate] [:db/add "396dc548-1d55-579a-8b96-6c2d63e31740" :answer-field/id #uuid "396dc548-1d55-579a-8b96-6c2d63e31740"] [:db/add "396dc548-1d55-579a-8b96-6c2d63e31740" :answer-field/key "answer"] [:db/add "396dc548-1d55-579a-8b96-6c2d63e31740" :answer-field/type :answer-field.type/blank] [:db/add "396dc548-1d55-579a-8b96-6c2d63e31740" :answer-field/choices "8156d017-3401-5bd3-a0d0-6313ab57906c"] [:db/add "396dc548-1d55-579a-8b96-6c2d63e31740" :answer-field/correct "8156d017-3401-5bd3-a0d0-6313ab57906c"] [:db/ensure "396dc548-1d55-579a-8b96-6c2d63e31740" :answer-field/validate] [:db/add "79fd7a1c-f80b-5f30-b249-83e9987f33c8" :question/id #uuid "79fd7a1c-f80b-5f30-b249-83e9987f33c8"] [:db/add "79fd7a1c-f80b-5f30-b249-83e9987f33c8" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 e^{x}}{\\sqrt{e^{x} + 3}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u=2 \\sqrt{u}+C$.\n\nWork where $e^{x} + 3>0$.\n\n{{answer}} $+C$"] [:db/add "79fd7a1c-f80b-5f30-b249-83e9987f33c8" :question/worked-solution "Let $u=e^{x} + 3$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nWork where $e^{x} + 3>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 e^{x}}{\\sqrt{e^{x} + 3}}\\,\\mathrm{d}x\\\\&=3\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n3\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right)=3\\left(2 \\sqrt{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n3\\left(2 \\sqrt{e^{x} + 3}\\right)+C.\n$$"] [:db/add "79fd7a1c-f80b-5f30-b249-83e9987f33c8" :question/difficulty :question.difficulty/moderate] [:db/add "79fd7a1c-f80b-5f30-b249-83e9987f33c8" :question/answer-fields "396dc548-1d55-579a-8b96-6c2d63e31740"] [:db/ensure "79fd7a1c-f80b-5f30-b249-83e9987f33c8" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "79fd7a1c-f80b-5f30-b249-83e9987f33c8"] [:db/add "cc74a0e7-44e2-5fae-a5db-8d69f134f85d" :answer/id #uuid "cc74a0e7-44e2-5fae-a5db-8d69f134f85d"] [:db/add "cc74a0e7-44e2-5fae-a5db-8d69f134f85d" :answer/type :answer.type/math] [:db/add "cc74a0e7-44e2-5fae-a5db-8d69f134f85d" :answer/value "\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\frac{2 \\left(2^{x} + 3\\right)^{\\frac{3}{2}}}{3}\\right)"] [:db/ensure "cc74a0e7-44e2-5fae-a5db-8d69f134f85d" :answer/validate] [:db/add "0db88b23-58cf-5ec3-87d8-e693487a62ba" :answer-field/id #uuid "0db88b23-58cf-5ec3-87d8-e693487a62ba"] [:db/add "0db88b23-58cf-5ec3-87d8-e693487a62ba" :answer-field/key "answer"] [:db/add "0db88b23-58cf-5ec3-87d8-e693487a62ba" :answer-field/type :answer-field.type/blank] [:db/add "0db88b23-58cf-5ec3-87d8-e693487a62ba" :answer-field/choices "cc74a0e7-44e2-5fae-a5db-8d69f134f85d"] [:db/add "0db88b23-58cf-5ec3-87d8-e693487a62ba" :answer-field/correct "cc74a0e7-44e2-5fae-a5db-8d69f134f85d"] [:db/ensure "0db88b23-58cf-5ec3-87d8-e693487a62ba" :answer-field/validate] [:db/add "fbe42d09-6935-5167-af4a-642732c52ed7" :question/id #uuid "fbe42d09-6935-5167-af4a-642732c52ed7"] [:db/add "fbe42d09-6935-5167-af4a-642732c52ed7" :question/problem "Find an antiderivative.\n\n$$\n\\int 2^{x} \\sqrt{2^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sqrt{u}\\,\\mathrm{d}u=\\frac{2 u^{\\frac{3}{2}}}{3}+C$.\n\nWork where $2^{x} + 3>0$.\n\n{{answer}} $+C$"] [:db/add "fbe42d09-6935-5167-af4a-642732c52ed7" :question/worked-solution "Let $u=2^{x} + 3$. Then $\\mathrm{d}u=(2^{x} \\ln{\\left(2 \\right)})\\,\\mathrm{d}x$.\n\nWork where $2^{x} + 3>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2^{x} \\sqrt{2^{x} + 3}\\,\\mathrm{d}x\\\\&=\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right)=\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\frac{2 u^{\\frac{3}{2}}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\frac{2 \\left(2^{x} + 3\\right)^{\\frac{3}{2}}}{3}\\right)+C.\n$$"] [:db/add "fbe42d09-6935-5167-af4a-642732c52ed7" :question/difficulty :question.difficulty/moderate] [:db/add "fbe42d09-6935-5167-af4a-642732c52ed7" :question/answer-fields "0db88b23-58cf-5ec3-87d8-e693487a62ba"] [:db/ensure "fbe42d09-6935-5167-af4a-642732c52ed7" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "fbe42d09-6935-5167-af4a-642732c52ed7"] [:db/add "6edf7752-6e76-549e-b7f5-cc968d4c1e6b" :answer/id #uuid "6edf7752-6e76-549e-b7f5-cc968d4c1e6b"] [:db/add "6edf7752-6e76-549e-b7f5-cc968d4c1e6b" :answer/type :answer.type/math] [:db/add "6edf7752-6e76-549e-b7f5-cc968d4c1e6b" :answer/value "\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 4\\right|\\right)"] [:db/ensure "6edf7752-6e76-549e-b7f5-cc968d4c1e6b" :answer/validate] [:db/add "2670a155-a926-5568-96d3-f75f22455479" :answer-field/id #uuid "2670a155-a926-5568-96d3-f75f22455479"] [:db/add "2670a155-a926-5568-96d3-f75f22455479" :answer-field/key "answer"] [:db/add "2670a155-a926-5568-96d3-f75f22455479" :answer-field/type :answer-field.type/blank] [:db/add "2670a155-a926-5568-96d3-f75f22455479" :answer-field/choices "6edf7752-6e76-549e-b7f5-cc968d4c1e6b"] [:db/add "2670a155-a926-5568-96d3-f75f22455479" :answer-field/correct "6edf7752-6e76-549e-b7f5-cc968d4c1e6b"] [:db/ensure "2670a155-a926-5568-96d3-f75f22455479" :answer-field/validate] [:db/add "b600485f-2a8a-53d6-9f97-db58335a0f24" :question/id #uuid "b600485f-2a8a-53d6-9f97-db58335a0f24"] [:db/add "b600485f-2a8a-53d6-9f97-db58335a0f24" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{5^{x}}{5^{x} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "b600485f-2a8a-53d6-9f97-db58335a0f24" :question/worked-solution "Let $u=5^{x} + 4$. Then $\\mathrm{d}u=(5^{x} \\ln{\\left(5 \\right)})\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{5^{x}}{5^{x} + 4}\\,\\mathrm{d}x\\\\&=\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 4\\right|\\right)+C.\n$$"] [:db/add "b600485f-2a8a-53d6-9f97-db58335a0f24" :question/difficulty :question.difficulty/moderate] [:db/add "b600485f-2a8a-53d6-9f97-db58335a0f24" :question/answer-fields "2670a155-a926-5568-96d3-f75f22455479"] [:db/ensure "b600485f-2a8a-53d6-9f97-db58335a0f24" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "b600485f-2a8a-53d6-9f97-db58335a0f24"] [:db/add "ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2" :answer/id #uuid "ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2"] [:db/add "ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2" :answer/type :answer.type/math] [:db/add "ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2" :answer/value "\\frac{3}{2}\\left(\\ln\\left|2 x + e^{2 x} + 1\\right|\\right)"] [:db/ensure "ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2" :answer/validate] [:db/add "8b553907-b58e-5267-8715-e4778af79c9c" :answer-field/id #uuid "8b553907-b58e-5267-8715-e4778af79c9c"] [:db/add "8b553907-b58e-5267-8715-e4778af79c9c" :answer-field/key "answer"] [:db/add "8b553907-b58e-5267-8715-e4778af79c9c" :answer-field/type :answer-field.type/blank] [:db/add "8b553907-b58e-5267-8715-e4778af79c9c" :answer-field/choices "ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2"] [:db/add "8b553907-b58e-5267-8715-e4778af79c9c" :answer-field/correct "ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2"] [:db/ensure "8b553907-b58e-5267-8715-e4778af79c9c" :answer-field/validate] [:db/add "bc08d550-1e24-59f1-bab8-fa99a8cbf667" :question/id #uuid "bc08d550-1e24-59f1-bab8-fa99a8cbf667"] [:db/add "bc08d550-1e24-59f1-bab8-fa99a8cbf667" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "bc08d550-1e24-59f1-bab8-fa99a8cbf667" :question/worked-solution "Let $u=2 x + e^{2 x} + 1$. Then $\\mathrm{d}u=(2 e^{2 x} + 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{3}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{3}{2}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{2}\\left(\\ln\\left|2 x + e^{2 x} + 1\\right|\\right)+C.\n$$"] [:db/add "bc08d550-1e24-59f1-bab8-fa99a8cbf667" :question/difficulty :question.difficulty/hard] [:db/add "bc08d550-1e24-59f1-bab8-fa99a8cbf667" :question/answer-fields "8b553907-b58e-5267-8715-e4778af79c9c"] [:db/ensure "bc08d550-1e24-59f1-bab8-fa99a8cbf667" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "bc08d550-1e24-59f1-bab8-fa99a8cbf667"] [:db/add "2e228d92-8e66-55f1-83eb-fa5d97e219e1" :answer/id #uuid "2e228d92-8e66-55f1-83eb-fa5d97e219e1"] [:db/add "2e228d92-8e66-55f1-83eb-fa5d97e219e1" :answer/type :answer.type/math] [:db/add "2e228d92-8e66-55f1-83eb-fa5d97e219e1" :answer/value "2\\left(\\ln\\left|x + e^{x} + 3\\right|\\right)"] [:db/ensure "2e228d92-8e66-55f1-83eb-fa5d97e219e1" :answer/validate] [:db/add "309b896d-0ed4-573b-ae38-151b2a7fd9ba" :answer-field/id #uuid "309b896d-0ed4-573b-ae38-151b2a7fd9ba"] [:db/add "309b896d-0ed4-573b-ae38-151b2a7fd9ba" :answer-field/key "answer"] [:db/add "309b896d-0ed4-573b-ae38-151b2a7fd9ba" :answer-field/type :answer-field.type/blank] [:db/add "309b896d-0ed4-573b-ae38-151b2a7fd9ba" :answer-field/choices "2e228d92-8e66-55f1-83eb-fa5d97e219e1"] [:db/add "309b896d-0ed4-573b-ae38-151b2a7fd9ba" :answer-field/correct "2e228d92-8e66-55f1-83eb-fa5d97e219e1"] [:db/ensure "309b896d-0ed4-573b-ae38-151b2a7fd9ba" :answer-field/validate] [:db/add "24ac3e9f-c431-5dd9-aaf4-0785964f442b" :question/id #uuid "24ac3e9f-c431-5dd9-aaf4-0785964f442b"] [:db/add "24ac3e9f-c431-5dd9-aaf4-0785964f442b" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 e^{x} + 2}{x + e^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "24ac3e9f-c431-5dd9-aaf4-0785964f442b" :question/worked-solution "Let $u=x + e^{x} + 3$. Then $\\mathrm{d}u=(e^{x} + 1)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 e^{x} + 2}{x + e^{x} + 3}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=2\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\ln\\left|x + e^{x} + 3\\right|\\right)+C.\n$$"] [:db/add "24ac3e9f-c431-5dd9-aaf4-0785964f442b" :question/difficulty :question.difficulty/hard] [:db/add "24ac3e9f-c431-5dd9-aaf4-0785964f442b" :question/answer-fields "309b896d-0ed4-573b-ae38-151b2a7fd9ba"] [:db/ensure "24ac3e9f-c431-5dd9-aaf4-0785964f442b" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "24ac3e9f-c431-5dd9-aaf4-0785964f442b"] [:db/add "389a48de-ba61-5e04-bb93-b02531e55793" :answer/id #uuid "389a48de-ba61-5e04-bb93-b02531e55793"] [:db/add "389a48de-ba61-5e04-bb93-b02531e55793" :answer/type :answer.type/math] [:db/add "389a48de-ba61-5e04-bb93-b02531e55793" :answer/value "4\\left(\\ln\\left|- 2 x + e^{x} + 3\\right|\\right)"] [:db/ensure "389a48de-ba61-5e04-bb93-b02531e55793" :answer/validate] [:db/add "04943376-ec09-5ee8-a026-2717f0edb9fc" :answer-field/id #uuid "04943376-ec09-5ee8-a026-2717f0edb9fc"] [:db/add "04943376-ec09-5ee8-a026-2717f0edb9fc" :answer-field/key "answer"] [:db/add "04943376-ec09-5ee8-a026-2717f0edb9fc" :answer-field/type :answer-field.type/blank] [:db/add "04943376-ec09-5ee8-a026-2717f0edb9fc" :answer-field/choices "389a48de-ba61-5e04-bb93-b02531e55793"] [:db/add "04943376-ec09-5ee8-a026-2717f0edb9fc" :answer-field/correct "389a48de-ba61-5e04-bb93-b02531e55793"] [:db/ensure "04943376-ec09-5ee8-a026-2717f0edb9fc" :answer-field/validate] [:db/add "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f" :question/id #uuid "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f"] [:db/add "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f" :question/worked-solution "Let $u=- 2 x + e^{x} + 3$. Then $\\mathrm{d}u=(e^{x} - 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=4\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\ln\\left|- 2 x + e^{x} + 3\\right|\\right)+C.\n$$"] [:db/add "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f" :question/difficulty :question.difficulty/hard] [:db/add "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f" :question/answer-fields "04943376-ec09-5ee8-a026-2717f0edb9fc"] [:db/ensure "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "f17aa6e6-95fe-551d-a18c-b1c22fb1c92f"] [:db/add "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a" :answer/id #uuid "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a"] [:db/add "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a" :answer/type :answer.type/math] [:db/add "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a" :answer/value "\\ln\\left|2 x + e^{2 x} + 4\\right|"] [:db/ensure "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a" :answer/validate] [:db/add "dcf91abd-7972-5cdd-a9d1-a1b544bbffff" :answer-field/id #uuid "dcf91abd-7972-5cdd-a9d1-a1b544bbffff"] [:db/add "dcf91abd-7972-5cdd-a9d1-a1b544bbffff" :answer-field/key "answer"] [:db/add "dcf91abd-7972-5cdd-a9d1-a1b544bbffff" :answer-field/type :answer-field.type/blank] [:db/add "dcf91abd-7972-5cdd-a9d1-a1b544bbffff" :answer-field/choices "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a"] [:db/add "dcf91abd-7972-5cdd-a9d1-a1b544bbffff" :answer-field/correct "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a"] [:db/ensure "dcf91abd-7972-5cdd-a9d1-a1b544bbffff" :answer-field/validate] [:db/add "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc" :question/id #uuid "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc"] [:db/add "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"] [:db/add "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc" :question/worked-solution "Let $u=2 x + e^{2 x} + 4$. Then $\\mathrm{d}u=(2 e^{2 x} + 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nSubstitute back:\n\n$$\n\\ln\\left|2 x + e^{2 x} + 4\\right|+C.\n$$"] [:db/add "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc" :question/difficulty :question.difficulty/hard] [:db/add "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc" :question/answer-fields "dcf91abd-7972-5cdd-a9d1-a1b544bbffff"] [:db/ensure "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc"] [:db/add "ef9d19b8-b764-5fc0-89ff-6ac72aea9d00" :answer/id #uuid "ef9d19b8-b764-5fc0-89ff-6ac72aea9d00"] [:db/add "ef9d19b8-b764-5fc0-89ff-6ac72aea9d00" :answer/type :answer.type/math] [:db/add "ef9d19b8-b764-5fc0-89ff-6ac72aea9d00" :answer/value "\\frac{1}{2}\\left(\\ln\\left|- 2 x + e^{2 x} + 4\\right|\\right)"] [:db/ensure "ef9d19b8-b764-5fc0-89ff-6ac72aea9d00" :answer/validate] [:db/add "72c51815-1bd0-5eb5-8b76-2f5b576ed2d6" :answer-field/id #uuid "72c51815-1bd0-5eb5-8b76-2f5b576ed2d6"] [:db/add "72c51815-1bd0-5eb5-8b76-2f5b576ed2d6" :answer-field/key "answer"] [:db/add "72c51815-1bd0-5eb5-8b76-2f5b576ed2d6" :answer-field/type :answer-field.type/blank] 