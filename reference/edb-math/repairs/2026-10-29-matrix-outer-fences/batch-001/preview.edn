} \\right]}\n}\n\t{\\left[ \\begin{array}{c}{k}_{1} \\\\ {k}_{2}\\end{array} \\right]}\n\t=\n{\\color{red}\n\t{\\left[ \\begin{array}{c}- \\hspace{0.222em} \\hspace{0.222em} {\\mathbf{a}}_{1} \\hspace{0.222em} \\hspace{0.222em} - \\\\ - \\hspace{0.222em} \\hspace{0.222em} {\\mathbf{a}}_{2} \\hspace{0.222em} \\hspace{0.222em} -\\end{array} \\right]}\n\t{\\left[ \\begin{array}{c}| \\\\ \\mathbf{x} \\\\ |\\end{array} \\right]}\n}\n$$\n\nIf we denote \n$$\nA={\\left[ \\begin{array}{cc}| & | \\\\ {\\mathbf{a}}_{1} & {\\mathbf{a}}_{2} \\\\ | & |\\end{array} \\right]}\n$$\nand $\\mathbf{k}={\\left[ \\begin{array}{c}{k}_{1} \\\\ {k}_{2}\\end{array} \\right]},$ then we obtain\n\n$$\nA^TA\\mathbf{k} = A^T\\mathbf{x}\n\t\\qquad\\Longrightarrow\\qquad\n\t\\mathbf{k}=(A^TA)^{-1}A^T\\mathbf{x}.\n$$\n\nAlso, we note that  $\\mathbf{x}_S = k_1 \\mathbf{a}_1 + k_2 \\mathbf{a}_2$ can be expressed as $\\textrm{proj}_{S}\\,\\mathbf{x}\t= A\\mathbf{k}.$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =Ak \\\\  & =A({A}^{T}A)^{-1}{A}^{T}x.\\end{aligned}\n$$\n\nThis is a formula for the orthogonal projection!\n\nNow, we return to our example. Using the formula, we get\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & 1 \\\\ 2 & 3 \\\\ 1 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ 2 & 3 \\\\ 1 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 4 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & 3 \\\\ 1 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}6 & 8 \\\\ 8 & 11\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}10 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & 3 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}11 & -8 \\\\ -8 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}10 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & 3 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-1 \\\\ 2\\end{bmatr