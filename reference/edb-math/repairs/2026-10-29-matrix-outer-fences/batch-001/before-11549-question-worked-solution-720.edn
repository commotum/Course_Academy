x}0 \\\\ 6\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=\\begin{bmatrix}0 & 1 & -1 \\\\ -1 & 0 & 1\\end{bmatrix}.\n$$"] [17592186512934 "Recall that the sample mean vector is given by\n\n$$\nm=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i},\n$$\n\nwhere ${x}_{1},{x}_{2},…,{x}_{n}$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix},\\,{x}_{2}=\\begin{bmatrix}4 \\\\ 11\\end{bmatrix},\\,{x}_{3}=\\begin{bmatrix}7 \\\\ -5\\end{bmatrix},\\,{x}_{4}=\\begin{bmatrix}-9 \\\\ -14\\end{bmatrix}.\n$$\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}(\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}4 \\\\ 11\\end{bmatrix}+\\begin{bmatrix}7 \\\\ -5\\end{bmatrix}+\\begin{bmatrix}-9 \\\\ -14\\end{bmatrix}) \\\\  & =\\frac{1}{4}\\begin{bmatrix}0 \\\\ -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$"] [17592186512954 "Recall that the sample mean vector is given by\n\n$$\nm=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i},\n$$\n\nwhere ${x}_{1},{x}_{2},…,{x}_{n}$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=\\begin{bmatrix}-1 \\\\ 7\\end{bmatrix},\\,{x}_{2}=\\begin{bmatrix}0 \\\\ 10\\end{bmatrix},\\,{x}_{3}=\\begin{bmatrix}-3 \\\\ 8\\end{bmatrix},\\,{x}_{4}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.\n$$\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}(\\begin{bmatrix}-1 \\\\ 7\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 10\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 8\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}) \\\\  & =\\frac{1}{4}\\begin{bmatrix}-6 \\\\ 28\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{3}{2} \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$"] [17592186512958 "Recall that the mean-deviation form of the observation matrix\n\n$$\nX=\\begin{bmatrix}| & | &  & | \\\\ {x}_{1} & {x}_{2} & ⋯ & {x}_{n} \\\\ | & | &  & |\\end{bmatrix}\n$$\n\nis given by \n\n$$\nB=\\begin{bmatrix}| & | &  & | \\\\ {b}_{1} & {b}_{2} & ⋯ & {b}_{n} \\\\ | & | &  & |\\end{bmatrix}\n$$\n\nwhere ${b}_{i}={x}_{i}-m$ for $i=1,2,…,n,$ and $m$ is sample mean vector.\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=\\begin{bmatrix}15 \\\\ 14\\end{bmatrix},\\,{x}_{2}=\\begin{bmatrix}23 \\\\ 20\\end{bmatrix},\\,{x}_{3}=\\begin{bmatrix}16 \\\\ 20\\end{bmatrix}.\n$$\n\nAs a result, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}(\\begin{bmatrix}15 \\\\ 14\\end{bmatrix}+\\begin{bmatrix}23 \\\\ 20\\end{bmatrix}+\\begin{bmatrix}16 \\\\ 20\\end{bmatrix}) \\\\  & =\\frac{1}{3}\\begin{bmatrix}54 \\\\ 54\\end{bmatrix} \\\\  & =\\begin{bmatrix}18 \\\\ 18\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=\\begin{bmatrix}15 \\\\ 14\\end{bmatrix}-\\begin{bmatrix}18 \\\\ 18\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ -4\\end{bmatrix} \\\\ {b}_{2} & ={x}_{2}-m=\\begin{bmatrix}23 \\\\ 20\\end{bmatrix}-\\begin{bmatrix}18 \\\\ 18\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 2\\end{bmatrix} \\\\ {b}_{3} & ={x}_{3}-m=\\begin{bmatrix}16 \\\\ 20\\end{bmatrix}-\\begin{bmatrix}18 \\\\ 18\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=\\begin{bmatrix}-3 & 5 & -2 \\\\ -4 & 2 & 2\\end{bmatrix}.\n$$"] [17592186516836 "To find a basis of $\\text{Null}(A),$ we need to solve the equation $Ax=0$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\text{Null}(A).$\n\nSince $A∼B,$ the equation $Ax=0$ is equivalent to the equation $Bx=0,$ which corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{3} &=0 \\\\ {x}_{2} &=0 \\\\ {x}_{4} &=0\\end{aligned}\\right.\n$$\n\nSo, the general solution is ${x}_{1}=-{x}_{3},$ ${x}_{2}=0,$ and ${x}_{4}=0,$ where ${x}_{3}$ is a free variable. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{bmatrix}=\\begin{bmatrix}-{x}_{3} \\\\ 0 \\\\ {x}_{3} \\\\ 0\\end{bmatrix}={x}_{3}\\begin{bmatrix}-1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nThis implies that \n\n$$\nB=\\{\\begin{bmatrix}-1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}\\}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$"] [17592186518122 "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={‖\\begin{bmatrix}5 \\\\ -3 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}4 \\\\ -1 \\\\ 2\\end{bmatrix}‖}_{4} \\\\  & ={(|5-4{|}^{4}+|-3-(-1){|}^{4}+|4-2{|}^{4})}^{1/4} \\\\  & ={33}^{1/4} \\\\  & ≈2.397.\\end{aligned}\n$$"] [17592186518138 "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖\\begin{bmatrix}1 \\\\ 4 \\\\ -2\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 5 \\\\ 3\\end{bmatrix}‖}_{1} \\\\  & =|1-2|+|4-5|+|-2-3| \\\\  & =7.\\end{aligned}\n$$"] [17592186518140 "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}‖}_{2} \\\\  & =\\sqrt{|2-5{|}^{2}+|6-3{|}^{2}} \\\\  & =\\sqrt{18} \\\\  & ≈4.243.\\end{aligned}\n$$"] [17592186518161 "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖\\begin{bmatrix}7 \\\\ 6 \\\\ -2\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 2 \\\\ 4\\end{bmatrix}‖}_{\\infty } \\\\  & =max(|7-(-1)|,|6-2|,|-2-4|) \\\\  & =max(8,4,6) \\\\  & =8.\\end{aligned}\n$$"] [17592186518162 "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖\\begin{bmatrix}0 \\\\ -6\\end{bmatrix}-\\begin{bmatrix}0.5 \\\\ -7\\end{bmatrix}‖}_{\\infty } \\\\  & =max(|0-0.5|,|-6-(-7)|) \\\\  & =max(0.5,1) \\\\  & =1.\\end{aligned}\n$$"] [17592186518163 "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖\\begin{bmatrix}-3 \\\\ 5 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 7 \\\\ 4\\end{bmatrix}‖}_{\\infty } \\\\  & =max(|-3-2|,|5-7|,|1-4|) \\\\  & =max(5,2,3) \\\\  & =5.\\end{aligned}\n$$"] [17592186518165 "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖\\begin{bmatrix}4 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}‖}_{2} \\\\  & =\\sqrt{|4-2{|}^{2}+|6-(-2){|}^{2}} \\\\  & =\\sqrt{68} \\\\  & ≈8.246.\\end{aligned}\n$$"] [17592186518171 "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖\\begin{bmatrix}1 \\\\ 4 \\\\ -2\\end{bmatrix}-\\begin{bmatrix}-4 \\\\ -1 \\\\ -2\\end{bmatrix}‖}_{1} \\\\  & =|1-(-4)|+|4-(-1)|+|-2-(-2)| \\\\  & =10.\\end{aligned}\n$$"] [17592186518180 "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖\\begin{bmatrix}2 \\\\ 1 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 3 \\\\ 5\\end{bmatrix}‖}_{2} \\\\  & =\\sqrt{|2-1{|}^{2}+|1-3{|}^{2}+|4-5{|}^{2}} \\\\  & =\\sqrt{6} \\\\  & ≈2.449.\\end{aligned}\n$$"] [17592186518184 "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{3}(a,b) & =‖a-b{‖}_{3} \\\\  & ={‖\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ -1 \\\\ -2\\end{bmatrix}‖}_{3} \\\\  & ={(|1-2{|}^{3}+|1-(-1){|}^{3}+|-1-(-2){|}^{3})}^{1/3} \\\\  & ={10}^{1/3} \\\\  & ≈2.154.\\end{aligned}\n$$"] [17592186518192 "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖\\begin{bmatrix}3 \\\\ 5 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}4 \\\\ -1 \\\\ 6\\end{bmatrix}‖}_{1} \\\\  & =|3-4|+|5-(-1)|+|1-6| \\\\  & =12.\\end{aligned}\n$$"] [17592186518194 "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}‖}_{1} \\\\  & =|1-5|+|-5-1| \\\\  & =10.\\end{aligned}\n$$"] [17592186518198 "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{5}(a,b) & =‖a-b{‖}_{5} \\\\  & ={‖\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}‖}_{5} \\\\  & ={(|3-2{|}^{5}+|1-2{|}^{5})}^{1/5} \\\\  & ={2}^{1/5} \\\\  & ≈1.149.\\end{aligned}\n$$"] [17592186518202 "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix}‖}_{2} \\\\  & =\\sqrt{|-1-2{|}^{2}+|1-3{|}^{2}+|0-1{|}^{2}} \\\\  & =\\sqrt{14} \\\\  & ≈3.742.\\end{aligned}\n$$"] [17592186518208 "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}-\\begin{bmatrix}9 \\\\ -9\\end{bmatrix}‖}_{\\infty } \\\\  & =max(|5-9|,|3-(-9)|) \\\\  & =max(4,12) \\\\  & =12.\\end{aligned}\n$$"] [17592186518219 "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖\\begin{bmatrix}7 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}‖}_{1} \\\\  & =|7-3|+|4-(-2)| \\\\  & =10.\\end{aligned}\n$$"] [17592186518220 "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{6}(a,b) & =‖a-b{‖}_{6} \\\\  & ={‖\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 0 \\\\ 2\\end{bmatrix}‖}_{6} \\\\  & ={(|2-3{|}^{6}+|-1-0{|}^{6}+|1-2{|}^{6})}^{1/6} \\\\  & ={3}^{1/6} \\\\  & ≈1.201.\\end{aligned}\n$$"] [17592186522781 "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $$\n\\displaystyle \\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{4} \\\\ \\text{dim(Col}(A)) &=4=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since \n\n$$\n\\text{Null}(A)=\\{\\begin{bmatrix}{x}_{1} \\\\ 2{x}_{1} \\\\ -3{x}_{1} \\\\ -4{x}_{1}\\end{bmatrix}\\,|\\,{x}_{1}\\in R\\}=\\text{Span}\\{\\,\\begin{bmatrix}1 \\\\ 2 \\\\ -3 \\\\ -4\\end{bmatrix}\\}\n$$\n\n \nwe have that $\\text{nullity}(A)=1.$\n\nNow,  for the matrix $A,$ the number of columns is $n=4,$ so according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+1 & =4 \\\\ \\text{rank}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is false. Since $\\text{rank}(A)=3\\ne 4,$ then, by the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{4}.$\n\n- Statement III is true. Indeed, since $\\text{rank}(A)=3\\ne 4$, according to the  invertible matrix theorem $A$ can't be an invertible matrix.\n\nTherefore, the correct answer is \"I and III only.\""] [17592186529336 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨3\\left({u}^{2}+1\\right),\\,4\\left({v}^{3}+1\\right),\\,2\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(2\\left(2u+v\\right))⟩ \\\\  & =⟨6 u,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(2\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,12 v^{2},\\,2⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 3\\left(2u\\right) & 0 & 2\\left(2\\right) \\\\ 0 & 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 2\\left(2\\right) \\\\ 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}3\\left(2u\\right) & 2\\left(2\\right) \\\\ 0 & 2\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}3\\left(2u\\right) & 0 \\\\ 0 & 4\\left(3{v}^{2}\\right)\\end{vmatrix}⟩ \\\\  & =⟨- 48 v^{2},\\,- 12 u,\\,72 u v^{2}⟩.\\end{aligned}\n$$"] [17592186529341 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨{u}^{2}+1,\\,3\\left({v}^{3}+1\\right),\\,4\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}({u}^{2}+1),\\,\\frac{∂}{∂u}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(4\\left(2u+v\\right))⟩ \\\\  & =⟨2u,\\,0,\\,8⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}({u}^{2}),\\,\\frac{∂}{∂v}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(4\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,9 v^{2},\\,4⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2u & 0 & 4\\left(2\\right) \\\\ 0 & 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 4\\left(2\\right) \\\\ 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}2u & 4\\left(2\\right) \\\\ 0 & 4\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}2u & 0 \\\\ 0 & 3\\left(3{v}^{2}\\right)\\end{vmatrix}⟩ \\\\  & =⟨- 72 v^{2},\\,- 8 u,\\,18 u v^{2}⟩.\\end{aligned}\n$$"] [17592186529345 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨2 u + 2 v,\\,3 v^{2} + 3 \\sin{(u )},\\,u v⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2 u + 2 v),\\,\\frac{∂}{∂u}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂u}(u v)⟩ \\\\  & =⟨2,\\,3 \\cos{(u )},\\,v⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2 u + 2 v),\\,\\frac{∂}{∂v}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂v}(u v)⟩ \\\\  & =⟨2,\\,6 v,\\,u⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 \\cos{(u )} & v \\\\ 2 & 6 v & u\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}3 \\cos{(u )} & v \\\\ 6 v & u\\end{vmatrix},\\,-\\begin{vmatrix}2 & v \\\\ 2 & u\\end{vmatrix},\\,\\begin{vmatrix}2 & 3 \\cos{(u )} \\\\ 2 & 6 v\\end{vmatrix}⟩ \\\\  & =⟨(3 \\cos{(u )})(u)-(v)(6 v),\\,-[(2)(u)-(v)(2)],\\,(2)(6 v)-(3 \\cos{(u )})(2)⟩ \\\\  & =⟨3 u \\cos{(u )} - 6 v^{2},\\,- 2 u + 2 v,\\,12 v - 6 \\cos{(u )}⟩.\\end{aligned}\n$$"] [17592186529348 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨4\\left({u}^{2}+1\\right),\\,4\\left({v}^{3}+1\\right),\\,2\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(4\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(2\\left(2u+v\\right))⟩ \\\\  & =⟨8 u,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(4\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(2\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,12 v^{2},\\,2⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 4\\left(2u\\right) & 0 & 2\\left(2\\right) \\\\ 0 & 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 2\\left(2\\right) \\\\ 4\\left(3{v}^{2}\\right) & 2\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}4\\left(2u\\right) & 2\\left(2\\right) \\\\ 0 & 2\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}4\\left(2u\\right) & 0 \\\\ 0 & 4\\left(3{v}^{2}\\right)\\end{vmatrix}⟩ \\\\  & =⟨- 48 v^{2},\\,- 16 u,\\,96 u v^{2}⟩.\\end{aligned}\n$$"] [17592186529356 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨2\\left(u\\right),\\,3\\left(v\\right),\\,4\\left(u-{e}^{v}\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2\\left(u\\right)),\\,\\frac{∂}{∂u}(3\\left(v\\right)),\\,\\frac{∂}{∂u}(4\\left(u-{e}^{v}\\right))⟩ \\\\  & =⟨2,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2\\left(u\\right)),\\,\\frac{∂}{∂v}(3\\left(v\\right)),\\,\\frac{∂}{∂v}(4\\left(u-{e}^{v}\\right))⟩ \\\\  & =⟨0,\\,3,\\,- 4 e^{v}⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2\\left(1\\right) & 0 & 4\\left(1\\right) \\\\ 0 & 3\\left(1\\right) & 4\\left(-{e}^{v}\\right)\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 4\\left(1\\right) \\\\ 3\\left(1\\right) & 4\\left(-{e}^{v}\\right)\\end{vmatrix},\\,-\\begin{vmatrix}2\\left(1\\right) & 4\\left(1\\right) \\\\ 0 & 4\\left(-{e}^{v}\\right)\\end{vmatrix},\\,\\begin{vmatrix}2\\left(1\\right) & 0 \\\\ 0 & 3\\left(1\\right)\\end{vmatrix}⟩ \\\\  & =⟨-12,\\,8 e^{v},\\,6⟩.\\end{aligned}\n$$"] [17592186529359 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3\\left(u\\right)),\\,\\frac{∂}{∂u}(u\\operatorname{sin}⁡v),\\,\\frac{∂}{∂u}(v\\operatorname{cos}⁡u)⟩ \\\\  & =⟨3,\\,\\operatorname{sin}⁡v,\\,-v\\operatorname{sin}⁡u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3\\left(u\\right)),\\,\\frac{∂}{∂v}(u\\operatorname{sin}⁡v),\\,\\frac{∂}{∂v}(v\\operatorname{cos}⁡u)⟩ \\\\  & =⟨