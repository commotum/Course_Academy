\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨2 uv - u - v,\\,uv,\\,u + v⟩\\cdot ⟨1 - 2 v,\\,1 - 2 u,\\,1⟩ \\\\  & =(2 uv - u - v)\\cdot (1 - 2 v)+(uv)\\cdot (1 - 2 u)+(u + v)\\cdot (1) \\\\  & =- 4 uv^{2} + 4 uv - u + 2 v^{2} - v- 2 u^{2} v + uv+u + v \\\\  & =- 2 u^{2} v - 4 uv^{2} + 5 uv + 2 v^{2}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨z,\\,xy,\\,x + y⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A. \\\\  & ={∬}_{D}(- 2 u^{2} v - 4 uv^{2} + 5 uv + 2 v^{2})\\,\\text{d}A \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{3}(- 2 u^{2} v - 4 uv^{2} + 5 uv + 2 v^{2})\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$"] [17592186533036 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,- 2 u^{2} - v^{2}⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,1\\le u\\le 4,\\,-1\\le v\\le 2\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(- 2 u^{2} - v^{2})⟩ \\\\  & =⟨1,\\,0,\\,- 4 u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(- 2 u^{2} - v^{2})⟩ \\\\  & =⟨0,\\,1,\\,- 2 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & - 4 u \\\\ 0 & 1 & - 2 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & - 4 u \\\\ 1 & - 2 v\\end{vmatrix},\\,-\\begin{vmatrix}1 & - 4 u \\\\ 0 & - 2 v\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}\\right\\rangle  \\\\  & =⟨4 u,\\,2 v,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨x + y,\\,2 x + y,\\,- z - 1⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=- 2 u^{2} - v^{2}} \\\\  & =⟨u + v,\\,2 u + v,\\,- (- 2 u^{2} - v^{2}) - 1⟩ \\\\  & =⟨u + v,\\,2 u + v,\\,2 u^{2} + v^{2} - 1⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨u + v,\\,2 u + v,\\,2 u^{2} + v^{2} - 1⟩\\cdot ⟨4 u,\\,2 v,\\,1⟩ \\\\  & =(u + v)\\cdot (4 u)+(2 u + v)\\cdot (2 v)+(2 u^{2} + v^{2} - 1)\\cdot (1) \\\\  & =4 u^{2} + 4 uv+4 uv + 2 v^{2}+2 u^{2} + v^{2} - 1 \\\\  & =6 u^{2} + 8 uv + 3 v^{2} - 1.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨x + y,\\,2 x + y,\\,- z - 1⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A. \\\\  & ={∬}_{D}(6 u^{2} + 8 uv + 3 v^{2} - 1)\\,\\text{d}A \\\\  & ={\\int }_{1}^{4}{\\int }_{-1}^{2}(6 u^{2} + 8 uv + 3 v^{2} - 1)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$"] [17592186533048 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,- u^{2} - 2 v^{2}⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-3\\le u\\le 4,\\,-2\\le v\\le 4\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(- u^{2} - 2 v^{2})⟩ \\\\  & =⟨1,\\,0,\\,- 2 u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(- u^{2} - 2 v^{2})⟩ \\\\  & =⟨0,\\,1,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & - 2 u \\\\ 0 & 1 & - 4 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & - 2 u \\\\ 1 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}1 & - 2 u \\\\ 0 & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}\\right\\rangle  \\\\  & =⟨2 u,\\,4 v,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨3 x - y,\\,- x + 3 y,\\,z + 1⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=- u^{2} - 2 v^{2}} \\\\  & =⟨3 u - v,\\,- u + 3 v,\\,(- u^{2} - 2 v^{2}) + 1⟩ \\\\  & =⟨3 u - v,\\,- u + 3 v,\\,- u^{2} - 2 v^{2} + 1⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3 u - v,\\,- u + 3 v,\\,- u^{2} - 2 v^{2} + 1⟩\\cdot ⟨2 u,\\,4 v,\\,1⟩ \\\\  & =(3 u - v)\\cdot (2 u)+(- u + 3 v)\\cdot (4 v)+(- u^{2} - 2 v^{2} + 1)\\cdot (1) \\\\  & =6 u^{2} - 2 uv- 4 uv + 12 v^{2}- u^{2} - 2 v^{2} + 1 \\\\  & =5 u^{2} - 6 uv + 10 v^{2} + 1.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨3 x - y,\\,- x + 3 y,\\,z + 1⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A. \\\\  & ={∬}_{D}(5 u^{2} - 6 uv + 10 v^{2} + 1)\\,\\text{d}A \\\\  & ={\\int }_{-3}^{4}{\\int }_{-2}^{4}(5 u^{2} - 6 uv + 10 v^{2} + 1)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$"] [17592186533051 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,2 u^{2} + v^{2}⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,0\\le u\\le 3,\\,0\\le v\\le 4\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(2 u^{2} + v^{2})⟩ \\\\  & =⟨1,\\,0,\\,4 u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(2 u^{2} + v^{2})⟩ \\\\  & =⟨0,\\,1,\\,2 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 4 u \\\\ 0 & 1 & 2 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 4 u \\\\ 1 & 2 v\\end{vmatrix},\\,-\\begin{vmatrix}1 & 4 u \\\\ 0 & 2 v\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 4 u,\\,- 2 v,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨x + 2 y,\\,2 x + 3 y,\\,2 z - 2⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=2 u^{2} + v^{2}} \\\\  & =⟨u + 2 v,\\,2 u + 3 v,\\,2 (2 u^{2} + v^{2}) - 2⟩ \\\\  & =⟨u + 2 v,\\,2 u + 3 v,\\,4 u^{2} + 2 v^{2} - 2⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨u + 2 v,\\,2 u + 3 v,\\,4 u^{2} + 2 v^{2} - 2⟩\\cdot ⟨- 4 u,\\,- 2 v,\\,1⟩ \\\\  & =(u + 2 v)\\cdot (- 4 u)+(2 u + 3 v)\\cdot (- 2 v)+(4 u^{2} + 2 v^{2} - 2)\\cdot (1) \\\\  & =- 4 u^{2} - 8 uv- 4 uv - 6 v^{2}+4 u^{2} + 2 v^{2} - 2 \\\\  & =- 12 uv - 4 v^{2} - 2.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨x + 2 y,\\,2 x + 3 y,\\,2 z - 2⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A. \\\\  & ={∬}_{D}(- 12 uv - 4 v^{2} - 2)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{4}(- 12 uv - 4 v^{2} - 2)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$"] [17592186533059 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,2 u^{2} - 2 v^{2}⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,0\\le u\\le 4,\\,0\\le v\\le 3\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(2 u^{2} - 2 v^{2})⟩ \\\\  & =⟨1,\\,0,\\,4 u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(2 u^{2} - 2 v^{2})⟩ \\\\  & =⟨0,\\,1,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 4 u \\\\ 0 & 1 & - 4 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & 4 u \\\\ 1 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}1 & 4 u \\\\ 0 & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- 4 u,\\,4 v,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨3 x - y,\\,- 2 x + y,\\,- z - 2⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=2 u^{2} - 2 v^{2}} \\\\  & =⟨3 u - v,\\,- 2 u + v,\\,- (2 u^{2} - 2 v^{2}) - 2⟩ \\\\  & =⟨3 u - v,\\,- 2 u + v,\\,- 2 u^{2} + 2 v^{2} - 2⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3 u - v,\\,- 2 u + v,\\,- 2 u^{2} + 2 v^{2} - 2⟩\\cdot ⟨- 4 u,\\,4 v,\\,1⟩ \\\\  & =(3 u - v)\\cdot (- 4 u)+(- 2 u + v)\\cdot (4 v)+(- 2 u^{2} + 2 v^{2} - 2)\\cdot (1) \\\\  & =- 12 u^{2} + 4 uv- 8 uv + 4 v^{2}- 2 u^{2} + 2 v^{2} - 2 \\\\  & =- 14 u^{2} - 4 uv + 6 v^{2} - 2.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨3 x - y,\\,- 2 x + y,\\,- z - 2⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A. \\\\  & ={∬}_{D}(- 14 u^{2} - 4 uv + 6 v^{2} - 2)\\,\\text{d}A \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{3}(- 14 u^{2} - 4 uv + 6 v^{2} - 2)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$"] [17592186533067 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,uv + u - v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,1\\le u\\le 2,\\,-1\\le v\\le 4\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(uv + u - v)⟩ \\\\  & =⟨1,\\,0,\\,v + 1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(uv + u - v)⟩ \\\\  & =⟨0,\\,1,\\,u - 1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & v + 1 \\\\ 0 & 1 & u - 1\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & v + 1 \\\\ 1 & u - 1\\end{vmatrix},\\,-\\begin{vmatrix}1 & v + 1 \\\\ 0 & u - 1\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}\\right\\rangle  \\\\  & =⟨- v - 1,\\,1 - u,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨2 z,\\,xy,\\,x + y⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=uv + u - v} \\\\  & =⟨2 (uv + u - v),\\,uv,\\,u + v⟩ \\\\  & =⟨2 uv + 2 u - 2 v,\\,uv,\\,u + v⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨2 uv + 2 u - 2 v,\\,uv,\\,u + v⟩\\cdot ⟨- v - 1,\\,1 - u,\\,1⟩ \\\\  & =(2 uv + 2 u - 2 v)\\cdot (- v - 1)+(uv)\\cdot (1 - u)+(u + v)\\cdot (1) \\\\  & =- 2 uv^{2} - 4 uv - 2 u + 2 v^{2} + 2 v- u^{2} v + uv+u + v \\\\  & =- u^{2} v - 2 uv^{2} - 3 uv - u + 2 v^{2} + 3 v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨2 z,\\,xy,\\,x + y⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A. \\\\  & ={∬}_{D}(- u^{2} v - 2 uv^{2} - 3 uv - u + 2 v^{2} + 3 v)\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{-1}^{4}(- u^{2} v - 2 uv^{2} - 3 uv - u + 2 v^{2} + 3 v)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$"] [17592186533986 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}3{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=3{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=3(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $$\n\\displaystyle x=\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}\n$$ and $$\n\\displaystyle y=\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix},\n$$ we get\n\n$$\n{∇}_{A}L=3\\left(\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 5\\end{bmatrix}\\right)=3\\left(\\begin{bmatrix}2 & 10 \\\\ -1 & -5 \\\\ 3 & 15\\end{bmatrix}\\right)=\\begin{bmatrix}6 & 30 \\\\ -3 & -15 \\\\ 9 & 45\\end{bmatrix}.\n$$"] [17592186534008 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{3}3{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=3{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=3(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $$\n\\displaystyle x=\\begin{bmatrix}-2 \\\\ 3 \\\\ 7\\end{bmatrix}\n$$ and $$\n\\displaystyle y=\\begin{bmatrix}2 \\\\ -5\\end{bmatrix},\n$$ we get\n\n$$\n{∇}_{A}L=3\\left(\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 3 & 7\\end{bmatrix}\\right)=3\\left(\\begin{bmatrix}-4 & 6 & 14 \\\\ 10 & -15 & -35\\end{bmatrix}\\right)=\\begin{bmatrix}-12 & 18 & 42 \\\\ 30 & -45 & -105\\end{bmatrix}.\n$$"] [17592186534022 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{3}.$ Then, $L(A)=\\frac{1}{2}{y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{3}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}(\\frac{1}{2}{y}^{T}y)=y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}={y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{3}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $$\n\\displaystyle A=\\begin{bmatrix}3 & 0 \\\\ -1 & -1 \\\\ 2 & 2\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =y\\cdot {x}^{T} \\\\  & =(Ax-b)\\cdot {x}^{T} \\\\  & =\\left(\\begin{bmatrix}3 & 0 \\\\ -1 & -1 \\\\ 2 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 7\\end{bmatrix}-\\begin{bmatrix}10 \\\\ -2 \\\\ 5\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}0 & 7\\end{bmatrix} \\\\  & =\\left(\\begin{bmatrix}0 \\\\ -7 \\\\ 14\\end{bmatrix}-\\begin{bmatrix}10 \\\\ -2 \\\\ 5\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}0 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 \\\\ -5 \\\\ 9\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -70 \\\\ 0 & -35 \\\\ 0 & 63\\end{bmatrix}.\\end{aligned}\n$$"] [17592186534034 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}2{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=2{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=2(y{x}^{T}).$\n\nEvaluating at the given values $$\n\\displaystyle x=\\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}\n$$ and $$\n\\displaystyle y=\\begin{bmatrix}6 \\\\ 0 \\\\ 1\\end{bmatrix},\n$$ we get\n\n$$\n{∇}_{A}L=2\\left(\\begin{bmatrix}6 \\\\ 0 \\\\ 1\\end{bmatrix}\\begin{bmatrix}-3 & 7\\end{bmatrix}\\right)=2\\left(\\begin{bmatrix}-18 & 42 \\\\ 0 & 0 \\\\ -3 & 7\\end{bmatrix}\\right)=\\begin{bmatrix}-36 & 84 \\\\ 0 & 0 \\\\ -6 & 14\\end{bmatrix}.\n$$"] [17592186534071 "Since we have a repeated eigenvalue $\\lambda =-2$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =-2,\\,v=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},\\,w=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}{e}^{-2t}+{c}_{2}\\left(\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}t{e}^{-2t}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{-2t}\\right) \\\\  & ={c}_{1}{e}^{-2t}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}+{c}_{2}{e}^{-2t}\\begin{bmatrix}t \\\\ -t+1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $$\n\\displaystyle v=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$ has the equation \n\n$$\ny=-x\n$$\n\nand the straight-line solutions of the form\n$$\n\\displaystyle {c}_{1}{e}^{-2t}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$\nlie on that line. \n\nSince ${e}^{-2t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/45/4522e4e6ed382e821aaa47d40a191135161f95eef276b6e8ba3a8514e6bfdfd8.png)\n\nNow, consider solutions of the form\n$$\n\\displaystyle {c}_{2}{e}^{-2t}\\begin{bmatrix}t \\\\ -t+1\\end{bmatrix}.\n$$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\left\\{\\begin{aligned}x=t{e}^{-2t} \\\\ y=(-t+1){e}^{-2t}\\end{aligned}\\right.\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-1.36$ | $0$ | $0.18$ |\n| $y$ | $4.08$ | $1$ | $0.18$ |\n\nLet's add the solutions to the phase space.\n\n![](images/db/dbf5a13ecd5e81c399204fd29d235e410fcb62274555cf3e5b32a383c1078d24.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/13/13a57f14ea65118473c24c6eb1dbf50a0461060201ced051bb2eb6776f5daf64.png)"] [17592186534073 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{2}.$ Then, $L(A)={y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}({y}^{T}y)=2y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=2{y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}{x}_{j}..\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is $2$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=2y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $$\n\\displaystyle A=\\begin{bmatrix}0 & 1 \\\\ 2 & 3\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =2y\\cdot {x}^{T} \\\\  & =2(Ax-b)\\cdot {x}^{T} \\\\  & =2\\left(\\begin{bmatrix}0 & 1 \\\\ 2 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}1 & -2\\end{bmatrix} \\\\  & =2\\left(\\begin{bmatrix}-2 \\\\ -4\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 \\\\ -18\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 & 20 \\\\ -18 & 36\\end{bmatrix}.\\end{aligned}\n$$"] [17592186534080 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{3}.$ Then, $L(A)={y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{3}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}({y}^{T}y)=2y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=2{y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{3}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is $2$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=2y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $$\n\\displaystyle A=\\begin{bmatrix}1 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =2y\\cdot {x}^{T} \\\\  & =2(Ax-b)\\cdot {x}^{T} \\\\  & =2\\left(\\begin{bmatrix}1 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}8 \\\\ 0 \\\\ 2\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}4 & 4\\end{bmatrix} \\\\  & =2\\left(\\begin{bmatrix}8 \\\\ -4 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}8 \\\\ 0 \\\\ 2\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -8 \\\\ 4\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -32 & -32 \\\\ 16 & 16\\end{bmatrix}.\\end{aligned}\n$$"] [17592186534082 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=2Ax-b\\in {R}^{2}.$ Then, $L(A)={y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}({y}^{T}y)=2y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=2{y}_{k}.\n$$\n\nWriting out $y=2Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}=2{\\sum }_{j=1}^{3}{a}_{ij}{x}_{j}-{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=2{x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot 2{x}_{j} \\\\  & =4{y}_{i}{x}_{j}\\end{aligned}\n$$\n\n The $(i,j)$th entry of ${∇}_{A}L$ is $4$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=4y\\cdot {x}^{T}.\n$$\n\n Finally, evaluating ${∇}_{A}L$ at $$\n\\displaystyle A=\\begin{bmatrix}0 & 1 & 1 \\\\ 4 & 0 & -3\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =4y\\cdot {x}^{T} \\\\  & =4(2Ax-b)\\cdot {x}^{T} \\\\  & =4\\left(2\\begin{bmatrix}0 & 1 & 1 \\\\ 4 & 0 & -3\\end{bmatrix}\\begin{bmatrix}10 \\\\ 10 \\\\ -5\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}10 & 10 & -5\\end{bmatrix} \\\\  & =4\\left(\\begin{bmatrix}10 \\\\ 110\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}10 & 10 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}48 \\\\ 428\\end{bmatrix}\\cdot \\begin{bmatrix}10 & 10 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}480 & 480 & -240 \\\\ 4280 & 4280 & -2140\\end{bmatrix}.\\end{aligned}\n$$"] [17592186536842 "Recall that the mean-deviation form of the observation matrix\n\n$$\nX=\\begin{bmatrix}| & | &  & | \\\\ {x}_{1} & {x}_{2} & ⋯ & {x}_{n} \\\\ | & | &  & |\\end{bmatrix}\n$$\n\nis given by \n\n$$\nB=\\begin{bmatrix}| & | &  & | \\\\ {b}_{1} & {b}_{2} & ⋯ & {b}_{n} \\\\ | & | &  & |\\end{bmatrix}\n$$\n\nwhere ${b}_{i}={x}_{i}-m$ for $i=1,2,…,n,$ and $m$ is sample mean vector.\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=\\begin{bmatrix}-5 \\\\ 7\\end{bmatrix},\\,{x}_{2}=\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix},\\,{x}_{3}=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}.\n$$\n\nAs a result, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}\\left(\\begin{bmatrix}-5 \\\\ 7\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}\\right) \\\\  & =\\frac{1}{3}\\begin{bmatrix}-6 \\\\ 12\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=\\begin{bmatrix}-5 \\\\ 7\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ 3\\end{bmatrix} \\\\ {b}_{2} & ={x}_{2}-m=\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\ {b}_{3} & ={x}_{3}-m=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=\\begin{bmatrix}-3 & -1 & 4 \\\\ 3 & 1 & -4\\end{bmatrix}.\n$$"] [17592186536875 "Recall that the mean-deviation form of the observation matrix\n\n$$\nX=\\begin{bmatrix}| & | &  & | \\\\ {x}_{1} & {x}_{2} & ⋯ & {x}_{n} \\\\ | & | &  & |\\end{bmatrix}\n$$\n\nis given by \n\n$$\nB=\\begin{bmatrix}| & | &  & | \\\\ {b}_{1} & {b}_{2} & ⋯ & {b}_{n} \\\\ | & | &  & |\\end{bmatrix}\n$$\n\nwhere ${b}_{i}={x}_{i}-m$ for $i=1,2,…,n,$ and $m$ is sample mean vector.\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=\\begin{bmatrix}2 \\\\ 7\\end{bmatrix},\\,{x}_{2}=\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix},\\,{x}_{3}=\\begin{bmatrix}3 \\\\ 9\\end{bmatrix}.\n$$\n\nAs a result, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}\\left(\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 9\\end{bmatrix}\\right) \\\\  & =\\frac{1}{3}\\begin{bmatrix}3 \\\\ 21\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 7\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\ {b}_{2} & ={x}_{2}-m=\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 7\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ -2\\end{bmatrix} \\\\ {b}_{3} & ={x}_{3}-m=\\begin{bmatrix}3 \\\\ 9\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 7\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & -2 & 2\\end{bmatrix}.\n$$"] [17592186536884 "Recall that  the sample covariance matrix is given by\n\n$$\nC=\\frac{1}{n-1}B{B}^{T},\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nSo, we first need to compute the mean-deviation form of our observation matrix.\n\nThe sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}\\left(\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}6 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}5 \\\\ 6\\end{bmatrix}\\right) \\\\  & =\\frac{1}{3}\\begin{bmatrix}15 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ -4\\end{bmatrix} \\\\ {b}_{2} & ={x}_{2}-m=\\begin{bmatrix}6 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\ {b}_{3} & ={x}_{3}-m=\\begin{bmatrix}5 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=\\begin{bmatrix}-1 & 1 & 0 \\\\ -4 & -1 & 5\\end{bmatrix}.\n$$\n\nFinally, the sample covariance matrix is \n\n$$\n\\begin{aligned}C & =\\frac{1}{3-1}\\begin{bmatrix}-1 & 1 & 0 \\\\ -4 & -1 & 5\\end{bmatrix}\\begin{bmatrix}-1 & -4 \\\\ 1 & -1 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & 3 \\\\ 3 & 42\\end{bmatrix}.\\end{aligned}\n$$"] [17592186537904 "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{bmatrix}\\,⇒\\,{A}^{T}=\\begin{bmatrix}1 & 1 & -4 \\\\ 1 & -1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{bmatrix}\\cdot {\\left(\\begin{bmatrix}1 & 1 & -4 \\\\ 1 & -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{bmatrix}\\right)}^{-1}\\cdot \\begin{bmatrix}1 & 1 & -4 \\\\ 1 & -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 \\\\ -10 \\\\ 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}18 & -4 \\\\ -4 & 3\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}-48 \\\\ 17\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{bmatrix}\\cdot \\frac{1}{38}\\begin{bmatrix}3 & 4 \\\\ 4 & 18\\end{bmatrix}\\cdot \\begin{bmatrix}-48 \\\\ 17\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -5 \\\\ 11\\end{bmatrix}\\end{aligned}\n$$"] [17592186537968 "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace $S$ spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{v,w\\}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ v & w \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}3 & -2 & -2 \\\\ 1 & 1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{bmatrix}\\cdot {\\left(\\begin{bmatrix}3 & -2 & -2 \\\\ 1 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{bmatrix}\\right)}^{-1}\\cdot \\begin{bmatrix}3 & -2 & -2 \\\\ 1 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ -6 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}17 & -1 \\\\ -1 & 3\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}16 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{bmatrix}\\cdot \\frac{1}{50}\\begin{bmatrix}3 & 1 \\\\ 1 & 17\\end{bmatrix}\\cdot \\begin{bmatrix}16 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ -1 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"] [17592186540048 "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-2b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={\\left(\\frac{\\text{d}L}{\\text{d}x}\\right)}^{T}={\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{T}\\cdot {\\left(\\frac{\\text{d}L}{\\text{d}y}\\right)}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-2b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{T}\\cdot {\\left(\\frac{\\text{d}L}{\\text{d}y}\\right)}^{T} \\\\  & ={A}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $$\n\\displaystyle x=\\begin{bmatrix}1 \\\\ 4\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot 2y \\\\  & =2\\cdot {A}^{T}(Ax-2b) \\\\  & =2\\cdot {\\begin{bmatrix}3 & 2 \\\\ -1 & 1 \\\\ 1 & 2\\end{bmatrix}}^{T}\\left(\\begin{bmatrix}3 & 2 \\\\ -1 & 1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 4\\end{bmatrix}-2\\cdot \\begin{bmatrix}1 \\\\ 3 \\\\ 5\\end{bmatrix}\\right) \\\\  & =2\\cdot \\begin{bmatrix}3 & -1 & 1 \\\\ 2 & 1 & 2\\end{bmatrix}\\left(\\begin{bmatrix}11 \\\\ 3 \\\\ 9\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 6 \\\\ 10\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}6 & -2 & 2 \\\\ 4 & 2 & 4\\end{bmatrix}\\begin{bmatrix}9 \\\\ -3 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}58 \\\\ 26\\end{bmatrix}.\\end{aligned}\n$$"] [17592186542139 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=4Ax-5b\\in {R}^{2}.$ Then, $L(A)={y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}({y}^{T}y)=2y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=2{y}_{k}.\n$$\n\nWriting out $y=4Ax-5b$ in component-wise notation as \n\n$$\n{y}_{i}=4{\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-5{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=4{x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot 4{x}_{j} \\\\  & =8{y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is $8$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=8y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $$\n\\displaystyle A=\\begin{bmatrix}1 & 1 \\\\ 0 & -1\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =8y\\cdot {x}^{T} \\\\  & =8(4Ax-5b)\\cdot {x}^{T} \\\\  & =8\\left(4\\begin{bmatrix}1 & 1 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}-5\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}0 & 4\\end{bmatrix} \\\\  & =8\\left(\\begin{bmatrix}16 \\\\ -16\\end{bmatrix}-\\begin{bmatrix}-10 \\\\ 15\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}208 \\\\ -248\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 832 \\\\ 0 & -992\\end{bmatrix}.\\end{aligned}\n$$"] [17592186542179 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{2}.$ Then, $L(A)=\\frac{1}{2}{y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}(\\frac{1}{2}{y}^{T}y)=y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}={y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $$\n\\displaystyle A=\\begin{bmatrix}1 & 0 \\\\ 2 & -1\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =y\\cdot {x}^{T} \\\\  & =(Ax-b)\\cdot {x}^{T} \\\\  & =\\left(\\begin{bmatrix}1 & 0 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 4\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}2 & 3\\end{bmatrix} \\\\  & =\\left(\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 4\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 9 \\\\ -6 & -9\\end{bmatrix}.\\end{aligned}\n$$"] [17592186542190 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{2}{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=2(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $$\n\\displaystyle x=\\begin{bmatrix}9 \\\\ 0\\end{bmatrix}\n$$ and $$\n\\displaystyle y=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},\n$$ we get\n\n$$\n{∇}_{A}L=2\\left(\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}9 & 0\\end{bmatrix}\\right)=2\\left(\\begin{bmatrix}9 & 0 \\\\ -9 & 0\\end{bmatrix}\\right)=\\begin{bmatrix}18 & 0 \\\\ -18 & 0\\end{bmatrix}.\n$$"] [17592186544996 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨2u-v,\\,3u+2,\\,u+2v⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2u-v),\\,\\frac{∂}{∂u}(3u+2),\\,\\frac{∂}{∂u}(u+2v)⟩ \\\\  & =⟨2,\\,3,\\,1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2u-v),\\,\\frac{∂}{∂v}(3u+2),\\,\\frac{∂}{∂v}(u+2v)⟩ \\\\  & =⟨-1,\\,0,\\,2⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 & 1 \\\\ -1 & 0 & 2\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}3 & 1 \\\\ 0 & 2\\end{vmatrix},\\,-\\begin{vmatrix}2 & 1 \\\\ -1 & 2\\end{vmatrix},\\,\\begin{vmatrix}2 & 3 \\\\ -1 & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨6,\\,-5,\\,3⟩,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨6,\\,-5,\\,3⟩‖ \\\\  & =\\sqrt{{6}^{2}+(-5)^{2}+{3}^{2}} \\\\  & =\\sqrt{36+25+9} \\\\  & =\\sqrt{70}.\\end{aligned}\n$$\n\nNext, let's denote\n\n$$\nD={(u,v)\\,:\\,0\\le u\\le 5,\\,-1\\le v\\le 1}.\n$$\n\nThen, the surface area is\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\sqrt{70}\\,\\text{d}A \\\\  & =\\sqrt{70}{∬}_{D}\\text{ }\\,\\text{d}A \\\\  & =\\sqrt{70}\\cdot \\text{Area}(D) \\\\  & =\\sqrt{70}\\cdot 5\\cdot 2 \\\\  & =10 \\sqrt{70}.\\end{aligned}\n$$"] [17592186545007 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(-u+v),\\,\\frac{∂}{∂u}(u-2v),\\,\\frac{∂}{∂u}(3v)⟩ \\\\  & =⟨-1,\\,1,\\,0⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(-u+v),\\,\\frac{∂}{∂v}(u-2v),\\,\\frac{∂}{∂v}(3v)⟩ \\\\  & =⟨1,\\,-2,\\,3⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ -1 & 1 & 0 \\\\ 1 & -2 & 3\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}1 & 0 \\\\ -2 & 3\\end{vmatrix},\\,-\\begin{vmatrix}-1 & 0 \\\\ 1 & 3\\end{vmatrix},\\,\\begin{vmatrix}-1 & 1 \\\\ 1 & -2\\end{vmatrix}\\right\\rangle  \\\\  & =⟨3,\\,3,\\,1⟩,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨3,\\,3,\\,1⟩‖ \\\\  & =\\sqrt{{3}^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{9+9+1} \\\\  & =\\sqrt{19}.\\end{aligned}\n$$\n\nNext, notice that the region ${u}^{2}+{v}^{2}\\le 20$ corresponds to the disk\n\n$$\nD={(u,v)\\,:\\,{u}^{2}+{v}^{2}\\le 20},\n$$\n\nof radius $2 \\sqrt{5}.$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\sqrt{19}\\,\\text{d}A \\\\  & =\\sqrt{19}{∬}_{D}\\text{d}A \\\\  & =\\sqrt{19}\\cdot \\text{Area}(D) \\\\  & =\\sqrt{19}\\cdot (\\pi \\cdot (2 \\sqrt{5})^{2}) \\\\  & =20 \\sqrt{19} \\pi.\\end{aligned}\n$$"] [17592186549018 "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\lambda =7.$ So, we get \n\n$$\n\\begin{aligned}A-\\lambda I & =\\begin{bmatrix}7 & 0 & 0 \\\\ 1 & 11 & -1 \\\\ 2 & 8 & 5\\end{bmatrix}-7\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & 4 & -1 \\\\ 2 & 8 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nTo find the eigenvectors, we have to solve the corresponding homogeneous system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}0=0 \\\\ {x}_{1}+4{x}_{2}-{x}_{3}=0 \\\\ 2{x}_{1}+8{x}_{2}-2{x}_{3}=0\\end{aligned}\\right.\n$$\n\nSo, we row-reduce the augmented matrix $M$ to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}0 & 0 & 0 & 0 \\\\ 1 & 4 & -1 & 0 \\\\ 2 & 8 & -2 & 0\\end{array}\\right] &  & {R}_{1}↔{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}2 & 8 & -2 & 0 \\\\ 1 & 4 & -1 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] &  & {R}_{2}:={R}_{2}+\\left(-\\frac{1}{2}\\right){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}2 & 8 & -2 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ and ${x}_{3}$ are free variables. From the first equation, we obtain ${x}_{1}=-4{x}_{2}+{x}_{3}.$ So, the general solution is\n\n$$\n\\begin{bmatrix}-4{x}_{2}+{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}\\begin{bmatrix}-4 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{2},{x}_{3}\\in R.\n$$\n\nTherefore, the required basis is\n\n$$\nB=\\left\\{\\begin{bmatrix}-4 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\\right\\}.\n$$"] [17592186549172 "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}A-(B-C) & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\left(\\begin{bmatrix}9 & -1 \\\\ 0 & 7\\end{bmatrix}-\\begin{bmatrix}0 & 0 \\\\ 0 & -9\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9-0 & -1-0 \\\\ 0-0 & 7-(-9)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9 & -1 \\\\ 0 & 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9-9 & -9-(-1) \\\\ -1-0 & -7-16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & -8 \\\\ -1 & -23\\end{bmatrix}.\\end{aligned}\n$$"] [17592186549181 "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}A+(B-C) & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+\\left(\\begin{bmatrix}-9 & -1 \\\\ 8 & 6\\end{bmatrix}-\\begin{bmatrix}3 & 6 \\\\ -7 & -4\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+\\begin{bmatrix}-9-3 & -1-6 \\\\ 8-(-7) & 6-(-4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+\\begin{bmatrix}-12 & -7 \\\\ 15 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-12) & 8+(-7) \\\\ 1+15 & -4+10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-11 & 1 \\\\ 16 & 6\\end{bmatrix}.\\end{aligned}\n$$"] [17592186549186 "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}C-(D-E) & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-\\left(\\begin{bmatrix}4 & 6 \\\\ 7 & 5\\end{bmatrix}-\\begin{bmatrix}-2 & 0 \\\\ -9 & -2\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-\\begin{bmatrix}4-(-2) & 6-0 \\\\ 7-(-9) & 5-(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-\\begin{bmatrix}6 & 6 \\\\ 16 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2-6 & -4-6 \\\\ 8-16 & -1-7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8 & -10 \\\\ -8 & -8\\end{bmatrix}.\\end{aligned}\n$$"] [17592186549924 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{2}.$ Then, $L(A)=2{y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}(2{y}^{T}y)=4y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=4{y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i}.\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =4{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =4{y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is $4$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x,$ so\n\n$$\n{∇}_{A}L=4y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $$\n\\displaystyle A=\\begin{bmatrix}1 & 1 \\\\ 1 & -1\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =4y\\cdot {x}^{T} \\\\  & =4(Ax-b)\\cdot {x}^{T} \\\\  & =4\\left(\\begin{bmatrix}1 & 1 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}10 \\\\ 10\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}10 & 10\\end{bmatrix} \\\\  & =4\\left(\\begin{bmatrix}20 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\right)\\cdot \\begin{bmatrix}10 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}76 \\\\ -4\\end{bmatrix}\\cdot \\begin{bmatrix}10 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}760 & 760 \\\\ -40 & -40\\end{bmatrix}.\\end{aligned}\n$$"] [17592186549972 "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{3}2{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=2{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=2(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $$\n\\displaystyle x=\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix}\n$$ and $$\n\\displaystyle y=\\begin{bmatrix}1 \\\\ 7\\end{bmatrix},\n$$ we get\n\n$$\n{∇}_{A}L=2\\left(\\begin{bmatrix}1 \\\\ 7\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -1 & 0\\end{bmatrix}\\right)=2\\left(\\begin{bmatrix}2 & -1 & 0 \\\\ 14 & -7 & 0\\end{bmatrix}\\right)=\\begin{bmatrix}4 & -2 & 0 \\\\ 28 & -14 & 0\\end{bmatrix}.\n$$"] [17592186549979 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}({v}^{2}),\\,\\frac{∂}{∂u}(uv)⟩ \\\\  & =⟨1,\\,0,\\,v⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}({v}^{2}),\\,\\frac{∂}{∂v}(uv)⟩ \\\\  & =⟨0,\\,2v,\\,u⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & v \\\\ 0 & 2v & u\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}0 & v \\\\ 2v & u\\end{vmatrix},\\,-\\begin{vmatrix}1 & v \\\\ 0 & u\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 2v\\end{vmatrix}\\right\\rangle  \\\\  & =⟨-2{v}^{2},\\,-u,\\,2v⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨x,\\,y,\\,xz⟩{|}_{x=u\\,y={v}^{2}\\,z=uv} \\\\  & =⟨u,\\,{v}^{2},\\,{u}^{2}v⟩.\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨u,\\,{v}^{2},\\,{u}^{2}v⟩\\cdot ⟨-2{v}^{2},\\,-u,\\,2v⟩ \\\\  & =u\\cdot (-2{v}^{2})+{v}^{2}\\cdot (-u)+{u}^{2}v\\cdot 2v \\\\  & =-2u{v}^{2}-u{v}^{2}+2{u}^{2}{v}^{2} \\\\  & =2{u}^{2}{v}^{2}-3u{v}^{2}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}2\\cdot {u}^{2}{v}^{2}+(-3)\\cdot u{v}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=2-3=-1.\n$$"] [17592186551242 "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{3}(a,b) & =‖a-b{‖}_{3} \\\\  & ={\\left\\|\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\right\\|}_{3} \\\\  & ={(|3-1{|}^{3}+|2-0{|}^{3})}^{1/3} \\\\  & ={16}^{1/3} \\\\  & ≈2.520.\\end{aligned}\n$$"] [17592186551272 "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={\\left\\|\\begin{bmatrix}4 \\\\ 3 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 3 \\\\ 4\\end{bmatrix}\\right\\|}_{4} \\\\  & ={(|4-5{|}^{4}+|3-3{|}^{4}+|1-4{|}^{4})}^{1/4} \\\\  & ={82}^{1/4} \\\\  & ≈3.009.\\end{aligned}\n$$"] [17592186551313 "Since we have a repeated eigenvalue $\\lambda =3$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =3,\\,v=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,w=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{3t}+{c}_{2}\\left(\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}t{e}^{3t}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t}\\right) \\\\  & ={c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{3t}\\begin{bmatrix}t \\\\ 1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n$$\n\\displaystyle {c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\nlie on the $x\\text{-axis}.$ Since ${e}^{3t}\\to \\infty $ as $t\\to \\infty ,$ these solutions move toward $\\text{infinity}$ in the phase plane as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/98/98fc60d566b520f3d943e42ee8f4e07aa0bdd33b53fbb04981c2e8f4001210fd.png)\n\nNow, consider solutions of the form\n$$\n\\displaystyle {c}_{2}{e}^{3t}\\begin{bmatrix}t \\\\ 1\\end{bmatrix}.\n$$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\left\\{\\begin{aligned}x=t{e}^{3t} \\\\ y={e}^{3t}\\end{aligned}\\right.\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.11$ | $0$ | $2.24$ |\n| $y$ | $0.22$ | $1$ | $4.48$ |\n\nLet's add the solutions to the phase space.\n\n![](images/ee/eed535cfbba657a10aa37ffd90c4de36ae85e5acfa6e44b1790ec3372da10c3c.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/4e/4eaab4510bb15a7207aedaf37bff252132f62550d5dc62373aea0b506b7b0611.png)"] [17592186551331 "Since we have a repeated eigenvalue $\\lambda =4$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =4,\\,v=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,w=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{4t}+{c}_{2}\\left(\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}t{e}^{4t}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{4t}\\right) \\\\  & ={c}_{1}{e}^{4t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{4t}\\begin{bmatrix}t \\\\ 1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n$$\n\\displaystyle {c}_{1}{e}^{4t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\nlie on the $x\\text{-axis}.$ Since ${e}^{4t}\\to \\infty $ as $t\\to \\infty ,$ these solutions move toward $\\text{infinity}$ in the phase plane as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/27/27e921a76383c4f8a4fc1e81a1febcfad53f330d0e902f4e07578238da33422f.png)\n\nNow, consider solutions of the form\n$$\n\\displaystyle {c}_{2}{e}^{4t}\\begin{bmatrix}t \\\\ 1\\end{bmatrix}.\n$$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\left\\{\\begin{aligned}x=t{e}^{4t} \\\\ y={e}^{4t}\\end{aligned}\\right.\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.4$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.07$ | $0$ | $1.98$ |\n| $y$ | $0.14$ | $1$ | $4.95$ |\n\nLet's add the solutions to the phase space.\n\n![](images/fd/fd431b8daf3ad9c1b25225af9d64b1e4876e4e1a90e1dfd010de8ed134ae323c.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/1f/1fd20f7333800323c44f41d7906958a0928d5f30279e36b1f50d0ca1f66fcd46.png)"] [17592186551338 "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={\\left\\|\\begin{bmatrix}2 \\\\ -7 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}-3 \\\\ -1 \\\\ 5\\end{bmatrix}\\right\\|}_{\\infty } \\\\  & =max(|2-(-3)|,|-7-(-1)|,|1-5|) \\\\  & =max(5,6,4) \\\\  & =6.\\end{aligned}\n$$"] [17592186552433 "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=\\frac{1}{2}Ax-b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={\\left(\\frac{\\text{d}L}{\\text{d}x}\\right)}^{T}={\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{T}\\cdot {\\left(\\frac{\\text{d}L}{\\text{d}y}\\right)}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}Ax-b)=\\frac{1}{2}A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{T}\\cdot {\\left(\\frac{\\text{d}L}{\\text{d}y}\\right)}^{T} \\\\  & ={(\\frac{1}{2}A)}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $$\n\\displaystyle x=\\begin{bmatrix}7 \\\\ 2\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{1}{2}A)}^{T}\\cdot 2y \\\\  & ={A}^{T}(\\frac{1}{2}Ax-b) \\\\  & ={\\begin{bmatrix}2 & 1 \\\\ 4 & 3\\end{bmatrix}}^{T}\\left(\\frac{1}{2}\\cdot \\begin{bmatrix}2 & 1 \\\\ 4 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}7 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 1 & 3\\end{bmatrix}\\left(\\frac{1}{2}\\cdot \\begin{bmatrix}16 \\\\ 34\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 1 & 3\\end{bmatrix}\\left(\\begin{bmatrix}8 \\\\ 17\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}3 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}62 \\\\ 45\\end{bmatrix}.\\end{aligned}\n$$"] [17592186552476 "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={\\left(\\frac{\\text{d}L}{\\text{d}x}\\right)}^{T}={\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{T}\\cdot {\\left(\\frac{\\text{d}L}{\\text{d}y}\\right)}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}^{T}\\cdot {\\left(\\frac{\\text{d}L}{\\text{d}y}\\right)}^{T} \\\\  & ={A}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $$\n\\displaystyle x=\\begin{bmatrix}3 \\\\ -1\\end{bmatrix},\n$$ we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot 2y \\\\  & =2\\cdot {A}^{T}(Ax-b) \\\\  & =2\\cdot {\\begin{bmatrix}1 & 2 \\\\ 4 & 0\\end{bmatrix}}^{T}\\left(\\begin{bmatrix}1 & 2 \\\\ 4 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\\right) \\\\  & =2\\cdot \\begin{bmatrix}1 & 4 \\\\ 2 & 0\\end{bmatrix}\\left(\\begin{bmatrix}1 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}2 & 8 \\\\ 4 & 0\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}52 \\\\ -8\\end{bmatrix}.\\end{aligned}\n$$"] [17592186553539 "To shift the system's equilibrium from ${x}^{∗}$ to the origin, we define the deviation vector\n\n$$\nu=x-{x}^{∗}.\n$$\n\nIn our case, we have\n\n$$\nu=x-\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\,⇒\\,x=u+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\,\\text{and}\\,{x}^{′}={u}^{′}.\n$$\n\nSubstituting $x$ and ${x}^{′}$ into the given system, we obtain\n\n$$\n\\begin{aligned}{x}^{′} & =\\begin{bmatrix}2 & -1 \\\\ 3 & 0\\end{bmatrix}x+\\begin{bmatrix}-1 \\\\ -3\\end{bmatrix} \\\\ {u}^{′} & =\\begin{bmatrix}2 & -1 \\\\ 3 & 0\\end{bmatrix}\\left(u+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\right)+\\begin{bmatrix}-1 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 3 & 0\\end{bmatrix}u+\\begin{bmatrix}2 & -1 \\\\ 3 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 3 & 0\\end{bmatrix}u+\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 3 & 0\\end{bmatrix}u.\\end{aligned}\n$$\n\nTherefore, the shifted system is\n\n$$\n{u}^{′}=\\begin{bmatrix}2 & -1 \\\\ 3 & 0\\end{bmatrix}u.\n$$"] [17592186553563 "To shift the system's equilibrium from ${x}^{∗}$ to the origin, we define the deviation vector\n\n$$\nu=x-{x}^{∗}.\n$$\n\nIn our case, we have\n\n$$\nu=x-\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\,⇒\\,x=u+\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\,\\text{and}\\,{x}^{′}={u}^{′}.\n$$\n\nSubstituting $x$ and ${x}^{′}$ into the given system, we obtain\n\n$$\n\\begin{aligned}{x}^{′} & =\\begin{bmatrix}3 & 1 \\\\ -2 & 2\\end{bmatrix}x+\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\ {u}^{′} & =\\begin{bmatrix}3 & 1 \\\\ -2 & 2\\end{bmatrix}\\left(u+\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\right)+\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 1 \\\\ -2 & 2\\end{bmatrix}u+\\begin{bmatrix}3 & 1 \\\\ -2 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 1 \\\\ -2 & 2\\end{bmatrix}u+\\begin{bmatrix}5 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 1 \\\\ -2 & 2\\end{bmatrix}u.\\end{aligned}\n$$\n\nTherefore, the shifted system is\n\n$$\n{u}^{′}=\\begin{bmatrix}3 & 1 \\\\ -2 & 2\\end{bmatrix}u.\n$$"] [17592186554573 "First, we find the orthogonal projection matrix onto ${S}^{⊥}=\\text{Span}\\{a\\}.$\n\nUsing the formula for the orthogonal projection matrix\n\n$$\n{P}_{{S}^{⊥}}=a({a}^{T}\\,a)^{-1}{a}^{T},\n$$\n\nwe obtain the following:\n\n$$\n\\begin{aligned}{P}_{{S}^{⊥}} & =\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}{\\left(\\begin{bmatrix}1 & -1 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}\\right)}^{-1}\\begin{bmatrix}1 & -1 & 2\\end{bmatrix} \\\\  & ={6}^{-1}\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}\\begin{bmatrix}1 & -1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}1 & -1 & 2 \\\\ -1 & 1 & -2 \\\\ 2 & -2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nRecall that ${P}_{S}+{P}_{{S}^{⊥}}=I.$ Therefore, \n\n$$\n\\begin{aligned}{P}_{S} & =I-{P}_{{S}^{⊥}} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}-\\frac{1}{6}\\begin{bmatrix}1 & -1 & 2 \\\\ -1 & 1 & -2 \\\\ 2 & -2 & 4\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}5 & 1 & -2 \\\\ 1 & 5 & 2 \\\\ -2 & 2 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, ${p}_{12}+{p}_{33}=1+2=3.$"] [17592186555847 "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation\n\n$$\n{x}_{1}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+{x}_{2}\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+{x}_{3}\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nis true if and only if ${x}_{1}={x}_{2}={x}_{3}=0.$ So the set is linearly independent.\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 0 & 2\\end{bmatrix}=2\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+3\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+0\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\n- Statement III is false. For example, the matrix $$\n\\displaystyle \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$ can't be written as a linear combination of \n\n$$\n\\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\right\\}\n$$\n\nsince all these linear combinations result in matrices with the entry ${a}_{11}={a}_{22}:$\n\n$$\na\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+b\\cdot \\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+c\\cdot \\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}a & b \\\\ c & a\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"I and II only.\""] [17592186557213 "Recall that the matrix ${P}_{S}=A({A}^{T}\\,A)^{-1}\\,{A}^{T}$ maps any vector $x\\in {R}^{n}$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nIn our case, $$\n\\displaystyle A=\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$ Therefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}{\\left(\\begin{bmatrix}-1 & 1 & 2\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}\\right)}^{-1}\\begin{bmatrix}-1 & 1 & 2\\end{bmatrix} \\\\  & ={6}^{-1}\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}\\begin{bmatrix}-1 & 1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}1 & -1 & -2 \\\\ -1 & 1 & 2 \\\\ -2 & 2 & 4\\end{bmatrix}.\\end{aligned}\n$$"] [17592186557283 "To find the matrices $L$ and $U,$ we reduce the matrix $M$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $M$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}5 & 10 & 0 \\\\ 1 & 0 & -2 \\\\ 0 & 3 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\left(-\\frac{1}{5}\\right){R}_{1} & ⟺ & \\,\\overbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{{E}_{1}}\\cdot M \\\\  & ∼\\begin{bmatrix}5 & 10 & 0 \\\\ 0 & -2 & -2 \\\\ 0 & 3 & -3\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\left(\\frac{3}{2}\\right){R}_{2} & ⟺ & \\,\\overbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{bmatrix}}^{{E}_{2}}\\cdot {E}_{1}\\cdot M \\\\  & ∼\\begin{bmatrix}5 & 10 & 0 \\\\ 0 & -2 & -2 \\\\ 0 & 0 & -6\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}M=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}M & =U \\\\ {E}_{1}M & ={E}_{2}^{-1}U \\\\ M & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ M & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{bmatrix}}^{-1}U \\\\ M & =\\left(\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{bmatrix}\\right)U \\\\ M & =\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{bmatrix}}_{L}\\underbrace{\\begin{bmatrix}5 & 10 & 0 \\\\ 0 & -2 & -2 \\\\ 0 & 0 & -6\\end{bmatrix}}_{U}\\end{aligned}\n$$"] [17592186557317 "Applying ${R}_{2}:={R}_{2}+1\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+(-2)\\cdot {R}_{1}$ is equivalent to multiplying $H$ from the left by the following elementary matrices:\n\n$$\n\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}}_{{E}_{2}}\\cdot \\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{{E}_{1}}\\cdot H=U\n$$\n\nNow, since ${E}_{2}{E}_{1}H=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}H & =U \\\\ {E}_{1}H & ={E}_{2}^{-1}U \\\\ H & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ H & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ H & =\\left(\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\\right)U \\\\ H & =\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}}_{L}\\cdot U\\end{aligned}\n$$"] [17592186558981 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n\\iint_S\\mathrm{d}S=\\iint_D\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\|\\,\\mathrm{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}\\mathbf r_u &=\\langle \\frac{\\partial x}{\\partial u},\\,\\frac{\\partial y}{\\partial u},\\,\\frac{\\partial z}{\\partial u}\\rangle \\\\  &=\\langle \\frac{\\partial}{\\partial u}\\left(u + v\\right),\\,\\frac{\\partial}{\\partial u}\\left(3 - v\\right),\\,\\frac{\\partial}{\\partial u}\\left(3 u + 5 v + 1\\right)\\rangle \\\\  &=\\langle 1,\\,0,\\,3\\rangle \\\\ \\mathbf r_v &=\\langle \\frac{\\partial x}{\\partial v},\\,\\frac{\\partial y}{\\partial v},\\,\\frac{\\partial z}{\\partial v}\\rangle \\\\  &=\\langle \\frac{\\partial}{\\partial v}\\left(u + v\\right),\\,\\frac{\\partial}{\\partial v}\\left(3 - v\\right),\\,\\frac{\\partial}{\\partial v}\\left(3 u + 5 v + 1\\right)\\rangle \\\\  &=\\langle 1,\\,-1,\\,5\\rangle\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}\\mathbf r_u\\times\\mathbf r_v &=\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 3 \\\\ 1 & -1 & 5\\end{vmatrix} \\\\  &=\\left\\langle \\begin{vmatrix}0 & 3 \\\\ -1 & 5\\end{vmatrix},\\,-\\begin{vmatrix}1 & 3 \\\\ 1 & 5\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 1 & -1\\end{vmatrix}\\right\\rangle \\\\  &=\\langle 3,\\,-2,\\,-1\\rangle\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\| &=\\left\\|\\langle 3,\\,-2,\\,-1\\rangle\\right\\| \\\\  &=\\sqrt{\\left(3\\right)^2+\\left(-2\\right)^2+\\left(-1\\right)^2} \\\\  &=\\sqrt{9+4+1} \\\\  &=\\sqrt{14} \\\\  &=\\sqrt{14}\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}\\iint_S\\mathrm{d}S &=\\iint_D\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\|\\,\\mathrm{d}A \\\\  &=\\iint_D \\sqrt{14}\\,\\mathrm{d}A\\end{aligned}\n$$"] [17592186558989 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n\\iint_S\\mathrm{d}S=\\iint_D\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\|\\,\\mathrm{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}\\mathbf r_u &=\\langle \\frac{\\partial x}{\\partial u},\\,\\frac{\\partial y}{\\partial u},\\,\\frac{\\partial z}{\\partial u}\\rangle \\\\  &=\\langle \\frac{\\partial}{\\partial u}\\left(2 u^{2}\\right),\\,\\frac{\\partial}{\\partial u}\\left(u - v^{2}\\right),\\,\\frac{\\partial}{\\partial u}\\left(v^{2}\\right)\\rangle \\\\  &=\\langle 4 u,\\,1,\\,0\\rangle \\\\ \\mathbf r_v &=\\langle \\frac{\\partial x}{\\partial v},\\,\\frac{\\partial y}{\\partial v},\\,\\frac{\\partial z}{\\partial v}\\rangle \\\\  &=\\langle \\frac{\\partial}{\\partial v}\\left(2 u^{2}\\right),\\,\\frac{\\partial}{\\partial v}\\left(u - v^{2}\\right),\\,\\frac{\\partial}{\\partial v}\\left(v^{2}\\right)\\rangle \\\\  &=\\langle 0,\\,- 2 v,\\,2 v\\rangle\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}\\mathbf r_u\\times\\mathbf r_v &=\\begin{vmatrix}i & j & k \\\\ 4 u & 1 & 0 \\\\ 0 & - 2 v & 2 v\\end{vmatrix} \\\\  &=\\left\\langle \\begin{vmatrix}1 & 0 \\\\ - 2 v & 2 v\\end{vmatrix},\\,-\\begin{vmatrix}4 u & 0 \\\\ 0 & 2 v\\end{vmatrix},\\,\\begin{vmatrix}4 u & 1 \\\\ 0 & - 2 v\\end{vmatrix}\\right\\rangle \\\\  &=\\langle 2 v,\\,- 8 u v,\\,- 8 u v\\rangle\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\| &=\\left\\|\\langle 2 v,\\,- 8 u v,\\,- 8 u v\\rangle\\right\\| \\\\  &=\\sqrt{\\left(2 v\\right)^2+\\left(- 8 u v\\right)^2+\\left(- 8 u v\\right)^2} \\\\  &=\\sqrt{4 v^{2}+64 u^{2} v^{2}+64 u^{2} v^{2}} \\\\  &=\\sqrt{128 u^{2} v^{2} + 4 v^{2}} \\\\  &=\\sqrt{4 v^{2} \\left(32 u^{2} + 1\\right)} \\\\  &=\\sqrt{4 v^{2}}\\sqrt{32 u^{2} + 1} \\\\  &=2 v \\sqrt{32 u^{2} + 1}\\end{aligned}\n$$\n\nNotice that $\\sqrt{v^2}=v$ since $v\\ge 0$ on $D.$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}\\iint_S\\mathrm{d}S &=\\iint_D\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\|\\,\\mathrm{d}A \\\\  &=\\iint_D 2 v \\sqrt{32 u^{2} + 1}\\,\\mathrm{d}A\\end{aligned}\n$$"] [17592186558993 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n\\iint_S\\mathrm{d}S=\\iint_D\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\|\\,\\mathrm{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}\\mathbf r_u &=\\langle \\frac{\\partial x}{\\partial u},\\,\\frac{\\partial y}{\\partial u},\\,\\frac{\\partial z}{\\partial u}\\rangle \\\\  &=\\langle \\frac{\\partial}{\\partial u}\\left(u + v\\right),\\,\\frac{\\partial}{\\partial u}\\left(3 - v\\right),\\,\\frac{\\partial}{\\partial u}\\left(5 u + 7 v + 1\\right)\\rangle \\\\  &=\\langle 1,\\,0,\\,5\\rangle \\\\ \\mathbf r_v &=\\langle \\frac{\\partial x}{\\partial v},\\,\\frac{\\partial y}{\\partial v},\\,\\frac{\\partial z}{\\partial v}\\rangle \\\\  &=\\langle \\frac{\\partial}{\\partial v}\\left(u + v\\right),\\,\\frac{\\partial}{\\partial v}\\left(3 - v\\right),\\,\\frac{\\partial}{\\partial v}\\left(5 u + 7 v + 1\\right)\\rangle \\\\  &=\\langle 1,\\,-1,\\,7\\rangle\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}\\mathbf r_u\\times\\mathbf r_v &=\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 5 \\\\ 1 & -1 & 7\\end{vmatrix} \\\\  &=\\left\\langle \\begin{vmatrix}0 & 5 \\\\ -1 & 7\\end{vmatrix},\\,-\\begin{vmatrix}1 & 5 \\\\ 1 & 7\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 1 & -1\\end{vmatrix}\\right\\rangle \\\\  &=\\langle 5,\\,-2,\\,-1\\rangle\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\| &=\\left\\|\\langle 5,\\,-2,\\,-1\\rangle\\right\\| \\\\  &=\\sqrt{\\left(5\\right)^2+\\left(-2\\right)^2+\\left(-1\\right)^2} \\\\  &=\\sqrt{25+4+1} \\\\  &=\\sqrt{30} \\\\  &=\\sqrt{30}\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}\\iint_S\\mathrm{d}S &=\\iint_D\\left\\|\\mathbf r_u\\times\\mathbf r_v\\right\\|\\,\\mathrm{d}A \\\\  &=\\iint_D \\sqrt{30}\\,\\mathrm{d}A\\end{aligned}\n$$"] [17592186560320 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2 u v),\\,\\frac{∂}{∂u}(- 3 u),\\,\\frac{∂}{∂u}(2 u - 2 v^{2})⟩ \\\\  & =⟨2 v,\\,-3,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2 u v),\\,\\frac{∂}{∂v}(- 3 u),\\,\\frac{∂}{∂v}(2 u - 2 v^{2})⟩ \\\\  & =⟨2 u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 v & -3 & 2 \\\\ 2 u & 0 & - 4 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}-3 & 2 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}2 v & 2 \\\\ 2 u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}2 v & -3 \\\\ 2 u & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨12 v,\\,4 u + 8 v^{2},\\,6 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨12 v,\\,4 u + 8 v^{2},\\,6 u⟩‖ \\\\  & =\\sqrt{(12 v)^{2}+(4 u + 8 v^{2})^{2}+(6 u)^{2}} \\\\  & =\\sqrt{52 u^{2} + 64 u v^{2} + 64 v^{4} + 144 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(3 x - y^{2} z)\\,{|}_{x=2 u v\\,y=- 3 u\\,z=2 u - 2 v^{2}} \\\\  & =6 u v-1\\cdot (- 3 u)^{2}\\cdot (2 u - 2 v^{2}) \\\\  & =- 18 u^{3} + 18 u^{2} v^{2} + 6 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 18 u^{3} + 18 u^{2} v^{2} + 6 u v\\right) \\sqrt{52 u^{2} + 64 u v^{2} + 64 v^{4} + 144 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"] [17592186560324 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u v),\\,\\frac{∂}{∂u}(- 3 u),\\,\\frac{∂}{∂u}(3 u - 2 v^{2})⟩ \\\\  & =⟨v,\\,-3,\\,3⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u v),\\,\\frac{∂}{∂v}(- 3 u),\\,\\frac{∂}{∂v}(3 u - 2 v^{2})⟩ \\\\  & =⟨u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ v & -3 & 3 \\\\ u & 0 & - 4 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}-3 & 3 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}v & 3 \\\\ u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}v & -3 \\\\ u & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨12 v,\\,3 u + 4 v^{2},\\,3 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨12 v,\\,3 u + 4 v^{2},\\,3 u⟩‖ \\\\  & =\\sqrt{(12 v)^{2}+(3 u + 4 v^{2})^{2}+(3 u)^{2}} \\\\  & =\\sqrt{18 u^{2} + 24 u v^{2} + 16 v^{4} + 144 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(x - 3 y^{2} z)\\,{|}_{x=u v\\,y=- 3 u\\,z=3 u - 2 v^{2}} \\\\  & =u v-3\\cdot (- 3 u)^{2}\\cdot (3 u - 2 v^{2}) \\\\  & =- 81 u^{3} + 54 u^{2} v^{2} + u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 81 u^{3} + 54 u^{2} v^{2} + u v\\right) \\sqrt{18 u^{2} + 24 u v^{2} + 16 v^{4} + 144 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"] [17592186560328 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2 u v),\\,\\frac{∂}{∂u}(- u),\\,\\frac{∂}{∂u}(3 u - v^{2})⟩ \\\\  & =⟨2 v,\\,-1,\\,3⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2 u v),\\,\\frac{∂}{∂v}(- u),\\,\\frac{∂}{∂v}(3 u - v^{2})⟩ \\\\  & =⟨2 u,\\,0,\\,- 2 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 v & -1 & 3 \\\\ 2 u & 0 & - 2 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}-1 & 3 \\\\ 0 & - 2 v\\end{vmatrix},\\,-\\begin{vmatrix}2 v & 3 \\\\ 2 u & - 2 v\\end{vmatrix},\\,\\begin{vmatrix}2 v & -1 \\\\ 2 u & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨2 v,\\,6 u + 4 v^{2},\\,2 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨2 v,\\,6 u + 4 v^{2},\\,2 u⟩‖ \\\\  & =\\sqrt{(2 v)^{2}+(6 u + 4 v^{2})^{2}+(2 u)^{2}} \\\\  & =\\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(x - y^{2} z)\\,{|}_{x=2 u v\\,y=- u\\,z=3 u - v^{2}} \\\\  & =2 u v-1\\cdot (- u)^{2}\\cdot (3 u - v^{2}) \\\\  & =- 3 u^{3} + u^{2} v^{2} + 2 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 3 u^{3} + u^{2} v^{2} + 2 u v\\right) \\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"] [17592186560333 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3 u v),\\,\\frac{∂}{∂u}(- u),\\,\\frac{∂}{∂u}(2 u - 2 v^{2})⟩ \\\\  & =⟨3 v,\\,-1,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3 u v),\\,\\frac{∂}{∂v}(- u),\\,\\frac{∂}{∂v}(2 u - 2 v^{2})⟩ \\\\  & =⟨3 u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 3 v & -1 & 2 \\\\ 3 u & 0 & - 4 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}-1 & 2 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}3 v & 2 \\\\ 3 u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}3 v & -1 \\\\ 3 u & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨4 v,\\,6 u + 12 v^{2},\\,3 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨4 v,\\,6 u + 12 v^{2},\\,3 u⟩‖ \\\\  & =\\sqrt{(4 v)^{2}+(6 u + 12 v^{2})^{2}+(3 u)^{2}} \\\\  & =\\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(2 x - y^{2} z)\\,{|}_{x=3 u v\\,y=- u\\,z=2 u - 2 v^{2}} \\\\  & =6 u v-1\\cdot (- u)^{2}\\cdot (2 u - 2 v^{2}) \\\\  & =- 2 u^{3} + 2 u^{2} v^{2} + 6 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 2 u^{3} + 2 u^{2} v^{2} + 6 u v\\right) \\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"] [17592186560336 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u v),\\,\\frac{∂}{∂u}(- 3 u),\\,\\frac{∂}{∂u}(2 u - 2 v^{2})⟩ \\\\  & =⟨v,\\,-3,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u v),\\,\\frac{∂}{∂v}(- 3 u),\\,\\frac{∂}{∂v}(2 u - 2 v^{2})⟩ \\\\  & =⟨u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ v & -3 & 2 \\\\ u & 0 & - 4 v\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}-3 & 2 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}v & 2 \\\\ u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}v & -3 \\\\ u & 0\\end{vmatrix}\\right\\rangle  \\\\  & =⟨12 v,\\,2 u + 4 v^{2},\\,3 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨12 v,\\,2 u + 4 v^{2},\\,3 u⟩‖ \\\\  & =\\sqrt{(12 v)^{2}+(2 u + 4 v^{2})^{2}+(3 u)^{2}} \\\\  & =\\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(2 x - 2 y^{2} z)\\,{|}_{x=u v\\,y=- 3 u\\,z=2 u - 2 v^{2}} \\\\  & =2 u v-2\\cdot (- 3 u)^{2}\\cdot (2 u - 2 v^{2}) \\\\  & =- 36 u^{3} + 36 u^{2} v^{2} + 2 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 36 u^{3} + 36 u^{2} v^{2} + 2 u v\\right) \\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"] [17592186562414 "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{bmatrix}\\right\\}.\n$$\n\nTherefore, for ${\\text{M}}_{3\\times 9}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{3\\times 9}(R))=3\\cdot 9=27.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"] [17592186562429 "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{bmatrix}\\right\\}.\n$$\n\nTherefore, for ${\\text{M}}_{4\\times 9}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{4\\times 9}(R))=4\\cdot 9=36.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"] [17592186562436 "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=\\begin{bmatrix}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{bmatrix}.\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2)) & =\\operatorname{ln}⁡\\left(\\begin{bmatrix}{J}_{2}(2) & 0 \\\\ 0 & {J}_{1}(2)\\end{bmatrix}\\right) \\\\  & =\\begin{bmatrix}\\operatorname{ln}⁡({J}_{2}(2)) & 0 \\\\ 0 & \\operatorname{ln}⁡({J}_{1}(2))\\end{bmatrix} \\\\  & =\\operatorname{ln}⁡({J}_{2}(2))\\,⊕\\,\\operatorname{ln}⁡({J}_{1}(2)).\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{2}(2),$ we have $n=2$ and $\\lambda =2.$ \\since $n=2,$ we need to compute the first derivative of $f$ only:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡x \\\\ {f}^{′}(x) & =\\frac{1}{x}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{2}(2)) & =\\begin{bmatrix}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{ln}⁡(2) & \\frac{1}{2} \\\\ 0 & \\operatorname{ln}⁡(2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{ln}⁡2 & \\frac{1}{2} \\\\ 0 & \\operatorname{ln}⁡2\\end{bmatrix}.\\end{aligned}\n$$\n\n- For ${J}_{1}(2),$ we have $n=1$ and $\\lambda =1.$ \\since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(2)) & =\\begin{bmatrix}f(2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{ln}⁡2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2)) & =\\operatorname{ln}⁡({J}_{2}(2))\\,⊕\\,\\operatorname{ln}⁡({J}_{1}(2)) \\\\  & =\\begin{bmatrix}\\operatorname{ln}⁡2 & \\frac{1}{2} & 0 \\\\ 0 & \\operatorname{ln}⁡2 & 0 \\\\ 0 & 0 & \\operatorname{ln}⁡2\\end{bmatrix}.\\end{aligned}\n$$"] [17592186562449 "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}5a-2x & =b \\\\ -2x & =b-5a \\\\ x & =-\\frac{1}{2}(b-5a) \\\\ x & =-\\frac{1}{2}\\left(\\begin{bmatrix}2 \\\\ -1 \\\\ -6 \\\\ -6\\end{bmatrix}-5\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ -2\\end{bmatrix}\\right) \\\\ x & =-\\frac{1}{2}\\begin{bmatrix}-8 \\\\ -6 \\\\ -6 \\\\ 4\\end{bmatrix} \\\\ x & =\\begin{bmatrix}4 \\\\ 3 \\\\ 3 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"] [17592186562451 "The standard basis of ${\\text{M}}_{n}(R)$ contains a total of ${n}^{2}$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{2}(R)$ contains ${2}^{2}=4$ elements, and is given by\n\n$$\n\\left\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\right\\}.\n$$\n\nTherefore, for ${\\text{M}}_{7}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{7}(R))={7}^{2}=49.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.\n$$"] [17592186562468 "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nThus, the standard basis of ${\\text{M}}_{5\\times 1}(R)$ contains $5\\cdot 1=5$ elements, and is given by\n\n$$\n\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix},\\,\\begin{bmatrix}0 \\\\ 1 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix},\\,\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,\\begin{bmatrix}0 \\\\ 0 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,\\begin{bmatrix}0 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{bmatrix}\\right\\}.\n$$\n\nTherefore, for ${\\text{M}}_{5\\times 1}(R),$ we have, indeed, \n\n$$\n\\text{dim}({\\text{M}}_{5\\times 1}(R))=5\\cdot 1=5.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"] [17592186563693 "First, recall that\n\n$$\n\\lim_{s\\to 1}f(s)=\\begin{bmatrix}\\lim_{s\\to 1}\\sqrt{5-s} \\\\ \\lim_{s\\to 1}\\frac{{e}^{1-s}}{1-s} \\\\ \\lim_{s\\to 1}\\,(1+5s)^{1/(2s)}\\end{bmatrix}.\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 1}\\sqrt{5-s} & =\\sqrt{5-1} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 1}\\frac{{e}^{1-s}}{s}=\\frac{1}{1}=1.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}\\lim_{s\\to 1}\\,(1+5s)^{1-s} & =(1+5\\cdot 1)^{1-1}=1.\\end{aligned}\n$$\n\nHence, $$\n\\displaystyle \\lim_{s\\to 1}f(s)=\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $1$ is\n\n$$\n\\begin{aligned}\\lim_{s\\to 1}‖f(s)‖ & =‖\\lim_{s\\to 1}f(s)‖ \\\\  & =\\left\\|\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}\\right\\| \\\\  & =\\sqrt{{2}^{2}+{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$"] [17592186563712 "First, recall that:\n\n$$\n\\lim_{t\\to 3}f(t)=\\begin{bmatrix}\\lim_{t\\to 3}({t}^{2}-3t) \\\\ \\lim_{t\\to 3}\\frac{1}{{t}^{2}-8} \\\\ \\lim_{t\\to 3}(5-2t)\\end{bmatrix}\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have:\n\n$$\n\\begin{aligned}\\lim_{t\\to 3}({t}^{2}-3t) & ={3}^{2}-3(3)=0\\end{aligned}\n$$\n\n- For the second component, we have:\n\n$$\n\\begin{aligned}\\lim_{t\\to 3}\\frac{1}{{t}^{2}-8} & =\\frac{1}{{3}^{2}-8}=1\\end{aligned}\n$$\n\n- For the third component, we have:\n\n$$\n\\begin{aligned}\\lim_{t\\to 3}(5-2t) & =5-2(3)=-1\\end{aligned}\n$$\n\nHence, $$\n\\displaystyle \\lim_{t\\to 3}f(t)=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}.\n$$\n\nFinally, the limit of $‖f(t)‖$ as $t$ approaches $3$ is\n\n$$\n\\begin{aligned}\\lim_{t\\to 3}‖f(t)‖ & =‖\\lim_{t\\to 3}f(t)‖ \\\\  & =\\left\\|\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}\\right\\| \\\\  & =\\sqrt{{0}^{2}+{1}^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}\\,.\\end{aligned}\n$$"] [17592186563716 "First, recall that:\n\n$$\n\\begin{aligned}\\lim_{s\\to 0}f(s) & =\\begin{bmatrix}\\lim_{s\\to 0}\\frac{s}{(s+1)^{2}} \\\\ \\lim_{s\\to 0}\\frac{{sin}^{2}⁡s}{{s}^{2}} \\\\ \\lim_{s\\to 0}\\frac{1-\\operatorname{cos}⁡s}{2{s}^{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have:\n\n$$\n\\begin{aligned}\\lim_{s\\to 0}\\frac{s}{(s+1)^{2}} & =\\frac{0}{(0+1)^{2}}=0\\end{aligned}\n$$\n\n- The second component can be found using a special limit:\n\n$$\n\\begin{aligned}\\lim_{s\\to 0}\\frac{{sin}^{2}⁡s}{{s}^{2}} & =\\lim_{s\\to 0}{\\left(\\frac{\\operatorname{sin}⁡s}{s}\\right)}^{2} \\\\  & ={(\\lim_{s\\to 0}\\frac{\\operatorname{sin}⁡s}{s})}^{2} \\\\  & ={1}^{2} \\\\  & =1\\end{aligned}\n$$\n\n- The third component can be found using L'Hopital's Rule twice:\n\n$$\n\\begin{aligned}\\lim_{s\\to 0}\\frac{1-\\operatorname{cos}⁡s}{2{s}^{2}} & =\\lim_{s\\to 0}\\frac{{(1-\\operatorname{cos}⁡s)}^{″}}{{(2{s}^{2})}^{″}} \\\\  & =\\lim_{s\\to 0}\\frac{\\operatorname{cos}⁡s}{4} \\\\  & =\\frac{\\operatorname{cos}⁡0}{4} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$\n\nHence, $$\n\\displaystyle \\lim_{s\\to 0}f(s)=\\begin{bmatrix}0 \\\\ 1 \\\\ 1/4\\end{bmatrix}\\,.\n$$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $0$ is:\n\n$$\n\\begin{aligned}\\lim_{s\\to 0}‖f(s)‖ & =‖\\lim_{s\\to 0}f(s)‖ \\\\  & =\\left\\|\\begin{bmatrix}0 \\\\ 1 \\\\ 1/4\\end{bmatrix}\\right\\| \\\\  & =\\sqrt{{0}^{2}+{1}^{2}+{\\left(\\frac{1}{4}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{17}{16}} \\\\  & =\\frac{\\sqrt{17}}{4}\\end{aligned}\n$$"] [17592186571404 "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(T) & ={t}_{11}{C}_{11}+{t}_{12}{C}_{12}+{t}_{13}{C}_{13}+{t}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}-10\\cdot {C}_{14} \\\\  & =-10{C}_{14} \\\\  & =-10\\cdot \\begin{vmatrix}∗ & ∗ & ∗ & -10 \\\\ 0 & 4 & 0 & ∗ \\\\ 1 & 3 & 2 & ∗ \\\\ 1 & 2 & 3 & ∗\\end{vmatrix} \\\\  & =-10(-1)^{1+4}\\begin{vmatrix}0 & 4 & 0 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 3\\end{vmatrix} \\\\  & =10\\left(0\\cdot \\begin{vmatrix}3 & 2 \\\\ 2 & 3\\end{vmatrix}-4\\cdot \\begin{vmatrix}1 & 2 \\\\ 1 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}1 & 3 \\\\ 1 & 2\\end{vmatrix}\\right) \\\\  & =10(0-4(1\\cdot 3-1\\cdot 2)+0) \\\\  & =10\\cdot (-4) \\\\  & =-40\\end{aligned}\n$$"]}
