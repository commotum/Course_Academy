#{[{:db/id #edb/ref 17592186416358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29430249-c511-5b3f-b606-e04e258a7382" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{11}" :db/id #edb/ref 17592186416328} {:answer/id #uuid "66516586-cecd-5e63-b1f0-d497a546cd06" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186416334} {:answer/id #uuid "b038fe34-a16a-5a55-bf98-fc3b8439343d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186416342} {:answer/id #uuid "d9c0d55a-c5e9-50c2-8df7-9355a909c1d6" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{10}" :db/id #edb/ref 17592186416346} {:answer/id #uuid "f15ad28f-93e2-5d8b-b5d3-7600366bd867" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186416347}] :answer-field/correct {:db/id #edb/ref 17592186416328} :answer-field/id #uuid "9b507b6b-07ae-51ff-8ef0-2463cc379cda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d93f91c3-07ee-5843-9236-38543eb4a92a" :question/math-academy-id "q-139474" :question/problem "Find the distance between the vector $x$ and the subspace spanned by the linearly independent vectors $\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}-2 \\\\ -1 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,x=\\begin{bmatrix}-2 \\\\ 6 \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have \n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}-2 & -1 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}-2 & -1 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}-2 & -1 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 \\\\ 6 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}6 & -1 \\\\ -1 & 2\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{11}\\begin{bmatrix}2 & 1 \\\\ 1 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=\\hat{x}\\end{aligned}\n$$\n\n \n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\hat{x}) & =‖x-\\hat{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\hat{x}}_{1})^{2}+({x}_{2}-{\\hat{x}}_{2})^{2}+({x}_{3}-{\\hat{x}}_{3})^{2}} \\\\  & =\\sqrt{(-2-0)^{2}+(6-0)^{2}+(2-0)^{2}} \\\\  & =\\sqrt{4+36+4} \\\\  & =\\sqrt{44} \\\\  & =2\\sqrt{11}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186416359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fef03fc-79ed-52dc-bd31-1e9cf734dd91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186416329} {:answer/id #uuid "5170028a-ab43-580a-a8b5-29da72f1fcd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186416333} {:answer/id #uuid "7c4a4aea-dd6d-5e0a-99e0-02a535cf0fc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186416336} {:answer/id #uuid "c52aa776-edc2-57f3-a183-a9201feae1aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186416345} {:answer/id #uuid "f37da0e2-81e8-576a-aa5e-b3594802c8da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186416348}] :answer-field/correct {:db/id #edb/ref 17592186416333} :answer-field/id #uuid "7d5f218f-38ba-531a-af9e-df5b58a66d01" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416352}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6dcfad9-4fa8-567a-ab9a-f61e9f6b1a76" :question/math-academy-id "q-39856" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors $\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix},\\,x=\\begin{bmatrix}4 \\\\ 0 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}A=\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}1 & -1 & -1 \\\\ 1 & -1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}1 & -1 & -1 \\\\ 1 & -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}1 & -1 & -1 \\\\ 1 & -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}3 & 1 \\\\ 1 & 3\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}4 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{bmatrix}\\cdot \\frac{1}{8}\\begin{bmatrix}3 & -1 \\\\ -1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -2 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$  \n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{‖x‖‖{\\text{proj}}_{S}x‖} \\\\  & =\\frac{4\\cdot 2+0\\cdot (-2)+0\\cdot 0}{\\sqrt{{4}^{2}+{0}^{2}+{0}^{2}}\\sqrt{{2}^{2}+(-2)^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{16}\\sqrt{8}} \\\\  & =\\frac{8}{4\\cdot 2\\sqrt{2}} \\\\  & =\\frac{1}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡\\left(\\frac{\\sqrt{2}}{2}\\right)=\\frac{\\pi }{4},\n$$\n\nwhich is already an acute angle."}] [{:db/id #edb/ref 17592186416397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce3ee34-0bbc-5bf1-8519-a5c6f5ca4be2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186416368} {:answer/id #uuid "2dfe1fac-b11a-54dc-b55d-c32d6ffe73e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186416370} {:answer/id #uuid "8ed59ef4-4b16-5d39-970e-9eb55064e9c0" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186416378} {:answer/id #uuid "afc0693e-b8b8-5f98-a567-53b12025e699" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186416381} {:answer/id #uuid "ed2eead7-3610-52a9-8cf6-5173ec43049c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186416387}] :answer-field/correct {:db/id #edb/ref 17592186416370} :answer-field/id #uuid "9715d32b-de54-5e1d-b216-07bf1e7e3fc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416393}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5979cff9-340a-5b78-84fd-5ca3a8c1f370" :question/math-academy-id "q-140374" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 3\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}a & -5 & -9 \\\\ 3 & b & 6 \\\\ 1 & \\frac{4}{3} & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT(\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix})=\\begin{bmatrix}x+y+z \\\\ x+z \\\\ y-z\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix})=\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix})=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\ T({b}_{3}) & =T(\\begin{bmatrix}0 \\\\ 0 \\\\ 3\\end{bmatrix})=\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\left[\\begin{array}{ccc|ccc}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{array}\\right].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|ccc}1 & 2 & 0 & 1 & 1 & 3 \\\\ -1 & -1 & 0 & 2 & 2 & 3 \\\\ 1 & 0 & 3 & -2 & -1 & -3\\end{array}\\right] &  & \\begin{aligned}{R}_{2}:={R}_{1}+{R}_{2} \\\\ {R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 2 & 0 & 1 & 1 & 3 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & -2 & 3 & -3 & -2 & -6\\end{array}\\right] &  & \\begin{aligned}{R}_{1}:={R}_{1}-2{R}_{2} \\\\ {R}_{3}:=2{R}_{2}+{R}_{3}\\end{aligned} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & -5 & -5 & -9 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & 0 & 3 & 3 & 4 & 6\\end{array}\\right] &  & \\begin{aligned}{R}_{3}:=\\frac{1}{3}{R}_{3}\\end{aligned} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & -5 & -5 & -9 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & 0 & 1 & 1 & \\frac{4}{3} & 2\\end{array}\\right]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}-5 & -5 & -9 \\\\ 3 & 3 & 6 \\\\ 1 & \\frac{4}{3} & 2\\end{bmatrix}.\n$$\n\nFinally, $a=-5,$ $b=3,$ $c=2$ and \n\n$$\na+b+c=-5+3+2=0.\n$$"}] [{:db/id #edb/ref 17592186416399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6e04b1-baff-5b92-8e15-ea0dfbc34cf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ -5 & -6\\end{bmatrix}" :db/id #edb/ref 17592186416366} {:answer/id #uuid "6f10e2cb-3c02-510f-8245-4c4fef2fb57e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 \\\\ 5 & -5\\end{bmatrix}" :db/id #edb/ref 17592186416376} {:answer/id #uuid "d919b397-4a17-5c1a-b41c-a4d8613b1b00" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 \\\\ -4 & -5\\end{bmatrix}" :db/id #edb/ref 17592186416384} {:answer/id #uuid "e2593c00-382d-5cff-bc6a-79ef94821d99" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 5 & 0\\end{bmatrix}" :db/id #edb/ref 17592186416386} {:answer/id #uuid "f8dab090-6ca4-5789-8aba-16cd40d5c9b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & -5\\end{bmatrix}" :db/id #edb/ref 17592186416390}] :answer-field/correct {:db/id #edb/ref 17592186416390} :answer-field/id #uuid "d40ebe53-c259-5fc7-9393-ddb15fac1751" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416395}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e8f9b1b9-d1e3-5a9e-a4fd-34ae92b559e5" :question/math-academy-id "q-140360" :question/problem "Let $B$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[\\,T\\,]_{B}$, given that\n\n$\\,$ $T(\\begin{bmatrix}x \\\\ y\\end{bmatrix})=\\begin{bmatrix}6x-7y \\\\ -2x-6y\\end{bmatrix}\\,$ and $\\,B={\\begin{bmatrix}6 \\\\ -2\\end{bmatrix},\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}}.$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1}$ and ${b}_{2}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}6 \\\\ -2\\end{bmatrix})=\\begin{bmatrix}50 \\\\ 0\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}4 \\\\ 2\\end{bmatrix})=\\begin{bmatrix}10 \\\\ -20\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\left[\\begin{array}{cc|cc}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{array}\\right].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|cc}6 & 4 & 50 & 10 \\\\ -2 & 2 & 0 & -20\\end{array}\\right] &  & \\begin{aligned}{R}_{1}:=\\frac{1}{6}{R}_{1}\\end{aligned} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & \\frac{2}{3} & \\frac{25}{3} & \\frac{5}{3} \\\\ -2 & 2 & 0 & -20\\end{array}\\right] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & \\frac{2}{3} & \\frac{25}{3} & \\frac{5}{3} \\\\ 0 & \\frac{10}{3} & \\frac{50}{3} & -\\frac{50}{3}\\end{array}\\right] &  & \\begin{aligned}{R}_{2}:=\\frac{3}{10}{R}_{2}\\end{aligned} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & \\frac{2}{3} & \\frac{25}{3} & \\frac{5}{3} \\\\ 0 & 1 & 5 & -5\\end{array}\\right] &  & \\begin{aligned}{R}_{1}:={R}_{1}-\\frac{2}{3}{R}_{2}\\end{aligned} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 5 & 5 \\\\ 0 & 1 & 5 & -5\\end{array}\\right]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}5 & 5 \\\\ 5 & -5\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186416979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8df6e2-fe2b-50c4-8d6d-bfcfdcb03b07" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186416955}] :answer-field/correct {:db/id #edb/ref 17592186416955} :answer-field/id #uuid "68f52881-eb76-51b7-8183-8acacfe3a8e3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186416973} {:answer-field/choices [{:answer/id #uuid "c6019430-865a-5e00-8e5e-9f4fec670079" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186416967}] :answer-field/correct {:db/id #edb/ref 17592186416967} :answer-field/id #uuid "cde49d9c-ec17-5210-bdd7-9e30e90fa8b4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186416976}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f56bf75-c034-5aab-87bb-3f506f067872" :question/math-academy-id "q-350412" :question/problem "$$\nA=\\begin{bmatrix}0 & 2 \\\\ 6 & -6\\end{bmatrix},\\,B=\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix},\\,y=\\begin{bmatrix}4 \\\\ 1\\end{bmatrix}.\n$$\n\nGiven the matrices above, write the following expression as a Hadamard product. Here $(\\,\\cdot \\,)$ denotes matrix multiplication.\n\n| $(AB)\\cdot (By)=\\,\\,$ |  | {{field-1}} |  | $⊙$ |  | {{field-2}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $-6$ |  |  | $4$ |  |  |  |  |" :question/worked-solution "The Hadamard product of two compatible vectors $u$ and $v$ can be expressed as the matrix product\n\n$$\nv⊙u=\\text{diag}(v)u.\n$$\n\nIn our case, we have\n\n$$\nAB=\\begin{bmatrix}0 & 2 \\\\ 6 & -6\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}2 & 0 \\\\ 0 & -6\\end{bmatrix}\n$$\n\nand\n\n$$\nBy=\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}4 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}.\n$$\n\nHence, \n\n$$\n\\begin{aligned}(AB)\\cdot (By) & =\\begin{bmatrix}2 & 0 \\\\ 0 & -6\\end{bmatrix}\\begin{bmatrix}3 \\\\ 4\\end{bmatrix} \\\\  & =\\text{diag}(\\begin{bmatrix}2 \\\\ -6\\end{bmatrix})\\begin{bmatrix}3 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -6\\end{bmatrix}⊙\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186417184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "339eb9d7-c3ff-5722-b2a4-62c01e506dfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186417130} {:answer/id #uuid "7545326f-2ed3-5b45-b83f-fdce64ffd43b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186417142} {:answer/id #uuid "c0ab3da6-d52a-52fe-8824-525245387581" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186417162} {:answer/id #uuid "f99a0a3e-8e69-5c5a-8d55-fb74464b4d49" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186417171} {:answer/id #uuid "fa770ac4-af40-5a3c-b0e8-fb5ff74934d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186417172}] :answer-field/correct {:db/id #edb/ref 17592186417172} :answer-field/id #uuid "61a8f832-f2b3-5123-8233-870da3bb21e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417178}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "15cdd9a6-5092-51ed-93a5-b2dd11d2ff12" :question/math-academy-id "q-82713" :question/problem "$$\nB=\\{\\begin{bmatrix}7 \\\\ 3\\end{bmatrix},\\begin{bmatrix}5 \\\\ 2\\end{bmatrix}\\},\\,[x]_{S}=\\begin{bmatrix}-2 \\\\ -1\\end{bmatrix}\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=\\begin{bmatrix}7 & 5 \\\\ 3 & 2\\end{bmatrix}.\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={\\begin{bmatrix}7 & 5 \\\\ 3 & 2\\end{bmatrix}}^{-1} \\\\  & =\\frac{1}{7\\cdot 2-3\\cdot 5}\\begin{bmatrix}2 & -5 \\\\ -3 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 5 \\\\ 3 & -7\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =\\begin{bmatrix}-2 & 5 \\\\ 3 & -7\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186417740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dea2883-7aed-50ab-88db-338d6b05d1d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}4{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430953} {:answer/id #uuid "6d08ac3a-bf71-57e5-86bb-45513f396dce" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}6{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430958} {:answer/id #uuid "78246ec8-609c-551f-b0ac-0dadda339bf8" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430960} {:answer/id #uuid "a3181278-1876-5206-9569-f7c580389091" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430963} {:answer/id #uuid "bcdbf8dd-4179-511e-ac05-173b55d1fa27" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{1} \\\\ -{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186430965}] :answer-field/correct {:db/id #edb/ref 17592186430960} :answer-field/id #uuid "59767641-5ff1-522d-98ff-ca8331e026ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417735}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "87edb91a-a643-5fdb-a1df-2e5d059d6b9b" :question/math-academy-id "q-111154" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -2 \\\\ -3 & 6 \\\\ 4 & -8\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 \\\\ -3 & 6 \\\\ 4 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & 0 \\\\ 4 & -8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2} &=0 \\\\ 0 &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have one free variable, ${x}_{2}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}.$\n\nFrom the first equation we get ${x}_{1}=2{x}_{2},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)=\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}.\n$$"}] [{:db/id #edb/ref 17592186417869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00506e35-c298-5a4f-af8f-eeaca76aaacb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ -2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186417839} {:answer/id #uuid "00f093fe-bc06-5628-b62a-e67a521941bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186417841} {:answer/id #uuid "6e7a673d-e4a8-5264-a60e-b71b9cc758bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 \\\\ -4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186417853} {:answer/id #uuid "7e7fd9d7-1875-5e28-9d53-6079344fc1c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186417857} {:answer/id #uuid "d4d3edfc-faf6-56f0-8a2f-d23798f45713" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186417861}] :answer-field/correct {:db/id #edb/ref 17592186417853} :answer-field/id #uuid "389ac663-f6cc-5412-8d70-af0f32538d7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417865}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "169ca18b-315b-5001-b32b-2f9efd14b654" :question/math-academy-id "q-86755" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=\\begin{bmatrix}-9 \\\\ -5 \\\\ -5\\end{bmatrix},\\,\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+{x}_{3} &=0 \\\\ {x}_{1}-2{x}_{2}-{x}_{3} &=0\\end{aligned}\\right.\n$$" :question/worked-solution "First, we need to find a basis of the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -3 & 1 & 0 \\\\ 1 & -2 & -1 & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & 1 & 0 \\\\ 0 & 1 & -2 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nIn the reduced matrix above, there are $2$ pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. Now, from the second equation, we get ${x}_{2}=2{x}_{3}.$ Substituting this into the first equation, we obtain \n\n$$\n{x}_{1}-3\\cdot (2{x}_{3})+{x}_{3}=0\\,⟹\\,{x}_{1}=5{x}_{3}.\n$$\n\nSo, the general solution is\n\n$$\n\\begin{bmatrix}5{x}_{3} \\\\ 2{x}_{3} \\\\ {x}_{3}\\end{bmatrix}={x}_{3}\\begin{bmatrix}5 \\\\ 2 \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B=\\{\\begin{bmatrix}5 \\\\ 2 \\\\ 1\\end{bmatrix}\\}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{(-9)\\cdot 5+(-5)\\cdot 2+(-5)\\cdot 1}{{5}^{2}+{2}^{2}+{1}^{2}}b \\\\  & =\\frac{-60\\,}{\\,\\,\\,30\\,}b \\\\  & =-2b \\\\  & =-2\\begin{bmatrix}5 \\\\ 2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 \\\\ -4 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186418767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a4730af-deb8-5685-8db4-054a0f26476b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186418737} {:answer/id #uuid "45409e4f-d6f7-583a-a654-f6549650ec01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186418740} {:answer/id #uuid "4bf16aae-72e1-5107-ae16-5b805fc64b24" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186418742} {:answer/id #uuid "510cc82f-89b0-512e-a913-16359c5c9470" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186418743} {:answer/id #uuid "d7982ef7-967e-53d6-ac5f-6caebe695c2c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186418758}] :answer-field/correct {:db/id #edb/ref 17592186418743} :answer-field/id #uuid "f71e16f6-f24e-58ff-9688-d083942b3ca5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418764}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "95765da4-bd97-53db-8498-26a824409464" :question/math-academy-id "q-80524" :question/problem "Given that $u=\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}$ is a non-zero  vector that is orthogonal to the set $W=\\{\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}4 \\\\ -1 \\\\ -1\\end{bmatrix}\\},$ find the value of $\\frac{b+c}{a}.$" :question/worked-solution "The vector $u$ is orthogonal to the set $W$ if $u\\cdot {w}_{1}=0$ and $u\\cdot {w}_{2}=0.$ So, we need to solve the following system:\n\n$$\n\\left\\{\\begin{aligned}u\\cdot {w}_{1} &=0 \\\\ u\\cdot {w}_{2} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{2}-{x}_{3} &=0 \\\\ 4{x}_{1}-{x}_{2}-{x}_{3} &=0\\end{aligned}\\right.\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}0 & 1 & -1 & 0 \\\\ 4 & -1 & -1 & 0\\end{array}\\right] & {R}_{1} & ⇔{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}4 & -1 & -1 & 0 \\\\ 0 & 1 & -1 & 0\\end{array}\\right] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -\\frac{1}{4} & -\\frac{1}{4} & 0 \\\\ 0 & 1 & -1 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $2$ pivot columns (the $1$st and $2$nd), so ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}={x}_{3}.$ Substituting this into the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{3}.$ So, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{2}{x}_{3} \\\\ {x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=2,$ we get the vector \n$$\n\\displaystyle \\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}.\n$$\n\nTherefore, we obtain $a=1,$ $b=2,$ and $c=2.$\n\nFinally, $\\frac{b+c}{a}=\\frac{2+2}{1}=4.$"}] [{:db/id #edb/ref 17592186419579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aa3f0cb-f552-5997-9604-53d87b356492" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-4z \\\\ y \\\\ 2z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186455062} {:answer/id #uuid "967cf1df-e3fe-5921-8f01-b706d00a2a7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ 4x+2z \\\\ z\\end{bmatrix}\\,:\\,x,y\\in R\\}" :db/id #edb/ref 17592186455175} {:answer/id #uuid "b52464b5-12d3-55df-8a1f-c2ec33198abb" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-2y+z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R\\}." :db/id #edb/ref 17592186455221} {:answer/id #uuid "c0727ab1-37f4-52c5-b6e4-c5118fe93bbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ y \\\\ 4x+2y\\end{bmatrix}\\,:\\,x,y\\in R\\}" :db/id #edb/ref 17592186455234} {:answer/id #uuid "ce2608f3-a0b5-5f12-8da7-ae3d41d9398a" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186455262}] :answer-field/correct {:db/id #edb/ref 17592186455221} :answer-field/id #uuid "07ed2ad4-a2fd-5d04-be73-f4b3ba6ae7db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419574}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "32b7b7cc-73cb-5678-9200-bd4242fb8265" :question/math-academy-id "q-140056" :question/problem "Consider the linear transformation $$\n\\displaystyle T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x+4y-2z \\\\ -3x-6y+3z \\\\ 4x+8y-4z\\end{bmatrix}.\n$$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=\\begin{bmatrix}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{bmatrix}.$ \n\nSetting $x=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+\\left(\\frac{3}{2}\\right){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 4 & 8 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables, $y,$ and $z.$ That means we need to find $x$ in terms of $y$ and $z.$ \n\nFrom the first equation, we get \n\n$$\nx=-2y+z.\n$$\n\n  \n\nTherefore, the kernel of the linear transformation $\\,T$ is $\\{\\begin{bmatrix}-2y+z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R\\}.$"}] [{:db/id #edb/ref 17592186419684 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6934d8-eaf0-5f13-b06a-71ac2a0dc0af" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186419660} {:answer/id #uuid "5c9c3643-ad71-51e0-bd19-40d272c2cabe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -3 \\\\ 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186419667} {:answer/id #uuid "8f47a664-a9ad-5deb-90c8-17a7a38adab0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & 7 \\\\ 8 & -5\\end{bmatrix}" :db/id #edb/ref 17592186419671} {:answer/id #uuid "d0704113-7386-54ca-ad0c-7578acd9ac62" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -11 \\\\ 2 & 7\\end{bmatrix}" :db/id #edb/ref 17592186419676} {:answer/id #uuid "dc81c6b4-cc09-56a5-916c-e323cc4197ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & -1 \\\\ -3 & 9\\end{bmatrix}" :db/id #edb/ref 17592186419678}] :answer-field/correct {:db/id #edb/ref 17592186419667} :answer-field/id #uuid "32c807d8-09ff-597f-a633-55d26150ec43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419681}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "662e0d41-a6b8-58b3-ad4a-e835c48f17e2" :question/math-academy-id "q-97118" :question/problem "$$\nB=\\{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}\\},\\,[T]_{B}=\\begin{bmatrix}3 & -1 \\\\ -2 & 1\\end{bmatrix}\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the basis $B$ and standard basis $S$ is given by the following diagram:\n\n![](images/db/dbd020362f950fe8bfb4c592652b9e78a73610fa01a247b0b7ead6f201bf9ea5.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{S}={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1},\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is\n\n$$\n{P}_{B\\to S}=\\begin{bmatrix}1 & 2 \\\\ 2 & 3\\end{bmatrix}.\n$$\n\nFirst, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{B\\to S}^{-1} & ={\\begin{bmatrix}1 & 2 \\\\ 2 & 3\\end{bmatrix}}^{-1} \\\\  & =\\frac{1}{3\\cdot 1-2\\cdot 2}\\begin{bmatrix}3 & -2 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 2 \\\\ 2 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the standard basis $S:$\n\n$$\n\\begin{aligned}[T]_{S} & ={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & 3\\end{bmatrix}\\begin{bmatrix}3 & -1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -3 \\\\ 2 & -1\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "094350f2-e017-53e0-b0e9-5075268dbe4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186419659} {:answer/id #uuid "248c47da-3dc5-5333-809d-acf62be00f30" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & -12 \\\\ 7 & 14\\end{bmatrix}" :db/id #edb/ref 17592186419663} {:answer/id #uuid "7d527527-44f7-5758-b7fd-4c2cd30a0912" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 9 \\\\ 0 & -7\\end{bmatrix}" :db/id #edb/ref 17592186419670} {:answer/id #uuid "c7cdd80b-8123-585f-9ada-143e7f38d137" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 6 \\\\ 1 & -4\\end{bmatrix}" :db/id #edb/ref 17592186419674} {:answer/id #uuid "cd75b99f-ca84-5149-9b32-732c0d712c4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & -18 \\\\ -9 & -16\\end{bmatrix}" :db/id #edb/ref 17592186419675}] :answer-field/correct {:db/id #edb/ref 17592186419663} :answer-field/id #uuid "2c3a3177-a079-5cdb-a624-7225c5f182a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419680}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7afd5a54-c223-5e70-9582-9406545b2d06" :question/math-academy-id "q-97279" :question/problem "$$\nB=\\{\\begin{bmatrix}0 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-1 \\\\ -4\\end{bmatrix}\\},\\,C=\\{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\},\\,[T]_{B}=\\begin{bmatrix}4 & 3 \\\\ 2 & 5\\end{bmatrix}\n$$\n\nConsider the bases $B$ and $C$ of ${R}^{2},$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to the basis $B$, shown above. Find the matrix of $T$ relative to the basis $C.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nFirst, let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the coordinates of vectors from $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ To do this, we consider the matrix\n\n$$\nM=\\left[\\begin{array}{cc|cc}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{array}\\right].\n$$\n\nWe reduce $M$ using Gaussian elimination until we get the identity matrix on the left. By doing this, we obtain the required change-of-coordinates matrix on the right.\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|cc}1 & 2 & 0 & -1 \\\\ -2 & -1 & 3 & -4\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 2 & 0 & -1 \\\\ 0 & 3 & 3 & -6\\end{array}\\right] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 2 & 0 & -1 \\\\ 0 & 1 & 1 & -2\\end{array}\\right] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & -2 & 3 \\\\ 0 & 1 & 1 & -2\\end{array}\\right]\\end{aligned}\n$$\n\nHence,\n\n$$\n{P}_{B\\to C}=\\begin{bmatrix}-2 & 3 \\\\ 1 & -2\\end{bmatrix}.\n$$\n\nNow, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{B\\to C}^{-1} & ={\\begin{bmatrix}-2 & 3 \\\\ 1 & -2\\end{bmatrix}}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-2)-1\\cdot 3}\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =\\begin{bmatrix}-2 & 3 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}4 & 3 \\\\ 2 & 5\\end{bmatrix}\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 9 \\\\ 0 & -7\\end{bmatrix}\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & -12 \\\\ 7 & 14\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189bee50-4a99-5b40-af14-d79a6be4cf78" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186421767} {:answer/id #uuid "1ab31c93-1b65-5e8b-a761-9f8a56bd7091" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186421768} {:answer/id #uuid "936a7baa-180a-5ac4-87b7-254a0a451cae" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186421773} {:answer/id #uuid "9c1d5f42-e69e-5804-8ffc-1ba7c0a90d40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186421774} {:answer/id #uuid "a21a5496-3418-514f-ae65-4dd4f8f20907" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186421775}] :answer-field/correct {:db/id #edb/ref 17592186421768} :answer-field/id #uuid "44498254-f6d6-5947-a33a-02e052e8e1fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "27b29e44-b12e-5311-b5aa-28b3cb92f7e4" :question/math-academy-id "q-161304" :question/problem "Consider the vector field $\\mathbf{F}$ and the surface $S$ with parametrization $\\mathbf{r}(u,v),$ where\n\n$$\n\\mathbf{F}(x,y,z)=⟨{x}^{2},\\hspace{0.222em}xy,\\hspace{0.222em}z⟩,\\hspace{1em}\\mathbf{r}(u,v)=⟨u,\\hspace{0.222em}v,\\hspace{0.222em}2uv⟩,\\hspace{1em}(u,v)\\in D⊂{\\mathbb{R}}^{2}.\n$$\n\nIf the flux of $\\mathbf{F}$ across $S$ with respect to $\\mathbf{n}$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}auv+b{u}^{2}v\\,\\text{d}A\n$$\n\nwhat is the value of $a+b?$" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}2uv)⟩ \\\\  & =⟨1,\\,0,\\,2v⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(2uv)⟩ \\\\  & =⟨0,\\,1,\\,2u⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 2v \\\\ 0 & 1 & 2u\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 2v \\\\ 1 & 2u\\end{vmatrix},\\,-\\begin{vmatrix}1 & 2v \\\\ 0 & 2u\\end{vmatrix},\\,\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}⟩ \\\\  & =⟨-2v,\\,-2u,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨{x}^{2},\\,xy,\\,z⟩{|}_{x=u\\,y=v\\,z=2uv} \\\\  & =⟨{u}^{2},\\,uv,\\,2uv⟩.\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨{u}^{2},\\,uv,\\,2uv⟩\\cdot ⟨-2v,\\,-2u,\\,1⟩ \\\\  & ={u}^{2}\\cdot (-2v)+uv\\cdot (-2u)+2uv\\cdot 1 \\\\  & =-2{u}^{2}v-2{u}^{2}v+2uv \\\\  & =2uv-4{u}^{2}v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}2\\cdot uv+(-4)\\cdot {u}^{2}v\\,\\text{d}A.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=2-4=-2.\n$$"}] [{:db/id #edb/ref 17592186421785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "127c5717-261e-5aef-838e-be5fab62b6d9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186421765} {:answer/id #uuid "176992fe-e63a-5f75-8661-ee649edc6971" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186421766} {:answer/id #uuid "794b5eb2-d0f5-57bd-8363-4337b7e59452" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186421772} {:answer/id #uuid "cb9f4e2e-e860-55d7-8d5c-c33be0190db3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186421778} {:answer/id #uuid "d7fec48c-2c4b-5a3b-8559-e99202ca21e4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186421779}] :answer-field/correct {:db/id #edb/ref 17592186421765} :answer-field/id #uuid "b8009739-528a-5b9d-8b7a-977eb7894c6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421781}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f3288098-3c26-556d-b6c9-f206da47adfb" :question/math-academy-id "q-162593" :question/problem "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨3z,\\hspace{0.222em}-2x,\\hspace{0.222em}-y⟩\\cdot \\text{d}\\mathbf{S}\n$$\n\nwhere the parametric surface $S$ is defined by the equations\n\n$$\n\\mathbf{r}(u,v)=⟨-v,\\hspace{0.222em}-u,\\hspace{0.222em}{u}^{2}⟩\n$$\n\nfor $0\\le u\\le 1$ and $0\\le v\\le 1.$" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(-v),\\,\\frac{∂}{∂u}(-u),\\,\\frac{∂}{∂u}({u}^{2})⟩ \\\\  & =⟨0,\\,-1,\\,2u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(-v),\\,\\frac{∂}{∂v}(-u),\\,\\frac{∂}{∂v}({u}^{2})⟩ \\\\  & =⟨-1,\\,0,\\,0⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 0 & -1 & 2u \\\\ -1 & 0 & 0\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}-1 & 2u \\\\ 0 & 0\\end{vmatrix},-\\begin{vmatrix}0 & 2u \\\\ -1 & 0\\end{vmatrix},\\begin{vmatrix}0 & -1 \\\\ -1 & 0\\end{vmatrix}⟩ \\\\  & =⟨0,\\,-2u,\\,-1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & ={⟨3z,\\,-2x,\\,-y⟩|}_{x=-v\\,y=-u\\,z={u}^{2}} \\\\  & =⟨3{u}^{2},\\,-2(-v),\\,-(-u)⟩ \\\\  & =⟨3{u}^{2},\\,2v,\\,u⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3{u}^{2},\\,2v,\\,u⟩\\cdot ⟨0,\\,-2u,\\,-1⟩ \\\\  & =3{u}^{2}\\cdot 0+2v\\cdot (-2u)+u\\cdot (-1) \\\\  & =-4uv-u\\end{aligned}\n$$\n\nTherefore, the surface integral evaluates to\n\n$$\n\\begin{aligned}{∬}_{S}⟨3z,\\,-2x,\\,-y⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(-4uv-u)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(-4uv-u)\\,\\text{d}u\\,\\text{d}v \\\\  & =-{\\int }_{0}^{1}{\\int }_{0}^{1}(4uv+u)\\,\\text{d}u\\,\\text{d}v \\\\  & =-{\\int }_{0}^{1}{[2{u}^{2}v+\\frac{1}{2}{u}^{2}]}_{u=0}^{u=1}\\,\\text{d}v \\\\  & =-{\\int }_{0}^{1}(2v+\\frac{1}{2})\\text{d}v \\\\  & =-{[{v}^{2}+\\frac{1}{2}v]}_{0}^{1} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146aebe7-02b6-58b6-8dd1-374b1fcd30d0" :answer/type {:db/ident :answer.type/math} :answer/value "{u}^{2}" :db/id #edb/ref 17592186423086} {:answer/id #uuid "3586c1bc-3061-5093-99ca-95e798991986" :answer/type {:db/ident :answer.type/math} :answer/value "4uv" :db/id #edb/ref 17592186423088} {:answer/id #uuid "5a1a3ab5-07e2-55d2-b713-d20c37bdda9e" :answer/type {:db/ident :answer.type/math} :answer/value "{u}^{3}" :db/id #edb/ref 17592186423092} {:answer/id #uuid "6197b42b-5e97-5e6b-a1bb-2951dc50be38" :answer/type {:db/ident :answer.type/math} :answer/value "2uv" :db/id #edb/ref 17592186423093} {:answer/id #uuid "cacced8e-053e-5057-89f0-678a72c14a18" :answer/type {:db/ident :answer.type/math} :answer/value "3v" :db/id #edb/ref 17592186423107}] :answer-field/correct {:db/id #edb/ref 17592186423086} :answer-field/id #uuid "2bbc92cc-19ad-54ee-9d42-9ce995a00f4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423116}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "29805411-7a4c-51f7-893d-a0f3dc3cef10" :question/math-academy-id "q-161377" :question/problem "Consider the vector field $\\mathbf{F}(x,y,z)=⟨{x}^{2}-{y}^{2},\\hspace{0.222em}{y}^{2}-{z}^{2},\\hspace{0.222em}{z}^{2}⟩$ and the surface $S$ defined by $z=-x-y$ for $-2\\le x\\le 2$ and $-2\\le y\\le 2.$ Using the parametrization $x=u$ and $y=v,$ the flux of $\\mathbf{F}$ through $S$ can be expressed as\n\n$$\n{∬}_{S}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}={\\int }_{-2}^{2}{\\int }_{-2}^{2}\\enclose{box}{\\phantom{AAAAAAA}}\\hspace{0.222em}\\text{d}v\\hspace{0.222em}\\text{d}u.\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $\\mathbf{r}(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $\\mathbf{F}$ over $S$ is given by\n\n$$\n{∬}_{S}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}={∬}_{S}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}S={∬}_{D}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'})\\hspace{0.167em}\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\n\\mathbf{r}(u,v)=⟨u,\\hspace{0.222em}v,\\hspace{0.222em}-u-v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-2\\le u\\le 2,\\,-2\\le v\\le 2\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{u}^{'} & =⟨\\frac{∂x}{∂u},\\hspace{0.222em}\\frac{∂y}{∂u},\\hspace{0.222em}\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\hspace{0.222em}\\frac{∂}{∂u}(v),\\hspace{0.222em}\\frac{∂}{∂u}(-u-v)⟩ \\\\  & =⟨1,\\hspace{0.222em}0,\\hspace{0.222em}-1⟩ \\\\ {\\mathbf{r}}_{v}^{'} & =⟨\\frac{∂x}{∂v},\\hspace{0.222em}\\frac{∂y}{∂v},\\hspace{0.222em}\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\hspace{0.222em}\\frac{∂}{∂v}(v),\\hspace{0.222em}\\frac{∂}{∂v}(-u-v)⟩ \\\\  & =⟨0,\\hspace{0.222em}1,\\hspace{0.222em}-1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 0 & -1 \\\\ 0 & 1 & -1\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & -1 \\\\ 1 & -1\\end{vmatrix},\\hspace{0.222em}-\\begin{vmatrix}1 & -1 \\\\ 0 & -1\\end{vmatrix},\\hspace{0.222em}\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}⟩ \\\\  & =⟨1,\\hspace{0.222em}1,\\hspace{0.222em}1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $\\mathbf{r}(u,v)$ into $\\mathbf{F}(x,y,z):$\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(u,v)) & =⟨{x}^{2}-{y}^{2},\\hspace{0.222em}{y}^{2}-{z}^{2},\\hspace{0.222em}{z}^{2}⟩{|}_{x=u,\\hspace{0.167em}\\,y=v,\\hspace{0.167em}\\,z=-u-v} \\\\  & =⟨{u}^{2}-{v}^{2},\\hspace{0.222em}{v}^{2}-(-u-v)^{2},\\hspace{0.222em}(-u-v)^{2}⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $\\mathbf{F}$ and ${\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'}:$\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'}) & =⟨{u}^{2}-{v}^{2},\\hspace{0.222em}{v}^{2}-(-u-v)^{2},\\hspace{0.222em}(-u-v)^{2}⟩\\cdot ⟨1,\\hspace{0.222em}1,\\hspace{0.222em}1⟩ \\\\  & =({u}^{2}-{v}^{2})\\cdot (1)+({v}^{2}-(-u-v)^{2})\\cdot (1)+(-u-v)^{2}\\cdot 1 \\\\  & ={u}^{2}-{v}^{2}+{v}^{2}-(-u-v)^{2}+(-u-v)^{2} \\\\  & ={u}^{2}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨{x}^{2}-{y}^{2},\\hspace{0.222em}{y}^{2}-{z}^{2},\\hspace{0.222em}{z}^{2}⟩\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'})\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}{u}^{2}\\hspace{0.222em}\\text{d}A \\\\  & ={\\int }_{-2}^{2}{\\int }_{-2}^{2}{\\color{blue}{u}^{2}}\\hspace{0.222em}\\text{d}v\\hspace{0.222em}\\text{d}u.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b89c0b5-bd8b-5088-a053-0db9bc0fd31f" :answer/type {:db/ident :answer.type/math} :answer/value "-uv" :db/id #edb/ref 17592186423085} {:answer/id #uuid "57bc1e11-c92f-5bf5-b1cd-bdfca274f1c3" :answer/type {:db/ident :answer.type/math} :answer/value "5uv" :db/id #edb/ref 17592186423091} {:answer/id #uuid "62a07ee3-0b12-5f4d-81e0-7183964e0136" :answer/type {:db/ident :answer.type/math} :answer/value "3u{v}^{2}" :db/id #edb/ref 17592186423094} {:answer/id #uuid "876d48e1-3fb3-5bc6-88d3-a7e99ab5d29a" :answer/type {:db/ident :answer.type/math} :answer/value "uv+v" :db/id #edb/ref 17592186423100} {:answer/id #uuid "b65ee624-a7db-5060-ba14-007644627aeb" :answer/type {:db/ident :answer.type/math} :answer/value "uv-v" :db/id #edb/ref 17592186423104}] :answer-field/correct {:db/id #edb/ref 17592186423091} :answer-field/id #uuid "dce1231b-682c-5119-8b60-1e600b81511c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423118}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92e8ddd2-ccb6-5c20-b74b-2f784e857a55" :question/math-academy-id "q-161379" :question/problem "Consider the vector field $\\mathbf{F}(x,y,z)=⟨(x+y)^{2},\\hspace{0.222em}(x-y)^{2},\\hspace{0.222em}xy⟩$ and the surface $S$ defined by $z=y-x$ for $-1\\le x\\le 1$ and $-3\\le y\\le 0.$ Using the parametrization $x=u$ and $y=v,$ the flux of $\\mathbf{F}$ through $S$ can be expressed as\n\n$$\n{∬}_{S}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}={\\int }_{-1}^{1}{\\int }_{-3}^{0}\\enclose{box}{\\phantom{AAAAAAA}}\\hspace{0.222em}\\text{d}v\\hspace{0.222em}\\text{d}u.\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $\\mathbf{r}(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $\\mathbf{F}$ over $S$ is given by\n\n$$\n{∬}_{S}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}={∬}_{S}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}S={∬}_{D}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'})\\hspace{0.167em}\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\n\\mathbf{r}(u,v)=⟨u,\\hspace{0.222em}v,\\hspace{0.222em}v-u⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,-3\\le v\\le 0\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{u}^{'} & =⟨\\frac{∂x}{∂u},\\hspace{0.222em}\\frac{∂y}{∂u},\\hspace{0.222em}\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\hspace{0.222em}\\frac{∂}{∂u}(v),\\hspace{0.222em}\\frac{∂}{∂u}(v-u)⟩ \\\\  & =⟨1,\\hspace{0.222em}0,\\hspace{0.222em}-1⟩ \\\\ {\\mathbf{r}}_{v}^{'} & =⟨\\frac{∂x}{∂v},\\hspace{0.222em}\\frac{∂y}{∂v},\\hspace{0.222em}\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\hspace{0.222em}\\frac{∂}{∂v}(v),\\hspace{0.222em}\\frac{∂}{∂v}(v-u)⟩ \\\\  & =⟨0,\\hspace{0.222em}1,\\hspace{0.222em}1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 0 & -1 \\\\ 0 & 1 & 1\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & -1 \\\\ 1 & 1\\end{vmatrix},\\hspace{0.222em}-\\begin{vmatrix}1 & -1 \\\\ 0 & 1\\end{vmatrix},\\hspace{0.222em}\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}⟩ \\\\  & =⟨1,\\hspace{0.222em}-1,\\hspace{0.222em}1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $\\mathbf{r}(u,v)$ into $\\mathbf{F}(x,y,z):$\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(u,v)) & =⟨(x+y)^{2},\\hspace{0.222em}(x-y)^{2},\\hspace{0.222em}xy⟩{|}_{x=u,\\hspace{0.167em}\\,y=v,\\hspace{0.167em}\\,z=v-u} \\\\  & =⟨(u+v)^{2},\\hspace{0.222em}(u-v)^{2},\\hspace{0.222em}uv⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $\\mathbf{F}$ and ${\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'}:$\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'}) & =⟨(u+v)^{2},\\hspace{0.222em}(u-v)^{2},\\hspace{0.222em}uv⟩\\cdot ⟨1,\\hspace{0.222em}-1,\\hspace{0.222em}1⟩ \\\\  & =(u+v)^{2}\\cdot 1+(u-v)^{2}\\cdot (-1)+uv\\cdot 1 \\\\  & =5uv.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨(x+y)^{2},\\hspace{0.222em}(x-y)^{2},\\hspace{0.222em}xy⟩\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'})\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}(5uv)\\hspace{0.222em}\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{-3}^{0}{\\color{blue}5uv}\\hspace{0.222em}\\text{d}v\\hspace{0.222em}\\text{d}u.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "556660a7-ba40-5142-a23c-96cdb3bb38b3" :answer/type {:db/ident :answer.type/math} :answer/value "8u-23v" :db/id #edb/ref 17592186423090} {:answer/id #uuid "86aaa33f-073f-5b9c-b6ed-02e42f1370d2" :answer/type {:db/ident :answer.type/math} :answer/value "12u-v" :db/id #edb/ref 17592186423099} {:answer/id #uuid "8fa80cac-9ed0-54f2-a0fb-a71697486081" :answer/type {:db/ident :answer.type/math} :answer/value "8u+14v" :db/id #edb/ref 17592186423101} {:answer/id #uuid "9d9623af-3bba-5a0d-9c01-61a215703653" :answer/type {:db/ident :answer.type/math} :answer/value "5u-17v" :db/id #edb/ref 17592186423103} {:answer/id #uuid "b721d1da-8cb3-5423-bdff-f515271a77db" :answer/type {:db/ident :answer.type/math} :answer/value "u-6v" :db/id #edb/ref 17592186423105}] :answer-field/correct {:db/id #edb/ref 17592186423103} :answer-field/id #uuid "de6e4169-2fd0-5a0b-b7fe-172964aca58f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423119}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ef91d27f-5ce3-5c48-b5b9-4ec732b3b2e1" :question/math-academy-id "q-161471" :question/problem "Consider the vector field $\\mathbf{F}(x,y,z)=⟨x+z,\\hspace{0.222em}2z,\\hspace{0.222em}y+z⟩$ and the surface $S$ defined by $z=x-3y$ for $-1\\le x\\le 2$ and $-1\\le y\\le 3.$ Using the parametrization $x=u$ and $y=v,$ the flux of $\\mathbf{F}$ through $S$ can be expressed as\n\n$$\n{∬}_{S}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}={\\int }_{-1}^{2}{\\int }_{-1}^{3}\\enclose{box}{\\phantom{AAAAAAA}}\\hspace{0.222em}\\text{d}v\\hspace{0.222em}\\text{d}u.\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $\\mathbf{r}(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $\\mathbf{F}$ over $S$ is given by\n\n$$\n{∬}_{S}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}={∬}_{S}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}S={∬}_{D}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'})\\hspace{0.167em}\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\n\\mathbf{r}(u,v)=⟨u,\\hspace{0.222em}v,\\hspace{0.222em}u-3v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-1\\le u\\le 2,\\,-1\\le v\\le 3\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{u}^{'} & =⟨\\frac{∂x}{∂u},\\hspace{0.222em}\\frac{∂y}{∂u},\\hspace{0.222em}\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\hspace{0.222em}\\frac{∂}{∂u}(v),\\hspace{0.222em}\\frac{∂}{∂u}(u-3v)⟩ \\\\  & =⟨1,\\hspace{0.222em}0,\\hspace{0.222em}1⟩ \\\\ {\\mathbf{r}}_{v}^{'} & =⟨\\frac{∂x}{∂v},\\hspace{0.222em}\\frac{∂y}{∂v},\\hspace{0.222em}\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\hspace{0.222em}\\frac{∂}{∂v}(v),\\hspace{0.222em}\\frac{∂}{∂v}(u-3v)⟩ \\\\  & =⟨0,\\hspace{0.222em}1,\\hspace{0.222em}-3⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 0 & 1 \\\\ 0 & 1 & -3\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 1 \\\\ 1 & -3\\end{vmatrix},\\hspace{0.222em}-\\begin{vmatrix}1 & 1 \\\\ 0 & -3\\end{vmatrix},\\hspace{0.222em}\\begin{vmatrix}1 & 0 \\\\ 0 & 1\\end{vmatrix}⟩ \\\\  & =⟨-1,\\hspace{0.222em}3,\\hspace{0.222em}1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $\\mathbf{r}(u,v)$ into $\\mathbf{F}(x,y,z):$\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(u,v)) & =⟨x+z,\\hspace{0.222em}2z,\\hspace{0.222em}y+z⟩{|}_{x=u,\\hspace{0.167em}\\,y=v,\\hspace{0.167em}\\,z=u-3v} \\\\  & =⟨u+u-3v,\\hspace{0.222em}2(u-3v),\\hspace{0.222em}v+u-3v⟩ \\\\  & =⟨2u-3v,\\hspace{0.222em}2u-6v,\\hspace{0.222em}u-2v⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $\\mathbf{F}$ and ${\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'}:$\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'}) & =⟨2u-3v,\\hspace{0.222em}2u-6v,\\hspace{0.222em}u-2v⟩\\cdot ⟨-1,\\hspace{0.222em}3,\\hspace{0.222em}1⟩ \\\\  & =(2u-3v)\\cdot (-1)+(2u-6v)\\cdot (3)+(u-2v)\\cdot 1 \\\\  & =-2u+3v+6u-18v+u-2v \\\\  & =5u-17v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨z-y,\\hspace{0.222em}2y-z,\\hspace{0.222em}xy⟩\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}\\mathbf{F}(\\mathbf{r}(u,v))\\cdot ({\\mathbf{r}}_{u}^{'}\\times {\\mathbf{r}}_{v}^{'})\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}(5u-17v)\\hspace{0.222em}\\text{d}A \\\\  & ={\\int }_{-1}^{2}{\\int }_{-1}^{3}{\\color{blue}(5u-17v)}\\hspace{0.222em}\\text{d}v\\hspace{0.222em}\\text{d}u.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423620 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ef60749-f0a3-5b92-b7ac-687d57c40bab" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186423608} {:answer/id #uuid "842c1b53-7a3c-5c3c-95cd-f635e53b9e76" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186423609} {:answer/id #uuid "8f1ff8c3-beef-5403-bf54-dedcfd80e6c8" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186423610} {:answer/id #uuid "c1363c60-15a5-5bca-ae79-3b740d941738" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186423613} {:answer/id #uuid "c62c345c-75b2-5956-a3af-45a35e4a85f2" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186423614}] :answer-field/correct {:db/id #edb/ref 17592186423610} :answer-field/id #uuid "8d734853-a228-557f-9012-a5d01ef1cf52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c2bc939-4b4c-5161-9351-90818be5a0a1" :question/math-academy-id "q-75070" :question/problem "Given the matrix \n$V=\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & 4\\end{bmatrix}.$ Find a basis $B$ of $\\text{Col}(V).$" :question/worked-solution "In order to find a basis of $\\text{Col}(V),$ we reduce the matrix $V$ to row echelon form:\n\n$$\n\\begin{aligned}V & =\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & 4\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${v}_{1}$ and ${v}_{2}.$ So, a basis of $\\text{Col}(V)$ is $\\{{v}_{1},{v}_{2}\\},$ that is to say, \n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\}.\n$$"}] [{:db/id #edb/ref 17592186424594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a113c4d-a0ac-5651-906e-41d84f5d836e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186424582} {:answer/id #uuid "5368a6fd-1c3c-5ec5-98c7-f3629d82df88" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186424583} {:answer/id #uuid "78554db1-b432-51b4-936b-3b8941909583" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186424585} {:answer/id #uuid "a841feda-cb6b-5b98-990a-d1a0abf6cfb1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186424588} {:answer/id #uuid "ff9dadc2-a499-5eb3-a904-a3da6ea8a443" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186424591}] :answer-field/correct {:db/id #edb/ref 17592186424588} :answer-field/id #uuid "0fd465c3-4977-5d35-b197-a5e9f9656a35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424592}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4780154a-e6c5-5212-9585-41f4b2c7d38a" :question/math-academy-id "q-34832" :question/problem "$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}5 \\\\ -1\\end{bmatrix},\\begin{bmatrix}-10 \\\\ 5\\end{bmatrix},\\begin{bmatrix}15 \\\\ -3\\end{bmatrix}\\})=\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}5 & -10 & 15 \\\\ -1 & 5 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{5}{R}_{1} \\\\  & ∼\\begin{bmatrix}5 & -10 & 15 \\\\ 0 & 3 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, \n$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}5 \\\\ -1\\end{bmatrix},\\begin{bmatrix}-10 \\\\ 5\\end{bmatrix},\\begin{bmatrix}15 \\\\ -3\\end{bmatrix}\\})=2.\n$$"}] [{:db/id #edb/ref 17592186424595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c49f7c-a1f3-56e9-95d3-4e8d7959ede8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186424584} {:answer/id #uuid "93ff253e-bb05-5ca6-8757-db5007d7fe23" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186424586} {:answer/id #uuid "9b73c0f1-2d21-5d2b-981e-9083bbda05f0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186424587} {:answer/id #uuid "bc38effb-2332-5570-8872-70a5b22fb92e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186424589} {:answer/id #uuid "cbcba230-afee-51b7-a5c4-70037d514241" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186424590}] :answer-field/correct {:db/id #edb/ref 17592186424590} :answer-field/id #uuid "29131f28-d633-5715-a931-1a4a0aae454c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424593}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f427e4e2-13a5-5d7b-8b8d-103e6b378823" :question/math-academy-id "q-79320" :question/problem "Determine the dimension of $$\n\\displaystyle \\text{Span}\\{\\begin{bmatrix}\\sqrt{2} \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0 \\\\ -3\\end{bmatrix}\\}.\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}\\sqrt{2} & 1 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $3$ pivot columns (or alternatively, $3$ non-zero rows). \n\nTherefore, the dimension of the span is $3.$"}] [{:db/id #edb/ref 17592186425337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a6cb745-49cb-5824-905d-9ab964f7c63d" :answer/type {:db/ident :answer.type/math} :answer/value "-x" :db/id #edb/ref 17592186425280} {:answer/id #uuid "6c5d4c7f-df56-5813-98e0-ce85883828a6" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186425293} {:answer/id #uuid "7edd99db-d3c6-58dd-8528-a5059e4d1e8d" :answer/type {:db/ident :answer.type/math} :answer/value "-2x" :db/id #edb/ref 17592186425294} {:answer/id #uuid "f06085c6-7cd3-5ef8-b0ca-cd0a5c5fdaf4" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186425313}] :answer-field/correct {:db/id #edb/ref 17592186425293} :answer-field/id #uuid "2859a2b8-1b13-5844-925e-cb48d7716457" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186425320} {:answer-field/choices [{:answer/id #uuid "83a03c22-b0ea-5