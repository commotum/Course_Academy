\ 2\\end{bmatrix}+(-3)\\cdot \\begin{bmatrix}6 \\\\ -4\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}15 \\\\ 0\\end{bmatrix}-(\\begin{bmatrix}10 \\\\ 10\\end{bmatrix}+\\begin{bmatrix}-18 \\\\ 12\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}15 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}-8 \\\\ 22\\end{bmatrix} \\\\\n&= \\begin{bmatrix}23 \\\\ -22\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186509527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53c01dee-7877-566f-b609-2bc0c1264bad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}13 \\\\ 19\\end{bmatrix}" :db/id #edb/ref 17592186509487} {:answer/id #uuid "57099cfb-100b-5358-919b-196056ae1aaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186509489} {:answer/id #uuid "77d36b79-2a8d-54b2-b668-0b91c20e1451" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-29 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186509502} {:answer/id #uuid "8de45366-79cb-555f-82e5-11746b4cd801" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-27 \\\\ -21\\end{bmatrix}" :db/id #edb/ref 17592186509511} {:answer/id #uuid "9edfd946-3c36-56e8-98d2-bc4cccad967f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-57 \\\\ -21\\end{bmatrix}" :db/id #edb/ref 17592186509519}] :answer-field/correct {:db/id #edb/ref 17592186509489} :answer-field/id #uuid "665f7925-4040-5cd7-889e-8b922ec3a082" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509494}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b41cbf21-c9de-5717-8665-c9ed20c4a407" :question/problem "Let $$\n\\displaystyle a=\\begin{bmatrix}7 \\\\ 1\\end{bmatrix},\n$$ $$\n\\displaystyle b=\\begin{bmatrix}-5 \\\\ 0\\end{bmatrix}\n$$ and $$\n\\displaystyle c=\\begin{bmatrix}-7 \\\\ -6\\end{bmatrix}.\n$$ Find $(-3)a-((-3)b+3c).$" :