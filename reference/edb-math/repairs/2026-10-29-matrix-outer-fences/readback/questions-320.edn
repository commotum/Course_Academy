0 \\\\ -1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}5 \\\\ 1 \\\\ 0 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-6 \\\\ -2 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}3 \\\\ 1 \\\\ -1 \\\\ -2\\end{bmatrix}\\})=2.\n$$"}]}
