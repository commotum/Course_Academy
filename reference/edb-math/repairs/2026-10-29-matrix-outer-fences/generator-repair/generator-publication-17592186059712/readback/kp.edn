{bmatrix}\\right) \\\\\n&= \\begin{bmatrix}-12 \\\\ 8\\end{bmatrix}-\\left(\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ -4\\end{bmatrix}\\right) \\\\\n&= \\begin{bmatrix}-12 \\\\ 8\\end{bmatrix}-\\begin{bmatrix}4 \\\\ 11\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-16 \\\\ -3\\end{bmatrix}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186637651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d0db60-2113-5589-904c-a3d5aa97379e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 \\\\ -17\\end{bmatrix}" :db/id #edb/ref 17592186637625} {:answer/id #uuid "4df57d4d-5121-54a6-9412-a901a9a9bb90" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-45 \\\\ 32\\end{bmatrix}" :db/id #edb/ref 17592186637631} {:answer/id #uuid "6e84776d-55f0-5ad4-806b-dd194787e2b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}20 \\\\ -17\\end{bmatrix}" :db/id #edb/ref 17592186637633} {:answer/id #uuid "8d49a4de-61ad-52de-828c-8e9cff0477af" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-36 \\\\ 23\\end{bmatrix}" :db/id #edb/ref 17592186637637} {:answer/id #uuid "d9e0b307-4ac1-5534-b118-3d8a23ab816a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}35 \\\\ -32\\end{bmatrix}" :db/id #edb/ref 17592186637646}] :answer-field/correct {:answer/id #uuid "d9e0b307-4ac1-5534-b118-3d8a23ab816a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}35 \\\\ -32\\end{bmatrix}" :db/id #edb/ref 17592186637646} :answer-field/id #uuid "6c7b34dc-76f4-504e-a427-72460042c71c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637632}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ef61d01f-334b-5b41-8f63-4b28993e4a54" :question/problem "Let the column vectors be\n\n<div class=\"matrix-operands\">\n<div>$a=\\begin{bmatrix}-5 \\\\ 0\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-8 \\\\ 3\\end{bmatrix}$</div>\n<div>$c=\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}$</div>\n</div>\n\nFind $4c + ((-4)b + a)$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n4c + ((-4)b + a) &= 4\\cdot \\begin{bmatrix}2 \\\\ -5\\end{bmatrix}+\\left((-4)\\cdot \\begin{bmatrix}-8 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 0\\end{bmatrix}\\right) \\\\\n&= \\begin{bmatrix}8 \\\\ -20\\end{bmatrix}+\\left(\\begin{bmatrix}32 \\\\ -12\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 0\\end{bmatrix}\\right) \\\\\n&= \\begin{bmatrix}8 \\\\ -20\\end{bmatrix}+\\begin{bmatrix}27 \\\\ -12\\end{bmatrix} \\\\\n&= \\begin{bmatrix}35 \\\\ -32\\end{bmatrix}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186637654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "150a27d6-510b-5098-86f1-f9fa0676c04d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-30 \\\\ -21\\end{bmatrix}" :db/id #edb/ref 17592186637627} {:answer/id #uuid "7ef9b3a8-5bb2-50a1-96d6-e52a6924b69b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-29 \\\\ 18\\end{bmatrix}" :db/id #edb/ref 17592186637635} {:answer/id #uuid "c75a88ed-a383-56c9-9d06-536bb28c0b8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}34 \\\\ 33\\end{bmatrix}" :db/id #edb/ref 17592186637642} {:answer/id #uuid "e09c7bc0-ef1a-5ab4-af5c-c66a3e01f8a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}19 \\\\ 42\\end{bmatrix}" :db/id #edb/ref 17592186637648} {:answer/id #uuid "fe67baea-2825-5436-8983-b62a0876d347" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186637653}] :answer-field/correct {:answer/id #uuid "150a27d6-510b-5098-86f1-f9fa0676c04d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-30 \\\\ -21\\end{bmatrix}" :db/id #edb/ref 17592186637627} :answer-field/id #uuid "eb8a282c-a5af-504d-88f7-6ac7bbd1d908" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637650}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ffebef0f-625e-56dd-9e44-72c9b6b3611c" :question/problem "Let the column vectors be\n\n<div class=\"matrix-operands\">\n<div>$a=\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-8 \\\\ -3\\end{bmatrix}$</div>\n<div>$c=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}$</div>\n</div>\n\nFind $2c - (2a - 5b)$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n2c - (2a - 5b) &= 2\\cdot \\begin{bmatrix}4 \\\\ 3\\end{bmatrix}-\\left(2\\cdot \\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}-5\\cdot \\begin{bmatrix}-8 \\\\ -3\\end{bmatrix}\\right) \\\\\n&= \\begin{bmatrix}8 \\\\ 6\\end{bmatrix}-\\left(\\begin{bmatrix}-2 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}-40 \\\\ -15\\end{bmatrix}\\right) \\\\\n&= \\begin{bmatrix}8 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}38 \\\\ 27\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-30 \\\\ -21\\end{bmatrix}\n\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}]}
