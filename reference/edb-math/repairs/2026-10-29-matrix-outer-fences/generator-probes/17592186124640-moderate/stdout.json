[{"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "267173de-ca8d-5eea-9434-feebbcddfd48", ":question/difficulty": ":question.difficulty/moderate", ":question/problem": "Find the domain of the function $f(x,y)=\\frac{\\ln\\left(2x+y\\right)}{e^{x}}.$", ":question/worked-solution": "The logarithm requires $2x+y>0$.\n\nThe denominator $e^{x}$ is positive for every real input, so it never vanishes.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}2x+y>0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb{R}^{2}:\\,2x+y>0\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "4d4ec8cc-eede-5567-8821-4cd2214d71d4", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "bc7b8946-9fd0-558a-8f22-cb556e52a39e", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,2x+y\\ge 0\\}"}, {":answer/id": "84efb450-ea1d-57dc-b8a3-14bb6dfad744", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&2x+y>0 \\\\ &2x+y\\ne 1\\end{aligned}\\right\\}"}, {":answer/id": "3f7d532e-527f-5e4e-93d9-4a63f44c7b8c", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&2x+y\\ne 0 \\\\ &x\\ne 0\\end{aligned}\\right\\}"}, {":answer/id": "1d397511-5658-5219-afaa-e7cdf590a4db", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,2x+y\\ne 0\\}"}, {":answer/id": "478deeef-9332-5531-8b4e-38c656b82b3c", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,2x+y>0\\}"}], ":answer-field/correct": [":answer/id", "478deeef-9332-5531-8b4e-38c656b82b3c"]}]}, "generation": {"family": "log_exp", "parameters": {"u": "2x+y", "v": "x", "w": "y", "op": "two", "power": 1, "numerator": "y^{2}", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["q-158185"], "conversions": [], "math_format": "course-academy-tex-v1"}}, {"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "2767da74-4fe6-55a0-97e3-3aac3ad513c9", ":question/difficulty": ":question.difficulty/moderate", ":question/problem": "Find the domain of the function $f(x,y)=\\frac{x^{3}}{\\ln\\left(x^{2}-y^{2}\\right)}.$", ":question/worked-solution": "The logarithm requires $x^{2}-y^{2}>0$. Its value is a denominator, so it must also be nonzero.\n\nOn positive inputs, $\\ln\\left(x^{2}-y^{2}\\right)=0$ exactly when $x^{2}-y^{2}=1$. Thus we must exclude $x^{2}-y^{2}=1$, even when the numerator is zero.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}x^{2}-y^{2}>0 \\\\ x^{2}-y^{2}\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x^{2}-y^{2}>0 \\\\ &x^{2}-y^{2}\\ne 1\\end{aligned}\\right\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "f782be52-a325-5eb2-acc6-85362e760558", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "af5ac77b-74c0-5889-925e-5c7de1df1a45", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x^{2}-y^{2}>0 \\\\ &x^{2}-y^{2}\\ne 1\\end{aligned}\\right\\}"}, {":answer/id": "484e2719-83a4-57c4-8c90-b560c1bcaa3a", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x^{2}-y^{2}\\ge 0 \\\\ &x^{2}-y^{2}\\ne 1\\end{aligned}\\right\\}"}, {":answer/id": "0866dedf-7ce3-538e-9301-9ee25012c946", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x^{2}-y^{2}\\ne 0 \\\\ &x^{2}-y^{2}\\ne 1\\end{aligned}\\right\\}"}, {":answer/id": "0e27f287-faec-5d64-b9ab-a85161a01afc", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,x^{2}-y^{2}>1\\}"}, {":answer/id": "81cd9e65-e6b2-5792-857c-bb940cc1a641", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,x^{2}-y^{2}>0\\}"}], ":answer-field/correct": [":answer/id", "af5ac77b-74c0-5889-925e-5c7de1df1a45"]}]}, "generation": {"family": "reciprocal_log", "parameters": {"u": "x^{2}-y^{2}", "v": "y-2", "w": "x", "op": "exp", "power": 1, "numerator": "x^{3}", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["q-158577", "q-158183"], "conversions": ["logarithm zero exactly at argument one"], "math_format": "course-academy-tex-v1"}}, {"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "68a08429-392a-5b4d-91fd-0243abe05af2", ":question/difficulty": ":question.difficulty/moderate", ":question/problem": "Find the domain of the function $f(x,y)=\\frac{\\ln\\left(-x-y+2\\right)}{\\sqrt{x+1}}.$", ":question/worked-solution": "The logarithm requires $-x-y+2>0$.\n\nThe denominator square root requires both $x+1\\ge 0$ and $\\sqrt{x+1}\\ne 0$. Together these give $x+1>0$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-x-y+2>0 \\\\ x+1>0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x-y+2>0 \\\\ &x+1>0\\end{aligned}\\right\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "2b096259-f222-519d-9acb-cadc99653cbe", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "36bf62ff-e924-5984-babd-37111e5b1885", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x-y+2\\ge 0 \\\\ &x+1>0\\end{aligned}\\right\\}"}, {":answer/id": "1adacd8e-219d-54b1-bb6b-0bbb6a2e6e27", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x-y+2>0\\}"}, {":answer/id": "853660f9-754e-5fb1-b68f-34a8c2bd9ce5", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x-y+2>0 \\\\ &x+1>0\\end{aligned}\\right\\}"}, {":answer/id": "13a1937e-d542-5ed2-850a-31baae71552f", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x-y+2>0 \\\\ &x+1\\ne 0\\end{aligned}\\right\\}"}, {":answer/id": "0af51205-34d7-5686-b2fe-4019d6988972", ":answer/type": ":answer.type/math", ":answer/value": "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x-y+2\\ne 0 \\\\ &x+1>0\\end{aligned}\\right\\}"}], ":answer-field/correct": [":answer/id", "853660f9-754e-5fb1-b68f-34a8c2bd9ce5"]}]}, "generation": {"family": "log_root", "parameters": {"u": "-x-y+2", "v": "x+1", "w": "y", "op": "sin", "power": 1, "numerator": "1", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["e-11029"], "conversions": ["nonnegative radicand and nonzero square root give positive radicand"], "math_format": "course-academy-tex-v1"}}]
