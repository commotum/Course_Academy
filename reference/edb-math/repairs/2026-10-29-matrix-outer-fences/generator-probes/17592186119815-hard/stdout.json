wer-field/type": ":answer-field.type/checkbox", ":answer-field/choices": [{":answer/id": "54feeb2f-f1f2-56f2-9884-a63965015dcf", ":answer/type": ":answer.type/text", ":answer/value": "false"}, {":answer/id": "a3f971f0-60e6-5be6-9b8f-da5a9c47f8aa", ":answer/type": ":answer.type/text", ":answer/value": "true"}], ":answer-field/correct": [":answer/id", "a3f971f0-60e6-5be6-9b8f-da5a9c47f8aa"]}, {":answer-field/id": "0e93e0be-6714-57f7-a3dc-ceb6a496eac6", ":answer-field/key": "$\\{\\mathbf{a}_{1}\\}$", ":answer-field/type": ":answer-field.type/checkbox", ":answer-field/choices": [{":answer/id": "7c35b9be-ced7-522f-a72f-e8bd9cb19ee3", ":answer/type": ":answer.type/text", ":answer/value": "false"}, {":answer/id": "d2683354-a896-5257-a3a5-06a3d333209a", ":answer/type": ":answer.type/text", ":answer/value": "true"}], ":answer-field/correct": [":answer/id", "7c35b9be-ced7-522f-a72f-e8bd9cb19ee3"]}, {":answer-field/id": "df2a9394-0107-5e43-bb32-49d1f457bb01", ":answer-field/key": "$\\{\\mathbf{a}_{1},\\mathbf{a}_{2}\\}$", ":answer-field/type": ":answer-field.type/checkbox", ":answer-field/choices": [{":answer/id": "eb216659-ea7d-5c4f-8f2b-7ef6b7716aa3", ":answer/type": ":answer.type/text", ":answer/value": "false"}, {":answer/id": "86ec8105-c5a9-56bb-98cd-ef6fa3c53cd5", ":answer/type": ":answer.type/text", ":answer/value": "true"}], ":answer-field/correct": [":answer/id", "eb216659-ea7d-5c4f-8f2b-7ef6b7716aa3"]}, {":answer-field/id": "e8227ee3-4310-5c75-ad90-ec2062b3e659", ":answer-field/key": "$\\{\\mathbf{a}_{2},\\mathbf{a}_{3}\\}$", ":answer-field/type": ":answer-field.type/checkbox", ":answer-field/choices": [{":answer/id": "68b561fe-9a30-57cc-9d02-cd596ad5c385", ":answer/type": ":answer.type/text", ":answer/value": "false"}, {":answer/id": "3925ee9a-ded0-5bd8-a713-d213bfab6149", ":answer/type": ":answer.type/text", ":answer/value": "true"}], ":answer-field/correct": [":answer/id", "68b561fe-9a30-57cc-9d02-cd596ad5c385"]}, {":answer-field/id": "66a6af32-da64-51a2-9d6e-c561