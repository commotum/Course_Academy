[{"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "8d2f18ef-7b7f-5d7f-a788-111ca0faceed", ":question/difficulty": ":question.difficulty/easy", ":question/problem": "Find the domain of the function $f(x,y)=2^{\\sqrt{-x+2y+1}}.$", ":question/worked-solution": "The square root requires $-x+2y+1\\ge 0$. The outer function is defined for every real input and adds no further restriction.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-x+2y+1\\ge 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y+1\\ge 0\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "391e7822-8f7c-57b4-ace4-8a670c064f7e", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "90a087ce-7de0-555c-8688-a2b1c1584045", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y+1\\ne 0\\}"}, {":answer/id": "5a8fb9e2-b999-547c-8622-cb5b0dcc5b88", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,0\\le -x+2y+1\\le 1\\}"}, {":answer/id": "19f69bfd-c25b-5a37-a19b-489f927bc43b", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y+1\\ge 0\\}"}, {":answer/id": "3561420b-66b3-5b2c-a85e-29cce272718d", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y+1<0\\}"}, {":answer/id": "7f4a1139-0e28-5214-a766-7bfa558e7b75", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y+1>0\\}"}], ":answer-field/correct": [":answer/id", "19f69bfd-c25b-5a37-a19b-489f927bc43b"]}]}, "generation": {"family": "radical", "parameters": {"u": "-x+2y+1", "v": "y", "w": "x", "op": "two", "power": 1, "numerator": "x^{3}", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["q-158565"], "conversions": [], "math_format": "course-academy-tex-v1"}}, {"knowledge_point": {"db_id": 17592186124640, "id": "88f2bc84-03e8-5921-81e2-683a09195279"}, "question": {":question/id": "b528520d-48d1-50f6-804d-cb25c9590bc4", ":question/difficulty": ":question.difficulty/easy", ":question/problem": "Find the domain of the function $f(x,y)=\\sin\\left(\\frac{y^{2}}{x-1}\\right).$", ":question/worked-solution": "The inner quotient requires $x-1\\ne 0$. The outer function is defined for every real input and adds no further restriction.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}x-1\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb{R}^{2}:\\,x-1\\ne 0\\}.\n$$", ":question/answer-fields": [{":answer-field/id": "ab26589f-326a-50c0-ab9b-bc539cd381d9", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "93ea70c7-b5d7-5cbe-9601-1a75c26102cc", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,x-1\\ne 0\\}"}, {":answer/id": "ddda9c79-b919-584f-b040-f35afb107859", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,y^{2}\\ne 0\\}"}, {":answer/id": "12a3b8d4-7fd2-5552-9289-69fa5efa9052", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,x-1>0\\}"}, {":answer/id": "200de831-556c-5398-9d10-955ebf475266", ":answer/type": ":answer.type/math", ":answer/value": "\\{(x,y)\\in\\mathbb{R}^{2}:\\,x-1<0\\}"}, {":answer/id": "d10ff366-5eb6-5c57-a9d6-9daf92c3d0ee", ":answer/type": ":answer.type/math", ":answer/value": "\\mathbb{R}^{2}"}], ":answer-field/correct": [":answer/id", "93ea70c7-b5d7-5cbe-9601-1a75c26102cc"]}]}, "generation": {"family": "rational", "parameters": {"u": "y^{2}", "v": "x-1", "w": "y", "op": "sin", "power": 1, "numerator": "1", "root_sum": "", "nonnegative_polynomial": false}, "sources": ["q-158567"], "conversions": [], "math_format": "course-academy-tex-v1"}}, {"knowledge_point": {"db_id": 17592186124640, "i