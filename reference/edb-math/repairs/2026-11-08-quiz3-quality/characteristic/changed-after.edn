swer/id #uuid "000b796c-6d2b-5a34-9fcb-708a04b0fafa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x^{3}y^{″} + 2y = 2x^{2} + 2\\ln x" :db/id #edb/ref 17592186146881}] :answer-field/correct {:db/id #edb/ref 17592186146878} :answer-field/id #uuid "4b8e0d8b-6ce4-5676-8ad7-68d3fcd27061" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146876}] [{:answer-field/choices [{:answer/id #uuid "d002c3bf-79ca-5d2a-8e47-065765f0dcd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = x + \\frac{2}{x}" :db/id #edb/ref 17592186146889} {:answer/id #uuid "d8343815-9857-5cf8-999a-2f6b01ee217a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = x^{2} + \\frac{2}{x^{2}}" :db/id #edb/ref 17592186146890} {:answer/id #uuid "d9482828-b45e-50db-a30e-8ddd02195249" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = x^{2} - \\frac{1}{x^{2}}" :db/id #edb/ref 17592186146891} {:answer/id #uuid "dee55fa4-7185-5fa1-884b-5a3875f2e83d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = x^{3} + 3x" :db/id #edb/ref 17592186146892} {:answer/id #uuid "68bb97cf-51ae-541b-8c05-33d731abd69c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = 2x - \\frac{1}{x^{2}}" :db/id #edb/ref 17592186146893}] :answer-field/id #uuid "21b213bd-f26a-5782-9baf-76437b576f9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146888}] [{:answer-field/choices [{:answer/id #uuid "828d2c05-5bef-5066-b5eb-e07255f21fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{6} + c_{2}t^{-6}" :db/id #edb/ref 17592186146895} {:answer/id #uuid "9211ec67-966b-5af8-932c-92d1dc2b112d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{-3} + c_{2}t^{-3}\\ln t" :db/id #edb/ref 17592186146896} {:answer/id #uuid "afee6923-9321-5270-b4de-12ae29be6782" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{6} + c_{2}t^{6}\\ln t" :db/id #edb/ref 17592186146897} {:answer/id #uuid "d4e69e4d-f6ab-5631-8024-4d1826c66c05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{3} + c_{2}t^{3}\\ln t" :db/id #edb/ref 17592186146898} {:answer/id #uuid "e84a6e87-8004-5548-bc6b-b6d302d441e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{3} + c_{2}\\ln t" :db/id #edb/ref 17592186146899}] :answer-field/correct {:db/id #edb/ref 17592186146898} :answer-field/id #uuid "c38a0d72-2264-5fad-8897-9dd1bc343b56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146894}] [{:answer-field/choices [{:answer/id #uuid "b533a07a-2e0b-5a93-b8b4-8ea517acc9de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 3t^{2} - t^{2}\\ln t" :db/id #edb/ref 17592186146901} {:answer/id #uuid "16ba5716-e0f1-507a-b29a-a99c7e8739ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = t^{2} + 3" :db/id #edb/ref 17592186146902} {:answer/id #uuid "2e289c91-8c17-5d54-8e3c-9c9df08d44d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 3t^{2}\\ln t" :db/id #edb/ref 17592186146903} {:answer/id #uuid "5c8f00ed-26ad-51b2-9b0b-b02effa6e859" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 2t^{2} + t^{2}\\ln t" :db/id #edb/ref 17592186146904} {:answer/id #uuid "7ca6d5e2-21cf-5106-a3a8-337ad489c255" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 3\\ln t" :db/id #edb/ref 17592186146905}] :answer-field/correct {:db/id #edb/ref 17592186146903} :answer-field/id #uuid "0355cf4f-1541-5c9f-ade1-067716169606" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146900}] [{:db/id #edb/ref 17592186148183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfb6fbce-eeec-5af8-947a-298441cf5af3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = c_{1}x^{3} + c_{2}x" :db/id #edb/ref 17592186146853} {:answer/id #uuid "01342d54-8f54-5896-92cf-f267de1e169b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = c_{1}x^{-3} + c_{2}" :db/id #edb/ref 17592186146854} {:answer/id #uuid "0afdf4b3-ee3d-5393-9f5d-1276f9198cc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = c_{1}x^{3} + c_{2}x^{-1}" :db/id #edb/ref 17592186146855} {:answer/id #uuid "24728c9f-6e90-551d-89ab-49d7fe24d6af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = c_{1}x^{-3} + c_{2}x" :db/id #edb/ref 17592186146856} {:answer/id #uuid "3a7e42d8-496e-508d-b0b0-9448948b2f31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = c_{1}x + c_{2}x^{-1}" :db/id #edb/ref 17592186146857}] :answer-field/correct {:db/id #edb/ref 17592186146855} :answer-field/id #uuid "6c3c7e95-c29f-5c19-8005-512b3bd5d481" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146852}] :question/id #uuid "ad06edd0-5203-5b9e-83ee-fdf806a840a9" :question/math-academy-id "q-64715" :question/problem "Find the general solution to the equation\n$x^{2}y^{″} - xy^{′} - 3y = 0, x > 0$." :question/worked-solution "For a Cauchy-Euler equation, use the trial solution $y=x^\\lambda.$ Then $y'=\\lambda x^{\\lambda-1}$ and $y''=\\lambda(\\lambda-1)x^{\\lambda-2}.$ Substitution gives the characteristic equation\n$$\n\\lambda(\\lambda-1)-\\lambda-3=\\lambda^2-2\\lambda-3=(\\lambda-3)(\\lambda+1)=0.\n$$\nThe distinct roots are $3$ and $-1.$ Therefore, for $x>0,$\n$$\ny(x)=c_1x^3+c_2x^{-1}.\n$$"}] [{:db/id #edb/ref 17592186148186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d1d0839-8119-503d-93fc-b968d7cbba14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = \\frac{x^{2} + 5}{2x^{3}}" :db/id #edb/ref 17592186146871} {:answer/id #uuid "d015b352-f306-5030-9862-94e6cc42c090" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = x^{3}(3 - 17\\ln x)" :db/id #edb/ref 17592186146872} {:answer/id #uuid "e2c4cb4e-32f3-59ca-a00a-6a1de55ce41a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = x(3 - \\ln x)" :db/id #edb/ref 17592186146873} {:answer/id #uuid "384f6e8c-dfe4-58b5-b065-0ef25b92bb50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = \\frac{17 + x^{6}}{6x^{3}}" :db/id #edb/ref 17592186146874} {:answer/id #uuid "4b993516-1b2d-55f8-b823-07beaea047c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x) = \\frac{3 + \\ln x}{x^{3}}" :db/id #edb/ref 17592186146875}] :answer-field/correct {:db/id #edb/ref 17592186146875} :answer-field/id #uuid "7eb6aa3b-e9a1-5b8c-82f1-af08bd0fa3df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146870}] :question/id #uuid "8c5f77fe-b09a-56b3-a0f6-bf761de278c9" :question/math-academy-id "q-64778" :question/problem "Find the solution of the initial value problem\n$$\n\\displaystyle x^{2}y^{″} + 7xy^{′} + 9y = 0, y(1) = 3, y^{′}(1) =-8, x > 0.\n$$" :question/worked-solution "The characteristic equation is\n$$\n\\lambda(\\lambda-1)+7\\lambda+9=\\lambda^2+6\\lambda+9=(\\lambda+3)^2=0.\n$$\nThe repeated root $-3$ gives\n$$\ny=c_1x^{-3}+c_2x^{-3}\\ln x.\n$$\nThe condition $y(1)=3$ gives $c_1=3.$ Differentiating,\n$$\ny'=-3c_1x^{-4}+c_2x^{-4}-3c_2x^{-4}\\ln x.\n$$\nUsing $y'(1)=-8$ gives $-3c_1+c_2=-8,$ so $c_2=1.$ Therefore, for $x>0,$\n$$\ny(x)=\\frac{3+\\ln x}{x^3}.\n$$"}] [{:db/id #edb/ref 17592186148187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9069447f-0529-51f0-97f7-b783117225d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3y^{″} - 4y^{′} + 3y = x^{2}" :db/id #edb/ref 17592186146877} {:answer/id #uuid "b6d7f018-8994-52ab-ab6a-f614b8655db3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x^{2}y^{″} - 2xy^{′} + 2y = 2\\ln x" :db/id #edb/ref 17592186146878} {:answer/id #uuid "d969c34f-6a58-5090-98b9-7a16f8fc308e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3y^{″} - 2xy^{′} + 4x^{2}y = 0" :db/id #edb/ref 17592186146879} {:answer/id #uuid "ebb7be2e-e064-53ad-a569-b25fe2189cc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y^{″} - 4x^{2}y^{′} + 2y = 0" :db/id #edb/ref 17592186146880} {:answer/id #uuid "000b796c-6d2b-5a34-9fcb-708a04b0fafa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x^{3}y^{″} + 2y = 2x^{2} + 2\\ln x" :db/id #edb/ref 17592186146881}] :answer-field/correct {:db/id #edb/ref 17592186146878} :answer-field/id #uuid "4b8e0d8b-6ce4-5676-8ad7-68d3fcd27061" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146876}] :question/id #uuid "2f851863-c462-53da-9224-d0b905023e06" :question/math-academy-id "q-64779" :question/problem "Which of the following equations is an instance of the Cauchy-Euler equation?" :question/worked-solution "A second-order Cauchy-Euler equation has the form\n$$\nax^2y''+bxy'+cy=f(x),\n$$\nwhere $a,b,c$ are constants and $a\\ne0.$ The listed equation\n$$\n3x^2y''-2xy'+2y=2\\ln x\n$$\nhas $a=3,$ $b=-2,$ $c=2,$ and $f(x)=2\\ln x.$ Each other option has a derivative or $y$ coefficient with the wrong power of $x.$ Therefore, this is the only listed Cauchy-Euler equation."}] [{:db/id #edb/ref 17592186148189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7796b0d-7c3f-52d0-bd67-e5e393fd39f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x)=2x-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186370974} {:answer/id #uuid "0487f2ef-1b76-5ca4-8759-092e0583d59d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x)={x}^{2}+\\frac{2}{{x}^{2}}" :db/id #edb/ref 17592186370975} {:answer/id #uuid "d284f6ce-1e8e-510a-8bde-b07edef7d19d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x)=x+\\frac{2}{x}" :db/id #edb/ref 17592186370976} {:answer/id #uuid "60cdb5ed-9520-5f38-9c72-9a4ee90513eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x)={x}^{2}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186370977} {:answer/id #uuid "5647fa9f-f8a1-5355-958d-ac9f76d96fcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(x)={x}^{3}+3x" :db/id #edb/ref 17592186370978}] :answer-field/correct {:db/id #edb/ref 17592186370977} :answer-field/id #uuid "c7e74405-08e9-573c-9649-955a41263462" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186370973}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0e49f63d-ced4-572f-9e71-2b50cc22b586" :question/math-academy-id "q-64811" :question/problem "Find the solution to the initial value problem\n\n$$\n{x}^{2}{y}^{″}+x{y}^{′}-4y=0,\\,y(1)=0,\\,{y}^{′}(1)=4,\\,x>0.\n$$" :question/worked-solution "Note that the given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}+x\\cdot \\lambda {x}^{\\lambda -1}-4{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }+\\lambda {x}^{\\lambda }-4{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[\\lambda (\\lambda -1)+\\lambda -4] & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)+\\lambda -4 & =0 \\\\ {\\lambda }^{2}-4 & =0 \\\\ (\\lambda -2)(\\lambda +2) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =\\pm 2.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{2}+{c}_{2}{x}^{-2}={c}_{1}{x}^{2}+\\frac{{c}_{2}}{{x}^{2}}.\n$$\n\nNow let's find the constants ${c}_{1}$ and ${c}_{2}.$\n\nSubstituting $y(1)=0$ into the general solution gives\n\n$$\n0={c}_{1}+{c}_{2}\\,⇒\\,{c}_{2}=-{c}_{1}.\n$$\n\nWe now need to apply the condition ${y}^{′}(1)=4.$ First, we differentiate $y$ to find ${y}^{′}$:\n\n$$\n\\begin{aligned}{y}^{′} & =2{c}_{1}x-2\\frac{{c}_{2}}{{x}^{3}}\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=4$ into the above gives\n\n$$\n\\begin{aligned}4 & =2{c}_{1}-2{c}_{2} \\\\ 2 & ={c}_{1}-{c}_{2} \\\\ 2 & ={c}_{1}-(-{c}_{1}) \\\\ {c}_{1} & =1\\,⇒\\,{c}_{2}=-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x)={x}^{2}-\\frac{1}{{x}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186148190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "828d2c05-5bef-5066-b5eb-e07255f21fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{6} + c_{2}t^{-6}" :db/id #edb/ref 17592186146895} {:answer/id #uuid "9211ec67-966b-5af8-932c-92d1dc2b112d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{-3} + c_{2}t^{-3}\\ln t" :db/id #edb/ref 17592186146896} {:answer/id #uuid "afee6923-9321-5270-b4de-12ae29be6782" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{6} + c_{2}t^{6}\\ln t" :db/id #edb/ref 17592186146897} {:answer/id #uuid "d4e69e4d-f6ab-5631-8024-4d1826c66c05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{3} + c_{2}t^{3}\\ln t" :db/id #edb/ref 17592186146898} {:answer/id #uuid "e84a6e87-8004-5548-bc6b-b6d302d441e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = c_{1}t^{3} + c_{2}\\ln t" :db/id #edb/ref 17592186146899}] :answer-field/correct {:db/id #edb/ref 17592186146898} :answer-field/id #uuid "c38a0d72-2264-5fad-8897-9dd1bc343b56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146894}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dadb2653-fa33-5c67-b21a-f4fc2e901bda" :question/math-academy-id "q-64876" :question/problem "Find the general solution to the equation\n$3t^{2}y^{″} - 15ty^{′} + 27y = 0, t > 0$." :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}3{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}-15t\\cdot \\lambda {t}^{\\lambda -1}+27{t}^{\\lambda } & =0 \\\\ 3\\lambda (\\lambda -1){t}^{\\lambda }-15\\lambda {t}^{\\lambda }+27{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[3\\lambda (\\lambda -1)-15\\lambda +27] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}3\\lambda (\\lambda -1)-15\\lambda +27 & =0 \\\\ 3{\\lambda }^{2}-18\\lambda +27 & =0 \\\\ 3({\\lambda }^{2}-6\\lambda +9) & =0 \\\\ 3(\\lambda -3)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =3.$\nTherefore, the general solution is\n\n$$\ny(t)={c}_{1}{t}^{3}+{c}_{2}{t}^{3}\\operatorname{ln} t.\n$$"}] [{:db/id #edb/ref 17592186148191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b533a07a-2e0b-5a93-b8b4-8ea517acc9de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 3t^{2} - t^{2}\\ln t" :db/id #edb/ref 17592186146901} {:answer/id #uuid "16ba5716-e0f1-507a-b29a-a99c7e8739ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = t^{2} + 3" :db/id #edb/ref 17592186146902} {:answer/id #uuid "2e289c91-8c17-5d54-8e3c-9c9df08d44d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 3t^{2}\\ln t" :db/id #edb/ref 17592186146903} {:answer/id #uuid "5c8f00ed-26ad-51b2-9b0b-b02effa6e859" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 2t^{2} + t^{2}\\ln t" :db/id #edb/ref 17592186146904} {:answer/id #uuid "7ca6d5e2-21cf-5106-a3a8-337ad489c255" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(t) = 3\\ln t" :db/id #edb/ref 17592186146905}] :answer-field/correct {:db/id #edb/ref 17592186146903} :answer-field/id #uuid "0355cf4f-1541-5c9f-ade1-067716169606" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146900}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb282e4d-658f-5955-aa68-61cd7cfcadc3" :question/math-academy-id "q-64881" :question/problem "Find the solution of the initial value problem\n$$\n\\displaystyle 2t^{2}y^{″} - 6ty^{′} + 8y = 0, y(1) = 0, y^{′}(1) = 3, t > 0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}2{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}-6t\\cdot \\lambda {t}^{\\lambda -1}+8{t}^{\\lambda } & =0 \\\\ 2\\lambda (\\lambda -1){t}^{\\lambda }-6\\lambda {t}^{\\lambda }+8{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[2\\lambda (\\lambda -1)-6\\lambda +8] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}2\\lambda (\\lambda -1)-6\\lambda +8 & =0 \\\\ 2{\\lambda }^{2}-8\\lambda +8 & =0 \\\\ 2({\\lambda }^{2}-4\\lambda +4) & =0 \\\\ 2(\\lambda -2)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =2.$\nTherefore, the general solution is\n\n$$\ny(t)={c}_{1}{t}^{2}+{c}_{2}{t}^{2}\\operatorname{ln} t.\n$$\n\nNow let's find the constants ${c}_{1}$ and ${c}_{2}.$\n\nSubstituting $y(1)=0$ into the general solution gives\n\n$$\n0={c}_{1}.\n$$\n\nWe now need to apply the condition ${y}^{′}(1)=3.$ First, we differentiate $y$ to find ${y}^{′}$:\n\n$$\n\\begin{aligned}{y}^{′} & =2t{c}_{1}+{c}_{2}t+2{c}_{2}t\\operatorname{ln} t\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=3$ and ${c}_{1}=0$ into the above gives\n\n$$\n\\begin{aligned}3 & =2{c}_{1}+{c}_{2} \\\\ 3 & =0+{c}_{2} \\\\ {c}_{2} & =3.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)=3{t}^{2}\\operatorname{ln} t.\n$$"}] [{:db/id #edb/ref 17592186148748 :tutorial/content "The second-order Cauchy-Euler equation has the form\n\n$$\nax^2y''+bxy'+cy=f(x),\n$$\n\nwhere $a,b,$ and $c$ are constants and $a\\ne0.$ We work on $x>0.$\n\nThe corresponding homogeneous equation ($f(x)=0$) can be solved using a trial solution $y=x^\\lambda,$ where $\\lambda$ is a constant to be found. To illustrate, let's solve the following Cauchy-Euler equation:\n\n$$\nx^2y''+xy'-9y=0\n$$\n\nDifferentiating the trial solution $y = x^\\lambda$ with respect to $x$ gives\n\n$$\ny' = \\lambda x^{\\lambda -1}, \\qquad y'' = \\lambda(\\lambda-1)x^{\\lambda-2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\lambda (\\lambda -1){x}^{\\lambda -2}+x\\lambda {x}^{\\lambda -1}-9{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }+\\lambda {x}^{\\lambda }-9{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }(\\lambda (\\lambda -1)+\\lambda -9) & =0.\\end{aligned}\n$$\n\nSo, we have the following characteristic equation:\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)+\\lambda -9 & =0 \\\\ {\\lambda }^{2}-9 & =0 \\\\ \\lambda  & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the general solution is \n\n$$\n\\begin{aligned}y(x) & ={c}_{1}{x}^{3}+{c}_{2}{x}^{-3} \\\\  & ={c}_{1}{x}^{3}+\\frac{{c}_{2}}{{x}^{3}}.\\end{aligned}\n$$" :tutorial/id #uuid "98a1c410-90bd-5aa5-b600-e871f7d98410" :tutorial/math-academy-id 4070 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186148754 :tutorial/content "For $x>0,$ when the characteristic equation of a Cauchy-Euler equation has a repeated root $\\lambda = c,$ the general solution is\n\n$$\ny(x) = c_1 x^c + c_2 x^c \\ln x.\n$$\n\nTo illustrate, let's solve the following Cauchy-Euler equation:\n\n$$\nx^2y''-xy'+y=0\n$$\n\nDifferentiating the trial solution $y = x^\\lambda$ with respect to $x$ gives\n\n$$\ny' = \\lambda x^{\\lambda -1}, \\qquad y'' = \\lambda(\\lambda-1)x^{\\lambda-2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\lambda (\\lambda -1){x}^{\\lambda -2}-x\\lambda {x}^{\\lambda -1}+{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }-\\lambda {x}^{\\lambda }+{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }(\\lambda (\\lambda -1)-\\lambda +1) & =0.\\end{aligned}\n$$\n\nSo, we have the following characteristic equation:\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-\\lambda +1 & =0 \\\\ {\\lambda }^{2}-2\\lambda +1 & =0 \\\\ (\\lambda -1)^{2} & =0\\end{aligned}\n$$\n\nThe characteristic equation has a double root $\\lambda = 1.$ Therefore, the general solution is \n\n$$\n\\begin{aligned}y(x) & ={c}_{1}{x}^{1}+{c}_{2}{x}^{1}\\operatorname{ln}⁡x \\\\  & ={c}_{1}x+{c}_{2}x\\operatorname{ln}⁡x.\\end{aligned}\n$$" :tutorial/id #uuid "2b81eee8-ed37-54cc-8162-fa06c20b8a79" :tutorial/math-academy-id 4097 :tutorial/title "Introduction"}] [{:answer-field/choices [{:answer/id #uuid "8bfc2fdb-4a42-5994-9537-e2225f8eb1f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 7\\cos (\\sqrt{11}x) - \\sqrt{11}\\sin (\\sqrt{11}x)" :db/id #edb/ref 17592186148950} {:answer/id #uuid "e229a207-4ef2-5d22-867b-ccab34a24868" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 7\\cos (\\sqrt{11}x) - 4\\sin (\\sqrt{11}x)" :db/id #edb/ref 17592186148951} {:answer/id #uuid "e946e55a-f081-5877-8dd6-33a721fca4e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 7\\cos (\\sqrt{11}x) + 2\\sin (\\sqrt{11}x)" :db/id #edb/ref 17592186148952} {:answer/id #uuid "011457b9-c1fa-5467-be44-8de0b082eb4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 7\\cos (\\sqrt{11}x) - \\sin (\\sqrt{11}x)" :db/id #edb/ref 17592186148953} {:answer/id #uuid "2c46909d-4cc1-5ebf-853b-6b12ed2aabb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 7\\cos (\\sqrt{11}x) - \\frac{4\\sqrt{11}}{11}\\sin (\\sqrt{11}x)" :db/id #edb/ref 17592186148954}] :answer-field/correct {:db/id #edb/ref 17592186148951} :answer-field/id #uuid "c923a4d5-1e96-5cfb-9e2d-1463a34bb868" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186148949}] [{:answer-field/choices [{:answer/id #uuid "d81758a1-467b-530b-82ed-1a512ef72718" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{-x}(3\\cos 2x - \\sin 2x)" :db/id #edb/ref 17592186148956} {:answer/id #uuid "d99d5a15-a222-54c7-bf19-f74127e55acf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{-x}(3\\cos 2x + \\sin 2x)" :db/id #edb/ref 17592186148957} {:answer/id #uuid "0a66397c-0490-5072-82c9-2d2240deff6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 3e^{-x}\\cos 2x" :db/id #edb/ref 17592186148958} {:answer/id #uuid "0be5b4db-ddce-59e9-827e-5021dec2fd58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{-2x}(3\\cos x - 5\\sin x)" :db/id #edb/ref 17592186148959} {:answer/id #uuid "791b2684-a257-53cb-84b7-354943b2e2aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 5e^{-2x}\\sin x + 3\\cos x" :db/id #edb/ref 17592186148960}] :answer-field/correct {:db/id #edb/ref 17592186148956} :answer-field/id #uuid "90656c46-dd4f-5081-ac12-2c172a198ac4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186148955}] [{:answer-field/choices [{:answer/id #uuid "b84d0516-abe6-519f-8b0b-3cfa502bafc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 5e^{-5x} + 28xe^{-5x}" :db/id #edb/ref 17592186151182} {:answer/id #uuid "fecd06bf-6d1f-5b42-93af-6e13a6dc6a3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = 5e^{-5x} + 20xe^{-5x}" :db/id #edb/ref 17592186151183} {:answer/id #uuid "307a4c35-5bf4-51b8-9ebb-a26