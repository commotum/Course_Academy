#edb/ref 17592186045493} :db/id #edb/ref 17592186086729}] :question/id #uuid "fe1a8631-6bfd-5fe9-b01a-13ec3b59f409" :question/math-academy-id "q-7791" :question/problem "Find the general solution to the equation\n$$\n\\displaystyle \\frac{d^{2}y}{dx^{2}} + 6\\frac{dy}{dx} + 9y = 0.\n$$" :question/worked-solution "Assuming $y=e^{\\lambda x}$ gives the characteristic equation\n$$\n\\lambda^2+6\\lambda+9=(\\lambda+3)^2=0.\n$$\nThe repeated root is $\\lambda=-3,$ so the general solution is\n$$\ny=Ae^{-3x}+Bxe^{-3x}.\n$$"}] [{:db/id #edb/ref 17592186088352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d31c5aa5-e21b-5aa6-8a43-29a2d9edeec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{3x}(P\\cos 2x + Q\\sin 2x)" :db/id #edb/ref 17592186086766} {:answer/id #uuid "ffa61304-a7cd-5231-8a0c-f84802f13c39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{-2x}(P\\cos 3x + Q\\sin 3x)" :db/id #edb/ref 17592186086767} {:answer/id #uuid "5f1735af-473f-5642-80dd-1dc7a38229d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{x}(P\\cos 2x + Q\\sin 2x)" :db/id #edb/ref 17592186086768} {:answer/id #uuid "63acf51b-4186-5bed-92bb-0ddbafcc25b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{2x}(P\\cos 3x + Q\\sin 3x)" :db/id #edb/ref 17592186086769} {:answer/id #uuid "7ef0cec0-58a3-593c-877b-d151e302f37c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = e^{x}(P\\cos 3x + Q\\sin 3x)" :db/id #edb/ref 17592186086770}] :answer-field/correct {:db/id #edb/ref 17592186086769} :answer-field/id #uuid "a4638042-b914-54a3-95e7-19aa70fcdf77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086765}] :question/id #uuid "77a2a4de-12d5-58ff-a712-904e8166cd22" :question/math-academy-id "q-7817" :question/problem "Find the general solution to the equation\n$$\n\\displaystyle \\frac{d^{2}y}{dx^{2}} - 4\\frac{dy}{dx} + 13y = 0.\n$$" :ques