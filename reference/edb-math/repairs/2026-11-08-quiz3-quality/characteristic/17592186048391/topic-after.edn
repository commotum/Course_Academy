/ident :answer.type/math} :answer/value "7{e}^{7x}" :db/id #edb/ref 17592186421911} {:answer/id #uuid "4deac328-5c08-5937-b799-6f57cf09acfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-x}" :db/id #edb/ref 17592186421912} {:answer/id #uuid "646c2a9c-ee6b-59ef-abca-48eaa42e7b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{e}^{-x}-7{e}^{7x}" :db/id #edb/ref 17592186421914} {:answer/id #uuid "a500bf2b-0bcf-52aa-8621-3db9d47c8750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6x}+{e}^{7x}" :db/id #edb/ref 17592186421919} {:answer/id #uuid "f5419660-dfd9-56ab-8bf3-1a8501f74f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-x}+{e}^{7x}" :db/id #edb/ref 17592186421922}] :answer-field/correct {:answer/id #uuid "a500bf2b-0bcf-52aa-8621-3db9d47c8750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6x}+{e}^{7x}" :db/id #edb/ref 17592186421919} :answer-field/id #uuid "4c296597-6c06-5bf8-aa85-d5015907d1ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421924}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ab1d8df9-7551-58b4-b23c-3a36ae997ae9" :question/math-academy-id "q-130122" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}-6{y}^{′}-7y=0,$ which of the following **cannot** be $y(x)?$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-6\\lambda {e}^{\\lambda x}-7{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-6\\lambda -7) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-6\\lambda -7 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +1)(\\lambda -7)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-1$ or $\\lambda =7.$\n\nTherefore, any linear combination of the functions ${e}^{-x}$ and ${e}^{7x}$ is a solution to the original differential equation. \n\nAmong the given options, only ${e}^{6x}+{e}^{7x}$ is not a solution."} {:db/id #edb/ref 17592186427572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bda799f-2dc1-508a-b332-a2dc15ad6469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{-5t}-4{e}^{2t}" :db/id #edb/ref 17592186427566} {:answer/id #uuid "463b0c74-3f5f-5ede-984f-20e81cf9dab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-5t}+6{e}^{2t}" :db/id #edb/ref 17592186427567} {:answer/id #uuid "6a3822e6-4ea3-5bd8-88d6-1f35c1d51f37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{-5t}+2{e}^{-2t}" :db/id #edb/ref 17592186427568} {:answer/id #uuid "bbd12f7d-a1de-5498-8a07-57a3b71dfca4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{e}^{-5t}" :db/id #edb/ref 17592186427569} {:answer/id #uuid "e0c2bf7c-2f4c-5e0e-8a59-5fd6f0e6f6d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{2t}" :db/id #edb/ref 17592186427570}] :answer-field/correct {:answer/id #uuid "6a3822e6-4ea3-5bd8-88d6-1f35c1d51f37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{-5t}+2{e}^{-2t}" :db/id #edb/ref 17592186427568} :answer-field/id #uuid "8f1bdcac-c8f7-5ea7-bb80-b176a1307c71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427571}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "128c4108-f47c-515a-aaac-ed93eb92e39c" :question/math-academy-id "q-64708" :question/problem "Given that $y=y(t)$ satisfies the equation ${y}^{″}+3{y}^{′}-10y=0,$ which of the following **cannot** be $y(t)?$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+3\\lambda {e}^{\\lambda t}-10{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+3\\lambda -10) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+3\\lambda -10 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +5)(\\lambda -2)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-5$ or $\\lambda =2.$\n\nTherefore, any linear combination of the functions ${e}^{-5t}$ and ${e}^{2t}$ is a solution to the original differential equation. \n\nAmong the given options, only $-3{e}^{-5t}+2{e}^{-2t}$ is not a solution."} {:db/id #edb/ref 17592186503728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7a6d1e-b67a-5086-8d8e-bc807158948a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6x}" :db/id #edb/ref 17592186503095} {:answer/id #uuid "4e1371dc-c00c-5e29-9079-f6bee21cefbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1-2x}" :db/id #edb/ref 17592186503131} {:answer/id #uuid "96581053-e51a-57c0-91dc-cdedecceb889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{-2x}+2{e}^{-4x}" :db/id #edb/ref 17592186503276} {:answer/id #uuid "e52cdcee-ace6-5887-9332-30bbc7af4b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6-4x}" :db/id #edb/ref 17592186503450} {:answer/id #uuid "eca2abbd-fc58-5d08-8f21-69f9b411e1fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}+{e}^{-4x}" :db/id #edb/ref 17592186503465}] :answer-field/correct {:answer/id #uuid "3d7a6d1e-b67a-5086-8d8e-bc807158948a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6x}" :db/id #edb/ref 17592186503095} :answer-field/id #uuid "8ea658b1-8a5c-53c8-b110-9aef693ebefd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503585}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ac3ed9ab-9e20-50c1-a2df-d0e7acffd405" :question/math-academy-id "q-90726" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+6{y}^{′}+8y=0,$ which of the following **cannot** be $y(x)?$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +8 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda +4)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-2$ or $\\lambda =-4.$\n\nTherefore, any linear combination of the functions ${e}^{-2x}$ and ${e}^{-4x}$ is a solution to the original differential equation. \n\nAmong the given options, only ${e}^{-6x}$ is not a solution."}] :knowledge-point/title "Identifying Non-Solutions of Second-Order Homogeneous ODEs"}] :topic/math-academy-id 614 :topic/title "Second-Order Homogeneous ODEs: Characteristic Equations With Distinct Real Roots"}]}
