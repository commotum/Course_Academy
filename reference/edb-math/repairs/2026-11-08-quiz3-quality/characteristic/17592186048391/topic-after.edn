052b-58a5-8e5a-622fd4d5ea6a" :question/math-academy-id "q-64701" :question/problem "Consider the equation ${y}^{″}-2{y}^{′}-15y=0$ where $y=y(t).$ If $y={e}^{\\lambda t}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}-2\\lambda {e}^{\\lambda t}-15{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}-2\\lambda -15) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-2\\lambda -15 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +3)(\\lambda -5)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-3$ or $\\lambda =5.$"} {:db/id #edb/ref 17592186404496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c59fbbc-2dc0-562b-b432-ce3c7f59dad3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ or $6$" :db/id #edb/ref 17592186404498} {:answer/id #uuid "c01408ce-3680-5eb5-8582-5d15eb08699d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-4$ or $2$" :db/id #edb/ref 17592186404499} {:answer/id #uuid "0e45d023-bccd-58f6-9704-f559be5f8da8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-6$ or $1$" :db/id #edb/ref 17592186404500} {:answer/id #uuid "1b463397-33ab-5e64-907b-e8904f8a0935" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ or $2$" :db/id #edb/ref 17592186404501} {:answer/id #uuid "d6e036bd-fcc3-5ff2-9e88-b80ab4086884" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ or $3$" :db/id #edb/ref 17592186404502}] :answer-field/correct {:answer/id #uuid "d6e036bd-fcc3-5ff2-9e88-b80ab4086884" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ or $3$" :db/id #edb/ref 17592186404502} :answer-field/id #uuid "117667a9-4c0a-559e-becf-2c255a4fa945" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404497}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8bfd769-670f-5f6b-bec7-13134d36de0b" :question/math-academy-id "q-90706" :question/problem "Consider the equation ${y}^{″}-{y}^{′}-6y=0$ where $y=y(x).$ If $y={e}^{\\lambda x}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-\\lambda {e}^{\\lambda x}-6{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-\\lambda -6) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-\\lambda -6 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda -3)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-2$ or $\\lambda =3.$"} {:db/id #edb/ref 17592186421926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b840a02-6e20-5e04-b9ba-9bc1e18883f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-5$ or $7$" :db/id #edb/ref 17592186421908} {:answer/id #uuid "41908330-21d9-59d9-a0b2-a53e1593c36e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-4$ or $-3$" :db/id #edb/ref 17592186421909} {:answer/id #uuid "4eb31420-e922-5f6e-bedb-6f1ece717ad4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ or $4$" :db/id #edb/ref 17592186421913} {:answer/id #uuid "7fa54804-bed0-557a-ba9a-e0d7bcc11265" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ or $7$" :db/id #edb/ref 17592186421916} {:answer/id #uuid "912dd08d-5db0-5a08-ab81-5772fdca1e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ or $4$" :db/id #edb/ref 17592186421918}] :answer-field/correct {:answer/id #uuid "7fa54804-bed0-557a-ba9a-e0d7bcc11265" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ or $7$" :db/id #edb/ref 17592186421916} :answer-field/id #uuid "dafe6fcf-90f7-529a-8290-8d2af8b5a7f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421925}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "57b50761-0ebc-5773-b974-58926652c62b" :question/math-academy-id "q-129835" :question/problem "Consider the equation ${y}^{″}-12{y}^{′}+35y=0$ where $y=y(x).$ If $y={e}^{\\lambda x}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-12\\lambda {e}^{\\lambda x}+35{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-12\\lambda +35) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-12\\lambda +35 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda -5)(\\lambda -7)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =5$ or $\\lambda =7.$"}] :knowledge-point/title "Constructing and Solving a Characteristic Equation"} {:db/id #edb/ref 17592186078495 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078338 :question/id #uuid "2065790f-428d-5477-ac77-0c5d07853143" :question/math-academy-id "e-6588" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{\\textrm{d}^2 y}{\\textrm{d} x^2} + \\frac{\\textrm{d} y}{\\textrm{d} x} - 2y =0.\n$$" :question/worked-solution "This is a second-order homogeneous ODE. So, we assume the solutions take the form $y=e^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\lambda e^{\\lambda x}, \\qquad \\dfrac{\\textrm{d}^2y}{\\textrm{d}x^2} = \\lambda^2 e^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+\\lambda {e}^{\\lambda x}-2{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+\\lambda -2) & =0.\\end{aligned}\n$$\n\nSo, we have the following characteristic equation:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+\\lambda -2 & =0 \\\\ (\\lambda -1)(\\lambda +2) & =0\\end{aligned}\n$$\n\nThe roots of the characteristic equation are $\\lambda = 1$ and $\\lambda = -2.$ Therefore, the general solution is\n\n$$\ny = Ae^{x} + Be^{- 2 x}.\n$$"} :knowledge-point/id #uuid "fe7e5c4f-6ac0-58e8-8b95-fe5a2230341c" :knowledge-point/questions [{:db/id #edb/ref 17592186079206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bec9d70-f8de-51cf-9e64-a849b809ce13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{-4x}" :db/id #edb/ref 17592186342607} {:answer/id #uuid "8f0ed665-7b86-5adb-85fc-2c91f4201111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+B{e}^{4x}" :db/id #edb/ref 17592186343490} {:answer/id #uuid "c479827f-1f07-57f4-80cf-2fa9049345a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{6x}+B{e}^{8x}" :db/id #edb/ref 17592186343966} {:answer/id #uuid "c65f01c2-eff5-56e3-8d94-e7a8e6fe2b8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{3x}" :db/id #edb/ref 17592186343978} {:answer/id #uuid "f51f0ae1-02ed-5b8f-a1ff-80e0e5ce8f7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+B{e}^{-4x}" :db/id #edb/ref 17592186344396}] :answer-field/correct {:answer/id #uuid "2bec9d70-f8de-51cf-9e64-a849b809ce13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{-4x}" :db/id #edb/ref 17592186342607} :answer-field/id #uuid "c56404db-2432-58f9-a3d9-cc82f8d56420" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344837}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b4af7b02-aa3b-5c89-83b9-f0034ff7803a" :question/math-academy-id "q-7781" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+6\\frac{\\text{d}y}{\\text{d}x}+8y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+6\\lambda +8=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda +4)=0,\n$$\n\nand so $\\lambda =-2$ or $\\lambda =-4.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+B{e}^{-4x}.\n$$"} {:db/id #edb/ref 17592186079207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a0f9485-72e1-575a-8d39-c36d01a1f161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = Ae^{-x} + Be^{-5x}" :db/id #edb/ref 17592186078021} {:answer/id #uuid "a2ca355c-f3ca-5bf5-88e1-18687f27cdef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = Ae^{-2x} + Be^{5x}" :db/id #edb/ref 17592186078022} {:answer/id #uuid "b3692ed3-4e64-5eae-a73a-687b43469fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = Ae^{-2x} + Be^{3x}" :db/id #edb/ref 17592186078023} {:answer/id #uuid "0650080f-1d71-54af-ab95-4f8958346796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = Ae^{-x} + Be^{5x}" :db/id #edb/ref 17592186078024} {:answer/id #uuid "7ccb8a32-49dd-5721-bfb7-5cbc467168e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = Ae^{2x} + Be^{-3x}" :db/id #edb/ref 17592186078025}] :answer-field/correct {:answer/id #uuid "a2ca355c-f3ca-5bf5-88e1-18687f27cdef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = Ae^{-2x} + Be^{5x}" :db/id #edb/ref 17592186078022} :answer-field/id #uuid "5f233c7e-f0db-504e-95a6-8675a27393c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186078020}] :question/id #uuid "b5dcdff1-57ea-5744-bf62-658396778f6b" :question/math-academy-id "q-7784" :question/problem "Find the general solution to the equation\n$$\n\\displaystyle \\frac{d^{2}y}{dx^{2}} - 3\\frac{dy}{dx} - 10y = 0.\n$$" :question/worked-solution "The characteristic equation is\n\n$$\n\\lambda^2-3\\lambda-10=(\\lambda-5)(\\lambda+2)=0.\n$$\n\nThe two distinct roots are $5$ and $-2$, so the general solution is\n\n$$\ny=Ae^{-2x}+Be^{5x},\n$$\n\nwhere $A$ and $B$ are arbitrary real constants."} {:db/id #edb/ref 17592186265829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a09fc5-de73-5cc7-9b01-55b17faed4d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{-x}" :db/id #edb/ref 17592186263202} {:answer/id #uuid "7779f14c-50b3-520b-91d6-2a97c1b4d4a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-x}+B{e}^{2x}" :db/id #edb/ref 17592186264037} {:answer/id #uuid "8dee922c-748c-5c16-a3a3-9b46af27a554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-x}+B{e}^{x}" :db/id #edb/ref 17592186264214} {:answer/id #uuid "978b4e8e-825b-5241-9035-2b14924b85ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{x}" :db/id #edb/ref 17592186264302} {:answer/id #uuid "a104befc-b950-5466-a5f6-df8ac36039ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{2x}" :db/id #edb/ref 17592186264369}] :answer-field/correct {:answer/id #uuid "978b4e8e-825b-5241-9035-2b14924b85ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{x}" :db/id #edb/ref 17592186264302} :answer-field/id #uuid "64d38205-f37e-5e25-ab49-76fc3955e146" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265421}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "480d405e-b6dc-5f02-bd47-92890e02436f" :question/math-academy-id "q-130114" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+\\frac{\\text{d}y}{\\text{d}x}-2y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+\\lambda {e}^{\\lambda x}-2{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+\\lambda -2) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+\\lambda -2.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda -1)=0,\n$$\n\nand so $\\lambda =-2$ or $\\lambda =1.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+B{e}^{x}.\n$$"} {:db/id #edb/ref 17592186265830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "302061b2-590e-57bc-9027-1fa52d005f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+B{e}^{x}" :db/id #edb/ref 17592186263407} {:answer/id #uuid "4137b59d-651f-5d17-9d5f-7b05b5e44095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{x}+B{e}^{4x}" :db/id #edb/ref 17592186263579} {:answer/id #uuid "5cf5d4d5-d6e9-5c36-b641-b515c21d032a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-x}+B{e}^{5x}" :db/id #edb/ref 17592186263806} {:answer/id #uuid "76ae8221-3de4-5545-bdbe-c6c34dd61a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+B{e}^{5x}" :db/id #edb/ref 17592186264032} {:answer/id #uuid "931f5078-4d07-5799-b50c-80cf55dd7ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-5x}+B{e}^{4x}" :db/id #edb/ref 17592186264261}] :answer-field/correct {:answer/id #uuid "4137b59d-651f-5d17-9d5f-7b05b5e44095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{x}+B{e}^{4x}" :db/id #edb/ref 17592186263579} :answer-field/id #uuid "08f3fbfd-de21-55e9-b36b-0dcec2a0f91f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265259}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aabd9305-103b-5e3f-a7eb-59e7abf9e597" :question/math-academy-id "q-130118" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-5\\frac{\\text{d}y}{\\text{d}x}+4y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-5\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-5\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-5\\lambda +4=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda -4)(\\lambda -1)=0,\n$$\n\nand so $\\lambda =1$ or $\\lambda =4.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{x}+B{e}^{4x}.\n$$"} {:db/id #edb/ref 17592186345343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a798c75-1028-50da-906a-6ce771bdb6db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{6x}+B{e}^{x}" :db/id #edb/ref 17592186342718} {:answer/id #uuid "675b97cc-6fe3-576e-a8b0-ea424f9b4bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-6x}+B{e}^{x}" :db/id #edb/ref 17592186343116} {:answer/id #uuid "6c0cd778-fdd7-5863-a3b0-a558825aa1ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{x}+B{e}^{2x}" :db/id #edb/ref 17592186343160} {:answer/id #uuid "8d57ddf6-b4a7-5b27-8140-3be19d35a4c1" :answer/t