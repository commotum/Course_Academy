099-39e0-503f-80b5-47847cdd5cf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(x)" :db/id #edb/ref 17592186316212}] :answer-field/correct {:answer/id #uuid "1b35725e-fded-5fd4-a9ee-50dc767a1a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(x)" :db/id #edb/ref 17592186315279} :answer-field/id #uuid "c4564c2e-fc85-5f3d-a633-81c9119858d6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317015}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9345495d-bff8-59ee-afcb-aa4b97e134b3" :question/math-academy-id "q-343294" :question/problem "$$\n{y}^{″}+\\operatorname{sin}⁡(x){y}^{′}+Q(x)y=0,\\,x>0\n$$\n\nLet ${y}_{1}$ and ${y}_{2}$ be solutions to the second-order homogeneous differential equation above, where $Q(x)$ is continuous on $(0,\\infty ).$ The Wronskian satisfies $W(\\pi )=0.$ Select the correct options in the reasoning below.\n\nThe Wronskian $W(x)$ satisfies the following first-order differential equation:\n\n$$\n{W}^{′}(x)={{field-1}}W(x)\n$$\n\nSolving this equation, we get\n\n$$\nW={{field-2}}\n$$\n\nwhere $C$ is an arbitrary constant.\n\nNow, using the fact that $W(\\pi )=0,$ we obtain \n{{field-3}}." :question/worked-solution "The separated calculation below treats $W\\ne0$. The solution $W\\equiv0$ must also be included; allowing $C=0$ in the final formula supplies it.\n\nAbel's identity says that if ${y}_{1}$ and ${y}_{2}$ are solutions of\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=0,\n$$\n\nthen their Wronskian $W(x)$ satisfies\n\n$$\n{W}^{′}(x)=-P(x)W(x).\n$$\n\nIn our equation, the coefficient of ${y}^{′}$ is \n\n$$\nP(x)=\\operatorname{sin}⁡(x).\n$$\n\nSubstituting into Abel's identity gives\n\n$$\n{W}^{′}(x)=-\\operatorname{sin}⁡(x)W(x).\n$$\n\nNow, we solve the first-order differential equation for $W:$\n\n$$\n\\begin{aligned}{W}^{′} & =-\\operatorname{sin}⁡(x)W \\\\ \\frac{\\text{d}W}{W} & =-\\operatorname{sin}⁡(x)\\text{d}x \\\\ \\int \\frac{\\text{d}W}{W} & =\\int -\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\ \\operatorname{ln}⁡|W| & =\\operatorname{cos}⁡(x)+K \\\\ |W| & ={e}^{K}{e}^{\\operatorname{cos}⁡(x)} \\\\ W & =C{e}^{\\operatorname{cos}⁡(x)}\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nNext, we use the given value $W(\\pi )=0$ to find $C:$\n\n$$\n\\begin{aligned}W(\\pi ) & =C{e}^{\\operatorname{cos}⁡(\\pi )} \\\\ 0 & =C{e}^{-1} \\\\ C & =0\\end{aligned}\n$$\n\nTherefore, we have $W(x)=0\\text{ for all }x>0.$"} {:db/id #edb/ref 17592186317386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46b44d84-ab78-5fa5-8ca8-c4a28f5f3b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{Q(x)}{x}" :db/id #edb/ref 17592186315529} {:answer/id #uuid "867155b3-187f-59d4-8cae-f4a1bb59611e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{Q(x)}" :db/id #edb/ref 17592186315874} {:answer/id #uuid "91968fda-8bdd-5212-9f81-b0342d7cb742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}" :db/id #edb/ref 17592186315930} {:answer/id #uuid "ae5ea267-9111-5d71-b0d8-b5b8b703f25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x}" :db/id #edb/ref 17592186316108}] :answer-field/correct {:answer/id #uuid "91968fda-8bdd-5212-9f81-b0342d7cb742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}" :db/id #edb/ref 17592186315930} :answer-field/id #uuid "2d21b7c6-536b-5d2b-9dfe-2a2aa392989c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316650} {:answer-field/choices [{:answer/id #uuid "0b173d16-a6f0-5c39-8247-f684d2314ba0" :answer/type {:db/id