 +6)^{2} & =-4 \\\\ \\lambda +6 & =\\pm 2\\text{i} \\\\ \\lambda  & =-6\\pm 2\\text{i}\\end{aligned}\n$$\n\nTherefore,  $\\lambda =-6\\pm 2\\text{i}$ are the complex roots of the auxiliary equation."} {:db/id #edb/ref 17592186265847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "377a1ff1-2008-568c-b9d8-3d6573556812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10\\pm 3\\text{i}" :db/id #edb/ref 17592186263498} {:answer/id #uuid "60893831-b813-5517-881b-c7747a0cef10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pm 10\\text{i}" :db/id #edb/ref 17592186263834} {:answer/id #uuid "76be65d3-7d4b-545f-9e1d-5bc3b0f64701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\pm \\text{i}" :db/id #edb/ref 17592186264033} {:answer/id #uuid "7a4dde3f-4e44-5804-8560-ced4fd5fd12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\pm 10\\text{i}" :db/id #edb/ref 17592186264060} {:answer/id #uuid "d2868b75-ccdd-5504-9349-67e1d7762925" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 10\\text{i}" :db/id #edb/ref 17592186264835}] :answer-field/correct {:answer/id #uuid "7a4dde3f-4e44-5804-8560-ced4fd5fd12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\pm 10\\text{i}" :db/id #edb/ref 17592186264060} :answer-field/id #uuid "ec22a978-7610-5a7c-badf-4b11855b1afa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265668}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "09bf58f0-609f-5f00-b876-df2e1d79119c" :question/math-academy-id "q-130164" :question/problem "Consider the equation ${y}^{″}+6{y}^{′}+109y=0,$ where $y=y(x).$ If $y={e}^{\\lambda x}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+109{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +109) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+6\\lambda +109=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +109 & =0 \\\\ ({\\lambda }^{2}+6\\lambda +9)-9+109 & =0 \\\\ (\\lambda +3)^{2}+100 & =0 \\\\ (\\lambda +3)^{2} & =-100 \\\\ \\lambda +3 & =\\pm 10\\text{i} \\\\ \\lambda  & =-3\\pm 10\\text{i}\\end{aligned}\n$$\n\nTherefore,  $\\lambda =-3\\pm 10\\text{i}$ are the complex roots of the auxiliary equation."} {:db/id #edb/ref 17592186357480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c8d8e61-ab39-56bf-b63a-f34792dd61c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2\\text{i}" :db/id #edb/ref 17592186354910} {:answer/id #uuid "2e721c96-80e2-5b71-92e3-f2502b35986d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pm 4\\text{i}" :db/id #edb/ref 17592186355066} {:answer/id #uuid "5c611244-2692-592c-a274-16a71dbd8c91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 4\\text{i}" :db/id #edb/ref 17592186355480} {:answer/id #uuid "9c4342bf-d60c-5399-8fbe-d23ca18f6aff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\pm \\text{i}" :db/id #edb/ref 17592186356050} {:answer/id #uuid "e6c98613-4c0e-57a6-9be6-d64b28330dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\pm 2\\text{i}" :db/id #edb/ref 1759218635668