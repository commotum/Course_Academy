e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\text{i}" :db/id #edb/ref 17592186355249} {:answer/id #uuid "678867c4-eb77-5a2c-8118-79cad8c88d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186355581} {:answer/id #uuid "871a1a39-79bf-5e41-be02-ee661f7504d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pm \\text{i}" :db/id #edb/ref 17592186355862} {:answer/id #uuid "998e8b09-4772-509d-b258-996ba84c2ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\pm 3\\text{i}" :db/id #edb/ref 17592186356027}] :answer-field/correct {:answer/id #uuid "678867c4-eb77-5a2c-8118-79cad8c88d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186355581} :answer-field/id #uuid "0e697071-43b7-5ea5-95db-d09a6fce8f76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356944}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6abf6154-8a42-5d1d-a162-51b8be1696db" :question/math-academy-id "q-90799" :question/problem "Consider the equation ${y}^{″}+3y=0,$ where $y=y(t).$ If $y={e}^{\\lambda t}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+3{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+3) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+3=0.\n$$\n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+3 & =0 \\\\ {\\lambda }^{2} & =-3 \\\\ \\lambda  & =\\pm \\sqrt{3}\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore,  $\\lambda =\\pm \\sqrt{3}\\,\\text{i}$ are the (purely imaginary) roots of the auxiliary equation."} {:db/id #edb/ref 17592186424417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03245522-0fe0-529f-b451-6abe8b80f779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pm \\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186424381} {:answer/id #uuid "579b2912-410b-55c0-b52c-737d3298d055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\pm \\,\\text{i}" :db/id #edb/ref 17592186424396} {:answer/id #uuid "769edc59-752e-5e12-8330-8391cd08a5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186424403} {:answer/id #uuid "b3ef9807-00e5-5ea2-a26c-7dfdf73f111b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\pm -2\\,\\text{i}" :db/id #edb/ref 17592186424406} {:answer/id #uuid "c972df8a-ed3b-5895-a3ef-2a61194b7a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\pm \\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186424408}] :answer-field/correct {:answer/id #uuid "03245522-0fe0-529f-b451-6abe8b80f779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pm \\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186424381} :answer-field/id #uuid "fe8f1d1e-565e-5be4-91dc-30880a0e6067" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424416}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "036dcc56-656f-5be3-b389-bcb0f4704c57" :question/math-academy-id "q-130165" :question/problem "Consider the equation ${y}^{″}-4{y}^{′}+6y=0,$ where $y=y(x).$ If $y={e}^{\\lambda x}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-4\\lambda {e}^{\\lambda x}+6{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-4\\lambda +6) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-4\\lambda +6=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-4\\lambda +6 & =0 \\\\ ({\\lambda }^{2}-4\\lambda +4)-4+6 & =0 \\\\ (\\lambda -2)^{2}+2 & =0 \\\\ (\\lambda -2)^{2} & =-2 \\\\ \\lambda -2 & =\\pm \\sqrt{2}\\,\\text{i} \\\\ \\lambda  & =2\\pm \\sqrt{2}\\,\\text{i}\\end{aligned}\n$$\n\nTherefore,  $\\lambda =2\\pm \\sqrt{2}\\,\\text{i}$ are the complex roots of the auxiliary equation."} {:db/id #edb/ref 17592186424420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1513401a-e1ba-5664-b3cf-95e373800e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\pm 14\\text{i}" :db/id #edb/ref 17592186424385} {:answer/id #uuid "3c8c3852-79f6-52a8-bf76-04d14a086970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 14\\text{i}" :db/id #edb/ref 17592186424391} {:answer/id #uuid "3e1e64c8-d790-53a7-bc7e-bbf555d4681b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\pm 7\\text{i}" :db/id #edb/ref 17592186424392} {:answer/id #uuid "60a91155-f0af-53ce-9e9e-3353b022d470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\pm \\text{i}" :db/id #edb/ref 17592186424399} {:answer/id #uuid "622d3756-d700-5d84-8d8b-60c8973afaed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 7\\text{i}" :db/id #edb/ref 17592186424400}] :answer-field/correct {:answer/id #uuid "622d3756-d700-5d84-8d8b-60c8973afaed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 7\\text{i}" :db/id #edb/ref 17592186424400} :answer-field/id #uuid "f015153f-8a9c-578d-9435-4dc22d6628c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424414}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "79cab45f-9e68-5df9-a9e0-9b0c3611e95a" :question/math-academy-id "q-64693" :question/problem "Consider the equation ${y}^{″}+49y=0,$ where $y=y(x).$ If $y={e}^{\\lambda x}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+49{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+49) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+49=0.\n$$\n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+49 & =0 \\\\ {\\lambda }^{2} & =-49 \\\\ \\lambda  & =\\pm 7\\text{i}.\\end{aligned}\n$$\n\nTherefore,  $\\lambda =\\pm 7\\text{i}$ are the (purely imaginary) roots of the auxiliary equation."} {:db/id #edb/ref 17592186479843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10569fcb-7e9f-575e-9509-740ee2036a5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2\\text{i}" :db/id #edb/ref 17592186479383} {:answer/id #uuid "273613c1-7c87-51dc-8032-d46e680c50a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\pm \\text{i}" :db/id #edb/ref 17592186479416} {:answer/id #uuid "3d4cc1a3-5fc9-57b5-8c0b-aee4588c2693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pm 2\\text{i}" :db/id #edb/ref 17592186479451} {:answer/id #uuid "5d807d68-7dd1-5e64-a6c9-60f86d530db1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\text{i}" :db/id #edb/ref 17592186479493} {:answer/id #uuid "9f6f7437-a625-52be-82dd-a8fe85b8d19f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pm \\text{i}" :db/id #edb/ref 17592186479602}] :answer-field/correct {:answer/id #uuid "5d807d68-7dd1-5e64-a6c9-60f86d530db1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\text{i}" :db/id #edb/ref 17592186479493} :answer-field/id #uuid "cdc5453e-43b0-5db5-af2d-6f25e95cf391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479806}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e82d486-592d-55be-b437-74783b93d164" :question/math-academy-id "q-64691" :question/problem "Consider the equation ${y}^{″}+y=0,$ where $y=y(t).$ If $y={e}^{\\lambda t}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+1) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+1=0.\n$$\n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+1 & =0 \\\\ {\\lambda }^{2} & =-1 \\\\ \\lambda  & =\\pm \\text{i}.\\end{aligned}\n$$\n\nTherefore,  $\\lambda =\\pm \\text{i}$ are the (purely imaginary) roots of the auxiliary equation."}] :knowledge-point/title "Finding the Complex Solutions of a Characteristic Equation"} {:db/id #edb/ref 17592186087778 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087598 :question/id #uuid "04253a00-f441-58d8-b97e-f7935ae5c7c6" :question/math-academy-id "e-6598" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{\\textrm{d}^2 y}{\\textrm{d} x^2} - 4 \\frac{\\textrm{d} y}{\\textrm{d} x} + 20y =0.\n$$" :question/worked-solution "Assuming $y=e^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\textrm{d} y}{\\textrm{d} x}  = \\lambda e^{\\lambda x}, \\qquad \\frac{\\textrm{d}^2 y}{\\textrm{d} x^2}  = \\lambda^2 e^{\\lambda x} .\n$$\n\nSubstituting the above into our ODE gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-4\\lambda {e}^{\\lambda x}+20{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-4\\lambda +20) & =0.\\end{aligned}\n$$\n\nThe corresponding characteristic equation is\n\n$$\n\\begin{aligned}{\\lambda }^{2}-4\\lambda +20 & =0,\\end{aligned}\n$$\n\nand we can solve it by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-4\\lambda +20 & =0 \\\\ ({\\lambda }^{2}-4\\lambda +4)-4+20 & =0 \\\\ (\\lambda -2)^{2}+16 & =0 \\\\ (\\lambda -2)^{2} & =-16 \\\\ \\lambda -2 & =\\pm 4\\text{i} \\\\ \\lambda  & =2\\pm 4\\text{i}.\\end{aligned}\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}y & ={e}^{2x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x).\\end{aligned}\n$$"} :knowledge-point/id #uuid "2999a565-bf64-5246-9fee-54cecc9e79ff" :knowledge-point/questions [{:db/id #edb/ref 17592186088352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d31c5aa5-e21b-5aa6-8a43-29a2d9edeec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = e^{3x}(P\\cos 2x + Q\\sin 2x)" :db/id #edb/ref 17592186086766} {:answer/id #uuid "ffa61304-a7cd-5231-8a0c-f84802f13c39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = e^{-2x}(P\\cos 3x + Q\\sin 3x)" :db/id #edb/ref 17592186086767} {:answer/id #uuid "5f1735af-473f-5642-80dd-1dc7a38229d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = e^{x}(P\\cos 2x + Q\\sin 2x)" :db/id #edb/ref 17592186086768} {:answer/id #uuid "63acf51b-4186-5bed-92bb-0ddbafcc25b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = e^{2x}(P\\cos 3x + Q\\sin 3x)" :db/id #edb/ref 17592186086769} {:answer/id #uuid "7ef0cec0-58a3-593c-877b-d151e302f37c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = e^{x}(P\\cos 3x + Q\\sin 3x)" :db/id #edb/ref 17592186086770}] :answer-field/id #uuid "a4638042-b914-54a3-95e7-19aa70fcdf77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086765}] :question/id #uuid "77a2a4de-12d5-58ff-a712-904e8166cd22" :question/math-academy-id "q-7817" :question/problem "Find the general solution to the equation\n$$\n\\displaystyle \\frac{d^{2}y}{dx^{2}} - 4\\frac{dy}{dx} + 13y = 0.\n$$"} {:db/id #edb/ref 17592186088353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c19d254-00b7-5b64-9105-3f7cc54116ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡5x+Q\\operatorname{sin}⁡5x)" :db/id #edb/ref 17592186346137} {:answer/id #uuid "a72e5a45-deac-5650-bbff-112f0224e077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-2x}(P\\operatorname{cos}⁡5x+Q\\operatorname{sin}⁡5x)" :db/id #edb/ref 17592186346808} {:answer/id #uuid "c66557f4-3510-5dd1-bb8c-1e29a1d78225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186347077} {:answer/id #uuid "cebe99c7-689c-57a6-ac0d-e8220b4afa0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡5x+Q\\operatorname{sin}⁡5x)" :db/id #edb/ref 17592186347161} {:answer/id #uuid "e2be9f9d-5cec-5de2-b3d3-78c9d15532cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186347345}] :answer-field/correct {:answer/id #uuid "cebe99c7-689c-57a6-ac0d-e8220b4afa0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡5x+Q\\operatorname{sin}⁡5x)" :db/id #edb/ref 17592186347161} :answer-field/id #uuid "d12238be-3be8-57ab-b7ea-d5cc938b7aff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bd2157c6-44ec-5848-a33c-3c6d00cdf590" :question/math-academy-id "q-7818" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+2\\frac{\\text{d}y}{\\text{d}x}+26y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+2\\lambda {e}^{\\lambda x}+26{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+2\\lambda +26) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+2\\lambda +26=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +26 & =0 \\\\ ({\\lambda }^{2}+2\\lambda +1)-1+26 & =0 \\\\ (\\lambda +1)^{2}+25 & =0 \\\\ (\\lambda +1)^{2} & =-25 \\\\ \\lambda +1 & =\\pm 5\\text{i} \\\\ \\lambda  & =-1\\pm 5\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{-x}(P\\operatorname{cos}⁡5x+Q\\operatorname{sin}⁡5x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26fa7ab1-0670-5c15-8b73-cde536ce2e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-\\sqrt{2}x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186263339} {:answer/id #uuid "7080601b-bafd-5d30-9294-31b4fd21ee88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x)" :db/id #edb/ref 17592186263974} {:answer/id #uuid "785f89a6-980f-5718-9047-17bba2cae9fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-\\sqrt{2}x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186264045} {:answer/id #uuid "816731c0-cadd-5e16-8067-a81dfab74394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x)" :db/id #edb/ref 17592186264113} {:answer/id #uuid "ab0851e5-f04c-5752-804f-dc68c52ca148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186264467}] :answer-field/correct {:answer/id #uuid "7080601b-bafd-5d30-9294-31b4fd21ee88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x)" :db/id #edb/ref 17592186263974} :answer-field/id #uuid "3f1e0f69-f1e5-5e9f-b9b4-9a8a93b78937" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265363}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c73eda7a-fc82-5c07-ba13-4e9d72b2a0ba" :question/math-academy-id "q-130166" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+8\\frac{\\text{d}y}{\\text{d}x}+18y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives \n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+8\\lambda {e}^{\\lambda x}+18{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+8\\lambda +18) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+8\\lambda +18=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+8\\lambda +18 & =0 \\\\ ({\\lambda }^{2}+8\\lambda +16)-16+18 & =0 \\\\ (\\lambda +4)^{2}+2 & =0 \\\\ (\\lambda +4)^{2} & =-2 \\\\ \\lambda +4 & =\\pm \\sqrt{2}\\text{i} \\\\ \\lambda  & =-4\\pm \\sqrt{2}\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{-4x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f9bc8f5-e9f8-540b-8895-d49f59927428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-10x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186263691} {:answer/id #uuid "6263a47a-1438-5716-9e97-2c98e8a8f8b0" :answer/type {:d