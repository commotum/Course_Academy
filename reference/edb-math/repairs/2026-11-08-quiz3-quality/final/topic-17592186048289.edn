d}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+109{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +109) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+6\\lambda +109=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +109 & =0 \\\\ ({\\lambda }^{2}+6\\lambda +9)-9+109 & =0 \\\\ (\\lambda +3)^{2}+100 & =0 \\\\ (\\lambda +3)^{2} & =-100 \\\\ \\lambda +3 & =\\pm 10\\text{i} \\\\ \\lambda  & =-3\\pm 10\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{-3x}(P\\operatorname{cos}⁡10x+Q\\operatorname{sin}⁡10x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35f38504-8305-5326-bb00-99730398c72f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{3x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186345815} {:answer/id #uuid "8c2c2f19-a310-51bc-b9f3-c3da0cbade4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186346566} {:answer/id #uuid "bd394e25-e934-5d93-8427-bbaa8ee6cec9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186346996} {:answer/id #uuid "ed6ca764-e4b1-5a07-aa16-c3060f5ba655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186347447} {:answer/id #uuid "ffbe2dda-35f7-576a-b2ef-f74883f82610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186347599}] :answer-field/correct {:answer/id #uuid "8c2c2f19-a310-51bc-b9f3-c3da0cbade4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186346566} :answer-field/id #uuid "5105fd34-ef14-5354-acd9-1f700b41c1b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347746}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d0d326e-4d26-506b-9602-c369ca812aa6" :question/math-academy-id "q-7819" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-6\\frac{\\text{d}y}{\\text{d}x}+13y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-6\\lambda {e}^{\\lambda x}+13{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-6\\lambda +13) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-6\\lambda +13=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-6\\lambda +13 & =0 \\\\ ({\\lambda }^{2}-6\\lambda +9)-9+13 & =0 \\\\ (\\lambda -3)^{2}+4 & =0 \\\\ (\\lambda -3)^{2} & =-4 \\\\ \\lambda -3 & =\\pm 2\\text{i} \\\\ \\lambda  & =3\\pm 2\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5391bd40-9dfe-5f5a-9861-a1093409b31b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355408} {:answer/id #uuid "70773ae9-a152-5cc4-ac15-a00c4a6fe1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{4x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186355657} {:answer/id #uuid "8638cc2f-34bc-5d19-b9c9-a973bfd6b17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-2x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355850} {:answer/id #uuid "aa8fa2b5-ccc3-5c13-a0d7-eb18dcd4119d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186356173} {:answer/id #uuid "d9f23479-4054-5fbe-9d96-28a1f746af09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186356577}] :answer-field/correct {:answer/id #uuid "5391bd40-9dfe-5f5a-9861-a1093409b31b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355408} :answer-field/id #uuid "6282c7db-351d-5818-ac25-77dc1e99dda4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357084}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a885511-1dcf-5606-836f-b33f26907c6e" :question/math-academy-id "q-90802" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-4\\frac{\\text{d}y}{\\text{d}x}+8y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-4\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-4\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-4\\lambda +8=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-4\\lambda +8 & =0 \\\\ ({\\lambda }^{2}-4\\lambda +4)-4+8 & =0 \\\\ (\\lambda -2)^{2}+4 & =0 \\\\ (\\lambda -2)^{2} & =-4 \\\\ \\lambda -2 & =\\pm 2\\text{i} \\\\ \\lambda  & =2\\pm 2\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{2x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186424419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "372decf5-07c1-53da-bc75-d9a5d1ca2af2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-\\sqrt{2}x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186424390} {:answer/id #uuid "5aca1eff-3ec7-558c-b8b7-98e8fbd1724d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x)" :db/id #edb/ref 17592186424398} {:answer/id #uuid "81bc7a0f-e18c-5f02-830e-17220310bc9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186424405} {:answer/id #uuid "b774558a-559a-5988-8403-8737cd918d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x)" :db/id #edb/ref 17592186424407} {:answer/id #uuid "f3b188bb-b260-50c5-829b-55f980ff4f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-\\sqrt{2}x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x)" :db/id #edb/ref 17592186424410}] :answer-field/correct {:answer/id #uuid "b774558a-559a-5988-8403-8737cd918d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x)" :db/id #edb/ref 17592186424407} :answer-field/id #uuid "dcd58d31-460d-5db3-9cc3-21dda899bae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424413}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5ec1eb1a-35a3-5483-b0fc-d5a9a680836b" :question/math-academy-id "q-130171" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+2\\frac{\\text{d}y}{\\text{d}x}+3y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+2\\lambda {e}^{\\lambda x}+3{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+2\\lambda +3) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+2\\lambda +3=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +3 & =0 \\\\ ({\\lambda }^{2}+2\\lambda +1)-1+3 & =0 \\\\ (\\lambda +1)^{2}+2 & =0 \\\\ (\\lambda +1)^{2} & =-2 \\\\ \\lambda +1 & =\\pm \\sqrt{2}\\text{i} \\\\ \\lambda  & =-1\\pm \\sqrt{2}\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{-x}(P\\operatorname{cos}⁡\\sqrt{2}x+Q\\operatorname{sin}⁡\\sqrt{2}x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186424422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "246b2565-637f-5292-abfa-d2862a24940b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-2x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186424388} {:answer/id #uuid "3039ea89-084f-5591-9fca-1787fe1eb56d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186424389} {:answer/id #uuid "58f5d98e-6fb6-528b-b0ee-2573b379c1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-2x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186424397} {:answer/id #uuid "70d70171-451c-5304-897d-4e4efdb95d05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186424402} {:answer/id #uuid "f13d0b8d-e943-5792-a3b5-b8da7091ae7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186424409}] :answer-field/correct {:answer/id #uuid "58f5d98e-6fb6-528b-b0ee-2573b379c1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-2x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186424397} :answer-field/id #uuid "f9a6370f-e406-5a8c-ad57-f67b9f3a356b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424415}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7ffe364-7a92-504c-8ec6-763abcbb5581" :question/math-academy-id "q-130169" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+4\\frac{\\text{d}y}{\\text{d}x}+20y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives \n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+20{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +20) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+4\\lambda +20=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +20 & =0 \\\\ ({\\lambda }^{2}+4\\lambda +4)-4+20 & =0 \\\\ (\\lambda +2)^{2}+16 & =0 \\\\ (\\lambda +2)^{2} & =-16 \\\\ \\lambda +2 & =\\pm 4\\text{i} \\\\ \\lambda  & =-2\\pm 4\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{-2x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x).\\end{aligned}\n$$"}] :knowledge-point/title "Finding the General Solution When the Characteristic Equation Has Complex Roots"}] :topic/math-academy-id 880 :topic/title "Second-Order Homogeneous ODEs: Characteristic Equations With Complex Roots"}]}
