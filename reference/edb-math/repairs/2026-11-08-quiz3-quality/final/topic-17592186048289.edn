e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+11{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+11) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+11=0.\n$$\n\n \n\nThe auxiliary equation has pure imaginary roots:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+11 & =0 \\\\ {\\lambda }^{2} & =-11 \\\\ \\lambda  & =\\pm \\sqrt{11}\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y=P\\operatorname{cos}⁡(\\sqrt{11}x)+Q\\operatorname{sin}⁡(\\sqrt{11}x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2abe233c-ca54-5efa-8d54-736956ff2f13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡(\\sqrt{3}x)+Q\\operatorname{sin}⁡(\\sqrt{3}x))" :db/id #edb/ref 17592186263366} {:answer/id #uuid "410ffeac-8e41-512e-b1e9-180fb7d6b147" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡(3x)+Q\\operatorname{sin}⁡(3x))" :db/id #edb/ref 17592186263577} {:answer/id #uuid "6b086a32-46d1-5731-a5e7-05a7a714b70d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(3x)+Q\\operatorname{sin}⁡(3x)" :db/id #edb/ref 17592186263922} {:answer/id #uuid "86c5c22a-e009-56b5-8a96-50b9e0bf2a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(3\\sqrt{3}x)+Q\\operatorname{sin}⁡(3\\sqrt{3}x)" :db/id #edb/ref 17592186264163} {:answer/id #uuid "f3372d30-f1ee-5e96-a1c4-fa2ae22e26c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(\\sqrt{3}x)+Q\\operatorname{sin}⁡(\\sqrt{3}x)" :db/id #edb/ref 17592186265137}] :answer-field/correct {:answer/id #uuid "f3372d30-f1ee-5e96-a1c4-fa2ae22e26c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(\\sqrt{3}x)+Q\\operatorname{sin}⁡(\\sqrt{3}x)" :db/id #edb/ref 17592186265137} :answer-field/id #uuid "5f54b85d-3abe-542a-b792-bdc7ef076694" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265410}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0bc719ea-aefa-5ef6-83f6-5e2dc5f4cad7" :question/math-academy-id "q-130155" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+3y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+3{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+3) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+3=0.\n$$\n\n \n\nThe auxiliary equation has pure imaginary roots:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+3 & =0 \\\\ {\\lambda }^{2} & =-3 \\\\ \\lambda  & =\\pm \\sqrt{3}\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y=P\\operatorname{cos}⁡(\\sqrt{3}x)+Q\\operatorname{sin}⁡(\\sqrt{3}x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a46aa64-5cbc-5f2f-8900-029223b3d563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\operatorname{cos}⁡7x+\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186355603} {:answer/id #uuid "be366002-6b61-56da-a603-f9930b167f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7\\operatorname{cos}⁡7x+2\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186356331} {:answer/id #uuid "e5aa5989-0dc9-5e96-9f01-9a131519cc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2\\operatorname{cos}⁡7x+\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186356669} {:answer/id #uuid "e87dce70-aebd-5b15-a1f9-2a461f9e7d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{cos}⁡7x+2\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186356697} {:answer/id #uuid "ee8739f2-a115-545c-b326-9bd035efd3d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2\\operatorname{cos}⁡7x+7\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186356743}] :answer-field/correct {:answer/id #uuid "e5aa5989-0dc9-5e96-9f01-9a131519cc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2\\operatorname{cos}⁡7x+\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186356669} :answer-field/id #uuid "ae89ec41-be19-50c6-b9e3-09e9ddba5e64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357238}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0bc0c8a7-8858-5e00-ae94-4f1aa0312ddd" :question/math-academy-id "q-90791" :question/problem "Solve the initial value problem\n\n$$\n{y}^{″}+49y=0,\\,y(0)=-2,\\,{y}^{′}(0)=7.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+49{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+49) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+49=0.\n$$\n\nThe auxiliary equation has pure imaginary roots:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+49 & =0 \\\\ {\\lambda }^{2} & =-49 \\\\ \\lambda  & =\\pm 7\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y=P\\operatorname{cos}⁡7x+Q\\operatorname{sin}⁡7x.\\end{aligned}\n$$\n\nNow let's find the constants $P$ and $Q.$ \n\nSubstituting $y(0)=-2$ into the general solution gives\n\n$$\nP=-2.\n$$\n\nWe now need to apply the condition ${y}^{′}(0)=7.$ First, we differentiate $y$ to find ${y}^{′}:$\n\n$$\n{y}^{′}=-7P\\operatorname{sin}⁡7x+7Q\\operatorname{cos}⁡7x\n$$\n\nSubstituting ${y}^{′}(0)=7$ into the above gives\n\n$$\n7Q=7.\n$$\n\nSo we have $P=-2$ and $Q=1.$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-2\\operatorname{cos}⁡7x+\\operatorname{sin}⁡7x.\n$$"} {:db/id #edb/ref 17592186357479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41e66632-57b9-51da-b078-395d9c20d178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5\\operatorname{cos}⁡10x-\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186355247} {:answer/id #uuid "6001cc3a-c216-505e-ba49-02df0e305596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10\\operatorname{cos}⁡10x+4\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186355514} {:answer/id #uuid "991b62f9-02a4-57b3-b531-4a02e93b4eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{cos}⁡10x+\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186356023} {:answer/id #uuid "b3d5c877-f8a8-5682-ab20-c126cbd31c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5\\operatorname{cos}⁡10x+2\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186356245} {:answer/id #uuid "da818f1f-318a-5234-a60b-e2e3535bd09e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\operatorname{cos}⁡10x-5\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186356587}] :answer-field/correct {:answer/id #uuid "b3d5c877-f8a8-5682-ab20-c126cbd31c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5\\operatorname{cos}⁡10x+2\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186356245} :answer-field/id #uuid "41c38b67-52cf-5430-bfdc-9fab57d13026" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357023}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9afdbaee-36d2-5005-b5ca-9e82e70cfccf" :question/math-academy-id "q-90793" :question/problem "Solve the initial value problem\n\n$$\n{y}^{″}+100y=0,\\,y(0)=5,\\,{y}^{′}(0)=20.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+100{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+100) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+100=0.\n$$\n\nThe auxiliary equation has pure imaginary roots:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+100 & =0 \\\\ {\\lambda }^{2} & =-100 \\\\ \\lambda  & =\\pm 10\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y=P\\operatorname{cos}⁡10x+Q\\operatorname{sin}⁡10x.\\end{aligned}\n$$\n\nNow let's find the constants $P$ and $Q.$ \n\nSubstituting $y(0)=5$ into the general solution gives\n\n$$\nP=5.\n$$\n\nWe now need to apply the condition ${y}^{′}(0)=20.$ First, we differentiate $y$ to find ${y}^{′}:$\n\n$$\n{y}^{′}=-10P\\operatorname{sin}⁡10x+10Q\\operatorname{cos}⁡10x\n$$\n\nSubstituting ${y}^{′}(0)=20$ into the above gives\n\n$$\n10Q=20.\n$$\n\nSo we have $P=5$ and $Q=2.$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=5\\operatorname{cos}⁡10x+2\\operatorname{sin}⁡10x.\n$$"} {:db/id #edb/ref 17592186424418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0d77c8-7efa-509f-bef6-82baddb279d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(2\\sqrt{2}x)+Q\\operatorname{sin}⁡(2\\sqrt{2}x)" :db/id #edb/ref 17592186424383} {:answer/id #uuid "11fa98b4-5ce7-562e-8556-f0c5fde17981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(2x)+Q\\operatorname{sin}⁡(2x)" :db/id #edb/ref 17592186424384} {:answer/id #uuid "1b17692c-c9e6-5fb9-b683-710c751d71eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(\\sqrt{2}x)+Q\\operatorname{sin}⁡(\\sqrt{2}x)" :db/id #edb/ref 17592186424387} {:answer/id #uuid "4dcba3b3-b484-591b-9199-dbe512146957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡(\\sqrt{2}x)+Q\\operatorname{sin}⁡(\\sqrt{2}x))" :db/id #edb/ref 17592186424395} {:answer/id #uuid "7b8c966b-6123-5761-8d43-445de358d1fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡(2x)+Q\\operatorname{sin}⁡(2x))" :db/id #edb/ref 17592186424404}] :answer-field/correct {:answer/id #uuid "1b17692c-c9e6-5fb9-b683-710c751d71eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(\\sqrt{2}x)+Q\\operatorname{sin}⁡(\\sqrt{2}x)" :db/id #edb/ref 17592186424387} :answer-field/id #uuid "2d07ff77-a6c4-5f49-aa6e-272568f4eaad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424411}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "39b56ce3-825a-5cae-ae49-6bfacb30db5c" :question/math-academy-id "q-90794" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+2y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+2{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+2) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+2=0.\n$$\n\n \n\nThe auxiliary equation has pure imaginary roots:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2 & =0 \\\\ {\\lambda }^{2} & =-2 \\\\ \\lambda  & =\\pm \\sqrt{2}\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y=P\\operatorname{cos}⁡(\\sqrt{2}x)+Q\\operatorname{sin}⁡(\\sqrt{2}x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186424421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b4249e-69dd-59cf-b52b-1c6c4a33e356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(9x)+Q\\operatorname{sin}⁡(9x)" :db/id #edb/ref 17592186424382} {:answer/id #uuid "17a24000-d1ae-5136-a384-a4ac9e0ce633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(3x)+Q\\operatorname{sin}⁡(3x)" :db/id #edb/ref 17592186424386} {:answer/id #uuid "448487a5-9552-5c98-a142-dc48b8aa610f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡(3x)+Q\\operatorname{sin}⁡(3x))" :db/id #edb/ref 17592186424393} {:answer/id #uuid "4a87e083-8bfc-5269-80d1-c0f3cccf05ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡(9x)+Q\\operatorname{sin}⁡(9x))" :db/id #edb/ref 17592186424394} {:answer/id #uuid "6ccdaae6-8946-5a17-88e5-edb6ce7cbfa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(18x)+Q\\operatorname{sin}⁡(18x)" :db/id #edb/ref 17592186424401}] :answer-field/correct {:answer/id #uuid "07b4249e-69dd-59cf-b52b-1c6c4a33e356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(9x)+Q\\operatorname{sin}⁡(9x)" :db/id #edb/ref 17592186424382} :answer-field/id #uuid "9b5fd536-e6d8-5681-9668-0ebbff4ffc2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424412}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "890e3373-7fb4-50a4-b559-8ada548af125" :question/math-academy-id "q-79611" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+81y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+81{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+81) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+81=0.\n$$\n\nThe auxiliary equation has pure imaginary roots:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+81 & =0 \\\\ {\\lambda }^{2} & =-81 \\\\ \\lambda  & =\\pm 9\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y=P\\operatorname{cos}⁡(9x)+Q\\operatorname{sin}⁡(9x).\\end{aligned}\n$$"}] :knowledge-point/title "Finding the General Solution When the Characteristic Equation Has Imaginary Roots"} {:db/id #edb/ref 17592186087776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087596 :question/id #uuid "b22fa1be-4c82-5dbf-b5fe-5cbb42c0c646" :question/math-academy-id "e-6596" :question/problem "Given that $y = y(t)$ satisfies the equation $y'' - 4y' + 85y = 0,$ which of the following is **not** a solution to this equation?\n\nI. $-2e^{2t}\\cos{9t} + 7e^{2t}\\sin{9t}$\n\nII. $e^{2t}\\cos{9t}+3e^{2t}\\sin{3t}$\n\nIII. $-6e^{2t}\\sin{9t}$" :question/worked-solution "Assuming $y = e^{\\lambda x}$ and differentiating $y$ with respect to $t$ gives\n\n$$\ny' = \\lambda e^{\\lambda t}, \\qquad y'' = \\lambda^2 e^{\\lambda t} .\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}-4\\lambda {e}^{\\lambda t}+85{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}-4\\lambda +85) & =0.\\end{aligned}\n$$\n\nThe corresponding characteristic equation is\n\n$$\n\\lambda^2 - 4\\lambda + 85 = 0,\n$$\n\nand we can solve it by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-4\\lambda +85 & =0 \\\\ ({\\lambda }^{2}-4\\lambda +4)-4+85 & =0 \\\\ (\\lambda -2)^{2}+81 & =0 \\\\ (\\lambda -2)^{2} & =-81 \\\\ \\lambda -2 & =\\pm 9\\text{i} \\\\ \\lambda  & =2\\pm 9\\text{i}\\end{aligned}\n$$\n\nSince $\\lambda = 2 \\pm 9 \\textrm{i}$ are the complex roots of the characteristic equation, the general solution takes the form\n\n$$\ny = e^{2t} \\left( P \\cos 9t + Q \\sin 9t \\right).\n$$\n\nFinally, we need to determine whether each of the given functions takes the form shown above.\n\n- Function I takes the above form with $P=-2$ and $Q=7.$ So, it is a solution to the given ODE.\n\n- Function II does *not* take the above form. It contains $\\sin 3t,$ which is not included in the above form. So, it is *not* a solution to the given ODE.\n\n- Function III takes the above form with $P=0$ and $Q=-6.$ So, it is a solution to the given ODE.\n\nTherefore, the correct answer is \"II only\"."} :knowledge-point/id #uuid "092a6c8c-7bea-5c53-88ac-f5dc8b16c357" :knowledge-point/questions [{:db/id #edb/ref 17592186088236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d28a3b3-9f9e-59dc-88eb-d0379bf9e54f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9e^{x}\\cos 4x + 2e^{x}\\sin 4x" :db/id #edb/ref 17592186086071} {:answer/id #uuid "b4e7844e-9cfb-5bfe-9c0a-351a69bbfe22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8e^{x}\\sin 4x" :db/id #edb/ref 17592186086072} {:answer/id #uuid "baa316df-5472-583b-8418-29664be113d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{x}\\cos 4x - 11e^{x}\\sin 4x" :db/id #edb/ref 17592186086073} {:answer/id #uuid "d7a2286e-eff8-5a2f-9b36-1b850f19cc4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5e^{2x}\\sin 4x" :db/id #edb/ref 17592186086074} {:answer/id #uuid "034fce6c-ee50-5a0d-8db5-9c295c214b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e^{x}\\cos 4x" :db/id #edb/ref 17592186086075}] :answer-field/id #uuid "c6503d73-857b-5850-b6df-2fa58ed7c477" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086070}] :question/id #uuid "77282f81-7f46-5bed-8933-2924da5a4281" :question/math-academy-id "q-64697" :question/problem "Given that $y = y(x)$ satisfies the equation $y^{″} - 2y^{′} + 17y = 0$, which of the following is **not** a solution to this equation?"} {:db/id #edb/ref 17592186088237 :question/answer-fields [{:answer-field/choices [{:answer/id #u