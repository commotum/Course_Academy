5bb-ceafcade3e20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50{e}^{x}\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186264367} {:answer/id #uuid "c3f46921-af99-5d26-a57f-b5feb00ce72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-x}\\operatorname{cos}⁡7x-2{e}^{-x}\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186264712} {:answer/id #uuid "d2f7f770-16a0-56b2-bff6-f2f328e949d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{-x}\\operatorname{cos}⁡7x+2{e}^{-x}\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186264840}] :answer-field/correct {:answer/id #uuid "a0e91013-3158-50a6-95bb-ceafcade3e20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50{e}^{x}\\operatorname{sin}⁡7x" :db/id #edb/ref 17592186264367} :answer-field/id #uuid "a1fe5c38-0c8a-5ad6-a3d7-d8a42883f274" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265528}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "950cca0c-2751-5927-8f98-bdff08102121" :question/math-academy-id "q-130330" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+2{y}^{′}+50y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+2\\lambda {e}^{\\lambda x}+50{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+2\\lambda +50) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+2\\lambda +50=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +50 & =0 \\\\ ({\\lambda }^{2}+2\\lambda +1)-1+50 & =0 \\\\ (\\lambda +1)^{2}+49 & =0 \\\\ (\\lambda +1)^{2} & =-49 \\\\ \\lambda +1 & =\\pm 7\\text{i} \\\\ \\lambda  & =-1\\pm 7\\text{i}\\end{aligned}\n$$\n\nHence, $\\lambda =-1\\pm 7\\text{i}$ are the complex roots of the auxiliary equation.\n\nThus, any linear combination of the functions $\\text{Re}({e}^{(-1+7\\text{i})x})={e}^{-x}\\operatorname{cos}⁡7x$ and $\\text{Im}({e}^{(-1+7\\text{i})x})={e}^{-x}\\operatorname{sin}⁡7x$ is a solution to the original differential equation. \n\nAmong the given options, only $50{e}^{x}\\operatorname{sin}⁡7x$ is not a solution."} {:db/id #edb/ref 17592186265886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4696d5-cc1e-5203-b64d-8bf1bd1f0021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186264079} {:answer/id #uuid "a4016bef-beb0-5db0-82a4-44e41b9e2b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186264395} {:answer/id #uuid "c1a592ed-3d1c-533a-acce-12ce3e8a08bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186264682} {:answer/id #uuid "d7acfab0-f973-57d7-848f-7c92141ba2a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186264880} {:answer/id #uuid "fe0aed58-ec3b-559f-a069-761233a8e9d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186265236}] :answer-field/correct {:answer/id #uuid "c1a592ed-3d1c-533a-acce-12ce3e8a08bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186264682} :answer-field/id #uuid "324549a9-80bb-5ccf-ab12-74bb3177f177" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265335}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91a61312-3bc9-5174-b905-87935cc4c9cf" :question/math-academy-id "q-130335" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+1) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+1=0.\n$$\n\n \n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+1 & =0 \\\\ {\\lambda }^{2} & =-1 \\\\ \\lambda  & =\\pm \\text{i}.\\end{aligned}\n$$\n\nSo, $\\lambda =\\pm \\text{i}$ are the purely imaginary roots of the auxiliary equation. \n\nTherefore, any linear combination of the functions $\\text{Re}({e}^{\\text{i}x})=\\operatorname{cos}⁡x$ and $\\text{Im}({e}^{\\text{i}x})=\\operatorname{sin}⁡x$ is a solution to the original differential equation. \n\nAmong the given options, only $\\operatorname{sin}⁡2x$ is not a solution."} {:db/id #edb/ref 17592186265887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24eecd5f-ec07-54e2-b437-8b77f9140681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{e}^{-4x}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186263318} {:answer/id #uuid "6f467d9d-979d-5709-bae3-c4c92fc04674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{-4x}\\operatorname{cos}⁡x+4{e}^{-4x}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186263964} {:answer/id #uuid "929baca9-f3b6-5d5b-b138-84979e7022e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-4x}\\operatorname{cos}⁡x-2{e}^{-4x}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186264256} {:answer/id #uuid "bade5fc7-a05e-5eb0-ba44-208ce4ea5d7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-4x}\\operatorname{cos}⁡x-4{e}^{x}" :db/id #edb/ref 17592186264623} {:answer/id #uuid "e6d6fa7c-41e1-5ad8-bfb2-dcbf76116a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10{e}^{-4x}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186265012}] :answer-field/correct {:answer/id #uuid "bade5fc7-a05e-5eb0-ba44-208ce4ea5d7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-4x}\\operatorname{cos}⁡x-4{e}^{x}" :db/id #edb/ref 17592186264623} :answer-field/id #uuid "63319091-fb0b-5512-8db9-1efa4f943939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265419}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "58474b39-7f22-54e5-91df-f41937199af6" :question/math-academy-id "q-130336" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+8{y}^{′}+17y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+8\\lambda {e}^{\\lambda x}+17{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+8\\lambda +17) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+8\\lambda +17=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+8\\lambda +17 & =0 \\\\ ({\\lambda }^{2}+8\\lambda +16)-16+17 & =0 \\\\ (\\lambda +4)^{2}+1 & =0 \\\\ (\\lambda +4)^{2} & =-1 \\\\ \\lambda +4 & =\\pm \\text{i} \\\\ \\lambda  & =-4\\pm \\text{i}\\end{aligned}\n$$\n\nHence, $\\lambda =-4\\pm \\text{i}$ are the complex roots of the auxiliary equation.\n\nThus, any linear combination of the functions $\\text{Re}({e}^{(-4+\\text{i})x})={e}^{-4x}\\operatorname{cos}⁡x$ and $\\text{Im}({e}^{(-4+\\text{i})x})={e}^{-4x}\\operatorname{sin}⁡x$ is a solution to the original differential equation. \n\nAmong the given options, only ${e}^{-4x}\\operatorname{cos}⁡x-4{e}^{x}$ is not a solution."} {:db/id #edb/ref 17592186335736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08439fed-af4f-572e-aaa3-59375e6a7ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡8t" :db/id #edb/ref 17592186333068} {:answer/id #uuid "37b86d6a-eddc-542b-8eea-0b91ef051ebe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{cos}⁡8t+\\frac{\\operatorname{sin}⁡8t}{4}" :db/id #edb/ref 17592186333503} {:answer/id #uuid "b59cbfeb-06af-507b-92ac-07ebfd6f3011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16\\operatorname{sin}⁡8t" :db/id #edb/ref 17592186334581} {:answer/id #uuid "d928fb4f-060c-5b9b-b61f-97b887a67e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡8t-2\\operatorname{cos}⁡4t" :db/id #edb/ref 17592186334894} {:answer/id #uuid "fc3ec2a3-f20f-5503-a02f-5ba9cb495bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{cos}⁡8t-6\\operatorname{sin}⁡8t" :db/id #edb/ref 17592186335204}] :answer-field/correct {:answer/id #uuid "d928fb4f-060c-5b9b-b61f-97b887a67e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡8t-2\\operatorname{cos}⁡4t" :db/id #edb/ref 17592186334894} :answer-field/id #uuid "10042a7b-4502-5c60-bf0e-7233aa1e2da3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335267}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9b13d315-60ad-5f09-add0-7ddb741771b7" :question/math-academy-id "q-64698" :question/problem "Given that $y=y(t)$ satisfies the equation ${y}^{″}+64y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+64{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+64) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+64=0.\n$$\n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+64 & =0 \\\\ {\\lambda }^{2} & =-64 \\\\ \\lambda  & =\\pm 8\\text{i}.\\end{aligned}\n$$\n\nSo, $\\lambda =\\pm 8\\text{i}$ are the (purely imaginary) roots of the auxiliary equation. \n\nTherefore, any linear combination of the functions $\\text{Re}({e}^{8\\text{i}t})=\\operatorname{cos}⁡8t$ and $\\text{Im}({e}^{8\\text{i}t})=\\operatorname{sin}⁡8t$ is a solution to the original differential equation. \n\nAmong the given options, only $\\operatorname{sin}⁡8t-2\\operatorname{cos}⁡4t$ is not a solution."} {:db/id #edb/ref 17592186357483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25cbb955-04e3-5525-893c-42de10491f18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}\\operatorname{cos}⁡4x-3{e}^{-2x}\\operatorname{sin}⁡4x" :db/id #edb/ref 17592186354982} {:answer/id #uuid "a436785a-8c48-5f77-adf7-d5df54378426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{-2x}\\operatorname{cos}⁡4x-8{e}^{-2x}\\operatorname{sin}⁡4x" :db/id #edb/ref 17592186356121} {:answer/id #uuid "b7347d57-e534-53d8-985e-aba25696dd82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{-2x}+{e}^{-2x}\\operatorname{sin}⁡4x" :db/id #edb/ref 17592186356271} {:answer/id #uuid "f3821bdf-82bd-532d-b299-cd3fa54697e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{-2x}\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186356794} {:answer/id #uuid "fac4cbc9-7f15-5be9-8b4f-6e8ada96f72f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{-2x}\\operatorname{sin}⁡4x" :db/id #edb/ref 17592186356855}] :answer-field/correct {:answer/id #uuid "b7347d57-e534-53d8-985e-aba25696dd82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{-2x}+{e}^{-2x}\\operatorname{sin}⁡4x" :db/id #edb/ref 17592186356271} :answer-field/id #uuid "36cedc8f-92dc-56e7-9af8-3e69f2411d11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357007}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c7ec34b-d26e-57cf-bfab-3aae321fbf59" :question/math-academy-id "q-90806" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+4{y}^{′}+20y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+20{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +20) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+4\\lambda +20=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +20 & =0 \\\\ ({\\lambda }^{2}+4\\lambda +4)-4+20 & =0 \\\\ (\\lambda +2)^{2}+16 & =0 \\\\ (\\lambda +2)^{2} & =-16 \\\\ \\lambda +2 & =\\pm 4\\text{i} \\\\ \\lambda  & =-2\\pm 4\\text{i}\\end{aligned}\n$$\n\nHence, $\\lambda =-2\\pm 4\\text{i}$ are the complex roots of the auxiliary equation.\n\nThus, any linear combination of the functions $\\text{Re}({e}^{(-2+4\\text{i})x})={e}^{-2x}\\operatorname{cos}⁡4x$ and $\\text{Im}({e}^{(-2+4\\text{i})x})={e}^{-2x}\\operatorname{sin}⁡4x$ is a solution to the original differential equation. \n\nAmong the given options, only $4{e}^{-2x}+{e}^{-2x}\\operatorname{sin}⁡4x$ is not a solution."} {:db/id #edb/ref 17592186357484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce005a0-0859-5d70-9762-50d37f1b33aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{6x}\\operatorname{cos}⁡2x" :db/id #edb/ref 17592186355051} {:answer/id #uuid "2fcbd114-4ac6-5a18-8de9-c463c3bb2781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{6x}\\operatorname{cos}⁡2x+3{e}^{6x}\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186355079} {:answer/id #uuid "505b0d61-8beb-5cf0-a448-20ac5c5e81c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{6x}\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186355382} {:answer/id #uuid "5204b3bd-ccab-57fb-869b-6d69b871aa1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{6x}\\operatorname{cos}⁡2x-2{e}^{6x}\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186355398} {:answer/id #uuid "f514bbd4-5840-5cd4-a6bd-7f1ccbd48e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{6x}\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186356802}] :answer-field/correct {:answer/id #uuid "505b0d61-8beb-5cf0-a448-20ac5c5e81c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{6x}\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186355382} :answer-field/id #uuid "5910f9bd-500b-549c-bae8-5af3eb830f1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357069}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1d14f94c-eee0-5194-aa26-bfd57687e00b" :question/math-academy-id "q-90807" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}-12{y}^{′}+40y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-12\\lambda {e}^{\\lambda x}+40{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-12\\lambda +40) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-12\\lambda +40=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-12\\lambda +40 & =0 \\\\ ({\\lambda }^{2}-12\\lambda +36)-36+40 & =0 \\\\ (\\lambda -6)^{2}+4 & =0 \\\\ (\\lambda -6)^{2} & =-4 \\\\ \\lambda -6 & =\\pm 2\\text{i} \\\\ \\lambda  & =6\\pm 2\\text{i}\\end{aligned}\n$$\n\nHence, $\\lambda =6\\pm 2\\text{i}$ are the complex roots of the auxiliary equation.\n\nThus, any linear combination of the functions $\\text{Re}({e}^{(6+2\\text{i})x})={e}^{6x}\\operatorname{cos}⁡2x$ and $\\text{Im}({e}^{(6+2\\text{i})x})={e}^{6x}\\operatorname{sin}⁡2x$ is a solution to the original differential equation. \n\nAmong the given options, only $3{e}^{6x}\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x$ is not a solution."} {:db/id #edb/ref 17592186479840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a5b5fcd-a29c-562a-bf8b-1f75f85c8212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡5x}{10}" :db/id #edb/ref 17592186479423} {:answer/id #uuid "45e6c364-109b-5f21-b91f-470d8f1c14dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡10x}{7}" :db/id #edb/ref 17592186479461} {:answer/id #uuid "4d1fee01-a9cc-5f62-9f84-82cfd509796a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡10x}{5}" :db/id #edb/ref 17592186479474} {:answer/id #uuid "6e4da9eb-58ac-5ffd-8391-5239e3f08137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{cos}⁡10x" :db/id #edb/ref 17592186479525} {:answer/id #uuid "ae0e539b-1e11-52de-8ca7-413cfb665f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡10x-4\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186479619}] :answer-field/correct {:answer/id #uuid "2a5b5fcd-a29c-562a-bf8b-1f75f85c8212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡5x}{10}" :db/id #edb/ref 17592186479423} :answer-field/id #uuid "916dd54d-8397-5580-93c9-13216913749d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479791}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "217cbddd-95c6-5476-9ab1-c973151ef34b" :question/math-academy-id "q-64695" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+100y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+100{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+100) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+100=0.\n$$\n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+100 & =0 \\\\ {\\lambda }^{2} & =-100 \\\\ \\lambda  & =\\pm 10\\text{i}.\\end{aligned}\n$$\n\nSo, $\\lambda =\\pm 10\\text{i}$ are the (purely imaginary) roots of the auxiliary equation. \n\nTherefore, any linear combination of the functions $\\text{Re}({e}^{10\\text{i}x})=\\operatorname{cos}⁡10x$ and $\\text{Im}({e}^{10\\text{i}x})=\\operatorname{sin}⁡10x$ is a solution to the original differential equation. \n\nAmong the given options, only $\\frac{\\operatorname{cos}⁡5x}{10}$ is not a solution."}] :knowledge-point/title "Identifying Non-Solutions of a Second-Order Homogeneous ODEs"} {:db/id #edb/ref 17592186087777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087597 :question/id #uuid "7aa1ff4a-2263-5c99-97dd-d6fcada8bfc0" :question/math-academy-id "e-6597" :question/problem "Consider the equation $y'' + 10y' + 34y  = 0,$ where $y = y(t).$ If $y = e^{\\lambda t}$ is a solution, then what is $\\lambda?$" :question/worked-solution "Assuming $y = e^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\ny' = \\lambda e^{\\lambda t}, \\qquad y'' = \\lambda^2 e^{\\lambda t} .\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+10\\lambda {e}^{\\lambda t}+34{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+10\\lambda +34) & =0.\\end{aligned}\n$$\n\nThe corresponding characteristic equation is\n\n$$\n\\lambda^2 + 10\\lambda + 34  = 0,\n$$\n\nand we can solve it by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+10\\lambda +34 & =0 \\\\ ({\\lambda }^{2}+10\\lambda +25)-25+34 & =0 \\\\ (\\lambda +5)^{2}+9 & =0 \\\\ (\\lambda +5)^{2} & =-9 \\\\ \\lambda +5 & =\\pm 3\\text{i} \\\\ \\lambda  & =-5\\pm 3\\text{i}\\end{aligned}\n$$\n\nTherefore,  $\\lambda = - 5 \\pm 3\\textrm{i}$ are the complex roots of the auxiliary equation."} :knowledge-point/id #uuid "191e98e0-aa31-5dd9-a735-6580d29ad287" :knowledge-point/questions [{:db/id #edb/ref 17592186088234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e08656c-e6c6-570d-be21-f4028582d652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pm \\text{i}" :db/id #edb/ref 17592186333575} {:answer/id #uuid "4520d0cf-e104-5613-8ad7-862f74ae00eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pm \\text{i}" :db/id #edb/ref 17592186333627} {:answer/id #uuid "a06712b4-7975-524f-a0ee-f851b6666817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\pm 2\\text{i}" :db/id #edb/ref 17592186334398} {:answer/id #uuid "a526e18a-efd0-5fb3-b1cd-a10b823de7ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2\\text{i}" :db/id #edb/ref 17592186334437} {:answer/id #uuid "b53e6e01-1712-54a5-9ef2-5adba86e75f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\text{i}" :db/id #edb/ref 17592186334575}] :answer-field/correct {:answer/id #uuid "4520d0cf-e104-5613-8ad7-862f74ae00eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pm \\text{i}" :db/id #edb/ref 17592186333627} :answer-field/id #uuid "8bb8d753-2857-538f-a873-5b55f3ec7c97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335506}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "70c30108-c302-53ad-8b6c-df208afe3a93" :question/math-academy-id "q-64663" :question/problem "Consider the equation ${y}^{″}-6{y}^{′}+10y=0$ where $y=y(t).$ If $y={e}^{\\lambda t}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}-6\\lambda {e}^{\\lambda t}+10{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}-6\\lambda +10) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-6\\lambda +10=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-6\\lambda +10 & =0 \\\\ ({\\lambda }^{2}-6\\lambda +9)-9+10 & =0 \\\\ (\\lambda -3)^{2}+1 & =0 \\\\ (\\lambda -3)^{2} & =-1 \\\\ \\lambda -3 & =\\pm \\text{i} \\\\ \\lambda  & =3\\pm \\text{i}\\end{aligned}\n$$\n\nTherefore,  $\\lambda =3\\pm \\text{i}$ are the complex roots of the auxiliary equation."} {:db/id #edb/ref 17592186088235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e05764a-3996-5dbc-8e61-71ef6fa9138b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\pm 2\\text{i}" :db/id #edb/ref 17592186334257} {:answer/id #uuid "ac47f7c5-f91c-54b1-acaf-fb35705a302a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 6\\text{i}" :db/id #edb/ref 17592186334502} {:answer/id #uuid "c5038594-b53c-5e41-8ffb-92ac79abc940"