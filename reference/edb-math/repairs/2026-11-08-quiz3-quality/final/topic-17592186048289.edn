#{[{:db/id #edb/ref 17592186048289 :topic/id #uuid "917bf85e-7253-5a9c-8395-ebac6e9e50d7" :topic/knowledge-points [{:db/id #edb/ref 17592186087775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087595 :question/id #uuid "07394b09-ab80-579c-9b10-dc7a2835d3c7" :question/math-academy-id "e-6595" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{\\textrm{d}^2 y}{\\textrm{d} x^2} + 25y =0.\n$$" :question/worked-solution "Assuming $y=e^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\textrm{d} y}{\\textrm{d} x}  = \\lambda e^{\\lambda x}, \\qquad \\frac{\\textrm{d}^2 y}{\\textrm{d} x^2}  = \\lambda^2 e^{\\lambda x} .\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+25{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+25) & =0.\\end{aligned}\n$$\n\nThe corresponding characteristic equation is\n\n$$\n\\begin{aligned}{\\lambda }^{2}+25 & =0 \\\\ {\\lambda }^{2}+25 & =0 \\\\ {\\lambda }^{2} & =-25 \\\\ \\lambda  & =\\pm 5\\text{i}.\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\ny = P\\cos{5x} + Q\\sin{5x}.\n$$"} :knowledge-point/id #uuid "0bf8bb23-741b-5583-b51c-67eabae0ab54" :knowledge-point/questions [{:db/id #edb/ref 17592186088351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095adea9-4204-5a0c-8116-ca14753a95a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186345424} {:answer/id #uuid "4959c464-7960-5dd8-8443-6b77f580d51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x" :db/id #edb/ref 17592186345979} {:answer/id #uuid "6dc21824-3d80-5bf3-8e23-d10e3274ddb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186346311} {:answer/id #uuid "846ab9ec-8bf4-5466-90f0-e8d23d31ea8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡8x+Q\\operatorname{sin}⁡8x" :db/id #edb/ref 17592186346503} {:answer/id #uuid "cdf8cec9-5073-5c8d-ad40-26497248e7e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186347153}] :answer-field/correct {:answer/id #uuid "4959c464-7960-5dd8-8443-6b77f580d51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x" :db/id #edb/ref 17592186345979} :answer-field/id #uuid "d84ff391-a823-5314-a2f7-5dca0797a318" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347986}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86740d1a-9e3f-5fde-bf6f-bd26506cd57b" :question/math-academy-id "q-7816" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+16y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+16{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+16) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+16=0.\n$$\n\n \n\nThe auxiliary equation has pure imaginary roots:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2} & =-16 \\\\ \\lambda  & =\\pm 4\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y=P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "819b3713-5b8c-5d47-ab7f-16cd8522ca33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = P\\cos x + Q\\sin x" :db/id #edb/ref 17592186086886} {:answer/id #uuid "88333b56-acaa-5102-aede-4ca4c483ec3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = e^{x}(P\\cos x + Q\\sin x)" :db/id #edb/ref 17592186086887} {:answer/id #uuid "9d78d32c-d4ee-572f-a941-cfa15b30e515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = P\\cos (-2x) + Q\\sin (-2x)" :db/id #edb/ref 17592186086888} {:answer/id #uuid "c67c55d1-8d99-5621-a966-fecb0a9ab657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = e^{x}(P\\cos (2x) + Q\\sin (2x))" :db/id #edb/ref 17592186086889} {:answer/id #uuid "3c7a92f1-25f9-533a-a3dc-40f0e0758abd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = P\\cos (2x) + Q\\sin (2x)" :db/id #edb/ref 17592186086890}] :answer-field/id #uuid "c5696827-5828-507d-a912-d923a169beb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086885}] :question/id #uuid "9d3a6c1d-0ac5-5582-9874-fbe9d57bc780" :question/math-academy-id "q-79610" :question/problem "Find the general solution to the equation\n$\\frac{d^{2}y}{dx^{2}} + y = 0$."} {:db/id #edb/ref 17592186265845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "378ff7b8-9f77-597b-ad83-d68fde1df64e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=P\\operatorname{cos}⁡(11\\sqrt{11}x)+Q\\operatorname{sin}⁡(11\\sqrt{11}x)" :db/i