#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186065258} :activity/id #uuid "3159ca73-1d98-5540-ba3d-ce5c4dd41cdb" :activity/scope {:db/id #edb/ref 17592186050711} :activity/steps [{:db/id #edb/ref 17592186065138 :step/content {:db/id #edb/ref 17592186064259 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064104 :question/id #uuid "fe999c48-1afd-5949-b4f9-533c09511d95" :question/math-academy-id "e-5295" :question/problem "Find the $x$-coordinate of the point on the curve $y=3x^2+1$ where the tangent line has a slope of $-1.$" :question/worked-solution "Let $f(x)=3x^2+1.$ The slope of the tangent at the point $x$ is equal to $f'(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+1) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =3\\cdot 2x+0 \\\\  & =6x+0 \\\\  & =6x.\\end{aligned}\n$$\n\nWe now set $f'(x) = -1$ and solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-1 \\\\ 6x & =-1 \\\\ x & =-\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $-1$ at the point where $x=-\\dfrac 1 6.$"} :knowledge-point/id #uuid "00a74f63-a4eb-5894-b4a4-eb4fd297a3f3" :knowledge-point/question-generator {:db/id #edb/ref 17592186510723} :knowledge-point/questions [{:db/id #edb/ref 17592186064836} {:db/id #edb/ref 17592186064838} {:db/id #edb/ref 17592186235354} {:db/id #edb/ref 17592186237876} {:db/id #edb/ref 17592186317424} {:db/id #edb/ref 17592186317425} {:db/id #edb/ref 17592186329926} {:db/id #edb/ref 17592186329946} {:db/id #edb/ref 17592186510720} {:db/id #edb/ref 17592186527206} {:db/id #edb/ref 17592186543476} {:db/id #edb/ref 17592186543488} {:db/id #edb/ref 17592186601498}] :knowledge-point/title "Finding a Point on a Curve With a Certain Slope"} :step/id #uuid "daef6167-0f84-5241-86a1-5f840b3b7175" :step/math-academy-id 19581} {:db/id #edb/ref 17592186065258 :step/content {:db/id #edb/ref 17592186065368 :tutorial/content "Remember that the derivative of a function $f(x)$ represents the slope of the tangent line to the curve $y=f(x).$\n\nFor example, consider the curve $y=x^2$, shown below. If we want to compute the slope of the tangent to the curve at the point $A(1,1),$ then we compute $f'(x)$ and evaluate $f'(1).$\n\n![](images/63/63f675532755376a733f2f0cad2b40e55f19b3278c1bcc5e8cb355fc6bdac277.png)\n\nIf $f(x)=x^2,$ then $f'(x) = 2 x$ by the power rule. Substituting $x=1$ into $f'(x)$ gives\n$$\nf'(1) = 2 (1) = 2.\n$$\n\nTherefore, the slope of the tangent to the curve $y=x^2$ at the point $A$ is $2.$" :tutorial/id #uuid "93644195-f209-5d8c-bcaf-bbb6766c7193" :tutorial/math-academy-id 351 :tutorial/title "Introduction"} :step/id #uuid "d5f47d99-6d75-561c-aa52-ee6d298efded" :step/math-academy-id 649 :step/next {:db/id #edb/ref 17592186065259}} {:db/id #edb/ref 17592186065259 :step/content {:db/id #edb/ref 17592186064342 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063980 :question/id #uuid "9c9b5972-f775-5cbe-8e66-2a0309f24f0e" :question/math-academy-id "e-142" :question/problem "Find the slope of the tangent to the curve $y = x^2 + \\dfrac {1}{x}$ at the point where $x=2.$" :question/worked-solution "Let $f(x)=x^2+\\dfrac 1 x.$ The slope of the tangent at $x=2$ is equal to $f'(2).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{x}^{-1}) \\\\  & =2\\cdot x-{x}^{-2} \\\\  & =2x-{x}^{-2}.\\end{aligned}\n$$\n\nNow, we evaluate at $x=2$ and get\n\n$$\n\\begin{aligned}{f}^{′}(2) & =2(2)-(2{)}^{-2} \\\\  & =4-\\frac{1}{4} \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $\\dfrac{15}{4}.$"} :knowledge-point/id #uuid "2ffbc4bb-e179-543f-bcb5-3aaf6540a8a1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186049061}] :knowledge-point/question-generator {:db/id #edb/ref 17592186510719} :knowledge-point/questions [{:db/id #edb/ref 17592186064535} {:db/id #edb/ref 17592186064536} {:db/id #edb/ref 17592186235367} {:db/id #edb/ref 17592186235458} {:db/id #edb/ref 17592186235472} {:db/id #edb/ref 17592186244051} {:db/id #edb/ref 17592186287885} {:db/id #edb/ref 17592186317207} {:db/id #edb/ref 17592186317341} {:db/id #edb/ref 17592186317342} {:db/id #edb/ref 17592186510702} {:db/id #edb/ref 17592186510704} {:db/id #edb/ref 17592186510707} {:db/id #edb/ref 17592186510708} {:db/id #edb/ref 17592186510709} {:db/id #edb/ref 17592186510711} {:db/id #edb/ref 17592186527218} {:db/id #edb/ref 17592186581731} {:db/id #edb/ref 17592186585809} {:db/id #edb/ref 17592186598635} {:db/id #edb/ref 17592186603046}] :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve at a Given Point"} :step/id #uuid "a6a6686a-5221-599d-acd4-27ad0b7f5605" :step/math-academy-id 650 :step/next {:db/id #edb/ref 17592186065260}} {:db/id #edb/ref 17592186065260 :step/content {:db/id #edb/ref 17592186064343 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063983 :question/id #uuid "3138f267-3903-510c-86e8-5597d3689262" :question/math-academy-id "e-143" :question/problem "What is the slope of the tangent to the curve $y = x^4 + 3\\sqrt [3]{x^2}$ at the point $(1,4)?$" :question/worked-solution "This time, we'll use $\\dfrac{\\textrm d y}{\\textrm d x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+3\\sqrt[3]{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+3{x}^{2/3}) \\\\  & =4\\cdot {x}^{3}+3\\cdot \\frac{2}{3}\\cdot {x}^{-1/3} \\\\  & =4{x}^{3}+2{x}^{-1/3}.\\end{aligned}\n$$\n\nEvaluating at $x=1$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & =4(1{)}^{3}+2(1{)}^{-1/3} \\\\  & =4+2 \\\\  & =6\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $6.$"} :knowledge-point/id #uuid "3ca13570-d504-53e6-8e02-0f1e85047a3e" :knowledge-point/question-generator {:db/id #edb/ref 17592186510700} :knowledge-point/questions [{:db/id #edb/ref 17592186064534} {:db/id #edb/ref 17592186064537} {:db/id #edb/ref 17592186237875} {:db/id #edb/ref 17592186287908} {:db/id #edb/ref 17592186297293} {:db/id #edb/ref 17592186317353} {:db/id #edb/ref 17592186338791} {:db/id #edb/ref 17592186510685} {:db/id #edb/ref 17592186510689} {:db/id #edb/ref 17592186510690} {:db/id #edb/ref 17592186510691} {:db/id #edb/ref 17592186510692} {:db/id #edb/ref 17592186527209}] :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve With Fractional Powers at a Given Point"} :step/id #uuid "9598c989-9a86-5a6c-9095-6ab731246cfd" :step/math-academy-id 654 :step/next {:db/id #edb/ref 17592186065138}}] :activity/title "Calculating the Slope of a Tangent Line Using Differentiation" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186064423}]}
