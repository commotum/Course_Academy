b/id #edb/ref 17592186616326} :answer-field/id #uuid "63b9c5d6-db2e-54e6-84b8-bf2a0320e4db" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186616328}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "57a6783a-fc39-5ef5-8a1c-628f352f4ad2" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-9-4x)^{6}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=-9-4x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-4.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6g^{5}\\cdot (-4) \\\\  &=-24(-9-4x)^{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186616329 :knowledge-point/_questions [{:db/id #edb/ref 17592186096841 :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7bf8b1-ff38-5f11-bbcc-50fa3c64315d" :answer/type {:db/ident :answer.type/math} :answer/value "12(3 x - 2)^{3}" :db/id #edb/ref 17592186616322} {:answer/id #uuid "3b7d9b20-6c95-5ef1-9f2f-5d156d52e4b9" :answer/type {:db/ident :answer.type/math} :answer/value "21(3 x - 2)^{2}" :db/id #edb/ref 17592186616324} {:answer/id #uuid "44ea5da8-041a-5e5b-99cd-1fb7c91c60e3" :answer/type {:db/ident :answer.type/math} :answer/value "28(3 x - 2)^{3}" :db/id #edb/ref 17592186616325} {:answer/id #uuid "d3b17d71-4b32-5a53-8943-d88edbe9e11a" :answer/type {:db/ident :answer.type/math} :answer/value "9(3 x - 2)^{2}" :db/id #edb/ref 17592186616330} {:answer/id #uuid "d5a8f75a-30e8-5ac1-8c2d-9aeb2e7e764a" :answer/type {:db/ident :answer.type/math} :answer/value "6(3 x - 2)^{2}" :db/id #edb/ref 17592186616331}] :answer-field/correct {:answer/id #uuid "d3b17d71-4b32-5a53-8943-d88edbe9e11a" :answer/type {:db/ident :answer.type/math} :answer/value "9(3 x - 2)^{2}" :db/id #edb/ref 17592186616330} :answer-field/id #uuid "298df8c1-b7b3-5697-9024-df99fb83258d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186616323}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a831160d-bd79-52f7-b589-31b6792f7366" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(3 x - 2)^{3}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{3},\\,g=3 x - 2\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3g^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=3g^{2}\\cdot (3) \\\\  &=9(3 x - 2)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186616333 :knowledge-point/_questions [{:db/id #edb/ref 17592186087693 :knowledge-point/id #uuid "f6ae25fc-16eb-598b-a288-742e4b46cb12" :knowledge-point/title "Determining the Dimensions of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c42aaf91-df34-52db-95f0-76a5be5c1835" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186616350}] :answer-field/correct {:answer/id #uuid "c42aaf91-df34-52db-95f0-76a5be5c1835" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186616350} :answer-field/id #uuid "8e7b9b28-dbd5-5ade-b610-ae32bd81b6dc" :answer-field/key "field-2" :answer-field/type {:db/