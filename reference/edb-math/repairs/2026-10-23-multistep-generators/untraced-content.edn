#{[{:db/id #edb/ref 17592186565593 :knowledge-point/_questions [{:db/id #edb/ref 17592186096841 :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fc5a380-1983-5fd3-a9a8-a3c2ecf287fc" :answer/type {:db/ident :answer.type/math} :answer/value "-4(3 - 4 x)^{5}" :db/id #edb/ref 17592186565591} {:answer/id #uuid "73f4128f-a1d8-5bf3-ad9f-85f70a222251" :answer/type {:db/ident :answer.type/math} :answer/value "3(3 - 4 x)^{5}" :db/id #edb/ref 17592186565592} {:answer/id #uuid "95a11de1-bb6b-5eb4-8e63-f0b053e1f1df" :answer/type {:db/ident :answer.type/math} :answer/value "6(3 - 4 x)^{5}" :db/id #edb/ref 17592186565595} {:answer/id #uuid "c2fd3656-3e39-56a1-92a1-6955b83b3b0b" :answer/type {:db/ident :answer.type/math} :answer/value "-24(3 - 4 x)^{6}" :db/id #edb/ref 17592186565598} {:answer/id #uuid "f881b92f-d7fe-54ff-9a4d-3e96bd197db8" :answer/type {:db/ident :answer.type/math} :answer/value "-24(3 - 4 x)^{5}" :db/id #edb/ref 17592186565603}] :answer-field/correct {:answer/id #uuid "f881b92f-d7fe-54ff-9a4d-3e96bd197db8" :answer/type {:db/ident :answer.type/math} :answer/value "-24(3 - 4 x)^{5}" :db/id #edb/ref 17592186565603} :answer-field/id #uuid "bad14dfb-e7b1-549d-8b87-2f1d672c7de0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565597}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a04edd0-e7bf-56e5-8b7e-72d1c5d80068" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(3 - 4 x)^{6}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=3 - 4 x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-4.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6g^{5}\\cdot (-4) \\\\  &=-24(3 - 4 x)^{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186565600 :knowledge-point/_questions [{:db/id #edb/ref 17592186096841 :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37815dd4-eb85-5506-a53b-02d708dc63b4" :answer/type {:db/ident :answer.type/math} :answer/value "12x(-1+2x)^{5}" :db/id #edb/ref 17592186565590} {:answer/id #uuid "7ca845be-815d-54b6-b943-67a05dfc5659" :answer/type {:db/ident :answer.type/math} :answer/value "16(-1+2x)^{7}" :db/id #edb/ref 17592186565594} {:answer/id #uuid "c4a651a1-21d4-5d6e-99e6-82d10932c207" :answer/type {:db/ident :answer.type/math} :answer/value "12(-1+2x)^{5}" :db/id #edb/ref 17592186565599} {:answer/id #uuid "d0dc0981-4569-5cd4-81b4-a1e05d370b16" :answer/type {:db/ident :answer.type/math} :answer/value "3(-1+2x)^{5}" :db/id #edb/ref 17592186565601} {:answer/id #uuid "f30538b4-9ca0-589f-b496-783cf99694de" :answer/type {:db/ident :answer.type/math} :answer/value "6(-1+2x)^{5}" :db/id #edb/ref 17592186565602}] :answer-field/correct {:answer/id #uuid "c4a651a1-21d4-5d6e-99e6-82d10932c207" :answer/type {:db/ident :answer.type/math} :answer/value "12(-1+2x)^{5}" :db/id #edb/ref 17592186565599} :answer-field/id #uuid "a28f42e5-36b6-5f5e-8b58-a45c3ea6040b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565596}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c560bc6a-e1e6-5b7e-9d3d-86522a3c4ff0" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-1+2x)^{6}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=-1+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6\\cdot 2\\cdot (-1+2x)^{5} \\\\  &=12(-1+2x)^{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567313 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2870cf14-3949-5d51-b043-39e85cf00600" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\left(4\\right)" :db/id #edb/ref 17592186567318} {:answer/id #uuid "33b09fc5-2518-54ed-ae1a-f60299abd95c" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\left(-8\\right)" :db/id #edb/ref 17592186567322} {:answer/id #uuid "361b4247-8d09-5403-a5f5-461e97e4edb8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\left(-4\\right)" :db/id #edb/ref 17592186567323} {:answer/id #uuid "8f51bbec-a5b3-5e45-b804-48b8bfbefd24" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\left(10\\right)" :db/id #edb/ref 17592186567330} {:answer/id #uuid "e4f70b02-e5a5-57ee-a081-974e3743d33d" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\left(-6\\right)" :db/id #edb/ref 17592186567342}] :answer-field/correct {:answer/id #uuid "33b09fc5-2518-54ed-ae1a-f60299abd95c" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\left(-8\\right)" :db/id #edb/ref 17592186567322} :answer-field/id #uuid "a3508371-56bb-59d3-b9d2-7a40ede5a08e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567332}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "016f6e3c-38fb-537b-b003-822a8ff4c03d" :question/problem "Consider the vector field \n\n$$\n\\begin{aligned}F & =(-2)\\left((x+y)^{2}\\right)\\,i \\\\ & \\quad +((-2)\\left((y+z)^{2}\\right))\\,j \\\\ & \\quad +((-2)\\left((x+z)^{2}\\right))\\,k\\end{aligned}\n$$\n\n Evaluate $\\text{div}\\,F$ at the point $(-2,1,-1).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}& ∇\\cdot F \\\\ & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}  \\\\ & =\\frac{∂}{∂x}((-2)\\left((x+y)^{2}\\right)) \\\\ & \\quad +\\frac{∂}{∂y}((-2)\\left((y+z)^{2}\\right)) \\\\ & \\quad +\\frac{∂}{∂z}((-2)\\left((x+z)^{2}\\right))  \\\\ & =(-2)\\left(2(x+y)+2(y+z)+2(x+z)\\right)  \\\\ & =(-2)\\left(4(x+y+z)\\right).\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(-2,1,-1),$ and obtain\n\n$$\n\\begin{aligned}& \\text{div}\\,F(-2,1,-1) \\\\ & =(-2)\\left(4((-2)+(1)+(-1))\\right)  \\\\ & =(-2)\\left(4\\cdot (-2)\\right)  \\\\ & =(-2)\\left(-8\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567319 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "851f7b6c-6ef8-5fa1-93c1-2b75578d0591" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(1\\right)" :db/id #edb/ref 17592186567328} {:answer/id #uuid "85a7bf6a-008a-5ad4-bb57-98a16c1ea300" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(4+\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186567329} {:answer/id #uuid "98f4ca2a-9f76-510d-99d8-13b8550e9b59" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(3+\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186567331} {:answer/id #uuid "c2a6ea42-172d-5293-9420-f6734616457c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(2-\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186567336} {:answer/id #uuid "fa85603b-2370-5ab3-b834-146df244880e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(4\\right)" :db/id #edb/ref 17592186567346}] :answer-field/correct {:answer/id #uuid "98f4ca2a-9f76-510d-99d8-13b8550e9b59" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(3+\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186567331} :answer-field/id #uuid "e4ad85d6-9fc6-5588-8f2e-c1109fd32c75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567341}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "28c24fc2-984b-5c1a-852c-201e6e077ee6" :question/problem "Consider the vector field \n\n$$\n\\begin{aligned}F & =2\\left({x}^{2}yz\\right)\\,i \\\\ & \\quad +(2\\left({x}^{3}y\\right))\\,j \\\\ & \\quad +(2\\left(z\\operatorname{arctan}⁡\\left(\\frac{y}{x}\\right)\\right))\\,k\\end{aligned}\n$$\n\n Evaluate $\\text{div}\\,F$ at the point $(-1,-1,2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}& ∇\\cdot F \\\\ & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}  \\\\ & =\\frac{∂}{∂x}(2\\left({x}^{2}yz\\right)) \\\\ & \\quad +\\frac{∂}{∂y}(2\\left({x}^{3}y\\right)) \\\\ & \\quad +\\frac{∂}{∂z}(2\\left(z\\operatorname{arctan}⁡\\left(\\frac{y}{x}\\right)\\right))  \\\\ & =2\\left(2xyz+{x}^{3}+\\operatorname{arctan}⁡\\left(\\frac{y}{x}\\right)\\right)\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(-1,-1,2),$ and obtain\n\n$$\n\\begin{aligned}& \\text{div}\\,F(-1,-1,2) \\\\ & =2\\left(2(-1)(-1)(2)\\right. \\\\ & \\quad \\left. +(-1)^{3}\\right. \\\\ & \\quad \\left. +\\operatorname{arctan}⁡\\left(\\frac{-1}{-1}\\right)\\right)  \\\\ & =2\\left(4-1+\\frac{\\pi }{4}\\right)  \\\\ & =2\\left(3+\\frac{\\pi }{4}\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567333 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f91d37-da8d-54f8-ba9e-ee66408cf83c" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186567314} {:answer/id #uuid "29aa8d63-92c4-5df0-8de4-ea7dc1c7e1c2" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186567320} {:answer/id #uuid "4576db10-6579-5b11-9c02-feec57e9f666" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186567324} {:answer/id #uuid "5823b613-cd8d-5382-8ec9-9b675b6b7457" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186567326} {:answer/id #uuid "e382c867-db40-5fd0-b63d-5d586a0ccacd" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186567340}] :answer-field/correct {:answer/id #uuid "04f91d37-da8d-54f8-ba9e-ee66408cf83c" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186567314} :answer-field/id #uuid "c1f4b39a-d9af-5934-9187-a0e2a66c417d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567335}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac507300-c358-5f81-a3a1-32ba16c5f8d7" :question/problem "Consider the vector field $F=⟨- \\left(x - y\\right)^{3},\\,- 3 \\left(y + z\\right)^{3},\\,3 \\left(x + z\\right)^{3}⟩.$ Evaluate $\\text{div}\\,F$ at the point $(2,1,-2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}& ∇\\cdot F \\\\ & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}  \\\\ & =\\frac{∂}{∂x}(- \\left(x - y\\right)^{3}) \\\\ & \\quad +\\frac{∂}{∂y}(- 3 \\left(y + z\\right)^{3}) \\\\ & \\quad +\\frac{∂}{∂z}(3 \\left(x + z\\right)^{3})  \\\\ & =(- 3 \\left(x - y\\right)^{2}) \\\\ & \\quad +(- 9 \\left(y + z\\right)^{2}) \\\\ & \\quad +(9 \\left(x + z\\right)^{2})  \\\\ & =- 3 \\left(x - y\\right)^{2} + 9 \\left(x + z\\right)^{2} - 9 \\left(y + z\\right)^{2}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(2,1,-2),$ and obtain\n\n$$\n\\begin{aligned}& (∇\\cdot F)(2,1,-2) \\\\ & =(- 3 \\left((2) - (1)\\right)^{2}) \\\\ & \\quad +(- 9 \\left((1) + (-2)\\right)^{2}) \\\\ & \\quad +(9 \\left((2) + (-2)\\right)^{2})  \\\\ & =(-3)+(-9)+(0)  \\\\ & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567337 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d10d140-d53c-5abc-bdc8-cba4649147ee" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186567315} {:answer/id #uuid "2b3475f0-5b22-571b-a805-af303887d55d" :answer/type {:db/ident :answer.type/math} :answer/value "-84" :db/id #edb/ref 17592186567321} {:answer/id #uuid "d060ccf1-e0a1-55a5-84f9-c904368bac0a" :answer/type {:db/ident :answer.type/math} :answer/value "134" :db/id #edb/ref 17592186567338} {:answer/id #uuid "f137330b-b37f-52d5-888d-d27c3ae8343d" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186567344} {:answer/id #uuid "fe390d00-7a59-5f61-a5c8-d39ee46d178e" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186567347}] :answer-field/correct {:answer/id #uuid "f137330b-b37f-52d5-888d-d27c3ae8343d" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186567344} :answer-field/id #uuid "bd1f2385-d3eb-5a18-8946-95b28e287c80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567334}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cfb8af83-760c-5df6-bf98-3cc117b1cf57" :question/problem "Consider the vector field $F=⟨\\left(2 x + y\\right)^{2},\\,\\left(- 3 y + 3 z\\right)^{2},\\,\\left(3 x + 2 z\\right)^{2}⟩.$ Evaluate $\\text{div}\\,F$ at the point $(-2,-1,-2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}& ∇\\cdot F \\\\ & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}  \\\\ & =\\frac{∂}{∂x}(\\left(2 x + y\\right)^{2}) \\\\ & \\quad +\\frac{∂}{∂y}(\\left(- 3 y + 3 z\\right)^{2}) \\\\ & \\quad +\\frac{∂}{∂z}(\\left(3 x + 2 z\\right)^{2})  \\\\ & =(4 \\left(2 x + y\\right)) \\\\ & \\quad +(18 \\left(y - z\\right)) \\\\ & \\quad +(4 \\left(3 x + 2 z\\right))  \\\\ & =20 x + 22 y - 10 z.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(-2,-1,-2),$ and obtain\n\n$$\n\\begin{aligned}& (∇\\cdot F)(-2,-1,-2) \\\\ & =(4 \\left(2 (-2) + (-1)\\right)) \\\\ & \\quad +(18 \\left((-1) - (-2)\\right)) \\\\ & \\quad +(4 \\left(3 (-2) + 2 (-2)\\right))  \\\\ & =(-20)+(18)+(-40)  \\\\ & =-42.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567343 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4c7908-da86-57af-b238-66de9e09f459" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(2\\right)" :db/id #edb/ref 17592186567316} {:answer/id #uuid "4d7aeb16-636d-50c6-8819-32a432a19ea3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(4\\right)" :db/id #edb/ref 17592186567325} {:answer/id #uuid "711aaab3-fdcf-5bc1-ac92-1df314216953" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(6\\right)" :db/id #edb/ref 17592186567327} {:answer/id #uuid "e22ac6e9-fcb6-5139-9cb0-e2b468832aa4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(3\\right)" :db/id #edb/ref 17592186567339} {:answer/id #uuid "f80ecc3d-1bca-5c81-b3b3-1a574dfefce3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(0\\right)" :db/id #edb/ref 17592186567345}] :answer-field/correct {:answer/id #uuid "4d7aeb16-636d-50c6-8819-32a432a19ea3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(4\\right)" :db/id #edb/ref 17592186567325} :answer-field/id #uuid "2448632d-78d0-53d8-9407-5709ed6299ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567317}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e5d3b92e-3bda-59f9-9fb6-b7a712a6bbbf" :question/problem "Consider the vector field \n\n$$\n\\begin{aligned}F & =2\\left(x(y{e}^{z}+\\operatorname{ln}⁡y)\\right)\\,i \\\\ & \\quad +(2\\left(xy{e}^{z}\\right))\\,j \\\\ & \\quad +(2\\left(z(x+1)\\right))\\,k\\end{aligned}\n$$\n\n \nEvaluate $∇\\cdot F$ at the point $(1,1,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}& ∇\\cdot F \\\\ & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}  \\\\ & =\\frac{∂}{∂x}(2\\left(x(y{e}^{z}+\\operatorname{ln}⁡y)\\right)) \\\\ & \\quad +\\frac{∂}{∂y}(2\\left(xy{e}^{z}\\right)) \\\\ & \\quad +\\frac{∂}{∂z}(2\\left(z(x+1)\\right))  \\\\ & =2\\left((y{e}^{z}+\\operatorname{ln}⁡y)+x{e}^{z}+(x+1)\\right)  \\\\ & =2\\left(y{e}^{z}+\\operatorname{ln}⁡y+x{e}^{z}+x+1\\right)\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(1,1,0),$ and obtain\n\n$$\n\\begin{aligned}& (∇\\cdot F)(1,1,0) \\\\ & =2\\left(1\\cdot {e}^{0}+\\operatorname{ln}⁡1+1\\cdot {e}^{0}+1+1\\right)  \\\\ & =2\\left(1+0+1+1+1\\right)  \\\\ & =2\\left(4\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186568806 :knowledge-point/_questions [{:db/id #edb/ref 17592186105938 :knowledge-point/id #uuid "56c575a7-577f-5439-a366-7e0ef287d0a5" :knowledge-point/title "Calculating the Area of a Trapezoid With Vertical Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ecc0708-1f0e-5873-a66e-bfbb700086b0" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186568811} {:answer/id #uuid "67ad660b-70ad-5647-9773-598a6a5d4040" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186568813} {:answer/id #uuid "74acfa2d-3a44-5298-8894-9ccfc1337e36" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186568816} {:answer/id #uuid "850013f0-876b-552b-b779-5d80c189eb9c" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186568818} {:answer/id #uuid "ab4cf150-92a0-5f0a-b356-f304fff98530" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186568824}] :answer-field/correct {:answer/id #uuid "67ad660b-70ad-5647-9773-598a6a5d4040" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186568813} :answer-field/id #uuid "995c1aec-a659-542f-9660-038a59bb4374" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186568821}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "26a4e17e-c835-569b-ae2a-22a3140f1547" :question/problem "![](images/17/1747dac29a4a706b988a985ec44d2633594ccf3b719ce1c075e425de837319d9.png)\n\nWhat is the area of the trapezoid $PQRS$?" :question/worked-solution "The area of a trapezoid is given by\n\n$$\n\\mathcal{A} = \\dfrac{(a+b) \\cdot h}{2}\n$$\n\nwhere $a,b$ are lengths of the bases and $h$ is the height of the trapezoid.\n\nIn our case, we have\n\n$$\na = PS = 3.5, \\qquad b = QR = 9, \\qquad h = 4\n$$\n\nTherefore, the area of our trapezoid is\n\n$$\n\\begin{aligned}\nA &= \\dfrac{(3.5 + 9) \\cdot 4}{2} \\\\\n&= 12.5 \\cdot 2 \\\\\n&= 25\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186568809 :knowledge-point/_questions [{:db/id #edb/ref 17592186105938 :knowledge-point/id #uuid "56c575a7-577f-5439-a366-7e0ef287d0a5" :knowledge-point/title "Calculating the Area of a Trapezoid With Vertical Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d444f7f-19af-5d95-bb8d-2b37d6d43c0e" :answer/type {:db/ident :answer.type/math} :answer/value "16.5" :db/id #edb/ref 17592186568804} {:answer/id #uuid "6e90ae97-214a-5d0e-9a9d-78ade60d008a" :answer/type {:db/ident :answer.type/math} :answer/value "17.5" :db/id #edb/ref 17592186568815} {:answer/id #uuid "a856f9f0-b695-552a-9e50-a1764182ea24" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186568823} {:answer/id #uuid "d9946e8d-0dec-5e22-8585-