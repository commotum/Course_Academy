} {:answer/id #uuid "4527a59b-a32b-5e8d-a24e-32dd3362198b" :answer/type {:db/ident :answer.type/math} :answer/value "6.5" :db/id #edb/ref 17592186568807} {:answer/id #uuid "5bfe4162-051d-5686-b3b4-efc2b304e73b" :answer/type {:db/ident :answer.type/math} :answer/value "16.25" :db/id #edb/ref 17592186568810} {:answer/id #uuid "5f6997d7-a61f-5579-863c-a50a56eb76e3" :answer/type {:db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186568812} {:answer/id #uuid "b1a93b8d-3d56-545c-be29-40725a73a919" :answer/type {:db/ident :answer.type/math} :answer/value "32.5" :db/id #edb/ref 17592186568825}] :answer-field/correct {:answer/id #uuid "b1a93b8d-3d56-545c-be29-40725a73a919" :answer/type {:db/ident :answer.type/math} :answer/value "32.5" :db/id #edb/ref 17592186568825} :answer-field/id #uuid "eb3e1541-cd8d-5133-b72c-158b46600ac2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186568835}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e19c6c1f-c5ee-5268-b55a-061be14a217a" :question/problem "![](images/a3/a35732f3503c3e93ef9a29e688cf35f77d1a380dce03de3187ff250cafc01c6f.png)\n\nWhat is the area of the trapezoid $PQRS$?" :question/worked-solution "The area of a trapezoid is given by\n\n$$\n\\mathcal{A} = \\dfrac{(a+b) \\cdot h}{2}\n$$\n\nwhere $a,b$ are lengths of the bases and $h$ is the height of the trapezoid.\n\nIn our case, we have\n\n$$\na = PS = 2.5, \\qquad b = QR = 4, \\qquad h = 10\n$$\n\nTherefore, the area of our trapezoid is\n\n$$\n\\begin{aligned}\nA &= \\dfrac{(2.5 + 4) \\cdot 10}{2} \\\\\n&= 6.5 \\cdot 5 \\\\\n&= 32.5\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610476 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a310b50-e76d-5c84-a7d8-439cba9283f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(14 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610475} {:answer/id #uuid "26a31a6d-0ddd-5920-b189-0f95fa2a1b73" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(15 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610482} {:answer/id #uuid "300bc62e-aa67-500e-9e29-b98c5a745e4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(16 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610485} {:answer/id #uuid "d74640fc-0a3c-52b2-977c-9201db784ece" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(8 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610500} {:answer/id #uuid "fa473eba-82bb-53ff-9841-25d71827e37b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(13 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610502}] :answer-field/correct {:answer/id #uuid "d74640fc-0a3c-52b2-977c-9201db784ece" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(8 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610500} :answer-field/id #uuid "bf5c94bf-efc6-541e-a1af-13bb640e828e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610496}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0a6f87ab-c871-5d73-b2fc-d2732f1674d8" :question/problem "Given that $y=e^{4{x}^{2}-6}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=e^{u},\\,u=4{x}^{2}-6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (8x) \\\\ & =(8x)e^{u} \\\\ & =8 x e^{4 x^{2} - 6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610479 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114666fb-e4b1-5224-8ac4-31e59d040d5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 8 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610478} {:answer/id #uuid "48800d7c-ecaf-51c2-96b7-ba445223aee7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 11 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610487} {:answer/id #uuid "8facde07-0b54-542e-88b0-754af8f0a5bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 10 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610493} {:answer/id #uuid "c90aabe4-d1a1-54fa-bc6b-88b3c9a436f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 4 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610497} {:answer/id #uuid "e09577c3-4b1c-5fc2-83f1-8999e9812bd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 9 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610501}] :answer-field/correct {:answer/id #uuid "c90aabe4-d1a1-54fa-bc6b-88b3c9a436f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 4 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610497} :answer-field/id #uuid "bcb277f3-fe77-50e5-873d-1973c4992c81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610495}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "15b62d33-cb18-5df8-9bbc-c0c480db4147" :question/problem "Find $f′(x)$ for $f(x)=e^{-2{x}^{2}+1}$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf=e^{u},\\,u=-2{x}^{2}+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-4x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (-4x) \\\\ & =(-4x)e^{u} \\\\ & =- 4 x e^{1 - 2 x^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610480 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26d026a6-2206-53ea-a409-4618dfcd55ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(3 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610483} {:answer/id #uuid "8bb1d071-4c68-553b-a230-488c233f4bb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610491} {:answer/id #uuid "8c9a8673-82e7-5213-acce-c81f91b01bb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(6 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610492} {:answer/id #uuid "cb7a4773-76c0-5f03-87e3-3004a0849809" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(10 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610498} {:answer/id #uuid "ff8c3307-5958-5fe4-b101-a2a253fa0f3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(7 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610503}] :answer-field/correct {:answer/id #uuid "8bb1d071-4c68-553b-a230-488c233f4bb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610491} :answer-field/id #uuid "10addea1-4650-53ff-b6d4-deee11cf02ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610477}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "15bd5965-2c97-5c0a-bda8-27bd8b23f859" :question/problem "Find $f′(x)$ for $f(x)=e^{{x}^{4}-8}$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf=e^{u},\\,u={x}^{4}-8.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4{x}^{3}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (4{x}^{3}) \\\\ & =(4{x}^{3})e^{u} \\\\ & =4 x^{3} e^{x^{4} - 8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610484 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e60f46-f7fe-5772-b8c0-dc7343518590" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(13 x^{3} + 6\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610473} {:answer/id #uuid "070c3f80-61a6-5863-a6b1-33b6899f1368" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(16 x^{3} + 5\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610474} {:answer/id #uuid "32dcf1db-cad3-5ea9-b541-9a00e6f6a5e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(8 x^{3} + 5\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610486} {:answer/id #uuid "9c1bc474-37a0-52e3-9f1e-9b4d9b1838f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(9 x^{3} + 6\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610494} {:answer/id #uuid "ccfa003a-e603-5e98-936b-f436b88940b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(14 x^{3} + 5\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610499}] :answer-field/correct {:answer/id #uuid "32dcf1db-cad3-5ea9-b541-9a00e6f6a5e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(8 x^{3} + 5\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610486} :answer-field/id #uuid "851f94c7-b8fe-5a81-b39a-4f857ba79151" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610490}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2fa6917a-5a4a-5303-8052-9cb68d3b2fcc" :question/problem "Given that $y=e^{2{x}^{4}+5x}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=e^{u},\\,u=2{x}^{4}+5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8{x}^{3}+5.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (8{x}^{3}+5) \\\\ & =(8{x}^{3}+5)e^{u} \\\\ & =\\left(8 x^{3} + 5\\right) e^{2 x^{4} + 5 x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610488 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16126b45-e476-59b2-8939-faf24557a0e9" :answer/type {:db/ident :answer.type/math} :answer/value "18 x^{5} e^{3 x^{6}}" :db/id #edb/ref 17592186610481}] :answer-field/correct {:answer/id #uuid "16126b45-e476-59b2-8939-faf24557a0e9" :answer/type {:db/ident :answer.type/math} :answer/value "18 x^{5} e^{3 x^{6}}" :db/id #edb/ref 17592186610481} :answer-field/id #uuid "7984346a-477f-5829-aad1-d3f5fd0110ad" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186610489}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "56855aa4-8739-5d32-8b10-552d67cfe6ca" :question/problem "Find $f′(x)$ for $f(x)=e^{3{x}^{6}}$.\n\n$f′(x)=$\n{{field-1}}" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf=e^{u},\\,u=3{x}^{6}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=18{x}^{5}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (18{x}^{5}) \\\\ & =(18{x}^{5})e^{u} \\\\ & =18 x^{5} e^{3 x^{6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610506 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165ecc04-7fbd-5a77-93f6-d22774668d8a" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sqrt{2} e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186610508} {:answer/id #uuid "a9a9eb71-d6f4-5e56-a789-44d48c2f4a4a" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2} e^{\\frac{3 \\pi}{4}}}{2}" :db/id #edb/ref 17592186610522} {:answer/id #uuid "c05b88fb-a1f5-578d-b994-6446f57d9da5" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 \\sqrt{2} e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186610523} {:answer/id #uuid "c158e98d-9be1-5924-824f-86a906952603" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2} e^{\\frac{3 \\pi}{4}}}{4}" :db/id #edb/ref 17592186610524} {:answer/id #uuid "e7d12503-47d7-5f59-a1b1-50b38d30a30b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610530}] :answer-field/correct {:answer/id #uuid "e7d12503-47d7-5f59-a1b1-50b38d30a30b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610530} :answer-field/id #uuid "35cfa76c-d46c-58d5-abac-80705a446e4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610514}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0d6c902f-2435-5203-aa9f-262524ac5a30" :question/problem "If a curve $C$ is given by $y=(2 e^{x})\\cdot (\\sin{\\left(x \\right)}),$ calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=2 e^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=2 e^{x},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(2 e^{x})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (2 e^{x})\\end{aligned} \\\\ &=2 e^{x}(\\cos x+\\sin x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=\\begin{aligned}&(2 e^{\\left(\\frac{3 \\pi}{4}\\right)})\\cdot (\\cos{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)}) \\\\ &{}+(\\sin{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})\\cdot (2 e^{\\left(\\frac{3 \\pi}{4}\\right)})\\end{aligned} \\\\ &=\\begin{aligned}&(2 e^{\\frac{3 \\pi}{4}})\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &{}+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (2 e^{\\frac{3 \\pi}{4}})\\end{aligned} \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$"}] [{:db/id #edb/ref 17592186610512 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c653dab-d9d6-5b47-ba64-cbbe5b46db95" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{e^{\\pi}}{4}" :db/id #edb/ref 17592186610511} {:answer/id #uuid "4113257e-c58c-52bb-ba02-31e91a438929" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610515} {:answer/id #uuid "6b30face-c814-5cf8-878a-8e44698640ec" :answer/type {:db/ident :answer.type/math} :answer/value "3 e^{\\pi}" :db/id #edb/ref 17592186610518} {:answer/id #uuid "91feb006-6edf-5c92-814e-860c6f6c38e3" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{e^{\\pi}}{2}" :db/id #edb/ref 17592186610521} {:answer/id #uuid "c9c63d51-a96d-5e42-858d-40ab7b62ab2c" :answer/type {:db/ident :answer.type/math} :answer/value "- e^{\\pi}" :db/id #edb/ref 17592186610526}] :answer-field/correct {:answer/id #uuid "c9c63d51-a96d-5e42-858d-40ab7b62ab2c" :answer/type {:db/ident :answer.type/math} :answer/value "- e^{\\pi}" :db/id #edb/ref 17592186610526} :answer-field/id #uuid "549d2205-841f-52e6-a67c-6b578550ece4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610516}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "30877dff-2142-58cc-a6f0-c31f215bf1ca" :question/problem "If a curve $C$ is given by $y=(e^{x})\\cdot (\\sin{\\left(x \\right)}),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=e^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=e^{x},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(e^{x})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (e^{x})\\end{aligned} \\\\ &=e^{x}(\\cos x+\\sin x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\pi} &=\\begin{aligned}&(e^{(\\pi)})\\cdot (\\cos{\\left((\\pi) \\right)}) \\\\ &{}+(\\sin{\\left((\\pi) \\right)})\\cdot (e^{(\\pi)})\\end{aligned} \\\\ &=(e^{\\pi})\\cdot (-1)+(0)\\cdot (e^{\\pi}) \\\\ &=- e^{\\pi}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- e^{\\pi}.$"}] [{:db/id #edb/ref 17592186610517 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0342fedd-8d06-51bf-b9ad-5e63f5f5f982" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{8}" :db/id #edb/ref 17592186610505} {:answer/id #uuid "173ff202-950a-5940-aabe-82d481b5d461" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{4}" :db/id #edb/ref 17592186610509} {:answer/id #uuid "c354a2c8-b0de-585b-8ee4-0a43e6df96a9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{27 \\pi^{2}}{2}" :db/id #edb/ref 17592186610525} {:answer/id #uuid "cb0129b4-44ea-5647-bf41-eda356ea7056" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{81 \\pi^{2}}{4}" :db/id #edb/ref 17592186610527} {:answer/id #uuid "e16fa939-f833-50c4-9a94-5a392aabfb39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{81 \\pi^{2}}{16}" :db/id #edb/ref 17592186610529}] :answer-field/correct {:answer/id #uuid "173ff202-950a-5940-aabe-82d481b5d461" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{4}" :db/id #edb/ref 17592186610509} :answer-field/id #uuid "f04cda44-d833-5a4f-9cef-56d38d1b0af1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610531}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6996047e-7e31-5564-bb70-e58aabf2bfcd" :question/problem "If a curve $C$ is given by $y=(- x^{3})\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{2}$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{3}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 3 x^{2},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(- x^{3})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (- 3 x^{2})\\end{aligned} \\\\ &=- x^{2} \\left(x \\cos{\\left(x \\right)} + 3 \\sin{\\left(x \\right)}\\right).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{2}} &=\\begin{aligned}&(- \\left(\\frac{3 \\pi}{2}\\right)^{3})\\cdot (\\cos{\\left(\\left(\\frac{3 \\pi}{2}\\right) \\right)}) \\\\ &{}+(\\sin{\\left(\\left(\\frac{3 \\pi}{2}\\right) \\right)})\\cdot (- 3 \\left(\\frac{3 \\pi}{2}\\right)^{2})\\end{aligned} \\\\ &=\\begin{aligned}&\\left(- \\frac{27 \\pi^{3}}{8}\\right)\\cdot (0) \\\\ &{}+(-1)\\cdot \\left(- \\frac{27 \\pi^{2}}{4}\\right)\\end{aligned} \\\\ &=\\frac{27 \\pi^{2}}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{27 \\pi^{2}}{4}.$"}] [{:db/id #edb/ref 17592186610519 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a49124e-b359-593a-a72b-ef618ed162eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}" :db/id #edb/ref 17592186610510}] :answer-field/correct {:answer/id #uuid "1a49124e-b359-593a-a72b-ef618ed162eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}" :db/id #edb/ref 17592186610510} :answer-field/id #uuid "0f7d6f26-56ba-523c-91e9-3177f7b66fb2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186610507}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6ecb8282-6295-5cd9-a5b5-e1bb578640a9" :question/problem "If a curve $C$ is given by $y=(4 x + 1)\\cdot (\\cos{\\left(x \\right)}),$ then the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=4 x + 1$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=4,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(4 x + 1)\\cdot (- \\sin{\\left(x \\right)}) \\\\ &{}+(\\cos{\\left(x \\right)})\\cdot (4)\\end{aligned} \\\\ &=-(4 x + 1)\\sin x+4\\cos x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=\\begin{aligned}&(4 \\left(\\frac{\\pi}{4}\\right) + 1)\\cdot (- \\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)}) \\\\ &{}+(\\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (4)\\end{aligned} \\\\ &=\\begin{aligned}&(1 + \\pi)\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &{}+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (4)\\end{aligned} \\\\ &=\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}.$"}] [{:db/id #edb/ref 17592186610528 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a274896-90a4-56a0-b45a-65385719edf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}" :db/id #edb/ref 17592186610520}] :answer-field/correct {:answer/id #uuid "8a274896-90a4-56a0-b45a-65385719edf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}" :db/id #edb/ref 17592186610520} :answer-field/id #uuid "3187eef1-7f80-587b-a0fe-39dc0cb198ff" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186610513}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "de532b59-dfad-573f-bd25-b6a82e67e141" :question/problem "Given $f(x)=- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}$, if a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}.$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=x$ and $v(x)=- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=1,\\quad v'(x)=\\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(x)\\cdot (\\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}) \\\\ &{}+(- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)})\\cdot (1)\\end{aligned} \\\\ &=\\begin{aligned}&(x - 3)\\cdot (\\sin{\\left(x \\right)}) \\\\ &{}+(- 3 x - 1)\\cdot (\\cos{\\left(x \\right)})\\end{aligned}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=\\begin{aligned}&(\\left(\\frac{\\pi}{4}\\right))\\cdot (\\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)} - 3 \\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)}) \\\\ &{}+(- 3 \\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)} - \\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (1)\\end{aligned} \\\\ &=\\left(\\frac{\\pi}{4}\\right)\\cdot (- \\sqrt{2})+(- 2 \\sqrt{2})\\cdot (1) \\\\ &=\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}.$"}] [{:db/id #edb/ref 17592186611693 :knowledge-point/_questions [{:db/id #edb/ref 17592186096841 :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2637e49a-0781-515c-9a84-f689805a94ab" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x - 7" :db/id #edb/ref 17592186611691}] :answer-field/correct {:answer/id #uuid "2637e49a-0781-515c-9a84-f689805a94ab" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x - 7" :db/id #edb/ref 17592186611691} :answer-field/id #uuid "e573b0d0-2df3-5439-93d8-68fb45052de8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611696}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6d431469-04a8-5431-a8f2-30fe91513752" :question/problem "Given that $f(x)=(1+2x)^{4},$ the equation of the tangent at the point $(-1,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(1+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=-1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=-1} &=[8(1+2x)^{3}]|_{x=-1} \\\\  &=8(1+2(-1))^{3} \\\\  &=-8.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(-1,1)$ is $m=-8.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=-8(x-(-1)) \\\\ y &=- 8 x - 8+1 \\\\ y &=- 8 x - 7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611694 :knowledge-point/_questions [{:db/id #edb/ref 17592186096841 :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec2cf140-cbdf-5a26-a3b0-eb6b8b2c84f1" :answer/type {:db/ident :answer.type/math} :answer/value "80 - 64 x" :db/id #edb/ref 17592186611697}] :answer-field/correct {:answer/id #uuid "ec2cf140-cbdf-5a26-a3b0-eb6b8b2c84f1" :answer/type {:db/ident :answer.type/math} :answer/value "80 - 64 x" :db/id #edb/ref 17592186611697} :answer-field/id #uuid "0f1d28df-dabb-5bf7-8e72-27b57ca20785" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611690}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "90d7ca00-a943-5f90-be7d-b4fa402d7fc3" :question/problem "Given that $f(x)=(-4+2x)^{4},$ the equation of the tangent at the point $(1,16)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=-4+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(-4+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=1} &=[8(-4+2x)^{3}]|_{x=1} \\\\  &=8(-4+2(1))^{3} \\\\  &=-64.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,16)$ is $m=-64.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(16) &=-64(x-(1)) \\\\ y &=64 - 64 x+16 \\\\ y &=80 - 64 x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611695 :knowledge-point/_questions [{:db/id #edb/ref 17592186096841 :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f389ac9f-9185-59ca-813f-7320e8f73331" :answer/type {:db/ident :answer.type/math} :answer/value "12 x + 1" :db/id #edb/ref 17592186611698}] :answer-field/correct {:answer/id #uuid "f389ac9f-9185-59ca-813f-7320e8f73331" :answer/type {:db/ident :answer.type/math} :answer/value "12 x + 1" :db/id #edb/ref 17592186611698} :answer-field/id #uuid "576ad759-6f77-5ac1-a36e-2ea6c5dd47da" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611692}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c482bf94-14dc-5d26-9e9f-475518535fcc" :question/problem "Given that $f(x)=(1+3x)^{4},$ the equation of the tangent at the point $(0,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (3) \\\\  &=12(1+3x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=0$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=0} &=[12(1+3x)^{3}]|_{x=0} \\\\  &=12(1+3(0))^{3} \\\\  &=12.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(0,1)$ is $m=12.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=12(x-(0)) \\\\ y &=12 x+1 \\\\ y &=12 x + 1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186615560 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1e78ab-8788-5174-8ffd-7a2cc15b6e42" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186615555} {:answer/id #uuid "633cee45-d59f-53de-923d-085faddb4ddb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186615556} {:answer/id #uuid "7c1183b0-b75b-534f-9f78-973a4bb01276" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186615558} {:answer/id #uuid "cf15d09f-7e8e-5f63-801d-3da408b8e869" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186615559} {:answer/id #uuid "f8866bcc-2a42-5656-b565-ee15147b562d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186615561}] :answer-field/correct {:answer/id #uuid "2a1e78ab-8788-5174-8ffd-7a2cc15b6e42" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186615555} :answer-field/id #uuid "691ad0ef-2a57-5243-bdf1-ddb48cf7a828" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186615557}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d5190bc4-2336-5db6-bb75-17e05e48e8ff" :question/problem "If a curve $C$ is given by $y=(2 e^{x})\\cdot (x - 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=2 e^{x}$ and $v(x)=x - 1.$ Then, we have\n\n$$\nu'(x)=2 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(2 e^{x})\\cdot (1)+(x - 1)\\cdot (2 e^{x}) \\\\ &=2 x e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=\\begin{aligned}&(2 e^{(0)})\\cdot (1) \\\\ &{}+((0) - 1)\\cdot (2 e^{(0)})\\end{aligned} \\\\ &=(2)\\cdot (1)+(-1)\\cdot (2) \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$"}] [{:db/id #edb/ref 17592186616295 :knowledge-point/_questions [{:db/id #edb/ref 17592186059730 :knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] :question/answer-fields [{:answer-fiel