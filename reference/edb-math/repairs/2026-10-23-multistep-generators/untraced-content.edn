\frac{1}{\\sqrt{y^{3}}}\\,\\mathrm{d}y\\\\ &= \\int\\left(-4+\\frac{1}{y^{\\frac{3}{2}}}\\right)\\,\\mathrm{d}y\\\\ &= -4\\int y^{0}\\,\\mathrm{d}y+\\int y^{-\\frac{3}{2}}\\,\\mathrm{d}y\\\\ &= -4\\left(\\frac{y^{1}}{1}\\right)+\\left(\\frac{y^{-\\frac{1}{2}}}{-\\frac{1}{2}}\\right)+C\\\\ &= -4y-\\frac{2}{\\sqrt{y}}+C\\end{aligned}\n$$"}]}
