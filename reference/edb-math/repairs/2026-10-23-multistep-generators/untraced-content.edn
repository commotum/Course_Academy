wer.type/math} :answer/value "\\frac{8\\sqrt{t^{5}}}{5}-\\frac{4\\sqrt{t^{3}}}{3}+C" :db/id #edb/ref 17592186671243} {:answer/id #uuid "c9c956f2-1a28-5943-a4a4-f27454ef6eed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{t^{5}}}{5}-\\frac{8\\sqrt{t^{3}}}{3}+C" :db/id #edb/ref 17592186671261} {:answer/id #uuid "cf0ab17f-9adc-5d16-9376-69cd98bec0d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{t^{5}}}{5}-\\frac{8\\sqrt{t^{3}}}{3}+C" :db/id #edb/ref 17592186671263} {:answer/id #uuid "f4e3303b-feda-543e-9a1a-17b14bc8c4b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{t^{5}}}{5}-\\frac{2\\sqrt{t^{3}}}{3}+C" :db/id #edb/ref 17592186671284} {:answer/id #uuid "fceec542-6546-51ec-b140-2d4712565ead" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{t^{5}}}{5}-2\\sqrt{t^{3}}+C" :db/id #edb/ref 17592186671289}] :answer-field/correct {:answer/id #uuid "a7b909cb-f99e-53b3-ab93-b7de7c3d3e4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{t^{5}}}{5}-\\frac{4\\sqrt{t^{3}}}{3}+C" :db/id #edb/ref 17592186671243} :answer-field/id #uuid "6e68bbd0-9d0d-57cb-8e25-f5b1b09a495e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671298}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5241f2d4-1d07-53bc-8e5b-a082d3e91f49" :question/problem "Calculate $$\n\\displaystyle\\int \\sqrt{t}\\left(4t-2\\right)\\,\\mathrm{d}t.\n$$ Assume $t>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int \\sqrt{t}\\left(4t-2\\right)\\,\\mathrm{d}t\\\\ &= \\int\\left(4t^{\\frac{3}{2}}-2t^{\\frac{1}{2}}\\right)\\,\\mathrm{d}t\\\\ &= 4\\int t^{\\frac{3}{2}}\\,\\mathrm{d}t-2\\int t^{\\frac{1}{2}}\\,\\mathrm{d}t\\\\ &= 4\\left(\\frac{t^{\\frac{5}{2}}}{\\frac{5}{2}}\\right)-2\\left(\\frac{t^{\\frac{3}{2}}}{\\frac{3}{2}}\\right)+C\\\\ &= \\frac{8\\sqrt{t^{5}}}{5}-\\frac{4\\sqrt{t^{3}}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671336 :knowledge-point/_questions [{:db/id #edb/ref 17592186184154 :knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f561c10-51b2-59d2-9e26-88c49fa735be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{4}}{2}-2y^{2}+C" :db/id #edb/ref 17592186671231} {:answer/id #uuid "d1456f3f-fe33-5e7c-a440-24903e0f0dac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5y^{4}}{4}-2y^{2}+C" :db/id #edb/ref 17592186671265} {:answer/id #uuid "d71af41a-fdfd-5024-9bab-ddc6507f6ef2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3y^{4}}{4}-\\frac{5y^{2}}{2}+C" :db/id #edb/ref 17592186671266} {:answer/id #uuid "daf71160-883b-5fc6-9b45-d55b2b8fecb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3y^{4}}{2}-y^{2}+C" :db/id #edb/ref 17592186671268} {:answer/id #uuid "fb02eb80-2dbb-5a86-b085-0d2c0bbb94c3" :answer/type {:db/ident :answer.type/math} :answer/value "y^{4}-y^{2}+C" :db/id #edb/ref 17592186671288}] :answer-field/correct {:answer/id #uuid "d1456f3f-fe33-5e7c-a440-24903e0f0dac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5y^{4}}{4}-2y^{2}+C" :db/id #edb/ref 17592186671265} :answer-field/id #uuid "9a6858e4-7778-5837-b5e1-e2b72956ba84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671301}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7f9cbcdd-7a9e-5df9-825b-539a3e74f8fa" :question/problem "Calculate $$\n\\displaystyle\\int 5y^{3}-4y\\,\\mathrm{d}y.\n$$" :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int y^p\\,\\mathrm{d}y=y^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 5y^{3}-4y\\,\\mathrm{d}y\\\\ &= \\int\\left(5y^{3}-4y\\right)\\,\\mathrm{d}y\\\\ &= 5\\int y^{3}\\,\\mathrm{d}y-4\\int y^{1}\\,\\mathrm{d}y\\\\ &= 5\\left(\\frac{y^{4}}{4}\\right)-4\\left(\\frac{y^{2}}{2}\\right)+C\\\\ &= \\frac{5y^{4}}{4}-2y^{2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671338 :knowledge-point/_questions [{:db/id #edb/ref 17592186184153 :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cee45ab3-b6a7-55bd-81d7-91cc0f754b44" :answer/type {:db/ident :answer.type/math} :answer/value "4t-\\frac{t^{7}}{7}" :db/id #edb/ref 17592186671262}] :answer-field/correct {:answer/id #uuid "cee45ab3-b6a7-55bd-81d7-91cc0f754b44" :answer/type {:db/ident :answer.type/math} :answer/value "4t-\\frac{t^{7}}{7}" :db/id #edb/ref 17592186671262} :answer-field/id #uuid "6da02c21-1f30-53c9-880d-0cfa7b47976c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186671297}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9214c456-0ded-5e8a-9e44-d24503d0acbe" :question/problem "Find the antiderivative:\n\n$$\n\\displaystyle\\int 4-t^{6}\\,\\mathrm{d}t=\n$$\n{{field-1}}\n$+C$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 4-t^{6}\\,\\mathrm{d}t\\\\ &= \\int\\left(4-t^{6}\\right)\\,\\mathrm{d}t\\\\ &= 4\\int t^{0}\\,\\mathrm{d}t-\\int t^{6}\\,\\mathrm{d}t\\\\ &= 4\\left(\\frac{t^{1}}{1}\\right)-\\left(\\frac{t^{7}}{7}\\right)+C\\\\ &= 4t-\\frac{t^{7}}{7}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank."}] [{:db/id #edb/ref 17592186671339 :knowledge-point/_questions [{:db/id #edb/ref 17592186184153 :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ab0ab0b-f131-5357-a68a-f9c57d76df0c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4\\sqrt[4]{y^{5}}}{5}-\\frac{y^{3}}{3}" :db/id #edb/ref 17592186671195}] :answer-field/correct {:answer/id #uuid "3ab0ab0b-f131-5357-a68a-f9c57d76df0c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4\\sqrt[4]{y^{5}}}{5}-\\frac{y^{3}}{3}" :db/id #edb/ref 17592186671195} :answer-field/id #uuid "2c268f5b-3612-51e6-bc9f-33c1abc72139" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186671294}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9bd10796-f3b1-5e70-8aec-1213f51f7042" :question/problem "Find the antiderivative:\n\n$$\n\\displaystyle\\int -\\sqrt[4]{y}-y^{2}\\,\\mathrm{d}y=\n$$\n{{field-1}}\n$+C$. Assume $y>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int y^p\\,\\mathrm{d}y=y^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -\\sqrt[4]{y}-y^{2}\\,\\mathrm{d}y\\\\ &= \\int\\left(-y^{\\frac{1}{4}}-y^{2}\\right)\\,\\mathrm{d}y\\\\ &= -\\int y^{\\frac{1}{4}}\\,\\mathrm{d}y-\\int y^{2}\\,\\mathrm{d}y\\\\ &= -\\left(\\frac{y^{\\frac{5}{4}}}{\\frac{5}{4}}\\right)-\\left(\\frac{y^{3}}{3}\\right)+C\\\\ &= -\\frac{4\\sqrt[4]{y^{5}}}{5}-\\frac{y^{3}}{3}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank."}] [{:db/id #edb/ref 17592186671340 :knowledge-point/_questions [{:db/id #edb/ref 17592186184154 :knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an In