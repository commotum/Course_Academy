b/ident :answer-field.type/blank} :db/id #edb/ref 17592186616353}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cf1d3a5b-7e7c-5832-bc99-3b5de130c019" :question/problem "Let\n\n<div class=\"matrix-operands\">\n<div>$P = \\begin{bmatrix}8 & -6 & 3 & 8 \\\\ -6 & 1 & -4 & -5 \\\\ 1 & 7 & 1 & 7 \\\\ 0 & -\\sqrt{3} & 4 & -8 \\\\ 5 & 4 & -\\sqrt{3} & -\\sqrt{3} \\\\ -3 & 3 & 2 & 2\\end{bmatrix}.$</div>\n</div>\n\nThe dimensions of the matrix $P$ are\n\n{{field-1}} $\\times$ {{field-2}}." :question/worked-solution "The matrix $P$ has $6$ rows and $4$ columns. Therefore, its dimensions are $6\\times 4.$"}] [{:db/id #edb/ref 17592186616356 :knowledge-point/_questions [{:db/id #edb/ref 17592186087693 :knowledge-point/id #uuid "f6ae25fc-16eb-598b-a288-742e4b46cb12" :knowledge-point/title "Determining the Dimensions of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2df211d8-6351-5a35-8c20-79228e4c0463" :answer/type {:db/ident :answer.type/math} :answer/value "6\\times 6" :db/id #edb/ref 17592186616335} {:answer/id #uuid "498e7b8f-67dd-53c8-92dd-c4d0c626f648" :answer/type {:db/ident :answer.type/math} :answer/value "5\\times 2" :db/id #edb/ref 17592186616339} {:answer/id #uuid "a114cde1-1508-5482-a1f1-0db9bc3b222d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 6" :db/id #edb/ref 17592186616343} {:answer/id #uuid "a9a7e6fa-df56-57b9-9649-41289ee5107c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 2" :db/id #edb/ref 17592186616344} {:answer/id #uuid "c0b45e15-8119-549e-8891-3f5f3caa3f3c" :answer/type {:db/ident :answer.type/math} :answer/value "4\\times 5" :db/id #edb/ref 17592186616349}] :answer-field/correct {:answer/id #uuid "c0b45e15-8119-549e-8891-3f5f3caa3f3c" :answer/type {:db/ident :answer.type/math} :answer/value "4\\times 5" :db/id #edb/ref 17592186616349} :answer-field/id #uuid "f2f59416-2224-5e58-a43a-42e7ddd0f7d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186616357}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eddfbce4-aa0b-50dd-9e5f-6a88c61815d7" :question/problem "What are the dimensions of the matrix $O$, where\n\n<div class=\"matrix-operands\">\n<div>$O = \\begin{bmatrix}-6 & -4 & -2 & -2 & 9 \\\\ -2 & -3 & -7 & 9 & -9 \\\\ 0 & 6 & 8 & -8 & \\sqrt{2} \\\\ -1 & 4 & -\\sqrt{3} & -3 & 3\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The matrix $O$ has $4$ rows and $5$ columns. Therefore, its dimensions are $4\\times 5.$"}] [{:db/id #edb/ref 17592186620984 :knowledge-point/_questions [{:db/id #edb/ref 17592186096841 :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271409d5-4217-5c85-b07c-9e0df003989b" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186620978} {:answer/id #uuid "362293ce-6960-5bec-bd1d-91d950c62c55" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186620979} {:answer/id #uuid "5442b9e8-2d41-5f44-aa1b-5bf84a779714" :answer/type {:db/ident :answer.type/math} :answer/value "-64" :db/id #edb/ref 17592186620980} {:answer/id #uuid "9e1008cf-16e7-59e5-9723-0377df844c92" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186620982} {:answer/id #uuid "cf9bd0de-8993-53c8-b29e-a2a030396acb" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186620983}] :answer-field/correct {:answer/id #uuid "9e1008cf-16e7-59e5-9723-0377df844c92" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186620982} :answer-field/id #uuid "8826ac9f-6e72-51e7-9d14-5ca172f0524c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186620981}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f96934b1-b807-5be7-b577-eeccabeded8d" :question/problem "Given that $f(x)=(2 x^{2} - 3)^{4},$ find the slope at the point $(1,1)$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=2 x^{2} - 3\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=4 x.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (4 x) \\\\  &=16 x(2 x^{2} - 3)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=1} &=[16 x(2 x^{2} - 3)^{3}]|_{x=1} \\\\  &=16 (1)(2 (1)^{2} - 3)^{3} \\\\  &=-16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186621007 :knowledge-point/_questions [{:db/id #edb/ref 17592186138429 :knowledge-point/id #uuid "4154d81b-c94a-57f7-80fa-0daa341505e6" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1155ef98-7832-5495-860a-9253a7809146" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186621009} {:answer/id #uuid "51529a1f-933a-50fa-8489-6eadaf91f460" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186621019} {:answer/id #uuid "5fa8a6e0-4b4c-5528-a3ba-74a7078a111f" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186621022} {:answer/id #uuid "9d00e86a-713d-526a-9889-51380887e00e" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186621031} {:answer/id #uuid "a6c79d86-68b1-5e77-b97d-3dabf89af6f3" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186621032}] :answer-field/correct {:answer/id #uuid "a6c79d86-68b1-5e77-b97d-3dabf89af6f3" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186621032} :answer-field/id #uuid "ce40e7cf-dd69-5f0d-b168-b679131d51db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186621035}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0207b6ea-3197-5954-ad5e-660a58010014" :question/problem "![](images/85/855d05a1380b48d2df060b188efe3a84c55198fadf518a530a9301e248def82a.png)\n\nThe graph above shows the speed of cars $A$ and $B$ as a function of the distance that they traveled during a brake test. At which distance, in meters, did both cars reach the same speed?" :question/worked-solution "The cars have the same speed when the two graphs intersect.\n\n![](images/13/133975486ee310209ed358e5a2533e888c993727383d4c9a86affae9942a46e5.png)\n\nIn this case, we have the point $(80,30)$. So, both cars have the same speed ($30\\,\\textrm{km/h}$) at a distance of $80$ meters."}] [{:db/id #edb/ref 17592186621014 :knowledge-point/_questions [{:db/id #edb/ref 17592186138429 :knowledge-point/id #uuid "4154d81b-c94a-57f7-80fa-0daa341505e6" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1d48ef-d48d-529c-9922-4ebba95dceda" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186621011} {:answer/id #uuid "3012355f-92a5-54a7-9447-cd713c6ff3ad" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186621012} {:answer/id #uuid "59cd7a4d-2c6a-5f9a-8cf7-8315ba2c285b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186621020} {:answer/id #uuid "6e965896-6328-5b98-bde0-9fe7ac88aa38" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186621025} {:answer/id #uuid "d2203f93-68f8-5b4c-b563-fa558c4fa175" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186621037}] :answer-field/correct {:answer/id #uuid "6e965896-6328-5b98-bde0-9fe7ac88aa38" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186621025} :answer-field/id #uuid "7c418d32-b5df-589e-8de3-0061b189b552" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186621027}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4261f832-a4b4-59e0-bc12-13bc87c19c99" :question/problem "![](images/eb/ebea0ea8bf8cc96880cf558d20edb7fa3c5ae2a3112b64cbffe4fdc686654108.png)\n\nThe graph above shows the number of liters of water in pool $A$ and pool $B$ as a function of time, measured in days. How many days will it take for both pools to contain the same amount of water?" :question/worked-solution "The pools have the same amount of water when the two graphs intersect.\n\n![](images/f8/f8e30556e9fd6e7665f7e2ea923280345da07f57b394cdea9f521a7a6e46bcae.png)\n\nIn this case, we have the point $(3,400)$. So, both pools have the same amount ($400\\,\\textrm{L}$) of water at $t=3$ days."}] [{:db/id #edb/ref 17592186621034 :knowledge-point/_questions [{:db/id #edb/ref 17592186138429 :knowledge-point/id #uuid "4154d81b-c94a-57f7-80fa-0daa341505e6" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4367e0fb-b7f4-5b90-a4b3-7f405f3af0ac" :answer/type {:db/ident :answer.type/math} :answer/value "3h" :db/id #edb/ref 17592186621015} {:answer/id #uuid "44241528-3b15-5649-9dad-ab1985ca62f0" :answer/type {:db/ident :answer.type/math} :answer/value "2h" :db/id #edb/ref 17592186621016} {:answer/id #uuid "61774d6f-7adc-50c2-9060-1d1d705fea35" :answer/type {:db/ident :a