 [{:answer-field/choices [{:answer/id #uuid "26e5d8b9-aa23-509f-9d82-cbc0a58b88aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257118} {:answer/id #uuid "523c5ff0-288c-54a6-8984-dab86593561a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257483} {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} {:answer/id #uuid "de5a4cff-b039-5894-8b6c-7aad63c636fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258717} {:answer/id #uuid "fb952160-6ec2-5819-80f3-0686d4603494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186258981}] :answer-field/correct {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} :answer-field/id #uuid "514ff102-c238-5181-bd9a-4ee63292ed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259176}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "569ad093-da2b-5144-992e-0f84b411665b" :question/math-academy-id "q-124263" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+av-2,\\,y=bu+cv-3\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 & -1 \\\\ 9 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}4 & -1 \\\\ 9 & 5\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}4u-v \\\\ 9u+5v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u-v-2 \\\\ 9u+5v-3\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+(-1)v-2,\\,y=9u+5v-3\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+9+5=13.\n$$"} {:db/id #edb/ref 17592186259643 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "506f9d2d-d08a-56f9-98e6-3535609b1da4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257470} {:answer/id #uuid "76cc7d25-0d63-5fa5-9287-8cd0b7cf87ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257829} {:answer/id #uuid "bbf5d7a0-0461-5380-8b1d-7aa6631a5d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258425} {:answer/id #uuid "c14197eb-d474-53b1-b351-f8738ddeafd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258471} {:answer/id #uuid "e94689f3-f817-50df-9027-5eb925d967a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258804}] :answer-field/correct {:answer/id #uuid "e94689f3-f817-50df-9027-5eb925d967a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258804} :answer-field/id #uuid "ea132969-c4fb-52c6-aa2f-d42f10a0b35d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e491209f-8e14-5a51-846e-3087f73ab2f3" :question/math-academy-id "q-124265" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+6v+b,\\,y=cu-4v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 & 6 \\\\ 3 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}1 & 6 \\\\ 3 & -4\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}u+6v \\\\ 3u-4v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+6v \\\\ 3u-4v\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=1u+6v+0,\\,y=3u-4v\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+0+3=4.\n$$"} {:db/id #edb/ref 17592186259644 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bc5571-4143-5aae-96cf-6f2be18ea704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186256958} {:answer/id #uuid "2b6e7a59-7e19-5f06-994d-4e3590c3b8bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257171} {:answer/id #uuid "c64c4347-213c-5d26-b1fc-9c4dcd0170a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258516} {:answer/id #uuid "d59fa816-e9ed-5fd9-bd9c-9869013fe1c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258655} {:answer/id #uuid "f8f07afd-8b4a-5912-b02f-c853e792c6e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258967}] :answer-field/correct {:answer/id #uuid "f8f07afd-8b4a-5912-b02f-c853e792c6e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258967} :answer-field/id #uuid "611144f2-0911-5d73-99aa-6da505f8fa68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259197}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cc9e110-657b-5c50-af6f-2ba6688d538a" :question/math-academy-id "q-124267" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au-2v+b,\\,y=4u+cv-2\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-6 & -2 \\\\ 4 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}-6 & -2 \\\\ 4 & 7\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}-6u-2v \\\\ 4u+7v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6u-2v+1 \\\\ 4u+7v-2\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-6u-2v+1,\\,y=4u+7v-2\n$$\n\nTherefore, we have\n\n$$\na+b+c=-6+1+7=2.\n$$"} {:db/id #edb/ref 17592186259652 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343b2207-66d5-57bb-87f6-c4c790c690d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257244} {:answer/id #uuid "ab7ec3bd-0bf2-5983-a44c-e00a3fdf0ceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258277} {:answer/id #uuid "b0e42a09-6baf-5d36-87f3-f42986684931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258323} {:answer/id #uuid "f23f4bbb-43d3-539b-a8e2-405d7732b7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258890} {:answer/id #uuid "f6097032-0646-54a4-8dab-1221f0240b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186258930}] :answer-field/correct {:answer/id #uuid "ab7ec3bd-0bf2-5983-a44c-e00a3fdf0ceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258277} :answer-field/id #uuid "ca41ba6d-3943-5258-9ae3-5aaa5c4554e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31239ffb-2521-5f24-adb5-1bf7dc8cd57c" :question/math-academy-id "q-124284" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4v-u,\\,y=3v-7\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & b \\\\ 0 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}c \\\\ -7\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4v-u \\\\ 3v-7\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4v-u \\\\ 3v-7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-u+4v \\\\ 3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -7\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-1 & 4 \\\\ 0 & 3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ -7\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+4+0=3.\n$$"} {:db/id #edb/ref 17592186259653 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca5b200-1e86-5077-aeb8-b67c50a6c8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256904} {:answer/id #uuid "10c3ff93-d73d-554e-87b3-0212fbed198e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186256936} {:answer/id #uuid "27911809-e171-5b95-b3fb-a9b7e21c7cab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257131} {:answer/id #uuid "9e61dc6e-2df8-5438-a1de-0bda0036241d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258175} {:answer/id #uuid "fb1e43fe-6e46-581d-8dc9-be67f6e9cca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258980}] :answer-field/correct {:answer/id #uuid "9e61dc6e-2df8-5438-a1de-0bda0036241d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258175} :answer-field/id #uuid "a9a47780-a23d-5f51-9883-7dae72cf3277" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259331}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79c75f5d-7fe0-5715-9bd2-b2946e30a081" :question/math-academy-id "q-124285" :question/problem "The matrix form of the affine transformation\n\n$$\nx=5u-3v-2,\\,y=2u+v+7\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5 & -3 \\\\ a & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}c \\\\ 7\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5u-3v-2 \\\\ 2u+v+7\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}5u-3v-2 \\\\ 2u+v+7\\end{bmatrix} \\\\  & =\\begin{bmatrix}5u-3v \\\\ 2u+v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}5 & -3 \\\\ 2 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+1+(-2)=1.\n$$"} {:db/id #edb/ref 17592186259655 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01350874-c575-5e87-9942-b73d549773cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186256793} {:answer/id #uuid "58d4a7a7-b300-54be-b8b9-e942e97ed67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257553} {:answer/id #uuid "5cf8de9f-1c39-50e9-ba1a-5b22b73cacee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257590} {:answer/id #uuid "b7e5fa5c-635b-5a31-a047-dcc83173e338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258390} {:answer/id #uuid "f878d7d8-0d4a-5961-98f0-e1d015a28949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258961}] :answer-field/correct {:answer/id #uuid "b7e5fa5c-635b-5a31-a047-dcc83173e338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258390} :answer-field/id #uuid "ecef4226-5d38-5b30-8307-348333368ee7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259446}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb674c4e-2ce4-5235-ac2b-98b363cda424" :question/math-academy-id "q-124292" :question/problem "The matrix form of the affine transformation\n\n$$\nx=3v-8u,\\,y=3u-v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & 3 \\\\ b & -1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3v-8u \\\\ 3u-v\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}3v-8u \\\\ 3u-v\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8u+3v \\\\ 3u-v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-8 & 3 \\\\ 3 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-8+3+0=-5.\n$$"} {:db/id #edb/ref 17592186259656 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d0da4d-3a14-594d-b8f6-132da7f61917" :answer/type {:db/id 