egin{bmatrix}-2 \\\\ -3\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}0 & -5 \\\\ -2 & 7\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-5+7+(-2)=0.\n$$"}] [{:db/id #edb/ref 17592186259657 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5242ad89-24a8-59cd-978d-3f922bae4da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186257484} {:answer/id #uuid "648b6c21-0d27-5132-aead-92eb0f89efc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257666} {:answer/id #uuid "ab8b2be3-dc38-5c58-b346-813a07b3593a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258278} {:answer/id #uuid "c9a7ff15-8e83-5c21-a366-f5f18ecdbc90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258538} {:answer/id #uuid "dde2292e-86d8-569d-9201-a0071cbb9521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258712}] :answer-field/correct {:answer/id #uuid "c9a7ff15-8e83-5c21-a366-f5f18ecdbc90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258538} :answer-field/id #uuid "6629122c-5a24-5ed6-8deb-f43d051c11d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259208}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c629231-167c-5031-b500-0861e24a5b23" :question/math-academy-id "q-124301" :question/problem "The matrix form of the affine transformation\n\n$$\nx=6u-v,\\,y=2u-3v+4\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & -1 \\\\ 2 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6u-v \\\\ 2u-3v+4\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}6u-v \\\\ 2u-3v+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}6u-v \\\\ 2u-3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 4\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}6 & -1 \\\\ 2 & -3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=6+(-3)+4=7.\n$$"}] [{:db/id #edb/ref 17592186435082 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec2e130-ad0b-5d90-874b-cafee34e58c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435066} {:answer/id #uuid "6bf5a0c1-0205-502f-9cbc-8cd0d9139fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186435067} {:answer/id #uuid "a0d4331d-d76a-550e-af61-65f77866dcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186435069} {:answer/id #uuid "d090baef-9223-53ba-b7a5-e64a993a1878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435074} {:answer/id #uuid "dcc4abca-dbd0-5a8c-8460-f14372be7eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186435075}] :answer-field/correct {:answer/id #uuid "a0d4331d-d76a-550e-af61-65f77866dcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186435069} :answer-field/id #uuid "3d3eb90b-b341-501f-a49e-f9c67d7e1ee8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fba38d94-94f1-5e40-9342-c81f8eabc355" :question/math-academy-id "q-124296" :question/problem "The matrix form of the affine transformation\n\n$$\nx=6u+4v+2,\\,y=5v-1\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6 & a \\\\ 0 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6u+4v+2 \\\\ 5v-1\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}6u+4v+2 \\\\ 5v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6u+4v \\\\ 5v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}6 & 4 \\\\ 0 & 5\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=4+5+(-1)=8.\n$$"}] [{:db/id #edb/ref 17592186435169 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c225a4-fa6b-5ff4-a3be-9440301a14e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435157} {:answer/id #uuid "99696a64-81b6-56b3-ae94-3cf2f2bf032d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186435159} {:answer/id #uuid "b2f12e59-3811-5fbe-a8bd-eda4370e2e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435161} {:answer/id #uuid "c4beb685-88bd-5864-8597-0ef45eddb0b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435162} {:answer/id #uuid "d78bfad4-b673-5a93-bb2a-0e0334cd3321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186435164}] :answer-field/correct {:answer/id #uuid "b2f12e59-3811-5fbe-a8bd-eda4370e2e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435161} :answer-field/id #uuid "29e8d3c2-d32c-5baa-954b-7b5d1efc7457" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f1617b1-29a0-58b4-80d3-cf8ca8d2090f" :question/math-academy-id "q-124288" :question/problem "The matrix form of the affine transformation\n\n$$\nx=2u+5v,\\,y=u-3v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2 & 5 \\\\ a & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}2 & 5 \\\\ 1 & -3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+(-3)+0=-2.\n$$"}] [{:db/id #edb/ref 17592186435170 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e78d75-7cc9-5f8f-a311-f9561d084ef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435151} {:answer/id #uuid "5cbd50d4-87c1-52b7-9640-b711a0fd95b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435153} {:answer/id #uuid "66027fe1-2bba-5e05-8206-4ca92bebfb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435155} {:answer/id #uuid "7df97388-6b5d-5314-a0e2-f9db5b72c685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186435156} {:answer/id #uuid "9e8c9a39-bea2-5dc9-ae9f-054f40df79f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435160}] :answer-field/correct {:answer/id #uuid "66027fe1-2bba-5e05-8206-4ca92bebfb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435155} :answer-field/id #uuid "9adca1c4-5980-5cfc-b795-52fbb2b1c569" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435168}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "924019d9-3882-5c74-a8d2-1e7c35a68ea0" :question/math-academy-id "q-124260" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+a,\\,y=6u+bv+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 & 0 \\\\ 6 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}4 & 0 \\\\ 6 & 2\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}4u \\\\ 6u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u \\\\ 6u+2v-1\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+0,\\,y=6u+2v+(-1)\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+2+(-1)=1.\n$$"}] [{:db/id #edb/ref 17592186435171 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5023974e-65e9-50b5-9103-6472584bc9df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435152} {:answer/id #uuid "606c1e22-4819-56b5-82a2-48e43550b035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186435154} {:answer/id #uuid "88148730-01ef-5f8f-8698-d5c0f9002897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435158} {:answer/id #uuid "d60c5735-4076-5c3e-b98e-aa72880ddf6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435163} {:answer/id #uuid "eeb2f54f-b084-5556-a569-1423fbe14b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435165}] :answer-field/correct {:answer/id #uuid "606c1e22-4819-56b5-82a2-48e43550b035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186435154} :answer-field/id #uuid "8859ffa2-d430-5120-8081-1bbcdaf58a41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435167}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abc616ba-5b7e-5285-91c7-65fdcb2a91f9" :question/math-academy-id "q-124299" :question/problem "The matrix form of the affine transformation\n\n$$\nx=v-7u,\\,y=2v-u\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & 1 \\\\ -1 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}c \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}v-7u \\\\ 2v-u\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v-7u \\\\ 2v-u\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7u+v \\\\ -u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-7 & 1 \\\\ -1 & 2\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-7+2+0=-5.\n$$"}] [{:db/id #edb/ref 17592186591665 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cdcdba9-09d7-5c5b-89d5-eb3ae94fb423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186591011} {:answer/id #uuid "396157a5-abfe-5f42-8fcb-06557b02e73b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186591086} {:answer/id #uuid "4cb8d268-3357-5312-9213-38e6b577c88f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186591127} {:answer/id #uuid "d4bb13a3-d665-5b16-ae22-b9793d2e4f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186591402} {:answer/id #uuid "d50e985c-ea50-5e7e-82f9-53f3f9013086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186591404}] :answer-field/correct {:answer/id #uuid "396157a5-abfe-5f42-8fcb-06557b02e73b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186591086} :answer-field/id #uuid "72b2e0b9-04f9-5048-880b-6211d52f3883" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591547}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d215719-bbcf-506e-b9f8-0434752f31dc" :question/math-academy-id "q-124269" :question/problem "The matrix form of the affine transformation\n\n$$\nx=8u+av+b,\\,y=cv+6\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}8 & 1 \\\\ 0 & -6\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 6\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}8 & 1 \\\\ 0 & -6\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}-5 \\\\ 6\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}8u+v \\\\ -6v\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}8u+v-5 \\\\ -6v+6\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=8u+1v+(-5),\\,y=-6v+6\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+(-5)+(-6)=-10.\n$$"}] [{:db/id #edb/ref 17592186591679 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf3e22b-5fae-5a6e-8d3c-b5b9969dde6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761775} {:answer/id #uuid "6071f90c-40aa-5209-8ab2-bc0abd0e7bdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761776}] :answer-field/correct {:answer/id #uuid "0cf3e22b-5fae-5a6e-8d3c-b5b9969dde6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761775} :answer-field/id #uuid "a8010a51-c13a-576e-9eba-d281a918012e" :answer-field/key "${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u(u+1) \\\\ v+1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186761777} {:answer-field/choices [{:answer/id #uuid "58b6cbdf-a868-5cbf-aa81-f3f27f92c41e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761778} {:answer/id #uuid "d459f0fb-931f-598e-9e2c-39999e3a87a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761779}] :answer-field/correct {:answer/id #uuid "d459f0fb-931f-598e-9e2c-39999e3a87a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761779} :answer-field/id #uuid "468d6c21-f3ea-5732-adc4-1d95de81a229" :answer-field/key "${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}v-2 \\\\ 5u-7\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186761780} {:answer-field/choices [{:answer/id #uuid "a8a25030-00cb-5357-a93f-64fac3a55d9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761781} {:answer/id #uuid "d14531ed-0d46-5c3b-ab6e-dfe924058aa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761782}] :answer-field/correct {:answer/id #uuid "d14531ed-0d46-5c3b-ab6e-dfe924058aa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761782} :answer-field/id #uuid "1ccf9035-a4f1-5f3b-a79a-e678e1087fd8" :answer-field/key "${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}-v \\\\ -v\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186761783}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d5c0b78-afcd-5c03-90bc-24317f6b2375" :question/math-academy-id "q-124240" :question/problem "Which of the following are affine transformations? Select all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is not affine since it contains the quadratic term ${u}^{2}.$\n\n- Transformation ${T}_{2}$ is affine. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v-2 \\\\ 5u-7\\end{bmatrix} \\\\  & =\\begin{bmatrix}v \\\\ 5u\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -7\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}0 & 1 \\\\ 5 & 0\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}-2 \\\\ -7\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\n- Transformation ${T}_{3}$ is affine. Notice that ${T}_{3}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}-v \\\\ -v\\end{bmatrix} \\\\  & =\\begin{bmatrix}-v \\\\ -v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}0 & -1 \\\\ 0 & -1\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nIn fact, the transformation ${T}_{3}$ is a linear transformation.\n\nTherefore, the correct answer is \"${T}_{2}$ and ${T}_{3}$ only.\""}] [{:db/id #edb/ref 17592186591692 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23a8e4af-31c4-5519-af11-7d86e8715160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186591052} {:answer/id #uuid "4f4ff3ea-48a2-5a17-b1e7-7449923d9780" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186591133} {:answer/id #uuid "724aa06d-f05a-569e-8275-f265ceddda9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186591200} {:answer/id #uuid "ce4acbcc-567d-5f8a-844b-1f5d441a3da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186591386} {:answer/id #uuid "e7014182-1831-5004-8e57-a669ad943917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186591442}] :answer-field/correct {:answer/id #uuid "23a8e4af-31c4-5519-af11-7d86e8715160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186591052} :answer-field/id #uuid "7aad1949-96d2-5d27-a1c7-dfe4ce2c355f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186591553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b67161bc-a152-5289-a964-e1aac0bf8b61" :question/math-academy-id "q-124264" :question/problem "The matrix form of the affine transformation\n\n$$\nx=2v+a,\\,y=bu+cv\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 & 2 \\\\ -7 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}8 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}0 & 2 \\\\ -7 & 4\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}8 \\\\ 0\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}2v \\\\ -7u+4v\\end{bmatrix}+\\begin{bmatrix}8 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2v+8 \\\\ -7u+4v\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=2v+8,\\,y=-7u+4v\n$$\n\nTherefore, we have\n\n$$\na+b+c=8+(-7)+4=5.\n$$"}] [{:db/id #edb/ref 17592186591712 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e624813-28c5-5284-bc77-e21e1db0938a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761748} {:answer/id #uuid "d51b1007-0803-5147-ac65-0d2ff7963b6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761749}] :answer-field/correct {:answer/id #uuid "7e624813-28c5-5284-bc77-e21e1db0938a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761748} :answer-field/id #uuid "fc31c009-57a4-5152-a3c2-d8c50f53a9ff" :answer-field/key "${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}uv \\\\ u+v\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186761750} {:answer-field/choices [{:answer/id #uuid "f08562d3-d33d-5920-b9fe-3a64caecce21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761751} {:answer/id #uuid "0aac4105-0634-5e75-85c9-e1d624d26c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761752}] :answer-field/correct {:answer/id #uuid "0aac4105-0634-5e75-85c9-e1d624d26c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761752} :answer-field/id #uuid "80f3fdae-7b6f-5f8e-b2ba-e31262040a1c" :answer-field/key "${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}v \\\\ 2v-u\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186761753} {:answer-field/choices [{:answer/id #uuid "88301c33-7a9b-5f6f-b57d-81c879dad8ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761754} {:answer/id #uuid "d6c70e98-3686-5cad-8d17-6c469afb9112" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186761755}] :answer-field/correct {:answer/id #uuid "88301c33-7a9b-5f6f-b57d-81c879dad8ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186761754} :answer-field/id #uuid "3b46763d-61bc-5335-b54c-c16223f3b7b0" :answer-field/key "${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}-{u}^{2} \\\\ 2u+v\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186761756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d81f269c-eb19-5276-a2f9-1af9f26afd2c" :question/math-academy-id "q-124232" :question/problem "Which of the following are affine transformations? Select all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is not affine since it contains the cross term $uv.$\n\n- Transformation ${T}_{2}$ is affine. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v \\\\ 2v-u\\end{bmatrix} \\\\  & =\\begin{bmatrix}v \\\\ -u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nIn fact, the transformation ${T}_{1}$ is a linear transformation.\n\n- Transformation ${T}_{3}$ is not affine since it contains the quadratic term ${u}^{2}.$\n\nTherefore, the correct answer is \"${T}_{2}$ only.\""}]}
