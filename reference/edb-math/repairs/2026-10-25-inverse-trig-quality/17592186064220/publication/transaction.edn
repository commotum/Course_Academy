f45e65" :answer-field/choices "747c5fbe-7e75-518d-8c8a-e490f78c6c3e"] [:db/add "5a2854ef-33d9-598b-9aef-0ec815f45e65" :answer-field/choices "0395acfe-788d-5ae8-95b8-1a877cfdb6de"] [:db/add "5a2854ef-33d9-598b-9aef-0ec815f45e65" :answer-field/choices "4c1f506a-329f-5cae-9645-f5af03831707"] [:db/add "5a2854ef-33d9-598b-9aef-0ec815f45e65" :answer-field/choices "c3076f3b-4804-5125-980f-22af622f8144"] [:db/add "5a2854ef-33d9-598b-9aef-0ec815f45e65" :answer-field/choices "1a17b406-1894-5d46-aefd-fd1aa307c104"] [:db/add "5a2854ef-33d9-598b-9aef-0ec815f45e65" :answer-field/correct "1a17b406-1894-5d46-aefd-fd1aa307c104"] [:db/ensure "5a2854ef-33d9-598b-9aef-0ec815f45e65" :answer-field/validate] [:db/add "87288a10-0160-532d-b809-b0f7a4ddc5a5" :question/id #uuid "87288a10-0160-532d-b809-b0f7a4ddc5a5"] [:db/add "87288a10-0160-532d-b809-b0f7a4ddc5a5" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{8}} \\frac{4}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "87288a10-0160-532d-b809-b0f7a4ddc5a5" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{4}=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{8}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{8}} \\frac{4}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}=\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{6}.\n$$"] [:db/add "87288a10-0160-532d-b809-b0f7a4ddc5a5" :question/difficulty :question.difficulty/easy] [:db/add "87288a10-0160-532d-b809-b0f7a4ddc5a5" :question/answer-fields "5a2854ef-33d9-598b-9aef-0ec815f45e65"] [:db/ensure "87288a10-0160-532d-b809-b0f7a4ddc5a5" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "87288a10-0160-532d-b809-b0f7a4ddc5a5"] [:db/add "4a82b43d-5997-5cc8-82c6-5885781d087b" :answer/id #uuid "4a82b43d-5997-5cc8-82c6-5885781d087b"] [:db/add "4a82b43d-5997-5cc8-82c6-5885781d087b" :answer/type :answer.type/math] [:db/add "4a82b43d-5997-5cc8-82c6-5885781d087b" :answer/value "\\frac{\\pi}{12}"] [:db/ensure "4a82b43d-5997-5cc8-82c6-5885781d087b" :answer/validate] [:db/add "3a317086-0fb3-5e60-97eb-7e2209cc5785" :answer/id #uuid "3a317086-0fb3-5e60-97eb-7e2209cc5785"] [:db/add "3a317086-0fb3-5e60-97eb-7e2209cc5785" :answer/type :answer.type/math] [:db/add "3a317086-0fb3-5e60-97eb-7e2209cc5785" :answer/value "\\frac{\\pi}{6}"] [:db/ensure "3a317086-0fb3-5e60-97eb-7e2209cc5785" :answer/validate] [:db/add "586d221f-e04a-5a5d-b5ac-089b39d994c8" :answer/id #uuid "586d221f-e04a-5a5d-b5ac-089b39d994c8"] [:db/add "586d221f-e04a-5a5d-b5ac-089b39d994c8" :answer/type :answer.type/math] [:db/add "586d221f-e04a-5a5d-b5ac-089b39d994c8" :answer/value "\\frac{\\pi}{4}"] [:db/ensure "586d221f-e04a-5a5d-b5ac-089b39d994c8" :answer/validate] [:db/add "255d1432-9742-50a6-9b4e-cf1f8e914ac3" :answer/id #uuid "255d1432-9742-50a6-9b4e-cf1f8e914ac3"] [:db/add "255d1432-9742-50a6-9b4e-cf1f8e914ac3" :answer/type :answer.type/math] [:db/add "255d1432-9742-50a6-9b4e-cf1f8e914ac3" :answer/value "\\frac{\\pi}{16}"] [:db/ensure "255d1432-9742-50a6-9b4e-cf1f8e914ac3" :answer/validate] [:db/add "450083e4-d68c-5778-86cf-a4661b953dc2" :answer/id #uuid "450083e4-d68c-5778-86cf-a4661b953dc2"] [:db/add "450083e4-d68c-5778-86cf-a4661b953dc2" :answer/type :answer.type/math] [:db/add "450083e4-d68c-5778-86cf-a4661b953dc2" :answer/value "\\frac{\\pi}{8}"] [:db/ensure "450083e4-d68c-5778-86cf-a4661b953dc2" :answer/validate] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/id #uuid "c74cab2f-c536-51f6-9f66-b71a69ff77bd"] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/key "answer"] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/type :answer-field.type/radio] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/choices "4a82b43d-5997-5cc8-82c6-5885781d087b"] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/choices "3a317086-0fb3-5e60-97eb-7e2209cc5785"] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/choices "586d221f-e04a-5a5d-b5ac-089b39d994c8"] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/choices "255d1432-9742-50a6-9b4e-cf1f8e914ac3"] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/choices "450083e4-d68c-5778-86cf-a4661b953dc2"] [:db/add "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/correct "450083e4-d68c-5778-86cf-a4661b953dc2"] [:db/ensure "c74cab2f-c536-51f6-9f66-b71a69ff77bd" :answer-field/validate] [:db/add "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49" :question/id #uuid "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49"] [:db/add "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{2}} \\frac{1}{4 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $1\\cdot \\frac{1}{2}=\\frac{1}{2}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{2}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{2}} \\frac{1}{4 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{1}{2}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{8}.\n$$"] [:db/add "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49" :question/difficulty :question.difficulty/easy] [:db/add "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49" :question/answer-fields "c74cab2f-c536-51f6-9f66-b71a69ff77bd"] [:db/ensure "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "aa1c5f06-a5af-50b4-9e18-5cc43e3dce49"] [:db/add "67743a5e-33fa-5aa0-8409-28b8c0569fd1" :answer/id #uuid "67743a5e-33fa-5aa0-8409-28b8c0569fd1"] [:db/add "67743a5e-33fa-5aa0-8409-28b8c0569fd1" :answer/type :answer.type/math] [:db/add "67743a5e-33fa-5aa0-8409-28b8c0569fd1" :answer/value "\\frac{\\pi}{8}"] [:db/ensure "67743a5e-33fa-5aa0-8409-28b8c0569fd1" :answer/validate] [:db/add "d6d0afd7-29c5-5d62-8e5b-4e1cb8e36314" :answer/id #uuid "d6d0afd7-29c5-5d62-8e5b-4e1cb8e36314"] [:db/add "d6d0afd7-29c5-5d62-8e5b-4e1cb8e36314" :answer/type :answer.type/math] [:db/add "d6d0afd7-29c5-5d62-8e5b-4e1cb8e36314" :answer/value "\\frac{\\pi}{4}"] [:db/ensure "d6d0afd7-29c5-5d62-8e5b-4e1cb8e36314" :answer/validate] [:db/add "ecba44fb-7afc-54c0-91fa-cfb05c08dd62" :answer/id #uuid "ecba44fb-7afc-54c0-91fa-cfb05c08dd62"] [:db/add "ecba44fb-7afc-54c0-91fa-cfb05c08dd62" :answer/type :answer.type/math] [:db/add "ecba44fb-7afc-54c0-91fa-cfb05c08dd62" :answer/value "\\frac{\\pi}{3}"] [:db/ensure "ecba44fb-7afc-54c0-91fa-cfb05c08dd62" :answer/validate] [:db/add "5e28e1d9-264a-54ea-853a-9204d1d56ff3" :answer/id #uuid "5e28e1d9-2