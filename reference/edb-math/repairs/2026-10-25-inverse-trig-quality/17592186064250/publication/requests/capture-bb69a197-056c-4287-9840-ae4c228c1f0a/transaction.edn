n\n$$\n\\frac{3 \\operatorname{arcsec}{\\left(2 x \\right)}}{2}+C.\n$$"] [:db/add "86e40079-fe16-51f5-a559-e14b50e86a2d" :question/difficulty :question.difficulty/moderate] [:db/add "86e40079-fe16-51f5-a559-e14b50e86a2d" :question/answer-fields "d10f510b-e1d6-5ef8-9977-6a607deb13d2"] [:db/ensure "86e40079-fe16-51f5-a559-e14b50e86a2d" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "86e40079-fe16-51f5-a559-e14b50e86a2d"] [:db/add "2a15597a-469d-5980-929a-eb4ba98ae1b1" :answer/id #uuid "2a15597a-469d-5980-929a-eb4ba98ae1b1"] [:db/add "2a15597a-469d-5980-929a-eb4ba98ae1b1" :answer/type :answer.type/math] [:db/add "2a15597a-469d-5980-929a-eb4ba98ae1b1" :answer/value "\\frac{2 \\operatorname{arcsec}{\\left(x \\right)}}{3}+C"] [:db/ensure "2a15597a-469d-5980-929a-eb4ba98ae1b1" :answer/validate] [:db/add "36f3f16e-6fc3-57e5-93d6-0b1d1d6e199a" :answer/id #uuid "36f3f16e-6fc3-57e5-93d6-0b1d1d6e199a"] [:db/add "36f3f16e-6fc3-57e5-93d6-0b1d1d6e199a" :answer/type :answer.type/math] [:db/add "36f3f16e-6fc3-57e5-93d6-0b1d1d6e199a" :answer/value "12 \\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "36f3f16e-6fc3-57e5-93d6-0b1d1d6e199a" :answer/validate] [:db/add "c0bed354-7200-5170-ab6a-331808b6dada" :answer/id #uuid "c0bed354-7200-5170-ab6a-331808b6dada"] [:db/add "c0bed354-7200-5170-ab6a-331808b6dada" :answer/type :answer.type/math] [:db/add "c0bed354-7200-5170-ab6a-331808b6dada" :answer/value "\\frac{8 \\operatorname{arcsec}{\\left(\\frac{3 x}{2} \\right)}}{3}+C"] [:db/ensure "c0bed354-7200-5170-ab6a-331808b6dada" :answer/validate] [:db/add "8720cc07-5d69-5900-811b-85adc2572af4" :answer/id #uuid "8720cc07-5d69-5900-811b-85adc2572af4"] [:db/add "8720cc07-5d69-5900-811b-85adc2572af4" :answer/type :answer.type/math] [:db/add "8720cc07-5d69-5900-811b-85adc2572af4" :answer/value "\\frac{2 \\operatorname{arcsec}{\\left(3 x \\right)}}{3}+C"] [:db/ensure "8720cc07-5d69-5900-811b-85adc2572af4" :answer/validate] [:db/add "19abc965-9d52-5a96-b405-5110dee1