}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2 \\operatorname{arcsec}{\\left(2 x \\right)}+C.\n$$"] [:db/add "87312669-caa3-5cc6-a042-e2cd54f8a473" :question/difficulty :question.difficulty/easy] [:db/add "87312669-caa3-5cc6-a042-e2cd54f8a473" :question/answer-fields "80e900ad-4468-5fc4-8ed1-9121bc66a208"] [:db/ensure "87312669-caa3-5cc6-a042-e2cd54f8a473" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "87312669-caa3-5cc6-a042-e2cd54f8a473"] [:db/add "04cadad9-62ff-577a-9e66-0ac6d64973aa" :answer/id #uuid "04cadad9-62ff-577a-9e66-0ac6d64973aa"] [:db/add "04cadad9-62ff-577a-9e66-0ac6d64973aa" :answer/type :answer.type/math] [:db/add "04cadad9-62ff-577a-9e66-0ac6d64973aa" :answer/value "6 \\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "04cadad9-62ff-577a-9e66-0ac6d64973aa" :answer/validate] [:db/add "57ba9e06-2732-580d-be73-6d2e232f31f0" :answer/id #uuid "57ba9e06-2732-580d-be73-6d2e232f31f0"] [:db/add "57ba9e06-2732-580d-be73-6d2e232f31f0" :answer/type :answer.type/math] [:db/add "57ba9e06-2732-580d-be73-6d2e232f31f0" :answer/value "6 \\operatorname{arcsec}{\\left(6 x \\right)}+C"] [:db/ensure "57ba9e06-2732-580d-be73-6d2e232f31f0" :answer/validate] [:db/add "a2b373af-a7d5-51f5-9c8a-e6bf22bb51f3" :answer/id #uuid "a2b373af-a7d5-51f5-9c8a-e6bf22bb51f3"] [:db/add "a2b373af-a7d5-51f5-9c8a-e6bf22bb51f3" :answer/type :answer.type/math] [:db/add "a2b373af-a7d5-51f5-9c8a-e6bf22bb51f3" :answer/value "6 \\operatorname{arcsec}{\\left(\\frac{x}{3} \\right)}+C"] [:db/ensure "a2b373af-a7d5-51f5-9c8a-e6bf22bb51f3" :answer/validate] [:db/add "4c151256-1780-585f-b025-783b78962d9f" :answer/id #uuid "4c151256-1780-585f-b025-783b78962d9f"] [:db/add "4c151256-1780-585f-b025-783b78962d9f" :answer/type :answer.type/math] [:db/add "4c151256-1780-585f-b025-783b78962d9f" :answer/value "\\frac{3 \\operatorname{arcsec}{\\left(6 x \\right)}}{2}+C"] [:db/ensure "4c151256-1780-585f-b025-783b78962d9f" :answer/validate] [:db/add "096f48d2-ec0e-