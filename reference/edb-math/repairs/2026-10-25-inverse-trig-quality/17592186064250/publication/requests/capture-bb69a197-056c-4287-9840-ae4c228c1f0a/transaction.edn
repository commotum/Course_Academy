rac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=\\frac{2}{3}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2 \\operatorname{arcsec}{\\left(3 x \\right)}}{3}+C.\n$$"] [:db/add "0a954013-9d72-5518-b90c-e3c2316d426f" :question/difficulty :question.difficulty/moderate] [:db/add "0a954013-9d72-5518-b90c-e3c2316d426f" :question/answer-fields "b07ff835-a21d-5030-ae6e-53a3c5d2eecb"] [:db/ensure "0a954013-9d72-5518-b90c-e3c2316d426f" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "0a954013-9d72-5518-b90c-e3c2316d426f"] [:db/add "736c4ccb-5805-5419-9c33-079154ebd1b9" :answer/id #uuid "736c4ccb-5805-5419-9c33-079154ebd1b9"] [:db/add "736c4ccb-5805-5419-9c33-079154ebd1b9" :answer/type :answer.type/math] [:db/add "736c4ccb-5805-5419-9c33-079154ebd1b9" :answer/value "- \\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "736c4ccb-5805-5419-9c33-079154ebd1b9" :answer/validate] [:db/add "f721a244-ba6c-5f4a-a24d-5fb059034355" :answer/id #uuid "f721a244-ba6c-5f4a-a24d-5fb059034355"] [:db/add "f721a244-ba6c-5f4a-a24d-5fb059034355" :answer/type :answer.type/math] [:db/add "f721a244-ba6c-5f4a-a24d-5fb059034355" :answer/value "\\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "f721a244-ba6c-5f4a-a24d-5fb059034355" :answer/validate] [:db/add "ef8f0de4-22f0-5087-9b64-3681fc8ec566" :answer/id #uuid "ef8f0de4-22f0-5087-9b64-3681fc8ec566"] [:db/add "ef8f0de4-22f0-5087-9b64-3681fc8ec566" :answer/type :answer.type/math] [:db/add "ef8f0de4-22f0-5087-9b64-3681fc8ec566" :answer/value "\\operatorname{arcsec}{\\left(\\frac{x}{3} \\right)}+C"] [:db/ensure "ef8f0de4-22f0-5087-9b64-3681fc8ec566" :answer/validate] [:db/add "5d399293-a41f-5587-81ac-23a5ea9c9046" :answer/id #uuid "5d399293-a41f-5587-81ac-23a5ea9c9046"] [:db/add "5d399293-a41f-5587-81ac-23a5ea9c9046" :answer/type :answer.type/math] [:db/add "5d399293-a41f-5587-81ac-23a5ea9c9046" :answer/value "3 \\operatorname{arcsec}{\\left(3 x