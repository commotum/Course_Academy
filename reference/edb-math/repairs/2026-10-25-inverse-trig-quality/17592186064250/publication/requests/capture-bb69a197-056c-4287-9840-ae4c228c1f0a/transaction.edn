\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n4\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=4\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4 \\operatorname{arcsec}{\\left(4 x \\right)}+C.\n$$"] [:db/add "ba3dffb2-273b-5194-97b3-bd7ef9fd4445" :question/difficulty :question.difficulty/hard] [:db/add "ba3dffb2-273b-5194-97b3-bd7ef9fd4445" :question/answer-fields "59626e45-b2ca-5ac1-8e2e-56b8d4ac0147"] [:db/ensure "ba3dffb2-273b-5194-97b3-bd7ef9fd4445" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "ba3dffb2-273b-5194-97b3-bd7ef9fd4445"] [:db/add "3be9ef6a-e376-5505-ab84-b4b5f48edf97" :answer/id #uuid "3be9ef6a-e376-5505-ab84-b4b5f48edf97"] [:db/add "3be9ef6a-e376-5505-ab84-b4b5f48edf97" :answer/type :answer.type/math] [:db/add "3be9ef6a-e376-5505-ab84-b4b5f48edf97" :answer/value "2 \\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "3be9ef6a-e376-5505-ab84-b4b5f48edf97" :answer/validate] [:db/add "4f1694c2-d412-5b53-80e0-b1a194a841d7" :answer/id #uuid "4f1694c2-d412-5b53-80e0-b1a194a841d7"] [:db/add "4f1694c2-d412-5b53-80e0-b1a194a841d7" :answer/type :answer.type/math] [:db/add "4f1694c2-d412-5b53-80e0-b1a194a841d7" :answer/value "2 \\operatorname{arcsec}{\\left(\\frac{x}{3} \\right)}+C"] [:db/ensure "4f1694c2-d412-5b53-80e0-b1a194a841d7" :answer/validate] [:db/add "de3c034f-ab2d-5bcb-ad80-b985d54bd6d9" :answer/id #uuid "de3c034f-ab2d-5bcb-ad80-b985d54bd6d9"] [:db/add "de3c034f-ab2d-5bcb-ad80-b985d54bd6d9" :answer/type :answer.type/math] [:db/add "de3c034f-ab2d-5bcb-ad80-b985d54bd6d9" :answer/value "\\operatorname{arcsec}{\\left(x \\right)}+C"] [:db/ensure "de3c034f-ab2d-5bcb-ad80-b985d54bd6d9" :answer/validate] [:db/add "7cca6bd5-0501-52cd-aa46-85eea1b8b517" :answer/id #uuid "7cca6bd5-0501-52cd-aa46-85eea1b8b517"] [:db/add "7cca6bd5-0501-52cd-aa46-85eea1b8b517" :answer/type :answer.type/math] [:db/add "7cca6bd5-0501-52cd-aa46-85ee