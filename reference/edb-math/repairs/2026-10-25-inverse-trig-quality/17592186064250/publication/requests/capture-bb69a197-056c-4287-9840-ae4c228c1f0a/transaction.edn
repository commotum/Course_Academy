iculty/hard] [:db/add "78833b8c-01c5-525b-8474-1e096f10359a" :question/answer-fields "0f8955bb-f9f2-5e62-91ca-cd8bbce1d0c0"] [:db/ensure "78833b8c-01c5-525b-8474-1e096f10359a" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "78833b8c-01c5-525b-8474-1e096f10359a"] [:db/add "ab84da90-1309-5127-9cfc-9761787849fd" :answer/id #uuid "ab84da90-1309-5127-9cfc-9761787849fd"] [:db/add "ab84da90-1309-5127-9cfc-9761787849fd" :answer/type :answer.type/math] [:db/add "ab84da90-1309-5127-9cfc-9761787849fd" :answer/value "4 \\operatorname{arcsec}{\\left(5 x \\right)}+C"] [:db/ensure "ab84da90-1309-5127-9cfc-9761787849fd" :answer/validate] [:db/add "e354094a-b1f9-5bd1-ab28-222799f61b1c" :answer/id #uuid "e354094a-b1f9-5bd1-ab28-222799f61b1c"] [:db/add "e354094a-b1f9-5bd1-ab28-222799f61b1c" :answer/type :answer.type/math] [:db/add "e354094a-b1f9-5bd1-ab28-222799f61b1c" :answer/value "2 \\operatorname{arcsec}{\\left(\\frac{x}{5} \\right)}+C"] [:db/ensure "e354094a-b1f9-5bd1-ab28-222799f61b1c" :answer/validate] [:db/add "2da20013-998b-5262-8fde-9e1d35e7146b" :answer/id #uuid "2da20013-998b-5262-8fde-9e1d35e7146b"] [:db/add "2da20013-998b-5262-8fde-9e1d35e7146b" :answer/type :answer.type/math] [:db/add "2da20013-998b-5262-8fde-9e1d35e7146b" :answer/value "\\operatorname{arcsec}{\\left(\\frac{5 x}{2} \\right)}+C"] [:db/ensure "2da20013-998b-5262-8fde-9e1d35e7146b" :answer/validate] [:db/add "64a93082-23b4-5666-9fd3-b0c4c73c6731" :answer/id #uuid "64a93082-23b4-5666-9fd3-b0c4c73c6731"] [:db/add "64a93082-23b4-5666-9fd3-b0c4c73c6731" :answer/type :answer.type/math] [:db/add "64a93082-23b4-5666-9fd3-b0c4c73c6731" :answer/value "50 \\operatorname{arcsec}{\\left(5 x \\right)}+C"] [:db/ensure "64a93082-23b4-5666-9fd3-b0c4c73c6731" :answer/validate] [:db/add "9926fadc-d9db-58bf-b261-b1cbce38a466" :answer/id #uuid "9926fadc-d9db-58bf-b261-b1cbce38a466"] [:db/add "9926fadc-d9db-58bf-b261-b1cbce38a466" :answer/type :answer.type/math] [:db/add "9926fadc-d9db-58bf-b261-b1cbce3