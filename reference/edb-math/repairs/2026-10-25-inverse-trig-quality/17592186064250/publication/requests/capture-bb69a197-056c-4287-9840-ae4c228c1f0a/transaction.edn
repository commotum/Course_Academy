t)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2 \\operatorname{arcsec}{\\left(5 x \\right)}+C.\n$$"] [:db/add "d5c52375-291e-5e77-89aa-497c8e0e0c18" :question/difficulty :question.difficulty/easy] [:db/add "d5c52375-291e-5e77-89aa-497c8e0e0c18" :question/answer-fields "8a38e249-d735-59b6-8e25-5b7a1bf06196"] [:db/ensure "d5c52375-291e-5e77-89aa-497c8e0e0c18" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "d5c52375-291e-5e77-89aa-497c8e0e0c18"] [:db/add "de63f920-2741-5412-a959-c4c19493bba9" :answer/id #uuid "de63f920-2741-5412-a959-c4c19493bba9"] [:db/add "de63f920-2741-5412-a959-c4c19493bba9" :answer/type :answer.type/math] [:db/add "de63f920-2741-5412-a959-c4c19493bba9" :answer/value "2 \\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "de63f920-2741-5412-a959-c4c19493bba9" :answer/validate] [:db/add "2bad1cd7-8843-5e41-879f-ae58266e3014" :answer/id #uuid "2bad1cd7-8843-5e41-879f-ae58266e3014"] [:db/add "2bad1cd7-8843-5e41-879f-ae58266e3014" :answer/type :answer.type/math] [:db/add "2bad1cd7-8843-5e41-879f-ae58266e3014" :answer/value "2 \\operatorname{arcsec}{\\left(\\frac{x}{3} \\right)}+C"] [:db/ensure "2bad1cd7-8843-5e41-879f-ae58266e3014" :answer/validate] [:db/add "d1071f17-8e71-50ea-a8a7-7008de3ce6d7" :answer/id #uuid "d1071f17-8e71-50ea-a8a7-7008de3ce6d7"] [:db/add "d1071f17-8e71-50ea-a8a7-7008de3ce6d7" :answer/type :answer.type/math] [:db/add "d1071f17-8e71-50ea-a8a7-7008de3ce6d7" :answer/value "\\operatorname{arcsec}{\\left(x \\right)}+C"] [:db/ensure "d1071f17-8e71-50ea-a8a7-7008de3ce6d7" :answer/validate] [:db/add "ff1daa84-ca50-5704-9fc2-43d73e7555f3" :answer/id #uuid "ff1daa84-ca50-5704-9fc2-43d73e7555f3"] [:db/add "ff1daa84-ca50-5704-9fc2-43d73e7555f3" :answer/type :answer.type/math] [:db/add "ff1daa84-ca50-5704-9fc2-43d73e7555f3" :answer/value "\\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "ff1daa84-ca50-5704-9fc2-43d73e7555f3" :answer/validate] [:db/add "85724037-1f0e-5d54-ba19-348f9a837781" :answer/id