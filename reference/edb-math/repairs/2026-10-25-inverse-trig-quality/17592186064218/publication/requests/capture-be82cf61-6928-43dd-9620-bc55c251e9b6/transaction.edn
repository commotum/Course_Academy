f5fe4-8b95-51ff-bf5b-34b2f15cde44"] [:db/ensure "ebf72a16-0cfd-542f-9be6-bfa2444a60bd" :answer-field/validate] [:db/add "25e27582-f1e2-52a4-85d6-86949f5fcd7e" :question/id #uuid "25e27582-f1e2-52a4-85d6-86949f5fcd7e"] [:db/add "25e27582-f1e2-52a4-85d6-86949f5fcd7e" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "25e27582-f1e2-52a4-85d6-86949f5fcd7e" :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n\\sqrt{4 - x^{2}}=2\\sqrt{1-(\\frac{x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{2}\\cdot 2=1$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\arcsin{\\left(\\frac{x}{2} \\right)}+C.\n$$"] [:db/add "25e27582-f1e2-52a4-85d6-86949f5fcd7e" :question/difficulty :question.difficulty/moderate] [:db/add "25e27582-f1e2-52a4-85d6-86949f5fcd7e" :question/answer-fields "ebf72a16-0cfd-542f-9be6-bfa2444a60bd"] [:db/ensure "25e27582-f1e2-52a4-85d6-86949f5fcd7e" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "25e27582-f1e2-52a4-85d6-86949f5fcd7e"] [:db/add "5d658b5b-2328-506c-9d6a-a87751bb1c85" :answer/id #uuid "5d658b5b-2328-506c-9d6a-a87751bb1c85"] [:db/add "5d658b5b-2328-506c-9d6a-a87751bb1c85" :answer/type :answer.type/math] [:db/add "5d658b5b-2328-506c-9d6a-a87751bb1c85" :answer/value "8 \\arcsin{\\left(\\frac{x}{2} \\right)}+C"] [:db/ensure "5d658b5b-2328-506c-9d6a-a87751bb1c85" :answer/validate] [:db/add "5c1ec6d9-1702-531b-a623-191b71ca6d5f" :answer/id #uuid "5c1ec6d9-1702-531b-a623-191b71ca6d5f"] [:db/add "5c1ec6d9-1702-531b-a623-191b71ca6d5f" :answer/type :answer.type/math] [:db/add "5c1ec6d9-1702-531b-a623-191b71ca6d5f" :answer/value "2 \\arcsin{\\left(\\frac{x}{2} \\right)}+C"] [:db/ensure "5c1ec6d9-1702-531b-a623-191b71ca6d5f" :answer/validate] [:db/add "ae19402f-e1b9-5216-a19a-c543f44c6ebc" :answer/id #uuid "ae19402f-e1b9-5216-a19a-c543f44c6ebc"] [:db/add "ae19402f-e1b9-5216-a19a-c543f44c6ebc" :answer/type :answer.type/math] [:db/add "ae19402f-e1b9-5216-a19a-c543f44c6ebc" :answer/value "8 \\arcsin{\\left(\\frac{x}{4} \\right)}+C"] [:db/ensure "ae19402f-e1b9-5216-a19a-c543f44c6ebc" :answer/validate] [:db/add "5548f241-9fad-51a4-bc9d-41471a85181b" :answer/id #uuid "5548f241-9fad-51a4-bc9d-41471a85181b"] [:db/add "5548f241-9fad-51a4-bc9d-41471a85181b" :answer/type :answer.type/math] [:db/add "5548f241-9fad-51a4-bc9d-41471a85181b" :answer/value "4 \\arcsin{\\left(\\frac{x}{2} \\right)}+C"] [:db/ensure "5548f241-9fad-51a4-bc9d-41471a85181b" :answer/validate] [:db/add "79d2d7c4-f466-5555-a50a-d30efd1830be" :answer/id #uuid "79d2d7c4-f466-5555-a50a-d30efd1830be"] [:db/add "79d2d7c4-f466-5555-a50a-d30efd1830be" :answer/type :answer.type/math] [:db/add "79d2d7c4-f466-5555-a50a-d30efd1830be" :answer/value "\\arcsin{\\left(\\frac{x}{2} \\right)}+C"] [:db/ensure "79d2d7c4-f466-5555-a50a-d30efd1830be" :answer/validate] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/id #uuid "f057d5ef-5572-52d5-b185-4928b28e1ce5"] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/key "answer"] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/type :answer-field.type/radio] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/choices "5d658b5b-2328-506c-9d6a-a87751bb1c85"] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/choices "5c1ec6d9-1702-531b-a623-191b71ca6d5f"] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/choices "ae19402f-e1b9-5216-a19a-c543f44c6ebc"] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/choices "5548f241-9fad-51a4-bc9d-41471a85181b"] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/choices "79d2d7c4-f466-5555-a50a-d30efd1830be"] [:db/add "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/correct "5548f241-9fad-51a4-bc9d-41471a85181b"] [:db/ensure "f057d5ef-5572-52d5-b185-4928b28e1ce5" :answer-field/validate] [:db/add "1325f05c-6254-5239-924a-ed17def24a85" :question/id #uuid "1325f05c-6254-5239-924a-ed17def24a85"] [:db/add "1325f05c-6254-5239-924a-ed17def24a85" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "1325f05c-6254-5239-924a-ed17def24a85" :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n\\sqrt{4 - x^{2}}=2\\sqrt{1-(\\frac{x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $2\\cdot 2=4$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n4\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=4\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4 \\arcsin{\\left(\\frac{x}{2} \\right)}+C.\n$$"] [:db/add "1325f05c-6254-5239-924a-ed17def24a85" :question/difficulty :question.difficulty/moderate] [:db/add "1325f05c-6254-5239-924a-ed17def24a85" :question/answer-fields "f057d5ef-5572-52d5-b185-4928b28e1ce5"] [:db/ensure "1325f05c-6254-5239-924a-ed17def24a85" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "1325f0