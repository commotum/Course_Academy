x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{1}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{5}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{1}{5}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\arcsin{\\left(\\frac{5 x}{4} \\right)}}{5}+C.\n$$"] [:db/add "bbd73b66-43fb-5914-ab3a-ff8ddcbeb86d" :question/difficulty :question.difficulty/hard] [:db/add "bbd73b66-43fb-5914-ab3a-ff8ddcbeb86d" :question/answer-fields "fd7d9ccf-4c7a-513d-a37e-8fac28d85cd3"] [:db/ensure "bbd73b66-43fb-5914-ab3a-ff8ddcbeb86d" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "bbd73b66-43fb-5914-ab3a-ff8ddcbeb86d"] [:db/add "1897b663-b2c1-5a67-9f34-25c67e78c376" :answer/id #uuid "1897b663-b2c1-5a67-9f34-25c67e78c376"] [:db/add "1897b663-b2c1-5a67-9f34-25c67e78c376" :answer/type :answer.type/math] [:db/add "1897b663-b2c1-5a67-9f34-25c67e78c376" :answer/value "- \\arcsin{\\left(\\frac{3 x}{4} \\right)}+C"] [:db/ensure "1897b663-b2c1-5a67-9f34-25c67e78c376" :answer/validate] [:db/add "1adc8a3d-9021-5260-bfe3-000b99e0b5ad" :answer/id #uuid "1adc8a3d-9021-5260-bfe3-000b99e0b5ad"] [:db/add "1adc8a3d-9021-5260-bfe3-000b99e0b5ad" :answer/type :answer.type/math] [:db/add "1adc8a3d-9021-5260-bfe3-000b99e0b5ad" :answer/value "\\arcsin{\\left(\\frac{3 x}{4} \\right)}+C"] [:db/ensure "1adc8a3d-9021-5260-bfe3-000b99e0b5ad" :answer/validate] [:db/add "15233785-ebbb-5b04-888c-39145e613120" :answer/id #uuid "15233785-ebbb-5b04-888c-39145e613120"] [:db/add "15233785-ebbb-5b04-888c-39145e613120" :answer/type :answer.type/math] [:db/add "15233785-ebbb-5b04-888c-39145e613120" :answer/value "2 \\arcsin{\\left(\\frac{3 x}{8} \\right)}+C"] [:db/ensure "15233785-ebbb-5b04-888c-39145e613120" :answer/validate] [:db/add "97d9c546-0c6a-5900-9eb2-0aec26062516" :answer/id #u