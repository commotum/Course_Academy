rcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\arcsin{\\left(2 x \\right)}+C.\n$$"] [:db/add "5a7f5a30-c6e1-58d7-a9cd-e61820b8d937" :question/difficulty :question.difficulty/easy] [:db/add "5a7f5a30-c6e1-58d7-a9cd-e61820b8d937" :question/answer-fields "aa442492-1a48-5638-9e44-d4baa87309c3"] [:db/ensure "5a7f5a30-c6e1-58d7-a9cd-e61820b8d937" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "5a7f5a30-c6e1-58d7-a9cd-e61820b8d937"] [:db/add "6b2623dc-77a3-5b8a-8a72-14782a462076" :answer/id #uuid "6b2623dc-77a3-5b8a-8a72-14782a462076"] [:db/add "6b2623dc-77a3-5b8a-8a72-14782a462076" :answer/type :answer.type/math] [:db/add "6b2623dc-77a3-5b8a-8a72-14782a462076" :answer/value "\\frac{4 \\arcsin{\\left(3 x \\right)}}{3}+C"] [:db/ensure "6b2623dc-77a3-5b8a-8a72-14782a462076" :answer/validate] [:db/add "ef049f6f-f92b-5d23-9c05-14d78106135a" :answer/id #uuid "ef049f6f-f92b-5d23-9c05-14d78106135a"] [:db/add "ef049f6f-f92b-5d23-9c05-14d78106135a" :answer/type :answer.type/math] [:db/add "ef049f6f-f92b-5d23-9c05-14d78106135a" :answer/value "\\frac{4 \\arcsin{\\left(x \\right)}}{3}+C"] [:db/ensure "ef049f6f-f92b-5d23-9c05-14d78106135a" :answer/validate] [:db/add "56856fb1-af92-51e5-878f-41aafe2b393f" :answer/id #uuid "56856fb1-af92-51e5-878f-41aafe2b393f"] [:db/add "56856fb1-af92-51e5-878f-41aafe2b393f" :answer/type :answer.type/math] [:db/add "56856fb1-af92-51e5-878f-41aafe2b393f" :answer/value "\\frac{4 \\arcsin{\\left(\\frac{3 x}{2} \\right)}}{3}+C"] [:db/ensure "56856fb1-af92-51e5-878f-41aafe2b393f" :answer/validate] [:db/add "dc9e6327-b8de-5fd8-b690-7a754d4e03ba" :answer/id #uuid "dc9e6327-b8de-5fd8-b690-7a754d4e03ba"] [:db/add "dc9e6327-b8de-5fd8-b690-7a754d4e03ba" :answer/type :answer.type/math] [:db/add "dc9e6327-b8de-5fd8-b690-7a754d4e03ba" :answer/value "\\frac{8 \\arcsin{\\left(3 x \\right)}}{3}+C"] [:db/ensure "dc9e6327-b8de-5fd8-b690-7a754d4