99057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/type :answer-field.type/radio] [:db/add "899057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/choices "45c4d2f8-0a59-58a0-afb8-437ec9a927fe"] [:db/add "899057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/choices "62f8de1c-84f8-5756-93aa-4b86e9f67694"] [:db/add "899057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/choices "09c33ad4-d706-5fcd-8528-b693b2919e23"] [:db/add "899057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/choices "01d7990c-6076-539b-89af-dd0227bc8a51"] [:db/add "899057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/choices "4abef276-42a3-5c7a-a288-8ef28e023074"] [:db/add "899057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/correct "62f8de1c-84f8-5756-93aa-4b86e9f67694"] [:db/ensure "899057db-ce48-5a16-8b7d-168741f3d9c7" :answer-field/validate] [:db/add "37f0de51-d490-5e2f-b853-70b97b9c1644" :question/id #uuid "37f0de51-d490-5e2f-b853-70b97b9c1644"] [:db/add "37f0de51-d490-5e2f-b853-70b97b9c1644" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "37f0de51-d490-5e2f-b853-70b97b9c1644" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{4}=\\frac{3}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{3}{4}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3 \\arcsin{\\left(4 x \\right)}}{4}+C.\n$$"] [:db/add "37f0de51-d490-5e2f-b853-70b97b9c1644" :question/difficulty :question.difficulty/easy] [:db/add "37f0de51-d490-5e2f-b853-70b97b9c1644" :question/answer-fields "899057db-ce48-5a16-8b7d-168741f3d9c7"] [:db/ensure "37f0de51-d490-5e2f-b853-70b97b9c1644" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "37f0de51-d490-5e2f-b853-70b97b9c1644"] [:db/add "34891f17-48b7-56d7-b635-162a1e0e2ef2" :answer/id #uuid "34891f17-48b7-56d7-b635-162a1e0e2ef2"] [:db/add "34891f17-48b7-56d7-b635-162a1e0e2ef2" :answer/type :answer.type/math] [:db/add "34891f17-48b7-56d7-b635-162a1e0e2ef2" :answer/value "\\arcsin{\\left(x \\right)}+C"] [:db/ensure "34891f17-48b7-56d7-b635-162a1e0e2ef2" :answer/validate] [:db/add "a12260ee-3446-55f7-9567-50260082d6c7" :answer/id #uuid "a12260ee-3446-55f7-9567-50260082d6c7"] [:db/add "a12260ee-3446-55f7-9567-50260082d6c7" :answer/type :answer.type/math] [:db/add "a12260ee-3446-55f7-9567-50260082d6c7" :answer/value "\\arcsin{\\left(4 x \\right)}+C"] [:db/ensure "a12260ee-3446-55f7-9567-50260082d6c7" :answer/validate] [:db/add "89000008-85cb-5a3b-be1b-d545a11fce6c" :answer/id #uuid "89000008-85cb-5a3b-be1b-d545a11fce6c"] [:db/add "89000008-85cb-5a3b-be1b-d545a11fce6c" :answer/type :answer.type/math] [:db/add "89000008-85cb-5a3b-be1b-d545a11fce6c" :answer/value "\\arcsin{\\left(2 x \\right)}+C"] [:db/ensure "89000008-85cb-5a3b-be1b-d545a11fce6c" :answer/validate] [:db/add "36ec5817-6677-577d-bc70-17fc921b804f" :answer/id #uuid "36ec5817-6677-577d-bc70-17fc921b804f"] [:db/add "36ec5817-6677-577d-bc70-17fc921b804f" :answer/type :answer.type/math] [:db/add "36ec5817-6677-577d-bc70-17fc921b804f" :answer/value "\\frac{\\arcsin{\\left(x \\right)}}{2}+C"] [:db/ensure "36ec5817-6677-577d-bc70-17fc921b804f" :answer/validate] [:db/add "dcf2b61a-1be3-5fc1-ad0e-031a01bc5c24" :answer/id #uuid "dcf2b61a-1be3-5fc1-ad0e-031a01bc5c24"] [:db/add "dcf2b61a-1be3-5fc1-ad0e-031a01bc5c24" :answer/type :answer.type/math] [:db/add "dcf2b61a-1be3-5fc1-ad0e-031a01bc5c24" :answer/