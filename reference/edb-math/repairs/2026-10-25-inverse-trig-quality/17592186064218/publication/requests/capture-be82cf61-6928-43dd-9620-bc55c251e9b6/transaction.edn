c-689e-5068-b3ad-76523ffb4116" :answer-field/choices "a4b10566-bb01-5fbc-87c0-fa8abe3f96da"] [:db/add "9407961c-689e-5068-b3ad-76523ffb4116" :answer-field/choices "c4817412-de6a-56be-add4-58e8d29c7bdb"] [:db/add "9407961c-689e-5068-b3ad-76523ffb4116" :answer-field/choices "ceda3090-359c-54e8-9e18-37cfe18bcc18"] [:db/add "9407961c-689e-5068-b3ad-76523ffb4116" :answer-field/correct "4de1f349-f6dc-54ee-96db-4863100a47e0"] [:db/ensure "9407961c-689e-5068-b3ad-76523ffb4116" :answer-field/validate] [:db/add "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd" :question/id #uuid "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd"] [:db/add "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{\\sqrt{25 - 9 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd" :question/worked-solution "Let $u=\\frac{3 x}{5}$. Then $\\mathrm{d}u=(\\frac{3}{5})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n\\sqrt{25 - 9 x^{2}}=5\\sqrt{1-(\\frac{3 x}{5})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{5}{3}\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{5}\\cdot \\frac{5}{3}=\\frac{4}{3}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{\\sqrt{25 - 9 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{4}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4 \\arcsin{\\left(\\frac{3 x}{5} \\right)}}{3}+C.\n$$"] [:db/add "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd" :question/difficulty :question.difficulty/hard] [:db/add "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd" :question/answer-fields "9407961c-689e-5068-b3ad-76523ffb4116"] [:db/ensure "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "6c832a4c-f85b-579d-89f2-ac66fd6bd1fd"] [:db/add "a8e4ede6-cca7-5a5b-9ec1-880b4ed53bfa" :answer/id #uuid "a8e4ede6-cca7-5a5b-9ec1-880b4ed53bfa"] [:db/add "a8e4ede6-cca7-5a5b-9ec1-880b4ed53bfa" :answer/type :answer.type/math] [:db/add "a8e4ede6-cca7-5a5b-9ec1-880b4ed53bfa" :answer/value "\\frac{\\arcsin{\\left(\\frac{3 x}{2} \\right)}}{3}+C"] [:db/ensure "a8e4ede6-cca7-5a5b-9ec1-880b4ed53bfa" :answer/validate] [:db/add "2b718ff3-3777-56a2-ad56-a936863105c1" :answer/id #uuid "2b718ff3-3777-56a2-ad56-a936863105c1"] [:db/add "2b718ff3-3777-56a2-ad56-a936863105c1" :answer/type :answer.type/math] [:db/add "2b718ff3-3777-56a2-ad56-a936863105c1" :answer/value "\\frac{3 \\arcsin{\\left(\\frac{3 x}{2} \\right)}}{4}+C"] [:db/ensure "2b718ff3-3777-56a2-ad56-a936863105c1" :answer/validate] [:db/add "71b33c4d-2ab0-5797-bbfc-e44c0271ad6b" :answer/id #uuid "71b33c4d-2ab0-5797-bbfc-e44c0271ad6b"] [:db/add "71b33c4d-2ab0-5797-bbfc-e44c0271ad6b" :answer/type :answer.type/math] [:db/add "71b33c4d-2ab0-5797-bbfc-e44c0271ad6b" :answer/value "\\frac{\\arcsin{\\left(\\frac{3 x}{2} \\right)}}{2}+C"] [:db/ensure "71b33c4d-2ab0-5797-bbfc-e44c0271ad6b" :answer/validate] [:db/add "d6ba397d-35e5-56e4-bbe6-04e4cb57121c" :answer/id #uuid "d6ba397d-35e5-56e4-bbe6-04e4cb57121c"] [:db/add "d6ba397d-35e5-56e4-bbe6-04e4cb57121c" :answer/type :answer.type/math] [:db/add "d6ba397d-35e5-56e4-bbe6-04e4cb57121c" :answer/value "\\frac{\\arcsin{\\left(\\frac{3 x}{4} \\right)}}{3}+C"] [:db/ensure "d6ba397d-35e5-56e4-bbe6-04e4cb57121c" :answer/validate] [:db/add "cb16fc10-bdca-5e4e-a6c0-7c5a1b93f903" :answer/id #uuid "cb16fc10-bdca-5e4e-a6c0-7c5a1b93f903"] [:db/add "cb16fc10-bdca-5e4e-a6c0-7c5a1b93f903" :answer/type :answer.type/math] [:db/add "cb16fc10-bdca-5e4e-a6c0-7c5a1b93f903" :answer/value "\\frac{2 \\arcsin{\\left(3 x \\right)}}{3}+C"] [:db/ensure "cb16fc10-bdca-5e4e-a6c0-7c5a1b93