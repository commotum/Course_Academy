rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{3}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{1}{3}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\arcsin{\\left(\\frac{3 x}{2} \\right)}}{3}+C.\n$$"] [:db/add "b6122a7f-8cd5-5ba1-9152-2dd731ae1ea4" :question/difficulty :question.difficulty/hard] [:db/add "b6122a7f-8cd5-5ba1-9152-2dd731ae1ea4" :question/answer-fields "49b8e845-3c19-5191-a94f-0425ba02e00f"] [:db/ensure "b6122a7f-8cd5-5ba1-9152-2dd731ae1ea4" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "b6122a7f-8cd5-5ba1-9152-2dd731ae1ea4"] [:db/add "9262c632-6c4e-5d71-9b04-9d1ba3cca4ab" :answer/id #uuid "9262c632-6c4e-5d71-9b04-9d1ba3cca4ab"] [:db/add "9262c632-6c4e-5d71-9b04-9d1ba3cca4ab" :answer/type :answer.type/math] [:db/add "9262c632-6c4e-5d71-9b04-9d1ba3cca4ab" :answer/value "2 \\arcsin{\\left(\\frac{4 x}{5} \\right)}+C"] [:db/ensure "9262c632-6c4e-5d71-9b04-9d1ba3cca4ab" :answer/validate] [:db/add "a156e746-eb49-5159-aa2d-3012b770fc72" :answer/id #uuid "a156e746-eb49-5159-aa2d-3012b770fc72"] [:db/add "a156e746-eb49-5159-aa2d-3012b770fc72" :answer/type :answer.type/math] [:db/add "a156e746-eb49-5159-aa2d-3012b770fc72" :answer/value "\\arcsin{\\left(\\frac{4 x}{5} \\right)}+C"] [:db/ensure "a156e746-eb49-5159-aa2d-3012b770fc72" :answer/validate] [:db/add "e1e8ba2f-5410-5acf-ab41-65f478ab7ba4" :answer/id #uuid "e1e8ba2f-5410-5acf-ab41-65f478ab7ba4"] [:db/add "e1e8ba2f-5410-5acf-ab41-65f478ab7ba4" :answer/type :answer.type/math] [:db/add "e1e8ba2f-5410-5acf-ab41-65f478ab7ba4" :answer/value "\\frac{8 \\arcsin{\\left(\\frac{4 x}{5} \\right)}}{25}+C"] [:db/ensure "e1e8ba2f-5410-5acf-ab41-65f478ab7ba4" :answer/validate] [:db/add "ecc72496-558b-50c6-9c34-8ca68c4aa700" :answer/id #uuid "ecc72496-558b-50c6-9c34-8ca68c4aa700"] [:db/add "ecc72496-558b-50c6-9c34-8ca68c4aa700" :answer/type :answer.type/math] [:db/add "e