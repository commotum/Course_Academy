5}$. Then $\\mathrm{d}u=(\\frac{4}{5})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n\\sqrt{25 - 16 x^{2}}=5\\sqrt{1-(\\frac{4 x}{5})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{5}{4}\\,\\mathrm{d}u$. The outside factor is $\\frac{2}{5}\\cdot \\frac{5}{4}=\\frac{1}{2}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{\\sqrt{25 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\arcsin{\\left(\\frac{4 x}{5} \\right)}}{2}+C.\n$$"] [:db/add "09b53fce-7186-54fd-8edb-2f8c949bfa41" :question/difficulty :question.difficulty/hard] [:db/add "09b53fce-7186-54fd-8edb-2f8c949bfa41" :question/answer-fields "fcb13a7c-e75b-59cf-9225-a0c4343fca3e"] [:db/ensure "09b53fce-7186-54fd-8edb-2f8c949bfa41" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "09b53fce-7186-54fd-8edb-2f8c949bfa41"] [:db/add "03d14ff4-f113-51c9-abfe-d2076a3ad44e" :answer/id #uuid "03d14ff4-f113-51c9-abfe-d2076a3ad44e"] [:db/add "03d14ff4-f113-51c9-abfe-d2076a3ad44e" :answer/type :answer.type/math] [:db/add "03d14ff4-f113-51c9-abfe-d2076a3ad44e" :answer/value "\\frac{2 \\arcsin{\\left(\\frac{3 x}{5} \\right)}}{3}+C"] [:db/ensure "03d14ff4-f113-51c9-abfe-d2076a3ad44e" :answer/validate] [:db/add "de1b480e-9354-5135-b420-6d673b75dd2e" :answer/id #uuid "de1b480e-9354-5135-b420-6d673b75dd2e"] [:db/add "de1b480e-9354-5135-b420-6d673b75dd2e" :answer/type :answer.type/math] [:db/add "de1b480e-9354-5135-b420-6d673b75dd2e" :answer/value "- \\frac{2 \\arcsin{\\left(\\frac{3 x}{5} \\right)}}{3}+C"] [:db/ensure "de1b480e-9354-5135-b420-6d673b75dd2e" :answer/validate] [:db/add "c597