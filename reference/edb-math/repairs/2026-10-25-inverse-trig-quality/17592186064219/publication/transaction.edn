}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{3}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{3}{5}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3 \\arctan{\\left(5 x \\right)}}{5}+C.\n$$"] [:db/add "e114f43b-99e3-54e7-8aeb-4f5b599e365d" :question/difficulty :question.difficulty/easy] [:db/add "e114f43b-99e3-54e7-8aeb-4f5b599e365d" :question/answer-fields "89c4d684-7278-513b-ad63-9b47ac864c86"] [:db/ensure "e114f43b-99e3-54e7-8aeb-4f5b599e365d" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "e114f43b-99e3-54e7-8aeb-4f5b599e365d"] [:db/add "3538f0db-d76c-5bd6-bc9b-f46f22b12c9a" :answer/id #uuid "3538f0db-d76c-5bd6-bc9b-f46f22b12c9a"] [:db/add "3538f0db-d76c-5bd6-bc9b-f46f22b12c9a" :answer/type :answer.type/math] [:db/add "3538f0db-d76c-5bd6-bc9b-f46f22b12c9a" :answer/value "- \\frac{2 \\arctan{\\left(3 x \\right)}}{3}+C"] [:db/ensure "3538f0db-d76c-5bd6-bc9b-f46f22b12c9a" :answer/validate] [:db/add "e2e01000-6516-58ab-8019-e94949e4eae1" :answer/id #uuid "e2e01000-6516-58ab-8019-e94949e4eae1"] [:db/add "e2e01000-6516-58ab-8019-e94949e4eae1" :answer/type :answer.type/math] [:db/add "e2e01000-6516-58ab-8019-e94949e4eae1" :answer/value "\\frac{2 \\arctan{\\left(3 x \\right)}}{3}+C"] [:db/ensure "e2e01000-6516-58ab-8019-e94949e4eae1" :answer/validate] [:db/add "6948f262-0157-5762-acbb-049552c4a6bf" :answer/id #uuid "6948f262-0157-5762-acbb-049552c4a6bf"] [:db/add "6948f262-0157-5762-acbb-049552c4a6bf" :answer/type :answer.type/math] [:db/add "6948f262-0157-5762-acbb-049552c4a6bf" :answer/value "\\frac{2 \\arctan{\\left(6 x \\right)}}{3}+C"] [:db/ensure "6948f262-0157-5762-acbb-049552c4a6bf" :answer/validate] [:db/add "10a1a90a-252f-5058-808b-10f09501e6f3" :answer/id #uuid "10a1a90a-252f-5058-808b-10f09501e6f3"] [:db/add "10a1a90a-252f-5058-808b-10f09501e6f3" :answer/type :answer.type/math] [:db/add "10a1a90a-252f-5058-808b-10f09501e6f3" :answer/value "\\frac{2 \\arctan{\