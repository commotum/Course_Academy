\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{3}{10}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{3}{10}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3 \\arctan{\\left(\\frac{5 x}{2} \\right)}}{10}+C.\n$$"] [:db/add "baf2420e-d759-52ac-97fe-a2ebcc7925cc" :question/difficulty :question.difficulty/hard] [:db/add "baf2420e-d759-52ac-97fe-a2ebcc7925cc" :question/answer-fields "7ab04f43-126d-5bab-9bd1-152eee8db5d0"] [:db/ensure "baf2420e-d759-52ac-97fe-a2ebcc7925cc" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "baf2420e-d759-52ac-97fe-a2ebcc7925cc"] [:db/add "2811fee6-38df-5d3d-827f-e13fcd4cf85e" :answer/id #uuid "2811fee6-38df-5d3d-827f-e13fcd4cf85e"] [:db/add "2811fee6-38df-5d3d-827f-e13fcd4cf85e" :answer/type :answer.type/math] [:db/add "2811fee6-38df-5d3d-827f-e13fcd4cf85e" :answer/value "\\frac{\\arctan{\\left(\\frac{5 x}{2} \\right)}}{20}+C"] [:db/ensure "2811fee6-38df-5d3d-827f-e13fcd4cf85e" :answer/validate] [:db/add "df7f6d49-2d58-55b1-a31d-6d2e213302a9" :answer/id #uuid "df7f6d49-2d58-55b1-a31d-6d2e213302a9"] [:db/add "df7f6d49-2d58-55b1-a31d-6d2e213302a9" :answer/type :answer.type/math] [:db/add "df7f6d49-2d58-55b1-a31d-6d2e213302a9" :answer/value "\\frac{\\arctan{\\left(\\frac{5 x}{4} \\right)}}{20}+C"] [:db/ensure "df7f6d49-2d58-55b1-a31d-6d2e213302a9" :answer/validate] [:db/add "bdd0330e-09b2-5a37-975d-0a0acd570e38" :answer/id #uuid "bdd0330e-09b2-5a37-975d-0a0acd570e38"] [:db/add "bdd0330e-09b2-5a37-975d-0a0acd570e38" :answer/type :answer.type/math] [:db/add "bdd0330e-09b2-5a37-975d-0a0acd570e38" :answer/value "\\frac{\\arctan{\\left(\\frac{5 x}{2} \\right)}}{10}+C"] [:db/ensure "bdd0330e-09b2-5a37-975d-0a0acd570e38" :answer/validate] [:db/add "67e54f61-4761-549e-9cf5-a94fc4569487" :answer/id #uuid "67e54f61-4761-549e-9cf5-a94fc4569487"] [:db/add "67e54f61-4761-549e-9cf5-a94fc4569487" :answer/type :answer.type/math] [:db/add 