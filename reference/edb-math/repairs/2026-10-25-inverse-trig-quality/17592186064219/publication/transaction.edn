right)}}{2}+C"] [:db/ensure "0c5035d5-7080-56ff-979b-72a02c149c9b" :answer/validate] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/id #uuid "025aa695-e52b-5bd5-906b-cc310573f44b"] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/key "answer"] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/type :answer-field.type/radio] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/choices "cb5ccc2e-346a-54f3-bfc1-e7cd603c34a7"] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/choices "13afb362-e9cb-501c-9e16-be3c503f6d08"] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/choices "23f54cd6-e96b-54cf-8ffb-bd80ab5b122b"] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/choices "ab5bb656-8a0f-527d-9d6f-948f175d56eb"] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/choices "0c5035d5-7080-56ff-979b-72a02c149c9b"] [:db/add "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/correct "cb5ccc2e-346a-54f3-bfc1-e7cd603c34a7"] [:db/ensure "025aa695-e52b-5bd5-906b-cc310573f44b" :answer-field/validate] [:db/add "281de4d8-737d-52fd-88eb-bfdc5ee854b5" :question/id #uuid "281de4d8-737d-52fd-88eb-bfdc5ee854b5"] [:db/add "281de4d8-737d-52fd-88eb-bfdc5ee854b5" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{16 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "281de4d8-737d-52fd-88eb-bfdc5ee854b5" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{4}=\\frac{3}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{16 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{3}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{3}{4}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3 \\arctan{\\left(4 x \\right)}}{4}+C.\n$$"] [:db/add "281de4d8-737d-52fd-88eb-bfdc5ee854b5" :question/difficulty :question.difficulty/easy] [:db/add "281de4d8-737d-52fd-88eb-bfdc5ee854b5" :question/answer-fields "025aa695-e52b-5bd5-906b-cc310573f44b"] [:db/ensure "281de4d8-737d-52fd-88eb-bfdc5ee854b5" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "281de4d8-737d-52fd-88eb-bfdc5ee854b5"] [:db/add "ae944cfa-97d3-5e99-a921-63853e56ad8a" :answer/id #uuid "ae944cfa-97d3-5e99-a921-63853e56ad8a"] [:db/add "ae944cfa-97d3-5e99-a921-63853e56ad8a" :answer/type :answer.type/math] [:db/add "ae944cfa-97d3-5e99-a921-63853e56ad8a" :answer/value "4 \\arctan{\\left(\\frac{x}{2} \\right)}+C"] [:db/ensure "ae944cfa-97d3-5e99-a921-63853e56ad8a" :answer/validate] [:db/add "bab6948b-1da8-5d2c-b414-6a11cf39ea91" :answer/id #uuid "bab6948b-1da8-5d2c-b414-6a11cf39ea91"] [:db/add "bab6948b-1da8-5d2c-b414-6a11cf39ea91" :answer/type :answer.type/math] [:db/add "bab6948b-1da8-5d2c-b414-6a11cf39ea91" :answer/value "4 \\arctan{\\left(x \\right)}+C"] [:db/ensure "bab6948b-1da8-5d2c-b414-6a11cf39ea91" :answer/validate] [:db/add "0f671a3a-8e44-5f06-8a99-b2c74fca5bf6" :answer/id #uuid "0f671a3a-8e44-5f06-8a99-b2c74fca5bf6"] [:db/add "0f671a3a-8e44-5f06-8a99-b2c74fca5bf6" :answer/type :answer.type/math] [:db/add "0f671a3a-8e44-5f06-8a99-b2c74fca5bf6" :answer/value "2 \\arctan{\\left(x \\right)}+C"] [:db/ensure "0f671a3a-8e44-5f06-8a99-b2c74fca5bf6" :answer/validate] [:db/add "d57a354d-392c-54a0-b47b-8e069281a968" :answer/id #uuid "d57a354d-392c-54a0-b47b-8e069281a968"] [:db/add "d57a354d-392c-54a0-b47b-8e069281a968" :answer/type :answer.type/math] [:db/add "d57a354d-392c-54a0-b47b-8e069281a968" :answer/value "2 \\arctan{\\left(\\frac{x}{2} \\right)}+C"] [:db/ensure "d57a354d-392c-54a0-b47b-8e069281a968" :