c6-9e13-0b13c4b8656c"] [:db/ensure "ba3e7d71-814a-599b-8476-63fca8cec807" :answer-field/validate] [:db/add "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b" :question/id #uuid "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b"] [:db/add "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{x^{2} + 4}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b" :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\nx^{2} + 4=4\\left(1+(\\frac{x}{2})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{4}\\cdot 2=\\frac{3}{2}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{x^{2} + 4}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{3}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{3}{2}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3 \\arctan{\\left(\\frac{x}{2} \\right)}}{2}+C.\n$$"] [:db/add "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b" :question/difficulty :question.difficulty/moderate] [:db/add "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b" :question/answer-fields "ba3e7d71-814a-599b-8476-63fca8cec807"] [:db/ensure "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "8cd43570-7c53-52ff-ad06-9ec1f1b7c18b"] [:db/add "981dec8c-c3e8-5c4a-b390-4b7544510fbf" :answer/id #uuid "981dec8c-c3e8-5c4a-b390-4b7544510fbf"] [:db/add "981dec8c-c3e8-5c4a-b390-4b7544510fbf" :answer/type :answer.type/math] [:db/add "981dec8c-c3e8-5c4a-b390-4b7544510fbf" :answer/value "\\frac{2 \\arctan{\\left(\\frac{2 x}{3} \\right)}}{3}+C"] [: