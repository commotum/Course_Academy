e4f95432" :answer-field/correct "d9f013b0-cc61-5ee5-9d1d-5baa0f81508d"] [:db/ensure "ad9d46c0-a4be-53e9-b7c3-53c1e4f95432" :answer-field/validate] [:db/add "8493b404-b397-597e-ad8a-3c8d1066a96e" :question/id #uuid "8493b404-b397-597e-ad8a-3c8d1066a96e"] [:db/add "8493b404-b397-597e-ad8a-3c8d1066a96e" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{9 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "8493b404-b397-597e-ad8a-3c8d1066a96e" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $1\\cdot \\frac{1}{3}=\\frac{1}{3}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{9 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{3}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\arctan{\\left(3 x \\right)}}{3}+C.\n$$"] [:db/add "8493b404-b397-597e-ad8a-3c8d1066a96e" :question/difficulty :question.difficulty/easy] [:db/add "8493b404-b397-597e-ad8a-3c8d1066a96e" :question/answer-fields "ad9d46c0-a4be-53e9-b7c3-53c1e4f95432"] [:db/ensure "8493b404-b397-597e-ad8a-3c8d1066a96e" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "8493b404-b397-597e-ad8a-3c8d1066a96e"] [:db/add "9c656965-a450-517c-bf8d-580baad1dc03" :answer/id #uuid "9c656965-a450-517c-bf8d-580baad1dc03"] [:db/add "9c656965-a450-517c-bf8d-580baad1dc03" :answer/type :answer.type/math] [:db/add "9c656965-a450-517c-bf8d-580baad1dc03" :answer/value "8 \\arctan{\\left(2 x \\right)}+C"] [:db/ensure "9c656965-a450-517c-bf8d-580baad1dc03" :answer/validate] [:db/add "caf