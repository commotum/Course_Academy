4363b226d9e"] [:db/add "ce89b6d6-2c57-5c70-94bd-ced14745a19e" :answer-field/choices "01e102be-5d36-588c-8c93-88e2285a2ad5"] [:db/add "ce89b6d6-2c57-5c70-94bd-ced14745a19e" :answer-field/choices "22e38109-d2c8-533b-994d-b56186b43a77"] [:db/add "ce89b6d6-2c57-5c70-94bd-ced14745a19e" :answer-field/correct "caf626d8-38ca-505b-a6c1-539e8506bb8a"] [:db/ensure "ce89b6d6-2c57-5c70-94bd-ced14745a19e" :answer-field/validate] [:db/add "15664049-5a30-5d18-a34b-b09f9e4c887f" :question/id #uuid "15664049-5a30-5d18-a34b-b09f9e4c887f"] [:db/add "15664049-5a30-5d18-a34b-b09f9e4c887f" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{8}{8 x^{2} + 2}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "15664049-5a30-5d18-a34b-b09f9e4c887f" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n8 x^{2} + 2=2\\left(1+(2 x)^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{2}=2$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{8}{8 x^{2} + 2}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n2\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=2\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2 \\arctan{\\left(2 x \\right)}+C.\n$$"] [:db/add "15664049-5a30-5d18-a34b-b09f9e4c887f" :question/difficulty :question.difficulty/easy] [:db/add "15664049-5a30-5d18-a34b-b09f9e4c887f" :question/answer-fields "ce89b6d6-2c57-5c70-94bd-ced14745a19e"] [:db/ensure "15664049-5a30-5d18-a34b-b09f9e4c887f" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "15664049-5a30-5d18-a34b-b09f9e4c887f"] [:db/add "fdd1f146-c7bb-519f-879c-b6f7593a770c" :answer/id #uuid "fdd1f146-c7bb-519f-879c-b6f7593a770c"] [:db/add "fdd1f146-c7bb-519f-879c-b6f7593a770c" :answer/type :answer.type/math] [:db/add "fdd1f146-c7bb-519f-879c-b6f7593a770c" :answer/value "\\frac{2 \\arctan{\\left(5 x \\right)}}{5}+C"] [:db/ensure "fdd1f146-c7bb-519f-879c-b6f7593a770c" :answer/validate] [:db/add "73d3997c-d07e-5c2d-9f54-a5f408011df2" :answer/id #uuid "73d3997c-d07e-5c2d-9f54-a5f408011df2"] [:db/add "73d3997c-d07e-5c2d-9f54-a5f408011df2" :answer/type :answer.type/math] [:db/add "73d3997c-d07e-5c2d-9f54-a5f408011df2" :answer/value "\\frac{4 \\arctan{\\left(5 x \\right)}}{5}+C"] [:db/ensure "73d3997c-d07e-5c2d-9f54-a5f408011df2" :answer/validate] [:db/add "d7923cc6-fe56-542b-8386-23f846f0bfef" :answer/id #uuid "d7923cc6-fe56-542b-8386-23f846f0bfef"] [:db/add "d7923cc6-fe56-542b-8386-23f846f0bfef" :answer/type :answer.type/math] [:db/add "d7923cc6-fe56-542b-8386-23f846f0bfef" :answer/value "\\frac{2 \\arctan{\\left(\\frac{5 x}{2} \\right)}}{5}+C"] [:db/ensure "d7923cc6-fe56-542b-8386-23f846f0bfef" :answer/validate] [:db/add "09170197-c2c3-57a1-8f01-1bb866a40252" :answer/id #uuid "09170197-c2c3-57a1-8f01-1bb866a40252"] [:db/add "09170197-c2c3-57a1-8f01-1bb866a40252" :answer/type :answer.type/math] [:db/add "09170197-c2c3-57a1-8f01-1bb866a40252" :answer/value "\\frac{4 \\arctan{\\left(10 x \\right)}}{5}+C"] [:db/ensure "09170197-c2c3-57a1-8f01-1bb866a40252" :answer/validate] [:db/add "ea11ec44-bef4-54b8-8656-a262885c0c4b" :answer/id #uuid "ea11ec44-bef4-54b8-8656-a262885c0c4b"] [:db/add "ea11ec44-bef4-54b8-8656-a262885c0c4b" :answer/type :answer.type/math] [:db/add "ea11ec44-bef4-54b8-8656-a262885c0c4b" :answer/value "\\frac{\\arctan{\\left(\\frac{x}{5} \\right)}}{5}+C"] [:db/ensure "ea11ec44-bef4-54b8-8656-a262885c0c4b" :answer/validate] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/id #uuid "64cfec14-05b6-58a4-a1ce-970e265ada95"] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/key "answer"] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/type :answer-field.type/radio] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/choices "fdd1f146-c7bb-519f-879c-b6f7593a770c"] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/choices "73d3997c-d07e-5c2d-9f54-a5f408011df2"] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/choices "d7923cc6-fe56-542b-8386-23f846f0bfef"] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/choices "09170197-c2c3-57a1-8f01-1bb866a40252"] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/choices "ea11ec44-bef4-54b8-8656-a262885c0c4b"] [:db/add "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/correct "fdd1f146-c7bb-519f-879c-b6f7593a770c"] [:db/ensure "64cfec14-05b6-58a4-a1ce-970e265ada95" :answer-field/validate] [:db/add "5302d11c-48b7-5538-b022-7413e48bf00a" :question/id #uuid "5302d11c-48b7-5538-b022-7413e48bf00a"] [:db/add "5302d11c-48b7-5538-b022-7413e48bf00a" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "5302d11c-48b7-5538-b022-7413e48bf00a" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{5}=\\frac{2}{5}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{25 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{2}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{2}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{2}{5}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2 \\arctan{\\left(5 x \\right)}}{5}+C.\n$$"] [:db/add "5302d11c-48b7-5538-b022-7413e48bf00a" :question/difficulty :question.difficulty/ea