37f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/id #uuid "95437f4a-a7d2-5799-ba81-e8a6c4c235ba"] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/key "answer"] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/type :answer-field.type/radio] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/choices "b7358f81-4f20-54fb-8bc0-21efcb0256aa"] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/choices "2dc741dd-13ae-56ea-898f-4f6c9a85d4d4"] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/choices "578543b4-f4ce-5151-b7ba-35333a34cb4c"] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/choices "0fe53b81-3ea9-56d8-a8bf-c94c584b48b4"] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/choices "324f95d5-eac4-562e-80b3-7ea566126703"] [:db/add "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/correct "2dc741dd-13ae-56ea-898f-4f6c9a85d4d4"] [:db/ensure "95437f4a-a7d2-5799-ba81-e8a6c4c235ba" :answer-field/validate] [:db/add "de3afc7b-6342-5c89-b7b3-754c8842d886" :question/id #uuid "de3afc7b-6342-5c89-b7b3-754c8842d886"] [:db/add "de3afc7b-6342-5c89-b7b3-754c8842d886" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "de3afc7b-6342-5c89-b7b3-754c8842d886" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{8}\\cdot 4=\\frac{1}{2}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\arctan{\\left(\\frac{x}{4} \\right)}}{2}+C.\n$$"] [:db/add "de3afc7b-6342-5c89-b7b3-754c8842d886" :question/difficulty :question.difficulty/moderate] [:db/add "de3afc7b-6342-5c89-b7b3-754c8842d886" :question/answer-fields "95437f4a-a7d2-5799-ba81-e8a6c4c235ba"] [:db/ensure "de3afc7b-6342-5c89-b7b3-754c8842d886" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "de3afc7b-6342-5c89-b7b3-754c8842d886"] [:db/add "78895b18-b0e0-5f95-8a9f-5906aedfeb9b" :answer/id #uuid "78895b18-b0e0-5f95-8a9f-5906aedfeb9b"] [:db/add "78895b18-b0e0-5f95-8a9f-5906aedfeb9b" :answer/type :answer.type/math] [:db/add "78895b18-b0e0-5f95-8a9f-5906aedfeb9b" :answer/value "\\frac{\\arctan{\\left(\\frac{x}{2} \\right)}}{2}+C"] [:db/ensure "78895b18-b0e0-5f95-8a9f-5906aedfeb9b" :answer/validate] [:db/add "34669325-72a9-55c2-a60b-1bab25d3c3bc" :answer/id #uuid "34669325-72a9-55c2-a60b-1bab25d3c3bc"] [:db/add "34669325-72a9-55c2-a60b-1bab25d3c3bc" :answer/type :answer.type/math] [:db/add "34669325-72a9-55c2-a60b-1bab25d3c3bc" :answer/value "\\frac{\\arctan{\\left(\\frac{x}{4} \\right)}}{2}+C"] [:db/ensure "34669325-72a9-55c2-a60b-1bab25d3c3bc" :answer/validate] [:db/add "80cf0563-4aef-5be0-854e-eaa56fd79add" :answer/id #uuid "80cf0563-4aef-5be0-854e-eaa56fd79add"] [:db/add "80cf0563-4aef-5be0-854e-eaa56fd79add" :answer/type :answer.type/math] [:db/add "80cf0563-4aef-5be0-854e-eaa56fd79add" :answer/value "\\frac{\\arctan{\\left(2 x \\right)}}{2}+C"] [:db/ensure "80cf0563-4aef-5be0-854e-eaa56fd79add" :answer/validate] [:db/add "9ea2934f-4944-58a1-b578-5639f0236b00" :answer/id #uuid "9ea2934f-4944-58a1-b578-5639f0236b00"] [:db/add "9ea2934f-4944-58a1-b578-5639f0236b00" :answer/type :answer.type/math] [:db/add "9ea2934f-4944-58a1-b578-5639f0236b00" :answer/value "- \\arctan{\\left(\\frac{x}{2} \\right)}+C"] [:db/