2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{6}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{6}\\left(\\arctan{\\left(\\frac{2 x}{3} \\right)}\\right)+C.\n$$"] [:db/add "deff6d65-8112-5b95-a6ff-9646caad51ac" :question/difficulty :question.difficulty/hard] [:db/add "deff6d65-8112-5b95-a6ff-9646caad51ac" :question/answer-fields "785ed284-86a5-596d-a82c-36093cb94aa1"] [:db/ensure "deff6d65-8112-5b95-a6ff-9646caad51ac" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "deff6d65-8112-5b95-a6ff-9646caad51ac"] [:db/add "generator" :question-generator/id #uuid "1daf5c0f-7f98-5299-a7f0-ee3b7868abf7"] [:db/add "generator" :question-generator/script "generators/f4/f45330804566875aebedd9162ec99378f985cd81f3184cd13f6fb04b0cc5cef3/generator.py"] [:db/add 17592186064219 :knowledge-point/question-generator "generator"] [:db/ensure 17592186064219 :knowledge-point/validate] [:db/cas 17592186679893 :question/retired nil true] [:db/cas 17592186679896 :question/retired nil true] [:db/cas 17592186679904 :question/retired nil true] [:db/cas 17592186679908 :question/retired nil true] [:db/cas 17592186679927 :question/retired nil true] [:db/cas 17592186679930 :question/retired nil true] [:db/cas 17592186679933 :question/retired nil true] [:db/cas 17592186679941 :question/retired nil true] [:db/cas 17592186679948 :question/retired nil true] [:db/cas 17592186679960 :question/retired nil true] [:db/cas 17592186679981 :question/retired nil true] [:db/cas 17592186679986 :question/retired nil true] [:db/cas 17592186679988 :question/retired nil true] [:db/cas 17592186680008 :question/retired nil true] [:db/cas 17592186680034 :question/retired nil true] [:db/cas 17592186680049 :question/retired nil true]]
