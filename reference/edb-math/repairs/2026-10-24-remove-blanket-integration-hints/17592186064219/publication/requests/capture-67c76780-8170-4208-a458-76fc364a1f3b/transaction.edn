dd "66bcebd1-596c-5794-a036-d1136d473062" :answer-field/choices "b2dd9e0d-b693-574e-90f2-9e533a86e9f1"] [:db/add "66bcebd1-596c-5794-a036-d1136d473062" :answer-field/choices "6e4d58b0-4239-52fa-9c16-7c50b3af235f"] [:db/add "66bcebd1-596c-5794-a036-d1136d473062" :answer-field/choices "0df5c099-d024-592c-9440-7598fa8d7d07"] [:db/add "66bcebd1-596c-5794-a036-d1136d473062" :answer-field/choices "5996abf7-3f2e-55ac-a363-c9ec97c766da"] [:db/add "66bcebd1-596c-5794-a036-d1136d473062" :answer-field/correct "d4e4c3ee-ca1c-5b3c-b345-772e9140b95e"] [:db/ensure "66bcebd1-596c-5794-a036-d1136d473062" :answer-field/validate] [:db/add "cb147313-6321-57c2-9e41-a59bfa74b9a7" :question/id #uuid "cb147313-6321-57c2-9e41-a59bfa74b9a7"] [:db/add "cb147313-6321-57c2-9e41-a59bfa74b9a7" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{x^{2} + 9}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "cb147313-6321-57c2-9e41-a59bfa74b9a7" :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 9=9\\left(1+(\\frac{x}{3})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{9}\\cdot 3=\\frac{4}{3}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{x^{2} + 9}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{4}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(\\arctan{\\left(\\frac{x}{3} \\right)}\\right)+C.\n$$"] [:db/add "cb147313-6321-57c2-9e41-a59bfa74b9a7" :question/difficulty :question.difficulty/moderate] [:db/add "cb147313-6321-57c2-9e41-a59bfa74b9a7" :question/answer-fields "66bcebd1-596c-5794-a036-d1136d473062"] [:db/ensure "cb147313-6321-57c2-9e41-a59bfa74b9a7" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "cb147313-6321-57c2-9e41-a59bfa74b9a7"] [:db/add "cd3b88ca-35cd-5ee9-aff4-9b27934790cc" :answer/id #uuid "cd3b88ca-35cd-5ee9-aff4-9b27934790cc"] [:db/add "cd3b88ca-35cd-5ee9-aff4-9b27934790cc" :answer/type :answer.type/math] [:db/add "cd3b88ca-35cd-5ee9-aff4-9b27934790cc" :answer/value "\\arctan{\\left(x \\right)}+C"] [:db/ensure "cd3b88ca-35cd-5ee9-aff4-9b27934790cc" :answer/validate] [:db/add "3b60cc0c-6878-5ea6-ba41-708d2bba161f" :answer/id #uuid "3b60cc0c-6878-5ea6-ba41-708d2bba161f"] [:db/add "3b60cc0c-6878-5ea6-ba41-708d2bba161f" :answer/type :answer.type/math] [:db/add "3b60cc0c-6878-5ea6-ba41-708d2bba161f" :answer/value "2\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "3b60cc0c-6878-5ea6-ba41-708d2bba161f" :answer/validate] [:db/add "0bdd48bf-d920-5785-8a8f-4ff1c0b2fb83" :answer/id #uuid "0bdd48bf-d920-5785-8a8f-4ff1c0b2fb83"] [:db/add "0bdd48bf-d920-5785-8a8f-4ff1c0b2fb83" :answer/type :answer.type/math] [:db/add "0bdd48bf-d920-5785-8a8f-4ff1c0b2fb83" :answer/value "\\arctan{\\left(\\frac{x}{4} \\right)}+C"] [:db/ensure "0bdd48bf-d920-5785-8a8f-4ff1c0b2fb83" :answer/validate] [:db/add "cd944a54-e1f3-5c8c-96dc-10a078f3a25e" :answer/id #uuid "cd944a54-e1f3-5c8c-96dc-10a078f3a25e"] [:db/add "cd944a54-e1f3-5c8c-96dc-10a078f3a25e" :answer/type :answer.type/math] [:db/add "cd944a54-e1f3-5c8c-96dc-10a078f3a25e" :answer/value "-1\\left(\\arctan{\\left(\\frac{x}{4} \\right)}\\right)+C"] [:db/ensure "cd944a54-e1f3-5c8c-96dc-10a078f3a25e" :answer/validate] [:db/add "cacda34b-efac-52f5-a2f0-d7612aede871" :answer/id #uuid "cacda34b-efac-52f5-a2f0-d7612aede871"] [:db/add "cacda34b-efac-52f5-a2f0-d7612aede871" :answer/type :answer.type/math] [:db/add "cacda34b-efac-52f5-a2f0-d7612aede871" :answer/value "\\arctan{\\left(\\frac{x}{8} \\right)}+C"] [:db/ensure "cacda34b-efac-52f5-a2f0-d7612aede871" :answer/validate] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/id #uuid "64bcc320-111f-5734-b50a-88861d3e3101"] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/key "answer"] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/type :answer-field.type/radio] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/choices "cd3b88ca-35cd-5ee9-aff4-9b27934790cc"] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/choices "3b60cc0c-6878-5ea6-ba41-708d2bba161f"] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/choices "0bdd48bf-d920-5785-8a8f-4ff1c0b2fb83"] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/choices "cd944a54-e1f3-5c8c-96dc-10a078f3a25e"] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/choices "cacda34b-efac-52f5-a2f0-d7612aede871"] [:db/add "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/correct "0bdd48bf-d920-5785-8a8f-4ff1c0b2fb83"] [:db/ensure "64bcc320-111f-5734-b50a-88861d3e3101" :answer-field/validate] [:db/add "795d7acd-3ce5-58cf-a7d2-51050e733863" :question/id #uuid "795d7acd-3ce5-58cf-a7d2-51050e733863"] [:db/add "795d7acd-3ce5-58cf-a7d2-51050e733863" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "795d7acd-3ce5-58cf-a7d2-51050e733863" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{4}\\cdot 4=1$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\arctan{\\left(\\frac{x}{4} \\right)}+C.\n$$"] [:db/add "795d7acd-3ce5-58cf-a7d2-51050e733863" :question/difficulty :question.difficulty/moderate] [:db/add "795d7acd-3ce5-58cf-a7d2-51050e733863" :question/answer-fields "64bcc320-111f-5734-b50a-88861d3e3101"] [:db/ensure "795d7acd-3ce5-58cf-a7d2-51050e733863" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "795d7acd-3ce5-58cf-a7d2-51050e733863"] [:db/add "b3612471-812e-5d5c-b0a3-2da33e50b0dd" :answer/id #uuid "b3612471-812e-5d5c-b0a3-2da33e50b0dd"] [:db/add "b3612471-812e-5d5c-b0a3-2da33e50b0dd" :answer/type :answer.type/math] [:db/add "b3612471-812e-5d5c-b0a3-2da33e50b0dd" :answer/value "\\arctan{\\left(x \\right)}+C"] [:db/ensure "b3612471-812e-5d5c-b0a3-2da33e50b0dd" :answer/validate] [:db/add "7083a527-803e-534b-9455-61aac1bd89de" :answer/id #uuid "7083a527-803e-534b-9455-61aac1bd89de"] [:db/add "7083a527-803e-534b-9455-61aac1bd89de" :answer/type :answer.type/math] [:db/add "7083a527-803e-534b-9455-61aac1bd89de" :answer/value "-2\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "7083a527-803e-534b-9455-61aac1bd89de" :answer/validate] [:db/add "b7dc39d6-3e65-5327-8858-adbbe4092820" :answer/id #uuid "b7dc39d6-3e65-5327-8858-adbbe4092820"] [:db/add "b7dc39d6-3e65-5327-8858-adbbe4092820" :answer/type :answer.type/math] [:db/add "b7dc39d6-3e65-5327-8858-adbbe4092820" :answer/value "2\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "b7dc39d6-3e65-5327-8858-adbbe4092820" :answer/validate] [:db/add "d05d6d98-aba8-557d-8b7d-fd6b6ad6a42e" :answer/id #uuid "d05d6d98-aba8-557d-8b7d-fd6b6ad6a42e"] [:db/add "d05d6d98-aba8-557d-8b7d-fd6b6ad6a42e" :answer/type :answer.type/math] [:db/add "d05d6d98-aba8-557d-8b7d-fd6b6ad6a42e" :answer/value "2\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "d05d6d