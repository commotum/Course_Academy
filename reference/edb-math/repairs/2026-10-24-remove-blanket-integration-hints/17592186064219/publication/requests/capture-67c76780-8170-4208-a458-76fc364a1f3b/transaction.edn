m{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{2}\\left(\\arctan{\\left(2 x \\right)}\\right)+C.\n$$"] [:db/add "041f7d22-d8a1-5d07-866f-37bc0cf86bac" :question/difficulty :question.difficulty/hard] [:db/add "041f7d22-d8a1-5d07-866f-37bc0cf86bac" :question/answer-fields "ff14bc6b-1ab5-5b86-9b55-2d4116b5d3e0"] [:db/ensure "041f7d22-d8a1-5d07-866f-37bc0cf86bac" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "041f7d22-d8a1-5d07-866f-37bc0cf86bac"] [:db/add "bf5bb5be-bdeb-53b1-9b84-bf02fb5a3c62" :answer/id #uuid "bf5bb5be-bdeb-53b1-9b84-bf02fb5a3c62"] [:db/add "bf5bb5be-bdeb-53b1-9b84-bf02fb5a3c62" :answer/type :answer.type/math] [:db/add "bf5bb5be-bdeb-53b1-9b84-bf02fb5a3c62" :answer/value "\\frac{1}{8}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "bf5bb5be-bdeb-53b1-9b84-bf02fb5a3c62" :answer/validate] [:db/add "c6a8f6b0-6ad2-5f13-853a-a2b0f297a86f" :answer/id #uuid "c6a8f6b0-6ad2-5f13-853a-a2b0f297a86f"] [:db/add "c6a8f6b0-6ad2-5f13-853a-a2b0f297a86f" :answer/type :answer.type/math] [:db/add "c6a8f6b0-6ad2-5f13-853a-a2b0f297a86f" :answer/value "\\frac{1}{2}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "c6a8f6b0-6ad2-5f13-853a-a2b0f297a86f" :answer/validate] [:db/add "8db26514-6942-524f-9040-4048aa6e0e3b" :answer/id #uuid "8db26514-6942-524f-9040-4048aa6e0e3b"] [:db/add "8db26514-6942-524f-9040-4048aa6e0e3b" :answer/type :answer.type/math] [:db/add "8db26514-6942-524f-9040-4048aa6e0e3b" :answer/value "\\frac{1}{4}\\left(\\arctan{\\left(\\frac{4 x}{3} \\right)}\\right)+C"] [:db/ensure "8db26514-6942-524f-9040-4048aa6e0e3b" :answer/validate] [:db/add "90410b17-cec3-54df-aded-c5af72adfaeb" :answer/id #uuid "90410b17-cec3-54df-aded-c5af72adfaeb"] [:db/add "90410b17-cec3-54df-aded-c5af72adfaeb" :answer/type :answer.type/math] [:db/a