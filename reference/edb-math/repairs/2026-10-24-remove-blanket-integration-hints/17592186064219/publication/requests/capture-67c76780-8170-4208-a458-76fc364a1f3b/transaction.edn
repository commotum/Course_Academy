id #uuid "4a133085-8cb4-5e4d-a722-a6dc905a076a"] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/key "answer"] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/type :answer-field.type/radio] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/choices "ad3595dc-7c17-5c23-bb3a-e0e82f8f5cfd"] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/choices "e212e603-f415-5ff0-b3ed-69da0f8284e1"] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/choices "76b1973a-03e2-5aed-8e0c-665d41274140"] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/choices "6808394e-857e-5349-8164-ddd94ff04f4c"] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/choices "864d62ef-a5ac-527b-b005-85ceafa7695f"] [:db/add "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/correct "ad3595dc-7c17-5c23-bb3a-e0e82f8f5cfd"] [:db/ensure "4a133085-8cb4-5e4d-a722-a6dc905a076a" :answer-field/validate] [:db/add "7d626c28-b73d-53d4-a3bf-5c54b8c980e1" :question/id #uuid "7d626c28-b73d-53d4-a3bf-5c54b8c980e1"] [:db/add "7d626c28-b73d-53d4-a3bf-5c54b8c980e1" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "7d626c28-b73d-53d4-a3bf-5c54b8c980e1" :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{16}\\cdot 4=\\frac{1}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\arctan{\\left(\\frac{x}{4} \\right)}\\right)+C.\n$$"] [:db/add "7d626c28-b73d-53d4-a3bf-5c54b8c980e1" :question/difficulty :question.difficulty/moderate] [:db/add "7d626c28-b73d-53d4-a3bf-5c54b8c980e1" :question/answer-fields "4a133085-8cb4-5e4d-a722-a6dc905a076a"] [:db/ensure "7d626c28-b73d-53d4-a3bf-5c54b8c980e1" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "7d626c28-b73d-53d4-a3bf-5c54b8c980e1"] [:db/add "9a831c8a-c3a0-5828-bcf8-9ef3cdd075b1" :answer/id #uuid "9a831c8a-c3a0-5828-bcf8-9ef3cdd075b1"] [:db/add "9a831c8a-c3a0-5828-bcf8-9ef3cdd075b1" :answer/type :answer.type/math] [:db/add "9a831c8a-c3a0-5828-bcf8-9ef3cdd075b1" :answer/value "\\frac{4}{5}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "9a831c8a-c3a0-5828-bcf8-9ef3cdd075b1" :answer/validate] [:db/add "b29d3634-66b8-50bb-ad32-18466174fbbe" :answer/id #uuid "b29d3634-66b8-50bb-ad32-18466174fbbe"] [:db/add "b29d3634-66b8-50bb-ad32-18466174fbbe" :answer/type :answer.type/math] [:db/add "b29d3634-66b8-50bb-ad32-18466174fbbe" :answer/value "\\frac{8}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C"] [:db/ensure "b29d3634-66b8-50bb-ad32-18466174fbbe" :answer/validate] [:db/add "69891e05-07e1-518a-923a-cc87325147cb" :answer/id #uuid "69891e05-07e1-518a-923a-cc87325147cb"] [:db/add "69891e05-07e1-518a-923a-cc87325147cb" :answer/type :answer.type/math] [:db/add "69891e05-07e1-518a-923a-cc87325147cb" :answer/value "\\frac{4}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C"] [:db/ensure "69891e05-07e1-518a-923a-cc87325147cb" :answer/validate] [:db/add "9b8ebd34-531d-53f8-883f-3d6fffede3cc" :answer/id #uuid "9b8ebd34-531d-53f8-883f-3d6fffede3cc"] [:db/add "9b8ebd34-531d-53f8-883f-3d6fffede3cc" :answer/type :answer.type/math] [:db/add "9b8ebd34-531d-53f8-883f-3d6fffede3cc" :answer/value "\\frac{8}{5}\\left(\\arctan{\\left(\\frac{2 x}{5} \\right)}\\right)+C"] [:db/ensure "9b8ebd34-531d-53f8-883f-3d6fffede3cc" :answer/validate] [:db/add "2388702c-c709-5e71-b319-65f7c6725905" :answer/id #uuid "2388702c-c709-5e71-b319-65f7c6725905"] [:db/add "2388702c-c709-5e71-b319-65f7c6725905" :answer/type :answer.type/math] [:db/add "2388702c-c709-5e71-b319-65f7c6725905" :answer/value "\\frac{4}{5}\\left(\\arctan{\\left(\\frac{x}{10} \\right)}\\right)+C"] [:db/ensure "2388702c-c709-5e71-b319-65f7c6725905" :answer/validate] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/id #uuid "db45237c-e5c8-5a90-a84d-081bbfe6682c"] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/key "answer"] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/type :answer-field.type/radio] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/choices "9a831c8a-c3a0-5828-bcf8-9ef3cdd075b1"] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/choices "b29d3634-66b8-50bb-ad32-18466174fbbe"] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/choices "69891e05-07e1-518a-923a-cc87325147cb"] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/choices "9b8ebd34-531d-53f8-883f-3d6fffede3cc"] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/choices "2388702c-c709-5e71-b319-65f7c6725905"] [:db/add "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/correct "69891e05-07e1-518a-923a-cc87325147cb"] [:db/ensure "db45237c-e5c8-5a90-a84d-081bbfe6682c" :answer-field/validate] [:db/add "9fac851b-355b-5020-8f36-949a9a05aba7" :question/id #uuid "9fac851b-355b-5020-8f36-949a9a05aba7"] [:db/add "9fac851b-355b-5020-8f36-949a9a05aba7" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{x^{2} + 25}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "9fac851b-355b-5020-8f36-949a9a05aba7" :question/worked-solution "Let $u=\\frac{x}{5}$. Then $\\mathrm{d}u=(\\frac{1}{5})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 25=25\\left(1+(\\frac{x}{5})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=5\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{25}\\cdot 5=\\frac{4}{5}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{x^{2} + 25}\\,\\mathrm{d}x\\\\&=\\frac{4}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{4}{5}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{4}{5}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{5}\\left(\\arctan{\\left(\\frac{x}{5} \\right)}\\right)+C.\n$$"] [:db/add "9fac851b-355b-5020-8f36-949a9a05aba7" :question/difficulty :question.difficulty/moderate] [:db/add "9fac851b-355b-5020-8f36-949a9a05aba7" :question/answer-fields "db45237c-e5c8-5a90-a84d-081bbfe6682c"] [:db/ensure "9fac851b-355b-5020-8f36-949a9a05aba7" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "9fac851b-355b-5020-8f36-949a9a05aba7"] [:db/add "dfd71781-3aea-548a-a066-1db8196a4e93" :answer/id #uuid "dfd71781-3aea-548a-a066-1db8196a4e93"] [:db/add "dfd71781-3aea-548a-a066-1db8196a4e93" :answer/type :answer.type/math] [:db/add "dfd71781-3aea-548a-a066-1db8196a4e93" :answer/value "\\frac{3}{2}\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "dfd71781-3aea-548a-a066-1db8196a4e93" :answer/validate] [:db/add "21343440-38fa-54ad-b278-e8aa58dc4c0a" :answer/id #uuid "21343440-38fa-54ad-b278-e8aa58dc4c0a"] [:db/add "21343440-38fa-54ad-b278-e8aa58dc4c0a" :answer/type :answer.type/math] [:db/add "21343440-38fa-54ad-b278-e8aa58dc4c0a" :answer/value "\\frac{3}{2}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "21343440-38fa-54ad-b278-e8aa58dc4c0a" :answer/validate] [:db/add "dbeb02c4-3082-575e-8429-fe6b148437da" :answer/id #uuid "dbeb02c4-3082-575e-8429-