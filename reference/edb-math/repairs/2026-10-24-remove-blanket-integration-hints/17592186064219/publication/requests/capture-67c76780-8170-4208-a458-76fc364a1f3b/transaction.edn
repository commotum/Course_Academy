8-e4a5-5efb-9c09-224f560f30a2" :answer-field/type :answer-field.type/radio] [:db/add "5dbd93c8-e4a5-5efb-9c09-224f560f30a2" :answer-field/choices "fe1180dc-4920-51d6-9670-31158d24fc43"] [:db/add "5dbd93c8-e4a5-5efb-9c09-224f560f30a2" :answer-field/choices "24601395-e4e4-59b1-abf0-cfaf01dd7ea2"] [:db/add "5dbd93c8-e4a5-5efb-9c09-224f560f30a2" :answer-field/choices "2f42d6d6-d2be-515f-ac77-c101214b636b"] [:db/add "5dbd93c8-e4a5-5efb-9c09-224f560f30a2" :answer-field/choices "ec1237d2-3423-536d-a6fa-c64637028cc9"] [:db/add "5dbd93c8-e4a5-5efb-9c09-224f560f30a2" :answer-field/choices "350131d3-cb87-5a0f-9040-431d757679bd"] [:db/add "5dbd93c8-e4a5-5efb-9c09-224f560f30a2" :answer-field/correct "fe1180dc-4920-51d6-9670-31158d24fc43"] [:db/ensure "5dbd93c8-e4a5-5efb-9c09-224f560f30a2" :answer-field/validate] [:db/add "1319d74d-edf9-57c5-a8c2-0e37322fa344" :question/id #uuid "1319d74d-edf9-57c5-a8c2-0e37322fa344"] [:db/add "1319d74d-edf9-57c5-a8c2-0e37322fa344" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{9 x^{2} + 4}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "1319d74d-edf9-57c5-a8c2-0e37322fa344" :question/worked-solution "Let $u=\\frac{3 x}{2}$. Then $\\mathrm{d}u=(\\frac{3}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n9 x^{2} + 4=4\\left(1+(\\frac{3 x}{2})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{2}{3}\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{4}\\cdot \\frac{2}{3}=\\frac{1}{6}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{9 x^{2} + 4}\\,\\mathrm{d}x\\\\&=\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{6}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C.\n$$"] [:db/add "1319d74d-edf9-57c5-a8c2-0e37322fa344" :question/difficulty :question.difficulty/hard] [:db/add "1319d74d-edf9-57c5-a8c2-0e37322fa344" :question/answer-fields "5dbd93c8-e4a5-5efb-9c09-224f560f30a2"] [:db/ensure "1319d74d-edf9-57c5-a8c2-0e37322fa344" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "1319d74d-edf9-57c5-a8c2-0e37322fa344"] [:db/add "b10b49fd-9280-58e6-abc0-7c2a7bd0f052" :answer/id #uuid "b10b49fd-9280-58e6-abc0-7c2a7bd0f052"] [:db/add "b10b49fd-9280-58e6-abc0-7c2a7bd0f052" :answer/type :answer.type/math] [:db/add "b10b49fd-9280-58e6-abc0-7c2a7bd0f052" :answer/value "- \\frac{1}{8}\\left(\\arctan{\\left(2 x \\right)}\\right)+C"] [:db/ensure "b10b49fd-9280-58e6-abc0-7c2a7bd0f052" :answer/validate] [:db/add "19cda1cf-e499-53fe-9541-27bf16e2d876" :answer/id #uuid "19cda1cf-e499-53fe-9541-27bf16e2d876"] [:db/add "19cda1cf-e499-53fe-9541-27bf16e2d876" :answer/type :answer.type/math] [:db/add "19cda1cf-e499-53fe-9541-27bf16e2d876" :answer/value "\\frac{1}{8}\\left(\\arctan{\\left(2 x \\right)}\\right)+C"] [:db/ensure "19cda1cf-e499-53fe-9541-27bf16e2d876" :answer/validate] [:db/add "0088877d-78ba-576c-b05f-303f04cd7725" :answer/id #uuid "0088877d-78ba-576c-b05f-303f04cd7725"] [:db/add "0088877d-78ba-576c-b05f-303f04cd7725" :answer/type :answer.type/math] [:db/add "0088877d-78ba-576c-b05f-303f04cd7725" :answer/value "- \\frac{1}{8}\\left(\\arctan{\\left(x \\right)}\\right)+C"] [:db/ensure "0088877d-78ba-576c-b05f-303f04cd7725" :answer/validate] [:db/add "24de903b-b8ad-521b-a836-2a65c05fcdcc" :answer/id #uuid "24de903b-b8ad-521b-a836-2a65c05fcdcc"] [:db/add "24de903b-b8ad-521b-a836-2a65c05fcdcc" :answer/type :answer.type/math] [:db/add "24de903b-b8ad-521b-a836-2a65c05fcdcc" :answer/value "\\frac{1}{16}\\left(\\arctan{\\left(4 x \\right)}\\right)+C"] [:db/ensure "24de903b-b8ad-521b-a836-2a65c05fcdcc" :answer/validate] [:db/add "b9bb0213-2e0c