#{[{:db/id #edb/ref 17592186050101 :topic/difficulty 1.7766990018568227 :topic/id #uuid "2d31fc2e-19fe-50d4-bccf-d60b3f5db5c4" :topic/knowledge-points [{:db/id #edb/ref 17592186096655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096454 :question/id #uuid "9a42787b-24fb-50c8-9f3f-9e95d35c403c" :question/math-academy-id "e-459" :question/problem "Calculate  $$\n\\displaystyle{\\int e^{1-3x}\\, \\textrm{d}x }.\n$$" :question/worked-solution "If we let $u=1-3x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3\\quad\\Longrightarrow\\quad \\textrm d x = -\\dfrac 1 3 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{1-3x}\\,\\text{d}x & =\\int {e}^{u}\\cdot \\left(-\\frac{1}{3}\\right)\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}{e}^{u}+C \\\\  & =-\\frac{1}{3}{e}^{1-3x}+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"} {:db/id #edb/ref 17592186096656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096455 :question/id #uuid "cbf09123-3650-5d6a-869a-8edd8f54206b" :question/math-academy-id "e-460" :question/problem "Calculate  $$\n\\displaystyle{\\int 3^{5+4x}\\, \\textrm{d}x }.\n$$" :question/worked-solution "If we let $u=5+4x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 4\\quad\\Longrightarrow\\quad \\textrm d x = \\dfrac 1 4 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {3}^{5+4x}\\,\\text{d}x & =\\int {3}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\int {3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{{3}^{u}}{\\operatorname{ln}⁡3}+C \\\\  & =\\frac{{3}^{5+4x}}{4\\operatorname{ln}⁡3}+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :topic/math-academy-id 1112 :topic/next [{:db/id #edb/ref 17592186048245}] :topic/title "Integrating Exponential Functions Using Linear Substitution"}]}
