[[:db/add "1b4967da-34df-5326-adef-a4a2e38a1818" :answer/id #uuid "1b4967da-34df-5326-adef-a4a2e38a1818"] [:db/add "1b4967da-34df-5326-adef-a4a2e38a1818" :answer/type :answer.type/math] [:db/add "1b4967da-34df-5326-adef-a4a2e38a1818" :answer/value "\\frac{1}{2}\\left(e^{2 x^{3} + 3}\\right)"] [:db/ensure "1b4967da-34df-5326-adef-a4a2e38a1818" :answer/validate] [:db/add "f07a55de-cbab-55d4-89f8-58bcff9cb751" :answer-field/id #uuid "f07a55de-cbab-55d4-89f8-58bcff9cb751"] [:db/add "f07a55de-cbab-55d4-89f8-58bcff9cb751" :answer-field/key "answer"] [:db/add "f07a55de-cbab-55d4-89f8-58bcff9cb751" :answer-field/type :answer-field.type/blank] [:db/add "f07a55de-cbab-55d4-89f8-58bcff9cb751" :answer-field/choices "1b4967da-34df-5326-adef-a4a2e38a1818"] [:db/add "f07a55de-cbab-55d4-89f8-58bcff9cb751" :answer-field/correct "1b4967da-34df-5326-adef-a4a2e38a1818"] [:db/ensure "f07a55de-cbab-55d4-89f8-58bcff9cb751" :answer-field/validate] [:db/add "71b98d17-a449-5844-80cf-b608ab77000a" :question/id #uuid "71b98d17-a449-5844-80cf-b608ab77000a"] [:db/add "71b98d17-a449-5844-80cf-b608ab77000a" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 x^{2} e^{2 x^{3} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "71b98d17-a449-5844-80cf-b608ab77000a" :question/worked-solution "Let $u=2 x^{3} + 3$. Then $\\mathrm{d}u=(6 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 x^{2} e^{2 x^{3} + 3}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\frac{1}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{2}\\left(e^{2 x^{3} + 3}\\right)+C.\n$$"] [:db/add "71b98d17-a449-5844-80cf-b608ab77000a" :question/difficulty :question.difficulty/moderate] [:db/add "71b98d17-a449-5844-80cf-b608ab77000a" :question/answer-fields "f07a55de-cbab-55d4-89f8-58bcff9cb751"] [:db/ensure "71b98d17-a449-5844-80cf-b608ab77000a" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "71b98d17-a449-5844-80cf-b608ab77000a"] [:db/add "c926056a-7282-5de1-b397-323d011e59b7" :answer/id #uuid "c926056a-7282-5de1-b397-323d011e59b7"] [:db/add "c926056a-7282-5de1-b397-323d011e59b7" :answer/type :answer.type/math] [:db/add "c926056a-7282-5de1-b397-323d011e59b7" :answer/value "\\frac{1}{2}\\left(e^{2 x^{2} + 1}\\right)"] [:db/ensure "c926056a-7282-5de1-b397-323d011e59b7" :answer/validate] [:db/add "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1" :answer-field/id #uuid "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1"] [:db/add "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1" :answer-field/key "answer"] [:db/add "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1" :answer-field/type :answer-field.type/blank] [:db/add "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1" :answer-field/choices "c926056a-7282-5de1-b397-323d011e59b7"] [:db/add "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1" :answer-field/correct "c926056a-7282-5de1-b397-323d011e59b7"] [:db/ensure "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1" :answer-field/validate] [:db/add "f16e53c8-1782-522b-bd10-fd26582b2fd7" :question/id #uuid "f16e53c8-1782-522b-bd10-fd26582b2fd7"] [:db/add "f16e53c8-1782-522b-bd10-fd26582b2fd7" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 x e^{2 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "f16e53c8-1782-522b-bd10-fd26582b2fd7" :question/worked-solution "Let $u=2 x^{2} + 1$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 x e^{2 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\frac{1}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{2}\\left(e^{2 x^{2} + 1}\\right)+C.\n$$"] [:db/add "f16e53c8-1782-522b-bd10-fd26582b2fd7" :question/difficulty :question.difficulty/moderate] [:db/add "f16e53c8-1782-522b-bd10-fd26582b2fd7" :question/answer-fields "3a9a6c1f-7d6a-5d5f-973b-e9998577d9d1"] [:db/ensure "f16e53c8-1782-522b-bd10-fd26582b2fd7" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "f16e53c8-1782-522b-bd10-fd26582b2fd7"] [:db/add "f5c913b3-4717-5bf6-b6e7-ccdb5d6aaf35" :answer/id #uuid "f5c913b3-4717-5bf6-b6e7-ccdb5d6aaf35"] [:db/add "f5c913b3-4717-5bf6-b6e7-ccdb5d6aaf35" :answer/type :answer.type/math] [:db/add "f5c913b3-4717-5bf6-b6e7-ccdb5d6aaf35" :answer/value "\\frac{1}{3}\\left(e^{2 x^{3} + 3}\\right)"] [:db/ensure "f5c913b3-4717-5bf6-b6e7-ccdb5d6aaf35" :answer/validate] [:db/add "39c1d27d-4fc8-5444-9451-0c474ea62215" :answer-field/id #uuid "39c1d27d-4fc8-5444-9451-0c474ea62215"] [:db/add "39c1d27d-4fc8-5444-9451-0c474ea62215" :answer-field/key "answer"] [:db/add "39c1d27d-4fc8-5444-9451-0c474ea62215" :answer-field/type :answer-field.type/blank] [:db/add "39c1d27d-4fc8-5444-9451-0c474ea62215" :answer-field/choices "f5c913b3-4717-5bf6-b6e7-ccdb5d6aaf35"] [:db/add "39c1d27d-4fc8-5444-9451-0c474ea62215" :answer-field/correct "f5c913b3-4717-5bf6-b6e7-ccdb5d6aaf35"] [:db/ensure "39c1d27d-4fc8-5444-9451-0c474ea62215" :answer-field/validate] [:db/add "9a858179-3a87-5c6b-852e-ebf0a1c8d79c" :question/id #uuid "9a858179-3a87-5c6b-852e-ebf0a1c8d79c"] [:db/add "9a858179-3a87-5c6b-852e-ebf0a1c8d79c" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 x^{2} e^{2 x^{3} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "9a858179-3a87-5c6b-852e-ebf0a1c8d79c" :question/worked-solution "Let $u=2 x^{3} + 3$. Then $\\mathrm{d}u=(6 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 x^{2} e^{2 x^{3} + 3}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\frac{1}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{3}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{3}\\left(e^{2 x^{3} + 3}\\right)+C.\n$$"] [:db/add "9a858179-3a87-5c6b-852e-ebf0a1c8d79c" :question/difficulty :question.difficulty/moderate] [:db/add "9a858179-3a87-5c6b-852e-ebf0a1c8d79c" :question/answer-fields "39c1d27d-4fc8-5444-9451-0c474ea62215"] [:db/ensure "9a858179-3a87-5c6b-852e-ebf0a1c8d79c" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "9a858179-3a87-5c6b-852e-ebf0a1c8d79c"] [:db/add "c4dcff69-868f-54cf-b1c5-94e78aba6c7b" :answer/id #uuid "c4dcff69-868f-54cf-b1c5-94e78aba6c7b"] [:db/add "c4dcff69-868f-54cf-b1c5-94e78aba6c7b" :answer/type :answer.type/math] [:db/add "c4dcff69-868f-54cf-b1c5-94e78aba6c7b" :answer/value "\\frac{3}{2}\\left(e^{x^{2} + 3}\\right)"] [:db/ensure "c4dcff69-868f-54cf-b1c5-94e78aba6c7b" :answer/validate] [:db/add "94a4c8c5-50c8-5815-8dd4-04d820ddd54a" :answer-field/id #uuid "94a4c8c5-50c8-5815-8dd4-04d820ddd54a"] [:db/add "94a4c8c5-50c8-5815-8dd4-04d820ddd54a" :answer-field/key "answer"] [:db/add "94a4c8c5-50c8-5815-8dd4-04d820ddd54a" :answer-field/type :answer-field.type/blank] [:db/add "94a4c8c5-50c8-5815-8dd4-04d820ddd54a" :answer-field/choices "c4dcff69-868f-54cf-b1c5-94e78aba6c7b"] [:db/add "94a4c8c5-50c8-5815-8dd4-04d820ddd54a" :answer-field/correct "c4dcff69-868f-54cf-b1c5-94e78aba6c7b"] [:db/ensure "94a4c8c5-50c8-5815-8dd4-04d820ddd54a" :answer-field/validate] [:db/add "c54dbc70-72d5-57c9-bc62-b57742aaaa03" :question/id #uuid "c54dbc70-72d5-57c9-bc62-b57742aaaa03"] [:db/add "c54dbc70-72d5-57c9-bc62-b57742aaaa03" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 x e^{x^{2} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "c54dbc70-72d5-57c9-bc62-b57742aaaa03" :question/worked-solution "Let $u=x^{2} + 3$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 x e^{x^{2} + 3}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\frac{3}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{3}{2}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{2}\\left(e^{x^{2} + 3}\\right)+C.\n$$"] [:db/add "c54dbc70-72d5-57c9-bc62-b57742aaaa03" :question/difficulty :question.difficulty/moderate] [:db/add "c54dbc70-72d5-57c9-bc62-b57742aaaa03" :question/answer-fields "94a4c8c5-50c8-5815-8dd4-04d820ddd54a"] [:db/ensure "c54dbc70-72d5-57c9-bc62-b57742aaaa03" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "c54dbc70-72d5-57c9-bc62-b57742aaaa03"] [:db/add "ed17f38e-5a9f-532f-a9a4-c31488e4c7d3" :answer/id #uuid "ed17f38e-5a9f-532f-a9a4-c31488e4c7d3"] [:db/add "ed17f38e-5a9f-532f-a9a4-c31488e4c7d3" :answer/type :answer.type/math] [:db/add "ed17f38e-5a9f-532f-a9a4-c31488e4c7d3" :answer/value "\\frac{4}{3}\\left(e^{x^{3} + 1}\\right)"] [:db/ensure "ed17f38e-5a9f-532f-a9a4-c31488e4c7d3" :answer/validate] [:db/add "8a3c6378-c050-582b-bc72-c6be88390b9b" :answer-field/id #uuid "8a3c6378-c050-582b-bc72-c6be88390b9b"] [:db/add "8a3c6378-c050-582b-bc72-c6be88390b9b" :answer-field/key "answer"] [:db/add "8a3c6378-c050-582b-bc72-c6be88390b9b" :answer-field/type :answer-field.type/blank] [:db/add "8a3c6378-c050-582b-bc72-c6be88390b9b" :answer-field/choices "ed17f38e-5a9f-532f-a9a4-c31488e4c7d3"] [:db/add "8a3c6378-c050-582b-bc72-c6be88390b9b" :answer-field/correct "ed17f38e-5a9f-532f-a9a4-c31488e4c7d3"] [:db/ensure "8a3c6378-c050-582b-bc72-c6be88390b9b" :answer-field/validate] [:db/add "a9381b7a-20d5-5220-9df3-3daac3498ef9" :question/id #uuid "a9381b7a-20d5-5220-9df3-3daac3498ef9"] [:db/add "a9381b7a-20d5-5220-9df3-3daac3498ef9" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 x^{2} e^{x^{3} + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "a9381b7a-20d5-5220-9df3-3daac3498ef9" :question/worked-solution "Let $u=x^{3} + 1$. Then $\\mathrm{d}u=(3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 x^{2} e^{x^{3} + 1}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\frac{4}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(e^{x^{3} + 1}\\right)+C.\n$$"] [:db/add "a9381b7a-20d5-5220-9df3-3daac3498ef9" :question/difficulty :question.difficulty/moderate] [:db/add "a9381b7a-20d5-5220-9df3-3daac3498ef9" :question/answer-fields "8a3c6378-c050-582b-bc72-c6be88390b9b"] [:db/ensure "a9381b7a-20d5-5220-9df3-3daac3498ef9" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "a9381b7a-20d5-5220-9df3-3daac3498ef9"] [:db/add "2af0f242-a08b-5806-a259-5aa2cc196345" :answer/id #uuid "2af0f242-a08b-5806-a259-5aa2cc196345"] [:db/add "2af0f242-a08b-5806-a259-5aa2cc196345" :answer/type :answer.type/math] [:db/add "2af0f242-a08b-5806-a259-5aa2cc196345" :answer/value "e^{2 x^{2}}"] [:db/ensure "2af0f242-a08b-5806-a259-5aa2cc196345" :answer/validate] [:db/add "9ac1486d-5749-5938-9322-c13e1a18c668" :answer-field/id #uuid "9ac1486d-5749-5938-9322-c13e1a18c668"] [:db/add "9ac1486d-5749-5938-9322-c13e1a18c668" :answer-field/key "answer"] [:db/add "9ac1486d-5749-5938-9322-c13e1a18c668" :answer-field/type :answer-field.type/blank] [:db/add "9ac1486d-5749-5938-9322-c13e1a18c668" :answer-field/choices "2af0f242-a08b-5806-a259-5aa2cc196345"] [:db/add "9ac1486d-5749-5938-9322-c13e1a18c668" :answer-field/correct "2af0f242-a08b-5806-a259-5aa2cc196345"] [:db/ensure "9ac1486d-5749-5938-9322-c13e1a18c668" :answer-field/validate] [:db/add "b5a9808d-04fd-57d0-8c1f-56acc1d05a06" :question/id #uuid "b5a9808d-04fd-57d0-8c1f-56acc1d05a06"] [:db/add "b5a9808d-04fd-57d0-8c1f-56acc1d05a06" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 x e^{2 x^{2}}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "b5a9808d-04fd-57d0-8c1f-56acc1d05a06" :question/worked-solution "Let $u=2 x^{2}$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 x e^{2 x^{2}}\\,\\mathrm{d}x\\\\&=\\int e^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\nSubstitute back:\n\n$$\ne^{2 x^{2}}+C.\n$$"] [:db/add "b5a9808d-04fd-57d0-8c1f-56acc1d05a06" :question/difficulty :question.difficulty/moderate] [:db/add "b5a9808d-04fd-57d0-8c1f-56acc1d05a06" :question/answer-fields "9ac1486d-5749-5938-9322-c13e1a18c668"] [:db/ensure "b5a9808d-04fd-57d0-8c1f-56acc1d05a06" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "b5a9808d-04fd-57d0-8c1f-56acc1d05a06"] [:db/add "479797be-8545-5273-ba72-17faea4f3e3f" :answer/id #uuid "479797be-8545-5273-ba72-17faea4f3e3f"] [:db/add "479797be-8545-5273-ba72-17faea4f3e3f" :answer/type :answer.type/math] [:db/add "479797be-8545-5273-ba72-17faea4f3e3f" :answer/value "\\frac{2}{3}\\left(e^{2 x^{3} + 1}\\right)"] [:db/ensure "479797be-8545-5273-ba72-17faea4f3e3f" :answer/validate] [:db/add "6bee483e-b68e-5967-853c-c538a70f71b6" :answer-field/id #uuid "6bee483e-b68e-5967-853c-c538a70f71b6"] [:db/add "6bee483e-b68e-5967-853c-c538a70f71b6" :answer-field/key "answer"] [:db/add "6bee483e-b68e-5967-853c-c538a70f71b6" :answer-field/type :answer-field.type/blank] [:db/add "6bee483e-b68e-5967-853c-c538a70f71b6" :answer-field/choices "479797be-8545-5273-ba72-17faea4f3e3f"] [:db/add "6bee483e-b68e-5967-853c-c538a70f71b6" :answer-field/correct "479797be-8545-5273-ba72-17faea4f3e3f"] [:db/ensure "6bee483e-b68e-5967-853c-c538a70f71b6" :answer-field/validate] [:db/add "50714240-2916-588a-b9a3-6a05c31eec50" :question/id #uuid "50714240-2916-588a-b9a3-6a05c31eec50"] [:db/add "50714240-2916-588a-b9a3-6a05c31eec50" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 x^{2} e^{2 x^{3} + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "50714240-2916-588a-b9a3-6a05c31eec50" :question/worked-solution "Let $u=2 x^{3} + 1$. Then $\\mathrm{d}u=(6 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 x^{2} e^{2 x^{3} + 1}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\frac{2}{3}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{2}{3}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{3}\\left(e^{2 x^{3} + 1}\\right)+C.\n$$"] [:db/add "50714240-2916-588a-b9a3-6a05c31eec50" :question/difficulty :question.difficulty/moderate] [:db/add "50714240-2916-588a-b9a3-6a05c31eec50" :question/answer-fields "6bee483e-b68e-5967-853c-c538a70f71b6"] [:db/ensure "50714240-2916-588a-b9a3-6a05c31eec50" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "50714240-2916-588a-b9a3-6a05c31eec50"] [:db/add "89bd8db7-acae-53be-a332-0a7ed2b766fc" :answer/id #uuid "89bd8db7-acae-53be-a332-0a7ed2b766fc"] [:db/add "89bd8db7-acae-53be-a332-0a7ed2b766fc" :answer/type :answer.type/math] [:db/add "89bd8db7-acae-53be-a332-0a7ed2b766fc" :answer/value "\\frac{1}{4}\\left(e^{2 x^{2} + 2}\\right)"] [:db/ensure "89bd8db7-acae-53be-a332-0a7ed2b766fc" :answer/validate] [:db/add "bbc67b53-39c5-5371-b8f0-c9997e05c726" :answer-field/id #uuid "bbc67b53-39c5-5371-b8f0-c9997e05c726"] [:db/add "bbc67b53-39c5-5371-b8f0-c9997e05c726" :answer-field/key "answer"] [:db/add "bbc67b53-39c5-5371-b8f0-c9997e05c726" :answer-field/type :answer-field.type/blank] [:db/add "bbc67b53-39c5-5371-b8f0-c9997e05c726" :answer-field/choices "89bd8db7-acae-53be-a332-0a7ed2b766fc"] [:db/add "bbc67b53-39c5-5371-b8f0-c9997e05c726" :answer-field/correct "89bd8db7-acae-53be-a332-0a7ed2b766fc"] [:db/ensure "bbc67b53-39c5-5371-b8f0-c9997e05c726" :answer-field/validate] [:db/add "8cf48884-db4f-5141-aec9-7eb7861239bf" :question/id #uuid "8cf48884-db4f-5141-aec9-7eb7861239bf"] [:db/add "8cf48884-db4f-5141-aec9-7eb7861239bf" :question/problem "Find an antiderivative.\n\n$$\n\\int x e^{2 x^{2} + 2}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "8cf48884-db4f-5141-aec9-7eb7861239bf" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int x e^{2 x^{2} + 2}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n\\frac{1}{4}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(e^{2 x^{2} + 2}\\right)+C.\n$$"] [:db/add "8cf48884-db4f-5141-aec9-7eb7861239bf" :question/difficulty :question.difficulty/moderate] [:db/add "8cf48884-db4f-5141-aec9-7eb7861239bf" :question/answer-fields "bbc67b53-39c5-5371-b8f0-c9997e05c726"] [:db/ensure "8cf48884-db4f-5141-aec9-7eb7861239bf" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "8cf48884-db4f-5141-aec9-7eb7861239bf"] [:db/add "e38cce4c-8138-5d4b-9aec-1ef206104df1" :answer/id #uuid "e38cce4c-8138-5d4b-9aec-1ef206104df1"] [:db/add "e38cce4c-8138-5d4b-9aec-1ef206104df1" :answer/type :answer.type/math] [:db/add "e38cce4c-8138-5d4b-9aec-1ef206104df1" :answer/value "- \\frac{3}{2}\\left(e^{3 - x^{2}}\\right)"] [:db/ensure "e38cce4c-8138-5d4b-9aec-1ef206104df1" :answer/validate] [:db/add "53809f76-5c28-56ae-b644-88fdfe771c6f" :answer-field/id #uuid "53809f76-5c28-56ae-b644-88fdfe771c6f"] [:db/add "53809f76-5c28-56ae-b644-88fdfe771c6f" :answer-field/key "answer"] [:db/add "53809f76-5c28-56ae-b644-88fdfe771c6f" :answer-field/type :answer-field.type/blank] [:db/add "53809f76-5c28-56ae-b644-88fdfe771c6f" :answer-field/choices "e38cce4c-8138-5d4b-9aec-1ef206104df1"] [:db/add "53809f76-5c28-56ae-b644-88fdfe771c6f" :answer-field/correct "e38cce4c-8138-5d4b-9aec-1ef206104df1"] [:db/ensure "53809f76-5c28-56ae-b644-88fdfe771c6f" :answer-field/validate] [:db/add "d98734fa-e5c5-5d9c-9a9b-68f30b694346" :question/id #uuid "d98734fa-e5c5-5d9c-9a9b-68f30b694346"] [:db/add "d98734fa-e5c5-5d9c-9a9b-68f30b694346" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 x e^{3 - x^{2}}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "d98734fa-e5c5-5d9c-9a9b-68f30b694346" :question/worked-solution "Let $u=3 - x^{2}$. Then $\\mathrm{d}u=(- 2 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 x e^{3 - x^{2}}\\,\\mathrm{d}x\\\\&=- \\frac{3}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\n$$\n- \\frac{3}{2}\\left(\\int e^{u}\\,\\mathrm{d}u\\right)=- \\frac{3}{2}\\left(e^{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{3}{2}\\left(e^{3 - x^{2}}\\right)+C.\n$$"] [:db/add "d98734fa-e5c5-5d9c-9a9b-68f30b694346" :question/difficulty :question.difficulty/hard] [:db/add "d98734fa-e5c5-5d9c-9a9b-68f30b694346" :question/answer-fields "53809f76-5c28-56ae-b644-88fdfe771c6f"] [:db/ensure "d98734fa-e5c5-5d9c-9a9b-68f30b694346" :question/validate] [:db/add 17592186184349 :knowledge-point/questions "d98734fa-e5c5-5d9c-9a9b-68f30b694346"] [:db/add "49abe979-652f-5742-87b9-21865ebc9b05" :answer/id #uuid "49abe979-652f-5742-87b9-21865ebc9b05"] [:db/add "49abe979-652f-5742-87b9-21865ebc9b05" :answer/type :answer.type/math] [:db/add "49abe979-652f-5742-87b9-21865ebc9b05" :answer/value "- \\frac{1}{3}\\left(e^{3 - 2 x^{3}}\\right)"] [:db/ensure "49abe979-652f-5742-87b9-21865ebc9b05" :answer/validate] [:db/add "832b2610-95a1-50b8-bef8-f8eb38bd8f0e" :answer-field/id #uuid "832b2610-95a1-50b8-bef8-f8eb38bd8f0e"] [:db/add "832b2610-95a1-50b8-bef8-f8eb38bd8f0e" :answer-field/key "answer"] [:db/add "832b2610-95a1-50b8-bef8-f8eb38bd8f0e" :answer-field/type :answer-field.type/blank] [:db/add "832b2610-95a1-50b8-b