  "before_edn": "{:db/id 17592186184349 :knowledge-point/canonical-example {:db/id 17592186183945 :question/id #uuid \"3e9586ee-12d1-5dbb-81f6-0f0a4998e00a\" :question/math-academy-id \"e-14402\" :question/problem \"Calculate  $$\\n\\\\displaystyle{\\\\int x^2 e^{x^3+1}\\\\, \\\\textrm{d}x }.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u = x^3+1.$ Differentiating gives\\n\\n$$\\n\\\\dfrac{\\\\textrm{d}u}{\\\\textrm{d}x}= 3x^2\\\\quad\\\\Longrightarrow\\\\quad\\\\dfrac 1 3 \\\\textrm{d}u = x^2 \\\\, \\\\textrm{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int {x}^{2}{e}^{{x}^{3}+1}\\\\,\\\\text{d}x & =\\\\int {e}^{{x}^{3}+1}\\\\cdot \\\\,{x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {e}^{u}\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\int {e}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}{e}^{u}+C \\\\\\\\  & =\\\\frac{1}{3}{e}^{{x}^{3}+1}+C.\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"e803bd99-388f-5146-ab91-03fd7b658c2c\" :knowledge-point/key-prerequisites [{:db/id 17592186050101 :topic/difficulty 1.7766990018568227 :topic/id #uuid \"2d31fc2e-19fe-50d4-bccf-d60b3f5db5c4\" :topic/knowledge-points [{:db/id 17592186096655} {:db/id 17592186096656}] :topic/math-academy-id 1112 :topic/next [{:db/id 17592186048245}] :topic/title \"Integrating Exponential Functions Using Linear Substitution\"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186680342 :question-generator/id #uuid \"b5ec3ef0-b432-52ca-b332-fc927d928c7e\" :question-generator/script \"generators/0f/0f136e0f6839f0a542eb58fbdb989da4c0b22b3f0848cd37ab3d1a0ed8d27c50/generator.py\"} :knowledge-point/questions [{:db/id 17592186184470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"83d22492-39be-5818-b2f9-72466fc0f7d3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}e^{x^{3} + 2} + C\" :db/id 17592186180998} {:answer/id #uuid \"a7ac4ca7-0b5d-5006-8e17-41afe089eb14\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}e^{x^{3} + 2} + C\" :db/id 17592186180999} {:answer/id #uuid \"b92fcd6b-3979-572f-840c-1b878839f23b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}e^{x^{3} + 2} + C\" :db/id 17592186181000} {:answer/id #uuid \"cfe98265-80f0-5ce4-ab7c-24cb05043464\" :answer/type {:db/ident :answer.type/math} :answer/value \"4e^{x^{3} + 2} + C\" :db/id 17592186181001} {:answer/id #uuid \"4c9c2116-b26a-55d4-9a9c-1cc7c0ce1d54\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}e^{x^{3} + 2} + C\" :db/id 17592186181002}] :answer-field/id #uuid \"74aa1e13-622e-5bc2-9c8b-8b14ea8a9e82\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186180997}] :question/id #uuid \"80b3fee2-e988-57de-a2ab-01d1f73b034c\" :question/math-academy-id \"q-13737\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int4x^{2}e^{x^{3} + 2}dx\\n$$?\"} {:db/id 17592186184836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2fa8605d-586a-58e5-95e6-49015287b26e\" :answer/type {:db/ident :answer.type/math} :answer/value \"5e^{1 - 5x^{2}} + C\" :db/id 17592186183626} {:answer/id #uuid \"405a50b5-36b7-52fe-9011-af86eb9f7abc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{10}e^{1 - 5x^{2}} + C\" :db/id 17592186183627} {:answer/id #uuid \"584858fa-c069-5e73-8e74-d9590b5632e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2e^{1 - 5x^{2}} + C\" :db/id 17592186183628} {:answer/id #uuid \"6d2d135d-6c84-5c28-aaf4-72dce09ff44f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}e^{1 - 5x^{2}} + C\" :db/id 17592186183629} {:answer/id #uuid \"78499ab6-df7c-502d-9f76-72859e1e137d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{5}e^{1 - 5x^{2}} + C\" :db/id 17592186183630}] :answer-field/id #uuid \"ebf709d9-05ed-5ee8-9978-0f8168375579\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186183625}] :question/id #uuid \"2ce6b941-f2cb-5089-a012-f9a2e257c86c\" :question/math-academy-id \"q-73663\" :question/problem \"What is $$\\n\\\\displaystyle \\\\int5xe^{1 - 5x^{2}}dx\\n$$?\"} {:db/id 17592186250123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"02b84d7d-608c-57fe-ad2a-8d7b3223ebf1\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2{e}^{4-{x}^{4}}+C\" :db/id 17592186247443} {:answer/id #uuid \"7b94e33e-8377-50fa-ba1a-01b0ed35414e\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{{e}^{4-{x}^{4}}}{2}+C\" :db/id 17592186248509} {:answer/id #uuid \"86567d54-2455-5e0f-9993-5bd9586dbb63\" :answer/type {:db/ident :answer.type/math} :answer/value \"{e}^{4-{x}^{4}}+C\" :db/id 17592186248624} {:answer/id #uuid \"922418e0-e363-5310-a811-02c1d0ad7698\" :answer/type {:db/ident :answer.type/math} :answer/value \"2{e}^{4-{x}^{4}}+C\" :db/id 17592186248720} {:answer/id #uuid \"c9074ff3-7294-565a-b1f0-898bbb960848\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{e}^{4-{x}^{4}}}{2}+C\" :db/id 17592186249212}] :answer-field/correct {:answer/id #uuid \"02b84d7d-608c-57fe-ad2a-8d7b3223ebf1\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2{e}^{4-{x}^{4}}+C\" :db/id 17592186247443} :answer-field/id #uuid \"a966ca4b-b482-5dc7-9dca-76ae5ec77a2b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249969}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cea6cfb7-b02b-5433-ac98-e8175ace7d35\" :question/math-academy-id \"q-113847\" :question/problem \"$$\\n\\\\displaystyle \\\\int 8{x}^{3}{e}^{4-{x}^{4}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=4-{x}^{4}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-4{x}^{3}\\\\,⟹\\\\,-2\\\\text{d}u=8{x}^{3}\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 8{x}^{3}{e}^{4-{x}^{4}}\\\\,\\\\text{d}x & =\\\\int {e}^{4-{x}^{4}}\\\\cdot 8{x}^{3}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {e}^{u}\\\\cdot (-2)\\\\,\\\\text{d}u \\\\\\\\  & =-2\\\\int {e}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =-2{e}^{u}+C \\\\\\\\  & =-2{e}^{4-{x}^{4}}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186290509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"00acbd21-382b-5ab9-ae57-615f612cac26\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{e}^{{z}^{2}}}{2}+C\" :db/id 17592186288029} {:answer/id #uuid \"16d1a3f9-9805-5b0c-9623-8ffe993e1989\" :answer/type {:db/ident :answer.type/math} :answer/value \"2{e}^{{z}^{2}}+C\" :db/id 17592186288185} {:answer/id #uuid \"3f42556a-0e3e-57ac-ac74-0ee7a768fb60\" :answer/type {:db/ident :answer.type/math} :answer/value \"{e}^{{z}^{2}}+C\" :db/id 17592186288463} {:answer/id #uuid \"95b7afd6-8fcf-5067-8e15-ead7f07a0ef1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{e}^{z}}{2}+C\" :db/id 17592186289031} {:answer/id #uuid \"9620b0c1-fc6c-5c19-a632-d8a82a74f6dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{{e}^{{z}^{2}}}{2}+C\" :db/id 17592186289038}] :answer-field/correct {:answer/id #uuid \"00acbd21-382b-5ab9-ae57-615f612cac26\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{e}^{{z}^{2}}}{2}+C\" :db/id 17592186288029} :answer-field/id #uuid \"0a11595a-5a8b-5fc2-9ad5-95d2f1d21318\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186289748}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"8c2e05bf-d6ab-5dd9-a54b-6f33a76c6868\" :question/math-academy-id \"q-2382\" :question/problem \"$$\\n\\\\displaystyle \\\\int z{e}^{{z}^{2}}\\\\,\\\\text{d}z=\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={z}^{2}.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}z}=2z\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=z\\\\,\\\\text{d}z.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int z{e}^{{z}^{2}}\\\\,\\\\text{d}z & =\\\\int {e}^{{z}^{2}}\\\\cdot z\\\\,\\\\text{d}z \\\\\\\\  & =\\\\int {e}^{u}\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int {e}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\cdot {e}^{u}+C \\\\\\\\  & =\\\\frac{{e}^{{z}^{2}}}{2}+C.\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186342054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"20dee8fa-f8ac-5b39-a8ad-c1b5486f639d\" :answer/type {:db/ident :answer.type/math} :answer/value \"2x{e}^{2{x}^{2}-x}+C\" :db/id 17592186339411} {:answer/id #uuid \"70c68315-1c62-551c-8f66-382b1980812f\" :answer/type {:db/ident :answer.type/math} :answer/value \"{e}^{2{x}^{2}-x}+C\" :db/id 17592186340129} {:answer/id #uuid \"8b0f4634-38d0-5a9c-a0e0-e92894c3f3ca\" :answer/type {:db/ident :answer.type/math} :answer/value \"{e}^{2{x}^{2}-x}+2{x}^{2}+C\" :db/id 17592186340373} {:answer/id #uuid \"c32920a0-43b1-5c65-9be0-be89e59dc068\" :answer/type {:db/ident :answer.type/math} :answer/value \"4{e}^{2{x}^{2}-x}+C\" :db/id 17592186340863} {:answer/id #uuid \"de852984-1ce8-5b8f-b435-50d70b3f4b97\" :answer/type {:db/ident :answer.type/math} :answer/value \"(2{x}^{2}-x){e}^{2{x}^{2}-x}+C\" :db/id 17592186341103}] :answer-field/correct {:answer/id #uuid \"70c68315-1c62-551c-8f66-382b1980812f\" :answer/type {:db/ident :answer.type/math} :answer/value \"{e}^{2{x}^{2}-x}+C\" :db/id 17592186340129} :answer-field/id #uuid \"cee805a0-b37f-5490-8818-8142f62aef3e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341743}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"775fc84f-28a7-5997-a00c-a935e8817172\" :question/math-academy-id \"q-73662\" :question/problem \"$$\\n\\\\displaystyle \\\\int (4x-1){e}^{2{x}^{2}-x}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=2{x}^{2}-x.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4x-1\\\\,⟹\\\\,\\\\text{d}u=(4x-1)\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int (4x-1){e}^{2{x}^{2}-x}\\\\,\\\\text{d}x & =\\\\int {e}^{2{x}^{2}-x}\\\\cdot (4x-1)\\\\text{d}x \\\\\\\\  & =\\\\int {e}^{u}\\\\,\\\\text{d}u \\\\\\\\  & ={e}^{2{x}^{2}-x}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186342055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0950077f-5306-57da-9f06-faaa7d8206c4\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{6}{e}^{5-2{x}^{3}}+C\" :db/id 17592186339207} {:answer/id #uuid \"9bf82ca6-ad94-5fdd-a899-3c7c54cc20be\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{3}{e}^{5-2{x}^{3}}+C\" :db/id 17592186340532} {:answer/id #uuid \"a3e1e3d7-4987-5b16-8a1e-ddf441083d39\" :answer/type {:db/ident :answer.type/math} :answer/value \"-{e}^{5-2{x}^{3}}+C\" :db/id 17592186340613} {:answer/id #uuid \"aa24112d-02cf-52a3-98b5-d799573a4663\" :answer/type {:db/ident :answer.type/math} :answer/value \"6{e}^{5-2{x}^{3}}+C\" :db/id 17592186340681} {:answer/id #uuid \"e1df2684-cab8-51a8-a3b4-21cf85839e36\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}{e}^{5-2{x}^{3}}+C\" :db/id 17592186341131}] :answer-field/correct {:answer/id #uuid \"a3e1e3d7-4987-5b16-8a1e-ddf441083d39\" :answer/type {:db/ident :answer.type/math} :answer/value \"-{e}^{5-2{x}^{3}}+C\" :db/id 17592186340613} :answer-field/id #uuid \"3a39fa1f-bf03-5be7-a356-d7a0ccbb9e6c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341485}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"78eb8eca-5e7f-5422-8275-d4d9278c8f6b\" :question/math-academy-id \"q-73664\" :question/problem \"$$\\n\\\\displaystyle \\\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=5-2{x}^{3}.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-6{x}^{2}\\\\,⟹\\\\,-\\\\text{d}u=6{x}^{2}\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\\\,\\\\text{d}x & =\\\\int {e}^{5-2{x}^{3}}\\\\cdot 6{x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {e}^{u}\\\\cdot \\\\,(-\\\\text{d}u) \\\\\\\\  & =-\\\\int {e}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =-{e}^{u}+C \\\\\\\\  & =-{e}^{5-2{x}^{3}}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186342084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0b9a0870-f8c4-5b88-9fc4-23a032ca1014\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{9}{e}^{3{x}^{3}+1}+C\" :db/id 17592186339228} {:answer/id #uuid \"1c4583d3-b65d-531b-90ce-c8082399cab5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{27}{e}^{3{x}^{3}+1}+C\" :db/id 17592186339370} {:answer/id #uuid \"1fa6a84f-26cb-5ba8-9c5a-d930d920fb17\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}{e}^{3{x}^{3}+1}+C\" :db/id 17592186339403} {:answer/id #uuid \"e327b154-8449-5e64-8466-531b65354f8c\" :answer/type {:db/ident :answer.type/math} :answer/value \"{e}^{3{x}^{3}+1}+C\" :db/id 17592186341139} {:answer/id #uuid \"f6415d67-ab62-5c80-8c4b-4c14b2b5afc2\" :answer/type {:db/ident :answer.type/math} :answer/value \"3{e}^{3{x}^{3}+1}+C\" :db/id 17592186341304}] :answer-field/correct {:answer/id #uuid \"1fa6a84f-26cb-5ba8-9c5a-d930d920fb17\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}{e}^{3{x}^{3}+1}+C\" :db/id 17592186339403} :answer-field/id #uuid \"f4b217b9-d7db-507a-b039-4fdc0e3ca281\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341815}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"936e31ed-13cd-5404-9ab8-85dcf93e8b28\" :question/math-academy-id \"q-73798\" :question/problem \"$$\\n\\\\displaystyle \\\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=3{x}^{3}+1.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=9{x}^{2}\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u=3{x}^{2}\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\\\,\\\\text{d}x & =\\\\int {e}^{3{x}^{3}+1}\\\\cdot 3{x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {e}^{u}\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\int {e}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}{e}^{u}+C \\\\\\\\  & =\\\\frac{1}{3}{e}^{3{x}^{3}+1}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186608223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"06b5ebe5-c210-5b35-835d-d9deeeabec7f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2}{3}{e}^{-{x}^{3}-5}+C\" :db/id 17592186607812} {:answer/id #uuid \"093177fd-5db2-57d5-9b5c-850e7b01fb2c\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{3}{2}{e}^{-{x}^{3}-5}+C\" :db/id 17592186607813} {:answer/id #uuid \"41629820-71e3-5199-b636-aa0a0102d247\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}{e}^{-{x}^{3}-5}+C\" :db/id 17592186607887} {:answer/id #uuid \"e4e0cba8-3339-5415-84a0-92836507db7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}{e}^{-{x}^{3}-5}+C\" :db/id 17592186608056} {:answer/id #uuid \"e5ccf36b-4d0e-5552-bc07-10a01cad864b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{3}{e}^{-{x}^{3}-5}+C\" :db/id 17592186608057}] :answer-field/correct {:answer/id #uuid \"06b5ebe5-c210-5b35-835d-d9deeeabec7f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2}{3}{e}^{-{x}^{3}-5}+C\" :db/id 17592186607812} :answer-field/id #uuid \"c1f2b0b4-ffb2-5d8c-aa82-efd5909fb1b8\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186608149}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c5cec407-ac09-52aa-af07-f10036319399\" :question/math-academy-id \"q-13738\" :question/problem \"$$\\n\\\\displaystyle \\\\int 2{x}^{2}{e}^{-{x}^{3}-5}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=-{x}^{3}-5.$ Differentiating gives\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-3{x}^{2}\\\\,⟹\\\\,-\\\\frac{1}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 2{x}^{2}{e}^{-{x}^{3}-5}\\\\,\\\\text{d}x & =2\\\\int {e}^{-{x}^{3}-5}\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =2\\\\int {e}^{u}\\\\cdot (-\\\\frac{1}{3}\\\\,\\\\text{d}u) \\\\\\\\  & =-\\\\frac{2}{3}\\\\int {e}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{2}{3}{e}^{u}+C \\\\\\\\  & =-\\\\frac{2}{3}{e}^{-{x}^{3}-5}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186679213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9c33e52a-ef5c-5dca-bf52-8df13c19b1ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(e^{2 x^{3} + 1}\\\\right)\" :db/id 17592186679266}] :answer-field/correct {:answer/id #uuid \"9c33e52a-ef5c-5dca-bf52-8df13c19b1ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(e^{2 x^{3} + 1}\\\\right)\" :db/id 17592186679266} :answer-field/id #uuid \"2fb711a7-75fa-5cfb-910d-a08ab701557b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679227}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"06c9f2f2-081d-5e5e-8117-a35b1223b310\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 x^{2} e^{2 x^{3} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x^{3} + 1$. Then $\\\\mathrm{d}u=(6 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 x^{2} e^{2 x^{3} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(e^{2 x^{3} + 1}\\\\right)+C.\\n$$\"} {:db/id 17592186679214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"181a1512-9dd4-53af-9ba3-3eb324313f8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679219} {:answer/id #uuid \"7a87e481-f08d-546c-a5fd-9d72fd9efedc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679253} {:answer/id #uuid \"cbf92a61-1cff-5108-925b-d44c96c3d13b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679288} {:answer/id #uuid \"d2f766dd-ea7b-5203-b26a-c27aa674bf4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679293} {:answer/id #uuid \"d3a3f135-c2b6-523f-a74a-43b4dbdae668\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679294}] :answer-field/correct {:answer/id #uuid \"d3a3f135-c2b6-523f-a74a-43b4dbdae668\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679294} :answer-field/id #uuid \"17beb37c-8590-5c39-8072-d207ac683a15\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679218}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"0c377e5f-9911-5d2b-8f41-5524ea99756c\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int 4 x^{2} e^{x^{3}}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{3}$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 x^{2} e^{x^{3}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6729ae11-fc35-5976-bc57-1902448a0ac8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(e^{2 x^{3} + 3}\\\\right)\" :db/id 17592186679247}] :answer-field/correct {:answer/id #uuid \"6729ae11-fc35-5976-bc57-1902448a0ac8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(e^{2 x^{3} + 3}\\\\right)\" :db/id 17592186679247} :answer-field/id #uuid \"4b73fd0e-d92a-5771-8910-1465e9933d14\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679237}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4392d504-1c48-5a77-bd3a-c3e46bfee947\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} e^{2 x^{3} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x^{3} + 3$. Then $\\\\mathrm{d}u=(6 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} e^{2 x^{3} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(e^{2 x^{3} + 3}\\\\right)+C.\\n$$\"} {:db/id 17592186679244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"39705c35-f8ef-5f06-9f87-2be289ab2f9b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679230} {:answer/id #uuid \"46637690-b7c3-56f6-95e1-84855e2175d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\" :db/id 17592186679236} {:answer/id #uuid \"5f51b04f-bd5c-57b1-ad81-03341d4152eb\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679243} {:answer/id #uuid \"96d81243-1274-57e6-830c-65b5e9fa8bf4\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679264} {:answer/id #uuid \"a3062d47-6aab-5f79-8450-3d231034d63e\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679271}] :answer-field/correct {:answer/id #uuid \"46637690-b7c3-56f6-95e1-84855e2175d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\" :db/id 17592186679236} :answer-field/id #uuid \"766e5203-6be6-528d-a2cd-3f20c9ba71de\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"5ff8adcd-3573-5070-a09c-c172e636c5b9\" :question/problem \"Use the substitution $u=x^{2} + 3$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 x e^{x^{2} + 3}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{2} + 3$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x e^{x^{2} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186679248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"14908f18-bce8-59f2-9cc3-127bcf0926f7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679216} {:answer/id #uuid \"3790a970-21f1-5577-bc46-d4e2a9d1bfe7\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679228} {:answer/id #uuid \"b16dfd9d-e421-560e-8dbd-3bcc20389c5f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679276} {:answer/id #uuid \"cef78cfa-4989-5ca8-8b60-1843b5863fe4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679290} {:answer/id #uuid \"f71dc5e9-ee6b-5b07-bb9e-0b9e7f3d35fe\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679312}] :answer-field/correct {:answer/id #uuid \"b16dfd9d-e421-560e-8dbd-3bcc20389c5f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679276} :answer-field/id #uuid \"50731c45-0364-5d44-8091-d5b4510a82c9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679238}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"67f901ed-98c1-580f-8d13-60885322fffd\" :question/problem \"Use the substitution $u=x^{3} + 3$. Which integral is obtained?\\n\\n$$\\n\\\\int 4 x^{2} e^{x^{3} + 3}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{3} + 3$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 x^{2} e^{x^{3} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"004ac9db-8c67-5fe2-a521-63d53f3b6db6\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679211} {:answer/id #uuid \"3d0d74cc-85d2-5646-af67-db3f777cdea1\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679232} {:answer/id #uuid \"7c542cf9-a8d8-5be1-b287-a9743537e2bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\" :db/id 17592186679254} {:answer/id #uuid \"96785031-b0b5-5089-8075-9458b263604e\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679263} {:answer/id #uuid \"da995351-7f7f-54ee-b241-87e9cec46a2e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679298}] :answer-field/correct {:answer/id #uuid \"7c542cf9-a8d8-5be1-b287-a9743537e2bb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\" :db/id 17592186679254} :answer-field/id #uuid \"a0743c97-1ef6-5329-ac17-faa2e94700bc\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679268}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"75b210bf-f0b2-5e8a-a38e-28c9458555c0\" :question/problem \"Use the substitution $u=x^{3} + 3$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 x^{2} e^{x^{3} + 3}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{3} + 3$. Then $\\\\mathrm{d}u=(3 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} e^{x^{3} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186679255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e6893cf9-4649-57b1-8129-7cb316292daa\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{2}\\\\left(e^{2 - x^{2}}\\\\right)\" :db/id 17592186679304}] :answer-field/correct {:answer/id #uuid \"e6893cf9-4649-57b1-8129-7cb316292daa\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{2}\\\\left(e^{2 - x^{2}}\\\\right)\" :db/id 17592186679304} :answer-field/id #uuid \"a482b582-40f6-5d63-a318-a1162d0fa1e1\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679272}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"85f8f3f2-08bb-5e4a-95f7-e04a03d95523\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x e^{2 - x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 - x^{2}$. Then $\\\\mathrm{d}u=(- 2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x e^{2 - x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3}{2}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(e^{2 - x^{2}}\\\\right)+C.\\n$$\"} {:db/id 17592186679258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"dac31bbf-6156-5bec-8a8f-2bd53c351533\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(e^{2 x^{3} + 3}\\\\right)\" :db/id 17592186679299}] :answer-field/correct {:answer/id #uuid \"dac31bbf-6156-5bec-8a8f-2bd53c351533\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(e^{2 x^{3} + 3}\\\\right)\" :db/id 17592186679299} :answer-field/id #uuid \"41f880c9-fcbf-51bd-a857-646ed253f4a1\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679233}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8def59e0-ca36-56d3-8371-7139140d77de\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x^{2} e^{2 x^{3} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x^{3} + 3$. Then $\\\\mathrm{d}u=(6 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} e^{2 x^{3} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(e^{2 x^{3} + 3}\\\\right)+C.\\n$$\"} {:db/id 17592186679259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"caf1d597-c130-5150-a713-e088d5003d84\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(e^{3 - 2 x^{3}}\\\\right)\" :db/id 17592186679286}] :answer-field/correct {:answer/id #uuid \"caf1d597-c130-5150-a713-e088d5003d84\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(e^{3 - 2 x^{3}}\\\\right)\" :db/id 17592186679286} :answer-field/id #uuid \"bc07202b-066e-5a08-88ea-66ff3182e51f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679282}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"91154a9a-ca11-54f8-a6c6-dd9021a1ba24\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 x^{2} e^{3 - 2 x^{3}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=3 - 2 x^{3}$. Then $\\\\mathrm{d}u=(- 6 x^{2})\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 x^{2} e^{3 - 2 x^{3}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n- \\\\frac{2}{3}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2}{3}\\\\left(e^{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2}{3}\\\\left(e^{3 - 2 x^{3}}\\\\right)+C.\\n$$\"} {:db/id 17592186679267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f3830de4-a5af-52f9-856d-db0c6cc56d7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"e^{2 x^{2}}\" :db/id 17592186679311}] :answer-field/correct {:answer/id #uuid \"f3830de4-a5af-52f9-856d-db0c6cc56d7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"e^{2 x^{2}}\" :db/id 17592186679311} :answer-field/id #uuid \"1e4c8932-4273-5d7d-bcb3-2dc7b8caf5e6\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679222}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9dab4373-3bc8-5360-9d0f-9464e91bb20e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 x e^{2 x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x^{2}$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 x e^{2 x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\ne^{2 x^{2}}+C.\\n$$\"} {:db/id 17592186679269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ecd04eb-ead1-55d9-bd04-1978eb289b3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679215} {:answer/id #uuid \"21d44399-933e-5c2f-adf6-7188fd21b08a\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679223} {:answer/id #uuid \"96081bd8-3257-5fc9-b271-3ba094a4ef11\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\" :db/id 17592186679262} {:answer/id #uuid \"db98860b-1701-5b1a-a33e-e87dc3f68d1c\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679300} {:answer/id #uuid \"fce871d1-b20a-5f20-9205-d7fe38d7eb57\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679314}] :answer-field/correct {:answer/id #uuid \"0ecd04eb-ead1-55d9-bd04-1978eb289b3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679215} :answer-field/id #uuid \"94bc0b2c-4942-55bd-885e-a1a8f4290e43\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679261}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a1f8b57d-23a2-5f0a-a3b5-4e7edcf30ca5\" :question/problem \"Use the substitution $u=x^{2} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 4 x e^{x^{2} + 2}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{2} + 2$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 x e^{x^{2} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"37fd5afc-64c0-5976-b8ff-d52926d864d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679229} {:answer/id #uuid \"9aa7433c-cca7-54c1-a935-33d31843e780\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679265} {:answer/id #uuid \"c481a3b8-224e-5a9d-9401-da26741c823f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679283} {:answer/id #uuid \"d8599c8c-8242-5c80-b41a-af9bf140d2b3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int e^{u}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679297} {:answer/id #uuid \"ecd24b01-d80c-5e9a-a423-593ca0bfde4c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int e^{u}\\\\,\\\\mathrm{d}u\" :db/id 17592186679309}] :answer-field/correct {:answer/id #uuid \"c481a3b8-224e-5a9d-9401-da26741c823f\" :answer/type {: