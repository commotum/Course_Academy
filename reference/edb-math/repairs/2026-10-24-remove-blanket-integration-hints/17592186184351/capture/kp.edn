 & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|{5}^{x}+1|+C \\\\  & =\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${5}^{x}+1>0$ for all $x.$"} {:db/id #edb/ref 17592186297411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07618f82-80dd-5c73-b8a4-2164bc070f03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x})}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295304} {:answer/id #uuid "7fabc313-b7ec-5fea-8e37-3c5a06d43177" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{4}^{x}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295957} {:answer/id #uuid "872590b5-df6d-5e6e-9dc4-79994e14eb92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{4\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295994} {:answer/id #uuid "ac13f248-7d32-5d3e-b31a-bf1601844a70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296173} {:answer/id #uuid "b29969af-ede3-53c4-a306-057c9ce68656" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296208}] :answer-field/correct {:answer/id #uuid "ac13f248-7d32-5d3e-b31a-bf1601844a70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296173} :answer-field/id #uuid "7f35bb0c-6a4b-5fe9-b22b-03be76e5104e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296892}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fa16c83a-9f14-57ce-8cd3-45bb3a59d16f" :question/math-academy-id "q-31480" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={4}^{x}+2.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={4}^{x}\\operatorname{ln}⁡4\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u={4}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x & =\\int \\frac{1}{{4}^{x}+2}\\cdot {4}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|{4}^{x}+2|+C \\\\  & =\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${4}^{x}+2>0$ for all $x.$"} {:db/id #edb/ref 17592186332748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027a07ce-3cfe-56e8-be37-2a1cb12f5c96" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{({e}^{x}+4)^{5}}+C" :db/id #edb/ref 17592186329985} {:answer/id #uuid "21d26b82-340b-5005-b15b-4c394deda50e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186330239} {:answer/id #uuid "34f46ff9-bbb8-5507-929a-8bf833e4a41a" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186330415} {:answer/id #uuid "b30e1c0f-e528-5e60-ac58-17f053cef19d" :answer/type {:db/ident :answer.type/math} :answer/value "10\\sqrt[3]{({e}^{x}+4)^{2}}+C" :db/id #edb/ref 17592186331531} {:answer/id #uuid "c31f2fe7-9fe8-531c-bb86-82e9bb1e9492" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186331685}] :answer-field/correct {:answer/id #uuid "c31f2fe7-9fe8-531c-bb86-82e9bb1e9492" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186331685} :answer-field/id #uuid "18e0a5f1-7890-529c-b7ba-c46e029335b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332236}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2a94e796-17ea-59f0-8634-ea54546ad51c" :question/math-academy-id "q-49577" :question/problem "Calculate the integral $$\n\\displaystyle \\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u={e}^{x}+4.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,⟹\\,\\text{d}u={e}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x & =5\\int \\sqrt{{e}^{x}+4}\\cdot {e}^{x}\\,\\text{d}x \\\\  & =5\\int \\sqrt{u}\\,\\text{d}u \\\\  & =5\\int {u}^{1/2}\\,\\text{d}u \\\\  & =5\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{10}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85fd39-fb12-5fd0-84ca-1f9410fd86c2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186339238} {:answer/id #uuid "35d01e19-8df6-5a98-9a4e-a13ff45e59c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186339607} {:answer/id #uuid "ba62682b-6375-50c8-ab0e-ae65ecff8935" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186340799} {:answer/id #uuid "f040dd33-55b8-577d-b65c-882719ad8257" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\operatorname{ln}⁡2}\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186341244} {:answer/id #uuid "fbec05e7-3328-5ebb-a6b8-92e98b6e67b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186341354}] :answer-field/correct {:answer/id #uuid "ba62682b-6375-50c8-ab0e-ae65ecff8935" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186340799} :answer-field/id #uuid "9475f005-9702-55df-8eb5-e3d9087d1fde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341643}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4d8e2bdb-04c0-5bb8-8174-6e672a971ff9" :question/math-academy-id "q-73669" :question/problem "Calculate the integral $$\n\\displaystyle \\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u={2}^{x}-5.$ Differentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={2}^{x}\\operatorname{ln}⁡2\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u={2}^{x}\\,\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x & =\\int 2\\cdot {2}^{x}\\sqrt{{2}^{x}-5}\\,\\text{d}x \\\\  & =2\\int \\sqrt{{2}^{x}-5}\\cdot {2}^{x}\\,\\text{d}x \\\\  & =2\\int \\sqrt{u}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{{u}^{3/2}}{\\left(\\frac{3}{2}\\right)}+C \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186608168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f888669-2477-534b-93c1-14dd41a1467c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{e}^{z}+1}+C" :db/id #edb/ref 17592186607822} {:answer/id #uuid "8a28e55e-aa6e-55ec-9c6f-983a66c3f811" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{{e}^{z}+1}+C" :db/id #edb/ref 17592186607968} {:answer/id #uuid "a422661a-62b6-548f-99fb-b5e248bf15ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{{e}^{z}+1}}+C" :db/id #edb/ref 17592186607999} {:answer/id #uuid "dd7625c3-f004-5df2-addc-77e2835786c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{e}^{z}+2}+C" :db/id #edb/ref 17592186608048} {:answer/id #uuid "ef774d49-b81e-572f-9499-ca77b619a297" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{e}^{z}+1}+C" :db/id #edb/ref 17592186608069}] :answer-field/correct {:answer/id #uuid "0f888669-2477-534b-93c1-14dd41a1467c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{e}^{z}+1}+C" :db/id #edb/ref 17592186607822} :answer-field/id #uuid "060253c5-cf85-5b59-9850-bd847d9b4cdb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608091}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "14a57d7f-2f51-563e-9400-c8274f6aaa38" :question/math-academy-id "q-49574" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\frac{{e}^{z}}{\\sqrt{{e}^{z}+1}}\\,\\text{d}z.\n$$" :question/worked-solution "Let's introduce the new variable $u={e}^{z}+1.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}z}={e}^{z}\\,⟹\\,\\text{d}u={e}^{z}\\,\\text{d}z.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{e}^{z}}{\\sqrt{{e}^{z}+1}}\\,\\text{d}z & =\\int \\frac{1}{\\sqrt{{e}^{z}+1}}\\cdot {e}^{z}\\,\\text{d}z \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =\\frac{{u}^{1/2}}{\\left(\\frac{1}{2}\\right)}+C \\\\  & =2\\sqrt{{e}^{z}+1}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186608178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34c67ac0-41e8-5678-8336-d0107e58afba" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡|2-{6}^{x}|}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186607865} {:answer/id #uuid "4d4864b2-2c2f-57f4-956b-9433730346bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|2-{6}^{x}|}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186607904} {:answer/id #uuid "70f388a5-6722-5425-b634-fd9fcace933e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡|2-{6}^{x}|}{6\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186607939} {:answer/id #uuid "7e2d864c-a850-55c1-893b-e69551329f80" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\operatorname{ln}⁡|2-{6}^{x}|+C" :db/id #edb/ref 17592186607958} {:answer/id #uuid "8f824d94-ffac-51cd-ade0-eac66ce2397f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6\\operatorname{ln}⁡|2-{6}^{x}|}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186607971}] :answer-field/correct {:answer/id #uuid "34c67ac0-41e8-5678-8336-d0107e58afba" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡|2-{6}^{x}|}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186607865} :answer-field/id #uuid "be0455fc-1523-58f5-9e10-d164fbc5cf2a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608146}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "35f0c1cb-49ca-5544-8236-0e4cefc5c8cd" :question/math-academy-id "q-113875" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\frac{{6}^{x}}{2-{6}^{x}}\\,\\text{d}x.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u=2-{6}^{x}.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-{6}^{x}\\operatorname{ln}⁡6\\,⟹\\,-\\frac{1}{\\operatorname{ln}⁡6}\\,\\text{d}u={6}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{6}^{x}}{2-{6}^{x}}\\,\\text{d}x & =\\int \\frac{1}{2-{6}^{x}}\\cdot {6}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\left(-\\frac{1}{\\operatorname{ln}⁡6}\\right)\\text{d}u \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{\\operatorname{ln}⁡|2-{6}^{x}|}{\\operatorname{ln}⁡6}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186627685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab0391c-aba7-5b4b-b924-823a0ecf8ef0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{2}^{2-3{x}^{2}}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186627112} {:answer/id #uuid "282c73af-4464-5ea1-be06-b83bdc954507" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{2}^{1-3{x}^{3}}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186627163} {:answer/id #uuid "64b77f22-9abf-56fe-8cb2-efe9fed08e09" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\cdot {2}^{3-3{x}^{3}}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186627264} {:answer/id #uuid "7516a0db-3848-55de-b5a0-79b72e92b866" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{2}^{1-3{x}^{3}}}{3\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186627290} {:answer/id #uuid "bef4977f-efe8-5b57-8f0e-155b8d88345f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{2}^{3-3{x}^{3}}}{3\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186627409}] :answer-field/correct {:answer/id #uuid "bef4977f-efe8-5b57-8f0e-155b8d88345f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{2}^{3-3{x}^{3}}}{3\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186627409} :answer-field/id #uuid "84fca298-420b-5070-8302-520084591405" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186627601}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "45b28540-4478-5f51-a0e6-dbeb90f3ba88" :question/math-academy-id "q-73666" :question/problem "Calculate the integral $$\n\\displaystyle \\int 6{x}^{2}\\,{2}^{2-3{x}^{3}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=2-3{x}^{3}.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-9{x}^{2}\\,⟹\\,-\\frac{1}{9}\\,\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 6{x}^{2}\\,{2}^{2-3{x}^{3}}\\,\\text{d}x & =6\\int {2}^{2-3{x}^{3}}\\,\\cdot {x}^{2}\\,\\text{d}x \\\\  & =6\\int {2}^{u}\\cdot \\left(-\\frac{1}{9}\\right)\\,\\text{d}u \\\\  & =-\\frac{2}{3}\\int {2}^{u}\\,\\text{d}u \\\\  & =-\\frac{2}{3}\\cdot \\frac{{2}^{u}}{\\operatorname{ln}⁡2}+C \\\\  & =-\\frac{{2}^{1}\\cdot {2}^{2-3{x}^{3}}}{3\\operatorname{ln}⁡2}+C \\\\  & =-\\frac{{2}^{3-3{x}^{3}}}{3\\operatorname{ln}⁡2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186664062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70a9e400-9f93-57ab-9a14-7ffb9d25e219" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡({3}^{x+1}+1)}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186663694} {:answer/id #uuid "ac6d1d4d-fceb-50d0-b5e6-abfc0eb65dde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡({3}^{x}+1)}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186663796} {:answer/id #uuid "ba253305-8757-572e-8b4a-4c6a6d188d9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({3}^{x}+1)}{3}+C" :db/id #edb/ref 17592186663821} {:answer/id #uuid "d9d02898-740e-54de-af62-005f64fa7dd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡({3}^{x-1}+1)}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186663879} {:answer/id #uuid "e1d58cd5-60ac-5ca2-8082-2c6c2008174d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({3}^{x}+1)}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186663890}] :answer-field/correct {:answer/id #uuid "ac6d1d4d-fceb-50d0-b5e6-abfc0eb65dde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡({3}^{x}+1)}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186663796} :answer-field/id #uuid "dbfdfb0e-1c45-5415-8a60-6b10719a32f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186664017}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "50d988aa-30cb-58ec-89a4-3a5bc9d0a71a" :question/math-academy-id "q-113872" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\frac{{3}^{x+1}}{{3}^{x}+1}\\,\\text{d}x.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={3}^{x}+1.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={3}^{x}\\operatorname{ln}⁡3\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡3}\\,\\text{d}u={3}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{3}^{x+1}}{{3}^{x}+1}\\,\\text{d}x & =\\int \\frac{1}{{3}^{x}+1}\\cdot {3}^{x+1}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{3}^{x}+1}\\cdot 3\\cdot {3}^{x}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\,\\text{d}u \\\\  & =\\frac{3}{\\operatorname{ln}⁡3}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{3\\operatorname{ln}⁡({3}^{x}+1)}{\\operatorname{ln}⁡3}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${3}^{x}+1>0$ for all $x.$"} {:db/id #edb/ref 17592186679422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 \\left(3^{x} + 4\\right)^{\\frac{3}{2}}}{3}\\right)" :db/id #edb/ref 17592186679492}] :answer-field/correct {:answer/id #uuid "ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 \\left(3^{x} + 4\\right)^{\\frac{3}{2}}}{3}\\right)" :db/id #edb/ref 17592186679492} :answer-field/id #uuid "a79080ff-3a68-56f4-bd9c-22a0870f1b37" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679490}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0156d36e-072e-5215-9c38-b10ce4b47e6d" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cdot 3^{x} \\sqrt{3^{x} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sqrt{u}\\,\\mathrm{d}u=\\frac{2 u^{\\frac{3}{2}}}{3}+C$.\n\nWork where $3^{x} + 4>0$.\n\n{{answer}} $+C$" :question/worked-solution "Let $u=3^{x} + 4$. Then $\\mathrm{d}u=(3^{x} \\ln{\\left(3 \\right)})\\,\\mathrm{d}x$.\n\nWork where $3^{x} + 4>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cdot 3^{x} \\sqrt{3^{x} + 4}\\,\\mathrm{d}x\\\\&=\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right)=\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 u^{\\frac{3}{2}}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 \\left(3^{x} + 4\\right)^{\\frac{3}{2}}}{3}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acbdbbf0-0d6c-5391-b6a4-3aee96bd807f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\int u^{2}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679494} {:answer/id #uuid "b3991143-d38e-53c7-8a27-5d190666569b" :answer/type {:db/ident :answer.type/math} :answer/value "6\\left(\\int u^{2}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679497} {:answer/id #uuid "b88134a9-93b2-53fd-add6-da3c8df3ac13" :answer/type {:db/ident :answer.type/math} :answer/value "\\int u^{2}\\,\\mathrm{d}u" :db/id #edb/ref 17592186679500} {:answer/id #uuid "cef139c2-af29-569f-97d3-211d93d5fac5" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\left(\\int u^{2}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679506} {:answer/id #uuid "eadcf2e6-93d0-589d-91c6-e568dc71f1b4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\int u^{2}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679517}] :answer-field/correct {:answer/id #uuid "eadcf2e6-93d0-589d-91c6-e568dc71f1b4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\int u^{2}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679517} :answer-field/id #uuid "178e5483-12e9-5478-82dc-be7ebb32cefe" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679432}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f15d446-4d46-574b-861e-a957a2536c10" :question/problem "Use the substitution $u=e^{2 x} + 2$. Which integral is obtained?\n\n$$\n\\int 4 \\left(e^{2 x} + 2\\right)^{2} e^{2 x}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=e^{2 x} + 2$. Then $\\mathrm{d}u=(2 e^{2 x})\\,\\mathrm{d}x$.\n\nWork where $e^{2 x} + 2>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\left(e^{2 x} + 2\\right)^{2} e^{2 x}\\,\\mathrm{d}x\\\\&=2\\left(\\int u^{2}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n2\\left(\\int u^{2}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186679430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e180d782-4de4-56af-b422-90495e9d1e10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{2^{x} + 2}\\right)" :db/id #edb/ref 17592186679514}] :answer-field/correct {:answer/id #uuid "e180d782-4de4-56af-b422-90495e9d1e10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{2^{x} + 2}\\right)" :db/id #edb/ref 17592186679514} :answer-field/id #uuid "82cc3620-0ac2-51ea-96d5-046a3c0a3a4f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679480}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "11ef6d40-0a09-58bb-8363-01217a52d0ea" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 \\cdot 2^{x}}{\\sqrt{2^{x} + 2}}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u=2 \\sqrt{u}+C$.\n\nWork where $2^{x} + 2>0$.\n\n{{answer}} $+C$" :question/worked-solution "Let $u=2^{x} + 2$. Then $\\mathrm{d}u=(2^{x} \\ln{\\left(2 \\right)})\\,\\mathrm{d}x$.\n\nWork where $2^{x} + 2>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 \\cdot 2^{x}}{\\sqrt{2^{x} + 2}}\\,\\mathrm{d}x\\\\&=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right)=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{2^{x} + 2}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left|2 x + e^{2 x} + 4\\right|" :db/id #edb/ref 17592186679467}] :answer-field/correct {:answer/id #uuid "6af84686-d09b-5aa3-ae4a-19ceb28d8a0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left|2 x + e^{2 x} + 4\\right|" :db/id #edb/ref 17592186679467} :answer-field/id #uuid "dcf91abd-7972-5cdd-a9d1-a1b544bbffff" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679511}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$" :question/worked-solution "Let $u=2 x + e^{2 x} + 4$. Then $\\mathrm{d}u=(2 e^{2 x} + 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nSubstitute back:\n\n$$\n\\ln\\left|2 x + e^{2 x} + 4\\right|+C.\n$$"} {:db/id #edb/ref 17592186679439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8ce16e4-e6e9-5770-bd52-c528f41d4c34" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\ln\\left|e^{x} + 1\\right|\\right)" :db/id #edb/ref 17592186679509}] :answer-field/correct {:answer/id #uuid "d8ce16e4-e6e9-5770-bd52-c528f41d4c34" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\ln\\left|e^{x} + 1\\right|\\right)" :db/id #edb/ref 17592186679509} :answer-field/id #uuid "e044980f-df8c-5ebc-9aab-7e314954a789" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679513}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "234b841b-ddf2-5537-9f3b-c343ab766392" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$" :question/worked-solution "Let $u=e^{x} + 1$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=4\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\ln\\left|e^{x} + 1\\right|\\right)+C.\n$$"} {:db/id #edb/ref 17592186679440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e228d92-8e66-55f1-83eb-fa5d97e219e1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\ln\\left|x + e^{x} + 3\\right|\\right)" :db/id #edb/ref 17592186679443}] :answer-field/correct {:answer/id #uuid "2e228d92-8e66-55f1-83eb-fa5d97e219e1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\ln\\left|x + e^{x} + 3\\right|\\right)" :db/id #edb/ref 17592186679443} :answer-field/id #uuid "309b896d-0ed4-573b-ae38-151b2a7fd9ba" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679444}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "24ac3e9f-c431-5dd9-aaf4-0785964f442b" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 e^{x} + 2}{x + e^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$" :question/worked-solution "Let $u=x + e^{x} + 3$. Then $\\mathrm{d}u=(e^{x} + 1)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 e^{x} + 2}{x + e^{x} + 3}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\r