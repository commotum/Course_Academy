[[:db/add "7a0df22d-2c7c-5778-875d-d7e3c17f496b" :answer/id #uuid "7a0df22d-2c7c-5778-875d-d7e3c17f496b"] [:db/add "7a0df22d-2c7c-5778-875d-d7e3c17f496b" :answer/type :answer.type/math] [:db/add "7a0df22d-2c7c-5778-875d-d7e3c17f496b" :answer/value "\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 \\left(3^{x} + 4\\right)^{\\frac{3}{2}}}{3}\\right)"] [:db/ensure "7a0df22d-2c7c-5778-875d-d7e3c17f496b" :answer/validate] [:db/add "57ddf01a-f4b7-53a2-beda-c85868fc3d10" :answer-field/id #uuid "57ddf01a-f4b7-53a2-beda-c85868fc3d10"] [:db/add "57ddf01a-f4b7-53a2-beda-c85868fc3d10" :answer-field/key "answer"] [:db/add "57ddf01a-f4b7-53a2-beda-c85868fc3d10" :answer-field/type :answer-field.type/blank] [:db/add "57ddf01a-f4b7-53a2-beda-c85868fc3d10" :answer-field/choices "7a0df22d-2c7c-5778-875d-d7e3c17f496b"] [:db/add "57ddf01a-f4b7-53a2-beda-c85868fc3d10" :answer-field/correct "7a0df22d-2c7c-5778-875d-d7e3c17f496b"] [:db/ensure "57ddf01a-f4b7-53a2-beda-c85868fc3d10" :answer-field/validate] [:db/add "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166" :question/id #uuid "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166"] [:db/add "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cdot 3^{x} \\sqrt{3^{x} + 4}\\,\\mathrm{d}x\n$$\n\nWork where $3^{x} + 4>0$.\n\n{{answer}} $+C$"] [:db/add "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166" :question/worked-solution "Let $u=3^{x} + 4$. Then $\\mathrm{d}u=(3^{x} \\ln{\\left(3 \\right)})\\,\\mathrm{d}x$.\n\nWork where $3^{x} + 4>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cdot 3^{x} \\sqrt{3^{x} + 4}\\,\\mathrm{d}x\\\\&=\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\sqrt{u}\\,\\mathrm{d}u=\\frac{2 u^{\\frac{3}{2}}}{3}+C.\n$$\n\n$$\n\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right)=\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 u^{\\frac{3}{2}}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{\\ln{\\left(3 \\right)}}\\left(\\frac{2 \\left(3^{x} + 4\\right)^{\\frac{3}{2}}}{3}\\right)+C.\n$$"] [:db/add "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166" :question/difficulty :question.difficulty/moderate] [:db/add "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166" :question/answer-fields "57ddf01a-f4b7-53a2-beda-c85868fc3d10"] [:db/ensure "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166"] [:db/add "bc6c2ae8-6b02-559c-85bd-c3849fdd5eba" :answer/id #uuid "bc6c2ae8-6b02-559c-85bd-c3849fdd5eba"] [:db/add "bc6c2ae8-6b02-559c-85bd-c3849fdd5eba" :answer/type :answer.type/math] [:db/add "bc6c2ae8-6b02-559c-85bd-c3849fdd5eba" :answer/value "\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 2\\right|\\right)"] [:db/ensure "bc6c2ae8-6b02-559c-85bd-c3849fdd5eba" :answer/validate] [:db/add "15c1212f-262c-5037-99c0-082ac53c1a70" :answer-field/id #uuid "15c1212f-262c-5037-99c0-082ac53c1a70"] [:db/add "15c1212f-262c-5037-99c0-082ac53c1a70" :answer-field/key "answer"] [:db/add "15c1212f-262c-5037-99c0-082ac53c1a70" :answer-field/type :answer-field.type/blank] [:db/add "15c1212f-262c-5037-99c0-082ac53c1a70" :answer-field/choices "bc6c2ae8-6b02-559c-85bd-c3849fdd5eba"] [:db/add "15c1212f-262c-5037-99c0-082ac53c1a70" :answer-field/correct "bc6c2ae8-6b02-559c-85bd-c3849fdd5eba"] [:db/ensure "15c1212f-262c-5037-99c0-082ac53c1a70" :answer-field/validate] [:db/add "c46741f4-bd53-5442-a723-dfe845118a09" :question/id #uuid "c46741f4-bd53-5442-a723-dfe845118a09"] [:db/add "c46741f4-bd53-5442-a723-dfe845118a09" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 \\cdot 5^{x}}{5^{x} + 2}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "c46741f4-bd53-5442-a723-dfe845118a09" :question/worked-solution "Let $u=5^{x} + 2$. Then $\\mathrm{d}u=(5^{x} \\ln{\\left(5 \\right)})\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 \\cdot 5^{x}}{5^{x} + 2}\\,\\mathrm{d}x\\\\&=\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 2\\right|\\right)+C.\n$$"] [:db/add "c46741f4-bd53-5442-a723-dfe845118a09" :question/difficulty :question.difficulty/moderate] [:db/add "c46741f4-bd53-5442-a723-dfe845118a09" :question/answer-fields "15c1212f-262c-5037-99c0-082ac53c1a70"] [:db/ensure "c46741f4-bd53-5442-a723-dfe845118a09" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "c46741f4-bd53-5442-a723-dfe845118a09"] [:db/add "6c1b9b3d-d58f-5014-851d-aa6f45245706" :answer/id #uuid "6c1b9b3d-d58f-5014-851d-aa6f45245706"] [:db/add "6c1b9b3d-d58f-5014-851d-aa6f45245706" :answer/type :answer.type/math] [:db/add "6c1b9b3d-d58f-5014-851d-aa6f45245706" :answer/value "4\\left(\\ln\\left|e^{x} + 1\\right|\\right)"] [:db/ensure "6c1b9b3d-d58f-5014-851d-aa6f45245706" :answer/validate] [:db/add "894a01d5-14e3-54d8-9af8-ce0275f9c54e" :answer-field/id #uuid "894a01d5-14e3-54d8-9af8-ce0275f9c54e"] [:db/add "894a01d5-14e3-54d8-9af8-ce0275f9c54e" :answer-field/key "answer"] [:db/add "894a01d5-14e3-54d8-9af8-ce0275f9c54e" :answer-field/type :answer-field.type/blank] [:db/add "894a01d5-14e3-54d8-9af8-ce0275f9c54e" :answer-field/choices "6c1b9b3d-d58f-5014-851d-aa6f45245706"] [:db/add "894a01d5-14e3-54d8-9af8-ce0275f9c54e" :answer-field/correct "6c1b9b3d-d58f-5014-851d-aa6f45245706"] [:db/ensure "894a01d5-14e3-54d8-9af8-ce0275f9c54e" :answer-field/validate] [:db/add "211ce25f-f7ca-5657-b57d-eb90788744d1" :question/id #uuid "211ce25f-f7ca-5657-b57d-eb90788744d1"] [:db/add "211ce25f-f7ca-5657-b57d-eb90788744d1" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "211ce25f-f7ca-5657-b57d-eb90788744d1" :question/worked-solution "Let $u=e^{x} + 1$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=4\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\ln\\left|e^{x} + 1\\right|\\right)+C.\n$$"] [:db/add "211ce25f-f7ca-5657-b57d-eb90788744d1" :question/difficulty :question.difficulty/moderate] [:db/add "211ce25f-f7ca-5657-b57d-eb90788744d1" :question/answer-fields "894a01d5-14e3-54d8-9af8-ce0275f9c54e"] [:db/ensure "211ce25f-f7ca-5657-b57d-eb90788744d1" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "211ce25f-f7ca-5657-b57d-eb90788744d1"] [:db/add "905fd618-c8e5-5066-9095-4c108ed45416" :answer/id #uuid "905fd618-c8e5-5066-9095-4c108ed45416"] [:db/add "905fd618-c8e5-5066-9095-4c108ed45416" :answer/type :answer.type/math] [:db/add "905fd618-c8e5-5066-9095-4c108ed45416" :answer/value "2\\left(\\frac{2 \\left(e^{2 x} + 1\\right)^{\\frac{3}{2}}}{3}\\right)"] [:db/ensure "905fd618-c8e5-5066-9095-4c108ed45416" :answer/validate] [:db/add "e7828fb5-201a-567d-8d5e-f194a1d7b755" :answer-field/id #uuid "e7828fb5-201a-567d-8d5e-f194a1d7b755"] [:db/add "e7828fb5-201a-567d-8d5e-f194a1d7b755" :answer-field/key "answer"] [:db/add "e7828fb5-201a-567d-8d5e-f194a1d7b755" :answer-field/type :answer-field.type/blank] [:db/add "e7828fb5-201a-567d-8d5e-f194a1d7b755" :answer-field/choices "905fd618-c8e5-5066-9095-4c108ed45416"] [:db/add "e7828fb5-201a-567d-8d5e-f194a1d7b755" :answer-field/correct "905fd618-c8e5-5066-9095-4c108ed45416"] [:db/ensure "e7828fb5-201a-567d-8d5e-f194a1d7b755" :answer-field/validate] [:db/add "12253e43-2776-5ace-9c3a-7db8b22905e1" :question/id #uuid "12253e43-2776-5ace-9c3a-7db8b22905e1"] [:db/add "12253e43-2776-5ace-9c3a-7db8b22905e1" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\sqrt{e^{2 x} + 1} e^{2 x}\\,\\mathrm{d}x\n$$\n\nWork where $e^{2 x} + 1>0$.\n\n{{answer}} $+C$"] [:db/add "12253e43-2776-5ace-9c3a-7db8b22905e1" :question/worked-solution "Let $u=e^{2 x} + 1$. Then $\\mathrm{d}u=(2 e^{2 x})\\,\\mathrm{d}x$.\n\nWork where $e^{2 x} + 1>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\sqrt{e^{2 x} + 1} e^{2 x}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\sqrt{u}\\,\\mathrm{d}u=\\frac{2 u^{\\frac{3}{2}}}{3}+C.\n$$\n\n$$\n2\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right)=2\\left(\\frac{2 u^{\\frac{3}{2}}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\frac{2 \\left(e^{2 x} + 1\\right)^{\\frac{3}{2}}}{3}\\right)+C.\n$$"] [:db/add "12253e43-2776-5ace-9c3a-7db8b22905e1" :question/difficulty :question.difficulty/moderate] [:db/add "12253e43-2776-5ace-9c3a-7db8b22905e1" :question/answer-fields "e7828fb5-201a-567d-8d5e-f194a1d7b755"] [:db/ensure "12253e43-2776-5ace-9c3a-7db8b22905e1" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "12253e43-2776-5ace-9c3a-7db8b22905e1"] [:db/add "2e9d78fb-a66d-5f27-8397-38c25eadc86e" :answer/id #uuid "2e9d78fb-a66d-5f27-8397-38c25eadc86e"] [:db/add "2e9d78fb-a66d-5f27-8397-38c25eadc86e" :answer/type :answer.type/math] [:db/add "2e9d78fb-a66d-5f27-8397-38c25eadc86e" :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{2^{x} + 2}\\right)"] [:db/ensure "2e9d78fb-a66d-5f27-8397-38c25eadc86e" :answer/validate] [:db/add "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32" :answer-field/id #uuid "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32"] [:db/add "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32" :answer-field/key "answer"] [:db/add "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32" :answer-field/type :answer-field.type/blank] [:db/add "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32" :answer-field/choices "2e9d78fb-a66d-5f27-8397-38c25eadc86e"] [:db/add "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32" :answer-field/correct "2e9d78fb-a66d-5f27-8397-38c25eadc86e"] [:db/ensure "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32" :answer-field/validate] [:db/add "c8da8569-d026-552c-bc62-7ded1a3b3820" :question/id #uuid "c8da8569-d026-552c-bc62-7ded1a3b3820"] [:db/add "c8da8569-d026-552c-bc62-7ded1a3b3820" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 \\cdot 2^{x}}{\\sqrt{2^{x} + 2}}\\,\\mathrm{d}x\n$$\n\nWork where $2^{x} + 2>0$.\n\n{{answer}} $+C$"] [:db/add "c8da8569-d026-552c-bc62-7ded1a3b3820" :question/worked-solution "Let $u=2^{x} + 2$. Then $\\mathrm{d}u=(2^{x} \\ln{\\left(2 \\right)})\\,\\mathrm{d}x$.\n\nWork where $2^{x} + 2>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 \\cdot 2^{x}}{\\sqrt{2^{x} + 2}}\\,\\mathrm{d}x\\\\&=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u=2 \\sqrt{u}+C.\n$$\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right)=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}\\left(2 \\sqrt{2^{x} + 2}\\right)+C.\n$$"] [:db/add "c8da8569-d026-552c-bc62-7ded1a3b3820" :question/difficulty :question.difficulty/moderate] [:db/add "c8da8569-d026-552c-bc62-7ded1a3b3820" :question/answer-fields "aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32"] [:db/ensure "c8da8569-d026-552c-bc62-7ded1a3b3820" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "c8da8569-d026-552c-bc62-7ded1a3b3820"] [:db/add "b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9" :answer/id #uuid "b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9"] [:db/add "b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9" :answer/type :answer.type/math] [:db/add "b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9" :answer/value "3\\left(2 \\sqrt{e^{x} + 3}\\right)"] [:db/ensure "b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9" :answer/validate] [:db/add "22edb980-938e-55ae-b15d-f2cc64be9e01" :answer-field/id #uuid "22edb980-938e-55ae-b15d-f2cc64be9e01"] [:db/add "22edb980-938e-55ae-b15d-f2cc64be9e01" :answer-field/key "answer"] [:db/add "22edb980-938e-55ae-b15d-f2cc64be9e01" :answer-field/type :answer-field.type/blank] [:db/add "22edb980-938e-55ae-b15d-f2cc64be9e01" :answer-field/choices "b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9"] [:db/add "22edb980-938e-55ae-b15d-f2cc64be9e01" :answer-field/correct "b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9"] [:db/ensure "22edb980-938e-55ae-b15d-f2cc64be9e01" :answer-field/validate] [:db/add "bad594e9-e3ea-5f37-bed8-7498761a9628" :question/id #uuid "bad594e9-e3ea-5f37-bed8-7498761a9628"] [:db/add "bad594e9-e3ea-5f37-bed8-7498761a9628" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 e^{x}}{\\sqrt{e^{x} + 3}}\\,\\mathrm{d}x\n$$\n\nWork where $e^{x} + 3>0$.\n\n{{answer}} $+C$"] [:db/add "bad594e9-e3ea-5f37-bed8-7498761a9628" :question/worked-solution "Let $u=e^{x} + 3$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nWork where $e^{x} + 3>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 e^{x}}{\\sqrt{e^{x} + 3}}\\,\\mathrm{d}x\\\\&=3\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u=2 \\sqrt{u}+C.\n$$\n\n$$\n3\\left(\\int \\frac{1}{\\sqrt{u}}\\,\\mathrm{d}u\\right)=3\\left(2 \\sqrt{u}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n3\\left(2 \\sqrt{e^{x} + 3}\\right)+C.\n$$"] [:db/add "bad594e9-e3ea-5f37-bed8-7498761a9628" :question/difficulty :question.difficulty/moderate] [:db/add "bad594e9-e3ea-5f37-bed8-7498761a9628" :question/answer-fields "22edb980-938e-55ae-b15d-f2cc64be9e01"] [:db/ensure "bad594e9-e3ea-5f37-bed8-7498761a9628" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "bad594e9-e3ea-5f37-bed8-7498761a9628"] [:db/add "c1d6dfca-33d1-50d5-b39f-f1e01fad43d5" :answer/id #uuid "c1d6dfca-33d1-50d5-b39f-f1e01fad43d5"] [:db/add "c1d6dfca-33d1-50d5-b39f-f1e01fad43d5" :answer/type :answer.type/math] [:db/add "c1d6dfca-33d1-50d5-b39f-f1e01fad43d5" :answer/value "\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\frac{2 \\left(2^{x} + 3\\right)^{\\frac{3}{2}}}{3}\\right)"] [:db/ensure "c1d6dfca-33d1-50d5-b39f-f1e01fad43d5" :answer/validate] [:db/add "f24f102d-1558-5840-92f0-bf6b8e16f958" :answer-field/id #uuid "f24f102d-1558-5840-92f0-bf6b8e16f958"] [:db/add "f24f102d-1558-5840-92f0-bf6b8e16f958" :answer-field/key "answer"] [:db/add "f24f102d-1558-5840-92f0-bf6b8e16f958" :answer-field/type :answer-field.type/blank] [:db/add "f24f102d-1558-5840-92f0-bf6b8e16f958" :answer-field/choices "c1d6dfca-33d1-50d5-b39f-f1e01fad43d5"] [:db/add "f24f102d-1558-5840-92f0-bf6b8e16f958" :answer-field/correct "c1d6dfca-33d1-50d5-b39f-f1e01fad43d5"] [:db/ensure "f24f102d-1558-5840-92f0-bf6b8e16f958" :answer-field/validate] [:db/add "1521ff74-6088-5fc8-ba62-bf6953ac95be" :question/id #uuid "1521ff74-6088-5fc8-ba62-bf6953ac95be"] [:db/add "1521ff74-6088-5fc8-ba62-bf6953ac95be" :question/problem "Find an antiderivative.\n\n$$\n\\int 2^{x} \\sqrt{2^{x} + 3}\\,\\mathrm{d}x\n$$\n\nWork where $2^{x} + 3>0$.\n\n{{answer}} $+C$"] [:db/add "1521ff74-6088-5fc8-ba62-bf6953ac95be" :question/worked-solution "Let $u=2^{x} + 3$. Then $\\mathrm{d}u=(2^{x} \\ln{\\left(2 \\right)})\\,\\mathrm{d}x$.\n\nWork where $2^{x} + 3>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2^{x} \\sqrt{2^{x} + 3}\\,\\mathrm{d}x\\\\&=\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\sqrt{u}\\,\\mathrm{d}u=\\frac{2 u^{\\frac{3}{2}}}{3}+C.\n$$\n\n$$\n\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\int \\sqrt{u}\\,\\mathrm{d}u\\right)=\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\frac{2 u^{\\frac{3}{2}}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{\\ln{\\left(2 \\right)}}\\left(\\frac{2 \\left(2^{x} + 3\\right)^{\\frac{3}{2}}}{3}\\right)+C.\n$$"] [:db/add "1521ff74-6088-5fc8-ba62-bf6953ac95be" :question/difficulty :question.difficulty/moderate] [:db/add "1521ff74-6088-5fc8-ba62-bf6953ac95be" :question/answer-fields "f24f102d-1558-5840-92f0-bf6b8e16f958"] [:db/ensure "1521ff74-6088-5fc8-ba62-bf6953ac95be" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "1521ff74-6088-5fc8-ba62-bf6953ac95be"] [:db/add "600ba5d3-5c66-55d6-947c-678d4ea14e35" :answer/id #uuid "600ba5d3-5c66-55d6-947c-678d4ea14e35"] [:db/add "600ba5d3-5c66-55d6-947c-678d4ea14e35" :answer/type :answer.type/math] [:db/add "600ba5d3-5c66-55d6-947c-678d4ea14e35" :answer/value "\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 4\\right|\\right)"] [:db/ensure "600ba5d3-5c66-55d6-947c-678d4ea14e35" :answer/validate] [:db/add "7396ae79-8338-5f0d-a117-94c48fe7b2d2" :answer-field/id #uuid "7396ae79-8338-5f0d-a117-94c48fe7b2d2"] [:db/add "7396ae79-8338-5f0d-a117-94c48fe7b2d2" :answer-field/key "answer"] [:db/add "7396ae79-8338-5f0d-a117-94c48fe7b2d2" :answer-field/type :answer-field.type/blank] [:db/add "7396ae79-8338-5f0d-a117-94c48fe7b2d2" :answer-field/choices "600ba5d3-5c66-55d6-947c-678d4ea14e35"] [:db/add "7396ae79-8338-5f0d-a117-94c48fe7b2d2" :answer-field/correct "600ba5d3-5c66-55d6-947c-678d4ea14e35"] [:db/ensure "7396ae79-8338-5f0d-a117-94c48fe7b2d2" :answer-field/validate] [:db/add "7cc50af0-d932-5993-9c02-08c5170a567c" :question/id #uuid "7cc50af0-d932-5993-9c02-08c5170a567c"] [:db/add "7cc50af0-d932-5993-9c02-08c5170a567c" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{5^{x}}{5^{x} + 4}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "7cc50af0-d932-5993-9c02-08c5170a567c" :question/worked-solution "Let $u=5^{x} + 4$. Then $\\mathrm{d}u=(5^{x} \\ln{\\left(5 \\right)})\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{5^{x}}{5^{x} + 4}\\,\\mathrm{d}x\\\\&=\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{\\ln{\\left(5 \\right)}}\\left(\\ln\\left|5^{x} + 4\\right|\\right)+C.\n$$"] [:db/add "7cc50af0-d932-5993-9c02-08c5170a567c" :question/difficulty :question.difficulty/moderate] [:db/add "7cc50af0-d932-5993-9c02-08c5170a567c" :question/answer-fields "7396ae79-8338-5f0d-a117-94c48fe7b2d2"] [:db/ensure "7cc50af0-d932-5993-9c02-08c5170a567c" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "7cc50af0-d932-5993-9c02-08c5170a567c"] [:db/add "6f3aba44-26b5-56d5-b2f5-790ffdc2057f" :answer/id #uuid "6f3aba44-26b5-56d5-b2f5-790ffdc2057f"] [:db/add "6f3aba44-26b5-56d5-b2f5-790ffdc2057f" :answer/type :answer.type/math] [:db/add "6f3aba44-26b5-56d5-b2f5-790ffdc2057f" :answer/value "\\frac{3}{2}\\left(\\ln\\left|2 x + e^{2 x} + 1\\right|\\right)"] [:db/ensure "6f3aba44-26b5-56d5-b2f5-790ffdc2057f" :answer/validate] [:db/add "d02975e3-0018-5782-9574-68ecc479127a" :answer-field/id #uuid "d02975e3-0018-5782-9574-68ecc479127a"] [:db/add "d02975e3-0018-5782-9574-68ecc479127a" :answer-field/key "answer"] [:db/add "d02975e3-0018-5782-9574-68ecc479127a" :answer-field/type :answer-field.type/blank] [:db/add "d02975e3-0018-5782-9574-68ecc479127a" :answer-field/choices "6f3aba44-26b5-56d5-b2f5-790ffdc2057f"] [:db/add "d02975e3-0018-5782-9574-68ecc479127a" :answer-field/correct "6f3aba44-26b5-56d5-b2f5-790ffdc2057f"] [:db/ensure "d02975e3-0018-5782-9574-68ecc479127a" :answer-field/validate] [:db/add "b52c3c92-6c98-5f45-940c-2c918ff5aeb4" :question/id #uuid "b52c3c92-6c98-5f45-940c-2c918ff5aeb4"] [:db/add "b52c3c92-6c98-5f45-940c-2c918ff5aeb4" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "b52c3c92-6c98-5f45-940c-2c918ff5aeb4" :question/worked-solution "Let $u=2 x + e^{2 x} + 1$. Then $\\mathrm{d}u=(2 e^{2 x} + 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n\\frac{3}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{3}{2}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3}{2}\\left(\\ln\\left|2 x + e^{2 x} + 1\\right|\\right)+C.\n$$"] [:db/add "b52c3c92-6c98-5f45-940c-2c918ff5aeb4" :question/difficulty :question.difficulty/hard] [:db/add "b52c3c92-6c98-5f45-940c-2c918ff5aeb4" :question/answer-fields "d02975e3-0018-5782-9574-68ecc479127a"] [:db/ensure "b52c3c92-6c98-5f45-940c-2c918ff5aeb4" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "b52c3c92-6c98-5f45-940c-2c918ff5aeb4"] [:db/add "7c5bab19-6161-5101-a165-18a3ffd01325" :answer/id #uuid "7c5bab19-6161-5101-a165-18a3ffd01325"] [:db/add "7c5bab19-6161-5101-a165-18a3ffd01325" :answer/type :answer.type/math] [:db/add "7c5bab19-6161-5101-a165-18a3ffd01325" :answer/value "2\\left(\\ln\\left|x + e^{x} + 3\\right|\\right)"] [:db/ensure "7c5bab19-6161-5101-a165-18a3ffd01325" :answer/validate] [:db/add "09bb2350-c5bd-522f-95e8-6f15ab48eec3" :answer-field/id #uuid "09bb2350-c5bd-522f-95e8-6f15ab48eec3"] [:db/add "09bb2350-c5bd-522f-95e8-6f15ab48eec3" :answer-field/key "answer"] [:db/add "09bb2350-c5bd-522f-95e8-6f15ab48eec3" :answer-field/type :answer-field.type/blank] [:db/add "09bb2350-c5bd-522f-95e8-6f15ab48eec3" :answer-field/choices "7c5bab19-6161-5101-a165-18a3ffd01325"] [:db/add "09bb2350-c5bd-522f-95e8-6f15ab48eec3" :answer-field/correct "7c5bab19-6161-5101-a165-18a3ffd01325"] [:db/ensure "09bb2350-c5bd-522f-95e8-6f15ab48eec3" :answer-field/validate] [:db/add "bf388ce7-7f54-566c-b013-28bd33cfcead" :question/id #uuid "bf388ce7-7f54-566c-b013-28bd33cfcead"] [:db/add "bf388ce7-7f54-566c-b013-28bd33cfcead" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 e^{x} + 2}{x + e^{x} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "bf388ce7-7f54-566c-b013-28bd33cfcead" :question/worked-solution "Let $u=x + e^{x} + 3$. Then $\\mathrm{d}u=(e^{x} + 1)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 e^{x} + 2}{x + e^{x} + 3}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=2\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\ln\\left|x + e^{x} + 3\\right|\\right)+C.\n$$"] [:db/add "bf388ce7-7f54-566c-b013-28bd33cfcead" :question/difficulty :question.difficulty/hard] [:db/add "bf388ce7-7f54-566c-b013-28bd33cfcead" :question/answer-fields "09bb2350-c5bd-522f-95e8-6f15ab48eec3"] [:db/ensure "bf388ce7-7f54-566c-b013-28bd33cfcead" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "bf388ce7-7f54-566c-b013-28bd33cfcead"] [:db/add "49a9b07a-8101-5daa-9dc0-f2b02b07afba" :answer/id #uuid "49a9b07a-8101-5daa-9dc0-f2b02b07afba"] [:db/add "49a9b07a-8101-5daa-9dc0-f2b02b07afba" :answer/type :answer.type/math] [:db/add "49a9b07a-8101-5daa-9dc0-f2b02b07afba" :answer/value "4\\left(\\ln\\left|- 2 x + e^{x} + 3\\right|\\right)"] [:db/ensure "49a9b07a-8101-5daa-9dc0-f2b02b07afba" :answer/validate] [:db/add "094192ba-6339-5cb4-b476-c1b5fb56a3ed" :answer-field/id #uuid "094192ba-6339-5cb4-b476-c1b5fb56a3ed"] [:db/add "094192ba-6339-5cb4-b476-c1b5fb56a3ed" :answer-field/key "answer"] [:db/add "094192ba-6339-5cb4-b476-c1b5fb56a3ed" :answer-field/type :answer-field.type/blank] [:db/add "094192ba-6339-5cb4-b476-c1b5fb56a3ed" :answer-field/choices "49a9b07a-8101-5daa-9dc0-f2b02b07afba"] [:db/add "094192ba-6339-5cb4-b476-c1b5fb56a3ed" :answer-field/correct "49a9b07a-8101-5daa-9dc0-f2b02b07afba"] [:db/ensure "094192ba-6339-5cb4-b476-c1b5fb56a3ed" :answer-field/validate] [:db/add "15e81c30-60bd-5d53-9d15-12b445c36ff0" :question/id #uuid "15e81c30-60bd-5d53-9d15-12b445c36ff0"] [:db/add "15e81c30-60bd-5d53-9d15-12b445c36ff0" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "15e81c30-60bd-5d53-9d15-12b445c36ff0" :question/worked-solution "Let $u=- 2 x + e^{x} + 3$. Then $\\mathrm{d}u=(e^{x} - 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n4\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=4\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\ln\\left|- 2 x + e^{x} + 3\\right|\\right)+C.\n$$"] [:db/add "15e81c30-60bd-5d53-9d15-12b445c36ff0" :question/difficulty :question.difficulty/hard] [:db/add "15e81c30-60bd-5d53-9d15-12b445c36ff0" :question/answer-fields "094192ba-6339-5cb4-b476-c1b5fb56a3ed"] [:db/ensure "15e81c30-60bd-5d53-9d15-12b445c36ff0" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "15e81c30-60bd-5d53-9d15-12b445c36ff0"] [:db/add "d2603ae0-e396-5aa5-b456-3663f4422741" :answer/id #uuid "d2603ae0-e396-5aa5-b456-3663f4422741"] [:db/add "d2603ae0-e396-5aa5-b456-3663f4422741" :answer/type :answer.type/math] [:db/add "d2603ae0-e396-5aa5-b456-3663f4422741" :answer/value "\\ln\\left|2 x + e^{2 x} + 4\\right|"] [:db/ensure "d2603ae0-e396-5aa5-b456-3663f4422741" :answer/validate] [:db/add "2eb6bd44-fc4c-520a-92a2-c308b49029ba" :answer-field/id #uuid "2eb6bd44-fc4c-520a-92a2-c308b49029ba"] [:db/add "2eb6bd44-fc4c-520a-92a2-c308b49029ba" :answer-field/key "answer"] [:db/add "2eb6bd44-fc4c-520a-92a2-c308b49029ba" :answer-field/type :answer-field.type/blank] [:db/add "2eb6bd44-fc4c-520a-92a2-c308b49029ba" :answer-field/choices "d2603ae0-e396-5aa5-b456-3663f4422741"] [:db/add "2eb6bd44-fc4c-520a-92a2-c308b49029ba" :answer-field/correct "d2603ae0-e396-5aa5-b456-3663f4422741"] [:db/ensure "2eb6bd44-fc4c-520a-92a2-c308b49029ba" :answer-field/validate] [:db/add "3022dfa7-5158-57bf-8cb2-acb01878091d" :question/id #uuid "3022dfa7-5158-57bf-8cb2-acb01878091d"] [:db/add "3022dfa7-5158-57bf-8cb2-acb01878091d" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "3022dfa7-5158-57bf-8cb2-acb01878091d" :question/worked-solution "Let $u=2 x + e^{2 x} + 4$. Then $\\mathrm{d}u=(2 e^{2 x} + 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nSubstitute back:\n\n$$\n\\ln\\left|2 x + e^{2 x} + 4\\right|+C.\n$$"] [:db/add "3022dfa7-5158-57bf-8cb2-acb01878091d" :question/difficulty :question.difficulty/hard] [:db/add "3022dfa7-5158-57bf-8cb2-acb01878091d" :question/answer-fields "2eb6bd44-fc4c-520a-92a2-c308b49029ba"] [:db/ensure "3022dfa7-5158-57bf-8cb2-acb01878091d" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "3022dfa7-5158-57bf-8cb2-acb01878091d"] [:db/add "8479c2d6-a87d-502b-bf23-37b341449923" :answer/id #uuid "8479c2d6-a87d-502b-bf23-37b341449923"] [:db/add "8479c2d6-a87d-502b-bf23-37b341449923" :answer/type :answer.type/math] [:db/add "8479c2d6-a87d-502b-bf23-37b341449923" :answer/value "\\frac{1}{2}\\left(\\ln\\left|- 2 x + e^{2 x} + 4\\right|\\right)"] [:db/ensure "8479c2d6-a87d-502b-bf23-37b341449923" :answer/validate] [:db/add "5bd35909-9f12-5709-aad6-653896cfcde3" :answer-field/id #uuid "5bd35909-9f12-5709-aad6-653896cfcde3"] [:db/add "5bd35909-9f12-5709-aad6-653896cfcde3" :answer-field/key "answer"] [:db/add "5bd35909-9f12-5709-aad6-653896cfcde3" :answer-field/type :answer-field.type/blank] [:db/add "5bd35909-9f12-5709-aad6-653896cfcde3" :answer-field/choices "8479c2d6-a87d-502b-bf23-37b341449923"] [:db/add "5bd35909-9f12-5709-aad6-653896cfcde3" :answer-field/correct "8479c2d6-a87d-502b-bf23-37b341449923"] [:db/ensure "5bd35909-9f12-5709-aad6-653896cfcde3" :answer-field/validate] [:db/add "f9aade53-c709-509d-8dd5-b965ca84727d" :question/id #uuid "f9aade53-c709-509d-8dd5-b965ca84727d"] [:db/add "f9aade53-c709-509d-8dd5-b965ca84727d" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{e^{2 x} - 1}{- 2 x + e^{2 x} + 4}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "f9aade53-c709-509d-8dd5-b965ca84727d" :question/worked-solution "Let $u=- 2 x + e^{2 x} + 4$. Then $\\mathrm{d}u=(2 e^{2 x} - 2)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{e^{2 x} - 1}{- 2 x + e^{2 x} + 4}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{2}\\left(\\ln\\left|- 2 x + e^{2 x} + 4\\right|\\right)+C.\n$$"] [:db/add "f9aade53-c709-509d-8dd5-b965ca84727d" :question/difficulty :question.difficulty/hard] [:db/add "f9aade53-c709-509d-8dd5-b965ca84727d" :question/answer-fields "5bd35909-9f12-5709-aad6-653896cfcde3"] [:db/ensure "f9aade53-c709-509d-8dd5-b965ca84727d" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "f9aade53-c709-509d-8dd5-b965ca84727d"] [:db/add "21b31637-5205-50a3-98dd-7d0d6175cdbc" :answer/id #uuid "21b31637-5205-50a3-98dd-7d0d6175cdbc"] [:db/add "21b31637-5205-50a3-98dd-7d0d6175cdbc" :answer/type :answer.type/math] [:db/add "21b31637-5205-50a3-98dd-7d0d6175cdbc" :answer/value "2\\left(\\ln\\left|x + e^{x} + 2\\right|\\right)"] [:db/ensure "21b31637-5205-50a3-98dd-7d0d6175cdbc" :answer/validate] [:db/add "b75bbeac-83f2-584c-b186-6fc256c87f58" :answer-field/id #uuid "b75bbeac-83f2-584c-b186-6fc256c87f58"] [:db/add "b75bbeac-83f2-584c-b186-6fc256c87f58" :answer-field/key "answer"] [:db/add "b75bbeac-83f2-584c-b186-6fc256c87f58" :answer-field/type :answer-field.type/blank] [:db/add "b75bbeac-83f2-584c-b186-6fc256c87f58" :answer-field/choices "21b31637-5205-50a3-98dd-7d0d6175cdbc"] [:db/add "b75bbeac-83f2-584c-b186-6fc256c87f58" :answer-field/correct "21b31637-5205-50a3-98dd-7d0d6175cdbc"] [:db/ensure "b75bbeac-83f2-584c-b186-6fc256c87f58" :answer-field/validate] [:db/add "d4db5818-aab2-534d-93ef-f6f93f256024" :question/id #uuid "d4db5818-aab2-534d-93ef-f6f93f256024"] [:db/add "d4db5818-aab2-534d-93ef-f6f93f256024" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 e^{x} + 2}{x + e^{x} + 2}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "d4db5818-aab2-534d-93ef-f6f93f256024" :question/worked-solution "Let $u=x + e^{x} + 2$. Then $\\mathrm{d}u=(e^{x} + 1)\\,\\mathrm{d}x$.\n\nUse a connected real interval on which the integrand is defined.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 e^{x} + 2}{x + e^{x} + 2}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\n$$\n2\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=2\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2\\left(\\ln\\left|x + e^{x} + 2\\right|\\right)+C.\n$$"] [:db/add "d4db5818-aab2-534d-93ef-f6f93f256024" :question/difficulty :question.difficulty/hard] [:db/add "d4db5818-aab2-534d-93ef-f6f93f256024" :question/answer-fields "b75bbeac-83f2-584c-b186-6fc256c87f58"] [:db/ensure "d4db5818-aab2-534d-93ef-f6f93f256024" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "d4db5818-aab2-534d-93ef-f6f93f256024"] [:db/add "6cb106b4-9166-5e76-b897-a0221fd66210" :answer/id #uuid "6cb106b4-9166-5e76-b897-a0221fd66210"] [:db/add "6cb106b4-9166-5e76-b897-a0221fd66210" :answer/type :answer.type/math] [:db/add "6cb106b4-9166-5e76-b897-a0221fd66210" :answer/value "\\ln\\left|- x + e^{2 x} + 3\\right|"] [:db/ensure "6cb106b4-9166-5e76-b897-a0221fd66210" :answer/validate] [:db/add "d247c712-aa40-5b32-ac58-aaf0bad0d94d" :answer-field/id #uuid "d247c712-aa40-5b32-ac58-aaf0bad0d94d"] [:db/add "d247c712-aa40-5b32-ac58-aaf0bad0d94d" :answer-field/key "answer"] [:db/add "d247c712-aa40-5b32-ac58-aaf0bad0d94d" :answer-field/type :answer-field.type/blank] [:db/add "d247c712-aa40-5b32-ac58-aaf0bad0d94d" :answer-field/choices "6cb106b4-9166-5e76-b897-a0221fd66210"] [:db/add "d247c712-aa40-5b32-ac58-aaf0bad0d94d" :answer-field/correct "6cb106b4-9166-5e76-b897-a0