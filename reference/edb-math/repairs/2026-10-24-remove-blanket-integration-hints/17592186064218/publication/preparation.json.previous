  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"cf73beed-959c-5af1-8871-e00b5c0c3d16\" :answer/id #uuid \"cf73beed-959c-5af1-8871-e00b5c0c3d16\"] [:db/add \"cf73beed-959c-5af1-8871-e00b5c0c3d16\" :answer/type :answer.type/math] [:db/add \"cf73beed-959c-5af1-8871-e00b5c0c3d16\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}+C\"] [:db/ensure \"cf73beed-959c-5af1-8871-e00b5c0c3d16\" :answer/validate] [:db/add \"6ecd7eaa-7889-5b8f-ba72-9753ec6cff81\" :answer/id #uuid \"6ecd7eaa-7889-5b8f-ba72-9753ec6cff81\"] [:db/add \"6ecd7eaa-7889-5b8f-ba72-9753ec6cff81\" :answer/type :answer.type/math] [:db/add \"6ecd7eaa-7889-5b8f-ba72-9753ec6cff81\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"6ecd7eaa-7889-5b8f-ba72-9753ec6cff81\" :answer/validate] [:db/add \"acd17162-3e22-58cb-8e95-afdab4183f36\" :answer/id #uuid \"acd17162-3e22-58cb-8e95-afdab4183f36\"] [:db/add \"acd17162-3e22-58cb-8e95-afdab4183f36\" :answer/type :answer.type/math] [:db/add \"acd17162-3e22-58cb-8e95-afdab4183f36\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"acd17162-3e22-58cb-8e95-afdab4183f36\" :answer/validate] [:db/add \"ddddd69e-d706-5f5b-a87b-ae566f266a97\" :answer/id #uuid \"ddddd69e-d706-5f5b-a87b-ae566f266a97\"] [:db/add \"ddddd69e-d706-5f5b-a87b-ae566f266a97\" :answer/type :answer.type/math] [:db/add \"ddddd69e-d706-5f5b-a87b-ae566f266a97\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ddddd69e-d706-5f5b-a87b-ae566f266a97\" :answer/validate] [:db/add \"96845604-0bb0-51b4-856c-3095be3ed10d\" :answer/id #uuid \"96845604-0bb0-51b4-856c-3095be3ed10d\"] [:db/add \"96845604-0bb0-51b4-856c-3095be3ed10d\" :answer/type :answer.type/math] [:db/add \"96845604-0bb0-51b4-856c-3095be3ed10d\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}+C\"] [:db/ensure \"96845604-0bb0-51b4-856c-3095be3ed10d\" :answer/validate] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/id #uuid \"bf30251c-b17f-56c8-9578-941b55c53dec\"] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/key \"answer\"] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/type :answer-field.type/radio] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/choices \"cf73beed-959c-5af1-8871-e00b5c0c3d16\"] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/choices \"6ecd7eaa-7889-5b8f-ba72-9753ec6cff81\"] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/choices \"acd17162-3e22-58cb-8e95-afdab4183f36\"] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/choices \"ddddd69e-d706-5f5b-a87b-ae566f266a97\"] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/choices \"96845604-0bb0-51b4-856c-3095be3ed10d\"] [:db/add \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/correct \"acd17162-3e22-58cb-8e95-afdab4183f36\"] [:db/ensure \"bf30251c-b17f-56c8-9578-941b55c53dec\" :answer-field/validate] [:db/add \"87a66aa8-c496-599b-ab47-b5f71305a74d\" :question/id #uuid \"87a66aa8-c496-599b-ab47-b5f71305a74d\"] [:db/add \"87a66aa8-c496-599b-ab47-b5f71305a74d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"87a66aa8-c496-599b-ab47-b5f71305a74d\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{3}\\\\cdot 3=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"87a66aa8-c496-599b-ab47-b5f71305a74d\" :question/difficulty :question.difficulty/moderate] [:db/add \"87a66aa8-c496-599b-ab47-b5f71305a74d\" :question/answer-fields \"bf30251c-b17f-56c8-9578-941b55c53dec\"] [:db/ensure \"87a66aa8-c496-599b-ab47-b5f71305a74d\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"87a66aa8-c496-599b-ab47-b5f71305a74d\"] [:db/add \"f2f3edb9-40e6-5c56-9239-8d8aa45a1f00\" :answer/id #uuid \"f2f3edb9-40e6-5c56-9239-8d8aa45a1f00\"] [:db/add \"f2f3edb9-40e6-5c56-9239-8d8aa45a1f00\" :answer/type :answer.type/math] [:db/add \"f2f3edb9-40e6-5c56-9239-8d8aa45a1f00\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"f2f3edb9-40e6-5c56-9239-8d8aa45a1f00\" :answer/validate] [:db/add \"7a4266b4-239c-5519-b959-7b252d6e6467\" :answer/id #uuid \"7a4266b4-239c-5519-b959-7b252d6e6467\"] [:db/add \"7a4266b4-239c-5519-b959-7b252d6e6467\" :answer/type :answer.type/math] [:db/add \"7a4266b4-239c-5519-b959-7b252d6e6467\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"7a4266b4-239c-5519-b959-7b252d6e6467\" :answer/validate] [:db/add \"ff4cad48-d38b-52ae-8a34-b8575c0e99d1\" :answer/id #uuid \"ff4cad48-d38b-52ae-8a34-b8575c0e99d1\"] [:db/add \"ff4cad48-d38b-52ae-8a34-b8575c0e99d1\" :answer/type :answer.type/math] [:db/add \"ff4cad48-d38b-52ae-8a34-b8575c0e99d1\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"ff4cad48-d38b-52ae-8a34-b8