b/add \"9b712a6e-6e52-5783-8e96-8c4185897b37\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"9b712a6e-6e52-5783-8e96-8c4185897b37\" :question/worked-solution \"Let $u=\\\\frac{x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - x^{2}}=3\\\\sqrt{1-(\\\\frac{x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=3\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot 3=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"9b712a6e-6e52-5783-8e96-8c4185897b37\" :question/difficulty :question.difficulty/moderate] [:db/add \"9b712a6e-6e52-5783-8e96-8c4185897b37\" :question/answer-fields \"16a9d0a3-e9cd-5559-afce-e8648bbcdcfe\"] [:db/ensure \"9b712a6e-6e52-5783-8e96-8c4185897b37\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"9b712a6e-6e52-5783-8e96-8c4185897b37\"] [:db/add \"303097de-de9e-5a4e-9694-a009057cbd3c\" :answer/id #uuid \"303097de-de9e-5a4e-9694-a009057cbd3c\"] [:db/add \"303097de-de9e-5a4e-9694-a009057cbd3c\" :answer/type :answer.type/math] [:db/add \"303097de-de9e-5a4e-9694-a009057cbd3c\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"303097de-de9e-5a4e-9694-a009057cbd3c\" :answer/validate] [:db/add \"7933756d-d4ec-54f9-a957-dd98d971866d\" :answer/id #uuid \"7933756d-d4ec-54f9-a957-dd98d971866d\"] [:db/add \"7933756d-d4ec-54f9-a957-dd98d971866d\" :answer/type :answer.type/math] [:db/add \"7933756d-d4ec-54f9-a957-dd98d971866d\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"7933756d-d4ec-54f9-a957-dd98d971866d\" :answer/validate] [:db/add \"a7dd16fb-bc99-52d7-9e33-3166eedac853\" :answer/id #uuid \"a7dd16fb-bc99-52d7-9e33-3166eedac853\"] [:db/add \"a7dd16fb-bc99-52d7-9e33-3166eedac853\" :answer/type :answer.type/math] [:db/add \"a7dd16fb-bc99-52d7-9e33-3166eedac853\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"a7dd16fb-bc99-52d7-9e33-3166eedac853\" :answer/validate] [:db/add \"9a970b3d-56f7-53f5-b232-42fd13058140\" :answer/id #uuid \"9a970b3d-56f7-53f5-b232-42fd13058140\"] [:db/add \"9a970b3d-56f7-53f5-b232-42fd13058140\" :answer/type :answer.type/math] [:db/add \"9a970b3d-56f7-53f5-b232-42fd13058140\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}+C\"] [:db/ensure \"9a970b3d-56f7-53f5-b232-42fd13058140\" :answer/validate] [:db/add \"fa88638e-20b5-53de-b43f-2ceb7e5d2611\" :answer/id #uuid \"fa88638e-20b5-53de-b43f-2ceb7e5d2611\"] [:db/add \"fa88638e-20b5-53de-b43f-2ceb7e5d2611\" :answer/type :answer.type/math] [:db/add \"fa88638e-20b5-53de-b43f-2ceb7e5d2611\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"fa88638e-20b5-53de-b43f-2ceb7e5d2611\" :answer/validate] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/id #uuid \"0928067e-abf1-5601-af9a-eb0232cac731\"] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/key \"answer\"] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/type :answer-field.type/radio] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/choices \"303097de-de9e-5a4e-9694-a009057cbd3c\"] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/choices \"7933756d-d4ec-54f9-a957-dd98d971866d\"] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/choices \"a7dd16fb-bc99-52d7-9e33-3166eedac853\"] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/choices \"9a970b3d-56f7-53f5-b232-42fd13058140\"] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/choices \"fa88638e-20b5-53de-b43f-2ceb7e5d2611\"] [:db/add \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/correct \"7933756d-d4ec-54f9-a957-dd98d971866d\"] [:db/ensure \"0928067e-abf1-5601-af9a-eb0232cac731\" :answer-field/validate] [:db/add \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\" :question/id #uuid \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\"] [:db/add \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 2=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\" :question/difficulty :question.difficulty/moderate] [:db/add \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\" :question/answer-fields \"0928067e-abf1-5601-af9a-eb0232cac731\"] [:db/ensure \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"f0d24e1a-b76a-52fa-be50-ddfb085b96e6\"] [:db/add \"76be5748-22da-5774-81d8-207bb26aaee4\" :answer/id #uuid \"76be5748-22da-5774-81d8-207bb26aaee4\"] [:db/add \"76be5748-22da-5774-81d8-207bb26aaee4\" :answer/type :answer.type/math] [:db/add \"76be5748-22da-5774-81d8-207bb26aaee4\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"76be5748-22da-5774-81d8-207bb26aaee4\" :answer/validate] [:db/add \"054aa328-8f57-565a-a206-535421169ab4\" :answer/id #uuid \"054aa328-8f57-565a-a206-535421169ab4\"] [:db/add \"054aa328-8f57-565a-a206-535421169ab4\" :answer/type :answer.type/math] [:db/add \"054aa328-8f57-565a-a206-535421169ab4\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"054aa328-8f57-565a-a206-535421169ab4\" :answer/validate] [:db/add \"f20d841d-4f83-51c7-8173-489ea9367416\" :answer/id #uuid \"f20d841d-4f83-51c7-8173-489ea9367416\"] [:db/add \"f20d841d-4f83-51c7-8173-489ea9367416\" :answer/type :answer.type/math] [:db/add \"f20d841d-4f83-51c7-8173-489ea9367416\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"f20d841d-4f83-51c7-8173-489ea9367416\" :answer/validate] [:db/add \"2687513b-066f-55c8-8dda-f4b34f54727a\" :answer/id #uuid \"2687513b-066f-55c8-8dda-f4b34f54727a\"] [:db/add \"2687513b-066f-55c8-8dda-f4b34f54727a\" :answer/type :answer.type/math] [:db/add \"2687513b-066f-55c8-8dda-f4b34f54727a\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"2687513b-066f-55c8-8dda-f4b34f54727a\" :answer/validate] [:db/add \"9cd447a8-7e98-5db6-8928-c7f3a26930f7\" :answer/id #uuid \"9cd447a8-7e98-5db6-8928-c7f3a26930f7\"] [:db/add \"9cd447a8-7e98-5db6-8928-c7f3a26930f7\" :answer/type :answer.type/math] [:db/add \"9cd447a8-7e98-5db6-8928-c7f3a26930f7\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"9cd447a8-7e98-5db6-8928-c7f3a26930f7\" :answer/validate] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/id #uuid \"dfaeeb09-b347-53b0-904a-10bd23843fbb\"] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/key \"answer\"] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/type :answer-field.type/radio] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/choices \"76be5748-22da-5774-81d8-207bb26aaee4\"] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/choices \"054aa328-8f57-565a-a206-535421169ab4\"] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/choices \"f20d841d-4f83-51c7-8173-489ea9367416\"] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/choices \"2687513b-066f-55c8-8dda-f4b34f54727a\"] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/choices \"9cd447a8-7e98-5db6-8928-c7f3a26930f7\"] [:db/add \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/correct \"76be5748-22da-5774-81d8-207bb26aaee4\"] [:db/ensure \"dfaeeb09-b347-53b0-904a-10bd23843fbb\" :answer-field/validate] [:db/add \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\" :question/id #uuid \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\"] [:db/add \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\" :question/worked-solution \"Let $u=\\\\frac{x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - x^{2}}=2\\\\sqrt{1-(\\\\frac{x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=2\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{2}\\\\cdot 2=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{4 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\" :question/difficulty :question.difficulty/moderate] [:db/add \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\" :question/answer-fields \"dfaeeb09-b347-53b0-904a-10bd23843fbb\"] [:db/ensure \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"3142b06d-bcb6-5c1e-8833-2865ec0d326e\"] [:db/add \"3a66c3f6-d52a-5475-bae6-e5aa8c0442e0\" :answer/id #uuid \"3a66c3f6-d52a-5475-bae6-e5aa8c0442e0\"] [:db/add \"3a66c3f6-d52a-5475-bae6-e5aa8c0442e0\" :answer/type :answer.type/math] [:db/add \"3a66c3f6-d52a-5475-bae6-e5aa8c0442e0\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"3a66c3f6-d52a-5475-bae6-e5aa8c0442e0\" :answer/validate] [:db/add \"4de421c4-26fe-5756-aa56-6b170d7a7cc8\" :answer/id #uuid \"4de421c4-26fe-5756-aa56-6b170d7a7cc8\"] [:db/add \"4de421c4-26fe-5756-aa56-6b170d7a7cc8\" :answer/type :answer.type/math] [:db/add \"4de421c4-26fe-5756-aa56-6b170d7a7cc8\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"4de421c4-26fe-5756-aa56-6b170d7a7cc8\" :answer/validate] [:db/add \"254c8fac-1e02-5b0c-b03f-49f770d903f2\" :answer/id #uuid \"254c8fac-1e02-5b0c-b03f-49f770d903f2\"] [:db/add \"254c8fac-1e02-5b0c-b03f-49f770d903f2\" :answer/type :answer.type/math] [:db/add \"254c8fac-1e02-5b0c-b03f-49f770d903f2\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"254c8fac-1e02-5b0c-b03f-49f770d903f2\" :answer/validate] [:db/add \"f75cebf5-e81e-5e15-b438-b1abcda6b5ce\" :answer/id #uuid \"f75cebf5-e81e-5e15-b438-b1abcda6b5ce\"] [:db/add \"f75cebf5-e81e-5e15-b438-b1abcda6b5ce\" :answer/type :answer.type/math] [:db/add \"f75cebf5-e81e-5e15-b438-b1abcda6b5ce\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"f75cebf5-e81e-5e15-b438-b1abcda6b5ce\" :answer/validate] [:db/add \"08f93f68-86dc-56ec-8047-4c34b24fefb7\" :answer/id #uuid \"08f93f68-86dc-56ec-8047-4c34b24fefb7\"] [:db/add \"08f93f68-86dc-56ec-8047-4c34b24fefb7\" :answer/type :answer.type/math] [:db/add \"08f93f68-86dc-56ec-8047-4c34b24fefb7\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{10} \\\\right)}\\\\right)+C\"] [:db/ensure \"08f93f68-86dc-56ec-8047-4c34b24fefb7\" :answer/validate] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/id #uuid \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\"] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/key \"answer\"] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/type :answer-field.type/radio] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/choices \"3a66c3f6-d52a-5475-bae6-e5aa8c0442e0\"] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/choices \"4de421c4-26fe-5756-aa56-6b170d7a7cc8\"] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/choices \"254c8fac-1e02-5b0c-b03f-49f770d903f2\"] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/choices \"f75cebf5-e81e-5e15-b438-b1abcda6b5ce\"] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/choices \"08f93f68-86dc-56ec-8047-4c34b24fefb7\"] [:db/add \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/correct \"254c8fac-1e02-5b0c-b03f-49f770d903f2\"] [:db/ensure \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\" :answer-field/validate] [:db/add \"d8bfa756-584c-546f-9389-10257daa4f6d\" :question/id #uuid \"d8bfa756-584c-546f-9389-10257daa4f6d\"] [:db/add \"d8bfa756-584c-546f-9389-10257daa4f6d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"d8bfa756-584c-546f-9389-10257daa4f6d\" :question/worked-solution \"Let $u=\\\\frac{x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - x^{2}}=5\\\\sqrt{1-(\\\\frac{x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=5\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{5}\\\\cdot 5=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{25 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"d8bfa756-584c-546f-9389-10257daa4f6d\" :question/difficulty :question.difficulty/moderate] [:db/add \"d8bfa756-584c-546f-9389-10257daa4f6d\" :question/answer-fields \"72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3\"] [:db/ensure \"d8bfa756-584c-546f-9389-10257daa4f6d\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"d8bfa756-584c-546f-9389-10257daa4f6d\"] [:db/add \"eb72ac2b-a8b7-56ac-8caa-7da4014bb176\" :answer/id #uuid \"eb72ac2b-a8b7-56ac-8caa-7da4014bb176\"] [:db/add \"eb72ac2b-a8b7-56ac-8caa-7da4014bb176\" :answer/type :answer.type/math] [:db/add \"eb72ac2b-a8b7-56ac-8caa-7da4014bb176\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"eb72ac2b-a8b7-56ac-8caa-7da4014bb176\" :answer/validate] [:db/add \"3ca1c617-13fb-5c53-9416-b64ff2367c83\" :answer/id #uuid \"3ca1c617-13fb-5c53-9416-b64ff2367c83\"] [:db/add \"3ca1c617-13fb-5c53-9416-b64ff2367c83\" :answer/type :answer.type/math] [:db/add \"3ca1c617-13fb-5c53-9416-b64ff2367c83\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"3ca1c617-13fb-5c53-9416-b64ff2367c83\" :answer/validate] [:db/add \"ffda49a3-3f8e-5cd9-8110-12e774b9a2fe\" :answer/id #uuid \"ffda49a3-3f8e-5cd9-8110-12e774b9a2fe\"] [:db/add \"ffda49a3-3f8e-5cd9-8110-12e774b9a2fe\" :answer/type :answer.type/math] [:db/add \"ffda49a3-3f8e-5cd9-8110-12e774b9a2fe\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"ffda49a3-3f8e-5cd9-8110-12e774b9a2fe\" :answer/validate] [:db/add \"1ecf4203-cceb-518f-8138-53ab7be26e9c\" :answer/id #uuid \"1ecf4203-cceb-518f-8138-53ab7be26e9c\"] [:db/add \"1ecf4203-cceb-518f-8138-53ab7be26e9c\" :answer/type :answer.type/math] [:db/add \"1ecf4203-cceb-518f-8138-53ab7be26e9c\" :answer/value \"8\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"1ecf4203-cceb-518f-8138-53ab7be26e9c\" :answer/validate] [:db/add \"738a424f-da3b-5c24-9ddb-bde3f82115e8\" :answer/id #uuid \"738a424f-da3b-5c24-9ddb-bde3f82115e8\"] [:db/add \"738a424f-da3b-5c24-9ddb-bde3f82115e8\" :answer/type :answer.type/math] [:db/add \"738a424f-da3b-5c24-9ddb-bde3f82115e8\" :answer/value \"-4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"738a424f-da3b-5c24-9ddb-bde3f82115e8\" :answer/validate] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/id #uuid \"28d3e114-d1f1-57f2-a856-156056ae0331\"] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/key \"answer\"] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/type :answer-field.type/radio] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/choices \"eb72ac2b-a8b7-56ac-8caa-7da4014bb176\"] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/choices \"3ca1c617-13fb-5c53-9416-b64ff2367c83\"] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/choices \"ffda49a3-3f8e-5cd9-8110-12e774b9a2fe\"] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/choices \"1ecf4203-cceb-518f-8138-53ab7be26e9c\"] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/choices \"738a424f-da3b-5c24-9ddb-bde3f82115e8\"] [:db/add \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/correct \"eb72ac2b-a8b7-56ac-8caa-7da4014bb176\"] [:db/ensure \"28d3e114-d1f1-57f2-a856-156056ae0331\" :answer-field/validate] [:db/add \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\" :question/id #uuid \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\"] [:db/add \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot 4=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\" :question/difficulty :question.difficulty/moderate] [:db/add \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\" :question/answer-fields \"28d3e114-d1f1-57f2-a856-156056ae0331\"] [:db/ensure \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"d7cc6f44-f7b9-56ad-865b-19c03ea6f303\"] [:db/add \"76c3d541-ae48-5f20-8898-b82e96bcd9f1\" :answer/id #uuid \"76c3d541-ae48-5f20-8898-b82e96bcd9f1\"] [:db/add \"76c3d541-ae48-5f20-8898-b82e96bcd9f1\" :answer/type :answer.type/math] [:db/add \"76c3d541-ae48-5f20-8898-b82e96bcd9f1\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"76c3d541-ae48-5f20-8898-b82e96bcd9f1\" :answer/validate] [:db/add \"17a284c1-3a91-5b3a-a195-75a698973a1c\" :answer/id #uuid \"17a284c1-3a91-5b3a-a195-75a698973a1c\"] [:db/add \"17a284c1-3a91-5b3a-a195-75a698973a1c\" :answer/type :answer.type/math] [:db/add \"17a284c1-3a91-5b3a-a195-75a698973a1c\" :answer/value \"-3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"17a284c1-3a91-5b3a-a195-75a698973a1c\" :answer/validate] [:db/add \"144b05a5-35ce-58f4-8aa2-b53cb03d74c8\" :answer/id #uuid \"144b05a5-35ce-58f4-8aa2-b53cb03d74c8\"] [:db/add \"144b05a5-35ce-58f4-8aa2-b53cb03d74c8\" :answer/type :answer.type/math] [:db/add \"144b05a5-35ce-58f4-8aa2-b53cb03d74c8\" :answer/value \"6\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"144b05a5-35ce-58f4-8aa2-b53cb03d74c8\" :answer/validate] [:db/add \"6606412b-972d-535b-9878-9cad31611d18\" :answer/id #uuid \"6606412b-972d-535b-9878-9cad31611d18\"] [:db/add \"6606412b-972d-535b-9878-9cad31611d18\" :answer/type :answer.type/math] [:db/add \"6606412b-972d-535b-9878-9cad31611d18\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"6606412b-972d-535b-9878-9cad31611d18\" :answer/validate] [:db/add \"3ed8fc3e-1d80-5257-bcec-68d599a1d0b8\" :answer/id #uuid \"3ed8fc3e-1d80-5257-bcec-68d599a1d0b8\"] [:db/add \"3ed8fc3e-1d80-5257-bcec-68d599a1d0b8\" :answer/type :answer.type/math] [:db/add \"3ed8fc3e-1d80-5257-bcec-68d599a1d0b8\" :answer/value \"3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{8} \\\\right)}\\\\right)+C\"] [:db/ensure \"3ed8fc3e-1d80-5257-bcec-68d599a1d0b8\" :answer/validate] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/id #uuid \"791b6536-9985-59fa-b96f-2454c13c5270\"] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/key \"answer\"] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/type :answer-field.type/radio] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/choices \"76c3d541-ae48-5f20-8898-b82e96bcd9f1\"] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/choices \"17a284c1-3a91-5b3a-a195-75a698973a1c\"] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/choices \"144b05a5-35ce-58f4-8aa2-b53cb03d74c8\"] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/choices \"6606412b-972d-535b-9878-9cad31611d18\"] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/choices \"3ed8fc3e-1d80-5257-bcec-68d599a1d0b8\"] [:db/add \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/correct \"6606412b-972d-535b-9878-9cad31611d18\"] [:db/ensure \"791b6536-9985-59fa-b96f-2454c13c5270\" :answer-field/validate] [:db/add \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\" :question/id #uuid \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\"] [:db/add \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{3}{4}\\\\cdot 4=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\" :question/difficulty :question.difficulty/moderate] [:db/add \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\" :question/answer-fields \"791b6536-9985-59fa-b96f-2454c13c5270\"] [:db/ensure \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"ef9178db-b6e7-5406-845d-17dcc05cb1b7\"] [:db/add \"bae754e5-56fa-5165-992d-7eee88b14f2f\" :answer/id #uuid \"bae754e5-56fa-5165-992d-7eee88b14f2f\"] [:db/add \"bae754e5-56fa-5165-992d-7eee88b14f2f\" :answer/type :answer.type/math] [:db/add \"bae754e5-56fa-5165-992d-7eee88b14f2f\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{8} \\\\right)}\\\\right)+C\"] [:db/ensure \"bae754e5-56fa-5165-992d-7eee88b14f2f\" :answer/validate] [:db/add \"9056a6ad-448a-5790-90f9-14397d2335a7\" :answer/id #uuid \"9056a6ad-448a-5790-90f9-14397d2335a7\"] [:db/add \"9056a6ad-448a-5790-90f9-14397d2335a7\" :answer/type :answer.type/math] [:db/add \"9056a6ad-448a-5790-90f9-14397d2335a7\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"9056a6ad-448a-5790-90f9-14397d2335a7\" :answer/validate] [:db/add \"3ca39426-5130-5f4e-9ef1-b7f3ae61b971\" :answer/id #uuid \"3ca39426-5130-5f4e-9ef1-b7f3ae61b971\"] [:db/add \"3ca39426-5130-5f4e-9ef1-b7f3ae61b971\" :answer/type :answer.type/math] [:db/add \"3ca39426-5130-5f4e-9ef1-b7f3ae61b971\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{x}{2} \\\\right)}+C\"] [:db/ensure \"3ca39426-5130-5f4e-9ef1-b7f3ae61b971\" :answer/validate] [:db/add \"b0a55b65-9015-59e6-b3f2-7faa7ab39220\" :answer/id #uuid \"b0a55b65-9015-59e6-b3f2-7faa7ab39220\"] [:db/add \"b0a55b65-9015-59e6-b3f2-7faa7ab39220\" :answer/type :answer.type/math] [:db/add \"b0a55b65-9015-59e6-b3f2-7faa7ab39220\" :answer/value \"4\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"b0a55b65-9015-59e6-b3f2-7faa7ab39220\" :answer/validate] [:db/add \"1e20dcdc-032c-5708-af11-0aaf503f1632\" :answer/id #uuid \"1e20dcdc-032c-5708-af11-0aaf503f1632\"] [:db/add \"1e20dcdc-032c-5708-af11-0aaf503f1632\" :answer/type :answer.type/math] [:db/add \"1e20dcdc-032c-5708-af11-0aaf503f1632\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"1e20dcdc-032c-5708-af11-0aaf503f1632\" :answer/validate] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/id #uuid \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\"] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/key \"answer\"] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/type :answer-field.type/radio] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/choices \"bae754e5-56fa-5165-992d-7eee88b14f2f\"] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/choices \"9056a6ad-448a-5790-90f9-14397d2335a7\"] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/choices \"3ca39426-5130-5f4e-9ef1-b7f3ae61b971\"] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/choices \"b0a55b65-9015-59e6-b3f2-7faa7ab39220\"] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/choices \"1e20dcdc-032c-5708-af11-0aaf503f1632\"] [:db/add \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/correct \"9056a6ad-448a-5790-90f9-14397d2335a7\"] [:db/ensure \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\" :answer-field/validate] [:db/add \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\" :question/id #uuid \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\"] [:db/add \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\" :question/worked-solution \"Let $u=\\\\frac{x}{4}$. Then $\\\\mathrm{d}u=(\\\\frac{1}{4})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{16 - x^{2}}=4\\\\sqrt{1-(\\\\frac{x}{4})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=4\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot 4=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{16 - x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{4} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\" :question/difficulty :question.difficulty/moderate] [:db/add \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\" :question/answer-fields \"3a9e507d-4f49-50a3-b59e-153d4e812f3c\"] [:db/ensure \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"ffa9d174-c2fd-5424-b8d2-3acccef9ad99\"] [:db/add \"13620ef1-e521-5058-8942-a85b7380b61d\" :answer/id #uuid \"13620ef1-e521-5058-8942-a85b7380b61d\"] [:db/add \"13620ef1-e521-5058-8942-a85b7380b61d\" :answer/type :answer.type/math] [:db/add \"13620ef1-e521-5058-8942-a85b7380b61d\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"13620ef1-e521-5058-8942-a85b7380b61d\" :answer/validate] [:db/add \"184bf7ca-9faf-5864-a12d-17d7ce2a9de1\" :answer/id #uuid \"184bf7ca-9faf-5864-a12d-17d7ce2a9de1\"] [:db/add \"184bf7ca-9faf-5864-a12d-17d7ce2a9de1\" :answer/type :answer.type/math] [:db/add \"184bf7ca-9faf-5864-a12d-17d7ce2a9de1\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"184bf7ca-9faf-5864-a12d-17d7ce2a9de1\" :answer/validate] [:db/add \"f0da924d-eeec-51b9-8b8b-9111f49f6766\" :answer/id #uuid \"f0da924d-eeec-51b9-8b8b-9111f49f6766\"] [:db/add \"f0da924d-eeec-51b9-8b8b-9111f49f6766\" :answer/type :answer.type/math] [:db/add \"f0da924d-eeec-51b9-8b8b-9111f49f6766\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}+C\"] [:db/ensure \"f0da924d-eeec-51b9-8b8b-9111f49f6766\" :answer/validate] [:db/add \"d064ecce-76fd-5b68-9c4c-ae08837f2cdf\" :answer/id #uuid \"d064ecce-76fd-5b68-9c4c-ae08837f2cdf\"] [:db/add \"d064ecce-76fd-5b68-9c4c-ae08837f2cdf\" :answer/type :answer.type/math] [:db/add \"d064ecce-76fd-5b68-9c4c-ae08837f2cdf\" :answer/value \"-2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"d064ecce-76fd-5b68-9c4c-ae08837f2cdf\" :answer/validate] [:db/add \"1c4f7e60-b53e-5871-a8cd-d619a79bd856\" :answer/id #uuid \"1c4f7e60-b53e-5871-a8cd-d619a79bd856\"] [:db/add \"1c4f7e60-b53e-5871-a8cd-d619a79bd856\" :answer/type :answer.type/math] [:db/add \"1c4f7e60-b53e-5871-a8cd-d619a79bd856\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"1c4f7e60-b53e-5871-a8cd-d619a79bd856\" :answer/validate] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/id #uuid \"5fa55012-786c-5c42-b08f-8ccd8d230e56\"] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/key \"answer\"] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/type :answer-field.type/radio] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/choices \"13620ef1-e521-5058-8942-a85b7380b61d\"] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/choices \"184bf7ca-9faf-5864-a12d-17d7ce2a9de1\"] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/choices \"f0da924d-eeec-51b9-8b8b-9111f49f6766\"] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/choices \"d064ecce-76fd-5b68-9c4c-ae08837f2cdf\"] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/choices \"1c4f7e60-b53e-5871-a8cd-d619a79bd856\"] [:db/add \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/correct \"1c4f7e60-b53e-5871-a8cd-d619a79bd856\"] [:db/ensure \"5fa55012-786c-5c42-b08f-8ccd8d230e56\" :answer-field/validate] [:db/add \"a4759172-33f7-52ee-b4bf-483a956b3b02\" :question/id #uuid \"a4759172-33f7-52ee-b4bf-483a956b3b02\"] [:db/add \"a4759172-33f7-52ee-b4bf-483a956b3b02\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"a4759172-33f7-52ee-b4bf-483a956b3b02\" :question/worked-solution \"Let $u=\\\\frac{2 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 4 x^{2}}=5\\\\sqrt{1-(\\\\frac{2 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{5}\\\\cdot \\\\frac{5}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{25 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"a4759172-33f7-52ee-b4bf-483a956b3b02\" :question/difficulty :question.difficulty/hard] [:db/add \"a4759172-33f7-52ee-b4bf-483a956b3b02\" :question/answer-fields \"5fa55012-786c-5c42-b08f-8ccd8d230e56\"] [:db/ensure \"a4759172-33f7-52ee-b4bf-483a956b3b02\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"a4759172-33f7-52ee-b4bf-483a956b3b02\"] [:db/add \"b92d90cc-a214-50e5-b54e-5caf1f7a0b02\" :answer/id #uuid \"b92d90cc-a214-50e5-b54e-5caf1f7a0b02\"] [:db/add \"b92d90cc-a214-50e5-b54e-5caf1f7a0b02\" :answer/type :answer.type/math] [:db/add \"b92d90cc-a214-50e5-b54e-5caf1f7a0b02\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C\"] [:db/ensure \"b92d90cc-a214-50e5-b54e-5caf1f7a0b02\" :answer/validate] [:db/add \"c0061cb1-8680-52d6-9d21-78b4ec405974\" :answer/id #uuid \"c0061cb1-8680-52d6-9d21-78b4ec405974\"] [:db/add \"c0061cb1-8680-52d6-9d21-78b4ec405974\" :answer/type :answer.type/math] [:db/add \"c0061cb1-8680-52d6-9d21-78b4ec405974\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}+C\"] [:db/ensure \"c0061cb1-8680-52d6-9d21-78b4ec405974\" :answer/validate] [:db/add \"e3ae4fea-f54e-5655-b37f-72e280bea302\" :answer/id #uuid \"e3ae4fea-f54e-5655-b37f-72e280bea302\"] [:db/add \"e3ae4fea-f54e-5655-b37f-72e280bea302\" :answer/type :answer.type/math] [:db/add \"e3ae4fea-f54e-5655-b37f-72e280bea302\" :answer/value \"2\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"e3ae4fea-f54e-5655-b37f-72e280bea302\" :answer/validate] [:db/add \"50e18cac-7a33-543e-95e3-3ea2eb889e61\" :answer/id #uuid \"50e18cac-7a33-543e-95e3-3ea2eb889e61\"] [:db/add \"50e18cac-7a33-543e-95e3-3ea2eb889e61\" :answer/type :answer.type/math] [:db/add \"50e18cac-7a33-543e-95e3-3ea2eb889e61\" :answer/value \"-1\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"50e18cac-7a33-543e-95e3-3ea2eb889e61\" :answer/validate] [:db/add \"e2f48239-3241-574d-bd74-e7019be7d99c\" :answer/id #uuid \"e2f48239-3241-574d-bd74-e7019be7d99c\"] [:db/add \"e2f48239-3241-574d-bd74-e7019be7d99c\" :answer/type :answer.type/math] [:db/add \"e2f48239-3241-574d-bd74-e7019be7d99c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"e2f48239-3241-574d-bd74-e7019be7d99c\" :answer/validate] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/id #uuid \"8091343a-bce8-5305-8188-2e61041cbb5a\"] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/key \"answer\"] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/type :answer-field.type/radio] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/choices \"b92d90cc-a214-50e5-b54e-5caf1f7a0b02\"] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/choices \"c0061cb1-8680-52d6-9d21-78b4ec405974\"] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/choices \"e3ae4fea-f54e-5655-b37f-72e280bea302\"] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/choices \"50e18cac-7a33-543e-95e3-3ea2eb889e61\"] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/choices \"e2f48239-3241-574d-bd74-e7019be7d99c\"] [:db/add \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/correct \"b92d90cc-a214-50e5-b54e-5caf1f7a0b02\"] [:db/ensure \"8091343a-bce8-5305-8188-2e61041cbb5a\" :answer-field/validate] [:db/add \"6ab1dc30-1799-5701-87df-381e5894e2ee\" :question/id #uuid \"6ab1dc30-1799-5701-87df-381e5894e2ee\"] [:db/add \"6ab1dc30-1799-5701-87df-381e5894e2ee\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"6ab1dc30-1799-5701-87df-381e5894e2ee\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{4}{3}\\\\cdot \\\\frac{3}{4}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}+C.\\n$$\"] [:db/add \"6ab1dc30-1799-5701-87df-381e5894e2ee\" :question/difficulty :question.difficulty/hard] [:db/add \"6ab1dc30-1799-5701-87df-381e5894e2ee\" :question/answer-fields \"8091343a-bce8-5305-8188-2e61041cbb5a\"] [:db/ensure \"6ab1dc30-1799-5701-87df-381e5894e2ee\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"6ab1dc30-1799-5701-87df-381e5894e2ee\"] [:db/add \"b4cd4c2e-f5e9-577d-9bbb-762fbfddb901\" :answer/id #uuid \"b4cd4c2e-f5e9-577d-9bbb-762fbfddb901\"] [:db/add \"b4cd4c2e-f5e9-577d-9bbb-762fbfddb901\" :answer/type :answer.type/math] [:db/add \"b4cd4c2e-f5e9-577d-9bbb-762fbfddb901\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"b4cd4c2e-f5e9-577d-9bbb-762fbfddb901\" :answer/validate] [:db/add \"ea3cb756-4738-595d-b6e5-05d7815ccc00\" :answer/id #uuid \"ea3cb756-4738-595d-b6e5-05d7815ccc00\"] [:db/add \"ea3cb756-4738-595d-b6e5-05d7815ccc00\" :answer/type :answer.type/math] [:db/add \"ea3cb756-4738-595d-b6e5-05d7815ccc00\" :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ea3cb756-4738-595d-b6e5-05d7815ccc00\" :answer/validate] [:db/add \"b2726a61-7fb1-5ae3-8672-5769978ab291\" :answer/id #uuid \"b2726a61-7fb1-5ae3-8672-5769978ab291\"] [:db/add \"b2726a61-7fb1-5ae3-8672-5769978ab291\" :answer/type :answer.type/math] [:db/add \"b2726a61-7fb1-5ae3-8672-5769978ab291\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"b2726a61-7fb1-5ae3-8672-5769978ab291\" :answer/validate] [:db/add \"d153aaf8-c145-54ef-bc22-c8df6b4ecc43\" :answer/id #uuid \"d153aaf8-c145-54ef-bc22-c8df6b4ecc43\"] [:db/add \"d153aaf8-c145-54ef-bc22-c8df6b4ecc43\" :answer/type :answer.type/math] [:db/add \"d153aaf8-c145-54ef-bc22-c8df6b4ecc43\" :answer/value \"\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{4} \\\\right)}\\\\right)+C\"] [:db/ensure \"d153aaf8-c145-54ef-bc22-c8df6b4ecc43\" :answer/validate] [:db/add \"946d6ced-7687-56b8-8965-24ca7453c6ed\" :answer/id #uuid \"946d6ced-7687-56b8-8965-24ca7453c6ed\"] [:db/add \"946d6ced-7687-56b8-8965-24ca7453c6ed\" :answer/type :answer.type/math] [:db/add \"946d6ced-7687-56b8-8965-24ca7453c6ed\" :answer/value \"\\\\frac{2}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\"] [:db/ensure \"946d6ced-7687-56b8-8965-24ca7453c6ed\" :answer/validate] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/id #uuid \"6ed717e7-eac0-5f19-899d-85290b2c76c1\"] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/key \"answer\"] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/type :answer-field.type/radio] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/choices \"b4cd4c2e-f5e9-577d-9bbb-762fbfddb901\"] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/choices \"ea3cb756-4738-595d-b6e5-05d7815ccc00\"] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/choices \"b2726a61-7fb1-5ae3-8672-5769978ab291\"] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/choices \"d153aaf8-c145-54ef-bc22-c8df6b4ecc43\"] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/choices \"946d6ced-7687-56b8-8965-24ca7453c6ed\"] [:db/add \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/correct \"b4cd4c2e-f5e9-577d-9bbb-762fbfddb901\"] [:db/ensure \"6ed717e7-eac0-5f19-899d-85290b2c76c1\" :answer-field/validate] [:db/add \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\" :question/id #uuid \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\"] [:db/add \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\" :question/worked-solution \"Let $u=\\\\frac{3 x}{2}$. Then $\\\\mathrm{d}u=(\\\\frac{3}{2})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 9 x^{2}}=2\\\\sqrt{1-(\\\\frac{3 x}{2})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{2}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{2}{3}=\\\\frac{1}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 9 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\arcsin{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\" :question/difficulty :question.difficulty/hard] [:db/add \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\" :question/answer-fields \"6ed717e7-eac0-5f19-899d-85290b2c76c1\"] [:db/ensure \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"bae20d5d-4436-5e8e-8143-212aaf8c29ca\"] [:db/add \"49b64ae9-2f05-59ec-8cd8-c6fc3fd6f7d5\" :answer/id #uuid \"49b64ae9-2f05-59ec-8cd8-c6fc3fd6f7d5\"] [:db/add \"49b64ae9-2f05-59ec-8cd8-c6fc3fd6f7d5\" :answer/type :answer.type/math] [:db/add \"49b64ae9-2f05-59ec-8cd8-c6fc3fd6f7d5\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}+C\"] [:db/ensure \"49b64ae9-2f05-59ec-8cd8-c6fc3fd6f7d5\" :answer/validate] [:db/add \"073c2bd5-178d-5e5e-823d-2e38e6dd56a1\" :answer/id #uuid \"073c2bd5-178d-5e5e-823d-2e38e6dd56a1\"] [:db/add \"073c2bd5-178d-5e5e-823d-2e38e6dd56a1\" :answer/type :answer.type/math] [:db/add \"073c2bd5-178d-5e5e-823d-2e38e6dd56a1\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"073c2bd5-178d-5e5e-823d-2e38e6dd56a1\" :answer/validate] [:db/add \"b1fe77f6-d9ed-56e4-b6cb-4c46a8a859d8\" :answer/id #uuid \"b1fe77f6-d9ed-56e4-b6cb-4c46a8a859d8\"] [:db/add \"b1fe77f6-d9ed-56e4-b6cb-4c46a8a859d8\" :answer/type :answer.type/math] [:db/add \"b1fe77f6-d9ed-56e4-b6cb-4c46a8a859d8\" :answer/value \"\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}+C\"] [:db/ensure \"b1fe77f6-d9ed-56e4-b6cb-4c46a8a859d8\" :answer/validate] [:db/add \"6aebfbc6-0dd0-5a4a-a307-07b5285bb523\" :answer/id #uuid \"6aebfbc6-0dd0-5a4a-a307-07b5285bb523\"] [:db/add \"6aebfbc6-0dd0-5a4a-a307-07b5285bb523\" :answer/type :answer.type/math] [:db/add \"6aebfbc6-0dd0-5a4a-a307-07b5285bb523\" :answer/value \"\\\\arcsin{\\\\left(x \\\\right)}+C\"] [:db/ensure \"6aebfbc6-0dd0-5a4a-a307-07b5285bb523\" :answer/validate] [:db/add \"36e3bc7e-3e6b-5063-8190-6803e2a8c0a1\" :answer/id #uuid \"36e3bc7e-3e6b-5063-8190-6803e2a8c0a1\"] [:db/add \"36e3bc7e-3e6b-5063-8190-6803e2a8c0a1\" :answer/type :answer.type/math] [:db/add \"36e3bc7e-3e6b-5063-8190-6803e2a8c0a1\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{5} \\\\right)}\\\\right)+C\"] [:db/ensure \"36e3bc7e-3e6b-5063-8190-6803e2a8c0a1\" :answer/validate] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/id #uuid \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\"] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/key \"answer\"] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/type :answer-field.type/radio] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/choices \"49b64ae9-2f05-59ec-8cd8-c6fc3fd6f7d5\"] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/choices \"073c2bd5-178d-5e5e-823d-2e38e6dd56a1\"] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/choices \"b1fe77f6-d9ed-56e4-b6cb-4c46a8a859d8\"] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/choices \"6aebfbc6-0dd0-5a4a-a307-07b5285bb523\"] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/choices \"36e3bc7e-3e6b-5063-8190-6803e2a8c0a1\"] [:db/add \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/correct \"073c2bd5-178d-5e5e-823d-2e38e6dd56a1\"] [:db/ensure \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\" :answer-field/validate] [:db/add \"5a421a58-948e-5542-a6c4-c105fa219eee\" :question/id #uuid \"5a421a58-948e-5542-a6c4-c105fa219eee\"] [:db/add \"5a421a58-948e-5542-a6c4-c105fa219eee\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"5a421a58-948e-5542-a6c4-c105fa219eee\" :question/worked-solution \"Let $u=\\\\frac{4 x}{5}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{5})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{25 - 16 x^{2}}=5\\\\sqrt{1-(\\\\frac{4 x}{5})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{5}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{2}{5}\\\\cdot \\\\frac{5}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{\\\\sqrt{25 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{5} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"5a421a58-948e-5542-a6c4-c105fa219eee\" :question/difficulty :question.difficulty/hard] [:db/add \"5a421a58-948e-5542-a6c4-c105fa219eee\" :question/answer-fields \"1ac6138a-4c7e-5f02-8816-1b474bd6824d\"] [:db/ensure \"5a421a58-948e-5542-a6c4-c105fa219eee\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"5a421a58-948e-5542-a6c4-c105fa219eee\"] [:db/add \"722ac779-7083-5a49-83f8-aaaaa2b80e42\" :answer/id #uuid \"722ac779-7083-5a49-83f8-aaaaa2b80e42\"] [:db/add \"722ac779-7083-5a49-83f8-aaaaa2b80e42\" :answer/type :answer.type/math] [:db/add \"722ac779-7083-5a49-83f8-aaaaa2b80e42\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"722ac779-7083-5a49-83f8-aaaaa2b80e42\" :answer/validate] [:db/add \"84d26cec-bf95-52a4-82c6-191bf6e0248c\" :answer/id #uuid \"84d26cec-bf95-52a4-82c6-191bf6e0248c\"] [:db/add \"84d26cec-bf95-52a4-82c6-191bf6e0248c\" :answer/type :answer.type/math] [:db/add \"84d26cec-bf95-52a4-82c6-191bf6e0248c\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arcsin{\\\\left(\\\\frac{8 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"84d26cec-bf95-52a4-82c6-191bf6e0248c\" :answer/validate] [:db/add \"cc440545-8002-5ed8-aa58-849ba3d3216c\" :answer/id #uuid \"cc440545-8002-5ed8-aa58-849ba3d3216c\"] [:db/add \"cc440545-8002-5ed8-aa58-849ba3d3216c\" :answer/type :answer.type/math] [:db/add \"cc440545-8002-5ed8-aa58-849ba3d3216c\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"cc440545-8002-5ed8-aa58-849ba3d3216c\" :answer/validate] [:db/add \"917617eb-968c-51da-8a65-27c8dc62b077\" :answer/id #uuid \"917617eb-968c-51da-8a65-27c8dc62b077\"] [:db/add \"917617eb-968c-51da-8a65-27c8dc62b077\" :answer/type :answer.type/math] [:db/add \"917617eb-968c-51da-8a65-27c8dc62b077\" :answer/value \"\\\\frac{1}{8}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"917617eb-968c-51da-8a65-27c8dc62b077\" :answer/validate] [:db/add \"7fdfdfdb-d6e8-53a1-b19f-0e2c8cb9c6d2\" :answer/id #uuid \"7fdfdfdb-d6e8-53a1-b19f-0e2c8cb9c6d2\"] [:db/add \"7fdfdfdb-d6e8-53a1-b19f-0e2c8cb9c6d2\" :answer/type :answer.type/math] [:db/add \"7fdfdfdb-d6e8-53a1-b19f-0e2c8cb9c6d2\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"7fdfdfdb-d6e8-53a1-b19f-0e2c8cb9c6d2\" :answer/validate] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/id #uuid \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\"] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/key \"answer\"] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/type :answer-field.type/radio] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/choices \"722ac779-7083-5a49-83f8-aaaaa2b80e42\"] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/choices \"84d26cec-bf95-52a4-82c6-191bf6e0248c\"] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/choices \"cc440545-8002-5ed8-aa58-849ba3d3216c\"] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/choices \"917617eb-968c-51da-8a65-27c8dc62b077\"] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/choices \"7fdfdfdb-d6e8-53a1-b19f-0e2c8cb9c6d2\"] [:db/add \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/correct \"722ac779-7083-5a49-83f8-aaaaa2b80e42\"] [:db/ensure \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\" :answer-field/validate] [:db/add \"e9837837-4dfe-557d-bb99-4d563c43757b\" :question/id #uuid \"e9837837-4dfe-557d-bb99-4d563c43757b\"] [:db/add \"e9837837-4dfe-557d-bb99-4d563c43757b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e9837837-4dfe-557d-bb99-4d563c43757b\" :question/worked-solution \"Let $u=\\\\frac{4 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{4}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 16 x^{2}}=3\\\\sqrt{1-(\\\\frac{4 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{3}\\\\cdot \\\\frac{3}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{9 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"e9837837-4dfe-557d-bb99-4d563c43757b\" :question/difficulty :question.difficulty/hard] [:db/add \"e9837837-4dfe-557d-bb99-4d563c43757b\" :question/answer-fields \"ba45e3fa-5a75-57a1-9d67-fb7109b2d239\"] [:db/ensure \"e9837837-4dfe-557d-bb99-4d563c43757b\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"e9837837-4dfe-557d-bb99-4d563c43757b\"] [:db/add \"0d74a0bc-6669-5dc1-a7aa-7c6914dc8b72\" :answer/id #uuid \"0d74a0bc-6669-5dc1-a7aa-7c6914dc8b72\"] [:db/add \"0d74a0bc-6669-5dc1-a7aa-7c6914dc8b72\" :answer/type :answer.type/math] [:db/add \"0d74a0bc-6669-5dc1-a7aa-7c6914dc8b72\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"0d74a0bc-6669-5dc1-a7aa-7c6914dc8b72\" :answer/validate] [:db/add \"85a9477d-631e-54f9-ad68-90931c4e5e95\" :answer/id #uuid \"85a9477d-631e-54f9-ad68-90931c4e5e95\"] [:db/add \"85a9477d-631e-54f9-ad68-90931c4e5e95\" :answer/type :answer.type/math] [:db/add \"85a9477d-631e-54f9-ad68-90931c4e5e95\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"85a9477d-631e-54f9-ad68-90931c4e5e95\" :answer/validate] [:db/add \"23bf9b35-76c9-5566-a5b2-bef24abb7312\" :answer/id #uuid \"23bf9b35-76c9-5566-a5b2-bef24abb7312\"] [:db/add \"23bf9b35-76c9-5566-a5b2-bef24abb7312\" :answer/type :answer.type/math] [:db/add \"23bf9b35-76c9-5566-a5b2-bef24abb7312\" :answer/value \"\\\\frac{1}{2}\\\\left(\\\\arcsin{\\\\left(4 x \\\\right)}\\\\right)+C\"] [:db/ensure \"23bf9b35-76c9-5566-a5b2-bef24abb7312\" :answer/validate] [:db/add \"1db1ac4b-da39-5be2-8b5f-1f8334b730dc\" :answer/id #uuid \"1db1ac4b-da39-5be2-8b5f-1f8334b730dc\"] [:db/add \"1db1ac4b-da39-5be2-8b5f-1f8334b730dc\" :answer/type :answer.type/math] [:db/add \"1db1ac4b-da39-5be2-8b5f-1f8334b730dc\" :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"1db1ac4b-da39-5be2-8b5f-1f8334b730dc\" :answer/validate] [:db/add \"54fb07c6-b2cc-5105-be5b-8391129ca9d4\" :answer/id #uuid \"54fb07c6-b2cc-5105-be5b-8391129ca9d4\"] [:db/add \"54fb07c6-b2cc-5105-be5b-8391129ca9d4\" :answer/type :answer.type/math] [:db/add \"54fb07c6-b2cc-5105-be5b-8391129ca9d4\" :answer/value \"\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"54fb07c6-b2cc-5105-be5b-8391129ca9d4\" :answer/validate] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/id #uuid \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\"] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/key \"answer\"] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/type :answer-field.type/radio] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/choices \"0d74a0bc-6669-5dc1-a7aa-7c6914dc8b72\"] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/choices \"85a9477d-631e-54f9-ad68-90931c4e5e95\"] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/choices \"23bf9b35-76c9-5566-a5b2-bef24abb7312\"] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/choices \"1db1ac4b-da39-5be2-8b5f-1f8334b730dc\"] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/choices \"54fb07c6-b2cc-5105-be5b-8391129ca9d4\"] [:db/add \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/correct \"54fb07c6-b2cc-5105-be5b-8391129ca9d4\"] [:db/ensure \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\" :answer-field/validate] [:db/add \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\" :question/id #uuid \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\"] [:db/add \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{4 - 16 x^{2}}=2\\\\sqrt{1-(2 x)^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $\\\\frac{1}{2}\\\\cdot \\\\frac{1}{2}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{\\\\sqrt{4 - 16 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\" :question/difficulty :question.difficulty/hard] [:db/add \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\" :question/answer-fields \"ff5050c7-b549-5879-a4b9-e1c7ea1c08cc\"] [:db/ensure \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"a1bf7056-d8a3-5bfc-b4c4-259afae4fff6\"] [:db/add \"b9663600-ee74-5d96-b0ad-3fb5c5e4f8aa\" :answer/id #uuid \"b9663600-ee74-5d96-b0ad-3fb5c5e4f8aa\"] [:db/add \"b9663600-ee74-5d96-b0ad-3fb5c5e4f8aa\" :answer/type :answer.type/math] [:db/add \"b9663600-ee74-5d96-b0ad-3fb5c5e4f8aa\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{4 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"b9663600-ee74-5d96-b0ad-3fb5c5e4f8aa\" :answer/validate] [:db/add \"c9c0a9ca-5468-5a4d-bbbc-6b0183d32c9c\" :answer/id #uuid \"c9c0a9ca-5468-5a4d-bbbc-6b0183d32c9c\"] [:db/add \"c9c0a9ca-5468-5a4d-bbbc-6b0183d32c9c\" :answer/type :answer.type/math] [:db/add \"c9c0a9ca-5468-5a4d-bbbc-6b0183d32c9c\" :answer/value \"\\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"c9c0a9ca-5468-5a4d-bbbc-6b0183d32c9c\" :answer/validate] [:db/add \"ec9ada74-9f98-5a25-849e-652bf59770cd\" :answer/id #uuid \"ec9ada74-9f98-5a25-849e-652bf59770cd\"] [:db/add \"ec9ada74-9f98-5a25-849e-652bf59770cd\" :answer/type :answer.type/math] [:db/add \"ec9ada74-9f98-5a25-849e-652bf59770cd\" :answer/value \"- \\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"ec9ada74-9f98-5a25-849e-652bf59770cd\" :answer/validate] [:db/add \"878c1c4e-c46e-5a68-b7ba-4c64f162a149\" :answer/id #uuid \"878c1c4e-c46e-5a68-b7ba-4c64f162a149\"] [:db/add \"878c1c4e-c46e-5a68-b7ba-4c64f162a149\" :answer/type :answer.type/math] [:db/add \"878c1c4e-c46e-5a68-b7ba-4c64f162a149\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"878c1c4e-c46e-5a68-b7ba-4c64f162a149\" :answer/validate] [:db/add \"089fba4e-f78b-5bc4-9d42-ced6385b4803\" :answer/id #uuid \"089fba4e-f78b-5bc4-9d42-ced6385b4803\"] [:db/add \"089fba4e-f78b-5bc4-9d42-ced6385b4803\" :answer/type :answer.type/math] [:db/add \"089fba4e-f78b-5bc4-9d42-ced6385b4803\" :answer/value \"\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{x}{3} \\\\right)}\\\\right)+C\"] [:db/ensure \"089fba4e-f78b-5bc4-9d42-ced6385b4803\" :answer/validate] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/id #uuid \"cf293a22-6792-5aaf-9cdc-3621ff704f81\"] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/key \"answer\"] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/type :answer-field.type/radio] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/choices \"b9663600-ee74-5d96-b0ad-3fb5c5e4f8aa\"] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/choices \"c9c0a9ca-5468-5a4d-bbbc-6b0183d32c9c\"] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/choices \"ec9ada74-9f98-5a25-849e-652bf59770cd\"] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/choices \"878c1c4e-c46e-5a68-b7ba-4c64f162a149\"] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/choices \"089fba4e-f78b-5bc4-9d42-ced6385b4803\"] [:db/add \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/correct \"878c1c4e-c46e-5a68-b7ba-4c64f162a149\"] [:db/ensure \"cf293a22-6792-5aaf-9cdc-3621ff704f81\" :answer-field/validate] [:db/add \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\" :question/id #uuid \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\"] [:db/add \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\" :question/worked-solution \"Let $u=\\\\frac{2 x}{3}$. Then $\\\\mathrm{d}u=(\\\\frac{2}{3})\\\\,\\\\mathrm{d}x$.\\n\\nFactor the constant in the denominator:\\n\\n$$\\n\\\\sqrt{9 - 4 x^{2}}=3\\\\sqrt{1-(\\\\frac{2 x}{3})^2}.\\n$$\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{3}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{3}{2}=\\\\frac{3}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{\\\\sqrt{9 - 4 x^{2}}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u=\\\\arcsin{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{1 - u^{2}}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\arcsin{\\\\left(\\\\frac{2 x}{3} \\\\right)}\\\\right)+C.\\n$$\"] [:db/add \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\" :question/difficulty :question.difficulty/hard] [:db/add \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\" :question/answer-fields \"cf293a22-6792-5aaf-9cdc-3621ff704f81\"] [:db/ensure \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\" :question/validate] [:db/add 17592186064218 :knowledge-point/questions \"dfc32bf8-6ace-5e48-bc5e-92e930371a4c\"] [:db/add \"68000a08-75fb-51a6-8bc1-784b7354d8e9\" :answer/id #uuid \"68000a08-75fb-51a6-8bc1-784b7354d8e9\"] [:db/add \"68000a08-75fb-51a6-8bc1-784b7354d8e9\" :answer/type :answer.type/math] [:db/add \"68000a08-75fb-51a6-8bc1-784b7354d8e9\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(x \\\\right)}\\\\right)+C\"] [:db/ensure \"68000a08-75fb-51a6-8bc1-784b7354d8e9\" :answer/validate] [:db/add \"59953fda-9f3a-57b7-9787-54da2829967f\" :answer/id #uuid \"59953fda-9f3a-57b7-9787-54da2829967f\"] [:db/add \"59953fda-9f3a-57b7-9787-54da2829967f\" :answer/type :answer.type/math] [:db/add \"59953fda-9f3a-57b7-9787-54da2829967f\" :answer/value \"- \\\\frac{3}{4}\\\\left(\\\\arcsin{\\\\left(2 x \\\\right)}\\\\right)+C\"] [:db/ensure \"59953fda-9f3a-57b7-9787-54da2829967f\" :answer/validate] [:db/add \"40bea2e8-abb7-5b3f-a487-a49abda29448\" :answer/id #uuid \"40bea2e8-abb7-5b3f-a487-a49abda29448\"] [:db/add \"40bea2e8-abb7-5b3f-a487-a49abda29448\" :answer/type :answer.type/math] [:db/add \"40bea2e8-abb7-5b3f-a487-a49abda