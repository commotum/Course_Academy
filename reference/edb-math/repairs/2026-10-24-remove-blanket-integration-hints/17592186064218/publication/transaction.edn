\frac{x}{5} \\right)}\\right)+C.\n$$"] [:db/add "d8bfa756-584c-546f-9389-10257daa4f6d" :question/difficulty :question.difficulty/moderate] [:db/add "d8bfa756-584c-546f-9389-10257daa4f6d" :question/answer-fields "72bc4f11-89b1-5fbb-ba82-8a9042d5fdc3"] [:db/ensure "d8bfa756-584c-546f-9389-10257daa4f6d" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "d8bfa756-584c-546f-9389-10257daa4f6d"] [:db/add "eb72ac2b-a8b7-56ac-8caa-7da4014bb176" :answer/id #uuid "eb72ac2b-a8b7-56ac-8caa-7da4014bb176"] [:db/add "eb72ac2b-a8b7-56ac-8caa-7da4014bb176" :answer/type :answer.type/math] [:db/add "eb72ac2b-a8b7-56ac-8caa-7da4014bb176" :answer/value "4\\left(\\arcsin{\\left(\\frac{x}{4} \\right)}\\right)+C"] [:db/ensure "eb72ac2b-a8b7-56ac-8caa-7da4014bb176" :answer/validate] [:db/add "3ca1c617-13fb-5c53-9416-b64ff2367c83" :answer/id #uuid "3ca1c617-13fb-5c53-9416-b64ff2367c83"] [:db/add "3ca1c617-13fb-5c53-9416-b64ff2367c83" :answer/type :answer.type/math] [:db/add "3ca1c617-13fb-5c53-9416-b64ff2367c83" :answer/value "2\\left(\\arcsin{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "3ca1c617-13fb-5c53-9416-b64ff2367c83" :answer/validate] [:db/add "ffda49a3-3f8e-5cd9-8110-12e774b9a2fe" :answer/id #uuid "ffda49a3-3f8e-5cd9-8110-12e774b9a2fe"] [:db/add "ffda49a3-3f8e-5cd9-8110-12e774b9a2fe" :answer/type :answer.type/math] [:db/add "ffda49a3-3f8e-5cd9-8110-12e774b9a2fe" :answer/value "4\\left(\\arcsin{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "ffda49a3-3f8e-5cd9-8110-12e774b9a2fe" :answer/validate] [:db/add "1ecf4203-cceb-518f-8138-53ab7be26e9c" :answer/id #uuid "1ecf4203-cceb-518f-8138-53ab7be26e9c"] [:db/add "1ecf4203-cceb-518f-8138-53ab7be26e9c" :answer/type :answer.type/math] [:db/add "1ecf4203-cceb-518f-8138-53ab7be26e9c" :answer/value "8\\left(\\arcsin{\\left(\\frac{x}{2} \\right)}\\right)+C"] [:db/ensure "1ecf4203-cceb-518f-8138-53ab7be26e9c" :answer/validate] [:db/add "738a424f-da3b-5c24-9ddb-bde3f82115e8" :answer/id #uuid "738a424f-da3b-5c2