[[:db/add "9546d0a3-3833-53ce-901a-acef02be3cae" :answer/id #uuid "9546d0a3-3833-53ce-901a-acef02be3cae"] [:db/add "9546d0a3-3833-53ce-901a-acef02be3cae" :answer/type :answer.type/math] [:db/add "9546d0a3-3833-53ce-901a-acef02be3cae" :answer/value "\\frac{5^{x^{2} + 2}}{\\ln{\\left(5 \\right)}}"] [:db/ensure "9546d0a3-3833-53ce-901a-acef02be3cae" :answer/validate] [:db/add "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e" :answer-field/id #uuid "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e"] [:db/add "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e" :answer-field/key "answer"] [:db/add "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e" :answer-field/type :answer-field.type/blank] [:db/add "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e" :answer-field/choices "9546d0a3-3833-53ce-901a-acef02be3cae"] [:db/add "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e" :answer-field/correct "9546d0a3-3833-53ce-901a-acef02be3cae"] [:db/ensure "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e" :answer-field/validate] [:db/add "1898d626-72c7-56d3-8a6b-3c2da1bca302" :question/id #uuid "1898d626-72c7-56d3-8a6b-3c2da1bca302"] [:db/add "1898d626-72c7-56d3-8a6b-3c2da1bca302" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 \\cdot 5^{x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "1898d626-72c7-56d3-8a6b-3c2da1bca302" :question/worked-solution "Let $u=x^{2} + 2$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 \\cdot 5^{x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\int 5^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C.\n$$\n\n$$\n\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{5^{x^{2} + 2}}{\\ln{\\left(5 \\right)}}+C.\n$$"] [:db/add "1898d626-72c7-56d3-8a6b-3c2da1bca302" :question/difficulty :question.difficulty/moderate] [:db/add "1898d626-72c7-56d3-8a6b-3c2da1bca302" :question/answer-fields "fb3bbebe-f98e-5bb4-8c5b-2deaa93fe59e"] [:db/ensure "1898d626-72c7-56d3-8a6b-3c2da1bca302" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "1898d626-72c7-56d3-8a6b-3c2da1bca302"] [:db/add "67707ceb-6697-578d-b856-335b78ba8fd5" :answer/id #uuid "67707ceb-6697-578d-b856-335b78ba8fd5"] [:db/add "67707ceb-6697-578d-b856-335b78ba8fd5" :answer/type :answer.type/math] [:db/add "67707ceb-6697-578d-b856-335b78ba8fd5" :answer/value "\\frac{1}{3}\\left(\\frac{5^{x^{3}}}{\\ln{\\left(5 \\right)}}\\right)"] [:db/ensure "67707ceb-6697-578d-b856-335b78ba8fd5" :answer/validate] [:db/add "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb" :answer-field/id #uuid "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb"] [:db/add "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb" :answer-field/key "answer"] [:db/add "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb" :answer-field/type :answer-field.type/blank] [:db/add "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb" :answer-field/choices "67707ceb-6697-578d-b856-335b78ba8fd5"] [:db/add "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb" :answer-field/correct "67707ceb-6697-578d-b856-335b78ba8fd5"] [:db/ensure "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb" :answer-field/validate] [:db/add "f8595572-e87a-5ca7-862d-a74e226b68c3" :question/id #uuid "f8595572-e87a-5ca7-862d-a74e226b68c3"] [:db/add "f8595572-e87a-5ca7-862d-a74e226b68c3" :question/problem "Find an antiderivative.\n\n$$\n\\int 5^{x^{3}} x^{2}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "f8595572-e87a-5ca7-862d-a74e226b68c3" :question/worked-solution "Let $u=x^{3}$. Then $\\mathrm{d}u=(3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 5^{x^{3}} x^{2}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C.\n$$\n\n$$\n\\frac{1}{3}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{3}\\left(\\frac{5^{u}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{3}\\left(\\frac{5^{x^{3}}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$"] [:db/add "f8595572-e87a-5ca7-862d-a74e226b68c3" :question/difficulty :question.difficulty/moderate] [:db/add "f8595572-e87a-5ca7-862d-a74e226b68c3" :question/answer-fields "f39dc10c-b3bb-5528-ae6c-bef5b79d64cb"] [:db/ensure "f8595572-e87a-5ca7-862d-a74e226b68c3" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "f8595572-e87a-5ca7-862d-a74e226b68c3"] [:db/add "dafbcda9-25ea-50f1-b091-b2b4ac54ccfb" :answer/id #uuid "dafbcda9-25ea-50f1-b091-b2b4ac54ccfb"] [:db/add "dafbcda9-25ea-50f1-b091-b2b4ac54ccfb" :answer/type :answer.type/math] [:db/add "dafbcda9-25ea-50f1-b091-b2b4ac54ccfb" :answer/value "\\frac{1}{4}\\left(\\frac{3^{2 x^{2} + 1}}{\\ln{\\left(3 \\right)}}\\right)"] [:db/ensure "dafbcda9-25ea-50f1-b091-b2b4ac54ccfb" :answer/validate] [:db/add "fb31adc0-7252-50e6-b90f-b68475349a5d" :answer-field/id #uuid "fb31adc0-7252-50e6-b90f-b68475349a5d"] [:db/add "fb31adc0-7252-50e6-b90f-b68475349a5d" :answer-field/key "answer"] [:db/add "fb31adc0-7252-50e6-b90f-b68475349a5d" :answer-field/type :answer-field.type/blank] [:db/add "fb31adc0-7252-50e6-b90f-b68475349a5d" :answer-field/choices "dafbcda9-25ea-50f1-b091-b2b4ac54ccfb"] [:db/add "fb31adc0-7252-50e6-b90f-b68475349a5d" :answer-field/correct "dafbcda9-25ea-50f1-b091-b2b4ac54ccfb"] [:db/ensure "fb31adc0-7252-50e6-b90f-b68475349a5d" :answer-field/validate] [:db/add "a79c698d-aa8a-5c1a-a47d-a7699e987c74" :question/id #uuid "a79c698d-aa8a-5c1a-a47d-a7699e987c74"] [:db/add "a79c698d-aa8a-5c1a-a47d-a7699e987c74" :question/problem "Find an antiderivative.\n\n$$\n\\int 3^{2 x^{2} + 1} x\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "a79c698d-aa8a-5c1a-a47d-a7699e987c74" :question/worked-solution "Let $u=2 x^{2} + 1$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3^{2 x^{2} + 1} x\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C.\n$$\n\n$$\n\\frac{1}{4}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right)=\\frac{1}{4}\\left(\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{4}\\left(\\frac{3^{2 x^{2} + 1}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$"] [:db/add "a79c698d-aa8a-5c1a-a47d-a7699e987c74" :question/difficulty :question.difficulty/moderate] [:db/add "a79c698d-aa8a-5c1a-a47d-a7699e987c74" :question/answer-fields "fb31adc0-7252-50e6-b90f-b68475349a5d"] [:db/ensure "a79c698d-aa8a-5c1a-a47d-a7699e987c74" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "a79c698d-aa8a-5c1a-a47d-a7699e987c74"] [:db/add "40c43222-85bb-5afc-81ad-93437117477f" :answer/id #uuid "40c43222-85bb-5afc-81ad-93437117477f"] [:db/add "40c43222-85bb-5afc-81ad-93437117477f" :answer/type :answer.type/math] [:db/add "40c43222-85bb-5afc-81ad-93437117477f" :answer/value "\\frac{2}{3}\\left(\\frac{3^{x^{3} + 1}}{\\ln{\\left(3 \\right)}}\\right)"] [:db/ensure "40c43222-85bb-5afc-81ad-93437117477f" :answer/validate] [:db/add "283d50df-027e-5483-8b65-baa866db8d7f" :answer-field/id #uuid "283d50df-027e-5483-8b65-baa866db8d7f"] [:db/add "283d50df-027e-5483-8b65-baa866db8d7f" :answer-field/key "answer"] [:db/add "283d50df-027e-5483-8b65-baa866db8d7f" :answer-field/type :answer-field.type/blank] [:db/add "283d50df-027e-5483-8b65-baa866db8d7f" :answer-field/choices "40c43222-85bb-5afc-81ad-93437117477f"] [:db/add "283d50df-027e-5483-8b65-baa866db8d7f" :answer-field/correct "40c43222-85bb-5afc-81ad-93437117477f"] [:db/ensure "283d50df-027e-5483-8b65-baa866db8d7f" :answer-field/validate] [:db/add "6941e475-e2c8-55fc-9046-07b89f3e32ac" :question/id #uuid "6941e475-e2c8-55fc-9046-07b89f3e32ac"] [:db/add "6941e475-e2c8-55fc-9046-07b89f3e32ac" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 \\cdot 3^{x^{3} + 1} x^{2}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "6941e475-e2c8-55fc-9046-07b89f3e32ac" :question/worked-solution "Let $u=x^{3} + 1$. Then $\\mathrm{d}u=(3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 \\cdot 3^{x^{3} + 1} x^{2}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C.\n$$\n\n$$\n\\frac{2}{3}\\left(\\int 3^{u}\\,\\mathrm{d}u\\right)=\\frac{2}{3}\\left(\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{3}\\left(\\frac{3^{x^{3} + 1}}{\\ln{\\left(3 \\right)}}\\right)+C.\n$$"] [:db/add "6941e475-e2c8-55fc-9046-07b89f3e32ac" :question/difficulty :question.difficulty/moderate] [:db/add "6941e475-e2c8-55fc-9046-07b89f3e32ac" :question/answer-fields "283d50df-027e-5483-8b65-baa866db8d7f"] [:db/ensure "6941e475-e2c8-55fc-9046-07b89f3e32ac" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "6941e475-e2c8-55fc-9046-07b89f3e32ac"] [:db/add "c3f411c2-3b85-54af-b0a9-b821bea620ef" :answer/id #uuid "c3f411c2-3b85-54af-b0a9-b821bea620ef"] [:db/add "c3f411c2-3b85-54af-b0a9-b821bea620ef" :answer/type :answer.type/math] [:db/add "c3f411c2-3b85-54af-b0a9-b821bea620ef" :answer/value "\\frac{2^{2 x^{2} + 3}}{\\ln{\\left(2 \\right)}}"] [:db/ensure "c3f411c2-3b85-54af-b0a9-b821bea620ef" :answer/validate] [:db/add "b69a5ad7-675c-58ca-bca9-f31634520e2d" :answer-field/id #uuid "b69a5ad7-675c-58ca-bca9-f31634520e2d"] [:db/add "b69a5ad7-675c-58ca-bca9-f31634520e2d" :answer-field/key "answer"] [:db/add "b69a5ad7-675c-58ca-bca9-f31634520e2d" :answer-field/type :answer-field.type/blank] [:db/add "b69a5ad7-675c-58ca-bca9-f31634520e2d" :answer-field/choices "c3f411c2-3b85-54af-b0a9-b821bea620ef"] [:db/add "b69a5ad7-675c-58ca-bca9-f31634520e2d" :answer-field/correct "c3f411c2-3b85-54af-b0a9-b821bea620ef"] [:db/ensure "b69a5ad7-675c-58ca-bca9-f31634520e2d" :answer-field/validate] [:db/add "7746da8f-70