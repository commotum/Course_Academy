lty/hard] [:db/add "90977ace-1fa5-5078-93a2-c5eab441a8e9" :question/answer-fields "b399cb7e-07d5-5c73-b091-7d6161716cd5"] [:db/ensure "90977ace-1fa5-5078-93a2-c5eab441a8e9" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "90977ace-1fa5-5078-93a2-c5eab441a8e9"] [:db/add "deee0061-e7e4-586e-b3c9-3f6e1dbd9489" :answer/id #uuid "deee0061-e7e4-586e-b3c9-3f6e1dbd9489"] [:db/add "deee0061-e7e4-586e-b3c9-3f6e1dbd9489" :answer/type :answer.type/math] [:db/add "deee0061-e7e4-586e-b3c9-3f6e1dbd9489" :answer/value "-1\\left(\\frac{5^{- x^{2}}}{\\ln{\\left(5 \\right)}}\\right)"] [:db/ensure "deee0061-e7e4-586e-b3c9-3f6e1dbd9489" :answer/validate] [:db/add "c62b90b2-b172-57ec-a784-8725557694b0" :answer-field/id #uuid "c62b90b2-b172-57ec-a784-8725557694b0"] [:db/add "c62b90b2-b172-57ec-a784-8725557694b0" :answer-field/key "answer"] [:db/add "c62b90b2-b172-57ec-a784-8725557694b0" :answer-field/type :answer-field.type/blank] [:db/add "c62b90b2-b172-57ec-a784-8725557694b0" :answer-field/choices "deee0061-e7e4-586e-b3c9-3f6e1dbd9489"] [:db/add "c62b90b2-b172-57ec-a784-8725557694b0" :answer-field/correct "deee0061-e7e4-586e-b3c9-3f6e1dbd9489"] [:db/ensure "c62b90b2-b172-57ec-a784-8725557694b0" :answer-field/validate] [:db/add "7df17760-71c4-5fce-bb06-bbd9c14ecc92" :question/id #uuid "7df17760-71c4-5fce-bb06-bbd9c14ecc92"] [:db/add "7df17760-71c4-5fce-bb06-bbd9c14ecc92" :question/problem "Find an antiderivative.\n\n$$\n\\int 2 \\cdot 5^{- x^{2}} x\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "7df17760-71c4-5fce-bb06-bbd9c14ecc92" :question/worked-solution "Let $u=- x^{2}$. Then $\\mathrm{d}u=(- 2 x)\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 \\cdot 5^{- x^{2}} x\\,\\mathrm{d}x\\\\&=-1\\left(\\int 5^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C.\n$$\n\n$$\n-1\\left(\\int 5^{u}\\,\\mathrm{d}u\\right)=-1\\left(\\frac{5^{u}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n-1\\left(\\frac{5^{- x^{2}}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$"] [:db/add "7df17760-71c4-5fce-bb06-bbd9c14ecc92" :question/difficulty :question.difficulty/hard] [:db/add "7df17760-71c4-5fce-bb06-bbd9c14ecc92" :question/answer-fields "c62b90b2-b172-57ec-a784-8725557694b0"] [:db/ensure "7df17760-71c4-5fce-bb06-bbd9c14ecc92" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "7df17760-71c4-5fce-bb06-bbd9c14ecc92"] [:db/add "3b3321aa-5851-5599-8c6f-a80afe4483ae" :answer/id #uuid "3b3321aa-5851-5599-8c6f-a80afe4483ae"] [:db/add "3b3321aa-5851-5599-8c6f-a80afe4483ae" :answer/type :answer.type/math] [:db/add "3b3321aa-5851-5599-8c6f-a80afe4483ae" :answer/value "- \\frac{4}{3}\\left(\\frac{5^{2 - x^{3}}}{\\ln{\\left(5 \\right)}}\\right)"] [:db/ensure "3b3321aa-5851-5599-8c6f-a80afe4483ae" :answer/validate] [:db/add "0612426d-9944-5b56-9d4b-d98ca50672f7" :answer-field/id #uuid "0612426d-9944-5b56-9d4b-d98ca50672f7"] [:db/add "0612426d-9944-5b56-9d4b-d98ca50672f7" :answer-field/key "answer"] [:db/add "0612426d-9944-5b56-9d4b-d98ca50672f7" :answer-field/type :answer-field.type/blank] [:db/add "0612426d-9944-5b56-9d4b-d98ca50672f7" :answer-field/choices "3b3321aa-5851-5599-8c6f-a80afe4483ae"] [:db/add "0612426d-9944-5b56-9d4b-d98ca50672f7" :answer-field/correct "3b3321aa-5851-5599-8c6f-a80afe4483ae"] [:db/ensure "0612426d-9944-5b56-9d4b-d98ca50672f7" :answer-field/validate] [:db/add "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c" :question/id #uuid "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c"] [:db/add "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cdot 5^{2 - x^{3}} x^{2}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c" :question/worked-solution "Let $u=2 - x^{3}$. Then $\\mathrm{d}u=(- 3 x^{2})\\,\\mathrm{d}x$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cdot 5^{2 - x^{3}} x^{2}\\,\\mathrm{d}x\\\\&=- \\frac{4}{3}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C.\n$$\n\n$$\n- \\frac{4}{3}\\left(\\int 5^{u}\\,\\mathrm{d}u\\right)=- \\frac{4}{3}\\left(\\frac{5^{u}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{4}{3}\\left(\\frac{5^{2 - x^{3}}}{\\ln{\\left(5 \\right)}}\\right)+C.\n$$"] [:db/add "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c" :question/difficulty :question.difficulty/hard] [:db/add "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c" :question/answer-fields "0612426d-9944-5b56-9d4b-d98ca50672f7"] [:db/ensure "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "5f6bec19-2b35-5f73-a91f-fdd6e8a1cf7c"] [:db/add "7bd03977-368b-5862-b214-324ed33c3361" :answer/id #uuid "7bd03977-368b-5862-b214-324ed33c3361"] [:db/add "7bd03977-368b-5862-b214-324ed33c3361" :answer/type :answer.type/math] [:db/add "7bd03977-368b-5862-b214-324ed33c3361" :answer/value "- \\frac{1}{4}\\left(\\frac{2^{2 - 2 x^{2}}}{\\ln{\\left(2 \\right)}}\\right)"] [:db/ensure "7bd03977-368b-5862-b214-324ed33c3361" :answer/validate] [:db/add "590cfd08-a1d1-5e22-a922-50409c4cec92" :answer-field/id #uuid "590cfd08-a1d1-5e22-a922-50409c4cec92"] [:db/add "590cfd08-a1d1-5e22-a922-50409c4cec92" :answer-field/key "answer"] [:db/add "590cfd08-a1d1-5e22-a922-50409c4cec92" :answer-field/type :answer-field.type/blank] [:db/add "590cfd08-a1d1-5e22-a922-50409c4cec92" :answer-field/choices "7bd03977-368b-5862-b214-324ed33c3361"] [:db/add "590cfd08-a1d1-5e22-a922-50409c4cec92" :answer-field/correct "7bd03977-368b-5862-b214-324ed33c3361"] [:db/ensure "590cfd08-a1d1-5e22-a922-50409c4cec92" :answer-field/validate] [:db/add "7593621f-52dc-55c7-bc26-c7f5be2cbb08" :question/id #uuid "7593621f-52dc-55c7-bc26-c7f5be2cbb08"] [:db/add "7593621f-52dc-55c7-bc26-c7f5be2cbb08" :question/problem "Find an antideri