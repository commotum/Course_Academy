  "before_edn": "{:db/id 17592186068916 :knowledge-point/canonical-example {:db/id 17592186068568 :question/id #uuid \"daf5cc74-4c7d-500a-9345-03bd6b73a333\" :question/math-academy-id \"e-465\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle\\\\int 5 \\\\csc {\\\\left(6x+\\\\dfrac \\\\pi 3\\\\right)} \\\\cot {\\\\left(6x+\\\\dfrac \\\\pi 3\\\\right)} \\\\,  \\\\textrm{d}x.\\n$$\" :question/worked-solution \"If we let $u=6x+\\\\dfrac \\\\pi 3,$ then\\n\\n$$\\n\\\\dfrac{\\\\textrm d u}{\\\\textrm d x} = 6\\\\quad\\\\Longrightarrow\\\\quad \\\\textrm d x =\\\\dfrac 1 6\\\\, \\\\textrm d u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 5\\\\operatorname{csc}⁡(6x+\\\\frac{\\\\pi }{3})\\\\operatorname{cot}⁡(6x+\\\\frac{\\\\pi }{3})\\\\,\\\\text{d}x & =5\\\\int \\\\operatorname{csc}⁡(6x+\\\\frac{\\\\pi }{3})\\\\operatorname{cot}⁡(6x+\\\\frac{\\\\pi }{3})\\\\,\\\\text{d}x \\\\\\\\  & =5\\\\int \\\\operatorname{csc}⁡u\\\\operatorname{cot}⁡u\\\\cdot \\\\frac{1}{6}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{6}\\\\int \\\\operatorname{csc}⁡u\\\\operatorname{cot}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{5}{6}\\\\operatorname{csc}⁡u+C \\\\\\\\  & =-\\\\frac{5}{6}\\\\operatorname{csc}⁡(6x+\\\\frac{\\\\pi }{3})+C\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"084eb4cc-2f84-5288-90a6-be84066922b6\" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186678238 :question-generator/id #uuid \"cf8e6e6b-7618-5de6-909b-13472525e782\" :question-generator/script \"generators/8a/8abaf17a755fc8ff2c813773cfc573b02b77e2f0b533e8a710a46007e32f0733/generator.py\"} :knowledge-point/questions [{:db/id 17592186069004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"00a40602-52d1-5dc9-8e31-c35464767acf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{7}\\\\operatorname{sec}⁡(7x)+C\" :db/id 17592186235799} {:answer/id #uuid \"3eec2768-c2bf-5731-b512-c6df48d8bb5c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sec}⁡(7x)+C\" :db/id 17592186236217} {:answer/id #uuid \"4e578f69-909a-523b-8577-e3cdb3de2088\" :answer/type {:db/ident :answer.type/math} :answer/value \"-7\\\\operatorname{sec}⁡(7x)+C\" :db/id 17592186236318} {:answer/id #uuid \"d4240689-1a4e-5384-9ef2-fdfe11a2085d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{7}\\\\operatorname{sec}⁡(7x)+C\" :db/id 17592186237156} {:answer/id #uuid \"e779e3e4-8675-5338-a515-5145e18de6ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\operatorname{sec}⁡(7x)+C\" :db/id 17592186237271}] :answer-field/correct {:answer/id #uuid \"00a40602-52d1-5dc9-8e31-c35464767acf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{7}\\\\operatorname{sec}⁡(7x)+C\" :db/id 17592186235799} :answer-field/id #uuid \"ea812aef-b957-50aa-a86e-5bc828f0e956\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186237741}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"8ab6145f-e13a-585c-bc5c-d4f390fce17e\" :question/math-academy-id \"q-10143\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\operatorname{sec}⁡(7x)\\\\operatorname{tan}⁡(7x)\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"If we let $u=7x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=7\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{7}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\operatorname{sec}⁡(7x)\\\\operatorname{tan}⁡(7x)\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\cdot \\\\frac{1}{7}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{7}\\\\int \\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{7}\\\\operatorname{sec}⁡u+C \\\\\\\\  & =\\\\frac{1}{7}\\\\operatorname{sec}⁡(7x)+C\\\\end{aligned}\\n$$\"} {:db/id 17592186069006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f85cf725-3237-5c2c-aa64-a45c7c2a4c32\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\csc (8x) + C\" :db/id 17592186065470} {:answer/id #uuid \"f8a92f4d-c241-5c04-a633-0e1a6d38dbbd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\csc (8x) + C\" :db/id 17592186065471} {:answer/id #uuid \"1639954a-f29a-5655-9185-4c5ede14b2a1\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\csc (8x) + C\" :db/id 17592186065472} {:answer/id #uuid \"3f09ad16-8c32-567b-88f6-1ca96ba704c6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{8}\\\\csc (8x) + C\" :db/id 17592186065473} {:answer/id #uuid \"4ff43ea7-a48a-5ab2-b9b1-77d7fc4ac4c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"-8\\\\csc (8x) + C\" :db/id 17592186065474}] :answer-field/id #uuid \"1ec74542-ab43-577e-9fef-7369f259e3e0\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186065469}] :question/id #uuid \"f0f4b98b-3f84-50e2-bc7f-218a4abdb553\" :question/math-academy-id \"q-10157\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int\\\\csc (8x)\\\\cot (8x)dx.\\n$$\"} {:db/id 17592186250146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"33da3ed1-1777-5bf4-8cfc-9e5a29ccb4c8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{tan}^{3}⁡x}{3}+\\\\operatorname{tan}⁡x+C\" :db/id 17592186247891} {:answer/id #uuid \"62494273-c0c0-5f7f-8ebb-533f7f201a63\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{sec}^{2}⁡x}{2}+C\" :db/id 17592186248310} {:answer/id #uuid \"89765658-5c5b-5edc-a80e-0d5330eacbc6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{sec}^{3}⁡x}{3}+\\\\operatorname{sec}⁡x+C\" :db/id 17592186248646} {:answer/id #uuid \"8df579a6-b4b7-59be-810b-4b8fd64e8efe\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{sec}^{3}⁡x}{3}+C\" :db/id 17592186248688} {:answer/id #uuid \"ce4aa2aa-cecd-5b62-ae9a-109027768536\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{tan}^{3}⁡x}{3}+\\\\operatorname{sec}⁡x+C\" :db/id 17592186249252}] :answer-field/correct {:answer/id #uuid \"89765658-5c5b-5edc-a80e-0d5330eacbc6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{sec}^{3}⁡x}{3}+\\\\operatorname{sec}⁡x+C\" :db/id 17592186248646} :answer-field/id #uuid \"812aa8aa-0438-595b-bab8-2d74de8d3b64\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249894}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"9801153f-b480-580e-a696-7b55c194e174\" :question/math-academy-id \"q-113983\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int ({sec}^{2}⁡x+1)\\\\operatorname{sec}⁡x\\\\operatorname{tan}⁡x\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"If we let $u=\\\\operatorname{sec}⁡x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\operatorname{sec}⁡x\\\\operatorname{tan}⁡x\\\\,⟹\\\\,\\\\operatorname{sec}⁡x\\\\operatorname{tan}⁡x\\\\,\\\\text{d}x=\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int ({sec}^{2}⁡x+1)\\\\operatorname{sec}⁡x\\\\operatorname{tan}⁡x\\\\,\\\\text{d}x & =\\\\int ({u}^{2}+1)\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{{u}^{3}}{3}+u+C \\\\\\\\  & =\\\\frac{{sec}^{3}⁡x}{3}+\\\\operatorname{sec}⁡x+C\\\\end{aligned}\\n$$\"} {:db/id 17592186269130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"519b8fb0-5928-5ec9-8613-12c9d1306f72\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186266873} {:answer/id #uuid \"60890db1-c6f4-5143-9b9a-ae422da31c9c\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{3}\" :db/id 17592186266994} {:answer/id #uuid \"87157abc-6212-562b-a343-90c57626ecf4\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2\\\\sqrt{3}}{3}\" :db/id 17592186267338} {:answer/id #uuid \"8b99c65a-2714-56e5-af5f-38d5a8ea0940\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{9}\" :db/id 17592186267396} {:answer/id #uuid \"919ec147-de01-530b-97cb-da754894b913\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}\" :db/id 17592186267439}] :answer-field/correct {:answer/id #uuid \"8b99c65a-2714-56e5-af5f-38d5a8ea0940\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{9}\" :db/id 17592186267396} :answer-field/id #uuid \"8c52e3dd-dd13-5927-892c-f499bebd302f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186268655}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"996adb7b-cb39-5733-9d5d-ec3bcfe1a670\" :question/math-academy-id \"q-13663\" :question/problem \"Evaluate the integral $$\\n\\\\displaystyle {\\\\int }_{\\\\pi /9}^{\\\\pi /6}2{csc}^{2}⁡(3x)\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"If we let $u=3x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{3}\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /9$ | $\\\\pi /6$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /3$ | $\\\\pi /2$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /9}^{\\\\pi /6}2{csc}^{2}⁡(3x)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /3}^{\\\\pi /2}2{csc}^{2}⁡u\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{2}{3}{\\\\int }_{\\\\pi /3}^{\\\\pi /2}{csc}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{2}{3}\\\\operatorname{cot}⁡u{|}_{\\\\pi /3}^{\\\\pi /2} \\\\\\\\  & =-\\\\frac{2}{3}(\\\\operatorname{cot}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right)-\\\\operatorname{cot}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)) \\\\\\\\  & =-\\\\frac{2}{3}(0-\\\\frac{\\\\sqrt{3}}{3}) \\\\\\\\  & =\\\\frac{2\\\\sqrt{3}}{9}\\\\end{aligned}\\n$$\"} {:db/id 17592186290366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5c351233-a918-5f2c-867c-b36c3e634b45\" :answer/type {:db/ident :answer.type/math} :answer/value \"10\\\\operatorname{sec}⁡(10x)+C\" :db/id 17592186288675} {:answer/id #uuid \"6387ca6c-9af3-5305-93ac-6ba215b43157\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{10}\\\\operatorname{csc}⁡(10x)+C\" :db/id 17592186288729} {:answer/id #uuid \"6c47091c-3dbb-514d-926c-70024a19ee8c\" :answer/type {:db/ident :answer.type/math} :answer/value \"{sec}^{2}⁡(10x)+C\" :db/id 17592186288795} {:answer/id #uuid \"9c25054c-c830-5cdc-9739-35307de9de4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{10}\\\\operatorname{sec}⁡x+C\" :db/id 17592186289083} {:answer/id #uuid \"a683964a-9c75-50e4-b041-7650006dc260\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{10}\\\\operatorname{sec}⁡(10x)+C\" :db/id 17592186289134}] :answer-field/correct {:answer/id #uuid \"a683964a-9c75-50e4-b041-7650006dc260\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{10}\\\\operatorname{sec}⁡(10x)+C\" :db/id 17592186289134} :answer-field/id #uuid \"0a9a7120-01c4-56ed-a4cb-cf7ba476dd9f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186289753}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"799e6798-92e1-543f-a4d9-7d772e9877f8\" :question/math-academy-id \"q-2203\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\operatorname{sec}⁡(10x)\\\\operatorname{tan}⁡(10x)\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"If we let $u=10x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=10\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{10}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\operatorname{sec}⁡(10x)\\\\operatorname{tan}⁡(10x)\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\cdot \\\\frac{1}{10}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{10}\\\\int \\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{10}\\\\operatorname{sec}⁡u+C \\\\\\\\  & =\\\\frac{1}{10}\\\\operatorname{sec}⁡(10x)+C\\\\end{aligned}\\n$$\"} {:db/id 17592186319094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5eb82788-efbe-50de-b226-6bde5d6aedf2\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\" :db/id 17592186317886}] :answer-field/correct {:answer/id #uuid \"5eb82788-efbe-50de-b226-6bde5d6aedf2\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\" :db/id 17592186317886} :answer-field/id #uuid \"47ffe2b0-f398-575b-afe8-d12d64c3f4fc\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318580}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ec7ce12f-cbf4-5c03-8053-383589db4d45\" :question/math-academy-id \"q-346368\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{2\\\\pi /3}^{2\\\\pi }\\\\operatorname{csc}⁡\\\\left(\\\\frac{x}{4}\\\\right)\\\\operatorname{cot}⁡\\\\left(\\\\frac{x}{4}\\\\right)\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=\\\\frac{x}{4},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{4}\\\\,⟹\\\\,\\\\text{d}x=4\\\\,\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $2\\\\pi /3$ | $2\\\\pi $ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /6$ | $\\\\pi /2$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{2\\\\pi /3}^{2\\\\pi }\\\\operatorname{csc}⁡\\\\left(\\\\frac{x}{4}\\\\right)\\\\operatorname{cot}⁡\\\\left(\\\\frac{x}{4}\\\\right)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /6}^{\\\\pi /2}\\\\operatorname{csc}⁡(u)\\\\operatorname{cot}⁡(u)\\\\cdot 4\\\\,\\\\text{d}u \\\\\\\\  & =4{\\\\int }_{\\\\pi /6}^{\\\\pi /2}\\\\operatorname{csc}⁡(u)\\\\operatorname{cot}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =4(-\\\\operatorname{csc}⁡(u))\\\\,{|}_{\\\\pi /6}^{\\\\pi /2} \\\\\\\\  & =4(-\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right)+\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)) \\\\\\\\  & =4(-1+2) \\\\\\\\  & =4\\\\end{aligned}\\n$$\"} {:db/id 17592186319363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"c9793ffe-67cc-5645-9b00-c140cc88e2aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\" :db/id 17592186318233}] :answer-field/correct {:answer/id #uuid \"c9793ffe-67cc-5645-9b00-c140cc88e2aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\" :db/id 17592186318233} :answer-field/id #uuid \"24f68f41-ba58-5d4c-9946-589591e9529a\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318497}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"8ccae74f-35c6-57d0-a03f-750b899cc692\" :question/math-academy-id \"q-350060\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /4}3{sec}^{2}⁡(x-\\\\frac{\\\\pi }{4})\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=x-\\\\frac{\\\\pi }{4},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=1\\\\,⟹\\\\,\\\\text{d}x=\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi /4$ |\\n| --- | --- | --- |\\n| $u$ | $-\\\\pi /4$ | $0$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /4}3{sec}^{2}⁡(x-\\\\frac{\\\\pi }{4})\\\\,\\\\text{d}x & =3{\\\\int }_{-\\\\pi /4}^{0}{sec}^{2}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =3\\\\operatorname{tan}⁡(u){|}_{-\\\\pi /4}^{0} \\\\\\\\  & =3(0-(-1)) \\\\\\\\  & =3\\\\end{aligned}\\n$$\"} {:db/id 17592186319364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"85c49c8e-61d5-5e58-a395-01a4e606b7d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\" :db/id 17592186318020}] :answer-field/correct {:answer/id #uuid \"85c49c8e-61d5-5e58-a395-01a4e606b7d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\" :db/id 17592186318020} :answer-field/id #uuid \"773a7395-c2f8-5568-bc4a-ffe056234383\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318675}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"d188146f-1019-54e0-bddf-9c317ac884d3\" :question/math-academy-id \"q-350071\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /3}^{2\\\\pi /3}4\\\\operatorname{csc}⁡(x-\\\\frac{\\\\pi }{6})\\\\operatorname{cot}⁡(x-\\\\frac{\\\\pi }{6})\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=x-\\\\frac{\\\\pi }{6},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=1\\\\,⟹\\\\,\\\\text{d}x=\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /3$ | $2\\\\pi /3$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /6$ | $\\\\pi /2$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /3}^{2\\\\pi /3}4\\\\operatorname{csc}⁡(x-\\\\frac{\\\\pi }{6})\\\\operatorname{cot}⁡(x-\\\\frac{\\\\pi }{6})\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /6}^{\\\\pi /2}4\\\\operatorname{csc}⁡(u)\\\\operatorname{cot}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =4{\\\\int }_{\\\\pi /6}^{\\\\pi /2}\\\\operatorname{csc}⁡(u)\\\\operatorname{cot}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =-4\\\\operatorname{csc}⁡(u){|}_{\\\\pi /6}^{\\\\pi /2} \\\\\\\\  & =-4(\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right)-\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)) \\\\\\\\  & =-4(1-2) \\\\\\\\  & =4\\\\end{aligned}\\n$$\"} {:db/id 17592186429931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"bde6a22f-af92-5d05-a00e-ee43025b38b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186429918}] :answer-field/correct {:answer/id #uuid \"bde6a22f-af92-5d05-a00e-ee43025b38b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186429918} :answer-field/id #uuid \"e4b1c21c-bb6c-5c53-b4e6-f6635e6c2be4\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186429928}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"66f3c3b9-c1e9-58f7-9604-16a02027760f\" :question/math-academy-id \"q-355818\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /20}^{\\\\pi /10}5{csc}^{2}⁡(5x)\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=5x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=5\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{5}\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /20$ | $\\\\pi /10$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /4$ | $\\\\pi /2$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /20}^{\\\\pi /10}5{csc}^{2}⁡(5x)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /4}^{\\\\pi /2}5{csc}^{2}⁡(u)\\\\cdot \\\\frac{1}{5}\\\\,\\\\text{d}u \\\\\\\\  & ={\\\\int }_{\\\\pi /4}^{\\\\pi /2}{csc}^{2}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\operatorname{cot}⁡(u){|}_{\\\\pi /4}^{\\\\pi /2} \\\\\\\\  & =-(\\\\operatorname{cot}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right)-\\\\operatorname{cot}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)) \\\\\\\\  & =-(0-1) \\\\\\\\  & =1\\\\end{aligned}\\n$$\"} {:db/id 17592186429933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"02192a18-96df-5c9c-86d1-fd39f10cc96d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{3}-2\" :db/id 17592186429909} {:answer/id #uuid \"258b40a9-d7f7-5e38-ab76-8707b1a1a9b7\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2\\\\sqrt{3}}{3}-1\" :db/id 17592186429911} {:answer/id #uuid \"59c2d43f-3033-53cf-a498-afe18808b478\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}-1\" :db/id 17592186429913} {:answer/id #uuid \"605c38a6-bd94-5054-abeb-196bc585d8b9\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\sqrt{3}+1\" :db/id 17592186429915} {:answer/id #uuid \"f513628d-4c08-512b-85ac-0d46df6f115b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}+2\" :db/id 17592186429924}] :answer-field/correct {:answer/id #uuid \"02192a18-96df-5c9c-86d1-fd39f10cc96d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{3}-2\" :db/id 17592186429909} :answer-field/id #uuid \"f070068b-56d2-50d4-88fa-ab05a0ca7204\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186429929}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a6be6fa7-2d6e-5c8a-ab1e-bb035341f649\" :question/math-academy-id \"q-10578\" :question/problem \"$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /2}\\\\operatorname{sec}⁡(x-\\\\frac{\\\\pi }{3})\\\\operatorname{tan}⁡(x-\\\\frac{\\\\pi }{3})\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"If we let $u=x-\\\\frac{\\\\pi }{3},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=1\\\\,⟹\\\\,\\\\text{d}x=\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives \\n\\n| $x$ | $0$ | $\\\\pi /2$ |\\n| --- | --- | --- |\\n| $u$ | $-\\\\pi /3$ | $\\\\pi /6$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /2}\\\\operatorname{sec}⁡(x-\\\\frac{\\\\pi }{3})\\\\operatorname{tan}⁡(x-\\\\frac{\\\\pi }{3})\\\\,\\\\text{d}x & ={\\\\int }_{-\\\\pi /3}^{\\\\pi /6}\\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{sec}⁡u{|}_{-\\\\pi /3}^{\\\\pi /6} \\\\\\\\  & =\\\\operatorname{sec}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)-\\\\operatorname{sec}⁡\\\\left(-\\\\frac{\\\\pi }{3}\\\\right) \\\\\\\\  & =\\\\frac{2\\\\sqrt{3}}{3}-2\\\\end{aligned}\\n$$\"} {:db/id 17592186553505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d53a8c66-6804-52ec-8840-edd3d4929673\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{4}\" :db/id 17592186553296}] :answer-field/correct {:answer/id #uuid \"d53a8c66-6804-52ec-8840-edd3d4929673\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{4}\" :db/id 17592186553296} :answer-field/id #uuid \"95531b96-24f8-5a49-ac02-3bfee0bf2b70\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186553446}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"248312e6-be46-5549-b1e3-5f70f146c665\" :question/math-academy-id \"q-346363\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /12}^{\\\\pi /8}3{csc}^{2}⁡(4x)\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=4x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{4}\\\\,\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /12$ | $\\\\pi /8$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /3$ | $\\\\pi /2$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /12}^{\\\\pi /8}3{csc}^{2}⁡(4x)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /3}^{\\\\pi /2}3{csc}^{2}⁡(u)\\\\cdot \\\\frac{1}{4}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{4}{\\\\int }_{\\\\pi /3}^{\\\\pi /2}{csc}^{2}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{4}(-\\\\operatorname{cot}⁡(u))\\\\,{|}_{\\\\pi /3}^{\\\\pi /2} \\\\\\\\  & =\\\\frac{3}{4}(-\\\\operatorname{cot}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right)+\\\\operatorname{cot}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)) \\\\\\\\  & =\\\\frac{3}{4}(0+\\\\frac{\\\\sqrt{3}}{3}) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186580882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"114cd42d-ba52-5869-9448-93a17d0920de\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}-\\\\frac{1}{2}\" :db/id 17592186580410} {:answer/id #uuid \"4edb41e5-8763-5f56-92a0-923aac665da3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}-\\\\frac{1}{2}\" :db/id 17592186580521} {:answer/id #uuid \"921a2907-c9c2-55f3-a5c1-c088eea2d222\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}+1\" :db/id 17592186580634} {:answer/id #uuid \"d55a31f3-9f9c-5cf2-9b86-12761d10e402\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}-2\" :db/id 17592186580719} {:answer/id #uuid \"ec7d360d-043f-5158-a0ad-2486d0c89e98\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186580758}] :answer-field/correct {:answer/id #uuid \"4edb41e5-8763-5f56-92a0-923aac665da3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}-\\\\frac{1}{2}\" :db/id 17592186580521} :answer-field/id #uuid \"1acf62d4-21d8-564e-9008-9e94eb8fcbe4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580805}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"0d4c2c34-0e64-5420-b51f-0cd0b469fb94\" :question/math-academy-id \"q-13524\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle {\\\\int }_{\\\\pi /6}^{\\\\pi /4}\\\\operatorname{csc}⁡(2x)\\\\operatorname{cot}⁡(2x)\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"If we let $u=2x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{2}\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /6$ | $\\\\pi /4$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /3$ | $\\\\pi /2$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /6}^{\\\\pi /4}\\\\operatorname{csc}⁡(2x)\\\\operatorname{cot}⁡(2x)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /3}^{\\\\pi /2}\\\\operatorname{csc}⁡u\\\\operatorname{cot}⁡u\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}{\\\\int }_{\\\\pi /3}^{\\\\pi /2}\\\\operatorname{csc}⁡u\\\\operatorname{cot}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{csc}⁡u{|}_{\\\\pi /3}^{\\\\pi /2} \\\\\\\\  & =-\\\\frac{1}{2}(\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right)-\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)) \\\\\\\\  & =-\\\\frac{1}{2}(1-\\\\frac{2\\\\sqrt{3}}{3}) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{3}-\\\\frac{1}{2}\\\\end{aligned}\\n$$\"} {:db/id 17592186580890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0d3b08c5-67ec-556a-9db8-346afb23990d\" :answer/type {:db/ident :answer.type/math} :answer/value \"4-2\\\\sqrt{2}\" :db/id 17592186580406}] :answer-field/correct {:answer/id #uuid \"0d3b08c5-67ec-556a-9db8-346afb23990d\" :answer/type {:db/ident :answer.type/math} :answer/value \"4-2\\\\sqrt{2}\" :db/id 17592186580406} :answer-field/id #uuid \"04e9c3ac-e070-5fba-b495-8a7967767527\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186580791}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1ccd5c9d-8efc-5890-b6e0-7b6adea1884d\" :question/math-academy-id \"q-350055\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /12}^{\\\\pi /9}6\\\\operatorname{sec}⁡(3x)\\\\operatorname{tan}⁡(3x)\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=3x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{3}\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /12$ | $\\\\pi /9$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /4$ | $\\\\pi /3$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /12}^{\\\\pi /9}6\\\\operatorname{sec}⁡(3x)\\\\operatorname{tan}⁡(3x)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /4}^{\\\\pi /3}6\\\\operatorname{sec}⁡(u)\\\\operatorname{tan}⁡(u)\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =2{\\\\int }_{\\\\pi /4}^{\\\\pi /3}\\\\operatorname{sec}⁡(u)\\\\operatorname{tan}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =2\\\\operatorname{sec}⁡(u){|}_{\\\\pi /4}^{\\\\pi /3} \\\\\\\\  & =2(\\\\operatorname{sec}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)-\\\\operatorname{sec}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)) \\\\\\\\  & =2(2-\\\\sqrt{2}) \\\\\\\\  & =4-2\\\\sqrt{2}\\\\end{aligned}\\n$$\"} {:db/id 17592186580925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7d020a63-ff8a-5103-950e-32a99925bad0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{3}\" :db/id 17592186580596}] :answer-field/correct {:answer/id #uuid \"7d020a63-ff8a-5103-950e-32a99925bad0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{3}\" :db/id 17592186580596} :answer-field/id #uuid \"4a470524-f944-5b81-ad61-34953fcf821f\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186580819}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"891837cc-fc66-582c-9fc5-1ebbcc953137\" :question/math-academy-id \"q-350053\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /18}^{\\\\pi /9}3{sec}^{2}⁡(3x)\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=3x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{3}\\\\,\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /18$ | $\\\\pi /9$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /6$ | $\\\\pi /3$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /18}^{\\\\pi /9}3{sec}^{2}⁡(3x)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /6}^{\\\\pi /3}3{sec}^{2}⁡(u)\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & ={\\\\int }_{\\\\pi /6}^{\\\\pi /3}{sec}^{2}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{tan}⁡(u)\\\\,{|}_{\\\\pi /6}^{\\\\pi /3} \\\\\\\\  & =\\\\operatorname{tan}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)-\\\\operatorname{tan}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =\\\\sqrt{3}-\\\\frac{1}{\\\\sqrt{3}} \\\\\\\\  & =\\\\frac{2\\\\sqrt{3}}{3}\\\\end{aligned}\\n$$\"} {:db/id 17592186580927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"00684a2f-d8bf-539e-8768-dd9c37ae4462\" :answer/type {:db/ident :answer.type/math} :answer/value \"{tan}^{2}⁡x+C\" :db/id 17592186580384} {:answer/id #uuid \"3bb0ba8b-b756-54d7-84d7-fbb88e5ca0f1\" :answer/type {:db/ident :answer.type/math} :answer/value \"{sec}^{2}⁡x+C\" :db/id 17592186580488} {:answer/id #uuid \"6a23ee15-1ca3-55ab-ab89-e68612ea242f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡x+C\" :db/id 17592186580564} {:answer/id #uuid \"6d602fb9-1975-5b9a-b57b-0b866e48bf8e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{tan}^{2}⁡x}{2}+C\" :db/id 17592186580573} {:answer/id #uuid \"d9d0d7d0-b097-58a3-b109-3bdf30daaa49\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sec}⁡x+C\" :db/id 17592186580728}] :answer-field/correct {:answer/id #uuid \"6d602fb9-1975-5b9a-b57b-0b866e48bf8e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{tan}^{2}⁡x}{2}+C\" :db/id 17592186580573} :answer-field/id #uuid \"efe5bc0a-b315-5b23-93da-8951c85ccafd\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580875}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"93bebf8e-0e85-5d99-abd0-30d0a01cdaa3\" :question/math-academy-id \"q-113979\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\operatorname{tan}⁡x{sec}^{2}⁡x\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"If we let $u=\\\\operatorname{tan}⁡x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}={sec}^{2}⁡x\\\\,⟹\\\\,{sec}^{2}⁡x\\\\,\\\\text{d}x=\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\operatorname{tan}⁡x{sec}^{2}⁡x\\\\,\\\\text{d}x & =\\\\int u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{{u}^{2}}{2}+C \\\\\\\\  & =\\\\frac{{tan}^{2}⁡x}{2}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186580935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"02a0e0ac-e727-5461-b976-19c124b8b464\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{3}{2}\" :db/id 17592186580388} {:answer/id #uuid \"4890fcde-2797-5117-8088-b582d7722617\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186580508} {:answer/id #uuid \"6d616f73-2fa0-5847-8b9f-9a01caad223b\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186580574} {:answer/id #uuid \"cb597cd5-c5ef-508d-a0c1-618aa29883dd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\" :db/id 17592186580705} {:answer/id #uuid \"e36ac8bb-58e1-59ed-a6aa-fe6e8c50369c\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186580744}] :answer-field/correct {:answer/id #uuid \"cb597cd5-c5ef-508d-a0c1-618aa29883dd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\" :db/id 17592186580705} :answer-field/id #uuid \"c6e41e02-7a09-5398-bc9b-a3b506f57d51\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580861}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"9cfe1a63-f205-5796-abd7-66f03dc0449c\" :question/math-academy-id \"q-13655\" :question/problem \"Evaluate the integral $$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi }\\\\frac{1}{2}\\\\operatorname{sec}⁡\\\\left(\\\\frac{x}{3}\\\\right)\\\\operatorname{tan}⁡\\\\left(\\\\frac{x}{3}\\\\right)\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"If we let $u=\\\\frac{x}{3},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{3}\\\\,⟹\\\\,\\\\text{d}x=3\\\\,\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi$ |\\n| --- | --- | --- |\\n| $u$ | $0$ | $\\\\pi /3$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi }\\\\frac{1}{2}\\\\operatorname{sec}⁡\\\\left(\\\\frac{x}{3}\\\\right)\\\\operatorname{tan}⁡\\\\left(\\\\frac{x}{3}\\\\right)\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /3}\\\\frac{1}{2}\\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\cdot 3\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{2}{\\\\int }_{0}^{\\\\pi /3}\\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{2}\\\\operatorname{sec}⁡u{|}_{0}^{\\\\pi /3} \\\\\\\\  & =\\\\frac{3}{2}(\\\\operatorname{sec}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)-\\\\operatorname{sec}⁡(0)) \\\\\\\\  & =\\\\frac{3}{2}(2-1) \\\\\\\\  & =\\\\frac{3}{2}\\\\end{aligned}\\n$$\"} {:db/id 17592186601948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2793389a-a6be-59df-bc34-ec2d332ef005\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2\\\\sqrt{3}}{3}\" :db/id 17592186601623} {:answer/id #uuid \"9949b34a-44b2-5aab-aa8a-f06da3c9f818\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{3}\" :db/id 17592186601715} {:answer/id #uuid \"d871a8f6-a53a-5d66-bea4-b8ccbd3eb897\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{6}\" :db/id 17592186601775} {:answer/id #uuid \"f362563c-190c-50ef-9666-faada8e9f4b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186601798} {:answer/id #uuid \"f4655e3f-33f9-5353-81d1-9b2c1670e6a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}\" :db/id 17592186601801}] :answer-field/correct {:answer/id #uuid \"f4655e3f-33f9-5353-81d1-9b2c1670e6a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{3}\" :db/id 17592186601801} :answer-field/id #uuid \"9b02c2b7-ab80-5b62-9eaa-c0d8af84102c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186601852}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f5ec3a44-706a-552a-b9fc-e5121c81e87c\" :question/math-academy-id \"q-10595\" :question/problem \"Evaluate $$\\n\\\\displaystyle {\\\\int }_{\\\\pi /6}^{\\\\pi /3}{csc}^{2}⁡(2x)\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"If we let $u=2x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{2}\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /6$ | $\\\\pi /3$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /3$ | $2\\\\pi /3$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /6}^{\\\\pi /3}{csc}^{2}⁡(2x)\\\\,\\\\text{d}x & ={\\\\int }_{\\\\pi /3}^{2\\\\pi /3}{csc}^{2}⁡u\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}{\\\\int }_{\\\\pi /3}^{2\\\\pi /3}{csc}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{cot}⁡u{|}_{\\\\pi /3}^{2\\\\pi /3} \\\\\\\\  & =-\\\\frac{1}{2}(\\\\operatorname{cot}⁡\\\\left(\\\\frac{2\\\\pi }{3}\\\\right)-\\\\operatorname{cot}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)) \\\\\\\\  & =-\\\\frac{1}{2}(-\\\\frac{\\\\sqrt{3}}{3}-\\\\frac{\\\\sqrt{3}}{3}) \\\\\\\\  & =-\\\\frac{1}{2}\\\\left(-\\\\frac{2\\\\sqrt{3}}{3}\\\\right) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{3}\\\\end{aligned}\\n$$\"} {:db/id 17592186611583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"194fd8af-b040-5b37-b284-479fc28e14fe\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\" :db/id 17592186611112}] :answer-field/correct {:answer/id #uuid \"194fd8af-b040-5b37-b284-479fc28e14fe\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\" :db/id 17592186611112} :answer-field/id #uuid \"80cdbf21-5d83-5f11-a83b-a6feecf8976c\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186611510}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4e66bab1-d394-5399-b025-c983e9b8e368\" :question/math-academy-id \"q-350057\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\pi /8}6{sec}^{2}⁡(2x)\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=2x,$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{2}\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\pi /8$ |\\n| --- | --- | --- |\\n| $u$ | $0$ | $\\\\pi /4$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\pi /8}6{sec}^{2}⁡(2x)\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /4}6{sec}^{2}⁡(u)\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =3{\\\\int }_{0}^{\\\\pi /4}{sec}^{2}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =3\\\\operatorname{tan}⁡(u){|}_{0}^{\\\\pi /4} \\\\\\\\  & =3(\\\\operatorname{tan}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-\\\\operatorname{tan}⁡(0)) \\\\\\\\  & =3(1-0) \\\\\\\\  & =3\\\\end{aligned}\\n$$\"} {:db/id 17592186658965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"50a62534-23f8-5551-b309-2bfcf1b6c7c8\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\" :db/id 17592186658519}] :answer-field/correct {:answer/id #uuid \"50a62534-23f8-5551-b309-2bfcf1b6c7c8\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\" :db/id 17592186658519} :answer-field/id #uuid \"7782799c-d581-57e2-83cc-457e771d14a2\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186658863}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b022582d-7a73-572b-bcbe-ac8b549acb6f\" :question/math-academy-id \"q-350061\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\pi /6}^{\\\\pi /2}6\\\\operatorname{sec}⁡(x-\\\\frac{\\\\pi }{6})\\\\operatorname{tan}⁡(x-\\\\frac{\\\\pi }{6})\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=x-\\\\frac{\\\\pi }{6},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=1\\\\,⟹\\\\,\\\\text{d}x=\\\\text{d}u.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\pi /6$ | $\\\\pi /2$ |\\n| --- | --- | --- |\\n| $u$ | $0$ | $\\\\pi /3$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\pi /6}^{\\\\pi /2}6\\\\operatorname{sec}⁡(x-\\\\frac{\\\\pi }{6})\\\\operatorname{tan}⁡(x-\\\\frac{\\\\pi }{6})\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\pi /3}6\\\\operatorname{sec}⁡(u)\\\\operatorname{tan}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =6{\\\\int }_{0}^{\\\\pi /3}\\\\operatorname{sec}⁡(u)\\\\operatorname{tan}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =6\\\\operatorname{sec}⁡(u){|}_{0}^{\\\\pi /3} \\\\\\\\  & =6(\\\\operatorname{sec}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)-\\\\operatorname{sec}⁡(0)) \\\\\\\\  & =6(2-1) \\\\\\\\  & =6\\\\end{aligned}\\n$$\"} {:db/id 17592186677387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"da28418d-ce9f-5f59-b794-596465adadd4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3} - \\\\frac{\\\\sqrt{2}}{3}\" :db/id 17592186677441}] :answer-field/correct {:answer/id #uuid \"da28418d-ce9f-5f59-b794-596465adadd4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3} - \\\\frac{\\\\sqrt{2}}{3}\" :db/id 17592186677441} :answer-field/id #uuid \"e97f93d6-8717-5343-9503-137259aa5d19\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677447}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"03595741-d485-53cb-871d-b8d426aec985\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{24}}^{\\\\frac{\\\\pi}{18}} 2 \\\\tan{\\\\left(6 x \\\\right)} \\\\sec{\\\\left(6 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=6 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{24}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\pi}{18}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{24}}^{\\\\frac{\\\\pi}{18}} 2 \\\\tan{\\\\left(6 x \\\\right)} \\\\sec{\\\\left(6 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}} \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{\\\\sec{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}}=\\\\left(\\\\frac{2}{3}\\\\right)-\\\\left(\\\\frac{\\\\sqrt{2}}{3}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{2}{3} - \\\\frac{\\\\sqrt{2}}{3}.\\n$$\"} {:db/id 17592186677388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"209c646d-cdab-5040-9f0e-4b1c81b98409\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\tan{\\\\left(2 x \\\\right)}}{2}\" :db/id 17592186677394}] :answer-field/correct {:answer/id #uuid \"209c646d-cdab-5040-9f0e-4b1c81b98409\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\tan{\\\\left(2 x \\\\right)}}{2}\" :db/id 17592186677394} :answer-field/id #uuid \"d871cdba-45ff-5925-9b05-a112885553d2\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677440}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"073aeb1d-5ede-5b0d-bfc8-d37ff2d691c4\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 3 \\\\sec^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 3 \\\\sec^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3 \\\\tan{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3 \\\\tan{\\\\left(2 x \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186677391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"befba929-9fda-5f48-afb7-dc9545acb297\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 5 \\\\sqrt{2} + \\\\frac{10 \\\\sqrt{3}}{3}\" :db/id 17592186677433}] :answer-field/correct {:answer/id #uuid \"befba929-9fda-5f48-afb7-dc9545acb297\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 5 \\\\sqrt{2} + \\\\frac{10 \\\\sqrt{3}}{3}\" :db/id 17592186677433} :answer-field/id #uuid \"7831f77e-feb9-5909-9370-a77527b7e4ab\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677416}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1c351c96-eb00-5911-ae50-4a666f600e22\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{\\\\pi}{6}}^{0} - \\\\frac{5 \\\\tan{\\\\left(\\\\frac{x}{2} + \\\\frac{\\\\pi}{4} \\\\right)} \\\\sec{\\\\left(\\\\frac{x}{2} + \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{x}{2} + \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{2}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\\\\\x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{\\\\pi}{6}}^{0} - \\\\frac{5 \\\\tan{\\\\left(\\\\frac{x}{2} + \\\\frac{\\\\pi}{4} \\\\right)} \\\\sec{\\\\left(\\\\frac{x}{2} + \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=-5\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}} \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- 5 \\\\sec{\\\\left(u \\\\right)}\\\\right]_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}}=\\\\left(- 5 \\\\sqrt{2}\\\\right)-\\\\left(- \\\\frac{10 \\\\sqrt{3}}{3}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- 5 \\\\sqrt{2} + \\\\frac{10 \\\\sqrt{3}}{3}.\\n$$\"} {:db/id 17592186677393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"fef5887b-26b3-5aa8-9e51-1e7c0d919e2d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2 + 2 \\\\sqrt{2}\" :db/id 17592186677457}] :answer-field/correct {:answer/id #uuid \"fef5887b-26b3-5aa8-9e51-1e7c0d919e2d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2 + 2 \\\\sqrt{2}\" :db/id 17592186677457} :answer-field/id #uuid \"e8eaa502-7fe5-5d6a-a807-4483e127b7ef\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677445}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1dd0d444-b9a6-56a7-81ab-1f737d2a3c8a\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{\\\\pi}{12}}^{0} 6 \\\\tan{\\\\left(- 3 x \\\\right)} \\\\sec{\\\\left(- 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- 3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-3.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{\\\\pi}{12}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=0&\\\\Longrightarrow u=0\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{\\\\pi}{12}}^{0} 6 \\\\tan{\\\\left(- 3 x \\\\right)} \\\\sec{\\\\left(- 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{0} \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- 2 \\\\sec{\\\\left(u \\\\right)}\\\\right]_{\\\\frac{\\\\pi}{4}}^{0}=\\\\left(-2\\\\right)-\\\\left(- 2 \\\\sqrt{2}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n-2 + 2 \\\\sqrt{2}.\\n$$\"} {:db/id 17592186677396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e6896d6f-761d-578c-81d5-360fcd6adfd0\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7 \\\\cot{\\\\left(5 x \\\\right)}}{5}\" :db/id 17592186677444}] :answer-field/correct {:answer/id #uuid \"e6896d6f-761d-578c-81d5-360fcd6adfd0\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7 \\\\cot{\\\\left(5 x \\\\right)}}{5}\" :db/id 17592186677444} :answer-field/id #uuid \"a07e1c67-4ecb-5837-8958-50a04cdd0b19\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677427}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2ce29796-c18d-5902-a450-5c6a1b1b5220\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 7 \\\\csc^{2}{\\\\left(5 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=5 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 7 \\\\csc^{2}{\\\\left(5 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{7}{5}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{7}{5}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7 \\\\cot{\\\\left(u \\\\right)}}{5}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7 \\\\cot{\\\\left(5 x \\\\right)}}{5}+C.\\n$$\"} {:db/id 17592186677398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e97b264a-92e7-5a52-b1a2-2a700eb0283c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{9 \\\\sqrt{2}}{2} + 3 \\\\sqrt{3}\" :db/id 17592186677446}] :answer-field/correct {:answer/id #uuid \"e97b264a-92e7-5a52-b1a2-2a700eb0283c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{9 \\\\sqrt{2}}{2} + 3 \\\\sqrt{3}\" :db/id 17592186677446} :answer-field/id #uuid \"6a5e5342-0591-5102-b507-47697fd55990\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677411}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"36cd3b27-f6e8-592d-99e4-5ee5368b313f\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{3 \\\\pi}{2}}^{\\\\frac{7 \\\\pi}{4}} - \\\\frac{3 \\\\cot{\\\\left(\\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)} \\\\csc{\\\\left(\\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{x}{3} - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{3}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{3 \\\\pi}{2}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{7 \\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{3 \\\\pi}{2}}^{\\\\frac{7 \\\\pi}{4}} - \\\\frac{3 \\\\cot{\\\\left(\\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)} \\\\csc{\\\\left(\\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{9}{2}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}} \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{9 \\\\csc{\\\\left(u \\\\right)}}{2}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}}=\\\\left(3 \\\\sqrt{3}\\\\right)-\\\\left(\\\\frac{9 \\\\sqrt{2}}{2}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{9 \\\\sqrt{2}}{2} + 3 \\\\sqrt{3}.\\n$$\"} {:db/id 17592186677399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f6e3a9b4-6967-5e80-a68f-df56357b77da\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\csc{\\\\left(5 x + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677452}] :answer-field/correct {:answer/id #uuid \"f6e3a9b4-6967-5e80-a68f-df56357b77da\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{7 \\\\csc{\\\\left(5 x + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677452} :answer-field/id #uuid \"daa22f9a-1118-50d0-810b-11c451d6a55d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677442}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"39226942-711b-55fb-b672-0b9498c72c21\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 7 \\\\cot{\\\\left(5 x + \\\\frac{\\\\pi}{6} \\\\right)} \\\\csc{\\\\left(5 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=5 x + \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 7 \\\\cot{\\\\left(5 x + \\\\frac{\\\\pi}{6} \\\\right)} \\\\csc{\\\\left(5 x + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{5}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{5}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{7 \\\\csc{\\\\left(u \\\\right)}}{5}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{7 \\\\csc{\\\\left(5 x + \\\\frac{\\\\pi}{6} \\\\right)}}{5}+C.\\n$$\"} {:db/id 17592186677405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"987b7251-5c21-5376-8e01-a0bfd0d15fad\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cot{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}\" :db/id 17592186677424}] :answer-field/correct {:answer/id #uuid \"987b7251-5c21-5376-8e01-a0bfd0d15fad\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cot{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}\" :db/id 17592186677424} :answer-field/id #uuid \"3081ec4b-ef17-50e3-b5cc-7ce15a85ee9e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677397}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"4ef6f8f6-1922-5bdc-a2f1-cc3e307583e8\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\csc^{2}{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- 2 x - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\csc^{2}{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\cot{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}+C.\\n$$\"} {:db/id 17592186677407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6f99cafe-bcac-5579-8d6d-6c31fd9aa27d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5} - \\\\frac{8 \\\\sqrt{3}}{15}\" :db/id 17592186677412}] :answer-field/correct {:answer/id #uuid \"6f99cafe-bcac-5579-8d6d-6c31fd9aa27d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5} - \\\\frac{8 \\\\sqrt{3}}{15}\" :db/id 17592186677412} :answer-field/id #uuid \"999f1e33-f8f3-597c-94a5-235188d9ae11\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677425}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"55663b8c-42f7-596d-83e8-240de0ec9b1d\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{\\\\pi}{10}}^{- \\\\frac{\\\\pi}{15}} - 4 \\\\cot{\\\\left(- 5 x \\\\right)} \\\\csc{\\\\left(- 5 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- 5 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-5.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\\\\\x=- \\\\frac{\\\\pi}{15}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{\\\\pi}{10}}^{- \\\\frac{\\\\pi}{15}} - 4 \\\\cot{\\\\left(- 5 x \\\\right)} \\\\csc{\\\\left(- 5 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{3}} \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{4 \\\\csc{\\\\left(u \\\\right)}}{5}\\\\right]_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{3}}=\\\\left(- \\\\frac{8 \\\\sqrt{3}}{15}\\\\right)-\\\\left(- \\\\frac{4}{5}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{4}{5} - \\\\frac{8 \\\\sqrt{3}}{15}.\\n$$\"} {:db/id 17592186677408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3a633cb9-c226-54ca-aa17-c258b57d502e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\sqrt{3}}{9}\" :db/id 17592186677400}] :answer-field/correct {:answer/id #uuid \"3a633cb9-c226-54ca-aa17-c258b57d502e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\sqrt{3}}{9}\" :db/id 17592186677400} :answer-field/id #uuid \"4411b9bd-2f0d-5663-9506-5db3b279da70\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677404}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"5915e3a9-56f6-54b6-939f-1f29ec463eca\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{\\\\pi}{3}}^{0} \\\\frac{2 \\\\csc^{2}{\\\\left(- \\\\frac{x}{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- \\\\frac{x}{2} + \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{2}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{\\\\pi}{3}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\\\\\x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{\\\\pi}{3}}^{0} \\\\frac{2 \\\\csc^{2}{\\\\left(- \\\\frac{x}{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{4}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{6}} \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{4 \\\\cot{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{6}}=\\\\left(\\\\frac{4 \\\\sqrt{3}}{3}\\\\right)-\\\\left(\\\\frac{4 \\\\sqrt{3}}{9}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{8 \\\\sqrt{3}}{9}.\\n$$\"} {:db/id 17592186677409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3ec8055a-0770-5844-aceb-1096e8a3b4e9\" :answer/type {:db/ident :answer.type/math} :answer/value \"15 - \\\\frac{15 \\\\sqrt{2}}{2}\" :db/id 17592186677402}] :answer-field/correct {:answer/id #uuid \"3ec8055a-0770-5844-aceb-1096e8a3b4e9\" :answer/type {:db/ident :answer.type/math} :answer/value \"15 - \\\\frac{15 \\\\sqrt{2}}{2}\" :db/id 17592186677402} :answer-field/id #uuid \"f28432f9-fdb3-57cf-97ac-acfd970c0f72\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677451}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"619d9def-2035-560b-b2fc-426e1f28c7bd\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{7 \\\\pi}{4}}^{- \\\\frac{3 \\\\pi}{2}} \\\\frac{5 \\\\tan{\\\\left(- \\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)} \\\\sec{\\\\left(- \\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- \\\\frac{x}{3} - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{3}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{7 \\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\\\\\x=- \\\\frac{3 \\\\pi}{2}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{7 \\\\pi}{4}}^{- \\\\frac{3 \\\\pi}{2}} \\\\frac{5 \\\\tan{\\\\left(- \\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)} \\\\sec{\\\\left(- \\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{15}{2}\\\\left(\\\\int_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{4}} \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{15 \\\\sec{\\\\left(u \\\\right)}}{2}\\\\right]_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{4}}=\\\\left(- \\\\frac{15 \\\\sqrt{2}}{2}\\\\right)-\\\\left(-15\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n15 - \\\\frac{15 \\\\sqrt{2}}{2}.\\n$$\"} {:db/id 17592186677410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"c145488d-7ae1-56c1-a8eb-8c26014398ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\tan{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\" :db/id 17592186677435}] :answer-field/correct {:answer/id #uuid \"c145488d-7ae1-56c1-a8eb-8c26014398ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\tan{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\" :db/id 17592186677435} :answer-field/id #uuid \"43695357-3206-5da3-8964-0cbc3811fe60\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677403}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"69e31cbe-7694-52bc-a3ff-a9360a8fffab\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- 2 x - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\sec^{2}{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{\\\\tan{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{\\\\tan{\\\\left(- 2 x - \\\\frac{\\\\pi}{4} \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186677414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"faceb4f1-8802-5949-89b6-ff9589308076\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{20}{9} - \\\\frac{10 \\\\sqrt{2}}{9}\" :db/id 17592186677455}] :answer-field/correct {:answer/id #uuid \"faceb4f1-8802-5949-89b6-ff9589308076\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{20}{9} - \\\\frac{10 \\\\sqrt{2}}{9}\" :db/id 17592186677455} :answer-field/id #uuid \"c58627f9-6c8a-5834-9ee8-34cfc235dbac\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677437}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"7176dd16-0df4-55a7-aeeb-1801ac33a090\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{18}} \\\\frac{5 \\\\cot{\\\\left(- \\\\frac{3 x}{2} + \\\\frac{\\\\pi}{4} \\\\right)} \\\\csc{\\\\left(- \\\\frac{3 x}{2} + \\\\frac{\\\\pi}{4} \\\\right)}}{3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- \\\\frac{3 x}{2} + \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{3}{2}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\pi}{18}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{18}} \\\\frac{5 \\\\cot{\\\\left(- \\\\frac{3 x}{2} + \\\\frac{\\\\pi}{4} \\\\right)} \\\\csc{\\\\left(- \\\\frac{3 x}{2} + \\\\frac{\\\\pi}{4} \\\\right)}}{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{10}{9}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{6}} \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{10 \\\\csc{\\\\left(u \\\\right)}}{9}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{6}}=\\\\left(\\\\frac{20}{9}\\\\right)-\\\\left(\\\\frac{10 \\\\sqrt{2}}{9}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{20}{9} - \\\\frac{10 \\\\sqrt{2}}{9}.\\n$$\"} {:db/id 17592186677415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"eaa78a60-e433-5623-ba90-70c9b3b3bd88\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5}\" :db/id 17592186677448}] :answer-field/correct {:answer/id #uuid \"eaa78a60-e433-5623-ba90-70c9b3b3bd88\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5}\" :db/id 17592186677448} :answer-field/id #uuid \"1d41f863-ce27-51af-8ff8-4ebb35a01076\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677392}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"76a1a2e0-2149-5343-b9b7-1442d550a8de\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{\\\\pi}{20}}^{0} 2 \\\\sec^{2}{\\\\left(- 5 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- 5 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-5.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{\\\\pi}{20}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=0&\\\\Longrightarrow u=0\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{\\\\pi}{20}}^{0} 2 \\\\sec^{2}{\\\\left(- 5 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{5}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{0} \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{2 \\\\tan{\\\\left(u \\\\right)}}{5}\\\\right]_{\\\\frac{\\\\pi}{4}}^{0}=\\\\left(0\\\\right)-\\\\left(- \\\\frac{2}{5}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{2}{5}.\\n$$\"} {:db/id 17592186677418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"542c6e90-f80c-52ae-9fc3-bff7b0448653\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sec{\\\\left(2 x - \\\\frac{\\\\pi}{4} \\\\right)}\" :db/id 17592186677406}] :answer-field/correct {:answer/id #uuid \"542c6e90-f80c-52ae-9fc3-bff7b0448653\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sec{\\\\left(2 x - \\\\frac{\\\\pi}{4} \\\\right)}\" :db/id 17592186677406} :answer-field/id #uuid \"fe29454b-a75b-5c7f-a6bf-aeaa639f5f41\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677456}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"8ad177de-f56b-548a-80fb-4041da0c0739\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\tan{\\\\left(2 x - \\\\frac{\\\\pi}{4} \\\\right)} \\\\sec{\\\\left(2 x - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2 x - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\tan{\\\\left(2 x - \\\\frac{\\\\pi}{4} \\\\right)} \\\\sec{\\\\left(2 x - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\sec{\\\\left(2 x - \\\\frac{\\\\pi}{4} \\\\right)}+C.\\n$$\"} {:db/id 17592186677423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"70f50210-11fa-5e51-88d9-cb55ccf10758\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5} - \\\\frac{2 \\\\sqrt{3}}{5}\" :db/id 17592186677413}] :answer-field/correct {:answer/id #uuid \"70f50210-11fa-5e51-88d9-cb55ccf10758\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5} - \\\\frac{2 \\\\sqrt{3}}{5}\" :db/id 17592186677413} :answer-field/id #uuid \"11d9b26f-5f57-522a-82c2-d02d262c2a75\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677390}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"939ab3eb-b6a3-53df-aeda-7838bff2e47a\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{20}}^{\\\\frac{\\\\pi}{15}} - 2 \\\\sec^{2}{\\\\left(5 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=5 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{20}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\pi}{15}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{20}}^{\\\\frac{\\\\pi}{15}} - 2 \\\\sec^{2}{\\\\left(5 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{5}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}} \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{2 \\\\tan{\\\\left(u \\\\right)}}{5}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}}=\\\\left(- \\\\frac{2 \\\\sqrt{3}}{5}\\\\right)-\\\\left(- \\\\frac{2}{5}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{2}{5} - \\\\frac{2 \\\\sqrt{3}}{5}.\\n$$\"} {:db/id 17592186677430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a7fe49a9-9a28-5898-bb50-8a90b07d7af0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\" :db/id 17592186677428}] :answer-field/correct {:answer/id #uuid \"a7fe49a9-9a28-5898-bb50-8a90b07d7af0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\" :db/id 17592186677428} :answer-field/id #uuid \"0a64a6fc-1858-5771-a346-4f80a390ad46\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677389}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a973650d-44b5-5568-9c49-20e47dc4a2f2\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{\\\\pi}{6}}^{- \\\\frac{\\\\pi}{12}} 4 \\\\csc^{2}{\\\\left(- 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- 3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-3.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\\\\\x=- \\\\frac{\\\\pi}{12}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{\\\\pi}{6}}^{- \\\\frac{\\\\pi}{12}} 4 \\\\csc^{2}{\\\\left(- 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{4}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{4}} \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{4 \\\\cot{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{4}}=\\\\left(\\\\frac{4}{3}\\\\right)-\\\\left(0\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{4}{3}.\\n$$\"} {:db/id 17592186677431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b991a52b-4050-5c87-98f1-935ba7acf9ea\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{2} - \\\\frac{9 \\\\sqrt{3}}{2}\" :db/id 17592186677432}] :answer-field/correct {:answer/id #uuid \"b991a52b-4050-5c87-98f1-935ba7acf9ea\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{2} - \\\\frac{9 \\\\sqrt{3}}{2}\" :db/id 17592186677432} :answer-field/id #uuid \"90a82afe-9b5c-5581-ac29-11654aefd369\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677422}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ae5adf82-5498-5c01-a1b8-4a2da93e2ba3\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{3 \\\\pi}{2}}^{\\\\frac{7 \\\\pi}{4}} - \\\\frac{3 \\\\sec^{2}{\\\\left(\\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{x}{3} - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{3}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{3 \\\\pi}{2}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{7 \\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{3 \\\\pi}{2}}^{\\\\frac{7 \\\\pi}{4}} - \\\\frac{3 \\\\sec^{2}{\\\\left(\\\\frac{x}{3} - \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{9}{2}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}} \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{9 \\\\tan{\\\\left(u \\\\right)}}{2}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}}=\\\\left(- \\\\frac{9 \\\\sqrt{3}}{2}\\\\right)-\\\\left(- \\\\frac{9}{2}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{9}{2} - \\\\frac{9 \\\\sqrt{3}}{2}.\\n$$\"} {:db/id 17592186677434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a89b39e9-4843-5bc6-87aa-fddaf1966f77\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3} - \\\\frac{4 \\\\sqrt{3}}{3}\" :db/id 17592186677429}] :answer-field/correct {:answer/id #uuid \"a89b39e9-4843-5bc6-87aa-fddaf1966f77\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3} - \\\\frac{4 \\\\sqrt{3}}{3}\" :db/id 17592186677429} :answer-field/id #uuid \"8e566b4b-c7af-511a-99be-fd1ad29079da\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677419}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"bf265989-f6f0-5f0e-ba70-db7eef3eab20\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{5 \\\\pi}{6}}^{\\\\pi} - \\\\frac{2 \\\\csc^{2}{\\\\left(\\\\frac{x}{2} - \\\\frac{\\\\pi}{4} \\\\right)}}{3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{x}{2} - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{2}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{5 \\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\\\\\x=\\\\pi&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{5 \\\\pi}{6}}^{\\\\pi} - \\\\frac{2 \\\\csc^{2}{\\\\left(\\\\frac{x}{2} - \\\\frac{\\\\pi}{4} \\\\right)}}{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{4}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}} \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{4 \\\\cot{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}}=\\\\left(\\\\frac{4}{3}\\\\right)-\\\\left(\\\\frac{4 \\\\sqrt{3}}{3}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{4}{3} - \\\\frac{4 \\\\sqrt{3}}{3}.\\n$$\"} {:db/id 17592186677436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8ee967d5-fefd-5922-921c-94cee5140c7c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{5} + \\\\frac{2 \\\\sqrt{3}}{15}\" :db/id 17592186677420}] :answer-field/correct {:answer/id #uuid \"8ee967d5-fefd-5922-921c-94cee5140c7c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{5} + \\\\frac{2 \\\\sqrt{3}}{15}\" :db/id 17592186677420} :answer-field/id #uuid \"23e14db0-4119-5331-8607-daa0c44fb68d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677395}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c583b2c4-8e86-5ae3-86a7-7860d0969586\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{15}}^{\\\\frac{\\\\pi}{10}} \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=5 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=5.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{15}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\\\\\x=\\\\frac{\\\\pi}{10}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{15}}^{\\\\frac{\\\\pi}{10}} \\\\cot{\\\\left(5 x \\\\right)} \\\\csc{\\\\left(5 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{2}} \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{\\\\csc{\\\\left(u \\\\right)}}{5}\\\\right]_{\\\\frac{\\\\pi}{3}}^{\\\\frac{\\\\pi}{2}}=\\\\left(- \\\\frac{1}{5}\\\\right)-\\\\left(- \\\\frac{2 \\\\sqrt{3}}{15}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{1}{5} + \\\\frac{2 \\\\sqrt{3}}{15}.\\n$$\"} {:db/id 17592186677438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3b0aa95c-2405-5271-89be-bd02c6d33269\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{6} + \\\\frac{7 \\\\sqrt{3}}{18}\" :db/id 17592186677401}] :answer-field/correct {:answer/id #uuid \"3b0aa95c-2405-5271-89be-bd02c6d33269\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{6} + \\\\frac{7 \\\\sqrt{3}}{18}\" :db/id 17592186677401} :answer-field/id #uuid \"9f481514-f665-5049-865b-c270ae2e8eaa\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677426}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c5b1ad32-bb4e-5508-bddb-594979f05fa7\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{24}}^{\\\\frac{\\\\pi}{18}} - 7 \\\\csc^{2}{\\\\left(6 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=6 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{24}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\pi}{18}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{24}}^{\\\\frac{\\\\pi}{18}} - 7 \\\\csc^{2}{\\\\left(6 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{6}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}} \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{7 \\\\cot{\\\\left(u \\\\right)}}{6}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}}=\\\\left(\\\\frac{7 \\\\sqrt{3}}{18}\\\\right)-\\\\left(\\\\frac{7}{6}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{7}{6} + \\\\frac{7 \\\\sqrt{3}}{18}.\\n$$\"} {:db/id 17592186677443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"863b5b27-ae04-5906-aacf-0d5ac60e3a04\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\csc{\\\\left(- 2 x \\\\right)}}{2}\" :db/id 17592186677417}] :answer-field/correct {:answer/id #uuid \"863b5b27-ae04-5906-aacf-0d5ac60e3a04\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\csc{\\\\left(- 2 x \\\\right)}}{2}\" :db/id 17592186677417} :answer-field/id #uuid \"8f8104c5-b0a2-5cfc-b3e1-6a64e97e59f3\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677421}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e415d708-3e73-5f13-95d7-e0704f439fd7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 5 \\\\cot{\\\\left(- 2 x \\\\right)} \\\\csc{\\\\left(- 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- 2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 5 \\\\cot{\\\\left(- 2 x \\\\right)} \\\\csc{\\\\left(- 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{5 \\\\csc{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{5 \\\\csc{\\\\left(- 2 x \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186677449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f7a5d38e-3a33-59bc-991f-be6ec110bb4e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{15}{4} + \\\\frac{5 \\\\sqrt{3}}{4}\" :db/id 17592186677453}] :answer-field/correct {:answer/id #uuid \"f7a5d38e-3a33-59bc-991f-be6ec110bb4e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{15}{4} + \\\\frac{5 \\\\sqrt{3}}{4}\" :db/id 17592186677453} :answer-field/id #uuid \"ef41ae03-0363-5ab5-8c19-b5a72d57172d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677450}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ebd5575e-4739-5634-aaed-010e3b1faf38\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{8}} - \\\\frac{5 \\\\sec^{2}{\\\\left(- \\\\frac{2 x}{3} + \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=- \\\\frac{2 x}{3} + \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{2}{3}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\end{aligned}\\n$$\\n\\nThe transformed bounds decrease; keep their order when subtracting endpoint values.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{8}} - \\\\frac{5 \\\\sec^{2}{\\\\left(- \\\\frac{2 x}{3} + \\\\frac{\\\\pi}{4} \\\\right)}}{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{15}{4}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{6}} \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{15 \\\\tan{\\\\left(u \\\\right)}}{4}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{6}}=\\\\left(\\\\frac{5 \\\\sqrt{3}}{4}\\\\right)-\\\\left(\\\\frac{15}{4}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{15}{4} + \\\\frac{5 \\\\sqrt{3}}{4}.\\n$$\"} {:db/id 17592186677454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d79d7341-1973-5d7b-ac0b-0797293dbe4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7 \\\\sec{\\\\left(- 5 x \\\\right)}}{5}\" :db/id 17592186677439}] :answer-field/correct {:answer/id #uuid \"d79d7341-1973-5d7b-ac0b-0797293dbe4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7 \\\\sec{\\\\left(- 5 x \\\\right)}}{5}\" :db/id 17592186677439} :answer-field/id #uuid \"00f7e62b-077a-54d7-8638-cd1efc363493\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677386}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"f9a8cd21-dc7c-5e67-8cfe-457222aa02c9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 7 \\\\tan{\\\\left(- 5 x \\\\right)} \\\\sec{\\\\left(- 5 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- 5 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-5.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 7 \\\\tan{\\\\left(- 5 x \\\\right)} \\\\sec{\\\\left(- 5 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{5}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{5}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7 \\\\sec{\\\\left(u \\\\right)}}{5}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7 \\\\sec{\\\\left(- 5 x \\\\right)}}{5}+C.\\n$$\"} {:db/id 17592186678134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"baa6babc-bc07-5e07-808c-dec2b4549800\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cot{\\\\left(2 - 2 x \\\\right)}\" :db/id 17592186678205}] :answer-field/correct {:answer/id #uuid \"baa6babc-bc07-5e07-808c-dec2b4549800\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cot{\\\\left(2 - 2 x \\\\right)}\" :db/id 17592186678205} :answer-field/id #uuid \"0af3bd85-54e0-5e73-a07d-7e18c96b76bc\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678136}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"003780e2-4716-5160-81ce-fe4c4042e016\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\csc^{2}{\\\\left(2 - 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 - 2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\csc^{2}{\\\\left(2 - 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\cot{\\\\left(2 - 2 x \\\\right)}+C.\\n$$\"} {:db/id 17592186678135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e7f722e9-70a7-58ac-8289-58758132f251\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\sec{\\\\left(3 - 3 x \\\\right)}\" :db/id 17592186678227}] :answer-field/correct {:answer/id #uuid \"e7f722e9-70a7-58ac-8289-58758132f251\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\sec{\\\\left(3 - 3 x \\\\right)}\" :db/id 17592186678227} :answer-field/id #uuid \"553902b8-0f27-5bcf-a11f-d8127f19a717\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678156}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"05fa3cab-effd-596e-9612-ab8ff5c8fc51\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\tan{\\\\left(3 - 3 x \\\\right)} \\\\sec{\\\\left(3 - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=3 - 3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\tan{\\\\left(3 - 3 x \\\\right)} \\\\sec{\\\\left(3 - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\sec{\\\\left(3 - 3 x \\\\right)}+C.\\n$$\"} {:db/id 17592186678138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1ebcc078-5f5b-5153-a2be-6b7b467d35ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4 \\\\cot{\\\\left(3 x + 3 \\\\right)}}{3}\" :db/id 17592186678140}] :answer-field/correct {:answer/id #uuid \"1ebcc078-5f5b-5153-a2be-6b7b467d35ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4 \\\\cot{\\\\left(3 x + 3 \\\\right)}}{3}\" :db/id 17592186678140} :answer-field/id #uuid \"de663327-71ff-5dc5-91bf-95991911281f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678224}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"120f2a90-dd77-5512-96e4-599cd74ab35c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\csc^{2}{\\\\left(3 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=3 x + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\csc^{2}{\\\\left(3 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{4 \\\\cot{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{4 \\\\cot{\\\\left(3 x + 3 \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186678142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"49c65e4e-57a9-502d-9e88-dc0de852ae0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678153}] :answer-field/correct {:answer/id #uuid \"49c65e4e-57a9-502d-9e88-dc0de852ae0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678153} :answer-field/id #uuid \"172894a9-0e0a-5435-b00c-654abc55aab0\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678139}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"262ce555-2ea1-5af2-90b8-7a5c412925cb\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{6}} 4 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\sec{\\\\left(0 \\\\right)}=1,\\\\quad \\\\sec{\\\\left(\\\\frac{\\\\pi}{3} \\\\right)}=2$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{6}} 4 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{\\\\frac{\\\\pi}{3}} \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[2 \\\\sec{\\\\left(u \\\\right)}\\\\right]_{0}^{\\\\frac{\\\\pi}{3}}=\\\\left(4\\\\right)-\\\\left(2\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n2.\\n$$\"} {:db/id 17592186678148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9e4d7c72-6826-51f9-851a-030b3f004aa9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\sec{\\\\left(2 x \\\\right)}}{2}\" :db/id 17592186678189}] :answer-field/correct {:answer/id #uuid \"9e4d7c72-6826-51f9-851a-030b3f004aa9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\sec{\\\\left(2 x \\\\right)}}{2}\" :db/id 17592186678189} :answer-field/id #uuid \"a7af3103-1064-53cb-a423-c5073d533749\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678196}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"399b103b-f9fc-5fcb-9095-9fb0189a1c1d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\tan{\\\\left(2 x \\\\right)} \\\\sec{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3 \\\\sec{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\sec{\\\\left(2 x \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186678150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"dffc9365-6a7a-5e28-b7de-12da0e7f08b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678225}] :answer-field/correct {:answer/id #uuid \"dffc9365-6a7a-5e28-b7de-12da0e7f08b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678225} :answer-field/id #uuid \"3a5872b9-abe8-5166-9675-198f966ed97f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678149}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3b7aac27-412c-5a90-a059-92216a7c258c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{4}} 2 \\\\sec^{2}{\\\\left(- 2 x + \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\tan{\\\\left(\\\\frac{\\\\pi}{4} \\\\right)}=1,\\\\quad \\\\tan{\\\\left(- \\\\frac{\\\\pi}{4} \\\\right)}=-1$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=- 2 x + \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=- \\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{4}} 2 \\\\sec^{2}{\\\\left(- 2 x + \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{- \\\\frac{\\\\pi}{4}} \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- \\\\tan{\\\\left(u \\\\right)}\\\\right]_{\\\\frac{\\\\pi}{4}}^{- \\\\frac{\\\\pi}{4}}=\\\\left(1\\\\right)-\\\\left(-1\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n2.\\n$$\"} {:db/id 17592186678151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"56c65302-d79a-5cb1-aade-bbb618c33fbc\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\csc{\\\\left(2 x + 3 \\\\right)}\" :db/id 17592186678158}] :answer-field/correct {:answer/id #uuid \"56c65302-d79a-5cb1-aade-bbb618c33fbc\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\csc{\\\\left(2 x + 3 \\\\right)}\" :db/id 17592186678158} :answer-field/id #uuid \"703b45b6-fdc2-56d4-b0f7-af144b3f364c\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678165}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"3c987452-833d-52ca-801c-e7c865c4a892\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cot{\\\\left(2 x + 3 \\\\right)} \\\\csc{\\\\left(2 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cot{\\\\left(2 x + 3 \\\\right)} \\\\csc{\\\\left(2 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\csc{\\\\left(2 x + 3 \\\\right)}+C.\\n$$\"} {:db/id 17592186678157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"57475ea4-9e00-5e80-accb-69b85042a227\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678159} {:answer/id #uuid \"5c3da318-d488-5f59-a691-1c8c6a57408f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678161} {:answer/id #uuid \"96c82633-1aad-5866-9bd4-8a6c677f24d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678187} {:answer/id #uuid \"aa8553dc-8506-5370-9ee5-50ed20c73cdf\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678198} {:answer/id #uuid \"cadc840a-f89b-5da7-adc9-9c358ff602d7\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678213}] :answer-field/correct {:answer/id #uuid \"5c3da318-d488-5f59-a691-1c8c6a57408f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678161} :answer-field/id #uuid \"30b2284d-ab69-57ac-8d3e-1f9f9a820a4f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678146}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"5547e870-ea5e-5240-a320-2701146b3083\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\sec^{2}{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\sec^{2}{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2f7201c8-9c4f-53ae-a2de-1f874a5305b7\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678144} {:answer/id #uuid \"5cf7c77f-45ab-5bf4-a5c0-bb1a8bfdfebe\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678162} {:answer/id #uuid \"81f4eefd-e441-5672-91fd-1ed852f09c33\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678179} {:answer/id #uuid \"9a7e7968-a386-5692-bef4-f60d47603656\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678188} {:answer/id #uuid \"a6397a61-84cb-5fea-9251-0d5bd0b0ad64\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678194}] :answer-field/correct {:answer/id #uuid \"9a7e7968-a386-5692-bef4-f60d47603656\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678188} :answer-field/id #uuid \"3d85a0ae-e7e3-5f86-a48d-9fa049c9cb4b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678152}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"5bcc31f6-0f45-5cf1-9fb5-ae4752f5542e\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\csc^{2}{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\csc^{2}{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"32c1860a-6468-58de-8496-543c9f8a5cf8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678147} {:answer/id #uuid \"61252f7b-a033-556d-9fce-fc2179dab597\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678163} {:answer/id #uuid \"74a47de7-5bca-51af-8fea-a6b3bb391619\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678168} {:answer/id #uuid \"bacf56fb-1591-5101-bb38-2e38a2959c0b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678206} {:answer/id #uuid \"e90e7463-810a-50ea-92d8-d56845cd5842\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678228}] :answer-field/correct {:answer/id #uuid \"61252f7b-a033-556d-9fce-fc2179dab597\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678163} :answer-field/id #uuid \"accc42f5-badf-52f9-9310-7f1a3021ec2a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678199}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"7716b4bb-41c4-536a-b2e6-6211510350c1\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\sec^{2}{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b03c3251-7439-553b-ad72-28e3cbd872f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\csc{\\\\left(3 - 4 x \\\\right)}}{2}\" :db/id 17592186678201}] :answer-field/correct {:answer/id #uuid \"b03c3251-7439-553b-ad72-28e3cbd872f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\csc{\\\\left(3 - 4 x \\\\right)}}{2}\" :db/id 17592186678201} :answer-field/id #uuid \"7fc56e32-885c-5c5e-9954-2275c018a22f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678176}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"7a6b6cd2-5e3e-5af2-a25d-55ab52bf40c6\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cot{\\\\left(3 - 4 x \\\\right)} \\\\csc{\\\\left(3 - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=3 - 4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cot{\\\\left(3 - 4 x \\\\right)} \\\\csc{\\\\left(3 - 4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\csc{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\csc{\\\\left(3 - 4 x \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186678180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2fd18b9b-016e-5e4b-a350-740cfd5f00c5\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678145} {:answer/id #uuid \"7f95a1bd-7610-5262-b814-39a994730ffb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678175} {:answer/id #uuid \"bd3482f7-8203-50a5-b540-02f254e6ca84\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678208} {:answer/id #uuid \"d51eb858-c4be-5140-9d20-9bcfac42a6a5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678221} {:answer/id #uuid \"f57083b4-5ec9-5bde-9304-0253cea2a867\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678232}] :answer-field/correct {:answer/id #uuid \"7f95a1bd-7610-5262-b814-39a994730ffb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678175} :answer-field/id #uuid \"7c6784a8-2eef-5e10-959d-0f702578e2be\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678172}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"84d1ec0d-ea87-54c5-96c3-4c647691681e\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cot{\\\\left(3 x \\\\right)} \\\\csc{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cot{\\\\left(3 x \\\\right)} \\\\csc{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"c9e4194a-9e2c-514b-a3fc-7381ed4e59c4\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678212} {:answer/id #uuid \"cf85c922-e65b-5d41-9423-8046a0fd0955\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678218} {:answer/id #uuid \"dda4e21f-2ec7-54f7-a1a4-5560a9a83061\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678223} {:answer/id #uuid \"ec5cd4ce-db03-5b32-ad63-0cdfc999aec8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678230} {:answer/id #uuid \"fc8a1f8b-973c-5fd3-99b4-6f2281ccbac0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678236}] :answer-field/correct {:answer/id #uuid \"ec5cd4ce-db03-5b32-ad63-0cdfc999aec8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678230} :answer-field/id #uuid \"f7e38452-080f-5305-9fc3-ce6011996a71\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678234}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"86df9637-597a-5564-98ec-e1285a2b614d\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\tan{\\\\left(4 x \\\\right)} \\\\sec{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\tan{\\\\left(4 x \\\\right)} \\\\sec{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e47027d5-cebb-5a6e-ba2a-199f22a1dfcf\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678226}] :answer-field/correct {:answer/id #uuid \"e47027d5-cebb-5a6e-ba2a-199f22a1dfcf\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678226} :answer-field/id #uuid \"726fbe57-9e99-5ca8-a32c-2927b6ccd612\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678167}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a12513cf-5b77-57ed-9d9c-cdf66ea9782e\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{12}}^{\\\\frac{\\\\pi}{4}} 4 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\csc{\\\\left(\\\\frac{\\\\pi}{6} \\\\right)}=2,\\\\quad \\\\csc{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=1$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{12}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\\\\\x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{12}}^{\\\\frac{\\\\pi}{4}} 4 \\\\cot{\\\\left(2 x \\\\right)} \\\\csc{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{2}} \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- 2 \\\\csc{\\\\left(u \\\\right)}\\\\right]_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{2}}=\\\\left(-2\\\\right)-\\\\left(-4\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n2.\\n$$\"} {:db/id 17592186678191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d2bc3098-5bc7-5aa1-b282-dbb062bc1a03\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\tan{\\\\left(4 x + 3 \\\\right)}\" :db/id 17592186678220}] :answer-field/correct {:answer/id #uuid \"d2bc3098-5bc7-5aa1-b282-dbb062bc1a03\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\tan{\\\\left(4 x + 3 \\\\right)}\" :db/id 17592186678220} :answer-field/id #uuid \"80ad7916-a685-5554-9389-9c7d724f927f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678177}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a22f82c7-fd5e-5819-8731-d3a4255f5f8f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\sec^{2}{\\\\left(4 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=4 x + 3$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\sec^{2}{\\\\left(4 x + 3 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\tan{\\\\left(4 x + 3 \\\\right)}+C.\\n$$\"} {:db/id 17592186678192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a762ae91-08c8-5dc1-ab3e-8b0ec39af452\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678195}] :answer-field/correct {:answer/id #uuid \"a762ae91-08c8-5dc1-ab3e-8b0ec39af452\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678195} :answer-field/id #uuid \"a5559ef8-9e0d-51c7-9165-14b66785793b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678193}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a3775cc7-4ca1-5792-8e8e-67e74410350a\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{- \\\\frac{\\\\pi}{8}}^{0} 4 \\\\sec^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\tan{\\\\left(- \\\\frac{\\\\pi}{4} \\\\right)}=-1,\\\\quad \\\\tan{\\\\left(0 \\\\right)}=0$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=- \\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=- \\\\frac{\\\\pi}{4}\\\\\\\\x=0&\\\\Longrightarrow u=0\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{- \\\\frac{\\\\pi}{8}}^{0} 4 \\\\sec^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{- \\\\frac{\\\\pi}{4}}^{0} \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[2 \\\\tan{\\\\left(u \\\\right)}\\\\right]_{- \\\\frac{\\\\pi}{4}}^{0}=\\\\left(0\\\\right)-\\\\left(-2\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n2.\\n$$\"} {:db/id 17592186678200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ce2d1382-34fd-5922-985d-48032fb59127\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678215}] :answer-field/correct {:answer/id #uuid \"ce2d1382-34fd-5922-985d-48032fb59127\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186678215} :answer-field/id #uuid \"768c7847-4f5d-58f7-8535-737636a3cad4\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678169}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b03573b5-3c33-54e5-ba16-b877200034cd\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{8}} 4 \\\\csc^{2}{\\\\left(- 2 x + \\\\frac{\\\\pi}{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\cot{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=0,\\\\quad \\\\cot{\\\\left(\\\\frac{\\\\pi}{4} \\\\right)}=1$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=- 2 x + \\\\frac{\\\\pi}{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\\\\\x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{8}} 4 \\\\csc^{2}{\\\\left(- 2 x + \\\\frac{\\\\pi}{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{4}} \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[2 \\\\cot{\\\\left(u \\\\right)}\\\\right]_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{4}}=\\\\left(2\\\\right)-\\\\left(0\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n2.\\n$$\"} {:db/id 17592186678211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e9e6cfa2-30b7-57fc-bf92-13ef834aa870\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\" :db/id 17592186678229}] :answer-field/correct {:answer/id #uuid \"e9e6cfa2-30b7-57fc-bf92-13ef834aa870\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\" :db/id 17592186678229} :answer-field/id #uuid \"ec68e414-0ec0-5fdf-9da0-e316467f9a94\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678231}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c697346a-a2b5-5ea9-944d-83b5b405b4f7\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} 3 \\\\csc^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\cot{\\\\left(\\\\frac{\\\\pi}{4} \\\\right)}=1,\\\\quad \\\\cot{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=0$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\pi}{8}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\pi}{4}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\pi}{8}}^{\\\\frac{\\\\pi}{4}} 3 \\\\csc^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{2}} \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- \\\\frac{3 \\\\cot{\\\\left(u \\\\right)}}{2}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{2}}=\\\\left(0\\\\right)-\\\\left(- \\\\frac{3}{2}\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n\\\\frac{3}{2}.\\n$$\"} {:db/id 17592186678214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b076dd84-df83-5834-9e95-dc75f15ca11d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\tan{\\\\left(3 - 3 x \\\\right)}\" :db/id 17592186678202}] :answer-field/correct {:answer/id #uuid \"b076dd84-df83-5834-9e95-dc75f15ca11d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\tan{\\\\left(3 - 3 x \\\\right)}\" :db/id 17592186678202} :answer-field/id #uuid \"71ab5c94-fed8-57da-b4b1-38d582c32381\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678166}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cd8e3e77-0528-50e5-85fc-4e26a37d7199\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\sec^{2}{\\\\left(3 - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=3 - 3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\sec^{2}{\\\\left(3 - 3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\tan{\\\\left(3 - 3 x \\\\right)}+C.\\n$$\"} {:db/id 17592186678216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ee6c3df-237e-5e70-9f15-cec8532a2c0f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678137} {:answer/id #uuid \"29c28d4f-6e45-589c-897c-de611c89158a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678143} {:answer/id #uuid \"90da945a-f6e0-59f6-92b3-d12ce86dc388\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678184} {:answer/id #uuid \"95070805-8217-526a-b651-45362a73710e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678185} {:answer/id #uuid \"aa6c093f-6262-50ab-8d93-9e07c190ca43\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678197}] :answer-field/correct {:answer/id #uuid \"95070805-8217-526a-b651-45362a73710e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678185} :answer-field/id #uuid \"50233114-8bfc-5a3a-babb-48379d4ea1b4\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678155}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"cf52a268-c2f4-5263-9f3b-a89d482dc6d7\" :question/problem \"Use the substitution $u=3 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\tan{\\\\left(3 x \\\\right)} \\\\sec{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=3 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\tan{\\\\left(3 x \\\\right)} \\\\sec{\\\\left(3 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4e81b010-490c-570b-93d2-e5a808604b6b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678154} {:answer/id #uuid \"66926c42-3b79-5096-85a7-54ab5f3f57d4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678164} {:answer/id #uuid \"7d2aefb5-09af-5327-a2db-3e09ad104fd2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{8}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678173} {:answer/id #uuid \"818a4297-b6ce-53d2-ac25-b2db9ddd9960\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678178} {:answer/id #uuid \"b74ab3a2-4948-5b2f-b5c5-4353b4c86973\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678204}] :answer-field/correct {:answer/id #uuid \"4e81b010-490c-570b-93d2-e5a808604b6b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678154} :answer-field/id #uuid \"c0b1f161-876f-5583-b647-1bb23875ff37\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678209}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"cf61ea9c-58bc-510f-ad29-02ae8d17f5da\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\cot{\\\\left(4 x \\\\right)} \\\\csc{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\cot{\\\\left(4 x \\\\right)} \\\\csc{\\\\left(4 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b52b8be3-1572-53a3-a178-6a3cfe9a9008\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186678203}] :answer-field/correct {:answer/id #uuid \"b52b8be3-1572-53a3-a178-6a3cfe9a9008\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186678203} :answer-field/id #uuid \"8a9be053-8ff7-5a09-8987-120e07c9f6ee\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678183}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"d0a9d12a-1c6a-5869-82ed-3b368443b0d4\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{6}} 2 \\\\tan{\\\\left(- 2 x \\\\right)} \\\\sec{\\\\left(- 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\sec{\\\\left(0 \\\\right)}=1,\\\\quad \\\\sec{\\\\left(- \\\\frac{\\\\pi}{3} \\\\right)}=2$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=- 2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=- \\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{6}} 2 \\\\tan{\\\\left(- 2 x \\\\right)} \\\\sec{\\\\left(- 2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\left(\\\\int_{0}^{- \\\\frac{\\\\pi}{3}} \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[- \\\\sec{\\\\left(u \\\\right)}\\\\right]_{0}^{- \\\\frac{\\\\pi}{3}}=\\\\left(-2\\\\right)-\\\\left(-1\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n-1.\\n$$\"} {:db/id 17592186678233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7e4f9c28-3e7f-5518-a969-379c6d383efe\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678174} {:answer/id #uuid \"9633ff6f-dd3a-5f0d-a2d8-42b70911a8df\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\" :db/id 17592186678186} {:answer/id #uuid \"bcec3f9a-3067-5470-a835-4aec7a19a20a\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678207} {:answer/id #uuid \"c4121f96-e416-5cfd-b715-4040e6b9ec83\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678210} {:answer/id #uuid \"d945b78c-4511-5547-9eb2-1f7a4332cb3d\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678222}] :answer-field/correct {:answer/id #uuid \"9633ff6f-dd3a-5f0d-a2d8-42b70911a8df\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\" :db/id 17592186678186} :answer-field/id #uuid \"2218bd34-d713-5df4-9440-3cccecb3c930\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678141}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"f6e206a2-ede9-53f8-8dbc-dee0fe15ad90\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\csc^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=2 x$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\csc^{2}{\\\\left(2 x \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186678237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"fa1ec0d5-0a6f-5861-8adf-094ce7847be3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186678235}] :answer-field/correct {:answer/id #uuid \"fa1ec0d5-0a6f-5861-8adf-094ce7847be3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186678235} :answer-field/id #uuid \"85edd87a-47ba-5b47-b967-0cd7189874fc\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678181}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"fe829f07-c75c-52fb-a210-8165808e94ed\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\frac{\\\\pi}{6}} \\\\cot{\\\\left(- 2 x + \\\\frac{\\\\pi}{2} \\\\right)} \\\\csc{\\\\left(- 2 x + \\\\frac{\\\\pi}{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C$.\\n\\nEndpoint values: $\\\\csc{\\\\left(\\\\frac{\\\\pi}{2} \\\\right)}=1,\\\\quad \\\\csc{\\\\left(\\\\frac{\\\\pi}{6} \\\\right)}=2$.\\n\\n{{answer}}\" :question/worked-solution \"Let $u=- 2 x + \\\\frac{\\\\pi}{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=-2.\\n$$\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=\\\\frac{\\\\pi}{2}\\\\\\\\x=\\\\frac{\\\\pi}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\end{aligned}\\n$$\\n\\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\frac{\\\\pi}{6}} \\\\cot{\\\\left(- 2 x + \\\\frac{\\\\pi}{2} \\\\right)} \\\\csc{\\\\left(- 2 x + \\\\frac{\\\\pi}{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{6}} \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate:\\n\\n$$\\n\\\\left[\\\\frac{\\\\csc{\\\\left(u \\\\right)}}{2}\\\\right]_{\\\\frac{\\\\pi}{2}}^{\\\\frac{\\\\pi}{6}}=\\\\left(1\\\\right)-\\\\left(\\\\frac{1}{2}\\\\right).\\n$$\\n\\nThe answer is\\n\\n$$\\n\\\\frac{1}{2}.\\n$$\"}] :knowledge-point/title \"Integrating Reciprocal Trigonometric Functions With Linear Arguments\"}",
  "records": [
    {
      "knowledge_point": {
        "db_id": 17592186068916,
