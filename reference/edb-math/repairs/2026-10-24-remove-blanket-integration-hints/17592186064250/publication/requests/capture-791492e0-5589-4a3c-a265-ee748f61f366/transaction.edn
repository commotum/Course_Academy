88950ae-72ca-53a2-b232-019701118162" :answer-field/id #uuid "e88950ae-72ca-53a2-b232-019701118162"] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/key "answer"] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/type :answer-field.type/radio] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/choices "535fe772-f058-57ab-b2e0-8952481047d8"] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/choices "a68738ed-9899-56d6-b02a-48ba8b866c2b"] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/choices "24485cb7-d90d-5ec5-81d9-657e2f0476b4"] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/choices "e633ee65-dc4a-5c89-ac15-960a24ba93a6"] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/choices "bc0eb0d8-48b0-5c65-a977-ee443c1257bb"] [:db/add "e88950ae-72ca-53a2-b232-019701118162" :answer-field/correct "24485cb7-d90d-5ec5-81d9-657e2f0476b4"] [:db/ensure "e88950ae-72ca-53a2-b232-019701118162" :answer-field/validate] [:db/add "ce77e064-2ce6-5ce9-a443-8bef85a1034b" :question/id #uuid "ce77e064-2ce6-5ce9-a443-8bef85a1034b"] [:db/add "ce77e064-2ce6-5ce9-a443-8bef85a1034b" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{|x|\\sqrt{9 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|3 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "ce77e064-2ce6-5ce9-a443-8bef85a1034b" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|3 x|>1$.\n\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $12\\cdot \\frac{1}{3}=4$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{|x|\\sqrt{9 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=4\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n4\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=4\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n4\\left(\\operatorname{arcsec}{\\left(3 x \\right)}\\right)+C.\n$$"] [:db/add "ce77e064-2ce6-5ce9-a443-8bef85a1034b" :question/difficulty :question.difficulty/hard] [:db/add "ce77e064-2ce6-5ce9-a443-8bef85a1034b" :question/answer-fields "e88950ae-72ca-53a2-b232-019701118162"] [:db/ensure "ce77e064-2ce6-5ce9-a443-8bef85a1034b" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "ce77e064-2ce6-5ce9-a443-8bef85a1034b"] [:db/add "generator" :question-generator/id #uuid "60768809-3750-51be-a9aa-ab953c38eaa5"] [:db/add "generator" :question-generator/script "generators/74/74e3d64ae5c839f39554d463b26744edb4168c32b82da5d6a6aaf482d1a9c804/generator.py"] [:db/add 17592186064250 :knowledge-point/question-generator "generator"] [:db/ensure 17592186064250 :knowledge-point/validate] [:db/cas 17592186680064 :question/retired nil true] [:db/cas 17592186680069 :question/retired nil true] [:db/cas 17592186680103 :question/retired nil true] [:db/cas 17592186680104 :question/retired nil true] [:db/cas 17592186680108 :question/retired nil true] [:db/cas 17592186680116 :question/retired nil true] [:db/cas 17592186680130 :question/retired nil true] [:db/cas 17592186680141 :question/retired nil true] [:db/cas 17592186680162 :question/retired nil true] [:db/cas 17592186680174 :question/retired nil true] [:db/cas 17592186680187 :question/retired nil true] [:db/cas 17592186680191 :question/retired nil true] [:db/cas 17592186680202 :question/retired nil true] [:db/cas 17592186680207 :question/retired nil true] [:db/cas 17592186680219 :question/retired nil true] [:db/cas 17592186680225 :question/retired nil true]]
