rcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "d9f6dff2-8146-5856-b8fb-495275393216" :answer/validate] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/id #uuid "99dbf1cc-a09e-5df6-8efb-0dd755797d1f"] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/key "answer"] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/type :answer-field.type/radio] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/choices "b1da623c-2e0c-5a9b-a424-dfe1d824f0c3"] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/choices "055086c5-6f13-5ad6-970e-1af6842a9f61"] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/choices "bd3bc2b6-be7e-5afa-af48-b0af1220c340"] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/choices "27322754-1126-563c-95da-98b4cf7e998a"] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/choices "d9f6dff2-8146-5856-b8fb-495275393216"] [:db/add "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/correct "055086c5-6f13-5ad6-970e-1af6842a9f61"] [:db/ensure "99dbf1cc-a09e-5df6-8efb-0dd755797d1f" :answer-field/validate] [:db/add "e6d570ea-5a06-5863-b191-7f1d5b757751" :question/id #uuid "e6d570ea-5a06-5863-b191-7f1d5b757751"] [:db/add "e6d570ea-5a06-5863-b191-7f1d5b757751" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{|x|\\sqrt{4 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|2 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "e6d570ea-5a06-5863-b191-7f1d5b757751" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|2 x|>1$.\n\nBecause $2>0$, $|u|=2|x|$, so $|x|=|u|/2$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{2}=1$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{|x|\\sqrt{4 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(2 x \\right)}+C.\n$$"] [:db/add "e6d570ea-5a06-5863-b191-7f1d5b757751" :question/difficulty :question.difficulty/hard] [:db/add "e6d570ea-5a06-5863-b191-7f1d5b757751" :question/answer-fields "99dbf1cc-a09e-5df6-8efb-0dd755797d1f"] [:db/ensure "e6d570ea-5a06-5863-b191-7f1d5b757751" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "e6d570ea-5a06-5863-b191-7f1d5b757751"] [:db/add "7e5a1d40-0c0d-51fc-8b5e-3ee190d24a6a" :answer/id #uuid "7e5a1d40-0c0d-51fc-8b5e-3ee190d24a6a"] [:db/add "7e5a1d40-0c0d-51fc-8b5e-3ee190d24a6a" :answer/type :answer.type/math] [:db/add "7e5a1d40-0c0d-51fc-8b5e-3ee190d24a6a" :answer/value "\\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "7e5a1d40-0c0d-51fc-8b5e-3ee190d24a6a" :answer/validate] [:db/add "b744d123-2f26-5a87-a35e-9f9424512c2c" :answer/id #uuid "b744d123-2f26-5a87-a35e-9f9424512c2c"] [:db/add "b744d123-2f26-5a87-a35e-9f9424512c2c" :answer/type :answer.type/math] [:db/add "b744d123-2f26-5a87-a35e-9f9424512c2c" :answer/value "\\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(3 x \\right)}\\right)+C"] [:db/ensure "b744d123-2f26-5a87-a35e-9f9424512c2c" :answer/validate] [:db/add "19b0401f-9b48-5e18-bb49-a9fb491c923d" :answer/id #uuid "19b0401f-9b48-5e18-bb49-a9fb491c923d"] [:db/add "19b0401f-9b48-5e18-bb49-a9fb491c923d" :answer/type :answer.type/math] [:db/add "19b0401f-9b48-5e18-bb49-a9fb491c923d" :answer/value "2\\left(\\operatorname{arcsec}{\\left(x \\right)}\\right)+C"] [:db/ensure "19b0401f-9b48-5e18-bb49-a9fb491c923d" :answer/validate] [:db/add "780b7457-ccdc-5bab-9d1d-2a24b46338f2" :answer/id #uuid "780b7457-ccdc-5bab-9d1d-2a24b46338f2"] [:db/add "780b7457-ccdc-5bab-9d1d-2a24b46338f2" :answer/type :answer.type/math] [:db/add "780b7457-ccdc-5bab-9d1d-2a24b46338f2" :answer/value "\\operatorname{arcsec}{\\left(\\frac{3 x}{2} \\right)}+C"] [:db/ensure "780b7457-ccdc-5bab-9d1d-2a24b46338f2" :answer/validate] [:db/add "bbad7e74-3cb2-57be-a3fe-aaeb2c9f38da" :answer/id #uuid "bbad7e74-3cb2-57be-a3fe-aaeb2c9f38da"] [:db/add "bbad7e74-3cb2-57be-a3fe-aaeb2c9f38da" :answer/type :answer.type/math] [:db/add "bbad7e74-3cb2-57be-a3fe-aaeb2c9f38da" :answer/value "\\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(6 x \\right)}\\right)+C"] [:db/ensure "bbad7e74-3cb2-57be-a3fe-aaeb2c9f38da" :answer/validate] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/id #uuid "4740d65e-78a3-57c3-84a4-8d9196c424fc"] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/key "answer"] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/type :answer-field.type/radio] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/choices "7e5a1d40-0c0d-51fc-8b5e-3ee190d24a6a"] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/choices "b744d123-2f26-5a87-a35e-9f9424512c2c"] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/choices "19b0401f-9b48-5e18-bb49-a9fb491c923d"] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/choices "780b7457-ccdc-5bab-9d1d-2a24b46338f2"] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/choices "bbad7e74-3cb2-57be-a3fe-aaeb2c9f38da"] [:db/add "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/correct "7e5a1d40-0c0d-51fc-8b5e-3ee190d24a6a"] [:db/ensure "4740d65e-78a3-57c3-84a4-8d9196c424fc" :answer-field/validate] [:db/add "1b8d8045-2521-5f4f-b1af-d5713f3765d6" :question/id #uuid "1b8d8045-2521-5f4f-b1af-d5713f3765d6"] [:db/add "1b8d8045-2521-5f4f-b1af-d5713f3765d6" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{|x|\\sqrt{9 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|3 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "1b8d8045-2521-5f4f-b1af-d5713f3765d6" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|3 x|>1$.\n\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{3}=1$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{|x|\\sqrt{9 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(3 x \\right)}+C.\n$$"] [:db/add "1b8d8045-2521-5f4f-b1af-d5713f3765d6" :question/difficulty :question.difficulty/hard] [:db/add "1b8d8045-2521-5f4f-b1af-d5713f3765d6" :question/answer-fields "4740d65e-78a3-57c3-84a4-8d9196c424fc"] [:db/ensure "1b8d8045-2521-5f4f-b1af-d5713f3765d6" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "1b8d8045-2521-5f4f-b1af-d5713f3765d6"] [:db/add "52d87f59-c5fd-5fe8-93e4-565c100aa189" :answer/id #uuid "52d87f59-c5fd-5fe8-93e4-565c100aa189"] [:db/add "52d87f59-c5fd-5fe8-93e4-565c100aa189" :answer/type :answer.type/math] [:db/add "52d87f59-c5fd-5fe8-93e4-565c100aa189" :answer/value "3\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "52d87f59-c5fd-5fe8-93e4-565c100aa189" :answer/validate] [:db/add "3eac4463-c5be-574a-938d-0df69d3cdc1a" :answer/id #uuid "3eac4463-c5be-574a-938d-0df69d3cdc1a"] [:db/add "3eac4463-c5be-574a-938d-0df69d3cdc1a" :answer/type :answer.type/math] [:db/add "3eac4463-c5be-574a-938d-0