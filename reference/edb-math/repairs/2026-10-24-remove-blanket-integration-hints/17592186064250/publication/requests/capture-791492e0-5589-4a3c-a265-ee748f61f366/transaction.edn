\\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(3 x \\right)}+C.\n$$"] [:db/add "15d0a57a-da2d-543e-928d-7290d4d1d2ac" :question/difficulty :question.difficulty/moderate] [:db/add "15d0a57a-da2d-543e-928d-7290d4d1d2ac" :question/answer-fields "9a2961c8-2e97-538a-939d-ebb005be6318"] [:db/ensure "15d0a57a-da2d-543e-928d-7290d4d1d2ac" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "15d0a57a-da2d-543e-928d-7290d4d1d2ac"] [:db/add "347fc161-b0b8-583b-b7e4-f6c9a663637b" :answer/id #uuid "347fc161-b0b8-583b-b7e4-f6c9a663637b"] [:db/add "347fc161-b0b8-583b-b7e4-f6c9a663637b" :answer/type :answer.type/math] [:db/add "347fc161-b0b8-583b-b7e4-f6c9a663637b" :answer/value "- \\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "347fc161-b0b8-583b-b7e4-f6c9a663637b" :answer/validate] [:db/add "19416538-2c8c-5f95-b522-505565619b39" :answer/id #uuid "19416538-2c8c-5f95-b522-505565619b39"] [:db/add "19416538-2c8c-5f95-b522-505565619b39" :answer/type :answer.type/math] [:db/add "19416538-2c8c-5f95-b522-505565619b39" :answer/value "\\frac{1}{4}\\left(\\operatorname{arcsec}{\\left(8 x \\right)}\\right)+C"] [:db/ensure "19416538-2c8c-5f95-b522-505565619b39" :answer/validate] [:db/add "cf4792ea-0ede-5041-8f43-8afd3895bace" :answer/id #uuid "cf4792ea-0ede-5041-8f43-8afd3895bace"] [:db/add "cf4792ea-0ede-5041-8f43-8afd3895bace" :answer/type :answer.type/math] [:db/add "cf4792ea-0ede-5041-8f43-8afd3895bace" :answer/value "\\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(8 x \\right)}\\right)+C"] [:db/ensure "cf4792ea-0ede-5041-8f43-8afd3895bace" :answer/validate] [:db/add "f12baf47-7210-586a-ad42-b09b2903d36f" :answer/id #uuid "f12baf47-7210-586a-ad42-b09b2903d36f"] [:db/add "f12baf47-7210-586a-ad42-b09b2903d36f" :answer/type :answer.type/math] [:db/add "f12baf47-7210-586a-ad42-b09b290