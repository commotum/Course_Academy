[[:db/add "50b28ccf-f304-504d-875b-5536c2114a4b" :answer/id #uuid "50b28ccf-f304-504d-875b-5536c2114a4b"] [:db/add "50b28ccf-f304-504d-875b-5536c2114a4b" :answer/type :answer.type/math] [:db/add "50b28ccf-f304-504d-875b-5536c2114a4b" :answer/value "\\frac{1}{2}\\left(\\operatorname{arcsec}{\\left(2 x \\right)}\\right)+C"] [:db/ensure "50b28ccf-f304-504d-875b-5536c2114a4b" :answer/validate] [:db/add "ed6a018b-d5a4-58aa-83bd-4e6b7d4fc89c" :answer/id #uuid "ed6a018b-d5a4-58aa-83bd-4e6b7d4fc89c"] [:db/add "ed6a018b-d5a4-58aa-83bd-4e6b7d4fc89c" :answer/type :answer.type/math] [:db/add "ed6a018b-d5a4-58aa-83bd-4e6b7d4fc89c" :answer/value "\\operatorname{arcsec}{\\left(2 x \\right)}+C"] [:db/ensure "ed6a018b-d5a4-58aa-83bd-4e6b7d4fc89c" :answer/validate] [:db/add "85630e5c-2ff2-56a6-8b01-a1fa5e1921a3" :answer/id #uuid "85630e5c-2ff2-56a6-8b01-a1fa5e1921a3"] [:db/add "85630e5c-2ff2-56a6-8b01-a1fa5e1921a3" :answer/type :answer.type/math] [:db/add "85630e5c-2ff2-56a6-8b01-a1fa5e1921a3" :answer/value "2\\left(\\operatorname{arcsec}{\\left(2 x \\right)}\\right)+C"] [:db/ensure "85630e5c-2ff2-56a6-8b01-a1fa5e1921a3" :answer/validate] [:db/add "d502e6d1-b306-5402-b4e3-644fccddf767" :answer/id #uuid "d502e6d1-b306-5402-b4e3-644fccddf767"] [:db/add "d502e6d1-b306-5402-b4e3-644fccddf767" :answer/type :answer.type/math] [:db/add "d502e6d1-b306-5402-b4e3-644fccddf767" :answer/value "-1\\left(\\operatorname{arcsec}{\\left(x \\right)}\\right)+C"] [:db/ensure "d502e6d1-b306-5402-b4e3-644fccddf767" :answer/validate] [:db/add "36076719-3b02-5438-b142-e7333e59741b" :answer/id #uuid "36076719-3b02-5438-b142-e7333e59741b"] [:db/add "36076719-3b02-5438-b142-e7333e59741b" :answer/type :answer.type/math] [:db/add "36076719-3b02-5438-b142-e7333e59741b" :answer/value "2\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "36076719-3b02-5438-b142-e7333e59741b" :answer/validate] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/id #uuid "e0b78b21-1cdb-534d-90ad-fb780f583108"] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/key "answer"] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/type :answer-field.type/radio] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/choices "50b28ccf-f304-504d-875b-5536c2114a4b"] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/choices "ed6a018b-d5a4-58aa-83bd-4e6b7d4fc89c"] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/choices "85630e5c-2ff2-56a6-8b01-a1fa5e1921a3"] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/choices "d502e6d1-b306-5402-b4e3-644fccddf767"] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/choices "36076719-3b02-5438-b142-e7333e59741b"] [:db/add "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/correct "ed6a018b-d5a4-58aa-83bd-4e6b7d4fc89c"] [:db/ensure "e0b78b21-1cdb-534d-90ad-fb780f583108" :answer-field/validate] [:db/add "9488c98e-2c06-5b39-b9eb-8420048bbf36" :question/id #uuid "9488c98e-2c06-5b39-b9eb-8420048bbf36"] [:db/add "9488c98e-2c06-5b39-b9eb-8420048bbf36" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{|2 x|\\sqrt{4 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|2 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "9488c98e-2c06-5b39-b9eb-8420048bbf36" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|2 x|>1$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{2}=1$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{|2 x|\\sqrt{4 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(2 x \\right)}+C.\n$$"] [:db/add "9488c98e-2c06-5b39-b9eb-8420048bbf36" :question/difficulty :question.difficulty/moderate] [:db/add "9488c98e-2c06-5b39-b9eb-8420048bbf36" :question/answer-fields "e0b78b21-1cdb-534d-90ad-fb780f583108"] [:db/ensure "9488c98e-2c06-5b39-b9eb-8420048bbf36" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "9488c98e-2c06-5b39-b9eb-8420048bbf36"] [:db/add "d03af0d7-0427-5dfc-8aa9-bf4e4ce0ae5b" :answer/id #uuid "d03af0d7-0427-5dfc-8aa9-bf4e4ce0ae5b"] [:db/add "d03af0d7-0427-5dfc-8aa9-bf4e4ce0ae5b" :answer/type :answer.type/math] [:db/add "d03af0d7-0427-5dfc-8aa9-bf4e4ce0ae5b" :answer/value "\\frac{8}{3}\\left(\\operatorname{arcsec}{\\left(6 x \\right)}\\right)+C"] [:db/ensure "d03af0d7-0427-5dfc-8aa9-bf4e4ce0ae5b" :answer/validate] [:db/add "1f343c7a-574f-531d-95ae-d396257bc33b" :answer/id #uuid "1f343c7a-574f-531d-95ae-d396257bc33b"] [:db/add "1f343c7a-574f-531d-95ae-d396257bc33b" :answer/type :answer.type/math] [:db/add "1f343c7a-574f-531d-95ae-d396257bc33b" :answer/value "\\frac{8}{3}\\left(\\operatorname{arcsec}{\\left(3 x \\right)}\\right)+C"] [:db/ensure "1f343c7a-574f-531d-95ae-d396257bc33b" :answer/validate] [:db/add "3849f6c9-ee5b-5405-a5d0-6f7b97aa178b" :answer/id #uuid "3849f6c9-ee5b-5405-a5d0-6f7b97aa178b"] [:db/add "3849f6c9-ee5b-5405-a5d0-6f7b97aa178b" :answer/type :answer.type/math] [:db/add "3849f6c9-ee5b-5405-a5d0-6f7b97aa178b" :answer/value "\\frac{2}{3}\\left(\\operatorname{arcsec}{\\left(6 x \\right)}\\right)+C"] [:db/ensure "3849f6c9-ee5b-5405-a5d0-6f7b97aa178b" :answer/validate] [:db/add "591e90b2-7087-51ea-a696-f7fe7e0b492d" :answer/id #uuid "591e90b2-7087-51ea-a696-f7fe7e0b492d"] [:db/add "591e90b2-7087-51ea-a696-f7fe7e0b492d" :answer/type :answer.type/math] [:db/add "591e90b2-7087-51ea-a696-f7fe7e0b492d" :answer/value "\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(\\frac{3 x}{2} \\right)}\\right)+C"] [:db/ensure "591e90b2-7087-51ea-a696-f7fe7e0b492d" :answer/validate] [:db/add "e235f3d4-d754-5287-b6b8-a8dcd28ce9bb" :answer/id #uuid "e235f3d4-d754-5287-b6b8-a8dcd28ce9bb"] [:db/add "e235f3d4-d754-5287-b6b8-a8dcd28ce9bb" :answer/type :answer.type/math] [:db/add "e235f3d4-d754-5287-b6b8-a8dcd28ce9bb" :answer/value "\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(3 x \\right)}\\right)+C"] [:db/ensure "e235f3d4-d754-5287-b6b8-a8dcd28ce9bb" :answer/validate] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/id #uuid "a098bcb9-efe7-53e5-9593-ccf0988dff34"] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/key "answer"] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/type :answer-field.type/radio] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/choices "d03af0d7-0427-5dfc-8aa9-bf4e4ce0ae5b"] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/choices "1f343c7a-574f-531d-95ae-d396257bc33b"] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/choices "3849f6c9-ee5b-5405-a5d0-6f7b97aa178b"] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/choices "591e90b2-7087-51ea-a696-f7fe7e0b492d"] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/choices "e235f3d4-d754-5287-b6b8-a8dcd28ce9bb"] [:db/add "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/correct "e235f3d4-d754-5287-b6b8-a8dcd28ce9bb"] [:db/ensure "a098bcb9-efe7-53e5-9593-ccf0988dff34" :answer-field/validate] [:db/add "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f" :question/id #uuid "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f"] [:db/add "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{|3 x|\\sqrt{9 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|3 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|3 x|>1$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{3}=\\frac{4}{3}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{|3 x|\\sqrt{9 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{4}{3}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{4}{3}\\left(\\operatorname{arcsec}{\\left(3 x \\right)}\\right)+C.\n$$"] [:db/add "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f" :question/difficulty :question.difficulty/moderate] [:db/add "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f" :question/answer-fields "a098bcb9-efe7-53e5-9593-ccf0988dff34"] [:db/ensure "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "4d9def4d-ec1c-5e4e-89a1-371b4cabc16f"] [:db/add "f6e9f071-c006-53c8-84ea-9610b3a912ef" :answer/id #uuid "f6e9f071-c006-53c8-84ea-9610b3a912ef"] [:db/add "f6e9f071-c006-53c8-84ea-9610b3a912ef" :answer/type :answer.type/math] [:db/add "f6e9f071-c006-53c8-84ea-9610b3a912ef" :answer/value "\\frac{4}{5}\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C"] [:db/ensure "f6e9f071-c006-53c8-84ea-9610b3a912ef" :answer/validate] [:db/add "7c5e4a99-6018-51b0-8638-5e0e8fdeefb4" :answer/id #uuid "7c5e4a99-6018-51b0-8638-5e0e8fdeefb4"] [:db/add "7c5e4a99-6018-51b0-8638-5e0e8fdeefb4" :answer/type :answer.type/math] [:db/add "7c5e4a99-6018-51b0-8638-5e0e8fdeefb4" :answer/value "\\frac{8}{5}\\left(\\operatorname{arcsec}{\\left(x \\right)}