  "before_edn": "{:db/id 17592186064250 :knowledge-point/canonical-example {:db/id 17592186064101 :question/id #uuid \"56860611-869d-5035-bf8f-f568c774d78d\" :question/math-academy-id \"e-5014\" :question/problem \"$$\\n\\\\displaystyle {\\\\displaystyle \\\\int \\\\dfrac{5\\\\, \\\\textrm{d}x}{|5x|\\\\sqrt{(5x)^2-1}}  = }\\n$$\" :question/worked-solution \"This resembles the basic integral for $\\\\textrm{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{u^2-1}} \\\\textrm{d}u = \\\\textrm{arcsec}(u)+C.\\n$$\\n\\nLet $u = 5x.$ Then\\n\\n$$\\n\\\\dfrac{\\\\textrm{d}u}{\\\\textrm{d}x}=5\\n\\\\quad\\\\Longrightarrow\\\\quad\\n5\\\\,\\\\textrm{d}x = \\\\textrm{d}u.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{5\\\\,\\\\text{d}x}{|5x|\\\\sqrt{(5x)^{2}-1}} & =\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec}(u)+C \\\\\\\\  & =\\\\text{arcsec}(5x)+C.\\\\end{aligned}\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"8d18bdc7-9387-5b2d-98bd-015fa4a1eba7\" :knowledge-point/level-coverage [{:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186680228 :question-generator/id #uuid \"1fb53caa-df0e-5c70-9c5b-f0d19d4416b4\" :question-generator/script \"generators/38/3863ea472908f17e1f0524d241f4c90b18b0bfe707b9a6d2914db21b43cc6db3/generator.py\"} :knowledge-point/questions [{:db/id 17592186064941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"33cf2d14-d04d-51e3-b76e-64b8e1a665b6\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\text{arcsec}(8x)+C\" :db/id 17592186333465} {:answer/id #uuid \"3dc9dd34-b284-58b6-84db-345e4e630da9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(64x)+C\" :db/id 17592186333571} {:answer/id #uuid \"8f11fd04-9fa8-5d58-b9c9-6ab52adba008\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(8x)+C\" :db/id 17592186334264} {:answer/id #uuid \"d2244dec-f6d2-5e94-8b71-32f7eabc6720\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(8x)}{8}+C\" :db/id 17592186334825} {:answer/id #uuid \"d66dc866-442a-59b0-ad6e-365d928672f6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(4x)}{4}+C\" :db/id 17592186334866}] :answer-field/correct {:answer/id #uuid \"8f11fd04-9fa8-5d58-b9c9-6ab52adba008\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(8x)+C\" :db/id 17592186334264} :answer-field/id #uuid \"ae92fcf7-e93b-597c-a9c2-a8feb16ae56b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186335558}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1c758c6a-6697-5dfb-b64a-bc653c6c226b\" :question/math-academy-id \"q-69476\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{8\\\\,\\\\text{d}x}{|8x|\\\\sqrt{(8x)^{2}-1}}=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{8\\\\,\\\\text{d}x}{|8x|\\\\sqrt{(8x)^{2}-1}}=8\\\\int \\\\frac{\\\\text{d}x}{|8x|\\\\sqrt{(8x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $8x.$\\n\\nSo, let's substitute $u=8x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=8\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{8}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}8\\\\int \\\\frac{1}{|8x|\\\\sqrt{(8x)^{2}-1}}\\\\text{d}x & =8\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{8}\\\\text{d}u) \\\\\\\\  & =\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(8x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186064952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"17153736-08a5-511b-8d66-3076de3a56f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186339331} {:answer/id #uuid \"287af432-ac1d-5bb0-9cce-df095ab56481\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(2x)}{4}+C\" :db/id 17592186339481} {:answer/id #uuid \"3031610e-8402-5eae-b837-b04a952ccb28\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186339548} {:answer/id #uuid \"741561ed-033d-5aff-8ad7-766c99be57a0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186340158} {:answer/id #uuid \"c8a5cb98-9b11-5ca7-8b96-437d604616ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\text{arcsec}(2x)}{2}+C\" :db/id 17592186340906}] :answer-field/correct {:answer/id #uuid \"3031610e-8402-5eae-b837-b04a952ccb28\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\text{arcsec}(2x)+C\" :db/id 17592186339548} :answer-field/id #uuid \"79900759-4114-5519-b212-5c813256836c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341594}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a6fafd98-c438-5a64-a87a-7a2d0a58fd7e\" :question/math-academy-id \"q-73717\" :question/problem \"$$\\n\\\\displaystyle \\\\int \\\\frac{2}{|x|\\\\sqrt{4{x}^{2}-1}}\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{2\\\\,\\\\text{d}x}{|x|\\\\sqrt{4{x}^{2}-1}}=4\\\\int \\\\frac{\\\\text{d}x}{|2x|\\\\sqrt{(2x)^{2}-1}}.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $2x.$\\n\\nSo, let's substitute $u=2x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{2}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{2}{|x|\\\\sqrt{4{x}^{2}-1}}\\\\,\\\\text{d}x & =4\\\\int \\\\frac{1}{|2x|\\\\sqrt{(2x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =4\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{2}\\\\text{d}u) \\\\\\\\  & =2\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =2\\\\,\\\\text{arcsec}\\\\,u+C \\\\\\\\  & =2\\\\,\\\\text{arcsec}(2x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2557c8c9-61d4-546a-b12e-2149e3cb0784\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186247753} {:answer/id #uuid \"4b9ffc95-a0ae-5868-bc4f-b4a2ff82ae20\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186248100} {:answer/id #uuid \"90d77fc7-cc8f-513f-84a7-ae393b51759b\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\text{arcsec}(5x)+C\" :db/id 17592186248710} {:answer/id #uuid \"da3de159-0af1-5109-a432-7a259afa945f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{5}\\\\,\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186249353} {:answer/id #uuid \"f5ce8cb5-8424-5bdb-b48e-afc1856f992f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(5x)+C\" :db/id 17592186249568}] :answer-field/correct {:answer/id #uuid \"2557c8c9-61d4-546a-b12e-2149e3cb0784\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\text{arcsec}(\\\\sqrt{5}x)+C\" :db/id 17592186247753} :answer-field/id #uuid \"5bb9394d-1677-5845-bcf1-c7fd75b784b5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249835}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"721577ab-4fa8-5463-8c74-5d6cebd1decf\" :question/math-academy-id \"q-114051\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{1}{|x|\\\\sqrt{5{x}^{2}-1}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Note that we can rewrite this integral as\\n\\n$$\\n\\\\int \\\\frac{\\\\text{d}x}{|x|\\\\sqrt{5{x}^{2}-1}}=\\\\int \\\\frac{\\\\sqrt{5}}{|\\\\sqrt{5}x|\\\\sqrt{(\\\\sqrt{5}x)^{2}-1}}\\\\text{d}x.\\n$$\\n\\nThis integral now resembles the basic one for $\\\\text{arcsec},$\\n\\n$$\\n\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\text{d}u=\\\\text{arcsec}(u)+C.\\n$$\\n\\nThe only difference is that instead of $u$ as the variable, we have $\\\\sqrt{5}x.$\\n\\nSo, let's substitute $u=\\\\sqrt{5}x.$ Differentiating, we get\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\sqrt{5}\\\\,⟹\\\\,\\\\text{d}x=\\\\frac{1}{\\\\sqrt{5}}\\\\text{d}u.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{1}{|x|\\\\sqrt{5{x}^{2}-1}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{\\\\sqrt{5}}{|\\\\sqrt{5}x|\\\\sqrt{(\\\\sqrt{5}x)^{2}-1}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\sqrt{5}\\\\int \\\\frac{1}{|u|\\\\sqrt{{u}^{2}-1}}\\\\cdot (\\\\frac{1}{\\\\sqrt{5}}\\\\text{d}u) \\\\\\\\  & =\\\\sqrt{5}\\\\cdot \\\\frac{1}{\\\\sqrt{5}}\\\\int \\\\frac{\\\\text{d}u}{|u|\\\\sqrt{{u}^{2}-1}} \\\\\\\\  & =\\\\text{arcsec }u+C \\\\\\\\  & =\\\\text{arcsec}(\\\\sqrt{5}x)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4d1c680b-da3e-532e-b768-23a73eed1830\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\,\\\\text{arcsec}(x)+C\" :db/id 17592186248115} {:answer/id #uuid \"7