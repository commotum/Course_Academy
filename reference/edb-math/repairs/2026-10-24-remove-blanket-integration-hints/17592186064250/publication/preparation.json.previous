{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680129} {:answer/id #uuid \"78afbe40-2982-59b6-a929-b741df18ec7b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{8}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680133} {:answer/id #uuid \"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680179} {:answer/id #uuid \"ee416b02-f6d8-5944-80fd-be5c1139ab5b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{16}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680217}] :answer-field/correct {:answer/id #uuid \"bf2c5ecf-f3f2-5296-9a0c-c0709aac3499\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680179} :answer-field/id #uuid \"a62533c6-7811-5118-b3f3-09b68014a85a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680166}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"02d4a9ce-1e83-5227-93dc-e7eb1721bb86\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"16b2d4ef-e63d-5505-b7d9-f37f61d625d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680077} {:answer/id #uuid \"3796c0ea-cde4-58eb-a226-0de3696f41e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186680101} {:answer/id #uuid \"450ac2fe-1a99-5118-a833-347f59ea9da3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}+C\" :db/id 17592186680107} {:answer/id #uuid \"8fe3a467-f753-5f74-9801-d0f11c60b24e\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\" :db/id 17592186680147} {:answer/id #uuid \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680186}] :answer-field/correct {:answer/id #uuid \"c59f6e77-cc20-5320-b7ce-d852ba60f52e\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680186} :answer-field/id #uuid \"bfd70697-b91d-5c47-a181-3da1acce89c9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680181}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"049adf91-8527-55f1-a6ee-6f90fabbcdd7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $10\\\\cdot \\\\frac{1}{5}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0f571e69-41b4-528e-88d7-d84f2aa8259c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680073} {:answer/id #uuid \"40feda46-d342-5cef-ba12-30773f0d3723\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186680105} {:answer/id #uuid \"56ef5604-2eb6-5198-9605-7786a819ee07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680114} {:answer/id #uuid \"59519cf4-e762-57cb-a030-105b00e1faac\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}+C\" :db/id 17592186680115} {:answer/id #uuid \"c270fd30-ee22-5180-b732-d29668ca15e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680184}] :answer-field/correct {:answer/id #uuid \"40feda46-d342-5cef-ba12-30773f0d3723\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186680105} :answer-field/id #uuid \"ecf22287-e7ac-53c6-b876-fd2048726cd4\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680215}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"0a802c2b-6d44-5e3b-8524-69c4811ecad9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C.\\n$$\"} {:db/id 17592186680103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0d5b56c9-7607-5db4-bdf6-e7e62ef6573d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680071} {:answer/id #uuid \"84490db6-6b93-5265-8ae3-8875e2514a2e\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680143} {:answer/id #uuid \"ad349545-f06c-5647-afae-19a519da2bbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680170} {:answer/id #uuid \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680200} {:answer/id #uuid \"ec8c9dfd-ff66-5a17-9e6d-f03e6cb14994\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186680214}] :answer-field/correct {:answer/id #uuid \"e25e7b90-5a59-52d3-9b70-ab71bc8cdf48\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680200} :answer-field/id #uuid \"cc51aeb5-0fb5-5a82-b880-19e13eb7f666\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680192}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3dcd0af0-2803-535c-b276-8eb7fdad5da3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{3}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1407ee65-2f79-586e-81a6-8fb7f82329e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\" :db/id 17592186680076} {:answer/id #uuid \"1d070ab3-811f-5739-b6ab-63bd68171300\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680080} {:answer/id #uuid \"29726943-6c48-5d78-9ab1-9d5e4826a361\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\" :db/id 17592186680089} {:answer/id #uuid \"dc598021-6c66-5115-ac71-3cd33ebc8da9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186680198} {:answer/id #uuid \"f6e19d42-27e3-5b3a-beef-f63000b64093\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680221}] :answer-field/correct {:answer/id #uuid \"f6e19d42-27e3-5b3a-beef-f63000b64093\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680221} :answer-field/id #uuid \"021c7d86-f00a-57fa-8bfe-7262334eefe1\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680062}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"40b27085-34e6-58d6-ab38-f796eb2eb64b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"29b6b7ce-9447-5530-8b85-6f66725c310d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{10}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680090} {:answer/id #uuid \"4c82403a-eca7-54a8-9c6f-185d871da9c4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680109} {:answer/id #uuid \"5f54c10e-b1d1-502a-887b-5f22b474dd2c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680122} {:answer/id #uuid \"d337e478-9e3d-5fee-a8e2-b96923986bc6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680194} {:answer/id #uuid \"eaa26936-cc54-54db-ba96-50da2dc56209\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{20}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680213}] :answer-field/correct {:answer/id #uuid \"4c82403a-eca7-54a8-9c6f-185d871da9c4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680109} :answer-field/id #uuid \"00e551b0-4ea8-5b08-ad11-54101d321313\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680060}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"41707ce6-ae13-5f46-a338-b37dceac0ae7\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{5}=\\\\frac{1}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1e5bc335-b7ee-5118-928d-e6feab31911e\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680082} {:answer/id #uuid \"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680087} {:answer/id #uuid \"65b8ecf5-a710-51e2-b9f4-d598c7ced40e\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680126} {:answer/id #uuid \"cb30fedb-fba5-5743-bc4f-0e48589d012b\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186680189} {:answer/id #uuid \"fa2e53a6-5258-5f95-88f1-f13797ab2172\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680222}] :answer-field/correct {:answer/id #uuid \"2658604b-a626-5178-a760-4f6e99b1f804\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680087} :answer-field/id #uuid \"e8b4aec0-a68b-5d4a-81cd-84562d3316c9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680212}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"491e4c26-a08b-53a0-9c8a-2f14d053b450\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nBecause $5>0$, $|u|=5|x|$, so $|x|=|u|/5$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $15\\\\cdot \\\\frac{1}{5}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680068} {:answer/id #uuid \"1b86c668-9c14-5fd7-b4a8-e830266452d1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{10}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680079} {:answer/id #uuid \"1fd78838-add0-5184-a216-6e1e6e35e6fd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680083} {:answer/id #uuid \"83d848f7-df88-5583-a04b-708515325915\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680142} {:answer/id #uuid \"e49aa456-6a27-5e27-a88e-28d4dfe3e343\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{5 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186680206}] :answer-field/correct {:answer/id #uuid \"08c60dee-8be6-5408-826e-7205668d1b78\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680068} :answer-field/id #uuid \"7f0fef05-ab2a-5429-9f3b-e358d19bd9af\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680139}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"5a4cf722-3932-5fb6-8d70-364a496ddcfb\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"07cda746-87cb-5523-93ce-d92d3a75a507\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680067} {:answer/id #uuid \"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680132} {:answer/id #uuid \"7a05fcc2-1905-5746-b765-f0093ad64183\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{12}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680135} {:answer/id #uuid \"9636625a-1efe-52f4-8200-3a1031432e07\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680153} {:answer/id #uuid \"e3d6d198-0795-5155-a94f-e9ba7449736a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680203}] :answer-field/correct {:answer/id #uuid \"76b66486-a4e5-5cb2-a0e3-13bc3be03fd8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680132} :answer-field/id #uuid \"dd581dc8-7072-5e17-a1d9-7722221a47a2\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680199}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"5a88e33b-bcc9-5d5e-854e-716b08caf25b\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{1}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $1\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"35abe1d1-b7ba-531f-8f3e-5d308559245a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680098} {:answer/id #uuid \"37fa1250-948e-5d74-b739-568c930134a9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{8}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680102} {:answer/id #uuid \"61b87488-e1b1-56c7-8df9-6b876e4d81bd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\" :db/id 17592186680124} {:answer/id #uuid \"8c089f0f-d3e5-58d7-ba9b-1056ffc774cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\" :db/id 17592186680146} {:answer/id #uuid \"9a476002-ac5f-52af-bf76-63871a1b23ee\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{8}\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\" :db/id 17592186680155}] :answer-field/correct {:answer/id #uuid \"35abe1d1-b7ba-531f-8f3e-5d308559245a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680098} :answer-field/id #uuid \"32368e13-0345-5935-ade8-e3ec1338c7dc\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680096}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"7557536f-4126-5553-aa32-304478d3cfce\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"10d5ce71-080a-5c4f-a79a-5af969e4199f\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{8}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680074} {:answer/id #uuid \"933d89e5-33d4-5d8e-99e1-4a57c2894d42\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680149} {:answer/id #uuid \"bee9d946-5ccd-542f-bcec-8fddec40d364\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680178} {:answer/id #uuid \"cc55ef6e-03b9-592e-8942-663ffeec6c1e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680193} {:answer/id #uuid \"d384d25f-4a4f-5e6d-8419-95cdb4afd4f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{15}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680195}] :answer-field/correct {:answer/id #uuid \"bee9d946-5ccd-542f-bcec-8fddec40d364\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680178} :answer-field/id #uuid \"ad967691-4e47-55c5-954b-2976bd4e4f9c\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680171}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"7a8b5646-0d93-57dd-bce0-4189d3f0c2b9\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{5}=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0591c87c-b5fd-5b16-8be3-400aa1f889a5\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680065} {:answer/id #uuid \"1282b5ae-e8e0-5fbd-91f3-9ef00f1ed768\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680075} {:answer/id #uuid \"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\" :db/id 17592186680091} {:answer/id #uuid \"e7fbdf1f-8fe3-5789-b214-1a40b7b2b6ee\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680211} {:answer/id #uuid \"fc076000-db2a-5052-b4c4-0e2e2eca2e22\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680224}] :answer-field/correct {:answer/id #uuid \"2d46568f-35d0-59e3-bb81-1bf1bf2f5835\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\" :db/id 17592186680091} :answer-field/id #uuid \"bc3140f2-15c8-5cf2-9ee2-08c72d9691af\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680176}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"7bb97d40-751e-5a89-8260-47ab1a2975f5\" :question/problem \"Use the substitution $u=4 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{4}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|4 x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186680141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680070} {:answer/id #uuid \"63879433-a599-50d9-af42-eabbbe9ff7a0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680125} {:answer/id #uuid \"9b09972a-d5da-5894-b5c6-29eda9816c52\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680157} {:answer/id #uuid \"9bf2d56c-b1bf-5236-bc55-5dfecd1a0d9c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680158} {:answer/id #uuid \"9d2e5afa-a4aa-5752-a6ba-13d5953687a1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680160}] :answer-field/correct {:answer/id #uuid \"0c8b9bfc-3f40-5fb6-9623-29bf700d8b46\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680070} :answer-field/id #uuid \"16c44766-281e-567b-9905-b8d866c56e67\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680078}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8200acbd-0096-5a04-af42-dd11117a204a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2ea2ff82-703c-54b1-92a1-8595617df0fd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680094} {:answer/id #uuid \"331b5cab-6236-5757-8d95-e849b6b2f857\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680097} {:answer/id #uuid \"5b45ec8c-cc02-52b4-a17d-ac1aa6bc158d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680120} {:answer/id #uuid \"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\" :db/id 17592186680127} {:answer/id #uuid \"bfaf2f4c-f15d-5675-9ff1-12e8c2ccd8d2\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680180}] :answer-field/correct {:answer/id #uuid \"66d53b5c-25c6-5e85-b9ce-f6e358d39a5e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\" :db/id 17592186680127} :answer-field/id #uuid \"8b55815a-5fe7-563c-b750-34ce11ba09ee\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680145}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"94bc0fd8-e241-534c-9870-ebf348fb3dca\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186680162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2337c541-befe-5e68-829f-fa9ded0fb13c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680085} {:answer/id #uuid \"2dad638d-6795-5bba-a28c-d4dae1791941\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680092} {:answer/id #uuid \"363e5719-bea1-5a90-b7cd-1a4c44850541\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186680099} {:answer/id #uuid \"94df93dd-8a07-5cd0-9a0e-9ec4ca2f19e9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680152} {:answer/id #uuid \"c454ddf1-b042-548b-979d-26163cd00889\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680185}] :answer-field/correct {:answer/id #uuid \"2337c541-befe-5e68-829f-fa9ded0fb13c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680085} :answer-field/id #uuid \"00e82129-7eda-53bc-88cc-0e45dcbad61e\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680061}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9f5792d0-9c5b-52ee-9935-fa165bdce327\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|3 x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"54f7586f-f527-51b7-88bc-73fb71733563\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680113} {:answer/id #uuid \"9b0731ce-6786-56be-bb0a-e9b8f1a2dd58\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\" :db/id 17592186680156} {:answer/id #uuid \"9c42b6f6-9782-54c6-b192-1cade00c9715\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680159} {:answer/id #uuid \"a654c3c1-4947-5c5f-a861-a0df2f21663e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680167} {:answer/id #uuid \"e2c135f3-6e96-56c7-8c08-61da63dce8dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680201}] :answer-field/correct {:answer/id #uuid \"e2c135f3-6e96-56c7-8c08-61da63dce8dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680201} :answer-field/id #uuid \"9a0278f0-7eaf-5656-81fa-58702d8db23d\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680154}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a389fa12-c56e-5666-b913-2d1803b92aee\" :question/problem \"Use the substitution $u=2 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{4}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"25b04917-3e2e-511f-af2b-c28a5d7511f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(10 x \\\\right)}\\\\right)+C\" :db/id 17592186680086} {:answer/id #uuid \"ab63aa8c-62ba-5c8c-b205-9e1d92a9052c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680168} {:answer/id #uuid \"c232732a-db29-5875-8154-305ac841267d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680182} {:answer/id #uuid \"d3b722ee-7fcd-5510-ba61-91bb9c65258e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680196} {:answer/id #uuid \"e62a8238-b6cf-5f3a-80d9-d7b7a465c046\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680208}] :answer-field/correct {:answer/id #uuid \"c232732a-db29-5875-8154-305ac841267d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C\" :db/id 17592186680182} :answer-field/id #uuid \"cbb9e342-9d9a-5b33-a07b-d9352e99a26a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680190}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"bacbded8-6884-5d02-af40-16c8adf1cd96\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|5 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{5}=\\\\frac{4}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{5}\\\\left(\\\\operatorname{arcsec}{\\\\left(5 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6f92b6de-9a9e-580b-a58e-4a2e8748382b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680128} {:answer/id #uuid \"acfe1411-a20d-50b2-9786-78651d1d8b99\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{6}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680169} {:answer/id #uuid \"be462b5e-5b40-5509-8d1c-2b219e3afd8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680177} {:answer/id #uuid \"d4b7acfd-650c-5723-95d6-0142a81b2358\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680197} {:answer/id #uuid \"fa7f6192-1c3e-5718-9359-76c99aeb88e0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680223}] :answer-field/correct {:answer/id #uuid \"be462b5e-5b40-5509-8d1c-2b219e3afd8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680177} :answer-field/id #uuid \"2dc6375a-33b1-597f-8bdc-f368b50d332a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680093}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"bb1a95f2-7242-5d0c-b87d-badd20589922\" :question/problem \"Use the substitution $u=5 x$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\frac{2}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|5 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{5}=\\\\frac{2}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|5 x|\\\\sqrt{25 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{5}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"312f0b64-0080-560c-8c94-b1307ebc782d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186680095} {:answer/id #uuid \"791b8920-8fd6-521e-964b-9313f417245f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680134} {:answer/id #uuid \"93b49532-0f6a-5a43-8698-40eebc6646c1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186680150} {:answer/id #uuid \"a2c26a46-a940-5ebd-b1d4-1593d67186d0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186680164} {:answer/id #uuid \"e6b6b55d-b4bd-5dd2-b9c9-79955938bd22\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680209}] :answer-field/correct {:answer/id #uuid \"312f0b64-0080-560c-8c94-b1307ebc782d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186680095} :answer-field/id #uuid \"ed7dfad9-5215-5ab8-ba24-9aa7d64ffef6\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680216}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c5ea2443-4f53-5b5f-8fb9-dbfdaf0c20f1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|2 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|2 x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C.\\n$$\"} {:db/id 17592186680191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2807e6ed-28f0-59f1-b084-b1172e2711dd\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186680088} {:answer/id #uuid \"4d67807f-f051-58a0-a4be-685c094bc679\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\" :db/id 17592186680110} {:answer/id #uuid \"54529229-e39d-5828-9aaa-f10c52168335\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680112} {:answer/id #uuid \"5da84c1a-bdce-54f2-b7b8-d2c8a50d5e25\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680121} {:answer/id #uuid \"ff03e90e-2efc-5b40-9dd7-08a938701e62\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680226}] :answer-field/correct {:answer/id #uuid \"54529229-e39d-5828-9aaa-f10c52168335\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680112} :answer-field/id #uuid \"f2557e05-1d1d-59ae-bac0-cf51192b42a9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680220}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cbfeac20-e0ab-547c-9174-31fab0729907\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $12\\\\cdot \\\\frac{1}{4}=3$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186680081} {:answer/id #uuid \"1ff30185-c84c-5002-b862-7ddba735b925\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680084} {:answer/id #uuid \"b763cb42-886b-5194-8984-6a2638a66c26\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}+C\" :db/id 17592186680173} {:answer/id #uuid \"e437a879-3bca-5bb1-8f58-8ccfe64171c0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680204} {:answer/id #uuid \"e4878e77-2010-58f8-8642-ba3d3a29ace6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680205}] :answer-field/correct {:answer/id #uuid \"1e03586a-ab27-59c3-afe6-f8af8c0afcfc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C\" :db/id 17592186680081} :answer-field/id #uuid \"ffdbc59b-4a98-5be2-9c09-af4838aeaa1b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680227}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e331ac2e-b4b6-57b2-8b0f-429a3474445c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}+C.\\n$$\"} {:db/id 17592186680207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"513725b9-174c-57d6-b726-87c5f271d0ad\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(8 x \\\\right)}\\\\right)+C\" :db/id 17592186680111} {:answer/id #uuid \"7ef04cfb-9b44-500f-9dac-37a988e2f84c\" :answer/type {:db/ident :answer.type/math} :answer/value \"-4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680138} {:answer/id #uuid \"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680144} {:answer/id #uuid \"9de079d3-4a6f-5a15-bf36-79439d2fc94a\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680161} {:answer/id #uuid \"e734e59e-f86e-5bf3-89e2-d816b06704ab\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680210}] :answer-field/correct {:answer/id #uuid \"84bd64a7-02b2-590b-94bf-390d16a28f56\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680144} :answer-field/id #uuid \"36c808c4-9944-51f4-b5ac-8ea1b7b7854e\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680100}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e5ce8791-8926-5237-bce9-217f5aba6353\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|4 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|4 x|>1$.\\n\\nBecause $4>0$, $|u|=4|x|$, so $|x|=|u|/4$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $16\\\\cdot \\\\frac{1}{4}=4$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{|x|\\\\sqrt{16 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5a75205a-6fec-50af-b81c-a92046480f5b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680117} {:answer/id #uuid \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680140} {:answer/id #uuid \"a1ce50cb-a9c5-5784-b722-53d59b2eb6db\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680163} {:answer/id #uuid \"afe45ba4-e2b8-5d22-ab5d-91d91de2f1d2\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(6 x \\\\right)}\\\\right)+C\" :db/id 17592186680172} {:answer/id #uuid \"c964a6ce-c06b-541d-819a-91229e5e003a\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(\\\\frac{3 x}{2} \\\\right)}\\\\right)+C\" :db/id 17592186680188}] :answer-field/correct {:answer/id #uuid \"7f9506e5-3edd-5b28-a3d9-7a8ef5d2747d\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C\" :db/id 17592186680140} :answer-field/id #uuid \"9168c6ea-695d-5c34-9a06-19e028f21093\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680148}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f1f49f83-41db-5881-9619-52564f75d31c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|3 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|3 x|>1$.\\n\\nBecause $3>0$, $|u|=3|x|$, so $|x|=|u|/3$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $6\\\\cdot \\\\frac{1}{3}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{|x|\\\\sqrt{9 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\operatorname{arcsec}{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\operatorname{arcsec}{\\\\left(3 x \\\\right)}\\\\right)+C.\\n$$\"} {:db/id 17592186680225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"067f4ebb-409c-5b7e-9c1b-cfc1b5818eb0\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(4 x \\\\right)}\\\\right)+C\" :db/id 17592186680066} {:answer/id #uuid \"0e289e71-2a3b-558f-8969-f46ee6549e1b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186680072} {:answer/id #uuid \"5a9cc8c8-be9a-521e-a793-afe0886d5354\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}\\\\right)+C\" :db/id 17592186680119} {:answer/id #uuid \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186680183} {:answer/id #uuid \"f0055d4b-dc9b-5fa0-be8f-a97096145bf6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\operatorname{arcsec}{\\\\left(x \\\\right)}\\\\right)+C\" :db/id 17592186680218}] :answer-field/correct {:answer/id #uuid \"c2568efb-2d03-5aac-aeff-ef6549cba4b8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C\" :db/id 17592186680183} :answer-field/id #uuid \"7557fe38-875d-5795-99c4-a36c7fd5e097\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680131}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"fd18704b-c686-54f7-9804-c8dbf31969bd\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C$.\\n\\nWork on a connected interval where $|2 x|>1$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nWork on a connected real interval where $|2 x|>1$.\\n\\nBecause $2>0$, $|u|=2|x|$, so $|x|=|u|/2$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{1}{|x|\\\\sqrt{4 x^{2} - 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u^{2} - 1} \\\\left|{u}\\\\right|}\\\\,\\\\mathrm{d}u=\\\\operatorname{arcsec}{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\operatorname{arcsec}{\\\\left(2 x \\\\right)}+C.\\n$$\"}] :knowledge-point/title \"Calculating Indefinite Integrals Using Substitution with Inverse Secant\"}",
  "records": [
