[[:db/add "7b4a39ca-e69f-5208-b7f5-eae915903d06" :answer/id #uuid "7b4a39ca-e69f-5208-b7f5-eae915903d06"] [:db/add "7b4a39ca-e69f-5208-b7f5-eae915903d06" :answer/type :answer.type/math] [:db/add "7b4a39ca-e69f-5208-b7f5-eae915903d06" :answer/value "-3\\left(\\ln\\left|\\cos{\\left(x \\right)} + 2\\right|\\right)"] [:db/ensure "7b4a39ca-e69f-5208-b7f5-eae915903d06" :answer/validate] [:db/add "7c4f149b-9af0-50c6-90ce-998f03c6f69c" :answer-field/id #uuid "7c4f149b-9af0-50c6-90ce-998f03c6f69c"] [:db/add "7c4f149b-9af0-50c6-90ce-998f03c6f69c" :answer-field/key "answer"] [:db/add "7c4f149b-9af0-50c6-90ce-998f03c6f69c" :answer-field/type :answer-field.type/blank] [:db/add "7c4f149b-9af0-50c6-90ce-998f03c6f69c" :answer-field/choices "7b4a39ca-e69f-5208-b7f5-eae915903d06"] [:db/add "7c4f149b-9af0-50c6-90ce-998f03c6f69c" :answer-field/correct "7b4a39ca-e69f-5208-b7f5-eae915903d06"] [:db/ensure "7c4f149b-9af0-50c6-90ce-998f03c6f69c" :answer-field/validate] [:db/add "c1f31b66-4d83-5de5-8508-4b8621695b0d" :question/id #uuid "c1f31b66-4d83-5de5-8508-4b8621695b0d"] [:db/add "c1f31b66-4d83-5de5-8508-4b8621695b0d" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 \\sin{\\left(x \\right)}}{\\cos{\\left(x \\right)} + 2}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "c1f31b66-4d83-5de5-8508-4b8621695b0d" :question/worked-solution "Let $u=\\cos{\\left(x \\right)} + 2$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\sin{\\left(x \\right)}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3 \\sin{\\left(x \\right)}}{\\cos{\\left(x \\right)} + 2}\\,\\mathrm{d}x\\\\&=-3\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 1/u\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-3\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=-3\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n-3\\left(\\ln\\left|\\cos{\\left(x \\right)} + 2\\right|\\right)+C.\n$$"] [:db/add "c1f31b66-4d83-5de5-8508-4b8621695b0d" :question/difficulty :question.difficulty/moderate] [:db/add "c1f31b66-4d83-5de5-8508-4b8621695b0d" :question/answer-fields "7c4f149b-9af0-50c6-90ce-998f03c6f69c"] [:db/ensure "c1f31b66-4d83-5de5-8508-4b8621695b0d" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "c1f31b66-4d83-5de5-8508-4b8621695b0d"] [:db/add "416eebd9-766a-53c2-84a2-7624a35963d6" :answer/id #uuid "416eebd9-766a-53c2-84a2-7624a35963d6"] [:db/add "416eebd9-766a-53c2-84a2-7624a35963d6" :answer/type :answer.type/math] [:db/add "416eebd9-766a-53c2-84a2-7624a35963d6" :answer/value "- \\frac{2}{3}\\left(\\ln\\left|\\cos^{3}{\\left(x \\right)} + 3\\right|\\right)"] [:db/ensure "416eebd9-766a-53c2-84a2-7624a35963d6" :answer/validate] [:db/add "ddac9cd7-1f22-5149-bdab-a89527bc1324" :answer-field/id #uuid "ddac9cd7-1f22-5149-bdab-a89527bc1324"] [:db/add "ddac9cd7-1f22-5149-bdab-a89527bc1324" :answer-field/key "answer"] [:db/add "ddac9cd7-1f22-5149-bdab-a89527bc1324" :answer-field/type :answer-field.type/blank] [:db/add "ddac9cd7-1f22-5149-bdab-a89527bc1324" :answer-field/choices "416eebd9-766a-53c2-84a2-7624a35963d6"] [:db/add "ddac9cd7-1f22-5149-bdab-a89527bc1324" :answer-field/correct "416eebd9-766a-53c2-84a2-7624a35963d6"] [:db/ensure "ddac9cd7-1f22-5149-bdab-a89527bc1324" :answer-field/validate] [:db/add "6ae6d24a-a614-50df-81d0-3360d1c1ce3a" :question/id #uuid "6ae6d24a-a614-50df-81d0-3360d1c1ce3a"] [:db/add "6ae6d24a-a614-50df-81d0-3360d1c1ce3a" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2 \\sin{\\left(x \\right)} \\cos^{2}{\\left(x \\right)}}{\\cos^{3}{\\left(x \\right)} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}} $+C$"] [:db/add "6ae6d24a-a614-50df-81d0-3360d1c1ce3a" :question/worked-solution "Let $u=\\cos^{3}{\\left(x \\right)} + 3$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- 3 \\sin{\\left(x \\right)} \\cos^{2}{\\left(x \\right)}.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2 \\sin{\\left(x \\right)} \\cos^{2}{\\left(x \\right)}}{\\cos^{3}{\\left(x \\right)} + 3}\\,\\mathrm{d}x\\\\&=- \\frac{2}{3}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 1/u\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nIntegrate with respect to $u$:\n\n$$\n- \\frac{2}{3}\\left(\\int \\frac{1}{u}\\,\\mathrm{d}u\\right)=- \\frac{2}{3}\\left(\\ln\\left|u\\right|\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{2}{3}\\left(\\ln\\left|\\cos^{3}{\\left(x \\right)} + 3\\right|\\right)+C.\n$$"] [:db/add "6ae6d24a-a614-50df-81d0-3360d1c1ce3a" :question/difficulty :question.difficulty/moderate] [:db/add "6ae6d24a-a614-50df-81d0-3360d1c1ce3a" :question/answer-fields "ddac9cd7-1f22-5149-bdab-a89527bc1324"] [:db/ensure "6ae6d24a-a614-50df-81d0-3360d1c1ce3a" :question/validate] [:db/add 17592186068918 :knowledge-point/questions "6ae6d24a-a614-50df-81d0-3360d1c1ce3a"] [:db/add "a29fd001-03c0-5c39-8005-790b4f7cfe2f" :answer/id #uuid "a29fd001-03c0-5c39-8005-790b4f7cfe2f"] [:db/add "a29fd001-03c0-5c39-8005-790b4f7cfe2f" :answer/type :answer.type/math] [:db/add "a29fd001-03c0-5c39-8005-790b4f7cfe2f" :answer/value "\\ln\\left|\\sin{\\left(x \\right)} + 3\\right|"] [:db/ensure "a29fd001-03c0-5c39-8005-790b4f7cfe2f" :answer/validate] [:db/add "da9eab3c-6aaa-5362-901f-e3328ac69e51" :answer-field/id #uuid "da9eab3c-6aaa-5362-901f-e3328ac69e51"] [:db/add "da9eab3c-6aaa-5362-901f-e3328ac69e51" :answer-field/key "answer"] [:db/add "da9eab3c-6aaa-5362-901f-e3328ac69e51" :answer-field/type :answer-field.type/blank] [:db/add "da9eab3c-6aaa-5362-901f-e3328ac69e51" :answer-field/choices "a29fd001-03c0-5c39-8005-790b4f7cfe2f"] [:db/add "da9eab3c-6aaa-5362-901f-e3328ac69e51" :answer-field/correct "a29fd001-03c0-5c39-8005-790b4f7cfe2f"] [:db/ensure "da9eab3c-6aaa-5362-901f-e3328ac69e51" :answer-field/validate] [:db/add "9b8712e5-6a18-5375-a382-4eab025d2b03" :question/id #uuid "9b8712e5-6a18-5375-a382-4eab