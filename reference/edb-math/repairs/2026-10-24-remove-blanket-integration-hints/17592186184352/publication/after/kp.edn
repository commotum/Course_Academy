/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186266859} {:answer/id #uuid "50f90dfe-d802-574a-8ed8-759b5057b926" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266869} {:answer/id #uuid "57c0df91-f04f-5221-8066-bed8410acb39" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186266928}] :answer-field/correct {:answer/id #uuid "50f90dfe-d802-574a-8ed8-759b5057b926" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266869} :answer-field/id #uuid "db7fea76-3c9e-5620-891f-f29f43564753" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268797}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8b4cba33-ddfb-53fe-af87-4270187c1909" :question/math-academy-id "q-13751" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5{e}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}{e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡3} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{5}{2}(3-1) \\\\  & =\\frac{5}{2}(2) \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5bf8a0-a538-5131-b32d-777d76c86e0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3\\ln 2}" :db/id #edb/ref 17592186183061} {:answer/id #uuid "00154e8b-a47a-59a6-9e54-9aee8af6344c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6\\ln 2}" :db/id #edb/ref 17592186183062} {:answer/id #uuid "3185e3f8-9923-5b43-9df1-2a552956c3a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6\\ln 2}" :db/id #edb/ref 17592186183063} {:answer/id #uuid "42546591-d960-5ea6-822b-c544d4094b17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2\\ln 2}" :db/id #edb/ref 17592186183064} {:answer/id #uuid "79a4d23b-d2d8-5bbc-814e-532fcf20645f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8\\ln 2}" :db/id #edb/ref 17592186183065}] :answer-field/id #uuid "95360911-bf76-5292-82a2-81c244f28aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183060}] :question/id #uuid "3c1f6565-c9e4-53b3-bf2f-682503382e07" :question/math-academy-id "q-30977" :question/problem "Evaluate the integral $$\n\\displaystyle \\int_{0}^{1}x2^{3x^{2}}dx.\n$$"} {:db/id #edb/ref 17592186297313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "819b16a3-f7a6-565b-b3ef-3936ba7715f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186295964} {:answer/id #uuid "887f9f69-8383-56d4-b68c-b8cfc625db4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186296002} {:answer/id #uuid "ccfd95ae-9589-58f8-99d6-dc27d8a4b715" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186296340} {:answer/id #uuid "d14bc0b9-fea2-545e-9860-0eceaf4fb7d1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296368} {:answer/id #uuid "f5ac6476-516e-5949-a1aa-b0dc8472989d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186296571}] :answer-field/correct {:answer/id #uuid "887f9f69-8383-56d4-b68c-b8cfc625db4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186296002} :answer-field/id #uuid "87845b5e-5ef2-542f-81a3-6d45bf09aa5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296913}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d27a3338-cb0f-5ca8-99dd-ea66c994efb5" :question/math-academy-id "q-30953" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=2{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡5}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2\\operatorname{ln}⁡5$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}{e}^{2{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{20}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{20}{e}^{u}\\,{|}_{0}^{2\\operatorname{ln}⁡5} \\\\  & =\\frac{1}{20}({e}^{2\\operatorname{ln}⁡5}-{e}^{0}) \\\\  & =\\frac{1}{20}(25-1) \\\\  & =\\frac{24}{20} \\\\  & =\\frac{6}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ccece4-65c4-5e5c-8817-3a18dce11af4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186295310} {:answer/id #uuid "84942b44-5495-5682-952a-911af4e4422c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡2}{3}" :db/id #edb/ref 17592186295978} {:answer/id #uuid "bfed6b15-aecc-5150-b7ae-098abfc895f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡2}{4}" :db/id #edb/ref 17592186296281} {:answer/id #uuid "c1be6811-0f82-5ed6-a4cb-46cd3b3d2590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296291} {:answer/id #uuid "cebdb2d9-074e-514a-9533-ddadbb7aad7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296351}] :answer-field/correct {:answer/id #uuid "c1be6811-0f82-5ed6-a4cb-46cd3b3d2590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296291} :answer-field/id #uuid "f8639f62-79b8-5cc0-8a72-d453dd46c5a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7481f370-fa2c-5189-a8ea-31c09e902fb8" :question/math-academy-id "q-30978" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{4}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}{4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}\\,{|}_{0}^{1} \\\\  & =\\frac{1}{2\\operatorname{ln}⁡4}(4-1) \\\\  & =\\frac{3}{2\\operatorname{ln}⁡4} \\\\  & =\\frac{3}{4\\operatorname{ln}⁡2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd2ee4a-9bd2-5dd9-bf3f-33b0c730a0e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186317699}] :answer-field/correct {:answer/id #uuid "2bd2ee4a-9bd2-5dd9-bf3f-33b0c730a0e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186317699} :answer-field/id #uuid "4ab28277-8243-5753-94c4-46d003e744e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318588}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03065e0a-3e2d-519b-9716-a27401bbed9d" :question/math-academy-id "q-346400" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{0}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{1}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(3-1) \\\\  & =\\frac{2}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a45e9d32-be80-51d7-b4d0-0082a4e9941a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186319882}] :answer-field/correct {:answer/id #uuid "a45e9d32-be80-51d7-b4d0-0082a4e9941a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186319882} :answer-field/id #uuid "e8bd78c3-38e4-5e76-9e6e-43ae4383b2eb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320645}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5669eaaa-dc6f-518c-94e2-a518478a7aa8" :question/math-academy-id "q-350740" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}+\\operatorname{ln}⁡2.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡2}$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡2$ | $4\\operatorname{ln}⁡2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}{e}^{u}\\,{|}_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2} \\\\  & =\\frac{1}{6}({e}^{4\\operatorname{ln}⁡2}-{e}^{\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{6}(16-2) \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f28b6429-4e66-5c8e-bb3f-5daf1daa32a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186320115}] :answer-field/correct {:answer/id #uuid "f28b6429-4e66-5c8e-bb3f-5daf1daa32a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186320115} :answer-field/id #uuid "174ca392-0304-5d05-b095-f15caadd5198" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320215}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5411d5fe-3637-5792-875a-d180b054e392" :question/math-academy-id "q-350743" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=2x+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x & ={\\int }_{1}^{3}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{1}^{3} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{3}-{3}^{1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(27-3) \\\\  & =\\frac{24}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bae22f-c29c-57f9-8e20-c50243b1f0f5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}\\left(\\frac{16}{7}\\right)" :db/id #edb/ref 17592186319463}] :answer-field/correct {:answer/id #uuid "18bae22f-c29c-57f9-8e20-c50243b1f0f5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}\\left(\\frac{16}{7}\\right)" :db/id #edb/ref 17592186319463} :answer-field/id #uuid "2ea49404-1273-5753-90c5-6d44c92c292b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320273}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "951fb591-2a64-51d6-a9bd-1ec21eaafe23" :question/math-academy-id "q-350751" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{e}^{x}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{x}\\,⟹\\,\\text{d}u=3{e}^{x}\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $\\operatorname{ln}⁡2$ | $\\operatorname{ln}⁡5$ |\n| --- | --- | --- |\n| $u$ | $7$ | $16$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{4}{3{e}^{x}+1}\\cdot 3{e}^{x}\\,\\text{d}x \\\\  & ={\\int }_{7}^{16}\\frac{4}{u}\\cdot \\,\\text{d}u \\\\  & =4{\\int }_{7}^{16}\\frac{1}{u}\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡|u|\\,{|}_{7}^{16} \\\\  & =4(\\operatorname{ln}⁡(16)-\\operatorname{ln}⁡(7)) \\\\  & =4\\operatorname{ln}⁡\\left(\\frac{16}{7}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186608214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a6451b-a04e-5424-95e0-ae56be129001" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26}{3}" :db/id #edb/ref 17592186607961} {:answer/id #uuid "94690ad0-d739-55f6-ac9d-9dc3576b64cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186607976} {:answer/id #uuid "9701597e-08b1-5e0d-a435-680d10de4650" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{6}" :db/id #edb/ref 17592186607983} {:answer/id #uuid "ae5ec5aa-483b-5010-8086-97f7bd646db3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186608009} {:answer/id #uuid "fd68ec79-2ca6-5501-9c03-063ed7a2a24d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{6}" :db/id #edb/ref 17592186608087}] :answer-field/correct {:answer/id #uuid "84a6451b-a04e-5424-95e0-ae56be129001" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26}{3}" :db/id #edb/ref 17592186607961} :answer-field/id #uuid "8829197f-1f69-56f1-a9e9-7d8daf594f9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608125}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "abccef89-be65-544a-a90d-e214a5be7183" :question/math-academy-id "q-30947" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}2x{e}^{3{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{3}\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $3\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}2x{e}^{3{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}{e}^{3{x}^{2}}\\cdot 2x\\,\\text{d}x \\\\  & ={\\int }_{0}^{3\\operatorname{ln}⁡3}{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{0}^{3\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}\\,{|}_{0}^{3\\operatorname{ln}⁡3} \\\\  & =\\frac{1}{3}({e}^{3\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{1}{3}({3}^{3}-1) \\\\  & =\\frac{1}{3}(27-1) \\\\  & =\\frac{26}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186627714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158f6da0-5a06-5168-856b-cc91f1475541" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186627133} {:answer/id #uuid "29056c93-7a46-5bad-b7ed-f96eb4d222b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186627164} {:answer/id #uuid "5782f199-9bda-541c-aa3b-3cfd908c9071" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186627241} {:answer/id #uuid "5a9dc582-8e68-50bd-9671-e81de6c58436" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186627248} {:answer/id #uuid "bd3c3c7c-ee8f-5fd8-9f4a-dad2af3ea9f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186627403}] :answer-field/correct {:answer/id #uuid "29056c93-7a46-5bad-b7ed-f96eb4d222b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186627164} :answer-field/id #uuid "3c7d1fbe-e3cb-5274-a242-c947f78275d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186627568}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a5f7af17-ee7d-5acb-82dd-5d6d5422661e" :question/math-academy-id "q-30954" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡8}}x{e}^{{x}^{2}/3}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=\\frac{{x}^{2}}{3}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{3}x\\,⟹\\,\\frac{3}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡8}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\operatorname{ln}⁡8}{3}$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡8}}x{e}^{{x}^{2}/3}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡8}}{e}^{{x}^{2}/3}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{(\\operatorname{ln}⁡8)/3}{e}^{u}\\cdot \\frac{3}{2}\\,\\text{d}u \\\\  & =\\frac{3}{2}{\\int }_{0}^{(\\operatorname{ln}⁡8)/3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{3}{2}{e}^{u}\\,{|}_{0}^{(\\operatorname{ln}⁡8)/3} \\\\  & =\\frac{3}{2}({e}^{(\\operatorname{ln}⁡8)/3}-{e}^{0}) \\\\  & =\\frac{3}{2}(\\sqrt[3]{8}-1) \\\\  & =\\frac{3}{2}(2-1) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186679532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e710d08-5bd0-5455-8321-ac9cf801861d" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)" :db/id #edb/ref 17592186679576}] :answer-field/correct {:answer/id #uuid "6e710d08-5bd0-5455-8321-ac9cf801861d" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)" :db/id #edb/ref 17592186679576} :answer-field/id #uuid "d0ebddaa-9572-5fd7-a266-26fe46eb85cb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679607}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1091cf45-3b7c-52f0-96e3-7f79a1caef3d" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=2 e^{x} + 3$. Then $\\mathrm{d}u=(2 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=7\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=9\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{7}^{9} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{7}^{9}\\right)=3\\left(\\left(\\ln{\\left(9 \\right)}\\right)-\\left(\\ln{\\left(7 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right).\n$$"} {:db/id #edb/ref 17592186679534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d2cc3bd-449b-51d2-9b3f-7058a9173358" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{72}{\\ln{\\left(3 \\right)}}" :db/id #edb/ref 17592186679537}] :answer-field/correct {:answer/id #uuid "1d2cc3bd-449b-51d2-9b3f-7058a9173358" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{72}{\\ln{\\left(3 \\right)}}" :db/id #edb/ref 17592186679537} :answer-field/id #uuid "d9f78162-d59e-5a3c-b279-66ccfe2509f4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679610}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1493bcad-9473-5e45-a62f-7de7e087075a" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\int_{2}^{4} 3^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{2}^{4}=\\left(\\frac{81}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{72}{\\ln{\\left(3 \\right)}}.\n$$"} {:db/id #edb/ref 17592186679539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679583}] :answer-field/correct {:answer/id #uuid "8d6b862e-a4e3-5270-a1e2-ff5cd4b02f04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679583} :answer-field/id #uuid "f976d41f-e7d5-5275-80bf-872c50e89f5d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679624}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "20519125-738d-55d8-b32b-ce8805e91f82" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2^{2 x + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=2 x + 2$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2^{2 x + 2}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{2}^{4} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{2}^{4}\\right)=\\frac{1}{2}\\left(\\left(\\frac{16}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{4}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{6}{\\ln{\\left(2 \\right)}}.\n$$"} {:db/id #edb/ref 17592186679550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f29c0bd-afd6-595d-a791-b40ce5f73018" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\ln\\left(12\\right)-\\ln\\left(9\\right)\\right)" :db/id #edb/ref 17592186679568}] :answer-field/correct {:answer/id #uuid "5f29c0bd-afd6-595d-a791-b40ce5f73018" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\ln\\left(12\\right)-\\ln\\left(9\\right)\\right)" :db/id #edb/ref 17592186679568} :answer-field/id #uuid "fdf15f47-a624-5c2f-9d2d-c2a653d8bcbe" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679628}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a151c81-c4e9-5302-89d7-30f533727337" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{9 e^{x}}{3 e^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=3 e^{x} + 3$. Then $\\mathrm{d}u=(3 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=9\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=12\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{9 e^{x}}{3 e^{x} + 3}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{9}^{12} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{9}^{12}\\right)=3\\left(\\left(\\ln{\\left(12 \\right)}\\right)-\\left(\\ln{\\left(9 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(12\\right)-\\ln\\left(9\\right)\\right).\n$$"} {:db/id #edb/ref 17592186679551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b908837-766f-5bfd-b27c-083bbab38bd6" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\ln\\left(5\\right)-\\ln\\left(4\\right)\\right)" :db/id #edb/ref 17592186679574}] :answer-field/correct {:answer/id #uuid "6b908837-766f-5bfd-b27c-083bbab38bd6" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\ln\\left(5\\right)-\\ln\\left(4\\right)\\right)" :db/id #edb/ref 17592186679574} :answer-field/id #uuid "239ff20c-752b-51a5-82e6-f986bc7883a3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679542}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a37439d-e797-5de6-ae99-2c1a68201323" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{3 e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=e^{x} + 2$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=4\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=5\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{3 e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{4}^{5} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{4}^{5}\\right)=3\\left(\\left(\\ln{\\left(5 \\right)}\\right)-\\left(\\ln{\\left(4 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(5\\right)-\\ln\\left(4\\right)\\right).\n$$"} {:db/id #edb/ref 17592186679554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66d5bff0-8694-5744-baa6-4a14ba1d6d8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\ln{\\left(3 \\right)}}" :db/id #edb/ref 17592186679572}] :answer-field/correct {:answer/id #uuid "66d5bff0-8694-5744-baa6-4a14ba1d6d8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\ln{\\left(3 \\right)}}" :db/id #edb/ref 17592186679572} :answer-field/id #uuid "49953bb8-af90-58f8-969d-7e0b1dfe201b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679558}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3f17baf9-fc2a-53b6-a35f-0b08e79be71d" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int_{2}^{4} 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{1}{4}\\left(\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{2}^{4}\\right)=\\frac{1}{4}\\left(\\left(\\frac{81}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{18}{\\ln{\\left(3 \\right)}}.\n$$"} {:db/id #edb/ref 17592186679557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20cacbd5-8945-583e-8192-cf2d065bcf18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679541} {:answer/id #uuid "36693298-24d1-5942-b04c-e7dece135391" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679548} {:answer/id #uuid "996ef1ea-508b-5cbc-a563-f119a4a5ff24" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u" :db/id #edb/ref 17592186679588} {:answer/id #uuid "9ad36c5c-70f5-534c-9642-deb259eebfa0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679590} {:answer/id #uuid "ee429d8e-d3da-5a8c-acea-e2ca7da3b753" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679619}] :answer-field/correct {:answer/id #uuid "20cacbd5-8945-583e-8192-cf2d065bcf18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679541} :answer-field/id #uuid "ee65aef4-0270-5704-bdc9-d3954e42566b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679620}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4254b7a3-8fbb-5397-b0d4-3e0f4d758d5d" :question/problem "Use the substitution $u=x^{2} + 1$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} x e^{x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=x^{2} + 1$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=\\sqrt{\\ln{\\left(2 \\right)}}&\\Longrightarrow u=\\ln{\\left(2 \\right)} + 1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} x e^{x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186679563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e805574d-111d-5acb-9f10-2e8e06520b7e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)" :db/id #edb/ref 17592186679617}] :answer-field/correct {:answer/id #uuid "e805574d-111d-5acb-9f10-2e8e06520b7e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)" :db/id #edb/ref 17592186679617} :answer-field/id #uuid "35043f02-4cbe-5b04-a1e0-7b7a8bf66f1f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679547}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4f6d06be-9e6e-5976-ac37-0dfb6633c901" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{4 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=2 e^{x} + 3$. Then $\\mathrm{d}u=(2 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=7\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=9\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{4 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{7}^{9} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\ln\\left|u\\right|\\right]_{7}^{9}\\right)=2\\left(\\left(\\ln{\\left(9 \\right)}\\right)-\\left(\\ln{\\left(7 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n2\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right).\n$$"} {:db/id #edb/ref 17592186679567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a764233-b2f3-5e90-b360-28f68e4e845e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\ln\\left(4\\right)-\\ln\\left(3\\right)\\right)" :db/id #edb/ref 17592186679565}] :answer-field/correct {:answer/id #uuid "5a764233-b2f3-5e90-b360-28f68e4e845e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\ln\\left(4\\right)-\\ln\\left(3\\right)\\right)" :db/id #edb/ref 17592186679565} :answer-field/id #uuid "423d8c4d-d609-5dd5-aa88-7aeb5927d885" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679556}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5ed82884-6c8c-5ce4-b237-91d8e5608eef" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=e^{x} + 1$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=3\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{4 e^{x}}{e^{x} + 1}\\,\\mathrm{d}x\\\\&=4\\left(\\int_{3}^{4} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n4\\left(\\left[\\ln\\left|u\\right|\\right]_{3}^{4}\\right)=4\\left(\\left(\\ln{\\left(4 \\right)}\\right)-\\left(\\ln{\\left(3 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n4\\left(\\ln\\left(4\\right)-\\ln\\left(3\\right)\\right).\n$$"} {:db/id #edb