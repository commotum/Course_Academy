|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=3 e^{x} + 2$. Then $\\mathrm{d}u=(3 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=8\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=11\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{9 e^{x}}{3 e^{x} + 2}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{8}^{11} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{8}^{11}\\right)=3\\left(\\left(\\ln{\\left(11 \\right)}\\right)-\\left(\\ln{\\left(8 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(11\\right)-\\ln\\left(8\\right)\\right).\n$$"} {:db/id #edb/ref 17592186679604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc2e004d-8080-52a5-b013-fa11bc1abf70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679611}] :answer-field/correct {:answer/id #uuid "dc2e004d-8080-52a5-b013-fa11bc1abf70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679611} :answer-field/id #uuid "be02bd4a-0fb8-5c53-b6bd-9807b05d127c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679599}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c76d7b6c-51f9-5398-95b8-ed5e30775bc6" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 2^{x^{2}} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=x^{2}$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=1&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 2^{x^{2}} x\\,\\mathrm{d}x\\\\&=2\\left(\\int_{0}^{1} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{0}^{1}\\right)=2\\left(\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{1}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2}{\\ln{\\left(2 \\right)}}.\n$$"} {:db/id #edb/ref 17592186679605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8cfb12c-f07f-5a9e-94e2-928dbd81d370" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679618}] :answer-field/correct {:answer/id #uuid "e8cfb12c-f07f-5a9e-94e2-928dbd81d370" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679618} :answer-field/id #uuid "620c9bdc-8093-5f25-9500-d270d9cda170" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679569}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c915b145-2c27-5f81-8c56-1312ac8cac36" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2 \\cdot 2^{2 x^{2} + 1} x\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=2 x^{2} + 1$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=3\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2 \\cdot 2^{2 x^{2} + 1} x\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{1}^{3} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{1}^{3}\\right)=\\frac{1}{2}\\left(\\left(\\frac{8}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}.\n$$"} {:db/id #edb/ref 17592186679606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7fe7a5-27b9-562d-8405-612baecc779a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\left(\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679531} {:answer/id #uuid "3f30ae78-7958-56b5-8269-99571ff177bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u" :db/id #edb/ref 17592186679555} {:answer/id #uuid "4eff4b0d-bc17-5ff7-a57f-9bf8f1ba22be" :answer/type {:db/ident :answer.type/math} :answer/value "6\\left(\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679561} {:answer/id #uuid "7a942d42-f286-5365-8191-58ec155c08a2" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679580} {:answer/id #uuid "acf50591-a0c3-5342-b6a5-d93fb7909e0a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679595}] :answer-field/correct {:answer/id #uuid "acf50591-a0c3-5342-b6a5-d93fb7909e0a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679595} :answer-field/id #uuid "de6d7507-7b4b-57ef-95b5-7ef96cc8d94f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679613}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cbb1ce86-4054-5654-9040-b3e8073157c6" :question/problem "Use the substitution $u=x^{2}$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} 4 x e^{x^{2}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=x^{2}$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\sqrt{\\ln{\\left(2 \\right)}}&\\Longrightarrow u=\\ln{\\left(2 \\right)}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} 4 x e^{x^{2}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n2\\left(\\int_{0}^{\\ln{\\left(2 \\right)}} e^{u}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186679621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e7abd27-c793-5130-9281-c0e31e3590bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(5\\right)-\\ln\\left(4\\right)" :db/id #edb/ref 17592186679560}] :answer-field/correct {:answer/id #uuid "4e7abd27-c793-5130-9281-c0e31e3590bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(5\\right)-\\ln\\left(4\\right)" :db/id #edb/ref 17592186679560} :answer-field/id #uuid "a76d7558-16bc-538f-bbb9-c370677b70cf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679594}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f311eb5f-107f-5276-825f-873dacb83ed0" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=e^{x} + 2$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=4\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=5\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\\\\&=\\int_{4}^{5} \\frac{1}{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\left[\\ln\\left|u\\right|\\right]_{4}^{5}=\\left(\\ln{\\left(5 \\right)}\\right)-\\left(\\ln{\\left(4 \\right)}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\ln\\left(5\\right)-\\ln\\left(4\\right).\n$$"} {:db/id #edb/ref 17592186679623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14821592-dcfc-5bda-b697-e8c065e996ce" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}\\left(\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679533} {:answer/id #uuid "3b294e75-d590-5756-bf3d-1917af5537f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679552} {:answer/id #uuid "83fa61f7-f59b-58d0-b70c-040bd7a434dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679582} {:answer/id #uuid "8e50e073-4439-5954-8601-35f71817d36c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679584} {:answer/id #uuid "dde3e1f4-3028-56ef-bcbc-1ca403bd42ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u" :db/id #edb/ref 17592186679612}] :answer-field/correct {:answer/id #uuid "3b294e75-d590-5756-bf3d-1917af5537f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679552} :answer-field/id #uuid "25d02d4e-f000-50c2-bb1d-8bbd055737ee" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679545}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f63df859-feae-5a0d-b265-058c2043e45e" :question/problem "Use the substitution $u=2 x^{2} + 1$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} 2 x e^{2 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=2 x^{2} + 1$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=\\sqrt{\\ln{\\left(2 \\right)}}&\\Longrightarrow u=1 + \\ln{\\left(4 \\right)}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} 2 x e^{2 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{2}\\left(\\int_{1}^{1 + \\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186679625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07c83705-0d24-567d-94ec-8364b10213c2" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}\\left(\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679529} {:answer/id #uuid "81440b68-80c1-509e-a962-c5d1804cbb07" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u" :db/id #edb/ref 17592186679581} {:answer/id #uuid "958cd4ec-d43c-5b72-bb9b-baccda93a090" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679586} {:answer/id #uuid "a45f2b55-d7a1-51a2-affe-f0a4037d6085" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679593} {:answer/id #uuid "f6262f90-037e-59c7-a8e7-bbda7fb45016" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679622}] :answer-field/correct {:answer/id #uuid "f6262f90-037e-59c7-a8e7-bbda7fb45016" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679622} :answer-field/id #uuid "3c455d4a-5ebf-5800-a325-9753b611a643" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679553}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fbd7dfd6-7437-5cf9-9b6c-18ca9b11760a" :question/problem "Use the substitution $u=2 x$. Which integral is obtained?\n\n$$\n\\int_{0}^{\\ln{\\left(2 \\right)}} e^{2 x}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=\\ln{\\left(4 \\right)}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\ln{\\left(2 \\right)}} e^{2 x}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{2}\\left(\\int_{0}^{\\ln{\\left(4 \\right)}} e^{u}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186679627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a46496-5ff9-51ee-9ccd-43838a42ba6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679535}] :answer-field/correct {:answer/id #uuid "14a46496-5ff9-51ee-9ccd-43838a42ba6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}" :db/id #edb/ref 17592186679535} :answer-field/id #uuid "9d5573ee-eb16-563d-899a-ac5f0a12eab4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186679591}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fc2e3839-7680-53ae-9065-634be947461c" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2^{x + 1}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=x + 1$. Then $\\mathrm{d}u=(1)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2^{x + 1}\\,\\mathrm{d}x\\\\&=\\int_{1}^{2} 2^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nApply the supplied primitive and subtract lower from upper:\n\n$$\n\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{1}^{2}=\\left(\\frac{4}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2}{\\ln{\\left(2 \\right)}}.\n$$"} {:db/id #edb/ref 17592186679630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2504bbab-4a2f-5c57-b9ea-838ddb3c27b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\int_{2}^{\\ln{\\left(2 \\right)} + 2} e^{u}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186679544} {:answer/id #uuid "554be830-f