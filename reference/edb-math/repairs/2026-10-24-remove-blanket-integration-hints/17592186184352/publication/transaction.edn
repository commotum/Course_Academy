[[:db/add "33815bee-7119-5572-94c9-72f36586f2e9" :answer/id #uuid "33815bee-7119-5572-94c9-72f36586f2e9"] [:db/add "33815bee-7119-5572-94c9-72f36586f2e9" :answer/type :answer.type/math] [:db/add "33815bee-7119-5572-94c9-72f36586f2e9" :answer/value "\\frac{72}{\\ln{\\left(3 \\right)}}"] [:db/ensure "33815bee-7119-5572-94c9-72f36586f2e9" :answer/validate] [:db/add "119f5306-f073-5d16-91d6-d7cdf25e2a75" :answer-field/id #uuid "119f5306-f073-5d16-91d6-d7cdf25e2a75"] [:db/add "119f5306-f073-5d16-91d6-d7cdf25e2a75" :answer-field/key "answer"] [:db/add "119f5306-f073-5d16-91d6-d7cdf25e2a75" :answer-field/type :answer-field.type/blank] [:db/add "119f5306-f073-5d16-91d6-d7cdf25e2a75" :answer-field/choices "33815bee-7119-5572-94c9-72f36586f2e9"] [:db/add "119f5306-f073-5d16-91d6-d7cdf25e2a75" :answer-field/correct "33815bee-7119-5572-94c9-72f36586f2e9"] [:db/ensure "119f5306-f073-5d16-91d6-d7cdf25e2a75" :answer-field/validate] [:db/add "012021b3-4d85-5cb3-8311-8b799e8be032" :question/id #uuid "012021b3-4d85-5cb3-8311-8b799e8be032"] [:db/add "012021b3-4d85-5cb3-8311-8b799e8be032" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "012021b3-4d85-5cb3-8311-8b799e8be032" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\int_{2}^{4} 3^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{2}^{4}=\\left(\\frac{81}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{72}{\\ln{\\left(3 \\right)}}.\n$$"] [:db/add "012021b3-4d85-5cb3-8311-8b799e8be032" :question/difficulty :question.difficulty/moderate] [:db/add "012021b3-4d85-5cb3-8311-8b799e8be032" :question/answer-fields "119f5306-f073-5d16-91d6-d7cdf25e2a75"] [:db/ensure "012021b3-4d85-5cb3-8311-8b799e8be032" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "012021b3-4d85-5cb3-8311-8b799e8be032"] [:db/add "2f77e899-5bf3-5606-be9d-9e74679a05f9" :answer/id #uuid "2f77e899-5bf3-5606-be9d-9e74679a05f9"] [:db/add "2f77e899-5bf3-5606-be9d-9e74679a05f9" :answer/type :answer.type/math] [:db/add "2f77e899-5bf3-5606-be9d-9e74679a05f9" :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}"] [:db/ensure "2f77e899-5bf3-5606-be9d-9e74679a05f9" :answer/validate] [:db/add "9d0908c6-1508-50e9-9268-c0821dfd898f" :answer-field/id #uuid "9d0908c6-1508-50e9-9268-c0821dfd898f"] [:db/add "9d0908c6-1508-50e9-9268-c0821dfd898f" :answer-field/key "answer"] [:db/add "9d0908c6-1508-50e9-9268-c0821dfd898f" :answer-field/type :answer-field.type/blank] [:db/add "9d0908c6-1508-50e9-9268-c0821dfd898f" :answer-field/choices "2f77e899-5bf3-5606-be9d-9e74679a05f9"] [:db/add "9d0908c6-1508-50e9-9268-c0821dfd898f" :answer-field/correct "2f77e899-5bf3-5606-be9d-9e74679a05f9"] [:db/ensure "9d0908c6-1508-50e9-9268-c0821dfd898f" :answer-field/validate] [:db/add "1100c904-712f-5524-964a-421be8478f15" :question/id #uuid "1100c904-712f-5524-964a-421be8478f15"] [:db/add "1100c904-712f-5524-964a-421be8478f15" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2^{x + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "1100c904-712f-5524-964a-421be8478f15" :question/worked-solution "Let $u=x + 1$. Then $\\mathrm{d}u=(1)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2^{x + 1}\\,\\mathrm{d}x\\\\&=\\int_{1}^{2} 2^{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{1}^{2}=\\left(\\frac{4}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "1100c904-712f-5524-964a-421be8478f15" :question/difficulty :question.difficulty/moderate] [:db/add "1100c904-712f-5524-964a-421be8478f15" :question/answer-fields "9d0908c6-1508-50e9-9268-c0821dfd898f"] [:db/ensure "1100c904-712f-5524-964a-421be8478f15" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "1100c904-712f-5524-964a-421be8478f15"] [:db/add "8edcdcf5-ee8a-538c-96af-d2101e4899ef" :answer/id #uuid "8edcdcf5-ee8a-538c-96af-d2101e4899ef"] [:db/add "8edcdcf5-ee8a-538c-96af-d2101e4899ef" :answer/type :answer.type/math] [:db/add "8edcdcf5-ee8a-538c-96af-d2101e4899ef" :answer/value "\\frac{3}{\\ln{\\left(2 \\right)}}"] [:db/ensure "8edcdcf5-ee8a-538c-96af-d2101e4899ef" :answer/validate] [:db/add "b2e12dce-8af3-5074-96bb-3236a1bf09ab" :answer-field/id #uuid "b2e12dce-8af3-5074-96bb-3236a1bf09ab"] [:db/add "b2e12dce-8af3-5074-96bb-3236a1bf09ab" :answer-field/key "answer"] [:db/add "b2e12dce-8af3-5074-96bb-3236a1bf09ab" :answer-field/type :answer-field.type/blank] [:db/add "b2e12dce-8af3-5074-96bb-3236a1bf09ab" :answer-field/choices "8edcdcf5-ee8a-538c-96af-d2101e4899ef"] [:db/add "b2e12dce-8af3-5074-96bb-3236a1bf09ab" :answer-field/correct "8edcdcf5-ee8a-538c-96af-d2101e4899ef"] [:db/ensure "b2e12dce-8af3-5074-96bb-3236a1bf09ab" :answer-field/validate] [:db/add "16af13da-5b4a-5b74-9587-06e182b98c33" :question/id #uuid "16af13da-5b4a-5b74-9587-06e182b98c33"] [:db/add "16af13da-5b4a-5b74-9587-06e182b98c33" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2 \\cdot 2^{2 x^{2} + 1} x\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "16af13da-5b4a-5b74-9587-06e182b98c33" :question/worked-solution "Let $u=2 x^{2} + 1$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=3\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2 \\cdot 2^{2 x^{2} + 1} x\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{1}^{3} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{1}^{3}\\right)=\\frac{1}{2}\\left(\\left(\\frac{8}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "16af13da-5b4a-5b74-9587-06e182b98c33" :question/difficulty :question.difficulty/moderate] [:db/add "16af13da-5b4a-5b74-9587-06e182b98c33" :question/answer-fields "b2e12dce-8af3-5074-96bb-3236a1bf09ab"] [:db/ensure "16af13da-5b4a-5b74-9587-06e182b98c33" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "16af13da-5b4a-5b74-9587-06e182b98c33"] [:db/add "33ffd842-c0f4-5dd4-ae37-55555a0a18c8" :answer/id #uuid "33ffd842-c0f4-5dd4-ae37-55555a0a18c8"] [:db/add "33ffd842-c0f4-5dd4-ae37-55555a0a18c8" :answer/type :answer.type/math] [:db/add "33ffd842-c0f4-5dd4-ae37-55555a0a18c8" :answer/value "\\frac{6}{\\ln{\\left(2 \\right)}}"] [:db/ensure "33ffd842-c0f4-5dd4-ae37-55555a0a18c8" :answer/validate] [:db/add "03fb0ade-496a-5432-8405-4871628eba76" :answer-field/id #uuid "03fb0ade-496a-5432-8405-4871628eba76"] [:db/add "03fb0ade-496a-5432-8405-4871628eba76" :answer-field/key "answer"] [:db/add "03fb0ade-496a-5432-8405-4871628eba76" :answer-field/type :answer-field.type/blank] [:db/add "03fb0ade-496a-5432-8405-4871628eba76" :answer-field/choices "33ffd842-c0f4-5dd4-ae37-55555a0a18c8"] [:db/add "03fb0ade-496a-5432-8405-4871628eba76" :answer-field/correct "33ffd842-c0f4-5dd4-ae37-55555a0a18c8"] [:db/ensure "03fb0ade-496a-5432-8405-4871628eba76" :answer-field/validate] [:db/add "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83" :question/id #uuid "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83"] [:db/add "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2^{2 x + 2}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83" :question/worked-solution "Let $u=2 x + 2$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2^{2 x + 2}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{2}^{4} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{2}^{4}\\right)=\\frac{1}{2}\\left(\\left(\\frac{16}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{4}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{6}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83" :question/difficulty :question.difficulty/moderate] [:db/add "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83" :question/answer-fields "03fb0ade-496a-5432-8405-4871628eba76"] [:db/ensure "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "19de1ca2-28f1-5ffe-a86a-3f6bc8444a83"] [:db/add "d3a8f371-e5ae-5720-b7bb-d3e191025cfd" :answer/id #uuid "d3a8f371-e5ae-5720-b7bb-d3e191025cfd"] [:db/add "d3a8f371-e5ae-5720-b7bb-d3e191025cfd" :answer/type :answer.type/math] [:db/add "d3a8f371-e5ae-5720-b7bb-d3e191025cfd" :answer/value "\\frac{18}{\\ln{\\left(3 \\right)}}"] [:db/ensure "d3a8f371-e5ae-5720-b7bb-d3e191025cfd" :answer/validate] [:db/add "05f3173b-ff5e-514c-8652-b030ac2dcf48" :answer-field/id #uuid "05f3173b-ff5e-514c-8652-b030ac2dcf48"] [:db/add "05f3173b-ff5e-514c-8652-b030ac2dcf48" :answer-field/key "answer"] [:db/add "05f3173b-ff5e-514c-8652-b030ac2dcf48" :answer-field/type :answer-field.type/blank] [:db/add "05f3173b-ff5e-514c-8652-b030ac2dcf48" :answer-field/choices "d3a8f371-e5ae-5720-b7bb-d3e191025cfd"] [:db/add "05f3173b-ff5e-514c-8652-b030ac2dcf48" :answer-field/correct "d3a8f371-e5ae-5720-b7bb-d3e191025cfd"] [:db/ensure "05f3173b-ff5e-514c-8652-b030ac2dcf48" :answer-field/validate] [:db/add "0cb8ac52-0d5a-5929-9f99-bdc30485bce9" :question/id #uuid "0cb8ac52-0d5a-5929-9f99-bdc30485bce9"] [:db/add "0cb8ac52-0d5a-5929-9f99-bdc30485bce9" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "0cb8ac52-0d5a-5929-9f99-bdc30485bce9" :question/worked-solution "Let $u=2 x^{2} + 2$. Then $\\mathrm{d}u=(4 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=2\\\\x=1&\\Longrightarrow u=4\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 3^{2 x^{2} + 2} x\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int_{2}^{4} 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{4}\\left(\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{2}^{4}\\right)=\\frac{1}{4}\\left(\\left(\\frac{81}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{18}{\\ln{\\left(3 \\right)}}.\n$$"] [:db/add "0cb8ac52-0d5a-5929-9f99-bdc30485bce9" :question/difficulty :question.difficulty/moderate] [:db/add "0cb8ac52-0d5a-5929-9f99-bdc30485bce9" :question/answer-fields "05f3173b-ff5e-514c-8652-b030ac2dcf48"] [:db/ensure "0cb8ac52-0d5a-5929-9f99-bdc30485bce9" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "0cb8ac52-0d5a-5929-9f99-bdc30485bce9"] [:db/add "792ffb16-ba24-5a06-b1aa-8ab593242c8b" :answer/id #uuid "792ffb16-ba24-5a06-b1aa-8ab593242c8b"] [:db/add "792ffb16-ba24-5a06-b1aa-8ab593242c8b" :answer/type :answer.type/math] [:db/add "792ffb16-ba24-5a06-b1aa-8ab593242c8b" :answer/value "\\frac{12}{\\ln{\\left(3 \\right)}}"] [:db/ensure "792ffb16-ba24-5a06-b1aa-8ab593242c8b" :answer/validate] [:db/add "3a252eb3-0c64-56bf-be62-4af6527ff94c" :answer-field/id #uuid "3a252eb3-0c64-56bf-be62-4af6527ff94c"] [:db/add "3a252eb3-0c64-56bf-be62-4af6527ff94c" :answer-field/key "answer"] [:db/add "3a252eb3-0c64-56bf-be62-4af6527ff94c" :answer-field/type :answer-field.type/blank] [:db/add "3a252eb3-0c64-56bf-be62-4af6527ff94c" :answer-field/choices "792ffb16-ba24-5a06-b1aa-8ab593242c8b"] [:db/add "3a252eb3-0c64-56bf-be62-4af6527ff94c" :answer-field/correct "792ffb16-ba24-5a06-b1aa-8ab593242c8b"] [:db/ensure "3a252eb3-0c64-56bf-be62-4af6527ff94c" :answer-field/validate] [:db/add "767c4d7a-696c-54ad-bdc2-ba5430518877" :question/id #uuid "767c4d7a-696c-54ad-bdc2-ba5430518877"] [:db/add "767c4d7a-696c-54ad-bdc2-ba5430518877" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 2 \\cdot 3^{x + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "767c4d7a-696c-54ad-bdc2-ba5430518877" :question/worked-solution "Let $u=x + 1$. Then $\\mathrm{d}u=(1)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 2 \\cdot 3^{x + 1}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{1}^{2} 3^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 3^{u}\\,\\mathrm{d}u=\\frac{3^{u}}{\\ln{\\left(3 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\frac{3^{u}}{\\ln{\\left(3 \\right)}}\\right]_{1}^{2}\\right)=2\\left(\\left(\\frac{9}{\\ln{\\left(3 \\right)}}\\right)-\\left(\\frac{3}{\\ln{\\left(3 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{12}{\\ln{\\left(3 \\right)}}.\n$$"] [:db/add "767c4d7a-696c-54ad-bdc2-ba5430518877" :question/difficulty :question.difficulty/moderate] [:db/add "767c4d7a-696c-54ad-bdc2-ba5430518877" :question/answer-fields "3a252eb3-0c64-56bf-be62-4af6527ff94c"] [:db/ensure "767c4d7a-696c-54ad-bdc2-ba5430518877" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "767c4d7a-696c-54ad-bdc2-ba5430518877"] [:db/add "0fe06044-600f-535f-bed4-8ffc40f30073" :answer/id #uuid "0fe06044-600f-535f-bed4-8ffc40f30073"] [:db/add "0fe06044-600f-535f-bed4-8ffc40f30073" :answer/type :answer.type/math] [:db/add "0fe06044-600f-535f-bed4-8ffc40f30073" :answer/value "\\frac{2}{\\ln{\\left(2 \\right)}}"] [:db/ensure "0fe06044-600f-535f-bed4-8ffc40f30073" :answer/validate] [:db/add "c9c1f898-d92a-5cad-a8d1-08463d9e421e" :answer-field/id #uuid "c9c1f898-d92a-5cad-a8d1-08463d9e421e"] [:db/add "c9c1f898-d92a-5cad-a8d1-08463d9e421e" :answer-field/key "answer"] [:db/add "c9c1f898-d92a-5cad-a8d1-08463d9e421e" :answer-field/type :answer-field.type/blank] [:db/add "c9c1f898-d92a-5cad-a8d1-08463d9e421e" :answer-field/choices "0fe06044-600f-535f-bed4-8ffc40f30073"] [:db/add "c9c1f898-d92a-5cad-a8d1-08463d9e421e" :answer-field/correct "0fe06044-600f-535f-bed4-8ffc40f30073"] [:db/ensure "c9c1f898-d92a-5cad-a8d1-08463d9e421e" :answer-field/validate] [:db/add "e0fc7683-b8ed-592a-a25c-b785a2344d1a" :question/id #uuid "e0fc7683-b8ed-592a-a25c-b785a2344d1a"] [:db/add "e0fc7683-b8ed-592a-a25c-b785a2344d1a" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 2^{x^{2}} x\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "e0fc7683-b8ed-592a-a25c-b785a2344d1a" :question/worked-solution "Let $u=x^{2}$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=1&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 2^{x^{2}} x\\,\\mathrm{d}x\\\\&=2\\left(\\int_{0}^{1} 2^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 2^{u}\\,\\mathrm{d}u=\\frac{2^{u}}{\\ln{\\left(2 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right]_{0}^{1}\\right)=2\\left(\\left(\\frac{2}{\\ln{\\left(2 \\right)}}\\right)-\\left(\\frac{1}{\\ln{\\left(2 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2}{\\ln{\\left(2 \\right)}}.\n$$"] [:db/add "e0fc7683-b8ed-592a-a25c-b785a2344d1a" :question/difficulty :question.difficulty/moderate] [:db/add "e0fc7683-b8ed-592a-a25c-b785a2344d1a" :question/answer-fields "c9c1f898-d92a-5cad-a8d1-08463d9e421e"] [:db/ensure "e0fc7683-b8ed-592a-a25c-b785a2344d1a" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "e0fc7683-b8ed-592a-a25c-b785a2344d1a"] [:db/add "cd6eb6a6-6f3d-5d0a-bbc8-0443fb7f2afb" :answer/id #uuid "cd6eb6a6-6f3d-5d0a-bbc8-0443fb7f2afb"] [:db/add "cd6eb6a6-6f3d-5d0a-bbc8-0443fb7f2afb" :answer/type :answer.type/math] [:db/add "cd6eb6a6-6f3d-5d0a-bbc8-0443fb7f2afb" :answer/value "\\frac{80}{\\ln{\\left(5 \\right)}}"] [:db/ensure "cd6eb6a6-6f3d-5d0a-bbc8-0443fb7f2afb" :answer/validate] [:db/add "bb4a765f-4357-592d-a138-9c572d7d0f98" :answer-field/id #uuid "bb4a765f-4357-592d-a138-9c572d7d0f98"] [:db/add "bb4a765f-4357-592d-a138-9c572d7d0f98" :answer-field/key "answer"] [:db/add "bb4a765f-4357-592d-a138-9c572d7d0f98" :answer-field/type :answer-field.type/blank] [:db/add "bb4a765f-4357-592d-a138-9c572d7d0f98" :answer-field/choices "cd6eb6a6-6f3d-5d0a-bbc8-0443fb7f2afb"] [:db/add "bb4a765f-4357-592d-a138-9c572d7d0f98" :answer-field/correct "cd6eb6a6-6f3d-5d0a-bbc8-0443fb7f2afb"] [:db/ensure "bb4a765f-4357-592d-a138-9c572d7d0f98" :answer-field/validate] [:db/add "65b3a6c7-a7dc-5b8b-bf74-171639b45782" :question/id #uuid "65b3a6c7-a7dc-5b8b-bf74-171639b45782"] [:db/add "65b3a6c7-a7dc-5b8b-bf74-171639b45782" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} 4 \\cdot 5^{x + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "65b3a6c7-a7dc-5b8b-bf74-171639b45782" :question/worked-solution "Let $u=x + 1$. Then $\\mathrm{d}u=(1)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=1&\\Longrightarrow u=2\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} 4 \\cdot 5^{x + 1}\\,\\mathrm{d}x\\\\&=4\\left(\\int_{1}^{2} 5^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int 5^{u}\\,\\mathrm{d}u=\\frac{5^{u}}{\\ln{\\left(5 \\right)}}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n4\\left(\\left[\\frac{5^{u}}{\\ln{\\left(5 \\right)}}\\right]_{1}^{2}\\right)=4\\left(\\left(\\frac{25}{\\ln{\\left(5 \\right)}}\\right)-\\left(\\frac{5}{\\ln{\\left(5 \\right)}}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{80}{\\ln{\\left(5 \\right)}}.\n$$"] [:db/add "65b3a6c7-a7dc-5b8b-bf74-171639b45782" :question/difficulty :question.difficulty/moderate] [:db/add "65b3a6c7-a7dc-5b8b-bf74-171639b45782" :question/answer-fields "bb4a765f-4357-592d-a138-9c572d7d0f98"] [:db/ensure "65b3a6c7-a7dc-5b8b-bf74-171639b45782" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "65b3a6c7-a7dc-5b8b-bf74-171639b45782"] [:db/add "006a3367-4a5e-565b-976b-1c24160b07ab" :answer/id #uuid "006a3367-4a5e-565b-976b-1c24160b07ab"] [:db/add "006a3367-4a5e-565b-976b-1c24160b07ab" :answer/type :answer.type/math] [:db/add "006a3367-4a5e-565b-976b-1c24160b07ab" :answer/value "3\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)"] [:db/ensure "006a3367-4a5e-565b-976b-1c24160b07ab" :answer/validate] [:db/add "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71" :answer-field/id #uuid "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71"] [:db/add "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71" :answer-field/key "answer"] [:db/add "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71" :answer-field/type :answer-field.type/blank] [:db/add "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71" :answer-field/choices "006a3367-4a5e-565b-976b-1c24160b07ab"] [:db/add "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71" :answer-field/correct "006a3367-4a5e-565b-976b-1c24160b07ab"] [:db/ensure "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71" :answer-field/validate] [:db/add "5221acf4-978c-58d8-9697-827ffc8e9542" :question/id #uuid "5221acf4-978c-58d8-9697-827ffc8e9542"] [:db/add "5221acf4-978c-58d8-9697-827ffc8e9542" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "5221acf4-978c-58d8-9697-827ffc8e9542" :question/worked-solution "Let $u=2 e^{x} + 3$. Then $\\mathrm{d}u=(2 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=7\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=9\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{7}^{9} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{7}^{9}\\right)=3\\left(\\left(\\ln{\\left(9 \\right)}\\right)-\\left(\\ln{\\left(7 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right).\n$$"] [:db/add "5221acf4-978c-58d8-9697-827ffc8e9542" :question/difficulty :question.difficulty/hard] [:db/add "5221acf4-978c-58d8-9697-827ffc8e9542" :question/answer-fields "6ec0fd86-93c9-5a69-b4b1-b1e5b2211a71"] [:db/ensure "5221acf4-978c-58d8-9697-827ffc8e9542" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "5221acf4-978c-58d8-9697-827ffc8e9542"] [:db/add "09a01de8-9d9c-5eb5-9613-f7cc12bde92f" :answer/id #uuid "09a01de8-9d9c-5eb5-9613-f7cc12bde92f"] [:db/add "09a01de8-9d9c-5eb5-9613-f7cc12bde92f" :answer/type :answer.type/math] [:db/add "09a01de8-9d9c-5eb5-9613-f7cc12bde92f" :answer/value "3\\left(\\ln\\left(5\\right)-\\ln\\left(4\\right)\\right)"] [:db/ensure "09a01de8-9d9c-5eb5-9613-f7cc12bde92f" :answer/validate] [:db/add "bc043b8a-cadd-581c-9912-a629a4453c91" :answer-field/id #uuid "bc043b8a-cadd-581c-9912-a629a4453c91"] [:db/add "bc043b8a-cadd-581c-9912-a629a4453c91" :answer-field/key "answer"] [:db/add "bc043b8a-cadd-581c-9912-a629a4453c91" :answer-field/type :answer-field.type/blank] [:db/add "bc043b8a-cadd-581c-9912-a629a4453c91" :answer-field/choices "09a01de8-9d9c-5eb5-9613-f7cc12bde92f"] [:db/add "bc043b8a-cadd-581c-9912-a629a4453c91" :answer-field/correct "09a01de8-9d9c-5eb5-9613-f7cc12bde92f"] [:db/ensure "bc043b8a-cadd-581c-9912-a629a4453c91" :answer-field/validate] [:db/add "288c851f-3131-5632-91b4-c054d25eb62c" :question/id #uuid "288c851f-3131-5632-91b4-c054d25eb62c"] [:db/add "288c851f-3131-5632-91b4-c054d25eb62c" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{3 e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "288c851f-3131-5632-91b4-c054d25eb62c" :question/worked-solution "Let $u=e^{x} + 2$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=4\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=5\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{3 e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{4}^{5} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{4}^{5}\\right)=3\\left(\\left(\\ln{\\left(5 \\right)}\\right)-\\left(\\ln{\\left(4 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(5\\right)-\\ln\\left(4\\right)\\right).\n$$"] [:db/add "288c851f-3131-5632-91b4-c054d25eb62c" :question/difficulty :question.difficulty/hard] [:db/add "288c851f-3131-5632-91b4-c054d25eb62c" :question/answer-fields "bc043b8a-cadd-581c-9912-a629a4453c91"] [:db/ensure "288c851f-3131-5632-91b4-c054d25eb62c" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "288c851f-3131-5632-91b4-c054d25eb62c"] [:db/add "38a0538a-a783-56ea-a782-05afc488044a" :answer/id #uuid "38a0538a-a783-56ea-a782-05afc488044a"] [:db/add "38a0538a-a783-56ea-a782-05afc488044a" :answer/type :answer.type/math] [:db/add "38a0538a-a783-56ea-a782-05afc488044a" :answer/value "2\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right)"] [:db/ensure "38a0538a-a783-56ea-a782-05afc488044a" :answer/validate] [:db/add "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c" :answer-field/id #uuid "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c"] [:db/add "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c" :answer-field/key "answer"] [:db/add "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c" :answer-field/type :answer-field.type/blank] [:db/add "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c" :answer-field/choices "38a0538a-a783-56ea-a782-05afc488044a"] [:db/add "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c" :answer-field/correct "38a0538a-a783-56ea-a782-05afc488044a"] [:db/ensure "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c" :answer-field/validate] [:db/add "382cce4b-b933-5280-b62f-ef1960d96879" :question/id #uuid "382cce4b-b933-5280-b62f-ef1960d96879"] [:db/add "382cce4b-b933-5280-b62f-ef1960d96879" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{4 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "382cce4b-b933-5280-b62f-ef1960d96879" :question/worked-solution "Let $u=2 e^{x} + 3$. Then $\\mathrm{d}u=(2 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=7\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=9\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{4 e^{x}}{2 e^{x} + 3}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{7}^{9} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\ln\\left|u\\right|\\right]_{7}^{9}\\right)=2\\left(\\left(\\ln{\\left(9 \\right)}\\right)-\\left(\\ln{\\left(7 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n2\\left(\\ln\\left(9\\right)-\\ln\\left(7\\right)\\right).\n$$"] [:db/add "382cce4b-b933-5280-b62f-ef1960d96879" :question/difficulty :question.difficulty/hard] [:db/add "382cce4b-b933-5280-b62f-ef1960d96879" :question/answer-fields "bba61d35-fe85-5d7e-aa62-6fa7c35aba8c"] [:db/ensure "382cce4b-b933-5280-b62f-ef1960d96879" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "382cce4b-b933-5280-b62f-ef1960d96879"] [:db/add "d5b95728-bb26-5604-b40d-a33c75195305" :answer/id #uuid "d5b95728-bb26-5604-b40d-a33c75195305"] [:db/add "d5b95728-bb26-5604-b40d-a33c75195305" :answer/type :answer.type/math] [:db/add "d5b95728-bb26-5604-b40d-a33c75195305" :answer/value "3\\left(\\ln\\left(11\\right)-\\ln\\left(8\\right)\\right)"] [:db/