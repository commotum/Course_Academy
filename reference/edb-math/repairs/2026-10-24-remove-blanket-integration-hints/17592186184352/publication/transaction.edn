db/ensure "f9739542-a30b-50b4-aae8-1f04112ba9ce" :answer/validate] [:db/add "85a0a66a-723e-5fd3-8ec9-a705e74547eb" :answer-field/id #uuid "85a0a66a-723e-5fd3-8ec9-a705e74547eb"] [:db/add "85a0a66a-723e-5fd3-8ec9-a705e74547eb" :answer-field/key "answer"] [:db/add "85a0a66a-723e-5fd3-8ec9-a705e74547eb" :answer-field/type :answer-field.type/blank] [:db/add "85a0a66a-723e-5fd3-8ec9-a705e74547eb" :answer-field/choices "f9739542-a30b-50b4-aae8-1f04112ba9ce"] [:db/add "85a0a66a-723e-5fd3-8ec9-a705e74547eb" :answer-field/correct "f9739542-a30b-50b4-aae8-1f04112ba9ce"] [:db/ensure "85a0a66a-723e-5fd3-8ec9-a705e74547eb" :answer-field/validate] [:db/add "7581584f-3556-5295-9d05-15996a63e9cd" :question/id #uuid "7581584f-3556-5295-9d05-15996a63e9cd"] [:db/add "7581584f-3556-5295-9d05-15996a63e9cd" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "7581584f-3556-5295-9d05-15996a63e9cd" :question/worked-solution "Let $u=e^{x} + 2$. Then $\\mathrm{d}u=(e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=4\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=5\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{e^{x}}{e^{x} + 2}\\,\\mathrm{d}x\\\\&=\\int_{4}^{5} \\frac{1}{u}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\ln\\left|u\\right|\\right]_{4}^{5}=\\left(\\ln{\\left(5 \\right)}\\right)-\\left(\\ln{\\left(4 \\right)}\\right).\n$$\n\nThe exact answer is\n\n$$\n\\ln\\left(5\\right)-\\ln\\left(4\\right).\n$$"] [:db/add "7581584f-3556-5295-9d05-15996a63e9cd" :question/difficulty :question.difficulty/hard] [:db/add "7581584f-3556-5295-9d05-15996a63e9cd" :question/answer-fields "85a0a66a-723e-5fd3-8ec9-a705e74547eb"] [:db/ensure "7581584f-3556-5295-9d05-15996a63e9cd" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "7581584f-3556-5295-9d05-15996a63e9cd"] [:db/add "55a0eaaf-8470-5260-abcc-1bda98163d43" :answer/id #uuid "55a0eaaf-8470-5260-abcc-1bda98163d43"] [:db/add "55a0eaaf-8470-5260-abcc-1bda98163d43" :answer/type :answer.type/math] [:db/add "55a0eaaf-8470-5260-abcc-1bda98163d43" :answer/value "3\\left(\\ln\\left(7\\right)-\\ln\\left(5\\right)\\right)"] [:db/ensure "55a0eaaf-8470-5260-abcc-1bda98163d43" :answer/validate] [:db/add "10eb30fc-60c0-550a-9e0b-73315f651eaf" :answer-field/id #uuid "10eb30fc-60c0-550a-9e0b-73315f651eaf"] [:db/add "10eb30fc-60c0-550a-9e0b-73315f651eaf" :answer-field/key "answer"] [:db/add "10eb30fc-60c0-550a-9e0b-73315f651eaf" :answer-field/type :answer-field.type/blank] [:db/add "10eb30fc-60c0-550a-9e0b-73315f651eaf" :answer-field/choices "55a0eaaf-8470-5260-abcc-1bda98163d43"] [:db/add "10eb30fc-60c0-550a-9e0b-73315f651eaf" :answer-field/correct "55a0eaaf-8470-5260-abcc-1bda98163d43"] [:db/ensure "10eb30fc-60c0-550a-9e0b-73315f651eaf" :answer-field/validate] [:db/add "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503" :question/id #uuid "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503"] [:db/add "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 1}\\,\\mathrm{d}x\n$$\n\n{{answer}}"] [:db/add "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503" :question/worked-solution "Let $u=2 e^{x} + 1$. Then $\\mathrm{d}u=(2 e^{x})\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\ln{\\left(2 \\right)}&\\Longrightarrow u=5\\\\x=\\ln{\\left(3 \\right)}&\\Longrightarrow u=7\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\ln{\\left(2 \\right)}}^{\\ln{\\left(3 \\right)}} \\frac{6 e^{x}}{2 e^{x} + 1}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{5}^{7} \\frac{1}{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{\\ln 3}=3$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u}\\,\\mathrm{d}u=\\ln\\left|u\\right|+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\ln\\left|u\\right|\\right]_{5}^{7}\\right)=3\\left(\\left(\\ln{\\left(7 \\right)}\\right)-\\left(\\ln{\\left(5 \\right)}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n3\\left(\\ln\\left(7\\right)-\\ln\\left(5\\right)\\right).\n$$"] [:db/add "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503" :question/difficulty :question.difficulty/hard] [:db/add "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503" :question/answer-fields "10eb30fc-60c0-550a-9e0b-73315f651eaf"] [:db/ensure "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "b8e6f16f-4e6e-54e3-ad91-b58eab9d4503"] [:db/add "generator" :question-generator/id #uuid "e46c5417-b49e-57ce-bf7c-19853d4a1eee"] [:db/add "generator" :question-generator/script "generators/6b/6bc11b1a3332c1b05ea600b9481584d8b99c83e76058c06da235b6ae2c53b862/generator.py"] [:db/add 17592186184352 :knowledge-point/question-generator "generator"] [:db/ensure 17592186184352 :knowledge-point/validate] [:db/cas 17592186679532 :question/retired nil true] [:db/cas 17592186679534 :question/retired nil true] [:db/cas 17592186679539 :question/retired nil true] [:db/cas 17592186679550 :question/retired nil true] [:db/cas 17592186679551 :question/retired nil true] [:db/cas 17592186679554 :question/retired nil true] [:db/cas 17592186679563 :question/retired nil true] [:db/cas 17592186679567 :question/retired nil true] [:db/cas 17592186679570 :question/retired nil true] [:db/cas 17592186679585 :question/retired nil true] [:db/cas 17592186679587 :question/retired nil true] [:db/cas 17592186679601 :question/retired nil true] [:db/cas 17592186679604 :question/retired nil true] [:db/c