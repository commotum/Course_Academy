      {
        "tex": "\n\\int \\dfrac{1}{(x-1)\\sqrt{2x-x^2}} \\textrm{d}x  = \\int  \\dfrac{1}{(x-1)\\sqrt { 1-(x-1)^2 } }\t\\, \\textrm{d}x.\n",
