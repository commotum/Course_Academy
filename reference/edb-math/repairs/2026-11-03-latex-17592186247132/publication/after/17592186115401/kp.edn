#{[{:db/id #edb/ref 17592186115401 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114956 :question/id #uuid "38c9e8d8-871f-54b1-a8df-637f54430cc1" :question/math-academy-id "e-210" :question/problem "Find $f'(x)$ if $f(x) =2 \\, \\operatorname{arccot}  (x^2 + 5).$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\operatorname{arccot}  x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\operatorname{arccot} ({x}^{2}+5)) \\\\  & =2\\cdot \\left(-\\frac{1}{1+({x}^{2}+5)^{2}}\\right)\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+5) \\\\  & =-\\frac{2}{1+({x}^{2}+5)^{2}}\\cdot 2x \\\\  & =-\\frac{4x}{1+({x}^{2}+5)^{2}} \\\\  & =-\\frac{4x}{{x}^{4}+10{x}^{2}+26}\\,.\\end{aligned}\n$$"} :knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084 :topic/difficulty 1.4416972363891276 :topic/id #uuid "7fcc3a06-676a-55a2-9979-d3726053babe" :topic/knowledge-points [{:db/id #edb/ref 17592186096841} {:db/id #edb/ref 17592186096842} {:db/id #edb/ref 17592186096843}] :topic/math-academy-id 1108 :topic/next [{:db/id #edb/ref 17592186049332} {:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050628} {:db/id #edb/ref 17592186050789}] :topic/title "The Chain Rule for Differentiation"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/questions [{:db/id #edb/ref 17592186115737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4c1893d-4baa-508a-af92-14850bbe7d03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\mid x \\mid \\sqrt{100x^{2} - 1}}" :db/id #edb/ref 17592186113389} {:answer/id #uuid "02a798da-d199-5e6d-b699-00efb428affb" :answer/type {:db/ident :answer.type/math} :answer/value