r/value "\\frac{1}{\\sqrt{x}}-\\frac{1}{2|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340500} {:answer/id #uuid "a07504e1-78da-53c1-a071-bf6d07bb482a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{x}}+\\frac{2}{x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340581} {:answer/id #uuid "c71ac88f-b329-53fd-a776-c30ee71c20b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{1}{2x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340893} {:answer/id #uuid "c94af7b5-9c00-52e6-891e-6dbf2ca55530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340913}] :answer-field/correct {:db/id #edb/ref 17592186340913} :answer-field/id #uuid "47d65433-3d6d-5565-a566-451d9ef6b0e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341504}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "077baa93-9f9f-5780-986d-77a93ca959f7" :question/math-academy-id "q-73437" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=\\sqrt{x}-2\\operatorname{arccsc} x.$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccsc} $ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccsc} x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-2\\operatorname{arccsc} x) \\\\  & =\\frac{1}{2\\sqrt{x}}-2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccsc} x) \\\\  & =\\frac{1}{2\\sqrt{x}}-2\\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right) \\\\  & =\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826695b2-7896-554a-b710-615a2ed245c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(1+x)\\operatorname{arccot} x}{x(1+{x}^{2})}" :db/id #edb/ref 17592186340302} {:answer/id #uuid "93f0db0d-31f3-5683-a714-07d8975da0bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{x+(1+{x}^{2})\\operatorname{arccot} x}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186340458} {:answer/id #uuid "ca1c32a6-bafe-5590-8786-dbaa106a79b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1+{x}^{2}\\operatorname{arccot} x}{1+{x}^{2}}" :db/id #edb/ref 17592186340917} {:answer/id #uuid "cb871cf7-4c3d-5e61-967e-16852dd2a29f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{2}+\\operatorname{arccot} x}{1+{x}^{2}}" :db/id #edb/ref 17592186340931} {:answer/id #uuid "f5c4d346-27c8-58ed-bcdb-42b65dcb2294" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186341297}] :answer-field/correct {:db/id #edb/ref 17592186340458} :answer-field/id #uuid "4c91fda9-15a2-5689-ae97-5f52a67803da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341514}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fde98232-ad33-5093-b3ee-9574c7c7e230" :question/math-academy-id "q-73447" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arccot} x}{x}.$" :question/worked-solution "Here, we let $u(x)=\\operatorname{arccot} x$ and $v(x)=x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{1+{x}^{2}}\\,\\text{and}\\,{v}^{′}(x)=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{1+{x}^{2}}\\cdot x-\\operatorname{arccot} x\\cdot 1}{{x}^{2}} \\\\  & =\\frac{-\\frac{x}{1+{x}^{2}}-\\operatorname{arccot} x}{{x}^{2}} \\\\  & =-\\frac{\\left(\\frac{x+(1+{x}^{2})\\operatorname{arccot} x}{1+{x}^{2}}\\right)}{{x}^{2}} \\\\  & =-\\frac{x+(1+{x}^{2})\\operatorname{arccot} x}{{x}^{2}(1+{x}^{2})}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed6b8a7-489f-5243-a1ab-0833d4b3659d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}-\\frac{{e}^{3x}\\operatorname{arccsc} x}{{e}^{3x}-1}" :db/id #edb/ref 17592186339694} {:answer/id #uuid "72547bb8-80f4-5189-a664-31a103998d0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}\\operatorname{arccsc} x}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186340143} {:answer/id #uuid "778014a0-4d28-5cbd-bcfb-226c4ad315c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{e}^{3x}-1}{|x|\\sqrt{{x}^{2}-1}}+\\frac{3\\operatorname{arccsc} x}{{e}^{3x}({e}^{3x}-1)}" :db/id #edb/ref 17592186340192} {:answer/id #uuid "de92d6cb-e70b-5bc3-b99c-b1ff038239da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}\\operatorname{arccsc} x}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186341104} {:answer/id #uuid "fb52f006-44ca-5a45-b8f9-20bd82b1abbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}\\operatorname{arccsc} x}{{e}^{3x}-1}" :db/id #edb/ref 17592186341348}] :answer-field/correct {:db/id #edb/ref 17592186341104} :answer-field/id #uuid "d070584c-5ac5-5571-b148-95c94bd096be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341746}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f1d541e8-a8d8-5346-9cfd-53646530c168" :question/math-academy-id "q-73448" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arccsc} x}{{e}^{3x}-1}.$" :question/worked-solution "Here, we let $u(x)=\\operatorname{arccsc} x$ and $v(x)={e}^{3x}-1$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{and}\\,{v}^{′}(x)=3{e}^{3x}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot ({e}^{3x}-1)-\\operatorname{arccsc} x\\cdot 3{e}^{3x}}{({e}^{3x}-1)^{2}} \\\\  & =-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}\\operatorname{arccsc} x}{({e}^{3x}-1)^{2}}.\\end{aligned}\n$$"}]}
