2}\\cdot \\operatorname{cos}⁡x \\\\  & =\\operatorname{arccsc} {x}^{2}\\cdot \\operatorname{cos}⁡x-\\frac{2\\operatorname{sin}⁡x}{x\\sqrt{{x}^{4}-1}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10117d52-a320-51da-b8e7-1851c6537b64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} {x}^{3}}{x}-\\frac{3{x}^{2}\\operatorname{ln}⁡x}{1+{x}^{6}}" :db/id #edb/ref 17592186244464} {:answer/id #uuid "499ffb5c-b83a-58d5-90b9-0e51e6c92cae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} 3{x}^{2}}{x}-\\frac{{x}^{3}\\operatorname{ln}⁡x}{1+{x}^{3}}" :db/id #edb/ref 17592186244970} {:answer/id #uuid "72f3c284-9daf-518f-a212-1bfdfb0d4b58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} {x}^{3}}{x}-\\frac{{x}^{3}\\operatorname{ln}⁡x}{1-{x}^{6}}" :db/id #edb/ref 17592186245341} {:answer/id #uuid "7d53c2b1-d610-500b-b9e0-989e9fb2d955" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} 3{x}^{2}}{x}-\\frac{{x}^{3}\\operatorname{ln}⁡x}{1+{x}^{6}}" :db/id #edb/ref 17592186245411} {:answer/id #uuid "80ca9ee9-9680-5130-b873-69aa0c1c4beb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} {x}^{3}}{x}+\\frac{3{x}^{2}\\operatorname{ln}⁡x}{1-{x}^{3}}" :db/id #edb/ref 17592186245450}] :answer-field/correct {:db/id #edb/ref 17592186244464} :answer-field/id #uuid "5392ed53-d697-557a-8c69-87600131924e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246692}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7bf50188-a0f4-5cf7-996e-46360eb076ac" :question/math-academy-id "q-110817" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{ln}⁡x\\operatorname{arccot} {x}^{3}.$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule, the formula above and the chain rule, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x\\operatorname{arccot} {x}^{3}) \\\\  & =\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} {x}^{3})+\\operatorname{arccot} {x}^{3}\\cdot \\frac{\\text{d}}{\\text{d}x}\\operatorname{ln}⁡x \\\\  & =\\operatorname{ln}⁡x\\cdot \\left(-\\frac{3{x}^{2}}{1+{({x}^{3})}^{2}}\\right)+\\operatorname{arccot} {x}^{3}\\cdot \\left(\\frac{1}{x}\\right) \\\\  & =\\frac{\\operatorname{arccot} {x}^{3}}{x}-\\frac{3{x}^{2}\\operatorname{ln}⁡x}{1+{x}^{6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6a9bcf-5b72-54d9-a128-8bd6ee36de0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x+4}{\\operatorname{arccsc} x}+\\frac{{x}^{2}+4x}{\\sqrt{{x}^{2}-1}\\cdot {\\operatorname{arccsc} }^{2}x}" :db/id #edb/ref 17592186244573} {:answer/id #uuid "3a12daab-bb88-55ce-a334-ad69cb782225" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x+4}{\\operatorname{arccsc} x}-\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {\\operatorname{arccsc} }^{2}x}" :db/id #edb/ref 17592186244829} {:answer/id #uuid "734eb1e5-5d2c-548c-a909-d144450435b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4x+2}{\\operatorname{arcsec} x}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {\\operatorname{arccsc} }^{2}x}" :db/id #edb/ref 17592186245345} {:answer/id #uuid "d5f3b612-bac7-5a34-a41e-8ffc73c0c464" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x+4}{\\operatorname{arccsc} x}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {\\operatorname{arccsc} }^{2}x}" :db/id #edb/ref 17592186246219} {:answer/id #uuid "f484b6c9-af99-5