{x^{2} - 1}}" :db/id #edb/ref 17592186112211}] [{:answer/id #uuid "6a21f05b-9b4e-5f66-b11c-4a3324b87aec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{x}}{\\mid x \\mid \\sqrt{x^{2} - 1}} - \\frac{\\operatorname{arcsec} x}{e^{x}}" :db/id #edb/ref 17592186112212}] [{:answer/id #uuid "b1dd5fd9-9638-5408-b50c-6a8d9efdf6b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x}{\\sqrt{1 + x^{2}}} - \\frac{\\arcsin x}{1 - x^{2}}" :db/id #edb/ref 17592186112214}] [{:answer/id #uuid "b2f31e61-819e-505e-8790-31a53dc7f7a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x}{\\sqrt{1 - x^{2}}} + \\frac{\\arcsin x}{1 + x^{2}}" :db/id #edb/ref 17592186112215}] [{:answer/id #uuid "ffe85bfa-864f-5ebe-8770-22df9f5e4d61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x}{1 + x^{2}} - \\frac{\\arcsin x}{\\sqrt{1 - x^{2}}}" :db/id #edb/ref 17592186112216}] [{:answer/id #uuid "3526625e-2be7-503e-9cec-29cbc776d586" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x}{\\sqrt{1 - x^{2}}} - \\frac{\\arcsin x}{1 + x^{2}}" :db/id #edb/ref 17592186112218}] [{:answer/id #uuid "d1b65214-c4c9-571c-82ff-9b239a9f82e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x\\operatorname{arccot} x + 1}{\\operatorname{arccot} ^{2}x}" :db/id #edb/ref 17592186112388}] [{:answer/id #uuid "d55fd042-0de1-5716-a0b7-b6171cf78f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x\\operatorname{arccot} x}{\\operatorname{arccot} ^{2}x}" :db/id #edb/ref 17592186112389}] [{:answer/id #uuid "e84e54bd-d8e1-5446-a1fd-81bedfba7b93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x - x^{2}}{\\operatorname{arccot} ^{2}x}" :db/id #edb/ref 17592186112390}] [{:answer/id #uuid "357b4598-1039-51de-9159-4d214e63555e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x\\operatorname{arccot} x + x^{2}}{\\operatorname{arccot} ^{2}x}" :db/id #edb/ref 17592186112391}] [{:answer/id #uuid "6239c4a6-5c1a-5c0a-84ff-cd365e042a7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x\\operatorname{arccot} x - 1}{\\operatorname{arccot} ^{2}x}" :db/id #edb/ref 17592186112392}] [{:db/id #edb/ref 17592186114947 :question/id #uuid "5adf056c-d122-54e6-b55f-5e85d39750c4" :question/math-academy-id "e-207" :question/problem "Calculate $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$ if $y = 2 \\,\\operatorname{arccot}  x.$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\operatorname{arccot}  x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\operatorname{arccot} x) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} x) \\\\  & =2\\cdot \\left(-\\frac{1}{1+{x}^{2}}\\right) \\\\  & =-\\frac{2}{1+{x}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114951 :question/id #uuid "99db3f5c-5d6f-5e8e-a31c-a627ddd5c6dc" :question/math-academy-id "e-208" :question/problem "If $f(x) = \\dfrac{\\operatorname{arcsec}  x}{\\operatorname{arccsc}  x},$ calculate $f'(x).$" :question/worked-solution "Here, we let $u(x) = \\operatorname{arcsec}  x$ and $v(x) = \\operatorname{arccsc}  x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\nu'(x) =  \\dfrac 1 {|x| \\sqrt {x^2 - 1}}\t\\quad \\text{and} \\quad\tv'(x) = -\\dfrac 1 {|x| \\sqrt {x^2 - 1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot \\operatorname{arccsc} x-\\operatorname{arcsec} x\\cdot \\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)}{{\\operatorname{arccsc} }^{2}x} \\\\  & =\\left(\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)\\frac{\\operatorname{arccsc} x+\\operatorname{arcsec} x}{{\\operatorname{arccsc} }^{2}x} \\\\  & =\\frac{\\operatorname{arccsc} x+\\operatorname{arcsec} x}{|x|\\sqrt{{x}^{2}-1}{\\operatorname{arccsc} }^{2}x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114954 :question/id #uuid "fd6239d1-4fec-50b9-8018-f6e185c4e0d0" :question/math-academy-id "e-209" :question/problem "If $f(x) =3 x\\, \\operatorname{arccsc} x,$ calculate $f'(x).$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccsc} $ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\operatorname{arccsc}  x) \t=  -\\dfrac 1 {|x| \\sqrt {x^2 - 1}} \\, .\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3x\\,\\operatorname{arccsc} x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x\\,\\operatorname{arccsc} x) \\\\  & =3(x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccsc} x)+\\operatorname{arccsc} x\\cdot \\frac{\\text{d}}{\\text{d}x}(x)) \\\\  & =3x\\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)+3\\,\\operatorname{arccsc} x\\cdot 1 \\\\  & =-\\frac{3x}{|x|\\sqrt{{x}^{2}-1}}+3\\,\\operatorname{arccsc} x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114956 :question/id #uuid "38c9e8d8-871f-54b1-a8df-637f54430cc1" :question/math-academy-id "e-210" :question/problem "Find $f'(x)$ if $f(x) =2 \\, \\operatorname{arccot}  (x^2 + 5).$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\operatorname{arccot}  x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\operatorname{arccot} ({x}^{2}+5)) \\\\  & =2\\cdot \\left(-\\frac{1}{1+({x}^{2}+5)^{2}}\\right)\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+5) \\\\  & =-\\frac{2}{1+({x}^{2}+5)^{2}}\\cdot 2x \\\\  & =-\\frac{4x}{1+({x}^{2}+5)^{2}} \\\\  & =-\\frac{4x}{{x}^{4}+10{x}^{2}+26}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ad8e1e6-aeae-597a-8e80-139e17f3b6c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3x}(\\frac{2}{x\\sqrt{x^{4} - 1}} - \\operatorname{arcsec} (x^{2}))" :db/id #edb/ref 17592186112202} {:answer/id #uuid "b98942c7-09e2-55b4-b89b-7016b4f84c4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3x}(\\frac{1}{x\\sqrt{x^{4} + 1}} + 2x\\operatorname{arcsec} (x^{2}))" :db/id #edb/ref 17592186112203} {:answer/id #uuid "fd700e43-86b1-5a48-82aa-4e6264185c2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3x}(\\frac{1}{x\\sqrt{x^{4} - 1}} + \\operatorname{arcsec} (x^{2}))" :db/id #edb/ref 17592186112204} {:answer/id #uuid "05a7f4a5-59a0-529a-b09f-262ef6da842c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3x}(\\frac{3}{x\\sqrt{x^{4} - 1}} - 2\\operatorname{arcsec} (x^{2}))" :db/id #edb/ref 17592186112205} {:answer/id #uuid "7e2e4892-a7de-5e57-a230-5007341e473c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3x}(\\frac{2}{x\\sqrt{x^{4} - 1}} + 3\\operatorname{arcsec} (x^{2}))" :db/id #edb/ref 17592186112206}] :answer-field/id #uuid "dbb14aa8-7832-5db0-a93e-7335338936aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186112201}] :question/id #uuid "14657686-c040-5541-b8a0-6f9b2c48fb94" :question/math-academy-id "q-19066" :question/problem "Calculate $\\frac{dy}{dx}$ for $y = e^{3x}\\operatorname{arcsec} (x^{2})$."}] [{:db/id #edb/ref 17592186115533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fd1d4b0-0775-5319-b58c-d1ea54b380e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{e^{x} \\mid x \\mid \\sqrt{x^{2} - 1}} - \\frac{\\operatorname{arcsec} x}{e^{x}}" :db/id #edb/ref 17592186112208} {:answer/id #uuid "c55e20bc-0765-5d91-9268-4e6302f9479c" :answer/type {:db/id #edb/ref