ue "\\operatorname{arccot} x-\\frac{({x}^{3}+2x)(3{x}^{2}+2)}{{x}^{2}+1}" :db/id #edb/ref 17592186285882} {:answer/id #uuid "a0bb6a0e-a3e1-53de-bf1c-a588c28c1165" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3{x}^{2}+2)-\\frac{1}{{x}^{2}+1}" :db/id #edb/ref 17592186286254} {:answer/id #uuid "a3628ab9-5c34-5c92-bef6-1314d9e06e81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arccot} x-\\frac{{x}^{3}+2x}{{x}^{2}+1}" :db/id #edb/ref 17592186286286}] :answer-field/correct {:db/id #edb/ref 17592186284855} :answer-field/id #uuid "751d5f7c-e24c-5495-bd5f-426fdee41841" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287394}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd1d008a-84eb-52df-bb09-d41421bc5f0f" :question/math-academy-id "q-19065" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=({x}^{3}+2x)\\operatorname{arccot} x.$" :question/worked-solution "The formula for the derivative of $\\operatorname{arccot} $ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(({x}^{3}+2x)\\operatorname{arccot} x) \\\\  & =\\operatorname{arccot} x\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3}+2x)+({x}^{3}+2x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccot} x) \\\\  & =\\operatorname{arccot} x\\cdot (3{x}^{2}+2)+({x}^{3}+2x)\\cdot \\left(-\\frac{1}{1+{x}^{2}}\\right) \\\\  & =(3{x}^{2}+2)\\operatorname{arccot} x-\\frac{{x}^{3}+2x}{{x}^{2}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d0cca3-b930-583a-a67f-b7d2fbb30dc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt{{x}^{4}-1}(1+\\operatorname{arcsec} ({x}^{2}))}" :db/id #edb/ref 17592186284811} {:answer/id #uuid "29fc1d7b-795e-5330-9fed-248e9bdfb72b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x\\sqrt{{x}^{2}-1}(1+{\\operatorname{arcsec} }^{2}({x}^{2}))}" :db/id #edb/ref 17592186285156} {:answer/id #uuid "9615675e-d4e7-5987-b50d-4218c3a5988d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x\\sqrt{{x}^{4}-1}(1+{\\operatorname{arcsec} }^{2}({x}^{2}))}" :db/id #edb/ref 17592186286150} {:answer/id #uuid "c54342e1-8752-5e65-99b0-9ee8dc40302a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{{x}^{4}-1}(1+{\\operatorname{arcsec} }^{2}({x}^{2}))}" :db/id #edb/ref 17592186286596} {:answer/id #uuid "d33e9472-db4f-5b53-bf24-f8efe37e24bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x\\sqrt{{x}^{2}+1}(1-\\operatorname{arcsec} ({x}^{2}))}" :db/id #edb/ref 17592186286711}] :answer-field/correct {:db/id #edb/ref 17592186286150} :answer-field/id #uuid "cb52bc86-fbbc-58f3-a753-d854efd39ec9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287568}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7aebb99a-4bdf-525d-8f3e-1c1f2acc8b2b" :question/math-academy-id "q-19082" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=\\operatorname{arctan}⁡(\\operatorname{arcsec} ({x}^{2})).$" :question/worked-solution "The formulae for the derivatives of $arctan$ and $\\operatorname{arcsec} $ are\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(arctanx) & =\\frac{1}{1+{x}^{2}}, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsec} x) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nUsing the chain rule and the formulae above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(\\operatorname{arcsec} ({x}^{2}))) \\\\  & =\\frac{1}{1+(\\operatorname{arcsec} ({x}^{2}))^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsec} ({x}^{2})) \\\\  & =\\frac{1}{1+(\\operatorname{arcsec} ({x}^{2}))^{2}}\\cdot \\frac{1}{|{x}^{2}|\\sqrt{({x}^{2})^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\  & =\\frac{1}{1+(\\operatorname{arcsec} ({x}^{2}))^{2}}\\cdot \\frac{1}{|{x}^{2}|\\sqrt{({x}^{2})^{2}-1}}\\cdot 2x \\\\  & =\\frac{2}{x\\sqrt{{x}^{4}-1}(1+{\\operatorname{arcsec} }^{2}({x}^{2}))}.\\end{aligned}\n$$"}] [{:answer/id #uuid "0e3e8a72-d66c-5ec3-b40f-fb6c49116d9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡x}{x}+\\frac{\\operatorname{arccot} x}{1+{x}^{2}}" :db/id #edb/ref 17592186288134}] [{:answer/id #uuid "1bc58f79-67c9-5a07-82b8-37019e8fcf16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x}{x}-\\frac{\\operatorname{ln}⁡x}{1+{x}^{2}}" :db/id #edb/ref 17592186288210}] [{:answer/id #uuid "356f78a7-7f7f-5f9a-acab-fbad74f70904" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccot} x}{x}+\\frac{\\operatorname{ln}⁡x}{1+{x}^{2}}" :db/id #edb/ref 17592186288391}] [{:answer/id #uuid "5476c042-8711-54ab-b3d4-eadca3ea72e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\operatorname{arccsc} x}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288614}] [{:answer/id #uuid "5b9cda91-25c7-507c-ae14-575d705818bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡x\\cdot \\operatorname{arccot} x}{x(1+{x}^{2})}" :db/id #edb/ref 17592186288670}] [{:answer/id #uuid "6427fa83-3424-5638-881a-1b75c59158ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\operatorname{arcsec} x}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288737}] [{:answer/id #uuid "8d34a562-2280-5df3-b021-0fc8376c8ba7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arccsc} x-\\operatorname{arcsec} x}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288975}] [{:answer/id #uuid "f32241a6-5d82-568c-bcfd-3f92960cb105" :answer/type {:db/id