:db/ident :answer.type/math} :answer/value "\\frac{x\\arccotx + x^{2}}{\\arccot^{2}x}" :db/id #edb/ref 17592186112391} {:answer/id #uuid "6239c4a6-5c1a-5c0a-84ff-cd365e042a7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x\\arccotx - 1}{\\arccot^{2}x}" :db/id #edb/ref 17592186112392}] :answer-field/id #uuid "09cc01cc-afef-533c-a4cb-762bf0278237" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112387}] :question/id #uuid "589b5aac-76f6-5bc7-af1d-f524fa485a7d" :question/math-academy-id "q-2487" :question/problem "Find $f^{′}(x)$ for $f(x) = \\frac{x^{2} + 1}{\\arccotx}$."} {:db/id #edb/ref 17592186247164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ae4a4e-83f2-5fd1-80a3-1c8886737842" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}-4(1+{x}^{2})arccotx}{{x}^{4}(1+{x}^{2})}" :db/id #edb/ref 17592186244919} {:answer/id #uuid "54eb934b-2ffa-5765-b678-1ac5e7064ec2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-(1+{x}^{2})arccotx}{{x}^{2}(1-{x}^{2})}" :db/id #edb/ref 17592186245060} {:answer/id #uuid "5b3744b3-c954-58b2-9c58-4407b5d13c00" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2x+3(1+{x}^{2}){x}^{2}arccotx}{{x}^{4}(1+{x}^{2})}" :db/id #edb/ref 17592186245112} {:answer/id #uuid "b7b4864f-e9c0-561f-967a-e58924dd458a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+3(1+{x}^{2})arccotx}{{x}^{4}(1+{x}^{2})}" :db/id #edb/ref 17592186245953} {:answer/id #uuid "f4f040b6-a6e9-51c2-a70e-f9e708728537" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x+3{x}^{2}arccotx}{{x}^{4}(1-{x}^{2})}" :db/id #edb/ref 17592186246475}] :answer-field/correct {:answer/id #uuid "b7b4864f-e9c0-561f-967a-e58924dd458a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+3(1+{x}^{2})arccotx}{{x}^{4}(1+{x}^{2})}" :db/id #edb/ref 17592186245953} :answer-field/id #uuid "9717ab3e-0ab6-5407-ba6f-0013f2497acb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246810}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d426c97a-392b-5a03-bca2-ec79aac9b21d" :question/math-academy-id "q-110786" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccotx}{{x}^{3}}.$" :question/worked-solution "Here, we let $u(x)=arccotx$ and $v(x)={x}^{3},$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{1+{x}^{2}}\\,\\text{and}\\,{v}^{′}(x)=3{x}^{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{1+{x}^{2}}\\cdot {x}^{3}-arccotx\\cdot 3{x}^{2}}{({x}^{3})^{2}} \\\\  & =\\frac{-\\frac{{x}^{3}}{1+{x}^{2}}-3{x}^{2}arccotx}{{x}^{6}} \\\\  & =-\\frac{\\left(\\frac{{x}^{3}+3(1+{x}^{2}){x}^{2}arccotx}{1+{x}^{2}}\\right)}{{x}^{6}} \\\\  & =-\\frac{{x}^{3}+3(1+{x}^{2}){x}^{2}arccotx}{{x}^{6}(1+{x}^{2})} \\\\  & =-\\frac{x+3(1+{x}^{2})arccotx}{{x}^{4}(1+{x}^{2})}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6a9bcf-5b72-54d9-a128-8bd6ee36de0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186244573} {:answer/id #uuid "3a12daab-bb88-55ce-a334-ad69cb782225" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+4}{arccscx}-\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186244829} {:answer/id #uuid "734eb1e5-5d2c-548c-a909-d144450435b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x+2}{arcsecx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186245345} {:answer/id #uuid "d5f3b612-bac7-5a34-a41e-8ffc73c0c464" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246219} {:answer/id #uuid "f484b6c9-af99-5523-b72f-2c18bf53b1b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+4}{arccscx}-\\frac{2x+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246471}] :answer-field/correct {:answer/id #uuid "d5f3b612-bac7-5a34-a41e-8ffc73c0c464" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246219} :answer-field/id #uuid "f6a0c5df-079e-53e1-9ee0-47a76e0ae5a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246987}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "698df1fd-5fd3-5825-8b74-4170ba6ffbf1" :question/math-academy-id "q-110834" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{{x}^{2}+4x}{arccscx}.$" :question/worked-solution "Here, we let $u(x)={x}^{2}+4x$ and $v(x)=arccscx,$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=2x+4\\,\\text{and}\\,{v}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2x+4)\\cdot arccscx-({x}^{2}+4x)\\cdot \\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)}{{arccsc}^{2}x} \\\\  & =\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d669365-c1a7-59e0-93f1-eb14edcfb2d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+5}{\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186295435}] :answer-field/correct {:answer/id #uuid "1d669365-c1a7-59e0-93f1-