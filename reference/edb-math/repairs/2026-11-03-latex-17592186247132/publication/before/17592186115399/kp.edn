ef 17592186312778}] :answer-field/correct {:answer/id #uuid "65d81e41-d413-5bdc-bac8-be87aebb35d0" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}3" :db/id #edb/ref 17592186312778} :answer-field/id #uuid "283a6be5-839d-5ff0-9bb5-4cf7f3cc3f25" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314116} {:answer-field/choices [{:answer/id #uuid "371c6c74-0468-5c9c-b71f-5ca91630b4ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186312419}] :answer-field/correct {:answer/id #uuid "371c6c74-0468-5c9c-b71f-5ca91630b4ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186312419} :answer-field/id #uuid "9c25f5fd-d7bd-5f84-a472-da9da0020049" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314435}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "61288950-c35e-5f57-a1be-6d007672017d" :question/math-academy-id "q-341179" :question/problem "Find ${f}^{′}(x)$ for $f(x)=\\frac{{3}^{x}}{arccsc\\,x}.$\n\n${f}^{′}(x)=$\n{{field-1}} \n$\\frac{1}{arccsc\\,x}\\,+$\n{{field-2}}\n$\\frac{1}{|x|{(arccsc\\,x)}^{2}}.$" :question/worked-solution "Here, we let $u(x)={3}^{x}$ and $v(x)=arccsc\\,x,$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)={3}^{x}\\operatorname{ln}⁡3\\,\\text{and}\\,{v}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({3}^{x}\\operatorname{ln}⁡3)\\cdot arccsc\\,x-{3}^{x}\\cdot \\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)}{{(arccsc\\,x)}^{2}}. \\\\  & ={3}^{x}\\operatorname{ln}⁡3\\cdot \\frac{arccsc\\,x}{{(arccsc\\,x)}^{2}}+\\frac{{3}^{x}}{{(arccsc\\,x)}^{2}}\\cdot \\frac{1}{|x|\\sqrt{{x}^{2}-1}} \\\\  & ={3}^{x}\\operatorname{ln}⁡3\\,\\frac{1}{arccsc\\,x}+\\frac{{3}^{x}}{\\sqrt{{x}^{2}-1}}\\,\\frac{1}{|x|{(arccsc\\,x)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826695b2-7896-554a-b710-615a2ed245c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(1+x)arccotx}{x(1+{x}^{2})}" :db/id #edb/ref 17592186340302} {:answer/id #uuid "93f0db0d-31f3-5683-a714-07d8975da0bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186340458} {:answer/id #uuid "ca1c32a6-bafe-5590-8786-dbaa106a79b3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1+{x}^{2}arccotx}{1+{x}^{2}}" :db/id #edb/ref 17592186340917} {:answer/id #uuid "cb871cf7-4c3d-5e61-967e-16852dd2a29f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}+arccotx}{1+{x}^{2}}" :db/id #edb/ref 17592186340931} {:answer/id #uuid "f5c4d346-27c8-58ed-bcdb-42b65dcb2294" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{arccotx}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186341297}] :answer-field/correct {:answer/id #uuid "93f0db0d-31f3-5683-a714-07d8975da0bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186340458} :answer-field/id #uuid "4c91fda9-15a2-5689-ae97-5f52a67803da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341514}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fde98232-ad33-5093-b3ee-9574c7c7e230" :question/math-academy-id "q-73447" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccotx}{x}.$" :question/worked-solution "Here, we let $u(x)=arccotx$ and $v(x)=x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{1+{x}^{2}}\\,\\text{and}\\,{v}^{′}(x)=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{1+{x}^{2}}\\cdot x-arccotx\\cdot 1}{{x}^{2}} \\\\  & =\\frac{-\\frac{x}{1+{x}^{2}}-arccotx}{{x}^{2}} \\\\  & =-\\frac{\\left(\\frac{x+(1+{x}^{2})arccotx}{1+{x}^{2}}\\right)}{{x}^{2}} \\\\  & =-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed6b8a7-489f-5243-a1ab-0833d4b3659d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}-\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/id #edb/ref 17592186339694} {:answer/id #uuid "72547bb8-80f4-5189-a664-31a103998d0e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186340143} {:answer/id #uuid "778014a0-4d28-5cbd-bcfb-226c4ad315c6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{3x}-1}{|x|\\sqrt{{x}^{2}-1}}+\\frac{3arccscx}{{e}^{3x}({e}^{3x}-1)}" :db/id #edb/ref 17592186340192} {:answer/id #uuid "de92d6cb-e70b-5bc3-b99c-b1ff038239da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186341104} {:answer/id #uuid "fb52f006-44ca-5a45-b8f9-20bd82b1abbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/id #edb/ref 17592186341348}] :answer-field/correct {:answer/id #uuid "de92d6cb-e70b-5bc3-b99c-b1ff038239da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186341104} :answer-field/id #uuid "d070584c-5ac5-5571-b148-95c94bd096be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341746}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f1d541e8-a8d8-5346-9cfd-53646530c168" :question/math-academy-id "q-73448" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccscx}{{e}^{3x}-1}.$" :question/worked-solution "Here, we let $u(x)=arccscx$ and $v(x)={e}^{3x}-1$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{and}\\,{v}^{′}(x)=3{e}^{3x}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot ({e}^{3x}-1)-arccscx\\cdot 3{e}^{3x}}{({e}^{3x}-1)^{2}} \\\\  & =-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186746654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155ef973-48ae-5c79-9411-702d3ef31fc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arccot}x+\\frac{x}{1+x^2}}{\\operatorname{arccot}x}" :db/id #edb/ref 17592186746652} {:answer/id #uuid "4246150b-2c7e-51c5-961a-bacfab37f924" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arccot}x-\\frac{x}{1+x^2}}{(\\operatorname{arccot}x)^2}" :db/id #edb/ref 17592186746655} {:answer/id #uuid "4ac37bba-159b-55a5-b8ea-94ecf49a5f66" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{arccot}x+\\frac{x}{1+x^2}}{(\\operatorname{arccot}x)^2}" :db/id #edb/ref 17592186746656} {:answer/id #uuid "977b3dff-8d4c-5350-a446-f325577a00e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arccot}x+\\frac{x}{1+x^2}}{(\\operatorname{arccot}x)^2}" :db/id #edb/ref 17592186746662} {:answer/id #uuid "cb8bdecc-6600-5b44-b7f8-40b20aa9e2f1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{1+x^2}" :db/id #edb/ref 17592186746668}] :answer-field/correct {:answer/id #uuid "977b3dff-8d4c-5350-a446-f325577a00e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arccot}x+\\frac{x}{1+x^2}}{(\\operatorname{arccot}x)^2}" :db/id #edb/ref 17592186746662} :answer-field/id #uuid "1b607cf5-a23d-5670-8148-e3fef8494334" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186746653}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "38b4af68-0025-52ba-bd14-db0e00b51e5d" :question/problem "Find $f'(x)$ for $f(x)=\\frac{x}{\\operatorname{arccot}x}.$" :question/worked-solution "Let $u(x)=x$ and $v(x)=\\operatorname{arccot}x.$ Their derivatives are\n\n$$\nu'(x)=1,\\qquad v'(x)=-\\frac{1}{1+x^2}.\n$$\n\nApplying the quotient rule gives\n\n$$\n\\begin{aligned}\nf'(x)&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{\\operatorname{arccot}x-x\\left(-\\frac{1}{1+x^2}\\right)}{(\\operatorname{arccot}x)^2}\\\\\n&=\\frac{\\operatorname{arccot}x+\\frac{x}{1+x^2}}{(\\operatorname{arccot}x)^2}.\n\\end{aligned}\n$$\n\nThe plus sign before $\\frac{x}{1+x^2}$ comes from subtracting $x$ times the negative derivative of $\\operatorname{arccot}x.$"} {:db/id #edb/ref 17592186746657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec82e2c3-2ba9-55a1-9f9f-0f60003aeed0" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186746670}] :answer-field/correct {:answer/id #uuid "ec82e2c3-2ba9-55a1-9f9f-0f60003aeed0" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186746670} :answer-field/id #uuid "92489a5c-7943-597f-9a1d-1aabb6413ad1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186746661} {:answer-field/choices [{:answer/id #uuid "9e332d2b-b454-5a8b-ab81-bc24bc487603" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2+2}{\\sqrt{x^2-1}}" :db/id #edb/ref 17592186746663}] :answer-field/correct {:answer/id #uuid "9e332d2b-b454-5a8b-ab81-bc24bc487603" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2+2}{\\sqrt{x^2-1}}" :db/id #edb/ref 17592186746663} :answer-field/id #uuid "dcea7fde-aaaa-53ac-905c-a9887ed8c4dc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186746669}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "502f4ebf-c0f9-5903-bfe4-266a31796084" :question/problem "Find $f'(x)$ for $f(x)=\\frac{x^2+2}{\\operatorname{arcsec}x}.$\n\n$f'(x)=$ {{field-1}} $\\frac{1}{\\operatorname{arcsec}x}\\,-\\,$ {{field-2}} $\\frac{1}{|x|(\\operatorname{arcsec}x)^2}$" :question/worked-solution "Let $u(x)=x^2+2$ and $v(x)=\\operatorname{arcsec}x.$ Then\n\n$$\nu'(x)=2x,\\qquad v'(x)=\\frac{1}{|x|\\sqrt{x^2-1}}.\n$$\n\nUsing the quotient rule,\n\n$$\n\\begin{aligned}\nf'(x)&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{2x\\operatorname{arcsec}x-(x^2+2)\\frac{1}{|x|\\sqrt{x^2-1}}}{(\\operatorname{arcsec}x)^2}\\\\\n&=2x\\,\\frac{1}{\\operatorname{arcsec}x}-\\frac{x^2+2}{\\sqrt{x^2-1}}\\,\\frac{1}{|x|(\\operatorname{arcsec}x)^2}.\n\\end{aligned}\n$$\n\nThe first blank is $2x$ and the second is $\\frac{x^2+2}{\\sqrt{x^2-1}}.$ The factor $|x|$ is already outside the second blank; it must not be removed or counted twice. This derivative applies for $|x|>1.$"} {:db/id #edb/ref 17592186746660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6445ecfa-afbf-5694-b53d-8a06b8b033a1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{|x|\\sqrt{x^2-1}}-\\frac{2e^{2x}\\operatorname{arccsc}x}{e^{2x}+1}" :db/id #edb/ref 17592186746658} {:answer/id #uuid "6fdd42e8-bf69-54a4-bef3-4f0bcc066c69" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(e^{2x}+1)|x|\\sqrt{x^2-1}}-\\frac{2e^{2x}\\operatorname{arccsc}x}{(e^{2x}+1)^2}" :db/id #edb/ref 17592186746659} {:answer/id #uuid "b7457510-e032-5e5d-bbfc-d7aafd9f670c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(e^{2x}+1)|x|\\sqrt{x^2-1}}+\\frac{2e^{2x}\\operatorname{arccsc}x}{(e^{2x}+1)^2}" :db/id #edb/ref 17592186746664} {:answer/id #uuid "c8b04790-5cd9-592d-a8dc-fe88299e2725" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(e^{2x}+1)|x|\\sqrt{x^2-1}}-\\frac{e^{2x}\\operatorname{arccsc}x}{(e^{2x}+1)^2}" :db/id #edb/ref 17592186746666} {:answer/id #uuid "c9665a0b-f9df-5098-b31e-00dbf5895f6e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(e^{2x}+1)x\\sqrt{x^2-1}}-\\frac{2e^{2x}\\operatorname{arccsc}x}{(e^{2x}+1)^2}" :db/id #edb/ref 17592186746667}] :answer-field/correct {:answer/id #uuid "6fdd42e8-bf69-54a4-bef3-4f0bcc066c69" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(e^{2x}+1)|x|\\sqrt{x^2-1}}-\\frac{2e^{2x}\\operatorname{arccsc}x}{(e^{2x}+1)^2}" :db/id #edb/ref 17592186746659} :answer-field/id #uuid "c3a53505-eaa6-5a2d-b6ab-88daea132b49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186746665}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8cf05a97-506b-5c88-bd49-6cfd4b6110a1" :question/problem "Calculate $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$ for $y=\\frac{\\operatorname{arccsc}x}{e^{2x}+1}.$" :question/worked-solution "Let $u(x)=\\operatorname{arccsc}x$ and $v(x)=e^{2x}+1.$ We have\n\n$$\nu'(x)=-\\frac{1}{|x|\\sqrt{x^2-1}},\\qquad v'(x)=2e^{2x}.\n$$\n\nThe factor $2$ in $v'(x)$ comes from differentiating the exponent $2x.$ Applying the quotient rule,\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{-\\frac{e^{2x}+1}{|x|\\sqrt{x^2-1}}-2e^{2x}\\operatorname{arccsc}x}{(e^{2x}+1)^2}\\\\\n&=-\\frac{1}{(e^{2x}+1)|x|\\sqrt{x^2-1}}-\\frac{2e^{2x}\\operatorname{arccsc}x}{(e^{2x}+1)^2}.\n\\end{aligned}\n$$\n\nBoth terms carry a minus sign: $u'(x)$ is negative, and the quotient rule subtracts $u(x)v'(x).$ The absolute value must be retained for negative as well as positive $x.$ The derivative applies for $|x|>1.$"} {:db/id #edb/ref 17592186746748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0535c42c-2ce5-5115-be0d-630fc9cace88" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1+x^2}}{\\left(3x\\right)^{2}}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{\\left(3x\\right)^{3}}" :db/id #edb/ref 17592186746733} {:answer/id #uuid "429e6400-36bd-5d2c-9210-e79fd3defdc0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arccot}x}{3x}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{\\left(3x\\right)^{2}}" :db/id #edb/ref 17592186746741} {:answer/id #uuid "7f01aa2b-b498-549b-9d60-3b11ea5167aa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{1+x^2}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{3x}" :db/id #edb/ref 17592186746745} {:answer/id #uuid "e60a01a6-4e1d-55ec-8e99-4c60f3e32643" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1+x^2}}{3x}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{\\left(3x\\right)^{2}}" :db/id #edb/ref 17592186746756} {:answer/id #uuid "ea17677f-2bc0-54fb-8d76-17bcbb37b0f7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1-x^2}}{3x}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{\\left(3x\\right)^{2}}" :db/id #edb/ref 17592186746757}] :answer-field/correct {:answer/id #uuid "e60a01a6-4e1d-55ec-8e99-4c60f3e32643" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1+x^2}}{3x}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{\\left(3x\\right)^{2}}" :db/id #edb/ref 17592186746756} :answer-field/id #uuid "0522fef5-9057-5484-a4be-9cac05f5a158" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186746732}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "872d1761-7366-5a5c-9ca4-70b748c742cc" :question/problem "Find $f'(x)$ for $f(x)=\\frac{\\operatorname{arccot}x}{3x}.$" :question/worked-solution "Let $u(x)=\\operatorname{arccot}x$ and $v(x)=3x.$ Their derivatives are\n\n$$\nu'(x)=-\\frac{1}{1+x^2},\\qquad v'(x)=3.\n$$\n\nApplying the quotient rule gives\n\n$$\n\\begin{aligned}\nf'(x)&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{\\left(-\\frac{1}{1+x^2}\\right)\\,\\left(3x\\right)-\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{\\left(3x\\right)^{2}}\\\\\n&=-\\frac{\\frac{1}{1+x^2}}{3x}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3\\right)}{\\left(3x\\right)^{2}}.\n\\end{aligned}\n$$\n\nThe derivative applies wherever the original denominator is nonzero."} {:db/id #edb/ref 17592186746750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5217a394-9581-5045-8f56-8140717c3020" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2+5x}{\\sqrt{x^2-1}}" :db/id #edb/ref 17592186746743}] :answer-field/correct {:answer/id #uuid "5217a394-9581-5045-8f56-8140717c3020" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2+5x}{\\sqrt{x^2-1}}" :db/id #edb/ref 17592186746743} :answer-field/id #uuid "71a3586c-9f8c-5b66-b967-0b497ee5ad63" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186746744} {:answer-field/choices [{:answer/id #uuid "f4f90ab5-f779-5fa1-bcaa-a19f777bf5e2" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5" :db/id #edb/ref 17592186746761}] :answer-field/correct {:answer/id #uuid "f4f90ab5-f779-5fa1-bcaa-a19f777bf5e2" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5" :db/id #edb/ref 17592186746761} :answer-field/id #uuid "ea9b9e96-da24-5bc6-b7df-5f03b525d9f1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186746758}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "908dc97b-c3cc-5950-b461-d3c8d243e3a8" :question/problem "Find $f'(x)$ for $f(x)=\\frac{x^2+5x}{\\operatorname{arcsec}x}.$\n\n$f'(x)=$ {{field-1}} $\\frac{1}{\\operatorname{arcsec}x}\\,-\\,$ {{field-2}} $\\frac{1}{|x|\\left(\\operatorname{arcsec}x\\right)^{2}}$" :question/worked-solution "Let $u(x)=x^2+5x$ and $v(x)=\\operatorname{arcsec}x.$ Their derivatives are\n\n$$\nu'(x)=2x+5,\\qquad v'(x)=\\frac{1}{|x|\\sqrt{x^2-1}}.\n$$\n\nApplying the quotient rule gives\n\n$$\n\\begin{aligned}\nf'(x)&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{\\left(2x+5\\right)\\,\\left(\\operatorname{arcsec}x\\right)-\\left(x^2+5x\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arcsec}x\\right)^{2}}\\\\\n&=\\frac{2x+5}{\\operatorname{arcsec}x}-\\frac{\\left(x^2+5x\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arcsec}x\\right)^{2}}.\n\\end{aligned}\n$$\n\nThe derivative applies where $|x|>1$ and the original denominator is nonzero.\n\nSeparate the supplied reciprocal factors:\n\n$$\n\\begin{aligned}f'(x)&=\\left(2x+5\\right)\\,\\left(\\frac{1}{\\operatorname{arcsec}x}\\right)\\\\\n&\\quad -\\left(\\frac{x^2+5x}{\\sqrt{x^2-1}}\\right)\\,\\left(\\frac{1}{|x|\\left(\\operatorname{arcsec}x\\right)^{2}}\\right)\\end{aligned}.\n$$\n\nThe first blank is $2x+5$ and the second is $\\frac{x^2+5x}{\\sqrt{x^2-1}}.$ The factor $|x|$ is already supplied outside the second blank."} {:db/id #edb/ref 17592186746752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055abe09-a3f7-5791-b6d1-b88f71f6a674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1+x^2}}{x^{3}}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3x^{2}\\right)}{\\left(x^{3}\\right)^{2}}" :db/id #edb/ref 17592186746734} {:answer/id #uuid "115955d9-9480-57b7-a353-d06c66a9c501" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1+x^2}}{x^{3}}+\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3x^{2}\\right)}{\\left(x^{3}\\right)^{2}}" :db/id #edb/ref 17592186746735} {:answer/id #uuid "327b77e1-87b7-5d35-8b7a-e1694b1974fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{1+x^2}}{x^{3}}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3x^{2}\\right)}{\\left(x^{3}\\right)^{2}}" :db/id #edb/ref 17592186746738} {:answer/id #uuid "3be20d5f-962c-5a65-99b2-09633f86ed75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{1+x^2}}{x^{3}}+\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3x^{2}\\right)}{\\left(x^{3}\\right)^{2}}" :db/id #edb/ref 17592186746739} {:answer/id #uuid "4e0efd54-b7dc-513d-b11c-e7af84b7d2fb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1+x^2}}{x^{3}}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(x^{2}\\right)}{\\left(x^{3}\\right)^{2}}" :db/id #edb/ref 17592186746742}] :answer-field/correct {:answer/id #uuid "055abe09-a3f7-5791-b6d1-b88f71f6a674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\frac{1}{1+x^2}}{x^{3}}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3x^{2}\\right)}{\\left(x^{3}\\right)^{2}}" :db/id #edb/ref 17592186746734} :answer-field/id #uuid "82cd0b3d-4be0-5d13-8e8a-369d5395931d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186746747}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a547ea92-97f1-53de-a327-efe787af1080" :question/problem "Find $f'(x)$ for $f(x)=\\frac{\\operatorname{arccot}x}{x^{3}}.$" :question/worked-solution "Let $u(x)=\\operatorname{arccot}x$ and $v(x)=x^{3}.$ Their derivatives are\n\n$$\nu'(x)=-\\frac{1}{1+x^2},\\qquad v'(x)=3x^{2}.\n$$\n\nApplying the quotient rule gives\n\n$$\n\\begin{aligned}\nf'(x)&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{\\left(-\\frac{1}{1+x^2}\\right)\\,\\left(x^{3}\\right)-\\left(\\operatorname{arccot}x\\right)\\,\\left(3x^{2}\\right)}{\\left(x^{3}\\right)^{2}}\\\\\n&=-\\frac{\\frac{1}{1+x^2}}{x^{3}}-\\frac{\\left(\\operatorname{arccot}x\\right)\\,\\left(3x^{2}\\right)}{\\left(x^{3}\\right)^{2}}.\n\\end{aligned}\n$$\n\nThe derivative applies wherever the original denominator is nonzero."} {:db/id #edb/ref 17592186746754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1c7ce46-5a19-5200-98ce-6e3108536072" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186746755}] :answer-field/correct {:answer/id #uuid "e1c7ce46-5a19-5200-98ce-6e3108536072" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186746755} :answer-field/id #uuid "8210da54-4bb0-5cdf-ba23-b1a4e239c53e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186746746} {:answer-field/choices [{:answer/id #uuid "1ff58b66-7910-5e23-bef2-2af10dab7e34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2+5}{\\sqrt{x^2-1}}" :db/id #edb/ref 17592186746736}] :answer-field/correct {:answer/id #uuid "1ff58b66-7910-5e23-bef2-2af10dab7e34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2+5}{\\sqrt{x^2-1}}" :db/id #edb/ref 17592186746736} :answer-field/id #uuid "ce512654-d7a9-5a77-8d99-6af72ee14b9f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186746753}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d525b66a-b6ff-5eb7-b31c-2b546a3a8ed8" :question/problem "Find $f'(x)$ for $f(x)=\\frac{x^2+5}{\\operatorname{arcsec}x}.$\n\n$f'(x)=$ {{field-1}} $\\frac{1}{\\operatorname{arcsec}x}\\,-\\,$ {{field-2}} $\\frac{1}{|x|\\left(\\operatorname{arcsec}x\\right)^{2}}$" :question/worked-solution "Let $u(x)=x^2+5$ and $v(x)=\\operatorname{arcsec}x.$ Their derivatives are\n\n$$\nu'(x)=2x,\\qquad v'(x)=\\frac{1}{|x|\\sqrt{x^2-1}}.\n$$\n\nApplying the quotient rule gives\n\n$$\n\\begin{aligned}\nf'(x)&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{\\left(2x\\right)\\,\\left(\\operatorname{arcsec}x\\right)-\\left(x^2+5\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arcsec}x\\right)^{2}}\\\\\n&=\\frac{2x}{\\operatorname{arcsec}x}-\\frac{\\left(x^2+5\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arcsec}x\\right)^{2}}.\n\\end{aligned}\n$$\n\nThe derivative applies where $|x|>1$ and the original denominator is nonzero.\n\nSeparate the supplied reciprocal factors:\n\n$$\n\\begin{aligned}f'(x)&=\\left(2x\\right)\\,\\left(\\frac{1}{\\operatorname{arcsec}x}\\right)\\\\\n&\\quad -\\left(\\frac{x^2+5}{\\sqrt{x^2-1}}\\right)\\,\\left(\\frac{1}{|x|\\left(\\operatorname{arcsec}x\\right)^{2}}\\right)\\end{aligned}.\n$$\n\nThe first blank is $2x$ and the second is $\\frac{x^2+5}{\\sqrt{x^2-1}}.$ The factor $|x|$ is already supplied outside the second blank."} {:db/id #edb/ref 17592186746759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21daac9c-80a3-559d-a1fc-f5104e569f1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{\\operatorname{arccsc}x}+\\frac{\\left(x^2+4\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2+1}}\\right)}{\\left(\\operatorname{arccsc}x\\right)^{2}}" :db/id #edb/ref 17592186746737} {:answer/id #uuid "8a528ece-a2c2-53b4-ba3d-eb84fd68f273" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{\\operatorname{arccsc}x}-\\frac{x^2+4}{\\left(\\operatorname{arccsc}x\\right)^{2}}" :db/id #edb/ref 17592186746749} {:answer/id #uuid "98f01875-a0a9-506e-a2ed-f827b10b40c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{\\operatorname{arccsc}x}-\\frac{\\left(x^2+4\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arccsc}x\\right)^{2}}" :db/id #edb/ref 17592186746751} {:answer/id #uuid "f446ec59-6552-580a-a003-6defdb1fb1cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{\\operatorname{arccsc}x}+\\frac{\\left(x^2+4\\right)\\,\\left(\\frac{1}{x\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arccsc}x\\right)^{2}}" :db/id #edb/ref 17592186746760} {:answer/id #uuid "f6141064-61f6-5994-a1b0-c1188f6f5398" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{\\operatorname{arccsc}x}+\\frac{\\left(x^2+4\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arccsc}x\\right)^{2}}" :db/id #edb/ref 17592186746762}] :answer-field/correct {:answer/id #uuid "f6141064-61f6-5994-a1b0-c1188f6f5398" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{\\operatorname{arccsc}x}+\\frac{\\left(x^2+4\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arccsc}x\\right)^{2}}" :db/id #edb/ref 17592186746762} :answer-field/id #uuid "4250e04d-1819-5958-bd54-70ad5a06a1fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186746740}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eb054ab6-a319-5345-a620-80982155c4aa" :question/problem "Find $f'(x)$ for $f(x)=\\frac{x^2+4}{\\operatorname{arccsc}x}.$" :question/worked-solution "Let $u(x)=x^2+4$ and $v(x)=\\operatorname{arccsc}x.$ Their derivatives are\n\n$$\nu'(x)=2x,\\qquad v'(x)=-\\frac{1}{|x|\\sqrt{x^2-1}}.\n$$\n\nApplying the quotient rule gives\n\n$$\n\\begin{aligned}\nf'(x)&=\\frac{u'(x)v(x)-u(x)v'(x)}{[v(x)]^2}\\\\\n&=\\frac{\\left(2x\\right)\\,\\left(\\operatorname{arccsc}x\\right)-\\left(x^2+4\\right)\\,\\left(-\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arccsc}x\\right)^{2}}\\\\\n&=\\frac{2x}{\\operatorname{arccsc}x}+\\frac{\\left(x^2+4\\right)\\,\\left(\\frac{1}{|x|\\sqrt{x^2-1}}\\right)}{\\left(\\operatorname{arccsc}x\\right)^{2}}.\n\\end{aligned}\n$$\n\nThe derivative applies where $|x|>1$ and the original denominator is nonzero."}] :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Quotient Rule"}]}
