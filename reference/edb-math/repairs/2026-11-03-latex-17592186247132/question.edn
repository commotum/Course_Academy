#{[{:db/id #edb/ref 17592186247132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7e650b-1d1b-565a-8bca-6db801ba288f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7\\sqrt{5}}" :db/id #edb/ref 17592186244574} {:answer/id #uuid "5c20347c-4fa7-55bc-810b-bd3a2b52dd11" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5\\sqrt{7}}" :db/id #edb/ref 17592186245124} {:answer/id #uuid "77de4b5c-0326-588b-88af-014db4c26886" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5\\sqrt{2}}" :db/id #edb/ref 17592186245378} {:answer/id #uuid "9d68227a-9d26-5cb5-b631-fe7afdbba8e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2\\sqrt{5}}" :db/id #edb/ref 17592186245714} {:answer/id #uuid "cbe51c6c-6bb0-5106-930c-50b1e556eada" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2\\sqrt{7}}" :db/id #edb/ref 17592186246131}] :answer-field/correct {:answer/id #uuid "9d68227a-9d26-5cb5-b631-fe7afdbba8e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2\\sqrt{5}}" :db/id #edb/ref 17592186245714} :answer-field/id #uuid "ded982e3-647f-52b9-a893-f698eb9f39b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246943}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9b98c70c-6a88-51cb-9877-b27cf2c2def7" :question/math-academy-id "q-110510" :question/problem "Find the slope of the tangent line to the curve $f(x)=-7arccscx$ at $x=\\sqrt{5}.$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccscx)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-7arccscx) \\\\  & =-7\\cdot \\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right) \\\\  & =\\frac{7}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line to the curve $y=f(x)$ at $x=\\sqrt{5}$ is\n\n$$\n\\begin{aligned}{f}^{′}(\\sqrt{5}) & =\\frac{7}{|\\sqrt{5}|\\sqrt{{\\sqrt{5}}^{2}-1}} \\\\  & =\\frac{7}{\\sqrt{5}\\sqrt{5-1}} \\\\  & =\\frac{7}{2\\sqrt{5}}.\\end{aligned}\n$$"}]}
