#{[{:activity/expected-seconds 1200.0 :activity/first-step {:db/id #edb/ref 17592186116380} :activity/id #uuid "157977f0-4722-54f2-b058-5943da844790" :activity/scope {:db/id #edb/ref 17592186049402} :activity/steps [{:db/id #edb/ref 17592186116380 :step/content {:db/id #edb/ref 17592186116525 :tutorial/content "We can calculate the derivatives of the inverse reciprocal trigonometric functions by using their definition and the chain rule, similar to how we did for the inverse trigonometric functions. When we do so, we get the following results:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\text{arcsec }x) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}} \\\\ \\frac{\\text{d}}{\\text{d}x}(\\text{arccsc }x) & =-\\frac{1}{|x|\\sqrt{{x}^{2}-1}} \\\\ \\frac{\\text{d}}{\\text{d}x}(\\text{arccot }x) & =-\\frac{1}{1+{x}^{2}}\\end{aligned}\n$$" :tutorial/id #uuid "8e9ebe2e-e55f-5d5a-84d8-e4431382a5d4" :tutorial/math-academy-id 458 :tutorial/title "Introduction"} :step/id #uuid "131b6da2-b272-5e15-a973-2aebc37a5d3a" :step/math-academy-id 851 :step/next {:db/id #edb/ref 17592186116381}} {:db/id #edb/ref 17592186116381 :step/content {:db/id #edb/ref 17592186115398 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114947 :question/id #uuid "5adf056c-d122-54e6-b55f-5e85d39750c4" :question/math-academy-id "e-207" :question/problem "Calculate $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$ if $y = 2 \\,\\textrm {arccot } x.$" :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot } x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\text{arccot }x) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\text{arccot }x) \\\\  & =2\\cdot \\left(-\\frac{1}{1+{x}^{2}}\\right) \\\\  & =-\\frac{2}{1+{x}^{2}}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186746731} :knowledge-point/questions [{:db/id #edb/ref 17592186115730} {:db/id #edb/ref 17592186115736} {:db/id #edb/ref 17592186247132} {:db/id #edb/ref 17592186247133} {:db/id #edb/ref 17592186297336} {:db/id #edb/ref 17592186315048} {:db/id #edb/ref 17592186341971} {:db/id #edb/ref 17592186746626} {:db/id #edb/ref 17592186746635} {:db/id #edb/ref 17592186746638} {:db/id #edb/ref 17592186746718} {:db/id #edb/ref 17592186746719} {:db/id #edb/ref 17592186746725} {:db/id #edb/ref 17592186746726} {:db/id #edb/ref 17592186746727}] :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions"} :step/id #uuid "fbc067c6-75a4-5898-ae0e-cd13f6529238" :step/math-academy-id 852 :step/next {:db/id #edb/ref 17592186116384}} {:db/id #edb/ref 17592186116382 :step/content {:db/id #edb/ref 17592186115399 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114951 :question/id #uuid "99db3f5c-5d6f-5e8e-a31c-a627ddd5c6dc" :question/math-academy-id "e-208" :question/problem "If $f(x) = \\dfrac{\\textrm{arcsec } x}{\\textrm{arccsc } x},$ calculate $f'(x).$" :question/worked-solution "Here, we let $u(x) = \\textrm{arcsec } x$ and $v(x) = \\textrm{arccsc } x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\nu'(x) =  \\dfrac 1 {|x| \\sqrt {x^2 - 1}}\t\\quad \\text{and} \\quad\tv'(x) = -\\dfrac 1 {|x| \\sqrt {x^2 - 1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot \\text{arccsc }x-\\text{arcsec }x\\cdot \\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)}{{\\text{arccsc }}^{2}x} \\\\  & =\\left(\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)\\frac{\\text{arccsc }x+\\text{arcsec }x}{{\\text{arccsc }}^{2}x} \\\\  & =\\frac{\\text{arccsc }x+\\text{arcsec }x}{|x|\\sqrt{{x}^{2}-1}{\\text{ arccsc }}^{2}x}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048842} {:db/id #edb/ref 17592186051029}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186746763} :knowledge-point/questions [{:db/id #edb/ref 17592186115533} {:db/id #edb/ref 17592186115571} {:db/id #edb/ref 17592186247164} {:db/id #edb/ref 17592186247169} {:db/id #edb/ref 17592186297338} {:db/id #edb/ref 17592186315060} {:db/id #edb/ref 17592186341973} {:db/id #edb/ref 17592186341974} {:db/id #edb/ref 17592186746654} {:db/id #edb/ref 17592186746657} {:db/id #edb/ref 17592186746660} {:db/id #edb/ref 17592186746748} {:db/id #edb/ref 17592186746750} {:db/id #edb/ref 17592186746752} {:db/id #edb/ref 17592186746754} {:db/id #edb/ref 17592186746759}] :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Quotient Rule"} :step/id #uuid "3855e5b0-241a-5732-8d2b-a010a4775e07" :step/math-academy-id 855} {:db/id #edb/ref 17592186116383 :step/content {:db/id #edb/ref 17592186115400 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114954 :question/id #uuid "fd6239d1-4fec-50b9-8018-f6e185c4e0d0" :question/math-academy-id "e-209" :question/problem "If $f(x) =3 x\\, \\textrm {arccsc }x,$ calculate $f'(x).$" :question/worked-solution "The formula for the derivative of $\\textrm{arccsc}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccsc } x) \t=  -\\dfrac 1 {|x| \\sqrt {x^2 - 1}} \\, .\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3x\\,\\text{arccsc }x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x\\,\\text{arccsc }x) \\\\  & =3(x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\text{arccsc }x)+\\text{arccsc }x\\cdot \\frac{\\text{d}}{\\text{d}x}(x)) \\\\  & =3x\\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)+3\\,\\text{arccsc }x\\cdot 1 \\\\  & =-\\frac{3x}{|x|\\sqrt{{x}^{2}-1}}+3\\,\\text{arccsc }x.\\end{aligned}\n$$"} :knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186746779} :knowledge-point/questions [{:db/id #edb/ref 17592186115532} {:db/id #edb/ref 17592186115534} {:db/id #edb/ref 17592186247165} {:db/id #edb/ref 17592186247168} {:db/id #edb/ref 17592186287920} {:db/id #edb/ref 17592186290578} {:db/id #edb/ref 17592186290579} {:db/id #edb/ref 17592186315055} {:db/id #edb/ref 17592186315056} {:db/id #edb/ref 17592186315057} {:db/id #edb/ref 17592186746684} {:db/id #edb/ref 17592186746692} {:db/id #edb/ref 17592186746698} {:db/id #edb/ref 17592186746766} {:db/id #edb/ref 17592186746770} {:db/id #edb/ref 17592186746772} {:db/id #edb/ref 17592186746775} {:db/id #edb/ref 17592186746777}] :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Product Rule"} :step/id #uuid "7add9af3-4e69-5a00-ac49-d6a47adeacc8" :step/math-academy-id 857 :step/next {:db/id #edb/ref 17592186116382}} {:db/id #edb/ref 17592186116384 :step/content {:db/id #edb/ref 17592186115401 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114956 :question/id #uuid "38c9e8d8-871f-54b1-a8df-637f54430cc1" :question/math-academy-id "e-210" :question/problem "Find $f'(x)$ if $f(x) =2 \\, \\textrm {arccot } (x^2 + 5).$" :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot } x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\text{arccot }({x}^{2}+5)) \\\\  & =2\\cdot \\left(-\\frac{1}{1+({x}^{2}+5)^{2}}\\right)\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+5) \\\\  & =-\\frac{2}{1+({x}^{2}+5)^{2}}\\cdot 2x \\\\  & =-\\frac{4x}{1+({x}^{2}+5)^{2}} \\\\  & =-\\frac{4x}{{x}^{4}+10{x}^{2}+26}\\,.\\end{aligned}\n$$"} :knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186115737} {:db/id #edb/ref 17592186115739} {:db/id #edb/ref 17592186287924} {:db/id #edb/ref 17592186297337} {:db/id #edb/ref 17592186299712} {:db/id #edb/ref 17592186299772} {:db/id #edb/ref 17592186315051} {:db/id #edb/ref 17592186315052}] :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Chain Rule"} :step/id #uuid "e41a82b4-e15b-5881-b0c6-3b4d02575649" :step/math-academy-id 859 :step/next {:db/id #edb/ref 17592186116383}}] :activity/title "Differentiating Inverse Reciprocal Trigonometric Functions" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186115469}]}
