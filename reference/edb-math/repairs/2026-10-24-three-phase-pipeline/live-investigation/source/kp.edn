#{[{:db/id #edb/ref 17592186068863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068501 :question/id #uuid "e1662bab-c11d-5770-8b7d-6646902f7e20" :question/math-academy-id "e-1435" :question/problem "Solve the equation $x^2 + 2x = 6$." :question/worked-solution "The first step is to put the equation into standard form:\n\n$$\n\\begin{aligned}\nx^{2} + 2x &= 6 \\\\\nx^{2} + 2x - 6 &= 0\n\\end{aligned}\n$$\n\nThe coefficients of our quadratic equation are\n\n$$\na = 1, \\quad b = 2, \\quad c = -6\n$$\n\nNow, we substitute these values into the quadratic formula:\n\n$$\n\\begin{aligned} x &= \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\\\[5pt] &= \\dfrac{-(2) \\pm \\sqrt{(2)^2 - 4(1)(-6)}}{2(1)} \\\\[5pt] &= \\dfrac{-2 \\pm \\sqrt{28}}{2} \\\\[5pt] &= \\dfrac{-2 \\pm 2\\sqrt{7}}{2} \\\\[5pt] &= -1 \\pm \\sqrt{7} \\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nx = -1 + \\sqrt{7}\n$$\n\nand\n\n$$\nx = -1 - \\sqrt{7}\n$$"} :knowledge-point/id #uuid "1c011eb9-7c5a-5180-812a-e6bbfcc7d93f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049077 :topic/id #uuid "d8c4ac32-4132-52a4-ae3a-c84da7590f1f" :topic/knowledge-points [{:db/id #edb/ref 17592186087704} {:db/id #edb/ref 17592186087705} {:db/id #edb/ref 17592186087706}] :topic/math-academy-id 813 :topic/next [{:db/id #edb/ref 17592186048963} {:db/id #edb/ref 17592186049724} {:db/id #edb/ref 17592186050296} {:db/id #edb/ref 17592186050465} {:db/id #edb/ref 17592186050845}] :topic/title "Introduction to Quadratic Equations"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/unobserved}] :knowledge-point/questions [{:db/id #edb/ref 17592186069270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1a50aba-17a0-50da-85a6-cf909c595346" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{-11 ± 5\\sqrt{13}}{2}" :db/id #edb/ref 17592186066791} {:answer/id #uuid "bb2a4311-ca61-5818-abbc-430eb4873b02" :answer/type {:db/ident :answer.type/math} :answer/v