ame{sec}⁡x)]}^{′}}{{[ln\\,(\\operatorname{cot}⁡x)]}^{′}} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{\\left(\\frac{\\operatorname{sec}⁡x\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\right)}{\\left(-\\frac{{csc}^{2}⁡x}{\\operatorname{cot}⁡x}\\right)} \\\\  & =-{lim}_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\operatorname{cot}⁡x}{{csc}^{2}⁡x} \\\\  & =-{lim}_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\frac{1}{\\operatorname{tan}⁡x}}{\\frac{1}{{sin}^{2}⁡x}} \\\\  & =-{lim}_{x\\to (\\pi /2)^{-}}{sin}^{2}⁡x \\\\  & =-1.\\end{aligned}\n$$" "Here the limits of the numerator and denominator are $\\lim_{x\\to (\\pi /2)^{-}}ln\\,(\\operatorname{sec}⁡x)=\\infty $ and $\\lim_{x\\to (\\pi /2)^{-}}ln\\,(\\operatorname{cot}⁡x)=-\\infty ,$ respectively, so we have the case $\\frac{\\infty }{-\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to (\\pi /2)^{-}}\\frac{ln\\,(\\operatorname{sec}⁡x)}{ln\\,(\\operatorname{cot}⁡x)} & =\\lim_{x\\to (\\pi /2)^{-}}\\frac{{[ln\\,(\\operatorname{sec}⁡x)]}^{′}}{{[ln\\,(\\operatorname{cot}⁡x)]}^{′}} \\\\  & =\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\left(\\frac{\\operatorname{sec}⁡x\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\right)}{\\left(-\\frac{{csc}^{2}⁡x}{\\operatorname{cot}⁡x}\\right)} \\\\  & =-\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\operatorname{cot}⁡x}{{csc}^{2}⁡x} \\\\  & =-\\lim_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\frac{1}{\\operatorname{tan}⁡x}}{\\frac{1}{{sin}^{2}⁡x}} \\\\  & =-\\lim_{x\\to (\\pi /2)^{-}}{sin}^{2}⁡x \\\\  & =-1.\\end{aligned}\n$$"] [:db/cas 17592186311761 :question/worked-solution "Note that plugging in $x=1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{5{x}^{3}+6{x}^{2}-11}{4{x}^{3}-4} & ={lim}_{x\\to 1}\\frac{[5{x}^{3}+6{x}^{2}-11]^{′}}{[4{x}^{3}-4]^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{15{x}^{2}+12x}{12{x}^{2}} \\\\  & =\\frac{15(1)^{2}+12(1)}{12(1)^{2}} \\\\  & =\\frac{15+12}{12} \\\\  & =\\frac{9}{4}\\end{aligned}\n$$" "Note that plugging in $x=1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 1}\\frac{5{x}^{3}+6{x}^{2}-11}{4{x}^{3}-4} & =\\lim_{x\\to 1}\\frac{[5{x}^{3}+6{x}^{2}-11]^{′}}{[4{x}^{3}-4]^{′}} \\\\  & =\\lim_{x\\to 1}\\frac{15{x}^{2}+12x}{12{x}^{2}} \\\\  & =\\frac{15(1)^{2}+12(1)}{12(1)^{2}} \\\\  & =\\frac{15+12}{12} \\\\  & =\\frac{9}{4}\\end{aligned}\n$$"] [:db/cas 17592186311762 :question/worked-solution "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{{x}^{2}-4x} & ={lim}_{x\\to 0}\\frac{[\\operatorname{sin}⁡x]^{′}}{[{x}^{2}-4x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{\\operatorname{cos}⁡x}{2x-4} \\\\  & =\\frac{\\operatorname{cos}⁡(0)}{2(0)-4} \\\\  & =\\frac{1}{0-4} \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$" "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{{x}^{2}-4x} & =\\lim_{x\\to 0}\\frac{[\\operatorname{sin}⁡x]^{′}}{[{x}^{2}-4x]^{′}} \\\\  & =\\lim_{x\\to 0}\\frac{\\operatorname{cos}⁡x}{2x-4} \\\\  & =\\frac{\\operatorname{cos}⁡(0)}{2(0)-4} \\\\  & =\\frac{1}{0-4} \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$"] [:db/cas 17592186311763 :question/worked-solution "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{2x}-1}{{x}^{2}+3x} & ={lim}_{x\\to 0}\\frac{[{e}^{2x}-1]^{′}}{[{x}^{2}+3x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{2{e}^{2x}}{2x+3} \\\\  & =\\frac{2{e}^{2(0)}}{2(0)+3} \\\\  & =\\frac{2(1)}{0+3} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$" "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{{e}^{2x}-1}{{x}^{2}+3x} & =\\lim_{x\\to 0}\\frac{[{e}^{2x}-1]^{′}}{[{x}^{2}+3x]^{′}} \\\\  & =\\lim_{x\\to 0}\\frac{2{e}^{2x}}{2x+3} \\\\  & =\\frac{2{e}^{2(0)}}{2(0)+3} \\\\  & =\\frac{2(1)}{0+3} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"] [:db/cas 17592186311764 :question/worked-solution "First, we note that\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(4{x}^{13}) & ={lim}_{x\\to -\\infty }(4\\cdot {x}^{13}) \\\\  & =4\\cdot {lim}_{x\\to -\\infty }{x}^{13}.\\end{aligned}\n$$\n\nThe graph $y={x}^{13}$ is power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{13}=-\\infty .\n$$\n\nMultiplication by the positive constant $4$ does not affect the limit at infinity. So, we have\n\n$$\n\\begin{aligned}4\\cdot {lim}_{x\\to -\\infty }{x}^{13}={lim}_{x\\to -\\infty }{x}^{13}=-\\infty .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }(4{x}^{13})=-\\infty .\n$$" "First, we note that\n\n$$\n\\begin{aligned}\\lim_{x\\to -\\infty }(4{x}^{13}) & =\\lim_{x\\to -\\infty }(4\\cdot {x}^{13}) \\\\  & =4\\cdot {lim}_{x\\to -\\infty }{x}^{13}.\\end{aligned}\n$$\n\nThe graph $y={x}^{13}$ is power function with an odd positive power and therefore has the property that\n\n$$\n\\lim_{x\\to -\\infty }{x}^{13}=-\\infty .\n$$\n\nMultiplication by the positive constant $4$ does not affect the limit at infinity. So, we have\n\n$$\n\\begin{aligned}4\\cdot {lim}_{x\\to -\\infty }{x}^{13}=\\lim_{x\\to -\\infty }{x}^{13}=-\\infty .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\lim_{x\\to -\\infty }(4{x}^{13})=-\\infty .\n$$"] [:db/cas 17592186311765 :question/worked-solution "First, we note that\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-6{x}^{7}) & ={lim}_{x\\to -\\infty }(-6\\cdot {x}^{7}) \\\\  & =-6\\cdot {lim}_{x\\to -\\infty }{x}^{7}.\\end{aligned}\n$$\n\nThe graph $y={x}^{7}$ is a power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{7}=-\\infty .\n$$\n\nMultiplication by the negative constant $-6$ changes the sign of the limit. So, we have\n\n$$\n\\begin{aligned}-6\\cdot {lim}_{x\\to -\\infty }{x}^{7} & =-{lim}_{x\\to -\\infty }{x}^{7}=\\infty . & \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }(-6{x}^{7})=\\infty .\n$$" "First, we note that\n\n$$\n\\begin{aligned}\\lim_{x\\to -\\infty }(-6{x}^{7}) & =\\lim_{x\\to -\\infty }(-6\\cdot {x}^{7}) \\\\  & =-6\\cdot {lim}_{x\\to -\\infty }{x}^{7}.\\end{aligned}\n$$\n\nThe graph $y={x}^{7}$ is a power function with an odd positive power and therefore has the property that\n\n$$\n\\lim_{x\\to -\\infty }{x}^{7}=-\\infty .\n$$\n\nMultiplication by the negative constant $-6$ changes the sign of the limit. So, we have\n\n$$\n\\begin{aligned}-6\\cdot {lim}_{x\\to -\\infty }{x}^{7} & =-\\lim_{x\\to -\\infty }{x}^{7}=\\infty . & \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\lim_{x\\to -\\infty }(-6{x}^{7})=\\infty .\n$$"] [:db/cas 17592186311766 :question/worked-solution "If we plug in $x=3$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{({x}^{2}-5)^{2}-48x+128}{{x}^{2}-6x+9} & ={lim}_{x\\to 3}\\frac{{[({x}^{2}-5)^{2}-48x+128]}^{′}}{[{x}^{2}-6x+9]^{′}} \\\\  & ={lim}_{x\\to 3}\\frac{4x({x}^{2}-5)-48}{2x-6} \\\\  & ={lim}_{x\\to 3}\\frac{2{x}^{3}-10x-24}{x-3}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{({x}^{2}-5)^{2}-48x+128}{{x}^{2}-6x+9} & ={lim}_{x\\to 3}\\frac{2{x}^{3}-10x-24}{x-3} \\\\  & ={lim}_{x\\to 3}\\frac{{[2{x}^{3}-10x-24]}^{′}}{{[x-3]}^{′}} \\\\  & ={lim}_{x\\to 3}\\frac{6{x}^{2}-10}{1} \\\\  & =6(3)^{2}-10 \\\\  & =44.\\end{aligned}\n$$" "If we plug in $x=3$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 3}\\frac{({x}^{2}-5)^{2}-48x+128}{{x}^{2}-6x+9} & =\\lim_{x\\to 3}\\frac{{[({x}^{2}-5)^{2}-48x+128]}^{′}}{[{x}^{2}-6x+9]^{′}} \\\\  & =\\lim_{x\\to 3}\\frac{4x({x}^{2}-5)-48}{2x-6} \\\\  & =\\lim_{x\\to 3}\\frac{2{x}^{3}-10x-24}{x-3}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 3}\\frac{({x}^{2}-5)^{2}-48x+128}{{x}^{2}-6x+9} & =\\lim_{x\\to 3}\\frac{2{x}^{3}-10x-24}{x-3} \\\\  & =\\lim_{x\\to 3}\\frac{{[2{x}^{3}-10x-24]}^{′}}{{[x-3]}^{′}} \\\\  & =\\lim_{x\\to 3}\\frac{6{x}^{2}-10}{1} \\\\  & =6(3)^{2}-10 \\\\  & =44.\\end{aligned}\n$$"] [:db/cas 17592186311767 :question/worked-solution "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{x}^{2}-2x+1}{({x}^{2}-9)^{2}+32x-96} & ={lim}_{x\\to 1}\\frac{{[{x}^{2}-2x+1]}^{′}}{{[({x}^{2}-9)^{2}+32x-96]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{2x-2}{4x({x}^{2}-9)+32} \\\\  & ={lim}_{x\\to 1}\\frac{x-1}{2{x}^{3}-18x+16}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{x}^{2}-2x+1}{({x}^{2}-9)^{2}+32x-96} & ={lim}_{x\\to 1}\\frac{x-1}{2{x}^{3}-18x+16} \\\\  & ={lim}_{x\\to 1}\\frac{{[x-1]}^{′}}{{[2{x}^{3}-18x+16]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{1}{6{x}^{2}-18} \\\\  & =\\frac{1}{6(1)^{2}-18} \\\\  & =-\\frac{1}{12}.\\end{aligned}\n$$" "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 1}\\fr