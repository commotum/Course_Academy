) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot (3-0) \\\\  & =\\frac{3}{\\operatorname{ln}⁡(4)}.\\end{aligned}\n$$" "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}3\\cdot {4}^{x}\\,\\text{d}x & =\\lim_{a\\to -\\infty }{\\int }_{a}^{0}3\\cdot {4}^{x}\\,\\text{d}x \\\\  & =\\lim_{a\\to -\\infty }{[\\frac{3\\cdot {4}^{x}}{\\operatorname{ln}⁡(4)}]}_{a}^{0} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot {lim}_{a\\to -\\infty }{[3\\cdot {4}^{x}]}_{a}^{0} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot {lim}_{a\\to -\\infty }(3-3\\cdot {4}^{a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot (3-\\lim_{a\\to -\\infty }3\\cdot {4}^{a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={4}^{x}$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }{4}^{x}=0$\n\n- $\\lim_{x\\to \\infty }{4}^{x}=\\infty $\n\n![](images/fd/fd4020291b348d130fc34969d72ff683aab5b6fb95ea5f7d32b90e5245d56d9c.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}3\\cdot {4}^{x}\\,\\text{d}x & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot (3-\\lim_{a\\to -\\infty }3\\cdot {4}^{a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot (3-0) \\\\  & =\\frac{3}{\\operatorname{ln}⁡(4)}.\\end{aligned}\n$$"] [:db/cas 17592186320831 :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int {b}^{\\,px+q}\\,\\text{d}x=\\frac{1}{p\\operatorname{ln}⁡(b)}{b}^{\\,px+q}+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{1}{2}^{3x-1}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{{2}^{3x}}{6\\operatorname{ln}⁡(2)}]}_{a}^{1} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot {lim}_{a\\to -\\infty }{[{2}^{3x}]}_{a}^{1} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot {lim}_{a\\to -\\infty }(8-{2}^{3a}) \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-{lim}_{a\\to -\\infty }{2}^{3a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={2}^{3x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{2}^{3x}=0$\n\n- ${lim}_{x\\to \\infty }{2}^{3x}=\\infty $\n\n![](images/c2/c2af905a46cea7b7512a727a5e53a2a178e4902f7114f86439365684e6685efa.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-{lim}_{a\\to -\\infty }{2}^{3a}) \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-0) \\\\  & =\\frac{4}{3\\operatorname{ln}⁡(2)}.\\end{aligned}\n$$" "First, let's recall the following result:\n\n$$\n\\int {b}^{\\,px+q}\\,\\text{d}x=\\frac{1}{p\\operatorname{ln}⁡(b)}{b}^{\\,px+q}+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x & =\\lim_{a\\to -\\infty }{\\int }_{a}^{1}{2}^{3x-1}\\,\\text{d}x \\\\  & =\\lim_{a\\to -\\infty }{[\\frac{{2}^{3x}}{6\\operatorname{ln}⁡(2)}]}_{a}^{1} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot {lim}_{a\\to -\\infty }{[{2}^{3x}]}_{a}^{1} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot {lim}_{a\\to -\\infty }(8-{2}^{3a}) \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-\\lim_{a\\to -\\infty }{2}^{3a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={2}^{3x}$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }{2}^{3x}=0$\n\n- $\\lim_{x\\to \\infty }{2}^{3x}=\\infty $\n\n![](images/c2/c2af905a46cea7b7512a727a5e53a2a178e4902f7114f86439365684e6685efa.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-\\lim_{a\\to -\\infty }{2}^{3a}) \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-0) \\\\  & =\\frac{4}{3\\operatorname{ln}⁡(2)}.\\end{aligned}\n$$"] [:db/cas 17592186320832 :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int {b}^{\\,px+q}\\,\\text{d}x=\\frac{1}{p\\operatorname{ln}⁡(b)}{b}^{\\,px+q}+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{5}^{x+1}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}{5}^{x+1}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{5\\cdot {5}^{x}}{\\operatorname{ln}⁡(5)}]}_{a}^{0} \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot {lim}_{a\\to -\\infty }{[{5}^{x}]}_{a}^{0} \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot {lim}_{a\\to -\\infty }(1-{5}^{a}) \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot (1-{lim}_{a\\to -\\infty }{5}^{a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={5}^{x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{5}^{x}=0$\n\n- ${lim}_{x\\to \\infty }{5}^{x}=\\infty $\n\n![](images/2f/2fc15149d2097a1965e575e725b4dfb49401c1fe5bb1c5b3e43bf0f4f51743a1.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{5}^{x+1}\\,\\text{d}x & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot (1-{lim}_{a\\to -\\infty }{5}^{a}) \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot (1-0) \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}.\\end{aligned}\n$$" "First, let's recall the following result:\n\n$$\n\\int {b}^{\\,px+q}\\,\\text{d}x=\\frac{1}{p\\operatorname{ln}⁡(b)}{b}^{\\,px+q}+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{5}^{x+1}\\,\\text{d}x & =\\lim_{a\\to -\\infty }{\\int }_{a}^{0}{5}^{x+1}\\,\\text{d}x \\\\  & =\\lim_{a\\to -\\infty }{[\\frac{5\\cdot {5}^{x}}{\\operatorname{ln}⁡(5)}]}_{a}^{0} \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot {lim}_{a\\to -\\infty }{[{5}^{x}]}_{a}^{0} \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot {lim}_{a\\to -\\infty }(1-{5}^{a}) \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot (1-\\lim_{a\\to -\\infty }{5}^{a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={5}^{x}$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }{5}^{x}=0$\n\n- $\\lim_{x\\to \\infty }{5}^{x}=\\infty $\n\n![](images/2f/2fc15149d2097a1965e575e725b4dfb49401c1fe5bb1c5b3e43bf0f4f51743a1.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{5}^{x+1}\\,\\text{d}x & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot (1-\\lim_{a\\to -\\infty }{5}^{a}) \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}\\cdot (1-0) \\\\  & =\\frac{5}{\\operatorname{ln}⁡(5)}.\\end{aligned}\n$$"] [:db/cas 17592186320833 :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int {b}^{\\,px+q}\\,\\text{d}x=\\frac{1}{p\\operatorname{ln}⁡(b)}{b}^{\\,px+q}+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{3}^{2x+2}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}{3}^{2x+2}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{9\\cdot {3}^{2x}}{2\\operatorname{ln}⁡(3)}]}_{a}^{0} \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot {lim}_{a\\to -\\infty }{[{3}^{2x}]}_{a}^{0} \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot {lim}_{a\\to -\\infty }(1-{3}^{2a}) \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot (1-{lim}_{a\\to -\\infty }{3}^{2a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={3}^{2x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{3}^{2x}=0$\n\n- ${lim}_{x\\to \\infty }{3}^{2x}=\\infty $\n\n![](images/05/052e461c4f02a644254b4b9936b688c29afacd07432db7234bd71474dc9a076c.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{3}^{2x+2}\\,\\text{d}x & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot (1-{lim}_{a\\to -\\infty }{3}^{2a}) \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot (1-0) \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$" "First, let's recall the following result:\n\n$$\n\\int {b}^{\\,px+q}\\,\\text{d}x=\\frac{1}{p\\operatorname{ln}⁡(b)}{b}^{\\,px+q}+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{3}^{2x+2}\\,\\text{d}x & =\\lim_{a\\to -\\infty }{\\int }_{a}^{0}{3}^{2x+2}\\,\\text{d}x \\\\  & =\\lim_{a\\to -\\infty }{[\\frac{9\\cdot {3}^{2x}}{2\\operatorname{ln}⁡(3)}]}_{a}^{0} \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot {lim}_{a\\to -\\infty }{[{3}^{2x}]}_{a}^{0} \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot {lim}_{a\\to -\\infty }(1-{3}^{2a}) \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot (1-\\lim_{a\\to -\\infty }{3}^{2a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={3}^{2x}$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }{3}^{2x}=0$\n\n- $\\lim_{x\\to \\infty }{3}^{2x}=\\infty $\n\n![](images/05/052e461c4f02a644254b4b9936b688c29afacd07432db7234bd71474dc9a076c.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{3}^{2x+2}\\,\\text{d}x & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot (1-\\lim_{a\\to -\\infty }{3}^{2a}) \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}\\cdot (1-0) \\\\  & =\\frac{9}{2\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"] [:db/cas 17592186320853 :question/worked-solution "First, let's rewrite the integral using a substitution. Let $u=\\operatorname{sin}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x\\,⟹\\,\\operatorname{cos}⁡x\\,\\text{d}x=\\text{d}u.\n$$\n\nWe use the table below to change the limits:\n\n| $x$ | $0$ | $\\frac{\\pi }{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nCarrying out the change of variable, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{\\sqrt[5]{\\operatorname{sin}⁡x}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{1}{\\sqrt[5]{u}}\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}{u}^{-1/5}\\,\\text{d}u.\\end{aligned}\n$$\n\nThis is an improper integral of the second kind because the function under the integral is unbounded at the *lower* limit of integration.\n\n$$\nf(u)={u}^{-1/5}\\to \\infty \\,\\text{ as }\\,u\\to {0}^{+}.\n$$\n\nNonetheless, it is possible to calculate the integral by setting the *lower* bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to {0}^{+}.$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{u}^{-1/5}\\,\\text{d}u & ={lim}_{a\\to {0}^{+}}{\\int }_{a}^{1}{u}^{-1/5}\\,\\text{d}u \\\\  & ={lim}_{a\\to {0}^{+}}{\\frac{5}{4}{u}^{4/5}|}_{a}^{1} \\\\  & ={lim}_{a\\to {0}^{+}}[\\frac{5}{4}\\cdot {1}^{4/5}-\\frac{5}{4}\\cdot {a}^{4/5}] \\\\  & =\\frac{5}{4}-0 \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{\\sqrt[5]{\\operatorname{sin}⁡x}}\\,\\text{d}x=\\frac{5}{4}.\n$$" "First, let's rewrite the integral using a substitution. Let $u=\\operatorname{sin}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x\\,⟹\\,\\operatorname{cos}⁡x\\,\\text{d}x=\\text{d}u.\n$$\n\nWe use the table below to change the limits:\n\n| $x$ | $0$ | $\\frac{\\pi }{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nCarrying out the change of variable, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{\\sqrt[5]{\\operatorname{sin}⁡x}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{1}{\\sqrt[5]{u}}\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}{u}^{-1/5}\\,\\text{d}u.\\end{aligned}\n$$\n\nThis is an improper integral of the second kind because the function under the integral is unbounded at the *lower* limit of integration.\n\n$$\nf(u)={u}^{-1/5}\\to \\infty \\,\\text{ as }\\,u\\to {0}^{+}.\n$$\n\nNonetheless, it is possible to calculate the integral by setting the *lower* bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to {0}^{+}.$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{u}^{-1/5}\\,\\text{d}u & =\\lim_{a\\to {0}^{+}}{\\int }_{a}^{1}{u}^{-1/5}\\,\\text{d}u \\\\  & =\\lim_{a\\to {0}^{+}}{\\frac{5}{4}{u}^{4/5}|}_{a}^{1} \\\\  & =\\lim_{a\\to {0}^{+}}[\\frac{5}{4}\\cdot {1}^{4/5}-\\frac{5}{4}\\cdot {a}^{4/5}] \\\\  & =\\frac{5}{4}-0 \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{\\sqrt[5]{\\operatorname{sin}⁡x}}\\,\\text{d}x=\\frac{5}{4}.\n$$"] [:db/cas 17592186320859 :question/worked-solution "First, we substitute $u=\\sqrt{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\text{d}u=\\frac{1}{\\sqrt{x}}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\sqrt{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{6}^{-2u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{6}^{-2u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{6}^{-2u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{{6}^{-2u}}{2\\operatorname{ln}⁡6}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot {lim}_{a\\to \\infty }{[{6}^{-2u}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{6}^{2a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{6}^{2x}},$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\frac{1}{{6}^{2x}}=\\infty $\n\n- ${lim}_{x\\to \\infty }\\frac{1}{{6}^{2x}}=0$\n\n![](images/8f/8f732515dd376db40889706419781e02cbedfcd4da8513a09e4f2d77ff88ece2.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{6}^{2a}}-1) \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot (0-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡6}.\\end{aligned}\n$$" "First, we substitute $u=\\sqrt{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\text{d}u=\\frac{1}{\\sqrt{x}}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\sqrt{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{6}^{-2u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{6}^{-2u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{6}^{-2u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{{6}^{-2u}}{2\\operatorname{ln}⁡6}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot {lim}_{a\\to \\infty }{[{6}^{-2u}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{6}^{2a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{6}^{2x}},$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }\\frac{1}{{6}^{2x}}=\\infty $\n\n- $\\lim_{x\\to \\infty }\\frac{1}{{6}^{2x}}=0$\n\n![](images/8f/8f732515dd376db40889706419781e02cbedfcd4da8513a09e4f2d77ff88ece2.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{6}^{2a}}-1) \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot (0-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡6}.\\end{aligned}\n$$"] [:db/cas 17592186320860 :question/worked-solution "First, we substitute $u=\\sqrt{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\text{d}u=\\frac{1}{\\sqrt{x}}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\sqrt{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{e}^{-\\sqrt{3}u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{e}^{-\\sqrt{3}u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{-\\sqrt{3}u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{{e}^{-\\sqrt{3}u}}{\\sqrt{3}}]}_{0}^{a} \\\\  & =-\\frac{2}{\\sqrt{3}}\\cdot {lim}_{a\\to \\infty }{[{e}^{-\\sqrt{3}u}]}_{0}^{a} \\\\  & =-\\frac{2}{\\sqrt{3}}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{e}^{\\sqrt{3}a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{e}^{\\sqrt{3}x}},$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\frac{1}{{e}^{x}}=\\infty $\n\n- ${lim}_{x\\to \\infty }\\frac{1}{{e}^{x}}=0$\n\n![](images/1c/1c0fc31d392bbaccf9a292553321bd60ccbdb2a02f3675543797f570c4fa0ef1.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x & =-\\frac{2}{\\sqrt{3}}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{e}^{\\sqrt{3}a}}-1) \\\\  & =-\\frac{2}{\\sqrt{3}}\\cdot (0-1) \\\\  & =\\frac{2}{\\sqrt{3}} \\\\  & =\\frac{2\\sqrt{3}}{3}.\\end{aligned}\n$$" "First, we substitute $u=\\sqrt{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\text{d}u=\\frac{1}{\\sqrt{x}}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\sqrt{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{e}^{-\\sqrt{3}u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{e}^{-\\sqrt{3}u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{-\\sqrt{3}u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{{e}^{-\\sqrt{3}u}}{\\sqrt{3}}]}_{0}^{a} \\\\  & =-\\frac{2}{\\sqrt{3}}\\cdot {lim}_{a\\to \\infty }{[{e}^{-\\sqrt{3}u}]}_{0}^{a} \\\\  & =-\\frac{2}{\\sqrt{3}}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{e}^{\\sqrt{3}a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{e}^{\\sqrt{3}x}},$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }\\frac{1}{{e}^{x}}=\\infty $\n\n- $\\lim_{x\\to \\infty }\\frac{1}{{e}^{x}}=0$\n\n![](images/1c/1c0fc31d392bbaccf9a292553321bd60ccbdb2a02f3675543797f570c4fa0ef1.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x & =-\\frac{2}{\\sqrt{3}}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{e}^{\\sqrt{3}a}}-1) \\\\  & =-\\frac{2}{\\sqrt{3}}\\cdot (0-1) \\\\  & =\\frac{2}{\\sqrt{3}} \\\\  & =\\frac{2\\sqrt{3}}{3}.\\end{aligned}\n$$"] [:db/cas 17592186320862 :question/worked-solution "First, we substitute $u=\\operatorname{ln}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\operatorname{ln}⁡x$ is as follows:\n\n| $x$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & ={\\int }_{0}^{\\infty }{3}^{-u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & ={\\int }_{0}^{\\infty }{3}^{-u}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}{3}^{-u}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{{3}^{-u}}{\\operatorname{ln}⁡3}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot {lim}_{a\\to \\infty }{[{3}^{-u}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{3}^{a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{3}^{x}},$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\frac{1}{{3}^{x}}=\\infty $\n\n- ${lim}_{x\\to \\infty }\\frac{1}{{3}^{x}}=0$\n\n![](images/fa/fac2eaeb6dfdda240d2bad7107f7a7e26ff688e89976437a95b99bc3f2ac288f.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{3}^{a}}-1) \\\\  & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot (0-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}.\\end{aligned}\n$$" "First, we substitute $u=\\operatorname{ln}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\operatorname{ln}⁡x$ is as follows:\n\n| $x$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & ={\\int }_{0}^{\\infty }{3}^{-u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & ={\\int }_{0}^{\\infty }{3}^{-u}\\,\\text{d}u \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{3}^{-u}\\,\\text{d}u \\\\  & =\\lim_{a\\to \\infty }{[-\\frac{{3}^{-u}}{\\operatorname{ln}⁡3}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot {lim}_{a\\to \\infty }{[{3}^{-u}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{3}^{a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{3}^{x}},$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }\\frac{1}{{3}^{x}}=\\infty $\n\n- $\\lim_{x\\to \\infty }\\frac{1}{{3}^{x}}=0$\n\n![](images/fa/fac2eaeb6dfdda240d2bad7107f7a7e26ff688e89976437a95b99bc3f2ac288f.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{3}^{a}}-1) \\\\  & =-\\frac{1}{\\operatorname{ln}⁡3}\\cdot (0-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}.\\end{aligned}\n$$"] [:db/cas 17592186320863 :question/worked-solution "First, we substitute $u=\\operatorname{ln}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\operatorname{ln}⁡x$ is as follows:\n\n| $x$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }\\frac{1}{{4}^{u}}\\,\\text{d}u={\\int }_{0}^{\\infty }{4}^{-u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }{4}^{-u}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}{4}^{-u}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{{4}^{-u}}{\\operatorname{ln}⁡4}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot {lim}_{a\\to \\infty }{[{4}^{-u}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{4}^{a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{4}^{x}},$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\frac{1}{{4}^{x}}=\\infty $\n\n- ${lim}_{x\\to \\infty }\\frac{1}{{4}^{x}}=0$\n\n![](images/e5/e50ca6e9326f5a6146a7a486adcc2d3d5f5c059eae3e2e1b06fbff8664b1c7df.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{4}^{a}}-1) \\\\  & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot (0-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}.\\end{aligned}\n$$" "First, we substitute $u=\\operatorname{ln}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\operatorname{ln}⁡x$ is as follows:\n\n| $x$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }\\frac{1}{{4}^{u}}\\,\\text{d}u={\\int }_{0}^{\\infty }{4}^{-u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }{4}^{-u}\\,\\text{d}u \\\\  & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}{4}^{-u}\\,\\text{d}u \\\\  & =\\lim_{a\\to \\infty }{[-\\frac{{4}^{-u}}{\\operatorname{ln}⁡4}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot {lim}_{a\\to \\infty }{[{4}^{-u}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{4}^{a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{4}^{x}},$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }\\frac{1}{{4}^{x}}=\\infty $\n\n- $\\lim_{x\\to \\infty }\\frac{1}{{4}^{x}}=0$\n\n![](images/e5/e50ca6e9326f5a6146a7a486adcc2d3d5f5c059eae3e2e1b06fbff8664b1c7df.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{4}^{a}}-1) \\\\  & =-\\frac{1}{\\operatorname{ln}⁡4}\\cdot (0-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}.\\end{aligned}\n$$"] [:db/cas 17592186320864 :question/worked-solution "First, we substitute $u=\\frac{1}{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\frac{1}{{x}^{2}}\\,⟹\\,-\\text{d}u=\\frac{1}{{x}^{2}}\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to {0}^{-}$ and $u\\to 0$ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=\\frac{1}{x}$ is as follows:\n\n| $x$ | $0$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $0$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x=-{\\int }_{0}^{-\\infty }{e}^{3u}\\,\\text{d}u={\\int }_{-\\infty }^{0}{e}^{3u}\\,\\text{d}u.\n$$\n\nNow, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}{e}^{3u}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{{e}^{3u}}{3}]}_{a}^{0} \\\\  & =\\frac{1}{3}{lim}_{a\\to -\\infty }(1-{e}^{3a}) \\\\  & =\\frac{1}{3}(1-{lim}_{a\\to -\\infty }{e}^{3a})\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y={e}^{3x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{e}^{3x}=0$\n\n- ${lim}_{x\\to \\infty }{e}^{3x}=\\infty $\n\n![](images/34/34abda46dc9fc2c6f14ce4f8460ba076a16004bb9141eb8074cdc08e0c12fd2f.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x & =\\frac{1}{3}(1-{lim}_{a\\to -\\infty }{e}^{3a}) \\\\  & =\\frac{1}{3}(1-0) \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" "First, we substitute $u=\\frac{1}{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\frac{1}{{x}^{2}}\\,⟹\\,-\\text{d}u=\\frac{1}{{x}^{2}}\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to {0}^{-}$ and $u\\to 0$ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=\\frac{1}{x}$ is as follows:\n\n| $x$ | $0$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $0$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x=-{\\int }_{0}^{-\\infty }{e}^{3u}\\,\\text{d}u={\\int }_{-\\infty }^{0}{e}^{3u}\\,\\text{d}u.\n$$\n\nNow, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x & =\\lim_{a\\to -\\infty }{\\int }_{a}^{0}{e}^{3u}\\,\\text{d}u \\\\  & =\\lim_{a\\to -\\infty }{[\\frac{{e}^{3u}}{3}]}_{a}^{0} \\\\  & =\\frac{1}{3}\\lim_{a\\to -\\infty }(1-{e}^{3a}) \\\\  & =\\frac{1}{3}(1-\\lim_{a\\to -\\infty }{e}^{3a})\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y={e}^{3x}$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }{e}^{3x}=0$\n\n- $\\lim_{x\\to \\infty }{e}^{3x}=\\infty $\n\n![](images/34/34abda46dc9fc2c6f14ce4f8460ba076a16004bb9141eb8074cdc08e0c12fd2f.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x & =\\frac{1}{3}(1-\\lim_{a\\to -\\infty }{e}^{3a}) \\\\  & =\\frac{1}{