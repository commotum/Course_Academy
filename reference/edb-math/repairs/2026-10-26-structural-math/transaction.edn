\\operatorname{cos}⁡(x))}^{2}}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x)\\cdot 4{sin}^{2}⁡(x){cos}^{2}⁡(x)}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{4{cos}^{3}⁡(x)\\cancel{{sin}^{2}⁡(x)}}{2\\cancel{{sin}^{2}⁡(x)}} \\\\  & ={lim}_{x\\to {0}^{+}}2{cos}^{3}⁡(x) \\\\  & =2{cos}^{3}⁡(0) \\\\  & =2\\cdot 1 \\\\  & =2.\\end{aligned}\n$$" "Here the limits of the numerator and denominator are $\\lim_{x\\to {0}^{+}}\\operatorname{csc}⁡(x)=\\infty $ and $\\lim_{x\\to {0}^{+}}\\operatorname{cot}⁡(2x)=\\infty ,$ respectively, so we have the indeterminate form $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)}{\\operatorname{cot}⁡(2x)} & =\\lim_{x\\to {0}^{+}}\\frac{[\\operatorname{csc}⁡(x)]^{′}}{[\\operatorname{cot}⁡(2x)]^{′}} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{-\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{-2{csc}^{2}⁡(2x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{2{csc}^{2}⁡(2x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\left(\\frac{1}{\\operatorname{sin}⁡(x)}\\right)\\left(\\frac{\\operatorname{cos}⁡(x)}{\\operatorname{sin}⁡(x)}\\right)}{2\\left(\\frac{1}{{sin}^{2}⁡(2x)}\\right)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){sin}^{2}⁡(2x)}{2{sin}^{2}⁡(x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){(2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x))}^{2}}{2{sin}^{2}⁡(x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x)\\cdot 4{sin}^{2}⁡(x){cos}^{2}⁡(x)}{2{sin}^{2}⁡(x)} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{4{cos}^{3}⁡(x)\\cancel{{sin}^{2}⁡(x)}}{2\\cancel{{sin}^{2}⁡(x)}} \\\\  & =\\lim_{x\\to {0}^{+}}2{cos}^{3}⁡(x) \\\\  & =2{cos}^{3}⁡(0) \\\\  & =2\\cdot 1 \\\\  & =2.\\end{aligned}\n$$"] [:db/cas 17592186311752 :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}{e}^{3/{x}^{2}}=\\infty $ and ${lim}_{x\\