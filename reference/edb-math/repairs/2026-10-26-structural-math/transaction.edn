5|+\\frac{3}{x+5}+\\operatorname{ln}|x+4|+C"] [:db/cas 17592186067484 :answer/value "\\ln\\begin{vmatrix}x + 5 & + \\frac{2}{x + 5} - 3\\ln & x + 4\\end{vmatrix}+ C" "\\operatorname{ln}|x+5|+\\frac{2}{x+5}-3\\operatorname{ln}|x+4|+C"] [:db/cas 17592186067485 :answer/value "\\ln\\begin{vmatrix}x + 4 & -\\frac{2}{x + 5} - 3\\ln & x + 5\\end{vmatrix}+ C" "\\operatorname{ln}|x+4|-\\frac{2}{x+5}-3\\operatorname{ln}|x+5|+C"] [:db/cas 17592186067547 :answer/value "5\\ln\\begin{vmatrix}x & -\\frac{1}{5}\\ln & x - 1\\end{vmatrix}+ C" "5\\operatorname{ln}|x|-\\frac{1}{5}\\operatorname{ln}|x-1|+C"] [:db/cas 17592186067548 :answer/value "\\ln\\begin{vmatrix}x & -\\frac{1}{5}\\ln & x - 1\\end{vmatrix}+ C" "\\operatorname{ln}|x|-\\frac{1}{5}\\operatorname{ln}|x-1|+C"] [:db/cas 17592186067549 :answer/value "\\ln\\begin{vmatrix}x & -5\\ln & x - 1\\end{vmatrix}+ C" "\\ln|x | -5\\ln | x - 1|+ C"] [:db/cas 17592186067550 :answer/value "5\\ln\\begin{vmatrix}x & -\\ln & x - 1\\end{vmatrix}+ C" "5\\ln|x | -\\ln | x - 1|+ C"] [:db/cas 17592186067551 :answer/value "5\\ln\\begin{vmatrix}x & -5\\ln & x - 1\\end{vmatrix}+ C" "5\\operatorname{ln}|x|-5\\operatorname{ln}|x-1|+C"] [:db/cas 17592186068428 :question/problem "Find $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,-1}f(x)\n$$ for the function $f(x)$ whose graph is shown below.\n\n![](images/ee/eead78a813f820cf12cbd05bd22b230b1753c7e4ebe1e77d2c1eb6b61c11f4ed.png)" "Find $$\n\\displaystyle \\lim_{x\\rightarrow \\,-1}f(x)\n$$ for the function $f(x)$ whose graph is shown below.\n\n![](images/ee/eead78a813f820cf12cbd05bd22b230b1753c7e4ebe1e77d2c1eb6b61c11f4ed.png)"] [:db/cas 17592186068428 :question/worked-solution "As $x$ approaches $-1,$ the value of $f(x)$ approaches $2.$ Consequently, \n\n$$\n\\lim_\\limits{x\\rightarrow \\,-1}f(x)=2\\,.\n$$" "As $x$ approaches $-1,$ the value of $f(x)$ approaches $2.$ Consequently, \n\n$$\n\\lim_{x\\rightarrow \\,-1}f(x)=2\\,.\n$$"] [:db/cas 17592186068471 :question/worked-solution "To simplify the expression, we first factor the numerator and denominator under the radical:\n\n$$\n\\begin{aligned}\n\\sqrt{\\frac{x^{2} - 4x + 4}{x^{2} + 6x + 9}} &= \\sqrt{(x^{2} + 2 \\cdot x \\cdot (-2) + (-2)^{2})/(x^{2} + 2 \\cdot x \\cdot 3 + 3^{2})} \\\\\n&= \\sqrt{((x - 2)^{2})/((x + 3)^{2})}\n\\end{aligned}\n$$\n\nThen, by applying the quotient rule for radicals and the rules of absolute value, we get\n\n$$\n\\begin{aligned}\n\\sqrt{((x - 2)^{2})/((x + 3)^{2})} &= (\\sqrt{(x - 2)^{2}})/(\\sqrt{(x + 3)^{2}}) \\\\\n&= \\frac{\\begin{vmatrix}x - 2 &}{\\mid x + 3 \\mid} \\\\ = & \\frac{x - 2}{x + 3}\\end{vmatrix}\n\\end{aligned}\n$$" "To simplify the expression, we first factor the numerator and denominator under the radical:\n\n$$\n\\begin{aligned}\n\\sqrt{\\frac{x^{2} - 4x + 4}{x^{2} + 6x + 9}} &= \\sqrt{(x^{2} + 2 \\cdot x \\cdot (-2) + (-2)^{2})/(x^{2} + 2 \\cdot x \\cdot 3 + 3^{2})} \\\\\n&= \\sqrt{((x - 2)^{2})/((x + 3)^{2})}\n\\end{aligned}\n$$\n\nThen, by applying the quotient rule for radicals and the rules of absolute value, we get\n\n$$\n\\begin{aligned}\\sqrt{\\frac{(x-2)^{2}}{(x+3)^{2}}} & =\\frac{\\sqrt{(x-2)^{2}}}{\\sqrt{(x+3)^{2}}} \\\\  & =\\frac{|x-2|}{|x+3|} \\\\  & =|\\frac{x-2}{x+3}|.\\end{aligned}\n$$"] [:db/cas 17592186068485 :question/worked-solution "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}\n4z^{2} - 25 &= 0 \\\\\n(2z)^{2} - (5)^{2} &= 0 \\\\\n(2z - 5)(2z + 5) &= 0\n\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2z-5=0 \\qquad\\text{or}\\qquad 2z+5=0\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}2z - 5 &= 0 & 2z + 5|= 0 \\\\ 2z|= 5 & 2z|=-5 \\\\ z|= \\frac{5}{2} & z|=-\\frac{5}{2}\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nz = -\\dfrac 5 2, \\dfrac 5 2\n$$\n\nWe can write this even more concisely as\n\n$$\nz=\\pm \\dfrac 5 2\n$$" "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}\n4z^{2} - 25 &= 0 \\\\\n(2z)^{2} - (5)^{2} &= 0 \\\\\n(2z - 5)(2z + 5) &= 0\n\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2z-5=0 \\qquad\\text{or}\\qquad 2z+5=0\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}2z-5 & =0 & \\hspace{2em} & \\hspace{2em} & 2z+5 & =0 \\\\ 2z & =5 & \\hspace{2em} & \\hspace{2em} & 2z & =-5 \\\\ z & =\\frac{5}{2} & \\hspace{2em} & \\hspace{2em} & z & =-\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nz = -\\dfrac 5 2, \\dfrac 5 2\n$$\n\nWe can write this even more concisely as\n\n$$\nz=\\pm \\dfrac 5 2\n$$"] [:db/cas 17592186068533 :question/problem "Find $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0} f(x)\n$$ for the function below.\n\n![](images/c0/c0ed78e2e640611d70263e17a76eb4a13e9e2816efba02494b53e540d38065d6.png)" "Find $$\n\\displaystyle \\lim_{x\\rightarrow \\,0} f(x)\n$$ for the function below.\n\n![](images/c0/c0ed78e2e640611d70263e17a76eb4a13e9e2816efba02494b53e540d38065d6.png)"] [:db/cas 17592186068533 :question/worked-solution "As $x$ approaches $0,$ the value of $f(x)$ approaches $1.$ Consequently, \n\n$$\n\\lim_\\limits{x\\rightarrow \\,0}f(x)= 1\\,.\n$$\n\nRemember, it does not matter that the actual value of $f(0)$ is $2.$ All that matters is that as $x$ approaches $0,$ the function $f(x)$ *looks like* it is getting closer and closer to $1$." "As $x$ approaches $0,$ the value of $f(x)$ approaches $1.$ Consequently, \n\n$$\n\\lim_{x\\rightarrow \\,0}f(x)= 1\\,.\n$$\n\nRemember, it does not matter that the actual value of $f(0)$ is $2.$ All that matters is that as $x$ approaches $0,$ the function $f(x)$ *looks like* it is getting closer and closer to $1$."] [:db/cas 17592186068534 :question/problem "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below? \n\nI. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0}f(x)=0\n$$\n\nII. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,3}f(x)=0\n$$\n\nIII. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,-1}f(x)=\\lim_\\limits{x\\rightarrow \\,1}f(x)\n$$\n\n![](images/68/68241f3cd913cd91d10765499dc4ce4398fb3e8a81ec4bcfb65b47c0d77731d6.png)" "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below? \n\nI. $$\n\\displaystyle \\lim_{x\\rightarrow \\,0}f(x)=0\n$$\n\nII. $$\n\\displaystyle \\lim_{x\\rightarrow \\,3}f(x)=0\n$$\n\nIII. $$\n\\displaystyle \\lim_{x\\rightarrow \\,-1}f(x)=\\lim_{x\\rightarrow \\,1}f(x)\n$$\n\n![](images/68/68241f3cd913cd91d10765499dc4ce4398fb3e8a81ec4bcfb65b47c0d77731d6.png)"] [:db/cas 17592186068534 :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. As $x$ approaches $0,$ the function $f(x)$ approaches the value $y=-1.$ Consequently, \n\n$$\n\\lim_\\limits{x\\rightarrow \\,0}f(x)=-1.\n$$\n\n- Statement II is true. As $x$ approaches $3,$ the function $f(x)$ approaches the value $y=0.$ Consequently,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,3}f(x)=0.\n$$\n\n- Statement III is false. As $x$ approaches $-1$ the function $f(x)$ approaches the value $y=2,$ and consequently\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-1}f(x)=2.\n$$\n\nSimiliarly, as $x$ approaches $1,$ the function $f(x)$ approaches the value $y=-2,$ and consequently\n\n$$\n\\lim_\\limits{x\\rightarrow \\,1}f(x)=-2.\n$$\n\nAs a result,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-1}f(x)\\ne\\lim_\\limits{x\\rightarrow \\,1}f(x).\n$$\n\nIn conclusion, only statement II is true." "Let's analyze each statement in turn.\n\n- Statement I is false. As $x$ approaches $0,$ the function $f(x)$ approaches the value $y=-1.$ Consequently, \n\n$$\n\\lim_{x\\rightarrow \\,0}f(x)=-1.\n$$\n\n- Statement II is true. As $x$ approaches $3,$ the function $f(x)$ approaches the value $y=0.$ Consequently,\n\n$$\n\\lim_{x\\rightarrow \\,3}f(x)=0.\n$$\n\n- Statement III is false. As $x$ approaches $-1$ the function $f(x)$ approaches the value $y=2,$ and consequently\n\n$$\n\\lim_{x\\rightarrow \\,-1}f(x)=2.\n$$\n\nSimiliarly, as $x$ approaches $1,$ the function $f(x)$ approaches the value $y=-2,$ and consequently\n\n$$\n\\lim_{x\\rightarrow \\,1}f(x)=-2.\n$$\n\nAs a result,\n\n$$\n\\lim_{x\\rightarrow \\,-1}f(x)\\ne\\lim_{x\\rightarrow \\,1}f(x).\n$$\n\nIn conclusion, only statement II is true."] [:db/cas 17592186068546 :question/worked-solution "As $x$ approaches $0$ from the *left*, the function $f(x)$ approaches $1.$ Therefore,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{-}}f(x) = 1 \\, .\n$$\n\nLikewise, as $x$ approaches $0$ from the *right*, the function $f(x)$ approaches $1.$ Therefore,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{+}}f(x) = 1 \\, .\n$$\n\nIn conclusion, we have\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{-}}f(x)=\\lim_\\limits{x\\rightarrow \\,0^{+}}f(x)=1 \\,.\n$$" "As $x$ approaches $0$ from the *left*, the function $f(x)$ approaches $1.$ Therefore,\n\n$$\n\\lim_{x\\rightarrow \\,0^{-}}f(x) = 1 \\, .\n$$\n\nLikewise, as $x$ approaches $0$ from the *right*, the function $f(x)$ approaches $1.$ Therefore,\n\n$$\n\\lim_{x\\rightarrow \\,0^{+}}f(x) = 1 \\, .\n$$\n\nIn conclusion, we have\n\n$$\n\\lim_{x\\rightarrow \\,0^{-}}f(x)=\\lim_{x\\rightarrow \\,0^{+}}f(x)=1 \\,.\n$$"] [:db/cas 17592186068549 :question/problem "![](images/18/1867a80955ae4b456cbcb011eefed96431f2b12926994942613eb947e55e38c6.png)\n\n \n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\nI. $f(x)$ is defined at $x=2$\n\nII. $\\lim_\\limits{x\\rightarrow \\, 2}f(x)$ exists\n\nIII. $f(x)$ is continuous at $x=2$" "![](images/18/1867a80955ae4b456cbcb011eefed96431f2b12926994942613eb947e55e38c6.png)\n\n \n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\nI. $f(x)$ is defined at $x=2$\n\nII. $\\lim_{x\\rightarrow \\, 2}f(x)$ exists\n\nIII. $f(x)$ is continuous at $x=2$"] [:db/cas 17592186068549 :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(2)=2.$\n\n- Statement II is false. From the graph, we can see that the left and right-sided limits are different:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{-}}f(x) & =2, \\\\ {lim}_{x\\to \\,{2}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nTherefore,  $\\lim_\\limits{x\\rightarrow \\, 2}f(x)$ does not exist.\n\n- Statement III is false.  The graph of the function breaks at $x=2.$ It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper. Therefore, $f(x)$ is not continuous at $x=2.$\n\nIn conclusion, only statement I is true." "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(2)=2.$\n\n- Statement II is false. From the graph, we can see that the left and right-sided limits are different:\n\n$$\n\\begin{aligned}\\lim_{x\\to \\,{2}^{-}}f(x) & =2, \\\\ \\lim_{x\\to \\,{2}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nTherefore,  $\\lim_{x\\rightarrow \\, 2}f(x)$ does not exist.\n\n- Statement III is false.  The graph of the function breaks at $x=2.$ It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper. Therefore, $f(x)$ is not continuous at $x=2.$\n\nIn conclusion, only statement I is true."] [:db/cas 17592186068551 :question/worked-solution "Since $f(x)$ is right-continuous at $x=3,$ we must have\n\n$$\n\\lim_{x\\to 3^+} f(x)=f(3)=1.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{+}}(f(x)-{x}^{2})=1-{3}^{2}=-8.\\end{aligned}\n$$" "Since $f(x)$ is right-continuous at $x=3,$ we must have\n\n$$\n\\lim_{x\\to 3^+} f(x)=f(3)=1.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}\\lim_{x\\to {3}^{+}}(f(x)-{x}^{2})=1-{3}^{2}=-8.\\end{aligned}\n$$"] [:db/cas 17592186068635 :question/problem "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below? \n\nI. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0^-}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)\n$$\n\nII. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)\n$$\n\nIII. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^-}f(x)\n$$\n\n![](images/1c/1c94c7d99009c46023556ce0f4f662f5a90ad315048099394016390552ade809.png)" "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below? \n\nI. $$\n\\displaystyle \\lim_{x\\rightarrow \\,0^-}f(x)=\\lim_{x\\rightarrow \\,1^+}f(x)\n$$\n\nII. $$\n\\displaystyle \\lim_{x\\rightarrow \\,0^+}f(x)=\\lim_{x\\rightarrow \\,1^+}f(x)\n$$\n\nIII. $$\n\\displaystyle \\lim_{x\\rightarrow \\,0^+}f(x)=\\lim_{x\\rightarrow \\,1^-}f(x)\n$$\n\n![](images/1c/1c94c7d99009c46023556ce0f4f662f5a90ad315048099394016390552ade809.png)"] [:db/cas 17592186068635 :question/worked-solution "First, let's compute the limits in question.\n\nLooking at the graph, as $x$ approaches $0$ from the left, the function value $f(x)$ approaches $0.$ However, as $x$ approaches $0$ from the right, the function value $f(x)$ is undefined. So we have\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^-}f(x)=0, \\qquad \\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\text{DNE} \\, .\n$$\n\nOn the other hand, as $x$ approaches $1$ from the left, the function value $f(x)$ is undefined, and as $x$ approaches $1$ from the right, the function value $f(x)$ approaches $0.$ So we have\n\n$$\n\\lim_\\limits{x\\rightarrow \\,1^-}f(x)=\\text{DNE}, \\qquad \\lim_\\limits{x\\rightarrow \\,1^+}f(x)=0 \\, .\n$$\n\nNow, let's look at each statement in turn.\n\nI. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0^-}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)\n$$ becomes $0=0,$ which is true.\n\nII. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)\n$$ becomes $\\text{DNE}=0,$ which is false.\n\nIII. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^-}f(x)\n$$ becomes $\\text{DNE}=\\text{DNE},$ which is false because we can't compare the undefined values.\n\nTherefore, only statement I is true." "First, let's compute the limits in question.\n\nLooking at the graph, as $x$ approaches $0$ from the left, the function value $f(x)$ approaches $0.$ However, as $x$ approaches $0$ from the right, the function value $f(x)$ is undefined. So we have\n\n$$\n\\lim_{x\\rightarrow \\,0^-}f(x)=0, \\qquad \\lim_{x\\rightarrow \\,0^+}f(x)=\\text{DNE} \\, .\n$$\n\nOn the other hand, as $x$ approaches $1$ from the left, the function value $f(x)$ is undefined, and as $x$ approaches $1$ from the right, the function value $f(x)$ approaches $0.$ So we have\n\n$$\n\\lim_{x\\rightarrow \\,1^-}f(x)=\\text{DNE}, \\qquad \\lim_{x\\rightarrow \\,1^+}f(x)=0 \\, .\n$$\n\nNow, let's look at each statement in turn.\n\nI. $$\n\\displaystyle \\lim_{x\\rightarrow \\,0^-}f(x)=\\lim_{x\\rightarrow \\,1^+}f(x)\n$$ becomes $0=0,$ which is true.\n\nII. $$\n\\displaystyle \\lim_{x\\rightarrow \\,0^+}f(x)=\\lim_{x\\rightarrow \\,1^+}f(x)\n$$ becomes $\\text{DNE}=0,$ which is false.\n\nIII. $$\n\\displaystyle \\lim_{x\\rightarrow \\,0^+}f(x)=\\lim_{x\\rightarrow \\,1^-}f(x)\n$$ becomes $\\text{DNE}=\\text{DNE},$ which is false because we can't compare the undefined values.\n\nTherefore, only statement I is true."] [:db/cas 17592186068649 :question/worked-solution "We see from the graph that, approaching $x=-2$ from the right, the function approaches the value $y=4$. However, we cannot approach $x=-2$ from the left, because the function is not defined left of $x=-2.$ Consequently,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-2^{-}}f(x)=\\text{DNE}\\,,\\quad\\lim_\\limits{x\\rightarrow \\,-2^{+}}f(x)=4 \\,.\n$$\n\nOn the other hand,  approaching $x=2$ from the left, the function approaches the value $y=2$. However, we cannot approach $x=2$ from the right, because the function is not defined right of $x=2.$ So we have\n\n$$\n\\lim_\\limits{x\\rightarrow 2^{-}}f(x)=2\\,,\\quad\\lim_\\limits{x\\rightarrow \\,2^{+}}f(x)=\\text{DNE} \\,.\n$$\n\n**Note:** Here, $\\text{DNE}$ is simply short for \"does not exist\"." "We see from the graph that, approaching $x=-2$ from the right, the function approaches the value $y=4$. However, we cannot approach $x=-2$ from the left, because the function is not defined left of $x=-2.$ Consequently,\n\n$$\n\\lim_{x\\rightarrow \\,-2^{-}}f(x)=\\text{DNE}\\,,\\quad\\lim_{x\\rightarrow \\,-2^{+}}f(x)=4 \\,.\n$$\n\nOn the other hand,  approaching $x=2$ from the left, the function approaches the value $y=2$. However, we cannot approach $x=2$ from the right, because the function is not defined right of $x=2.$ So we have\n\n$$\n\\lim_{x\\rightarrow 2^{-}}f(x)=2\\,,\\quad\\lim_{x\\rightarrow \\,2^{+}}f(x)=\\text{DNE} \\,.\n$$\n\n**Note:** Here, $\\text{DNE}$ is simply short for \"does not exist\"."] [:db/cas 17592186068659 :question/worked-solution "Recall that $\\cos(\\theta)$ ranges between $-1$ and $1$. So we have\n\n$$\n-1 \\le \\cos \\left(\\dfrac{1}{x}\\right) \\le 1\n$$\n\nand multiplying both sides by $x^4$ gives\n\n$$\n-x^4 \\le x^4\\cos\\left(\\dfrac{1}{x}\\right) \\le x^4\n$$\n\nNow, taking the limits gives\n\n$$\n\\begin{bmatrix}lim_(x → 0)(-x^{4}) \\le & lim_(x → 0)x^{4}\\cos \\left(\\frac{1}{x}\\right) \\le lim_(x → 0)(x^{4}) \\\\ 0 \\le & lim_(x → 0)x^{4}\\cos \\left(\\frac{1}{x}\\right) \\le 0\\end{bmatrix}\n$$\n\nwhich, by the squeeze theorem, implies that\n\n$$\n\\lim\\limits_{x\\to0} x^4\\cos \\left(\\dfrac{1}{x}\\right) = 0\n$$" "Recall that $\\cos(\\theta)$ ranges between $-1$ and $1$. So we have\n\n$$\n-1 \\le \\cos \\left(\\dfrac{1}{x}\\right) \\le 1\n$$\n\nand multiplying both sides by $x^4$ gives\n\n$$\n-x^4 \\le x^4\\cos\\left(\\dfrac{1}{x}\\right) \\le x^4\n$$\n\nNow, taking the limits gives\n\n$$\n\\begin{bmatrix}\\lim_{x \\to  0}(-x^{4}) \\le & \\lim_{x \\to  0}x^{4}\\cos \\left(\\frac{1}{x}\\right) \\le lim_(x → 0)(x^{4}) \\\\ 0 \\le & \\lim_{x \\to  0}x^{4}\\cos \\left(\\frac{1}{x}\\right) \\le 0\\end{bmatrix}\n$$\n\nwhich, by the squeeze theorem, implies that\n\n$$\n\\lim\\limits_{x\\to0} x^4\\cos \\left(\\dfrac{1}{x}\\right) = 0\n$$"] [:db/cas 17592186068661 :question/worked-solution "Taking the limits gives\n\n$$\n\\begin{bmatrix}lim_(x → 2)(4x - 4) \\le & lim_(x → 2)f(x) \\le lim_(x → 2)x^{2} \\\\ 4(2) - 4 \\le & lim_(x → 2)f(x) \\le 2^{2} \\\\ 4 \\le & lim_(x → 2)f(x) \\le 4\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we must have\n\n$$\n\\lim\\limits_{x\\to 2} f(x)=4\n$$" "Taking the limits gives\n\n$$\n\\begin{bmatrix}\\lim_{x \\to  2}(4x - 4) \\le & \\lim_{x \\to  2}f(x) \\le lim_(x → 2)x^{2} \\\\ 4(2) - 4 \\le & \\lim_{x \\to  2}f(x) \\le 2^{2} \\\\ 4 \\le & \\lim_{x \\to  2}f(x) \\le 4\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we must have\n\n$$\n\\lim\\limits_{x\\to 2} f(x)=4\n$$"] [:db/cas 17592186068664 :question/worked-solution "Recall that $\\cos(\\theta)$ ranges between $-1$ and $1$. So we have\n\n$$\n-1 \\le \\cos \\left(\\dfrac{1}{x}\\right) \\le 1\n$$\n\nNow, since $e^x$ is a positive, increasing function, we can exponentiate both sides to give\n\n$$\ne^{-1} \\le e^{\\cos (1/x)} \\le e^{1}\n$$\n\nMultiplying both sides of the inequality by $x^2$ gives\n\n$$\nx^2e^{-1} \\le x^2e^{\\cos (1/x)} \\le x^2e^{1}\n$$\n\nand taking the limits gives\n\n$$\n\\begin{bmatrix}lim_(x → 0)x^{2}e^{-1} \\le & lim_(x → 0)x^{2}e^{\\cos (1/x)} \\le lim_(x → 0)x^{2}e^{1} \\\\ 0 \\le & lim_(x → 0)x^{2}e^{\\cos (1/x)} \\le 0\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we must have\n\n$$\n\\lim_{x\\to0} x^2e^{\\cos (1/x)} = 0\n$$" "Recall that $\\cos(\\theta)$ ranges between $-1$ and $1$. So we have\n\n$$\n-1 \\le \\cos \\left(\\dfrac{1}{x}\\right) \\le 1\n$$\n\nNow, since $e^x$ is a positive, increasing function, we can exponentiate both sides to give\n\n$$\ne^{-1} \\le e^{\\cos (1/x)} \\le e^{1}\n$$\n\nMultiplying both sides of the inequality by $x^2$ gives\n\n$$\nx^2e^{-1} \\le x^2e^{\\cos (1/x)} \\le x^2e^{1}\n$$\n\nand taking the limits gives\n\n$$\n\\begin{bmatrix}\\lim_{x \\to  0}x^{2}e^{-1} \\le & \\lim_{x \\to  0}x^{2}e^{\\cos (1/x)} \\le lim_(x → 0)x^{2}e^{1} \\\\ 0 \\le & \\lim_{x \\to  0}x^{2}e^{\\cos (1/x)} \\le 0\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we must have\n\n$$\n\\lim_{x\\to0} x^2e^{\\cos (1/x)} = 0\n$$"] [:db/cas 17592186068665 :question/worked-solution "Recall that $\\sin(\\theta)$ ranges between $-1$ and $1$. So, we have\n\n$$\n\\left|\\sin{\\left(\\dfrac{3}{x}\\right)}\\right|\\leq 1\n$$\n\nMultiplying the above inequality by $\\mid x^3 \\mid$ gives\n\n$$\n\\begin{vmatrix}x^{3} & \\cdot & \\sin \\left(\\frac{3}{x}\\right) & \\le & x^{3}\\end{vmatrix};\\begin{vmatrix}x^{3}\\sin \\left(\\frac{3}{x}\\right) & \\le & x^{3}\\end{vmatrix}\n$$\n\nand using the definition of absolute value, we have\n\n$$\n-\\begin{vmatrix}x^3 & \\leq x^3 \\sin{\\left(\\dfrac{3}{x}\\right)} \\leq & x^3\\end{vmatrix}\n$$\n\nNote that we're using absolute value here because $x^3$ has an odd power.\n\nNow, taking the limit as $x\\to 0$, we have\n\n$$\n\\begin{bmatrix}lim_(x → 0)(-\\mid x^{3} \\mid) \\le & lim_(x → 0)x^{3}\\sin \\left(\\frac{3}{x}\\right) \\le lim_(x → 0)(\\mid x^{3} \\mid) \\\\ 0 \\le & lim_(x → 0)x^{3}\\sin \\left(\\frac{3}{x}\\right) \\le 0\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we conclude that\n\n$$\n\\lim_{x\\to 0} x^3 \\sin{\\left(\\dfrac{3}{x}\\right)} = 0\n$$" "Recall that $\\sin(\\theta)$ ranges between $-1$ and $1$. So, we have\n\n$$\n\\left|\\sin{\\left(\\dfrac{3}{x}\\right)}\\right|\\leq 1\n$$\n\nMultiplying the above inequality by $\\mid x^3 \\mid$ gives\n\n$$\n\\begin{aligned}|{x}^{3}|\\cdot |\\operatorname{sin}\\left(\\frac{3}{x}\\right)|\\le |{x}^{3}| \\\\ |{x}^{3}\\operatorname{sin}\\left(\\frac{3}{x}\\right)|\\le |{x}^{3}|,\\end{aligned}\n$$\n\nand using the definition of absolute value, we have\n\n$$\n-|x^3| \\leq x^3 \\sin{\\left(\\dfrac{3}{x}\\right)} \\leq |x^3|.\n$$\n\nNote that we're using absolute value here because $x^3$ has an odd power.\n\nNow, taking the limit as $x\\to 0$, we have\n\n$$\n\\begin{bmatrix}\\lim_{x \\to  0}(-\\mid x^{3} \\mid) \\le & \\lim_{x \\to  0}x^{3}\\sin \\left(\\frac{3}{x}\\right) \\le lim_(x → 0)(\\mid x^{3} \\mid) \\\\ 0 \\le & \\lim_{x \\to  0}x^{3}\\sin \\left(\\frac{3}{x}\\right) \\le 0\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we conclude that\n\n$$\n\\lim_{x\\to 0} x^3 \\sin{\\left(\\dfrac{3}{x}\\right)} = 0\n$$"] [:db/cas 17592186069091 :question/problem "![](images/15/159749b3bcae3d28f469dfd7356e4955721d23a40a45142a65aa6f7beccb90a7.png)\n\nFind $lim_(x → 0)f(x)$ for the function $f(x)$ whose graph is shown above." "![](images/15/159749b3bcae3d28f469dfd7356e4955721d23a40a45142a65aa6f7beccb90a7.png)\n\nFind $\\lim_{x \\to  0}f(x)$ for the function $f(x)$ whose graph is shown above."] [:db/cas 17592186069092 :question/problem "![](images/39/392fb6eaebb1e2faee96796f5633cfcd4e5d4c55484f9d185d5f55eb87d95fb5.png)\n\nFind $lim_(x → 1)f(x)$ for the function $f(x)$ whose graph is shown above." "![](images/39/392fb6eaebb1e2faee96796f5633cfcd4e5d4c55484f9d185d5f55eb87d95fb5.png)\n\nFind $\\lim_{x \\to  1}f(x)$ for the function $f(x)$ whose graph is shown above."] [:db/cas 17592186069093 :question/problem "![](images/38/384a9198f7b164fce69e5c33a70ed1a4b6bf8d3c0d5c5a58fb8c9202b87f3d61.png)\n\nFind $lim_(x → 3)f(x)$ for the function above." "![](images/38/384a9198f7b164fce69e5c33a70ed1a4b6bf8d3c0d5c5a58fb8c9202b87f3d61.png)\n\nFind $\\lim_{x \\to  3}f(x)$ for the function above."] [:db/cas 17592186069094 :question/problem "![](images/09/09b0beda6782f188a57716ae41971a1167d3c931b9739f7e8ee6df59d87b82b2.png)\n\nFind $lim_(x → 2)f(x)$ for the function above." "![](images/09/09b0beda6782f188a57716ae41971a1167d3c931b9739f7e8ee6df59d87b82b2.png)\n\nFind $\\lim_{x \\to  2}f(x)$ for the function above."] [:db/cas 17592186069097 :question/problem "![](images/ce/ce76137f4cde1447b2dff893897ff101c9075e49cae5b2ddedb7c83a5e552028.png)\n\nFind $lim_(x → - \\frac{π}{2}^{-})f(x)$ and $lim_(x → - \\frac{π}{2}^{+})f(x)$ for the function given above." "![](images/ce/ce76137f4cde1447b2dff893897ff101c9075e49cae5b2ddedb7c83a5e552028.png)\n\nFind $\\lim_{x \\to  - \\frac{π}{2}^{-}}f(x)$ and $\\lim_{x \\to  - \\frac{π}{2}^{+}}f(x)$ for the function given above."] [:db/cas 17592186069101 :question/problem "![](images/5c/5c9b656893111fd16146ab5b44465c7823d9cf6d82a30d2a3ca04cb0b389cf07.png)\n\nFind $lim_(x → \\frac{π}{2}^{-})f(x)$ and $lim_(x → \\frac{π}{2}^{+})f(x)$ for the function given above." "![](images/5c/5c9b656893111fd16146ab5b44465c7823d9cf6d82a30d2a3ca04cb0b389cf07.png)\n\nFind $\\lim_{x \\to  \\frac{π}{2}^{-}}f(x)$ and $\\lim_{x \\to  \\frac{π}{2}^{+}}f(x)$ for the function given above."] [:db/cas 17592186069218 :question/problem "![](images/7b/7b3544694cc41819941bdc05e2e1c9f388c5c538dbc5a58dbf02f6ae0bc685f7.png)\n\nIf the figure above shows the graph of $f(x)$, then$lim_(x → 1^{-})f(x) =$\n{{field-1}} ,\n$lim_(x → 1^{+})f(x) =$\n{{field-2}}." "![](images/7b/7b3544694cc41819941bdc05e2e1c9f388c5c538dbc5a58dbf02f6ae0bc685f7.png)\n\nIf the figure above shows the graph of $f(x)$, then$\\lim_{x \\to  1^{-}}f(x) =$\n{{field-1}} ,\n$\\lim_{x \\to  1^{+}}f(x) =$\n{{field-2}}."] [:db/cas 17592186069232 :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{({x}^{2}-1)^{2}-1}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[({x}^{2}-1)^{2}-1]}^{′}}{{[{x}^{2}]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{4x({x}^{2}-1)}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{4{x}^{3}-4x}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{({x}^{2}-1)^{2}-1}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{4{x}^{3}-4x}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{[4{x}^{3}-4x]^{′}}{[2x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{12{x}^{2}-4}{2} \\\\  & =\\frac{12(0)^{2}-4}{2} \\\\  & =\\frac{-4}{2} \\\\  & =-2.\\end{aligned}\n$$" "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{({x}^{2}-1)^{2}-1}{{x}^{2}} & =\\lim_{x\\to 0}\\frac{{[({x}^{2}-1)^{2}-1]}^{′}}{{[{x}^{2}]}^{′}} \\\\  & =\\lim_{x\\to 0}\\frac{4x({x}^{2}-1)}{2x} \\\\  & =\\lim_{x\\to 0}\\frac{4{x}^{3}-4x}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{({x}^{2}-1)^{2}-1}{{x}^{2}} & =\\lim_{x\\to 0}\\frac{4{x}^{3}-4x}{2x} \\\\  & =\\lim_{x\\to 0}\\frac{[4{x}^{3}-4x]^{′}}{[2x]^{′}} \\\\  & =\\lim_{x\\to 0}\\frac{12{x}^{2}-4}{2} \\\\  & =\\frac{12(0)^{2}-4}{2} \\\\  & =\\frac{-4}{2} \\\\  & =-2.\\end{aligned}\n$$"] [:db/cas 17592186069233 :question/problem "What is $lim_(x → ∞)\\frac{x + 1}{\\sqrt{x} - 1}$?" "What is $\\lim_{x \\to  \\infty}\\frac{x + 1}{\\sqrt{x} - 1}$?"] [:db/cas 17592186069243 :question/problem "What is $lim_(x → 0)\\frac{\\sin x - x}{x^{3} + x^{2}}$?" "What is $\\lim_{x \\to  0}\\frac{\\sin x - x}{x^{3} + x^{2}}$?"] [:db/cas 17592186069247 :question/worked-solution "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{x\\operatorname{cos}⁡x}{\\operatorname{ln}⁡(x+1)} & ={lim}_{x\\to 0}\\frac{[x\\operatorname{cos}⁡x]^{′}}{[\\operatorname{ln}⁡(x+1)]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x}{\\left(\\frac{1}{x+1}\\right)} \\\\  & =\\frac{\\operatorname{cos}⁡0-0\\cdot \\operatorname{sin}⁡0}{\\left(\\frac{1}{0+1}\\right)} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$" "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{x\\operatorname{cos}⁡x}{\\operatorname{ln}⁡(x+1)} & =\\lim_{x\\to 0}\\frac{[x\\operatorname{cos}⁡x]^{′}}{[\\operatorname{ln}⁡(x+1)]^{′}} \\\\  & =\\lim_{x\\to 0}\\frac{\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x}{\\left(\\frac{1}{x+1}\\right)} \\\\  & =\\frac{\\operatorname{cos}⁡0-0\\cdot \\operatorname{sin}⁡0}{\\left(\\frac{1}{0+1}\\right)} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$"] [:db/cas 17592186069248 :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{{[2\\operatorname{ln}⁡x]}^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\left(\\frac{2}{x}\\right)}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x}{{e}^{x}} & =\\lim_{x\\to \\infty }\\frac{{[2\\operatorname{ln}⁡x]}^{′}}{[{e}^{x}]^{′}} \\\\  & =\\lim_{x\\to \\infty }\\frac{\\left(\\frac{2}{x}\\right)}{{e}^{x}} \\\\  & =\\lim_{x\\to \\infty }\\frac{2}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$"] [:db/cas 17592186069274 :question/problem "![](images/2f/2f37f1f1e1b575695c38665ba5cc7cac694f441a2acb64d508f274825d2a4e12.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $lim_(x → - 1)f(x) = 2$\n2. $lim_(x → 0)f(x) = 2$\n3. $lim_(x → 1)f(x) = lim_(x → 3)f(x)$" "![](images/2f/2f37f1f1e1b575695c38665ba5cc7cac694f441a2acb64d508f274825d2a4e12.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $\\lim_{x \\to  - 1}f(x) = 2$\n2. $\\lim_{x \\to  0}f(x) = 2$\n3. $\\lim_{x \\to  1}f(x) = \\lim_{x \\to  3}f(x)$"] [:db/cas 17592186069276 :question/problem "![](images/22/225b05930bec6085ed259aeffa9b729bb233782fb15c846eb78ab6b6fb8bcbbc.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $lim_(x → - 2)f(x) = 0$\n2. $lim_(x → - 3)f(x) =-2$\n3. $lim_(x → - 2)f(x) = lim_(x → 2)f(x)$" "![](images/22/225b05930bec6085ed259aeffa9b729bb233782fb15c846eb78ab6b6fb8bcbbc.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $\\lim_{x \\to  - 2}f(x) = 0$\n2. $\\lim_{x \\to  - 3}f(x) =-2$\n3. $\\lim_{x \\to  - 2}f(x) = \\lim_{x \\to  2}f(x)$"] [:db/cas 17592186069304 :question/problem "What is $lim_(x → 0)\\frac{x^{2} - x}{\\tan x}$?" "What is $\\lim_{x \\to  0}\\frac{x^{2} - x}{\\tan x}$?"] [:db/cas 17592186069311 :question/worked-solution "Since $f(x)$ is right-continuous at $x=2,$ we must have\n\n$$\n{lim}_{x\\to {2}^{+}}f(x)=f(2)=-1.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}(f(x)+f(2)) & ={lim}_{x\\to {2}^{+}}f(x)+f(2) \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$" "Since $f(x)$ is right-continuous at $x=2,$ we must have\n\n$$\n\\lim_{x\\to {2}^{+}}f(x)=f(2)=-1.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{+}}(f(x)+f(2)) & =\\lim_{x\\to {2}^{+}}f(x)+f(2) \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$"] [:db/cas 17592186069315 :question/problem "If $f(x)$ is right-continuous at $x = 4$ and $f(4) = 1$, then what is $lim_(x → 4^{+})(f(x) + \\sqrt{x})/(3x)$?" "If $f(x)$ is right-continuous at $x = 4$ and $f(4) = 1$, then what is $\\lim_{x \\to  4^{+}}(f(x) + \\sqrt{x})/(3x)$?"] [:db/cas 17592186069320 :question/problem "Evaluate $lim_(x → 0)x^{2}e^{\\sin (1/x)}$." "Evaluate $\\lim_{x \\to  0}x^{2}e^{\\sin (1/x)}$."] [:db/cas 17592186069321 :question/problem "Find $lim_(x → 4)f(x)$ if\n$4x - 9 \\le f(x) \\le x^{2} - 4x + 7$." "Find $\\lim_{x \\to  4}f(x)$ if\n$4x - 9 \\le f(x) \\le x^{2} - 4x + 7$."] [:db/cas 17592186069322 :question/problem "Find $lim_(x → 2)f(x)$ if\n$\\ln (x - 1) + 1 \\le f(x) \\le x - 1$." "Find $\\lim_{x \\to  2}f(x)$ if\n$\\ln (x - 1) + 1 \\le f(x) \\le x - 1$."] [:db/cas 17592186069359 :question/problem "Evaluate $lim_(x → 0)x\\sin \\left(\\frac{1}{x^{2}}\\right)$." "Evaluate $\\lim_{x \\to  0}x\\sin \\left(\\frac{1}{x^{2}}\\right)$."] [:db/cas 17592186069360 :question/problem "Evaluate $lim_(x → 0)x^{2}\\cos \\left(\\frac{1}{x}\\right)$." "Evaluate $\\lim_{x \\to  0}x^{2}\\cos \\left(\\frac{1}{x}\\right)$."] [:db/cas 17592186069361 :question/problem "Evaluate $lim_(x → 0)x^{2}\\sin \\left(\\frac{1}{x}\\right)$." "Evaluate $\\lim_{x \\to  0}x^{2}\\sin \\left(\\frac{1}{x}\\right)$."] [:db/cas 17592186069362 :question/problem "Evaluate $lim_(x → 0)x^{4}e^{3\\cos (1/x)}$." "Evaluate $\\lim_{x \\to  0}x^{4}e^{3\\cos (1/x)}$."] [:db/cas 17592186069363 :question/problem "Evaluate $lim_(x → 0)x^{5}\\sin \\left(\\frac{4}{x}\\right)$." "Evaluate $\\lim_{x \\to  0}x^{5}\\sin \\left(\\frac{4}{x}\\right)$."] [:db/cas 17592186069364 :question/problem "![](images/0e/0e689136f958f2d6425d36fa5448268bd645ffc7729a992d8c6621e2c51e3bfb.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $lim_(x → 1^{+})f(x) = 1$\n2. $lim_(x → 2^{+})f(x) = 1$\n3. $lim_(x → (-1)^{-})f(x) = lim_(x → (-1)^{+})f(x)$" "![](images/0e/0e689136f958f2d6425d36fa5448268bd645ffc7729a992d8c6621e2c51e3bfb.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $\\lim_{x \\to  1^{+}}f(x) = 1$\n2. $\\lim_{x \\to  2^{+}}f(x) = 1$\n3. $\\lim_{x \\to  (-1)^{-}}f(x) = \\lim_{x \\to  (-1)^{+}}f(x)$"] [:db/cas 17592186069435 :question/problem "![](images/a0/a090fc9f29c025635de280fee0ba0194236ea8ebb3945bf2306e65c104949d32.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $lim_(x → - 1^{+})f(x) = lim_(x → 0^{-})f(x)$\n2. $lim_(x → - 1^{+})f(x) = lim_(x → 0^{+})f(x)$\n3. $lim_(x → 2^{+})f(x) = lim_(x → 2^{-})f(x)$" "![](images/a0/a090fc9f29c025635de280fee0ba0194236ea8ebb3945bf2306e65c104949d32.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $\\lim_{x \\to  - 1^{+}}f(x) = \\lim_{x \\to  0^{-}}f(x)$\n2. $\\lim_{x \\to  - 1^{+}}f(x) = \\lim_{x \\to  0^{+}}f(x)$\n3. $\\lim_{x \\to  2^{+}}f(x) = \\lim_{x \\to  2^{-}}f(x)$"] [:db/cas 17592186069473 :question/problem "Evaluate $lim_(x → 0^{+})(\\ln x)/(\\left(\\frac{1}{x^{2}}\\right))$." "Evaluate $\\lim_{x \\to  0^{+}}(\\ln x)/(\\left(\\frac{1}{x^{2}}\\right))$."] [:db/cas 17592186069507 :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{csc}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{sin}⁡x)]}^{′}}{[\\operatorname{csc}⁡x]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cot}⁡x}{-\\operatorname{csc}⁡x\\operatorname{cot}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{\\cancel{\\operatorname{cot}⁡x}}{\\operatorname{csc}⁡x\\cancel{\\operatorname{cot}⁡x}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{1}{\\operatorname{csc}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\operatorname{sin}⁡x \\\\  & =0.\\end{aligned}\n$$" "Here the limits of the numerator and denominator are $\\lim_{x\\to {0}^{+}}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)=-\\infty $ and $\\lim_{x\\to {0}^{+}}\\operatorname{csc}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x} & =\\lim_{x\\to {0}^{+}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{sin}⁡x)]}^{′}}{[\\operatorname{csc}⁡x]^{′}} \\\\  & =\\lim_{x\\to {0}^{+}}\\frac{\\operatorname{cot}⁡x}{-\\operatorname{csc}⁡x\\operatorname{cot}⁡x} \\\\  & =-\\lim_{x\\to {0}^{+}}\\frac{\\cancel{\\operatorname{cot}⁡x}}{\\operatorname{csc}⁡x\\cancel{\\operatorname{cot}⁡x}} \\\\  & =-\\lim_{x\\to {0}^{+}}\\frac{1}{\\operatorname{csc}⁡x} \\\\  & =-\\lim_{x\\to {0}^{+}}\\operatorname{sin}⁡x \\\\  & =0.\\end{aligned}\n$$"] [:db/cas 17592186069924 :tutorial/content "The limit of a function at some point has **nothing to do** with the value of the function at that point.\n\nFor example, the following functions $g(x)$ and $h(x)$ have *different values* at $x=2,$ but they have the *same limit* at $x=2.$\n\n![](images/6a/6a73b74072a8a990c91a38553d519f4913370d34ef0251b7e45cc664da40517d.png)\n\n![](images/06/06e150aacae774b4fe883a2750ef13cebbddf2ea871e5a682f2587c47a54615a.png)\n\nThe actual values of $g(2)$ and $h(2)$ are irrelevant for determining the limit at $x=2$. All that matters is what values the functions *look like* they are approaching as $x$ approaches $2$. \n\nNear $x=2,$ both $g(x)$ and $h(x)$ appear to be approaching $y=1$. Therefore,\n\n$$\n\\lim_\\limits{x\\rightarrow 2}g(x)=1\n$$\n\nand\n\n$$\n\\lim_\\limits{x\\rightarrow 2}h(x)=1 \\, .\n$$" "The limit of a function at some point has **nothing to do** with the value of the function at that point.\n\nFor example, the following functions $g(x)$ and $h(x)$ have *different values* at $x=2,$ but they have the *same limit* at $x=2.$\n\n![](images/6a/6a73b74072a8a990c91a38553d519f4913370d34ef0251b7e45cc664da40517d.png)\n\n![](images/06/06e150aacae774b4fe883a2750ef13cebbddf2ea871e5a682f2587c47a54615a.png)\n\nThe actual values of $g(2)$ and $h(2)$ are irrelevant for determining the limit at $x=2$. All that matters is what values the functions *look like* they are approaching as $x$ approaches $2$. \n\nNear $x=2,$ both $g(x)$ and $h(x)$ appear to be approaching $y=1$. Therefore,\n\n$$\n\\lim_{x\\rightarrow 2}g(x)=1\n$$\n\nand\n\n$$\n\\lim_{x\\rightarrow 2}h(x)=1 \\, .\n$$"] [:db/cas 17592186069928 :tutorial/content "The **limit** of a function is the value that the function approaches. For example, the function $y=f(x)$ shown below is not defined at $x=2,$ as represented by the open circle there $-$ but when we *approach* $x=2$, we see that $f(x)$ *approaches* the value $y=1.$\n\n![](images/f7/f7081d649c6cdfa0a19a0fb2de93b97ee700ad922f34530c7f3e5c2a3228c9fb.png)\n\nAs $x$ approaches $2$, the value of $f(x)$ approaches $1.$ In other words, the limit of $f(x),$ as $x$ approaches $2,$ is $1$. We can express this mathematically as \n\n$$\n\\lim_\\limits{x\\rightarrow 2}f(x)=1 \\, .\n$$" "The **limit** of a function is the value that the function approaches. For example, the function $y=f(x)$ shown below is not defined at $x=2,$ as represented by the open circle there $-$ but when we *approach* $x=2$, we see that $f(x)$ *approaches* the value $y=1.$\n\n![](images/f7/f7081d649c6cdfa0a19a0fb2de93b97ee700ad922f34530c7f3e5c2a3228c9fb.png)\n\nAs $x$ approaches $2$, the value of $f(x)$ approaches $1.$ In other words, the limit of $f(x),$ as $x$ approaches $2,$ is $1$. We can express this mathematically as \n\n$$\n\\lim_{x\\rightarrow 2}f(x)=1 \\, .\n$$"] [:db/cas 17592186069933 :tutorial/content "We already know that $\\lim\\limits_{x \\to \\, a} f(x)$ represents the limit of $f(x)$ as $x$ approaches $a.$ However, there are really two ways that $x$ can approach $a$ -- from the left side or from the right side -- and sometimes, it matters which direction we choose.\n\nFor example, consider the function below.\n\n- As $x \\to -1$ from the left, we have $f(x) \\to -4,$ but\n\n- as $x \\to -1$ from the right, we have $f(x) \\to -3.$\n\n![](images/f7/f7a08cf136b1fdb33973c4f94300b08d18ca89fae8c2f9016155d05e21f4d610.png)\n\nTo be more precise about the direction in which $x$ approaches $a$, we use superscripts. The minus sign $(-)$ means \"from the left\" and the plus sign $(+)$ means \"from the right.\"\n\n- **Left-sided limit:** $\\lim\\limits_{x \\to \\, a^-} f(x)$ represents the limit of $f(x)$ as $x$ approaches $a$ *from the left.*\n\n- **Right-sided limit:** $\\lim\\limits_{x \\to \\, a^+} f(x)$ represents the limit of $f(x)$ as $x$ approaches $a$ *from the right.*\n\nFor the function graphed above, the left-sided limit is\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-1^{-}}f(x)=-4\n$$\n\nand the right-sided limit is\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-1^{+}}f(x)=-3 \\,.\n$$\n\nAt the same time, if we consider the point $x=-5,$ we note that the left-sided limit at this point does not exist because the function to the left of $x=-5$ is not defined. If the limit **does not exist**, we usually denote it using the abbreviation $\\textrm{DNE}{:}$\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-5^{-}}f(x)=\\textrm{DNE}\n$$\n\n**Note:** The \"minus\" superscript $(-)$ indicates \"left\" because the left direction is the negative direction on the number line, and the \"plus\" superscript $(+)$ indicates \"right\" because the right direction is the positive direction on the number line." "We already know that $\\lim\\limits_{x \\to \\, a} f(x)$ represents the limit of $f(x)$ as $x$ approaches $a.$ However, there are really two ways that $x$ can approach $a$ -- from the left side or from the right side -- and sometimes, it matters which direction we choose.\n\nFor example, consider the function below.\n\n- As $x \\to -1$ from the left, we have $f(x) \\to -4,$ but\n\n- as $x \\to -1$ from the right, we have $f(x) \\to -3.$\n\n![](images/f7/f7a08cf136b1fdb33973c4f94300b08d18ca89fae8c2f9016155d05e21f4d610.png)\n\nTo be more precise about the direction in which $x$ approaches $a$, we use superscripts. The minus sign $(-)$ means \"from the left\" and the plus sign $(+)$ means \"from the right.\"\n\n- **Left-sided limit:** $\\lim\\limits_{x \\to \\, a^-} f(x)$ represents the limit of $f(x)$ as $x$ approaches $a$ *from the left.*\n\n- **Right-sided limit:** $\\lim\\limits_{x \\to \\, a^+} f(x)$ represents the limit of $f(x)$ as $x$ approaches $a$ *from the right.*\n\nFor the function graphed above, the left-sided limit is\n\n$$\n\\lim_{x\\rightarrow \\,-1^{-}}f(x)=-4\n$$\n\nand the right-sided limit is\n\n$$\n\\lim_{x\\rightarrow \\,-1^{+}}f(x)=-3 \\,.\n$$\n\nAt the same time, if we consider the point $x=-5,$ we note that the left-sided limit at this point does not exist because the function to the left of $x=-5$ is not defined. If the limit **does not exist**, we usually denote it using the abbreviation $\\textrm{DNE}{:}$\n\n$$\n\\lim_{x\\rightarrow \\,-5^{-}}f(x)=\\textrm{DNE}\n$$\n\n**Note:** The \"minus\" superscript $(-)$ indicates \"left\" because the left direction is the negative direction on the number line, and the \"plus\" superscript $(+)$ indicates \"right\" because the right direction is the positive direction on the number line."] [:db/cas 17592186069962 :tutorial/content "Recall that a function $f(x)$ is said to be **continuous** at a point $x=c$ if \n\n$$\n\\lim\\limits_{x \\to c} f(x) = f(c) .\n$$\n\nIn order for the above statement to be true, we require both\n\n$$\n\\begin{aligned}{lim}_{x\\to {c}^{-}}f(x) &=f(c)\\,\\text{and}\\,{lim}_{x\\to {c}^{+}}f(x)=f(c).\\end{aligned}\n$$\n\nThe above equalities represent left-continuity and right-continuity. So, we have the following fact:\n\nA function is **continuous** at a point if and only if it is *both* **left-continuous** *and* **right-continuous** at that point." "Recall that a function $f(x)$ is said to be **continuous** at a point $x=c$ if \n\n$$\n\\lim\\limits_{x \\to c} f(x) = f(c) .\n$$\n\nIn order for the above statement to be true, we require both\n\n$$\n\\begin{aligned}\\lim_{x\\to {c}^{-}}f(x) &=f(c)\\,\\text{and}\\,\\lim_{x\\to {c}^{+}}f(x)=f(c).\\end{aligned}\n$$\n\nThe above equalities represent left-continuity and right-continuity. So, we have the following fact:\n\nA function is **continuous** at a point if and only if it is *both* **left-continuous** *and* **right-continuous** at that point."] [:db/cas 17592186069963 :tutorial/content "The function\n\n$$\nf(x)=x^2\\sin \\left(\\dfrac{1}{x^2}\\right)\n$$\n\nis undefined at $x=0$, but does that mean that the limit of this function at $x=0$ is also undefined?\n\nTo find out, let's start by looking at the graph of $y=f(x)$.\n\n![](images/2b/2b7e2e2d02a28fdf5f94efa4494b56fdf2fa445de81f3707e8040e6686af5793.png)\n\nBased on the graph, it looks like $f(x) \\to 0$ as $x \\to 0$. But let's try to find more convincing evidence.\n\nFirst, notice that the function $f(x)$ is squeezed (or sandwiched) between the two functions $y=x^2$ and $y=-x^2$. This happens because $\\sin(\\cdots)$ ranges between $-1$ and $1$, so $x^2 \\sin (\\cdots)$ ranges between $-x^2$ and $x^2$.\n\n![](images/d2/d2a4563cbe7c245eeda865238b4287d70607a4e43330c1806988fe5804b8c2df.png)\n\nStarting with\n\n$$\n-x^2 \\leq f(x) \\leq x^2\n$$\n\nwe take the limit as $x\\to 0$ and evaluate the two known limits, reaching\n\n$$\n\\begin{bmatrix}lim_(x → 0)(-x^{2}) \\le & lim_(x → 0)f(x) \\le lim_(x → 0)(x^{2}) \\\\ 0 \\le & lim_(x → 0)f(x) \\le 0\\end{bmatrix}\n$$\n\nThere is only one number that satisfies the final inequality above, and that number is $0$. Therefore,\n\n$$\n\\lim_{x\\to 0}f(x) =0\n$$\n\nWe just applied the **squeeze theorem**, also called the **sandwich theorem**. Written generally, the squeeze theorem states that if a function $f(x)$ is squeezed between two functions $g(x)$ and $h(x)$, i.e.,\n\n$$\nh(x) \\le f(x) \\le g(x)\n$$\n\nand\n\n$$\n\\lim_{x\\to a} h(x)=\\lim_{x\\to a} g(x) =L\n$$\n\nfor constants $a$ and $L$, then\n\n$$\n\\lim_{x\\to a} f(x) =L\n$$" "The function\n\n$$\nf(x)=x^2\\sin \\left(\\dfrac{1}{x^2}\\right)\n$$\n\nis undefined at $x=0$, but does that mean that the limit of this function at $x=0$ is also undefined?\n\nTo find out, let's start by looking at the graph of $y=f(x)$.\n\n![](images/2b/2b7e2e2d02a28fdf5f94efa4494b56fdf2fa445de81f3707e8040e6686af5793.png)\n\nBased on the graph, it looks like $f(x) \\to 0$ as $x \\to 0$. But let's try to find more convincing evidence.\n\nFirst, notice that the function $f(x)$ is squeezed (or sandwiched) between the two functions $y=x^2$ and $y=-x^2$. This happens because $\\sin(\\cdots)$ ranges between $-1$ and $1$, so $x^2 \\sin (\\cdots)$ ranges between $-x^2$ and $x^2$.\n\n![](images/d2/d2a4563cbe7c245eeda865238b4287d70607a4e43330c1806988fe5804b8c2df.png)\n\nStarting with\n\n$$\n-x^2 \\leq f(x) \\leq x^2\n$$\n\nwe take the limit as $x\\to 0$ and evaluate the two known limits, reaching\n\n$$\n\\begin{bmatrix}\\lim_{x \\to  0}(-x^{2}) \\le & \\lim_{x \\to  0}f(x) \\le lim_(x → 0)(x^{2}) \\\\ 0 \\le & \\lim_{x \\to  0}f(x) \\le 0\\end{bmatrix}\n$$\n\nThere is only one number that satisfies the final inequality above, and that number is $0$. Therefore,\n\n$$\n\\lim_{x\\to 0}f(x) =0\n$$\n\nWe just applied the **squeeze theorem**, also called the **sandwich theorem**. Written generally, the squeeze theorem states that if a function $f(x)$ is squeezed between two functions $g(x)$ and $h(x)$, i.e.,\n\n$$\nh(x) \\le f(x) \\le g(x)\n$$\n\nand\n\n$$\n\\lim_{x\\to a} h(x)=\\lim_{x\\to a} g(x) =L\n$$\n\nfor constants $a$ and $L$, then\n\n$$\n\\lim_{x\\to a} f(x) =L\n$$"] [:db/cas 17592186070001 :tutorial/content "We wish to find the solution to the equation\n\n$$\n\\vert 5x + 7 \\vert = 3x +9\n$$\n\nFor this equation to be true, either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nTherefore, we have the following two cases:\n\n$$\n\\begin{vmatrix}5x+7 & = 5x+7 \\qquad \\textrm{and}\\qquad & 5x+7\\end{vmatrix} = -(5x+7)\n$$\n\nWe now consider these two cases separately:\n\n- If $\\mid 5x +7|=5x +7$, we obtain the following equation:\n$5x +7 = 3x +9$\nWe now solve this equation using the usual methods:\n$$\n\\displaystyle 5x + 7|= 3x + 9; 2x + 7|= 9; 2x|= 2; x|= 1\n$$\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$$\n\\displaystyle \\mid 5x + 7 \\mid |= 3x + 9; \\mid 5(1) + 7 \\mid |= 3(1) + 9; \\mid 5 + 7 \\mid |= 3 + 9; \\mid 12 \\mid |= 12; 12|= 12✓\n$$\nSince $x=1$ satisfies the original equation, it's a valid solution.\n- If $\\mid 5x +7|=-(5x +7)$, we obtain the following equation:\n$-(5x +7)=3x +9$\nWe now solve this equation using the usual methods:\n$$\n\\displaystyle - (5x + 7)|= 3x + 9; - 5x - 7|= 3x + 9; - 7|= 8x + 9; - 16|= 8x; - 2|= x; x|=-2\n$$\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$$\n\\displaystyle \\mid 5x + 7 \\mid |= 3(-2) + 9; \\mid 5(-2) + 7 \\mid |= 3(-2) + 9; \\mid - 10 + 7 \\mid |=-6 + 9; \\mid - 3 \\mid |= 3; 3|= 3✓\n$$\nSince $x=-2$ satisfies the original equation, it's a valid solution.\n\nTherefore, the solutions of our equation are $x=-2, \\, 1$.\n\n![](images/a8/a8982c526d460e2968b5e06871f74adc32da549faeffa89ac58a39c4d84730d5.png)" "We wish to find the solution to the equation\n\n$$\n\\vert 5x + 7 \\vert = 3x +9\n$$\n\nFor this equation to be true, either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nTherefore, we have the following two cases:\n\n$$\n|5x+7| = 5x+7 \\qquad \\textrm{and}\\qquad |5x+7| = -(5x+7)\n$$\n\nWe now consider these two cases separately:\n\n- If $\\mid 5x +7|=5x +7$, we obtain the following equation:\n$5x +7 = 3x +9$\nWe now solve this equation using the usual methods:\n$$\n\\displaystyle 5x + 7|= 3x + 9; 2x + 7|= 9; 2x|= 2; x|= 1\n$$\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$$\n\\displaystyle \\mid 5x + 7 \\mid |= 3x + 9; \\mid 5(1) + 7 \\mid |= 3(1) + 9; \\mid 5 + 7 \\mid |= 3 + 9; \\mid 12 \\mid |= 12; 12|= 12✓\n$$\nSince $x=1$ satisfies the original equation, it's a valid solution.\n- If $\\mid 5x +7|=-(5x +7)$, we obtain the following equation:\n$-(5x +7)=3x +9$\nWe now solve this equation using the usual methods:\n$$\n\\displaystyle - (5x + 7)|= 3x + 9; - 5x - 7|= 3x + 9; - 7|= 8x + 9; - 16|= 8x; - 2|= x; x|=-2\n$$\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$$\n\\displaystyle \\mid 5x + 7 \\mid |= 3(-2) + 9; \\mid 5(-2) + 7 \\mid |= 3(-2) + 9; \\mid - 10 + 7 \\mid |=-6 + 9; \\mid - 3 \\mid |= 3; 3|= 3✓\n$$\nSince $x=-2$ satisfies the original equation, it's a valid solution.\n\nTherefore, the solutions of our equation are $x=-2, \\, 1$.\n\n![](images/a8/a8982c526d460e2968b5e06871f74adc32da549faeffa89ac58a39c4d84730d5.png)"] [:db/cas 17592186073448 :question/worked-solution "First, we count the number of triangles. We see that there are $4$ triangles.\n\nThen, we count the total number of shapes. We see that there are $6$ shapes in total.\n\nSo the ratio of triangles to total shapes is $4:6.$\n\nWe can simplify this ratio by dividing both numbers in the ratio by $2\\mathbin{:}$\n\n$$\n\\begin{aligned}\\,\\,4 &  & : & \\,\\,\\,\\, & \\,\\,\\,6 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,2 &  & : &  & \\,\\,\\,3 & \\end{aligned}\n$$\n\nTherefore, the ratio of triangles to the total shapes is $2:3.$" "First, we count the number of triangles. We see that there are $4$ triangles.\n\nThen, we count the total number of shapes. We see that there are $6$ shapes in total.\n\nSo the ratio of triangles to total shapes is $4:6.$\n\nWe can simplify this ratio by dividing both numbers in the ratio by $2\\mathbin{:}$\n\n$$\n\\begin{array}{llllll}\\,\\,4 &  & : & \\,\\,\\,\\, & \\,\\,\\,6 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,2 &  & : &  & \\,\\,\\,3 & \\end{array}\n$$\n\nTherefore, the ratio of triangles to the total shapes is $2:3.$"] [:db/cas 17592186073449 :question/worked-solution "First, we count the number of squares. We see that there are $2$ squares.\n\nThen, we count the number of circles. We see that there are $2$ circles.\n\nSo the ratio of circles to squares is $2:2.$\n\nWe can simplify this ratio by dividing both numbers by $2\\mathbin{:}$\n\n$$\n\\begin{aligned}\\,\\,2 &  & : & \\,\\,\\,\\, & \\,\\,\\,2 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,1 & \\end{aligned}\n$$\n\nThis means that $2:2$ is equivalent to $1:1.$ \n\nSo, the complete statement is\n\"The ratio of squares to circles is $1:\\bbox[3px,#d3d3d3]{1}\\,$ because there is $1$ square for every $\\bbox[3px,#d3d3d3]{1}\\,$circle.\"" "First, we count the number of squares. We see that there are $2$ squares.\n\nThen, we count the number of circles. We see that there are $2$ circles.\n\nSo the ratio of circles to squares is $2:2.$\n\nWe can simplify this ratio by dividing both numbers by $2\\mathbin{:}$\n\n$$\n\\begin{array}{llllll}\\,\\,2 &  & : & \\,\\,\\,\\, & \\,\\,\\,2 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,1 & \\end{array}\n$$\n\nThis means that $2:2$ is equivalent to $1:1.$ \n\nSo, the complete statement is\n\"The ratio of squares to circles is $1:\\bbox[3px,#d3d3d3]{1}\\,$ because there is $1$ square for every $\\bbox[3px,#d3d3d3]{1}\\,$circle.\""] [:db/cas 17592186073478 :question/worked-solution "We round both numbers to the nearest whole number:\n$$\n\\displaystyle 206.6\\begin{vmatrix}\\div & 3.43 \\\\ ↓ & ↓ \\\\ 207 & \\div\\end{vmatrix}3\n$$\n\nNow, we need to find the value of\n\n$$\n207 \\div 3\n$$\n\nSo, we go through the long division procedure as usual:\n\n| $6$$9$$3$$\\!\\!\\enclose{longdiv}{2 {\\:\\phantom{\\mid}} 0 {\\:\\phantom{\\mid}} 7}$$-\\!\\!\\!\\!$$1$$8$$2$$7$$-\\!\\!\\!\\!$$2$$7$$\\fbox{0}$ |\n| --- |\n\nTherefore, $206.6 \\div 3.43$ is approximately equal to $69$." "We round both numbers to the nearest whole number:\n$$\n\\begin{array}{ccc}206.6 & ÷ & 3.43 \\\\ ↓ &  & ↓ \\\\ {\\color{blue}{207}} & ÷ & {\\color{blue}{3}}\\end{array}\n$$\n\nNow, we need to find the value of\n\n$$\n207 \\div 3\n$$\n\nSo, we go through the long division procedure as usual:\n\n| $6$$9$$3$$\\!\\!\\enclose{longdiv}{2 {\\:\\phantom{\\mid}} 0 {\\:\\phantom{\\mid}} 7}$$-\\!\\!\\!\\!$$1$$8$$2$$7$$-\\!\\!\\!\\!$$2$$7$$\\fbox{0}$ |\n| --- |\n\nTherefore, $206.6 \\div 3.43$ is approximately equal to $69$."] [:db/cas 17592186073479 :question/worked-solution "We round both numbers to the nearest whole number:\n$$\n\\displaystyle 116.8\\begin{vmatrix}\\div & 5.15 \\\\ ↓ & ↓ \\\\ 117 & \\div\\end{vmatrix}5\n$$\n\nNow, we need to find the value of\n$117\\div 5$.\n\nSo, we go through the long division procedure as usual:\n\n|  |  | $2$ | $3$ |\n| --- | ---: | ---: | ---: |\n| $5$ | $\\!\\!\\enclose{longdiv}{1 {\\:\\phantom{\\mid}} 1 {\\:\\phantom{\\mid}} 7}$ |  |  |\n| $-\\!\\!\\!\\!\\!\\!\\!$ | $1$ | $0$ |  |\n|  |  | $1$ | $7$ |\n|  | $-\\!\\!\\!\\!\\!$ | $1$ | $5$ |\n|  |  |  | $\\fbox{2}$ |\n\nTherefore,\n\n$$\n117 \\div 5 = 23\\,\\text{R}2\n$$\n\nThe remainder $2$ is closer to $0$ than to the divisor $5$. So, to round to the nearest whole number, we must round down:\n\n$$\n117 \\div 5 \\rightarrow 23\n$$\n\nTherefore, $116.8 \\div 5.15$ is approximately equal to $23$." "We round both numbers to the nearest whole number:\n$$\n\\begin{array}{ccc}116.8 & ÷ & 5.15 \\\\ ↓ &  & ↓ \\\\ {\\color{blue}{117}} & ÷ & {\\color{blue}{5}}\\end{array}\n$$\n\nNow, we need to find the value of\n$117\\div 5$.\n\nSo, we go through the long division procedure as usual:\n\n|  |  | $2$ | $3$ |\n| --- | ---: | ---: | ---: |\n| $5$ | $\\!\\!\\enclose{longdiv}{1 {\\:\\phantom{\\mid}} 1 {\\:\\phantom{\\mid}} 7}$ |  |  |\n| $-\\!\\!\\!\\!\\!\\!\\!$ | $1$ | $0$ |  |\n|  |  | $1$ | $7$ |\n|  | $-\\!\\!\\!\\!\\!$ | $1$ | $5$ |\n|  |  |  | $\\fbox{2}$ |\n\nTherefore,\n\n$$\n117 \\div 5 = 23\\,\\text{R}2\n$$\n\nThe remainder $2$ is closer to $0$ than to the divisor $5$. So, to round to the nearest whole number, we must round down:\n\n$$\n117 \\div 5 \\rightarrow 23\n$$\n\nTherefore, $116.8 \\div 5.15$ is approximately equal to $23$."] [:db/cas 17592186074992 :tutorial/content "Consider the right triangle below.\n\n![](images/cd/cd056cb2c92d918412778089c0744525fb676a79047b0e779161c68db8210d54.png)\n\nWe know that\n\n$$\n\\begin{bmatrix}\\sin A = \\frac{BC}{AC}, & \\cos C = \\frac{BC}{AC}, \\\\ \\cos A = \\frac{AB}{AC}, & \\sin C = \\frac{AB}{AC}\\end{bmatrix}\n$$\n\nConsequently,\n\n$$\n\\sin A = \\cos C\n$$\n\nand\n\n$$\n\\cos A = \\sin C\n$$\n\nNow, let\n\n$$\nm\\angle A =\\theta\n$$\n\nThen, since $\\angle A$ and $\\angle C$ are complementary, we have\n\n$$\nm\\angle C = 90^\\circ - \\theta\n$$\n\nand we conclude that\n\n$$\n\\begin{aligned}\n\\sin θ &= \\cos (90^{∘} - θ) \\\\\n\\cos θ &= \\sin (90^{∘} - θ)\n\\end{aligned}\n$$\n\nIn other words,\n\n- the sine of an angle equals the cosine of its complement, and\n- the cosine of an angle equals the sine of its complement.\n\nSine and cosine are known as **cofunctions**. The latter is called **co**sine to indicate that it is the **co**function of sine." "Consider the right triangle below.\n\n![](images/cd/cd056cb2c92d918412778089c0744525fb676a79047b0e779161c68db8210d54.png)\n\nWe know that\n\n$$\n\\begin{array}{cc}\\operatorname{sin}A=\\frac{BC}{AC}, & \\hspace{1em}\\operatorname{cos}C=\\frac{BC}{AC}, \\\\ \\operatorname{cos}A=\\frac{AB}{AC}, & \\hspace{1em}\\operatorname{sin}C=\\frac{AB}{AC}.\\end{array}\n$$\n\nConsequently,\n\n$$\n\\sin A = \\cos C\n$$\n\nand\n\n$$\n\\cos A = \\sin C\n$$\n\nNow, let\n\n$$\nm\\angle A =\\theta\n$$\n\nThen, since $\\angle A$ and $\\angle C$ are complementary, we have\n\n$$\nm\\angle C = 90^\\circ - \\theta\n$$\n\nand we conclude that\n\n$$\n\\begin{aligned}\n\\sin θ &= \\cos (90^{∘} - θ) \\\\\n\\cos θ &= \\sin (90^{∘} - θ)\n\\end{aligned}\n$$\n\nIn other words,\n\n- the sine of an angle equals the cosine of its complement, and\n- the cosine of an angle equals the sine of its complement.\n\nSine and cosine are known as **cofunctions**. The latter is called **co**sine to indicate that it is the **co**function of sine."] [:db/cas 17592186075007 :tutorial/content "A **biquadratic equation** is a polynomial of degree $4$ that has only even powers of the variable. For example,\n\n- the equation $a^{\\color{blue}4}-3a^{\\color{blue}2}+2=0$ is a biquadratic equation because the exponents $\\color{blue}4$ and $\\color{blue}2$ are both even, while\n- the equation $a^{\\color{blue}4}+3a^{\\color{blue}1}+2=0$ is *not* a biquadratic equation because the exponents $\\color{blue}4$ and $\\color{blue}1$ are *not* both even.\n\nSolving a biquadratic may seem daunting because of the higher powers, but there is a trick! We just substitute a new variable in the place of the original variable squared.\n\nFor example, to solve the equation\n\n$$\na^4-3a^2+2=0\n$$\n\n, just let $b = a^2$ and substitute $b$ in the place of $a^2$. Then, we can solve for $b$ as follows:\n\nLet's work it out:\n\n$$\n\\begin{aligned} a^4-3a^2+2 &= 0 \\ \\left(a^2\\right)^2 - 3\\left(a^2\\right) +2 &= 0 \\\\ (b)^2 - 3(b) + 2 &= 0 \\\\ b^2 - 3b + 2&= 0 \\\\ (b-1)(b - 2) &= 0 \\\\ b &= 1,2 \\end{aligned}\n$$\n\nWe have the solutions $b=1,2$. However, the original equation was given in terms of $a$, so we need to find the corresponding values of $a$. To do this, we substitute $a^2$ back in for $b$ and solve for $a$:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}a^{2} &= 1 & ⇒ & a|= ± 1 \\\\ a^{2}|= 2 & ⇒ & a|= ± \\sqrt{2}\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\na = \\pm 1, \\pm \\sqrt{2}\n$$" "A **biquadratic equation** is a polynomial of degree $4$ that has only even powers of the variable. For example,\n\n- the equation $a^{\\color{blue}4}-3a^{\\color{blue}2}+2=0$ is a biquadratic equation because the exponents $\\color{blue}4$ and $\\color{blue}2$ are both even, while\n- the equation $a^{\\color{blue}4}+3a^{\\color{blue}1}+2=0$ is *not* a biquadratic equation because the exponents $\\color{blue}4$ and $\\color{blue}1$ are *not* both even.\n\nSolving a biquadratic may seem daunting because of the higher powers, but there is a trick! We just substitute a new variable in the place of the original variable squared.\n\nFor example, to solve the equation\n\n$$\na^4-3a^2+2=0\n$$\n\n, just let $b = a^2$ and substitute $b$ in the place of $a^2$. Then, we can solve for $b$ as follows:\n\nLet's work it out:\n\n$$\n\\begin{aligned} a^4-3a^2+2 &= 0 \\ \\left(a^2\\right)^2 - 3\\left(a^2\\right) +2 &= 0 \\\\ (b)^2 - 3(b) + 2 &= 0 \\\\ b^2 - 3b + 2&= 0 \\\\ (b-1)(b - 2) &= 0 \\\\ b &= 1,2 \\end{aligned}\n$$\n\nWe have the solutions $b=1,2$. However, the original equation was given in terms of $a$, so we need to find the corresponding values of $a$. To do this, we substitute $a^2$ back in for $b$ and solve for $a$:\n\n$$\n\\begin{aligned}{a}^{2} & =1 & \\hspace{0.167em} & \\Rightarrow  & \\hspace{0.167em}a & =\\pm 1 \\\\ {a}^{2} & =2 & \\hspace{0.167em} & \\Rightarrow  & \\hspace{0.167em}a & =\\pm \\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\na = \\pm 1, \\pm \\sqrt{2}\n$$"] [:db/cas 17592186075034 :tutorial/content "We can find **equivalent ratios** by multiplying or dividing all numbers in a ratio by the same value. \n\nTo demonstrate, let's consider the following ratio:\n\n$$\n2:6\n$$\n\nIf we multiply *both* numbers by $5,$ for example, we get the ratio $10:30.$\n\n$$\n\\begin{aligned}\\,\\,2 &  & : & \\,\\,\\, & \\,\\,6 &  \\\\ \\,\\,↓\\times \\,5 &  &  &  & \\,\\,↓\\times \\,5 &  \\\\ \\,10 &  & : &  & \\,30 & \\end{aligned}\n$$\n\nTherefore, the ratios $2:6$ and $10:30$ are equivalent. \n\nSimilarly, if we take the ratio $2:6$ and divide *both* numbers by $2,$ we get $1:3.$\n\n$$\n\\begin{aligned}\\,\\,2 &  & : & \\,\\,\\, & \\,\\,6 &  \\\\ \\,\\,↓÷\\,2 &  &  &  & \\,\\,↓÷\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,3 & \\end{aligned}\n$$\n\nTherefore, the ratios  $2:6$ and  $1:3$ are also equivalent." "We can find **equivalent ratios** by multiplying or dividing all numbers in a ratio by the same value. \n\nTo demonstrate, let's consider the following ratio:\n\n$$\n2:6\n$$\n\nIf we multiply *both* numbers by $5,$ for example, we get the ratio $10:30.$\n\n$$\n\\begin{array}{llllll}\\,\\,2 &  & : & \\,\\,\\, & \\,\\,6 &  \\\\ \\,\\,↓\\times \\,5 &  &  &  & \\,\\,↓\\times \\,5 &  \\\\ \\,10 &  & : &  & \\,30 & \\end{array}\n$$\n\nTherefore, the ratios $2:6$ and $10:30$ are equivalent. \n\nSimilarly, if we take the ratio $2:6$ and divide *both* numbers by $2,$ we get $1:3.$\n\n$$\n\\begin{array}{llllll}\\,\\,2 &  & : & \\,\\,\\, & \\,\\,6 &  \\\\ \\,\\,↓÷\\,2 &  &  &  & \\,\\,↓÷\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,3 & \\end{array}\n$$\n\nTherefore, the ratios  $2:6$ and  $1:3$ are also equivalent."] [:db/cas 17592186075036 :tutorial/content "We can simplify ratios by dividing both numbers in the ratio by a common factor.\n\nTo demonstrate, let's simplify the following ratio: \n\n$$\n18:9\n$$\n\nThe numbers $18$ and $9$ share a common factor of $9,$ so we can divide both numbers by $9$ as follows:\n\n$$\n\\begin{aligned}\\,\\,18 &  & : & \\,\\,\\,\\, & \\,\\,\\,9 &  \\\\ \\,\\,↓÷\\,\\,9 &  &  &  & \\,\\,\\,↓÷\\,\\,9 &  \\\\ \\,\\,2 &  & : &  & \\,\\,\\,1 & \\end{aligned}\n$$\n\nTherefore, $18:9$ is equivalent to $2:1.$ \n\nSince $2$ and $1$ have no common factors, $2:1$ is the simplest form of this ratio. We often prefer to work with ratios in their simplest form, where possible." "We can simplify ratios by dividing both numbers in the ratio by a common factor.\n\nTo demonstrate, let's simplify the following ratio: \n\n$$\n18:9\n$$\n\nThe numbers $18$ and $9$ share a common factor of $9,$ so we can divide both numbers by $9$ as follows:\n\n$$\n\\begin{array}{llllll}\\,\\,18 &  & : & \\,\\,\\,\\, & \\,\\,\\,9 &  \\\\ \\,\\,↓÷\\,\\,9 &  &  &  & \\,\\,\\,↓÷\\,\\,9 &  \\\\ \\,\\,2 &  & : &  & \\,\\,\\,1 & \\end{array}\n$$\n\nTherefore, $18:9$ is equivalent to $2:1.$ \n\nSince $2$ and $1$ have no common factors, $2:1$ is the simplest form of this ratio. We often prefer to work with ratios in their simplest form, where possible."] [:db/cas 17592186075048 :tutorial/content "We can estimate decimal division by rounding each decimal to the nearest whole number and dividing the resulting numbers.\n\nFor example, suppose we wish to estimate the quotient of the following division problem.\n$19.7 \\div 5.3$\n\nOne way to proceed is first to round both quantities to the nearest whole number:\n\n$$\n19.7\\begin{vmatrix}\\div & 5.3 \\\\ ↓ & ↓ \\\\ 20 & \\div\\end{vmatrix}5\n$$\n\nSo, we can form an estimate of $19.7 \\div 5.3$ by evaluating $20 \\div 5$.\n\nComputing the quotient of this simplified problem gives\n\n$$\n20 \\div 5 = 4\n$$\n\nTherefore, $19.7 \\div 5.3$ is approximately equal to $4$. We can write this symbolically as follows:\n\n$$\n19.7 \\div 5.3 \\approx 4\n$$\n\nThe symbol\n\n$$\n\\approx\n$$\n\nmeans \"is approximately equal to.\"" "We can estimate decimal division by rounding each decimal to the nearest whole number and dividing the resulting numbers.\n\nFor example, suppose we wish to estimate the quotient of the following division problem.\n$19.7 \\div 5.3$\n\nOne way to proceed is first to round both quantities to the nearest whole number:\n\n$$\n\\begin{array}{ccc}19.7 & ÷ & 5.3 \\\\ ↓ &  & ↓ \\\\ {\\color{blue}{20}} & ÷ & {\\color{blue}{5}}\\end{array}\n$$\n\nSo, we can form an estimate of $19.7 \\div 5.3$ by evaluating $20 \\div 5$.\n\nComputing the quotient of this simplified problem gives\n\n$$\n20 \\div 5 = 4\n$$\n\nTherefore, $19.7 \\div 5.3$ is approximately equal to $4$. We can write this symbolically as follows:\n\n$$\n19.7 \\div 5.3 \\approx 4\n$$\n\nThe symbol\n\n$$\n\\approx\n$$\n\nmeans \"is approximately equal to.\""] [:db/cas 17592186075051 :tutorial/content "Suppose $M(4,2)$ is the midpoint between $A(1,1)$ and $B(a,b)$. What are the values of $a$ and $b$?\n\n![](images/d9/d946b98f81c7f30ff5a277c337be47dc743de531e3b138795d4a15f34ad82d54.png)\n\nAgain, we use the midpoint formula:\n\n$$\n\\begin{aligned}\n(x_{m}, y_{m}) &= (\\frac{x_{1} + x_{2}}{2}, \\frac{y_{1} + y_{2}}{2})\n\\end{aligned}\n$$\n\nWe have\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}x_{1} &= 1, & y_{1}|= 1, \\\\ x_{2}|= a, & y_{2}|= b, \\\\ x_{m}|= 4, & y_{m}|= 2\\end{bmatrix}\n\\end{aligned}\n$$\n\nSubstituting the known values in the formula, we obtain\n\n$$\n\\begin{aligned}\n(4, 2) &= (\\frac{1 + a}{2}, \\frac{1 + b}{2})\n\\end{aligned}\n$$\n\nSetting the $x$-coordinates equal to each other and the $y$-coordinates equal to each other, we have the following two equations:\n\n$$\n{\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 4 = {\\displaystyle \\frac{1 + a}{2}} \\\\ \\displaystyle 2 = {\\displaystyle \\frac{1 + b}{2}}\\end{array} \\right. \\end{array}}\n$$\n\nMultiplying both sides of the equations by $2$, we have:\n\n$$\n{\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 8 = 1 + a \\\\ \\displaystyle 4 = 1 + b\\end{array} \\right. \\end{array}}\n$$\n\nFinally, we solve both equations independently:\n\n$$\n{\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle a = 8 - 1 = 7 \\\\ \\displaystyle b = 4 - 1 = 3.\\end{array} \\right. \\end{array}}\n$$\n\nTherefore, $a=7$ and $b=3$." "Suppose $M(4,2)$ is the midpoint between $A(1,1)$ and $B(a,b)$. What are the values of $a$ and $b$?\n\n![](images/d9/d946b98f81c7f30ff5a277c337be47dc743de531e3b138795d4a15f34ad82d54.png)\n\nAgain, we use the midpoint formula:\n\n$$\n\\begin{aligned}\n(x_{m}, y_{m}) &= (\\frac{x_{1} + x_{2}}{2}, \\frac{y_{1} + y_{2}}{2})\n\\end{aligned}\n$$\n\nWe have\n\n$$\n\\begin{aligned}{x}_{1} & =1, & {y}_{1} & =1, \\\\ {x}_{2} & =a, & {y}_{2} & =b, \\\\ {x}_{m} & =4, & {y}_{m} & =2.\\end{aligned}\n$$\n\nSubstituting the known values in the formula, we obtain\n\n$$\n\\begin{aligned}\n(4, 2) &= (\\frac{1 + a}{2}, \\frac{1 + b}{2})\n\\end{aligned}\n$$\n\nSetting the $x$-coordinates equal to each other and the $y$-coordinates equal to each other, we have the following two equations:\n\n$$\n{\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 4 = {\\displaystyle \\frac{1 + a}{2}} \\\\ \\displaystyle 2 = {\\displaystyle \\frac{1 + b}{2}}\\end{array} \\right. \\end{array}}\n$$\n\nMultiplying both sides of the equations by $2$, we have:\n\n$$\n{\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle 8 = 1 + a \\\\ \\displaystyle 4 = 1 + b\\end{array} \\right. \\end{array}}\n$$\n\nFinally, we solve both equations independently:\n\n$$\n{\\begin{array}{r}\\displaystyle \\left\\{  \\begin{array}{l}\\displaystyle a = 8 - 1 = 7 \\\\ \\displaystyle b = 4 - 1 = 3.\\end{array} \\right. \\end{array}}\n$$\n\nTherefore, $a=7$ and $b=3$."] [:db/cas 17592186075347 :answer/value "lim_(x → π)f(x) = π" "\\lim_{x \\to  π}f(x) = π"] [:db/cas 17592186075348 :answer/value "lim_(x → π)f(x) = 1" "\\lim_{x \\to  π}f(x) = 1"] [:db/cas 17592186075349 :answer/value "lim_(x → π)f(x) = 2" "\\lim_{x \\to  π}f(x) = 2"] [:db/cas 17592186075350 :answer/value "lim_(x → π)f(x) = 0" "\\lim_{x \\to  π}f(x) = 0"] [:db/cas 17592186075351 :answer/value "lim_(x → π)f(x) = DNE" "\\lim_{x \\to  π}f(x) = DNE"] [:db/cas 17592186075353 :answer/value "lim_(x → 1)f(x) = DNE" "\\lim_{x \\to  1}f(x) = DNE"] [:db/cas 17592186075354 :answer/value "lim_(x → 1)f(x) = 0" "\\lim_{x \\to  1}f(x) = 0"] [:db/cas 17592186075355 :answer/value "lim_(x → 1)f(x) = 2" "\\lim_{x \\to  1}f(x) = 2"] [:db/cas 17592186075356 :answer/value "lim_(x → 1)f(x) = 1" "\\lim_{x \\to  1}f(x) = 1"] [:db/cas 17592186075357 :answer/value "lim_(x → 1)f(x) = \\frac{1}{2}" "\\lim_{x \\to  1}f(x) = \\frac{1}{2}"] [:db/cas 17592186075359 :answer/value "lim_(x → - 1)f(x) =-1" "\\lim_{x \\to  - 1}f(x) =-1"] [:db/cas 17592186075360 :answer/value "lim_(x → - 1)f(x) = 1" "\\lim_{x \\to  - 1}f(x) = 1"] [:db/cas 17592186075361 :answer/value "lim_(x → - 1)f(x) = \\frac{1}{4}" "\\lim_{x \\to  - 1}f(x) = \\frac{1}{4}"] [:db/cas 17592186075362 :answer/value "lim_(x → - 1)f(x) = DNE" "\\lim_{x \\to  - 1}f(x) = DNE"] [:db/cas 17592186075363 :answer/value "lim_(x → - 1)f(x) = \\frac{1}{2}" "\\lim_{x \\to  - 1}f(x) = \\frac{1}{2}"] [:db/cas 17592186078173 :question/worked-solution "First, we draw the corresponding straight line\n\n$$\ny=-x+2\n$$\n\nSince the inequality involves a 'strictly greater than' sign, the line\n\n$$\ny=-x+2\n$$\n\nitself is *not* part of the solution. Therefore, we draw a **dashed line.**\n\n![](images/60/60af5fdbf308cd733c74ccdb655c8ce35bfb3f243cb1ed60ec1d754a6e7a52ca.png)\n\nThen, we must decide whether to shade above or below the line. The inequality $y > -x+2$ refers to the $y$-values that are *greater than* those on the line\n\n$$\ny=-x+2\n$$\n\nso we shade *above* the line.\n\n![](images/9d/9de02d7ebcc415c0cc21dbf2f9e11779e6341462545a7f08c74b7ce3e0fd44f0.png)\n\nLet's now check that we've shaded the correct part. First, we consider a point in the shaded region, say $(3,0)$.\n\n![](images/23/23aa9fe89c286702b371c1d8bac4c895a7a3593c381253a5434ce2b78423028f.png)\n\nWhen we substitute the coordinates of this point into our inequality, we get a true statement:\n\n$$\n\\begin{bmatrix}y & > - x + 2 \\\\ (0) & > - (3) + 2 \\\\ 0 & > - 1✓\\end{bmatrix}\n$$\n\nThis indicates that we have shaded the correct region." "First, we draw the corresponding straight line\n\n$$\ny=-x+2\n$$\n\nSince the inequality involves a 'strictly greater than' sign, the line\n\n$$\ny=-x+2\n$$\n\nitself is *not* part of the solution. Therefore, we draw a **dashed line.**\n\n![](images/60/60af5fdbf308cd733c74ccdb655c8ce35bfb3f243cb1ed60ec1d754a6e7a52ca.png)\n\nThen, we must decide whether to shade above or below the line. The inequality $y > -x+2$ refers to the $y$-values that are *greater than* those on the line\n\n$$\ny=-x+2\n$$\n\nso we shade *above* the line.\n\n![](images/9d/9de02d7ebcc415c0cc21dbf2f9e11779e6341462545a7f08c74b7ce3e0fd44f0.png)\n\nLet's now check that we've shaded the correct part. First, we consider a point in the shaded region, say $(3,0)$.\n\n![](images/23/23aa9fe89c286702b371c1d8bac4c895a7a3593c381253a5434ce2b78423028f.png)\n\nWhen we substitute the coordinates of this point into our inequality, we get a true statement:\n\n$$\n\\begin{aligned}y & >-x+2 \\\\ (0) & >-(3)+2 \\\\ 0 & >-1\\hspace{0.222em}{\\color{darkgreen}{✓}}\\end{aligned}\n$$\n\nThis indicates that we have shaded the correct region."] [:db/cas 17592186078174 :question/worked-solution "First, we draw the corresponding straight line\n\n$$\ny=-2x+4\n$$\n\nSince the inequality involves a 'strictly less than' sign, the line\n\n$$\ny=-2x+4\n$$\n\nitself is *not* part of the solution. Therefore, we draw a **dashed line.**\n\n![](images/75/75f17da6637e696cd97d49d844818bb0810bbf7abc4a0507ac72dbe4b0a3ceb0.png)\n\nThen, we must decide whether to shade above or below the line. The inequality $y < -2x+4$ refers to the $y$-values that are *less than* those on the line\n\n$$\ny=-2x+4\n$$\n\nso we shade *below* the line.\n\n![](images/fc/fcf1027f755d36d9d7e69f96587fe9db7bd3e45aa5983ab201102af333b71630.png)\n\nLet's now check that we've shaded the correct part. First, we consider a point in the shaded region, say $(-1,0)$.\n\n![](images/4c/4c9dc318b193851cf8454b02c798225631f5f6fb62a40b047e4ffa50aec1cee6.png)\n\nWhen we substitute the coordinates of this point into our inequality, we get a true statement:\n\n$$\n\\begin{bmatrix}y & < - 2x + 4 \\\\ (0) & < - 2(-1) + 4 \\\\ 0 & < 6✓\\end{bmatrix}\n$$\n\nThis indicates that we have shaded the correct region." "First, we draw the corresponding straight line\n\n$$\ny=-2x+4\n$$\n\nSince the inequality involves a 'strictly less than' sign, the line\n\n$$\ny=-2x+4\n$$\n\nitself is *not* part of the solution. Therefore, we draw a **dashed line.**\n\n![](images/75/75f17da6637e696cd97d49d844818bb0810bbf7abc4a0507ac72dbe4b0a3ceb0.png)\n\nThen, we must decide whether to shade above or below the line. The inequality $y < -2x+4$ refers to the $y$-values that are *less than* those on the line\n\n$$\ny=-2x+4\n$$\n\nso we shade *below* the line.\n\n![](images/fc/fcf1027f755d36d9d7e69f96587fe9db7bd3e45aa5983ab201102af333b71630.png)\n\nLet's now check that we've shaded the correct part. First, we consider a point in the shaded region, say $(-1,0)$.\n\n![](images/4c/4c9dc318b193851cf8454b02c798225631f5f6fb62a40b047e4ffa50aec1cee6.png)\n\nWhen we substitute the coordinates of this point into our inequality, we get a true statement:\n\n$$\n\\begin{aligned}y & <-2x+4 \\\\ (0) & <-2(-1)+4 \\\\ 0 & <6\\hspace{0.222em}{\\color{darkgreen}{✓}}\\end{aligned}\n$$\n\nThis indicates that we have shaded the correct region."] [:db/cas 17592186078220 :question/worked-solution "At $x=0,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}\\sqrt{2b-3x} \\\\  & =\\sqrt{2b-3(0)} \\\\  & =\\sqrt{2b},\\end{aligned}\n$$\n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to {0}^{+}}(-x+2) \\\\  & =-(0)+2 \\\\  & =2.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=0,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{+}}f(x) \\\\ 2 & =\\sqrt{2b} \\\\ 4 & =2b \\\\ b & =2.\\end{aligned}\n$$" "At $x=0,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{-}}\\sqrt{2b-3x} \\\\  & =\\sqrt{2b-3(0)} \\\\  & =\\sqrt{2b},\\end{aligned}\n$$\n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{+}}f(x) & =\\lim_{x\\to {0}^{+}}(-x+2) \\\\  & =-(0)+2 \\\\  & =2.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=0,$ we require that\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{+}}f(x) \\\\ 2 & =\\sqrt{2b} \\\\ 4 & =2b \\\\ b & =2.\\end{aligned}\n$$"] [:db/cas 17592186078222 :question/worked-solution "At $x=2,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{-}}(2x+a)^{2} \\\\  & =(2(2)+a)^{2} \\\\  & =(4+a)^{2},\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}({x}^{2}-3) \\\\  & =(2)^{2}-3 \\\\  & =4-3 \\\\  & =1.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=2,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{+}}f(x) \\\\ (4+a)^{2} & =1 \\\\ \\sqrt{(a+4)^{2}} & =\\sqrt{1} \\\\ |a+4| & =1 \\\\ a+4 & =\\pm 1 \\\\ a & =-4\\pm 1 \\\\ a & =-5,-3.\\end{aligned}\n$$\n\nTherefore, $f(x)$ is continuous at $x=2$ for $a=-5$ or $a=-3.$" "At $x=2,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{-}}f(x) & =\\lim_{x\\to {2}^{-}}(2x+a)^{2} \\\\  & =(2(2)+a)^{2} \\\\  & =(4+a)^{2},\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{+}}f(x) & =\\lim_{x\\to {2}^{+}}({x}^{2}-3) \\\\  & =(2)^{2}-3 \\\\  & =4-3 \\\\  & =1.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=2,$ we require that\n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{-}}f(x) & =\\lim_{x\\to {2}^{+}}f(x) \\\\ (4+a)^{2} & =1 \\\\ \\sqrt{(a+4)^{2}} & =\\sqrt{1} \\\\ |a+4| & =1 \\\\ a+4 & =\\pm 1 \\\\ a & =-4\\pm 1 \\\\ a & =-5,-3.\\end{aligned}\n$$\n\nTherefore, $f(x)$ is continuous at $x=2$ for $a=-5$ or $a=-3.$"] [:db/cas 17592186078225 :question/worked-solution "At $x=1,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}g(x) & ={lim}_{x\\to {1}^{-}}{log}_{2}⁡(ax+1) \\\\  & ={log}_{2}⁡(a(1)+1) \\\\  & ={log}_{2}⁡(a+1),\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}g(x) & ={lim}_{x\\to {1}^{+}}({log}_{3}⁡(2x+1)) \\\\  & ={log}_{3}⁡(2(1)+1) \\\\  & ={log}_{3}⁡(3) \\\\  & =1.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=1,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}g(x) & ={lim}_{x\\to {1}^{+}}g(x) \\\\ {log}_{2}⁡(a+1) & =1 \\\\ a+1 & ={2}^{1} \\\\ a & =1.\\end{aligned}\n$$" "At $x=1,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}g(x) & =\\lim_{x\\to {1}^{-}}{log}_{2}⁡(ax+1) \\\\  & ={log}_{2}⁡(a(1)+1) \\\\  & ={log}_{2}⁡(a+1),\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}g(x) & =\\lim_{x\\to {1}^{+}}({log}_{3}⁡(2x+1)) \\\\  & ={log}_{3}⁡(2(1)+1) \\\\  & ={log}_{3}⁡(3) \\\\  & =1.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=1,$ we require that\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}g(x) & =\\lim_{x\\to {1}^{+}}g(x) \\\\ {log}_{2}⁡(a+1) & =1 \\\\ a+1 & ={2}^{1} \\\\ a & =1.\\end{aligned}\n$$"] [:db/cas 17592186078228 :question/worked-solution "The horizontal asymptote of $y=f(x)$ is\n\n$$\ny=\\lim_\\limits{x \\rightarrow \\infty} f(x)\n$$\n\nTo evaluate the limit, note that the $x^4$ in the radical is a perfect square, so we can rewrite the function as\n\n$$\n\\begin{aligned}\nlim_(x → ∞)f(x) &= \\frac{\\sqrt{2x^{4} + 5}}{x^{2} + 3} \\\\\n&= lim_(x → ∞)(\\sqrt{x^{4}(2 + \\frac{5}{x^{4}})})/(x^{2} + 3) \\\\\n&= lim_(x → ∞)\\frac{\\sqrt{x^{4}} \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3} \\\\\n&= lim_(x → ∞)\\frac{\\mid x^{2} \\mid \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3}\n\\end{aligned}\n$$\n\nSince $x^2>0$ for all $x$, we have\n\n$$\n\\begin{aligned}\n\\mid x^2 &= x^2\n\\end{aligned}\n$$\n\n$$\nlim_(x → ∞)\\frac{\\mid x^{2} \\mid \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3} = lim_(x → ∞)\\frac{x^{2} \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3}\n$$\n\nNow, we divide the top and bottom of the fraction by $x^2$ and evaluate the limit, which gives\n\n$$\nlim_(x → ∞)\\frac{\\sqrt{2 + \\frac{5}{x^{4}}}}{1 + \\frac{3}{x^{2}}} = lim_(x → ∞)\\frac{\\sqrt{2 + 0}}{1 + 0} = \\sqrt{2}\n$$\n\nTherefore, the horizontal asymptote is\n\n$$\ny=\\sqrt{2}\n$$" "The horizontal asymptote of $y=f(x)$ is\n\n$$\ny=\\lim_{x \\rightarrow \\infty} f(x)\n$$\n\nTo evaluate the limit, note that the $x^4$ in the radical is a perfect square, so we can rewrite the function as\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  \\infty}f(x) &= \\frac{\\sqrt{2x^{4} + 5}}{x^{2} + 3} \\\\\n&= \\lim_{x \\to  \\infty}(\\sqrt{x^{4}(2 + \\frac{5}{x^{4}})})/(x^{2} + 3) \\\\\n&= \\lim_{x \\to  \\infty}\\frac{\\sqrt{x^{4}} \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3} \\\\\n&= \\lim_{x \\to  \\infty}\\frac{\\mid x^{2} \\mid \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3}\n\\end{aligned}\n$$\n\nSince $x^2>0$ for all $x$, we have\n\n$$\n\\begin{aligned}\n\\mid x^2 &= x^2\n\\end{aligned}\n$$\n\n$$\n\\lim_{x \\to  \\infty}\\frac{\\mid x^{2} \\mid \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3} = \\lim_{x \\to  \\infty}\\frac{x^{2} \\cdot \\sqrt{2 + \\frac{5}{x^{4}}}}{x^{2} + 3}\n$$\n\nNow, we divide the top and bottom of the fraction by $x^2$ and evaluate the limit, which gives\n\n$$\n\\lim_{x \\to  \\infty}\\frac{\\sqrt{2 + \\frac{5}{x^{4}}}}{1 + \\frac{3}{x^{2}}} = \\lim_{x \\to  \\infty}\\frac{\\sqrt{2 + 0}}{1 + 0} = \\sqrt{2}\n$$\n\nTherefore, the horizontal asymptote is\n\n$$\ny=\\sqrt{2}\n$$"] [:db/cas 17592186078229 :question/worked-solution "We note that the $x^2$ in the radical is a perfect square, so we can rewrite the function as\n\n$$\n\\begin{aligned}\nlim_(x → ∞)\\frac{\\sqrt{2x^{2} - 3x}}{x^{2} + x} &= lim_(x → ∞)(\\sqrt{x^{2}(2 - \\frac{3x}{x^{2}})})/(x^{2} + x) = lim_(x → ∞)\\frac{\\sqrt{x^{2}} \\cdot \\sqrt{2 - \\frac{3}{x}}}{x^{2} + x}\n\\end{aligned}\n$$\n\nNote that\n\n$$\n\\sqrt{x^2}= \\mid x \\mid\n$$\n\nSince $x \\to \\infty$, we have $x>0$, and therefore\n\n$$\n\\begin{aligned}\n\\sqrt{x^2}= \\mid x &= x\n\\end{aligned}\n$$\n\nSo, the above reduces to\n\n$$\nlim_(x → ∞)\\frac{x \\cdot \\sqrt{2 - \\frac{3}{x}}}{x^{2} + x}\n$$\n\nNow, we divide the top and bottom of the fraction by $x^2$ and evaluate the limit, which gives\n\n$$\n\\begin{aligned}\nlim_(x → ∞)\\frac{\\frac{1}{x}\\sqrt{2 - \\frac{3}{x}}}{1 + \\frac{1}{x}} &= \\frac{0 \\cdot \\sqrt{2 - 0}}{1 + 0} = 0\n\\end{aligned}\n$$" "We note that the $x^2$ in the radical is a perfect square, so we can rewrite the function as\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  \\infty}\\frac{\\sqrt{2x^{2} - 3x}}{x^{2} + x} &= \\lim_{x \\to  \\infty}(\\sqrt{x^{2}(2 - \\frac{3x}{x^{2}})})/(x^{2} + x) = \\lim_{x \\to  \\infty}\\frac{\\sqrt{x^{2}} \\cdot \\sqrt{2 - \\frac{3}{x}}}{x^{2} + x}\n\\end{aligned}\n$$\n\nNote that\n\n$$\n\\sqrt{x^2}= \\mid x \\mid\n$$\n\nSince $x \\to \\infty$, we have $x>0$, and therefore\n\n$$\n\\begin{aligned}\n\\sqrt{x^2}= \\mid x &= x\n\\end{aligned}\n$$\n\nSo, the above reduces to\n\n$$\n\\lim_{x \\to  \\infty}\\frac{x \\cdot \\sqrt{2 - \\frac{3}{x}}}{x^{2} + x}\n$$\n\nNow, we divide the top and bottom of the fraction by $x^2$ and evaluate the limit, which gives\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  \\infty}\\frac{\\frac{1}{x}\\sqrt{2 - \\frac{3}{x}}}{1 + \\frac{1}{x}} &= \\frac{0 \\cdot \\sqrt{2 - 0}}{1 + 0} = 0\n\\end{aligned}\n$$"] [:db/cas 17592186078230 :question/worked-solution "The horizontal asymptote of $f(x)$ in the domain $x< 0$ is\n\n$$\ny=\\lim_\\limits{x \\rightarrow -\\infty} f(x)\n$$\n\nTo find the horizontal asymptote, we note that the $x^6$ in the radical is a perfect square, and so we rewrite the function as\n\n$$\n\\begin{aligned}\nlim_(x → - ∞)f(x) &= lim_(x → - ∞)\\frac{2x^{4} + x}{\\sqrt{x^{6} - x}}, \\\\\n&= lim_(x → - ∞)(2x^{4} + x)/(\\sqrt{x^{6}(1 - \\frac{x}{x^{6}})}) \\\\\n&= lim_(x → - ∞)\\frac{2x^{4} + x}{\\sqrt{x^{6}} \\cdot \\sqrt{1 - \\frac{1}{x^{5}}}}\n\\end{aligned}\n$$\n\nNote that\n\n$$\n\\sqrt{x^6}= \\mid x^3 \\mid\n$$\n\nSince $x \\to -\\infty$, we have $x^3<0$, and therefore\n\n$$\n\\begin{aligned}\n\\sqrt{x^6}= \\mid x^3 &= -x^3\n\\end{aligned}\n$$\n\nSo, the above reduces to\n\n$$\n\\begin{aligned}\nlim_(x → - ∞)f(x) &= lim_(x → - ∞)(2x^{4} + x)/((-x^{3}) \\cdot \\sqrt{1 - \\frac{1}{x^{5}}}) =-lim_(x → - ∞)\\frac{2x^{4} + x}{x^{3} \\cdot \\sqrt{1 - \\frac{1}{x^{5}}}}\n\\end{aligned}\n$$\n\nNow, we divide the top and bottom of the fraction by $x^3$ and evaluate the limit, which gives\n\n$$\n\\begin{aligned}\nlim_(x → - ∞)f(x) &= -lim_(x → - ∞)\\frac{2x + \\frac{x}{x^{3}}}{\\sqrt{1 - \\frac{1}{x^{5}}}} \\\\\n&=-lim_(x → - ∞)\\frac{2x + \\frac{1}{x^{2}}}{\\sqrt{1 - \\frac{1}{x^{5}}}} \\\\\n&=-lim_(x → - ∞)\\frac{2x + 0}{\\sqrt{1 - 0}} \\\\\n&=-lim_(x → - ∞)2x \\\\\n&= ∞\n\\end{aligned}\n$$\n\nThe limit is not a finite number. Therefore, there is no horizontal asymptote." "The horizontal asymptote of $f(x)$ in the domain $x< 0$ is\n\n$$\ny=\\lim_{x \\rightarrow -\\infty} f(x)\n$$\n\nTo find the horizontal asymptote, we note that the $x^6$ in the radical is a perfect square, and so we rewrite the function as\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  - \\infty}f(x) &= \\lim_{x \\to  - \\infty}\\frac{2x^{4} + x}{\\sqrt{x^{6} - x}}, \\\\\n&= \\lim_{x \\to  - \\infty}(2x^{4} + x)/(\\sqrt{x^{6}(1 - \\frac{x}{x^{6}})}) \\\\\n&= \\lim_{x \\to  - \\infty}\\frac{2x^{4} + x}{\\sqrt{x^{6}} \\cdot \\sqrt{1 - \\frac{1}{x^{5}}}}\n\\end{aligned}\n$$\n\nNote that\n\n$$\n\\sqrt{x^6}= \\mid x^3 \\mid\n$$\n\nSince $x \\to -\\infty$, we have $x^3<0$, and therefore\n\n$$\n\\begin{aligned}\n\\sqrt{x^6}= \\mid x^3 &= -x^3\n\\end{aligned}\n$$\n\nSo, the above reduces to\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  - \\infty}f(x) &= \\lim_{x \\to  - \\infty}(2x^{4} + x)/((-x^{3}) \\cdot \\sqrt{1 - \\frac{1}{x^{5}}}) =-\\lim_{x \\to  - \\infty}\\frac{2x^{4} + x}{x^{3} \\cdot \\sqrt{1 - \\frac{1}{x^{5}}}}\n\\end{aligned}\n$$\n\nNow, we divide the top and bottom of the fraction by $x^3$ and evaluate the limit, which gives\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  - \\infty}f(x) &= -\\lim_{x \\to  - \\infty}\\frac{2x + \\frac{x}{x^{3}}}{\\sqrt{1 - \\frac{1}{x^{5}}}} \\\\\n&=-\\lim_{x \\to  - \\infty}\\frac{2x + \\frac{1}{x^{2}}}{\\sqrt{1 - \\frac{1}{x^{5}}}} \\\\\n&=-\\lim_{x \\to  - \\infty}\\frac{2x + 0}{\\sqrt{1 - 0}} \\\\\n&=-\\lim_{x \\to  - \\infty}2x \\\\\n&= ∞\n\\end{aligned}\n$$\n\nThe limit is not a finite number. Therefore, there is no horizontal asymptote."] [:db/cas 17592186078276 :question/problem "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below?\n\n1. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,2}f(x)=0\n$$\n2. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,1}f(x)=\\text{DNE}\n$$\n3. $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,-1}f(x)=\\lim_\\limits{x\\rightarrow \\,0}f(x)\n$$\n\n![](images/de/dea690cf5bae7ef2463bd2f274bbc50becaa6d24f8d4aed926d9c0fda7f5e6d1.png)" "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below?\n\n1. $$\n\\displaystyle \\lim_{x\\rightarrow \\,2}f(x)=0\n$$\n2. $$\n\\displaystyle \\lim_{x\\rightarrow \\,1}f(x)=\\text{DNE}\n$$\n3. $$\n\\displaystyle \\lim_{x\\rightarrow \\,-1}f(x)=\\lim_{x\\rightarrow \\,0}f(x)\n$$\n\n![](images/de/dea690cf5bae7ef2463bd2f274bbc50becaa6d24f8d4aed926d9c0fda7f5e6d1.png)"] [:db/cas 17592186078276 :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. We see from the graph that $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,2^-}f(x)=\\lim_\\limits{x\\rightarrow \\,2^+}f(x)=0.\n$$ Consequently, $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,2}f(x)=0.\n$$\n- Statement II is true. When approaching $x=1$ from the left and from the right, we get\n$$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,1^-}f(x)=0, \\qquad \\lim_\\limits{x\\rightarrow \\,1^+}f(x)=3,\n$$\nrespectively. Since $\\lim_\\limits{x\\rightarrow \\,1^-}f(x)\\ne\\lim_\\limits{x\\rightarrow \\,1^+}f(x)$, we conclude that $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\,1}f(x)=\\text{DNE}.\n$$\n- Statement III is false. Both limits $\\lim_\\limits{x\\rightarrow \\,-1}f(x)$ and $\\lim_\\limits{x\\rightarrow \\,0}f(x)$ do not exist because the function $f(x)$ is not given in the interval $[-1,0)$. We *cannot* say that the limits are equal because we can't compare the undefined values.\n\nIn conclusion, only statements I and II are true." "Let's analyze each statement in turn.\n\n- Statement I is true. We see from the graph that $$\n\\displaystyle \\lim_{x\\rightarrow \\,2^-}f(x)=\\lim_{x\\rightarrow \\,2^+}f(x)=0.\n$$ Consequently, $$\n\\displaystyle \\lim_{x\\rightarrow \\,2}f(x)=0.\n$$\n- Statement II is true. When approaching $x=1$ from the left and from the right, we get\n$$\n\\displaystyle \\lim_{x\\rightarrow \\,1^-}f(x)=0, \\qquad \\lim_{x\\rightarrow \\,1^+}f(x)=3,\n$$\nrespectively. Since $\\lim_{x\\rightarrow \\,1^-}f(x)\\ne\\lim_{x\\rightarrow \\,1^+}f(x)$, we conclude that $$\n\\displaystyle \\lim_{x\\rightarrow \\,1}f(x)=\\text{DNE}.\n$$\n- Statement III is false. Both limits $\\lim_{x\\rightarrow \\,-1}f(x)$ and $\\lim_{x\\rightarrow \\,0}f(x)$ do not exist because the function $f(x)$ is not given in the interval $[-1,0)$. We *cannot* say that the limits are equal because we can't compare the undefined values.\n\nIn conclusion, only statements I and II are true."] [:db/cas 17592186078281 :question/worked-solution "Comparing these limits with the formula for the instantaneous rate of change\n\n$$\nf'(a) = \\lim_{h\\to 0}\\dfrac{f(a+h) - f(a)}{h}\n$$\n\nwe see that\n\n$$\n\\begin{aligned}\nlim_(h → 0)(f(-4 + h) - f(-4))/(h) &= f^{′}(-4), \\\\\nlim_(h → 0)(f(2 + h) - f(2))/(h) &= f^{′}(2), \\\\\nlim_(h → 0)(f(4 + h) - f(4))/(h) &= f^{′}(4)\n\\end{aligned}\n$$\n\nThe function consists of $3$ line segments. Inspecting the graph, we see that\n\n- for $x < -2$, we have $f'(x)=-1$,\n- for $-2 < x < 2$, we have $f'(x)=\\dfrac{1}{2}$,\n- for $x > 2$, we have $f'(x)=-1$.\n\nThe derivative does not exist at $x=-2$ nor $x=2$. So, we have\n\n$$\n\\begin{aligned}\nlim_(h → 0)(f(-4 + h) - f(-4))/(h) &= -1, \\\\\nlim_(h → 0)(f(2 + h) - f(2))/(h) &= DNE, \\\\\nlim_(h → 0)(f(4 + h) - f(4))/(h) &= -1\n\\end{aligned}\n$$\n\nTherefore, only statement III is true." "Comparing these limits with the formula for the instantaneous rate of change\n\n$$\nf'(a) = \\lim_{h\\to 0}\\dfrac{f(a+h) - f(a)}{h}\n$$\n\nwe see that\n\n$$\n\\begin{aligned}\n\\lim_{h \\to  0}(f(-4 + h) - f(-4))/(h) &= f^{′}(-4), \\\\\n\\lim_{h \\to  0}(f(2 + h) - f(2))/(h) &= f^{′}(2), \\\\\n\\lim_{h \\to  0}(f(4 + h) - f(4))/(h) &= f^{′}(4)\n\\end{aligned}\n$$\n\nThe function consists of $3$ line segments. Inspecting the graph, we see that\n\n- for $x < -2$, we have $f'(x)=-1$,\n- for $-2 < x < 2$, we have $f'(x)=\\dfrac{1}{2}$,\n- for $x > 2$, we have $f'(x)=-1$.\n\nThe derivative does not exist at $x=-2$ nor $x=2$. So, we have\n\n$$\n\\begin{aligned}\n\\lim_{h \\to  0}(f(-4 + h) - f(-4))/(h) &= -1, \\\\\n\\lim_{h \\to  0}(f(2 + h) - f(2))/(h) &= DNE, \\\\\n\\lim_{h \\to  0}(f(4 + h) - f(4))/(h) &= -1\n\\end{aligned}\n$$\n\nTherefore, only statement III is true."] [:db/cas 17592186078316 :question/problem "Find $$\n\\displaystyle \\lim_\\limits{x \\to (-2)^+} \\dfrac{15x}{\\mid x^3+x \\mid}.\n$$" "Find $$\n\\displaystyle \\lim_{x \\to (-2)^+} \\dfrac{15x}{\\mid x^3+x \\mid}.\n$$"] [:db/cas 17592186078316 :question/worked-solution "Let's attempt to evaluate this limit by direct substitution. Substituting $x=-2$ into the limit, we obtain\n\n$$\n\\begin{aligned}\nlim_(x → - 2^{+})\\frac{15x}{\\begin{vmatrix}x^{3} + x &} &= (15(-2))/(\\mid (-2)^{3} + (-2)\\end{vmatrix}) \\\\\n&= \\frac{-30}{\\mid - 8 - 2\\begin{vmatrix}} \\\\ = \\frac{-30}{\\mid - 10\\end{vmatrix}} \\\\\n&= \\frac{-30}{10} \\\\\n&=-3\n\\end{aligned}\n$$" "Let's attempt to evaluate this limit by direct substitution. Substituting $x=-2$ into the limit, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to -{2}^{+}}\\frac{15x}{|{x}^{3}+x|} & =\\frac{15(-2)}{|(-2)^{3}+(-2)|} \\\\  & =\\frac{-30}{|-8-2|} \\\\  & =\\frac{-30}{|-10|} \\\\  & =\\frac{-30}{10} \\\\  & =-3.\\end{aligned}\n$$"] [:db/cas 17592186078329 :question/problem "Evaluate $$\n\\displaystyle \\lim_\\limits{\\theta \\to 0}\\: \\dfrac{\\theta \\cot \\theta}{4 \\cos^2 \\theta}.\n$$" "Evaluate $$\n\\displaystyle \\lim_{\\theta \\to 0}\\: \\dfrac{\\theta \\cot \\theta}{4 \\cos^2 \\theta}.\n$$"] [:db/cas 17592186078329 :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{\\theta \\operatorname{cot}⁡\\theta }{4{cos}^{2}⁡\\theta } & ={lim}_{\\theta \\to 0}(\\frac{\\theta }{4{cos}^{2}⁡\\theta }\\cdot \\operatorname{cot}⁡\\theta ) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{\\theta }{4{cos}^{2}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\frac{1}{4\\operatorname{cos}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{4\\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_\\limits{\\theta \\to 0}\\: \\dfrac{\\theta}{\\sin\\theta} = \\dfrac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1}{({lim}_{\\theta \\to 0}\\,\\frac{\\operatorname{sin}⁡\\theta }{\\theta })} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n\\lim_\\limits{\\theta \\to 0} \\:\\dfrac{1}{4 \\cos \\theta} = \\dfrac{1}{4\\cos 0} = \\dfrac14.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{4\\operatorname{cos}⁡\\theta } & =1\\cdot \\frac{1}{4}=\\frac{1}{4}.\\end{aligned}\n$$" "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta \\operatorname{cot}⁡\\theta }{4{cos}^{2}⁡\\theta } & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{4{cos}^{2}⁡\\theta }\\cdot \\operatorname{cot}⁡\\theta ) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{4{cos}^{2}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}(\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\frac{1}{4\\operatorname{cos}⁡\\theta }) \\\\  & =\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{4\\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{\\theta \\to 0}\\: \\dfrac{\\theta}{\\sin\\theta} = \\dfrac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1}{(\\lim_{\\theta \\to 0}\\,\\frac{\\operatorname{sin}⁡\\theta }{\\theta })} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n\\lim_{\\theta \\to 0} \\:\\dfrac{1}{4 \\cos \\theta} = \\dfrac{1}{4\\cos 0} = \\dfrac14.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{4\\operatorname{cos}⁡\\theta } & =1\\cdot \\frac{1}{4}=\\frac{1}{4}.\\end{aligned}\n$$"] [:db/cas 17592186078334 :question/worked-solution "At $x=4,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{-}}h(x) & =h(4) \\\\  & ={4}^{c(4)+1} \\\\  & ={4}^{4c+1},\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}h(x) & ={lim}_{x\\to {4}^{+}}(4x) \\\\  & =4(4) \\\\  & =16.\\end{aligned}\n$$\n\nIn order for $h(x)$ to be continuous at $x=4,$ we require that\n\n$$\n\\begin{aligned}{4}^{4c+1} & =16 \\\\ {4}^{4c+1} & ={4}^{2} \\\\ 4c+1 & =2 \\\\ 4c & =1 \\\\ c & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, $h(x)$ is continuous at $x=4$ for $c = \\dfrac{1}{4}.$" "At $x=4,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{-}}h(x) & =h(4) \\\\  & ={4}^{c(4)+1} \\\\  & ={4}^{4c+1},\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{+}}h(x) & =\\lim_{x\\to {4}^{+}}(4x) \\\\  & =4(4) \\\\  & =16.\\end{aligned}\n$$\n\nIn order for $h(x)$ to be continuous at $x=4,$ we require that\n\n$$\n\\begin{aligned}{4}^{4c+1} & =16 \\\\ {4}^{4c+1} & ={4}^{2} \\\\ 4c+1 & =2 \\\\ 4c & =1 \\\\ c & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, $h(x)$ is continuous at $x=4$ for $c = \\dfrac{1}{4}.$"] [:db/cas 17592186078344 :question/problem "Evaluate $$\n\\displaystyle \\lim_\\limits{x \\rightarrow 1^+}\\dfrac{\\mid x-1 \\mid}{\\sqrt{x-1}}.\n$$" "Evaluate $$\n\\displaystyle \\lim_{x \\rightarrow 1^+}\\dfrac{\\mid x-1 \\mid}{\\sqrt{x-1}}.\n$$"] [:db/cas 17592186078344 :question/worked-solution "First, let's attempt to evaluate this limit by direct substitution. Substituting $x=1$ into the limit, we obtain\n\n$$\n\\begin{aligned}\nlim_(x → 1^{+})\\frac{\\begin{vmatrix}x - 1 &}{\\sqrt{x - 1}} &= \\frac{\\mid 1 - 1\\end{vmatrix}}{\\sqrt{1 - 1}} \\\\\n&= \\frac{\\mid 0 \\mid}{0} \\\\\n&= \\frac{0}{0}\n\\end{aligned}\n$$\n\nwhich is an indeterminate form.\n\nNotice, however, that we only require the right-sided limit, i.e., $x\\to1^{+}$. If $x > 1$, then\n\n$$\n\\mid x-1 \\mid = x-1\n$$\n\nTherefore, we can write this limit as follows:\n\n$$\n\\begin{aligned}\nlim_(x → 1^{+})\\frac{\\mid x - 1 \\mid}{\\sqrt{x - 1}} &= lim_(x → 1^{+})\\frac{x - 1}{\\sqrt{x - 1}}\n\\end{aligned}\n$$\n\nDirect substitution into the above still gives an indeterminate form\n\n$$\n\\dfrac 0 0\n$$\n\nHowever, we can rationalize the expression and then evaluate the limit, as follows:\n\n$$\n{\\begin{array}{rl}\\displaystyle lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{x - 1}{\\sqrt{x - 1}}} & \\displaystyle  = lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{x - 1}{\\sqrt{x - 1}}} \\cdot  {\\displaystyle \\frac{\\sqrt{x - 1}}{\\sqrt{x - 1}}} \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{( x - 1 ) \\sqrt{x - 1}}{x - 1}} \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{\\cancel{( x - 1 )} \\sqrt{x - 1}}{\\cancel{x - 1}}} \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{\\sqrt{x - 1}}{1}} \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {1}^{+}} \\sqrt{x - 1} \\\\ \\displaystyle  & \\displaystyle  = \\sqrt{1 - 1} \\\\ \\displaystyle  & \\displaystyle  = \\sqrt{0} \\\\ \\displaystyle  & \\displaystyle  = 0\\end{array}}\n$$" "First, let's attempt to evaluate this limit by direct substitution. Substituting $x=1$ into the limit, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{+}}\\frac{|x-1|}{\\sqrt{x-1}} & =\\frac{|1-1|}{\\sqrt{1-1}} \\\\  & =\\frac{|0|}{0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nwhich is an indeterminate form.\n\nNotice, however, that we only require the right-sided limit, i.e., $x\\to1^{+}$. If $x > 1$, then\n\n$$\n\\mid x-1 \\mid = x-1\n$$\n\nTherefore, we can write this limit as follows:\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  1^{+}}\\frac{\\mid x - 1 \\mid}{\\sqrt{x - 1}} &= \\lim_{x \\to  1^{+}}\\frac{x - 1}{\\sqrt{x - 1}}\n\\end{aligned}\n$$\n\nDirect substitution into the above still gives an indeterminate form\n\n$$\n\\dfrac 0 0\n$$\n\nHowever, we can rationalize the expression and then evaluate the limit, as follows:\n\n$$\n{\\begin{array}{rl}\\displaystyle lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{x - 1}{\\sqrt{x - 1}}} & \\displaystyle  = \\lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{x - 1}{\\sqrt{x - 1}}} \\cdot  {\\displaystyle \\frac{\\sqrt{x - 1}}{\\sqrt{x - 1}}} \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{( x - 1 ) \\sqrt{x - 1}}{x - 1}} \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{\\cancel{( x - 1 )} \\sqrt{x - 1}}{\\cancel{x - 1}}} \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {1}^{+}} {\\displaystyle \\frac{\\sqrt{x - 1}}{1}} \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {1}^{+}} \\sqrt{x - 1} \\\\ \\displaystyle  & \\displaystyle  = \\sqrt{1 - 1} \\\\ \\displaystyle  & \\displaystyle  = \\sqrt{0} \\\\ \\displaystyle  & \\displaystyle  = 0\\end{array}}\n$$"] [:db/cas 17592186078346 :question/problem "Find $$\n\\displaystyle \\lim_\\limits{x \\to 0^-} \\dfrac{\\sqrt{x^2}}{x}.\n$$" "Find $$\n\\displaystyle \\lim_{x \\to 0^-} \\dfrac{\\sqrt{x^2}}{x}.\n$$"] [:db/cas 17592186078346 :question/worked-solution "First, recall that\n\n$$\n\\sqrt{x^2} = \\mid x \\mid\n$$\n\nTherefore, we can rewrite the limit as\n\n$$\n\\lim_\\limits{x \\to 0^-} \\dfrac{\\mid x \\mid}{x}\n$$\n\nLet's attempt to evaluate this limit by direct substitution. Substituting $x=0$ into the limit, we obtain\n\n$$\n\\begin{aligned}\nlim_(x → 0^{-})\\frac{\\begin{vmatrix}x &}{x} &= \\frac{\\mid 0\\end{vmatrix}}{0} = \\frac{0}{0}\n\\end{aligned}\n$$\n\nwhich is an indeterminate form.\n\nNotice, however, that we only require the left-sided limit, i.e., $x\\to0^{-}$. If $x < 0$, then\n\n$$\n\\mid x \\mid = -x\n$$\n\nTherefore, we can evaluate this limit as follows:\n\n$$\n{\\begin{array}{rl}\\displaystyle lim_{x \\to  {0}^{-}} ( {\\displaystyle \\frac{| x |}{x}} ) & \\displaystyle  = lim_{x \\to  {0}^{-}} ( {\\displaystyle \\frac{- x}{x}} ) \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {0}^{-}} ( {\\displaystyle \\frac{- \\cancel{x}}{\\cancel{x}}} ) \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {0}^{-}} ( - 1 ) \\\\ \\displaystyle  & \\displaystyle  = - 1\\end{array}}\n$$\n\nFinally, we conclude that\n\n$$\n\\lim_\\limits{x \\to 0^-} \\dfrac{\\sqrt{x^2}}{x} = -1\n$$" "First, recall that\n\n$$\n\\sqrt{x^2} = \\mid x \\mid\n$$\n\nTherefore, we can rewrite the limit as\n\n$$\n\\lim_{x \\to 0^-} \\dfrac{\\mid x \\mid}{x}\n$$\n\nLet's attempt to evaluate this limit by direct substitution. Substituting $x=0$ into the limit, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}\\frac{|x|}{x} & =\\frac{|0|}{0}=\\frac{0}{0}\\end{aligned}\n$$\n\nwhich is an indeterminate form.\n\nNotice, however, that we only require the left-sided limit, i.e., $x\\to0^{-}$. If $x < 0$, then\n\n$$\n\\mid x \\mid = -x\n$$\n\nTherefore, we can evaluate this limit as follows:\n\n$$\n{\\begin{array}{rl}\\displaystyle lim_{x \\to  {0}^{-}} ( {\\displaystyle \\frac{| x |}{x}} ) & \\displaystyle  = \\lim_{x \\to  {0}^{-}} ( {\\displaystyle \\frac{- x}{x}} ) \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {0}^{-}} ( {\\displaystyle \\frac{- \\cancel{x}}{\\cancel{x}}} ) \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {0}^{-}} ( - 1 ) \\\\ \\displaystyle  & \\displaystyle  = - 1\\end{array}}\n$$\n\nFinally, we conclude that\n\n$$\n\\lim_{x \\to 0^-} \\dfrac{\\sqrt{x^2}}{x} = -1\n$$"] [:db/cas 17592186078349 :question/problem "Determine $$\n\\displaystyle \\lim_\\limits{x \\to 2^-} \\dfrac {\\vert x^2 - 4 \\vert} {x - 2}.\n$$" "Determine $$\n\\displaystyle \\lim_{x \\to 2^-} \\dfrac {\\vert x^2 - 4 \\vert} {x - 2}.\n$$"] [:db/cas 17592186078349 :question/worked-solution "First, let's attempt to evaluate this limit by direct substitution. Substituting $x=2$ into the limit, we obtain\n\n$$\n\\begin{aligned}\nlim_(x → 2^{-})\\frac{\\begin{vmatrix}x^{2} - 4 &}{x - 2} &= \\frac{\\mid 2^{2} - 4\\end{vmatrix}}{2 - 2} \\\\\n&= \\frac{\\mid 4 - 4 \\mid}{2 - 2} \\\\\n&= \\frac{0}{0}\n\\end{aligned}\n$$\n\nwhich is an indeterminate form.\n\nTo evaluate the limit, we factor the numerator and rewrite the limit, as follows:\n\n$$\n\\begin{aligned} \\lim_{x \\to 2^-} \\dfrac {\\vert x^2 - 4 \\vert} {x - 2} &=\\lim_{x \\to 2^-} \\dfrac {\\vert (x+2)(x-2) \\vert} {x - 2} \\\\[5pt] &=\\lim_{x \\to 2^-} \\dfrac {\\vert x+2\\vert \\cdot \\vert x-2 \\vert} {x - 2} \\end{aligned}\n$$\n\nNow, since $x<2$, we have\n\n- $\\mid x+2 \\mid = x+2$ and\n- $\\mid x-2 \\mid = -(x-2)$.\n\nSubstituting the above into our limit and simplifying, we get\n\n$$\n{\\begin{array}{rl}\\displaystyle lim_{x \\to  {2}^{-}} {\\displaystyle \\frac{| x + 2 | \\cdot  | x - 2 |}{x - 2}} & \\displaystyle  = lim_{x \\to  {2}^{-}} {\\displaystyle \\frac{- ( x + 2 ) ( x - 2 )}{x - 2}} \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {2}^{-}} {\\displaystyle \\frac{- ( x + 2 ) \\cancel{( x - 2 )}}{\\cancel{x - 2}}} \\\\ \\displaystyle  & \\displaystyle  = lim_{x \\to  {2}^{-}} - ( x + 2 ) \\\\ \\displaystyle  & \\displaystyle  = - ( 2 + 2 ) \\\\ \\displaystyle  & \\displaystyle  = - 4.\\end{array}}\n$$\n\nFinally, we conclude that\n\n$$\n\\lim_\\limits{x \\to 2^-} \\dfrac {\\vert x^2 - 4 \\vert} {x - 2} = -4\n$$" "First, let's attempt to evaluate this limit by direct substitution. Substituting $x=2$ into the limit, we obtain\n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{-}}\\frac{|{x}^{2}-4|}{x-2} & =\\frac{|{2}^{2}-4|}{2-2} \\\\  & =\\frac{|4-4|}{2-2} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nwhich is an indeterminate form.\n\nTo evaluate the limit, we factor the numerator and rewrite the limit, as follows:\n\n$$\n\\begin{aligned} \\lim_{x \\to 2^-} \\dfrac {\\vert x^2 - 4 \\vert} {x - 2} &=\\lim_{x \\to 2^-} \\dfrac {\\vert (x+2)(x-2) \\vert} {x - 2} \\\\[5pt] &=\\lim_{x \\to 2^-} \\dfrac {\\vert x+2\\vert \\cdot \\vert x-2 \\vert} {x - 2} \\end{aligned}\n$$\n\nNow, since $x<2$, we have\n\n- $\\mid x+2 \\mid = x+2$ and\n- $\\mid x-2 \\mid = -(x-2)$.\n\nSubstituting the above into our limit and simplifying, we get\n\n$$\n{\\begin{array}{rl}\\displaystyle lim_{x \\to  {2}^{-}} {\\displaystyle \\frac{| x + 2 | \\cdot  | x - 2 |}{x - 2}} & \\displaystyle  = \\lim_{x \\to  {2}^{-}} {\\displaystyle \\frac{- ( x + 2 ) ( x - 2 )}{x - 2}} \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {2}^{-}} {\\displaystyle \\frac{- ( x + 2 ) \\cancel{( x - 2 )}}{\\cancel{x - 2}}} \\\\ \\displaystyle  & \\displaystyle  = \\lim_{x \\to  {2}^{-}} - ( x + 2 ) \\\\ \\displaystyle  & \\displaystyle  = - ( 2 + 2 ) \\\\ \\displaystyle  & \\displaystyle  = - 4.\\end{array}}\n$$\n\nFinally, we conclude that\n\n$$\n\\lim_{x \\to 2^-} \\dfrac {\\vert x^2 - 4 \\vert} {x - 2} = -4\n$$"] [:db/cas 17592186078352 :question/worked-solution "The displacement $s(t)$ is given by\n\n$$\ns(t) =2t^3-6t^2+4\n$$\n\nThe velocity $v(t)$ is obtained by differentiating $s(t)$. This gives\n\n$$\n\\begin{aligned} v(t)&=\\dfrac{\\textrm{d}s}{\\textrm{d}t}=6t^2-12t. \\end{aligned}\n$$\n\nTo find the total distance traveled, we need to find the points where the velocity changes direction. This occurs when the velocity is zero. Solving $v(t) = 0$, we get\n\n$$\n\\begin{aligned} 6t^2-12t &= 0 \\\\ 6t(t -2) & = 0 \\\\ t & =0,2. \\end{aligned}\n$$\n\nA sketch of $v(t)$ is shown below:\n\n![](images/e8/e888df54f36a5b8cce1198ef3eaebf7b0995d1a38f0469335cb3ec20c95f3a2d.png)\n\nNotice that in the interval\n\n$$\n0\\leq t\\leq 4\n$$\n\nthe curve $v(t)$ crosses the $t$-axis at $t=2$. Therefore, total distance traveled $d$ is given by\n\n$$\nd = \\left|s(2) - s(0) \\mid + \\mid s(4) - s(2)\\right|\n$$\n\nWe calculate the total distance traveled as follows:\n\n$$\n\\begin{aligned}\nd &= \\begin{vmatrix}(2(2)^{3} - 6(2)^{2} + 4) - (4) & + & (2(4)^{3} - 6(4)^{2} + 4) - (2(2)^{3} - 6(2)^{2} + 4)\\end{vmatrix} \\\\\n&= 8 + 40 \\\\\n&= 48m\n\\end{aligned}\n$$\n\nTherefore, the total distance traveled by $P$ in the interval\n\n$$\n0 \\leq t\\leq 4\n$$\n\nis $48\\,\\textrm{m}$." "The displacement $s(t)$ is given by\n\n$$\ns(t) =2t^3-6t^2+4\n$$\n\nThe velocity $v(t)$ is obtained by differentiating $s(t)$. This gives\n\n$$\n\\begin{aligned} v(t)&=\\dfrac{\\textrm{d}s}{\\textrm{d}t}=6t^2-12t. \\end{aligned}\n$$\n\nTo find the total distance traveled, we need to find the points where the velocity changes direction. This occurs when the velocity is zero. Solving $v(t) = 0$, we get\n\n$$\n\\begin{aligned} 6t^2-12t &= 0 \\\\ 6t(t -2) & = 0 \\\\ t & =0,2. \\end{aligned}\n$$\n\nA sketch of $v(t)$ is shown below:\n\n![](images/e8/e888df54f36a5b8cce1198ef3eaebf7b0995d1a38f0469335cb3ec20c95f3a2d.png)\n\nNotice that in the interval\n\n$$\n0\\leq t\\leq 4\n$$\n\nthe curve $v(t)$ crosses the $t$-axis at $t=2$. Therefore, total distance traveled $d$ is given by\n\n$$\nd = \\left|s(2) - s(0) \\mid + \\mid s(4) - s(2)\\right|\n$$\n\nWe calculate the total distance traveled as follows:\n\n$$\n\\begin{aligned}d & =|(2(2)^{3}-6(2)^{2}+4)-(4)|+|(2(4)^{3}-6(4)^{2}+4)-(2(2)^{3}-6(2)^{2}+4)| \\\\  & =8+40 \\\\  & =48\\hspace{0.167em}\\text{ m}\\end{aligned}\n$$\n\nTherefore, the total distance traveled by $P$ in the interval\n\n$$\n0 \\leq t\\leq 4\n$$\n\nis $48\\,\\textrm{m}$."] [:db/cas 17592186078353 :question/worked-solution "To find the total distance traveled, we first need to find the points where the particle changes its direction, which can only occur when the velocity is zero. Solving $v(t) = 0$, we get\n\n$$\n\\begin{aligned}\nv(t) &= 0 \\\\\n\\frac{1}{2}t - 1 &= 0 \\\\\n\\frac{1}{2}t &= 1 \\\\\nt &= 2\n\\end{aligned}\n$$\n\nA sketch of $v(t)$ is shown below:\n\n![](images/64/6403365c9fb39942bc27747257db6fdc32f079921c10d2e0aca987fd898e29dc.png)\n\nNotice that in the interval\n\n$$\n0\\leq t\\leq T\n$$\n\nfor $T > 2$, the curve $v(t)$ crosses the $t$-axis at $t=2$. Therefore, we need to split up the distance integral between the intervals\n\n$$\n0\\leq t\\leq 2\n$$\n\nand\n\n$$\n2\\leq t\\leq T\n$$\n\nIn the interval\n\n$$\n0 \\leq t\\leq 2\n$$\n\nwe have $v(t) \\lt 0$. Therefore,\n\n$$\n\\mid v(t) \\mid = -v(t) = 1 - \\dfrac{1}{2}t\n$$\n\nSimilarly, in the interval\n\n$$\n2 \\leq t \\leq T\n$$\n\nwe have $v(t) \\gt 0$. Therefore,\n\n$$\n\\mid v(t) \\mid = v(t) = \\dfrac{1}{2}t - 1\n$$\n\nFinally, splitting the integral over the two intervals, we can find an expression for the total distance traveled, as follows:\n\n$$\n\\begin{aligned}\nd &= \\int_{0}^{T}\\begin{vmatrix}v(t) & dt \\\\ = \\int_{0}^{2} & v(t)\\end{vmatrix}dt + \\int_{2}^{T} \\mid v(t) \\mid dt \\\\\n&= \\int_{0}^{2}(1 - \\frac{1}{2}t)dt + \\int_{2}^{T}(\\frac{1}{2}t - 1)dt \\\\\n&= \\left.(t - \\frac{1}{4}t^{2})\\right|_{0}^{2} + \\left.(\\frac{1}{4}t^{2} - t)\\right|_{2}^{T} \\\\\n&= [(2 - \\frac{1}{4}(2)^{2}) - 0] + [(\\frac{1}{4}T^{2} - T) - (\\frac{1}{4}(2)^{2} - 2)] \\\\\n&= 1 + \\frac{1}{4}T^{2} - T - (-1) \\\\\n&= \\frac{1}{4}T^{2} - T + 2\n\\end{aligned}\n$$" "To find the total distance traveled, we first need to find the points where the particle changes its direction, which can only occur when the velocity is zero. Solving $v(t) = 0$, we get\n\n$$\n\\begin{aligned}\nv(t) &= 0 \\\\\n\\frac{1}{2}t - 1 &= 0 \\\\\n\\frac{1}{2}t &= 1 \\\\\nt &= 2\n\\end{aligned}\n$$\n\nA sketch of $v(t)$ is shown below:\n\n![](images/64/6403365c9fb39942bc27747257db6fdc32f079921c10d2e0aca987fd898e29dc.png)\n\nNotice that in the interval\n\n$$\n0\\leq t\\leq T\n$$\n\nfor $T > 2$, the curve $v(t)$ crosses the $t$-axis at $t=2$. Therefore, we need to split up the distance integral between the intervals\n\n$$\n0\\leq t\\leq 2\n$$\n\nand\n\n$$\n2\\leq t\\leq T\n$$\n\nIn the interval\n\n$$\n0 \\leq t\\leq 2\n$$\n\nwe have $v(t) \\lt 0$. Therefore,\n\n$$\n\\mid v(t) \\mid = -v(t) = 1 - \\dfrac{1}{2}t\n$$\n\nSimilarly, in the interval\n\n$$\n2 \\leq t \\leq T\n$$\n\nwe have $v(t) \\gt 0$. Therefore,\n\n$$\n\\mid v(t) \\mid = v(t) = \\dfrac{1}{2}t - 1\n$$\n\nFinally, splitting the integral over the two intervals, we can find an expression for the total distance traveled, as follows:\n\n$$\n\\begin{aligned}d & ={\\int }_{0}^{T}|v(t)|\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{2}|v(t)|\\text{d}t+{\\int }_{2}^{T}|v(t)|\\text{d}t \\\\  & ={\\int }_{0}^{2}(1-\\frac{1}{2}t)\\text{d}t+{\\int }_{2}^{T}(\\frac{1}{2}t-1)\\text{d}t \\\\  & ={(t-\\frac{1}{4}{t}^{2})|}_{0}^{2}+{(\\frac{1}{4}{t}^{2}-t)|}_{2}^{T} \\\\  & =[(2-\\frac{1}{4}(2)^{2})-0]+[(\\frac{1}{4}{T}^{2}-T)-(\\frac{1}{4}(2)^{2}-2)] \\\\  & =1+\\frac{1}{4}{T}^{2}-T-(-1) \\\\  & =\\frac{1}{4}{T}^{2}-T+2\\end{aligned}\n$$"] [:db/cas 17592186078358 :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}\\frac{x-2\\sqrt{x}}{x-4} & =\\frac{4-2\\sqrt{4}}{4-4}=\\frac{0}{0},\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\n\t\\lim_{x \\to 4^+} \\dfrac {x - 2\\sqrt{x}} {x - 4} &= \\lim_{x \\to 4^+} \\dfrac {(x -2 \\sqrt{x})(x+2\\sqrt x)} {(x - 4)(x+2\\sqrt x)} \\\\\n            &= \\lim_{x \\to 4^+} \\dfrac {x^2-\\left(2\\sqrt{x}\\right)^2} {(x - 4)(x+2\\sqrt x)} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {x^2-4x} {(x - 4)(x+2\\sqrt x)} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {x(x-4)} {(x - 4)(x+2\\sqrt x)} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {x} {x+2\\sqrt x} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {4} {4+2\\sqrt4} \\\\\n\t    &=\\dfrac 1 2.\n\t\\end{aligned}\n$$" "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}\\lim_{x\\to {4}^{+}}\\frac{x-2\\sqrt{x}}{x-4} & =\\frac{4-2\\sqrt{4}}{4-4}=\\frac{0}{0},\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\n\t\\lim_{x \\to 4^+} \\dfrac {x - 2\\sqrt{x}} {x - 4} &= \\lim_{x \\to 4^+} \\dfrac {(x -2 \\sqrt{x})(x+2\\sqrt x)} {(x - 4)(x+2\\sqrt x)} \\\\\n            &= \\lim_{x \\to 4^+} \\dfrac {x^2-\\left(2\\sqrt{x}\\right)^2} {(x - 4)(x+2\\sqrt x)} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {x^2-4x} {(x - 4)(x+2\\sqrt x)} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {x(x-4)} {(x - 4)(x+2\\sqrt x)} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {x} {x+2\\sqrt x} \\\\\n\t    &= \\lim_{x \\to 4^+} \\dfrac {4} {4+2\\sqrt4} \\\\\n\t    &=\\dfrac 1 2.\n\t\\end{aligned}\n$$"] [:db/cas 17592186078359 :question/worked-solution "If we attempt to evaluate the limit by simply evaluating the function at $x=0$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{3x}{\\sqrt{x+1}-1} & =\\frac{3\\cdot 0}{\\sqrt{0+1}-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}\n\\lim_{x \\to 0} \\dfrac {3x} {\\sqrt{x + 1} - 1} \n\t&=\\lim_{x\\to 0}\\frac{(3x)(\\sqrt{x+1}+1)}{(\\sqrt{x + 1} - 1)(\\sqrt{x+1}+1)}\\\\\n\t&=\\lim_{x\\to 0}\\frac{3x(\\sqrt{x+1}+1)}{\\left(\\sqrt{x+1}\\right)^2-1^2}\\\\\n\t&=\\lim_{x\\to 0}\\frac{3x(\\sqrt{x+1}+1)}{x+1-1}\\\\\n\t&=\\lim_{x\\to 0}\\frac{3x(\\sqrt{x+1}+1)}{x}\\\\\n\t&=\\lim_{x\\to 0}3(\\sqrt{x+1}+1)\\\\\n&=3(\\sqrt{0+1}+1)\\\\\n\t&=6.\n\\end{aligned}\n$$" "If we attempt to evaluate the limit by simply evaluating the function at $x=0$, we get an indeterminate form:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{3x}{\\sqrt{x+1}-1} & =\\frac{3\\cdot 0}{\\sqrt{0+1}-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}\n\\lim_{x \\to 0} \\dfrac {3x} {\\sqrt{x + 1} - 1} \n\t&=\\lim_{x\\to 0}\\frac{(3x)(\\sqrt{x+1}+1)}{(\\sqrt{x + 1} - 1)(\\sqrt{x+1}+1)}\\\\\n\t&=\\lim_{x\\to 0}\\frac{3x(\\sqrt{x+1}+1)}{\\left(\\sqrt{x+1}\\right)^2-1^2}\\\\\n\t&=\\lim_{x\\to 0}\\frac{3x(\\sqrt{x+1}+1)}{x+1-1}\\\\\n\t&=\\lim_{x\\to 0}\\frac{3x(\\sqrt{x+1}+1)}{x}\\\\\n\t&=\\lim_{x\\to 0}3(\\sqrt{x+1}+1)\\\\\n&=3(\\sqrt{0+1}+1)\\\\\n\t&=6.\n\\end{aligned}\n$$"] [:db/cas 17592186078371 :question/problem "Find $$\n\\displaystyle \\lim_\\limits{x\\rightarrow 0}f(x)\n$$ for the function $f(x)$ plotted below.\n\n![](images/dc/dcee0bc0465b5cd26f982d11ea7de02c477c4215e4cbdb9b463241ed225b8850.png)" "Find $$\n\\displaystyle \\lim_{x\\rightarrow 0}f(x)\n$$ for the function $f(x)$ plotted below.\n\n![](images/dc/dcee0bc0465b5cd26f982d11ea7de02c477c4215e4cbdb9b463241ed225b8850.png)"] [:db/cas 17592186078371 :question/worked-solution "From the graph, we see that as we approach $x=0$ from the left, the $y$ value approaches $2$. So the left-hand limit is\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{-}}f(x)=2\n$$\n\nSimilarly, when we approach $x=0$ from the right, the $y$ value again approaches $2$. So the right-hand limit is\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{+}}f(x)=2\n$$\n\nSince both the left and right-hand limits exist and are equal to $2$, we conclude that\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0}f(x)=2\n$$" "From the graph, we see that as we approach $x=0$ from the left, the $y$ value approaches $2$. So the left-hand limit is\n\n$$\n\\lim_{x\\rightarrow \\,0^{-}}f(x)=2\n$$\n\nSimilarly, when we approach $x=0$ from the right, the $y$ value again approaches $2$. So the right-hand limit is\n\n$$\n\\lim_{x\\rightarrow \\,0^{+}}f(x)=2\n$$\n\nSince both the left and right-hand limits exist and are equal to $2$, we conclude that\n\n$$\n\\lim_{x\\rightarrow \\,0}f(x)=2\n$$"] [:db/cas 17592186078375 :question/problem "The function $y=f(x)$ is defined on $x\\in (1,5]$. Find $$\n\\displaystyle \\lim_\\limits{x\\rightarrow \\, 1}f(x)\n$$ for the function.\n\n![](images/7c/7c596732a717c4aa97ce2079fab32f85779b31811d1de9872db491ce4cb775d3.png)" "The function $y=f(x)$ is defined on $x\\in (1,5]$. Find $$\n\\displaystyle \\lim_{x\\rightarrow \\, 1}f(x)\n$$ for the function.\n\n![](images/7c/7c596732a717c4aa97ce2079fab32f85779b31811d1de9872db491ce4cb775d3.png)"] [:db/cas 17592186078375 :question/worked-solution "From the graph, we see that it is not possible to approach $x=1$ from the left. Therefore,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,1^{-}}f(x)=\\text{DNE}\n$$\n\nWhen we approach $x=1$ from the right, we have\n\n$$\n\\lim_\\limits{x\\rightarrow \\,1^{+}}f(x)=1\n$$\n\nSince\n\n$$\n\\lim_\\limits{x\\rightarrow 1^-} f(x) \\ne \\lim_\\limits{x\\rightarrow 1^+} f(x)\n$$\n\nwe conclude that\n\n$$\n\\lim_\\limits{x\\rightarrow \\,1}f(x)=\\text{DNE}\n$$" "From the graph, we see that it is not possible to approach $x=1$ from the left. Therefore,\n\n$$\n\\lim_{x\\rightarrow \\,1^{-}}f(x)=\\text{DNE}\n$$\n\nWhen we approach $x=1$ from the right, we have\n\n$$\n\\lim_{x\\rightarrow \\,1^{+}}f(x)=1\n$$\n\nSince\n\n$$\n\\lim_{x\\rightarrow 1^-} f(x) \\ne \\lim_{x\\rightarrow 1^+} f(x)\n$$\n\nwe conclude that\n\n$$\n\\lim_{x\\rightarrow \\,1}f(x)=\\text{DNE}\n$$"] [:db/cas 17592186078378 :question/worked-solution "Notice that as $x \\to 0,$ both the numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\displaystyle \\lim_{x\\to 0}\\: \\dfrac{2\\sin{x}}{3x} = \\dfrac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\displaystyle \\lim_{x\\to 0}\\: \\dfrac{\\sin{x}}{x} = 1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\,\\frac{2\\operatorname{sin}⁡x}{3x} & ={lim}_{x\\to 0}(\\frac{2}{3}\\cdot \\frac{\\operatorname{sin}⁡x}{x}) \\\\  & =\\frac{2}{3}\\cdot {lim}_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x} \\\\  & =\\frac{2}{3}\\cdot 1 \\\\  & =\\frac{2}{3}\\end{aligned}\n$$" "Notice that as $x \\to 0,$ both the numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\displaystyle \\lim_{x\\to 0}\\: \\dfrac{2\\sin{x}}{3x} = \\dfrac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\displaystyle \\lim_{x\\to 0}\\: \\dfrac{\\sin{x}}{x} = 1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\,\\frac{2\\operatorname{sin}⁡x}{3x} & =\\lim_{x\\to 0}(\\frac{2}{3}\\cdot \\frac{\\operatorname{sin}⁡x}{x}) \\\\  & =\\frac{2}{3}\\cdot {lim}_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x} \\\\  & =\\frac{2}{3}\\cdot 1 \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"] [:db/cas 17592186078745 :question/problem "![](images/43/435690410bce967875a376a921310743735cc1d9dbc8ba0260d38e447a484a53.png)\n\nFind $lim_(x → π)f(x)$ for the function $f(x)$ plotted above." "![](images/43/435690410bce967875a376a921310743735cc1d9dbc8ba0260d38e447a484a53.png)\n\nFind $\\lim_{x \\to  π}f(x)$ for the function $f(x)$ plotted above."] [:db/cas 17592186078746 :question/problem "![](images/d9/d965f7791ad67200455efa39c4d37d13d05d75a5561cb7da6dc3a0116e843c9b.png)\n\nThe function $y = f(x)$ is defined on $x ∈ (- ∞, \\frac{1}{2}]∪(1, ∞)$. Find $lim_(x → 1)f(x)$." "![](images/d9/d965f7791ad67200455efa39c4d37d13d05d75a5561cb7da6dc3a0116e843c9b.png)\n\nThe function $y = f(x)$ is defined on $x ∈ (- ∞, \\frac{1}{2}]∪(1, ∞)$. Find $\\lim_{x \\to  1}f(x)$."] [:db/cas 17592186078747 :question/problem "![](images/49/49ea038a841683b688cc5aeaa5c8c64c6028feb9c4362e1d919b31d7446ff91b.png)\n\nThe function $y = f(x)$ is defined on $$\n\\displaystyle x ∈ (- ∞,-1]∪[- \\frac{1}{2}, \\frac{1}{2}]∪[1, ∞).\n$$ Find $lim_(x → - 1)f(x)$." "![](images/49/49ea038a841683b688cc5aeaa5c8c64c6028feb9c4362e1d919b31d7446ff91b.png)\n\nThe function $y = f(x)$ is defined on $$\n\\displaystyle x ∈ (- ∞,-1]∪[- \\frac{1}{2}, \\frac{1}{2}]∪[1, ∞).\n$$ Find $\\lim_{x \\to  - 1}f(x)$."] [:db/cas 17592186078866 :question/problem "Evaluate the following limit:$lim_(x → - ∞)\\frac{4x^{7} + 2x^{3}}{\\sqrt{25x^{8} + 4x^{6} - 1}} =$\n{{field-1}}" "Evaluate the following limit:$\\lim_{x \\to  - \\infty}\\frac{4x^{7} + 2x^{3}}{\\sqrt{25x^{8} + 4x^{6} - 1}} =$\n{{field-1}}"] [:db/cas 17592186078871 :question/problem "![](images/2d/2d9fb5725aa6b4c292382c3be2b2a408a46402fea0f903894af7230e2b6abc73.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $lim_(x → - 1)f(x) = DNE$\n2. $lim_(x → 1)f(x) = 2$\n3. $lim_(x → 0)f(x) = lim_(x → 2)f(x)$" "![](images/2d/2d9fb5725aa6b4c292382c3be2b2a408a46402fea0f903894af7230e2b6abc73.png)\n\nWhich of the following statements are true concerning the function $y = f(x)$ whose graph is shown above?\n\n1. $\\lim_{x \\to  - 1}f(x) = DNE$\n2. $\\lim_{x \\to  1}f(x) = 2$\n3. $\\lim_{x \\to  0}f(x) = \\lim_{x \\to  2}f(x)$"] [:db/cas 17592186078877 :question/problem "Evaluate $lim_(x → 2^{+})\\frac{\\mid x - 2 \\mid}{\\sqrt{x - 2}}$." "Evaluate $\\lim_{x \\to  2^{+}}\\frac{\\mid x - 2 \\mid}{\\sqrt{x - 2}}$."] [:db/cas 17592186078880 :question/problem "Evaluate $lim_(x → 1^{+})(\\sqrt{(1 - x)^{2}})/(1 - x)$." "Evaluate $\\lim_{x \\to  1^{+}}(\\sqrt{(1 - x)^{2}})/(1 - x)$."] [:db/cas 17592186078881 :question/problem "Evaluate $lim_(x → 4^{-})\\frac{\\mid 4 - x \\mid}{\\sqrt{4 - x}}$." "Evaluate $\\lim_{x \\to  4^{-}}\\frac{\\mid 4 - x \\mid}{\\sqrt{4 - x}}$."] [:db/cas 17592186078892 :question/problem "What is $lim_(x → 1^{+})\\frac{\\mid x^{3} - 4 \\mid}{x + 1}$?" "What is $\\lim_{x \\to  1^{+}}\\frac{\\mid x^{3} - 4 \\mid}{x + 1}$?"] [:db/cas 17592186078923 :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\sqrt{x+4}-2}{x} & =\\frac{\\sqrt{0+4}-2}{0}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\sqrt{x+4}-2}{x} & ={lim}_{x\\to 0}\\frac{(\\sqrt{x+4}-2)(\\sqrt{x+4}+2)}{x(\\sqrt{x+4}+2)} \\\\  & ={lim}_{x\\to 0}\\frac{x+4-4}{x(\\sqrt{x+4}+2)} \\\\  & ={lim}_{x\\to 0}\\frac{1}{\\sqrt{x+4}+2} \\\\  & =\\frac{1}{\\sqrt{0+4}+2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{\\sqrt{x+4}-2}{x} & =\\frac{\\sqrt{0+4}-2}{0}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{\\sqrt{x+4}-2}{x} & =\\lim_{x\\to 0}\\frac{(\\sqrt{x+4}-2)(\\sqrt{x+4}+2)}{x(\\sqrt{x+4}+2)} \\\\  & =\\lim_{x\\to 0}\\frac{x+4-4}{x(\\sqrt{x+4}+2)} \\\\  & =\\lim_{x\\to 0}\\frac{1}{\\sqrt{x+4}+2} \\\\  & =\\frac{1}{\\sqrt{0+4}+2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"] [:db/cas 17592186078924 :question/worked-solution "If we attempt to evaluate the limit by simply evaluating the function at $x=1$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}\\frac{x-1}{\\sqrt{x+3}-2} & =\\frac{1-1}{\\sqrt{1+3}-2}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}\\frac{x-1}{\\sqrt{x+3}-2} & ={lim}_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{(\\sqrt{x+3}-2)(\\sqrt{x+3}+2)} \\\\  & ={lim}_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{{(\\sqrt{x+3})}^{2}-{2}^{2}} \\\\  & ={lim}_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{x+3-4} \\\\  & ={lim}_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{x-1} \\\\  & ={lim}_{x\\to {1}^{-}}(\\sqrt{x+3}+2) \\\\  & =\\sqrt{1+3}+2 \\\\  & =4.\\end{aligned}\n$$" "If we attempt to evaluate the limit by simply evaluating the function at $x=1$, we get an indeterminate form:\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}\\frac{x-1}{\\sqrt{x+3}-2} & =\\frac{1-1}{\\sqrt{1+3}-2}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to {1}^{-}}\\frac{x-1}{\\sqrt{x+3}-2} & =\\lim_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{(\\sqrt{x+3}-2)(\\sqrt{x+3}+2)} \\\\  & =\\lim_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{{(\\sqrt{x+3})}^{2}-{2}^{2}} \\\\  & =\\lim_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{x+3-4} \\\\  & =\\lim_{x\\to {1}^{-}}\\frac{(x-1)(\\sqrt{x+3}+2)}{x-1} \\\\  & =\\lim_{x\\to {1}^{-}}(\\sqrt{x+3}+2) \\\\  & =\\sqrt{1+3}+2 \\\\  & =4.\\end{aligned}\n$$"] [:db/cas 17592186078926 :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{\\sqrt{x}-2}{x-4} & =\\frac{\\sqrt{4}-2}{4-4}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{\\sqrt{x}-2}{x-4} & ={lim}_{x\\to 4}\\frac{(\\sqrt{x}-2)(\\sqrt{x}+2)}{(x-4)(\\sqrt{x}+2)} \\\\  & ={lim}_{x\\to 4}\\frac{{(\\sqrt{x})}^{2}-{2}^{2}}{(x-4)(\\sqrt{x}+2)} \\\\  & ={lim}_{x\\to 4}\\frac{x-4}{(x-4)(\\sqrt{x}+2)} \\\\  & ={lim}_{x\\to 4}\\frac{1}{\\sqrt{x}+2} \\\\  & =\\frac{1}{\\sqrt{4}+2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}\\lim_{x\\to 4}\\frac{\\sqrt{x}-2}{x-4} & =\\frac{\\sqrt{4}-2}{4-4}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}\\lim_{x\\to 4}\\frac{\\sqrt{x}-2}{x-4} & =\\lim_{x\\to 4}\\frac{(\\sqrt{x}-2)(\\sqrt{x}+2)}{(x-4)(\\sqrt{x}+2)} \\\\  & =\\lim_{x\\to 4}\\frac{{(\\sqrt{x})}^{2}-{2}^{2}}{(x-4)(\\sqrt{x}+2)} \\\\  & =\\lim_{x\\to 4}\\frac{x-4}{(x-4)(\\sqrt{x}+2)} \\\\  & =\\lim_{x\\to 4}\\frac{1}{\\sqrt{x}+2} \\\\  & =\\frac{1}{\\sqrt{4}+2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"] [:db/cas 17592186078928 :question/problem "Evaluate $lim_(x → 3^{+})\\frac{\\mid x - 3 \\mid}{x - 3}$." "Evaluate $\\lim_{x \\to  3^{+}}\\frac{\\mid x - 3 \\mid}{x - 3}$."] [:db/cas 17592186078929 :question/problem "Calculate $lim_(x → 1^{+})\\frac{\\mid x^{2} - 1 \\mid}{x - 1}$." "Calculate $\\lim_{x \\to  1^{+}}\\frac{\\mid x^{2} - 1 \\mid}{x - 1}$."] [:db/cas 17592186078930 :question/problem "Calculate $lim_(x → 4^{+})\\frac{\\mid 16 - x^{2} \\mid}{x - 4}$." "Calculate $\\lim_{x \\to  4^{+}}\\frac{\\mid 16 - x^{2} \\mid}{x - 4}$."] [:db/cas 17592186078931 :question/problem "What is $lim_(x → (-3))\\frac{6}{\\mid x^{2} + 1 \\mid}$?" "What is $\\lim_{x \\to  (-3)}\\frac{6}{\\mid x^{2} + 1 \\mid}$?"] [:db/cas 17592186078932 :question/problem "Evaluate $lim_(x → 0)\\frac{5\\sin x}{2x}$." "Evaluate $\\lim_{x \\to  0}\\frac{5\\sin x}{2x}$."] [:db/cas 17592186078933 :question/worked-solution "Notice that as $x\\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to 0}\\,\\frac{x}{7\\operatorname{sin}⁡x}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}=1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\,\\frac{x}{7\\operatorname{sin}⁡x} & ={lim}_{x\\to 0}(\\frac{1}{7}\\cdot \\frac{x}{\\operatorname{sin}⁡x}) \\\\  & =\\frac{1}{7}\\cdot {lim}_{x\\to 0}\\frac{x}{\\operatorname{sin}⁡x} \\\\  & =\\frac{1}{7}\\cdot {lim}_{x\\to 0}{\\left(\\frac{\\operatorname{sin}⁡x}{x}\\right)}^{-1} \\\\  & =\\frac{1}{7}\\cdot {[{lim}_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}]}^{-1} \\\\  & =\\frac{1}{7}\\cdot {1}^{-1} \\\\  & =\\frac{1}{7}\\end{aligned}\n$$" "Notice that as $x\\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n\\lim_{x\\to 0}\\,\\frac{x}{7\\operatorname{sin}⁡x}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}=1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\,\\frac{x}{7\\operatorname{sin}⁡x} & =\\lim_{x\\to 0}(\\frac{1}{7}\\cdot \\frac{x}{\\operatorname{sin}⁡x}) \\\\  & =\\frac{1}{7}\\cdot {lim}_{x\\to 0}\\frac{x}{\\operatorname{sin}⁡x} \\\\  & =\\frac{1}{7}\\cdot {lim}_{x\\to 0}{\\left(\\frac{\\operatorname{sin}⁡x}{x}\\right)}^{-1} \\\\  & =\\frac{1}{7}\\cdot {[\\lim_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x}]}^{-1} \\\\  & =\\frac{1}{7}\\cdot {1}^{-1} \\\\  & =\\frac{1}{7}\\end{aligned}\n$$"] [:db/cas 17592186078953 :question/problem "Evaluate $lim_(x → 1^{+})\\frac{1 - x^{2}}{1 - \\sqrt{x}}$." "Evaluate $\\lim_{x \\to  1^{+}}\\frac{1 - x^{2}}{1 - \\sqrt{x}}$."] [:db/cas 17592186078958 :question/problem "What is $lim_(h → 0)(\\ln (4 + h) - \\ln (4))/(h)$?" "What is $\\lim_{h \\to  0}(\\ln (4 + h) - \\ln (4))/(h)$?"] [:db/cas 17592186078965 :question/problem "What is $lim_(x → 2)\\frac{3x^{2} - 4x^{3} + 20}{x - 2}$?" "What is $\\lim_{x \\to  2}\\frac{3x^{2} - 4x^{3} + 20}{x - 2}$?"] [:db/cas 17592186078981 :question/problem "Evaluate $lim_(x → ∞)(e^{x})/(\\ln (2x))$." "Evaluate $\\lim_{x \\to  \\infty}(e^{x})/(\\ln (2x))$."] [:db/cas 17592186078982 :question/problem "Evaluate $lim_(x → ∞)(\\ln (3x))/(e^{x})$." "Evaluate $\\lim_{x \\to  \\infty}(\\ln (3x))/(e^{x})$."] [:db/cas 17592186078984 :question/problem "Evaluate $lim_(x → ∞)(x)/(\\ln (2x))$." "Evaluate $\\lim_{x \\to  \\infty}(x)/(\\ln (2x))$."] [:db/cas 17592186079002 :question/problem "What is $lim_(h → 0)(\\sin (π + h))/(h)$?" "What is $\\lim_{h \\to  0}(\\sin (π + h))/(h)$?"] [:db/cas 17592186079003 :question/problem "What is $lim_(x → 3)(\\log (x) - \\log (3))/(x - 3)$?" "What is $\\lim_{x \\to  3}(\\log (x) - \\log (3))/(x - 3)$?"] [:db/cas 17592186079004 :question/problem "![](images/86/86f0d7d835c7e651f8e1fe0781aadc5ba963556010d6817d7c02c4ecf3726e2c.png)\n\nWhich of the following statements are true regarding the graph of the function $y = f(x)$ shown above?\n\n1. $lim_(h → 0)(f(1 + h) - f(1))/(h) = 2$\n2. $lim_(h → 0)(f(3 + h) - f(3))/(h) =-2$\n3. $lim_(h → 0)(f(2 + h) - f(2))/(h) = 3$" "![](images/86/86f0d7d835c7e651f8e1fe0781aadc5ba963556010d6817d7c02c4ecf3726e2c.png)\n\nWhich of the following statements are true regarding the graph of the function $y = f(x)$ shown above?\n\n1. $\\lim_{h \\to  0}(f(1 + h) - f(1))/(h) = 2$\n2. $\\lim_{h \\to  0}(f(3 + h) - f(3))/(h) =-2$\n3. $\\lim_{h \\to  0}(f(2 + h) - f(2))/(h) = 3$"] [:db/cas 17592186079005 :question/problem "![](images/cf/cf714089d8f1194001e9d761882045f71fdcf515c3d7d333965596b96ea2ce39.png)\n\nWhich of the following statements is true regarding the graph of the function $y = f(x)$ shown above?\n\n1. $lim_(h → 0)(f(-1 + h) - f(-1))/(h) = 0.5$\n2. $lim_(h → 0)(f(2 + h) - f(2))/(h) =-0.5$\n3. $lim_(h → 0)(f(5 + h) - f(5))/(h) = 1$" "![](images/cf/cf714089d8f1194001e9d761882045f71fdcf515c3d7d333965596b96ea2ce39.png)\n\nWhich of the following statements is true regarding the graph of the function $y = f(x)$ shown above?\n\n1. $\\lim_{h \\to  0}(f(-1 + h) - f(-1))/(h) = 0.5$\n2. $\\lim_{h \\to  0}(f(2 + h) - f(2))/(h) =-0.5$\n3. $\\lim_{h \\to  0}(f(5 + h) - f(5))/(h) = 1$"] [:db/cas 17592186079006 :question/problem "Calculate $lim_(x → ∞)\\frac{\\sqrt{9x^{4} + 3}}{2x^{2} - x}$." "Calculate $\\lim_{x \\to  \\infty}\\frac{\\sqrt{9x^{4} + 3}}{2x^{2} - x}$."] [:db/cas 17592186079008 :question/problem "Evaluate $lim_(x → - ∞)\\frac{8x + 3}{\\sqrt{4x^{2} + 3x}}$." "Evaluate $\\lim_{x \\to  - \\infty}\\frac{8x + 3}{\\sqrt{4x^{2} + 3x}}$."] [:db/cas 17592186079009 :question/problem "Evaluate $lim_(x → ∞)\\frac{2x}{\\sqrt{9x^{2} - 2}}$." "Evaluate $\\lim_{x \\to  \\infty}\\frac{2x}{\\sqrt{9x^{2} - 2}}$."] [:db/cas 17592186079010 :question/problem "Calculate $lim_(x → - ∞)\\frac{\\sqrt{9x^{6} - x}}{9x - 5}$." "Calculate $\\lim_{x \\to  - \\infty}\\frac{\\sqrt{9x^{6} - x}}{9x - 5}$."] [:db/cas 17592186079012 :question/worked-solution "At $x=0,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}g(x) & =g(0) \\\\  & =\\sqrt{b-3(0)}+2 \\\\  & =\\sqrt{b}+2,\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}g(x) & ={lim}_{x\\to {0}^{+}}(x+3) \\\\  & =0+3 \\\\  & =3.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=0,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{+}}f(x) \\\\ \\sqrt{b}+2 & =3 \\\\ \\sqrt{b} & =3-2 \\\\ \\sqrt{b} & =1 \\\\ b & =1.\\end{aligned}\n$$" "At $x=0,$ the left-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}g(x) & =g(0) \\\\  & =\\sqrt{b-3(0)}+2 \\\\  & =\\sqrt{b}+2,\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{+}}g(x) & =\\lim_{x\\to {0}^{+}}(x+3) \\\\  & =0+3 \\\\  & =3.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=0,$ we require that\n\n$$\n\\begin{aligned}\\lim_{x\\to {0}^{-}}f(x) & =\\lim_{x\\to {0}^{+}}f(x) \\\\ \\sqrt{b}+2 & =3 \\\\ \\sqrt{b} & =3-2 \\\\ \\sqrt{b} & =1 \\\\ b & =1.\\end{aligned}\n$$"] [:db/cas 17592186079015 :question/worked-solution "At $x=2,$ the left-sided limit is \n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}g(x) & =g(2) \\\\  & ={3}^{2a(2)+1} \\\\  & ={3}^{4a+1},\\end{aligned}\n$$\n\n \n\nAt $x=2,$ the right-sided limit is \n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}g(x) & ={lim}_{x\\to {2}^{+}}(2x+5) \\\\  & =2(2)+5 \\\\  & =9.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=2,$ we require that\n\n$$\n\\begin{aligned}{3}^{4a+1} & =9 \\\\ {3}^{4a+1} & ={3}^{2} \\\\ 4a+1 & =2 \\\\ 4a & =1 \\\\ a & =\\frac{1}{4}.\\end{aligned}\n$$\n\n \n\nTherefore, $g(x)$ is continuous at $x=2$ for $a=\\frac{1}{4}.$" "At $x=2,$ the left-sided limit is \n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{-}}g(x) & =g(2) \\\\  & ={3}^{2a(2)+1} \\\\  & ={3}^{4a+1},\\end{aligned}\n$$\n\n \n\nAt $x=2,$ the right-sided limit is \n\n$$\n\\begin{aligned}\\lim_{x\\to {2}^{+}}g(x) & =\\lim_{x\\to {2}^{+}}(2x+5) \\\\  & =2(2)+5 \\\\  & =9.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=2,$ we require that\n\n$$\n\\begin{aligned}{3}^{4a+1} & =9 \\\\ {3}^{4a+1} & ={3}^{2} \\\\ 4a+1 & =2 \\\\ 4a & =1 \\\\ a & =\\frac{1}{4}.\\end{aligned}\n$$\n\n \n\nTherefore, $g(x)$ is continuous at $x=2$ for $a=\\frac{1}{4}.$"] [:db/cas 17592186079025 :question/problem "Evaluate $lim_(x → ∞)\\frac{\\sin x - 3}{x^{3} + x^{2}}$." "Evaluate $\\lim_{x \\to  \\infty}\\frac{\\sin x - 3}{x^{3} + x^{2}}$."] [:db/cas 17592186079026 :question/problem "Evaluate $lim_(x → ∞)\\frac{3\\sin x}{2x + 1}$." "Evaluate $\\lim_{x \\to  \\infty}\\frac{3\\sin x}{2x + 1}$."] [:db/cas 17592186079118 :question/problem "![](images/0f/0f2ed64f9e5629c69b1a84cde49ca043ea3dc0107632bd1241c1b86d95ddd5e4.png)\n\nFind $lim_(x → π/2)f(x)$ for the function $f(x)$ plotted above." "![](images/0f/0f2ed64f9e5629c69b1a84cde49ca043ea3dc0107632bd1241c1b86d95ddd5e4.png)\n\nFind $\\lim_{x \\to  π/2}f(x)$ for the function $f(x)$ plotted above."] [:db/cas 17592186079199 :question/problem "Calculate $lim_(θ → 0)\\frac{2θ}{\\tan θ}$." "Calculate $\\lim_{θ \\to  0}\\frac{2θ}{\\tan θ}$."] [:db/cas 17592186079200 :question/problem "Find the value of $lim_(θ → 0)\\frac{2\\cos θ}{θ\\cot θ}$." "Find the value of $\\lim_{θ \\to  0}\\frac{2\\cos θ}{θ\\cot θ}$."] [:db/cas 17592186079611 :tutorial/content "Now, we will prove the limit\n\n$$\n\\lim_{\\theta \\to 0} \\dfrac{\\sin \\theta}{\\theta}=1.\n$$\n\nFirst, we prove the right-sided limit\n\n$$\n\\lim_{\\theta \\to 0^+} \\dfrac{\\sin \\theta}{\\theta}=1.\n$$\n\nOn the unit circle, we choose the two points, $A$ and $B.$ The point $A$ lies on the $x$-axis and the point $B$ is such that the angle $\\theta=\\angle AOB$ is acute:\n\n$$\n0 < \\theta < \\dfrac{\\pi}{2}\n$$\n\n  \n\nLet $C$ be the point of intersection of the tangent to this circle at the point $A$ and the line $\\overset{\\longleftrightarrow}{OB}.$ The point $H$ is the projection of the point $B$ onto the $x$-axis. See the illustration below.\n\n![](images/05/056cd7fef10de3870c165f07da3e2546981805241453390dce9903b1bf855307.png)\n\nThen, $OA = OB =1,$ $BH = \\sin \\theta,$ and $AC = \\tan \\theta.$\n\nThe area of a triangle $\\triangle OAB$ is less than the area of a sector $OAB$, which is less than the area of a triangle $\\triangle OAC\\mathbin{:}$\n\n$$\n{\\color{SteelBlue}\\mathcal{A}_{\\triangle OAB} }\\leq {\\color{PaleVioletRed}\\mathcal{A}_{sec OAB}} \\leq { \\color{SandyBrown}\\mathcal{A}_{\\triangle OAC}}.\n$$\n\nUsing the formulas for the areas of the triangles and the sector, and noting that $\\theta$ is measured in radians, we get:\n\n$$\n\\begin{aligned}{A}_{△OAB} & =\\frac{1}{2}OA\\cdot BH \\\\  & =\\frac{1}{2}\\cdot 1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{2} \\\\ {A}_{\\text{sec.}OAB} & =\\pi {r}^{2}\\cdot \\frac{\\theta }{2\\pi } \\\\  & =\\pi \\cdot {1}^{2}\\cdot \\frac{\\theta }{2\\pi } \\\\  & =\\frac{\\theta }{2} \\\\ {A}_{△OAC} & =\\frac{1}{2}OA\\cdot AC \\\\  & =\\frac{1}{2}\\cdot 1\\cdot \\operatorname{tan}⁡\\theta  \\\\  & =\\frac{\\operatorname{tan}⁡\\theta }{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\dfrac{\\sin \\theta}{2} \\leq \\dfrac{\\theta}{2} \\leq \\dfrac{\\tan \\theta}{2}.\n$$\n\nMultiplying each part of the final inequality by $\\dfrac{2}{\\sin \\theta},$ we obtain\n\n$$\n1  \\leq \\dfrac{\\theta}{\\sin \\theta} \\leq \\dfrac{1}{\\cos{\\theta}}.\n$$\n\nTaking reciprocals and reversing the inequalities yields\n\n$$\n\\cos{\\theta} \\leq \\dfrac{\\sin \\theta}{\\theta} \\leq 1.\n$$\n\nSince  $$\n\\displaystyle \\lim\\limits_{\\theta \\to 0^+}\\cos{\\theta} = 1\n$$ and $$\n\\displaystyle \\lim\\limits_{\\theta \\to 0^+}1 = 1,\n$$\nwe get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to {0}^{+}}\\operatorname{cos}⁡\\theta  & \\le {lim}_{\\theta \\to {0}^{+}}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }\\le {lim}_{\\theta \\to {0}^{+}}1 \\\\ 1 & \\le {lim}_{\\theta \\to {0}^{+}}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }\\le 1,\\end{aligned}\n$$\n\nand consequently, the squeeze theorem implies that\n\n$$\n\\lim\\limits_{\\theta \\to 0^+} \\dfrac{\\sin \\theta}{\\theta} = 1.\n$$\n\nNow, we'll use this result to calculate $$\n\\displaystyle \\lim\\limits_{\\theta \\to 0^-} \\dfrac{\\sin \\theta}{\\theta}.\n$$ \n\nLet $u=-\\theta.$ Then, the limit $\\theta \\to 0^-$ is equivalent to $u \\to 0^+.$ Therefore,\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to {0}^{-}}\\frac{\\operatorname{sin}⁡\\theta }{\\theta } & ={lim}_{u\\to {0}^{+}}\\frac{\\operatorname{sin}⁡(-u)}{(-u)} \\\\  & ={lim}_{u\\to {0}^{+}}\\frac{-\\operatorname{sin}⁡u}{-u} \\\\  & ={lim}_{u\\to {0}^{+}}\\frac{\\operatorname{sin}⁡u}{u} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, since \n\n$$\n\\lim_{\\theta \\to 0^+} \\dfrac{\\sin \\theta}{\\theta} =  \\lim_{\\theta \\to 0^-} \\dfrac{\\sin \\theta}{\\theta}=1,\n$$\n\nwe conclude that\n\n$$\n\\lim_{\\theta \\to 0} \\dfrac{\\sin \\theta}{\\theta} = 1.\n$$" "Now, we will prove the limit\n\n$$\n\\lim_{\\theta \\to 0} \\dfrac{\\sin \\theta}{\\theta}=1.\n$$\n\nFirst, we prove the right-sided limit\n\n$$\n\\lim_{\\theta \\to 0^+} \\dfrac{\\sin \\theta}{\\theta}=1.\n$$\n\nOn the unit circle, we choose the two points, $A$ and $B.$ The point $A$ lies on the $x$-axis and the point $B$ is such that the angle $\\theta=\\angle AOB$ is acute:\n\n$$\n0 < \\theta < \\dfrac{\\pi}{2}\n$$\n\n  \n\nLet $C$ be the point of intersection of the tangent to this circle at the point $A$ and the line $\\overset{\\longleftrightarrow}{OB}.$ The point $H$ is the projection of the point $B$ onto the $x$-axis. See the illustration below.\n\n![](images/05/056cd7fef10de3870c165f07da3e2546981805241453390dce9903b1bf855307.png)\n\nThen, $OA = OB =1,$ $BH = \\sin \\theta,$ and $AC = \\tan \\theta.$\n\nThe area of a triangle $\\triangle OAB$ is less than the area of a sector $OAB$, which is less than the area of a triangle $\\triangle OAC\\mathbin{:}$\n\n$$\n{\\color{SteelBlue}\\mathcal{A}_{\\triangle OAB} }\\leq {\\color{PaleVioletRed}\\mathcal{A}_{sec OAB}} \\leq { \\color{SandyBrown}\\mathcal{A}_{\\triangle OAC}}.\n$$\n\nUsing the formulas for the areas of the triangles and the sector, and noting that $\\theta$ is measured in radians, we get:\n\n$$\n\\begin{aligned}{A}_{△OAB} & =\\frac{1}{2}OA\\cdot BH \\\\  & =\\frac{1}{2}\\cdot 1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{2} \\\\ {A}_{\\text{sec.}OAB} & =\\pi {r}^{2}\\cdot \\frac{\\theta }{2\\pi } \\\\  & =\\pi \\cdot {1}^{2}\\cdot \\frac{\\theta }{2\\pi } \\\\  & =\\frac{\\theta }{2} \\\\ {A}_{△OAC} & =\\frac{1}{2}OA\\cdot AC \\\\  & =\\frac{1}{2}\\cdot 1\\cdot \\operatorname{tan}⁡\\theta  \\\\  & =\\frac{\\operatorname{tan}⁡\\theta }{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\dfrac{\\sin \\theta}{2} \\leq \\dfrac{\\theta}{2} \\leq \\dfrac{\\tan \\theta}{2}.\n$$\n\nMultiplying each part of the final inequality by $\\dfrac{2}{\\sin \\theta},$ we obtain\n\n$$\n1  \\leq \\dfrac{\\theta}{\\sin \\theta} \\leq \\dfrac{1}{\\cos{\\theta}}.\n$$\n\nTaking reciprocals and reversing the inequalities yields\n\n$$\n\\cos{\\theta} \\leq \\dfrac{\\sin \\theta}{\\theta} \\leq 1.\n$$\n\nSince  $$\n\\displaystyle \\lim\\limits_{\\theta \\to 0^+}\\cos{\\theta} = 1\n$$ and $$\n\\displaystyle \\lim\\limits_{\\theta \\to 0^+}1 = 1,\n$$\nwe get\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to {0}^{+}}\\operatorname{cos}⁡\\theta  & \\le {lim}_{\\theta \\to {0}^{+}}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }\\le {lim}_{\\theta \\to {0}^{+}}1 \\\\ 1 & \\le {lim}_{\\theta \\to {0}^{+}}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }\\le 1,\\end{aligned}\n$$\n\nand consequently, the squeeze theorem implies that\n\n$$\n\\lim\\limits_{\\theta \\to 0^+} \\dfrac{\\sin \\theta}{\\theta} = 1.\n$$\n\nNow, we'll use this result to calculate $$\n\\displaystyle \\lim\\limits_{\\theta \\to 0^-} \\dfrac{\\sin \\theta}{\\theta}.\n$$ \n\nLet $u=-\\theta.$ Then, the limit $\\theta \\to 0^-$ is equivalent to $u \\to 0^+.$ Therefore,\n\n$$\n\\begin{aligned}\\lim_{\\theta \\to {0}^{-}}\\frac{\\operatorname{sin}⁡\\theta }{\\theta } & =\\lim_{u\\to {0}^{+}}\\frac{\\operatorname{sin}⁡(-u)}{(-u)} \\\\  & =\\lim_{u\\to {0}^{+}}\\frac{-\\operatorname{sin}⁡u}{-u} \\\\  & =\\lim_{u\\to {0}^{+}}\\frac{\\operatorname{sin}⁡u}{u} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, since \n\n$$\n\\lim_{\\theta \\to 0^+} \\dfrac{\\sin \\theta}{\\theta} =  \\lim_{\\theta \\to 0^-} \\dfrac{\\sin \\theta}{\\theta}=1,\n$$\n\nwe conclude that\n\n$$\n\\lim_{\\theta \\to 0} \\dfrac{\\sin \\theta}{\\theta} = 1.\n$$"] [:db/cas 17592186079615 :tutorial/content "In general, the limit of a function $f(x)$ at a point only exists if *both* the left-sided and right-sided limits *exist* and are the *same*.\n\nFor example, suppose we want to compute $$\n\\displaystyle \\lim_\\limits{x\\rightarrow 2}f(x)\n$$ for the function whose graph is shown below. To do this, we must first compute the left and right-sided limits.\n\n![](images/d9/d99cb9753d63d0812245159b6727e30408eb6cd89d01ecb2f4090f65925527f1.png)\n\nAs $x$ approaches $2$ from the left, $y$ approaches $0$. However, as $x$ approaches $2$ from the right, $y$ approaches $1$. Therefore, we have the following left and right-sided limits.\n\n$$\n\\begin{bmatrix}Left-sided limit: & lim_(x → 2^{-})f(x) = 0 \\\\ Right-sided limit: & lim_(x → 2^{+})f(x) = 1\\end{bmatrix}\n$$\n\nBoth of these limits exist. However, they are *not* the same. Consequently, the overall limit at $x=2$ does not exist:\n\n$$\n\\lim_\\limits{x\\rightarrow 2}f(x)=\\text{DNE}\n$$" "In general, the limit of a function $f(x)$ at a point only exists if *both* the left-sided and right-sided limits *exist* and are the *same*.\n\nFor example, suppose we want to compute $$\n\\displaystyle \\lim_{x\\rightarrow 2}f(x)\n$$ for the function whose graph is shown below. To do this, we must first compute the left and right-sided limits.\n\n![](images/d9/d99cb9753d63d0812245159b6727e30408eb6cd89d01ecb2f4090f65925527f1.png)\n\nAs $x$ approaches $2$ from the left, $y$ approaches $0$. However, as $x$ approaches $2$ from the right, $y$ approaches $1$. Therefore, we have the following left and right-sided limits.\n\n$$\n\\begin{aligned}\\text{Left-sided limit: }\\hspace{0.25cm} & \\lim_{x\\to {2}^{-}}f(x)=0 \\\\ \\text{Right-sided limit: }\\hspace{0.25cm} & \\lim_{x\\to {2}^{+}}f(x)=1\\end{aligned}\n$$\n\nBoth of these limits exist. However, they are *not* the same. Consequently, the overall limit at $x=2$ does not exist:\n\n$$\n\\lim_{x\\rightarrow 2}f(x)=\\text{DNE}\n$$"] [:db/cas 17592186079632 :tutorial/content "Consider the graph of the absolute value function\n\n$$\ny= \\mid x \\mid\n$$\n\nbelow.\n\n![](images/d9/d9dbef726750fac7a608667168eb9fd13380eb407fa3b059543ff11122096411.png)\n\nFrom this graph, we see that as $x$ approaches $4$, the value of $y$ approaches\n\n$$\n\\begin{aligned}\n\\mid 4 &= 4\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to 4} \\begin{vmatrix}x & = & 4\\end{vmatrix} = 4\n$$\n\nThe absolute value is defined for all real $x$. As $x$ approaches any finite number $a$, the limit of the absolute value function can be obtained by directly substituting $x=a$ into the absolute value:\n\n$$\n\\lim_{x\\to a} \\begin{vmatrix}x & = & a\\end{vmatrix}\n$$\n\nAdditionally, we can see from the graph that the limits at infinity are\n\n$$\n\\lim_{x\\to \\infty} \\begin{vmatrix}x & = \\infty \\qquad \\textrm{and}\\qquad \\lim_{x\\to -\\infty} & x\\end{vmatrix} = \\infty\n$$" "Consider the graph of the absolute value function\n\n$$\ny= \\mid x \\mid\n$$\n\nbelow.\n\n![](images/d9/d9dbef726750fac7a608667168eb9fd13380eb407fa3b059543ff11122096411.png)\n\nFrom this graph, we see that as $x$ approaches $4$, the value of $y$ approaches\n\n$$\n\\begin{aligned}\n\\mid 4 &= 4\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim_{x\\to 4} |x| = |4| = 4.\n$$\n\nThe absolute value is defined for all real $x$. As $x$ approaches any finite number $a$, the limit of the absolute value function can be obtained by directly substituting $x=a$ into the absolute value:\n\n$$\n\\lim_{x\\to a} |x| = |a|\n$$\n\nAdditionally, we can see from the graph that the limits at infinity are\n\n$$\n\\lim_{x\\to \\infty} |x| = \\infty \\qquad \\textrm{and}\\qquad \\lim_{x\\to -\\infty} |x| = \\infty.\n$$"] [:db/cas 17592186079646 :tutorial/content "Suppose that we want to calculate the following limit:\n\n$$\n\\lim_{x \\to 1} \\frac{\\sqrt{x} - 1}{x - 1}\n$$\n\nIf we try to evaluate the limit by directly substituting $x=1,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{\\sqrt{x}-1}{x-1} & =\\frac{\\sqrt{1}-1}{1-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, if we simplify the fraction before evaluating the limit, we obtain a more clear result. To simplify the fraction, we can multiply the numerator and the denominator of the function by the **conjugate** of the numerator.\n\nTo obtain the conjugate of $\\sqrt{x}-1,$ we simply switch the sign between the two terms to get $\\sqrt{x}+ 1.$ \n\n$$\n\\begin{aligned}\n\\lim_{x\\to 1} \\frac{\\sqrt{x} - 1} {x - 1}\n\t&= \\lim_{x\\to 1} \\frac{\\sqrt{x} - 1} {x - 1} \\cdot\\dfrac{\\sqrt{x} + 1}{\\sqrt{x} + 1}\t\\\\\n\t&=\\lim_{x\\to 1} \\dfrac{(\\sqrt{x} - 1)(\\sqrt{x} +1)} {(x-1)(\\sqrt{x} + 1)}\\\\\n        &=\\lim_{x\\to 1} \\dfrac{\\left(\\sqrt{x}\\right)^2 - 1^2} {(x-1)(\\sqrt{x} + 1)}\\\\\n\t&=\\lim_{x\\to 1} \\dfrac{x-1} {(x-1)(\\sqrt{x} + 1)}\\\\\n\t&=\\lim_{x\\to 1} \\dfrac{\\cancel{x-1}} {\\cancel{(x-1)}(\\sqrt{x} + 1)}\\\\\n\t&=\\lim_{x\\to 1} \\dfrac1{\\sqrt{x} + 1}\\\\\n        &=\\dfrac{1}{\\sqrt{1} +1}\\\\\n\t&=\\dfrac{1}{2}\n\\end{aligned}\n$$" "Suppose that we want to calculate the following limit:\n\n$$\n\\lim_{x \\to 1} \\frac{\\sqrt{x} - 1}{x - 1}\n$$\n\nIf we try to evaluate the limit by directly substituting $x=1,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}\\lim_{x\\to 1}\\frac{\\sqrt{x}-1}{x-1} & =\\frac{\\sqrt{1}-1}{1-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, if we simplify the fraction before evaluating the limit, we obtain a more clear result. To simplify the fraction, we can multiply the numerator and the denominator of the function by the **conjugate** of the numerator.\n\nTo obtain the conjugate of $\\sqrt{x}-1,$ we simply switch the sign between the two terms to get $\\sqrt{x}+ 1.$ \n\n$$\n\\begin{aligned}\n\\lim_{x\\to 1} \\frac{\\sqrt{x} - 1} {x - 1}\n\t&= \\lim_{x\\to 1} \\frac{\\sqrt{x} - 1} {x - 1} \\cdot\\dfrac{\\sqrt{x} + 1}{\\sqrt{x} + 1}\t\\\\\n\t&=\\lim_{x\\to 1} \\dfrac{(\\sqrt{x} - 1)(\\sqrt{x} +1)} {(x-1)(\\sqrt{x} + 1)}\\\\\n        &=\\lim_{x\\to 1} \\dfrac{\\left(\\sqrt{x}\\right)^2 - 1^2} {(x-1)(\\sqrt{x} + 1)}\\\\\n\t&=\\lim_{x\\to 1} \\dfrac{x-1} {(x-1)(\\sqrt{x} + 1)}\\\\\n\t&=\\lim_{x\\to 1} \\dfrac{\\cancel{x-1}} {\\cancel{(x-1)}(\\sqrt{x} + 1)}\\\\\n\t&=\\lim_{x\\to 1} \\dfrac1{\\sqrt{x} + 1}\\\\\n        &=\\dfrac{1}{\\sqrt{1} +1}\\\\\n\t&=\\dfrac{1}{2}\n\\end{aligned}\n$$"] [:db/cas 17592186079652 :tutorial/content "Suppose that we wish to calculate the limit\n\n$$\nL=\\lim\\limits_{h\\to 0} \\dfrac{\\ln(2+h) -\\ln(2)}{h}\n$$\n\nThe key here is to notice that the limit looks very similar to the instantaneous rate of change formula,\n\n$$\nf'(a) = \\lim\\limits_{h\\to 0} \\dfrac{f(a+h)-f(a)}{h}\n$$\n\nfor the function\n\n$$\nf(x) = \\ln x\n$$\n\nat $a=2$.\n\nLet's substitute\n\n$$\nf(x) = \\ln x\n$$\n\nand $a=2$ into the above, just to be sure:\n\n$$\n\\begin{aligned}\nf^{′}(2) &= lim_(h → 0)(f(2 + h) - f(2))/(h) \\\\\n&= lim_(h → 0)(\\ln (2 + h) - \\ln (2))/(h) \\\\\n&= L\n\\end{aligned}\n$$\n\nThis confirms that $L = f'(2)$. So instead of working out that difficult limit, we only need to work out $f'(2)$.\n\nComputing the derivative, we have\n\n$$\nf'(x) = \\frac{1}{x}, \\qquad f'(2) = \\dfrac{1}{2}\n$$\n\nand therefore we conclude that\n\n$$\nL=\\dfrac{1}{2}\n$$" "Suppose that we wish to calculate the limit\n\n$$\nL=\\lim\\limits_{h\\to 0} \\dfrac{\\ln(2+h) -\\ln(2)}{h}\n$$\n\nThe key here is to notice that the limit looks very similar to the instantaneous rate of change formula,\n\n$$\nf'(a) = \\lim\\limits_{h\\to 0} \\dfrac{f(a+h)-f(a)}{h}\n$$\n\nfor the function\n\n$$\nf(x) = \\ln x\n$$\n\nat $a=2$.\n\nLet's substitute\n\n$$\nf(x) = \\ln x\n$$\n\nand $a=2$ into the above, just to be sure:\n\n$$\n\\begin{aligned}\nf^{′}(2) &= \\lim_{h \\to  0}(f(2 + h) - f(2))/(h) \\\\\n&= \\lim_{h \\to  0}(\\ln (2 + h) - \\ln (2))/(h) \\\\\n&= L\n\\end{aligned}\n$$\n\nThis confirms that $L = f'(2)$. So instead of working out that difficult limit, we only need to work out $f'(2)$.\n\nComputing the derivative, we have\n\n$$\nf'(x) = \\frac{1}{x}, \\qquad f'(2) = \\dfrac{1}{2}\n$$\n\nand therefore we conclude that\n\n$$\nL=\\dfrac{1}{2}\n$$"] [:db/cas 17592186079654 :tutorial/content "Consider the limit\n\n$$\n\\lim_\\limits{x \\to 0} \\dfrac{\\sin x}{x}.\n$$\n\nDirect substitution leads to the indeterminate form: \n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{x} &=\\frac{\\operatorname{sin}⁡(0)}{0}=\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, if we plot the graphs of $y=\\dfrac{\\sin x}{x},$ we get the following picture.\n\n![](images/53/53e8d0766ac043e9dc5358ed7aed73ee1eafed80eae7162c8ecab2cd9c4956a2.png)\n\nWhile $y = \\dfrac{\\sin{x}}{x}$ is undefined at $x=0,$ it does appear from the graph that \n\n$$\n\\lim_\\limits{x \\to 0} \\dfrac{\\sin x}{x}=1.\n$$\n\nIt's possible to prove this result more rigorously, and we'll do this at the end of the lesson. For now, we will assume that it is true and use it to calculate other limits." "Consider the limit\n\n$$\n\\lim_{x \\to 0} \\dfrac{\\sin x}{x}.\n$$\n\nDirect substitution leads to the indeterminate form: \n\n$$\n\\begin{aligned}\\lim_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{x} &=\\frac{\\operatorname{sin}⁡(0)}{0}=\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, if we plot the graphs of $y=\\dfrac{\\sin x}{x},$ we get the following picture.\n\n![](images/53/53e8d0766ac043e9dc5358ed7aed73ee1eafed80eae7162c8ecab2cd9c4956a2.png)\n\nWhile $y = \\dfrac{\\sin{x}}{x}$ is undefined at $x=0,$ it does appear from the graph that \n\n$$\n\\lim_{x \\to 0} \\dfrac{\\sin x}{x}=1.\n$$\n\nIt's possible to prove this result more rigorously, and we'll do this at the end of the lesson. For now, we will assume that it is true and use it to calculate other limits."] [:db/cas 17592186079683 :tutorial/content "Consider the function $f(x)$ below:\n$$\nf(x) =\n{\\left\\{  \\begin{array}{ll}3 {x}^{2} + k x , & x < - 3 , \\\\ {x}^{3} , & x \\ge  - 3\\end{array} \\right. }\n$$\n\nThe function $f(x)$ seems to have a jump discontinuity at $x=-3.$ However, by selecting a particular value for $k$, we can remove the jump discontinuity and make the function continuous.\n\nWe can find this value of $k$ by forcing the left and right-sided limits of the function to be equal at $x=-3\\mathbin{:}$\n\n$$\n\\lim\\limits_{x\\to (-3)^-} f(x) = \\lim\\limits_{x\\to (-3)^+} f(x)\n$$\n\nFor the left limit, we have,\n\n$$\n\\begin{aligned}{lim}_{x\\to (-3)^{-}}f(x) & ={lim}_{x\\to (-3)^{-}}(3{x}^{2}+kx) \\\\  & =3(-3)^{2}+k(-3) \\\\  & =27-3k,\\end{aligned}\n$$\n\nand for the right limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (-3)^{+}}f(x) & ={lim}_{x\\to (-3)^{+}}{x}^{3} \\\\  & =(-3)^{3} \\\\  & =-27.\\end{aligned}\n$$\n\nSetting the left and right limits as equal, we have\n\n$$\n\\begin{aligned}27-3k & =-27 \\\\ 3k & =54 \\\\ k & =18.\\end{aligned}\n$$\n\nTherefore, to make $f(x)$ continuous at $x=-3,$ we need to choose $k=18.$" "Consider the function $f(x)$ below:\n$$\nf(x) =\n{\\left\\{  \\begin{array}{ll}3 {x}^{2} + k x , & x < - 3 , \\\\ {x}^{3} , & x \\ge  - 3\\end{array} \\right. }\n$$\n\nThe function $f(x)$ seems to have a jump discontinuity at $x=-3.$ However, by selecting a particular value for $k$, we can remove the jump discontinuity and make the function continuous.\n\nWe can find this value of $k$ by forcing the left and right-sided limits of the function to be equal at $x=-3\\mathbin{:}$\n\n$$\n\\lim\\limits_{x\\to (-3)^-} f(x) = \\lim\\limits_{x\\to (-3)^+} f(x)\n$$\n\nFor the left limit, we have,\n\n$$\n\\begin{aligned}\\lim_{x\\to (-3)^{-}}f(x) & =\\lim_{x\\to (-3)^{-}}(3{x}^{2}+kx) \\\\  & =3(-3)^{2}+k(-3) \\\\  & =27-3k,\\end{aligned}\n$$\n\nand for the right limit, we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (-3)^{+}}f(x) & =\\lim_{x\\to (-3)^{+}}{x}^{3} \\\\  & =(-3)^{3} \\\\  & =-27.\\end{aligned}\n$$\n\nSetting the left and right limits as equal, we have\n\n$$\n\\begin{aligned}27-3k & =-27 \\\\ 3k & =54 \\\\ k & =18.\\end{aligned}\n$$\n\nTherefore, to make $f(x)$ continuous at $x=-3,$ we need to choose $k=18.$"] [:db/cas 17592186079686 :tutorial/content "How do we evaluate a limit like\n\n$$\n\\displaystyle \\lim_{x\\to\\infty}\\dfrac{x^2}{\\sqrt{9x^4+x}}\n$$\n\nBecause the ${\\color{blue}{x^4}}$ in the radical is a perfect square, we can factor it outside of the radical.\n\n$$\n\\begin{aligned}\nlim_(x → ∞)\\frac{x^{2}}{\\sqrt{9x^{4} + x}} &= lim_(x → ∞)(x^{2})/(\\sqrt{x^{4}(9 + \\frac{x}{x^{4}})}) \\\\\n&= lim_(x → ∞)\\frac{x^{2}}{\\sqrt{x^{4}} \\cdot \\sqrt{9 + \\frac{1}{x^{3}}}} \\\\\n&= lim_(x → ∞)\\frac{x^{2}}{\\mid x^{2} \\mid \\sqrt{9 + \\frac{1}{x^{3}}}}\n\\end{aligned}\n$$\n\nSince $x^2>0$ for all $x$, we have\n\n$$\n\\begin{aligned}\n\\mid x^2 &= x^2\n\\end{aligned}\n$$\n\nThen, we can cancel the $x^2$ in the numerator and denominator, and evaluate the limit.\n\n$$\n\\begin{aligned}\nlim_(x → ∞)\\frac{x^{2}}{\\mid x^{2} \\mid \\sqrt{9 + \\frac{1}{x^{3}}}} &= lim_(x → ∞)\\frac{x^{2}}{x^{2}\\sqrt{9 + \\frac{1}{x^{3}}}} \\\\\n&= lim_(x → ∞)\\frac{1}{\\sqrt{9 + \\frac{1}{x^{3}}}} \\\\\n&= \\frac{1}{\\sqrt{9 + 0}} \\\\\n&= \\frac{1}{3}\n\\end{aligned}\n$$" "How do we evaluate a limit like\n\n$$\n\\displaystyle \\lim_{x\\to\\infty}\\dfrac{x^2}{\\sqrt{9x^4+x}}\n$$\n\nBecause the ${\\color{blue}{x^4}}$ in the radical is a perfect square, we can factor it outside of the radical.\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  \\infty}\\frac{x^{2}}{\\sqrt{9x^{4} + x}} &= \\lim_{x \\to  \\infty}(x^{2})/(\\sqrt{x^{4}(9 + \\frac{x}{x^{4}})}) \\\\\n&= \\lim_{x \\to  \\infty}\\frac{x^{2}}{\\sqrt{x^{4}} \\cdot \\sqrt{9 + \\frac{1}{x^{3}}}} \\\\\n&= \\lim_{x \\to  \\infty}\\frac{x^{2}}{\\mid x^{2} \\mid \\sqrt{9 + \\frac{1}{x^{3}}}}\n\\end{aligned}\n$$\n\nSince $x^2>0$ for all $x$, we have\n\n$$\n\\begin{aligned}\n\\mid x^2 &= x^2\n\\end{aligned}\n$$\n\nThen, we can cancel the $x^2$ in the numerator and denominator, and evaluate the limit.\n\n$$\n\\begin{aligned}\n\\lim_{x \\to  \\infty}\\frac{x^{2}}{\\mid x^{2} \\mid \\sqrt{9 + \\frac{1}{x^{3}}}} &= \\lim_{x \\to  \\infty}\\frac{x^{2}}{x^{2}\\sqrt{9 + \\frac{1}{x^{3}}}} \\\\\n&= \\lim_{x \\to  \\infty}\\frac{1}{\\sqrt{9 + \\frac{1}{x^{3}}}} \\\\\n&= \\frac{1}{\\sqrt{9 + 0}} \\\\\n&= \\frac{1}{3}\n\\end{aligned}\n$$"] [:db/cas 17592186079709 :tutorial/content "The sum of the first $N$ terms of an arithmetic series with the initial term $a_1$ and the common difference $d$ can be found as\n\n$$\nS_N = \\frac{N}{2}\\big(2a_1+(N-1)d \\big)\n$$\n\nWe'll now prove this result.\n\nFirst, we recall that the $n$th term of the series is given by\n\n$$\na_n = a_1 + (n-1)d\n$$\n\nLet's write down the sum by placing the indices\n\n$$\nn=1,2,3,\\ldots, N\n$$\n\nin ascending order:\n\n$$\n\\begin{aligned}\nS_{N} &= a_{1} + a_{2} + ⋯ + a_{N - 1} + a_{N} \\\\\n&= a_{1} + \\underbrace{(a_{1} + d)}_{{a}_{2}} + ⋯ + \\underbrace{(a_{1} + (N - 2)d)}_{{a}_{N-1}} + \\underbrace{(a_{1} + (N - 1)d)}_{{a}_{N}}\n\\end{aligned}\n$$\n\nNow, let's write down the same sum but place the indices in descending order:\n\n$$\n\\begin{aligned}\nS_{N} &= a_{N} + a_{N - 1} + ⋯ + a_{2} + a_{1} \\\\\n&= \\underbrace{(a_{1} + (N - 1)d)}_{{a}_{N}} + \\underbrace{(a_{1} + (N - 2)d)}_{{a}_{N-1}} + ⋯ + \\underbrace{(a_{1} + d)}_{{a}_{2}} + a_{1}\n\\end{aligned}\n$$\n\nBy adding the two expressions, we get the following:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}S_{N} &= & a_{1} & + & (a_{1} + d) & + & ⋯ & + & (a_{1} + (N - 1)d) \\\\ S_{N}|= & (a_{1} + (N - 1)d) & + & (a_{1} + (N - 2)d) & + & ⋯ & + & a_{1} \\\\ 2S_{N}|= & (2a_{1} + (N - 1)d) & + & (2a_{1} + (N - 1)d) & + & ⋯ & + & (2a_{1} + (N - 1)d)\\end{bmatrix}\n\\end{aligned}\n$$\n\nThe expression on the right contains $N$ copies of $2a_1+(N-1)d$. Therefore,\n\n$$\n2S_{N} = N \\cdot (2a_{1} + (N - 1)d)⟹S_{N} = \\frac{N}{2}(2a_{1} + (N - 1)d)\n$$" "The sum of the first $N$ terms of an arithmetic series with the initial term $a_1$ and the common difference $d$ can be found as\n\n$$\nS_N = \\frac{N}{2}\\big(2a_1+(N-1)d \\big)\n$$\n\nWe'll now prove this result.\n\nFirst, we recall that the $n$th term of the series is given by\n\n$$\na_n = a_1 + (n-1)d\n$$\n\nLet's write down the sum by placing the indices\n\n$$\nn=1,2,3,\\ldots, N\n$$\n\nin ascending order:\n\n$$\n\\begin{aligned}\nS_{N} &= a_{1} + a_{2} + ⋯ + a_{N - 1} + a_{N} \\\\\n&= a_{1} + \\underbrace{(a_{1} + d)}_{{a}_{2}} + ⋯ + \\underbrace{(a_{1} + (N - 2)d)}_{{a}_{N-1}} + \\underbrace{(a_{1} + (N - 1)d)}_{{a}_{N}}\n\\end{aligned}\n$$\n\nNow, let's write down the same sum but place the indices in descending order:\n\n$$\n\\begin{aligned}\nS_{N} &= a_{N} + a_{N - 1} + ⋯ + a_{2} + a_{1} \\\\\n&= \\underbrace{(a_{1} + (N - 1)d)}_{{a}_{N}} + \\underbrace{(a_{1} + (N - 2)d)}_{{a}_{N-1}} + ⋯ + \\underbrace{(a_{1} + d)}_{{a}_{2}} + a_{1}\n\\end{aligned}\n$$\n\nBy adding the two expressions, we get the following:\n\n$$\n\\begin{array}{ccccccccc}{S}_{N} & = & {a}_{1} & + & ({a}_{1}+d) & + & ⋯ & + & ({a}_{1}+(N-1)d) \\\\ {S}_{N} & = & ({a}_{1}+(N-1)d) & + & ({a}_{1}+(N-2)d) & + & ⋯ & + & {a}_{1} \\\\ \\hline 2{S}_{N} & = & (2{a}_{1}+(N-1)d) & + & (2{a}_{1}+(N-1)d) & + & ⋯ & + & (2{a}_{1}+(N-1)d)\\end{array}\n$$\n\nThe expression on the right contains $N$ copies of $2a_1+(N-1)d$. Therefore,\n\n$$\n2S_{N} = N \\cdot (2a_{1} + (N - 1)d)⟹S_{N} = \\frac{N}{2}(2a_{1} + (N - 1)d)\n$$"] [:db/cas 17592186081342 :answer/value "lim_(a → + ∞)(\\displaystyle \\int_{2}^{a}\\frac{dx}{\\sqrt{x^{2} - 4}})" "\\lim_{a \\to  + \\infty}(\\displaystyle \\int_{2}^{a}\\frac{dx}{\\sqrt{x^{2} - 4}})"] [:db/cas 17592186081343 :answer/value "lim_(a → 4^{+})(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})" "\\lim_{a \\to  4^{+}}(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})"] [:db/cas 17592186081344 :answer/value "lim_(a → - ∞)(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})" "\\lim_{a \\to  - \\infty}(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})"] [:db/cas 17592186081345 :answer/value "lim_(a → 2^{+})(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})" "\\lim_{a \\to  2^{+}}(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})"] [:db/cas 17592186081346 :answer/value "lim_(a → 5^{-})(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})" "\\lim_{a \\to  5^{-}}(\\displaystyle \\int_{a}^{5}\\frac{dx}{\\sqrt{x^{2} - 4}})"] [:db/cas 17592186081444 :answer/value "$lim_(n → ∞)a_{n} = 1$. The series converges" "$\\lim_{n \\to  \\infty}a_{n} = 1$. The series converges"] [:db/cas 17592186081445 :answer/value "$lim_(n → ∞)a_{n} = 0$. The series diverges" "$\\lim_{n \\to  \\infty}a_{n} = 0$. The series diverges"] [:db/cas 17592186081446 :answer/value "$lim_(n → ∞)a_{n} = 0$. The series converges" "$\\lim_{n \\to  \\infty}a_{n} = 0$. The series converges"] [:db/cas 175921860