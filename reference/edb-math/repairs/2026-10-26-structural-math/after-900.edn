\\color{red}0$ and carry ${\\color{blue}3}$.\n\n$$\n\\begin{aligned} & \\begin{array}{ccccc} &  & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}{}_{{\\color{blue}{3}}}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}{}_{{\\color{blue}{2}}}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} &  \\\\  &  & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}1\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}4\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}3\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} \\\\ \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\times \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} &  &  &  & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}7\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} \\\\ \\hline  & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}{\\color{red}{0\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}}} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}1\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\end{array} & \\hspace{2em}\\hspace{2em} & \\begin{aligned}4\\times 7=28\\hspace{1em}\\text{and}\\hspace{1em}{\\color{blue}{2}}+28=30 \\\