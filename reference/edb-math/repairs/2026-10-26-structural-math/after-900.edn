7em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}.\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}7\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}0\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} \\\\ \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}-\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} &  & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}3\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}.\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}1\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}6\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} \\\\ \\hline  &  &  & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}.\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em} &  & \\end{array}\n$$.\n\nNext, we proceed by subtracting the two numbers just as we would with whole numbers:\n$$\n{\\begin{array}{cccccc} &  & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} {\\color{blue} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em}} &  & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} {\\color{blue}\\begin{array}{c} \\\\ 6\\end{array} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em}} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} {\\color{blue}\\begin{array}{c} \\\\ 10\\end{array} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em}} \\\\  &  & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 4 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} . \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\cancel{\\hspace{-0.167em} 7 \\hspace{-0.167em}} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\cancel{\\hspace{-0.167em} 0 \\hspace{-0.167em}} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\\\ \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} - \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} &  & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 3 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} . \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 1 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 6 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\\\ \\hline  &  & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 1 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} . \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 5 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 4 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em}\\end{array}}\n$$\n\nTherefore,\n\n$$\n4.7-3.16 = 1.54\\,\n$$"] [17592186139731 :tutorial/content "We can use the standard algorithm to multiply a three-digit number by a one-digit number. In this case, we might need to carry a digit from the multiplication of the ones *and* tens.\n\nFor instance, let's find the value of\n\n$$\n143 \\times 7\n$$\n\nWe start by writing the problem out as follows:\n\n$$\n{\\begin{array}{rlrl}\\displaystyle  & \\displaystyle \\begin{array}{ccccc}\\displaystyle  & \\displaystyle  & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle  \\\\ \\displaystyle  & \\displaystyle  & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 1 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 4 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 3 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\\\ \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\times  \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle  & \\displaystyle  & \\displaystyle  & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 7 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\\\ \\hline \\displaystyle  & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em}\\end{array} & \\displaystyle \\hspace{2em} \\hspace{2em} & \\displaystyle \\hspace{2em} \\phantom{10 \\hspace{1em} \\text{and} \\hspace{1em} {\\color{blue}2} + 10 = 1200000}\\end{array}}\n$$\n\nFirst, we multiply the ones. We have\n\n$$\n3\\times 7 = {\\color{blue}2}{\\color{red}1}\n$$\n\nWe write $\\color{red}1$ in the ones place and carry the ${\\color{blue}2}$.\n\n$$\n{\\begin{array}{rlrl}\\displaystyle  & \\displaystyle \\begin{array}{ccccc}\\displaystyle  & \\displaystyle  & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\underset{ {\\color{blue}2}}{} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle  \\\\ \\displaystyle  & \\displaystyle  & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} 1 \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} \\hspace{-0.167em} & \\displaystyle \\hspace{-0.167em} \\hspace{-0.167em} \\hspac