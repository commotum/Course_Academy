#{[{:db/id #edb/ref 17592186705114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7144605f-159a-52e4-bd00-8aae8b6a028d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186705119} {:answer/id #uuid "4f865d8d-87b4-49c5-a7aa-0799cb85397a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac72" :db/id #edb/ref 17592186717185}] :answer-field/correct {:answer/id #uuid "7144605f-159a-52e4-bd00-8aae8b6a028d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186705119} :answer-field/id #uuid "d25eddd8-02c9-5ffa-8e4a-02543cd922bf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186705126} {:answer-field/choices [{:answer/id #uuid "71d824b6-97f6-5003-b8d6-0a1f5cb651d0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186705120}] :answer-field/correct {:answer/id #uuid "71d824b6-97f6-5003-b8d6-0a1f5cb651d0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186705120} :answer-field/id #uuid "e5b8653c-a2ee-5136-ad4d-659087fda9d0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186705127}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "442d5432-8a42-576a-a879-172b4af2c459" :question/problem "Complete the square on $y^2-7y+\\frac{65}{4}$.\n\nFill in the nonnegative numbers.\n\n$y^2-7y+\\frac{65}{4}=(y-$ {{field-1}} $)^2+$ {{field-2}}" :question/worked-solution "The half of the linear coefficient is $-\\frac{7}{2}$. **Add and subtract** its square so the expression keeps its value.\n\n$$\n\\begin{aligned}\ny^2-7y+\\frac{65}{4}&=\\underbrace{y^2-2\\cdot \\frac{7}{2}y+\\frac{49}{4}}_{\\text{perfect square}}-\\frac{49}{4}+\\frac{65}{4} \\\\\n&=\\left(y-\\frac{7}{2}\\right)^2-\\frac{49}{4}+\\frac{65}{4} \\\\\n&=\\left(y-\\frac{7}{2}\\right)^2+4.\n\\end{aligned}\n$$\n\nThe minus sign inside the square produces the required linear term $-7y$.\n\nThe blanks are $\\frac{7}{2}$ and $4$; the sign before the second blank is already supplied."}] [{:db/id #edb/ref 17592186705130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6fdb839-5235-5549-88bc-4c4bdad8a981" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186705129}] :answer-field/correct {:answer/id #uuid "e6fdb839-5235-5549-88bc-4c4bdad8a981" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186705129} :answer-field/id #uuid "66430221-a943-5298-8f05-5c12826733d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186705117} {:answer-field/choices [{:answer/id #uuid "6ef03400-1596-52a9-a3f5-1cb9ed63e03f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186705118}] :answer-field/correct {:answer/id #uuid "6ef03400-1596-52a9-a3f5-1cb9ed63e03f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186705118} :answer-field/id #uuid "8ac4338f-5491-547a-ae07-e90e02f12ab0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186705121}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f1b669b8-a9a6-5c51-8d91-0c785f54ef15" :question/problem "Complete the square on $y^2-7y+\\frac{61}{4}$.\n\nFill in the nonnegative numbers.\n\n$y^2-7y+\\frac{61}{4}=(y-$ {{field-1}} $)^2+$ {{field-2}}" :question/worked-solution "The half of the linear coefficient is $-\\frac{7}{2}$. **Add and subtract** its square so the expression keeps its value.\n\n$$\n\\begin{aligned}\ny^2-7y+\\frac{61}{4}&=\\underbrace{y^2-2\\cdot \\frac{7}{2}y+\\frac{49}{4}}_{\\text{perfect square}}-\\frac{49}{4}+\\frac{61}{4} \\\\\n&=\\left(y-\\frac{7}{2}\\right)^2-\\frac{49}{4}+\\frac{61}{4} \\\\\n&=\\left(y-\\frac{7}{2}\\right)^2+3.\n\\end{aligned}\n$$\n\nThe minus sign inside the square produces the required linear term $-7y$.\n\nThe blanks are $\\frac{7}{2}$ and $3$; the sign before the second blank is already supplied."}]}
