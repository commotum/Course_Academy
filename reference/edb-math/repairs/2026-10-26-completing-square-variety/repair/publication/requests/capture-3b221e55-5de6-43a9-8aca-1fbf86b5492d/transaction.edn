eady supplied."] [:db/add "04fc8170-4c79-5292-bb24-79a0f57d7f70" :question/difficulty :question.difficulty/moderate] [:db/add "04fc8170-4c79-5292-bb24-79a0f57d7f70" :question/answer-fields "ba3f1d7f-3fbe-50c1-80b7-4b3a19786bda"] [:db/add "04fc8170-4c79-5292-bb24-79a0f57d7f70" :question/answer-fields "32878bdc-cd1b-5235-8bbc-9dc110e289a4"] [:db/ensure "04fc8170-4c79-5292-bb24-79a0f57d7f70" :question/validate] [:db/add 17592186184170 :knowledge-point/questions "04fc8170-4c79-5292-bb24-79a0f57d7f70"] [:db/add "84726613-565a-52e5-8629-298e1a97af25" :answer/id #uuid "84726613-565a-52e5-8629-298e1a97af25"] [:db/add "84726613-565a-52e5-8629-298e1a97af25" :answer/type :answer.type/math] [:db/add "84726613-565a-52e5-8629-298e1a97af25" :answer/value "\\frac{15}{2}"] [:db/ensure "84726613-565a-52e5-8629-298e1a97af25" :answer/validate] [:db/add "6513ed65-ec97-5efd-a2bb-b21569becdcc" :answer-field/id #uuid "6513ed65-ec97-5efd-a2bb-b21569becdcc"] [:db/add "6513ed65-ec97-5efd-a2bb-b21569becdcc" :answer-field/key "field-1"] [:db/add "6513ed65-ec97-5efd-a2bb-b21569becdcc" :answer-field/type :answer-field.type/blank] [:db/add "6513ed65-ec97-5efd-a2bb-b21569becdcc" :answer-field/choices "84726613-565a-52e5-8629-298e1a97af25"] [:db/add "6513ed65-ec97-5efd-a2bb-b21569becdcc" :answer-field/correct "84726613-565a-52e5-8629-298e1a97af25"] [:db/ensure "6513ed65-ec97-5efd-a2bb-b21569becdcc" :answer-field/validate] [:db/add "3879403b-57f9-585d-997f-439e6c582dbe" :answer/id #uuid "3879403b-57f9-585d-997f-439e6c582dbe"] [:db/add "3879403b-57f9-585d-997f-439e6c582dbe" :answer/type :answer.type/math] [:db/add "3879403b-57f9-585d-997f-439e6c582dbe" :answer/value "2"] [:db/ensure "3879403b-57f9-585d-997f-439e6c582dbe" :answer/validate] [:db/add "d4584dfd-90bd-53f8-aafd-12f821da179c" :answer-field/id #uuid "d4584dfd-90bd-53f8-aafd-12f821da179c"] [:db/add "d4584dfd-90bd-53f8-aafd-12f821da179c" :answer-field/key "field-2"] [:db/add "d4584dfd-90bd-53f8-aafd-12f821da179c" :answer-field/type :answer-fiel