      ":question/id": "b7307067-8a74-53a5-8266-8ae8db3b34c1",
      ":question/difficulty": ":question.difficulty/hard",
      ":question/problem": "Rewrite $7-5x+x^2$ in the form $(x+a)^2+b$. Find the signed numbers $a$ and $b$.\n\n$a=$ {{field-1}}\n\n$b=$ {{field-2}}",
