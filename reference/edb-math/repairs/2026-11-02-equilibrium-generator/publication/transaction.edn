d5b0-78a1-56f1-adfd-b79a8730cc49"] [:db/add "6ccad5b0-78a1-56f1-adfd-b79a8730cc49" :answer-field/key "$y=3$"] [:db/add "6ccad5b0-78a1-56f1-adfd-b79a8730cc49" :answer-field/type :answer-field.type/checkbox] [:db/add "6ccad5b0-78a1-56f1-adfd-b79a8730cc49" :answer-field/choices "db194aa7-909d-53b6-9439-1306a8957f30"] [:db/add "6ccad5b0-78a1-56f1-adfd-b79a8730cc49" :answer-field/choices "8764b9cc-6915-5233-8715-9eaeb6628a5b"] [:db/add "6ccad5b0-78a1-56f1-adfd-b79a8730cc49" :answer-field/correct "db194aa7-909d-53b6-9439-1306a8957f30"] [:db/ensure "6ccad5b0-78a1-56f1-adfd-b79a8730cc49" :answer-field/validate] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/id #uuid "b73355af-8562-58ac-92ab-a09e083ca7d0"] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/problem "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt}= \\\\ \\frac{y^{3} - y^{2} - 6 y}{y - 3}\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nFirst keep the original domain: $y - 3\\ne0$.\n\nTest whether $f(c)=0$, where\n\n$$\n\\begin{gathered}f(c)= \\\\ \\frac{c^{3} - c^{2} - 6 c}{c - 3}\\end{gathered}\n$$\n\n- For $c=-3$:\n\n$$\n\\begin{aligned}f(-3) &=3\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=0$:\n\n$$\n\\begin{aligned}f(0) &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=-2$:\n\n$$\n\\begin{aligned}f(-2) &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=3$, $c - 3=0$ violates the original domain, so it is not an equilibrium solution.\n\nSelect $y=0$ and $y=-2$."] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/difficulty :question.difficulty/hard] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/answer-fields "83a60b17-c8d9-5ae3-8b29-42dfd3061910"] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/answer-fields "906052da-d6f9-5bc8-b602-f5263b40a0a6"] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/answer-fields "880539eb-c7c3-5d4a-958b-a3f8407f4262"] [:db/add "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/answer-fields "6ccad5b0-78a1-56f1-adfd-b79a8730cc49"] [:db/ensure "b73355af-8562-58ac-92ab-a09e083ca7d0" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "b73355af-8562-58ac-92ab-a09e083ca7d0"] [:db/add "generator" :question-generator/id #uuid "ac3f4ddf-e1ea-578a-85d0-b59d3a1b9f79"] [:db/add "generator" :question-generator/script "generators/4f/4fd06a5b0cf48eeed6d10418e1b6cad209e39ef6a90fedc95a4468179725ac42/generator.py"] [:db/add 17592186166788 :knowledge-point/question-generator "generator"] [:db/ensure 17592186166788 :knowledge-point/validate] [:db/cas 17592186693815 :question/retired nil true] [:db/cas 17592186693821 :question/retired nil true] [:db/cas 17592186693830 :question/retired nil true] [:db/cas 17592186694166 :question/retired nil true] [:db/cas 17592186694194 :question/retired nil true] [:db/cas 17592186694197 :question/retired nil true] [:db/cas 17592186694208 :question/retired nil true] [:db/cas 17592186694216 :question/retired nil true] [:db/cas 17592186694227 :question/retired nil true] [:db/cas 17592186694244 :question/retired nil true] [:db/cas 17592186694256 :question/retired nil true] [:db/cas 17592186694258 :question/retired nil true] [:db/cas 17592186694284 :question/retired nil true] [:db/cas 17592186694294 :question/problem "Consider the differential equation\n\n$$\n\\frac{dy}{dt} + \\left(y + 1\\right) = \\left(y + 1\\right) + \\left(\\left(y - 1\\right)^{2} \\ln{\\left(y - 1 \\right)} + e^{-2}\\right).\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply." "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt}= \\\\ \\left(y - 1\\right)^{2} \\ln{\\left(y - 1 \\right)} \\\\ + e^{-2}\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/cas 17592186694294 :question/worked-solution "A constant function $y(t)=c$ has derivative $dy/dt=0$. It must satisfy the original equation and its domain restrictions.\n\nThe original equation requires $y - 1>0$.\n\nIsolating the derivative gives\n\n$$\n\\frac{dy}{dt} = y^{2} \\ln{\\left(y - 1 \\right)} - 2 y \\ln{\\left(y - 1 \\right)} + \\ln{\\left(y - 1 \\right)} + e^{-2}.\n$$\n\nTest each supplied constant in the original equation, with the derivative set to zero.\n\n- For $y=c=2$, evaluate the non-derivative left and right sides, denoted $L(c)$ and $R(c)$:\n\n$$\n\\begin{aligned}\\ln{\\left(c - 1 \\right)} &= \\ln{\\left(1 \\right)} \\\\  &= 0 \\\\ L(c) &= c + 1 \\\\  &= 3 \\\\ R(c) &= \\left(c + 1\\right) + \\left(\\left(c - 1\\right)^{2} \\ln{\\left(c - 1 \\right)} + e^{-2}\\right) \\\\  &= e^{-2} + 3\\end{aligned}\n$$\n\nThe values differ, so this is *not* an equilibrium solution.\n\n- For $y=c=1 + e$, evaluate the non-derivative left and right sides, denoted $L(c)$ and $R(c)$:\n\n$$\n\\begin{aligned}\\ln{\\left(c - 1 \\right)} &= \\ln{\\left(e \\right)} \\\\  &= 1 \\\\ L(c) &= c + 1 \\\\  &= 2 + e \\\\ R(c) &= \\left(c + 1\\right) + \\left(\\left(c - 1\\right)^{2} \\ln{\\left(c - 1 \\right)} + e^{-2}\\right) \\\\  &= e^{-2} + 2 + e + e^{2}\\end{aligned}\n$$\n\nThe values differ, so this is *not* an equilibrium solution.\n\n- For $y=c=e^{-1} + 1$, evaluate the non-derivative left and right sides, denoted $L(c)$ and $R(c)$:\n\n$$\n\\begin{aligned}\\ln{\\left(c - 1 \\right)} &= \\ln{\\left(e^{-1} \\right)} \\\\  &= -1 \\\\ L(c) &= c + 1 \\\\  &= e^{-1} + 2 \\\\ R(c) &= \\left(c + 1\\right) + \\left(\\left(c - 1\\right)^{2} \\ln{\\left(c - 1 \\right)} + e^{-2}\\right) \\\\  &= e^{-1} + 2\\end{aligned}\n$$\n\nThe values agree, so this is an equilibrium solution.\n\nSelect $y=e^{-1} + 1$." "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nFirst keep the original domain: $y - 1>0$.\n\nTest whether $f(c)=0$, where\n\n$$\n\\begin{gathered}f(c)= \\\\ \\left(c - 1\\right)^{2} \\ln{\\left(c - 1 \\right)} \\\\ + e^{-2}\\end{gathered}\n$$\n\n- For $c=1 + e$: Use $\\ln{\\left(e \\right)}=1$.\n\n$$\n\\begin{gathered}f(1 + e)= \\\\ e^{-2} + e^{2} \\ln{\\left(e \\right)} \\\\ =e^{-2} + e^{2}\\end{gathered}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=2$: Use $\\ln{\\left(1 \\right)}=0$.\n\n$$\n\\begin{aligned}f(2) &=1 \\ln{\\left(1 \\right)} + e^{-2} \\\\ &=e^{-2}\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=e^{-1} + 1$: Use $\\ln{\\left(e^{-1} \\right)}=-1$.\n\n$$\n\\begin{gathered}f(e^{-1} + 1)= \\\\ \\frac{\\ln{\\left(e^{-1} \\right)}}{e^{2}} + e^{-2} \\\\ =0\\end{gathered}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\nSelect $y=e^{-1} + 1$."] [:db/ensure 17592186694294 :question/validate]]
