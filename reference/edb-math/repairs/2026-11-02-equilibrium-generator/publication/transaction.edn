99c9-20f14836b61a"] [:db/add "9d79f37b-975e-5724-99c9-20f14836b61a" :question/problem "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt}= \\\\ \\left(y - e + 1\\right) \\ln{\\left(y + 1 \\right)}\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "9d79f37b-975e-5724-99c9-20f14836b61a" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nFirst keep the original domain: $y + 1>0$.\n\nTest whether $f(c)=0$, where\n\n$$\n\\begin{gathered}f(c)= \\\\ \\left(c - e + 1\\right) \\ln{\\left(c + 1 \\right)}\\end{gathered}\n$$\n\n- For $c=1$:\n\n$$\n\\begin{gathered}f(1)= \\\\ \\left(- e + 2\\right) \\ln{\\left(2 \\right)}\\end{gathered}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=0$: Use $\\ln{\\left(1 \\right)}=0$.\n\n$$\n\\begin{gathered}f(0)= \\\\ \\left(- e + 1\\right) \\ln{\\left(1 \\right)} \\\\ =0\\end{gathered}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=2$:\n\n$$\n\\begin{gathered}f(2)= \\\\ \\left(- e + 3\\right) \\ln{\\left(3 \\right)}\\end{gathered}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=-1$, $c + 1=0$ violates the original domain, so it is not an equilibrium solution.\n\nSelect $y=0$."] [:db/add "9d79f37b-975e-5724-99c9-20f14836b61a" :question/difficulty :question.difficulty/hard] [:db/add "9d79f37b-975e-5724-99c9-20f14836b61a" :question/answer-fields "87d79efe-91d0-534e-91c1-8043cd24e582"] [:db/add "9d79f37b-975e-5724-99c9-20f14836b61a" :question/answer-fields "2e91bc7f-b59e-5b7c-ab36-bce2bc50de97"] [:db/add "9d79f37b-975e-5724-99c9-20f14836b61a" :question/answer-fields "52626f0d-d2b4-5e82-acdb-252678530395"] [:db/add "9d79f37b-975e-5724-99c9-20f14836b61a" :question/answer-fields "6dba8363-8c29-5ed2-bee4-2c556419ae0c"] [:db/ensure "9d79f37b-975e-5724-99c9-20f14836b61a" :question/validate] [:db/add 17592186166788 :knowledge-point