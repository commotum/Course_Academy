wer/type :answer.type/text] [:db/add "2ebba819-e4f4-5699-ab33-7f935ae42895" :answer/value "false"] [:db/ensure "2ebba819-e4f4-5699-ab33-7f935ae42895" :answer/validate] [:db/add "8f8a97ed-cfb4-58b3-bc43-9b12e65f5b59" :answer/id #uuid "8f8a97ed-cfb4-58b3-bc43-9b12e65f5b59"] [:db/add "8f8a97ed-cfb4-58b3-bc43-9b12e65f5b59" :answer/type :answer.type/text] [:db/add "8f8a97ed-cfb4-58b3-bc43-9b12e65f5b59" :answer/value "true"] [:db/ensure "8f8a97ed-cfb4-58b3-bc43-9b12e65f5b59" :answer/validate] [:db/add "ac7385ce-1b28-5bbf-ab42-ced554fc35ce" :answer-field/id #uuid "ac7385ce-1b28-5bbf-ab42-ced554fc35ce"] [:db/add "ac7385ce-1b28-5bbf-ab42-ced554fc35ce" :answer-field/key "$y=1$"] [:db/add "ac7385ce-1b28-5bbf-ab42-ced554fc35ce" :answer-field/type :answer-field.type/checkbox] [:db/add "ac7385ce-1b28-5bbf-ab42-ced554fc35ce" :answer-field/choices "2ebba819-e4f4-5699-ab33-7f935ae42895"] [:db/add "ac7385ce-1b28-5bbf-ab42-ced554fc35ce" :answer-field/choices "8f8a97ed-cfb4-58b3-bc43-9b12e65f5b59"] [:db/add "ac7385ce-1b28-5bbf-ab42-ced554fc35ce" :answer-field/correct "2ebba819-e4f4-5699-ab33-7f935ae42895"] [:db/ensure "ac7385ce-1b28-5bbf-ab42-ced554fc35ce" :answer-field/validate] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/id #uuid "d2788ace-5247-5c8a-b2be-3ee65d5917cb"] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/problem "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt}= \\\\ \\frac{y^{2} - 5 y + 6}{y - 1}\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nFirst keep the original domain: $y - 1\\ne0$.\n\nTest whether $f(c)=0$, where\n\n$$\nf(c) = \\frac{c^{2} - 5 c + 6}{c - 1}\n$$\n\n- For $c=-3$:\n\n$$\n\\begin{aligned}f(-3) &=- \\frac{15}{2}\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=2$:\n\n$$\n\\begin{aligned}f(2) &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=3$:\n\n$$\n\\begin{aligned}f(3) &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=1$, $c - 1=0$ violates the original domain, so it is not an equilibrium solution.\n\nSelect $y=2$ and $y=3$."] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/difficulty :question.difficulty/hard] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/answer-fields "770be70e-b2d2-5356-975a-3ee2ef877647"] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/answer-fields "f896c107-db1c-5bdd-89a2-17a563378d2d"] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/answer-fields "45093cc0-8745-5465-be48-1681b671e3ba"] [:db/add "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/answer-fields "ac7385ce-1b28-5bbf-ab42-ced554fc35ce"] [:db/ensure "d2788ace-5247-5c8a-b2be-3ee65d5917cb" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "d2788ace-5247-5c8a-b2be-3ee65d5917cb"] [:db/add "af846840-c3b5-53ab-8081-87a442aab2ef" :answer/id #uuid "af846840-c3b5-53ab-8081-87a442aab2ef"] [:db/add "af846840-c3b5-53ab-8081-87a442aab2ef" :answer/type :answer.type/text] [:db/add "af846840-c3b5-53ab-8081-87a442aab2ef" :answer/value "false"] [:db/ensure "af846840-c3b5-53ab-8081-87a442aab2ef" :answer/validate] [:db/add "c9bd1940-f30f-5c6c-9547-a8915c68176c" :answer/id #uuid "c9bd1940-f30f-5c6c-9547-a8915c68176c"] [:db/add "c9bd1940-f30f-5c6c-9547-a8915c68176c" :answer/type :answer.type/text] [:db/add "c9bd1940-f30f-5c6c-9547-a8915c68176c" :answer/value "true"] [:db/ensure "c9bd1940-f30f-5c6c-9547-a8915c68176c" :answer/validate] [:db/add "a5313d1a-4bc2-52ea-b863-a0a21558cfed" :answer-field/id #uuid "a5313d1a-4bc2-52ea-b863-a0a21558cfed"] [:db/add "a5313d1a-4bc2-52ea-b863-a0a21558cfed" :answer-field/key "$y=-3$"] [:db/add "a5313d1a-4bc2-52ea-b863-a0a21558cfed" :answer-field/type :answer-field.type/checkbox] [:db