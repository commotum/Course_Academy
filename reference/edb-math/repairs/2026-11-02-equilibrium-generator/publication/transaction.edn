/id #uuid "8e2ec4da-4630-509d-a362-8531b08e089c"] [:db/add "8e2ec4da-4630-509d-a362-8531b08e089c" :answer/type :answer.type/text] [:db/add "8e2ec4da-4630-509d-a362-8531b08e089c" :answer/value "false"] [:db/ensure "8e2ec4da-4630-509d-a362-8531b08e089c" :answer/validate] [:db/add "4f66d9cb-592b-5f1e-8a2e-d89adb067962" :answer/id #uuid "4f66d9cb-592b-5f1e-8a2e-d89adb067962"] [:db/add "4f66d9cb-592b-5f1e-8a2e-d89adb067962" :answer/type :answer.type/text] [:db/add "4f66d9cb-592b-5f1e-8a2e-d89adb067962" :answer/value "true"] [:db/ensure "4f66d9cb-592b-5f1e-8a2e-d89adb067962" :answer/validate] [:db/add "806e85c3-856b-553e-84c9-7e7a24fe9bbb" :answer-field/id #uuid "806e85c3-856b-553e-84c9-7e7a24fe9bbb"] [:db/add "806e85c3-856b-553e-84c9-7e7a24fe9bbb" :answer-field/key "$y=1$"] [:db/add "806e85c3-856b-553e-84c9-7e7a24fe9bbb" :answer-field/type :answer-field.type/checkbox] [:db/add "806e85c3-856b-553e-84c9-7e7a24fe9bbb" :answer-field/choices "8e2ec4da-4630-509d-a362-8531b08e089c"] [:db/add "806e85c3-856b-553e-84c9-7e7a24fe9bbb" :answer-field/choices "4f66d9cb-592b-5f1e-8a2e-d89adb067962"] [:db/add "806e85c3-856b-553e-84c9-7e7a24fe9bbb" :answer-field/correct "8e2ec4da-4630-509d-a362-8531b08e089c"] [:db/ensure "806e85c3-856b-553e-84c9-7e7a24fe9bbb" :answer-field/validate] [:db/add "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/id #uuid "c72d8feb-f5dd-59f4-b471-e2054392ae9f"] [:db/add "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/problem "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt}= \\\\ y^{2} \\ln{\\left(y \\right)} - e^{2}\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nFirst keep the original domain: $y>0$.\n\nTest whether $f(c)=0$, where\n\n$$\n\\begin{gathered}f(c)= \\\\ c^{2} \\ln{\\left(c \\right)} - e^{2}\\end{gathered}\n$$\n\n- For $c=e$: Use $\\ln{\\left(e \\right)}=1$.\n\n$$\n\\begin{gathered}f(e)= \\\\ - e^{2} + e^{2} \\ln{\\left(e \\right)} \\\\ =0\\end{gathered}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=2$:\n\n$$\n\\begin{aligned}f(2) &=- e^{2} + 4 \\ln{\\left(2 \\right)}\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=1$: Use $\\ln{\\left(1 \\right)}=0$.\n\n$$\n\\begin{aligned}f(1) &=- e^{2} + 1 \\ln{\\left(1 \\right)} \\\\ &=- e^{2}\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\nSelect $y=e$."] [:db/add "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/difficulty :question.difficulty/easy] [:db/add "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/answer-fields "2b1dc939-0f88-5dc6-bd14-6fa82a81c7a4"] [:db/add "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/answer-fields "d003e6c1-9966-5209-b39d-82ebb46979c5"] [:db/add "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/answer-fields "806e85c3-856b-553e-84c9-7e7a24fe9bbb"] [:db/ensure "c72d8feb-f5dd-59f4-b471-e2054392ae9f" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "c72d8feb-f5dd-59f4-b471-e2054392ae9f"] [:db/add "7c2b5dc0-6cfe-5c58-ba36-feab6cfc1f6c" :answer/id #uuid "7c2b5dc0-6cfe-5c58-ba36-feab6cfc1f6c"] [:db/add "7c2b5dc0-6cfe-5c58-ba36-feab6cfc1f6c" :answer/type :answer.type/text] [:db/add "7c2b5dc0-6cfe-5c58-ba36-feab6cfc1f6c" :answer/value "false"] [:db/ensure "7c2b5dc0-6cfe-5c58-ba36-feab6cfc1f6c" :answer/validate] [:db/add "4a5b15a9-3fe3-58bd-9873-09d0cdf5d109" :answer/id #uuid "4a5b15a9-3fe3-58bd-9873-09d0cdf5d109"] [:db/add "4a5b15a9-3fe3-58bd-9873-09d0cdf5d109" :answer/type :answer.type/text] [:db/add "4a5b15a9-3fe3-58bd-9873-09d0cdf5d109" :answer/value "true"] [:db/ensure "4a5b15a9-3fe3-58bd-9873-09d0cdf5d109" :answer/validate] [:db/add "e25f8ead-959d-5c0b-8319-34974ee49996" :answer-field/id #uuid "e25f8ead-959d-5c0b-8319-34974ee49996"] [:db/add "e25f8ead-959d-5c0b-8319-34974ee49996" :answer