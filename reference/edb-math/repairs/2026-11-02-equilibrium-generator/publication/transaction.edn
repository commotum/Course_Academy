03d-2bf0-5408-ac9b-30da9c391361"] [:db/add "2cf7172d-3765-5c7e-924d-bb0ea9356bb5" :answer-field/correct "842fe03d-2bf0-5408-ac9b-30da9c391361"] [:db/ensure "2cf7172d-3765-5c7e-924d-bb0ea9356bb5" :answer-field/validate] [:db/add "8b528cf2-db44-5164-a8ce-4d256d541071" :question/id #uuid "8b528cf2-db44-5164-a8ce-4d256d541071"] [:db/add "8b528cf2-db44-5164-a8ce-4d256d541071" :question/problem "Consider the differential equation\n\n$$\n\\frac{dy}{dt} + 4 y = - 2 y^{2}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "8b528cf2-db44-5164-a8ce-4d256d541071" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nRearranging once, test whether $f(c)=0$, where\n\n$$\nf(c) = - 2 c^{2} - 4 c\n$$\n\n- For $c=-2$:\n\n$$\n\\begin{aligned}f(-2) &=-8 + 8 \\\\ &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=1$:\n\n$$\n\\begin{aligned}f(1) &=-4 - 2 \\\\ &=-6\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=0$:\n\n$$\n\\begin{aligned}f(0) &=0 + 0 \\\\ &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\nSelect $y=-2$ and $y=0$."] [:db/add "8b528cf2-db44-5164-a8ce-4d256d541071" :question/difficulty :question.difficulty/moderate] [:db/add "8b528cf2-db44-5164-a8ce-4d256d541071" :question/answer-fields "f250119f-3e90-51e7-b516-d3abb3cac046"] [:db/add "8b528cf2-db44-5164-a8ce-4d256d541071" :question/answer-fields "ac6e1afa-f3ac-532a-9e4d-e54edb64d9d0"] [:db/add "8b528cf2-db44-5164-a8ce-4d256d541071" :question/answer-fields "2cf7172d-3765-5c7e-924d-bb0ea9356bb5"] [:db/ensure "8b528cf2-db44-5164-a8ce-4d256d541071" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "8b528cf2-db44-5164-a8ce-4d256d541071"] [:db/add "23b47a0c-1cbe-585b-84bc-1e074ef49f53" :answer/id #uuid "23b47a0c-1cbe-585b-84bc-1e074ef49f53"] [:db/add "23b47a0c-1cbe-585b-84bc-1e074ef49f53" :answer/type 