203a3e4c3df"] [:db/add "f237acb7-6045-560e-8466-8203a3e4c3df" :answer-field/key "$y=1 + \\frac{\\pi}{2}$"] [:db/add "f237acb7-6045-560e-8466-8203a3e4c3df" :answer-field/type :answer-field.type/checkbox] [:db/add "f237acb7-6045-560e-8466-8203a3e4c3df" :answer-field/choices "ca5ef06f-1ba9-507a-b957-67c58106344f"] [:db/add "f237acb7-6045-560e-8466-8203a3e4c3df" :answer-field/choices "c8b02b61-d28d-5e14-90f5-a81a0e65b583"] [:db/add "f237acb7-6045-560e-8466-8203a3e4c3df" :answer-field/correct "ca5ef06f-1ba9-507a-b957-67c58106344f"] [:db/ensure "f237acb7-6045-560e-8466-8203a3e4c3df" :answer-field/validate] [:db/add "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/id #uuid "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885"] [:db/add "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/problem "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt}= \\\\ 2 \\sin{\\left(y - 1 \\right)}\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nTest whether $f(c)=0$, where\n\n$$\nf(c) = 2 \\sin{\\left(c - 1 \\right)}\n$$\n\n- For $c=- \\frac{\\pi}{2} + 1$: Use $\\sin{\\left(- \\frac{\\pi}{2} \\right)}=-1$.\n\n$$\n\\begin{gathered}f(- \\frac{\\pi}{2} + 1)= \\\\ 2 \\sin{\\left(- \\frac{\\pi}{2} \\right)} \\\\ =-2\\end{gathered}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=1$: Use $\\sin{\\left(0 \\right)}=0$.\n\n$$\n\\begin{aligned}f(1) &=2 \\sin{\\left(0 \\right)} \\\\ &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=1 + \\frac{\\pi}{2}$: Use $\\sin{\\left(\\frac{\\pi}{2} \\right)}=1$.\n\n$$\n\\begin{gathered}f(1 + \\frac{\\pi}{2})= \\\\ 2 \\sin{\\left(\\frac{\\pi}{2} \\right)} \\\\ =2\\end{gathered}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\nSelect $y=1$."] [:db/add "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/difficulty :question.difficulty/moderate] [:db/add "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/answer-fields "cca55b19-2945-5c4e-86b5-a4d3e0c66208"] [:db/add "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/answer-fields "fed39b0d-a6e9-5537-920a-d6dbe1ac1915"] [:db/add "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/answer-fields "f237acb7-6045-560e-8466-8203a3e4c3df"] [:db/ensure "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "86972ed0-fdb5-5c6a-a3da-dc7cbd5ab885"] [:db/add "c8fbf5f0-6601-567e-b4a4-a12aa8dcb7cf" :answer/id #uuid "c8fbf5f0-6601-567e-b4a4-a12aa8dcb7cf"] [:db/add "c8fbf5f0-6601-567e-b4a4-a12aa8dcb7cf" :answer/type :answer.type/text] [:db/add "c8fbf5f0-6601-567e-b4a4-a12aa8dcb7cf" :answer/value "false"] [:db/ensure "c8fbf5f0-6601-567e-b4a4-a12aa8dcb7cf" :answer/validate] [:db/add "54e27c5c-6fbd-5b53-977e-7a3f137734c3" :answer/id #uuid "54e27c5c-6fbd-5b53-977e-7a3f137734c3"] [:db/add "54e27c5c-6fbd-5b53-977e-7a3f137734c3" :answer/type :answer.type/text] [:db/add "54e27c5c-6fbd-5b53-977e-7a3f137734c3" :answer/value "true"] [:db/ensure "54e27c5c-6fbd-5b53-977e-7a3f137734c3" :answer/validate] [:db/add "72418077-679e-5a1d-bd03-b0093496599c" :answer-field/id #uuid "72418077-679e-5a1d-bd03-b0093496599c"] [:db/add "72418077-679e-5a1d-bd03-b0093496599c" :answer-field/key "$y=2$"] [:db/add "72418077-679e-5a1d-bd03-b0093496599c" :answer-field/type :answer-field.type/checkbox] [:db/add "72418077-679e-5a1d-bd03-b0093496599c" :answer-field/choices "c8fbf5f0-6601-567e-b4a4-a12aa8dcb7cf"] [:db/add "72418077-679e-5a1d-bd03-b0093496599c" :answer-field/choices "54e27c5c-6fbd-5b53-977e-7a3f137734c3"] [:db/add "72418077-679e-5a1d-bd03-b0093496599c" :answer-field/correct "c8fbf5f0-6601-567e-b4a4-a12aa8dcb7cf"] [:db/ensure "72418077-679e-5a1d-bd03-b0093496599c" :answer-field/validate] [:db/add "ab8b94d3-e886-5c36-905c-593be9af371b" :answer/id #uuid "ab8b94d3-e886-5c36-905c