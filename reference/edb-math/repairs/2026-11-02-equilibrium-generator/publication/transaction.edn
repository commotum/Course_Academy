515f0"] [:db/add "cb0e56df-fa8d-5a25-bce8-c3e5fb3515f0" :answer-field/key "$y=0$"] [:db/add "cb0e56df-fa8d-5a25-bce8-c3e5fb3515f0" :answer-field/type :answer-field.type/checkbox] [:db/add "cb0e56df-fa8d-5a25-bce8-c3e5fb3515f0" :answer-field/choices "a488546a-8e6d-53a5-b90f-557bead28c17"] [:db/add "cb0e56df-fa8d-5a25-bce8-c3e5fb3515f0" :answer-field/choices "eb0a5ab9-f798-573c-98cd-eb44e827d1c2"] [:db/add "cb0e56df-fa8d-5a25-bce8-c3e5fb3515f0" :answer-field/correct "a488546a-8e6d-53a5-b90f-557bead28c17"] [:db/ensure "cb0e56df-fa8d-5a25-bce8-c3e5fb3515f0" :answer-field/validate] [:db/add "4db980ed-67fb-5185-9224-78c8f7859f26" :question/id #uuid "4db980ed-67fb-5185-9224-78c8f7859f26"] [:db/add "4db980ed-67fb-5185-9224-78c8f7859f26" :question/problem "Consider the differential equation\n\n$$\n\\frac{dy}{dt} -2 = y^{3} - y^{2}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "4db980ed-67fb-5185-9224-78c8f7859f26" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nRearranging once, test whether $f(c)=0$, where\n\n$$\nf(c) = c^{3} - c^{2} + 2\n$$\n\n- For $c=2$:\n\n$$\n\\begin{aligned}f(2) &=-4 + 2 + 8 \\\\ &=6\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=-1$:\n\n$$\n\\begin{aligned}f(-1) &=-1 - 1 + 2 \\\\ &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=0$:\n\n$$\n\\begin{aligned}f(0) &=0 + 0 + 2 \\\\ &=2\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\nSelect $y=-1$."] [:db/add "4db980ed-67fb-5185-9224-78c8f7859f26" :question/difficulty :question.difficulty/moderate] [:db/add "4db980ed-67fb-5185-9224-78c8f7859f26" :question/answer-fields "72418077-679e-5a1d-bd03-b0093496599c"] [:db/add "4db980ed-67fb-5185-9224-78c8f7859f26" :question/answer-fields "669e614d-b7e5-59d8-9a23-d2d2fba2e766"] [:db/add "4db980ed-67fb-5185-9224-78c8f7859f26" :question/answer