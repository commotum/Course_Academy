a-5525-a02a-13f76c4b885f" :answer/value "true"] [:db/ensure "197ca168-676a-5525-a02a-13f76c4b885f" :answer/validate] [:db/add "d0442f58-b962-5d75-b82b-60f2800b1fd0" :answer-field/id #uuid "d0442f58-b962-5d75-b82b-60f2800b1fd0"] [:db/add "d0442f58-b962-5d75-b82b-60f2800b1fd0" :answer-field/key "$y=-3$"] [:db/add "d0442f58-b962-5d75-b82b-60f2800b1fd0" :answer-field/type :answer-field.type/checkbox] [:db/add "d0442f58-b962-5d75-b82b-60f2800b1fd0" :answer-field/choices "1aaa5d37-1745-5577-9a6c-741cabb18431"] [:db/add "d0442f58-b962-5d75-b82b-60f2800b1fd0" :answer-field/choices "197ca168-676a-5525-a02a-13f76c4b885f"] [:db/add "d0442f58-b962-5d75-b82b-60f2800b1fd0" :answer-field/correct "1aaa5d37-1745-5577-9a6c-741cabb18431"] [:db/ensure "d0442f58-b962-5d75-b82b-60f2800b1fd0" :answer-field/validate] [:db/add "2290f49d-c263-51d2-8038-81eb1905aa45" :question/id #uuid "2290f49d-c263-51d2-8038-81eb1905aa45"] [:db/add "2290f49d-c263-51d2-8038-81eb1905aa45" :question/problem "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt} + \\frac{1}{\\left(y + 1\\right)^{2}}= \\\\ 1\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "2290f49d-c263-51d2-8038-81eb1905aa45" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nFirst keep the original domain: $y + 1\\ne0$.\n\nRearranging once, test whether $f(c)=0$, where\n\n$$\n\\begin{gathered}f(c)= \\\\ 1 - \\frac{1}{\\left(c + 1\\right)^{2}}\\end{gathered}\n$$\n\n- For $c=2$:\n\n$$\n\\begin{aligned}f(2) &=- \\frac{1}{9} + 1 \\\\ &=\\frac{8}{9}\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=-2$:\n\n$$\n\\begin{aligned}f(-2) &=-1 + 1 \\\\ &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=-3$:\n\n$$\n\\begin{aligned}f(-3) &=- \\frac{1}{4} + 1 \\\\ &=\\frac{3}{4}\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\nSelect $y=-2$."] [:db/add "2290f49d-c263-51d2-8038-81eb1905aa45" :question/difficulty :question.difficulty/moderate] [:db/add "2290f49d-c263-51d2-8038-81eb1905aa45" :question/answer-fields "6243c08f-4ce5-5416-aad3-f0d841973528"] [:db/add "2290f49d-c263-51d2-8038-81eb1905aa45" :question/answer-fields "47e791f2-af5e-587f-9ee6-7e42b04c21c9"] [:db/add "2290f49d-c263-51d2-8038-81eb1905aa45" :question/answer-fields "d0442f58-b962-5d75-b82b-60f2800b1fd0"] [:db/ensure "2290f49d-c263-51d2-8038-81eb1905aa45" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "2290f49d-c263-51d2-8038-81eb1905aa45"] [:db/add "c951d591-36af-57de-955b-0943250e8f5f" :answer/id #uuid "c951d591-36af-57de-955b-0943250e8f5f"] [:db/add "c951d591-36af-57de-955b-0943250e8f5f" :answer/type :answer.type/text] [:db/add "c951d591-36af-57de-955b-0943250e8f5f" :answer/value "false"] [:db/ensure "c951d591-36af-57de-955b-0943250e8f5f" :answer/validate] [:db/add "0a15c633-1ac4-540c-9d98-1121a23b73a7" :answer/id #uuid "0a15c633-1ac4-540c-9d98-1121a23b73a7"] [:db/add "0a15c633-1ac4-540c-9d98-1121a23b73a7" :answer/type :answer.type/text] [:db/add "0a15c633-1ac4-540c-9d98-1121a23b73a7" :answer/value "true"] [:db/ensure "0a15c633-1ac4-540c-9d98-1121a23b73a7" :answer/validate] [:db/add "71bb6d1c-8a90-5844-98d7-dc1c089860e5" :answer-field/id #uuid "71bb6d1c-8a90-5844-98d7-dc1c089860e5"] [:db/add "71bb6d1c-8a90-5844-98d7-dc1c089860e5" :answer-field/key "$y=1$"] [:db/add "71bb6d1c-8a90-5844-98d7-dc1c089860e5" :answer-field/type :answer-field.type/checkbox] [:db/add "71bb6d1c-8a90-5844-98d7-dc1c089860e5" :answer-field/choices "c951d591-36af-57de-955b-0943250e8f5f"] [:db/add "71bb6d1c-8a90-5844-98d7-dc1c089860e5" :answer-field/choices "0a15c633-1ac4-540c-9d98-1121a23b73a7"] [:db/add "71bb6d1c-8a90-5844-98d7-dc1c089860e5" :answer-field/correct "c951d591-36af-57de-955b-0943250e8f5f"] [:db/ensure "71bb6d1c-8a90-5844-98d7-dc1c089860e5" :answer-field/validate] [:db/add "8aac168c-3e5e-581a-8