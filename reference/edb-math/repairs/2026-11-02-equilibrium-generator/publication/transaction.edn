validate] [:db/add "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/id #uuid "4c85940e-5d6a-5e77-8c03-607d21fd581c"] [:db/add "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/problem "Consider the differential equation\n\n$$\n\\begin{gathered}\\frac{dy}{dt}= \\\\ \\frac{y^{2} - 1}{y^{2}}\\end{gathered}\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nFirst keep the original domain: $y\\ne0$.\n\nTest whether $f(c)=0$, where\n\n$$\nf(c) = \\frac{c^{2} - 1}{c^{2}}\n$$\n\n- For $c=2$:\n\n$$\n\\begin{aligned}f(2) &=\\frac{3}{4}\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=1$:\n\n$$\n\\begin{aligned}f(1) &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=-1$:\n\n$$\n\\begin{aligned}f(-1) &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\nSelect $y=1$ and $y=-1$."] [:db/add "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/difficulty :question.difficulty/easy] [:db/add "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/answer-fields "6213c2ab-4c93-579a-b779-d8a55ed55de9"] [:db/add "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/answer-fields "b47e5247-b584-597e-8399-dfdaf2dbfd34"] [:db/add "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/answer-fields "cac1764f-530e-52f9-93e4-fc05d44ce5a2"] [:db/ensure "4c85940e-5d6a-5e77-8c03-607d21fd581c" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "4c85940e-5d6a-5e77-8c03-607d21fd581c"] [:db/add "61c5b620-d8b4-5198-a45d-0f05ca710c68" :answer/id #uuid "61c5b620-d8b4-5198-a45d-0f05ca710c68"] [:db/add "61c5b620-d8b4-5198-a45d-0f05ca710c68" :answer/type :answer.type/text] [:db/add "61c5b620-d8b4-5198-a45d-0f05ca710c68" :answer/value "false"] [:db/ensure "61c5b620-d8b4-5198-a45d-0f05ca710c68" :answer/validate] [:db