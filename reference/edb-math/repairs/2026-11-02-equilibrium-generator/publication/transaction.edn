4f85d48b" :answer/type :answer.type/text] [:db/add "16124f30-0b52-55e1-8a25-43384f85d48b" :answer/value "false"] [:db/ensure "16124f30-0b52-55e1-8a25-43384f85d48b" :answer/validate] [:db/add "4d1ac8da-eb77-575e-855f-e69372ec73fb" :answer/id #uuid "4d1ac8da-eb77-575e-855f-e69372ec73fb"] [:db/add "4d1ac8da-eb77-575e-855f-e69372ec73fb" :answer/type :answer.type/text] [:db/add "4d1ac8da-eb77-575e-855f-e69372ec73fb" :answer/value "true"] [:db/ensure "4d1ac8da-eb77-575e-855f-e69372ec73fb" :answer/validate] [:db/add "377b8885-22b4-5248-a86b-8aca5515b22a" :answer-field/id #uuid "377b8885-22b4-5248-a86b-8aca5515b22a"] [:db/add "377b8885-22b4-5248-a86b-8aca5515b22a" :answer-field/key "$y=-2$"] [:db/add "377b8885-22b4-5248-a86b-8aca5515b22a" :answer-field/type :answer-field.type/checkbox] [:db/add "377b8885-22b4-5248-a86b-8aca5515b22a" :answer-field/choices "16124f30-0b52-55e1-8a25-43384f85d48b"] [:db/add "377b8885-22b4-5248-a86b-8aca5515b22a" :answer-field/choices "4d1ac8da-eb77-575e-855f-e69372ec73fb"] [:db/add "377b8885-22b4-5248-a86b-8aca5515b22a" :answer-field/correct "16124f30-0b52-55e1-8a25-43384f85d48b"] [:db/ensure "377b8885-22b4-5248-a86b-8aca5515b22a" :answer-field/validate] [:db/add "25ff952b-9e47-5f63-8fd0-219680477b42" :question/id #uuid "25ff952b-9e47-5f63-8fd0-219680477b42"] [:db/add "25ff952b-9e47-5f63-8fd0-219680477b42" :question/problem "Consider the differential equation\n\n$$\n\\frac{dy}{dt} = - y^{2} + y + 2\n$$\n\nWhich of the following are equilibrium solutions? Select all that apply."] [:db/add "25ff952b-9e47-5f63-8fd0-219680477b42" :question/worked-solution "An equilibrium is a constant function $y(t)=c$. Set $dy/dt=0$ and test the resulting equation.\n\nTest whether $f(c)=0$, where\n\n$$\nf(c) = - c^{2} + c + 2\n$$\n\n- For $c=2$:\n\n$$\n\\begin{aligned}f(2) &=-4 + 2 + 2 \\\\ &=0\\end{aligned}\n$$\n\nThis is zero, so it is an equilibrium solution.\n\n- For $c=0$:\n\n$$\n\\begin{aligned}f(0) &=0 + 0 + 2 \\\\ &=2\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\n- For $c=-2$:\n\n$$\n\\begin{aligned}f(-2) &=-4 - 2 + 2 \\\\ &=-4\\end{aligned}\n$$\n\nThis is nonzero, so it is not an equilibrium solution.\n\nSelect $y=2$."] [:db/add "25ff952b-9e47-5f63-8fd0-219680477b42" :question/difficulty :question.difficulty/easy] [:db/add "25ff952b-9e47-5f63-8fd0-219680477b42" :question/answer-fields "e25f8ead-959d-5c0b-8319-34974ee49996"] [:db/add "25ff952b-9e47-5f63-8fd0-219680477b42" :question/answer-fields "e9b09117-d11e-562e-b014-5574748edeab"] [:db/add "25ff952b-9e47-5f63-8fd0-219680477b42" :question/answer-fields "377b8885-22b4-5248-a86b-8aca5515b22a"] [:db/ensure "25ff952b-9e47-5f63-8fd0-219680477b42" :question/validate] [:db/add 17592186166788 :knowledge-point/questions "25ff952b-9e47-5f63-8fd0-219680477b42"] [:db/add "9bf2bea9-8e0a-5080-860f-19673902d0c2" :answer/id #uuid "9bf2bea9-8e0a-5080-860f-19673902d0c2"] [:db/add "9bf2bea9-8e0a-5080-860f-19673902d0c2" :answer/type :answer.type/text] [:db/add "9bf2bea9-8e0a-5080-860f-19673902d0c2" :answer/value "false"] [:db/ensure "9bf2bea9-8e0a-5080-860f-19673902d0c2" :answer/validate] [:db/add "900c878e-ac6c-5c6b-8e1d-e8e0527a2cbc" :answer/id #uuid "900c878e-ac6c-5c6b-8e1d-e8e0527a2cbc"] [:db/add "900c878e-ac6c-5c6b-8e1d-e8e0527a2cbc" :answer/type :answer.type/text] [:db/add "900c878e-ac6c-5c6b-8e1d-e8e0527a2cbc" :answer/value "true"] [:db/ensure "900c878e-ac6c-5c6b-8e1d-e8e0527a2cbc" :answer/validate] [:db/add "6243c08f-4ce5-5416-aad3-f0d841973528" :answer-field/id #uuid "6243c08f-4ce5-5416-aad3-f0d841973528"] [:db/add "6243c08f-4ce5-5416-aad3-f0d841973528" :answer-field/key "$y=2$"] [:db/add "6243c08f-4ce5-5416-aad3-f0d841973528" :answer-field/type :answer-field.type/checkbox] [:db/add "6243c08f-4ce5-5416-aad3-f0d841973528" :answer-field/choices "9bf2bea9-8e0a-5080-860f-19673902d0c2"] [:db/add "6243c08f-4ce5-5416-aad3-f0d841973528" :answer-field/choices "900c878e-ac6c-5c6b-8e1d-e8e0527a2cbc"] [:db/add "6243c08f-4ce5-5416-aad3-f0d841973528" :answe