#{[{:db/id #edb/ref 17592186048369 :topic/id #uuid "99e1fe28-92a1-545f-8ee9-b78506123551" :topic/knowledge-points [{:db/id #edb/ref 17592186068749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068582 :question/id #uuid "4968972d-3bc9-5100-aa70-46213e0c3581" :question/math-academy-id "e-5028" :question/problem "Is $x=3$ a root of the polynomial $2x^3+8x^2-2x-8?$" :question/worked-solution "Substituting $3$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}2(3)^3+8(3)^2-2(3)-8 &= 2(27)+8(9)-6-8 \\\\ &= 54+72-14 \\\\ &= 112\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $3$ is substituted for $x.$\n\nTherefore, $3$ is *not* a root."} :knowledge-point/id #uuid "2b680bd3-e1e3-5ff5-ade3-39977cbdaaf7" :knowledge-point/title "Identifying Values that are Roots of a Given Polynomial"} {:db/id #edb/ref 17592186068750 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068583 :question/id #uuid "c1830274-3260-5bf5-aef1-c855a89efbf2" :question/math-academy-id "e-5030" :question/problem "Find $p$ if $3$ is a root of $x^3-3x+p.$" :question/worked-solution "Since $x=3$ is a root, we have $f(3)=0.$ Therefore, we can evaluate the polynomial at $x=3,$ set it equal to $0,$ and solve the equation for the parameter $p\\mathbin{:}$\n\n$$\n\\begin{aligned}(3)^{3}-3(3)+p & =0 \\\\ 27-9+p & =0 \\\\ p & =-18\\end{aligned}\n$$"} :knowledge-point/id #uuid "9328cc9a-2e6c-5ac2-bae4-f02c86fe9d29" :knowledge-point/title "Solving for an Unknown Parameter Given the Root of a Polynomial"}] :topic/math-academy-id 469 :topic/next [{:db/id #edb/ref 17592186049242} {:db/id #edb/ref 17592186050364}] :topic/title "Determining the Roots of Polynomials"}]}
