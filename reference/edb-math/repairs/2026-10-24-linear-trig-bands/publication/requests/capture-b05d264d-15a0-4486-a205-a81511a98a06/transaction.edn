d21f-56ab-8142-6316dd5ce989" :question/worked-solution "Let $u=3 x - \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3,\\qquad \\mathrm{d}x=\\left(\\frac{1}{3}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{9}&\\quad\\Longrightarrow\\quad u=3\\left(\\frac{\\pi}{9}\\right)+\\left(- \\frac{\\pi}{3}\\right)=0\\\\ x=\\frac{2 \\pi}{9}&\\quad\\Longrightarrow\\quad u=3\\left(\\frac{2 \\pi}{9}\\right)+\\left(- \\frac{\\pi}{3}\\right)=\\frac{\\pi}{3}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{9}}^{\\frac{2 \\pi}{9}} 4\\sin\\left(3 x - \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=4\\left(\\frac{1}{3}\\right)\\int_{0}^{\\frac{\\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\int_{0}^{\\frac{\\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\left[-\\cos\\left(u\\right)\\right]_{0}^{\\frac{\\pi}{3}}\\\\ &=- \\frac{4}{3}\\left(\\cos\\left(\\frac{\\pi}{3}\\right)-\\cos\\left(0\\right)\\right)\\\\ &=- \\frac{4}{3}\\left(\\left(\\frac{1}{2}\\right)-\\left(1\\right)\\right)\\\\ &=\\frac{2}{3}.\\end{aligned}\n$$"] [:db/add "724e1a0a-d21f-56ab-8142-6316dd5ce989" :question/difficulty :question.difficulty/moderate] [:db/add "724e1a0a-d21f-56ab-8142-6316dd5ce989" :question/answer-fields "41860545-823e-524e-bc0d-b01a33d26aea"] [:db/ensure "724e1a0a-d21f-56ab-8142-6316dd5ce989" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "724e1a0a-d21f-56ab-8142-6316dd5ce989"] [:db/add "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/id #uuid "d3fcda61-dde0-56ba-aba9-3c128ff21e1d"] [:db/add "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/type :answer.type/math] [:db/add "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/value "\\frac{7}{\\pi}"] [:db/ensure "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/validate] [:db/add "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/id #uuid "ec92a541-0236-55c6-9780-e15a96944df5"] [:db/add "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/key "answer"] [:db/add "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/type :answer-field.type/blank] [:db/add "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/choices "d3fcda61-dde0-56ba-aba9-3c128ff21e1d"] [:db/add "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/correct "d3fcda61-dde0-56ba-aba9-3c128ff21e1d"] [:db/ensure "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/validate] [:db/add "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/id #uuid "e08ae2d3-6cbc-51bb-9630-56e2ea57265b"] [:db/add "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/worked-solution "Let $u=\\frac{\\pi x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\pi}{2},\\qquad \\mathrm{d}x=\\left(\\frac{2}{\\pi}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(0\\right)+\\left(0\\right)=0\\\\ x=\\frac{1}{3}&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(\\frac{1}{3}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x\\\\ &=7\\left(\\frac{2}{\\pi}\\right)\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\left[\\sin\\left(u\\right)\\right]_{0}^{\\frac{\\pi}{6}}\\\\ &=\\frac{14}{\\pi}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(0\\right)\\right)\\\\ &=\\frac{14}{\\pi}\\left(\\left(\\frac{1}{2}\\right)-\\left(0\\right)\\right)\\\\ &=\\frac{7}{\\pi}.\\end{aligned}\n$$"] [:db/add "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/difficulty :question.difficulty/moderate] [:db/add "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/answer-fields "ec92a541-0236-55c6-9780-e15a96944df5"] [:db/ensure "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "e08ae2d3-6cbc-51bb-9630-56e2ea57265b"] [:db/add "a3ae71b0-0616-5582-8426-8500a21242c5" :answer/id #uuid "a3ae71b0-0616-5582-8426-8500a21242c5"] [:db/add "a3ae71b0-0616-5582-8426-8500a21242c5" :answer/type :answer.type/math] [:db/add "a3ae71b0-0616-5582-8426-8500a21242c5" :answer/value "6"] [:db/ensure "a3ae71b0-0616-5582-8426-8500a21242c5" :answer/validate] [:db/add "97607e32-bce9-5350-af3d-b0b95b9120a8" :answer/id #uuid "97607e32-bce9-5350-af3d-b0b95b9120a8"] [:db/add "97607e32-bce9-5350-af3d-b0b95b9120a8" :answer/type :answer.type/math] [:db/add "97607e32-bce9-5350-af3d-b0b95b9120a8" :answer/value "- \\frac{27}{2}"] [:db/ensure "97607e32-bce9-5350-af3d-b0b95b9120a8" :answer/validate] [:db/add "6e33ac7d-1111-58bc-a5ef-3e977fe55380" :answer/id #uuid "6e33ac7d-1111-58bc-a5ef-3e977fe55380"] [:db/add "6e33ac7d-1111-58bc-a5ef-3e977fe55380" :answer/type :answer.type/math] [:db/add "6e33ac7d-1111-58bc-a5ef-3e977fe55380" :answer/value "\\frac{27}{4}"] [:db/ensure "6e33ac7d-1111-58bc-a5ef-3e977fe55380" :answer/validate] [:db/add "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/id #uuid "ed465d05-32c5-59f9-862e-19ebdb8ba802"] [:db/add "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/type :answer.type/math] [:db/add "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/value "\\frac{27}{2}"] [:db/ensure "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/validate] [:db/add "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1" :answer/id #uuid "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1"] [:db/add "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1" :answer/type :answer.type/math] [:db/add "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1" :answer/value "9"] [:db/ensure "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1" :answer/validate] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/id #uuid "91ff406b-b01c-500b-a9d1-8a1f7d62f93a"] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/key "selection"] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/type :answer-field.type/radio] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/choices "a3ae71b0-0616-5582-8426-8500a21242c5"] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/choices "97607e32-bce9-5350-af3d-b0b95b9120a8"] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/choices "6e33ac7d-1111-58bc-a5ef-3e977fe55380"] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/choices "ed465d05-32c5-59f9-862e-19ebdb8ba802"] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/choices "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1"] [:db/add "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/correct "ed465d05-32c5-59f9-862e-19ebdb8ba802"] [:db/ensure "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/validate] [:db/add "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/id #uuid "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b"] [:db/add "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\n$$"] [:db/add "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/worked-solution "Let $u=\\frac{2 x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{2}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(- \\frac{\\pi}{4}\\right)+\\left(0\\right)=- \\frac{\\pi}{6}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\\\\ &=9\\left(\\frac{3}{2}\\right)\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\left[\\sin\\left(u\\right)\\right]_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}}\\\\ &=\\frac{27}{2}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(- \\frac{\\pi}{6}\\right)\\right)\\\\ &=\\frac{27}{2}\\left(\\left(\\frac{1}{2}\\right)-\\left(- \\frac{1}{2}\\right)\\right)\\\\ &=\\frac{27}{2}.\\end{aligned}\n$$"] [:db/add "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/difficulty :question.difficulty/moderate] [:db/add "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/answer-fields "91ff406b-b01c-500b-a9d1-8a1f7d62f93a"] [:db/ensure "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b"] [:db/add "e02560fb-c13e-5b6d-85aa-73d31ee35632" :answer/id #uuid "e02560fb-c13e-5b6d-85aa-73d31ee35632"] [:db/add "e02560fb-c13e-5b6d-85aa-73d31ee35632" :answer/type :answer.type/math] [:db/add "e02560fb-c13e-5b6d-85aa-73d31ee35632" :answer/value "- \\frac{5 \\sqrt{3}}{6} - \\frac{5 \\sqrt{2}}{6}"] [:db/ensure "e02560fb-c13e-5b6d-85aa-73d31ee35632" :answer/validate] [:db/add "be5f4652-ef51-5fdb-99d1-b944f55685bb" :answer-field/id #uuid "be5f4652-ef51-5fdb-99d1-b944f55685bb"] [:db/add "be5f4652-ef51-5fdb-99d1-b944f55685bb" :answer-field/key "answer"] [:db/add "be5f4652-ef51-5fdb-99d1-b944f55685bb" :answer-field/type :answer-field.type/blank] [:db/add "be5f4652-ef51-5fdb-99d1-b944f55685bb" :answer-field/choices "e02560fb-c13e-5b6d-85aa-73d31ee35632"] [:db/add "be5f4652-ef51-5fdb-99d1-b944f55685bb" :answer-field/correct "e02560fb-c13e-5b6d-85aa-73d31ee35632"] [:db/ensure "be5f4652-ef51-5fdb-99d1-b944f55685bb" :answer-field/validate] [:db/add "4bcfa1e0-703e-524a-b749-85326c57a27f" :question/id #uuid "4bcfa1e0-703e-524a-b749-85326c57a27f"] [:db/add "4bcfa1e0-703e-524a-b749-85326c57a27f" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{4 \\pi}{9}}^{\\frac{\\pi}{2}} \\frac{5}{2}\\cos\\left(\\frac{3 x}{2} + \\pi\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "4bcfa1e0-703e-524a-b749-85326c57a27f" :question/worked-solution "Let $u=\\frac{3 x}{2} + \\pi.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{3}{2},\\qquad \\mathrm{d}x=\\left(\\frac{2}{3}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{4 \\pi}{9}&\\quad\\Longrightarrow\\quad u=\\frac{3}{2}\\left(- \\frac{4 \\pi}{9}\\right)+\\left(\\pi\\right)=\\frac{\\pi}{3}\\\\ x=\\frac{\\pi}{2}&\\quad\\Longrightarrow\\quad u=\\frac{3}{2}\\left(\\frac{\\pi}{2}\\right)+\\left(\\pi\\right)=\\frac{7 \\pi}{4}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{4 \\pi}{9}}^{\\frac{\\pi}{2}} \\frac{5}{2}\\cos\\left(\\frac{3 x}{2} + \\pi\\right)\\,\\mathrm{d}x\\\\ &=\\frac{5}{2}\\left(\\frac{2}{3}\\right)\\int_{\\frac{\\pi}{3}}^{\\frac{7 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{5}{3}\\int_{\\frac{\\pi}{3}}^{\\frac{7 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{5}{3}\\left[\\sin\\left(u\\right)\\right]_{\\frac{\\pi}{3}}^{\\frac{7 \\pi}{4}}\\\\ &=\\frac{5}{3}\\left(\\sin\\left(\\frac{7 \\pi}{4}\\right)-\\sin\\left(\\frac{\\pi}{3}\\right)\\right)\\\\ &=\\frac{5}{3}\\left(\\left(- \\frac{\\sqrt{2}}{2}\\right)-\\left(\\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{6} - \\frac{5 \\sqrt{2}}{6}.\\end{aligned}\n$$"] [:db/add "4bcfa1e0-703e-524a-b749-85326c57a27f" :question/difficulty :question.difficulty/hard] [:db/add "4bcfa1e0-703e-524a-b749-85326c57a27f" :question/answer-fields "be5f4652-ef51-5fdb-99d1-b944f55685bb"] [:db/ensure "4bcfa1e0-703e-524a-b749-85326c57a27f" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "4bcfa1e0-703e-524a-b749-85326c57a27f"] [:db/add "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/id #uuid "5564e6d7-8470-5ee5-be25-90e415f3a1f7"] [:db/add "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/type :answer.type/math] [:db/add "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/value "- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}"] [:db/ensure "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/validate] [:db/add "159128b8-e040-5516-a836-f601577308cb" :answer-field/id #uuid "159128b8-e040-5516-a836-f601577308cb"] [:db/add "159128b8-e040-5516-a836-f601577308cb" :answer-field/key "answer"] [:db/add "159128b8-e040-5516-a836-f601577308cb" :answer-field/type :answer-field.type/blank] [:db/add "159128b8-e040-5516-a836-f601577308cb" :answer-field/choices "5564e6d7-8470-5ee5-be25-90e415f3a1f7"] [:db/add "159128b8-e040-5516-a836-f601577308cb" :answer-field/correct "5564e6d7-8470-5ee5-be25-90e415f3a1f7"] [:db/ensure "159128b8-e040-5516-a836-f601577308cb" :answer-field/validate] [:db/add "bde0ea65-e851-569d-a00d-23c578b58f06" :question/id #uuid "bde0ea65-e851-569d-a00d-23c578b58f06"] [:db/add "bde0ea65-e851-569d-a00d-23c578b58f06" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\pi}{2}}^{\\frac{15 \\pi}{16}} \\frac{3}{4}\\sin\\left(\\frac{4 x}{3} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "bde0ea65-e851-569d-a00d-23c578b58f06" :question/worked-solution "Let $u=\\frac{4 x}{3} + \\frac{\\pi}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{4}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{4}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{2}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{\\pi}{2}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{7 \\pi}{6}\\\\ x=\\frac{15 \\pi}{16}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{15 \\pi}{16}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{7 \\pi}{4}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{2}}^{\\frac{15 \\pi}{16}} \\frac{3}{4}\\sin\\left(\\frac{4 x}{3} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{3}{4}\\left(\\frac{3}{4}\\right)\\int_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{9}{16}\\int_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{9}{16}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}}\\\\ &=- \\frac{9}{16}\\left(\\cos\\left(\\frac{7 \\pi}{4}\\right)-\\cos\\left(\\frac{7 \\pi}{6}\\right)\\right)\\\\ &=- \\frac{9}{16}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}.\\end{aligned}\n$$"] [:db/add "bde0ea65-e851-569d-a00d-23c578b58f06" :question/difficulty :question.difficulty/hard] [:db/add "bde0ea65-e851-569d-a00d-23c578b58f06" :question/answer-fields "159128b8-e040-5516-a836-f601577308cb"] [:db/ensure "bde0ea65-e851-569d-a00d-23c578b58f06" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "bde0ea65-e851-569d-a00d-23c578b58f06"] [:db/add "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/id #uuid "cf452ea9-b76c-5931-acd8-0d28a08d20ad"] [:db/add "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/type :answer.type/math] [:db/add "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/value "- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}"] [:db/ensure "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/validate] [:db/add "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/id #uuid "9eaf1394-6f14-55a0-a068-583ffa37b8e2"] [:db/add "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/key "answer"] [:db/add "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/type :answer-field.type/blank] [:db/add "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/choices "cf452ea9-b76c-5931-acd8-0d28a08d20ad"] [:db/add "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/correct "cf452ea9-b76c-5931-acd8-0d28a08d20ad"] [:db/ensure "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/validate] [:db/add "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/id #uuid "c4127c78-e9a5-5dca-9fdf-b419c6a80b69"] [:db/add "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/worked-solution "Let $u=- \\frac{3 x}{2} + \\frac{\\pi}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{3}{2},\\qquad \\mathrm{d}x=\\left(- \\frac{2}{3}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{7 \\pi}{9}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{7 \\pi}{9}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{5 \\pi}{3}\\\\ x=- \\frac{\\pi}{6}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{\\pi}{6}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{3 \\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{5}{3}\\left(- \\frac{2}{3}\\right)\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\left[\\sin\\left(u\\right)\\right]_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}}\\\\ &=- \\frac{10}{9}\\left(\\sin\\left(\\frac{3 \\pi}{4}\\right)-\\sin\\left(\\frac{5 \\pi}{3}\\right)\\right)\\\\ &=- \\frac{10}{9}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}.\\end{aligned}\n$$"] [:db/add "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/difficulty :question.difficulty/hard] [:db/add "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/answer-fields "9eaf1394-6f14-55a0-a068-583ffa37b8e2"] [:db/ensure "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "c4127c78-e9a5-5dca-9fdf-b419c6a80b69"] [:db/add "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/id #uuid "4a0e74a7-1c36-51b6-91e4-886cab511f20"] [:db/add "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/type :answer.type/math] [:db/add "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/value "- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}"] [:db/ensure "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/validate] [:db/add "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/id #uuid "e10b7850-b68c-56e8-b02f-3dbe81ab05a7"] [:db/add "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/key "answer"] [:db/add "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/type :answer-field.type/blank] [:db/add "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/choices "4a0e74a7-1c36-51b6-91e4-886cab511f20"] [:db/add "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/correct "4a0e74a7-1c36-51b6-91e4-886cab511f20"] [:db/ensure "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/validate] [:db/add "c367b576-70c2-5965-8278-60a472b975f2" :question/id #uuid "c367b576-70c2-5965-8278-60a472b975f2"] [:db/add "c367b576-70c2-5965-8278-60a472b975f2" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "c367b576-70c2-5965-8278-60a472b975f2" :question/worked-solution "Let $u=- \\frac{2 x}{5} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{2}{5},\\qquad \\mathrm{d}x=\\left(- \\frac{5}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{15 \\pi}{4}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(- \\frac{15 \\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{11 \\pi}{6}\\\\ x=\\frac{5 \\pi}{24}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(\\frac{5 \\pi}{24}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{4}{3}\\left(- \\frac{5}{2}\\right)\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}}\\\\ &=\\frac{10}{3}\\left(\\cos\\left(\\frac{\\pi}{4}\\right)-\\cos\\left(\\frac{11 \\pi}{6}\\right)\\right)\\\\ &=\\frac{10}{3}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(\\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}.\\end{aligned}\n$$"] [:db/add "c367b576-70c2-5965-8278-60a472b975f2" :question/difficulty :question.difficulty/hard] [:db/add "c367b576-70c2-5965-8278-60a472b975f2" :question/answer-fields "e10b7850-b68c-56e8-b02f-3dbe81ab05a7"] [:db/ensure "c367b576-70c2-5965-8278-60a472b975f2" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "c367b576-70c2-5965-8278-60a472b975f2"] [:db/add "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/id #uuid "e121f6b0-8162-5af1-8275-aafe620e7f30"] [:db/add "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/type :answer.type/math] [:db/add "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/value "- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}"] [:db/ensure "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/validate] [:db/add "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/id #uuid "e1757f25-fe17-5f29-aeef-375989f1d640"] [:db/add "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/key "answer"] [:db/add "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/type :answer-field.type/blank] [:db/add "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/choices "e121f6b0-8162-5af1-8275-aafe620e7f30"] [:db/add "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/correct "e121f6b0-8162-5af1-8275-aafe620e7f30"] [:db/ensure "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/validate] [:db/add "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/id #uuid "91ceb661-bbb3-59a9-a7e3-99caa019215e"] [:db/add "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/worked-solution "Let $u=\\frac{4 x}{3} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{4}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{4}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{16}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(- \\frac{\\pi}{16}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{2 \\pi}{3}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{7}{3}\\left(\\frac{3}{4}\\right)\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\left[\\sin\\left(u\\right)\\right]_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}}\\\\ &=\\frac{7}{4}\\left(\\sin\\left(\\frac{2 \\pi}{3}\\right)-\\sin\\left(\\frac{\\pi}{4}\\right)\\right)\\\\ &=\\frac{7}{4}\\left(\\left(\\frac{\\sqrt{3}}{2}\\right)-\\left(\\frac{\\sqrt{2}}{2}\\right)\\right)\\\\ &=- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}.\\end{aligned}\n$$"] [:db/add "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/difficulty :question.difficulty/hard] [:db/add "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/answer-fields "e1757f25-fe17-5f29-aeef-375989f1d640"] [:db/ensure "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "91ceb661-bbb3-59a9-a7e3-99caa019215e"] [:db/add "generator" :question-generator/id #uuid "614576f1-1d87-593c-9490-c47e22c3c1e9"] [:db/add "generator" :question-generator/script "generators/b8/b8641145f08d065e5bd8bc95eb1679123310934e4ce8a9c0cfcd9dbca6001ccd/generator.py"] [:db/add 17592186068915 :knowledge-point/question-generator "generator"] [:db/ensure 17592186068915 :knowledge-point/validate] [:db/cas 17592186482716 :question/retired nil true] [:db/cas 17592186482718 :question/retired nil true] [:db/cas 17592186482722 :question/retired nil true] [:db/cas 17592186482724 :question/retired nil true]]
