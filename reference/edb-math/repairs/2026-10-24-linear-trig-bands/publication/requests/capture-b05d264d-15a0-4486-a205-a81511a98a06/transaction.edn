9ed-aa36-5cd6-b857-f98fa492f0ad"] [:db/add "91697a01-5c8e-5ec5-9d4d-40df179b19c1" :answer-field/choices "3e306d20-d2b1-5a3d-a552-2e55f37cef45"] [:db/add "91697a01-5c8e-5ec5-9d4d-40df179b19c1" :answer-field/choices "3d180e7a-0337-5f13-9937-e1a7f411edf8"] [:db/add "91697a01-5c8e-5ec5-9d4d-40df179b19c1" :answer-field/choices "45089e5d-ae43-566d-b483-7e410e696f4e"] [:db/add "91697a01-5c8e-5ec5-9d4d-40df179b19c1" :answer-field/choices "32c3129a-6b42-58de-8a06-66ce28bd379b"] [:db/add "91697a01-5c8e-5ec5-9d4d-40df179b19c1" :answer-field/correct "3d180e7a-0337-5f13-9937-e1a7f411edf8"] [:db/ensure "91697a01-5c8e-5ec5-9d4d-40df179b19c1" :answer-field/validate] [:db/add "147dbb57-6890-5654-a45c-df8a4958135a" :question/id #uuid "147dbb57-6890-5654-a45c-df8a4958135a"] [:db/add "147dbb57-6890-5654-a45c-df8a4958135a" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int 2\\cos\\left(2 x + 6\\right)\\,\\mathrm{d}x\n$$"] [:db/add "147dbb57-6890-5654-a45c-df8a4958135a" :question/worked-solution "Let $u=2 x + 6.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2,\\qquad \\mathrm{d}x=\\left(\\frac{1}{2}\\right)\\mathrm{d}u.\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int 2\\cos\\left(2 x + 6\\right)\\,\\mathrm{d}x\\\\ &=2\\left(\\frac{1}{2}\\right)\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=1\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=1\\left(\\sin\\left(u\\right)\\right)+C\\\\ &=\\sin\\left(2 x + 6\\right)+C.\\end{aligned}\n$$"] [:db/add "147dbb57-6890-5654-a45c-df8a4958135a" :question/difficulty :question.difficulty/easy] [:db/add "147dbb57-6890-5654-a45c-df8a4958135a" :question/answer-fields "91697a01-5c8e-5ec5-9d4d-40df179b19c1"] [:db/ensure "147dbb57-6890-5654-a45c-df8a4958135a" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "147dbb57-6890-5654-a45c-df8a4958135a"] [:db/add "681faebd-59d7-5aad-be76-d7bda39af783" :answer/id #uuid "681faebd-59d7-5aad-be76-d7bda39af783"] [:db/add "681faebd-59d7-5aad-be76-d7bda39af783" :answer/type :answer.type/math] [:db/add "681faebd-59d7-5aad-be76-d7bda39af783" :answer/value "\\frac{3}{7}"] [:db/ensure "681faebd-59d7-5aad-be76-d7bda39af783" :answer/validate] [:db/add "efad99be-23b1-5f35-959b-32b553356edc" :answer-field/id #uuid "efad99be-23b1-5f35-959b-32b553356edc"] [:db/add "efad99be-23b1-5f35-959b-32b553356edc" :answer-field/key "answer"] [:db/add "efad99be-23b1-5f35-959b-32b553356edc" :answer-field/type :answer-field.type/blank] [:db/add "efad99be-23b1-5f35-959b-32b553356edc" :answer-field/choices "681faebd-59d7-5aad-be76-d7bda39af783"] [:db/add "efad99be-23b1-5f35-959b-32b553356edc" :answer-field/correct "681faebd-59d7-5aad-be76-d7bda39af783"] [:db/ensure "efad99be-23b1-5f35-959b-32b553356edc" :answer-field/validate] [:db/add "1f9657e8-0b88-5bcb-a83c-0378b111282a" :question/id #uuid "1f9657e8-0b88-5bcb-a83c-0378b111282a"] [:db/add "1f9657e8-0b88-5bcb-a83c-0378b111282a" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{3 \\pi}{14}}^{\\frac{2 \\pi}{7}} 3\\cos\\left(7 x\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "1f9657e8-0b88-5bcb-a83c-0378b111282a" :question/worked-solution "Let $u=7 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=7,\\qquad \\mathrm{d}x=\\left(\\frac{1}{7}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{3 \\pi}{14}&\\quad\\Longrightarrow\\quad u=7\\left(\\frac{3 \\pi}{14}\\right)+\\left(0\\right)=\\frac{3 \\pi}{2}\\\\ x=\\frac{2 \\pi}{7}&\\quad\\Longrightarrow\\quad u=7\\left(\\frac{2 \\pi}{7}\\right)+\\left(0\\right)=2 \\pi.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{\\frac{3 \\pi}{14}}^{\\frac{2 \\pi}{7}} 3\\cos\\left(7 x\\right)\\,\\mathrm{d}x\\\\ &=3\\left(\\frac{1}{7}\\right)\\int_{\\frac{3 \\pi}{2}}^{2 \\pi} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{3}{7}\\int_{\\frac{3 \\pi}{2}}^{2 \\pi} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{3}{7}\\left[\\sin\\left(u\\right)\\right]_{\\frac{3 \\pi}{2}}^{2 \\pi}\\\\ &=\\frac{3}{7}\\left(\\sin\\left(2 \\pi\\right)-\\sin\\left(\\frac{3 \\pi}{2}\\right)\\right)\\\\ &=\\frac{3}{7}\\left(\\left(0\\right)-\\left(-1\\right)\\right)\\\\ &=\\frac{3}{7}.\\end{aligned}\n$$"] [:db/add "1f9657e8-0b88-5bcb-a83c-0378b111282a" :question/difficulty :question.difficulty/easy] [:db/add "1f9657e8-0b88-5bcb-a83c-0378b111282a" :question/answer-fields "efad99be-23b1-5f35-959b-32b553356edc"] [:db/ensure "1f9657e8-0b88-5bcb-a83c-0378b111282a" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "1f9657e8-0b88-5bcb-a83c-0378b111282a"] [:db/add "4ce7375c-8c2a-58a4-9684-dfd27be44f50" :answer/id #uuid "4ce7375c-8c2a-58a4-9684-dfd27be44f50"] [:db/add "4ce7375c-8c2a-58a4-9684-dfd27be44f50" :answer/type :answer.type/math] [:db/add "4ce7375c-8c2a-58a4-9684-dfd27be44f50" :answer/value "14\\cos\\left(2 x - 6\\right)+C"] [:db/ensure "4ce7375c-8c2a-58a4-9684-dfd27be44f50" :answer/validate] [:db/add "bef7fdaf-2777-5fed-9ee8-4c2ae3d71a4b" :answer/id #uuid "bef7fdaf-2777-5fed-9ee8-4c2ae3d71a4b"] [:db/add "bef7fdaf-2777-5fed-9ee8-4c2ae3d71a4b" :answer/type :answer.type/math] [:db/add "bef7fdaf-2777-5fed-9ee8-4c2ae3d71a4b" :answer/value "- \\frac{7}{2}\\sin\\left(2 x - 6\\right)+C"] [:db/ensure "bef7fdaf-2777-5fed-9ee8-4c2ae3d71a4b" :answer/validate] [:db/add "a3bfd06a-2993-5a25-824d-5927347d72d1" :answer/id #uuid "a3bfd06a-2993-5a25-824d-5927347d72d1"] [:db/add "a3bfd06a-2993-5a25-824d-5927347d72d1" :answer/type :answer.type/math] [:db/add "a3bfd06a-2993-5a25-824d-5927347d72d1" :answer/value "-14\\cos\\left(2 x - 6\\right)+C"] [:db/ensure "a3bfd06a-2993-5a25-824d-5927347d72d1" :answer/validate] [:db/add "cfd79bed-4758-5a59-b26e-e3123798f5a3" :answer/id #uuid "cfd79bed-4758-5a59-b26e-e3123798f5a3"] [:db/add "cfd79bed-4758-5a59-b26e-e3123798f5a3" :answer/type :answer.type/math] [:db/add "cfd79bed-4758-5a59-b26e-e3123798f5a3" :answer/value "- \\frac{7}{2}\\cos\\left(2 x - 6\\right)+C"] [:db/ensure "cfd7