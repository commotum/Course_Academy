\right)\\,\\mathrm{d}x\\\\ &=7\\left(\\frac{1}{2}\\right)\\int \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{2}\\int \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{2}\\left(-\\cos\\left(u\\right)\\right)+C\\\\ &=- \\frac{7}{2}\\cos\\left(2 x - 6\\right)+C.\\end{aligned}\n$$"] [:db/add "02a4ecd8-fe53-5b76-bb00-7a2fb2b7da62" :question/difficulty :question.difficulty/easy] [:db/add "02a4ecd8-fe53-5b76-bb00-7a2fb2b7da62" :question/answer-fields "3e967a1c-85f3-5fb7-9c6b-eb6b3985676d"] [:db/ensure "02a4ecd8-fe53-5b76-bb00-7a2fb2b7da62" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "02a4ecd8-fe53-5b76-bb00-7a2fb2b7da62"] [:db/add "5f34da43-0f48-5e0a-a50f-7ea610a1bc7b" :answer/id #uuid "5f34da43-0f48-5e0a-a50f-7ea610a1bc7b"] [:db/add "5f34da43-0f48-5e0a-a50f-7ea610a1bc7b" :answer/type :answer.type/math] [:db/add "5f34da43-0f48-5e0a-a50f-7ea610a1bc7b" :answer/value "\\frac{2}{3}"] [:db/ensure "5f34da43-0f48-5e0a-a50f-7ea610a1bc7b" :answer/validate] [:db/add "ee403d3c-509a-5002-9242-3fcc94c0d976" :answer-field/id #uuid "ee403d3c-509a-5002-9242-3fcc94c0d976"] [:db/add "ee403d3c-509a-5002-9242-3fcc94c0d976" :answer-field/key "answer"] [:db/add "ee403d3c-509a-5002-9242-3fcc94c0d976" :answer-field/type :answer-field.type/blank] [:db/add "ee403d3c-509a-5002-9242-3fcc94c0d976" :answer-field/choices "5f34da43-0f48-5e0a-a50f-7ea610a1bc7b"] [:db/add "ee403d3c-509a-5002-9242-3fcc94c0d976" :answer-field/correct "5f34da43-0f48-5e0a-a50f-7ea610a1bc7b"] [:db/ensure "ee403d3c-509a-5002-9242-3fcc94c0d976" :answer-field/validate] [:db/add "6dc5e039-64c3-5cf6-8a27-6b787b1f362f" :question/id #uuid "6dc5e039-64c3-5cf6-8a27-6b787b1f362f"] [:db/add "6dc5e039-64c3-5cf6-8a27-6b787b1f362f" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{36}}^{\\frac{\\pi}{36}} 8\\cos\\left(6 x + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "6dc5e039-64c3-5cf6-8a27-6b787b1f362f" :question/worked-solution "Let $u=6 x + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=6,\\qquad \\mathrm{d}x=\\left(\\frac{1}{6}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{36}&\\quad\\Longrightarrow\\quad u=6\\left(- \\frac{\\pi}{36}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{6}\\\\ x=\\frac{\\pi}{36}&\\quad\\Longrightarrow\\quad u=6\\left(\\frac{\\pi}{36}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{2}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{36}}^{\\frac{\\pi}{36}} 8\\cos\\left(6 x + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=8\\left(\\frac{1}{6}\\right)\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{2}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{2}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\left[\\sin\\left(u\\right)\\right]_{\\frac{\\pi}{6}}^{\\frac{\\pi}{2}}\\\\ &=\\frac{4}{3}\\left(\\sin\\left(\\frac{\\pi}{2}\\right)-\\sin\\left(\\frac{\\pi}{6}\\right)\\right)\\\\ &=\\frac{4}{3}\\left(\\left(1\\right)-\\left(\\frac{1}{2}\\right)\\right)\\\\ &=\\frac{2}{3}.\\end{aligned}\n$$"] [:db/add "6dc5e039-64c3-5cf6-8a27-6b787b1f362f" :question/difficulty :question.difficulty/moderate] [:db/add "6dc5e039-64c3-5cf6-8a27-6b787b1f362f" :question/answer-fields "ee403d3c-509a-5002-9242-3fcc94c0d976"] [:db/ensure "6dc5e039-64c3-5cf6-8a27-6b787b1f362f" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "6dc5e039-64c3-5cf6-8a27-6b787b1f362f"] [:db/add "ae5c49f8-3c96-547c-83ae-539136c25a87" :answer/id #uuid "ae5c49f8-3c96-547c-83ae-539136c25a87"] [:db/add "ae5c49f8-3c96-547c-83ae-539136c25a87" :answer/type :answer.type/math] [:db/add "ae5c49f8-3c96-547c-83ae-539136c25a87" :answer/value "\\frac{1}{\\pi}"] [:db/ensure "ae5c49f8-3c96-547c-83ae-539136c25a87" :answer/validate] [:db/add "60cb7d71-ee14-5924-9fe9-1b0465b328f7" :answer-field/id #uuid "60cb7d71-ee14-5924-9fe9-1b0465b328f7"] [:db/add "60cb7d71-ee14-5924-9fe9-1b0465b328f7" :answer-field/key "answer"] [:db/add "60cb7d71-ee14-5924-9fe9-1b0465b328f7" :answer-field/type :answer-field.type/blank] [:db/add "60cb7d71-ee14-5924-9fe9-1b0465b328f7" :answer-field/choices "ae5c49f8-3c96-547c-83ae-539136c25a87"] [:db/add "60cb7d71-ee14-5924-9fe9-1b0465b328f7" :answer-field/correct "ae5c49f8-3c96-547c-83ae-539136c25a87"] [:db/ensure "60cb7d71-ee14-5924-9fe9-1b0465b328f7" :answer-field/validate] [:db/add "63c57725-6371-5ca9-959a-491975ac1d75" :question/id #uuid "63c57725-6371-5ca9-959a-491975ac1d75"] [:db/add "63c57725-6371-5ca9-959a-491975ac1d75" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{2}{3}} \\sin\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "63c57725-6371-5ca9-959a-491975ac1d75" :question/worked-solution "Let $u=\\frac{\\pi x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\pi}{2},\\qquad \\mathrm{d}x=\\left(\\frac{2}{\\pi}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(0\\right)+\\left(0\\right)=0\\\\ x=\\frac{2}{3}&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(\\frac{2}{3}\\right)+\\left(0\\right)=\\frac{\\pi}{3}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{2}{3}} \\sin\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x\\\\ &=1\\left(\\frac{2}{\\pi}\\right)\\int_{0}^{\\frac{\\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{2}{\\pi}\\int_{0}^{\\frac{\\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{2}{\\pi}\\left[-\\cos\\left(u\\right)\\right]_{0}^{\\frac{\\pi}{3}}\\\\ &=- \\frac{2}{\\pi}\\left(\\cos\\left(\\frac{\\pi}{3}\\right)-\\cos\\left(0\\right)\\right)\\\\ &=- \\frac{2}{\\pi}\\left(\\left(\\frac{1}{2}\\right)-\\left(1\\right)\\right)\\\\ &=\\frac{1}{\\pi}.\\end{aligned}\n$$"] [:db/add "63c57725-6371-5ca9-959a-491975ac1d75" :question/difficulty :question.difficulty/moderate] [:db/add "63c57725-6371-5ca9-959a-491975ac1d75" :question/answer-fields "60cb7d71-ee14-5924-9fe9-1b0465b328f7"] [:db/ensure "63c57725-6371-5ca9-959a-491975ac1d75" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "63c57725-6371-5ca9-959a-491975ac1d75"] [:db/add "07058ef8-4cad-5206-8288-4fcc5924cd1d" :answer/id #uuid "07058ef8-4cad-5206-8288-4fcc5924cd1d"] [:db/add "07058ef8-4cad-5206-8288-4fcc5924cd1d" :answer/type :answer.type/math] [:db/add "07058ef8-4cad-5206-8288-4fcc5924cd1d" :answer/value "\\frac{32}{3}"] [:db/ensure "07058ef8-4cad-5206-8288-4fcc5924cd1d" :answer/validate] [:db/add "f63bd4a4-d81e-5bfc-954c-18b7e3205a39" :answer/id #uuid "f63bd4a4-d81e-5bfc-954c-18b7e3205a39"] [:db/add "f63bd4a4-d81e-5bfc-954c-18b7e3205a39" :answer/type :answer.type/math] [:db/add "f63bd4a4-d81e-5bfc-954c-18b7e3205a39" :answer/value "6"] [:db/ensure "f63bd4a4-d81e-5bfc-954c-18b7e3205a39" :answer/validate] [:db/add "bb790c67-e396-585d-9e02-eac4d0f80443" :answer/id #uuid "bb790c67-e396-585d-9e02-eac4d0f80443"] [:db/add "bb790c67-e396-585d-9e02-eac4d0f80443" :answer/type :answer.type/math] [:db/add "bb790c67-e396-585d-9e02-eac4d0f80443" :answer/value "- \\frac{32}{3}"] [:db/ensure "bb790c67-e396-585d-9e02-eac4d0f80443" :answer/validate] [:db/add "5d32331d-f52e-5d0c-91be-227ebbaeac32" :answer/id #uuid "5d32331d-f52e-5d0c-91be-227ebbaeac32"] [:db/add "5d32331d-f52e-5d0c-91be-227ebbaeac32" :answer/type :answer.type/math] [:db/add "5d32331d-f52e-5d0c-91be-227ebbaeac32" :answer/value "8"] [:db/ensure "5d32331d-f52e-5d0c-91be-227ebbaeac32" :answer/validate] [:db/add "e63fbaa5-1271-563b-9d06-bd5da6fc9ed9" :answer/id #uuid "e63fbaa5-1271-563b-9d06-bd5da6fc9ed9"] [:db/add "e63fbaa5-1271-563b-9d06-bd5da6fc9ed9" :answer/type :answer.type/math] [:db/add "e63fbaa5-1271-563b-9d06-bd5da6fc9ed9" :answer/value "\\frac{16}{3}"] [:db/ensure "e63fbaa5-1271-563b-9d06-bd5da6fc9ed9" :answer/validate] [:db/add "cef245d6-aaad-