i}{9}} 8\\sin\\left(\\frac{3 x}{4}\\right)\\,\\mathrm{d}x\\\\ &=8\\left(\\frac{4}{3}\\right)\\int_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{32}{3}\\int_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{32}{3}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}}\\\\ &=- \\frac{32}{3}\\left(\\cos\\left(\\frac{2 \\pi}{3}\\right)-\\cos\\left(\\frac{\\pi}{3}\\right)\\right)\\\\ &=- \\frac{32}{3}\\left(\\left(- \\frac{1}{2}\\right)-\\left(\\frac{1}{2}\\right)\\right)\\\\ &=\\frac{32}{3}.\\end{aligned}\n$$"] [:db/add "10d173e1-5192-5447-b754-267d1ea43054" :question/difficulty :question.difficulty/moderate] [:db/add "10d173e1-5192-5447-b754-267d1ea43054" :question/answer-fields "cef245d6-aaad-57dc-bd11-d73ebb75fef4"] [:db/ensure "10d173e1-5192-5447-b754-267d1ea43054" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "10d173e1-5192-5447-b754-267d1ea43054"] [:db/add "0359f783-0312-5459-acec-71a042146a5d" :answer/id #uuid "0359f783-0312-5459-acec-71a042146a5d"] [:db/add "0359f783-0312-5459-acec-71a042146a5d" :answer/type :answer.type/math] [:db/add "0359f783-0312-5459-acec-71a042146a5d" :answer/value "2"] [:db/ensure "0359f783-0312-5459-acec-71a042146a5d" :answer/validate] [:db/add "22deb4b9-7e3e-56d5-a0c8-62dc8130800c" :answer/id #uuid "22deb4b9-7e3e-56d5-a0c8-62dc8130800c"] [:db/add "22deb4b9-7e3e-56d5-a0c8-62dc8130800c" :answer/type :answer.type/math] [:db/add "22deb4b9-7e3e-56d5-a0c8-62dc8130800c" :answer/value "6"] [:db/ensure "22deb4b9-7e3e-56d5-a0c8-62dc8130800c" :answer/validate] [:db/add "5ff3dbe0-984d-5124-8f01-74a3783380e4" :answer/id #uuid "5ff3dbe0-984d-5124-8f01-74a3783380e4"] [:db/add "5ff3dbe0-984d-5124-8f01-74a3783380e4" :answer/type :answer.type/math] [:db/add "5ff3dbe0-984d-5124-8f01-74a3783380e4" :answer/value "- \\frac{4}{3}"] [:db/ensure "5ff3dbe0-984d-5124-8f01-74a3783380e4" :answer/validate] [:db/add "c51f5cf3-74f6-501a-8b50-211