[[:db/add "25b31114-aa79-5baf-bf88-25ff628340ee" :answer/id #uuid "25b31114-aa79-5baf-bf88-25ff628340ee"] [:db/add "25b31114-aa79-5baf-bf88-25ff628340ee" :answer/type :answer.type/math] [:db/add "25b31114-aa79-5baf-bf88-25ff628340ee" :answer/value "\\frac{3}{7}\\cos\\left(3 - 7 x\\right)"] [:db/ensure "25b31114-aa79-5baf-bf88-25ff628340ee" :answer/validate] [:db/add "129f57c1-a174-566a-9f13-b798e1b3c2ad" :answer-field/id #uuid "129f57c1-a174-566a-9f13-b798e1b3c2ad"] [:db/add "129f57c1-a174-566a-9f13-b798e1b3c2ad" :answer-field/key "answer"] [:db/add "129f57c1-a174-566a-9f13-b798e1b3c2ad" :answer-field/type :answer-field.type/blank] [:db/add "129f57c1-a174-566a-9f13-b798e1b3c2ad" :answer-field/choices "25b31114-aa79-5baf-bf88-25ff628340ee"] [:db/add "129f57c1-a174-566a-9f13-b798e1b3c2ad" :answer-field/correct "25b31114-aa79-5baf-bf88-25ff628340ee"] [:db/ensure "129f57c1-a174-566a-9f13-b798e1b3c2ad" :answer-field/validate] [:db/add "6dc83e44-6626-5e65-a40a-a1bd0e3611df" :question/id #uuid "6dc83e44-6626-5e65-a40a-a1bd0e3611df"] [:db/add "6dc83e44-6626-5e65-a40a-a1bd0e3611df" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int 3\\sin\\left(3 - 7 x\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}} $+C$"] [:db/add "6dc83e44-6626-5e65-a40a-a1bd0e3611df" :question/worked-solution "Let $u=3 - 7 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-7,\\qquad \\mathrm{d}x=\\left(- \\frac{1}{7}\\right)\\mathrm{d}u.\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int 3\\sin\\left(3 - 7 x\\right)\\,\\mathrm{d}x\\\\ &=3\\left(- \\frac{1}{7}\\right)\\int \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{3}{7}\\int \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{3}{7}\\left(-\\cos\\left(u\\right)\\right)+C\\\\ &=\\frac{3}{7}\\cos\\left(3 - 7 x\\right)+C.\\end{aligned}\n$$"] [:db/add "6dc83e44-6626-5e65-a40a-a1bd0e3611df" :question/difficulty :question.difficulty/easy] [:db/add "6dc83e44-6626-5e65-a40a-a1bd0e3611df" :question/answer-fields "129f57c1-a174-566a-9f13-b798e1b3c2ad"] [:db/ensure "6dc83e44-6626-5e65-a40a-a1bd0e3611df" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "6dc83e44-6626-5e65-a40a-a1bd0e3611df"] [:db/add "7dfcb1e6-0495-5263-82a6-ad72181751f8" :answer/id #uuid "7dfcb1e6-0495-5263-82a6-ad72181751f8"] [:db/add "7dfcb1e6-0495-5263-82a6-ad72181751f8" :answer/type :answer.type/math] [:db/add "7dfcb1e6-0495-5263-82a6-ad72181751f8" :answer/value "2"] [:db/ensure "7dfcb1e6-0495-5263-82a6-ad72181751f8" :answer/validate] [:db/add "9fa114f1-dbaf-5014-91ef-821840c3f254" :answer-field/id #uuid "9fa114f1-dbaf-5014-91ef-821840c3f254"] [:db/add "9fa114f1-dbaf-5014-91ef-821840c3f254" :answer-field/key "answer"] [:db/add "9fa114f1-dbaf-5014-91ef-821840c3f254" :answer-field/type :answer-field.type/blank] [:db/add "9fa114f1-dbaf-5014-91ef-821840c3f254" :answer-field/choices "7dfcb1e6-0495-5263-82a6-ad72181751f8"] [:db/add "9fa114f1-dbaf-5014-91ef-821840c3f254" :answer-field/correct "7dfcb1e6-0495-5263-82a6-ad72181751f8"] [:db/ensure "9fa114f1-dbaf-5014-91ef-821840c3f254" :answer-field/validate] [:db/add "4668fb00-b242-546c-8a63-ae7e49505541" :question/id #uuid "4668fb00-b242-546c-8a63-ae7e49505541"] [:db/add "4668fb00-b242-546c-8a63-ae7e49505541" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{\\pi}{9}} 9\\sin\\left(9 x\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}"] [:db/add "4668fb00-b242-546c-8a63-ae7e49505541" :question/worked-solution "Let $u=9 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9,\\qquad \\mathrm{d}x=\\left(\\frac{1}{9}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\quad\\Longrightarrow\\quad u=9\\left(0\\right)+\\left(0\\right)=0\\\\ x=\\frac{\\pi}{9}&\\quad\\Longrightarrow\\quad u=9\\left(\\frac{\\pi}{9}\\right)+\\left(0\\right)=\\pi.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{\\pi}{9}} 9\\sin\\left(9 x\\right)\\,\\mathrm{d}x\\\\ &=9\\left(\\frac{1}{9}\\right)\\int_{0}^{\\pi} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=1\\int_{0}^{\\pi} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=1\\left[-\\cos\\left(u\\right)\\right]_{0}^{\\pi}\\\\ &=-1\\left(\\cos\\left(\\pi\\right)-\\cos\\left(0\\right)\\right)\\\\ &=-1\\left(\\left(-1\\right)-\\left(1\\right)\\right)\\\\ &=2.\\end{aligned}\n$$"] [:db/add "4668fb00-b242-546c-8a63-ae7e49505541" :question/difficulty :question.difficulty/easy] [:db/add "4668fb00-b242-546c-8a63-ae7e49505541" :question/answer-fields "9fa114f1-dbaf-5014-91ef-821840c3f254"] [:db/ensure "4668fb00-b242-546c-8a63-ae7e49505541" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "4668fb00-b242-546c-8a63-ae7e49505541"] [:db/add "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/id #uuid "6b096547-15c1-510d-a3dc-fbef497569c6"] [:db/add "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/type :answer.type/math] [:db/add "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/value "- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)"] [:db/ensure "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/validate] [:db/add "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/id #uuid "22365332-c83c-5a84-b180-311e56a951fa"] [:db/add "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/key "answer"] [:db/add "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/type :answer-field.type/blank] [:db/add "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/choices "6b096547-15c1-510d-a3dc-fbef497569c6"] [:db/add "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/correct "6b096547-15c1-510d-a3dc-fbef497569c6"] [:db/ensure "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/validate] [:db/add "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/id #uuid "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c"] [:db/add "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int 4\\cos\\left(1 - 5 x\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}} $+C$"] [:db/add "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/worked-solution "Let $u=1 - 5 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-5,\\qquad \\mathrm{d}x=\\left(- \\frac{1}{5}\\right)\\mathrm{d}u.\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int 4\\cos\\left(1 - 5 x\\right)\\,\\mathrm{d}x\\\\ &=4\\left(- \\frac{1}{5}\\right)\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{4}{5}\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{4}{5}\\left(\\sin\\left(u\\right)\\right)+C\\\\ &=- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)+C.\\end{aligned}\n$$"] [:db/add "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/difficulty :question.difficulty/easy] [:db/add "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/answer-fields "22365332-c83c-5a84-b180-311e56a951fa"] [:db/ensure "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c"] [:db/add "c868113b-f21d-5988-819f-3ea71492c522" :answer/id #uuid "c868113b-f21d-5988-819f-3ea71492c522"] [:db/add "c868113b-f21d-5988-819f-3ea71492c522" :answer/type :answer.type/math] [:db/add "c868113b-f21d-5988-819f-3ea71492c522" :answer/value "30"] [:db/ensure "c868113b-f21d-5988-819f-3ea71492c522" :answer/validate] [:db/add "941d99e6-574d-5828-b441-b4e7c8a0812f" :answer/id #uuid "941d99e6-574d-5828-b441-b4e7c8a0812f"] [:db/add "941d99e6-574d-5828-b441-b4e7c8a0812f" :answer/type :answer.type/math] [:db/add "941d99e6-574d-5828-b441-b4e7c8a0812f" :answer/value "- \\frac{6}{5}"] [:db/ensure "941d99e6-574d-5828-b441-b4e7c8a0812f" :answer/validate] [:db/add "9cffe1d3-d2da-59aa-b7a6-307ae4ada02a" :answer/id #uuid "9cffe1d3-d2da-59aa-b7a6-307ae4ada02a"] [:db/add "9cffe1d3-d2da-59aa-b7a6-307ae4ada02a" :answer/type :answer.type/math] [:db/add "9cffe1d3-d2da-59aa-b7a6-307ae4ada02a" :answer/value "6"] [:db/ensure "9cffe1d3-d2da-59aa-b7a6-307ae4ada02a" :answer/validate] [:db/add "480174f7-6a5b-5d3d-82d2-79b9a3743ba6" :answer/id #uuid "480174f7-6a5b-5d3d-82d2-79b9