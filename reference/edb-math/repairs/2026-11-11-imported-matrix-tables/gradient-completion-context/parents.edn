 \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=-2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=-2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{x}_{1}^{2}{x}_{2}^{2} & -2{x}_{1}{x}_{2} \\\\ -2{x}_{1}{x}_{2} & 2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7f2ad9-b172-524e-b52c-42588397217d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186529804}] :answer-field/correct {:answer/id #uuid "5c7f2ad9-b172-524e-b52c-42588397217d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186529804} :answer-field/id #uuid "09e13d1e-7edd-5b89-b514-be2cd80a2204" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530226} {:answer-field/choices [{:answer/id #uuid "25294040-285c-52b6-9de8-d0c78213a3df" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529661}] :answer-field/correct {:answer/id #uuid "25294040-285c-52b6-9de8-d0c78213a3df" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529661} :answer-field/id #uuid "5550c2be-5d3c-58be-bc8e-d1a2e37820e9" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530281} {:answer-field/choices [{:answer/id #uuid "2e8c2151-d1f7-5e77-984d-977058948cf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529681}] :answer-field/correct {:answer/id #uuid "2e8c2151-d1f7-5e77-984d-977058948cf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17