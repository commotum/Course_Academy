/ref 17592186530063}] :answer-field/correct {:answer/id #uuid "c1b6661d-a08a-5c9c-97ea-75c8ed8b1a7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{z}" :db/id #edb/ref 17592186530063} :answer-field/id #uuid "2c1adc0a-c465-5765-a271-6cf456d2ee26" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530252} {:answer-field/choices [{:answer/id #uuid "c49d497a-5133-5547-a1e5-47527e18b642" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{xy}{{z}^{2}}" :db/id #edb/ref 17592186530070}] :answer-field/correct {:answer/id #uuid "c49d497a-5133-5547-a1e5-47527e18b642" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{xy}{{z}^{2}}" :db/id #edb/ref 17592186530070} :answer-field/id #uuid "8a5606ec-22d8-59ef-accf-8e2b329fb9d3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530323}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6fe4b67e-5906-58ff-aafc-e34173437530" :question/math-academy-id "q-264817" :question/problem "Given the function $f(x,y,z)=\\frac{xy}{z},$ compute ${∇}_{y,z}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{y,z}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{y,z}\\,f$, we take partial derivatives with respect to $y$ and $z$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}=\\frac{∂}{∂y}\\left(\\frac{xy}{z}\\right) & =\\frac{x}{z} \\\\ \\frac{∂f}{∂z}=\\frac{∂}{∂z}\\left(\\frac{xy}{z}\\right) & =-\\frac{xy}{{z}^{2}}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{y,z}\\,f & =\\begin{bmatrix}\\frac{∂f}{∂y} \\\\ \\frac{∂f}{∂z}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{x}{z} \\\\ -\\frac{xy}{{z}^{2}}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186665391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ceb4f82-dd8f-5cfd-b3d5-52c2f5679fb5" :answer/type {:db/ident :answer.type/math} :answer/value "y+z" :db/id #edb/ref 17592186664936}] :answer-field/correct {:answer/id #uuid "1ceb4f82-dd8f-5cfd-b3d5-52c2f5679fb5" :answer/type {:db/ident :answer.type/math} :answer/value "y+z" :db/id #edb/ref 17592186664936} :answer-field/id #uuid "31d029e9-caac-5a11-8ff4-aeea2ba85c7a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665281} {:answer-field/choices [{:answer/id #uuid "cff9681e-bc65-5748-914c-75a5ff087bbb" :answer/type {:db/ident :answer.type/math} :answer/value "x+y" :db/id #edb/ref 17592186665191}] :answer-field/correct {:answer/id #uuid "cff9681e-bc65-5748-914c-75a5ff087bbb" :answer/type {:db/ident :answer.type/math} :answer/value "x+y" :db/id #edb/ref 17592186665191} :answer-field/id #uuid "d52da4f3-5957-5445-9b24-82c34e38b0ed" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665343}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5d6110c8-6ffb-5830-a09c-4f21fa4ef8b5" :question/math-academy-id "q-264812" :question/problem "Given the function $f(x,y,z)=xy+yz+xz,$ compute ${∇}_{x,z}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{x,z}\\,f$, we take partial derivatives with respect to $x$ and $z$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂}{∂x}(xy+yz+xz) & =y+z \\\\ \\frac{∂f}{∂z}=\\frac{∂}{∂z}(xy+yz+xz) & =x+y\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =\\begin{bmatrix}\\frac{∂f}{∂x} \\\\ \\frac{∂f}{∂z}\\end{bmatrix} \\\\  & =\\begin{bmatrix}y+z \\\\ x+y\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186665410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1657e53d-a51b-532f-bd57-04cf9c9b6409" :answer/type {:db/ident :answer.type/math} :answer/value "yz" :db/id #edb/ref 17592186664926}] :answer-field/correct {:answer/id #uuid "1657e53d-a51b-532f-bd57-04cf9c9b6409" :answer/type {:db/ident :answer.type/math} :answer/value "yz" :db/id #edb/ref 17592186664926} :answer-field/id #uuid "29416c83-e7da-59a8-9ab3-ee6c38a85286" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665275} {:answer-field/choices [{:answer/id #uuid "a582247e-69e1-5184-b2fc-b8dae3b61420" :answer/type {:db/ident :answer.type/math} :answer/value "xz+zw" :db/id #edb/ref 17592186665123}] :answer-field/correct {:answer/id #uuid "a582247e-69e1-5184-b2fc-b8dae3b61420" :answer/type {:db/ident :answer.type/math} :answer/value "xz+zw" :db/id #edb/ref 17592186665123} :answer-field/id #uuid "a48f0c76-dba7-5cab-878c-c2546d136c06" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665324}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "909da71f-6871-5305-bb80-1faeaab2be7a" :question/math-academy-id "q-264819" :question/problem "Given the function $f(x,y,z,w)=xyz+yzw,$ compute ${∇}_{x,y}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,y}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{x,y}\\,f$, we take partial derivatives with respect to $x$ and $y$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂}{∂x}(xyz+yzw) & =yz \\\\ \\frac{∂f}{∂y}=\\frac{∂}{∂y}(xyz+yzw) & =xz+zw\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,y}\\,f & =\\begin{bmatrix}\\frac{∂f}{∂x} \\\\ \\frac{∂f}{∂y}\\end{bmatrix} \\\\  & =\\begin{bmatrix}yz \\\\ xz+zw\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186665426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac489dee-9136-581a-b207-3951a0321c49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2y}{zw}" :db/id #edb/ref 17592186665132}] :answer-field/correct {:answer/id #uuid "ac489dee-9136-581a-b207-3951a0321c49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2y}{zw}" :db/id #edb/ref 17592186665132} :answer-field/id #uuid "1386fdad-cfde-500f-977c-cf4034d34ed4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665259} {:answer-field/choices [{:answer/id #uuid "2d6ea5e2-ef05-5447-8236-de1629b3c458" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x^{2}+y^{2}}{z^{2}w}" :db/id #edb/ref 17592186664954}] :answer-field/correct {:answer/id #uuid "2d6ea5e2-ef05-5447-8236-de1629b3c458" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x^{2}+y^{2}}{z^{2}w}" :db/id #edb/ref 17592186664954} :answer-field/id #uuid "1cb612fa-1499-5591-b55e-421972b488fd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665269}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c9f8b096-eaa9-5459-8d36-2b4f95417ec0" :question/math-academy-id "q-264823" :question/problem "Given the function $f(x,y,z,w)=\\frac{{x}^{2}+{y}^{2}}{zw}$, compute ${∇}_{y,z}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{y,z}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">\n{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{y,z}\\,f$, we take partial derivatives with respect to $y$ and $z$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}=\\frac{∂}{∂y}\\left(\\frac{{x}^{2}+{y}^{2}}{zw}\\right) & =\\frac{2y}{zw} \\\\ \\frac{∂f}{∂z}=\\frac{∂}{∂z}\\left(\\frac{{x}^{2}+{y}^{2}}{zw}\\right) & =-\\frac{{x}^{2}+{y}^{2}}{{z}^{2}w}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{y,z}\\,f & =\\begin{bmatrix}\\frac{∂f}{∂y} \\\\ \\frac{∂f}{∂z}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2y}{zw} \\\\ -\\frac{{x}^{2}+{y}^{2}}{{z}^{2}w}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186665440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac1d2b8a-88b7-5c98-acd8-d66c0e1728c9" :answer/type {:db/ident :answer.type/math} :answer/value "2zw" :db/id #edb/ref 17592186665131}] :answer-field/correct {:answer/id #uuid "ac1d2b8a-88b7-5c98-acd8-d66c0e1728c9" :answer/type {:db/ident :answer.type/math} :answer/value "2zw" :db/id #edb/ref 17592186665131} :answer-field/id #uuid "4b52a893-382b-55fc-9dd1-4036f81cbe18" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665292} {:answer-field/choices [{:answer/id #uuid "52c66239-7801-58d9-b8f4-af3b182b9757" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin(y)" :db/id #edb/ref 17592186664989}] :answer-field/correct {:answer/id #uuid "52c66239-7801-58d9-b8f4-af3b182b9757" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin(y)" :db/id #edb/ref 17592186664989} :answer-field/id #uuid "62cededa-4621-56f6-bbad-a048f98c323e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665300}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f1331713-6cb2-510c-b200-79fc9bb9f67e" :question/math-academy-id "q-365604" :question/problem "Given the function $f(x,y,z,w)=x\\operatorname{sin}⁡(y)+y{z}^{3}+z{w}^{2},$ compute ${∇}_{x,w}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">\n{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{x,w}\\,f$, we take partial derivatives with respect to $x$ and $w$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂}{∂x}(x\\operatorname{sin}⁡(y)+y{z}^{3}+z{w}^{2}) & =\\operatorname{sin}⁡(y) \\\\ \\frac{∂f}{∂w}=\\frac{∂}{∂w}(x\\operatorname{sin}⁡(y)+y{z}^{3}+z{w}^{2}) & =2zw\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,w}\\,f & =\\begin{bmatrix}\\frac{∂f}{∂x} \\\\ \\frac{∂f}{∂w}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{sin}⁡(y) \\\\ 2zw\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Computing Basic Subset Gradients"} {:db/id #edb/ref 17592186204086 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203859 :question/id #uuid "9599c265-6015-5ad4-b379-d72a67a1a475" :question/math-academy-id "e-17533" :question/problem "Given the function $f(x,y; a,b) = a - bx^{2}+y^3$, compute $\\nabla_{a,b} \\: f.$" :question/worked-solution "To compute $\\nabla_{a,b} \\: f$, we take partial derivatives with respect to $a$ and $b$.\n\n$$\n\\begin{array}{rl}\\displaystyle {\\displaystyle \\frac{\\partial  f}{\\partial  a}} & \\displaystyle  = {\\displaystyle \\frac{\\partial }{\\partial  a}} ( a - b {x}^{2} + {y}^{3} ) = 1 \\\\ \\displaystyle {\\displaystyle \\frac{\\partial  f}{\\partial  b}} & \\displaystyle  = {\\displaystyle \\frac{\\partial }{\\partial  b}} ( a - b {x}^{2} + {y}^{3} ) = - {x}^{2}\\end{array}\n$$\n\nTherefore, we obtain the following:\n$$\n\\begin{array}{rl}\\displaystyle {\\mathrm{\\nabla }}_{a , b} \\hspace{0.222em} f & \\displaystyle  = \\left[ \\begin{array}{c}\\displaystyle {\\displaystyle \\frac{\\partial  f}{\\partial  a}} \\\\ \\displaystyle {\\displaystyle \\frac{\\partial  f}{\\partial  b}}\\end{array} \\right] \\\\ \\displaystyle  & \\displaystyle  = \\left[ \\begin{array}{c}\\displaystyle 1 \\\\ \\displaystyle - {x}^{2}\\end{array} \\right]\\end{array}\n$$"} :knowledge-point/id #uuid "c6646d65-7c0f-56ae-995d-1de831893ab9" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/questions [{:db/id #edb/ref 17592186204560 :question/answer-fields [{:answer-field/id #uuid "1c8a42e6-ca31-5ff0-95d3-12c2104a5252" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186203323} {:answer-field/id #uuid "49e221f1-3be4-5395-97c1-ff3945472e20" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186203324}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c966be18-dee8-5854-8192-4cdab044476b" :question/math-academy-id "q-263487" :question/problem "Given the line