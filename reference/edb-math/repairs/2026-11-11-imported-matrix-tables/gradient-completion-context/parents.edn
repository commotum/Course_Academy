/blank} :db/id #edb/ref 17592186530256}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "15f52165-8151-599f-bfe3-492fccf77d4a" :question/math-academy-id "q-264843" :question/problem "Given the quadratic function $f(x;a,b)=a{x}^{2}+bx,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{2}+bx)={x}^{2} \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{2}+bx)=x\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =\\begin{bmatrix}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}^{2} \\\\ x\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5d3dbbf-c74a-5302-a34c-11e26c0c9270" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186530113}] :answer-field/correct {:answer/id #uuid "d5d3dbbf-c74a-5302-a34c-11e26c0c9270" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186530113} :answer-field/id #uuid "bd1fbb7b-a7c4-5bd5-b548-d2067e768875" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530355} {:answer-field/choices [{:answer/id #uuid "c01a522f-1682-539a-bef6-be335b8183a9" :answer/type {:db/ident :answer.type/math} :answer/value "xy" :db/id #edb/ref 17592186530060}]