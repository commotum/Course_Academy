f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =\\begin{bmatrix}\\frac{∂}{∂x}(xyz) \\\\ \\frac{∂}{∂z}(xyz)\\end{bmatrix}=\\begin{bmatrix}yz \\\\ xy\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $z$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}(yz)=0\\,\\, &  & \\frac{∂}{∂z}(yz)=y \\\\  & \\frac{∂}{∂x}(xy)=y\\,\\, &  & \\frac{∂}{∂z}(xy)=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}({∇}_{x,z}\\,f) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂x} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & y \\\\ y & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186665370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a86981e-29ef-53f1-94be-355946d92c3a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186665100}] :answer-field/correct {:answer/id #uuid "9a86981e-29ef-53f1-94be-355946d92c3a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186665100} :answer-field/id #uuid "19a08833-a23e-519b-bca5-afb64dbf0fbe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665265} {:answer-field/choices [{:answer/id #uuid "7a0db06e-3ec3-52be-a982-69bb9717d235" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186665051}] :answer-field/correct {:answer/id #uuid "7a0db06e-3ec3-52be-a982-69bb9717d235" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186665051} :answer-field/id #uuid "1e463f06-595a-5718-b5c8-c47422dfba58" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665271} {:answer-field/choices [{:answer/id #uuid "9acd4a36-905c-5146-8e35-454979a74ee9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186665101}] :answer-field/correct {:answer/id #uuid "9acd4a36-905c-5146-8e35-454979a74ee9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186665101} :answer-field/id #uuid "2cdb5e38-5b82-5c9a-a8eb-afbdecac1df0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665279} {:answer-field/choices [{:answer/id #uuid "2d25cfa1-cebb-51ef-a347-dcbaffc63d95" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186664952}] :answer-field/correct {:answer/id #uuid "2d25cfa1-cebb-51ef-a347-dcbaffc63d95" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186664952} :answer-field/id #uuid "ad8bac4e-cd63-5d17-8587-37b0a997c641" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665329}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2127a517-7dc0-5912-afe0-9dd738e3fd0c" :question/math-academy-id "q-264889" :question/problem "Given the function $f(x,y,z)=xy+yz+xz$, compute ${∇}_{y,z}({∇}_{y,z}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{y,z}({∇}_{y,z}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{y,z}\\,f & =\\begin{bmatrix}\\frac{∂}{∂y}(xy+yz+xz) \\\\ \\frac{∂}{∂z}(xy+yz+xz)\\end{bmatrix}=\\begin{bmatrix}x+z \\\\ x+y\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $y$ and $z$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂y}(x+z)=0\\,\\, &  & \\frac{∂}{∂z}(x+z)=1 \\\\  & \\frac{∂}{∂y}(x+y)=1\\,\\, &  & \\frac{∂}{∂z}(x+y)=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{y,z}({∇}_{y,z}\\,f) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{y}^{2}} & \\frac{{∂}^{2}f}{∂y∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂y} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186665373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5ae5311-035b-5f3f-af3a-a4de3c781a19" :answer/type {:db/ident :answer.type/math} :answer/value "2x_{2}^{2}" :db/id #edb/ref 17592186665175}] :answer-field/correct {:answer/id #uuid "c5ae5311-035b-5f3f-af3a-a4de3c781a19" :answer/type {:db/ident :answer.type/math} :answer/value "2x_{2}^{2}" :db/id #edb/ref 17592186665175} :answer-field/id #uuid "629fcda0-1602-5866-9bc2-988bfbf9d4a1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665299} {:answer-field/choices [{:answer/id #uuid "b489d0e0-4fb2-5089-b76c-b91759ddac88" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186665147}] :answer-field/correct {:answer/id #uuid "b489d0e0-4fb2-5089-b76c-b91759ddac88" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186665147} :answer-field/id #uuid "a3968005-d9c5-5958-a430-b85129bf8a03" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186665323}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "29d7492f-d01b-5afa-9cf2-143780523277" :question/math-academy-id "q-264901" :question/problem "Given the function $f(x;w)={w}_{1}^{2}{x}_{2}^{2}-{w}_{2}{x}_{1}$, compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"40px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">{{field-1}}</td>\n<td align=\"center\" width=\"50px\">$0$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}^{2}{x}_{2}^{2}-{w}_{2}{x}_{1})=2{w}_{1}{x}_{2}^{2} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}^{2}{x}_{2}^{2}-{w}_{2}{x}_{1})=-{x}_{1}\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{x}_{2}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=0 \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=0\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{x}_{2}^{2} & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186665395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c5f33b5-37a2-5