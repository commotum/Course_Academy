2x)=0 \\\\  & \\frac{∂}{∂x}(2z)=0\\,\\, &  & \\frac{∂}{∂z}(2z)=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}({∇}_{x,z}\\,f) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂x} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a961726f-d2e5-5c4e-aa58-b8b021e50fd5" :answer/type {:db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530000}] :answer-field/correct {:answer/id #uuid "a961726f-d2e5-5c4e-aa58-b8b021e50fd5" :answer/type {:db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530000} :answer-field/id #uuid "44a70234-afbd-5b95-b6d0-57f5d9b17da8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530268} {:answer-field/choices [{:answer/id #uuid "b9887375-d8c7-5b8f-8932-603f171ad7b5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186530046}] :answer-field/correct {:answer/id #uuid "b9887375-d8c7-5b8f-8932-603f171ad7b5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186530046} :answer-field/id #uuid "54132b05-6b53-5a59-a55a-32250c5ba899" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530280} {:answer-field/choices [{:answer/id #uuid "0e1601a7-b20b-5f51-9f9a-5b71e91349ba" :answer/type {:db/ident :answer.type/math} :answer/value "xz^2e^{yz}" :db/id #edb/ref 17592186529606}] :answer-field/correct {:answer/id #uuid "0e1601a7-b20b-5f51-9f9a-5b71e91349ba" :answer/type {:db/ident :answer.type/math} :answer/value "xz^2e^{yz}" :db/id #edb/ref 17592186529606} :answer-field/id #uuid "7075f514-a4aa-5bcc-8c11-8e3071322458" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530303} {:answer-field/choices [{:answer/id #uuid "c3559be5-9ddd-5be3-86e4-201b8acfad49" :answer/type {:db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530069}] :answer-field/correct {:answer/id #uuid "c3559be5-9ddd-5be3-86e4-201b8acfad49" :answer/type {:db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530069} :answer-field/id #uuid "c27b4e5d-55a0-5453-9ef5-40b4c02e0023" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530358}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ef911a6f-8eaa-541f-ada4-10af4c9994c6" :question/math-academy-id "q-264888" :question/problem "Given the function $f(x,y,z)=x{e}^{yz}$, compute ${∇}_{x,y}({∇}_{x,y}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,y}({∇}_{x,y}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,y}\\,f & =\\begin{bmatrix}\\frac{∂}{∂x}(x{e}^{yz}) \\\\ \\frac{∂}{∂y}(x{e}^{yz})\\end{bmatrix}=\\begin{bmatrix}{e}^{yz} \\\\ xz{e}^{yz}\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $y$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}({e}^{yz})=0\\,\\, &  & \\frac{∂}{∂y}({e}^{yz})=z{e}^{yz} \\\\  & \\frac{∂}{∂x}(xz{e}^{yz})=z{e}^{yz}\\,\\, &  & \\frac{∂}{∂y}(xz{e}^{yz})=x{z}^{2}{e}^{yz}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,y}({∇}_{x,y}\\,f) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & z{e}^{yz} \\\\ z{e}^{yz} & x{z}^{2}{e}^{yz}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc3299c1-7141-5be7-bfe9-a4da090cb231" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186539905}] :answer-field/correct {:answer/id #uuid "fc3299c1-7141-5be7-bfe9-a4da090cb231" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186539905} :answer-field/id #uuid "a75257c9-8063-572f-b90b-975bf7853ddd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539979} {:answer-field/choices [{:answer/id #uuid "d58aa4b3-dfec-58ba-9003-5a0d9d8feceb" :answer/type {:db/ident :answer.type/math} :answer/value "2w_2x_2^2" :db/id #edb/ref 17592186539842}] :answer-field/correct {:answer/id #uuid "d58aa4b3-dfec-58ba-9003-5a0d9d8feceb" :answer/type {:db/ident :answer.type/math} :answer/value "2w_2x_2^2" :db/id #edb/ref 17592186539842} :answer-field/id #uuid "eaa3fc51-52ac-520e-88d7-534ea602e135" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540009}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "869ee47c-102a-5b9f-9e3a-e75445c641bf" :question/math-academy-id "q-264896" :question/problem "Given the function $f(x;w)={w}_{2}({w}_{1}{x}_{2}-{x}_{1})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">$2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})$</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2})^{2}=2{w}_{2}{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2})^{2}=({w}_{1}{x}_{2}-{x}_{1})^{2}\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{w}_{2}{x}_{2}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{w}_{2}{x}_{2}^{2} & 2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\ 2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6be170-22a5-50c2-b423-ef63a5649a71" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186539502}] :answer-field/correct {:answer/id #uuid "0b6be170-22a5-50c2-b423-ef63a5649a71" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186539502} :answer-field/id #uuid "29c11c41-4251-59f9-a07b-6dd2357b05fe" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/