\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}z}{\\text{d}t}\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{-t})\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({e}^{2t})\\mathbf{j} \\\\  & =-{e}^{-t}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}+2{e}^{2t}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =({e}^{t}\\hspace{0.167em}\\mathbf{i}+{e}^{-t}\\hspace{0.167em}\\mathbf{j}+{e}^{2t}\\hspace{0.167em}\\mathbf{k})\\cdot (-{e}^{-t}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}+2{e}^{2t}\\hspace{0.167em}\\mathbf{k}) \\\\  & =-1+1+2{e}^{4t} \\\\  & =2{e}^{4t}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{1}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}2{e}^{4t}\\hspace{0.167em}\\mathrm{d}t \\\\  & ={\\frac{{e}^{4t}}{2}|}_{0}^{1} \\\\  & =\\frac{{e}^{4}-1}{2}\\end{aligned}\n$$"] [17592186259715 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t\\operatorname{sin}⁡t,\\,y=t\\operatorname{cos}⁡t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =x\\hspace{0.167em}\\mathbf{i}+y\\hspace{0.167em}\\mathbf{j} \\\\  & =t\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+t\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}t)\\mathbf{j} \\\\  & =(\\operatorname{sin}t+t\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{i}+(\\operatorname{cos}t-t\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(t\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+t\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j})\\cdot ((\\operatorname{sin}t+t\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{i}+(\\operatorname{cos}t-t\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{j}) \\\\  & =t\\operatorname{sin}t(\\operatorname{sin}t+t\\operatorname{cos}t)+t\\operatorname{cos}t(\\operatorname{cos}t-t\\operatorname{sin}t) \\\\  & =t{\\operatorname{sin}}^{2}t+{t}^{2}\\operatorname{sin}t\\operatorname{cos}t+t{\\operatorname{cos}}^{2}t-{t}^{2}\\operatorname{sin}t\\operatorname{cos}t \\\\  & =t({\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t) \\\\  & =t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{f}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }t\\hspace{0.167em}\\mathrm{d}t \\\\  & =\\frac{{t}^{2}}{2}\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =\\frac{(2\\pi )^{2}}{2}-0 \\\\  & =2{\\pi }^{2}\\end{aligned}\n$$"] [17592186259716 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t,\\,y={t}^{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{j} \\\\  & ={t}^{2}\\hspace{0.167em}\\mathbf{i}+t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\mathbf{j} \\\\  & =\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =({t}^{2}\\hspace{0.167em}\\mathbf{i}+t\\hspace{0.167em}\\mathbf{j})\\cdot (\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}) \\\\  & ={t}^{2}\\cdot 1+t\\cdot 2t \\\\  & =3{t}^{2}.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{1}\\mathbf{f}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}3{t}^{2}\\hspace{0.167em}\\mathrm{d}t \\\\  & ={[{t}^{3}]}_{0}^{1} \\\\  & =[1-0] \\\\  & =1\\end{aligned}\n$$"] [17592186259717 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=2{e}^{t},\\,y=3{e}^{2t},\\,z={e}^{-2t}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =x\\hspace{0.167em}\\mathbf{i}+z\\hspace{0.167em}\\mathbf{j}+y\\hspace{0.167em}\\mathbf{k} \\\\  & =2{e}^{t}\\hspace{0.167em}\\mathbf{i}+{e}^{-2t}\\hspace{0.167em}\\mathbf{j}+3{e}^{2t}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}z}{\\text{d}t}\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{e}^{t})\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(3{e}^{2t})\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({e}^{-2t})\\mathbf{j} \\\\  & =2{e}^{t}\\mathbf{i}+6{e}^{2t}\\hspace{0.167em}\\mathbf{j}-2{e}^{-2t}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(2{e}^{t}\\hspace{0.167em}\\mathbf{i}+{e}^{-2t}\\hspace{0.167em}\\mathbf{j}+3{e}^{2t}\\hspace{0.167em}\\mathbf{k})\\cdot (2{e}^{t}\\mathbf{i}+6{e}^{2t}\\hspace{0.167em}\\mathbf{j}-2{e}^{-2t}\\hspace{0.167em}\\mathbf{k}) \\\\  & =4{e}^{2t}+6-6 \\\\  & =4{e}^{2t}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{1}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}4{e}^{2t}\\hspace{0.167em}\\mathrm{d}t \\\\  & =2{e}^{2t}{|}_{0}^{1} \\\\  & =2{e}^{2}-2\\end{aligned}\n$$"] [17592186259718 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx={t}^{2},\\,y=t-1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =\\frac{y+1}{x}\\hspace{0.167em}\\mathbf{i}-\\frac{2(x-1)}{y}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{(t-1)+1}{{t}^{2}}\\hspace{0.167em}\\mathbf{i}-\\frac{2({t}^{2}-1)}{t-1}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}-2(t+1)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t-1)\\mathbf{j} \\\\  & =2t\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}-2(t+1)\\hspace{0.167em}\\mathbf{j})\\cdot (2t\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}) \\\\  & =\\frac{1}{t}\\cdot 2t-2(t+1)\\cdot 1 \\\\  & =2-2(t+1)\\cdot 1 \\\\  & =-2t.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{3}^{4}\\mathbf{f}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{3}^{4}(-2t)\\hspace{0.167em}\\mathrm{d}t \\\\  & ={[-{t}^{2}]}_{3}^{4} \\\\  & =[-16+9] \\\\  & =-7\\end{aligned}\n$$"] [17592186259726 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y,z)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{j}+\\frac{∂f}{∂z}\\hspace{0.167em}\\mathbf{k}.\n$$\n\nSince $\\mathrm{∇}f(x,y,z)=\\mathbf{F}(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=2xz+\\operatorname{sin}⁡y,\\,\\frac{∂f}{∂y}=x\\operatorname{cos}⁡y,\\,\\frac{∂f}{∂z}={x}^{2}\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (2xz+\\operatorname{sin}⁡y)\\,\\text{d}x \\\\  & ={x}^{2}z+x\\operatorname{sin}⁡y+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x\\operatorname{cos}⁡y+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=x\\operatorname{cos}⁡y$ into account, we obtain\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡y+\\frac{∂g}{∂y} & =x\\operatorname{cos}⁡y \\\\ \\frac{∂g}{∂y} & =0\\end{aligned}\n$$\n\nNow, we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int 0\\,\\text{d}y \\\\  & =h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)={x}^{2}z+x\\operatorname{sin}⁡y+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}={x}^{2}+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}={x}^{2}$ into account, we obtain\n\n$$\n\\begin{aligned}{x}^{2} & ={x}^{2}+{h}^{′}(z) \\\\ {h}^{′}(z) & =0 \\\\ h(z) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)={x}^{2}z+x\\operatorname{sin}⁡y+C.\n$$"] [17592186259727 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y,z)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{\\text{i}}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{\\text{j}}+\\frac{∂f}{∂z}\\hspace{0.167em}\\mathbf{\\text{k}}.\n$$\n\nSince $\\mathrm{∇}f(x,y,z)=\\mathbf{F}(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}={y}^{2}{z}^{3}-{e}^{z},\\,\\frac{∂f}{∂y}=2xy{z}^{3},\\,\\frac{∂f}{∂z}=3x{y}^{2}{z}^{2}-x{e}^{z}\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int ({y}^{2}{z}^{3}-{e}^{z})\\,\\text{d}x \\\\  & =x{y}^{2}{z}^{3}-x{e}^{z}+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=2xy{z}^{3}+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=2xy{z}^{3}$ into account, we obtain\n\n$$\n\\begin{aligned}2xy{z}^{3}+\\frac{∂g}{∂y} & =2xy{z}^{3} \\\\ \\frac{∂g}{∂y} & =0\\end{aligned}\n$$\n\nNow we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int 0\\,\\text{d}y \\\\  & =h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)=x{y}^{2}{z}^{3}-x{e}^{z}+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}=3x{y}^{2}{z}^{2}-x{e}^{z}+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}=3x{y}^{2}{z}^{2}-x{e}^{z}$ into account, we obtain\n\n$$\n\\begin{aligned}3x{y}^{2}{z}^{2}-x{e}^{z}+{h}^{′}(z) & =3x{y}^{2}{z}^{2}-x{e}^{z} \\\\ {h}^{′}(z) & =0 \\\\ h(z) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=x{y}^{2}{z}^{3}-x{e}^{z}+C.\n$$"] [17592186259730 "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,y-x\\ge 0}$ is simply connected. Indeed, it is the half-plane $y\\ge x.$ So,   it's a plane region without holes,\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>1}$ is *not* simply connected since it's a plane region with a hole (containing all points of the circle ${x}^{2}+{y}^{2}\\le 1$).\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,y+x\\ne 0}$ is *not* simply connected. The region contains all the points of ${\\mathbb{R}}^{2}$ except those on the straight line $y=-x.$ Thus, the region is formed by two disjoint half-planes and, therefore, is not even a connected region.\n\nTherefore, the correct answer is ${(x,y)\\in {R}^{2}\\,|\\,y-x\\ge 0}$ only."] [17592186259731 "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4}$ is *not* simply connected. The region contains all the points of ${\\mathbb{R}}^{2}$ except those on the ellipse ${x}^{2}+{y}^{2}=4.$ Thus, the region is formed by two disjoint pieces and, therefore, is not even a connected region.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 1}$  is simply connected. It's a plane region without holes.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,xy\\ne 0}$ is *not* simply connected.  The region contains all the points of ${\\mathbb{R}}^{2}$ except those on the coordinate axes.  Thus, the region is formed by four disjoint pieces and, therefore, is not even a connected region.\n\nTherefore, the correct answer is ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 1}$ only."] [17592186259803 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then $$\n\\displaystyle {∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}>0.\n$$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then $$\n\\displaystyle {∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}<0.\n$$\n\nWith that in mind, let's check each statement.\n\n- Statement $$\n\\displaystyle {∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}>0\n$$ is false, while statement $$\n\\displaystyle {∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}=0\n$$ is true. Since the force $\\mathbf{F}$ acts perpendicular to the motion of the particle as it moves around $C,$ it neither helps nor hinders its motion. \n\n![](images/eb/eb4da8143700c7d31e0ceacd09ac76a8d1bcb10379a34dce5b59d48f2ae58c13.png)\n\nSo, $$\n\\displaystyle {∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}=0.\n$$\n\n- Statement $$\n\\displaystyle {∮}_{-C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}>0\n$$ is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $\\mathbf{F}$ remains unchanged.\n\n![](images/70/70a473397216589350f63482ab3e36cb1247e7825046c70642254c8514564b00.png)\n\nSo, $$\n\\displaystyle {∮}_{-C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}=0.\n$$\n\nTherefore, the correct answer is $$\n\\displaystyle {∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}=0\n$$ only."] [17592186259804 "Given a piecewise-smooth path $C$ and a vector field \n\n$$\n\\mathbf{F}(x,y,z)=P(x,y,z)\\hspace{0.167em}\\mathbf{i}+Q(x,y,z)\\hspace{0.167em}\\mathbf{j}+R(x,y,z)\\hspace{0.167em}\\mathbf{k}\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{C}P(x,y,z)\\hspace{0.167em}\\text{d}x+Q(x,y,z)\\hspace{0.167em}\\text{d}y+R(x,y,z)\\hspace{0.167em}\\text{d}z.\n$$\n\nTherefore, in our case, we obtain \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{C}2z\\hspace{0.167em}\\text{d}x+3x\\hspace{0.167em}\\text{d}y-4y\\hspace{0.167em}\\text{d}z.\\end{aligned}\n$$"] [17592186259805 "Given a piecewise-smooth path $C$ and a vector field \n\n$$\n\\mathbf{F}(x,y)=P(x,y)\\hspace{0.167em}\\mathbf{i}+Q(x,y)\\hspace{0.167em}\\mathbf{j}\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{C}P(x,y)\\hspace{0.167em}\\text{d}x+Q(x,y)\\hspace{0.167em}\\text{d}y.\n$$\n\nTherefore, in our case, we obtain \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{C}(x-3y)\\hspace{0.167em}\\text{d}x+2\\hspace{0.167em}\\text{d}y.\\end{aligned}\n$$"] [17592186259806 "Given a piecewise-smooth path $C$ and a vector field \n\n$$\n\\mathbf{F}(x,y)=P(x,y)\\hspace{0.167em}\\mathbf{i}+Q(x,y)\\hspace{0.167em}\\mathbf{j}\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{C}P(x,y)\\hspace{0.167em}\\text{d}x+Q(x,y)\\hspace{0.167em}\\text{d}y.\n$$\n\nTherefore, in our case, we obtain \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{C}4\\hspace{0.167em}\\text{d}x-(2y-3x)\\hspace{0.167em}\\text{d}y.\\end{aligned}\n$$"] [17592186259807 "Given a piecewise-smooth path $C$ and a vector field \n\n$$\n\\mathbf{F}(x,y,z)=P(x,y,z)\\hspace{0.167em}\\mathbf{i}+Q(x,y,z)\\hspace{0.167em}\\mathbf{j}+R(x,y,z)\\hspace{0.167em}\\mathbf{k}\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{C}P\\hspace{0.167em}\\text{d}x+Q\\hspace{0.167em}\\text{d}y+R\\hspace{0.167em}\\text{d}z\n$$\n\nIn our case, $P={x}^{2},Q=-y,R=2z.$ Therefore\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}\\hspace{0.167em}\\mathbf{i}-y\\hspace{0.167em}\\mathbf{j}+2z\\hspace{0.167em}\\mathbf{k})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{C}{x}^{2}\\hspace{0.167em}\\text{d}x-y\\hspace{0.167em}\\text{d}y+2z\\hspace{0.167em}\\text{d}z.\\end{aligned}\n$$\n\nSo, $\\mathbf{F}={x}^{2}\\hspace{0.167em}\\mathbf{i}-y\\hspace{0.167em}\\mathbf{j}+2z\\hspace{0.167em}\\mathbf{k}.$"] [17592186259808 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =-y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{j} \\\\  & =-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{j} \\\\  & =-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j})\\cdot (-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}) \\\\  & =-\\operatorname{sin}t\\cdot (-2\\operatorname{sin}t)+2\\operatorname{cos}t\\cdot \\operatorname{cos}t \\\\  & =2{\\operatorname{sin}}^{2}t+2{\\operatorname{cos}}^{2}t \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }2\\hspace{0.278em}\\text{d}t \\\\  & =2t\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =2(2\\pi )-0 \\\\  & =4\\pi \\end{aligned}\n$$"] [17592186259809 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\sqrt{3}\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}-x\\hspace{0.167em}\\mathbf{j} \\\\  & =\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}-\\sqrt{3}\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{3}\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{j} \\\\  & =-\\sqrt{3}\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}-\\sqrt{3}\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j})\\cdot (-\\sqrt{3}\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}) \\\\  & =\\operatorname{sin}t\\cdot (-\\sqrt{3}\\operatorname{sin}t)-\\sqrt{3}\\operatorname{cos}t\\cdot \\operatorname{cos}t \\\\  & =-\\sqrt{3}{\\operatorname{sin}}^{2}t-\\sqrt{3}{\\operatorname{cos}}^{2}t \\\\  & =-\\sqrt{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-\\sqrt{3})\\hspace{0.278em}\\text{d}t \\\\  & =-\\sqrt{3}t\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =-\\sqrt{3}(2\\pi )-0 \\\\  & =-2\\pi \\sqrt{3}\\end{aligned}\n$$"] [17592186259810 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =x\\hspace{0.167em}\\mathbf{i}+y\\hspace{0.167em}\\mathbf{j} \\\\  & =2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{j} \\\\  & =-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j})\\cdot (-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}) \\\\  & =2\\operatorname{cos}t\\cdot (-2\\operatorname{sin}t)+3\\operatorname{sin}t\\cdot 3\\operatorname{cos}t \\\\  & =5\\operatorname{sin}t\\operatorname{cos}t\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }5\\operatorname{sin}t\\operatorname{cos}t\\hspace{0.278em}\\text{d}t \\\\  & =\\frac{5}{2}{\\int }_{0}^{2\\pi }2\\operatorname{sin}t\\operatorname{cos}t\\hspace{0.278em}\\text{d}t \\\\  & =\\frac{5}{2}{\\int }_{0}^{2\\pi }\\operatorname{sin}2t\\hspace{0.278em}\\text{d}t \\\\  & =\\frac{5}{2}\\left(\\frac{-\\operatorname{cos}2t}{2}\\right)\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =\\frac{5}{4}(-1+1) \\\\  & =0\\end{aligned}\n$$"]}
