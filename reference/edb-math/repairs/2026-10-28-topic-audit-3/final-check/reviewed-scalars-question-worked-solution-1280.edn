} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}-2+{t}^{2}+4} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}+2+{t}^{2}} \\\\  & =\\sqrt{{(\\frac{1}{t}+t)}^{2}} \\\\  & =\\frac{1}{t}+t\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{e}‖{\\mathbf{g}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{1}^{e}(\\frac{1}{t}+t)\\hspace{0.167em}\\text{d}t \\\\  & =(\\operatorname{ln}t+\\frac{{t}^{2}}{2}){|}_{1}^{e} \\\\  & =(\\operatorname{ln}e+\\frac{{e}^{2}}{2})-(\\operatorname{ln}1+\\frac{{1}^{2}}{2}) \\\\  & =1+\\frac{{e}^{2}}{2}-0-\\frac{1}{2} \\\\  & =\\frac{{e}^{2}+1}{2}.\\end{aligned}\n$$"] [17592186345272 "First, we find ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}t+\\operatorname{cos}t),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}t-\\operatorname{sin}t)\\hspace{0.222em}⟩ \\\\  & =⟨t\\operatorname{cos}t,\\hspace{0.222em}-t\\operatorname{sin}t⟩ \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{(t\\operatorname{cos}t)}^{2}+{(-t\\operatorname{sin}t)}^{2}} \\\\  & =\\sqrt{{t}^{2}{\\operatorname{sin}}^{2}t+{t}^{2}{\\operatorname{cos}}^{2}t} \\\\  & =\\sqrt{{t}^{2}} \\\\  & =t\\end{aligned}\n$$\n\nNotice that $t\\ge 0$ for $t\\in [0,2].$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{2}t\\hspace{0.167em}\\text{d}t \\\\  & ={\\left(\\frac{{t}^{2}}{2}\\right)|}_{0}^{2} \\\\  & =2.\\end{aligned}\n$$"] [17592186345273 "First, notice that we can represent $C,$ which is traversed in counterclockwise, as the union of $3$ paths: \n\n$$\nC={C}_{1}\\cup \\{-{C}_{2}\\}\\cup \\{-{C}_{3}\\},\n$$\n\nwhere $-{C}_{2}$ and $-{C}_{3}$ are the same paths as ${C}_{2}$ and ${C}_{3}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{-{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{-{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}-{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}-{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\\end{aligned}\n$$"] [17592186345274 "First, notice that we can represent $C,$ which is traversed clockwise, as the union of $3$ paths:\n\n$$\nC={C}_{1}\\cup \\{-{C}_{2}\\}\\cup \\{-{C}_{3}\\},\n$$\n\nwhere $-{C}_{2}$ and $-{C}_{3}$ are the same paths as ${C}_{2}$ and ${C}_{3}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{-{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{-{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}-{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}-{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\\end{aligned}\n$$"] [17592186345275 "First, notice that we can represent $C,$ which is traversed in clockwise, as the union of $3$ paths:\n\n$$\nC=\\{-{C}_{1}\\}\\cup {C}_{2}\\cup {C}_{3},\n$$\n\nwhere $-{C}_{1}$ is the same path as ${C}_{1}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{-{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & =-{\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\\end{aligned}\n$$"] [17592186345276 "First, notice that we can represent $C,$ which is traversed in counterclockwise, as the union of $3$ paths:\n\n$$\nC=\\{-{C}_{1}\\}\\cup \\{-{C}_{2}\\}\\cup {C}_{3},\n$$\n\nwhere $-{C}_{1}$ and $-{C}_{2}$ are the same paths as ${C}_{1}$ and ${C}_{2}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{-{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{-{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & =-{\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}-{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\\end{aligned}\n$$"] [17592186345277 "First, notice that we can represent $C,$ which is traversed in counterclockwise, as the union of $3$ paths:\n\n$$\nC={C}_{1}\\cup \\{-{C}_{2}\\}\\cup {C}_{3},\n$$\n\nwhere $-{C}_{2}$ is the same path as ${C}_{2}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{-{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}-{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\\end{aligned}\n$$"] [17592186345278 "We know that $\\mathbf{u}⊥\\mathbf{v}$ ($\\mathbf{u}$ and $\\mathbf{v}$ are perpendicular) if and only if $\\mathbf{u}\\cdot \\mathbf{v}=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}\\mathbf{u}\\cdot \\mathbf{v} & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =a\\cdot a+2\\cdot (-4)+4\\cdot (-2) \\\\  & ={a}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}\\mathbf{u}\\cdot \\mathbf{v} & =0 \\\\ {a}^{2}-16 & =0 \\\\ {a}^{2} & =16 \\\\ a & =\\pm 4\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-4.$"] [17592186345283 "We will use the fact that\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\n$$\n\nWe're given the value of the first integral, so we only need to work out the second.\n\nThe path ${C}_{2}$ is the line segment from $B$ to $O.$ It can be parametrized as\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{2}(t) & =\\mathbf{b}+t(\\mathbf{0}-\\mathbf{b}) \\\\  & =⟨1,1⟩+t(⟨0,0⟩-⟨1,1⟩) \\\\  & =⟨1-t,1-t⟩ \\\\  & =(1-t)\\hspace{0.167em}\\mathbf{i}+(1-t)\\hspace{0.167em}\\mathbf{j},\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=1-t$ and $y=1-t.$ Therefore, \n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{2}(t)) & =(2x+y)\\hspace{0.167em}\\mathbf{i}+(x-2y)\\hspace{0.167em}\\mathbf{j} \\\\  & =(2(1-t)+(1-t))\\hspace{0.167em}\\mathbf{i}+((1-t)-2(1-t))\\hspace{0.167em}\\mathbf{j} \\\\  & =(3-3t)\\hspace{0.167em}\\mathbf{i}+(-1+t)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{2}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(1-t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(1-t)\\mathbf{j} \\\\  & =-\\mathbf{i}-\\mathbf{j}\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{2}(t))\\cdot {\\mathbf{r}}_{2}^{'}(t) & =((3-3t)\\hspace{0.167em}\\mathbf{i}+(-1+t)\\hspace{0.167em}\\mathbf{j})\\cdot (-\\mathbf{i}-\\mathbf{j}) \\\\  & =-3+3t+1-t \\\\  & =-2+2t\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & =2+{\\int }_{0}^{1}\\mathbf{F}({\\mathbf{r}}_{\\mathbf{2}}(t))\\cdot {\\mathbf{r}}_{2}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & =2+{\\int }_{0}^{1}(-2+2t)\\hspace{0.167em}\\text{d}t \\\\  & =2+(-2t+{t}^{2})\\hspace{0.167em}{|}_{0}^{1} \\\\  & =2+(1-2) \\\\  & =1\\end{aligned}\n$$"] [17592186345284 "We will use the fact that\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\n$$\n\nWe're given the value of the second integral, so we only need to work out the first.\n\nThe path ${C}_{1}$ is the horizontal line segment from $O$ to $A.$ It can be parametrized as\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{1}(t) & =\\mathbf{0}+t(\\mathbf{a}-\\mathbf{0}) \\\\  & =⟨0,0⟩+t(⟨1,0⟩-⟨0,0⟩) \\\\  & =⟨t,0⟩ \\\\  & =t\\hspace{0.167em}\\mathbf{i},\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=t$ and $y=0.$ Therefore, \n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{1}(t)) & =({x}^{2}+y)\\hspace{0.167em}\\mathbf{i}+(x-{y}^{2})\\hspace{0.167em}\\mathbf{j} \\\\  & =({t}^{2}+0)\\hspace{0.167em}\\mathbf{i}+(t-{0}^{2})\\hspace{0.167em}\\mathbf{j} \\\\  & ={t}^{2}\\hspace{0.167em}\\mathbf{i}+t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{1}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(0)\\mathbf{j} \\\\  & =\\mathbf{i}\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{1}(t))\\cdot {\\mathbf{r}}_{1}^{'}(t) & =({t}^{2}\\hspace{0.167em}\\mathbf{i}+t\\hspace{0.167em}\\mathbf{j})\\cdot (\\mathbf{i}) \\\\  & ={t}^{2}\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & ={\\int }_{0}^{1}\\mathbf{F}({\\mathbf{r}}_{\\mathbf{1}}(t))\\cdot {\\mathbf{r}}_{1}^{'}(t)\\hspace{0.167em}\\text{d}t+\\frac{7}{3} \\\\  & ={\\int }_{0}^{1}{t}^{2}\\hspace{0.167em}\\text{d}t+\\frac{7}{3} \\\\  & =\\frac{1}{3}{t}^{3}\\hspace{0.167em}{|}_{0}^{1}+\\frac{7}{3} \\\\  & =(\\frac{1}{3}-0)+\\frac{7}{3} \\\\  & =\\frac{1}{3}+\\frac{7}{3} \\\\  & =\\frac{8}{3}\\end{aligned}\n$$"] [17592186345285 "We will use the fact that\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\n$$\n\nWe're given the value of the first integral, so we only need to work out the second.\n\nThe path ${C}_{2}$ is the vertical line segment from $B$ to $D.$ It can be parametrized as\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{2}(t) & =\\mathbf{b}+t(\\mathbf{d}-\\mathbf{b}) \\\\  & =⟨-1,2⟩+t(⟨-1,0⟩-⟨-1,2⟩) \\\\  & =⟨-1,2-2t⟩ \\\\  & =-\\hspace{0.167em}\\mathbf{i}+(2-2t)\\hspace{0.167em}\\mathbf{j},\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=-1$ and $y=2-2t.$ Therefore, \n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{2}(t)) & =(x-y)\\hspace{0.167em}\\mathbf{i}+(y-x)\\hspace{0.167em}\\mathbf{j} \\\\  & =(-1-(2-2t))\\hspace{0.167em}\\mathbf{i}+(2-2t-(-1))\\hspace{0.167em}\\mathbf{j} \\\\  & =(-3+2t)\\hspace{0.167em}\\mathbf{i}+(3-2t)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{2}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(-1)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(2-2t)\\mathbf{j} \\\\  & =-2\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{2}(t))\\cdot {\\mathbf{r}}_{2}^{'}(t) & =((-3+2t)\\hspace{0.167em}\\mathbf{i}+(3-2t)\\hspace{0.167em}\\mathbf{j})\\cdot (-2\\hspace{0.167em}\\mathbf{j}) \\\\  & =(3-2t)\\cdot (-2) \\\\  & =4t-6\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & =-\\frac{7}{2}+{\\int }_{0}^{1}\\mathbf{F}({\\mathbf{r}}_{\\mathbf{2}}(t))\\cdot {\\mathbf{r}}_{2}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & =-\\frac{7}{2}+{\\int }_{0}^{1}(4t-6)\\hspace{0.167em}\\text{d}t \\\\  & =-\\frac{7}{2}+[2{t}^{2}-6t]_{0}^{1} \\\\  & =-\\frac{7}{2}+[2({1}^{2})-6(1)-0] \\\\  & =-\\frac{7}{2}-4 \\\\  & =-\\frac{15}{2}\\end{aligned}\n$$"] [17592186345286 "We will use the fact that\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\n$$\n\nWe're given the value of the second integral, so we only need to work out the first.\n\nThe path ${C}_{1}$ is the line segment from $A$ to $B.$  It can be parametrized as\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{1}(t) & =\\mathbf{a}+t(\\mathbf{b}-\\mathbf{a}) \\\\  & =⟨-2,0⟩+t(⟨0,1⟩-⟨-2,0⟩) \\\\  & =⟨-2+2t,t⟩ \\\\  & =(-2+2t)\\mathbf{i}+t\\hspace{0.167em}\\mathbf{j},\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=-2+2t$ and $y=t.$ Therefore, \n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{1}(t)) & =(x-2y)\\hspace{0.167em}\\mathbf{i}+(y-x)\\hspace{0.167em}\\mathbf{j} \\\\  & =((-2+2t)-2t)\\hspace{0.167em}\\mathbf{i}+(t-(-2+2t))\\hspace{0.167em}\\mathbf{j} \\\\  & =-2\\hspace{0.167em}\\mathbf{i}+(2-t)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{1}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(-2+2t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{j} \\\\  & =2\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{1}(t))\\cdot {\\mathbf{r}}_{1}^{'}(t) & =(-2\\hspace{0.167em}\\mathbf{i}+(2-t)\\hspace{0.167em}\\mathbf{j})\\cdot (2\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}) \\\\  & =-2-t\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & ={\\int }_{0}^{1}\\mathbf{F}({\\mathbf{r}}_{\\mathbf{1}}(t))\\cdot {\\mathbf{r}}_{1}^{'}(t)\\hspace{0.167em}\\text{d}t+\\left(-\\frac{3}{2}\\right) \\\\  & ={\\int }_{0}^{1}(-2-t)\\hspace{0.167em}\\text{d}t-\\frac{3}{2} \\\\  & ={[-2t-\\frac{{t}^{2}}{2}]}_{0}^{1}-\\frac{3}{2} \\\\  & =[-2(1)-\\frac{{1}^{2}}{2}-0]-\\frac{3}{2} \\\\  & =-\\frac{5}{2}-\\frac{3}{2} \\\\  & =-4\\end{aligned}\n$$"] [17592186345287 "First, we find ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(6t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(-\\frac{3}{t}-{t}^{3})⟩ \\\\  & =⟨6,\\hspace{0.167em}\\frac{3}{{t}^{2}}-3{t}^{2}⟩ \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{6}^{2}+{(\\frac{3}{{t}^{2}}-3{t}^{2})}^{2}} \\\\  & =3\\sqrt{{2}^{2}+{(\\frac{1}{{t}^{2}}-{t}^{2})}^{2}} \\\\  & =3\\sqrt{4+\\frac{1}{{t}^{4}}-2+{t}^{4}} \\\\  & =3\\sqrt{\\frac{1}{{t}^{4}}+2+{t}^{4}} \\\\  & =3\\sqrt{{(\\frac{1}{{t}^{2}}+{t}^{2})}^{2}} \\\\  & =3(\\frac{1}{{t}^{2}}+{t}^{2})\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{3}3(\\frac{1}{{t}^{2}}+{t}^{2})\\,\\text{d}t \\\\  & =3{\\int }_{1}^{3}(\\frac{1}{{t}^{2}}+{t}^{2})\\text{d}t \\\\  & =3(-\\frac{1}{t}+\\frac{{t}^{3}}{3}){|}_{1}^{3} \\\\  & =(-\\frac{3}{t}+{t}^{3}){|}_{1}^{3} \\\\  & =(-1+27)-(-3+1) \\\\  & =28\\end{aligned}\n$$"] [17592186345288 "First, we find ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}2t+2t\\operatorname{sin}2t),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}2t-2t\\operatorname{cos}2t)⟩ \\\\  & =⟨4t\\operatorname{cos}2t\\hspace{0.222em},4t\\operatorname{sin}2t⟩ \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{(4t\\operatorname{cos}2t)}^{2}+{(4t\\operatorname{sin}2t)}^{2}} \\\\  & =\\sqrt{16{t}^{2}{\\operatorname{cos}}^{2}t+16{t}^{2}{sin}^{2}} \\\\  & =\\sqrt{16{t}^{2}} \\\\  & =4t\\end{aligned}\n$$\n\nNotice that $t>0$ for $t\\in [1,2].$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{1}^{2}4t\\hspace{0.167em}\\text{d}t \\\\  & =2{t}^{2}{|}_{1}^{2} \\\\  & =2(4-1) \\\\  & =6.\\end{aligned}\n$$"] [17592186345295 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & x & 1 \\\\ 1 & -x & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}x & 1 \\\\ -x & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 1 \\\\ 1 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & x \\\\ 1 & -x\\end{vmatrix}\\mathbf{k} \\\\  & =(3x+x)\\mathbf{i}-(6-1)\\mathbf{j}+(-2x-x)\\mathbf{k} \\\\  & =⟨4x,-5,-3x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{(4x)^{2}+(-5)^{2}+(-3x)^{2}} \\\\  & =\\sqrt{16{x}^{2}+25+9{x}^{2}} \\\\  & =\\sqrt{25({x}^{2}+1)}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =10 \\\\ \\sqrt{25({x}^{2}+1)} & =10 \\\\ 25({x}^{2}+1) & =100 \\\\ {x}^{2}+1 & =4 \\\\ {x}^{2} & =3.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\sqrt{3}.$"] [17592186345296 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 0 & -4 \\\\ -1 & 1 & 2x\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & -4 \\\\ 1 & 2x\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -4 \\\\ -1 & 2x\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 0 \\\\ -1 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(0+4)\\mathbf{i}-(4x-4)\\mathbf{j}+(2-0)\\mathbf{k} \\\\  & =⟨4,-4x+4,2⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{{4}^{2}+(-4x+4)^{2}+{2}^{2}} \\\\  & =\\sqrt{16+16{x}^{2}-32x+16+4} \\\\  & =\\sqrt{16{x}^{2}-32x+36}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =2\\sqrt{5} \\\\ \\sqrt{16{x}^{2}-32x+36} & =2\\sqrt{5} \\\\ 16{x}^{2}-32x+36 & =20 \\\\ 16{x}^{2}-32x+16 & =0 \\\\ 16({x}^{2}-2x+1) & =0 \\\\ {x}^{2}-2x+1 & =0 \\\\ (x-1)^{2} & =0 \\\\ x-1 & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$"] [17592186348178 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =7\\operatorname{cos}\\theta  \\\\ {x}^{2} & =(7\\operatorname{cos}\\theta )^{2} \\\\  & =49{\\operatorname{cos}}^{2}\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =7\\operatorname{sin}\\theta  \\\\ {y}^{2} & =(7\\operatorname{sin}\\theta )^{2} \\\\  & =49{\\operatorname{sin}}^{2}\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =49{\\operatorname{cos}}^{2}\\theta +49{\\operatorname{sin}}^{2}\\theta  \\\\  & =49({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta ) \\\\  & =49(1) \\\\  & =49.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=49.$"] [17592186348179 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x+1}{2} & =\\operatorname{cos}\\theta  \\\\ \\frac{(x+1)^{2}}{{2}^{2}} & ={\\operatorname{cos}}^{2}\\theta  \\\\ \\frac{(x+1)^{2}}{4} & ={\\operatorname{cos}}^{2}\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y-4}{2} & =\\operatorname{sin}\\theta  \\\\ \\frac{(y-4)^{2}}{{2}^{2}} & ={\\operatorname{sin}}^{2}\\theta  \\\\ \\frac{(y-4)^{2}}{4} & ={\\operatorname{sin}}^{2}\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+1)^{2}}{4}+\\frac{(y-4)^{2}}{4} & ={\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta  \\\\ \\frac{(x+1)^{2}}{4}+\\frac{(y-4)^{2}}{4} & =1 \\\\ (x+1)^{2}+(y-4)^{2} & =4\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $(x+1)^{2}+(y-4)^{2}=4.$"] [17592186348180 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x+2}{3} & =\\operatorname{cos}\\theta  \\\\ \\frac{(x+2)^{2}}{{3}^{2}} & ={\\operatorname{cos}}^{2}\\theta  \\\\ \\frac{(x+2)^{2}}{9} & ={\\operatorname{cos}}^{2}\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y+3}{3} & =\\operatorname{sin}\\theta  \\\\ \\frac{(y+3)^{2}}{{3}^{2}} & ={\\operatorname{sin}}^{2}\\theta  \\\\ \\frac{(y+3)^{2}}{9} & ={\\operatorname{sin}}^{2}\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+2)^{2}}{9}+\\frac{(y+3)^{2}}{9} & ={\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta  \\\\ \\frac{(x+2)^{2}}{9}+\\frac{(y+3)^{2}}{9} & =1 \\\\ (x+2)^{2}+(y+3)^{2} & =9\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $(x+2)^{2}+(y+3)^{2}=9.$"] [17592186348181 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x-5}{4} & =\\operatorname{cos}\\theta  \\\\ \\frac{(x-5)^{2}}{{4}^{2}} & ={\\operatorname{cos}}^{2}\\theta  \\\\ \\frac{(x-5)^{2}}{16} & ={\\operatorname{cos}}^{2}\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y}{4} & =\\operatorname{sin}\\theta  \\\\ \\frac{{y}^{2}}{{4}^{2}} & ={\\operatorname{sin}}^{2}\\theta  \\\\ \\frac{{y}^{2}}{16} & ={\\operatorname{sin}}^{2}\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x-5)^{2}}{16}+\\frac{{y}^{2}}{16} & ={\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta  \\\\ \\frac{(x-5)^{2}}{16}+\\frac{{y}^{2}}{16} & =1 \\\\ (x-5)^{2}+{y}^{2} & =16\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $(x-5)^{2}+{y}^{2}=16.$"] [17592186351189 "Notice that our curve is given by the explicit Cartesian equation $y=\\sqrt{x}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) &=x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}={t}^{2}\\hspace{0.167em}\\mathbf{i}+t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}t\\in [0,1]\\end{aligned}\n$$\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=2t\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+y)\\,dx+(3x+2y)\\,dy & ={\\int }_{0}^{1}({x}^{2}+y)\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+(3x+2y)\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(({x}^{2}+y)\\,\\frac{\\text{d}x}{\\text{d}t}+(3x+2y)\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}({({t}^{2})}^{2}+t)\\cdot 2t+(3{t}^{2}+2t)\\cdot 1\\,dt \\\\  & ={\\int }_{0}^{1}({t}^{4}+t)\\cdot 2t+3{t}^{2}+2t\\,dt \\\\  & ={\\int }_{0}^{1}2{t}^{5}+5{t}^{2}+2t\\,dt \\\\  & ={[\\frac{{t}^{6}}{3}+\\frac{5{t}^{3}}{3}+{t}^{2}]}_{0}^{1} \\\\  & =[\\frac{(1)^{6}}{3}+\\frac{5(1)^{3}}{3}+(1)^{2}]-[0] \\\\  & =[\\frac{1}{3}+\\frac{5}{3}+1]-[0] \\\\  & =3\\end{aligned}\n$$"] [17592186351216 "Notice that our curve is given by the explicit Cartesian equation $y={x}^{2}-x.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) &=x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}=t\\hspace{0.167em}\\mathbf{i}+({t}^{2}-t)\\hspace{0.167em}\\mathbf{j},\\hspace{2em}t\\in [0,2]\\end{aligned}\n$$\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=\\mathbf{i}+(2t-1)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}2xy\\,dx+x\\,dy & ={\\int }_{0}^{2}2xy\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+x\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}(2xy\\,\\frac{\\text{d}x}{\\text{d}t}+x\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2}2t({t}^{2}-t)\\cdot 1+t(2t-1)\\,dt \\\\  & ={\\int }_{0}^{2}2{t}^{3}-t\\,dt \\\\  & ={[\\frac{{t}^{4}}{2}-\\frac{{t}^{2}}{2}]}_{0}^{2} \\\\  & =[\\frac{{2}^{4}}{2}-\\frac{{2}^{2}}{2}]-[0] \\\\  & =8-2 \\\\  & =6\\end{aligned}\n$$"] [17592186351218 "The position vectors of the endpoints of our line segment are $\\mathbf{a}=\\mathbf{j}$ and $\\mathbf{b}=2\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}\\mathbf{r}(t) & =\\mathbf{a}+t\\hspace{0.167em}(\\mathbf{b}-\\mathbf{a}) \\\\  & =\\mathbf{j}+t(2\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}-\\mathbf{j}) \\\\  & =\\mathbf{j}+t(2\\hspace{0.167em}\\mathbf{i}+2\\mathbf{j}) \\\\  & =2t\\hspace{0.167em}\\mathbf{i}+(1+2t)\\hspace{0.167em}\\mathbf{j},\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t$ and $y(t)=1+2t$ along the segment.\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=2\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x}\\,dx-\\pi \\operatorname{sin}⁡\\left(\\frac{\\pi y}{2}\\right)\\,dy & ={\\int }_{0}^{1}{e}^{x}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t-\\pi \\operatorname{sin}⁡\\left(\\frac{\\pi y}{2}\\right)\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}({e}^{x}\\,\\frac{\\text{d}x}{\\text{d}t}-\\pi \\operatorname{sin}⁡\\left(\\frac{\\pi y}{2}\\right)\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{2t}\\cdot 2-\\pi \\operatorname{sin}⁡\\left(\\frac{\\pi (1+2t)}{2}\\right)\\cdot 2\\,dt \\\\  & ={\\int }_{0}^{1}(2{e}^{2t}-2\\pi \\operatorname{sin}⁡(\\frac{\\pi }{2}+\\pi t))dt \\\\  & ={[{e}^{2t}+2\\operatorname{cos}⁡(\\frac{\\pi }{2}+\\pi t)]}_{0}^{1} \\\\  & =[{e}^{2(1)}+2\\operatorname{cos}⁡(\\frac{\\pi }{2}+\\pi (1))]-[{e}^{2(0)}+2\\operatorname{cos}⁡(\\frac{\\pi }{2}+\\pi (0))] \\\\  & =[{e}^{2}+2\\operatorname{cos}⁡\\left(\\frac{3\\pi }{2}\\right)]-[1+2\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)] \\\\  & =[{e}^{2}+0]-[1+0] \\\\  & ={e}^{2}-1\\end{aligned}\n$$"] [17592186351250 "Notice that our curve is given by the explicit Cartesian equation $y=\\pi {x}^{2}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) &=x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}=t\\hspace{0.167em}\\mathbf{i}+\\pi {t}^{2}\\hspace{0.167em}\\mathbf{j},\\hspace{2em}t\\in [1,2]\\end{aligned}\n$$\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=\\mathbf{i}+2\\pi t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{sin}⁡\\left(\\frac{y}{2{x}^{2}}\\right)\\,dx+3x\\,dy & ={\\int }_{1}^{2}\\operatorname{sin}⁡\\left(\\frac{y}{2{x}^{2}}\\right)\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+3x\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}(\\operatorname{sin}⁡\\left(\\frac{y}{2{x}^{2}}\\right)\\frac{\\text{d}x}{\\text{d}t}+3x\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1}^{2}\\operatorname{sin}⁡\\left(\\frac{\\pi {t}^{2}}{2{t}^{2}}\\right)\\cdot 1+3t\\cdot 2\\pi t\\,dt \\\\  & ={\\int }_{1}^{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)+6\\pi {t}^{2}\\,dt \\\\  & ={\\int }_{1}^{2}1+6\\pi {t}^{2}\\,dt \\\\  & =[t+2\\pi {t}^{3}]_{1}^{2} \\\\  & =[2+2\\pi (2)^{3}]-[1+2\\pi (1)^{3}] \\\\  & =[2+16\\pi ]-[1+2\\pi ] \\\\  & =1+14\\pi \\end{aligned}\n$$"] [17592186351278 "Given a transformation \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $\\mathbf{T},$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\n \n\nHere, we have $x=\\operatorname{sin}⁡(u+v)$ and $y=\\operatorname{cos}⁡(u-v).$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =\\operatorname{cos}⁡(u+v) & \\,\\frac{∂x}{∂v} & =\\operatorname{cos}⁡(u+v) \\\\ \\frac{∂y}{∂u} & =-\\operatorname{sin}⁡(u-v) & \\,\\frac{∂y}{∂v} & =\\operatorname{sin}⁡(u-v)\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\operatorname{cos}⁡(u+v) & \\operatorname{cos}⁡(u+v) \\\\ -\\operatorname{sin}⁡(u-v)\\, & \\operatorname{sin}⁡(u-v)\\end{vmatrix} \\\\  & =\\operatorname{cos}⁡(u+v)\\cdot \\operatorname{sin}⁡(u-v)-\\operatorname{cos}⁡(u+v)\\cdot (-\\operatorname{sin}⁡(u-v)) \\\\  & =2\\operatorname{cos}⁡(u+v)\\operatorname{sin}⁡(u-v).\\end{aligned}\n$$"] [17592186351356 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{j}.\n$$\n\nSince $\\mathrm{∇}f(x,y)=\\mathbf{F}(x,y),$ the function $f(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=2x{y}^{2}+1,\\,\\frac{∂f}{∂y}=2{x}^{2}y+1\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}f(x,y) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (2x{y}^{2}+1)\\,\\text{d}x \\\\  & ={x}^{2}{y}^{2}+x+g(y)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=2{x}^{2}y+{g}^{′}(y).\n$$\n\nTaking $\\frac{∂f}{∂y}=2{x}^{2}y+1$ into account, we obtain\n\n$$\n\\begin{aligned}2{x}^{2}y+{g}^{′}(y) & =2{x}^{2}y+1 \\\\ {g}^{′}(y) & =1 \\\\ g(y) & =y+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nFinally, substituting $g(y)=y+C$ into our expression for $f(x,y),$ we get\n\n$$\nf(x,y)={x}^{2}{y}^{2}+x+y+C.\n$$"] [17592186351357 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{j}.\n$$\n\nSince $\\mathrm{∇}f(x,y)=\\mathbf{F}(x,y),$ the function $f(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=12{x}^{3}-\\frac{1}{y},\\,\\frac{∂f}{∂y}=\\frac{x-1}{{y}^{2}}\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}f(x,y) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (12{x}^{3}-\\frac{1}{y})\\,\\text{d}x \\\\  & =3{x}^{4}-\\frac{x}{y}+g(y)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=\\frac{x}{{y}^{2}}+{g}^{′}(y).\n$$\n\nTaking $\\frac{∂f}{∂y}=\\frac{x-1}{{y}^{2}}$ into account, we obtain\n\n$$\n\\begin{aligned}\\frac{x}{{y}^{2}}+{g}^{′}(y) & =\\frac{x-1}{{y}^{2}} \\\\ \\frac{x}{{y}^{2}}+{g}^{′}(y) & =\\frac{x}{{y}^{2}}-\\frac{1}{{y}^{2}} \\\\ {g}^{′}(y) & =-\\frac{1}{{y}^{2}} \\\\ g(y) & =\\frac{1}{y}+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nFinally, substituting $g(y)=\\frac{1}{y}+C$ into our expression for $f(x,y),$ we get\n\n$$\nf(x,y)=3{x}^{4}-\\frac{x}{y}+\\frac{1}{y}+C.\n$$"] [17592186351358 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y,z)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{j}+\\frac{∂f}{∂z}\\hspace{0.167em}\\mathbf{k}.\n$$\n\nSince $\\mathrm{∇}f(x,y,z)=\\mathbf{F}(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=y+1,\\,\\frac{∂f}{∂y}=x+z+1,\\,\\frac{∂f}{∂z}=y+1\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (y+1)\\,\\text{d}x \\\\  & =xy+x+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=x+z+1$ into account, we obtain\n\n$$\n\\begin{aligned}x+\\frac{∂g}{∂y} & =x+z+1 \\\\ \\frac{∂g}{∂y} & =z+1\\end{aligned}\n$$\n\nNow, we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int (z+1)\\,\\text{d}y \\\\  & =yz+y+h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=yz+y+h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)=xy+x+yz+y+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}=y+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}=y+1$ into account, we obtain\n\n$$\n\\begin{aligned}y+1 & =y+{h}^{′}(z) \\\\ {h}^{′}(z) & =1 \\\\ h(z) & =z+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=xy+yz+x+y+z+C.\n$$"] [17592186351359 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y,z)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{\\text{i}}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{\\text{j}}+\\frac{∂f}{∂z}\\hspace{0.167em}\\mathbf{\\text{k}}.\n$$\n\nSince $\\mathrm{∇}f(x,y,z)=\\mathbf{F}(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=y{e}^{xy},\\,\\frac{∂f}{∂y}=x{e}^{xy},\\,\\frac{∂f}{∂z}=3\\operatorname{cos}⁡(3z)\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int y{e}^{xy}\\,\\text{d}x \\\\  & ={e}^{xy}+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x{e}^{xy}+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=x{e}^{xy}$ into account, we obtain\n\n$$\n\\begin{aligned}x{e}^{xy}+\\frac{∂g}{∂y} & =x{e}^{xy} \\\\ \\frac{∂g}{∂y} & =0\\end{aligned}\n$$\n\nNow we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int 0\\,\\text{d}y \\\\  & =h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)={e}^{xy}+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}={h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}=3\\operatorname{cos}⁡(3z)$ into account, we obtain\n\n$$\n\\begin{aligned}{h}^{′}(z) & =3\\operatorname{cos}⁡(3z) \\\\ h(z) & =\\operatorname{sin}⁡(3z)+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)={e}^{xy}+\\operatorname{sin}⁡(3z)+C.\n$$"] [17592186351362 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{j}.\n$$\n\nSince $\\mathrm{∇}f(x,y)=\\mathbf{F}(x,y),$ the function $f(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=\\operatorname{cos}⁡x\\operatorname{sin}⁡y,\\,\\frac{∂f}{∂y}=\\operatorname{sin}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡y\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}f(x,y) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\operatorname{sin}⁡y\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x\\operatorname{sin}⁡y+g(y)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=\\operatorname{sin}⁡x\\operatorname{cos}⁡y+{g}^{′}(y).\n$$\n\nTaking  $$\n\\displaystyle \\frac{∂f}{∂y}=\\operatorname{sin}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡y\n$$ into account, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x\\operatorname{cos}⁡y+{g}^{′}(y) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡y \\\\ {g}^{′}(y) & =\\operatorname{sin}⁡y \\\\ g(y) & =-\\operatorname{cos}⁡y+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nFinally, substituting $g(y)=-\\operatorname{cos}⁡y+C$ into our expression for $f(x,y),$ we get\n\n$$\nf(x,y)=\\operatorname{sin}⁡x\\operatorname{sin}⁡y-\\operatorname{cos}⁡y+C.\n$$"] [17592186351363 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{j}.\n$$\n\nSince $\\mathrm{∇}f(x,y)=\\mathbf{F}(x,y),$ the function $f(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=y{e}^{xy},\\,\\frac{∂f}{∂y}=x{e}^{xy}+2y\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}f(x,y) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int y{e}^{xy}\\,\\text{d}x \\\\  & ={e}^{xy}+g(y)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x{e}^{xy}+{g}^{′}(y).\n$$\n\nTaking $\\frac{∂f}{∂y}=x{e}^{xy}+2y$ into account, we obtain\n\n$$\n\\begin{aligned}x{e}^{xy}+{g}^{′}(y) & =x{e}^{xy}+2y \\\\ {g}^{′}(y) & =2y \\\\ g(y) & ={y}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nFinally, substituting $g(y)={y}^{2}+C$ into our expression for $f(x,y),$ we get\n\n$$\nf(x,y)={e}^{xy}+{y}^{2}+C.\n$$"] [17592186351364 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y,z)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{j}+\\frac{∂f}{∂z}\\hspace{0.167em}\\mathbf{k}.\n$$\n\nSince $\\mathrm{∇}f(x,y,z)=\\mathbf{F}(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=y{z}^{2},\\,\\frac{∂f}{∂y}=x{z}^{2}+z,\\,\\frac{∂f}{∂z}=2xyz+y-2\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int y{z}^{2}\\,\\text{d}x \\\\  & =xy{z}^{2}+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x{z}^{2}+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=x{z}^{2}+z$ into account, we obtain\n\n$$\n\\begin{aligned}x{z}^{2}+\\frac{∂g}{∂y} & =x{z}^{2}+z \\\\ \\frac{∂g}{∂y} & =z\\end{aligned}\n$$\n\nNow, we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int z\\,\\text{d}y \\\\  & =yz+h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=yz+h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)=xy{z}^{2}+yz+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}=2xyz+y+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}=2xyz+y-2$ into account, we obtain\n\n$$\n\\begin{aligned}2xyz+y-2 & =2xyz+y+{h}^{′}(z) \\\\ {h}^{′}(z) & =-2 \\\\ h(z) & =-2z+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=xy{z}^{2}+yz-2z+C.\n$$"] [17592186351365 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y,z)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{\\text{i}}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{\\text{j}}+\\frac{∂f}{∂z}\\hspace{0.167em}\\mathbf{\\text{k}}.\n$$\n\nSince $\\mathrm{∇}f(x,y,z)=\\mathbf{F}(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=yz{e}^{xz}+z,\\,\\frac{∂f}{∂y}={e}^{xz}+1,\\,\\frac{∂f}{∂z}=xy{e}^{xz}+x\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (yz{e}^{xz}+z)\\,\\text{d}x \\\\  & =y{e}^{xz}+xz+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}={e}^{xz}+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}={e}^{xz}+1$ into account, we obtain\n\n$$\n\\begin{aligned}{e}^{xz}+\\frac{∂g}{∂y} & ={e}^{xz}+1 \\\\ \\frac{∂g}{∂y} & =1\\end{aligned}\n$$\n\nNow we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int 1\\,\\text{d}y \\\\  & =y+h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=y+h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)=y{e}^{xz}+xz+y+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}=xy{e}^{xz}+x+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}=xy{e}^{xz}+x$ into account, we obtain\n\n$$\n\\begin{aligned}xy{e}^{xz}+x+{h}^{′}(z) & =zy{e}^{xz}+x \\\\ {h}^{′}(z) & =0 \\\\ h(z) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=y{e}^{xz}+xz+y+C.\n$$"] [17592186351514 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/96/968419bad65410864c75e8abe766d21ac4d4acd835c73ea84118cf21ac066f79.png)\n\nNotice that the region $D$ represents a portion of the disk of radius $2$ centered at $(0,2).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write the ${x}^{2}+(y-2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-2)^{2} & =4 \\\\ (r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta -2)^{2} & =4 \\\\ {r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta -4r\\operatorname{sin}\\theta +4 & =4 \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )-4r\\operatorname{sin}\\theta  & =0 \\\\ {r}^{2}-4r\\operatorname{sin}\\theta  & =0 \\\\ r(r-4\\operatorname{sin}\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=4\\operatorname{sin}⁡\\theta .$\n\nNow, let's determine the limits for $r$ and $\\theta .$ First of all, $r$ can vary from $r=0$ (at the origin) to $r=4\\operatorname{sin}⁡\\theta $ (at the boundary of the region): \n\n![](images/2f/2fe33fb6e1be8b6107cb667e9453613af906bd4da7d67f9d9323d49cce5ae06c.png)\n\nSecondly, $\\theta $ can vary between $\\theta =0$ (the positive $x$-axis) and $\\theta =\\frac{\\pi }{2}$ (the positive $y$-axis):\n\n![](images/e2/e2b5e7b4433cbfb50ac7a9f991e4e4bc0cf8deecfefeeef0a4c9606ab6183cce.png)\n\nSo, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta )\\hspace{0.222em}:\\hspace{0.222em}0\\le r\\le 4\\operatorname{sin}\\theta ,\\hspace{0.222em}0\\le \\theta \\le \\frac{\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{4\\operatorname{sin}⁡\\theta }\\sqrt{{r}^{2}}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{4\\operatorname{sin}⁡\\theta }{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"] [17592186351516 "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{\\int }_{1}^{3}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{1}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {[\\frac{{r}^{4}}{4}]}_{1}^{3}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta ({3}^{4}-{1}^{4})\\,\\text{d}\\theta  \\\\  & =20{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}20{\\int }_{0}^{\\pi /2}\\operatorname{cos}\\theta \\operatorname{sin}\\theta \\hspace{0.222em}\\text{d}\\theta  & =20[\\frac{{\\operatorname{sin}}^{2}\\theta }{2}]_{0}^{\\pi /2} \\\\  & =10{[{\\operatorname{sin}}^{2}\\theta ]}_{0}^{\\pi /2} \\\\  & =10({\\operatorname{sin}}^{2}\\left(\\frac{\\pi }{2}\\right)-{\\operatorname{sin}}^{2}(0)) \\\\  & =10(1-0) \\\\  & =10\\end{aligned}\n$$"] [17592186351517 "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(-1,1):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}y+y{e}^{x}-xy)\\text{ }\\mathbf{i}+\\frac{∂}{∂y}(x\\operatorname{ln}y+y{e}^{x}-xy)\\text{ }\\mathbf{j} \\\\  & =(\\operatorname{ln}y+y{e}^{x}-y)\\text{ }\\mathbf{i}+(\\frac{x}{y}+{e}^{x}-x)\\text{ }\\mathbf{j} \\\\ \\mathrm{∇}f(1,1) & =(\\operatorname{ln}1+1\\cdot {e}^{-1}-1)\\text{ }\\mathbf{i}+(\\frac{-1}{1}+{e}^{-1}-(-1))\\text{ }\\mathbf{j} \\\\  & =({e}^{-1}-1)\\text{ }\\mathbf{i}+{e}^{-1}\\mathbf{j}\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $({e}^{-1}-1)\\text{ }\\mathbf{i}+{e}^{-1}\\mathbf{j}.$"] [17592186351520 "The rate of change of $g(x,y)$ at the point $(1,1)$ in the direction of $\\mathbf{v}$ is equal to the directional derivative ${g}_{\\mathbf{u}}^{'}(1,1).$ \n\nFirst, we find the unit vector $\\mathbf{u}$ in the direction of $\\mathbf{v}:$\n\n$$\n\\begin{aligned}‖\\mathbf{v}‖ & =\\sqrt{(-2)^{2}+{2}^{2}}=2\\sqrt{2} \\\\ \\mathbf{u} & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇\\,g(x,y)$ and evaluate it at the point $(1,1):$\n\n$$\n\\begin{aligned}∇\\,g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy),\\,\\frac{∂}{∂y}(\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy)⟩ \\\\  & =⟨\\frac{\\pi \\operatorname{cos}⁡(\\pi x)}{y}+\\pi y,\\,-\\frac{\\operatorname{sin}⁡(\\pi x)}{{y}^{2}}+\\pi x⟩ \\\\ ∇\\,g(1,1) & =⟨\\frac{\\pi \\operatorname{cos}⁡(\\pi \\cdot 1)}{1}+\\pi \\cdot 1,\\,-\\frac{\\operatorname{sin}⁡(\\pi \\cdot 1)}{{1}^{2}}+\\pi \\cdot 1⟩ \\\\  & =⟨-\\pi +\\pi ,0+\\pi ⟩ \\\\  & =⟨0,\\pi ⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{\\mathbf{u}}^{'}(1,1)$ is\n\n$$\n\\begin{aligned}{g}_{\\mathbf{u}}^{'}(1,1) & =\\mathrm{∇}\\hspace{-0.167em}g(1,1)\\cdot \\mathbf{u} \\\\  & =⟨0,\\pi ⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{0\\cdot (-1)+\\pi \\cdot 1}{\\sqrt{2}} \\\\  & =\\frac{\\pi }{\\sqrt{2}}.\\end{aligned}\n$$"] [17592186351521 "The rate of change of $g(x,y)$ at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4})$ in the direction of $\\mathbf{v}$ is equal to the directional derivative $$\n{g}_{\\mathbf{u}}^{'}(\\frac{\\pi }{4},\\frac{\\pi }{4}).\n$$ \n\nFirst, we find the unit vector $\\mathbf{u}$ in the direction of $\\mathbf{v}:$\n\n$$\n\\begin{aligned}‖\\mathbf{v}‖ & =\\sqrt{(-1)^{2}+{1}^{2}}=\\sqrt{2} \\\\ \\mathbf{u} & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇\\,g(x,y)$ and evaluate it at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}∇\\,g(x,y) & =⟨\\frac{∂}{∂x}(2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x),\\,\\frac{∂}{∂y}(2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x)⟩ \\\\  & =⟨2\\operatorname{tan}⁡y-2y{sec}^{2}⁡x,\\,2x{sec}^{2}⁡y-2\\operatorname{tan}⁡x⟩ \\\\ ∇\\,g(\\frac{\\pi }{4},\\frac{\\pi }{4}) & =⟨2\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)-2\\cdot \\frac{\\pi }{4}\\cdot {sec}^{2}⁡\\left(\\frac{\\pi }{4}\\right),\\,2\\cdot \\frac{\\pi }{4}\\cdot {sec}^{2}⁡\\left(\\frac{\\pi }{4}\\right)-2\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)⟩ \\\\  & =⟨2\\cdot 1-\\frac{\\pi }{2}\\cdot 2,\\frac{\\pi }{2}\\cdot 2-2\\cdot 1⟩ \\\\  & =⟨2-\\pi ,\\,\\pi -2⟩\\end{aligned}\n$$\n\nFinally, the directional derivative $$\n{g}_{\\mathbf{u}}^{'}(\\frac{\\pi }{4},\\frac{\\pi }{4})\n$$ is\n\n$$\n\\begin{aligned}{g}_{\\mathbf{u}}^{'}(\\frac{\\pi }{4},\\frac{\\pi }{4}) & =\\mathrm{∇}\\hspace{-0.167em}g(\\frac{\\pi }{4},\\frac{\\pi }{4})\\cdot \\mathbf{u} \\\\  & =⟨2-\\pi ,\\pi -2⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{(2-\\pi )\\cdot (-1)+(\\pi -2)\\cdot 1}{\\sqrt{2}} \\\\  & =\\frac{2\\pi -4}{\\sqrt{2}} \\\\  & =\\sqrt{2}(\\pi -2).\\end{aligned}\n$$"] [17592186351551 "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $1$ and $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta )\\hspace{0.222em}:\\hspace{0.222em}1\\le r\\le 2,\\hspace{0.222em}-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}+{y}^{2})\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}((r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2})\\hspace{0.167em}r\\hspace{0.222em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{1}^{2}{r}^{3}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{1}^{2}{r}^{3}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"] [17592186351552 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $\\frac{1}{2}$ centered at $(\\frac{1}{2},0)\\,.$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For $$\n\\displaystyle {(x-\\frac{1}{2})}^{2}+{y}^{2}=\\frac{1}{4},\n$$ we obtain\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{y}^{2} & =\\frac{1}{4} \\\\ {(r\\operatorname{cos}\\theta -\\frac{1}{2})}^{2}+(r\\operatorname{sin}\\theta )^{2} & =\\frac{1}{4} \\\\ {r}^{2}{\\operatorname{cos}}^{2}\\theta -r\\operatorname{cos}\\theta +\\frac{1}{4}+{r}^{2}{\\operatorname{sin}}^{2}\\theta  & =\\frac{1}{4} \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )-r\\operatorname{cos}\\theta  & =0 \\\\ {r}^{2}-r\\operatorname{cos}\\theta  & =0 \\\\ r(r-\\operatorname{cos}\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=\\operatorname{cos}⁡\\theta .$\n\n- For $x=\\frac{1}{2},$ we get\n\n$$\n\\begin{aligned}x & =\\frac{1}{2} \\\\ r\\operatorname{cos}⁡\\theta  & =\\frac{1}{2} \\\\ r & =\\frac{1}{2\\operatorname{cos}⁡\\theta } \\\\ r & =\\frac{1}{2}\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(\\frac{1}{2},\\frac{1}{2}).$  So, the entire region lies between the radial lines $\\theta =0$ and $\\theta =\\frac{\\pi }{4},$ as depicted below.  \n\n![](images/f5/f518a206638071a7b8548882a453123b6d78aed0aa94cc0e6e23429f22c6f1b3.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta )\\hspace{0.222em}:\\hspace{0.222em}\\frac{1}{2}\\operatorname{sec}\\theta \\le r\\le \\operatorname{cos}\\theta ,\\hspace{0.222em}0\\le \\theta \\le \\frac{\\pi }{4}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2x}{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}\\frac{2r\\operatorname{cos}\\theta }{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\hspace{0.222em}r\\hspace{0.167em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{\\operatorname{sec}\\theta /2}^{\\operatorname{cos}\\theta }2\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{cos}\\theta {\\int }_{\\operatorname{sec}\\theta /2}^{\\operatorname{cos}\\theta }\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{cos}\\theta [r]_{\\operatorname{sec}\\theta /2}^{\\operatorname{cos}\\theta }\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{cos}\\theta (\\operatorname{cos}\\theta -\\frac{1}{2}\\operatorname{sec}\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(2{\\operatorname{cos}}^{2}\\theta -1)\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{cos}(2\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & =\\frac{1}{2}[\\operatorname{sin}(2\\theta )]_{0}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\operatorname{sin}\\left(\\frac{\\pi }{2}\\right)-0) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"] [17592186354274 "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{\\int }_{1-\\operatorname{cos}\\theta }^{1}r\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  & ={\\int }_{0}^{\\pi /2}\\hspace{0.222em}[\\frac{{r}^{2}}{2}]_{1-\\operatorname{cos}\\theta }^{1}\\hspace{0.222em}\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}({1}^{2}-(1-\\operatorname{cos}\\theta )^{2})\\hspace{0.222em}\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(2\\operatorname{cos}\\theta -{\\operatorname{cos}}^{2}\\theta )\\hspace{0.222em}\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{\\pi /2}(2\\operatorname{cos}\\theta -{\\operatorname{cos}}^{2}\\theta )\\hspace{0.222em}\\text{d}\\theta  & ={[\\operatorname{sin}\\theta -\\frac{1}{4}\\theta -\\frac{1}{8}\\operatorname{sin}(2\\theta )]}_{0}^{\\pi /2} \\\\  & =(\\operatorname{sin}\\left(\\frac{\\pi }{2}\\right)-\\frac{1}{4}\\cdot \\frac{\\pi }{2}-\\frac{1}{8}\\operatorname{sin}\\pi )-0 \\\\  & =1-\\frac{\\pi }{8}-\\frac{1}{8}\\cdot 0 \\\\  & =\\frac{8-\\pi }{8}\\end{aligned}\n$$"] [17592186354278 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $2$ centered at the origin.\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=4,$ we obtain $r=2.$\n\n- For $y=-1,$ we get\n\n$$\n\\begin{aligned}y & =-1 \\\\ r\\operatorname{sin}⁡\\theta  & =-1 \\\\ r & =-\\frac{1}{\\operatorname{sin}⁡\\theta } \\\\ r & =-\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(\\sqrt{3},-1).$ So, the entire region lies between the radial lines $\\theta =-\\frac{\\pi }{2}$ and $\\theta =-\\frac{\\pi }{6},$ as depicted below.  \n\n![](images/23/2386c1dcb1cf71231f2bb508dc1dd85dadef15b806eaf7f9a9ad0d3e4f3da1ca.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,-\\operatorname{csc}⁡\\theta \\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le -\\frac{\\pi }{6}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2y}{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}\\frac{2r\\operatorname{sin}\\theta }{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\hspace{0.222em}r\\hspace{0.167em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}{\\int }_{-\\operatorname{csc}\\theta }^{2}2\\operatorname{sin}\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}2\\operatorname{sin}\\theta {\\int }_{-\\operatorname{csc}\\theta }^{2}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}2\\operatorname{sin}\\theta [r]_{-\\operatorname{csc}\\theta }^{2}\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}2\\operatorname{sin}\\theta (2+\\operatorname{csc}\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}(4\\operatorname{sin}\\theta +2)\\hspace{0.222em}\\text{d}\\theta  \\\\  & =[-4\\operatorname{cos}\\theta +2\\theta ]_{-\\pi /2}^{-\\pi /6} \\\\  & =[(-4\\operatorname{cos}\\left(-\\frac{\\pi }{6}\\right)-\\frac{\\pi }{3})-(0-\\pi )] \\\\  & =\\frac{2\\pi }{3}-2\\sqrt{3}.\\end{aligned}\n$$"] [17592186354389 "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $1$ and $3$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,1\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}-{y}^{2})\\hspace{0.222em}\\text{ }\\mathrm{d}A & ={∬}_{\\mathrm{Δ}}({r}^{2}{\\operatorname{cos}}^{2}\\theta -{r}^{2}{\\operatorname{sin}}^{2}\\theta )\\hspace{0.167em}r\\hspace{0.222em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{3}{r}^{2}({\\operatorname{cos}}^{2}\\theta -{\\operatorname{sin}}^{2}\\theta )\\hspace{0.167em}r\\hspace{0.222em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{3}{r}^{3}\\operatorname{cos}2\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"] [17592186354390 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $2$ centered at $(-2,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For $(x+2)^{2}+{y}^{2}=4,$ we obtain\n\n$$\n\\begin{aligned}(x+2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}\\theta +2)^{2}+(r\\operatorname{sin}\\theta )^{2} & =4 \\\\ {r}^{2}{\\operatorname{cos}}^{2}\\theta +4r\\operatorname{cos}\\theta +4+{r}^{2}{\\operatorname{sin}}^{2}\\theta  & =4 \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )+4r\\operatorname{cos}\\theta  & =0 \\\\ {r}^{2}+4r\\operatorname{cos}\\theta  & =0 \\\\ r(r+4\\operatorname{cos}\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-4\\operatorname{cos}⁡\\theta .$\n\n- For $x=-3,$ we get\n\n$$\n\\begin{aligned}x & =-3 \\\\ r\\operatorname{cos}⁡\\theta  & =-3 \\\\ r & =-\\frac{3}{\\operatorname{cos}⁡\\theta } \\\\ r & =-3\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the points $(-3,-\\sqrt{3})$ and $(-3,\\sqrt{3}).$ So, the entire region $D$ lies between the polar lines $\\theta =\\frac{5\\pi }{6}$ and $\\theta =\\frac{7\\pi }{6},$ as depicted below.  \n\n![](images/92/928c6dc79f44a2185ccf217c0cf9210630b6554a698f805ef2c77500f9ddc76b.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,-3\\operatorname{sec}⁡\\theta \\le r\\le -4\\operatorname{cos}⁡\\theta ,\\,\\frac{5\\pi }{6}\\le \\theta \\le \\frac{7\\pi }{6}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}xy\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta )(r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{5\\pi /6}^{7\\pi /6}{\\int }_{-3\\operatorname{sec}⁡\\theta }^{-4\\operatorname{cos}⁡\\theta }{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{5\\pi /6}^{7\\pi /6}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{-3\\operatorname{sec}⁡\\theta }^{-4\\operatorname{cos}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"] [17592186354391 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at $(0,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=1,$ we obtain $r=1.$\n\n- For $x=-\\frac{\\sqrt{2}}{2},$ we get\n\n$$\n\\begin{aligned}x & =-\\frac{\\sqrt{2}}{2} \\\\ r\\operatorname{cos}⁡\\theta  & =-\\frac{\\sqrt{2}}{2} \\\\ r & =-\\frac{\\sqrt{2}}{2\\operatorname{cos}⁡\\theta } \\\\ r & =-\\frac{\\operatorname{sec}⁡\\theta }{\\sqrt{2}}.\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $$\n\\displaystyle (-\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).\n$$ So, the entire region $D$ lies between the polar lines $\\theta =\\frac{3\\pi }{4}$ and $\\theta =\\pi ,$ as depicted below.  \n\n![](images/ca/ca09f228fc218ef1b57196c6b6b1e740c10173b7cd38b1c27407726eccd783f1.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,-\\frac{\\operatorname{sec}⁡\\theta }{\\sqrt{2}}\\le r\\le 1,\\,\\frac{3\\pi }{4}\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}\\sqrt{(r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2}}\\hspace{0.222em}r\\hspace{0.167em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /4}^{\\pi }{\\int }_{-\\operatorname{sec}\\theta /\\sqrt{2}}^{1}\\sqrt{{r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )}\\hspace{0.222em}r\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /4}^{\\pi }{\\int }_{-\\operatorname{sec}\\theta /\\sqrt{2}}^{1}{r}^{2}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"] [17592186354402 "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $3$ and $4$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,3\\le r\\le 4,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y}{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}\\frac{r\\operatorname{sin}\\theta }{(r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2}}\\hspace{0.167em}r\\hspace{0.222em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}\\frac{{r}^{2}\\operatorname{sin}\\theta }{{r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}\\operatorname{sin}\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"] [17592186354403 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $2$ centered at $(2,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For $(x-2)^{2}+{y}^{2}=4,$ we obtain\n\n$$\n\\begin{aligned}(x-2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}\\theta -2)^{2}+(r\\operatorname{sin}\\theta )^{2} & =4 \\\\ {r}^{2}{\\operatorname{cos}}^{2}\\theta -4r\\operatorname{cos}\\theta +4+{r}^{2}{\\operatorname{sin}}^{2}\\theta  & =4 \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )-4r\\operatorname{cos}\\theta  & =0 \\\\ {r}^{2}-4r\\operatorname{cos}\\theta  & =0 \\\\ r(r-4\\operatorname{cos}\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=4\\operatorname{cos}⁡\\theta .$\n\n- For $x=3,$ we get\n\n$$\n\\begin{aligned}x & =3 \\\\ r\\operatorname{cos}⁡\\theta  & =3 \\\\ r & =\\frac{3}{\\operatorname{cos}⁡\\theta } \\\\ r & =3\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(3,-\\sqrt{3}).$ So, the entire region $D$ lies between the polar lines $\\theta =-\\frac{\\pi }{6}$ and $\\theta =0,$ as depicted below.  \n\n![](images/bf/bf2d20acbb93d3c61e9890a49d1c15a08c2b4e18b474da421bded7cf3dafc297.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,3\\operatorname{sec}⁡\\theta \\le r\\le 4\\operatorname{cos}⁡\\theta ,\\,-\\frac{\\pi }{6}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y}{{x}^{2}}\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}\\frac{r\\operatorname{sin}\\theta }{(r\\operatorname{cos}\\theta )^{2}}\\hspace{0.222em}r\\hspace{0.167em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /6}^{0}{\\int }_{3\\operatorname{sec}\\theta }^{4\\operatorname{cos}\\theta }\\frac{{r}^{2}\\operatorname{sin}\\theta }{{r}^{2}{\\operatorname{cos}}^{2}\\theta }\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /6}^{0}\\operatorname{sec}\\theta \\operatorname{tan}\\theta {\\int }_{3\\operatorname{sec}\\theta }^{4\\operatorname{cos}\\theta }\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"] [17592186354405 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $4$ centered at $(0,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=16,$ we obtain $r=4.$\n\n- For $x=2\\sqrt{2},$ we get\n\n$$\n\\begin{aligned}x & =2\\sqrt{2} \\\\ r\\operatorname{cos}⁡\\theta  & =2\\sqrt{2} \\\\ r & =\\frac{2\\sqrt{2}}{\\operatorname{cos}⁡\\theta } \\\\ r & =2\\sqrt{2}\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(2\\sqrt{2},2\\sqrt{2}).$ So, the entire region $D$ lies between the polar lines $\\theta =0$ and $\\theta =\\frac{\\pi }{4},$ as depicted below.  \n\n![](images/37/375e270ce444d9f62b50f9a25abfae781113fdad895833d693061ffffe93f5d3.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,2\\sqrt{2}\\operatorname{sec}⁡\\theta \\le r\\le 4,\\,0\\le \\theta \\le \\frac{\\pi }{4}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{6x}{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}\\frac{6r\\operatorname{cos}\\theta }{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\hspace{0.222em}r\\hspace{0.167em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{2\\sqrt{2}\\operatorname{sec}\\theta }^{4}6\\operatorname{cos}\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}6\\operatorname{cos}\\theta {\\int }_{2\\sqrt{2}\\operatorname{sec}\\theta }^{4}\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}6\\operatorname{cos}\\theta [r]_{2\\sqrt{2}\\operatorname{sec}\\theta }^{4}\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}6\\operatorname{cos}\\theta (4-2\\sqrt{2}\\operatorname{sec}\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(24\\operatorname{cos}\\theta -12\\sqrt{2})\\hspace{0.222em}\\text{d}\\theta  \\\\  & =[24\\operatorname{sin}\\theta -12\\sqrt{2}\\hspace{0.167em}\\theta ]_{0}^{\\pi /4} \\\\  & =[(24\\operatorname{sin}\\left(\\frac{\\pi }{4}\\right)-12\\sqrt{2}\\left(\\frac{\\pi }{4}\\right))-0] \\\\  & =12\\sqrt{2}-3\\pi \\sqrt{2}.\\end{aligned}\n$$"] [17592186354406 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at $(0,1).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+(y-1)^{2}=1,$ we obtain\n\n$$\n\\begin{aligned}{x}^{2}+(y-1)^{2} & =1 \\\\ (r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta -1)^{2} & =1 \\\\ {r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta -2r\\operatorname{sin}\\theta +1 & =1 \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )-2r\\operatorname{sin}\\theta  & =0 \\\\ {r}^{2}-2r\\operatorname{sin}\\theta  & =0 \\\\ r(r-2\\operatorname{sin}\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{sin}⁡\\theta .$\n\n- For $y=1,$ we get\n\n$$\n\\begin{aligned}y & =1 \\\\ r\\operatorname{sin}⁡\\theta  & =1 \\\\ r & =\\frac{1}{\\operatorname{sin}⁡\\theta } \\\\ r & =\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(-1,1).$ So, the entire region $D$ lies between the polar lines $\\theta =\\frac{\\pi }{2}$ and $\\theta =\\frac{3\\pi }{4},$ as depicted below.  \n\n![](images/1b/1b83e2674bba4bd6c326083f8c94496b5288de23575dc63a92b9a660eba69f67.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,\\operatorname{csc}⁡\\theta \\le r\\le 2\\operatorname{sin}⁡\\theta ,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{4}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{4y}{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}A & ={∬}_{\\mathrm{Δ}}\\frac{4r\\operatorname{sin}\\theta }{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\hspace{0.222em}r\\hspace{0.167em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}{\\int }_{\\operatorname{csc}\\theta }^{2\\operatorname{sin}\\theta }4\\operatorname{sin}\\theta \\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}4\\operatorname{sin}\\theta {\\int }_{\\operatorname{csc}\\theta }^{2\\operatorname{sin}\\theta }\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}4\\operatorname{sin}\\theta [r]_{\\operatorname{csc}\\theta }^{2\\operatorname{sin}\\theta }\\hspace{0.222em}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}4\\operatorname{sin}\\theta (2\\operatorname{sin}\\theta -\\operatorname{csc}\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & =4{\\int }_{\\pi /2}^{3\\pi /4}(2{\\operatorname{sin}}^{2}\\theta -1)\\hspace{0.222em}\\text{d}\\theta  \\\\  & =-4{\\int }_{\\pi /2}^{3\\pi /4}\\operatorname{cos}(2\\theta )\\hspace{0.222em}\\text{d}\\theta  \\\\  & =-2[\\operatorname{sin}(2\\theta )]_{\\pi /2}^{3\\pi /4} \\\\  & =-2[\\operatorname{sin}\\left(\\frac{3\\pi }{2}\\right)-\\operatorname{sin}(\\pi )] \\\\  & =2.\\end{aligned}\n$$"] [17592186354470 "The directional derivative ${f}_{\\mathbf{u}}^{'}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $\\mathbf{v}$ is given by\n\n$$\n{f}_{\\mathbf{u}}^{'}(a,b)=\\mathrm{∇}f(a,b)\\cdot \\mathbf{u}\n$$\n\nwhere $\\mathbf{u}$ is a unit vector in the direction of $\\mathbf{v}.$\n\nFirst, we find the unit vector $\\mathbf{u}$ in the direction of $\\mathbf{v}:$\n\n$$\n\\begin{aligned}‖\\mathbf{v}‖ & =\\sqrt{{3}^{2}+{5}^{2}}=\\sqrt{34} \\\\ \\mathbf{u} & =\\frac{1}{\\sqrt{34}}(3\\mathbf{i}+5\\mathbf{j})\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(0,1):$\n\n$$\n\\begin{aligned}\\mathrm{∇}\\hspace{-0.167em}f(x,y) & =\\frac{∂}{∂x}(6{x}^{2}+2y)\\text{ }\\mathbf{i}+\\frac{∂}{∂y}(6{x}^{2}+2y)\\text{ }\\mathbf{j} \\\\  & =12x\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j} \\\\ \\mathrm{∇}\\hspace{-0.167em}f(0,1) & =(12\\cdot 0)\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j} \\\\  & =2\\mathbf{j}\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{\\mathbf{u}}^{'}(0,1) & =\\mathrm{∇}\\hspace{-0.167em}f(0,1)\\cdot \\mathbf{u} \\\\  & =2\\mathbf{j}\\cdot (\\frac{3}{\\sqrt{34}}\\mathbf{i}+\\frac{5}{\\sqrt{34}}\\mathbf{j}) \\\\  & =\\frac{0\\cdot 3+2\\cdot 5}{\\sqrt{34}} \\\\  & =\\frac{10\\sqrt{34}}{34}.\\end{aligned}\n$$"] [17592186354478 "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(0,1):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y) & =\\frac{∂}{∂x}(3{x}^{2}\\operatorname{sin}y-y\\operatorname{cos}x)\\text{ }\\mathbf{i}+\\frac{∂}{∂y}(3{x}^{2}\\operatorname{sin}y-y\\operatorname{cos}x)\\text{ }\\mathbf{j} \\\\  & =(y\\operatorname{sin}x+6x\\operatorname{sin}y)\\text{ }\\mathbf{i}+(3{x}^{2}\\operatorname{cos}y-\\operatorname{cos}x)\\text{ }\\mathbf{j} \\\\ \\mathrm{∇}f(0,1) & =(1\\cdot \\operatorname{sin}(0)+6\\cdot 0\\cdot \\operatorname{sin}(1))\\text{ }\\mathbf{i}+(3(0)^{2}\\operatorname{cos}(1)-\\operatorname{cos}(0))\\text{ }\\mathbf{j} \\\\  & =-\\mathbf{j}\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $-\\mathbf{j}.$"] [17592186357487 "Notice that our curve is given by the explicit Cartesian equation $y={x}^{2}-1.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) &=x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}=t\\hspace{0.167em}\\mathbf{i}+({t}^{2}-1)\\hspace{0.167em}\\mathbf{j},\\hspace{2em}t\\in [0,2]\\end{aligned}\n$$\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}5{x}^{2}y\\,dx+{x}^{2}(y+1)\\,dy & ={\\int }_{0}^{2}5{x}^{2}y\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+{x}^{2}(y+1)\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}(5{x}^{2}y\\,\\frac{\\text{d}x}{\\text{d}t}+{x}^{2}(y+1)\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2}5{t}^{2}({t}^{2}-1)\\cdot 1+{t}^{2}({t}^{2}-1+1)\\cdot 2t\\,dt \\\\  & ={\\int }_{0}^{2}5{t}^{4}-5{t}^{2}+2{t}^{5}\\,dt \\\\  & ={[{t}^{5}-\\frac{5}{3}{t}^{3}+\\frac{{t}^{6}}{3}]}_{0}^{2} \\\\  & =[{2}^{5}-\\frac{5}{3}(2)^{3}+\\frac{{2}^{6}}{3}]-[0] \\\\  & =32-\\frac{40}{3}+\\frac{64}{3} \\\\  & =40\\end{aligned}\n$$"] [17592186357488 "Notice that our curve is given by the explicit Cartesian equation $y=\\pi {x}^{2}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) &=x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}=t\\hspace{0.167em}\\mathbf{i}+\\pi {t}^{2}\\hspace{0.167em}\\mathbf{j},\\hspace{2em}t\\in [0,1]\\end{aligned}\n$$\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=\\mathbf{i}+2\\pi t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{cos}⁡\\left(\\frac{y}{{x}^{2}}\\right)\\,dx+4{x}^{2}\\,dy & ={\\int }_{0}^{1}\\operatorname{cos}⁡\\left(\\frac{y}{{x}^{2}}\\right)\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+4{x}^{2}\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(\\operatorname{cos}⁡\\left(\\frac{y}{{x}^{2}}\\right)\\frac{\\text{d}x}{\\text{d}t}+4{x}^{2}\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}\\operatorname{cos}⁡\\left(\\frac{\\pi {t}^{2}}{{t}^{2}}\\right)\\cdot 1+4{t}^{2}\\cdot 2\\pi t\\,dt \\\\  & ={\\int }_{0}^{1}\\operatorname{cos}⁡\\pi +8\\pi {t}^{3}\\,dt \\\\  & ={\\int }_{0}^{1}8\\pi {t}^{3}-1\\,dt \\\\  & =[2\\pi {t}^{4}-t]_{0}^{1} \\\\  & =[2\\pi (1)^{4}-1]-[0] \\\\  & =2\\pi -1\\end{aligned}\n$$"] [17592186360484 "![](images/11/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{cos}⁡(st), \\\\ \\frac{∂f}{∂y} & =\\operatorname{sin}⁡(st).\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =s\\operatorname{cos}⁡(st), \\\\ \\frac{∂y}{∂t} & =-s\\operatorname{sin}⁡(st).\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =(\\operatorname{cos}(st))(s\\operatorname{cos}(st))+(\\operatorname{sin}(st))(-s\\operatorname{sin}(st)) \\\\  & =s{\\operatorname{cos}}^{2}(st)-s{\\operatorname{sin}}^{2}(st) \\\\  & =s({\\operatorname{cos}}^{2}(st)-{\\operatorname{sin}}^{2}(st)) \\\\  & =s\\operatorname{cos}(2st).\\end{aligned}\n$$"] [17592186360524 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n\\mathrm{∇}f(x,y)=2x\\hspace{0.167em}\\mathbf{i}+2y\\hspace{0.167em}\\mathbf{j}.\n$$\n\nFirst, we substitute $x={e}^{-t}$ and $y={e}^{t}$ into $∇f(x,y)$ to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =2{e}^{-t}\\hspace{0.167em}\\mathbf{i}+2{e}^{t}\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{-t})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\hspace{0.167em}\\mathbf{j} \\\\  & =(-{e}^{-t})\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(2{e}^{-t}\\hspace{0.167em}\\mathbf{i}+2{e}^{t}\\hspace{0.167em}\\mathbf{j})\\cdot ((-{e}^{-t})\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}) \\\\  & =2{e}^{-t}\\cdot (-{e}^{-t})+2{e}^{t}\\cdot {e}^{t} \\\\  & =2{e}^{2t}-2{e}^{-2t}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(1))] & =2{e}^{2(1)}-2{e}^{-2(1)} \\\\  & =2{e}^{2}-2{e}^{-2}.\\end{aligned}\n$$"] [17592186360525 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n\\mathrm{∇}f(x,y)=-y\\operatorname{sin}(xy)\\hspace{0.167em}\\mathbf{i}-x\\operatorname{sin}(xy)\\hspace{0.167em}\\mathbf{j}.\n$$\n\nFirst, we substitute $x=2\\sqrt{t}$ and $y=-2\\sqrt{t}$ into $∇f(x,y)$ to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =-(-2\\sqrt{t})\\operatorname{sin}[(2\\sqrt{t})(-2\\sqrt{t})]\\hspace{0.167em}\\mathbf{i}-2\\sqrt{t}\\operatorname{sin}[(2\\sqrt{t})(-2\\sqrt{t})]\\hspace{0.167em}\\mathbf{j} \\\\  & =-2\\sqrt{t}\\operatorname{sin}(4t)\\hspace{0.167em}\\mathbf{i}+2\\sqrt{t}\\operatorname{sin}(4t)\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{t})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(-2\\sqrt{t})\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{1}{\\sqrt{t}}\\hspace{0.167em}\\mathbf{i}+\\left(-\\frac{1}{\\sqrt{t}}\\right)\\mathbf{j}.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(-2\\sqrt{t}\\operatorname{sin}(4t)\\hspace{0.167em}\\mathbf{i}+2\\sqrt{t}\\operatorname{sin}(4t)\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{1}{\\sqrt{t}}\\hspace{0.167em}\\mathbf{i}+\\left(-\\frac{1}{\\sqrt{t}}\\right)\\mathbf{i}) \\\\  & =(-2\\sqrt{t}\\operatorname{sin}(4t))\\cdot \\frac{1}{\\sqrt{t}}+2\\sqrt{t}\\operatorname{sin}(4t)\\cdot \\left(-\\frac{1}{\\sqrt{t}}\\right) \\\\  & =-2\\operatorname{sin}(4t)-2\\operatorname{sin}(4t) \\\\  & =-4\\operatorname{sin}(4t).\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi }{8},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}\\left(\\frac{\\pi }{8}\\right))] & =-4\\operatorname{sin}(4\\cdot \\frac{\\pi }{8}) \\\\  & =-4\\operatorname{sin}\\left(\\frac{\\pi }{2}\\right) \\\\  & =-4.\\end{aligned}\n$$"] [17592186360526 "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $\\mathbf{r}(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}({x}^{2}-{y}^{2}),\\frac{∂}{∂y}({x}^{2}-{y}^{2})⟩ \\\\  & =⟨2x,-2y⟩\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{2}$ and $y=2t-1$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =⟨2{t}^{2},-2(2t-1)⟩ \\\\  & =⟨2{t}^{2},2-4t⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\frac{\\text{d}}{\\text{d}t}(2t-1)⟩ \\\\  & =⟨2t,2⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =⟨2{t}^{2},2-4t⟩\\cdot ⟨2t,2⟩ \\\\  & =2{t}^{2}\\cdot 2t+(2-4t)\\cdot 2 \\\\  & =4{t}^{3}-8t+4.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $\\mathbf{r}(t)$ at $t=0$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(0))] & =4(0)^{3}-8(0)+4 \\\\  & =4.\\end{aligned}\n$$"] [17592186360527 "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $\\mathbf{r}(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(xyz),\\frac{∂}{∂y}(xyz),\\frac{∂}{∂z}(xyz)⟩ \\\\  & =⟨yz,xz,xy⟩\\end{aligned}\n$$\n\nNext, we substitute $x=2t,y=\\sqrt{t}$ and $z=3t-1$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =⟨\\sqrt{t}(3t-1),2t(3t-1),2t\\sqrt{t}⟩ \\\\  & =⟨(3t-1)\\sqrt{t},6{t}^{2}-2t,2t\\sqrt{t}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}),\\frac{\\text{d}}{\\text{d}t}(3t-1)⟩ \\\\  & =⟨2,\\frac{1}{2\\sqrt{t}},3⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =⟨(3t-1)\\sqrt{t},6{t}^{2}-2t,2t\\sqrt{t}⟩\\cdot ⟨2,\\frac{1}{2\\sqrt{t}},3⟩ \\\\  & =(3t-1)\\sqrt{t}\\cdot 2+(6{t}^{2}-2t)\\cdot \\frac{1}{2\\sqrt{t}}+2t\\sqrt{t}\\cdot 3 \\\\  & =6t\\sqrt{t}-2\\sqrt{t}+\\frac{3{t}^{2}-t}{\\sqrt{t}}+6t\\sqrt{t} \\\\  & =12t\\sqrt{t}-2\\sqrt{t}+\\frac{3{t}^{2}-t}{\\sqrt{t}}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $\\mathbf{r}(t)$ at $t=1$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(1))] & =12(1)\\sqrt{1}-2\\sqrt{1}+\\frac{3(1)^{2}-1}{\\sqrt{1}} \\\\  & =12.\\end{aligned}\n$$"] [17592186360528 "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $\\mathbf{r}(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(x{z}^{2}+{y}^{3}),\\frac{∂}{∂y}(x{z}^{2}+{y}^{3}),\\frac{∂}{∂z}(x{z}^{2}+{y}^{3})⟩ \\\\  & =⟨{z}^{2},3{y}^{2},2xz⟩\\end{aligned}\n$$\n\nNext, we substitute $x=t,$ $y=4$ and $z=\\sqrt{{t}^{2}-3}$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =⟨(\\sqrt{{t}^{2}-3})^{2},3(4)^{2},2t\\sqrt{{t}^{2}-3}⟩ \\\\  & =⟨{t}^{2}-3,48,2t\\sqrt{{t}^{2}-3}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\frac{\\text{d}}{\\text{d}t}(4),\\sqrt{{t}^{2}-3}⟩ \\\\  & =⟨1,0,\\frac{t}{\\sqrt{{t}^{2}-3}}⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =⟨{t}^{2}-3,48,2t\\sqrt{{t}^{2}-3}⟩\\cdot ⟨1,0,\\frac{t}{\\sqrt{{t}^{2}-3}}⟩ \\\\  & =({t}^{2}-3)\\cdot 1+48\\cdot 0+2t\\sqrt{{t}^{2}-3}\\cdot \\frac{t}{\\sqrt{{t}^{2}-3}} \\\\  & ={t}^{2}-3+0+2{t}^{2} \\\\  & =3{t}^{2}-3.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $\\mathbf{r}(t)$ at $t=2$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(2))] & =3(2)^{2}-3 \\\\  & =12-3 \\\\  & =9.\\end{aligned}\n$$"] [17592186360529 "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $\\mathbf{r}(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})),\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})),\\frac{∂}{∂z}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}))⟩ \\\\  & =⟨\\frac{2x}{{x}^{2}+{y}^{2}+{z}^{2}},\\frac{2y}{{x}^{2}+{y}^{2}+{z}^{2}},\\frac{2z}{{x}^{2}+{y}^{2}+{z}^{2}}⟩\\end{aligned}\n$$\n\nNext, we substitute $x=t-1,$ $y=3$ and $z=2t$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =⟨\\frac{2(t-1)}{(t-1)^{2}+(3)^{2}+(2t)^{2}},\\frac{2(3)}{(t-1)^{2}+(3)^{2}+(2t)^{2}},\\frac{2(2t)}{(t-1)^{2}+(3)^{2}+(2t)^{2}}⟩ \\\\  & =⟨\\frac{2t-2}{5{t}^{2}-2t+10},\\frac{6}{5{t}^{2}-2t+10},\\frac{4t}{5{t}^{2}-2t+10}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t-1),\\frac{\\text{d}}{\\text{d}t}(3),2t⟩ \\\\  & =⟨1,0,2⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =⟨\\frac{2t-2}{5{t}^{2}-2t+10},\\frac{6}{5{t}^{2}-2t+10},\\frac{4t}{5{t}^{2}-2t+10}⟩\\cdot ⟨1,0,2⟩ \\\\  & =\\frac{2t-2}{5{t}^{2}-2t+10}\\cdot 1+\\frac{6}{5{t}^{2}-2t+10}\\cdot 0+\\frac{4t}{5{t}^{2}-2t+10}\\cdot 2 \\\\  & =\\frac{2t-2+8t}{5{t}^{2}-2t+10} \\\\  & =\\frac{10t-2}{5{t}^{2}-2t+10}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $\\mathbf{r}(t)$ at $t=0$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(0))] & =\\frac{10(0)-2}{5(0)^{2}-2(0)+10} \\\\  & =\\frac{-2}{10} \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$"]}
