u}^{'}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{\\mathbf{g}}^{'}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\operatorname{ln}u \\\\ \\frac{\\text{d}}{\\text{d}u}\\hspace{0.167em}\\hspace{0.167em}5\\hspace{0.167em}\\hspace{0.167em} \\\\ \\frac{\\text{d}}{\\text{d}u}\\hspace{0.167em}\\hspace{0.167em}{u}^{2}\\hspace{0.167em}\\hspace{0.167em}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{u} \\\\ 0 \\\\ 2u\\end{bmatrix} \\\\ {u}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}t)=\\frac{1}{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(\\mathbf{g}∘u)^{'}(t) & =\\mathbf{g}'(u(t))u'(t) \\\\  & =\\begin{bmatrix}\\frac{1}{u(t)} \\\\ 0 \\\\ 2u(t)\\end{bmatrix}{u}^{'}(t) \\\\  & =\\frac{1}{t}\\begin{bmatrix}\\frac{1}{\\operatorname{ln}t} \\\\ 0 \\\\ 2\\operatorname{ln}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{t\\operatorname{ln}t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}t}{t}\\end{bmatrix}\\end{aligned}\n$$"] [17592186304791 "By the chain rule, we have \n\n$$\n(\\mathbf{g}∘u)^{'}(t)=\\mathbf{g}'(u(t))u'(t)\n$$\n\nNow, let's find the derivatives of each function:\n\n$$\n\\begin{aligned}{\\mathbf{g}}^{'}(u) & =⟨\\frac{\\text{d}}{\\text{d}u}\\operatorname{ln}u,\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}u}0,\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}u}\\left(\\frac{1}{u}\\right)⟩ \\\\  & =⟨\\frac{1}{u},\\hspace{0.222em}0,\\hspace{0.222em}-\\frac{1}{{u}^{2}}⟩ \\\\ {u}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t})=2{e}^{2t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(\\mathbf{g}∘u)^{'}(t) & =\\mathbf{g}'(u(t))u'(t) \\\\  & =⟨\\frac{1}{u(t)},\\hspace{0.222em}0,\\hspace{0.222em}-\\frac{1}{{u}^{2}(t)}⟩{u}^{'}(t) \\\\  & =2{e}^{2t}⟨\\frac{1}{{e}^{2t}},\\hspace{0.222em}0,\\hspace{0.222em}-\\frac{1}{({e}^{2t})^{2}}⟩ \\\\  & =⟨\\frac{2{e}^{2t}}{{e}^{2t}},\\hspace{0.222em}0,\\hspace{0.222em}-\\frac{2{e}^{2t}}{{e}^{4t}}⟩ \\\\  & =⟨2,\\hspace{0.222em}0,\\hspace{0.222em}-2{e}^{-2t}⟩\\end{aligned}\n$$"] [17592186304891 "Using the constant multiple and the sum rules, we have \n\n$$\n(2\\mathbf{f}(t)+3\\mathbf{g}(t))^{'}=2{\\mathbf{f}}^{'}(t)+3{\\mathbf{g}}^{'}(t)\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}-\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{k} \\\\  & =2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k} \\\\ {\\mathbf{g}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(5-\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}-\\frac{\\text{d}}{\\text{d}t}1\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{k} \\\\  & =-\\operatorname{cos}t\\mathbf{i}-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nHence \n\n$$\n\\begin{aligned}(2\\mathbf{f}(t)+3\\mathbf{g}(t))^{'} & =2{\\mathbf{f}}^{'}(t)+3{\\mathbf{g}}^{'}(t) \\\\  & =2(2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k})+3(-\\operatorname{cos}t\\mathbf{i}-2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k}) \\\\  & =4\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-6\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+6\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k}-3\\operatorname{cos}t\\mathbf{i}-6\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-6\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$"] [17592186305066 "By the chain rule, we have\n\n$$\n(\\mathbf{f}∘u)^{'}(t)=\\mathbf{f}'(u(t))u'(t)\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(u) & =\\frac{\\text{d}}{\\text{d}u}({e}^{u+1})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}u}({e}^{2u})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}u}\\frac{1}{e}\\hspace{0.167em}\\mathbf{k} \\\\  & ={e}^{u+1}\\hspace{0.167em}\\mathbf{i}+2{e}^{2u}\\hspace{0.167em}\\mathbf{j}+0\\hspace{0.167em}\\mathbf{k} \\\\  & ={e}^{u+1}\\hspace{0.167em}\\mathbf{i}+2{e}^{2t}\\hspace{0.167em}\\mathbf{j} \\\\ {u}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})=4t\\end{aligned}\n$$\n\n \nTherefore, we obtain:\n\n$$\n\\begin{aligned}(\\mathbf{f}∘u)^{'}(t) & =\\mathbf{f}'(u(t))u'(t) \\\\ (\\mathbf{f}∘u)^{'}(t) & =({e}^{2{t}^{2}+1}\\hspace{0.167em}\\mathbf{i}+2{e}^{4{t}^{2}}\\hspace{0.167em}\\mathbf{j})4t \\\\  & =4t{e}^{2{t}^{2}+1}\\hspace{0.167em}\\mathbf{i}+8t{e}^{4{t}^{2}}\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$"] [17592186308444 "Using the dot product rule, we can write:\n\n$$\n(\\mathbf{f}\\cdot \\mathbf{g})^{'}(t)={\\mathbf{f}}^{'}(t)\\cdot \\mathbf{g}(t)+\\mathbf{f}(t)\\cdot {\\mathbf{g}}^{'}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+\\left(-\\frac{1}{{t}^{2}}\\right)\\hspace{0.167em}\\mathbf{j}+1\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}-\\frac{1}{{t}^{2}}\\hspace{0.167em}\\mathbf{j}+\\mathbf{k} \\\\ {\\mathbf{g}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}t)\\hspace{0.167em}\\mathbf{k} \\\\  & =1\\hspace{0.167em}\\mathbf{i}+\\left(-\\frac{1}{{t}^{2}}\\right)\\hspace{0.167em}\\mathbf{j}+\\frac{1}{t}\\hspace{0.167em}\\mathbf{k} \\\\  & =\\mathbf{i}-\\frac{1}{{t}^{2}}\\hspace{0.167em}\\mathbf{j}+\\frac{1}{t}\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(\\mathbf{f}\\cdot \\mathbf{g})^{'}(t) & ={\\mathbf{f}}^{'}(t)\\cdot \\mathbf{g}(t)+\\mathbf{f}(t)\\cdot {\\mathbf{g}}^{'}(t) \\\\  & =(\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}-\\frac{1}{{t}^{2}}\\hspace{0.167em}\\mathbf{j}+\\mathbf{k})\\cdot (t\\hspace{0.167em}\\mathbf{i}+\\frac{1}{t}\\hspace{0.167em}\\mathbf{j}+\\operatorname{ln}t\\hspace{0.167em}\\mathbf{k})+(\\operatorname{ln}t\\hspace{0.167em}\\mathbf{i}+\\frac{1}{t}\\hspace{0.167em}\\mathbf{j}+t\\hspace{0.167em}\\mathbf{k})\\cdot (\\mathbf{i}-\\frac{1}{{t}^{2}}\\hspace{0.167em}\\mathbf{j}+\\frac{1}{t}\\hspace{0.167em}\\mathbf{k}) \\\\  & =(\\frac{1}{t}\\cdot t-\\frac{1}{{t}^{2}}\\cdot \\frac{1}{t}+1\\cdot \\operatorname{ln}t)+(\\operatorname{ln}t\\cdot 1+\\frac{1}{t}\\left(-\\frac{1}{{t}^{2}}\\right)+t\\cdot \\frac{1}{t}) \\\\  & =1-\\frac{1}{{t}^{3}}+\\operatorname{ln}t+\\operatorname{ln}t-\\frac{1}{{t}^{3}}+1 \\\\  & =2\\operatorname{ln}t+2-\\frac{2}{{t}^{3}}\\end{aligned}\n$$"] [17592186308623 "By the scalar function multiple rule, we have\n\n$$\n(v(t)\\mathbf{f}(t))^{'}=v(t){\\mathbf{f}}^{'}(t)+{v}^{'}(t)\\mathbf{f}(t)\n$$\n\nLet's find ${v}^{′}(t)$ and ${\\mathbf{f}}^{'}(t).$\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({2}^{t}),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}({2}^{t+1}),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}({2}^{2t}+1)⟩ \\\\  & =⟨{2}^{t}\\operatorname{ln}2,\\hspace{0.222em}{2}^{t+1}\\operatorname{ln}2,\\hspace{0.222em}2\\cdot {2}^{2t}\\operatorname{ln}2⟩ \\\\ {v}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{{2}^{t}}\\right)=-\\frac{\\operatorname{ln}2}{{2}^{t}}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(v(t)\\mathbf{f}(t))^{'} & =v(t){\\mathbf{f}}^{'}(t)+{v}^{'}(t)\\mathbf{f}(t) \\\\  & =\\frac{1}{{2}^{t}}⟨{2}^{t}\\operatorname{ln}2,\\hspace{0.222em}{2}^{t+1}\\operatorname{ln}2,\\hspace{0.222em}2\\cdot {2}^{2t}\\operatorname{ln}2⟩-\\frac{\\operatorname{ln}2}{{2}^{t}}⟨{2}^{t},\\hspace{0.222em}{2}^{t+1},\\hspace{0.222em}{2}^{2t}+1⟩ \\\\  & =⟨\\frac{{2}^{t}\\operatorname{ln}2}{{2}^{t}},\\hspace{0.222em}\\frac{{2}^{t+1}\\operatorname{ln}2}{{2}^{t}},\\hspace{0.222em}\\frac{2\\cdot {2}^{2t}\\operatorname{ln}2}{{2}^{t}}⟩-⟨\\frac{{2}^{t}\\operatorname{ln}2}{{2}^{t}},\\hspace{0.222em}\\frac{{2}^{t+1}2\\operatorname{ln}2}{{2}^{t}},\\hspace{0.222em}\\frac{({2}^{2t}+1)\\operatorname{ln}2}{{2}^{t}}⟩ \\\\  & =⟨0,\\hspace{0.222em}0,\\hspace{0.222em}\\frac{({2}^{2t}-1)\\operatorname{ln}2}{{2}^{t}}⟩\\end{aligned}\n$$"] [17592186314703 "First, we find ${\\mathbf{f}}^{'}(t)$ and $‖{\\mathbf{f}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}2t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}2t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}({t}^{2})⟩ \\\\  & =⟨2\\operatorname{cos}2t,\\hspace{0.167em}-2\\operatorname{sin}2t,\\hspace{0.167em}2t⟩ \\\\ ‖{\\mathbf{f}}^{'}(t)‖ & =\\sqrt{(2\\operatorname{cos}2t)^{2}+(-2\\operatorname{sin}2t)^{2}+(2t)^{2}} \\\\  & =\\sqrt{4{\\operatorname{cos}}^{2}2t+4{\\operatorname{sin}}^{2}2t+4{t}^{2}} \\\\  & =\\sqrt{4({\\operatorname{cos}}^{2}2t+{\\operatorname{sin}}^{2}2t+{t}^{2})} \\\\  & =2\\sqrt{1+{t}^{2}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{\\mathbf{f}}^{'}(t)‖\\hspace{0.167em}\\text{d}t={\\int }_{0}^{1}2\\sqrt{1+{t}^{2}}\\hspace{0.167em}\\text{d}t\\end{aligned}\n$$"] [17592186323770 "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $\\mathbf{r}(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}({x}^{3}+{y}^{2}),\\frac{∂}{∂y}({x}^{3}+{y}^{2})⟩ \\\\  & =⟨3{x}^{2},2y⟩\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t$ and $y=\\operatorname{cos}⁡t$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =⟨3{\\operatorname{sin}}^{2}t,2\\operatorname{cos}t⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t)⟩ \\\\  & =⟨\\operatorname{cos}t,-\\operatorname{sin}t⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =⟨3{\\operatorname{sin}}^{2}t,2\\operatorname{cos}t⟩\\cdot ⟨\\operatorname{cos}t,-\\operatorname{sin}t⟩ \\\\  & =3{\\operatorname{sin}}^{2}t\\cdot \\operatorname{cos}t+2\\operatorname{cos}t\\cdot (-\\operatorname{sin}t) \\\\  & =3{\\operatorname{sin}}^{2}t\\operatorname{cos}t-2\\operatorname{sin}t\\operatorname{cos}t.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $\\mathbf{r}(t)$ at $t=\\frac{\\pi }{4}$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}\\left(\\frac{\\pi }{4}\\right))] & =3{\\operatorname{sin}}^{2}\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}\\left(\\frac{\\pi }{4}\\right)-2\\operatorname{sin}\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}\\left(\\frac{\\pi }{4}\\right) \\\\  & =3\\cdot {\\left(\\frac{\\sqrt{2}}{2}\\right)}^{2}\\cdot \\frac{\\sqrt{2}}{2}-2\\cdot \\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{3\\sqrt{2}}{4}-1 \\\\  & =\\frac{3\\sqrt{2}-4}{4}.\\end{aligned}\n$$"] [17592186323790 "The directional derivative ${f}_{\\mathbf{u}}^{'}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $\\mathbf{v}$ is given by\n\n$$\n{f}_{\\mathbf{u}}^{'}(a,b)=\\mathrm{∇}f(a,b)\\cdot \\mathbf{u}\n$$\n\nwhere $\\mathbf{u}$ is a unit vector in the direction of $\\mathbf{v}.$\n\nFirst, we find the direction vector and the corresponding unit vector:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,1⟩-⟨1,0⟩ \\\\  & =⟨-1,1⟩ \\\\ \\mathbf{u} & =\\frac{\\overset{\\to }{AB}}{‖\\overset{\\to }{AB}‖} \\\\  & =\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}}}⟨-1,1⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we calculate the gradient $∇f(x,y)$ and evaluate it at the point $A(1,0):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =⟨\\frac{∂}{∂x}(x{e}^{y}+{x}^{2}y),\\,\\frac{∂}{∂y}(x{e}^{y}+{x}^{2}y)⟩ \\\\  & =⟨{e}^{y}+2xy,\\,x{e}^{y}+{x}^{2}⟩ \\\\ ∇\\,f(1,0) & =⟨{e}^{0}+2\\cdot 1\\cdot 0,\\,1\\cdot {e}^{0}+{1}^{2}⟩ \\\\  & =⟨1,\\,2⟩\\end{aligned}\n$$\n\nTherefore, the directional derivative is:\n\n$$\n\\begin{aligned}{f}_{\\mathbf{u}}^{'}(1,0) & =\\mathrm{∇}f(1,0)\\cdot \\mathbf{u} \\\\  & =⟨1,\\hspace{0.222em}2⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$"] [17592186323791 "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(1,3):$\n\n$$\n\\begin{aligned}-\\mathrm{∇}\\hspace{-0.167em}f(x,y) & =-\\frac{∂}{∂x}(2xy+{e}^{3x-y})\\text{ }\\mathbf{i}-\\frac{∂}{∂y}(2xy+{e}^{3x-y})\\text{ }\\mathbf{j} \\\\  & =-(2y+3{e}^{3x-y})\\text{ }\\mathbf{i}-(2x-{e}^{3x-y})\\text{ }\\mathbf{j} \\\\ -\\mathrm{∇}\\hspace{-0.167em}f(1,3) & =-(2\\cdot 3+3\\cdot {e}^{3\\cdot 1-3})\\text{ }\\mathbf{i}-(2\\cdot 1-{e}^{3\\cdot 1-3})\\text{ }\\mathbf{j} \\\\  & =-9\\text{ }\\mathbf{i}-\\text{ }\\mathbf{j}\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction of $-∇f(1,3)$ is given by\n\n$$\n\\begin{aligned}‖-\\mathrm{∇}\\hspace{-0.167em}f(1,3)‖ & =‖-9\\text{ }\\mathbf{i}-\\text{ }\\mathbf{j}‖ \\\\  & =\\sqrt{(-9)^{2}+(-1)^{2}} \\\\  & =\\sqrt{82}.\\end{aligned}\n$$"] [17592186323794 "A normal vector to the level curve that passes through the point  where $(x,y)=(1,1)$, can be found by computing $∇g(1,1).$ \n\nSo, we first find the gradient of $g(x,y)$ and evaluate it at $(x,y)=(1,1):$ \n\n$$\n\\begin{aligned}∇g(x,y) & ={g}_{x}(x,y)\\,i+{g}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy))\\,j \\\\  & =\\frac{1}{xy}\\cdot y\\,i+\\frac{1}{xy}\\cdot x\\,j \\\\  & =\\frac{1}{x}\\,i+\\frac{1}{y}\\,j \\\\ ∇g(1,1) & =\\frac{1}{(1)}\\,i+\\frac{1}{(1)}\\,j \\\\  & =i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇g(1,1):$\n\n$$\n\\begin{aligned}\\frac{\\mathrm{∇}g(1,1)}{‖\\mathrm{∇}g(1,1)‖} & =\\frac{\\mathbf{i}+\\mathbf{j}}{\\sqrt{{1}^{2}+{1}^{2}}} \\\\  & =\\frac{\\sqrt{2}}{2}(\\mathbf{i}+\\mathbf{j})\\end{aligned}\n$$"] [17592186323795 "First, we bring all variables to one side: \n\n$$\n\\begin{aligned}2xy+6{y}^{2} & =x-2 \\\\ 2xy+6{y}^{2}-x & =-2\\end{aligned}\n$$\n\nIf we set $f(x,y)=2xy+6{y}^{2}-x$, our curve can be viewed as the level curve $f(x,y)=-2.$   \n\nA normal vector to the level curve that passes through the point $(8,-3)$ can be found by computing $∇f(8,-3).$ \n\nSo, we find the gradient and evaluate it at $(8,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2xy+6{y}^{2}-x)\\,i+\\frac{∂}{∂y}(2xy+6{y}^{2}-x)\\,j \\\\  & =(2y-1)\\,i+(2x+12y)\\,j \\\\ ∇f(8,-3) & =(2(-3)-1)\\,i+(2(8)+12(-3))\\,j \\\\  & =-7\\,i-20\\,j \\\\  & =⟨-7,-20⟩\\end{aligned}\n$$\n\n Hence, $∇f(8,-3)=⟨-7,-20⟩$ is a normal vector to the curve at $(8,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $\\mathbf{v}=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as: \n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-8}{-7} & =\\frac{y-(-3)}{-20} \\\\ -20(x-8) & =-7(y+3) \\\\ -20x+7y+160+21 & =0 \\\\ -20x+7y+181 & =0\\end{aligned}\n$$"] [17592186323821 "The formula for the area of the triangle is \n\n$$\n\\mathcal{A}=\\frac{1}{2}bc\\operatorname{sin}A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=8\\,\\text{cm}, \\\\ b & =AC=10\\,\\text{cm}\\end{aligned}\n$$\n\nTherefore, we can calculate $m∠A$ as follows:\n\n$$\n\\begin{aligned}\\mathcal{A} & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}A \\\\ 20\\sqrt{2} & =\\frac{1}{2}\\cdot 10\\cdot 8\\cdot \\operatorname{sin}A \\\\ 20\\sqrt{2} & =40\\cdot \\operatorname{sin}A \\\\ \\frac{20\\sqrt{2}}{40} & =\\operatorname{sin}A \\\\ \\operatorname{sin}A & =\\frac{\\sqrt{2}}{2} \\\\ m\\mathrm{∠}A & ={45}^{∘}.\\end{aligned}\n$$"] [17592186323861 "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\frac{1}{xy}\\cdot y+0 \\\\  & =\\frac{1}{x} \\\\ {g}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\frac{1}{xy}\\cdot x-\\operatorname{sin}⁡({y}^{2})\\cdot 2y \\\\  & =\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}\\mathrm{∇}g(x,y) & ={g}_{x}(x,y)\\text{ }\\mathbf{i}+{g}_{y}(x,y)\\text{ }\\mathbf{j} \\\\  & =\\frac{1}{x}\\text{ }\\mathbf{i}+(\\frac{1}{y}-2y\\operatorname{sin}({y}^{2}))\\text{ }\\mathbf{j}\\end{aligned}\n$$"] [17592186323869 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y,z)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{\\text{i}}+\\frac{∂f}{∂y}\\hspace{0.167em}\\mathbf{\\text{j}}+\\frac{∂f}{∂z}\\hspace{0.167em}\\mathbf{\\text{k}}.\n$$\n\nSince $\\mathrm{∇}f(x,y,z)=\\mathbf{F}(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=2\\operatorname{cos}⁡(2x),\\,\\frac{∂f}{∂y}=2yz,\\,\\frac{∂f}{∂z}={y}^{2}\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int 2\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡(2x)+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=2yz$ into account, we obtain\n\n$$\n\\begin{aligned}\\frac{∂g}{∂y} & =2yz\\end{aligned}\n$$\n\nNow we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int (2yz)\\,\\text{d}y \\\\  & ={y}^{2}z+h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)={y}^{2}z+h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)=\\operatorname{sin}⁡(2x)+{y}^{2}z+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}={y}^{2}+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}={y}^{2}$ into account, we obtain\n\n$$\n\\begin{aligned}{y}^{2}+{h}^{′}(z) & ={y}^{2} \\\\ {h}^{′}(z) & =0 \\\\ h(z) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=\\operatorname{sin}⁡(2x)+{y}^{2}z+C.\n$$"] [17592186323875 "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(2,-1):$\n\n$$\n\\begin{aligned}-\\mathrm{∇}\\hspace{-0.167em}f(x,y) & =-\\frac{∂}{∂x}((x+y)\\operatorname{ln}(x+y))\\text{ }\\mathbf{i}-\\frac{∂}{∂y}((x+y)\\operatorname{ln}(x+y))\\text{ }\\mathbf{j} \\\\  & =(\\operatorname{ln}(x+y)+1)\\text{ }\\mathbf{i}+(\\operatorname{ln}(x+y)+1)\\text{ }\\mathbf{j} \\\\ -\\mathrm{∇}\\hspace{-0.167em}f(2,-1) & =-(\\operatorname{ln}(2-1)+1)\\mathbf{i}-(\\operatorname{ln}(2-1)+1)\\mathbf{j} \\\\  & =-\\mathbf{i}-\\mathbf{j}\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(2,-1)$ in the direction of $-∇f(2,-1)$ is given by\n\n$$\n\\begin{aligned}‖-\\mathrm{∇}\\hspace{-0.167em}f(2,-1)‖ & =‖-\\mathbf{i}-\\mathbf{j}‖ \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"] [17592186323878 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y) & =\\frac{∂}{∂x}(2x-x{y}^{2})\\hspace{0.167em}\\mathbf{i}+\\frac{∂}{∂y}(2x-x{y}^{2})\\hspace{0.167em}\\mathbf{j} \\\\  & =(2-{y}^{2})\\hspace{0.167em}\\mathbf{i}-2xy\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{ln}⁡t$ and $y=3{t}^{2}$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =(2-9{t}^{4})\\hspace{0.167em}\\mathbf{i}-6{t}^{2}\\operatorname{ln}t\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+6t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =((2-9{t}^{4})\\hspace{0.167em}\\mathbf{i}-6{t}^{2}\\operatorname{ln}t\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+6t\\hspace{0.167em}\\mathbf{j}) \\\\  & =(2-9{t}^{4})\\cdot \\frac{1}{t}+(-6{t}^{2}\\operatorname{ln}t)\\cdot 6t \\\\  & =\\frac{2}{t}-9{t}^{3}-36{t}^{3}\\operatorname{ln}t.\\end{aligned}\n$$"] [17592186323880 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n\\mathrm{∇}f(x,y)=\\frac{1}{x}\\hspace{0.167em}\\mathbf{i}+\\frac{1}{y}\\hspace{0.167em}\\mathbf{j}.\n$$\n\nFirst, we substitute $x=2{t}^{2}+2$ and $y=\\operatorname{arctan}⁡t$ into $∇f(x,y)$ to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}\\hspace{-0.167em}f(\\mathbf{r}(t)) & =\\frac{1}{2{t}^{2}+2}\\text{ }\\mathbf{i}+\\frac{1}{\\operatorname{arctan}t}\\text{ }\\mathbf{j}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+2)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}t)\\hspace{0.167em}\\mathbf{j} \\\\  & =4t\\hspace{0.167em}\\mathbf{i}+\\frac{1}{1+{t}^{2}}\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(\\frac{1}{2{t}^{2}+2}\\hspace{0.167em}\\mathbf{i}+\\frac{1}{\\operatorname{arctan}t}\\hspace{0.167em}\\mathbf{j})\\cdot (4t\\hspace{0.167em}\\mathbf{i}+\\frac{1}{1+{t}^{2}}\\hspace{0.167em}\\mathbf{j}) \\\\  & =\\frac{1}{2{t}^{2}+2}\\cdot 4t+\\frac{1}{\\operatorname{arctan}t}\\cdot \\frac{1}{1+{t}^{2}} \\\\  & =\\frac{2t}{{t}^{2}+1}+\\frac{1}{({t}^{2}+1)\\operatorname{arctan}t} \\\\  & =\\frac{2t\\operatorname{arctan}t+1}{({t}^{2}+1)\\operatorname{arctan}t}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(1))] & =\\frac{2(1)\\operatorname{arctan}1+1}{({1}^{2}+1)\\operatorname{arctan}1} \\\\  & =\\frac{(2\\cdot \\frac{\\pi }{4}+1)}{(2\\cdot \\frac{\\pi }{4})} \\\\  & =\\frac{\\pi +2}{\\pi }.\\end{aligned}\n$$"] [17592186323883 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n\\mathrm{∇}f(x,y)=y(\\operatorname{ln}x+1)\\hspace{0.167em}\\mathbf{i}+x\\operatorname{ln}x\\hspace{0.167em}\\mathbf{j}.\n$$\n\nFirst, we substitute $x={e}^{2t}$ and $y=\\operatorname{sin}⁡(2t)$ into $∇f(x,y)$ to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}\\hspace{-0.167em}f(\\mathbf{r}(t)) & =\\operatorname{sin}(2t)(\\operatorname{ln}{e}^{2t}+1)\\hspace{0.167em}\\mathbf{i}+{e}^{2t}\\operatorname{ln}{e}^{2t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\operatorname{sin}(2t)(2t+1)\\hspace{0.167em}\\mathbf{i}+2t{e}^{2t}\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(2t))\\hspace{0.167em}\\mathbf{j} \\\\  & =2{e}^{2t}\\hspace{0.167em}\\mathbf{i}+2\\operatorname{cos}(2t)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(\\operatorname{sin}(2t)(2t+1)\\hspace{0.167em}\\mathbf{i}+2t{e}^{2t}\\hspace{0.167em}\\mathbf{j})\\cdot (2{e}^{2t}\\hspace{0.167em}\\mathbf{i}+2\\operatorname{cos}(2t)\\hspace{0.167em}\\mathbf{j}) \\\\  & =2{e}^{2t}(2t+1)\\operatorname{sin}(2t)+4t{e}^{2t}\\operatorname{cos}(2t) \\\\  & =2{e}^{2t}[(2t+1)\\operatorname{sin}(2t)+2t\\operatorname{cos}(2t)].\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=0,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(0))] & =2{e}^{2(0)}((2(0)+1)\\operatorname{sin}(2(0))+2(0)\\operatorname{cos}(2(0)))=0.\\end{aligned}\n$$"] [17592186323918 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡y & =8xy+2-8e \\\\ 2x\\operatorname{ln}⁡y-8xy & =2-8e\\end{aligned}\n$$\n\nIf we set $f(x,y)=2x\\operatorname{ln}⁡y-8xy$, our curve can be viewed as the level curve $f(x,y)=2-8e.$ \n\nA tangent vector to the level curve that passes through the point $(1,e)$ can be computed as follows:\n\n$$\n\\mathbf{t}(1,e)={f}_{y}(1,e)\\hspace{0.167em}\\mathbf{i}-{f}_{x}(1,e)\\hspace{0.167em}\\mathbf{j}\n$$\n\nSo, we calculate $\\mathbf{t}(x,y)$ and evaluate it at $(1,e):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(2x\\operatorname{ln}⁡y-8xy)\\,i-\\frac{∂}{∂x}(2x\\operatorname{ln}⁡y-8xy)\\,j \\\\  & =(\\frac{2x}{y}-8x)i-(2\\operatorname{ln}⁡y-8y)\\,j \\\\ t(1,e) & =(\\frac{2(1)}{e}-8(1))i-(2\\operatorname{ln}⁡e-8(e))\\,j \\\\  & =(\\frac{2}{e}-8)i+(8e-2)j\\end{aligned}\n$$\n\n  \n\nTherefore, our tangent vector is $(\\frac{2}{e}-8)\\mathbf{i}+(8e-2)\\hspace{0.167em}\\mathbf{j}.$"] [17592186323976 "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}(2\\theta )}r\\hspace{0.167em}\\text{d}r\\hspace{0.167em}\\text{d}\\theta  & ={\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}(2\\theta )}r\\hspace{0.167em}\\text{d}r\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}{[\\frac{{r}^{2}}{2}]}_{0}^{2\\operatorname{cos}(2\\theta )}\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}(\\frac{(2\\operatorname{cos}(2\\theta ))^{2}}{2}-0)\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}2{\\operatorname{cos}}^{2}(2\\theta )\\hspace{0.167em}\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}2{\\operatorname{cos}}^{2}(2\\theta )\\hspace{0.167em}\\text{d}\\theta  & ={\\int }_{-\\pi /2}^{\\pi /2}(1+\\operatorname{cos}(4\\theta ))\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={[\\theta +\\frac{1}{4}\\operatorname{sin}(4\\theta )]}_{-\\pi /2}^{\\pi /2} \\\\  & =(\\frac{\\pi }{2}+\\frac{\\pi }{2})+\\frac{1}{4}(\\operatorname{sin}(2\\pi )-\\operatorname{sin}(-2\\pi )) \\\\  & =\\pi \\end{aligned}\n$$"] [17592186326759 "The position vectors of the endpoints of our line segment are $\\mathbf{a}=\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}$ and $\\mathbf{b}=3\\hspace{0.167em}\\mathbf{i}+4\\hspace{0.167em}\\mathbf{j}.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}\\mathbf{r}(t) & =\\mathbf{a}+t\\hspace{0.167em}(\\mathbf{b}-\\mathbf{a}) \\\\  & =\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}+t(3\\hspace{0.167em}\\mathbf{i}+4\\hspace{0.167em}\\mathbf{j}-(\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j})) \\\\  & =\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}+t(2\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}) \\\\  & =(1+2t)\\hspace{0.167em}\\mathbf{i}+(2+2t)\\hspace{0.167em}\\mathbf{j},\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=1+2t$ and $y(t)=2+2t$ along the segment.\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=2\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,dx+y\\,dy & ={\\int }_{0}^{1}x\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+y\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(x\\frac{\\text{d}x}{\\text{d}t}+y\\frac{\\text{d}y}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}(1+2t)\\cdot 2+(2+2t)\\cdot 2\\,dt \\\\  & ={\\int }_{0}^{1}6+8t\\,dt \\\\  & ={[6t+4{t}^{2}]}_{0}^{1} \\\\  & =[6(1)+4(1)^{2}]-[0] \\\\  & =10\\end{aligned}\n$$"] [17592186326763 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=\\operatorname{arcsin}⁡t,\\,y=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =2\\operatorname{sin}(\\operatorname{arcsin}t)\\hspace{0.167em}\\mathbf{i}+(\\operatorname{arcsin}t+2)\\hspace{0.167em}\\mathbf{j} \\\\  & =2t\\hspace{0.167em}\\mathbf{i}+(\\operatorname{arcsin}t+2)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arcsin}t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(2)\\mathbf{j} \\\\  & =\\frac{1}{\\sqrt{1-{t}^{2}}}\\hspace{0.167em}\\mathbf{i}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(2t\\hspace{0.167em}\\mathbf{i}+(\\operatorname{arcsin}t+2)\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{1}{\\sqrt{1-{t}^{2}}}\\hspace{0.167em}\\mathbf{i}) \\\\  & =\\frac{2t}{\\sqrt{1-{t}^{2}}}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{1/2}\\mathbf{f}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1/2}\\frac{2t}{\\sqrt{1-{t}^{2}}}\\hspace{0.167em}\\mathrm{d}t \\\\  & =-2\\sqrt{1-{t}^{2}}\\hspace{0.167em}{|}_{0}^{1/2} \\\\  & =-2(\\sqrt{1-{\\left(\\frac{1}{2}\\right)}^{2}}-1) \\\\  & =2-\\sqrt{3}\\end{aligned}\n$$"] [17592186326775 "We will use the fact that\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}.\n$$\n\nWe're given the value of the second integral, so we only need to work out the first.\n\nThe path ${C}_{1}$ is the line segment from $A$ to $B.$  It can be parametrized as\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{1}(t) & =\\mathbf{a}+t(\\mathbf{b}-\\mathbf{a}) \\\\  & =⟨0,1⟩+t(⟨1,2⟩-⟨0,1⟩) \\\\  & =⟨t,1+t⟩ \\\\  & =t\\hspace{0.167em}\\mathbf{i}+(1+t)\\hspace{0.167em}\\mathbf{j},\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=t$ and $y=1+t.$ Therefore, \n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{1}(t)) & =(2x-3y)\\hspace{0.167em}\\mathbf{i}+(x+y)\\hspace{0.167em}\\mathbf{j} \\\\  & =(2t-3(1+t))\\hspace{0.167em}\\mathbf{i}+(t+(1+t))\\hspace{0.167em}\\mathbf{j} \\\\  & =(-3-t)\\hspace{0.167em}\\mathbf{i}+(2t+1)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}_{1}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(1+t)\\mathbf{j} \\\\  & =\\mathbf{i}+\\mathbf{j}\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}\\mathbf{F}({\\mathbf{r}}_{1}(t))\\cdot {\\mathbf{r}}_{1}^{'}(t) & =((-3-t)\\hspace{0.167em}\\mathbf{i}+(2t+1)\\hspace{0.167em}\\mathbf{j})\\cdot (\\mathbf{i}+\\mathbf{j}) \\\\  & =-3-t+2t+1 \\\\  & =t-2\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{{C}_{1}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} \\\\  & ={\\int }_{0}^{1}\\mathbf{F}({\\mathbf{r}}_{\\mathbf{1}}(t))\\cdot {\\mathbf{r}}_{1}^{'}(t)\\hspace{0.167em}\\text{d}t+\\frac{7}{2} \\\\  & ={\\int }_{0}^{1}(t-2)\\hspace{0.167em}\\text{d}t+\\frac{7}{2} \\\\  & ={[\\frac{{t}^{2}}{2}-2t]}_{0}^{1}+\\frac{7}{2} \\\\  & =[\\frac{1}{2}-2-0]+\\frac{7}{2} \\\\  & =-\\frac{3}{2}+\\frac{7}{2} \\\\  & =2\\end{aligned}\n$$"] [17592186326776 "Notice that our curve is given by the explicit Cartesian equation $y=\\sqrt[3]{x}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) &=x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}={t}^{3}\\hspace{0.167em}\\mathbf{i}+t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}t\\in [0,1]\\end{aligned}\n$$\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=3{t}^{2}\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}4y{e}^{xy}\\,dx+dy & ={\\int }_{0}^{1}4y{e}^{xy}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(4y{e}^{xy}\\,\\frac{\\text{d}x}{\\text{d}t}+\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}4t\\cdot {e}^{{t}^{3}\\cdot t}\\cdot 3{t}^{2}+1\\,dt \\\\  & ={\\int }_{0}^{1}12{t}^{3}{e}^{{t}^{4}}+1\\,dt \\\\  & ={[3{e}^{{t}^{4}}+t]}_{0}^{1} \\\\  & =[3{e}^{(1)^{4}}+(1)]-[3{e}^{(0)^{4}}+(0)] \\\\  & =[3e+1]-[3] \\\\  & =3e-2\\end{aligned}\n$$"] [17592186326819 "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =\\begin{vmatrix}-5 & 3 & 0 \\\\ 2 & -1 & 4 \\\\ 1 & 1 & 1\\end{vmatrix} \\\\  & =(-5)\\cdot \\begin{vmatrix}-1 & 4 \\\\ 1 & 1\\end{vmatrix}-3\\cdot \\begin{vmatrix}2 & 4 \\\\ 1 & 1\\end{vmatrix}+0\\cdot \\begin{vmatrix}2 & -1 \\\\ 1 & 1\\end{vmatrix} \\\\  & =-5((-1)\\cdot 1-1\\cdot 4)-3(2\\cdot 1-1\\cdot 4)+0 \\\\  & =25+6 \\\\  & =31\\end{aligned}\n$$\n\nFinally, we take the absolute value. So the volume of the corresponding parallelepiped is\n\n$$\nV=|31|=31.\n$$"] [17592186326911 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D$, then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/73/73bf9b973e50c540a873f4f1a44d936474e4c49d7041a330902508a840645009.png)\n\nFirst, notice that we can rewrite our integral as follows:\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∮}_{C}({x}^{3}+2{y}^{2})\\hspace{0.167em}\\mathrm{d}x+({x}^{2}+\\operatorname{ln}y)\\hspace{0.167em}\\mathrm{d}y\n$$\n\nWe have that $P(x,y)={x}^{3}+2{y}^{2}$ and $Q(x,y)={x}^{2}+\\operatorname{ln}⁡y.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=4y,\\,\\frac{∂Q}{∂x} & =2x.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD=\\{(x,y):y\\le x\\le 2-y,\\,0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's Theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({x}^{3}+2{y}^{2})\\,dx+({x}^{2}+\\operatorname{ln}⁡y)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x-4y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{y}^{2-y}(2x-4y)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{[{x}^{2}-4xy]}_{y}^{2-y}\\,dy \\\\  & ={\\int }_{0}^{1}[(2-y)^{2}-4(2-y)y-{y}^{2}+4{y}^{2}]dy \\\\  & ={\\int }_{0}^{1}(8{y}^{2}-12y+4)\\,dy \\\\  & =4{\\int }_{0}^{1}(2{y}^{2}-3y+1)\\,dy \\\\  & =4{[\\frac{2{y}^{3}}{3}-\\frac{3{y}^{2}}{2}+y]}_{0}^{1} \\\\  & =4[\\frac{2}{3}-\\frac{3}{2}+1] \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"]}
