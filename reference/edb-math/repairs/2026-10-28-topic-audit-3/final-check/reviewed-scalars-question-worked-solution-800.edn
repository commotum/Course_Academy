le t\\le 2\n$$\n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\mathbf{j} \\\\  & =\\mathbf{i}+3{t}^{2}\\hspace{0.167em}\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{(3{t}^{2})}^{2}} \\\\  & =\\sqrt{1+9{t}^{4}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =t\\cdot {t}^{3}={t}^{4}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{0}^{2}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{2}{t}^{4}\\sqrt{1+9{t}^{4}}\\hspace{0.167em}\\text{d}t.\\end{aligned}\n$$"] [17592186275193 "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=\\frac{1}{t}.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t)=⟨t,\\frac{1}{t}⟩,\\hspace{2em}1\\le t\\le 2\n$$\n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)\\mathbf{j} \\\\  & =\\mathbf{i}-\\frac{1}{{t}^{2}}\\hspace{0.167em}\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{\\left(-\\frac{1}{{t}^{2}}\\right)}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{{t}^{4}}} \\\\  & =\\frac{\\sqrt{{t}^{4}+1}}{{t}^{2}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2{x}^{3}y$, we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =2\\cdot {t}^{3}\\cdot \\frac{1}{t}=2{t}^{2}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{1}^{2}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{1}^{2}2{t}^{2}\\cdot \\frac{\\sqrt{{t}^{4}+1}}{{t}^{2}}\\cdot \\text{d}t \\\\  & =2{\\int }_{1}^{2}\\sqrt{{t}^{4}+1}\\hspace{0.167em}\\text{d}t.\\end{aligned}\n$$"] [17592186275194 "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=\\sqrt{4-{t}^{2}}.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t)=⟨t,\\hspace{0.222em}\\sqrt{4-{t}^{2}}⟩,\\hspace{2em}0\\le t\\le 2\n$$\n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\sqrt{4-{t}^{2}})\\mathbf{j} \\\\  & =\\mathbf{i}-\\frac{t}{\\sqrt{4-{t}^{2}}}\\hspace{0.167em}\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{\\left(-\\frac{t}{\\sqrt{4-{t}^{2}}}\\right)}^{2}} \\\\  & =\\sqrt{1+\\frac{{t}^{2}}{4-{t}^{2}}} \\\\  & =\\frac{2}{\\sqrt{4-{t}^{2}}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2xy$, we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =2t\\sqrt{4-{t}^{2}}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{0}^{2}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{2}2t\\sqrt{4-{t}^{2}}\\cdot \\frac{2}{\\sqrt{4-{t}^{2}}}\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2}t\\hspace{0.167em}\\text{d}t \\\\  & =2{t}^{2}\\hspace{0.167em}{|}_{0}^{2} \\\\  & =2({2}^{2}-{0}^{2}) \\\\  & =8.\\end{aligned}\n$$"] [17592186275195 "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=t.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t)=⟨t,\\hspace{0.222em}t⟩,\\hspace{2em}0\\le t\\le 3\n$$\n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{j} \\\\  & =\\mathbf{i}+\\hspace{0.167em}\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =t+t=2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{0}^{3}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{3}2t\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =2\\sqrt{2}{\\int }_{0}^{3}t\\hspace{0.167em}\\text{d}t \\\\  & =\\sqrt{2}\\hspace{0.167em}{t}^{2}{|}_{0}^{3} \\\\  & =\\sqrt{2}({3}^{2}-{0}^{2}) \\\\  & =9\\sqrt{2}.\\end{aligned}\n$$"] [17592186275196 "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=3t+2.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t)=⟨t,\\hspace{0.222em}3t+2⟩,\\hspace{2em}0\\le t\\le 1\n$$\n\nCo