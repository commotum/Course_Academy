17592186440022}] :answer-field/correct {:answer/id #uuid "1dba7438-ff22-567a-950d-78a7202b6d12" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440021} :answer-field/id #uuid "abb35f96-8e34-5ec5-8483-299f03e8484c" :answer-field/key "$x=8$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440368}] :question/id #uuid "f04c86de-5ed5-52ee-bc8b-1a0c07c06519" :question/math-academy-id "q-9657" :question/problem "Given that the determinant of\n$$\n\\displaystyle \\begin{bmatrix}2 & -1 & 3 \\\\ x & 2 & 4 \\\\ -2 & 1 & x + 3\\end{bmatrix}\n$$\nis $8$, find all the possible values of $x$.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The determinant is $x^{2} + 10 x + 24$. Setting it equal to $8$ gives $\\left\\{-8, -2\\right\\}$."} {:db/id #edb/ref 17592186060447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082dc2d8-bedc-5e7d-b400-565c864a2156" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186357827} {:answer/id #uuid "1497bbf0-b0e3-55c9-a773-3097042ee709" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186357932} {:answer/id #uuid "94d5145f-94aa-5233-938d-f5a7dd10a709" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186359056} {:answer/id #uuid "bda894ff-ae9d-5d5a-99bd-a1f4b7cf8342" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186359402} {:answer/id #uuid "e8ddf45e-881c-5c0c-a2da-d518f976e537" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186359817}] :answer-field/correct {:answer/id #uuid "082dc2d8-bedc-5e7d-b400-565c864a2156" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186357827} :answer-field/id #uuid "796c6d71-8b6e-59df-88c9-9b3757e40cfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360192}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b64018e-8bf2-54ed-9b58-217e6e652f6c" :question/math-academy-id "q-9669" :question/problem "Find the possible values of the constant $k$ given that the matrix $\\begin{bmatrix}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{bmatrix}$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$ \n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{vmatrix} & =2\\begin{vmatrix}3 & k \\\\ 0 & 1\\end{vmatrix}-1\\begin{vmatrix}2k+1 & k \\\\ 1 & 1\\end{vmatrix}-4\\begin{vmatrix}2k+1 & 3 \\\\ 1 & 0\\end{vmatrix} \\\\  & =2(3-0)-(2k+1-k)-4(0-3) \\\\  & =2\\cdot 3-(k+1)-4\\cdot (-3) \\\\  & =6-k-1+12 \\\\  & =17-k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}17-k & =0 \\\\ k & =17\\end{aligned}\n$$\n\nTherefore, the solution is $k=17.$"} {:db/id #edb/ref 17592186060456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c97d112-a733-50db-a3e0-14dc2721dcef" :answer/type {:db/ident :answer.type/text} :answer/value "Any value of $k$" :db/id #edb/ref 17592186059359} {:answer/id #uuid "a2aa1a94-21f1-552d-ae6c-c5b0802357bb" :answer/type {:db/ident :answer.type/text} :answer/value "$10$ only" :db/id #edb/ref 17592186059360} {:answer/id #uuid "b2d37c14-0ed6-5cb1-ae4d-65ca40ec7dab" :answer/type {:db/ident :answer.type/text} :answer/value "$0$ only" :db/id #edb/ref 17592186059361} {:answer/id #uuid "0e5ddce2-efab-57ff-834e-5148be9476c7" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ only" :db/id #edb/ref 17592186059362} {:answer/id #uuid "73493f5b-e7e5-53c5-91c5-a37d38ea1731" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $-3$ only" :db/id #edb/ref 17592186059363}] :answer-field/correct {:answer/id #uuid "8c97d112-a733-50db-a3e0-14dc2721dcef" :answer/type {:db/ident :answer.type/text} :answer/value "Any value of $k$" :db/id #edb/ref 17592186059359} :answer-field/id #uuid "a3da1235-861c-5299-892e-dbd9ea51bf74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059358}] :question/id #uuid "aae8854c-5bc3-5b0c-a496-72765fde3229" :question/math-academy-id "q-9852" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$\\begin{bmatrix}0 & 7 & 4k \\\\ 0 & 9 & 5k \\\\ 0 & 11 & 6k\\end{bmatrix}$ is singular." :question/worked-solution "The determinant is $0$. Setting it equal to $0$ gives $\\mathbb{R}$."} {:db/id #edb/ref 17592186262917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fb98df-401c-5fa9-9f2f-08261df60aa9" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186259918} {:answer/id #uuid "220b8b83-724a-5cbe-853b-6caa42638775" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186260170} {:answer/id #uuid "726ac3fa-740a-5e90-81fa-f599fc3f37a6" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186260875} {:answer/id #uuid "81ca9339-6bce-5219-8fae-787545463a11" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261005} {:answer/id #uuid "8c6b36bf-bffd-5918-ae53-d958ad6e391a" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261101}] :answer-field/correct {:answer/id #uuid "81ca9339-6bce-5219-8fae-787545463a11" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261005} :answer-field/id #uuid "c45caafc-858f-500e-9ef9-058205b847f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262475}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cb6a7e0a-d356-5b58-a703-e0864f9a1a58" :question/math-academy-id "q-128500" :question/problem "Given that\n$$\n\\displaystyle B=\\begin{bmatrix}1 & 2 & -5 \\\\ 1 & 2 & 1 \\\\ y & 2 & 1\\end{bmatrix}\n$$\nand $det(B)=12,$ find the value of $y.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}\\text{det}(B) & =\\begin{vmatrix}1 & 2 & -5 \\\\ 1 & 2 & 1 \\\\ y & 2 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}2 & 1 \\\\ 2 & 1\\end{vmatrix}-2\\begin{vmatrix}1 & 1 \\\\ y & 1\\end{vmatrix}-5\\begin{vmatrix}1 & 2 \\\\ y & 2\\end{vmatrix} \\\\  & =0-2\\cdot (1-y)-5\\cdot (2-2y) \\\\  & =12y-12\\end{aligned}\n$$\n\nSince the determinant of the matrix is $12,$ we have:\n\n$$\n\\begin{aligned}12y-12 & =12 \\\\ 12y & =24 \\\\ y & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "183c086d-012b-5f39-b92e-4550955dfcbb" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186260085} {:answer/id #uuid "2044861f-98f6-51d9-9cf5-e5080be450a1" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186260152} {:answer/id #uuid "21a46985-36f6-5f1d-b213-16f3935ec5b0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260165} {:answer/id #uuid "91c5f6e6-19cd-5455-92f6-06f29a9d6687" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186261142} {:answer/id #uuid "c0800f44-af37-5d5d-b586-92ebc2148392" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186261575}] :answer-field/correct {:answer/id #uuid "c0800f44-af37-5d5d-b586-92ebc2148392" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186261575} :answer-field/id #uuid "9a39ba2f-181c-558b-b3c6-6fdf22cdca96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262399}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9517ddd6-18dd-5bea-948b-a75416c96cbb" :question/math-academy-id "q-128502" :question/problem "Given that \n$$\n\\displaystyle C=\\begin{bmatrix}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{bmatrix}\n$$ \nand $det(C)=28,$ find the value of $q.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $q:$\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{vmatrix} \\\\  & =2\\begin{vmatrix}q & 5 \\\\ -5 & 1\\end{vmatrix}-3\\begin{vmatrix}-1 & 5 \\\\ 0 & 1\\end{vmatrix}+1\\begin{vmatrix}-1 & q \\\\ 0 & -5\\end{vmatrix} \\\\  & =2\\cdot (q+25)-3\\cdot (-1)+5 \\\\  & =2q+58\\end{aligned}\n$$\n\nSince the determinant of the matrix is $28,$ we have:\n\n$$\n\\begin{aligned}2q+58 & =28 \\\\ 2q & =-30 \\\\ q & =-15\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a96a6f2b-900e-5634-9638-19c6ba6bffea" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439527} {:answer/id #uuid "5d1afda0-1dac-5620-821a-ad4de506b094" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439528}] :answer-field/correct {:answer/id #uuid "a96a6f2b-900e-5634-9638-19c6ba6bffea" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439527} :answer-field/id #uuid "0a971e33-0a26-5898-ba8a-788195a8a8e8" :answer-field/key "$z=-5$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440121} {:answer-field/choices [{:answer/id #uuid "d2790ee6-862d-5820-b3be-e055f4659069" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439529} {:answer/id #uuid "d99a0961-46ae-512d-9fb7-6207f8fa1ecf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439530}] :answer-field/correct {:answer/id #uuid "d2790ee6-862d-582