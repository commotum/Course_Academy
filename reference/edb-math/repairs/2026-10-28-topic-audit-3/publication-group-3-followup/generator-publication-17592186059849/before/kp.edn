#{[{:db/id #edb/ref 17592186059849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059454 :question/id #uuid "7780340c-43d6-5d38-9270-865914098218" :question/math-academy-id "e-14764" :question/problem "Given that the determinant of  $\\begin{bmatrix}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{bmatrix}$ is $2,$ find the value of the constant $k.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $k\\mathbin{:}$\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{vmatrix} & =3\\begin{vmatrix}4 & 5 \\\\ 2 & 3\\end{vmatrix}-1\\begin{vmatrix}k & 5 \\\\ 0 & 3\\end{vmatrix}+2\\begin{vmatrix}k & 4 \\\\ 0 & 2\\end{vmatrix} \\\\  & =3(12-10)-1(3k-0)+2(2k-0) \\\\  & =3\\cdot 2-1\\cdot 3k+2\\cdot 2k \\\\  & =6-3k+4k \\\\  & =k+6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $2,$ we have:\n\n$$\n\\begin{aligned}k+6 & =2 \\\\ k & =-4\\end{aligned}\n$$"} :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050465 :topic/id #uuid "4bbf23bd-b30a-5ef9-8f1c-5c3855237fe0" :topic/knowledge-points [{:db/id #edb/ref 17592186068793} {:db/id #edb/ref 17592186068862} {:db/id #edb/ref 17592186068863} {:db/id #edb/ref 17592186068864}] :topic/math-academy-id 422 :topic/next [{:db/id #edb/ref 17592186048116} {:db/id #edb/ref 17592186048475} {:db/id #edb/ref 17592186048681} {:db/id #edb/ref 17592186048965} {:db/id #edb/ref 17592186049022} {:db/id #edb/ref 17592186049244} {:db/id #edb/ref 17592186049490} {:db/id #edb/ref 17592186049499} {:db/id #edb/ref 17592186049814} {:db/id #edb/ref 17592186050209} {:db/id #edb/ref 17592186050334}] :topic/title "The Quadratic Formula"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186705303 :question-generator/id #u