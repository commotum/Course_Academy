#edb/ref 17592186439562}] :answer-field/correct {:answer/id #uuid "fc065864-faea-55e7-829d-8436655f4adf" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439561} :answer-field/id #uuid "e28d926e-be6f-58c9-bdc1-98b5d2921bdf" :answer-field/key "$y=1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440138}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "627e7a3d-46e0-5ce8-b4f0-d14bd806cb23" :question/math-academy-id "q-18256" :question/problem "Given that the determinant of \n$$\n\\displaystyle \\begin{bmatrix}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{bmatrix}\n$$\n is $81,$ find all the possible values of $y.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{vmatrix} & =4\\begin{vmatrix}-2 & 1 \\\\ y & -5\\end{vmatrix}-2\\begin{vmatrix}-3y & 1 \\\\ 2 & -5\\end{vmatrix}+3\\begin{vmatrix}-3y & -2 \\\\ 2 & y\\end{vmatrix} \\\\  & =4\\cdot (10-y)-2\\cdot (15y-2)+3\\cdot (-3{y}^{2}+4) \\\\  & =40-4y-30y+4-9{y}^{2}+12 \\\\  & =-9{y}^{2}-34y+56\\end{aligned}\n$$\n\nSince the determinant of the matrix is $81,$ we have:\n\n$$\n\\begin{aligned}-9{y}^{2}-34y+56 & =81 \\\\ -9{y}^{2}-34y-25 & =0 \\\\ 9{y}^{2}+34y+25 & =0 \\\\ y & =\\frac{-34\\pm \\sqrt{{34}^{2}-4\\cdot 9\\cdot 25}}{2\\cdot 9} \\\\  & =\\frac{-34\\pm \\sqrt{256}}{18} \\\\  & =\\frac{-34\\pm 16}{18} \\\\  & =\\frac{-17\\pm 8}{9}\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-\\frac{25}{9}$ and $y=-1.$"} {:db/id #edb/ref 17592186287824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d5ba56-de94-5e4c-b177-c5dc46ffbd51" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186285000} {:answer/id #uuid "77114028-3901-51ca-9e0e-c825093eb6e0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285895} {:answer/id #uuid "7dacdb7f-b468-5607-98ad-e22d7d3b1b14" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186285945} {:answer/id #uuid "a1c9c2b5-e4ef-5a55-b086-105ff3094bd5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186286267} {:answer/id #uuid "eeb37ef9-8f27-5f7e-8602-dfc794e1f1a1" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286978}] :answer-field/correct {:answer/id #uuid "eeb37ef9-8f27-5f7e-8602-dfc794e1f1a1" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286978} :answer-field/id #uuid "e17a460e-868e-59c7-9907-c5516e2c691c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287610}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "418920c2-d3a5-5269-af1c-6648eaf6ff36" :question/math-academy-id "q-18271" :question/problem "Given that\n$$\n\\displaystyle A=\\begin{bmatrix}-k & 0 & -3 \\\\ 1 & 3 & -1 \\\\ 2k & 0 & 1\\end{bmatrix}\n$$\nand $det(A)=-30,$ find the value of $k.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}\\text{det}(A) & =\\begin{vmatrix}-k & 0 & -3 \\\\ 1 & 3 & -1 \\\\ 2k & 0 & 1\\end{vmatrix} \\\\  & =-k\\begin{vmatrix}3 & -1 \\\\ 0 & 1\\end{vmatrix}-0\\begin{vmatrix}1 & -1 \\\\ 2k & 1\\end{vmatrix}-3\\begin{vmatrix}1 & 3 \\\\ 2k & 0\\end{vmatrix} \\\\  & =-k\\cdot 3+0-3\\cdot (-6k) \\\\  & =-3k+18k \\\\  & =15k\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-30,$ we have:\n\n$$\n\\begin{aligned}15k & =-30 \\\\ k & =-2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8a0b14-4d5c-5c97-adda-ad9333ee9989" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439563} {:answer/id #uuid "dd74231f-397c-535b-b601-fd3c79196c9d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439564}] :answer-field/correct {:answer/id #uuid "dd74231f-397c-535b-b601-fd3c79196c9d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439564} :answer-field/id #uuid "bc6cf2f7-d1dc-587c-98ad-df0c79eb39bd" :answer-field/key "$p=-2$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440139} {:answer-field/choices [{:answer/id #uuid "b99de5ad-e5ec-584b-85db-f3fe0159078d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439565} {:answer/id #uuid "6a78a0f8-e11d-55e4-ae7a-bb450fd88339" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439566}] :answer-field/correct {:answer/id #uuid "b99de5ad-e5ec-584b-85db-f3fe0159078d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439565} :answer-field/id #uuid "60fa672d-cabd-5202-b542-e29c05c6092c" :answer-field/key "$p=2$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440140} {:answer-field/choices [{:answer/id #uuid "0824bc4a-1fb6-5f8e-8f46-06f33e4a0f34" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439567} {:answer/id #uuid "4bccbe1d-f704-50a7-a7cc-0373aa409b61" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439568}] :answer-field/correct {:answer/id #uuid "0824bc4a-1fb6-5f8e-8f46-06f33e4a0f34" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439567} :answer-field/id #uuid "b90240d0-5950-5b79-9a0c-e7150762e3ac" :answer-field/key "$p=4$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440141} {:answer-field/choices [{:answer/id #uuid "99e7c5d4-430e-5f20-88bd-00f87d74ace8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439569} {:answer/id #uuid "82587c1b-bbe1-5f58-a819-0bba3bb63520" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439570}] :answer-field/correct {:answer/id #uuid "82587c1b-bbe1-5f58-a819-0bba3bb63520" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439570} :answer-field/id #uuid "1827baf7-1958-50ff-a89b-0e47a7c1cf1e" :answer-field/key "$p=5$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440142}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1a6ffa24-d6e8-52ac-ac3d-5fab4f24df3d" :question/math-academy-id "q-18272" :question/problem "Given that $M=\\begin{bmatrix}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{bmatrix}$ and $det(M)=-23,$ find all the possible values of $p.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}\\text{det}(M) & =\\begin{vmatrix}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{vmatrix} \\\\  & =0\\begin{vmatrix}p & 0 \\\\ 0 & -1\\end{vmatrix}-(-3)\\begin{vmatrix}1 & 0 \\\\ p-3 & -1\\end{vmatrix}+2\\begin{vmatrix}1 & p \\\\ p-3 & 0\\end{vmatrix} \\\\  & =0+3\\cdot (-1)+2\\cdot (3p-{p}^{2}) \\\\  & =-3-2{p}^{2}+6p \\\\  & =-2{p}^{2}+6p-3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-23,$ we have:\n\n$$\n\\begin{aligned}-2{p}^{2}+6p-3 & =-23 \\\\ 2{p}^{2}-6p-20 & =0 \\\\ {p}^{2}-3p-10 & =0 \\\\ p & =\\frac{-(-3)\\pm \\sqrt{(-3)^{2}-4\\cdot 1\\cdot (-10)}}{2\\cdot 1} \\\\  & =\\frac{3\\pm \\sqrt{49}}{2} \\\\  & =\\frac{3\\pm 7}{2}\\end{aligned}\n$$\n\nTherefore,  the solutions are $p=-2$ and $p=5.$"} {:db/id #edb/ref 17592186295140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b6fb57b-36e2-543a-ab01-e63593d507d2" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186293544}] :answer-field/correct {:answer/id #uuid "9b6fb57b-36e2-543a-ab01-e63593d507d2" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186293544} :answer-field/id #uuid "9633885c-c66b-52e8-84a6-2cf06bb918b2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294471}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b8c1908a-4170-5ad4-8920-81bd7dfc6050" :question/math-academy-id "q-280403" :question/problem "Given that $A=\\begin{bmatrix}2 & 1 & 0 \\\\ 3 & x & 4 \\\\ -2 & 5 & 1\\end{bmatrix}$ and $det(A)=37$, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}\\text{det}(F) & =\\begin{vmatrix}2 & 1 & 0 \\\\ 3 & x & 4 \\\\ -2 & 5 & 1\\end{vmatrix} \\\\  & =2\\begin{vmatrix}x & 4 \\\\ 5 & 1\\end{vmatrix}-1\\begin{vmatrix}3 & 4 \\\\ -2 & 1\\end{vmatrix}+0\\begin{vmatrix}3 & x \\\\ -2 & 5\\end{vmatrix} \\\\  & =2(x\\cdot 1-4\\cdot 5)-(3\\cdot 1-4\\cdot (-2)) \\\\  & =2(x-20)-(3+8) \\\\  & =2x-40-11 \\\\  & =2x-51\\end{aligned}\n$$\n\nSince the determinant of the matrix is $37,$ we have\n\n$$\n\\begin{aligned}2x-51 & =37 \\\\ 2x & =88 \\\\ x & =44.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd58d80d-e3cd-55e9-ab3a-7f344ff3bcd8" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293792}] :answer-field/correct {:answer/id #uuid "dd58d80d-e3cd-55e9-ab3a-7f344ff3bcd8" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293792} :answer-field/id #uuid "de3f45f5-c264-5c0e-b8b4-960fb94c3f56" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294706}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b09153b7-90f9-5996-a92d-2d17cff9a754" :question/math-academy-id "q-280404" :question/problem "Find the possible values of the constant $k$ given that the matrix $\\begin{bmatrix}k+1 & 2k & 3 \\\\ 0 & 5 & 0 \\\\ -2 & k & 1\\end{bmatrix}$ is singular.\n\n$k=$\n{{field-1}}" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}det & =\\begin{vmatrix}k+1 & 2k & 3 \\\\ 0 & 5 & 0 \\\\ -2 & k & 1\\end{vmatrix} \\\\  & =(k+1)\\begin{vmatrix}5 & 0 \\\\ k & 1\\end{vmatrix}-2k\\begin{vmatrix}0 & 0 \\\\ -2 & 1\\end{vmatrix}+3\\begin{vmatrix}0 & 5 \\\\ -2 & k\\end{vmatrix} \\\\  & =(k+1)(5\\cdot 1-0\\cdot k)-2k(0\\cdot 1-0\\cdot -2)+3(0\\cdot k-5\\cdot (-2)) \\\\  & =(k+1)(5)-2k(0)+3(10) \\\\  & =5k+5+30 \\\\  & =5k+35\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have\n\n$$\n\\begin{aligned}5k+35 & =0 \\\\ 5k & =-35 \\\\ k & =-7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4fa7fe2-70f7-5b48-aad2-0f11a308a02b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186293639}] :answer-field/correct {:answer/id #uuid "b4fa7fe2-70f7-5b48-aad2-0f11a308a02b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186293639} :answer-field/id #uuid "ff1893bf-705b-5320-b68c-49a5e5fad6f0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294826}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cae37ba1-c114-55f8-b121-0094f150645e" :question/math-academy-id "q-280519" :question/problem "Given that $G=\\begin{bmatrix}x & 2x-1 & 6 \\\\ 0 & 3 & 0 \\\\ -1 & x+1 & -4\\end{bmatrix}$ is singular, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}det & =\\begin{vmatrix}x & 2x-1 & 6 \\\\ 0 & 3 & 0 \\\\ -1 & x+1 & -4\\end{vmatrix} \\\\  & =x\\begin{vmatrix}3 & 0 \\\\ x+1 & -4\\end{vmatrix}-(2x-1)\\begin{vmatrix}0 & 0 \\\\ -1 & -4\\end{vmatrix}+6\\begin{vmatrix}0 & 3 \\\\ -1 & x+1\\end{vmatrix} \\\\  & =x(3\\cdot (-4)-0\\cdot (x+1))-(2x-1)(0)+6(0\\cdot (x+1)-3\\cdot (-1)) \\\\  & =x(-12)+0+6(3) \\\\  & =-12x+18\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have\n\n$$\n\\begin{aligned}-12x+18 & =0 \\\\ -12x & =-18 \\\\ x & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7a14d7c-c976-5346-a0ff-1a7451eb909b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{43}}{2}" :db/id #edb/ref 17592186293594}] :answer-field/correct {:answer/id #uuid "a7a14d7c-c976-5346-a0ff-1a7451eb909b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{43}}{2}" :db/id #edb/ref 17592186293594} :answer-field/id #uuid "744d1c09-7fab-597a-b711-9626275fab38" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294339} {:answer-field/choices [{:answer/id #uuid "0e75f6dd-e85a-5f64-bcc4-624a0a4629af" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{43}}{2}" :db/id #edb/ref 17592186292998}] :answer-field/correct {:answer/id #uuid "0e75f6dd-e85a-5f64-bcc4-624a0a4629af" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{43}}{2}" :db/id #edb/ref 17592186292998} :answer-field/id #uuid "d728a0ab-06b9-5153-aa9d-039b19b0b1ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294689}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "854d343a-6ceb-5dbc-aed9-5a3bba384840" :question/math-academy-id "q-280540" :question/problem "Given that the determinant of $\\begin{bmatrix}{x}^{2}-2 & 3 & 0 \\\\ x & -2 & -1 \\\\ 1 & 4 & 0\\end{bmatrix}$ is $32$, find all the possible values of $x$ **in ascending order**.\n\nIn ascending order, $x=$\n{{field-1}} and $x=$\n{{field-2}}." :question/worked-solution "Let’s use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}{x}^{2}-2 & 3 & 0 \\\\ x & -2 & -1 \\\\ 1 & 4 & 0\\end{vmatrix} \\\\  & =({x}^{2}-2)\\begin{vmatrix}-2 & -1 \\\\ 4 & 0\\end{vmatrix}-3\\begin{vmatrix}x & -1 \\\\ 1 & 0\\end{vmatrix}+0 \\\\  & =({x}^{2}-2)(-2\\cdot 0-(-1)(4))-3(x\\cdot 0-(-1)(1)) \\\\  & =({x}^{2}-2)(4)-3(1) \\\\  & =4{x}^{2}-8-3 \\\\  & =4{x}^{2}-11\\end{aligned}\n$$\n\nSince the determinant of the matrix is $32$, we have\n\n$$\n\\begin{aligned}4{x}^{2}-11 & =32 \\\\ 4{x}^{2} & =43 \\\\ {x}^{2} & =\\frac{43}{4} \\\\ x & =\\pm \\sqrt{\\frac{43}{4}} \\\\  & =\\pm \\frac{\\sqrt{43}}{2}\\end{aligned}\n$$\n\nTherefore, **in ascending order**, the solutions are $x=-\\frac{\\sqrt{43}}{2}$ and $x=\\frac{\\sqrt{43}}{2}.$"} {:db/id #edb/ref 17592186295161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0455064-a7d8-59fd-ac77-33abf41ca336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186293865}] :answer-field/correct {:answer/id #uuid "f0455064-a7d8-59fd-ac77-33abf41ca336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186293865} :answer-field/id #uuid "718e1993-6243-5b67-ad85-b48d5e4c1b0e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294333} {:answer-field/choices [{:answer/id #uuid "f5474c54-161f-5c59-93d2-847eb2a1ab3f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293891}] :answer-field/correct {:answer/id #uuid "f5474c54-161f-5c59-93d2-847eb2a1ab3f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293891} :answer-field/id #uuid "904e7486-ae2f-53e2-a8b8-33a2fef9eb06" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294451}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f11851f4-08f0-546e-8ec7-83f1d8f0d049" :question/math-academy-id "q-280541" :question/problem "Given that the determinant of $\\begin{bmatrix}x & 2x & 5 \\\\ 3 & x & 4 \\\\ 7 & 1 & 2\\end{bmatrix}$ is $40$, find all the possible values of $x$ **in ascending order**.\n\nIn ascending order, $x=$\n{{field-1}} and $x=$\n{{field-2}}." :question/worked-solution "Let’s use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}x & 2x & 5 \\\\ 3 & x & 4 \\\\ 7 & 1 & 2\\end{vmatrix} \\\\  & =x\\begin{vmatrix}x & 4 \\\\ 1 & 2\\end{vmatrix}-2x\\begin{vmatrix}3 & 4 \\\\ 7 & 2\\end{vmatrix}+5\\begin{vmatrix}3 & x \\\\ 7 & 1\\end{vmatrix} \\\\  & =x(2x-4)-2x(3\\cdot 2-4\\cdot 7)+5(3-7x) \\\\  & =x(2x-4)-2x(-22)+15-35x \\\\  & =2{x}^{2}-4x+44x+15-35x \\\\  & =2{x}^{2}+5x+15\\end{aligned}\n$$\n\nSince the determinant of the matrix is $40$, we have\n\n$$\n\\begin{aligned}2{x}^{2}+5x+15 & =40 \\\\ 2{x}^{2}+5x-25 & =0 \\\\ x & =\\frac{-5\\pm \\sqrt{{5}^{2}-4(2)(-25)}}{2(2)} \\\\ x & =\\frac{-5+\\sqrt{225}}{4} \\\\  & =\\frac{-5\\pm 15}{4}.\\end{aligned}\n$$\n\nTherefore, **in ascending order**, the solutions are $x=-5$ and $x=\\frac{5}{2}.$"} {:db/id #edb/ref 17592186362340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ac7900-ea05-5cc8-9d53-11c30c4ca60a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440029} {:answer/id #uuid "91747f90-b1ca-5a23-b764-3011370995c0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440030}] :answer-field/correct {:answer/id #uuid "37ac7900-ea05-5cc8-9d53-11c30c4ca60a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440029} :answer-field/id #uuid "536c4571-b3d8-5ac6-b419-3f6f71056077" :answer-field/key "$k=-3$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440372} {:answer-field/choices [{:answer/id #uuid "d1e4cb25-b3e5-5104-8ec6-1f86c12d56d4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440031} {:answer/id #uuid "7ff679bc-fdfb-5669-bd8b-854d2358190c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440032}] :answer-field/correct {:answer/id #uuid "7ff679bc-fdfb-5669-bd8b-854d2358190c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440032} :answer-field/id #uuid "e5c431c2-1fb0-5a03-b48d-74276cb322b4" :answer-field/key "$k=0$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440373} {:answer-field/choices [{:answer/id #uuid "9399f58c-b270-5d89-8f0f-c6e1b2ae15a6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440033} {:answer/id #uuid "7cd73f80-9ac4-5715-aa47-0376b208e6f3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440034}] :answer-field/correct {:answer/id #uuid "7cd73f80-9ac4-5715-aa47-0376b208e6f3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440034} :answer-field/id #uuid "f7c8be4f-cbe0-55fc-a506-530979c94394" :answer-field/key "$k=3$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440374}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e554c090-e3bc-5a93-90b4-9f79a0997b62" :question/math-academy-id "q-9911" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$\\begin{bmatrix}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{bmatrix}$ is singular.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{vmatrix} & =1\\begin{vmatrix}k & -k \\\\ k & k\\end{vmatrix}-(-1)\\begin{vmatrix}1 & -k \\\\ 5 & k\\end{vmatrix}+k\\begin{vmatrix}1 & k \\\\ 5 & k\\end{vmatrix} \\\\  & =({k}^{2}+{k}^{2})+(k+5k)+k(k-5k) \\\\  & =2{k}^{2}+6k+k\\cdot (-4k) \\\\  & =2{k}^{2}+6k-4{k}^{2} \\\\  & =-2{k}^{2}+6k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}-2{k}^{2}+6k & =0 \\\\ k(-2k+6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=3.$"} {:db/id #edb/ref 17592186362379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28576cc0-5b53-52a1-993c-52e6981f0e23" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186361011} {:answer/id #uuid "41df7ae9-3272-5a1d-b2c6-8730c296899a" :answer/type {:db/ident :answer.type/text} :answer/value "Any real number" :db/id #edb/ref 17592186361129} {:answer/id #uuid "a0b997e7-f26c-5ca5-b635-2f16f0cab1c4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186361556} {:answer/id #uuid "a555d756-093c-5a66-ac31-9396b628afff" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186361577} {:answer/id #uuid "d8a9bece-ac6f-57f6-abed-e01a47669f57" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186361800}] :answer-field/correct {:answer/id #uuid "a0b997e7-f26c-5ca5-b635-2f16f0cab1c4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186361556} :answer-field/id #uuid "7f3d836f-c871-5036-ada8-8e641e2d9862" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362089}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ec95474f-3d89-5428-8221-da33b63b3f3b" :question/math-academy-id "q-9961" :question/problem "Given that the determinant of  $\\begin{bmatrix}1 & n & 0 \\\\ 1 & 2 & 0 \\\\ -1 & 1 & 2\\end{bmatrix}$ is $-6$, find the value of $n.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $n:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & n & 0 \\\\ 1 & 2 & 0 \\\\ -1 & 1 & 2\\end{vmatrix} & =1\\begin{vmatrix}2 & 0 \\\\ 1 & 2\\end{vmatrix}-n\\begin{vmatrix}1 & 0 \\\\ -1 & 2\\end{vmatrix}+0\\begin{vmatrix}1 & 2 \\\\ -1 & 1\\end{vmatrix} \\\\  & =4-n\\cdot 2+0 \\\\  & =4-2n\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-6,$ we have:\n\n$$\n\\begin{aligned}4-2n & =-6 \\\\ -2n & =-10 \\\\ n & =5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186365547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40e1e46e-bc20-5e49-8f3c-e2b13ee9e67f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{67}{10}" :db/id #edb/ref 17592186365549}] :answer-field/correct {:answer/id #uuid "40e1e46e-bc20-5e49-8f3c-e2b13ee9e67f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{67}{10}" :db/id #edb/ref 17592186365549} :answer-field/id #uuid "20261a72-2d87-53f3-be96-928a95530e46" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365548}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fbb701de-fecd-5033-b2e0-5f19c68c7b4a" :question/math-academy-id "q-280402" :question/problem "Given that $B=\\begin{bmatrix}3 & 0 & 2 \\\\ 1 & k+2 & -5 \\\\ 4 & -1 & 6\\end{bmatrix}$ and $det(B)=70$, find the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}\\text{det}(B) & =\\begin{vmatrix}3 & 0 & 2 \\\\ 1 & k+2 & -5 \\\\ 4 & -1 & 6\\end{vmatrix} \\\\  & =3\\begin{vmatrix}k+2 & -5 \\\\ -1 & 6\\end{vmatrix}-0\\begin{vmatrix}1 & -5 \\\\ 4 & 6\\end{vmatrix}+2\\begin{vmatrix}1 & k+2 \\\\ 4 & -1\\end{vmatrix} \\\\  & =3(6\\cdot (k+2)-(-5)(-1))+2(1\\cdot (-1)-4\\cdot (k+2)) \\\\  & =3(6k+12-5)+2(-1-4k-8) \\\\  & =3(6k+7)+2(-4k-9) \\\\  & =18k+21-8k-18 \\\\  & =10k+3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $70,$ we have\n\n$$\n\\begin{aligned}10k+3 & =70 \\\\ 10k & =67 \\\\ k & =\\frac{67}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186365550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e337463-b3e6-57c5-a2b0-3b2f8be1327c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365552}] :answer-field/correct {:answer/id #uuid "5e337463-b3e6-57c5-a2b0-3b2f8be1327c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365552} :answer-field/id #uuid "113f8edf-ce63-5e3c-8e20-25df8fcc000b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365551} {:answer-field/choices [{:answer/id #uuid "b5aa7c3b-3cc6-5915-9f4e-4ad87619a68f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186365554}] :answer-field/correct {:answer/id #uuid "b5aa7c3b-3cc6-5915-9f4e-4ad87619a68f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186365554} :answer-field/id #uuid "8ae0cbef-0d94-5f00-b36b-22a479b003a4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365553}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7046d61a-2100-5f6e-80e3-9459516462dc" :question/math-academy-id "q-280543" :question/problem "Find, in **ascending order**, the values ​​of $x$ for which the following matrix is singular.\n\n$$\nA=\\begin{bmatrix}x+2 & 2x & 4 \\\\ 3 & x & x+1 \\\\ 1 & 0 & 3\\end{bmatrix}\n$$\n\nIn ascending order, $x=$\n{{field-1}} and $x=$\n{{field-2}}." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}x+2 & 2x & 4 \\\\ 3 & x & x+1 \\\\ 1 & 0 & 3\\end{vmatrix} & =(x+2)\\begin{vmatrix}x & x+1 \\\\ 0 & 3\\end{vmatrix}-2x\\begin{vmatrix}3 & x+1 \\\\ 1 & 3\\end{vmatrix}+4\\begin{vmatrix}3 & x \\\\ 1 & 0\\end{vmatrix} \\\\  & =(x+2)(3x)-2x(8-x)+4(-x) \\\\  & =3x(x+2)-2x(8-x)-4x \\\\  & =3{x}^{2}+6x-16x+2{x}^{2}-4x \\\\  & =5{x}^{2}-14x\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have\n \n\n$$\n\\begin{aligned}5{x}^{2}-14x & =0 \\\\ x(5x-14) & =0 \\\\ x & =0\\,\\text{or}\\,x=\\frac{14}{5}.\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=0$ and $x=\\frac{14}{5}.$"} {:db/id #edb/ref 17592186396237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46af019b-5e0e-54fe-a3a4-d3a5f79204d1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440035} {:answer/id #uuid "36089e95-fc88-5a76-b2c4-311f215a41a1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440036}] :answer-field/correct {:answer/id #uuid "46af019b-5e0e-54fe-a3a4-d3a5f79204d1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440035} :answer-field/id #uuid "a7bba9ed-822d-53ee-89c9-116fde41ee52" :answer-field/key "$k=-2$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440375} {:answer-field/choices [{:answer/id #uuid "242f0892-e1e1-5e47-ac02-f10209cc7691" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440037} {:answer/id #uuid "5261eeed-b902-50cd-be8c-e339e0cd7603" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440038}] :answer-field/correct {:answer/id #uuid "5261eeed-b902-50cd-be8c-e339e0cd7603" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440038} :answer-field/id #uuid "3baa83a4-cb6e-5db3-8f0f-7d1c5b2abfae" :answer-field/key "$k=0$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440376} {:answer-field/choices [{:answer/id #uuid "2a8201e6-2d8f-5889-8d5a-7f26e45965c7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440039} {:answer/id #uuid "8aa3b90b-7a80-5418-b7a0-778bc241d10d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440040}] :answer-field/correct {:answer/id #uuid "8aa3b90b-7a80-5418-b7a0-778bc241d10d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440040} :answer-field/id #uuid "ab487ccf-fee0-51d3-aff0-dfee470b09fd" :answer-field/key "$k=2$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440377}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "11af43ea-89bf-58ea-b458-4433226aa764" :question/math-academy-id "q-9913" :question/problem "Find the possible values of the constant $k$ given that the matrix  $\\begin{bmatrix}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{bmatrix}$ is singular.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{vmatrix} & =k\\begin{vmatrix}3 & 1 \\\\ 6 & k\\end{vmatrix}+0\\begin{vmatrix}0 & 1 \\\\ 0 & k\\end{vmatrix}+0\\begin{vmatrix}0 & 3 \\\\ 0 & 6\\end{vmatrix} \\\\  & =k(3k-6)+0+0 \\\\  & =k(3k-6)\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0.$ So,  we have:\n\n \n\n$$\n\\begin{aligned}k(3k-6) & =0 \\\\ 3k(k-2) & =0 \\\\ k & =0,2\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=2.$"} {:db/id #edb/ref 17592186400366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3601e09a-9335-5956-9835-0fbca8ffb502" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439483} {:answer/id #uuid "3db08d97-0845-5f7c-ab43-56777bea1d91" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439484}] :answer-field/correct {:answer/id #uuid "3601e09a-9335-5956-9835-0fbca8ffb502" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439483} :answer-field/id #uuid "36f65856-78a1-51a9-a1da-71cda1e674f1" :answer-field/key "$m=-6$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440099} {:answer-field/choices [{:answer/id #uuid "dec92b27-277d-5920-9c63-50c355350d50" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439485} {:answer/id #uuid "d7efe730-22a8-5253-b96e-23123e4a98e9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439486}] :answer-field/correct {:answer/id #uuid "dec92b27-277d-5920-9c63-50c355350d50" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439485} :answer-field/id #uuid "21524ea9-5072-5e34-9765-c48f94050d16" :answer-field/key "$m=-5$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440100} {:answer-field/choices [{:answer/id #uuid "6a17a4ff-d40c-5630-a3e9-10db02ad93e1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439487} {:answer/id #uuid "dbf556fa-4d79-5443-8bfa-93c96686c0b3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439488}] :answer-field/correct {:answer/id #uuid "6a17a4ff-d40c-5630-a3e9-10db02ad93e1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439487} :answer-field/id #uuid "1274cfce-7367-5750-bf06-dd8f1d1cfeec" :answer-field/key "$m=1$" :answer-field/type 