a40b1a50d115e1d.png)"} {:db/id #edb/ref 17592186389181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "659a692b-2aae-5acc-a235-560ceb57bafb" :answer/type {:db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186389183} {:answer/id #uuid "f3c0fc1d-78bf-56a3-bddf-42bd659ad7fb" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186389184} {:answer/id #uuid "404681f6-e3e2-5a85-a1a6-1e1e580bf865" :answer/type {:db/ident :answer.type/image} :answer/value "images/d5/d5889bd5e8d537757de25a7b1a868ff8a903da14c9088c5f8de5a70d8b078552.png" :db/id #edb/ref 17592186389185} {:answer/id #uuid "121673a3-bbfa-573d-a9d1-f20fe0e8e765" :answer/type {:db/ident :answer.type/image} :answer/value "images/cb/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png" :db/id #edb/ref 17592186389186} {:answer/id #uuid "e0e134b4-7103-5125-b7fc-086313478261" :answer/type {:db/ident :answer.type/image} :answer/value "images/b0/b0171dfd42295e39cd45186e8edba3a5105fbd1bd02a1621223091de75815f61.png" :db/id #edb/ref 17592186389187}] :answer-field/correct {:answer/id #uuid "121673a3-bbfa-573d-a9d1-f20fe0e8e765" :answer/type {:db/ident :answer.type/image} :answer/value "images/cb/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png" :db/id #edb/ref 17592186389186} :answer-field/id #uuid "3825278d-de78-5afb-82f2-adfd041f336b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389182}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c2f0da55-1926-59a4-96c8-e68855af7a42" :question/math-academy-id "q-161837" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $\\mathbf{T},$ given by \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\frac{1}{3}{u}^{3}+v \\\\ uv\\end{bmatrix},\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\frac{1}{3}{u}^{3}+v \\\\ uv\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{u}^{2} & 1 \\\\ v & u\\end{vmatrix} \\\\  & ={u}^{2}\\cdot u-v\\cdot 1 \\\\  & ={u}^{3}-v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}{u}^{3}-v & <0 \\\\ v & >{u}^{3}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv={u}^{3}\n$$\n\ndefines a cubic function, and the coordinates of, say, $(-1,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/cb/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png)"} {:db/id #edb/ref 17592186389188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "773f7224-683a-5657-93fd-0b49bba9ddc6" :answer/type {:db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186389190} {:answer/id #uuid "3223453f-3db3-5cf7-9170-0776a21f7b7c" :answer/type {:db/ident :answer.type/image} :answer/value "images/8b/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png" :db/id #edb/ref 17592186389191} {:answer/id #uuid "d90c24c3-b6bf-58dc-bb07-e1245dcf6b0d" :answer/type {:db/ident :answer.type/image} :answer/value "images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab07