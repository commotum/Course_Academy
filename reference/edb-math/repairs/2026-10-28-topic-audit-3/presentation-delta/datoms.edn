609-438c5d809a74" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730898 #edb/ref 1068 #edb/ref 17592186730896 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730898 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730898 #edb/ref 1071 "Find the slope of $y=f(x)$ at $x=\\frac{\\pi}{4}$ if\n\n$$\nf(x)=3x-\\sqrt{2}\\sec x.\n$$" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730898 #edb/ref 1072 #uuid "791a6a4f-a51e-5ff5-866f-c5e7ad77ec0f" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730898 #edb/ref 1074 "The slope is $m=f'\\left(\\frac{\\pi}{4}\\right)$. Differentiate each term before substituting the given input:\n\n$$\n\\begin{aligned}\nf'(x)&=3-\\sqrt{2}\\sec x\\tan x.\n\\end{aligned}\n$$\n\nAt $x=\\frac{\\pi}{4}$, we have $\\sec x=\\sqrt{2}$ and $\\tan x=1$. Therefore,\n\n$$\n\\begin{aligned}\nm&=3-\\sqrt{2}(\\sqrt{2})(1)\\\\\n &=3-2\\\\\n &=1.\n\\end{aligned}\n$$" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730899 #edb/ref 1068 #edb/ref 17592186730901 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730899 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730899 #edb/ref 1071 "Find the slope $m$ of $y=g(x)$ at $x=\\frac{\\pi}{3}$ if\n\n$$\ng(x)=x\\cot x.\n$$\n\n$m=$ {{field-1}}" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730899 #edb/ref 1072 #uuid "aade5c52-d21f-5fad-bb3b-d7626a8b9edb" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730899 #edb/ref 1074 "The slope is $m=g'\\left(\\frac{\\pi}{3}\\right)$. Both factors depend on $x$, so use the product rule:\n\n$$\n\\begin{aligned}\ng'(x)&=(1)\\cot x+x(-\\csc^2 x)\\\\\n     &=\\cot x-x\\csc^2 x.\n\\end{aligned}\n$$\n\nAt $x=\\frac{\\pi}{3}$, we have $\\cot x=\\frac{1}{\\sqrt{3}}$ and $\\csc x=\\frac{2}{\\sqrt{3}}$. Substituting gives\n\n$$\n\\begin{aligned}\nm&=\\frac{1}{\\sqrt{3}}-\\frac{\\pi}{3}\\left(\\frac{2}{\\sqrt{3}}\\right)^2\\\\\n &=\\frac{\\sqrt{3}}{3}-\\frac{4\\pi}{9}.\n\\end{aligned}\n$$" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730900 #edb/ref 1080 "5" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730900 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730900 #edb/ref 1083 #uuid "ae6ba2cc-40ac-5820-99c2-6106613e2ad3" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730901 #edb/ref 1075 #edb/ref 17592186730894 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730901 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730901 #edb/ref 1077 "field-1" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730901 #edb/ref 1078 #edb/ref 17592186730894 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730901 #edb/ref 1079 #uuid "bf9fb160-d700-5aa9-b76a-44526eb798d0" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730902 #edb/ref 1080 "3-2\\sqrt{2}" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730902 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730902 #edb/ref 1083 #uuid "cb54a516-5f4c-53f2-9ae4-1df1806279c0" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730903 #edb/ref 1080 "1" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730903 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730903 #edb/ref 1083 #uuid "e044594a-d9da-55f9-8345-3fc35cf3c2e4" #edb/ref 13194139543428 #edb/ref 17592186576411 true] [#edb/ref 17592186730904 #edb/ref 1080 "\\frac{10\\sqrt{3}}{9}" #edb/ref 13194