{x}+3\\cdot \\ln x\\right) \\\\ &= 4\\cdot \\left({e}^{x}\\right)+3\\cdot \\left(\\frac{1}{x}\\right) \\\\ &= 4\\cdot {e}^{x}+\\frac{3}{x}\\end{aligned}\n$$" #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730930 #edb/ref 1080 "-\\frac{4}{x}-5-9\\cdot {x}^{2}" #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730930 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730930 #edb/ref 1083 #uuid "6dbc18d3-6946-57e9-bb0a-9ef83468367a" #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730931 #edb/ref 1080 "-5-9\\cdot {x}^{2}" #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730931 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730931 #edb/ref 1083 #uuid "6e955de2-39ac-532e-a31a-459befd6f4e6" #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730932 #edb/ref 1068 #edb/ref 17592186730935 #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730932 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730932 #edb/ref 1071 "Given the function $y=2\\cdot \\ln x+2\\cdot {4}^{x}-4$, find the instantaneous rate of change at $x=1$. Give an exact answer.\n\nThe instantaneous rate of change is {{field-1}}." #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730932 #edb/ref 1072 #uuid "7007c10c-b976-5cd1-a946-092d73087786" #edb/ref 13194139543431 #edb/ref 17592186045443 true] [#edb/ref 17592186730932 #edb/ref 1074 "Differentiate each term and retain its constant multiplier. The derivative of an additive constant is $0$.\n\n$$\n\\begin{aligned}\\frac{dy}{dx} &= \\frac{d}{dx}\\left(2\\cdot \\ln x+2\\cdot {4}^{x}-4\\right) \\\\ &= 2\\cdot \\left(\\frac{1}{x}\\right)+2\\cdot \\left({4}^{x}\\ln 4\\right) \\\\ &= \\frac{2}{x}+2\\cdot {4}^{x}\\ln 4\\end{aligned}\n$$\