5-d1db-547f-9fec-5b069d1a6135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{17}}{17}a" :db/id #edb/ref 17592186502383} {:answer/id #uuid "b178e68c-779a-5054-843e-a75a51bc3a61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}a" :db/id #edb/ref 17592186502388} {:answer/id #uuid "d0e80375-2d4e-5d08-abd4-f6fb022fd894" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{17}a" :db/id #edb/ref 17592186502412}] :answer-field/correct {:answer/id #uuid "4b64f103-4a0f-5427-abf6-87a5b93eadd0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{17}}{17}a" :db/id #edb/ref 17592186502353} :answer-field/id #uuid "f1cf3e15-cc97-5a13-bd25-8922cfbaabbc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502425}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fd2c3dbb-22ff-5705-a4a4-9ced2ca58d7c" :question/problem "![](images/e2/e2a2003ffdc18b5cc19abbe61346906d9ddbe45021109b41e88818d40dd05ee3.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $a$. Choose the unit vector in the same direction." :question/worked-solution "![](images/23/23a7a8c3471a8f297b1daf5bf52f4314e2360b215083bcb379605801a5984890.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=4$ and $BH=1$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(4)^2+(1)^2} \\\\\n&= \\sqrt{16+1} \\\\\n&= \\sqrt{17}\n\\end{aligned}\n$$\n\nHence, the magnitude of $a$ is $\\sqrt{17}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|a|}\\cdot a \\\\\n&= \\frac{\\sqrt{17}}{17}a\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186565617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f286019-c88c-5842-a7b8-9eb547678959" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{29}}{29}a" :db/id #edb/ref 17592186565613} {:answer/id #uuid "7a58a0e3-980e-505e-83a7-96cf992263a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}a" :db/id #edb/ref 17592186565615} {:answer/id #uuid "7d16a415-ebbc-506a-8125-0d913b5c4e3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{29}}{29}a" :db/id #edb/ref 17592186565616} {:answer/id #uuid "a3aea7ea-5977-53db-a932-5f809f16357f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{29}a" :db/id #edb/ref 17592186565620} {:answer/id #uuid "f48f6b83-2ed6-5e6c-95c1-3d1c22810f40" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{29}a" :db/id #edb/ref 17592186565625}] :answer-field/correct {:answer/id #uuid "3f286019-c88c-5842-a7b8-9eb547678959" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{29}}{29}a" :db/id #edb/ref 17592186565613} :answer-field/id #uuid "e5254726-4499-591e-9b5e-d6416edfab27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565624}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "893b4f39-63b4-53ad-9436-0ea8a59d0fab" :question/problem "![](images/3f/3fa6928e03ea158677a7a95970bd4a5694fecf07e29898395945508ce55c2b69.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $a$. Choose the unit vector in the same direction." :question/worked-solution "![](images/2e/2e7f98a3a56071215be52dcf70f568d868b6314b5e4831828cb6a83a0cc51966.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=5$ and $BH=2$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(5)^2+(2)^2} \\\\\n&= \\sqrt{25+4} \\\\\n&= \\sqrt{29}\n\\end{aligned}\n$$\n\nHence, the magnitude of $a$ is $\\sqrt{29}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|a|}\\cdot a \\\\\n&= \\frac{\\sqrt{29}}{29}a\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186565618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b4b1ab-c04f-5513-81bf-fbc605f7ad3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{10}a" :db/id #edb/ref 17592186565612} {:answer/id #uuid "a3928650-7241-534e-8f5e-a62180edd706" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}a" :db/id #edb/ref 17592186565619} {:answer/id #uuid "a4dc3529-b0d3-5899-bceb-b3f38f462306" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}a" :db/id #edb/ref 17592186565621} {:answer/id #uuid "ae52f227-de5a-5674-82ed-9e675e166b58" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sqrt{5}a" :db/id #edb/ref 17592186565622} {:answer/id #uuid "bd729940-7a3a-5abd-852b-38d2fdb1f70b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}a" :db/id #edb/ref 17592186565623}] :answer-field/correct {:answer/id #uuid "14b4b1ab-c04f-5513-81bf-fbc605f7ad3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{10}a" :db/id #edb/ref 17592186565612} :answer-field/id #uuid "504d3e27-e309-58e8-a757-b9930747358e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565614}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9bfbf2d2-bfbe-5c67-a31b-342360e76488" :question/problem "![](images/8d/8d36006c69a9e18e6b603641b4f0ce4f197c5be279b8c8cc4aa3921e3da98c41.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $a$. Choose the unit vector in the same direction." :question/worked-solution "![](images/6b/6b6d4c70f67251eacc9199fd18bb57f7b2ee6a84f24f33851e3f03e3a6796edd.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=2$ and $BH=4$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(2)^2+(4)^2} \\\\\n&= \\sqrt{4+16} \\\\\n&= 2 \\sqrt{5}\n\\end{aligned}\n$$\n\nHence, the magnitude of $a$ is $2 \\sqrt{5}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|a|}\\cdot a \\\\\n&= \\frac{\\sqrt{5}}{10}a\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41a4d7d5-a9c3-55b4-a14c-6f528ed3d880" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{26}a" :db/id #edb/ref 17592186567680} {:answer/id #uuid "6e2838ca-8839-5c6e-bce5-e33be0fa2203" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{26}a" :db/id #edb/ref 17592186567682} {:answer/id #uuid "a082a1eb-994b-53ec-9845-86a7e450fd94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{26}}{13}a" :db/id #edb/ref 17592186567683} {:answer/id #uuid "b867b942-3cfc-5194-bd6e-d438cd7f39af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{26}}{26}a" :db/id #edb/ref 17592186567684} {:answer/id #uuid "e0ab28f6-4393-5c32-aec3-124a318f279f" :answer/type {:db/ident :answer.type/math} :answer/value "1a" :db/id #edb/ref 17592186567686}] :answer-field/correct {:answer/id #uuid "b867b942-3cfc-5194-bd6e-d438cd7f39af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{26}}{26}a" :db/id #edb/ref 17592186567684} :answer-field/id #uuid "6b13fbef-105b-57e3-b389-514e96d3cd79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567681}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dc73ac92-52d3-59d7-b727-aa664056a93d" :question/problem "![](images/19/1918cfc0e0cc83334a16c7ee544b7314a8d12054999ce7c175604a2a39eb63ac.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $a$. Choose the unit vector in the same direction." :question/worked-solution "![](images/50/50d98e45b9996b85e50191c2164348ef4492dd45623c5c072699f2dac2feb87e.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=1$ and $BH=5$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(1)^2+(5)^2} \\\\\n&= \\sqrt{1+25} \\\\\n&= \\sqrt{26}\n\\end{aligned}\n$$\n\nHence, the magnitude of $a$ is $\\sqrt{26}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|a|}\\cdot a \\\\\n&= \\frac{\\sqrt{26}}{26}a\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6bcf0a9-648c-5969-b70f-729de3275926" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{13}}(p+q)" :db/id #edb/ref 17592186571924}] :answer-field/correct {:answer/id #uuid "d6bcf0a9-648c-5969-b70f-729de3275926" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{13}}(p+q)" :db/id #edb/ref 17592186571924} :answer-field/id #uuid "9a9adad1-9941-5e52-a6d0-5821492aa5a4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572053}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bf062e19-facf-5f56-9031-7ed68b8d30bc" :question/math-academy-id "q-275627" :question/problem "![](images/13/13fc8ff564a7162c556d050a10df6e8f23c0fca269e3b88168ca6681be3ad3a3.png)\n\nConsider the picture above. Find a unit vector $\\mathbf{u}$ that is parallel to  $\\mathbf{p}+\\mathbf{q}$ and has the same direction as $\\mathbf{p}+\\mathbf{q}.$ \n\nType $\\mathbf{p}$ and $q$ to represent the vectors $\\mathbf{p}$ and $\\mathbf{q},$ respectively.  \n\n$\\mathbf{u}=$\n{{field-1}}" :question/worked-solution "First, we have to find $p+q.$ According to the triangle law of addition, the resultant $p+q$ goes from the tail of $p$ to the head of $q:$ \n\n![](images/68/68c14ce5ff66272986e958f09f30289d56519e90b34fae23362753f84c042a50.png)\n\nIn $△AHB$, we have $∠AHB={90}^{∘}$, $AH=2$ and $BH=3.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}|p+q| & =AB \\\\  & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{(2)^{2}+(3)^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}.\\end{aligned}\n$$\n\nHence, the magnitude of $p+q$ is $\\sqrt{13}.$ Consequently, the unit vector is\n\n$$\n\\begin{aligned}u & =\\frac{1}{|p+q|}\\cdot (p+q) \\\\  & =\\frac{1}{\\sqrt{13}}(p+q).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "133b9a0b-07a3-5279-9f37-33049aaaa2e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{29}}p" :db/id #edb/ref 17592186571572} {:answer/id #uuid "b626256e-983a-5f2c-9230-3938cb23814d" :answer/type {:db/ident :answer.type/math} :answer/value "p" :db/id #edb/ref 17592186571857} {:answer/id #uuid "b80ef2f2-4a9b-5e69-872c-2881d1a0e191" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{29}p" :db/id #edb/ref 17592186571864} {:answer/id #uuid "c245d639-18f5-577d-a798-c53b48699ba5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{29}}p" :db/id #edb/ref 17592186571885} {:answer/id #uuid "f784eacd-53c7-568d-957e-7b132d8f2939" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{29}p" :db/id #edb/ref 17592186571964}] :answer-field/correct {:answer/id #uuid "c245d639-18f5-577d-a798-c53b48699ba5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{29}}p" :db/id #edb/ref 17592186571885} :answer-field/id #uuid "a3de6837-e66c-5b9a-a142-8fdce8446005" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572055}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cb1f02a3-6465-553f-a943-f356abc8fd01" :question/math-academy-id "q-119796" :question/problem "![](images/aa/aa72f6ea8c52a1f141f8469c3f932937b8b957956dc478811910e77c83336a9c.png)\n\nConsider the picture shown above. Which of the following is a unit vector that is parallel to $\\mathbf{p}?$" :question/worked-solution "![](images/4d/4d4d7faa0c0611c8ef891cda5fef3b75a61aa97e0879fac525f58f4ce263c937.png)\n\nIn $△AHB$, we have $∠AHB={90}^{∘}$, $AH=2$ and $BH=5.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}AB & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{2}^{2}+{5}^{2}} \\\\  & =\\sqrt{4+25} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$\n\nHence, the magnitude of $p$ is $\\sqrt{29}.$ Consequently, the unit vector is\n\n$$\n\\begin{aligned}u & =\\frac{1}{|\\,p\\,|}\\cdot p \\\\  & =\\frac{1}{\\sqrt{29}}p.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ea67919-5e18-5be7-9702-c464cf1d1177" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{2}}(a+b)" :db/id #edb/ref 17592186578323} {:answer/id #uuid "521517de-68d0-52cd-ad95-2e4548549291" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{2}}(a+b)" :db/id #edb/ref 17592186578400} {:answer/id #uuid "58e8a721-e8b8-5173-a99c-d8a915d45caa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}(a+b)" :db/id #edb/ref 17592186578416} {:answer/id #uuid "9bfd6a9b-c89e-5152-9b11-7c851f8e0bbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{2}}(a+b)" :db/id #edb/ref 17592186578520} {:answer/id #uuid "c8eacbfb-28db-5c6b-b078-42227e8a590d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}(a+b)" :db/id #edb/ref 17592186578584}] :answer-field/correct {:answer/id #uuid "1ea67919-5e18-5be7-9702-c464cf1d1177" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{2}}(a+b)" :db/id #edb/ref 17592186578323} :answer-field/id #uuid "ff69f484-6f82-5fef-b550-b26c32e5d4a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578788}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "254f47f4-de54-53f2-afdb-aefad812b57c" :question/math-academy-id "q-77224" :question/problem "![](images/3a/3af9e0f9483bf968ebf0db637e74c0536f19d4da6f15895d03ab04f39d1d98b0.png)\n\nConsider the picture above. Which of the following is a unit vector that is parallel to $\\mathbf{a}+\\mathbf{b}?$" :question/worked-solution "First, we have to find $a+b.$ According to the triangle law of addition, the resultant $a+b$ goes from the tail of $a$ to the head of $b:$\n\n![](images/f9/f95b72a0b508e0cdacef7de386888f3b473aeba01574ce5fb345b9fec74bb900.png)\n\nIn $△AHB$, we have $∠AHB={90}^{∘}$, $AH=2$ and $BH=2.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}|a+b| & =AB \\\\  & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{2}^{2}+{2}^{2}} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\nHence, the magnitude of $a+b$ is $2\\sqrt{2}.$ Consequently, the unit vector is\n\n$$\n\\begin{aligned}u & =\\frac{1}{|a+b|}\\cdot (a+b) \\\\  & =\\frac{1}{2\\sqrt{2}}(a+b).\\end{aligned}\n$$"}] :knowledge-point/title "Finding a Unit Vector Parallel to a Given Vector in a Diagram"}]}
