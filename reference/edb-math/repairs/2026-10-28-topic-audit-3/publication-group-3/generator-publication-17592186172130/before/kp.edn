,3⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u v),\\,\\frac{∂}{∂v}(- 3 u),\\,\\frac{∂}{∂v}(3 u - 2 v^{2})⟩ \\\\  & =⟨u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ v & -3 & 3 \\\\ u & 0 & - 4 v\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}-3 & 3 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}v & 3 \\\\ u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}v & -3 \\\\ u & 0\\end{vmatrix}⟩ \\\\  & =⟨12 v,\\,3 u + 4 v^{2},\\,3 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨12 v,\\,3 u + 4 v^{2},\\,3 u⟩‖ \\\\  & =\\sqrt{(12 v)^{2}+(3 u + 4 v^{2})^{2}+(3 u)^{2}} \\\\  & =\\sqrt{18 u^{2} + 24 u v^{2} + 16 v^{4} + 144 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(x - 3 y^{2} z)\\,{|}_{x=u v\\,y=- 3 u\\,z=3 u - 2 v^{2}} \\\\  & =u v-3\\cdot (- 3 u)^{2}\\cdot (3 u - 2 v^{2}) \\\\  & =- 81 u^{3} + 54 u^{2} v^{2} + u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 81 u^{3} + 54 u^{2} v^{2} + u v\\right) \\sqrt{18 u^{2} + 24 u v^{2} + 16 v^{4} + 144 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b418aa-8f50-529b-a254-a52c443915a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(3 u^{3} + u^{2} v^{2} + 2 u v\\right) \\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}" :db/id #edb/ref 17592186560306} {:answer/id #uuid "9c93004a-cd83-5a5e-91b3-6afd517b9553" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 3 u^{3} + u^{2} v^{2} + 2 u v\\right) \\left(40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}\\right)" :db/id #edb/ref 17592186560334} {:answer/id #uuid "bf0da7f6-74c9-595e-935f-fa2d5e17164f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 3 u^{3} + u^{2} v^{2} + 2 u v\\right) \\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}" :db/id #edb/ref 17592186560339} {:answer/id #uuid "d3279af3-c719-5f48-8397-3cee94b39b27" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(u^{2} v^{2} + 2 u v\\right) \\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}" :db/id #edb/ref 17592186560341} {:answer/id #uuid "fdb763ec-517c-56ab-a78d-f970a030bcd1" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 u^{3} + u^{2} v^{2} + 2 u v" :db/id #edb/ref 17592186560347}] :answer-field/correct {:answer/id #uuid "bf0da7f6-74c9-595e-935f-fa2d5e17164f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 3 u^{3} + u^{2} v^{2} + 2 u v\\right) \\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}" :db/id #edb/ref 17592186560339} :answer-field/id #uuid "27483cd1-fc63-57b7-82c5-fd8540038450" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560313}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7d206b38-df94-5588-845c-04813c06e146" :question/problem "$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nConsider the surface integral of the function \n$f(x,y,z)=x - y^{2} z$ \nover the parametric surface \n\n$$\nr(u,v)=⟨2 u v,\\,- u,\\,3 u - v^{2}⟩\n$$\n\nfor $(u,v)\\in D⊆{R}^{2}.$ What is the missing expression? Choose an integrand equal to the required expression as a function on $D$." :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2 u v),\\,\\frac{∂}{∂u}(- u),\\,\\frac{∂}{∂u}(3 u - v^{2})⟩ \\\\  & =⟨2 v,\\,-1,\\,3⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2 u v),\\,\\frac{∂}{∂v}(- u),\\,\\frac{∂}{∂v}(3 u - v^{2})⟩ \\\\  & =⟨2 u,\\,0,\\,- 2 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 v & -1 & 3 \\\\ 2 u & 0 & - 2 v\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}-1 & 3 \\\\ 0 & - 2 v\\end{vmatrix},\\,-\\begin{vmatrix}2 v & 3 \\\\ 2 u & - 2 v\\end{vmatrix},\\,\\begin{vmatrix}2 v & -1 \\\\ 2 u & 0\\end{vmatrix}⟩ \\\\  & =⟨2 v,\\,6 u + 4 v^{2},\\,2 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨2 v,\\,6 u + 4 v^{2},\\,2 u⟩‖ \\\\  & =\\sqrt{(2 v)^{2}+(6 u + 4 v^{2})^{2}+(2 u)^{2}} \\\\  & =\\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(x - y^{2} z)\\,{|}_{x=2 u v\\,y=- u\\,z=3 u - v^{2}} \\\\  & =2 u v-1\\cdot (- u)^{2}\\cdot (3 u - v^{2}) \\\\  & =- 3 u^{3} + u^{2} v^{2} + 2 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 3 u^{3} + u^{2} v^{2} + 2 u v\\right) \\sqrt{40 u^{2} + 48 u v^{2} + 16 v^{4} + 4 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dbbf8c5-b186-50e3-83eb-a34ac7c0c068" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 2 u^{3} + 2 u^{2} v^{2} + 6 u v\\right) \\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}" :db/id #edb/ref 17592186560316} {:answer/id #uuid "361ee39b-048e-5ba6-8456-29b75f167d20" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(2 u^{2} v^{2} + 6 u v\\right) \\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}" :db/id #edb/ref 17592186560319} {:answer/id #uuid "3f1e9e0f-f4d1-5f9b-b01e-4c51ccc96d26" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 u^{3} + 2 u^{2} v^{2} + 6 u v" :db/id #edb/ref 17592186560321} {:answer/id #uuid "71ff934d-be68-5886-a0e6-ceea28cda382" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(2 u^{3} + 2 u^{2} v^{2} + 6 u v\\right) \\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}" :db/id #edb/ref 17592186560327} {:answer/id #uuid "f8c64255-656c-592c-8b6f-d29d8add1e50" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 2 u^{3} + 2 u^{2} v^{2} + 6 u v\\right) \\left(45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}\\right)" :db/id #edb/ref 17592186560346}] :answer-field/correct {:answer/id #uuid "2dbbf8c5-b186-50e3-83eb-a34ac7c0c068" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 2 u^{3} + 2 u^{2} v^{2} + 6 u v\\right) \\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}" :db/id #edb/ref 17592186560316} :answer-field/id #uuid "d30326ca-d748-58e4-a5fd-30f7dcf9dd69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560340}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9b0c0134-9edd-51ff-b844-c0de83e1869b" :question/problem "$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nConsider the surface integral of the function \n$f(x,y,z)=2 x - y^{2} z$ \nover the parametric surface \n\n$$\nr(u,v)=⟨3 u v,\\,- u,\\,2 u - 2 v^{2}⟩\n$$\n\nfor $(u,v)\\in D⊆{R}^{2}.$ What is the missing expression? Choose an integrand equal to the required expression as a function on $D$." :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(3 u v),\\,\\frac{∂}{∂u}(- u),\\,\\frac{∂}{∂u}(2 u - 2 v^{2})⟩ \\\\  & =⟨3 v,\\,-1,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(3 u v),\\,\\frac{∂}{∂v}(- u),\\,\\frac{∂}{∂v}(2 u - 2 v^{2})⟩ \\\\  & =⟨3 u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 3 v & -1 & 2 \\\\ 3 u & 0 & - 4 v\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}-1 & 2 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}3 v & 2 \\\\ 3 u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}3 v & -1 \\\\ 3 u & 0\\end{vmatrix}⟩ \\\\  & =⟨4 v,\\,6 u + 12 v^{2},\\,3 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨4 v,\\,6 u + 12 v^{2},\\,3 u⟩‖ \\\\  & =\\sqrt{(4 v)^{2}+(6 u + 12 v^{2})^{2}+(3 u)^{2}} \\\\  & =\\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(2 x - y^{2} z)\\,{|}_{x=3 u v\\,y=- u\\,z=2 u - 2 v^{2}} \\\\  & =6 u v-1\\cdot (- u)^{2}\\cdot (2 u - 2 v^{2}) \\\\  & =- 2 u^{3} + 2 u^{2} v^{2} + 6 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 2 u^{3} + 2 u^{2} v^{2} + 6 u v\\right) \\sqrt{45 u^{2} + 144 u v^{2} + 144 v^{4} + 16 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d456bb7-3a9d-56dd-93b0-7a184a9a4649" :answer/type {:db/ident :answer.type/math} :answer/value "- 36 u^{3} + 36 u^{2} v^{2} + 2 u v" :db/id #edb/ref 17592186560303} {:answer/id #uuid "23028f52-cd66-57e0-afed-a3ec494e3381" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 36 u^{3} + 36 u^{2} v^{2} + 2 u v\\right) \\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}" :db/id #edb/ref 17592186560311} {:answer/id #uuid "7194190b-9e89-5f7e-af91-ce99d3f01169" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(36 u^{2} v^{2} + 2 u v\\right) \\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}" :db/id #edb/ref 17592186560326} {:answer/id #uuid "9cc0030a-0473-5ca6-886a-e1f5a05cd61d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 36 u^{3} + 36 u^{2} v^{2} + 2 u v\\right) \\left(13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}\\right)" :db/id #edb/ref 17592186560335} {:answer/id #uuid "fe35efa1-95dd-5d26-a0cd-9af6226ea03d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(36 u^{3} + 36 u^{2} v^{2} + 2 u v\\right) \\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}" :db/id #edb/ref 17592186560348}] :answer-field/correct {:answer/id #uuid "23028f52-cd66-57e0-afed-a3ec494e3381" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 36 u^{3} + 36 u^{2} v^{2} + 2 u v\\right) \\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}" :db/id #edb/ref 17592186560311} :answer-field/id #uuid "1f22210f-68bc-50f9-9ee4-c533602be0ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560310}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9d4bdd51-e427-51d6-919e-7d7980cc59de" :question/problem "$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nConsider the surface integral of the function \n$f(x,y,z)=2 x - 2 y^{2} z$ \nover the parametric surface \n\n$$\nr(u,v)=⟨u v,\\,- 3 u,\\,2 u - 2 v^{2}⟩\n$$\n\nfor $(u,v)\\in D⊆{R}^{2}.$ What is the missing expression? Choose an integrand equal to the required expression as a function on $D$." :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u v),\\,\\frac{∂}{∂u}(- 3 u),\\,\\frac{∂}{∂u}(2 u - 2 v^{2})⟩ \\\\  & =⟨v,\\,-3,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u v),\\,\\frac{∂}{∂v}(- 3 u),\\,\\frac{∂}{∂v}(2 u - 2 v^{2})⟩ \\\\  & =⟨u,\\,0,\\,- 4 v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ v & -3 & 2 \\\\ u & 0 & - 4 v\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}-3 & 2 \\\\ 0 & - 4 v\\end{vmatrix},\\,-\\begin{vmatrix}v & 2 \\\\ u & - 4 v\\end{vmatrix},\\,\\begin{vmatrix}v & -3 \\\\ u & 0\\end{vmatrix}⟩ \\\\  & =⟨12 v,\\,2 u + 4 v^{2},\\,3 u⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨12 v,\\,2 u + 4 v^{2},\\,3 u⟩‖ \\\\  & =\\sqrt{(12 v)^{2}+(2 u + 4 v^{2})^{2}+(3 u)^{2}} \\\\  & =\\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(2 x - 2 y^{2} z)\\,{|}_{x=u v\\,y=- 3 u\\,z=2 u - 2 v^{2}} \\\\  & =2 u v-2\\cdot (- 3 u)^{2}\\cdot (2 u - 2 v^{2}) \\\\  & =- 36 u^{3} + 36 u^{2} v^{2} + 2 u v\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,\\left(- 36 u^{3} + 36 u^{2} v^{2} + 2 u v\\right) \\sqrt{13 u^{2} + 16 u v^{2} + 16 v^{4} + 144 v^{2}}\\,\\,\\text{d}A.\\end{aligned}\n$$"}] :knowledge-point/title "Constructing Surface Integrals Over Parametric Surfaces"}]}
