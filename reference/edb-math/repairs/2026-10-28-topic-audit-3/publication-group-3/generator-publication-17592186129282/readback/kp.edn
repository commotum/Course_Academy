}\\\\\\frac{\\partial y}{\\partial u}&\\frac{\\partial y}{\\partial v}\\end{vmatrix}\\\\& =\\begin{vmatrix}6 \\left(u + v\\right)^{2}&6 \\left(u + v\\right)^{2}\\\\4 \\left(2 u - v\\right)&- 2 \\left(2 u - v\\right)\\end{vmatrix}\\\\& =(6 \\left(u + v\\right)^{2})\\cdot (- 2 \\left(2 u - v\\right))-(6 \\left(u + v\\right)^{2})\\cdot (4 \\left(2 u - v\\right))\\\\& =- 72 u^{3} - 108 u^{2} v + 36 v^{3}\\\\& =- 36 \\left(u + v\\right)^{2} \\left(2 u - v\\right)\\\\\\left.\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|_{(-2,1)} & =\\left(- 36 \\left(u + v\\right)^{2} \\left(2 u - v\\right)\\right)\\big|_{u=-2,v=1}\\\\& =- 36 \\left((-2) + (1)\\right)^{2} \\left(2 (-2) - (1)\\right)\\\\& =180\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & \\approx|180|\\cdot\\delta A\\\\ & =180\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e43eb16-fd50-58a8-a646-55a7b162847a" :answer/type {:db/ident :answer.type/math} :answer/value "360\\,\\delta A" :db/id #edb/ref 17592186518927} {:answer/id #uuid "5078973b-c6bc-557e-bd48-736bc3b4c202" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{180}\\,\\delta A" :db/id #edb/ref 17592186518928} {:answer/id #uuid "5ea468ed-e1fe-5ba2-9fa5-fefe32cc95ed" :answer/type {:db/ident :answer.type/math} :answer/value "32400\\,\\delta A" :db/id #edb/ref 17592186518934} {:answer/id #uuid "69db795c-5742-5b39-9574-c13288983347" :answer/type {:db/ident :answer.type/math} :answer/value "180\\,\\delta A" :db/id #edb/ref 17592186518938} {:answer/id #uuid "93bb489d-c9e5-5d96-b8d7-5033a9c1010a" :answer/type {:db/ident :answer.type/math} :answer/value "90\\,\\delta A" :db/id #edb/ref 17592186518947}] :answer-field/correct {:answer/id #uuid "69db795c-5742-5b39-9574-c13288983347" :answer/type {:db/ident :answer.type/math} :answer/value "180\\,\\delta A" :db/id #edb/ref 17592186518938} :answer-field/id #uuid "f0f839a4-8628-5b5f-ac1d