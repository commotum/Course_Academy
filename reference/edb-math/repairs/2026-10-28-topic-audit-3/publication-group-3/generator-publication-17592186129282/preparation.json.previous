592186383531} {:answer/id #uuid \"7b00f634-9599-5965-8f40-9e6474ab0791\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186383532} {:answer/id #uuid \"f38e3aba-b47f-541c-aa66-da66bf8d1540\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\delta A\" :db/id 17592186383533} {:answer/id #uuid \"cfcbe347-2504-5975-baa3-b1307425330b\" :answer/type {:db/ident :answer.type/math} :answer/value \"14\\\\,\\\\delta A\" :db/id 17592186383534}] :answer-field/correct {:answer/id #uuid \"817eea6b-4bcd-50a0-bd01-e9c9361a4607\" :answer/type {:db/ident :answer.type/math} :answer/value \"26\\\\,\\\\delta A\" :db/id 17592186383531} :answer-field/id #uuid \"ae626fe0-3107-5566-bc20-cde6cc1edd64\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186383529}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"fff1ef63-7fa2-5e33-aa47-b4df6f56d662\" :question/math-academy-id \"q-161788\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}{u}^{2}+v \\\\\\\\ 2u-{v}^{3}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}2u & 1 \\\\\\\\ 2 & -3{v}^{2}\\\\end{vmatrix} \\\\\\\\  & =2u\\\\cdot (-3{v}^{2})-1\\\\cdot 2 \\\\\\\\  & =-6u{v}^{2}-2 \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(1,2)} & =(-6u{v}^{2}-2)\\\\,{|}_{u=1\\\\,v=2} \\\\\\\\  & =-6(1)(2)^{2}-2 \\\\\\\\  & =-26\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|-26|\\\\cdot \\\\delta A \\\\\\\\  & =26\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186129527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"34dc7b2d-483b-5c21-bc52-af09b2738d49\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186279050} {:answer/id #uuid \"c1a09ab6-33e6-5ece-a662-897c11c5ccd4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\delta A\" :db/id 17592186280292} {:answer/id #uuid \"d69096ab-d2da-522b-a9e8-43b1733cab55\" :answer/type {:db/ident :answer.type/math} :answer/value \"11\\\\,\\\\delta A\" :db/id 17592186280486} {:answer/id #uuid \"da3fef5b-3c5a-5bb3-87f5-3ea6a20ec484\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\delta A\" :db/id 17592186280518} {:answer/id #uuid \"fed38294-cb1c-52e8-92ca-723bf52e3cde\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186280820}] :answer-field/correct {:answer/id #uuid \"34dc7b2d-483b-5c21-bc52-af09b2738d49\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186279050} :answer-field/id #uuid \"41f8b0d5-fe40-59fc-a296-062330e0b4a9\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186280944}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c116e20c-7c3c-5121-8057-e62b04b89e02\" :question/math-academy-id \"q-161832\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,5)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}\\\\operatorname{ln}(uv) \\\\\\\\ u{v}^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}\\\\frac{1}{u} & \\\\frac{1}{v} \\\\\\\\ {v}^{2} & 2uv\\\\end{vmatrix} \\\\\\\\  & =\\\\frac{1}{u}\\\\cdot 2uv-\\\\frac{1}{v}\\\\cdot {v}^{2} \\\\\\\\  & =2v-v \\\\\\\\  & =v \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(1,5)} & =v\\\\,{|}_{u=1\\\\,v=5} \\\\\\\\  & =5\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|5|\\\\cdot \\\\delta A \\\\\\\\  & =5\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186281348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"30c1db1d-2cc0-5ac8-8f04-c8180becd16a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\,\\\\delta A\" :db/id 17592186383542} {:answer/id #uuid \"821cd8c6-8ff9-5da6-80d4-645283944e57\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186383543} {:answer/id #uuid \"ba9f678f-6723-5d0a-aaf8-823aac52bf9c\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\,\\\\delta A\" :db/id 17592186383544} {:answer/id #uuid \"3dd393ca-0f85-5050-8edc-c100a9d38ea2\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\delta A\" :db/id 17592186383545} {:answer/id #uuid \"9ab28153-3505-5ac2-969c-4808d24a5d4b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\delta A\" :db/id 17592186383546}] :answer-field/correct {:answer/id #uuid \"3dd393ca-0f85-5050-8edc-c100a9d38ea2\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\delta A\" :db/id 17592186383545} :answer-field/id #uuid \"91eca270-f22e-5746-93f6-648d523d80f9\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186383541}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"7c1651a7-19c3-5fc6-882f-8612e069dc1b\" :question/math-academy-id \"q-161831\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-1,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}v{e}^{u} \\\\\\\\ u{e}^{v}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}v{e}^{u} & {e}^{u} \\\\\\\\ {e}^{v} & u{e}^{v}\\\\end{vmatrix} \\\\\\\\  & =v{e}^{u}\\\\cdot u{e}^{v}-{e}^{v}\\\\cdot {e}^{u} \\\\\\\\  & =uv{e}^{u+v}-{e}^{u+v} \\\\\\\\  & =(uv-1){e}^{u+v} \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(-1,1)} & =(uv-1){e}^{u+v}\\\\,{|}_{u=-1\\\\,v=1} \\\\\\\\  & =(-1\\\\cdot 1-1){e}^{-1+1} \\\\\\\\  & =-2\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|-2|\\\\cdot \\\\delta A \\\\\\\\  & =2\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186281366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5a27b376-f76e-5224-bd14-dcd0f58ef17d\" :answer/type {:db/ident :answer.type/math} :answer/value \"14\\\\,\\\\delta A\" :db/id 17592186279419} {:answer/id #uuid \"6df88852-e281-540b-9be8-5da79ff04db5\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\delta A\" :db/id 17592186279592} {:answer/id #uuid \"e29c7966-53cc-5a98-a45d-f216ac316386\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\,\\\\delta A\" :db/id 17592186280594} {:answer/id #uuid \"e5bf82bf-7ae4-51b0-8078-b62137d694c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"9\\\\,\\\\delta A\" :db/id 17592186280619} {:answer/id #uuid \"f2ae113f-b190-5e88-a500-9aa18217b4af\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186280706}] :answer-field/correct {:answer/id #uuid \"6df88852-e281-540b-9be8-5da79ff04db5\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\delta A\" :db/id 17592186279592} :answer-field/id #uuid \"150f9199-b68c-5aef-8efe-e079ecbd49f8\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186280869}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"9ee4cd0d-00ad-5fb0-be36-91eca3f6f7a9\" :question/math-academy-id \"q-161873\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}\\\\frac{1}{u}-v \\\\\\\\ {u}^{2}v\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}-\\\\frac{1}{{u}^{2}} & -1 \\\\\\\\ 2uv & {u}^{2}\\\\end{vmatrix} \\\\\\\\  & =\\\\left(-\\\\frac{1}{{u}^{2}}\\\\right)\\\\cdot ({u}^{2})-2uv\\\\cdot (-1) \\\\\\\\  & =-1+2uv \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(2,2)} & =(-1+2uv)\\\\,{|}_{u=2\\\\,v=2} \\\\\\\\  & =-1+2(2)(2) \\\\\\\\  & =7\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|7|\\\\cdot \\\\delta A \\\\\\\\  & =7\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186281367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4d9515a0-7aca-5bd0-93c2-b5138c7c3052\" :answer/type {:db/ident :answer.type/math} :answer/value \"15\\\\,\\\\delta A\" :db/id 17592186279294} {:answer/id #uuid \"62fb6c42-d7b5-5116-b4d8-c608240b0020\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\delta A\" :db/id 17592186279491} {:answer/id #uuid \"65e00832-3370-516f-bf0e-931f9e463a62\" :answer/type {:db/ident :answer.type/math} :answer/value \"21\\\\,\\\\delta A\" :db/id 17592186279521} {:answer/id #uuid \"c042a147-a78a-546c-adff-8d9859d6b5eb\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186280284} {:answer/id #uuid \"df364235-b831-5c0a-a5fa-907e835f3022\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\,\\\\delta A\" :db/id 17592186280559}] :answer-field/correct {:answer/id #uuid \"62fb6c42-d7b5-5116-b4d8-c608240b0020\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\delta A\" :db/id 17592186279491} :answer-field/id #uuid \"3c8c07a6-1fb4-5da8-abe5-ac2081b48db6\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186280937}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"9201622d-d447-58b4-8006-2fbea11393d4\" :question/math-academy-id \"q-161874\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(4,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}\\\\sqrt{u}+{v}^{2} \\\\\\\\ uv\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}\\\\frac{1}{2\\\\sqrt{u}} & 2v \\\\\\\\ v & u\\\\end{vmatrix} \\\\\\\\  & =\\\\frac{1}{2\\\\sqrt{u}}\\\\cdot u-v\\\\cdot 2v \\\\\\\\  & =\\\\frac{1}{2}\\\\sqrt{u}-2{v}^{2} \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(4,2)} & ={\\\\frac{1}{2}\\\\sqrt{u}-2{v}^{2}\\\\,|}_{u=4\\\\,v=2} \\\\\\\\  & =\\\\frac{1}{2}\\\\sqrt{4}-2(2)^{2} \\\\\\\\  & =-7\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|-7|\\\\cdot \\\\delta A \\\\\\\\  & =7\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186281368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"018385f7-7519-5922-8545-718d1e4443e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\,\\\\delta A\" :db/id 17592186278597} {:answer/id #uuid \"09f72da4-93f7-5f6e-8f5c-7adf97a2d87b\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\,\\\\delta A\" :db/id 17592186278688} {:answer/id #uuid \"42229dfb-92db-527f-98d4-81e464debdce\" :answer/type {:db/ident :answer.type/math} :answer/value \"16\\\\,\\\\delta A\" :db/id 17592186279182} {:answer/id #uuid \"5806f5cb-b442-516d-a7af-f295ed7a67a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"9\\\\,\\\\delta A\" :db/id 17592186279401} {:answer/id #uuid \"b63f49ff-6805-5e3d-9a84-bb5bf0cb46d3\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186280191}] :answer-field/correct {:answer/id #uuid \"09f72da4-93f7-5f6e-8f5c-7adf97a2d87b\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\,\\\\delta A\" :db/id 17592186278688} :answer-field/id #uuid \"30341de0-d7c9-531a-935d-0764a34a14a5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186280923}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"8a571cf4-d621-5149-95d3-896e62b990d5\" :question/math-academy-id \"q-161875\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(0,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}\\\\operatorname{cos}u-{v}^{2} \\\\\\\\ u+v\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}-\\\\operatorname{sin}⁡u & -2v \\\\\\\\ 1 & 1\\\\end{vmatrix} \\\\\\\\  & =(-\\\\operatorname{sin}⁡u)\\\\cdot 1-1\\\\cdot (-2v) \\\\\\\\  & =-\\\\operatorname{sin}⁡u+2v \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(0,3)} & =(-\\\\operatorname{sin}⁡u+2v)\\\\,{|}_{u=0\\\\,v=3} \\\\\\\\  & =-\\\\operatorname{sin}⁡0+2(3) \\\\\\\\  & =6\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|6|\\\\cdot \\\\delta A \\\\\\\\  & =6\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186281371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6868218d-e1cc-5d50-a993-c991f43b1d4f\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186279541} {:answer/id #uuid \"7cc9479c-c9e8-5ef9-bf90-29e06a33263c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\delta A\" :db/id 17592186279705} {:answer/id #uuid \"9162be54-7854-53e2-9565-c82bf2b82b2e\" :answer/type {:db/ident :answer.type/math} :answer/value \"9\\\\,\\\\delta A\" :db/id 17592186279888} {:answer/id #uuid \"d5ff9956-5830-5df1-9e06-3627aaf262d4\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\,\\\\delta A\" :db/id 17592186280480} {:answer/id #uuid \"d96ff063-ffb7-5f8f-95e7-79745e683d0f\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\,\\\\delta A\" :db/id 17592186280513}] :answer-field/correct {:answer/id #uuid \"6868218d-e1cc-5d50-a993-c991f43b1d4f\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186279541} :answer-field/id #uuid \"cf437f98-16a0-57d1-a983-d2d8546f1bd5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186281197}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"4a48d509-ce9f-57c3-ab71-29eb65410f8f\" :question/math-academy-id \"q-161885\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}\\\\frac{{u}^{2}}{v} \\\\\\\\ uv\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}\\\\frac{2u}{v} & -\\\\frac{{u}^{2}}{{v}^{2}} \\\\\\\\ v & u\\\\end{vmatrix} \\\\\\\\  & =\\\\frac{2u}{v}\\\\cdot u-v\\\\cdot \\\\left(-\\\\frac{{u}^{2}}{{v}^{2}}\\\\right) \\\\\\\\  & =\\\\frac{2{u}^{2}}{v}+\\\\frac{{u}^{2}}{v} \\\\\\\\  & =\\\\frac{3{u}^{2}}{v} \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(2,4)} & =\\\\left(\\\\frac{3{u}^{2}}{v}\\\\right)\\\\,{|}_{u=2\\\\,v=4} \\\\\\\\  & =\\\\frac{3(2)^{2}}{4} \\\\\\\\  & =3\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|3|\\\\cdot \\\\delta A \\\\\\\\  & =3\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186281372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1cbff252-78de-56e0-9831-68d0d5847cf4\" :answer/type {:db/ident :answer.type/math} :answer/value \"16\\\\,\\\\delta A\" :db/id 17592186278858} {:answer/id #uuid \"254166ee-c366-5b0a-8254-ef1c99d8cefa\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\delta A\" :db/id 17592186278923} {:answer/id #uuid \"4a7b2391-4ac4-5aba-b7fd-d5c4a0c731ac\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\,\\\\delta A\" :db/id 17592186279258} {:answer/id #uuid \"5bb16338-8739-5100-afb4-a97df7a35f4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\,\\\\delta A\" :db/id 17592186279437} {:answer/id #uuid \"5ec2c7bb-fc96-59d3-9cef-a3d5103aac04\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\delta A\" :db/id 17592186279461}] :answer-field/correct {:answer/id #uuid \"5bb16338-8739-5100-afb4-a97df7a35f4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\,\\\\delta A\" :db/id 17592186279437} :answer-field/id #uuid \"82c1b0c7-bd87-588b-918a-c6b0538039e7\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186281069}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"787ef4d5-9dfe-5be7-87e1-4a46bed285bf\" :question/math-academy-id \"q-161887\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}\\\\sqrt{uv} \\\\\\\\ u{v}^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}\\\\frac{\\\\sqrt{v}}{2\\\\sqrt{u}} & \\\\frac{\\\\sqrt{u}}{2\\\\sqrt{v}} \\\\\\\\ {v}^{2} & 2uv\\\\end{vmatrix} \\\\\\\\  & =\\\\frac{\\\\sqrt{v}}{2\\\\sqrt{u}}\\\\cdot 2uv-{v}^{2}\\\\cdot \\\\frac{\\\\sqrt{u}}{2\\\\sqrt{v}} \\\\\\\\  & =v\\\\sqrt{uv}-\\\\frac{1}{2}v\\\\sqrt{uv} \\\\\\\\  & =\\\\frac{1}{2}v\\\\sqrt{uv} \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(1,4)} & ={(\\\\frac{1}{2}v\\\\sqrt{uv})\\\\,|}_{u=1\\\\,v=4} \\\\\\\\  & =\\\\frac{1}{2}(4)\\\\sqrt{(1)(4)} \\\\\\\\  & =4\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|4|\\\\cdot \\\\delta A \\\\\\\\  & =4\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186383568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5f94640a-439d-5450-b89c-214d6351fa55\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\,\\\\delta A\" :db/id 17592186383570} {:answer/id #uuid \"22b7af57-2308-539f-b4dc-7bf734738b88\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186383571} {:answer/id #uuid \"305c7067-b121-52de-832b-2cd582abe378\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186383572} {:answer/id #uuid \"0e57c966-7e8f-5c20-b14e-3fff17deba68\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\,\\\\delta A\" :db/id 17592186383573} {:answer/id #uuid \"c14d8db9-1f54-501a-a0d4-dbdd47484709\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\delta A\" :db/id 17592186383574}] :answer-field/correct {:answer/id #uuid \"305c7067-b121-52de-832b-2cd582abe378\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\,\\\\delta A\" :db/id 17592186383572} :answer-field/id #uuid \"1fd0ed70-8ad1-5612-8701-9b382b52743e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186383569}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"6f0941ca-edd5-5538-8a0c-b3d25f8e41f5\" :question/math-academy-id \"q-161877\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}\\\\operatorname{ln}(u-v) \\\\\\\\ v-{u}^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}\\\\frac{1}{u-v} & -\\\\frac{1}{u-v} \\\\\\\\ -2u & 1\\\\end{vmatrix} \\\\\\\\  & =\\\\frac{1}{u-v}\\\\cdot 1-(-2u)\\\\cdot \\\\left(-\\\\frac{1}{u-v}\\\\right) \\\\\\\\  & =\\\\frac{1-2u}{u-v} \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(2,1)} & ={\\\\left(\\\\frac{1-2u}{u-v}\\\\right)\\\\,|}_{u=2\\\\,v=1} \\\\\\\\  & =\\\\frac{1-2(2)}{2-1} \\\\\\\\  & =-3\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|-3|\\\\cdot \\\\delta A \\\\\\\\  & =3\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186383575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"61164a03-d653-5509-8896-92a9f5d833f2\" :answer/type {:db/ident :answer.type/math} :answer/value \"12\\\\,\\\\delta A\" :db/id 17592186383577} {:answer/id #uuid \"5766d69f-6242-5cfa-96ee-c8cd587905ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186383578} {:answer/id #uuid \"6ec2c14a-52b6-5478-a60f-1f678392ec7a\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\,\\\\delta A\" :db/id 17592186383579} {:answer/id #uuid \"5317cbac-448e-539f-b6c8-0a7df3081b44\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\,\\\\delta A\" :db/id 17592186383580} {:answer/id #uuid \"18259f51-378f-592e-be8d-c8109a57fd90\" :answer/type {:db/ident :answer.type/math} :answer/value \"7\\\\,\\\\delta A\" :db/id 17592186383581}] :answer-field/correct {:answer/id #uuid \"5766d69f-6242-5cfa-96ee-c8cd587905ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186383578} :answer-field/id #uuid \"c852d323-c95a-5a6d-9333-8d677385a559\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186383576}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"3a2efb4f-04d0-536e-850b-89df0bdf4245\" :question/math-academy-id \"q-161878\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-3,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}u+{v}^{2} \\\\\\\\ \\\\operatorname{sin}(u+v)\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}1 & 2v \\\\\\\\ \\\\operatorname{cos}⁡(u+v) & \\\\operatorname{cos}⁡(u+v)\\\\end{vmatrix} \\\\\\\\  & =1\\\\cdot \\\\operatorname{cos}⁡(u+v)-\\\\operatorname{cos}⁡(u+v)\\\\cdot 2v \\\\\\\\  & =(1-2v)\\\\operatorname{cos}⁡(u+v) \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(-3,3)} & =(1-2v)\\\\operatorname{cos}⁡(u+v)\\\\,{|}_{u=-3\\\\,v=3} \\\\\\\\  & =(1-2(3))\\\\operatorname{cos}⁡(-3+3) \\\\\\\\  & =-5\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|-5|\\\\cdot \\\\delta A \\\\\\\\  & =5\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186389216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"efa02fb0-8bd7-58b2-846f-b834fa4d00a5\" :answer/type {:db/ident :answer.type/math} :answer/value \"21\\\\,\\\\delta A\" :db/id 17592186389218} {:answer/id #uuid \"f26a101a-d1b7-54cb-9da6-045b68d673b8\" :answer/type {:db/ident :answer.type/math} :answer/value \"18\\\\,\\\\delta A\" :db/id 17592186389219} {:answer/id #uuid \"102a5894-9256-52e2-86ff-598cf595625d\" :answer/type {:db/ident :answer.type/math} :answer/value \"13\\\\,\\\\delta A\" :db/id 17592186389220} {:answer/id #uuid \"a7e6000c-9905-5a76-9098-325dd8f54c3e\" :answer/type {:db/ident :answer.type/math} :answer/value \"11\\\\,\\\\delta A\" :db/id 17592186389221} {:answer/id #uuid \"eca4c4f3-4d0e-5221-a6c4-b18b4d27e0a2\" :answer/type {:db/ident :answer.type/math} :answer/value \"17\\\\,\\\\delta A\" :db/id 17592186389222}] :answer-field/correct {:answer/id #uuid \"a7e6000c-9905-5a76-9098-325dd8f54c3e\" :answer/type {:db/ident :answer.type/math} :answer/value \"11\\\\,\\\\delta A\" :db/id 17592186389221} :answer-field/id #uuid \"c652ad8c-b6bc-516a-b0a9-9d72286277e2\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186389217}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"dc1b537d-1bb4-5840-be74-781a73ccdf95\" :question/math-academy-id \"q-161876\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-2,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}{e}^{u+v} \\\\\\\\ {u}^{3}+v\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}{e}^{u+v} & {e}^{u+v} \\\\\\\\ 3{u}^{2} & 1\\\\end{vmatrix} \\\\\\\\  & ={e}^{u+v}\\\\cdot 1-3{u}^{2}\\\\cdot {e}^{u+v} \\\\\\\\  & ={e}^{u+v}(1-3{u}^{2}) \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(-2,2)} & ={e}^{u+v}(1-3{u}^{2})\\\\,{|}_{u=-2\\\\,v=2} \\\\\\\\  & ={e}^{-2+2}(1-3(-2)^{2}) \\\\\\\\  & =-11\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|-11|\\\\cdot \\\\delta A \\\\\\\\  & =11\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186502096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0edfd29e-3a12-5f5c-aa4d-c9d232e9d8ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"8\\\\,\\\\delta A\" :db/id 17592186501491} {:answer/id #uuid \"10477c22-e6c0-5396-865c-7efb2e452797\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\,\\\\delta A\" :db/id 17592186501495} {:answer/id #uuid \"1354d1db-51ab-5f5c-944c-79110ffcc91b\" :answer/type {:db/ident :answer.type/math} :answer/value \"18\\\\,\\\\delta A\" :db/id 17592186501502} {:answer/id #uuid \"3ba7e918-0922-576c-91b5-2e38e5a1b977\" :answer/type {:db/ident :answer.type/math} :answer/value \"13\\\\,\\\\delta A\" :db/id 17592186501571} {:answer/id #uuid \"84d571a0-192f-5d6b-bfdc-6b4cf1be9b9e\" :answer/type {:db/ident :answer.type/math} :answer/value \"26\\\\,\\\\delta A\" :db/id 17592186501720}] :answer-field/correct {:answer/id #uuid \"84d571a0-192f-5d6b-bfdc-6b4cf1be9b9e\" :answer/type {:db/ident :answer.type/math} :answer/value \"26\\\\,\\\\delta A\" :db/id 17592186501720} :answer-field/id #uuid \"9a680a9f-c944-5dc6-b6be-a4a3dda024b5\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186502031}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"3d5c488c-135d-5c5b-b6fb-380729a9e440\" :question/math-academy-id \"q-161886\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(3,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\\\mathbf{T},$ given by\\n\\n$$\\n\\\\mathbf{T}:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}⟶\\\\begin{bmatrix}{u}^{3}-v \\\\\\\\ v-u\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))≈|\\\\frac{∂(x,y)}{∂(u,v)}|\\\\cdot \\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\n \\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{∂(x,y)}{∂(u,v)} & =\\\\begin{vmatrix}\\\\frac{∂x}{∂u} & \\\\frac{∂x}{∂v} \\\\\\\\ \\\\frac{∂y}{∂u} & \\\\frac{∂y}{∂v}\\\\end{vmatrix} \\\\\\\\  & =\\\\begin{vmatrix}3{u}^{2} & -1 \\\\\\\\ -1 & 1\\\\end{vmatrix} \\\\\\\\  & =3{u}^{2}\\\\cdot 1-(-1)\\\\cdot (-1) \\\\\\\\  & =3{u}^{2}-1 \\\\\\\\ {\\\\frac{∂(x,y)}{∂(u,v)}|}_{(3,1)} & =(3{u}^{2}-1)\\\\,{|}_{u=3\\\\,v=1} \\\\\\\\  & =3(3)^{2}-1 \\\\\\\\  & =26\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & ≈|26|\\\\cdot \\\\delta A \\\\\\\\  & =26\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"10c25e88-eda6-5994-8669-2fc4e8989223\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{80}\\\\,\\\\delta A\" :db/id 17592186518907} {:answer/id #uuid \"2938687d-5d55-5245-8c65-6f9840dccd9b\" :answer/type {:db/ident :answer.type/math} :answer/value \"160\\\\,\\\\delta A\" :db/id 17592186518914} {:answer/id #uuid \"3f0938ab-55ed-5367-8d20-ae9cdfd95ae8\" :answer/type {:db/ident :answer.type/math} :answer/value \"80\\\\,\\\\delta A\" :db/id 17592186518920} {:answer/id #uuid \"a3238964-bd1d-5761-80d6-d8671006ef6f\" :answer/type {:db/ident :answer.type/math} :answer/value \"6400\\\\,\\\\delta A\" :db/id 17592186518951} {:answer/id #uuid \"b76da343-223a-5697-a37a-50a8d039196b\" :answer/type {:db/ident :answer.type/math} :answer/value \"40\\\\,\\\\delta A\" :db/id 17592186518960}] :answer-field/correct {:answer/id #uuid \"3f0938ab-55ed-5367-8d20-ae9cdfd95ae8\" :answer/type {:db/ident :answer.type/math} :answer/value \"80\\\\,\\\\delta A\" :db/id 17592186518920} :answer-field/id #uuid \"f13aea66-5851-5988-acfe-308733165daa\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518972}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"14ceb78e-322f-54a1-9174-9de018a820b6\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}2 u v^{3}\\\\\\\\3 u^{2} + v^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}2 v^{3}&6 u v^{2}\\\\\\\\6 u&2 v\\\\end{vmatrix}\\\\\\\\& =(2 v^{3})\\\\cdot (2 v)-(6 u v^{2})\\\\cdot (6 u)\\\\\\\\& =- 36 u^{2} v^{2} + 4 v^{4}\\\\\\\\& =- 4 v^{2} \\\\left(3 u - v\\\\right) \\\\left(3 u + v\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(-1,2)} & =\\\\left(- 4 v^{2} \\\\left(3 u - v\\\\right) \\\\left(3 u + v\\\\right)\\\\right)\\\\big|_{u=-1,v=2}\\\\\\\\& =- 4 (2)^{2} \\\\left(3 (-1) - (2)\\\\right) \\\\left(3 (-1) + (2)\\\\right)\\\\\\\\& =-80\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|-80|\\\\cdot\\\\delta A\\\\\\\\ & =80\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"68183119-0e35-5d48-af62-a8b0b531100a\" :answer/type {:db/ident :answer.type/math} :answer/value \"192\\\\,\\\\delta A\" :db/id 17592186518936} {:answer/id #uuid \"6abf04e2-7547-5fd6-adf1-679bbe9324da\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{96}\\\\,\\\\delta A\" :db/id 17592186518939} {:answer/id #uuid \"a3594f26-df2d-522d-8678-6bd28bc24f8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"9216\\\\,\\\\delta A\" :db/id 17592186518952} {:answer/id #uuid \"b0631b4b-2af0-51ae-9938-eed818a10498\" :answer/type {:db/ident :answer.type/math} :answer/value \"48\\\\,\\\\delta A\" :db/id 17592186518957} {:answer/id #uuid \"d956c4c8-a269-5eba-9d74-d31be57b55d0\" :answer/type {:db/ident :answer.type/math} :answer/value \"96\\\\,\\\\delta A\" :db/id 17592186518965}] :answer-field/correct {:answer/id #uuid \"d956c4c8-a269-5eba-9d74-d31be57b55d0\" :answer/type {:db/ident :answer.type/math} :answer/value \"96\\\\,\\\\delta A\" :db/id 17592186518965} :answer-field/id #uuid \"d765db19-5dd7-5fc5-8884-f5f88ec83632\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518964}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2f65179e-ed0f-5b0a-a190-a9cd8645ec56\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-3,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}3 u v^{2}\\\\\\\\u^{2} + 2 v^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}3 v^{2}&6 u v\\\\\\\\2 u&4 v\\\\end{vmatrix}\\\\\\\\& =(3 v^{2})\\\\cdot (4 v)-(6 u v)\\\\cdot (2 u)\\\\\\\\& =- 12 u^{2} v + 12 v^{3}\\\\\\\\& =- 12 v \\\\left(u - v\\\\right) \\\\left(u + v\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(-3,-1)} & =\\\\left(- 12 v \\\\left(u - v\\\\right) \\\\left(u + v\\\\right)\\\\right)\\\\big|_{u=-3,v=-1}\\\\\\\\& =- 12 (-1) \\\\left(- (-1) + (-3)\\\\right) \\\\left((-1) + (-3)\\\\right)\\\\\\\\& =96\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|96|\\\\cdot\\\\delta A\\\\\\\\ & =96\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"43b9aafb-7456-5f41-8063-d0b78c7dd2fe\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{180}\\\\,\\\\delta A\" :db/id 17592186518923} {:answer/id #uuid \"48539ef9-0109-5101-b692-7f33dca51bb8\" :answer/type {:db/ident :answer.type/math} :answer/value \"90\\\\,\\\\delta A\" :db/id 17592186518925} {:answer/id #uuid \"57aafb72-bdac-55be-80f7-7b85776228a9\" :answer/type {:db/ident :answer.type/math} :answer/value \"180\\\\,\\\\delta A\" :db/id 17592186518932} {:answer/id #uuid \"7aa80141-2ce2-5349-94f1-543788e1555c\" :answer/type {:db/ident :answer.type/math} :answer/value \"32400\\\\,\\\\delta A\" :db/id 17592186518941} {:answer/id #uuid \"ea8be9f3-91f4-5cba-858d-41aaac0aa322\" :answer/type {:db/ident :answer.type/math} :answer/value \"360\\\\,\\\\delta A\" :db/id 17592186518968}] :answer-field/correct {:answer/id #uuid \"57aafb72-bdac-55be-80f7-7b85776228a9\" :answer/type {:db/ident :answer.type/math} :answer/value \"180\\\\,\\\\delta A\" :db/id 17592186518932} :answer-field/id #uuid \"9a1f8f25-3418-59b0-ba6b-72dab84b9c04\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518950}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4bedfcff-a678-5213-96c3-9e61ef2500d0\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}2 \\\\left(u + 2 v\\\\right)^{2}\\\\\\\\\\\\left(u - v\\\\right)^{3}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}4 \\\\left(u + 2 v\\\\right)&8 \\\\left(u + 2 v\\\\right)\\\\\\\\3 \\\\left(u - v\\\\right)^{2}&- 3 \\\\left(u - v\\\\right)^{2}\\\\end{vmatrix}\\\\\\\\& =(4 \\\\left(u + 2 v\\\\right))\\\\cdot (- 3 \\\\left(u - v\\\\right)^{2})-(8 \\\\left(u + 2 v\\\\right))\\\\cdot (3 \\\\left(u - v\\\\right)^{2})\\\\\\\\& =- 36 u^{3} + 108 u v^{2} - 72 v^{3}\\\\\\\\& =- 36 \\\\left(u - v\\\\right)^{2} \\\\left(u + 2 v\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(1,2)} & =\\\\left(- 36 \\\\left(u - v\\\\right)^{2} \\\\left(u + 2 v\\\\right)\\\\right)\\\\big|_{u=1,v=2}\\\\\\\\& =- 36 \\\\left((1) - (2)\\\\right)^{2} \\\\left((1) + 2 (2)\\\\right)\\\\\\\\& =-180\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|-180|\\\\cdot\\\\delta A\\\\\\\\ & =180\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"26961c66-edcd-5145-85c4-6c1fc54d0f34\" :answer/type {:db/ident :answer.type/math} :answer/value \"3600\\\\,\\\\delta A\" :db/id 17592186518913} {:answer/id #uuid \"6037566d-f7b6-50da-a88b-dfbdeeb3fcc0\" :answer/type {:db/ident :answer.type/math} :answer/value \"60\\\\,\\\\delta A\" :db/id 17592186518935} {:answer/id #uuid \"76383b00-80af-5d97-ab38-8ebc7d2e3bb8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{60}\\\\,\\\\delta A\" :db/id 17592186518940} {:answer/id #uuid \"812363c8-d6ee-5aea-85f6-8c6219b20949\" :answer/type {:db/ident :answer.type/math} :answer/value \"120\\\\,\\\\delta A\" :db/id 17592186518943} {:answer/id #uuid \"ec0f0246-49a2-593f-b299-8edb618ae39c\" :answer/type {:db/ident :answer.type/math} :answer/value \"30\\\\,\\\\delta A\" :db/id 17592186518969}] :answer-field/correct {:answer/id #uuid \"6037566d-f7b6-50da-a88b-dfbdeeb3fcc0\" :answer/type {:db/ident :answer.type/math} :answer/value \"60\\\\,\\\\delta A\" :db/id 17592186518935} :answer-field/id #uuid \"d336bb06-ff1c-5772-90e6-a62e20ceb52d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518962}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"53cbe52b-bde0-5c41-aca4-4e6c21faa397\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}3 u v^{3}\\\\\\\\u^{2} + 2 v^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}3 v^{3}&9 u v^{2}\\\\\\\\2 u&4 v\\\\end{vmatrix}\\\\\\\\& =(3 v^{3})\\\\cdot (4 v)-(9 u v^{2})\\\\cdot (2 u)\\\\\\\\& =- 18 u^{2} v^{2} + 12 v^{4}\\\\\\\\& =- 6 v^{2} \\\\left(3 u^{2} - 2 v^{2}\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(2,-1)} & =\\\\left(- 6 v^{2} \\\\left(3 u^{2} - 2 v^{2}\\\\right)\\\\right)\\\\big|_{u=2,v=-1}\\\\\\\\& =- 6 (-1)^{2} \\\\left(- 2 (-1)^{2} + 3 (2)^{2}\\\\right)\\\\\\\\& =-60\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|-60|\\\\cdot\\\\delta A\\\\\\\\ & =60\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"18d61485-2e83-5936-bf4f-bdb56bc3c4ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"972\\\\,\\\\delta A\" :db/id 17592186518910} {:answer/id #uuid \"1c320d3a-60da-5b71-a776-74db91358bd2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{486}\\\\,\\\\delta A\" :db/id 17592186518911} {:answer/id #uuid \"45580a5e-5bf5-591a-975f-b5c6caffce26\" :answer/type {:db/ident :answer.type/math} :answer/value \"243\\\\,\\\\delta A\" :db/id 17592186518924} {:answer/id #uuid \"981bec3c-d327-540d-b022-7683af7469d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"486\\\\,\\\\delta A\" :db/id 17592186518949} {:answer/id #uuid \"b5f24ccd-920b-5556-ac5f-da611e02a4e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"236196\\\\,\\\\delta A\" :db/id 17592186518959}] :answer-field/correct {:answer/id #uuid \"981bec3c-d327-540d-b022-7683af7469d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"486\\\\,\\\\delta A\" :db/id 17592186518949} :answer-field/id #uuid \"f515b64d-d940-5cd5-9894-9abe522a7fe6\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518973}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"829d2336-b2c1-5d22-81da-62efc70bcbb3\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}\\\\left(u + 2 v\\\\right)^{3}\\\\\\\\\\\\left(u - v\\\\right)^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}3 \\\\left(u + 2 v\\\\right)^{2}&6 \\\\left(u + 2 v\\\\right)^{2}\\\\\\\\2 \\\\left(u - v\\\\right)&- 2 \\\\left(u - v\\\\right)\\\\end{vmatrix}\\\\\\\\& =(3 \\\\left(u + 2 v\\\\right)^{2})\\\\cdot (- 2 \\\\left(u - v\\\\right))-(6 \\\\left(u + 2 v\\\\right)^{2})\\\\cdot (2 \\\\left(u - v\\\\right))\\\\\\\\& =- 18 u^{3} - 54 u^{2} v + 72 v^{3}\\\\\\\\& =- 18 \\\\left(u - v\\\\right) \\\\left(u + 2 v\\\\right)^{2}\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(-1,2)} & =\\\\left(- 18 \\\\left(u - v\\\\right) \\\\left(u + 2 v\\\\right)^{2}\\\\right)\\\\big|_{u=-1,v=2}\\\\\\\\& =- 18 \\\\left((-1) - (2)\\\\right) \\\\left((-1) + 2 (2)\\\\right)^{2}\\\\\\\\& =486\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|486|\\\\cdot\\\\delta A\\\\\\\\ & =486\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"09aa9167-b044-5501-8f63-4ce19c39ae5b\" :answer/type {:db/ident :answer.type/math} :answer/value \"180\\\\,\\\\delta A\" :db/id 17592186518905} {:answer/id #uuid \"09d9affe-0d42-57ca-8777-3fbb4b43fa8c\" :answer/type {:db/ident :answer.type/math} :answer/value \"360\\\\,\\\\delta A\" :db/id 17592186518906} {:answer/id #uuid \"979d8129-4d6e-5b64-adf3-cad4bb9f306b\" :answer/type {:db/ident :answer.type/math} :answer/value \"32400\\\\,\\\\delta A\" :db/id 17592186518948} {:answer/id #uuid \"c371dc56-8562-5f1d-88cd-cbe72dc4bff0\" :answer/type {:db/ident :answer.type/math} :answer/value \"90\\\\,\\\\delta A\" :db/id 17592186518961} {:answer/id #uuid \"d50691b4-12ca-58c1-819c-2360e3254157\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{180}\\\\,\\\\delta A\" :db/id 17592186518963}] :answer-field/correct {:answer/id #uuid \"09aa9167-b044-5501-8f63-4ce19c39ae5b\" :answer/type {:db/ident :answer.type/math} :answer/value \"180\\\\,\\\\delta A\" :db/id 17592186518905} :answer-field/id #uuid \"7ac21d89-71cb-55af-8bb2-ae949d77431d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518942}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"8a1a276c-9bc8-5768-90c3-2e3e48e45da7\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-2,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}2 \\\\left(u + v\\\\right)^{3}\\\\\\\\\\\\left(2 u - v\\\\right)^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}6 \\\\left(u + v\\\\right)^{2}&6 \\\\left(u + v\\\\right)^{2}\\\\\\\\4 \\\\left(2 u - v\\\\right)&- 2 \\\\left(2 u - v\\\\right)\\\\end{vmatrix}\\\\\\\\& =(6 \\\\left(u + v\\\\right)^{2})\\\\cdot (- 2 \\\\left(2 u - v\\\\right))-(6 \\\\left(u + v\\\\right)^{2})\\\\cdot (4 \\\\left(2 u - v\\\\right))\\\\\\\\& =- 72 u^{3} - 108 u^{2} v + 36 v^{3}\\\\\\\\& =- 36 \\\\left(u + v\\\\right)^{2} \\\\left(2 u - v\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(-2,1)} & =\\\\left(- 36 \\\\left(u + v\\\\right)^{2} \\\\left(2 u - v\\\\right)\\\\right)\\\\big|_{u=-2,v=1}\\\\\\\\& =- 36 \\\\left((-2) + (1)\\\\right)^{2} \\\\left(2 (-2) - (1)\\\\right)\\\\\\\\& =180\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|180|\\\\cdot\\\\delta A\\\\\\\\ & =180\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4e43eb16-fd50-58a8-a646-55a7b162847a\" :answer/type {:db/ident :answer.type/math} :answer/value \"360\\\\,\\\\delta A\" :db/id 17592186518927} {:answer/id #uuid \"5078973b-c6bc-557e-bd48-736bc3b4c202\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{180}\\\\,\\\\delta A\" :db/id 17592186518928} {:answer/id #uuid \"5ea468ed-e1fe-5ba2-9fa5-fefe32cc95ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"32400\\\\,\\\\delta A\" :db/id 17592186518934} {:answer/id #uuid \"69db795c-5742-5b39-9574-c13288983347\" :answer/type {:db/ident :answer.type/math} :answer/value \"180\\\\,\\\\delta A\" :db/id 17592186518938} {:answer/id #uuid \"93bb489d-c9e5-5d96-b8d7-5033a9c1010a\" :answer/type {:db/ident :answer.type/math} :answer/value \"90\\\\,\\\\delta A\" :db/id 17592186518947}] :answer-field/correct {:answer/id #uuid \"69db795c-5742-5b39-9574-c13288983347\" :answer/type {:db/ident :answer.type/math} :answer/value \"180\\\\,\\\\delta A\" :db/id 17592186518938} :answer-field/id #uuid \"f0f839a4-8628-5b5f-ac1d-b0991c234235\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518971}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a969598c-ea80-5e43-ada9-6b7308b83589\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-2,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}2 \\\\left(2 u + v\\\\right)^{2}\\\\\\\\\\\\left(u - v\\\\right)^{3}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}8 \\\\left(2 u + v\\\\right)&4 \\\\left(2 u + v\\\\right)\\\\\\\\3 \\\\left(u - v\\\\right)^{2}&- 3 \\\\left(u - v\\\\right)^{2}\\\\end{vmatrix}\\\\\\\\& =(8 \\\\left(2 u + v\\\\right))\\\\cdot (- 3 \\\\left(u - v\\\\right)^{2})-(4 \\\\left(2 u + v\\\\right))\\\\cdot (3 \\\\left(u - v\\\\right)^{2})\\\\\\\\& =- 72 u^{3} + 108 u^{2} v - 36 v^{3}\\\\\\\\& =- 36 \\\\left(u - v\\\\right)^{2} \\\\left(2 u + v\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(-2,-1)} & =\\\\left(- 36 \\\\left(u - v\\\\right)^{2} \\\\left(2 u + v\\\\right)\\\\right)\\\\big|_{u=-2,v=-1}\\\\\\\\& =- 36 \\\\left(- (-1) + (-2)\\\\right)^{2} \\\\left((-1) + 2 (-2)\\\\right)\\\\\\\\& =180\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|180|\\\\cdot\\\\delta A\\\\\\\\ & =180\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"15dbf132-3e31-59b6-b187-892685acc97d\" :answer/type {:db/ident :answer.type/math} :answer/value \"88\\\\,\\\\delta A\" :db/id 17592186518909} {:answer/id #uuid \"697e6aef-9964-5053-b382-5c88b21c2920\" :answer/type {:db/ident :answer.type/math} :answer/value \"44\\\\,\\\\delta A\" :db/id 17592186518937} {:answer/id #uuid \"83524c04-5468-53fa-bd7d-bb4999cc9585\" :answer/type {:db/ident :answer.type/math} :answer/value \"1936\\\\,\\\\delta A\" :db/id 17592186518945} {:answer/id #uuid \"a6d2a6d9-d644-5d45-8bdf-1c1fb6df4980\" :answer/type {:db/ident :answer.type/math} :answer/value \"22\\\\,\\\\delta A\" :db/id 17592186518953} {:answer/id #uuid \"f639046b-b2fc-5455-96d0-1286ffd8950a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{44}\\\\,\\\\delta A\" :db/id 17592186518974}] :answer-field/correct {:answer/id #uuid \"697e6aef-9964-5053-b382-5c88b21c2920\" :answer/type {:db/ident :answer.type/math} :answer/value \"44\\\\,\\\\delta A\" :db/id 17592186518937} :answer-field/id #uuid \"535e0d1f-0eed-5a50-9f3c-40a846b5562f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518929}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"adc92b5f-6402-53d1-8666-3baacdfe2c66\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-2,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}2 u v^{3}\\\\\\\\u^{2} + v^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}2 v^{3}&6 u v^{2}\\\\\\\\2 u&2 v\\\\end{vmatrix}\\\\\\\\& =(2 v^{3})\\\\cdot (2 v)-(6 u v^{2})\\\\cdot (2 u)\\\\\\\\& =- 12 u^{2} v^{2} + 4 v^{4}\\\\\\\\& =- 4 v^{2} \\\\left(3 u^{2} - v^{2}\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(-2,-1)} & =\\\\left(- 4 v^{2} \\\\left(3 u^{2} - v^{2}\\\\right)\\\\right)\\\\big|_{u=-2,v=-1}\\\\\\\\& =- 4 (-1)^{2} \\\\left(- (-1)^{2} + 3 (-2)^{2}\\\\right)\\\\\\\\& =-44\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|-44|\\\\cdot\\\\delta A\\\\\\\\ & =44\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"22ec1407-5d3e-572e-b894-a96fde5d8e98\" :answer/type {:db/ident :answer.type/math} :answer/value \"75\\\\,\\\\delta A\" :db/id 17592186518912} {:answer/id #uuid \"33d42482-34ef-59e1-9d7b-c0a1dcf6db23\" :answer/type {:db/ident :answer.type/math} :answer/value \"300\\\\,\\\\delta A\" :db/id 17592186518916} {:answer/id #uuid \"39480101-3dbb-5f98-9d35-a02e91aadd76\" :answer/type {:db/ident :answer.type/math} :answer/value \"150\\\\,\\\\delta A\" :db/id 17592186518917} {:answer/id #uuid \"3e0670ce-c1db-5e79-a6f4-2e53c985344b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{150}\\\\,\\\\delta A\" :db/id 17592186518919} {:answer/id #uuid \"3ffa3aa9-000d-52d4-8910-4d539df8e087\" :answer/type {:db/ident :answer.type/math} :answer/value \"22500\\\\,\\\\delta A\" :db/id 17592186518921}] :answer-field/correct {:answer/id #uuid \"39480101-3dbb-5f98-9d35-a02e91aadd76\" :answer/type {:db/ident :answer.type/math} :answer/value \"150\\\\,\\\\delta A\" :db/id 17592186518917} :answer-field/id #uuid \"ae334581-cc02-5854-80ac-65ba5fd211c3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518956}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"b11a00bf-ad16-5270-bbbf-f403e6fe76c2\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(3,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}3 u v^{3}\\\\\\\\u^{2} + 2 v^{2}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}3 v^{3}&9 u v^{2}\\\\\\\\2 u&4 v\\\\end{vmatrix}\\\\\\\\& =(3 v^{3})\\\\cdot (4 v)-(9 u v^{2})\\\\cdot (2 u)\\\\\\\\& =- 18 u^{2} v^{2} + 12 v^{4}\\\\\\\\& =- 6 v^{2} \\\\left(3 u^{2} - 2 v^{2}\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(3,1)} & =\\\\left(- 6 v^{2} \\\\left(3 u^{2} - 2 v^{2}\\\\right)\\\\right)\\\\big|_{u=3,v=1}\\\\\\\\& =- 6 (1)^{2} \\\\left(- 2 (1)^{2} + 3 (3)^{2}\\\\right)\\\\\\\\& =-150\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|-150|\\\\cdot\\\\delta A\\\\\\\\ & =150\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"} {:db/id 17592186518966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3a46dd2e-7844-511c-8225-1d0a51bb3eaf\" :answer/type {:db/ident :answer.type/math} :answer/value \"72\\\\,\\\\delta A\" :db/id 17592186518918} {:answer/id #uuid \"421250cd-a2d2-59cf-a6de-47aaded334b2\" :answer/type {:db/ident :answer.type/math} :answer/value \"20736\\\\,\\\\delta A\" :db/id 17592186518922} {:answer/id #uuid \"549b51aa-02b7-56c9-a3ea-cc9c797d0dfd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{144}\\\\,\\\\delta A\" :db/id 17592186518931} {:answer/id #uuid \"5c59fc35-b29f-5893-8340-a07c39c6bbb5\" :answer/type {:db/ident :answer.type/math} :answer/value \"144\\\\,\\\\delta A\" :db/id 17592186518933} {:answer/id #uuid \"ec16d3f2-9da5-5e85-813f-086fbb3e74c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"288\\\\,\\\\delta A\" :db/id 17592186518970}] :answer-field/correct {:answer/id #uuid \"5c59fc35-b29f-5893-8340-a07c39c6bbb5\" :answer/type {:db/ident :answer.type/math} :answer/value \"144\\\\,\\\\delta A\" :db/id 17592186518933} :answer-field/id #uuid \"e48954b8-5146-577a-919f-6d9a5e7fbd72\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186518967}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"dcaa4bdd-7f4f-5106-9de8-2ca23f1745cd\" :question/problem \"Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\\n\\n$$\\nT:\\\\begin{bmatrix}u \\\\\\\\ v\\\\end{bmatrix}\\\\longrightarrow\\\\begin{bmatrix}2 \\\\left(2 u + v\\\\right)^{2}\\\\\\\\\\\\left(u - v\\\\right)^{3}\\\\end{bmatrix}?\\n$$\" :question/worked-solution \"Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\\n\\n$$\\n\\\\text{Area}(T(Δ))\\\\approx\\\\left|\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|\\\\cdot\\\\underbrace{\\\\text{Area}(Δ)}_{\\\\delta A}\\n$$\\n\\nComputing the corresponding Jacobian determinant, we obtain the following:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)} & =\\\\begin{vmatrix}\\\\frac{\\\\partial x}{\\\\partial u}&\\\\frac{\\\\partial x}{\\\\partial v}\\\\\\\\\\\\frac{\\\\partial y}{\\\\partial u}&\\\\frac{\\\\partial y}{\\\\partial v}\\\\end{vmatrix}\\\\\\\\& =\\\\begin{vmatrix}8 \\\\left(2 u + v\\\\right)&4 \\\\left(2 u + v\\\\right)\\\\\\\\3 \\\\left(u - v\\\\right)^{2}&- 3 \\\\left(u - v\\\\right)^{2}\\\\end{vmatrix}\\\\\\\\& =(8 \\\\left(2 u + v\\\\right))\\\\cdot (- 3 \\\\left(u - v\\\\right)^{2})-(4 \\\\left(2 u + v\\\\right))\\\\cdot (3 \\\\left(u - v\\\\right)^{2})\\\\\\\\& =- 72 u^{3} + 108 u^{2} v - 36 v^{3}\\\\\\\\& =- 36 \\\\left(u - v\\\\right)^{2} \\\\left(2 u + v\\\\right)\\\\\\\\\\\\left.\\\\frac{\\\\partial(x,y)}{\\\\partial(u,v)}\\\\right|_{(1,-1)} & =\\\\left(- 36 \\\\left(u - v\\\\right)^{2} \\\\left(2 u + v\\\\right)\\\\right)\\\\big|_{u=1,v=-1}\\\\\\\\& =- 36 \\\\left(- (-1) + (1)\\\\right)^{2} \\\\left((-1) + 2 (1)\\\\right)\\\\\\\\& =-144\\\\end{aligned}\\n$$\\n\\nTherefore, we have\\n\\n$$\\n\\\\begin{aligned}\\\\text{Area}(T(Δ)) & \\\\approx|-144|\\\\cdot\\\\delta A\\\\\\\\ & =144\\\\,\\\\delta A.\\\\end{aligned}\\n$$\"}] :knowledge-point/title \"Identifying the Local Area Scale Factor of a Transformation\"}",
  "records": []
}
