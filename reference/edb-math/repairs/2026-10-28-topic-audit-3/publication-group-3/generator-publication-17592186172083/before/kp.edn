}\\right)\\,j=-\\frac{1}{2}\\,i-2\\,j \\\\ F(-1,\\frac{5}{4}) & =\\left((2)(-1)\\left(\\frac{5}{4}\\right)\\right)\\,i+\\left((-2)(-1)^{2}\\right)\\,j=-\\frac{5}{2}\\,i-2\\,j \\\\ F(1,\\frac{1}{4}) & =\\left((2)(1)\\left(\\frac{1}{4}\\right)\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=\\frac{1}{2}\\,i-2\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/a6/a69a9afddf3271e21e7b0a4136a84d4420238af354869085c58d931ac2e045fe.png)"} {:db/id #edb/ref 17592186518817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d9748db-ff33-5738-9275-47347081811f" :answer/type {:db/ident :answer.type/image} :answer/value "images/a5/a5ee72ae329a50484d2d6c41983fbcf131500e9f52619d1c6644a63a10e9b92f.png" :db/id #edb/ref 17592186518767} {:answer/id #uuid "13ef16eb-1657-5324-8294-4449e71c4000" :answer/type {:db/ident :answer.type/image} :answer/value "images/95/9560b790b63b75ce1a0e79e0beb58e0f51693723fdc8ac0642440fd4ad973937.png" :db/id #edb/ref 17592186518770} {:answer/id #uuid "37e994b8-8c59-5ccf-a6e4-81eeb22d9cfe" :answer/type {:db/ident :answer.type/image} :answer/value "images/4e/4e79f6a378556f500223baaa090df75b002cfd83196bd23b748278ef542b0fae.png" :db/id #edb/ref 17592186518779} {:answer/id #uuid "890ee44e-76ba-5143-a748-348d04ac2127" :answer/type {:db/ident :answer.type/image} :answer/value "images/2b/2b09ff0226023ff4dc3dc2f8f50f3e0a7882111a64fd4170dafba4f43082d380.png" :db/id #edb/ref 17592186518798} {:answer/id #uuid "922e2ffe-74c1-5bcd-bceb-cbe86b8efa17" :answer/type {:db/ident :answer.type/image} :answer/value "images/76/76268ad669c8974c2e342d00c31d0545caa1f8d86001b4e30c4142ff7ac6df23.png" :db/id #edb/ref 17592186518806}] :answer-field/correct {:answer/id #uuid "890ee44e-76ba-5143-a748-348d04ac2127" :answer/type {:db/ident :answer.type/image} :answer/value "images/2b/2b09ff0226023ff4dc3dc2f8f50f3e0a788