ight)} \\\\ - 4 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & - 4 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & - 4 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ 3 \\cos{\\left(v \\right)} & - 3 u \\sin{\\left(v \\right)} & 0\\end{vmatrix} \\\\  & =\\left(3 \\cos{\\left(v \\right)}\\right)(-1)^{3+1}\\begin{vmatrix}- 2 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & 2 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ - 4 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & - 4 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix}+\\left(- 3 u \\sin{\\left(v \\right)}\\right)(-1)^{3+2}\\begin{vmatrix}- 2 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & 2 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ - 4 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & - 4 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix} \\\\  & =\\left(24 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right)+\\left(24 u^{2} \\sin^{3}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right) \\\\  & =\\left(24 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)+\\left(24 u^{2} \\sin^{3}{\\left(v \\right)}\\right) \\\\  & =24 u^{2} \\sin{\\left(v \\right)}\\left(\\cos^2 v+\\sin^2 v\\right) \\\\  & =24 u^{2} \\sin{\\left(v \\right)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186538081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8639633e-7629-5d2f-945f-aa8ce0e5f0c8" :answer/type {:db/ident :answer.type/math} :answer/value "9 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538085} {:answer/id #uuid "a3b1ab11-7d9e-52c2-aac3-7a93e1a2576b" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 u^{2} \\sin^{3}{\\left(v \\right)}" :db/id #edb/ref 17592186538090} {:answer/id #uuid "a4caba16-1039-5e14-be47-fdf13dfcd67d" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/r