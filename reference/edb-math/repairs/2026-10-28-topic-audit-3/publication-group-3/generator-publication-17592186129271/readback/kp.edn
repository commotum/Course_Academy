eft(w \\right)} \\\\ \\frac{∂y}{∂u} & =3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & \\frac{∂y}{∂v} & =3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & \\frac{∂y}{∂w} & =3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ \\frac{∂z}{∂u} & =4 \\cos{\\left(v \\right)} & \\frac{∂z}{∂v} & =- 4 u \\sin{\\left(v \\right)} & \\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}3 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & 3 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & - 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & 3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ 4 \\cos{\\left(v \\right)} & - 4 u \\sin{\\left(v \\right)} & 0\\end{vmatrix} \\\\  & =\\left(4 \\cos{\\left(v \\right)}\\right)(-1)^{3+1}\\begin{vmatrix}3 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & - 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix}+\\left(- 4 u \\sin{\\left(v \\right)}\\right)(-1)^{3+2}\\begin{vmatrix}3 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & - 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix} \\\\  & =\\left(36 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right)+\\left(36 u^{2} \\sin^{3}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right) \\\\  & =\\left(36 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)+\\left(36 u^{2} \\sin^{3}{\\left(v \\right)}\\right) \\\\  & =36 u^{2} \\sin{\\left(v \\right)}\\left(\\cos^2 v+\\sin^2 v\\right) \\\\  & =36 u^{2} \\sin{\\left(v \\right)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186639182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ba08da-9f5a-52d8-9bd9-567d6804bb6a" :answer/type {:db/ident :answer.type/math} :answer/value "2-{e}^{u}" :db/id #edb/ref 17592186638718} {:answer/id #uuid "59f12bcd-4bf5-5853-b09a-118edf45b7f2" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{4u}+{e}^{3u}" :db/id #edb/ref 17592186638785} {:answer/id #uuid "6531df97-a0f5-53cd-a7f1-b6ea5924c70e" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2u}" :db/id #edb/ref 17592186638801} {:answer/id #uuid "75783e54-1171-5d5c-8402-cb1482ba7623" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2u}-{e}^{3u}" :db/id #edb/ref 17592186638831} {:answer/id #uuid "be89115a-ad65-5b7a-bdc4-2ebd69a522c2" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{3u}" :db/id #edb/ref 17592186638964}] :answer-field/correct {:answer/id #uuid "75783e54-1171-5d5c-8402-cb1482ba7623" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2u}-{e}^{3u}" :db/id #edb/ref 17592186638831} :answer-field/id #uuid "42adc3cd-b96d-5012-8e9d-3fc32c49bc59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639099}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2f68c183-5310-55e6-bbe3-419bef3f8dfa" :question/math-academy-id "q-161791" :question/problem "Find the Jacobian determinant of the transformation $\\mathbf{T}$ that maps the $uvw$-space into the $xyz$-space by means of the equations\n\n$$\nx=v{e}^{2u},\\,y={e}^{u}+w,\\,z=2u+w.\n$$" :question/worked-solution "For a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2v{e}^{2u} & \\,\\frac{∂x}{∂v} & ={e}^{2u} & \\,\\frac{∂x}{∂w} & =0 \\\\ \\frac{∂y}{∂u} & ={e}^{u} & \\,\\frac{∂y}{∂v} & =0 & \\,\\frac{∂y}{∂w} & =1 \\\\ \\frac{∂z}{∂u} & =2 & \\,\\frac{∂z}{∂v} & =0 & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}2v{e}^{2u} & {e}^{2u} & 0 \\\\ {e}^{u} & 0 & 1 \\\\ 2 & 0 & 1\\end{vmatrix} \\\\  & =1(-1)^{2+3}\\begin{vmatrix}2v{e}^{2u} & {e}^{2u} \\\\ 2 & 0\\end{vmatrix}+1(-1)^{3+3}\\begin{vmatrix}2v{e}^{2u} & {e}^{2u} \\\\ {e}^{u} & 0\\end{vmatrix} \\\\  & =-(0-2{e}^{2u})+(0-{e}^{u+2u}) \\\\  & =2{e}^{2u}-{e}^{3u}.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Jacobian of a Three-Dimensional Transformation"}]}
