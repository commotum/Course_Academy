ac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b0e90e7-4add-5e33-8547-4c25dae10c4b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537013} {:answer/id #uuid "51c76675-9e2c-59b9-8577-4dc096a8cdfb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\cos{\\left(\\theta \\right)} + 5}^{-6}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537016} {:answer/id #uuid "5d3b8ee2-e524-5b41-8574-e188f91ae2b5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r^{2}}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537020} {:answer/id #uuid "a36208fb-a2e1-572d-a6a9-8b8ccf4ee98c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537045} {:answer/id #uuid "d3040689-2239-57e5-8500-1ac134938960" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{1}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537062}] :answer-field/correct {:answer/id #uuid "a36208fb-a2e1-572d-a6a9-8b8ccf4ee98c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537045} :answer-field/id #uuid "3c179be8-68d6-5589-9fd5-03692660f907" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537009}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a4df6a09-850b-5ef6-8bf5-1f79b92be5fa" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x+4)^{2}+{y}^{2}\\le 16,\\,-6\\le z\\le x + 5\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/8b/8b16f7e69a4ce84b0b7c4597defd9e9f55593e50623f344f001d24518d59c483.png)\n\nThe region $R$ is a right vertical cylinder of radius $4$ whose axis passes through the point $(-4,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-6,$ and\n\n- bounded above by $z=x + 5=r \\cos{\\left(\\theta \\right)} + 5.$\n\nWith that in mind, let's write the equation $(x+4)^{2}+{y}^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}(x+4)^{2}+{y}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta+4)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta +8r\\operatorname{cos}⁡\\theta+16+{r}^{2}{sin}^{2}⁡\\theta & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+8r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}+8r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r+8\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=- 8 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le - 8 \\cos{\\left(\\theta \\right)},\\,\\frac{\\pi}{2}\\le \\theta \\le \\frac{3 \\pi}{2},\\,-6\\le z\\le r \\cos{\\left(\\theta \\right)} + 5\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2}+2}}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+2}}\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098d3517-e148-57fb-b802-0b2dbc349278" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\sin{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536985} {:answer/id #uuid "24acc4ff-e0b0-5c78-95ce-b81732e7ce1a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536997} {:answer/id #uuid "3554a9cb-6c59-5f65-87eb-c96e1206a180" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}\\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537005} {:answer/id #uuid "42573f2c-f0d7-5b0a-a697-3d745e18a680" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537012} {:answer/id #uuid "b2ef5227-2542-5600-9c83-8758d74eee3e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\sin{\\left(\\theta \\right)}}\\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537050}] :answer-field/correct {:answer/id #uuid "24acc4ff-e0b0-5c78-95ce-b81732e7ce1a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536997} :answer-field/id #uuid "8f1ed8e4-2fa2-59d9-98df-3af8a6aba784" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537037}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ab4dd324-45c0-5df5-a923-9696a0511377" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y-4)^{2}\\le 16,x\\ge 0,\\,-2\\le z\\le x\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\sqrt{x^{2} + y^{2} + 1}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/26/262fdb09ab8f6ee5de1a31cec2d238cb633ae2d5dfa2e99d80ed58d4cb849ec5.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(0,4)$ in the $xy$-plane, and is\n\n- bounded below by $z=-2,$ and\n\n- bounded above by $z=x=r \\cos{\\left(\\theta \\right)}.$\n\nWith that in mind, let's now write the ${x}^{2}+(y-4)^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-4)^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta-4)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -8r\\operatorname{sin}⁡\\theta+16 & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{sin}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{sin}⁡\\theta & =0 \\\\ r(r-8\\operatorname{sin}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\sin{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\sin{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,-2\\le z\\le r \\cos{\\left(\\theta \\right)}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{x^{2} + y^{2} + 1}\\,\\text{d}V & ={∭}_{Δ}\\sqrt{(r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2}+1}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a83957d-072f-56dd-967f-e6e3cad6b479" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536986} {:answer/id #uuid "2156c48d-60f6-5a75-b7bd-532244308380" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{4}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536995} {:answer/id #uuid "55850eab-9b9d-5708-b164-b99babf0d7c1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537017} {:answer/id #uuid "8d424d92-a14d-56fd-9646-621bf9980044" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{2}^{1}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537036} {:answer/id #uuid "d8b1f40f-3ec1-5b86-a168-1bf950f81dbc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537065}] :answer-field/correct {:answer/id #uuid "55850eab-9b9d-5708-b164-b99babf0d7c1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537017} :answer-field/id #uuid "3c67f654-3428-5c4c-b065-5f85356ec766" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537010}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b5e1ca18-2705-5bdb-9505-7d24e5965b22" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-4)^{2}+{y}^{2}\\le 16,y\\ge 0,\\,1\\le z\\le 2\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}x^{2} + y^{2}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/80/80a919b28ae7ed559b06b34bd8512859794a7d6550970b56347e2deb653bf76d.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(4,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=1,$ and\n\n- bounded above by $z=2.$\n\nWith that in mind, let's now write the $(x-4)^{2}+{y}^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-4)^{2}+{y}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta-4)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta -8r\\operatorname{cos}⁡\\theta+16+{r}^{2}{sin}^{2}⁡\\theta & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-8\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\cos{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,1\\le z\\le 2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}x^{2} + y^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f5725f-873a-5cb2-9d93-8dd091bb64fc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{r \\sin{\\left(\\theta \\right)}}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536989} {:answer/id #uuid "341da02c-a537-571e-98d0-36040cb4c3d3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537002} {:answer/id #uuid "55f37382-115f-5176-b367-f0f7693481cc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{1}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537018} {:answer/id #uuid "95c46129-e371-5472-a8c0-39ca8937604f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537038} {:answer/id #uuid "dede804f-1f13-5287-811a-67eb0c9566f2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r^{2}}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537067}] :answer-field/correct {:answer/id #uuid "341da02c-a537-571e-98d0-36040cb4c3d3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537002} :answer-field/id #uuid "f3833d31-d0a7-5f2a-ba09-40678b399d56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537074}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c80df8b3-485c-5c4b-a01f-65b076ecb41f" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-4)^{2}+{y}^{2}\\le 16,y\\le 0,\\,y\\le z\\le 4\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{z + 5}}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/51/510a5ecd48459be9372c1a797d00cc78a167b7ebc0563063e4f1a1e187e32bd0.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(4,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=y=r \\sin{\\left(\\theta \\right)},$ and\n\n- bounded above by $z=4.$\n\nWith that in mind, let's now write the $(x-4)^{2}+{y}^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-4)^{2}+{y}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta-4)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta -8r\\operatorname{cos}⁡\\theta+16+{r}^{2}{sin}^{2}⁡\\theta & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-8\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\cos{\\left(\\theta \\right)},\\,\\frac{3 \\pi}{2}\\le \\theta \\le 2 \\pi,\\,r \\sin{\\left(\\theta \\right)}\\le z\\le 4\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{z + 5}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{z + 5}}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6797e6ea-0e50-5bcf-8670-1502efade88b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{2 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537023} {:answer/id #uuid "6a1f36d1-2f5f-5b5d-b048-0f5b93961b12" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{6}^{4}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537026} {:answer/id #uuid "80b41028-1697-5a18-89f0-2ed59ee0559f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537034} {:answer/id #uuid "c719c5f0-f401-5da6-91a4-572901eb262b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537057} {:answer/id #uuid "fb13a566-d121-503a-8bc9-4bd42bb083df" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{4}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537077}] :answer-field/correct {:answer/id #uuid "c719c5f0-f401-5da6-91a4-572901eb262b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537057} :answer-field/id #uuid "5d4af9d5-325d-5634-94af-ef6d75847f12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537021}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d488f663-9171-597d-b16b-2f0b7032086a" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-2)^{2}+{y}^{2}\\le 4,y\\ge 0,\\,4\\le z\\le 6\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}x^{2} + y^{2}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/d2/d2b3344b7b910f5685d4fd81b75a600608af6b008778ff608cb084edb5a92da9.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(2,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=4,$ and\n\n- bounded above by $z=6.$\n\nWith that in mind, let's now write the $(x-2)^{2}+{y}^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta-2)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta -4r\\operatorname{cos}⁡\\theta+4+{r}^{2}{sin}^{2}⁡\\theta & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-4r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-4r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-4\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=4 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 4 \\cos{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,4\\le z\\le 6\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}x^{2} + y^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "682a228b-b79d-5fcb-b15e-e67fdbaa8be7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{10}\\frac{1}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537024} {:answer/id #uuid "6af500dd-3fdb-56d1-8617-670cec01eb55" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{10}\\frac{r^{2}}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537028} {:answer/id #uuid "7301b34c-817c-56a3-8683-9aaaf6122853" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{10}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537032} {:answer/id #uuid "e0cad40a-69b5-528c-86d1-d835cef665eb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{2 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{10}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537069} {:answer/id #uuid "e796db0a-5eac-585e-902e-dc1ce488d7e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{10}^{r \\sin{\\left(\\theta \\right)}}\\frac