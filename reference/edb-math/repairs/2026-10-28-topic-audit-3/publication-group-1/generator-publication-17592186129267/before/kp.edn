#{[{:db/id #edb/ref 17592186129267 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128844 :question/id #uuid "c6495ab5-3756-50e6-8977-7ec19fba4466" :question/math-academy-id "e-11470" :question/problem "The region $R$ is enclosed inside the cylinder $x^2 + y^2 = 4$ for $y \\geq 0$ between the surfaces $z =0$ and $z = 10 - x.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n\\displaystyle \\iiint\\limits_R y \\:\\textrm{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\, \\mathrm{d}V = \n\\iiint\\limits_{\\Delta} \\, f(r \\cos\\theta, r\\sin\\theta, z) \\:  r \\: \\mathrm{d}z \\, \\mathrm{d}r \\, \\mathrm{d}\\theta.\n$$\n\nIf $(r, \\theta, z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx = r\\cos\\theta, \\qquad\ny = r\\sin\\theta, \\qquad \nz = z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/9a/9ad0d507a5440cfce9595e9054457fd733ae412d9a57b0a85238b4773ff0a0c7.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=10-x = 10 - r\\cos\\theta.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\Delta = \\left\\{ (r,\\theta,z) \\, : \\, 0 \\leq r \\leq 2, \\: 0 \\leq \\theta \\leq \\pi, \\: 0 \\leq z \\leq 10-r\\cos\\theta \\right\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}y\\,\\text{d}V & ={∭}_{Δ}(r\\operatorname{sin}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2}{\\int }_{0}^{10-r\\operatorname{cos}⁡\\theta }{r}^{2}\\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} :knowledge-point/id #uuid "f3688ce9-ceff-524b-ac44-0224526c861b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049084 :topic/difficulty 0.7620038433200931 :topic/id #uuid "d952f888-5e27-5f27-a3ff-b83b56acd32a" :topic/knowledge-points [{:db/id #edb/ref 17592186129198} {:db/id #edb/ref 17592186129199} {:db/id #edb/ref 17592186129200} {:db/id #edb/ref 17592186129275}] :topic/math-academy-id 2030 :topic/next [{:db/id #edb/ref 17592186049267} {:db/id #edb/ref 17592186049883} {:db/id #edb/ref 17592186049957} {:db/id #edb/ref 17592186050332} {:db/id #edb/ref 17592186050343} {:db/id #edb/ref 17592186050816} {:db/id #edb/ref 17592186051016}] :topic/title "Double Integrals in Plane Polar Coordinates"} {:db/id #edb/ref 17592186049694 :topic/id #uuid "0b8d7edb-a5e9-5a06-89a9-f9eeb1759812" :topic/knowledge-points [{:db/id #edb/ref 17592186129181} {:db/id #edb/ref 17592186129182} {:db/id #edb/ref 17592186129183}] :topic/math-academy-id 1981 :topic/next [{:db/id #edb/ref 17592186048259} {:db/id #edb/ref 17592186048635} {:db/id #edb/ref 17592186050698}] :topic/title "Cylindrical Polar Coordinates"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186556351 :question-generator/id #uuid "23ae31de-fa40-5998-8121-8091b0db9897" :question-generator/script "generate/scratch/17592186129267.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186129516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19edc691-38d0-5ad2-be38-1638ded6e729" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{6+r\\operatorname{sin}⁡\\theta }{r}^{2}z\\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555048} {:answer/id #uuid "6e67f273-e80f-584c-a56c-d08f5c55b249" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{6+r\\operatorname{sin}⁡\\theta }rz\\operatorname{cos}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555253} {:answer/id #uuid "bd707b9b-7e24-5f86-9393-637c67c6bcee" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{6+r\\operatorname{cos}⁡\\theta }rz\\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555451} {:answer/id #uuid "cd1bd12e-1cd5-5a17-a462-56e0ee79d849" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{6+r\\operatorname{cos}⁡\\theta }{r}^{2}z\\operatorname{cos}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555491} {:answer/id #uuid "e3a983f6-7f59-5aad-b3c8-497270d02f2c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{6+r\\operatorname{sin}⁡\\theta }{r}^{2}z\\operatorname{cos}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555557}] :answer-field/correct {:answer/id #uuid "e3a983f6-7f59-5aad-b3c8-497270d02f2c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{6+r\\operatorname{sin}⁡\\theta }{r}^{2}z\\operatorname{cos}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555557} :answer-field/id #uuid "5659b1e7-edd6-5858-a187-e1aacd269a66" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126596}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1a6db462-1cdd-5328-ac3f-82ce0a5c5a14" :question/math-academy-id "q-161520" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=25$  for $x\\ge 0$ between the surfaces $z=0$ and $z=6+y.$\nExpress the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}xz\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/b1/b194b4882dcada56a10ec69f9dae80b363ea05efaae27385ceacc9a15ba3b56f.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $5$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=6+y=6+r\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 5,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le z\\le 6+r\\operatorname{sin}⁡\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}xz\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}(r\\operatorname{cos}\\theta )z\\hspace{0.222em}r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}-\\pi /2}}}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}6+r\\operatorname{sin}\\theta }}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}z\\operatorname{cos}\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186129739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7534b4b-0be3-57d1-9602-f5788953a87e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{1}^{10}{r}^{2}z\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186368536} {:answer/id #uuid "83bc9502-bd0e-55c2-88f7-c99dfeb46a4e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{1}^{10-r\\operatorname{cos}⁡\\theta }rz\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186368537} {:answer/id #uuid "7fa867b2-61b8-564d-bf6d-b7e1d2f94971" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{1}^{10-r\\operatorname{cos}⁡\\theta }{r}^{2}z\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186368538} {:answer/id #uuid "35e7552c-f179-58ed-93c4-67028d32cb70" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{9}{\\int }_{1}^{10-r\\operatorname{sin}⁡\\theta }{r}^{2}z\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186368539} {:answer/id #uuid "eb28f31a-ad06-547b-a0a7-98b1ef8b5e42" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{9}{\\int }_{1}^{10}{r}^{2}z\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186368540}] :answer-field/correct {:answer/id #uuid "7fa867b2-61b8-564d-bf6d-b7e1d2f94971" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{1}^{10-r\\operatorname{cos}⁡\\theta }{r}^{2}z\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186368538} :answer-field/id #uuid "b1676e97-4bf4-5377-a977-58856345b080" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368535}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5d9d79e2-4f89-52ac-a84b-fb5b127d47eb" :question/math-academy-id "q-39481" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=9$ between the surfaces $z=1$ and $z=10-x.$\nExpress the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}z\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/9c/9c4ea0ba92e19a201e3944defa6deb0bc1ee76971adaa809521722b6ac31241f.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=1,$ and\n\n- bounded above by $z=10-x=10-r\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le 3,\\hspace{0.222em}0\\le \\theta <2\\pi ,\\hspace{0.222em}1\\le z\\le 10-r\\operatorname{cos}\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}z\\sqrt{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}z\\sqrt{(r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2}}\\hspace{0.222em}r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}z\\sqrt{{r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )}\\hspace{0.222em}r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3}}}{\\int }_{1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}10-r\\operatorname{cos}\\theta }}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}z}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186367659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccd9d0aa-3e58-51b4-aa65-f2fab94c1045" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}2}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}r{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367661} {:answer/id #uuid "ed3616c8-9a5d-54a6-8d6b-c0ccc09a58e8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}2}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367662} {:answer/id #uuid "1fc39972-cdfa-5f06-8bdd-ea431268d777" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}r{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367663} {:answer/id #uuid "4fa4178f-c535-5a4a-8c93-a33931081fc5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367664} {:answer/id #uuid "937fccb4-3f00-5741-b712-a541b3052af9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367665}] :answer-field/correct {:answer/id #uuid "937fccb4-3f00-5741-b712-a541b3052af9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367665} :answer-field/id #uuid "ef2ef7d1-0525-5600-9694-dd8bdf3b7386" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367660}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ea39193a-bd12-54e0-b687-ee3f9d3c2eec" :question/math-academy-id "q-161605" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=1$ between the surfaces $z=0$ and $z=1.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}{z}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f4/f4c6f3acefa5d89fd5064de469952da3d68d379559bb4a6a4990a2ea24e4f861.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=1.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le 1,\\hspace{0.222em}0\\le \\theta <2\\pi ,\\hspace{0.222em}0\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}{z}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}{z}^{2}\\sqrt{(r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2}}\\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}r{z}^{2}\\sqrt{{r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}1}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186367666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6865fde3-5faa-5c6c-9848-626d31d1faf6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{2}}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{4-r}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{r}{\\sqrt{1+z}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367668} {:answer/id #uuid "e3f89762-3cbb-55f2-ae7d-80400ebd3d18" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}2}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{4-r}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{1}{\\sqrt{1+z}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367669} {:answer/id #uuid "ddf3d1ed-b7ce-54e2-b809-9211a789e705" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{2}}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{16-{r}^{2}}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{r}{\\sqrt{1+z}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367670} {:answer/id #uuid "ed644672-0769-5dd7-ae28-d54203b97a8f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{2}}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{16-{r}^{2}}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{1}{\\sqrt{1+z}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367671} {:answer/id #uuid "17de9ee2-1a3d-54e2-adb3-9772d2ea22b2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}2}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{16-{r}^{2}}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{r}{\\sqrt{1+z}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367672}] :answer-field/correct {:answer/id #uuid "ddf3d1ed-b7ce-54e2-b809-9211a789e705" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{2}}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{16-{r}^{2}}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{r}{\\sqrt{1+z}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367670} :answer-field/id #uuid "87e263cd-6a7c-550d-852b-30e38d3c9ad2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367667}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0602a248-c988-5793-8ea6-c87cceac7390" :question/math-academy-id "q-161607" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=2$ between the surfaces $z=0$ and $z=\\sqrt{16-({x}^{2}+{y}^{2})}.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{1+z}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/36/36839d1fbde65e86df7335d40374fe72a5ff43ed92b89405327406a62dc8763c.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{2}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{16-({x}^{2}+{y}^{2})}=\\sqrt{16-{r}^{2}}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le \\sqrt{2},\\,0\\le \\theta <2\\pi ,\\,0\\le z\\le \\sqrt{16-{r}^{2}}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{z}}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}\\frac{1}{\\sqrt{1+z}}\\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{2}}}}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{16-{r}^{2}}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{r}{\\sqrt{1+z}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186367673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac64e85f-c75e-5695-8748-bba429dfbf1d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}{\\int }_{0}^{3}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{sin}\\theta }}}^{{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367675} {:answer/id #uuid "6ee3a9f1-edc8-5a06-9c64-03a304c45a58" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\pi /2}}}{\\int }_{0}^{3}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{cos}\\theta }}}^{{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367676} {:answer/id #uuid "01eebf3e-1158-5e20-80e4-ac97089def3b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}{\\int }_{0}^{3}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{cos}\\theta }}}^{{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367677} {:answer/id #uuid "e4afce7b-06df-5b92-8141-ceddfc731240" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\pi /2}}}{\\int }_{0}^{3}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{cos}\\theta }}}^{{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367678} {:answer/id #uuid "21cd2e06-5c99-57e5-a1a5-95c6355405e0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\pi /2}}}{\\int }_{0}^{3}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{sin}\\theta }}}^{{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367679}] :answer-field/correct {:answer/id #uuid "e4afce7b-06df-5b92-8141-ceddfc731240" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\pi /2}}}{\\int }_{0}^{3}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{cos}\\theta }}}^{{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367678} :answer-field/id #uuid "b021fe61-7dff-56cd-841b-a803cdfcc585" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367674}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b5fb33f0-d9af-50dd-ae91-99a85b0b4ad0" :question/math-academy-id "q-161611" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=9$ for $x\\le 0,$ between the surfaces $z=x$ and $z={y}^{2}.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}{x}^{2}-{y}^{2}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/16/16b7c2f69bb20df2faafabf10368776cb69b608bb61eb8432495ae5f146e7100.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $3$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=x=r\\operatorname{cos}⁡\\theta ,$ and\n\n- bounded above by $z={y}^{2}={r}^{2}{\\operatorname{sin}}^{2}\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le 3,\\hspace{0.222em}\\frac{\\pi }{2}\\le \\theta <\\frac{3\\pi }{2},\\hspace{0.222em}r\\operatorname{cos}\\theta \\le z\\le {r}^{2}{\\operatorname{sin}}^{2}\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}-{y}^{2}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}((r\\operatorname{cos}\\theta )^{2}-(r\\operatorname{sin}\\theta )^{2})\\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}r({r}^{2}{\\operatorname{cos}}^{2}\\theta -{r}^{2}{\\operatorname{sin}}^{2}\\theta )\\hspace{0.167em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}{r}^{3}({\\operatorname{cos}}^{2}\\theta -{\\operatorname{sin}}^{2}\\theta )\\hspace{0.167em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\pi /2}}}{\\int }_{0}^{3}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{cos}\\theta }}}^{{r}^{2}{\\operatorname{sin}}^{2}\\theta }\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186367680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "179016a8-0967-5aa2-8749-987e9232c473" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}{\\int }_{0}^{\\sqrt{5}}{\\int }_{-1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{cos}\\theta +2}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367682} {:answer/id #uuid "ed409635-e038-5761-8147-f34be88d7eb5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi /2}}}{\\int }_{0}^{\\sqrt{5}}{\\int }_{-1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{sin}\\theta +2}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367683} {:answer/id #uuid "dd0451c2-89db-5c8c-b802-ada9b3135d89" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi /2}}}{\\int }_{0}^{\\sqrt{5}}{\\int }_{-1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{cos}\\theta +2}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367684} {:answer/id #uuid "8b8f6a4e-1068-54f9-bfa2-44dea6b6c19d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}{\\int }_{0}^{\\sqrt{5}}{\\int }_{-1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{sin}\\theta +2}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367685} {:answer/id #uuid "3d42aec9-1d36-56e8-8bbb-4d0cd2b495d9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}{\\int }_{0}^{\\sqrt{5}}{\\int }_{-1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{sin}\\theta +2}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367686}] :answer-field/correct {:answer/id #uuid "8b8f6a4e-1068-54f9-bfa2-44dea6b6c19d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}{\\int }_{0}^{\\sqrt{5}}{\\int }_{-1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{sin}\\theta +2}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta" :db/id #edb/ref 17592186367685} :answer-field/id #uuid "9e8df57e-c904-5c32-8f54-f331ca9fbb46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367681}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "93fe857d-875f-5d05-8b0e-e6f2a6566317" :question/math-academy-id "q-161612" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=5$ for $y\\ge 0,$ between the surfaces $z=-1$ and $z=y+2.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/7d/7d3ef0b0a9a2f1c9ab60b4ed09f8a0318c57f74236e404baf181e0197ef66002.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $\\sqrt{5}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-1,$ and\n\n- bounded above by $z=y+2=r\\operatorname{sin}⁡\\theta +2.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta ,z)\\hspace{0.167em}:\\hspace{0.167em}0\\le r\\le \\sqrt{5},\\hspace{0.222em}0\\le \\theta \\le \\pi ,\\hspace{0.222em}-1\\le z\\le r\\operatorname{sin}\\theta +2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}z({x}^{2}-{y}^{2})\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}z((r\\operatorname{cos}\\theta )^{2}-(r\\operatorname{sin}\\theta )^{2})r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}rz({r}^{2}{\\operatorname{cos}}^{2}\\theta -{r}^{2}{\\operatorname{sin}}^{2}\\theta )r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}{r}^{3}z({\\operatorname{cos}}^{2}\\theta -{\\operatorname{sin}}^{2}\\theta )\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}{\\int }_{0}^{\\sqrt{5}}{\\int }_{-1}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}r\\operatorname{sin}\\theta +2}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186427901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fa8d886-4e3c-5e48-b553-b40bcf5fb8a1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{4-{r}^{2}}}r\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427869} {:answer/id #uuid "5ff27779-26b4-5f50-86c1-895b48b634f5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{4-r}}r\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427872} {:answer/id #uuid "845094cf-59d5-5624-ae32-03926b0d10f6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{4-{r}^{2}}}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427877} {:answer/id #uuid "880a8f8a-f3c5-58bb-8d3c-3a0e61a860b8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{4-r}}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427878} {:answer/id #uuid "dcf0414c-80b1-5d90-b7d4-18b04ab2c214" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{4-{r}^{2}}}r\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427889}] :answer-field/correct {:answer/id #uuid "2fa8d886-4e3c-5e48-b553-b40bcf5fb8a1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{4-{r}^{2}}}r\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427869} :answer-field/id #uuid "b6d846f8-2c72-5e60-9280-2f6e5faaefd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427900}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "29c4348e-6b58-58ee-9f24-8f11cdb0cbe1" :question/math-academy-id "q-161613" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=1$ for $x\\le 0$ and $y\\ge 0,$ between the surfaces $z=0$ and $z=\\sqrt{4-({x}^{2}+{y}^{2})}.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/8d/8dc4ea0ad2bb776fb31132e1ff8d97efdd2c166dc23ffbc8641f8d7034b8d487.png)\n\nThe region $R$ is one-quarter of a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{4-({x}^{2}+{y}^{2})}=\\sqrt{4-{r}^{2}}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 1,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi ,\\,0\\le z\\le \\sqrt{4-{r}^{2}}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\text{d}V & ={\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi /2}}}^{\\pi }{\\int }_{0}^{1}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{4-{r}^{2}}}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}r}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186427902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48587302-f52a-53a7-9f31-47825d8a1075" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{r}^{3}r\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427870} {:answer/id #uuid "841fab14-6f1b-500a-ab2e-cd3ad15098fe" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{r}^{3}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427876} {:answer/id #uuid "90b8d8fe-ee7b-5218-86d0-ad24858cf4c8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{9}{\\int }_{{r}^{2}}^{3}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427881} {:answer/id #uuid "a75b7c7c-ec28-5349-b0da-7fdd1b563361" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{{r}^{2}}^{3}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427882} {:answer/id #uuid "b90b5f49-c248-5418-886a-73d93a5226bf" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{9}{\\int }_{r}^{3}r\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427886}] :answer-field/correct {:answer/id #uuid "841fab14-6f1b-500a-ab2e-cd3ad15098fe" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\int }_{r}^{3}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427876} :answer-field/id #uuid "587e6da7-3775-5bfa-a95f-b626a3ad5c01" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427897}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "34d0810f-9c28-578b-861d-9088f229fffb" :question/math-academy-id "q-161604" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=9$ between the surfaces $z=\\sqrt{{x}^{2}+{y}^{2}}$ and $z=3.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/9c/9c4ea0ba92e19a201e3944defa6deb0bc1ee76971adaa809521722b6ac31241f.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=\\sqrt{{x}^{2}+{y}^{2}}=r,$ and\n\n- bounded above by $z=3.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 3,\\,0\\le \\theta <2\\pi ,\\,r\\le z\\le 3\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}\\sqrt{(r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2}}\\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}r\\sqrt{{r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3}}}{\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}r}}}^{3}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3768d3f5-e479-570a-8f87-054f14151075" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{25-r}}rz\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555118} {:answer/id #uuid "3f831b9d-82b6-5349-872b-718dde1c3078" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{16}{\\int }_{0}^{\\sqrt{25-{r}^{2}}}z\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555138} {:answer/id #uuid "d1eb0318-10db-5f50-b75e-ea3adc67bc95" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{25-{r}^{2}}}z\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555497} {:answer/id #uuid "e0cec740-2b57-59fd-94c7-ffbf1bda6bb3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{25-{r}^{2}}}rz\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555550} {:answer/id #uuid "f4d014df-66b9-5abe-ae05-fa223574e036" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{16}{\\int }_{0}^{\\sqrt{25-r}}rz\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555606}] :answer-field/correct {:answer/id #uuid "e0cec740-2b57-59fd-94c7-ffbf1bda6bb3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{25-{r}^{2}}}rz\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555550} :answer-field/id #uuid "00cb030e-7557-507e-9d73-d9dfccad2a51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555639}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "20069222-ef1d-5746-8188-77095ae40eed" :question/math-academy-id "q-161603" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=16$ between the surfaces $z=0$ and $z=\\sqrt{25-({x}^{2}+{y}^{2})}.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}z\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/5d/5d8a94cd0df8095c78aec955c3d0f062e38410326399104644b24e981eb1db9a.png)\n\nThe region $R$ is a right vertical cylinder of radius $4$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{25-({x}^{2}+{y}^{2})}=\\sqrt{25-{r}^{2}}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 4,\\,0\\le \\theta <2\\pi ,\\,0\\le z\\le \\sqrt{25-{r}^{2}}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}z\\,\\text{d}V & ={∭}_{Δ}zr\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{25-{r}^{2}}}rz\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25533cdc-be79-58c6-ab12-68206d98ec66" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\sqrt{2}}{\\int }_{1}^{{r}^{2}+4}{r}^{2}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555075} {:answer/id #uuid "8b5ecda2-04fc-57ef-8508-76f7387c82cd" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{\\int }_{1}^{{r}^{2}+4}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555326} {:answer/id #uuid "b0761522-850c-5049-b68e-e7c671bc3e19" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\sqrt{2}}{\\int }_{1}^{{r}^{2}+4}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555423} {:answer/id #uuid "b86b244b-9164-5eba-9967-5ba9b71c70fe" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{\\int }_{1}^{r+4}{r}^{2}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555439} {:answer/id #uuid "d6399ea9-d979-5a2c-a0ae-56134f1964db" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\sqrt{2}}{\\int }_{1}^{r+4}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555510}] :answer-field/correct {:answer/id #uuid "b0761522-850c-5049-b68e-e7c671bc3e19" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\sqrt{2}}{\\int }_{1}^{{r}^{2}+4}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555423} :answer-field/id #uuid "d3ce3bff-654b-53ac-b60d-98e14aab9c6f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555741}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d03cab7-f35e-5f26-85d3-e871e46cdf45" :question/math-academy-id "q-161609" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=2$ for $x\\ge 0$ and $y\\ge 0,$ between the surfaces $z=1$ and $z={x}^{2}+{y}^{2}+4.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}2xy\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/14/140ac7f7d6036657a4ba8a0c6944474c2aa0dfba7f7719228cdffb4d0cf9316f.png)\n\nThe region $R$ is one-quarter of a right vertical cylinder of radius $\\sqrt{2}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=1,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+4={r}^{2}+4.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le \\sqrt{2},\\,0\\le \\theta <\\frac{\\pi }{2},\\,1\\le z\\le {r}^{2}+4\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}2xy\\,\\text{d}V & ={∭}_{Δ}2(r\\operatorname{cos}⁡\\theta )(r\\operatorname{sin}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\sqrt{2}}{\\int }_{1}^{{r}^{2}+4}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b4012ca-c40d-5331-ab80-f5f541c94add" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{\\int }_{2}^{4+r\\operatorname{cos}⁡\\theta }r{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555093} {:answer/id #uuid "3d3cd1d4-431a-5fb2-83e3-87f48ccd6d71" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{5}}{\\int }_{2}^{4+r\\operatorname{sin}⁡\\theta }{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555130} {:answer/id #uuid "658b97a0-eabd-507b-8d2d-737539308798" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{5}}{\\int }_{2}^{4}r{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555229} {:answer/id #uuid "798db401-1df6-59c8-ae28-251864596785" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{5}}{\\int }_{2}^{4+r\\operatorname{sin}⁡\\theta }r{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555282} {:answer/id #uuid "fb84cfdc-3789-5915-a5fd-5ed0d14ca0e0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{\\int }_{2}^{4}{r}^{2}{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555622}] :answer-field/correct {:answer/id #uuid "798db401-1df6-59c8-ae28-251864596785" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{5}}{\\int }_{2}^{4+r\\operatorname{sin}⁡\\theta }r{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555282} :answer-field/id #uuid "ad4e7b48-b967-5cd8-8d67-9aafb4784107" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555725}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9ff4f4d5-934d-5904-8c7d-edf6b1d6934c" :question/math-academy-id "q-161602" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=5$ between the surfaces $z=2$ and $z=4+y.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}{z}^{2}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/28/286910d89e35603dc6558b80b11d06736d213fbad8c9c91825f42ff87b26e318.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{5}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=2,$ and\n\n- bounded above by $z=4+y=4+r\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le \\sqrt{5},\\,0\\le \\theta <2\\pi ,\\,2\\le z\\le 4+r\\operatorname{sin}⁡\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{z}^{2}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}{z}^{2}r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\sqrt{5}}}}{\\int }_{2}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}4+r\\operatorname{sin}\\theta }}}\\bbox[Gainsboro, 2pt]{{\\color{blue}r{z}^{2}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186556292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ee5f71-37f2-50d6-ae8a-9bfa2a3e68bb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2 \\pi}{\\int }_{0}^{\\sqrt{17}}{\\int }_{0}^{r}r^{2} z^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556293} {:answer/id #uuid "4e49c3a3-9740-5bef-9bdc-6a51c7364c8e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2 \\pi}{\\int }_{\\sqrt{17}}^{2 \\sqrt{17}}{\\int }_{0}^{r}r z^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556304} {:answer/id #uuid "8cdbc979-1803-56f6-b7a0-c904c039ff8e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2 \\pi}{\\int }_{0}^{\\sqrt{17}}{\\int }_{0}^{12}r z^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556320} {:answer/id #uuid "9349e73f-aef8-59e0-a523-0ddc41b66c45" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2 \\pi}{\\int }_{0}^{\\sqrt{17}}{\\int }_{0}^{12}r^{2} z^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556321} {:answer/id #uuid "b16ff172-8fbe-5547-98e0-17218c4e502c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2 \\pi}{\\int }_{\\sqrt{17}}^{2 \\sqrt{17}}{\\int }_{0}^{12}r^{2} z^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556329}] :answer-field/correct {:answer/id #uuid "9349e73f-aef8-59e0-a523-0ddc41b66c45" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2 \\pi}{\\int }_{0}^{\\sqrt{17}}{\\int }_{0}^{12}r^{2} z^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556321} :answer-field/id #uuid "2a37a2e4-2236-5089-9702-0aa3e56fadda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556295}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1c4f39f6-c3b9-5ce0-9e72-9d922968c0ed" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=17$ between the surfaces $z=0$ and $z=12.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}{z}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/99/994f3537bf54a849e6a725c4c692a2326266d8065a742b1988308c793708827f.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{17}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=12.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le \\sqrt{17},\\,0\\le \\theta <2\\pi ,\\,0\\le z\\le 12\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}{z}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}{z}^{2}\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}r{z}^{2}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{17}}{\\int }_{0}^{12}{r}^{2}{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186556296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b9a55a9-e21c-5f6b-83a7-1697dde3f5a2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{\\sqrt{5}}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{4} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556315} {:answer/id #uuid "bcafc06b-d37c-56be-b7c8-ed39af45d2c7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{5}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{3} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556333} {:answer/id #uuid "bee5f666-1739-5060-b52a-3a618de550f7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{\\sqrt{5}}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{2} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556334} {:answer/id #uuid "c153d2dc-77a3-5d5b-840c-6705fe6d4796" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{\\sqrt{5}}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{3} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556336} {:answer/id #uuid "ceb3cbb3-d693-5101-819b-f5167b411aa2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{5}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{2} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556339}] :answer-field/correct {:answer/id #uuid "c153d2dc-77a3-5d5b-840c-6705fe6d4796" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{\\sqrt{5}}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{3} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556336} :answer-field/id #uuid "7c700b53-099b-567b-adf9-63c54f069d82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556316}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "37475e2f-873b-54fd-b9a9-28a66b2df1fd" :question/problem "The region $R$ is enclosed inside the cylinder $x^2+y^2=5$ for $x\\le 0$ and $y\\ge 0$, between the surfaces $z=x$ and $z=y^{2} + 4$. Express the following triple integral in cylindrical polar coordinates.\n\n$$\n\\iiint_R z \\left(x^{2} - y^{2}\\right)\\,\\mathrm{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/3e/3e51a479b8fe2a00f7b51a8613fe2cb6a45d790d737637c31b7858766e0491ff.png)\n\nThe region $R$ is one-quarter of a right vertical cylinder of radius $\\sqrt{5}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=x=r \\cos{\\left(\\theta \\right)},$ and\n\n- bounded above by $z=y^{2} + 4=r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le \\sqrt{5},\\frac{\\pi}{2}\\le\\theta\\le \\pi,r \\cos{\\left(\\theta \\right)}\\le z\\le r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R z \\left(x^{2} - y^{2}\\right)\\,\\mathrm{d}V&=\\iiint_\\Delta z((r\\cos\\theta)^2-(r\\sin\\theta)^2)\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\iiint_\\Delta rz(r^2\\cos^2\\theta-r^2\\sin^2\\theta)\\,dz\\,dr\\,d\\theta \\\\ &=\\iiint_\\Delta r^3z(\\cos^2\\theta-\\sin^2\\theta)\\,dz\\,dr\\,d\\theta \\\\ &=\\iiint_\\Delta r^3z\\cos(2\\theta)\\,dz\\,dr\\,d\\theta \\\\ &={\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{\\sqrt{5}}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{3} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta \\end{aligned}\n$$"} {:db/id #edb/ref 17592186556300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ebcc17a-019e-5c17-8bea-7b8844187a85" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{2}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 12}r^{2} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556289} {:answer/id #uuid "12dbab12-164b-5680-94f9-924300098671" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{4}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 12}r^{2} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556290} {:answer/id #uuid "7f2fdac7-0129-5de8-a676-0df12f29a289" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{2}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 12}r^{3} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556318} {:answer/id #uuid "a3b96017-32cb-5f0a-9af2-8b846950d5c7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{2}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 12}r^{4} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556327} {:answer/id #uuid "f68a34f1-2003-56dd-8559-7af6896e3609" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{4}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 12}r^{3} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186556348}] :answer-field/corr