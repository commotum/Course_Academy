#{[{:db/id #edb/ref 17592186497721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "611a3c44-f974-5d1e-a09c-352c3bc0c24d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-80" :db/id #edb/ref 17592186497718}] :answer-field/correct {:db/id #edb/ref 17592186497718} :answer-field/id #uuid "2193b5b3-9a72-511d-86c8-8094d7eaaf72" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497701}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c0231b2-afa6-51bf-9fc2-2f320ea32268" :question/problem "If $a=⟨-9,11,-4⟩$ and $b=⟨7,-3,-4⟩,$ then $a\\cdot b=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =(-9)\\cdot 7+11\\cdot (-3)+(-4)\\cdot (-4) \\\\  & =-63-33+16 \\\\  & =-80.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e69ff9a-ea16-5a34-9380-eff96a1a1b8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-102" :db/id #edb/ref 17592186497707} {:answer/id #uuid "4c11f92a-bbe4-53ac-ba9b-2a480adfa81f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-150" :db/id #edb/ref 17592186497714} {:answer/id #uuid "6b46598f-aa90-5540-8835-b1d372b28b2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-260" :db/id #edb/ref 17592186497720} {:answer/id #uuid "b19d1fc2-c014-594e-ac63-86b9412a6ac5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186497733} {:answer/id #uuid "f6fe8d4e-d42f-5ef8-9852-05c28a197b8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-60" :db/id #edb/ref 17592186497742}] :answer-field/correct {:db/id #edb/ref 17592186497707} :answer-field/id #uuid "9923ad18-7a64-5e10-8f8b-995c29be76f7" :answer-field/key "selection" :answer-field/type {:db/id