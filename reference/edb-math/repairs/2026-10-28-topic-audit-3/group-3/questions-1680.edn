\\right)^{2}} + \\frac{x z}{3 x - 2 y + z})\\,\\mathbf j+(- \\frac{x y z}{\\left(3 x - 2 y + z\\right)^{2}} + \\frac{x y}{3 x - 2 y + z})\\,\\mathbf k \\\\ ∇g(3,2,1) & =\\left(\\frac{(6)(2)-(6)(3)}{(6)^2}\\right)\\,\\mathbf i+\\left(\\frac{(6)(3)-(6)(-2)}{(6)^2}\\right)\\,\\mathbf j+\\left(\\frac{(6)(6)-(6)(1)}{(6)^2}\\right)\\,\\mathbf k \\\\  & =\\left(- \\frac{1}{6}\\right)\\,\\mathbf i+\\left(\\frac{5}{6}\\right)\\,\\mathbf j+\\left(\\frac{5}{6}\\right)\\,\\mathbf k \\\\  & =\\left(- \\frac{1}{6}\\right)\\,\\mathbf i+\\left(\\frac{5}{6}\\right)\\,\\mathbf j+\\left(\\frac{5}{6}\\right)\\,\\mathbf k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71d0f352-5436-5a7b-9f8e-7209188bcf4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- 4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551558} {:answer/id #uuid "84f87ee6-84ac-512f-a950-3b2c1fa07a24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- 4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(- 9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551565} {:answer/id #uuid "9deaa07f-ccfb-572f-879a-a66037f1a2ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- 4 x)\\,\\mathbf i+(3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551572} {:answer/id #uuid "a1432f04-c811-5d61-9930-fed90819117f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551574} {:answer/id #uuid "ef7650a3-aae8-5c47-92a2-7df98f7b92e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- 2 x)\\,\\mathbf i+(- y^{2})\\,\\mathbf j+(3 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551597}] :answer-field/correct {:db/id #edb/ref 17592186551558} :answer-field/id #uuid "02154e13-b680-5f7c-abaf-30774d8ae771" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551533}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d159fc9-a74b-5bd1-b271-b0154d57fc6f" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=- 2 x^{2} - y^{3} + 3 z^{3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(- 2 x^{2} - y^{3} + 3 z^{3}) \\\\  & =(- 4 x)+(0)+(0) \\\\  & =- 4 x \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(- 2 x^{2} - y^{3} + 3 z^{3}) \\\\  & =(0)+(- 3 y^{2})+(0) \\\\  & =- 3 y^{2} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(- 2 x^{2} - y^{3} + 3 z^{3}) \\\\  & =(0)+(0)+(9 z^{2}) \\\\  & =9 z^{2}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(- 4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "426f4d6f-642a-5cd9-b16a-cc631e6f86ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2 x^{2})\\,\\mathbf i+(- 2 y^{2})\\,\\mathbf j+(5 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551549} {:answer/id #uuid "4d57ee26-d55e-5492-9255-c4b8b94d066c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(- 15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551552} {:answer/id #uuid "9f2ddc6e-f3c6-5eba-8696-ca36ae673a3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6 x^{2})\\,\\mathbf i+(6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551573} {:answer/id #uuid "bef8af72-93b9-521d-a5d5-f563c2d8a9d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551582} {:answer/id #uuid "e4e9e0f9-babc-5eff-9c2f-c58e34b69e42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- 6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551592}] :answer-field/correct {:db/id #edb/ref 17592186551582} :answer-field/id #uuid "577176ee-b9f7-5420-8473-fc7dc26c6dc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551554}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ce3e8301-9f22-51e6-b4bd-79ce231d33ce" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=2 x^{3} - 2 y^{3} + 5 z^{3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(2 x^{3} - 2 y^{3} + 5 z^{3}) \\\\  & =(6 x^{2})+(0)+(0) \\\\  & =6 x^{2} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(2 x^{3} - 2 y^{3} + 5 z^{3}) \\\\  & =(0)+(- 6 y^{2})+(0) \\\\  & =- 6 y^{2} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(2 x^{3} - 2 y^{3} + 5 z^{3}) \\\\  & =(0)+(0)+(15 z^{2}) \\\\  & =15 z^{2}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c128f7d-55b7-5fe3-a35b-3b916bfae8b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x^{2})\\,\\mathbf i+(2 y)\\,\\mathbf j+(2 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551536} {:answer/id #uuid "3f9dc42d-4e9b-519d-865d-778adf7e4f13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551548} {:answer/id #uuid "6124a3e9-e1c2-5acb-817f-8f58072e8d0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3 x^{2})\\,\\mathbf i+(- 4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551556} {:answer/id #uuid "b78b0ba8-034f-5202-a5ee-87b1178a0c88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- 3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551580} {:answer/id #uuid "fbd7f76b-8056-5d2d-a7f3-bfc6aad16c17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(- 6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551600}] :answer-field/correct {:db/id #edb/ref 17592186551548} :answer-field/id #uuid "f620b0c8-071e-5fea-bd5b-cbc98758de3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551599}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed666d31-fef8-5eb5-a5ef-be7ba8d33a2a" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=x^{3} + 2 y^{2} + 2 z^{3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(x^{3} + 2 y^{2} + 2 z^{3}) \\\\  & =(3 x^{2})+(0)+(0) \\\\  & =3 x^{2} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(x^{3} + 2 y^{2} + 2 z^{3}) \\\\  & =(0)+(4 y)+(0) \\\\  & =4 y \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(x^{3} + 2 y^{2} + 2 z^{3}) \\\\  & =(0)+(0)+(6 z^{2}) \\\\  & =6 z^{2}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a7742d-0ab1-5cb1-a4e0-9f04009f380a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}y+{x}^{2}y" :db/id #edb/ref 17592186551740} {:answer/id #uuid "39be7048-959a-5586-9a05-58dd72dd2a00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}y" :db/id #edb/ref 17592186551802} {:answer/id #uuid "4fdea056-e0b2-527a-a76b-3b7bd51c90d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-3{x}^{3}y" :db/id #edb/ref 17592186551855} {:answer/id #uuid "63741c96-7347-5365-9dd4-5b7cb9ce2a0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xy-x{y}^{2}" :db/id #edb/ref 17592186551900} {:answer/id #uuid "71d55716-0405-5ae7-a22f-7c18c75cb125" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}{y}^{2}-{x}^{3}" :db/id #edb/ref 17592186551934}] :answer-field/correct {:db/id #edb/ref 17592186551802} :answer-field/id #uuid "52e66d08-f648-5db7-b29b-0acb8e6ee730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552300}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "832871bc-122c-548e-b34d-eed1097a268c" :question/math-academy-id "q-127052" :question/problem "Consider the vector field $F(x,y)=3xy\\,i-{x}^{2}\\,j$ and the circle $C$ given by ${x}^{2}+{y}^{2}=1.$ If the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}\\boxed{}\\,\\text{d}s,\n$$\n\nwhat is the missing expression?\n\n*Hint: The outward-pointing unit normal vector to $C$ is $n=x\\,i+y\\,j.$*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$\n\n![](images/38/386f010932b5846e7f47a605a94a5b5d580bd35dbe37512b1583d15d29f3dc70.png)\n\nIn our case, we have\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}(3xy\\,i-{x}^{2}\\,j)\\cdot (xi+y\\,j)\\,\\text{d}s \\\\  & ={∮}_{C}3{x}^{2}y-{x}^{2}y\\,\\text{d}s \\\\  & ={∮}_{C}2{x}^{2}y\\,\\text{d}s.\\end{aligned}\n$$\n\nTherefore, the missing expression is $2{x}^{2}y.$"}] [{:db/id #edb/ref 17592186552470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac0a72f-211e-5ee3-ae1a-cdee72cf08a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-y" :db/id #edb/ref 17592186551763} {:answer/id #uuid "2d182642-d007-5fcb-afa9-a8fa7ef431cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xy" :db/id #edb/ref 17592186551773} {:answer/id #uuid "5e5d59b2-0373-5c0b-afdf-10bb5a2f8068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}" :db/id #edb/ref 17592186551891} {:answer/id #uuid "728d6f69-9ad5-569f-bfa9-38eefd7f9277" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-xy" :db/id #edb/ref 17592186551938} {:answer/id #uuid "74cf75dc-c6e4-5de4-a02f-72578e740790" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}y" :db/id #edb/ref 17592186551941}] :answer-field/correct {:db/id #edb/ref 17592186551941} :answer-field/id #uuid "e1dca841-c306-5d01-962c-2f2e21f3e369" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552385}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89cfc1e4-7ca7-548a-8985-27acedeb025d" :question/math-academy-id "q-127054" :question/problem "![](images/0d/0dd48f19e9940f1684c0cbb723e772384dda3d7429fc89c2c9dc528f7ebfe42c.png)\n\nConsider the vector field $F(x,y)=xy\\,i-{x}^{2}y\\,j$ and the square $C$ with side length $4$ centered at $O,$ shown above. If the flux of $F$ across the side ${C}_{4}$ is given by\n\n$$\n{\\int }_{{C}_{4}}\\boxed{}\\,\\text{d}s,\n$$\n\nwhat is the missing expression?" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$\n\nIn our case, we need to find an expression for the flux across only the part ${C}_{4}$ of the closed curve $C.$ Since this side is perpendicular to the $y$-axis and we require an outward-pointing unit normal vector, we must have $n=-j.$\n\n![](images/c5/c591fedf1b1c8ea705f0c13fbfd96bc7f1f6701841e3eff03bd0578aa2f8ab06.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{4}}F\\cdot n\\,\\text{d}s & ={\\int }_{{C}_{4}}(xy\\,i-{x}^{2}y\\,j)\\cdot (-j)\\,\\text{d}s \\\\  & ={\\int }_{{C}_{4}}{x}^{2}y\\,\\text{d}s\\end{aligned}\n$$\n\nTherefore, the missing expression is ${x}^{2}y.$"}] [{:db/id #edb/ref 17592186552782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "281698df-9249-5da9-9368-9b2f93cd8848" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552791} {:answer/id #uuid "455025c2-db51-556e-a3e6-9fa4b4a79dac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}t \\left(4 - 6 t^{3}\\right) \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552799} {:answer/id #uuid "4c1ecf92-1397-5d44-97e4-f143aa9d8c69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552801} {:answer/id #uuid "4f811054-64ac-515c-b215-4b187de7bc5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552805} {:answer/id #uuid "a60d9d4a-69db-5a5f-9245-b3924cba5128" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552830}] :answer-field/correct {:db/id #edb/ref 17592186552830} :answer-field/id #uuid "0763297f-2785-5418-b00d-ee5ade6a337c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552781}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "10654151-77bf-5b54-8ad8-7a9ddd7ea1a1" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle \\int_C 2 x^{2} y\\,\\mathrm{d}s\n$$\n\nwhere $C$ is the section of the curve $x=2 - 3 y^{3}$ traversed between the points $(2,0)$ and $(-79,3)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 - 3 t^{3}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 - 3 t^{3},\\,t\\rangle,\\quad 0\\le t\\le 3\n$$\n\nNote that the domain $0\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 - 3 t^{3})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(- 9 t^{2})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &=\\sqrt{(- 9 t^{2})^2+1^2} \\\\ &=\\sqrt{81 t^{4} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=2 x^{2} y,$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left(2 - 3 t^{3}\\right)^{2}t^{1} \\\\ &=2 t \\left(2 - 3 t^{3}\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 2 x^{2} y\\,\\mathrm{d}s&=\\int_{0}^{3}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}(2 t \\left(2 - 3 t^{3}\\right)^{2})\\cdot \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2275c2b9-bd7c-5d72-90c8-7b26275f195e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 t^{5}" :db/id #edb/ref 17592186552788} {:answer/id #uuid "36e310df-bff1-5173-9e88-7181749cd810" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 t^{5}}{64}" :db/id #edb/ref 17592186552795} {:answer/id #uuid "77b420d0-67c2-528a-91a7-5fcbbe514595" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 t^{2}" :db/id #edb/ref 17592186552812} {:answer/id #uuid "7aee2490-8ebd-5fff-aeba-dd54ccd94877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 t^{5}" :db/id #edb/ref 17592186552814} {:answer/id #uuid "ac98de36-83ed-5aef-b75d-338dc0b2dbdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "768 t^{5}" :db/id #edb/ref 17592186552832}] :answer-field/correct {:db/id #edb/ref 17592186552814} :answer-field/id #uuid "e31bb3e8-a091-5beb-bbef-ce8a5745dea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552843}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4996d341-4274-5583-88ff-0f580b30aea8" :question/problem "Consider the line integral\n\n$$\n\\int_C 48 x^{2} y^{3}\\,\\mathrm{d}s=\\frac{\\sqrt{17}}{4}\\int_{1}^{2}\\boxed{}\\,\\mathrm{d}t\n$$\n\nwhere $C$ is the segment of the line $4x=y$ traversed between the points $(\\frac{1}{4},1)$ and $(\\frac{1}{2},2)$. Which of the following is the missing expression under the integral on the right?\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\n4x=y\\,\\Longrightarrow\\,x=\\frac{y}{4}\n$$\n\nTherefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=\\frac{t}{4}.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle\\frac{t}{4},\\,t\\rangle,\\quad 1\\le t\\le 2\n$$\n\nNote that the domain $1\\le t\\le 2$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(\\frac{t}{4}\\right)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=\\left(\\frac{1}{4}\\right)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &=\\sqrt{\\left(\\frac{1}{4}\\right)^2+1^2} \\\\ &=\\sqrt{\\frac{1}{16}+1} \\\\ &=\\sqrt{\\frac{17}{16}} \\\\ &=\\frac{\\sqrt{17}}{4}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=48 x^{2} y^{3},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t))&=48\\left(\\frac{t}{4}\\right)^2t^{3} \\\\ &=48\\left(\\frac{t^2}{16}\\right)t^{3} \\\\ &=3 t^{5}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}\\int_C 48 x^{2} y^{3}\\,\\mathrm{d}s&=\\int_{1}^{2}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{2}(3 t^{5})\\cdot \\frac{\\sqrt{17}}{4}\\,\\mathrm{d}t \\\\ &=\\frac{\\sqrt{17}}{4}\\int_{1}^{2}3 t^{5}\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23197b07-5a7b-53de-9d9e-c615db2ae1e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}t^{2} \\left(2 t^{3} - 8\\right) \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552789} {:answer/id #uuid "2df87d88-57a2-5c89-9a85-320711d02d09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2} \\sqrt{t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552793} {:answer/id #uuid "7b0929a7-5013-5e55-aa1e-ae864b350074" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552815} {:answer/id #uuid "d080d482-7b0f-5090-b506-abea27a84bad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 \\left(t^{3} - 4\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552839} {:answer/id #uuid "ed952ab0-5dec-52bf-9c72-9b41ef3af6ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552847}] :answer-field/correct {:db/id #edb/ref 17592186552847} :answer-field/id #uuid "c85e1c25-dace-5d43-9b45-c16fb0df76d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552838}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7ed925b2-2bfc-5cd1-979d-0167eb4f42c0" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle \\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s\n$$\n\nwhere $C$ is the section of the curve $x=y^{3} - 4$ traversed between the points $(-4,0)$ and $(23,3)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=t^{3} - 4.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle t^{3} - 4,\\,t\\rangle,\\quad 0\\le t\\le 3\n$$\n\nNote that the domain $0\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{3} - 4)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(3 t^{2})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &=\\sqrt{(3 t^{2})^2+1^2} \\\\ &=\\sqrt{9 t^{4} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=2 x^{2} y^{2},$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left(t^{3} - 4\\right)^{2}t^{2} \\\\ &=2 t^{2} \\left(t^{3} - 4\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s&=\\int_{0}^{3}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}(2 t^{2} \\left(t^{3} - 4\\right)^{2})\\cdot \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ce1b2b9-3b87-52e0-a1f6-172a88bf7b1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 t^{3} \\left(2 - 2 t\\right)^{2}" :db/id #edb/ref 17592186552802} {:answer/id #uuid "680810eb-e33e-5d7a-ac2d-3e3d2bcc7f23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\left(2 t + 2\\right)^{2}" :db/id #edb/ref 17592186552809} {:answer/id #uuid "b7a2acf9-a41f-5160-8dc1-756db6ef76d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16 t^{5}" :db/id #edb/ref 17592186552834} {:answer/id #uuid "e0c023e8-5a47-5179-b7eb-afe7ce12e7ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 t^{3} \\left(2 t + 2\\right)^{2}" :db/id #edb/ref 17592186552842} {:answer/id #uuid "f3bd6f10-f9f4-538e-913c-d22618c6f106" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 t^{2} \\left(2 t + 2\\right)^{3}" :db/id #edb/ref 17592186552848}] :answer-field/correct {:db/id #edb/ref 17592186552842} :answer-field/id #uuid "4ecb885d-e56e-5e60-9407-9e9e3fa26bfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552803}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86be1e77-b581-5d25-9650-3cc553d658e6" :question/problem "Consider the line integral\n\n$$\n\\int_C 4 x^{2} y^{3}\\,\\mathrm{d}s=\\sqrt{5}\\int_{2}^{4}\\boxed{}\\,\\mathrm{d}t\n$$\n\nwhere $C$ is the segment of the line $x=2 y + 2$ traversed between the points $(6,2)$ and $(10,4)$. Which of the following is the missing expression under the integral on the right?\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 t + 2.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 t + 2,\\,t\\rangle,\\quad 2\\le t\\le 4\n$$\n\nNote that the domain $2\\le t\\le 4$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 2)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(2)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &=\\sqrt{(2)^2+1^2} \\\\ &=\\sqrt{5}\\end{aligned}\n$$\n\nNow, if $f(x,y)=4 x^{2} y^{3},$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=4\\left(2 t + 2\\right)^{2}t^{3} \\\\ &=4 t^{3} \\left(2 t + 2\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 4 x^{2} y^{3}\\,\\mathrm{d}s&=\\int_{2}^{4}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{2}^{4}(4 t^{3} \\left(2 t + 2\\right)^{2})\\cdot \\sqrt{5}\\,\\mathrm{d}t \\\\ &=\\sqrt{5}\\int_{2}^{4}4 t^{3} \\left(2 t + 2\\right)^{2}\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0260f071-3897-545d-bb02-440d61d15330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 - 5 t" :db/id #edb/ref 17592186552779} {:answer/id #uuid "17052b32-b23e-5b70-b603-b912587c5543" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 - t" :db/id #edb/ref 17592186552785} {:answer/id #uuid "19c6da5f-d3b5-56f5-94b4-f6ad26195c2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7 t - 8" :db/id #edb/ref 17592186552787} {:answer/id #uuid "87c31bd7-b6ca-5532-b4da-aad42b84c763" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 - 3 t" :db/id #edb/ref 17592186552820} {:answer/id #uuid "d7fb372a-4d60-5b14-bc9e-3501041766f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 5 t" :db/id #edb/ref 17592186552840}] :answer-field/correct {:db/id #edb/ref 17592186552779} :answer-field/id #uuid "6ee0746c-4281-5a79-87b4-bd2fbd506c40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552810}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "99c0214e-a2d8-5339-8aee-c36838439a0d" :question/problem "Consider the line integral\n\n$$\n\\int_C x - 2 y\\,\\mathrm{d}s=\\sqrt{10}\\int_{0}^{4}\\boxed{}\\,\\mathrm{d}t\n$$\n\nwhere $C$ is the segment of the line $\\frac{x}{4}=1 - \\frac{3 y}{4}$ traversed between the points $(4,0)$ and $(-8,4)$. Which of the following is the missing expression under the integral on the right?\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\n\\frac{x}{4}=1 - \\frac{3 y}{4}\\,\\Longrightarrow\\,x=4 - 3 y\n$$\n\nTherefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=4 - 3 t.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 4 - 3 t,\\,t\\rangle,\\quad 0\\le t\\le 4\n$$\n\nNote that the domain $0\\le t\\le 4$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(4 - 3 t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(-3)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &=\\sqrt{(-3)^2+1^2} \\\\ &=\\sqrt{9+1} \\\\ &=\\sqrt{10}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=x - 2 y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t))&=1\\left(4 - 3 t\\right)-2t \\\\ &=4 - 5 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}\\int_C x - 2 y\\,\\mathrm{d}s&=\\int_{0}^{4}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{4}(4 - 5 t)\\cdot \\sqrt{10}\\,\\mathrm{d}t \\\\ &=\\sqrt{10}\\int_{0}^{4}(4 - 5 t)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417a2e2c-c99e-5b7e-89a5-04fd8801fb79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2} \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552798} {:answer/id #uuid "7a3d15a8-46f5-5bf1-811c-a4f19b6a7124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{3}t^{2} \\left(4 t^{2} + 6\\right) \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552813} {:answer/id #uuid "7dc7687e-5dff-5e5e-97a9-d31743837c06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{3}2 \\left(2 t^{2} + 3\\right)^{2} \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552816} {:answer/id #uuid "c023fc4c-620c-5620-a1bb-9b3840ec1fc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2} \\sqrt{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552836} {:answer/id #uuid "ed840fbf-dc53-5f4f-83cf-efc910b3cde0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552846}] :answer-field/correct {:db/id #edb/ref 17592186552798} :answer-field/id #uuid "1224e6c3-08af-592f-b40f-08f63238075d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552783}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9eafb873-c81e-5383-b266-5700676268cc" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle \\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s\n$$\n\nwhere $C$ is the section of the curve $x=2 y^{2} + 3$ traversed between the points $(5,1)$ and $(21,3)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 t^{2} + 3.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 t^{2} + 3,\\,t\\rangle,\\quad 1\\le t\\le 3\n$$\n\nNote that the domain $1\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t^{2} + 3)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(4 t)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &=\\sqrt{(4 t)^2+1^2} \\\\ &=\\sqrt{16 t^{2} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=2 x^{2} y^{2},$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left(2 t^{2} + 3\\right)^{2}t^{2} \\\\ &=2 t^{2} \\left(2 t^{2} + 3\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s&=\\int_{1}^{3}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}(2 t^{2} \\left(2 t^{2} + 3\\right)^{2})\\cdot \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2} \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05820e9b-5d3f-5f00-8ab1-5cb728ad058c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{e^{2}}t \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552780} {:answer/id #uuid "3912c436-323c-5514-82b7-0a551fe02d0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{e^{2}}t^{5} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552796} {:answer/id #uuid "5534bb00-f895-5c7c-97e6-684d212578d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{6}t^{4} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552806} {:answer/id #uuid "a0a0976d-6042-5f97-9145-cb3e806a614e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{e^{2}}\\sqrt{10} t^{5}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552828} {:answer/id #uuid "c7400a6a-8f3d-57bb-bce2-f39b5a9cf40c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{e^{2}}t^{4} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552837}] :answer-field/correct {:db/id #edb/ref 17592186552837} :answer-field/id #uuid "2ae4cf2f-2882-5737-907d-832d0c62119c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552792}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa8602a5-ab99-5ec1-a115-7e29b5ef7be8" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle \\int_C y^{2} e^{x}\\,\\mathrm{d}s\n$$\n\nwhere $C$ is the section of the curve $x=3 \\ln{\\left(y \\right)}$ traversed between the points $(0,1)$ and $(6,e^{2})$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=3 \\ln{\\left(t \\right)}.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 3 \\ln{\\left(t \\right)},\\,t\\rangle,\\quad 1\\le t\\le e^{2}\n$$\n\nNote that the domain $1\\le t\\le e^{2}$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 \\ln{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=\\left(\\frac{3}{t}\\right)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &=\\sqrt{\\left(\\frac{3}{t}\\right)^2+1^2} \\\\ &=\\sqrt{\\frac{9}{t^2}+1} \\\\ &=\\sqrt{\\frac{t^{2} + 9}{t^2}} \\\\ &=\\frac{\\sqrt{t^{2} + 9}}{|t|} \\\\ &=\\frac{\\sqrt{t^{2} + 9}}{t}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=y^{2} e^{x},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t))&=1\\left(e^{3\\ln t}\\right)t^{2} \\\\ &=1\\left(t^{3}\\right)t^{2} \\\\ &=t^{5}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}\\int_C y^{2} e^{x}\\,\\mathrm{d}s&=\\int_{1}^{e^{2}}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{e^{2}}(t^{5})\\cdot \\sqrt{1 + \\frac{9}{t^{2}}}\\,\\mathrm{d}t \\\\ &=\\int_{1}^{e^{2}}t^{4} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t.\\end{aligned}\n$$"}]}
