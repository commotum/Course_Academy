#{[{:db/id #edb/ref 17592186125020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35a99596-2194-56d8-b34a-8cf33e24d509" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{xyz}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186321558} {:answer/id #uuid "6fa3bf93-c16d-5b28-921e-41079fe50f98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{xyz}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322014} {:answer/id #uuid "bdfd3cdb-b6de-5b57-8bc2-55f6cfdc0358" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322622} {:answer/id #uuid "ce59c82e-5d51-5485-be48-7fb4d8c385b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{xyz}}{2}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186322758} {:answer/id #uuid "def79f1e-967d-536d-901e-8b6506e4e5d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{xyz}(\\frac{1}{yz}\\text{ }i+\\frac{1}{xz}\\text{ }j+\\frac{1}{xz}\\text{ }k)" :db/id #edb/ref 17592186322890}] :answer-field/correct {:db/id #edb/ref 17592186322622} :answer-field/id #uuid "b1682cef-8ea8-5e2a-8b48-c4bffce5ce2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323514}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4903eb08-1095-52c0-bd3a-a8d7c39455f8" :question/math-academy-id "q-36918" :question/problem "Given $f(x,y,z)=\\sqrt{xyz}$, find $∇f(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (yz) \\\\  & =\\frac{\\sqrt{xyz}}{2x} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xz) \\\\  & =\\frac{\\sqrt{xyz}}{2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xy) \\\\  & =\\frac{\\sqrt{xyz}}{2z}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2x}\\text{ }i+\\frac{\\sqrt{xyz}}{2y}\\text{ }j+\\frac{\\sqrt{xyz}}{2z}\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e393b4-8a81-5128-9ba6-326770dd3c30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k" :db/id #edb/ref 17592186321197} {:answer/id #uuid "46cf9748-7a8c-51e8-a98f-bf480e7d4abd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{yz}\\text{ }j+\\frac{1}{yz}\\text{ }k" :db/id #edb/ref 17592186321705} {:answer/id #uuid "5277d147-5423-52ea-9448-c91d7f890aac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2\\sqrt{y}}\\text{ }j+\\frac{1}{2\\sqrt{z}}\\text{ }k" :db/id #edb/ref 17592186321796} {:answer/id #uuid "76d89040-9cda-5314-8747-132b54e35625" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2yz}\\text{ }j+\\frac{1}{2yz}\\text{ }k" :db/id #edb/ref 17592186322073} {:answer/id #uuid "fa45680f-55c0-5cbc-847f-d3b13a4ac29e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k" :db/id #edb/ref 17592186323119}] :answer-field/correct {:db/id #edb/ref 17592186321197} :answer-field/id #uuid "4bd27916-0e07-570f-8b09-3b81d2a1b865" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323310}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e287a6b3-141e-5735-ae69-360760a9ed55" :question/math-academy-id "q-36968" :question/problem "Find $∇g(x,y,z)$ given that  $g(x,y,z)=\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =\\frac{1}{2\\sqrt{x+2}}+0 \\\\  & =\\frac{1}{2\\sqrt{x+2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot z \\\\  & =\\frac{1}{2y} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot y \\\\  & =\\frac{1}{2z}\\end{aligned}\n$$\n\nHence,  the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2c10b59-e8cd-5e7c-9049-fd8be7ddaab6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439659} {:answer/id #uuid "ca655899-65ac-5820-b59a-f7c0ae16b8b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439660}] :answer-field/correct {:db/id #edb/ref 17592186439659} :answer-field/id #uuid "1c0ad1ed-94f0-5bfa-840b-df5c1a61ba95" :answer-field/key "$(-1,-1,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440187} {:answer-field/choices [{:answer/id #uuid "0a1984ad-7e67-5f77-b8cb-f189a10d7438" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439661} {:answer/id #uuid "61d3c332-6d22-5dee-bc1a-066a7af36a70" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439662}] :answer-field/correct {:db/id #edb/ref 17592186439662} :answer-field/id #uuid "70673469-2ca6-5afb-a822-ecaa84c950e4" :answer-field/key "$(0,-1,0)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440188} {:answer-field/choices [{:answer/id #uuid "34574511-9dc1-5490-b660-0ec605aed387" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439663} {:answer/id #uuid "138bce6c-91c8-5fb6-bc0f-b3bfd4167414" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439664}] :answer-field/correct {:db/id #edb/ref 17592186439664} :answer-field/id #uuid "4c4a942e-b2f8-55dc-8a38-b5c2c5665e02" :answer-field/key "$(0,0,0)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440189} {:answer-field/choices [{:answer/id #uuid "cc50fb60-551e-5145-829b-a3b02ac7fbc1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439665} {:answer/id #uuid "0cb35919-3fb4-5b4b-8865-1ce0fe36c9fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439666}] :answer-field/correct {:db/id #edb/ref 17592186439665} :answer-field/id #uuid "9adf9e7f-68e9-58c1-8b08-64f124922a86" :answer-field/key "$(1,-1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440190}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "adae0b04-7ccf-59da-b863-ae9717fcfd97" :question/math-academy-id "q-36970" :question/problem "Given $h(x,y,z)=xy+x{y}^{2}+{z}^{3}.$ Find the points $(x,y,z)$ where $∇h(x,y,z)=0.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xy+x{y}^{2}+{z}^{3}) \\\\  & =y+{y}^{2}+0 \\\\  & =y+{y}^{2} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xy+x{y}^{2}+{z}^{3}) \\\\  & =x+2xy+0 \\\\  & =x+2xy \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy+x{y}^{2}+{z}^{3}) \\\\  & =0+0+3{z}^{2} \\\\  & =3{z}^{2}\\end{aligned}\n$$\n\nHence, $∇h(x,y,z)=(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k.$\n\nNow, we solve $∇h(x,y,z)=0:$\n\n$$\n\\begin{aligned}(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }k\\end{aligned}\n$$\n\nSo, by equating the coefficients of $i$, $j$, and $k$, we obtain:\n\n$$\n\\begin{cases}y+{y}^{2}=0 \\\\ x+2xy=0 \\\\ 3{z}^{2}=0\\end{cases}\n$$\n\nThe first equation can be written as $y(1+y)=0$, which gives $y=0$ or $y=-1.$ Substituting these into the second equation, we obtain:\n\n$$\n\\begin{aligned}x+2x(0) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nor,\n\n$$\n\\begin{aligned}x+2x(-1) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nFinally, from the third equation, we get $z=0.$\n\nTherefore, $∇h(x,y,z)=0$ at two points: $(0,0,0)$ and $(0,-1,0).$"}] [{:db/id #edb/ref 17592186125073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "823cc20e-f86a-5020-9707-c46b0aebe5ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y^{2}\\ln y(2\\ln x + 1)i + x^{2}\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123039} {:answer/id #uuid "2149104b-9ef4-58ae-9dd2-d0090b43d4b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xy^{2}\\ln y(2\\ln x + 1)i + x^{2}y\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123040} {:answer/id #uuid "237aa152-79aa-59ca-9da8-d11107a70f8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xy^{2}\\ln y(\\ln x + 1)i + x^{2}y\\ln x(\\ln y + 1)j" :db/id #edb/ref 17592186123041} {:answer/id #uuid "4598fee0-272e-5114-8a2c-ded49201d59a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2xy^{2}\\ln x\\ln yi + 2x^{2}y\\ln x\\ln yj" :db/id #edb/ref 17592186123042} {:answer/id #uuid "62496431-e87b-55ac-959c-a35896635b84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xy\\ln y(2\\ln x + 1)i + xy\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123043}] :answer-field/id #uuid "570aa897-a887-5746-b026-d89e242c332b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186123038}] :question/id #uuid "5428db75-6dff-5dda-b472-e2a79932ad02" :question/math-academy-id "q-37466" :question/problem "What is the gradient of the product $f(x, y)g(x, y)$ if $f(x, y) = \\ln x\\ln y$ and $g(x, y) = x^{2}y^{2}$?"}] [{:db/id #edb/ref 17592186125074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccafabf2-27cf-5b44-8930-a54e452bc954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-y-1=\\frac{z-1}{2}" :db/id #edb/ref 17592186385385} {:answer/id #uuid "67a0969d-2efa-50ec-a3a4-619fb8bb16fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{y+1}{2}=z-1" :db/id #edb/ref 17592186385386} {:answer/id #uuid "4e6a97a3-5af6-531a-870a-ae08853e320f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{x}{2}=\\frac{y+1}{2}=z" :db/id #edb/ref 17592186385387} {:answer/id #uuid "7632f3d8-1e29-5bdf-93fe-9967dfc64633" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{y+1}{2}=\\frac{z-1}{2}" :db/id #edb/ref 17592186385388} {:answer/id #uuid "247f5172-7db7-511c-8fd9-7db9f6287753" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=y+1=z-1" :db/id #edb/ref 17592186385389}] :answer-field/correct {:db/id #edb/ref 17592186385386} :answer-field/id #uuid "0b6b56a1-3889-545f-a00d-30961c2c2ad7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385384}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "78adb807-d26f-59bb-a8f7-9d0e5cc88b53" :question/math-academy-id "q-37515" :question/problem "Find the equation of the normal line to the surface $z=\\operatorname{sin}⁡(xy)+{y}^{2}$ at the point $(0,-1,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}z & =\\operatorname{sin}⁡(xy)+{y}^{2} \\\\ 0 & =\\operatorname{sin}⁡(xy)+{y}^{2}-z\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=\\operatorname{sin}⁡(xy)+{y}^{2}-z$, our surface can be viewed as the level surface $f(x,y,z)=0.$ \n\nA normal vector to the level surface that passes through the point $(0,-1,1)$ can be found by computing $∇f(0,-1,1).$ \n\nSo, we find the gradient and evaluate it at $(0,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy)+{y}^{2}-z)i+\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy)+{y}^{2}-z)j+\\frac{∂}{∂z}(\\operatorname{sin}⁡(xy)+{y}^{2}-z)k \\\\  & =y\\operatorname{cos}⁡(xy)\\text{ }i+(x\\operatorname{cos}⁡(xy)+2y)\\text{ }j-\\text{ }k \\\\ ∇f(0,-1,1) & =(-1)\\operatorname{cos}⁡(0)\\text{ }i+[(0)\\operatorname{cos}⁡(0)+2(-1)]\\text{ }j-\\text{ }k \\\\  & =-i-2\\,j-k \\\\  & =⟨-1,-2,-1⟩\\end{aligned}\n$$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$ and passes through the point $({x}_{0},{y}_{0},{z}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-0}{-1}=\\frac{y-(-1)}{-2}=\\frac{z-1}{-1} \\\\ \\frac{x}{-1}=\\frac{y+1}{-2}=\\frac{z-1}{-1} \\\\ \\frac{x}{1}=\\frac{y+1}{2}=\\frac{z-1}{1} \\\\ x=\\frac{y+1}{2}=z-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b0197ad-d5e0-50ec-8157-0c06f4986576" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,-36⟩\\cdot ⟨x-\\sqrt{\\pi },\\,y-2⟩=0" :db/id #edb/ref 17592186447333} {:answer/id #uuid "341d1b1c-4578-5521-9b08-b2e4e4af8a34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,1⟩\\cdot ⟨x-\\sqrt{\\pi },\\,y-2⟩=0" :db/id #edb/ref 17592186447334} {:answer/id #uuid "351713ea-d6ad-5a99-b2a8-0ed43fff911d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨36,0⟩\\cdot ⟨x-\\sqrt{\\pi },\\,y-2⟩=0" :db/id #edb/ref 17592186447335} {:answer/id #uuid "e5bdc0c7-03d3-58fa-b3e6-6a56b32f6d75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,12⟩\\cdot ⟨x-\\sqrt{\\pi },\\,y-2⟩=0" :db/id #edb/ref 17592186447356} {:answer/id #uuid "f85e4345-3a7c-5b21-b5a8-d864dc102736" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨6,9⟩\\cdot ⟨x-\\sqrt{\\pi },\\,y-2⟩=0" :db/id #edb/ref 17592186447362}] :answer-field/correct {:db/id #edb/ref 17592186447333} :answer-field/id #uuid "912b4db0-e052-5337-99c9-aff6e5410f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186123050}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6369bf45-c149-5591-b6da-b79b10114d99" :question/math-academy-id "q-37517" :question/problem "Given the function $f(x,y)=\\operatorname{cos}⁡({x}^{2})-3{y}^{3}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(\\sqrt{\\pi },2).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\sqrt{\\pi },2):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡({x}^{2})-3{y}^{3})\\,i+\\frac{∂}{∂y}(\\operatorname{cos}⁡({x}^{2})-3{y}^{3})\\,j \\\\  & =-2x\\operatorname{sin}⁡({x}^{2})\\,i-9{y}^{2}\\,j \\\\ ∇\\,f(\\sqrt{\\pi },2) & =-2\\sqrt{\\pi }\\operatorname{sin}⁡((\\sqrt{\\pi })^{2})i-9(2)^{2}\\,j \\\\  & =-2\\sqrt{\\pi }\\cdot 0\\,i-36\\,j \\\\  & =-36\\,j \\\\  & =⟨0,-36⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(\\sqrt{\\pi },2)\\cdot ⟨x-\\sqrt{\\pi },\\,y-2⟩ & =0 \\\\ ⟨0,-36⟩\\cdot ⟨x-\\sqrt{\\pi },\\,y-2⟩ & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284eed2b-f5b5-55e8-8043-dc7f9352df8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,i-2\\,j+4\\,k" :db/id #edb/ref 17592186385391} {:answer/id #uuid "891daeba-0e3b-599d-ba1c-f3ca19efea95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\,i-2\\,k" :db/id #edb/ref 17592186385392} {:answer/id #uuid "7479fa2d-d3ba-5e5f-b91f-c455aeddd593" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,i+j+4\\,k" :db/id #edb/ref 17592186385393} {:answer/id #uuid "f368beea-18d3-5ba4-a48e-57ffd46d193b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "i+2\\,j+4\\,k" :db/id #edb/ref 17592186385394} {:answer/id #uuid "4cb18261-78e6-5c3a-b541-e09f14d04051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,j+k" :db/id #edb/ref 17592186385395}] :answer-field/correct {:db/id #edb/ref 17592186385393} :answer-field/id #uuid "e6793d18-67c7-5552-bd0c-a7ad3c9a1562" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385390}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5878a311-1e95-57bd-8bd7-391f384f5bbd" :question/math-academy-id "q-37570" :question/problem "For the function $f(x,y,z)=xy+5x+{z}^{2}$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,2).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,2)$ can be found by computing \n$∇f(1,-1,2).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(1,-1,2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(xy+5x+{z}^{2})\\,i+\\frac{∂}{∂y}(xy+5x+{z}^{2})\\,j+\\frac{∂}{∂z}(xy+5x+{z}^{2})\\,k \\\\  & =(y+5)\\text{ }i+x\\text{ }j+2z\\text{ }k \\\\ ∇f(1,-1,2) & =(-1+5)\\,i+(1)\\,j+2(2)\\,k \\\\  & =4\\,i+j+4\\,k\\end{aligned}\n$$\n\nTherefore, $4\\,i+j+4\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,2).$"}] [{:db/id #edb/ref 17592186125189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a68112ca-e7ee-5f12-8c6b-6f964b2fce64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\,i+4j+2\\,k" :db/id #edb/ref 17592186398915} {:answer/id #uuid "5739b0cd-fba7-5818-952f-616d15f8cd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\,i-4j+3\\,k" :db/id #edb/ref 17592186398916} {:answer/id #uuid "fc61dd7b-3fa9-5347-ad13-eae563990528" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i-j+3\\,k" :db/id #edb/ref 17592186398917} {:answer/id #uuid "9e270cd2-2ed5-5ff9-a8d2-046b4683fe91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,i+4j+3\\,k" :db/id #edb/ref 17592186398918} {:answer/id #uuid "12f59294-d897-5332-9fd4-6a0a58840be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,i-2j+6\\,k" :db/id #edb/ref 17592186398919}] :answer-field/correct {:db/id #edb/ref 17592186398916} :answer-field/id #uuid "027e0dd0-8fb0-53bb-95b9-27c1e0e20a6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398914}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15fe86f3-62bf-5e0d-8567-00ad11df9f8d" :question/math-academy-id "q-65167" :question/problem "For the function $f(x,y,z)=x{y}^{2}-2yz+z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,1)$ can be found by computing \n$∇f(1,-1,1).$ \n\nSo, we first find the gradient of $f(x,y,z)$  and evaluate it at $(x,y,z)=(1,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-2yz+z)\\,i+\\frac{∂}{∂y}(x{y}^{2}-2yz+z)\\,j+\\frac{∂}{∂z}(x{y}^{2}-2yz+z)\\,k \\\\  & ={y}^{2}\\text{ }i+(2xy-2z)\\text{ }j+(-2y+1)\\text{ }k \\\\ ∇f(1,-1,1) & =(-1)^{2}\\,i+(2(1)(-1)-2(1))\\,j+(-2(-1)+1)\\,k \\\\  & =1\\,i-4j+3\\,k\\end{aligned}\n$$\n\n \n\nTherefore, $\\,i-4\\,j+3\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$"}] [{:db/id #edb/ref 17592186125190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034d9a67-8763-5c70-b5b9-7febdebfdaf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-5y+1=0" :db/id #edb/ref 17592186496664} {:answer/id #uuid "132dcf6f-8423-544a-b9b0-4fe0220a1869" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x-3y+5=0" :db/id #edb/ref 17592186496700} {:answer/id #uuid "6cc0248f-f177-570e-9398-26b743d6c5ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2x-2y+3=0" :db/id #edb/ref 17592186496894} {:answer/id #uuid "9a929f5c-99d1-523a-aabc-fdf5eb4c7f18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x+5y-3=0" :db/id #edb/ref 17592186496982} {:answer/id #uuid "bc272b8f-4ab5-5f01-8506-f12b4f57de0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5x-4y+1=0" :db/id #edb/ref 17592186497043}] :answer-field/correct {:db/id #edb/ref 17592186496982} :answer-field/id #uuid "22b9919e-c058-55c4-a73e-14ca053dbdce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186123740}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb219d72-040d-55dd-90ca-3f831acb4d64" :question/math-academy-id "q-65173" :question/problem "Consider the plane curve $xy={x}^{2}+{y}^{2}-7.$  Find the equation of the normal line to the curve at the point $(2,-1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}xy & ={x}^{2}+{y}^{2}-7 \\\\ 0 & ={x}^{2}+{y}^{2}-xy-7\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+{y}^{2}-xy-7$, our curve can be viewed as the level curve $f(x,y)=0.$  \n\nA normal vector to the level curve that passes through the point $(2,-1)$ can be found by computing $∇f(2,-1).$ \n\nSo, we find the gradient and evaluate it at $(2,-1):$ \n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}+{y}^{2}-xy-7)\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2}-xy-7)\\,j \\\\  & =(2x-y)\\,i+(2y-x)\\,j \\\\ ∇f(2,-1) & =(2(2)-(-1))\\,i+(2(-1)-2)\\,j \\\\  & =5\\,i-4\\,j \\\\  & =⟨5,-4⟩\\end{aligned}\n$$\n\nHence, $∇f(2,-1)=⟨5,-4⟩$ is a normal vector to the curve at $(2,-1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-2}{5} & =\\frac{y-(-1)}{-4} \\\\ -4(x-2) & =5(y+1) \\\\ -4x-5y+8-5 & =0 \\\\ -4x-5y+3 & =0 \\\\ 4x+5y-3 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323ab6d8-7707-5cf4-a618-ba17b3923dd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364297} {:answer/id #uuid "043f0c6b-beee-5929-91a6-329b0aba6cab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364298} {:answer/id #uuid "6c7f3a73-6bb3-57e1-b890-8a39b32ac5a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{2}\\,i+j" :db/id #edb/ref 17592186364299} {:answer/id #uuid "b9bd5e2f-eea5-58c3-8f18-2c41ef884348" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i-j" :db/id #edb/ref 17592186364300} {:answer/id #uuid "cb787b13-c2e5-5275-b510-4a2ee9675a16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{2}\\,i-j" :db/id #edb/ref 17592186364301}] :answer-field/correct {:db/id #edb/ref 17592186364297} :answer-field/id #uuid "4633732e-7712-5dd5-9f2e-d57d7262b765" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186364296}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ad74cdc7-0885-5bf3-989d-0d3835ead91a" :question/math-academy-id "q-65204" :question/problem "Consider the plane curve $\\operatorname{cos}⁡x\\operatorname{cos}⁡y=\\operatorname{sin}⁡(xy).$ Find a tangent vector to that curve at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x\\operatorname{cos}⁡y & =\\operatorname{sin}⁡xy \\\\ \\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy) & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡xy$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(0,\\frac{\\pi }{2})$ can be computed as follows:\n\n$$\nt(0,\\frac{\\pi }{2})={f}_{y}(0,\\frac{\\pi }{2})i-{f}_{x}(0,\\frac{\\pi }{2})j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(0,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,i-\\frac{∂}{∂x}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,j \\\\  & =(-\\operatorname{cos}⁡x\\operatorname{sin}⁡y-x\\operatorname{cos}⁡(xy))i-(-\\operatorname{sin}⁡x\\operatorname{cos}⁡y-y\\operatorname{cos}⁡(xy))\\,j \\\\ t(0,\\frac{\\pi }{2}) & =(-\\operatorname{cos}⁡(0)\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)-0\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))i-(-\\operatorname{sin}⁡(0)\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\frac{\\pi }{2}\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))j \\\\  & =-i+\\frac{\\pi }{2}\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-i+\\frac{\\pi }{2}\\,j.$"}] [{:db/id #edb/ref 17592186125192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce07dfdf-2d2a-50b4-b231-394b5d5d097f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439857} {:answer/id #uuid "85dfbd24-c291-5c08-b3d8-efa72d2bebc9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439858}] :answer-field/correct {:db/id #edb/ref 17592186439857} :answer-field/id #uuid "76b7e8b2-e034-52dd-9da2-5852ff35bd1c" :answer-field/key "$(-1,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440286} {:answer-field/choices [{:answer/id #uuid "75afdcde-1b54-58d6-b950-1389a729ce22" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439859} {:answer/id #uuid "ddc181f6-b619-50be-b805-c3f50013f219" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439860}] :answer-field/correct {:db/id #edb/ref 17592186439860} :answer-field/id #uuid "32972e40-590f-5893-946b-6bd1c90198c0" :answer-field/key "$(-1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440287} {:answer-field/choices [{:answer/id #uuid "38c129c4-6cdd-5109-a4f7-14ddc43a724a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439861} {:answer/id #uuid "3e06be53-d9b1-54cd-bff2-19c4f3681747" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439862}] :answer-field/correct {:db/id #edb/ref 17592186439862} :answer-field/id #uuid "30e09a55-e1b1-529e-9575-29c8323f08a4" :answer-field/key "$(0,0)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440288} {:answer-field/choices [{:answer/id #uuid "5278cce0-690a-57d3-9f99-59786668dd25" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439863} {:answer/id #uuid "c194ddff-249d-568f-bbed-b5a98a9cbf2b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439864}] :answer-field/correct {:db/id #edb/ref 17592186439864} :answer-field/id #uuid "4f6cf21c-f929-519d-97e8-9c947398a3c9" :answer-field/key "$(1,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440289} {:answer-field/choices [{:answer/id #uuid "fd09c21d-1862-5911-bc93-7b66b39ffdd2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439865} {:answer/id #uuid "800ae177-fe54-5efa-bdce-f8e4327de277" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439866}] :answer-field/correct {:db/id #edb/ref 17592186439865} :answer-field/id #uuid "50868321-e216-553a-b3ca-72efe4f524e3" :answer-field/key "$(1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440290}] :question/id #uuid "142e660e-5b1f-5e61-a343-ee1945f69615" :question/math-academy-id "q-65208" :question/problem "At which points on the curve $9x^{2}y = 3y^{3} - 6x$ is the tangent vector to the curve perpendicular to the vector $i$?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Write the curve as F(x,y)=0. A tangent is (F_y,-F_x); its dot product with the given vector is $9 x^{2} - 9 y^{2}$. Solving this with the curve equation gives $(-1,1), (0,0), (1,-1)$, and the tangent is nonzero at each point."}] [{:db/id #edb/ref 17592186125220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5e4bf55-9a10-5bcf-b1ba-805a65a3bf3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186123921} {:answer/id #uuid "3eff33c7-fc2b-5d42-a965-3adddff1c0e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186123922} {:answer/id #uuid "4d168aed-dd23-5ed7-b72b-7e03278d8a80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186123923} {:answer/id #uuid "5ef815d8-371a-5069-b3e0-9b266d62c779" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186123924} {:answer/id #uuid "6f85d996-bdc5-5a2c-ae0a-5f2abafa3993" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186123925}] :answer-field/correct {:db/id #edb/ref 17592186123921} :answer-field/id #uuid "bf75eb81-4b37-5ee3-b292-043ac65176b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186123920}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d068be46-087a-5639-aff2-b79d4b9eda8a" :question/math-academy-id "q-74898" :question/problem "Find  $\\lim_{\\mathbf{x}\\to (-1,2,2)}\\frac{{z}^{2}-{y}^{2}}{{z}^{3}-{y}^{2}z}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\lim_{x\\to (-1,2,2)}\\frac{{z}^{2}-{y}^{2}}{{z}^{3}-{y}^{2}z}=\\frac{{2}^{2}-{2}^{2}}{{2}^{3}-{2}^{2}\\cdot 2}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,2,2)}\\frac{{z}^{2}-{y}^{2}}{{z}^{3}-{y}^{2}z} & =\\lim_{x\\to (-1,2,2)}\\frac{{z}^{2}-{y}^{2}}{z({z}^{2}-{y}^{2})} \\\\  & =\\lim_{x\\to (-1,2,2)}\\frac{1}{z}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,2,2)}\\frac{1}{z} & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186125221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1ef4124-221a-5a91-b97a-ab217edc9f27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186380030} {:answer/id #uuid "541c1996-da8d-5186-bf33-6697813ff100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186380031} {:answer/id #uuid "bda409eb-ec4f-5401-9dcf-b40ae4c50f43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186380032} {:answer/id #uuid "86aeb84b-e9b3-5051-aaa0-7952946334ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186380033} {:answer/id #uuid "aea31071-42df-54b5-9274-ca95aa9906f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186380034}] :answer-field/correct {:db/id #edb/ref 17592186380034} :answer-field/id #uuid "4d23ad6c-16ea-5ede-a1f2-1c4a033d4add" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380029}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b7553878-547e-5260-bbb8-8346cb43f141" :question/math-academy-id "q-74901" :question/problem "$\\lim_{\\mathbf{x}\\to (0,1)}\\frac{{x}^{2}-x}{\\sqrt{1+xy}-1}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\lim_{\\mathbf{x}\\to (0,1)}\\frac{{x}^{2}-x}{\\sqrt{1+xy}-1}=\\frac{{0}^{2}-0}{\\sqrt{1+0\\cdot 1}-1}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (0,1)}\\frac{{x}^{2}-x}{\\sqrt{1+xy}-1} & =\\lim_{\\mathbf{x}\\to (0,1)}\\frac{({x}^{2}-x)(\\sqrt{1+xy}+1)}{(\\sqrt{1+xy}-1)(\\sqrt{1+xy}+1)} \\\\  & =\\lim_{\\mathbf{x}\\to (0,1)}\\frac{x(x-1)(\\sqrt{1+xy}+1)}{(\\sqrt{1+xy})^{2}-{1}^{2}} \\\\  & =\\lim_{\\mathbf{x}\\to (0,1)}\\frac{x(x-1)(\\sqrt{1+xy}+1)}{xy} \\\\  & =\\lim_{\\mathbf{x}\\to (0,1)}\\frac{(x-1)(\\sqrt{1+xy}+1)}{y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (0,1)}\\frac{(x-1)(\\sqrt{1+xy}+1)}{y} & =\\frac{(0-1)(\\sqrt{1+0\\cdot 1}+1)}{1} \\\\  & =\\frac{-2}{1} \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-2.$"}] [{:db/id #edb/ref 17592186125222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f08974e8-e936-5c85-b6a9-d720913a44f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186380036} {:answer/id #uuid "073ecdcc-0e82-5540-a063-14787b43ccc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186380037} {:answer/id #uuid "74037f58-94e0-5f4b-b642-529c4760d8d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty " :db/id #edb/ref 17592186380038} {:answer/id #uuid "eb86860f-a9f9-52b5-b8ca-e8fac436332c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186380039} {:answer/id #uuid "2b214f52-5fef-5a7f-b0cb-9e2a51b1e5f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186380040}] :answer-field/correct {:db/id #edb/ref 17592186380040} :answer-field/id #uuid "0437ed33-2c17-55e7-bef6-493c7f7ed724" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380035}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "38bfaf73-a17c-57af-a4a5-e1f3edf77e4c" :question/math-academy-id "q-74903" :question/problem "$\\lim_{\\mathbf{x}\\to (0,0)}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\lim_{\\mathbf{x}\\to (0,0)}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}}=\\frac{2\\cdot {0}^{2}\\cdot 0+0\\cdot {0}^{2}}{{0}^{3}+0\\cdot {0}^{2}}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $\\mathbf{x}\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (0,0)\\,\\hspace{0.222em}\\hspace{0.222em}y=x}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}} & =\\lim_{x\\to 0}\\frac{2{x}^{3}+{x}^{3}}{{x}^{3}+{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\frac{3{x}^{3}}{2{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\hspace{0.222em}\\frac{3}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\n- Taking $\\mathbf{x}\\to (0,0)$ along the path $y=-x,$ we have\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (0,0)\\,\\hspace{0.222em}\\hspace{0.222em}y=-x}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}} & =\\lim_{x\\to 0}\\frac{2{x}^{3}-{x}^{3}}{{x}^{3}+{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\frac{{x}^{3}}{2{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\hspace{0.222em}\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n\\lim_{\\mathbf{x}\\to (0,0)}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186125223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b854f763-ed80-5765-977e-d777be9389dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186123939} {:answer/id #uuid "b9820c9d-fbc4-5ec7-8e94-b92be2bcca27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186123940} {:answer/id #uuid "bb91eaa9-b9b0-507a-a5d1-1276815c0414" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186123941} {:answer/id #uuid "bc8208af-32ab-5380-8ca8-41fb48e098cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186123942} {:answer/id #uuid "7f9a7dee-ade9-57bb-b47b-7818602e9219" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186123943}] :answer-field/correct {:db/id #edb/ref 17592186123943} :answer-field/id #uuid "406cbd00-ec1e-58cf-b40f-a0b22e94c3e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186123938}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e3fea14-2815-5683-ac38-ab51981e0e10" :question/math-academy-id "q-74924" :question/problem "Find  $\\lim_{\\mathbf{x}\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\lim_{x\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}}=\\frac{2\\cdot 2\\cdot (-1)-(-1)\\cdot {2}^{2}}{{2}^{2}-{2}^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}} & =\\lim_{x\\to (2,2,-1)}\\frac{yz(x-y)}{-(x-y)(x+y)} \\\\  & =\\lim_{x\\to (2,2,-1)}\\frac{yz}{-x-y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}\\lim_{x\\to (2,2,-1)}\\frac{yz}{-x-y} & =\\frac{2\\cdot (-1)}{-2-2} \\\\  & =\\frac{-2}{-4} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186125224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbd3afd7-5a69-5bc2-8161-fee77f4632dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186377703} {:answer/id #uuid "f9b0c048-b115-51b0-b2dc-9897de240e0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186377704} {:answer/id #uuid "23b23618-823a-5db2-9ef3-35b32a0c9e44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186377705} {:answer/id #uuid "d8ed3530-f0fa-5d8c-bdb6-2cf6002bca16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186377706} {:answer/id #uuid "bcab442c-986f-5282-b630-dfaf3c36ca2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186377707}] :answer-field/correct {:db/id #edb/ref 17592186377705} :answer-field/id #uuid "fc72be4b-ba1c-5d2a-b23f-ef19af81df35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186377702}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dfaf27b0-dc8b-5691-99ed-4010ac8fdea0" :question/math-academy-id "q-74954" :question/problem "$$\n\\lim_{\\mathbf{x}\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=\n$$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\lim_{\\mathbf{x}\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=\\frac{4-4}{\\sqrt{4}-\\sqrt{4}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}} & =\\lim_{\\mathbf{x}\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})} \\\\  & =\\lim_{\\mathbf{x}\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x})^{2}-(\\sqrt{y})^{2}} \\\\  & =\\lim_{\\mathbf{x}\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & =\\lim_{\\mathbf{x}\\to (4,4)}(\\sqrt{x}+\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (4,4)}(\\sqrt{x}+\\sqrt{y}) & =\\sqrt{4}+\\sqrt{4} \\\\  & =2+2 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $4.$"}] [{:db/id #edb/ref 17592186128836 :question/id #uuid "418bea54-7fb3-5013-b91c-355a45af08e6" :question/math-academy-id "e-11151" :question/problem "Using the change of variables\n\n$$\nu = \\dfrac{y^2}{x}, \\qquad v= xy,\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the curves\n\n$$\nx = {y^2}, \\qquad x=\\dfrac{y^2}3, \\qquad y=\\dfrac2x, \\qquad y=\\dfrac4x.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n\\iint\\limits_{D} \\mathrm d x \\mathrm d y.\n$$\n\nLet's define a transformation $\\mathbf T$ as follows: \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v ) \\\\ y ( u , v )\\end{array} \\right]}\n$$\n\nThis transformation maps some region $\\Delta$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n\\iint\\limits_{D} \\mathrm d x \\mathrm d y = \\iint\\limits_{\\Delta} \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right|  \\ \\mathrm d u \\mathrm d v\n$$\n\nwhere $\\dfrac{\\partial (x, y)}{\\partial (u, v)}$ is the Jacobian determinant corresponding to $\\mathbf T.$  \n\nNote that the changes of variables\n\n$$\nu = \\dfrac{y^2}{x}, \\qquad v= xy\n$$\n\n \n\ngives us the *inverse* function $\\mathbf T^{-1},$ that is\n\n$$\n\\mathbf{T}^{-1}:{\\left[ \\begin{array}{c}x \\\\ y\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}u ( x , y ) \\\\ v ( x , y )\\end{array} \\right]}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $\\Delta,$ which is the image of $D$ under the action of $\\mathbf{T}^{-1}.$ \n\nWe substitute $u= \\dfrac{y^2}{x}$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & x={y}^{2} & ⟹\\, & \\frac{{y}^{2}}{x}=1 & ⟹\\, & u=1 \\\\  & x=\\frac{{y}^{2}}{3} & ⟹\\, & \\frac{{y}^{2}}{x}=3 & ⟹\\, & u=3\\end{aligned}\n$$\n\nAnd we substitute $v = xy$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & y=\\frac{2}{x} & ⟹\\, & xy=2 & ⟹\\, & v=2 \\\\  & y=\\frac{4}{x} & ⟹\\, & xy=4 & ⟹\\, & v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\n\\Delta = \\big\\{ (u,v) \\: : \\: 1 \\leq u \\leq 3, \\quad 2 \\leq v \\leq 4\\big\\}\n$$\n\n![](images/12/1207d8cdb8afd7c55d712caca043edfe9f0d0395343a6cbd329cf5861ec3bce7.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to $\\mathbf T^{-1}.$\n\nThe Jacobian determinant corresponding to $\\mathbf T^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\frac{{y}^{2}}{{x}^{2}} & \\frac{2y}{x} \\\\ y & \\text{ }\\text{ }x\\end{vmatrix} \\\\  & =-\\frac{3{y}^{2}}{x}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $\\mathbf T.$\n\nThe Jacobian determinant corresponding to $\\mathbf T$ is\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)} = \\left( \\dfrac{\\partial (u, v)}{\\partial (x, y)} \\right)^{-1} = -\\dfrac{x}{3y^2} = -\\dfrac{1}{3u}.\n$$\n\nNote that $\\dfrac{\\partial (x, y)}{\\partial (u, v)} \\neq 0$ everywhere inside $\\Delta.$  In other words, $\\mathbf T$ has no critical points inside $\\Delta.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3u}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}{\\int }_{2}^{4}\\frac{1}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}\\frac{1}{u}\\,\\text{d}u{\\int }_{2}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡1)\\cdot (4-2) \\\\  & =\\frac{2}{3}\\operatorname{ln}⁡3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186128837 :question/id #uuid "acd76e31-5c7e-5577-a402-f003b3c2e1bc" :question/math-academy-id "e-11154" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves.\n\n$$\ne^y = \\dfrac{5}{e^x}, \\qquad e^y=\\dfrac{10}{e^x}, \\qquad e^x=e^y, \\qquad e^x=2e^y\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n\\iint\\limits_{D} \\mathrm d x \\mathrm d y.\n$$\n\nLet's define a transformation $\\mathbf T$ as follows: \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v ) \\\\ y ( u , v )\\end{array} \\right]}\n$$\n\nWe'll assume this transformation maps some region $\\Delta$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n\\iint\\limits_{D} \\mathrm d x \\mathrm d y = \\iint\\limits_{\\Delta} \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right|  \\ \\mathrm d u \\mathrm d v,\n$$\n\n  \n\nwhere $\\dfrac{\\partial (x, y)}{\\partial (u, v)}$ is the Jacobian determinant corresponding to $\\mathbf T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\ne^{x+y} = 5, \\qquad e^{x+y}=10, \\qquad e^{x-y} = 1, \\qquad e^{x-y} = 2\n$$\n\nThis suggests the following change of variables:\n\n$$\nu = e^{x+y}, \\qquad v = e^{x-y}\n$$\n\nThis change of variables gives us the *inverse* function $\\mathbf T^{-1},$ that is\n\n$$\n\\mathbf{T}^{-1}:{\\left[ \\begin{array}{c}x \\\\ y\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}u ( x , y ) \\\\ v ( x , y )\\end{array} \\right]}.\n$$\n\n**Step 2**: Find $\\Delta,$ which is the image of $D$ under the action of $\\mathbf{T}^{-1}.$ \n\nWe substitute $u=e^{x+y}$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & {e}^{x+y}=5\\,⟹\\,u=5 \\\\  & {e}^{x+y}=10\\,⟹\\,u=10\\end{aligned}\n$$\n\nAnd we substitute $v =e^{x-y}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & {e}^{x-y}=1\\,⟹\\,v=1 \\\\  & {e}^{x-y}=2\\,⟹\\,v=2\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\n\\Delta = \\big\\{ (u,v) \\: : \\: 5 \\leq u \\leq 10, \\quad 1 \\leq v \\leq 2\\big\\}\n$$\n\n![](images/10/105745a82e8f67b086f526b0166e3b442d3eaf02e4df69314ed9d3ffd5fca071.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to $\\mathbf T^{-1}.$\n\nThe Jacobian determinant corresponding to $\\mathbf T^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{e}^{x+y} & {e}^{x+y} \\\\ {e}^{x-y} & -{e}^{x-y}\\end{vmatrix} \\\\  & =-{e}^{2x}-{e}^{2x} \\\\  & =-2{e}^{2x}.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $\\mathbf T.$\n\nThe Jacobian determinant corresponding to $\\mathbf T$ is\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)} = \\left( \\dfrac{\\partial (u, v)}{\\partial (x, y)} \\right)^{-1} =  -\\dfrac{1}{2}e^{-2x}=-\\dfrac{1}{2uv}.\n$$\n\nNote that $\\dfrac{\\partial (u, v)}{\\partial (x, y)}\\neq 0$ everywhere inside $\\Delta.$  In other words, $\\mathbf T$ has no critical points inside $\\Delta.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{2uv}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{∬}_{Δ}\\frac{1}{uv}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{5}^{10}\\frac{1}{u}\\,\\text{d}u{\\int }_{1}^{2}\\frac{1}{v}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot (\\operatorname{ln}⁡10-\\operatorname{ln}⁡5)\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =\\frac{1}{2}(\\operatorname{ln}⁡2)^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186128838 :question/id #uuid "eec994b4-82ac-568c-b493-dc9a21102c2d" :question/math-academy-id "e-11156" :question/problem "For the transformation $\\mathbf{T},$ defined as\n\n$$\n\\mathbf{T}: {\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \n\\longrightarrow \n{\\left[ \\begin{array}{c}2 v \\cos   u \\\\ v \\sin   u\\end{array} \\right]}\n$$\n\ncompute the value of the Jacobian determinant at the point where $$\n\\displaystyle {\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} =  {\\left[ \\begin{array}{c}0 \\\\ - 1\\end{array} \\right]}.\n$$" :question/worked-solution "Given a transformation \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v ) \\\\ y ( u , v )\\end{array} \\right]},\n$$\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y)}{\\partial (u, v)} ,$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x(u,v) = 2v\\cos{u}$ and $y(u,v) = v\\sin{u}.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =-2v\\operatorname{sin}⁡u & \\,\\frac{∂x}{∂v} & =2\\operatorname{cos}⁡u \\\\ \\frac{∂y}{∂u} & =v\\operatorname{cos}⁡u & \\,\\frac{∂y}{∂v} & =\\operatorname{sin}⁡u\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2v\\operatorname{sin}⁡u & 2\\operatorname{cos}⁡u \\\\ v\\operatorname{cos}⁡u & \\operatorname{sin}⁡u\\end{vmatrix} \\\\  & =-2v\\operatorname{sin}⁡u\\cdot \\operatorname{sin}⁡u-2\\operatorname{cos}⁡u\\cdot v\\operatorname{cos}⁡u \\\\  & =-2v({sin}^{2}⁡u+{cos}^{2}⁡u) \\\\  & =-2v.\\end{aligned}\n$$\n\nFinally, when $$\n\\displaystyle {\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]}  = {\\left[ \\begin{array}{c}0 \\\\ - 1\\end{array} \\right]},\n$$ the value of our Jacobian determinant is\n\n$$\n\\left.\\dfrac{\\partial (x, y)}{\\partial (u, v)}\\right|_{(0,-1)} = -2(-1) = 2.\n$$"}] [{:db/id #edb/ref 17592186128846 :question/id #uuid "b22d04e0-8c6a-507a-9d76-ab05adb32b10" :question/math-academy-id "e-11517" :question/problem "Consider the transformation $\\mathbf{T}:(u,v,w) \\to (x(u,v,w),y(u,v,w),z(u,v,w)).$ The inverse transformation $\\mathbf T^{-1}(x,y,z)\\to(u(x,y,z), v(x,y,z), w(x,y,z))$ is given by\n$$\n\\mathbf{T}^{-1}: {\\left[ \\begin{array}{c}x \\\\ y \\\\ z\\end{array} \\right]} \n\\longrightarrow \n{\\left[ \\begin{array}{c}{x}^{2} \\\\ x y \\\\ y z\\end{array} \\right]}.\n$$\n\nFind the Jacobian determinant of $\\mathbf T.$\n\n*Hint: You can assume that $x>0$, $y \\ne 0.$*" :question/worked-solution "For a transformation \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v \\\\ w\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v , w ) \\\\ y ( u , v , w ) \\\\ z ( u , v , w )\\end{array} \\right]},\n$$\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given $\\mathbf T^{-1}.$ So, we compute the Jacobian determinant of $\\mathbf T$ as follows:\n\n- First, we compute $\\dfrac{\\partial (u, v, w)}{\\partial (x, y, z)},$ the Jacobian determinant of $\\mathbf T^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $\\mathbf T$ using the relation\n\n$$\n\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} = \\left( \\dfrac{\\partial (u, v, w)}{\\partial (x, y, z)} \\right)^{-1}.\n$$\n\nHere, we have \n\n$$\nu(x,y,z) = x^2, \\qquad \nv(x,y,z) = xy, \\qquad\nw(x,y,z) = yz.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =2x & \\,\\frac{∂u}{∂y} & =0 & \\,\\frac{∂u}{∂z} & =0 \\\\ \\frac{∂v}{∂x} & =y & \\,\\frac{∂v}{∂y} & =x & \\,\\frac{∂v}{∂z} & =0 \\\\ \\frac{∂w}{∂x} & =0 & \\,\\frac{∂w}{∂y} & =z & \\,\\frac{∂w}{∂z} & =y\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant of $\\mathbf{T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2x & 0 & 0 \\\\ y & x & 0 \\\\ 0 & z & y\\end{vmatrix} \\\\  & =2x\\begin{vmatrix}x & 0 \\\\ z & y\\end{vmatrix} \\\\  & =2x(xy-0) \\\\  & =2{x}^{2}y.\\end{aligned}\n$$\n\nWriting down $\\dfrac{\\partial (u, v, w)}{\\partial (x, y, z)}$ in terms of $u,$ $v,$ and $w,$ we obtain\n\n$$\n\\begin{aligned}2{x}^{2}y & =2\\cdot x\\cdot (xy) \\\\  & =2\\cdot \\sqrt{u}\\cdot v \\\\  & =2v\\sqrt{u}.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & ={\\left(\\frac{∂(u,v,w)}{∂(x,y,z)}\\right)}^{-1} \\\\  & =\\frac{1}{2v\\sqrt{u}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186128847 :question/id #uuid "b16845a2-5f66-524a-90ea-37f8a8186f8f" :question/math-academy-id "e-11518" :question/problem "Find the locations of all of the critical points of the transformation $\\mathbf{T},$ where $\\mathbf T$ is defined as\n\n$$\n\\mathbf T: {\\left[ \\begin{array}{c}u \\\\ v \\\\ w\\end{array} \\right]} \n\\longrightarrow \n{\\left[ \\begin{array}{c}w - {u}^{3} \\\\ 2 u v \\\\ {u}^{2} + v\\end{array} \\right]}.\n$$" :question/worked-solution "For a transformation \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v \\\\ w\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v , w ) \\\\ y ( u , v , w ) \\\\ z ( u , v , w )\\end{array} \\right]},\n$$\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w) =w-u^3, \\qquad \ny(u,v,w) = 2uv, \\qquad\nz(u,v,w) = u^2+v.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =-3{u}^{2} & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =1 \\\\ \\frac{∂y}{∂u} & =2v & \\,\\frac{∂y}{∂v} & =2u & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =2u & \\,\\frac{∂z}{∂v} & =1 & \\,\\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}-3{u}^{2} & 0 & 1 \\\\ 2v & 2u & 0 \\\\ 2u & 1 & 0\\end{vmatrix} \\\\  & =-3{u}^{2}\\begin{vmatrix}2u & 0 \\\\ 1 & 0\\end{vmatrix}+1\\begin{vmatrix}2v & 2u \\\\ 2u & 1\\end{vmatrix} \\\\  & =-3{u}^{2}(0-0)+1(2v-4{u}^{2}) \\\\  & =2(v-2{u}^{2}).\\end{aligned}\n$$\n\nThe function has critical points when $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} =0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ 2(v-2{u}^{2}) & =0 \\\\ v-2{u}^{2} & =0.\\end{aligned}\n$$\n\nThe equation $v-2u^2 = 0$ defines the parabolic cylinder $v=2u^2.$"}] [{:db/id #edb/ref 17592186128848 :question/id #uuid "66d757d2-f2ad-5f0d-b4f1-8d426f4c8351" :question/math-academy-id "e-11579" :question/problem "Find the Jacobian determinant of the transformation $\\mathbf{T}$ that maps the Cartesian $uvw$-space onto the Cartesian $xyz$-space by means of the equations\n\n$$\nx = 2u-v,\\qquad\ny = u+3v+w,\\qquad\nz = u+2v-w.\n$$" :question/worked-solution "For a transformation \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v \\\\ w\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v , w ) \\\\ y ( u , v , w ) \\\\ z ( u , v , w )\\end{array} \\right]},\n$$\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} ,$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2 & \\,\\frac{∂x}{∂v} & =-1 & \\,\\frac{∂x}{∂w} & =0 \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =3 & \\,\\frac{∂y}{∂w} & =1 \\\\ \\frac{∂z}{∂u} & =1 & \\,\\frac{∂z}{∂v} & =2 & \\,\\frac{∂z}{∂w} & =-1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}2 & -1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & 2 & -1\\end{vmatrix} \\\\  & =2\\begin{vmatrix}3 & 1 \\\\ 2 & -1\\end{vmatrix}-(-1)\\cdot \\begin{vmatrix}1 & 1 \\\\ 1 & -1\\end{vmatrix} \\\\  & =2(-3-2)+(-1-1) \\\\  & =-10-2 \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186128860 :question/id #uuid "32f92fce-b4b9-5e7a-9fe0-255b15edf312" :question/math-academy-id "e-12417" :question/problem "Consider a small rectangle $\\Delta$ whose bottom-left corner is located at the point $(-1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta{A}.$ Find an approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf T,$ given by\n$$\n\\mathbf{T}: \n{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \n\\longrightarrow \n{\\left[ \\begin{array}{c}u {v}^{3} \\\\ {u}^{2} + {v}^{2}\\end{array} \\right]}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\textrm{Area}\\big(\\mathbf{T}(\\Delta)\\big) \\approx \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right| \\cdot \\underbrace{\\textrm{Area}(\\Delta)}_{\\large \\delta{A}}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{v}^{3} & 3u{v}^{2} \\\\ 2u & 2v\\end{vmatrix} \\\\  & ={v}^{3}\\cdot 2v-3u{v}^{2}\\cdot 2u \\\\  & =2{v}^{4}-6{u}^{2}{v}^{2} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(-1,2)} & =(2{v}^{4}-6{u}^{2}{v}^{2})\\,{|}_{u=-1\\,v=2} \\\\  & =2(2)^{4}-6(-1)^{2}(2)^{2} \\\\  & =32-24 \\\\  & =8\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|8|\\cdot \\delta A \\\\  & =8\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186128861 :question/id #uuid "6102567f-7035-5fa2-b12e-80a0470de4a3" :question/math-academy-id "e-12418" :question/problem "Sketch the region in the $uv$-plane where the transformation $\\mathbf{T},$ given by \n$$\n\\mathbf{T}: \n{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \n\\longrightarrow \n{\\left[ \\begin{array}{c}u {e}^{v} \\\\ {u}^{2} - {v}^{2}\\end{array} \\right]},\n$$\nis (locally) orientation-reversing." :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)}  <    0\n$$\n\nWe have\n\n$$\n\\mathbf{T}: \n{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \n\\longrightarrow \n{\\left[ \\begin{array}{c}u {e}^{v} \\\\ {u}^{2} - {v}^{2}\\end{array} \\right]}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{e}^{v} & u{e}^{v} \\\\ 2u & -2v\\end{vmatrix} \\\\  & ={e}^{v}\\cdot (-2v)-u{e}^{v}\\cdot 2u \\\\  & =-2{e}^{v}({u}^{2}+v).\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-2{e}^{v}({u}^{2}+v) & <0 \\\\ {u}^{2}+v & >0 \\\\ v & >-{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=-u^2\n$$\n\ndefines a downward-opening parabola, and the coordinates of, say, $(1,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/2b/2b6128c5a1737e3ad1fd82f91f5ccd320421ad3472ae8152440034ecea10d364.png)"}] [{:db/id #edb/ref 17592186129006 :question/id #uuid "28562339-0fe0-5d56-8767-2ec0834525d9" :question/math-academy-id "e-6810" :question/problem "Find the Jacobian determinant of the transformation $\\mathbf{T},$ defined as\n\n$$\n\\mathbf{T}: {\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \n\\longrightarrow  {\\left[ \\begin{array}{c}( u + v {)}^{3} \\\\ ( u - v {)}^{2}\\end{array} \\right]}.\n$$" :question/worked-solution "Given a transformation \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v ) \\\\ y ( u , v )\\end{array} \\right]},\n$$\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y)}{\\partial (u, v)} ,$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x=(u+v)^3$ and $y=(u-v)^2.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =3(u+v)^{2} & \\,\\frac{∂x}{∂v} & =3(u+v)^{2} \\\\ \\frac{∂y}{∂u} & =2(u-v) & \\,\\frac{∂y}{∂v} & =-2(u-v)\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}3(u+v)^{2} & 3(u+v)^{2} \\\\ 2(u-v) & -2(u-v)\\end{vmatrix} \\\\  & =3(u+v)^{2}\\cdot (-2(u-v))-3(u+v)^{2}\\cdot 2(u-v) \\\\  & =-12(u+v)^{2}(u-v).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129015 :question/id #uuid "9de92581-00d5-5343-90be-3b5527bfab49" :question/math-academy-id "e-7283" :question/problem "Using the change of variables \n\n$$\nu =3x-2y, \\quad v=x+y,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $(3x-2y)^2 - y - x = 0$ and the line $x+y=4.$" :question/worked-solution "The area of the required region is given by\n\n$$\n\\iint\\limits_{D} \\mathrm d x \\mathrm d y.\n$$\n\nLet's define a transformation $\\mathbf T$ as follows: \n\n$$\n\\mathbf{T}:{\\left[ \\begin{array}{c}u \\\\ v\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}x ( u , v ) \\\\ y ( u , v )\\end{array} \\right]}\n$$\n\nThis transformation maps some region $\\Delta$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n\\iint\\limits_{D} \\mathrm d x \\mathrm d y = \\iint\\limits_{\\Delta} \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right|  \\ \\mathrm d u \\mathrm d v\n$$\n\nwhere $\\dfrac{\\partial (x, y)}{\\partial (u, v)}$ is the Jacobian determinant corresponding to $\\mathbf T.$  \n\nNote that the changes of variables\n\n$$\nu = 3x-2y, \\qquad v=x+y\n$$\n\n \n\ngives us the *inverse* function $\\mathbf T^{-1},$ that is\n\n$$\n\\mathbf{T}^{-1}:{\\left[ \\begin{array}{c}x \\\\ y\\end{array} \\right]} \\to {\\left[ \\begin{array}{c}u ( x , y ) \\\\ v ( x , y )\\end{array} \\right]}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $\\Delta,$ which is the image of $D$ under the action of $\\mathbf{T}^{-1}.$ \n\nSubstituting $3x-2y = u$ and $x+y = v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(3x-2y)^{2}-y-x=0\\,⟹\\,{u}^{2}-v=0\\,⟹\\,v={u}^{2},\\end{aligned}\n$$\n\nwhile substituting $x + y = v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}y+x=4\\,⟹\\,v=4.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v &={u}^{2} \\\\ v &=4\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}u &=\\pm 2 \\\\ v &=4.\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 2, 4).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\n\\Delta = \\big\\{ (u,v) \\: : \\: -2 \\leq u \\leq 2, \\, u^2 \\leq v \\leq 4\\big\\},\n$$\n\nas shown below.\n\n![](images/0a/0a3d0211dfbe18e5737b62e8b61cf9308af2735ef827d14bae7b5dbfffaa4faa.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to $\\mathbf T^{-1}{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -2 \\\\ 1 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =5.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $\\mathbf T{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T$ is\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)} = \\left( \\dfrac{\\partial (u, v)}{\\partial (x, y)} \\right)^{-1} = (5)^{-1} = \\dfrac 15.\n$$\n\nNote that $\\dfrac{\\partial (x, y)}{\\partial (u, v)} \\neq 0$ everywhere inside $\\Delta.$  In other words, $\\mathbf T$ has no critical points inside $\\Delta.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{1}{5}\\text{d}u\\text{d}v \\\\  & =\\frac{1}{5}{\\int }_{-2}^{2}[{\\int }_{{u}^{2}}^{4}\\,dv]du \\\\  & =\\frac{1}{5}{\\int }_{-2}^{2}[v]_{{u}^{2}}^{4}\\,du \\\\  & =\\frac{1}{5}{\\int }_{-2}^{2}(4-{u}^{2})\\,du \\\\  & =\\frac{1}{5}\\cdot 2{\\int }_{0}^{2}(4-{u}^{2})\\,du \\\\  & =\\frac{2}{5}{[4u-\\frac{{u}^{3}}{3}]}_{0}^{2} \\\\  & =\\frac{2}{5}(8-\\frac{8}{3}) \\\\  & =\\frac{2}{5}\\left(\\frac{16}{3}\\right) \\\\  & =\\frac{32}{15}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061056bc-bfce-5ff4-8595-a2d484ecafcd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png" :db/id #edb/ref 17592186275531} {:answer/id #uuid "16f3a484-24df-5d26-8a99-6de6aa5fdb49" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/15/154f70201a5a00737d8df61952f5600ff91a2373df07b0b54680fe84e048402c.png" :db/id #edb/ref 17592186275690} {:answer/id #uuid "5d63b3ec-601c-5feb-8242-cbcc9d6062a7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186276310} {:answer/id #uuid "9cb5eb91-0daf-521c-91f4-9877e03fe3e3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186276885} {:answer/id #uuid "ff869b8f-3276-5ccb-a221-37224323880c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186277723}] :answer-field/correct {:db/id #edb/ref 17592186275531} :answer-field/id #uuid "cd317045-c8ee-5fc6-a8f1-218f77e90e7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278085}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f5ab6f10-630f-5f61-bd52-33e1fa95452d" :question/math-academy-id "q-160341" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{2}-2{v}^{2} \\\\ u-v\\end{bmatrix},\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{2}-2{v}^{2} \\\\ u-v\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2u & -4v \\\\ 1 & -1\\end{vmatrix} \\\\  & =2u\\cdot (-1)-(-4v)\\cdot 1 \\\\  & =-2u+4v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-2u+4v & <0 \\\\ 4v & <2u \\\\ v & <\\frac{1}{2}u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=\\frac{1}{2}u\n$$\n\ndefines a straight line, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png)"}] [{:db/id #edb/ref 17592186129504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c2703af-9466-5bfe-b4be-6b83ac22c669" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186126525} {:answer/id #uuid "cf58a05e-6426-5bb8-8231-daefdfe1b35a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186126526} {:answer/id #uuid "e030ad9f-a5b5-582f-939f-64d484910356" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186126527} {:answer/id #uuid "3310ee92-258d-50a0-8117-218100854be9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186126528} {:answer/id #uuid "3a3f2756-8915-5175-ae43-ff1f5dcb79fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186126529}] :answer-field/correct {:db/id #edb/ref 17592186126526} :answer-field/id #uuid "ace18637-bd27-5171-b992-40bdb4d2ac91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186126524}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "297a0864-bd1f-5e14-96f0-53d43c9309da" :question/math-academy-id "q-160365" :question/problem "Using the change of variables \n\n$$\nu=y-2x,\\,v=y+x,\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the lines\n\n$$\ny=2x-1,\\,y=2x+1,\\,y=1-x,\\,y=2-x.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=y-2x,\\,v=y+x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=y-2x$ into the equations of the first and second lines:\n\n$$\n\\begin{aligned} & y=2x-1 & ⟹\\, & y-2x=-1 & ⟹\\, & u=-1 \\\\  & y=2x+1 & ⟹\\, & y-2x=1 & ⟹\\, & u=1\\end{aligned}\n$$\n\nAnd we substitute $v=y+x$ into the equations of the third and fourth lines:\n\n$$\n\\begin{aligned} & y=1-x & ⟹\\, & y+x=1 & ⟹\\, & v=1 \\\\  & y=2-x & ⟹\\, & y+x=2 & ⟹\\, & v=2\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,1\\le v\\le 2\\}\n$$\n\n![](images/21/2116f558e3712a08c13d49238054336dcb60efc7d9602bed220be8115d392be7.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ 1 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}\\cdot \\text{Area}(Δ) \\\\  & =\\frac{1}{3}\\cdot 2\\cdot 1 \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ff3e8eb-7902-58a5-868e-63835438a0a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\ln 3" :db/id #edb/ref 17592186126531} {:answer/id #uuid "93d7d291-7c2d-5519-b040-7f86626378b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 2" :db/id #edb/ref 17592186126532} {:answer/id #uuid "e00d9ba3-0616-526a-918f-f048ec3ad32e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln 2" :db/id #edb/ref 17592186126533} {:answer/id #uuid "e22b2d72-5d69-5a7c-b99b-a96070394e77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\ln 2" :db/id #edb/ref 17592186126534} {:answer/id #uuid "04aac39f-4ad5-591b-8475-0d18f4471535" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln 3" :db/id #edb/ref 17592186126535}] :answer-field/id #uuid "57c4cb66-dacd-5670-bc66-deebb81b0535" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186126530}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d109551f-ec24-59b5-88d1-83b6f9c3f33e" :question/math-academy-id "q-160373" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n$$\n\\displaystyle y = \\frac{1}{x}, y = \\frac{2}{x}, y = x, y = 2x\n$$"}] [{:db/id #edb/ref 17592186129506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2aafe7e-6c91-5d6d-8464-7dba52b30e74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\ln 2" :db/id #edb/ref 17592186126537} {:answer/id #uuid "bcd35985-e84f-5813-8588-98b9055133fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\ln 2" :db/id #edb/ref 17592186126538} {:answer/id #uuid "d2697d0b-ab20-5ad0-9fbf-426d7b8ac704" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 4" :db/id #edb/ref 17592186126539} {:answer/id #uuid "0d245dc4-6278-59dd-ac0e-565b7ead760b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 2" :db/id #edb/ref 17592186126540} {:answer/id #uuid "45b03faf-db45-58e5-91f3-c3f8035ce775" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln 2" :db/id #edb/ref 17592186126541}] :answer-field/id #uuid "6c5dc97d-8128-54b5-935f-d17d396d9b2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186126536}] :question/id #uuid "af55d298-694f-59ec-ab70-d9760a4b8e8c" :question/math-academy-id "q-160379" :question/problem "Using the change of variables\n\n$$\n\\displaystyle u = \\frac{y}{x^{2}}, v = xy,\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the curves\n$$\n\\displaystyle y = x^{2}, y = 2x^{2}, y = \\frac{1}{x}, y = \\frac{4}{x}.\n$$"}]}
