              ":question/id": "571f96ea-2c3c-55e6-b776-9009301d8d9e",
              ":question/math-academy-id": "e-4778",
              ":question/problem": "Express $\\sqrt{\\dfrac{2}{7}}$ as the quotient of two radicals.",
              ":question/worked-solution": "Applying the quotient rule, we have\n\n$$\n\\sqrt{\\dfrac{2}{7}}=\\dfrac{\\sqrt{2}}{\\sqrt{7}} .\n$$"
            },
            ":knowledge-point/id": "638d891b-f2c9-505e-99a6-9c15fbf6df5a",
            ":knowledge-point/title": "Separating a Square Root Into a Quotient of Two Square Roots"
          },
          {
            ":db/id": 17592186138395,
            ":knowledge-point/canonical-example": {
              ":db/id": 17592186138300,
              ":question/id": "96cf1739-aa80-574d-900e-3ff75517cfe9",
              ":question/math-academy-id": "e-4779",
              ":question/problem": "Express $\\dfrac{\\sqrt{12}}{\\sqrt{3}}$ as a single radical.",
              ":question/worked-solution": "Using the quotient rule, we have\n\n$$\n\\dfrac{\\sqrt{12}}{\\sqrt{3}} = \\sqrt{\\dfrac{12}{3}}= \\sqrt{4} = 2 .\n$$"
            },
            ":knowledge-point/id": "afa8c578-f074-5c70-a6d8-7ad3fb059961",
            ":knowledge-point/title": "Writing a Quotient of Two Square Roots as a Single Square Root"
          },
          {
            ":db/id": 17592186138396,
            ":knowledge-point/canonical-example": {
              ":db/id": 17592186138301,
              ":question/id": "f0bfcf6d-08a2-5dc4-b66c-814445c05e76",
              ":question/math-academy-id": "e-4780",
              ":question/problem": "Express $\\dfrac{\\sqrt[3]{3}}{\\sqrt[3]{4}}$ as a single radical.",
              ":question/worked-solution": "Applying the quotient rule, we have\n\n$$\n\\dfrac{\\sqrt[3]{3}}{\\sqrt[3]{4}} = \\sqrt[3] {\\dfrac{3}{4}} .\n$$"
            },
            ":knowledge-point/id": "6d8f0211-cd1a-5a01-9422-2e3e475599ed",
            ":knowledge-point/title": "The Quotient Rule With Cube Roots"
          }
