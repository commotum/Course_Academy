2186045498} :answer/value "\\mathbf F(x,y,z)=-\\mathbf j" :db/id #edb/ref 17592186685393} {:answer/id #uuid "6bdba0f9-4d90-55d7-a571-622820e4854a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbf K(x,y,z)=-\\mathbf i" :db/id #edb/ref 17592186685395} {:answer/id #uuid "dc88010f-b4e9-512a-a045-9c4864346a73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbf G(x,y,z)=\\mathbf i" :db/id #edb/ref 17592186685406}] :answer-field/correct {:db/id #edb/ref 17592186685393} :answer-field/id #uuid "a6e70ff7-2292-52d3-ac20-1ec61cb2f177" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186685401}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bf269ace-8580-5e37-90c9-86f9d6c8170a" :question/problem "![](images/c3/c324583aba5224e8c2ba9b2dc75c8836fd0e267c80a3f4119f7c67536d92bfe4.png)\n\nCompare the arrows with the positive directions of the labeled axes. All listed formulas are constant vector fields. Which of the following could generate the field shown?\n\nArrow lengths use a common display scale; no numerical magnitude is specified." :question/worked-solution "The arrows are parallel to the $y$-axis and point in its **negative** direction. They have the same nonzero length throughout the diagram. A matching field must therefore have zero components on the other axes and a constant negative $\\mathbf j$ component.\n\n- $\\mathbf G(x,y,z)=\\mathbf i$ has a nonzero component on another axis, so its arrows have the wrong direction.\n- $\\mathbf H(x,y,z)=-\\mathbf k$ has a nonzero component on another axis, so its arrows have the wrong direction.\n- $\\mathbf K(x,y,z)=-\\mathbf i$ has a nonzero component on another axis, so its arrows have the wrong direction.\n- $\\mathbf F(x,y,z)=-\\mathbf j$ is constant and has the observed axis and direction, so it fits.\n\nTherefore $\\mathbf F(x,y,z)=-\\mathbf j$ could generate the field."}] [{:db/id #edb/ref 17592186693797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "120393bd-f6bf-542f-bd4b-48617262d79a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac\\pi4" :db/id #edb/ref 17592186693794} {:answer/id #uuid "46d27e52-8ebd-535d-8c75-390088ae0270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac\\pi2" :db/id #edb/ref 17592186693798} {:answer/id #uuid "62c64977-ec46-5dd5-a2ce-6727bb70c073" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac\\pi4+\\frac14" :db/id #edb/ref 17592186693800} {:answer/id #uuid "bbfeac0e-3f32-58e4-a809-2218e78e0a9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac\\pi4" :db/id #edb/ref 17592186693804} {:answer/id #uuid "c3eaf698-f423-5b74-bf2b-8e639a46db1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186693805}] :answer-field/correct {:db/id #edb/ref 17592186693804} :answer-field/id #uuid "9d795ae8-d38f-5b1e-9f09-596ad1795065" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693802}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3983ce3c-17a0-527c-b83a-700f3e8a900f" :question/problem "Evaluate the integral.\n\n$$\n\\int_0^{\\pi/2} x\\sin(2x)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Let $I$ denote the given integral. Choose $u=x$ and $v'=\\sin(2x)$, so $u'=1$ and $v=-\\frac12\\cos(2x)$.\n\nSubstitute into the definite integration-by-parts formula:\n\n$$\n\\begin{aligned}\nI\n&=\\left[-\\frac{x\\cos(2x)}2\\right]_0^{\\pi/2}\n+\\frac12\\int_0^{\\pi/2}\\cos(2x)\\,\\mathrm{d}x\\\\\n&=\\left[-\\frac{x\\cos(2x)}2+\\frac{\\sin(2x)}4\\right]_0^{\\pi/2}.\n\\end{aligned}\n$$\n\nNow substitute the upper limit and subtract the value at the lower limit:\n\n$$\n\\begin{aligned}\nI\n&=\\left(-\\frac{\\pi\\cos\\pi}{4}+\\frac{\\sin\\pi}{4}\\right)\n-\\left(0+\\frac{\\sin0}{4}\\right)\\\\\n&=\\frac\\pi4.\n\\end{aligned}\n$$\n\nHere the remaining integral contributes zero; the nonzero boundary term determines the result."}] [{:db/id #edb/ref 17592186693799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14126911-dcb8-5a40-b464-e96163280061" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left[\\frac{x e^{2x}}2\\right]_0^1-\\frac12\\int_0^1e^{2x}\\,\\mathrm{d}x" :db/id #edb/ref 17592186693795} {:answer/id #uuid "27784cd8-1de2-54ed-8ab2-27040e4e82c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left[\\frac{x e^{2x}}2\\right]_0^1-\\int_0^1e^{2x}\\,\\mathrm{d}x" :db/id #edb/ref 17592186693796} {:answer/id #uuid "86cbfb29-9294-5ea7-b122-5eaacf32979d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left[x e^{2x}\\right]_0^1-\\frac12\\int_0^1e^{2x}\\,\\mathrm{d}x" :db/id #edb/ref 17592186693801} {:answer/id #uuid "cf6a3bdf-4fe0-59ac-8471-0b612d7b24ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac12\\int_0^1e^{2x}\\,\\mathrm{d}x" :db/id #edb/ref 17592186693807} {:answer/id #uuid "f7e75cb3-9faf-53b5-baab-c1e3ea09abb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left[\\frac{x e^{2x}}2\\right]_0^1+\\frac12\\int_0^1e^{2x}\\,\\mathrm{d}x" :db/id #edb/ref 17592186693810}] :answer-field/correct {:db/id #edb/ref 17592186693795} :answer-field/id #uuid "f58e8eba-9d31-502e-8334-8918dd161c45" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693809}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "61a5a880-9d8d-5a0d-ae74-48cef90c5ec6" :question/problem "Apply integration by parts once to\n\n$$\n\\int_0^1 x e^{2x}\\,\\mathrm{d}x.\n$$\n\nSelect the correct rewrite with $u=x$ and $v'=e^{2x}$. Leave the remaining integral unevaluated." :question/worked-solution "With $u=x$ and $v'=e^{2x}$, we have $u'=1$ and $v=\\frac12 e^{2x}$. The factor $\\frac12$ is needed because the exponent has derivative $2$.\n\nUse the definite integration-by-parts formula:\n\n$$\n\\int_a^b uv'\\,\\mathrm{d}x=[uv]_a^b-\\int_a^b vu'\\,\\mathrm{d}x.\n$$\n\nSubstituting gives\n\n$$\n\\begin{aligned}\n\\int_0^1 x e^{2x}\\,\\mathrm{d}x\n&=\\left[\\frac{x e^{2x}}2\\right]_0^1-\\int_0^1\\frac{e^{2x}}2\\cdot1\\,\\mathrm{d}x\\\\\n&=\\left[\\frac{x e^{2x}}2\\right]_0^1-\\frac12\\int_0^1e^{2x}\\,\\mathrm{d}x.\n\\end{aligned}\n$$\n\nThe boundary term and the remaining integral both retain the original limits. This is the requested rewrite."}] [{:db/id #edb/ref 17592186693808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a70b874d-eafa-57a5-9685-73abfcb42909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi+2}{8}" :db/id #edb/ref 17592186693803}] :answer-field/correct {:db/id #edb/ref 17592186693803} :answer-field/id #uuid "cdc54588-7661-5d57-a65a-7d30f7b4d76c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186693806}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d6ccd625-6440-5c85-8383-7c7fa5be03c9" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\pi/4}^{\\pi/2} x\\cos(2x)\\,\\mathrm{d}x=\n$$\n\n{{field-1}}" :question/worked-solution "Let $I$ denote the given integral. Choose $u=x$ and $v'=\\cos(2x)$. Then $u'=1$ and $v=\\frac12\\sin(2x)$.\n\nIntegration by parts gives\n\n$$\n\\begin{aligned}\nI\n&=\\left[\\frac{x\\sin(2x)}2\\right]_{\\pi/4}^{\\pi/2}\n-\\frac12\\int_{\\pi/4}^{\\pi/2}\\sin(2x)\\,\\mathrm{d}x\\\\\n&=\\left[\\frac{x\\sin(2x)}2+\\frac{\\cos(2x)}4\\right]_{\\pi/4}^{\\pi/2}.\n\\end{aligned}\n$$\n\nFor $F(x)=\\frac{x\\sin(2x)}2+\\frac{\\cos(2x)}4$, the two endpoint values are\n\n$$\n\\begin{aligned}\nF(\\pi/2)&=\\frac{\\pi\\sin\\pi}{4}+\\frac{\\cos\\pi}{4}=-\\frac14,\\\\\nF(\\pi/4)&=\\frac{\\pi\\sin(\\pi/2)}8+\\frac{\\cos(\\pi/2)}4=\\frac\\pi8.\n\\end{aligned}\n$$\n\nSubtract the entire lower-endpoint value:\n\n$$\n\\begin{aligned}I&=F(\\pi/2)-F(\\pi/4)\\\\&=-\\frac14-\\frac\\pi8\\\\&=-\\frac{\\pi+2}{8}.\\end{aligned}\n$$\n\nBoth endpoints contribute. The negative result also agrees with $x>0$ and $\\cos(2x)<0$ inside the interval."}]}
