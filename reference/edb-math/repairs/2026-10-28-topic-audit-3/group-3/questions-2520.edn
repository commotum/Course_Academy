ac{3 \\pi}{2}.\n$$\n\nThe squared coordinate ratios sum to $\\sin^2 t+\\cos^2 t=1$, so this parametrization lies on the curve. It travels counterclockwise. The endpoints occur at $t=\\frac{\\pi}{2}$ and $t=\\frac{3 \\pi}{2}$; the interval covers the specified portion once.\n\nThe signed differential factor is\n\n$$\ny\\prime(t)=\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(4 \\sin{t}\\right)=4 \\cos{t}.\n$$\n\nSubstituting both coordinates into the given function gives\n\n$$\n\\begin{aligned}f(x(t),y(t))&=\\left.\\left(x^{2} + y^{2}\\right)\\right|_{x=\\cos{t},\\,y=4 \\sin{t}}\\\\&=16 \\sin^{2}{t} + \\cos^{2}{t}.\\end{aligned}\n$$\n\nTherefore, retaining the signed derivative,\n\n$$\n\\begin{aligned}&\\int_C f(x,y)\\,\\mathrm{d}y\\\\&\\quad=4\\int_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}\\left(16 \\sin^{2}{t} + \\cos^{2}{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721970 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The $x$ coordinate scale was lost in the substitution." :answer/id #uuid "5552e63e-21c4-503e-8e37-ff3fbae4227c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\left(2 \\sin{t} \\cos{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721952} {:answer/feedback "This expression uses the specified path, substituted function, and signed $y$ derivative." :answer/id #uuid "a923cf63-cfc3-5479-a5f6-2a3e3c74b440" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\left(4 \\sin{t} \\cos{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721960} {:answer/feedback "The sign of the $y$ coordinate was changed in the substitution." :answer/id #uuid "b620d65f-248b-563f-bbdf-cf017738ea2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\left(- 4 \\sin{t} \\cos{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721963} {:answer/feedback "The factor $y\\prime(t)$ is missing." :answer/id #uuid "c3037665-a03d-5f93-8b54-8e72c7918ce8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\left(4 \\sin{t} \\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721965} {:answer/feedback "The upper limit stops before the required traversal is complete." :answer/id #uuid "cfdc2962-b684-5a73-b3d9-8f508f4f7f5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_{\\pi}^{\\frac{5 \\pi}{4}}\\left(4 \\sin{t} \\cos{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721968}] :answer-field/correct {:db/id #edb/ref 17592186721960} :answer-field/id #uuid "54104850-00c6-5827-bd68-2a87defadba0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721951}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e17b4295-f53b-5e07-96cc-f3ccf50f625d" :question/problem "![Directed path C](images/8c/8c0a1760eb9218ffd6592bedec96f093ccd2e78df7ad1cc03e4b9c2654aa25c6.png)\n\nWhich definite integral is equivalent to\n\n$$\n\\int_C\\left(x y\\right)\\,\\mathrm{d}y\n$$\n\nwhere $C$ is one quarter of the circle $\\frac{x^2}{4}+\\frac{y^2}{4}=1$, directed counterclockwise from $A=(-2,0)$ to $B=(0,-2)$, as shown above? Do not evaluate the integral.\n\n*Hint: Use the parametrization $\\mathbf r(t)=\\langle 2 \\cos{t},\\,2 \\sin{t}\\rangle$.*" :question/worked-solution "For a parametrization following the directed path,\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}y=\\int_a^b f(x(t),y(t))\\,y\\prime(t)\\,\\mathrm{d}t.\n$$\n\nChoose\n\n$$\n\\mathbf r(t)=\\langle 2 \\cos{t},\\,2 \\sin{t}\\rangle,\\qquad \\pi\\le t\\le \\frac{3 \\pi}{2}.\n$$\n\nThe squared coordinate ratios sum to $\\sin^2 t+\\cos^2 t=1$, so this parametrization lies on the curve. It travels counterclockwise. The endpoints occur at $t=\\pi$ and $t=\\frac{3 \\pi}{2}$; the interval covers the specified portion once.\n\nThe signed differential factor is\n\n$$\ny\\prime(t)=\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(2 \\sin{t}\\right)=2 \\cos{t}.\n$$\n\nSubstituting both coordinates into the given function gives\n\n$$\n\\begin{aligned}f(x(t),y(t))&=\\left.\\left(x y\\right)\\right|_{x=2 \\cos{t},\\,y=2 \\sin{t}}\\\\&=4 \\sin{t} \\cos{t}.\\end{aligned}\n$$\n\nTherefore, retaining the signed derivative,\n\n$$\n\\begin{aligned}&\\int_C f(x,y)\\,\\mathrm{d}y\\\\&\\quad=2\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\left(4 \\sin{t} \\cos{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721978 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The signed $y$ derivative has been negated." :answer/id #uuid "15ea3f30-1d70-5e07-a0ab-fd562c28e325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{\\pi}\\left(1 - \\cos^{2}{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721979} {:answer/feedback "The coordinates have been interchanged in the substitution into $f$." :answer/id #uuid "1e4ba360-36cb-5965-874a-d4bcb233cea2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\int_{0}^{\\pi}\\left(1 - \\sin^{2}{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721981} {:answer/feedback "This uses $x\\prime(t)$ in place of $y\\prime(t)$." :answer/id #uuid "2859866f-93c2-57c9-9ee1-997939d7e3af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{\\pi}\\left(1 - \\cos^{2}{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721983} {:answer/feedback "This expression uses the specified path, substituted function, and signed $y$ derivative." :answer/id #uuid "36c1e4f3-6b9b-5b84-a401-51a1f6826341" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\int_{0}^{\\pi}\\left(1 - \\cos^{2}{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721985} {:answer/feedback "The squared coordinate was used to the first power." :answer/id #uuid "8a5e656a-3c0b-57fa-ba74-622aaf63279d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\int_{0}^{\\pi}\\left(1 - \\cos{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721996}] :answer-field/correct {:db/id #edb/ref 17592186721985} :answer-field/id #uuid "ea61576c-2cba-5d0a-ab00-d48375128adc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186722002}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "15a47068-6ad9-5381-a05e-f9230a604dab" :question/problem "![Directed path C](images/31/31342567571e1b920d8b3de05e0a858aee18065190987414799674c4824b26d1.png)\n\nWhich definite integral is equivalent to\n\n$$\n\\int_C\\left(1 - y^{2}\\right)\\,\\mathrm{d}y\n$$\n\nwhere $C$ is one half of the circle $\\frac{x^2}{1}+\\frac{y^2}{1}=1$, directed clockwise from $A=(0,1)$ to $B=(0,-1)$, as shown above? Do not evaluate the integral." :question/worked-solution "For a parametrization following the directed path,\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}y=\\int_a^b f(x(t),y(t))\\,y\\prime(t)\\,\\mathrm{d}t.\n$$\n\nChoose\n\n$$\n\\mathbf r(t)=\\langle \\sin{t},\\,\\cos{t}\\rangle,\\qquad 0\\le t\\le \\pi.\n$$\n\nThe squared coordinate ratios sum to $\\sin^2 t+\\cos^2 t=1$, so this parametrization lies on the curve. It travels clockwise. The endpoints occur at $t=0$ and $t=\\pi$; the interval covers the specified portion once.\n\nThe signed differential factor is\n\n$$\ny\\prime(t)=\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(\\cos{t}\\right)=- \\sin{t}.\n$$\n\nSubstituting both coordinates into the given function gives\n\n$$\n\\begin{aligned}f(x(t),y(t))&=\\left.\\left(1 - y^{2}\\right)\\right|_{x=\\sin{t},\\,y=\\cos{t}}\\\\&=1 - \\cos^{2}{t}.\\end{aligned}\n$$\n\nTherefore, retaining the signed derivative,\n\n$$\n\\begin{aligned}&\\int_C f(x,y)\\,\\mathrm{d}y\\\\&\\quad=-\\int_{0}^{\\pi}\\left(1 - \\cos^{2}{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721993 :question/answer-fields [{:answer-field/choices [{:answer/feedback "This expression uses the specified path, substituted function, and signed $y$ derivative." :answer/id #uuid "0fb0eff4-b997-5d90-94fc-4768e6902426" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\int_{\\frac{3 \\pi}{2}}^{3 \\pi}\\left(27 \\sin^{2}{t} \\cos{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721977} {:answer/feedback "This uses $x\\prime(t)$ in place of $y\\prime(t)$." :answer/id #uuid "34dfce32-caf4-58f1-9acd-45e94dd669f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\int_{\\frac{3 \\pi}{2}}^{3 \\pi}\\left(27 \\sin^{2}{t} \\cos{t}\\right)\\left(\\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721984} {:answer/feedback "The coordinates have been interchanged in the substitution into $f$." :answer/id #uuid "3f2ff8d7-325d-5abd-9e45-dd67dcf4e112" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\int_{\\frac{3 \\pi}{2}}^{3 \\pi}\\left(27 \\sin{t} \\cos^{2}{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721986} {:answer/feedback "The factor $y\\prime(t)$ is missing." :answer/id #uuid "56b08f46-46cd-59fb-a39b-f0314a6a3e86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\frac{3 \\pi}{2}}^{3 \\pi}\\left(27 \\sin^{2}{t} \\cos{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721989} {:answer/feedback "The sign of the $y$ coordinate was changed in the substitution." :answer/id #uuid "7c884f3a-dd25-56ff-987d-3157d75cdc49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\int_{\\frac{3 \\pi}{2}}^{3 \\pi}\\left(- 27 \\sin^{2}{t} \\cos{t}\\right)\\left(\\sin{t}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721994}] :answer-field/correct {:db/id #edb/ref 17592186721977} :answer-field/id #uuid "d67facdb-b22f-5607-bd03-ec8ff7f2c47b" :answer-field/key "selection" :answer-field/ty