 y^{2}\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x y^{2}}$ from the numerator.  These expressions apply where $x - y^{2}\\ne0$."}] [{:db/id #edb/ref 17592186703580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f1733fa-7e29-5db0-afa1-05d743750847" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- x^{2} y^{2} - 2 x y^{4} - 2 x y^{2} - x - y^{6} - 2 y^{4} - 2 y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703585} {:answer/id #uuid "60c6291c-d821-586e-8118-443380929340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} - y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703590} {:answer/id #uuid "934501aa-0ccf-52a3-a17a-7697a60a6329" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} - y^{2}\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703593} {:answer/id #uuid "c162a7b1-3325-5387-b962-fca88d0852b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(x + y^{2}\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703597} {:answer/id #uuid "dd9f76b3-fd50-53eb-9784-1bdbf6e38f73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x y^{2} - 2 y^{4} - 2 y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703599}] :answer-field/correct {:db/id #edb/ref 17592186703590} :answer-field/id #uuid "6a79f399-0de0-5f3a-ad9f-dab2927d7af6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703592}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "22259673-fa26-5ed1-a205-f20f7f26a6f1" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{e^{- x y^{2}}}{x + y^{2} + 1},\n$$\n\nfind $\\frac{\\partial f}{\\partial x}$, where $x + y^{2} + 1\\ne0$." :question/worked-solution "Hold $y$ constant and differentiate with respect to $x$. Write $N=e^{- x y^{2}}$ and $D=x + y^{2} + 1$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{x}&=- y^{2} e^{- x y^{2}}, \\\\\nD_{x}&=1.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $- y^{2}$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}&=\\frac{N_{x}D-ND_{x}}{D^2} \\\\\n&=\\frac{\\left(- y^{2} e^{- x y^{2}}\\right)D-N\\left(1\\right)}{D^2} \\\\\n&=\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} - y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x y^{2}}$ from the numerator.  These expressions apply where $x + y^{2} + 1\\ne0$."}] [{:db/id #edb/ref 17592186703589 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077231f7-eafb-588e-ae80-23ef77302737" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + y^{2} - 2\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703577} {:answer/id #uuid "30416b19-787f-5a3a-9766-2cc6bee0bb12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x y^{2} - 2 y^{4} + 2 y^{2} - 1\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703583} {:answer/id #uuid "3945d4f4-7852-579d-9b5d-44f096659dab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 2 x y - 2 y\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703584} {:answer/id #uuid "57f0557d-8c27-53a7-b931-cdae1d010d33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + y^{2} - 1\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703588} {:answer/id #uuid "65692aa5-76ee-53c5-81e5-a128415f581d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- x^{2} y^{2} - 2 x y^{4} + 2 x y^{2} - x - y^{6} + 2 y^{4} - 2 y^{2} + 1\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703591}] :answer-field/correct {:db/id #edb/ref 17592186703588} :answer-field/id #uuid "c3e2d419-1a4a-5f40-97cd-dfd16be71203" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703598}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "59a46ae3-091e-5d67-b273-6ba33cc756e4" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{e^{- x y^{2}}}{x + y^{2} - 1},\n$$\n\nfind $\\frac{\\partial f}{\\partial x}$, where $x + y^{2} - 1\\ne0$." :question/worked-solution "Hold $y$ constant and differentiate with respect to $x$. Write $N=e^{- x y^{2}}$ and $D=x + y^{2} - 1$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{x}&=- y^{2} e^{- x y^{2}}, \\\\\nD_{x}&=1.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $- y^{2}$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}&=\\frac{N_{x}D-ND_{x}}{D^2} \\\\\n&=\\frac{\\left(- y^{2} e^{- x y^{2}}\\right)D-N\\left(1\\right)}{D^2} \\\\\n&=\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + y^{2} - 1\\right)}{\\left(x + y^{2} - 1\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x y^{2}}$ from the numerator.  These expressions apply where $x + y^{2} - 1\\ne0$."}] [{:db/id #edb/ref 17592186703594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "115edd5a-e36e-5155-b042-47681eb95fd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(4 x^{3} y^{2} + 4 x^{2} y^{4} - 8 x^{2} y^{2} - 2 x^{2} - 2 x y^{2} + 4 x - 2 y\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703578} {:answer/id #uuid "1bf65ecc-d045-5ee4-b5db-f9935cc050ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + 2 y^{2} - 1\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703579} {:answer/id #uuid "26286f54-8520-559f-b1ab-9dfb23f78fa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 4 x y\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703581} {:answer/id #uuid "2982e09b-d12b-5336-8365-ab3ff027e61c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(x + y^{2} - 2 y - 2\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703582} {:answer/id #uuid "fb037ca2-43d9-5b49-93e8-1c7a24d37edb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 4 x y - 2 y\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703603}] :answer-field/correct {:db/id #edb/ref 17592186703603} :answer-field/id #uuid "ed196b42-225c-58c3-8b20-8f4a4d55667e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703600}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a17a2d63-cb15-534d-9625-d8f2f79140f3" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{e^{- x y^{2}}}{x + y^{2} - 2},\n$$\n\nfind $\\frac{\\partial f}{\\partial y}$, where $x + y^{2} - 2\\ne0$." :question/worked-solution "Hold $x$ constant and differentiate with respect to $y$. Write $N=e^{- x y^{2}}$ and $D=x + y^{2} - 2$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{y}&=- 2 x y e^{- x y^{2}}, \\\\\nD_{y}&=2 y.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $- 2 x y$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial y}&=\\frac{N_{y}D-ND_{y}}{D^2} \\\\\n&=\\frac{\\left(- 2 x y e^{- x y^{2}}\\right)D-N\\left(2 y\\right)}{D^2} \\\\\n&=\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 4 x y - 2 y\\right)}{\\left(x + y^{2} - 2\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x y^{2}}$ from the numerator.  These expressions apply where $x + y^{2} - 2\\ne0$."}] [{:db/id #edb/ref 17592186703607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6100ee-2e38-54b1-bec7-b0c0fdfdb028" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{206}{5}" :db/id #edb/ref 17592186703604} {:answer/id #uuid "6a80e3fa-0902-5f8d-b368-7dfee413720e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{86}{5}" :db/id #edb/ref 17592186703609} {:answer/id #uuid "8a8ebaf1-93e5-537c-b32a-1ffc24b347a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186703612} {:answer/id #uuid "9dc061ab-fef5-52cf-a564-35ac8cc0ff30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{26}{5}" :db/id #edb/ref 17592186703616} {:answer/id #uuid "ca07ccf5-afa4-5506-a582-09cc87c0af45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{34}{5}" :db/id #edb/ref 17592186703623}] :answer-field/correct {:db/id #edb/ref 17592186703623} :answer-field/id #uuid "a67a89b0-6c1f-5575-94ef-a3bb684cdbfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703617}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2877e3a9-23cb-5b25-8a95-2664630541d4" :question/problem "For $f(x,y)=\\left(x + \\sqrt{x^{2} + y^{2}}\\right) \\left(x^{2} + y\\right)$, evaluate $f_x(-3,4)$. Assume $(x,y)\\ne(0,0)$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=x^{2} + y,\\quad v=x + \\sqrt{x^{2} + y^{2}}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_x&=2 x\\\\\nv_x&=\\frac{x}{\\sqrt{x^{2} + y^{2}}} + 1\\\\\nr_x&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_x&=C(u_xv+uv_x)+r_x\\\\\n&=2 x \\left(x + \\sqrt{x^{2} + y^{2}}\\right)\\\\\n&\\quad +\\left(\\left(x^{2} + y\\right) \\left(\\frac{x}{\\sqrt{x^{2} + y^{2}}} + 1\\right)\\right)\n\\end{aligned}\n$$\n\nNow substitute $x=-3$ and $y=4$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_x(-3,4)&=\\left(-6\\right)\\left(2\\right)+\\left(13\\right)\\left(\\frac{2}{5}\\right)\\\\\n&=- \\frac{34}{5}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186703608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137b8c64-d1a6-5a32-b98e-7e5a7d038824" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186703605} {:answer/id #uuid "ccdd3231-bccc-5697-9e9f-31cf0609a2b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8 + 4 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186703624} {:answer/id #uuid "d9d60b3a-2be2-5315-b237-6cb8819d1de4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5 - 4 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186703625} {:answer/id #uuid "dcaad5d8-c8af-50d2-bfde-6e86dacb3fd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11 + 4 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186703626} {:answer/id #uuid "e8709986-126a-5acc-aec9-43b469e66405" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-19 + 8 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186703627}] :answer-field/correct {:db/id #edb/ref 17592186703626} :answer-field/id #uuid "70f59d35-07b3-53b3-80d0-3049af314311" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703610}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4b9ec73d-66bc-5a8b-aec7-1c291f9efbdf" :question/problem "For $f(x,y)=\\left(x + y^{2}\\right) \\left(- y + \\ln{\\left(x y \\right)}\\right)$, evaluate $f_y(2,2)$. Assume $x y>0$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=x + y^{2},\\quad v=- y + \\ln{\\left(x y \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_y&=2 y\\\\\nv_y&=-1 + \\frac{1}{y}\\\\\nr_y&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_y&=C(u_yv+uv_y)+r_y\\\\\n&=2 y \\left(- y + \\ln{\\left(x y \\right)}\\right)\\\\\n&\\quad +\\left(\\left(-1 + \\frac{1}{y}\\right) \\left(x + y^{2}\\right)\\right)\n\\end{aligned}\n$$\n\nNow substitute $x=2$ and $y=2$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_y(2,2)&=\\left(4\\right)\\left(-2 + \\ln{\\left(4 \\right)}\\right)+\\left(6\\right)\\left(- \\frac{1}{2}\\right)\\\\\n&=-11 + 4 \\ln{\\left(4 \\right)}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186703621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7da1d774-e17a-5236-bbb7-483959c8bcc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186703611} {:answer/id #uuid "9734e2d6-5ef9-5d46-a744-25c0cd5b2359" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186703614} {:answer/id #uuid "bb25d4b6-1ba7-5334-831d-c54e99b24ed0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186703620} {:answer/id #uuid "fbba24f3-6fc1-5b18-9a9e-fd2e50eb9954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186703630} {:answer/id #uuid "fdb7536f-35eb-566f-9928-5a75378e5fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186703631}] :answer-field/correct {:db/id #edb/ref 17592186703630} :answer-field/id #uuid "19d320e9-9461-5879-ad9b-611d031c37e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703606}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c44ba4b6-f3fb-551a-a608-3169a0e2c54f" :question/problem "For $f(x,y)=\\left(x + \\ln{\\left(x y \\right)}\\right) \\left(x^{2} + y\\right)$, evaluate $f_x(1,1)$. Assume $x y>0$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=x^{2} + y,\\quad v=x + \\ln{\\left(x y \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_x&=2 x\\\\\nv_x&=1 + \\frac{1}{x}\\\\\nr_x&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_x&=C(u_xv+uv_x)+r_x\\\\\n&=2 x \\left(x + \\ln{\\left(x y \\right)}\\right)\\\\\n&\\quad +\\left(\\left(1 + \\frac{1}{x}\\right) \\left(x^{2} + y\\right)\\right)\n\\end{aligned}\n$$\n\nNow substitute $x=1$ and $y=1$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_x(1,1)&=\\left(2\\right)\\left(1\\right)+\\left(2\\right)\\left(2\\right)\\\\\n&=6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186703629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dcad0bd-e62c-5041-a186-cfd7a5198ef2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 \\ln{\\left(2 \\right)} - \\frac{7}{e^{2}} + \\frac{3}{2}" :db/id #edb/ref 17592186703613} {:answer/id #uuid "9a2bb40c-2e77-5375-bb96-e33638784a67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{-2} + \\frac{3}{2} + 4 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186703615} {:answer/id #uuid "a89d2d20-2f51-57c6-84f4-41c7a6949cc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2} - \\frac{3}{e^{2}}" :db/id #edb/ref 17592186703618} {:answer/id #uuid "c77ffcfd-6a77-5a52-b2d3-82b75d88f657" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{e^{2}} + \\frac{3}{2} + 8 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186703622} {:answer/id #uuid "f0680338-2829-5897-ae20-398ba3a3e580" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{e^{2}} + 4 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186703628}] :answer-field/correct {:db/id #edb/ref 17592186703615} :answer-field/id #uuid "ae5ee852-aed6-595b-9ef9-40daa9df2b71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703619}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f446adf0-5ca4-5e51-b5d8-ccc54934d4af" :question/problem "For $f(x,y)=\\left(x^{2} + y\\right) \\left(e^{x y} + \\ln{\\left(x \\right)}\\right)$, evaluate $f_x(2,-1)$. Assume $x>0$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=x^{2} + y,\\quad v=e^{x y} + \\ln{\\left(x \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_x&=2 x\\\\\nv_x&=y e^{x y} + \\frac{1}{x}\\\\\nr_x&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_x&=C(u_xv+uv_x)+r_x\\\\\n&=2 x \\left(e^{x y} + \\ln{\\left(x \\right)}\\right)\\\\\n&\\quad +\\left(\\left(x^{2} + y\\right) \\left(y e^{x y} + \\frac{1}{x}\\right)\\right)\n\\end{aligned}\n$$\n\nNow substitute $x=2$ and $y=-1$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_x(2,-1)&=\\left(4\\right)\\left(e^{-2} + \\ln{\\left(2 \\right)}\\right)+\\left(3\\right)\\left(\\frac{1}{2} - e^{-2}\\right)\\\\\n&=e^{-2} + \\frac{3}{2} + 4 \\ln{\\left(2 \\right)}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186703671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b3b140d-f65c-5629-8dea-05e0052634a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 + 4 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703662} {:answer/id #uuid "2ece8d04-3990-5454-8597-78174a14f76e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{-3} + 4" :db/id #edb/ref 17592186703663} {:answer/id #uuid "317ae13f-244a-58cb-9f3e-6792721b5edf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703664} {:answer/id #uuid "57dce0db-44c1-52b6-9ef2-a5f5a30d4144" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\left(3 + 2 e^{3}\\right)}{1 + e^{3}}" :db/id #edb/ref 17592186703674} {:answer/id #uuid "71dda70b-7a3b-52a6-b4f3-15c4c6191445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 + 5 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703680}] :answer-field/correct {:db/id #edb/ref 17592186703662} :answer-field/id #uuid "3a7a1014-a311-5603-b2cf-a2b4c6713807" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186703669} {:answer-field/choices [{:answer/id #uuid "087c1c73-300a-58e5-878b-1ae9b623e411" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 + 4 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703654} {:answer/id #uuid "52730245-8088-5b41-91b9-dd014ee66179" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703673} {:answer/id #uuid "d19c815c-1306-53aa-9785-8191617b8aba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{1 + e^{3}}" :db/id #edb/ref 17592186703698} {:answer/id #uuid "d70b8694-60f2-544f-aeef-2e0b29bbec8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\left(2 + e^{3}\\right)}{1 + e^{3}}" :db/id #edb/ref 17592186703700} {:answer/id #uuid "fcca41d4-7996-5764-a2b4-3c70d36048ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 - \\frac{4}{e^{3}}" :db/id #edb/ref 17592186703704}] :answer-field/correct {:db/id #edb/ref 17592186703673} :answer-field/id #uuid "ff5808d3-bc93-5620-8225-e7ed82ad17b5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186703705}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4ae6cebf-3ba4-5724-94d9-bf3a094bcebe" :question/problem "For the function\n\n$$\nf(x,y)=x y^{2} + \\ln{\\left(e^{x - y^{2}} + 1 \\right)},\n$$\n\nevaluate both partial derivatives at $(1,2)$.\n\n$f_x(1,2)=$\n\n{{field-1}}\n\n$f_y(1,2)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x - y^{2}\\\\\n\\frac{\\partial u}{\\partial x}&=1\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(x y^{2}\\right)&=y^{2}\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(1\\right)+\\left(y^{2}\\right)\\\\\n&=y^{2} + \\frac{e^{x - y^{2}}}{e^{x - y^{2}} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right) - \\left(2\\right)^{2}=-3.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(1,2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(4\\right)\\\\\n&=\\left(\\frac{1}{\\left(e^{-3} + 1\\right) e^{3}}\\right)\\cdot\\left(1\\right)+\\left(4\\right)\\\\\n&=\\frac{5 + 4 e^{3}}{1 + e^{3}}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x - y^{2}\\\\\n\\frac{\\partial u}{\\partial y}&=- 2 y\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(x y^{2}\\right)&=2 x y\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(- 2 y\\right)+\\left(2 x y\\right)\\\\\n&=2 x y - \\frac{2 y e^{x - y^{2}}}{e^{x - y^{2}} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right) - \\left(2\\right)^{2}=-3.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(1,2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(-4\\right)+\\left(4\\right)\\\\\n&=\\left(\\frac{1}{\\left(e^{-3} + 1\\right) e^{3}}\\right)\\cdot\\left(-4\\right)+\\left(4\\right)\\\\\n&=\\frac{4 e^{3}}{1 + e^{3}}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186703689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23086f7c-6874-552f-94e1-4db3e1882080" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{- 4 e - 3}{1 + e}" :db/id #edb/ref 17592186703659} {:answer/id #uuid "2656c7c3-9b12-5824-9215-6880fa614fed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4 - \\frac{2}{e}" :db/id #edb/ref 17592186703661} {:answer/id #uuid "88bf77b1-800a-5f76-a9f7-54f999516957" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\left(- 2 e - 3\\right)}{1 + e}" :db/id #edb/ref 17592186703685} {:answer/id #uuid "b77841ba-1f00-5c41-a0ac-8f17916aece2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\left(- 3 e - 2\\right)}{1 + e}" :db/id #edb/ref 17592186703693} {:answer/id #uuid "cab791b3-e77b-57b6-81bf-88768e701b21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\left(- 2 e - 1\\right)}{1 + e}" :db/id #edb/ref 17592186703697}] :answer-field/correct {:db/id #edb/ref 17592186703685} :answer-field/id #uuid "25a83270-ab8d-5341-83fa-5e9723e830a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186703660} {:answer-field/choices [{:answer/id #uuid "3275ae56-f62f-53b2-892b-e2ce9bd50f12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1 - e}{1 + e}" :db/id #edb/ref 17592186703665} {:answer/id #uuid "503e4bf6-cb69-5f2e-aefa-599274081308" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{e}{1 + e}" :db/id #edb/ref 17592186703672} {:answer/id #uuid "6eb6edb5-4391-589a-b068-c3faf8970f31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{- e - 2}{1 + e}" :db/id #edb/ref 17592186703678} {:answer/id #uuid "958e1397-8f25-5bb3-a27b-5f70c2dd477f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{1}{1 + e}" :db/id #edb/ref 17592186703686} {:answer/id #uuid "a60858ee-d060-5a44-b064-44cfc6fe40ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1 + e^{-1}" :db/id #edb/ref 17592186703688}] :answer-field/correct {:db/id #edb/ref 17592186703672} :answer-field/id #uuid "c9ee1e83-ed2f-5038-a86e-84826caaa005" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186703696}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "aa0bc855-0104-5a68-bd13-be0c1477a8bb" :question/problem "For the function\n\n$$\nf(x,y)=- x^{2} y + \\ln{\\left(e^{x^{2} + y} + 1 \\right)},\n$$\n\nevaluate both partial derivatives at $(-1,-2)$.\n\n$f_x(-1,-2)=$\n\n{{field-1}}\n\n$f_y(-1,-2)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x^{2} + y\\\\\n\\frac{\\partial u}{\\partial x}&=2 x\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(- x^{2} y\\right)&=- 2 x y\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(2 x\\right)+\\left(- 2 x y\\right)\\\\\n&=- 2 x y + \\frac{2 x e^{x^{2} + y}}{e^{x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=-1$ and $y=-2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(-1\\right)^{2} + \\left(-2\\right)=-1.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(-1,-2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(-2\\right)+\\left(-4\\right)\\\\\n&=\\left(\\frac{1}{e \\left(e^{-1} + 1\\right)}\\right)\\cdot\\left(-2\\right)+\\left(-4\\right)\\\\\n&=\\frac{2 \\left(- 2 e - 3\\right)}{1 + e}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x^{2} + y\\\\\n\\frac{\\partial u}{\\partial y}&=1\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(- x^{2} y\\right)&=- x^{2}\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(1\\right)+\\left(- x^{2}\\right)\\\\\n&=- x^{2} + \\frac{e^{x^{2} + y}}{e^{x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=-1$ and $y=-2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(-1\\right)^{2} + \\left(-2\\right)=-1.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(-1,-2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(-1\\right)\\\\\n&=\\left(\\frac{1}{e \\left(e^{-1} + 1\\right)}\\right)\\cdot\\left(1\\right)+\\left(-1\\right)\\\\\n&=- \\frac{e}{1 + e}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186703690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b32f9f3-45df-54ac-9813-3342fac2db26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\left(- e^{3} - 3\\right)}{1 + e^{3}}" :db/id #edb/ref 17592186703655} {:answer/id #uuid "22d32cb4-8972-55dd-affb-b6c1d949f03a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186703658} {:answer/id #uuid "3be9f4d1-007a-5656-81de-b9cab3303026" :answer/type {:db/id #edb/ref 17592186045498} :answer/valu