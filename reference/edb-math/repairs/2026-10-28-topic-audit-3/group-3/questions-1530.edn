ht)}\\right)(-1)^{3+1}\\begin{vmatrix}- 3 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix}+\\left(- u \\sin{\\left(v \\right)}\\right)(-1)^{3+2}\\begin{vmatrix}- 3 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix} \\\\  & =\\left(- 9 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right)+\\left(- 9 u^{2} \\sin^{3}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right) \\\\  & =\\left(- 9 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)+\\left(- 9 u^{2} \\sin^{3}{\\left(v \\right)}\\right) \\\\  & =- 9 u^{2} \\sin{\\left(v \\right)}\\left(\\cos^2 v+\\sin^2 v\\right) \\\\  & =- 9 u^{2} \\sin{\\left(v \\right)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00621579-98b8-5fc9-8c16-b5eb82de0221" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 u \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538071} {:answer/id #uuid "05b79517-df53-5b79-ac36-4cbcb1efc025" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}" :db/id #edb/ref 17592186538073} {:answer/id #uuid "5241ee4a-85f2-5f97-b688-cf1417ac8cb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 u^{2} \\sin^{3}{\\left(v \\right)}" :db/id #edb/ref 17592186538079} {:answer/id #uuid "69d81a15-f9af-5fb0-bf28-29b987a5cbd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 12 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538083} {:answer/id #uuid "be3bed3d-b68a-5bcb-b8a2-d2d2b35e63ea" :answer/t