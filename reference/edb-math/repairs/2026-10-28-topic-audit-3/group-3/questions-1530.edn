ht)} \\cos{\\left(w \\right)} & \\frac{∂x}{∂w} & =- 4 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ \\frac{∂y}{∂u} & =\\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & \\frac{∂y}{∂v} & =u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & \\frac{∂y}{∂w} & =u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ \\frac{∂z}{∂u} & =- 2 \\cos{\\left(v \\right)} & \\frac{∂z}{∂v} & =2 u \\sin{\\left(v \\right)} & \\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}4 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & 4 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & - 4 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ - 2 \\cos{\\left(v \\right)} & 2 u \\sin{\\left(v \\right)} & 0\\end{vmatrix} \\\\  & =\\left(- 2 \\cos{\\left(v \\right)}\\right)(-1)^{3+1}\\begin{vmatrix}4 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & - 4 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix}+\\left(2 u \\sin{\\left(v \\right)}\\right)(-1)^{3+2}\\begin{vmatrix}4 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & - 4 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix} \\\\  & =\\left(- 8 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right)+\\left(- 8 u^{2} \\sin^{3}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right) \\\\  & =\\left(- 8 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)+\\left(- 8 u^{2} \\sin^{3}{\\left(v \\right)}\\right) \\\\  & =- 8 u^{2} \\sin{\\left(v \\right)}\\left(\\cos^2 v+\\sin^2 v\\right) \\\\  & =- 8 u^{2} \\sin{\\left(v \\right)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cc8b0b-3b33-504e-9fcf-49fefb81af1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36 u^{2} \\sin^{3}{\\left(v \\right)}" :db/id #edb/ref 17592186538072} {:answer/id #uuid "0e1688fd-9312-57f7-9c64-e1d3ad42a239" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 36 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538074} {:answer/id #uuid "cbd03066-c83d-5019-9485-37cb3cc2441b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538099} {:answer/id #uuid "d58ab3c0-af56-5de4-ae75-7fd52aa5fe86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36 u \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538101} {:answer/id #uuid "eb1933b7-d000-5a91-889e-9974df4f68f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}" :db/id #edb/ref 17592186538104}] :answer-field/correct {:db/id #edb/ref 17592186538099} :answer-field/id #uuid "d08d3ad2-917b-5e7d-8e9b-9aa5cfd9d08e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538100}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a4148d41-ff0c-544e-a801-c54fea1c172d" :question/problem "Find the Jacobian determinant of the transformation $T$ that maps the $uvw$-space into the $xyz$-space by means of the equations\n\n$$\nx=3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\, y=3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)}\\, z=4 u \\cos{\\left(v \\right)}.\n$$" :question/worked-solution "For a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =3 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & \\frac{∂x}{∂v} & =3 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & \\frac{∂x}{∂w} & =- 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ \\frac{∂y}{∂u} & =3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & \\frac{∂y}{∂v} & =3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & \\frac{∂y}{∂w} & =3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ \\frac{∂z}{∂u} & =4 \\cos{\\left(v \\right)} & \\frac{∂z}{∂v} & =- 4 u \\sin{\\left(v \\right)} & \\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}3 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & 3 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & - 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & 3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ 4 \\cos{\\left(v \\right)} & - 4 u \\sin{\\left(v \\right)} & 0\\end{vmatrix} \\\\  & =\\left(4 \\cos{\\left(v \\right)}\\right)(-1)^{3+1}\\begin{vmatrix}3 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & - 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix}+\\left(- 4 u \\sin{\\left(v \\right)}\\right)(-1)^{3+2}\\begin{vmatrix}3 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & - 3 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix} \\\\  & =\\left(36 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right)+\\left(36 u^{2} \\sin^{3}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right) \\\\  & =\\left(36 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)+\\left(36 u^{2} \\sin^{3}{\\left(v \\right)}\\right) \\\\  & =36 u^{2} \\sin{\\left(v \\right)}\\left(\\cos^2 v+\\sin^2 v\\right) \\\\  & =36 u^{2} \\sin{\\left(v \\right)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b11761-2ef2-5ceb-a8c8-ffbe832809e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{e^{2}} + 50 e^{2}" :db/id #edb/ref 17592186538110} {:answer/id #uuid "5550ce8b-a330-5d05-a7e2-450b1c4c0130" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186538120} {:answer/id #uuid "888723f5-95e9-5497-a702-b81d6ee6aed4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 50 e^{2} - \\frac{10}{e^{2}} + 24" :db/id #edb/ref 17592186538129} {:answer/id #uuid "8d7fcd3b-6226-5771-b4d1-350798052ab0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24 + \\frac{10}{e^{2}} + 50 e^{2}" :db/id #edb/ref 17592186538130} {:answer/id #uuid "ad9f8939-8a29-5353-a94a-d5c6161080f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{e^{2}} + 24 + 50 e^{2}" :db/id #edb/ref 17592186538134}] :answer-field/correct {:db/id #edb/ref 17592186538130} :answer-field/id #uuid "9522aaa5-9e4d-58cf-88b3-a6672f006add" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538132}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "10952efb-f91e-5efa-8836-2bdfa5e4547d" :question/problem "Let $f(x,y,z)=2 x y^{2} + 2 y z.$ Given that $C$ is the path along the curve $r(t)=⟨e^{t},t + 3,e^{- t}⟩$ for $t\\in [0,2],$ evaluate $$\n\\displaystyle {\\int }_{C}∇f\\cdot \\text{d}r.\n$$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,3,1⟩ \\\\ r(2) & =⟨e^{2},5,e^{-2}⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,3,1)$ and $(e^{2},5,e^{-2}).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(2))-f(r(0)) \\\\  & =f(e^{2},5,e^{-2})-f(1,3,1) \\\\  & =\\left(2 \\left(e^{2}\\right) \\left(5\\right)^{2} + 2 \\left(5\\right) \\left(e^{-2}\\right)\\right)-\\left(2 \\left(1\\right) \\left(3\\right)^{2} + 2 \\left(3\\right) \\left(1\\right)\\right) \\\\  & =\\left(\\frac{10}{e^{2}} + 50 e^{2}\\right)-\\left(24\\right) \\\\  & =-24 + \\frac{10}{e^{2}} + 50 e^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a2220e-715f-57f8-8743-057e266ca318" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 e - 2" :db/id #edb/ref 17592186538114} {:answer/id #uuid "48fd3aa2-5c7d-540a-8ffd-5be89dfb1429" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10 + 4 e" :db/id #edb/ref 17592186538117} {:answer/id #uuid "6546aaf9-7cff-56ea-b59f-85e4aeb74c05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 + 4 e" :db/id #edb/ref 17592186538124} {:answer/id #uuid "9c99bae7-2dc2-5b64-885b-d754ce59bea4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186538133} {:answer/id #uuid "cd403008-fbc5-583c-96a7-a0c78f2b027d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 + 4 e" :db/id #edb/ref 17592186538140}] :answer-field/correct {:db/id #edb/ref 17592186538140} :answer-field/id #uuid "7c5d2f31-c569-5ce6-b4d2-c54ef953da59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538127}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "55b9003c-2f9b-5f89-8acf-67ac21d03597" :question/problem "Let $f(x,y,z)=x y^{2} + 3 x y z.$ Given that $C$ is the path along the curve $r(t)=⟨e^{t},t + 1,e^{- t}⟩$ for $t\\in [0,1],$ evaluate $$\n\\displaystyle {\\int }_{C}∇f\\cdot \\text{d}r.\n$$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,1,1⟩ \\\\ r(1) & =⟨e,2,e^{-1}⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,1,1)$ and $(e,2,e^{-1}).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(e,2,e^{-1})-f(1,1,1) \\\\  & =\\left(\\left(e\\right) \\left(2\\right)^{2} + 3 \\left(e\\right) \\left(2\\right) \\left(e^{-1}\\right)\\right)-\\left(\\left(1\\right) \\left(1\\right)^{2} + 3 \\left(1\\right) \\left(1\\right) \\left(1\\right)\\right) \\\\  & =\\left(6 + 4 e\\right)-\\left(4\\right) \\\\  & =2 + 4 e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1557e0a8-d585-523d-babf-b225f2b9a2ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5 - 25 e^{2}" :db/id #edb/ref 17592186538109} {:answer/id #uuid "3b9fe5a3-cec7-5200-87f9-a77a6de16f45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 25 e^{2} - 25" :db/id #edb/ref 17592186538115} {:answer/id #uuid "8fa93bc4-860e-5e12-a31b-4f116ce4d740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 25 e^{2} - 10" :db/id #edb/ref 17592186538131} {:answer/id #uuid "af665cd1-c2e0-5c16-bd26-b9766458bd3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186538135} {:answer/id #uuid "dc7a2ada-2d8c-5325-a3ef-40ae29016e2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5 + 25 e^{2}" :db/id #edb/ref 17592186538143}] :answer-field/correct {:db/id #edb/ref 17592186538109} :answer-field/id #uuid "3dbbff86-e68c-5eab-90c3-61a3fcbc667f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538116}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7f288c44-ccaa-54db-bd90-19654202c121" :question/problem "Let $f(x,y,z)=- x y^{2} - 2 x y z.$ Given that $C$ is the path along the curve $r(t)=⟨e^{t},t + 3,e^{- t}⟩$ for $t\\in [0,2],$ evaluate $$\n\\displaystyle {\\int }_{C}∇f\\cdot \\text{d}r.\n$$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,3,1⟩ \\\\ r(2) & =⟨e^{2},5,e^{-2}⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,3,1)$ and $(e^{2},5,e^{-2}).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(2))-f(r(0)) \\\\  & =f(e^{2},5,e^{-2})-f(1,3,1) \\\\  & =\\left(- \\left(e^{2}\\right) \\left(5\\right)^{2} - 2 \\left(e^{2}\\right) \\left(5\\right) \\left(e^{-2}\\right)\\right)-\\left(- \\left(1\\right) \\left(3\\right)^{2} - 2 \\left(1\\right) \\left(3\\right) \\left(1\\right)\\right) \\\\  & =\\left(- 25 e^{2} - 10\\right)-\\left(-15\\right) \\\\  & =5 - 25 e^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5674d226-aed0-5af3-94c0-c08de387fb42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 54 \\pi" :db/id #edb/ref 17592186538123} {:answer/id #uuid "b6677f9e-c46e-5df1-a022-79ff79ead6b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 216 \\pi" :db/id #edb/ref 17592186538136} {:answer/id #uuid "ccb35463-fe83-57c2-9aa8-404bf6c9df5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "108 \\pi" :db/id #edb/ref 17592186538138} {:answer/id #uuid "e0ded7cd-20cb-515e-90ac-79e2da37e37b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186538144} {:answer/id #uuid "f9c73618-b299-5c5a-8259-3519762335fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 108 \\pi" :db/id #edb/ref 17592186538147}] :answer-field/correct {:db/id #edb/ref 17592186538147} :answer-field/id #uuid "fa67956c-515d-580e-8ab9-dbe6238b9841" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538148}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb2e2e55-8936-54d7-a33c-03469d398524" :question/problem "Let $f(x,y,z)=- 2 x^{2} z - 2 x \\sin{\\left(y \\right)}.$ Given that $C$ is the path along the curve $r(t)=⟨3 \\cos{\\left(t \\right)},\\sin{\\left(t \\right)},3 t⟩$ for $t\\in [0,2 \\pi],$ evaluate $$\n\\displaystyle {\\int }_{C}∇f\\cdot \\text{d}r.\n$$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨3,0,0⟩ \\\\ r(2 \\pi) & =⟨3,0,6 \\pi⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(3,0,0)$ and $(3,0,6 \\pi).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(2 \\pi))-f(r(0)) \\\\  & =f(3,0,6 \\pi)-f(3,0,0) \\\\  & =\\left(- 2 \\left(3\\right)^{2} \\left(6 \\pi\\right) - 2 \\left(3\\right) \\sin{\\left(\\left(0\\right) \\right)}\\right)-\\left(- 2 \\left(3\\right)^{2} \\left(0\\right) - 2 \\left(3\\right) \\sin{\\left(\\left(0\\right) \\right)}\\right) \\\\  & =-2\\left(\\left(54 \\pi+0\\right)-\\left(0\\right)\\right) \\\\  & =- 108 \\pi.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b122fb-d082-5051-bb26-2b9c0fcc8dda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 - 8 e" :db/id #edb/ref 17592186538108} {:answer/id #uuid "169cc0df-0d15-5b42-b984-d54bb015c91d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1 - 8 e" :db/id #edb/ref 17592186538112} {:answer/id #uuid "4a663d34-c8ed-50d1-aa09-4f141042888e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 - 8 e" :db/id #edb/ref 17592186538118} {:answer/id #uuid "6f6d4e79-214a-5156-9718-c26c48758f6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3 + 8 e" :db/id #edb/ref 17592186538125} {:answer/id #uuid "da58d612-7787-54cd-85a7-f3f5f020e812" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186538142}] :answer-field/correct {:db/id #edb/ref 17592186538118} :answer-field/id #uuid "7a696714-c0a6-58d5-a9b9-4ec27d224ce0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538126}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cd1bb89c-9ca9-5d27-95e0-43a9165543a7" :question/problem "Let $f(x,y,z)=- 2 x y^{2} + x y z.$ Given that $C$ is the path along the curve $r(t)=⟨e^{t},t + 1,e^{- t}⟩$ for $t\\in [0,1],$ evaluate $$\n\\displaystyle {\\int }_{C}∇f\\cdot \\text{d}r.\n$$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,1,1⟩ \\\\ r(1) & =⟨e,2,e^{-1}⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,1,1)$ and $(e,2,e^{-1}).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(e,2,e^{-1})-f(1,1,1) \\\\  & =\\left(- 2 \\left(e\\right) \\left(2\\right)^{2} + \\left(e\\right) \\left(2\\right) \\left(e^{-1}\\right)\\right)-\\left(- 2 \\left(1\\right) \\left(1\\right)^{2} + \\left(1\\right) \\left(1\\right) \\left(1\\right)\\right) \\\\  & =\\left(2 - 8 e\\right)-\\left(-1\\right) \\\\  & =3 - 8 e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16055ec6-dd35-5ae8-b9b2-8fae66b219d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18 + 48 e^{2}" :db/id #edb/ref 17592186538111} {:answer/id #uuid "29033b82-e62d-5eff-869f-6e3c77aa79fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6 + 48 e^{2}" :db/id #edb/ref 17592186538113} {:answer/id #uuid "557cbc89-6a9c-59ae-af39-2498105ed609" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12 + 48 e^{2}" :db/id #edb/ref 17592186538121} {:answer/id #uuid "d22d355c-0046-5ecf-842d-6e656cb61b45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18 - 48 e^{2}" :db/id #edb/ref 17592186538141} {:answer/id #uuid "f1b76274-e3bf-518f-9866-77422b19ef84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186538146}] :answer-field/correct {:db/id #edb/ref 17592186538111} :answer-field/id #uuid "50f558ba-5ac1-5f2d-94f2-8f408ce11078" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538119}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "edc4ddd0-1255-518c-9176-4cb2e8db04ff" :question/problem "Let $f(x,y,z)=3 x y^{2} - 3 x y z.$ Given that $C$ is the path along the curve $r(t)=⟨e^{t},t + 2,e^{- t}⟩$ for $t\\in [0,2],$ evaluate $$\n\\displaystyle {\\int }_{C}∇f\\cdot \\text{d}r.\n$$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,2,1⟩ \\\\ r(2) & =⟨e^{2},4,e^{-2}⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,2,1)$ and $(e^{2},4,e^{-2}).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(2))-f(r(0)) \\\\  & =f(e^{2},4,e^{-2})-f(1,2,1) \\\\  & =\\left(3 \\left(e^{2}\\right) \\left(4\\right)^{2} - 3 \\left(e^{2}\\right) \\left(4\\right) \\left(e^{-2}\\right)\\right)-\\left(3 \\left(1\\right) \\left(2\\right)^{2} - 3 \\left(1\\right) \\left(2\\right) \\left(1\\right)\\right) \\\\  & =\\left(-12 + 48 e^{2}\\right)-\\left(6\\right) \\\\  & =-18 + 48 e^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b65a186-a184-5132-a502-d8ae39b78c12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{8}" :db/id #edb/ref 17592186539287} {:answer/id #uuid "90eb973c-7cd7-5bda-8a6f-a575297ec671" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{3}}{4} - \\frac{e^{4}}{4} - \\frac{e^{7}}{4} + \\frac{e^{8}}{4}" :db/id #edb/ref 17592186539322} {:answer/id #uuid "983f0743-ee62-5125-95e9-f57503bfeb8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{5}}{4} - \\frac{e}{4}" :db/id #edb/ref 17592186539325} {:answer/id #uuid "a7aa3024-8c33-533e-ae31-5c49f1df18fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{e^{3}}{4} - \\frac{e^{4}}{4} + \\frac{e^{7}}{4} + \\frac{e^{8}}{4}" :db/id #edb/ref 17592186539331} {:answer/id #uuid "c0c8590b-5153-5c28-99fd-22b08634c632" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{e^{4}}{4} + \\frac{e^{8}}{4}" :db/id #edb/ref 17592186539337}] :answer-field/correct {:db/id #edb/ref 17592186539322} :answer-field/id #uuid "c71fa17c-f1a9-58bd-837f-ffd76e6dc9e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539338}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2231fad2-39e0-5330-a2a7-ac9c21f00afb" :question/problem "Use a change of variables to evaluate the double integral\n\n$$\n\\iint_D e^{x^{2} + x + 4 y}\\,\\mathrm{d}x\\,\\mathrm{d}y\n$$\n\nwhere $D=\\{(x,y):1\\le x\\le 5,\\quad 2\\le x^{2} + 4 y\\le 3\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le x\\le 5,\\quad 2\\le x^{2} + 4 y\\le 3,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=x\\,\\text{and}\\,v=x^{2} + 4 y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nOur domain in the $uv$-plane is\n\n$$\n\\Delta=\\{(u,v):1\\le u\\le 5,\\,2\\le v\\le 3\\}.\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)} & =\\begin{vmatrix}\\frac{\\partial u}{\\partial x}&\\frac{\\partial u}{\\partial y}\\\\\\frac{\\partial v}{\\partial x}&\\frac{\\partial v}{\\partial y}\\end{vmatrix}\\\\&=\\left|\\begin{bmatrix}1 & 0\\\\2 x & 4\\end{bmatrix}\\right|\\\\&=4.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\left(\\frac{\\partial(u,v)}{\\partial(x,y)}\\right)^{-1}=\\frac{1}{4}=\\frac{1}{4}.\n$$\n\nNote that $\\frac{\\partial(x,y)}{\\partial(u,v)}\\ne0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\nSolving the transformation equations gives $x=u,\\ y=- \\frac{u^{2}}{4} + \\frac{v}{4}$, so the transformation is one-to-one on this domain.\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}\\iint_D e^{x^{2} + x + 4 y}\\,\\mathrm{d}x\\,\\mathrm{d}y & =\\iint_D e^{x+(x^{2} + 4 y)}\\,\\mathrm{d}x\\,\\mathrm{d}y \\\\ & =\\iint_\\Delta e^{u + v}\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\iint_\\Delta \\left(e^{u + v}\\right)\\cdot \\left(\\frac{1}{4}\\right)\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\frac{1}{4}\\int_{1}^{5} [\\int_{2}^{3} e^{u} e^{v}\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{4}\\int_{1}^{5} \\left(e^{u}\\right)[\\int_{2}^{3} e^{v}\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{4}\\int_{1}^{5} \\left(e^{u}\\right)\\left[e^{v}\\right]_{2}^{3}\\,\\mathrm{d}u \\\\ & =\\frac{1}{4}\\int_{1}^{5} \\left(e^{u}\\right)\\left(\\left(e^{3}\\right)-(\\left(e^{2}\\right))\\right)\\,\\mathrm{d}u \\\\ & =\\left(\\frac{1}{4}\\right)\\cdot \\left(- e^{2} + e^{3}\\right)\\int_{1}^{5} e^{u}\\,\\mathrm{d}u \\\\ & =\\left(\\frac{1}{4}\\right)\\cdot \\left(- e^{2} + e^{3}\\right)\\left[e^{u}\\right]_{1}^{5} \\\\ & =\\left(\\frac{1}{4}\\right)\\cdot \\left(- e^{2} + e^{3}\\right)\\left(\\left(e^{5}\\right)-(\\left(e\\right))\\right) \\\\ & =\\left(\\frac{1}{4}\\right)\\cdot \\left(e^{5} - e\\right)\\cdot \\left(- e^{2} + e^{3}\\right) \\\\ & =\\frac{e^{3}}{4} - \\frac{e^{4}}{4} - \\frac{e^{7}}{4} + \\frac{e^{8}}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1090fa4f-2de9-5a71-b762-f9c4b206e1c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186539289} {:answer/id #uuid "640d0292-c344-5d5e-9a14-b447496b8f72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 e^{6}}{3}" :db/id #edb/ref 17592186539311} {:answer/id #uuid "a376fd42-0744-52dd-a934-28272c20671d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{6}}{3}" :db/id #edb/ref 17592186539327} {:answer/id #uuid "d3e93479-2c09-5768-8f64-ed59388e0706" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{e^{4}}{3} + \\frac{e^{6}}{3}" :db/id #edb/ref 17592186539348} {:answer/id #uuid "f27ea39a-86a0-5aeb-ab5d-b1302b3e4a29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{4}}{3} + \\frac{e^{6}}{3}" :db/id #edb/ref 17592186539351}] :answer-field/correct {:db/id #edb/ref 17592186539348} :answer-field/id #uuid "ccb83526-61fd-5cdc-9d18-5c81f0f664bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539341}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "261bbf3c-0c9b-595d-8e0e-d4b85f4e6d85" :question/problem "Use a change of variables to evaluate the double integral\n\n$$\n\\iint_D e^{2 x + 6 y} \\left(x - 1\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y\n$$\n\nwhere $D=\\{(x,y):1\\le x\\le 3,\\quad 2\\le x + 3 y\\le 3\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le x\\le 3,\\quad 2\\le x + 3 y\\le 3,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=x\\,\\text{and}\\,v=x + 3 y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nOur domain in the $uv$-plane is\n\n$$\n\\Delta=\\{(u,v):1\\le u\\le 3,\\,2\\le v\\le 3\\}.\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)} & =\\begin{vmatrix}\\frac{\\partial u}{\\partial x}&\\frac{\\partial u}{\\partial y}\\\\\\frac{\\partial v}{\\partial x}&\\frac{\\partial v}{\\partial y}\\end{vmatrix}\\\\&=\\left|\\begin{bmatrix}1 & 0\\\\1 & 3\\end{bmatrix}\\right|\\\\&=3.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\left(\\frac{\\partial(u,v)}{\\partial(x,y)}\\right)^{-1}=\\frac{1}{3}=\\frac{1}{3}.\n$$\n\nNote that $\\frac{\\partial(x,y)}{\\partial(u,v)}\\ne0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\nSolving the transformation equations gives $x=u,\\ y=- \\frac{u}{3} + \\frac{v}{3}$, so the transformation is one-to-one on this domain.\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}\\iint_D e^{2 x + 6 y} \\left(x - 1\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y & =\\iint_\\Delta e^{2 v} \\left(u - 1\\right)\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\iint_\\Delta \\left(e^{2 v} \\left(u - 1\\right)\\right)\\cdot \\left(\\frac{1}{3}\\right)\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\frac{1}{3}\\int_{1}^{3} [\\int_{2}^{3} e^{2 v} \\left(u - 1\\right)\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{3}\\int_{1}^{3} \\left(u - 1\\right)[\\int_{2}^{3} e^{2 v}\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{3}\\int_{1}^{3} \\left(u - 1\\right)\\left[\\frac{e^{2 v}}{2}\\right]_{2}^{3}\\,\\mathrm{d}u \\\\ & =\\frac{1}{3}\\int_{1}^{3} \\left(u - 1\\right)\\left(\\left(\\frac{e^{6}}{2}\\right)-(\\left(\\frac{e^{4}}{2}\\right))\\right)\\,\\mathrm{d}u \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right)\\int_{1}^{3} u - 1\\,\\mathrm{d}u \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right)\\left[\\frac{u^{2}}{2} - u\\right]_{1}^{3} \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right)\\left(\\left(\\frac{9}{2}\\right)+\\left(-3\\right)-(\\left(\\frac{1}{2}\\right)+\\left(-1\\right))\\right) \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(2\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right) \\\\ & =- \\frac{e^{4}}{3} + \\frac{e^{6}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4f8852-8c2d-52c3-9bfe-2c07f2a7d249" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{4}}{4} + \\frac{e^{6}}{4}" :db/id #edb/ref 17592186539288} {:answer/id #uuid "10c1298d-2a3f-5806-a08e-4abe4508710b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 e^{6}}{3}" :db/id #edb/ref 17592186539290} {:answer/id #uuid "62e518e1-7f15-50d7-b3d9-6f2e7e0ec706" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{e^{4}}{4} + \\frac{e^{6}}{4}" :db/id #edb/ref 17592186539309} {:answer/id #uuid "b0895210-4fe6-59d4-81bd-4a7b6f99774c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186539334} {:answer/id #uuid "d0ee4ba4-229e-5664-895e-136f3ef23945" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{6}}{4}" :db/id #edb/ref 17592186539346}] :answer-field/correct {:db/id #edb/ref 17592186539309} :answer-field/id #uuid "1c3a5904-bf08-5994-9567-c34370267b6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539292}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2d2b5012-62ca-5818-b5dd-c30729dfd6d5" :question/problem "Use a change of variables to evaluate the double integral\n\n$$\n\\iint_D e^{2 x + 6 y} \\left(x - 1\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y\n$$\n\nwhere $D=\\{(x,y):2\\le x\\le 3,\\quad 2\\le x + 3 y\\le 3\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n2\\le x\\le 3,\\quad 2\\le x + 3 y\\le 3,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=x\\,\\text{and}\\,v=x + 3 y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nOur domain in the $uv$-plane is\n\n$$\n\\Delta=\\{(u,v):2\\le u\\le 3,\\,2\\le v\\le 3\\}.\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)} & =\\begin{vmatrix}\\frac{\\partial u}{\\partial x}&\\frac{\\partial u}{\\partial y}\\\\\\frac{\\partial v}{\\partial x}&\\frac{\\partial v}{\\partial y}\\end{vmatrix}\\\\&=\\left|\\begin{bmatrix}1 & 0\\\\1 & 3\\end{bmatrix}\\right|\\\\&=3.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\left(\\frac{\\partial(u,v)}{\\partial(x,y)}\\right)^{-1}=\\frac{1}{3}=\\frac{1}{3}.\n$$\n\nNote that $\\frac{\\partial(x,y)}{\\partial(u,v)}\\ne0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\nSolving the transformation equations gives $x=u,\\ y=- \\frac{u}{3} + \\frac{v}{3}$, so the transformation is one-to-one on this domain.\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}\\iint_D e^{2 x + 6 y} \\left(x - 1\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y & =\\iint_\\Delta e^{2 v} \\left(u - 1\\right)\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\iint_\\Delta \\left(e^{2 v} \\left(u - 1\\right)\\right)\\cdot \\left(\\frac{1}{3}\\right)\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\frac{1}{3}\\int_{2}^{3} [\\int_{2}^{3} e^{2 v} \\left(u - 1\\right)\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{3}\\int_{2}^{3} \\left(u - 1\\right)[\\int_{2}^{3} e^{2 v}\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{3}\\int_{2}^{3} \\left(u - 1\\right)\\left[\\frac{e^{2 v}}{2}\\right]_{2}^{3}\\,\\mathrm{d}u \\\\ & =\\frac{1}{3}\\int_{2}^{3} \\left(u - 1\\right)\\left(\\left(\\frac{e^{6}}{2}\\right)-(\\left(\\frac{e^{4}}{2}\\right))\\right)\\,\\mathrm{d}u \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right)\\int_{2}^{3} u - 1\\,\\mathrm{d}u \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right)\\left[\\frac{u^{2}}{2} - u\\right]_{2}^{3} \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right)\\left(\\left(\\frac{9}{2}\\right)+\\left(-3\\right)-(\\left(2\\right)+\\left(-2\\right))\\right) \\\\ & =\\left(\\frac{1}{3}\\right)\\cdot \\left(\\frac{3}{2}\\right)\\cdot \\left(- \\frac{e^{4}}{2} + \\frac{e^{6}}{2}\\right) \\\\ & =- \\frac{e^{4}}{4} + \\frac{e^{6}}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1adc1044-a21c-5fb5-a7dd-710c0183e0a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{63}{2}" :db/id #edb/ref 17592186539291} {:answer/id #uuid "730e8a89-1885-53bc-968e-db1e396f42e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186539315} {:answer/id #uuid "88d08105-5bc0-5b01-aba1-ad81db0f73d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{63}{2}" :db/id #edb/ref 17592186539319} {:answer/id #uuid "bdaf610d-9c5e-5495-9e74-f6cc3d09e83d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186539335} {:answer/id #uuid "ce359bd0-213f-5208-b73b-97a593b89e7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "63" :db/id #edb/ref 17592186539342}] :answer-field/correct {:db/id #edb/ref 17592186539291} :answer-field/id #uuid "94a3a1f5-e60e-5c3b-8422-1ee5205aa1f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539324}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f71a0e9-4f26-53c3-82c6-851fe7d02505" :question/problem "Use a change of variables to evaluate the double integral\n\n$$\n\\iint_D x + y\\,\\mathrm{d}x\\,\\mathrm{d}y\n$$\n\nwhere $D=\\{(x,y):0\\le x\\le 7,\\quad 0\\le x + y\\le 3\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n0\\le x\\le 7,\\quad 0\\le x + y\\le 3,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=x\\,\\text{and}\\,v=x + y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nOur domain in the $uv$-plane is\n\n$$\n\\Delta=\\{(u,v):0\\le u\\le 7,\\,0\\le v\\le 3\\}.\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)} & =\\begin{vmatrix}\\frac{\\partial u}{\\partial x}&\\frac{\\partial u}{\\partial y}\\\\\\frac{\\partial v}{\\partial x}&\\frac{\\partial v}{\\partial y}\\end{vmatrix}\\\\&=\\left|\\begin{bmatrix}1 & 0\\\\1 & 1\\end{bmatrix}\\right|\\\\&=1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\left(\\frac{\\partial(u,v)}{\\partial(x,y)}\\right)^{-1}=1=1.\n$$\n\nNote that $\\frac{\\partial(x,y)}{\\partial(u,v)}\\ne0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\nSolving the transformation equations gives $x=u,\\ y=- u + v$, so the transformation is one-to-one on this domain.\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}\\iint_D x + y\\,\\mathrm{d}x\\,\\mathrm{d}y & =\\iint_\\Delta v\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\iint_\\Delta \\left(v\\right)\\cdot \\left(1\\right)\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{3} [\\int_{0}^{7} v\\,\\mathrm{d}u]\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{3} v[\\int_{0}^{7} 1\\,\\mathrm{d}u]\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{3} v\\left[u\\right]_{0}^{7}\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{3} v\\left(\\left(7\\right)-(\\left(0\\right))\\right)\\,\\mathrm{d}v \\\\ & =\\left(1\\right)\\cdot \\left(7\\right)\\int_{0}^{3} v\\,\\mathrm{d}v \\\\ & =\\left(1\\right)\\cdot \\left(7\\right)\\left[\\frac{v^{2}}{2}\\right]_{0}^{3} \\\\ & =\\left(1\\right)\\cdot \\left(7\\right)\\left(\\left(\\frac{9}{2}\\right)-(\\left(0\\right))\\right) \\\\ & =\\left(1\\right)\\cdot \\left(7\\right)\\cdot \\left(\\frac{9}{2}\\right) \\\\ & =\\frac{63}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441faa0c-6a70-5ffa-a2f7-be85bc15c8e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186539301} {:answer/id #uuid "5c780ba2-f667-560d-b8e1-248ea20cfe21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186539307} {:answer/id #uuid "60d8a298-d4e4-570a-a583-6f173784c347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186539308} {:answer/id #uuid "f26d4ab5-5aed-5a95-963f-4870415729d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186539350} {:answer/id #uuid "f54f3396-5ed6-5d96-b187-6458849c0b77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186539353}] :answer-field/correct {:db/id #edb/ref 17592186539307} :answer-field/id #uuid "c986d9b3-6cbe-5371-bfa3-6e711d83e7d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539340}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "80d403dd-76fc-5ee3-bdb6-3cb3268156ab" :question/problem "Use a change of variables to evaluate the double integral\n\n$$\n\\iint_D x + y\\,\\mathrm{d}x\\,\\mathrm{d}y\n$$\n\nwhere $D=\\{(x,y):0\\le x\\le 6,\\quad 0\\le x + y\\le 2\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n0\\le x\\le 6,\\quad 0\\le x + y\\le 2,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=x\\,\\text{and}\\,v=x + y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$\n\nOur domain in the $uv$-plane is\n\n$$\n\\Delta=\\{(u,v):0\\le u\\le 6,\\,0\\le v\\le 2\\}.\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)} & =\\begin{vmatrix}\\frac{\\partial u}{\\partial x}&\\frac{\\partial u}{\\partial y}\\\\\\frac{\\partial v}{\\partial x}&\\frac{\\partial v}{\\partial y}\\end{vmatrix}\\\\&=\\left|\\begin{bmatrix}1 & 0\\\\1 & 1\\end{bmatrix}\\right|\\\\&=1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\left(\\frac{\\partial(u,v)}{\\partial(x,y)}\\right)^{-1}=1=1.\n$$\n\nNote that $\\frac{\\partial(x,y)}{\\partial(u,v)}\\ne0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\nSolving the transformation equations gives $x=u,\\ y=- u + v$, so the transformation is one-to-one on this domain.\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}\\iint_D x + y\\,\\mathrm{d}x\\,\\mathrm{d}y & =\\iint_\\Delta v\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\iint_\\Delta \\left(v\\right)\\cdot \\left(1\\right)\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{2} [\\int_{0}^{6} v\\,\\mathrm{d}u]\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{2} v[\\int_{0}^{6} 1\\,\\mathrm{d}u]\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{2} v\\left[u\\right]_{0}^{6}\\,\\mathrm{d}v \\\\ & =1\\int_{0}^{2} v\\left(\\left(6\\right)-(\\left(0\\right))\\right)\\,\\mathrm{d}v \\\\ & =\\left(1\\right)\\cdot \\left(6\\right)\\int_{0}^{2} v\\,\\mathrm{d}v \\\\ & =\\left(1\\right)\\cdot \\left(6\\right)\\left[\\frac{v^{2}}{2}\\right]_{0}^{2} \\\\ & =\\left(1\\right)\\cdot \\left(6\\right)\\left(\\left(2\\right)-(\\left(0\\right))\\right) \\\\ & =\\left(1\\right)\\cdot \\left(6\\right)\\cdot \\left(2\\right) \\\\ & =12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "281e4fec-c587-55e5-9466-7d86996844e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72" :db/id #edb/ref 17592186539295} {:answer/id #uuid "2a1950a3-40b6-5898-b425-c531634f8fd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186539296} {:answer/id #uuid "57377b59-9410-5e89-b4f8-e9b944c753b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186539306} {:answer/id #uuid "667a6e43-b6f9-5aa8-9c14-d1fe22bd70fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186539312} {