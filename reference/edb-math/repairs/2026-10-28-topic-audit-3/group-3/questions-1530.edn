}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{4}{v}^{2}[{\\int }_{1}^{9}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{4}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{9}]dv \\\\  & =\\frac{1}{3}{\\int }_{2}^{4}{v}^{2}(\\operatorname{ln}⁡9-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡3}{3}{\\int }_{2}^{4}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡3}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{2}^{4} \\\\  & =\\frac{2\\operatorname{ln}⁡3}{9}\\cdot (64-8) \\\\  & =\\frac{112\\operatorname{ln}⁡3}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1760086a-7c09-5e8c-b8a1-c75d9fe9a51b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\ln(4)" :db/id #edb/ref 17592186539359} {:answer/id #uuid "6a996faf-b917-5a49-b738-11415367209b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 14 \\ln(4)" :db/id #edb/ref 17592186539373} {:answer/id #uuid "7ea0e4fa-607a-52bf-a6d1-09e1f76b57f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\operatorname{ln}⁡4" :db/id #edb/ref 17592186539377} {:answer/id #uuid "cf2b0b28-1110-5655-97fd-3599b3b30adf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42 \\ln(4)" :db/id #edb/ref 17592186539385} {:answer/id #uuid "d44bf487-a72f-5688-b79f-679c5c9843de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{85 \\ln(4)}{2}" :db/id #edb/ref 17592186539386}] :answer-field/correct {:db/id #edb/ref 17592186539377} :answer-field/id #uuid "e0c9be7b-466c-5bfe-beef-e661d5145178" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539389}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b880e9be-152d-5343-be07-baad51f74777" :question/problem "Using the change of variables $u=\\frac{y}{{x}^{2}}$ and $v=xy,$ evaluate the double integral\n\n$$\n{∬}_{D}(xy)^{2}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,{x}^{2}\\le y\\le 16{x}^{2},\\,1\\le xy\\le 4\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 16,\\,1\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{vmatrix} \\\\  & =-\\frac{3y}{{x}^{2}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(-\\frac{3y}{{x}^{2}}\\right)}=-\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{\\int }_{1}^{16}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}[{\\int }_{1}^{16}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{16}]dv \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}(\\operatorname{ln}⁡16-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}{\\int }_{1}^{4}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{1}^{4} \\\\  & =\\frac{2\\operatorname{ln}⁡4}{9}\\cdot (64-1) \\\\  & =14\\operatorname{ln}⁡4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8e42dd-1135-55d6-baea-5eaf5e395812" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{182 \\ln{\\left(2 \\right)}}{9}" :db/id #edb/ref 17592186539362} {:answer/id #uuid "5775d9e0-17da-5f4b-97d4-d8327fe13f79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{671 \\ln{\\left(2 \\right)}}{6}" :db/id #edb/ref 17592186539368} {:answer/id #uuid "bee804f0-fe47-54f2-82b3-1ab225bbaa16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\ln{\\left(2 \\right)}}{3}" :db/id #edb/ref 17592186539381} {:answer/id #uuid "c8511436-e484-5251-a621-0417962a64ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{182 \\ln{\\left(2 \\right)}}{3}" :db/id #edb/ref 17592186539383} {:answer/id #uuid "f7a1ff94-668d-56c9-ab15-77c13bfdd79a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{182 \\ln{\\left(2 \\right)}}{9}" :db/id #edb/ref 17592186539391}] :answer-field/correct {:db/id #edb/ref 17592186539362} :answer-field/id #uuid "2a87ecd3-6574-5e98-aac6-eaeb2a2a41af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539361}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dc1cd88b-9881-56a3-9ef5-53708f7c4b33" :question/problem "Using the change of variables $u=\\frac{y}{{x}^{2}}$ and $v=xy,$ evaluate the double integral\n\n$$\n{∬}_{D}(xy)^{2}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,{x}^{2}\\le y\\le 4{x}^{2},\\,5\\le xy\\le 6\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,5\\le v\\le 6\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{vmatrix} \\\\  & =-\\frac{3y}{{x}^{2}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(-\\frac{3y}{{x}^{2}}\\right)}=-\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{5}^{6}{\\int }_{1}^{4}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{5}^{6}{v}^{2}[{\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{5}^{6}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{4}]dv \\\\  & =\\frac{1}{3}{\\int }_{5}^{6}{v}^{2}(\\operatorname{ln}⁡4-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡2}{3}{\\int }_{5}^{6}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡2}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{5}^{6} \\\\  & =\\frac{2\\operatorname{ln}⁡2}{9}\\cdot (216-125) \\\\  & =\\frac{182\\operatorname{ln}⁡2}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "592edeca-a58b-598c-b36b-63081f22b737" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "108\\sqrt{34}" :db/id #edb/ref 17592186540185}] :answer-field/correct {:db/id #edb/ref 17592186540185} :answer-field/id #uuid "bd5dfdc6-6e25-5817-aa73-4ea414decde1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2a0c552d-208d-5647-bd93-a9e5ea76dedb" :question/problem "Evaluate the surface integral\n\n$$\\iint_S(x-y)\\,\\text{d}S,$$\n\nwhere $r(u,v)=⟨2u+2v,\\,2u-2v,\\,3v⟩$ for $0\\le u\\le 3$ and $0\\le v\\le 3.$\n\n*Hint: $‖r_u′\\times r_v′‖=2\\sqrt{34}.$*\n\n{{field-1}}" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nNotice that we are told that the norm of the fundamental vector product is\n\n$$\n‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=2\\sqrt{34}.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$f(r(u,v))=(2u+2v)-(2u-2v)=4v.$$\n\nTherefore, our surface integral can be written as\n\n$$\\begin{aligned}\\iint_S(x-y)\\,\\text{d}S&=\\iint_D f(r(u,v))‖r_u′\\times r_v′‖\\,\\text{d}A\\\\&=2\\sqrt{34}\\iint_D 4v\\,\\text{d}A\\\\&=2\\sqrt{34}\\int_0^{3}4v\\,\\text{d}v\\cdot\\int_0^{3}1\\,\\text{d}u\\\\&=2\\sqrt{34}[2v^{2}]_0^{3}[u]_0^{3}\\\\&=2\\sqrt{34}(18-0)(3-0)\\\\&=108\\sqrt{34}.\\end{aligned}$$"}] [{:db/id #edb/ref 17592186540184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04750ba1-7d77-5b3e-adbe-fb66cc839d72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54\\sqrt{22}" :db/id #edb/ref 17592186540182}] :answer-field/correct {:db/id #edb/ref 17592186540182} :answer-field/id #uuid "5d0cc3a7-0b20-5f18-b1bb-75c69ce02711" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540186}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44e31a62-0afc-5503-b1c7-497ce942e02a" :question/problem "Evaluate the surface integral\n\n$$\\iint_S(x-y)\\,\\text{d}S,$$\n\nwhere $r(u,v)=⟨3u+v,\\,3u-v,\\,3v⟩$ for $0\\le u\\le 2$ and $0\\le v\\le 3.$\n\n*Hint: $‖r_u′\\times r_v′‖=3\\sqrt{22}.$*\n\n{{field-1}}" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nNotice that we are told that the norm of the fundamental vector product is\n\n$$\n‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=3\\sqrt{22}.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$f(r(u,v))=(3u+v)-(3u-v)=2v.$$\n\nTherefore, our surface integral can be written as\n\n$$\\begin{aligned}\\iint_S(x-y)\\,\\text{d}S&=\\iint_D f(r(u,v))‖r_u′\\times r_v′‖\\,\\text{d}A\\\\&=3\\sqrt{22}\\iint_D 2v\\,\\text{d}A\\\\&=3\\sqrt{22}\\int_0^{3}2v\\,\\text{d}v\\cdot\\int_0^{2}1\\,\\text{d}u\\\\&=3\\sqrt{22}[v^{2}]_0^{3}[u]_0^{2}\\\\&=3\\sqrt{22}(9-0)(2-0)\\\\&=54\\sqrt{22}.\\end{aligned}$$"}] [{:db/id #edb/ref 17592186540187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dac57afd-cb85-5e46-a6c1-819e0317af41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\sqrt{11}" :db/id #edb/ref 17592186540193}] :answer-field/correct {:db/id #edb/ref 17592186540193} :answer-field/id #uuid "954bfe3d-d924-5d77-a50e-3e9051dff6ee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540189}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "693fafe3-8347-5fad-b5e8-6328dbf9f45e" :question/problem "Evaluate the surface integral\n\n$$\\iint_S(x-y)\\,\\text{d}S,$$\n\nwhere $r(u,v)=⟨u+3v,\\,u-3v,\\,2v⟩$ for $0\\le u\\le 2$ and $0\\le v\\le 1.$\n\n*Hint: $‖r_u′\\times r_v′‖=2\\sqrt{11}.$*\n\n{{field-1}}" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nNotice that we are told that the norm of the fundamental vector product is\n\n$$\n‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=2\\sqrt{11}.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$f(r(u,v))=(u+3v)-(u-3v)=6v.$$\n\nTherefore, our surface integral can be written as\n\n$$\\begin{aligned}\\iint_S(x-y)\\,\\text{d}S&=\\iint_D f(r(u,v))‖r_u′\\times r_v′‖\\,\\text{d}A\\\\&=2\\sqrt{11}\\iint_D 6v\\,\\text{d}A\\\\&=2\\sqrt{11}\\int_0^{1}6v\\,\\text{d}v\\cdot\\int_0^{2}1\\,\\text{d}u\\\\&=2\\sqrt{11}[3v^{2}]_0^{1}[u]_0^{2}\\\\&=2\\sqrt{11}(3-0)(2-0)\\\\&=12\\sqrt{11}.\\end{aligned}$$"}] [{:db/id #edb/ref 17592186540188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7782f9c-a288-538e-acbc-09a9550c8baf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "324\\sqrt{2}" :db/id #edb/ref 17592186540191}] :answer-field/correct {:db/id #edb/ref 17592186540191} :answer-field/id #uuid "a78d8176-5589-542a-996f-c9de271e00a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540190}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6a2ff333-cf5b-5cec-a3d0-9589f8fcca8f" :question/problem "Evaluate the surface integral\n\n$$\\iint_S(x-y)\\,\\text{d}S,$$\n\nwhere $r(u,v)=⟨2u+2v,\\,2u-2v,\\,v⟩$ for $0\\le u\\le 3$ and $0\\le v\\le 3.$\n\n*Hint: $‖r_u′\\times r_v′‖=6\\sqrt{2}.$*\n\n{{field-1}}" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nNotice that we are told that the norm of the fundamental vector product is\n\n$$\n‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=6\\sqrt{2}.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$f(r(u,v))=(2u+2v)-(2u-2v)=4v.$$\n\nTherefore, our surface integral can be written as\n\n$$\\begin{aligned}\\iint_S(x-y)\\,\\text{d}S&=\\iint_D f(r(u,v))‖r_u′\\times r_v′‖\\,\\text{d}A\\\\&=6\\sqrt{2}\\iint_D 4v\\,\\text{d}A\\\\&=6\\sqrt{2}\\int_0^{3}4v\\,\\text{d}v\\cdot\\int_0^{3}1\\,\\text{d}u\\\\&=6\\sqrt{2}[2v^{2}]_0^{3}[u]_0^{3}\\\\&=6\\sqrt{2}(18-0)(3-0)\\\\&=324\\sqrt{2}.\\end{aligned}$$"}]}
