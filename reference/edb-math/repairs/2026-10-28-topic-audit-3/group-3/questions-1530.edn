,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =- 2 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & \\frac{∂x}{∂v} & =- 2 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & \\frac{∂x}{∂w} & =2 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ \\frac{∂y}{∂u} & =- 4 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & \\frac{∂y}{∂v} & =- 4 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & \\frac{∂y}{∂w} & =- 4 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ \\frac{∂z}{∂u} & =3 \\cos{\\left(v \\right)} & \\frac{∂z}{∂v} & =- 3 u \\sin{\\left(v \\right)} & \\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}- 2 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & - 2 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & 2 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ - 4 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & - 4 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & - 4 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ 3 \\cos{\\left(v \\right)} & - 3 u \\sin{\\left(v \\right)} & 0\\end{vmatrix} \\\\  & =\\left(3 \\cos{\\left(v \\right)}\\right)(-1)^{3+1}\\begin{vmatrix}- 2 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & 2 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ - 4 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & - 4 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix}+\\left(- 3 u \\sin{\\left(v \\right)}\\right)(-1)^{3+2}\\begin{vmatrix}- 2 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & 2 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ - 4 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & - 4 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix} \\\\  & =\\left(24 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right)+\\left(24 u^{2} \\sin^{3}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right) \\\\  & =\\left(24 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)+\\left(24 u^{2} \\sin^{3}{\\left(v \\right)}\\right) \\\\  & =24 u^{2} \\sin{\\left(v \\right)}\\left(\\cos^2 v+\\sin^2 v\\right) \\\\  & =24 u^{2} \\sin{\\left(v \\right)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8639633e-7629-5d2f-945f-aa8ce0e5f0c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538085} {:answer/id #uuid "a3b1ab11-7d9e-52c2-aac3-7a93e1a2576b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 9 u^{2} \\sin^{3}{\\left(v \\right)}" :db/id #edb/ref 17592186538090} {:answer/id #uuid "a4caba16-1039-5e14-be47-fdf13dfcd67d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 9 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538092} {:answer/id #uuid "b6eb2d3b-bd8f-50ea-8736-5da858c8a892" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 9 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}" :db/id #edb/ref 17592186538094} {:answer/id #uuid "eebf4344-774e-5d8c-bf8f-9ad590e630f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 9 u \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538105}] :answer-field/correct {:db/id #edb/ref 17592186538092} :answer-field/id #uuid "4739e7c6-b451-564c-ac39-bba86db75337" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538077}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "68a40794-ec75-5300-a01a-332543287ac4" :question/problem "Find the Jacobian determinant of the tran