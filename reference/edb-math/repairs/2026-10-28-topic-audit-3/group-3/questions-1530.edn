t is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}- 4 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & - 4 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & 4 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & 3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} \\\\ - \\cos{\\left(v \\right)} & u \\sin{\\left(v \\right)} & 0\\end{vmatrix} \\\\  & =\\left(- \\cos{\\left(v \\right)}\\right)(-1)^{3+1}\\begin{vmatrix}- 4 u \\cos{\\left(v \\right)} \\cos{\\left(w \\right)} & 4 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 u \\sin{\\left(w \\right)} \\cos{\\left(v \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix}+\\left(u \\sin{\\left(v \\right)}\\right)(-1)^{3+2}\\begin{vmatrix}- 4 \\sin{\\left(v \\right)} \\cos{\\left(w \\right)} & 4 u \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} \\\\ 3 \\sin{\\left(v \\right)} \\sin{\\left(w \\right)} & 3 u \\sin{\\left(v \\right)} \\cos{\\left(w \\right)}\\end{vmatrix} \\\\  & =\\left(12 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right)+\\left(12 u^{2} \\sin^{3}{\\left(v \\right)}\\right)\\left(\\cos^2 w+\\sin^2 w\\right) \\\\  & =\\left(12 u^{2} \\sin{\\left(v \\right)} \\cos^{2}{\\left(v \\right)}\\right)+\\left(12 u^{2} \\sin^{3}{\\left(v \\right)}\\right) \\\\  & =12 u^{2} \\sin{\\left(v \\right)}\\left(\\cos^2 v+\\sin^2 v\\right) \\\\  & =12 u^{2} \\sin{\\left(v \\right)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132328d8-571d-54c1-a382-e07fe4ab0e8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 8 u^{2} \\sin{\\left(v \\right)}" :db/id #edb/ref 17592186538075} {:answer/id #uuid "4b164324-6818-54e6-8c89-068adf9f97cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8 u^{2} \\sin