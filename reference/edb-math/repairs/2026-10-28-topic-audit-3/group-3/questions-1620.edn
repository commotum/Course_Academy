ht)\\rangle \\\\ & =\\langle 12 t^{2} - 4, 18 t + 9, 9 t^{2} - 3\\rangle\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r\\prime(t) & =\\langle - 3 t^{3} + 3 t, 0, - 9 t^{2} - 9 t\\rangle\\cdot \\langle 12 t^{2} - 4, 18 t + 9, 9 t^{2} - 3\\rangle \\\\ & =\\left(- 3 t^{3} + 3 t\\right)\\cdot \\left(12 t^{2} - 4\\right)+\\left(0\\right)\\cdot \\left(18 t + 9\\right)+\\left(- 9 t^{2} - 9 t\\right)\\cdot \\left(9 t^{2} - 3\\right) \\\\ & =\\left(- 36 t^{5} + 48 t^{3} - 12 t\\right)+\\left(0\\right)+\\left(- 81 t^{4} - 81 t^{3} + 27 t^{2} + 27 t\\right) \\\\ & =- 36 t^{5} - 81 t^{4} - 33 t^{3} + 27 t^{2} + 15 t \\\\ & =- 36 t^{5} - 81 t^{4} - 33 t^{3} + 27 t^{2} + 15 t\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\iint_S\\operatorname{curl}F\\cdot\\mathrm dS & =\\oint_C F\\cdot\\mathrm dr \\\\ & =\\int_{-1}^{0} F(r(t))\\cdot r\\prime(t)\\,\\mathrm dt \\\\ & =\\int_{-1}^{0}\\left(- 36 t^{5} - 81 t^{4} - 33 t^{3} + 27 t^{2} + 15 t\\right)\\,\\mathrm dt \\\\ & =\\left[\\left(- \\frac{81 t^{5}}{5}\\right) + \\left(- 6 t^{6}\\right) + \\left(- \\frac{33 t^{4}}{4}\\right) + \\left(\\frac{15 t^{2}}{2}\\right) + \\left(9 t^{3}\\right)\\right]_{-1}^{0} \\\\ & =\\left(\\left(0\\right) + \\left(0\\right) + \\left(0\\right) + \\left(0\\right) + \\left(0\\right)\\right)-\\left(\\left(\\frac{81}{5}\\right) + \\left(-6\\right) + \\left(- \\frac{33}{4}\\right) + \\left(\\frac{15}{2}\\right) + \\left(-9\\right)\\right) \\\\ & =- \\frac{9}{20}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39afc945-9e03-524e-952d-a33d5ab5d753" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 \\pi" :db/id #edb/ref 17592186543972} {:answer/id #uuid "90ef5b58-d25f-5e4f-a42c-d2e505c49183" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186543987} {:answer/id #uuid "b5f67b67-bc16-5291-8fdd-c5471a12cd02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\pi" :db/id #edb/ref 17592186543996} {:answer/id #uuid "e5d4c9aa-321f-56c7-9ef0-3a217437cb9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\pi" :db/id #edb/ref 17592186544006} {:answer/id #uuid "f5a378c0-0e5b-55bb-98f4-df4562cc3e38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186544010}] :answer-field/correct {:db/id #edb/ref 17592186544006} :answer-field/id #uuid "48c8a955-76d0-58a7-a91b-b0d249b47acb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543977}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a815ade-dfb6-5a43-b8bb-5c22f46d2670" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\langle \\cos{\\left(t \\right)}, - 2 \\sin{\\left(t \\right)}, 1\\rangle$ for $t\\in [0,2 \\pi).$\nGiven that $F(x,y,z)=\\langle y, - x, 0\\rangle,$ evaluate the integral\n\n$$\n\\iint_S\\operatorname{curl}F\\cdot\\mathrm{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\cos{\\left(t \\right)},\\quad y=- 2 \\sin{\\left(t \\right)},\\quad z=1\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\langle y, - x, 0\\rangle \\\\ & =\\langle \\left(- 2 \\sin{\\left(t \\right)}\\right), - \\left(\\cos{\\left(t \\right)}\\right), 0\\rangle \\\\ & =\\langle - 2 \\sin{\\left(t \\right)}, - \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nComputing $r\\prime(t),$ we get\n\n$$\n\\begin{aligned}r\\prime(t) & =\\langle \\frac{\\mathrm d}{\\mathrm dt}\\left(\\cos{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(- 2 \\sin{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(1\\right)\\rangle \\\\ & =\\langle - \\sin{\\left(t \\right)}, - 2 \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r\\prime(t) & =\\langle - 2 \\sin{\\left(t \\right)}, - \\cos{\\left(t \\right)}, 0\\rangle\\cdot \\langle - \\sin{\\left(t \\right)}, - 2 \\cos{\\left(t \\right)}, 0\\rangle \\\\ & =\\left(- 2 \\sin{\\left(t \\right)}\\right)\\cdot \\left(- \\sin{\\left(t \\right)}\\right)+\\left(- \\cos{\\left(t \\right)}\\right)\\cdot \\left(- 2 \\cos{\\left(t \\right)}\\right)+\\left(0\\right)\\cdot \\left(0\\right) \\\\ & =\\left(2 \\sin^{2}{\\left(t \\right)}\\right)+\\left(2 \\cos^{2}{\\left(t \\right)}\\right)+\\left(0\\right) \\\\ & =2 \\sin^{2}{\\left(t \\right)} + 2 \\cos^{2}{\\left(t \\right)} \\\\ & =2\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\iint_S\\operatorname{curl}F\\cdot\\mathrm dS & =\\oint_C F\\cdot\\mathrm dr \\\\ & =\\int_{0}^{2 \\pi} F(r(t))\\cdot r\\prime(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{2 \\pi}\\left(2\\right)\\,\\mathrm dt \\\\ & =\\left[\\left(2 t\\right)\\right]_{0}^{2 \\pi} \\\\ & =\\left(\\left(4 \\pi\\right)\\right)-\\left(\\left(0\\right)\\right) \\\\ & =4 \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a586ec0-0624-5fa5-bb42-b553aa1955f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186543966} {:answer/id #uuid "886e21f4-282c-5d51-b381-ea5a9c03a010" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 12 \\pi" :db/id #edb/ref 17592186543986} {:answer/id #uuid "91c57125-f107-58b3-96a3-2d51059bea9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186543988} {:answer/id #uuid "e2c13c2e-52fe-58db-85c2-56e596e798ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 \\pi" :db/id #edb/ref 17592186544005} {:answer/id #uuid "fefa30b8-6a1f-58c6-8d37-71fd16bf828e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 \\pi" :db/id #edb/ref 17592186544011}] :answer-field/correct {:db/id #edb/ref 17592186544005} :answer-field/id #uuid "c766976e-6b2f-5d97-a902-e8110fe7515f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543999}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7483bc57-3777-5a4c-b887-84c48a923ec4" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\langle - \\cos{\\left(t \\right)}, - 2 \\sin{\\left(t \\right)}, 1\\rangle$ for $t\\in [0,2 \\pi).$\nGiven that $F(x,y,z)=\\langle - 3 y, 3 x, 0\\rangle,$ evaluate the integral\n\n$$\n\\iint_S\\operatorname{curl}F\\cdot\\mathrm{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=- \\cos{\\left(t \\right)},\\quad y=- 2 \\sin{\\left(t \\right)},\\quad z=1\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\langle - 3 y, 3 x, 0\\rangle \\\\ & =\\langle - 3 \\left(- 2 \\sin{\\left(t \\right)}\\right), 3 \\left(- \\cos{\\left(t \\right)}\\right), 0\\rangle \\\\ & =\\langle 6 \\sin{\\left(t \\right)}, - 3 \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nComputing $r\\prime(t),$ we get\n\n$$\n\\begin{aligned}r\\prime(t) & =\\langle \\frac{\\mathrm d}{\\mathrm dt}\\left(- \\cos{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(- 2 \\sin{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(1\\right)\\rangle \\\\ & =\\langle \\sin{\\left(t \\right)}, - 2 \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r\\prime(t) & =\\langle 6 \\sin{\\left(t \\right)}, - 3 \\cos{\\left(t \\right)}, 0\\rangle\\cdot \\langle \\sin{\\left(t \\right)}, - 2 \\cos{\\left(t \\right)}, 0\\rangle \\\\ & =\\left(6 \\sin{\\left(t \\right)}\\right)\\cdot \\left(\\sin{\\left(t \\right)}\\right)+\\left(- 3 \\cos{\\left(t \\right)}\\right)\\cdot \\left(- 2 \\cos{\\left(t \\right)}\\right)+\\left(0\\right)\\cdot \\left(0\\right) \\\\ & =\\left(6 \\sin^{2}{\\left(t \\right)}\\right)+\\left(6 \\cos^{2}{\\left(t \\right)}\\right)+\\left(0\\right) \\\\ & =6 \\sin^{2}{\\left(t \\right)} + 6 \\cos^{2}{\\left(t \\right)} \\\\ & =6\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\iint_S\\operatorname{curl}F\\cdot\\mathrm dS & =\\oint_C F\\cdot\\mathrm dr \\\\ & =\\int_{0}^{2 \\pi} F(r(t))\\cdot r\\prime(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{2 \\pi}\\left(6\\right)\\,\\mathrm dt \\\\ & =\\left[\\left(6 t\\right)\\right]_{0}^{2 \\pi} \\\\ & =\\left(\\left(12 \\pi\\right)\\right)-\\left(\\left(0\\right)\\right) \\\\ & =12 \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b9cb0a-4110-548b-9b97-4a59eda21d43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54 \\pi" :db/id #edb/ref 17592186543964} {:answer/id #uuid "27d430ae-f87b-5de5-b7dd-d5309b3c247d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 27 \\pi" :db/id #edb/ref 17592186543969} {:answer/id #uuid "338ede79-c00d-5f63-9f9d-ec76ab18164c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186543971} {:answer/id #uuid "9464ca65-fe98-5ebb-a9dc-694bd2e84b80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-54" :db/id #edb/ref 17592186543990} {:answer/id #uuid "9b040b56-c8c5-5550-a0b5-62c1800fc164" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 54 \\pi" :db/id #edb/ref 17592186543992}] :answer-field/correct {:db/id #edb/ref 17592186543992} :answer-field/id #uuid "872bc545-d968-536d-98aa-6e7c5f5a418e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543985}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aed77857-b62d-52c0-b3e1-b8ab3820a8e9" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\langle 3 \\cos{\\left(t \\right)}, - 3 \\sin{\\left(t \\right)}, 1\\rangle$ for $t\\in [0,2 \\pi).$\nGiven that $F(x,y,z)=\\langle - 3 y, 3 x, 0\\rangle,$ evaluate the integral\n\n$$\n\\iint_S\\operatorname{curl}F\\cdot\\mathrm{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=3 \\cos{\\left(t \\right)},\\quad y=- 3 \\sin{\\left(t \\right)},\\quad z=1\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\langle - 3 y, 3 x, 0\\rangle \\\\ & =\\langle - 3 \\left(- 3 \\sin{\\left(t \\right)}\\right), 3 \\left(3 \\cos{\\left(t \\right)}\\right), 0\\rangle \\\\ & =\\langle 9 \\sin{\\left(t \\right)}, 9 \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nComputing $r\\prime(t),$ we get\n\n$$\n\\begin{aligned}r\\prime(t) & =\\langle \\frac{\\mathrm d}{\\mathrm dt}\\left(3 \\cos{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(- 3 \\sin{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(1\\right)\\rangle \\\\ & =\\langle - 3 \\sin{\\left(t \\right)}, - 3 \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r\\prime(t) & =\\langle 9 \\sin{\\left(t \\right)}, 9 \\cos{\\left(t \\right)}, 0\\rangle\\cdot \\langle - 3 \\sin{\\left(t \\right)}, - 3 \\cos{\\left(t \\right)}, 0\\rangle \\\\ & =\\left(9 \\sin{\\left(t \\right)}\\right)\\cdot \\left(- 3 \\sin{\\left(t \\right)}\\right)+\\left(9 \\cos{\\left(t \\right)}\\right)\\cdot \\left(- 3 \\cos{\\left(t \\right)}\\right)+\\left(0\\right)\\cdot \\left(0\\right) \\\\ & =\\left(- 27 \\sin^{2}{\\left(t \\right)}\\right)+\\left(- 27 \\cos^{2}{\\left(t \\right)}\\right)+\\left(0\\right) \\\\ & =- 27 \\sin^{2}{\\left(t \\right)} - 27 \\cos^{2}{\\left(t \\right)} \\\\ & =-27\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\iint_S\\operatorname{curl}F\\cdot\\mathrm dS & =\\oint_C F\\cdot\\mathrm dr \\\\ & =\\int_{0}^{2 \\pi} F(r(t))\\cdot r\\prime(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{2 \\pi}\\left(-27\\right)\\,\\mathrm dt \\\\ & =\\left[\\left(- 27 t\\right)\\right]_{0}^{2 \\pi} \\\\ & =\\left(\\left(- 54 \\pi\\right)\\right)-\\left(\\left(0\\right)\\right) \\\\ & =- 54 \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39cca0a5-f6a4-53d4-9ca2-2d4cd4160e03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186543973} {:answer/id #uuid "954a7fdc-590b-571c-8601-dd1c7e85834f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 12 \\pi" :db/id #edb/ref 17592186543991} {:answer/id #uuid "a3d38899-69a8-572d-be81-9c243375efa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 \\pi" :db/id #edb/ref 17592186543994} {:answer/id #uuid "b6f127af-a8e0-5329-8318-2d0da584db70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 \\pi" :db/id #edb/ref 17592186543997} {:answer/id #uuid "dac85e8d-ab49-55f9-846c-3dc0d2a4020e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186544003}] :answer-field/correct {:db/id #edb/ref 17592186543997} :answer-field/id #uuid "cf26150f-b273-5664-b7e2-1b1cb4d7f684" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544001}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e208d643-0a26-5834-9a20-0a6aa5d0ec21" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\langle \\cos{\\left(t \\right)}, - 2 \\sin{\\left(t \\right)}, 1\\rangle$ for $t\\in [0,2 \\pi).$\nGiven that $F(x,y,z)=\\langle 3 y, - 3 x, 0\\rangle,$ evaluate the integral\n\n$$\n\\iint_S\\operatorname{curl}F\\cdot\\mathrm{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\cos{\\left(t \\right)},\\quad y=- 2 \\sin{\\left(t \\right)},\\quad z=1\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\langle 3 y, - 3 x, 0\\rangle \\\\ & =\\langle 3 \\left(- 2 \\sin{\\left(t \\right)}\\right), - 3 \\left(\\cos{\\left(t \\right)}\\right), 0\\rangle \\\\ & =\\langle - 6 \\sin{\\left(t \\right)}, - 3 \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nComputing $r\\prime(t),$ we get\n\n$$\n\\begin{aligned}r\\prime(t) & =\\langle \\frac{\\mathrm d}{\\mathrm dt}\\left(\\cos{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(- 2 \\sin{\\left(t \\right)}\\right), \\frac{\\mathrm d}{\\mathrm dt}\\left(1\\right)\\rangle \\\\ & =\\langle - \\sin{\\left(t \\right)}, - 2 \\cos{\\left(t \\right)}, 0\\rangle\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r\\prime(t) & =\\langle - 6 \\sin{\\left(t \\right)}, - 3 \\cos{\\left(t \\right)}, 0\\rangle\\cdot \\langle - \\sin{\\left(t \\right)}, - 2 \\cos{\\left(t \\right)}, 0\\rangle \\\\ & =\\left(- 6 \\sin{\\left(t \\right)}\\right)\\cdot \\left(- \\sin{\\left(t \\right)}\\right)+\\left(- 3 \\cos{\\left(t \\right)}\\right)\\cdot \\left(- 2 \\cos{\\left(t \\right)}\\right)+\\left(0\\right)\\cdot \\left(0\\right) \\\\ & =\\left(6 \\sin^{2}{\\left(t \\right)}\\right)+\\left(6 \\cos^{2}{\\left(t \\right)}\\right)+\\left(0\\right) \\\\ & =6 \\sin^{2}{\\left(t \\right)} + 6 \\cos^{2}{\\left(t \\right)} \\\\ & =6\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\iint_S\\operatorname{curl}F\\cdot\\mathrm dS & =\\oint_C F\\cdot\\mathrm dr \\\\ & =\\int_{0}^{2 \\pi} F(r(t))\\cdot r\\prime(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{2 \\pi}\\left(6\\right)\\,\\mathrm dt \\\\ & =\\left[\\left(6 t\\right)\\right]_{0}^{2 \\pi} \\\\ & =\\left(\\left(12 \\pi\\right)\\right)-\\left(\\left(0\\right)\\right) \\\\ & =12 \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbb58a5e-aca0-59c4-912f-79726bee9634" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186544054}] :answer-field/correct {:db/id #edb/ref 17592186544054} :answer-field/id #uuid "dea7cd5a-b58b-58d0-9d87-50e8f2bc76db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0271a4be-2e1b-5236-8901-8d8148db0863" :question/problem "Suppose $|\\,a\\,|=\\frac{8}{3}$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{5\\pi }{6}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{8}{3}cos\\,\\left(\\frac{5\\pi }{6}\\right) \\\\  & =\\frac{8}{3}\\cdot \\left(-\\frac{\\sqrt{3}}{2}\\right) \\\\  & =-\\frac{4\\sqrt{3}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "377c6d11-a7a7-5f20-ba84-76c30ccac924" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186544024} {:answer/id #uuid "a2ddacf4-9a0d-5239-beb0-73314a47214f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186544041} {:answer/id #uuid "ca910b8a-3d59-557b-ba4f-f2b85fcc6242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186544052} {:answer/id #uuid "e12a00cf-23e1-5372-9913-b6aab316b001" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186544060} {:answer/id #uuid "fc9686b8-dc48-5192-9b13-fc687d782667" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186544066}] :answer-field/correct {:db/id #edb/ref 17592186544060} :answer-field/id #uuid "52ec4aa6-ec74-57c8-ba94-d2f1f232e5b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544030}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d94e22f-d77e-5143-a145-e612cf090a46" :question/problem "Suppose $|\\,a\\,|=\\frac{8}{3}$ and the angle between vectors $a$ and $b$ is $\\theta ={120}^{∘}.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{8}{3}\\operatorname{cos}⁡({120}^{∘}) \\\\  & =\\frac{8}{3}\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-\\frac{4}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c2250f5-ba82-57a9-b821-d253cc658925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{4}" :db/id #edb/ref 17592186544031} {:answer/id #uuid "8ac0314c-36da-5370-b9c6-89940334e38a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{23\\sqrt{3}}{8}" :db/id #edb/ref 17592186544038} {:answer/id #uuid "980cef53-538d-52b2-8352-82089158b9ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23\\sqrt{3}}{8}" :db/id #edb/ref 17592186544040} {:answer/id #uuid "b767c375-74b2-5428-a7d3-42d7260e9610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186544047} {:answer/id #uuid "dad5cdc2-0ab9-5f50-8396-6d41c0d70d23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{8}" :db/id #edb/ref 17592186544057}] :answer-field/correct {:db/id #edb/ref 17592186544040} :answer-field/id #uuid "3e6f4a9e-8b78-5c7f-821a-2b1bf3546f12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544026}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "10125ab8-971b-5485-8172-a971ef4fcf90" :question/problem "Suppose $|\\,a\\,|=\\frac{23}{4}$ and the angle between vectors $a$ and $b$ is $\\theta ={30}^{∘}.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{23}{4}\\operatorname{cos}⁡({30}^{∘}) \\\\  & =\\frac{23}{4}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{23\\sqrt{3}}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45edfae8-3d0b-