86544019} :answer-field/id #uuid "df2ca04f-d6ae-5f52-bafe-c833132086ec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544059}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5178e3f5-c8fd-52bb-a8fd-c681d5274952" :question/problem "Suppose $|\\,a\\,|=\\frac{13\\sqrt{2}}{2}$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{13\\sqrt{2}}{2}cos\\,\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{13\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{13\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f798c441-5d32-5525-ae68-6c973829b26f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{19\\sqrt{6}}{6}" :db/id #edb/ref 17592186544063}] :answer-field/correct {:db/id #edb/ref 17592186544063} :answer-field/id #uuid "c1be4d57-363a-5a2b-ba9e-69a0a1010b97" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544049}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "61f545d5-b5bf-525e-ad10-f5a57d970254" :question/problem "Suppose $|\\,a\\,|=\\frac{19\\sqrt{3}}{3}$ and the angle between vectors $a$ and $b$ is $\\theta ={135}^{∘}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{19\\sqrt{3}}{3}cos\\,({135}^{∘}) \\\\  & =\\frac{19\\sqrt{3}}{3}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =-\\frac{19\\sqrt{6}}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00715636-b497-55df-8978-8cd6b0b16c6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186544013} {:answer/id #uuid "64a9380c-8870-5b9f-b7ee-993d5e87b434" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{19}{6}" :db/id #edb/ref 17592186544034} {:answer/id #uuid "90e689a5-4816-54c5-a9ca-f517fdc93c34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186544039} {:answer/id #uuid "a856af08-ba89-533c-95e3-1439bdee2145" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{19}{6}" :db/id #edb/ref 17592186544043} {:answer/id #uuid "efcf809d-bca6-5300-8ea2-9425644e9542" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{19\\sqrt{3}}{6}" :db/id #edb/ref 17592186544061}] :answer-field/correct {:db/id #edb/ref 17592186544034} :answer-field/id #uuid "25059633-0bc7-5672-ac6d-d1bd3451508e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544020}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a50c95af-9463-551b-82b3-9708a625fa78" :question/problem "Suppose $|\\,a\\,|=\\frac{19}{3}$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{19}{3}\\operatorname{cos}⁡\\left(\\frac{2\\pi }{3}\\right) \\\\  & =\\frac{19}{3}\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-\\frac{19}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e586194-f128-5432-99ca-efd65f783fc8" :answer/type {:db/id #edb/ref 17592186045498}