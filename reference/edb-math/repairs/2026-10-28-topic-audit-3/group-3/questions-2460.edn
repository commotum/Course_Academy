\frac{\\sqrt{14}}{2}=\\frac{\\sqrt{14}}{2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26fbcb50-1945-5ec5-bd49-da5813aeeed8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{106}" :db/id #edb/ref 17592186720438} {:answer/id #uuid "4d30d669-b6a3-5297-9601-5b38ef06ad7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{202}" :db/id #edb/ref 17592186720442} {:answer/id #uuid "95d00143-f876-5f10-aafe-f1fca373084d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\sqrt{3}" :db/id #edb/ref 17592186720451} {:answer/id #uuid "cfcb808c-7e90-5236-8cb7-6fb5a393898c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{146}" :db/id #edb/ref 17592186720458} {:answer/id #uuid "dccd73fd-83b9-5558-bb10-79c7086617d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{227}" :db/id #edb/ref 17592186720459}] :answer-field/correct {:db/id #edb/ref 17592186720459} :answer-field/id #uuid "5631bf19-374d-5c11-97a1-14ac1dc79972" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720443}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b6a791e-bd10-50a6-a54f-532d00a1ee74" :question/problem "Calculate the area of the triangle spanned by $\\mathbf{p}=\\langle 5,2,5\\rangle$ and $\\mathbf{q}=\\langle 1,-4,-1\\rangle$. Give an exact answer." :question/worked-solution "Compute the cross product using a determinant:\n\n$$\n\\begin{aligned}\n\\mathbf{p}\\times \\mathbf{q}&=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\5 & 2 & 5\\\\1 & -4 & -1\\end{vmatrix}\\\\&=((2)\\cdot (-1)-(5)\\cdot (-4))\\mathbf{i}\\\\&\\quad-((5)\\cdot (-1)-(5)\\cdot (1))\\mathbf{j}\\\\&\\quad+((5)\\cdot (-4)-(2)\\cdot (1))\\mathbf{k}\\\\&=\\langle 18,10,-22\\rangle.\n\\end{aligned}\n$$\n\nThe magnitude gives the corresponding parallelogram area:\n\n$$\n\\begin{aligned}\nM&=\\|\\mathbf{p}\\times \\mathbf{q}\\|\\\\&=\\sqrt{(18)^{2}+(10)^{2}+(-22)^{2}}\\\\&=\\sqrt{908}=2\\sqrt{227}.\n\\end{aligned}\n$$\n\nThe triangle has half the area of the parallelogram.\n\n$$\n\\begin{aligned}\nA&=\\frac12 M=\\frac{2\\sqrt{227}}{2}=\\sqrt{227}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea1eaf3-7b33-5435-b5d5-a08380e72a42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{467}}{2}" :db/id #edb/ref 17592186720439} {:answer/id #uuid "5ade3ce1-8900-5f91-910e-70394e2ab19a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{146}}{2}" :db/id #edb/ref 17592186720444} {:answer/id #uuid "a4a4dc71-148d-543f-805b-2979a31c24b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{227}}{2}" :db/id #edb/ref 17592186720452} {:answer/id #uuid "a7c730b4-6066-5f03-bdd5-8a23948ca1b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186720453} {:answer/id #uuid "c8215a59-ebce-5aaf-aa0f-2922008fcc4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{202}}{2}" :db/id #edb/ref 17592186720456}] :answer-field/correct {:db/id #edb/ref 17592186720452} :answer-field/id #uuid "08e0e3b2-b9f0-529c-bc96-6881110624c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720436}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b93063d8-20f0-54d7-b2ff-4a4fadfb313f" :question/problem "Calculate the area of the triangle spanned by $\\mathbf{a}=\\langle 1,-2,3\\rangle$ and $\\mathbf{b}=\\langle 5,-1,4\\rangle$. Give an exact answer." :question/worked-solution "Compute the cross product using a determinant:\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\times \\mathbf{b}&=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\1 & -2 & 3\\\\5 & -1 & 4\\end{vmatrix}\\\\&=((-2)\\cdot (4)-(3)\\cdot (-1))\\mathbf{i}\\\\&\\quad-((1)\\cdot (4)-(3)\\cdot (5))\\mathbf{j}\\\\&\\quad+((1)\\cdot (-1)-(-2)\\cdot (5))\\mathbf{k}\\\\&=\\langle -5,11,9\\rangle.\n\\end{aligned}\n$$\n\nThe magnitude gives the corresponding parallelogram area:\n\n$$\n\\begin{aligned}\nM&=\\|\\mathbf{a}\\times \\mathbf{b}\\|\\\\&=\\sqrt{(-5)^{2}+(11)^{2}+(9)^{2}}\\\\&=\\sqrt{227}=\\sqrt{227}.\n\\end{aligned}\n$$\n\nThe triangle has half the area of the parallelogram.\n\n$$\n\\begin{aligned}\nA&=\\frac12 M=\\frac{\\sqrt{227}}{2}=\\frac{\\sqrt{227}}{2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "443d6278-05fd-570a-8e9b-5dc7ceb3316c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{357}}{17}" :db/id #edb/ref 17592186720541} {:answer/id #uuid "4490e576-afad-5592-a2f5-5a9ccfb62ead" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{357}}{17}" :db/id #edb/ref 17592186720542} {:answer/id #uuid "9c887b2d-2fff-5307-9a2c-544c0f1977f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{105}}{5}" :db/id #edb/ref 17592186720553} {:answer/id #uuid "af71f23c-f57a-5754-aae7-236d514e1580" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186720555} {:answer/id #uuid "f00ad345-4625-5f9c-9f54-49ac4a258747" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14 \\sqrt{17}}{17}" :db/id #edb/ref 17592186720563}] :answer-field/correct {:db/id #edb/ref 17592186720542} :answer-field/id #uuid "789ad3d7-2337-5280-8cff-6a8edee718b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720547}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1041ef46-f42d-59ae-8cd5-a9a7626089c8" :question/problem "Calculate the length of the altitude $QH$ of $\\triangle PQR$, where $P(-2,-2,0)$, $Q(0,-2,1)$, $R(0,0,-3)$. Here $H$ is the foot of the perpendicular from $Q$ to the line $PR$." :question/worked-solution "The altitude $QH$ corresponds to the base $PR$, so\n\n$$\n\\mathcal A_{\\triangle PQR}=\\frac12 PR\\cdot QH.\n$$\n\nForm the required edge vectors from the vertices:\n\n$$\n\\begin{aligned}\\overrightarrow{PR}&=\\langle 0-(-2),0-(-2),-3-0\\rangle,\\\\\n&=\\langle 2,2,-3\\rangle.\\\\\n\\overrightarrow{PQ}&=\\langle 0-(-2),-2-(-2),1-0\\rangle,\\\\\n&=\\langle 2,0,1\\rangle.\\end{aligned}\n$$\n\nCalculate the cross product:\n\n$$\n\\begin{aligned}\\overrightarrow{PR}\\times \\overrightarrow{PQ}&=\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\2&2&-3\\\\2&0&1\\end{vmatrix}\\\\\nw_1&=2\\cdot 1-(-3)\\cdot 0=2,\\\\\nw_2&=(-3)\\cdot 2-2\\cdot 1=-8,\\\\\nw_3&=2\\cdot 0-2\\cdot 2=-4,\\\\\n\\overrightarrow{PR}\\times \\overrightarrow{PQ}&=\\langle 2,-8,-4\\rangle.\\end{aligned}\n$$\n\nThe magnitude of the cross product gives the parallelogram area:\n\n$$\n\\left|\\overrightarrow{PR}\\times \\overrightarrow{PQ}\\right|=\\sqrt{2^2+(-8)^2+(-4)^2}=2 \\sqrt{21}.\n$$\n\nThe matching base length is\n\n$$\nPR=\\sqrt{2^2+2^2+(-3)^2}=\\sqrt{17}.\n$$\n\nThe triangle has half the parallelogram area:\n\n$$\n\\mathcal A_{\\triangle PQR}=\\frac12\\left(2 \\sqrt{21}\\right)=\\sqrt{21}.\n$$\n\nSubstitute the area and matching base, then solve for the altitude:\n\n$$\n\\begin{aligned}\\sqrt{21}&=\\frac12\\left(\\sqrt{17}\\right)QH,\\\\\n2 \\sqrt{21}&=\\left(\\sqrt{17}\\right)QH,\\\\\nQH&=\\frac{2 \\sqrt{21}}{\\sqrt{17}}=\\frac{2 \\sqrt{357}}{17}.\\end{aligned}\n$$\n\nThe altitude is $\\frac{2 \\sqrt{357}}{17}$ units."}] [{:db/id #edb/ref 17592186720539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "956754f3-438c-5734-a29c-38535def90c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{182}}{13}" :db/id #edb/ref 17592186720551} {:answer/id #uuid "e040bc26-b8af-583c-91ca-1fcc75bf2404" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18 \\sqrt{13}}{13}" :db/id #edb/ref 17592186720561} {:answer/id #uuid "ee9de1ae-cbe8-5c89-88e3-d819671dc44e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186720562} {:answer/id #uuid "f56b6770-90dd-5c05-a501-4d3ddea483b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{14}}{2}" :db/id #edb/ref 17592186720565} {:answer/id #uuid "fa71e4b2-812e-5b60-bc37-b9408fa1b568" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14 \\sqrt{13}" :db/id #edb/ref 17592186720566}] :answer-field/correct {:db/id #edb/ref 17592186720562} :answer-field/id #uuid "c0380cf5-1277-5472-91d3-9eaca32db731" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720557}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4315efeb-cb2f-5497-9f14-fd7a983f656b" :question/problem "Calculate the length of the altitude $MH$ of $\\triangle LMN$, where $L(-2,0,1)$, $M(-4,3,2)$, $N(-5,-2,1)$. Here $H$ is the foot of the perpendicular from $M$ to the line $LN$." :question/worked-solution "The altitude $MH$ corresponds to the base $LN$, so\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12 LN\\cdot MH.\n$$\n\nForm the required edge vectors from the vertices:\n\n$$\n\\begin{aligned}\\overrightarrow{LN}&=\\langle -5-(-2),-2-0,1-1\\rangle,\\\\\n&=\\langle -3,-2,0\\rangle.\\\\\n\\overrightarrow{LM}&=\\langle -4-(-2),3-0,2-1\\rangle,\\\\\n&=\\langle -2,3,1\\rangle.\\end{aligned}\n$$\n\nCalculate the cross product:\n\n$$\n\\begin{aligned}\\overrightarrow{LN}\\times \\overrightarrow{LM}&=\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\-3&-2&0\\\\-2&3&1\\end{vmatrix}\\\\\nw_1&=(-2)\\cdot 1-0\\cdot 3=-2,\\\\\nw_2&=0\\cdot (-2)-(-3)\\cdot 1=3,\\\\\nw_3&=(-3)\\cdot 3-(-2)\\cdot (-2)=-13,\\\\\n\\overrightarrow{LN}\\times \\overrightarrow{LM}&=\\langle -2,3,-13\\rangle.\\end{aligned}\n$$\n\nThe magnitude of the cross product gives the parallelogram area:\n\n$$\n\\left|\\overrightarrow{LN}\\times \\overrightarrow{LM}\\right|=\\sqrt{(-2)^2+3^2+(-13)^2}=\\sqrt{182}.\n$$\n\nThe matching base length is\n\n$$\nLN=\\sqrt{(-3)^2+(-2)^2+0^2}=\\sqrt{13}.\n$$\n\nThe triangle has half the parallelogram area:\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12\\left(\\sqrt{182}\\right)=\\frac{\\sqrt{182}}{2}.\n$$\n\nSubstitute the area and matching base, then solve for the altitude:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{182}}{2}&=\\frac12\\left(\\sqrt{13}\\right)MH,\\\\\n\\sqrt{182}&=\\left(\\sqrt{13}\\right)MH,\\\\\nMH&=\\frac{\\sqrt{182}}{\\sqrt{13}}=\\sqrt{14}.\\end{aligned}\n$$\n\nThe altitude is $\\sqrt{14}$ units."}] [{:db/id #edb/ref 17592186720549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1594044c-0cd8-532c-b66f-550d78501eff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3230}}{38}" :db/id #edb/ref 17592186720535} {:answer/id #uuid "621aace2-54e4-599c-9f50-91f7dbb67627" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{170}}{19}" :db/id #edb/ref 17592186720544} {:answer/id #uuid "7ed5c3e4-659c-50cf-800e-aeab876a2617" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{51}}{3}" :db/id #edb/ref 17592186720548} {:answer/id #uuid "99acbef1-231d-5276-9152-b909f886c794" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{3230}}{19}" :db/id #edb/ref 17592186720552} {:answer/id #uuid "d73cf83e-3ceb-545a-9697-27087fd6e7b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3230}}{19}" :db/id #edb/ref 17592186720560}] :answer-field/correct {:db/id #edb/ref 17592186720560} :answer-field/id #uuid "d5b5d0ff-4b93-587a-88d0-f9752dafa75d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720559}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87f36543-2de1-5cf3-878e-e406552f0ea7" :question/problem "Calculate the length of the altitude $NH$ of $\\triangle LMN$, where $L(-2,-2,2)$, $M(1,-1,-1)$, $N(-1,0,4)$. Here $H$ is the foot of the perpendicular from $N$ to the line $LM$." :question/worked-solution "The altitude $NH$ corresponds to the base $LM$, so\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12 LM\\cdot NH.\n$$\n\nForm the required edge vectors from the vertices:\n\n$$\n\\begin{aligned}\\overrightarrow{LM}&=\\langle 1-(-2),-1-(-2),-1-2\\rangle,\\\\\n&=\\langle 3,1,-3\\rangle.\\\\\n\\overrightarrow{LN}&=\\langle -1-(-2),0-(-2),4-2\\rangle,\\\\\n&=\\langle 1,2,2\\rangle.\\end{aligned}\n$$\n\nCalculate the cross product:\n\n$$\n\\begin{aligned}\\overrightarrow{LM}\\times \\overrightarrow{LN}&=\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\3&1&-3\\\\1&2&2\\end{vmatrix}\\\\\nw_1&=1\\cdot 2-(-3)\\cdot 2=8,\\\\\nw_2&=(-3)\\cdot 1-3\\cdot 2=-9,\\\\\nw_3&=3\\cdot 2-1\\cdot 1=5,\\\\\n\\overrightarrow{LM}\\times \\overrightarrow{LN}&=\\langle 8,-9,5\\rangle.\\end{aligned}\n$$\n\nThe magnitude of the cross product gives the parallelogram area:\n\n$$\n\\left|\\overrightarrow{LM}\\times \\overrightarrow{LN}\\right|=\\sqrt{8^2+(-9)^2+5^2}=\\sqrt{170}.\n$$\n\nThe matching base length is\n\n$$\nLM=\\sqrt{3^2+1^2+(-3)^2}=\\sqrt{19}.\n$$\n\nThe triangle has half the parallelogram area:\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12\\left(\\sqrt{170}\\right)=\\frac{\\sqrt{170}}{2}.\n$$\n\nSubstitute the area and matching base, then solve for the altitude:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{170}}{2}&=\\frac12\\left(\\sqrt{19}\\right)NH,\\\\\n\\sqrt{170}&=\\left(\\sqrt{19}\\right)NH,\\\\\nNH&=\\frac{\\sqrt{170}}{\\sqrt{19}}=\\frac{\\sqrt{3230}}{19}.\\end{aligned}\n$$\n\nThe altitude is $\\frac{\\sqrt{3230}}{19}$ units."}] [{:db/id #edb/ref 17592186720554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202e3007-5778-5a4a-a056-79792e34e474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{38}" :db/id #edb/ref 17592186720536} {:answer/id #uuid "3d853c16-aff4-5163-9bee-e488cc0659b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{19}}{2}" :db/id #edb/ref 17592186720538} {:answer/id #uuid "4372e6fc-3160-5785-b41b-4fa9664ebea6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{38}}{2}" :db/id #edb/ref 17592186720540} {:answer/id #uuid "6303dd96-60e3-5f45-8ab0-cb492fd1c737" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{190}}{10}" :db/id #edb/ref 17592186720545} {:answer/id #uuid "f1448094-d764-5b70-9f91-d48f68811d1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sqrt{38}" :db/id #edb/ref 17592186720564}] :answer-field/correct {:db/id #edb/ref 17592186720540} :answer-field/id #uuid "0f4126f1-83f8-5fd9-9208-b73fe85cd40d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720532}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a066069b-2681-5143-b55b-56b68e1e9743" :question/problem "Calculate the length of the altitude $LH$ of $\\triangle LMN$, where $L(0,-1,-2)$, $M(2,0,1)$, $N(1,-1,1)$. Here $H$ is the foot of the perpendicular from $L$ to the line $MN$." :question/worked-solution "The altitude $LH$ corresponds to the base $MN$, so\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12 MN\\cdot LH.\n$$\n\nForm the required edge vectors from the vertices:\n\n$$\n\\begin{aligned}\\overrightarrow{MN}&=\\langle 1-2,-1-0,1-1\\rangle,\\\\\n&=\\langle -1,-1,0\\rangle.\\\\\n\\overrightarrow{ML}&=\\langle 0-2,-1-0,-2-1\\rangle,\\\\\n&=\\langle -2,-1,-3\\rangle.\\end{aligned}\n$$\n\nCalculate the cross product:\n\n$$\n\\begin{aligned}\\overrightarrow{MN}\\times \\overrightarrow{ML}&=\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\-1&-1&0\\\\-2&-1&-3\\end{vmatrix}\\\\\nw_1&=(-1)\\cdot (-3)-0\\cdot (-1)=3,\\\\\nw_2&=0\\cdot (-2)-(-1)\\cdot (-3)=-3,\\\\\nw_3&=(-1)\\cdot (-1)-(-1)\\cdot (-2)=-1,\\\\\n\\overrightarrow{MN}\\times \\overrightarrow{ML}&=\\langle 3,-3,-1\\rangle.\\end{aligned}\n$$\n\nThe magnitude of the cross product gives the parallelogram area:\n\n$$\n\\left|\\overrightarrow{MN}\\times \\overrightarrow{ML}\\right|=\\sqrt{3^2+(-3)^2+(-1)^2}=\\sqrt{19}.\n$$\n\nThe matching base length is\n\n$$\nMN=\\sqrt{(-1)^2+(-1)^2+0^2}=\\sqrt{2}.\n$$\n\nThe triangle has half the parallelogram area:\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12\\left(\\sqrt{19}\\right)=\\frac{\\sqrt{19}}{2}.\n$$\n\nSubstitute the area and matching base, then solve for the altitude:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{19}}{2}&=\\frac12\\left(\\sqrt{2}\\right)LH,\\\\\n\\sqrt{19}&=\\left(\\sqrt{2}\\right)LH,\\\\\nLH&=\\frac{\\sqrt{19}}{\\sqrt{2}}=\\frac{\\sqrt{38}}{2}.\\end{aligned}\n$$\n\nThe altitude is $\\frac{\\sqrt{38}}{2}$ units."}] [{:db/id #edb/ref 17592186720558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1219a99a-4eb4-59f4-95f0-0b0e48615824" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{3230}}{19}" :db/id #edb/ref 17592186720534} {:answer/id #uuid "4b721c35-c5d1-5c04-aec2-c4caae07f49a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{22 \\sqrt{19}}{19}" :db/id #edb/ref 17592186720543} {:answer/id #uuid "7390695a-e989-50f4-ab10-66d5040963ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{170}" :db/id #edb/ref 17592186720546} {:answer/id #uuid "88ecfc49-70b9-5860-83dd-095c1bbc2c90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3230}}{19}" :db/id #edb/ref 17592186720550} {:answer/id #uuid "bdf84980-a267-5166-ad84-3f427dcd4dd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{418}}{19}" :db/id #edb/ref 17592186720556}] :answer-field/correct {:db/id #edb/ref 17592186720550} :answer-field/id #uuid "2379a359-3e4f-568d-b45e-b3110b5c7d62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720537}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c5aa664d-ab4b-53ae-801c-ab2469bf0ae1" :question/problem "Calculate the length of the altitude $NH$ of $\\triangle LMN$, where $L(-1,0,0)$, $M(0,-3,-3)$, $N(-3,-2,1)$. Here $H$ is the foot of the perpendicular from $N$ to the line $LM$." :question/worked-solution "The altitude $NH$ corresponds to the base $LM$, so\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12 LM\\cdot NH.\n$$\n\nForm the required edge vectors from the vertices:\n\n$$\n\\begin{aligned}\\overrightarrow{LM}&=\\langle 0-(-1),-3-0,-3-0\\rangle,\\\\\n&=\\langle 1,-3,-3\\rangle.\\\\\n\\overrightarrow{LN}&=\\langle -3-(-1),-2-0,1-0\\rangle,\\\\\n&=\\langle -2,-2,1\\rangle.\\end{aligned}\n$$\n\nCalculate the cross product:\n\n$$\n\\begin{aligned}\\overrightarrow{LM}\\times \\overrightarrow{LN}&=\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\1&-3&-3\\\\-2&-2&1\\end{vmatrix}\\\\\nw_1&=(-3)\\cdot 1-(-3)\\cdot (-2)=-9,\\\\\nw_2&=(-3)\\cdot (-2)-1\\cdot 1=5,\\\\\nw_3&=1\\cdot (-2)-(-3)\\cdot (-2)=-8,\\\\\n\\overrightarrow{LM}\\times \\overrightarrow{LN}&=\\langle -9,5,-8\\rangle.\\end{aligned}\n$$\n\nThe magnitude of the cross product gives the parallelogram area:\n\n$$\n\\left|\\overrightarrow{LM}\\times \\overrightarrow{LN}\\right|=\\sqrt{(-9)^2+5^2+(-8)^2}=\\sqrt{170}.\n$$\n\nThe matching base length is\n\n$$\nLM=\\sqrt{1^2+(-3)^2+(-3)^2}=\\sqrt{19}.\n$$\n\nThe triangle has half the parallelogram area:\n\n$$\n\\mathcal A_{\\triangle LMN}=\\frac12\\left(\\sqrt{170}\\right)=\\frac{\\sqrt{170}}{2}.\n$$\n\nSubstitute the area and matching base, then solve for the altitude:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{170}}{2}&=\\frac12\\left(\\sqrt{19}\\right)NH,\\\\\n\\sqrt{170}&=\\left(\\sqrt{19}\\right)NH,\\\\\nNH&=\\frac{\\sqrt{170}}{\\sqrt{19}}=\\frac{\\sqrt{3230}}{19}.\\end{aligned}\n$$\n\nThe altitude is $\\frac{\\sqrt{3230}}{19}$ units."}] [{:db/id #edb/ref 17592186720573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7538b1a7-aca0-5f57-b85e-d3ecce596be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186720582} {:answer/id #uuid "baf4934f-2479-5801-871f-d331cb3c1161" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186720590} {:answer/id #uuid "d7490aca-4808-5e53-8d88-077b5f9e333a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186720593} {:answer/id #uuid "eb3ba4a2-0d2b-5024-9705-76fa1ed33cba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186720594} {:answer/id #uuid "feaf0fde-0102-56c8-8dcf-97910e6875c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5 \\sqrt{2}" :db/id #edb/ref 17592186720599}] :answer-field/correct {:db/id #edb/ref 17592186720594} :answer-field/id #uuid "7b6f0871-9165-5019-8f86-3c9ed3a53b27" :answer-field/key "area" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720583}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2eaf0e14-0141-5e26-9eae-7583da001e86" :question/problem "Calculate the exact area of triangle $DEF$ with vertices $D(0,-3,4)$, $E(-2,1,2)$, $F(-3,0,3)$, in square units." :question/worked-solution "Form two sides with the same starting vertex:\n$$\n\\begin{aligned}\n\\overrightarrow{FD}&=\\langle 0-(-3),-3-0,4-3\\rangle \\\\\n&=\\langle 3,-3,1\\rangle \\\\\n\\overrightarrow{FE}&=\\langle -2-(-3),1-0,2-3\\rangle \\\\\n&=\\langle 1,1,-1\\rangle\n\\end{aligned}\n$$\n\nCompute the cross product:\n$$\n\\overrightarrow{FD}\\times \\overrightarrow{FE}=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\3 & -3 & 1\\\\1 & 1 & -1\\end{vmatrix}\n$$\n$$\n\\begin{aligned}\nw_1&=(-3)\\cdot (-1)-1\\cdot 1=2 \\\\\nw_2&=1\\cdot 1-3\\cdot (-1)=4 \\\\\nw_3&=3\\cdot 1-(-3)\\cdot 1=6 \\\\\n\\overrightarrow{FD}\\times \\overrightarrow{FE}&=\\langle 2,4,6\\rangle\n\\end{aligned}\n$$\n\nThe magnitude is the parallelogram's area:\n$$\n\\begin{aligned}\n\\lVert \\overrightarrow{FD}\\times \\overrightarrow{FE}\\rVert&=\\sqrt{2^2+4^2+6^2} \\\\\n&=\\sqrt{56}=2 \\sqrt{14}\n\\end{aligned}\n$$\n\nThe triangle has half that area:\n$$\nT=\\frac12\\lVert \\overrightarrow{FD}\\times \\overrightarrow{FE}\\rVert=\\frac{2 \\sqrt{14}}{2}=\\sqrt{14}.\n$$"}] [{:db/id #edb/ref 17592186720579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d0836a-ac5f-543b-906b-ba263d8eea6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13}}{2}" :db/id #edb/ref 17592186720569}] :answer-field/correct {:db/id #edb/ref 17592186720569} :answer-field/id #uuid "55e1d944-a35a-59a8-b4fa-f0c7776ca708" :answer-field/key "area" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186720576}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "67fa9248-4b82-5fa3-a45d-f50b4b13a464" :question/problem "Calculate the exact area of triangle $RST$ with vertices $R(0,-3,3)$, $S(2,0,0)$, $T(-2,-5,6)$, in square units.\n\n$T=$ {{area}}" :question/worked-solution "Form two sides with the same starting vertex:\n$$\n\\begin{aligned}\n\\overrightarrow{RS}&=\\langle 2-0,0-(-3),0-3\\rangle \\\\\n&=\\langle 2,3,-3\\rangle \\\\\n\\overrightarrow{RT}&=\\langle -2-0,-5-(-3),6-3\\rangle \\\\\n&=\\langle -2,-2,3\\rangle\n\\end{aligned}\n$$\n\nCompute the cross product:\n$$\n\\overrightarrow{RS}\\times \\overrightarrow{RT}=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\2 & 3 & -3\\\\-2 & -2 & 3\\end{vmatrix}\n$$\n$$\n\\begin{aligned}\nw_1&=3\\cdot 3-(-3)\\cdot (-2)=3 \\\\\nw_2&=(-3)\\cdot (-2)-2\\cdot 3=0 \\\\\nw_3&=2\\cdot (-2)-3\\cdot (-2)=2 \\\\\n\\overrightarrow{RS}\\times \\overrightarrow{RT}&=\\langle 3,0,2\\rangle\n\\end{aligned}\n$$\n\nThe magnitude is the parallelogram's area:\n$$\n\\begin{aligned}\n\\lVert \\overrightarrow{RS}\\times \\overrightarrow{RT}\\rVert&=\\sqrt{3^2+0^2+2^2} \\\\\n&=\\sqrt{13}=\\sqrt{13}\n\\end{aligned}\n$$\n\nThe triangle has half that area:\n$$\nT=\\frac12\\lVert \\overrightarrow{RS}\\times \\overrightarrow{RT}\\rVert=\\frac{\\sqrt{13}}{2}=\\frac{\\sqrt{13}}{2}.\n$$"}] [{:db/id #edb/ref 17592186720588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a50f372-861e-5abd-8962-801e39e85c25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\sqrt{42}}{2}" :db/id #edb/ref 17592186720580} {:answer/id #uuid "8a55c974-582f-568f-99f1-bef93bd9bb78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{322}}{2}" :db/id #edb/ref 17592186720584} {:answer/id #uuid "b2a3e792-5d5d-5da3-bc0f-4f6238aafc2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{370}}{2}" :db/id #edb/ref 17592186720587} {:answer/id #uuid "b7c976bf-3356-55af-aac3-7f821727afbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{106}}{2}" :db/id #edb/ref 17592186720589} {:answer/id #uuid "f23159b3-87b9-5070-9f94-c73683463363" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{10}}{2}" :db/id #edb/ref 17592186720596}] :answer-field/correct {:db/id #edb/ref 17592186720584} :answer-field/id #uuid "fdd4bb7b-a9b4-54e7-b791-55b7cb5b57fe" :answer-field/key "area" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720598}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b4a48894-0744-57b0-b887-2c6daef7fd3a" :question/problem "Calculate the exact area of triangle $ABC$ with vertices $A(-1,2,0)$, $B(0,1,-6)$, $C(-2,-1,-3)$, in square units." :question/worked-solution "Form two sides with the same starting vertex:\n$$\n\\begin{aligned}\n\\overrightarrow{CA}&=\\langle -1-(-2),2-(-1),0-(-3)\\rangle \\\\\n&=\\langle 1,3,3\\rangle \\\\\n\\overrightarrow{CB}&=\\langle 0-(-2),1-(-1),-6-(-3)\\rangle \\\\\n&=\\langle 2,2,-3\\rangle\n\\end{aligned}\n$$\n\nCompute the cross product:\n$$\n\\overrightarrow{CA}\\times \\overrightarrow{CB}=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\1 & 3 & 3\\\\2 & 2 & -3\\end{vmatrix}\n$$\n$$\n\\begin{aligned}\nw_1&=3\\cdot (-3)-3\\cdot 2=-15 \\\\\nw_2&=3\\cdot 2-1\\cdot (-3)=9 \\\\\nw_3&=1\\cdot 2-3\\cdot 2=-4 \\\\\n\\overrightarrow{CA}\\times \\overrightarrow{CB}&=\\langle -15,9,-4\\rangle\n\\end{aligned}\n$$\n\nThe magnitude is the parallelogram's area:\n$$\n\\begin{aligned}\n\\lVert \\overrightarrow{CA}\\times \\overrightarrow{CB}\\rVert&=\\sqrt{(-15)^2+9^2+(-4)^2} \\\\\n&=\\sqrt{322}=\\sqrt{322}\n\\end{aligned}\n$$\n\nThe triangle has half that area:\n$$\nT=\\frac12\\lVert \\overrightarrow{CA}\\times \\overrightarrow{CB}\\rVert=\\frac{\\sqrt{322}}{2}=\\frac{\\sqrt{322}}{2}.\n$$"}] [{:db/id #edb/ref 17592186720592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18264a23-dfc5-5caa-9627-b42f926017d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{194}}{2}" :db/id #edb/ref 17592186720571} {:answer/id #uuid "598c3fcf-ca9b-52da-ad6a-6d0f816d7780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{146}}{2}" :db/id #edb/ref 17592186720577} {:answer/id #uuid "6261d143-cbad-5d55-be4b-aadb397a9c10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{122}}{2}" :db/id #edb/ref 17592186720578} {:answer/id #uuid "73c76ad6-09bc-5f51-948c-c66b38577d33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{74}}{2}" :db/id #edb/ref 17592186720581} {:answer/id #uuid "ec85dec5-3d25-5fa4-93df-dd88e7061d7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{38}}{2}" :db/id #edb/ref 17592186720595}] :answer-field/correct {:db/id #edb/ref 17592186720577} :answer-field/id #uuid "481945b9-fb4a-5ab6-a2b7-1c730f4ccc87" :answer-field/key "area" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720575}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c802c8b3-420e-524c-a797-e50da0b27c88" :question/problem "Calculate the exact area of triangle $DEF$ with vertices $D(0,3,-2)$, $E(1,-1,-1)$, $F(-2,2,0)$, in square units." :question/worked-solution "Form two sides with the same starting vertex:\n$$\n\\begin{aligned}\n\\overrightarrow{FD}&=\\langle 0-(-2),3-2,-2-0\\rangle \\\\\n&=\\langle 2,1,-2\\rangle \\\\\n\\overrightarrow{FE}&=\\langle 1-(-2),-1-2,-1-0\\rangle \\\\\n&=\\langle 3,-3,-1\\rangle\n\\end{aligned}\n$$\n\nCompute the cross product:\n$$\n\\overrightarrow{FD}\\times \\overrightarrow{FE}=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\2 & 1 & -2\\\\3 & -3 & -1\\end{vmatrix}\n$$\n$$\n\\begin{aligned}\nw_1&=1\\cdot (-1)-(-2)\\cdot (-3)=-7 \\\\\nw_2&=(-2)\\cdot 3-2\\cdot (-1)=-4 \\\\\nw_3&=2\\cdot (-3)-1\\cdot 3=-9 \\\\\n\\overrightarrow{FD}\\times \\overrightarrow{FE}&=\\langle -7,-4,-9\\rangle\n\\end{aligned}\n$$\n\nThe magnitude is the parallelogram's area:\n$$\n\\begin{aligned}\n\\lVert \\overrightarrow{FD}\\times \\overrightarrow{FE}\\rVert&=\\sqrt{(-7)^2+(-4)^2+(-9)^2} \\\\\n&=\\sqrt{146}=\\sqrt{146}\n\\end{aligned}\n$$\n\nThe triangle has half that area:\n$$\nT=\\frac12\\lVert \\overrightarrow{FD}\\times \\overrightarrow{FE}\\rVert=\\frac{\\sqrt{146}}{2}=\\frac{\\sqrt{146}}{2}.\n$$"}] [{:db/id #edb/ref 17592186720597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0715958a-f414-5c87-870f-ae4e984bb016" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{5}}{2}" :db/id #edb/ref 17592186720570} {:answer/id #uuid "18e4359c-b002-508c-b83c-3b363505e9d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{77}}{2}" :db/id #edb/ref 17592186720572} {:answer/id #uuid "33996198-b71d-5688-a396-a4f207ee9c59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{101}}{2}" :db/id #edb/ref 17592186720574} {:answer/id #uuid "b119f816-44fd-5064-bcbe-ba54caaa171a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{17}}{2}" :db/id #edb/ref 17592186720586} {:answer/id #uuid "c2bf2db1-6096-555c-bc68-62d5f44fb1e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{29}}{2}" :db/id #edb/ref 17592186720591}] :answer-field/correct {:db/id #edb/ref 17592186720591} :answer-field/id #uuid "a2ff56c2-f069-5739-9526-6d36e61c7177" :answer-field/key "area" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186720585}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbbb2833-16ff-5b2d-b399-0b25da18b97e" :question/problem "Calculate the exact area of triangle $LMN$ with vertices $L(-3,-5,-2)$, $M(-3,-4,0)$, $N(-1,-2,1)$, in square units." :question/worked-solution "Form two sides with the same starting vertex:\n$$\n\\begin{aligned}\n\\overrightarrow{NL}&=\\langle -3-(-1),-5-(-2),-2-1\\rangle \\\\\n&=\\langle -2,-3,-3\\rangle \\\\\n\\overrightarrow{NM}&=\\langle -3-(-1),-4-(-2),0-1\\rangle \\\\\n&=\\langle -2,-2,-1\\rangle\n\\end{aligned}\n$$\n\nCompute the cross product:\n$$\n\\overrightarrow{NL}\\times \\overrightarrow{NM}=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\-2 & -3 & -3\\\\-2 & -2 & -1\\end{vmatrix}\n$$\n$$\n\\begin{aligned}\nw_1&=(-3)\\cdot (-1)-(-3)\\cdot (-2)=-3 \\\\\nw_2&=(-3)\\cdot (-2)-(-2)\\cdot (-1)=4 \\\\\nw_3&=(-2)\\cdot (-2)-(-3)\\cdot (-2)=-2 \\\\\n\\overrightarrow{NL}\\times \\overrightarrow{NM}&=\\langle -3,4,-2\\rangle\n\\end{aligned}\n$$\n\nThe magnitude is the parallelogram's area:\n$$\n\\begin{aligned}\n\\lVert \\overrightarrow{NL}\\times \\overrightarrow{NM}\\rVert&=\\sqrt{(-3)^2+4^2+(-2)^2} \\\\\n&=\\sqrt{29}=\\sqrt{29}\n\\end{aligned}\n$$\n\nThe triangle has half that area:\n$$\nT=\\frac12\\lVert \\overrightarrow{NL}\\times \\overrightarrow{NM}\\rVert=\\frac{\\sqrt{29}}{2}=\\frac{\\sqrt{29}}{2}.\n$$"}] [{:db/id #edb/ref 17592186721317 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0759e150-9651-577d-b1e8-5ba6187da643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac14" :db/id #edb/ref 17592186721310} {:answer/id #uuid "7827895f-5658-5361-b658-667a7b920baa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac47" :db/id #edb/ref 17592186721316} {:answer/id #uuid "88f011a4-4138-5a80-8588-09e2ba2e2722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac47" :db/id #edb/ref 17592186721318} {:answer/id #uuid "8ef18a38-2c7f-5a99-8aca-679bedd32ad9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{11}{20}" :db/id #edb/ref 17592186721319} {:answer/id #uuid "9c638014-349d-55ad-864e-4a0370583dad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac9{28}" :db/id #edb/ref 17592186721320}] :answer-field/correct {:db/id #edb/ref 17592186721316} :answer-field/id #uuid "0466a5f0-2854-5653-b729-96c8fd45a9f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721309}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7cb9caac-9593-511a-9480-6d9f8acf4ea6" :question/problem "The path $C$ follows the Cartesian curve $y^3=x+1$ from $A(-1,0)$ to $B(0,1)$. Evaluate\n\n$$\n\\int_C xy\\,\\mathrm{d}x+(x+y)\\,\\mathrm{d}y.\n$$" :question/worked-solution "Rearrange the curve equation as $x=y^3-1$. Choosing $y$ as the parameter gives\n\n$$\nx(t)=t^3-1,\\qquad y(t)=t,\\qquad 0\\le t\\le 1.\n$$\n\nAt $t=0$ the point is $(-1,0)$, and at $t=1$ it is $(0,1)$, so this parametrization has the required direction. Its derivatives are\n\n$$\n\\frac{\\mathrm{d}x}{\\mathrm{d}t}=3t^2,\\qquad \\frac{\\mathrm{d}y}{\\mathrm{d}t}=1.\n$$\n\nWrite the given integral as $I$. Substituting both coordinates into both coefficients and retaining the derivative factors gives\n\n$$\n\\begin{aligned}\nI\n&=\\int_0^1\\bigl((t^3-1)t\\cdot 3t^2+(t^3-1+t)\\cdot 1\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_0^1(3t^6-2t^3+t-1)\\,\\mathrm{d}t\\\\\n&=\\left[\\frac{3t^7}{7}-\\frac{t^4}{2}+\\frac{t^2}{2}-t\\right]_0^1\\\\\n&=\\frac{3}{7}-\\frac12+\\frac12-1\\\\\n&=-\\frac47.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38d00505-988f-59ad-9212-dd66c765f7c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{14}{3}" :db/id #edb/ref 17592186721313} {:answer/id #uuid "a46bfb92-a076-5937-bfa8-65ec8c4007ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{22}{3}" :db/id #edb/ref 17592186721321} {:answer/id #uuid "af1423ed-ceae-5ba9-a897-c2543fe4042c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186721323} {:answer/id #uuid "cd6e20a9-014d-5998-934e-72782410687a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186721325} {:answer/id #uuid "ef7df896-0ebf-5c66-b4dc-bc95cc814064" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186721328}] :answer-field/correct {:db/id #edb/ref 17592186721323} :answer-field/id #uuid "d8d6181b-b102-5803-813c-b12b0e1dd851" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721326}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c02acbe3-1f10-5f56-956c-2ac9a1f0b577" :question/problem "The path $C$ follows the parabola $y=x^2-x$ from $A(0,0)$ to $B(2,2)$. Evaluate\n\n$$\n\\int_C xy\\,\\mathrm{d}x+x\\,\\mathrm{d}y.\n$$" :question/worked-solution "Since $y$ is given as a function of $x$, choose\n\n$$\nx(t)=t,\\qquad y(t)=t^2-t,\\qquad 0\\le t\\le 2.\n$$\n\nThe endpoints are reached in the stated order. Also,\n\n$$\n\\frac{\\mathrm{d}x}{\\mathrm{d}t}=1,\\qquad \\frac{\\mathrm{d}y}{\\mathrm{d}t}=2t-1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int_C xy\\,\\mathrm{d}x+x\\,\\mathrm{d}y\n&=\\int_0^2\\bigl(t(t^2-t)\\cdot 1+t(2t-1)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_0^2(t^3+t^2-t)\\,\\mathrm{d}t\\\\\n&=\\left[\\frac{t^4}{4}+\\frac{t^3}{3}-\\frac{t^2}{2}\\right]_0^2\\\\\n&=4+\\frac{8}{3}-2\\\\\n&=\\frac{14}{3}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1575654e-4239-540b-9022-5b727bfb16c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^2 t^2\\sqrt{1+(2t-1)^2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186721311} {:answer/id #uuid "36995c02-4577-52bf-90eb-e6cb4d541f8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^1(3t^2-2t)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721312} {:answer/id #uuid "570b7bf5-2cc3-5ff0-a25e-0fd297b1dbc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^2 t^2\\,\\mathrm{d}t" :db/id #edb/ref 17592186721315} {:answer/id #uuid "aa13e661-1f89-56cb-ab92-976fed466652" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^2(3t^2-2t)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721322} {:answer/id #uuid "f2ee2fe5-1921-53ed-8f2f-48d611044264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^2(3t^2-t)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721329}] :answer-field/correct {:db/id #edb/ref 17592186721322} :answer-field/id #uuid "53777877-0e09-58ed-b6f5-6bb44375d6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721314}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e4e6826d-ffdf-5a34-81ab-0c22a18d7414" :question/problem "The path $C$ follows $y=x^2-x$ from $A(0,0)$ to $B(2,2)$. Consider\n\n$$\n\\int_C y\\,\\mathrm{d}x+x\\,\\mathrm{d}y.\n$$\n\n*Hint: Use $x(t)=t$ and $y(t)=t^2-t$.*\n\nUsing this parametrization, which definite integral is equivalent to the line integral?" :question/worked-solution "The endpoint $x$-coordinates give $0\\le t\\le 2$. Differentiating the supplied parametrization gives\n\n$$\n\\frac{\\mathrm{d}x}{\\mathrm{d}t}=1,\\qquad \\frac{\\mathrm{d}y}{\\mathrm{d}t}=2t-1.\n$$\n\nSubstitute into each coefficient and multiply by its corresponding derivative:\n\n$$\n\\begin{aligned}\n\\int_C y\\,\\mathrm{d}x+x\\,\\mathrm{d}y\n&=\\int_0^2\\bigl((t^2-t)\\cdot 1+t(2t-1)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_0^2(3t^2-2t)\\,\\mathrm{d}t.\n\\end{aligned}\n$$\n\nThis is the requested definite integral; no evaluation is required."}] [{:db/id #edb/ref 17592186721433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b8e0d1-a521-5417-b8da-71d5b2396f02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{14}{3}" :db/id #edb/ref 17592186721436} {:answer/id #uuid "5593f30c-6c0e-5716-95bf-0d047690600c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac23" :db/id #edb/ref 17592186721438} {:answer/id #uuid "84e60402-24b5-51b5-8eb6-ffbb97263b43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{26}{3}" :db/id #edb/ref 17592186721442} {:answer/id #uuid "87da1cf0-1cbb-55d8-a068-12b5136854ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac16" :db/id #edb/ref 17592186721443} {:answer/id #uuid "da312e1d-7a97-542a-9a1e-3f8901774560" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac23" :db/id #edb/ref 17592186721451}] :answer-field/correct {:db/id #edb/ref 17592186721451} :answer-field/id #uuid "c88056b6-bfa7-5b23-ba27-fedc4cc0abee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721447}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0b95c36a-82f4-5e3b-a6b7-85fae48a5b9d" :question/problem "The path $C$ is the line segment from $A(2,1)$ to $B(0,5)$, traversed from $A$ to $B$. Use the parametrization\n\n$$\n\\mathbf{r}(t)=\\langle1+t,3-2t\\rangle,\n$$\n\nwith parameter bounds chosen to match this traversal, to evaluate\n\n$$\n\\int_C xy\\,\\mathrm{d}x+x\\,\\mathrm{d}y.\n$$" :question/worked-solution "First match the parameter to the ordered endpoints:\n\n$$\n\\mathbf{r}(1)=\\langle2,1\\rangle=A,\\qquad\n\\mathbf{r}(-1)=\\langle0,5\\rangle=B.\n$$\n\nThe traversal from $A$ to $B$ therefore takes $t$ from $1$ to $-1$. Increasing $t$ from $-1$ to $1$ would traverse the segment in the opposite direction.\n\nHere $x(t)=1+t$, $y(t)=3-2t$, and $\\mathbf{r}'(t)=\\langle1,-2\\rangle$, giving $\\mathrm{d}x=\\mathrm{d}t$ and $\\mathrm{d}y=-2\\,\\mathrm{d}t$. Use these derivatives with the bounds just found:\n\n$$\n\\begin{aligned}\n\\int_C xy\\,\\mathrm{d}x+x\\,\\mathrm{d}y\n&=\\int_1^{-1}\\bigl(x(t)y(t)x'(t)+x(t)y'(t)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_1^{-1}\\bigl((1+t)(3-2t)-2(1+t)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_1^{-1}(1-t-2t^2)\\,\\mathrm{d}t\\\\\n&=\\left[t-\\frac12t^2-\\frac23t^3\\right]_1^{-1}\\\\\n&=\\left(-1-\\frac12+\\frac23\\right)-\\left(1-\\frac12-\\frac23\\right)\\\\\n&=-\\frac56-\\left(-\\frac16\\right)\\\\\n&=-\\frac23.\n\\end{aligned}\n$$\n\nThe decreasing parameter bounds already enforce the stated direction; no additional sign change is needed."}] [{:db/id #edb/ref 17592186721437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57c609dd-9345-52d9-b9c6-a7622e61e357" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186721439} {:answer/id #uuid "7136e6cb-a490-5333-a633-39eb5c006949" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186721440} {:answer/id #uuid "c6c710ef-fe22-55c0-bb66-8a5319ca3665" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{3}" :db/id #edb/ref 17592186721446} {:answer/id #uuid "f566e062-a56b-5fef-ab88-35e1e7ced51c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{29}{6}" :db/id #edb/ref 17592186721452} {:answer/id #uuid "f8393510-3227-58d1-88f2-fe8f7d48f099" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186721453}] :answer-field/correct {:db/id #edb/ref 17592186721439} :answer-field/id #uuid "cb3b685d-04b8-546f-b1c6-0db693399c9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721448}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3ac32936-df49-5725-8b0b-57dd6ffb26c3" :question/problem "The path $C$ is the line segment from $A(1,2)$ to $B(3,1)$, traversed from $A$ to $B$. Evaluate\n\n$$\n\\int_C xy\\,\\mathrm{d}x+x\\,\\mathrm{d}y.\n$$" :question/worked-solution "The endpoint parametrization is\n\n$$\n\\begin{aligned}\n\\mathbf{r}(t)&=\\mathbf{a}+t(\\mathbf{b}-\\mathbf{a})\\\\\n&=\\langle1,2\\rangle+t\\langle2,-1\\rangle\\\\\n&=\\langle1+2t,2-t\\rangle,\\qquad 0\\le t\\le1.\n\\end{aligned}\n$$\n\nHence $x(t)=1+2t$, $y(t)=2-t$, and $\\mathbf{r}'(t)=\\langle2,-1\\rangle$. In particular, $\\mathrm{d}x=2\\,\\mathrm{d}t$ and $\\mathrm{d}y=-\\mathrm{d}t$; the negative sign records the decreasing $y$-coordinate.\n\nNow substitute both coordinates in the product $xy$, retaining the signed differentials:\n\n$$\n\\begin{aligned}\n\\int_C xy\\,\\mathrm{d}x+x\\,\\mathrm{d}y\n&=\\int_0^1\\bigl(x(t)y(t)x'(t)+x(t)y'(t)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_0^1\\bigl(2(1+2t)(2-t)-(1+2t)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_0^1(3+4t-4t^2)\\,\\mathrm{d}t\\\\\n&=\\left[3t+2t^2-\\frac43t^3\\right]_0^1\\\\\n&=3+2-\\frac43\\\\\n&=\\frac{11}{3}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ca52fa-6e00-5b16-a7f6-4c97eb5e770c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac52" :db/id #edb/ref 17592186721434} {:answer/id #uuid "211e8a77-13cc-5cc0-bc00-f5603aa3931e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac32" :db/id #edb/ref 17592186721435} {:answer/id #uuid "834dd6ab-78f3-54b7-8b59-5b7099054f63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186721441} {:answer/id #uuid "bc941cae-2856-58b1-8571-4bdfec6c03b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac52" :db/id #edb/ref 17592186721445} {:answer/id #uuid "cd409216-27be-5fe9-9810-0359f26b01be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac12" :db/id #edb/ref 17592186721449}] :answer-field/correct {:db/id #edb/ref 17592186721434} :answer-field/id #uuid "9a07ccce-25ab-531a-9278-ed75a230e6b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721444}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd8016c8-b076-582f-b751-1ac9e77f6730" :question/problem "The path $C$ is the line segment from $A(0,0)$ to $B(2,1)$, traversed from $A$ to $B$. Evaluate\n\n$$\n\\int_C x\\,\\mathrm{d}x+y\\,\\mathrm{d}y.\n$$" :question/worked-solution "Use the endpoint parametrization $\\mathbf{r}(t)=\\mathbf{a}+t(\\mathbf{b}-\\mathbf{a})$, with $0\\le t\\le1$. Here,\n\n$$\n\\mathbf{r}(t)=\\langle 2t,t\\rangle.\n$$\n\nThus $x(t)=2t$, $y(t)=t$, and $\\mathbf{r}'(t)=\\langle2,1\\rangle$, so $\\mathrm{d}x=2\\,\\mathrm{d}t$ and $\\mathrm{d}y=\\mathrm{d}t$.\n\nSubstitute each coordinate and its corresponding differential:\n\n$$\n\\begin{aligned}\n\\int_C x\\,\\mathrm{d}x+y\\,\\mathrm{d}y\n&=\\int_0^1\\bigl(x(t)x'(t)+y(t)y'(t)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_0^1\\bigl((2t)(2)+t(1)\\bigr)\\,\\mathrm{d}t\\\\\n&=\\int_0^1 5t\\,\\mathrm{d}t\\\\\n&=\\left[\\frac52t^2\\right]_0^1\\\\\n&=\\frac52.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bfd357c-2081-5dcc-9570-bcc088781fad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\int_{\\pi/2}^{\\pi}(\\cos t+2\\sin t)\\cos t\\,\\mathrm{d}t" :db/id #edb/ref 17592186721456} {:answer/id #uuid "35012521-eb67-51ef-8af3-fa281fcd570e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\int_{\\pi/2}^{\\pi}(\\cos t+2\\sin t)\\sin t\\,\\mathrm{d}t" :db/id #edb/ref 17592186721461} {:answer/id #uuid "43987b90-9f02-5ea5-8c75-9ebe8dc98584" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\int_0^{\\pi/2}(\\cos t+2\\sin t)\\sin t\\,\\mathrm{d}t" :db/id #edb/ref 17592186721462} {:answer/id #uuid "554cce1e-6c22-56f4-b961-c41fad562c80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_{\\pi/2}^{\\pi}(\\cos t+2\\sin t)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721463} {:answer/id #uuid "f6cc2598-e5ae-50f4-80cc-6b235e695fbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\int_{\\pi/2}^{\\pi}(\\cos t+2\\sin t)\\sin t\\,\\mathrm{d}t" :db/id #edb/ref 17592186721474}] :answer-field/correct {:db/id #edb/ref 17592186721474} :answer-field/id #uuid "6b3a7570-112d-551f-be31-ccaf485d35ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721466}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "065ee6f5-1314-5a80-9afc-930493ce5623" :question/problem "![](images/47/4727c988042bd8d63af370c507db8988b3024cf7e75c86d40bc70cdcfd744873.png)\n\nWhich definite integral is equivalent to\n\n$$\n\\int_C(x+2y)\\,\\mathrm{d}x,\n$$\n\nwhere $C$ is the arc of $x^2+y^2=4$ traversed counterclockwise from $(0,2)$ to $(-2,0)$ in the second quadrant, as shown above? Do not evaluate the integral." :question/worked-solution "Use the change of variables formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}x=\\int_a^b f(x(t),y(t))x'(t)\\,\\mathrm{d}t.\n$$\n\nThe circle has radius $2$. Choose\n\n$$\n\\mathbf r(t)=\\langle2\\cos t,2\\sin t\\rangle.\n$$\n\nIncreasing $t$ moves counterclockwise. The starting point $(0,2)$ corresponds to $t=\\pi/2$, and the ending point $(-2,0)$ corresponds to $t=\\pi$. This interval traces exactly the indicated arc.\n\nNow compute the two factors:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=2\\cos t+4\\sin t=2(\\cos t+2\\sin t),\\\\\nx'(t)&=-2\\sin t.\n\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}\n\\int_C(x+2y)\\,\\mathrm{d}x\n&=\\int_{\\pi/2}^{\\pi}2(\\cos t+2\\sin t)(-2\\sin t)\\,\\mathrm{d}t\\\\\n&=-4\\int_{\\pi/2}^{\\pi}(\\cos t+2\\sin t)\\sin t\\,\\mathrm{d}t.\n\\end{aligned}\n$$\n\nHere $x$ decreases along the arc, so the negative sign in $x'(t)$ is essential. Using $y'(t)=2\\cos t$ would construct a different differential."}] [{:db/id #edb/ref 17592186721467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1044807e-7da3-5ed2-a205-10373e0a94f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\int_0^1(4t+1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721457} {:answer/id #uuid "26cde9d9-91cd-556e-91c5-6cd1ed5c3430" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\int_0^1(5t+1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721459} {:answer/id #uuid "62c0297a-f91e-5195-b971-48d6b9b48285" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\int_0^1(5t+1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721464} {:answer/id #uuid "665bfbb2-f340-534a-a964-dc9c5ede2f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^1(5t+1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721465} {:answer/id #uuid "c333812a-90ce-5168-8927-7072bb7adcfd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\int_0^1(5t-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186721471}] :answer-field/correct {:db/id #edb/ref 17592186721464} :answer-field/id #uuid "e16d799b-b86b-5a66-9299-1ed7feb2e8bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186721473}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6dda4af1-b1cb-5805-87da-510d2afd9cb0" :question/problem "![](images/43/43c8d1ced440e0fe79052c1329ff3af865e1fdbfb4cc0c7ad0a9c176592358e9.png)\n\nWhich definite integral is equivalent to\n\n$$\n\\int_C (x+2y)\\,\\mathrm{d}x,\n$$\n\nwhere $C$ is the line segment traversed from $(-1,1)$ to $(2,2)$, as shown above? Do not evaluate the integral.\n\n*Hint: Use $\\mathbf r(t)=\\langle 3t-1,t+1\\rangle$.*" :question/worked-solution "Use the change of variables formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}x=\\int_a^b f(x(t),y(t))x'(t)\\,\\mathrm{d}t.\n$$\n\nThe supplied parametrization starts at $(-1,1)$ when $t=0$ and ends at $(2,2)$ when $t=1$. Thus the limits are $0$ and $1$.\n\nDifferentiate the $x$-coordinate:\n\n$$\nx'(t)=\\frac{\\mathrm{d}}{\\mathrm{d}t}(3t-1)=3.\n$$\n\nSubstitute both coordinates into the function:\n\n$$\nf(\\mathbf r(t))=(3t-1)+2(t+1)=5t+1.\n$$\n\nTherefore,\n\n$$\n\\int_C(x+2y)\\,\\mathrm{d}x=\\int_0^1(5t+1)\\cdot3\\,\\mathrm{d}t=3\\int_0^1(5t+1)\\,\\mathrm{d}t.\n$$\n\nThe factor $3$ comes from $\\mathrm{d}x=3\\,\\mathrm{d}t$; substituting into the function alone omits it."}]}
