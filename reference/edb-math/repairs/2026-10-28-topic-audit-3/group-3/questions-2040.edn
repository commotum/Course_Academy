 + 2 z\\right) \\sin{\\left(x \\right)} - 3 \\sin{\\left(z \\right)}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16dfbde1-959b-5f3d-9e04-38462ae15677" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(3 y + 3 z\\right) \\sin{\\left(x \\right)} - 2 \\cos{\\left(y \\right)}" :db/id #edb/ref 17592186698817} {:answer/id #uuid "67ed2976-b54a-5151-8bbe-b42547556f30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\left(3 y + 3 z\\right) \\cos{\\left(x \\right)} - 2 \\cos{\\left(y \\right)}" :db/id #edb/ref 17592186698831} {:answer/id #uuid "81b861bd-7727-5b40-920d-825232063f40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(2 x + 2 z\\right) \\cos{\\left(y \\right)} + \\left(y + z\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186698835} {:answer/id #uuid "88b2f590-6fb2-5efd-9c34-ea83c86b794a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(3 y + 3 z\\right) \\cos{\\left(x \\right)} + 2 \\cos{\\left(y \\right)}" :db/id #edb/ref 17592186698837} {:answer/id #uuid "dcf85c3f-78fe-5198-89e8-f5c3c4cb9956" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 \\cos{\\left(x \\right)} + 2 \\cos{\\left(y \\right)}" :db/id #edb/ref 17592186698844}] :answer-field/correct {:db/id #edb/ref 17592186698837} :answer-field/id #uuid "bb842962-6e5b-535e-9424-98a149b0c637" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186698841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "607a77b6-72c3-57c6-b29b-c3bf12924b8f" :question/problem "Find $\\frac{\\partial f}{\\partial x}$ for $f(x,y,z)=\\left(2 x + 2 z\\right) \\cos{\\left(y \\right)} + \\left(3 y + 3 z\\right) \\sin{\\left(x \\right)}$." :question/worked-solution "Differentiate with respect to $x$, holding $y$ and $z$ fixed. Apply the sum rule. In each term, differentiate only the factors that depend on $x$; all remaining factors stay fixed.\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}&=\\left(3 y + 3 z\\right)\\cos x+2 \\cos{\\left(y \\right)}\\cdot 1\\\\&=\\left(3 y + 3 z\\right) \\cos{\\left(x \\right)} + 2 \\cos{\\left(y \\right)}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b5274f9-9637-5372-819e-24c7c7ba2050" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 3 x - 3 z\\right) \\cos{\\left(y \\right)} - 4 \\cos{\\left(z \\right)}" :db/id #edb/ref 17592186698819} {:answer/id #uuid "248b956f-1d7e-58bd-afe2-2e3b452a2731" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(x + z\\right) \\cos{\\left(y \\right)} + 2 \\cos{\\left(z \\right)}" :db/id #edb/ref 17592186698820} {:answer/id #uuid "634d9271-2a8e-5df5-9bbf-590dc2668414" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 2 x - 2 y\\right) \\cos{\\left(z \\right)} + \\left(x + z\\right) \\cos{\\left(y \\right)}" :db/id #edb/ref 17592186698830} {:answer/id #uuid "6aae1a9f-a244-5a23-ab10-cb47f172a5a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 3 x - 3 z\\right) \\cos{\\left(y \\right)} - 2 \\cos{\\left(z \\right)}" :db/id #edb/ref 17592186698833} {:answer/id #uuid "81bdc97d-0fc7-5a07-b046-71c74e36228a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\left(- 3 x - 3 z\\right) \\cos{\\left(y \\right)} + 2 \\cos{\\left(z \\right)}" :db/id #edb/ref 17592186698836}] :answer-field/correct {:db/id #edb/ref 17592186698833} :answer-field/id #uuid "d0c40e74-d8ac-5923-8166-aa8be711a188" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186698843}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a9552fe-b092-553c-8072-f0cb1275189a" :question/problem "Find $\\frac{\\partial f}{\\partial y}$ for $f(x,y,z)=\\left(- 3 x - 3 z\\right) \\sin{\\left(y \\right)} + \\left(- 2 x - 2 y\\right) \\cos{\\left(z \\right)}$." :question/worked-solution "Differentiate with respect to $y$, holding $x$ and $z$ fixed. Apply the sum rule. In each term, differentiate only the factors that depend on $y$; all remaining factors stay fixed.\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial y}&=\\left(- 3 x - 3 z\\right)\\cos y+- 2 \\cos{\\left(z \\right)}\\cdot 1\\\\&=\\left(- 3 x - 3 z\\right) \\cos{\\left(y \\right)} - 2 \\cos{\\left(z \\right)}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09c6c016-7809-5245-bbdf-4381698ad4b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sin{\\left(y \\right)} + 2 \\sin{\\left(z \\right)}" :db/id #edb/ref 17592186698813} {:answer/id #uuid "0acbf550-e455-5137-b17f-8d07b9295298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sin{\\left(y \\right)} - 2 \\sin{\\left(z \\right)}" :db/id #edb/ref 17592186698814} {:answer/id #uuid "3507a352-9e5a-552a-8c31-283aebed2954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sin{\\left(y \\right)} + 4 \\sin{\\left(z \\right)}" :db/id #edb/ref 17592186698821} {:answer/id #uuid "51b54a38-3580-594e-a8d9-470a3b867710" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- x - z\\right) \\sin{\\left(y \\right)} + 4 \\sin{\\left(z \\right)}" :db/id #edb/ref 17592186698827} {:answer/id #uuid "765d972f-eb80-5994-b681-fca31be93545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(2 x + 2 z\\right) \\sin{\\left(y \\right)} + 2 \\sin{\\left(z \\right)}" :db/id #edb/ref 17592186698834}] :answer-field/correct {:db/id #edb/ref 17592186698834} :answer-field/id #uuid "1b0d3d36-4e04-57c1-a4a9-61dc1ebba729" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186698818}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bede030b-cbd4-55f3-b338-8a518379c5a0" :question/problem "Find $\\frac{\\partial f}{\\partial y}$ for $f(x,y,z)=\\left(- 2 x - 2 z\\right) \\cos{\\left(y \\right)} + \\left(2 x + 2 y\\right) \\sin{\\left(z \\right)}$." :question/worked-solution "Differentiate with respect to $y$, holding $x$ and $z$ fixed. Apply the sum rule. In each term, differentiate only the factors that depend on $y$; all remaining factors stay fixed.\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial y}&=2 \\sin{\\left(z \\right)}\\cdot 1+\\left(- 2 x - 2 z\\right)\\left(-\\sin y\\right)\\\\&=\\left(2 x + 2 z\\right) \\sin{\\left(y \\right)} + 2 \\sin{\\left(z \\right)}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186699052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8fd8c5-6636-5e91-9b5d-b9c3574b9eda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{5}{2}" :db/id #edb/ref 17592186699051} {:answer/id #uuid "70a877e2-1ec4-5764-8712-d8c81c1773f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186699061} {:answer/id #uuid "8b5cbe67-a840-5e5d-9107-1de6c255be97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186699064} {:answer/id #uuid "97d99df0-33ec-592a-ad8a-2352e9c17ad5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186699066} {:answer/id #uuid "cb02d79a-4e33-5f0c-ace6-141265e770e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186699075}] :answer-field/correct {:db/id #edb/ref 17592186699051} :answer-field/id #uuid "50f6b31d-0957-53d2-9aa8-cd2406c30d29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699055}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30e79f3c-ebf9-5ee3-a9f7-87af4f4fcb8e" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{- 2 x^{2} - 3 y^{2} - 2}{\\sqrt{y}},\n$$\n\nevaluate $\\frac{\\partial f}{\\partial y}$ at the point $(-1,1)$." :question/worked-solution "Hold $x$ constant and differentiate with respect to $y$. Write $N=- 2 x^{2} - 3 y^{2} - 2$ and $D=\\sqrt{y}$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{y}&=- 6 y, \\\\\nD_{y}&=\\frac{1}{2 \\sqrt{y}}.\n\\end{aligned}\n$$\n\nFor the square root use $D_{y}=\\frac{1}{2\\sqrt{y}}$.  Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial y}&=\\frac{N_{y}D-ND_{y}}{D^2} \\\\\n&=\\frac{\\left(- 6 y\\right)D-N\\left(\\frac{1}{2 \\sqrt{y}}\\right)}{D^2} \\\\\n&=\\frac{2 x^{2} - 9 y^{2} + 2}{2\\left(y\\right)\\sqrt{y}}.\n\\end{aligned}\n$$\n\nThe last step multiplies the numerator and denominator by $2\\sqrt{y}$ and collects the numerator terms. Now substitute the point, after differentiating:\n\n$$\n\\begin{aligned}\n\\left.\\frac{\\partial f}{\\partial y}\\right|_{(-1,1)}&=\\frac{\\left(-6\\right)\\left(1\\right)-\\left(-7\\right)\\left(\\frac{1}{2}\\right)}{\\left(1\\right)^2} \\\\\n&=- \\frac{5}{2}.\n\\end{aligned}\n$$\n\n These expressions apply where $y>0$."}] [{:db/id #edb/ref 17592186699053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f1b6cbd-f7d9-5fe2-972b-64df4cf135e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10 e^{3}" :db/id #edb/ref 17592186699059} {:answer/id #uuid "7038eabb-d3b2-5911-99b6-4e82904ad863" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 10 e^{3}" :db/id #edb/ref 17592186699060} {:answer/id #uuid "8988e03f-7dc7-5c83-bea0-20efe459bcfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 e^{3}" :db/id #edb/ref 17592186699063} {:answer/id #uuid "c3c5a81b-f88b-54b2-bc75-0a2d97cb3d23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 e^{3}" :db/id #edb/ref 17592186699073} {:answer/id #uuid "d7b7f256-c429-54eb-9dda-0171a068c312" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 e^{3}" :db/id #edb/ref 17592186699077}] :answer-field/correct {:db/id #edb/ref 17592186699059} :answer-field/id #uuid "99d7b05b-efdd-5a2b-b0ff-b4998030c128" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699067}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3a50981f-7ca4-5e15-8f03-ccedc12a95e1" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{3 x^{2} + y^{2} - 1}{e^{x - y}},\n$$\n\nevaluate $\\frac{\\partial f}{\\partial y}$ at the point $(-1,2)$." :question/worked-solution "Hold $x$ constant and differentiate with respect to $y$. Write $N=3 x^{2} + y^{2} - 1$ and $D=e^{x - y}$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{y}&=2 y, \\\\\nD_{y}&=- e^{x - y}.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $-1$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial y}&=\\frac{N_{y}D-ND_{y}}{D^2} \\\\\n&=\\frac{\\left(2 y\\right)D-N\\left(- e^{x - y}\\right)}{D^2} \\\\\n&=\\frac{3 x^{2} + y^{2} + 2 y - 1}{e^{x - y}}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{x - y}$ from the numerator. Cancel that factor with one copy in the squared denominator. Now substitute the point, after differentiating:\n\n$$\n\\begin{aligned}\n\\left.\\frac{\\partial f}{\\partial y}\\right|_{(-1,2)}&=\\frac{\\left(4\\right)\\left(\\frac{1}{e^{3}}\\right)-\\left(6\\right)\\left(- \\frac{1}{e^{3}}\\right)}{\\left(\\frac{1}{e^{3}}\\right)^2} \\\\\n&=10 e^{3}.\n\\end{aligned}\n$$\n\n These expressions apply where $e^{x - y}\\ne0$."}] [{:db/id #edb/ref 17592186699058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298e3d07-1f2d-5109-b0cc-77fc0d81ba76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186699050} {:answer/id #uuid "4cb008dc-1883-536b-8f24-4d08d1cb7c4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186699054} {:answer/id #uuid "c44c4920-c231-5fc4-91ec-58bd3d67ae50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186699074} {:answer/id #uuid "ce19b885-267c-5aab-aaec-93f040f3bab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186699076} {:answer/id #uuid "d7d9bcb3-819d-56a1-89d8-a7bd7c97b00e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186699078}] :answer-field/correct {:db/id #edb/ref 17592186699076} :answer-field/id #uuid "b73b08c7-e4ce-5809-a128-3e614c54420b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "65fd193d-d9ad-588d-b4ba-ecfbf36bcbb7" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{- 2 x y - 3}{2 x - 2 y - 1},\n$$\n\nevaluate $\\frac{\\partial f}{\\partial x}$ at the point $(0,-1)$." :question/worked-solution "Hold $y$ constant and differentiate with respect to $x$. Write $N=- 2 x y - 3$ and $D=2 x - 2 y - 1$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{x}&=- 2 y, \\\\\nD_{x}&=2.\n\\end{aligned}\n$$\n\n Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}&=\\frac{N_{x}D-ND_{x}}{D^2} \\\\\n&=\\frac{\\left(- 2 y\\right)D-N\\left(2\\right)}{D^2} \\\\\n&=\\frac{4 y^{2} + 2 y + 6}{\\left(2 x - 2 y - 1\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step distributes the subtraction and collects like terms. Now substitute the point, after differentiating:\n\n$$\n\\begin{aligned}\n\\left.\\frac{\\partial f}{\\partial x}\\right|_{(0,-1)}&=\\frac{\\left(2\\right)\\left(1\\right)-\\left(-3\\right)\\left(2\\right)}{\\left(1\\right)^2} \\\\\n&=8.\n\\end{aligned}\n$$\n\n These expressions apply where $2 x - 2 y - 1\\ne0$."}] [{:db/id #edb/ref 17592186699072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6054e7e8-2357-5453-bd28-df85d4eb8c1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{11}{e^{2}}" :db/id #edb/ref 17592186699057} {:answer/id #uuid "78f4bb71-0114-5502-a1db-84bdceafc211" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{e^{2}}" :db/id #edb/ref 17592186699062} {:answer/id #uuid "a870b043-9b68-5135-a982-62e2ad93ba52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{e^{2}}" :db/id #edb/ref 17592186699068} {:answer/id #uuid "b239eabb-7538-52a4-9db9-a9f0228631fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{e^{2}}" :db/id #edb/ref 17592186699070} {:answer/id #uuid "ed4c368d-35fd-5a0e-84da-c4ee8a0adf06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{6}{e^{2}}" :db/id #edb/ref 17592186699079}] :answer-field/correct {:db/id #edb/ref 17592186699070} :answer-field/id #uuid "f614a711-2ef1-5129-aeee-a489173aa3c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699082}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b7ce85a3-231b-52d3-9284-683bab4a239d" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{- 3 x^{2} - 2 y^{2}}{e^{- x + y}},\n$$\n\nevaluate $\\frac{\\partial f}{\\partial x}$ at the point $(-1,1)$." :question/worked-solution "Hold $y$ constant and differentiate with respect to $x$. Write $N=- 3 x^{2} - 2 y^{2}$ and $D=e^{- x + y}$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{x}&=- 6 x, \\\\\nD_{x}&=- e^{- x + y}.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $-1$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}&=\\frac{N_{x}D-ND_{x}}{D^2} \\\\\n&=\\frac{\\left(- 6 x\\right)D-N\\left(- e^{- x + y}\\right)}{D^2} \\\\\n&=\\frac{- 3 x^{2} - 6 x - 2 y^{2}}{e^{- x + y}}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x + y}$ from the numerator. Cancel that factor with one copy in the squared denominator. Now substitute the point, after differentiating:\n\n$$\n\\begin{aligned}\n\\left.\\frac{\\partial f}{\\partial x}\\right|_{(-1,1)}&=\\frac{\\left(6\\right)\\left(e^{2}\\right)-\\left(-5\\right)\\left(- e^{2}\\right)}{\\left(e^{2}\\right)^2} \\\\\n&=\\frac{1}{e^{2}}.\n\\end{aligned}\n$$\n\n These expressions apply where $e^{- x + y}\\ne0$."}] [{:db/id #edb/ref 17592186699081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069a3cc8-1f1a-58da-86e1-87122723c5f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186699049} {:answer/id #uuid "5bbcd7f4-5d73-5025-8d63-f1900f36e341" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{9}" :db/id #edb/ref 17592186699056} {:answer/id #uuid "b17e4500-ffa5-52a8-ae36-d19f109ceb0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{27}" :db/id #edb/ref 17592186699069} {:answer/id #uuid "f2769889-c75a-55fa-bfac-791733aba4ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{1}{3}" :db/id #edb/ref 17592186699080} {:answer/id #uuid "f6b72858-5e76-56ca-8872-41a50fa6584a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186699083}] :answer-field/correct {:db/id #edb/ref 17592186699049} :answer-field/id #uuid "8c0e2180-1398-56bb-b1e3-b5f23c0dce37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699065}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f39f470f-1381-5c00-9d56-dd5568a45b1b" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{x y - 3}{- x + 2 y},\n$$\n\nevaluate $\\frac{\\partial f}{\\partial y}$ at the point $(-1,1)$." :question/worked-solution "Hold $x$ constant and differentiate with respect to $y$. Write $N=x y - 3$ and $D=- x + 2 y$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{y}&=x, \\\\\nD_{y}&=2.\n\\end{aligned}\n$$\n\n Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial y}&=\\frac{N_{y}D-ND_{y}}{D^2} \\\\\n&=\\frac{\\left(x\\right)D-N\\left(2\\right)}{D^2} \\\\\n&=\\frac{6 - x^{2}}{\\left(- x + 2 y\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step distributes the subtraction and collects like terms. Now substitute the point, after differentiating:\n\n$$\n\\begin{aligned}\n\\left.\\frac{\\partial f}{\\partial y}\\right|_{(-1,1)}&=\\frac{\\left(-1\\right)\\left(3\\right)-\\left(-4\\right)\\left(2\\right)}{\\left(3\\right)^2} \\\\\n&=\\frac{5}{9}.\n\\end{aligned}\n$$\n\n These expressions apply where $- x + 2 y\\ne0$."}] [{:db/id #edb/ref 17592186699138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129a83c8-e8ef-59c6-abe2-51129a469597" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186699124} {:answer/id #uuid "38183f18-6ded-52bf-9ad4-330808c857e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3} + 3 \\sqrt{5}" :db/id #edb/ref 17592186699132} {:answer/id #uuid "9129d2ac-3665-5b0b-98d3-1da1ecac73cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{4}{3}" :db/id #edb/ref 17592186699146} {:answer/id #uuid "9220930f-6746-557f-a825-9be62a0af211" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186699147} {:answer/id #uuid "e58daad7-8014-5c0c-9644-3d776fcbc64a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186699152}] :answer-field/correct {:db/id #edb/ref 17592186699124} :answer-field/id #uuid "4a393a1f-77aa-53d9-a935-abf1933f8a57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699136}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "509ebf1b-6e42-5796-8a07-b312e13c2333" :question/problem "For $f(x,y)=y \\sqrt{x^{2} + y^{2}}$, evaluate $f_y(2,\\sqrt{5})$. Assume $(x,y)\\ne(0,0)$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=y,\\quad v=\\sqrt{x^{2} + y^{2}}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_y&=1\\\\\nv_y&=\\frac{y}{\\sqrt{x^{2} + y^{2}}}\\\\\nr_y&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_y&=C(u_yv+uv_y)+r_y\\\\\n&=1\\left[\\left(1\\right)\\left(\\sqrt{x^{2} + y^{2}}\\right)+\\left(y\\right)\\left(\\frac{y}{\\sqrt{x^{2} + y^{2}}}\\right)\\right]+\\left(0\\right)\\\\\n&=\\frac{y^{2}}{\\sqrt{x^{2} + y^{2}}} + \\sqrt{x^{2} + y^{2}}\n\\end{aligned}\n$$\n\nNow substitute $x=2$ and $y=\\sqrt{5}$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_y(2,\\sqrt{5})&=\\left(1\\right)\\left(3\\right)+\\left(\\sqrt{5}\\right)\\left(\\frac{\\sqrt{5}}{3}\\right)\\\\\n&=\\frac{14}{3}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186699144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b183eb9-d4c7-5c8f-b895-2178bc1b54ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1 + \\frac{\\pi}{2}" :db/id #edb/ref 17592186699122} {:answer/id #uuid "56bc0705-7448-52ae-854e-4fafb563c113" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186699139} {:answer/id #uuid "6004465d-a128-52ee-ad8a-f85f3ba55ebe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9 \\pi}{16}" :db/id #edb/ref 17592186699140} {:answer/id #uuid "83698164-b262-5351-9534-a11eb21a20b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1 + \\frac{\\pi}{2}" :db/id #edb/ref 17592186699143} {:answer/id #uuid "9701d1af-c558-5fc6-bb75-b77b4229312b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186699148}] :answer-field/correct {:db/id #edb/ref 17592186699143} :answer-field/id #uuid "2d567bde-8205-583d-8144-3c7df1d5d53b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699130}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8bfa4687-ea8e-5445-b5aa-82f3155d1dbc" :question/problem "For $f(x,y)=x \\tan{\\left(x y^{2} \\right)}$, evaluate $f_x(\\frac{\\pi}{16},-2)$. Assume $\\cos(x y^{2})\\ne0$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=x,\\quad v=\\tan{\\left(x y^{2} \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_x&=1\\\\\nv_x&=y^{2} \\sec^{2}{\\left(x y^{2} \\right)}\\\\\nr_x&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_x&=C(u_xv+uv_x)+r_x\\\\\n&=1\\left[\\left(1\\right)\\left(\\tan{\\left(x y^{2} \\right)}\\right)+\\left(x\\right)\\left(y^{2} \\sec^{2}{\\left(x y^{2} \\right)}\\right)\\right]+\\left(0\\right)\\\\\n&=x y^{2} \\sec^{2}{\\left(x y^{2} \\right)} + \\tan{\\left(x y^{2} \\right)}\n\\end{aligned}\n$$\n\nNow substitute $x=\\frac{\\pi}{16}$ and $y=-2$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_x(\\frac{\\pi}{16},-2)&=\\left(1\\right)\\left(1\\right)+\\left(\\frac{\\pi}{16}\\right)\\left(8\\right)\\\\\n&=1 + \\frac{\\pi}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186699145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a01521e-28fe-55d5-9258-e8c15ab0dfba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699126} {:answer/id #uuid "3a4133ab-2447-506f-860f-6797538c4336" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi^{2}}{8} + \\frac{\\pi}{2}" :db/id #edb/ref 17592186699133} {:answer/id #uuid "3d9e9e86-d222-53ac-a373-6b409e8b0553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186699135} {:answer/id #uuid "c219ef8d-3a55-51ac-887b-f586199f99e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi^{2}}{8} + \\pi" :db/id #edb/ref 17592186699149} {:answer/id #uuid "dc99b071-0a75-5b1b-b245-268d0529efd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2} + \\frac{\\pi^{2}}{4}" :db/id #edb/ref 17592186699151}] :answer-field/correct {:db/id #edb/ref 17592186699133} :answer-field/id #uuid "17511e64-76db-588b-9f95-a34f5735e8db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699125}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8fd87939-2c31-5ef4-853f-ca1c06299873" :question/problem "For $f(x,y)=y^{2} \\tan{\\left(x^{2} y \\right)}$, evaluate $f_y(-1,- \\frac{\\pi}{4})$. Assume $\\cos(x^{2} y)\\ne0$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=y^{2},\\quad v=\\tan{\\left(x^{2} y \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_y&=2 y\\\\\nv_y&=x^{2} \\sec^{2}{\\left(x^{2} y \\right)}\\\\\nr_y&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_y&=C(u_yv+uv_y)+r_y\\\\\n&=1\\left[\\left(2 y\\right)\\left(\\tan{\\left(x^{2} y \\right)}\\right)+\\left(y^{2}\\right)\\left(x^{2} \\sec^{2}{\\left(x^{2} y \\right)}\\right)\\right]+\\left(0\\right)\\\\\n&=x^{2} y^{2} \\sec^{2}{\\left(x^{2} y \\right)} + 2 y \\tan{\\left(x^{2} y \\right)}\n\\end{aligned}\n$$\n\nNow substitute $x=-1$ and $y=- \\frac{\\pi}{4}$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_y(-1,- \\frac{\\pi}{4})&=\\left(- \\frac{\\pi}{2}\\right)\\left(-1\\right)+\\left(\\frac{\\pi^{2}}{16}\\right)\\left(2\\right)\\\\\n&=\\frac{\\pi^{2}}{8} + \\frac{\\pi}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186699154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23813693-a85d-50d2-ad36-696afb707480" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8 e^{2}" :db/id #edb/ref 17592186699127} {:answer/id #uuid "296a84e6-03ce-579e-84d8-e24693cb20e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 e^{2}" :db/id #edb/ref 17592186699129} {:answer/id #uuid "3b060117-9344-5372-b476-aa8d072896e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 e^{2}" :db/id #edb/ref 17592186699134} {:answer/id #uuid "7423ee34-3612-5260-870f-9e1d64470ac9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699141} {:answer/id #uuid "c322e948-2534-5ab1-94b1-cb5710ca6067" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 e^{2}" :db/id #edb/ref 17592186699150}] :answer-field/correct {:db/id #edb/ref 17592186699127} :answer-field/id #uuid "4b620fc7-821d-53c5-9b26-1daa7d35e0ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699137}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eadb85c2-fddb-59e6-b2f5-a05e8e93e0d3" :question/problem "For $f(x,y)=x^{2} e^{x} \\cos{\\left(y \\right)}$, evaluate $f_x(2,0)$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=\\cos{\\left(y \\right)},\\quad r=0\\\\\nu&=x^{2},\\quad v=e^{x}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_x&=2 x\\\\\nv_x&=e^{x}\\\\\nr_x&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_x&=C(u_xv+uv_x)+r_x\\\\\n&=\\cos{\\left(y \\right)}\\left[\\left(2 x\\right)\\left(e^{x}\\right)+\\left(x^{2}\\right)\\left(e^{x}\\right)\\right]+\\left(0\\right)\\\\\n&=\\left(x^{2} e^{x} + 2 x e^{x}\\right) \\cos{\\left(y \\right)}\n\\end{aligned}\n$$\n\nNow substitute $x=2$ and $y=0$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_x(2,0)&=\\left(4\\right)\\left(e^{2}\\right)+\\left(4\\right)\\left(e^{2}\\right)\\\\\n&=8 e^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186699155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0736d791-d58b-525b-b82b-ab314165c8fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\pi" :db/id #edb/ref 17592186699121} {:answer/id #uuid "0f0311c7-e2b1-56ab-a99c-94c554b73767" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186699123} {:answer/id #uuid "2617ceb2-6ff8-52a4-86ac-515e35bf622a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186699128} {:answer/id #uuid "37b3f7fe-55de-542e-81d7-1dc951314438" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi" :db/id #edb/ref 17592186699131} {:answer/id #uuid "e5c19e44-4746-5267-8376-3290c4c3c068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186699153}] :answer-field/correct {:db/id #edb/ref 17592186699128} :answer-field/id #uuid "7e441a84-435f-538c-b9fb-f33e88b8589e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699142}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2cc3ae2-5e34-5fc1-8271-777739085362" :question/problem "For $f(x,y)=x y \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)}$, evaluate $f_x(- \\pi,2)$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=y,\\quad r=- \\sin{\\left(x \\right)}\\\\\nu&=x,\\quad v=\\cos{\\left(x \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_x&=1\\\\\nv_x&=- \\sin{\\left(x \\right)}\\\\\nr_x&=- \\cos{\\left(x \\right)}\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_x&=C(u_xv+uv_x)+r_x\\\\\n&=y\\left[\\left(1\\right)\\left(\\cos{\\left(x \\right)}\\right)+\\left(x\\right)\\left(- \\sin{\\left(x \\right)}\\right)\\right]+\\left(- \\cos{\\left(x \\right)}\\right)\\\\\n&=y \\left(- x \\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}\\right) - \\cos{\\left(x \\right)}\n\\end{aligned}\n$$\n\nNow substitute $x=- \\pi$ and $y=2$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_x(- \\pi,2)&=2\\left[\\left(1\\right)\\left(-1\\right)+\\left(- \\pi\\right)\\left(0\\right)\\right]+\\left(1\\right)\\\\\n&=-1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186699474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15765b6f-201e-5bb4-8ae3-61b406032fbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186699472} {:answer/id #uuid "15cc08fa-d185-53a2-9355-2eebd8e3db72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186699473} {:answer/id #uuid "3e12adc5-2c53-5dc8-9648-3657f34e9a98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186699483} {:answer/id #uuid "a4b1b75c-97e3-53ce-af59-0f85cee7517d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186699495} {:answer/id #uuid "d65dc22b-5aaf-568c-8222-4e064379dd52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186699499}] :answer-field/correct {:db/id #edb/ref 17592186699473} :answer-field/id #uuid "74da9fbe-3b78-5cf4-8f76-3264ebfeb6dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699487}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "184c0ad6-2969-57dd-adfa-65af5702b3ac" :question/problem "For the function $f(x,y)=\\sqrt{2 x^{2} + y^{2}}$, evaluate $f_x(1,- \\sqrt{2})$." :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=2 x^{2} + y^{2}\\\\\n\\frac{\\partial u}{\\partial x}&=4 x\\\\\n\\frac{\\partial}{\\partial x}\\left(\\sqrt{u}\\right)&=\\left(\\frac{1}{2 \\sqrt{u}}\\right)\\cdot\\frac{\\partial u}{\\partial x}\\\\\nf_x(x,y)&=\\left(\\frac{1}{2 \\sqrt{u}}\\right)\\cdot\\left(4 x\\right)\\\\\n&=\\frac{2 x}{\\sqrt{2 x^{2} + y^{2}}}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=- \\sqrt{2}$ after differentiating. The inner input is\n\n$$\nu_0=2 \\left(1\\right)^{2} + \\left(- \\sqrt{2}\\right)^{2}=4.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(1,- \\sqrt{2})&=\\left(\\frac{1}{2 \\sqrt{u_0}}\\right)\\cdot\\left(4\\right)\\\\\n&=\\left(\\frac{1}{4}\\right)\\cdot\\left(4\\right)\\\\\n&=1.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $(x,y)\\ne(0,0)$."}] [{:db/id #edb/ref 17592186699479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35598f19-0305-51c2-916b-6194582ffb31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186699481} {:answer/id #uuid "b2e02194-0a93-5c72-a8cd-ae141f63461b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186699496} {:answer/id #uuid "bcb9b33c-31a0-5652-977e-400303993d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186699497} {:answer/id #uuid "d8adb849-7817-5eb9-8d8c-f53cba587acc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186699500} {:answer/id #uuid "f92e48d9-15ce-58d1-aed3-5174594a5c72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186699503}] :answer-field/correct {:db/id #edb/ref 17592186699497} :answer-field/id #uuid "1d5f836f-30a6-52e9-8ac8-9797f482c7af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699475}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "31e5baf3-2f0d-5f1d-8b0e-96f85f013e89" :question/problem "For the function $f(x,y)=- 2 x^{2} y^{3} + e^{- 2 x y}$, evaluate $f_x(0,1)$." :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=- 2 x y\\\\\n\\frac{\\partial u}{\\partial x}&=- 2 y\\\\\n\\frac{\\partial}{\\partial x}\\left(e^{u}\\right)&=\\left(e^{u}\\right)\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(- 2 x^{2} y^{3}\\right)&=- 4 x y^{3}\\\\\nf_x(x,y)&=\\left(e^{u}\\right)\\cdot\\left(- 2 y\\right)+\\left(- 4 x y^{3}\\right)\\\\\n&=- 4 x y^{3} - 2 y e^{- 2 x y}\n\\end{aligned}\n$$\n\nSubstitute $x=0$ and $y=1$ after differentiating. The inner input is\n\n$$\nu_0=- 2 \\left(0\\right) \\left(1\\right)=0.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(0,1)&=\\left(e^{u_0}\\right)\\cdot\\left(-2\\right)+\\left(0\\right)\\\\\n&=\\left(1\\right)\\cdot\\left(-2\\right)+\\left(0\\right)\\\\\n&=-2.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186699482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033e69f2-9aa4-577b-955e-b9ac6c825fa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186699470} {:answer/id #uuid "1ec292b7-90d3-5f2b-bebe-240e5dd5bd83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-32" :db/id #edb/ref 17592186699476} {:answer/id #uuid "4925403d-5a8a-5b6e-9fc1-b651019b747d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699484} {:answer/id #uuid "7e6d8ae9-c51f-54d6-9694-55800a5eb5df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-64" :db/id #edb/ref 17592186699491} {:answer/id #uuid "ea814246-b386-55aa-a694-cb5ad03cb518" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186699502}] :answer-field/correct {:db/id #edb/ref 17592186699476} :answer-field/id #uuid "0ee87337-27ef-5441-aeb6-6ab2f5085a76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699471}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3a2cbdd6-4345-532e-98b7-31690902f040" :question/problem "For the function $f(x,y)=\\left(1 - x\\right)^{3 y + 1}$, evaluate $f_x(-1,1)$." :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=1 - x\\\\\n\\frac{\\partial u}{\\partial x}&=-1\\\\\n\\frac{\\partial}{\\partial x}u^{3 y + 1}&=\\left(3 y + 1\\right)\\,u^{3 y}\\cdot\\frac{\\partial u}{\\partial x}\\\\\nf_x(x,y)&=\\left(u^{3 y} \\left(3 y + 1\\right)\\right)\\cdot\\left(-1\\right)\\\\\n&=- \\left(1 - x\\right)^{3 y} \\left(3 y + 1\\right)\n\\end{aligned}\n$$\n\nSubstitute $x=-1$ and $y=1$ after differentiating. The inner input is\n\n$$\nu_0=1 - \\left(-1\\right)=2.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(-1,1)&=\\left(u_0^{3 \\left(1\\right)} \\left(3 \\left(1\\right) + 1\\right)\\right)\\cdot\\left(-1\\right)\\\\\n&=\\left(32\\right)\\cdot\\left(-1\\right)\\\\\n&=-32.\n\\end{aligned}\n$$\n\nThese derivatives apply for $1 - x>0$."}] [{:db/id #edb/ref 17592186699492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2caf5535-3310-57e1-b98e-4aa38842998f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699477} {:answer/id #uuid "3088fa28-fb09-57e4-b619-db7616e9c92b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\pi \\left(\\frac{1}{2} + \\pi\\right)" :db/id #edb/ref 17592186699478} {:answer/id #uuid "3514a087-1faf-5c90-a1d7-664a33ce5956" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\left(- \\pi - 1\\right)" :db/id #edb/ref 17592186699480} {:answer/id #uuid "7c4a4e6e-8092-5761-a760-9474b2b04591" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi \\left(-1 + \\pi\\right)}{2}" :db/id #edb/ref 17592186699488} {:answer/id #uuid "7e686f23-d883-57f4-8e07-ffdb32be8b4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 \\pi - 1" :db/id #edb/ref 17592186699490}] :answer-field/correct {:db/id #edb/ref 17592186699478} :answer-field/id #uuid "f9f20d81-bc28-506f-930d-b824026f2228" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699504}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "85fc884e-7343-5fd1-b009-771feda2a88a" :question/problem "For the function $f(x,y)=2 x^{2} y^{2} - \\cos{\\left(x y \\right)}$, evaluate $f_y(- \\frac{\\pi}{2},-1)$." :question/worked-solution "Treat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x y\\\\\n\\frac{\\partial u}{\\partial y}&=x\\\\\n\\frac{\\partial}{\\partial y}\\left(- \\cos{\\left(u \\right)}\\right)&=\\left(\\sin{\\left(u \\right)}\\right)\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(2 x^{2} y^{2}\\right)&=4 x^{2} y\\\\\nf_y(x,y)&=\\left(\\sin{\\left(u \\right)}\\right)\\cdot\\left(x\\right)+\\left(4 x^{2} y\\right)\\\\\n&=4 x^{2} y + x \\sin{\\left(x y \\right)}\n\\end{aligned}\n$$\n\nSubstitute $x=- \\frac{\\pi}{2}$ and $y=-1$ after differentiating. The inner input is\n\n$$\nu_0=\\left(- \\frac{\\pi}{2}\\right) \\left(-1\\right)=\\frac{\\pi}{2}.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(- \\frac{\\pi}{2},-1)&=\\left(\\sin{\\left(u_0 \\right)}\\right)\\cdot\\left(- \\frac{\\pi}{2}\\right)+\\left(- \\pi^{2}\\right)\\\\\n&=\\left(1\\right)\\cdot\\left(- \\frac{\\pi}{2}\\right)+\\left(- \\pi^{2}\\right)\\\\\n&=- \\pi \\left(\\frac{1}{2} + \\pi\\right).\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186699494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51312c46-3332-5b1b-b097-7b5e9e97daae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186699485} {:answer/id #uuid "6dc52ad2-b40f-5301-94fb-3b1c3b4c6c9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186699486} {:answer/id #uuid "7e12c707-b42f-543f-993d-4cb0f3a4d421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186699489} {:answer/id #uuid "920460f0-09c3-5832-834c-82859710c5ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186699493} {:answer/id #uuid "beadd131-726b-5a50-84f8-17120d0ce5a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699498}] :answer-field/correct {:db/id #edb/ref 17592186699498} :answer-field/id #uuid "e98dd5e4-005f-5354-8b53-c0703844adde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699501}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94b0e1db-015a-50cb-95c7-36f75ef3bfc1" :question/problem "For the function $f(x,y)=\\cos^{2}{\\left(- x^{2} + 2 y \\right)}$, evaluate $f_x(2,\\frac{\\pi}{4} + 2)$." :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=- x^{2} + 2 y\\\\\n\\frac{\\partial u}{\\partial x}&=- 2 x\\\\\n\\frac{\\partial}{\\partial x}\\cos^2(u)&=2\\cos(u)\\cdot(-\\sin(u))\\cdot\\frac{\\partial u}{\\partial x}\\\\\nf_x(x,y)&=\\left(- 2 \\sin{\\left(u \\right)} \\cos{\\left(u \\right)}\\right)\\cdot\\left(- 2 x\\right)\\\\\n&=4 x \\sin{\\left(- x^{2} + 2 y \\right)} \\cos{\\left(- x^{2} + 2 y \\right)}\n\\end{aligned}\n$$\n\nSubstitute $x=2$ and $y=\\frac{\\pi}{4} + 2$ after differentiating. The inner input is\n\n$$\nu_0=- \\left(2\\right)^{2} + 2 \\left(\\frac{\\pi}{4} + 2\\right)=\\frac{\\pi}{2}.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(2,\\frac{\\pi}{4} + 2)&=\\left(- 2 \\sin{\\left(u_0 \\right)} \\cos{\\left(u_0 \\right)}\\right)\\cdot\\left(-4\\right)\\\\\n&=\\left(0\\right)\\cdot\\left(-4\\right)\\\\\n&=0.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}]}
