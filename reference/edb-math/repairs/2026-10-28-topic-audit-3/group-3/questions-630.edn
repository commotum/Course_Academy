#{[{:db/id #edb/ref 17592186287821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458cafbf-7052-5688-a3e6-270feaa693c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439555} {:answer/id #uuid "f155cb5b-192c-558c-aa25-73d859f68f54" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439556}] :answer-field/correct {:db/id #edb/ref 17592186439556} :answer-field/id #uuid "11461a6e-1dea-5d60-87fb-79ffe64218c2" :answer-field/key "$y=- \\frac{25}{9}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440135} {:answer-field/choices [{:answer/id #uuid "ac822410-bfae-5d59-9738-427934044f97" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439557} {:answer/id #uuid "0258f679-5bbb-5a4f-8ebb-3d4abeaeab7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439558}] :answer-field/correct {:db/id #edb/ref 17592186439557} :answer-field/id #uuid "e1d050ea-e9d9-5e3c-ba92-d504ed6a5ce7" :answer-field/key "$y=- \\frac{5}{3}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440136} {:answer-field/choices [{:answer/id #uuid "1fee28db-a2fa-5c8a-b01b-25dceb5db556" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439559} {:answer/id #uuid "1bc5a615-11e6-5a3f-b222-5f82eaec2ed5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439560}] :answer-field/correct {:db/id #edb/ref 17592186439560} :answer-field/id #uuid "fecaf349-b286-5e78-8846-4d31a1320995" :answer-field/key "$y=-1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440137} {:answer-field/choices [{:answer/id #uuid "fc065864-faea-55e7-829d-8436655f4adf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439561} {:answer/id #uuid "2e659b65-8b01-57c8-8277-3075d6254b77" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439562}] :answer-field/correct {:db/id #edb/ref 17592186439561} :answer-field/id #uuid "e28d926e-be6f-58c9-bdc1-98b5d2921bdf" :answer-field/key "$y=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440138}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "627e7a3d-46e0-5ce8-b4f0-d14bd806cb23" :question/math-academy-id "q-18256" :question/problem "Given that the determinant of \n$$\n\\displaystyle \\begin{bmatrix}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{bmatrix}\n$$\n is $81,$ find all the possible values of $y.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{vmatrix} & =4\\begin{vmatrix}-2 & 1 \\\\ y & -5\\end{vmatrix}-2\\begin{vmatrix}-3y & 1 \\\\ 2 & -5\\end{vmatrix}+3\\begin{vmatrix}-3y & -2 \\\\ 2 & y\\end{vmatrix} \\\\  & =4\\cdot (10-y)-2\\cdot (15y-2)+3\\cdot (-3{y}^{2}+4) \\\\  & =40-4y-30y+4-9{y}^{2}+12 \\\\  & =-9{y}^{2}-34y+56\\end{aligned}\n$$\n\nSince the determinant of the matrix is $81,$ we have:\n\n$$\n\\begin{aligned}-9{y}^{2}-34y+56 & =81 \\\\ -9{y}^{2}-34y-25 & =0 \\\\ 9{y}^{2}+34y+25 & =0 \\\\ y & =\\frac{-34\\pm \\sqrt{{34}^{2}-4\\cdot 9\\cdot 25}}{2\\cdot 9} \\\\  & =\\frac{-34\\pm \\sqrt{256}}{18} \\\\  & =\\frac{-34\\pm 16}{18} \\\\  & =\\frac{-17\\pm 8}{9}\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-\\frac{25}{9}$ and $y=-1.$"}] [{:db/id #edb/ref 17592186287824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d5ba56-de94-5e4c-b177-c5dc46ffbd51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186285000} {:answer/id #uuid "77114028-3901-51ca-9e0e-c825093eb6e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186285895} {:answer/id #uuid "7dacdb7f-b468-5607-98ad-e22d7d3b1b14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186285945} {:answer/id #uuid "a1c9c2b5-e4ef-5a55-b086-105ff3094bd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186286267} {:answer/id #uuid "eeb37ef9-8f27-5f7e-8602-dfc794e1f1a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186286978}] :answer-field/correct {:db/id #edb/ref 17592186286978} :answer-field/id #uuid "e17a460e-868e-59c7-9907-c5516e2c691c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287610}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "418920c2-d3a5-5269-af1c-6648eaf6ff36" :question/math-academy-id "q-18271" :question/problem "Given that\n$$\n\\displaystyle A=\\begin{bmatrix}-k & 0 & -3 \\\\ 1 & 3 & -1 \\\\ 2k & 0 & 1\\end{bmatrix}\n$$\nand $det(A)=-30,$ find the value of $k.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}\\text{det}(A) & =\\begin{vmatrix}-k & 0 & -3 \\\\ 1 & 3 & -1 \\\\ 2k & 0 & 1\\end{vmatrix} \\\\  & =-k\\begin{vmatrix}3 & -1 \\\\ 0 & 1\\end{vmatrix}-0\\begin{vmatrix}1 & -1 \\\\ 2k & 1\\end{vmatrix}-3\\begin{vmatrix}1 & 3 \\\\ 2k & 0\\end{vmatrix} \\\\  & =-k\\cdot 3+0-3\\cdot (-6k) \\\\  & =-3k+18k \\\\  & =15k\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-30,$ we have:\n\n$$\n\\begin{aligned}15k & =-30 \\\\ k & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8a0b14-4d5c-5c97-adda-ad9333ee9989" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439563} {:answer/id #uuid "dd74231f-397c-535b-b601-fd3c79196c9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439564}] :answer-field/correct {:db/id #edb/ref 17592186439564} :answer-field/id #uuid "bc6cf2f7-d1dc-587c-98ad-df0c79eb39bd" :answer-field/key "$p=-2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440139} {:answer-field/choices [{:answer/id #uuid "b99de5ad-e5ec-584b-85db-f3fe0159078d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439565} {:answer/id #uuid "6a78a0f8-e11d-55e4-ae7a-bb450fd88339" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439566}] :answer-field/correct {:db/id #edb/ref 17592186439565} :answer-field/id #uuid "60fa672d-cabd-5202-b542-e29c05c6092c" :answer-field/key "$p=2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440140} {:answer-field/choices [{:answer/id #uuid "0824bc4a-1fb6-5f8e-8f46-06f33e4a0f34" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439567} {:answer/id #uuid "4bccbe1d-f704-50a7-a7cc-0373aa409b61" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439568}] :answer-field/correct {:db/id #edb/ref 17592186439567} :answer-field/id #uuid "b90240d0-5950-5b79-9a0c-e7150762e3ac" :answer-field/key "$p=4$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440141} {:answer-field/choices [{:answer/id #uuid "99e7c5d4-430e-5f20-88bd-00f87d74ace8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439569} {:answer/id #uuid "82587c1b-bbe1-5f58-a819-0bba3bb63520" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439570}] :answer-field/correct {:db/id #edb/ref 17592186439570} :answer-field/id #uuid "1827baf7-1958-50ff-a89b-0e47a7c1cf1e" :answer-field/key "$p=5$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440142}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a6ffa24-d6e8-52ac-ac3d-5fab4f24df3d" :question/math-academy-id "q-18272" :question/problem "Given that $M=\\begin{bmatrix}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{bmatrix}$ and $det(M)=-23,$ find all the possible values of $p.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}\\text{det}(M) & =\\begin{vmatrix}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{vmatrix} \\\\  & =0\\begin{vmatrix}p & 0 \\\\ 0 & -1\\end{vmatrix}-(-3)\\begin{vmatrix}1 & 0 \\\\ p-3 & -1\\end{vmatrix}+2\\begin{vmatrix}1 & p \\\\ p-3 & 0\\end{vmatrix} \\\\  & =0+3\\cdot (-1)+2\\cdot (3p-{p}^{2}) \\\\  & =-3-2{p}^{2}+6p \\\\  & =-2{p}^{2}+6p-3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-23,$ we have:\n\n$$\n\\begin{aligned}-2{p}^{2}+6p-3 & =-23 \\\\ 2{p}^{2}-6p-20 & =0 \\\\ {p}^{2}-3p-10 & =0 \\\\ p & =\\frac{-(-3)\\pm \\sqrt{(-3)^{2}-4\\cdot 1\\cdot (-10)}}{2\\cdot 1} \\\\  & =\\frac{3\\pm \\sqrt{49}}{2} \\\\  & =\\frac{3\\pm 7}{2}\\end{aligned}\n$$\n\nTherefore,  the solutions are $p=-2$ and $p=5.$"}] [{:db/id #edb/ref 17592186287850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b7cee0-d64b-5acf-80f6-e4395feda439" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186285016} {:answer/id #uuid "43074725-3f05-5199-8c89-774b6421cd7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{\\sqrt{17}}" :db/id #edb/ref 17592186285407} {:answer/id #uuid "aad0caa3-f123-5a0b-bd2b-e7efddced7e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186286346} {:answer/id #uuid "e3226fe7-e48a-5225-9072-a624a09264f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186286863} {:answer/id #uuid "f9ca23d4-64d5-5790-abdd-f668d2d603e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186287071}] :answer-field/correct {:db/id #edb/ref 17592186285407} :answer-field/id #uuid "22c5b613-158c-53cc-a454-1a0b462e7843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287222}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8c5361cf-1bb5-5b1a-8111-4c0f01c39896" :question/math-academy-id "q-18372" :question/problem "Let $c=⟨-2,0,0⟩$ and $d=⟨4,-1,0⟩.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{-2\\cdot 4+0\\cdot (-1)+0\\cdot 0}{\\sqrt{{4}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =-\\frac{8}{\\sqrt{17}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f5744ef-1b8e-5152-8f6b-6c58808e05e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186285821} {:answer/id #uuid "75a1e7cc-e3a2-51b8-bca9-b3b300d0756f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285880} {:answer/id #uuid "a39acd59-c1ec-51d0-a69d-f4370d5bdf1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186286288} {:answer/id #uuid "ac05f264-0ba2-5898-bdea-abf6a84471dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186286361} {:answer/id #uuid "dd89447a-889f-5b9e-92e0-00cf6cf24813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186286804}] :answer-field/correct {:db/id #edb/ref 17592186286288} :answer-field/id #uuid "6af7f554-1c70-5cd5-8470-5c00835248b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287372}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ddbfd2e-178a-532d-aeb2-81eedf1fe8dc" :question/math-academy-id "q-18580" :question/problem "Calculate the area of the triangle spanned by $r=⟨1,-2,3⟩$ and $t=⟨0,1,-2⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}r\\times t & =\\begin{vmatrix}i & j & k \\\\ 1 & -2 & 3 \\\\ 0 & 1 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 3 \\\\ 1 & -2\\end{vmatrix}i-\\begin{vmatrix}1 & 3 \\\\ 0 & -2\\end{vmatrix}j+\\begin{vmatrix}1 & -2 \\\\ 0 & 1\\end{vmatrix}k \\\\  & =((-2)\\cdot (-2)-3\\cdot 1)i-(1\\cdot (-2)-3\\cdot 0)j+(1\\cdot 1-(-2)\\cdot 0)k \\\\  & =i+2j+k \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,r\\times t\\,| \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{6}}{2}.\n$$"}] [{:db/id #edb/ref 17592186287887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1920d715-e444-516d-8fac-793798266f68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285011} {:answer/id #uuid "29e1177a-6728-5e48-bee7-8dc0e9fdc691" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186285154} {:answer/id #uuid "a7af1a98-7783-53e1-8fd7-c75ee0dc0fa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186286317} {:answer/id #uuid "af7def2a-51b9-5a38-89f0-dcfcbe125b08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186286387} {:answer/id #uuid "f54aae70-dfb4-5043-9686-2b5185587d3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186287034}] :answer-field/correct {:db/id #edb/ref 17592186287034} :answer-field/id #uuid "da1704eb-bbb3-5f38-b0f6-6aae59a45a8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287592}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "20a90ebb-b81e-5c2a-8135-e658aa05c005" :question/math-academy-id "q-18581" :question/problem "Calculate the area of the $△\\,LMN$, if $L(0,0,1)$, $M(2,1,1)$, $N(3,1,1).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(2i+j+k)-k \\\\  & =2i+j \\\\  & =⟨2,1,0⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(3i+j+k)-k \\\\  & =3i+j \\\\  & =⟨3,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & 0 \\\\ 3 & 1 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 0 \\\\ 1 & 0\\end{vmatrix}i-\\begin{vmatrix}2 & 0 \\\\ 3 & 0\\end{vmatrix}j+\\begin{vmatrix}2 & 1 \\\\ 3 & 1\\end{vmatrix}k \\\\  & =(1\\cdot 0-0\\cdot 1)i-(2\\cdot 0-0\\cdot 3)j+(2\\cdot 1-1\\cdot 3)k \\\\  & =-k \\\\  & =⟨0,0,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{0}^{2}+{0}^{2}+(-1)^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186287909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cdf7785-cbcd-5112-bc95-0ebbc936c864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{12}" :db/id #edb/ref 17592186285506} {:answer/id #uuid "6c3e8d51-22f5-56d9-bed9-0046f6689fee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186285779} {:answer/id #uuid "cc2594eb-bee1-5bc9-9567-d9bdbbe0c102" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186286647} {:answer/id #uuid "cd97d40d-cba1-5ada-8396-a11d2d4f6bbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186286658} {:answer/id #uuid "e137dd90-b672-5a36-ac92-f22334af1df6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186286837}] :answer-field/correct {:db/id #edb/ref 17592186286658} :answer-field/id #uuid "126e0055-240c-57c8-bdd7-5831adf2287c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287177}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9064a6be-d660-5dcb-af2d-9691a386096a" :question/math-academy-id "q-19023" :question/problem "Let $g=\\begin{bmatrix}{r}^{2} \\\\ -1 \\\\ -6\\end{bmatrix}$ and $h=\\begin{bmatrix}3 \\\\ {r}^{2} \\\\ 2\\end{bmatrix}.$ Given that $g⊥h$ and $r<0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186287928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "198f22c6-0445-52bc-83aa-a928d6491b15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{19}{\\sqrt{14}}" :db/id #edb/ref 17592186285014} {:answer/id #uuid "2b3a4a86-225d-534b-a15d-5918f2ea011f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{19}{\\sqrt{26}}" :db/id #edb/ref 17592186285165} {:answer/id #uuid "6551806f-9af4-5acf-baf5-f8bd266bcb68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{\\sqrt{14}}" :db/id #edb/ref 17592186285708} {:answer/id #uuid "b1687580-4bf2-516a-a1c5-2dc6481b4840" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{\\sqrt{26}}" :db/id #edb/ref 17592186286410} {:answer/id #uuid "b59822c4-ae90-5342-a493-51dfdcaedf77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286441}] :answer-field/correct {:db/id #edb/ref 17592186286441} :answer-field/id #uuid "db4d957e-68bd-5532-97ab-71b9f41f4d22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287595}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a28b642f-c4d9-5d12-89ce-977b27587408" :question/math-academy-id "q-19139" :question/problem "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "878d43a6-d107-5eec-8449-fd467cac8ebd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{3\\sqrt{11}}" :db/id #edb/ref 17592186286029} {:answer/id #uuid "933aaa15-11df-5f3e-ae55-c0208c1380e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{2\\sqrt{11}}" :db/id #edb/ref 17592186286125} {:answer/id #uuid "9d4d067c-ee1e-5639-885e-2771ed5aec7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{\\sqrt{33}}" :db/id #edb/ref 17592186286227} {:answer/id #uuid "df6c1f7d-e888-572e-ae9a-4ca94e13c1c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{\\sqrt{22}}" :db/id #edb/ref 17592186286825} {:answer/id #uuid "f9db8267-d997-5b03-8fb6-b817c07e5f31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{22}{\\sqrt{23}}" :db/id #edb/ref 17592186287072}] :answer-field/correct {:db/id #edb/ref 17592186286825} :answer-field/id #uuid "5e7fbbe9-37af-5f89-a880-f7a5a7a0a366" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287349}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5a770afc-2081-5ea1-a846-77f04dfffce6" :question/math-academy-id "q-19142" :question/problem "Let $p=⟨4,1,4⟩$ and $q=⟨2,3,3⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28850236-3de7-5c0f-ad4a-582ad9110aa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186285141} {:answer/id #uuid "664869a8-b432-582c-8b54-e197d9d1a3df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186285715} {:answer/id #uuid "bfccf2a2-4590-5036-915e-9685779cef8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}-\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186286542} {:answer/id #uuid "c40ec30b-c8c3-5bdf-bfde-854b6e185a64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186286586} {:answer/id #uuid "fd89f41f-3a93-5bce-90c4-03f483be869a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\sqrt{6}-\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186287106}] :answer-field/correct {:db/id #edb/ref 17592186285715} :answer-field/id #uuid "d28ece84-3df4-51e6-a121-897423efdecc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287579}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e415a913-d869-5296-88b6-0354f2046768" :question/math-academy-id "q-19143" :question/problem "Let $a=⟨2,1,-1⟩$ and $b=⟨1,4,2⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+1\\cdot 4+(-1)\\cdot 2}{\\sqrt{{1}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{21}}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{\\sqrt{21}}-\\frac{4}{\\sqrt{6}} \\\\  & =\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28821f48-88e1-581d-b34d-ec1fc4f59a03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{55}{3}" :db/id #edb/ref 17592186285140} {:answer/id #uuid "49409df2-050f-52a4-8e83-0d1c45e7ad2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33}{5}" :db/id #edb/ref 17592186285462} {:answer/id #uuid "58358764-c4a7-5af5-92ea-b6dcb1906bdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186285599} {:answer/id #uuid "7217bf98-ec78-513a-8e37-cb8d6a8b8ed9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33}{15}" :db/id #edb/ref 17592186285838} {:answer/id #uuid "e30bceea-881e-560d-b0c5-a474f1311ae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{22}{15}" :db/id #edb/ref 17592186286861}] :answer-field/correct {:db/id #edb/ref 17592186286861} :answer-field/id #uuid "73a60c4c-5c55-56bb-b830-7bdc6154b85e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287389}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3ff49977-bf49-5e35-8d9c-c45493e6961d" :question/math-academy-id "q-19145" :question/problem "Let $c=⟨4,3,0⟩$ and $d=⟨2,1,2⟩.$ Find ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1930a8b6-cd05-5bad-be3f-eae31bbbbee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186285012} {:answer/id #uuid "b0026f8e-38dc-5c51-a2ec-b994f309e5ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{12}" :db/id #edb/ref 17592186286394} {:answer/id #uuid "d4184123-74bc-5c11-b1a2-60f3c7b8e2f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186286715} {:answer/id #uuid "d4c28def-c746-5f59-b80d-ed038e2ec013" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{13}{12}" :db/id #edb/ref 17592186286721} {:answer/id #uuid "fccd42d0-c67a-57fd-b47a-85f3c8797917" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186287100}] :answer-field/correct {:db/id #edb/ref 17592186286721} :answer-field/id #uuid "a60e4480-c03a-5f50-bfa4-7a3ebfb11c72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287481}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e1b2619c-accd-562b-971e-880743f34699" :question/math-academy-id "q-19146" :question/problem "Let $a=⟨-1,2,\\sqrt{11}⟩$ and $b=⟨4,3,\\sqrt{11}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149b0e75-0e0f-5b6e-898f-b91b5abc2f2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{10}" :db/id #edb/ref 17592186284970} {:answer/id #uuid "539e28bb-ac48-5446-acd3-14cf0e617f7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{29}{5}" :db/id #edb/ref 17592186285557} {:answer/id #uuid "5d2ad1eb-65e3-5cb3-8131-71ed7fbd9966" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186285642} {:answer/id #uuid "5edbada8-12de-53cc-8e94-28f1564de9d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{29}{5}" :db/id #edb/ref 17592186285656} {:answer/id #uuid "9fa64933-2e58-52bb-a74a-53c5dfe77c92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186286243}] :answer-field/correct {:db/id #edb/ref 17592186285642} :answer-field/id #uuid "1d07da54-40a4-54d3-b699-33effe67a77d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287210}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a3ddc06-901e-5c3b-a45b-37325838cc5b" :question/math-academy-id "q-19147" :question/problem "Let $p=⟨1,4,2\\sqrt{2}⟩$ and $q=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31831168-454f-5baf-9173-586eba9d4624" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{14}}{2}" :db/id #edb/ref 17592186285238} {:answer/id #uuid "3b19523e-0825-5461-afc4-1afb51acc0f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{14}}{3}" :db/id #edb/ref 17592186285344} {:answer/id #uuid "6c0bab51-aa06-5633-ad7e-cad3a75b9f36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186285778} {:answer/id #uuid "77a22a7a-5f71-57a2-bca0-1e46be7780e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186285899} {:answer/id #uuid "c7c0d194-f09e-5a8c-aaff-63d2d1628464" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}}{2}" :db/id #edb/ref 17592186286617}] :answer-field/correct {:db/id #edb/ref 17592186285778} :answer-field/id #uuid "35ae4963-3d48-5daa-bb09-fff5ace57f0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287258}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa11bb3b-6421-5e71-90eb-d6514f51a379" :question/math-academy-id "q-19981" :question/problem "Calculate the area of the parallelogram spanned by $u=⟨2,1,-1⟩$ and $v=⟨1,2,0⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & -1 \\\\ 1 & 2 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 2 & 0\\end{vmatrix}i-\\begin{vmatrix}2 & -1 \\\\ 1 & 0\\end{vmatrix}j+\\begin{vmatrix}2 & 1 \\\\ 1 & 2\\end{vmatrix}k \\\\  & =(1\\cdot 0-2\\cdot (-1))i-(2\\cdot 0-1\\cdot (-1))j+(2\\cdot 2-1\\cdot 1)k \\\\  & =2i-j+3k \\\\  & =⟨2,-1,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,u\\times v\\,| \\\\  & =\\sqrt{{2}^{2}+(-1)^{2}+{3}^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36790fe4-27d4-5430-88cf-40fdcbb1fe9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186285294} {:answer/id #uuid "b3f9e5eb-469c-55c5-8da6-311732c4b4a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186286426} {:answer/id #uuid "ba27497f-dcbe-599e-afe6-02f759bdea5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{5}}{3}" :db/id #edb/ref 17592186286485} {:answer/id #uuid "bda96f26-df0a-565b-8da0-e4190336d93e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{3}}{2}" :db/id #edb/ref 17592186286522} {:answer/id #uuid "dc8e723b-8aea-5162-a514-5d1ec48189fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186286796}] :answer-field/correct {:db/id #edb/ref 17592186286796} :answer-field/id #uuid "72125cc1-d961-5f15-b759-baf12f6c70d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287386}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f2ce5a4-7f12-54b1-ab3b-420eb2d47dab" :question/math-academy-id "q-19997" :question/problem "Calculate the area of the parallelogram spanned by $f=⟨1,1,-2⟩$ and $g=⟨3,2,1⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}f\\times g & =\\begin{vmatrix}i & j & k \\\\ 1 & 1 & -2 \\\\ 3 & 2 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -2 \\\\ 2 & 1\\end{vmatrix}i-\\begin{vmatrix}1 & -2 \\\\ 3 & 1\\end{vmatrix}j+\\begin{vmatrix}1 & 1 \\\\ 3 & 2\\end{vmatrix}k \\\\  & =(1\\cdot 1-2\\cdot (-2))i-(1\\cdot 1-3\\cdot (-2))j+(1\\cdot 2-3\\cdot 1)k \\\\  & =5i-7j-k \\\\  & =⟨5,-7,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,f\\times g\\,| \\\\  & =\\sqrt{{5}^{2}+(-7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{75} \\\\  & =5\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce73380-2abe-591b-a501-2fffb25e9869" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186284895} {:answer/id #uuid "1b175e13-968e-5ec8-9d17-0a77d893b075" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186285027} {:answer/id #uuid "2e9105f8-f2d6-5c3f-9c60-b593e96c51d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186285206} {:answer/id #uuid "ab82b635-2160-5ed5-a7f7-47c54a617da1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186286354} {:answer/id #uuid "ace7fdea-5fb7-5fd8-aa32-30d01d52a4f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186286368}] :answer-field/correct {:db/id #edb/ref 17592186286368} :answer-field/id #uuid "b1b35598-0d81-58f5-9d4e-8b067b0830b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287516}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9a99808d-9449-580d-ae70-e6aff48c1ff9" :question/math-academy-id "q-20004" :question/problem "Calculate the area of the parallelogram spanned by $h=⟨2,0,3⟩$ and $l=⟨4,1,3⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}h\\times l & =\\begin{vmatrix}i & j & k \\\\ 2 & 0 & 3 \\\\ 4 & 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 3 \\\\ 1 & 3\\end{vmatrix}i-\\begin{vmatrix}2 & 3 \\\\ 4 & 3\\end{vmatrix}j+\\begin{vmatrix}2 & 0 \\\\ 4 & 1\\end{vmatrix}k \\\\  & =(0\\cdot 3-1\\cdot 3)i-(2\\cdot 3-4\\cdot 3)j+(2\\cdot 1-4\\cdot 0)k \\\\  & =-3i+6j+2k \\\\  & =⟨-3,6,2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,h\\times l\\,| \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d78b70-cb8f-5e6f-99ce-03eb325a6129" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186284818} {:answer/id #uuid "0586a3e6-6eb5-5101-969f-81fc47045d2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186284833} {:answer/id #uuid "57c889db-8102-5c28-aa33-9a91e2b2a89f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186285591} {:answer/id #uuid "bcba07e4-2097-5048-b82d-fcda445cced9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186286508} {:answer/id #uuid "c3c8ab1c-911c-552c-9f08-414eae7622f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186286582}] :answer-field/correct {:db/id #edb/ref 17592186284818} :answer-field/id #uuid "6c509f79-9189-5afb-8b33-24e72c7a6b3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287374}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cee105b4-e3ae-5a95-a3ab-a9f9dc2703a2" :question/math-academy-id "q-20017" :question/problem "Calculate the area of the $△\\,RST$, if $R(3,-2,1)$, $S(2,-2,2)$, $T(1,-3,3).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =s-r \\\\  & =(2i-2j+2k)-(3i-2j+k) \\\\  & =-i+k \\\\  & =⟨-1,0,1⟩ \\\\ \\overset{\\to }{RT} & =t-r \\\\  & =(i-3j+3k)-(3i-2j+k) \\\\  & =-2i-j+2k \\\\  & =⟨-2,-1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{RS}\\times \\overset{\\to }{RT} & =\\begin{vmatrix}i & j & k \\\\ -1 & 0 & 1 \\\\ -2 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 1 \\\\ -1 & 2\\end{vmatrix}i-\\begin{vmatrix}-1 & 1 \\\\ -2 & 2\\end{vmatrix}j+\\begin{vmatrix}-1 & 0 \\\\ -2 & -1\\end{vmatrix}k \\\\  & =(0\\cdot 2-(-1)\\cdot 1)i-((-1)\\cdot 2-(-2)\\cdot 1)j+((-1)\\cdot (-1)-(-2)\\cdot 0)k \\\\  & =i+k \\\\  & =⟨1,0,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{RS}\\times \\overset{\\to }{RT}| \\\\  & =\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,RST$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$"}] [{:db/id #edb/ref 17592186290429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27376309-d644-597d-a2c9-90859cc06cff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "288" :db/id #edb/ref 17592186288291} {:answer/id #uuid "2dfba689-75b2-5e71-83fa-300f0b52711b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72" :db/id #edb/ref 17592186288343} {:answer/id #uuid "66be0097-da64-5230-a199-d4415883412f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128" :db/id #edb/ref 17592186288751} {:answer/id #uuid "a8ac569a-5062-5f6f-ab92-813702cf3b7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186289151} {:answer/id #uuid "b5a1e55a-e608-50ab-be11-0613ec305f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "256" :db/id #edb/ref 17592186289232}] :answer-field/correct {:db/id #edb/ref 17592186289232} :answer-field/id #uuid "39f8f410-9e95-5f99-a90d-85e470264e2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289855}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "10d8ca93-3d42-5558-a25c-f6c42ee07223" :question/math-academy-id "q-226126" :question/problem "![](images/6f/6f827dac7ecaf3a659245d1178aa39a519ae3a40339c917004247f12554c871a.png)\n\nConsider the vector field $F=2x\\,i+2y\\,j$ and a square $C$ with side length $8$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across all four sides of the square.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/0b/0b753318ebad9270c3fc8788d0e3949ffb29a800eb3f8dd6fb67cb271be68033.png)\n\nFirst, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(2x\\,i+2y\\,j)\\cdot i\\,\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=4\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-4,4].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\,\\text{d}s & =2{\\int }_{-4}^{4}4\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =8{\\int }_{-4}^{4}\\text{d}t \\\\  & =8(4-(-4)) \\\\  & =8\\cdot 8 \\\\  & =64.\\end{aligned}\n$$\n\nBy symmetry, the flux integrals over the sides ${C}_{2},{C}_{3},$ and ${C}_{4}$ must be the same. Therefore,\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=4\\cdot 64=256.\n$$"}] [{:db/id #edb/ref 17592186290430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152fede1-5726-517f-a05e-876200b5ee78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "156" :db/id #edb/ref 17592186288176} {:answer/id #uuid "413223d4-8a5c-5d2b-9abe-668e2bd30c32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "176" :db/id #edb/ref 17592186288475} {:answer/id #uuid "77244b17-d797-5c25-af3e-b7be4b5247e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "144" :db/id #edb/ref 17592186288853} {:answer/id #uuid "f4aa3f09-ac58-5db0-a8cf-92e3e9290ba0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "164" :db/id #edb/ref 17592186289645} {:answer/id #uuid "ffc32f2b-2e06-5d37-ad35-f23957cef930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "180" :db/id #edb/ref 17592186289724}] :answer-field/correct {:db/id #edb/ref 17592186288853} :answer-field/id #uuid "0f51012a-ecf2-53cc-b685-8df57cc4cd3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289768}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d5afdf08-64c4-5039-ae6a-14029973d009" :question/math-academy-id "q-226133" :question/problem "![](images/2d/2dcfb8778adf7e9a05ff1dff886d0d8290427ed2ae910b46db4fe9aeb36170eb.png)\n\nConsider the vector field $F=x\\,i+3y\\,j$ and a square $C$ with side length $6$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/f2/f283fe675e0a9ef736947e404f03ab5afb90a4209ba1a6949d18ac6d3fb20048.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(x\\,i+3y\\,j)\\cdot i\\,\\text{d}s \\\\  & ={\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}x\\,\\text{d}s & ={\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =3{\\int }_{-3}^{3}\\text{d}t \\\\  & =3\\cdot 6 \\\\  & =18.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=18.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(x\\,i+3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+3\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{2}}y\\,\\text{d}s & =3{\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =9{\\int }_{-3}^{3}\\text{d}t \\\\  & =9\\cdot 6 \\\\  & =54.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=54.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 18+2\\cdot 54=144.\n$$"}] [{:db/id #edb/ref 17592186290431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68c3c913-6ba1-589f-b840-0c1c159c5673" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186288765} {:answer/id #uuid "87c909c6-4a8b-53ba-9fe3-85ea04806d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186288947} {:answer/id #uuid "8ca45b03-5e4b-5dc7-a0d5-d0be258cb0e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186288972} {:answer/id #uuid "98530f43-0be2-5253-982a-5e1438c34a83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42" :db/id #edb/ref 17592186289053} {:answer/id #uuid "d44d97a4-ddc4-54ff-bcc7-703ddeca5526" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186289438}] :answer-field/correct {:db/id #edb/ref 17592186288947} :answer-field/id #uuid "8cd839a4-a88e-5b41-ab67-448f00d8b008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290041}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3cf6fcba-4714-5b05-9571-4d5f1a493fd4" :question/math-academy-id "q-226135" :question/problem "![](images/ec/ec48931b53248128f4eefd2fe2428120adeef983b6fd2a613e7dcca96c00fe12.png)\n\nConsider the vector field $F=2x\\,i-y\\,j$ and a square $C$ with side length $6$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/86/867ab8337894fa75d010bcb12557702059a4a93aaa2bdef2f853c46ff2801d67.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(2x\\,i-y\\,j)\\cdot i\\,\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\,\\text{d}s & =2{\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=36.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(2x\\,i-y\\,j)\\cdot j\\,\\text{d}s \\\\  & =-{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+3\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-{\\int }_{{C}_{1}}y\\,\\text{d}s & =-{\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-3}^{3}\\text{d}t \\\\  & =-3\\cdot 6 \\\\  & =-18.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=-18.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 36+2\\cdot (-18)=36.\n$$"}] [{:db/id #edb/ref 17592186290432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33a7f4b5-7cd8-5940-8c69-846081503ee2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186288372} {:answer/id #uuid "88197c07-3a6b-5987-bb1c-74af6ddc7d2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186288949} {:answer/id #uuid "8fdaa769-2e35-5ecc-99d5-dfff81635172" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186288995} {:answer/id #uuid "b789b18f-9e62-5ef5-849d-af6b3ac4df59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186289248} {:answer/id #uuid "dc728a29-5158-5872-a5a0-0b92e91b195a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186289499}] :answer-field/correct {:db/id #edb/ref 17592186289499} :answer-field/id #uuid "a8ca8232-836f-5ef4-a146-93cc8fbacbb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290106}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4d0758f2-17c6-502d-ba56-8303db371c67" :question/math-academy-id "q-226149" :question/problem "![](images/0a/0a62dfaec4e967433ef56d319e4e66a220441a711ce97a84ca96a4bbd7d0bf37.png)\n\nConsider the vector field $F=2x\\,i-3y\\,j$ and a rectangle $C$ with base $4$ and height $2$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/00/00a9df76d0be8ffd33b2ee968b57a21eb1e6947af6e94505313f163b584f5769.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(2x\\,i-3y\\,j)\\cdot i\\,\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=2i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\,\\text{d}s & =2{\\int }_{-1}^{1}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =4{\\int }_{-1}^{1}\\text{d}t \\\\  & =4\\cdot 2 \\\\  & =8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=8.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(2x\\,i-3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =-3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-3{\\int }_{{C}_{2}}y\\,\\text{d}s & =-3{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=-12.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 8+2\\cdot (-12)=-8.\n$$"}] [{:db/id #edb/ref 17592186290434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dabc53b-7f14-580e-9dfc-62c43ae6e5b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186288220} {:answer/id #uuid "522030d5-4b17-54f8-8958-12fdb0032b09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186288601} {:answer/id #uuid "7ffee840-90f4-5267-a69d-56a7b110e4ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54" :db/id #edb/ref 17592186288897} {:answer/id #uuid "9794e61c-293d-58a5-913c-74da807b4f9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42" :db/id #edb/ref 17592186289049} {:answer/id #uuid "ad33f942-65c1-5719-bd3e-bdd804dc2bf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186289179}] :answer-field/correct {:db/id #edb/ref 17592186289179} :answer-field/id #uuid "163d16b5-420f-5024-8996-baf2ca361651" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289782}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6848eb02-e01e-5364-9fcf-7d0ce934cecc" :question/math-academy-id "q-226150" :question/problem "![](images/80/80cc5e165f78bc1fc8cc7f83644fd00ca4a8f4e05e69d97b654bb2f1450d9b99.png)\n\nConsider the vector field $F=-x\\,i+3y\\,j$ and a rectangle $C$ with base $6$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/51/511bae61d710c3362bb18618717b3d44ef5dcedece5f669e0b5237b7b524a054.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-x\\,i+3y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-{\\int }_{{C}_{1}}x\\,\\text{d}s & =-{\\int }_{-2}^{2}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=-12.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(-x\\,i+3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{2}}y\\,\\text{d}s & =3{\\int }_{-3}^{3}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=36.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot (-12)+2\\cdot 36=48.\n$$"}] [{:db/id #edb/ref 17592186290435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05bced42-9d9b-51eb-a8d9-8037582027ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186288075} {:answer/id #uuid "2d72cffe-4c07-5c70-b05b-180492dc12a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186288334} {:answer/id #uuid "47db62fc-8131-5663-b17b-7d3455d7dd0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186288527} {:answer/id #uuid "648ce239-aa26-55b4-97d5-fe6bb326ae67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186288743} {:answer/id #uuid "8a83f196-f6c0-5e78-9d8c-b4264e812e15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186288960}] :answer-field/correct {:db/id #edb/ref 17592186288527} :answer-field/id #uuid "a03be787-385b-5f52-9f16-af8df82818b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290084}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a69a7a8b-52c6-5396-ab13-a2f6e97bdfa1" :question/math-academy-id "q-226152" :question/problem "![](images/0a/0ac0fa01b3e09d268115a604a53ca6247c9e26d88603482223aa43927df20561.png)\n\nConsider the vector field $F=-2x\\,i+5y\\,j$ and a rectangle $C$ with base $2$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/29/29f4b57751e27f01539fb48acf115b6e255d47a04ee647ef85aa496731b266c8.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-2x\\,i+5y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-2{\\int }_{{C}_{1}}x\\,\\text{d}s & =-2{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-2{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-2)\\cdot 4 \\\\  & =-8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=-8.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(-2x\\,i+5y\\,j)\\cdot j\\,\\text{d}s \\\\  & =5{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}5{\\int }_{{C}_{2}}y\\,\\text{d}s & =5{\\int }_{-1}^{1}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =10{\\int }_{-1}^{1}\\text{d}t \\\\  & =10\\cdot 2 \\\\  & =20.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=20.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot (-8)+2\\cdot 20=24.\n$$"}] [{:db/id #edb/ref 17592186290486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "641ccdd7-0572-5c4f-b7e6-d4afe84948d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186288736} {:answer/id #uuid "66ccc376-8b86-58f9-b2ff-5c6b7268656c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288752} {:answer/id #uuid "72db54e1-ea6b-5dd6-a346-7ef3737b3912" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186288831} {:answer/id #uuid "d8aca7b4-fb6f-58c2-83da-427e09c26a5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186289478} {:answer/id #uuid "ed0c240a-396a-521b-addd-33491e305d80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186289599}] :answer-field/correct {:db/id #edb/ref 17592186288831} :answer-field/id #uuid "d2d641b9-8ae0-5f17-b941-11db55cc78a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290188}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5d78299-26e4-51e8-b76f-fbcf41be9fda" :question/math-academy-id "q-237014" :question/problem "Let $p=\\begin{bmatrix}-2 \\\\ 0 \\\\ 5\\end{bmatrix}$ and $q=\\begin{bmatrix}15 \\\\ \\sqrt{2} \\\\ x\\end{bmatrix}.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-2)\\cdot 15+0\\cdot \\sqrt{2}+5\\cdot x \\\\  & =5x-30.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 5x-30 & =0 \\\\ 5x & =30 \\\\ x & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f63989c-30f1-5c24-b29f-efbf4137d328" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186288234} {:answer/id #uuid "1fcdfc3c-0b4f-56d0-8865-1174e6c456fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186288238} {:answer/id #uuid "436014ad-b619-5cc4-b0db-f17722d1681a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186288492} {:answer/id #uuid "45206803-f9d0-55fe-be31-cc4c00a72853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186288501} {:answer/id #uuid "92856ac6-8e97-51a2-9023-612b203bc678" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186289016}] :answer-field/correct {:db/id #edb/ref 17592186288234} :answer-field/id #uuid "094c47e3-6adf-5882-8699-9b8ef4f4d74a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289746}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f879853f-8faf-5226-ac51-81b9eb8102b2" :question/math-academy-id "q-237015" :question/problem "Let $p=\\begin{bmatrix}5 \\\\ x \\\\ 2\\end{bmatrix}$ and $q=\\begin{bmatrix}4 \\\\ -2 \\\\ -3\\end{bmatrix}.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =5\\cdot 4+x\\cdot (-2)+2\\cdot (-3) \\\\  & =14-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 14-2x & =0 \\\\ 2x & =14 \\\\ x & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b700fff-7350-5a76-9d33-c6381d7b4af9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186288117} {:answer/id #uuid "1c148563-2d95-5d3e-a347-48d7c955421a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288212} {:answer/id #uuid "2a0223ed-9e09-5f4d-8cc1-702460540107" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186288310} {:answer/id #uuid "c4c48f5e-b790-58d9-875e-5aaa2333b742" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186289334} {:answer/id #uuid "f1e9c580-629d-51e0-8934-3fda8eae5fe1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186289631}] :answer-field/correct {:db/id #edb/ref 17592186288310} :answer-field/id #uuid "348703ae-c9d1-5e58-8c49-61fe59940c35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289842}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a6e6afc-4f8e-5725-a54c-691ecc02b5ca" :question/math-academy-id "q-237016" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}$ and $b=\\begin{bmatrix}-2 \\\\ x \\\\ 2\\end{bmatrix}.$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2a414a-e78b-5958-8429-12052b4523b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186288205} {:answer/id #uuid "8c9f2614-32c3-56e5-a409-d2760ef70248" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288971} {:answer/id #uuid "b251eb43-1e9d-55b6-850c-8b2662839755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186289210} {:answer/id #uuid "cb0819fe-16d3-5da2-9e12-f9a8552518f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186289378} {:answer/id #uuid "f278ef26-95d6-561a-bd55-6e9c6609d020" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186289634}] :answer-field/correct {:db/id #edb/ref 17592186289634} :answer-field/id #uuid "2a6e7ba3-1c4d-5d41-a107-43b856da8d1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289828}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ede3719-f0d6-5ce0-9786-3cb5498e6270" :question/math-academy-id "q-237017" :question/problem "Let $p=i-3j$ and $q=xi+2j+k.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot x+(-3)\\cdot 2+0\\cdot 1 \\\\  & =x-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-6 & =0 \\\\ x & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186288339} {:answer/id #uuid "4be5c6a7-9473-5f8f-a76d-361e76618b03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186288557} {:answer/id #uuid "969e8fda-7e9c-55a7-bced-44ceb4371dda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186289039} {:answer/id #uuid "cbe15376-5215-5280-ae06-1a3991f84d01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186289384} {:answer/id #uuid "eb4d7bb2-b033-5091-b1bf-ce3cd9d629f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186289590}] :answer-field/correct {:db/id #edb/ref 17592186288339} :answer-field/id #uuid "0bd2ffd0-af54-5576-8d75-4029636169bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289757}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "23ed6766-8e64-5c6e-b8a5-b8f25dcf697a" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341784da-b585-53fe-93fa-c3cbb0d2b032" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288377} {:answer/id #uuid "8ca536b9-617f-5625-ad14-acd349960cf7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186288973} {:answer/id #uuid "ac275e68-b65e-502d-8d04-712cba1e1a03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186289174} {:answer/id #uuid "bba33e30-0659-53ad-a553-8814871bb2ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186289270} {:answer/id #uuid "f03674f0-c895-5b67-901a-d1feb586a561" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186289620}] :answer-field/correct {:db/id #edb/ref 17592186288377} :answer-field/id #uuid "fff57b46-70ef-54bd-87fb-a12c9a20446e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186290256}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8158669b-62f4-54f1-8025-20269eb7a332" :question/math-academy-id "q-237020" :question/problem "Let $p=⟨2,0,3⟩$ and $q=⟨3,0,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot 3+0\\cdot 0+3\\cdot x \\\\  & =3x+6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+6 & =0 \\\\ 3x & =-6 \\\\ x & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13792421-9275-5651-8409-88c85398dd37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186288166} {:answer/id #uuid "490f58c8-c786-5d31-8e1c-79dccd244271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288538} {:answer/id #uuid "710f00a5-6a28-5ddc-bbc9-f671cc856f77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288818} {:answer/id #uuid "95c00138-66e1-5e8b-a88a-99d98837093b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186289032} {:answer/id #uuid "fc1f4fad-69ca-506c-bf35-61221cd5e6c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186289696}] :answer-field/correct {:db/id #edb/ref 17592186288166} :answer-field/id #uuid "10ff23a8-ea19-544f-b919-18be2538ce3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289772}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f85820f0-0e97-5a70-b11e-7b663b24839a" :question/math-academy-id "q-237021" :question/problem "Let $c=⟨-3,\\sqrt{3},1⟩$ and $d=⟨x,0,-12⟩.$ Given that the scalar projection of $c$ onto $d$ is zero, find the value of $x.$" :question/worked-solution "Since $c$ is a nonzero vector, its scalar projection onto another nonzero vector $d$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nc⊥d\\,⟹\\,c\\cdot d=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$"}]}
