l curves are parallel straight lines. A normal is proportional to $(1,-1)$. Use the labels to choose its sense: moving in that direction raises the labels, so it is the gradient direction. Tangent arrows fail perpendicularity; the opposite normal points toward smaller labels.\n\n![Matching contours and gradient directions](images/fe/fe809367f4109420d7f8539abd69407066a052dc10c6b0afa1127ef66fc681c5.png)\n\nTherefore choose this diagram:\n\n![Correct diagram](images/11/11fd2ec491cdd866338cdee26092668315c872558b4b000608dd21f7e6dd701e.png)"}] [{:db/id #edb/ref 17592186708277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a488e71-d3e3-50d5-96f3-5e24a52f2794" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bb/bb83524be625efee137ead1baaddd2a81f0215f0c12a1c804fecbe939a135c00.png" :db/id #edb/ref 17592186708288} {:answer/id #uuid "7ca75ef0-07bd-5d5b-847d-27aed236292d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/ef0f85d081d7330f401f02afbf75847cdcbc9162a6349c819b2e629423581b18.png" :db/id #edb/ref 17592186708290} {:answer/id #uuid "aa1e4987-c7dd-589a-a678-7a817272fa7a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/11/11fd2ec491cdd866338cdee26092668315c872558b4b000608dd21f7e6dd701e.png" :db/id #edb/ref 17592186708294} {:answer/id #uuid "bddb6694-582a-532b-846f-45587d231521" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/12/124001c6fa8e74c0b4576b08eb22e129aa7ddb9081fa8c3a120c480a49b31ce7.png" :db/id #edb/ref 17592186708297} {:answer/id #uuid "e9776936-0986-564d-a3cc-056c71670653" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0c/0c17016c6470aeab549495c4cd7961ec7ad8ca4552fb1a12b0a6f377496f2101.png" :db/id #edb/ref 17592186708301}] :answer-field/correct {:db/id #edb/ref 17592186708288} :answer-field/id #uuid "4304696d-e6ac-554a-94b5-06c2c9b4384d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186