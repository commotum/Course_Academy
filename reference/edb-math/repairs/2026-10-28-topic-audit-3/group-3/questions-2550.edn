9bc-5eb934296230" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186723138}] :answer-field/correct {:db/id #edb/ref 17592186723135} :answer-field/id #uuid "cda097d3-dbd4-5e09-bfad-fa1b8b122678" :answer-field/key "$(9,-5)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186723183}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b62ec31a-4113-5533-9abd-2c73a5ddca3a" :question/problem "At which points on the curve $x^{2} + 2 x y + 2 y^{2} + 4 y + 4=25$ is a tangent vector perpendicular to $\\mathbf v=\\langle 1,1\\rangle$?\n\nSelect all that apply." :question/worked-solution "Set $F(x,y)=x^{2} + 2 x y + 2 y^{2} + 4 y + 4$, so the curve is $F(x,y)=25$. A tangent vector is $\\mathbf t=\\langle F_y,-F_x\\rangle$.\n\n$$\n\\begin{aligned}\nF_x&=2 x + 2 y\\\\\nF_y&=2 x + 4 y + 4\\\\\n\\mathbf t(x,y)&=\\langle 2 x + 4 y + 4,- 2 x - 2 y\\rangle\n\\end{aligned}\n$$\n\nPerpendicularity requires\n\n$$\n\\begin{aligned}\n\\mathbf t\\cdot \\langle 1,1\\rangle&=0\\\\\n2 y + 4&=0\\\\\n2 (y + 2)&=0\n\\end{aligned}\n$$\n\nThe condition gives $y=-2$. Substitution into the original curve gives\n\n$$\n\\begin{aligned}\nx^{2} - 4 x + 4&=25\\\\\n(x - 7) (x + 3)&=0\n\\end{aligned}\n$$\n\nHence $x=-3$ or $x=7$. Recovering the other coordinate gives $(-3,-2)$ and $(7,-2)$.\n\nThus the qualifying points are $(7,-2)$ and $(-3,-2)$. All listed points lie on the curve. The following nonzero tangent vectors check every choice:\n\n$$\n\\begin{aligned}\n\\mathbf t(7,-2)&=\\langle 10,-10\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,1\\rangle=0\\\\\n\\mathbf t(-3,-2)&=\\langle -10,10\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,1\\rangle=0\\\\\n\\mathbf t(1,2)&=\\langle 14,-6\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,1\\rangle=8\\\\\n\\mathbf t(3,-6)&=\\langle -14,6\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,1\\rangle=-8\\\\\n\\mathbf t(9,-5)&=\\langle 2,-8\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,1\\rangle=-6\\\\\n\\mathbf t(-5,1)&=\\langle -2,8\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,1\\rangle=6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186723174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9ce7a33-3553-5dae-b044-c8ce99e65dde" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186723175} {:answer/id #uuid "f7ac5a15-4d95-5da6-b14f-b4956fb63709" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186723194}] :answer-field/correct {:db/id #edb/ref 17592186723194} :answer-field/id #uuid "0dc06d98-9fcb-5d23-8d0b-3ea83a3ebafb" :answer-field/key "$(-3,0)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186723108} {:answer-field/choices [{:answer/id #uuid "2315f16d-705b-5a6e-92fd-4a06eef6d840" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186723114} {:answer/id #uuid "e931fde2-18c3-58eb-ac4c-d3e4bd54e4a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186723190}] :answer-field/correct {:db/id #edb/ref 17592186723114} :answer-field/id #uuid "19f93f05-9de1-56b1-bcbf-6f3c3c8805c3" :answer-field/key "$(7,0)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186723110} {:answer-field/choices [{:answer/id #uuid "9e3ee5e8-1209-5d0f-b300-7c9ad792b15b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186723162} {:answer/id #uuid "cfad951b-760c-5e7c-8e08-668738bc756e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186723184}] :answer-field/correct {:db/id #edb/ref 17592186723162} :answer-field/id #uuid "363c7697-a1d7-5787-b5a2-b68d6aed2024" :answer-field/key "$(1,3)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186723124} {:answer-field/choices [{:answer/id #uuid "3a4ca516-a440-5730-ada5-e1d296e5be05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186723127} {:answer/id #uuid "fb5f42b9-c8c2-59b3-9726-019a5786b9f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186723195}] :answer-field/correct {:db/id #edb/ref 17592186723127} :answer-field/id #uuid "3a251e3b-8fe2-589c-85ec-bc474e3b23c6" :answer-field/key "$(-5,-4)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186723126} {:answer-field/choices [{:answer/id #uuid "3b11ad2e-5ccb-5b88-85ff-8effc398e99e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186723128} {:answer/id #uuid "adc8381c-fc5e-57a7-91cc-9f0677ae3945" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186723168}] :answer-field/correct {:db/id #edb/ref 17592186723128} :answer-field/id #uuid "6f19ca61-cc61-52d5-b3ea-a0126ee61b24" :answer-field/key "$(3,-3)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186723145} {:answer-field/choices [{:answer/id #uuid "0563e659-499f-5957-a46c-7512a8eeef85" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186723105} {:answer/id #uuid "679fbc9d-490d-5217-a0d1-6277eae025e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186723140}] :answer-field/correct {:db/id #edb/ref 17592186723105} :answer-field/id #uuid "a1f459d2-3deb-521d-bcd1-fbd6679f34cd" :answer-field/key "$(9,4)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186723166}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b7f37c70-98a3-5e1f-921c-73faf794a220" :question/problem "At which points on the curve $x^{2} - 2 x y - 4 x + 2 y^{2} + 4 y + 4=25$ is a tangent vector perpendicular to $\\mathbf v=\\langle 1,-1\\rangle$?\n\nSelect all that apply." :question/worked-solution "Set $F(x,y)=x^{2} - 2 x y - 4 x + 2 y^{2} + 4 y + 4$, so the curve is $F(x,y)=25$. A tangent vector is $\\mathbf t=\\langle F_y,-F_x\\rangle$.\n\n$$\n\\begin{aligned}\nF_x&=2 x - 2 y - 4\\\\\nF_y&=- 2 x + 4 y + 4\\\\\n\\mathbf t(x,y)&=\\langle - 2 x + 4 y + 4,- 2 x + 2 y + 4\\rangle\n\\end{aligned}\n$$\n\nPerpendicularity requires\n\n$$\n\\begin{aligned}\n\\mathbf t\\cdot \\langle 1,-1\\rangle&=0\\\\\n2 y&=0\n\\end{aligned}\n$$\n\nThe condition gives $y=0$. Substitution into the original curve gives\n\n$$\n\\begin{aligned}\nx^{2} - 4 x + 4&=25\\\\\n(x - 7) (x + 3)&=0\n\\end{aligned}\n$$\n\nHence $x=-3$ or $x=7$. Recovering the other coordinate gives $(-3,0)$ and $(7,0)$.\n\nThus the qualifying points are $(7,0)$ and $(-3,0)$. All listed points lie on the curve. The following nonzero tangent vectors check every choice:\n\n$$\n\\begin{aligned}\n\\mathbf t(7,0)&=\\langle -10,-10\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,-1\\rangle=0\\\\\n\\mathbf t(-3,0)&=\\langle 10,10\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,-1\\rangle=0\\\\\n\\mathbf t(9,4)&=\\langle 2,-6\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,-1\\rangle=8\\\\\n\\mathbf t(-5,-4)&=\\langle -2,6\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,-1\\rangle=-8\\\\\n\\mathbf t(3,-3)&=\\langle -14,-8\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,-1\\rangle=-6\\\\\n\\mathbf t(1,3)&=\\langle 14,8\\rangle,\\qquad \\mathbf t\\cdot \\langle 1,-1\\rangle=6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186723198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2937a93d-6f89-5fe9-852b-95f03ad61b9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{e^{2}}\\,\\mathbf i-\\left(3 - \\frac{4}{e^{2}}\\right)\\,\\mathbf j" :db/id #edb/ref 17592186723203} {:answer/id #uuid "642a7c6c-3971-506d-b533-f18f93167f94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\left(1 - \\frac{2}{e^{2}}\\right)\\,\\mathbf i+\\left(1 - \\frac{4}{e^{2}}\\right)\\,\\mathbf j" :db/id #edb/ref 17592186723209} {:answer/id #uuid "936a1909-d7ba-5e83-a2d8-1bf57c1f9e30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(3 - \\frac{4}{e^{2}}\\right)\\,\\mathbf i-3\\,\\mathbf j" :db/id #edb/ref 17592186723212} {:answer/id #uuid "f8a10e53-6ef0-579c-9ac0-2591ce9dc214" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\left(3 - \\frac{2}{e^{2}}\\right)\\,\\mathbf i-\\left(3 - \\frac{4}{e^{2}}\\right)\\,\\mathbf j" :db/id #edb/ref 17592186723230} {:answer/id #uuid "fe1dc011-2614-50f3-8345-6ac0cf0282a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{2}{e^{2}} + 3\\right)\\,\\mathbf i-\\left(1 - \\frac{4}{e^{2}}\\right)\\,\\mathbf j" :db/id #edb/ref 17592186723232}] :answer-field/correct {:db/id #edb/ref 17592186723230} :answer-field/id #uuid "ec64f3ef-7b24-5787-9e5a-ffeb91289e94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186723225}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00a8b85d-68fd-5965-b2af-1340bf4b5568" :question/problem "Consider the plane curve $2 e^{x y}=3 x - 3 y + \\frac{2}{e^{2}} + 9$. Find a tangent vector to the curve at the point $(-1,2)$." :question/worked-solution "Bring the variable terms to one side and set $f(x,y)=- 3 x + 3 y + 2 e^{x y}$. The curve is the level curve $f(x,y)=\\frac{2}{e^{2}} + 9$, and $f(-1,2)=\\frac{2}{e^{2}} + 9$ confirms that the point lies on it.\n\nA tangent vector is perpendicular to the nonzero gradient. Use $\\mathbf t=f_y\\mathbf i-f_x\\mathbf j$. Differentiate while holding the other variable constant:\n\n$$\n\\begin{aligned}f_x(x,y)&=2 y e^{x y} - 3\\\\ f_y(x,y)&=2 x e^{x y} + 3\\end{aligned}\n$$\n\nAt the supplied point,\n\n$$\n\\begin{aligned}f_x(-1,2)&=2 \\left(2\\right) e^{\\left(-1\\right) \\left(2\\right)} - 3\\\\ &=-3 + \\frac{4}{e^{2}}\\\\ f_y(-1,2)&=2 \\left(-1\\right) e^{\\left(-1\\right) \\left(2\\right)} + 3\\\\ &=3 - \\frac{2}{e^{2}}\\end{aligned}\n$$\n\nThus one tangent vector is\n\n$$\n\\mathbf t(-1,2)=\\left(3 - \\frac{2}{e^{2}}\\right)\\,\\mathbf i+\\left(3 - \\frac{4}{e^{2}}\\right)\\,\\mathbf j.\n$$\n\nMultiplying by $-1$ gives the listed tangent vector $-\\left(3 - \\frac{2}{e^{2}}\\right)\\,\\mathbf i-\\left(3 - \\frac{4}{e^{2}}\\right)\\,\\mathbf j$. The gradient is nonzero. The dot product is\n\n$$\n\\begin{aligned}\\nabla f(-1,2)\\cdot\\mathbf t(-1,2)&=\\left(-3 + \\frac{4}{e^{2}}\\right)\\left(3 - \\frac{2}{e^{2}}\\right)\\\\ &\\quad-\\left(3 - \\frac{2}{e^{2}}\\right)\\left(-3 + \\frac{4}{e^{2}}\\right)\\\\ &=0.\\end{aligned}\n$$\n\nAny nonzero scalar multiple has the same tangent direction; none of the other listed vectors is perpendicular to this gradient."}] [{:db/id #edb/ref 17592186723201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d0e855e-485a-5ae6-83e0-4c4e6b9ec141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\mathbf i-4\\,\\mathbf j" :db/id #edb/ref 17592186723199} {:answer/id #uuid "240f0aa1-435b-56a9-9312-fc2e5113c2e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\pi}{2}\\,\\mathbf i+4\\,\\mathbf j" :db/id #edb/ref 17592186723202} {:answer/id #uuid "87f05cd1-c320-510a-98e5-7cede7db50f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3 \\pi}{2}\\,\\mathbf i-\\mathbf j" :db/id #edb/ref 17592186723211} {:answer/id #uuid "b9a70d84-bf3b-56c4-9b00-f40b9e17e80b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\pi}{2}\\,\\mathbf i+2\\,\\mathbf j" :db/id #edb/ref 17592186723215} {:answer/id #uuid "cd1c7dc6-008c-571b-b3c7-efd7e1bb35a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\mathbf i+\\frac{3 \\pi}{2}\\,\\mathbf j" :db/id #edb/ref 17592186723218}] :answer-field/correct {:db/id #edb/ref 17592186723202} :answer-field/id #uuid "da331a3e-78c1-5a2f-8633-0c82909dad28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186723222}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1e3f745c-e668-5837-86c3-dcb8518e8128" :question/problem "Consider the plane curve $3 \\cos{\\left(x \\right)} \\cos{\\left(y \\right)}=x - 3 \\sin{\\left(x y \\right)} - \\frac{\\pi}{2}$. Find a tangent vector to the curve at the point $(\\frac{\\pi}{2},0)$." :question/worked-solution "Bring the variable terms to one side and set $f(x,y)=- x + 3 \\sin{\\left(x y \\right)} + 3 \\cos{\\left(x \\right)} \\cos{\\left(y \\right)}$. The curve is the level curve $f(x,y)=- \\frac{\\pi}{2}$, and $f(\\frac{\\pi}{2},0)=- \\frac{\\pi}{2}$ confirms that the point lies on it.\n\nA tangent vector is perpendicular to the nonzero gradient. Use $\\mathbf t=f_y\\mathbf i-f_x\\mathbf j$. Differentiate while holding the other variable constant:\n\n$$\n\\begin{aligned}f_x(x,y)&=3 y \\cos{\\left(x y \\right)} - 3 \\sin{\\left(x \\right)} \\cos{\\left(y \\right)} - 1\\\\ f_y(x,y)&=3 x \\cos{\\left(x y \\right)} - 3 \\sin{\\left(y \\right)} \\cos{\\left(x \\right)}\\end{aligned}\n$$\n\nAt the supplied point,\n\n$$\n\\begin{aligned}f_x(\\frac{\\pi}{2},0)&=-1\\\\ &\\quad - 3 \\sin{\\left(\\left(\\frac{\\pi}{2}\\right) \\right)} \\cos{\\left(\\left(0\\right) \\right)}\\\\ &\\quad +3 \\left(0\\right) \\cos{\\left(\\left(\\frac{\\pi}{2}\\right) \\left(0\\right) \\right)}\\\\ &=-4\\\\ f_y(\\frac{\\pi}{2},0)&=- 3 \\sin{\\left(\\left(0\\right) \\right)} \\cos{\\left(\\left(\\frac{\\pi}{2}\\right) \\right)}\\\\ &\\quad +3 \\left(\\frac{\\pi}{2}\\right) \\cos{\\left(\\left(\\frac{\\pi}{2}\\right) \\left(0\\right) \\right)}\\\\ &=\\frac{3 \\pi}{2}\\end{aligned}\n$$\n\nThus one tangent vector is\n\n$$\n\\mathbf t(\\frac{\\pi}{2},0)=\\frac{3 \\pi}{2}\\,\\mathbf i+4\\,\\mathbf j.\n$$\n\nThe gradient is nonzero. The dot product is\n\n$$\n\\begin{aligned}\\nabla f(\\frac{\\pi}{2},0)\\cdot\\mathbf t(\\frac{\\pi}{2},0)&=\\left(-4\\right)\\left(\\frac{3 \\pi}{2}\\right)\\\\ &\\quad-\\left(\\frac{3 \\pi}{2}\\right)\\left(-4\\right)\\\\ &=0.\\end{aligned}\n$$\n\nAny nonzero scalar multiple has the same tangent direction; none of the other listed vectors is perpendicular to this gradient."}]}
