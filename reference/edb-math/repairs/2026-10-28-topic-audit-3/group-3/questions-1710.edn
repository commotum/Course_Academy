i+\\left(0\\right)\\,j+\\left(0\\right)\\,k \\\\ & =\\left(3 t^{3} - 3 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\end{aligned}\n$$\n\nComputing $r^{\\prime}(t),$ we get\n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm d}{\\mathrm dt}\\left(t^{2} - t\\right)\\,i+\\frac{\\mathrm d}{\\mathrm dt}\\left(3 t^{3} - 3 t\\right)\\,j+\\frac{\\mathrm d}{\\mathrm dt}\\left(\\sin{\\left(2 \\pi t \\right)}\\right)\\,k \\\\ & =\\left(2 t - 1\\right)\\,i+\\left(9 t^{2} - 3\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =\\left(\\left(3 t^{3} - 3 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\right)\\cdot\\left(\\left(2 t - 1\\right)\\,i+\\left(9 t^{2} - 3\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\right) \\\\ & =\\left(3 t^{3} - 3 t^{2}\\right)\\cdot\\left(2 t - 1\\right)+\\left(0\\right)\\cdot\\left(9 t^{2} - 3\\right)+\\left(0\\right)\\cdot\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right) \\\\ & =\\left(6 t^{4} - 9 t^{3} + 3 t^{2}\\right)+\\left(0\\right)+\\left(0\\right) \\\\ & =\\left(2 t - 1\\right) \\left(3 t^{3} - 3 t^{2}\\right)\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ=\\oint_C F\\cdot\\mathrm dr & =\\int_{0}^{1}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{1}\\left(\\left(2 t - 1\\right) \\left(3 t^{3} - 3 t^{2}\\right)\\right)\\,\\mathrm dt \\\\ & =\\left[\\frac{6 t^{5}}{5} - \\frac{9 t^{4}}{4} + t^{3}\\right]_{0}^{1} \\\\ & =[\\left(1\\right)+\\left(- \\frac{9}{4}\\right)+\\left(\\frac{6}{5}\\right)]-[\\left(0\\right)+\\left(0\\right)+\\left(0\\right)] \\\\ & =- \\frac{1}{20}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac91a83-8224-5d8e-ba27-2b72dc0e550e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9}{2}" :db/id #edb/ref 17592186554871} {:answer/id #uuid "a2f5d5e8-72bf-5eef-9f66-1115edcbf08b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186554892} {:answer/id #uuid "aeb0051e-3f8b-5982-b846-e7ff7eee0bc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186554895} {:answer/id #uuid "b6bebfde-1b88-5d80-a03c-526c15e8086b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{15}{2}" :db/id #edb/ref 17592186554897} {:answer/id #uuid "d7cd44d3-fba0-5f5a-9f78-907e87a97980" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{3}{4}" :db/id #edb/ref 17592186554906}] :answer-field/correct {:db/id #edb/ref 17592186554906} :answer-field/id #uuid "9141a1c6-310d-56d7-be04-c32575e4f57b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554887}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a2d5b731-3e56-5fb7-954f-29cf21b28b60" :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=\\left(- 5 x + 3 y\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k$ along the closed curve $C$ given by $r(t)=\\left(3 t^{2} - 3 t\\right)\\,i+\\left(5 t^{3} - 5 t\\right)\\,j+\\left(\\sin{\\left(2 \\pi t \\right)}\\right)\\,k$ for $t\\in [0,1).$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ=\\oint_C F\\cdot\\mathrm dr=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm dt.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=3 t^{2} - 3 t,\\quad y=5 t^{3} - 5 t,\\quad z=\\sin{\\left(2 \\pi t \\right)}.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\left(- 5 x + 3 y\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k \\\\ & =\\left(15 t^{3} - 15 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\end{aligned}\n$$\n\nComputing $r^{\\prime}(t),$ we get\n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm d}{\\mathrm dt}\\left(3 t^{2} - 3 t\\right)\\,i+\\frac{\\mathrm d}{\\mathrm dt}\\left(5 t^{3} - 5 t\\right)\\,j+\\frac{\\mathrm d}{\\mathrm dt}\\left(\\sin{\\left(2 \\pi t \\right)}\\right)\\,k \\\\ & =\\left(6 t - 3\\right)\\,i+\\left(15 t^{2} - 5\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =\\left(\\left(15 t^{3} - 15 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\right)\\cdot\\left(\\left(6 t - 3\\right)\\,i+\\left(15 t^{2} - 5\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\right) \\\\ & =\\left(15 t^{3} - 15 t^{2}\\right)\\cdot\\left(6 t - 3\\right)+\\left(0\\right)\\cdot\\left(15 t^{2} - 5\\right)+\\left(0\\right)\\cdot\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right) \\\\ & =\\left(90 t^{4} - 135 t^{3} + 45 t^{2}\\right)+\\left(0\\right)+\\left(0\\right) \\\\ & =\\left(6 t - 3\\right) \\left(15 t^{3} - 15 t^{2}\\right)\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ=\\oint_C F\\cdot\\mathrm dr & =\\int_{0}^{1}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{1}\\left(\\left(6 t - 3\\right) \\left(15 t^{3} - 15 t^{2}\\right)\\right)\\,\\mathrm dt \\\\ & =\\left[18 t^{5} - \\frac{135 t^{4}}{4} + 15 t^{3}\\right]_{0}^{1} \\\\ & =[\\left(15\\right)+\\left(- \\frac{135}{4}\\right)+\\left(18\\right)]-[\\left(0\\right)+\\left(0\\right)+\\left(0\\right)] \\\\ & =- \\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18dd15e6-ceda-574e-ae06-3f078dde4884" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{4}{15}" :db/id #edb/ref 17592186554856} {:answer/id #uuid "2d9fb833-3125-5919-b437-36a3f7f5f96f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{8}{3}" :db/id #edb/ref 17592186554861} {:answer/id #uuid "8b7a795b-920f-50ae-a34a-1268cb9c84e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186554883} {:answer/id #uuid "af7a1424-420b-530b-a8b3-d9679923d02b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186554896} {:answer/id #uuid "d449a91f-5788-54f4-828f-d3441dced376" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{8}{5}" :db/id #edb/ref 17592186554905}] :answer-field/correct {:db/id #edb/ref 17592186554856} :answer-field/id #uuid "16a69a5b-1a25-591c-a7b0-93d8b7f7c7fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554855}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f1bb72e1-4e4c-5956-a260-d2f9af2fd428" :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=\\left(- x + 4 y\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k$ along the closed curve $C$ given by $r(t)=\\left(4 t^{2} - 4 t\\right)\\,i+\\left(t^{3} - t\\right)\\,j+\\left(\\sin{\\left(2 \\pi t \\right)}\\right)\\,k$ for $t\\in [0,1).$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ=\\oint_C F\\cdot\\mathrm dr=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm dt.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=4 t^{2} - 4 t,\\quad y=t^{3} - t,\\quad z=\\sin{\\left(2 \\pi t \\right)}.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\left(- x + 4 y\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k \\\\ & =\\left(4 t^{3} - 4 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\end{aligned}\n$$\n\nComputing $r^{\\prime}(t),$ we get\n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm d}{\\mathrm dt}\\left(4 t^{2} - 4 t\\right)\\,i+\\frac{\\mathrm d}{\\mathrm dt}\\left(t^{3} - t\\right)\\,j+\\frac{\\mathrm d}{\\mathrm dt}\\left(\\sin{\\left(2 \\pi t \\right)}\\right)\\,k \\\\ & =\\left(8 t - 4\\right)\\,i+\\left(3 t^{2} - 1\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =\\left(\\left(4 t^{3} - 4 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\right)\\cdot\\left(\\left(8 t - 4\\right)\\,i+\\left(3 t^{2} - 1\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\right) \\\\ & =\\left(4 t^{3} - 4 t^{2}\\right)\\cdot\\left(8 t - 4\\right)+\\left(0\\right)\\cdot\\left(3 t^{2} - 1\\right)+\\left(0\\right)\\cdot\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right) \\\\ & =\\left(32 t^{4} - 48 t^{3} + 16 t^{2}\\right)+\\left(0\\right)+\\left(0\\right) \\\\ & =\\left(8 t - 4\\right) \\left(4 t^{3} - 4 t^{2}\\right)\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ=\\oint_C F\\cdot\\mathrm dr & =\\int_{0}^{1}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{1}\\left(\\left(8 t - 4\\right) \\left(4 t^{3} - 4 t^{2}\\right)\\right)\\,\\mathrm dt \\\\ & =\\left[\\frac{32 t^{5}}{5} - 12 t^{4} + \\frac{16 t^{3}}{3}\\right]_{0}^{1} \\\\ & =[\\left(\\frac{16}{3}\\right)+\\left(-12\\right)+\\left(\\frac{32}{5}\\right)]-[\\left(0\\right)+\\left(0\\right)+\\left(0\\right)] \\\\ & =- \\frac{4}{15}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0107db86-5f81-5e7a-90b1-ac80539a2cab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186554851} {:answer/id #uuid "563b3666-11ab-5f91-bf53-b00d149971a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186554869} {:answer/id #uuid "7923bbea-5fc9-561d-8f9d-cbea6a7cc519" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186554876} {:answer/id #uuid "7ae5c9e7-b57e-591d-b22b-fd4a0ce7f189" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186554877} {:answer/id #uuid "a7530702-2dc7-5b8f-a27e-09042f5ae35e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186554894}] :answer-field/correct {:db/id #edb/ref 17592186554876} :answer-field/id #uuid "1ec2ef2e-3a51-5ca5-b6b9-538fa415f571" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554858}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f20d86c9-5c94-54b3-af24-d220a2e7aeac" :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=\\left(- 5 x + 6 y\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k$ along the closed curve $C$ given by $r(t)=\\left(6 t^{2} - 6 t\\right)\\,i+\\left(5 t^{3} - 5 t\\right)\\,j+\\left(\\sin{\\left(2 \\pi t \\right)}\\right)\\,k$ for $t\\in [0,1).$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ=\\oint_C F\\cdot\\mathrm dr=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm dt.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=6 t^{2} - 6 t,\\quad y=5 t^{3} - 5 t,\\quad z=\\sin{\\left(2 \\pi t \\right)}.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\left(- 5 x + 6 y\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k \\\\ & =\\left(30 t^{3} - 30 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\end{aligned}\n$$\n\nComputing $r^{\\prime}(t),$ we get\n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm d}{\\mathrm dt}\\left(6 t^{2} - 6 t\\right)\\,i+\\frac{\\mathrm d}{\\mathrm dt}\\left(5 t^{3} - 5 t\\right)\\,j+\\frac{\\mathrm d}{\\mathrm dt}\\left(\\sin{\\left(2 \\pi t \\right)}\\right)\\,k \\\\ & =\\left(12 t - 6\\right)\\,i+\\left(15 t^{2} - 5\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =\\left(\\left(30 t^{3} - 30 t^{2}\\right)\\,i+\\left(0\\right)\\,j+\\left(0\\right)\\,k\\right)\\cdot\\left(\\left(12 t - 6\\right)\\,i+\\left(15 t^{2} - 5\\right)\\,j+\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right)\\,k\\right) \\\\ & =\\left(30 t^{3} - 30 t^{2}\\right)\\cdot\\left(12 t - 6\\right)+\\left(0\\right)\\cdot\\left(15 t^{2} - 5\\right)+\\left(0\\right)\\cdot\\left(2 \\pi \\cos{\\left(2 \\pi t \\right)}\\right) \\\\ & =\\left(360 t^{4} - 540 t^{3} + 180 t^{2}\\right)+\\left(0\\right)+\\left(0\\right) \\\\ & =\\left(12 t - 6\\right) \\left(30 t^{3} - 30 t^{2}\\right)\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ=\\oint_C F\\cdot\\mathrm dr & =\\int_{0}^{1}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{1}\\left(\\left(12 t - 6\\right) \\left(30 t^{3} - 30 t^{2}\\right)\\right)\\,\\mathrm dt \\\\ & =\\left[72 t^{5} - 135 t^{4} + 60 t^{3}\\right]_{0}^{1} \\\\ & =[\\left(60\\right)+\\left(-135\\right)+\\left(72\\right)]-[\\left(0\\right)+\\left(0\\right)+\\left(0\\right)] \\\\ & =-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186556173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81f409ab-b867-5779-bc24-3ae54ab00e2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 u e^{v} + 3 u + 4 u e^{- v} + \\frac{1}{u}" :db/id #edb/ref 17592186556186} {:answer/id #uuid "a5b60f43-91d0-5ad6-955a-29cb1b0af72b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 u^{2} - 2 e^{v} + e^{- v}" :db/id #edb/ref 17592186556194} {:answer/id #uuid "ad700ff7-1d9b-54b2-99aa-1b07525131d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 6 u^{2} - 2 e^{v} - e^{- v}" :db/id #edb/ref 17592186556197} {:answer/id #uuid "b8067b40-76f7-5036-80c8-130af6336736" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 u^{2} + 2 e^{v} - e^{- v}" :db/id #edb/ref 17592186556199} {:answer/id #uuid "f98d6f1e-22d5-5074-822b-b404003b9231" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 u^{2} e^{- v} + 4 u v e^{v} + 2 u e^{v} - 6 u - u e^{- v}" :db/id #edb/ref 17592186556206}] :answer-field/correct {:db/id #edb/ref 17592186556199} :answer-field/id #uuid "9dce9ca4-5617-5673-ad73-789cc80ac4e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186556191}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1039f010-3863-5220-a49a-f66106dbc4e6" :question/problem "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=\\left\\langle 4 x - \\frac{1}{z},\\,4 y + \\frac{2}{z},\\,3 z\\right\\rangle,\\quad r(u,v)=\\left\\langle u e^{v},\\,u e^{- v},\\,u\\right\\rangle,\\quad (u,v)\\in D\\subset\\mathbb R^2.\n$$\n\nAssume $D\\subset\\{(u,v):u>0\\}$, so the vector field is defined on $S$.\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n\\iint_S F\\cdot\\mathrm{d}\\mathbf S=\\iint_D \\boxed{}\\,\\mathrm{d}A\n$$\n\nwhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n\\iint_S F\\cdot\\mathrm{d}\\mathbf S=\\iint_S F\\cdot n\\,\\mathrm{d}S=\\iint_D F(r(u,v))\\cdot (r'_u\\times r'_v)\\,\\mathrm{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}r'_u & =\\left\\langle \\frac{\\partial x}{\\partial u},\\,\\frac{\\partial y}{\\partial u},\\,\\frac{\\partial z}{\\partial u}\\right\\rangle \\\\  & =\\left\\langle \\frac{\\partial}{\\partial u}(u e^{v}),\\,\\frac{\\partial}{\\partial u}(u e^{- v}),\\,\\frac{\\partial}{\\partial u}(u)\\right\\rangle \\\\  & =\\left\\langle e^{v},\\,e^{- v},\\,1\\right\\rangle \\\\ r'_v & =\\left\\langle \\frac{\\partial x}{\\partial v},\\,\\frac{\\partial y}{\\partial v},\\,\\frac{\\partial z}{\\partial v}\\right\\rangle \\\\  & =\\left\\langle \\frac{\\partial}{\\partial v}(u e^{v}),\\,\\frac{\\partial}{\\partial v}(u e^{- v}),\\,\\frac{\\partial}{\\partial v}(u)\\right\\rangle \\\\  & =\\left\\langle u e^{v},\\,- u e^{- v},\\,0\\right\\rangle\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}r'_u\\times r'_v & =\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\e^{v}&e^{- v}&1\\\\u e^{v}&- u e^{- v}&0\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}e^{- v}&1\\\\- u e^{- v}&0\\end{vmatrix},-\\begin{vmatrix}e^{v}&1\\\\u e^{v}&0\\end{vmatrix},\\begin{vmatrix}e^{v}&e^{- v}\\\\u e^{v}&- u e^{- v}\\end{vmatrix}\\right\\rangle \\\\  & =\\left\\langle u e^{- v},\\,u e^{v},\\,- 2 u\\right\\rangle.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =\\left\\langle 4 x - \\frac{1}{z},\\,4 y + \\frac{2}{z},\\,3 z\\right\\rangle\\big|_{x=u e^{v},\\,y=u e^{- v},\\,z=u} \\\\  & =\\left\\langle 4 \\left(u e^{v}\\right) - \\frac{1}{\\left(u\\right)},\\,4 \\left(u e^{- v}\\right) + \\frac{2}{\\left(u\\right)},\\,3 \\left(u\\right)\\right\\rangle \\\\  & =\\left\\langle 4 u e^{v} - \\frac{1}{u},\\,4 u e^{- v} + \\frac{2}{u},\\,3 u\\right\\rangle\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot (r'_u\\times r'_v) & =\\left\\langle 4 u e^{v} - \\frac{1}{u},\\,4 u e^{- v} + \\frac{2}{u},\\,3 u\\right\\rangle\\cdot \\left\\langle u e^{- v},\\,u e^{v},\\,- 2 u\\right\\rangle \\\\  & =\\left(4 u e^{v} - \\frac{1}{u}\\right)\\cdot\\left(u e^{- v}\\right)+\\left(4 u e^{- v} + \\frac{2}{u}\\right)\\cdot\\left(u e^{v}\\right)+\\left(3 u\\right)\\cdot\\left(- 2 u\\right) \\\\  & =\\left(4 u^{2} - e^{- v}\\right)+\\left(4 u^{2} + 2 e^{v}\\right)+\\left(- 6 u^{2}\\right) \\\\  & =2 u^{2} + 2 e^{v} - e^{- v}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}\\iint_S F\\cdot\\mathrm{d}\\mathbf S & =\\iint_D F(r(u,v))\\cdot(r'_u\\times r'_v)\\,\\mathrm{d}A \\\\  & =\\iint_D 2 u^{2} + 2 e^{v} - e^{- v}\\,\\mathrm{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186556184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3115ca9e-35fc-5598-b2a4-4a9b99166161" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u e^{v} + u + 3 u e^{- v} + \\frac{1}{u}" :db/id #edb/ref 17592186556177} {:answer/id #uuid "361c146c-4835-5ada-a6f0-3bf04facfd7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 u^{2} - 4 e^{v} - 3 e^{- v}" :db/id #edb/ref 17592186556178} {:answer/id #uuid "4c3e74c8-f490-5b2e-b30e-16bd96e7bfc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 u^{2} - 4 e^{v} + 3 e^{- v}" :db/id #edb/ref 17592186556179} {:answer/id #uuid "86e6f5d6-a8de-5c9c-bc47-256b0491327e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u^{2} e^{- v} + 3 u v e^{v} + 4 u e^{v} - 2 u - 3 u e^{- v}" :db/id #edb/ref 17592186556189} {:answer/id #uuid "c5866d34-6781-54c7-b8f0-02aa86b688be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 u^{2} + 4 e^{v} - 3 e^{- v}" :db/id #edb/ref 17592186556200}] :answer-field/correct {:db/id #edb/ref 17592186556200} :answer-field/id #uuid "ddbef7c9-4e2c-56a5-9a9d-0f5c6282dcad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186556201}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7935e083-94be-533d-a1d7-bf299ffdd905" :question/problem "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=\\left\\langle x - \\frac{3}{z},\\,3 y + \\frac{4}{z},\\,z\\right\\rangle,\\quad r(u,v)=\\left\\langle u e^{v},\\,u e^{- v},\\,u\\right\\rangle,\\quad (u,v)\\in D\\subset\\mathbb R^2.\n$$\n\nAssume $D\\subset\\{(u,v):u>0\\}$, so the vector field is defined on $S$.\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n\\iint_S F\\cdot\\mathrm{d}\\mathbf S=\\iint_D \\boxed{}\\,\\mathrm{d}A\n$$\n\nwhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n\\iint_S F\\cdot\\mathrm{d}\\mathbf S=\\iint_S F\\cdot n\\,\\mathrm{d}S=\\iint_D F(r(u,v))\\cdot (r'_u\\times r'_v)\\,\\mathrm{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}r'_u & =\\left\\langle \\frac{\\partial x}{\\partial u},\\,\\frac{\\partial y}{\\partial u},\\,\\frac{\\partial z}{\\partial u}\\right\\rangle \\\\  & =\\left\\langle \\frac{\\partial}{\\partial u}(u e^{v}),\\,\\frac{\\partial}{\\partial u}(u e^{- v}),\\,\\frac{\\partial}{\\partial u}(u)\\right\\rangle \\\\  & =\\left\\langle e^{v},\\,e^{- v},\\,1\\right\\rangle \\\\ r'_v & =\\left\\langle \\frac{\\partial x}{\\partial v},\\,\\frac{\\partial y}{\\partial v},\\,\\frac{\\partial z}{\\partial v}\\right\\rangle \\\\  & =\\left\\langle \\frac{\\partial}{\\partial v}(u e^{v}),\\,\\frac{\\partial}{\\partial v}(u e^{- v}),\\,\\frac{\\partial}{\\partial v}(u)\\right\\rangle \\\\  & =\\left\\langle u e^{v},\\,- u e^{- v},\\,0\\right\\rangle\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}r'_u\\times r'_v & =\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\e^{v}&e^{- v}&1\\\\u e^{v}&- u e^{- v}&0\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}e^{- v}&1\\\\- u e^{- v}&0\\end{vmatrix},-\\begin{vmatrix}e^{v}&1\\\\u e^{v}&0\\end{vmatrix},\\begin{vmatrix}e^{v}&e^{- v}\\\\u e^{v}&- u e^{- v}\\end{vmatrix}\\right\\rangle \\\\  & =\\left\\langle u e^{- v},\\,u e^{v},\\,- 2 u\\right\\rangle.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =\\left\\langle x - \\frac{3}{z},\\,3 y + \\frac{4}{z},\\,z\\right\\rangle\\big|_{x=u e^{v},\\,y=u e^{- v},\\,z=u} \\\\  & =\\left\\langle \\left(u e^{v}\\right) - \\frac{3}{\\left(u\\right)},\\,3 \\left(u e^{- v}\\right) + \\frac{4}{\\left(u\\right)},\\,\\left(u\\right)\\right\\rangle \\\\  & =\\left\\langle u e^{v} - \\frac{3}{u},\\,3 u e^{- v} + \\frac{4}{u},\\,u\\right\\rangle\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot (r'_u\\times r'_v) & =\\left\\langle u e^{v} - \\frac{3}{u},\\,3 u e^{- v} + \\frac{4}{u},\\,u\\right\\rangle\\cdot \\left\\langle u e^{- v},\\,u e^{v},\\,- 2 u\\right\\rangle \\\\  & =\\left(u e^{v} - \\frac{3}{u}\\right)\\cdot\\left(u e^{- v}\\right)+\\left(3 u e^{- v} + \\frac{4}{u}\\right)\\cdot\\left(u e^{v}\\right)+\\left(u\\right)\\cdot\\left(- 2 u\\right) \\\\  & =\\left(u^{2} - 3 e^{- v}\\right)+\\left(3 u^{2} + 4 e^{v}\\right)+\\left(- 2 u^{2}\\right) \\\\  & =2 u^{2} + 4 e^{v} - 3 e^{- v}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}\\iint_S F\\cdot\\mathrm{d}\\mathbf S & =\\iint_D F(r(u,v))\\cdot(r'_u\\times r'_v)\\,\\mathrm{d}A \\\\  & =\\iint_D 2 u^{2} + 4 e^{v} - 3 e^{- v}\\,\\mathrm{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186556187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b303eaa-4c9a-51ab-9670-8dd51e38698e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30 u^{3} \\sin^{2}{\\left(v \\right)} - 15 u^{3}" :db/id #edb/ref 17592186556174} {:answer/id #uuid "4cc355ae-178d-5355-b6c5-d29d66022fb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 u^{3} \\sin^{2}{\\left(v \\right)} - 15 u^{3}" :db/id #edb/ref 17592186556180} {:answer/id #uuid "8141b305-5485-5f6c-8f15-6dc7edf9aa3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 18 u^{3} \\cos{\\left(v \\right)} - 12 u^{2} v \\sin{\\left(v \\right)} + u" :db/id #edb/ref 17592186556185} {:answer/id #uuid "a77f1062-0c86-5a45-b222-eda6a74dda05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 u^{2} + 2 u \\sin{\\left(v \\right)} + 3 u \\cos{\\left(v \\right)}" :db/id #edb/ref 17592186556195} {:answer/id #uuid "e1d3f567-fd7a-59d3-912c-6d37e7b32a91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 6 u^{3} \\sin^{2}{\\left(v \\right)} + 15 u^{3}" :db/id #edb/ref 17592186556202}] :answer-field/correct {:db/id #edb/ref 17592186556180} :answer-field/id #uuid "270a3f4d-7871-5456-be53-ac2121da8507" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186556176}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "849d702e-e365-572d-ab5f-c0ce0dd77382" :question/problem "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=\\left\\langle 3 x,\\,2 y,\\,z\\right\\rangle,\\quad r(u,v)=\\left\\langle u \\cos{\\left(v \\right)},\\,u \\sin{\\left(v \\right)},\\,3 u^{2}\\right\\rangle,\\quad (u,v)\\in D\\subset\\mathbb R^2.\n$$\n\nAssume $D\\subset\\{(u,v):u>0,\\ 0<v<2\\pi\\}$.\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n\\iint_S F\\cdot\\mathrm{d}\\mathbf S=\\iint_D \\boxed{}\\,\\mathrm{d}A\n$$\n\nwhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n\\iint_S F\\cdot\\mathrm{d}\\mathbf S=\\iint_S F\\cdot n\\,\\mathrm{d}S=\\iint_D F(r(u,v))\\cdot (r'_u\\times r'_v)\\,\\mathrm{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}r'_u & =\\left\\langle \\frac{\\partial x}{\\partial u},\\,\\frac{\\partial y}{\\partial u},\\,\\frac{\\partial z}{\\partial u}\\right\\rangle \\\\  & =\\left\\langle \\frac{\\partial}{\\partial u}(u \\cos{\\left(v \\right)}),\\,\\frac{\\partial}{\\partial u}(u \\sin{\\left(v \\right)}),\\,\\frac{\\partial}{\\partial u}(3 u^{2})\\right\\rangle \\\\  & =\\left\\langle \\cos{\\left(v \\right)},\\,\\sin{\\left(v \\right)},\\,6 u\\right\\rangle \\\\ r'_v & =\\left\\langle \\frac{\\partial x}{\\partial v},\\,\\frac{\\partial y}{\\partial v},\\,\\frac{\\partial z}{\\partial v}\\right\\rangle \\\\  & =\\left\\langle \\frac{\\partial}{\\partial v}(u \\cos{\\left(v \\right)}),\\,\\frac{\\partial}{\\partial v}(u \\sin{\\left(v \\right)}),\\,\\frac{\\partial}{\\partial v}(3 u^{2})\\right\\rangle \\\\  & =\\left\\langle - u \\sin{\\left(v \\right)},\\,u \\cos{\\left(v \\right)},\\,0\\right\\rangle\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}r'_u\\times r'_v & =\\begin{vmatrix}\\mathbf i&\\mathbf j&\\mathbf k\\\\\\cos{\\left(v \\right)}&\\sin{\\left(v \\right)}&6 u\\\\- u \\sin{\\left(v \\right)}&u \\cos{\\left(v \\right)}&0\\end{vmatrix} \\\\  & =\\left\\langle \\begin{vmatrix}\\sin{\\left(v \\right)}&6 u\\\\u \\cos{\\left(v \\right)}&0\\end{vmatrix},-\\begin{vmatrix}\\cos{\\left(v \\right)}&6 u\\\\- u \\sin{\\left(v \\right)}&0\\end{vmatrix},\\begin{vmatrix}\\cos{\\left(v \\right)}&\\sin{\\left(v \\right)}\\\\- u \\sin{\\left(v \\right)}&u \\cos{\\left(v \\right)}\\end{vmatrix}\\right\\rangle \\\\  & =\\left\\langle - 6 u^{2} \\cos{\\left(v \\right)},\\,- 6 u^{2} \\sin{\\left(v \\right)},\\,u\\right\\rangle.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =\\left\\langle 3 x,\\,2 y,\\,z\\right\\rangle\\big|_{x=u \\cos{\\left(v \\right)},\\,y=u \\sin{\\left(v \\right)},\\,z=3 u^{2}} \\\\  & =\\left\\langle 3 \\left(u \\cos{\\left(v \\right)}\\right),\\,2 \\left(u \\sin{\\left(v \\right)}\\right),\\,\\left(3 u^{2}\\right)\\right\\rangle \\\\  & =\\left\\langle 3 u \\cos{\\left(v \\right)},\\,2 u \\sin{\\left(v \\right)},\\,3 u^{2}\\right\\rangle\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot (r'_u\\times r'_v) & =\\left\\langle 3 u \\cos{\\left(v \\right)},\\,2 u \\sin{\\left(v \\right)},\\,3 u^{2}\\right\\rangle\\cdot \\left\\langle - 6 u^{2} \\cos{\\left(v \\right)},\\,- 6 u^{2} \\sin{\\left(v \\right)},\\,u\\right\\rangle \\\\  & =\\left(3 u \\cos{\\left(v \\right)}\\right)\\cdot\\left(- 6 u^{2} \\cos{\\left(v \\right)}\\right)+\\left(2 u \\sin{\\left(v \\right)}\\right)\\cdot\\left(- 6 u^{2} \\sin{\\left(v \\right)}\\right)+\\left(3 u^{2}\\right)\\cdot\\left(u\\right) \\\\  & =\\left(18 u^{3} \\sin^{2}{\\left(v \\right)} - 18 u^{3}\\right)+\\left(- 12 u^{3} \\sin^{2}{\\left(v \\right)}\\right)+\\left(3 u^{3}\\right) \\\\  & =6 u^{3} \\sin^{2}{\\left(v \\right)} - 15 u^{3}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}\\iint_S F\\cdot\\mathrm{d}\\mathbf S & =\\iint_D F(r(u,v))\\cdot(r'_u\\times r'_v)\\,\\mathrm{d}A \\\\  & =\\iint_D 6 u^{3} \\sin^{2}{\\left(v \\right)} - 15 u^{3}\\,\\mathrm{d}A.\\end{aligned}\n$$"}]}
