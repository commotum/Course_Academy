1}{2}) & =(6 \\left(- \\frac{1}{2}\\right) + 6 \\left(\\frac{1}{2}\\right)^{2})\\,i+(12 \\left(- \\frac{1}{2}\\right) \\left(\\frac{1}{2}\\right) + 12 \\left(\\frac{1}{2}\\right))\\,j \\\\  & =\\left(- \\frac{3}{2}\\right)\\,i+(3)\\,j \\\\  & =⟨- \\frac{3}{2},3⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(- \\frac{1}{2},\\frac{1}{2})\\cdot ⟨x-\\left(- \\frac{1}{2}\\right),\\,y-\\left(\\frac{1}{2}\\right)⟩ & =0 \\\\ ⟨- \\frac{3}{2},3⟩\\cdot ⟨x + \\frac{1}{2},\\,y - \\frac{1}{2}⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c85a57c-ae25-594f-b859-8c42b147ef3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨24,48⟩\\cdot ⟨x + 3,\\,y - 1⟩=0" :db/id #edb/ref 17592186521694} {:answer/id #uuid "546d86d2-b987-5441-a035-ea8120764307" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-24,48⟩\\cdot ⟨x - 3,\\,y - 1⟩=0" :db/id #edb/ref 17592186521696} {:answer/id #uuid "b8fb0684-fb28-5200-a831-4b05217f342b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨48,24⟩\\cdot ⟨x - 3,\\,y - 1⟩=0" :db/id #edb/ref 17592186521727} {:answer/id #uuid "c10f4dde-488a-504a-bfdc-c96a15f3c756" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨24,48⟩\\cdot ⟨x - 3,\\,y + 1⟩=0" :db/id #edb/ref 17592186521730} {:answer/id #uuid "e2d57443-0818-520e-bcad-92c34a4c3c68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨24,48⟩\\cdot ⟨x - 3,\\,y - 1⟩=0" :db/id #edb/ref 17592186521739}] :answer-field/correct {:db/id #edb/ref 17592186521739} :answer-field/id #uuid "aee44b19-384e-57f3-9c07-a81959031578" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521724}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ded82588-cfbc-50f4-bfae-36c240c5cd0b" :question/problem "Given the function $f(x,y)=3 x^{2} + 6 x y^{2} + 6 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(3,1).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(3,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(3 x^{2} + 6 x y^{2} + 6 y^{2})\\,i+\\frac{∂}{∂y}(3 x^{2} + 6 x y^{2} + 6 y^{2})\\,j \\\\  & =(6 x + 6 y^{2})\\,i+(12 x y + 12 y)\\,j \\\\ ∇f(3,1) & =(6 (3) + 6 (1)^{2})\\,i+(12 (3) (1) + 12 (1))\\,j \\\\  & =(24)\\,i+(48)\\,j \\\\  & =⟨24,48⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(3,1)\\cdot ⟨x-(3),\\,y-(1)⟩ & =0 \\\\ ⟨24,48⟩\\cdot ⟨x - 3,\\,y - 1⟩ & =0.\\end{aligned}\n$$"}]}
