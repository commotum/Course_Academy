partial(x,y)}{\\partial(u,v)}\\right|_{(-2,1)} & =\\left(- 36 \\left(u + v\\right)^{2} \\left(2 u - v\\right)\\right)\\big|_{u=-2,v=1}\\\\& =- 36 \\left((-2) + (1)\\right)^{2} \\left(2 (-2) - (1)\\right)\\\\& =180\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & \\approx|180|\\cdot\\delta A\\\\ & =180\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e43eb16-fd50-58a8-a646-55a7b162847a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "360\\,\\delta A" :db/id #edb/ref 17592186518927} {:answer/id #uuid "5078973b-c6bc-557e-bd48-736bc3b4c202" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{180}\\,\\delta A" :db/id #edb/ref 17592186518928} {:answer/id #uuid "5ea468ed-e1fe-5ba2-9fa5-fefe32cc95ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32400\\,\\delta A" :db/id #edb/ref 17592186518934} {:answer/id #uuid "69db795c-5742-5b39-9574-c13288983347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "180\\,\\delta A" :db/id #edb/ref 17592186518938} {:answer/id #uuid "93bb489d-c9e5-5d96-b8d7-5033a9c1010a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90\\,\\delta A" :db/id #edb/ref 17592186518947}] :answer-field/correct {:db/id #edb/ref 17592186518938} :answer-field/id #uuid "f0f839a4-8628-5b5f-ac1d-b0991c234235" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518971}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a969598c-ea80-5e43-ada9-6b7308b83589" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-2,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\longrightarrow\\begin{bmatrix}2 \\left(2 u + v\\right)^{2}\\\\\\left(u - v\\right)^{3}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))\\approx\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\cdot\\underbrace{\\text{Area}(Δ)}_{\\delta A}\n$$\n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)} & =\\begin{vmatrix}\\frac{\\partial x}{\\partial u}&\\frac{\\partial x}{\\partial v}\\\\\\frac{\\partial y}{\\partial u}&\\frac{\\partial y}{\\partial v}\\end{vmatrix}\\\\& =\\begin{vmatrix}8 \\left(2 u + v\\right)&4 \\left(2 u + v\\right)\\\\3 \\left(u - v\\right)^{2}&- 3 \\left(u - v\\right)^{2}\\end{vmatrix}\\\\& =(8 \\left(2 u + v\\right))\\cdot (- 3 \\left(u - v\\right)^{2})-(4 \\left(2 u + v\\right))\\cdot (3 \\left(u - v\\right)^{2})\\\\& =- 72 u^{3} + 108 u^{2} v - 36 v^{3}\\\\& =- 36 \\left(u - v\\right)^{2} \\left(2 u + v\\right)\\\\\\left.\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|_{(-2,-1)} & =\\left(- 36 \\left(u - v\\right)^{2} \\left(2 u + v\\right)\\right)\\big|_{u=-2,v=-1}\\\\& =- 36 \\left(- (-1) + (-2)\\right)^{2} \\left((-1) + 2 (-2)\\right)\\\\& =180\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & \\approx|180|\\cdot\\delta A\\\\ & =180\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15dbf132-3e31-59b6-b187-892685acc97d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "88\\,\\delta A" :db/id #edb/ref 17592186518909} {:answer/id #uuid "697e6aef-9964-5053-b382-5c88b21c2920" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "44\\,\\delta A" :db/id #edb/ref 17592186518937} {:answer/id #uuid "83524c04-5468-53fa-bd7d-bb4999cc9585" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1936\\,\\delta A" :db/id #edb/ref 17592186518945} {:answer/id #uuid "a6d2a6d9-d644-5d45-8bdf-1c1fb6df4980" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22\\,\\delta A" :db/id #edb/ref 17592186518953} {:answer/id #uuid "f639046b-b2fc-5455-96d0-1286ffd8950a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{44}\\,\\delta A" :db/id #edb/ref 17592186518974}] :answer-field/correct {:db/id #edb/ref 17592186518937} :answer-field/id #uuid "535e0d1f-0eed-5a50-9f3c-40a846b5562f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518929}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "adc92b5f-6402-53d1-8666-3baacdfe2c66" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-2,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\longrightarrow\\begin{bmatrix}2 u v^{3}\\\\u^{2} + v^{2}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))\\approx\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\cdot\\underbrace{\\text{Area}(Δ)}_{\\delta A}\n$$\n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)} & =\\begin{vmatrix}\\frac{\\partial x}{\\partial u}&\\frac{\\partial x}{\\partial v}\\\\\\frac{\\partial y}{\\partial u}&\\frac{\\partial y}{\\partial v}\\end{vmatrix}\\\\& =\\begin{vmatrix}2 v^{3}&6 u v^{2}\\\\2 u&2 v\\end{vmatrix}\\\\& =(2 v^{3})\\cdot (2 v)-(6 u v^{2})\\cdot (2 u)\\\\& =- 12 u^{2} v^{2} + 4 v^{4}\\\\& =- 4 v^{2} \\left(3 u^{2} - v^{2}\\right)\\\\\\left.\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|_{(-2,-1)} & =\\left(- 4 v^{2} \\left(3 u^{2} - v^{2}\\right)\\right)\\big|_{u=-2,v=-1}\\\\& =- 4 (-1)^{2} \\left(- (-1)^{2} + 3 (-2)^{2}\\right)\\\\& =-44\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & \\approx|-44|\\cdot\\delta A\\\\ & =44\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22ec1407-5d3e-572e-b894-a96fde5d8e98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75\\,\\delta A" :db/id #edb/ref 17592186518912} {:answer/id #uuid "33d42482-34ef-59e1-9d7b-c0a1dcf6db23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "300\\,\\delta A" :db/id #edb/ref 17592186518916} {:answer/id #uuid "39480101-3dbb-5f98-9d35-a02e91aadd76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "150\\,\\delta A" :db/id #edb/ref 17592186518917} {:answer/id #uuid "3e0670ce-c1db-5e79-a6f4-2e53c985344b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{150}\\,\\delta A" :db/id #edb/ref 17592186518919} {:answer/id #uuid "3ffa3aa9-000d-52d4-8910-4d539df8e087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22500\\,\\delta A" :db/id #edb/ref 17592186518921}] :answer-field/correct {:db/id #edb/ref 17592186518917} :answer-field/id #uuid "ae334581-cc02-5854-80ac-65ba5fd211c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518956}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b11a00bf-ad16-5270-bbbf-f403e6fe76c2" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(3,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\longrightarrow\\begin{bmatrix}3 u v^{3}\\\\u^{2} + 2 v^{2}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))\\approx\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\cdot\\underbrace{\\text{Area}(Δ)}_{\\delta A}\n$$\n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)} & =\\begin{vmatrix}\\frac{\\partial x}{\\partial u}&\\frac{\\partial x}{\\partial v}\\\\\\frac{\\partial y}{\\partial u}&\\frac{\\partial y}{\\partial v}\\end{vmatrix}\\\\& =\\begin{vmatrix}3 v^{3}&9 u v^{2}\\\\2 u&4 v\\end{vmatrix}\\\\& =(3 v^{3})\\cdot (4 v)-(9 u v^{2})\\cdot (2 u)\\\\& =- 18 u^{2} v^{2} + 12 v^{4}\\\\& =- 6 v^{2} \\left(3 u^{2} - 2 v^{2}\\right)\\\\\\left.\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|_{(3,1)} & =\\left(- 6 v^{2} \\left(3 u^{2} - 2 v^{2}\\right)\\right)\\big|_{u=3,v=1}\\\\& =- 6 (1)^{2} \\left(- 2 (1)^{2} + 3 (3)^{2}\\right)\\\\& =-150\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & \\approx|-150|\\cdot\\delta A\\\\ & =150\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a46dd2e-7844-511c-8225-1d0a51bb3eaf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72\\,\\delta A" :db/id #edb/ref 17592186518918} {:answer/id #uuid "421250cd-a2d2-59cf-a6de-47aaded334b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20736\\,\\delta A" :db/id #edb/ref 17592186518922} {:answer/id #uuid "549b51aa-02b7-56c9-a3ea-cc9c797d0dfd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{144}\\,\\delta A" :db/id #edb/ref 17592186518931} {:answer/id #uuid "5c59fc35-b29f-5893-8340-a07c39c6bbb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "144\\,\\delta A" :db/id #edb/ref 17592186518933} {:answer/id #uuid "ec16d3f2-9da5-5e85-813f-086fbb3e74c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "288\\,\\delta A" :db/id #edb/ref 17592186518970}] :answer-field/correct {:db/id #edb/ref 17592186518933} :answer-field/id #uuid "e48954b8-5146-577a-919f-6d9a5e7fbd72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518967}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dcaa4bdd-7f4f-5106-9de8-2ca23f1745cd" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,-1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\longrightarrow\\begin{bmatrix}2 \\left(2 u + v\\right)^{2}\\\\\\left(u - v\\right)^{3}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))\\approx\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\cdot\\underbrace{\\text{Area}(Δ)}_{\\delta A}\n$$\n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)} & =\\begin{vmatrix}\\frac{\\partial x}{\\partial u}&\\frac{\\partial x}{\\partial v}\\\\\\frac{\\partial y}{\\partial u}&\\frac{\\partial y}{\\partial v}\\end{vmatrix}\\\\& =\\begin{vmatrix}8 \\left(2 u + v\\right)&4 \\left(2 u + v\\right)\\\\3 \\left(u - v\\right)^{2}&- 3 \\left(u - v\\right)^{2}\\end{vmatrix}\\\\& =(8 \\left(2 u + v\\right))\\cdot (- 3 \\left(u - v\\right)^{2})-(4 \\left(2 u + v\\right))\\cdot (3 \\left(u - v\\right)^{2})\\\\& =- 72 u^{3} + 108 u^{2} v - 36 v^{3}\\\\& =- 36 \\left(u - v\\right)^{2} \\left(2 u + v\\right)\\\\\\left.\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|_{(1,-1)} & =\\left(- 36 \\left(u - v\\right)^{2} \\left(2 u + v\\right)\\right)\\big|_{u=1,v=-1}\\\\& =- 36 \\left(- (-1) + (1)\\right)^{2} \\left((-1) + 2 (1)\\right)\\\\& =-144\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & \\approx|-144|\\cdot\\delta A\\\\ & =144\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ad4d22b-acab-5ed4-80d7-49438eaa6ff2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186519948} {:answer/id #uuid "a5a9fe0e-461d-5c50-9b13-e2d874c7c501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17 \\sqrt{17}}{3}" :db/id #edb/ref 17592186519960} {:answer/id #uuid "ae7b8d36-7fec-572a-aff6-b1b470283083" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{2}}{3} + \\frac{17 \\sqrt{17}}{3}" :db/id #edb/ref 17592186519963} {:answer/id #uuid "dede3d58-8509-5b02-a30e-5c2edec92aba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{285}{4}" :db/id #edb/ref 17592186519972} {:answer/id #uuid "e96d81fd-09d1-5c57-816e-ef56ea09fc90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{2 \\sqrt{2}}{3} + \\frac{17 \\sqrt{17}}{3}" :db/id #edb/ref 17592186519976}] :answer-field/correct {:db/id #edb/ref 17592186519976} :answer-field/id #uuid "42a780e2-ad8c-5ca4-b690-f0fe637d9239" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519924}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "316743f9-ae6e-5a5c-90d0-c46ad39f440f" :question/problem "![](images/c3/c3f6e03956e6002db05950b10d9608be87dd45a4bb75b3822e1ab754981eb19d.png)\n\nEvaluate the line integral\n$$\n\\displaystyle {\\int }_{C}2 x y^{6}\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=\\frac{1}{y}$ from $(1,1)$ to $(\\frac{1}{2},2),$ as shown above." :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=\\frac{1}{t}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨\\frac{1}{t},\\,t⟩,\\,1\\le t\\le 2\n$$\n\nNote that the domain $1\\le t\\le 2$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =- \\frac{1}{t^{2}}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{\\left(- \\frac{1}{t^{2}}\\right)^2+1^2} \\\\  & =\\sqrt{\\frac{1}{t^{4}}+1} \\\\  & =\\sqrt{1 + \\frac{1}{t^{4}}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=2 x y^{6},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =2 \\left(\\frac{1}{t}\\right) t^{6} \\\\  & =2 t^{5}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}2 x y^{6}\\,\\text{d}s & ={\\int }_{1}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}\\left(2 t^{5}\\right)\\cdot\\left(\\sqrt{1 + \\frac{1}{t^{4}}}\\right)\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}2 t^{3} \\sqrt{t^{4} + 1}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=t^{4} + 1,$ $\\text{d}u=4 t^{3}\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}2 t^{3} \\sqrt{t^{4} + 1}\\,\\text{d}t & =2{\\int }_{2}^{17}\\sqrt{u}\\cdot\\left(\\frac{1}{4}\\right)\\,\\text{d}u \\\\  & ={\\int }_{2}^{17}\\frac{\\sqrt{u}}{2}\\,\\text{d}u \\\\  & =\\left[\\frac{1}{2}\\cdot\\frac{2}{3}u^{3/2}\\right]_{2}^{17} \\\\  & =\\left[\\frac{u^{\\frac{3}{2}}}{3}\\right]_{2}^{17} \\\\  & =\\left(\\left(\\frac{\\left(17\\right)^{\\frac{3}{2}}}{3}\\right)\\right)-\\left(\\left(\\frac{\\left(2\\right)^{\\frac{3}{2}}}{3}\\right)\\right) \\\\  & =\\left(\\left(\\frac{17 \\sqrt{17}}{3}\\right)\\right)-\\left(\\left(\\frac{2 \\sqrt{2}}{3}\\right)\\right) \\\\  & =- \\frac{2 \\sqrt{2}}{3} + \\frac{17 \\sqrt{17}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "502b4fef-e465-5b61-8882-5e374dab527e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186519931} {:answer/id #uuid "5aa47a8c-d91a-57c1-a9f1-0922f42018fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186519934} {:answer/id #uuid "68c61336-093f-55bd-aa10-7226bb03c3a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{10 \\sqrt{5}}{3} + 4 \\sqrt{6}" :db/id #edb/ref 17592186519941} {:answer/id #uuid "9ff5fdaa-596f-587d-a87a-1b719d485ce6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10 \\sqrt{5}}{3} + 4 \\sqrt{6}" :db/id #edb/ref 17592186519956} {:answer/id #uuid "d906e193-9c9a-5192-b2b6-679b2f764aaf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\sqrt{6}" :db/id #edb/ref 17592186519971}] :answer-field/correct {:db/id #edb/ref 17592186519941} :answer-field/id #uuid "ee9402cd-0a21-588e-9736-a8a0d09641c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519978}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5487c7b6-44fe-5e39-9226-bf0a43081f99" :question/problem "Evaluate the line integral\n$$\n\\displaystyle {\\int }_{C}2 x^{6} e^{- 2 y}\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=e^{\\frac{y}{2}}$ from $(1,0)$ to $(\\sqrt{2},\\ln{\\left(2 \\right)}).$" :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=e^{\\frac{t}{2}}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨e^{\\frac{t}{2}},\\,t⟩,\\,0\\le t\\le \\ln{\\left(2 \\right)}\n$$\n\nNote that the domain $0\\le t\\le \\ln{\\left(2 \\right)}$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(e^{\\frac{t}{2}})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{e^{\\frac{t}{2}}}{2}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{\\left(\\frac{e^{\\frac{t}{2}}}{2}\\right)^2+1^2} \\\\  & =\\sqrt{\\frac{e^{t}}{4}+1} \\\\  & =\\sqrt{\\frac{e^{t}}{4} + 1}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=2 x^{6} e^{- 2 y},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =2 \\left(e^{\\frac{t}{2}}\\right)^{6} e^{- 2 t} \\\\  & =2 e^{t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}2 x^{6} e^{- 2 y}\\,\\text{d}s & ={\\int }_{0}^{\\ln{\\left(2 \\right)}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\ln{\\left(2 \\right)}}\\left(2 e^{t}\\right)\\cdot\\left(\\sqrt{\\frac{e^{t}}{4} + 1}\\right)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\ln{\\left(2 \\right)}}\\sqrt{e^{t} + 4} e^{t}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=e^{t} + 4,$ $\\text{d}u=e^{t}\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\ln{\\left(2 \\right)}}\\sqrt{e^{t} + 4} e^{t}\\,\\text{d}t & =1{\\int }_{5}^{6}\\sqrt{u}\\cdot\\left(1\\right)\\,\\text{d}u \\\\  & ={\\int }_{5}^{6}\\sqrt{u}\\,\\text{d}u \\\\  & =\\left[1\\cdot\\frac{2}{3}u^{3/2}\\right]_{5}^{6} \\\\  & =\\left[\\frac{2 u^{\\frac{3}{2}}}{3}\\right]_{5}^{6} \\\\  & =\\left(\\left(\\frac{2 \\left(6\\right)^{\\frac{3}{2}}}{3}\\right)\\right)-\\left(\\left(\\frac{2 \\left(5\\right)^{\\frac{3}{2}}}{3}\\right)\\right) \\\\  & =\\left(\\left(4 \\sqrt{6}\\right)\\right)-\\left(\\left(\\frac{10 \\sqrt{5}}{3}\\right)\\right) \\\\  & =- \\frac{10 \\sqrt{5}}{3} + 4 \\sqrt{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1462cb59-c704-506e-a83c-16cf44ae2975" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186519917} {:answer/id #uuid "4b4517a3-aa53-5919-9bed-4810f2d2c48a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186519927} {:answer/id #uuid "4c732881-a009-564d-95a7-a2eeeff3e247" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{125}{9}" :db/id #edb/ref 17592186519928} {:answer/id #uuid "4f7575b3-0dca-5cc3-83db-5f2b03ab84a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{123}{4}" :db/id #edb/ref 17592186519930} {:answer/id #uuid "528322e2-0164-531d-815c-501f2c5a4e7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{61}{9}" :db/id #edb/ref 17592186519932}] :answer-field/correct {:db/id #edb/ref 17592186519932} :answer-field/id #uuid "4e62414b-49f9-5db8-a201-3192213542b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519929}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5b75b6c1-d336-52ca-ae2f-f314c60fb3a9" :question/problem "Evaluate the line integral\n$$\n\\displaystyle {\\int }_{C}\\frac{6 x}{y}\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $y^2=6x$ from $(\\frac{7}{6},\\sqrt{7})$ to $(\\frac{8}{3},4).$" :question/worked-solution "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\ny^2=6x\\,⟹\\,x=\\frac{y^{2}}{6}.\n$$\n\nTherefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=\\frac{t^{2}}{6}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨\\frac{t^{2}}{6},\\,t⟩,\\,\\sqrt{7}\\le t\\le 4\n$$\n\nNote that the domain $\\sqrt{7}\\le t\\le 4$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{t^{2}}{6}\\right)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{t}{3}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{\\left(\\frac{t}{3}\\right)^2+1^2} \\\\  & =\\sqrt{\\frac{t^{2}}{9}+1} \\\\  & =\\sqrt{\\frac{t^{2}}{9} + 1}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=\\frac{6 x}{y},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{6 \\left(\\frac{t^{2}}{6}\\right)}{t} \\\\  & =t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{6 x}{y}\\,\\text{d}s & ={\\int }_{\\sqrt{7}}^{4}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{7}}^{4}\\left(t\\right)\\cdot\\left(\\sqrt{\\frac{t^{2}}{9} + 1}\\right)\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{7}}^{4}\\frac{t \\sqrt{t^{2} + 9}}{3}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=t^{2} + 9,$ $\\text{d}u=2 t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{7}}^{4}\\frac{t \\sqrt{t^{2} + 9}}{3}\\,\\text{d}t & =\\frac{1}{3}{\\int }_{16}^{25}\\sqrt{u}\\cdot\\left(\\frac{1}{2}\\right)\\,\\text{d}u \\\\  & ={\\int }_{16}^{25}\\frac{\\sqrt{u}}{6}\\,\\text{d}u \\\\  & =\\left[\\frac{1}{6}\\cdot\\frac{2}{3}u^{3/2}\\right]_{16}^{25} \\\\  & =\\left[\\frac{u^{\\frac{3}{2}}}{9}\\right]_{16}^{25} \\\\  & =\\left(\\left(\\frac{\\left(25\\right)^{\\frac{3}{2}}}{9}\\right)\\right)-\\left(\\left(\\frac{\\left(16\\right)^{\\frac{3}{2}}}{9}\\right)\\right) \\\\  & =\\left(\\left(\\frac{125}{9}\\right)\\right)-\\left(\\left(\\frac{64}{9}\\right)\\right) \\\\  & =\\frac{61}{9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b01bf31-2ee2-53d0-94d2-836a1979c75d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9 \\sqrt{5}" :db/id #edb/ref 17592186519915} {:answer/id #uuid "3f7f8963-5894-537f-beb8-fd372b21c68a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186519923} {:answer/id #uuid "a6c1f173-d6f1-508b-9bb0-95bc71c51c1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{38 \\sqrt{5}}{3}" :db/id #edb/ref 17592186519961} {:answer/id #uuid "df9f311c-5c28-5284-b186-7d31aaae46f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5 \\sqrt{5}" :db/id #edb/ref 17592186519973} {:answer/id #uuid "f537f4b8-eb49-5ef0-9790-4395f8071591" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13 \\sqrt{5}" :db/id #edb/ref 17592186519980}] :answer-field/correct {:db/id #edb/ref 17592186519973} :answer-field/id #uuid "6400f1c6-0b7b-5401-8a4b-73a82dadcf86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519938}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "757a5531-af3b-53d8-af0b-e619bd9a8745" :question/problem "Evaluate the line integral\n$$\n\\displaystyle {\\int }_{C}2 y\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=2 y + 1$ from $(5,2)$ to $(7,3).$" :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=2 t + 1.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨2 t + 1,\\,t⟩,\\,2\\le t\\le 3\n$$\n\nNote that the domain $2\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t + 1)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2)^2+1^2} \\\\  & =\\sqrt{4+1} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=2 y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =2 t \\\\  & =2 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}2 y\\,\\text{d}s & ={\\int }_{2}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{2}^{3}\\left(2 t\\right)\\cdot\\left(\\sqrt{5}\\right)\\,\\text{d}t \\\\  & ={\\int }_{2}^{3}2 \\sqrt{5} t\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}2 \\sqrt{5} t\\,\\text{d}t & =\\left[\\sqrt{5} t^{2}\\right]_{2}^{3} \\\\  & =2 \\sqrt{5}\\left(\\frac{3^2}{2}-\\frac{2^2}{2}\\right) \\\\  & =2 \\sqrt{5}\\left(\\frac{9}{2}-2\\right) \\\\  & =5 \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39dca523-9171-5e40-833c-978d9ad71849" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25 \\sqrt{5}" :db/id #edb/ref 17592186519922} {:answer/id #uuid "473858c3-157d-5055-9739-f0d6b85e7989" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "78 \\sqrt{5}" :db/id #edb/ref 17592186519925} {:answer/id #uuid "754a7457-a3e8-51f7-b689-9b4291afc217" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186519943} {:answer/id #uuid "9aa6f2cf-f8b0-51f7-9093-58c3d7bf3ebb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "29 \\sqrt{5}" :db/id #edb/ref 17592186519953} {:answer/id #uuid "fe15649c-aa4e-5adc-af44-f12a4b3fb802" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21 \\sqrt{5}" :db/id #edb/ref 17592186519982}] :answer-field/correct {:db/id #edb/ref 17592186519982} :answer-field/id #uuid "86cb8063-be0e-59e9-b0ab-6ae36122c5ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519946}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a06b7a8-a31a-5d91-a4c2-27f8e724e7b7" :question/problem "Evaluate the line integral\n$$\n\\displaystyle {\\int }_{C}2 y\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=2 y + 1$ from $(5,2)$ to $(11,5).$" :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=2 t + 1.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨2 t + 1,\\,t⟩,\\,2\\le t\\le 5\n$$\n\nNote that the domain $2\\le t\\le 5$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t + 1)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2)^2+1^2} \\\\  & =\\sqrt{4+1} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=2 y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =2 t \\\\  & =2 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}2 y\\,\\text{d}s & ={\\int }_{2}^{5}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\left(2 t\\right)\\cdot\\left(\\sqrt{5}\\right)\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}2 \\sqrt{5} t\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{5}2 \\sqrt{5} t\\,\\text{d}t & =\\left[\\sqrt{5} t^{2}\\right]_{2}^{5} \\\\  & =2 \\sqrt{5}\\left(\\frac{5^2}{2}-\\frac{2^2}{2}\\right) \\\\  & =2 \\sqrt{5}\\left(\\frac{25}{2}-2\\right) \\\\  & =21 \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "498a3dd0-f17b-5f70-8b03-fc510f9aad6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{152 \\sqrt{5}}{3}" :db/id #edb/ref 17592186519926} {:answer/id #uuid "97f57c54-8701-5d8a-a5ed-fd3c0f65306b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52 \\sqrt{5}" :db/id #edb/ref 17592186519951} {:answer/id #uuid "af54eed5-bbc0-5fe0-84c5-eb933f76c6a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186519964} {:answer/id #uuid "c6ae83d0-87f4-5859-85f3-d0abf6c9594d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36 \\sqrt{5}" :db/id #edb/ref 17592186519968} {:answer/id #uuid "ff9120ba-23f5-5da5-845b-c9f43ed0780a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20 \\sqrt{5}" :db/id #edb/ref 17592186519983}] :answer-field/correct {:db/id #edb/ref 17592186519983} :answer-field/id #uuid "a078cda7-6548-5368-8ce0-29f35e1abda9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519957}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8c77817c-c092-573a-a129-dda1b7dbaf00" :question/problem "Evaluate the line integral\n$$\n\\displaystyle {\\int }_{C}8 y\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=2 y + 2$ from $(6,2)$ to $(8,3).$" :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=2 t + 2.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨2 t + 2,\\,t⟩,\\,2\\le t\\le 3\n$$\n\nNote that the domain $2\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t + 2)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2)^2+1^2} \\\\  & =\\sqrt{4+1} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=8 y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =8 t \\\\  & =8 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}8 y\\,\\text{d}s & ={\\int }_{2}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{2}^{3}\\left(8 t\\right)\\cdot\\left(\\sqrt{5}\\right)\\,\\text{d}t \\\\  & ={\\int }_{2}^{3}8 \\sqrt{5} t\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}8 \\sqrt{5} t\\,\\text{d}t & =\\left[4 \\sqrt{5} t^{2}\\right]_{2}^{3} \\\\  & =8 \\sqrt{5}\\left(\\frac{3^2}{2}-\\frac{2^2}{2}\\right) \\\\  & =8 \\sqrt{5}\\left(\\frac{9}{2}-2\\right) \\\\  & =20 \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ee718e7-8c66-5b5c-9686-158a4a052a0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{5}}{2} + \\frac{343}{2}" :db/id #edb/ref 17592186519937} {:answer/id #uuid "6d2f283d-ca77-5bd5-b76f-fd081e1ef092" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{343}{2} - \\frac{5 \\sqrt{5}}{2}" :db/id #edb/ref 17592186519942} {:answer/id #uuid "985323ac-4ffe-5a8b-b35b-a8ae16606764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{343}{2}" :db/id #edb/ref 17592186519952} {:answer/id #uuid "9ec560c5-8a2a-5832-803c-a59a7a317dea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "891" :db/id #edb/ref 17592186519955} {:answer/id #uuid "aa5db845-80f2-5dbc-b2a3-2f9cc3faee50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "33" :db/id #edb/ref 17592186519962}] :answer-field/correct {:db/id #edb/ref 17592186519942} :answer-field/id #uuid "64569d65-6b5b-57eb-a178-6af1a5ac90dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519939}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1335390-7338-553c-9752-14a0d9faa957" :question/problem "![](images/ca/ca91ec7d1e638b49ab7d4334397c5c7d383b7df0bce022c0e481b857ae2e1b95.png)\n\nEvaluate the line integral\n$$\n\\displaystyle {\\int }_{C}\\frac{6 x}{y}\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=y^{2}$ from $(1,1)$ to $(12,2 \\sqrt{3}),$ as shown above." :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=t^{2}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t^{2},\\,t⟩,\\,1\\le t\\le 2 \\sqrt{3}\n$$\n\nNote that the domain $1\\le t\\le 2 \\sqrt{3}$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t^{2})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2 t\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2 t)^2+1^2} \\\\  & =\\sqrt{4 t^{2}+1} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=\\frac{6 x}{y},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{6 \\left(t^{2}\\right)}{t} \\\\  & =6 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{6 x}{y}\\,\\text{d}s & ={\\int }_{1}^{2 \\sqrt{3}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2 \\sqrt{3}}\\left(6 t\\right)\\cdot\\left(\\sqrt{4 t^{2} + 1}\\right)\\,\\text{d}t \\\\  & ={\\int }_{1}^{2 \\sqrt{3}}6 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=4 t^{2} + 1,$ $\\text{d}u=8 t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2 \\sqrt{3}}6 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & =6{\\int }_{5}^{49}\\sqrt{u}\\cdot\\left(\\frac{1}{8}\\right)\\,\\text{d}u \\\\  & ={\\int }_{5}^{49}\\frac{3 \\sqrt{u}}{4}\\,\\text{d}u \\\\  & =\\left[\\frac{3}{4}\\cdot\\frac{2}{3}u^{3/2}\\right]_{5}^{49} \\\\  & =\\left[\\frac{u^{\\frac{3}{2}}}{2}\\right]_{5}^{49} \\\\  & =\\left(\\left(\\frac{\\left(49\\right)^{\\frac{3}{2}}}{2}\\right)\\right)-\\left(\\left(\\frac{\\left(5\\right)^{\\frac{3}{2}}}{2}\\right)\\right) \\\\  & =\\left(\\left(\\frac{343}{2}\\right)\\right)-\\left(\\left(\\frac{5 \\sqrt{5}}{2}\\right)\\right) \\\\  & =\\frac{343}{2} - \\frac{5 \\sqrt{5}}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d5f72a-c449-56eb-989f-22226e0b50de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15 \\sqrt{5}" :db/id #edb/ref 17592186519914} {:answer/id #uuid "128d4ac3-24ee-55ce-9b25-4cf80792cec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 \\sqrt{5}" :db/id #edb/ref 17592186519916} {:answer/id #uuid "7d024a42-dbb0-595d-9286-4d48315042fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186519945} {:answer/id #uuid "a286ac33-a522-5b67-b3fa-62a475c8f733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9 \\sqrt{5}" :db/id #edb/ref 17592186519959} {:answer/id #uuid "b4231752-2303-5f37-a885-fec04df72753" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14 \\sqrt{5}" :db/id #edb/ref 17592186519966}] :answer-field/correct {:db/id #edb/ref 17592186519959} :answer-field/id #uuid "5aabe041-866e-5d3f-b02e-f537a8abdf22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519935}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d33ab010-ae47-54a5-a66e-bc5313115fb2" :question/problem "Evaluate the line integral\n$$\n\\displaystyle {\\int }_{C}6 y\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=2 y + 2$ from $(4,1)$ to $(6,2).$" :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=2 t + 2.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨2 t + 2,\\,t⟩,\\,1\\le t\\le 2\n$$\n\nNote that the domain $1\\le t\\le 2$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t + 2)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2)^2+1^2} \\\\  & =\\sqrt{4+1} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=6 y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =6 t \\\\  & =6 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}6 y\\,\\text{d}s & ={\\int }_{1}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}\\left(6 t\\right)\\cdot\\left(\\sqrt{5}\\right)\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}6 \\sqrt{5} t\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}6 \\sqrt{5} t\\,\\text{d}t & =\\left[3 \\sqrt{5} t^{2}\\right]_{1}^{2} \\\\  & =6 \\sqrt{5}\\left(\\frac{2^2}{2}-\\frac{1^2}{2}\\right) \\\\  & =6 \\sqrt{5}\\left(2-\\frac{1}{2}\\right) \\\\  & =9 \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1baa52c1-5c71-5f87-8551-3279611003dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100 \\sqrt{5}" :db/id #edb/ref 17592186519919} {:answer/id #uuid "67732790-16a3-5527-b750-580381646c5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84" :db/id #edb/ref 17592186519940} {:answer/id #uuid "8e21c30b-33aa-5878-9f58-a724973bf4d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "116 \\sqrt{5}" :db/id #edb/ref 17592186519950} {:answer/id #uuid "9d078917-01b7-5c9d-8b60-6b5248691b82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84 \\sqrt{5}" :db/id #edb/ref 17592186519954} {:answer/id #uuid "bb9d7d72-6508-5e36-8e89-fed8dd873be4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "312 \\sqrt{5}" :db/id #edb/ref 17592186519967}] :answer-field/correct {:db/id #edb/ref 17592186519954} :answer-field/id #uuid "afcc0b52-3f45-5cf3-a53f-e03a34d67289" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519965}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "edc5b731-7331-5410-b96a-68df46082b51" :question/problem "Evaluate the line integral\n$$\n\\displaystyle {\\int }_{C}8 y\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=2 y + 2$ from $(6,2)$ to $(12,5).$" :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=2 t + 2.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨2 t + 2,\\,t⟩,\\,2\\le t\\le 5\n$$\n\nNote that the domain $2\\le t\\le 5$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t + 2)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2)^2+1^2} \\\\  & =\\sqrt{4+1} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=8 y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =8 t \\\\  & =8 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}8 y\\,\\text{d}s & ={\\int }_{2}^{5}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\left(8 t\\right)\\cdot\\left(\\sqrt{5}\\right)\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}8 \\sqrt{5} t\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{5}8 \\sqrt{5} t\\,\\text{d}t & =\\left[4 \\sqrt{5} t^{2}\\right]_{2}^{5} \\\\  & =8 \\sqrt{5}\\left(\\frac{5^2}{2}-\\frac{2^2}{2}\\right) \\\\  & =8 \\sqrt{5}\\left(\\frac{25}{2}-2\\right) \\\\  & =84 \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16637d83-9d55-58dd-9a6e-b892dcb60c85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{64 \\sqrt{2}}{15} + \\frac{832 \\sqrt{6}}{5}" :db/id #edb/ref 17592186519918} {:answer/id #uuid "2aae3009-c21c-529f-9656-63ab4497ccd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{832 \\sqrt{6}}{5}" :db/id #edb/ref 17592186519920} {:answer/id #uuid "d57a9be7-b91b-5c57-b613-1fb34ee7dd87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{32}{5} + 160 \\sqrt{5}" :db/id #edb/ref 17592186519970} {:answer/id #uuid "e7b390e9-d955-54c3-bde9-22bd5a28116c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5120}{3}" :db/id #edb/ref 17592186519975} {:answer/id #uuid "f5509479-ec88-5363-9bf0-f7d33b99fdee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{64 \\sqrt{2}}{15} + \\frac{832 \\sqrt{6}}{5}" :db/id #edb/ref 17592186519981}] :answer-field/correct {:db/id #edb/ref 17592186519918} :answer-field/id #uuid "e1f6ae96-8b2e-581c-93a9-a1569f0c7cc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519974}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f20094c6-0c28-54cf-af5d-3c0a666f7927" :question/problem "![](images/ad/ad80637c8c61ee847bd385c39fb0eec5fc1b14ee4f9d6c1796fb31baff48c016.png)\n\nEvaluate the line integral\n$$\n\\displaystyle {\\int }_{C}8 x y\\,\\text{d}s,\n$$\nwhere $C$ is the section of the curve $x=2 \\sqrt{y}$ from $(2,1)$ to $(2 \\sqrt{5},5),$ as shown above." :question/worked-solution "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=2 \\sqrt{t}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨2 \\sqrt{t},\\,t⟩,\\,1\\le t\\le 5\n$$\n\nNote that the domain $1\\le t\\le 5$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 \\sqrt{t})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{1}{\\sqrt{t}}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{\\left(\\frac{1}{\\sqrt{t}}\\right)^2+1^2} \\\\  & =\\sqrt{\\frac{1}{t}+1} \\\\  & =\\sqrt{1 + \\frac{1}{t}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=8 x y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =8 \\left(2 \\sqrt{t}\\right) t \\\\  & =16 t^{\\frac{3}{2}}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}8 x y\\,\\text{d}s & ={\\int }_{1}^{5}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{5}\\left(16 t^{\\frac{3}{2}}\\right)\\cdot\\left(\\sqrt{1 + \\frac{1}{t}}\\right)\\,\\text{d}t \\\\  & ={\\int }_{1}^{5}16 t \\sqrt{t + 1}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=4 t + 4,$ $\\text{d}u=4\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}16 t \\sqrt{t + 1}\\,\\text{d}t & =8{\\int }_{8}^{24}\\frac{u-4}{4}\\cdot\\sqrt{u}\\cdot\\frac{1}{4}\\,\\text{d}u \\\\  & ={\\int }_{8}^{24}\\frac{u^{\\frac{3}{2}}}{2} - 2 \\sqrt{u}\\,\\text{d}u \\\\  & =\\left[\\frac{1}{2}\\cdot\\left(\\frac{2}{5}u^{5/2}-(4)\\cdot\\frac{2}{3}u^{3/2}\\right)\\right]_{8}^{24} \\\\  & =\\left[\\frac{u^{\\frac{5}{2}}}{5} - \\frac{4 u^{\\frac{3}{2}}}{3}\\right]_{8}^{24} \\\\  & =\\left(\\left(\\frac{\\left(24\\right)^{\\frac{5}{2}}}{5}\\right)+\\left(- \\frac{4 \\left(24\\right)^{\\frac{3}{2}}}{3}\\right)\\right)-\\left(\\left(\\frac{\\left(8\\right)^{\\frac{5}{2}}}{5}\\right)+\\left(- \\frac{4 \\left(8\\right)^{\\frac{3}{2}}}{3}\\right)\\right) \\\\  & =\\left(\\left(\\frac{1152 \\sqrt{6}}{5}\\right)+\\left(- 64 \\sqrt{6}\\right)\\right)-\\left(\\left(\\frac{128 \\sqrt{2}}{5}\\right)+\\left(- \\frac{64 \\sqrt{2}}{3}\\right)\\right) \\\\  & =- \\frac{64 \\sqrt{2}}{15} + \\frac{832 \\sqrt{6}}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1348fc00-336c-53bb-be7c-916496ef5d88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186520808} {:answer/id #uuid "55053be1-77fb-5c4b-806e-49e7c1fc512f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186520958} {:answer/id #uuid "662c897b-ead7-5be2-af3c-4e8c4cf7d102" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186520996} {:answer/id #uuid "b48883a2-477f-5af5-a0a1-a15c7ffa7d19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186521168} {:answer/id #uuid "c81bffa8-6d28-5db1-a4e4-943e85fac37c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186521211}] :answer-field/correct {:db/id #edb/ref 17592186521211} :answer-field/id #uuid "81425c09-b875-5245-8a44-a234fc04ecfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521387}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19360ab0-63c4-5cd8-9a4a-b29910944cd3" :question/math-academy-id "q-162232" :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=x\\,i-z\\,k$ along the closed curve $C$ given by $r(t)=({t}^{2}-t)\\,i+({t}^{3}-{t}^{2})\\,j+k$ for $t\\in [0,1).$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2}-t,\\,y={t}^{3}-{t}^{2},\\,z=1.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i-z\\,k \\\\  & =({t}^{2}-t)\\,i-1\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(1)\\,k \\\\  & =(2t-1)\\,i+(3{t}^{2}-2t)\\,j+0\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(({t}^{2}-t)\\,i-\\,k)\\cdot ((2t-1)\\,i+(3{t}^{2}-2t)\\,j) \\\\  & =({t}^{2}-t)\\cdot (2t-1)+0\\cdot (3{t}^{2}-2t)+(-1)\\cdot 0 \\\\  & =({t}^{2}-t)(2t-1).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{2}-t)(2t-1)\\,\\text{d}t \\\\  & ={[\\frac{({t}^{2}-t)^{2}}{2}]}_{0}^{1} \\\\  & =(0-0) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c4b66cf-ec3e-5130-bf78-dab2acbc861c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{x}\\,{x}^{2}-{y}^{2}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520786} {:answer/id #uuid "3598a050-8338-5881-8c7e-00b829e53f3f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520878} {:answer/id #uuid "531bef77-5bda-58b0-b731-a0a09745931d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{x}\\,4+2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520953} {:answer/id #uuid "580a54b0-7193-5059-b069-221fd5506992" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2+2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520963} {:answer/id #uuid "735bc584-a512-58b1-8842-88d84b62c851" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186521022}] :answer-field/correct {:db/id #edb/ref 17592186521022} :answer-field/id #uuid "bce8cadb-6f17-5458-a146-66e868571308" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521421}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22c4166d-7812-5cc0-89d7-bc30157982f0" :question/math-academy-id "q-162363" :question/problem "Let $C$ be the intersection of the hyperbolic paraboloid $z={x}^{2}-{y}^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x=\\pm 1,$ $y=\\pm 2.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨y,\\,x,\\,2⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z={x}^{2}-{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)={x}^{2}-{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({x}^{2}-{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({x}^{2}-{y}^{2})=-2y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨y,\\,x,\\,2⟩{|}_{z={x}^{2}-{y}^{2}} \\\\  & =⟨y,\\,x,\\,2⟩ \\\\  & =⟨\\underbrace{y}_{P},\\,\\underbrace{x}_{Q},\\,\\underbrace{2}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (2x)-x\\cdot (-2y)+2)\\,\\text{d}A \\\\  & ={∬}_{D}2\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/5f/5f2f4cb03b3b0232c9debd1f4ed64bd683fe788ccba16cfbe395d9c3b629972d.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}2\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49efc351-4e26-566c-99c2-fe234a1dd84a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186520930} {:answer/id #uuid "83f896a5-bf32-5e5d-9cc6-f790b29f490e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186521065} {:answer/id #uuid "96cf3b15-d8b8-5670-bef5-bd091199fa39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\pi " :db/id #edb/ref 17592186521109} {:answer/id #uuid "a99d6b81-4b37-544d-99ea-7af055e746a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186521144} {:answer/id #uuid "ac7ed5de-3dc1-5a83-a649-aaf890348062" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10\\pi " :db/id #edb/ref 17592186521149}] :answer-field/correct {:db/id #edb/ref 17592186521149} :answer-field/id #uuid "fd517342-4196-5078-a01c-54f228cf9d0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521451}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2bdcc65b-8401-5044-8aa5-c9a7e37ffa6b" :question/math-academy-id "q-162890" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j+2\\operatorname{cos}⁡t\\,k$ for $t\\in [0,2\\pi ).$\nGiven that $F(x,y,z)=2z\\,i+x\\,j+3y\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t,\\,z=2\\operatorname{cos}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =2z\\,i+x\\,j+3y\\,k \\\\  & =4\\operatorname{cos}⁡t\\,i+\\operatorname{cos}⁡t\\,j+6\\operatorname{sin}⁡t\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j-2\\operatorname{sin}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(4\\operatorname{cos}⁡t\\,i+\\operatorname{cos}⁡t\\,j+6\\operatorname{sin}⁡t\\,k)\\cdot (-\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j-2\\operatorname{sin}⁡t\\,k) \\\\  & =4\\operatorname{cos}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot 2\\operatorname{cos}⁡t+6\\operatorname{sin}⁡t\\cdot (-2\\operatorname{sin}⁡t) \\\\  & =-4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2{cos}^{2}⁡t-12{sin}^{2}⁡t \\\\  & =-2\\operatorname{sin}⁡(2t)+2{cos}^{2}⁡t+2{sin}^{2}⁡t-14{sin}^{2}⁡t \\\\  & =-2\\operatorname{sin}⁡2t-14{sin}^{2}⁡t+2.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-2\\operatorname{sin}⁡2t-14{sin}^{2}⁡t+2)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-2\\operatorname{sin}⁡2t-7(1-\\operatorname{cos}⁡2t)+2)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-2\\operatorname{sin}⁡2t-5+7\\operatorname{cos}⁡2t)\\,\\text{d}t \\\\  & ={[\\operatorname{cos}⁡2t-5t+\\frac{7}{2}\\operatorname{sin}⁡2t]}_{0}^{2\\pi } \\\\  & =(1-5(2\\pi )+0)-(1-5(0)+0) \\\\  & =-10\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521681 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c37ef54-3dae-58eb-86ba-e0608831b30c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-8,-12⟩\\cdot ⟨x + 1,\\,y + 2⟩=0" :db/id #edb/ref 17592186521698} {:answer/id #uuid "61b75093-2b8c-58b7-8188-b0952cfe42de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨8,-12⟩\\cdot ⟨x + 1,\\,y + 2⟩=0" :db/id #edb/ref 17592186521700} {:answer/id #uuid "7a0b9fd6-d82a-5b2a-959f-b39a6313e958" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-8,-12⟩\\cdot ⟨x + 1,\\,y - 2⟩=0" :db/id #edb/ref 17592186521708} {:answer/id #uuid "803e91f0-bba5-5405-ae5a-c091ede06aa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-12,-8⟩\\cdot ⟨x + 1,\\,y + 2⟩=0" :db/id #edb/ref 17592186521713} {:answer/id #uuid "caf0597d-ab9c-5a42-82c1-3fe84a63a936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-8,-12⟩\\cdot ⟨x - 1,\\,y + 2⟩=0" :db/id #edb/ref 17592186521731}] :answer-field/correct {:db/id #edb/ref 17592186521698} :answer-field/id #uuid "f8d79453-6692-51e6-8683-1c5f858701cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521744}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c9b715c-7ccb-51aa-804e-8cbcc40004a8" :question/problem "Given the function $f(x,y)=6 x^{2} + x y^{2} + 4 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(-1,-2).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-1,-2):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(6 x^{2} + x y^{2} + 4 y^{2})\\,i+\\frac{∂}{∂y}(6 x^{2} + x y^{2} + 4 y^{2})\\,j \\\\  & =(12 x + y^{2})\\,i+(2 x y + 8 y)\\,j \\\\ ∇f(-1,-2) & =(12 (-1) + (-2)^{2})\\,i+(2 (-1) (-2) + 8 (-2))\\,j \\\\  & =(-8)\\,i+(-12)\\,j \\\\  & =⟨-8,-12⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(-1,-2)\\cdot ⟨x-(-1),\\,y-(-2)⟩ & =0 \\\\ ⟨-8,-12⟩\\cdot ⟨x + 1,\\,y + 2⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521684 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec3cb01-9709-5f4d-b512-edefe3f3ee1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{185}{4},- \\frac{55}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521677} {:answer/id #uuid "2f284a02-2fb2-5fa7-bd41-576dd3d0bba5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{55}{2},\\frac{185}{4}⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521689} {:answer/id #uuid "7d40b20a-3844-5ee1-965b-acec820bd31d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{185}{4},- \\frac{55}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521710} {:answer/id #uuid "7f241a59-debf-5de1-a40a-8220ae6d711f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{185}{4},- \\frac{55}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y + \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521712} {:answer/id #uuid "8a532d49-8d53-5a2f-a45c-6713f991d1b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{185}{4},- \\frac{55}{2}⟩\\cdot ⟨x - \\frac{3}{2},\\,y - \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521717}] :answer-field/correct {:db/id #edb/ref 17592186521677} :answer-field/id #uuid "b665079c-c019-5428-b8de-1f2f603c7242" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521726}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "20ccc6f9-9078-5553-ae96-b36095f293ae" :question/problem "Given the function $f(x,y)=- 5 x^{2} + 5 x y^{2} + 2 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(- \\frac{3}{2},\\frac{5}{2}).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(- \\frac{3}{2},\\frac{5}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(- 5 x^{2} + 5 x y^{2} + 2 y^{2})\\,i+\\frac{∂}{∂y}(- 5 x^{2} + 5 x y^{2} + 2 y^{2})\\,j \\\\  & =(- 10 x + 5 y^{2})\\,i+(10 x y + 4 y)\\,j \\\\ ∇f(- \\frac{3}{2},\\frac{5}{2}) & =(- 10 \\left(- \\frac{3}{2}\\right) + 5 \\left(\\frac{5}{2}\\right)^{2})\\,i+(10 \\left(- \\frac{3}{2}\\right) \\left(\\frac{5}{2}\\right) + 4 \\left(\\frac{5}{2}\\right))\\,j \\\\  & =\\left(\\frac{185}{4}\\right)\\,i+\\left(- \\frac{55}{2}\\right)\\,j \\\\  & =⟨\\frac{185}{4},- \\frac{55}{2}⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(- \\frac{3}{2},\\frac{5}{2})\\cdot ⟨x-\\left(- \\frac{3}{2}\\right),\\,y-\\left(\\frac{5}{2}\\right)⟩ & =0 \\\\ ⟨\\frac{185}{4},- \\frac{55}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21544ba6-ef06-5266-93a1-313a526067e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x + \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521685} {:answer/id #uuid "2eb23044-bcc9-5962-9105-7de29057842a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521688} {:answer/id #uuid "46b191a3-b090-5dd0-ac4f-c90400eb199a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{13}{3},\\frac{85}{9}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521691} {:answer/id #uuid "6c6a3182-68ef-5d3d-8b37-e9e7be34344c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521704} {:answer/id #uuid "8b23529b-86a4-53b3-8086-beeeb9b129c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y + \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521718}] :answer-field/correct {:db/id #edb/ref 17592186521688} :answer-field/id #uuid "854ed5c8-bf23-5931-b481-8a38951b43b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521715}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4f9f3451-ede1-5210-8b07-6d5429ad7a60" :question/problem "Given the function $f(x,y)=2 x^{2} - 5 x y^{2} + 6 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(\\frac{5}{2},\\frac{1}{3}).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{5}{2},\\frac{1}{3}):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,j \\\\  & =(4 x - 5 y^{2})\\,i+(- 10 x y + 12 y)\\,j \\\\ ∇f(\\frac{5}{2},\\frac{1}{3}) & =(4 \\left(\\frac{5}{2}\\right) - 5 \\left(\\frac{1}{3}\\right)^{2})\\,i+(- 10 \\left(\\frac{5}{2}\\right) \\left(\\frac{1}{3}\\right) + 12 \\left(\\frac{1}{3}\\right))\\,j \\\\  & =\\left(\\frac{85}{9}\\right)\\,i+\\left(- \\frac{13}{3}\\right)\\,j \\\\  & =⟨\\frac{85}{9},- \\frac{13}{3}⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(\\frac{5}{2},\\frac{1}{3})\\cdot ⟨x-\\left(\\frac{5}{2}\\right),\\,y-\\left(\\frac{1}{3}\\right)⟩ & =0 \\\\ ⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fa1950-a214-593e-94bb-243b690a1707" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-49,66⟩\\cdot ⟨x + 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521679} {:answer/id #uuid "710f2844-45c8-59bf-880d-fe3c26cb0832" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-49,66⟩\\cdot ⟨x + 1,\\,y + 3⟩=0" :db/id #edb/ref 17592186521706} {:answer/id #uuid "d48dac5a-1d5f-5154-aa25-33bdbfcde65c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨49,66⟩\\cdot ⟨x + 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521732} {:answer/id #uuid "df36e640-415f-58a4-bc06-4d7c4809c34d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-49,66⟩\\cdot ⟨x - 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521736} {:answer/id #uuid "e2b2b0d4-a0e4-5086-b86d-dbc7f486d746" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨66,-49⟩\\cdot ⟨x + 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521738}] :answer-field/correct {:db/id #edb/ref 17592186521679} :answer-field/id #uuid "7baa5690-e3d0-5579-a631-3557bc32676a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521709}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "881a79d9-03b1-51ac-8b66-c52a6345dfc8" :question/problem "Given the function $f(x,y)=2 x^{2} - 5 x y^{2} + 6 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(-1,3).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-1,3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,j \\\\  & =(4 x - 5 y^{2})\\,i+(- 10 x y + 12 y)\\,j \\\\ ∇f(-1,3) & =(4 (-1) - 5 (3)^{2})\\,i+(- 10 (-1) (3) + 12 (3))\\,j \\\\  & =(-49)\\,i+(66)\\,j \\\\  & =⟨-49,66⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(-1,3)\\cdot ⟨x-(-1),\\,y-(3)⟩ & =0 \\\\ ⟨-49,66⟩\\cdot ⟨x + 1,\\,y - 3⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08396be8-551a-56f0-be99-5d1834a0c9d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-20,- \\frac{111}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y + \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521676} {:answer/id #uuid "10e86575-f93c-5f64-950f-c7b82d9e1364" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{111}{2},-20⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521678} {:answer/id #uuid "186cfe4b-4dfa-530b-9d0d-dd50f922acde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{111}{2},-20⟩\\cdot ⟨x + \\frac{3}{2},\\,y + \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521680} {:answer/id #uuid "1d12fff6-b9f1-57fd-a747-267328625646" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{111}{2},-20⟩\\cdot ⟨x + \\frac{3}{2},\\,y + \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521682} {:answer/id #uuid "1d6289d5-24ff-5c6c-97cc-fd398c028f1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{111}{2},-20⟩\\cdot ⟨x - \\frac{3}{2},\\,y + \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521683}] :answer-field/correct {:db/id #edb/ref 17592186521680} :answer-field/id #uuid "92ce6bee-2817-5c2a-8469-519cf78c9bd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521721}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8eb72b3b-1817-5b03-8db4-35e0f0a341f5" :question/problem "Given the function $f(x,y)=6 x^{2} - 6 x y^{2} - 5 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(- \\frac{3}{2},- \\frac{5}{2}).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(- \\frac{3}{2},- \\frac{5}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(6 x^{2} - 6 x y^{2} - 5 y^{2})\\,i+\\frac{∂}{∂y}(6 x^{2} - 6 x y^{2} - 5 y^{2})\\,j \\\\  & =(12 x - 6 y^{2})\\,i+(- 12 x y - 10 y)\\,j \\\\ ∇f(- \\frac{3}{2},- \\frac{5}{2}) & =(12 \\left(- \\frac{3}{2}\\right) - 6 \\left(- \\frac{5}{2}\\right)^{2})\\,i+(- 12 \\left(- \\frac{3}{2}\\right) \\left(- \\frac{5}{2}\\right) - 10 \\left(- \\frac{5}{2}\\right))\\,j \\\\  & =\\left(- \\frac{111}{2}\\right)\\,i+(-20)\\,j \\\\  & =⟨- \\frac{111}{2},-20⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(- \\frac{3}{2},- \\frac{5}{2})\\cdot ⟨x-\\left(- \\frac{3}{2}\\right),\\,y-\\left(- \\frac{5}{2}\\right)⟩ & =0 \\\\ ⟨- \\frac{111}{2},-20⟩\\cdot ⟨x + \\frac{3}{2},\\,y + \\frac{5}{2}⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bd85355-271e-50bb-88b1-d2b13a06d756" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{119}{4},\\frac{3}{2}⟩\\cdot ⟨x + \\frac{5}{2},\\,y + \\frac{1}{2}⟩=0" :db/id #edb/ref 17592186521693} {:answer/id #uuid "5706501c-de86-5634-87a7-ddcfe0773c5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{119}{4},\\frac{3}{2}⟩\\cdot ⟨x + \\frac{5}{2},\\,y - \\frac{1}{2}⟩=0" :db/id #edb/ref 17592186521697} {:answer/id #uuid "66a910cc-c44b-5f7c-b648-cb1fe9aff95d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨- \\frac{119}{4},\\frac{3}{2}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{2}⟩=0" :db/id #edb/ref 17592186521701} {:answer/id #uuid "672bcb75-b4ca-5b71-9acb-7ec472d66c38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{2},- \\frac{119}{4}⟩\\cdot ⟨x + \\frac{5}{2},\\,y - \\frac{1}{2}⟩=0" :db/id #edb/ref 17592186521702} {:answer/id #uuid "bc3912a8-6f0e-56f9-a5f1-d09dbac9861c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{119}{4},\\frac{3}{2}⟩\\cdot ⟨x + \\frac{5}{2},\\,y - \\frac{1}{2}⟩=0" :db/id #edb/ref 17592186521728}] :answer-field/correct {:db/id #edb/ref 17592186521697} :answer-field/id #uuid "2e6fa0b3-7471-5b24-b6ed-74973563e2be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521687}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "973a3ce1-53a3-5558-8746-a27a1f5bd217" :question/problem "Given the function $f(x,y)=6 x^{2} + x y^{2} + 4 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(- \\frac{5}{2},\\frac{1}{2}).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(- \\frac{5}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(6 x^{2} + x y^{2} + 4 y^{2})\\,i+\\frac{∂}{∂y}(6 x^{2} + x y^{2} + 4 y^{2})\\,j \\\\  & =(12 x + y^{2})\\,i+(2 x y + 8 y)\\,j \\\\ ∇f(- \\frac{5}{2},\\frac{1}{2}) & =(12 \\left(- \\frac{5}{2}\\right) + \\left(\\frac{1}{2}\\right)^{2})\\,i+(2 \\left(- \\frac{5}{2}\\right) \\left(\\frac{1}{2}\\right) + 8 \\left(\\frac{1}{2}\\right))\\,j \\\\  & =\\left(- \\frac{119}{4}\\right)\\,i+\\left(\\frac{3}{2}\\right)\\,j \\\\  & =⟨- \\frac{119}{4},\\frac{3}{2}⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(- \\frac{5}{2},\\frac{1}{2})\\cdot ⟨x-\\left(- \\frac{5}{2}\\right),\\,y-\\left(\\frac{1}{2}\\right)⟩ & =0 \\\\ ⟨- \\frac{119}{4},\\frac{3}{2}⟩\\cdot ⟨x + \\frac{5}{2},\\,y - \\frac{1}{2}⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25baa447-0f3c-51cd-aaf7-6b3ac00a96e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨72,-16⟩\\cdot ⟨x + 2,\\,y - 3⟩=0" :db/id #edb/ref 17592186521686} {:answer/id #uuid "711d8eaf-84ac-5817-bb06-8bb383e766df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-16,72⟩\\cdot ⟨x + 2,\\,y + 3⟩=0" :db/id #edb/ref 17592186521707} {:answer/id #uuid "9def3085-312c-56c4-b6c4-579f38156da9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨16,72⟩\\cdot ⟨x + 2,\\,y - 3⟩=0" :db/id #edb/ref 17592186521723} {:answer/id #uuid "afc3ae48-4ccd-52e2-bf8b-9d12065c313f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-16,72⟩\\cdot ⟨x - 2,\\,y - 3⟩=0" :db/id #edb/r