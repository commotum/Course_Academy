d #edb/ref 17592186045498} :answer/value "144" :db/id #edb/ref 17592186534236} {:answer/id #uuid "c8b8457d-b2e6-5989-8e6c-dd59d1b3aaf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-252" :db/id #edb/ref 17592186534245} {:answer/id #uuid "ee17ef55-5428-5486-a3ff-0708d8d93453" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72" :db/id #edb/ref 17592186534248}] :answer-field/correct {:db/id #edb/ref 17592186534245} :answer-field/id #uuid "2436d2ef-9539-51ea-b406-cc5f8b0716d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534221}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a22ef47-ba80-5740-a37c-d803f29b10ec" :question/problem "Find the value of $$\n\\displaystyle \\begin{vmatrix}2 & 8 & -6 \\\\ -7 & 5 & -8 \\\\ 3 & -6 & 3\\end{vmatrix}.\n$$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 8 & -6 \\\\ -7 & 5 & -8 \\\\ 3 & -6 & 3\\end{vmatrix} & =2\\begin{vmatrix}5 & -8 \\\\ -6 & 3\\end{vmatrix}-8\\begin{vmatrix}-7 & -8 \\\\ 3 & 3\\end{vmatrix}+(-6)\\begin{vmatrix}-7 & 5 \\\\ 3 & -6\\end{vmatrix} \\\\  & =2(15-48)+(-8)(-21-(-24))+(-6)(42-15) \\\\  & =2\\cdot (-33)+(-8)\\cdot 3+(-6)\\cdot 27 \\\\  & =-66-24-162 \\\\  & =-252\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc809fa4-652d-5ac8-974c-677581cdb740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "290" :db/id #edb/ref 17592186534242}] :answer-field/correct {:db/id #edb/ref 17592186534242} :answer-field/id #uuid "21e24fff-e059-56bd-a412-331cb6aac184" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534220}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e7f085d-8189-5198-aacc-e050d549ba30" :question/problem "If $$\n\\displaystyle A=\\begin{bmatrix}-2 & 8 & -3 \\\\ 6 & 7 & -3 \\\\ 2 & -2 & -4\\end{bmatrix},\n$$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-2 & 8 & -3 \\\\ 6 & 7 & -3 \\\\ 2 & -2 & -4\\end{vmatrix} & =(-2)\\begin{vmatrix}7 & -3 \\\\ -2 & -4\\end{vmatrix}-8\\begin{vmatrix}6 & -3 \\\\ 2 & -4\\end{vmatrix}+(-3)\\begin{vmatrix}6 & 7 \\\\ 2 & -2\\end{vmatrix} \\\\  & =(-2)(7\\cdot (-4)-(-3)\\cdot (-2))+(-8)(6\\cdot (-4)-(-3)\\cdot 2)+(-3)(6\\cdot (-2)-7\\cdot 2) \\\\  & =(-2)(-28-6)+(-8)(-24-(-6))+(-3)(-12-14) \\\\  & =(-2)\\cdot (-34)+(-8)\\cdot (-18)+(-3)\\cdot (-26) \\\\  & =68+144+78 \\\\  & =290\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b87f15d6-01c2-557f-a08c-16a5ceb7d64c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2080" :db/id #edb/ref 17592186534238}] :answer-field/correct {:db/id #edb/ref 17592186534238} :answer-field/id #uuid "6b974bbe-ce42-568d-a217-2141b1101e14" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534230}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b0697975-fcd3-5a6b-8bab-bac455d6d4bb" :question/problem "If $$\n\\displaystyle Q=\\begin{bmatrix}-10 & -5 & 4 \\\\ -10 & 8 & -7 \\\\ -10 & -5 & -12\\end{bmatrix},\n$$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-10 & -5 & 4 \\\\ -10 & 8 & -7 \\\\ -10 & -5 & -12\\end{vmatrix} & =(-10)\\begin{vmatrix}8 & -7 \\\\ -5 & -12\\end{vmatrix}-(-5)\\begin{vmatrix}-10 & -7 \\\\ -10 & -12\\end{vmatrix}+4\\begin{vmatrix}-10 & 8 \\\\ -10 & -5\\end{vmatrix} \\\\  & =(-10)(8\\cdot (-12)-(-7)\\cdot (-5))+5((-10)\\cdot (-12)-(-7)\\cdot (-10))+4((-10)\\cdot (-5)-8\\cdot (-10)) \\\\  & =(-10)(-96-35)+5(120-70)+4(50-(-80)) \\\\  & =(-10)\\cdot (-131)+5\\cdot 50+4\\cdot 130 \\\\  & =1310+250+520 \\\\  & =2080\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc802cfd-5dcd-5ae0-9368-5cd44186f5bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-163" :db/id #edb/ref 17592186534247}] :answer-field/correct {:db/id #edb/ref 17592186534247} :answer-field/id #uuid "c48cbd3e-4fec-5282-b2b0-e02d9a186f35" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534243}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c662d088-8a5c-538a-9a26-b6ad00819d49" :question/problem "If $$\n\\displaystyle Q=\\begin{bmatrix}8 & 5 & 5 \\\\ 9 & 8 & -4 \\\\ -12 & -9 & -10\\end{bmatrix},\n$$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}8 & 5 & 5 \\\\ 9 & 8 & -4 \\\\ -12 & -9 & -10\\end{vmatrix} & =8\\begin{vmatrix}8 & -4 \\\\ -9 & -10\\end{vmatrix}-5\\begin{vmatrix}9 & -4 \\\\ -12 & -10\\end{vmatrix}+5\\begin{vmatrix}9 & 8 \\\\ -12 & -9\\end{vmatrix} \\\\  & =8(8\\cdot (-10)-(-4)\\cdot (-9))+(-5)(9\\cdot (-10)-(-4)\\cdot (-12))+5(9\\cdot (-9)-8\\cdot (-12)) \\\\  & =8(-80-36)+(-5)(-90-48)+5(-81-(-96)) \\\\  & =8\\cdot (-116)+(-5)\\cdot (-138)+5\\cdot 15 \\\\  & =-928+690+75 \\\\  & =-163\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb6d018c-ba33-52b5-b3d7-aa5783cc6736" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1022" :db/id #edb/ref 17592186534252}] :answer-field/correct {:db/id #edb/ref 17592186534252} :answer-field/id #uuid "7ab18f7c-f40c-5379-93c7-a7f21c1e6cce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534232}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d662af0a-b4d4-5653-a75a-192a84ba886b" :question/problem "If $$\n\\displaystyle Q=\\begin{bmatrix}7 & -7 & 9 \\\\ -7 & -7 & 7 \\\\ 12 & -12 & 5\\end{bmatrix},\n$$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & -7 & 9 \\\\ -7 & -7 & 7 \\\\ 12 & -12 & 5\\end{vmatrix} & =7\\begin{vmatrix}-7 & 7 \\\\ -12 & 5\\end{vmatrix}-(-7)\\begin{vmatrix}-7 & 7 \\\\ 12 & 5\\end{vmatrix}+9\\begin{vmatrix}-7 & -7 \\\\ 12 & -12\\end{vmatrix} \\\\  & =7((-7)\\cdot 5-7\\cdot (-12))+7((-7)\\cdot 5-7\\cdot 12)+9((-7)\\cdot (-12)-(-7)\\cdot 12) \\\\  & =7(-35-(-84))+7(-35-84)+9(84-(-84)) \\\\  & =7\\cdot 49+7\\cdot (-119)+9\\cdot 168 \\\\  & =343-833+1512 \\\\  & =1022\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003496f1-3b51-50b5-b886-d6d3f3efcc21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1839" :db/id #edb/ref 17592186534215}] :answer-field/correct {:db/id #edb/ref 17592186534215} :answer-field/id #uuid "2d8282c0-97d4-5fb5-b9eb-de5bff7453bc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534222}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f47007bd-5cbd-5756-890b-9b75cb25d807" :question/problem "If $$\n\\displaystyle W=\\begin{bmatrix}-9 & 9 & 8 \\\\ 12 & 8 & -5 \\\\ 6 & 5 & 8\\end{bmatrix},\n$$ then $det(W)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-9 & 9 & 8 \\\\ 12 & 8 & -5 \\\\ 6 & 5 & 8\\end{vmatrix} & =(-9)\\begin{vmatrix}8 & -5 \\\\ 5 & 8\\end{vmatrix}-9\\begin{vmatrix}12 & -5 \\\\ 6 & 8\\end{vmatrix}+8\\begin{vmatrix}12 & 8 \\\\ 6 & 5\\end{vmatrix} \\\\  & =(-9)(8\\cdot 8-(-5)\\cdot 5)+(-9)(12\\cdot 8-(-5)\\cdot 6)+8(12\\cdot 5-8\\cdot 6) \\\\  & =(-9)(64-(-25))+(-9)(96-(-30))+8(60-48) \\\\  & =(-9)\\cdot 89+(-9)\\cdot 126+8\\cdot 12 \\\\  & =-801-1134+96 \\\\  & =-1839\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "207f985c-5c7f-5533-a8b6-987df6052d66" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186534331} {:answer/id #uuid "42f905b7-6402-5058-b569-ac945598dc5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186534391} {:answer/id #uuid "6945da02-c950-5064-a170-fc578a3069fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186534481} {:answer/id #uuid "9219bfba-4d32-5e6f-9243-454fb1322162" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186534588} {:answer/id #uuid "a5ae85ad-3923-5d0b-9389-406219ac54b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186534637}] :answer-field/correct {:db/id #edb/ref 17592186534331} :answer-field/id #uuid "ab27c17a-102b-5532-a4af-ffd4b651eaf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534927}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3f935fec-3b1f-581f-b980-6cf035478e31" :question/math-academy-id "q-125496" :question/problem "![](images/a5/a5f23af5dd514a65937eee29bb0992ff94d68897d8c6422fcf215aad45379c4a.png)\n\nConsider the part of parabola and constant vector field $F$ shown above. Let $C$ be the path where the part of parabola is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0\n$$\n\nII. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r=0\n$$\n\nIII. $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r>0\n$$" :question/worked-solution "Remember that $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r\n$$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0.\n$$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r<0.\n$$\n\nWith that in mind, let's check each statement.\n\n- Statements I is false, while statement II is true. As the particle moves from $A$ to $B,$ the force $F$ works with the particle for $y<0,$ while $F$  works against the particle for $y>0.$ \n\n![](images/53/537aca6190fc2f3e06e85c0781a8bb461559ef0a7515ee29aca505f9d615f820.png)\n\n \n\nBy symmetry, the contribution to $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r\n$$ for $y<0$ is canceled out by the contribution for $y>0.$ So,\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r=0.\n$$\n\n- Statement III is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/49/4939f9a22400a7a56eaeacb77d520e522f50aa8378ca1014a19810122e12da51.png)\n\n \n\nSo, $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r=0.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186535015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2569d358-b974-5ab3-bc46-887feb8dc1c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186534344} {:answer/id #uuid "8fd73072-7917-5f86-99a8-41ee2a588608" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186534584} {:answer/id #uuid "944d538b-b3a1-5009-9ca2-782affab4ee6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186534591} {:answer/id #uuid "c0b28b0e-b9f8-552a-97a2-7b024eb7c68b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186534694} {:answer/id #uuid "d214a18a-5783-55d2-8cad-8aa1d708bdea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186534734}] :answer-field/correct {:db/id #edb/ref 17592186534584} :answer-field/id #uuid "bd4d08a8-464b-5031-bdac-129c93989f3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534940}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c3b3b24-43f3-512c-b4aa-af0e4524c252" :question/math-academy-id "q-150013" :question/problem "![](images/dc/dcf7a2ea5b44f3f5ba7b1663f7979cdc3fc8c1036b6cc797904ffda77f1003bd.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the сurve is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0\n$$\n\nII. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r<0\n$$\n\nIII. $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r<0\n$$" :question/worked-solution "Remember that $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r\n$$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0.\n$$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r<0.\n$$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true while statement II is false. It's clear from the picture below that $F$  assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/81/818ad935fd7aa592f00c23c9c77799d127449b4bb6ffacee4354e7acf39887d8.png)\n\nSo, $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0.\n$$\n\n- Statement III is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/70/70e268a08195a92573f41927ae7de653837fca273f0c75cb951243a31ec660a2.png)\n\nSo, $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r<0.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186535078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37c513f0-8e53-5681-addf-29a9147b60ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186534371} {:answer/id #uuid "727c6d10-f05b-51c9-89d4-2264deae7ee0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186534506} {:answer/id #uuid "7e0dedae-2946-5360-b334-0d9616cd33c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186534536} {:answer/id #uuid "9c162211-9ea9-54bb-9f45-d836755b653f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186534611} {:answer/id #uuid "ffd8d63f-35ce-5d33-8f42-afecc9c28f08" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186534826}] :answer-field/correct {:db/id #edb/ref 17592186534826} :answer-field/id #uuid "abe81e71-7378-51b7-8cd0-c1c7afdebd22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534929}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8382e90-f8cf-5c02-a1ba-6dd0a94124ee" :question/math-academy-id "q-125502" :question/problem "![](images/8a/8aed400e7768b70f4532642418d83b36d9e32aa84db87c71ea6d902504930bc4.png)\n\nConsider the vector field $F(x,y)$ shown above, and let $C$ be the path where the semiellipse is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0\n$$\n\nII. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r=0\n$$\n\nIII. $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r=0\n$$" :question/worked-solution "Remember that $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r\n$$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0.\n$$\n\n- If the force works *against* the motion  of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r<0.\n$$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement II is true. Since the force $F$ acts perpendicular to the motion of the particle as it moves from $A$ to $B,$ it neither helps nor hinders its motion. \n\n![](images/d8/d8e05de34bf9ddfdbf9580b1df32eb9e091f56f76ac3616cbb1cd81d5d212a86.png)\n\n \nSo, $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r=0.\n$$\n\n- Statement III is true. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/17/17423916013677c1476df5a4368ab9eec81671b04b4ca29a0e702b20ddc818f2.png)\n\n \nSo, $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r=0.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186535079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d89cccc-306c-53d5-aef6-3a09d66762b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186534383} {:answer/id #uuid "4f3ee884-db04-5c75-9481-3c7b9fdbaebb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186534419} {:answer/id #uuid "8d3245f3-1418-5cbc-8bdf-0fbf963d7590" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186534571} {:answer/id #uuid "a183fdc7-3ce9-52cd-9fb3-ce809fabf547" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186534629} {:answer/id #uuid "d6f17f74-b9d6-5ff0-add2-62309e9b7aff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186534752}] :answer-field/correct {:db/id #edb/ref 17592186534571} :answer-field/id #uuid "4ea4a547-6ad1-5f93-999f-8abb84e0f98d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534877}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8988e8d-780c-5cf1-8b3a-d358392fe42f" :question/math-academy-id "q-125694" :question/problem "![](images/3c/3c2035d50b823b9bcbeb3ae8cf698df9a25c95a289c5a6f35054269dc920088d.png)\n\nConsider the vector field $F$ shown above, and let $C$ be the path where the curve is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0\n$$\n\nII. $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r<0\n$$\n\nIII. $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r>0\n$$" :question/worked-solution "Remember that $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r\n$$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0.\n$$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r<0.\n$$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true, while statement II is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/df/dfec76b47e8508a57e18440a72986bcae8e2bd19559bd0915ea4530e0b08b4f6.png)\n\n \nSo, $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r>0.\n$$\n\n- Statement III is false. It's clear from the picture below that if we reverse the orientation of $C,$ then $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/58/58e3efc39d0aee02d14e7c80c7355c37a1f28b6f0f54ff7102553e3a6ffc17cf.png)\n\n \nSo, $$\n\\displaystyle {\\int }_{-C}F\\cdot \\text{d}r<0.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186535937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed12692-e337-5916-a234-aaa8ffd8cb1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e-{e}^{3}}{3}" :db/id #edb/ref 17592186535482} {:answer/id #uuid "50bbae27-58bd-5797-8bfa-c17fe6627c78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1-{e}^{6}}{3{e}^{2}}" :db/id #edb/ref 17592186535558} {:answer/id #uuid "7c336942-42ac-5381-b315-51098c5b5b35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3-2{e}^{6}}{2{e}^{2}}" :db/id #edb/ref 17592186535627} {:answer/id #uuid "9944fc8f-2117-5170-b12f-702d4177c803" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3e-{e}^{3}}{2}" :db/id #edb/ref 17592186535677} {:answer/id #uuid "ea10fa2d-ab40-54c3-a266-d1a7f2cd6885" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2-{e}^{4}}{3{e}^{2}}" :db/id #edb/ref 17592186535796}] :answer-field/correct {:db/id #edb/ref 17592186535558} :answer-field/id #uuid "4daaebdb-5eac-5f4d-bcbe-069ee00fd432" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535858}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1c089741-5544-5275-8ceb-bbd95cf5e4fe" :question/math-academy-id "q-124659" :question/problem "If the path $C$ is the line segment $\\overset{―}{MN}$ traversed from the point $M(1,3)$ to the point $N(3,-1),$ then $$\n\\displaystyle {\\int }_{C}{e}^{x-y}\\,dx+{e}^{x-y}\\,dy=\n$$" :question/worked-solution "The position vectors of the endpoints of our line segment are $a=i+3\\,j$ and $b=3\\,i-j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+3\\,j+t(3\\,i-j-(i+3\\,j)) \\\\  & =i+3\\,j+t(2\\,i-4\\,j) \\\\  & =(2t+1)\\,i+(3-4t)\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t+1$ and $y(t)=3-4t$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2\\,i-4\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x-y}\\,dx+{e}^{x-y}\\,dy & ={\\int }_{0}^{1}{e}^{x-y}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+{e}^{x-y}\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}{e}^{x-y}(\\frac{\\text{d}x}{\\text{d}t}+\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{2t+1-(3-4t)}(2+(-4))\\,\\text{d}t \\\\  & =-2{\\int }_{0}^{1}{e}^{6t-2}\\,\\text{d}t \\\\  & =-\\frac{1}{3}{e}^{6t-2}\\,{|}_{0}^{1} \\\\  & =-\\frac{1}{3}[{e}^{6(1)-2}-{e}^{6(0)-2}] \\\\  & =-\\frac{1}{3}[{e}^{4}-\\frac{1}{{e}^{2}}] \\\\  & =\\frac{1-{e}^{6}}{3{e}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fd21d2-40f2-5b58-913c-e84aa062ff61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡2+2}{3}" :db/id #edb/ref 17592186535439} {:answer/id #uuid "37db0990-fced-5795-aeb4-f498e0afce12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡3+1}{2}" :db/id #edb/ref 17592186535520} {:answer/id #uuid "54aca898-1a55-5bcb-8d3f-340b7f07bc20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\operatorname{ln}⁡2+3}{2}" :db/id #edb/ref 17592186535567} {:answer/id #uuid "57595cac-95b5-5f6d-b989-b8d5bdf94881" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\operatorname{ln}⁡3+2}{3}" :db/id #edb/ref 17592186535574} {:answer/id #uuid "c512d8f7-5585-5111-bc8a-cb18cd5fde29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡2+3}{4}" :db/id #edb/ref 17592186535733}] :answer-field/correct {:db/id #edb/ref 17592186535574} :answer-field/id #uuid "cee9f237-ef40-55b1-b748-bc0ff7960913" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535909}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e6367608-0b6c-56a6-854c-a12592ac7a14" :question/math-academy-id "q-124662" :question/problem "If the path $C$ is the line segment $\\overset{―}{MN}$ traversed from the point $M(1,1)$ to the point $N(3,3),$ then $$\n\\displaystyle {\\int }_{C}\\frac{1}{y}\\,dx+\\frac{1}{{x}^{2}}\\,dy=\n$$" :question/worked-solution "The position vectors of the endpoints of our line segment are $a=i+j$ and $b=3\\,i+3\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+j+t(3\\,i+3\\,j-(i+j)) \\\\  & =i+j+t(2\\,i+2\\,j) \\\\  & =(2t+1)\\,i+(2t+1)\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t+1$ and $y(t)=2t+1$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2\\,i+2\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{1}{y}\\,dx+\\frac{1}{{x}^{2}}\\,dy & ={\\int }_{0}^{1}\\frac{1}{y}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+\\frac{1}{{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(\\frac{1}{y}\\,\\frac{\\text{d}x}{\\text{d}t}+\\frac{1}{{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}\\frac{1}{2t+1}\\cdot 2+\\frac{1}{(2t+1)^{2}}\\cdot 2\\,dt \\\\  & ={[\\operatorname{ln}⁡(2t+1)-\\frac{1}{2t+1}]}_{0}^{1} \\\\  & =[\\operatorname{ln}⁡(2\\cdot 1+1)-\\frac{1}{2\\cdot 1+1}]-[\\operatorname{ln}⁡(2\\cdot 0+1)-\\frac{1}{2\\cdot 0+1}] \\\\  & =\\operatorname{ln}⁡3-\\frac{1}{3}+1 \\\\  & =\\operatorname{ln}⁡3+\\frac{2}{3} \\\\  & =\\frac{3\\operatorname{ln}⁡3+2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abe0b0c-c7b6-54cc-89f5-b4e8765eb5d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{C}(yz+xz)\\,\\text{d}x\\,\\text{d}y+xy\\,\\text{d}z" :db/id #edb/ref 17592186536304} {:answer/id #uuid "9d2c9102-5369-5ba0-ac8a-916120320f57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{C}yz\\,\\text{d}x+(xz+xy)\\,\\text{d}y\\,\\text{d}z" :db/id #edb/ref 17592186536537} {:answer/id #uuid "ae0c8d28-d367-5e4a-9fc3-ee267494558a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{C}x\\,\\text{d}x+y\\,\\text{d}y+z\\,\\text{d}z" :db/id #edb/ref 17592186536563} {:answer/id #uuid "c30515bc-7147-5e35-a4a6-aa22b4d891de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{C}yz\\,\\text{d}x+xz\\,\\text{d}y+xy\\,\\text{d}z" :db/id #edb/ref 17592186536592} {:answer/id #uuid "e80d1d5b-0eef-53d7-9609-23206eeed2a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{C}(yz+xy+xy)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z" :db/id #edb/ref 17592186536646}] :answer-field/correct {:db/id #edb/ref 17592186536592} :answer-field/id #uuid "5f8c40bf-0ce0-5cf0-89dd-16aa652b7225" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536742}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b7927a26-b99a-5854-aa75-916116f0bbc7" :question/math-academy-id "q-125411" :question/problem "Let $F(x,y,z)=yz\\,i+xz\\,j+xy\\,k$ and let $C$ be a path in ${R}^{3}.$ Which of the following is equivalent to $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r?\n$$" :question/worked-solution "Given a piecewise-smooth path $C$ and a vector field \n\n$$\nF(x,y,z)=P(x,y,z)\\,i+Q(x,y,z)\\,j+R(x,y,z)\\,k\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{C}P(x,y,z)\\,\\text{d}x+Q(x,y,z)\\,\\text{d}y+R(x,y,z)\\,\\text{d}z.\n$$\n\nTherefore, in our case, we obtain \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{C}yz\\,\\text{d}x+xz\\,\\text{d}y+xy\\,\\text{d}z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6863e39b-e96c-5223-ae3e-ba8869732589" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + y + 4=0" :db/id #edb/ref 17592186537106} {:answer/id #uuid "6b145348-ee6b-5f83-a834-3612b52a8eea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0" :db/id #edb/ref 17592186537108} {:answer/id #uuid "80ba4577-cc56-5b55-8175-ebe29a27f6d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y + 4=0" :db/id #edb/ref 17592186537109} {:answer/id #uuid "b325fe0e-0f75-587e-9349-5774ff912b6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186537118} {:answer/id #uuid "dd9a8ba1-c9eb-55d2-9075-41f1ca7b26a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + 4=0" :db/id #edb/ref 17592186537126}] :answer-field/correct {:db/id #edb/ref 17592186537118} :answer-field/id #uuid "aec42275-f52a-5401-85f4-ec74b7d1f15d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537115}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "00382f0d-ea9b-5110-b24f-8be62b8690a5" :question/problem "Consider the plane curve $x^{2} + y^{2}=16.$  Find the equation of the normal line to the curve at the point $(-4,0).$" :question/worked-solution "If we set $f(x,y)=x^{2} + y^{2}$, our curve can be viewed as the level curve $f(x,y)=16.$  \n\nA normal vector to the level curve that passes through the point $(-4,0)$ can be found by computing $∇f(-4,0).$ \n\nSo, we find the gradient and evaluate it at $(-4,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(x^{2} + y^{2})\\,i+\\frac{∂}{∂y}(x^{2} + y^{2})\\,j \\\\  & =(2 x)\\,i+(2 y)\\,j \\\\ ∇f(-4,0) & =(2 (-4))\\,i+(2 (0))\\,j \\\\  & =(-8)\\,i+(0)\\,j \\\\  & =⟨-8,0⟩\\end{aligned}\n$$\n\nHence, $∇f(-4,0)=⟨-8,0⟩$ is a normal vector to the curve at $(-4,0).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}(x-{x}_{0}){v}_{y}-(y-{y}_{0}){v}_{x} & =0 \\\\ (x-(-4))(0)-(y-(0))(-8) & =0 \\\\ 8 y & =0 \\\\ y & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a4413af-f625-5560-8d8d-c748e370cbfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 x + 3 y + 1=0" :db/id #edb/ref 17592186537088} {:answer/id #uuid "23d11206-9bb2-5dc4-b264-7e984cd3988a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x + 3 y + 1=0" :db/id #edb/ref 17592186537091} {:answer/id #uuid "2fac1bf6-c07f-518f-9bf8-a2eae2be9292" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x - 4 y - 7=0" :db/id #edb/ref 17592186537093} {:answer/id #uuid "69d7288d-a2cb-577d-9da4-2fdb78119565" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x + 3 y=0" :db/id #edb/ref 17592186537107} {:answer/id #uuid "f62649f5-52ed-5959-9607-46e5d37163e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x + 3 y - 1=0" :db/id #edb/ref 17592186537129}] :answer-field/correct {:db/id #edb/ref 17592186537129} :answer-field/id #uuid "23e7d9c2-c40a-577f-94ad-5274d43663ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537092}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c33c871-3aa8-55d7-b3c4-b164edfa69d7" :question/problem "Consider the plane curve $3 x^{2} + 4 y^{2}=7.$  Find the equation of the normal line to the curve at the point $(1,-1).$" :question/worked-solution "If we set $f(x,y)=3 x^{2} + 4 y^{2}$, our curve can be viewed as the level curve $f(x,y)=7.$  \n\nA normal vector to the level curve that passes through the point $(1,-1)$ can be found by computing $∇f(1,-1).$ \n\nSo, we find the gradient and evaluate it at $(1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(3 x^{2} + 4 y^{2})\\,i+\\frac{∂}{∂y}(3 x^{2} + 4 y^{2})\\,j \\\\  & =(6 x)\\,i+(8 y)\\,j \\\\ ∇f(1,-1) & =(6 (1))\\,i+(8 (-1))\\,j \\\\  & =(6)\\,i+(-8)\\,j \\\\  & =⟨6,-8⟩\\end{aligned}\n$$\n\nHence, $∇f(1,-1)=⟨6,-8⟩$ is a normal vector to the curve at $(1,-1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(1)}{6} & =\\frac{y-(-1)}{-8} \\\\ (-8)(x-(1)) & =(6)(y-(-1)) \\\\ (-4)(x-(1)) & =(3)(y-(-1)) \\\\ 4 - 4 x & =3 y + 3 \\\\ 4 x + 3 y - 1 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b082478-c820-5762-b2a2-2a62271a3ef2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x + y - 2=0" :db/id #edb/ref 17592186537089} {:answer/id #uuid "982c2d81-f814-5d6a-aa38-881e92050088" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 x + y=0" :db/id #edb/ref 17592186537111} {:answer/id #uuid "ba020276-b69d-5fef-ba06-976da1e22be0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x - 4 y - 9=0" :db/id #edb/ref 17592186537120} {:answer/id #uuid "c6454838-da94-524c-851e-653529507ee9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x + y + 2=0" :db/id #edb/ref 17592186537124} {:answer/id #uuid "d9fe04c2-63a3-5665-902d-743af1759e1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x + y=0" :db/id #edb/ref 17592186537125}] :answer-field/correct {:db/id #edb/ref 17592186537089} :answer-field/id #uuid "af862b75-ced5-50a1-9df7-adc532c40789" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537116}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3df1a962-28ed-5ee8-927b-1c62b88a956c" :question/problem "Consider the plane curve $x^{2} + 2 y^{2}=9.$  Find the equation of the normal line to the curve at the point $(1,-2).$" :question/worked-solution "If we set $f(x,y)=x^{2} + 2 y^{2}$, our curve can be viewed as the level curve $f(x,y)=9.$  \n\nA normal vector to the level curve that passes through the point $(1,-2)$ can be found by computing $∇f(1,-2).$ \n\nSo, we find the gradient and evaluate it at $(1,-2):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(x^{2} + 2 y^{2})\\,i+\\frac{∂}{∂y}(x^{2} + 2 y^{2})\\,j \\\\  & =(2 x)\\,i+(4 y)\\,j \\\\ ∇f(1,-2) & =(2 (1))\\,i+(4 (-2))\\,j \\\\  & =(2)\\,i+(-8)\\,j \\\\  & =⟨2,-8⟩\\end{aligned}\n$$\n\nHence, $∇f(1,-2)=⟨2,-8⟩$ is a normal vector to the curve at $(1,-2).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(1)}{2} & =\\frac{y-(-2)}{-8} \\\\ (-8)(x-(1)) & =(2)(y-(-2)) \\\\ (-4)(x-(1)) & =(1)(y-(-2)) \\\\ 4 - 4 x & =y + 2 \\\\ 4 x + y - 2 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03eb4c04-9267-59ba-b869-c90be23347ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x - 8 y - 18=0" :db/id #edb/ref 17592186537086} {:answer/id #uuid "359c18da-2dc4-518a-a5c0-cd5436006e5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x - 4 y - 6=0" :db/id #edb/ref 17592186537095} {:answer/id #uuid "50911ebd-2e23-5084-9d41-757a96a08045" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x + 3 y + 17=0" :db/id #edb/ref 17592186537102} {:answer/id #uuid "9de33a7f-b967-5eba-9785-13d2ae9d81f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x - 4 y + 6=0" :db/id #edb/ref 17592186537112} {:answer/id #uuid "bc0db264-9ef6-5c62-ae91-dd6cc4a6e716" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x - 4 y=0" :db/id #edb/ref 17592186537121}] :answer-field/correct {:db/id #edb/ref 17592186537095} :answer-field/id #uuid "3b978872-a86e-5385-abda-6a0fbfd634ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537096}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3df7d364-776e-5dbb-9f2e-436f4e9fc804" :question/problem "Consider the plane curve $2 x^{2} + y^{2}=17.$  Find the equation of the normal line to the curve at the point $(-2,-3).$" :question/worked-solution "If we set $f(x,y)=2 x^{2} + y^{2}$, our curve can be viewed as the level curve $f(x,y)=17.$  \n\nA normal vector to the level curve that passes through the point $(-2,-3)$ can be found by computing $∇f(-2,-3).$ \n\nSo, we find the gradient and evaluate it at $(-2,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2 x^{2} + y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} + y^{2})\\,j \\\\  & =(4 x)\\,i+(2 y)\\,j \\\\ ∇f(-2,-3) & =(4 (-2))\\,i+(2 (-3))\\,j \\\\  & =(-8)\\,i+(-6)\\,j \\\\  & =⟨-8,-6⟩\\end{aligned}\n$$\n\nHence, $∇f(-2,-3)=⟨-8,-6⟩$ is a normal vector to the curve at $(-2,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(-2)}{-8} & =\\frac{y-(-3)}{-6} \\\\ (-6)(x-(-2)) & =(-8)(y-(-3)) \\\\ (-3)(x-(-2)) & =(-4)(y-(-3)) \\\\ - 3 x - 6 & =- 4 y - 12 \\\\ 3 x - 4 y - 6 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "330917b2-cba0-53ab-910e-6eea81df6b75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + 3 y + 6=0" :db/id #edb/ref 17592186537094} {:answer/id #uuid "5c6fd1dd-a919-51be-b894-113cc9ed93f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + 3 y=0" :db/id #edb/ref 17592186537104} {:answer/id #uuid "b2cb4d5b-4b25-55eb-9856-78437bedb5e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x - y - 12=0" :db/id #edb/ref 17592186537117} {:answer/id #uuid "f04fc7c8-e4a1-58fb-9dcc-daf30680e84a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + 3 y - 6=0" :db/id #edb/ref 17592186537128} {:answer/id #uuid "fb695a72-da41-5585-8fc0-51f517403af8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + 6 y + 15=0" :db/id #edb/ref 17592186537132}] :answer-field/correct {:db/id #edb/ref 17592186537094} :answer-field/id #uuid "031f356f-2821-5db9-9c7a-f7890bd14e91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537085}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a06355a9-e2d0-5a7e-bed1-e1b39de7ef4e" :question/problem "Consider the plane curve $3 x^{2} + y^{2}=36.$  Find the equation of the normal line to the curve at the point $(3,-3).$" :question/worked-solution "If we set $f(x,y)=3 x^{2} + y^{2}$, our curve can be viewed as the level curve $f(x,y)=36.$  \n\nA normal vector to the level curve that passes through the point $(3,-3)$ can be found by computing $∇f(3,-3).$ \n\nSo, we find the gradient and evaluate it at $(3,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(3 x^{2} + y^{2})\\,i+\\frac{∂}{∂y}(3 x^{2} + y^{2})\\,j \\\\  & =(6 x)\\,i+(2 y)\\,j \\\\ ∇f(3,-3) & =(6 (3))\\,i+(2 (-3))\\,j \\\\  & =(18)\\,i+(-6)\\,j \\\\  & =⟨18,-6⟩\\end{aligned}\n$$\n\nHence, $∇f(3,-3)=⟨18,-6⟩$ is a normal vector to the curve at $(3,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(3)}{18} & =\\frac{y-(-3)}{-6} \\\\ (-6)(x-(3)) & =(18)(y-(-3)) \\\\ (-1)(x-(3)) & =(3)(y-(-3)) \\\\ 3 - x & =3 y + 9 \\\\ x + 3 y + 6 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df7a5cf-c5ee-5d5d-bbcf-a92c76ab4ef5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x + 4 y - 9=0" :db/id #edb/ref 17592186537090} {:answer/id #uuid "3be2a23d-ef2c-595f-9cf8-9a45f0a1d019" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x + 2 y - 3=0" :db/id #edb/ref 17592186537097} {:answer/id #uuid "5b126564-37ea-568a-a5ff-6329c3df1cc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x + 2 y=0" :db/id #edb/ref 17592186537103} {:answer/id #uuid "6061ce51-b351-522a-bca9-76aa11187e78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x + 2 y + 3=0" :db/id #edb/ref 17592186537105} {:answer/id #uuid "884d0d51-859f-5fea-96a9-8818c3c7184f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 x - 3 y + 11=0" :db/id #edb/ref 17592186537110}] :answer-field/correct {:db/id #edb/ref 17592186537097} :answer-field/id #uuid "a3e69355-4465-5521-9779-bce1af127a1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537114}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c34c8b85-1410-5a9f-8287-4a3353c69bd2" :question/problem "Consider the plane curve $4 x^{2} + 2 y^{2}=22.$  Find the equation of the normal line to the curve at the point $(-1,3).$" :question/worked-solution "If we set $f(x,y)=4 x^{2} + 2 y^{2}$, our curve can be viewed as the level curve $f(x,y)=22.$  \n\nA normal vector to the level curve that passes through the point $(-1,3)$ can be found by computing $∇f(-1,3).$ \n\nSo, we find the gradient and evaluate it at $(-1,3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(4 x^{2} + 2 y^{2})\\,i+\\frac{∂}{∂y}(4 x^{2} + 2 y^{2})\\,j \\\\  & =(8 x)\\,i+(4 y)\\,j \\\\ ∇f(-1,3) & =(8 (-1))\\,i+(4 (3))\\,j \\\\  & =(-8)\\,i+(12)\\,j \\\\  & =⟨-8,12⟩\\end{aligned}\n$$\n\nHence, $∇f(-1,3)=⟨-8,12⟩$ is a normal vector to the curve at $(-1,3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(-1)}{-8} & =\\frac{y-(3)}{12} \\\\ (12)(x-(-1)) & =(-8)(y-(3)) \\\\ (3)(x-(-1)) & =(-2)(y-(3)) \\\\ 3 x + 3 & =6 - 2 y \\\\ 3 x + 2 y - 3 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1898e89d-7f9b-5658-8c51-d493fe024120" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186537087} {:answer/id #uuid "4ea7e0b2-048d-501b-8ce8-6a30e5846097" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y + 3=0" :db/id #edb/ref 17592186537101} {:answer/id #uuid "b85cdbbd-f0a1-5380-b88e-05b490cd1b40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0" :db/id #edb/ref 17592186537119} {:answer/id #uuid "c5f676ce-6f87-51f1-a05e-777980795d5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + 3=0" :db/id #edb/ref 17592186537123} {:answer/id #uuid "e5db7b26-9071-561e-8c30-3a00b00da0a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x + y + 3=0" :db/id #edb/ref 17592186537127}] :answer-field/correct {:db/id #edb/ref 17592186537087} :answer-field/id #uuid "fa7f8d9d-bf5e-5054-b7fc-6882417c0d5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537131}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fa107303-abd7-5cc9-bd95-cc8524938adb" :question/problem "Consider the plane curve $\\frac{x^{2}}{9} + y^{2}=1.$  Find the equation of the normal line to the curve at the point $(-3,0).$" :question/worked-solution "If we set $f(x,y)=\\frac{x^{2}}{9} + y^{2}$, our curve can be viewed as the level curve $f(x,y)=1.$  \n\nA normal vector to the level curve that passes through the point $(-3,0)$ can be found by computing $∇f(-3,0).$ \n\nSo, we find the gradient and evaluate it at $(-3,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\frac{x^{2}}{9} + y^{2})\\,i+\\frac{∂}{∂y}(\\frac{x^{2}}{9} + y^{2})\\,j \\\\  & =\\left(\\frac{2 x}{9}\\right)\\,i+(2 y)\\,j \\\\ ∇f(-3,0) & =\\left(\\frac{2 (-3)}{9}\\right)\\,i+(2 (0))\\,j \\\\  & =\\left(- \\frac{2}{3}\\right)\\,i+(0)\\,j \\\\  & =⟨- \\frac{2}{3},0⟩\\end{aligned}\n$$\n\nHence, $∇f(-3,0)=⟨- \\frac{2}{3},0⟩$ is a normal vector to the curve at $(-3,0).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}(x-{x}_{0}){v}_{y}-(y-{y}_{0}){v}_{x} & =0 \\\\ (x-(-3))(0)-(y-(0))\\left(- \\frac{2}{3}\\right) & =0 \\\\ \\frac{2 y}{3} & =0 \\\\ y & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fce93da-e871-5c72-9d09-6eb4bf2aae2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186537394} {:answer/id #uuid "5a4b60e3-cd37-51c5-b631-37359cad927c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-64" :db/id #edb/ref 17592186537411} {:answer/id #uuid "7ae15837-c155-5657-9cbb-e2ad0a708b49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-32" :db/id #edb/ref 17592186537470} {:answer/id #uuid "cb15f9d8-3a05-5c26-bc50-d85a868e79fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186537625} {:answer/id #uuid "e63d7042-0452-51d5-8e47-47acba03407b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186537697}] :answer-field/correct {:db/id #edb/ref 17592186537411} :answer-field/id #uuid "a8f6c78e-2502-540d-9f7b-11049bb63129" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537838}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7933960a-e5cd-5862-9088-b9c1f61b494c" :question/math-academy-id "q-226103" :question/problem "![](images/32/321c16127ae1999e4ec42024f35cd076930618588fe378b9ca16a4ee4eabd58a.png)\n\nConsider the vector field $F=-0.5x\\,i-0.5y\\,j$ and a square $C$ with side length $8$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across all four sides of the square.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/ab/abe90a592e098a4656577f3a2303669dccc126baff738397836c8f96c26b5389.png)\n\nFirst, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-0.5x\\,i-0.5y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-0.5{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=4\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-4,4].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-0.5{\\int }_{{C}_{1}}x\\,\\text{d}s & =-0.5{\\int }_{-4}^{4}4\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-2{\\int }_{-4}^{4}\\text{d}t \\\\  & =-2(4-(-4)) \\\\  & =(-2)\\cdot 8 \\\\  & =-16.\\end{aligned}\n$$\n\nBy symmetry, the flux integrals over the sides ${C}_{2},{C}_{3},$ and ${C}_{4}$ must be the same. Therefore,\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=4\\cdot (-16)=-64.\n$$"}] [{:db/id #edb/ref 17592186537939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1add2c2e-a167-5c2c-b545-a5f1eb517140" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186537284} {:answer/id #uuid "28b45251-3b7f-5715-8789-20bd83838a64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186537309} {:answer/id #uuid "91c49acb-1fa6-5ddc-9050-3b83a7f4c764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186537504} {:answer/id #uuid "ba10258f-f51b-5e95-9c08-2bf569bcb880" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186537591} {:answer/id #uuid "d3235a30-a18e-50b4-a05b-6c1309b09270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186537643}] :answer-field/correct {:db/id #edb/ref 17592186537284} :answer-field/id #uuid "8bc18207-a6fd-5437-a68d-b3d6fef6d67e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537815}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "90bd3eab-412f-52dc-83f5-2f8877931db1" :question/math-academy-id "q-127193" :question/problem "![](images/32/32d4722f4a1dd1cfae3fb22cde7399dcb66623e484bcd5989fd2de246a905b51.png)\n\nConsider the vector field $F=-3\\,j$ and a square $C$ with side length $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/3b/3bd953b7fb02b90a55a29bea6f58ff9bd8bab77d62b1df1c547ca899656d37a3.png)\n\nNow, since the vector field $F=-3\\,j$ is parallel to ${C}_{1}$ and ${C}_{3},$ there is zero net flow through these two sides. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=0.\n$$\n\nSo, our expression for the flux reduces to\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s.\n$$\n\nNow, since the vector field is uniform, the net inflow through ${C}_{2}$ will cancel with the net outflow through ${C}_{4}.$ That is\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s=-{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s\\,⟹\\,{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=0.\n$$\n\nTherefore, we conclude that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=0.\n$$"}]}
