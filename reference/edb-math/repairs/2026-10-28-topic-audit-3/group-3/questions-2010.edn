#{[{:db/id #edb/ref 17592186693906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e1b88c8-541c-545b-a454-3f5affa928b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16 x \\operatorname{sin}{(x )}+4 \\operatorname{cos}{(x )}+C" :db/id #edb/ref 17592186693907} {:answer/id #uuid "2700ad5e-c837-57d7-9341-d849c9444445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16 x \\operatorname{sin}{(x )}+\\operatorname{cos}{(x )}+C" :db/id #edb/ref 17592186693912} {:answer/id #uuid "b670c128-0083-5d0f-9c92-82612640cdb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x \\operatorname{sin}{(x )}+16 \\operatorname{cos}{(x )}+C" :db/id #edb/ref 17592186693933} {:answer/id #uuid "d29936a2-f45e-5fbd-9efc-a20473250ddc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x \\operatorname{sin}{(x )}+4 \\operatorname{cos}{(x )}+C" :db/id #edb/ref 17592186693935} {:answer/id #uuid "f444d0ad-fb36-52b6-9869-6123ada215db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x \\operatorname{sin}{(x )}+\\operatorname{cos}{(x )}+C" :db/id #edb/ref 17592186693939}] :answer-field/correct {:db/id #edb/ref 17592186693935} :answer-field/id #uuid "990f8d6f-2215-560c-8003-41d5671230d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693928}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "091220e8-625c-54b0-9a64-91384f985f9f" :question/problem "Calculate $$\n\\int 4 x\\operatorname{cos}(x)\\,\\text{d}x.\n$$" :question/worked-solution "Write $I=\\int 4 x\\operatorname{cos}(x)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =4 x \\\\ u^{\\prime} & =4 \\\\ v^{\\prime} & =\\operatorname{cos}(x) \\\\ v & =\\operatorname{sin}(x)\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =4 x\\left(\\operatorname{sin}(x)\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(\\operatorname{sin}(x)\\right)4\\,\\text{d}x\\end{aligned}\n$$\n\nEvaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =4 x\\operatorname{sin}(x)-4\\int \\operatorname{sin}(x)\\,\\text{d}x \\\\  & =4 x\\operatorname{sin}(x)-4(-\\operatorname{cos}(x))+C \\\\  & =4 x\\operatorname{sin}(x)+4\\operatorname{cos}(x)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186693917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "176475d1-b4fd-5c1b-b37b-4ea09414f5c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x \\operatorname{cos}{(x )}+\\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693910} {:answer/id #uuid "3e75540c-cfee-52c6-830d-8b29a2e56a21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- x \\operatorname{cos}{(x )}+2 \\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693915} {:answer/id #uuid "82fe6589-a7cc-5777-bb90-0cc9c2996954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x \\operatorname{cos}{(x )}+2 \\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693924} {:answer/id #uuid "9940dcd0-f6fc-5366-b7bf-961090001817" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x \\operatorname{cos}{(x )}+\\frac{\\operatorname{sin}{(x )}}{2}+C" :db/id #edb/ref 17592186693929} {:answer/id #uuid "b1fd5684-ad5a-5490-a366-79ef9b1e5725" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- x \\operatorname{cos}{(x )}+\\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693931}] :answer-field/correct {:db/id #edb/ref 17592186693931} :answer-field/id #uuid "4afcc0bf-3aba-520e-b67a-aef0a5515c00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693916}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4bba3ad9-c1ce-5fc6-bb50-b500dd56f77b" :question/problem "Calculate $$\n\\int x\\operatorname{sin}(x)\\,\\text{d}x.\n$$" :question/worked-solution "Write $I=\\int x\\operatorname{sin}(x)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =x \\\\ u^{\\prime} & =1 \\\\ v^{\\prime} & =\\operatorname{sin}(x) \\\\ v & =-\\operatorname{cos}(x)\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =x\\left(-\\operatorname{cos}(x)\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(-\\operatorname{cos}(x)\\right)1\\,\\text{d}x\\end{aligned}\n$$\n\nEvaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =-x\\operatorname{cos}(x)+\\int \\operatorname{cos}(x)\\,\\text{d}x \\\\  & =-x\\operatorname{cos}(x)+(\\operatorname{sin}(x))+C \\\\  & =-x\\operatorname{cos}(x)+\\operatorname{sin}(x)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186693918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbf3b1f-1c20-54a0-aa8c-6a741efdce9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 6 x \\operatorname{cos}{(x )}- 6 \\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693908} {:answer/id #uuid "24087e23-21eb-5cc0-952e-c5ae70c1d518" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 36 x \\operatorname{cos}{(x )}+6 \\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693911} {:answer/id #uuid "58c93266-5735-5b4f-ad40-a57b6e9b364e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- x \\operatorname{cos}{(x )}- 6 \\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693919} {:answer/id #uuid "85a040f3-ce85-5fb8-a277-713c37815088" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 6 x \\operatorname{cos}{(x )}+6 \\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693925} {:answer/id #uuid "ee162c45-a71f-530b-8e29-02e35c6c2b6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 36 x \\operatorname{cos}{(x )}- 6 \\operatorname{sin}{(x )}+C" :db/id #edb/ref 17592186693938}] :answer-field/correct {:db/id #edb/ref 17592186693925} :answer-field/id #uuid "8c7ca758-d72f-52f6-a949-8e702c7ba87e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693926}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f5b27d1-76c1-5ba8-ac3e-11bb12357480" :question/problem "Calculate $$\n\\int 6 x\\operatorname{sin}(x)\\,\\text{d}x.\n$$" :question/worked-solution "Write $I=\\int 6 x\\operatorname{sin}(x)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =6 x \\\\ u^{\\prime} & =6 \\\\ v^{\\prime} & =\\operatorname{sin}(x) \\\\ v & =-\\operatorname{cos}(x)\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =6 x\\left(-\\operatorname{cos}(x)\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(-\\operatorname{cos}(x)\\right)6\\,\\text{d}x\\end{aligned}\n$$\n\nEvaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =-6 x\\operatorname{cos}(x)+6\\int \\operatorname{cos}(x)\\,\\text{d}x \\\\  & =-6 x\\operatorname{cos}(x)+6(\\operatorname{sin}(x))+C \\\\  & =-6 x\\operatorname{cos}(x)+6\\operatorname{sin}(x)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186693922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b1914fc-8cff-581d-af04-0a73c1aebfd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9 x \\operatorname{cos}{(2 x )}}{2}+\\frac{9 \\operatorname{sin}{(2 x )}}{4}+C" :db/id #edb/ref 17592186693920} {:answer/id #uuid "61ceb443-d8b6-592a-83ff-e41b6bd93624" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9 x \\operatorname{cos}{(2 x )}}{4}+\\frac{9 \\operatorname{sin}{(2 x )}}{8}+C" :db/id #edb/ref 17592186693921} {:answer/id #uuid "b3ce32fa-0240-51a8-b02e-103de5bfa9ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 9 x \\operatorname{cos}{(2 x )}+\\frac{9 \\operatorname{sin}{(2 x )}}{2}+C" :db/id #edb/ref 17592186693932} {:answer/id #uuid "ce8eb239-098e-56b4-9ead-1d9dd2963b6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 9 x \\operatorname{cos}{(2 x )}+\\frac{9 \\operatorname{sin}{(2 x )}}{4}+C" :db/id #edb/ref 17592186693934} {:answer/id #uuid "e9dc4fbe-14ec-5ec8-929f-2a50aef5b9e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9 x \\operatorname{cos}{(2 x )}}{2}+\\frac{9 \\operatorname{sin}{(2 x )}}{2}+C" :db/id #edb/ref 17592186693937}] :answer-field/correct {:db/id #edb/ref 17592186693920} :answer-field/id #uuid "3df000a1-b017-5159-9527-8ca87bec0a0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693914}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73479ef6-4130-58cf-a60f-903efe5e0ac7" :question/problem "$$\n\\int 9 x\\operatorname{sin}(2 x)\\,\\text{d}x=\n$$" :question/worked-solution "Write $I=\\int 9 x\\operatorname{sin}(2 x)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =9 x \\\\ u^{\\prime} & =9 \\\\ v^{\\prime} & =\\operatorname{sin}(2 x) \\\\ v & =-\\frac{\\operatorname{cos}(2 x)}{2}\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =9 x\\left(-\\frac{\\operatorname{cos}(2 x)}{2}\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(-\\frac{\\operatorname{cos}(2 x)}{2}\\right)9\\,\\text{d}x\\end{aligned}\n$$\n\nEvaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =-\\frac{9 x\\operatorname{cos}(2 x)}{2}+\\frac{9\\int \\operatorname{cos}(2 x)\\,\\text{d}x}{2} \\\\  & =-\\frac{9 x\\operatorname{cos}(2 x)}{2}+\\frac{9\\left(\\frac{\\operatorname{sin}(2 x)}{2}\\right)}{2}+C \\\\  & =-\\frac{9 x\\operatorname{cos}(2 x)}{2}+\\frac{9\\operatorname{sin}(2 x)}{4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186693940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14ead871-24ed-5400-bae4-686f02541758" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x \\operatorname{sin}{(2 x )}+2 \\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693909} {:answer/id #uuid "7bf4cd93-9fed-58a9-943b-c0e085d82da6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 x \\operatorname{sin}{(2 x )}+2 \\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693923} {:answer/id #uuid "9352cd28-68cc-5b6c-8b78-baedf1c4be68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x \\operatorname{sin}{(2 x )}+\\frac{\\operatorname{cos}{(2 x )}}{2}+C" :db/id #edb/ref 17592186693927} {:answer/id #uuid "9a6dc913-4a71-5a81-bee1-95be3980c62e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 x \\operatorname{sin}{(2 x )}+\\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693930} {:answer/id #uuid "e7623f08-6cca-5666-957b-ab5f06a022d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x \\operatorname{sin}{(2 x )}+\\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693936}] :answer-field/correct {:db/id #edb/ref 17592186693909} :answer-field/id #uuid "3b561170-cb8e-5d99-8584-d067ea668ee9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693913}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbb1cdcc-77f5-5f31-9a8d-82fa47f0faa3" :question/problem "$$\n\\int 8 x\\operatorname{cos}(2 x)\\,\\text{d}x=\n$$" :question/worked-solution "Write $I=\\int 8 x\\operatorname{cos}(2 x)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =8 x \\\\ u^{\\prime} & =8 \\\\ v^{\\prime} & =\\operatorname{cos}(2 x) \\\\ v & =\\frac{\\operatorname{sin}(2 x)}{2}\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =8 x\\left(\\frac{\\operatorname{sin}(2 x)}{2}\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(\\frac{\\operatorname{sin}(2 x)}{2}\\right)8\\,\\text{d}x\\end{aligned}\n$$\n\nEvaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =\\frac{8 x\\operatorname{sin}(2 x)}{2}-4\\int \\operatorname{sin}(2 x)\\,\\text{d}x \\\\  & =\\frac{8 x\\operatorname{sin}(2 x)}{2}-4\\left(-\\frac{\\operatorname{cos}(2 x)}{2}\\right)+C \\\\  & =\\frac{8 x\\operatorname{sin}(2 x)}{2}+2\\operatorname{cos}(2 x)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186693948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6baa2743-362f-5fc4-9638-ecba52365759" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x \\operatorname{tan}{(x - 3 )}}{2}+\\frac{\\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}}{2}+C" :db/id #edb/ref 17592186693950} {:answer/id #uuid "93c156bd-2c8e-5069-b0a1-10646ad976e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 x \\operatorname{tan}{(x - 3 )}+2 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693955} {:answer/id #uuid "a4240e77-ada2-5a4c-b0ce-014a73d16791" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x \\operatorname{tan}{(x - 3 )}+\\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693959} {:answer/id #uuid "bbc38041-0ea7-5682-8dcd-0846ea516a11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x \\operatorname{tan}{(x - 3 )}}{2}+\\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693961} {:answer/id #uuid "ca3e7399-929c-5c17-ae4b-3ed4c24316f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x \\operatorname{tan}{(x - 3 )}+\\frac{\\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}}{2}+C" :db/id #edb/ref 17592186693964}] :answer-field/correct {:db/id #edb/ref 17592186693959} :answer-field/id #uuid "2e2e190d-9d0b-50ee-ab5d-dd2c69ebfa30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693945}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "44cc1dae-8ceb-5c00-8b98-963b26d9db55" :question/problem "Calculate $$\n\\int x\\operatorname{sec}^{2}(x - 3)\\,\\text{d}x.\n$$" :question/worked-solution "Write $I=\\int x\\operatorname{sec}^{2}(x - 3)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =x \\\\ u^{\\prime} & =1 \\\\ v^{\\prime} & =\\operatorname{sec}^{2}(x - 3) \\\\ v & =\\operatorname{tan}(x - 3)\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =x\\left(\\operatorname{tan}(x - 3)\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(\\operatorname{tan}(x - 3)\\right)1\\,\\text{d}x\\end{aligned}\n$$\n\nUse $t=\\operatorname{cos}(x - 3)$ and $\\mathrm{d}t=-\\operatorname{sin}(x - 3)\\,\\mathrm{d}x$. Evaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =x\\operatorname{tan}(x - 3)-\\int \\frac{\\operatorname{sin}(x - 3)}{\\operatorname{cos}(x - 3)}\\,\\text{d}x \\\\  & =x\\operatorname{tan}(x - 3)+\\int \\frac{1}{t}\\,\\text{d}t \\\\  & =x\\operatorname{tan}(x - 3)+\\ln|t|+C \\\\  & =x\\operatorname{tan}(x - 3)+\\ln|\\operatorname{cos}(x - 3)|+C\\end{aligned}\n$$\n\nThis holds on each interval where $\\operatorname{cos}(x - 3)\\ne0$."}] [{:db/id #edb/ref 17592186693957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21ad0f6c-9008-55e1-8aa8-64aa9c5de2d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 x \\operatorname{cot}{(x - 1 )}+2 \\ln{(|{\\operatorname{sin}{(x - 1 )}}| )}+C" :db/id #edb/ref 17592186693943} {:answer/id #uuid "311b89f7-97d7-5ce9-b5ed-ddefdbef9834" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 x \\operatorname{cot}{(x - 1 )}+2 \\ln{(|{\\operatorname{sin}{(x - 1 )}}| )}+C" :db/id #edb/ref 175921