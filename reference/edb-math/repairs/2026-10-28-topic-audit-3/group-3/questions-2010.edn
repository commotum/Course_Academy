(x - 1)}{\\operatorname{sin}(x - 1)}\\,\\text{d}x \\\\  & =-2 x\\operatorname{cot}(x - 1)+2\\int \\frac{1}{t}\\,\\text{d}t \\\\  & =-2 x\\operatorname{cot}(x - 1)+2\\ln|t|+C \\\\  & =-2 x\\operatorname{cot}(x - 1)+2\\ln|\\operatorname{sin}(x - 1)|+C\\end{aligned}\n$$\n\nThis holds on each interval where $\\operatorname{sin}(x - 1)\\ne0$."}] [{:db/id #edb/ref 17592186693958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08673960-afae-5ac2-93e2-94842a85adfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x \\operatorname{tan}{(x - 3 )}+27 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693942} {:answer/id #uuid "53cd5250-3135-5b2e-8211-48fc3f2afcf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x \\operatorname{tan}{(x - 3 )}+9 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693949} {:answer/id #uuid "b5e858e7-80e9-5dfd-ae50-3c2d1bf12d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 x \\operatorname{tan}{(x - 3 )}+3 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693960} {:answer/id #uuid "dbaf7982-e857-5ec0-ab03-67c241df3a4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 3 x \\operatorname{tan}{(x - 3 )}+9 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693967} {:answer/id #uuid "fdf98e88-1518-53f1-9714-0417f2929cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 3 x \\operatorname{tan}{(x - 3 )}+3 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693969}] :answer-field/correct {:db/id #edb/ref 17592186693960} :answer-field/id #uuid "74d5733e-d1cd-54a4-afa1-f0a8b244c7dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186693952}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9eb87a19-c5f8-5454-9a44-fac03e428a1e" :question/problem "Calculate $$\n\\int 3 x\\operatorname{sec}^{2}(x - 3)\\,\\text{d}x.\n$$" :question/worked-solution "Write $I=\\int 3 x\\operatorname{sec}^{2}(x - 3)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =3 x \\\\ u^{\\prime} & =3 \\\\ v^{\\prime} & =\\operatorname{sec}^{2}(x - 3) \\\\ v & =\\operatorname{tan}(x - 3)\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =3 x\\left(\\operatorname{tan}(x - 3)\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(\\operatorname{tan}(x - 3)\\right)3\\,\\text{d}x\\end{aligned}\n$$\n\nUse $t=\\operatorname{cos}(x - 3)$ and $\\mathrm{d}t=-\\operatorname{sin}(x - 3)\\,\\mathrm{d}x$. Evaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =3 x\\operatorname{tan}(x - 3)-3\\int \\frac{\\operatorname{sin}(x - 3)}{\\operatorname{cos}(x - 3)}\\,\\text{d}x \\\\  & =3 x\\operatorname{tan}(x - 3)+3\\int \\frac{1}{t}\\,\\text{d}t \\\\  & =3 x\\operatorname{tan}(x - 3)+3\\ln|t|+C \\\\  & =3 x\\operatorname{tan}(x - 3)+3\\ln|\\operatorname{cos}(x - 3)|+C\\end{aligned}\n$$\n\nThis holds on each interval where $\\operatorname{cos}(x - 3)\\ne0$."}] [{:db/id #edb/ref 17592186693966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23d43c5d-2565-5429-af83-3b404e66a274" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 x \\operatorname{cot}{(x - 3 )}+2 \\ln{(|{\\operatorname{sin}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693944} {:answer/id #uuid "349b9304-9d0a-552b-8fcf-620db8022aad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 x \\operatorname{cot}{(x - 3 )}+2 \\ln{(|{\\operatorname{sin}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693947} {:answer/id #uuid "89e09202-4622-5b84-b9c1-07184be1300d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 x \\operatorname{cot}{(x - 3 )}+4 \\ln{(|{\\operatorname{sin}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693954} {: