#{[{:db/id #edb/ref 17592186193907 :tutorial/content "We can also compute partial derivatives of functions with three or even more variables. \n\nFor example, suppose we have the function $f(x,y,z).$ We find its partial derivatives as follows:\n\n- To compute $\\dfrac{\\partial f}{\\partial x},$ we differentiate with respect to $x,$ treating $y$ *and* $z$ as constants.\n\n- To compute $\\dfrac{\\partial f}{\\partial y},$ we differentiate with respect to $y,$ treating $x$ *and* $z$ as constants.\n\n- To compute $\\dfrac{\\partial f}{\\partial z},$ we differentiate with respect to $z,$ treating $x$ *and* $y$ as constants.\n\nLet's see an example." :tutorial/id #uuid "c87e2fef-e77f-5c67-a502-0d900d85ee40" :tutorial/math-academy-id 7692 :tutorial/title "Partial Derivatives of Three-Variable Functions"}] [{:db/id #edb/ref 17592186198361 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198235} :knowledge-point/id #uuid "9fed8ac2-8d21-5bc9-b1cc-df20760cfbfb" :knowledge-point/title "Performing a Change of Variables"}] [{:db/id #edb/ref 17592186198373 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198015} :knowledge-point/id #uuid "cd546dda-c78f-5367-b03e-9b3acb420040" :knowledge-point/title "Cases When the Transformation Is Inferred From the Domain"}] [{:db/id #edb/ref 17592186198374 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198016} :knowledge-point/id #uuid "b2682751-23e4-5cf2-9a46-82c75765423f" :knowledge-point/title "Cases When the Transformation Is Inferred From the Integrand"}] [{:db/id #edb/ref 17592186198378 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198020} :knowledge-point/id #uuid "e9b46ce4-cfe0-5da6-bc91-65ae8c544393" :knowledge-point/title "Expressing Flux Through a Surface as a Double Integral"}] [{:db/id #edb/ref 17592186198380 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198022} :knowledge-point/id #uuid "f322cca7-7530-50bf-b262-89faa81f5906" :knowledge-point/title "Evaluating Flux Through a Surface"}] [{:db/id #edb/ref 17592186198397 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198039} :knowledge-point/id #uuid "a898f345-9210-5976-9a42-f415a0e7eaf5" :knowledge-point/title "Performing a Change of Variables in a Triple Integral"}] [{:db/id #edb/ref 17592186198398 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198040} :knowledge-point/id #uuid "832dc2b8-873f-56c6-bd87-5e886a586fb1" :knowledge-point/title "Evaluating a Triple Integral Using a Change of Variables"}] [{:db/id #edb/ref 17592186198399 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198041} :knowledge-point/id #uuid "a8a79d4e-f9e0-583e-8e52-aa60c14fd4a3" :knowledge-point/title "Computing the Volume of a Region Using a Change of Variables"}] [{:db/id #edb/ref 17592186198584}] [{:db/id #edb/ref 17592186198585}] [{:db/id #edb/ref 17592186198586}]}
