a11fe.png" :db/id #edb/ref 17592186171634} {:answer/id #uuid "bb6440c1-9147-5ac2-9a38-c145bc5403e2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e2/e2053309347d1a471b449745106de45c5932a9f6fed737a08a8150353f2b589a.png" :db/id #edb/ref 17592186171635} {:answer/id #uuid "fabfa234-8bf2-53a6-89ea-9f9e8e769fbb" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/07/07e822b78317e1bc18b5b7060ac867a200b60403ffe0b91eadad850efe865d55.png" :db/id #edb/ref 17592186171636} {:answer/id #uuid "3563f91c-c127-52a6-bc25-2af4533166cf" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ea/eaefe01eb97b7f03d9ca24f47263201b22b87cdb0453b98c65f07693f5afe741.png" :db/id #edb/ref 17592186171637} {:answer/id #uuid "451b0efb-73f1-58d5-84ba-01690e2c1afe" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9f/9fc470d0d317379f32576f92d9c16dc51e24184b448d11280193b949c08bee26.png" :db/id #edb/ref 17592186171638}] :answer-field/id #uuid "780b37f2-853f-5e38-ae71-8da9c83932bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186171633} {:answer-field/choices [{:answer/id #uuid "79d91382-9ab5-5467-a190-6adaf8506b75" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9f/9fc470d0d317379f32576f92d9c16dc51e24184b448d11280193b949c08bee26.png" :db/id #edb/ref 17592186395391} {:answer/id #uuid "87481517-9502-5307-8715-a2439483b0be" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ea/eaefe01eb97b7f03d9ca24f47263201b22b87cdb0453b98c65f07693f5afe741.png" :db/id #edb/ref 17592186395392} {:answer/id #uuid "ff7ba7a8-4b26-574e-aee8-2abdcfb69227" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2c/2cb6c81ea87d7299083a853f94f4238ce074b9ca553fa142bc3ef0b68f1a11fe.png" :db/id #edb/ref 17592186395393} {:answer/id #uuid "86bfb78b-8a3f-5bd8-bfe6-610461977ef2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e2/e2053309347d1a471b449745106de45c5932a9f6fed737a08a8150353f2b589a.png" :db/id #edb/ref 17592186395394} {:answer/id #uuid "04c399f1-df31-56df-9b13-7e3645c989ed" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/07/07e822b78317e1bc18b5b7060ac867a200b60403ffe0b91eadad850efe865d55.png" :db/id #edb/ref 17592186395395}] :answer-field/correct {:db/id #edb/ref 17592186395391} :answer-field/id #uuid "178eecae-8495-5623-a528-d940d6a47162" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186395390}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2eb47630-481d-5fa5-a91b-a7743799b27f" :question/math-academy-id "q-98035" :question/problem "Which of the following is *not* a simply connected region?" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nAmong the given options, the only one that does not satisfy this definition is the following:\n\n \n\n![](images/9a/9a001b71c984559199c1457115621dbd111c69da50f741332b2396ce832ede08.png)"}] [{:db/id #edb/ref 17592186172669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2132682-d892-5ab9-bb87-e66b51a6a1d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460499} {:answer/id #uuid "d9edf225-47eb-52d9-9236-490f3c6db5dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460500}] :answer-field/correct {:db/id #edb/ref 17592186460500} :answer-field/id #uuid "2118d6af-4ef2-578c-b102-d393d2fbeab2" :answer-field/key "![Region I](images/a1/a10ff6f49ddef971e1d0903606f7ec7e9854ca61f54b06628de30cc43f9eb084.svg)" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461116} {:answer-field/choices [{:answer/id #uuid "eccde749-8255-5674-80ee-42a42f6cfc7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460501} {:answer/id #uuid "28f51c6d-3184-5852-b549-1e196a451f34" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460502}] :answer-field/correct {:db/id #edb/ref 17592186460501} :answer-field/id #uuid "a559e75b-8ff2-5917-899d-8ec81cc20125" :answer-field/key "![Region II](images/85/85cb1a2ef9bbf5730f45c16debc2907e0c1523da902d288382702e88135cc5fb.svg)" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461117} {:answer-field/choices [{:answer/id #uuid "9eb5b6d1-21dc-5ca5-a087-32ff42346fa5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460503} {:answer/id #uuid "91a9ad8c-64bb-544a-9c5b-62d0b2a8b831" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460504}] :answer-field/correct {:db/id #edb/ref 17592186460504} :answer-field/id #uuid "bbbd7b3b-6caf-53d2-85d1-760ead766ae3" :answer-field/key "![Region III](images/55/55e389798da7756773eaa9421db393ef683918a4e188748f25e3f3ae589aaf7b.svg)" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461118} {:answer-field/choices [{:answer/id #uuid "be18d6eb-994d-5193-848d-ff043f487efe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460505} {:answer/id #uuid "d10a703c-11a3-5f17-b61d-345a7064eb33" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460506}] :answer-field/correct {:db/id #edb/ref 17592186460505} :answer-field/id #uuid "1bd05271-ff7a-5e38-870a-c107d034a080" :answer-field/key "![Region IV](images/76/7637f501aa3827e740acd7e6760f2ecdce85b8fbf6cfa0db69e3615751909927.svg)" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461119}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "72da8c2e-5747-5cf0-addd-5e327ef519dd" :question/math-academy-id "q-98036" :question/problem "Which of the regions shown below are simply connected?\n\nSelect all that apply." :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nWith that in mind, let's examine each of the regions: \n\n- Region I is simply connected. This is a connected region that does not contain holes.\n\n- Region II is not simply connected. Instead, this is a connected region that contains two holes.\n\n- Region III is simply connected. This is a connected region that does not contain holes.\n\n- Region IV is not simply connected. Instead, this is a region that consists of two pieces (it's not connected).\n\nTherefore, the correct answer is regions I and III only"}] [{:db/id #edb/ref 17592186179426 :question/id #uuid "a779f67a-21ee-5eb4-8355-c69476ee0d3e" :question/math-academy-id "e-12395" :question/problem "Construct the vector field that has the stream function $\\psi(x,y) = e^{x} \\cos{y}.$" :question/worked-solution "A function $\\psi(x,y)$ is a stream function of the vector field $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ if the following equations hold:\n\n$$\nP = \\dfrac{\\partial \\psi}{\\partial y},\\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}\n$$\n\nComputing the partial derivatives of the function $\\psi(x,y),$ we have\n\n$$\n\\begin{aligned}P & =\\frac{∂ψ}{∂y} \\\\  & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡y) \\\\  & =-{e}^{x}\\operatorname{sin}⁡y, \\\\ Q & =-\\frac{∂ψ}{∂x} \\\\  & =-\\frac{∂}{∂x}({e}^{x}\\operatorname{cos}⁡y) \\\\  & =-{e}^{x}\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nTherefore, the vector field with the stream function $\\psi(x,y) = e^{x} \\cos{y}$ is\n\n$$\n\\begin{aligned}F(x,y) & =P\\,i+Q\\,j \\\\  & =-{e}^{x}\\operatorname{sin}⁡y\\,i-{e}^{x}\\operatorname{cos}⁡y\\,j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179427 :question/id #uuid "69a293cc-ff8c-5485-8329-12e87e1addff" :question/math-academy-id "e-12396" :question/problem "Which of the following vector fields have a stream function?\n\nI. $\\mathbf{F}(x,y) = x^4y\\,\\mathbf{i} - 2x^3y^2\\,\\mathbf{j}$\n\nII. $\\mathbf{F}(x,y) = \\sin x \\sin y\\,\\mathbf{i} + \\cos x \\cos y\\,\\mathbf{j}$\n\nIII. $\\mathbf{F}(x,y) = 4x^2y\\,\\mathbf{i} -4x^2y^2\\,\\mathbf{j}$" :question/worked-solution "A vector field $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ with a simply connected domain $D \\subseteq \\mathbb{R}^2$ has a stream function $\\psi(x,y)$ if and only if\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field I has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=4{x}^{3}y,\\,\\frac{∂Q}{∂y} & =-4{x}^{3}y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y}\n= 4x^3y + (- 4x^3y)\n= 0\n$$\n\n- Vector field II has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=\\operatorname{cos}⁡x\\operatorname{sin}⁡y,\\,\\frac{∂Q}{∂y} & =-\\operatorname{cos}⁡x\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y}\n= \\cos x \\sin y + (- \\cos x \\sin y)\n= 0.\n$$\n\n- Vector field III doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=8xy,\\,\\frac{∂Q}{∂y} & =-8{x}^{2}y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y}\n= 8xy + (- 8x^2y)\n\\neq 0.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186179435 :question/id #uuid "6cb53e89-c4a9-57a6-b54f-f6a09d3a17d4" :question/math-academy-id "e-12439" :question/problem "Determine the equation of the streamline that passes through the point $P(-1,1)$ for the vector field $\\mathbf{F}(x,y) = (x^3-3xy^2)\\,\\mathbf{i} + (y^3-3x^2y)\\,\\mathbf{j}.$" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $\\mathbf F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nA vector field $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ with a simply connected domain $D \\subseteq \\mathbb{R}^2$ has a stream function $\\psi(x,y)$ if and only if\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.\n$$\n\nNote that $\\mathbf{F}(x,y) = (x^3-3xy^2)\\,\\mathbf{i} + (y^3-3x^2y)\\,\\mathbf{j}$ is a vector field with simply connected domain $D=\\mathbb{R}^2,$ where $P(x,y) = x^3-3xy^2$ and $Q(x,y) = y^3 - 3x^2y.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{x}^{2}-3{y}^{2},\\,\\frac{∂Q}{∂y} & =3{y}^{2}-3{x}^{2}.\\end{aligned}\n$$\n\nHence, $\\mathbf F$ has a stream function, since\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = (3x^2-3y^2) + (3y^2 - 3x^2) = 0.\n$$\n\nNext, we find a stream function. A function $\\psi(x,y)$ is a stream function of the vector field $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ if \n\n$$\nP = \\dfrac{\\partial \\psi}{\\partial y}, \\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}.\n$$\n\nIn our case, we have\n\n$$\n\\dfrac{\\partial \\psi}{\\partial y} = x^3-3xy^2, \\qquad \\dfrac{\\partial \\psi}{\\partial x} = -y^3+3x^2y.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\n\\psi(x,y) = x^3y - xy^3 + f(x), \\qquad \n\\psi(x,y) = -xy^3 + x^3y + g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f=g=0,$ we have\n\n$$\n\\psi(x,y) = x^3y - xy^3.\n$$\n\nFinally, we find the level curve of the stream function $\\psi(x,y) = x^3y - xy^3$ that passes through $P.$\nFirst, we find the value of the stream function at $P{:}$\n\n$$\n\\begin{aligned}ψ(-1,1) & =(-1)^{3}(1)-(-1)(1)^{3} \\\\  & =-1-(-1) \\\\  & =0\\end{aligned}\n$$\n\nHence, the streamline that passes through $P(-1,1)$ is the $0$-level curve:\n\n$$\n\\begin{aligned}ψ(x,y) & =0 \\\\ {x}^{3}y-x{y}^{3} & =0 \\\\ xy({x}^{2}-{y}^{2}) & =0 \\\\ xy(x+y)(x-y) & =0\\end{aligned}\n$$\n\nTherefore, our possible streamlines are $x=0,$ $y=0,$ $y=-x,$ or $y=x.$ The streamline that passes through $P(-1,1)$ is $y=-x.$\nThe vector field and the streamline through the point $P$ are shown below.\n\n![](images/29/29512dff5cf2dfe6dbebc0fadeee51ee3043b0161dc1729cc89877e6b39512af.png)"}] [{:db/id #edb/ref 17592186179437 :question/id #uuid "6cf11fc9-874f-5d59-bff0-1ed3debcbd40" :question/math-academy-id "e-12446" :question/problem "Find a stream function for the vector field $\\mathbf F,$ given by\n\n$$\n\\mathbf{F}(x,y) = 2y\\,\\mathbf{i} +2x\\,\\mathbf{j}.\n$$" :question/worked-solution "A vector field $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ with a simply connected domain $D \\subseteq \\mathbb{R}^2$ has a stream function $\\psi(x,y)$ if and only if\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.\n$$\n\nNote that $\\mathbf{F}(x,y) =  2y\\,\\mathbf{i} +2x\\,\\mathbf{j}$ is a vector field with simply connected domain $D=\\mathbb{R}^2,$ where $P(x,y) = 2y$ and $Q(x,y) =2x.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=0,\\,\\frac{∂Q}{∂y} & =0.\\end{aligned}\n$$\n\nHence, $\\mathbf F$ has a stream function, since\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0 + 0 = 0.\n$$\n\nNext, we find a stream function. A function $\\psi(x,y)$ is a stream function of the vector field $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ if \n\n$$\nP = \\dfrac{\\partial \\psi}{\\partial y}, \\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}.\n$$\n\nIn our case, we have\n\n$$\n\\dfrac{\\partial \\psi}{\\partial y} = 2y, \\qquad \\dfrac{\\partial \\psi}{\\partial x} = -2x.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\n\\psi(x,y) = y^2 + f(x), \\qquad \n\\psi(x,y) = -x^2+ g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f(x)=-x^2$ and $g(y)=y^2,$ we have\n\n$$\n\\psi(x,y) = y^2-x^2.\n$$"}] [{:db/id #edb/ref 17592186179482 :question/id #uuid "c427d9b4-2944-5edc-8e19-363de348d23d" :question/math-academy-id "e-15147" :question/problem "Consider the circle $S$ and vector field $\\mathbf F$ shown below. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\nWhich of the following statements are true?\n\nI. The flux of $\\mathbf F$ across $C$ is negative\n\nII. The flux of $\\mathbf F$ across $C$ is zero\n\nIII. The flux of $\\mathbf F$ across $-C$ is positive\n\n![](images/7e/7e7fbe6aaf1310b186344a3cf5a127075f11a86b51db2e687ddc7035d5d890f8.png)" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $\\mathbf F$ represents a stream of flowing water. The flux of $\\mathbf F$ across $C$ represents the net flow of water escaping the region bounded by $C\\mathbin:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero, the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nThe outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement II is true. From the diagram below we see that $\\mathbf F$ acts perpendicular to $\\mathbf n$ at every point on $C.$ Therefore, there is no net flow of $\\mathbf F$ through $C.$\n\n![](images/4a/4a3d9864bb6bada1fd218b299427bc5bb4ffcbcccb1a504fff77416d5d292151.png)\n\nSo, the flux of $\\mathbf F$ across $C$ is zero, and we must have\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = 0.\n$$\n\n- Statement III is false. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/93/9310d17389f61de2984c0e23cfe1060e77d4a87a140d2f1c892bdbab9b99629b.png)\n\nSo, the flux of $\\mathbf F$ across $-C$ is zero, and we must have\n\n$$\n\\oint\\limits_{-C} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = 0.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186179483 :question/id #uuid "15426c37-1508-5407-ab49-b26f8761795c" :question/math-academy-id "e-15148" :question/problem "Consider the vector field $\\mathbf F(x,y) = 8y\\,\\mathbf i + 4x\\,\\mathbf j$ and the circle $C$ given by $x^2+y^2 = 4.$ If the flux of $\\mathbf F$ across $C$ is given by  \n\n$$\n\\oint_C \\boxed{ {\\phantom{A A A A A A A}}} \\:\\textrm d s,\n$$\n\nwhat is the missing expression?\n\n*Hint: The outward-pointing unit normal vector to $C$ is $$\n\\displaystyle \\mathbf n = \\dfrac x2\\,\\mathbf i + \\dfrac y2\\,\\mathbf j.\n$$*" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\n![](images/ff/ff84680c55f5349431cf3d70066eeaba2c680569faa3b2210e5d14ef63ccd99e.png)\n\nIn our case, we have\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}(8y\\,i+4x\\,j)\\cdot (\\frac{x}{2}i+\\frac{y}{2}\\,j)\\text{d}s \\\\  & ={∮}_{C}4xy+2xy\\,\\text{d}s \\\\  & ={∮}_{C}6xy\\,\\text{d}s.\\end{aligned}\n$$\n\nTherefore, the missing expression is $6xy.$"}] [{:db/id #edb/ref 17592186179484 :question/id #uuid "f4a82102-6dd6-5a73-8370-9050e0f2323a" :question/math-academy-id "e-15149" :question/problem "![](images/05/05c91d681a0c84bbe9d8b6cab9bd8cdf1dca8bf88c851b8c7a7045f73ff9844c.png)\n\nConsider the vector field $\\mathbf F = 2x\\,\\mathbf i + 2y\\,\\mathbf j$ and a square $C$ with side length $2$ centered at $O,$ as shown below. Calculate the flux of $\\mathbf F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across all four sides of the square.*" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n=\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n}_1 \\: \\textrm{d}s\n+\n\\int\\limits_{C_2} \\mathbf F \\cdot \\mathbf{n}_2 \\: \\textrm{d}s\n+\n\\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n}_3 \\: \\textrm{d}s\n+\n\\int\\limits_{C_4} \\mathbf F \\cdot \\mathbf{n}_4 \\: \\textrm{d}s,\n$$\n\nwhere the sides $C_i$ and unit vectors $\\mathbf n_i$ are shown below.\n\n![](images/1d/1de4c4c55784b4a84a0493a4cc65082c430cadcc39c3d808001b2fd27665e968.png)\n\nFirst, consider the side $C_1.$ We have that $\\mathbf n_1 = \\mathbf i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(2x\\,i+2y\\,j)\\cdot i\\,\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side $C_1,$ we have\n\n$$\n\\mathbf r(t) = \\mathbf i + t\\,\\mathbf j, \\quad \\Rightarrow\\quad \\mathbf r'(t) = \\mathbf j, \\qquad t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\,\\text{d}s & =2{\\int }_{-1}^{1}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =2{\\int }_{-1}^{1}\\text{d}t \\\\  & =2(1-(-1)) \\\\  & =2\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\nBy symmetry, the flux integrals over the sides $C_2, C_3,$ and $C_4$ must be the same. Therefore,\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = 4\\cdot 4 = 16.\n$$"}] [{:db/id #edb/ref 17592186179485 :question/id #uuid "3f592794-e0e9-529c-9040-7b2806de2380" :question/math-academy-id "e-15150" :question/problem "![](images/59/59b5f1676f036f80e6aa2e9e331327ed9ec28e88bacda52a91ee0865736e9ce3.png)\n\nConsider the vector field $\\mathbf F = 5x\\,\\mathbf i - 3y\\,\\mathbf j$ and a rectangle $C$ with base $4$ and height $2$ centered at $O,$ as shown above. Calculate the flux of $\\mathbf F$ across $C.$ \n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n=\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n}_1 \\: \\textrm{d}s\n+\n\\int\\limits_{C_2} \\mathbf F \\cdot \\mathbf{n}_2 \\: \\textrm{d}s\n+\n\\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n}_3 \\: \\textrm{d}s\n+\n\\int\\limits_{C_4} \\mathbf F \\cdot \\mathbf{n}_4 \\: \\textrm{d}s,\n$$\n\nwhere the sides $C_i$ and unit vectors $\\mathbf n_i$ are shown below.\n\n![](images/79/793755cda5243dbb427d8722c21ab150a4821c3957f0ccd0ef0fedbbd576e924.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side $C_1.$ We have that $\\mathbf n_1 = \\mathbf i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(5x\\,i-3y\\,j)\\cdot i\\,\\text{d}s \\\\  & =5{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side $C_1,$ we have\n\n$$\n\\mathbf r(t) = 2\\mathbf i + t\\,\\mathbf j, \\quad \\Rightarrow\\quad \\mathbf r'(t) = \\mathbf j, \\qquad t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}5{\\int }_{{C}_{1}}x\\,\\text{d}s & =5{\\int }_{-1}^{1}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =10{\\int }_{-1}^{1}\\text{d}t \\\\  & =10\\cdot 2 \\\\  & =20.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side $C_3$ must be the same. Therefore,\n\n$$\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n}_1 \\: \\textrm{d}s = \\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n}_3 \\: \\textrm{d}s = 20.\n$$\n\n- Next, we consider the side $C_2.$ We have that $\\mathbf n_2 = \\mathbf j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(5x\\,i-3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =-3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side $C_2,$ we have\n\n$$\n\\mathbf r(t) = t\\,\\mathbf i + \\mathbf j, \\quad \\Rightarrow\\quad \\mathbf r'(t) = \\mathbf i, \\qquad t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-3{\\int }_{{C}_{2}}y\\,\\text{d}s & =-3{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side $C_4$ must be the same. Therefore,\n\n$$\n\\int\\limits_{C_2} \\mathbf F \\cdot \\mathbf{n}_2 \\: \\textrm{d}s = \\int\\limits_{C_4} \\mathbf F \\cdot \\mathbf{n}_4 \\: \\textrm{d}s = -12.\n$$\n\nFinally, then\n\n$$\n\\oint\\limits_{C}\\mathbf F\\cdot\\mathbf n\\,\\textrm d s= 2 \\cdot 20 + 2 \\cdot (-12) = 16.\n$$"}] [{:db/id #edb/ref 17592186179524 :question/id #uuid "734d74ca-26cf-57d3-b3dc-fec66d7e0264" :question/math-academy-id "e-6286" :question/problem "![](images/00/001487e4a94988a24d15702a18692e9deb2495a7cc7ec5c9f71b98fea13e0ce8.png)\n\nThe path $C_1$ consists of a line segment from the point $A(-2,0)$ to the point $O(0,0),$ and the path $C_2$ consists of a line segment from the point $O(0,0)$ to the point $B(1,1).$\n\nGiven that $$\n\\displaystyle \\int\\limits_{C_1} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r} = -4,\n$$ evaluate $$\n\\displaystyle \\int\\limits_{C} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r},\n$$ where $\\mathbf{F}(x, y) = (2x-3y) \\,\\mathbf{i} + (2y-5x)\\,\\mathbf {j}$ and $C = C_1\\cup C_2.$" :question/worked-solution "We will use the fact that\n\n$$\n\\int\\limits_{C} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r} = \\int\\limits_{C_1} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r}\n+\n \\int\\limits_{C_2} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r}.\n$$\n\nWe're given the value of the first integral, so we only need to work out the second.\n\nThe path $C_2$ is the line segment from $O$ to $B.$ It can be parametrized as\n\n$$\n\\begin{aligned}{r}_{2}(t) & =b+t(c-b) \\\\  & =⟨0,0⟩+t(⟨1,1⟩-⟨0,0⟩) \\\\  & =⟨t,t⟩ \\\\  & =t\\,i+t\\,j,\\end{aligned}\n$$\n\nwhere $0 \\lt t \\lt 1.$ Along this segment, we have $x = t$ and $y = t.$ Therefore, \n\n$$\n\\begin{aligned}F({r}_{2}(t)) & =(2x-3y)\\,i+(2y-5x)\\,j \\\\  & =(2t-3t)\\,i+(2t-5t)\\,j \\\\  & =-t\\,i-3t\\,j.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{r}_{2}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =i+j\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}F({r}_{2}(t))\\cdot {r}_{2}^{′}(t) & =(-t\\,i-3t\\,j)\\cdot (i+j) \\\\  & =-t\\cdot 1+(-3t)\\cdot 1 \\\\  & =-4t\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r \\\\  & =-4+{\\int }_{0}^{1}F({r}_{2}(t))\\cdot {r}_{2}^{′}(t)\\,\\text{d}t \\\\  & =-4+{\\int }_{0}^{1}(-4t)\\,\\text{d}t \\\\  & =-4+[-2{t}^{2}]_{0}^{1} \\\\  & =-4+[-2+0] \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179525 :question/id #uuid "cd73b214-d887-5dbb-93f9-b71e16711a24" :question/math-academy-id "e-6304" :question/problem "Evaluate the integral of the function $f(x,y) = e^{x+y}$ along the line segment from $(0,3)$ to $(2,3).$" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_{t_a}^{t_b}  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(0,3)$ to $(2,3).$ \n\nThe position vectors of the endpoints of our line segment are $\\mathbf{a}=3\\,\\mathbf{j}$ and $\\mathbf{b}=2\\,\\mathbf{i}+3\\,\\mathbf{j}.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =3\\,j+t[(2\\,i+3\\,j)-3\\,j] \\\\  & =3\\,j+t(2\\,i) \\\\  & =2t\\,i+3\\,j\\end{aligned}\n$$\n\nwhere $0 \\le t \\le 1.$ Thus, we have that $x=2t$ and $y=3$ along the segment.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)i+\\frac{\\text{d}}{\\text{d}t}(3)j \\\\  & =2\\,i \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = e^{x+y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & ={e}^{2t+3}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x+y}\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{2t+3}\\cdot 2\\cdot \\text{d}t \\\\  & =2{\\int }_{0}^{1}{e}^{2t+3}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t+3,$ $\\textrm d u=2\\,\\textrm d t$ as follows: \n\n$$\n\\begin{aligned}2{\\int }_{0}^{1}{e}^{2t+3}\\,\\text{d}t & ={\\int }_{3}^{5}{e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}\\,{|}_{3}^{5} \\\\  & ={e}^{5}-{e}^{3} \\\\  & ={e}^{3}({e}^{2}-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179527 :question/id #uuid "2e6103cc-7be6-5eb6-ab5a-aa5aff3fa423" :question/math-academy-id "e-6319" :question/problem "![](images/38/38ab4af726729b5c9804f4aa13801d637e5e62eda085d6611174586827ef8c11.png)\n\nConsider the integral $$\n\\displaystyle \\int\\limits_{C} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r},\n$$ where $C$ is the closed polygonal path $FGHF$ shown above, traversed in the **clockwise** direction. Express this integral as a sum of line integrals along $C_1, C_2,$ and $C_3.$" :question/worked-solution "First, notice that we can represent $C,$ which is traversed in clockwise, as the union of $3$ paths:\n\n$$\nC = \\{-C_1\\} \\cup \\{-C_2\\} \\cup C_3,\n$$\n\nwhere $-C_1$ and $-C_2$ are the same paths as $C_1$ and $C_2$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{-{C}_{1}}F\\cdot \\text{d}r+{\\int }_{-{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r \\\\  & =-{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$"}]}
