#{[{:db/id #edb/ref 17592186488245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb9848c-1e82-5dce-8b65-0e9c48c76b2c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a2/a213dd6561609a4f9e91ea6f0a45f7ce63686acd74e58727c027dada5bb3ba66.png" :db/id #edb/ref 17592186487691} {:answer/id #uuid "69cb04c6-efca-5548-a928-c26fd1180f2d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/aa/aa7c75e476c336fe687d703351b8a0c5becb0dce9d296f9ad3858178175f0983.png" :db/id #edb/ref 17592186487777} {:answer/id #uuid "9f66844d-7df7-5ada-9c5b-08980ffc827e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/dd/dd767429c321d02dc6edf559127ff8ecc733bd5ecdf243b79f7b671fd78085c4.png" :db/id #edb/ref 17592186487863} {:answer/id #uuid "a2f1cce1-78cb-5f61-830a-d8b0bba27616" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/60/608ecd071efb0a26a81e001015a22eccd0721f7052c05bbea78c8cc92ab12b1a.png" :db/id #edb/ref 17592186487871} {:answer/id #uuid "a8759899-9876-5cea-aab9-4a8998ae49d1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/90/906d167f0ab7b179f8b11ff51b8581f3b190a61391bd4cc26cb1a760077abb14.png" :db/id #edb/ref 17592186487887}] :answer-field/correct {:db/id #edb/ref 17592186487863} :answer-field/id #uuid "02ebd98c-f2ed-55d1-aeea-e294928fd7b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488052}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a4b8bc46-7868-52e5-a7b3-40602e3b7509" :question/math-academy-id "q-98392" :question/problem "Which of the following regions is connected?" :question/worked-solution "A region $D$ is connected if every pair of points in $D$ can be joined by a smooth curve or a path in $D.$\n\nAmong the given options, the only one that satisfies this definition is the following:\n\n![](images/dd/dd767429c321d02dc6edf559127ff8ecc733bd5ecdf243b79f7b671fd78085c4.png)"}] [{:db/id #edb/ref 17592186488270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00693d44-168a-59ae-81ba-7237813361a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186487568} {:answer/id #uuid "5e040eb6-7f07-520b-9885-f2312cee4b7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III and IV only" :db/id #edb/ref 17592186487754} {:answer/id #uuid "8f2829aa-b1bc-5d42-a9ba-b1777c71d30e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186487838} {:answer/id #uuid "a7780b16-691d-528d-a79d-418312672210" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186487881} {:answer/id #uuid "bd604b74-ca77-53a0-8727-e78e594cc6cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186487923}] :answer-field/correct {:db/id #edb/ref 17592186487754} :answer-field/id #uuid "4a7b56f9-4f69-5483-8998-cc50c72ca12a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488078}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "db6c8509-7f18-5c65-821d-f6d09e6d4e13" :question/math-academy-id "q-98695" :question/problem "![](images/23/2304f9b9080a8b3ec4ff10284cee8e01ec8dff54fb879f7ed55dd7a3f80e2b23.png)\n\nWhich of the regions shown above are simply connected?" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nWith that in mind, let's examine each of the regions:  \n\n- Region I is not simply connected. Instead, this is a region that consists of two pieces (it's not connected).\n\n- Region II is not simply connected. Instead, this is a connected region that contains a hole.\n\n- Region III is simply connected. This is a connected region that does not contain holes.\n\n- Region IV is simply connected. This is a connected region that does not contain holes.\n\nTherefore, the correct answer is \"III and IV only.\""}] [{:db/id #edb/ref 17592186490212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "405b937b-2494-589a-941f-c2c89bb59b81" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/44/4459ec44cd710a0ba13e9d22796311cb251cc58f8e41c4212a00260e45bbcd2c.png" :db/id #edb/ref 17592186489663} {:answer/id #uuid "4f3ef020-6dd5-5ced-a63e-ffae9ca42093" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a9/a9b8e953a6d1277056331aa46a3d3a6bf59ae0dd8dad66d14c8a5f2a409316ce.png" :db/id #edb/ref 17592186489704} {:answer/id #uuid "595622b7-555e-511d-b8fb-61467363fd56" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b8/b8be3b86eb85760320298c272e31dd76fa2fea5fd6acf2931831f1c0e3d73787.png" :db/id #edb/ref 17592186489732} {:answer/id #uuid "87b8b871-e4f1-5444-8738-aa304484251c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/57/5725e9ce0bd4f2995d478f2a74d7b65f778157058a41ef0229637b40bb865b11.png" :db/id #edb/ref 17592186489823} {:answer/id #uuid "d25de580-d351-551b-9837-3c4daaa24a24" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1c/1c0270805f90797c9add194054ea5bbef76207b5ce9c9659227c069e999369f3.png" :db/id #edb/ref 17592186489980}] :answer-field/correct {:db/id #edb/ref 17592186489704} :answer-field/id #uuid "b9111900-5b3b-528e-bee1-da24812f7bc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490174}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "03021383-b99c-5e38-823a-268b5d1215a6" :question/math-academy-id "q-162160" :question/problem "Which of the following represents the streamlines of the vector field $$\n\\displaystyle F(x,y)=\\left(\\frac{1}{y-{x}^{2}}\\right)i+\\left(\\frac{2x}{y-{x}^{2}}\\right)j\n$$ over the domain $D=\\{(x,y)\\in {R}^{2}\\,:\\,y>{x}^{2}\\}.$" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nA vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that \n\n$$\nF(x,y)=\\left(\\frac{1}{y-{x}^{2}}\\right)i+\\left(\\frac{2x}{y-{x}^{2}}\\right)j\n$$\n\n is a vector field with simply connected domain $D,$ where $P(x,y)=\\frac{1}{y-{x}^{2}}$ and $Q(x,y)=\\frac{2x}{y-{x}^{2}}.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=\\frac{2x}{(y-{x}^{2})^{2}},\\,\\frac{∂Q}{∂y} & =-\\frac{2x}{(y-{x}^{2})^{2}}.\\end{aligned}\n$$\n\nHence, $F$ has a stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=\\frac{2x}{(y-{x}^{2})^{2}}+\\left(-\\frac{2x}{(y-{x}^{2})^{2}}\\right)=0.\n$$\n\nNext, we find a stream function. A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if \n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}.\n$$\n\nIn our case, we have\n\n$$\n\\frac{∂ψ}{∂y}=\\frac{1}{y-{x}^{2}},\\,\\frac{∂ψ}{∂x}=-\\frac{2x}{y-{x}^{2}}.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\nψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2})+f(x),\\,ψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2})+g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f=g=0,$ we have\n\n$$\nψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2}).\n$$\n\nFinally, we find the level curves of the stream function $ψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2})$ given by the equations $ψ(x,y)=c.$\n\nNotice that the range of $ψ(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider level curves for any value of $c.$ So, we have:\n\n$$\n\\begin{aligned}ψ(x,y) & =c \\\\ \\operatorname{ln}⁡(y-{x}^{2}) & =c \\\\ y-{x}^{2} & ={e}^{c} \\\\ y & ={x}^{2}+{e}^{c}\\end{aligned}\n$$\n\nThe equation above gives us a family of parabolas with the vertex at $(0,{e}^{c}).$ Therefore, the correct graph (along with the vector field $F$) is as follows:\n\n![](images/ed/edc12146ffad4dc46ed6d57b3dfdc9a08ca92fb601ef5e08ed9ccef3a1c1da4c.png)"}] [{:db/id #edb/ref 17592186490290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f9115f7-c967-552e-babd-64a7c492372a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186489621} {:answer/id #uuid "375f59e1-b6c5-51a0-ad58-23511b54c59d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186489638} {:answer/id #uuid "3c97f35c-4480-5e3e-a894-f3effca05b9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186489651} {:answer/id #uuid "5959bb5d-4929-5707-80e3-51ab7b1c379f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186489733} {:answer/id #uuid "cc31709a-e3d1-56b4-9a97-dea545336cc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186489966}] :answer-field/correct {:db/id #edb/ref 17592186489651} :answer-field/id #uuid "59271587-d957-593c-984d-f14328120bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490127}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "abc95782-56f0-5602-a797-77bbd8bc8d07" :question/math-academy-id "q-160382" :question/problem "For the transformation $T,$ defined as\n\n$$\nT(\\begin{bmatrix}u \\\\ v\\end{bmatrix})⟶\\begin{bmatrix}uv \\\\ \\operatorname{ln}⁡\\left(\\frac{u}{v}\\right)\\end{bmatrix}\n$$\n\n  \n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x=uv$ and $y=\\operatorname{ln}⁡\\left(\\frac{u}{v}\\right).$ \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =u \\\\ \\frac{∂y}{∂u} & =\\frac{1}{u} & \\,\\frac{∂y}{∂v} & =-\\frac{1}{v}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}v & u \\\\ \\frac{1}{u} & -\\frac{1}{v}\\end{vmatrix} \\\\  & =v\\cdot \\left(-\\frac{1}{v}\\right)-u\\cdot \\frac{1}{u} \\\\  & =-2.\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,3)}=-2.\n$$"}] [{:db/id #edb/ref 17592186490304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0324db79-c1eb-5ed2-9131-3173b26268b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(x,y)=-{e}^{1-y}\\,i-{x}^{2}{e}^{1-y}\\,j" :db/id #edb/ref 17592186489518} {:answer/id #uuid "470802a2-bab1-557b-aff1-7439468a51fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(x,y)=-x{e}^{1-y}\\,i-2{x}^{2}{e}^{1-y}\\,j" :db/id #edb/ref 17592186489679} {:answer/id #uuid "79ab0051-8a1d-5b87-9e8b-c2a2a8676b53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(x,y)=-x{e}^{1-y}\\,i-2y{e}^{1-y}\\,j" :db/id #edb/ref 17592186489793} {:answer/id #uuid "84a166b1-efc2-58de-b99b-61ca8760b1b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(x,y)=-{x}^{2}{e}^{1-y}\\,i-2x{e}^{1-y}\\,j" :db/id #edb/ref 17592186489817} {:answer/id #uuid "bef70330-ce0a-50b9-8bbf-129455a0ace1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(x,y)=-2{e}^{1-y}\\,i-2x{e}^{-y}\\,j" :db/id #edb/ref 17592186489930}] :answer-field/correct {:db/id #edb/ref 17592186489817} :answer-field/id #uuid "a4ad95fd-3ba5-57ea-89a2-4cf27fe1615b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490167}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cae20d6b-2ae5-5a13-a8c2-7e9cf70b768d" :question/math-academy-id "q-162510" :question/problem "Construct the vector field that has the stream function $ψ(x,y)={x}^{2}{e}^{1-y}.$" :question/worked-solution "A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if the following equations hold:\n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}\n$$\n\nComputing the partial derivatives of the function $ψ(x,y),$ we have\n\n$$\n\\begin{aligned}P & =\\frac{∂ψ}{∂y} \\\\  & =\\frac{∂}{∂y}({x}^{2}{e}^{1-y}) \\\\  & =-{x}^{2}{e}^{1-y}, \\\\ Q & =-\\frac{∂ψ}{∂x} \\\\  & =-\\frac{∂}{∂x}({x}^{2}{e}^{1-y}) \\\\  & =-2x{e}^{1-y}.\\end{aligned}\n$$\n\nTherefore, the vector field with the stream function $ψ(x,y)={x}^{2}{e}^{1-y}$ is\n\n$$\n\\begin{aligned}F(x,y) & =P\\,i+Q\\,j \\\\  & =-{x}^{2}{e}^{1-y}\\,i-2x{e}^{1-y}\\,j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25c55a7f-31b3-58c2-b77e-afb1cd059f2b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186489598} {:answer/id #uuid "335a35ea-9c7e-52ad-891b-16a96af5a8c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186489629} {:answer/id #uuid "9cca9909-11f3-54e5-be7a-416185202e4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186489864} {:answer/id #uuid "b6ed420d-9af0-5de8-8f51-6a8eb4d4d2a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186489914} {:answer/id #uuid "bdf91090-4a1d-5328-8dcd-f3143efe1729" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186489929}] :answer-field/correct {:db/id #edb/ref 17592186489629} :answer-field/id #uuid "72ba71ce-b94a-5573-a9f5-03870c73d863" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490139}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e0611f00-dc8b-5374-b5f7-8b0d695e2534" :question/math-academy-id "q-162612" :question/problem "Which of the following vector fields have a stream function?\n\nI. $F(x,y)=\\operatorname{cos}⁡x\\,i-x\\operatorname{cos}⁡y\\,j$\n\nII. $F(x,y)={e}^{x}\\operatorname{cos}⁡y\\,i-{e}^{x}\\operatorname{sin}⁡y\\,j$\n\nIII. $F(x,y)=x\\,i+2{e}^{y}\\,j$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field I doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-\\operatorname{sin}⁡x,\\,\\frac{∂Q}{∂y} & =x\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=(-\\operatorname{sin}⁡x)+x\\operatorname{sin}⁡y\\ne 0.\n$$\n\n- Vector field II has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}={e}^{x}\\operatorname{cos}⁡y,\\,\\frac{∂Q}{∂y} & =-{e}^{x}\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}={e}^{x}\\operatorname{cos}⁡y+(-{e}^{x}\\operatorname{cos}⁡y)=0.\n$$\n\n- Vector field III doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=1,\\,\\frac{∂Q}{∂y} & =2{e}^{y}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=1+2{e}^{y}\\ne 0.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186490318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5778857a-821a-5682-89ba-1adfcab7df7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186489723} {:answer/id #uuid "95bce84c-a559-591f-953f-651e5baec02d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186489850} {:answer/id #uuid "b29da8c3-1cc1-5e25-86bf-88ebbd6119ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186489905} {:answer/id #uuid "bb5c5ded-90a1-5823-bb01-ab3f81ba4a0c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186489926} {:answer/id #uuid "bc05f566-bd10-5158-8fb4-fe5ab7bbec72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186489927}] :answer-field/correct {:db/id #edb/ref 17592186489905} :answer-field/id #uuid "f8d3f67a-8384-5a77-a9a4-eb3e9f68a0eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490205}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9691dde-e78b-59c1-ac5c-550cb0f124bb" :question/math-academy-id "q-162614" :question/problem "Which of the following vector fields have a stream function?\n\nI. $F(x,y)={x}^{2}\\,i-xy\\,j$\n\nII. $F(x,y)=({x}^{2}-2xy)\\,i+({y}^{2}-2xy)\\,j$\n\nIII. $F(x,y)={e}^{3x}\\operatorname{cos}⁡(3y)\\,i-{e}^{3x}\\operatorname{sin}⁡(3y)\\,j$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field I doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x,\\,\\frac{∂Q}{∂y} & =-x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2x+(-x)\\ne 0.\n$$\n\n- Vector field II has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x-2y,\\,\\frac{∂Q}{∂y} & =2y-2x\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=(2x-2y)+(2y-2x)=0.\n$$\n\n- Vector field III does have a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{e}^{3x}\\operatorname{cos}⁡(3y),\\,\\frac{∂Q}{∂y} & =-3{e}^{3x}\\operatorname{cos}⁡(3y).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=3{e}^{3x}\\operatorname{cos}⁡(3y)+(-3{e}^{3x}\\operatorname{cos}⁡(3y))=0.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186491983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b2bbcb8-c26d-5006-a73c-bbb060d2cd36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186491568} {:answer/id #uuid "aba8c641-4582-5c5c-96f9-0d22c8330b28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186491753} {:answer/id #uuid "d6091ef9-6288-59c1-9465-7c82caaeb2be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186491819} {:answer/id #uuid "ebb91197-701b-57ed-96ae-159bf0a24d7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491858} {:answer/id #uuid "edc9ced6-e6c7-5f1d-be8e-a811c81b1ee0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186491862}] :answer-field/correct {:db/id #edb/ref 17592186491568} :answer-field/id #uuid "2c5a083c-f900-50bb-ab0f-b4084bf566f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491899}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "018796a4-bd8d-5016-90ff-54138b129ff5" :question/math-academy-id "q-160875" :question/problem "Using the change of variables \n\n$$\nu=2y-x,\\,v=y-x,\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the lines\n\n$$\ny=1+\\frac{x}{2},\\,y=-1+\\frac{x}{2},\\,y=x-1,\\,y=x-2.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=2y-x,\\,v=y-x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=2y-x$ into the equations of the first and second lines:\n\n$$\n\\begin{aligned} & y=1+\\frac{x}{2} & ⟹\\, & 2y-x=2 & ⟹\\, & u=2 \\\\  & y=-1+\\frac{x}{2} & ⟹\\, & 2y-x=-2 & ⟹\\, & u=-2\\end{aligned}\n$$\n\nAnd we substitute $v=y-x$ into the equations of the third and fourth lines:\n\n$$\n\\begin{aligned} & y=x-1 & ⟹\\, & y-x=-1 & ⟹\\, & v=-1 \\\\  & y=x-2 & ⟹\\, & y-x=-2 & ⟹\\, & v=-2\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,-2\\le u\\le 2,\\,-2\\le v\\le -1\\}\n$$\n\n![](images/e9/e9ad855bcb5133e9a51d990ea25d0e23c8da88c59e15825f3ea1bfc47335dc33.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & 2 \\\\ -1 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|1|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\text{Area}(Δ) \\\\  & =4\\cdot 1 \\\\  & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059db5fe-4cc3-54a1-81e3-0414e4815adc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491461} {:answer/id #uuid "2986cb5f-c1ed-50c3-8db9-d15e99c3946a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186491539} {:answer/id #uuid "31cc9859-a239-5a5d-b7da-9bb9d1419d34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186491553} {:answer/id #uuid "3d8a5ea6-1e80-5839-b6f0-5b028efd7cc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186491573} {:answer/id #uuid "478b922b-06ad-5ebb-92ad-7e5c3604f039" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186491588}] :answer-field/correct {:db/id #edb/ref 17592186491573} :answer-field/id #uuid "71a832b8-f7c1-5834-aad6-10f8986faaf6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491926}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "148dd598-80e8-5dbb-9901-ed29d38f654f" :question/math-academy-id "q-160846" :question/problem "Use a change of variables to calculate the area of the finite region $D$ bounded by the following lines.\n\n$$\ny=2x-1,\\,y=2x-3,\\,x=2y+1,\\,x=2y+4\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n2x-y=1,\\,2x-y=3,\\,x-2y=1,\\,x-2y=4\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=2x-y,\\,v=x-2y\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=2x-y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & 2x-y=1\\,⟹\\,u=1 \\\\  & 2x-y=3\\,⟹\\,u=3\\end{aligned}\n$$\n\nAnd we substitute $v=x-2y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & x-2y=1\\,⟹\\,v=1 \\\\  & x-2y=4\\,⟹\\,v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le 3,\\,1\\le v\\le 4\\}\n$$\n\n![](images/87/877dee1177d97f3c0df572e766d47cf31cec941d1770f72f5835433b386d5067.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -1 \\\\ 1 & -2\\end{vmatrix} \\\\  & =-4+1 \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}\\,\\text{d}u{\\int }_{1}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (3-1)\\cdot (4-1) \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2704d9bd-c674-57e4-8db7-da57113e6141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491535} {:answer/id #uuid "a01f91d3-c2ad-5069-8a76-47da4c8b38b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186491738} {:answer/id #uuid "a5bfbf0b-4072-5ba5-a96b-076aaa163007" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186491742} {:answer/id #uuid "afce08c0-f3d3-511e-9b16-29b005f793ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186491761} {:answer/id #uuid "dd32bf3f-4ab3-582a-ad98-c9be76c0ba3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186491830}] :answer-field/correct {:db/id #edb/ref 17592186491738} :answer-field/id #uuid "97563c8f-2987-55f3-a83b-6c7371d8e9d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491941}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19c4c415-ad3c-5e8f-ba67-3b530b8c6971" :question/math-academy-id "q-160853" :question/problem "Use a change of variables to calculate the area of the finite region $D$ bounded by the following lines.\n\n$$\n2y=3x-2,\\,2y=3x-7,\\,2x=3y+1,\\,2x=3y+4\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n3x-2y=2,\\,3x-2y=7,\\,2x-3y=1,\\,2x-3y=4\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=3x-2y,\\,v=2x-3y\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=3x-2y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & 3x-2y=2\\,⟹\\,u=2 \\\\  & 3x-2y=7\\,⟹\\,u=7\\end{aligned}\n$$\n\nAnd we substitute $v=2x-3y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & 2x-3y=1\\,⟹\\,v=1 \\\\  & 2x-3y=4\\,⟹\\,v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 7,\\,1\\le v\\le 4\\}\n$$\n\n![](images/83/83798f4e941010a24a548d9403b7085fa8e4b8cca8dcb7c0ebc6670d4afbf517.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -2 \\\\ 2 & -3\\end{vmatrix} \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{5}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{5}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{5}{∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{5}{\\int }_{2}^{7}\\,\\text{d}u{\\int }_{1}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{5}\\cdot (7-2)\\cdot (4-1) \\\\  & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f427ed-2d2a-5dfa-8945-d1b3f1c00922" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491456} {:answer/id #uuid "3d405b8d-b749-5fcf-9281-fe13658b158d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491572} {:answer/id #uuid "947befcc-fa3a-58ec-8c95-d53e4ad8cc01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491708} {:answer/id #uuid "c853fb0b-11f2-5a9b-a138-764447d95351" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491794} {:answer/id #uuid "c9995f65-1329-5eb2-aafe-12e03a218173" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186491797}] :answer-field/correct {:db/id #edb/ref 17592186491797} :answer-field/id #uuid "e3443c26-bcc5-576e-a59c-ebc351a5027e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491974}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19d01b49-3d16-5ae7-a700-51548665fd4c" :question/math-academy-id "q-160893" :question/problem "Using the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=\\frac{{y}^{2}}{x},\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the curves\n\n$$\ny={x}^{2},\\,y=3{x}^{2},\\,x={y}^{2},\\,x=\\frac{{y}^{2}}{4}.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=\\frac{{y}^{2}}{x}\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=\\frac{y}{{x}^{2}}$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & y={x}^{2} & ⟹\\, & \\frac{y}{{x}^{2}}=1 & ⟹\\, & u=1 \\\\  & y=3{x}^{2} & ⟹\\, & \\frac{y}{{x}^{2}}=3 & ⟹\\, & u=3\\end{aligned}\n$$\n\nAnd we substitute $v=\\frac{{y}^{2}}{x}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & x={y}^{2} & ⟹\\, & \\frac{{y}^{2}}{x}=1 & ⟹\\, & v=1 \\\\  & x=\\frac{{y}^{2}}{4} & ⟹\\, & \\frac{{y}^{2}}{x}=4 & ⟹\\, & v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le 3,\\,1\\le v\\le 4\\}\n$$\n\n![](images/26/26eaba24af54a40f59f92148c145285ba4097ce765aee8cfc9a6241ff88b9498.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ -\\frac{{y}^{2}}{{x}^{2}} & \\text{ }\\text{ }\\frac{2y}{x}\\end{vmatrix} \\\\  & =-\\frac{3{y}^{2}}{{x}^{4}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{{x}^{4}}{3{y}^{2}}=-\\frac{1}{3{u}^{2}}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3{u}^{2}}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}{\\int }_{1}^{4}\\frac{1}{{u}^{2}}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}\\frac{1}{{u}^{2}}\\,\\text{d}u{\\int }_{1}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (-\\frac{1}{3}+1)\\cdot (4-1) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26ffbc26-848e-5d04-abcc-6404b93bc783" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\sqrt{2}}{3}" :db/id #edb/ref 17592186491534} {:answer/id #uuid "51513ac6-c10d-5428-81d7-fc0f9ff5e5a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186491608} {:answer/id #uuid "8d66c296-5953-5fbe-8ee0-08a430a0fe71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186491694} {:answer/id #uuid "ab6be4c3-4f0a-5a3d-9787-10ec2aa91cac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186491751} {:answer/id #uuid "df621dfa-555c-59a4-b00c-5eb1cda1d6b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186491834}] :answer-field/correct {:db/id #edb/ref 17592186491534} :answer-field/id #uuid "9c1d39b3-e468-5801-801a-6497da6d4261" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491946}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "57f9fe20-2df7-5d01-bf45-354e1e66779e" :question/math-academy-id "q-38132" :question/problem "Using the change of variables \n\n$$\nu=x+2y,\\,v=x,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $(x+2y)^{2}-x-1=0$ and the line $x=1.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x+2y,\\,v=x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x+2y=u$ and $x=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(x+2y)^{2}-x-1=0\\,⟹\\,{u}^{2}-v-1=0\\,⟹\\,v={u}^{2}-1,\\end{aligned}\n$$\n\nwhile substituting $x=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}x=1\\,⟹\\,v=1.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v &={u}^{2}-1 \\\\ v &=1\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}u &=\\pm \\sqrt{2} \\\\ v &=1.\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm \\sqrt{2},1).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-\\sqrt{2}\\le u\\le \\sqrt{2},\\,{u}^{2}-1\\le v\\le 1\\}.\n$$\n\n![](images/0c/0c598c1c0d09fb26175cad17106bc4529165da619f35a5882ead0ba133d05c2c.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 2 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}={(-2)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}[{\\int }_{{u}^{2}-1}^{1}\\,dv]du \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}[v]_{{u}^{2}-1}^{1}\\,du \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}(1-({u}^{2}-1))du \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}(2-{u}^{2})du \\\\  & =\\frac{1}{2}{[2u-\\frac{{u}^{3}}{3}]}_{-\\sqrt{2}}^{\\sqrt{2}} \\\\  & =\\frac{1}{2}((2\\sqrt{2}-\\frac{2\\sqrt{2}}{3})-(-2\\sqrt{2}+\\frac{2\\sqrt{2}}{3})) \\\\  & =2\\sqrt{2}-\\frac{2\\sqrt{2}}{3} \\\\  & =\\frac{4\\sqrt{2}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e9418b6-f97a-56c0-a5f8-cb663c2070de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186491482} {:answer/id #uuid "1e609f4f-6be3-5c74-b9cf-1200ed558b19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{5}" :db/id #edb/ref 17592186491517} {:answer/id #uuid "234a9c24-6945-5264-98b6-b6c065eb22c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186491527} {:answer/id #uuid "74cdbe9e-bfc8-55b1-addc-c01619e14194" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186491661} {:answer/id #uuid "ba55a64c-3c7e-522a-800b-186dd45e7f5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186491774}] :answer-field/correct {:db/id #edb/ref 17592186491482} :answer-field/id #uuid "462ba4b0-a9c1-5d72-894e-ca9fc93df274" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491908}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cfee0347-870f-5cb0-bd74-a4488b93243b" :question/math-academy-id "q-83944" :question/problem "Using the change of variables \n\n$$\nu=x-y,\\,v=y,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $y+(x-y)^{4}=3$ and the line $y=2.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x-y,\\,v=y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x-y=u$ and $y=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}y+(x-y)^{4}=3\\,⟹\\,v+{u}^{4}=3\\,⟹\\,v=3-{u}^{4},\\end{aligned}\n$$\n\nwhile substituting $y=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}y=2\\,⟹\\,v=2.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v &=3-{u}^{4} \\\\ v &=2\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}u &=\\pm 1 \\\\ v &=2.\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 1,2).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,2\\le v\\le 3-{u}^{4}\\}.\n$$\n\n![](images/81/81ff220903cbe53cebf5e8f8b704e2a316be6092e1f14e527a7321e8f61bffb8.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=(1)^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|1|\\text{d}u\\text{d}v \\\\  & ={\\int }_{-1}^{1}[{\\int }_{2}^{3-{u}^{4}}\\,dv]du \\\\  & ={\\int }_{-1}^{1}[v]_{2}^{3-{u}^{4}}\\,du \\\\  & ={\\int }_{-1}^{1}((3-{u}^{4})-2)\\,du \\\\  & ={\\int }_{-1}^{1}(1-{u}^{4}))\\,du \\\\  & ={[u-\\frac{{u}^{5}}{5}]}_{-1}^{1} \\\\  & =2-\\frac{2}{5} \\\\  & =\\frac{8}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ab4b08a-d977-567f-a04e-d43ed9d2d0a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491542} {:answer/id #uuid "94243889-413b-535c-af6b-ce9f8dfb1709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491706} {:answer/id #uuid "b4ac3fa8-e528-579d-ad93-0c93644320df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491767} {:answer/id #uuid "e10f8c74-4f85-5c66-896d-c5e8857bd026" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491836} {:answer/id #uuid "ff3ff714-7cca-5ae3-9331-6463299a095b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491885}] :answer-field/correct {:db/id #edb/ref 17592186491542} :answer-field/id #uuid "9fcb4a03-8da4-5422-b391-06e26dc1be4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491950}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dcce5a2c-ee13-5e17-858d-468f144adb26" :question/math-academy-id "q-160892" :question/problem "Using the change of variables\n\n$$\nu=\\frac{{x}^{2}}{y},\\,v=xy,\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the curves\n\n$$\ny={x}^{2},\\,y=\\frac{{x}^{2}}{3},\\,y=\\frac{2}{x},\\,y=\\frac{4}{x}.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=\\frac{{x}^{2}}{y},\\,v=xy\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=\\frac{{x}^{2}}{y}$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & y={x}^{2} & ⟹\\, & \\frac{{x}^{2}}{y}=1 & ⟹\\, & u=1 \\\\  & y=\\frac{{x}^{2}}{3} & ⟹\\, & \\frac{{x}^{2}}{y}=3 & ⟹\\, & u=3\\end{aligned}\n$$\n\nAnd we substitute $v=xy$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & y=\\frac{2}{x} & ⟹\\, & xy=2 & ⟹\\, & v=2 \\\\  & y=\\frac{4}{x} & ⟹\\, & xy=4 & ⟹\\, & v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le 3,\\,2\\le v\\le 4\\}\n$$\n\n![](images/12/1207d8cdb8afd7c55d712caca043edfe9f0d0395343a6cbd329cf5861ec3bce7.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\frac{2x}{y} & -\\frac{{x}^{2}}{{y}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{vmatrix} \\\\  & =\\frac{3{x}^{2}}{y}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{y}{3{x}^{2}}=\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|\\frac{1}{3u}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}{\\int }_{2}^{4}\\frac{1}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}\\frac{1}{u}\\,\\text{d}u{\\int }_{2}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡1)\\cdot (4-2) \\\\  & =\\frac{2}{3}\\operatorname{ln}⁡3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6b5fe5-29d1-5793-a274-fa3b5699e913" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3({e}^{-1/2}-{e}^{-2})\\operatorname{ln}⁡2" :db/id #edb/ref 17592186493410} {:answer/id #uuid "17dcff5e-6574-5e2e-be4c-22c67c1a31d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e}{8}" :db/id #edb/ref 17592186493432} {:answer/id #uuid "702b0bc2-ac10-5437-9f18-9fa877532a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{-1}-{e}^{-2}}{4}" :db/id #edb/ref 17592186493554} {:answer/id #uuid "857734df-e10d-5568-a049-4e87b8b5c0d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{e}^{2}" :db/id #edb/ref 17592186493601} {:answer/id #uuid "e162164d-9035-55fa-9f1c-b47ea0bae241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({e}^{2}-e)\\operatorname{ln}⁡2" :db/id #edb/ref 17592186493747}] :answer-field/correct {:db/id #edb/ref 17592186493410} :answer-field/id #uuid "15ea503e-c96f-567a-8f89-cf26cc3e1193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493808}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5c02db8-6f5e-5ac6-a24e-9e9016b1082e" :question/math-academy-id "q-160899" :question/problem "Using the change of variables $u=\\frac{y}{x}$ and $v=xy,$ evaluate the double integral\n\n$$\n{∬}_{D}{e}^{-xy/2}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,\\frac{x}{4}\\le y\\le 2x,\\,1\\le xy\\le 4\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{x},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,\\frac{1}{4}\\le u\\le 2,\\,1\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\frac{y}{{x}^{2}} & \\frac{1}{x} \\\\ y & \\text{ }\\text{ }x\\end{vmatrix} \\\\  & =-\\frac{2y}{x}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(-\\frac{2y}{x}\\right)}=-\\frac{1}{2u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{-xy/2}\\,dx\\,dy & ={∬}_{Δ}{e}^{-v/2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{e}^{-v/2}\\cdot |-\\frac{1}{2u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{\\int }_{1/4}^{2}\\frac{{e}^{-v/2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{e}^{-v/2}[{\\int }_{1/4}^{2}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{e}^{-v/2}[\\operatorname{ln}⁡|u|\\,{|}_{1/4}^{2}]du \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{e}^{-v/2}[\\operatorname{ln}⁡2-\\operatorname{ln}⁡\\frac{1}{4}]\\,du \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2}{\\int }_{1}^{4}{e}^{-v/2}\\,du \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2}\\cdot {[-2{e}^{-v/2}]}_{1}^{4} \\\\  & =-3\\operatorname{ln}⁡2\\cdot ({e}^{-2}-{e}^{-1/2}) \\\\  & =3({e}^{-1/2}-{e}^{-2})\\operatorname{ln}⁡2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143bd49e-b2ca-5b56-9eca-6d7751d7c1e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186493428} {:answer/id #uuid "37392f66-38d1-5cf1-a83a-b61ffbecdc24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186493480} {:answer/id #uuid "3b9d745e-3b7a-5566-acd4-df51a55a0434" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186493492} {:answer/id #uuid "757701d0-e96c-58b7-9b6d-52ab1067ccc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186493565} {:answer/id #uuid "f8b8b11d-0fcd-5a7a-8d95-67c9db317553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186493793}] :answer-field/correct {:db/id #edb/ref 17592186493428} :answer-field/id #uuid "b260735c-8ce2-5820-82bd-e9db5e7533a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493865}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9c37ee3-304c-5283-97a5-75391f3d1e94" :question/math-academy-id "q-82985" :question/problem "Using the change of variables $u=x+3y$ and $v=x+2y,$ evaluate the double integral\n\n$$\n{∬}_{D}\\frac{x+3y}{x+2y}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,0\\le x+3y\\le 2,\\,2\\le x+2y\\le 4\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+3y,\\,v=x+2y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,0\\le u\\le 2,\\,2\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 3 \\\\ 1 & \\text{ }\\text{ }2\\end{vmatrix} \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{x+3y}{x+2y}\\,dx\\,dy & ={∬}_{Δ}\\frac{u}{v}\\cdot |\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}\\frac{u}{v}\\cdot |-1|\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{2}{\\int }_{2}^{4}\\frac{u}{v}\\,\\text{d}v\\,\\text{d}u \\\\  & ={\\int }_{0}^{2}u[{\\int }_{2}^{4}\\frac{1}{v}\\,dv]du \\\\  & ={\\int }_{0}^{2}u[\\operatorname{ln}⁡v]_{2}^{4}\\,du \\\\  & ={\\int }_{0}^{2}u(\\operatorname{ln}⁡4-\\operatorname{ln}⁡2)\\,du \\\\  & =(2\\operatorname{ln}⁡2-\\operatorname{ln}⁡2){\\int }_{0}^{2}u\\,du \\\\  & =\\operatorname{ln}⁡2[\\frac{{u}^{2}}{2}]_{0}^{2} \\\\  & =\\operatorname{ln}⁡2\\cdot (2-0) \\\\  & =2\\operatorname{ln}⁡2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186495059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76a2fca9-a004-56dc-bcb9-7a9d56bf96b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494570} {:answer/id #uuid "807c89b0-1baf-5d8a-afd4-cecf678b8f6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡6" :db/id #edb/ref 17592186494600} {:answer/id #uuid "83e55904-4dad-5f50-9ed8-a699c5c350a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186494608} {:answer/id #uuid "b4dca2c1-f3a5-573b-82d7-9841c885f465" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{ln}⁡3" :db/id #edb/ref 17592186494739} {:answer/id #uuid "ebf26341-3745-5f43-a14c-cda67d69e390" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494880}] :answer-field/correct {:db/id #edb/ref 17592186494608} :answer-field/id #uuid "91b5b4ea-2fbf-58c6-b385-fcfece3b9311" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494987}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11be1c1c-7eab-52eb-aab8-c16c55806ef6" :question/math-academy-id "q-160917" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}\\frac{y-2x}{y+2x}\\,dxdy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,0\\le y-2x\\le 2,\\,2\\le y+2x\\le 6\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n0\\le y-2x\\le 2,\\,2\\le y+2x\\le 6,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-2x\\,\\text{and}\\,v=y+2x.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,0\\le u\\le 2,\\,2\\le v\\le 6\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ \\text{ }\\text{ }\\text{ }2 & 1\\end{vmatrix} \\\\  & =-4.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{4}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y-2x}{y+2x}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}\\frac{u}{v}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{u}{v}|-\\frac{1}{4}|\\text{d}u\\text{d}v \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u[{\\int }_{2}^{6}\\frac{1}{v}\\,dv]du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u[\\operatorname{ln}⁡|v|]_{2}^{6}\\,du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u(\\operatorname{ln}⁡6-\\operatorname{ln}⁡2)\\,du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u\\cdot \\operatorname{ln}⁡3\\,du \\\\  & =\\frac{\\operatorname{ln}⁡3}{4}{[\\frac{1}{2}{u}^{2}]}_{0}^{2} \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186495100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36ad6cac-d25a-50df-a71c-ff5530463782" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-4\\pi " :db/id #edb/ref 17592186494431} {:answer/id #uuid "377131c4-9276-5492-90f4-5fe9f9ea094b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2\\pi }" :db/id #edb/ref 17592186494433} {:answer/id #uuid "389c158d-eca4-5138-ade2-702a2174ac43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(2\\pi -1)" :db/id #edb/ref 17592186494436} {:answer/id #uuid "76f8296f-42f1-5d17-a5c6-7274b014898c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{12}{\\pi }" :db/id #edb/ref 17592186494571} {:answer/id #uuid "adfbcfe0-1ed2-552d-9eab-c92cbe93246a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{6\\pi }" :db/id #edb/ref 17592186494723}] :answer-field/correct {:db/id #edb/ref 17592186494571} :answer-field/id #uuid "caaee621-928c-5865-8689-d0a675bcc7ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495012}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75903bf3-d1b7-5813-a3cf-49663583fcbd" :question/math-academy-id "q-160915" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}\\frac{{y}^{2}}{{x}^{2}}\\operatorname{sin}⁡(\\pi xy)\\,dxdy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,1\\le xy\\le 4,\\,1\\le \\frac{y}{x}\\le 5\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le xy\\le 4,\\,1\\le \\frac{y}{x}\\le 5,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=xy\\,\\text{and}\\,v=\\frac{y}{x}.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,1\\le v\\le 5\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\text{ }\\text{ }\\text{ }y & x \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{vmatrix} \\\\  & =\\frac{2y}{x}.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(\\frac{2y}{x}\\right)}=\\frac{1}{2v}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{{y}^{2}}{{x}^{2}}\\operatorname{sin}⁡(\\pi xy)\\,\\text{d}x\\text{d}y & ={∬}_{D}{\\left(\\frac{y}{x}\\right)}^{2}\\operatorname{sin}⁡(\\pi xy)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{Δ}{v}^{2}\\operatorname{sin}⁡(\\pi u)|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\operatorname{sin}⁡(\\pi u)|\\frac{1}{2v}|\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u)[{\\int }_{1}^{5}v\\,dv]du \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u){[\\frac{1}{2}\\,{v}^{2}]}_{1}^{5}\\,du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\operatorname{sin}⁡(\\pi u)\\cdot 12\\,du \\\\  & =6{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u)\\,du \\\\  & =6{[-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi u)]}_{1}^{4} \\\\  & =-\\frac{6}{\\pi }(1-(-1)) \\\\  & =-\\frac{12}{\\pi }.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "367ab4f2-93bc-5938-9462-dc0e018dd590" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨\\frac{1}{2},\\frac{3}{2},\\frac{1}{2}⟩+t\\,⟨1,0,1⟩" :db/id #edb/ref 17592186496776} {:answer/id #uuid "399e3797-afa8-52bc-9d91-1f755a50f199" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,1⟩+t\\,⟨1,1,1⟩" :db/id #edb/ref 17592186496783} {:answer/id #uuid "d59ec8f6-4eba-53b8-a3b8-5a5f6ce7e72d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,1⟩+t\\,⟨\\frac{1}{2},0,\\frac{1}{2}⟩" :db/id #edb/ref 17592186497104} {:answer/id #uuid "db86fc5b-7216-54fe-8379-494c5e62c9fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨\\frac{1}{2},\\frac{3}{2},\\frac{1}{2}⟩+t\\,⟨\\frac{1}{2},0,\\frac{1}{2}⟩" :db/id #edb/ref 17592186497123} {:answer/id #uuid "fbc71725-cf86-521b-8c43-ec05f48b2500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,1⟩+t\\,⟨\\frac{1}{2},\\frac{3}{2},\\frac{1}{2}⟩" :db/id #edb/ref 17592186497200}] :answer-field/correct {:db/id #edb/ref 17592186497200} :answer-field/id #uuid "631be222-c76c-5ee5-9b25-874887015acd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497263}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ca2288f3-367d-50c0-9754-21f3665fdec7" :question/math-academy-id "q-71406" :question/problem "Find a vector equation of the normal line to the surface $\\operatorname{ln}⁡(x+y+z)=\\operatorname{ln}⁡(2)-xyz$ at the point $(1,0,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(x+y+z) & =\\operatorname{ln}⁡(2)-xyz \\\\ \\operatorname{ln}⁡(x+y+z)+xyz & =\\operatorname{ln}⁡(2)\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=\\operatorname{ln}⁡(x+y+z)+xyz$, our surface can be viewed as the level surface $f(x,y,z)=\\operatorname{ln}⁡(2).$ \n\nA normal vector to the level surface that passes through the point $(1,0,1)$ can be found by computing $∇f(1,0,1).$ \n\nSo, we find the gradient and evaluate it at $(1,0,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+y+z)+xyz)i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+y+z)+xyz)j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(x+y+z)+xyz)k \\\\  & =(\\frac{1}{x+y+z}+yz)\\text{ }i+(\\frac{1}{x+y+z}+xz)\\text{ }j+(\\frac{1}{x+y+z}+xy)\\text{ }k \\\\ ∇f(1,0,1) & =(\\frac{1}{1+0+1}+(0)(1))\\,i+(\\frac{1}{1+0+1}+(1)(1))\\text{ }j+(\\frac{1}{1+0+1}+(1)(0))\\,k \\\\  & =\\frac{1}{2}\\,i+\\frac{3}{2}\\,j+\\frac{1}{2}\\,k \\\\  & =⟨\\frac{1}{2},\\frac{3}{2},\\frac{1}{2}⟩\\end{aligned}\n$$\n\nFinally, the vector equation of the line that is parallel to $∇f(1,0,1)$ and passes through the point $(1,0,1)$ can be written as\n\n$$\n\\begin{aligned}r & =⟨1,0,1⟩+t\\,∇f(1,0,1)=⟨1,0,1⟩+t\\,⟨\\frac{1}{2},\\frac{3}{2},\\frac{1}{2}⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186497648 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d15905-64e8-5d18-af76-8acc9e5d07c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186497652} {:answer/id #uuid "4ad8e45f-0ef5-5613-af41-2fd293933b76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186497659} {:answer/id #uuid "53d58eb0-0d8f-5cbb-9b43-03bddd83341c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186497660} {:answer/id #uuid "5d488039-835c-51f7-98f3-a614ceeaa760" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186497663} {:answer/id #uuid "5e52e799-9a4a-574e-8348-452560e7951d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186497664}] :answer-field/correct {:db/id #edb/ref 17592186497660} :answer-field/id #uuid "34df9243-805f-538d-a45b-1fa7022afbc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497655}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0dfb24ed-71db-576c-87d7-7b45fd0ad875" :question/problem "Let $g=\\begin{bmatrix}{r}^{2} \\\\ -2 \\\\ -2\\end{bmatrix}$ and $h=\\begin{bmatrix}4 \\\\ {r}^{2} \\\\ 3\\end{bmatrix}.$ Given that $g⊥h$ and $r>0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 4+(-2)\\cdot {r}^{2}+(-2)\\cdot 3 \\\\  & =4{r}^{2}-2{r}^{2}-6 \\\\  & =2{r}^{2}-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-6 & =0 \\\\ 2{r}^{2} & =6 \\\\ {r}^{2} & =3 \\\\ r & =\\pm \\sqrt{3}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $r>0.$ Therefore, $r=\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186497657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e71aa6-0dd2-528b-82f1-c11f714a943c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186497645} {:answer/id #uuid "31546151-ec15-571b-a3a0-a043f97c6ce6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186497653} {:answer/id #uuid "8c9d1a62-29c0-5978-a42e-05d68ed3f2c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{10}" :db/id #edb/ref 17592186497674} {:answer/id #uuid "b6def8f7-fa98-5672-a10e-3350a588cd82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186497682} {:answer/id #uuid "cf664727-ae67-5808-8037-46c3d58535a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{10}}{10}" :db/id #edb/ref 17592186497686}] :answer-field/correct {:db/id #edb/ref 17592186497674} :answer-field/id #uuid "e7fa0ba8-9797-51f1-a1a3-612a76531ff7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497691}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "38cba23b-122c-5771-b6e6-8755391889ee" :question/problem "Let $u=\\begin{bmatrix}a \\\\ 2 \\\\ 3\\end{bmatrix}$ and $v=\\begin{bmatrix}a \\\\ -2 \\\\ -2\\end{bmatrix}.$ Given that $u⊥v$ and $a<0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =a\\cdot a+2\\cdot (-2)+3\\cdot (-2) \\\\  & ={a}^{2}-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ {a}^{2}-10 & =0 \\\\ {a}^{2} & =10 \\\\ a & =\\pm \\sqrt{10}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-\\sqrt{10}.$"}] [{:db/id #edb/ref 17592186497669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4110b4e-1a2c-578a-8eae-e4ee8ea9f987" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186497681}] :answer-field/correct {:db/id #edb/ref 17592186497681} :answer-field/id #uuid "580d3caf-8d8c-5d43-990c-bd6328480355" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497662}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "773eaa1c-93aa-5388-970f-8375245372c9" :question/problem "If $c=\\begin{bmatrix}k \\\\ 3k \\\\ -4\\end{bmatrix},$ $d=\\begin{bmatrix}-3 \\\\ 2 \\\\ 2\\end{bmatrix},$ and $c⊥d,$ then $k=${{field-1}}." :question/worked-solution "We know that $c⊥d$ ($c$ and $d$ are perpendicular) if and only if $c\\cdot d=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+3k\\cdot 2+(-4)\\cdot 2 \\\\  & =-3k+6k-8 \\\\  & =3k-8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ 3k-8 & =0 \\\\ k & =\\frac{8}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b3972e-c239-511d-a71c-02f341be9035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{30}}{15}" :db/id #edb/ref 17592186497646} {:answer/id #uuid "2bd291ac-ba38-5d8a-a0e8-3f5f1fe8366e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{15}{2}" :db/id #edb/ref 17592186497650} {:answer/id #uuid "2c7913a5-a7e3-5bdd-8171-688ecb016f91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{30}}{2}" :db/id #edb/ref 17592186497651} {:answer/id #uuid "99847163-4548-58d7-8f0d-3fe134152ee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{30}}{2}" :db/id #edb/ref 17592186497677} {:answer/id #uuid "f30e7da8-4149-5bae-bf57-17a518398e8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186497693}] :answer-field/correct {:db/id #edb/ref 17592186497677} :answer-field/id #uuid "0dd99b61-9868-53dd-b83f-1601d4f65c22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497647}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7db3af69-69b0-5a51-a3ca-bf5d1a73cdb2" :question/problem "Let $g=\\begin{bmatrix}4{r}^{2} \\\\ -2 \\\\ -10\\end{bmatrix}$ and $h=\\begin{bmatrix}2 \\\\ 2{r}^{2} \\\\ 3\\end{bmatrix}.$ Given that $g⊥h$ and $r<0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & =4{r}^{2}\\cdot 2+(-2)\\cdot 2{r}^{2}+(-10)\\cdot 3 \\\\  & =8{r}^{2}-4{r}^{2}-30 \\\\  & =4{r}^{2}-30.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 4{r}^{2}-30 & =0 \\\\ 4{r}^{2} & =30 \\\\ {r}^{2} & =\\frac{15}{2} \\\\ r & =\\pm \\frac{\\sqrt{30}}{2}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\frac{\\sqrt{30}}{2}.$"}] [{:db/id #edb/ref 17592186497673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63819dbc-3f41-5891-90a4-cfb3d79f6d2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186497665} {:answer/id #uuid "64b8a2f4-8a4c-594f-b127-67b2ef09e03a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{24}{5}" :db/id #edb/ref 17592186497666} {:answer/id #uuid "9db5fe94-6940-5997-81bf-5f9c1b0e4a07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{30}}{5}" :db/id #edb/ref 17592186497680} {:answer/id #uuid "db36b01b-c74b-5c77-9f0e-c9e4710cea66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2\\sqrt{30}}{5}" :db/id #edb/ref 17592186497689} {:answer/id #uuid "e8d6ae85-eb27-5a4a-b111-5532e22cf397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{30}}{12}" :db/id #edb/ref 17592186497692}] :answer-field/correct {:db/id #edb/ref 17592186497689} :answer-field/id #uuid "7ba1b053-f29b-56e3-92de-9c65917d5a48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497670}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "85909f08-7094-52c8-bf85-b4e47bc2b8a0" :question/problem "Let $g=\\begin{bmatrix}3{r}^{2} \\\\ -2 \\\\ -8\\end{bmatrix}$ and $h=\\begin{bmatrix}3 \\\\ 2{r}^{2} \\\\ 3\\end{bmatrix}.$ Given that $g⊥h$ and $r<0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & =3{r}^{2}\\cdot 3+(-2)\\cdot 2{r}^{2}+(-8)\\cdot 3 \\\\  & =9{r}^{2}-4{r}^{2}-24 \\\\  & =5{r}^{2}-24.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 5{r}^{2}-24 & =0 \\\\ 5{r}^{2} & =24 \\\\ {r}^{2} & =\\frac{24}{5} \\\\ r & =\\pm \\frac{2\\sqrt{30}}{5}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\frac{2\\sqrt{30}}{5}.$"}] [{:db/id #edb/ref 17592186497687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b27be4c-f581-5458-a959-2633136524b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186497678}] :answer-field/correct {:db/id #edb/ref 17592186497678} :answer-field/id #uuid "7ff7f755-1ffc-5fd4-8059-46a3459e8c06" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497672}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d00137d5-07f7-5c87-9146-2b0f0101752e" :question/problem "Let $a=⟨{x}^{2},-1⟩$ and $b=⟨2,2⟩.$ If $a⊥b$ and $x<0,$ then $x=${{field-1}}." :question/worked-solution "We know that $a⊥b$ ($a$ and $b$ are perpendicular) if and only if $a\\cdot b=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & ={x}^{2}\\cdot 2+(-1)\\cdot 2 \\\\  & =2{x}^{2}-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2{x}^{2}-2 & =0 \\\\ 2{x}^{2} & =2 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $x<0.$ Therefore, $x=-1.$"}] [{:db/id #edb/ref 17592186497690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d1acb72-e017-5d70-8eb9-4fdfdb674352" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186497679}] :answer-field/correct {:db/id #edb/ref 17592186497679} :answer-field/id #uuid "8ca76dfd-af74-5089-be0d-ba18af8c7da4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497675}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e46cbde8-81fd-5138-9b25-b9d9d745ebf8" :question/problem "Let $g=\\begin{bmatrix}4{r}^{2} \\\\ -4 \\\\ -9\\end{bmatrix}$ and $h=\\begin{bmatrix}4 \\\\ 3{r}^{2} \\\\ 2\\end{bmatrix}.$ Given that $g⊥h$ and $r<0$, find the value of $r.$\n\n$r=${{field-1}}." :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & =4{r}^{2}\\cdot 4+(-4)\\cdot 3{r}^{2}+(-9)\\cdot 2 \\\\  & =16{r}^{2}-12{r}^{2}-18 \\\\  & =4{r}^{2}-18.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 4{r}^{2}-18 & =0 \\\\ 4{r}^{2} & =18 \\\\ {r}^{2} & =\\frac{9}{2} \\\\ r & =\\pm \\frac{3\\sqrt{2}}{2}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\frac{3\\sqrt{2}}{2}.$"}] [{:db/id #edb/ref 17592186497694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42db0ff9-268e-5f06-9ee9-a7a292ada277" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186497658} {:answer/id #uuid "541c0827-2258-5054-8eab-97190e4c34ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186497661} {:answer/id #uuid "6e1e2d11-8aba-58cf-8e55-5dc3a26baf88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186497667} {:answer/id #uuid "9772a7d0-6381-5b37-bd93-ae02579c6810" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186497676} {:answer/id #uuid "bf0f7956-57e7-5c50-a0a6-2bb730385d88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186497683}] :answer-field/correct {:db/id #edb/ref 17592186497667} :answer-field/id #uuid "d9d772c8-782b-58a2-9298-f17510ff6220" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497688}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f59e3fe2-2803-5ba9-843a-699370832a34" :question/problem "Let $g=\\begin{bmatrix}3{r}^{2} \\\\ -4 \\\\ -6\\end{bmatrix}$ and $h=\\begin{bmatrix}4 \\\\ 2{r}^{2} \\\\ 3\\end{bmatrix}.$ Given that $g⊥h$ and $r>0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & =3{r}^{2}\\cdot 4+(-4)\\cdot 2{r}^{2}+(-6)\\cdot 3 \\\\  & =12{r}^{2}-8{r}^{2}-18 \\\\  & =4{r}^{2}-18.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 4{r}^{2}-18 & =0 \\\\ 4{r}^{2} & =18 \\\\ {r}^{2} & =\\frac{9}{2} \\\\ r & =\\pm \\frac{3\\sqrt{2}}{2}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $r>0.$ Therefore, $r=\\frac{3\\sqrt{2}}{2}.$"}] [{:db/id #edb/ref 17592186497695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "338258b5-5456-514c-8754-93cf8061091f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186497654} {:answer/id #uuid "38237f4f-5129-5256-b140-edb70815c42b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{30}}{10}" :db/id #edb/ref 17592186497656} {:answer/id #uuid "714a3214-aa60-50f0-aade-4841169775f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186497668} {:answer/id #uuid "c06c6172-5411-5aa2-9336-178c2ad14341" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186497684} {:answer/id #uuid "cec53d7c-f38a-5d49-be8a-32db3b6b3e54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186497685}] :answer-field/correct {:db/id #edb/ref 17592186497668} :answer-field/id #uuid "14f6fb08-46af-5637-b16c-c9f11df73b8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497649}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff91a7cd-801d-551f-898a-f82e597274c3" :question/problem "Let $g=\\begin{bmatrix}4{r}^{2} \\\\ -3 \\\\ -10\\end{bmatrix}$ and $h=\\begin{bmatrix}3 \\\\ 2{r}^{2} \\\\ 2\\end{bmatrix}.$ Given that $g⊥h$ and $r>0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & =4{r}^{2}\\cdot 3+(-3)\\cdot 2{r}^{2}+(-10)\\cdot 2 \\\\  & =12{r}^{2}-6{r}^{2}-20 \\\\  & =6{r}^{2}-20.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 6{r}^{2}-20 & =0 \\\\ 6{r}^{2} & =20 \\\\ {r}^{2} & =\\frac{10}{3} \\\\ r & =\\pm \\frac{\\sqrt{30}}{3}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $r>0.$ Therefore, $r=\\frac{\\sqrt{30}}{3}.$"}] [{:db/id #edb/ref 17592186497705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4bbf587-3553-5e25-9c63-d085afe9f937" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-27.91" :db/id #edb/ref 17592186497734}] :answer-field/correct {:db/id #edb/ref 17592186497734} :answer-field/id #uuid "9dbd49e0-802f-508b-a96d-d180f87760a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497729}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "29abbae9-5af8-5c1b-bfb4-e61982673964" :question/problem "If $a=⟨3.9,-2.5,4.3⟩$ and $b=⟨-5,-3,-3.7⟩,$ then $a\\cdot b=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3.9\\cdot (-5)+(-2.5)\\cdot (-3)+4.3\\cdot (-3.7) \\\\  & =-19.5+7.5-15.91 \\\\  & =-27.91.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5056bbc1-c0cc-5aa9-aea4-7399e53fe36f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.12" :db/id #edb/ref 17592186497715}] :answer-field/correct {:db/id #edb/ref 17592186497715} :answer-field/id #uuid "1254ebf1-caa7-5616-a895-3d50e99e4b22" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497697}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "499b28bf-8c43-53e7-8518-5a6cf677d6ae" :question/problem "If $a=⟨3.8,3.6,-1.1⟩$ and $b=⟨3.2,-3.4,-2⟩,$ then $a\\cdot b=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3.8\\cdot 3.2+3.6\\cdot (-3.4)+(-1.1)\\cdot (-2) \\\\  & =12.16-12.24+2.2 \\\\  & =2.12.\\end{aligned}\n$$"}]}
