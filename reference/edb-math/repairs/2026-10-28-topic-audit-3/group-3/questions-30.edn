17592186045493} :db/id #edb/ref 17592186102608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b7fa7f1d-963f-5878-b4cb-ed2a7ee6c561" :question/math-academy-id "q-20016" :question/problem "Calculate the area of the $△ABC$, if $A(1, 1, 0)$, $B(3, 2, 2)$, $C(1, 2, 1)$."}] [{:db/id #edb/ref 17592186106123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e79b7a5-a889-5636-81a6-5c628d9606ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186284912} {:answer/id #uuid "78d9ff09-0da1-5a53-8355-bac5cd8c3dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186285912} {:answer/id #uuid "a718ab84-4198-545d-bdfa-d0f5048065c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186286310} {:answer/id #uuid "b63ac272-c912-57b7-9e69-82262d25e7e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186286451} {:answer/id #uuid "e47df95b-3077-5100-92fa-f72c23d2e1f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286879}] :answer-field/correct {:db/id #edb/ref 17592186284912} :answer-field/id #uuid "3b4dc220-3cdd-52b1-9314-1cc837d05799" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287270}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7799a52e-21d3-584f-93c3-f00bb69321c0" :question/math-academy-id "q-20026" :question/problem "Calculate the area of the $△\\,PQR$, if $P(4,7,3)$, $Q(5,6,2)$, $R(3,8,3).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(5i+6j+2k)-(4i+7j+3k) \\\\  & =i-j-k \\\\  & =⟨1,-1,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(3i+8j+3k)-(4i+7j+3k) \\\\  & =-i+j \\\\  & =⟨-1,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =\\begin{vmatrix}i & j & k \\\\ 1 & -1 & -1 \\\\ -1 & 1 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & -1 \\\\ 1 & 0\\end{vmatrix}i-\\begin{vmatrix}1 & -1 \\\\ -1 & 0\\end{vmatrix}j+\\begin{vmatrix}1 & -1 \\\\ -1 & 1\\end{vmatrix}k \\\\  & =((-1)\\cdot 0-1\\cdot (-1))i-(1\\cdot 0-(-1)\\cdot (-1))j+(1\\cdot 1-(-1)\\cdot (-1))k \\\\  & =i+j \\\\  & =⟨1,1,0⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$"}] [{:db/id #edb/ref 17592186106124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b1cac9a-d8ad-501d-b0a6-a0a1bebe9636" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186285345} {:answer/id #uuid "3cf88e45-9bac-51c6-a90f-f80f508a8095" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186285363} {:answer/id #uuid "46574c64-b2d9-52a5-ba20-5c4e8f687459" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186285432} {:answer/id #uuid "61a98581-4f83-59f8-a0f9-f6ec11524a8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{2}}{3}" :db/id #edb/ref 17592186285684} {:answer/id #uuid "6cd903e1-1e62-5f4c-86df-6c375dc3361d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{6}}{2}" :db/id #edb/ref 17592186285787}] :answer-field/correct {:db/id #edb/ref 17592186285345} :answer-field/id #uuid "c5b8bbd2-699b-5127-b6f0-02f2e8c72c29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287551}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "95f6f3a1-caa9-5902-b6fb-cb14398f3fb9" :question/math-academy-id "q-20027" :question/problem "Calculate the length of the altitude $CH$ of the $△\\,ABC$, if $A(2,1,2)$, $B(1,2,1)$, $C(3,2,3).$" :question/requires-calculator true :question/worked-solution "Note that the length of the altitude $CH$ can be related to the area of $△\\,ABC$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}CH\\cdot AB\n$$\n\nSo, to find $CH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(i+2j+k)-(2i+j+2k) \\\\  & =-i+j-k \\\\  & =⟨-1,1,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+2j+3k)-(2i+j+2k) \\\\  & =i+j+k \\\\  & =⟨1,1,1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}i & j & k \\\\ -1 & 1 & -1 \\\\ 1 & 1 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 1 & 1\\end{vmatrix}i-\\begin{vmatrix}-1 & -1 \\\\ 1 & 1\\end{vmatrix}j+\\begin{vmatrix}-1 & 1 \\\\ 1 & 1\\end{vmatrix}k \\\\  & =(1\\cdot 1-1\\cdot (-1))i-((-1)\\cdot 1-1\\cdot (-1))j+((-1)\\cdot 1-1\\cdot 1)k \\\\  & =2i-2k \\\\  & =⟨2,0,-2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{2}^{2}+{0}^{2}+(-2)^{2}} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{2}}{2}=\\sqrt{2}.\n$$\n\nLet's also compute $AB$ since it appears in the formula:\n\n$$\n\\begin{aligned}AB & =|\\overset{\\to }{AB}| \\\\  & =\\sqrt{(-1)^{2}+{1}^{2}+(-1)^{2}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}CH\\cdot AB,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}CH\\cdot AB \\\\ \\sqrt{2} & =\\frac{1}{2}CH\\cdot \\sqrt{3} \\\\ 2\\sqrt{2} & =CH\\cdot \\sqrt{3} \\\\ CH & =\\frac{2\\sqrt{2}}{\\sqrt{3}} \\\\ CH & =\\frac{2\\sqrt{6}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91d02db9-e77b-5b70-bf52-95157c6b371c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{30}}{5}" :db/id #edb/ref 17592186102627} {:answer/id #uuid "b8541fc0-8462-5904-9145-c20fc56387a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{6}" :db/id #edb/ref 17592186102628} {:answer/id #uuid "c06d702c-89e5-5852-9582-6fca6d927ab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{30}}{5}" :db/id #edb/ref 17592186102629} {:answer/id #uuid "36fa653c-a96d-5d43-9c00-e68c6671ede2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186102630} {:answer/id #uuid "376be9ee-03ee-58c2-9786-34782438fca0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{30}}{6}" :db/id #edb/ref 17592186102631}] :answer-field/id #uuid "dc647480-b80a-5e28-afb7-8bed712a7f58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186102626}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "74c42862-54b5-59d3-9fc0-d15a552d30c2" :question/math-academy-id "q-20028" :question/problem "Calculate the length of the altitude $RH$ of the $△PRQ$, if $P(1,-2, 3)$, $Q(3, 2, 3)$, $R(2, 1, 4)$.\n\n> A calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186106213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1000e887-f114-51b9-b67a-d436889f9bb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186288151} {:answer/id #uuid "4f6cbdef-32ec-5499-a6bd-ce420ddec4fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288580} {:answer/id #uuid "812d7309-b400-5fd3-bd24-0d8abc7cac68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186288903} {:answer/id #uuid "a7847429-4b08-529a-a14c-c8cbd6af9359" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186289142} {:answer/id #uuid "dfa64626-acf1-57f9-bd83-06342e759333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186289525}] :answer-field/correct {:db/id #edb/ref 17592186288580} :answer-field/id #uuid "2edfa40a-17b0-5eff-898c-e2c29a2c872d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289836}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "71a079d2-97d0-5455-a26c-8d71df225e2c" :question/math-academy-id "q-236734" :question/problem "Let $p=⟨-1,1,2⟩$ and $q=⟨4,x,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 4+1\\cdot x+2\\cdot 1 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32a9b8e6-e5c7-5386-b6a4-a0340f010993" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186288364} {:answer/id #uuid "485ef75c-1b41-5e2a-a66c-0c07edb72c16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186288532} {:answer/id #uuid "61691320-cd84-5b8a-b32e-847e76c40d8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186288713} {:answer/id #uuid "e150dd45-0881-5820-a874-6959ab85bc53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186289535} {:answer/id #uuid "f232237e-47c0-523d-897d-f50021d1ccdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186289632}] :answer-field/correct {:db/id #edb/ref 17592186288713} :answer-field/id #uuid "71f1aa2c-7ea0-5d2e-810c-4873abf36f67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289980}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f961e7bf-40d0-5b4f-86c7-b36ac1e85bd7" :question/math-academy-id "q-236735" :question/problem "Let $p=\\begin{bmatrix}6 \\\\ 1 \\\\ 4\\end{bmatrix}$ and $q=\\begin{bmatrix}x \\\\ 4 \\\\ -4\\end{bmatrix}.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =6\\cdot x+1\\cdot 4+4\\cdot (-4) \\\\  & =6x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 6x-12 & =0 \\\\ 6x & =12 \\\\ x & =2.\\end{aligned}\n$$"}]}
