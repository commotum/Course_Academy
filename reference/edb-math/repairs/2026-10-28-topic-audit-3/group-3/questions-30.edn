#{[{:db/id #edb/ref 17592186088322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e887380e-c6a2-55c5-a953-644c684c42f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $5$" :db/id #edb/ref 17592186086587} {:answer/id #uuid "022e8e85-f2f9-5f22-89c3-32299f61eba1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2\\sqrt{10}$ and $6$" :db/id #edb/ref 17592186086588} {:answer/id #uuid "25b8aed4-093a-5a57-ad29-a6f742a77db5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $2$" :db/id #edb/ref 17592186086589} {:answer/id #uuid "37b46b49-d523-50f1-9995-b5a05ce4f820" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $3$" :db/id #edb/ref 17592186086590} {:answer/id #uuid "60da5fd4-8377-57c4-87c2-582cca3b9c69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $3$" :db/id #edb/ref 17592186086591}] :answer-field/correct {:db/id #edb/ref 17592186086588} :answer-field/id #uuid "dc165d99-699e-586e-b731-222ff1843dbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086586}] :question/id #uuid "256fdb5e-1d5d-5f2a-8bad-6f30d3b32832" :question/math-academy-id "q-7600" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation\n$\\frac{x^{2}}{10} + \\frac{y^{2}}{9} = 1$?" :question/worked-solution "Compare with $\\frac{x^2}{a^2}+\\frac{y^2}{b^2}=1$. Here $a=\\sqrt{10}$ and $b=3$, with $a>b$. The lengths of the major and minor axes are therefore\n\n$$\n2a=2\\sqrt{10},\\qquad2b=6.\n$$"}] [{:db/id #edb/ref 17592186088323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f245cc5-cf66-5e23-941f-5ed3c61f8519" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2{x}^{2}}{7}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186342368} {:answer/id #uuid "2aaf0f54-99ea-5f51-b032-c17b629e54df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186342595} {:answer/id #uuid "b0519dd2-e0e8-5e54-915c-ce7ec5a247b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9{x}^{2}}{24}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186343788} {:answer/id #uuid "f625dd86-0749-5723-adf5-e39041ad4f8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344405} {:answer/id #uuid "fb39f685-9e2f-50ea-ae5a-250fc73349a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344448}] :answer-field/correct {:db/id #edb/ref 17592186344405} :answer-field/id #uuid "65e8416d-99db-5904-9535-5182a7fbb499" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344665}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f8eff0d-f84c-5907-a2c9-a5a7eb91d57f" :question/math-academy-id "q-7603" :question/problem "![](images/8a/8ac809353e7834d328d645fafb5c02e17386ba087e778a841865ef6313893e79.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=\\frac{7}{2}$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3.5}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{\\left(\\frac{7}{2}\\right)}^{2}}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{\\left(\\frac{{7}^{2}}{{2}^{2}}\\right)}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{\\left(\\frac{49}{4}\\right)}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17dbb695-a8da-50c8-bbc0-8305a0e101a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186342448} {:answer/id #uuid "2fb68ca0-59ba-5dad-94a0-0b73ef26ecfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186342636} {:answer/id #uuid "99b15d26-b6be-5ef3-a9cf-fd12150a374e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186343589} {:answer/id #uuid "a9d29486-cbd3-56cc-baa6-eb5af1fe093e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186343737} {:answer/id #uuid "bb629a7c-214b-5b78-9be1-51f1b708557d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186343886}] :answer-field/correct {:db/id #edb/ref 17592186342636} :answer-field/id #uuid "6cdedc79-da92-5992-bc36-02e000bd1509" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344689}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "808bb938-3f2e-5c94-82a4-205181f5d6ac" :question/math-academy-id "q-7604" :question/problem "![](images/d2/d2c35e72acad77ae747c6a78c9794e9b076c047891d4b12d5c9b3176bdc6dde5.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=4$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ \\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92d9a932-277e-5479-a0ef-d4e0d662da4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{9} + \\frac{y^{2}}{4} = 1" :db/id #edb/ref 17592186086605} {:answer/id #uuid "9e1b8dd5-2fdf-5ae1-b381-7df76cf18c0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{16} + \\frac{y^{2}}{9} = 1" :db/id #edb/ref 17592186086606} {:answer/id #uuid "18331ea6-dd35-58c4-a87b-66e41b8a0158" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{3} + \\frac{y^{2}}{4} = 1" :db/id #edb/ref 17592186086607} {:answer/id #uuid "70187839-c8fc-50ea-8e78-c929f95a7f65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{9} + \\frac{y^{2}}{16} = 1" :db/id #edb/ref 17592186086608} {:answer/id #uuid "7f852fe4-272e-5d76-b674-33cd9f6c8153" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{4} + \\frac{y^{2}}{3} = 1" :db/id #edb/ref 17592186086609}] :answer-field/correct {:db/id #edb/ref 17592186086608} :answer-field/id #uuid "f771dc03-583e-530f-908d-e69dc267d68e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086604}] :question/id #uuid "f0ef5818-9fef-50e7-a456-afae14c51c79" :question/math-academy-id "q-7605" :question/problem "![](images/df/dfda198c093371945608318353c997435f2d388ca62f94cc3d27f49cfaf14cb8.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "The graph crosses the $x$-axis at $\\pm3$ and the $y$-axis at $\\pm4$. Thus the horizontal and vertical semiaxes are $3$ and $4$, respectively. Its equation is\n\n$$\n\\frac{x^2}{3^2}+\\frac{y^2}{4^2}=1,\\qquad\\text{or}\\qquad\\frac{x^2}{9}+\\frac{y^2}{16}=1.\n$$"}] [{:db/id #edb/ref 17592186096447 :question/id #uuid "2a61b115-4e26-5966-b2a9-d2fedef6b728" :question/math-academy-id "e-4282" :question/problem "The vector $\\mathbf{a}$ has magnitude $3$. Find a unit vector that is parallel to $\\mathbf{a}$." :question/worked-solution "To obtain the unit vector that is parallel to $\\mathbf{a}$, we divide $\\mathbf{a}$ by its length:\n\n$$\n\\mathbf{u}=\\dfrac{\\mathbf{a}}{\\mid \\,\\mathbf{a}\\, \\mid}=\\dfrac{1}{3}\\mathbf{a}\n$$"}] [{:db/id #edb/ref 17592186096448 :question/id #uuid "23d9a601-974b-51c2-a6ea-0ebadde19efc" :question/math-academy-id "e-4283" :question/problem "The vector $\\mathbf{a}$ is directed horizontally to the right and has magnitude $10$, while the vector $\\mathbf{b}$ is directed vertically down and has magnitude $20$. Find a unit vector that is parallel to $\\mathbf{a+b}$." :question/worked-solution "First, we have to find $\\mathbf{a+b}$. According to the triangle law of addition, the resultant $\\mathbf{a}+\\mathbf{b}$ goes from the tail of $\\mathbf{a}$ to the head of $\\mathbf{b}$:\n\n![](images/32/32c48d8c19fc68fbc172b240ded922f3e2ebc12804411c318ff63fe999aaedcc.png)\n\nTo find the unit vector corresponding to $\\mathbf{a+b}$, we have to divide by the magnitude:\n\n$$\n\\begin{aligned}\nu &= \\frac{a + b}{\\mid a + b \\mid}\n\\end{aligned}\n$$\n\nTo find the magnitude, first notice that we obtain a right triangle. So, we can use the Pythagorean theorem:\n\n$$\n\\begin{aligned}{|\\mathbf{a}\\mathbf{+}\\mathbf{b}|}^{2} & ={|\\mathbf{a}|}^{2}+{|\\mathbf{b}|}^{2} \\\\  & ={10}^{2}+{20}^{2} \\\\  & =100+400 \\\\  & =500\\end{aligned}\n$$\n\nTherefore, the magnitude is\n\n$$\n\\begin{aligned}\n\\mid \\mathbf{a+b} &= \\sqrt{500}=10\\sqrt{5}\n\\end{aligned}\n$$\n\nand the corresponding unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{a + b}{\\mid a + b \\mid} \\\\\n&= \\frac{1}{10\\sqrt{5}}(a + b)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096493 :question/id #uuid "6dfe09f0-30e2-53bc-a8f6-d7e4a3b8232a" :question/math-academy-id "e-5181" :question/problem "![](images/d3/d3042242136b82b867b8bd7911761ee38318924df0c9979488d20f04117c45d9.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $\\mathbf a$." :question/worked-solution "![](images/b3/b316448c885a20a7ed60871ce0f1a4dc4f77bd4658dc6eda3407fb3c89a088cb.png)\n\nIn $\\bigtriangleup AHB$ we have\n\n$$\n\\angle AHB = 90^\\circ\n$$\n\n, $AH=3$ and $BH=2$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^{2} + BH^{2}} \\\\\n&= \\sqrt{3^{2} + 2^{2}} \\\\\n&= \\sqrt{9 + 4} \\\\\n&= \\sqrt{13}\n\\end{aligned}\n$$\n\nHence, the magnitude of $\\mathbf{a}$ is $\\sqrt{13}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{\\mid a \\mid} \\cdot a \\\\\n&= \\frac{1}{\\sqrt{13}}a\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be1529be-a7de-5974-b991-d60dde835856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5a" :db/id #edb/ref 17592186093789} {:answer/id #uuid "d540dace-2707-5500-b5c4-ab774e31fbd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186093790} {:answer/id #uuid "03b0e61c-7ea0-5634-9db6-b0e0196b04fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}a" :db/id #edb/ref 17592186093791} {:answer/id #uuid "40cede01-8d57-5e23-8ad3-1718dcad0ad6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{20}a" :db/id #edb/ref 17592186093792} {:answer/id #uuid "6da8d0ca-8218-54d1-b8e7-7f100838a138" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}a" :db/id #edb/ref 17592186093793}] :answer-field/id #uuid "45156f70-5185-5291-966e-5fa7eea23fa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186093788}] :question/id #uuid "b156a92a-15b2-528d-ba13-ee9f57edd97d" :question/math-academy-id "q-11376" :question/problem "The vector $a$ has magnitude $5$. Find a unit vector that is parallel to $a$."}] [{:db/id #edb/ref 17592186097042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab0413fa-4042-5147-a3d8-818097bc2626" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{3}}(a + b)" :db/id #edb/ref 17592186094226} {:answer/id #uuid "c81ea504-05ac-5c44-a92e-1630193abb8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}(a + b)" :db/id #edb/ref 17592186094227} {:answer/id #uuid "d0b9b147-1585-55ec-b881-e10cd196e800" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}(a + b)" :db/id #edb/ref 17592186094228} {:answer/id #uuid "fb5dad94-0917-544d-85f3-4e70f0e93daf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3\\sqrt{3}}(a + b)" :db/id #edb/ref 17592186094229} {:answer/id #uuid "24b28af8-0f33-5293-a88e-61ee2a659e20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}(a + b)" :db/id #edb/ref 17592186094230}] :answer-field/id #uuid "bd239bbe-a8f9-5077-a835-d71f38e1b449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186094225}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f0752f9-cfba-5496-a6dc-d603b64b1e81" :question/math-academy-id "q-12184" :question/problem "The vector $a$ is directed horizontally to the right and has magnitude $3$, while the vector $b$ is directed vertically down and has magnitude $4$. Which of the following is a unit vector that is parallel to $a + b$?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186097043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c27fb23c-7e75-5962-96da-f5d4cdf55baa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{569}}(a + b)" :db/id #edb/ref 17592186094232} {:a