#{[{:db/id #edb/ref 17592186616306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b28e87-413d-5468-8e26-03d5e3269564" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49" :db/id #edb/ref 17592186616293} {:answer/id #uuid "58f71afb-2cd3-5df5-abd2-68e052b6852c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-139" :db/id #edb/ref 17592186616294} {:answer/id #uuid "5d73d2a4-d27e-56bb-ae43-6579efcb2aa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186616297} {:answer/id #uuid "770ea212-4859-566a-885d-2c9ef6c7f156" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186616300} {:answer/id #uuid "fa497b58-0099-5c75-a82f-38a0998df5fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-154" :db/id #edb/ref 17592186616319}] :answer-field/correct {:db/id #edb/ref 17592186616294} :answer-field/id #uuid "8d44acee-879a-50c3-bcd8-deab9d51d0cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186616304}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "97e1a39a-a0d9-543a-afc2-69f3831ace43" :question/problem "If $v=⟨12,11,6,3⟩$ and $w=⟨-2,-8,-2,-5⟩$, then $v\\cdot w=$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}v\\cdot w & ={v}_{1}\\cdot {w}_{1}+{v}_{2}\\cdot {w}_{2}+{v}_{3}\\cdot {w}_{3}+{v}_{4}\\cdot {w}_{4} \\\\  & =12\\cdot (-2)+11\\cdot (-8)+6\\cdot (-2)+3\\cdot (-5) \\\\  & =-24-88-12-15 \\\\  & =-139\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186617185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0735dfb4-3564-5117-80da-a428d10574c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186617172} {:answer/id #uuid "3a86e34c-134b-5a4b-aa70-86e1f80caa22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186617177} {:answer/id #uuid "928a92cd-3053-5a0b-b52a-c5b57961426f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{2}" :db/id #edb/ref 17592186617191} {:answer/id #uuid "a364a8f1-4910-542a-9046-66cb11c8b91e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{3}" :db/id #edb/ref 17592186617195} {:answer/id #uuid "cd78d041-1509-5f72-acf2-4b3806cf564c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186617200}] :answer-field/correct {:db/id #edb/ref 17592186617172} :answer-field/id #uuid "555415cf-9b27-58c5-984c-fbd5879aa444" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617183}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5f7abbd4-dec2-5c26-867c-884441c7a868" :question/problem "Let $u=\\begin{bmatrix}2 \\\\ x\\end{bmatrix}$ and $v=\\begin{bmatrix}3 \\\\ -3x\\end{bmatrix}.$ Given that $u⊥v$ and $x<0$, find the value of $x.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v &={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  &=2\\cdot 3+x\\cdot (-3x) \\\\  &=6-3{x}^{2}.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v &=0 \\\\ 6-3{x}^{2} &=0 \\\\ -3{x}^{2} &=-6 \\\\ {x}^{2} &=2 \\\\ x &=\\pm \\sqrt{2}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $x<0.$ Therefore, $x=-\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186617186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36973881-2e28-572f-b3d1-a79b31072f93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186617175} {:answer/id #uuid "53c6479f-5a38-516c-a15c-4e0b7d0a331f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186617182} {:answer/id #uuid "98991a02-e60e-567a-bb89-0371f8f1d8d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186617193} {:answer/id #uuid "a8277c98-f93b-5bd1-b49b-324347ff8060" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{7}" :db/id #edb/ref 17592186617196} {:answer/id #uuid "f6207953-326f-5b0f-83e2-bd287bccf488" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186617204}] :answer-field/correct {:db/id #edb/ref 17592186617182} :answer-field/id #uuid "76d72f1f-caaa-50cf-99a8-babbdf52cd73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617188}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "66205a0c-f430-588d-b9f8-f9d7605a33a2" :question/problem "Let $g=\\begin{bmatrix}4 \\\\ 8 \\\\ -3{r}^{2}\\end{bmatrix}$ and $h=\\begin{bmatrix}2{r}^{2} \\\\ 4 \\\\ 4\\end{bmatrix}.$ Given that $g⊥h$ and $r>0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h &={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  &=4\\cdot 2{r}^{2}+8\\cdot 4+(-3{r}^{2})\\cdot 4 \\\\  &=8r^{2}+32-12r^{2} \\\\  &=-4{r}^{2}+32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h &=0 \\\\ -4{r}^{2}+32 &=0 \\\\ -4{r}^{2} &=-32 \\\\ {r}^{2} &=8 \\\\ r &=\\pm 2\\sqrt{2}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $r>0.$ Therefore, $r=2\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186617202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4704a2-d926-5ef7-9311-d4fa38e68eae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186617173} {:answer/id #uuid "460341b7-0fcf-52a8-9afb-e123df4ffbe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186617180} {:answer/id #uuid "8b7e63c1-870d-536e-8b08-3968f81da95e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186617190} {:answer/id #uuid "abfeb241-14b5-5220-90df-391ff3ca1a0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186617197} {:answer/id #uuid "f8089312-1c2d-5d4a-b4d7-579e861a0e7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186617205}] :answer-field/correct {:db/id #edb/ref 17592186617205} :answer-field/id #uuid "7ed350f7-a7d4-57b7-934c-f0d62fe57042" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617189}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "df008323-425e-5c7b-99be-1402b2cea408" :question/problem "Let $u=\\begin{bmatrix}-3x \\\\ 9\\end{bmatrix}$ and $v=\\begin{bmatrix}x \\\\ 4\\end{bmatrix}.$ Given that $u⊥v$ and $x>0$, find the value of $x.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v &={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  &=(-3x)\\cdot x+9\\cdot 4 \\\\  &=36-3{x}^{2}.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v &=0 \\\\ 36-3{x}^{2} &=0 \\\\ -3{x}^{2} &=-36 \\\\ {x}^{2} &=12 \\\\ x &=\\pm 2\\sqrt{3}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $x>0.$ Therefore, $x=2\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186617203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c9b2895-590d-50be-8c60-d8aa9c8f1052" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186617178} {:answer/id #uuid "40175792-c438-5c25-aedd-5c39cdf624b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186617179} {:answer/id #uuid "479d01be-6029-5339-a7ff-61c4838f8976" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186617181} {:answer/id #uuid "bcf037ae-cea7-5554-bfd5-20ec0182a811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186617198} {:answer/id #uuid "cd23fe41-a847-5017-9d44-c206e7b2b275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186617199}] :answer-field/correct {:db/id #edb/ref 17592186617178} :answer-field/id #uuid "12e5649d-ed28-53ae-9f00-1bfa7f6270ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617174}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f191eeb3-d803-58d8-bfc3-a95930b102c7" :question/problem "Let $u=\\begin{bmatrix}a \\\\ 2 \\\\ -2\\end{bmatrix}$ and $v=\\begin{bmatrix}a \\\\ -3 \\\\ 3\\end{bmatrix}.$ Given that $u⊥v$ and $a>0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v &={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  &=a\\cdot a+2\\cdot (-3)+(-2)\\cdot 3 \\\\  &={a}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v &=0 \\\\ {a}^{2}-12 &=0 \\\\ {a}^{2} &=12 \\\\ a &=\\pm 2\\sqrt{3}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $a>0.$ Therefore, $a=2\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186617206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58d086b3-e0fa-5bc6-bce8-44fc35dacad4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186617184} {:answer/id #uuid "681f78b5-44ad-58ff-aac6-f8197756b827" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186617187} {:answer/id #uuid "978a3cf2-f70b-52f9-b907-31be75af048c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{10}" :db/id #edb/ref 17592186617192} {:answer/id #uuid "a1a57ebf-1ac9-51f3-b7e1-ef6add107c8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\sqrt{7}" :db/id #edb/ref 17592186617194} {:answer/id #uuid "d08af987-9fad-5eb1-b468-853e91ae6dd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186617201}] :answer-field/correct {:db/id #edb/ref 17592186617187} :answer-field/id #uuid "3860ac6f-2a4c-53d7-affa-c04fde2fe716" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617176}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fc638a72-2c79-53d0-823f-0197be9b90d6" :question/problem "Let $u=\\begin{bmatrix}-3 \\\\ 4 \\\\ a\\end{bmatrix}$ and $v=\\begin{bmatrix}-2 \\\\ -2 \\\\ a\\end{bmatrix}.$ Given that $u⊥v$ and $a<0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v &={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  &=(-3)\\cdot (-2)+4\\cdot (-2)+a\\cdot a \\\\  &={a}^{2}-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v &=0 \\\\ {a}^{2}-2 &=0 \\\\ {a}^{2} &=2 \\\\ a &=\\pm \\sqrt{2}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186617785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3499da-8cb4-5ab0-a38d-17c492370352" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186617271} {:answer/id #uuid "37a24197-bb49-5fe3-a439-8f6029051397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{10}" :db/id #edb/ref 17592186617359} {:answer/id #uuid "96fc41e0-a931-5299-b320-b819e37f0217" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186617495} {:answer/id #uuid "b25b03a9-a2ae-57cb-b586-005c3f77e077" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186617538} {:answer/id #uuid "c1b930f2-dfcf-561d-ae99-0a7886f9b79d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186617573}] :answer-field/correct {:db/id #edb/ref 17592186617538} :answer-field/id #uuid "c77127a0-b9dc-5211-b535-33dd262efdbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617743}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1b4091f0-4a95-54e5-98db-b30b1df1c475" :question/math-academy-id "q-82909" :question/problem "Using the change of variables \n\n$$\nu=x+2y,\\,v=y,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $(x+2y)^{4}-y=0$ and  the line $y=1.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x+2y,\\,v=y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x+2y=u$ and $y=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(x+2y)^{4}-y &=0\\,⟹\\,{u}^{4}-v=0\\,⟹\\,v={u}^{4},\\end{aligned}\n$$\n\nwhile substituting $y=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}y &=1\\,⟹\\,v=1.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\left\\{\\begin{aligned}v &={u}^{4} \\\\ v &=1\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}u &=\\pm 1 \\\\ v &=1.\\end{aligned}\\right.\n$$\n\nSo, the intersection points are $(\\pm 1,1).$ \n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,{u}^{4}\\le v\\le 1\\}.\n$$\n\n![](images/21/21a418b848dc981a9490ca72038a077205d79cf152b00581c5bc6eb7f48269a9.png)\n\n   \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 2 \\\\ 0 & 1\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=(1)^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|1|\\text{d}u\\text{d}v \\\\  & ={\\int }_{-1}^{1}[{\\int }_{{u}^{4}}^{1}\\,dv]du \\\\  & ={\\int }_{-1}^{1}v{|}_{{u}^{4}}^{1}\\,du \\\\  & ={\\int }_{-1}^{1}(1-{u}^{4})du \\\\  & ={[u-\\frac{{u}^{5}}{5}]}_{-1}^{1} \\\\  & =2-\\frac{2}{5} \\\\  & =\\frac{8}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186617817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a5311b-b490-5a09-85f8-fc1b269f1205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186617256} {:answer/id #uuid "8ccf1135-1fe5-583b-b4ee-593321640eb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186617482} {:answer/id #uuid "918803c3-671a-5e4a-8563-3e9619b2e943" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186617489} {:answer/id #uuid "9b07c076-1613-5f0e-bb39-6116510a9e65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186617500} {:answer/id #uuid "e3d82748-249b-5512-b9b1-28fc80d6c9ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186617629}] :answer-field/correct {:db/id #edb/ref 17592186617256} :answer-field/id #uuid "112a4813-b58b-57f9-bd0c-7e592f6fe194" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617673}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "66c2a1bc-864c-53e1-9f03-760ac753becb" :question/math-academy-id "q-160851" :question/problem "Use a change of variables to calculate the area of the finite region $D$ bounded by the following lines.\n\n$$\ny=3x,\\,y=3x-4,\\,x=y-1,\\,x=y+2\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n3x-y=0,\\,3x-y=4,\\,x-y=-1,\\,x-y=2\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=3x-y,\\,v=x-y\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=3x-y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & 3x-y=0\\,⟹\\,u=0 \\\\  & 3x-y=4\\,⟹\\,u=4\\end{aligned}\n$$\n\nAnd we substitute $v=x-y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & x-y=-1\\,⟹\\,v=-1 \\\\  & x-y=2\\,⟹\\,v=2\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 4,\\,-1\\le v\\le 2\\}\n$$\n\n![](images/ff/ff0564b19ac1a55b0bc5d50a8b93bf0a6196a92c388d95a82bccf74039243e05.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -1 \\\\ 1 & -1\\end{vmatrix} \\\\  & =-3+1 \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{4}\\,\\text{d}u{\\int }_{-1}^{2}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot (4-0)\\cdot (2-(-1)) \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186617824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067db027-125f-563d-954d-9e67b4fde190" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,2x\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186617255} {:answer/id #uuid "34ca402b-b080-5fdc-883f-f6ad834bfbc9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,8x\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186617347} {:answer/id #uuid "896ef29a-68f5-587c-8d99-31ed6c6870ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,4x\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186617474} {:answer/id #uuid "c0646f5d-df70-507c-bc50-a604aa30aa73" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,-4x-2y\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186617568} {:answer/id #uuid "e0c6f33c-e850-5204-a0a0-b42ca512f797" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,8x+2y\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186617620}] :answer-field/correct {:db/id #edb/ref 17592186617474} :answer-field/id #uuid "84a6c8a4-4db1-5fa0-a4bf-6c47d6502129" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617714}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "852b8c26-61ec-5ce4-909a-b99005179ddb" :question/math-academy-id "q-162362" :question/problem "Let $C$ be the intersection of the half-ellipsoid $z=\\sqrt{9-4{x}^{2}-{y}^{2}}$ and the cylinder ${x}^{2}+{y}^{2}=1.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨z,\\,0,\\,0⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the half-ellipsoid $z=\\sqrt{9-4{x}^{2}-{y}^{2}}$ and the cylinder. One such surface is our half-ellipsoid $S$ with the equation \n\n$$\nz=g(x,y)=\\sqrt{9-4{x}^{2}-{y}^{2}}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}\\sqrt{9-4{x}^{2}-{y}^{2}}=\\frac{-4x}{\\sqrt{9-4{x}^{2}-{y}^{2}}} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}\\sqrt{9-4{x}^{2}-{y}^{2}}=\\frac{-y}{\\sqrt{9-4{x}^{2}-{y}^{2}}}\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨z,\\,0,\\,0⟩{|}_{z=\\sqrt{9-4{x}^{2}-{y}^{2}}} \\\\  & =⟨\\sqrt{9-4{x}^{2}-{y}^{2}},\\,0,\\,0⟩ \\\\  & =⟨\\underbrace{\\sqrt{9-4{x}^{2}-{y}^{2}}}_{P},\\,\\underbrace{0}_{Q},\\,\\underbrace{0}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-\\sqrt{9-4{x}^{2}-{y}^{2}}\\cdot \\left(-\\frac{4x}{\\sqrt{9-4{x}^{2}-{y}^{2}}}\\right)-0\\cdot \\left(-\\frac{y}{\\sqrt{9-4{x}^{2}-{y}^{2}}}\\right)+0)\\,\\text{d}A \\\\  & ={∬}_{D}4x\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/ea/eae72066363dd2c749f85fcc1568c15d65d193af83b9185ab084aef9a38db045.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}4x\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,4x\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186617841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00932f26-2b47-5ff3-8cb5-8aa2c89e710a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186617242} {:answer/id #uuid "2d870863-1d12-5745-89bf-ae892441530f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186617334} {:answer/id #uuid "9db1417d-fd82-5b18-9bc3-3ba28317f539" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡2" :db/id #edb/ref 17592186617505} {:answer/id #uuid "f1ef297f-fb08-5986-83a8-96a66672543e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186617649} {:answer/id #uuid "fc685a95-36b1-5083-9821-45c69a790526" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186617657}] :answer-field/correct {:db/id #edb/ref 17592186617334} :answer-field/id #uuid "078e0dea-6e4c-5a4f-80cf-6cc6c26934d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617669}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "af302994-8f59-5ef6-a68b-2b3888da4fed" :question/math-academy-id "q-160655" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n\n$$\ny=\\frac{2}{x},\\,y=\\frac{5}{x},\\,x={y}^{2},\\,x=4{y}^{2}\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\nxy=2,\\,xy=5,\\,\\frac{x}{{y}^{2}}=1,\\,\\frac{x}{{y}^{2}}=4\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=xy,\\,v=\\frac{x}{{y}^{2}}\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=xy$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & xy=2\\,⟹\\,u=2 \\\\  & xy=5\\,⟹\\,u=5\\end{aligned}\n$$\n\nAnd we substitute $v=\\frac{x}{{y}^{2}}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & \\frac{x}{{y}^{2}}=1\\,⟹\\,v=1 \\\\  & \\frac{x}{{y}^{2}}=4\\,⟹\\,v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 5,\\,1\\le v\\le 4\\}\n$$\n\n![](images/ff/ff8f8b6af1d1a81a0c7f40b29e92351431a45f67ebc057fd39acd2cd2280f48b.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}y & x \\\\ \\frac{1}{{y}^{2}} & -\\frac{2x}{{y}^{3}}\\end{vmatrix} \\\\  & =-\\frac{2x}{{y}^{2}}-\\frac{x}{{y}^{2}} \\\\  & =-3v.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{3v}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3v}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{∬}_{Δ}\\frac{1}{v}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}\\,\\text{d}u{\\int }_{1}^{4}\\frac{1}{v}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot 3\\cdot (\\operatorname{ln}⁡4-\\operatorname{ln}⁡1) \\\\  & =2\\operatorname{ln}⁡2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186617844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33a47eb6-f2b7-5aaf-a621-372f14930b43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{2}}{5}" :db/id #edb/ref 17592186617345} {:answer/id #uuid "39323b63-908b-5c81-8b6f-ec673db43da5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186617360} {:answer/id #uuid "50ac51ca-22b4-5df2-a421-fe1f447842c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186617400} {:answer/id #uuid "7a88fc97-d0b3-5fd9-844f-1a1e361f132d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{2}}{5}" :db/id #edb/ref 17592186617449} {:answer/id #uuid "8caa5414-b802-5170-9c8c-9a050cd7c154" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{2}}{3}" :db/id #edb/ref 17592186617481}] :answer-field/correct {:db/id #edb/ref 17592186617481} :answer-field/id #uuid "6a99a52c-e996-5a20-bc4b-efc83eee630b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186617704}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b4c23fa9-f154-5b24-977d-0b5df3576acf" :question/math-academy-id "q-38372" :question/problem "Using the change of variables \n\n$$\nu=x+y,\\,v=x,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $(x+y)^{2}-x=0$ and the line $x=2.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x+y,\\,v=x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x+y=u$ and $x=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(x+y)^{2}-x &=0\\,⟹\\,{u}^{2}-v=0\\,⟹\\,v={u}^{2},\\end{aligned}\n$$\n\n  \n\nwhile substituting $x=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}x &=2\\,⟹\\,v=2.\\end{aligned}\n$$\n\n \n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system: \n\n$$\n\\left\\{\\begin{aligned}v &={u}^{2} \\\\ v &=2\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}u &=\\pm \\sqrt{2} \\\\ v &=2.\\end{aligned}\\right.\n$$\n\nSo, the intersection points are $(\\pm \\sqrt{2},2).$ \n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-\\sqrt{2}\\le u\\le \\sqrt{2},\\,{u}^{2}\\le v\\le 2\\}.\n$$\n\n \n\n![](images/34/349486642eca07c8f1a619cb567dcb578c39a5ff024067a0910301039f3ae1d9.png)\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=(-1)^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-1|\\text{d}u\\text{d}v \\\\  & ={\\int }_{-\\sqrt{2}}^{\\sqrt{2}}[{\\int }_{{u}^{2}}^{2}\\,dv]du \\\\  & ={\\int }_{-\\sqrt{2}}^{\\sqrt{2}}[v]_{{u}^{2}}^{2}\\,du \\\\  & ={\\int }_{-\\sqrt{2}}^{\\sqrt{2}}(2-{u}^{2})\\,du \\\\  & ={[2u-\\frac{{u}^{3}}{3}]}_{-\\sqrt{2}}^{\\sqrt{2}} \\\\  & =4\\sqrt{2}-\\frac{4\\sqrt{2}}{3} \\\\  & =\\frac{8\\sqrt{2}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d813c91-e6f4-59a1-a842-48fcf9ce9af5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=6\\operatorname{cos}⁡\\theta +2,\\,y=3\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186619241} {:answer/id #uuid "4453859b-f34d-5f30-9c31-e0ee14768c82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=12\\operatorname{cos}⁡\\theta +2,\\,y=6\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186619271} {:answer/id #uuid "4c54dfc5-f01d-549f-9d89-045cf4ed14da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3\\operatorname{cos}⁡\\theta -2,\\,y=\\frac{3}{2}\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186619285} {:answer/id #uuid "cf73e931-28fe-5f8a-8291-5545c03755f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=6\\operatorname{cos}⁡\\theta -2,\\,y=3\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186619511} {:answer/id #uuid "ea70a59c-d907-5269-b32a-5f77cc00fb90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=12\\operatorname{cos}⁡\\theta -2,\\,y=6\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186619551}] :answer-field/correct {:db/id #edb/ref 17592186619511} :answer-field/id #uuid "4d1e519a-0f16-50eb-97af-1e4ec9006632" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186619628}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2dfc30bf-0d0e-5e3d-98b6-150a56a2caf5" :question/math-academy-id "q-106395" :question/problem "![](images/c5/c5fa93d7d0c2e1f13df0235b7f250f0a4dfd2216424043b674540de00d05baa1.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" :question/worked-solution "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the ellipse is centered at the point $(-2,-3),$ $a=6$ and $b=3.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=6\\operatorname{cos}⁡\\theta -2,\\,y=3\\operatorname{sin}⁡\\theta -3,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186619768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7809b34a-b414-5626-87f4-b8df7b324f28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(x-5)^2}{49}+\\frac{(y+9)^2}{40}" :db/id #edb/ref 17592186619357}] :answer-field/correct {:db/id #edb/ref 17592186619357} :answer-field/id #uuid "46f43d9c-4fc0-559f-b675-3c340b5d3173" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186619625}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6d556f14-1025-59a3-bb9d-cd16c49fe0e7" :question/math-academy-id "q-327802" :question/problem "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=7\\operatorname{cos}⁡\\theta +5,\\,y=2\\sqrt{10}\\operatorname{sin}⁡\\theta -9,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =7\\operatorname{cos}⁡\\theta +5 \\\\ \\frac{x-5}{7} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x-5)^{2}}{{7}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x-5)^{2}}{49} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta$ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =2\\sqrt{10}\\operatorname{sin}⁡\\theta -9 \\\\ \\frac{y+9}{2\\sqrt{10}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y+9)^{2}}{(2\\sqrt{10})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y+9)^{2}}{40} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x-5)^{2}}{49}+\\frac{(y+9)^{2}}{40} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{(x-5)^{2}}{49}+\\frac{(y+9)^{2}}{40}=1.\n$$"}] [{:db/id #edb/ref 17592186619799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6a73aa-3e13-559d-9f8f-c295d2bf7338" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}(3\\,i+4\\,j)" :db/id #edb/ref 17592186619184} {:answer/id #uuid "22ef7b38-4fbe-5b8b-b8f5-269f2fa8cc74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{13}}{13}(-4\\,i+3\\,j)" :db/id #edb/ref 17592186619218} {:answer/id #uuid "bd7cac34-4988-5377-b419-038b3c2c37a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{5}(3\\,i+4\\,j)" :db/id #edb/ref 17592186619479} {:answer/id #uuid "cfdee83a-5a66-5abd-82e4-e438fa9feea6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}(-4\\,i+3\\,j)" :db/id #edb/ref 17592186619513} {:answer/id #uuid "f8fba20c-af8d-5b36-aab7-af838640f298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{5}}{5}(2\\,i+j)" :db/id #edb/ref 17592186619579}] :answer-field/correct {:db/id #edb/ref 17592186619513} :answer-field/id #uuid "39993027-d901-523a-a14e-1716cf16f527" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186619616}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ccb904eb-d991-5a1c-8e43-5fa47d3aef3c" :question/math-academy-id "q-130705" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=3{y}^{2}-4{x}^{2}$ that passes through the point where $(x,y)=(\\frac{1}{2},\\frac{1}{2}).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(\\frac{1}{2},\\frac{1}{2})$, can be found by computing $∇f(\\frac{1}{2},\\frac{1}{2}).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(3{y}^{2}-4{x}^{2})\\,i+\\frac{∂}{∂y}(3{y}^{2}-4{x}^{2})\\,j \\\\  & =-8x\\,i+6y\\,j \\\\ ∇f(\\frac{1}{2},\\frac{1}{2}) & =-8\\left(\\frac{1}{2}\\right)i+6\\left(\\frac{1}{2}\\right)j \\\\  & =-4\\,i+3\\,j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∇f(\\frac{1}{2},\\frac{1}{2})}{‖∇f(\\frac{1}{2},\\frac{1}{2})‖} & =\\frac{(-4\\,i+3\\,j)}{\\sqrt{{(-4)}^{2}+{(3)}^{2}}} \\\\  & =\\frac{(-4\\,i+3\\,j)}{\\sqrt{16+9}} \\\\  & =\\frac{(-4\\,i+3\\,j)}{\\sqrt{25}} \\\\  & =\\frac{1}{5}(-4\\,i+3\\,j).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186623649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c9b6318-ab68-5c9b-9158-5d39f7350f6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{46}}{2}" :db/id #edb/ref 17592186623281}] :answer-field/correct {:db/id #edb/ref 17592186623281} :answer-field/id #uuid "2108de69-3be2-54bb-8f5e-e237688b6cfc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186623535}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "674f25d6-d3f0-5162-a555-2f7e1dc56d5b" :question/math-academy-id "q-316357" :question/problem "Calculate the area ${A}_{△}$ of the triangle spanned by $c=⟨1,0,2⟩$ and $d=⟨0,3,-1⟩.$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}c\\times d & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 2 \\\\ 0 & 3 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 2 \\\\ 3 & -1\\end{vmatrix}i-\\begin{vmatrix}1 & 2 \\\\ 0 & -1\\end{vmatrix}j+\\begin{vmatrix}1 & 0 \\\\ 0 & 3\\end{vmatrix}k \\\\  & =(0\\cdot (-1)-2\\cdot 3)i-(1\\cdot (-1)-2\\cdot 0)j+(1\\cdot 3-0\\cdot 0)k \\\\  & =-6i+j+3k \\\\  & =⟨-6,1,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,c\\times d\\,| \\\\  & =\\sqrt{(-6)^{2}+{1}^{2}+{3}^{2}} \\\\  & =\\sqrt{36+1+9} \\\\  & =\\sqrt{46}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{46}}{2}=\\frac{\\sqrt{46}}{2}.\n$$"}] [{:db/id #edb/ref 17592186623687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a483773d-e8b8-5dda-84dc-625a24288854" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{186}}{2}" :db/id #edb/ref 17592186623394}] :answer-field/correct {:db/id #edb/ref 17592186623394} :answer-field/id #uuid "f58ffa5a-c0d2-50c9-bebf-2baa3fea39f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186623617}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da363f24-f322-5059-b920-a35fbd6c6a0c" :question/math-academy-id "q-316529" :question/problem "Calculate the area of the $△\\,JKL,$ if $J(2,0,1),$ $K(5,2,3),$ $L(1,3,0).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{JK}$ and $\\overset{\\to }{JL}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{JK} & =k-j \\\\  & =(5i+2j+3k)-(2i+k) \\\\  & =3i+2j+2k \\\\  & =⟨3,2,2⟩ \\\\ \\overset{\\to }{JL} & =l-j \\\\  & =(i+3j)-(2i+k) \\\\  & =-i+3j-k \\\\  & =⟨-1,3,-1⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{JK}\\times \\overset{\\to }{JL} & =\\begin{vmatrix}i & j & k \\\\ 3 & 2 & 2 \\\\ -1 & 3 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 2 \\\\ 3 & -1\\end{vmatrix}i-\\begin{vmatrix}3 & 2 \\\\ -1 & -1\\end{vmatrix}j+\\begin{vmatrix}3 & 2 \\\\ -1 & 3\\end{vmatrix}k \\\\  & =(2\\cdot (-1)-2\\cdot 3)i-(3\\cdot (-1)-(-1)\\cdot 2)j+(3\\cdot 3-2\\cdot (-1))k \\\\  & =-8i+j+11k \\\\  & =⟨-8,1,11⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{JK}$ and $\\overset{\\to }{JL}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{JK}\\times \\overset{\\to }{JL}| \\\\  & =\\sqrt{(-8)^{2}+{1}^{2}+{11}^{2}} \\\\  & =\\sqrt{186}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,JKL$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{186}}{2}.\n$$"}] [{:db/id #edb/ref 17592186624510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3811f67e-12d4-5358-9b35-f29760a8a11e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186624012} {:answer/id #uuid "40a763c8-ca5c-5165-ac88-a7432137f666" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186624020} {:answer/id #uuid "5a0ed97f-0f10-5403-981e-b48eea0fe92e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186624075} {:answer/id #uuid "5b8ebd9e-2e8e-560b-93a9-a5fe01751c6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186624078} {:answer/id #uuid "d3118b09-b823-521b-96d0-88f34997a10c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186624301}] :answer-field/correct {:db/id #edb/ref 17592186624075} :answer-field/id #uuid "2353f489-4bd8-5077-8133-3a45665cc42b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186624385}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2587914b-a5bf-526d-966b-073e8cf4550f" :question/math-academy-id "q-162609" :question/problem "Which of the following vector fields have a stream function?\n\nI. $F(x,y)=3{x}^{2}\\,i-3{y}^{2}\\,j$\n\nII. $F(x,y)=2x\\,i-2y\\,j$\n\nIII. $F(x,y)=x{y}^{3}\\,i+y\\,j$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field I doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=6x,\\,\\frac{∂Q}{∂y} & =-6y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=6x+(-6y)\\ne 0.\n$$\n\n- Vector field II does have a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2,\\,\\frac{∂Q}{∂y} & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2+(-2)=0.\n$$\n\n- Vector field III doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3x{y}^{2},\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=3x{y}^{2}+1\\ne 0.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186624526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284f48d9-f180-50c7-a055-2e13ddcd09ac" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a2/a26bc245ae6ba3c8db9e021e9292bedf3c1ec5267dc99e4cde872f972d0ca73d.png" :db/id #edb/ref 17592186623979} {:answer/id #uuid "65482f79-8d6f-5148-9c7a-b1956cfabec2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/91/91e7124ef57462e9d8e0045582ccc8149608c687f3a822071345fa5b5f532cdd.png" :db/id #edb/ref 17592186624100} {:answer/id #uuid "acb0880c-b429-5829-8f24-d61a5c4d930e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4c/4ccc8027a9e25cadad9cc49f910d62ec272b18b48987e33750f3a00db5957735.png" :db/id #edb/ref 17592186624224} {:answer/id #uuid "df78b497-daf0-52a9-8987-0e5296fe8b9a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/fe/fe2fba534abf5f52b4ab9924c7f3175ed23d8a13c1b0e90919e8b9f1bcf8c33c.png" :db/id #edb/ref 17592186624319} {:answer/id #uuid "e21e3e66-e366-51fd-bca0-502c68badc17" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b1/b168b63e168a750dd78493112eff6f3e362f2334aa2dae9b801640cc047f84f4.png" :db/id #edb/ref 17592186624324}] :answer-field/correct {:db/id #edb/ref 17592186624224} :answer-field/id #uuid "ec670edb-5a00-5b76-871c-5f0d4757ebe8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186624491}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5502d093-d5cc-5b5e-b3c2-0aa4a3035bd7" :question/math-academy-id "q-162604" :question/problem "![](images/8e/8ec6c3353156edf794d0da25ccdebb8421a2570a6ec81625c54affcafe303889.png)\n\nConsider the vector field $F$ shown above. Which of the following shows the streamlines of this vector field?" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nOf the given options, the only level curves tangential to the vector field at every point are shown below.\n\n![](images/1b/1bbd13918b2cda87c82eb7c9e7cc33cff46642d94725a806df23a94da6b0d5e8.png)"}] [{:db/id #edb/ref 17592186625997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a08cb74-0067-5737-9174-20ae7ccf48cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}\\overrightarrow{ST}" :db/id #edb/re