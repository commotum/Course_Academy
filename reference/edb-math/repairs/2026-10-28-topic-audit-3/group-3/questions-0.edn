e34-5ec5-8483-299f03e8484c" :answer-field/key "$x=8$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440368}] :question/id #uuid "f04c86de-5ed5-52ee-bc8b-1a0c07c06519" :question/math-academy-id "q-9657" :question/problem "Given that the determinant of\n$$\n\\displaystyle \\begin{bmatrix}2 & -1 & 3 \\\\ x & 2 & 4 \\\\ -2 & 1 & x + 3\\end{bmatrix}\n$$\nis $8$, find all the possible values of $x$.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The determinant is $x^{2} + 10 x + 24$. Setting it equal to $8$ gives $\\left\\{-8, -2\\right\\}$."}] [{:db/id #edb/ref 17592186060447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082dc2d8-bedc-5e7d-b400-565c864a2156" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186357827} {:answer/id #uuid "1497bbf0-b0e3-55c9-a773-3097042ee709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186357932} {:answer/id #uuid "94d5145f-94aa-5233-938d-f5a7dd10a709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186359056} {:answer/id #uuid "bda894ff-ae9d-5d5a-99bd-a1f4b7cf8342" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186359402} {:answer/id #uuid "e8ddf45e-881c-5c0c-a2da-d518f976e537" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186359817}] :answer-field/correct {:db/id #edb/ref 17592186357827} :answer-field/id #uuid "796c6d71-8b6e-59df-88c9-9b3757e40cfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b64018e-8bf2-54ed-9b58-217e6e652f6c" :question/math-academy-id "q-9669" :question/problem "Find the possible values of the constant $k$ given that the matrix $\\begin{bmatrix}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{bmatrix}$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$ \n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{vmatrix} & =2\\begin{vmatrix}3 & k \\\\ 0 & 1\\end{vmatrix}-1\\begin{vmatrix}2k+1 & k \\\\ 1 & 1\\end{vmatrix}-4\\begin{vmatrix}2k+1 & 3 \\\\ 1 & 0\\end{vmatrix} \\\\  & =2(3-0)-(2k+1-k)-4(0-3) \\\\  & =2\\cdot 3-(k+1)-4\\cdot (-3) \\\\  & =6-k-1+12 \\\\  & =17-k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}17-k & =0 \\\\ k & =17\\end{aligned}\n$$\n\nTherefore, the solution is $k=17.$"}] [{:db/id #edb/ref 17592186060454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "141d3bda-708e-5cd1-a9c3-33813075f0e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438670} {:answer/id #uuid "c97bfd73-22d0-514a-b96a-af8b07567307" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438671}] :answer-field/correct {:db/id #edb/ref 17592186438671} :answer-field/id #uuid "e441ef7a-f7d8-556c-897f-7d0c7a6b2bc1" :answer-field/key "$det(F)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439364} {:answer-field/choices [{:answer/id #uuid "aa853019-8cb7-57bb-8d89-07bb087c8654" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438672} {:answer/id #uuid "5e56b566-9992-53f1-aacf-331d0f084061" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438673}] :answer-field/correct {:db/id #edb/ref 17592186438673} :answer-field/id #uuid "e6cc4081-efb3-5cbd-91d9-77bb4d9690f4" :answer-field/key "$F$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439365} {:answer-field/choices [{:answer/id #uuid "1db0c840-997f-55b7-bab1-3572f80549a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438674} {:answer/id #uuid "9da77c68-30c2-574d-8a12-c8183bf926de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438675}] :answer-field/correct {:db/id #edb/ref 17592186438674} :answer-field/id #uuid "3e1cd461-5747-5d77-9466-83683a668421" :answer-field/key "$det(F)=-2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439366}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nSelect all that apply.\n\n$$\nF=\\begin{bmatrix}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =\\begin{vmatrix}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{vmatrix} \\\\  & =0\\begin{vmatrix}4 & 5 \\\\ 7 & 8\\end{vmatrix}-1\\begin{vmatrix}3 & 5 \\\\ 6 & 8\\end{vmatrix}+2\\begin{vmatrix}3 & 4 \\\\ 6 & 7\\end{vmatrix} \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(F)=0$, the matrix is singular. \n\nTherefore, only statements $det(F)=0$ and “$F$ is a singular matrix” are true."}] [{:db/id #edb/ref 17592186060455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb7f9378-1e2c-5fad-a64e-dba8350af45e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186059353} {:answer/id #uuid "d0ce2cd2-c328-50a2-a7d8-262686f4f13c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-13" :db/id #edb/ref 17592186059354} {:answer/id #uuid "f1b413f1-d53c-5d8d-939a-db24e1f1fc46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "47" :db/id #edb/ref 17592186059355} {:answer/id #uuid "f83be477-467e-53c3-8f41-fa96ec94d220" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186059356} {:answer/id #uuid "3d8025f2-5776-57cc-9e01-ba1728d61b90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186059357}] :answer-field/correct {:db/id #edb/ref 17592186059354} :answer-field/id #uuid "8b2b69aa-960e-50ee-ba26-2912592042dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186059352}] :question/id #uuid "7143707d-50b6-5c64-b7c9-25d6ff46e0d4" :question/math-academy-id "q-9841" :question/problem "Find the value of $\\begin{vmatrix}0 & -1 & 3 \\\\ 2 & 0 & 1 \\\\ 7 & -1 & 0\\end{vmatrix}$." :question/worked-solution "Expanding across the first row, we obtain\n\n$$\n\\begin{aligned}\\begin{vmatrix}0&-1&3\\\\2&0&1\\\\7&-1&0\\end{vmatrix}&=0-(-1)\\begin{vmatrix}2&1\\\\7&0\\end{vmatrix}+3\\begin{vmatrix}2&0\\\\7&-1\\end{vmatrix}\\\\&=(-7)+3(-2)\\\\&=-13.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c97d112-a733-50db-a3e0-14dc2721dcef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Any value of $k$" :db/id #edb/ref 17592186059359} {:answer/id #uuid "a2aa1a94-21f1-552d-ae6c-c5b0802357bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ only" :db/id #edb/ref 17592186059360} {:answer/id #uuid "b2d37c14-0ed6-5cb1-ae4d-65ca40ec7dab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0$ only" :db/id #edb/ref 17592186059361} {:answer/id #uuid "0e5ddce2-efab-57ff-834e-5148be9476c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ only" :db/id #edb/ref 17592186059362} {:answer/id #uuid "73493f5b-e7e5-53c5-91c5-a37d38ea1731" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $-3$ only" :db/id #edb/ref 17592186059363}] :answer-field/correct {:db/id #edb/ref 17592186059359} :answer-field/id #uuid "a3da1235-861c-5299-892e-dbd9ea51bf74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186059358}] :question/id #uuid "aae8854c-5bc3-5b0c-a496-72765fde3229" :question/math-academy-id "q-9852" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$\\begin{bmatrix}0 & 7 & 4k \\\\ 0 & 9 & 5k \\\\ 0 & 11 & 6k\\end{bmatrix}$ is singular." :question/worked-solution "The determinant is $0$. Setting it equal to $0$ gives $\\mathbb{R}$."}] [{:db/id #edb/ref 17592186064099 :question/id #uuid "60a223c7-3d1c-50d6-be7c-330ba039635c" :question/math-academy-id "e-491" :question/problem "Calculate $$\n\\displaystyle \\int xe^{7x} \\textrm{d}x.\n$$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int uv' \\, \\textrm{d}x= uv - \\int vu' \\, \\textrm{d}x.\n$$\n\nWe need to express $\\displaystyle  \\int xe^{7x} \\textrm{d}x$ as $\\displaystyle  \\int uv'\\,\\textrm{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{7x}\\, & ⟹\\,v=\\frac{1}{7}{e}^{7x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get the following:\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{7x}\\,\\text{d}x & =x\\cdot \\frac{1}{7}{e}^{7x}-\\int \\frac{1}{7}{e}^{7x}\\cdot 1\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we calculate the integral:\n\n$$\n\\begin{aligned}\\int x{e}^{7x}\\,\\text{d}x & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{7}\\int {e}^{7x}\\,\\text{d}x \\\\  & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{7}\\left(\\frac{{e}^{7x}}{7}\\right)+C \\\\  & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{49}{e}^{7x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064100 :question/id #uuid "804f45cd-2082-5521-b4db-a32169716626" :question/math-academy-id "e-492" :question/problem "Calculate $$\n\\displaystyle\\int x \\cos{2x}\\,\\textrm d x.\n$$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int uv'\\,\\textrm{d}x= uv- \\int vu'\\,\\textrm{d}x.\n$$\n\nWe need to express $\\displaystyle \\int x \\cos{2x} \\textrm{d}x$ as $\\displaystyle \\int uv'\\,\\textrm{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡2x\\, & ⟹\\,v=\\frac{1}{2}\\operatorname{sin}⁡2x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\operatorname{cos}⁡2x\\,\\text{d}x & =x\\cdot \\frac{1}{2}\\operatorname{sin}⁡2x-\\int \\frac{1}{2}\\operatorname{sin}⁡2x\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡2x\\,\\text{d}x & =\\frac{1}{2}x\\operatorname{sin}⁡2x-\\frac{1}{2}\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡2x-\\frac{1}{2}(-\\frac{1}{2}\\operatorname{cos}⁡2x)+C \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡2x+\\frac{1}{4}\\operatorname{cos}⁡2x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064117 :question/id #uuid "aaeb0407-771b-5dbc-8a50-e7bc0e3477c3" :question/math-academy-id "e-6209" :question/problem "Evaluate $$\n\\displaystyle \\int_0^{\\pi/5} x\\sin(5x) \\, \\textrm{d}x.\n$$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(5x) & ⟹\\,v=-\\frac{1}{5}\\operatorname{cos}⁡(5x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sin}⁡(5x)\\,\\text{d}x & =-x\\cdot \\frac{1}{5}\\operatorname{cos}⁡(5x)-\\int (-\\frac{1}{5}\\operatorname{cos}⁡(5x))\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /5}x\\operatorname{sin}⁡(5x)\\,\\text{d}x & =-{\\frac{1}{5}x\\operatorname{cos}⁡(5x)|}_{0}^{\\pi /5}+\\frac{1}{5}{\\int }_{0}^{\\pi /5}\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & =-{\\frac{1}{5}x\\operatorname{cos}⁡(5x)|}_{0}^{\\pi /5}+{\\frac{1}{5}\\left(\\frac{\\operatorname{sin}⁡(5x)}{5}\\right)|}_{0}^{\\pi /5} \\\\  & =[-\\frac{1}{5}\\cdot \\frac{\\pi }{5}\\operatorname{cos}⁡(\\pi )+\\frac{1}{5}\\cdot 0\\cdot \\operatorname{cos}⁡(0)]+[\\frac{1}{25}\\operatorname{sin}⁡(\\pi )-\\frac{1}{25}\\operatorname{sin}⁡(0)] \\\\  & =[-\\frac{\\pi }{25}\\cdot (-1)+0]+[0-0] \\\\  & =\\frac{\\pi }{25}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af2e84f-a21d-52e3-a64a-4cd4f75a12e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x\\operatorname{sin}⁡(3x)}{9}+\\frac{\\operatorname{cos}⁡(3x)}{3}+C" :db/id #edb/ref 17592186257011} {:answer/id #uuid "9c127a15-e250-5fec-ba10-64265f125da9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\operatorname{sin}⁡(3x)}{3}+\\frac{x\\operatorname{cos}⁡(3x)}{9}+C" :db/id #edb/ref 17592186258153} {:answer/id #uuid "a52d209e-bc78-5754-8593-120bb1521e79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}+\\frac{\\operatorname{cos}⁡(3x)}{9}+C" :db/id #edb/ref 17592186258221} {:answer/id #uuid "ab28af47-d9d9-51e6-a7e7-784bf7544716" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(x+3)\\operatorname{sin}⁡(3x)}{9}+\\frac{\\operatorname{cos}⁡(3x)}{3}+C" :db/id #edb/ref 17592186258275} {:answer/id #uuid "b11f0972-d6c7-5f7c-b041-100cfd94fdbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}-\\frac{x\\operatorname{cos}⁡(3x)}{3}+C" :db/id #edb/ref 17592186258325}] :answer-field/correct {:db/id #edb/ref 17592186258221} :answer-field/id #uuid "ec602d5e-cc1e-5573-8422-898b9eb55e75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259444}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8f405e14-26e8-524b-b2bf-2f3fef1fc543" :question/math-academy-id "q-12564" :question/problem "$$\n\\displaystyle \\int (x+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x=\n$$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\displaystyle \\int (x+3)\\operatorname{cos}⁡(3x)\\text{d}x$ as $\\displaystyle \\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x+3\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x)\\, & ⟹\\,v=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (x+3)\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =(x+3)\\cdot \\frac{\\operatorname{sin}⁡(3x)}{3}-\\int \\frac{\\operatorname{sin}⁡(3x)}{3}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (x+3)\\operatorname{cos}⁡(3x)\\text{d}x & =\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}-\\frac{1}{3}\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}+\\frac{\\operatorname{cos}⁡(3x)}{9}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40e31ec9-8fca-5231-8200-ca80bc72b044" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x{e}^{4x}}{3}+\\frac{x{e}^{4x}}{9}+C" :db/id #edb/ref 17592186272940} {:answer/id #uuid "997e80aa-81e0-539a-a4da-c477e354e208" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3x{e}^{4x}}{2}-\\frac{3{e}^{4x}}{8}+C" :db/id #edb/ref 17592186273716} {:answer/id #uuid "c854fd56-2342-58ef-b090-fd79a6ccd523" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3x{e}^{4x}}{2}-\\frac{3{e}^{4x}}{9}+C" :db/id #edb/ref 17592186274128} {:answer/id #uuid "df814db1-8188-5e1b-812c-d9b512f99e8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x{e}^{4x}}{2}-\\frac{3{e}^{4x}}{8}+C" :db/id #edb/ref 17592186274359} {:answer/id #uuid "f0053e13-ea2e-5ba8-b9dc-186d83b1f4f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{4x}}{3}+\\frac{{e}^{4x}}{9}+C" :db/id #edb/ref 17592186274512}] :answer-field/correct {:db/id #edb/ref 17592186273716} :answer-field/id #uuid "7a3e16d2-70ea-5fbe-9bd1-a83494641d8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274842}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d59fc11b-e64a-50a7-ad7d-a5192fdda084" :question/math-academy-id "q-14434" :question/problem "$$\n\\displaystyle \\int 6x{e}^{4x}\\,\\text{d}x=\n$$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\displaystyle \\int 6x{e}^{4x}\\text{d}x$ as $\\displaystyle \\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=6x\\, & ⟹\\,{u}^{′}=6 \\\\ {v}^{′}={e}^{4x}\\, & ⟹\\,v=\\frac{1}{4}{e}^{4x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 6x\\cdot {e}^{4x}\\,\\text{d}x & =6x\\cdot \\frac{1}{4}{e}^{4x}-\\int \\frac{1}{4}{e}^{4x}\\cdot 6\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 6x{e}^{4x}\\,\\text{d}x & =\\frac{3}{2}x{e}^{4x}-\\frac{3}{2}\\int {e}^{4x}\\,\\text{d}x \\\\  & =\\frac{3x{e}^{4x}}{2}-\\frac{3{e}^{4x}}{8}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043fa24a-45ec-5b10-bfa8-7e31faa50866" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186272422} {:answer/id #uuid "4dad317a-7e2c-5027-9a3a-188de187c660" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186273038} {:answer/id #uuid "657c9906-4184-54b2-a2ca-75931266448c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡2x+x\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186273256} {:answer/id #uuid "cf6fa9bf-7209-5009-8683-0533f03518a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x\\operatorname{cos}⁡x-\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186274192} {:answer/id #uuid "ef13a328-66f5-517d-8b0a-ca4c0258e019" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2x\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186274503}] :answer-field/correct {:db/id #edb/ref 17592186274503} :answer-field/id #uuid "8b869c77-052f-508f-90ff-9807f6d71398" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274873}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "36f423a0-7a02-5e68-b537-f427610136e3" :question/math-academy-id "q-14437" :question/problem "Calculate $$\n\\displaystyle \\int 2x\\operatorname{sin}⁡(x)\\,\\text{d}x.\n$$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\displaystyle \\int 2x\\operatorname{sin}⁡(x)\\text{d}x$ as $\\displaystyle \\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=2x\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =2x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 2x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-2x\\operatorname{cos}⁡(x)+2\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-2x\\operatorname{cos}⁡(x)+2\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a175a8cb-a6ee-5116-a42e-7718588e0c8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2^{x}}{\\ln 2}(\\frac{1}{x} - \\frac{x}{\\ln 2}) + C" :db/id #edb/ref 17592186061862} {:answer/id #uuid "b04d4f7a-8a20-52a1-b476-c32936814c77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2^{x}}{\\ln 2}(x - 1) + C" :db/id #edb/ref 17592186061863} {:answer/id #uuid "da1a54a0-de58-5994-a0ad-8678d8dee9ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2^{x}}{\\ln 2}(1 - \\frac{x}{\\ln 2}) + C" :db/id #edb/ref 17592186061864} {:answer/id #uuid "ec8d992b-235f-5112-bb41-ee409c14309a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2^{x}}{\\ln 2}(x + \\frac{1}{\\ln 2}) + C" :db/id #edb/ref 17592186061865} {:answer/id #uuid "638dab82-2814-5689-94e7-12a7d4a7dbd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2^{x}}{\\ln 2}(x - \\frac{1}{\\ln 2}) + C" :db/id #edb/ref 17592186061866}] :answer-field/correct {:db/id #edb/ref 17592186061866} :answer-field/id #uuid "a6953c52-54a9-56b3-9aa6-e38c3e7044c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186061861}] :question/id #uuid "faff3077-5b5e-5000-bc89-036983a07d8d" :question/math-academy-id "q-2425" :question/problem "Calculate\n\n$$\n\\int x2^{x}dx\n$$." :question/worked-solution "Use integration by parts with $u=x$ and $\\mathrm dv=2^x\\,\\mathrm dx$. Then $\\mathrm du=\\mathrm dx$ and $v=2^x/\\ln2$, so\n$$\n\\int x2^x\\,\\mathrm dx=\\frac{x2^x}{\\ln2}-\\frac1{\\ln2}\\int 2^x\\,\\mathrm dx\n=\\frac{2^x}{\\ln2}\\left(x-\\frac1{\\ln2}\\right)+C.\n$$\nDifferentiating the result gives $x2^x$, which verifies the antiderivative."}] [{:db/id #edb/ref 17592186064877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "398c3cee-657c-5b95-8a1e-1aa70b615cd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi -1" :db/id #edb/ref 17592186330468} {:answer/id #uuid "4b6624a0-3597-520a-b136-40dc699a2c1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}-1" :db/id #edb/ref 17592186330632} {:answer/id #uuid "829fe91a-9a59-5b71-9364-170b07c5eb54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}-1" :db/id #edb/ref 17592186331102} {:answer/id #uuid "b6aee3a4-6d54-578c-8449-e0741c41a98f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi -1" :db/id #edb/ref 17592186331563} {:answer/id #uuid "cea8bab6-1bfc-5d6a-a36b-eda9ee31a503" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi -1}{2}" :db/id #edb/ref 17592186331783}] :answer-field/correct {:db/id #edb/ref 17592186331102} :answer-field/id #uuid "a32b33d9-9824-5fca-9f78-08bd81319767" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332487}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d08b82b1-573b-56aa-9196-6973e5625acf" :question/math-academy-id "q-49664" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(x)\\,\\text{d}x.\n$$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(x) & ⇒ & v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(x)\\,\\text{d}x & =x\\operatorname{sin}⁡(x){|}_{0}^{\\pi /2}-{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(x){|}_{0}^{\\pi /2}+\\operatorname{cos}⁡(x){|}_{0}^{\\pi /2} \\\\  & =[\\frac{\\pi }{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)-0\\operatorname{sin}⁡(0)]+[\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cos}⁡(0)] \\\\  & =[\\frac{\\pi }{2}-0]+[0-1] \\\\  & =\\frac{\\pi }{2}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e635c6-8362-502a-8dac-9f4c126f56b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186330682} {:answer/id #uuid "5b2cbd9a-7afc-5459-b6df-7ca6506a12c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186330765} {:answer/id #uuid "9f4d14d4-eed1-5e2e-b017-564cb00a0993" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9e}{4}" :db/id #edb/ref 17592186331378} {:answer/id #uuid "cb8743c8-cccb-54cd-b8ac-95180b80ba0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2e}{3}" :db/id #edb/ref 17592186331757} {:answer/id #uuid "cd91e0dd-3fb4-57cb-8cdd-dff11939eaf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186331772}] :answer-field/correct {:db/id #edb/ref 17592186331772} :answer-field/id #uuid "4dfe59be-f622-58ca-a168-a466d2025ba6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332341}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49de41a8-b520-5e5d-99f3-b4a02784a3b8" :question/math-academy-id "q-49684" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1/3}2x{e}^{3x}\\,\\text{d}x.\n$$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x & ⇒ & {u}^{′}=2 \\\\ {v}^{′}={e}^{3x} & ⇒ & v=\\frac{{e}^{3x}}{3}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot {e}^{3x}\\,\\text{d}x & =2x\\cdot \\frac{{e}^{3x}}{3}-\\int \\left(\\frac{{e}^{3x}}{3}\\right)\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/3}2x{e}^{3x}\\,\\text{d}x & ={\\frac{2}{3}x{e}^{3x}|}_{0}^{1/3}-\\frac{2}{3}{\\int }_{0}^{1/3}{e}^{3x}\\text{d}x \\\\  & ={\\frac{2}{3}x{e}^{3x}|}_{0}^{1/3}-{\\frac{2}{9}{e}^{3x}|}_{0}^{1/3} \\\\  & =\\frac{2}{3}[\\frac{1}{3}{e}^{3(1/3)}-0\\cdot {e}^{3\\cdot 0}]-\\frac{2}{9}[{e}^{3(1/3)}-{e}^{3\\cdot 0}] \\\\  & =\\frac{2}{3}[\\frac{e}{3}-0]-\\frac{2}{9}[e-1] \\\\  & =\\frac{2e}{9}-\\frac{2e}{9}+\\frac{2}{9} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087515 :question/id #uuid "446ea007-1ff4-5023-8e3f-7f00eb0fb2d0" :question/math-academy-id "e-5071" :question/problem "What is the equation of the ellipse given below?\n\n![](images/6d/6d2ba3fba1a05a841a486553ea3a52d6f3797974630420ad79ae50f4c6f5bc15.png)" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=5$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{5}^{2}}+\\frac{{y}^{2}}{{3}^{2}} & =1 \\\\ \\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087516 :question/id #uuid "af56117c-65e0-5f12-9780-7a95e6be829e" :question/math-academy-id "e-5072" :question/problem "What is the equation of the ellipse given below?\n\n![](images/3e/3e8d5ed4bf055960b50e046c0688a3c4cc69907ebb1209bb9658ac4bcba48ffe.png)" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{4}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087517 :question/id #uuid "b7c94673-f847-5977-9b9f-8d235ea42eb2" :question/math-academy-id "e-5073" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation $\\dfrac{x^2}{36} + \\dfrac{y^2}{25} = 1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nIn the given equation, we have $a^2=36$ and $b^2=25.$\n\n- Since $a^2=36,$ the length of the horizontal radius must be $a=\\sqrt{36} = 6.$\n\n- Since $b^2=25,$ the length of the vertical radius must be $b=\\sqrt{25} = 5.$\n\nSo the semi-major axis has length $a=6,$ and the semi-minor axis has length $b=5.$\n\nTherefore, the major axis has length $2a = 2 \\cdot 6 = 12,$ and the minor axis has length $2b = 2 \\cdot 5 =10.$"}] [{:db/id #edb/ref 17592186088122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97b2bb68-89cb-59c8-9356-f76f21ec7260" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{x}^{2}}{9}+\\frac{4{y}^{2}}{81}" :db/id #edb/ref 17592186293529}] :answer-field/correct {:db/id #edb/ref 17592186293529} :answer-field/id #uuid "0415426c-2704-586e-93d9-ec13672b3656" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186293943}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d11d0095-5740-5d82-8a0d-f23a175699b1" :question/math-academy-id "q-279153" :question/problem "![](images/b1/b12eb6672d263655f9f77eaafbf486a7be5bf9b7673c73fd0d75382d192a658b.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=\\frac{3}{2}$ and the vertical radius has length $b=\\frac{9}{2}.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{\\left(\\frac{3}{2}\\right)}^{2}}+\\frac{{y}^{2}}{{\\left(\\frac{9}{2}\\right)}^{2}} & =1 \\\\ \\frac{{x}^{2}}{\\left(\\frac{9}{4}\\right)}+\\frac{{y}^{2}}{\\left(\\frac{81}{4}\\right)} & =1 \\\\ \\frac{4{x}^{2}}{9}+\\frac{4{y}^{2}}{81} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b14229b-7244-5a13-b9f7-377caf1b3763" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $2$" :db/id #edb/ref 17592186342721} {:answer/id #uuid "5f7b224c-d2f2-57f2-923d-636856ca9541" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $4$" :db/id #edb/ref 17592186343046} {:answer/id #uuid "909cdc5c-8c31-567d-a8db-9603fcfc60fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $4$" :db/id #edb/ref 17592186343502} {:answer/id #uuid "abc3321f-0ab1-56d9-b892-997b85188d6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186343749} {:answer/id #uuid "cdb1fa09-1293-5ba1-af7a-c2963a194695" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $2$" :db/id #edb/ref 17592186344052}] :answer-field/correct {:db/id #edb/ref 17592186343046} :answer-field/id #uuid "e3d2e838-6d36-58ab-9502-f89e82764f33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344893}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b586f348-117c-513c-b7f9-86528f54bc6b" :question/math-academy-id "q-7598" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=4$ and ${b}^{2}=16.$\n\n- Since ${a}^{2}=4,$ the length of the horizontal radius must be $a=\\sqrt{4}=2.$\n\n- Since ${b}^{2}=16,$ the length of the vertical radius must be $b=\\sqrt{16}=4.$\n\nSo the semi-major axis has length $b=4,$ and the semi-minor axis has length $a=2.$\n\nTherefore, the major axis has length $2b=2\\cdot 4=8,$ and the minor axis has length $2a=2\\cdot 2=4.$"}]}
