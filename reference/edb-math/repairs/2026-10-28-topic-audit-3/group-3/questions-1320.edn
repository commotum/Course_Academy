8-55ff-9ade-0780a8ebf633" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13}}{52}" :db/id #edb/ref 17592186502268} {:answer/id #uuid "a0d8454f-de76-5005-833d-699e377f1293" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbf{a}" :db/id #edb/ref 17592186502284}] :answer-field/correct {:db/id #edb/ref 17592186502235} :answer-field/id #uuid "6e5a26ed-0e7c-5e31-84e0-ebfd08d7be08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502258}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f719072e-c57f-507a-8dda-84c1a653bd39" :question/problem "The vector $\\mathbf{a}$ has magnitude $4 \\sqrt{13}$. Find a unit vector that is parallel to $\\mathbf{a}$." :question/worked-solution "To obtain the unit vector that is parallel to $\\mathbf{a}$, we divide $\\mathbf{a}$ by its length:\n\n$$\n\\mathbf{u}=\\dfrac{\\mathbf{a}}{\\mid \\,\\mathbf{a}\\, \\mid}=\\dfrac{1}{4 \\sqrt{13}}\\mathbf{a}=\\frac{\\sqrt{13}}{52}\\mathbf{a}\n$$"}] [{:db/id #edb/ref 17592186502334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a455916-32b4-5125-a03d-acadaf8f7915" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{10}}{5}(m+n)" :db/id #edb/ref 17592186502359} {:answer/id #uuid "74dbaa7e-fca7-5073-a877-6b16ff3e4d78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}(m+n)" :db/id #edb/ref 17592186502367} {:answer/id #uuid "8a06c96f-4a15-5bf2-a6d0-edbdb248951e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(m+n)" :db/id #edb/ref 17592186502372} {:answer/id #uuid "90fb3517-b11c-5317-ac7d-17e978e3d179" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{2}(m+n)" :db/id #edb/ref 17592186502376} {:answer/id #uuid "c45caa27-da31-57ac-8666-1a0bb5c8d193" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{5}(m+n)" :db/id #edb/ref 17592186502404}] :answer-field/correct {:db/id #edb/ref 17592186502404} :answer-field/id #uuid "139bd750-f127-56f4-9c8c-dad3ecb6aa91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502330}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "15405bfd-218a-5ebb-ac44-be3eba615aca" :question/problem "![](images/d6/d62b7f63213e0a36a4cc186c396de6986f8c9e594fa045791d9c37fad7550f60.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $m+n$. Choose the unit vector in the same direction." :question/worked-solution "First, we have to find $m+n$. According to the triangle law of addition, the resultant $m+n$ goes from the tail of $m$ to the head of $n$:\n\n![](images/ae/ae31ae08afde8173954eef7609108f51e2a5113e7ef37a815511d29e653f33bf.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=0.5$ and $BH=1.5$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{\\left(\\frac{1}{2}\\right)^2+\\left(\\frac{3}{2}\\right)^2} \\\\\n&= \\sqrt{\\frac{1}{4}+\\frac{9}{4}} \\\\\n&= \\frac{\\sqrt{10}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $m+n$ is $\\frac{\\sqrt{10}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|m+n|}\\cdot (m+n) \\\\\n&= \\frac{\\sqrt{10}}{5}(m+n)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44542f74-71e7-507c-ba2a-4a28f636ac89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{2}}{5}c" :db/id #edb/ref 17592186502352} {:answer/id #uuid "57d39e45-b7dc-5b05-accd-6ded543fb154" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{2}}{2}c" :db/id #edb/ref 17592186502357} {:answer/id #uuid "c55ad23b-68a1-557a-aa55-3f07c42db8a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{25}c" :db/id #edb/ref 17592186502405} {:answer/id #uuid "e16574a4-34e8-54cf-a77e-3ad1ef0fe437" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{5}c" :db/id #edb/ref 17592186502420} {:answer/id #uuid "e9b27dcd-fc04-5048-9e40-7aa9d5043980" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}c" :db/id #edb/ref 17592186502422}] :answer-field/correct {:db/id #edb/ref 17592186502420} :answer-field/id #uuid "94d9330f-8252-5b46-9c3b-ad958ccbb399" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502378}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "25059bd6-40b8-5009-96b3-70ae023f7607" :question/problem "![](images/35/35ce1ab5c1689dca152c58e955e4a43c0be0e2bc6a796bf20e84f2c99786f8ca.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $c$. Choose the unit vector in the same direction." :question/worked-solution "![](images/9b/9b906579f40ce2a1c59129d80540b339c1bb00fcd9a5f5ce179b01efeb702ab5.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=3.5$ and $BH=0.5$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{\\left(\\frac{7}{2}\\right)^2+\\left(\\frac{1}{2}\\right)^2} \\\\\n&= \\sqrt{\\frac{49}{4}+\\frac{1}{4}} \\\\\n&= \\frac{5 \\sqrt{2}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $c$ is $\\frac{5 \\sqrt{2}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|c|}\\cdot c \\\\\n&= \\frac{\\sqrt{2}}{5}c\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aeab7be-8c7d-5a3a-be9f-120546db36cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{17}c" :db/id #edb/ref 17592186502337} {:answer/id #uuid "78dffdfd-3b80-57ec-a318-d95ddef548d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{17}}{17}c" :db/id #edb/ref 17592186502369} {:answer/id #uuid "b21b2119-51aa-5753-ab74-53f404fe7b91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}c" :db/id #edb/ref 17592186502390} {:answer/id #uuid "c0949ae1-36a1-539c-9ddd-694612a88e72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{17}}{2}c" :db/id #edb/ref 17592186502402} {:answer/id #uuid "dc94450a-5a6d-5d38-bd5d-47e15a6a879e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{17}}{17}c" :db/id #edb/ref 17592186502416}] :answer-field/correct {:db/id #edb/ref 17592186502369} :answer-field/id #uuid "ebf6beda-d9da-55d2-92ef-7c06f8adde74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502423}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2e59a005-0b33-5ed7-ad5d-fc08843b1882" :question/problem "![](images/11/1112fef974be645940a11f8f3f099ca6b0125a6a92ca8642712dde7b86c63ac8.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $c$. Choose the unit vector in the same direction." :question/worked-solution "![](images/4c/4c8930d8535e42d793def554d8e65943e637c02debb6d411048096ba1b8cda68.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=2$ and $BH=0.5$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(2)^2+\\left(\\frac{1}{2}\\right)^2} \\\\\n&= \\sqrt{4+\\frac{1}{4}} \\\\\n&= \\frac{\\sqrt{17}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $c$ is $\\frac{\\sqrt{17}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|c|}\\cdot c \\\\\n&= \\frac{2 \\sqrt{17}}{17}c\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d788b6-d7d5-53f9-baa9-94394f07c1f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}(m+n)" :db/id #edb/ref 17592186502346} {:answer/id #uuid "3ac393dd-d1cc-54b8-bd96-c686fc1523d0" :answer/type {:d