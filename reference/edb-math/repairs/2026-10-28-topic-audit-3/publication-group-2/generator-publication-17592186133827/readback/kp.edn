ac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=11 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(11)(t) \\\\  & =11 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{6}}(11 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{6}}11 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{25}\\frac{11}{8}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{11}{8}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{25} \\\\  & =\\frac{11}{12}[(25)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{11}{12}[(125)-(1)] \\\\  & =\\left(\\frac{1375}{12}\\right)-\\left(\\frac{11}{12}\\right) \\\\  & =\\frac{341}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57f928b7-f3c1-52b5-b1f3-e51f2ac25685" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{15 \\sqrt{14}}{26} + \\frac{45 \\sqrt{3}}{26}" :db/id #edb/ref 17592186536191} {:answer/id #uuid "5e2f52fd-d5a6-5f97-8553-e4f43e399741" :answer/type {:db/ident :answer.type/math} :answer/value "- 70 \\sqrt{14} + 405 \\sqrt{3}" :db/id #edb/ref 17592186536192} {:answer/id #uuid "6a2ab4f5-0f77-542a-ae0c-3c24c174ddd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186536198} {:answer/id #uuid "de7178fd-a762-590b-a176-d5866a3e8366" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{35 \\sqrt{14}}{13} + \\frac{405 \\sqrt{3}}{26}" :db/id #edb/ref 17592186536231} {:answer/id #uuid "e54c1709-79ec-5e74-9903-bf87dcc8ae95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35 \\sqrt{14}}{13} + \\frac{405 \\sqrt{3}}{26}" :db/id #edb/ref 17592186536234}] :answer-field/correct {:answer/id #uuid "de7178fd-a762-590b-a176-d5866a3e8366" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{35 \\sqrt{14}}{13} + \\frac{405 \\sqrt{3}}{26}" :db/id #edb/ref 17592186536231} :answer-field/id #uuid "5f6f04f0-a3b7-5983-aafe-e6b7a4a0ae76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536194}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4598c153-f2b3-5aa3-bf7d-421ba3e4749e" :question/problem "Evaluate the line integral of the function $f(x,y,z)=\\frac{3 y + 3 z}{x}$ along the curve parametrized by $r(t)=\\langle t,t^{2},\\frac{3 t^{2}}{2}\\rangle$ for $t\\in [1,\\sqrt{2}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t)\\,i+(t^{2})\\,j+\\left(\\frac{3 t^{2}}{2}\\right)\\,k$, then along the curve we have $x=t$, $y=t^{2}$, $z=\\frac{3 t^{2}}{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{3 t^{2}}{2}\\right)\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(3 t)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(1)^2+(2 t)^2+(3 t)^2} \\\\  & =\\sqrt{13 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{3 y + 3 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(3)[(t^{2})+\\left(\\frac{3 t^{2}}{2}\\right)]}{t} \\\\  & =\\frac{\\left(\\frac{15}{2}\\right)t^2}{(1)t} \\\\  & =\\frac{15 t}{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{1}^{\\sqrt{2}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{1}^{\\sqrt{2}}\\left(\\frac{15 t}{2}\\right)(\\sqrt{13 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=13 t^{2} + 1$, $\\text{d}u=(26 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\sqrt{2}}\\frac{15 t \\sqrt{13 t^{2} + 1}}{2}\\,\\text{d}t & ={\\int }_{14}^{27}\\sqrt{u}\\cdot \\frac{15}{52}\\,\\text{d}u \\\\  & =\\frac{15}{52}{\\int }_{14}^{27}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{15}{52}\\cdot\\frac{2}{3}u^{3/2}\\big|_{14}^{27} \\\\  & =\\frac{5}{26}[(27)^{3/2}-(14)^{3/2}] \\\\  & =\\frac{5}{26}[(81 \\sqrt{3})-(14 \\sqrt{14})] \\\\  & =\\left(\\frac{405 \\sqrt{3}}{26}\\right)-\\left(\\frac{35 \\sqrt{14}}{13}\\right) \\\\  & =- \\frac{35 \\sqrt{14}}{13} + \\frac{405 \\sqrt{3}}{26}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08930374-f1d2-5c84-b19a-2683f1af6485" :answer/type {:db/ident :answer.type/math} :answer/value "- 100 \\sqrt{30} + \\frac{1120 \\sqrt{14}}{3}" :db/id #edb/ref 17592186536173} {:answer/id #uuid "6e5c7801-aeea-5abc-8505-a02245d7ee46" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{30}}{13} + \\frac{10 \\sqrt{14}}{13}" :db/id #edb/ref 17592186536201} {:answer/id #uuid "af8bd43c-2eb0-5278-8be1-06e077eda466" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{50 \\sqrt{30}}{13} + \\frac{560 \\sqrt{14}}{39}" :db/id #edb/ref 17592186536217} {:answer/id #uuid "e3e839ff-7be3-5f5c-93ae-9e4bc0b08ed9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{50 \\sqrt{30}}{13} + \\frac{560 \\sqrt{14}}{39}" :db/id #edb/ref 17592186536233} {:answer/id #uuid "e74cf37d-93ab-51d4-a5b3-0b2e116e7daf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186536236}] :answer-field/correct {:answer/id #uuid "af8bd43c-2eb0-5278-8be1-06e077eda466" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{50 \\sqrt{30}}{13} + \\frac{560 \\sqrt{14}}{39}" :db/id #edb/ref 17592186536217} :answer-field/id #uuid "d79b1b5d-3a71-51d9-b679-1016c4c4285b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536229}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4eee203b-5512-5c93-95fe-15ef6820bb5a" :question/problem "Evaluate the line integral of the function $f(x,y,z)=\\frac{4 y + 4 z}{x}$ along the curve parametrized by $r(t)=\\langle 2 t,\\frac{3 t^{2}}{2},t^{2}\\rangle$ for $t\\in [\\sqrt{2},2].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(2 t)\\,i+\\left(\\frac{3 t^{2}}{2}\\right)\\,j+(t^{2})\\,k$, then along the curve we have $x=2 t$, $y=\\frac{3 t^{2}}{2}$, $z=t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t)\\,i+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{3 t^{2}}{2}\\right)\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(2)\\,i+(3 t)\\,j+(2 t)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2)^2+(3 t)^2+(2 t)^2} \\\\  & =\\sqrt{13 t^{2} + 4}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{4 y + 4 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(4)[\\left(\\frac{3 t^{2}}{2}\\right)+(t^{2})]}{2 t} \\\\  & =\\frac{(10)t^2}{(2)t} \\\\  & =5 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{\\sqrt{2}}^{2}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{2}(5 t)(\\sqrt{13 t^{2} + 4})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=13 t^{2} + 4$, $\\text{d}u=(26 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{2}5 t \\sqrt{13 t^{2} + 4}\\,\\text{d}t & ={\\int }_{30}^{56}\\sqrt{u}\\cdot \\frac{5}{26}\\,\\text{d}u \\\\  & =\\frac{5}{26}{\\int }_{30}^{56}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{5}{26}\\cdot\\frac{2}{3}u^{3/2}\\big|_{30}^{56} \\\\  & =\\frac{5}{39}[(56)^{3/2}-(30)^{3/2}] \\\\  & =\\frac{5}{39}[(112 \\sqrt{14})-(30 \\sqrt{30})] \\\\  & =\\left(\\frac{560 \\sqrt{14}}{39}\\right)-\\left(\\frac{50 \\sqrt{30}}{13}\\right) \\\\  & =- \\frac{50 \\sqrt{30}}{13} + \\frac{560 \\sqrt{14}}{39}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a24a14e-7ef5-5ad1-a61b-3b0c903f1bbb" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{25 \\sqrt{30}}{13} + \\frac{215 \\sqrt{43}}{78}" :db/id #edb/ref 17592186536178} {:answer/id #uuid "32658cc0-fb41-54b1-adeb-b587a3ed9bd3" :answer/type {:db/ident :answer.type/math} :answer/value "- 50 \\sqrt{30} + \\frac{215 \\sqrt{43}}{3}" :db/id #edb/ref 17592186536183} {:answer/id #uuid "52633d9b-e8c6-534c-a7d5-036ac4ee235e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186536190} {:answer/id #uuid "771125d9-54a3-59c0-aaa9-f0634bc33656" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{30}}{26} + \\frac{5 \\sqrt{43}}{26}" :db/id #edb/ref 17592186536202} {:answer/id #uuid "c5a182f5-b696-5167-9387-544100c2c212" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25 \\sqrt{30}}{13} + \\frac{215 \\sqrt{43}}{78}" :db/id #edb/ref 17592186536222}] :answer-field/correct {:answer/id #uuid "1a24a14e-7ef5-5ad1-a61b-3b0c903f1bbb" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{25 \\sqrt{30}}{13} + \\frac{215 \\sqrt{43}}{78}" :db/id #edb/ref 17592186536178} :answer-field/id #uuid "e67895d3-d4ec-5187-b82d-db3c871037c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536235}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "610b886f-b7bb-5ac0-b2cd-087760dc82c1" :question/problem "Evaluate the line integral of the function $f(x,y,z)=\\frac{2 y + 2 z}{x}$ along the curve parametrized by $r(t)=\\langle 2 t,t^{2},\\frac{3 t^{2}}{2}\\rangle$ for $t\\in [\\sqrt{2},\\sqrt{3}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(2 t)\\,i+(t^{2})\\,j+\\left(\\frac{3 t^{2}}{2}\\right)\\,k$, then along the curve we have $x=2 t$, $y=t^{2}$, $z=\\frac{3 t^{2}}{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{3 t^{2}}{2}\\right)\\,k \\\\  & =(2)\\,i+(2 t)\\,j+(3 t)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2)^2+(2 t)^2+(3 t)^2} \\\\  & =\\sqrt{13 t^{2} + 4}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{2 y + 2 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(2)[(t^{2})+\\left(\\frac{3 t^{2}}{2}\\right)]}{2 t} \\\\  & =\\frac{(5)t^2}{(2)t} \\\\  & =\\frac{5 t}{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{\\sqrt{2}}^{\\sqrt{3}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{\\sqrt{3}}\\left(\\frac{5 t}{2}\\right)(\\sqrt{13 t^{2} + 4})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=13 t^{2} + 4$, $\\text{d}u=(26 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{\\sqrt{3}}\\frac{5 t \\sqrt{13 t^{2} + 4}}{2}\\,\\text{d}t & ={\\int }_{30}^{43}\\sqrt{u}\\cdot \\frac{5}{52}\\,\\text{d}u \\\\  & =\\frac{5}{52}{\\int }_{30}^{43}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{5}{52}\\cdot\\frac{2}{3}u^{3/2}\\big|_{30}^{43} \\\\  & =\\frac{5}{78}[(43)^{3/2}-(30)^{3/2}] \\\\  & =\\frac{5}{78}[(43 \\sqrt{43})-(30 \\sqrt{30})] \\\\  & =\\left(\\frac{215 \\sqrt{43}}{78}\\right)-\\left(\\frac{25 \\sqrt{30}}{13}\\right) \\\\  & =- \\frac{25 \\sqrt{30}}{13} + \\frac{215 \\sqrt{43}}{78}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5117585f-11b3-58c4-a2ed-93bfe6a37773" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536189} {:answer/id #uuid "83e9d980-388d-545d-aea1-9c61f2ded7ac" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}" :db/id #edb/ref 17592186536204} {:answer/id #uuid "89459d10-f9bc-56f1-8dfa-8495b9630dd5" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5}{2} + \\frac{\\sqrt{41}}{2}" :db/id #edb/ref 17592186536208} {:answer/id #uuid "8be88d4f-cace-5fd8-b578-2774c746c989" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}" :db/id #edb/ref 17592186536209} {:answer/id #uuid "d0cf66d8-37ef-5803-bb94-f6ef1e86c800" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1000}{3} + \\frac{328 \\sqrt{41}}{3}" :db/id #edb/ref 17592186536223}] :answer-field/correct {:answer/id #uuid "83e9d980-388d-545d-aea1-9c61f2ded7ac" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}" :db/id #edb/ref 17592186536204} :answer-field/id #uuid "f83931f4-8222-5091-a3ba-b17f6d5b10e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536240}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "660f6c2f-13cf-5ed3-95da-d564af1963e0" :question/problem "Evaluate the line integral of the function $f(x,y,z)=\\frac{6 y + 6 z}{x}$ along the curve parametrized by $r(t)=\\langle 3 t,t^{2},t^{2}\\rangle$ for $t\\in [\\sqrt{2},2].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 t)\\,i+(t^{2})\\,j+(t^{2})\\,k$, then along the curve we have $x=3 t$, $y=t^{2}$, $z=t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(3)\\,i+(2 t)\\,j+(2 t)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(3)^2+(2 t)^2+(2 t)^2} \\\\  & =\\sqrt{8 t^{2} + 9}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{6 y + 6 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(6)[(t^{2})+(t^{2})]}{3 t} \\\\  & =\\frac{(12)t^2}{(3)t} \\\\  & =4 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{\\sqrt{2}}^{2}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{2}(4 t)(\\sqrt{8 t^{2} + 9})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=8 t^{2} + 9$, $\\text{d}u=(16 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{2}4 t \\sqrt{8 t^{2} + 9}\\,\\text{d}t & ={\\int }_{25}^{41}\\sqrt{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{25}^{41}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot\\frac{2}{3}u^{3/2}\\big|_{25}^{41} \\\\  & =\\frac{1}{6}[(41)^{3/2}-(25)^{3/2}] \\\\  & =\\frac{1}{6}[(41 \\sqrt{41})-(125)] \\\\  & =\\left(\\frac{41 \\sqrt{41}}{6}\\right)-\\left(\\frac{125}{6}\\right) \\\\  & =- \\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c3f34f-1c70-50e1-b7bf-ff41e0ef0902" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186536176} {:answer/id #uuid "6e1da80c-59bf-589c-a938-df19a1306cef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{860}{3}" :db/id #edb/ref 17592186536200} {:answer/id #uuid "b9ed84e8-6f14-5594-a806-33a9e9aa364c" :answer/type {:db/ident :answer.type/math} :answer/value "2280" :db/id #edb/ref 17592186536218} {:answer/id #uuid "d56a59cf-94dd-52d7-a8c9-3ae73263f82d" :answer/type {:db/ident :answer.type/math} :answer/value "285" :db/id #edb/ref 17592186536228} {:answer/id #uuid "f23229f8-4fcb-51b5-b69a-bfdcbeacb7c3" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186536239}] :answer-field/correct {:answer/id #uuid "d56a59cf-94dd-52d7-a8c9-3ae73263f82d" :answer/type {:db/ident :answer.type/math} :answer/value "285" :db/id #edb/ref 17592186536228} :answer-field/id #uuid "5f40dc3b-86d8-585e-98f4-9b2f3c029b58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536193}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bc131f90-387e-54b0-bfab-a8eb22f2797f" :question/problem "Evaluate the line integral of the function $f(x,y)=10 y$ along the curve parametrized by $r(t)=\\langle t^{2},t\\rangle$ for $t\\in [0,2 \\sqrt{3}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t^{2})\\,i+(t)\\,j$, then along the curve we have $x=t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(2 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=10 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(10)(t) \\\\  & =10 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{2 \\sqrt{3}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{2 \\sqrt{3}}(10 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2 \\sqrt{3}}10 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{49}\\frac{5}{4}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{5}{4}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{49} \\\\  & =\\frac{5}{6}[(49)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{5}{6}[(343)-(1)] \\\\  & =\\left(\\frac{1715}{6}\\right)-\\left(\\frac{5}{6}\\right) \\\\  & =285\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c94afe4-cdcf-5f7f-ad7d-644f56ba78be" :answer/type {:db/ident :answer.type/math} :answer/value "6 \\sqrt{5}" :db/id #edb/ref 17592186536181} {:answer/id #uuid "6bcf5482-d032-5cb5-832a-7e160c6f0b28" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\sqrt{5} \\sin{\\left(\\frac{\\sqrt{3} \\sqrt{\\pi}}{6} \\right)}" :db/id #edb/ref 17592186536199} {:answer/id #uuid "7c80f3d4-abe2-593e-a0b6-9a8763440675" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186536203} {:answer/id #uuid "8c2b1f95-0ba2-57cf-818a-fede800a91f2" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\sqrt{5} \\left(-1 + \\frac{\\sqrt{3}}{2}\\right)" :db/id #edb/ref 17592186536210} {:answer/id #uuid "d4abf743-e772-522d-adfb-5c4592283ab2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{5}}{2}" :db/id #edb/ref 17592186536226}] :answer-field/correct {:answer/id #uuid "d4abf743-e772-522d-adfb-5c4592283ab2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{5}}{2}" :db/id #edb/ref 17592186536226} :answer-field/id #uuid "87810930-e74a-5f50-8241-46263ccebad7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536207}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c2ce718e-45c4-5f03-8361-b5c8663f79aa" :question/problem "Evaluate the line integral of the function $f(x,y)=3 \\cos{\\left(x \\right)}$ along the curve parametrized by $r(t)=\\langle 2 t^{2},- 4 t^{2}\\rangle$ for $t\\in [0,\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(2 t^{2})\\,i+(- 4 t^{2})\\,j$, then along the curve we have $x=2 t^{2}$, $y=- 4 t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(- 4 t^{2})\\,j \\\\  & =(4 t)\\,i+(- 8 t)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(4 t)^2+(- 8 t)^2} \\\\  & =\\sqrt{80 t^{2}} \\\\  & =4 \\sqrt{5}|t| \\\\  & =4 \\sqrt{5} t\\end{aligned}\n$$\n\nNotice that $|t|=t$ because $t\\geq0$ along the path of $C.$\n\nNow, since $f(x,y)=3 \\cos{\\left(x \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3 \\cos{\\left(2 t^{2} \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}}(3 \\cos{\\left(2 t^{2} \\right)})(4 \\sqrt{5} t)\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2 t^{2}$, $\\text{d}u=(4 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}}12 \\sqrt{5} t \\cos{\\left(2 t^{2} \\right)}\\,\\text{d}t & ={\\int }_{0}^{\\frac{\\pi}{6}}3 \\sqrt{5}\\cdot \\cos u\\,\\text{d}u \\\\  & =3 \\sqrt{5}\\sin u\\big|_{0}^{\\frac{\\pi}{6}} \\\\  & =3 \\sqrt{5}[\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin(0)] \\\\  & =3 \\sqrt{5}[\\left(\\frac{1}{2}\\right)-(0)] \\\\  & =\\left(\\frac{3 \\sqrt{5}}{2}\\right)-(0) \\\\  & =\\frac{3 \\sqrt{5}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32401b01-66d1-582d-8f93-fdd0495d51ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{992}{3}" :db/id #edb/ref 17592186536182} {:answer/id #uuid "8f7db02d-15e7-5e26-b9ba-c564c254f76d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536212} {:answer/id #uuid "9e8a9183-5730-550b-80d7-41a03b8fc3ac" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186536213} {:answer/id #uuid "a6d9fc85-6374-5f2f-8f41-47ba6361411d" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186536215} {:answer/id #uuid "d3d96dc4-fa03-5034-bac5-1b848d99d4f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{3}" :db/id #edb/ref 17592186536225}] :answer-field/correct {:answer/id #uuid "d3d96dc4-fa03-5034-bac5-1b848d99d4f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{3}" :db/id #edb/ref 17592186536225} :answer-field/id #uuid "ad468d44-fb68-5a19-a5ba-ce398186f0b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536216}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c45dcc44-5b16-5bcb-8c40-42484661e768" :question/problem "Evaluate the line integral of the function $f(x,y)=4 y$ along the curve parametrized by $r(t)=\\langle t^{2},t\\rangle$ for $t\\in [0,\\sqrt{6}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t^{2})\\,i+(t)\\,j$, then along the curve we have $x=t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(2 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=4 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(4)(t) \\\\  & =4 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{6}}(4 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{6}}4 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{25}\\frac{1}{2}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{25} \\\\  & =\\frac{1}{3}[(25)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{1}{3}[(125)-(1)] \\\\  & =\\left(\\frac{125}{3}\\right)-\\left(\\frac{1}{3}\\right) \\\\  & =\\frac{124}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87256819-2e49-5e9c-89f5-72825a02e536" :answer/type {:db/ident :answer.type/math} :answer/value "1-2\\sqrt2" :db/id #edb/ref 17592186700692} {:answer/id #uuid "adeb24cd-d6e0-5d44-a9ff-a7be9c840c13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac32" :db/id #edb/ref 17592186700697} {:answer/id #uuid "cde1b3a3-e76c-503b-850d-8bd31b548cc4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt2-1" :db/id #edb/ref 17592186700702} {:answer/id #uuid "e8eb8386-e3b0-5810-96be-3621c2fa7e16" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac23(2\\sqrt2-1)" :db/id #edb/ref 17592186700705} {:answer/id #uuid "f2894531-86b8-5027-a00f-ab1a76c8f98b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt2" :db/id #edb/ref 17592186700707}] :answer-field/correct {:answer/id #uuid "cde1b3a3-e76c-503b-850d-8bd31b548cc4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt2-1" :db/id #edb/ref 17592186700702} :answer-field/id #uuid "f19ea2ac-b621-56d8-bd99-b79d832a9765" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700706}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "56e093a1-badc-5734-b16b-054c37904e43" :question/problem "Evaluate the line integral\n\n$$\n\\int_C 3yz\\cos x\\,\\mathrm ds,\n$$\n\nwhere\n\n$$\n\\mathbf r(t)=\\langle t,\\sin t,1\\rangle,\\qquad 0\\le t\\le\\frac\\pi2.\n$$\n\nGive the exact value." :question/worked-solution "Use the scalar line integral formula\n\n$$\n\\int_C f\\,\\mathrm ds=\\int_a^b f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm dt.\n$$\n\nAlong the curve, $x=t$, $y=\\sin t$, and $z=1$. Hence\n\n$$\nf(\\mathbf r(t))=3\\sin t\\cos t.\n$$\n\nDifferentiate all three coordinates and compute the speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 1,\\cos t,0\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{1+\\cos^2t}.\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\int_C 3yz\\cos x\\,\\mathrm ds\n=\\int_0^{\\pi/2}3\\sin t\\cos t\\sqrt{1+\\cos^2t}\\,\\mathrm dt.\n$$\n\nChoose $u=1+\\cos^2t$. Then $\\mathrm du=-2\\sin t\\cos t\\,\\mathrm dt$. The limits reverse:\n\n| $t$ | $0$ | $\\frac\\pi2$ |\n| --- | --- | --- |\n| $u$ | $2$ | $1$ |\n\nSo\n\n$$\n\\begin{aligned}\n\\int_C 3yz\\cos x\\,\\mathrm ds\n&=-\\frac32\\int_2^1 u^{1/2}\\,\\mathrm du\\\\\n&=\\frac32\\int_1^2 u^{1/2}\\,\\mathrm du\\\\\n&=\\left[u^{3/2}\\right]_1^2\\\\\n&=2\\sqrt2-1.\n\\end{aligned}\n$$\n\nThe integrand is nonnegative on this interval, which also checks the sign."} {:db/id #edb/ref 17592186700698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "470fd09c-2842-5207-903a-32f6c2c8d5a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186700687} {:answer/id #uuid "759b8130-52ab-5356-8d16-c80951fb2b73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32-3\\sqrt6}{5}" :db/id #edb/ref 17592186700690} {:answer/id #uuid "a6d1f8c6-0c06-53aa-ba95-3d037136b925" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac32" :db/id #edb/ref 17592186700695} {:answer/id #uuid "aa31bef7-4b10-5b0a-bfad-bb01518bd542" :answer/type {:db/ident :answer.type/math} :answer/value "4-\\sqrt2" :db/id #edb/ref 17592186700696} {:answer/id #uuid "c4187bd4-b094-50c6-9d6b-0208e95835a9" :answer/type {:db/ident :answer.type/math} :answer/value "32-3\\sqrt6" :db/id #edb/ref 17592186700701}] :answer-field/correct {:answer/id #uuid "759b8130-52ab-5356-8d16-c80951fb2b73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32-3\\sqrt6}{5}" :db/id #edb/ref 17592186700690} :answer-field/id #uuid "b5c2c7f4-339d-5a6b-a4dd-1e042be81dc5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700699}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b0411044-fc20-574c-a3d2-b78307b21dd1" :question/problem "Evaluate the line integral\n\n$$\n\\int_C\\frac{y+z}{x}\\,\\mathrm ds,\n$$\n\nwhere\n\n$$\n\\mathbf r(t)=\\left\\langle t,\\frac{t^2}{2},t^2\\right\\rangle,\\qquad 1\\le t\\le\\sqrt3.\n$$\n\nGive the exact value." :question/worked-solution "For a scalar function in three variables,\n\n$$\n\\int_C f\\,\\mathrm ds=\\int_a^b f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm dt.\n$$\n\nHere $x=t$, $y=t^2/2$, and $z=t^2$. Since $t\\ge1$, the denominator is nonzero, and\n\n$$\nf(\\mathbf r(t))=\\frac{t^2/2+t^2}{t}=\\frac32t.\n$$\n\nAll three derivative components contribute to arc length:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 1,t,2t\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{1^2+t^2+(2t)^2}=\\sqrt{1+5t^2}.\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\int_C\\frac{y+z}{x}\\,\\mathrm ds\n=\\int_1^{\\sqrt3}\\frac32t\\sqrt{1+5t^2}\\,\\mathrm dt.\n$$\n\nChoose $u=1+5t^2$, so $\\mathrm du=10t\\,\\mathrm dt$ and $\\frac32t\\,\\mathrm dt=\\frac3{20}\\,\\mathrm du$. The transformed limits are\n\n| $t$ | $1$ | $\\sqrt3$ |\n| --- | --- | --- |\n| $u$ | $6$ | $16$ |\n\nIt follows that\n\n$$\n\\begin{aligned}\n\\int_C\\frac{y+z}{x}\\,\\mathrm ds\n&=\\frac3{20}\\int_6^{16}u^{1/2}\\,\\mathrm du\\\\\n&=\\frac1{10}\\left[u^{3/2}\\right]_6^{16}\\\\\n&=\\frac{64-6\\sqrt6}{10}\\\\\n&=\\frac{32-3\\sqrt6}{5}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "673ee373-4257-5e1b-98e4-e28ae6539e00" :answer/type {:db/ident :answer.type/math} :answer/value "4(5\\sqrt5-1)" :db/id #edb/ref 17592186700689} {:answer/id #uuid "7e9dbede-9e49-5313-83e3-c1898bb46155" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5}{2}" :db/id #edb/ref 17592186700691} {:answer/id #uuid "8e10081f-1d09-5341-80c8-fc705707a900" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186700693} {:answer/id #uuid "9c9c8ad1-56c5-54e6-a286-4fc2e4b820e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5-1}{2}" :db/id #edb/ref 17592186700694} {:answer/id #uuid "e70037de-5b4c-50ec-956d-b0441e1e0034" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt5-1}{2}" :db/id #edb/ref 17592186700704}] :answer-field/correct {:answer/id #uuid "9c9c8ad1-56c5-54e6-a286-4fc2e4b820e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5-1}{2}" :db/id #edb/ref 17592186700694} :answer-field/id #uuid "d26120d5-a2cc-5919-8cc1-c929341f09a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700703}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c3fd95d9-ac39-5143-ab7b-7b87094db6e4" :question/problem "Evaluate the line integral of $f(x,y)=6y$ along the curve\n\n$$\n\\mathbf r(t)=\\langle t^2,t\\rangle,\\qquad 0\\le t\\le 1.\n$$\n\nUse\n\n$$\n\\int_C f\\,\\mathrm ds=\\int_a^b f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm dt.\n$$\n\nFor this curve, $\\|\\mathbf r'(t)\\|=\\sqrt{4t^2+1}$. Use the substitution $u=4t^2+1$ and give the exact value." :question/worked-solution "Along the curve, $x=t^2$ and $y=t$, so $f(\\mathbf r(t))=6t$. The supplied speed follows from\n\n$$\n\\mathbf r'(t)=\\langle 2t,1\\rangle,\\qquad\n\\|\\mathbf r'(t)\\|=\\sqrt{(2t)^2+1^2}=\\sqrt{4t^2+1}.\n$$\n\nThus\n\n$$\n\\int_C 6y\\,\\mathrm ds=\\int_0^1 6t\\sqrt{4t^2+1}\\,\\mathrm dt.\n$$\n\nWith $u=4t^2+1$, we have $\\mathrm du=8t\\,\\mathrm dt$ and $6t\\,\\mathrm dt=\\frac34\\,\\mathrm du$. Change both limits:\n\n| $t$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $5$ |\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int_C 6y\\,\\mathrm ds\n&=\\frac34\\int_1^5 u^{1/2}\\,\\mathrm du\\\\\n&=\\frac12\\left[u^{3/2}\\right]_1^5\\\\\n&=\\frac{5\\sqrt5-1}{2}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c21b08c-6569-5a70-9eab-5ab764295e85" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{108}" :db/id #edb/ref 17592186701105} {:answer/id #uuid "43020db3-5943-5475-9919-0d602f443458" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186701106} {:answer/id #uuid "80ae634d-389d-5b49-8bbf-e00839bfb9ec" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{10 \\sqrt{3}}{3}" :db/id #edb/ref 17592186701115} {:answer/id #uuid "8ea070e5-5022-53a7-8782-c4c0a56f7b8b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{120}" :db/id #edb/ref 17592186701118} {:answer/id #uuid "b19ffb40-1a41-577e-b157-d65d7caa5566" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{18}" :db/id #edb/ref 17592186701123}] :answer-field/correct {:answer/id #uuid "43020db3-5943-5475-9919-0d602f443458" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186701106} :answer-field/id #uuid "79c8b8d8-6162-596d-9a0c-1809a555fa8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701112}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "00b17c43-8b90-5d56-be0c-96bcd18391ca" :question/problem "Evaluate the line integral of $f(x,y)=- 2 \\cos{\\left(x \\right)}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 t^{2},- t^{2}\\rangle,\\qquad 0\\le t\\le \\sqrt{\\frac{\\pi}{9}}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 t^{2})\\,i+(- t^{2})\\,j$, then along the curve we have $x=3 t^{2}$, $y=- t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(- t^{2})\\,j \\\\  & =(6 t)\\,i+(- 2 t)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(6 t)^2+(- 2 t)^2} \\\\  & =\\sqrt{40 t^{2}} \\\\  & =2 \\sqrt{10}|t| \\\\  & =2 \\sqrt{10} t\\end{aligned}\n$$\n\nNotice that $|t|=t$ because $t\\geq0$ along the path of $C.$\n\nNow, since $f(x,y)=- 2 \\cos{\\left(x \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =- 2 \\cos{\\left(3 t^{2} \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\sqrt{\\frac{\\pi}{9}}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{\\frac{\\pi}{9}}}(- 2 \\cos{\\left(3 t^{2} \\right)})(2 \\sqrt{10} t)\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=3 t^{2}$, $\\text{d}u=(6 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{0}^{\\frac{\\pi}{3}}- \\frac{2 \\sqrt{10}}{3}\\cdot \\cos u\\,\\text{d}u \\\\  & =- \\frac{2 \\sqrt{10}}{3}\\sin u\\big|_{0}^{\\frac{\\pi}{3}} \\\\  & =- \\frac{2 \\sqrt{10}}{3}[\\sin\\left(\\frac{\\pi}{3}\\right)-\\sin(0)] \\\\  & =- \\frac{2 \\sqrt{10}}{3}[\\left(\\frac{\\sqrt{3}}{2}\\right)-(0)] \\\\  & =\\left(- \\frac{\\sqrt{30}}{3}\\right)-(0) \\\\  & =- \\frac{\\sqrt{30}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd13bde-6d9e-5c3e-a4e5-cbd2a122ea69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{72}" :db/id #edb/ref 17592186701102} {:answer/id #uuid "54b220d4-3608-58cb-9d7f-6065d629f80a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{72}" :db/id #edb/ref 17592186701108} {:answer/id #uuid "8567bcad-90d3-51dd-ad8a-5da667384e2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{24}" :db/id #edb/ref 17592186701117} {:answer/id #uuid "9f0f8bf8-39e8-514b-a0ba-920b358a7e31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3125}{72}" :db/id #edb/ref 17592186701120} {:answer/id #uuid "ba61f66e-7d07-534c-a9db-793099510320" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{625}{72}" :db/id #edb/ref 17592186701125}] :answer-field/correct {:answer/id #uuid "0fd13bde-6d9e-5c3e-a4e5-cbd2a122ea69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{72}" :db/id #edb/ref 17592186701102} :answer-field/id #uuid "0e8991dd-c0bc-5bd8-8dde-990f2b621f47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701101}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4b2c3d27-3ea7-5c92-afe5-8617224ddffe" :question/problem "Evaluate the line integral of $f(x,y)=\\frac{x^{2}}{3} + \\frac{y^{2}}{3}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 \\sin{\\left(t \\right)},- 4 \\sin{\\left(t \\right)}\\rangle,\\qquad 0\\le t\\le \\frac{\\pi}{6}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 \\sin{\\left(t \\right)})\\,i+(- 4 \\sin{\\left(t \\right)})\\,j$, then along the curve we have $x=3 \\sin{\\left(t \\right)}$, $y=- 4 \\sin{\\left(t \\right)}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 \\sin{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(- 4 \\sin{\\left(t \\right)})\\,j \\\\  & =(3 \\cos{\\left(t \\right)})\\,i+(- 4 \\cos{\\left(t \\right)})\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(3 \\cos{\\left(t \\right)})^2+(- 4 \\cos{\\left(t \\right)})^2} \\\\  & =\\sqrt{9\\cos^2 t+16\\cos^2 t} \\\\  & =\\sqrt{25 \\cos^{2}{\\left(t \\right)}} \\\\  & =5|\\cos t| \\\\  & =5 \\cos{\\left(t \\right)}\\end{aligned}\n$$\n\nNotice that $|\\cos t|=\\cos t$ because $\\cos t\\geq0$ along this interval.\n\nNow, since $f(x,y)=\\frac{x^{2}}{3} + \\frac{y^{2}}{3}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(3 \\sin{\\left(t \\right)})^2+(- 4 \\sin{\\left(t \\right)})^2}{3} \\\\  & =\\frac{9\\sin^2 t+16\\sin^2 t}{3} \\\\  & =\\frac{25 \\sin^{2}{\\left(t \\right)}}{3}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}\\left(\\frac{25 \\sin^{2}{\\left(t \\right)}}{3}\\right)(5 \\cos{\\left(t \\right)})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}\\frac{125 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)}}{3}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\sin{\\left(t \\right)}$, $\\text{d}u=(\\cos{\\left(t \\right)})\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{0}^{\\frac{1}{2}}\\frac{125}{3}\\cdot u^2\\,\\text{d}u \\\\  & =\\frac{125}{3}\\cdot\\frac{u^3}{3}\\big|_{0}^{\\frac{1}{2}} \\\\  & =\\frac{125}{3}[\\frac{\\left(\\frac{1}{2}\\right)^3}{3}-\\frac{(0)^3}{3}] \\\\  & =\\frac{125}{3}[\\left(\\frac{1}{24}\\right)-(0)] \\\\  & =\\left(\\frac{125}{72}\\right)-(0) \\\\  & =\\frac{125}{72}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06158c03-ef05-5409-9ac8-f73d9749fbd7" :answer/type {:db/ident :answer.type/math} :answer/value "-8 + 40 \\sqrt{5}" :db/id #edb/ref 17592186701099} {:answer/id #uuid "0b0ce4d1-90ce-5db7-8997-b8bd971a4bdb" :answer/type {:db/ident :answer.type/math} :answer/value "-1 + 5 \\sqrt{5}" :db/id #edb/ref 17592186701100} {:answer/id #uuid "6577e98f-c01f-5036-9610-cf43ba099268" :answer/type {:db/ident :answer.type/math} :answer/value "-3 + 3 \\sqrt{5}" :db/id #edb/ref 17592186701109} {:answer/id #uuid "a444553b-54ec-5e76-8cfe-9a028678e08c" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\sqrt{5}" :db/id #edb/ref 17592186701121} {:answer/id #uuid "ae67a166-2f28-5b07-9daa-8225ac05f162" :answer/type {:db/ident :answer.type/math} :answer/value "- 5 \\sqrt{5} - 1" :db/id #edb/ref 17592186701122}] :answer-field/correct {:answer/id #uuid "0b0ce4d1-90ce-5db7-8997-b8bd971a4bdb" :answer/type {:db/ident :answer.type/math} :answer/value "-1 + 5 \\sqrt{5}" :db/id #edb/ref 17592186701100} :answer-field/id #uuid "6b32729f-62f7-5c6a-9f09-f07262bf1480" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701111}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ebba8f89-10fd-53f6-ae01-20f0665c8bb8" :question/problem "Evaluate the line integral of $f(x,y,z)=6 y z \\cos{\\left(x \\right)}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle t,2 \\sin{\\left(t \\right)},1\\rangle,\\qquad 0\\le t\\le \\frac{\\pi}{2}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t)\\,i+(2 \\sin{\\left(t \\right)})\\,j+(1)\\,k$, then along the curve we have $x=t$, $y=2 \\sin{\\left(t \\right)}$, $z=1$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2 \\sin{\\left(t \\right)})\\,j+\\frac{\\text{d}}{\\text{d}t}(1)\\,k \\\\  & =(1)\\,i+(2 \\cos{\\left(t \\right)})\\,j+(0)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(1)^2+(2 \\cos{\\left(t \\right)})^2+(0)^2} \\\\  & =\\sqrt{4 \\cos^{2}{\\left(t \\right)} + 1}\\end{aligned}\n$$\n\nThe substitution decreases from $5$ to $1$; its differential includes the negative sign.\n\nNow, since $f(x,y,z)=6 y z \\cos{\\left(x \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(6)(2 \\sin{\\left(t \\right)})(1)\\cos(t) \\\\  & =12 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}(12 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})(\\sqrt{4 \\cos^{2}{\\left(t \\right)} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 \\cos^{2}{\\left(t \\right)} + 1$, $\\text{d}u=(- 8 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{5}^{1}- \\frac{3}{2}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =- \\frac{3}{2}\\cdot\\frac{2}{3}u^{3/2}\\big|_{5}^{1} \\\\  & =-1[(1)^{3/2}-(5)^{3/2}] \\\\  & =-1[(1)-(5 \\sqrt{5})] \\\\  & =(-1)-(- 5 \\sqrt{5}) \\\\  & =-1 + 5 \\sqrt{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68403796-d86c-5756-ad00-929997713088" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{392}{3}" :db/id #edb/ref 17592186701110} {:answer/id #uuid "84eda34b-9b85-5fa2-b2e6-4c6b33d30b5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{18}" :db/id #edb/ref 17592186701116} {:answer/id #uuid "8edd16a1-f539-5afd-b612-572481bfe3b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{8}" :db/id #edb/ref 17592186701119} {:answer/id #uuid "b496069c-ddfe-57c4-bdc7-82e9f83ea52d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{12}" :db/id #edb/ref 17592186701124} {:answer/id #uuid "e4e80ddc-b3f7-5452-a220-2aa58dacfa2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{384}" :db/id #edb/ref 17592186701128}] :answer-field/correct {:answer/id #uuid "b496069c-ddfe-57c4-bdc7-82e9f83ea52d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{12}" :db/id #edb/ref 17592186701124} :answer-field/id #uuid "e23be7fa-2880-5455-8c9c-47e6675e9a26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701127}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f47d5754-f9f9-5af1-bf49-5dbec9336f19" :question/problem "Evaluate the line integral of $f(x,y)=\\frac{x}{y}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 2 t^{2},t\\rangle,\\qquad \\frac{\\sqrt{2}}{2}\\le t\\le \\frac{\\sqrt{6}}{2}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(2 t^{2})\\,i+(t)\\,j$, then along the curve we have $x=2 t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(4 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(4 t)^2+(1)^2} \\\\  & =\\sqrt{16 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{x}{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{1(2 t^{2})}{(t)-(0)} \\\\  & =\\frac{2t^2}{t} \\\\  & =2 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{\\frac{\\sqrt{2}}{2}}^{\\frac{\\sqrt{6}}{2}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\frac{\\sqrt{2}}{2}}^{\\frac{\\sqrt{6}}{2}}(2 t)(\\sqrt{16 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=16 t^{2} + 1$, $\\text{d}u=(32 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{9}^{25}\\frac{1}{16}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{16}\\cdot\\frac{2}{3}u^{3/2}\\big|_{9}^{25} \\\\  & =\\frac{1}{24}[(25)^{3/2}-(9)^{3/2}] \\\\  & =\\frac{1}{24}[(125)-(27)] \\\\  & =\\left(\\frac{125}{24}\\right)-\\left(\\frac{9}{8}\\right) \\\\  & =\\frac{49}{12}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01009da4-370b-5ce5-8ccc-74197a1dff1a" :answer/type {:db/ident :answer.type/math} :answer/value "-15 + 30 \\sqrt{2}" :db/id #edb/ref 17592186701098} {:answer/id #uuid "1aae5798-19c4-5aaf-a6bc-46c03e97ed98" :answer/type {:db/ident :answer.type/math} :answer/value "-60 + 120 \\sqrt{2}" :db/id #edb/ref 17592186701103} {:answer/id #uuid "319c08a0-75b5-59bc-85b4-981834b86e94" :answer/type {:db/ident :answer.type/math} :answer/value "-45 + 45 \\sqrt{2}" :db/id #edb/ref 17592186701104} {:answer/id #uuid "7b89ca8b-294a-500b-a972-43919c50fac0" :answer/type {:db/ident :answer.type/math} :answer/value "30 \\sqrt{2}" :db/id #edb/ref 17592186701113} {:answer/id #uuid "7dbe161f-d8b6-52c0-aef3-1ff05ee5c560" :answer/type {:db/ident :answer.type/math} :answer/value "15 + 30 \\sqrt{2}" :db/id #edb/ref 17592186701114}] :answer-field/correct {:answer/id #uuid "01009da4-370b-5ce5-8ccc-74197a1dff1a" :answer/type {:db/ident :answer.type/math} :answer/value "-15 + 30 \\sqrt{2}" :db/id #edb/ref 17592186701098} :answer-field/id #uuid "c5280cd8-53ba-59ac-b0c8-0114bf4aec72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701126}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fa78e628-a7ee-5030-809b-cc919281c9c1" :question/problem "Evaluate the line integral of $f(x,y)=x^{3} + 3 y$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 t,t^{3}\\rangle,\\qquad 0\\le t\\le 1.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 t)\\,i+(t^{3})\\,j$, then along the curve we have $x=3 t$, $y=t^{3}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{3})\\,j \\\\  & =(3)\\,i+(3 t^{2})\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(3)^2+(3 t^{2})^2} \\\\  & =\\sqrt{9 t^{4} + 9} \\\\  & =3 \\sqrt{t^{4} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x^{3} + 3 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(3 t)^3+(3)(t^{3}) \\\\  & =27t^3+3t^3 \\\\  & =30 t^{3}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{1}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(30 t^{3})(3 \\sqrt{t^{4} + 1})\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}90 t^{3} \\sqrt{t^{4} + 1}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=t^{4} + 1$, $\\text{d}u=(4 t^{3})\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{1}^{2}\\frac{45}{2}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{45}{2}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{2} \\\\  & =15[(2)^{3/2}-(1)^{3/2}] \\\\  & =15[(2 \\sqrt{2})-(1)] \\\\  & =(30 \\sqrt{2})-(15) \\\\  & =-15 + 30 \\sqrt{2}\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating the Line Integral of a Scalar Function Using a Substitution"}]}
