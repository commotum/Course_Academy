/id #uuid "af7463aa-12d7-57ad-803b-3c850c3fe265" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y}{x}" :db/id #edb/ref 17592186163626} {:answer/id #uuid "ca72da31-eeea-56d4-973b-8125561d7056" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186163627} {:answer/id #uuid "ee2d3c03-496e-55bf-a039-5ecbd04ee38f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}" :db/id #edb/ref 17592186163628} {:answer/id #uuid "06dcb89b-43af-580e-a84a-316afd26beda" :answer/type {:db/ident :answer.type/math} :answer/value "yx^{2}" :db/id #edb/ref 17592186163629}] :answer-field/correct {:answer/id #uuid "ca72da31-eeea-56d4-973b-8125561d7056" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186163627} :answer-field/id #uuid "fff66644-0b05-5c26-a65d-0ffc27452391" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163624}] :question/id #uuid "3d859e7f-f28f-5c06-af6e-a805a7402be0" :question/math-academy-id "q-127359" :question/problem "![](images/ef/efaa81ed608cd130b1f9a6000dd50c27f8d81ed7cbd6c10570c04df1281c149d.png)\n\nFind $\\frac{dy}{dx}$ for the circle shown above." :question/worked-solution "The diagram is the circle $x^2+y^2=4$. Differentiating gives $2x+2yy'=0$, so $$\\frac{dy}{dx}=-\\frac{x}{y}$$ for $y\\ne0$."} {:db/id #edb/ref 17592186167092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdffde0b-6618-51d6-bc49-a22477f723f8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y - 1}{x + 1}" :db/id #edb/ref 17592186163631} {:answer/id #uuid "d1dfdf67-527b-511d-abee-249d1eb9a880" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x + 1}{y - 1}" :db/id #edb/ref 17592186163632} {:answer/id #uuid "27c4a1e8-5acb-5b6f-8de6-b2f50aeb90c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y - 1}{x + 1}" :db/id #edb/ref 17592186163633} {:answer/id #uuid "38683bd4-b061-5d5a-a1c0-60944a2fa2e9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x - 1}{y + 1}" :db/id #edb/ref 17592186163634} {:answer/id #uuid "38ae922f-61ca-5b33-bdae-7d7e14ba332a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x + 1}{y + 1}" :db/id #edb/ref 17592186163635}] :answer-field/correct {:answer/id #uuid "38683bd4-b061-5d5a-a1c0-60944a2fa2e9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x - 1}{y + 1}" :db/id #edb/ref 17592186163634} :answer-field/id #uuid "02b4c5ff-6289-5b8b-bb00-03fbd4292b64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163630}] :question/id #uuid "ef223789-79d4-59f3-b94f-8f0a66169b59" :question/math-academy-id "q-127360" :question/problem "![](images/a0/a09aa5c81ec7775f390901569afb0468204c49752eb401845e6836317616f25d.png)\n\nFind $\\frac{dy}{dx}$ for the circle shown above." :question/worked-solution "The diagram gives center $(1,-1)$ and radius $3$, so $(x-1)^2+(y+1)^2=9$. Differentiating gives $2(x-1)+2(y+1)y'=0$. Therefore $$\\frac{dy}{dx}=-\\frac{x-1}{y+1}$$ for $y\\ne-1$."} {:db/id #edb/ref 17592186262777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2675139a-3fa5-5b56-94e2-c392744f2058" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{y}" :db/id #edb/ref 17592186260211} {:answer/id #uuid "53dc176a-f425-5b28-938a-cb3b8dfbea9a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4x}{y}" :db/id #edb/ref 17592186260581} {:answer/id #uuid "705192e6-bac2-5c6b-acc2-b4a6d7c27a4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{x}" :db/id #edb/ref 17592186260862} {:answer/id #uuid "e9942a87-c77c-5a9d-a10f-bfd1dc59e1f5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186261919} {:answer/id #uuid "ee2aee2c-79cc-5487-8a09-2deff11502b7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186261972}] :answer-field/correct {:answer/id #uuid "e9942a87-c77c-5a9d-a10f-bfd1dc59e1f5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186261919} :answer-field/id #uuid "486a8e80-f3f5-5ea0-86c4-8514e424260b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fdc8e2a5-3885-5dd5-9725-cf793a052578" :question/math-academy-id "q-127493" :question/problem "![](images/f2/f24d078ca0dc57ebd12778b7862683b0289e9c0d4c664639bd210dcc1f7c6d1b.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at the origin and has a radius of $4,$ its equation is given by\n\n$$\n{x}^{2}+{y}^{2}={4}^{2}\\,⟹\\,{x}^{2}+{y}^{2}=16.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(16) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1baa187c-702f-5d74-9e49-a1dc869d9fa4" :answer/type {:db/ident :answer.type/math} :answer/value "(1-x)y" :db/id #edb/ref 17592186260112} {:answer/id #uuid "5a6d8273-ae12-56d9-9e8e-fcc50fc83290" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+1}{y}" :db/id #edb/ref 17592186260645} {:answer/id #uuid "74a22088-ee78-5010-84ba-740de0945199" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-x}{y}" :db/id #edb/ref 17592186260896} {:answer/id #uuid "ae28886d-9cbf-5b7c-9d76-cf9e7ca1aa9c" :answer/type {:db/ident :answer.type/math} :answer/value "-(x+1)y" :db/id #edb/ref 17592186261410} {:answer/id #uuid "e6444082-8e18-513f-a526-e008b7c933af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{y}" :db/id #edb/ref 17592186261896}] :answer-field/correct {:answer/id #uuid "74a22088-ee78-5010-84ba-740de0945199" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-x}{y}" :db/id #edb/ref 17592186260896} :answer-field/id #uuid "71d6fbea-23c2-5931-a1d8-e65fc956b604" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262313}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "270ef110-70fe-5fce-83a6-6d6bf6a5f7cf" :question/math-academy-id "q-127497" :question/problem "![](images/a3/a3ca092dc7c0668ac465d4832b91a2b831af057ff22e357b4e7105bfb454ea18.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(1,0)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-1)^{2}+(y-0)^{2}={2}^{2}\\,⟹\\,(x-1)^{2}+{y}^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x-1)^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x-1)^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2(x-1)+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2(x-1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1-x}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "086f2ce1-1368-53f8-ba86-97532f17e2be" :answer/type {:db/ident :answer.type/math} :answer/value "2(x+1)(y+1)" :db/id #edb/ref 17592186259953} {:answer/id #uuid "15624327-92e2-5e45-93c8-9e8b0f12c8a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-x}{y+1}" :db/id #edb/ref 17592186260061} {:answer/id #uuid "1b0ad15c-3fd9-513f-9213-0034cf18a310" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{1-y}" :db/id #edb/ref 17592186260109} {:answer/id #uuid "262a7584-90ba-501c-94ba-193aab3a5f57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(x+1)}{y-1}" :db/id #edb/ref 17592186260210} {:answer/id #uuid "56f957aa-f127-5fa0-8b32-8a16dec1aaac" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)(1-y)" :db/id #edb/ref 17592186260618}] :answer-field/correct {:answer/id #uuid "1b0ad15c-3fd9-513f-9213-0034cf18a310" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{1-y}" :db/id #edb/ref 17592186260109} :answer-field/id #uuid "d01c7489-9aff-5d6d-85e8-5b918e133134" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262489}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d49ad33a-9c4d-534a-b2d2-deca2d37a9d8" :question/math-academy-id "q-127499" :question/problem "![](images/2f/2f08e0a0d1fd855f2d179ac65dbdf5d022f3488b85c78b5cbb507f12bd69487e.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(-1,1)$ and has a radius of $1,$ its equation is given by\n\n$$\n(x-(-1))^{2}+(y-1)^{2}={1}^{2}\\,⟹\\,(x+1)^{2}+(y-1)^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+1)^{2}+(y-1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+1)^{2})+\\frac{\\text{d}}{\\text{d}x}((y-1)^{2}) & =0 \\\\ 2(x+1)+2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =-2(x+1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{y-1} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{x+1}{1-y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbff705-86d7-5620-9b91-f217fc3dd62f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+2}{x+3}" :db/id #edb/ref 17592186259995} {:answer/id #uuid "1404812d-8afd-556d-a934-1872662ba5ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+3}{y+2}" :db/id #edb/ref 17592186260050} {:answer/id #uuid "2cae2188-2835-52aa-8873-60409aaec2d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(x-3)}{y-2}" :db/id #edb/ref 17592186260276} {:answer/id #uuid "7b7c9e2c-eda0-5eef-8879-0d607c2ec01a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+2}{x-3}" :db/id #edb/ref 17592186260952} {:answer/id #uuid "86c7e6c8-e96b-5be4-8744-21b6d321d35e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2(y+2)}{x+3}" :db/id #edb/ref 17592186261050}] :answer-field/correct {:answer/id #uuid "1404812d-8afd-556d-a934-1872662ba5ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+3}{y+2}" :db/id #edb/ref 17592186260050} :answer-field/id #uuid "88ab4b98-7df7-574e-9078-9c3fc81e2000" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262363}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8fba4c03-ae99-5394-bb2d-645b07038e02" :question/math-academy-id "q-127500" :question/problem "![](images/78/78ad1a6835bb71441f77a3ca2bbdc93a42635e0386cda35fbe5fc9b0c9f48677.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(-3,-2)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-(-3))^{2}+(y-(-2))^{2}={2}^{2}\\,⟹\\,(x+3)^{2}+(y+2)^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+3)^{2}+(y+2)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+3)^{2})+\\frac{\\text{d}}{\\text{d}x}((y+2)^{2}) & =0 \\\\ 2(x+3)+2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =-2(x+3) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+3}{y+2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12fcdc1d-9e23-5008-bf5d-34dc22fc186c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{x+2}" :db/id #edb/ref 17592186260042} {:answer/id #uuid "22b7ceba-bd0d-5cf4-99c5-b69358079cd6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y+2}{x}" :db/id #edb/ref 17592186260179} {:answer/id #uuid "41bc10c8-5d61-5860-b083-a238754518aa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+2}{3y}" :db/id #edb/ref 17592186260450} {:answer/id #uuid "79ec63bb-645a-50e8-b0a6-bd5548a8649a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y+2}" :db/id #edb/ref 17592186260940} {:answer/id #uuid "97f828a2-e540-5264-bff8-1e86698e24a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{y+2}" :db/id #edb/ref 17592186261194}] :answer-field/correct {:answer/id #uuid "79ec63bb-645a-50e8-b0a6-bd5548a8649a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y+2}" :db/id #edb/ref 17592186260940} :answer-field/id #uuid "8a9b4da9-c684-5fbe-a09a-8174d70bd535" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262368}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "49f66e90-d770-50de-8b81-b5c4a9d9e022" :question/math-academy-id "q-127502" :question/problem "![](images/81/812f88e913650b7924fc13acc7adde999819d0011fa547a7e0ad73cb37e3939f.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(0,-2)$ and has a radius of $3,$ its equation is given by\n\n$$\n(x-0)^{2}+(y-(-2))^{2}={3}^{2}\\,⟹\\,{x}^{2}+(y+2)^{2}=9.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+(y+2)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(9) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}((y+2)^{2}) & =0 \\\\ 2x+2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y+2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7532c1eb-1150-5b3d-abb1-342bec35e705" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186517710}] :answer-field/correct {:answer/id #uuid "7532c1eb-1150-5b3d-abb1-342bec35e705" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186517710} :answer-field/id #uuid "87ca15d6-48a6-50a1-9d31-763d81685807" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518034}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0343bcd3-e974-592d-9f5b-2241e197ca26" :question/math-academy-id "q-131253" :question/problem "Given that the point $(2,\\sqrt{5})$ lies on the graph of $y={f}^{′}(x),$ find ${f}^{″}(2).$\n\n${f}^{″}(2)\\,=\\,$ {{field-1}}" :question/worked-solution "Recall that \n\n$$\n{f}^{″}(x)=\\frac{\\text{d}}{\\text{d}x}({f}^{′}(x))\n$$\n\nis the slope of the tangent line to the graph of $y={f}^{′}(x).$ \n\nNotice that the graph of $y={f}^{′}(x)$ on $x\\in [-3,3]$ is a semicircle of a radius $3$ centered at $(0,0).$ Its equation (for $y>0$) is given by\n\n$$\n(x-0)^{2}+(y-0)^{2}={3}^{2}\\,⟹\\,{x}^{2}+{y}^{2}=9.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(9) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{f}^{″}(2) & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(2,\\,\\sqrt{5})} \\\\  & =-\\frac{2}{\\sqrt{5}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101bc44b-ae63-5792-a272-b928410c2e03" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{2y}" :db/id #edb/ref 17592186545116} {:answer/id #uuid "46ee26ff-f58f-5032-b7db-ac117f845487" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2x}{y}" :db/id #edb/ref 17592186545130} {:answer/id #uuid "5dffa1dd-a4d5-5af7-920b-9642c3173a01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}" :db/id #edb/ref 17592186545138} {:answer/id #uuid "ab4529a6-2047-5774-a2c8-a00d35e21602" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186545158} {:answer/id #uuid "dba2bb78-136a-54a8-971a-c8bf7500191a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y}{x}" :db/id #edb/ref 17592186545173}] :answer-field/correct {:answer/id #uuid "ab4529a6-2047-5774-a2c8-a00d35e21602" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186545158} :answer-field/id #uuid "b87ecf42-e1b6-5f2d-940c-a6c537ae74ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545164}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0075b464-322a-5f3d-9f7e-e9a5a8363cca" :question/problem "![](images/e3/e3da6e664f55c8abb41ff05e3f7e7108ab1f7c648e887402885347eccd42ed46.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at the origin and has a radius of $3,$ its equation is given by\n\n$$\n{x}^{2}+{y}^{2}={3}^{2}\\,⟹\\,{x}^{2}+{y}^{2}=9.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(9) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a3fc09a-efc9-5c4c-ac65-bd75198800e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545131} {:answer/id #uuid "7db5b616-54c4-5818-91bd-8636dfe89f9f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2(x+\\frac{7}{2})}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545143} {:answer/id #uuid "8677d2a0-5832-5a14-aa54-22f821cce209" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545148} {:answer/id #uuid "a92aeace-c06b-57c2-b93a-99dd15e0cb20" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{2(y+\\frac{1}{2})}" :db/id #edb/ref 17592186545156} {:answer/id #uuid "bbb38e3c-a97d-5d21-b693-c4de60dd22b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y+\\frac{1}{2}}{x+\\frac{7}{2}}" :db/id #edb/ref 17592186545165}] :answer-field/correct {:answer/id #uuid "8677d2a0-5832-5a14-aa54-22f821cce209" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545148} :answer-field/id #uuid "c3406e35-cfa3-57be-b127-de08e9b94e52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545167}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4baaba62-d9ac-5b3e-89d5-fbd516aa665c" :question/problem "![](images/d4/d4ca74438b4c5e5eeae2ce46d7a86964d74adfb1e12df6029a41a04c0dea7e93.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(- \\frac{7}{2},- \\frac{1}{2})$ and has a radius of $\\frac{3}{2},$ its equation is given by\n\n$$\n(x-\\left(- \\frac{7}{2}\\right))^{2}+(y-\\left(- \\frac{1}{2}\\right))^{2}={\\frac{3}{2}}^{2}\\,⟹\\,(x+\\frac{7}{2})^{2}+(y+\\frac{1}{2})^{2}=\\frac{9}{4}.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+\\frac{7}{2})^{2}+(y+\\frac{1}{2})^{2}) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{9}{4}\\right) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+\\frac{7}{2})^{2})+\\frac{\\text{d}}{\\text{d}x}((y+\\frac{1}{2})^{2}) & =0 \\\\ 2(x+\\frac{7}{2})+2(y+\\frac{1}{2})\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+\\frac{1}{2})\\frac{\\text{d}y}{\\text{d}x} & =-2(x+\\frac{7}{2}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cc9736-1ad6-592a-aebb-e6c16d0d50e0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y-\\frac{1}{2}}" :db/id #edb/ref 17592186545113} {:answer/id #uuid "1c75beaa-b238-5161-9628-8a764302e2cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+\\frac{7}{2}}{y-\\frac{1}{2}}" :db/id #edb/ref 17592186545117} {:answer/id #uuid "236ef634-16e5-560d-8f85-33280287b1dd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2(x+\\frac{7}{2})}{y-\\frac{1}{2}}" :db/id #edb/ref 17592186545120} {:answer/id #uuid "6c3d80d9-4059-5ed3-acb0-dc16dbea0388" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y-\\frac{1}{2}}{x+\\frac{7}{2}}" :db/i