frac{y+\\frac{3}{2}}{x+\\frac{7}{2}}" :db/id #edb/ref 17592186545128} {:answer/id #uuid "956a17cd-d604-5800-ba68-8c52c52b2d35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{2(y+\\frac{3}{2})}" :db/id #edb/ref 17592186545150} {:answer/id #uuid "a1cba8f8-c370-5d2d-bf85-e6448daf4ab1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+\\frac{7}{2}}{y+\\frac{3}{2}}" :db/id #edb/ref 17592186545155} {:answer/id #uuid "ab29b439-c053-5ab4-b58f-3a6dcca32183" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2(x+\\frac{7}{2})}{y+\\frac{3}{2}}" :db/id #edb/ref 17592186545157}] :answer-field/correct {:answer/id #uuid "085d5f70-a758-5ee6-a237-cd70c5daefa9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y+\\frac{3}{2}}" :db/id #edb/ref 17592186545114} :answer-field/id #uuid "516481b8-d8c8-58ca-bc4f-15b8b0a2b0f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545133}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e666840a-1052-52e3-badf-2168db98672a" :question/problem "![](images/02/025ef38d69954bfcc7f2a463a97239e442c446803ede7fee6ee172b30a356cbd.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(- \\frac{7}{2},- \\frac{3}{2})$ and has a radius of $\\frac{3}{2},$ its equation is given by\n\n$$\n(x-\\left(- \\frac{7}{2}\\right))^{2}+(y-\\left(- \\frac{3}{2}\\right))^{2}={\\frac{3}{2}}^{2}\\,⟹\\,(x+\\frac{7}{2})^{2}+(y+\\frac{3}{2})^{2}=\\frac{9}{4}.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+\\frac{7}{2})^{2}+(y+\\frac{3}{2})^{2}) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{9}{4}\\right) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+\\frac{7}{2})^{2})+\\frac{\\text{d}}{\\text{d}x}((y+\\frac{3}{2})^{2}) & =0 \\\\ 2(x+\\frac{7}{2})+2(y+\\frac{3}{2})\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+\\frac{3}{2})\\frac{\\text{d}y}{\\text{d}x} & =-2(x+\\frac{7}{2}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+\\frac{7}{2}}{y+\\frac{3}{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57dd2e5d-962b-5dfb-98f4-97d92de3fc02" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y-1}{x-2}" :db/id #edb/ref 17592186545135} {:answer/id #uuid "7894a990-fc5d-5b5f-9059-92d296bcae3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{y-1}" :db/id #edb/ref 17592186545142} {:answer/id #uuid "89f8a526-8bd0-5214-bc9f-92a258707346" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2(x-2)}{y-1}" :db/id #edb/ref 17592186545149} {:answer/id #uuid "a174af3f-d1c8-5045-be9a-3c1d1b00481d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x-2}{2(y-1)}" :db/id #edb/ref 17592186545154} {:answer/id #uuid "cb28ad6d-076e-5fca-8e60-91e19f6bc049" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x-2}{y-1}" :db/id #edb/ref 17592186545171}] :answer-field/correct {:answer/id #uuid "cb28ad6d-076e-5fca-8e60-91e19f6bc049" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x-2}{y-1}" :db/id #edb/ref 17592186545171} :answer-field/id #uuid "b0263139-c8c5-505f-b0e2-da3711351949" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545159}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ea2b8a3b-1dae-50d7-a5d0-e8c0492ad83d" :question/problem "![](images/38/38bd557f03e547ee2634d361fe1768cf8b2089a51230c2795e17036676b50bcd.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(2,1)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-2)^{2}+(y-1)^{2}={2}^{2}\\,⟹\\,(x-2)^{2}+(y-1)^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x-2)^{2}+(y-1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x-2)^{2})+\\frac{\\text{d}}{\\text{d}x}((y-1)^{2}) & =0 \\\\ 2(x-2)+2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =-2(x-2) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x-2}{y-1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186634698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255a52bb-b812-5f05-9411-5e76274b2699" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}\\,x}{y}" :db/id #edb/ref 17592186633892} {:answer/id #uuid "2ac2a52c-a255-5b6b-bda1-4f88981196d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{\\sqrt{2}\\,y}" :db/id #edb/ref 17592186633901} {:answer/id #uuid "2cb72191-ac65-5af5-ab29-6c74e0267130" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186633905} {:answer/id #uuid "54d8857d-602a-537b-8dc5-6315d5227105" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,xy" :db/id #edb/ref 17592186634008} {:answer/id #uuid "794c9a1f-3f01-5187-ba43-1694382e7f33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\,y}{x}" :db/id #edb/ref 17592186634100}] :answer-field/correct {:answer/id #uuid "2cb72191-ac65-5af5-ab29-6c74e0267130" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186633905} :answer-field/id #uuid "9988140a-b955-50b0-b554-f2aba9a1c95e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186634501}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f9f25f72-9abc-5b8c-b8e6-779c898cd083" :question/math-academy-id "q-127495" :question/problem "![](images/22/2261b100b72c98a99e76b33ee070dd8fe0dfecb030551d98e216b8ba85f7f0d0.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at the origin and has a radius of $2\\sqrt{2},$ its equation is given by\n\n$$\n{x}^{2}+{y}^{2}=(2\\sqrt{2})^{2}\\,⟹\\,{x}^{2}+{y}^{2}=8.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(8) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Slope of the Tangent to a Circle"}]}
