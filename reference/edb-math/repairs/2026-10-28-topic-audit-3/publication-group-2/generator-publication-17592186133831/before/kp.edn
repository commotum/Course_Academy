\\right)})j \\\\  & =(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((3 t \\sin{\\left(t \\right)} - 3 t \\cos{\\left(t \\right)})\\,i+(- 4 t \\sin{\\left(t \\right)} - t \\cos{\\left(t \\right)})\\,j)\\cdot ((- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j) \\\\  & =(3 t \\sin{\\left(t \\right)} - 3 t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- 4 t \\sin{\\left(t \\right)} - t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =(- 3 t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})+(- 4 t \\sin{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =- 3 t^{2} \\sin^{2}{\\left(t \\right)} - t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - t^{2} \\cos^{2}{\\left(t \\right)} - 4 t \\sin^{2}{\\left(t \\right)} + 2 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 t \\cos^{2}{\\left(t \\right)} \\\\  & =t^{2} \\left(- 3 \\sin^{2}{\\left(t \\right)} - \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 4 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos^{2}{\\left(t \\right)}\\right).\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{\\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{\\pi}{3}}(t^{2} \\left(- 3 \\sin^{2}{\\left(t \\right)} - \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 4 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos^{2}{\\left(t \\right)}\\right))\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d10bd8a-7e2d-5f7b-bfe7-2e0ae92a80cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(t e^{2 t} + 4)\\,dt" :db/id #edb/ref 17592186560138} {:answer/id #uuid "700dd878-159e-5841-92ce-18dd055b193b" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- 8 \\sqrt{t} - t e^{t})\\,dt" :db/id #edb/ref 17592186560165} {:answer/id #uuid "aff49623-520d-5050-8c10-3f273f7a0cd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- t e^{2 t})\\,dt" :db/id #edb/ref 17592186560192} {:answer/id #uuid "e5dda080-6f9e-5996-b6a9-a5b1df511468" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(-4)\\,dt" :db/id #edb/ref 17592186560211} {:answer/id #uuid "f85ad87c-05c3-5572-b780-a25b41e3926b" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- t e^{2 t} - 4)\\,dt" :db/id #edb/ref 17592186560216}] :answer-field/correct {:answer/id #uuid "f85ad87c-05c3-5572-b780-a25b41e3926b" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- t e^{2 t} - 4)\\,dt" :db/id #edb/ref 17592186560216} :answer-field/id #uuid "7533086f-6308-548a-9bbb-fda3d2b21e22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560167}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7890e094-fef5-567c-b6e4-965fdc5b93aa" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(- x y^{2})\\,i+(- 8 y)\\,j$ and $C$ is the path $r(t)=(e^{t})\\,i+(\\sqrt{t})\\,j$ for $t\\in [1,2]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=e^{t},\\,y=\\sqrt{t}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(- x y^{2})\\,i+(- 8 y)\\,j \\\\  & =(- (e^{t}) (\\sqrt{t})^{2})\\,i+(- 8 (\\sqrt{t}))\\,j \\\\  & =(- t e^{t})\\,i+(- 8 \\sqrt{t})\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(e^{t})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sqrt{t})j \\\\  & =(e^{t})\\,i+\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((- t e^{t})\\,i+(- 8 \\sqrt{t})\\,j)\\cdot ((e^{t})\\,i+\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\,j) \\\\  & =(- t e^{t})\\cdot (e^{t})+(- 8 \\sqrt{t})\\cdot \\left(\\frac{1}{2 \\sqrt{t}}\\right) \\\\  & =- t e^{2 t} - 4.\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{1}^{2}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{1}^{2}(- t e^{2 t} - 4)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "273cd694-c19e-5b18-bfec-cd5c57ed5ff9" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(3 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} - 4 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560141} {:answer/id #uuid "5f3569f5-5b13-550e-b642-5dbf5fb3d1aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560157} {:answer/id #uuid "911efb5e-f235-5990-a6fc-07cbd8ec0ca4" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(4 t \\sin{\\left(t \\right)} - 3 t \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560179} {:answer/id #uuid "af514606-1011-5fd0-bd9f-45e394507101" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(- t^{2} \\sin^{2}{\\left(t \\right)} - t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\cos^{2}{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560191} {:answer/id #uuid "c4d8fee3-1213-5bfd-833d-9686d66f6093" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(- t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) - t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560201}] :answer-field/correct {:answer/id #uuid "5f3569f5-5b13-550e-b642-5dbf5fb3d1aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560157} :answer-field/id #uuid "1d0434ee-bf15-5472-a32b-f36428ff5196" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560137}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "86e837bb-1b72-587e-9545-9d268702c40b" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(x + y)\\,i+(- 4 x + 3 y)\\,j$ and $C$ is the path $r(t)=(t \\cos{\\left(t \\right)})\\,i+(t \\sin{\\left(t \\right)})\\,j$ for $t\\in [0,\\frac{2 \\pi}{3}]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t \\cos{\\left(t \\right)},\\,y=t \\sin{\\left(t \\right)}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(x + y)\\,i+(- 4 x + 3 y)\\,j \\\\  & =((t \\cos{\\left(t \\right)}) + (t \\sin{\\left(t \\right)}))\\,i+(- 4 (t \\cos{\\left(t \\right)}) + 3 (t \\sin{\\left(t \\right)}))\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\cos{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\sin{\\left(t \\right)})j \\\\  & =(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\,i+(3 t \\sin{\\left(t \\right)} - 4 t \\cos{\\left(t \\right)})\\,j)\\cdot ((- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j) \\\\  & =(t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)} - 4 t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =(t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(t \\sin{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- 4 t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =- t^{2} \\sin^{2}{\\left(t \\right)} + 2 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} - 3 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\cos^{2}{\\left(t \\right)} \\\\  & =t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right).\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{2 \\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{2 \\pi}{3}}(t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295d16d2-e3b6-597b-a791-b8fe852304a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{3}(- 6 t^{10} + 4 t^{9})\\,dt" :db/id #edb/ref 17592186560143} {:answer/id #uuid "43298b2f-a5cb-51bb-8e7f-ddecb647f96c" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{3}(- 2 t^{8} + t^{6})\\,dt" :db/id #edb/ref 17592186560150} {:answer/id #uuid "94c19294-6ae0-5fdf-a20d-8fc5bc603c38" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{3}(4 t^{9})\\,dt" :db/id #edb/ref 17592186560182} {:answer/id #uuid "a4a312d3-e2bd-5f23-ba35-9a8686202a02" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{3}(- 6 t^{10})\\,dt" :db/id #edb/ref 17592186560186} {:answer/id #uuid "bd37e432-bd27-565b-b9cc-b5aa98ebba43" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{3}(6 t^{10} - 4 t^{9})\\,dt" :db/id #edb/ref 17592186560197}] :answer-field/correct {:answer/id #uuid "295d16d2-e3b6-597b-a791-b8fe852304a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{3}(- 6 t^{10} + 4 t^{9})\\,dt" :db/id #edb/ref 17592186560143} :answer-field/id #uuid "8b962474-051d-5e8f-89ea-e43cb8505627" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560178}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "87294308-b491-50e6-ba20-a861e9b21c1a" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(y^{2})\\,i+(- 2 x^{2})\\,j$ and $C$ is the path $r(t)=(t^{4})\\,i+(t^{3})\\,j$ for $t\\in [0,3]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t^{4},\\,y=t^{3}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(y^{2})\\,i+(- 2 x^{2})\\,j \\\\  & =((t^{3})^{2})\\,i+(- 2 (t^{4})^{2})\\,j \\\\  & =(t^{6})\\,i+(- 2 t^{8})\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{4})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{3})j \\\\  & =(4 t^{3})\\,i+(3 t^{2})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((t^{6})\\,i+(- 2 t^{8})\\,j)\\cdot ((4 t^{3})\\,i+(3 t^{2})\\,j) \\\\  & =(t^{6})\\cdot (4 t^{3})+(- 2 t^{8})\\cdot (3 t^{2}) \\\\  & =- 6 t^{10} + 4 t^{9}.\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{3}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{3}(- 6 t^{10} + 4 t^{9})\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e2473a-7ecd-5c81-b672-db12be2f9d23" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(- \\cos^{2}{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560132} {:answer/id #uuid "66224a06-98ab-5fad-b9b5-5d4a40da649c" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(\\sin{\\left(t \\right)} - \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560161} {:answer/id #uuid "c4a93688-3a3e-5787-853b-25cb35330f67" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(- \\sin^{2}{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560200} {:answer/id #uuid "e43cfe1d-16f3-5772-8982-d15cb951335f" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(1)\\,dt" :db/id #edb/ref 17592186560210} {:answer/id #uuid "f10312fc-2eaf-5fdd-902f-4104757887fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(-1)\\,dt" :db/id #edb/ref 17592186560214}] :answer-field/correct {:answer/id #uuid "f10312fc-2eaf-5fdd-902f-4104757887fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(-1)\\,dt" :db/id #edb/ref 17592186560214} :answer-field/id #uuid "69a19aea-9cac-5ffe-bb63-04acf1a5bd19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560164}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9cad2e1c-3fd7-5abc-a45f-1ba0aa4a145f" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(y)\\,i+(- x)\\,j$ and $C$ is the path $r(t)=(\\cos{\\left(t \\right)})\\,i+(\\sin{\\left(t \\right)})\\,j$ for $t\\in [0,\\frac{2 \\pi}{3}]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=\\cos{\\left(t \\right)},\\,y=\\sin{\\left(t \\right)}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(y)\\,i+(- x)\\,j \\\\  & =((\\sin{\\left(t \\right)}))\\,i+(- (\\cos{\\left(t \\right)}))\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\cos{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sin{\\left(t \\right)})j \\\\  & =(- \\sin{\\left(t \\right)})\\,i+(\\cos{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((\\sin{\\left(t \\right)})\\,i+(- \\cos{\\left(t \\right)})\\,j)\\cdot ((- \\sin{\\left(t \\right)})\\,i+(\\cos{\\left(t \\right)})\\,j) \\\\  & =(\\sin{\\left(t \\right)})\\cdot (- \\sin{\\left(t \\right)})+(- \\cos{\\left(t \\right)})\\cdot (\\cos{\\left(t \\right)}) \\\\  & =-1.\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{2 \\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{2 \\pi}{3}}(-1)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347604a6-fc29-5235-a40e-c4b974503a53" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{2}(- 2 t^{7} + 12 t^{6})\\,dt" :db/id #edb/ref 17592186560147} {:answer/id #uuid "692110f8-3f18-56d8-9db5-0decd985e753" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{2}(- 2 t^{7})\\,dt" :db/id #edb/ref 17592186560163} {:answer/id #uuid "82ea29ed-ba48-5255-b7d8-4759e8f3c4ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{2}(12 t^{6})\\,dt" :db/id #edb/ref 17592186560174} {:answer/id #uuid "b2e6ca92-0fd1-53cd-8e65-d7e4fa20bfa4" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{2}(- t^{6} + 4 t^{4})\\,dt" :db/id #edb/ref 17592186560193} {:answer/id #uuid "d6dc348d-d61f-5310-b464-54dc51822d33" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{2}(2 t^{7} - 12 t^{6})\\,dt" :db/id #edb/ref 17592186560206}] :answer-field/correct {:answer/id #uuid "347604a6-fc29-5235-a40e-c4b974503a53" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{2}(- 2 t^{7} + 12 t^{6})\\,dt" :db/id #edb/ref 17592186560147} :answer-field/id #uuid "ddd4e2de-caba-5381-9532-6515c5b57a7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560209}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b8acbc35-3fad-5a85-bfc1-6bd439a2af48" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(- y^{2})\\,i+(4 x^{2})\\,j$ and $C$ is the path $r(t)=(t^{2})\\,i+(t^{3})\\,j$ for $t\\in [0,2]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t^{2},\\,y=t^{3}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(- y^{2})\\,i+(4 x^{2})\\,j \\\\  & =(- (t^{3})^{2})\\,i+(4 (t^{2})^{2})\\,j \\\\  & =(- t^{6})\\,i+(4 t^{4})\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{3})j \\\\  & =(2 t)\\,i+(3 t^{2})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((- t^{6})\\,i+(4 t^{4})\\,j)\\cdot ((2 t)\\,i+(3 t^{2})\\,j) \\\\  & =(- t^{6})\\cdot (2 t)+(4 t^{4})\\cdot (3 t^{2}) \\\\  & =- 2 t^{7} + 12 t^{6}.\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{2}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{2}(- 2 t^{7} + 12 t^{6})\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68628931-5917-506d-9dff-cd9f8bbc7b9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{4 \\pi}{3}}(- 2 t^{2} \\sin^{2}{\\left(t \\right)} - t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\cos^{2}{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560162} {:answer/id #uuid "77c5a4f2-31fb-5985-a30d-d68bcda53ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{4 \\pi}{3}}(t^{2} \\left(- 2 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560169} {:answer/id #uuid "c6e171d8-646b-54e3-b47b-b2bf53c0c924" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{4 \\pi}{3}}(3 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} + t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560203} {:answer/id #uuid "efb092da-cb53-5fb2-878f-d365f984296f" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{4 \\pi}{3}}(5 t \\sin{\\left(t \\right)} + 2 t \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560212} {:answer/id #uuid "fbbcde59-6af9-54b2-8c4d-996bd8287034" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{4 \\pi}{3}}(- t^{2} \\left(- 2 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) - t \\left(3 \\sin^{2}{\\left(t \\right)} + 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560218}] :answer-field/correct {:answer/id #uuid "77c5a4f2-31fb-5985-a30d-d68bcda53ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{4 \\pi}{3}}(t^{2} \\left(- 2 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560169} :answer-field/id #uuid "db671629-2024-5c4e-95bd-d304c4e96f05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560208}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c300e91f-d29b-52cd-bc77-53bb950d5cac" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(x + 2 y)\\,i+(x + 3 y)\\,j$ and $C$ is the path $r(t)=(t \\cos{\\left(t \\right)})\\,i+(t \\sin{\\left(t \\right)})\\,j$ for $t\\in [0,\\frac{4 \\pi}{3}]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t \\cos{\\left(t \\right)},\\,y=t \\sin{\\left(t \\right)}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(x + 2 y)\\,i+(x + 3 y)\\,j \\\\  & =((t \\cos{\\left(t \\right)}) + 2 (t \\sin{\\left(t \\right)}))\\,i+((t \\cos{\\left(t \\right)}) + 3 (t \\sin{\\left(t \\right)}))\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\cos{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\sin{\\left(t \\right)})j \\\\  & =(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((2 t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\,i+(3 t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\,j)\\cdot ((- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j) \\\\  & =(2 t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =(t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(2 t \\sin{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =- 2 t^{2} \\sin^{2}{\\left(t \\right)} + 2 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} + 3 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\cos^{2}{\\left(t \\right)} \\\\  & =t^{2} \\left(- 2 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right).\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{4 \\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{4 \\pi}{3}}(t^{2} \\left(- 2 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dbb8114-0022-545b-b749-b3e641678284" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{3}(t e^{2 t} + 1)\\,dt" :db/id #edb/ref 17592186560149} {:answer/id #uuid "5243f7e4-74ef-5df2-9100-845d622c7a72" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{3}(- t e^{2 t} - 1)\\,dt" :db/id #edb/ref 17592186560153} {:answer/id #uuid "abe385ed-8d08-52ec-ae91-225fba4548b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{3}(2 \\sqrt{t} + t e^{t})\\,dt" :db/id #edb/ref 17592186560190} {:answer/id #uuid "ba644c3a-40bf-59f7-9a07-a986b9585af7" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{3}(1)\\,dt" :db/id #edb/ref 17592186560196} {:answer/id #uuid "cdca2a95-175e-5c86-b898-ea1220da8ae5" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{3}(t e^{2 t})\\,dt" :db/id #edb/ref 17592186560204}] :answer-field/correct {:answer/id #uuid "3dbb8114-0022-545b-b749-b3e641678284" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{1}^{3}(t e^{2 t} + 1)\\,dt" :db/id #edb/ref 17592186560149} :answer-field/id #uuid "b9f3daab-6a8a-5ae4-ada6-b16d6d099a72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560195}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f547fa50-e9ed-52ea-ac31-f84758ccc7ba" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(x y^{2})\\,i+(2 y)\\,j$ and $C$ is the path $r(t)=(e^{t})\\,i+(\\sqrt{t})\\,j$ for $t\\in [1,3]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=e^{t},\\,y=\\sqrt{t}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(x y^{2})\\,i+(2 y)\\,j \\\\  & =((e^{t}) (\\sqrt{t})^{2})\\,i+(2 (\\sqrt{t}))\\,j \\\\  & =(t e^{t})\\,i+(2 \\sqrt{t})\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(e^{t})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sqrt{t})j \\\\  & =(e^{t})\\,i+\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((t e^{t})\\,i+(2 \\sqrt{t})\\,j)\\cdot ((e^{t})\\,i+\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\,j) \\\\  & =(t e^{t})\\cdot (e^{t})+(2 \\sqrt{t})\\cdot \\left(\\frac{1}{2 \\sqrt{t}}\\right) \\\\  & =t e^{2 t} + 1.\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{1}^{3}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{1}^{3}(t e^{2 t} + 1)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17e89266-d4a1-5535-be58-9db6669fae57" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(- 4 t^{2} \\sin^{2}{\\left(t \\right)} + 2 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 4 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 2 t \\cos^{2}{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560134} {:answer/id #uuid "5979a1a7-83d7-5674-a4d7-e6cb418720b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(7 t \\sin{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560154} {:answer/id #uuid "6015e95f-cad5-5129-8008-f13592f1a067" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(3 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} + 2 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560158} {:answer/id #uuid "62ab536d-0865-50cf-acb0-d3db8534033d" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(- t^{2} \\left(- 4 \\sin^{2}{\\left(t \\right)} + 5 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 \\cos^{2}{\\left(t \\right)}\\right) - t \\left(3 \\sin^{2}{\\left(t \\right)} + 6 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 2 \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560159} {:answer/id #uuid "91227625-325d-5a82-a06d-d544ad1a411c" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(t^{2} \\left(- 4 \\sin^{2}{\\left(t \\right)} + 5 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 6 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 2 \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560180}] :answer-field/correct {:answer/id #uuid "91227625-325d-5a82-a06d-d544ad1a411c" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(t^{2} \\left(- 4 \\sin^{2}{\\left(t \\right)} + 5 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 6 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 2 \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560180} :answer-field/id #uuid "28b7a085-84f4-5355-b06f-113513cbca6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560142}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fd911363-4a99-52e5-97ea-c6a788ed91ec" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(- 2 x + 4 y)\\,i+(2 x + 3 y)\\,j$ and $C$ is the path $r(t)=(t \\cos{\\left(t \\right)})\\,i+(t \\sin{\\left(t \\right)})\\,j$ for $t\\in [0,\\frac{\\pi}{3}]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t \\cos{\\left(t \\right)},\\,y=t \\sin{\\left(t \\right)}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(- 2 x + 4 y)\\,i+(2 x + 3 y)\\,j \\\\  & =(- 2 (t \\cos{\\left(t \\right)}) + 4 (t \\sin{\\left(t \\right)}))\\,i+(2 (t \\cos{\\left(t \\right)}) + 3 (t \\sin{\\left(t \\right)}))\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\cos{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\sin{\\left(t \\right)})j \\\\  & =(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((4 t \\sin{\\left(t \\right)} - 2 t \\cos{\\left(t \\right)})\\,i+(3 t \\sin{\\left(t \\right)} + 2 t \\cos{\\left(t \\right)})\\,j)\\cdot ((- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j) \\\\  & =(4 t \\sin{\\left(t \\right)} - 2 t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)} + 2 t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =(- 2 t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(4 t \\sin{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(2 t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =- 4 t^{2} \\sin^{2}{\\left(t \\right)} + 5 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} + 6 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 2 t \\cos^{2}{\\left(t \\right)} \\\\  & =t^{2} \\left(- 4 \\sin^{2}{\\left(t \\right)} + 5 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 6 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 2 \\cos^{2}{\\left(t \\right)}\\right).\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{\\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{\\pi}{3}}(t^{2} \\left(- 4 \\sin^{2}{\\left(t \\right)} + 5 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 2 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} + 6 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 2 \\cos^{2}{\\left(t \\right)}\\right))\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186712528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164d3436-02fc-58ec-ad98-395139cc15db" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[t(\\cos t+\\sin t)(\\cos t+t\\sin t)\\\\&\\quad+t(\\cos t+2\\sin t)(\\sin t+t\\cos t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186712523} {:answer/id #uuid "19fafab9-d222-5527-ae9f-4637bedc8041" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[t(\\cos t+\\sin t)(\\sin t+t\\cos t)\\\\&\\quad+t(\\cos t+2\\sin t)(\\cos t-t\\sin t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186712524} {:answer/id #uuid "5c6f04b0-0112-5a27-be84-302fd8b79fc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[t(\\cos t+\\sin t)(\\cos t-t\\sin t)\\\\&\\quad+t(\\cos t+2\\sin t)(\\sin t-t\\cos t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186712531} {:answer/id #uuid "70fe4683-4b99-5fbb-aa6a-ac68c7760763" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[t(\\cos t+\\sin t)\\cos t\\\\&\\quad+t(\\cos t+2\\sin t)\\sin t\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186712533} {:answer/id #uuid "e1afd290-81f5-5155-8f82-f2abab13401d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[t(\\cos t+\\sin t)(\\cos t-t\\sin t)\\\\&\\quad+t(\\cos t+2\\sin t)(\\sin t+t\\cos t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186712541}] :answer-field/correct {:answer/id #uuid "e1afd290-81f5-5155-8f82-f2abab13401d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[t(\\cos t+\\sin t)(\\cos t-t\\sin t)\\\\&\\quad+t(\\cos t+2\\sin t)(\\sin t+t\\cos t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186712541} :answer-field/id #uuid "470ec447-ed81-5044-845d-e06021b3dc5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712529}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "447e6e82-3ebd-54bd-8760-5d4d27f34b99" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=(x+y)\\,i+(x+2y)\\,j$ and $C$ is the path $r(t)=t\\cos t\\,i+t\\sin t\\,j$ for $t\\in [0,1]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it." :question/worked-solution "Use\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve, $x=t\\cos t$ and $y=t\\sin t$. Substitute into both mixed field components:\n\n$$\n\\begin{aligned}F(r(t))&=(t\\cos t+t\\sin t)\\,i+(t\\cos t+2t\\sin t)\\,j\\\\&=t(\\cos t+\\sin t)\\,i+t(\\cos t+2\\sin t)\\,j.\\end{aligned}\n$$\n\nEach path component needs the product rule:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}t}(t\\cos t)&=\\cos t-t\\sin t,\\\\\\frac{\\mathrm{d}}{\\mathrm{d}t}(t\\sin t)&=\\sin t+t\\cos t.\\end{aligned}\n$$\n\nThus\n\n$$\nr^{\\prime}(t)=(\\cos t-t\\sin t)\\,i+(\\sin t+t\\cos t)\\,j.\n$$\n\nMultiply matching components. Keep the two products factored:\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t)&=t(\\cos t+\\sin t)(\\cos t-t\\sin t)\\\\&\\quad+t(\\cos t+2\\sin t)(\\sin t+t\\cos t).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int_C F\\cdot\\mathrm{d}r&=\\int_0^1\\bigl[t(\\cos t+\\sin t)(\\cos t-t\\sin t)\\\\&\\qquad+t(\\cos t+2\\sin t)(\\sin t+t\\cos t)\\bigr]\\,\\mathrm{d}t.\\end{aligned}\n$$\n\nNo antiderivative or further expansion is needed."} {:db/id #edb/ref 17592186712535 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36ce88dc-8921-5c0c-b680-14c54c03502a" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(3t^4+3t^5-2t^6)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712525} {:answer/id #uuid "43621b54-d7d6-5bd2-a416-d1de62638438" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(t^2+t^3-t^5)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712527} {:answer/id #uuid "7ecb2fc7-b596-51bf-bd7f-ab20fff642ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(2t^3+2t^4-3t^5)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712534} {:answer/id #uuid "dc2ba97d-e13b-5478-a560-7b784062a09a" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(2t^3+2t^4-3t^7)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712540} {:answer/id #uuid "e774a275-6075-5aca-ad96-976f5fbbd1ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(2t^3+2t^4+3t^7)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712543}] :answer-field/correct {:answer/id #uuid "dc2ba97d-e13b-5478-a560-7b784062a09a" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(2t^3+2t^4-3t^7)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712540} :answer-field/id #uuid "370884ca-bc2d-545d-80e1-324ac00f63f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712526}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "91647911-097b-5f0a-b4e4-6d9a03848a20" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=(x+y)\\,i-xy\\,j$ and $C$ is the path $r(t)=t^2\\,i+t^3\\,j$ for $t\\in [0,1]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it." :question/worked-solution "Use\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nSubstitute $x=t^2$ and $y=t^3$ into both components:\n\n$$\n\\begin{aligned}F(r(t))&=(t^2+t^3)\\,i-(t^2)(t^3)\\,j\\\\&=(t^2+t^3)\\,i-t^5\\,j.\\end{aligned}\n$$\n\nDifferentiate both path components:\n\n$$\nr^{\\prime}(t)=2t\\,i+3t^2\\,j.\n$$\n\nThe dot product includes both coordinate derivatives:\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t)&=(t^2+t^3)(2t)+(-t^5)(3t^2)\\\\&=2t^3+2t^4-3t^7.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_{0}^{1}(2t^3+2t^4-3t^7)\\,\\mathrm{d}t.\n$$"} {:db/id #edb/ref 17592186712539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "632c96a6-32a3-5a76-95ab-e02f54444d18" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(t^3-t^2)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712532} {:answer/id #uuid "9e0f1d5e-7117-5535-9792-1aa315d5d811" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(t^6+3t^4)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712536} {:answer/id #uuid "be4039f4-30bd-5b08-931c-561ad99bd8bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(t^6-3t^2)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712537} {:answer/id #uuid "c40c51b1-4594-59d6-abd1-bd585bbc7cf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(t^6-t^2)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712538} {:answer/id #uuid "e5023fa3-64bb-5161-9c6c-58f1cb85418d" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(t^6-3t^4)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712542}] :answer-field/correct {:answer/id #uuid "e5023fa3-64bb-5161-9c6c-58f1cb85418d" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{1}(t^6-3t^4)\\,\\mathrm{d}t" :db/id #edb/ref 17592186712542} :answer-field/id #uuid "521a2c38-a20a-52ca-af45-a740ef754d3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712530}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c82d9dd3-6e0b-5343-9d08-6711b97e50be" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=y^2\\,i-x^2\\,j$ and $C$ is the path $r(t)=t\\,i+t^3\\,j$ for $t\\in [0,1]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it.\n\n*Hint: $r^{\\prime}(t)=i+3t^2\\,j$. Substitute the coordinates into the field, then take the dot product.*" :question/worked-solution "For a vector field, use\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve, $x=t$ and $y=t^3$, so\n\n$$\nF(r(t))=(t^3)^2\\,i-t^2\\,j=t^6\\,i-t^2\\,j.\n$$\n\nDifferentiating the path gives\n\n$$\nr^{\\prime}(t)=\\frac{\\mathrm{d}t}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}(t^3)}{\\mathrm{d}t}\\,j=i+3t^2\\,j.\n$$\n\nMultiply corresponding components and add:\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t)&=t^6(1)+(-t^2)(3t^2)\\\\&=t^6-3t^4.\\end{aligned}\n$$\n\nKeep the supplied parameter limits:\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_{0}^{1}(t^6-3t^4)\\,\\mathrm{d}t.\n$$"} {:db/id #edb/ref 17592186713036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fae0589-765b-55b3-9c10-bb3cedb753cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(\\cos{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- \\sin{\\left(t \\right)})(\\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713029} {:answer/id #uuid "7a1c1aa7-6c43-5b01-8a98-f7b440d6fdf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(\\cos{\\left(t \\right)})(1)\\\\&\\quad+(- \\cos{\\left(t \\right)})(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713045} {:answer/id #uuid "941fa5bb-790c-5f9a-bde7-020ac9f8913c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(\\cos{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- \\sin{\\left(t \\right)})(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713050} {:answer/id #uuid "9fce81d0-4b87-5c61-8823-ae1b222096aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(\\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- \\cos{\\left(t \\right)})(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713052} {:answer/id #uuid "abdef346-5072-5680-b0d0-0abd3f111b40" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(\\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- \\cos{\\left(t \\right)})(\\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713054}] :answer-field/correct {:answer/id #uuid "941fa5bb-790c-5f9a-bde7-020ac9f8913c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(\\cos{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- \\sin{\\left(t \\right)})(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713050} :answer-field/id #uuid "4d1aeb31-c2a8-567a-8be7-35087de69cd0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713038}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "45dd7645-0290-5b22-93f8-95c9724e8a5f" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=(y)\\,i+(- x)\\,j$ and $C$ is the path $r(t)=(\\sin{\\left(t \\right)})\\,i+(\\cos{\\left(t \\right)})\\,j$ for $t\\in [0,2]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it.\n\n*Hint: $r^{\\prime}(t)=(\\cos{\\left(t \\right)})\\,i+(- \\sin{\\left(t \\right)})\\,j$. Substitute both coordinates into the field, then take the dot product.*" :question/worked-solution "Use the vector line-integral formula:\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nSubstitute the coordinates $x=\\sin{\\left(t \\right)}$ and $y=\\cos{\\left(t \\right)}$ into both field components:\n\n$$\n\\begin{aligned}F(r(t))&=((\\cos{\\left(t \\right)}))\\,i\\\\&\\quad+(- (\\sin{\\left(t \\right)}))\\,j\\\\&=(\\cos{\\left(t \\right)})\\,i\\\\&\\quad+(- \\sin{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nDifferentiate each path component:\n\n$$\n\\begin{aligned}x^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sin{\\left(t \\right)})=\\cos{\\left(t \\right)},\\\\y^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\cos{\\left(t \\right)})=- \\sin{\\left(t \\right)}.\\end{aligned}\n$$\n\nMultiply matching components and add:\n\n$$\n\\begin{aligned}&F(r(t))\\cdot r^{\\prime}(t)\\\\&=(\\cos{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- \\sin{\\left(t \\right)})(- \\sin{\\left(t \\right)}).\\end{aligned}\n$$\n\nSimplify the products using $\\sin^2 t+\\cos^2 t=1$ where applicable:\n\n$$\nF(r(t))\\cdot r^{\\prime}(t)=1.\n$$\n\nKeep the supplied parameter limits. The required integral is\n\n$$\n\\begin{aligned}&\\int_{0}^{2}\\bigl[(\\cos{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- \\sin{\\left(t \\right)})(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186713039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d9db1f-bb91-557f-a268-db0a5a18e896" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{1}^{3}\\bigl[(2 e^{3 t})(1)\\\\&\\quad+(4 e^{t})(e^{t})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713031} {:answer/id #uuid "40943e93-6b05-57c1-ad6b-f6452d8dadb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{1}^{3}\\bigl[(- 2 \\sqrt{t} e^{2 t})(\\sqrt{t})\\\\&\\quad+(4 e^{t})(e^{t})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713033} {:answer/id #uuid "4c0e225b-2548-596f-9ba9-babde7c7ee2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{1}^{3}\\bigl[(2 \\sqrt{t} e^{2 t})(1)\\\\&\\quad+(4 e^{t})(e^{t})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713037} {:answer/id #uuid "627f2e57-c069-5ce4-8914-ec35c3745b71" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{1}^{3}\\bigl[(2 \\sqrt{t} e^{2 t})\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\\\&\\quad+(4 e^{t})(e^{t})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713041} {:answer/id #uuid "62c2fbac-2441-5234-9adf-dec35ee6ace9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{1}^{3}\\bigl[(2 e^{3 t})\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\\\&\\quad+(4 e^{t})(e^{t})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713042}] :answer-field/correct {:answer/id #uuid "627f2e57-c069-5ce4-8914-ec35c3745b71" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{1}^{3}\\bigl[(2 \\sqrt{t} e^{2 t})\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\\\&\\quad+(4 e^{t})(e^{t})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713041} :answer-field/id #uuid "6360d371-92b7-5617-94ac-d2cd5c6b5e2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713043}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5d73125b-bb0a-593f-b95e-0c2ec21a36f9" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=(2 x y^{2})\\,i+(4 y)\\,j$ and $C$ is the path $r(t)=(\\sqrt{t})\\,i+(e^{t})\\,j$ for $t\\in [1,3]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it.\n\n*Hint: $r^{\\prime}(t)=\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\,i+(e^{t})\\,j$. Substitute both coordinates into the field, then take the dot product.*" :question/worked-solution "Use the vector line-integral formula:\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nSubstitute the coordinates $x=\\sqrt{t}$ and $y=e^{t}$ into both field components:\n\n$$\n\\begin{aligned}F(r(t))&=(2 (\\sqrt{t}) (e^{t})^{2})\\,i\\\\&\\quad+(4 (e^{t}))\\,j\\\\&=(2 \\sqrt{t} e^{2 t})\\,i\\\\&\\quad+(4 e^{t})\\,j.\\end{aligned}\n$$\n\nDifferentiate each path component:\n\n$$\n\\begin{aligned}x^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sqrt{t})=\\frac{1}{2 \\sqrt{t}},\\\\y^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(e^{t})=e^{t}.\\end{aligned}\n$$\n\nMultiply matching components and add:\n\n$$\n\\begin{aligned}&F(r(t))\\cdot r^{\\prime}(t)\\\\&=(2 \\sqrt{t} e^{2 t})\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\\\&\\quad+(4 e^{t})(e^{t}).\\end{aligned}\n$$\n\nSimplify the products:\n\n$$\nF(r(t))\\cdot r^{\\prime}(t)=5 e^{2 t}.\n$$\n\nKeep the supplied parameter limits. The required integral is\n\n$$\n\\begin{aligned}&\\int_{1}^{3}\\bigl[(2 \\sqrt{t} e^{2 t})\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\\\&\\quad+(4 e^{t})(e^{t})\\bigr]\\,\\mathrm{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186713049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a9217a-197e-5a79-b240-99e300064447" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 t \\sin{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\\\&\\quad+(2 t \\sin{\\left(t \\right)})(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713030} {:answer/id #uuid "5ee5f34d-e213-57d2-bce5-67b0a900ab35" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 t \\sin{\\left(t \\right)})(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\\\&\\quad+(2 t \\cos{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713040} {:answer/id #uuid "658a425c-c970-589c-918b-b176292d9f2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 t \\sin{\\left(t \\right)})(- t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\\\&\\quad+(2 t \\cos{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713044} {:answer/id #uuid "838c8a44-1cae-5ecb-95b8-47a2aed2f55e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 t \\cos{\\left(t \\right)})(- t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\\\&\\quad+(2 t \\cos{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713046} {:answer/id #uuid "9445bfb2-13c3-5093-94ba-eb583e8a0dde" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 t \\cos{\\left(t \\right)})(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\\\&\\quad+(2 t \\cos{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713051}] :answer-field/correct {:answer/id #uuid "5ee5f34d-e213-57d2-bce5-67b0a900ab35" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 t \\sin{\\left(t \\right)})(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\\\&\\quad+(2 t \\cos{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713040} :answer-field/id #uuid "87248e49-49f7-578c-9410-6dc8605ae63a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713047}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8f8cf799-b912-5587-87a9-ee1b80067dc1" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=(2 x)\\,i+(2 y)\\,j$ and $C$ is the path $r(t)=(t \\sin{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)})\\,j$ for $t\\in [0,1]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it.\n\n*Hint: $r^{\\prime}(t)=(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,i+(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,j$. Substitute both coordinates into the field, then take the dot product.*" :question/worked-solution "Use the vector line-integral formula:\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nSubstitute the coordinates $x=t \\sin{\\left(t \\right)}$ and $y=t \\cos{\\left(t \\right)}$ into both field components:\n\n$$\n\\begin{aligned}F(r(t))&=(2 (t \\sin{\\left(t \\right)}))\\,i\\\\&\\quad+(2 (t \\cos{\\left(t \\right)}))\\,j\\\\&=(2 t \\sin{\\left(t \\right)})\\,i\\\\&\\quad+(2 t \\cos{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nDifferentiate each path component:\n\n$$\n\\begin{aligned}x^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\sin{\\left(t \\right)})=t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)},\\\\y^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\cos{\\left(t \\right)})=- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}.\\end{aligned}\n$$\n\nMultiply matching components and add:\n\n$$\n\\begin{aligned}&F(r(t))\\cdot r^{\\prime}(t)\\\\&=(2 t \\sin{\\left(t \\right)})(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\\\&\\quad+(2 t \\cos{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}).\\end{aligned}\n$$\n\nSimplify the products using $\\sin^2 t+\\cos^2 t=1$ where applicable:\n\n$$\nF(r(t))\\cdot r^{\\prime}(t)=2 t.\n$$\n\nKeep the supplied parameter limits. The required integral is\n\n$$\n\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 t \\sin{\\left(t \\right)})(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\\\&\\quad+(2 t \\cos{\\left(t \\right)})(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186713053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29480a7a-9779-5c72-aa5e-686ff4e445ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(t^{2})(1)\\\\&\\quad+(2 t^{2})(2 t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713027} {:answer/id #uuid "2ec826cf-d37f-51d6-b6f0-67fbd2fb728b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(t^{4})(1)\\\\&\\quad+(2 t^{2})(2 t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713028} {:answer/id #uuid "3f56a250-e546-53a1-85fc-56af3c1de3de" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(t^{4})(1)\\\\&\\quad+(- 2 t^{2})(2 t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713032} {:answer/id #uuid "44144e91-61e3-5ba3-9647-17d13ebf94d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(t^{4})(1)\\\\&\\quad+(- 2 t^{2})(t^{2})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713034} {:answer/id #uuid "44df0283-ef1a-5749-bf7a-de86215aa9b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(t^{4})(1)\\\\&\\quad+(2 t^{2})(t^{2})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713035}] :answer-field/correct {:answer/id #uuid "2ec826cf-d37f-51d6-b6f0-67fbd2fb728b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{2}\\bigl[(t^{4})(1)\\\\&\\quad+(2 t^{2})(2 t)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713028} :answer-field/id #uuid "cc19804d-b831-52c7-be8a-47bb9f762af3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713057}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a3c6f36e-7d98-533f-bae0-60abf8216a47" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=(y^{2})\\,i+(2 x^{2})\\,j$ and $C$ is the path $r(t)=(t)\\,i+(t^{2})\\,j$ for $t\\in [0,2]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it.\n\n*Hint: $r^{\\prime}(t)=(1)\\,i+(2 t)\\,j$. Substitute both coordinates into the field, then take the dot product.*" :question/worked-solution "Use the vector line-integral formula:\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nSubstitute the coordinates $x=t$ and $y=t^{2}$ into both field components:\n\n$$\n\\begin{aligned}F(r(t))&=((t^{2})^{2})\\,i\\\\&\\quad+(2 (t)^{2})\\,j\\\\&=(t^{4})\\,i\\\\&\\quad+(2 t^{2})\\,j.\\end{aligned}\n$$\n\nDifferentiate each path component:\n\n$$\n\\begin{aligned}x^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)=1,\\\\y^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{2})=2 t.\\end{aligned}\n$$\n\nMultiply matching components and add:\n\n$$\n\\begin{aligned}&F(r(t))\\cdot r^{\\prime}(t)\\\\&=(t^{4})(1)\\\\&\\quad+(2 t^{2})(2 t).\\end{aligned}\n$$\n\nSimplify the products:\n\n$$\nF(r(t))\\cdot r^{\\prime}(t)=t^{4} + 4 t^{3}.\n$$\n\nKeep the supplied parameter limits. The required integral is\n\n$$\n\\begin{aligned}&\\int_{0}^{2}\\bigl[(t^{4})(1)\\\\&\\quad+(2 t^{2})(2 t)\\bigr]\\,\\mathrm{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186713055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ae17ad6-79a0-5742-ab49-d52fe47d5ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(- 2 \\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- 2 \\cos{\\left(t \\right)} - 1)(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713048} {:answer/id #uuid "b4b3eabf-a12a-50fa-a39d-9353d982ea58" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(- 2 \\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- 2 \\sin{\\left(t \\right)} - 1)(\\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713056} {:answer/id #uuid "daf2b239-744f-57f7-b6b9-633285cdadb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(2 \\sin{\\left(t \\right)})(1)\\\\&\\quad+(- 2 \\cos{\\left(t \\right)} - 1)(1)\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713058} {:answer/id #uuid "dcd7b501-3955-52d3-9685-eb3ced8dd2ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(- 2 \\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- 2 \\sin{\\left(t \\right)} - 1)(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713059} {:answer/id #uuid "e2bf32ec-517d-582d-919f-f203d9ffebae" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(- 2 \\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- 2 \\cos{\\left(t \\right)} - 1)(\\cos{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713060}] :answer-field/correct {:answer/id #uuid "8ae17ad6-79a0-5742-ab49-d52fe47d5ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\int_{0}^{1}\\bigl[(- 2 \\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- 2 \\cos{\\left(t \\right)} - 1)(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}" :db/id #edb/ref 17592186713048} :answer-field/id #uuid "137b5e03-5115-58b0-ba79-05d93198ab61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713026}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "af26ebe9-3e62-557d-a2b8-0480b65b5604" :question/problem "Which ordinary definite integral represents $\\int_C F\\cdot\\mathrm{d}r$ given that $F(x,y)=(- 2 x)\\,i+(- 2 y - 1)\\,j$ and $C$ is the path $r(t)=(\\sin{\\left(t \\right)})\\,i+(\\cos{\\left(t \\right)})\\,j$ for $t\\in [0,1]$?\n\nUse the supplied parameterization and limits. Select the integral whose integrand is $F(r(t))\\cdot r^{\\prime}(t)$; do not evaluate it.\n\n*Hint: $r^{\\prime}(t)=(\\cos{\\left(t \\right)})\\,i+(- \\sin{\\left(t \\right)})\\,j$. Substitute both coordinates into the field, then take the dot product.*" :question/worked-solution "Use the vector line-integral formula:\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nSubstitute the coordinates $x=\\sin{\\left(t \\right)}$ and $y=\\cos{\\left(t \\right)}$ into both field components:\n\n$$\n\\begin{aligned}F(r(t))&=(- 2 (\\sin{\\left(t \\right)}))\\,i\\\\&\\quad+(- 2 (\\cos{\\left(t \\right)}) - 1)\\,j\\\\&=(- 2 \\sin{\\left(t \\right)})\\,i\\\\&\\quad+(- 2 \\cos{\\left(t \\right)} - 1)\\,j.\\end{aligned}\n$$\n\nDifferentiate each path component:\n\n$$\n\\begin{aligned}x^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sin{\\left(t \\right)})=\\cos{\\left(t \\right)},\\\\y^{\\prime}(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\cos{\\left(t \\right)})=- \\sin{\\left(t \\right)}.\\end{aligned}\n$$\n\nMultiply matching components and add:\n\n$$\n\\begin{aligned}&F(r(t))\\cdot r^{\\prime}(t)\\\\&=(- 2 \\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- 2 \\cos{\\left(t \\right)} - 1)(- \\sin{\\left(t \\right)}).\\end{aligned}\n$$\n\nSimplify the products using $\\sin^2 t+\\cos^2 t=1$ where applicable:\n\n$$\nF(r(t))\\cdot r^{\\prime}(t)=\\sin{\\left(t \\right)}.\n$$\n\nKeep the supplied parameter limits. The required integral is\n\n$$\n\\begin{aligned}&\\int_{0}^{1}\\bigl[(- 2 \\sin{\\left(t \\right)})(\\cos{\\left(t \\right)})\\\\&\\quad+(- 2 \\cos{\\left(t \\right)} - 1)(- \\sin{\\left(t \\right)})\\bigr]\\,\\mathrm{d}t\\end{aligned}\n$$"}] :knowledge-point/title "Constructing Line Integrals of a Vector-Valued Functions Over Plane Curves"}]}
