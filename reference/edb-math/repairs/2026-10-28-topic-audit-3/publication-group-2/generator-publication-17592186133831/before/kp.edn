e,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((- 4 t \\sin{\\left(t \\right)} - t \\cos{\\left(t \\right)})\\,i+(- 3 t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\,j)\\cdot ((- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j) \\\\  & =(- 4 t \\sin{\\left(t \\right)} - t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- 3 t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =(- t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- 4 t \\sin{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})+(- 3 t \\sin{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =4 t^{2} \\sin^{2}{\\left(t \\right)} - 2 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t^{2} \\cos^{2}{\\left(t \\right)} - 3 t \\sin^{2}{\\left(t \\right)} - 3 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - t \\cos^{2}{\\left(t \\right)} \\\\  & =t^{2} \\left(4 \\sin^{2}{\\left(t \\right)} - 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right).\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{\\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{\\pi}{3}}(t^{2} \\left(4 \\sin^{2}{\\left(t \\right)} - 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right))\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "231542bc-935b-58eb-a04d-88b4f37951f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(t^{2} \\left(- 3 \\sin^{2}{\\left(t \\right)} - \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 4 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560140} {:answer/id #uuid "2d042e0c-6a7e-5449-a8d2-89c55857dc02" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(- t^{2} \\left(- 3 \\sin^{2}{\\left(t \\right)} - \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right) - t \\left(- 4 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560145} {:answer/id #uuid "71e523ba-fc50-5d33-88f4-98a74bff9f24" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(- 3 t^{2} \\sin^{2}{\\left(t \\right)} + 3 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 3 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 t \\cos^{2}{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560166} {:answer/id #uuid "a14b9979-009a-544a-b5e1-ec3711b08286" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(- t \\sin{\\left(t \\right)} - 4 t \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560184} {:answer/id #uuid "aa2043ce-5c63-5720-80b7-1ba2c1918519" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{3}}(- 4 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - t^{2} \\cos^{2}{\\left(t \\right)} - 4 t \\sin^{2}{\\left(t \\right)} - t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})\\,dt