{d}z}{\\mathrm{d}t}\\,k \\\\ & =\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(t\\right)\\,i \\\\ &\\quad {}+\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(t^{2}\\right)\\,j \\\\ &\\quad {}+\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(t^{3}\\right)\\,k \\\\ & =\\,i+2 t\\,j+3 t^{2}\\,k\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =\\left(- t^{2}\\right)\\left(1\\right) \\\\ &\\quad {}+\\left(- 2 t\\right)\\left(2 t\\right) \\\\ &\\quad {}+\\left(- t^{3}\\right)\\left(3 t^{2}\\right) \\\\ & =\\left(- t^{2}\\right)+\\left(- 4 t^{2}\\right) \\\\ &\\quad {}+\\left(- 3 t^{5}\\right) \\\\ & =t^{2} \\left(- 3 t^{3} - 5\\right)\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F\\cdot\\mathrm{d}r & =\\int_{0}^{1}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\ & =\\int_{0}^{1}\\left(t^{2} \\left(- 3 t^{3} - 5\\right)\\right)\\,\\mathrm{d}t \\\\ & =\\left[- \\frac{t^{6}}{2} - \\frac{5 t^{3}}{3}\\right]_{0}^{1} \\\\ & =\\left(- \\frac{\\left(1\\right)^{6}}{2} - \\frac{5 \\left(1\\right)^{3}}{3}\\right) \\\\ &\\quad {}+\\left(-\\left(- \\frac{\\left(0\\right)^{6}}{2} - \\frac{5 \\left(0\\right)^{3}}{3}\\right)\\right) \\\\ & =\\left(- \\frac{13}{6}\\right)+\\left(0\\right) \\\\ & =- \\frac{13}{6}\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating Line Integrals of Vector-Valued Functions Over Space Curves"}]}
