5-3f359e70c7a7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9y}{2}" :db/id #edb/ref 17592186507737} {:answer/id #uuid "93f161f4-832c-5426-af71-c7778005d5fb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4y}" :db/id #edb/ref 17592186507807} {:answer/id #uuid "e3a24980-5105-538e-8c74-64c4ebc803d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3y}{4}" :db/id #edb/ref 17592186507904} {:answer/id #uuid "e5c9d2d6-91af-5536-9214-6c10a18ce267" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2y}" :db/id #edb/ref 17592186507909} {:answer/id #uuid "ef20abea-8c5e-5aa2-aa09-5d4772fb2a0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4y}" :db/id #edb/ref 17592186507922}] :answer-field/correct {:answer/id #uuid "ef20abea-8c5e-5aa2-aa09-5d4772fb2a0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4y}" :db/id #edb/ref 17592186507922} :answer-field/id #uuid "293366ad-ad39-5d08-a9c8-a7c1154b5526" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507956}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3f2a3f8a-3c25-5094-b1ff-9932bec29ec7" :question/math-academy-id "q-127503" :question/problem "![](images/4c/4c6a99f62a77f7fc16dbb95e8a8d03c42b266fffee10ed3739ab13820729be44.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(2,-3).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=2$ and $y=-3$ into the equation above, we get\n\n$$\n\\begin{aligned}(-3)^{2} & =4p(2) \\\\ 9 & =8p \\\\ p & =\\frac{9}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{9}{2}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{9}{2}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{4y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186550175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7904e266-8e40-55dd-9fdd-7cf84c6b8ee2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{y}" :db/id #edb/ref 17592186550183}] :answer-field/correct {:answer/id #uuid "7904e266-8e40-55dd-9fdd-7cf84c6b8ee2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{y}" :db/id #edb/ref 17592186550183} :answer-field/id #uuid "eb810b16-9131-57df-8426-531a34ce6789" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186550207}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "50ce0446-d663-52f1-8947-55316401966e" :question/problem "![](images/44/44f13c74646a1a3dda14673314c545a5909a72b05ba9f967ebcaff36f7388b76.png)\n\nThe parabola shown above has equation\n\n$$\n{y}^{2}=12x.\n$$\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The equation of our parabola is \n\n$$\n{y}^{2}=12x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =12 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186550181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e669d2-14d3-5434-9211-5869010d936c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 1759218655017