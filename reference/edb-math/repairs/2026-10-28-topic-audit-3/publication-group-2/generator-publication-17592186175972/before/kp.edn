#{[{:db/id #edb/ref 17592186175972 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175822 :question/id #uuid "3e65aff0-a768-58fd-b41c-ca38ce3eb0bd" :question/math-academy-id "e-8888" :question/problem "$$\n\\mathbf{f}(x,y) = \\big\\langle x, \\: y, \\: \\text{___} \\big\\rangle\n$$\n\nThe vector-valued function $\\mathbf{f}(x,y)$ above parametrizes the parabolic cylinder defined in Cartesian coordinates as $2x^2=z.$ What is the third component of $\\mathbf{f}?$" :question/worked-solution "For any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(x,y) & =⟨x,y,z⟩ \\\\  & =⟨x,\\hspace{0.222em}y,\\hspace{0.222em}{\\color{blue}2{x}^{2}}⟩\\end{aligned}\n$$\n\nwhere $x \\in (-\\infty,\\infty)$ and $y \\in (-\\infty,\\infty).$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue} 2x^2}.$"} :knowledge-point/id #uuid "87b371d9-6172-5ac0-a105-c9887542f0a7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048259 :topic/id #uuid "8d29957f-c788-5b0c-83bd-13de2712401f" :topic/knowledge-points [{:db/id #edb/ref 17592186119880} {:db/id #edb/ref 17592186119881} {:db/id #edb/ref 17592186119882} {:db/id #edb/ref 17592186119883}] :topic/math-academy-id 1789 :topic/next [{:db/id #edb/ref 17592186048642} {:db/id #edb/ref 17592186049482} {:db/id #edb/ref 17592186049817} {:db/id #edb/ref 17592186050346}] :topic/title "Parametric Surfaces"} {:db/id #edb/ref 17592186050123 :topic/difficulty 1.0 :topic/id #uuid "2eaffcb9-29e5-5903-a02d-080ab3e7a821" :topic/knowledge-points [{:db/id #edb/ref 17592186124587} {:db/id #edb/ref 17592186124588}] :topic/math-academy-id 1895 :topic/next [{:db/id #edb/ref 17592186049482} {:db/id #edb/ref 17592186050005} {:db/id #edb/ref 17592186050851}] :topic/title "Cylinders"} {:db/id #edb/ref 17592186050769 :topic/difficulty 1.4014403941425895 :topic/id #uuid "654e93d7-fd22-5247-81be-58bce3864517" :topic/knowledge-points [{:db/id #edb/ref 17592186087800} {:db/id #edb/ref 17592186087801