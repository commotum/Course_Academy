dy}{\\text{d}t})\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }({e}^{\\sqrt{3}\\operatorname{cos}⁡t}+\\sqrt{3}\\operatorname{sin}⁡t)\\cdot (-\\sqrt{3}\\operatorname{sin}⁡t)-(\\sqrt{3}\\operatorname{cos}⁡t)\\cdot (\\sqrt{3}\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }-\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}-3{sin}^{2}⁡t-3{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }-\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}-3\\,\\text{d}t \\\\  & =-{\\int }_{\\pi /2}^{\\pi }\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}+3\\,\\text{d}t\\end{aligned}\n$$"] [17592186387547 "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $3,$ respectively, it can be parametrized as follows:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) & =x(t)\\hspace{0.167em}\\mathbf{i}+y(t)\\hspace{0.167em}\\mathbf{j}=\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}t\\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}]\\end{aligned}\n$$\n\nThe derivative of $\\mathbf{r}(t)$ is given by\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}=-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-2y)\\,dx+2x\\,dy & ={\\int }_{\\pi /2}^{3\\pi /2}(x-2y)\\,\\frac{dx}{\\text{d}t}\\,\\text{d}t+2x\\,\\frac{dy}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}((x-2y)\\,\\frac{dx}{\\text{d}t}+2x\\,\\frac{dy}{\\text{d}t})\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡t-2(3\\operatorname{sin}⁡t))\\cdot (-\\operatorname{sin}⁡t)+2(\\operatorname{cos}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3