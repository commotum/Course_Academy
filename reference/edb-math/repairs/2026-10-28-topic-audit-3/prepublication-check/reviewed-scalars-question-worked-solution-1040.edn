}{3}\\right)(-3)-(1)(1))\\mathbf{j}+(\\left(\\frac{2}{3}\\right)(2)-(0)(1))\\mathbf{k} \\\\  & =(0-2)\\mathbf{i}-(-2-1)\\mathbf{j}+\\left(\\frac{4}{3}\\right)\\mathbf{k} \\\\  & =-2\\mathbf{i}+3\\mathbf{j}+\\left(\\frac{4}{3}\\right)\\mathbf{k} \\\\  & =⟨-2,3,\\frac{4}{3}⟩.\\end{aligned}\n$$"] [17592186295227 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & -4 & 1 \\\\ -2 & 5 & 6\\end{vmatrix} \\\\  & =\\begin{vmatrix}-4 & 1 \\\\ 5 & 6\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & 1 \\\\ -2 & 6\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & -4 \\\\ -2 & 5\\end{vmatrix}\\mathbf{k} \\\\  & =((-4)(6)-(1)(5))\\mathbf{i}-((3)(6)-(1)(-2))\\mathbf{j}+((3)(5)-(-4)(-2))\\mathbf{k} \\\\  & =(-24-5)\\mathbf{i}-(18+2)\\mathbf{j}+(15-8)\\mathbf{k} \\\\  & =-29\\hspace{0.167em}\\mathbf{i}-20\\hspace{0.167em}\\mathbf{j}+7\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$"] [17592186295228 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 2 & -5 \\\\ -3 & 4 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -5 \\\\ 4 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & -5 \\\\ -3 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 2 \\\\ -3 & 4\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot 1-(-5)(4))\\mathbf{i}-(1\\cdot 1-(-5)(-3))\\mathbf{j}+(1\\cdot 4-2\\cdot (-3))\\mathbf{k} \\\\  & =(2+20)\\mathbf{i}-(1-15)\\mathbf{j}+(4+6)\\mathbf{k} \\\\  & =22\\hspace{0.167em}\\mathbf{i}+14\\hspace{0.167em}\\mathbf{j}+10\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$"] [17592186295229 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -6 & 3 & 2 \\\\ 4 & -1 & 5\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 2 \\\\ -1 & 5\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-6 & 2 \\\\ 4 & 5\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-6 & 3 \\\\ 4 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot 5-2\\cdot -1)\\mathbf{i}-(-6\\cdot 5-2\\cdot 4)\\mathbf{j}+(-6\\cdot -1-3\\cdot 4)\\mathbf{k} \\\\  & =(15+2)\\mathbf{i}-(-30-8)\\mathbf{j}+(6-12)\\mathbf{k} \\\\  & =17\\hspace{0.167em}\\mathbf{i}+38\\hspace{0.167em}\\mathbf{j}-6\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$"] [17592186295230 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & -7 & 4 \\\\ 5 & 3 & -6\\end{vmatrix} \\\\  & =\\begin{vmatrix}-7 & 4 \\\\ 3 & -6\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 4 \\\\ 5 & -6\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & -7 \\\\ 5 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =((-7)(-6)-(4)(3))\\mathbf{i}-((2)(-6)-(4)(5))\\mathbf{j}+((2)(3)-(-7)(5))\\mathbf{k} \\\\  & =(42-12)\\mathbf{i}-(-12-20)\\mathbf{j}+(6+35)\\mathbf{k} \\\\  & =30\\hspace{0.167em}\\mathbf{i}+32\\hspace{0.167em}\\mathbf{j}+41\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$"] [17592186295231 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -4 & 0 & 3 \\\\ 1 & 2 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 3 \\\\ 2 & -2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-4 & 3 \\\\ 1 & -2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-4 & 0 \\\\ 1 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(0)(-2)-(3)(2)\\mathbf{i}-(-4)(-2)-(3)(1)\\mathbf{j}+(-4)(2)-(0)(1)\\mathbf{k} \\\\  & =(0-6)\\mathbf{i}-(8-3)\\mathbf{j}+(-8-0)\\mathbf{k} \\\\  & =-6\\hspace{0.167em}\\mathbf{i}-5\\hspace{0.167em}\\mathbf{j}-8\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$"] [17592186295235 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2x & 3 & 1 \\\\ -2x & 0 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 1 \\\\ 0 & 4\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2x & 1 \\\\ -2x & 4\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2x & 3 \\\\ -2x & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(12-0)\\mathbf{i}-(8x+2x)\\mathbf{j}+(0+6x)\\mathbf{k} \\\\  & =⟨12,-10x,6x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{{12}^{2}+(-10x)^{2}+(6x)^{2}} \\\\  & =\\sqrt{144+100{x}^{2}+36{x}^{2}} \\\\  & =\\sqrt{136{x}^{2}+144}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{280} \\\\ \\sqrt{136{x}^{2}+144} & =\\sqrt{280} \\\\ 136{x}^{2}+144 & =280 \\\\ 136{x}^{2} & =136 \\\\ {x}^{2} & =1\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-1,$ $x=1.$"] [17592186295236 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ x & 0 & 1 \\\\ -x & 2 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}x & 1 \\\\ -x & 0\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}x & 0 \\\\ -x & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(0-2)\\mathbf{i}-(0+x)\\mathbf{j}+(2x+0)\\mathbf{k} \\\\  & =⟨-2,-x,2x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{(-2)^{2}+(-x)^{2}+(2x)^{2}} \\\\  & =\\sqrt{4+{x}^{2}+4{x}^{2}} \\\\  & =\\sqrt{5{x}^{2}+4}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{29} \\\\ \\sqrt{5{x}^{2}+4} & =\\sqrt{29} \\\\ 5{x}^{2}+4 & =29 \\\\ 5{x}^{2} & =25 \\\\ {x}^{2} & =5\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-\\sqrt{5},$ $x=\\sqrt{5}.$"] [17592186295237 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ x & 3 & 0 \\\\ -x & 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 0 \\\\ 0 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}x & 0 \\\\ -x & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}x & 3 \\\\ -x & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(3-0)\\mathbf{i}-(x+0)\\mathbf{j}+(0+3x)\\mathbf{k} \\\\  & =⟨3,-x,3x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{{3}^{2}+(-x)^{2}+(3x)^{2}} \\\\  & =\\sqrt{9+{x}^{2}+9{x}^{2}} \\\\  & =\\sqrt{10{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{49} \\\\ \\sqrt{10{x}^{2}+9} & =\\sqrt{49} \\\\ 10{x}^{2}+9 & =49 \\\\ 10{x}^{2} & =40 \\\\ {x}^{2} & =4\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-2,$ $x=2.$"] [17592186295238 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ x & 1 & 1 \\\\ 1 & 0 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 \\\\ 0 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}x & 1 \\\\ 1 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}x & 1 \\\\ 1 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(3-0)\\mathbf{i}-(3x-1)\\mathbf{j}+(0-1)\\mathbf{k} \\\\  & =⟨3,1-3x,-1⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{{3}^{2}+(1-3x)^{2}+(-1)^{2}} \\\\  & =\\sqrt{9+(9{x}^{2}-6x+1)+1} \\\\  & =\\sqrt{9{x}^{2}-6x+11}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{10} \\\\ \\sqrt{9{x}^{2}-6x+11} & =\\sqrt{10} \\\\ 9{x}^{2}-6x+11 & =10 \\\\ (3x-1)^{2} & =0 \\\\ 3x-1 & =0 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{1}{3}.$"] [17592186295239 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ x & 1 & 2 \\\\ 1 & 0 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 2 \\\\ 0 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}x & 2 \\\\ 1 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}x & 1 \\\\ 1 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(2-0)\\mathbf{i}-(2x-2)\\mathbf{j}+(0-1)\\mathbf{k} \\\\  & =⟨2,2-2x,-1⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{{2}^{2}+(2-2x)^{2}+(-1)^{2}} \\\\  & =\\sqrt{4+(4{x}^{2}-8x+4)+1} \\\\  & =\\sqrt{4{x}^{2}-8x+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{5} \\\\ \\sqrt{4{x}^{2}-8x+9} & =\\sqrt{5} \\\\ 4{x}^{2}-8x+9 & =5 \\\\ 4{x}^{2}-8x+4 & =0 \\\\ (2x-2)^{2} & =0 \\\\ 2x-2 & =0 \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$"] [17592186295240 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ x & 4 & 5 \\\\ 1 & 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}4 & 5 \\\\ 0 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}x & 5 \\\\ 1 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}x & 4 \\\\ 1 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(4-0)\\mathbf{i}-(x-5)\\mathbf{j}+(0-4)\\mathbf{k} \\\\  & =⟨4,5-x,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{{4}^{2}+(5-x)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+(25-10x+{x}^{2})+16} \\\\  & =\\sqrt{{x}^{2}-10x+57}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{33} \\\\ \\sqrt{{x}^{2}-10x+57} & =\\sqrt{33} \\\\ {x}^{2}-10x+57 & =33 \\\\ {x}^{2}-10x+24 & =0 \\\\ (x-4)(x-6) & =0 \\\\ x & =4,\\hspace{1em}x=6\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=4,$ $x=6.$"] [17592186295241 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2x & 1 & 4 \\\\ 3 & 0 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 4 \\\\ 0 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2x & 4 \\\\ 3 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2x & 1 \\\\ 3 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(2-0)\\mathbf{i}-(4x-12)\\mathbf{j}+(0-3)\\mathbf{k} \\\\  & =⟨2,12-4x,-3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{{2}^{2}+(12-4x)^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+(144-96x+16{x}^{2})+9} \\\\  & =\\sqrt{16{x}^{2}-96x+157}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{157} \\\\ \\sqrt{16{x}^{2}-96x+157} & =\\sqrt{157} \\\\ 16{x}^{2}-96x+157 & =157 \\\\ 16{x}^{2}-96x & =0 \\\\ 16x(x-6) & =0 \\\\ x & =0,\\hspace{1em}x=6\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=0,$ $x=6.$"] [17592186297160 "The area of the quadrilateral $ABCD$ is the sum of the areas of the triangles $△ABD$ and $△BDC$ (see the illustration below).\n\n![](images/cd/cd9363a3cc686ae45f49c982f4b31ad75b7c7897dcf7e8af58e530dba6946e1d.png)\n\nFirst we find the area for $△ABD:$ \n \n\n$$\\begin{aligned}{\\mathcal{A}}_{ABD} & =\\frac{1}{2}\\cdot 6\\cdot 7\\cdot \\operatorname{sin}{50}^{∘} \\\\  & =21\\cdot \\operatorname{sin}{50}^{∘} \\\\  & \\approx 16.086\\hspace{0.167em}9,\\end{aligned}$$\n\nrounded to four decimal places.\n\nNow we find the area for $△BCD:$ \n \n\n$$\\begin{aligned}{\\mathcal{A}}_{BDC} & =\\frac{1}{2}\\cdot 7\\cdot 8\\cdot \\operatorname{sin}{43}^{∘} \\\\  & =28\\cdot \\operatorname{sin}{43}^{∘} \\\\  & \\approx 19.096\\hspace{0.167em}0,\\end{aligned}$$\n\nrounded to four decimal places.\n\nFinally, we add together the areas of our two triangles to determine the area of $ABCD:$\n\n$$\\begin{aligned}{\\mathcal{A}}_{ABCD} & ={\\mathcal{A}}_{ABD}+{\\mathcal{A}}_{BDC} \\\\  & \\approx 16.086\\hspace{0.167em}9+19.096\\hspace{0.167em}0 \\\\  & \\approx 35.182\\hspace{0.167em}9\\end{aligned}$$\n\nConsequently, to the **nearest tenth**, the area of the quadrilateral $ABCD$ is $35.2.$"] [17592186297161 "The diagonal $\\overset{―}{AC}$ divides the parallelogram into two congruent triangles. Therefore, the area of the parallelogram is twice the area of $△ACB$ (see the illustration below).\n\n![](images/d6/d6a654d3154ba8af8fc4f7654e62c6bacfede7017322aeed21a143e2634dcd14.png)\n\n Computing the area of $△ACB,$ we find\n \n\n$$\\begin{aligned}{\\mathcal{A}}_{ACB} & =\\frac{1}{2}(4)(8)\\operatorname{sin}{120}^{∘} \\\\  & =16\\cdot \\operatorname{sin}{120}^{∘} \\\\  & \\approx 13.856,\\end{aligned}$$\n\nrounded to three decimal places. Consequently,\n\n$$\\begin{aligned}{\\mathcal{A}}_{ABCD} & =2{\\mathcal{A}}_{ACB} \\\\  & =2\\cdot 13.856 \\\\  & =27.712.\\end{aligned}$$\n\nSo, to the **nearest integer**, the area of the parallelogram is $28.$"] [17592186297162 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 6\\cdot 4\\cdot \\operatorname{sin}{75}^{∘} \\\\  & =\\frac{1}{2}\\cdot 24\\cdot \\operatorname{sin}{75}^{∘} \\\\  & =11.591… \\\\  & \\approx 12{\\text{ cm}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =12-10 \\\\  & =2{\\text{ cm}}^{2}.\\end{aligned}$$"] [17592186297163 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 7\\cdot \\operatorname{sin}{45}^{∘} \\\\  & =\\frac{1}{2}\\cdot 28\\cdot \\operatorname{sin}{45}^{∘} \\\\  & =9.899… \\\\  & \\approx 10{\\text{ m}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =10-7 \\\\  & =3{\\text{ mm}}^{2}.\\end{aligned}$$"] [17592186297164 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 2.5\\cdot 6\\cdot \\operatorname{sin}{63}^{∘} \\\\  & =\\frac{1}{2}\\cdot 15\\cdot \\operatorname{sin}{63}^{∘} \\\\  & =6.682… \\\\  & \\approx 7{\\text{ km}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =7-5 \\\\  & =2{\\text{ km}}^{2}.\\end{aligned}$$"] [17592186297165 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 5\\cdot 6.5\\cdot \\operatorname{sin}{90}^{∘} \\\\  & =\\frac{1}{2}\\cdot 32.5\\cdot \\operatorname{sin}{90}^{∘} \\\\  & \\approx 16{\\text{ mi}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =16-13 \\\\  & =3{\\text{ mi}}^{2}.\\end{aligned}$$"] [17592186297464 "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -3 & 5 & 0 \\\\ 4 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & 0 \\\\ -1 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-3 & 0 \\\\ 4 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-3 & 5 \\\\ 4 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =(5\\cdot 2-0\\cdot (-1))\\mathbf{i}-((-3)\\cdot 2-0\\cdot 4)\\mathbf{j}+((-3)\\cdot (-1)-5\\cdot 4)\\mathbf{k} \\\\  & =10\\mathbf{i}+6\\mathbf{j}-17\\mathbf{k} \\\\  & =⟨10,6,-17⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| \\\\  & =\\sqrt{{10}^{2}+{6}^{2}+(-17)^{2}} \\\\  & =\\sqrt{100+36+289} \\\\  & =\\sqrt{425} \\\\  & =5\\sqrt{17}.\\end{aligned}\n$$"] [17592186297465 "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 0 & 0 \\\\ 0 & 3 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 0 \\\\ 3 & 4\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 0 \\\\ 0 & 4\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 0 \\\\ 0 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =(0\\cdot 4-0\\cdot 3)\\mathbf{i}-(1\\cdot 4-0\\cdot 0)\\mathbf{j}+(1\\cdot 3-0\\cdot 0)\\mathbf{k} \\\\  & =0\\mathbf{i}-4\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨0,-4,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+{3}^{2}} \\\\  & =\\sqrt{0+16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"] [17592186297466 "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{p}\\times \\mathbf{q} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 0 & 5 & -1 \\\\ 6 & 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & -1 \\\\ 0 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}0 & -1 \\\\ 6 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}0 & 5 \\\\ 6 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(5\\cdot 1-(-1)\\cdot 0)\\mathbf{i}-(0\\cdot 1-(-1)\\cdot 6)\\mathbf{j}+(0\\cdot 0-5\\cdot 6)\\mathbf{k} \\\\  & =5\\mathbf{i}-6\\mathbf{j}-30\\mathbf{k} \\\\  & =⟨5,-6,-30⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{p}\\times \\mathbf{q}\\hspace{0.167em}| \\\\  & =\\sqrt{{5}^{2}+(-6)^{2}+(-30)^{2}} \\\\  & =\\sqrt{25+36+900} \\\\  & =\\sqrt{961} \\\\  & =31.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{31}{2}.\n$$"] [17592186297467 "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\mathbf{q}-\\mathbf{p} \\\\  & =(3\\mathbf{i}+\\mathbf{j}-\\mathbf{k})-(\\mathbf{i}-2\\mathbf{j}) \\\\  & =2\\mathbf{i}+3\\mathbf{j}-\\mathbf{k} \\\\  & =⟨2,3,-1⟩ \\\\ \\overset{\\to }{PR} & =\\mathbf{r}-\\mathbf{p} \\\\  & =(-\\mathbf{i}+2\\mathbf{k})-(\\mathbf{i}-2\\mathbf{j}) \\\\  & =-2\\mathbf{i}+2\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨-2,2,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 3 & -1 \\\\ -2 & 2 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -1 \\\\ 2 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -1 \\\\ -2 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 3 \\\\ -2 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot 2-(-1)\\cdot 2)\\mathbf{i}-(2\\cdot 2-(-1)\\cdot (-2))\\mathbf{j}+(2\\cdot 2-3\\cdot (-2))\\mathbf{k} \\\\  & =8\\mathbf{i}-2\\mathbf{j}+10\\mathbf{k} \\\\  & =⟨8,-2,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{{8}^{2}+(-2)^{2}+{10}^{2}} \\\\  & =\\sqrt{64+4+100} \\\\  & =\\sqrt{168} \\\\  & =2\\sqrt{42}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{42}}{2}=\\sqrt{42}.\n$$"] [17592186297468 "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =\\mathbf{e}-\\mathbf{d} \\\\  & =(-\\mathbf{j})-(-2\\mathbf{i}+\\mathbf{j}+3\\mathbf{k}) \\\\  & =2\\mathbf{i}-2\\mathbf{j}-3\\mathbf{k} \\\\  & =⟨2,-2,-3⟩ \\\\ \\overset{\\to }{DF} & =\\mathbf{f}-\\mathbf{d} \\\\  & =(2\\mathbf{i}+2\\mathbf{j}-\\mathbf{k})-(-2\\mathbf{i}+\\mathbf{j}+3\\mathbf{k}) \\\\  & =4\\mathbf{i}+\\mathbf{j}-4\\mathbf{k} \\\\  & =⟨4,1,-4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & -2 & -3 \\\\ 4 & 1 & -4\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & -3 \\\\ 1 & -4\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -3 \\\\ 4 & -4\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & -2 \\\\ 4 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot (-4)-(-3)\\cdot 1)\\mathbf{i}-(2\\cdot (-4)-(-3)\\cdot 4)\\mathbf{j}+(2\\cdot 1-(-2)\\cdot 4)\\mathbf{k} \\\\  & =11\\mathbf{i}-4\\mathbf{j}+10\\mathbf{k} \\\\  & =⟨11,-4,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{{11}^{2}+(-4)^{2}+{10}^{2}} \\\\  & =\\sqrt{121+16+100} \\\\  & =\\sqrt{237}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{237}}{2}.\n$$"] [17592186297469 "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(2\\mathbf{j}-2\\mathbf{k})-(-3\\mathbf{i}+\\mathbf{k}) \\\\  & =3\\mathbf{i}+2\\mathbf{j}-3\\mathbf{k} \\\\  & =⟨3,2,-3⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(2\\mathbf{i}-\\mathbf{j})-(-3\\mathbf{i}+\\mathbf{k}) \\\\  & =5\\mathbf{i}-\\mathbf{j}-\\mathbf{k} \\\\  & =⟨5,-1,-1⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & 2 & -3 \\\\ 5 & -1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -3 \\\\ -1 & -1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & -3 \\\\ 5 & -1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & 2 \\\\ 5 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot (-1)-(-3)\\cdot (-1))\\mathbf{i}-(3\\cdot (-1)-(-3)\\cdot 5)\\mathbf{j}+(3\\cdot (-1)-2\\cdot 5)\\mathbf{k} \\\\  & =-5\\mathbf{i}-12\\mathbf{j}-13\\mathbf{k} \\\\  & =⟨-5,-12,-13⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{(-5)^{2}+(-12)^{2}+(-13)^{2}} \\\\  & =\\sqrt{25+144+169} \\\\  & =\\sqrt{338} \\\\  & =13\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{13\\sqrt{2}}{2}.\n$$"] [17592186297473 "Note that the length of the altitude $NP$ can be related to the area of $△\\,LMN$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}\\,NP\\cdot LM.\n$$\n\nSo, to find $NP,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(2\\mathbf{j}+\\mathbf{k})-(3\\mathbf{i}-\\mathbf{j}) \\\\  & =-3\\mathbf{i}+3\\mathbf{j}+\\mathbf{k} \\\\  & =⟨-3,3,1⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(-2\\mathbf{i}+\\mathbf{j}-\\mathbf{k})-(3\\mathbf{i}-\\mathbf{j}) \\\\  & =-5\\mathbf{i}+2\\mathbf{j}-\\mathbf{k} \\\\  & =⟨-5,2,-1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -3 & 3 & 1 \\\\ -5 & 2 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 1 \\\\ 2 & -1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-3 & 1 \\\\ -5 & -1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-3 & 3 \\\\ -5 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot (-1)-1\\cdot 2)\\mathbf{i}-((-3)\\cdot (-1)-1\\cdot (-5))\\mathbf{j}+((-3)\\cdot 2-3\\cdot (-5))\\mathbf{k} \\\\  & =-5\\mathbf{i}-8\\mathbf{j}+9\\mathbf{k} \\\\  & =⟨-5,-8,9⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{(-5)^{2}+(-8)^{2}+{9}^{2}} \\\\  & =\\sqrt{170}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{170}}{2}.\n$$\n\nLet's also compute $LM$ since it appears in the formula:\n\n$$\n\\begin{aligned}LM & =|\\overset{\\to }{LM}| \\\\  & =\\sqrt{(-3)^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{19}.\\end{aligned}\n$$\n\nFinally, using ${A}_{△}=\\frac{1}{2}\\,NP\\cdot LM,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}\\,NP\\cdot LM \\\\ \\frac{\\sqrt{170}}{2} & =\\frac{1}{2}\\,NP\\cdot \\sqrt{19} \\\\ \\sqrt{170} & =NP\\cdot \\sqrt{19} \\\\ NP & =\\frac{\\sqrt{170}}{\\sqrt{19}} \\\\  & =\\frac{\\sqrt{3230}}{19}.\\end{aligned}\n$$"] [17592186297474 "Note that the length of the altitude $UT$ can be related to the area of $△\\,UVW$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}\\,UT\\cdot VW.\n$$\n\nSo, to find $UT,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{VW}$ and $\\overset{\\to }{VU}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{VW} & =\\mathbf{w}-\\mathbf{v} \\\\  & =(3\\mathbf{i}-\\mathbf{k})-(\\mathbf{i}-\\mathbf{j}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+\\mathbf{j}-3\\mathbf{k} \\\\  & =⟨2,1,-3⟩ \\\\ \\overset{\\to }{VU} & =\\mathbf{u}-\\mathbf{v} \\\\  & =(-2\\mathbf{i}+2\\mathbf{j})-(\\mathbf{i}-\\mathbf{j}+2\\mathbf{k}) \\\\  & =-3\\mathbf{i}+3\\mathbf{j}-2\\mathbf{k} \\\\  & =⟨-3,3,-2⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{VW}\\times \\overset{\\to }{VU} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 1 & -3 \\\\ -3 & 3 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -3 \\\\ 3 & -2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -3 \\\\ -3 & -2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 1 \\\\ -3 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot (-2)-(-3)\\cdot 3)\\mathbf{i}-(2\\cdot (-2)-(-3)\\cdot (-3))\\mathbf{j}+(2\\cdot 3-1\\cdot (-3))\\mathbf{k} \\\\  & =7\\mathbf{i}+13\\mathbf{j}+9\\mathbf{k} \\\\  & =⟨7,13,9⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{VW}$ and $\\overset{\\to }{VU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{VW}\\times \\overset{\\to }{VU}| \\\\  & =\\sqrt{{7}^{2}+{13}^{2}+{9}^{2}} \\\\  & =\\sqrt{299}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,UVW$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{299}}{2}.\n$$\n\nLet's also compute $VW$ since it appears in the formula:\n\n$$\n\\begin{aligned}VW & =|\\overset{\\to }{VW}| \\\\  & =\\sqrt{{2}^{2}+{1}^{2}+(-3)^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$\n\nFinally, using ${A}_{△}=\\frac{1}{2}\\,UT\\cdot VW,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}\\,UT\\cdot VW \\\\ \\frac{\\sqrt{299}}{2} & =\\frac{1}{2}\\,UT\\cdot \\sqrt{14} \\\\ \\sqrt{299} & =UT\\cdot \\sqrt{14} \\\\ UT & =\\frac{\\sqrt{299}}{\\sqrt{14}} \\\\  & =\\frac{\\sqrt{4186}}{14}.\\end{aligned}\n$$"] [17592186297475 "Note that the length of the altitude $VL$ can be related to the area of $△\\,TUV$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}VL\\cdot TU\n$$\n\nSo, to find $VL,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{TU}$ and $\\overset{\\to }{TV}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{TU} & =\\mathbf{u}-\\mathbf{t} \\\\  & =(3\\mathbf{i}+2\\mathbf{j}-\\mathbf{k})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =2\\mathbf{i}+2\\mathbf{j}-2\\mathbf{k} \\\\  & =⟨2,2,-2⟩ \\\\ \\overset{\\to }{TV} & =\\mathbf{v}-\\mathbf{t} \\\\  & =(-\\mathbf{i}+\\mathbf{j})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =-2\\mathbf{i}+\\mathbf{j}-\\mathbf{k} \\\\  & =⟨-2,1,-1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{TU}\\times \\overset{\\to }{TV} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 2 & -2 \\\\ -2 & 1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -2 \\\\ 1 & -1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -2 \\\\ -2 & -1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 2 \\\\ -2 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot (-1)-(-2)\\cdot 1)\\mathbf{i}-(2\\cdot (-1)-(-2)\\cdot (-2))\\mathbf{j}+(2\\cdot 1-2\\cdot (-2))\\mathbf{k} \\\\  & =0\\mathbf{i}+6\\mathbf{j}+6\\mathbf{k} \\\\  & =⟨0,6,6⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{TU}$ and $\\overset{\\to }{TV}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{TU}\\times \\overset{\\to }{TV}| \\\\  & =\\sqrt{{0}^{2}+{6}^{2}+{6}^{2}} \\\\  & =\\sqrt{72} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,TUV$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{6\\sqrt{2}}{2}=3\\sqrt{2}.\n$$\n\nLet's also compute $TU$ since it appears in the formula:\n\n$$\n\\begin{aligned}TU & =|\\overset{\\to }{TU}| \\\\  & =\\sqrt{{2}^{2}+{2}^{2}+(-2)^{2}} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}VL\\cdot TU,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}VL\\cdot TU \\\\ 3\\sqrt{2} & =\\frac{1}{2}VL\\cdot 2\\sqrt{3} \\\\ 3\\sqrt{2} & =VL\\cdot \\sqrt{3} \\\\ VL & =\\frac{3\\sqrt{2}}{\\sqrt{3}} \\\\ VL & =\\sqrt{6}.\\end{aligned}\n$$"] [17592186297477 "Note that the length of the altitude $IP$ can be related to the area of $△\\,HIJ$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}IP\\cdot HJ\n$$\n\nSo, to find $IP,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{HJ}$ and $\\overset{\\to }{HI}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{HJ} & =\\mathbf{j}-\\mathbf{h} \\\\  & =(-2\\mathbf{j}+\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =\\mathbf{i}-4\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,-4,1⟩ \\\\ \\overset{\\to }{HI} & =\\mathbf{i}-\\mathbf{h} \\\\  & =(\\mathbf{i}+\\mathbf{j}+3\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =2\\mathbf{i}-\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,-1,3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HJ}\\times \\overset{\\to }{HI} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & -4 & 1 \\\\ 2 & -1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}-4 & 1 \\\\ -1 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & -4 \\\\ 2 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =((-4)\\cdot 3-1\\cdot (-1))\\mathbf{i}-(1\\cdot 3-1\\cdot 2)\\mathbf{j}+(1\\cdot (-1)-(-4)\\cdot 2)\\mathbf{k} \\\\  & =-11\\mathbf{i}-\\mathbf{j}+7\\mathbf{k} \\\\  & =⟨-11,-1,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{HJ}$ and $\\overset{\\to }{HI}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{HJ}\\times \\overset{\\to }{HI}| \\\\  & =\\sqrt{(-11)^{2}+(-1)^{2}+{7}^{2}} \\\\  & =\\sqrt{171} \\\\  & =3\\sqrt{19}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,HIJ$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{19}}{2}.\n$$\n\nLet's also compute $HJ$ since it appears in the formula:\n\n$$\n\\begin{aligned}HJ & =|\\overset{\\to }{HJ}| \\\\  & =\\sqrt{{1}^{2}+(-4)^{2}+{1}^{2}} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}IP\\cdot HJ,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}IP\\cdot HJ \\\\ \\frac{3\\sqrt{19}}{2} & =\\frac{1}{2}\\,IP\\cdot 3\\sqrt{2} \\\\ \\sqrt{19} & =\\sqrt{2}\\,IP \\\\ IP & =\\frac{\\sqrt{19}}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{38}}{2}.\\end{aligned}\n$$"] [17592186297486 "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =\\mathbf{e}-\\mathbf{d} \\\\  & =(2\\mathbf{i}+\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =3\\mathbf{i}-2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨3,-2,1⟩ \\\\ \\overset{\\to }{DF} & =\\mathbf{f}-\\mathbf{d} \\\\  & =(\\mathbf{i}+3\\mathbf{j}+2\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =2\\mathbf{i}+\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨2,1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & -2 & 1 \\\\ 2 & 1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ 1 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & 1 \\\\ 2 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & -2 \\\\ 2 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot 2-1\\cdot 1)\\mathbf{i}-(3\\cdot 2-2\\cdot 1)\\mathbf{j}+(3\\cdot 1-(-2)\\cdot 2)\\mathbf{k} \\\\  & =-5\\mathbf{i}-4\\mathbf{j}+7\\mathbf{k} \\\\  & =⟨-5,-4,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{(-5)^{2}+(-4)^{2}+{7}^{2}} \\\\  & =\\sqrt{90} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$"] [17592186297487 "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(3\\mathbf{i}+2\\mathbf{j})-(\\mathbf{i}-\\mathbf{k}) \\\\  & =2\\mathbf{i}+2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨2,2,1⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(\\mathbf{j}+3\\mathbf{k})-(\\mathbf{i}-\\mathbf{k}) \\\\  & =-\\mathbf{i}+\\mathbf{j}+4\\mathbf{k} \\\\  & =⟨-1,1,4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 2 & 1 \\\\ -1 & 1 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ 1 & 4\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 1 \\\\ -1 & 4\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 2 \\\\ -1 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot 4-1\\cdot 1)\\mathbf{i}-(2\\cdot 4-(-1)\\cdot 1)\\mathbf{j}+(2\\cdot 1-2\\cdot (-1))\\mathbf{k} \\\\  & =7\\mathbf{i}-9\\mathbf{j}+4\\mathbf{k} \\\\  & =⟨7,-9,4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{7}^{2}+(-9)^{2}+{4}^{2}} \\\\  & =\\sqrt{146}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{146}}{2}.\n$$"] [17592186297489 "First, we find the vectors $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{ST} & =\\mathbf{t}-\\mathbf{s} \\\\  & =(2\\mathbf{i}+3\\mathbf{j}+\\mathbf{k})-(\\mathbf{j}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+2\\mathbf{j}-\\mathbf{k} \\\\  & =⟨2,2,-1⟩ \\\\ \\overset{\\to }{SU} & =\\mathbf{u}-\\mathbf{s} \\\\  & =(4\\mathbf{i}+\\mathbf{j}+2\\mathbf{k})-(\\mathbf{j}+2\\mathbf{k}) \\\\  & =4\\mathbf{i}+0\\mathbf{j}+0\\mathbf{k} \\\\  & =⟨4,0,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{ST}\\times \\overset{\\to }{SU} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 2 & -1 \\\\ 4 & 0 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -1 \\\\ 0 & 0\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -1 \\\\ 4 & 0\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 2 \\\\ 4 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot 0-(-1)\\cdot 0)\\mathbf{i}-(2\\cdot 0-(-1)\\cdot 4)\\mathbf{j}+(2\\cdot 0-2\\cdot 4)\\mathbf{k} \\\\  & =0\\mathbf{i}-4\\mathbf{j}-8\\mathbf{k} \\\\  & =⟨0,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{ST}\\times \\overset{\\to }{SU}| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,STU$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{4\\sqrt{5}}{2}=2\\sqrt{5}.\n$$"] [17592186297491 "Note that the length of the altitude $CK$ can be related to the area of $△\\,ABC$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}CK\\cdot AB\n$$\n\nSo, to find $CK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(4\\mathbf{i}+2\\mathbf{j}+\\mathbf{k})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =3\\mathbf{i}+2\\mathbf{j}+0\\mathbf{k} \\\\  & =⟨3,2,0⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(2\\mathbf{i}+3\\mathbf{j}+2\\mathbf{k})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =\\mathbf{i}+3\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,3,1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & 2 & 0 \\\\ 1 & 3 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 0 \\\\ 3 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & 0 \\\\ 1 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & 2 \\\\ 1 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot 1-0\\cdot 3)\\mathbf{i}-(3\\cdot 1-0\\cdot 1)\\mathbf{j}+(3\\cdot 3-2\\cdot 1)\\mathbf{k} \\\\  & =2\\mathbf{i}-3\\mathbf{j}+7\\mathbf{k} \\\\  & =⟨2,-3,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{2}^{2}+(-3)^{2}+{7}^{2}} \\\\  & =\\sqrt{62}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{62}}{2}.\n$$\n\nLet's also compute $AB$ since it appears in the formula:\n\n$$\n\\begin{aligned}AB & =|\\overset{\\to }{AB}| \\\\  & =\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{13}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}CK\\cdot AB,$ we get\n\n$$\n\\begin{aligned}\\frac{\\sqrt{62}}{2} & =\\frac{1}{2}CK\\cdot \\sqrt{13} \\\\ CK & =\\frac{\\sqrt{62}}{\\sqrt{13}} \\\\ CK & =\\frac{\\sqrt{806}}{13}.\\end{aligned}\n$$"] [17592186297492 "Note that the length of the altitude $HK$ can be related to the area of $△\\,GHI$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}HK\\cdot GI\n$$\n\nSo, to find $HK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{GI} & =\\mathbf{i}-\\mathbf{g} \\\\  & =(2\\mathbf{i}+4\\mathbf{j}+2\\mathbf{k})-(\\mathbf{i}+\\mathbf{j}+\\mathbf{k}) \\\\  & =\\mathbf{i}+3\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,3,1⟩ \\\\ \\overset{\\to }{GH} & =\\mathbf{h}-\\mathbf{g} \\\\  & =(3\\mathbf{i}+2\\mathbf{j}+4\\mathbf{k})-(\\mathbf{i}+\\mathbf{j}+\\mathbf{k}) \\\\  & =2\\mathbf{i}+\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,1,3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{GI}\\times \\overset{\\to }{GH} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 3 & 1 \\\\ 2 & 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 1 \\\\ 1 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 3 \\\\ 2 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot 3-1\\cdot 1)\\mathbf{i}-(1\\cdot 3-1\\cdot 2)\\mathbf{j}+(1\\cdot 1-3\\cdot 2)\\mathbf{k} \\\\  & =8\\mathbf{i}-\\mathbf{j}-5\\mathbf{k} \\\\  & =⟨8,-1,-5⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{GI}\\times \\overset{\\to }{GH}| \\\\  & =\\sqrt{{8}^{2}+(-1)^{2}+(-5)^{2}} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,GHI$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$\n\nLet's also compute $GI$ since it appears in the formula:\n\n$$\n\\begin{aligned}GI & =|\\overset{\\to }{GI}| \\\\  & =\\sqrt{{1}^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}HK\\cdot GI,$ we get\n\n$$\n\\begin{aligned}\\frac{3\\sqrt{10}}{2} & =\\frac{1}{2}HK\\cdot \\sqrt{11} \\\\ HK & =\\frac{3\\sqrt{10}}{\\sqrt{11}} \\\\ HK & =\\frac{3\\sqrt{110}}{11}.\\end{aligned}\n$$"]}
