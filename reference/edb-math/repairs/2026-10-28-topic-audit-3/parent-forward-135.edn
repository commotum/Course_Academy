#{[{:db/id #edb/ref 17592186601892 :multistep/context "A particle $P$ is moving along a curve in an $xy$-plane such that the $x$-coordinate of $P$ is given by\n\n$$\nx(t)=\\frac{3t}{({t}^{2}+1)^{3}},\\,t>0\n$$\n\nwhere $x$ is the distance of $P$ from the origin, measured in meters, and $t$ is measured in seconds." :multistep/id #uuid "a3bb6abd-7c7c-5aed-acb5-3ed09c221aa1" :multistep/steps [{:db/id #edb/ref 17592186601971 :step/content {:db/id #edb/ref 17592186601949}} {:db/id #edb/ref 17592186601972 :step/content {:db/id #edb/ref 17592186601935}} {:db/id #edb/ref 17592186601973 :step/content {:db/id #edb/ref 17592186601914}} {:db/id #edb/ref 17592186601974 :step/content {:db/id #edb/ref 17592186601923}} {:db/id #edb/ref 17592186602002 :step/content {:db/id #edb/ref 17592186601918}} {:db/id #edb/ref 17592186602003 :step/content {:db/id #edb/ref 17592186601919}} {:db/id #edb/ref 17592186602014 :step/content {:db/id #edb/ref 17592186601905}} {:db/id #edb/ref 17592186602022 :step/content {:db/id #edb/ref 17592186601926}} {:db/id #edb/ref 17592186602024 :step/content {:db/id #edb/ref 17592186601929}} {:db/id #edb/ref 17592186602026 :step/content {:db/id #edb/ref 17592186601927}}]}] [{:db/id #edb/ref 17592186602395 :multistep/context "Consider the cubic function $f(x)=2-{x}^{3}.$" :multistep/id #uuid "f4b3ac11-c452-546b-8fc8-7b6c612e9e53" :multistep/steps [{:db/id #edb/ref 17592186602473 :step/content {:db/id #edb/ref 17592186602410}} {:db/id #edb/ref 17592186602488 :step/content {:db/id #edb/ref 17592186602422}} {:db/id #edb/ref 17592186602497 :step/content {:db/id #edb/ref 17592186602437}} {:db/id #edb/ref 17592186602518 :step/content {:db/id #edb/ref 17592186602457}} {:db/id #edb/ref 17592186602519 :step/content {:db/id #edb/ref 17592186602406}} {:db/id #edb/ref 17592186602522 :step/content {:db/id #edb/ref 17592186602452}} {:db/id #edb/ref 17592186602534 :step/content {:db/id #edb/ref 17592186602441}} {:db/id #edb/ref 17592186602536 :step/content {:db/id #edb/ref 1759