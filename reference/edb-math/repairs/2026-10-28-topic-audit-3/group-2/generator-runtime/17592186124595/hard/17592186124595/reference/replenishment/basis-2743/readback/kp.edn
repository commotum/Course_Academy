hen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =(\\operatorname{sin}⁡2\\theta )\\operatorname{cos}⁡\\theta -\\frac{1}{r}(2r\\operatorname{cos}⁡2\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡2\\theta \\operatorname{cos}⁡\\theta -2\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡\\theta ({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =2\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta -2\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +2{sin}^{3}⁡\\theta  \\\\  & =2{sin}^{3}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07a1ee6a-caac-58ee-afb5-38bc8bb1ed51" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡2\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186357819} {:answer/id #uuid "2228fe89-b437-5a7a-aa61-67383a3bc1cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358049} {:answer/id #uuid "2486a9ac-6c70-5c04-9668-5c8f9093b469" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186358077} {:answer/id #uuid "c28adbb2-a46a-5fcd-bc0c-7c33f8291c40" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta (\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta )" :db/id #edb/ref 17592186359459} {:answer/id #uuid "cc4bc83b-09f3-5b22-b701-0b449bf034fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡2\\theta (\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta )" :db/id #edb/ref 17592186359545}] :answer-field/correct {:answer/id #uuid "2228fe89-b437-5a7a-aa