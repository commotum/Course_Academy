eta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂y} & =(1+\\operatorname{cos}⁡2\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(-2r\\operatorname{sin}⁡2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17a74912-9939-5160-b2f2-fc9f75995b79" :answer/type {:db/ident :answer.type/math} :answer/value "r\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478590} {:answer/id #uuid "489fb4e2-401a-51bd-8367-54c21281a25c" :answer/type {:db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478661} {:answer/id #uuid "af934f8e-6b47-50f3-976d-130962164ab7" :answer/type {:db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta +2" :db/id #edb/ref 17592186478844} {:answer/id #uuid "d704c90e-1c68-5f35-9050-f1ea9764f3d9" :answer/type {:db/ident :answer.type/math} :answer/value "{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡(2\\theta ))" :db/id #edb/ref 17592186478900} {:answer/id #uuid "f8d81125-ee3b-5e23-ba6b-3f5a3fc654e1" :answer/type {:db/ident :answer.type/math} :answer/value "r(\\operatorname{cos}⁡\\theta +1)" :db/id #edb/ref 17592186478949}] :answer-field/correct {:answer/id #uuid "af934f8e-6b47-50f3-976d-130962164ab7" :answer/type {:db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta +2" :db/id #edb/ref 17592186478844} :answer-field/id #uuid "77f83ac4-379e-5a13-8c4c-6ea313e7d773" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479004}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4437c604-b7f0-5633-b7e5-9971f03bd2b2" :question/math-academy-id "q-165283" :question/problem "Given that $v(r,\\theta )={r}^{2}+2r\\operatorname{cos}⁡\\theta ,$ find $\\frac{∂v}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂v}{∂x}=\\frac{∂v}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂v}{∂\\theta }\\operatorname{sin}⁡\\theta \n$$\n\nFirst, we find the partial derivatives of $v$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂v}{∂r}=2r+2\\operatorname{cos}⁡\\theta ,\\,\\frac{∂v}{∂\\theta }=-2r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂x} & =(2r+2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-2r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta +2{cos}^{2}⁡\\theta +2{sin}^{2}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta +2({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =2r\\operatorname{cos}⁡\\theta +2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d25be9-c593-5605-a401-5d2bd749db79" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478585} {:answer/id #uuid "7368bb2b-738b-5553-9b24-d72d10f86673" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478728} {:answer/id #uuid "84dcc6f3-d690-5f72-8730-48a6a222d69f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478763} {:answer/id #uuid "952ab814-3b74-5511-bb1b-17a92c942267" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478803} {:answer/id #uuid "e73b53e8-31b8-587a-95b0-e9d5813a7d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478918}] :answer-field/correct {:answer/id #uuid "7368bb2b-738b-5553-9b24-d72d10f86673" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478728} :answer-field/id #uuid "1bff08b3-d2ad-542d-9f8a-a1ea880775f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478967}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88d1b83b-2766-5063-936f-a018502be867" :question/math-academy-id "q-95137" :question/problem "Given that $h(r,\\theta )=r(\\operatorname{cos}⁡\\theta -1),$ find $\\frac{∂h}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂h}{∂x}=\\frac{∂h}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂h}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r}=\\operatorname{cos}⁡\\theta -1,\\,\\frac{∂h}{∂\\theta }=-r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =(\\operatorname{cos}⁡\\theta -1)\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta -\\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1-\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0ce7d1-e3eb-5abe-aad3-5ec2e74afb0a" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 r (\\cos {4 \\theta} - 2) \\sin {\\theta} + 4 r \\sin {4 \\theta} \\cos {\\theta}" :db/id #edb/ref 17592186562599} {:answer/id #uuid "4512ed8c-3ede-5a65-9f8f-a810c42e748e" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 r^{2} \\sin {\\theta} \\sin {4 \\theta} - 2 r (\\cos {4 \\theta} - 2) \\cos {\\theta}" :db/id #edb/ref 17592186562619} {:answer/id #uuid "5674929d-a824-55f0-8f30-82e8e0ca48d8" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 r \\sin {\\theta} \\sin {4 \\theta} - 2 r \\cos {\\theta} \\cos {4 \\theta} + 4 r \\cos {\\theta}" :db/id #edb/ref 17592186562623} {:answer/id #uuid "801a07f3-db90-5408-b255-c06f0a469d9b" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 r (\\cos {4 \\theta} - 2) \\cos {\\theta} + 4 r \\sin {\\theta} \\sin {4 \\theta}" :db/id #edb/ref 17592186562638} {:answer/id #uuid "e3a57294-efde-52ac-930c-bfb39691209d" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 r (\\cos {4 \\theta} - 2) \\cos {\\theta}" :db/id #edb/ref 17592186562657}] :answer-field/correct {:answer/id #uuid "5674929d-a824-55f0-8f30-82e8e0ca48d8" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 r \\sin {\\theta} \\sin {4 \\theta} - 2 r \\cos {\\theta} \\cos {4 \\theta} + 4 r \\cos {\\theta}" :db/id #edb/ref 17592186562623} :answer-field/id #uuid "e8ad19b3-da03-5387-b18b-48205b99fd19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562660}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0480635c-deef-558b-bf50-7e4a5cabfaac" :question/problem "Given that $f(r,\\theta)=- r^{2} (\\cos {4 \\theta} - 2)$, find $\\frac{∂f}{∂x}$, where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂f}{∂x}=\\frac{∂f}{∂r}\\cos \\theta-\\frac{1}{r}\\frac{∂f}{∂\\theta}\\sin \\theta.\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $r$ and $\\theta:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂r}=- 2 r (\\cos {4 \\theta} - 2),\\,\\frac{∂f}{∂\\theta}=4 r^{2} \\sin {4 \\theta}\\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =(- 2 r (\\cos {4 \\theta} - 2))\\cos \\theta-\\frac{1}{r}(4 r^{2} \\sin {4 \\theta})\\sin \\theta \\\\ & =4r\\cos \\theta-2r\\cos 4\\theta\\cos \\theta-4r\\sin 4\\theta\\sin \\theta \\\\ & =-r(-4\\cos \\theta+2\\cos 4\\theta\\cos \\theta+4\\sin 4\\theta\\sin \\theta).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c911de-2d6d-5671-a74c-00fc4aa3eaa0" :answer/type {:db/ident :answer.type/math} :answer/value "9 r^{2} (\\cos {4 \\theta} - 2) \\cos {\\theta} - 12 r^{2} \\sin {\\theta} \\sin {4 \\theta}" :db/id #edb/ref 17592186562596} {:answer/id #uuid "15bd4d04-bdf1-5558-a9ff-1200e8ee4d87" :answer/type {:db/ident :answer.type/math} :answer/value "12 r^{2} \\sin {\\theta} \\sin {4 \\theta} + 9 r^{2} \\cos {\\theta} \\cos {4 \\theta} - 18 r^{2} \\cos {\\theta}" :db/id #edb/ref 17592186562602} {:answer/id #uuid "82ae2703-474c-555b-8fed-031abab6f1e2" :answer/type {:db/ident :answer.type/math} :answer/value "9 r^{2} (\\cos {4 \\theta} - 2) \\cos {\\theta}" :db/id #edb/ref 17592186562639} {:answer/id #uuid "8cc92cd3-9036-52d2-ae31-8fda66f83e53" :answer/type {:db/ident :answer.type/math} :answer/value "12 r^{3} \\sin {\\theta} \\sin {4 \\theta} + 9 r^{2} (\\cos {4 \\theta} - 2) \\cos {\\theta}" :db/id #edb/ref 17592186562641} {:answer/id #uuid "e555c1cb-1e86-5a94-9ce2-1f56b2365ca2" :answer/type {:db/ident :answer.type/math} :answer/value "9 r^{2} (\\cos {4 \\theta} - 2) \\sin {\\theta} - 12 r^{2} \\sin {4 \\theta} \\cos {\\theta}" :db/id #edb/ref 17592186562659}] :answer-field/correct {:answer/id #uuid "15bd4d04-bdf1-5558-a9ff-1200e8ee4d87" :answer/type {:db/ident :answer.type/math} :answer/value "12 r^{2} \\sin {\\theta} \\sin {4 \\theta} + 9 r^{2} \\cos {\\theta} \\cos {4 \\theta} - 18 r^{2} \\cos {\\theta}" :db/id #edb/ref 17592186562602} :answer-field/id #uuid "6131ed53-674d-503a-b389-9b68504af064" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562625}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "085cc759-0d83-5d50-ae74-d1cf9642efc4" :question/problem "Given that $u(r,\\theta)=3 r^{3} (\\cos {4 \\theta} - 2)$, find $\\frac{∂u}{∂x}$, where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂u}{∂x}=\\frac{∂u}{∂r}\\cos \\theta-\\frac{1}{r}\\frac{∂u}{∂\\theta}\\sin \\theta.\n$$\n\nFirst, we find the partial derivatives of $u$ with respect to $r$ and $\\theta:$\n\n$$\n\\begin{aligned}\\frac{∂u}{∂r}=9 r^{2} (\\cos {4 \\theta} - 2),\\,\\frac{∂u}{∂\\theta}=- 12 r^{3} \\sin {4 \\theta}\\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =(9 r^{2} (\\cos {4 \\theta} - 2))\\cos \\theta-\\frac{1}{r}(- 12 r^{3} \\sin {4 \\theta})\\sin \\theta \\\\ & =-18{r}^{2}\\cos \\theta+9{r}^{2}\\cos 4\\theta\\cos \\theta+12{r}^{2}\\sin 4\\theta\\sin \\theta \\\\ & =3{r}^{2}(-6\\cos \\theta+3\\cos 4\\theta\\cos \\theta+4\\sin 4\\theta\\sin \\theta).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f840b5-46c8-591e-ac05-98c98fc28496" :answer/type {:db/ident :answer.type/math} :answer/value "- 12 r^{2} \\sin {\\theta}" :db/id #edb/ref 17592186562612} {:answer/id #uuid "3826bc4e-b3a2-5171-b9c0-48a0a14a2bdd" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 r^{2} \\cos {\\theta}" :db/id #edb/ref 17592186562617} {:answer/id #uuid "727c8ffa-e