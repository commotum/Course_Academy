e{sin}⁡(4t)\\,i+2\\sqrt{t}\\operatorname{sin}⁡(4t)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{t})\\,i+\\frac{\\text{d}}{\\text{d}t}(-2\\sqrt{t})\\,j \\\\  & =\\frac{1}{\\sqrt{t}}\\,i+(-\\frac{1}{\\sqrt{t}})j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(-2\\sqrt{t}\\operatorname{sin}⁡(4t)\\,i+2\\sqrt{t}\\operatorname{sin}⁡(4t)\\,j)\\cdot (\\frac{1}{\\sqrt{t}}\\,i+(-\\frac{1}{\\sqrt{t}})i) \\\\  & =(-2\\sqrt{t}\\operatorname{sin}⁡(4t))\\cdot \\frac{1}{\\sqrt{t}}+2\\sqrt{t}\\operatorname{sin}⁡(4t)\\cdot (-\\frac{1}{\\sqrt{t}}) \\\\  & =-2\\operatorname{sin}⁡(4t)-2\\operatorname{sin}⁡(4t) \\\\  & =-4\\operatorname{sin}⁡(4t).\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi }{8},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\frac{\\pi }{8}))] & =-4\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{8}) \\\\  & =-4\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186445677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ab9250-28af-5908-8d6f-09833d521f51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186445643} {:answer/id #uuid "67d5968e-4c9e-5d9b-9b55-ddaa5793f241" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445655} {:answer/id #uuid "bd8e760c-2dd0-5dcf-8836-3c5e2deced71" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186445664} {:answer/id #uuid "cc6cc197-cc16-54f4-b4ca-9fa9bd9e20c8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186445666} {:answer/id #uuid "de9daefe-3ccb-54d5-9516-f29765d78d78" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186445668}] :answer-field/correct {:answer/id #uuid "67d5968e-4c9e-5d9b-9b55-ddaa5793f241" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445655} :answer-field/id #uuid "da5c7c2a-000b-5483-8ada-2cf63e301ba8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "021b7b63-3816-5a7a-9f77-baf36bf193bb" :question/math-academy-id "q-65864" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\frac{\\pi }{4}$ given that $∇f(x,y)=\\frac{2x}{{x}^{2}+{y}^{2}}\\,i+\\frac{2y}{{x}^{2}+{y}^{2}}\\,j$ and $r(t)=\\operatorname{sin}⁡t\\text{ }i+\\operatorname{cos}⁡t\\text{ }j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\frac{2x}{{x}^{2}+{y}^{2}}\\,i+\\frac{2y}{{x}^{2}+{y}^{2}}\\,j.\n$$\n\nFirst, we substitute $x=\\operatorname{sin}⁡t$ and $y=\\operatorname{cos}⁡t$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{2\\operatorname{sin}⁡t}{{sin}^{2}⁡t+{cos}^{2}⁡t}\\,i+\\frac{2\\operatorname{cos}⁡t}{{sin}^{2}⁡t+{cos}^{2}⁡t}\\,j \\\\  & =2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j \\\\  & =\\operatorname{cos}⁡t\\,i+(-\\operatorname{sin}⁡t)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j)\\cdot (\\operatorname{cos}⁡t\\,i+(-\\operatorname{sin}⁡t)\\,j) \\\\  & =2\\operatorname{sin}⁡t\\cdot \\operatorname{cos}⁡t+2\\operatorname{cos}⁡t\\cdot (-\\operatorname{sin}⁡t) \\\\  & =2\\operatorname{sin}⁡t\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =0.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi }{4},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\frac{\\pi }{4}))] & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1600e78f-067b-5159-9df5-0a07460bd35e" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-1}+3" :db/id #edb/ref 17592186479394} {:answer/id #uuid "4783f08a-d1dc-5e36-a5c3-01e18e5e73b1" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186479463} {:answer/id #uuid "5983345c-db95-5ace-9463-67aa96a3fe71" :answer/type {:db/ident :answer.type/math} :answer/value "4e+7" :db/id #edb/ref 17592186479485} {:answer/id #uuid "6acc7f99-e086-5514-b8e6-83a4c9ef8720" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186479518} {:answer/id #uuid "97ef8f60-6130-5ffd-8c09-836902b3e0e3" :answer/type {:db/ident :answer.type/math} :answer/value "3-2{e}^{-1}" :db/id #edb/ref 17592186479590}] :answer-field/correct {:answer/id #uuid "4783f08a-d1dc-5e36-a5c3-01e18e5e73b1" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186479463} :answer-field/id #uuid "35243cd2-2483-5ad0-842a-67891f04a244" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479761}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ccfc773-296b-50db-8da8-c0588c64c45e" :question/math-academy-id "q-94871" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=-1$ given that $∇f(x,y)=y{e}^{xy}\\,i+(x{e}^{xy}+2y)\\,j$ and $r(t)=(t+1)\\,i+(t-1)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=y{e}^{xy}\\,i+(x{e}^{xy}+2y)\\,j.\n$$\n\nFirst, we substitute $x=t+1$ and $y=t-1$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(t-1){e}^{(t+1)(t-1)}\\,i+((t+1){e}^{(t+1)(t-1)}+2(t-1))\\,j \\\\  & =(t-1){e}^{{t}^{2}-1}\\,i+((t+1){e}^{{t}^{2}-1}+2t-2)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(t-1)\\,j \\\\  & =i+j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((t-1){e}^{{t}^{2}-1}\\,i+((t+1){e}^{{t}^{2}-1}+2t-2)\\,j)\\cdot (i+j) \\\\  & =(t-1){e}^{{t}^{2}-1}\\cdot 1+((t+1){e}^{{t}^{2}-1}+2t-2)\\cdot 1 \\\\  & =(t-1){e}^{{t}^{2}-1}+(t+1){e}^{{t}^{2}-1}+2t-2 \\\\  & =2t{e}^{{t}^{2}-1}+2t-2.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=-1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(-1))] & =2(-1){e}^{(-1)^{2}-1}+2(-1)-2 \\\\  & =-2-2-2 \\\\  & =-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10678e1e-886a-5a4e-b7c2-d43590d9da42" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186479384} {:answer/id #uuid "3bf77277-da5c-508b-b19f-23412ad069a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186479447} {:answer/id #uuid "3c735127-556e-521a-a97e-a560cb0e5a28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{2}-1" :db/id #edb/ref 17592186479448} {:answer/id #uuid "5a40eb2d-45dd-5e4f-bfc4-ce7f311e8219" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186479487} {:answer/id #uuid "5d6b668e-9dfd-55fa-bd2b-afca9acc2e9a" 