z}(2 x - 3 y + 2 z)\\,k \\\\  & =(2)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(2 t)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((2)\\,i+(-3)\\,j+(2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(2 t)\\,k) \\\\  & =(2)\\cdot (1)+(-3)\\cdot (2 t)+(2)\\cdot (2 t) \\\\  & =(2)+(- 6 t)+(4 t) \\\\  & =2 \\left(1 - t\\right).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["4ea5389a-261a-518e-b827-bc0fb8107846"] :db/ensure :question/validate} {:db/id "7ad1d7fe-61c1-5328-9f74-34705da6c672" :answer/id #uuid "7ad1d7fe-61c1-5328-9f74-34705da6c672" :answer/type :answer.type/math :answer/value "- (4 t + 3)" :db/ensure :answer/validate} {:db/id "69f314a2-61a8-53f2-b0ac-eb90c1a11c54" :answer/id #uuid "69f314a2-61a8-53f2-b0ac-eb90c1a11c54" :answer/type :answer.type/math :answer/value "- (10 t + 3)" :db/ensure :answer/validate} {:db/id "2f8edcc7-83f3-51eb-a02a-f98f35085a9e" :answer/id #uuid "2f8edcc7-83f3-51eb-a02a-f98f35085a9e" :answer/type :answer.type/math :answer/value "- 10 t" :db/ensure :answer/validate} {:db/id "7a0b14be-60a6-545a-ac09-803a1de56af5" :answer/id #uuid "7a0b14be-60a6-545a-ac09-803a1de56af5" :answer/type :answer.type/math :answer/value "- 3 \\left(2 t + 1\\right)" :db/ensure :answer/validate} {:db/id "99bcbeaa-ab4e-516c-bbf9-8ff846ba257b" :answer/id #uuid "99bcbeaa-ab4e-516c-bbf9-8ff846ba257b" :answer/type :answer.type/math :answer/value "- t \\left(5 t + 3\\right)" :db/ensure :answer/validate} {:db/id "5c278396-ed1e-50e