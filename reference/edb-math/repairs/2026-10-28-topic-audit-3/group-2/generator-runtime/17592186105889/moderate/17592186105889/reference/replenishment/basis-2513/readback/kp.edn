{∂x}=\\frac{∂}{∂x}(-{x}^{2}+2{y}^{2})=-2x,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(-{x}^{2}+2{y}^{2})=4y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(-2x)}^{2}+{(4y)}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,{x}^{2}(-{x}^{2}+2{y}^{2})^{2}\\sqrt{1+4{x}^{2}+16{y}^{2}}\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}\\,({x}^{6}-4{y}^{2}{x}^{4}+4{y}^{4}{x}^{2})\\sqrt{1+4{x}^{2}+16{y}^{2}}\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401226 :knowledge-point/_questions [{:knowledge-point/id #uuid "8885504f-07fb-5308-a982-608d7baa262b" :knowledge-point/title "Express Surface Integrals as Repeated Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed482a3a-a562-53c9-9952-b7f4ae64a9f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}(-{x}^{3}+{x}^{2}{y}^{3})" :db/id #edb/ref 17592186401228} {:answer/id #uuid "292ba469-4e9c-5812-b40c-813e27620124" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3y}(-{x}^{2}y-{x}^{2}{y}^{2})" :db/id #edb/ref 17592186401229} {:answer/id #uuid "1139e147-84fe-5bb5-a30a-874f5c401de8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}(-{x}^{2}y-{x}^{2}y)" :db/id #edb/ref 17592186401230} {:answer/id #uuid "25a694b0-85e4-50a9-9c0d-fb4f6db18268" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}(-{x}^{3}y+{x}^{2}{y}^{2})" :db/id #edb/ref 17592186401231} {:answer/id #uuid "60287cb2-73a4-5d70-9afa-49321e3ddf3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3x}({x}^{3}y+{x}^{2}{y}^{2})" :db/id #edb/ref 17592186401232}] :answer-field/correct {:answer/id #uuid "25a694b0-85e4-50a9-9c0d-fb4f6db18268" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}(-{x}^{3}y+{x}^{2}{y}^{2})" :db/id #edb/re