qrt{3}}\\,\\mathrm{d}A \\\\ & =(\\sqrt{3})\\iint_D{y}\\,\\mathrm{d}A.\\end{aligned}\n$$\n\nNotice that in polar coordinates $(r,\\theta),$ our domain can be expressed as\n\n$$\\Delta=\\{(r,\\theta):0\\le r\\le 2,\\ 0\\le\\theta\\le \\frac{\\pi}{2}\\}.$$\n\nTherefore, using the change of variables formula for polar coordinates, where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we obtain\n\n$$\n\\begin{aligned}(\\sqrt{3})\\iint_D{y}\\,\\mathrm{d}A & =(\\sqrt{3})\\iint_\\Delta{f(r\\cos\\theta,r\\sin\\theta)\\cdot r}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\iint_\\Delta{((r\\sin\\theta))\\cdot r}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\iint_\\Delta{r^{2} \\sin{\\left(\\theta \\right)}}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{0}^{\\frac{\\pi}{2}}{(\\sin{\\left(\\theta \\right)})\\int_{0}^{2}{r^{2}}\\,\\mathrm{d}r}\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{0}^{\\frac{\\pi}{2}}{(\\sin{\\left(\\theta \\right)})\\left[\\frac{r^{3}}{3}\\right]_{0}^{2}}\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{0}^{\\frac{\\pi}{2}}{(\\sin{\\left(\\theta \\right)})\\left[((\\frac{8}{3}))-((0))\\right]}\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{0}^{\\frac{\\pi}{2}}{\\frac{8 \\sin{\\left(\\theta \\right)}}{3}}\\,\\mathrm{d}\\theta \\\\ & =(\\frac{8 \\sqrt{3}}{3})\\left[- \\cos{\\left(\\theta \\right)}\\right]_{0}^{\\frac{\\pi}{2}} \\\\ & =(\\frac{8 \\sqrt{3}}{3})\\left[((0))-((-1))\\right] \\\\ & =(\\frac{8 \\sqrt{3}}{3})\\cdot((0)-(-1)) \\\\ & =\\frac{8 \\sqrt{3}}{3}.\\end{aligned}\n$$\n\nTherefore, the surface integral is $\\frac{8 \\sqrt{3}}{3}$." :question/difficulty :question.difficulty/moderate :question/answer-fields ["bb9f6651-4921-50c2-a3b2-e6a39b3ee3ee"] :db/ensure :question/validate} {:db/id "62f81263-c580-52d1-90e1-7fa8854069df" :answer/id #uuid "62f81263-c580-52d1-90e1-7fa8854069df" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure :answer/validate} {:db/id "cbe3dcf5-5100-544e-ae55-56e98c4a35fd" :