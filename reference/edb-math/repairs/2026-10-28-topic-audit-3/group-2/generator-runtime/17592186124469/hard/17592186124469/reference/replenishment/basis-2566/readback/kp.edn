eft(3 t \\right)} + 1\\right) \\left(2 e^{4 t} \\sin^{2}{\\left(3 t \\right)} + 2 e^{2 t} \\sin{\\left(3 t \\right)} + 1\\right)}" :db/id #edb/ref 17592186536145} :answer-field/id #uuid "18ed12c2-f057-5824-bd7e-43c4cfaca9a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536108}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5a59dfd2-3508-59f4-99f3-603cc9ac3e42" :question/problem "If $f(x,y)=\\operatorname{arctan}⁡(2x{y}^{2})$ and $r(t)={e}^{4t}\\,i+\\operatorname{sin}⁡3t\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(2x{y}^{2}))\\,i+\\frac{∂}{∂y}(\\operatorname{arctan}⁡(2x{y}^{2}))\\,j \\\\  & =\\frac{2(1{y}^{2}+x2y\\cdot 0)}{1+4{x}^{2}{y}^{4}}\\,i+\\frac{2(0{y}^{2}+x2y\\cdot 1)}{1+4{x}^{2}{y}^{4}}\\,j \\\\  & =\\frac{2{y}^{2}}{1+4{x}^{2}{y}^{4}}\\,i+\\frac{4xy}{1+4{x}^{2}{y}^{4}}\\,j\\end{aligned}\n$$\n\nNext, we substitute $x={e}^{4t}$ and $y=\\operatorname{sin}⁡3t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{2(\\operatorname{sin}⁡3t)^{2}}{1+4({e}^{4t})^{2}(\\operatorname{sin}⁡3t)^{4}}\\,i+\\frac{4({e}^{4t})(\\operatorname{sin}⁡3t)}{1+4({e}^{4t})^{2}(\\operatorname{sin}⁡3t)^{4}}\\,j \\\\  & =\\frac{2\\sin^{2}⁡3t}{1+4{e}^{8t}\\sin^{4}⁡3t}\\,i+\\frac{4{e}^{4t}\\operatorname{sin}⁡3t}{1+4{e}^{8t}\\sin^{4}⁡3t}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{4t})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡3t)\\,j \\\\  & =4{e}^{4t}\\,i+3\\operatorname{cos}⁡3t\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{2\\sin^{2}⁡3t}{1+4{e}^{8t}\\sin^{4}⁡3t}\\,i+\\frac{4{e}^{4t}\\operatorname{sin}⁡3t}{1+4{e}^{8t}\\sin^{4}⁡3t}\\,j)\\cdot (4{e}^{4t}\\,i+3\\operatorname{cos}⁡3t\\,j) \\\\  & =\\frac{8{e}^{4t}\\sin^{2}⁡3t}{1+4{e}^{8t}\\sin^{4}⁡3t}+\\frac{12{e}^{4t}\\operatorname{sin}⁡3t\\operatorname{cos}⁡3t}{1+4{e}^{8t}\\sin^{4}⁡3t} \\\\  & =\\frac{2{e}^{4t}(4\\sin^{2}⁡3t+6\\operatorname{sin}⁡3t\\operatorname{cos}⁡3t)}{1+4{e}^{8t}\\sin^{4}⁡3t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536134 :knowledge-point/_questions [{:knowledge-point/id #uuid "0096e314-e53e-5d9b-9cee-fe34fa3a6379" :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ad3c34-7920-5a0f-aa67-8bf1dce8f6d1" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{18 t e^{2 t} \\ln{\\left(t \\right)} - 9 e^{2 t} - 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536107} {:answer/id #uuid "42690b01-2e49-5771-869f-15c475b0958c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18 t e^{2 t} \\ln{\\left(t \\right)} + 9 e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536118} {:answer/id #uuid "4609bfb4-e0ca-56b1-8aa9-80620eea6074" :answer/type {:db/ident :answer.type/math} :answer/value "9 e^{2 t} + 6 e^{t} \\ln{\\left(t \\right)} + 2 \\ln{\\left(t \\right)}" :db/id #edb/ref 17592186536120} {:answer/id #uuid "52f917e4-2460-586b-a26e-61222e1b7ec4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\left(9 t e^{2 t} + 2 t \\ln{\\left(t \\right)} + 2 \\ln{\\left(t \\right)}\\right) e^{t}}{t}" :db/id #edb/ref 17592186536126} {:answer/id #uuid "b7d46d3a-bccb-523d-885d-4d3c7e6255a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536157}] :answer-field/correct {:answer/id #uuid "42690b01-2e49-5771-869f-15c475b0958c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18 t e^{2 t} \\ln{\\left(t \\right)} + 9 e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536118} :answer-field/id #uuid "66b25e82-59b6-5991-9378-8d3bf44fdfe9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "699d81bf-486b-5fcd-891b-b8329a36d705" :question/problem "If $f(x,y)=x^{2} + x y^{2}$ and $r(t)=\\ln{\\left(t \\right)}\\,i+3 e^{t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x^{2} + x y^{2})\\,i+\\frac{∂}{∂y}(x^{2} + x y^{2})\\,j \\\\  & =(2 x + y^{2})\\,i+2 x y\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\ln{\\left(t \\right)}$ and $y=3 e^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2(\\ln{\\left(t \\right)})+(3 e^{t})^{2})\\,i+2(\\ln{\\left(t \\right)})(3 e^{t})\\,j \\\\  & =(9 e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+6 e^{t} \\ln{\\left(t \\right)}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\ln{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(3 e^{t})\\,j \\\\  & =\\frac{1}{t}\\,i+3 e^{t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((9 e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+6 e^{t} \\ln{\\left(t \\right)}\\,j)\\cdot (\\frac{1}{t}\\,i+3 e^{t}\\,j) \\\\  & =((9 e^{2 t} + 2 \\ln{\\left(t \\right)}))(\\frac{1}{t})+(6 e^{t} \\ln{\\left(t \\right)})(3 e^{t}) \\\\  & =\\frac{2 \\ln{\\left(t \\right)}}{t}+\\frac{9 e^{2 t}}{t}+18 e^{2 t} \\ln{\\left(t \\right)} \\\\  & =18 e^{2 t} \\ln{\\left(t \\right)} + \\frac{9 e^{2 t}}{t} + \\frac{2 \\ln{\\left(t \\right)}}{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536143 :knowledge-point/_questions [{:knowledge-point/id #uuid "0096e314-e53e-5d9b-9cee-fe34fa3a6379" :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b2d657-12ba-5244-855a-127cd7306b1a" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\left(6 e^{2 t} + 6 e^{t} \\ln{\\left(t \\right)} + \\ln{\\left(t \\right)}\\right)" :db/id #edb/ref 17592186536100} {:answer/id #uuid "40d0cfbc-c3e0-5010-8a27-3ad659f00932" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(6 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536117} {:answer/id #uuid "a4cbccd4-10a9-5603-9d7c-31e8c4299e45" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 \\left(12 t e^{2 t} \\ln{\\left(t \\right)} - 6 e^{2 t} - \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536152} {:answer/id #uuid "c0a2428f-4efd-534e-b8a5-9d7f8763b84e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(12 t e^{2 t} \\ln{\\left(t \\right)} + 6 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536158} {:answer/id #uuid "dcff26e5-35a3-5a9b-8d7d-385dad335180" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(6 t e^{2 t} + t \\ln{\\left(t \\right)} + 3 \\ln{\\left(t \\right)}\\right) e^{t}}{t}" :db/id #edb/ref 17592186536167}] :answer-field/correct {:answer/id #uuid "c0a2428f-4efd-534e-b8a5-9d7f8763b84e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(12 t e^{2 t} \\ln{\\left(t \\right)} + 6 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536158} :answer-field/id #uuid "07def19c-4051-567c-8664-2166dc149246" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536101}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82600b93-632f-5ad5-9122-0f9e18ec5a13" :question/problem "If $f(x,y)=x^{2} + 3 x y^{2}$ and $r(t)=\\ln{\\left(t \\right)}\\,i+2 e^{t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x^{2} + 3 x y^{2})\\,i+\\frac{∂}{∂y}(x^{2} + 3 x y^{2})\\,j \\\\  & =(2 x + 3 y^{2})\\,i+6 x y\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\ln{\\left(t \\right)}$ and $y=2 e^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2(\\ln{\\left(t \\right)})+3(2 e^{t})^{2})\\,i+6(\\ln{\\left(t \\right)})(2 e^{t})\\,j \\\\  & =(12 e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+12 e^{t} \\ln{\\left(t \\right)}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\ln{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(2 e^{t})\\,j \\\\  & =\\frac{1}{t}\\,i+2 e^{t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((12 e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+12 e^{t} \\ln{\\left(t \\right)}\\,j)\\cdot (\\frac{1}{t}\\,i+2 e^{t}\\,j) \\\\  & =((12 e^{2 t} + 2 \\ln{\\left(t \\right)}))(\\frac{1}{t})+(12 e^{t} \\ln{\\left(t \\right)})(2 e^{t}) \\\\  & =\\frac{2 \\ln{\\left(t \\right)}}{t}+\\frac{12 e^{2 t}}{t}+24 e^{2 t} \\ln{\\left(t \\right)} \\\\  & =24 e^{2 t} \\ln{\\left(t \\right)} + \\frac{12 e^{2 t}}{t} + \\frac{2 \\ln{\\left(t \\right)}}{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536144 :knowledge-point/_questions [{:knowledge-point/id #uuid "0096e314-e53e-5d9b-9cee-fe34fa3a6379" :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c65a274-bf1c-510e-93f7-af87e6992999" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 t e^{2 t} \\ln{\\left(t \\right)} + e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536109} {:answer/id #uuid "2e078f7c-7fb4-5408-83b3-9282edfe1151" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(t e^{2 t} + 2 t \\ln{\\left(t \\right)} + 2 \\ln{\\left(t \\right)}\\right) e^{t}}{t}" :db/id #edb/ref 17592186536114} {:answer/id #uuid "7dd6b5b5-82a5-5bbc-af24-64251de049af" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2 t} + 2 e^{t} \\ln{\\left(t \\right)} + 2 \\ln{\\left(t \\right)}" :db/id #edb/ref 17592186536142} {:answer/id #uuid "a5893d8d-8c9d-58d1-a951-4116dd536f6d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536154} {:answer/id #uuid "c165d35f-0e3e-54f0-bd59-5e02a049ced0" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 t e^{2 t} \\ln{\\left(t \\right)} - e^{2 t} - 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536160}] :answer-field/correct {:answer/id #uuid "1c65a274-bf1c-510e-93f7-af87e6992999" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 t e^{2 t} \\ln{\\left(t \\right)} + e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536109} :answer-field/id #uuid "219519b6-e351-5891-9ab3-febd1842d844" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "870cb2f9-447e-5e98-bbd0-de46e4f5add3" :question/problem "If $f(x,y)=x^{2} + x y^{2}$ and $r(t)=\\ln{\\left(t \\right)}\\,i+e^{t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x^{2} + x y^{2})\\,i+\\frac{∂}{∂y}(x^{2} + x y^{2})\\,j \\\\  & =(2 x + y^{2})\\,i+2 x y\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\ln{\\left(t \\right)}$ and $y=e^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2(\\ln{\\left(t \\right)})+(e^{t})^{2})\\,i+2(\\ln{\\left(t \\right)})(e^{t})\\,j \\\\  & =(e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+2 e^{t} \\ln{\\left(t \\right)}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\ln{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(e^{t})\\,j \\\\  & =\\frac{1}{t}\\,i+e^{t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+2 e^{t} \\ln{\\left(t \\right)}\\,j)\\cdot (\\frac{1}{t}\\,i+e^{t}\\,j) \\\\  & =((e^{2 t} + 2 \\ln{\\left(t \\right)}))(\\frac{1}{t})+(2 e^{t} \\ln{\\left(t \\right)})(e^{t}) \\\\  & =\\frac{2 \\ln{\\left(t \\right)}}{t}+\\frac{e^{2 t}}{t}+2 e^{2 t} \\ln{\\left(t \\right)} \\\\  & =2 e^{2 t} \\ln{\\left(t \\right)} + \\frac{e^{2 t}}{t} + \\frac{2 \\ln{\\left(t \\right)}}{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536146 :knowledge-point/_questions [{:knowledge-point/id #uuid "0096e314-e53e-5d9b-9cee-fe34fa3a6379" :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23479d6b-0017-5db5-a587-dd7c374c7ee8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16 e^{4 t} \\sin^{2}{\\left(5 t \\right)}}{16 e^{8 t} \\sin^{4}{\\left(5 t \\right)} + 1}" :db/id #edb/ref 17592186536112} {:answer/id #uuid "530366db-79a8-50df-ad45-b44ecc227b13" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{8 \\left(- 2 \\sin{\\left(5 t \\right)} + 5 \\cos{\\left(5 t \\right)}\\right) e^{4 t} \\sin{\\left(5 t \\right)}}{16 e^{8 t} \\sin^{4}{\\left(5 t \\right)} + 1}" :db/id #edb/ref 17592186536127} {:answer/id #uuid "6bcda1e6-11d8-59b8-b27c-b1988618d72c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(2 e^{4 t} + \\sin{\\left(5 t \\right)}\\right) \\sin{\\left(5 t \\right)}}{16 e^{8 t} \\sin^{4}{\\left(5 t \\right)} + 1}" :db/id #edb/ref 17592186536136} {:answer/id #uuid "c1282498-7aba-573b-bc25-80c6fd8a1f8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\left(2 \\sin{\\left(5 t \\right)} + 5 \\cos{\\left(5 t \\right)}\\right) e^{4 t} \\sin{\\left(5 t \\right)}}{16 e^{8 t} \\sin^{4}{\\left(5 t \\right)} + 1}" :db/id #edb/ref 17592186536159} {:answer/id #uuid "d83ad5fa-5e5c-5504-9219-e20de2bf81b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(8 e^{8 t} + 5 \\sin{\\left(5 t \\right)} \\cos{\\left(5 t \\right)}\\right) \\sin{\\left(5 t \\right)}}{16 e^{8 t} \\sin^{4}{\\left(5 t \\right)} + 1}" :db/id #edb/ref 17592186536166}] :answer-field/correct {:answer/id #uuid "c1282498-7aba-573b-bc25-80c6fd8a1f8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\left(2 \\sin{\\left(5 t \\right)} + 5 \\cos{\\left(5 t \\right)}\\right) e^{4 t} \\sin{\\left(5 t \\right)}}{16 e^{8 t} \\sin^{4}{\\left(5 t \\right)} + 1}" :db/id #edb/ref 17592186536159} :answer-field/id #uuid "572be089-a689-5cb6-88f1-0301b7c058df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536129}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8c9981e4-00b6-58ae-b640-e83086d82404" :question/problem "If $f(x,y)=\\operatorname{arctan}⁡(4x{y}^{2})$ and $r(t)={e}^{4t}\\,i+\\operatorname{sin}⁡5t\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(4x{y}^{2}))\\,i+\\frac{∂}{∂y}(\\operatorname{arctan}⁡(4x{y}^{2}))\\,j \\\\  & =\\frac{4(1{y}^{2}+x2y\\cdot 0)}{1+16{x}^{2}{y}^{4}}\\,i+\\frac{4(0{y}^{2}+x2y\\cdot 1)}{1+16{x}^{2}{y}^{4}}\\,j \\\\  & =\\frac{4{y}^{2}}{1+16{x}^{2}{y}^{4}}\\,i+\\frac{8xy}{1+16{x}^{2}{y}^{4}}\\,j\\end{aligned}\n$$\n\nNext, we substitute $x={e}^{4t}$ and $y=\\operatorname{sin}⁡5t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{4(\\operatorname{sin}⁡5t)^{2}}{1+16({e}^{4t})^{2}(\\operatorname{sin}⁡5t)^{4}}\\,i+\\frac{8({e}^{4t})(\\operatorname{sin}⁡5t)}{1+16({e}^{4t})^{2}(\\operatorname{sin}⁡5t)^{4}}\\,j \\\\  & =\\frac{4\\sin^{2}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,i+\\frac{8{e}^{4t}\\operatorname{sin}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{4t})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡5t)\\,j \\\\  & =4{e}^{4t}\\,i+5\\operatorname{cos}⁡5t\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{4\\sin^{2}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,i+\\frac{8{e}^{4t}\\operatorname{sin}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,j)\\cdot (4{e}^{4t}\\,i+5\\operatorname{cos}⁡5t\\,j) \\\\  & =\\frac{16{e}^{4t}\\sin^{2}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}+\\frac{40{e}^{4t}\\operatorname{sin}⁡5t\\operatorname{cos}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t} \\\\  & =\\frac{4{e}^{4t}(4\\sin^{2}⁡5t+10\\operatorname{sin}⁡5t\\operatorname{cos}⁡5t)}{1+16{e}^{8t}\\sin^{4}⁡5t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536147 :knowledge-point/_questions [{:knowledge-point/id #uuid "0096e314-e53e-5d9b-9cee-fe34fa3a6379" :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e4a664-828b-5860-8931-3f7a67e771ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(2 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536113} {:answer/id #uuid "43863874-ca72-58e4-99b6-b2310513b7d8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 \\left(4 t e^{2 t} \\ln{\\left(t \\right)} - 2 e^{2 t} - \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536119} {:answer/id #uuid "4f9ceac7-621c-54b7-b41f-8994e3294d08" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\left(2 e^{2 t} + 2 e^{t} \\ln{\\left(t \\right)} + \\ln{\\left(t \\right)}\\right)" :db/id #edb/ref 17592186536123} {:answer/id #uuid "af473d8e-16e9-570c-81d8-5f12c2cd647c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(4 t e^{2 t} \\ln{\\left(t \\right)} + 2 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536155} {:answer/id #uuid "c2579dd5-b29d-546c-85ee-76fc7fc743a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\left(2 t e^{2 t} + t \\ln{\\left(t \\right)} + \\ln{\\left(t \\right)}\\right) e^{t}}{t}" :db/id #edb/ref 17592186536161}] :answer-field/correct {:answer/id #uuid "af473d8e-16e9-570c-81d8-5f12c2cd647c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(4 t e^{2 t} \\ln{\\left(t \\right)} + 2 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536155} :answer-field/id #uuid "7d12e6ff-94be-5dcd-84cc-d93391333c27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536141}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e3d3273-ab0d-559d-b480-c40a8896fe51" :question/problem "If $f(x,y)=2 x^{2} + 2 x y^{2}$ and $r(t)=\\ln{\\left(t \\right)}\\,i+2 e^{t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(2 x^{2} + 2 x y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} + 2 x y^{2})\\,j \\\\  & =(4 x + 2 y^{2})\\,i+4 x y\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\ln{\\left(t \\right)}$ and $y=2 e^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(4(\\ln{\\left(t \\right)})+2(2 e^{t})^{2})\\,i+4(\\ln{\\left(t \\right)})(2 e^{t})\\,j \\\\  & =(8 e^{2 t} + 4 \\ln{\\left(t \\right)})\\,i+8 e^{t} \\ln{\\left(t \\right)}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\ln{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(2 e^{t})\\,j \\\\  & =\\frac{1}{t}\\,i+2 e^{t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((8 e^{2 t} + 4 \\ln{\\left(t \\right)})\\,i+8 e^{t} \\ln{\\left(t \\right)}\\,j)\\cdot (\\frac{1}{t}\\,i+2 e^{t}\\,j) \\\\  & =((8 e^{2 t} + 4 \\ln{\\left(t \\right)}))(\\frac{1}{t})+(8 e^{t} \\ln{\\left(t \\right)})(2 e^{t}) \\\\  & =\\frac{4 \\ln{\\left(t \\right)}}{t}+\\frac{8 e^{2 t}}{t}+16 e^{2 t} \\ln{\\left(t \\right)} \\\\  & =16 e^{2 t} \\ln{\\left(t \\right)} + \\frac{8 e^{2 t}}{t} + \\frac{4 \\ln{\\left(t \\right)}}{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536163 :knowledge-point/_questions [{:knowledge-point/id #uuid "0096e314-e53e-5d9b-9cee-fe34fa3a6379" :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fcbb94e-faef-5525-9470-4b6ce168bca9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(2 e^{3 t} + \\sin{\\left(2 t \\right)}\\right) \\sin{\\left(2 t \\right)}}{4 e^{6 t} \\sin^{4}{\\left(2 t \\right)} + 1}" :db/id #edb/ref 17592186536124} {:answer/id #uuid "554fc290-ebd5-56da-99e2-35b578477e7b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 \\left(- 3 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\right) e^{3 t} \\sin{\\left(2 t \\right)}}{4 e^{6 t} \\sin^{4}{\\left(2 t \\right)} + 1}" :db/id #edb/ref 17592186536128} {:answer/id #uuid "5849863d-28ec-5073-8260-c3b9880b8690" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(3 e^{6 t} + \\sin{\\left(2 t \\right)} \\cos{\\left(2 t \\right)}\\right) \\sin{\\left(2 t \\right)}}{4 e^{6 t} \\sin^{4}{\\left(2 t \\right)} + 1}" :db/id #edb/ref 17592186536130} {:answer/id #uuid "918aa55b-03d6-5a24-af2c-a013acb6995a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(3 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\right) e^{3 t} \\sin{\\left(2 t \\right)}}{4 e^{6 t} \\sin^{4}{\\left(2 t \\right)} + 1}" :db/id #edb/ref 17592186536149} {:answer/id #uuid "d30558e5-dd40-58c6-a497-8b68fb6bb95b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6 e^{3 t} \\sin^{2}{\\left(2 t \\right)}}{4 e^{6 t} \\sin^{4}{\\left(2 t \\right)} + 1}" :db/id #edb/ref 17592186536165}] :answer-field/correct {:answer/id #uuid "918aa55b-03d6-5a24-af2c-a013acb6995a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(3 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\right) e^{3 t} \\sin{\\left(2 t \\right)}}{4 e^{6 t} \\sin^{4}{\\left(2 t \\right)} + 1}" :db/id #edb/ref 17592186536149} :answer-field/id #uuid "3e322836-255a-51e3-a105-98fd7d7b75f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536115}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7286e11-a67f-5b3a-a6ac-713b2737570a" :question/problem "If $f(x,y)=\\operatorname{arctan}⁡(2x{y}^{2})$ and $r(t)={e}^{3t}\\,i+\\operatorname{sin}⁡2t\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(2x{y}^{2}))\\,i+\\frac{∂}{∂y}(\\operatorname{arctan}⁡(2x{y}^{2}))\\,j \\\\  & =\\frac{2(1{y}^{2}+x2y\\cdot 0)}{1+4{x}^{2}{y}^{4}}\\,i+\\frac{2(0{y}^{2}+x2y\\cdot 1)}{1+4{x}^{2}{y}^{4}}\\,j \\\\  & =\\frac{2{y}^{2}}{1+4{x}^{2}{y}^{4}}\\,i+\\frac{4xy}{1+4{x}^{2}{y}^{4}}\\,j\\end{aligned}\n$$\n\nNext, we substitute $x={e}^{3t}$ and $y=\\operatorname{sin}⁡2t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{2(\\operatorname{sin}⁡2t)^{2}}{1+4({e}^{3t})^{2}(\\operatorname{sin}⁡2t)^{4}}\\,i+\\frac{4({e}^{3t})(\\operatorname{sin}⁡2t)}{1+4({e}^{3t})^{2}(\\operatorname{sin}⁡2t)^{4}}\\,j \\\\  & =\\frac{2\\sin^{2}⁡2t}{1+4{e}^{6t}\\sin^{4}⁡2t}\\,i+\\frac{4{e}^{3t}\\operatorname{sin}⁡2t}{1+4{e}^{6t}\\sin^{4}⁡2t}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{3t})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t)\\,j \\\\  & =3{e}^{3t}\\,i+2\\operatorname{cos}⁡2t\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{2\\sin^{2}⁡2t}{1+4{e}^{6t}\\sin^{4}⁡2t}\\,i+\\frac{4{e}^{3t}\\operatorname{sin}⁡2t}{1+4{e}^{6t}\\sin^{4}⁡2t}\\,j)\\cdot (3{e}^{3t}\\,i+2\\operatorname{cos}⁡2t\\,j) \\\\  & =\\frac{6{e}^{3t}\\sin^{2}⁡2t}{1+4{e}^{6t}\\sin^{4}⁡2t}+\\frac{8{e}^{3t}\\operatorname{sin}⁡2t\\operatorname{cos}⁡2t}{1+4{e}^{6t}\\sin^{4}⁡2t} \\\\  & =\\frac{2{e}^{3t}(3\\sin^{2}⁡2t+4\\operatorname{sin}⁡2t\\operatorname{cos}⁡2t)}{1+4{e}^{6t}\\sin^{4}⁡2t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536169 :knowledge-point/_questions [{:knowledge-point/id #uuid "0096e314-e53e-5d9b-9cee-fe34fa3a6379" :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51bb9ef3-9793-536d-83c9-dd2d55598726" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\left(e^{4 t} + 2 e^{2 t} \\ln{\\left(t \\right)} + \\ln{\\left(t \\right)}\\right)" :db/id #edb/ref 17592186536125} {:answer/id #uuid "5ce67cdf-7635-55db-9f92-06eb0b47dfbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(e^{4 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536132} {:answer/id #uuid "6b18450d-20dc-57d6-a4dc-8ccb1ef0781c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(4 t e^{4 t} \\ln{\\left(t \\right)} + e^{4 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536135} {:answer/id #uuid "94efb8a3-edb0-515f-9afd-69942a6e2b78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\left(t e^{4 t} + t \\ln{\\left(t \\right)} + \\ln{\\left(t \\right)}\\right) e^{2 t}}{t}" :db/id #edb/ref 17592186536150} {:answer/id #uuid "afb69994-495a-5e34-808e-984f82739d21" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 \\left(4 t e^{4 t} \\ln{\\left(t \\right)} - e^{4 t} - \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536156}] :answer-field/correct {:answer/id #uuid "6b18450d-20dc-57d6-a4dc-8ccb1ef0781c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 \\left(4 t e^{4 t} \\ln{\\left(t \\right)} + e^{4 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536135} :answer-field/id #uuid "4b802581-781c-5f13-9c9e-406f2d098414" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536121}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6e87588-a6f0-5803-a115-953266b2efe6" :question/problem "If $f(x,y)=x^{2} + 2 x y^{2}$ and $r(t)=\\ln{\\left(t \\right)}\\,i+e^{2 t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x^{2} + 2 x y^{2})\\,i+\\frac{∂}{∂y}(x^{2} + 2 x y^{2})\\,j \\\\  & =(2 x + 2 y^{2})\\,i+4 x y\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\ln{\\left(t \\right)}$ and $y=e^{2 t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2(\\ln{\\left(t \\right)})+2(e^{2 t})^{2})\\,i+4(\\ln{\\left(t \\right)})(e^{2 t})\\,j \\\\  & =(2 e^{4 t} + 2 \\ln{\\left(t \\right)})\\,i+4 e^{2 t} \\ln{\\left(t \\right)}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\ln{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(e^{2 t})\\,j \\\\  & =\\frac{1}{t}\\,i+2 e^{2 t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((2 e^{4 t} + 2 \\ln{\\left(t \\right)})\\,i+4 e^{2 t} \\ln{\\left(t \\right)}\\,j)\\cdot (\\frac{1}{t}\\,i+2 e^{2 t}\\,j) \\\\  & =((2 e^{4 t} + 2 \\ln{\\left(t \\right)}))(\\frac{1}{t})+(4 e^{2 t} \\ln{\\left(t \\right)})(2 e^{2 t}) \\\\  & =\\frac{2 \\ln{\\left(t \\right)}}{t}+\\frac{2 e^{4 t}}{t}+8 e^{4 t} \\ln{\\left(t \\right)} \\\\  & =8 e^{4 t} \\ln{\\left(t \\right)} + \\frac{2 e^{4 t}}{t} + \\frac{2 \\ln{\\left(t \\right)}}{t}.\\end{aligned}\n$$"}] :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Two Variables"}]}
