n{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["24ce3f6b-1cff-5e54-951c-3d66da20a412"] :db/ensure :question/validate} {:db/id "25451830-b3c4-5ed7-907b-8021140d7082" :answer/id #uuid "25451830-b3c4-5ed7-907b-8021140d7082" :answer/type :answer.type/math :answer/value "r^{2} \\sin^{2}{\\left(\\theta \\right)} - 8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/ensure :answer/validate} {:db/id "88268ae5-df7c-5cd6-b910-e71adbf29cbf" :answer/id #uuid "88268ae5-df7c-5cd6-b910-e71adbf29cbf" :answer/type :answer.type/math :answer/value "- 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/ensure :answer/validate} {:db/id "ce5b502e-7cdc-57c8-818e-2a9249e80994" :answer/id #uuid "ce5b502e-7cdc-57c8-818e-2a9249e80994" :answer/type :answer.type/math :answer/value "r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/ensure :answer/validate} {:db/id "80d2b349-1aa9-5707-a1f3-27d64fedfcb1" :answer/id #uuid "80d2b349-1aa9-5707-a1f3-27d64fedfcb1" :answer/type :answer.type/math :answer/value "- r^{2} \\sin^{2}{\\left(\\theta \\right)} + 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/ensure :answer/validate} {:db/id "1c4b70f1-a2a9-50cf-83a8-2af7e51db9b7" :answer/id #uuid "1c4b70f1-a2a9-50cf-83a8-2af7e51db9b7" :answer/type :answer.type/math :answer/value "\\frac{r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/ensure :answer/validate} {:db/id "cea47898-ec2b-520f-a44f-e17d98f48686" :answer-field/id #uuid "cea47898-ec2b-520f-a44f-e17d98f48686" :answer-field/key "