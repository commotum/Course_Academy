{\\left(\\theta \\right)}) \\\\  & =r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - r^{3} \\cos^{3}{\\left(\\theta \\right)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["b38fe45d-dbbd-5614-9a2b-4a1fd9aeb2c3"] :db/ensure :question/validate} {:db/id "7623b2a1-2815-51c8-af36-c5449d7b4225" :answer/id #uuid "7623b2a1-2815-51c8-af36-c5449d7b4225" :answer/type :answer.type/math :answer/value "\\frac{4 r^{2} \\sin^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}" :db/ensure :answer/validate} {:db/id "e06161ba-b711-53b6-a6be-89ac2b159b29" :answer/id #uuid "e06161ba-b711-53b6-a6be-89ac2b159b29" :answer/type :answer.type/math :answer/value "\\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{r \\left(3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}\\right)}" :db/ensure :answer/validate} {:db/id "a095650a-55e6-5374-a87f-11f9eca107d2" :answer/id #uuid "a095650a-55e6-5374-a87f-11f9eca107d2" :answer/type :answer.type/math :answer/value "\\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/ensure :answer/validate} {:db/id "b3de4b3d-f1b9-5b84-a580-865d3ba52584" :answer/id #uuid "b3de4b3d-f1b9-5b84-a580-865d3ba52584" :answer/type :answer.type/math :answer/value "\\frac{6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}" :db/ensure :answer/validate} {:db/id "b997a104-b349-5dba-8d72-574ffb82c196" :answer/id #uuid "b997a104-b349-5dba-8d72-574ffb82c196" :answer/type :answer.type/math :answer/value "- \\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/ensure :answer/validate} {:db/id "cf37e36c-be27-5f11-9b87-1e2003357f10" :answer-field/id #uuid "cf37e36c-be27-5f11-9b87-1e2003357f10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["7623b2a1-2815-51c8-af36-c5449d7b4225" "e06161ba-b711-53b6-a6be-89ac2b159b29" "a095650a-55e6-5374-a87f-11f9eca107d2" "b3de4b3d-f1b9-5b84-a580-865d3ba52584" "b997a104-b349-5dba-8d72-574ffb82c196"] :answer-field/correct "a095650a-55e6-5374-a87f-11f9eca107d2" :db/ensure :answer-field/validate} {:db/id "fad48590-44c0-5716-af2e-ae5d36de575e" :question/id #uuid "fad48590-44c0-5716-af2e-ae5d36de575e" :question/problem "Given that $h(x,y)=\\ln{\\left(4 x^{2} - 4 x y + 3 y^{2} \\right)},$ find $\\frac{∂h}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =(\\frac{∂h}{∂x})(- r \\sin{\\left(\\theta \\right)})+(\\frac{∂h}{∂y})(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=\\frac{8 x - 4 y}{4 x^{2} - 4 x y + 3 y^{2}},\\,\\frac{∂h}{∂y}=\\frac{- 4 x + 6 y}{4 x^{2} - 4 x y + 3 y^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{- 4 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}, \\\\ \\frac{∂h}{∂y} & =\\frac{6 r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta} & =(\\frac{- 4 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})(- r \\sin{\\left(\\theta \\right)})+(\\frac{6 r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(\\frac{4 r^{2} \\sin^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})+(\\frac{6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}) \\\\  & =\\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["cf37e36c-be27-5f11-9b87-1e2003357f10"] :db/ensure :question/validate} {:db/id "60fdd167-0846-56cf-b69c-e98695bcdd09" :answer/id #uuid "60fdd167-0846-56cf-b69c-e98695bcdd09" :answer/type :answer.type/math :answer/value "\\frac{r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}}{r}" :db/ensure :answer/validate} {:db/id "6b4cd983-7e49-585a-9573-13bb478061d2" :answer/id #uuid "6b4cd983-7e49-585a-9573-13bb478061d2" :answer/type :answer.type/math :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\th