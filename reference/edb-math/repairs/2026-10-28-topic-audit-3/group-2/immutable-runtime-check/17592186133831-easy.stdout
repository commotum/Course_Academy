              ":answer/value": "\\begin{aligned}&\\int_{0}^{1}\\bigl[(- 2 t^{4})(2 t)\\\\&\\quad+(- t^{4})(1)\\bigr]\\,\\mathrm{d}t\\end{aligned}"
