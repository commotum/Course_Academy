              ":answer/value": "⟨\\frac{3 \\ln{(5 )}}{25},\\,5 \\cdot 5^{t} \\ln{(5 )} + 3 \\cdot 5^{- t} \\ln{(5 )},\\,3 \\ln{(5 )}⟩"
            }
          ],
          ":answer-field/correct": [
