              ":answer/value": "- \\frac{2 \\left(- \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t}}{4 e^{2 t} \\sin^{2}{\\left(t \\right)} + 1}"
            }
          ],
          ":answer-field/correct": [
