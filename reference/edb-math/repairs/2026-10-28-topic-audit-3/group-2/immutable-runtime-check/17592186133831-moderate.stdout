              ":answer/type": ":answer.type/math",
              ":answer/value": "\\begin{aligned}&\\int_{0}^{1}\\bigl[(t^{6})(1)\\\\&\\quad+(- 2 t^{4})(1)\\bigr]\\,\\mathrm{d}t\\end{aligned}"
            },
