          ":answer-field/choices": [
            {
              ":answer/id": "98fb6556-fcb3-50a9-a4a9-6e9452fa77a8",
              ":answer/type": ":answer.type/math",
              ":answer/value": "3 \\left(- \\frac{\\cos{\\left(t \\right)}}{\\sin{\\left(t \\right)}} + \\frac{1}{t}\\right)"
            },
