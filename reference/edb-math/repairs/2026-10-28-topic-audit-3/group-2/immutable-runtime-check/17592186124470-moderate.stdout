            },
            {
              ":answer/id": "7febf960-78af-5530-b349-18504e7b3f32",
              ":answer/type": ":answer.type/math",
              ":answer/value": "3 \\left(- 2 t e^{t^{2}} + \\frac{1}{t}\\right)"
            },
            {
