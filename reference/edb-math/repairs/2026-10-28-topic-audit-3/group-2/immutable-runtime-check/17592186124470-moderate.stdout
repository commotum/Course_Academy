              ":answer/type": ":answer.type/math",
              ":answer/value": "-3\\left(\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}\\right)"
            },
            {
              ":answer/id": "0f5d0299-1bbf-5e9c-8328-d0147fe12b90",
              ":answer/type": ":answer.type/math",
              ":answer/value": "- 3 \\left(2 t e^{t^{2}} + \\frac{\\cos{\\left(t \\right)}}{\\sin{\\left(t \\right)}}\\right)"
            }
