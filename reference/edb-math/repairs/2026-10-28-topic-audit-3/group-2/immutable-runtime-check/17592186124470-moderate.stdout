      "title": "Applying the Vector Form of the Chain Rule to a Function of Three Variables"
    },
    "question": {
      ":question/id": "bc89453a-e80b-5b99-a48a-beb4a4abf66c",
      ":question/problem": "If $f(x,y,z)=-3\\left(\\operatorname{ln}⁡(xz)+{e}^{y}\\right)$ and $\\mathbf{r}(t)=\\operatorname{sin}⁡t\\,\\mathbf{i}+{t}^{2}\\,\\mathbf{j}+\\frac{1}{t}\\,\\mathbf{k},$ compute $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))].$",
      ":question/answer-fields": [
        {
          ":answer-field/id": "6439ef03-15ab-57ab-a266-2a9e2dd3e201",
          ":answer-field/key": "selection",
