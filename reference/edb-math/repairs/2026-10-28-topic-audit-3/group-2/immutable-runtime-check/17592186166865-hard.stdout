              ":answer/type": ":answer.type/math",
              ":answer/value": "-\\frac{x-\\frac{3}{2}}{2(y+\\frac{5}{2})}"
            },
            {
              ":answer/id": "37078b78-f5d6-5447-98e4-a6c88f7c9b65",
              ":answer/type": ":answer.type/math",
              ":answer/value": "-\\frac{2(x-\\frac{3}{2})}{y+\\frac{5}{2}}"
            },
            {
              ":answer/id": "204bb2ec-27a4-547e-8b6e-ea6d58bb78e4",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{x-\\frac{3}{2}}{y+\\frac{5}{2}}"
            },
            {
              ":answer/id": "199ff0d6-3390-53cb-9f6e-dd04d1694cdb",
              ":answer/type": ":answer.type/math",
              ":answer/value": "-\\frac{y+\\frac{5}{2}}{x-\\frac{3}{2}}"
            }
