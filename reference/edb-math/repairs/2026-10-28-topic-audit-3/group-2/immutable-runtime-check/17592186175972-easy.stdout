            },
            {
              ":answer/id": "9f1beaf3-9e87-5cf3-af1d-9e82dc114b95",
              ":answer/type": ":answer.type/math",
              ":answer/value": "12x"
            },
            {
              ":answer/id": "66c242e9-19bd-5a96-99e5-1e549ea1d379",
              ":answer/type": ":answer.type/math",
              ":answer/value": "{y}^{2}"
            },
