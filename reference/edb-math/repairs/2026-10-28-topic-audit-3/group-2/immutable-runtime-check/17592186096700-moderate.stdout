[
  {
    "knowledge_point": {
      "db_id": 17592186096700,
      "id": "dc5bab6c-1ce7-58b5-a59d-cff2ce35ecca",
      "title": "Identifying Parallel Vectors From a Diagram"
    },
    "question": {
      ":question/id": "315c53f0-f9a3-5c89-981e-43d9f0f9b631",
      ":question/problem": "![](/tmp/course-academy-g2-readonly-tly0pcma/17592186096700/caller-moderate/generated/3075e749745625da7a26d6ed7db920dd90e73f5c98e91fcff7c917674dc12060.png)\n\nConsider the diagram that is shown above. Which of the following statements are true?\n\nI. $g=-k$\n\nII. $\\mathbf{a}=z$\n\nIII. $k=-\\frac{1}{2}g$",
      ":question/worked-solution": "- Statement I is false. The vectors $g$ and $k$ are parallel and have the same direction. The magnitude of $g$ is $2$ times the magnitude of $k$. So, $g\\ne -k$.\n\n- Statement II is true. The vectors $\\mathbf{a}$ and $z$ are parallel and have the same direction. The magnitude of $\\mathbf{a}$ is $1$ times the magnitude of $z$. So, $\\mathbf{a}=z$.\n\n- Statement III is false. The vectors $k$ and $g$ are parallel and have the same direction. The magnitude of $k$ is $\\frac{1}{2}$ times the magnitude of $g$. So, $k\\ne -\\frac{1}{2}g$.\n\nTherefore, only statement II is true.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "e3437c80-2c34-5c02-8a18-f19f8cb71022",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "4e947116-0b8e-53a2-8bc3-caa47524ee07",
              ":answer/type": ":answer.type/text",
              ":answer/value": "I and III only"
            },
            {
              ":answer/id": "f1ce6895-5f28-53f1-9415-f5aebaa28e33",
              ":answer/type": ":answer.type/text",
              ":answer/value": "II only"
            },
            {
              ":answer/id": "bc6499fb-c753-5c2d-8e0a-0a3b12dc24a8",
              ":answer/type": ":answer.type/text",
              ":answer/value": "III only"
            },
            {
              ":answer/id": "72b5b3fc-d0f0-5e2d-aa5a-af8374443873",
              ":answer/type": ":answer.type/text",
              ":answer/value": "II and III only"
            },
            {
              ":answer/id": "efdfbef4-2477-582b-ba19-f6dd96b19daf",
