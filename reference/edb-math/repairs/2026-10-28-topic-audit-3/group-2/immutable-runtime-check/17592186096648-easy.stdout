              ":answer/value": "\\frac{4}{3}"
            },
            {
              ":answer/id": "d83222b9-bd18-5e75-a49c-63319fa87128",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{1}{4}"
            },
