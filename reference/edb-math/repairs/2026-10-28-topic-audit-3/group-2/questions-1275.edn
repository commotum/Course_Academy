92186719835} {:answer/id #uuid "596c7d5d-45f4-5d60-bcdb-ef8501785555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186719837} {:answer/id #uuid "79c139c7-c2a4-50ce-b9d3-a6036b670fd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\sqrt{2}\\,\\text{cm}" :db/id #edb/ref 17592186719841} {:answer/id #uuid "d4c089ef-f901-57c5-8eb3-679917f859b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\sqrt{2}\\,\\text{cm}" :db/id #edb/ref 17592186719849}] :answer-field/correct {:answer/id #uuid "596c7d5d-45f4-5d60-bcdb-ef8501785555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186719837} :answer-field/id #uuid "3d469086-3abb-5ae2-9bd1-e3a7ac589c83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719833}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3fc2b89c-3ded-5a43-887d-f3dcba0f6ec0" :question/problem "![Triangle CAB with its given side lengths and included angle](images/0b/0b2c72bd9c35ad12f10c9a7ca58d3a03a4fe62f4d2d75cd2871c4f1cf6f04757.png)\n\nThe area of $\\triangle CAB$ is $8 \\sqrt{2}\\,\\text{cm}^2$. Find $CB$." :question/worked-solution "The angle at $C$ is included between $CA$ and $CB$. Let $x$ be the length of $CB$ in cm. Use $\\sin 45^\\circ=\\frac{\\sqrt{2}}{2}$:\n\n$$\n\\begin{aligned}\n\\mathcal A&=\\frac12(CA)(CB)\\sin C \\\\\n8 \\sqrt{2}&=\\frac12\\cdot\\left(8\\right)\\cdot x\\cdot\\sin 45^\\circ \\\\\n8 \\sqrt{2}&=\\frac12\\cdot\\left(8\\right)\\cdot x\\cdot\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\\n8 \\sqrt{2}&=\\left(2 \\sqrt{2}\\right)x \\\\\nx&=\\frac{8 \\sqrt{2}}{2 \\sqrt{2}}=4\n\\end{aligned}\n$$\n\nThus $CB=4\\,\\text{cm}$. Checking the area gives $\\frac12\\cdot\\left(8\\right)\\cdot\\left(4\\right)\\cdot\\left(\\frac{\\sqrt{2}}{2}\\right)=8 \\sqrt{2}\\,\\text{cm}^2$."}] [{:db/id #edb/ref 17592186719839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cac36d5-43f7-545b-a78e-3e2b65229128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,\\text{cm}" :db/id #edb/ref 17592186719828} {:answer/id #uuid "297c7965-06c0-5021-bac1-7a5d33776d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186719830} {:answer/id #uuid "48330198-4286-5401-90a7-ccaa6ecef5a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56\\,\\text{cm}" :db/id #edb/ref 17592186719836} {:answer/id #uuid "afa6a1c7-f31e-5d82-a6f1-f9a97c428884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14 \\sqrt{3}}{3}\\,\\text{cm}" :db/id #edb/ref 17592186719844} {:answer/id #uuid "d98bf90a-d62a-5b04-a35e-a0d18b078405" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{4}\\,\\text{cm}" :db/id #edb/ref 17592186719850}] :answer-field/correct {:answer/id #uuid "297c7965-06c0-5021-bac1-7a5d33776d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186719830} :answer-field/id #uuid "1e976276-7a5e-5646-9753-58a5dd775f4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719829}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "76b2342d-bbea-5c1d-b37f-b5eb403d0654" :question/problem "![Triangle CAB with its given side lengths and included angle](images/40/40979bcfce5e4f446e7ce15733f5b8a3c9d35b1fe490b2342ad6bc87691db40b.png)\n\nThe area of $\\triangle CAB$ is $14 \\sqrt{3}\\,\\text{cm}^2$. Find $CB$." :question/worked-solution "The angle at $C$ is included between $CA$ and $CB$. Let $x$ be the length of $CB$ in cm. Use $\\sin 60^\\circ=\\frac{\\sqrt{3}}{2}$:\n\n$$\n\\begin{aligned}\n\\mathcal A&=\\frac12(CA)(CB)\\sin C \\\\\n14 \\sqrt{3}&=\\frac12\\cdot\\left(8\\right)\\cdot x\\cdot\\sin 60^\\circ \\\\\n14 \\sqrt{3}&=\\frac12\\cdot\\left(8\\right)\\cdot x\\cdot\\left(\\frac{\\sqrt{3}}{2}\\right) \\\\\n14 \\sqrt{3}&=\\left(2 \\sqrt{3}\\right)x \\\\\nx&=\\frac{14 \\sqrt{3}}{2 \\sqrt{3}}=7\n\\end{aligned}\n$$\n\nThus $CB=7\\,\\text{cm}$. Checking the area gives $\\frac12\\cdot\\left(8\\right)\\cdot\\left(7\\right)\\cdot\\left(\\frac{\\sqrt{3}}{2}\\right)=14 \\sqrt{3}\\,\\text{cm}^2$."}] [{:db/id #edb/ref 17592186719840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc35bfb-1149-5246-b2b1-a38d7a5dcefe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{cm}" :db/id #edb/ref 17592186719831} {:answer/id #uuid "39ae2ed8-4fd7-5c87-b152-a734112adee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186719832} {:answer/id #uuid "6b3fcfec-e739-57d6-b00f-aba6fde6ff9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28\\,\\text{cm}" :db/id #edb/ref 17592186719838} {:answer/id #uuid "c6366a31-ae50-5ab1-97ef-76a15db3a7e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}\\,\\text{cm}" :db/id #edb/ref 17592186719848} {:answer/id #uuid "e822fc67-9ecf-530f-8595-36766724192a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{cm}" :db/id #edb/ref 17592186719852}] :answer-field/correct {:answer/id #uuid "39ae2ed8-4fd7-5c87-b152-a734112adee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186719832} :answer-field/id #uuid "c207bcd2-cddd-5c6f-94ae-1eefadd39a64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719846}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "78da8a26-c448-587e-96b6-3472576bb008" :question/problem "![Triangle BCA with its given side lengths and included angle](images/d7/d78faa847c9ac7c181821f5ba6fc69c0e19b2fbc3844602dac07db77d9869a2a.png)\n\nThe area of $\\triangle BCA$ is $7\\,\\text{cm}^2$. Find $BA$." :question/worked-solution "The angle at $B$ is included between $BC$ and $BA$. Let $x$ be the length of $BA$ in cm. Use $\\sin 150^\\circ=\\sin(180^\\circ-150^\\circ)=\\sin 30^\\circ=\\frac{1}{2}$:\n\n$$\n\\begin{aligned}\n\\mathcal A&=\\frac12(BC)(BA)\\sin B \\\\\n7&=\\frac12\\cdot\\left(7\\right)\\cdot x\\cdot\\sin 150^\\circ \\\\\n7&=\\frac12\\cdot\\left(7\\right)\\cdot x\\cdot\\left(\\frac{1}{2}\\right) \\\\\n7&=\\left(\\frac{7}{4}\\right)x \\\\\nx&=\\frac{7}{\\frac{7}{4}}=4\n\\end{aligned}\n$$\n\nThus $BA=4\\,\\text{cm}$. Checking the area gives $\\frac12\\cdot\\left(7\\right)\\cdot\\left(4\\right)\\cdot\\left(\\frac{1}{2}\\right)=7\\,\\text{cm}^2$."}] [{:db/id #edb/ref 17592186719847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c9603cf-2088-5a25-add7-ce547a14ff97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719842}] :answer-field/correct {:answer/id #uuid "7c9603cf-2088-5a25-add7-ce547a14ff97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719842} :answer-field/id #uuid "93bbbc30-a70d-56da-a719-0740fbc152a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719843}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5c18b00-9704-5ea2-a2ee-1221a08e858b" :question/problem "![Triangle ABC with its given side lengths and included angle](images/0d/0d747478e090f092451da1828db98c6213e82187e8d48c418db0264d17bac5b4.png)\n\nThe area of $\\triangle ABC$ is $\\frac{33 \\sqrt{2}}{2}\\,\\text{mm}^2$. Find $AB$.\n\n$AB=$ {{field-1}} $\\text{mm}$." :question/worked-solution "The angle at $A$ is included between $AB$ and $AC$. Let $x$ be the length of $AB$ in mm. Use $\\sin 135^\\circ=\\sin(180^\\circ-135^\\circ)=\\sin 45^\\circ=\\frac{\\sqrt{2}}{2}$:\n\n$$\n\\begin{aligned}\n\\mathcal A&=\\frac12(AB)(AC)\\sin A \\\\\n\\frac{33 \\sqrt{2}}{2}&=\\frac12\\cdot\\left(6\\right)\\cdot x\\cdot\\sin 135^\\circ \\\\\n\\frac{33 \\sqrt{2}}{2}&=\\frac12\\cdot\\left(6\\right)\\cdot x\\cdot\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\\n\\frac{33 \\sqrt{2}}{2}&=\\left(\\frac{3 \\sqrt{2}}{2}\\right)x \\\\\nx&=\\frac{\\frac{33 \\sqrt{2}}{2}}{\\frac{3 \\sqrt{2}}{2}}=11\n\\end{aligned}\n$$\n\nThus $AB=11\\,\\text{mm}$. Checking the area gives $\\frac12\\cdot\\left(11\\right)\\cdot\\left(6\\right)\\cdot\\left(\\frac{\\sqrt{2}}{2}\\right)=\\frac{33 \\sqrt{2}}{2}\\,\\text{mm}^2$."}] [{:db/id #edb/ref 17592186719853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6c10758-3dfa-53ec-8a29-22441b28cc2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186719851}] :answer-field/correct {:answer/id #uuid "e6c10758-3dfa-53ec-8a29-22441b28cc2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186719851} :answer-field/id #uuid "bb08aa88-9b5b-5bcb-b9dd-c8678d95980d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719845}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f256533e-faf4-5492-9df7-40da647a29ff" :question/problem "![Triangle BCA with its given side lengths and included angle](images/44/4445e6e3a74dd289305ee06461147ffe8efb1bc11e4b38e7d9c580303ac43006.png)\n\nThe area of $\\triangle BCA$ is $8\\,\\text{cm}^2$. Find $BC$.\n\n$BC=$ {{field-1}} $\\text{cm}$." :question/worked-solution "The angle at $B$ is included between $BC$ and $BA$. Let $x$ be the length of $BC$ in cm. Use $\\sin 30^\\circ=\\frac{1}{2}$:\n\n$$\n\\begin{aligned}\n\\mathcal A&=\\frac12(BC)(BA)\\sin B \\\\\n8&=\\frac12\\cdot\\left(8\\right)\\cdot x\\cdot\\sin 30^\\circ \\\\\n8&=\\frac12\\cdot\\left(8\\right)\\cdot x\\cdot\\left(\\frac{1}{2}\\right) \\\\\n8&=\\left(2\\right)x \\\\\nx&=\\frac{8}{2}=4\n\\end{aligned}\n$$\n\nThus $BC=4\\,\\text{cm}$. Checking the area gives $\\frac12\\cdot\\left(4\\right)\\cdot\\left(8\\right)\\cdot\\left(\\frac{1}{2}\\right)=8\\,\\text{cm}^2$."}] [{:db/id #edb/ref 17592186719976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a39927c-5099-5f82-b99a-e73c441b989e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38\\,\\text{in}^{2}" :db/id #edb/ref 17592186719979} {:answer/id #uuid "2d15490b-9767-5280-b427-b767c16c11d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "121\\,\\text{in}^{2}" :db/id #edb/ref 17592186719982} {:answer/id #uuid "6dc49e05-8244-5482-9617-650c01646f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45\\,\\text{in}^{2}" :db/id #edb/ref 17592186719990} {:answer/id #uuid "a75c8bf2-ac08-59eb-9869-1fb74f4c5b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19\\,\\text{in}^{2}" :db/id #edb/ref 17592186719997} {:answer/id #uuid "e4fdd43f-8374-53b1-b477-bb37596b27f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61\\,\\text{in}^{2}" :db/id #edb/ref 17592186720004}] :answer-field/correct {:answer/id #uuid "1a39927c-5099-5f82-b99a-e73c441b989e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38\\,\\text{in}^{2}" :db/id #edb/ref 17592186719979} :answer-field/id #uuid "2df3db38-1886-5bb1-b010-7269b81ecb59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719983}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "08c90099-9d78-57cf-a182-aedd5e3ffc9d" :question/problem "![Concave quadrilateral ABCD with a dashed enclosing edge](images/bb/bbff14d8535244160e8a241dd6193db7ee56c04083205d84c1854fa3b35d120d.png)\n\nThe area of the quadrilateral $ABCD$ is $83\\,\\text{in}^{2}$. The sides $AB=16\\,\\text{in}$ and $AD=18\\,\\text{in}$ meet at $57^\\circ$. What is the area of $\\triangle BCD$, rounded to the **nearest integer**?\n\nA scientific calculator is required." :question/requires-calculator true :question/retired true :question/worked-solution "First calculate the area of the enclosing triangle $ABD$. Use the two given sides and their included angle, with the calculator in degree mode.\n\n$$\n\\begin{aligned}A_{ABD}&=\\frac12\\cdot AB\\cdot AD\\cdot\\sin\\angle BAD\\\\&=\\frac12\\cdot 16\\cdot 18\\cdot\\sin57^\\circ\\\\&\\approx120.768562\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nThe enclosing triangle consists of the quadrilateral $ABCD$ and the missing triangle $BCD$. Subtract the quadrilateral area:\n\n$$\n\\begin{aligned}A_{BCD}&=A_{ABD}-A_{ABCD}\\\\&=144\\sin57^\\circ-83\\\\&\\approx37.768562\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nKeep full precision until this subtraction is complete. Rounded to the nearest integer, the area is $38\\,\\text{in}^{2}$."}] [{:db/id #edb/ref 17592186719984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63327f01-e38e-53b4-a99d-81fec5f1cf16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{cm}^{2}" :db/id #edb/ref 17592186719988} {:answer/id #uuid "aea0698e-b295-58bc-a772-9a31f9762e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}^{2}" :db/id #edb/ref 17592186719998} {:answer/id #uuid "d8014177-c01d-5fc4-9c36-754df46f257f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,\\text{cm}^{2}" :db/id #edb/ref 17592186720002} {:answer/id #uuid "d9446104-dcad-5723-8394-4002c3a6686c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{cm}^{2}" :db/id #edb/ref 17592186720003} {:answer/id #uuid "f9752cc6-3623-5ab8-bbee-ec00aee53514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,\\text{cm}^{2}" :db/id #edb/ref 17592186720006}] :answer-field/correct {:answer/id #uuid "aea0698e-b295-58bc-a772-9a31f9762e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}^{2}" :db/id #edb/ref 17592186719998} :answer-field/id #uuid "7fdfd754-dfd3-504b-95b9-d5bd734ada98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719993}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "415c3b42-1a74-5a28-864a-a316178967eb" :question/problem "![Concave quadrilateral BCDA with a dashed enclosing edge](images/2c/2c1180d2676b37e7c91cdd1f11d2fc3a8a583d667b26ffd5131bca4ac6bd5c13.png)\n\nThe area of the quadrilateral $BCDA$ is $8\\,\\text{cm}^{2}$. The sides $BC=4\\,\\text{cm}$ and $BA=6\\,\\text{cm}$ meet at $75^\\circ$. What is the area of $\\triangle CDA$, rounded to the **nearest integer**?\n\nA scientific calculator is required." :question/requires-calculator true :question/retired true :question/worked-solution "First calculate the area of the enclosing triangle $BCA$. Use the two given sides and their included angle, with the calculator in degree mode.\n\n$$\n\\begin{aligned}A_{BCA}&=\\frac12\\cdot BC\\cdot BA\\cdot\\sin\\angle CBA\\\\&=\\frac12\\cdot 4\\cdot 6\\cdot\\sin75^\\circ\\\\&\\approx11.591110\\,\\text{cm}^{2}.\\end{aligned}\n$$\n\nThe enclosing triangle consists of the quadrilateral $BCDA$ and the missing triangle $CDA$. Subtract the quadrilateral area:\n\n$$\n\\begin{aligned}A_{CDA}&=A_{BCA}-A_{BCDA}\\\\&=12\\sin75^\\circ-8\\\\&\\approx3.591110\\,\\text{cm}^{2}.\\end{aligned}\n$$\n\nKeep full precision until this subtraction is complete. Rounded to the nearest integer, the area is $4\\,\\text{cm}^{2}$."}] [{:db/id #edb/ref 17592186719985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "198b48dd-493a-539f-b3a2-dea0ff1102ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{in}^{2}" :db/id #edb/ref 17592186719978} {:answer/id #uuid "1e1dbb26-9fbb-5e7a-abbd-c52730681d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{in}^{2}" :db/id #edb/ref 17592186719981} {:answer/id #uuid "4d2a2931-6f33-5e49-b89b-662d94f83555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28\\,\\text{in}^{2}" :db/id #edb/ref 17592186719987} {:answer/id #uuid "869145d6-6038-5dd4-9e4e-33cc45b536e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{in}^{2}" :db/id #edb/ref 17592186719994} {:answer/id #uuid "cbd2c66c-0171-5fbc-a934-de35110bdf3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,\\text{in}^{2}" :db/id #edb/ref 17592186720001}] :answer-field/correct {:answer/id #uuid "198b48dd-493a-539f-b3a2-dea0ff1102ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{in}^{2}" :db/id #edb/ref 17592186719978} :answer-field/id #uuid "7f2b88eb-d12e-53bd-ae24-98620019e4d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719992}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4a561584-c28e-5c79-8236-4ac3287cf971" :question/problem "![Concave quadrilateral DABC with a dashed enclosing edge](images/cb/cbc857d026fb2afe0a1a9f643d42578ca4e5b301a4a7a6367272a932ab014d42.png)\n\nThe area of the quadrilateral $DABC$ is $4\\,\\text{in}^{2}$. The sides $DA=8\\,\\text{in}$ and $DC=6\\,\\text{in}$ meet at $42^\\circ$. What is the area of $\\triangle ABC$, rounded to the **nearest integer**?\n\nA scientific calculator is required." :question/requires-calculator true :question/retired true :question/worked-solution "First calculate the area of the enclosing triangle $DAC$. Use the two given sides and their included angle, with the calculator in degree mode.\n\n$$\n\\begin{aligned}A_{DAC}&=\\frac12\\cdot DA\\cdot DC\\cdot\\sin\\angle ADC\\\\&=\\frac12\\cdot 8\\cdot 6\\cdot\\sin42^\\circ\\\\&\\approx16.059135\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nThe enclosing triangle consists of the quadrilateral $DABC$ and the missing triangle $ABC$. Subtract the quadrilateral area:\n\n$$\n\\begin{aligned}A_{ABC}&=A_{DAC}-A_{DABC}\\\\&=24\\sin42^\\circ-4\\\\&\\approx12.059135\\,\\text{in}^{2}.\\end{aligned}\n$$\n\nKeep full precision until this subtraction is complete. Rounded to the nearest integer, the area is $12\\,\\text{in}^{2}$."}] [{:db/id #edb/ref 17592186719991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c6d3b47-4373-5eb5-b1c5-2869a4072c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186719980}] :answer-field/correct {:answer/id #uuid "1c6d3b47-4373-5eb5-b1c5-2869a4072c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186719980} :answer-field/id #uuid "8ff1eea9-51d6-57fe-9398-3f98c83c380a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719995}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7cb87bba-f43f-59ab-9073-8f7e06e1992d" :question/problem "![Concave quadrilateral DABC with a dashed enclosing edge](images/42/42ad0f671e1fe52287c2c03031b292078d7ad4980d4bf2e929cc5e45ca7f9830.png)\n\nThe area of the quadrilateral $DABC$ is $10\\,\\text{cm}^{2}$. The sides $DA=12\\,\\text{cm}$ and $DC=6\\,\\text{cm}$ meet at $96^\\circ$. The area of $\\triangle ABC$, rounded to the **nearest integer**, is {{field-1}} $\\text{cm}^{2}$.\n\nA scientific calculator is required." :question/requires-calculator true :question/retired true :question/worked-solution "First calculate the area of the enclosing triangle $DAC$. Use the two given sides and their included angle, with the calculator in degree mode.\n\n$$\n\\begin{aligned}A_{DAC}&=\\frac12\\cdot DA\\cdot DC\\cdot\\sin\\angle ADC\\\\&=\\frac12\\cdot 12\\cdot 6\\cdot\\sin96^\\circ\\\\&\\approx35.802788\\,\\text{cm}^{2}.\\end{aligned}\n$$\n\nThe enclosing triangle consists of the quadrilateral $DABC$ and the missing triangle $ABC$. Subtract the quadrilateral area:\n\n$$\n\\begin{aligned}A_{ABC}&=A_{DAC}-A_{DABC}\\\\&=36\\sin96^\\circ-10\\\\&\\approx25.802788\\,\\text{cm}^{2}.\\end{aligned}\n$$\n\nKeep full precision until this subtraction is complete. Rounded to the nearest integer, the area is $26\\,\\text{cm}^{2}$."}] [{:db/id #edb/ref 17592186720005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d584bf-7951-5e16-b69e-349919d2afeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,\\text{in}^{2}" :db/id #edb/ref 17592186719977} {:answer/id #uuid "4c15b7ae-e86c-5030-a74b-6abc5f55e6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\text{in}^{2}" :db/id #edb/ref 17592186719986} {:answer/id #uuid "6558f1db-759a-5051-bad2-7b03b95b3bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13\\,\\text{in}^{2}" :db/id #edb/ref 17592186719989} {:answer/id #uuid "af37c82c-43b8-5bb2-afd3-d8ad1aaea34