s of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{22}{3}\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={120}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{120}^{∘}=\\frac{\\sqrt{3}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{1}{2}\\cdot b\\cdot \\frac{22}{3}\\cdot \\operatorname{sin}⁡{120}^{∘} \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{1}{2}\\cdot b\\cdot \\frac{22}{3}\\cdot \\left(\\frac{\\sqrt{3}}{2}\\right) \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{11\\sqrt{3}}{6}b \\\\ b & =\\frac{\\frac{121\\sqrt{3}}{18}}{\\frac{11\\sqrt{3}}{6}} \\\\ b & =\\frac{11}{3}\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{11}{3}\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186556396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a81808-f3a7-51b7-a275-f77c8ce4630c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{4}" :db/id #edb/ref 17592186556354}] :answer-field/correct {:answer/id #uuid "09a81808-f3a7-51b7-a275-f77c8ce4630c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{4}" :db/id #edb/ref 17592186556354} :answer-field/id #uuid "5da2ced1-509c-5f9a-a1eb-9a312a6150a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186556368}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d3e9f084-c5c8-5e5d-a8cd-0b8a1cdc4b6a" :question/problem "![](images/3d/3dc502507d431d52979ff26a01089d61793a9487989d9203fd2f4f9246ecb1e3.png)\n\nThe area of the triangle $△ABC$ is $\\frac{111\\sqrt{2}}{32}\\,\\text{cm}^{2}.$ Then, $AC=${{field-1}} $\\text{cm}.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{3}{2}\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{1}{2}\\cdot b\\cdot \\frac{3}{2}\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{1}{2}\\cdot b\\cdot \\frac{3}{2}\\cdot \\left(\\frac{\\sqrt{2}}{2}\\right) \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{3\\sqrt{2}}{8}b \\\\ b & =\\frac{\\frac{111\\sqrt{2}}{32}}{\\frac{3\\sqrt{2}}{8}} \\\\ b & =\\frac{37}{4}\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{37}{4}\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186556400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189e4e81-e91b-541e-a713-a659dc893ccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556357} {:answer/id #uuid "397621df-9258-5f5c-b429-ac0df048eae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{17}\\,\\text{mm}" :db/id #edb/ref 17592186556361} {:answer/id #uuid "56329264-d12e-5e0e-a820-46d1266fc01d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556365} {:answer/id #uuid "9031717b-9f69-57af-8df6-781065968f5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1445}{27}\\,\\text{mm}" :db/id #edb/ref 17592186556377} {:answer/id #uuid "9197fd42-c5ad-5145-ad0f-670e27d991b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}\\,\\text{mm}" :db/id #edb/ref 17592186556378}] :answer-field/correct {:answer/id #uuid "56329264-d12e-5e0e-a820-46d1266fc01d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556365} :answer-field/id #uuid "e0c61827-39ef-5b85-8a67-6d3bc7f90cb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556397}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e783bc5b-9008-5bdd-9a47-991be242d917" :question/problem "![](images/77/7783777fcc75d7c12a8eaed0f703bc6a864e805fc8c814860a899e3737f71480.png)\n\nThe area of the triangle $△ABC$ is $\\frac{85\\sqrt{2}}{36}\\,\\text{mm}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{17}{3}\\text{ mm} \\\\ b & =AC \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{1}{2}\\cdot b\\cdot \\frac{17}{3}\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{1}{2}\\cdot b\\cdot \\frac{17}{3}\\cdot \\left(\\frac{\\sqrt{2}}{2}\\right) \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{17\\sqrt{2}}{12}b \\\\ b & =\\frac{\\frac{85\\sqrt{2}}{36}}{\\frac{17\\sqrt{2}}{12}} \\\\ b & =\\frac{5}{3}\\text{ mm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{5}{3}\\,\\text{mm}.$"}] [{:db/id #edb/ref 17592186556401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e808f9d-31be-5a13-9482-c882618b4d13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7}\\,\\text{cm}" :db/id #edb/ref 17592186556363} {:answer/id #uuid "6464c1a3-5522-5202-84e1-c5893469dea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186556369} {:answer/id #uuid "6eeeca4d-7e83-52c4-ab5b-afef0a041e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186556370} {:answer/id #uuid "8f4a94f6-3016-5f60-9d0c-0d9b1512ddce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "245\\,\\text{cm}" :db/id #edb/ref 17592186556376} {:answer/id #uuid "bd849935-03e9-5534-b8df-54ec95c858b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\,\\text{cm}" :db/id #edb/ref 17592186556392}] :answer-field/correct {:answer/id #uuid "6eeeca4d-7e83-52c4-ab5b-afef0a041e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186556370} :answer-field/id #uuid "b93faa7e-caa0-5f1e-8af9-0757c496ba0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556387}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e802d20f-bb4d-5898-ad8c-4cb88bfe1ea8" :question/problem "![](images/6a/6a2da5468750823c21e259f6aa40a0c93342a2bebcc38a1292aa43686ca618fa.png)\n\nThe area of the triangle $△ABC$ is $\\frac{35}{4}\\,\\text{cm}^{2}.$ Use $\\sin30^{\\circ}=\\frac{1}{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=7\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={30}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{30}^{∘}=\\frac{1}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{35}{4} & =\\frac{1}{2}\\cdot b\\cdot 7\\cdot \\operatorname{sin}⁡{30}^{∘} \\\\ \\frac{35}{4} & =\\frac{1}{2}\\cdot b\\cdot 7\\cdot \\left(\\frac{1}{2}\\right) \\\\ \\frac{35}{4} & =\\frac{7}{4}b \\\\ b & =\\frac{\\frac{35}{4}}{\\frac{7}{4}} \\\\ b & =5\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=5\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186557293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65d7e23d-a662-543a-949a-9f1103f2f026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556669} {:answer/id #uuid "718ad878-e04a-5234-a710-bf3756d5dd41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556688} {:answer/id #uuid "7822939c-8917-5fa9-999c-a9b7716110f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556703} {:answer/id #uuid "863c7b23-cd66-50d9-b292-999cccff557f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556747} {:answer/id #uuid "8fbfadd0-9675-506a-9f67-970459a5eb77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556778}] :answer-field/correct {:answer/id #uuid "7822939c-8917-5fa9-999c-a9b7716110f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556703} :answer-field/id #uuid "c1ee5adb-4e16-5916-9acc-b73f1caa075b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557175}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b105592d-99b2-5bf4-877e-0bc7baf37cd7" :question/math-academy-id "q-161105" :question/problem "![](images/0b/0b460a07026e489fb7c63dad99c04c7e44540138632626dcd3ebcafb5c0a93d3.png)\n\nThe area of $ABCD$ is $52{\\text{ in}}^{2}.$   What is the area of $△BCD$ rounded to the nearest integer?" :question/worked-solution "Let's start by finding the area of $△ABD.$ We get \n\n$$\n\\begin{aligned}{A}_{△ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}⁡A \\\\  & =\\frac{1}{2}\\cdot 9\\cdot 16\\cdot \\operatorname{sin}⁡{66}^{∘} \\\\  & =72\\cdot \\operatorname{sin}⁡{66}^{∘} \\\\  & =65.775… \\\\  & ≈66{\\text{ in}}^{2},\\end{aligned}\n$$\n\nrounded to the nearest integer.\n\nThe difference of the areas of  $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n \n\n$$\n\\begin{aligned}{A}_{△BCD} & ={A}_{△ABD}-{A}_{ABCD} \\\\  & =66-52 \\\\  & =14\\,{\\text{ in}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "056ae85b-4497-51c3-bf0f-16db555df25d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "87" :db/id #edb/ref 17592186556442} {:answer/id #uuid "893a2d02-47a2-54d1-80f0-24b55f689ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186556754} {:answer/id #uuid "9e8e098e-a66d-5126-99c7-db91b01066aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186556816} {:answer/id #uuid "a7188c0a-2793-54f6-a856-19adbe5707e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "93" :db/id #edb/ref 17592186556841} {:answer/id #uuid "cc4e118b-ddd2-55e0-a765-c19e81224e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186556923}] :answer-field/correct {:answer/id #uuid "cc4e118b-ddd2-55e0-a765-c19e81224e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186556923} :answer-field/id #uuid "0bd6e77c-1825-574d-9544-ad954df128e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557069}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c86bcf22-54c7-51dc-bd7b-9dc7538670ba" :question/math-academy-id "q-67785" :question/problem "![](images/27/27dc9ff8452d9a9aa95322492549ba0eabed5f68a7aa2e586ebe239143268bde.png)\n\nRounded to the nearest integer, what is the area of the quadrilateral $ABCD?$" :question/worked-solution "The area of the quadrilateral $ABCD$ is the sum of the areas of the triangles $△ABD$ and $△BDC$ (see the illustration below).\n\n![](images/da/da7cc00005fbeb686443e2075009fda7c68f6d379a8ddb924a7dfe5b60e6ab16.png)\n\n \n\nFirst we find the area for $△ABD:$ \n \n\n$$\n\\begin{aligned}{A}_{ABD} & =\\frac{1}{2}\\cdot 10\\cdot 8\\cdot \\operatorname{sin}⁡{75}^{∘} \\\\  & =40\\cdot \\operatorname{sin}⁡{75}^{∘} \\\\  & ≈38.637,\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nNow we find the area for $△BCD:$ \n \n\n$$\n\\begin{aligned}{A}_{BDC} & =\\frac{1}{2}\\cdot 5\\cdot 12\\cdot \\operatorname{sin}⁡{67.2}^{∘} \\\\  & =30\\cdot \\operatorname{sin}⁡{67.2}^{∘} \\\\  & ≈27.656,\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nFinally, we add together the areas of our two triangles to determine the area of $ABCD:$\n\n$$\n\\begin{aligned}{A}_{ABCD} & ={A}_{ABD}+{A}_{BDC} \\\\  & =38.637+27.656 \\\\  & =66.293\\end{aligned}\n$$\n\nConsequently, to the nearest integer, the area of the quadrilateral $ABCD$ is $66.$"}] [{:db/id #edb/ref 17592186561383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a3cd9c-241c-5968-a466-c1279229ffce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "108{\\text{ km}}^{2}" :db/id #edb/ref 17592186561385} {:answer/id #uuid "2900df49-9c1b-5a54-a2a5-deec66c212ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math}