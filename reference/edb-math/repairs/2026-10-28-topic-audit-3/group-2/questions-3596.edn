7592186176194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf49a136-1e98-5c0a-bfa3-281c50bb4e57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186173423} {:answer/id #uuid "cd871832-d0c3-59ac-b21f-49cef3e75f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}" :db/id #edb/ref 17592186173424} {:answer/id #uuid "157f6a2d-6a3e-5f67-876e-1a83ae3848e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sin y" :db/id #edb/ref 17592186173425} {:answer/id #uuid "42a2ed92-a5cc-5411-98ae-af6792517334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186173426} {:answer/id #uuid "684dbbcc-0964-5ba5-ab08-e4e37fbd6bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{2}" :db/id #edb/ref 17592186173427}] :answer-field/id #uuid "c62592dc-2c27-5d36-9b3a-38dd112685e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173422}] :question/id #uuid "ef866db3-b2e4-5f4c-bceb-3251e75aa136" :question/math-academy-id "q-103992" :question/problem "$f(x, y) = ⟨___, y, 9y^{2}⟩$\n\nThe vector-valued function $f(x, z)$ above parametrizes the parabolic cylinder defined in Cartesian coordinates as $9y^{2} = z$. What is the first component of $f$?"}] [{:db/id #edb/ref 17592186176195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4bccfdf-8331-5efb-b37f-6bd4c45035fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cos t" :db/id #edb/ref 17592186173429} {:answer/id #uuid "f7003dda-c112-5f97-8bca-af47b02f7225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\tan t" :db/id #edb/ref 17592186173430} {:answer/id #uuid "03e1293d-6cad-