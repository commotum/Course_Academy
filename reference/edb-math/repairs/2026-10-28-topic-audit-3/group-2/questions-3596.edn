,y,z⟩ \\\\  & =⟨4\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t,\\,z⟩\\end{aligned}\n$$\n\nwhere $t\\in [0,2\\pi )$ and $z\\in (-\\infty ,\\infty ).$\n\nTherefore, the first component of $f$ is $4\\operatorname{cos}⁡t.$"}] [{:db/id #edb/ref 17592186606853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d72e7d9-c604-567b-ad32-e320b4f69359" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}" :db/id #edb/ref 17592186606162} {:answer/id #uuid "5f484dc8-7640-5205-b5b4-023e43e5cc9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡t" :db/id #edb/ref 17592186606339} {:answer/id #uuid "730c2650-ca5b-5912-8060-00b7041a6d0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡t" :db/id #edb/ref 17592186606386} {:answer/id #uuid "7ac61989-998c-556e-a28d-51c0585e3303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡t" :db/id #edb/ref 17592186606400} {:answer/id #uuid "cb3d09ed-1d15-53b4-b6e4-9595b71527c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t" :db/id #edb/ref 17592186606564}] :answer-field/correct {:answer/id #uuid "cb3d09ed-1d15-53b4-b6e4-9595b71527c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t" :db/id #edb/ref 17592186606564} :answer-field/id #uuid "c39a1e2e-522e-5426-835a-fb8e3a86870c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186606767}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8030e6dd-a74d-56aa-ac1a-23794775e565" :question/math-academy-id "q-164520" :question/problem "$$\nf(t,z)=⟨\\text{_____},\\,3\\operatorname{sin}⁡t,\\,z⟩\n$$\n\nThe vector-valued function $f(t,z)$ above parametrizes the elliptic cylinder defined in Cartesian coordinates as ${x}^{2}+\\frac{{y}^{2}}{9}=1.$ What is the first component of $f?$" :question/worked-solution "Recall that the ellipse ${x}^{2}+\\frac{{y}^{2}}{9}=1$ in $xy$-plane has the parametrization\n\n$$\n⟨x,y⟩=⟨\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩,\\,t\\in [0,2\\pi ),\n$$\n\nsince \n\n$$\n\\begin{aligned}{x}^{2}+\\frac{{y}^{2}}{9} & =(\\operatorname{cos}⁡t)^{2}+\\frac{(3\\operatorname{sin}⁡t)^{2}}{9} \\\\  & ={cos}^{2}⁡t+\\frac{9{sin}^{2}⁡t}{9} \\\\  & ={cos}^{2}⁡t+{sin}^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(t,z) & =⟨x,y,z⟩ \\\\  & =⟨\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t,\\,z⟩\\end{aligned}\n$$\n\nwhere $t\\in [0,2\\pi )$ and $z\\in (-\\infty ,\\infty ).$\n\nTherefore, the first component of $f$ is $\\operatorname{cos}⁡t.$"}] [{:db/id #edb/ref 17592186606867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c4db993-2237-5276-8e40-e246ee717693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}" :db/id #edb/ref 17592186606333} {:answer/id #uuid "8a2450c2-4730-57b2-8192-ad329c0f83f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z" :db/id #edb/ref 17592186606434} {:answer/id #uuid "9317e52e-0370-5386-8409-cbb052f906b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}" :db/id #edb/ref 17592186606452} {:answer/id #uuid "a582795a-e1a7-56bf-9e5c-50e7e52a466f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10{y}^{2}" :db/id #edb/ref 17592186606491} {:answer/id #uuid "b411a1a5-e510-5435-a8c5-a14105ef5136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10y" :db/id #edb/ref 17592186606515}] :answer-field/correct {:answer/id #uuid "8a2450c2-4730-57b2-81