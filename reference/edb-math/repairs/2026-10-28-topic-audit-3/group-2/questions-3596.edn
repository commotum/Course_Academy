6556034} {:answer/id #uuid "a12593a3-577d-58cb-a5a1-76e354fb5c15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10 \\sin{\\left(t \\right)}" :db/id #edb/ref 17592186556036} {:answer/id #uuid "b1c39745-ae16-5d0f-90ea-c88d4634c795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100 z^{2}" :db/id #edb/ref 17592186556039} {:answer/id #uuid "f736708e-82e2-5dc4-adaa-e74882b04876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10 \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186556049}] :answer-field/correct {:answer/id #uuid "a12593a3-577d-58cb-a5a1-76e354fb5c15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10 \\sin{\\left(t \\right)}" :db/id #edb/ref 17592186556036} :answer-field/id #uuid "a971110f-9b04-577e-9120-54f128f1d092" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556037}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "055565a1-d075-5a32-af9f-b388bf896da0" :question/problem "$$\nf(t,z)=⟨5 \\cos{\\left(t \\right)},\\,\\text{_____},\\,z⟩\n$$\n\nThe vector-valued function $f(t,z)$ above parametrizes the elliptic cylinder defined in Cartesian coordinates as $\\frac{x^{2}}{25}+\\frac{y^{2}}{100}=1.$ What is the second component of $f?$" :question/worked-solution "Recall that the ellipse $\\frac{x^{2}}{25}+\\frac{y^{2}}{100}=1$ in the $xy$-plane has the parametrization\n\n$$\n⟨x,y⟩=⟨5 \\cos{\\left(t \\right)},\\,10 \\sin{\\left(t \\right)}⟩,\\quad t\\in[0,2\\pi),\n$$\n\nsince\n\n$$\n\\begin{aligned}\\frac{x^2}{25}+\\frac{y^2}{100}&=\\frac{(5 \\cos{\\left(t \\right)})^2}{25}+\\frac{(10 \\sin{\\left(t \\right)})^2}{100}\\\\&=\\cos^2 t+\\sin^2 t\\\\&=1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\nf(t,z)=⟨x,y,z⟩=⟨5 \\cos{\\left(t \\right)},\\,10 \\sin{\\left(t \\right)},\\,z⟩\n$$\n\nwhere $t\\in[0,2\\pi)$ and $z\\in(-\\infty,\\infty)$.\n\nTherefore, the second component of $f$ is $10 \\sin{\\left(t \\right)}$."}] [{:db/id #edb/ref 17592186556012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "545dbd73-3941-5f8a-b806-9a603e124fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cosh{\\left(t \\right)}" :db/id #edb/ref 17592186556020} {:answer/id #uuid "886a9a8c-d05f-51a9-b93e-ae9efcb68495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\sinh{\\left(t \\right)}" :db/id #edb/ref 17592186556028} {:answer/id #uuid "8b144c7f-abb7-5bc3-a659-d923fd4678ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186556031} {:answer/id #uuid "b21e90a9-f985-5b92-a025-4963e4401f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\sin{\\left(t \\right)}" :db/id #edb/ref 17592186556040} {:answer/id #uuid "e7325a3c-2971-5516-a37e-91be41f7ff2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 z^{2}" :db/id #edb/ref 17592186556048}] :answer-field/correct {:answer/id #uuid "b21e90a9-f985-5b92-a025-4963e4401f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\sin{\\left(t \\right)}" :db/id #edb/ref 17592186556040} :answer-field/id #uuid "6a15085a-f429-544e-9047-5c2dab830074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556022}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "06ed7ef9-a964-530f-9d92-c37d0095d2ae" :question/problem "$$\nf(t,z)=⟨12 \\cos{\\left(t \\right)},\\,\\text{_____},\\,z⟩\n$$\n\nThe vector-valued function $f(t,z)$ above parametrizes the elliptic cylinder defined in Cartesian coordinates as $\\frac{x^{2}}{144}+\\frac{y^{2}}{4}=1.$ What is the second component of $f?$" :question/worked-solution "Recall that the ellipse $\\frac{x^{2}}{144}+\\frac{y^{2}}{4}=1$ in the $xy$-plane has the parametrization\n\n$$\n⟨x,y⟩=⟨12 \\cos{\\left(t \\right)},\\,2 \\sin{\\left(t \\right)}⟩,\\quad t\\in[0,2\\pi),\n$$\n\nsince\n\n$$\n\\begin{aligned}\\frac{x^2}{144}+\\frac{y^2}{4}&=\\frac{(12 \\cos{\\left(t \\right)})^2}{144}+\\frac{(2 \\sin{\\left(t \\right)})^2}{4}\\\\&=\\cos^2 t+\\sin^2 t\\\\&=1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\nf(t,z)=⟨x,y,z⟩=⟨12 \\cos{\\left(t \\right)},\\,2 \\sin{\\left(t \\right)},\\,z⟩\n$$\n\nwhere $t\\in[0,2\\pi)$ and $z\\in(-\\infty,\\infty)$.\n\nTherefore, the second component of $f$ is $2 \\sin{\\left(t \\right)}$."}] [{:db/id #edb/ref 17592186556013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c334483-a5dc-5291-906b-9abb7c81c5f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49 z^{2}" :db/id #edb/ref 17592186556018} {:answer/id #uuid "9652f064-94fd-579a-8db0-b306af8bac8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49 \\sinh{\\left(t \\right)}" :db/id #edb/ref 17592186556032} {:answer/id #uuid "9674040a-6542-50fc-a4cb-0af6940ccf9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cosh{\\left(t \\right)}" :db/id #edb/ref 17592186556033} {:answer/id #uuid "bc619dc6-d9cf-5f81-b5ce-f3a6de35def5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186556043} {:answer/id #uuid "c8bdaafe-4dd0-5041-8d1f-eddfaa8bab60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 \\sin{\\left(t \\right)}" :db/id #edb/ref 17592186556044}] :answer-field/correct {:answer/id #uuid "c8bdaafe-4dd0-5