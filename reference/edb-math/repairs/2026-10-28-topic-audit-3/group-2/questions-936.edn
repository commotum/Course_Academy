ident :answer.type/math} :answer/value "(- \\frac{3}{2},\\frac{3 \\sqrt{3}}{2})" :db/id #edb/ref 17592186722420} {:answer/id #uuid "20219eb2-85d4-5ab5-870d-66e10aeb8cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 3 \\sqrt{2},3 \\sqrt{2})" :db/id #edb/ref 17592186722423} {:answer/id #uuid "6e9c0687-7ebd-5b6c-9f83-a81c77957e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{3 \\sqrt{3}}{2},\\frac{3}{2})" :db/id #edb/ref 17592186722432} {:answer/id #uuid "7d4e37b2-b891-54ca-977a-f2a9fbe5981b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{3 \\sqrt{2}}{2},\\frac{3 \\sqrt{2}}{2})" :db/id #edb/ref 17592186722435} {:answer/id #uuid "a9841cd1-b86d-556d-967b-e6be2652a05c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{9}{2},\\frac{9 \\sqrt{3}}{2})" :db/id #edb/ref 17592186722438}] :answer-field/correct {:answer/id #uuid "6e9c0687-7ebd-5b6c-9f83-a81c77957e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{3 \\sqrt{3}}{2},\\frac{3}{2})" :db/id #edb/ref 17592186722432} :answer-field/id #uuid "1659ac42-cf40-50ef-9b7d-f111ac4c4793" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722421}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5a126485-576d-5a09-823a-d5f94ed7e549" :question/problem "![](images/33/33061766ae30a387c2c1f6cb6f43ed45adcd36fa7a8914b7d4eed393a7161660.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(3,135^\\circ)$ and the marked angle is $\\angle AOB=15^\\circ$.\n\nMoving from $A$ to $B$ along the marked arc is counterclockwise, so add the marked angle. Use $x=r\\cos\\theta$ and $y=r\\sin\\theta$ to find the Cartesian coordinates of $B$.\n\nWhich ordered pair gives the Cartesian coordinates of $B$?" :question/worked-solution "Both points lie on the same circle, so $B$ has radius $3$. Along the marked arc, moving from $A$ to $B$ is counterclockwise; add the marked angle.\n\n$$\n\\theta_B=135^\\circ+15^\\circ=150^\\circ.\n$$\n\nThus $B$ has polar coordinates $(3,150^\\circ)$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=3\\cos\\left(150^\\circ\\right)=3\\left(- \\frac{\\sqrt{3}}{2}\\right)=- \\frac{3 \\sqrt{3}}{2},\\\\y &=3\\sin\\left(150^\\circ\\right)=3\\left(\\frac{1}{2}\\right)=\\frac{3}{2}.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(- \\frac{3 \\sqrt{3}}{2},\\frac{3}{2})$."}] [{:db/id #edb/ref 17592186722431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427a41bc-4559-5278-b7d4-a38d5785c32a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4 \\sqrt{2},- 4 \\sqrt{2})" :db/id #edb/ref 17592186722424} {:answer/id #uuid "67c4fd59-cd31-598e-9258-a76fedf95461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{2}}{2},- \\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186722430} {:answer/id #uuid "71004ca5-938c-5e6d-a31c-81bf562fc79d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2 \\sqrt{2},- 2 \\sqrt{2})" :db/id #edb/ref 17592186722433} {:answer/id #uuid "729f2153-f870-5e96-ba9e-9733e599d466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,- 4 \\sqrt{3})" :db/id #edb/ref 17592186722434} {:answer/id #uuid "f1294a14-b97c-5d5e-9642-e6b16df64fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4 \\sqrt{3},-4)" :db/id #edb/ref 17592186722444}] :answer-field/correct {:answer/id #uuid "729f2153-f870-5e96-ba9e-9733e599d466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,- 4 \\sqrt{3})" :db/id #edb/ref 17592186722434} :answer-field/id #uuid "02ae430e-ed73-570f-ad77-a7cd2f6f01e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722418}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b2cc1ed-66c3-594a-a842-2ce8dcf7ba47" :question/problem "![](images/4f/4f4bb9378ef45d352ca4e07fe76847daf3bbb94f752d0622ec4d1ec4598f1b07.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(8,315^\\circ)$ and the marked angle is $\\angle AOB=15^\\circ$.\n\nMoving from $A$ to $B$ along the marked arc is clockwise, so subtract the marked angle. Use $x=r\\cos\\theta$ and $y=r\\sin\\theta$ to find the Cartesian coordinates of $B$.\n\nWhich ordered pair gives the Cartesian coordinates of $B$?" :question/worked-solution "Both points lie on the same circle, so $B$ has radius $8$. Along the marked arc, moving from $A$ to $B$ is clockwise; subtract the marked angle.\n\n$$\n\\theta_B=315^\\circ-15^\\circ=300^\\circ.\n$$\n\nThus $B$ has polar coordinates $(8,300^\\circ)$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=8\\cos\\left(300^\\circ\\right)=8\\left(\\frac{1}{2}\\right)=4,\\\\y &=8\\sin\\left(300^\\circ\\right)=8\\left(- \\frac{\\sqrt{3}}{2}\\right)=- 4 \\sqrt{3}.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(4,- 4 \\sqrt{3})$."}] [{:db/id #edb/ref 17592186722439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112958f1-822a-57fe-bfaa-e65e2a6ffa43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186722419} {:answer/id #uuid "4a689e78-011b-558c-bec5-b6cc25a43ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 5 \\sqrt{2},5 \\sqrt{2})" :db/id #edb/ref 17592186722425} {:answer/id #uuid "84084b59-4a44-5625-8f21-e958b52cd1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 10 \\sqrt{3},10)" :db/id #edb/ref 17592186722436} {:answer/id #uuid "b072daae-207a-5027-9268-fe44618b6388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 5 \\sqrt{3},5)" :db/id #edb/ref 17592186722441} {:answer/id #uuid "f6cf0c03-05ae-5807-bc19-720b306aada4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,5 \\sqrt{3})" :db/id #edb/ref 17592186722445}] :answer-field/correct {:answer/id #uuid "f6cf0c03-05ae-5807-bc19-720b306aada4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,5 \\sqrt{3})" :db/id #edb/ref 17592186722445} :answer-field/id #uuid "d16fc94b-445b-5032-b2b2-e0d739796abf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722442}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aeff06ee-1150-54af-9c3a-7f03008cc819" :question/problem "![](images/b4/b4b681702f7102d387b8e7ff910d39aefd016b79df88b0ef01ee17a781b5b047.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(10,210^\\circ)$ and the marked angle is $\\angle AOB=90^\\circ$.\n\nMoving from $A$ to $B$ along the marked arc is clockwise, so subtract the marked angle. Use $x=r\\cos\\theta$ and $y=r\\sin\\theta$ to find the Cartesian coordinates of $B$.\n\nWhich ordered pair gives the Cartesian coordinates of $B$?" :question/worked-solution "Both points lie on the same circle, so $B$ has radius $10$. Along the marked arc, moving from $A$ to $B$ is clockwise; subtract the marked angle.\n\n$$\n\\theta_B=210^\\circ-90^\\circ=120^\\circ.\n$$\n\nThus $B$ has polar coordinates $(10,120^\\circ)$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=10\\cos\\left(120^\\circ\\right)=10\\left(- \\frac{1}{2}\\right)=-5,\\\\y &=10\\sin\\left(120^\\circ\\right)=10\\left(\\frac{\\sqrt{3}}{2}\\right)=5 \\sqrt{3}.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(-5,5 \\sqrt{3})$."}] [{:db/id #edb/ref 17592186722440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7aa24f-81e1-597a-8436-88e33e26354b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9,- 9 \\sqrt{3})" :db/id #edb/ref 17592186722422} {:answer/id #uuid "573b2be8-faa2-5051-8e3d-df9cb4c3497b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{2}}{2},- \\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186722426} {:answer/id #uuid "5fc9e14a-8a9d-5bc9-8e6c-144ed352ec8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{9}{2},- \\frac{9 \\sqrt{3}}{2})" :db/id #edb/ref 17592186722428} {:answer/id #uuid "6076a588-142a-591a-b42c-10d78df7f968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{9 \\sqrt{3}}{2},- \\frac{9}{2})" :db/id #edb/ref 17592186722429} {:answer/id #uuid "a546f1fd-fceb-5859-8449-e6ae430bf7f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{9 \\sqrt{2}}{2},- \\frac{9 \\sqrt{2}}{2})" :db/id #edb/ref 17592186722437}] :answer-field/correct {:answer/id #uuid "5fc9e14a-8a9d-5bc9-8e6c-144ed352ec8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{9}{2},- \\frac{9 \\sqrt{3}}{2})" :db/id #edb/ref 17592186722428} :answer-field/id #uuid "d71baf76-b979-5900-b6ad-46656eff01c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722443}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af207628-d160-5dab-b44d-869a2aa646ed" :question/problem "![](images/19/19e401148d6a6b874fbad93a4db3afe1b6fde55105fcc7798363ff2cd5533bb7.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(9,225^\\circ)$ and the marked angle is $\\angle AOB=75^\\circ$.\n\nMoving from $A$ to $B$ along the marked arc is counterclockwise, so add the marked angle. Use $x=r\\cos\\theta$ and $y=r\\sin\\theta$ to find the Cartesian coordinates of $B$.\n\nWhich ordered pair gives the Cartesian coordinates of $B$?" :question/worked-solution "Both points lie on the same circle, so $B$ has radius $9$. Along the marked arc, moving from $A$ to $B$ is counterclockwise; add the marked angle.\n\n$$\n\\theta_B=225^\\circ+75^\\circ=300^\\circ.\n$$\n\nThus $B$ has polar coordinates $(9,300^\\circ)$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=9\\cos\\left(300^\\circ\\right)=9\\left(\\frac{1}{2}\\right)=\\frac{9}{2},\\\\y &=9\\sin\\left(300^\\circ\\right)=9\\left(- \\frac{\\sqrt{3}}{2}\\right)=- \\frac{9 \\sqrt{3}}{2}.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(\\frac{9}{2},- \\frac{9 \\sqrt{3}}{2})$."}] [{:db/id #edb/ref 17592186722455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "626ed49b-617b-5148-a562-cc76e9ae4b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186722452} {:answer/id #uuid "649db78c-f486-598c-86aa-1a58eb47dccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186722453} {:answer/id #uuid "96b64b85-abeb-5dd4-bf36-3d653a804db7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2 \\sqrt{2},2 \\sqrt{2})" :db/id #edb/ref 17592186722456} {:answer/id #uuid "9f187aee-139c-5edb-9916-58beeff75d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},1)" :db/id #edb/ref 17592186722459} {:answer/id #uuid "c5b5ca00-56e0-5949-89d8-0677215a5758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\sqrt{3})" :db/id #edb/ref 17592186722462}] :answer-field/correct {:answer/id #uuid "9f187aee-139c-5edb-9916-58beeff75d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},1)" :db/id #edb/ref 17592186722459} :answer-field/id #uuid "f6da59bf-1c67-5646-83e3-68edc78e56a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722471}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84b23dc3-d908-5a0b-8c09-834c970f23f9" :question/problem "![](images/c4/c4a75632d599b85c5ac0c8c826a9e42891628ec7c97d8a3c2100119bf417a986.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(2,60^\\circ)$ and the marked angle is $\\angle AOB=30^\\circ$.\n\nUse the marked arc and the positions of $A$ and $B$ to decide whether to increase or decrease the angle of $A$.\n\nWhich ordered pair gives the Cartesian coordinates of $B$?" :question/worked-solution "Both points lie on the same circle, so $B$ has radius $2$. Along the marked arc, moving from $A$ to $B$ is clockwise; subtract the marked angle.\n\n$$\n\\theta_B=60^\\circ-30^\\circ=30^\\circ.\n$$\n\nThus $B$ has polar coordinates $(2,30^\\circ)$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=2\\cos\\left(30^\\circ\\right)=2\\left(\\frac{\\sqrt{3}}{2}\\right)=\\sqrt{3},\\\\y &=2\\sin\\left(30^\\circ\\right)=2\\left(\\frac{1}{2}\\right)=1.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(\\sqrt{3},1)$."}] [{:db/id #edb/ref 17592186722461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db23885-cc2d-5561-87f8-938cc3c7822e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :ans