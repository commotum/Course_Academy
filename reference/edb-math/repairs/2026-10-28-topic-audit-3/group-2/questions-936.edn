/choices [{:answer/id #uuid "087bb12e-ab33-5215-bc13-e3a91859240a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3 \\sqrt{3},3\\right)" :db/id #edb/ref 17592186722335} {:answer/id #uuid "3f95a07b-c4b3-591f-9279-f71f21506bbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3,- 3 \\sqrt{3}\\right)" :db/id #edb/ref 17592186722338} {:answer/id #uuid "59e39ed0-4ae6-548d-a07c-58dce3bf55a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3 \\sqrt{2},- 3 \\sqrt{2}\\right)" :db/id #edb/ref 17592186722342} {:answer/id #uuid "6c6ea5f3-1144-56d1-a113-c9ade7cee404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6 \\sqrt{2},6 \\sqrt{2}\\right)" :db/id #edb/ref 17592186722344} {:answer/id #uuid "8a843697-1321-56fd-8d6f-735f9a873226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3,3 \\sqrt{3}\\right)" :db/id #edb/ref 17592186722352}] :answer-field/correct {:answer/id #uuid "3f95a07b-c4b3-591f-9279-f71f21506bbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3,- 3 \\sqrt{3}\\right)" :db/id #edb/ref 17592186722338} :answer-field/id #uuid "4c5045f2-87e3-5299-ada4-e5e5b899ff2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722340}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93961e59-8531-5c83-ac2d-aec241583857" :question/problem "The point $P$ has polar coordinates $\\left(6,\\frac{5 \\pi}{3}\\right)$. Find the exact Cartesian coordinates of $P$." :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, use\n\n$$\nx=r\\cos\\theta,\\qquad y=r\\sin\\theta.\n$$\n\nFirst calculate the $x$-coordinate:\n\n$$\n\\begin{aligned}\nx&=6\\cos\\left(\\frac{5 \\pi}{3}\\right)\\\\\n &=6\\left(\\frac{1}{2}\\right)\\\\\n &=3.\n\\end{aligned}\n$$\n\nThen calculate the $y$-coordinate:\n\n$$\n\\begin{aligned}\ny&=6\\sin\\left(\\frac{5 \\pi}{3}\\right)\\\\\n &=6\\left(- \\frac{\\sqrt{3}}{2}\\right)\\\\\n &=- 3 \\sqrt{3}.\n\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates are $\\left(3,- 3 \\sqrt{3}\\right)$."}] [{:db/id #edb/ref 17592186722365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0df1a2-2991-5ba6-8d7d-b60c5de98afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-3,3 \\sqrt{3}\\right)" :db/id #edb/ref 17592186722339} {:answer/id #uuid "a158e965-4c41-5c55-81db-74fe06c17a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3 \\sqrt{2},- 3 \\sqrt{2}\\right)" :db/id #edb/ref 17592186722356} {:answer/id #uuid "a869cbfd-3828-5af7-97b0-0b505262b117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 3 \\sqrt{3},3\\right)" :db/id #edb/ref 17592186722357} {:answer/id #uuid "aa992d2f-9111-5f01-ac6d-ac95ab799682" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{3}{2},- \\frac{3 \\sqrt{3}}{2}\\right)" :db/id #edb/ref 17592186722358} {:answer/id #uuid "c878f13e-5891-58df-965d-7569521bb77f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 3 \\sqrt{2},3 \\sqrt{2}\\right)" :db/id #edb/ref 17592186722361}] :answer-field/correct {:answer/id #uuid "c878f13e-5891-58df-965d-7569521bb77f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 3 \\sqrt{2},3 \\sqrt{2}\\right)" :db/id #edb/ref 17592186722361} :answer-field/id #uuid "8bc5f44d-d238-5ac4-9b9e-95b0f62b8497" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722353}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e12af443-0fd7-50bc-b40e-419f5a6059c1" :question/problem "The point $P$ has polar coordinates $\\left(6,135^{\\circ}\\right)$. Find the exact Cartesian coordinates of $P$." :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, use\n\n$$\nx=r\\cos\\theta,\\qquad y=r\\sin\\theta.\n$$\n\nFirst calculate the $x$-coordinate:\n\n$$\n\\begin{aligned}\nx&=6\\cos\\left(135^{\\circ}\\right)\\\\\n &=6\\left(- \\frac{\\sqrt{2}}{2}\\right)\\\\\n &=- 3 \\sqrt{2}.\n\\end{aligned}\n$$\n\nThen calculate the $y$-coordinate:\n\n$$\n\\begin{aligned}\ny&=6\\sin\\left(135^{\\circ}\\right)\\\\\n &=6\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\\n &=3 \\sqrt{2}.\n\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates are $\\left(- 3 \\sqrt{2},3 \\sqrt{2}\\right)$."}] [{:db/id #edb/ref 17592186722392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "549b9faf-456f-5427-8e4e-574fc083dc8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186722399}] :answer-field/correct {:answer/id #uuid "549b9faf-456f-5427-8e4e-574fc083dc8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186722399} :answer-field/id #uuid "20301d49-58a8-5cd0-a56a-d38006547e58" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722396} {:answer-field/choices [{:answer/id #uuid "0ed64302-5f3f-576f-a7fc-6f27b594141b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{3}" :db/id #edb/ref 17592186722394}] :answer-field/correct {:answer/id #uuid "0ed64302-5f3f-576f-a7fc-6f27b594141b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{3}" :db/id #edb/ref 17592186722394} :answer-field/id #uuid "5ec4df2e-aaf9-5f25-a801-a1d7c5272895" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722403}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0189301b-08d7-5d9c-92d1-67224f073476" :question/problem "![](images/b1/b17d9c57364b57f5a41d1ef1eba46aefb14501d4e8e6ced0fc976bc1b6075c7c.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(6,\\pi)$ and the marked angle is $\\angle AOB=\\frac{5 \\pi}{6}$.\n\nDetermine the exact Cartesian coordinates of $B$.\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$ {{field-2}}$)$." :question/worked-solution "Both points lie on the same circle, so $B$ has radius $6$. Along the marked arc, moving from $A$ to $B$ is counterclockwise; add the marked angle.\n\n$$\n\\theta_B=\\pi+\\frac{5 \\pi}{6}=\\frac{6\\pi}{6}+\\frac{5\\pi}{6}=\\frac{11 \\pi}{6}.\n$$\n\nThus $B$ has polar coordinates $(6,\\frac{11 \\pi}{6})$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=6\\cos\\left(\\frac{11 \\pi}{6}\\right)=6\\left(\\frac{\\sqrt{3}}{2}\\right)=3 \\sqrt{3},\\\\y &=6\\sin\\left(\\frac{11 \\pi}{6}\\right)=6\\left(- \\frac{1}{2}\\right)=-3.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(3 \\sqrt{3},-3)$."}] [{:db/id #edb/ref 17592186722402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97fd5a83-2226-53ba-8676-0f2031217c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186722408}] :answer-field/correct {:answer/id #uuid "97fd5a83-2226-53ba-8676-0f2031217c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186722408} :answer-field/id #uuid "18e416d7-df20-52e5-9c17-7fef7564e7d5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722395} {:answer-field/choices [{:answer/id #uuid "284a47e3-a03d-594e-ac9e-4c1be102a466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186722397}] :answer-field/correct {:answer/id #uuid "284a47e3-a03d-594e-ac9e-4c1be102a466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186722397} :answer-field/id #uuid "59332158-366d-514f-8e32-fc08973153eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722401}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5d590ec8-8697-55da-a041-c23ad60e4df7" :question/problem "![](images/1c/1c9a038c2ca74c36cb49b3677b4ba6b80e4ed7fc7d0899eb828a4d6ecbace2e0.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(3 \\sqrt{2},\\frac{5 \\pi}{6})$ and the marked angle is $\\angle AOB=\\frac{7 \\pi}{12}$.\n\nDetermine the exact Cartesian coordinates of $B$.\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$ {{field-2}}$)$." :question/worked-solution "Both points lie on the same circle, so $B$ has radius $3 \\sqrt{2}$. Along the marked arc, moving from $A$ to $B$ is clockwise; subtract the marked angle.\n\n$$\n\\theta_B=\\frac{5 \\pi}{6}-\\frac{7 \\pi}{12}=\\frac{10\\pi}{12}-\\frac{7\\pi}{12}=\\frac{\\pi}{4}.\n$$\n\nThus $B$ has polar coordinates $(3 \\sqrt{2},\\frac{\\pi}{4})$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=3 \\sqrt{2}\\cos\\left(\\frac{\\pi}{4}\\right)=3 \\sqrt{2}\\left(\\frac{\\sqrt{2}}{2}\\right)=3,\\\\y &=3 \\sqrt{2}\\sin\\left(\\frac{\\pi}{4}\\right)=3 \\sqrt{2}\\left(\\frac{\\sqrt{2}}{2}\\right)=3.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(3,3)$."}] [{:db/id #edb/ref 17592186722407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da8c46f7-a35e-561e-ab33-f2475589143c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7}{2}" :db/id #edb/ref 17592186722413}] :answer-field/correct {:answer/id #uuid "da8c46f7-a35e-561e-ab33-f2475589143c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7}{2}" :db/id #edb/ref 17592186722413} :answer-field/id #uuid "a05ad7d4-1093-5275-bbae-e3eea8b478ad" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722411} {:answer-field/choices [{:answer/id #uuid "079f93d1-76c4-5bda-89fd-b448b1abf5d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{3}}{2}" :db/id #edb/ref 17592186722393}] :answer-field/correct {:answer/id #uuid "079f93d1-76c4-5bda-89fd-b448b1abf5d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{3}}{2}" :db/id #edb/ref 17592186722393} :answer-field/id #uuid "e63c7f79-30ae-52ea-ae25-2efcecfe68df" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722415}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "92556bc8-7ad9-546a-896c-0a996e5fdbb3" :question/problem "![](images/4d/4de04f48cc9db6c90301b15849b0634a6952500f3275372a4aa14b14ad739116.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(7,\\frac{\\pi}{4})$ and the marked angle is $\\angle AOB=\\frac{13 \\pi}{12}$.\n\nDetermine the exact Cartesian coordinates of $B$.\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$ {{field-2}}$)$." :question/worked-solution "Both points lie on the same circle, so $B$ has radius $7$. Along the marked arc, moving from $A$ to $B$ is counterclockwise; add the marked angle.\n\n$$\n\\theta_B=\\frac{\\pi}{4}+\\frac{13 \\pi}{12}=\\frac{3\\pi}{12}+\\frac{13\\pi}{12}=\\frac{4 \\pi}{3}.\n$$\n\nThus $B$ has polar coordinates $(7,\\frac{4 \\pi}{3})$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=7\\cos\\left(\\frac{4 \\pi}{3}\\right)=7\\left(- \\frac{1}{2}\\right)=- \\frac{7}{2},\\\\y &=7\\sin\\left(\\frac{4 \\pi}{3}\\right)=7\\left(- \\frac{\\sqrt{3}}{2}\\right)=- \\frac{7 \\sqrt{3}}{2}.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(- \\frac{7}{2},- \\frac{7 \\sqrt{3}}{2})$."}] [{:db/id #edb/ref 17592186722409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "883780d1-9f56-5c76-8132-226b60ae4fd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186722405}] :answer-field/correct {:answer/id #uuid "883780d1-9f56-5c76-8132-226b60ae4fd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186722405} :answer-field/id #uuid "363c2fc1-a4ae-5731-901c-96c5fed1ab4a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722398} {:answer-field/choices [{:answer/id #uuid "9002c560-dc48-5e91-bf04-d4a32f6dfd78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186722406}] :answer-field/correct {:answer/id #uuid "9002c560-dc48-5e91-bf04-d4a32f6dfd78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186722406} :answer-field/id #uuid "6fb78c5f-67f6-5780-a623-00ad7bb6b65e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722404}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9b59c857-813f-569b-ad28-000866a77515" :question/problem "![](images/cc/ccf554ba2d8974f9ef26b9dcf1e32cbae1c67cbc46fdd055350c7e732d6ef81d.png)\n\nThe diagram shows $A$ and $B$ on a circle centered at the origin $O$. Point $A$ has polar coordinates $(3,\\frac{2 \\pi}{3})$ and the marked angle is $\\angle AOB=\\frac{\\pi}{12}$.\n\nDetermine the exact Cartesian coordinates of $B$.\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$ {{field-2}}$)$." :question/worked-solution "Both points lie on the same circle, so $B$ has radius $3$. Along the marked arc, moving from $A$ to $B$ is counterclockwise; add the marked angle.\n\n$$\n\\theta_B=\\frac{2 \\pi}{3}+\\frac{\\pi}{12}=\\frac{8\\pi}{12}+\\frac{1\\pi}{12}=\\frac{3 \\pi}{4}.\n$$\n\nThus $B$ has polar coordinates $(3,\\frac{3 \\pi}{4})$. Using $x=r\\cos\\theta$ and $y=r\\sin\\theta$,\n\n$$\n\\begin{aligned}\nx &=3\\cos\\left(\\frac{3 \\pi}{4}\\right)=3\\left(- \\frac{\\sqrt{2}}{2}\\right)=- \\frac{3 \\sqrt{2}}{2},\\\\y &=3\\sin\\left(\\frac{3 \\pi}{4}\\right)=3\\left(\\frac{\\sqrt{2}}{2}\\right)=\\frac{3 \\sqrt{2}}{2}.\n\\end{aligned}\n$$\n\nThe Cartesian coordinates of $B$ are $(- \\frac{3 \\sqrt{2}}{2},\\frac{3 \\sqrt{2}}{2})$."}] [{:db/id #edb/ref 17592186722416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc1e00b5-8abc-508c-ab4f-ff119f21afcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{2}}{2}" :db/id #edb/ref 17592186722414}] :answer-field/correct {:answer/id #uuid "dc1e00b5-8abc-508c-ab4f-ff119f21afcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5 \\sqrt{2}}{2}" :db/id #edb/ref 17592186722414} :answer-field/id #uuid "9bdd40c9-60a0-57bc-883a-c66f12256a1d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186722410} {:answer-field/choices [{:answer/id #uuid "5601f10f-e649-5314-98d8-10e23b1c525f" :answer/type {:db/id #edb/ref 1