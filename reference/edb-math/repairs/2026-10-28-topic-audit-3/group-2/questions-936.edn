cdot \\left(\\frac{\\sqrt{2}}{2}\\right) \\\\  & =4\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\sqrt{2}\\cdot \\operatorname{sin}⁡\\left(\\frac{7\\pi }{4}\\right) \\\\  & =4\\sqrt{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(4,-4).$"}] [{:db/id #edb/ref 17592186564649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbbf92a9-0fa4-55a1-bb95-e955f0f6000e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186564640}] :answer-field/correct {:answer/id #uuid "cbbf92a9-0fa4-55a1-bb95-e955f0f6000e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186564640} :answer-field/id #uuid "8fc758cc-47c4-548c-ae73-2759315e3a50" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564624} {:answer-field/choices [{:answer/id #uuid "cade5ed0-20d9-555b-a2c3-66740930ee9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186564639}] :answer-field/correct {:answer/id #uuid "cade5ed0-20d9-555b-a2c3-66740930ee9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186564639} :answer-field/id #uuid "a844a994-b578-5d96-81f7-8be19373954c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564632}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f352f389-972c-5549-a153-30f04a85aa31" :question/problem "If the distance from a point $P$ to the origin is $5\\sqrt{2},$ and that $P$ makes an angle of $\\frac{\\pi }{4}$ with the positive $x$-axis, then the Cartesian 