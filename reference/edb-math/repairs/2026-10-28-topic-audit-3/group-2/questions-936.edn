t) \\\\   & =2\\cdot\\left(-\\frac{1}{2}\\right) \\\\   & =-1\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-\\sqrt{3},-1).$"}] [{:db/id #edb/ref 17592186550166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b8f1b37-d179-55a2-8bdb-b8e5114e6a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186550123} {:answer/id #uuid "548319ac-3265-5a34-bb26-497ddb9afd2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-4\\sqrt{3})" :db/id #edb/ref 17592186550136} {:answer/id #uuid "641d2665-d10f-5535-ab2c-72bc489e588d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,0)" :db/id #edb/ref 17592186550142} {:answer/id #uuid "c248991e-d7e3-543a-bc27-44eb8bf16b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-8)" :db/id #edb/ref 17592186550161} {:answer/id #uuid "c8056e82-36e7-5ff9-8524-d0cf2051f709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4\\sqrt{3},-4)" :db/id #edb/ref 17592186550164}] :answer-field/correct {:answer/id #uuid "c248991e-d7e3-543a-bc27-44eb8bf16b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-8)" :db/id #edb/ref 17592186550161} :answer-field/id #uuid "7cc22fb0-8b96-50d7-81b9-3c21feb2ca19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186550153}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d7847b88-33c8-5f91-b129-21317935c9af" :question/problem "The point $A$ has polar coordinates $(4,\\theta )$ and the point $B$ has polar coordinates $(8,\\theta +\\frac{\\pi }{3}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-\\sqrt{12},-2).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find its reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡\\left(\\frac{-2}{-\\sqrt{12}}\\right) \\\\  & =\\operatorname{arctan}⁡(1/\\sqrt{3}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nSince the point $A$ lies in the third quadrant, we have $\\theta =\\pi +{\\theta }_{R}=\\frac{7\\pi }{6}.$ Consequently, the polar coordinates of $B$ are\n\n$$\n(8,\\frac{7\\pi }{6}+\\frac{\\pi }{3})=(8,\\frac{3\\pi }{2}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\cdot \\operatorname{cos}⁡\\left(\\frac{3\\pi }{2}\\right) \\\\  & =0\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\cdot \\operatorname{sin}⁡\\left(\\frac{3\\pi }{2}\\right) \\\\  & =-8\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(0,-8).$"}] [{:db/id #edb/ref 17592186564601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03557524-3809-52d4-9d68-9faf937bdb58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},\\frac{\\sqrt{3}}{2})" :db/id #edb/ref 17592186564600} {:answer/id #uuid "224f63a5-963c-5451-b6e8-7fba150db1a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{2},-\\frac{\\sqrt{3}}{2})" :db/id #edb/ref 17592186564602} {:answer/id #uuid "343fd6ee-2f12-525f-b827-6036ba3e52e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{3}}{2},-\\frac{1}{2})" :db/id #edb/ref 17592186564609} {:answer/id #uuid "9c8cec09-fbba-518e-ad05-89fcd612bc74" :answer/type {:db/id #edb/ref 