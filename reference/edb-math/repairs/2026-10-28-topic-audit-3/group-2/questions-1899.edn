6d5a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186276902} {:answer/id #uuid "3fa5338f-2040-50a2-8215-a65d278835dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0\\}" :db/id #edb/ref 17592186564077} {:answer/id #uuid "5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y<1\\}" :db/id #edb/ref 17592186564117} {:answer/id #uuid "802c8eca-f606-57bb-ba41-d622b1cfd092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y>0\\}" :db/id #edb/ref 17592186564163} {:answer/id #uuid "d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne -1\\}" :db/id #edb/ref 17592186564312}] :answer-field/correct {:answer/id #uuid "3fa5338f-2040-50a2-8215-a65d278835dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0\\}" :db/id #edb/ref 17592186564077} :answer-field/id #uuid "df108a95-6e90-54f8-bc6b-d51e2e24412d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278119}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "83b99b1c-0bfd-5266-a9a8-e11b90bb0b2b" :question/math-academy-id "q-158553" :question/problem "Find the domain of the function $f(x,y)=\\frac{1}{2x+y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2x+y\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0\\}.\n$$"}] [{:db/id #edb/ref 17592186278205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a3f1208-d233-59ef-ae53-26ae3eaff7a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 1}" :db/id #edb/ref 17592186275564} {:answer/id #uuid "40e308d4-bcfd-5dfb-b729-57cd9643869c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186276044} {:answer/id #uuid "516afa51-e41f-506c-a2d1-36db9c13e327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}=1}" :db/id #edb/ref 17592186276206} {:answer/id #uuid "59fa2ef6-3ffb-5ccc-a67a-68e0fcf8768c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0}" :db/id #edb/ref 17592186276284} {:answer/id #uuid "a1711c23-3a76-5369-ace7-f9d33593f559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>1}" :db/id #edb/ref 17592186276931}] :answer-field/correct {:answer/id #uuid "0a3f1208-d233-59ef-ae53-26ae3eaff7a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 1}" :db/id #edb/ref 17592186275564} :answer-field/id #uuid "641e5bb9-0e06-5e49-9887-b21be6bf1d9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277904}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2692792d-2735-5350-8ee6-ccf7381cbdd2" :question/math-academy-id "q-158556" :question/problem "Find the domain of the function $f(x,y)=\\frac{x+{y}^{3}}{{x}^{2}-{y}^{2}-1}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}-{y}^{2}-1\\ne 0\\,⟹\\,{x}^{2}-{y}^{2}\\ne 1\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 1}.\n$$"}] [{:db/id #edb/ref 17592186278206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e0aacd4-d4a8-5b60-ae14-4d802dccae40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x<1,\\,{x}^{2}+{y}^{2}\\ne 0}" :db/id #edb/ref 17592186276462} {:answer/id #uuid "7bb7e44c-d94f-5ac6-922c-02f992f2e2c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge 1,\\,{x}^{2}+{y}^{2}\\ne 0}" :db/id #edb/ref 17592186276602} {:answer/id #uuid "a3b6c20f-3a4c-5fe7-aec7-13cbae8d61d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge 1,\\,{x}^{2}+{y}^{2}\\ne 1}" :db/id #edb/ref 17592186276952} {:answer/id #uuid "e30fc058-11ff-5f18-9e4e-e36017ee3543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x=1,\\,{x}^{2}+{y}^{2}\\ne 1}" :db/id #edb/ref 17592186277462} {:answer/id #uuid "f606b79d-99b8-5444-9b03-c493099e542a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186277630}] :answer-field/correct {:answer/id #uuid "a3b6c20f-3a4c-5fe7-aec7-13cbae8d61d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge 1,\\,{x}^{2}+{y}^{2}\\ne 1}" :db/id #edb/ref 17592186276952} :answer-field/id #uuid "997fdcc1-0ced-5785-a34d-fb5ab7d843fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277998}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a22a64f-170d-5095-a7c1-d8735a6757c8" :question/math-academy-id "q-158558" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{x-1}}{{x}^{2}+{y}^{2}-1}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}x-1\\ge 0 \\\\ {x}^{2}+{y}^{2}-1\\ne 0\\end{aligned}\\,⟹\\,{\\begin{aligned}x\\ge 1 \\\\ {x}^{2}+{y}^{2}\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x\\ge 1,\\,{x}^{2}+{y}^{2}\\ne 1}.\n$$"}] [{:db/id #edb/ref 17592186278207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59d9500b-f8cf-5a73-bfb3-c9612186858f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}\\ne 4}" :db/id #edb/ref 17592186276283} {:answer/id #uuid "74c3e355-8385-5f88-9130-8b55937e954c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186276533} {:answer/id #uuid "96396b81-d6de-5d67-8109-c2fbb2e16be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}>4}" :db/id #edb/ref 17592186276829} {:answer/id #uuid "d32b4094-490f-54e9-b056-ee9c6d9c4f5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne y,\\,{x}^{2}+{y}^{2}\\ne 4}" :db/id #edb/ref 17592186277340} {:answer/id #uuid "d70d8