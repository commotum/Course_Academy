#uuid "b505ca05-1820-5c4b-a3d6-bb10e90240fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{π}{2}" :db/id #edb/ref 17592186121417} {:answer/id #uuid "3b1bc846-1fcb-59cf-a29e-29f19714b588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186121418} {:answer/id #uuid "580cb253-53e1-518b-8fa9-b34e2e07f27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{π + 1}" :db/id #edb/ref 17592186121419} {:answer/id #uuid "61a6496f-deaf-59c9-8193-0698971ffb50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186121420}] :answer-field/id #uuid "11d89977-9f4d-55e6-9cb2-8573a36c1a90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121415} {:answer-field/choices [{:answer/id #uuid "c4e68527-6fb2-5ff6-96ca-f5fc9769e4e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi +1}" :db/id #edb/ref 17592186378754} {:answer/id #uuid "f2935c1f-71a8-5bd2-a8a7-96a552912d98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186378755} {:answer/id #uuid "766b5d61-be2d-57b2-80fc-975a92b07181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186378756} {:answer/id #uuid "2fbd0b00-5e71-54ba-a416-cdf010be6a2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186378757} {:answer/id #uuid "e59e19f8-1d80-580e-a383-419751df02f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186378758}] :answer-field/correct {:answer/id #uuid "2fbd0b00-5e71-54ba-a416-cdf010be6a2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186378757} :answer-field/id #uuid "5d6cea74-bd5c-5627-88f4-4c756116d33c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378753}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e770662e-a895-500b-9b37-57f120f5b59c" :question/math-academy-id "q-158243" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=\\frac{\\operatorname{cos}⁡(xy)}{y+1}.\n$$\n\nEvaluate this function at the point $(\\pi ,-1).$" :question/worked-solution "To evaluate our multivariable function at the point $(\\pi ,-1),$ we substitute $x=\\pi $ and $y=-1$ into the function expression:\n\n$$\n\\begin{aligned}f(\\pi ,-1) & =\\frac{\\operatorname{cos}⁡(xy)}{y+1}{|}_{(\\pi ,-1)} \\\\  & =\\frac{\\operatorname{cos}⁡(\\pi \\cdot 1)}{-1+1} \\\\  & =\\frac{-1}{0},\\end{aligned}\n$$\n\nwhich is undefined."}] [{:db/id #edb/ref 17592186124804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d569954b-a9bd-5e60-8d8d-dc21240f8373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186121422} {:answer/id #uuid "31ab3514-afb9-55f0-b797-5d67fafbd447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186121423} {:answer/id #uuid "50456efb-8153-58c0-b558-6f6aca1e4608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186121424} {:answer/id #uuid "55fccb26-6f80-5c7f-a2da-3df8bb2dc868" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186121425} {:answer/id #uuid "69feff14-68ef-55b8-89be-19860c1c8bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186121426}] :answer-field/correct {:answer/id #uuid "69feff14-68ef-55b8-89be-19860c1c8bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186121426} :answer-field/id #uuid "4a5c3de9-0c28-55d6-a0e6-dcc003a6afdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121421}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15761064-db02-546d-ba8e-469a8fb53fd1" :question/math-academy-id "q-158245" :question/problem "Evaluate $z={x}^{2}+xy-5$ at the point $(1,2).$" :question/worked-solution "To evaluate our multivariable function at the point $(1,2),$ we substitute $x=1$ and $y=2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(1,2)} & =({x}^{2}+xy-5)\\,{|}_{(1,2)} \\\\  & =(1)^{2}+(1)(2)-5 \\\\  & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "587f5542-5a27-517a-84b1-e66f5d47860c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}<1}" :db/id #edb/ref 17592186276271} {:answer/id #uuid "5a4ffc4d-b07e-549b-a751-a3d91ba357d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0}" :db/id #edb/ref 17592186276289} {:answer/id #uuid "77583919-d19f-5129-8df8-e7e6b74fea75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>1}" :db/id #edb/ref 17592186276559} {:answer/id #uuid "7efc28bb-059b-500e-87f9-668f0875eb75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186276629} {:answer/id #uuid "f617ba46-61de-54bf-a41e-c0e566ae9f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne y}" :db/id #edb/ref 17592186277631}] :answer-field/correct {:answer/id #uuid "7efc28bb-059b-500e-87f9-668f0875eb75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186276629} :answer-field/id #uuid "f77abaf8-7358-5457-b8b2-4285d46b13bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278159}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "80d6d429-d2f8-586a-b19e-c50b52dbc8e3" :question/math-academy-id "q-158438" :question/problem "Find the domain of the function $f(x,y)={e}^{{x}^{2}-{y}^{2}}.$" :question/worked-solution "Notice that\n\n- ${x}^{2}-{y}^{2}$ is defined for all $x$ and $y,$ and\n\n- ${e}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${e}^{{x}^{2}-{y}^{2}}$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane."}] [{:db/id #edb/ref 17592186275453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df3e244c-ae04-56cb-8d2f-103fe2a767ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186274357} {:answer/id #uuid "0401f3db-693c-55a6-a2a6-cdcb8f618641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<0\\}" :db/id #edb/ref 17592186563976} {:answer/id #uuid "56d57d91-2728-51bc-b291-e2245cc07a65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}" :db/id #edb/ref 17592186564108} {:answer/id #uuid "b88c88cc-ef4e-5607-aff6-aeedbfce6369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}>1\\}" :db/id #edb/ref 17592186564254} {:answer/id #uuid "cc963b79-b269-5331-848d-67f4ee353859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}" :db/id #edb/ref 17592186564289}] :answer-field/correct {:answer/id #uuid "cc963b79-b269-5331-848d-67f4ee353859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}" :db/id #edb/ref 17592186564289} :answer-field/id #uuid "7d3ee636-ed6b-5d29-ac3b-8e818ea5617f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274851}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8022d60c-ad02-52ea-a2bc-6bcc108f5f02" :question/math-academy-id "q-158179" :question/problem "Find the domain of the function $z=\\frac{1}{\\sqrt{1-{x}^{2}-{y}^{2}}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n\\begin{aligned}1-{x}^{2}-{y}^{2}>0\\,⟹\\,{x}^{2}+{y}^{2}<1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}.\n$$"}] [{:db/id #edb/ref 17592186275454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59eb15d3-b888-5e22-8f7f-3b9a0485253b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c86e0f4cb86cfed0b6ada08c56c1582fac05b5be00a7c0ba837aa3154e2f0cee.png" :db/id #edb/ref 17592186273158} {:answer/id #uuid "5ba29654-047e-57de-94d6-6059378aff7b" :answer/type {:db/id #edb/ref 17592186045497 :db/id