{:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186564182} {:answer/id #uuid "9f3293bb-1f94-5c8d-a23a-3cb06b1be4a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\pi " :db/id #edb/ref 17592186564210}] :answer-field/correct {:answer/id #uuid "6348d00d-0685-5ea8-9c47-f047fe568924" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186564124} :answer-field/id #uuid "10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564380}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "be7cd3c6-b4d8-58fc-a0bb-f9185ad55778" :question/math-academy-id "q-158568" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=x\\operatorname{arccos}⁡(y+1).\n$$\n\nEvaluate this function at the point $(-3,1).$" :question/worked-solution "To evaluate our multivariable function at the point $(-3,1),$ we substitute $x=-3$ and $y=1$ into the function expression:\n\n$$\n\\begin{aligned}f(-3,1) & =x\\operatorname{arccos}⁡(y+1)\\,{|}_{(-3,1)} \\\\  & =-3\\operatorname{arccos}⁡(1+1) \\\\  & =-3\\operatorname{arccos}⁡2,\\end{aligned}\n$$\n\nwhich is undefined."}] [{:db/id #edb/ref 17592186564533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c87b3c0-88bd-5bcd-8655-c1b7cc94de43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186563988} {:answer/id #uuid "2e779e34-e7fe-559c-8a5e-d6acdf7c0dc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne y,\\,x\\ne 0\\}" :db/id #edb/ref 17592186564046} {:answer/id #uuid "809ffa9f-fc24-57db-8fe0-6f88da3c8f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x>y\\}" :db/id #edb/ref 17592186564165} {:answer/id #uuid "90267910-6534-5e32-a7b2-2a165379570f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne y\\}" :db/id #edb/ref 17592186564193} {:answer/id #uuid "b0f55a63-715f-589c-a5b9-f12320546593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x>y,\\,x\\ne 0\\}" :db/id #edb/ref 17592186564245}] :answer-field/correct {:answer/id #uuid "809ffa9f-fc24-57db-8fe0-6f88da3c8f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x>y\\}" :db/id #edb/ref 17592186564165} :answer-field/id #uuid "0495e322-ad63-52d2-84e8-e016c8d6367c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e5fbae1b-fa0a-5638-bec4-5b64d04c9a07" :question/math-academy-id "q-158185" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\operatorname{ln}⁡(x-y)}{{e}^{x}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nNotice that ${e}^{x}>0$ for all $x.$ Therefore, the points in the domain must satisfy the following inequality:\n\n$$\n\\begin{aligned}x-y>0\\,⟹\\,x>y\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x>y\\}.\n$$"}] [{:db/id #edb/ref 17592186564534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d5fb42b-48b0-5faa-b43e-a2cc7b0c3a9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1<x<1,\\,y\\ne 0\\}" :db/id #edb/ref 17592186564045} {:answer/id #uuid "47325857-bade-5abe-940b-58d047f337df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x>0,\\,y\\ne 0\\}" :db/id #edb/ref 17592186564087} {:answer/id #uuid "ac6f7aeb-aa8b-5188-b690-7774d66d49cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186564233} {:answer/id #uuid "be3d5d38-7205-5015-a8b8-93d91f6b0ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne \\pm 1,\\,y\\ne 0\\}" :db/id #edb/ref 17592186564259} {:answer/id #uuid "d1a17952-6dd7-5e95-8f91-a446078ae611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1<x<1,\\,y>0\\}" :db/id #edb/ref 17592186564302}] :answer-field/correct {:answer/id #uuid "2d5fb42b-48b0-5faa-b43e-a2cc7b0c3a9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1<x<1,\\,y\\ne 0\\}" :db/id #edb/ref 17592186564045} :answer-field/id #uuid "f1449eb3-c226-5410-a948-814f6bd35c51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564458}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e70a4727-f486-57b6-aa40-dbf0dba8fb16" :question/math-academy-id "q-158191" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\operatorname{ln}⁡(1-{x}^{2})}{y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}1-{x}^{2}>0 \\\\ y\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-1<x<1 \\\\ y\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,-1<x<1,\\,y\\ne 0\\}.\n$$"}] [{:db/id #edb/ref 17592186564538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeac4431-91c7-5505-8522-2946cd2d43cc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/44/4453ab63ec12361c69cffbf76bd51d63a9ef985b54452f7f84e37ed7dee21c39.png" :db/id #edb/ref 17592186564236} {:answer/id #uuid "cdf6bb0c-4f48-5455-b7c2-33db2af70756" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9c/9c2a0516ca58c52ccecadade60e966563b442f3112cce73cb16c1931c2087cd8.png" :db/id #edb/ref 17592186564291} {:answer/id #uuid "e69db1ea-c330-5536-8560-08f5b1e80164" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/338809ca0a3fe4d02c3523ec5e34a8d07a00b297d9f468740bbd1800d9675941.png" :db/id #edb/ref 17592186564331} {:answer/id #uuid "fb69bb38-f4d8-5144-bff4-908369a1e63a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/402d90507403eabf4cd35cde83a45c9fa2d8080347e1debb0e2463be408b489b.png" :db/id #edb/ref 17592186564373} {:answer/id #uuid "ff779dbe-e82e-5919-99da-f2d26cecb00a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b8fe923f727ca57a8a2cfc756b93c0ed522bdd9edcc06c8097bead979c8e4b15.png" :db/id #edb/ref 17592186564375}] :answer-field/correct {:answer/id #uuid "fb69bb38-f4d8-5144-bff4-908369a1e63a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/402d90507403eabf4cd35cde83a45c9fa2d8080347e1debb0e2463be408b489b.png" :db/id #edb/ref 17592186564373} :answer-field/id #uuid "b0c62e6a-7044-5e8e-b3aa-7123ad96f32d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564433}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f90f5dc8-4e9d-5e87-800a-708d8b32cd8d" :question/math-academy-id "q-158196" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\sqrt{{x}^{2}+{y}^{2}+1}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}+{y}^{2}+1\\ge 0\n$$\n\nSince the inequality ${x}^{2}+{y}^{2}+1\\ge 0$ is true for all values of $x$ and $y,$ the domain of the function $f$ is the entire $xy$-plane.\n\nThe resulting domain is as follows:\n\n![](images/40/402d90507403eabf4cd35cde83a45c9fa2d8080347e1debb0e2463be408b489b.png)"}] [{:db/id #edb/ref 17592186593299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101216b6-38fb-5078-940f-17359e5c5770" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4c/4ca797c5ac8d7158fc5af9e7421349ac3ff908de9d46312539b64a02347fa21d.png" :db/id #edb/ref 17592186592378} {:answer/id #uuid "27f83231-cf36-5e4a-97ff-69d69eb26328" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5e/5e88ccf29cea8e641d9002c236ed04d1300ad475aa0ddc6d819289b6f85cb3be.png" :db/id #edb/ref 17592186592458} {:answer/id #uuid "2c23374a-c62a-5ffc-82d4-b4cdc168d41e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4add22572db01658a9c909f66be2d53f14331454ab32577ced33011fe05fafa.png" :db/id #edb/ref 17592186592468} {:answer/id #uuid "69b1d542-17f5-5761-988e-79d65121a637" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ff/ffa3279d89347ba4176e43b8e21dfd5d9a6ad955b36f8582efb51e3c737276e5.png" :db/id #edb/ref 17592186592629} {:answer/id #uuid "ffd01bc3-5cc2-57b2-8074-04dd0ed389b2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/69/69d110e4eb184437c04ac9c0e23138f78d266416e605c31837a382ab90ae6e84.png" :db/id #edb/ref 17592186593011}] :answer-field/correct {:answer/id #uuid "ffd01bc3-5cc2-57b2-8074-04dd0ed389b2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/69/69d110e4eb184437c04ac9c0e23138f78d266416e605c31837a382ab90ae6e84.png" :db/id #edb/ref 17592186593011} :answer-field/id #uuid "86077ad8-2754-5257-b5ab-3609ca6d0112" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593108}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8d03db3-7c5a-5bd7-8cd4-aef29b72c104" :question/math-academy-id "q-158207" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\frac{1}{{x}^{2}-y}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}-y\\ne 0\\,⟹\\,y\\ne {x}^{2}\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ne {x}^{2}\\}.\n$$\n\nSince the expression involves the $\\ne$ sign, the curve is *not* part of the domain. Therefore, we draw the dashed curve $y={x}^{2}$ and shade *above* and *below* the curve.\n\nThe resulting domain is as follows:\n\n![](images/e6/e6fff00937aa9a20c6e8c1e83dd65c483ae6b403b55b4ac3054d4032249ffedb.png)"}] [{:db/id #edb/ref 17592186660367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082b4bca-f032-5f58-a356-850bed4cfba4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186659843} {:answer/id #uuid "0843910f-2730-5ef6-897f-0b82505824fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186659845} {:answer/id #uuid "466b598b-42bf-55ae-a13a-9a2c405d8fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186659949} {:answer/id #uuid "90961f41-2c4a-5baa-8170-fe4d93f8b765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186660045} {:answer/id #uuid "b146e32e-aacc-589c-95f3-68a004c8ed2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186660104}] :answer-field/correct {:answer/id #uuid "466b598b-42bf-55ae-a13a-9a2c405d8fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186659949} :answer-field/id #uuid "164892c2-e8be-5b74-90f5-e8b2173065fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186660223}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8d3d0dc-4e09-5317-a46e-76157b0c960f" :question/math-academy-id "q-158579" :question/problem "Evaluate $z=2\\operatorname{arctan}⁡y-x$ at the point $(\\pi ,1).$" :question/worked-solution "To evaluate our multivariable function at the point $(\\pi ,1),$ we substitute $x=\\pi$ and $y=1$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(\\pi ,1)} & =(2\\operatorname{arctan}⁡y-x){|}_{(\\pi ,1)} \\\\  & =2\\operatorname{arctan}⁡1-\\pi  \\\\  & =2\\left(\\frac{\\pi }{4}\\right)-\\pi  \\\\  & =\\frac{\\pi }{2}-\\pi  \\\\  & =-\\frac{\\pi }{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186696267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0f05b8-d1ca-515b-b13e-de8f833c5e88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane." :db/id #edb/ref 17592186696266} {:answer/id #uuid "2a97564f-3a45-55ca-a470-ee41566bf188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ne x+1\\}" :db/id #edb/ref 17592186696269} {:answer/id #uuid "50d83121-4e26-5959-bb9d-ef802846de81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ne x-1\\}" :db/id #edb/ref 17592186696274} {:answer/id #uuid "596c9bff-33b9-584a-8233-b0702c9d8767" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y=x+1\\}" :db/id #edb/ref 17592186696275} {:answer/id #uuid "a2fa7806-546a-594b-b7be-b1bfd6a33191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y>x+1\\}" :db/id #edb/ref 17592186696278}] :answer-field/correct {:answer/id #uuid "2a97564f-3a45-55ca-a470-ee41566bf188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ne x+1\\}" :db/id #edb/ref 17592186696269} :answer-field/id #uuid "b23f1674-bc5b-54ca-941c-e0f627e7af69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696280}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10ad9171-c2f9-573b-87a4-c5968cfcfcfb" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{x+2y}{x-y+1}$." :question/requires-calculator false :question/worked-solution "The numerator is a polynomial, so it imposes no restrictions. The function is well-defined precisely when its denominator is nonzero:\n\n$$\nx-y+1\\ne 0\\quad\\Longleftrightarrow\\quad y\\ne x+1.\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ne x+1\\}.\n$$\n\nPoints on either side of the line are allowed. Only the line $y=x+1$ is excluded."}] [{:db/id #edb/ref 17592186696271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c5a9fd0-6577-5446-a0c8-e3ae2391442a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y>-1,\\ x^2+y^2\\le 4,\\ x^2+y^2\\ne 3\\}" :db/id #edb/ref 17592186696268} {:answer/id #uuid "5013356f-ee8c-5575-9ecd-508be5344bba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -1,\\ x^2+y^2<3\\}" :db/id #edb/ref 17592186696273} {:answer/id #uuid "6c7ec6ad-f7e5-5400-80bf-35bfc85dc4a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -1,\\ x^2+y^2\\le 4,\\ x^2+y^2\\ne 1\\}" :db/id #edb/ref 17592186696276} {:answer/id #uuid "d01d0778-b159-55c5-bf91-5e3b6df41a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -1,\\ x^2+y^2<4,\\ x^2+y^2\\ne 3\\}" :db/id #edb/ref 17592186696282} {:answer/id #uuid "e07c5b98-a84e-5636-b20c-edec468f2423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -1,\\ x^2+y^2\\le 4,\\ x^2+y^2\\ne 3\\}" :db/id #edb/ref 17592186696285}] :answer-field/correct {:answer/id #uuid "e07c5b98-a84e-5636-b20c-edec468f2423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -1,\\ x^2+y^2\\le 4,\\ x^2+y^2\\ne 3\\}" :db/id #edb/ref 17592186696285} :answer-field/id #uuid "94ab6641-11e4-5adf-a26e-090645e7f748" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696277}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4312adfd-d331-5073-842a-15da34b52fee" :question/problem "Find the domain of the function $z=\\dfrac{\\sqrt{y+1}}{\\sqrt{4-x^2-y^2}-1}$." :question/requires-calculator false :question/worked-solution "Three conditions must hold:\n\n- The numerator's radicand is nonnegative: $y+1\\ge 0$.\n- The denominator's radicand is nonnegative: $4-x^2-y^2\\ge 0$.\n- The whole denominator is nonzero: $\\sqrt{4-x^2-y^2}-1\\ne 0$.\n\nThe first two conditions give $y\\ge -1$ and $x^2+y^2\\le 4$. To find the excluded points within this region, solve the denominator-zero equation:\n\n$$\n\\begin{aligned}\n\\sqrt{4-x^2-y^2}-1&=0\\\\\n\\sqrt{4-x^2-y^2}&=1\\\\\n4-x^2-y^2&=1\\\\\nx^2+y^2&=3.\n\\end{aligned}\n$$\n\nSquaring introduces no extra solutions here: both sides of the square-root equation are nonnegative. Therefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -1,\\ x^2+y^2\\le 4,\\ x^2+y^2\\ne 3\\}.\n$$\n\nThe outer boundary $x^2+y^2=4$ is allowed wherever $y\\ge -1$: there the denominator is $-1$, not zero. The excluded circle has $x^2+y^2=3$, and only its portion in the allowed region matters. For example, $(2,0)$ and $(0,-1)$ are in the domain, while $(\\sqrt{3},0)$ is excluded."}] [{:db/id #edb/ref 17592186696286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e56bcd5-d1be-5e4b-86d4-249760450dbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane." :db/id #edb/ref 17592186696270} {:answer/id #uuid "4ae7cfad-e9a3-5a55-a843-c589b842ca1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -2,\\ y>1-x\\}" :db/id #edb/ref 17592186696272} {:answer/id #uuid "af9e17e6-3806-543b-abcf-c0bec8b56956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y>-2,\\ y\\ne 1-x\\}" :db/id #edb/ref 17592186696279} {:answer/id #uuid "cff25eff-e12f-55d9-823f-2f916b116246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -2,\\ y\\ne 1-x\\}" :db/id #edb/ref 17592186696281} {:answer/id #uuid "d5bd6ca3-5b29-5d54-90dc-fef0336a20bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge 2,\\ y\\ne 1-x\\}" :db/id #edb/ref 17592186696284}] :answer-field/correct {:answer/id #uuid "cff25eff-e12f-55d9-823f-2f916b116246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -2,\\ y\\ne 1-x\\}" :db/id #edb/ref 17592186696281} :answer-field/id #uuid "d5205777-f1f0-5f16-a643-43c27046cc84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696283}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fb9d298c-6775-5390-a7d6-dab7ca9c4184" :question/problem "Find the domain of the function $z=\\dfrac{\\sqrt{y+2}}{x+y-1}$." :question/requires-calculator false :question/worked-solution "The function is well-defined at all points $(x,y)$ for which both conditions hold:\n\n- The expression under the square root is nonnegative.\n- The denominator is nonzero.\n\nThus,\n\n$$\n\\begin{aligned}\ny+2&\\ge 0 &&\\Longleftrightarrow\\quad y\\ge -2,\\\\\nx+y-1&\\ne 0 &&\\Longleftrightarrow\\quad y\\ne 1-x.\n\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge -2,\\ y\\ne 1-x\\}.\n$$\n\nA zero numerator is allowed, so the boundary $y=-2$ is included except at $(3,-2)$, where the denominator is zero. The denominator may be positive or negative."}] [{:db/id #edb/ref 17592186696514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df6821d-175c-5db6-9e0e-b1084d04933b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186696512} {:answer/id #uuid "2478da9b-d6d0-55d6-90b7-7146eb2df2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186696513} {:answer/id #uuid "2cbc2e61-f9fe-532c-8184-cbd91f6ac538" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696515} {:answer/id #uuid "970a11b7-5796-5680-b00c-069f325d7a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186696524} {:answer/id #uuid "c97a5901-05dc-5f47-a462-5acc3509ad62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{20}{7}" :db/id #edb/ref 17592186696527}] :answer-field/correct {:answer/id #uuid "2478da9b-d6d0-55d6-90b7-7146eb2df2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186696513} :answer-field/id #uuid "cc8fe627-bd83-5fe0-97ff-59559aff3543" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696528}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2c0e2c3d-1459-5fdf-984b-feacfa06311c" :question/problem "The real-valued function $f(x,y)$ is defined by\n\n$$\nf(x,y)=\\frac{\\log_2(xy^2)+\\sqrt{x-y}}{2^{-y}-x}.\n$$\n\nEvaluate this function at the point $(2,-2)$." :question/worked-solution "Substitute $x=2$ and $y=-2$ throughout the expression:\n\n$$\n\\begin{aligned}\nf(2,-2) &= \\frac{\\log_2\\bigl(2(-2)^2\\bigr)+\\sqrt{2-(-2)}}{2^{-(-2)}-2} \\\\\n        &= \\frac{\\log_2(8)+\\sqrt{4}}{2^2-2}.\n\\end{aligned}\n$$\n\nThe logarithm has positive argument $8$, the square root has nonnegative argument $4$, and the denominator is $4-2=2$, which is nonzero. Thus the expression is defined over the real numbers. Since $2^3=8$, we have $\\log_2(8)=3$, and the principal square root of $4$ is $2$. Hence\n\n$$\n\\begin{aligned}\nf(2,-2) &= \\frac{3+2}{4-2} \\\\\n        &= \\frac{5}{2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186696521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c6b6af4-b08c-52ae-b51c-30eeeaf825b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186696519} {:answer/id #uuid "7b64f11c-8220-506b-ae00-cd41af386a50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696520} {:answer/id #uuid "8ae495cf-4cec-5833-9834-f60da6e6e435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186696522} {:answer/id #uuid "a0c203d3-a4c0-5618-85d0-0abf64fc1b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186696525} {:answer/id #uuid "f983d6f7-3792-5ada-ac34-27f362e1a8df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186696531}] :answer-field/correct {:answer/id #uuid "7b64f11c-8220-506b-ae00-cd41af386a50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696520} :answer-field/id #uuid "cdba90e2-631e-5ccd-a8a1-9e3e3dd0ec0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696529}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86737fd7-bd0c-5448-8968-f16aae1ed367" :question/problem "Evaluate the real-valued function\n\n$$\nf(x,y)=\\frac{2y-x}{x^3-y^2-7}\n$$\n\nat the point $(2,-1)$." :question/worked-solution "Substitute $x=2$ and $y=-1$ into both the numerator and the denominator:\n\n$$\n\\begin{aligned}\n2y-x &= 2(-1)-2 = -4, \\\\\nx^3-y^2-7 &= 2^3-(-1)^2-7 \\\\\n            &= 8-1-7 = 0.\n\\end{aligned}\n$$\n\nThis would require division by zero, so $f(2,-1)$ is undefined. The point $(2,-1)$ is outside the domain; the nonzero numerator does not change that."}] [{:db/id #edb/ref 17592186696526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08473013-527f-59fe-89a2-d72410d2dd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186696511} {:answer/id #uuid "53aa0249-fd83-5b76-bb77-41d31b2cc23d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186696517} {:answer/id #uuid "5a1be7b3-8d24-578e-be0f-2020af258522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186696518} {:answer/id #uuid "8f02c644-936f-5a08-ad5f-522ec52110e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696523} {:answer/id #uuid "f6a915ef-a535-5d13-8725-bb5675a37a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186696530}] :answer-field/correct {:answer/id #uuid "5a1be7b3-8d24-578e-be0f-2020af258522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186696518} :answer-field/id #uuid "3d37e191-a248-5e9e-a02a-23130fe6ab33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696516}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c09a691f-3c64-5a41-af8e-5e1505147442" :question/problem "Evaluate $z=x^2+xy-5$ at the point $(-2,3)$." :question/worked-solution "The first coordinate gives $x=-2$ and the second gives $y=3$. Substitute both values, keeping parentheses around the negative input:\n\n$$\n\\begin{aligned}\nz &= (-2)^2+(-2)(3)-5 \\\\\n  &= 4-6-5 \\\\\n  &= -7.\n\\end{aligned}\n$$\n\nTherefore, the value of the function at $(-2,3)$ is $-7$."}] [{:db/id #edb/ref 17592186696633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2e375b-fffe-5a50-9ebc-fe59809d641c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ 2y+x\\ne4\\}" :db/id #edb/ref 17592186696636} {:answer/id #uuid "92fa3133-4b4e-5576-be96-865f3933aa91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ 2y+x\\le4\\}" :db/id #edb/ref 17592186696651} {:answer/id #uuid "a294504b-050e-5ca7-a03a-32ed348b79ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\le0,\\ 2y+x\\ne4\\}" :db/id #edb/ref 17592186696653} {:answer/id #uuid "bb2883d3-0d56-5e3a-850e-6918200a45e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ 2y+x\\ge4\\}" :db/id #edb/ref 17592186696658} {:answer/id #uuid "c0dc9188-873e-5aae-9a1a-41f4820d0830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0\\}" :db/id #edb/ref 17592186696660}] :answer-field/correct {:answer/id #uuid "2b2e375b-fffe-5a50-9ebc-fe59809d641c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ 2y+x\\ne4\\}" :db/id #edb/ref 17592186696636} :answer-field/id #uuid "fe5b55e3-bd79-599d-862e-3464f7714514" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696665}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a9726d0-9f18-5e3d-ab03-fcafb0dc11bb" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{y}}{2y+x-4}$." :question/requires-calculator false :question/worked-solution "The numerator radicand must be nonnegative, and the polynomial denominator must be nonzero. A zero numerator is allowed.\n\n$$\n\\begin{aligned}\ny&\\ge 0\\quad\\Longleftrightarrow\\quad y\\ge0\\\\\n2y+x-4&\\ne 0\\quad\\Longleftrightarrow\\quad 2y+x\\ne4\n\\end{aligned}\n$$\n\n\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ 2y+x\\ne4\\}.\n$$"}] [{:db/id #edb/ref 17592186696635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d977228-f7fe-50e7-87df-172683d924ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x^2<-1,\\ 2x^3-y\\le1\\}" :db/id #edb/ref 17592186696638} {:answer/id #uuid "83f7b3b8-0aa4-5398-a583-4ed6e2b876dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x^2\\ge-1,\\ 2x^3-y\\le1\\}" :db/id #edb/ref 17592186696648} {:answer/id #uuid "9233aee3-6b51-5de6-8d60-a898483ed953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x^2\\ge-1,\\ 2x^3-y\\ne1\\}" :db/id #edb/ref 17592186696650} {:answer/id #uuid "9b4b79a7-ba3d-5eed-aa3b-33b476135fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x^2\\ge-1,\\ 2x^3-y<1\\}" :db/id #edb/ref 17592186696652} {:answer/id #uuid "b5ed480d-d129-5103-9ace-2cf41bf67501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x^2\\le-1,\\ 2x^3-y>1\\}" :db/id #edb/ref 17592186696656}] :answer-field/correct {:answer/id #uuid "9b4b79a7-ba3d-5eed-aa3b-33b476135fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x^2\\ge-1,\\ 2x^3-y<1\\}" :db/id #edb/ref 17592186696652} :answer-field/id #uuid "83c2cdb4-d7d6-552c-b8c5-b3b0a47fe6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696647}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a2c6df1-c469-5331-9c7b-2f038652b69b" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{y-x^2+1}}{\\sqrt{1-\\left(2x^3-y\\right)}}$." :question/requires-calculator false :question/worked-solution "The numerator radicand may equal zero. The denominator radicand must be strictly positive, since its square root is the complete denominator.\n\n$$\n\\begin{aligned}\ny-x^2+1&\\ge 0\\quad\\Longleftrightarrow\\quad y-x^2\\ge-1\\\\\n1-\\left(2x^3-y\\right)&>0\\quad\\Longleftrightarrow\\quad 2x^3-y<1\n\\end{aligned}\n$$\n\n\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x^2\\ge-1,\\ 2x^3-y<1\\}.\n$$"}] [{:db/id #edb/ref 17592186696642 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b577d7-84fa-52c5-ac63-31de60dafc7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x>-1,\\ 2y^3-x>1\\}" :db/id #edb/ref 17592186696632} {:answer/id #uuid "5dd978a2-100e-5c41-a81c-a22cd6f6b78f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le-1,\\ 2y^3-x>1\\}" :db/id #edb/ref 17592186696641} {:answer/id #uuid "60dea674-07ee-556c-8e66-7c033c25b3ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\ne-1,\\ 2y^3-x>1\\}" :db/id #edb/ref 17592186696644} {:answer/id #uuid "ca8d4699-a291-57c4-9552-bd24c589f60e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x<-1,\\ 2y^3-x\\ne1\\}" :db/id #edb/ref 17592186696662} {:answer/id #uuid "ece933c2-e148-52e5-8794-07d93ea60259" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le-1,\\ 2y^3-x<1\\}" :db/id #edb/ref 17592186696664}] :answer-field/correct {:answer/id #uuid "5dd978a2-100e-5c41-a81c-a22cd6f6b78f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le-1,\\ 2y^3-x>1\\}" :db/id #edb/ref 17592186696641} :answer-field/id #uuid "a30f34d4-c134-5a25-9b8e-d5ad2e18ca75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696654}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5df44538-01cf-5d7a-84f5-b38dfd4bb925" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{-1-\\left(y-x\\right)}}{\\sqrt{2y^3-x-1}}$." :question/requires-calculator false :question/worked-solution "The numerator radicand may equal zero. The denominator radicand must be strictly positive, since its square root is the complete denominator.\n\n$$\n\\begin{aligned}\n-1-\\left(y-x\\right)&\\ge 0\\quad\\Longleftrightarrow\\quad y-x\\le-1\\\\\n2y^3-x-1&>0\\quad\\Longleftrightarrow\\quad 2y^3-x>1\n\\end{aligned}\n$$\n\n\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le-1,\\ 2y^3-x>1\\}.\n$$"}] [{:db/id #edb/ref 17592186696649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1debb5d1-3fd4-5a8c-82db-91b64f032aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,2y+x>2\\}" :db/id #edb/ref 17592186696634} {:answer/id #uuid "51225001-b261-5750-b431-653bbfca2d58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane." :db/id #edb/ref 17592186696639} {:answer/id #uuid "5297012b-d4b7-5880-8144-828b1021f663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,2y+x>3\\}" :db/id #edb/ref 17592186696640} {:answer/id #uuid "bd79b373-0448-5187-a8d5-2bb1e5d43bf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,2y+x=2\\}" :db/id #edb/ref 17592186696659} {:answer/id #uuid "d6c174f6-2ae3-5426-9415-e39fe11fa942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,2y+x\\ne2\\}" :db/id #edb/ref 17592186696663}] :answer-field/correct {:answer/id #uuid "1debb5d1-3fd4-5a8c-82db-91b64f032aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,2y+x>2\\}" :db/id #edb/ref 17592186696634} :answer-field/id #uuid "7e42f85c-56bd-5382-9314-c28187cd0d25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696646}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "920083b9-efb9-5cf5-835a-b034b842d086" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{x+y}{\\sqrt{2y+x-2}}$." :question/requires-calculator false :question/worked-solution "The numerator is a polynomial. The denominator radicand must be nonnegative and its square root must be nonzero, so the radicand must be strictly positive.\n\n$$\n\\begin{aligned}\n2y+x-2&>0\\quad\\Longleftrightarrow\\quad 2y+x>2\n\\end{aligned}\n$$\n\n\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,2y+x>2\\}.\n$$"}] [{:db/id #edb/ref 17592186696655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a63a7ab-00a9-56c4-986d-c83028370b76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,x-y^2\\ge-1,\\ 2y^3-x\\ne1\\}" :db/id #edb/ref 17592186696631} {:answer/id #uuid "33d9a32f-a18b-5f5a-b089-4507a0fcaeeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,x-y^2<-1,\\ 2y^3-x\\le1\\}" :db/id #edb/ref 17592186696637} {:answer/id #uuid "68611a96-7db1-575d-9584-21fab095a59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,x-y^2<-1,\\ 2y^3-x\\ne1\\}" :db/id #edb/ref 17592186696645} {:answer/id #uuid "b7e22c80-c7ef-56f7-9f9e-3333115a8fd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,x-y^2=-1,\\ 2y^3-x\\ne1\\}" :db/id #edb/ref 17592186696657} {:answer/id #uuid "c264f58a-8448-5f0c-8ae8-b15d45c75490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,x-y^2\\ge-1,\\ 2y^3-x\\ne2\\}" :db/id #edb/ref 17592186696661}] :answer-field/correct {:answer/id #uuid "0a63a7ab-00a9-56c4-986d-c83028370b76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,x-y^2\\ge-1,\\ 2y^3-x\\ne1\\}" :db/id #edb/ref 17592186696631} :answer-field/id #uuid "5e940392-5382-55ab-a0a1-9c3739588896" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696643}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a8fb0d90-82a5-579c-b5a8-cc534d33ae21" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{x-y^2+1}}{2y^3-x-1}$." :question/requires-calculator false :question/worked-solution "The numerator radicand must be nonnegative, and the polynomial denominator must be nonzero. A zero numerator is allowed.\n\n$$\n\\begin{aligned}\nx-y^2+1&\\ge 0\\quad\\Longleftrightarrow\\quad x-y^2\\ge-1\\\\\n2y^3-x-1&\\ne 0\\quad\\Longleftrightarrow\\quad 2y^3-x\\ne1\n\\end{aligned}\n$$\n\n\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,x-y^2\\ge-1,\\ 2y^3-x\\ne1\\}.\n$$"}] [{:db/id #edb/ref 17592186696672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c0f855-8cbb-596e-8439-db3aa5491065" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y &\\le0\\\\x^2+y^2 &\\ge9\\\\x^2+y^2 &\\ne13\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696667} {:answer/id #uuid "12feebc3-dfdb-5ab2-ba79-afd2953460d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y &\\ge0\\\\x^2+y^2 &\\ge9\\\\x^2+y^2 &\\ne5\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696670} {:answer/id #uuid "15889121-79cc-500c-86a3-c77f8f75c750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y &\\ge0\\\\x^2+y^2 &\\ge9\\\\x^2+y^2 &>13\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696671} {:answer/id #uuid "c19bf749-919c-5d72-8b01-6aa785bd17ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,x^2+y^2\\ge9,\\ x^2+y^2\\ne13\\}" :db/id #edb/ref 17592186696687} {:answer/id #uuid "ff700549-7e72-5be8-aef6-cd12bd9a9d11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y &\\ge0\\\\x^2+y^2 &\\ge9\\\\x^2+y^2 &\\ne13\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696694}] :answer-field/correct {:answer/id #uuid "ff700549-7e72-5be8-aef6-cd12bd9a9d11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y &\\ge0\\\\x^2+y^2 &\\ge9\\\\x^2+y^2 &\\ne13\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696694} :answer-field/id #uuid "caa95045-a451-558b-96a7-01cfa3f6561d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696688}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "16d84d36-e644-5e6b-8ec7-a7705e432ae0" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{y}}{\\sqrt{x^2+y^2-9}-2}$." :question/requires-calculator false :question/worked-solution "Both radicands must be nonnegative. The complete shifted denominator must also be nonzero.\n\n$$\n\\begin{aligned}\ny&\\ge 0\\quad\\Longleftrightarrow\\quad y\\ge0\\\\\nx^2+y^2-9&\\ge 0\\quad\\Longleftrightarrow\\quad x^2+y^2\\ge9\\\\\n\\sqrt{x^2+y^2-9}-2&=0\\\\\n\\sqrt{x^2+y^2-9}&=2\\\\\nx^2+y^2-9&=4\\\\\nx^2+y^2&=13\n\\end{aligned}\n$$\n\nThe right side of the root equation is positive, so squaring is reversible. Exclude this level set. The radicand-zero boundary remains allowed wherever the numerator is real, since the denominator there is $-2$.\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y &\\ge0\\\\x^2+y^2 &\\ge9\\\\x^2+y^2 &\\ne13\\end{aligned}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186696673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "330426a3-182d-548b-80ee-e7b09a01c645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le0,\\ y^2+x^2\\le9\\}" :db/id #edb/ref 17592186696674} {:answer/id #uuid "845cba9d-4586-5358-b48b-5d7678e52d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le0\\}" :db/id #edb/ref 17592186696679} {:answer/id #uuid "aba0791a-9524-5449-8944-0c5adcfd8ac7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le1,\\ y^2+x^2\\le9\\}" :db/id #edb/ref 17592186696685} {:answer/id #uuid "ea97bc09-3fc4-5994-a64e-3c6bcc963968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le0,\\ y^2+x^2=9\\}" :db/id #edb/ref 17592186696691} {:answer/id #uuid "fed2a819-3f8f-5cac-94d5-560f83f647fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le0,\\ y^2+x^2\\ge9\\}" :db/id #edb/ref 17592186696693}] :answer-field/correct {:answer/id #uuid "330426a3-182d-548b-80ee-e7b09a01c645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le0,\\ y^2+x^2\\le9\\}" :db/id #edb/ref 17592186696674} :answer-field/id #uuid "797d3895-b6f6-5f30-b150-0441fd5bd79d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696678}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1bc92a11-13e7-54c9-b7f2-0edf439330b8" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{0-\\left(y-x\\right)}}{\\sqrt{9-\\left(y^2+x^2\\right)}+1}$." :question/requires-calculator false :question/worked-solution "Both radicands must be nonnegative. The complete shifted denominator must also be nonzero.\n\n$$\n\\begin{aligned}\n0-\\left(y-x\\right)&\\ge 0\\quad\\Longleftrightarrow\\quad y-x\\le0\\\\\n9-\\left(y^2+x^2\\right)&\\ge 0\\quad\\Longleftrightarrow\\quad y^2+x^2\\le9\\\\\n\\sqrt{9-\\left(y^2+x^2\\right)}+1&\\ge 1>0\n\\end{aligned}\n$$\n\nA principal square root is nonnegative. This denominator is always positive on the real-radicand region, so it has no zero to exclude. Squaring an equation with a negative right side would create extraneous points.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le0,\\ y^2+x^2\\le9\\}.\n$$"}] [{:db/id #edb/ref 17592186696675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6942dae7-eca7-51fd-8c21-2e3a83b9a288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0\\}" :db/id #edb/ref 17592186696677} {:answer/id #uuid "9506e8a4-deff-53a0-8219-ee6858941ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\le0,\\ y^2+x^2>9\\}" :db/id #edb/ref 17592186696682} {:answer/id #uuid "984b597d-2723-5832-abcf-d0068bc1f652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y &\\ge0\\\\y^2+x^2 &\\ge9\\\\y^2+x^2 &\\ne13\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696683} {:answer/id #uuid "a9deb0d4-6b6b-5f16-8f8a-d369291b69e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\le0,\\ y^2+x^2\\ge9\\}" :db/id #edb/ref 17592186696684} {:answer/id #uuid "bb1dd8e5-34ce-5264-8d9e-969ce2a8bad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ y^2+x^2\\ge9\\}" :db/id #edb/ref 17592186696686}] :answer-field/correct {:answer/id #uuid "bb1dd8e5-34ce-5264-8d9e-969ce2a8bad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ y^2+x^2\\ge9\\}" :db/id #edb/ref 17592186696686} :answer-field/id #uuid "d80ed292-3c79-5210-9414-1001962008e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696690}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3e74bcc7-5096-5d3d-9001-eb2450b76382" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{y}}{\\sqrt{y^2+x^2-9}+2}$." :question/requires-calculator false :question/worked-solution "Both radicands must be nonnegative. The complete shifted denominator must also be nonzero.\n\n$$\n\\begin{aligned}\ny&\\ge 0\\quad\\Longleftrightarrow\\quad y\\ge0\\\\\ny^2+x^2-9&\\ge 0\\quad\\Longleftrightarrow\\quad y^2+x^2\\ge9\\\\\n\\sqrt{y^2+x^2-9}+2&\\ge 2>0\n\\end{aligned}\n$$\n\nA principal square root is nonnegative. This denominator is always positive on the real-radicand region, so it has no zero to exclude. Squaring an equation with a negative right side would create extraneous points.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb R^2\\,:\\,y\\ge0,\\ y^2+x^2\\ge9\\}.\n$$"}] [{:db/id #edb/ref 17592186696692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f185cc6-d81d-5a42-9834-2c952f9a3713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y-x &\\le0\\\\y^2+x^2 &<4\\\\y^2+x^2 &\\ne3\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696669} {:answer/id #uuid "55679e30-6e4d-58ed-af15-352afcfcfde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y-x &\\ge0\\\\y^2+x^2 &\\le4\\\\y^2+x^2 &\\ne3\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696676} {:answer/id #uuid "89f12ee0-0e6c-538b-8172-70f28fcf7501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb R^2\\,:\\,y-x\\le0,\\ y^2+x^2\\ne3\\}" :db/id #edb/ref 17592186696680} {:answer/id #uuid "8e23fd6a-0628-52a9-bb9e-80a829bb05af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y-x &\\le0\\\\y^2+x^2 &>4\\\\y^2+x^2 &\\ne3\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696681} {:answer/id #uuid "ccd8a504-9e45-54a8-8ea5-cf7db0ca2689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y-x &\\le0\\\\y^2+x^2 &\\le4\\\\y^2+x^2 &\\ne3\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696689}] :answer-field/correct {:answer/id #uuid "ccd8a504-9e45-54a8-8ea5-cf7db0ca2689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y-x &\\le0\\\\y^2+x^2 &\\le4\\\\y^2+x^2 &\\ne3\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696689} :answer-field/id #uuid "02eaa1ac-abe5-5955-8b1e-fadbc26a9288" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696668}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f278cc3f-0f5f-523f-8ac1-3ff099d40197" :question/problem "Find the domain of the function $f(x,y)=\\dfrac{\\sqrt{0-\\left(y-x\\right)}}{\\sqrt{4-\\left(y^2+x^2\\right)}-1}$." :question/requires-calculator false :question/worked-solution "Both radicands must be nonnegative. The complete shifted denominator must also be nonzero.\n\n$$\n\\begin{aligned}\n0-\\left(y-x\\right)&\\ge 0\\quad\\Longleftrightarrow\\quad y-x\\le0\\\\\n4-\\left(y^2+x^2\\right)&\\ge 0\\quad\\Longleftrightarrow\\quad y^2+x^2\\le4\\\\\n\\sqrt{4-\\left(y^2+x^2\\right)}-1&=0\\\\\n\\sqrt{4-\\left(y^2+x^2\\right)}&=1\\\\\n4-\\left(y^2+x^2\\right)&=1\\\\\ny^2+x^2&=3\n\\end{aligned}\n$$\n\nThe right side of the root equation is positive, so squaring is reversible. Exclude this level set. The radicand-zero boundary remains allowed wherever the numerator is real, since the denominator there is $-1$.\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb R^2\\,:\\,\\begin{aligned}y-x &\\le0\\\\y^2+x^2 &\\le4\\\\y^2+x^2 &\\ne3\\end{aligned}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186696715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f83bee4-136b-5df1-8cf0-44903f1dc916" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4e/4e248a20570df4d58eb01ba5101bfbd5b82c3d7b98b8aed2508624c79ba6ea45.png" :db/id #edb/ref 17592186696725} {:answer/id #uuid "5d3ef8af-de39-5cf0-a55a-777435492eaa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b2/b20586da876629da396c66b888bbfec64e1f7bf492ef84ce1a7fcefd30c7eaee.png" :db/id #edb/ref 17592186696727} {:answer/id #uuid "8d1840e3-d054-5bbb-bdea-754b50959dcd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9b/9b36c2590695b16770b794827fbd2c9aca7e752ae9478fcef8ceb02c218fd1c1.png" :db/id #edb/ref 17592186696731} {:answer/id #uuid "fb52c2e1-3744-5d51-8283-20bbef70da8d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/3345524447f3e449f8a7ef0fad244237598a5d8b940db02149e76a68f23ba004.png" :db/id #edb/ref 17592186696745} {:answer/id #uuid "fda78f9a-82c6-5f01-988e-c78e38998179" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a5/a5a518fc9ee664ca51583d502138c2f4fb38c9c2445c39a7119c9f39909a7e5b.png" :db/id #edb/ref 17592186696746}] :answer-field/correct {:answer/id #uuid "8d1840e3-d054-5bbb-bdea-754b50959dcd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9b/9b36c2590695b16770b794827fbd2c9aca7e752ae9478fcef8ceb02c218fd1c1.png" :db/id #edb/ref 17592186696731} :answer-field/id #uuid "b019ad56-eeb9-5414-808f-34d878890a34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696736}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f87f852-57cf-5a36-bb42-98d13933d6df" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\frac{3}{\\sqrt{x - y - 1}}$?" :question/worked-solution "The radicand must be nonnegative and the denominator must be nonzero. Together these require a strictly positive radicand.\n\n$$\n\\begin{aligned}&x - y - 1>0 \\\\ &\\Longleftrightarrow y<x - 1\\end{aligned}\n$$\n\nSolving for $y$ gives $y<x - 1$. Shade **below** the boundary $y=x - 1$. The boundary is **excluded** (dashed).\n\nTherefore,\n\n$$\nD=\\left\\{(x,y)\\in\\mathbb{R}^2\\;:\\;y<x - 1\\right\\}.\n$$\n\n![](images/9b/9b36c2590695b16770b794827fbd2c9aca7e752ae9478fcef8ceb02c218fd1c1.png)"}] [{:db/id #edb/ref 17592186696722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d570f0-bd14-59b1-b580-6cd0d025c4d9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/921773c5801e39cf0534f232aaba09d92631232f9db2b9e26b76666caac0872e.png" :db/id #edb/ref 17592186696720} {:answer/id #uuid "7450a5a9-c12b-5b24-8e03-cfd225974702" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8007a2f28c43a79497c56758e098bc98d04e4a4336fe7e28fab2288165b499b.png" :db/id #edb/ref 17592186696729} {:answer/id #uuid "9c6b5a68-206e-5b5c-aef8-4b25b69a13e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/eb/eb237f7c1b5dbced834712569c8d526ebf0b96b570b3bc87e466570f06397825.png" :db/id #edb/ref 17592186696732} {:answer/id #uuid "ad4a91ef-fcdc-56e8-8713-bfd5e8ccd296" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/79/79d93b43debc77782c64f3e27c1147dbb9babe7e04ed997cee938b9052474382.png" :db/id #edb/ref 17592186696735} {:answer/id #uuid "d9f93214-b975-5d3e-bd6e-2bdc752fd08e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2a/2a83eaa32736992349dfe166ad7f2c786024791c3e9dc6d249a18a5b524a400c.png" :db/id #edb/ref 17592186696741}] :answer-field/correct {:answer/id #uuid "7450a5a9-c12b-5b24-8e03-cfd225974702" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8007a2f28c43a79497c56758e098bc98d04e4a4336fe7e28fab2288165b499b.png" :db/id #edb/ref 17592186696729} :answer-field/id #uuid "0c567358-1e77-5d1f-aceb-5ef400c7b74f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696713}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35024022-95b8-5016-95f8-681120cafcdb" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\sqrt{y - \\left(x + 2\\right)^{2} + 2}$?" :question/worked-solution "The radicand must be nonnegative.\n\n$$\n\\begin{aligned}&y - \\left(x + 2\\right)^{2} + 2\\ge 0 \\\\ &\\Longleftrightarrow y\\ge \\left(x + 2\\right)^{2} - 2\\end{aligned}\n$$\n\nSolving for $y$ gives $y\\ge \\left(x + 2\\right)^{2} - 2$. Shade **above** the boundary $y=\\left(x + 2\\right)^{2} - 2$. The boundary is **included** (solid).\n\nTherefore,\n\n$$\nD=\\left\\{(x,y)\\in\\mathbb{R}^2\\;:\\;y\\ge \\left(x + 2\\right)^{2} - 2\\right\\}.\n$$\n\n![](images/c8/c8007a2f28c43a79497c56758e098bc98d04e4a4336fe7e28fab2288165b499b.png)"}] [{:db/id #edb/ref 17592186696726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06423c8b-5ece-55e4-b29c-b2b6b3c96897" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a84a116450f8751d95da02977a36d49e728cbf115b1326d3a7b5b37814025776.png" :db/id #edb/ref 17592186696712} {:answer/id #uuid "148a5380-b8d0-5f06-b20f-59576254c39d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f82710b22919b3906300aefe4b0ba44a44b3824be37b43d3be5b51636bd85e37.png" :db/id #edb/ref 17592186696716} {:answer/id #uuid "39dd0ef0-dbad-5a4f-a7a4-1c8bf6e05ffd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/dabf2ddfb2c1d9e72bc1e4fe398d078cdb70e7d9ba52c7ddfe470ac08bcb41f8.png" :db/id #edb/ref 17592186696723} {:answer/id #uuid "6fece37c-ca63-5fa2-b47c-49557a3c6bd8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe41b4c716acf742c1f3e1619ebc8fe521ce0a66a9b25f78478c0933e3b55100.png" :db/id #edb/ref 17592186696728} {:answer/id #uuid "a79d1550-ba7e-5ddb-8ed5-03834b4531c4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dd/dd23edd161f65e0bcabfca0b116ce3723bd0655256bdd14ce83d91027fca9513.png" :db/id #edb/ref 17592186696733}] :answer-field/correct {:answer/id #uuid "39dd0ef0-dbad-5a4f-a7a4-1c8bf6e05ffd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/dabf2ddfb2c1d9e72bc1e4fe398d078cdb70e7d9ba52c7ddfe470ac08bcb41f8.png" :db/id #edb/ref 17592186696723} :answer-field/id #uuid "f1f3fc9b-8eed-587e-a4e1-7fa10ccc3a66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696743}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "59cb045c-9b39-5a2f-a494-938cb0ee907f" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\frac{2}{\\sqrt{- x^{2} + y^{2}}}$?" :question/worked-solution "The radicand must be nonnegative and the denominator must be nonzero. Together these require a strictly positive radicand.\n\n$$\n\\begin{aligned}&- x^{2} + y^{2}>0 \\\\ &\\Longleftrightarrow x^2<y^2\\end{aligned}\n$$\n\nComparing the squares gives $x^2<y^2$. Shade the **upper and lower** wedges between the diagonal lines $y=x$ and $y=-x$. The boundary is **excluded** (dashed).\n\nTherefore,\n\n$$\nD=\\left\\{(x,y)\\in\\mathbb{R}^2\\;:\\;x^2<y^2\\right\\}.\n$$\n\n![](images/da/dabf2ddfb2c1d9e72bc1e4fe398d078cdb70e7d9ba52c7ddfe470ac08bcb41f8.png)"}] [{:db/id #edb/ref 17592186696734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9c185f-a731-51db-bf3c-c07d9fce839a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/46/4639525b1e1f5989b6d17f5a3cb59d29540f01a35aef110f4a78cd8afd344f38.png" :db/id #edb/ref 17592186696714} {:answer/id #uuid "2344dffa-f06d-5676-ba09-a8134b1db696" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0b/0b72e9ceedd654dc265b6bb84b5abc4e17a5fd865d210edc2e70cfa587bee674.png" :db/id #edb/ref 17592186696718} {:answer/id #uuid "2a9d953e-856a-5260-b58c-d8c7ed47c144" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a2c212d0f6ee825ebe77b70bee7551ec88de829fd88311e0a634d66626375f9.png" :db/id #edb/ref 17592186696721} {:answer/id #uuid "bd5ad1d3-ba89-5d0c-b400-e42909edbcc5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/47e26111c7ce0c907027d438de7fb708ce924eadca5a878d42be60d03ca8afd4.png" :db/id #edb/ref 17592186696737} {:answer/id #uuid "d7ae2698-7ced-5219-a4e0-371ab34682cd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/99/996860bd9d39369c2659077da371f8d2e3710905978446ca48eb701c37953444.png" :db/id #edb/ref 17592186696740}] :answer-field/correct {:answer/id #uuid "2344dffa-f06d-5676-ba09-a8134b1db696" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0b/0b72e9ceedd654dc265b6bb84b5abc4e17a5fd865d210edc2e70cfa587bee674.png" :db/id #edb/ref 17592186696718} :answer-field/id #uuid "24339851-d396-5a76-8711-c2d1980ae3dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696719}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ac686de1-f4d9-5ec2-915f-dd5f56cda268" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\frac{3}{\\sqrt{x^{2} + y^{2} - 9}}$?" :question/worked-solution "The radicand must be nonnegative and the denominator must be nonzero. Together these require a strictly positive radicand.\n\n$$\n\\begin{aligned}&x^{2} + y^{2} - 9>0 \\\\ &\\Longleftrightarrow x^{2} + y^{2}>9\\end{aligned}\n$$\n\nRearrange to obtain $x^{2} + y^{2}>9$. The boundary is centered at $(0,0)$ with radius $3$. Shade **outside** it. The boundary is **excluded** (dashed).\n\nTherefore,\n\n$$\nD=\\left\\{(x,y)\\in\\mathbb{R}^2\\;:\\;x^{2} + y^{2}>9\\right\\}.\n$$\n\n![](images/0b/0b72e9ceedd654dc265b6bb84b5abc4e17a5fd865d210edc2e70cfa587bee674.png)"}] [{:db/id #edb/ref 17592186696742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e35ec57-83c7-5183-9c27-cdff4d4b440b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0b/0b74c1e3d9e121a50ddbb258fa587bba99572fa2abecd8aa4580bbb4912084c5.png" :db/id #edb/ref 17592186696717} {:answer/id #uuid "3bfafa81-c153-56b5-9b1f-8b6ee23e3d7e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c6395da2e0157358006facb57bc70dee8da39779f249046cea1c01d16727291a.png" :db/id #edb/ref 17592186696724} {:answer/id #uuid "7eb634d5-b796-56bd-9d5c-1bfac7d2a51d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8b670d9c82a8652816c07507da614e3403b040179e21ea5a7769556d479fcce1.png" :db/id #edb/ref 17592186696730} {:answer/id #uuid "d4b4fe8f-2ead-54ff-934b-a07c16d40c21" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2e/2e742af20949000e39ef5824597647ae143a16398ccd3725a34dfac5f3291575.png" :db/id #edb/ref 17592186696739} {:answer/id #uuid "f2ef6484-0cf0-59e6-a754-005b5d4d9e1f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dd/dd23edd161f65e0bcabfca0b116ce3723bd0655256bdd14ce83d91027fca9513.png" :db/id #edb/ref 17592186696744}] :answer-field/correct {:answer/id #uuid "f2ef6484-0cf0-59e6-a754-005b5d4d9e1f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dd/dd23edd161f65e0bcabfca0b116ce3723bd0655256bdd14ce83d91027fca9513.png" :db/id #edb/ref 17592186696744} :answer-field/id #uuid "bf527a8e-d537-5c85-aeee-b67f692a38ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696738}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee1fd022-59ab-551b-917a-56ba56088abe" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\sqrt{\\left(x - 1\\right)^{2} + \\left(y - 1\\right)^{2} + 2}$?" :question/worked-solution "The radicand must be nonnegative. Both squared terms are nonnegative, so $\\left(x - 1\\right)^{2} + \\left(y - 1\\right)^{2} + 2\\ge 2>0$ for every real pair $(x,y)$. Therefore $D=\\mathbb{R}^2$: shade the **entire plane**.\n\n![](images/dd/dd23edd161f65e0bcabfca0b116ce3723bd0655256bdd14ce83d91027fca9513.png)"}] [{:db/id #edb/ref 17592186696748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3affdd56-3364-5371-bc27-a58eb6d221d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f80443f846d10567795f4d411ad9fdf308c07d131926622182c6b491e3557222.png" :db/id #edb/ref 17592186696750} {:answer/id #uuid "4adfaa8e-6bc9-59eb-a09b-20a7aef8d95a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba7d94bc5146fd83ef0df4bd503b830c696268bea72cd5cfd6a08be7576a3bd9.png" :db/id #edb/ref 17592186696752} {:answer/id #uuid "4bc624a3-a9ff-5dd6-ab17-b35694c5535e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/898ec04601f42ca6c5220ed58715425dbd2839d70dcc4636d59b7f7a562745fe.png" :db/id #edb/ref 17592186696753} {:answer/id #uuid "966b7660-a63f-5618-bedb-a1a9662803de" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f456cca74dc8fda2a4ae442b1f4ce54205b6d875f60b615cf2f0af6cf22063e2.png" :db/id #edb/ref 17592186696762} {:answer/id #uuid "a71fd433-de85-532f-98a3-a652b12f7959" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/eb/eb4edbf24caf9a0b7821356450b529d6e12ec8d5a527da4fcab71f1fe9319795.png" :db/id #edb/ref 17592186696763}] :answer-field/correct {:answer/id #uuid "3affdd56-3364-5371-bc27-a58eb6d221d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f80443f846d10567795f4d411ad9fdf308c07d131926622182c6b491e3557222.png" :db/id #edb/ref 17592186696750} :answer-field/id #uuid "6a9ec9d3-775f-5095-a9d8-939d6fd9e18b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696759}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "01301769-0ea1-513e-b400-a6dc5e746707" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\ln\\!\\left(- x^{2} - 9 \\left(y + 1\\right)^{2} + 9\\right)$?" :question/worked-solution "The argument of the logarithm must be positive.\n\n$$\n\\begin{aligned}&- x^{2} - 9 \\left(y + 1\\right)^{2} + 9>0 \\\\ &\\Longleftrightarrow \\frac{x^{2}}{9} + \\left(y + 1\\right)^{2}<1\\end{aligned}\n$$\n\nRearrange and divide by the positive constant $9$ to obtain $\\frac{x^{2}}{9} + \\left(y + 1\\right)^{2}<1$. The boundary is centered at $(0,-1)$ with horizontal and vertical semiaxes $3$ and $1$. Shade **inside** it. The boundary is **excluded** (dashed).\n\nTherefore,\n\n$$\nD=\\left\\{(x,y)\\in\\mathbb{R}^2\\;:\\;\\frac{x^{2}}{9} + \\left(y + 1\\right)^{2}<1\\right\\}.\n$$\n\n![](images/f8/f80443f846d10567795f4d411ad9fdf308c07d131926622182c6b491e3557222.png)"}] [{:db/id #edb/ref 17592186696765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2989fec6-cc17-50b5-baa8-772210137fb5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6b49cc9423ca341a7aaece5d1b3f0a35328d7d003d3f33a18f6afeeadb6e6651.png" :db/id #edb/ref 17592186696749} {:answer/id #uuid "63258147-c504-5bb1-bde6-3563b9b704a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dc/dcc9dc967374d240fd177008e19af73463b779176c8bc35d99427d3afe8cdc63.png" :db/id #edb/ref 17592186696756} {:answer/id #uuid "9042f812-7cd9-58f0-a472-418f150acb21" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f2/f29caebe30aadbc0f1fd1e1d44635dca8232c62a5de8677fb8ca7030a1b50b84.png" :db/id #edb/ref 17592186696761} {:answer/id #uuid "cfa78ea4-1cd8-5368-8949-f50ebd5b8ba2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b1/b1509b409434570f458c3cf057a6737cad16aa4a94e9ccc7f4bdaa904a401ce7.png" :db/id #edb/ref 17592186696766} {:answer/id #uuid "e1a30c02-1369-55a6-a5b7-9242d3384ab7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/58/582c9b4de0e2920fa39c27f7a9aabb1d8723d1ad3c3b2a3a0388d2e319c23764.png" :db/id #edb/ref 17592186696767}] :answer-field/correct {:answer/id #uuid "cfa78ea4-1cd8-5368-8949-f50ebd5b8ba2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b1/b1509b409434570f458c3cf057a6737cad16aa4a94e9ccc7f4bdaa904a401ce7.png" :db/id #edb/ref 17592186696766} :answer-field/id #uuid "b2b0fee2-5499-5dde-8ebd-04ddb627243a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696764}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b7049013-9226-5ea7-9e32-0b9354f176cf" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\frac{2}{\\ln\\!\\left(x - \\frac{y}{2} + \\frac{1}{2}\\right)}$?" :question/worked-solution "The logarithm needs a positive argument, and its value in the denominator must be nonzero.\n\n$$\n\\begin{aligned}x - \\frac{y}{2} + \\frac{1}{2}&>0 \\\\ \\ln\\!\\left(x - \\frac{y}{2} + \\frac{1}{2}\\right)&\\ne0 \\\\ x - \\frac{y}{2} + \\frac{1}{2}&\\ne1 \\\\ 2 x - y + 1&\\ne 2\\end{aligned}\n$$\n\nSince $\\ln(1)=0$ and the logarithm is one-to-one on positive inputs, its argument must differ from $1$. Multiplying both restrictions by the positive constant $2$ gives $2 x - y + 1>0,\\quad 2 x - y + 1\\ne 2$. Shade the half-plane $2 x - y + 1>0$ and remove the parallel line $2 x - y + 1=2$. Both lines are **excluded**, so draw them dashed. Keep both portions of the positive half-plane separated by the removed line.\n\nTherefore,\n\n$$\nD=\\left\\{(x,y)\\in\\mathbb{R}^2\\;:\\;\\begin{aligned}2 x - y + 1&>0 \\\\ 2 x - y + 1&\\ne 2\\end{aligned}\\right\\}.\n$$\n\n![](images/b1/b1509b409434570f458c3cf057a6737cad16aa4a94e9ccc7f4bdaa904a401ce7.png)"}] [{:db/id #edb/ref 17592186696768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4199ae08-8931-5480-863b-997e9725cd79" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ecc8a5094076a3c9233bd239920e724a3c18206d4146aee01b5f86aa19445e0d.png" :db/id #edb/ref 17592186696751} {:answer/id #uuid "507c4ec3-f383-5584-81a8-3d624d62b8e5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7037c606f0e23965146bf4ff817fc77ff1a7f2cb1b6e62b5cd972bc46d1d971.png" :db/id #edb/ref 17592186696754} {:answer/id #uuid "676c6b20-6729-5ec7-a8e6-d41ecd70dd50" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd1ab2a81490d36ad8172de6828df910f0443b646573ecebb472b8ba88e7fa42.png" :db/id #edb/ref 17592186696757} {:answer/id #uuid "678be4e2-9c0c-5d45-aa62-108bf93445f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/32/325a0e7fd77dcf854936c5da9b604daef2afc1a153ad3762084a9ea7a02930bc.png" :db/id #edb/ref 17592186696758} {:answer/id #uuid "87f0ba66-0374-5903-aa41-e3df91beaea0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4d/4dc74f1acfe88384fcd482267db6592e8e7570480b1356d80588381932414277.png" :db/id #edb/ref 17592186696760}] :answer-field/correct {:answer/id #uuid "4199ae08-8931-5480-863b-997e9725cd79" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ecc8a5094076a3c9233bd239920e724a3c18206d4146aee01b5f86aa19445e0d.png" :db/id #edb/ref 17592186696751} :answer-field/id #uuid "531f3ccd-7383-56c9-a536-d07bab8e5ddb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696755}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f6f4013b-06c8-5cc4-b7d0-8a0a7e02fa43" :question/problem "Which of the following shaded regions corresponds to the domain of the real-valued function $f(x,y)=\\ln\\!\\left(9 x^{2} + 4 y^{2} - 36\\right)$?" :question/worked-solution "The argument of the logarithm must be positive.\n\n$$\n\\begin{aligned}&9 x^{2} + 4 y^{2} - 36>0 \\\\ &\\Longleftrightarrow \\frac{x^{2}}{4} + \\frac{y^{2}}{9}>1\\end{aligned}\n$$\n\nRearrange and divide by the positive constant $36$ to obtain $\\frac{x^{2}}{4} + \\frac{y^{2}}{9}>1$. The boundary is centered at $(0,0)$ with horizontal and vertical semiaxes $2$ and $3$. Shade **outside** it. The boundary is **excluded** (dashed).\n\nTherefore,\n\n$$\nD=\\left\\{(x,y)\\in\\mathbb{R}^2\\;:\\;\\frac{x^{2}}{4} + \\frac{y^{2}}{9}>1\\right\\}.\n$$\n\n![](images/ec/ecc8a5094076a3c9233bd239920e724a3c18206d4146aee01b5f86aa19445e0d.png)"}] [{:db/id #edb/ref 17592186696840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ba9fad5-2b4b-5f73-ae49-b3a8c62c3764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x\\ge 0 \\\\ &y\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696832} {:answer/id #uuid "6b7f2ea8-2c46-5e87-a5d5-c21d48be52c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x>0 \\\\ &y\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696841} {:answer/id #uuid "a166d305-32b8-52ea-a6d3-c4e7d43e80e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb{R}^{2}:\\,x>0\\}" :db/id #edb/ref 17592186696848} {:answer/id #uuid "aa5a8507-8feb-5c79-88da-6e74358f0d89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mathbb{R}^{2}" :db/id #edb/ref 17592186696852} {:answer/id #uuid "bf9e744b-f67d-5f4a-a896-1af5519f1ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x>0 \\\\ &y\\ne 0 \\\\ &x\\ne 1\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696854}] :answer-field/correct {:answer/id #uuid "6b7f2ea8-2c46-5e87-a5d5-c21d48be52c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x>0 \\\\ &y\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696841} :answer-field/id #uuid "a24acd3e-b5b9-5d56-88d7-69a8949ae2dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696849}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "671621f1-3f1c-5cf2-b90e-853a0cd48b6f" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\ln\\left(x\\right)}{y}.$" :question/worked-solution "The logarithm requires $x>0$.\n\nThe denominator must be nonzero, so $y\\ne 0$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}x>0 \\\\ y\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&x>0 \\\\ &y\\ne 0\\end{aligned}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186696858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e6917bc-f20d-5a44-87f0-f267dc9201d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-2x^{2}+y-1\\ge 0 \\\\ &-2x^{2}+y-1\\ne 1\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696833} {:answer/id #uuid "50e42947-2e16-5e03-a24a-ca98b085f34f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-2x^{2}+y-1>0 \\\\ &-2x^{2}+y-1\\ne 1\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696836} {:answer/id #uuid "5928a9c2-91a4-58fb-b582-9df2a3603f89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-2x^{2}+y-1>1\\}" :db/id #edb/ref 17592186696839} {:answer/id #uuid "8983f672-09f9-5188-aa19-24777013d5c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-2x^{2}+y-1\\ne 0 \\\\ &-2x^{2}+y-1\\ne 1\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696846} {:answer/id #uuid "f781d594-5857-531f-ba34-abcc4756c4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mathbb{R}^{2}" :db/id #edb/ref 17592186696862}] :answer-field/correct {:answer/id #uuid "50e42947-2e16-5e03-a24a-ca98b085f34f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-2x^{2}+y-1>0 \\\\ &-2x^{2}+y-1\\ne 1\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696836} :answer-field/id #uuid "fcefa320-f00c-51c8-9224-0d80e673f93b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696866}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d86eeacc-8280-5cf6-8986-273e4cb1008d" :question/problem "Find the domain of the function $f(x,y)=\\frac{y^{2}}{\\ln\\left(-2x^{2}+y-1\\right)}.$" :question/worked-solution "The logarithm requires $-2x^{2}+y-1>0$. Its value is a denominator, so it must also be nonzero.\n\nOn positive inputs, $\\ln\\left(-2x^{2}+y-1\\right)=0$ exactly when $-2x^{2}+y-1=1$. Thus we must exclude $-2x^{2}+y-1=1$, even when the numerator is zero.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-2x^{2}+y-1>0 \\\\ -2x^{2}+y-1\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-2x^{2}+y-1>0 \\\\ &-2x^{2}+y-1\\ne 1\\end{aligned}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186696859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "431978a6-be0a-5c76-b744-6846a34a5778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&1-x^{2}\\ne 0 \\\\ &y+2\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696834} {:answer/id #uuid "5103dd5f-c533-5c08-8d88-fdabf688264b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&1-x^{2}>0 \\\\ &y+2>0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696837} {:answer/id #uuid "6d5fef6b-9986-5548-bc88-3ed6b415c7d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&1-x^{2}>0 \\\\ &y+2\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696842} {:answer/id #uuid "a7bb8656-56b3-578d-8cea-a4fe3435ef81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb{R}^{2}:\\,1-x^{2}>0\\}" :db/id #edb/ref 17592186696851} {:answer/id #uuid "cf1442a1-4c1e-5009-bba8-845aac3b5228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&1-x^{2}\\ge 0 \\\\ &y+2\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696857}] :answer-field/correct {:answer/id #uuid "6d5fef6b-9986-5548-bc88-3ed6b415c7d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&1-x^{2}>0 \\\\ &y+2\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696842} :answer-field/id #uuid "f2e7e4dd-600f-5ce5-a59b-e7dd9aaa5894" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696861}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d8dbbea7-bc98-5991-ae25-9e94b155d5d4" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\ln\\left(1-x^{2}\\right)}{y+2}.$" :question/worked-solution "The logarithm requires $1-x^{2}>0$.\n\nThe denominator must be nonzero, so $y+2\\ne 0$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}1-x^{2}>0 \\\\ y+2\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&1-x^{2}>0 \\\\ &y+2\\ne 0\\end{aligned}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186696860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70a28d34-8a22-5266-a550-8fd539a0a685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-1\\ne 0 \\\\ &x+2\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696844} {:answer/id #uuid "849f8560-1c4e-522d-94ab-f465723a4867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y-1>0\\}" :db/id #edb/ref 17592186696845} {:answer/id #uuid "9a6da0c1-82a5-50ec-a9b3-52f75080da69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-1>0 \\\\ &-x+2y-1\\ne 1\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696847} {:answer/id #uuid "bf9efe65-dbcc-5590-aab3-f4d4fef0a99d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mathbb{R}^{2}" :db/id #edb/ref 17592186696855} {:answer/id #uuid "f7d45442-2cca-5a44-ab0f-861f450db519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y-1\\ne 0\\}" :db/id #edb/ref 17592186696863}] :answer-field/correct {:answer/id #uuid "849f8560-1c4e-522d-94ab-f465723a4867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y-1>0\\}" :db/id #edb/ref 17592186696845} :answer-field/id #uuid "c461ddbd-444b-5267-b4f7-83467a9840db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696856}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f0358b69-1f0f-5b11-b7f4-919a80c1f11c" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\ln\\left(-x+2y-1\\right)}{e^{x+2}}.$" :question/worked-solution "The logarithm requires $-x+2y-1>0$.\n\nThe denominator $e^{x+2}$ is positive for every real input, so it never vanishes.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-x+2y-1>0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y-1>0\\}.\n$$"}] [{:db/id #edb/ref 17592186696865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57d3bd1d-17c9-58fd-88b2-93597c564f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in\\mathbb{R}^{2}:\\,-x+2y-2>0\\}" :db/id #edb/ref 17592186696838} {:answer/id #uuid "6e4b4be4-1125-505d-a07f-076b77d98be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-2>0 \\\\ &x+2\\ne 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696843} {:answer/id #uuid "a6f2634d-c3e8-5458-82d3-2558a095ff38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-2\\ge 0 \\\\ &x+2>0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696850} {:answer/id #uuid "adf5e04b-6200-5b0f-a0ef-ccd499d38ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-2\\ne 0 \\\\ &x+2>0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696853} {:answer/id #uuid "f85385d0-98fc-50c6-a128-6b55b5937683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-2>0 \\\\ &x+2>0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696864}] :answer-field/correct {:answer/id #uuid "f85385d0-98fc-50c6-a128-6b55b5937683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-2>0 \\\\ &x+2>0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696864} :answer-field/id #uuid "454a4971-420b-5362-94a5-dcde0f6c7940" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696835}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fa559283-8c6c-5b76-b094-365a6ffa7ec7" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\ln\\left(-x+2y-2\\right)}{\\sqrt{x+2}}.$" :question/worked-solution "The logarithm requires $-x+2y-2>0$.\n\nThe denominator square root requires both $x+2\\ge 0$ and $\\sqrt{x+2}\\ne 0$. Together these give $x+2>0$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-x+2y-2>0 \\\\ x+2>0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-x+2y-2>0 \\\\ &x+2>0\\end{aligned}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186696874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e76908-4be2-53be-b263-e469d2b91732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le x+y\\le 1 \\\\ &y\\ge 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696868} {:answer/id #uuid "0f7ad825-3f04-5e9a-9c5b-23913cb8c54f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1<x+\\sqrt{y}<1 \\\\ &y\\ge 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696869} {:answer/id #uuid "15f4b6f3-b4e9-528a-a9ba-67985af5a545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mathbb{R}^{2}" :db/id #edb/ref 17592186696870} {:answer/id #uuid "187d4725-d642-5d9a-81c2-e7460196191f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le x+\\sqrt{y}\\le 1 \\\\ &y>0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696871} {:answer/id #uuid "675a12d7-366a-5a88-a79c-fdb51d354de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le x+\\sqrt{y}\\le 1 \\\\ &y\\ge 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696872}] :answer-field/correct {:answer/id #uuid "675a12d7-366a-5a88-a79c-fdb51d354de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le x+\\sqrt{y}\\le 1 \\\\ &y\\ge 0\\end{aligned}\\right\\}" :db/id #edb/ref 17592186696872} :answer-field/id #uuid "6e331e3d-fbd6-5853-8438-855bb0177990" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696873}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ed42543c-0205-57e1-8479-2779ea07d2db" :question/problem "Find the domain of the function $f(x,y)=\\arcsin\\left(x+\\sqrt{y}\\right).$" :question/worked-solution "The inner square root requires $y\\ge 0$.\n\nThe input of $\\arcsin$ must lie in the closed interval $[-1,1]$, including both endpoints. Therefore $-1\\le x+\\sqrt{y}\\le 1$.\n\nIntersecting these conditions gives\n\n$$\n\\begin{aligned}-1\\le x+\\sqrt{y}\\le 1 \\\\ y\\ge 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\left\\{(x,y)\\in\\mathbb{R}^{2}:\\,\\begin{aligned}&-1\\le x+\\sqrt{y}\\le 1 \\\\ &y\\ge 0\\end{aligned}\\right\\}.\n$$"}] [{:db/id #edb/ref 17592186696879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e266e5f-7025-58c3-9e54-ed557978fa3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\pi \\sin{\\left(2 \\right)}}{4}" :db/id #edb/ref 17592186696885} {:answer/id #uuid "7a1da077-1b6a-58c3-b903-d993197eabe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 + \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186696888} {:answer/id #uuid "7efa374f-3b10-5ae6-bb2e-5a54120dc987" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186696889} {:answer/id #uuid "a4728647-caf0-59f3-a113-fb564992cbc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186696896} {:answer/id #uuid "b322517c-b6d3-5c21-a085-944c5dd3e444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\sqrt{2}" :db/id #edb/ref 17592186696899}] :answer-field/correct {:answer/id #uuid "b322517c-b6d3-5c21-a085-944c5dd3e444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\sqrt{2}" :db/id #edb/ref 17592186696899} :answer-field/id #uuid "49fe6b28-f5ea-5f9b-8c50-7b11d696d453" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696883}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "31582087-7497-5a02-8271-e41ad7e2cb50" :question/problem "Evaluate the real-valued function\n\n$$\nf(x,y)=x\\cdot \\sin\\left(y\\right)\n$$\n\nat the point $(-2,\\frac{\\pi}{4})$." :question/worked-solution "Substitute $x=-2$ and $y=\\frac{\\pi}{4}$ throughout the expression. Keep parentheses around signed inputs:\n\n$$\nf(-2,\\frac{\\pi}{4})=(-2)\\cdot \\sin\\left(\\frac{\\pi}{4}\\right)\n$$\n\nEvaluate the inner operations before combining them:\n\n$$\n\\begin{aligned}\n\\sin\\left(\\frac{\\pi}{4}\\right) &=\\frac{\\sqrt{2}}{2} \\\\\n(-2)\\cdot \\sin\\left(\\frac{\\pi}{4}\\right) &=- \\sqrt{2}\n\\end{aligned}\n$$\n\nThus $f(-2,\\frac{\\pi}{4})=- \\sqrt{2}$."}] [{:db/id #edb/ref 17592186696881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37628258-730b-5f9b-8fae-dae4a5a19fd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696880} {:answer/id #uuid "71239da3-94ee-5f76-837c-aaa0cdf8a9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186696886} {:answer/id #uuid "a45a2753-ff92-50ca-9e6f-bc61ee61b019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 175921866968