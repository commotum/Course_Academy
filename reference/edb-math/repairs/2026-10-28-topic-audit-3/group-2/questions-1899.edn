db/id #edb/ref 17592186696940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4ac2e4-496a-5461-b1ab-a5ace15d1be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186696929} {:answer/id #uuid "216aa754-6198-5c47-b7da-d255aa689f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\log_{3}\\left(13\\right)}{3}" :db/id #edb/ref 17592186696931} {:answer/id #uuid "256d24f2-9289-5d8d-a2f6-dd9754f07427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696932} {:answer/id #uuid "2a875073-42e4-582c-8ee5-349b140cbcc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\log_{3}\\left(7\\right)}{3}" :db/id #edb/ref 17592186696933} {:answer/id #uuid "33bd5b93-7ed0-5e39-b594-90fe39f4409d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186696934}] :answer-field/correct {:answer/id #uuid "33bd5b93-7ed0-5e39-b594-90fe39f4409d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186696934} :answer-field/id #uuid "5408f904-662a-5269-8471-46ec13345526" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696937}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "78cbb6d8-1818-5730-a796-47824c1c4161" :question/problem "Evaluate the real-valued function\n\n$$\nf(x,y)=\\frac{\\log_{3}\\left({x}^{2}+y-6\\right)}{\\sqrt{x-y+10}}\n$$\n\nat the point $(2,3)$." :question/worked-solution "Substitute $x=2$ and $y=3$ throughout the expression. Keep parentheses around signed inputs:\n\n$$\nf(2,3)=\\frac{\\log_{3}\\left({2}^{2}+3-6\\right)}{\\sqrt{2-3+10}}\n$$\n\nEvaluate the inner operations before combining them:\n\n$$\n\\begin{aligned}\n{2}^{2} &=4 \\\\\n{2}^{2}+3 &=7 \\\\\n{2}^{2}+3-6 &=1 \\\\\n\\log_{3}\\left({2}^{2}+3-6\\right) &=0 \\\\\n2-3 &=-1 \\\\\n2-3+10 &=9 \\\\\n\\sqrt{2-3+10} &=3 \\\\\n\\frac{\\log_{3}\\left({2}^{2}+3-6\\right)}{\\sqrt{2-3+10}} &=0\n\\end{aligned}\n$$\n\nThus $f(2,3)=0$."}] [{:db/id #edb/ref 17592186696941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40fb3181-fd24-501c-a49f-7f9ed423b7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{3}" :db/id #edb/ref 17592186696935} {:answer/id #uuid "9ca14737-783d-5ea2-bdbb-af1a9fa204d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186696942} {:answer/id #uuid "a1556982-00b1-5628-baa0-02c4f904b48f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696943} {:answer/id #uuid "accb6c1e-c47e-559b-b3ce-bc6d91d47527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3} + \\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186696945} {:answer/id #uuid "f57b33a0-1149-5bc1-a999-09581e8a3dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186696954}] :answer-field/correct {:answer/id #uuid "9ca14737-783d-5ea2-bdbb-af1a9fa204d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186696942} :answer-field/id #uuid "4a6f2597-0a14-5ee0-a0bf-c0f729b3c963" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696936}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "831d2c3d-6626-5d96-877e-ceca37688adc" :question/problem "Evaluate the real-valued function\n\n$$\nf(x,y)=\\frac{\\log_{2}\\left(x\\cdot {y}^{2}\\right)+\\sqrt{x-y+6}}{{2}^{(-1)\\cdot y}-x+0}\n$$\n\nat the point $(1,-2)$." :question/worked-solution "Substitute $x=1$ and $y=-2$ throughout the expression. Keep parentheses around signed inputs:\n\n$$\nf(1,-2)=\\frac{\\log_{2}\\left(1\\cdot {(-2)}^{2}\\right)+\\sqrt{1-(-2)+6}}{{2}^{(-1)\\cdot (-2)}-1+0}\n$$\n\nEvaluate the inner operations before combining them:\n\n$$\n\\begin{aligned}\n{(-2)}^{2} &=4 \\\\\n1\\cdot {(-2)}^{2} &=4 \\\\\n\\log_{2}\\left(1\\cdot {(-2)}^{2}\\right) &=2 \\\\\n1-(-2) &=3 \\\\\n1-(-2)+6 &=9 \\\\\n\\sqrt{1-(-2)+6} &=3 \\\\\n\\log_{2}\\left(1\\cdot {(-2)}^{2}\\right)+\\sqrt{1-(-2)+6} &=5 \\\\\n(-1)\\cdot (-2) &=2 \\\\\n{2}^{(-1)\\cdot (-2)} &=4 \\\\\n{2}^{(-1)\\cdot (-2)}-1 &=3 \\\\\n{2}^{(-1)\\cdot (-2)}-1+0 &=3 \\\\\n\\frac{\\log_{2}\\left(1\\cdot {(-2)}^{2}\\right)+\\sqrt{1-(-2)+6}}{{2}^{(-1)\\cdot (-2)}-1+0} &=\\frac{5}{3}\n\\end{aligned}\n$$\n\nThus $f(1,-2)=\\frac{5}{3}$."}] [{:db/id #edb/ref 17592186696946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a77ddf-50fa-5a4c-911e-1a9cdb352744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4}{7}" :db/id #edb/ref 17592186696928} {:answer/id #uuid "203ccde9-0738-5507-aec5-d8de0e9e48fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186696930} {:answer/id #uuid "613f9bd8-8372-5573-965b-ed59eabdf36b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\log_{2}\\left(5\\right)}{2}" :db/id #edb/ref 17592186696938} {:answer/id #uuid "b8457618-e9cb-56a9-9be3-49280a7e70af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186696947} {:answer/id #uuid "ce7661d1-077f-539b-b608-b99e8f5c949b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186696949}] :answer-field/correct {:answer/id #