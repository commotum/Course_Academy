{2}\\ge 2}" :db/id #edb/ref 17592186275803} {:answer/id #uuid "25d83c1f-637a-5dcd-830a-0fa3976b241b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}" :db/id #edb/ref 17592186275820} {:answer/id #uuid "3ef1e5fc-d9f8-50bb-862b-ce7e0d18c81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\ge 2}" :db/id #edb/ref 17592186276024} {:answer/id #uuid "c38f2474-4f66-5bcf-86ef-809432b8773b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,{x}^{2}+{y}^{2}<2}" :db/id #edb/ref 17592186277216}] :answer-field/correct {:answer/id #uuid "25d83c1f-637a-5dcd-830a-0fa3976b241b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}" :db/id #edb/ref 17592186275820} :answer-field/id #uuid "40c8a41c-9c97-5993-b1c0-a3a6fec6bcd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277823}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cbb2ddad-ba55-5c7d-8280-316182c4f2ac" :question/math-academy-id "q-158564" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{2y}}{\\sqrt{2-{x}^{2}-{y}^{2}}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}2y\\ge 0 \\\\ 2-{x}^{2}-{y}^{2}>0\\end{aligned}\\,⟹\\,{\\begin{aligned}y\\ge 0 \\\\ {x}^{2}+{y}^{2}<2\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}.\n$$"}] [{:db/id #edb/ref 17592186278210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65f9296d-5b6c-5a94-85c0-fc9260f63356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0}" :db/id #edb/ref 17592186276392} {:answer/id #uuid "76fdec64-15f6-58f2-ba73-b4a291ce7530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0}" :db/id #edb/ref 17592186276550} {:answer/id #uuid "79d6c2ed-3c1e-5f2b-98dc-4be2598c0642" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186276585} {:answer/id #uuid "a357a81a-402b-5112-bfc3-07e163a76753" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne 0}" :db/id #edb/ref 17592186276945} {:answer/id #uuid "d33dc070-d181-5ac9-aa73-0934049d9bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y>0}" :db/id #edb/ref 17592186277342}] :answer-field/correct {:answer/id #uuid "65f9296d-5b6c-5a94-85c0-fc9260f63356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0}" :db/id #edb/ref 17592186276392} :answer-field/id #uuid "182876a9-c4aa-58eb-a19b-ea98688b0065" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277770}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d95d1a0b-f0b3-5203-b742-463bd2cca0ce" :question/math-academy-id "q-158567" :question/problem "Find the domain of the function $f(x,y)={e}^{{x}^{2}/y}.$" :question/worked-solution "Notice that\n\n- $\\frac{{x}^{2}}{y}$ is defined for $x$ and $y,$ such that $y\\ne 0,$ and\n\n- ${e}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${e}^{{x}^{2}/y}$ is defined for values of $x$ and $y$ that satisfy $y\\ne 0.$\n\nTherefore, the domain of $f$ is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0}.\n$$"}] [{:db/id #edb/ref 17592186278211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c76e3aa-4667-51f4-960b-54ca94e95bd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186276006} {:answer/id #uuid "4d9d4847-f4a3-5e51-8843-844c295abf04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡10" :db/id #edb/ref 17592186276161} {:answer/id #uuid "547dc3c1-d89d-5b16-897a-edc2f16a48c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186276228} {:answer/id #uuid "56bc4319-f696-511e-8032-dbec796ecaea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡5" :db/id #edb/ref 17592186276251} {:answer/id #uuid "d9d39fd4-0a44-568e-b95b-3b8fe25d4342" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277389}] :answer-field/correct {:answer/id #uuid "3c76e3aa-4667-51f4-960b-54ca94e95bd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186276006} :answer-field/id #uuid "b4ad22a6-5ade-5693-8d0f-ccaadfcf6954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f50b49cb-5ece-5d2a-8bc6-eb00c81b1f11" :question/math-academy-id "q-158572" :question/problem "Evaluate $z=\\operatorname{ln}⁡(3x-2y+4)$ at the point $(-4,1).$" :question/worked-solution "To evaluate our multivariable function at the point $(-4,1),$ we substitute $x=-4$ and $y=1$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(-4,1)} & =\\operatorname{ln}⁡(3x-2y+4)\\,{|}_{(-4,1)} \\\\  & =\\operatorname{ln}⁡(3(-4)-2(1)+4) \\\\  & =\\operatorname{ln}⁡(-12-2+4) \\\\  & =\\operatorname{ln}⁡(-10),\\end{aligned}\n$$\n\nwhich is undefined."}] [{:db/id #edb/ref 17592186278212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "874e8073-0d08-552f-bf41-fef79f0acdfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}=0}" :db/id #edb/ref 17592186276695} {:answer/id #uuid "c059d3a9-b3cd-56dc-9f69-2505b594f4d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<2\\pi }" :db/id #edb/ref 17592186277184} {:answer/id #uuid "da005de1-0354-502a-bf8d-180b375e6964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}>0}" :db/id #edb/ref 17592186277390} {:answer/id #uuid "da30121f-ade9-5e6c-83e6-52804967cc60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ne 0}" :db/id #edb/ref 17592186277391} {:answer/id #uuid "f4807b75-ccc3-5cff-a9dd-006ae92951c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186277617}] :answer-field/correct {:answer/id #uuid "f4807b75-ccc3-5cff-a9dd-006ae92951c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186277617} :answer-field/id #uuid "0b05ec92-0b25-5e00-a2e5-2fb1edc2cd41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277746}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41205b92-d424-5502-be6f-040740489edd" :question/math-academy-id "q-158573" :question/problem "Find the domain of the function $f(x,y)=\\operatorname{sin}⁡({x}^{2}+{y}^{2}).$" :question/worked-solution "Notice that\n\n- ${x}^{2}+{y}^{2}$ is defined for all $x$ and $y,$ and\n\n- $\\operatorname{sin}⁡g(x,y)$ is defined if $g(x,y)$ is defined.\n\nAs a result, $\\operatorname{sin}⁡({x}^{2}+{y}^{2})$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane."}] [{:db/id #edb/ref 17592186278213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10745616-0602-5d0a-b702-ddf953b4fd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275623} {:answer/id #uuid "2eacecbd-7897-59d9-bb65-2d0a2e156dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275896} {:answer/id #uuid "49f2e092-d9b4-56d8-a57b-65f1230599e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276129} {:answer/id #uuid "6c46acf3-b068-5e7a-af82-06cfd2ae6fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186276450} {:answer/id #uuid "8db0cfa0-69d5-5323-bda4-d39822ec80f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276761}] :answer-field/correct {:answer/id #uuid "10745616-0602-5d0a-b702-ddf953b4fd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275623} :answer-field/id #uuid "36c223f0-1ac5-50b8-bc16-df19662b3923" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277808}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d225e24f-f8fc-5851-bdaa-9e7972c2ed2f" :question/math-academy-id "q-158574" :question/problem "Evaluate $z=x\\operatorname{ln}⁡y-1$ at the point $(3,{e}^{2}).$" :question/worked-solution "To evaluate our multivariable function at the point $(3,{e}^{2}),$ we substitute $x=3$ and $y={e}^{2}$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(3,{e}^{2})} & =(x\\operatorname{ln}⁡y-1){|}_{(3,{e}^{2})} \\\\  & =3\\operatorname{ln}⁡({e}^{2})-1 \\\\  & =3(2\\operatorname{ln}⁡e)-1 \\\\  & =3(2)-1 \\\\  & =6-1 \\\\  & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f7a5bbc-3365-5bba-82b2-9e07c2d95446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186276481} {:answer/id #uuid "5a2a0eb0-6434-58f7-9e6c-4792c1123498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>1\\}" :db/id #edb/ref 17592186564111} {:answer/id #uuid "9c51b544-d4a2-5932-8f15-bac18a3bfea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0,1\\}" :db/id #edb/ref 17592186564208} {:answer/id #uuid "afb9bfc6-03a7-5955-a866-f8b80cc14adc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0\\}" :db/id #edb/ref 17592186564241} {:answer/id #uuid "c250b76c-84fb-5171-96ad-26f59f4cc182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1\\}" :db/id #edb/ref 17592186564268}] :answer-field/correct {:answer/id #uuid "c250b76c-84fb-5171-96ad-26f59f4cc182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1\\}" :db/id #edb/ref 17592186564268} :answer-field/id #uuid "123bde27-b22e-5118-aaaf-2bd06d63606a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "806bcc75-b225-5d86-8c9e-f99567365362" :question/math-academy-id "q-158577" :question/problem "Find the domain of the function $z=\\frac{{x}^{3}}{\\operatorname{ln}⁡({x}^{2}-{y}^{2})}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ \\operatorname{ln}⁡({x}^{2}-{y}^{2})\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ {x}^{2}-{y}^{2}\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1\\}.\n$$"}] [{:db/id #edb/ref 17592186278215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21657e95-6ee9-5970-a9cc-d509a7172a95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186275779} {:answer/id #uuid "58cdbe1f-ce81-5f62-aff6-88877f337c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186276276} {:answer/id #uuid "6a4fd9ba-6782-5304-94fe-1ac889025e8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276433} {:answer/id #uuid "7c747cf7-ad6f-56fd-8290-41a0162b1b23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276614} {:answer/id #uuid "cbab29c5-3c01-5680-add0-0542eeec59d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186277289}] :answer-field/correct {:answer/id #uuid "21657e95-6ee9-5970-a9cc-d509a7172a95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186275779} :answer-field/id #uuid "4915e3fb-3f40-544b-a170-cc35fa8a3f2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277842}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6e391d1a-8298-5c2b-8fbb-e2c14854c2e0" :question/math-academy-id "q-158588" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=3{y}^{3}-x+2.\n$$\n\nEvaluate this function at the point $(5,-1).$" :question/worked-solution "To evaluate our multivariable function at the point $(5,-1),$ we substitute $x=5$ and $y=-1$ into the function expression:\n\n$$\n\\begin{aligned}f(5,-1) & =(3{y}^{3}-x+2){|}_{(5,-1)} \\\\  & =3(-1)^{3}-5+2 \\\\  & =-3-5+2 \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "626d2cd4-d863-551b-85d4-0992a3ac3e3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{3}" :db/id #edb/ref 17592186276367} {:answer/id #uuid "7859973b-3d98-5be2-96e5-8bd6508350c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{6}" :db/id #edb/ref 17592186276566} {:answer/id #uuid "79248bfa-b635-5b6c-bdc8-42d448958105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186276576} {:answer/id #uuid "f7b54037-0784-559d-ba12-67cbd84e6545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277641} {:answer/id #uuid "f918b368-d56e-5b4b-bfdb-ff83590c0dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277657}] :answer-field/correct {:answer/id #uuid "f918b368-d56e-5b4b-bfdb-ff83590c0dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277657} :answer-field/id #uuid "d8cea2f7-c629-5a03-9bc8-1543391bae01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278106}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a10c57f-681f-57e8-b21b-1312730cce62" :question/math-academy-id "q-158591" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=\\sqrt[3]{xy+7}.\n$$\n\nEvaluate this function at the point $(-4,-5).$" :question/worked-solution "To evaluate our multivariable function at the point $(-4,-5),$ we substitute $x=-4$ and $y=-5$ into the function expression:\n\n$$\n\\begin{aligned}f(-4,-5) & =\\sqrt[3]{xy+7}\\,{|}_{(-4,-5)} \\\\  & =\\sqrt[3]{(-4)(-5)+7} \\\\  & =\\sqrt[3]{20+7} \\\\  & =\\sqrt[3]{27} \\\\  & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d179e7e-f303-5e43-9e54-e88411ae105b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275744} {:answer/id #uuid "46e40daf-130d-5c56-b7c2-fc096cd4aed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186276104} {:answer/id #uuid "b2806a77-e40d-5b69-bab9-8967e1d6fe69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186277077} {:answer/id #uuid "b68d0a3c-5c93-53b8-8605-a4d0414d525a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186277100} {:answer/id #uuid "fd305dd5-1d3f-5453-8e82-323421970570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{2}" :db/id #edb/ref 17592186277696}] :answer-field/correct {:answer/id #uuid "b68d0a3c-5c93-53b8-8605-a4d0414d525a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186277100} :answer-field/id #uuid "c5402d2d-2d55-5783-b6ed-20607de2fef0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278072}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64dcbd76-8d54-5023-881a-a57cc6e8bf6c" :question/math-academy-id "q-158592" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=x\\operatorname{sin}⁡y.\n$$\n\nEvaluate this function at the point $(-6,-\\frac{\\pi }{4}).$" :question/worked-solution "To evaluate our multivariable function at the point $(-6,-\\frac{\\pi }{4}),$ we substitute $x=-6$ and $y=-\\frac{\\pi }{4}$ into the function expression:\n\n$$\n\\begin{aligned}f(-6,-\\frac{\\pi }{4}) & =x\\operatorname{sin}⁡y\\,{|}_{(-6,-\\pi /4)} \\\\  & =-6\\operatorname{sin}⁡\\left(-\\frac{\\pi }{4}\\right) \\\\  & =-6\\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =3\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7dd88c6-a262-58f6-95e2-e5384e5a31d1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/18/18dcabdd46f686f12ce0577d5398b525976ee8404209d24a187c3d372a3bf78a.png" :db/id #edb/ref 17592186378748} {:answer/id #uuid "e43659e6-8eca-521f-a3ac-7988fc36588b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4add22572db01658a9c909f66be2d53f14331454ab32577ced33011fe05fafa.png" :db/id #edb/ref 17592186378749} {:answer/id #uuid "50b317ce-e6eb-5c10-bf7a-1fcf5464941b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c641990be320fa60b602e3d42ab5d29648eb3d5274645f8193018d132c964599.png" :db/id #edb/ref 17592186378750} {:answer/id #uuid "04ab281c-1447-5ea1-a446-2b1264179bd6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e7/e79d4b0590032bc951f56e3117a6e5048e7101e270043b3e01b11e961b8c52a3.png" :db/id #edb/ref 17592186378751} {:answer/id #uuid "8b2d7682-8df8-5624-9a62-ae12d475ff4d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e646fe749cc50c557df1a35c69d9de75b16064afe42e467e62784b705c189b36.png" :db/id #edb/ref 17592186378752}] :answer-field/correct {:answer/id #uuid "8b2d7682-8df8-5624-9a62-ae12d475ff4d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e646fe749cc50c557df1a35c69d9de75b16064afe42e467e62784b705c189b36.png" :db/id #edb/ref 17592186378752} :answer-field/id #uuid "c0adcc51-cdb5-5e33-a2ed-45fc79d72d4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378747}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f8af9ca-3fa0-5528-bb2b-5f736d2c06fe" :question/math-academy-id "q-158204" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\sqrt{y+{x}^{2}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\ny+{x}^{2}\\ge 0\\,⟹\\,y\\ge -{x}^{2}\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge -{x}^{2}\\}.\n$$\n\nSince the inequality involves the $\\ge $ sign, the curve is part of the domain. Therefore, we draw a solid curve $y=-{x}^{2}$ and shade the area *outside* the curve.\n\nThe resulting domain is as follows:\n\n![](images/0b/0b7a6dbbab890b469cf389fa27627e9c1a5f95d8892507fcd4ba5f70541936ea.png)"}] [{:db/id #edb/ref 17592186378773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92757d03-2388-5c47-beca-df9e4078abe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x+y\\ne 0}" :db/id #edb/ref 17592186378775} {:answer/id #uuid "c358dedf-36c4-5ea3-b154-5b6cc1b476da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186378776} {:answer/id #uuid "d39ddcb8-46de-53c0-a0ba-9c3d861ea003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x+y<0}" :db/id #edb/ref 17592186378777} {:answer/id #uuid "89ae4167-2f7d-55f3-a7d9-6313ae2baa6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x+y>0}" :db/id #edb/ref 17592186378778} {:answer/id #uuid "6ce6d2b0-044b-5087-89cc-9dd95c17cffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x+y\\ne -1}" :db/id #edb/ref 17592186378779}] :answer-field/correct {:answer/id #uuid "92757d03-2388-5c47-beca-df9e4078abe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x+y\\ne 0}" :db/id #edb/ref 17592186378775} :answer-field/id #uuid "2889e158-0053-58e8-9ac0-bcb233479121" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378774}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5a5f0a19-c9e6-5cb8-90ec-d158940d83f6" :question/math-academy-id "q-158550" :question/problem "Find the domain of the function $f(x,y)=\\frac{2x+y}{(x+y)^{2}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n(x+y)^{2}\\ne 0\\,⟹\\,x+y\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x+y\\ne 0}.\n$$"}] [{:db/id #edb/ref 17592186378780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b856f2fe-9b4f-5951-916a-b4d19c357b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne -2}" :db/id #edb/ref 17592186378782} {:answer/id #uuid "95be0e3e-e128-579b-b71f-de9310a30a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x>-2}" :db/id #edb/ref 17592186378783} {:answer/id #uuid "222f06f9-0369-5850-a115-1a00d293c72a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186378784} {:answer/id #uuid "9830c844-b778-546b-88b6-640c2ad92084" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge -2}" :db/id #edb/ref 17592186378785} {:answer/id #uuid "0f86fae6-db40-56f5-beae-fae3b622dcc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x>-2,\\,y=0}" :db/id #edb/ref 17592186378786}] :answer-field/correct {:answer/id #uuid "95be0e3e-e128-579b-b71f-de9310a30a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x>-2}" :db/id #edb/ref 17592186378783} :answer-field/id #uuid "fedade10-2b0e-5184-8ff4-3f0fcf478542" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378781}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c169bcc-a581-55f9-b4fe-8fe294bcd657" :question/math-academy-id "q-158559" :question/problem "Find the domain of the function $z=\\frac{{x}^{2}+3y}{\\sqrt{x+2}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx+2>0\\,⟹\\,x>-2\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x>-2}.\n$$"}] [{:db/id #edb/ref 17592186378787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186ffedd-8963-5331-8dee-228ee0b2bf5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186378789} {:answer/id #uuid "a664ed89-b412-50db-9336-b5a981dbd51f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y<-2,\\,y\\ne 2{x}^{3}}" :db/id #edb/ref 17592186378790} {:answer/id #uuid "04de4494-092a-59be-bf41-05a523518384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2,\\,y>2{x}^{3}}" :db/id #edb/ref 17592186378791} {:answer/id #uuid "2a3506b2-6406-50dd-b036-ea7413383d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y\\ne 2{x}^{3}}" :db/id #edb/ref 17592186378792} {:answer/id #uuid "7299cc62-a05d-5895-ac7d-c3f9ab0cf70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y>2{x}^{3}}" :db/id #edb/ref 17592186378793}] :answer-field/correct {:answer/id #uuid "2a3506b2-6406-50dd-b036-ea7413383d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y\\ne 2{x}^{3}}" :db/id #edb/ref 17592186378792} :answer-field/id #uuid "d18fb94b-0aa1-5189-9b62-680a65bf7d2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378788}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "44bfd95c-9ee8-5b8e-91af-f8c6e58bbec3" :question/math-academy-id "q-158563" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{y+2}}{2{x}^{3}-y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}y+2\\ge 0 \\\\ 2{x}^{3}-y\\ne 0\\end{aligned}\\,⟹\\,{\\begin{aligned}y\\ge -2 \\\\ y\\ne 2{x}^{3}\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y\\ne 2{x}^{3}}.\n$$"}] [{:db/id #edb/ref 17592186378794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cfd14df-2546-5211-95b9-f833b6ef2695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}y<0}" :db/id #edb/ref 17592186378796} {:answer/id #uuid "29d9e207-b7e4-5b1a-b156-70707564dc10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}y\\ne 0}" :db/id #edb/ref 17592186378797} {:answer/id #uuid "6dc9b7d0-5679-5152-8561-d6d4ee22887b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}y\\ge 0}" :db/id #edb/ref 17592186378798} {:answer/id #uuid "7986ee5d-d3f5-552c-8101-a9bdf4c56e7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186378799} {:answer/id #uuid "8bc476d6-4029-5548-89ba-99920001dc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}y>0}" :db/id #edb/ref 17592186378800}] :answer-field/correct {:answer/id #uuid "7986ee5d-d3f5-552c-8101-a9bdf4c56e7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186378799} :answer-field/id #uuid "f4292cef-6a77-561a-be05-517ab4cec5f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378795}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "82bb42aa-d239-57ff-a8e6-5069e851b06c" :question/math-academy-id "q-158566" :question/problem "Find the domain of the function $f(x,y)={e}^{-{x}^{3}y}.$" :question/worked-solution "Notice that\n\n- $-{x}^{3}y$ is defined for all $x$ and $y,$ and\n\n- ${e}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${e}^{-{x}^{3}y}$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane."}] [{:db/id #edb/ref 17592186378801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfbb9e1c-dc0f-5379-8105-ae634692cef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186378803} {:answer/id #uuid "6ea7abc0-92ea-5c67-a855-acec34388228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186378804} {:answer/id #uuid "6fdbcac9-e1c9-5053-b624-a38756f3cdce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186378805} {:answer/id #uui