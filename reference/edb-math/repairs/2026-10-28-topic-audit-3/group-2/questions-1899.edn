 :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-\\frac{\\pi }{2}\\le x-y\\le \\frac{\\pi }{2}}" :db/id #edb/ref 17592186273604} {:answer/id #uuid "a40eb757-e322-5c5a-ae24-103986e65d27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,0\\le x-y\\le \\pi }" :db/id #edb/ref 17592186273802} {:answer/id #uuid "b8517e7a-c661-562c-81e8-faa0f8fe98e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1,\\,x>0}" :db/id #edb/ref 17592186273983} {:answer/id #uuid "db332580-91a3-58b1-ad8e-07bfc400b3ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186274306}] :answer-field/correct {:answer/id #uuid "7ed55f36-0c59-534d-95e8-07b34cf2dc0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1}" :db/id #edb/ref 17592186273476} :answer-field/id #uuid "5b7c962d-3d23-53a3-911a-272dffdfe63f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274793}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8d83dba6-238e-5ccd-970d-da3225e73ce3" :question/math-academy-id "q-158181" :question/problem "Find the domain of the function  $f(x,y)=\\operatorname{arccos}⁡(x-y).$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The argument of the arccosine has values between $-1$ and $1.$\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n-1\\le x-y\\le 1\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1}.\n$$"}] [{:db/id #edb/ref 17592186124799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f166b0-54e7-561f-80d2-086b2073b054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}=0}" :db/id #edb/ref 17592186272564} {:answer/id #uuid "3f91f6f3-dc59-5a5e-9270-08e65d8f40a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186272933} {:answer/id #uuid "6dbaa72c-fbcd-5392-a287-ddedb19f330f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<2}" :db/id #edb/ref 17592186273337} {:answer/id #uuid "9bc9b67f-ec69-5a36-b521-dc6edc1c699b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ne 0}" :db/id #edb/ref 17592186273737} {:answer/id #uuid "eb3b6642-1b82-5a67-9fba-277e22bfc82c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ge 1}" :db/id #edb/ref 17592186274465}] :answer-field/correct {:answer/id #uuid "9bc9b67f-ec69-5a36-b521-dc6edc1c699b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ne 0}" :db/id #edb/ref 17592186273737} :answer-field/id #uuid "36e5f2b4-f356-5c4d-b8fd-c69f6c56e2e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274730}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0b8f769a-fcb4-5284-aeb5-6002c7cc37e2" :question/math-academy-id "q-158182" :question/problem "Find the domain of the function $f(x,y)=\\frac{xy}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}+{y}^{2}\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ne 0}.\n$$"}] [{:db/id #edb/ref 17592186124800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "276ef443-515a-5fc5-811c-9fd1a1c9389d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b7cf0f04bb0ac9373b222edef23d2925ea40d06fafa33f03423220f99de7d95f.png" :db/id #edb/ref 17592186272736} {:answer/id #uuid "50a009e0-93df-51e7-920e-e0763fa10bd8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1c/1c1d7ca7d9fdcaa8baeded0408339b29130810c07fb90b27ebc0674f9bffa275.png" :db/id #edb/ref 17592186273070} {:answer/id #uuid "510a0b87-4b2e-5a08-98ae-86d141d6ee14" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7afd18ecf16e868bb65e43626144251a1387d3dbbac8ec552ab1f8544b35d6fe.png" :db/id #edb/ref 17592186273075} {:answer/id #uuid "67c03a35-d64e-56cc-b238-c85ee6143494" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/488ae413d28377a5dcd8887003e5389c082189867c0d3cdf0564d4a2f351ed56.png" :db/id #edb/ref 17592186273282} {:answer/id #uuid "f1ef31de-ea63-5a11-adb1-d631ad0edd13" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2ddf4edfd91b14835e7b14ca8cebf08b82b8585d9fd18972c8b065d6153a62f0.png" :db/id #edb/ref 17592186274524}] :answer-field/correct {:answer/id #uuid "276ef443-515a-5fc5-811c-9fd1a1c9389d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b7cf0f04bb0ac9373b222edef23d2925ea40d06fafa33f03423220f99de7d95f.png" :db/id #edb/ref 17592186272736} :answer-field/id #uuid "7c6210ce-a078-5b05-a002-cbeb9bc8a1bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274849}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "76db17ba-163a-5fe3-9bd7-63e519e3eab2" :question/math-academy-id "q-158195" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}-1}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}+{y}^{2}-1\\ge 0\\,⟹\\,{x}^{2}+{y}^{2}\\ge 1\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ge 1\\}.\n$$\n\nSince the inequality involves the $\\ge $ sign, the curve ${x}^{2}+{y}^{2}=1$ is part of the domain. Therefore, we draw a solid curve ${x}^{2}+{y}^{2}=1$ and shade the area *outside* the curve.\n\nThe resulting domain is as follows:\n\n![](images/ba/ba31bbc16c58860a4bc3c4d33ea1a61cb3d86d0e73d8aa6a67869b3e96a7fe32.png)"}] [{:db/id #edb/ref 17592186124801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01afdd60-14a5-5347-97c0-b145df6c08f5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/934de8df0f2c2a0c93d3966a66f1eed69744079f4beee57d7cc46e6ca20fddcb.png" :db/id #edb/ref 17592186121404} {:answer/id #uuid "42fd1e88-b1bd-520d-91af-11e4da73aadd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09a061a81ca4b3201e9b97ad15354c14003e41d610c2892f5b6ba468761e83b7.png" :db/id #edb/ref 17592186121405} {:answer/id #uuid "52848fa8-e0a8-5d95-b7e3-ee8a85dd9598" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/407b19e99e4fe935cc353c18afcd8576bc4a8d6fa10f5d059ff1b4a7005f4f21.png" :db/id #edb/ref 17592186121406} {:answer/id #uuid "6dae1c1d-e85c-5ad2-95d5-247890638d6a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/800cc48a7cbe24b302e3ea0d4ddd156bd33cb1ad45d8dafbbcef20b997c24585.png" :db/id #edb/ref 17592186121407} {:answer/id #uuid "7839d4ad-f7d4-57b2-a944-52dd9c55849d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/280ac039d18c0af132b0a2a85a3b94226c7ff2b310c460a1086d52402bc41865.png" :db/id #edb/ref 17592186121408}] :answer-field/correct {:answer/id #uuid "7839d4ad-f7d4-57b2-a944-52dd9c55849d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/280ac039d18c0af132b0a2a85a3b94226c7ff2b310c460a1086d52402bc41865.png" :db/id #edb/ref 17592186121408} :answer-field/id #uuid "51e5d630-8dfa-5699-9375-937c6eb03e4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121403}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "036420cb-4253-5cbd-8d56-15a7f64df030" :question/math-academy-id "q-158197" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{1}{x-y}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx-y\\ne 0\\,⟹\\,y\\ne x\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,y\\ne x}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $y=x$ and shade *above* and *below* the line.\n\nThe resulting domain is as follows:\n\n![](images/69/6953e2f817a786ae5ea52ea224a31b12a40a3ca89999a6bd5b1453eec11f8559.png)"}] [{:db/id #edb/ref 17592186124802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ac1e