y}\\le 1,\\,y\\ge 0}" :db/id #edb/ref 17592186378817} {:answer/id #uuid "3d2602f9-bf88-5f4c-806b-3b31eb135abb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,0\\le x+\\sqrt{y}\\le \\pi ,\\,y\\ge 0}" :db/id #edb/ref 17592186378818} {:answer/id #uuid "7e7f95e2-47aa-5848-9ff2-0d515cb9ec9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x+y\\le 1,\\,y\\ne 0}" :db/id #edb/ref 17592186378819} {:answer/id #uuid "aea1a380-0313-53a2-a0ce-7641b7fcdb9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-\\pi \\le x+\\sqrt{y}\\le \\pi ,\\,y>0}" :db/id #edb/ref 17592186378820} {:answer/id #uuid "fdef3191-6fbe-5154-ac37-b725da275be0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186378821}] :answer-field/correct {:answer/id #uuid "af358399-f5b9-530a-86bf-886ecb494541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x+\\sqrt{y}\\le 1,\\,y\\ge 0}" :db/id #edb/ref 17592186378817} :answer-field/id #uuid "52097ee1-deb5-5b5f-aaa6-6546ee814314" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378816}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "06dfdebc-466f-504b-ab2c-86ba19d7159e" :question/math-academy-id "q-158589" :question/problem "Find the domain of the function  $f(x,y)=\\operatorname{arccos}⁡(x+\\sqrt{y}).$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The argument of the arccosine has values between $-1$ and $1,$ and\n\n- the expression under the square root must be non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{\\begin{aligned}-1<x+\\sqrt{y}<1 \\\\ y\\ge 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-1\\le x+\\sqrt{y}\\le 1,\\,y\\ge 0}.\n$$"}] [{:db/id #edb/ref 17592186378822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1a56357-1763-5ddb-a4c1-77a02817dfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6e}{\\pi }" :db/id #edb/ref 17592186378824} {:answer/id #uuid "20bb06b1-732d-53e4-8a43-31a50273c302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi \\sqrt{e}" :db/id #edb/ref 17592186378825} {:answer/id #uuid "91f4af0f-10d5-565f-9a07-659babc43aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi e" :db/id #edb/ref 17592186378826} {:answer/id #uuid "e98a25b2-0b21-5c9f-811d-c26eab92dd55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{e}}{\\pi }" :db/id #edb/ref 17592186378827} {:answer/id #uuid "2a8d3cc6-3a5f-5a7c-ad92-d3df03abeddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3e}{\\pi }" :db/id #edb/ref 17592186378828}] :answer-field/correct {:answer/id #uuid "d1a56357-1763-5ddb-a4c1-77a02817dfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6e}{\\pi }" :db/id #edb/ref 17592186378824} :answer-field/id #uuid "f63e530d-36f3-528b-89d6-88b52987714c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378823}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b4986375-d8de-524c-9cca-ad92c58d9cc6" :question/math-academy-id "q-158595" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=\\frac{{e}^{y}}{\\operatorname{arcsin}⁡x}.\n$$\n\nEvaluate this function at the point $(\\frac{1}{2},1).$" :question/worked-solution "To evaluate our multivariable function at the point $(\\frac{1}{2},1),$ we substitute $x=\\frac{1}{2}$ and $y=1$ into the function expression:\n\n$$\n\\begin{aligned}f(\\frac{1}{2},1) & =\\frac{{e}^{y}}{\\operatorname{arcsin}⁡x}\\,{|}_{(1/2,1)} \\\\  & =\\frac{{e}^{1}}{\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)} \\\\  & =\\frac{e}{\\left(\\frac{\\pi }{6}\\right)} \\\\  & =\\frac{6e}{\\pi }\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31993f67-cb13-54c1-825f-a871eb2dd965" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/04/044cb99eef6bafea63a4b4dd8df2a465790ea8eda949d98dd97df2ed768791be.png" :db/id #edb/ref 17592186378831} {:answer/id #uuid "6e60753e-9691-518b-a34b-cefcf9d4bc24" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/934de8df0f2c2a0c93d3966a66f1eed69744079f4beee57d7cc46e6ca20fddcb.png" :db/id #edb/ref 17592186378832} {:answer/id #uuid "7ade9180-8b54-5d3a-bfdb-c1cb7778c73a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2ddf4edfd91b14835e7b14ca8cebf08b82b8585d9fd18972c8b065d6153a62f0.png" :db/id #edb/ref 17592186378833} {:answer/id #uuid "501346e1-a1e0-553c-96ce-2d555eb1295a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/280ac039d18c0af132b0a2a85a3b94226c7ff2b310c460a1086d52402bc41865.png" :db/id #edb/ref 17592186378834} {:answer/id #uuid "9eae9821-d4e8-5aa2-84b4-d170a1a95d15" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6a/6a111de19f5b6fdc447cac043e875b243c67709180ca23b2283d448cdbfda94d.png" :db/id #edb/ref 17592186378835}] :answer-field/correct {:answer/id #uuid "31993f67-cb13-54c1-825f-a871eb2dd965" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/04/044cb99eef6bafea63a4b4dd8df2a465790ea8eda949d98dd97df2ed768791be.png" :db/id #edb/ref 17592186378831} :answer-field/id #uuid "04cdf5f5-74c6-51ca-8422-d1cd0d51b9e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378830}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56f9c6d4-908f-5999-9300-6cd67e4208c5" :question/math-academy-id "q-158600" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{1}{{x}^{3}+y}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{3}+y\\ne 0\\,⟹\\,y\\ne -{x}^{3}\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ne -{x}^{3}\\}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed curve $y=-{x}^{3}$ and shade *above* and *below* the curve.\n\nThe resulting domain is as follows:\n\n![](images/6c/6c85783dc6626a3fea9d06431ee31e202da8c4d88e2eb1c2b6608dccdc2b782e.png)"}] [{:db/id #edb/ref 17592186388981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5fbd44c-edf5-56b4-9863-36a35f3b9ad3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9f4dd7da9adf7ec5580f4e866fdf094e90e87425ce435feae6dc41488e6518bf.png" :db/id #edb/ref 17592186388983} {:answer/id #uuid "dce09265-cac3-50b1-9938-d4e109c7378c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e55fa4f75253935fb3f372dd82612b241d1133aceaa51666fdb0513decba8ea.png" :db/id #edb/ref 17592186388984} {:answer/id #uuid "6e38f214-36b2-5226-88a7-d7314eed1c5a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/64/6431427a27685248942ae4ac998feeb8f38d210b63e7f4c429ce3a5bf9afd1e5.png" :db/id #edb/ref 17592186388985} {:answer/id #uuid "aea45356-e834-5306-9e4b-0c712e35b96f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/04/04b8028809192321180e05f2e86c5e149b4870ddb0adea7e3191e2db33f12133.png" :db/id #edb/ref 17592186388986} {:answer/id #uuid "283aafa9-a98b-5196-ab68-7113c77960e4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91094f3f8fc9b21724e4e6d0f33e2ec0dc18782b3cc0aa1d4b1e4226e4bb93bc.png" :db/id #edb/ref 17592186388987}] :answer-field/correct {:answer/id #uuid "dce09265-cac3-50b1-9938-d4e109c7378c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e55fa4f75253935fb3f372dd82612b241d1133aceaa51666fdb0513decba8ea.png" :db/id #edb/ref 17592186388984} :answer-field/id #uuid "c35e8875-bbf9-5e5f-bc9a-34467a284be5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388982}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ddc33dd3-a1a1-567c-a9d1-d5d15d54e87f" :question/math-academy-id "q-158200" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{y}{2-x}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2-x\\ne 0\\,⟹\\,x\\ne 2\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,x\\ne 2}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $x=2$ and shade *right* and *left* the line.\n\nThe resulting domain is as follows:\n\n![](images/23/2371c9724d66e0f7d74c45e173f9625a986615185c10d55c029976baa82d0877.png)"}] [{:db/id #edb/ref 17592186388988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c91f7252-2ff5-527f-9655-70e7dabdfa63" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89076b709a935f384acab2609f2d046123ceb3984c5ae60818f908525ad5e53d.png" :db/id #edb/ref 17592186388990} {:answer/id #uuid "34f1e16e-cbc1-5a7f-b808-dd9fc70fa781" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/4030364abd4fd5a8f21e4ac358adb077ed56fb2a33f14ed49d4131e7ab36af6d.png" :db/id #edb/ref 17592186388991} {:answer/id #uuid "8295865c-6ec5-5877-93c7-08b4a9de7247" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/43693fc51d09f6408198a74dc5672a2904b1ad0d45f6abc7f1f4aad0b2764a5b.png" :db/id #edb/ref 17592186388992} {:answer/id #uuid "5accd97b-35b2-571d-8505-8db9329051a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f843c386c730f85e7c3511e4fd8631b01f77b998f4e99fe19ed9783e4c4b6cbb.png" :db/id #edb/ref 17592186388993} {:answer/id #uuid "5eeca2ff-1397-558c-b26b-156e2af27244" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/44/44e6511542b39bb3946095ff28c7a82ab3e35b5e50d648aba246413e6fea00c4.png" :db/id #edb/ref 17592186388994}] :answer-field/correct {:answer/id #uuid "c91f7252-2ff5-527f-9655-70e7dabdfa63" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89076b709a935f384acab2609f2d046123ceb3984c5ae60818f908525ad5e53d.png" :db/id #edb/ref 17592186388990} :answer-field/id #uuid "d8830a22-e4bc-585f-b4d8-653840c79639" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388989}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fa9a90c8-68ec-5392-a3c8-0ae9ab63850c" :question/math-academy-id "q-158202" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\operatorname{ln}⁡(y-2x)?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the logarithm is positive.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\ny-2x>0\\,⟹\\,y>2x\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,y>2x}.\n$$\n\nSince the expression involves the $>$ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $y=2x$ and shade the region *above* the line.\n\nThe resulting domain is as follows:\n\n![](images/42/42e2faf3df63b038b57d2fddc9b7ef2c2e720dae6e0a8524d602b7ac93681b3d.png)"}] [{:db/id #edb/ref 17592186388995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "613e7132-2128-56b5-bc00-f53656e511b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/65/65e29ff9fda5ad25fbbd68121d0c1a86e27a41de8890af31425208d7c38f2c2f.png" :db/id #edb/ref 17592186388997} {:answer/id #uuid "344a137c-9b7d-593b-8372-97e276d83d39" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c3/c30be01de07727a44fce390cfc2c56ddeed8071a7a7d64abec831a31aa2079fe.png" :db/id #edb/ref 17592186388998} {:answer/id #uuid "73c75e4a-3588-5716-a610-2b5c06d6af3b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/4789f1e3a4fbe0c6f23980010a0222905cb46b4ef105b02e7fba0b59fc570eeb.png" :db/id #edb/ref 17592186388999} {:answer/id #uuid "0c8633ad-7e8b-588d-bda6-758ae14482e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/402d90507403eabf4cd35cde83a45c9fa2d8080347e1debb0e2463be408b489b.png" :db/id #edb/ref 17592186389000} {:answer/id #uuid "04f3aa5b-1769-54da-88b9-15a178728381" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fefbca84defd52b9fecd3b13b37cb95a744b4ddedd5a570ad554b6a251cd6077.png" :db/id #edb/ref 17592186389001}] :answer-field/correct {:answer/id #uuid "04f3aa5b-1769-54da-88b9-15a178728381" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fefbca84defd52b9fecd3b13b37cb95a744b4ddedd5a570ad554b6a251cd6077.png" :db/id #edb/ref 17592186389001} :answer-field/id #uuid "60958810-5683-5293-9f68-2735d4937038" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388996}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9419d3b0-0595-5357-8a67-2ff487c67499" :question/math-academy-id "q-158205" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\frac{1}{{x}^{2}+{y}^{2}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}+{y}^{2}\\ne 0\\,⟹\\,(x,y)\\ne (0,0)\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,(x.y)\\ne (0,0)\\}.\n$$\n\nSince the expression involves the $\\ne $ sign, the point $(0,0)$ is *not* part of the domain. Therefore, we exclude the point $(x,y)=(0,0)$ and shade the plane.\n\nThe resulting domain is as follows:\n\n![](images/70/701c54bff1c431883f21cb980ac43f4f2f6beabb11817066a4e909d5a2663a25.png)"}] [{:db/id #edb/ref 17592186401123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d17359d3-8c16-5f6a-b127-4635699145de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 2x}" :db/id #edb/ref 17592186401125} {:answer/id #uuid "723d1468-5b49-57b7-aca8-480bc0d17b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y<2x}" :db/id #edb/ref 17592186401126} {:answer/id #uuid "3ee0d3a5-a4a1-5cee-a062-442dab6411d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y>2x}" :db/id #edb/ref 17592186401127} {:answer/id #uuid "ab4e594f-0e4b-5943-92bb-bf8c40588e8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186401128} {:answer/id #uuid "20fdbcce-ba79-5860-9e27-a2583b78aa49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2x}" :db/id #edb/ref 17592186401129}] :answer-field/correct {:answer/id #uuid "ab4e594f-0e4b-5943-92bb-bf8c40588e8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186401128} :answer-field/id #uuid "2a4d4ae3-6796-52c1-a3b7-76a9cd48622e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401124}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d3d7c34b-eed1-5181-a45d-9a598cc7cc31" :question/math-academy-id "q-158569" :question/problem "Find the domain of the function $f(x,y)={2}^{y-2x}.$" :question/worked-solution "Notice that\n\n- $y-2x$ is defined for all $x$ and $y,$ and\n\n- ${2}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${2}^{y-2x}$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane."}] [{:db/id #edb/ref 17592186435806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43ccfe2f-0560-528d-ba84-ade4a43c6a21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186435778} {:answer/id #uuid "6328591f-26cd-5a9c-bb16-a094d0fce559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,0\\le \\frac{1}{y-x}\\le \\pi \\}" :db/id #edb/ref 17592186435781} {:answer/id #uuid "9d38eb2d-c186-5118-a6d9-96fbee67928e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le \\frac{1}{y-x}\\le 1,\\,y-x\\ne 0\\}" :db/id #edb/ref 17592186435787} {:answer/id #uuid "9ea63572-0b73-594a-9be3-31c1af1775f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y-x\\ne 0\\}" :db/id #edb/ref 17592186435789} {:answer/id #uuid "e3684b28-fb6d-5385-b110-85d8de2e97a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le \\frac{1}{y-x}\\le 1\\}" :db/id #edb/ref 17592186435796}] :answer-field/correct {:answer/id #uuid "9d38eb2d-c186-5118-a6d9-96fbee67928e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le \\frac{1}{y-x}\\le 1,\\,y-x\\ne 0\\}" :db/id #edb/ref 17592186435787} :answer-field/id #uuid "4261be1e-d3be-5915-93ea-32ad8e744bfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435802}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "04c36299-59f0-54ea-b2d4-6a2a60540beb" :question/math-academy-id "q-158583" :question/problem "Find the domain of the function  $f(x,y)=\\operatorname{arccos}⁡\\left(\\frac{1}{y-x}\\right).$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The argument of the arccosine has values between $-1$ and $1,$ and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n\\{\\begin{aligned}-1<\\frac{1}{y-x}<1 \\\\ y-x\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le \\frac{1}{y-x}\\le 1,\\,y-x\\ne 0\\}.\n$$"}] [{:db/id #edb/ref 17592186435807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76429727-c36c-5953-99b6-ad256b53ad35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x+y>0\\}" :db/id #edb/ref 17592186435783} {:answer/id #uuid "9b14ad04-2e98-56ed-947e-c11c491e233f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,0<x+y<2\\pi \\}" :db/id #edb/ref 17592186435785} {:answer/id #uuid "cd1e66fe-8752-50b3-95bb-5ddf851dbaeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x+y\\ne 0\\}" :db/id #edb/ref 17592186435792} {:answer/id #uuid "d58e238a-cef0-5f2c-af19-539f41d9c5c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186435793} {:answer/id #uuid "ffc86b0d-b945-5389-9124-0ca53da17c91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x+y\\ge 0\\}" :db/id #edb/ref 17592186435800}] :answer-field/correct {:answer/id #uuid "ffc86b0d-b945-5389-9124-0ca53da17c91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x+y\\ge 0\\}" :db/id #edb/ref 17592186435800} :answer-field/id #uuid "eb150068-ffd1-5d6f-a433-79938dc22c47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435805}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7303070a-5c11-542d-9464-8fd77a6c4c78" :question/math-academy-id "q-158565" :question/problem "Find the domain of the function $f(x,y)=\\operatorname{cos}⁡\\sqrt{x+y}.$" :question/worked-solution "Notice that\n\n- $\\sqrt{x+y}$ is defined for $x$ and $y,$ such that $x+y\\ge 0,$ and\n\n- $\\operatorname{cos}⁡g(x,y)$ is defined if $g(x,y)$ is defined.\n\nAs a result, $\\operatorname{cos}⁡\\sqrt{x+y}$ is defined for values of $x$ and $y$ that satisfy $x+y\\ge 0.$\n\nTherefore, the domain of $f$ is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x+y\\ge 0\\}.\n$$"}] [{:db/id #edb/ref 17592186435808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53e832d0-cd61-540c-b2a3-7c2559bf84d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,xy\\ne 0\\}" :db/id #edb/ref 17592186435780} {:answer/id #uuid "9e4b6c86-9cf0-5ab0-9ffb-3dafec8612d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186435788} {:answer/id #uuid "bd074967-2295-5b21-8825-9badd7925df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,xy=1\\}" :db/id #edb/ref 17592186435791} {:answer/id #uuid "fb9c1db5-2655-5685-a7cd-b1d30f8510c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,xy>0\\}" :db/id #edb/ref 17592186435798} {:answer/id #uuid "fe8cd5f3-6aeb-530a-b211-e5b21f320134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,xy\\ne 1\\}" :db/id #edb/ref 17592186435799}] :answer-field/correct {:answer/id #uuid "53e832d0-cd61-540c-b2a3-7c2559bf84d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,xy\\ne 0\\}" :db/id #edb/ref 17592186435780} :answer-field/id #uuid "572ec305-a046-531a-8cd4-f40c72ec433f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435803}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "75318d12-00c4-544e-97a9-126ab4836587" :question/math-academy-id "q-158551" :question/problem "Find the domain of the function $f(x,y)=\\frac{x+y}{xy}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nxy\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,xy\\ne 0\\}.\n$$"}] [{:db/id #edb/ref 17592186435809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ed170e-f9ef-581a-a28f-e895638d17f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}\\ne -1\\}" :db/id #edb/ref 17592186435776} {:answer/id #uuid "6dfe18bb-7b8e-5e23-b6bb-c3d39e3896af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186435782} {:answer/id #uuid "a0dbcdf0-68f4-5a84-9587-f3fa35d6aba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}=-1\\}" :db/id #edb/ref 17592186435790} {:answer/id #uuid "dcdecbfa-f590-53c6-baa7-254b9858e4a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}\\ne 0\\}" :db/id #edb/ref 17592186435795} {:answer/id #uuid "f87318a8-3643-5bd8-8b57-84f2fc51ba95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}>-1\\}" :db/id #edb/ref 17592186435797}] :answer-field/correct {:answer/id #uuid "00ed170e-f9ef-581a-a28f-e895638d17f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}\\ne -1\\}" :db/id #edb/ref 17592186435776} :answer-field/id #uuid "c3b045b8-bf15-51b1-816f-a65dbb6c4b2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435804}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8d614db-1f17-5013-b1ed-45363a374722" :question/math-academy-id "q-158552" :question/problem "Find the domain of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{3}+1}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{3}+1\\ne 0\\,⟹\\,{x}^{3}\\ne -1\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{3}\\ne -1\\}.\n$$"}] [{:db/id #edb/ref 17592186435810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c9017c3-0305-5a1f-91b7-5ff0abefd2b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186435777} {:answer/id #uuid "4cdfbe0f-7325-5f77-a8c6-761b1ce65557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186435779} {:answer/id #uuid "81903d38-806f-5011-865e-1ba6f995e0e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435784} {:answer/id #uuid "9cf5fa64-468b-5aa3-b046-e9ca3d40c1fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186435786} {:answer/id #uuid "d978482b-dadc-5142-91af-61294dc15739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186435794}] :answer-field/correct {:answer/id #uuid "d978482b-dadc-5142-91af-61294dc15739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186435794} :answer-field/id #uuid "0f239717-0131-5270-be88-b5cd8017e7fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435801}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb2bfb86-4e76-5321-aed7-06eaaf8188f8" :question/math-academy-id "q-158582" :question/problem "Evaluate $z=\\frac{x}{\\operatorname{cos}⁡y}$ at the point $(3,-\\frac{\\pi }{3}).$" :question/worked-solution "To evaluate our multivariable function at the point $(3,-\\frac{\\pi }{3}),$ we substitute $x=3$ and $y=-\\frac{\\pi }{3}$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(3,-\\pi /3)} & =\\frac{x}{\\operatorname{cos}⁡y}\\,{|}_{(3,-\\pi /3)} \\\\  & =\\frac{3}{\\operatorname{cos}⁡\\left(-\\frac{\\pi }{3}\\right)} \\\\  & =\\frac{3}{\\left(\\frac{1}{2}\\right)} \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186564467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "235f0230-c6a2-58fc-bd59-7672f354b6da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y\\ne 2x\\}" :db/id #edb/ref 17592186564021} {:answer/id #uuid "aae1a469-d68e-59c0-a688-35b023ed0b2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y={x}^{2},\\,y>2x\\}" :db/id #edb/ref 17592186564227} {:answer/id #uuid "aef90284-fc08-5b4f-9e81-9caa92dfe802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y<{x}^{2},\\,y\\ne 2x\\}" :db/id #edb/ref 17592186564239} {:answer/id #uuid "b015e9e9-ed69-58a1-bc47-3d84c2927025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y>2x\\}" :db/id #edb/ref 17592186564244} {:answer/id #uuid "c6cc232c-cc23-5849-87bd-c3d853e16f7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186564278}] :answer-field/correct {:answer/id #uuid "235f0230-c6a2-58fc-bd59-7672f354b6da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y\\ne 2x\\}" :db/id #edb/ref 17592186564021} :answer-field/id #uuid "fbec5fcc-3c3a-5ffd-b0f3-92a5d7992122" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564463}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/math-academy-id "q-158561" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{y-{x}^{2}}}{2x-y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n\\{\\begin{aligned}y-{x}^{2}\\ge 0 \\\\ 2x-y\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}y\\ge {x}^{2} \\\\ y\\ne 2x\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y\\ne 2x\\}.\n$$"}] [{:db/id #edb/ref 17592186564477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ee07ec-7db5-5819-9326-c35abfd13309" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02c770831bde33820dd4f616df872e22d1a1f9d2de4e49073043cbd4139408e4.png" :db/id #edb/ref 17592186564023} {:answer/id #uuid "a52a1264-daf9-5585-a899-ca4955b26a0c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8fc352405dfa98fc84dc5fc60a41d111139058b7680b9c3b02ee988079b34fef.png" :db/id #edb/ref 17592186564222} {:answer/id #uuid "b2b08043-54bd-579b-a710-49e36d027167" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec1f53deac4b4a4c29daf9ad8205b6283b09f9402ce4df20a46c47e268bcd374.png" :db/id #edb/ref 17592186564248} {:answer/id #uuid "bb553729-44e6-50a1-8fbf-d734ae3b55c8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/20/2058a5e83362c3a2b823169cab5044ea8c3756c6f99ad9f8d26234e9f3b4421d.png" :db/id #edb/ref 17592186564255} {:answer/id #uuid "fae94e29-660b-5543-bab0-87e8d67f1ae2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bb/bbf7c2cd4d8b11cd078f08d7ca31d3e7f40f20db3ee25fbbe95134d051840cc0.png" :db/id #edb/ref 17592186564371}] :answer-field/correct {:answer/id #uuid "a52a1264-daf9-5585-a899-ca4955b26a0c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8fc352405dfa98fc84dc5fc60a41d111139058b7680b9c3b02ee988079b34fef.png" :db/id #edb/ref 17592186564222} :answer-field/id #uuid "d3261e01-b350-524c-a353-a2dfc7e7e037" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564445}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "28327fac-a614-5756-91bd-3fcab54fcda2" :question/math-academy-id "q-158199" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{1}{\\sqrt{x-y}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx-y>0\\,⟹\\,y<x\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,y<x\\}.\n$$\n\nSince the inequality involves the $>$ sign, the line is not part of the domain. Therefore, we draw a dashed line $y=x$ and shade the area *below* the line.\n\nThe resulting domain is as follows:\n\n![](images/77/77a1a03d037ee571fb0dc14ec8370c8b01f521b5a54798117c0b131000676599.png)"}] [{:db/id #edb/ref 17592186564498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3c2367-c89a-5a63-909a-8ab545f01ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,x\\ne 0\\}" :db/id #edb/ref 17592186563987} {:answer/id #uuid "269efb88-268f-56aa-a516-6833ee078794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y>0\\}" :db/id #edb/ref 17592186564025} {:answer/id #uuid "94603c8a-00da-5e0e-8705-b52b7dbbcde4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y>0,\\,x\\ne 0\\}" :db/id #edb/ref 17592186564199} {:answer/id #uuid "d6a12713-af0d-576a-8ce3-2bf1f61336d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186564308} {:answer/id #uuid "fa533f6d-4ad6-5d08-9dfd-22ac37f25112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,x\\ne 0\\}" :db/id #edb/ref 17592186564369}] :answer-field/correct {:answer/id #uuid "94603c8a-00da-5e0e-8705-b52b7dbbcde4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y>0,\\,x\\ne 0\\}" :db/id #edb/ref 17592186564199} :answer-field/id #uuid "e365395e-e193-5723-b80a-2293c4ae62a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564451}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a819c67-d4ea-5946-94af-b50fc8d8ad96" :question/math-academy-id "q-158186" :question/problem "Find the domain of the function $f(x,y)=\\frac{{ln}^{2}⁡y}{{x}^{3}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}y>0 \\\\ {x}^{3}\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}y>0 \\\\ x\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y>0,\\,x\\ne 0\\}.\n$$"}] [{:db/id #edb/ref 17592186564504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3e6ed38-eb22-5a68-b4e4-a818bbc05c8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186564220} {:answer/id #uuid "b121cf1a-7dc7-5909-a04d-7262bf0ba8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y>0,\\,x-y\\ne 1\\}" :db/id #edb/ref 17592186564246} {:answer/id #uuid "c7eee758-44ec-5173-b8d7-7b012b545dcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y>0\\}" :db/id #edb/ref 17592186564281} {:answer/id #uuid "d680f939-d4c5-5d9b-a170-a6f596fd8729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y\\ne 0,1\\}" :db/id #edb/ref 17592186564307} {:answer/id #uuid "e9d25956-37d7-5565-be7f-161a70ab6752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y\\ge 0\\}" :db/id #edb/ref 17592186564341}] :answer-field/correct {:answer/id #uuid "b121cf1a-7dc7-5909-a04d-7262bf0ba8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y>0,\\,x-y\\ne 1\\}" :db/id #edb/ref 17592186564246} :answer-field/id #uuid "421fe0aa-3a0a-5d77-af83-754300b22259" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564390}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a09ec73-a8f5-5e32-98fd-165c3e60bda6" :question/math-academy-id "q-158183" :question/problem "Find the domain of the function $f(x,y)=\\frac{1}{\\operatorname{ln}⁡(x-y)}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}x-y>0 \\\\ \\operatorname{ln}⁡(x-y)\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}x-y>0 \\\\ x-y\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x-y>0,\\,x-y\\ne 1\\}.\n$$"}] [{:db/id #edb/ref 17592186564505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3795c09d-83a0-5e77-8d46-905638f8cd94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}>1\\}" :db/id #edb/ref 17592186564063} {:answer/id #uuid "766255f4-6ead-5147-a37a-dead8da19ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}>0\\}" :db/id #edb/ref 17592186564148} {:answer/id #uuid "afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186564243} {:answer/id #uuid "cedcf912-6c17-5453-a419-96804f0a8e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}=1\\}" :db/id #edb/ref 17592186564293} {:answer/id #uuid "e1a68aca-012d-5c87-957b-411dd32e2492" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}\\ne 1\\}" :db/id #edb/ref 17592186564323}] :answer-field/correct {:answer/id #uuid "e1a68aca-012d-5c87-957b-411dd32e2492" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}\\ne 1\\}" :db/id #edb/ref 17592186564323} :answer-field/id #uuid "90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564420}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/math-academy-id "q-158549" :question/problem "Find the domain of the function $f(x,y)=\\frac{y}{{x}^{2}-1}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}-1\\ne 0\\,⟹\\,{x}^{2}\\ne 1\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}\\ne 1\\}.\n$$"}] [{:db/id #edb/ref 17592186564508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4332d078-c596-5ab9-a9fd-b2600b41dcb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186564083} {:answer/id #uuid "529e6e4c-543b-5b5d-91ba-42883dfabf92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186564102} {:answer/id #uuid "ade04a22-b4eb-505b-8eb9-82420c1e8561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186564234} {:answer/id #uuid "c11088d1-89b4-5f2e-9c65-45b33b86af64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186564266} {:answer/id #uuid "f1a761eb-6b14-555e-ba52-76a27a6e6871" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186564360}] :answer-field/correct {:answer/id #uuid "c11088d1-89b4-5f2e-9c65-45b33b86af64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186564266} :answer-field/id #uuid "378dd559-16b2-53c2-b64a-808e9c526e35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564387}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/math-academy-id "q-158571" :question/problem "Evaluate $z=\\frac{2y-x}{{x}^{3}-{y}^{2}-4}$ at the point $(2,-2).$" :question/worked-solution "To evaluate our multivariable function at the point $(2,-2),$ we substitute $x=2$ and $y=-2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(2,-2)} & =\\frac{2y-x}{{x}^{3}-{y}^{2}-4}\\,{|}_{(2,-2)} \\\\  & =\\frac{2(-2)-2}{{2}^{3}-(-2)^{2}-4} \\\\  & =\\frac{-4-2}{8-4-4} \\\\  & =\\frac{(-6)}{0},\\end{aligned}\n$$\n\nwhich is undefined."}] [{:db/id #edb/ref 17592186564511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ca77a3e-9085-58ef-87e4-a39c3ee58fbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186564188} {:answer/id #uuid "a69cfe99-5dda-5c7f-a8ae-e9e88f862d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186564223} {:answer/id #uuid "c4a63f4b-3cca-51c6-b369-5d4f828546a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186564272} {:answer/id #uuid "dbef1e38-02bf-5cd7-beba-116a24ac4bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186564317} {:answer/id #uuid "e866b3d9-12d2-51c5-a482-af43a7c89490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186564336}] :answer-field/correct {:answer/id #uuid "a69cfe99-5dda-5c7f-a8ae-e9e88f862d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186564223} :answer-field/id #uuid "893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564418}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9c34765f-7311-53ab-be9b-191b42487450" :question/math-academy-id "q-158585" :question/problem "Evaluate $z={2}^{-x}+\\frac{1}{y}$ at the point $(2,2).$" :question/worked-solution "To evaluate our multivariable function at the point $(2,2),$ we substitute $x=2$ and $y=2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(2,2)} & =({2}^{-x}+\\frac{1}{y}){|}_{(2,2)} \\\\  & ={2}^{-2}+\\frac{1}{2} \\\\  & =\\frac{1}{{2}^{2}}+\\frac{1}{2} \\\\  & =\\frac{1}{4}+\\frac{1}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186564512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acdc5a5-82d8-5e8c-8ed0-61de70bd1223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}=0\\}" :db/id #edb/ref 17592186563986} {:answer/id #uuid "0f719873-855b-510a-a974-761504b7537d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+y\\ne 0\\}" :db/id #edb/ref 17592186563991} {:answer/id #uuid "3cd2fadc-384e-56c3-ae50-0d963c2dd45a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0\\}" :db/id #edb/ref 17592186564071} {:answer/id #uuid "76aded1e-0a67-55a3-a895-85e73d77a133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186564149} {:answer/id #uuid "afcfd169-0a6a-5b23-9542-bc1a80e450be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 1\\}" :db/id #edb/ref 17592186564242}] :answer-field/correct {:answer/id #uuid "3cd2fadc-384e-56c3-ae50-0d963c2dd45a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0\\}" :db/id #edb/ref 17592186564071} :answer-field/id #uuid "d0effc05-87d0-589c-bbda-8eebc905e53e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564443}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a1824679-625d-5463-b2f3-fb72a493af82" :question/math-academy-id "q-158554" :question/problem "Find the domain of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}-{y}^{2}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}-{y}^{2}\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0\\}.\n$$"}] [{:db/id #edb/ref 17592186564517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b746c30-aae0-5a72-8f59-c56e220b909e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b1/b18e5383da3d9cd336d8829713127c670449da207ecc9216789747ee55ad3db7.png" :db/id #edb/ref 17592186564037} {:answer/id #uuid "48fd464b-717b-50cf-9914-97377d2a6891" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c1/c165cffbac8308d93d73db8323f2e89e6231f8661c0c010947861be46f0a0040.png" :db/id #edb/ref 17592186564089} {:answer/id #uuid "5d3bfeec-8a70-54e7-b902-621589c010e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5b10601e98e7b8f4aea176c5a0eea21e806c61ecc8bf9e09bc231d36c848494b.png" :db/id #edb/ref 17592186564115} {:answer/id #uuid "873bd759-67ad-5785-b300-e95e0d07fa2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7b/7b7973136f5add18c648db5589bab6e3f3a8f1f2544473274e37f28ab282b5d6.png" :db/id #edb/ref 17592186564178} {:answer/id #uuid "921a2c76-2d53-53a6-a4cc-08b4036be5ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d60f7727323089821783619f48be4d61146e463a5d694f0817276f0e8a0986b1.png" :db/id #edb/ref 17592186564197}] :answer-field/correct {:answer/id #uuid "921a2c76-2d53-53a6-a4cc-08b4036be5ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d60f7727323089821783619f48be4d61146e463a5d694f0817276f0e8a0986b1.png" :db/id #edb/ref 17592186564197} :answe