ht)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 4 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560140} :answer-field/id #uuid "a2b63836-071f-5c49-897a-204153e0c277" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560185}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4afd5c0a-85eb-550b-b4c7-9261bcadb73f" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(- 3 x + 3 y)\\,i+(- x - 4 y)\\,j$ and $C$ is the path $r(t)=(t \\cos{\\left(t \\right)})\\,i+(t \\sin{\\left(t \\right)})\\,j$ for $t\\in [0,\\frac{\\pi}{3}]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t \\cos{\\left(t \\right)},\\,y=t \\sin{\\left(t \\right)}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(- 3 x + 3 y)\\,i+(- x - 4 y)\\,j \\\\  & =(- 3 (t \\cos{\\left(t \\right)}) + 3 (t \\sin{\\left(t \\right)}))\\,i+(- (t \\cos{\\left(t \\right)}) - 4 (t \\sin{\\left(t \\right)}))\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\cos{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\sin{\\left(t \\right)})j \\\\  & =(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((3 t \\sin{\\left(t \\right)} - 3 t \\cos{\\left(t \\right)})\\,i+(- 4 t \\sin{\\left(t \\right)} - t \\cos{\\left(t \\right)})\\,j)\\cdot ((- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j) \\\\  & =(3 t \\sin{\\left(t \\right)} - 3 t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- 4 t \\sin{\\left(t \\right)} - t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =(- 3 t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})+(- 4 t \\sin{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =- 3 t^{2} \\sin^{2}{\\left(t \\right)} - t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - t^{2} \\cos^{2}{\\left(t \\right)} - 4 t \\sin^{2}{\\left(t \\right)} + 2 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 t \\cos^{2}{\\left(t \\right)} \\\\  & =t^{2} \\left(- 3 \\sin^{2}{\\left(t \\right)} - \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 4 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos^{2}{\\left(t \\right)}\\right).\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{\\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{\\pi}{3}}(t^{2} \\left(- 3 \\sin^{2}{\\left(t \\right)} - \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - \\cos^{2}{\\left(t \\right)}\\right) + t \\left(- 4 \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos^{2}{\\left(t \\right)}\\right))\\,dt.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186560171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d10bd8a-7e2d-5f7b-bfe7-2e0ae92a80cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(t e^{2 t} + 4)\\,dt" :db/id #edb/ref 17592186560138} {:answer/id #uuid "700dd878-159e-5841-92ce-18dd055b193b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- 8 \\sqrt{t} - t e^{t})\\,dt" :db/id #edb/ref 17592186560165} {:answer/id #uuid "aff49623-520d-5050-8c10-3f273f7a0cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- t e^{2 t})\\,dt" :db/id #edb/ref 17592186560192} {:answer/id #uuid "e5dda080-6f9e-5996-b6a9-a5b1df511468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(-4)\\,dt" :db/id #edb/ref 17592186560211} {:answer/id #uuid "f85ad87c-05c3-5572-b780-a25b41e3926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- t e^{2 t} - 4)\\,dt" :db/id #edb/ref 17592186560216}] :answer-field/correct {:answer/id #uuid "f85ad87c-05c3-5572-b780-a25b41e3926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}(- t e^{2 t} - 4)\\,dt" :db/id #edb/ref 17592186560216} :answer-field/id #uuid "7533086f-6308-548a-9bbb-fda3d2b21e22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560167}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7890e094-fef5-567c-b6e4-965fdc5b93aa" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(- x y^{2})\\,i+(- 8 y)\\,j$ and $C$ is the path $r(t)=(e^{t})\\,i+(\\sqrt{t})\\,j$ for $t\\in [1,2]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=e^{t},\\,y=\\sqrt{t}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(- x y^{2})\\,i+(- 8 y)\\,j \\\\  & =(- (e^{t}) (\\sqrt{t})^{2})\\,i+(- 8 (\\sqrt{t}))\\,j \\\\  & =(- t e^{t})\\,i+(- 8 \\sqrt{t})\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(e^{t})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sqrt{t})j \\\\  & =(e^{t})\\,i+\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((- t e^{t})\\,i+(- 8 \\sqrt{t})\\,j)\\cdot ((e^{t})\\,i+\\left(\\frac{1}{2 \\sqrt{t}}\\right)\\,j) \\\\  & =(- t e^{t})\\cdot (e^{t})+(- 8 \\sqrt{t})\\cdot \\left(\\frac{1}{2 \\sqrt{t}}\\right) \\\\  & =- t e^{2 t} - 4.\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{1}^{2}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{1}^{2}(- t e^{2 t} - 4)\\,dt.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186560176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "273cd694-c19e-5b18-bfec-cd5c57ed5ff9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(3 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} - 4 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560141} {:answer/id #uuid "5f3569f5-5b13-550e-b642-5dbf5fb3d1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560157} {:answer/id #uuid "911efb5e-f235-5990-a6fc-07cbd8ec0ca4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(4 t \\sin{\\left(t \\right)} - 3 t \\cos{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560179} {:answer/id #uuid "af514606-1011-5fd0-bd9f-45e394507101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(- t^{2} \\sin^{2}{\\left(t \\right)} - t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\cos^{2}{\\left(t \\right)})\\,dt" :db/id #edb/ref 17592186560191} {:answer/id #uuid "c4d8fee3-1213-5bfd-833d-9686d66f6093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(- t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) - t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560201}] :answer-field/correct {:answer/id #uuid "5f3569f5-5b13-550e-b642-5dbf5fb3d1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{2 \\pi}{3}}(t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt" :db/id #edb/ref 17592186560157} :answer-field/id #uuid "1d0434ee-bf15-5472-a32b-f36428ff5196" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560137}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "86e837bb-1b72-587e-9545-9d268702c40b" :question/problem "Which integral is obtained from $$\n\\displaystyle \\int_C F\\cdot\\mathrm{d}r\n$$ given that $F(x,y)=(x + y)\\,i+(- 4 x + 3 y)\\,j$ and $C$ is the path $r(t)=(t \\cos{\\left(t \\right)})\\,i+(t \\sin{\\left(t \\right)})\\,j$ for $t\\in [0,\\frac{2 \\pi}{3}]$? Use the supplied parameterization and limits to compute $F(r(t))\\cdot r'(t)$. Do not evaluate the integral or change variables." :question/worked-solution "We will use the formula\n\n$$\n\\int_C F\\cdot\\mathrm{d}r=\\int_a^b F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t \\cos{\\left(t \\right)},\\,y=t \\sin{\\left(t \\right)}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(x + y)\\,i+(- 4 x + 3 y)\\,j \\\\  & =((t \\cos{\\left(t \\right)}) + (t \\sin{\\left(t \\right)}))\\,i+(- 4 (t \\cos{\\left(t \\right)}) + 3 (t \\sin{\\left(t \\right)}))\\,j.\\end{aligned}\n$$\n\nComputing $r'(t),$ we get \n\n$$\n\\begin{aligned}r^{\\prime}(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\cos{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t \\sin{\\left(t \\right)})j \\\\  & =(- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot r^{\\prime}(t) & =((t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\,i+(3 t \\sin{\\left(t \\right)} - 4 t \\cos{\\left(t \\right)})\\,j)\\cdot ((- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})\\,i+(t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})\\,j) \\\\  & =(t \\sin{\\left(t \\right)} + t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)} - 4 t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =(t \\cos{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(t \\sin{\\left(t \\right)})\\cdot (- t \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)})+(- 4 t \\cos{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)})+(3 t \\sin{\\left(t \\right)})\\cdot (t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}) \\\\  & =- t^{2} \\sin^{2}{\\left(t \\right)} + 2 t^{2} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 t^{2} \\cos^{2}{\\left(t \\right)} + 3 t \\sin^{2}{\\left(t \\right)} - 3 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + t \\cos^{2}{\\left(t \\right)} \\\\  & =t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right).\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}\\int_C F(r)\\cdot\\mathrm{d}r & =\\int_{0}^{\\frac{2 \\pi}{3}}F(r(t))\\cdot r^{\\prime}(t)\\,\\mathrm{d}t \\\\  & =\\int_{0}^{\\frac{2 \\pi}{3}}(t^{2} \\left(- \\sin^{2}{\\left(t \\right)} + 2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 4 \\cos^{2}{\\left(t \\right)}\\right) + t \\left(3 \\sin^{2}{\\left(t \\right)} - 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))\\,dt.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186560177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295d16d2-e3b6-597b-a791-b8fe852304a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}(- 6 t^{10} + 4 t^{9})\\,dt" :db/id #edb/ref 17592