\ q &= -2 \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $q=-2$ and\n\n$$\np=4\n$$\n\n, which can be written as\n\n$$\n\\left(4,-2\\right)\n$$"}] [{:db/id #edb/ref 17592186505044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c604f56b-d302-58fb-a478-e6f140d1b44c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = -\\dfrac{19}{2}, q = \\dfrac{13}{2}" :db/id #edb/ref 17592186505069} {:answer/id #uuid "da8467be-0482-564f-b5d2-bfa6c1d51cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = -28, q = -25" :db/id #edb/ref 17592186505077} {:answer/id #uuid "dc3fef8b-68b3-5b51-aacc-bac81739ded6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = -8, q = 5" :db/id #edb/ref 17592186505078} {:answer/id #uuid "eae0b3dd-9a86-5ad5-b884-59fe84fe608a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = 47, q = -50" :db/id #edb/ref 17592186505082} {:answer/id #uuid "f1650eb8-3447-5c6d-a2aa-b63c52cf1523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = 5, q = -8" :db/id #edb/ref 17592186505086}] :answer-field/correct {:answer/id #uuid "dc3fef8b-68b3-5b51-aacc-bac81739ded6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = -8, q = 5" :db/id #edb/ref 17592186505078} :answer-field/id #uuid "0f45a298-4422-5551-8d83-c2422dc2c4cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505008}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81d33e45-12e7-5f43-864d-1ce259421c85" :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}6p - 4q + 68 &=0 \\\\ 4p + 4q + 12 &=0\\end{aligned}\\right.\n$$" :question/worked-solution "Sometimes, it's handy to assign a number to each equation in a system, so that we can refer to them more easily:\n\n$$\n\\left\\{\\begin{aligned}6p - 4q + 68 &=0 && (1) \\\\ 4p + 4q + 12 &=0 && (2)\\end{aligned}\\right.\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $\\color{blue}(2)$, we can solve for $p$ as follows:\n\n$$\n\\begin{aligned} 4p + 4q + 12 &= 0 \\\\ 4p + 4q &= -12 \\\\ 4p &= -12 - 4q \\\\ p &= \\dfrac{-12 - 4q}{4} \\\\ p &= -3 - q \\end{aligned}\n$$\n\nThen, we substitute $p=-3-q$ into equation $\\color{red}(1)$ and solve for $q$:\n\n$$\n\\begin{aligned} 6p - 4q + 68 &= 0 \\\\ 6(-3 - q) - 4q + 68 &= 0 \\\\ -18 - 6q - 4q + 68 &= 0 \\\\ 50 - 10q &= 0 \\\\ -10q &= -50 \\\\ q &= 5 \\end{aligned}\n$$\n\nIf we now substitute\n\n$$\nq=5\n$$\n\ninto equation $\\color{red}(1)$, then we can find the value of $p$:\n\n$$\n\\begin{aligned} 6p - 4q + 68 &= 0 \\\\ 6p - 4\\left(5\\right) + 68 &= 0 \\\\ 6p - 20 + 68 &= 0 \\\\ 6p + 48 &= 0 \\\\ 6p &= -48 \\\\ p &= -8 \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=-8$ and\n\n$$\nq=5\n$$\n\n, which can be written as\n\n$$\n\\left(-8,5\\right)\n$$"}] [{:db/id #edb/ref 17592186505050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1603d82b-c052-55fd-9a55-a364ff5e2cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\dfrac{13}{3}, y = -\\dfrac{7}{3}" :db/id #edb/ref 17592186505010} {:answer/id #uuid "1e963105-b7e6-5546-8c58-b81dea275cfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 5, y = -3" :db/id #edb/ref 17592186505015} {:answer/id #uuid "a3d4ad7d-f15c-5de6-af54-c7b851da7a3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\dfrac{13}{7}, y = \\dfrac{27}{7}" :db/id #edb/ref 17592186505055} {:answer/id #uuid "eb4cd44a-762e-558f-bf0a-b46105f41178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 13, y = -11" :db/id #edb/ref 17592186505083} {:answer/id #uuid "ef570589-6178-5d0b-a363-96472e39717a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = -\\dfrac{7}{3}, y = \\dfrac{13}{3}" :db/id #edb/ref 17592186505085}] :answer-field/correct {:answer/id #uuid "1603d82b-c052-55fd-9a55-a364ff5e2cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\dfrac{13}{3}, y = -\\dfrac{7}{3}" :db/id #edb/ref 17592186505010} :answer-field/id #uuid "8d8dbb77-04a8-5b1a-a763-3af48c384109" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505047}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "94502529-f765-562b-a0a6-063708d3571d" :question/problem "Using the method of substitution, find the solution of\n\n$$\n\\left\\{\\begin{aligned}5x + 2y &=17 \\\\ 3x + 3y &=6\\end{aligned}\\right.\n$$" :question/worked-solution "Sometimes, it's handy to assign a number to each equation in a system, so that we can refer to them more easily:\n\n$$\n\\left\\{\\begin{aligned}5x + 2y - 17 &=0 && (1) \\\\ 3x + 3y - 6 &=0 && (2)\\end{aligned}\\right.\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $\\color{blue}(2)$, we can solve for $y$ as follows:\n\n$$\n\\begin{aligned} 3y + 3x - 6 &= 0 \\\\ 3y + 3x &= 6 \\\\ 3y &= 6 - 3x \\\\ y &= \\dfrac{6 - 3x}{3} \\\\ y &= 2 - x \\end{aligned}\n$$\n\nThen, we substitute $y=2-x$ into equation $\\color{red}(1)$ and solve for $x$:\n\n$$\n\\begin{aligned} 2y + 5x - 17 &= 0 \\\\ 2(2 - x) + 5x - 17 &= 0 \\\\ 4 - 2x + 5x - 17 &= 0 \\\\ -13 + 3x &= 0 \\\\ 3x &= 13 \\\\ x &= \\dfrac{13}{3} \\end{aligned}\n$$\n\nIf we now substitute\n\n$$\nx=\\dfrac{13}{3}\n$$\n\ninto equation $\\color{red}(1)$, then we can find the value of $y$:\n\n$$\n\\begin{aligned} 2y + 5x - 17 &= 0 \\\\ 2y + 5\\left(\\dfrac{13}{3}\\right) - 17 &= 0 \\\\ 2y + \\dfrac{65}{3} - 17 &= 0 \\\\ 2y + \\dfrac{14}{3} &= 0 \\\\ 2y &= -\\dfrac{14}{3} \\\\ y &= -\\dfrac{7}{3} \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $y=-\\dfrac{7}{3}$ and\n\n$$\nx=\\dfrac{13}{3}\n$$\n\n, which can be written as\n\n$$\n\\left(\\dfrac{13}{3},-\\dfrac{7}{3}\\right)\n$$"}] [{:db/id #edb/ref 17592186505053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f359dcf-82e1-573f-b829-c73044894a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = 61, q = -32" :db/id #edb/ref 17592186505007} {:answer/id #uuid "4324f3ee-42a2-5b81-af28-c33a37b544cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = 1, q = -2" :db/id #edb/ref 17592186505019} {:answer/id #uuid "c8880a82-ecf0-5fd0-98a4-687161107483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = -2, q = 1" :db/id #edb/ref 17592186505070} {:answer/id #uuid "f51c7ec6-517a-52a1-9d66-f23ef39a1baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = -\\dfrac{13}{8}, q = -\\dfrac{11}{16}" :db/id #edb/ref 17592186505089} {:answer/id #uuid "f6387b29-e54c-5f2f-b499-866421947cd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = 5, q = 4" :db/id #edb/ref 17592186505090}] :answer-field/correct {:answer/id #uuid "4324f3ee-42a2-5b81-af28-c33a37b544cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p = 1, q = -2" :db/id #edb/ref 17592186505019} :answer-field/id #uuid "495cde91-9097-5016-a4b7-f83c157183cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505022}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a20b2f41-8f60-5daf-a6d6-584b1826ccc0" :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-6p + 4q + 14 &=0 \\\\ 2p + 4q + 6 &=0\\end{aligned}\\right.\n$$" :question/worked-solution "Sometimes, it's handy to assign a number to each equation in a system, so that we can refer to them more easily:\n\n$$\n\\left\\{\\begin{aligned}-6p + 4q + 14 &=0 && (1) \\\\ 2p + 4q + 6 &=0 && (2)\\end{aligned}\\right.\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $\\color{blue}(2)$, we can solve for $p$ as follows:\n\n$$\n\\begin{aligned} 2p + 4q + 6 &= 0 \\\\ 2p + 4q &= -6 \\\\ 2p &= -6 - 4q \\\\ p &= \\dfrac{-6 - 4q}{2} \\\\ p &= -3 - 2q \\end{aligned}\n$$\n\nThen, we substitute $p=-3-2q$ into equation $\\color{red}(1)$ and solve for $q$:\n\n$$\n\\begin{aligned} -6p + 4q + 14 &= 0 \\\\ -6(-3 - 2q) + 4q + 14 &= 0 \\\\ 18 + 12q + 4q + 14 &= 0 \\\\ 32 + 16q &= 0 \\\\ 16q &= -32 \\\\ q &= -2 \\end{aligned}\n$$\n\nIf we now substitute\n\n$$\nq=-2\n$$\n\ninto equation $\\color{red}(1)$, then we can find the value of $p$:\n\n$$\n\\begin{aligned} -6p + 4q + 14 &= 0 \\\\ -6p + 4\\left(-2\\right) + 14 &= 0 \\\\ -6p - 8 + 14 &= 0 \\\\ -6p + 6 &= 0 \\\\ -6p &= -6 \\\\ p &= 1 \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=1$ and\n\n$$\nq=-2\n$$\n\n, which can be written as\n\n$$\n\\left(1,-2\\right)\n$$"}] [{:db/id #edb/ref 17592186505059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "183f9a92-7d85-53ba-bb28-1b66842b5e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186505011} {:answer/id #uuid "621871e5-d472-56df-b867-bc30be73a084" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-38" :db/id #edb/ref 17592186505032} {:answer/id #uuid "7639d21a-e892-5043-9cbc-a4fb6a9ca3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186505040} {:answer/id #uuid "a3410dfa-f1bf-5787-ac89-c05bbe4fd261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186505054} {:answer/id #uuid "aecd726c-29f3-5f8c-8f56-bc34d79630a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186505058}] :answer-field/correct {:answer/id #uuid "a3410dfa-f1bf-5787-ac89-c05bbe4fd261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186505054} :answer-field/id #uuid "c2ae802f-7984-5f66-a194-5b364b61a802" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505066}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b1972fab-2da0-5ed8-b4bc-94b1335dd7b8" :question/problem "Given the system of equations below, what is the value of $p - q$?\n\n$$\n\\left\\{\\begin{aligned}2q + 16 &=0 \\\\ 2p + 4q + 28 &=0\\end{aligned}\\right.\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $\\color{red}(1)$, we can solve for $q$ as follows:\n\n$$\n\\begin{aligned} 2q + 16 &= 0 \\\\ 2q &= -16 \\\\ q &= -8 \\end{aligned}\n$$\n\nThen, we substitute $q=-8$ into equation $\\color{blue}(2)$ and solve for $p$:\n\n$$\n\\begin{aligned} 2p + 4q + 28 &= 0 \\\\ 2p + 4\\left(-8\\right) + 28 &= 0 \\\\ 2p - 32 + 28 &= 0 \\\\ 2p &= 4 \\\\ p &= 2 \\end{aligned}\n$$\n\nTherefore, $p - q = 2 - \\left(-8\\right) = 10$."}] [{:db/id #edb/ref 17592186505062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95af81eb-d92c-51f4-b179-301af6b7074e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u = \\dfrac{11}{2}, v = -\\dfrac{3}{4}" :db/id #edb/ref 17592186505051} 