592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186709282}] :answer-field/correct {:answer/id #uuid "9c78107b-c73b-5623-8aeb-99e3e01d0d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186709272} :answer-field/id #uuid "decc3a58-6739-5da3-880f-807dacd454e3" :answer-field/key "$\\oint_C\\mathbf F\\cdot\\mathrm d\\mathbf r\\ne0$ for some closed path $C$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186709288} {:answer-field/choices [{:answer/id #uuid "0b5dc49f-717e-55e8-8522-144ac9e43786" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186709232} {:answer/id #uuid "63bfc4a2-dffe-5e27-b7e1-e3bb0b5a16c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186709252}] :answer-field/correct {:answer/id #uuid "0b5dc49f-717e-55e8-8522-144ac9e43786" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186709232} :answer-field/id #uuid "fea65a01-d3f0-54fd-b676-1b31745223a6" :answer-field/key "$\\int_C\\mathbf F\\cdot\\mathrm d\\mathbf r\\ne0$ for some open path $C$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186709295}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "691dbf6d-340b-5ce7-a0b1-87eeeb32c3d1" :question/problem "Consider the vector field\n\n$$\n\\mathbf F(x,y)=\\left(- x e^{y} - 3\\right)\\mathbf i+\\left(- \\frac{x^{2} e^{y}}{2} + y\\right)\\mathbf j\n$$\n\non $\\mathbb R^2$. Which statements are true? Select all that apply. All paths mentioned are piecewise smooth and lie in $\\mathbb R^2$." :question/worked-solution "Write $P=- x e^{y} - 3$ and $Q=- \\frac{x^{2} e^{y}}{2} + y$. The cross partials are\n\n$$\n\\begin{aligned}P_y&=- x e^{y}\\\\Q_x&=- x e^{y}.\\end{aligned}\n$$\n\nThey agree everywhere. The components have continuous partial derivatives on the simply connected domain $\\mathbb R^2$, so $\\mathbf F$ is conservative. For a conservative field with potential $f$, the fundamental theorem gives\n\n$$\n\\int_C\\mathbf F\\cdot\\mathrm d\\mathbf r=f(B)-f(A).\n$$\n\nFor such a conservative field, a closed path has the same endpoints, so its circulation is zero in either orientation. An open path can also have zero work when its endpoint potential values agree; zero work is not guaranteed for every open path. For example, the work along the segment from $(0, 0)$ to $(1, 0)$ is $- \\frac{7}{2}$, which is nonzero. A path followed by its reverse always has zero total work, so a claim of nonzero work for every closed path is false.\n\n- $\\oint_C\\mathbf F\\cdot\\mathrm d\\mathbf r\\ne0$ for some closed path $C$. This is **false**.\n- $\\mathbf F$ is **not** conservative. This is **false**.\n- $\\int_C\\mathbf F\\cdot\\mathrm d\\mathbf r\\ne0$ for some open path $C$. This is **true**.\n- None of the above This is **false**."}] [{:db/id #edb/ref 17592186709259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3026b59a-0a22-5058-ad13-1079cd6eef97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186709239} {:answer/id #uuid "93a7d07d-3134-59d3-b2d9-8bbc8d8b5882" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186709270}] :answer-field/correct {:answer/id #uuid "93a7d07d-3134-59d3-b2d9-8bbc8d8b5882" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186709270} :answer-field/id #uuid "214fece2-f64b-5952-b67b-8ef59f1a4766" :answer-field/key "$\\int_C\\mathbf F\\cdot\\mathrm d\\mathbf r\\ne0$ for some open path $C$." :answer-field/type {:db/id #edb/ref 1759218