{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=0\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂f}{∂y} & =0.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂r} & =(2r\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta +0\\,(\\operatorname{sin}⁡\\theta ) \\\\  & =2r{cos}^{2}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255b1439-4503-5ba1-9467-b4cbf23cf837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358086} {:answer/id #uuid "2826740b-006a-5fb8-af1b-b04cb4e430c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(1-{sin}^{2}⁡\\theta )" :db/id #edb/ref 17592186358112} {:answer/id #uuid "8f20dc0c-2f9c-59cb-9371-1e2bab94de58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186358999} {:answer/id #uuid "c17a4d57-ab7f-5cad-9c18-15918d10a4db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359449} {:answer/id #uuid "ff52e99a-a36a-570b-927e-6775bb16f2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186359997}] :answer-field/correct {:answer/id #uuid "ff52e99a-a36a-570b-927e-6775bb16f2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186359997} :answer-field/id #uuid "d14ca8c8-8191-546e-952e-035f83d5d2de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360352}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a5ea0e8-c2a8-56bd-bc0a-1183f811a786" :question/math-academy-id "q-95113" :question/problem "Given that $g(x,y)={y}^{2},$ find $\\frac{∂g}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta } & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂g}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂g}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=0,\\,\\frac{∂g}{∂y}=2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂y} & =0, \\\\ \\frac{∂g}{∂y} & =2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta } & =0\\,(-r\\operatorname{sin}⁡\\theta )+(2r\\operatorname{sin}⁡\\theta )\\,r\\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fe46cca-410f-5c55-88ef-8d80e7031ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186358726} {:answer/id #uuid "ba7b642c-5011-5fe6-b8b3-8ba15e13f44b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186359374} {:answer/id #uuid "bfc682ef-5b2d-5c3c-8130-e2f1ce1ee474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186359430} {:answer/id #uuid "e32325f6-ab86-53be-a9ca-0e5883831318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359761} {:answer/id #uuid "fb9162b2-a7fc-5e49-88a2-4b87f9188d83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186359975}] :answer-field/correct {:answer/id #uuid "bfc682ef-5b2d-5c3c-8130-e2f1ce1ee474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186359430} :answer-field/id #uuid "5ebf0a96-067c-5319-889e-a652fa3fcdea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360139}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "09b6c584-862f-5f2c-8d59-a960b719bfdf" :question/math-academy-id "q-95116" :question/problem "Given that $$\n\\displaystyle w(x,y)=\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{2},\n$$ find $\\frac{∂w}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta } & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂w}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂w}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=x,\\,\\frac{∂w}{∂y}=y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂y} & =r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂w}{∂y} & =r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta } & =-(r\\operatorname{cos}⁡\\theta )\\,r\\operatorname{sin}⁡\\theta +(r\\operatorname{sin}⁡\\theta )\\,r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd315d7-b1d5-551a-af37-e14e882123b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta +2r\\operatorname{cos}⁡2\\theta " :db/id #edb/ref 17592186358153} {:answer/id #uuid "421e4508-c098-51e8-90e8-98bf10fa5694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2r}\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358313} {:answer/id #uuid "7d38dabb-3b90-5940-a75d-8510ce424b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358842} {:answer/id #uuid "d1e4c0a7-a55b-5eab-8f76-5e79031a6d80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta -\\frac{1}{2r}\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186359587} {:answer/id #uuid "d2dd87cb-765e-56e5-b2a7-b887923ea35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡\\theta +\\frac{1}{r}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359597}] :answer-field/correct {:answer/id #uuid "d1e4c0a7-a55b-5eab-8f76-5e79031a6d80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta -\\frac{1}{2r}\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186359587} :answer-field/id #uuid "9d594cdf-96e3-59ea-b073-9e09cf2903a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360268}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "089e9487-84e2-5cf6-99a6-f3b1375b3cef" :question/math-academy-id "q-95129" :question/problem "Given that $h(r,\\theta )=2r+\\operatorname{sin}⁡\\theta ,$ find $\\frac{∂h}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂h}{∂x}=\\frac{∂h}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂h}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r}=2,\\,\\frac{∂h}{∂\\theta }=\\operatorname{cos}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =(2)\\operatorname{cos}⁡\\theta -\\frac{1}{r}(\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta -\\frac{1}{2r}\\operatorname{sin}⁡2\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5558a820-fe68-5154-b605-abf1888ca002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡3\\theta +2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡3\\theta )" :db/id #edb/ref 17592186358495} {:answer/id #uuid "6ccd388d-c735-55eb-b378-f7d1e760c7ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(2\\operatorname{sin}⁡\\theta -3\\operatorname{cos}⁡\\theta )" :db/id #edb/ref 17592186358704} {:answer/id #uuid "7e7beea8-2165-59f1-b2bd-041b16b78155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡3\\theta -3\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡3\\theta " :db/id #edb/ref 17592186358854} {:answer/id #uuid "aeb8186e-5270-5422-93d1-cdc25d726dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡3\\theta -\\operatorname{sin}⁡3\\theta " :db/id #edb/ref 17592186359269} {:answer/id #uuid "dbba7a33-6727-5aa3-8d25-973cb0049ead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡3\\theta -3\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡3\\theta )" :db/id #edb/ref 17592186359678}] :answer-field/correct {:answer/id #uuid "dbba7a33-6727-5aa3-8d25-973cb0049ead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡3\\theta -3\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡3\\theta )" :db/id #edb/ref 17592186359678} :answer-field/id #uuid "cf0ec5fc-3755-5a5d-a8d1-a936b1188676" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360350}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d4ca4975-1827-563d-9fb6-1ff2551b2f31" :question/math-academy-id "q-95130" :question/problem "Given that $g(r,\\theta )={r}^{2}\\operatorname{cos}⁡3\\theta ,$ find $\\frac{∂g}{∂y},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂g}{∂y}=\\frac{∂g}{∂r}\\operatorname{sin}⁡\\theta +\\frac{1}{r}\\frac{∂g}{∂\\theta }\\operatorname{cos}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂r}=2r\\operatorname{cos}⁡3\\theta ,\\,\\frac{∂g}{∂\\theta }=-3{r}^{2}\\operatorname{sin}⁡3\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂y} & =(2r\\operatorname{cos}⁡3\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(-3{r}^{2}\\operatorname{sin}⁡3\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =r(2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡3\\theta -3\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡3\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52cf3c7c-f856-5e1a-893d-423bede6de59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186358463} {:answer/id #uuid "8d6451f3-ba0d-5b74-abb5-e944654eaa92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186358982} {:answer/id #uuid "a99fe949-6ed3-526e-8127-1b1ec443989e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186359214} {:answer/id #uuid "d2cb342c-cb70-5a1b-b38b-8f594ea8d85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sin}^{3}⁡\\theta " :db/id #edb/ref 17592186359595} {:answer/id #uuid "d540cc2e-6105-5828-a5a3-41026567f180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{cos}^{3}⁡\\theta " :db/id #edb/ref 17592186359618}] :answer-field/correct {:answer/id #uuid "d2cb342