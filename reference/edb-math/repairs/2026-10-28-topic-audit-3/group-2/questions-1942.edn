a \\right)} \\cos{\\left(\\theta \\right)} + 6 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526195} :answer-field/id #uuid "9dd9e72c-be44-595b-952d-4e4727b9d32d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526199}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8479fa83-fbbd-5793-b8d0-0b7149751139" :question/problem "Given that $f(x,y)=- 2 x^{2} y + 3 x y^{2},$ find $\\frac{∂f}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =\\left(\\frac{∂f}{∂x}\\right)(- r \\sin{\\left(\\theta \\right)})+\\left(\\frac{∂f}{∂y}\\right)(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=- 4 x y + 3 y^{2},\\,\\frac{∂f}{∂y}=- 2 x^{2} + 6 x y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂f}{∂y} & =6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{2} \\cos^{2}{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta} & =(3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})(- r \\sin{\\left(\\theta \\right)})+(6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{2} \\cos^{2}{\\left(\\theta \\right)})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(- 3 r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})+(6 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}) \\\\  & =- 3 r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 6 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c4b70f1-a2a9-50cf-83a8-2af7e51db9b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526165} {:answer/id #uuid "25451830-b3c4-5ed7-907b-8021140d7082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{2} \\sin^{2}{\\left(\\theta \\right)} - 8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526168} {:answer/id #uuid "80d2b349-1aa9-5707-a1f3-27d64fedfcb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- r^{2} \\sin^{2}{\\left(\\theta \\right)} + 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526189} {:answer/id #uuid "88268ae5-df7c-5cd6-b910-e71adbf29cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526191} {:answer/id #uuid "ce5b502e-7cdc-57c8-818e-2a9249e80994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526214}] :answer-field/correct {:answer/id #uuid "ce5b502e-7cdc-57c8-818e-2a9249e80994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526214} :answer-field/id #uuid "cea47898-ec2b-520f-a44f-e17d98f48686" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526215}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8945f7df-fee5-566f-aa38-1a5d974cb343" :question/problem "Given that $w(x,y)=4 x^{2} - x y - 3 y^{2},$ find $\\frac{∂w}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta} & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =\\left(\\frac{∂w}{∂x}\\right)(- r \\sin{\\left(\\theta \\right)})+\\left(\\frac{∂w}{∂y}\\right)(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=8 x - y,\\,\\frac{∂w}{∂y}=- x - 6 y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & =- r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂w}{∂y} & =- 6 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta} & =(- r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)})(- r \\sin{\\left(\\theta \\right)})+(- 6 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(r^{2} \\sin^{2}{\\left(\\theta \\right)} - 8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})+(- 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}) \\\\  & =r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "282f6b6d-7109-520e-aba8-fa9ab8b0a7a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526170} {:answer/id #uuid "3391d5eb-68ff-5f47-8cb4-841e008f9b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526173} {:answer/id #uuid "a4d504c1-fe78-5a56-8d10-4e6193ffaa1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db