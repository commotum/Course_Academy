c-58ee-afb5-38bc8bb1ed51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡2\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186357819} {:answer/id #uuid "2228fe89-b437-5a7a-aa61-67383a3bc1cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358049} {:answer/id #uuid "2486a9ac-6c70-5c04-9668-5c8f9093b469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186358077} {:answer/id #uuid "c28adbb2-a46a-5fcd-bc0c-7c33f8291c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta (\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta )" :db/id #edb/ref 17592186359459} {:answer/id #uuid "cc4bc83b-09f3-5b22-b701-0b449bf034fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡2\\theta (\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta )" :db/id #edb/ref 17592186359545}] :answer-field/correct {:answer/id #uuid "2228fe89-b437-5a7a-aa61-67383a3bc1cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358049} :answer-field/id #uuid "4b690a60-fc65-5545-974d-063013346d86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360113}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0702360a-d22f-5e34-a49e-3610cfb8aefb" :question/math-academy-id "q-95133" :question/problem "Given that $w(r,\\theta )=r\\operatorname{cos}⁡2\\theta ,$ find $\\frac{∂w}{∂y},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂w}{∂y}=\\frac{∂w}{∂r}\\operatorname{sin}⁡\\theta +\\frac{1}{r}\\frac{∂w}{∂\\theta }\\operatorname{cos}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r}=\\operatorname{cos}⁡2\\theta ,\\,\\frac{∂w}{∂\\theta }=-2r\\operatorname{sin}⁡2\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂y} & =(\\operatorname{cos}⁡2\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(-2r\\operatorname{sin}⁡2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12192e9d-666e-5c58-ae9b-549a795d8bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z\\operatorname{cos}⁡2\\theta +\\frac{1}{2}{sin}^{2}⁡\\theta )" :db/id #edb/ref 17592186357907} {:answer/id #uuid "2313e01f-d71c-5200-a515-ee826a71b2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}(z{cos}^{2}⁡\\theta +\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186358058} {:answer/id #uuid "3838a62b-71f1-5444-8110-29c7f4dcb528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358248} {:answer/id #uuid "6d65b027-234d-52ec-b21e-4cda093023c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta +{r}^{2}z\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358706} {:answer/id #uuid "a2650aa0-1dde-559a-991a-ef66b1ee74bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186359169}] :answer-field/correct {:answer/id #uuid "a2650aa0-1dde-559a-991a-ef66b1ee74bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186359169} :answer-field/id #uuid "41d8dcd8-411e-5bef-bfda-8f715f466b64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360090}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2f89a4f6-9145-5fdf-84a8-9fcaed162c54" :question/math-academy-id "q-95171" :question/problem "Given that $u(x,y,z)={x}^{2}{z}^{2}+{x}^{2}{y}^{2}+xyz,$ find $\\frac{∂u}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $u(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z} & =\\frac{∂u}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂u}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂u}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂u}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $u$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z}=2{x}^{2}z+xy\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z} & =2{r}^{2}z{cos}^{2}⁡\\theta +{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & ={r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010406ea-8191-5e47-ac06-dceff2ff745b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡\\theta +z\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186357766} {:answer/id #uuid "282feee2-ff23-53af-9799-8744c554abd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\operatorname{cos}⁡2\\theta +2r{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186358113} {:answer/id #uuid "49f1c912-9ed3-5d04-8e7b-747744cb437f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "rz\\operatorname{sin}⁡\\theta +2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186358385} {:answer/id #uuid "6830d01d-5239-5816-9b25-ca0834b037fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z{cos}^{2}⁡\\theta +2r\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358665} {:answer/id #uuid "a16444c4-1302-5cfc-815a-cb0ecda9bea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z{sin}^{2}⁡\\theta +2r{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186359158}] :answer-field/correct {:answer/id #uuid "49f1c912-9ed3-5d04-8e7b-747744cb437f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "rz\\operatorname{sin}⁡\\theta +2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186358385} :answer-field/id #uuid "fbaff869-51ca-5842-bcc1-9882b7c10798" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360444}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1af069b9-f8b0-59a0-a5fc-f493e760396c" :question/math-academy-id "q-95172" :question/problem "Given that $v(x,y,z)=2y-xz,$ find $\\frac{∂v}{∂\\theta },$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $v(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂v}{∂\\theta } & =\\frac{∂v}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂v}{∂y}\\cdot \\frac{∂v}{∂\\theta }+\\frac{∂v}{∂z}\\cdot \\frac{∂z}{∂\\theta } \\\\  & =-\\frac{∂v}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂v}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $v$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂v}{∂x}=-z,\\,\\frac{∂v}{∂y}=2\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂x} & =-z, \\\\ \\frac{∂v}{∂y} & =2.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂\\theta } & =-(-z)r\\operatorname{sin}⁡\\theta +(2)r\\operatorname{cos}⁡\\theta  \\\\  & =rz\\operatorname{sin}⁡\\theta +2r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129511e1-8153-5e51-95ae-9c26ed91e829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z" :db/id #edb/ref 17592186357911} {:answer/id #uuid "22e04b8b-94b1-5f23-a25d-237f08e39a4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z+{r}^{2}{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358054} {:answer/id #uuid "8a775666-2516-5e21-bf4d-75577316d96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358958} {:answer/id #uuid "b5f0ea0f-66cb-5c73-84ba-025ec83912b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z+{r}^{2}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359332} {:answer/id #uuid "d256b0d6-11fb-52fc-a283-8f751fba045a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359590}] :answer-field/correct {:answer/id #uuid "8a775666-2516-5e21-bf4d-75577316d96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358958} :answer-field/id #uuid "57e7c9e5-29e9-5ecf-8487-914454d5c63c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360130}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e7a6bf9a-03da-5b3f-8e6f-6e42220c784c" :question/math-academy-id "q-95174" :question/problem "Given that $h(x,y,z)=2{x}^{2}+{y}^{2}+4{x}^{2}{z}^{2},$ find $\\frac{∂h}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂h}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂h}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z}=8{x}^{2}z\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z} & =8{r}^{2}z{cos}^{2}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41de3643-e918-53d1-8cb0-5b8e949652ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r({sin}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta )" :db/id #edb/ref 17592186367923} {:answer/id #uuid "92a45346-b02e-5a67-a6a4-d289bad3bacb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}z{sin}^{2}⁡\\theta +r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186367924} {:answer/id #uuid "899dd257-9509-5c24-b797-073d1ba2f7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2z+{r}^{2}{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186367925} {:answer/id #uuid "0e78e572-1929-583c-ac2f-64dd21622fd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}z{cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186367926} {:answer/id #uuid "28a698cf-cd11-5929-8167-bd140fb45ce8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186367927}] :answer-field/correct {:answer/id #uuid "92a45346-b02e-5a67-a6a4-d289bad3bacb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}z{sin}^{2}⁡\\theta +r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186367924} :answer-field/id #uuid "c15c034d-fc01-5c57-ac70-f9660ec41f88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367922}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "958d3cd5-a585-5cf1-a4ae-62a7c65fe9ab" :question/math-academy-id "q-165284" :question/problem "Given that $f(x,y,z)={y}^{2}{z}^{2}+xz,$ find $\\frac{∂f}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂f}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}=2{y}^{2}z+x\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =2{r}^{2}z{sin}^{2}⁡\\theta +r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186368878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "812a2a72-c787-5aec-b20b-53b5609d7060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡4\\theta +4\\operatorname{cos}⁡4\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368880} {:answer/id #uuid "57701b6b-149a-570c-8820-a5a4899a9926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡4\\theta +4\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368881} {:answer/id #uuid "7956c7d2-5ce8-5570-912d-71126718b86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡4\\theta +4\\operatorname{cos}⁡4\\theta " :db/id #edb/ref 17592186368882} {:answer/id #uuid "4f6f8124-2427-51e4-b3d5-8a7f5cc0bfee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +4\\operatorname{cos}⁡4\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368883} {:answer/id #uuid "29dabe43-58c4-5883-9567-12a537018918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡4\\theta +4\\operatorname{cos}⁡4\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368884}] :answer-field/correct {:answer/id #uuid "29dabe43-58c4-5883-9567-12a537018918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡4\\theta +4\\operatorname{cos}⁡4\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368884} :answer-field/id #uuid "63ac7f03-12c3-54a9-b69c-fc2e73fe5c37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368879}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6f35556-89a1-5c4e-ad2e-ad3a5182772a" :question/math-academy-id "q-95020" :question/problem "Given that $u(r,\\theta )=r\\operatorname{sin}⁡4\\theta ,$ find $\\frac{∂u}{∂y},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂u}{∂y}=\\frac{∂u}{∂r}\\operatorname{sin}⁡\\theta +\\frac{1}{r}\\frac{∂u}{∂\\theta }\\operatorname{cos}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $u$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂u}{∂r}=\\operatorname{sin}⁡4\\theta ,\\,\\frac{∂u}{∂\\theta }=4r\\operatorname{cos}⁡4\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂y} & =(\\operatorname{sin}⁡4\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(4r\\operatorname{cos}⁡4\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡4\\theta +4\\operatorname{cos}⁡4\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186368885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60efe842-a152-5a8d-94b4-e0b50381d44a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368887} {:answer/id #uuid "c5c358c5-25b8-5374-9d9d-f36d756d1533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368888} {:answer/id #uuid "a2ab60a0-c20b-514b-93f7-be5b89a2ed07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡\\theta -\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186368889} {:answer/id #uuid "4f084c23-67fc-5831-a5d3-607d0f3f2651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186368890} {:answer/id #uuid "c7fe4eeb-f778-583c-9aed-a3ec394140b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186368891}] :answer-field/correct {:answer/id #uuid "c5c358c5-25b8-5374-9d9d-f36d756d1533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368888} :answer-field/id #uuid "208a9196-43b6-5acc-b9b2-19dc5589219d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368886}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d4815c77-06a6-5342-87f5-965d49f4d616" :question/math-academy-id "q-95134" :question/problem "Given that $u(r,\\theta )=r(2+\\operatorname{sin}⁡\\theta ),$ find $\\frac{∂u}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂u}{∂x}=\\frac{∂u}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂u}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $u$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂u}{∂r}=2+\\operatorname{sin}⁡\\theta ,\\,\\frac{∂u}{∂\\theta }=r\\operatorname{cos}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =(2+\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta -\\frac{1}{r}(r\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186368892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7772675-d258-5d51-b29d-b3396a5e5001" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{r}^{2}({z}^{2}{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )" :db/id #edb/ref 17592186368894} {:answer/id #uuid "2c7da375-0431-5f66-8543-0491e4f293c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{r}^{2}{z}^{2}(\\operatorname{cos}⁡3\\theta +\\operatorname{sin}⁡3\\theta )" :db/id #edb/ref 17592186368895} {:answer/id #uuid "43eedeea-a30d-5b9a-ba7b-6945237b5a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}{cos}^{3}⁡\\theta +{sin}^{3}⁡\\theta " :db/id #edb/ref 17592186368896} {:answer/id #uuid "b844a28f-f811-5210-9c5f-949a6a5243b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z({z}^{3}{cos}^{3}⁡\\theta +z{sin}^{3}⁡\\theta )" :db/id #edb/ref 17592186368897} {:answer/id #uuid "eab23144-3264-5367-8737-fc9bde1fca89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{r}^{2}{z}^{2}({z}^{2}{cos}^{3}⁡\\theta +{sin}^{3}⁡\\theta )" :db/id #edb/ref 17592186368898}] :answer-field/correct {:answer/id #uuid "eab23144-3264-5367-8737-fc9bde1fca89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{r}^{2}{z}^{2}({z}^{2}{cos}^{3}⁡\\theta +{sin}^{3}⁡\\theta )" :db/id #edb/ref 17592186368898} :answer-field/id #uuid "20825cbb-d704-5a1b-b17b-e68c8b914c7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368893}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "008135f6-6225-50a5-8c82-16fdb8564c98" :question/math-academy-id "q-95173" :question/problem "Given that $g(x,y,z)={x}^{3}{z}^{4}+{y}^{3}{z}^{2},$ find $\\frac{∂g}{∂r},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂r} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂r}+\\frac{∂g}{∂z}\\cdot \\frac{∂z}{∂r} \\\\  & =\\frac{∂g}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂g}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=3{x}^{2}{z}^{4},\\,\\frac{∂g}{∂y}=3{y}^{2}{z}^{2}\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =3{r}^{2}{z}^{4}{cos}^{2}⁡\\theta , \\\\ \\frac{∂g}{∂y} & =3{r}^{2}{z}^{2}{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂r} & =(3{r}^{2}{z}^{4}{cos}^{2}⁡\\theta )\\operatorname{cos}⁡\\theta +(3{r}^{2}{z}^{2}{sin}^{2}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =3{r}^{2}{z}^{2}({z}^{2}{cos}^{3}⁡\\theta +{sin}^{3}⁡\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abaecde-f0c9-53d9-a58e-fb98f60eda2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{sin}^{2}⁡\\theta -2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478600} {:answer/id #uuid "1f6054fc-1437-5b2d-8432-34493b15c6c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478608} {:answer/id #uuid "5d8cc96a-5c3e-522a-bb6f-d8ebe3a3b80a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )-2r\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478691} {:answer/id #uuid "860111b7-3db7-5aa8-8df9-cd797e251089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{r}^{2}\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478768} {:answer/id #uuid "982a579f-34d1-56d7-a91d-7ee313227e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{r}^{2}\\operatorname{sin}⁡(2\\theta )+r\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478810}] :answer-field/correct {:answer/id #uuid "5d8cc96a-5c3e-522a-bb6f-d8ebe3a3b80a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )-2r\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478691} :answer-field/id #uuid "7b299f98-e7d5-5d6a-b095-d0d004a31211" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479006}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10ac6b1a-97da-521c-a5c2-16923318bd3b" :question/math-academy-id "q-95108" :question/problem "Given that $p(x,y)=2x+{y}^{2},$ find $\\frac{∂p}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $p(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂p}{∂\\theta } & =\\frac{∂p}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂p}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂p}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂p}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $n$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂p}{∂x}=2,\\,\\frac{∂p}{∂y}=2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂p}{∂x} & =2, \\\\ \\frac{∂p}{∂y} & =2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂p}{∂\\theta } & =-2r\\operatorname{sin}⁡\\theta +(2r\\operatorname{sin}⁡\\theta )r\\operatorname{cos}⁡\\theta  \\\\  & =-2r\\operatorname{sin}⁡\\theta +2{r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}\\operatorname{sin}⁡(2\\theta )-2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8d5bbd-e2b1-533d-9bdd-c6ed6c668040" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta -\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta " :db/id #edb/ref 17592186478606} {:answer/id #uuid "6a2092ad-3f11-5666-b765-95bb966954f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478716} {:answer/id #uuid "6c9972e3-8762-5cb3-b03e-679f5020939c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478720} {:answer/id #uuid "8baa2b02-1db0-5fce-a974-ddf0773d035d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡2\\theta -2\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478779} {:answer/id #uuid "aa3c903d-f537-5005-92b3-162fe2194e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478838}] :answer-field/correct {:answer/id #uuid "aa3c903d-f537-5005-92b3-162fe2194e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478838} :answer-field/id #uuid "a1d7bd4f-ecaa-56a0-8783-ed8687ea01ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479023}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41bc3280-6f3c-5ef7-84dc-f2df8938f974" :question/math-academy-id "q-95135" :question/problem "Given that $v(r,\\theta )=r(1+\\operatorname{cos}⁡2\\theta ),$ find $\\frac{∂v}{∂y},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂v}{∂y}=\\frac{∂v}{∂r}\\operatorname{sin}⁡\\theta +\\frac{1}{r}\\frac{∂v}{∂\\theta }\\operatorname{cos}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $v$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂v}{∂r}=1+\\operatorname{cos}⁡2\\theta ,\\,\\frac{∂v}{∂\\theta }=-2r\\operatorname{sin}⁡2\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂y} & =(1+\\operatorname{cos}⁡2\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(-2r\\operatorname{sin}⁡2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f1b62c-f9ad-5062-b0e1-04d51f193f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r{cos}^{2}⁡\\theta +{r}^{3}{sin}^{4}⁡\\theta " :db/id #edb/ref 17592186478564} {:answer/id #uuid "1506c3d3-af67-5f60-9fbf-f85df4c42324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r{cos}^{2}⁡\\theta +3{r}^{2}{sin}^{3}⁡\\theta " :db/id #edb/ref 17592186478586} {:answer/id #uuid "61401e41-69fe-5937-b2e0-2a0aea6f6035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡(2\\theta )+3{r}^{3}\\operatorname{sin}⁡(4\\theta )" :db/id #edb/ref 17592186478699} {:answer/id #uuid "b9805fe1-fc17-516a-93d3-42522d950906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta +{r}^{2}{sin}^{4}⁡\\theta " :db/id #edb/ref 17592186478860} {:answer/id #uuid "d46accdd-6789-5230-a789-5a2c14364ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta +{r}^{3}{sin}^{3}⁡\\theta " :db/id #edb/ref 17592186478897}] :answer-field/correct {:answer/id #uuid "1506c3d3-af67-5f60-9fbf-f85df4c42324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r{cos}^{2}⁡\\theta +3{r}^{2}{sin}^{3}⁡\\theta " :db/id #edb/ref 17592186478586} :answer-field/id #uuid "dbfbb460-7f02-5f92-88f0-57dd4c8eadf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479044}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "43a13109-9c88-5e83-9206-805f97530d84" :question/math-academy-id "q-95045" :question/problem "Given that $f(x,y,z)={x}^{2}+{y}^{3}+{z}^{4},$ find $\\frac{∂f}{∂r},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂r} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂r}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂r} \\\\  & =\\frac{∂f}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂f}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=3{y}^{2}\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂f}{∂y} & =3{r}^{2}{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂r} & =(2r\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta +(3{r}^{2}{sin}^{2}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2r{cos}^{2}⁡\\theta +3{r}^{2}{sin}^{3}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17a74912-9939-5160-b2f2-fc9f75995b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478590} {:answer/id #uuid "489fb4e2-401a-51bd-8367-54c21281a25c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478661} {:answer/id #uuid "af934f8e-6b47-50f3-976d-130962164ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta +2" :db/id #edb/ref 17592186478844} {:answer/id #uuid "d704c90e-1c68-5f35-9050-f1ea9764f3d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡(2\\theta ))" :db/id #edb/ref 17592186478900} {:answer/id #uuid "f8d81125-ee3b-5e23-ba6b-3f5a3fc654e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(\\operatorname{cos}⁡\\theta +1)" :db/id #edb/ref 17592186478949}] :answer-field/correct {:answer/id #uuid "af934f8e-6b47-50f3-976d-130962164ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta +2" :db/id #edb/ref 17592186478844} :answer-field/id #uuid "77f83ac4-379e-5a13-8c4c-6ea313e7d773" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479004}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4437c604-b7f0-5633-b7e5-9971f03bd2b2" :question/math-academy-id "q-165283" :question/problem "Given that $v(r,\\theta )={r}^{2}+2r\\operatorname{cos}⁡\\theta ,$ find $\\frac{∂v}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂v}{∂x}=\\frac{∂v}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂v}{∂\\theta }\\operatorname{sin}⁡\\theta \n$$\n\nFirst, we find the partial derivatives of $v$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂v}{∂r}=2r+2\\operatorname{cos}⁡\\theta ,\\,\\frac{∂v}{∂\\theta }=-2r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂x} & =(2r+2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-2r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta +2{cos}^{2}⁡\\theta +2{sin}^{2}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta +2({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =2r\\operatorname{cos}⁡\\theta +2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0466a8b0-0e72-50a8-9e40-0c1214a8a281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478566} {:answer/id #uuid "074a0854-45c8-5e8e-88a6-4963ee2622c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2rz\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478571} {:answer/id #uuid "1a085611-6858-54c9-855d-19621bc6a77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186478598} {:answer/id #uuid "aa1073de-8640-5caf-b844-a33c80d8ae74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478837} {:answer/id #uuid "d4935e49-5ceb-5de5-a639-1d44e14dc969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "rz\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478898}] :answer-field/correct {:answer/id #uuid "0466a8b0-0e72-50a8-9e40-0c1214a8a281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478566} :answer-field/id #uuid "52931c2c-52e1-5448-b25c-5e4f502aa192" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478991}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7396bdb2-9333-5e99-8459-ac9d52a00034" :question/math-academy-id "q-165285" :question/problem "Given that $f(x,y,z)=xy{z}^{2},$ find $\\frac{∂f}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂f}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}=2xyz\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =2{r}^{2}z\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}z\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bf02a3a-6507-5e24-9dfe-fdc65427917b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡\\theta -r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478718} {:answer/id #uuid "cb480f73-b28d-5d1d-bf28-114396c6f5bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478886} {:answer/id #uuid "d40c479d-3512-5ad6-901c-ae8cc9ca656d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478896} {:answer/id #uuid "ef9ed06d-7edb-5dc7-a0b5-315d2f4f833d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡(2\\theta ))" :db/id #edb/ref 17592186478932} {:answer/id #uuid "f4006751-8828-5338-b289-001c5c562f27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡(2\\theta ))" :db/id #edb/ref 17592186478941}] :answer-field/correct {:answer/id #uuid "d40c479d-3512-5ad6-901c-ae8cc9ca656d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478896} :answer-field/id #uuid "2c55d75d-2389-5139-9713-9b0001a3628b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478973}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "824e717c-810d-5647-9a31-c9225776fabe" :question/math-academy-id "q-165280" :question/problem "Given that $f(x,y)=2y-xy,$ find $\\frac{∂f}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂f}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂f}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-y,\\,\\frac{∂f}{∂y}=2-x\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-r\\operatorname{sin}⁡\\theta , \\\\ \\frac{∂f}{∂y} & =2-r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =(-r\\operatorname{sin}⁡\\theta )\\,(-r\\operatorname{sin}⁡\\theta )+(2-r\\operatorname{cos}⁡\\theta )r\\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}{sin}^{2}⁡\\theta +2r\\operatorname{cos}⁡\\theta -{r}^{2}{cos}^{2}⁡\\theta  \\\\  & ={r}^{2}({sin}^{2}⁡\\theta -{cos}^{2}⁡\\theta )+2r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}\\operatorname{cos}⁡(2\\theta )+2r\\operatorname{cos}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d25be9-c593-5605-a401-5d2bd749db79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478585} {:answer/id #uuid "7368bb2b-738b-5553-9b24-d72d10f86673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478728} {:answer/id #uuid "84dcc6f3-d690-5f72-8730-48a6a222d69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478763} {:answer/id #uuid "952ab814-3b74-5511-bb1b-17a92c942267" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478803} {:answer/id #uuid "e73b53e8-31b8-587a-95b0-e9d5813a7d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478918}] :answer-field/correct {:answer/id #uuid "7368bb2b-738b-5553-9b24-d72d10f86673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478728} :answer-field/id #uuid "1bff08b3-d2ad-542d-9f8a-a1ea880775f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478967}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "88d1b83b-2766-5063-936f-a018502be867" :question/math-academy-id "q-95137" :question/problem "Given that $h(r,\\theta )=r(\\operatorname{cos}⁡\\theta -1),$ find $\\frac{∂h}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂h}{∂x}=\\frac{∂h}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂h}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r}=\\operatorname{cos}⁡\\theta -1,\\,\\frac{∂h}{∂\\theta }=-r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =(\\operatorname{cos}⁡\\theta -1)\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta -\\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1-\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "578fd67e-6bee-5c2b-b8bf-bcc27293593f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478681} {:answer/id #uuid "67ac1cbd-e9a7-5e4f-a6c5-90683547e24d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{4}\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478712} {:answer/id #uuid "aa6caf2a-21be-526b-986f-2f7d216426b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{4}\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478839} {:answer/id #uuid "b97ad485-d546-55df-a46d-f931c8749f54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{4}\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478859} {:answer/id #uuid "f4265219-f53f-5148-b2f2-d73b22c820e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡\\theta +{z}^{4}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186478942}] :answer-field/correct {:answer/id #uuid "aa6caf2a-21be-526b-986f-2f7d216426b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{4}\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478839} :answer-field/id #uuid "33abe709-ff3f-57d7-b112-d74c4aa40f5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478977}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5265619-0ee7-5042-83d2-70d3e989522b" :question/math-academy-id "q-95170" :question/problem "Given that $w(x,y,z)=x{z}^{4}+y,$ find $\\frac{∂w}{∂r},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂r}+\\frac{∂w}{∂z}\\cdot \\frac{∂z}{∂r} \\\\  & =\\frac{∂w}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂w}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}={z}^{4},\\,\\frac{∂w}{∂y}=1\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & ={z}^{4}, \\\\ \\frac{∂w}{∂y} & =1.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =({z}^{4})\\operatorname{cos}⁡\\theta +(1)\\operatorname{sin}⁡\\theta  \\\\  & ={z}^{4}\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6d8b25-1be0-507f-9e45-600b11128f7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478574} {:answer/id #uuid "194c2f16-5d03-56da-8f8a-2451146b01a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478595} {:answer/id #uuid "27127698-eb1f-5556-ba20-69f2d7bce69e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186478617} {:answer/id #uuid "80a52cdb-4432-54c2-aba3-ba66914bcbe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478752} {:answer/id #uuid "91e129af-e354-55a9-b266-adc2bb6d4a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186478794}] :answer-field/correct {:answer/id #uuid "194c2f16-5d03-56da-8f8a-2451146b01a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478595} :answer-field/id #uuid "74be8c02-d536-5d47-b824-c1806a52210c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479003}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5298f54-bfaf-5a4f-ac68-b78b607bf15c" :question/math-academy-id "q-95115" :question/problem "Given that $h(x,y)={x}^{2}-{y}^{2},$ find $\\frac{∂h}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =\\frac{∂h}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂h}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=2x,\\,\\frac{∂h}{∂y}=-2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =2r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂h}{∂y} & =-2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =(2r\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta -(2r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2r({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =2r\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b6645f2-694d-5701-b91f-bf076971ef68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478601} {:answer/id #uuid "4d211281-45d7-5aac-97a5-b16e835059d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )" :db/id #edb/ref 17592186478667} {:answer/id #uuid "53caf8ff-2acc-51ae-aaa5-97dfb713b748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(\\operatorname{sin}⁡(2\\theta )+r\\operatorname{cos}⁡(\\theta )" :db/id #edb/ref 17592186478678} {:answer/id #uuid "64d89caa-06b3-5a99-b92b-722d4926b374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\operatorname{sin}⁡\\theta +{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478705} {:answer/id #uuid "dd87415c-114c-567c-b99f-b5fa2701b9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478907}] :answer-field/correct {:answer/id #uuid "1b6645f2-694d-5701-b91f-bf076971ef68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478601} :answer-field/id #uuid "549b5d38-f4aa-575f-b0f7-90b5dcfff3ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478994}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d222dcc8-f398-5562-bff7-74444e587da8" :question/math-academy-id "q-165281" :question/problem "Given that $f(x,y)={x}^{2}+y,$ find $\\frac{∂f}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂f}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂f}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=1\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂f}{∂y} & =1.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =-2r\\operatorname{cos}⁡\\theta \\,r\\operatorname{sin}⁡\\theta +r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}\\operatorname{sin}⁡(2\\theta )+r\\operatorname{cos}⁡\\theta  \\\\  & =r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "893956da-d416-51f2-95f7-dc12fb1c1725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡\\theta +2rz" :db/id #edb/ref 17592186478773} {:answer/id #uuid "9713ade3-5604-530d-b802-1fdfc640a4e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{cos}^{2}⁡\\theta +2z" :db/id #edb/ref 17592186478807} {:answer/id #uuid "b62c08b7-43fb-5995-8666-a7c19ff8a830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡2\\theta +z" :db/id #edb/ref 17592186478854} {:answer/id #uuid "daa43c07-cab4-59d9-96d9-b09db9596eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{sin}^{2}⁡\\theta +z" :db/id #edb/ref 17592186478903} {:answer/id #uuid "f69418f1-6362-5b4e-8489-03eacbf8b9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡2\\theta +2z" :db/id #edb/ref 17592186478945}] :answer-field/correct {:answer/id #uuid "9713ade3-5604-530d-b802-1fdfc640a4e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{cos}^{2}⁡\\theta +2z" :db/id #edb/ref 17592186478807} :answer-field/id #uuid "45082c16-ebec-5599-aae3-e180ec356a3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478983}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e54cb552-8c05-5b9c-84f1-978bbe7cbf63" :question/math-academy-id "q-95168" :question/problem "Given that $g(x,y,z)={x}^{2}z+{z}^{2},$ find $\\frac{∂g}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂g}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂g}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z}={x}^{2}+2z\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & ={r}^{2}{cos}^{2}⁡\\theta +2z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188706c6-3a9a-59e2-a321-b5f7df7e0d47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z\\operatorname{cos}⁡2\\theta " :db/id #edb/ref 17592186478593} {:answer/id #uuid "48daba33-40ff-5944-964d-6c1da24ee2b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2rz\\operatorname{cos}⁡2\\theta " :db/id #edb/ref 17592186478662} {:answer/id #uuid "b483533f-bf6d-5af3-85eb-651c6a343298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "rz{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186478851} {:answer/id #uuid "bfd84997-1bc6-5e77-af1c-2104ef3b0bee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z" :db/id #edb/ref 17592186478869} {:answer/id #uuid "cb23270c-5341-5bc3-a497-83e69396e2b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478885}] :answer-field/correct {:answer/id #uuid "188706c6-3a9a-59e2-a321-b5f7df7e0d47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}z\\operatorname{cos}⁡2\\theta " :db/id #edb/ref 17592186478593} :answer-field/id #uuid "ce5f4636-c6b9-5bae-8b55-2a495ce5b39c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479039}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eb779ef9-c9f2-5338-9ff6-677718e082ac" :question/math-academy-id "q-95169" :question/problem "Given that $h(x,y,z)=xyz,$ find $\\frac{∂h}{∂\\theta },$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta } & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂\\theta }+\\frac{∂h}{∂z}\\cdot \\frac{∂z}{∂\\theta } \\\\  & =-\\frac{∂h}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂h}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=yz,\\,\\frac{∂h}{∂y}=xz\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =rz\\operatorname{sin}⁡\\theta , \\\\ \\frac{∂h}{∂y} & =rz\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta } & =-(rz\\operatorname{sin}⁡\\theta )r\\operatorname{sin}⁡\\theta +(rz\\operatorname{cos}⁡\\theta )r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}z{sin}^{2}⁡\\theta +{r}^{2}z{cos}^{2}⁡\\theta  \\\\  & ={r}^{2}z({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & ={r}^{2}z\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186508977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12433c4a-668f-57da-9582-b6ee6515dc42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186508415} {:answer/id #uuid "5c05a8fd-c462-59f0-82be-578cd7e2ef16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorna