{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526180} :answer-field/id #uuid "89b86388-a8f9-541f-8e1f-d5aece2596e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526193}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1f34d303-adce-5e96-8e3e-a46bddba0d7c" :question/problem "Given that $w(x,y)=- 2 x^{2} y - x y^{2},$ find $\\frac{∂w}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta} & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =\\left(\\frac{∂w}{∂x}\\right)(- r \\sin{\\left(\\theta \\right)})+\\left(\\frac{∂w}{∂y}\\right)(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=- 4 x y - y^{2},\\,\\frac{∂w}{∂y}=- 2 x^{2} - 2 x y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & =- r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂w}{∂y} & =- 2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{2} \\cos^{2}{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta} & =(- r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})(- r \\sin{\\left(\\theta \\right)})+(- 2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{2} \\cos^{2}{\\left(\\theta \\right)})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})+(- 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}) \\\\  & =r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0146a63c-62c6-560b-8bf6-e87a875aba94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 r \\sin^{2}{\\left(\\theta \\right)} + 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526156} {:answer/id #uuid "74e7bddb-101d-5b9e-87f1-113de332564d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526185} {:answer/id #uuid "7b6a11b6-329f-51a9-a974-6ec14d3a4bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526187} {:answer/id #uuid "b9a65f47-d085-5450-a793-ff1778432351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 r \\sin^{2}{\\left(\\theta \\right)} - r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526210} {:answer/id #uuid "e639b67f-fbb5-5ca1-ac05-e9a89950e83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526220}] :answer-field/correct {:answer/id #uuid "7b6a11b6-329f-51a9-a974-6ec14d3a4bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526187} :answer-field/id #uuid "24ce3f6b-1cff-5e54-951c-3d66da20a412" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526167}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3a1713ce-41c1-5e43-88ce-84d20bba3e8d" :question/problem "Given that $g(x,y)=- x^{2} - x y + 2 y^{2},$ find $\\frac{∂g}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂r} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =\\left(\\frac{∂g}{∂x}\\right)(\\cos{\\left(\\theta \\right)})+\\left(\\frac{∂g}{∂y}\\right)(\\sin{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=- 2 x - y,\\,\\frac{∂g}{∂y}=- x + 4 y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =- r \\sin{\\left(\\theta \\right)} - 2 r \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂g}{∂y} & =4 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂r} & =(- r \\sin{\\left(\\theta \\right)} - 2 r \\cos{\\left(\\theta \\right)})(\\cos{\\left(\\theta \\right)})+(4 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)})(\\sin{\\left(\\theta \\right)}) \\\\  & =(- r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)})+(4 r \\sin^{2}{\\left(\\theta \\right)} - r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}) \\\\  & =4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b3c018-edde-524b-b06c-f153e53c6290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526171} {:answer/id #uuid "5fe3c20f-e840-5440-be2a-f5c1a1149fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526179} {:answer/id #uuid "8d818a12-395f-5c83-b461-dd04476ca3f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/r