}(x) \\\\  & ={({2}^{x})}^{′}\\log _{7} (x)+{2}^{x}{(\\log _{7} (x))}^{′} \\\\  & =({2}^{x}\\ln  (2))(\\log _{7} (x))+({2}^{x})(\\frac{1}{x\\ln  (7)}) \\\\  & ={2}^{x}\\ln  (2)\\log _{7} (x)+\\frac{{2}^{x}}{x\\ln  (7)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{10}(x) \\sec^{2}{\\left(x \\right)}" :db/id #edb/ref 17592186657625}] :answer-field/correct {:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{10}(x) \\sec^{2}{\\left(x \\right)}" :db/id #edb/ref 17592186657625} :answer-field/id #uuid "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b796de74-72c4-529b-b038-a4d67224a125" :question/problem "Given that $f(x)=\\tan(x)\\log(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\log(x)=\\log_{10}(x)$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{\\tan{\\left(x \\right)}}{x \\ln{\\left(10 \\right)}}$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\tan(x)$ and $v(x)=\\log(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\tan(x))^{′}\\log(x)+\\tan(x)(\\log(x))^{′} \\\\  & =(\\sec^{2}(x))(\\log(x))+(\\tan(x))(\\frac{1}{x\\ln(10)}) \\\\  & =\\sec^{2}(x)\\log(x)+\\frac{\\tan(x)}{x\\ln(10)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620} {:answer/id #uuid "e7cb6598-216f-42c9-acbb-153b6a47e8da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^3+4}{x}" :db/id #edb/ref 17592186674541}] :answer-field/correct {:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620} :answer-field/id #uuid "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657631}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/problem "Given that $f(x)=({x}^{3}+4)\\ln(x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=3 x^{2} \\ln{\\left(x \\right)}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=({x}^{3}+4)$ and $v(x)=\\ln(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(({x}^{3}+4))^{′}\\ln(x)+({x}^{3}+4)(\\ln(x))^{′} \\\\  & =(3{x}^{2})(\\ln(x))+({x}^{3}+4)(\\frac{1}{x}) \\\\  & =3{x}^{2}\\ln(x)+\\frac{{x}^{3}+4}{x}\\end{aligned}\n$$"}]}
