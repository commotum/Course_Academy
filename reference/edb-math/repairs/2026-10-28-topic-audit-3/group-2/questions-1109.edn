\\right)} - 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086}] :answer-field/correct {:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086} :answer-field/id #uuid "1461180d-25fe-52b1-abad-c2120615be94" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536066}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "025970ae-87f8-5c12-8836-70b62439e2c5" :question/problem "If a curve $C$ is given by $y=(3 x^{2} + x - 1)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3 x^{2} + x - 1$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=6 x + 1,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 x^{2} + x - 1)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (6 x + 1) \\\\ &=\\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} + x \\ln{\\left(x \\right)} + x - 1}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(3 (e^{2})^{2} + (e^{2}) - 1)\\cdot \\left(\\frac{1}{(e^{2})}\\right)+(\\ln{\\left((e^{2}) \\right)})\\cdot (6 (e^{2}) + 1) \\\\ &=(-1 + e^{2} + 3 e^{4})\\cdot (e^{-2})+(2)\\cdot (1 + 6 e^{2}) \\\\ &=- \\frac{1}{e^{2}} + 3 + 15 e^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- \\frac{1}{e^{2}} + 3 + 15 e^{2}.$"}] [{:db/id #edb/ref 17592186536065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f87e3eb-6bcd-53ef-bb03-fc2a22a36834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186536064} {:answer/id #uuid "3bb39653-f774-5bc6-95ff-0532ba097430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186536073} {:answer/id #uuid "4a8deab9-18c9-5ebc-98e6-8435b3c93cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186536078} {:answer/id #uuid "84823475-39f2-5b99-8473-e23495b0e21d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536085} {:answer/id #uuid "d1b1968b-bd0a-5181-accb-526b08866904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536095}] :answer-field/correct {:answer/id #uuid "3bb39653-f774-5bc6-95ff-0532ba097430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186536073} :answer-field/id #uuid "4c5e91f8-c020-5cd4-ab84-1fac365579b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536079}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11508a06-1238-59d6-9f30-ce054ca95db7" :question/problem "If a curve $C$ is given by $y=(4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(4 e^{x})\\cdot (1)+(x + 1)\\cdot (4 e^{x}) \\\\ &=4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (4 e^{(0)}) \\\\ &=(4)\\cdot (1)+(1)\\cdot (4) \\\\ &=8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $8.$"}] [{:db/id #edb/ref 17592186536069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068}] :answer-field/correct {:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068} :answer-field/id #uuid "a3c99e80-1859-5501-94e2-065df60ee30c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536092}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "33ab5b35-dd61-5afa-9e50-76ac2177002e" :question/problem "If a curve $C$ is given by $y=(- x^{2} - x - 1)\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - x - 1$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 1,\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - x - 1)\\cdot (\\cos{\\left(x \\right)})+(\\sin{\\left(x \\right)})\\cdot (- 2 x - 1) \\\\ &=- x^{2} \\cos{\\left(x \\right)} - 2 x \\sin{\\left(x \\right)} - x \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=(- \\left(\\frac{\\pi}{4}\\right)^{2} - \\left(\\frac{\\pi}{4}\\right) - 1)\\cdot (\\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})+(\\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (- 2 \\left(\\frac{\\pi}{4}\\right) - 1) \\\\ &=(-1 - \\frac{\\pi}{4} - \\frac{\\pi^{2}}{16})\\cdot \\left(\\frac{\\sqrt{2}}{2}\\right)+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\frac{\\pi}{2} - 1) \\\\ &=\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.$"}] [{:db/id #edb/ref 17592186536071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f58f4a6-0b44-5f88-9b25-552d8955a459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186536084} {:answer/id #uuid "9067e445-c243-5b05-b2ab-57c52adbf2ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186536088} {:answer/id #uuid "b52782fc-00de-55d6-a076-2f209848a815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186536093} {:answer/id #uuid "c791b538-1274-505c-a9e0-ab9ebe95ebd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536094} {:answer/id #uuid "e8f0fd20-ea84-5728-a09c-b8667bf436f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186536097}] :answer-field/correct {:answer/id #uuid "e8f0fd20-ea84-5728-a09c-b8667bf436f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186536097} :answer-field/id #uuid "3ecdcf0c-044d-52db-b4c4-2ebdf6a193cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536076}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3897814a-55c8-55e3-8f23-2d1a17edc389" :question/problem "If a curve $C$ is given by $y=(- e^{x})\\cdot (x + 3)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=- e^{x}$ and $v(x)=x + 3.$ Then, we have\n\n$$\nu'(x)=- e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- e^{x})\\cdot (1)+(x + 3)\\cdot (- e^{x}) \\\\ &=- \\left(x + 4\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- e^{(0)})\\cdot (1)+((0) + 3)\\cdot (- e^{(0)}) \\\\ &=(-1)\\cdot (1)+(3)\\cdot (-1) \\\\ &=-4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-4.$"}] [{:db/id #edb/ref 17592186536074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abdf3e2-3942-5519-a3a0-98c8ba14955a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536062}] :answer-field/correct {:answer/id #uuid "0abdf3e2-3942-5519-a3a0-98c8ba14955a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536062} :answer-field/id #uuid "77d6b1af-8fd9-5dcc-9877-1ef7732a91ee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536083}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3be093e9-a88a-5893-84f7-f2f4d4e8fb03" :question/problem "If a curve $C$ is given by $y=(- 4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 4 e^{x})\\cdot (1)+(x + 1)\\cdot (- 4 e^{x}) \\\\ &=- 4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 4 e^{(0)}) \\\\ &=(-4)\\cdot (1)+(1)\\cdot (-4) \\\\ &=-8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-8.$"}] [{:db/id #edb/ref 17592186536075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081}] :answer-field/correct {:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081} :answer-field/id #uuid "718082e0-417d-5acb-ab28-41d32f8d52ce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536082}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3cc06495-0e47-5717-9700-118ad0cf690b" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 2 x + 2)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 2 x + 2$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 2,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 2 x + 2)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (- 2 x - 2) \\\\ &=- \\frac{2 x^{2} \\ln{\\left(x \\right)} + x^{2} + 2 x \\ln{\\left(x \\right)} + 2 x - 2}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(- (e^{2})^{2} - 2 (e^{2}) + 2)\\cdot \\left(\\frac{1}{(e^{2})}\\right)+(\\ln{\\left((e^{2}) \\right)})\\cdot (- 2 (e^{2}) - 2) \\\\ &=(- e^{4} - 2 e^{2} + 2)\\cdot (e^{-2})+(2)\\cdot (- 2 e^{2} - 2) \\\\ &=- 5 e^{2} - 6 + \\frac{2}{e^{2}}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 5 e^{2} - 6 + \\frac{2}{e^{2}}.$"}] [{:db/id #edb/ref 17592186536077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091}] :answer-field/correct {:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091} :answer-field/id #uuid "354f12c4-c49c-5ce8-9d56-4a6bfbb09230" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536070}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "45e8eff6-7be8-5e2f-8927-eac30ddd0bc6" :question/problem "If a curve $C$ is given by $y=(- 3 x^{2} + 3 x - 4)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 3 x^{2} + 3 x - 4$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=3 - 6 x,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 x^{2} + 3 x - 4)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (3 - 6 x) \\\\ &=- \\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} - 3 x \\ln{\\left(x \\right)} - 3 x + 4}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e} &=(- 3 (e)^{2} + 3 (e) - 4)\\cdot \\left(\\frac{1}{(e)}\\right)+(\\ln{\\left((e) \\right)})\\cdot (3 - 6 (e)) \\\\ &=(- 3 e^{2} - 4 + 3 e)\\cdot (e^{-1})+(1)\\cdot (3 - 6 e) \\\\ &=- 9 e - \\frac{4}{e} + 6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 9 e - \\frac{4}{e} + 6.$"}] [{:db/id #edb/ref 17592186536087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063}] :answer-field/correct {:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063} :answer-field/id #uuid "1d6f8461-59dd-570a-8790-4ee15ed4552d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536067}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "89a63571-dce9-5ef0-8359-7d12fffc0179" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 3 x - 4)\\cdot (\\cos{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 3 x - 4$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 3,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 3 x - 4)\\cdot (- \\sin{\\left(x \\right)})+(\\cos{\\left(x \\right)})\\cdot (- 2 x - 3) \\\\ &=x^{2} \\sin{\\left(x \\right)} + 3 x \\sin{\\left(x \\right)} - 2 x \\cos{\\left(x \\right)} + 4 \\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=(- \\left(\\frac{3 \\pi}{4}\\right)^{2} - 3 \\left(\\frac{3 \\pi}{4}\\right) - 4)\\cdot (- \\sin{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})+(\\cos{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})\\cdot (- 2 \\left(\\frac{3 \\pi}{4}\\right) - 3) \\\\ &=(- \\frac{9 \\pi}{4} - \\frac{9 \\pi^{2}}{16} - 4)\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right)+\\left(- \\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\frac{3 \\pi}{2} - 3) \\\\ &=\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.$"}] [{:db/id #edb/ref 17592186536090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396109d2-9a78-5ec7-8f4c-daf147bbb5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186536072}] :answer-field/correct {:answer/id #uuid "396109d2-9a78-5ec7-8f4c-daf147bbb5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186536072} :answer-field/id #uuid "923746ba-42ca-56b6-8ff7-9429d9c12883" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536089}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92e053cc-163c-5fb4-9084-c721d7a398e6" :question/problem "If a curve $C$ is given by $y=(3 e^{x})\\cdot (x + 2)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3 e^{x}$ and $v(x)=x + 2.$ Then, we have\n\n$$\nu'(x)=3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 e^{x})\\cdot (1)+(x + 2)\\cdot (3 e^{x}) \\\\ &=3 \\left(x + 3\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(3 e^{(0)})\\cdot (1)+((0) + 2)\\cdot (3 e^{(0)}) \\\\ &=(3)\\cdot (1)+(2)\\cdot (3) \\\\ &=9.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $9.$"}] [{:db/id #edb/ref 17592186536098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbaa2ade-3a9e-5286-83c0-581f6b0d6602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186536096}] :answer-field/correct {:answer/id #uuid "dbaa2ade-3a9e-5286-83c0-581f6b0d6602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186536096} :answer-field/id #uuid "50a33319-8a25-53ef-8f2f-91c0f3e572b9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536080}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fad32388-6506-515e-9fd4-68888763cf2f" :question/problem "If a curve $C$ is given by $y=(- 3 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 3 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 e^{x})\\cdot (1)+(x + 1)\\cdot (- 3 e^{x}) \\\\ &=- 3 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 3 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 3 e^{(0)}) \\\\ &=(-3)\\cdot (1)+(1)\\cdot (-3) \\\\ &=-6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-6.$"}] [{:db/id #edb/ref 17592186571385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7864c3b-b764-56cd-a641-bd65ea7dd484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2}(x)\\log(x)" :db/id #edb/ref 17592186571265}] :answer-field/correct {:answer/id #uuid "f7864c3b-b764-56cd-a641-bd65ea7dd484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2}(x)\\log(x)" :db/id #edb/ref 17592186571265} :answer-field/id #uuid "0af8eb9f-fc24-5d73-ad75-f548e3ea3646" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571289}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "303e2b76-22b6-55f6-abfa-1986d9ab5f9d" :question/math-academy-id "q-320820" :question/problem "Given that $f(x)=\\operatorname{tan}⁡(x)\\operatorname{log}⁡(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\operatorname{log}⁡(x)={log}_{10}⁡(x)$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{\\operatorname{tan}⁡(x)}{x\\operatorname{ln}⁡(10)}$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\operatorname{tan}⁡(x)$ and $v(x)=\\operatorname{log}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\operatorname{tan}⁡(x))}^{′}\\operatorname{log}⁡(x)+\\operatorname{tan}⁡(x){(\\operatorname{log}⁡(x))}^{′} \\\\  & =({sec}^{2}⁡(x))(\\operatorname{log}⁡(x))+(\\operatorname{tan}⁡(x))\\left(\\frac{1}{x\\operatorname{ln}⁡(10)}\\right) \\\\  & ={sec}^{2}⁡(x)\\operatorname{log}⁡(x)+\\frac{\\operatorname{tan}⁡(x)}{x\\operatorname{ln}⁡(10)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa1cb47c-2e18-5935-a199-4342ba479343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186571271}] :answer-field/correct {:answer/id #uuid "fa1cb47c-2e18-5935-a199-4342ba479343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186571271} :answer-field/id #uuid "99aa048f-795f-5835-b3e4-7ab1bb44a8a9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571340}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a0fee3ca-7f95-5f0e-a414-4282e409bf7a" :question/math-academy-id "q-319824" :question/problem "If a curve $C$ is given by $y=(2x+1)\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=1$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=2x+1$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(2x+1)\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 2 \\\\  & =\\frac{2x+1}{x}+2\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2x+1}{x}+2\\operatorname{ln}⁡x)|}_{x=1} \\\\  & =\\frac{2(1)+1}{1}+2\\operatorname{ln}⁡1 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"}] [{:db/id #edb/ref 17592186571442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbb081d-8fbf-5577-b042-226064e10be0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{cos}⁡x+3{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571014} {:answer/id #uuid "a20a9a53-3e6f-5754-8799-d24e521ac2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}\\operatorname{cos}⁡x+3{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571145} {:answer/id #uuid "a462a7c9-b56d-5b3e-b5f2-01b27202da04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571149} {:answer/id #uuid "cadbcaa0-5f4b-5598-a6eb-4541c20a3865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{3}\\operatorname{cos}⁡x+3{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571202} {:answer/id #uuid "dd2fd5e5-1d32-56a9-b43f-1421f5392621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571232}] :answer-field/correct {:answer/id #uuid "a462a7c9-b56d-5b3e-b5f2-01b27202da04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571149} :answer-field/id #uuid "b4d091bc-16c4-5784-a6c4-28309a12be4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571351}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d8004d91-2319-5283-80d1-a0670d83fdc0" :question/math-academy-id "q-104300" :question/problem "Differentiate ${x}^{3}\\operatorname{cos}⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={x}^{3}$ and $v(x)=\\operatorname{cos}⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({x}^{3}\\operatorname{cos}⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({x}^{3})^{′}\\cdot \\operatorname{cos}⁡x+{x}^{3}\\cdot (\\operatorname{cos}⁡x)^{′} \\\\  & =(3{x}^{2})(\\operatorname{cos}⁡x)+({x}^{3})(-\\operatorname{sin}⁡x) \\\\  & =3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} {:answer/id #uuid "205ae525-2c88-43fd-ab44-a800dec93096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\ln x+x+\\frac{3}{x}" :db/id #edb/ref 17592186576147}] :answer-field/correct {:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} :answer-field/id #uuid "b6a34341-fe46-5049-b63f-03fb79ef67af" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f475b19b-1e35-517e-8f15-4fa3d740b6ba" :question/math-academy-id "q-320824" :question/problem "Given that $f(x)=({x}^{2}+3)\\operatorname{ln}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=2x\\operatorname{ln}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}+3$ and $v(x)=\\operatorname{ln}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2}+3)}^{′}\\operatorname{ln}⁡(x)+({x}^{2}+3){(\\operatorname{ln}⁡(x))}^{′} \\\\  & =(2x)(\\operatorname{ln}⁡(x))+({x}^{2}+3)\\left(\\frac{1}{x}\\right) \\\\  & =2x\\operatorname{ln}⁡(x)+\\frac{{x}^{2}+3}{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f296ed5-5ee1-5373-8853-cd9b42ca5b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186578346}] :answer-field/correct {:answer/id #uuid "2f296ed5-5ee1-5373-8853-cd9b42ca5b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186578346} :answer-field/id #uuid "59299f55-f653-572d-af54-ffb8778f188f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578723}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "23f453dd-5391-598b-a2f5-caa9d74e0c57" :question/math-academy-id "q-167316" :question/problem "If a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. \n\nIn part 2 we found that $$\n\\displaystyle \\frac{\\text{d}f}{\\text{d}x}=2\\operatorname{cos}⁡x-3\\operatorname{sin}⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}f}{\\text{d}x}+f\\frac{\\text{d}(x)}{\\text{d}x} \\\\  & =x\\cdot (2\\operatorname{cos}⁡x-3\\operatorname{sin}⁡x)+(2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)\\cdot 1 \\\\  & =(2-3x)\\operatorname{sin}⁡x+(3+2x)\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & =(2-3(0))\\operatorname{sin}⁡(0)+(3+2(0))\\operatorname{cos}⁡(0) \\\\  & =3\\operatorname{cos}⁡(0) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"}] [{:db/id #edb/ref 17592186586552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e9a10c-b454-5d9e-b42d-a5b4e64d2a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^x\\ln(3)\\cos(x)" :db/id #edb/ref 17592186585886}] :answer-field/correct {:answer/id #uuid "04e9a10c-b454-5d9e-b42d-a5b4e64d2a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^x\\ln(3)\\cos(x)" :db/id #edb/ref 17592186585886} :answer-field/id #uuid "517709e9-f87f-51ef-86e5-3a7246853549" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186586429}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4aaf1474-44f2-53a9-ae70-2c44030b9b58" :question/math-academy-id "q-311231" :question/problem "Given that $f(x)={3}^{x}\\operatorname{cos}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $-\\,{3}^{x}\\operatorname{sin}⁡(x)$" :question/worked-solution "Here, we have the product of two functions $u(x)={3}^{x}$ and $v(x)=\\operatorname{cos}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({3}^{x})}^{′}\\operatorname{cos}⁡(x)+{3}^{x}{(\\operatorname{cos}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))\\operatorname{cos}⁡(x)+{3}^{x}(-\\operatorname{sin}⁡(x)) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3)\\operatorname{cos}⁡(x)-{3}^{x}\\operatorname{sin}⁡(x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c287098-fdb2-58e8-8342-956a1ff9deb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586034} {:answer/id #uuid "612c3980-83e9-5078-8f02-eb7e2291e335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+\\frac{2{e}^{x}}{\\sqrt{x}}" :db/id #edb/ref 17592186586063} {:answer/id #uuid "81086a0e-a325-51b9-93a4-e249186b89b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586132} {:answer/id #uuid "ab530418-5692-5073-9efb-8e7255b84fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586226} {:answer/id #uuid "b967f191-c4fe-5e66-b7f6-f73c7faf9b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+x{e}^{x}}{\\sqrt{x}}" :db/id #edb/ref 17592186586246}] :answer-field/correct {:answer/id #uuid "ab530418-5692-5073-9efb-8e7255b84fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586226} :answer-field/id #uuid "3c400dff-bed5-5d41-986f-72a99df176f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64d86353-289c-5c4c-a5f5-b6e2b66703e2" :question/math-academy-id "q-47954" :question/problem "Given that $f(x)=\\sqrt{x}{e}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\sqrt{x}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\sqrt{x})^{′}\\cdot {e}^{x}+\\sqrt{x}\\cdot ({e}^{x})^{′} \\\\  & =\\frac{1}{2\\sqrt{x}}{e}^{x}+\\sqrt{x}{e}^{x} \\\\  & =\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00cbe2c2-361c-57b8-8499-6c44bef9cd90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186600505}] :answer-field/correct {:answer/id #uuid "00cbe2c2-361c-57b8-8499-6c44bef9cd90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186600505} :answer-field/id #uuid "7de17562-4cb2-576c-b80a-4d58584f24da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600746}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "688015ab-7641-5f23-9a80-3af6a7102896" :question/math-academy-id "q-167769" :question/problem "If a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. \n\nIn part 2 we found that $$\n\\displaystyle \\frac{\\text{d}f}{\\text{d}x}=2\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x).\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}f}{\\text{d}x}+f\\frac{\\text{d}(x)}{\\text{d}x} \\\\  & =x\\cdot (2\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x))+(2\\operatorname{sin}⁡(x)+3\\operatorname{cos}⁡(x))\\cdot 1 \\\\  & =(2-3x)\\operatorname{sin}⁡(x)+(3+2x)\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & =(2-3(0))\\operatorname{sin}⁡(0)+(3+2(0))\\operatorname{cos}⁡(0) \\\\  & =3\\operatorname{cos}⁡(0) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"}] [{:db/id #edb/ref 17592186610506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165ecc04-7fbd-5a77-93f6-d22774668d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\sqrt{2} e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186610508} {:answer/id #uuid "a9a9eb71-d6f4-5e56-a789-44d48c2f4a4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2} e^{\\frac{3 \\pi}{4}}}{2}" :db/id #edb/ref 17592186610522} {:answer/id #uuid "c05b88fb-a1f5-578d-b994-6446f57d9da5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 \\sqrt{2} e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186610523} {:answer/id #uuid "c158e98d-9be1-5924-824f-86a906952603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2} e^{\\frac{3 \\pi}{4}}}{4}" :db/id #edb/ref 17592186610524} {:answer/id #uuid "e7d12503-47d7-5f59-a1b1-50b38d30a30b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610530}] :answer-field/correct {:answer/id #uuid "e7d12503-47d7-5f59-a1b1-50b38d30a30b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610530} :answer-field/id #uuid "35cfa76c-d46c-58d5-abac-80705a446e4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610514}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d6c902f-2435-5203-aa9f-262524ac5a30" :question/problem "If a curve $C$ is given by $y=(2 e^{x})\\cdot (\\sin{\\left(x \\right)}),$ calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=2 e^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=2 e^{x},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(2 e^{x})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (2 e^{x})\\end{aligned} \\\\ &=2 e^{x}(\\cos x+\\sin x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=\\begin{aligned}&(2 e^{\\left(\\frac{3 \\pi}{4}\\right)})\\cdot (\\cos{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)}) \\\\ &{}+(\\sin{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})\\cdot (2 e^{\\left(\\frac{3 \\pi}{4}\\right)})\\end{aligned} \\\\ &=\\begin{aligned}&(2 e^{\\frac{3 \\pi}{4}})\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &{}+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (2 e^{\\frac{3 \\pi}{4}})\\end{aligned} \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$"}] [{:db/id #edb/ref 17592186610512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c653dab-d9d6-5b47-ba64-cbbe5b46db95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{e^{\\pi}}{4}" :db/id #edb/ref 17592186610511} {:answer/id #uuid "4113257e-c58c-52bb-ba02-31e91a438929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610515} {:answer/id #uuid "6b30face-c814-5cf8-878a-8e44698640ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 e^{\\pi}" :db/id #edb/ref 17592186610518} {:answer/id #uuid "91feb006-6edf-5c92-814e-860c6f6c38e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{e^{\\pi}}{2}" :db/id #edb/ref 17592186610521} {:answer/id #uuid "c9c63d51-a96d-5e42-858d-40ab7b62ab2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- e^{\\pi}" :db/id #edb/ref 17592186610526}] :answer-field/correct {:answer/id #uuid "c9c63d51-a96d-5e42-858d-40ab7b62ab2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- e^{\\pi}" :db/id #edb/ref 17592186610526} :answer-field/id #uuid "549d2205-841f-52e6-a67c-6b578550ece4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610516}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30877dff-2142-58cc-a6f0-c31f215bf1ca" :question/problem "If a curve $C$ is given by $y=(e^{x})\\cdot (\\sin{\\left(x \\right)}),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=e^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=e^{x},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(e^{x})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (e^{x})\\end{aligned} \\\\ &=e^{x}(\\cos x+\\sin x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\pi} &=\\begin{aligned}&(e^{(\\pi)})\\cdot (\\cos{\\left((\\pi) \\right)}) \\\\ &{}+(\\sin{\\left((\\pi) \\right)})\\cdot (e^{(\\pi)})\\end{aligned} \\\\ &=(e^{\\pi})\\cdot (-1)+(0)\\cdot (e^{\\pi}) \\\\ &=- e^{\\pi}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- e^{\\pi}.$"}] [{:db/id #edb/ref 17592186610517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0342fedd-8d06-51bf-b9ad-5e63f5f5f982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{8}" :db/id #edb/ref 17592186610505} {:answer/id #uuid "173ff202-950a-5940-aabe-82d481b5d461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{4}" :db/id #edb/ref 17592186610509} {:answer/id #uuid "c354a2c8-b0de-585b-8ee4-0a43e6df96a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{27 \\pi^{2}}{2}" :db/id #edb/ref 17592186610525} {:answer/id #uuid "cb0129b4-44ea-5647-bf41-eda356ea7056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{81 \\pi^{2}}{4}" :db/id #edb/ref 17592186610527} {:answer/id #uuid "e16fa939-f833-50c4-9a94-5a392aabfb39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81 \\pi^{2}}{16}" :db/id #edb/ref 17592186610529}] :answer-field/correct {:answer/id #uuid "173ff202-950a-5940-aabe-82d481b5d461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{4}" :db/id #edb/ref 17592186610509} :answer-field/id #uuid "f04cda44-d833-5a4f-9cef-56d38d1b0af1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610531}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6996047e-7e31-5564-bb70-e58aabf2bfcd" :question/problem "If a curve $C$ is given by $y=(- x^{3})\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{2}$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{3}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 3 x^{2},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(- x^{3})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (- 3 x^{2})\\end{aligned} \\\\ &=- x^{2} \\left(x \\cos{\\left(x \\right)} + 3 \\sin{\\left(x \\right)}\\right).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{2}} &=\\begin{aligned}&(- \\left(\\frac{3 \\pi}{2}\\right)^{3})\\cdot (\\cos{\\left(\\left(\\frac{3 \\pi}{2}\\right) \\right)}) \\\\ &{}+(\\sin{\\left(\\left(\\frac{3 \\pi}{2}\\right) \\right)})\\cdot (- 3 \\left(\\frac{3 \\pi}{2}\\right)^{2})\\end{aligned} \\\\ &=\\begin{aligned}&\\left(- \\frac{27 \\pi^{3}}{8}\\right)\\cdot (0) \\\\ &{}+(-1)\\cdot \\left(- \\frac{27 \\pi^{2}}{4}\\right)\\end{aligned} \\\\ &=\\frac{27 \\pi^{2}}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{27 \\pi^{2}}{4}.$"}] [{:db/id #edb/ref 17592186610519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a49124e-b359-593a-a72b-ef618ed162eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}" :db/id #edb/ref 17592186610510}] :answer-field/correct {:answer/id #uuid "1a49124e-b359-593a-a72b-ef618ed162eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}" :db/id #edb/ref 17592186610510} :answer-field/id #uuid "0f7d6f26-56ba-523c-91e9-3177f7b66fb2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186610507}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6ecb8282-6295-5cd9-a5b5-e1bb578640a9" :question/problem "If a curve $C$ is given by $y=(4 x + 1)\\cdot (\\cos{\\left(x \\right)}),$ then the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=4 x + 1$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=4,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(4 x + 1)\\cdot (- \\sin{\\left(x \\right)}) \\\\ &{}+(\\cos{\\left(x \\right)})\\cdot (4)\\end{aligned} \\\\ &=-(4 x + 1)\\sin x+4\\cos x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=\\begin{aligned}&(4 \\left(\\frac{\\pi}{4}\\right) + 1)\\cdot (- \\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)}) \\\\ &{}+(\\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (4)\\end{aligned} \\\\ &=\\begin{aligned}&(1 + \\pi)\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &{}+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (4)\\end{aligned} \\\\ &=\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}.$"}] [{:db/id #edb/ref 17592186610528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a274896-90a4-56a0-b45a-65385719edf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}" :db/id #edb/ref 17592186610520}] :answer-field/correct {:answer/id #uuid "8a274896-90a4-56a0-b45a-65385719edf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}" :db/id #edb/ref 17592186610520} :answer-field/id #uuid "3187eef1-7f80-587b-a0fe-39dc0cb198ff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186610513}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de532b59-dfad-573f-bd25-b6a82e67e141" :question/problem "Given $f(x)=- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}$, if a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}.$\n\nSlope $\\,=$\n{{field-1}}" :question/retired true :question/worked-solution "We differentiate using the product rule. Let $u(x)=x$ and $v(x)=- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=1,\\quad v'(x)=\\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(x)\\cdot (\\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}) \\\\ &{}+(- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)})\\cdot (1)\\end{aligned} \\\\ &=\\begin{aligned}&(x - 3)\\cdot (\\sin{\\left(x \\right)}) \\\\ &{}+(- 3 x - 1)\\cdot (\\cos{\\left(x \\right)})\\end{aligned}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=\\begin{aligned}&(\\left(\\frac{\\pi}{4}\\right))\\cdot (\\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)} - 3 \\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)}) \\\\ &{}+(- 3 \\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)} - \\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (1)\\end{aligned} \\\\ &=\\left(\\frac{\\pi}{4}\\right)\\cdot (- \\sqrt{2})+(- 2 \\sqrt{2})\\cdot (1) \\\\ &=\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}.$"}] [{:db/id #edb/ref 17592186615560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1e78ab-8788-5174-8ffd-7a2cc15b6e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186615555} {:answer/id #uuid "633cee45-d59f-53de-923d-085faddb4ddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186615556} {:answer/id #uuid "7c1183b0-b75b-534f-9f78-973a4bb01276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186615558} {:answer/id #uuid "cf15d09f-7e8e-5f63-801d-3da408b8e869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186615559} {:answer/id #uuid "f8866bcc-2a42-5656-b565-ee15147b562d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186615561}] :answer-field/correct {:answer/id #uuid "2a1e78ab-8788-5174-8ffd-7a2cc15b6e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186615555} :answer-field/id #uuid "691ad0ef-2a57-5243-bdf1-ddb48cf7a828" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186615557}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d5190bc4-2336-5db6-bb75-17e05e48e8ff" :question/problem "If a curve $C$ is given by $y=(2 e^{x})\\cdot (x - 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=2 e^{x}$ and $v(x)=x - 1.$ Then, we have\n\n$$\nu'(x)=2 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(2 e^{x})\\cdot (1)+(x - 1)\\cdot (2 e^{x}) \\\\ &=2 x e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=\\begin{aligned}&(2 e^{(0)})\\cdot (1) \\\\ &{}+((0) - 1)\\cdot (2 e^{(0)})\\end{aligned} \\\\ &=(2)\\cdot (1)+(-1)\\cdot (2) \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$"}] [{:db/id #edb/ref 17592186657591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efedf7e-3d47-5ff8-8014-af7d7f1c524c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657588}] :answer-field/correct {:answer/id #uuid "0efedf7e-3d47-5ff8-8014-af7d7f1c524c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657588} :answer-field/id #uuid "bd6980db-63b9-58a9-a161-58fba5aeb424" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657603}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "50d8c6ab-86f9-5697-89f9-f6bea58cd673" :question/problem "Differentiate ${6}^{x}\\sin(x).$\n\n$(6^{x} \\sin{\\left(x \\right)})'=$ $6^{x} \\ln{\\left(6 \\right)} \\sin{\\left(x \\right)}\\,+$ {{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=6^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(6^{x})'\\cdot (\\sin{\\left(x \\right)}) \\\\ &\\quad +(6^{x})\\cdot (\\sin{\\left(x \\right)})' \\\\ &=(6^{x} \\ln{\\left(6 \\right)})(\\sin{\\left(x \\right)}) \\\\ &\\quad +(6^{x})(\\cos{\\left(x \\right)}) \\\\ &=6^{x} \\ln{\\left(6 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(6^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c2a69dd-025f-5be8-980e-f66236939db9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 e^{x} \\sin{\\left(x \\right)} + 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657589} {:answer/id #uuid "73eeb177-fa56-5e28-88c3-c06d587a93db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 e^{x} \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657593} {:answer/id #uuid "8380cb0c-f99b-5edc-8bcb-df0b4edd19ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 e^{x} \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657596} {:answer/id #uuid "91824e3e-fce8-5d21-847f-ffd4ce485006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 e^{x} \\sin{\\left(x \\right)} - 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657598} {:answer/id #uuid "eee2ca73-2f04-51ce-9964-2aff5fa07bd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 e^{x} \\sin{\\left(x \\right)} - 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657606}] :answer-field/correct {:answer/id #uuid "91824e3e-fce8-5d21-847f-ffd4ce485006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 e^{x} \\sin{\\left(x \\right)} - 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657598} :answer-field/id #uuid "8d02748c-91f7-5ad2-96c0-7d5e682d90af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id