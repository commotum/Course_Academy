29}\\cdot (2a+b) \\\\\n&= \\frac{1}{29}\\cdot \\begin{bmatrix}20 \\\\ -21\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{20}{29} \\\\ - \\frac{21}{29}\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17390a50-909e-519b-b1c9-2fd6e74d5286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501419} {:answer/id #uuid "24652883-4d03-5d3a-94a2-7578f505b356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186501421} {:answer/id #uuid "3e7113a7-4e6f-50a3-ba67-bda8e88e5ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501423} {:answer/id #uuid "b19bb3ae-14c7-59ef-85c7-6d21c84a18fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{195}\\end{bmatrix}" :db/id #edb/ref 17592186501443} {:answer/id #uuid "f5b9b920-4cc5-5a82-a0bb-b0280d83ae64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501450}] :answer-field/correct {:answer/id #uuid "17390a50-909e-519b-b1c9-2fd6e74d5286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501419} :answer-field/id #uuid "af1f73f3-416d-515c-8b21-fd9ed0345370" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501441}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8567289b-a7cd-523c-8ba0-cb8ef5847d98" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}$ and $b=\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/requires-calculator false :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}4 \\\\ -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -6\\end{bmatrix}+\\begin{bmatrix}4 \\\\ -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(4) \\\\ (-6)+(-1)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}4 \\\\ -7\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(4)^2+(-7)^2} \\\\\n&= \\sqrt{65} \\\\\n&= \\sqrt{65}\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{\\sqrt{65}}\\cdot (2a+b) \\\\\n&= \\frac{1}{\\sqrt{65}}\\cdot \\begin{bmatrix}4 \\\\ -7\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4424df-2c27-57d6-b91a-4c769aa3a3d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186501417} {:answer/id #uuid "99a9035c-621d-5f0a-90b1-430b6da30043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501438} {:answer/id #uuid "9fcb7f83-60ae-5fd7-8845-026488417b53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{6}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501439} {:answer/id #uuid "f1867dff-0f88-5922-972b-2e006c5e6a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{39}\\end{bmatrix}" :db/id #edb/ref 17592186501448} {:answer/id #uuid "f5b575f3-1801-524b-a76d-306e898a95d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501449}] :answer-field/correct {:answer/id #uuid "99a9035c-621d-5f0a-90b1-430b6da30043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501438} :answer-field/id #uuid "45c48596-27ed-55c4-8123-7a3960c5a2e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501428}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87c53303-b5c9-58af-aa9e-4eabf0ef314d" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}$ and $b=\\begin{bmatrix}-12 \\\\ -3\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/requires-calculator false :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}-12 \\\\ -3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}-12 \\\\ -3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(-12) \\\\ (-2)+(-3)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-12 \\\\ -5\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(-12)^2+(-5)^2} \\\\\n&= \\sqrt{169} \\\\\n&= 13\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{13}\\cdot (2a+b) \\\\\n&= \\frac{1}{13}\\cdot \\begin{bmatrix}-12 \\\\ -5\\end{bmatrix} \\\\\n&= \\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135f6880-f2d4-57f4-b6c2-f57d76de9846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{123}\\end{bmatrix}" :db/id #edb/ref 17592186501418} {:answer/id #uuid "64d9579b-9034-5d26-9564-05a7d8dfa32d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 40\\end{bmatrix}" :db/id #edb/ref 17592186501430} {:answer/id #uuid "71a98ba4-87aa-5cfb-85c6-16c3b6494b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ - \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501433} {:answer/id #uuid "bc8348aa-d847-507f-b28b-29a3f3e30499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{82} \\\\ \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501445} {:answer/id #uuid "c52d8eab-2ff9-5a8e-b72b-8b924b645da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501446}] :answer-field/correct {:answer/id #uuid "c52d8eab-2ff9-5a8e-b72b-8b924b645da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501446} :answer-field/id #uuid "449fcc00-8553-5455-8f81-e7253900c6b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501427}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9375cd18-2a95-552f-b85a-1ce8d0584d8e" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$ and $b=\\begin{bmatrix}9 \\\\ 38\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/requires-calculator false :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}9 \\\\ 38\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}9 \\\\ 38\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(9) \\\\ (2)+(38)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}9 \\\\ 40\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(9)^2+(40)^2} \\\\\n&= \\sqrt{1681} \\\\\n&= 41\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{41}\\cdot (2a+b) \\\\\n&= \\frac{1}{41}\\cdot \\begin{bmatrix}9 \\\\ 40\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{41}\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72f71719-0fa2-5d74-951f-4a5a6316e2e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{bmatrix}" :db/id #edb/ref 17592186572967} {:answer/id #uuid "76cef696-33d5-53c7-a20a-186993b395fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{6}{\\sqrt{5}} \\\\ -\\frac{3}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186572977} {:answer/id #uuid "c8e40bc8-06c3-562a-83ac-e13c465cde6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{15}} \\\\ -\\frac{1}{\\sqrt{15}}\\end{bmatrix}" :db/id #edb/ref 17592186573076} {:answer/id #uuid "cf3a28aa-2fb3-5f9e-a119-7bce309125f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{6}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}" :db/id #edb/ref 17592186573087} {:answer/id #uuid "ebc2b5a5-a24d-5729-84ca-0b3b24f51964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186573124}] :answer-field/correct {:answer/id #uuid "ebc2b5a5-a24d-5729-84ca-0b3b24f51964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186573124} :answer-field/id #uuid "486b8f01-6945-5809-91a8-88d9d6a85f09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573174}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "54931a2c-0179-55ba-b42e-021e69939399" :question/math-academy-id "q-70415" :question/problem "Let $r=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$ and $s=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}.$ Find a unit vector that is parallel to $3r+2s$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction., we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}3r+2s & =3\\cdot \\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-6)+0 \\\\ 3+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|3r+2s| & =\\sqrt{(-6)^{2}+(-3)^{2}} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, we divide $3r+2s$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|} \\\\  & =\\frac{1}{3\\sqrt{5}}(3r+2s) \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot \\begin{bmatrix}-6 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7001357a-d27f-5f38-bb51-c1671b2f85e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186572963}] :answer-field/correct {:answer/id #uuid "7001357a-d27f-5f38-bb51-c1671b2f85e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186572963} :answer-field/id #uuid "19605a89-6fbc-50e5-80b4-4cc3c9941a36" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573159}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "65c77d8f-4e68-5667-bebf-382cd66bf3e2" :question/math-academy-id "q-320965" :question/problem "![](images/45/453e8fc1c4d8a5262fd0a8aa7341dd71b909a4a72cec94cd2698f800f7dc06c9.png)\n\nLet $A(0,3)$ and $B(4,-1).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OB}=b=4i-j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(4i-j)-(0i+3j) \\\\  & =4i-4j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{4}^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f4878d-2b22-5080-b71d-e44372f2d016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186572833} {:answer/id #uuid "3f5f3505-15b1-548f-bc68-5dc8b5cd1856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186572897} {:answer/id #uuid "87f5f51b-4856-5dc0-b0e5-2f3c355ea3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186572997} {:answer/id #uuid "94a4df81-f598-5b1a-8c7c-7dfe90337b8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186573016} {:answer/id #uuid "c114d74b-8feb-5637-9c93-f0e010981f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186573069}] :answer-field/correct {:answer/id #uuid "3f5f3505-15b1-548f-bc68-5dc8b5cd1856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186572897} :answer-field/id #uuid "20e48ca9-80f3-5bdd-beed-e52606176cac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573161}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "84731c4b-0fa0-51b7-ab58-c2cc224240fc" :question/math-academy-id "q-1307" :question/problem "If $u=⟨2,3⟩$, then what is the magnitude of $u?$" :question/worked-solution "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,u\\,| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(2)^{2}+(3)^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b71bc5a-ea49-5c5c-8189-d231b7b94741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186572854} {:answer/id #uuid "61691c6b-be2a-578a-a95a-691cf407bc55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186572939} {:answer/id #uuid "911f0451-83e2-59cb-94bc-9e71ecca138f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186573011} {:answer/id #uuid "a1d6c940-f208-59e6-abc2-918bb6b4ed48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186573029} {:answer/id #uuid "aec58b42-8779-526c-bd77-df664c625168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186573046}] :answer-field/correct {:answer/id #uuid "aec58b42-8779-526c-bd77-df664c625168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186573046} :answer-field/id #uuid "23f50047-f3e3-54c2-a0eb-ca4d6b6bb3ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573163}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c1db841-92ab-5a9b-b59a-bd03ce09afe3" :question/math-academy-id "q-18057" :question/problem "![](images/b9/b911126b4468e016afbab7faaf20223d0811827bb7f57cdefc2f1923cb7faf1b.png)\n\nPoints $A$ and $C$ are shown in the picture above. Find $|\\overset{\\to }{AC}|.$" :question/worked-solution "From the picture, we obtain $A(0,3)$ and $C(4,0).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OC}=c=4i+0j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AC}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AC} & =\\overset{\\to }{OC}-\\overset{\\to }{OA} \\\\  & =c-a \\\\  & =(4i)-(3j) \\\\  & =4i-3j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AC}| & =\\sqrt{(4)^{2}+(-3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d115c9-84d2-581b-ae54-3c5a392028f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186572849} {:answer/id #uuid "416bf8df-8b35-5b3b-8251-fed7dfc9545a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{31}" :db/id #edb/ref 17592186572901} {:answer/id #uuid "5f6db638-2f62-5677-827d-ee425c9aafcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186572933} {:answer/id #uuid "a3449bba-2a92-58bc-975c-d54b2afa32da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186573033} {:answer/id #uuid "ec43eb77-641f-58c3-9a18-ba04193242f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186573125}] :answer-field/correct {:answer/id #uuid "a3449bba-2a92-58bc-975c-d54b2afa32da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186573033} :answer-field/id #uuid "4f5a668f-140d-5ea6-b6c3-21a8cbb8bfc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573178}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9c74dff8-a34c-5a12-a8c0-881272406626" :question/math-academy-id "q-1326" :question/problem "If $u=⟨-3,-5⟩$, then what is the magnitude of $u?$" :question/worked-solution "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,u\\,| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(-5)^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "200a4d21-812f-5dd9-a1e8-34e8c33d93df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186572861}] :answer-field/correct {:answer/id #uuid "200a4d21-812f-5dd9-a1e8-34e8c33d93df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186572861} :answer-field/id #uuid "f71eec51-55f5-5ed3-a5a6-c93f3bce746d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573247}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a88ebacd-81cc-571b-8835-0aed7b200fdc" :question/math-academy-id "q-320964" :question/problem "![](images/cf/cf7890789d1b80002ac2055fd61e8c8f58525f9bb1714bd77ff6e8542567e962.png)\n\nLet $A(-2,0)$ and $B(3,3).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=-2i+0j, \\\\  & \\overset{\\to }{OB}=b=3i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(3i+3j)-(-2i+0j) \\\\  & =5i+3j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{5}^{2}+{3}^{2}} \\\\  & =\\sqrt{25+9} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111fbb05-f522-5735-8207-38753554e5cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{55}" :db/id #edb/ref 17592186572842} {:answer/id #uuid "60bf083e-3a33-524b-9653-f2ca3d265df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{53}" :db/id #edb/ref 17592186572937} {:answer/id #uuid "951751dc-25fa-54f0-bb3e-3f6f69037922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{50}" :db/id #edb/ref 17592186573018} {:answer/id #uuid "f2a9e490-80bb-5877-8dc0-511713e73021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{56}" :db/id #edb/ref 17592186573132} {:answer/id #uuid "f9e1c41a-04cb-544b-8889-aaf571180749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{52}" :db/id #edb/ref 17592186573141}] :answer-field/correct {:answer/id #uuid "60bf083e-3a33-524b-9653-f2ca3d265df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{53}" :db/id #edb/ref 17592186572937} :answer-field/id #uuid "837da19e-bdf7-595c-b9f5-dac18fb60790" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573196}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aee063d1-50f9-564e-a7e9-bfddcd038224" :question/math-academy-id "q-17616" :question/problem "Let $a=⟨-2,7⟩.$ Find $|\\,a\\,|.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+(7)^{2}} \\\\  & =\\sqrt{4+49} \\\\  & =\\sqrt{53}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29691489-fe06-51db-9613-0837b0228553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186572874} {:answer/id #uuid "3b6bb977-d9f3-5ac7-aa36-12e676435303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186572889} {:answer/id #uuid "a8dc62f1-9b87-5c5f-bcbc-3dc1a7455c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186573039} {:answer/id #uuid "d4da40ff-148d-5e81-bb1e-7550030dcf49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186573096} {:answer/id #uuid "f99c4b85-6ca6-540b-bc9f-de4142e72920" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186573140}] :answer-field/correct {:answer/id #uuid "3b6bb977-d9f3-5ac7-aa36-12e676435303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186572889} :answer-field/id #uuid "75e5c39a-4f29-5171-b743-cd598384ab3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573190}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de84f93a-9a95-5709-8b3a-1c7aaa638199" :question/math-academy-id "q-1330" :question/problem "Let $\\overset{\\to }{U}=⟨7,-1⟩.$ Find $|\\,\\overset{\\to }{U}|.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,\\overset{\\to }{U}| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{49+1} \\\\  & =\\sqrt{50} \\\\  & =\\sqrt{25\\cdot 2} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1069ee09-17b5-57ab-aab5-38e6b996e90c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{3}{2\\sqrt{5}} \\\\ -\\frac{3}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186572841} {:answer/id #uuid "20e6eaac-82d9-5705-8448-025257524e8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{5\\sqrt{3}} \\\\ -\\frac{2}{5\\sqrt{3}}\\end{bmatrix}" :db/id #edb/ref 17592186572863} {:answer/id #uuid "79a93776-a59c-5551-bd4b-8aac720a2d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186572980} {:answer/id #uuid "a81428f3-9e59-5a07-9500-76476f5034a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{3}{\\sqrt{5}} \\\\ -\\frac{6}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186573037} {:answer/id #uuid "acc576d0-0654-519c-b96b-6398ec344ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{3}{5\\sqrt{3}} \\\\ -\\frac{6}{5\\sqrt{3}}\\end{bmatrix}" :db/id #edb/ref 17592186573044}] :answer-field/correct {:answer/id #uuid "79a93776-a59c-5551-bd4b-8aac720a2d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186572980} :answer-field/id #uuid "ad9dfc42-a7b2-570f-831f-bdb8b850c4c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573211}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "efcda90e-97e9-5de4-ab6e-f342fb013418" :question/math-academy-id "q-125137" :question/problem "Let $r=\\begin{bmatrix}-3 \\\\ -6\\end{bmatrix}.$ Find a unit vector that is parallel to $r$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{r}{|\\,r\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,r\\,| & =\\sqrt{(-3)^{2}+(-6)^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, we divide $r$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{r}{|r|} \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot r \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot \\begin{bmatrix}-3 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186584343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bf17541-6b09-5cc5-94b8-7cb25f026248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{20}" :db/id #edb/ref 17592186583919} {:answer/id #uuid "74cbcd82-36ac-55be-bfc3-e3e2127b2f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186583969} {:answer/id #uuid "798f72d7-f7e0-5c39-91c8-5f000feb5735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{29}" :db/id #edb/ref 17592186583974} {:answer/id #uuid "bb4657e8-6fbf-5afe-bca0-fb51946dad68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186584100} {:answer/id #uuid "d70d5d24-1049-5288-8c76-dde73c158274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186584155}] :answer-field/correct {:answer/id #uuid "74cbcd82-36ac-55be-bfc3-e3e2127b2f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186583969} :answer-field/id #uuid "1ee64485-d25e-5ed7-9103-cde5dee2e997" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584242}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "26f0950f-ad4a-5c9a-89c9-e7428553cbe6" :question/math-academy-id "q-18050" :question/problem "![](images/08/08d900690b841d132b3451ca7f8e5013ee1e9a5383c541c926f9e921639d0e5f.png)\n\nLet $C(0,2)$ and $D(4,-1).$ Find $|\\overset{\\to }{CD}|.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OC}=c=0i+2j, \\\\  & \\overset{\\to }{OD}=d=4i-j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{CD}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =\\overset{\\to }{OD}-\\overset{\\to }{OC} \\\\  & =d-c \\\\  & =(4i-j)-(2j) \\\\  & =4i-3j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{CD}| & =\\sqrt{{4}^{2}+(-3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186584366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35fa558b-aa2a-5d08-a194-8fd3ca139bdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186583859} {:answer/id #uuid "893b8ba7-3a08-5fd1-aa2d-6dd433e4aa6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186584007} {:answer/id #uuid "badf4824-0416-5e42-8834-627bdd52d646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186584097} {:answer/id #uuid "c2ec1cbe-3b55-507f-b858-8a815c5efcd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186584123} {:answer/id #uuid "fb754ecd-45fc-5648-9b8a-8a4bb4ddbb15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{29}" :db/id #edb/ref 17592186584217}] :answer-field/correct {:answer/id #uuid "c2ec1cbe-3b55-507f-b858-8a815c5efcd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186584123} :answer-field/id #uuid "126dbc04-4a65-52ba-bb07-cd51a75ba54f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584236}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54a79ae6-82dd-5ed3-9588-7bbba919c89c" :question/math-academy-id "q-18054" :question/problem "![](images/89/8927e58849984fbb42a7a3856e3b3509b9729b65031e066d29c6f94747ee5b6b.png)\n\nPoints $C$ and $D$ are shown in the picture above. Find $|\\overset{\\to }{CD}|.$" :question/worked-solution "From the picture, we obtain $C(-3,4)$ and $D(2,3).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OC}=c=-3i+4j, \\\\  & \\overset{\\to }{OD}=d=2i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{CD}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =\\overset{\\to }{OD}-\\overset{\\to }{OC} \\\\  & =d-c \\\\  & =(2i+3j)-(-3i+4j) \\\\  & =5i-j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{CD}| & =\\sqrt{{5}^{2}+(-1)^{2}} \\\\  & =\\sqrt{25+1} \\\\  & =\\sqrt{26}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186584387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1740c703-f90f-5674-ac6e-423ee4f3314c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186583820} {:answer/id #uuid "5c7c2d6d-0694-5f38-821e-a9938ec588af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186583921} {:answer/id #uuid "86e5e800-6afc-5f3b-b460-1cbed73b9940" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{8}" :db/id #edb/ref 17592186584000} {:answer/id #uuid "a87bbc15-19fe-5b49-8bf9-b8b6ca154c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186584057} {:answer/id #uuid "dd4827d9-8352-53ac-a685-59bb5ead1116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186584164}] :answer-field/correct {:answer/id #uuid "1740c703-f90f-5674-ac6e-423ee4f3314c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186583820} :answer-field/id #uuid "9eed13a4-9538-5f5e-a98e-a12132d3cc3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584291}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8dcc134b-6901-5ba4-a2f2-302111421e92" :question/math-academy-id "q-1308" :question/problem "If $a=⟨-3,5⟩$, then what is the magnitude of $a?$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(5)^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186609024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeed51cb-f47a-5b61-a15b-6ef51556cd9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{25}{6} \\\\ \\frac{\\sqrt{11}}{6}\\end{bmatrix}" :db/id #edb/ref 17592186608700} {:answer/id #uuid "ba16b1b0-64a4-55b7-95db-3692a2c064c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{\\sqrt{35}} \\\\ \\frac{11}{\\sqrt{35}}\\end{bmatrix}" :db/id #edb/ref 17592186608725} {:answer/id #uuid "d4180e23-b0af-5b27-8407-4737674c0f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{6} \\\\ \\frac{\\sqrt{11}}{6}\\end{bmatrix}" :db/id #edb/ref 17592186608770} {:answer/id #uuid "f098feb2-cb07-5f74-93ba-dfda93662182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{11}}{6} \\\\ \\frac{\\sqrt{5}}{6}\\end{bmatrix}" :db/id #edb/ref 17592186608812} {:answer/id #uuid "f45240a3-2476-5bbf-8882-733133c52c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{2\\sqrt{6}} \\\\ \\frac{11}{2\\sqrt{6}}\\end{bmatrix}" :db/id #edb/ref 17592186608818}] :answer-field/correct {:answer/id #uuid "d4180e23-b0af-5b27-8407-4737674c0f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{6} \\\\ \\frac{\\sqrt{11}}{6}\\end{bmatrix}" :db/id #edb/ref 17592186608770} :answer-field/id #uuid "cb26c284-82e3-5e79-8093-c2b8b99da1c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608915}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f78113c4-93c4-50ec-8ba9-e20f334b9b91" :question/math-academy-id "q-70419" :question/problem "Let $t=\\begin{bmatrix}-1 \\\\ \\sqrt{11}\\end{bmatrix}$ and $v=\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}.$ Find a unit vector that is parallel to $t+2v$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{t+2v}{|t+2v|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}t+2v & =\\begin{bmatrix}-1 \\\\ \\sqrt{11}\\end{bmatrix}+2\\cdot \\begin{bmatrix}3 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ \\sqrt{11}\\end{bmatrix}+\\begin{bmatrix}6 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1+6 \\\\ \\sqrt{11}+0\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ \\sqrt{11}\\end{bmatrix}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|t+v| & =\\sqrt{{5}^{2}+(\\sqrt{11})^{2}} \\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$\n\nFinally, we divide $t+2v$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{t+2v}{|t+2v|} \\\\  & =\\frac{1}{6}(t+2v) \\\\  & =\\frac{1}{6}\\cdot \\begin{bmatrix}5 \\\\ \\sqrt{11}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{6} \\\\ \\frac{\\sqrt{11}}{6}\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186622023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26774831-e6ef-5534-9071-f317c80dad1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\sqrt{11}" :db/id #edb/ref 17592186622027} {:answer/id #uuid "47437656-12d4-5c5a-abd3-3dc958286cc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :an