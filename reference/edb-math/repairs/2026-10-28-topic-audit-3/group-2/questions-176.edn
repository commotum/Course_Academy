 "a8eaa732-503b-5d3e-9400-adc2a8028bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\sqrt{5}" :db/id #edb/ref 17592186501362} {:answer/id #uuid "afe02226-de3c-552f-bc03-c7afecf61b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186501364} {:answer/id #uuid "c91c20b6-0c18-5ae8-ba08-4ddadb442e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186501368}] :answer-field/correct {:answer/id #uuid "552951ba-838c-563a-a702-f44f6524104a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\sqrt{17}" :db/id #edb/ref 17592186501354} :answer-field/id #uuid "3bd46d81-0236-582b-868f-f4e59aa85b3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501351}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f0caf898-ce5d-5506-b145-31d60aeb15df" :question/problem "If $v = ⟨16,-4⟩$, then what is the magnitude of $v$?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}\n\\mid v \\mid &= \\sqrt{v_{x}^{2} + v_{y}^{2}} \\\\\n&= \\sqrt{(16)^{2} + (-4)^{2}} \\\\\n&= \\sqrt{256 + 16} \\\\\n&= \\sqrt{272} \\\\\n&= 4 \\sqrt{17}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0445042e-54ee-545e-a3f8-732df318f4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186501380} {:answer/id #uuid "0490c650-33f4-5c2c-b521-fe9b1e566ec1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15 \\sqrt{2}" :db/id #edb/ref 17592186501381} {:answer/id #uuid "6ddf7c05-e687-5019-