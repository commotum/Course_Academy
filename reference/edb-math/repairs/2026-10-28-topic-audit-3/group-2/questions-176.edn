:answer/id #uuid "fb4bdbac-dae8-512d-9f28-a6d1ca641844" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186057123} {:answer/id #uuid "5c31b652-4b6c-5d88-8099-aa3b8dbea173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186057124} {:answer/id #uuid "70729c42-11e6-5309-82bb-19226d272451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186057125}] :answer-field/id #uuid "21f89363-a985-51cc-946e-14f2aa27f506" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057120}] :question/id #uuid "6a56ae9f-24f2-57fe-8fdd-fdcdaeb8e97e" :question/math-academy-id "q-18051" :question/problem "![](images/2c/2c1f9580f07d06af7ec900ee63c95872e06f459107e64cf1b5117d928efdab22.png)\n\nLet $A(-4, 1)$ and $B(3, 0)$. Find $\\mid AB^(→) \\mid$."}] [{:db/id #edb/ref 17592186060128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "859a4033-c7be-5ff5-af88-1823e959391b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{27}" :db/id #edb/ref 17592186057127} {:answer/id #uuid "ad6482c5-d423-5cfa-b5c4-60571c0a06c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{23}" :db/id #edb/ref 17592186057128} {:answer/id #uuid "e1496379-7a78-53b1-8d89-c51305772b95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186057129} {:answer/id #uuid "e7ded905-451e-5e8d-87f6-0bff47652269" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186057130} {:answer/id #uuid "4818a873-c410-58c3-9fa9-c071285aa2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186057131}] :answer-field/id #uuid "60525c6f-c622-5ce0-b076-32a8f28ba4a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057126}] :question/id #uuid "1c261405-1fb7-5f8f-992e-8a8c19696484" :question/math-academy-id "q-18052" :question/problem "![](images/0d/0d92a4d7b9c59b0d6bc8ffec9926bcf189c9bbe808c5bed7a02d6ab09bcebcd0.png)\n\nLet $P(-2, 2)$ and $Q(3, 3)$. Find $\\mid PQ^(→) \\mid$."}] [{:db/id #edb/ref 17592186060129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b3339c8-cfee-5d1c-ad46-ab44efd7b6e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{73}} \\\\ \\frac{3}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057133} {:answer/id #uuid "96688b3e-d471-54f6-8aec-c73d555b7226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{77}} \\\\ \\frac{8}{\\sqrt{77}}\\end{bmatrix}" :db/id #edb/ref 17592186057134} {:answer/id #uuid "c2e8a09e-3906-503f-9e9f-3e6c5b353823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{\\sqrt{73}} \\\\ \\frac{3}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057135} {:answer/id #uuid "29a80b65-88dd-51a4-baa0-c738950c1264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{73}} \\\\ \\frac{8}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057136} {:answer/id #uuid "401e5f5b-5db4-522a-9b7a-11b15f373032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{76}} \\\\ \\frac{8}{\\sqrt{76}}\\end{bmatrix}" :db/id #edb/ref 17592186057137}] :answer-field/id #uuid "f8820177-fcee-5d33-9928-79e84e800cd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057132}] :question/id #uuid "bfe76e58-e39f-55e9-9d8c-8f6cb0fc0443" :question/math-academy-id "q-18058" :question/problem "Let $a = \\begin{bmatrix}3 \\\\ 8\\end{bmatrix}$. Find a unit vector that is parallel to $a$ and points the same direction."}] [{:db/id #edb/ref 17592186233366 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "02dcce11-c60f-5753-ba12-d8ce046f2ae1" :question/math-academy-id "q-125118" :question/problem "![](images/f3/f35a3ad730621023ec86e5727588fc86083ee500b3a72c55ab2808bd290019e9.png)\n\nLet $P(1,2)$ and $Q(-2,1).$ Find $|\\overset{\\to }{PQ}|.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OP}=p=i+2j, \\\\  & \\overset{\\to }{OQ}=q=-2i+j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{PQ}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =q-p \\\\  & =(-2i+j)-(i+2j) \\\\  & =-3i-j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{PQ}| & =\\sqrt{(-3)^{2}+(-1)^{2}} \\\\  & =\\sqrt{9+1} \\\\  & =\\sqrt{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0602d7a4-2911-50a7-8931-1b4bc528c19a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} \\\\ -\\frac{3}{10}\\end{bmatrix}" :db/id #edb/ref 17592186411685} {:answer/id #uuid "3c5b6bc3-0505-592d-8bbe-21764c037dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{\\sqrt{5}} \\\\ -\\frac{6}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186411711} {:answer/id #uuid "74dbb49a-6f69-59c5-ab9c-6bf2f84350df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186411739} {:answer/id #uuid "8c50ba8e-c157-5ca3-9288-576321916d2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{\\sqrt{10}} \\\\ -\\frac{6}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186411752} {:answer/id #uuid "dda19a54-ac15-5715-b0ab-0a3f1c4ff8ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{5} \\\\ -\\frac{3}{10}\\end{bmatrix}" :db/id #edb/ref 17592186411801}] :answer-field/correct {:answer/id #uuid "74dbb49a-6f69-59c5-ab9c-6bf2f84350df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186411739} :answer-field/id #uuid "760bc6eb-d6bd-5bc8-a1ad-d57d71d59023" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411832}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eff15426-c7b2-53a2-8441-6bacd0c6dc45" :question/math-academy-id "q-125135" :question/problem "Let $b=\\begin{bmatrix}8 \\\\ -6\\end{bmatrix}.$ Find a unit vector that is parallel to $b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|\\,b\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,b\\,| & =\\sqrt{{8}^{2}+(-6)^{2}} \\\\  & =\\sqrt{64+36} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$\n\nFinally, we divide $b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|b|} \\\\  & =\\frac{1}{10}\\cdot b \\\\  & =\\frac{1}{10}\\cdot \\begin{bmatrix}8 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233368 :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "06094a0c-ab74-504d-9e7a-29ff1a469a1b" :question/math-academy-id "q-125138" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}$ and $b=\\begin{bmatrix}5 \\\\ 8\\end{bmatrix}.$ Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}2a+b & =2\\cdot \\begin{bmatrix}0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}5 \\\\ 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}5 \\\\ 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}0+5 \\\\ 4+8\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ 12\\end{bmatrix}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|2a+b| & =\\sqrt{{5}^{2}+{12}^{2}} \\\\  & =\\sqrt{169} \\\\  & =13.\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|} \\\\  & =\\frac{1}{13}(2a+b) \\\\  & =\\frac{1}{13}\\cdot \\begin{bmatrix}5 \\\\ 12\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{13} \\\\ \\frac{12}{13}\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233594 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b8c6e450-fe10-5923-accc-8b824e3c81c1" :question/math-academy-id "q-18047" :question/problem "Let $a=⟨5,9⟩.$ Find $|\\,a\\,|.$" :question/worked-solution "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(5)^{2}+(9)^{2}} \\\\  & =\\sqrt{25+81} \\\\  & =\\sqrt{106}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233595 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "26fce79e-92f6-594d-aec2-af45c6145c5c" :question/math-academy-id "q-18048" :question/problem "if $a=⟨-4,8⟩$, then  what is the magnitude of  $a?$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+(8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =\\sqrt{16\\cdot 5} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233596 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6f7008d-b645-50b0-a00b-9cf227ed2ff3" :question/math-academy-id "q-18049" :question/problem "![](images/1a/1a250499768a91e3e225a05d141e42d7ed89168ba82c5560777f64b8b29fac4a.png)\n\nLet $C(-1,3)$ and $D(1,-2).$ Find $|\\overset{\\to }{CD}|.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OC}=c=-i+3j, \\\\  & \\overset{\\to }{OD}=d=i-2j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{CD}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =\\overset{\\to }{OD}-\\overset{\\to }{OC} \\\\  & =d-c \\\\  & =(i-2j)-(-i+3j) \\\\  & =2i-5j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{CD}| & =\\sqrt{{2}^{2}+(-5)^{2}} \\\\  & =\\sqrt{4+25} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233598 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c14ed0ed-41e3-5534-b77e-503efe93d887" :question/math-academy-id "q-18055" :question/problem "![](images/1e/1e3e9c336bf85cf0f19b2326f12c5fd986fee5b0aae65b8d79257ea234efee13.png)\n\nPoints $P$ and $Q$ are shown in the picture above. Find $|\\overset{\\to }{PQ}|.$" :question/worked-solution "From the picture, we obtain $P(1,1)$ and $Q(2,3).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OP}=p=i+j, \\\\  & \\overset{\\to }{OQ}=q=2i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{PQ}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =q-p \\\\  & =(2i+3j)-(i+j) \\\\  & =i+2j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{PQ}| & =\\sqrt{{1}^{2}+(2)^{2}} \\\\  & =\\sqrt{1+4} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234271 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "af9476c9-5aa2-526b-87d4-a82f7e7eeb39" :question/math-academy-id "q-70409" :question/problem "Let $n=\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}.$ Find a unit vector that is parallel to $n$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|\\,n\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|n| & =\\sqrt{{5}^{2}+{4}^{2}} \\\\  & =\\sqrt{41}.\\end{aligned}\n$$\n\nFinally, we divide $n$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|n|} \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot n \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot \\begin{bmatrix}5 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{\\sqrt{41}} \\\\ \\frac{4}{\\sqrt{41}}\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "079b9a79-06f2-5db8-b532-db1a9740e2a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186501340} {:answer/id #uuid "16cda31a-522e-5e9a-a392-a12fa93be895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 \\sqrt{17}" :db/id #edb/ref