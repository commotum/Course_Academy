-a7e3-528c-ad38-0a25fa0c06e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439473} {:answer/id #uuid "c1e62795-ea37-5a2c-a40d-79165b1c9fc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439474}] :answer-field/correct {:answer/id #uuid "c1e62795-ea37-5a2c-a40d-79165b1c9fc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439474} :answer-field/id #uuid "1a16e752-a6da-51f5-a176-d4c86eab7b66" :answer-field/key "$k=\\sqrt{6}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440094} {:answer-field/choices [{:answer/id #uuid "9817eb20-9e99-5e90-bece-d6fd670b6f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439475} {:answer/id #uuid "49451522-b542-50df-a0e5-8b97f2634208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439476}] :answer-field/correct {:answer/id #uuid "9817eb20-9e99-5e90-bece-d6fd670b6f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439475} :answer-field/id #uuid "a7148c9c-1bda-595b-a2c5-e6841ac127f2" :answer-field/key "$k=6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440095}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41e53fe4-b06e-5150-a976-5badf29f5d4c" :question/math-academy-id "q-128461" :question/problem "Find $k$ given that the vectors $a=⟨{k}^{2},7,4⟩,$ $b=⟨6,7,4⟩,$ and $c=⟨3,0,2⟩$ are coplanar.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}{k}^{2} & 7 & 4 \\\\ 6 & 7 & 4 \\\\ 3 & 0 & 2\\end{vmatrix} \\\\  & ={k}^{2}\\cdot \\begin{vmatrix}7 & 4 \\\\ 0 & 2\\end{vmatrix}-7\\cdot \\begin{vmatrix}6 & 4 \\\\ 3 & 2\\end{vmatrix}+4\\cdot \\begin{vmatrix}6 & 7 \\\\ 3 & 0\\end{vmatrix} \\\\  & ={k}^{2}(7\\cdot 2-0\\cdot 4)-7(6\\cdot 2-3\\cdot 4)+4(6\\cdot 0-3\\cdot 7) \\\\  & =14{k}^{2}+0-84 \\\\  & =14{k}^{2}-84 \\\\  & =14({k}^{2}-6).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 14({k}^{2}-6) & =0 \\\\ {k}^{2}-6 & =0 \\\\ {k}^{2} & =6 \\\\ k & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\sqrt{6}$ or $k=\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186459212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "993b3b03-f3d6-5055-808b-fcb8eae46a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186458894}] :answer-field/correct {:answer/id #uuid "993b3b03-f3d6-5055-808b-fcb8eae46a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186458894} :answer-field/id #uuid "09c71cbe-d318-5b84-9c56-0344d5f8371b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459088}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1a41586e-8435-5507-a7ef-851c0478678b" :question/math-academy-id "q-281027" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(3,1,2),$ $B(0,5,0),$ $C(3,3,1),$ and $D(1,4,2).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(5j)-(3i+1j+2k) \\\\  & =-3i+4j-2k \\\\  & =⟨-3,4,-2⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+3j+1k)-(3i+1j+2k) \\\\  & =2j-1k \\\\  & =⟨0,2,-1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(1i+4j+2k)-(3i+1j+2k) \\\\  & =-2i+3j \\\\  & =⟨-2,3,0⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}-3 & 4 & -2 \\\\ 0 & 2 & -1 \\\\ -2 & 3 & 0\\end{vmatrix} \\\\  & =-3\\cdot \\begin{vmatrix}2 & -1 \\\\ 3 & 0\\end{vmatrix}-4\\cdot \\begin{vmatrix}0 & -1 \\\\ -2 & 0\\end{vmatrix}+(-2)\\cdot \\begin{vmatrix}0 & 2 \\\\ -2 & 3\\end{vmatrix} \\\\  & =-3(2\\cdot 0-(-1)(3))-4(0\\cdot 0-(-1)(-2))+(-2)(0\\cdot 3-2\\cdot (-2)) \\\\  & =-3(3)-4(-2)-2(4) \\\\  & =-9-8+8 \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-9|=9.\n$$"}] [{:db/id #edb/ref 17592186459217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255146d3-f1ae-58a0-bbc3-4ee1dacf192e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186458703}] :answer-field/correct {:answer/id #uuid "255146d3-f1ae-58a0-bbc3-4ee1dacf192e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186458703} :answer-field/id #uuid "8056469f-7633-5bdb-aee2-dd21051fcade" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459142}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "250fb4d2-3fa7-5b45-a7da-bbdf1bb4b98b" :question/math-academy-id "q-280323" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(1,1,1),$ $B(2,3,4),$ $C(-1,2,0),$ and $D(3,0,5).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i+3j+4k)-(i+j+k) \\\\  & =i+2j+3k \\\\  & =⟨1,2,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-i+2j)-(i+j+k) \\\\  & =-2i+j-k \\\\  & =⟨-2,1,-1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i+5k)-(i+j+k) \\\\  & =2i-j+4k \\\\  & =⟨2,-1,4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}1 & 2 & 3 \\\\ -2 & 1 & -1 \\\\ 2 & -1 & 4\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}1 & -1 \\\\ -1 & 4\\end{vmatrix}-2\\cdot \\begin{vmatrix}-2 & -1 \\\\ 2 & 4\\end{vmatrix}+3\\cdot \\begin{vmatrix}-2 & 1 \\\\ 2 & -1\\end{vmatrix} \\\\  & =1(1\\cdot 4-(-1)\\cdot (-1))-2((-2)\\cdot 4-(-1)\\cdot 2)+3((-2)\\cdot (-1)-1\\cdot 2) \\\\  & =1(4-1)-2(-8+2)+3(2-2) \\\\  & =3+12+0 \\\\  & =15.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|15|=15.\n$$"}] [{:db/id #edb/ref 17592186459221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a3758c-f60c-5dae-92fa-afedc78160ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186458653} {:answer/id #uuid "1c111100-d619-5b93-b482-b6ec810b8df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186458679} {:answer/id #uuid "3f06b20c-1420-5939-96cc-465d37b4df29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186458746} {:answer/id #uuid "856f42a7-be02-543a-b498-4b18fecdaca0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}" :db/id #edb/ref 17592186458860} {:answer/id #uuid "96678253-6e22-571e-98ff-a64d81bbbdd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186458889}] :answer-field/correct {:answer/id #uuid "96678253-6e22-571e-98ff-a64d81bbbdd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186458889} :answer-field/id #uuid "0ef466f3-b445-5f7c-961a-8d3a58c07b04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459092}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2eedb023-f05d-5365-a7fb-580375aea9cb" :question/math-academy-id "q-128442" :question/problem "Find $k$ given that the vectors $p=⟨5,-2,2⟩,$ $q=⟨3,k,1⟩,$ and $r=⟨-8,3,-4⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =\\begin{vmatrix}5 & -2 & 2 \\\\ 3 & k & 1 \\\\ -8 & 3 & -4\\end{vmatrix} \\\\  & =5\\cdot \\begin{vmatrix}k & 1 \\\\ 3 & -4\\end{vmatrix}-(-2)\\cdot \\begin{vmatrix}3 & 1 \\\\ -8 & -4\\end{vmatrix}+2\\cdot \\begin{vmatrix}3 & k \\\\ -8 & 3\\end{vmatrix} \\\\  & =5(k\\cdot (-4)-3\\cdot 1)+2(3\\cdot (-4)-(-8)\\cdot 1)+2(3\\cdot 3-(-8)\\cdot k) \\\\  & =-20k-15-8+18+16k \\\\  & =-4k-5.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ -4k-5 & =0 \\\\ k & =-\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{5}{4}.$"}] [{:db/id #edb/ref 17592186459239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4745fa01-7267-5d7d-80a7-da776c08b11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186458758} {:answer/id #uuid "6a6770d3-5bd6-55b6-b578-032b42984508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186458815} {:answer/id #uuid "87767553-4117-55d5-ab34-eebfa1e2b999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186458866} {:answer/id #uuid "9b91be34-01c4-5335-b541-f723bc434b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186458902} {:answer/id #uuid "9e493727-fb30-528b-be73-42746650771c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186458905}] :answer-field/correct {:answer/id #uuid "4745fa01-7267-5d7d-80a7-da776c08b11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186458758} :answer-field/id #uuid "cffe9ad2-0939-5976-9d7b-05a76872555a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459180}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5208cfc4-b7ed-5787-b174-631ca841e3f7" :question/math-academy-id "q-128486" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(8,0,5),$ $B(8,-3,3),$ $C(5,2,5),$ and $D(7,-1,4).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(8i-3j+3k)-(8i+5k) \\\\  & =-3j-2k \\\\  & =⟨0,-3,-2⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(5i+2j+5k)-(8i+5k) \\\\  & =-3i+2j \\\\  & =⟨-3,2,0⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(7i-j+4k)-(8i+5k) \\\\  & =-i-j-k \\\\  & =⟨-1,-1,-1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}0 & -3 & -2 \\\\ -3 & 2 & 0 \\\\ -1 & -1 & -1\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}2 & 0 \\\\ -1 & -1\\end{vmatrix}-(-3)\\cdot \\begin{vmatrix}-3 & 0 \\\\ -1 & -1\\end{vmatrix}+(-2)\\cdot \\begin{vmatrix}-3 & 2 \\\\ -1 & -1\\end{vmatrix} \\\\  & =0+3((-3)\\cdot (-1)-(-1)\\cdot 0)-2((-3)\\cdot (-1)-(-1)\\cdot 2) \\\\  & =9-10 \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-1|=1.\n$$"}] [{:db/id #edb/ref 17592186459261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24585c6e-39f5-5de1-bfc1-0173664ae181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186458701} {:answer/id #uuid "5b8513cd-ab93-5f19-bf47-89063e84a0d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186458780} {:answer/id #uuid "8e663096-bc65-50c5-bf7a-24f45672c008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186458875} {:answer/id #uuid "9ba547f4-f014-5db1-b028-89db94f43cf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186458903} {:answer/id #uuid "b050aca3-3130-5bde-8b37-6ba509d74c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "73" :db/id #edb/ref 17592186458944}] :answer-field/correct {:answer/id #uuid "9ba547f4-f014-5db1-b028-89db94f43cf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186458903} :answer-field/id #uuid "fe68fa49-351f-5bc9-8911-9305bb6e6c31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459202}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8fcc06ee-9e96-5a19-8006-dabebc81e1fc" :question/math-academy-id "q-42055" :question/problem "Calculate the volume of the parallelepiped spanned by $a=⟨-1,2,5⟩$, $b=⟨1,-4,2⟩$ and $c=⟨0,5,1⟩.$" :question/worked-solution "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}-1 & 2 & 5 \\\\ 1 & -4 & 2 \\\\ 0 & 5 & 1\\end{vmatrix} \\\\  & =(-1)\\cdot \\begin{vmatrix}-4 & 2 \\\\ 5 & 1\\end{vmatrix}-2\\cdot \\begin{vmatrix}1 & 2 \\\\ 0 & 1\\end{vmatrix}+5\\cdot \\begin{vmatrix}1 & -4 \\\\ 0 & 5\\end{vmatrix} \\\\  & =-((-4)\\cdot 1-5\\cdot 2)-2(1\\cdot 1-0\\cdot 2)+5(1\\cdot 5-0\\cdot (-4)) \\\\  & =14-2+25 \\\\  & =37\\end{aligned}\n$$\n\n    \n\nFinally, we take the absolute value. So the volume of the corresponding parallelepiped is\n\n$$\nV=|37|=37.\n$$"}] [{:db/id #edb/ref 17592186459264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2edcbb95-8455-53f6-ab2b-7ee4b7636b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{48}{89}" :db/id #edb/ref 17592186458720} {:answer/id #uuid "952a2910-c243-5005-89e0-a85dc85a351b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186458888} {:answer/id #uuid "b7055a4c-b19c-53cc-bd20-a53224e1ac3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{48}{89}" :db/id #edb/ref 17592186458958} {:answer/id #uuid "d351447b-72b1-5263-b183-d42c3b9c1db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186458996} {:answer/id #uuid "fb3fdd87-8f4b-5ed1-abd8-52ae4ff972fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186459073}] :answer-field/correct {:answer/id #uuid "fb3fdd87-8f4b-5ed1-abd8-52ae4ff972fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186459073} :answer-field/id #uuid "20c78fd9-b62d-5bc1-a554-90d9058aa00b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459098}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1fc629c-e7ef-51c7-b925-1dba79c32351" :question/math-academy-id "q-128457" :question/problem "Find $t$ given that the vectors $p=⟨9,9,-2⟩,$ $q=⟨5,6,0⟩,$ and $r=⟨4,t,t⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =\\begin{vmatrix}9 & 9 & -2 \\\\ 5 & 6 & 0 \\\\ 4 & t & t\\end{vmatrix} \\\\  & =9\\cdot \\begin{vmatrix}6 & 0 \\\\ t & t\\end{vmatrix}-9\\cdot \\begin{vmatrix}5 & 0 \\\\ 4 & t\\end{vmatrix}+(-2)\\cdot \\begin{vmatrix}5 & 6 \\\\ 4 & t\\end{vmatrix} \\\\  & =9(6\\cdot t-t\\cdot 0)-9(5\\cdot t-4\\cdot 0)-2(5\\cdot t-4\\cdot 6) \\\\  & =54t-45t-10t+48 \\\\  & =48-t.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 48-t & =0 \\\\ t & =48\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=48.$"}] [{:db/id #edb/ref 17592186459275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4c55ab-5c11-591a-ae51-5858bb8b481e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186458638} {:answer/id #uuid "14ba0b46-50bc-55aa-8afd-659259db34e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186458662} {:answer/id #uuid "742d97ab-9f7c-5567-8851-19c88e61766c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46" :db/id #edb/ref 17592186458832} {:answer/id #uuid "89d83a6d-9b11-560d-9b1f-652553495081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186458871} {:answer/id #uuid "fdb99b8e-8f53-513e-9d9d-5f7e24a3cbd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186459079}] :answer-field/correct {:answer/id #uuid "fdb99b8e-8f53-513e-9d9d-5f7e24a3cbd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186459079} :answer-field/id #uuid "2515701c-5375-5820-8a2d-3a0891924183" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459100}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b387009d-e229-5370-99a6-bec87fcc7e69" :question/math-academy-id "q-42053" :question/problem "Calculate the volume of the parallelepiped spanned by $a=⟨1,2,4⟩$, $b=⟨3,5,-7⟩$ and $c=⟨1,0,2⟩.$" :question/worked-solution "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}1 & 2 & 4 \\\\ 3 & 5 & -7 \\\\ 1 & 0 & 2\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}5 & -7 \\\\ 0 & 2\\end{vmatrix}-2\\cdot \\begin{vmatrix}3 & -7 \\\\ 1 & 2\\end{vmatrix}+4\\cdot \\begin{vmatrix}3 & 5 \\\\ 1 & 0\\end{vmatrix} \\\\  & =(5\\cdot 2-0\\cdot (-7))-2(3\\cdot 2-1\\cdot (-7))+4(3\\cdot 0-1\\cdot 5) \\\\  & =10-26-20 \\\\  & =-36\\end{aligned}\n$$\n\n    \n\nFinally, we take the absolute value. So the volume of the corresponding parallelepiped is\n\n$$\nV=|-36|=36.\n$$"}] [{:db/id #edb/ref 17592186459280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5216c374-a69c-5443-8bee-9f1ddd0f5f48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186458774} {:answer/id #uuid "6335e762-2245-5418-bb75-3a1949475345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186458799} {:answer/id #uuid "e1689190-63f6-546f-8a11-0c26f5505614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186459019} {:answer/id #uuid "e266aadb-6f3e-5cb3-bdf0-fbd14964466f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186459022} {:answer/id #uuid "f5efc6f5-034d-561c-9f26-ee84c3ed3263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186459063}] :answer-field/correct {:answer/id #uuid "e266aadb-6f3e-5cb3-bdf0-fbd14964466f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186459022} :answer-field/id #uuid "86bdb8ca-60d6-5ea6-b69c-33f89749693f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459144}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bf74fac3-a1be-5590-922d-8474c31e9763" :question/math-academy-id "q-128471" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(0,9,4),$ $B(3,8,2),$ $C(2,9,1),$ and $D(-1,7,7).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(3i+8j+2k)-(9j+4k) \\\\  & =3i-j-2k \\\\  & =⟨3,-1,-2⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(2i+9j+k)-(9j+4k) \\\\  & =2i-3k \\\\  & =⟨2,0,-3⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(-i+7j+7k)-(9j+4k) \\\\  & =-i-2j+3k \\\\  & =⟨-1,-2,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}3 & -1 & -2 \\\\ 2 & 0 & -3 \\\\ -1 & -2 & 3\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}0 & -3 \\\\ -2 & 3\\end{vmatrix}-(-1)\\cdot \\begin{vmatrix}2 & -3 \\\\ -1 & 3\\end{vmatrix}+(-2)\\cdot \\begin{vmatrix}2 & 0 \\\\ -1 & -2\\end{vmatrix} \\\\  & =3(0\\cdot 3-(-2)\\cdot (-3))+(2\\cdot 3-(-1)\\cdot (-3))-2(2\\cdot (-2)-(-1)\\cdot 0) \\\\  & =-18+3+8 \\\\  & =-7.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-7|=7.\n$$"}] [{:db/id #edb/ref 17592186459283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91e13210-c3e8-5a66-8d62-7a2167a2e669" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186458883}] :answer-field/correct {:answer/id #uuid "91e13210-c3e8-5a66-8d62-7a2167a2e669" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186458883} :answer-field/id #uuid "c3dc73c2-9dbe-5591-bf8d-362e058d27f6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459172}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c8774189-53cd-55b6-bea0-346937f16124" :question/math-academy-id "q-280710" :question/problem "Compute the volume $V$ of the parallelepiped spanned by the vectors $a=⟨4,0,2⟩$, $b=⟨1,3,0⟩$, and $c=⟨0,2,5⟩.$\n\n$V=${{field-1}}" :question/worked-solution "The volume of a parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}4 & 0 & 2 \\\\ 1 & 3 & 0 \\\\ 0 & 2 & 5\\end{vmatrix} \\\\  & =4\\cdot \\begin{vmatrix}3 & 0 \\\\ 2 & 5\\end{vmatrix}-0\\cdot \\begin{vmatrix}1 & 0 \\\\ 0 & 5\\end{vmatrix}+2\\cdot \\begin{vmatrix}1 & 3 \\\\ 0 & 2\\end{vmatrix} \\\\  & =4(3\\cdot 5-0\\cdot 2)+0+2(1\\cdot 2-3\\cdot 0) \\\\  & =60+0+4 \\\\  & =64\\end{aligned}\n$$\n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|64|=64.\n$$"}] [{:db/id #edb/ref 17592186459292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4b54cc7-eae3-5d57-91d2-3a0fea3a1c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "152" :db/id #edb/ref 17592186458919} {:answer/id #uuid "b303e1bb-f85e-5fac-8e2e-0800f3853ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "161" :db/id #edb/ref 17592186458950} {:answer/id #uuid "bf8935c4-627d-5119-a734-99dcd8c66458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "153" :db/id #edb/ref 17592186458972} {:answer/id #uuid "e0b30beb-61fb-5067-98b9-8e9d6b43d7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-134" :db/id #edb/ref 17592186459017} {:answer/id #uuid "eb7b07bc-b3d2-5466-b600-1f239c376357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{155}{6}" :db/id #edb/ref 17592186459041}] :answer-field/correct {:answer/id #uuid "bf8935c4-627d-5119-a734-99dcd8c66458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "153" :db/id #edb/ref 17592186458972} :answer-field/id #uuid "f9a5041e-ac12-543b-a288-c49e2bf1590e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459199}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "da5d7cb9-5c27-5b41-96e4-8767d3252a54" :question/math-academy-id "q-20144" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(3,-2,2)$, $B(4,3,2)$, $C(1,3,5)$, $D(2,4,-6).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(4i+3j+2k)-(3i-2j+2k) \\\\  & =i+5j \\\\  & =⟨1,5,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+3j+5k)-(3i-2j+2k) \\\\  & =-2i+5j+3k \\\\  & =⟨-2,5,3⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i+4j-6k)-(3i-2j+2k) \\\\  & =-i+6j-8k \\\\  & =⟨-1,6,-8⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}1 & 5 & 0 \\\\ -2 & 5 & 3 \\\\ -1 & 6 & -8\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}5 & 3 \\\\ 6 & -8\\end{vmatrix}-5\\cdot \\begin{vmatrix}-2 & 3 \\\\ -1 & -8\\end{vmatrix}+0\\cdot \\begin{vmatrix}-2 & 5 \\\\ -1 & 6\\end{vmatrix} \\\\  & =(5\\cdot (-8)-6\\cdot 3)-5((-2)\\cdot (-8)-(-1)\\cdot 3)+0 \\\\  & =-58-95 \\\\  & =-153.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-153|=153.\n$$"}] [{:db/id #edb/ref 17592186459306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "030d4dbf-31a4-5c0b-ac81-fba854373f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186458621} {:answer/id #uuid "73574c6b-9bf8-53da-8eb4-4206538d870d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186458830} {:answer/id #uuid "9f870293-8ab2-51ce-aeed-f745f0ba194c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186458911} {:answer/id #uuid "beb8454a-c986-5919-9b86-28dfc102e89c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186458970} {:answer/id #uuid "e4c4fd6b-08ec-58ae-80a4-d8e5d351c013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186459025}] :answer-field/correct {:answer/id #uuid "e4c4fd6b-08ec-58ae-80a4-d8e5d351c013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186459025} :answer-field/id #uuid "70ec86a9-e96a-54b6-bdab-92b2a2a8c0ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459133}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f94fb95c-1aca-535d-ab25-0d9749d43fb3" :question/math-academy-id "q-18262" :question/problem "Calculate the volume of the parallelepiped spanned by $p=⟨0,1,-1⟩$, $q=⟨-2,3,1⟩$ and $r=⟨-1,4,3⟩.$" :question/worked-solution "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =\\begin{vmatrix}0 & 1 & -1 \\\\ -2 & 3 & 1 \\\\ -1 & 4 & 3\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}3 & 1 \\\\ 4 & 3\\end{vmatrix}-1\\cdot \\begin{vmatrix}-2 & 1 \\\\ -1 & 3\\end{vmatrix}+(-1)\\cdot \\begin{vmatrix}-2 & 3 \\\\ -1 & 4\\end{vmatrix} \\\\  & =0-((-2)\\cdot 3-(-1)\\cdot 1)-((-2)\\cdot 4-(-1)\\cdot 3) \\\\  & =5+5 \\\\  & =10\\end{aligned}\n$$\n\nFinally, we take the absolute value. So the volume of the corresponding parallelepiped is\n\n$$\nV=|10|=10.\n$$"}] [{:db/id #edb/ref 17592186459308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097251b1-26d6-5cd9-bf4d-87268a9fc820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{2}" :db/id #edb/ref 17592186458633} {:answer/id #uuid "1b54582f-21c1-5dbb-96a1-354563e5dd55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186458675} {:answer/id #uuid "2cada373-4b44-51da-8246-3a0563bdb1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{2}" :db/id #edb/ref 17592186458715} {:answer/id #uuid "746350b5-80dc-5a7c-a6bb-5b2627a66dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{4}" :db/id #edb/ref 17592186458833} {:answer/id #uuid "f5f276ab-f70a-50eb-8278-8d17070d15a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186459064}] :answer-field/correct {:answer/id #uuid "746350b5-80dc-5a7c-a6bb-5b2627a66dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{4}" :db/id #edb/ref 17592186458833} :answer-field/id #uuid "79226ded-2796-54ed-af2f-9b7e026caf73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459137}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fa437fb9-bfe8-5dbc-864c-e499156b0343" :question/math-academy-id "q-18261" :question/problem "Find $x$ given that the vectors $a=⟨12,-2x,1⟩$ , $b=⟨1,5,-2⟩$ and $c=⟨-9,4,8⟩$  are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}12 & -2x & 1 \\\\ 1 & 5 & -2 \\\\ -9 & 4 & 8\\end{vmatrix} \\\\  & =12\\cdot \\begin{vmatrix}5 & -2 \\\\ 4 & 8\\end{vmatrix}-(-2x)\\cdot \\begin{vmatrix}1 & -2 \\\\ -9 & 8\\end{vmatrix}+1\\cdot \\begin{vmatrix}1 & 5 \\\\ -9 & 4\\end{vmatrix} \\\\  & =12(5\\cdot 8-4\\cdot (-2))+2x(1\\cdot 8-(-9)\\cdot (-2))+(1\\cdot 4-5\\cdot (-9)) \\\\  & =576-20x+49 \\\\  & =625-20x.\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 625-20x & =0 \\\\ 20x & =625 \\\\ x & =\\frac{125}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $x=\\frac{125}{4}.$"}] [{:db/id #edb/ref 17592186484224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef21b691-d97c-5047-bd55-f0d2f57c360d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186484042}] :answer-field/correct {:answer/id #uuid "ef21b691-d97c-5047-bd55-f0d2f57c360d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186484042} :answer-field/id #uuid "752c7d24-ba0b-5853-99e8-14fd968c0d02" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484137}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "54f335de-9889-5585-819e-c5ae71a53628" :question/math-academy-id "q-280714" :question/problem "Compute the volume $V$ of the parallelepiped spanned by the vectors $p=⟨1,2,3⟩$, $q=⟨0,5,1⟩$, and $r=⟨4,0,6⟩.$\n\n$V=${{field-1}}" :question/worked-solution "The volume of a parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =\\begin{vmatrix}1 & 2 & 3 \\\\ 0 & 5 & 1 \\\\ 4 & 0 & 6\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}5 & 1 \\\\ 0 & 6\\end{vmatrix}-2\\cdot \\begin{vmatrix}0 & 1 \\\\ 4 & 6\\end{vmatrix}+3\\cdot \\begin{vmatrix}0 & 5 \\\\ 4 & 0\\end{vmatrix} \\\\  & =1(30)-2(0\\cdot 6-1\\cdot 4)+3(0\\cdot 0-5\\cdot 4) \\\\  & =30+8-60 \\\\  & =-22\\end{aligned}\n$$\n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|-22|=22.\n$$"}] [{:db/id #edb/ref 17592186484229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eea5ea1b-1584-5bf8-9c56-60e082cc3b30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16}{13}" :db/id #edb/ref 17592186484039}] :answer-field/correct {:answer/id #uuid "eea5ea1b-1584-5bf8-9c56-60e082cc3b30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16}{13}" :db/id #edb/ref 17592186484039} :answer-field/id #uuid "aefbe563-901b-5005-9895-d7c05a2acfbf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484170}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "65ad1da6-49b7-5494-8267-2eea67ec5389" :question/math-academy-id "q-280747" :question/problem "Find $k$ given that the vectors $a=⟨2,k,-1⟩$, $b=⟨-3,4,5⟩$, and $c=⟨6,k,1⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}2 & k & -1 \\\\ -3 & 4 & 5 \\\\ 6 & k & 1\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}4 & 5 \\\\ k & 1\\end{vmatrix}-k\\cdot \\begin{vmatrix}-3 & 5 \\\\ 6 & 1\\end{vmatrix}+(-1)\\cdot \\begin{vmatrix}-3 & 4 \\\\ 6 & k\\end{vmatrix} \\\\  & =2(4\\cdot 1-5\\cdot k)-k(-3\\cdot 1-5\\cdot 6)-1(-3\\cdot k-4\\cdot 6) \\\\  & =8-10k+33k+3k+24 \\\\  & =26k+32\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 26k+32 & =0 \\\\ k & =-\\frac{16}{13}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{16}{13}.$"}] [{:db/id #edb/ref 17592186484248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17336941-881c-5fb2-a109-5b4a5addcfec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186483606}] :answer-field/correct {:answer/id #uuid "17336941-881c-5fb2-a109-5b4a5addcfec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186483606} :answer-field/id #uuid "a6a81b1b-3ad2-556f-aea1-11eab91bed3e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484164}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8951c125-ece2-55e4-a6b5-7a7f9b036e1d" :question/math-academy-id "q-280669" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $x=⟨3,0,-2⟩$, $y=⟨1,2,4⟩$, and $z=⟨-5,1,1⟩.$\n\n$V=${{field-1}}" :question/worked-solution "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =\\begin{vmatrix}3 & 0 & -2 \\\\ 1 & 2 & 4 \\\\ -5 & 1 & 1\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}2 & 4 \\\\ 1 & 1\\end{vmatrix}-0\\cdot \\begin{vmatrix}1 & 4 \\\\ -5 & 1\\end{vmatrix}+(-2)\\cdot \\begin{vmatrix}1 & 2 \\\\ -5 & 1\\end{vmatrix} \\\\  & =3(2\\cdot 1-4\\cdot 1)+0+(-2)(1\\cdot 1-2\\cdot (-5)) \\\\  & =-6-22 \\\\  & =-28\\end{aligned}\n$$\n\n    \n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|-28|=28.\n$$"}] [{:db/id #edb/ref 17592186493904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc5ee62-4f20-5c54-9e5a-bbb471927bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493468} {:answer/id #uuid "3135cadf-898b-5d47-89f0-df3060a008eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186493473} {:answer/id #uuid "389cf47a-7d3c-5e4e-b0ed-207e5d8a0087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186493485} {:answer/id #uuid "9fcfd0be-c665-50f6-b594-87f4f9162f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186493643} {:answer/id #uuid "ae7cc567-6679-5581-b389-e82348eb1ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493668}] :answer-field/correct {:answer/id #uuid "2cc5ee62-4f20-5c54-9e5a-bbb471927bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493468} :answer-field/id #uuid "0b436b69-27e7-557e-9669-3a80b22007ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493806}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2b5a6dbe-bec1-5af9-82e5-d252aa38eb1f" :question/math-academy-id "q-73733" :question/problem "Find $k$ given that the vectors $a=⟨-1,1,1⟩$, $b=⟨2,1,0⟩$, and $c=⟨k,-2,-3⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}-1 & 1 & 1 \\\\ 2 & 1 & 0 \\\\ k & -2 & -3\\end{vmatrix} \\\\  & =(-1)\\cdot \\begin{vmatrix}1 & 0 \\\\ -2 & -3\\end{vmatrix}-1\\cdot \\begin{vmatrix}2 & 0 \\\\ k & -3\\end{vmatrix}+\\begin{vmatrix}2 & 1 \\\\ k & -2\\end{vmatrix} \\\\  & =-(1\\cdot (-3)-(-2)\\cdot 0)-(2\\cdot (-3)-k\\cdot 0)+(2\\cdot (-2)-k\\cdot 1) \\\\  & =3+6-4-k \\\\  & =5-k.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 5-k & =0 \\\\ k & =5\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=5.$"}] [{:db/id #edb/ref 17592186493949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a627e562-14bd-588f-a5f4-1d17e6cb6828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}" :db/id #edb/ref 17592186493653}] :answer-field/correct {:answer/id #uuid "a627e562-14bd-588f-a5f4-1d17e6cb6828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}" :db/id #edb/ref 17592186493653} :answer-field/id #uuid "a9d8c1a0-222c-5144-9f47-a1a87a86c092" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493858}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b407ea24-4cac-5cb8-bbfb-b1a7b706dc73" :question/math-academy-id "q-280770" :question/problem "Find $k$ given that the vectors $x=⟨1,k,2⟩$, $y=⟨5,-2,3⟩$, and $z=⟨-4,k,1⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =\\begin{vmatrix}1 & k & 2 \\\\ 5 & -2 & 3 \\\\ -4 & k & 1\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-2 & 3 \\\\ k & 1\\end{vmatrix}-k\\cdot \\begin{vmatrix}5 & 3 \\\\ -4 & 1\\end{vmatrix}+2\\cdot \\begin{vmatrix}5 & -2 \\\\ -4 & k\\end{vmatrix} \\\\  & =1(-2\\cdot 1-3\\cdot k)-k(5\\cdot 1-3\\cdot -4)+2(5k-(-2)(-4)) \\\\  & =-2-3k-k(5+12)+2(5k-8) \\\\  & =-2-3k-17k+10k-16 \\\\  & =-10k-18\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =0 \\\\ -10k-18 & =0 \\\\ k & =-\\frac{9}{5}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{9}{5}.$"}] [{:db/id #edb/ref 17592186532929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031d0e77-1be4-5f79-ac49-30581b1109df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186532913} {:answer/id #uuid "36cb9852-6cc7-56c2-997d-427abce87832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186532922} {:answer/id #uuid "5abbd8d9-ea61-54f3-b7bf-18bc60b7992e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186532933} {:answer/id #uuid "5b749e31-62ae-556d-adc9-5afe59c5aca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186532934} {:answer/id #uuid "8ab80959-cc27-5323-96bb-30dc2e905bac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186532942}] :answer-field/correct {:answer/id #uuid "8ab80959-cc27-5323-96bb-30dc2e905bac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186532942} :answer-field/id #uuid "55c5a31d-71e6-5a81-bbf8-422ec893a0df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532931}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5162d6b7-170d-5cba-9c12-2a329eeb3c85" :question/problem "Find $k$ given that the vectors $a=⟨0,2,2⟩$, $b=⟨-1,3,-1⟩$, and $c=⟨k,0,1⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}0 & 2 & 2 \\\\ -1 & 3 & -1 \\\\ k & 0 & 1\\end{vmatrix}\\\\ &=((0)\\cdot \\begin{vmatrix}3 & -1 \\\\ 0 & 1\\end{vmatrix})+((-2)\\cdot \\begin{vmatrix}-1 & -1 \\\\ k & 1\\end{vmatrix})+((2)\\cdot \\begin{vmatrix}-1 & 3 \\\\ k & 0\\end{vmatrix})\\\\ &=((0)\\cdot ((3)\\cdot (1)-(-1)\\cdot (0)))+((-2)\\cdot ((-1)\\cdot (1)-(-1)\\cdot (k)))+((2)\\cdot ((-1)\\cdot (0)-(3)\\cdot (k)))\\\\ &=((0)\\cdot (3))+((-2)\\cdot (k-1))+((2)\\cdot (-3k))\\\\ &=(0)+(2-2k)+(-6k)\\\\ &=2-8k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}2-8k&=0\\\\ -8k&=-2\\\\ k&=\\frac{1}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=\\frac{1}{4}.$"}] [{:db/id #edb/ref 17592186532943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9460621-71a9-5b4c-8225-df04faa86acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186532958}] :answer-field/correct {:answer/id #uuid "d9460621-71a9-5b4c-8225-df04faa86acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186532958} :answer-field/id #uuid "256c84a5-699e-5885-98ca-8c2306a3126d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532919}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "959a3d96-96d9-5e94-ae16-1649b7187c84" :question/problem "Find $k$ given that the vectors $a=⟨-2,-4,-4⟩$, $b=⟨5,k,3⟩$, and $c=⟨-8,-4,-6⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}-2 & -4 & -4 \\\\ 5 & k & 3 \\\\ -8 & -4 & -6\\end{vmatrix}\\\\ &=((-2)\\cdot \\begin{vmatrix}k & 3 \\\\ -4 & -6\\end{vmatrix})+((4)\\cdot \\begin{vmatrix}5 & 3 \\\\ -8 & -6\\end{vmatrix})+((-4)\\cdot \\begin{vmatrix}5 & k \\\\ -8 & -4\\end{vmatrix})\\\\ &=((-2)\\cdot ((k)\\cdot (-6)-(3)\\cdot (-4)))+((4)\\cdot ((5)\\cdot (-6)-(3)\\cdot (-8)))+((-4)\\cdot ((5)\\cdot (-4)-(k)\\cdot (-8)))\\\\ &=((-2)\\cdot (12-6k))+((4)\\cdot (-6))+((-4)\\cdot (8k-20))\\\\ &=(12k-24)+(-24)+(80-32k)\\\\ &=32-20k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}32-20k&=0\\\\ -20k&=-32\\\\ k&=\\frac{8}{5}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=\\frac{8}{5}.$"}] [{:db/id #edb/ref 17592186532947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "389a6fa0-e3d4-5597-827a-e58c65d1dbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{282}{53}" :db/id #edb/ref 17592186532924} {:answer/id #uuid "389dc8f8-8d8d-50a6-95e6-77056fb36c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{53}{282}" :db/id #edb/ref 17592186532925} {:answer/id #uuid "6f7462bc-d1b9-501c-a475-be0669abcfa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{282}{53}" :db/id #edb/ref 17592186532939} {:answer/id #uuid "c41f9576-8ca1-52d8-93b9-ff5e58d717ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "282" :db/id #edb/ref 17592186532951} {:answer/id #uuid "efd5024c-bc85-5fbf-9102-4af7fc5b265e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{354}{11}" :db/id #edb/ref 17592186532961}] :answer-field/correct {:answer/id #uuid "6f7462bc-d1b9-501c-a475-be0669abcfa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{282}{53}" :db/id #edb/ref 17592186532939} :answer-field/id #uuid "5c1f86e4-f33a-5bbb-b5d1-c7e07d4f315c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532935}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "acd084fc-5208-5b27-9f08-8dd69c354e99" :question/problem "Find $k$ given that the vectors $a=⟨-6,3,-4⟩$, $b=⟨k,3,-3⟩$, and $c=⟨-4,8,7⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}-6 & 3 & -4 \\\\ k & 3 & -3 \\\\ -4 & 8 & 7\\end{vmatrix}\\\\ &=((-6)\\cdot \\begin{vmatrix}3 & -3 \\\\ 8 & 7\\end{vmatrix})+((-3)\\cdot \\begin{vmatrix}k & -3 \\\\ -4 & 7\\end{vmatrix})+((-4)\\cdot \\begin{vmatrix}k & 3 \\\\ -4 & 8\\end{vmatrix})\\\\ &=((-6)\\cdot ((3)\\cdot (7)-(-3)\\cdot (8)))+((-3)\\cdot ((k)\\cdot (7)-(-3)\\cdot (-4)))+((-4)\\cdot ((k)\\cdot (8)-(3)\\cdot (-4)))\\\\ &=((-6)\\cdot (45))+((-3)\\cdot (7k-12))+((-4)\\cdot (8k+12))\\\\ &=(-270)+(36-21k)+(-32k-48)\\\\ &=-53k-282\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}-53k-282&=0\\\\ -53k&=282\\\\ k&=-\\frac{282}{53}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{282}{53}.$"}] [{:db/id #edb/ref 17592186532948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1e0999-560e-596f-a43f-4cc139aad91e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186532915}] :answer-field/correct {:answer/id #uuid "0a1e0999-560e-596f-a43f-4cc139aad91e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186532915} :answer-field/id #uuid "75ce68ff-001a-5d18-89b6-4460cfebbbf2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532940}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b19b3600-3782-5719-8b4b-54b70445653d" :question/problem "Find $k$ given that the vectors $a=⟨1,0,-1⟩$, $b=⟨2,-2,0⟩$, and $c=⟨1,-2,k⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}1 & 0 & -1 \\\\ 2 & -2 & 0 \\\\ 1 & -2 & k\\end{vmatrix}\\\\ &=((1)\\cdot \\begin{vmatrix}-2 & 0 \\\\ -2 & k\\end{vmatrix})+((0)\\cdot \\begin{vmatrix}2 & 0 \\\\ 1 & k\\end{vmatrix})+((-1)\\cdot \\begin{vmatrix}2 & -2 \\\\ 1 & -2\\end{vmatrix})\\\\ &=((1)\\cdot ((-2)\\cdot (k)-(0)\\cdot (-2)))+((0)\\cdot ((2)\\cdot (k)-(0)\\cdot (1)))+((-1)\\cdot ((2)\\cdot (-2)-(-2)\\cdot (1)))\\\\ &=((1)\\cdot (-2k))+((0)\\cdot (2k))+((-1)\\cdot (-2))\\\\ &=(-2k)+(0)+(2)\\\\ &=2-2k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}2-2k&=0\\\\ -2k&=-2\\\\ k&=1\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=1.$"}] [{:db/id #edb/ref 17592186532950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c89863-a7a5-54c6-a390-8bda35d2ed8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{64}{7}" :db/id #edb/ref 17592186532911} {:answer/id #uuid "028e1fd4-5032-53e5-b46c-a5ee23169035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{64}" :db/id #edb/ref 17592186532912} {:answer/id #uuid "035375d4-c9d0-5349-b9bd-b6de80ede829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-128" :db/id #edb/ref 17592186532914} {:answer/id #uuid "56e63dba-9418-5d05-b2ca-0f55d02ed074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{7}" :db/id #edb/ref 17592186532932} {:answer/id #uuid "99627a42-6459-563d-9a31-b498ce4fed42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186532946}] :answer-field/correct {:answer/id #uuid "01c89863-a7a5-54c6-a390-8bda35d2ed8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{64}{7}" :db/id #edb/ref 17592186532911} :answer-field/id #uuid "ce442651-4f85-5db0-b190-a1684c76b876" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532957}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bb17559d-a343-5f1f-a65b-26dfaa099904" :question/problem "Find $k$ given that the vectors $a=⟨-5,-5,3⟩$, $b=⟨k,-8,4⟩$, and $c=⟨-3,-7,7⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}-5 & -5 & 3 \\\\ k & -8 & 4 \\\\ -3 & -7 & 7\\end{vmatrix}\\\\ &=((-5)\\cdot \\begin{vmatrix}-8 & 4 \\\\ -7 & 7\\end{vmatrix})+((5)\\cdot \\begin{vmatrix}k & 4 \\\\ -3 & 7\\end{vmatrix})+((3)\\cdot \\begin{vmatrix}k & -8 \\\\ -3 & -7\\end{vmatrix})\\\\ &=((-5)\\cdot ((-8)\\cdot (7)-(4)\\cdot (-7)))+((5)\\cdot ((k)\\cdot (7)-(4)\\cdot (-3)))+((3)\\cdot ((k)\\cdot (-7)-(-8)\\cdot (-3)))\\\\ &=((-5)\\cdot (-28))+((5)\\cdot (7k+12))+((3)\\cdot (-7k-24))\\\\ &=(140)+(35k+60)+(-21k-72)\\\\ &=14k+128\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}14k+128&=0\\\\ 14k&=-128\\\\ k&=-\\frac{64}{7}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{64}{7}.$"}] [{:db/id #edb/ref 17592186532952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76c5b4cb-6d55-5b36-bc09-4860517acd1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186532941}] :answer-field/correct {:answer/id #uuid "76c5b4cb-6d55-5b36-bc09-4860517acd1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186532941} :answer-field/id #uuid "37a38844-d78a-5780-8e88-5a1d10bda758" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532923}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5ff0093-be96-550d-9641-06c29e3471de" :question/problem "Find $k$ given that the vectors $a=⟨0,-1,-1⟩$, $b=⟨2,0,1⟩$, and $c=⟨k,0,-2⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}0 & -1 & -1 \\\\ 2 & 0 & 1 \\\\ k & 0 & -2\\end{vmatrix}\\\\ &=((0)\\cdot \\begin{vmatrix}0 & 1 \\\\ 0 & -2\\end{vmatrix})+((1)\\cdot \\begin{vmatrix}2 & 1 \\\\ k & -2\\end{vmatrix})+((-1)\\cdot \\begin{vmatrix}2 & 0 \\\\ k & 0\\end{vmatrix})\\\\ &=((0)\\cdot ((0)\\cdot (-2)-(1)\\cdot (0)))+((1)\\cdot ((2)\\cdot (-2)-(1)\\cdot (k)))+((-1)\\cdot ((2)\\cdot (0)-(0)\\cdot (k)))\\\\ &=((0)\\cdot (0))+((1)\\cdot (-k-4))+((-1)\\cdot (0))\\\\ &=(0)+(-k-4)+(0)\\\\ &=-k-4\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}-k-4&=0\\\\ -k&=4\\\\ k&=-4\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-4.$"}] [{:db/id #edb/ref 17592186532955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c9a717-ec72-5b7a-a3bb-6d8d6443b34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186532917} {:answer/id #uuid "32b3de44-86fc-5383-b273-ea7ca9001b72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186532920} {:answer/id #uuid "6ebbac01-5409-5496-b350-ab29e290547a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186532938} {:answer/id #uuid "c738d87d-d523-5da3-a60e-74f3d6588295" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186532953} {:answer/id #uuid "e67af7bd-0910-5792-904d-394262291e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186532960}] :answer-field/correct {:answer/id #uuid "e67af7bd-0910-5792-904d-394262291e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186532960} :answer-field/id #uuid "b7a3cd37-a2fc-5234-91f7-30b4045f7151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532949}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cc8b8bd2-db50-5811-bf49-b4f250279478" :question/problem "Find $k$ given that the vectors $a=⟨2,2,0⟩$, $b=⟨3,0,k⟩$, and $c=⟨-3,-1,-2⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}2 & 2 & 0 \\\\ 3 & 0 & k \\\\ -3 & -1 & -2\\end{vmatrix}\\\\ &=((2)\\cdot \\begin{vmatrix}0 & k \\\\ -1 & -2\\end{vmatrix})+((-2)\\cdot \\begin{vmatrix}3 & k \\\\ -3 & -2\\end{vmatrix})+((0)\\cdot \\begin{vmatrix}3 & 0 \\\\ -3 & -1\\end{vmatrix})\\\\ &=((2)\\cdot ((0)\\cdot (-2)-(k)\\cdot (-1)))+((-2)\\cdot ((3)\\cdot (-2)-(k)\\cdot (-3)))+((0)\\cdot ((3)\\cdot (-1)-(0)\\cdot (-3)))\\\\ &=((2)\\cdot (k))+((-2)\\cdot (3k-6))+((0)\\cdot (-3))\\\\ &=(2k)+(12-6k)+(0)\\\\ &=12-4k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}12-4k&=0\\\\ -4k&=-12\\\\ k&=3\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=3.$"}] [{:db/id #edb/ref 17592186532959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9a3bf2-bb27-55ea-9d1a-0705b0c69a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186532918} {:answer/id #uuid "4026b447-0d95-56cd-af37-471328d81281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186532926} {:answer/id #uuid "4bf532b2-930d-5041-aafb-acc26b8eef68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186532928} {:answer/id #uuid "98ad6c6e-ff84-5aee-bd24-aa5dd7396fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186532945} {:answer/id #uuid "cde619be-078c-573e-9e89-5f8ac0f0fb94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186532956}] :answer-field/correct {:answer/id #uuid "4bf532b2-930d-5041-aafb-acc26b8eef68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186532928} :answer-field/id #uuid "f79832df-bc36-5b90-9a30-1d02c70c6b38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532962}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e57079a5-b446-561a-b004-99b65c79b5c1" :question/problem "Find $k$ given that the vectors $a=⟨1,-3,-3⟩$, $b=⟨k,0,-2⟩$, and $c=⟨-2,-2,0⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}1 & -3 & -3 \\\\ k & 0 & -2 \\\\ -2 & -2 & 0\\end{vmatrix}\\\\ &=((1)\\cdot \\begin{vmatrix}0 & -2 \\\\ -2 & 0\\end{vmatrix})+((3)\\cdot \\begin{vmatrix}k & -2 \\\\ -2 & 0\\end{vmatrix})+((-3)\\cdot \\begin{vmatrix}k & 0 \\\\ -2 & -2\\end{vmatrix})\\\\ &=((1)\\cdot ((0)\\cdot (0)-(-2)\\cdot (-2)))+((3)\\cdot ((k)\\cdot (0)-(-2)\\cdot (-2)))+((-3)\\cdot ((k)\\cdot (-2)-(0)\\cdot (-2)))\\\\ &=((1)\\cdot (-4))+((3)\\cdot (-4))+((-3)\\cdot (-2k))\\\\ &=(-4)+(-12)+(6k)\\\\ &=6k-16\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}6k-16&=0\\\\ 6k&=16\\\\ k&=\\frac{8}{3}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=\\frac{8}{3}.$"}] [{:db/id #edb/ref 17592186532963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ddeab8d-bcb4-5ee1-9257-633f3e384f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{40}{3}" :db/id #edb/ref 17592186532916}] :answer-field/correct {:answer/id #uuid "0ddeab8d-bcb4-5ee1-9257-633f3e384f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{40}{3}" :db/id #edb/ref 17592186532916} :answer-field/id #uuid "3513ccb6-8018-5776-a275-e1ab6af0409e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532921}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f9bfe94d-f47c-538d-88ad-f4c779282429" :question/problem "Find $k$ given that the vectors $a=⟨3,-3,5⟩$, $b=⟨-8,8,k⟩$, and $c=⟨-2,5,-8⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}3 & -3 & 5 \\\\ -8 & 8 & k \\\\ -2 & 5 & -8\\end{vmatrix}\\\\ &=((3)\\cdot \\begin{vmatrix}8 & k \\\\ 5 & -8\\end{vmatrix})+((3)\\cdot \\begin{vmatrix}-8 & k \\\\ -2 & -8\\end{vmatrix})+((5)\\cdot \\begin{vmatrix}-8 & 8 \\\\ -2 & 5\\end{vmatrix})\\\\ &=((3)\\cdot ((8)\\cdot (-8)-(k)\\cdot (5)))+((3)\\cdot ((-8)\\cdot (-8)-(k)\\cdot (-2)))+((5)\\cdot ((-8)\\cdot (5)-(8)\\cdot (-2)))\\\\ &=((3)\\cdot (-5k-64))+((3)\\cdot (2k+64))+((5)\\cdot (-24))\\\\ &=(-15k-192)+(6k+192)+(-120)\\\\ &=-9k-120\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}-9k-120&=0\\\\ -9k&=120\\\\ k&=-\\frac{40}{3}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{40}{3}.$"}] [{:db/id #edb/ref 17592186532964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "495216f8-ef7c-5ef8-ae34-5152e6e47107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186532927} {:answer/id #uuid "5f0d1937-8d14-5f3d-97f8-60d41875c868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{62}{41}" :db/id #edb/ref 17592186532936} {:answer/id #uuid "650159f6-9436-5fb8-b02e-03d322bc7f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{62}{41}" :db/id #edb/ref 17592186532937} {:answer/id #uuid "976d48d5-992e-5a41-8e8e-4090eb885398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{146}{57}" :db/id #edb/ref 17592186532944} {:answer/id #uuid "cae87ba6-a32d-5098-a69e-0f18a37a474e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{62}" :db/id #edb/ref 17592186532954}] :answer-field/correct {:answer/id #uuid "5f0d1937-8d14-5f3d-97f8-60d41875c868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{62}{41}" :db/id #edb/ref 17592186532936} :answer-field/id #uuid "52467521-ef60-5e84-bec4-06437e06e07b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532930}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fde80f08-4e0e-5eb6-a3f4-6031da9ee39a" :question/problem "Find $k$ given that the vectors $a=⟨6,-7,4⟩$, $b=⟨2,-2,7⟩$, and $c=⟨k,-2,-3⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot(b\\times c)&=\\begin{vmatrix}6 & -7 & 4 \\\\ 2 & -2 & 7 \\\\ k & -2 & -3\\end{vmatrix}\\\\ &=((6)\\cdot \\begin{vmatrix}-2 & 7 \\\\ -2 & -3\\end{vmatrix})+((7)\\cdot \\begin{vmatrix}2 & 7 \\\\ k & -3\\end{vmatrix})+((4)\\cdot \\begin{vmatrix}2 & -2 \\\\ k & -2\\end{vmatrix})\\\\ &=((6)\\cdot ((-2)\\cdot (-3)-(7)\\cdot (-2)))+((7)\\cdot ((2)\\cdot (-3)-(7)\\cdot (k)))+((4)\\cdot ((2)\\cdot (-2)-(-2)\\cdot (k)))\\\\ &=((6)\\cdot (20))+((7)\\cdot (-7k-6))+((4)\\cdot (2k-4))\\\\ &=(120)+(-49k-42)+(8k-16)\\\\ &=62-41k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}62-41k&=0\\\\ -41k&=-62\\\\ k&=\\frac{62}{41}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=\\frac{62}{41}.$"}] [{:db/id #edb/ref 17592186544819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d62d2e68-5eee-5bc7-afa4-c823d3717d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{50}{3}" :db/id #edb/ref 17592186544543}] :answer-field/correct {:answer/id #uuid "d62d2e68-5eee-5bc7-afa4-c823d3717d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{50}{3}" :db/id #edb/ref 17592186544543} :answer-field/id #uuid "0d21ebbf-1121-50e2-8b37-00e70a6f94e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544657}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "58e03782-f890-5578-a853-4a903526c725" :question/math-academy-id "q-280718" :question/problem "Find $k$ given that the vectors $a=⟨1,2,k⟩$, $b=⟨-3,0,4⟩$, and $c=⟨2,-1,5⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}1 & 2 & k \\\\ -3 & 0 & 4 \\\\ 2 & -1 & 5\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}0 & 4 \\\\ -1 & 5\\end{vmatrix}-2\\cdot \\begin{vmatrix}-3 & 4 \\\\ 2 & 5\\end{vmatrix}+k\\cdot \\begin{vmatrix}-3 & 0 \\\\ 2 & -1\\end{vmatrix} \\\\  & =1(0\\cdot 5-4\\cdot (-1))-2((-3)\\cdot 5-4\\cdot 2)+k((-3)\\cdot (-1)-0\\cdot 2) \\\\  & =4-2(-15-8)+3k \\\\  & =50+3k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 50+3k & =0 \\\\ k & =-\\frac{50}{3}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{50}{3}.$"}] [{:db/id #edb/ref 17592186544855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f4b5ae5-dd42-5130-a079-3437f957abdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186544157} {:answer/id #uuid "36a59f0c-6350-5ee2-ab7b-1e2e0aaab216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186544206} {:answer/id #uuid "8dd330f2-c63f-5936-b6a4-80ea6b670b83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186544392} {:answer/id #uuid "e0f468c2-e5f3-55da-b91c-73e467a1b0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186544572} {:answer/id #uuid "e659aca7-3288-5e5d-8c4f-7e31771aa20e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186544581}] :answer-field/correct {:answer/id #uuid "e0f468c2-e5f3-55da-b91c-73e467a1b0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186544572} :answer-field/id #uuid "87f1cabe-8e50-570a-a56a-29d676db3c4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544716}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9ce41098-082c-5659-8a15-6d5205341359" :question/math-academy-id "q-73747" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(-1,1,1)$, $B(2,-2,1)$, $C(1,2,2)$, and $D(2,-1,4).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i-2j+k)-(-i+j+k) \\\\  & =3i-3j \\\\  & =⟨3,-3,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+2j+2k)-(-i+j+k) \\\\  & =2i+j+k \\\\  & =⟨2,1,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i-j+4k)-(-i+j+k) \\\\  & =3i-2j+3k \\\\  & =⟨3,-2,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}3 & -3 & 0 \\\\ 2 & 1 & 1 \\\\ 3 & -2 & 3\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}1 & 1 \\\\ -2 & 3\\end{vmatrix}-(-3)\\cdot \\begin{vmatrix}2 & 1 \\\\ 3 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}2 & 1 \\\\ 3 & -2\\end{vmatrix} \\\\  & =3(1\\cdot 3-(-2)\\cdot 1)+3(2\\cdot 3-3\\cdot 1)+0 \\\\  & =15+9 \\\\  & =24.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|24|=24.\n$$"}] [{:db/id #edb/ref 17592186572664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd4b21f5-ae4e-533c-a49c-e215e4954375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186572528}] :answer-field/correct {:answer/id #uuid "bd4b21f5-ae4e-533c-a49c-e215e4954375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186572528} :answer-field/id #uuid "752eecbd-7383-564b-9c0e-74b4d04c57f2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572625}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "02e4dd76-291f-501d-9dd9-df687e45b52b" :question/math-academy-id "q-280320" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(0,2,-1),$ $B(3,4,1),$ $C(-1,3,2),$ and $D(2,1,0).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(3i+4j+k)-(2j-k) \\\\  & =3i+2j+2k \\\\  & =⟨3,2,2⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-i+3j+2k)-(2j-k) \\\\  & =-i+j+3k \\\\  & =⟨-1,1,3⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i+j)-(2j-k) \\\\  & =2i-j+k \\\\  & =⟨2,-1,1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}3 & 2 & 2 \\\\ -1 & 1 & 3 \\\\ 2 & -1 & 1\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}1 & 3 \\\\ -1 & 1\\end{vmatrix}-2\\cdot \\begin{vmatrix}-1 & 3 \\\\ 2 & 1\\end{vmatrix}+2\\cdot \\begin{vmatrix}-1 & 1 \\\\ 2 & -1\\end{vmatrix} \\\\  & =3(1\\cdot 1-3\\cdot (-1))-2((-1)\\cdot 1-3\\cdot 2)+2((-1)\\cdot (-1)-1\\cdot 2) \\\\  & =3(1+3)-2(-1-6)+2(1-2) \\\\  & =12-(-14)-2 \\\\  & =24.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|24|=24.\n$$"}] [{:db/id #edb/ref 17592186572689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad103bee-c9bb-538f-b95a-de0c98d63213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186572503}] :answer-field/correct {:answer/id #uuid "ad103bee-c9bb-538f-b95a-de0c98d63213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186572503} :answer-field/id #uuid "2566d49a-718e-5a8c-9b71-cc6e6ef2e3db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572604}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "443a4021-2ecb-5b8a-948d-b71804528fab" :question/math-academy-id "q-280715" :question/problem "Compute the volume $V$ of the parallelepiped spanned by the vectors $p=⟨1,0,5⟩$, $q=⟨3,2,6⟩$, and $r=⟨0,4,1⟩.$\n\n$V=${{field-1}}" :question/worked-solution "The volume of a parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =\\begin{vmatrix}1 & 0 & 5 \\\\ 3 & 2 & 6 \\\\ 0 & 4 & 1\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}2 & 6 \\\\ 4 & 1\\end{vmatrix}-0\\cdot \\begin{vmatrix}3 & 6 \\\\ 0 & 1\\end{vmatrix}+5\\cdot \\begin{vmatrix}3 & 2 \\\\ 0 & 4\\end{vmatrix} \\\\  & =1(2\\cdot 1-6\\cdot 4)+0+5(3\\cdot 4-2\\cdot 0) \\\\  & =-22+60 \\\\  & =38\\end{aligned}\n$$\n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|38|=38.\n$$"}] [{:db/id #edb/ref 17592186572715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d46a7ab-4f0b-5721-bebb-a49f4264e23c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186572453}] :answer-field/correct {:answer/id #uuid "7d46a7ab-4f0b-5721-bebb-a49f4264e23c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186572453} :answer-field/id #uuid "5ef8f1ee-ea2b-53fa-8813-6530aca61521" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572619}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c885246f-c4a6-5da3-b8cb-28ee3dc779d8" :question/math-academy-id "q-280713" :question/problem "Compute the volume $V$ of the parallelepiped spanned by the vectors $x=⟨2,3,0⟩$, $y=⟨1,4,5⟩$, and $z=⟨0,2,6⟩.$\n\n$V=${{field-1}}" :question/worked-solution "The volume of a parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =\\begin{vmatrix}2 & 3 & 0 \\\\ 1 & 4 & 5 \\\\ 0 & 2 & 6\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}4 & 5 \\\\ 2 & 6\\end{vmatrix}-3\\cdot \\begin{vmatrix}1 & 5 \\\\ 0 & 6\\end{vmatrix}+0\\cdot \\begin{vmatrix}1 & 4 \\\\ 0 & 2\\end{vmatrix} \\\\  & =2(4\\cdot 6-5\\cdot 2)-3(1\\cdot 6-5\\cdot 0)+0 \\\\  & =2(24-10)-3(6) \\\\  & =28-18 \\\\  & =10\\end{aligned}\n$$\n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|10|=10.\n$$"}] [{:db/id #edb/ref 17592186572726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efac262e-978f-52d8-b514-d218c8e2aaf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186572579}] :answer-field/correct {:answer/id #uuid "efac262e-978f-52d8-b514-d218c8e2aaf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186572579} :answer-field/id #uuid "2170e711-c9bf-56cc-a436-de505690692b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572599}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef51444c-d286-591b-9ba9-aedca70d62d8" :question/math-academy-id "q-280746" :question/problem "Find $k$ given that the vectors $a=⟨k,k,2⟩$, $b=⟨1,3,0⟩$, and $c=⟨0,4,5⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}k & k & 2 \\\\ 1 & 3 & 0 \\\\ 0 & 4 & 5\\end{vmatrix} \\\\  & =k\\cdot \\begin{vmatrix}3 & 0 \\\\ 4 & 5\\end{vmatrix}-k\\cdot \\begin{vmatrix}1 & 0 \\\\ 0 & 5\\end{vmatrix}+2\\cdot \\begin{vmatrix}1 & 3 \\\\ 0 & 4\\end{vmatrix} \\\\  & =k(3\\cdot 5-0\\cdot 4)-k(1\\cdot 5-0\\cdot 0)+2(1\\cdot 4-3\\cdot 0) \\\\  & =k(15)-k(5)+2(4) \\\\  & =15k-5k+8 \\\\  & =10k+8\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 10k+8 & =0 \\\\ 10k & =-8 \\\\ k & =-\\frac{4}{5}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{4}{5}.$"}] [{:db/id #edb/ref 17592186609837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d472e9-7e7e-57ee-a438-d562c9fafeca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186609239} {:answer/id #uuid "0ec35d3c-0d31-5515-956f-0b04e225abed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186609257} {:answer/id #uuid "2b6011d3-8d01-55ea-b17e-00fc0a580f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186609297} {:answer/id #uuid "31eaad11-84e5-5d54-ab69-5eec706af416" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186609307} {:answer/id #uuid "514edabb-7601-5124-89e9-fc02599f42c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186609365}] :answer-field/correct {:answer/id #uuid "2b6011d3-8d01-55ea-b17e-00fc0a580f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186609297} :answer-field/id #uuid "53ae6036-88fb-5b46-8f2b-3e914c866376" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186609725}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3046fa3f-b2d9-5b09-acdf-dabea3180a8c" :question/math-academy-id "q-73732" :question/problem "Find $k$ given that the vectors $a=⟨2,1,-4⟩$, $b=⟨4,0,k⟩$, and $c=⟨-2,1,2⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}2 & 1 & -4 \\\\ 4 & 0 & k \\\\ -2 & 1 & 2\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}0 & k \\\\ 1 & 2\\end{vmatrix}-1\\cdot \\begin{vmatrix}4 & k \\\\ -2 & 2\\end{vmatrix}+(-4)\\cdot \\begin{vmatrix}4 & 0 \\\\ -2 & 1\\end{vmatrix} \\\\  & =2(0\\cdot 2-1\\cdot k)-(4\\cdot 2-(-2)\\cdot k)-4(4\\cdot 1-(-2)\\cdot 0) \\\\  & =-2k-8-2k-16 \\\\  & =-4k-24.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ -4k-24 & =0 \\\\ 4k & =-24 \\\\ k & =-6\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-6.$"}] [{:db/id #edb/ref 17592186622823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138b1a6c-d17e-53e9-8954-d051e67e09f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186622353}] :answer-field/correct {:answer/id #uuid "138b1a6c-d17e-53e9-8954-d051e67e09f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186622353} :answer-field/id #uuid "d73cc699-16d0-5a92-bbab-5a0f6a639a7c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186622734}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c4acea64-7498-5ef0-92c2-7592ee8f0c12" :question/math-academy-id "q-275354" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(0,-1,2),$ $B(-2,4,-1),$ $C(-4,-2,0),$ and $D(-2,3,1).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i+4j-k)-(-j+2k) \\\\  & =-2i+5j-3k \\\\  & =⟨-2,5,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-4i-2j)-(-j+2k) \\\\  & =-4i-j-2k \\\\  & =⟨-4,-1,-2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(-2i+3j+k)-(-j+2k) \\\\  & =-2i+4j-k \\\\  & =⟨-2,4,-1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}-2 & 5 & -3 \\\\ -4 & -1 & -2 \\\\ -2 & 4 & -1\\end{vmatrix} \\\\  & =(-2)\\cdot \\begin{vmatrix}-1 & -2 \\\\ 4 & -1\\end{vmatrix}-5\\cdot \\begin{vmatrix}-4 & -2 \\\\ -2 & -1\\end{vmatrix}+(-3)\\cdot \\begin{vmatrix}-4 & -1 \\\\ -2 & 4\\end{vmatrix} \\\\  & =-2((-1)(-1)-4(-2))-5((-4)(-1)-(-2)(-2))-3((-4)(4)-(-2)(-1)) \\\\  & =-18-0+54 \\\\  & =36.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|36|=36.\n$$"}] [{:db/id #edb/ref 17592186622834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de9e591-f75a-5224-8de9-f4db6e94464a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186622344} {:answer/id #uuid "1a87b133-66f2-5865-9063-c700cf41265d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186622363} {:answer/id #uuid "58cfb04e-6014-5f06-bbba-df1d9a25c322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186622444} {:answer/id #uuid "be0ad13d-5c0a-589f-a68d-046f820a7458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186622581} {:answer/id #uuid "d137d517-3fb4-59d1-8e34-35ddeba4c9fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186622605}] :answer-field/correct {:answer/id #uuid "58cfb04e-6014-5f06-bbba-df1d9a25c322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186622444} :answer-field/id #uuid "08d05bdf-8a8c-514b-8771-369032aec337" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186622661}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed1efdc2-16e3-5a3c-8c0f-e830f53a5c6e" :question/math-academy-id "q-128426" :question/problem "Calculate the volume of the parallelepiped spanned by $x=⟨-1,3,-2⟩,$ $y=⟨4,0,3⟩,$ and $z=⟨7,7,4⟩.$" :question/worked-solution "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =\\begin{vmatrix}-1 & 3 & -2 \\\\ 4 & 0 & 3 \\\\ 7 & 7 & 4\\end{vmatrix} \\\\  & =(-1)\\cdot \\begin{vmatrix}0 & 3 \\\\ 7 & 4\\end{vmatrix}-3\\cdot \\begin{vmatrix}4 & 3 \\\\ 7 & 4\\end{vmatrix}+(-2)\\cdot \\begin{vmatrix}4 & 0 \\\\ 7 & 7\\end{vmatrix} \\\\  & =(-1)(0\\cdot 4-7\\cdot 3)-3(4\\cdot 4-7\\cdot 3)-2(4\\cdot 7-7\\cdot 0) \\\\  & =21+15-56 \\\\  & =-20\\end{aligned}\n$$\n\n    \n\nFinally, we take the absolute value. So the volume of the corresponding parallelepiped is \n\n$$\nV=|-20|=20.\n$$"}] [{:db/id #edb/ref 17592186622836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b44a25-42ae-5126-8dc0-33b857b7d31e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{8}" :db/id #edb/ref 17592186622386}] :answer-field/correct {:answer/id #uuid "29b44a25-42ae-5126-8dc0-33b857b7d31e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{8}" :db/id #edb/ref 17592186622386} :answer-field/id #uuid "ca1a0ae9-499f-587a-a156-4f8794516c34" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186622728}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f40b3c19-a75a-51e5-9296-9fe256096c13" :question/math-academy-id "q-280721" :question/problem "Find $k$ given that the vectors $p=⟨1,0,k⟩$, $q=⟨2,3,1⟩$, and $r=⟨0,4,5⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\np\\cdot (q\\times r)=\\begin{vmatrix}1 & 0 & k \\\\ 2 & 3 & 1 \\\\ 0 & 4 & 5\\end{vmatrix}\n$$\n\n$$\n\\begin{aligned} & =1\\cdot \\begin{vmatrix}3 & 1 \\\\ 4 & 5\\end{vmatrix}-0\\cdot \\begin{vmatrix}2 & 1 \\\\ 0 & 5\\end{vmatrix}+k\\cdot \\begin{vmatrix}2 & 3 \\\\ 0 & 4\\end{vmatrix} \\\\  & =1(3\\cdot 5-1\\cdot 4)+0+k(2\\cdot 4-3\\cdot 0) \\\\  & =11+8k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 11+8k & =0 \\\\ 8k & =-11 \\\\ k & =-\\frac{11}{8}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{11}{8}.$"}] [{:db/id #edb/ref 17592186660873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42ef0922-6adf-5c0a-8bfb-b5d2acaeae14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186660532}] :answer-field/correct {:answer/id #uuid "42ef0922-6adf-5c0a-8bfb-b5d2acaeae14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186660532} :answer-field/id #uuid "14e7d5ed-b3d0-5c1d-a456-09197ed807e5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186660775}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6972d955-79e0-59ef-a98f-5f985969a482" :question/math-academy-id "q-281572" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(1,2,0),$ $B(3,4,1),$ $C(2,5,3),$ and $D(1,3,5).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(3i+4j+1k)-(i+2j) \\\\  & =2i+2j+1k \\\\  & =⟨2,2,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(2i+5j+3k)-(i+2j) \\\\  & =i+3j+3k \\\\  & =⟨1,3,3⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(i+3j+5k)-(i+2j) \\\\  & =j+5k \\\\  & =⟨0,1,5⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}2 & 2 & 1 \\\\ 1 & 3 & 3 \\\\ 0 & 1 & 5\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}3 & 3 \\\\ 1 & 5\\end{vmatrix}-2\\cdot \\begin{vmatrix}1 & 3 \\\\ 0 & 5\\end{vmatrix}+1\\cdot \\begin{vmatrix}1 & 3 \\\\ 0 & 1\\end{vmatrix} \\\\  & =2(3\\cdot 5-3\\cdot 1)-2(1\\cdot 5-3\\cdot 0)+(1\\cdot 1-3\\cdot 0) \\\\  & =2(15-3)-2(5)+1 \\\\  & =24-10+1 \\\\  & =15.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|15|=15.\n$$"}] [{:db/id #edb/ref 17592186662822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0dbb826-6ad6-524c-ae91-a9020724cb88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186662679}] :answer-field/correct {:answer/id #uuid "d0dbb826-6ad6-524c-ae91-a9020724cb88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186662679} :answer-field/id #uuid "9d7f6f03-42d3-5419-b029-eeb31a0a4b98" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186662767}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "533d9cf4-22ab-545e-bf03-703d5931d532" :question/math-academy-id "q-280719" :question/problem "Find $k$ given that the vectors $x=⟨1,3,2⟩$, $y=⟨0,-1,k⟩$, and $z=⟨2,5,1⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =\\begin{vmatrix}1 & 3 & 2 \\\\ 0 & -1 & k \\\\ 2 & 5 & 1\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-1 & k \\\\ 5 & 1\\end{vmatrix}-3\\cdot \\begin{vmatrix}0 & k \\\\ 2 & 1\\end{vmatrix}+2\\cdot \\begin{vmatrix}0 & -1 \\\\ 2 & 5\\end{vmatrix} \\\\  & =1(-1\\cdot 1-5\\cdot k)-3(0\\cdot 1-k\\cdot 2)+2(0\\cdot 5-(-1)\\cdot 2) \\\\  & =(-1-5k)+6k+4 \\\\  & =k+3\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =0 \\\\ k+3 & =0 \\\\ k & =-3\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-3.$"}] [{:db/id #edb/ref 17592186662860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "764b55a6-37ea-50d5-8e2a-00623691a389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186662584}] :answer-field/correct {:answer/id #uuid "764b55a6-37ea-50d5-8e2a-00623691a389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186662584} :answer-field/id #uuid "6d7afc67-e398-5850-8a9f-c61c4dd87686" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186662755}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fccddec8-d857-5b0f-b38d-28ea20b2d9ec" :question/math-academy-id "q-281024" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(1,2,2),$ $B(4,2,1),$ $C(1,4,4),$ and $D(4,3,1).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(4i+2j+k)-(i+2j+2k) \\\\  & =3i+0j-k \\\\  & =⟨3,0,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+4j+4k)-(i+2j+2k) \\\\  & =0i+2j+2k \\\\  & =⟨0,2,2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(4i+3j+k)-(i+2j+2k) \\\\  & =3i+j-k \\\\  & =⟨3,1,-1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}3 & 0 & -1 \\\\ 0 & 2 & 2 \\\\ 3 & 1 & -1\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}2 & 2 \\\\ 1 & -1\\end{vmatrix}-0\\cdot \\begin{vmatrix}0 & 2 \\\\ 3 & -1\\end{vmatrix}+(-1)\\cdot \\begin{vmatrix}0 & 2 \\\\ 3 & 1\\end{vmatrix} \\\\  & =3(2\\cdot (-1)-2\\cdot 1)-0+(-1)(0\\cdot 1-2\\cdot 3) \\\\  & =3(-2-2)+6 \\\\  & =-12+6 \\\\  & =-6.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-6|=6.\n$$"}] [{:db/id #edb/ref 17592186720309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0897ce-0f27-5f3c-8aa2-a63efd3e2221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186720307}] :answer-field/correct {:answer/id #uuid "0e0897ce-0f27-5f3c-8aa2-a63efd3e2221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186720307} :answer-field/id #uuid "4b2aa70c-df1e-5f3e-a4b7-32568bf341cf" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720310}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3c03dded-a341-51ce-a207-2b6e5b26d0db" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle1,2,1\\rangle,\\\\\n\\mathbf{b}&=\\langle-1,1,2\\rangle,\\\\\n\\mathbf{c}&=\\langle2,-1,1\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume $V$ of the parallelepiped whose three edge vectors are $\\mathbf{a}+\\mathbf{b}$, $\\mathbf{a}-\\mathbf{b}$, and $\\mathbf{c}$.\n\n$V=${{volume}}" :question/worked-solution "First form the actual edge vectors component by component:\n\n$$\n\\begin{aligned}\n\\mathbf{u}=\\mathbf{a}+\\mathbf{b}&=\\langle 1+(-1),2+1,1+2\\rangle=\\langle0,3,3\\rangle,\\\\\n\\mathbf{v}=\\mathbf{a}-\\mathbf{b}&=\\langle 1-(-1),2-1,1-2\\rangle=\\langle2,1,-1\\rangle,\\\\\n\\mathbf{w}=\\mathbf{c}&=\\langle2,-1,1\\rangle.\n\\end{aligned}\n$$\n\nThe volume is $V=|\\mathbf{u}\\cdot(\\mathbf{v}\\times\\mathbf{w})|$. Use these edge vectors, rather than $\\mathbf{a},\\mathbf{b},\\mathbf{c}$, as the determinant rows:\n\n$$\n\\begin{aligned}\n\\mathbf{u}\\cdot(\\mathbf{v}\\times\\mathbf{w})\n&=\\begin{vmatrix}0&3&3\\\\2&1&-1\\\\2&-1&1\\end{vmatrix}\\\\\n&=0-3\\begin{vmatrix}2&-1\\\\2&1\\end{vmatrix}+3\\begin{vmatrix}2&1\\\\2&-1\\end{vmatrix}\\\\\n&=-3(2\\cdot1-(-1)\\cdot2)+3(2(-1)-1\\cdot2)\\\\\n&=-3(4)+3(-4)\\\\\n&=-24.\n\\end{aligned}\n$$\n\nTaking the absolute value gives\n\n$$\nV=|-24|=24.\n$$\n\nThe two mixed edges are not parallel simply because both are made from $\\mathbf{a}$ and $\\mathbf{b}$. Subtracting the vectors also requires subtracting each signed component."}] [{:db/id #edb/ref 17592186720316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "289d8a25-99c4-53ee-abb9-4d6ec44bf683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186720308} {:answer/id #uuid "60669324-58dc-5531-b914-ac832f711619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186720313} {:answer/id #uuid "69a98c7b-f172-5edf-8234-034308229e18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186720314} {:answer/id #uuid "93cd9ddb-29f5-59d2-9909-95a64da69e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186720315} {:answer/id #uuid "b0a10115-089c-54de-bb6e-8646d0d6f277" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186720317}] :answer-field/correct {:answer/id #uuid "93cd9ddb-29f5-59d2-9909-95a64da69e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186720315} :answer-field/id #uuid "c0fefa8f-480f-5314-8766-7f49518fa583" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720318}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9554955e-855e-5082-ac79-b252f334e554" :question/problem "Calculate the volume of the parallelepiped spanned by $\\mathbf{a}=\\langle 1,2,0\\rangle$, $\\mathbf{b}=\\langle 0,1,2\\rangle$, and $\\mathbf{c}=\\langle -3,0,1\\rangle$.\n\n![A parallelepiped with three edge vectors a, b, and c](images/25/2597b48a010607fca71c551dbce8e9e2bbeda47d0892a582347ae1cdf19f1bf6.png)\n\nThe diagram is schematic and is not to scale." :question/worked-solution "The volume is the absolute value of the scalar triple product:\n\n$$\nV=|\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})|.\n$$\n\nUse the edge vectors as the rows of a determinant. Expanding along the first row gives\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})\n&=\\begin{vmatrix}1&2&0\\\\0&1&2\\\\-3&0&1\\end{vmatrix}\\\\\n&=1\\begin{vmatrix}1&2\\\\0&1\\end{vmatrix}-2\\begin{vmatrix}0&2\\\\-3&1\\end{vmatrix}+0\\\\\n&=1(1\\cdot1-2\\cdot0)-2(0\\cdot1-2(-3))\\\\\n&=1-12=-11.\n\\end{aligned}\n$$\n\nThe triple product is signed, but volume is nonnegative. Therefore\n\n$$\nV=|-11|=11.\n$$"}] [{:db/id #edb/ref 17592186720319 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ed0c610-3a1c-57fa-804e-bd298abc7ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186720311}] :answer-field/correct {:answer/id #uuid "4ed0c610-3a1c-57fa-804e-bd298abc7ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186720311} :answer-field/id #uuid "56abd9b3-c04f-523b-a173-1e8151f66d47" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720312}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f392547e-4c12-5e31-881f-fa3eb0a707a3" :question/problem "Suppose $\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})=-5$. Calculate the volume $V$ of the parallelepiped whose three edge vectors are $2\\mathbf{b}$, $\\mathbf{c}$, and $3\\mathbf{a}$.\n\n$V=${{volume}}" :question/worked-solution "The volume is the absolute value of the scalar triple product of the actual edge vectors:\n\n$$\nV=|(2\\mathbf{b})\\cdot(\\mathbf{c}\\times3\\mathbf{a})|.\n$$\n\nFactor out the two scale factors. A cyclic change from $\\mathbf{a},\\mathbf{b},\\mathbf{c}$ to $\\mathbf{b},\\mathbf{c},\\mathbf{a}$ preserves the scalar triple product:\n\n$$\n\\begin{aligned}\n(2\\mathbf{b})\\cdot(\\mathbf{c}\\times3\\mathbf{a})\n&=6\\,\\mathbf{b}\\cdot(\\mathbf{c}\\times\\mathbf{a})\\\\\n&=6\\,\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})\\\\\n&=6(-5)=-30.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|-30|=30.\n$$\n\nScaling two different edges multiplies their scale factors; it does not add or square them."}] [{:db/id #edb/ref 17592186720321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a5cd9ef-43c4-5838-846e-4aa5cb7b9fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186720320} {:answer/id #uuid "22f4881e-2ad7-5489-aebc-2307151882cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186720323} {:answer/id #uuid "94e6ff3f-24a2-59b9-8252-a8063aef04f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186720328} {:answer/id #uuid "c2cecd9d-281f-5704-afc8-96d841db0075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186720331} {:answer/id #uuid "d4c6d4a5-f6d5-5b51-878c-8a2587e86ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186720334}] :answer-field/correct {:answer/id #uuid "1a5cd9ef-43c4-5838-846e-4aa5cb7b9fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186720320} :answer-field/id #uuid "bd8f39d4-9272-5e86-b4ac-bae4a90b619f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720330}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1b76e67c-91d7-59f0-9114-a310b5537a1d" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=\\langle k,1,1\\rangle$, $\\mathbf{b}=\\langle 1,0,1\\rangle$, and $\\mathbf{c}=\\langle 0,1,2\\rangle$ are coplanar.\n\nThe first-row expansion of their scalar triple product is provided:\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})&=k(0\\cdot2-1\\cdot1)\\\\\n&\\quad -(1\\cdot2-1\\cdot0)\\\\\n&\\quad +(1\\cdot1-0\\cdot0).\n\\end{aligned}\n$$\n\nSelect the value of $k$." :question/worked-solution "Three vectors are coplanar if and only if their scalar triple product is zero. Simplify the supplied expansion:\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})&=k(0-1)-(2-0)+(1-0)\\\\\n&=-k-2+1\\\\\n&=-k-1.\n\\end{aligned}\n$$\n\nSet this equal to zero and solve:\n\n$$\n\\begin{aligned}\n-k-1&=0\\\\\n-k&=1\\\\\nk&=-1.\n\\end{aligned}\n$$\n\nThus the vectors are coplanar exactly when $k=-1$. At this value the triple product is $-(-1)-1=0$, so the parallelepiped spanned by the vectors has zero volume."}] [{:db/id #edb/ref 17592186720332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2cbce2-fd1d-5287-ac2f-a15e75839a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186720322}] :answer-field/correct {:answer/id #uuid "1e2cbce2-fd1d-5287-ac2f-a15e75839a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186720322} :answer-field/id #uuid "570079d8-403b-503a-a793-9d026280ffaf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720324}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c3a7a2c8-87c9-51aa-b826-1fa2edadbdb5" :question/problem "Find $t$ given that the vectors $\\mathbf{p}=\\langle t,2,t\\rangle$, $\\mathbf{q}=\\langle 1,2,-1\\rangle$, and $\\mathbf{r}=\\langle 2,1,3\\rangle$ are coplanar.\n\n$t=${{field-1}}" :question/worked-solution "The vectors are coplanar if and only if $\\mathbf{p}\\cdot(\\mathbf{q}\\times\\mathbf{r})=0$. Compute the triple product as a determinant, expanding along its first row:\n\n$$\n\\begin{aligned}\n\\mathbf{p}\\cdot(\\mathbf{q}\\times\\mathbf{r})\n&=\\begin{vmatrix}t&2&t\\\\1&2&-1\\\\2&1&3\\end{vmatrix}\\\\\n&=t\\begin{vmatrix}2&-1\\\\1&3\\end{vmatrix}\n-2\\begin{vmatrix}1&-1\\\\2&3\\end{vmatrix}\\\\\n&\\quad +t\\begin{vmatrix}1&2\\\\2&1\\end{vmatrix}\\\\\n&=t(2\\cdot3-(-1)\\cdot1)-2(1\\cdot3-(-1)\\cdot2)\\\\\n&\\quad +t(1\\cdot1-2\\cdot2)\\\\\n&=7t-10-3t\\\\\n&=4t-10.\n\\end{aligned}\n$$\n\nBoth occurrences of $t$ contribute to the equation. Setting the triple product equal to zero gives\n\n$$\n\\begin{aligned}\n4t-10&=0\\\\\n4t&=10\\\\\nt&=\\frac{5}{2}.\n\\end{aligned}\n$$\n\nTherefore, the vectors are coplanar exactly when $t=\\frac{5}{2}$. Substitution gives $4\\cdot\\frac{5}{2}-10=0$."}] [{:db/id #edb/ref 17592186720333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cbefd0b-91fc-5909-92ed-e06c894f6654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186720327}] :answer-field/correct {:answer/id #uuid "7cbefd0b-91fc-5909-92ed-e06c894f6654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186720327} :answer-field/id #uuid "62ac0587-ca0e-5bb2-a543-29c377764fef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720325} {:answer-field/choices [{:answer/id #uuid "68456afa-9d6c-5475-9ae0-51c0a84f3f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186720326}] :answer-field/correct {:answer/id #uuid "68456afa-9d6c-5475-9ae0-51c0a84f3f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186720326} :answer-field/id #uuid "ad5d4973-48f2-5c55-8f70-0c3d15ae573b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720329}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cb6ade61-6399-520b-a96d-7d6d93814f1d" :question/problem "Find all real values of $k$ for which the vectors $\\mathbf{a}=\\langle 3,k^2,3\\rangle$, $\\mathbf{b}=\\langle 1,3,2\\rangle$, and $\\mathbf{c}=\\langle 2,-1,1\\rangle$ are coplanar.\n\nEnter the two values in ascending order, using exact values.\n\n$k=${{field-1}} and $k=${{field-2}}" :question/worked-solution "Three vectors are coplanar if and only if their scalar triple product is zero. Expanding along the first row gives\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})\n&=\\begin{vmatrix}3&k^2&3\\\\1&3&2\\\\2&-1&1\\end{vmatrix}\\\\\n&=3\\begin{vmatrix}3&2\\\\-1&1\\end{vmatrix}\n-k^2\\begin{vmatrix}1&2\\\\2&1\\end{vmatrix}\\\\\n&\\quad +3\\begin{vmatrix}1&3\\\\2&-1\\end{vmatrix}\\\\\n&=3(3\\cdot1-2\\cdot(-1))-k^2(1\\cdot1-2\\cdot2)\\\\\n&\\quad +3(1\\cdot(-1)-3\\cdot2)\\\\\n&=3(5)-k^2(-3)+3(-7)\\\\\n&=15+3k^2-21\\\\\n&=3k^2-6.\n\\end{aligned}\n$$\n\nSet the triple product equal to zero:\n\n$$\n\\begin{aligned}\n3k^2-6&=0\\\\\n3k^2&=6\\\\\nk^2&=2\\\\\nk&=\\pm\\sqrt{2}.\n\\end{aligned}\n$$\n\nBoth signs must be retained because either value has square $2$. In ascending order, the values are $-\\sqrt{2}$ and $\\sqrt{2}$. For each, the triple product is $3(2)-6=0$, so both make the vectors coplanar."}] [{:db/id #edb/ref 17592186720466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e9d99e-a0ca-5308-8060-f0db1af542cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186720462} {:answer/id #uuid "6f7f2907-6ccb-5a8b-bfca-647530bc1232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186720468} {:answer/id #uuid "a4471919-95e2-51d4-a29b-646e1568e36d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186720473} {:answer/id #uuid "a9e69b2b-dec2-51d6-9bfb-9f6fd9eac8c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186720475} {:answer/id #uuid "d0b0c745-5b2d-551c-941f-0870d1ab1650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186720476}] :answer-field/correct {:answer/id #uuid "08e9d99e-a0ca-5308-8060-f0db1af542cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186720462} :answer-field/id #uuid "0e18d67c-1ada-58fb-acb9-cb88f0afe510" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720463}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "582b1ada-941b-55e8-9846-d25bf46b6f65" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\nA(1,-1,2),\\quad B(2,1,2),\\quad C(0,0,4),\\quad D(3,-1,3).\n$$\n\nSelect the volume in cubic units." :question/worked-solution "First find the displacement vectors from the common vertex $A$:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle2-1,1-(-1),2-2\\rangle=\\langle1,2,0\\rangle,\\\\\n\\overrightarrow{AC}&=\\langle0-1,0-(-1),4-2\\rangle=\\langle-1,1,2\\rangle,\\\\\n\\overrightarrow{AD}&=\\langle3-1,-1-(-1),3-2\\rangle=\\langle2,0,1\\rangle.\n\\end{aligned}\n$$\n\nLet $T=\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})$. Expand its determinant along the first row. The cofactor signs are $+,-,+$:\n\n$$\n\\begin{aligned}\nT&=\\begin{vmatrix}1 & 2 & 0 \\\\ -1 & 1 & 2 \\\\ 2 & 0 & 1\\end{vmatrix}\\\\\n&=1\\begin{vmatrix}1 & 2 \\\\ 0 & 1\\end{vmatrix}-2\\begin{vmatrix}-1 & 2 \\\\ 2 & 1\\end{vmatrix}+0\\begin{vmatrix}-1 & 1 \\\\ 2 & 0\\end{vmatrix}\\\\\n&=1(1\\cdot1-2\\cdot0)-2((-1)\\cdot1-2\\cdot2)+0\\\\\n&=1-2(-5)\\\\\n&=11.\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\nV=|11|=11\\text{ cubic units}.\n$$\n\nBoth nonzero cofactor contributions are needed. The middle contribution is positive because the cofactor sign and its minor are both negative. There is no division by six: that factor would give a tetrahedron's volume."}] [{:db/id #edb/ref 17592186720470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3620afe7-e03e-5d7a-8ff0-a25ab0d3ee09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186720464} {:answer/id #uuid "3a1be3bd-89d2-55b3-887b-bdd12b748140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186720465} {:answer/id #uuid "690258af-227c-56d8-a4f3-37af202e07b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186720467} {:answer/id #uuid "a4761454-500b-5082-bc73-f99a2d33b78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186720474} {:answer/id #uuid "f1ae4450-7180-543e-9f61-ece38e67a18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186720477}] :answer-field/correct {:answer/id #uuid "a4761454-500b-5082-bc73-f99a2d33b78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186720474} :answer-field/id #uuid "71a0ca03-8fa8-5671-9a12-8b5748e99cab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720469}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7952a797-6c64-5312-8a8d-97e8e965de46" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\nA(3,1,1),\\quad B(1,1,1),\\quad C(4,4,1),\\quad D(3,2,3).\n$$\n\nFirst subtract the coordinates of $A$ from each endpoint to find the three edge vectors. Then use\n\n$$\nV=\\left|\\overrightarrow{AB}\\cdot\\left(\\overrightarrow{AC}\\times\\overrightarrow{AD}\\right)\\right|.\n$$\n\nThe schematic shows the three edges meeting at a common vertex, with $\\mathbf{a}=\\overrightarrow{AB}$, $\\mathbf{b}=\\overrightarrow{AC}$, and $\\mathbf{c}=\\overrightarrow{AD}$.\n\n![](images/25/2597b48a010607fca71c551dbce8e9e2bbeda47d0892a582347ae1cdf19f1bf6.png)\n\nSelect the volume in cubic units." :question/worked-solution "Form each displacement vector by subtracting the common starting point $A$:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle 1-3,1-1,1-1\\rangle=\\langle-2,0,0\\rangle,\\\\\n\\overrightarrow{AC}&=\\langle 4-3,4-1,1-1\\rangle=\\langle1,3,0\\rangle,\\\\\n\\overrightarrow{AD}&=\\langle 3-3,2-1,3-1\\rangle=\\langle0,1,2\\rangle.\n\\end{aligned}\n$$\n\nThe scalar triple product is the determinant with these edge vectors as rows. Expanding along the first row, the two zero entries leave just one term:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})\n&=\\begin{vmatrix}-2 & 0 & 0 \\\\ 1 & 3 & 0 \\\\ 0 & 1 & 2\\end{vmatrix}\\\\\n&=(-2)\\begin{vmatrix}3 & 0 \\\\ 1 & 2\\end{vmatrix}\\\\\n&=(-2)(3\\cdot2-0\\cdot1)\\\\\n&=-12.\n\\end{aligned}\n$$\n\nVolume is the absolute value of the triple product, so\n\n$$\nV=|-12|=12\\text{ cubic units}.\n$$\n\nThe negative triple product describes orientation; it does not give a negative volume. Using the position vectors of $B$, $C$, and $D$ without subtracting $A$ would give the wrong edges."}] [{:db/id #edb/ref 17592186720471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2ffabf9-1d14-577b-afcc-7185cb50e025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186720478}] :answer-field/correct {:answer/id #uuid "f2ffabf9-1d14-577b-afcc-7185cb50e025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186720478} :answer-field/id #uuid "8467c352-a631-5013-a4e4-bc77eaea45f8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720472}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8352e5f5-2e9a-5ce6-830c-5d41b93f38ec" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\nA(-1,2,-1),\\quad B(1,1,0),\\quad C(0,3,0),\\quad D(0,4,-3).\n$$\n\nEnter the volume in cubic units.\n\n$V=$ {{field-1}}" :question/worked-solution "Subtract $A$ from each endpoint to obtain the three edge vectors:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle1-(-1),1-2,0-(-1)\\rangle=\\langle2,-1,1\\rangle,\\\\\n\\overrightarrow{AC}&=\\langle0-(-1),3-2,0-(-1)\\rangle=\\langle1,1,1\\rangle,\\\\\n\\overrightarrow{AD}&=\\langle0-(-1),4-2,-3-(-1)\\rangle=\\langle1,2,-2\\rangle.\n\\end{aligned}\n$$\n\nLet $T=\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})$. All three first-row cofactor contributions are nonzero:\n\n$$\n\\begin{aligned}\nT&=\\begin{vmatrix}2 & -1 & 1 \\\\ 1 & 1 & 1 \\\\ 1 & 2 & -2\\end{vmatrix}\\\\\n&=2\\begin{vmatrix}1 & 1 \\\\ 2 & -2\\end{vmatrix}-(-1)\\begin{vmatrix}1 & 1 \\\\ 1 & -2\\end{vmatrix}+1\\begin{vmatrix}1 & 1 \\\\ 1 & 2\\end{vmatrix}\\\\\n&=2(1\\cdot(-2)-1\\cdot2)\\\\\n&\\quad{}-(-1)(1\\cdot(-2)-1\\cdot1)\\\\\n&\\quad{}+1(1\\cdot2-1\\cdot1)\\\\\n&=2(-4)+(-3)+1\\\\\n&=-8-3+1\\\\\n&=-10.\n\\end{aligned}\n$$\n\nThe required volume is the absolute value:\n\n$$\nV=|-10|=10\\text{ cubic units}.\n$$\n\nUsing the endpoint position vectors instead of the displacement vectors changes the solid. Taking the absolute value of each cofactor term separately is also incorrect: combine the signed contributions before taking the absolute value."}] [{:db/id #edb/ref 17592186720502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4755740-83be-59ac-8c0e-25786913ece3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186720529}] :answer-field/correct {:answer/id #uuid "f4755740-83be-59ac-8c0e-25786913ece3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186720529} :answer-field/id #uuid "a65240a8-2a3a-54b1-b0c9-b2c583ff120b" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720519}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15df1f4b-541e-588d-9f56-3f9c46801c66" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle -4,-1,3\\rangle,\\\\\n\\mathbf{b}&=\\langle 2,0,-4\\rangle,\\\\\n\\mathbf{c}&=\\langle -3,3,4\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume $V$ of the parallelepiped spanned by these three vectors.\n\n$V=${{volume}}" :question/worked-solution "The volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}-4&-1&3\\\\2&0&-4\\\\-3&3&4\\end{vmatrix}\\\\\n&=(-4)\\cdot \\begin{vmatrix}0&-4\\\\3&4\\end{vmatrix}\\\\\n&\\quad -(-1)\\cdot \\begin{vmatrix}2&-4\\\\-3&4\\end{vmatrix}\\\\\n&\\quad +3\\cdot \\begin{vmatrix}2&0\\\\-3&3\\end{vmatrix}\\\\\n&=(-4)(0\\cdot 4-(-4)\\cdot 3)\\\\\n&\\quad -(-1)(2\\cdot 4-(-4)\\cdot (-3))\\\\\n&\\quad +3(2\\cdot 3-0\\cdot (-3))\\\\\n&=(-48)+(-4)+18=-34.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|-34|=34.\n$$"}] [{:db/id #edb/ref 17592186720503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7de40f-3d6d-5da0-9bac-5f56fa0175be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186720501} {:answer/id #uuid "2fce9826-2ce7-5d38-9349-64d343cb2a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186720506} {:answer/id #uuid "61a3c189-5eeb-5e14-99fd-c2c03abbf741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186720510} {:answer/id #uuid "a25956fc-5025-5756-bbe0-3c2c6beab066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186720516} {:answer/id #uuid "d3fe4f32-44ef-5242-9ca4-c62da0586ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186720523}] :answer-field/correct {:answer/id #uuid "2fce9826-2ce7-5d38-9349-64d343cb2a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186720506} :answer-field/id #uuid "4d051f71-f1b2-5e11-bc80-1bb49996b9d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720508}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1ce988c5-31c6-5960-877c-f08661bb0a8c" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle 2,2,-2\\rangle,\\\\\n\\mathbf{b}&=\\langle 4,0,-1\\rangle,\\\\\n\\mathbf{c}&=\\langle -3,-4,-4\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume of the parallelepiped spanned by these three vectors." :question/worked-solution "The volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}2&2&-2\\\\4&0&-1\\\\-3&-4&-4\\end{vmatrix}\\\\\n&=2\\cdot \\begin{vmatrix}0&-1\\\\-4&-4\\end{vmatrix}\\\\\n&\\quad -2\\cdot \\begin{vmatrix}4&-1\\\\-3&-4\\end{vmatrix}\\\\\n&\\quad +(-2)\\cdot \\begin{vmatrix}4&0\\\\-3&-4\\end{vmatrix}\\\\\n&=2(0\\cdot (-4)-(-1)\\cdot (-4))\\\\\n&\\quad -2(4\\cdot (-4)-(-1)\\cdot (-3))\\\\\n&\\quad +(-2)(4\\cdot (-4)-0\\cdot (-3))\\\\\n&=(-8)+38+32=62.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|62|=62.\n$$"}] [{:db/id #edb/ref 17592186720524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064368b2-817f-5a32-8812-0b31a36f850a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186720500} {:answer/id #uuid "3eace146-36ff-5e8f-af47-326c12aa9f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186720507} {:answer/id #uuid "5ff9286d-ba96-525e-81cd-9b6da32ba877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186720509} {:answer/id #uuid "72883ae3-d0fb-513e-8430-3ea3388bdd7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186720512} {:answer/id #uuid "db331b17-5967-5d83-8403-94be53e0166b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186720525}] :answer-field/correct {:answer/id #uuid "72883ae3-d0fb-513e-8430-3ea3388bdd7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186720512} :answer-field/id #uuid "29c84c4c-9742-5e35-8f8f-8ac2bce618ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720505}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d44d0ce3-f8d4-5aac-a39c-228edb9ea66c" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle 3,-4,1\\rangle,\\\\\n\\mathbf{b}&=\\langle -1,2,-4\\rangle,\\\\\n\\mathbf{c}&=\\langle 2,-3,0\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume of the parallelepiped spanned by these three vectors." :question/worked-solution "The volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}3&-4&1\\\\-1&2&-4\\\\2&-3&0\\end{vmatrix}\\\\\n&=3\\cdot \\begin{vmatrix}2&-4\\\\-3&0\\end{vmatrix}\\\\\n&\\quad -(-4)\\cdot \\begin{vmatrix}-1&-4\\\\2&0\\end{vmatrix}\\\\\n&\\quad +1\\cdot \\begin{vmatrix}-1&2\\\\2&-3\\end{vmatrix}\\\\\n&=3(2\\cdot 0-(-4)\\cdot (-3))\\\\\n&\\quad -(-4)((-1)\\cdot 0-(-4)\\cdot 2)\\\\\n&\\quad +1((-1)\\cdot (-3)-2\\cdot 2)\\\\\n&=(-36)+32+(-1)=-5.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|-5|=5.\n$$"}] [{:db/id #edb/ref 17592186720527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "208ee8c7-dcc9-547a-9ad4-2320feffb48e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186720504} {:answer/id #uuid "b197bf94-930d-5bed-85de-b05842d0a0c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186720520} {:answer/id #uuid "cb584001-6666-58a4-820a-6a214f3699b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186720521} {:answer/id #uuid "d133e732-d178-5403-9af0-9497a61fbbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186720522} {:answer/id #uuid "e42c578b-4f9b-5cad-9e7c-7f5688c015c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186720526}] :answer-field/correct {:answer/id #uuid "b197bf94-930d-5bed-85de-b05842d0a0c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186720520} :answer-field/id #uuid "f7b55711-b861-5be1-abca-3527450b691f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720530}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e5cb224e-1cc1-5d8f-8d8e-759f35bd9042" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle 0,3,1\\rangle,\\\\\n\\mathbf{b}&=\\langle 4,-1,-2\\rangle,\\\\\n\\mathbf{c}&=\\langle -1,-4,0\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume of the parallelepiped spanned by these three vectors." :question/worked-solution "The volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}0&3&1\\\\4&-1&-2\\\\-1&-4&0\\end{vmatrix}\\\\\n&=0\\cdot \\begin{vmatrix}-1&-2\\\\-4&0\\end{vmatrix}\\\\\n&\\quad -3\\cdot \\begin{vmatrix}4&-2\\\\-1&0\\end{vmatrix}\\\\\n&\\quad +1\\cdot \\begin{vmatrix}4&-1\\\\-1&-4\\end{vmatrix}\\\\\n&=0((-1)\\cdot 0-(-2)\\cdot (-4))\\\\\n&\\quad -3(4\\cdot 0-(-2)\\cdot (-1))\\\\\n&\\quad +1(4\\cdot (-4)-(-1)\\cdot (-1))\\\\\n&=0+6+(-17)=-11.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|-11|=11.\n$$"}] [{:db/id #edb/ref 17592186720528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68ca0cd3-2f76-58d3-a141-60c7a08a9bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186720511} {:answer/id #uuid "892faa2b-2cd7-5c74-88c2-530e92c9a7fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186720513} {:answer/id #uuid "9ac75d18-61a7-5c13-bb4e-0f8dae527b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186720514} {:answer/id #uuid "9de6e7d6-89e8-539a-a4c2-bbe8629785bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186720515} {:answer/id #uuid "a4bd204e-d76a-5a76-b53d-1fe97219f155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186720517}] :answer-field/correct {:answer/id #uuid "68ca0cd3-2f76-58d3-a141-60c7a08a9bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186720511} :answer-field/id #uuid "a548cf09-9880-59fe-913d-b56e87072fe9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720518}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee2c3b77-2cbd-5535-ba4e-f0846f78bba8" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle -3,1,3\\rangle,\\\\\n\\mathbf{b}&=\\langle 3,0,1\\rangle,\\\\\n\\mathbf{c}&=\\langle -1,4,-3\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume of the parallelepiped spanned by these three vectors." :question/worked-solution "The volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}-3&1&3\\\\3&0&1\\\\-1&4&-3\\end{vmatrix}\\\\\n&=(-3)\\cdot \\begin{vmatrix}0&1\\\\4&-3\\end{vmatrix}\\\\\n&\\quad -1\\cdot \\begin{vmatrix}3&1\\\\-1&-3\\end{vmatrix}\\\\\n&\\quad +3\\cdot \\begin{vmatrix}3&0\\\\-1&4\\end{vmatrix}\\\\\n&=(-3)(0\\cdot (-3)-1\\cdot 4)\\\\\n&\\quad -1(3\\cdot (-3)-1\\cdot (-1))\\\\\n&\\quad +3(3\\cdot 4-0\\cdot (-1))\\\\\n&=12+8+36=56.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|56|=56.\n$$"}] [{:db/id #edb/ref 17592186720603 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3192ad-4fce-5803-a231-cb96018bfa2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "86" :db/id #edb/ref 17592186720604}] :answer-field/correct {:answer/id #uuid "1d3192ad-4fce-5803-a231-cb96018bfa2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "86" :db/id #edb/ref 17592186720604} :answer-field/id #uuid "5692b42a-152f-560f-b597-4d81a1f84c0d" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720606}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "072f14de-7588-50db-831a-865ccb6ce514" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle -2,3,-2\\rangle,\\\\\n\\mathbf{b}&=\\langle 3,-3,-1\\rangle,\\\\\n\\mathbf{c}&=\\langle 2,2,3\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume $V$ of the parallelepiped whose three edge vectors are\n\n$$\n\\mathbf{b},\\quad -\\mathbf{a}+\\mathbf{c},\\quad \\mathbf{a}+\\mathbf{c}.\n$$\n\n$V=${{volume}}" :question/worked-solution "First form the actual edge vectors component by component:\n\n$$\n\\begin{aligned}\n\\mathbf{u}&=\\mathbf{b}\\\\\n&=\\langle 3,(-3),(-1)\\rangle\\\\\n&=\\langle 3,-3,-1\\rangle.\\\\\n\\mathbf{v}&=-\\mathbf{a}+\\mathbf{c}\\\\\n&=\\langle -(-2)+2,-3+2,-(-2)+3\\rangle\\\\\n&=\\langle 4,-1,5\\rangle.\\\\\n\\mathbf{w}&=\\mathbf{a}+\\mathbf{c}\\\\\n&=\\langle (-2)+2,3+2,(-2)+3\\rangle\\\\\n&=\\langle 0,5,1\\rangle.\n\\end{aligned}\n$$\n\nThe volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}3&-3&-1\\\\4&-1&5\\\\0&5&1\\end{vmatrix}\\\\\n&=3\\cdot \\begin{vmatrix}-1&5\\\\5&1\\end{vmatrix}\\\\\n&\\quad -(-3)\\cdot \\begin{vmatrix}4&5\\\\0&1\\end{vmatrix}\\\\\n&\\quad +(-1)\\cdot \\begin{vmatrix}4&-1\\\\0&5\\end{vmatrix}\\\\\n&=3((-1)\\cdot 1-5\\cdot 5)\\\\\n&\\quad -(-3)(4\\cdot 1-5\\cdot 0)\\\\\n&\\quad +(-1)(4\\cdot 5-(-1)\\cdot 0)\\\\\n&=(-78)+12+(-20)=-86.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|-86|=86.\n$$"}] [{:db/id #edb/ref 17592186720607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85d62195-5a09-5947-8439-07ce6ed4838a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186720608}] :answer-field/correct {:answer/id #uuid "85d62195-5a09-5947-8439-07ce6ed4838a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186720608} :answer-field/id #uuid "8f47bc25-53e3-5dc6-99e1-a97fb0755b5c" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720610}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6073871e-22fc-54e8-b7a2-3ac64482c7ea" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle -3,0,0\\rangle,\\\\\n\\mathbf{b}&=\\langle 2,2,-2\\rangle,\\\\\n\\mathbf{c}&=\\langle 1,-2,3\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume $V$ of the parallelepiped whose three edge vectors are\n\n$$\n\\mathbf{a},\\quad \\mathbf{b}+\\mathbf{c},\\quad -\\mathbf{b}+\\mathbf{c}.\n$$\n\n$V=${{volume}}" :question/worked-solution "First form the actual edge vectors component by component:\n\n$$\n\\begin{aligned}\n\\mathbf{u}&=\\mathbf{a}\\\\\n&=\\langle (-3),0,0\\rangle\\\\\n&=\\langle -3,0,0\\rangle.\\\\\n\\mathbf{v}&=\\mathbf{b}+\\mathbf{c}\\\\\n&=\\langle 2+1,2+(-2),(-2)+3\\rangle\\\\\n&=\\langle 3,0,1\\rangle.\\\\\n\\mathbf{w}&=-\\mathbf{b}+\\mathbf{c}\\\\\n&=\\langle -2+1,-2+(-2),-(-2)+3\\rangle\\\\\n&=\\langle -1,-4,5\\rangle.\n\\end{aligned}\n$$\n\nThe volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}-3&0&0\\\\3&0&1\\\\-1&-4&5\\end{vmatrix}\\\\\n&=(-3)\\cdot \\begin{vmatrix}0&1\\\\-4&5\\end{vmatrix}\\\\\n&\\quad -0\\cdot \\begin{vmatrix}3&1\\\\-1&5\\end{vmatrix}\\\\\n&\\quad +0\\cdot \\begin{vmatrix}3&0\\\\-1&-4\\end{vmatrix}\\\\\n&=(-3)(0\\cdot 5-1\\cdot (-4))\\\\\n&\\quad -0(3\\cdot 5-1\\cdot (-1))\\\\\n&\\quad +0(3\\cdot (-4)-0\\cdot (-1))\\\\\n&=(-12)+0+0=-12.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|-12|=12.\n$$"}] [{:db/id #edb/ref 17592186720611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb74b8df-8d5f-5cf4-b53a-0a1e11988694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186720614}] :answer-field/correct {:answer/id #uuid "fb74b8df-8d5f-5cf4-b53a-0a1e11988694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186720614} :answer-field/id #uuid "8d4e45bb-6a1c-5a6a-b038-a1257e882501" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720609}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a00e6b69-0832-54f5-963b-49417f72d4f0" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle 2,1,-3\\rangle,\\\\\n\\mathbf{b}&=\\langle 3,-2,0\\rangle,\\\\\n\\mathbf{c}&=\\langle -2,0,-1\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume $V$ of the parallelepiped whose three edge vectors are\n\n$$\n\\mathbf{a}+\\mathbf{c},\\quad \\mathbf{a}-\\mathbf{c},\\quad \\mathbf{b}.\n$$\n\n$V=${{volume}}" :question/worked-solution "First form the actual edge vectors component by component:\n\n$$\n\\begin{aligned}\n\\mathbf{u}&=\\mathbf{a}+\\mathbf{c}\\\\\n&=\\langle 2+(-2),1+0,(-3)+(-1)\\rangle\\\\\n&=\\langle 0,1,-4\\rangle.\\\\\n\\mathbf{v}&=\\mathbf{a}-\\mathbf{c}\\\\\n&=\\langle 2-(-2),1-0,(-3)-(-1)\\rangle\\\\\n&=\\langle 4,1,-2\\rangle.\\\\\n\\mathbf{w}&=\\mathbf{b}\\\\\n&=\\langle 3,(-2),0\\rangle\\\\\n&=\\langle 3,-2,0\\rangle.\n\\end{aligned}\n$$\n\nThe volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}0&1&-4\\\\4&1&-2\\\\3&-2&0\\end{vmatrix}\\\\\n&=0\\cdot \\begin{vmatrix}1&-2\\\\-2&0\\end{vmatrix}\\\\\n&\\quad -1\\cdot \\begin{vmatrix}4&-2\\\\3&0\\end{vmatrix}\\\\\n&\\quad +(-4)\\cdot \\begin{vmatrix}4&1\\\\3&-2\\end{vmatrix}\\\\\n&=0(1\\cdot 0-(-2)\\cdot (-2))\\\\\n&\\quad -1(4\\cdot 0-(-2)\\cdot 3)\\\\\n&\\quad +(-4)(4\\cdot (-2)-1\\cdot 3)\\\\\n&=0+(-6)+44=38.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|38|=38.\n$$"}] [{:db/id #edb/ref 17592186720613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c7e0ef-d23f-5664-9a70-e80b06246475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186720605}] :answer-field/correct {:answer/id #uuid "51c7e0ef-d23f-5664-9a70-e80b06246475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186720605} :answer-field/id #uuid "c5d4e9af-a5a7-51e9-8bb4-e570221e1581" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720612}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d069a54b-bea8-5006-a5e5-4551ca8452c8" :question/problem "Let\n\n$$\n\\begin{aligned}\n\\mathbf{a}&=\\langle 0,0,1\\rangle,\\\\\n\\mathbf{b}&=\\langle 3,-1,0\\rangle,\\\\\n\\mathbf{c}&=\\langle 1,-2,2\\rangle.\n\\end{aligned}\n$$\n\nCalculate the volume $V$ of the parallelepiped whose three edge vectors are\n\n$$\n\\mathbf{b}-\\mathbf{c},\\quad \\mathbf{a}-\\mathbf{b},\\quad \\mathbf{c}.\n$$\n\n$V=${{volume}}" :question/worked-solution "First form the actual edge vectors component by component:\n\n$$\n\\begin{aligned}\n\\mathbf{u}&=\\mathbf{b}-\\mathbf{c}\\\\\n&=\\langle 3-1,(-1)-(-2),0-2\\rangle\\\\\n&=\\langle 2,1,-2\\rangle.\\\\\n\\mathbf{v}&=\\mathbf{a}-\\mathbf{b}\\\\\n&=\\langle 0-3,0-(-1),1-0\\rangle\\\\\n&=\\langle -3,1,1\\rangle.\\\\\n\\mathbf{w}&=\\mathbf{c}\\\\\n&=\\langle 1,(-2),2\\rangle\\\\\n&=\\langle 1,-2,2\\rangle.\n\\end{aligned}\n$$\n\nThe volume is the absolute value of the scalar triple product of the actual edge vectors. Use those edges as the determinant rows:\n\n$$\n\\begin{aligned}\nD&=\\begin{vmatrix}2&1&-2\\\\-3&1&1\\\\1&-2&2\\end{vmatrix}\\\\\n&=2\\cdot \\begin{vmatrix}1&1\\\\-2&2\\end{vmatrix}\\\\\n&\\quad -1\\cdot \\begin{vmatrix}-3&1\\\\1&2\\end{vmatrix}\\\\\n&\\quad +(-2)\\cdot \\begin{vmatrix}-3&1\\\\1&-2\\end{vmatrix}\\\\\n&=2(1\\cdot 2-1\\cdot (-2))\\\\\n&\\quad -1((-3)\\cdot 2-1\\cdot 1)\\\\\n&\\quad +(-2)((-3)\\cdot (-2)-1\\cdot 1)\\\\\n&=8+7+(-10)=5.\n\\end{aligned}\n$$\n\nFinally, take the absolute value:\n\n$$\nV=|5|=5.\n$$"}] [{:db/id #edb/ref 17592186720646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7014c4ad-6326-5f55-86cf-7e10f1273c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186720643}] :answer-field/correct {:answer/id #uuid "7014c4ad-6326-5f55-86cf-7e10f1273c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186720643} :answer-field/id #uuid "82925378-e956-587c-baf1-e54634ed4694" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720645}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a333e493-7709-5e5c-9970-5be5a636ed8d" :question/problem "Suppose $\\mathbf{a}\\cdot(\\mathbf{b}\\times \\mathbf{c})=-10$. Calculate the volume $V$ of the parallelepiped whose three edge vectors are $-2\\mathbf{c}$, $\\mathbf{b}$, $3\\mathbf{a}$.\n\n$V=${{volume}}" :question/worked-solution "The volume is the magnitude of the scalar triple product of the actual edges. Factor each edge scale out separately. An odd number of pairwise swaps reverses the triple product sign.\n\n$$\n\\begin{aligned}\nD&=(-2\\mathbf{c})\\cdot((\\mathbf{b})\\times(3\\mathbf{a}))\\\\\n&=-6\\bigl[\\mathbf{c}\\cdot(\\mathbf{b}\\times \\mathbf{a})\\bigr]\\\\\n&=-6\\cdot (-1)\\cdot (-10)=-60.\n\\end{aligned}\n$$\n\nTake the absolute value:\n\n$$\nV=|-60|=60.\n$$"}] [{:db/id #edb/ref 17592186720647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8fcdbe3-2f17-5c1e-bcbb-6e4b10ac68fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186720648}] :answer-field/correct {:answer/id #uuid "e8fcdbe3-2f17-5c1e-bcbb-6e4b10ac68fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186720648} :answer-field/id #uuid "601c1be8-9a20-5ef0-8d06-401230ba4768" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720642}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce2194e0-e55a-5ff4-b29e-6ff351c7b4ee" :question/problem "Suppose $\\mathbf{a}\\cdot(\\mathbf{b}\\times \\mathbf{c})=8$. Calculate the volume $V$ of the parallelepiped whose three edge vectors are $\\mathbf{c}$, $2\\mathbf{a}$, $2\\mathbf{b}$.\n\n$V=${{volume}}" :question/worked-solution "The volume is the magnitude of the scalar triple product of the actual edges. Factor each edge scale out separately. An even number of pairwise swaps preserves the triple product.\n\n$$\n\\begin{aligned}\nD&=(\\mathbf{c})\\cdot((2\\mathbf{a})\\times(2\\mathbf{b}))\\\\\n&=4\\bigl[\\mathbf{c}\\cdot(\\mathbf{a}\\times \\mathbf{b})\\bigr]\\\\\n&=4\\cdot 1\\cdot 8=32.\n\\end{aligned}\n$$\n\nTake the absolute value:\n\n$$\nV=|32|=32.\n$$"}] [{:db/id #edb/ref 17592186720649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce511d4-30ff-51fb-904e-fef2cd3141e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186720640}] :answer-field/correct {:answer/id #uuid "0ce511d4-30ff-51fb-904e-fef2cd3141e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186720640} :answer-field/id #uuid "09fc5900-bd18-56f9-967f-fbbe13a82ea1" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720639}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ead38d2c-e2fa-5556-b074-6d6dd76da492" :question/problem "Suppose $\\mathbf{a}\\cdot(\\mathbf{b}\\times \\mathbf{c})=-8$. Calculate the volume $V$ of the parallelepiped whose three edge vectors are $2\\mathbf{b}$, $-\\mathbf{c}$, $-2\\mathbf{a}$.\n\n$V=${{volume}}" :question/worked-solution "The volume is the magnitude of the scalar triple product of the actual edges. Factor each edge scale out separately. An even number of pairwise swaps preserves the triple product.\n\n$$\n\\begin{aligned}\nD&=(2\\mathbf{b})\\cdot((-\\mathbf{c})\\times(-2\\mathbf{a}))\\\\\n&=4\\bigl[\\mathbf{b}\\cdot(\\mathbf{c}\\times \\mathbf{a})\\bigr]\\\\\n&=4\\cdot 1\\cdot (-8)=-32.\n\\end{aligned}\n$$\n\nTake the absolute value:\n\n$$\nV=|-32|=32.\n$$"}] [{:db/id #edb/ref 17592186720650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "300f1356-e961-5be4-85a4-2a91d72269f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186720641}] :answer-field/correct {:answer/id #uuid "300f1356-e961-5be4-85a4-2a91d72269f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186720641} :answer-field/id #uuid "81709299-bdc4-5e6f-8728-a68053b30996" :answer-field/key "volume" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720644}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f24579d9-f493-58e8-9e5f-b53d2ff479fe" :question/problem "Suppose $\\mathbf{a}\\cdot(\\mathbf{b}\\times \\mathbf{c})=4$. Calculate the volume $V$ of the parallelepiped whose three edge vectors are $2\\mathbf{c}$, $\\mathbf{b}$, $3\\mathbf{a}$.\n\n$V=${{volume}}" :question/worked-solution "The volume is the magnitude of the scalar triple product of the actual edges. Factor each edge scale out separately. An odd number of pairwise swaps reverses the triple product sign.\n\n$$\n\\begin{aligned}\nD&=(2\\mathbf{c})\\cdot((\\mathbf{b})\\times(3\\mathbf{a}))\\\\\n&=6\\bigl[\\mathbf{c}\\cdot(\\mathbf{b}\\times \\mathbf{a})\\bigr]\\\\\n&=6\\cdot (-1)\\cdot 4=-24.\n\\end{aligned}\n$$\n\nTake the absolute value:\n\n$$\nV=|-24|=24.\n$$"}] [{:db/id #edb/ref 17592186720717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbb52271-eab9-56cb-80c5-be31ff567e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186720736}] :answer-field/correct {:answer/id #uuid "dbb52271-eab9-56cb-80c5-be31ff567e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186720736} :answer-field/id #uuid "77e023dd-2277-51d0-8a49-c5629993c2c1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720721}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "39372990-6d98-5b5b-8e78-8c833b33a360" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\n\\begin{aligned}\nA(2,-3,3),&\\quad B(5,-5,2),\\\\\nC(1,-4,2),&\\quad D(4,-5,2).\n\\end{aligned}\n$$\n\nEnter the volume in cubic units.\n\n$V=$ {{field-1}}" :question/worked-solution "Subtract the common vertex $A$ from each endpoint:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle5-2,-5-(-3),2-3\\rangle=\\langle3,-2,-1\\rangle\\\\\n\\overrightarrow{AC}&=\\langle1-2,-4-(-3),2-3\\rangle=\\langle-1,-1,-1\\rangle\\\\\n\\overrightarrow{AD}&=\\langle4-2,-5-(-3),2-3\\rangle=\\langle2,-2,-1\\rangle\n\\end{aligned}\n$$\n\nUse the scalar triple product:\n\n$T=\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})$.\n\n$$\n\\begin{aligned}\nT&=\\begin{vmatrix}3 & -2 & -1 \\\\ -1 & -1 & -1 \\\\ 2 & -2 & -1\\end{vmatrix}\n\\end{aligned}\n$$\n\nExpand along row $1$, whose cofactor signs are $+,-,+$. Zero entries make no contribution. Evaluate the needed minors:\n\n$$\n\\begin{aligned}\nM_1&=\\begin{vmatrix}-1 & -1 \\\\ -2 & -1\\end{vmatrix}\\\\\n&=(-1)\\cdot(-1)-(-1)\\cdot(-2)=-1\\\\\nM_2&=\\begin{vmatrix}-1 & -1 \\\\ 2 & -1\\end{vmatrix}\\\\\n&=(-1)\\cdot(-1)-(-1)\\cdot2=3\\\\\nM_3&=\\begin{vmatrix}-1 & -1 \\\\ 2 & -2\\end{vmatrix}\\\\\n&=(-1)\\cdot(-2)-(-1)\\cdot2=4\n\\end{aligned}\n$$\n\nCombine the signed contributions before taking the absolute value:\n\n$$\n\\begin{aligned}\nT&=3M_1+2M_2+(-1)M_3\\\\\n&=3\\cdot(-1)+2\\cdot3+(-1)\\cdot4\\\\\n&=(-3)+6+(-4)=-1\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\nV&=|-1|=1\\text{ cubic units}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdcac7b-0a3a-51eb-98ea-bbe596cc6ac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186720715} {:answer/id #uuid "473e7244-9858-52c3-a213-77a4dd92fe4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186720720} {:answer/id #uuid "b527d9b1-f168-5e06-82fb-f4383326ad32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186720730} {:answer/id #uuid "d8a9b37a-8f02-5d19-b19d-7e4e701277be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186720735} {:answer/id #uuid "f94938db-13c6-5123-a0bb-ee95148a7ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186720740}] :answer-field/correct {:answer/id #uuid "473e7244-9858-52c3-a213-77a4dd92fe4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186720720} :answer-field/id #uuid "9408a99f-982e-5826-acf1-295b92eef411" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720726}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "43ce8fd8-ed44-527d-bb40-61576e831b45" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\n\\begin{aligned}\nA(1,0,-2),&\\quad B(3,1,-1),\\\\\nC(3,2,-3),&\\quad D(4,3,-4).\n\\end{aligned}\n$$\n\nSelect the volume in cubic units." :question/worked-solution "Subtract the common vertex $A$ from each endpoint:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle3-1,1-0,-1-(-2)\\rangle=\\langle2,1,1\\rangle\\\\\n\\overrightarrow{AC}&=\\langle3-1,2-0,-3-(-2)\\rangle=\\langle2,2,-1\\rangle\\\\\n\\overrightarrow{AD}&=\\langle4-1,3-0,-4-(-2)\\rangle=\\langle3,3,-2\\rangle\n\\end{aligned}\n$$\n\nUse the scalar triple product:\n\n$T=\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})$.\n\n$$\n\\begin{aligned}\nT&=\\begin{vmatrix}2 & 1 & 1 \\\\ 2 & 2 & -1 \\\\ 3 & 3 & -2\\end{vmatrix}\n\\end{aligned}\n$$\n\nExpand along row $1$, whose cofactor signs are $+,-,+$. Zero entries make no contribution. Evaluate the needed minors:\n\n$$\n\\begin{aligned}\nM_1&=\\begin{vmatrix}2 & -1 \\\\ 3 & -2\\end{vmatrix}\\\\\n&=2\\cdot(-2)-(-1)\\cdot3=-1\\\\\nM_2&=\\begin{vmatrix}2 & -1 \\\\ 3 & -2\\end{vmatrix}\\\\\n&=2\\cdot(-2)-(-1)\\cdot3=-1\\\\\nM_3&=\\begin{vmatrix}2 & 2 \\\\ 3 & 3\\end{vmatrix}\\\\\n&=2\\cdot3-2\\cdot3=0\n\\end{aligned}\n$$\n\nCombine the signed contributions before taking the absolute value:\n\n$$\n\\begin{aligned}\nT&=2M_1+(-1)M_2+1M_3\\\\\n&=2\\cdot(-1)+(-1)\\cdot(-1)+1\\cdot0\\\\\n&=(-2)+1+0=-1\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\nV&=|-1|=1\\text{ cubic units}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbbe321-e55a-50e9-afda-df310e5f35df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186720714} {:answer/id #uuid "7dfba7a3-4c80-506c-bc7d-71b5af8088f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186720723} {:answer/id #uuid "d000b1a9-3676-5940-b5bd-00ad421e4901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "59" :db/id #edb/ref 17592186720731} {:answer/id #uuid "d738a0fa-da9a-5a23-9e86-4d6deb2a1bee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186720734} {:answer/id #uuid "e936a92a-0513-591e-be2d-8131f743c7f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186720738}] :answer-field/correct {:answer/id #uuid "7dfba7a3-4c80-506c-bc7d-71b5af8088f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186720723} :answer-field/id #uuid "9f834c64-e5f2-59b4-bef4-c764312674d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720728}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7aa1a8a5-f1ce-5444-8e11-561a63f6ba6c" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\n\\begin{aligned}\nA(-3,-2,3),&\\quad B(0,-1,1),\\\\\nC(-5,-5,1),&\\quad D(-1,-5,5).\n\\end{aligned}\n$$\n\nSelect the volume in cubic units." :question/worked-solution "Subtract the common vertex $A$ from each endpoint:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle0-(-3),-1-(-2),1-3\\rangle=\\langle3,1,-2\\rangle\\\\\n\\overrightarrow{AC}&=\\langle-5-(-3),-5-(-2),1-3\\rangle=\\langle-2,-3,-2\\rangle\\\\\n\\overrightarrow{AD}&=\\langle-1-(-3),-5-(-2),5-3\\rangle=\\langle2,-3,2\\rangle\n\\end{aligned}\n$$\n\nUse the scalar triple product:\n\n$T=\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})$.\n\n$$\n\\begin{aligned}\nT&=\\begin{vmatrix}3 & 1 & -2 \\\\ -2 & -3 & -2 \\\\ 2 & -3 & 2\\end{vmatrix}\n\\end{aligned}\n$$\n\nExpand along row $1$, whose cofactor signs are $+,-,+$. Zero entries make no contribution. Evaluate the needed minors:\n\n$$\n\\begin{aligned}\nM_1&=\\begin{vmatrix}-3 & -2 \\\\ -3 & 2\\end{vmatrix}\\\\\n&=(-3)\\cdot2-(-2)\\cdot(-3)=-12\\\\\nM_2&=\\begin{vmatrix}-2 & -2 \\\\ 2 & 2\\end{vmatrix}\\\\\n&=(-2)\\cdot2-(-2)\\cdot2=0\\\\\nM_3&=\\begin{vmatrix}-2 & -3 \\\\ 2 & -3\\end{vmatrix}\\\\\n&=(-2)\\cdot(-3)-(-3)\\cdot2=12\n\\end{aligned}\n$$\n\nCombine the signed contributions before taking the absolute value:\n\n$$\n\\begin{aligned}\nT&=3M_1+(-1)M_2+(-2)M_3\\\\\n&=3\\cdot(-12)+(-1)\\cdot0+(-2)\\cdot12\\\\\n&=(-36)+0+(-24)=-60\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\nV&=|-60|=60\\text{ cubic units}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a7a840-bd04-5c70-a112-d4726b0d1caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186720716}] :answer-field/correct {:answer/id #uuid "12a7a840-bd04-5c70-a112-d4726b0d1caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186720716} :answer-field/id #uuid "e5212169-483d-5e34-8d5b-0875b8258af5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720737}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a75b1a3e-25bb-511c-a9db-665c54399121" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\n\\begin{aligned}\nA(-3,2,-3),&\\quad B(-2,3,-5),\\\\\nC(-1,0,-2),&\\quad D(0,-1,-1).\n\\end{aligned}\n$$\n\nEnter the volume in cubic units.\n\n$V=$ {{field-1}}" :question/worked-solution "Subtract the common vertex $A$ from each endpoint:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle-2-(-3),3-2,-5-(-3)\\rangle=\\langle1,1,-2\\rangle\\\\\n\\overrightarrow{AC}&=\\langle-1-(-3),0-2,-2-(-3)\\rangle=\\langle2,-2,1\\rangle\\\\\n\\overrightarrow{AD}&=\\langle0-(-3),-1-2,-1-(-3)\\rangle=\\langle3,-3,2\\rangle\n\\end{aligned}\n$$\n\nUse the scalar triple product:\n\n$T=\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})$.\n\n$$\n\\begin{aligned}\nT&=\\begin{vmatrix}1 & 1 & -2 \\\\ 2 & -2 & 1 \\\\ 3 & -3 & 2\\end{vmatrix}\n\\end{aligned}\n$$\n\nExpand along row $1$, whose cofactor signs are $+,-,+$. Zero entries make no contribution. Evaluate the needed minors:\n\n$$\n\\begin{aligned}\nM_1&=\\begin{vmatrix}-2 & 1 \\\\ -3 & 2\\end{vmatrix}\\\\\n&=(-2)\\cdot2-1\\cdot(-3)=-1\\\\\nM_2&=\\begin{vmatrix}2 & 1 \\\\ 3 & 2\\end{vmatrix}\\\\\n&=2\\cdot2-1\\cdot3=1\\\\\nM_3&=\\begin{vmatrix}2 & -2 \\\\ 3 & -3\\end{vmatrix}\\\\\n&=2\\cdot(-3)-(-2)\\cdot3=0\n\\end{aligned}\n$$\n\nCombine the signed contributions before taking the absolute value:\n\n$$\n\\begin{aligned}\nT&=1M_1+(-1)M_2+(-2)M_3\\\\\n&=1\\cdot(-1)+(-1)\\cdot1+(-2)\\cdot0\\\\\n&=(-1)+(-1)+0=-2\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\nV&=|-2|=2\\text{ cubic units}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a554fce-7086-5194-81e6-e22c03e2ecbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186720718} {:answer/id #uuid "7ecadf92-ac30-55f1-8d4a-f73f6bd134a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186720724} {:answer/id #uuid "90a07bb1-430c-526a-bd3b-94f86399d539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186720725} {:answer/id #uuid "9e0beb5e-ccb2-5a75-a849-257c3f56653e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186720727} {:answer/id #uuid "ebec425a-e842-5985-84ea-b1c59a051c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186720739}] :answer-field/correct {:answer/id #uuid "ebec425a-e842-5985-84ea-b1c59a051c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186720739} :answer-field/id #uuid "d5972f1e-a7e0-580f-be8b-ca740b9ac70a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720732}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d620718d-122a-5275-99cf-0b7daa766314" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overrightarrow{AB}$, $\\overrightarrow{AC}$, and $\\overrightarrow{AD}$, given\n\n$$\n\\begin{aligned}\nA(1,3,-1),&\\quad B(-1,0,-3),\\\\\nC(-2,5,2),&\\quad D(-1,4,-3).\n\\end{aligned}\n$$\n\nSelect the volume in cubic units." :question/worked-solution "Subtract the common vertex $A$ from each endpoint:\n\n$$\n\\begin{aligned}\n\\overrightarrow{AB}&=\\langle-1-1,0-3,-3-(-1)\\rangle=\\langle-2,-3,-2\\rangle\\\\\n\\overrightarrow{AC}&=\\langle-2-1,5-3,2-(-1)\\rangle=\\langle-3,2,3\\rangle\\\\\n\\overrightarrow{AD}&=\\langle-1-1,4-3,-3-(-1)\\rangle=\\langle-2,1,-2\\rangle\n\\end{aligned}\n$$\n\nUse the scalar triple product:\n\n$T=\\overrightarrow{AB}\\cdot(\\overrightarrow{AC}\\times\\overrightarrow{AD})$.\n\n$$\n\\begin{aligned}\nT&=\\begin{vmatrix}-2 & -3 & -2 \\\\ -3 & 2 & 3 \\\\ -2 & 1 & -2\\end{vmatrix}\n\\end{aligned}\n$$\n\nExpand along row $1$, whose cofactor signs are $+,-,+$. Zero entries make no contribution. Evaluate the needed minors:\n\n$$\n\\begin{aligned}\nM_1&=\\begin{vmatrix}2 & 3 \\\\ 1 & -2\\end{vmatrix}\\\\\n&=2\\cdot(-2)-3\\cdot1=-7\\\\\nM_2&=\\begin{vmatrix}-3 & 3 \\\\ -2 & -2\\end{vmatrix}\\\\\n&=(-3)\\cdot(-2)-3\\cdot(-2)=12\\\\\nM_3&=\\begin{vmatrix}-3 & 2 \\\\ -2 & 1\\end{vmatrix}\\\\\n&=(-3)\\cdot1-2\\cdot(-2)=1\n\\end{aligned}\n$$\n\nCombine the signed contributions before taking the absolute value:\n\n$$\n\\begin{aligned}\nT&=(-2)M_1+3M_2+(-2)M_3\\\\\n&=(-2)\\cdot(-7)+3\\cdot12+(-2)\\cdot1\\\\\n&=14+36+(-2)=48\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\nV&=|48|=48\\text{ cubic units}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aceb5c90-4654-58c8-9dac-b505a1ac6d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{9}{4}" :db/id #edb/ref 17592186720790}] :answer-field/correct {:answer/id #uuid "aceb5c90-4654-58c8-9dac-b505a1ac6d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{9}{4}" :db/id #edb/ref 17592186720790} :answer-field/id #uuid "26cf9d83-bc16-54ff-8334-000b9b33ba08" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720782}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c2728e7-118d-5c91-b9fe-0c2cd9b83080" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=\\langle 0,-1,-4\\rangle$, $\\mathbf{b}=\\langle -2,-3,-1\\rangle$, and $\\mathbf{c}=\\langle -2,k,2\\rangle$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "The vectors are coplanar if and only if their scalar triple product is zero. Expanding along the first row gives\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})&=\\begin{vmatrix}0&-1&-4\\\\-2&-3&-1\\\\-2&k&2\\end{vmatrix}\\\\&=(0)\\cdot \\begin{vmatrix}-3&-1\\\\k&2\\end{vmatrix}\\\\&\\quad -(-1)\\cdot \\begin{vmatrix}-2&-1\\\\-2&2\\end{vmatrix}\\\\&\\quad +(-4)\\cdot \\begin{vmatrix}-2&-3\\\\-2&k\\end{vmatrix}\\\\&=(0)\\cdot ((-3)\\cdot (2)-(-1)\\cdot (k))\\\\&\\quad -(-1)\\cdot ((-2)\\cdot (2)-(-1)\\cdot (-2))\\\\&\\quad +(-4)\\cdot ((-2)\\cdot (k)-(-3)\\cdot (-2))\\\\&=(0)\\cdot (k - 6)\\\\&\\quad -(-1)\\cdot (-6)\\\\&\\quad +(-4)\\cdot (- 2 k - 6)\\\\&=8 k + 18\n\\end{aligned}\n$$\n\nSet the triple product equal to zero and solve:\n\n$$\n\\begin{aligned}\n8 k + 18&=0\\\\8 k&=-18\\\\k&=- \\frac{9}{4}\n\\end{aligned}\n$$\n\nThus the vectors are coplanar exactly when $k=- \\frac{9}{4}$."}] [{:db/id #edb/ref 17592186720785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4a1315a-abf0-582b-8ef8-00fc36b521fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186720791}] :answer-field/correct {:answer/id #uuid "c4a1315a-abf0-582b-8ef8-00fc36b521fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186720791} :answer-field/id #uuid "21473fa9-a954-510a-9ad4-d1bd9ff74040" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720781}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42f392ce-5821-58fe-85a6-74aaee8d04e5" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=\\langle 3,k,k\\rangle$, $\\mathbf{b}=\\langle 3,3,0\\rangle$, and $\\mathbf{c}=\\langle -2,-4,-3\\rangle$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "The vectors are coplanar if and only if their scalar triple product is zero. Expanding along the first row gives\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})&=\\begin{vmatrix}3&k&k\\\\3&3&0\\\\-2&-4&-3\\end{vmatrix}\\\\&=(3)\\cdot \\begin{vmatrix}3&0\\\\-4&-3\\end{vmatrix}\\\\&\\quad -(k)\\cdot \\begin{vmatrix}3&0\\\\-2&-3\\end{vmatrix}\\\\&\\quad +(k)\\cdot \\begin{vmatrix}3&3\\\\-2&-4\\end{vmatrix}\\\\&=(3)\\cdot ((3)\\cdot (-3)-(0)\\cdot (-4))\\\\&\\quad -(k)\\cdot ((3)\\cdot (-3)-(0)\\cdot (-2))\\\\&\\quad +(k)\\cdot ((3)\\cdot (-4)-(3)\\cdot (-2))\\\\&=(3)\\cdot (-9)\\\\&\\quad -(k)\\cdot (-9)\\\\&\\quad +(k)\\cdot (-6)\\\\&=3 k - 27\n\\end{aligned}\n$$\n\nSet the triple product equal to zero and solve:\n\n$$\n\\begin{aligned}\n3 k - 27&=0\\\\3 k&=27\\\\k&=9\n\\end{aligned}\n$$\n\nThus the vectors are coplanar exactly when $k=9$."}] [{:db/id #edb/ref 17592186720786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77530362-3f2a-5daa-8298-38580b3ab387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186720788}] :answer-field/correct {:answer/id #uuid "77530362-3f2a-5daa-8298-38580b3ab387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186720788} :answer-field/id #uuid "8d3a728f-fc5c-5533-aa88-3831b37beb1e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720789}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "43c79f6f-5971-56a7-bfe1-0fe7119f8b16" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=\\langle -1,-1,-3\\rangle$, $\\mathbf{b}=\\langle 1,2,4\\rangle$, and $\\mathbf{c}=\\langle k,-4,k\\rangle$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "The vectors are coplanar if and only if their scalar triple product is zero. Expanding along the first row gives\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})&=\\begin{vmatrix}-1&-1&-3\\\\1&2&4\\\\k&-4&k\\end{vmatrix}\\\\&=(-1)\\cdot \\begin{vmatrix}2&4\\\\-4&k\\end{vmatrix}\\\\&\\quad -(-1)\\cdot \\begin{vmatrix}1&4\\\\k&k\\end{vmatrix}\\\\&\\quad +(-3)\\cdot \\begin{vmatrix}1&2\\\\k&-4\\end{vmatrix}\\\\&=(-1)\\cdot ((2)\\cdot (k)-(4)\\cdot (-4))\\\\&\\quad -(-1)\\cdot ((1)\\cdot (k)-(4)\\cdot (k))\\\\&\\quad +(-3)\\cdot ((1)\\cdot (-4)-(2)\\cdot (k))\\\\&=(-1)\\cdot (2 k + 16)\\\\&\\quad -(-1)\\cdot (- 3 k)\\\\&\\quad +(-3)\\cdot (- 2 k - 4)\\\\&=k - 4\n\\end{aligned}\n$$\n\nSet the triple product equal to zero and solve:\n\n$$\n\\begin{aligned}\nk - 4&=0\\\\k&=4\\\\k&=4\n\\end{aligned}\n$$\n\nThus the vectors are coplanar exactly when $k=4$."}] [{:db/id #edb/ref 17592186720792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b153adc-2d47-5e05-b7d9-32c414072333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186720787}] :answer-field/correct {:answer/id #uuid "5b153adc-2d47-5e05-b7d9-32c414072333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186720787} :answer-field/id #uuid "014355ad-381b-585c-993f-8de8a3d7b0c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720779}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d46c93b0-26e4-57d1-af42-6040d4d7b8a0" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=\\langle k,k,3\\rangle$, $\\mathbf{b}=\\langle -2,-3,-3\\rangle$, and $\\mathbf{c}=\\langle -3,3,-2\\rangle$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "The vectors are coplanar if and only if their scalar triple product is zero. Expanding along the first row gives\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})&=\\begin{vmatrix}k&k&3\\\\-2&-3&-3\\\\-3&3&-2\\end{vmatrix}\\\\&=(k)\\cdot \\begin{vmatrix}-3&-3\\\\3&-2\\end{vmatrix}\\\\&\\quad -(k)\\cdot \\begin{vmatrix}-2&-3\\\\-3&-2\\end{vmatrix}\\\\&\\quad +(3)\\cdot \\begin{vmatrix}-2&-3\\\\-3&3\\end{vmatrix}\\\\&=(k)\\cdot ((-3)\\cdot (-2)-(-3)\\cdot (3))\\\\&\\quad -(k)\\cdot ((-2)\\cdot (-2)-(-3)\\cdot (-3))\\\\&\\quad +(3)\\cdot ((-2)\\cdot (3)-(-3)\\cdot (-3))\\\\&=(k)\\cdot (15)\\\\&\\quad -(k)\\cdot (-5)\\\\&\\quad +(3)\\cdot (-15)\\\\&=20 k - 45\n\\end{aligned}\n$$\n\nSet the triple product equal to zero and solve:\n\n$$\n\\begin{aligned}\n20 k - 45&=0\\\\20 k&=45\\\\k&=\\frac{9}{4}\n\\end{aligned}\n$$\n\nThus the vectors are coplanar exactly when $k=\\frac{9}{4}$."}] [{:db/id #edb/ref 17592186720793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ddbd7b1-d88f-58b2-91f5-ea5b3e42c603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186720784}] :answer-field/correct {:answer/id #uuid "2ddbd7b1-d88f-58b2-91f5-ea5b3e42c603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186720784} :answer-field/id #uuid "0533e203-c137-5c99-8999-42524a4286c6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d5efa85b-bdcb-550c-a602-81233112e9d6" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=\\langle -3,k,-2\\rangle$, $\\mathbf{b}=\\langle -2,k,1\\rangle$, and $\\mathbf{c}=\\langle 4,0,-1\\rangle$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "The vectors are coplanar if and only if their scalar triple product is zero. Expanding along the first row gives\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})&=\\begin{vmatrix}-3&k&-2\\\\-2&k&1\\\\4&0&-1\\end{vmatrix}\\\\&=(-3)\\cdot \\begin{vmatrix}k&1\\\\0&-1\\end{vmatrix}\\\\&\\quad -(k)\\cdot \\begin{vmatrix}-2&1\\\\4&-1\\end{vmatrix}\\\\&\\quad +(-2)\\cdot \\begin{vmatrix}-2&k\\\\4&0\\end{vmatrix}\\\\&=(-3)\\cdot ((k)\\cdot (-1)-(1)\\cdot (0))\\\\&\\quad -(k)\\cdot ((-2)\\cdot (-1)-(1)\\cdot (4))\\\\&\\quad +(-2)\\cdot ((-2)\\cdot (0)-(k)\\cdot (4))\\\\&=(-3)\\cdot (- k)\\\\&\\quad -(k)\\cdot (-2)\\\\&\\quad +(-2)\\cdot (- 4 k)\\\\&=13 k\n\\end{aligned}\n$$\n\nSet the triple product equal to zero and solve:\n\n$$\n\\begin{aligned}\n13 k&=0\\\\13 k&=0\\\\k&=0\n\\end{aligned}\n$$\n\nThus the vectors are coplanar exactly when $k=0$."}]}
