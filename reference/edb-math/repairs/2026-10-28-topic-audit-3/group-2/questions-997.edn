math} :answer/value "\\int_{0}^{3}\\sqrt{36 t^{4} - 35 t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722507} {:answer/id #uuid "1519b23e-4ee0-560c-8d8f-498fbcacd677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\sqrt{81 t^{4} - 50 t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722508} {:answer/id #uuid "278274fb-cb56-58b6-bd2a-83c9fb0c84f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\sqrt{144 t^{4} - 63 t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722513} {:answer/id #uuid "870380d2-ae97-513b-b891-294c9d119477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\sqrt{t^{4} - \\frac{23 t^{2}}{4} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722523} {:answer/id #uuid "c8efc0a6-f436-5ac1-8101-c4aabb92377d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\sqrt{9 t^{4} - 17 t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722537}] :answer-field/correct {:answer/id #uuid "1519b23e-4ee0-560c-8d8f-498fbcacd677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\sqrt{81 t^{4} - 50 t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722508} :answer-field/id #uuid "c74b0d45-ee5c-56e4-92c0-50f3a3f53a70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722536}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91e48687-18c8-5f85-88d0-e3b2a78a18bb" :question/problem "Which of the following gives the length of the curve defined by\n\n$$\n\\begin{aligned}\nx&=- t^{2} - 1\\\\\ny&=- 3 t^{3} + 3 t - 3\n\\end{aligned}\n$$\n\nfrom $t=0$ to $t=3$?\n\nChoose an integral expression valid on the entire interval. Do not evaluate it.\n\n![](images/18/18fc45fce3c2cad760007c82f15b0103858b944fb2b30b939b31a33453dca748.png)" :question/worked-solution "For parametric arc length, use\n\n$$\nL=\\int_a^b\\sqrt{[x\\prime(t)]^2+[y\\prime(t)]^2}\\,\\mathrm{d}t.\n$$\n\nDifferentiate each coordinate:\n\n$$\n\\begin{aligned}\nx'(t)&=- 2 t\\\\\ny'(t)&=- 9 t^{2} + 3.\n\\end{aligned}\n$$\n\nSquare both derivatives and add:\n\n$$\n\\begin{aligned}\nx'(t)^2+y'(t)^2&=\\bigl(- 2 t\\bigr)^2+\\bigl(- 9 t^{2} + 3\\bigr)^2\\\\\n&=81 t^{4} - 50 t^{2} + 9.\n\\end{aligned}\n$$\n\nUse the given parameter bounds:\n\n$$\nL=\\int_{0}^{3}\\sqrt{81 t^{4} - 50 t^{2} + 9}\\,\\mathrm{d}t.\n$$"}] [{:db/id #edb/ref 17592186722528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04de0f32-9816-5f31-96f1-0318eccadf94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\left(- t\\right)\\sqrt{8 t^{2} + 8}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722506} {:answer/id #uuid "5bfa826a-0d13-50a9-bb24-edea98f107c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\left(- t\\right)\\sqrt{72 t^{2} + 32}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722518} {:answer/id #uuid "afb24ef9-4e02-5fb5-a85c-11abdfe7f50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\left(t\\right)\\sqrt{128 t^{2} + 72}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722530} {:answer/id #uuid "bd1d247f-0b71-5f25-bbf6-ba39a679a37c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\left(t\\right)\\sqrt{72 t^{2} + 32}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722533} {:answer/id #uuid "c10d91c3-fa83-5353-8d2a-677ce7734373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\left(t\\right)\\sqrt{8 t^{2} + 8}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722535}] :answer-field/correct {:answer/id #uuid "bd1d247f-0b71-5f25-bbf6-ba39a679a37c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}\\left(t\\right)\\sqrt{72 t^{2} + 32}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722533} :answer-field/id #uuid "87104fc4-ca37-591f-b6b4-3201df891ae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722524}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d7ac94d-df51-51b5-9305-5ff157a15ce2" :question/problem "Which of the following gives the length of the curve defined by\n\n$$\n\\begin{aligned}\nx&=2 t^{3} + 2 t^{2} - 3\\\\\ny&=2 t^{3} - 2 t^{2} + 3\n\\end{aligned}\n$$\n\nfrom $t=0$ to $t=3$?\n\nChoose an integral expression valid on the entire interval. Do not evaluate it.\n\n![](images/10/10276f544790b5511e1067d1763f59699805a0364f1e1caccc434c9ed05d17bf.png)" :question/worked-solution "For parametric arc length, use\n\n$$\nL=\\int_a^b\\sqrt{[x\\prime(t)]^2+[y\\prime(t)]^2}\\,\\mathrm{d}t.\n$$\n\nDifferentiate each coordinate:\n\n$$\n\\begin{aligned}\nx'(t)&=6 t^{2} + 4 t\\\\\ny'(t)&=6 t^{2} - 4 t.\n\\end{aligned}\n$$\n\nThe cross terms cancel when the two derivative squares are added.\n\n$$\n\\begin{aligned}\nx'(t)^2+y'(t)^2&=72 t^{4} + 32 t^{2}\\\\\n&=(t)^2\\bigl(72 t^{2} + 32\\bigr).\n\\end{aligned}\n$$\n\nUse $\\sqrt{(t)^2}=|t|$. The factor $t$ is nonnegative on this interval. Hence $|t|=t$ here.\n\nUse the given parameter bounds:\n\n$$\nL=\\int_{0}^{3}\\left(t\\right)\\sqrt{72 t^{2} + 32}\\,\\mathrm{d}t.\n$$"}] [{:db/id #edb/ref 17592186722532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17c09800-5345-5469-867e-8d47db8135ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}\\left(t\\right)\\sqrt{648 t^{2} + 128}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722509} {:answer/id #uuid "53395a6e-4123-5409-b31f-98a4aada4233" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value 