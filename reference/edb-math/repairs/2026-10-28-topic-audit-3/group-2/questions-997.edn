t(t - 1\\right)^{2} - 1\n\\end{aligned}\n$$\n\nfrom $t=0$ to $t=4$?\n\nChoose an integral expression valid on the entire interval. Do not evaluate it.\n\n![](images/5c/5c51dabe9247857a3b15562c63525bcaeec213568c4c92f75f3740420201dfa4.png)" :question/worked-solution "For parametric arc length, use\n\n$$\nL=\\int_a^b\\sqrt{[x\\prime(t)]^2+[y\\prime(t)]^2}\\,\\mathrm{d}t.\n$$\n\nDifferentiate each coordinate:\n\n$$\n\\begin{aligned}\nx'(t)&=8 t + 6 \\left(t - 1\\right)^{2} - 8\\\\\ny'(t)&=- 8 t + 6 \\left(t - 1\\right)^{2} + 8.\n\\end{aligned}\n$$\n\nThe cross terms cancel when the two derivative squares are added.\n\n$$\n\\begin{aligned}\nx'(t)^2+y'(t)^2&=72 \\left(t - 1\\right)^{4} + 128 \\left(t - 1\\right)^{2}\\\\\n&=(t - 1)^2\\bigl(72 \\left(t - 1\\right)^{2} + 128\\bigr).\n\\end{aligned}\n$$\n\nUse $\\sqrt{(t - 1)^2}=|t - 1|$. The factor $t - 1$ changes sign inside this interval, so its absolute value must remain.\n\nUse the given parameter bounds:\n\n$$\nL=\\int_{0}^{4}\\left|t - 1\\right|\\sqrt{72 \\left(t - 1\\right)^{2} + 128}\\,\\mathrm{d}t.\n$$"}] [{:db/id #edb/ref 17592186722570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2074adc3-14d7-5a05-b3fd-616a33aba45b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}\\left(- t + 2\\right)\\sqrt{72 \\left(t - 2\\right)^{2} + 512}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722571} {:answer/id #uuid "40ce11e6-d25e-589b-b897-e39a58f6f834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}\\left(t - 2\\right)\\sqrt{18 \\left(t - 2\\right)^{2} + 128}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722573} {:answer/id #uuid "79cae51e-cf12-5954-8841-ce027b5ff4b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}\\left(- t + 2\\right)\\sqrt{18 \\left(t - 2\\right)^{2} + 128}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722579} {:answer/id #uuid "cbef544e-ffd5-589f-afc3-0de7c84fa7c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}\\left(t - 2\\right)\\sqrt{72 \\left(t - 2\\right)^{2} + 512}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722591} {:answer/id #uuid "de1ebd96-ee7b-52f3-8e68-7329791b688b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}\\left(- t + 2\\right)\\sqrt{32 \\left(t - 2\\right)^{2} + 288}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722593}] :answer-field/correct {:answer/id #uuid "79cae51e-cf12-5954-8841-ce027b5ff4b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}\\left(- t + 2\\right)\\sqrt{18 \\left(t - 2\\right)^{2} + 128}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722579} :answer-field/id #uuid "57c3473a-fd04-559e-b84b-74fc27aa06b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722576}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d1d0946-21e8-5afa-a7e0-83dbc129c1c4" :question/problem "Which of the following gives the length of the curve defined by\n\n$$\n\\begin{aligned}\nx&=\\left(t - 2\\right)^{3} + 4 \\left(t - 2\\right)^{2} - 1\\\\\ny&=\\left(t - 2\\right)^{3} - 4 \\left(t - 2\\right)^{2} - 1\n\\end{aligned}\n$$\n\nfrom $t=-1$ to $t=2$?\n\nChoose an integral expression valid on the entire interval. Do not evaluate it.\n\n![](images/92/92e4c0688c28ab5737615bf08d4be1badf95db8a399259875f9d259325a0e3a6.png)" :question/worked-solution "For parametric arc length, use\n\n$$\nL=\\int_a^b\\sqrt{[x\\prime(t)]^2+[y\\prime(t)]^2}\\,\\mathrm{d}t.\n$$\n\nDifferentiate each coordinate:\n\n$$\n\\begin{aligned}\nx'(t)&=8 t + 3 \\left(t - 2\\right)^{2} - 16\\\\\ny'(t)&=- 8 t + 3 \\left(t - 2\\right)^{2} + 16.\n\\end{aligned}\n$$\n\nThe cross terms cancel when the two derivative squares are added.\n\n$$\n\\begin{aligned}\nx'(t)^2+y'(t)^2&=18 \\left(t - 2\\right)^{4} + 128 \\left(t - 2\\right)^{2}\\\\\n&=(t - 2)^2\\bigl(18 \\left(t - 2\\right)^{2} + 128\\bigr).\n\\end{aligned}\n$$\n\nUse $\\sqrt{(t - 2)^2}=|t - 2|$. The factor $t - 2$ is nonpositive on this interval. Hence $|t - 2|=- t + 2$ here.\n\nUse the given parameter bounds:\n\n$$\nL=\\int_{-1}^{2}\\left(- t + 2\\right)\\sqrt{18 \\left(t - 2\\right)^{2} + 128}\\,\\mathrm{d}t.\n$$"}] [{:db/id #edb/ref 17592186722583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cc0905-ad57-5901-bb40-18333cd16cdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-5}^{-2}\\left(t + 2\\right)\\sqrt{32 \\left(t + 2\\right)^{2} + 72}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722569} {:answer/id #uuid "51bb1523-41dd-59ce-a743-291639cc71f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-5}^{-2}\\left(t + 2\\right)\\sqrt{8 \\left(t + 2\\right)^{2} + 8}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722575} {:answer/id #uuid "bec8be56-2d4a-5f84-b58b-188f6cf245c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-5}^{-2}\\left(- t - 2\\right)\\sqrt{32 \\left(t + 2\\right)^{2} + 72}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722589} {:answer/id #uuid "d8587cf5-4e80-52bf-bbb1-ccdbceed7384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-5}^{-2}\\left(t + 2\\right)\\sqrt{18 \\left(t + 2\\right)^{2} + 32}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722592} {:answer/id #uuid "e29cbe04-b84a-5132-ad1f-ccdb12fba447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-5}^{-2}\\left(- t - 2\\right)\\sqrt{18 \\left(t + 2\\right)^{2} + 32}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722594}] :answer-field/correct {:answer/id #uuid "e29cbe04-b84a-5132-ad1f-ccdb12fba447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :