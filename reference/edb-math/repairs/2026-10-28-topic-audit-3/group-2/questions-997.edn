rm{d}t}&=1\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}t}&=- 2 e^{- t}\\end{aligned}\n$$\n\nSquare the complete derivatives before adding, and retain the parameter limits. Substitute and simplify:\n\n$$\n\\begin{aligned}L&=\\int_{0}^{1}\\sqrt{\\left(- 2 e^{- t}\\right)^{2} + 1^{2}}\\,\\mathrm{d}t\\\\&=\\int_{0}^{1}\\sqrt{1 + 4 e^{- 2 t}}\\,\\mathrm{d}t\\end{aligned}\n$$\n\n"}] [{:db/id #edb/ref 17592186722639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25482c96-0842-5eae-9263-6ca929ace411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{e^{2 t} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722635} {:answer/id #uuid "26bc9484-dd87-5ec0-aa59-fbb0b09126ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{e^{2 t} + 16}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722636} {:answer/id #uuid "7d424744-dd47-54a2-ba6a-ef0e288efca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{4 e^{2 t} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722643} {:answer/id #uuid "b4964eac-4c4e-5d3a-ab3e-28897736d42d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{4 e^{2 t} + 16}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722651} {:answer/id #uuid "b8100f41-2c21-54d7-9599-7a2db540d8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{e^{t} + 2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722652}] :answer-field/correct {:answer/id #uuid "25482c96-0842-5eae-9263-6ca929ace411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{e^{2 t} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186722635} :answer-field/id #uuid "42945505-b824-59a5-8bcf-9bb83b5e9e97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answ