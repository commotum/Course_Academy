ype/math} :answer/value "-\\frac{4}{2 y + 1}" :db/id #edb/ref 17592186711284} {:answer/id #uuid "103c08f5-ef27-5668-8a80-522f1be0da98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2 y - 1}" :db/id #edb/ref 17592186711285} {:answer/id #uuid "322ec602-5f44-5662-a6e4-60c442fedf2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{y + 1}" :db/id #edb/ref 17592186711291} {:answer/id #uuid "56c3ee43-a823-51c0-9b9d-032711260d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{2 y + 1}" :db/id #edb/ref 17592186711295} {:answer/id #uuid "a8899d24-0f37-5af6-8506-4bf30e28c966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{y + 1}" :db/id #edb/ref 17592186711306}] :answer-field/correct {:answer/id #uuid "0f350959-6f85-5294-be20-f6f2d44f1cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{2 y + 1}" :db/id #edb/ref 17592186711284} :answer-field/id #uuid "9e9dfce0-12fe-5cb1-bb29-74d3dad69647" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2664f25c-1b9d-557f-8911-16fcf050cb22" :question/problem "Given that $y^{2} + y-(- 4 x)=-2$, calculate $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "Differentiate both sides with respect to $x$, treating $y$ as a function $y(x)$.\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(y^{2} + y\\right)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(- 4 x - 2\\right)\\\\\n2 y\\frac{\\mathrm{d}y}{\\mathrm{d}x}+1\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=-4\n\\end{aligned}\n$$\n\nCollect the terms containing $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$, factor, and solve:\n\n$$\n\\begin{aligned}\n\\left(2 y + 1\\right)\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=-4\\\\\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=-\\frac{4}{2 y + 1}\n\\end{aligned}\n$$\n\nThis formula applies on real branches where $2 y + 1\\ne 0$."}] [{:db/id #edb/ref 17592186711292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "229078fd-2cda-58cc-8689-caaa27e6f09d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{2 y + 2}" :db/id #edb/ref 17592186711287} {:answer/id #uuid "2e176b49-93a5-5cda-b7bb-fea8f0572d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{2 y + 2}" :db/id #edb/ref 17592186711290} {:answer/id #uuid "d6cac64f-0c9c-5732-b381-7e9b5ad6a468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{2 y}" :db/id #edb/ref 17592186711315} {:answer/id #uuid "e8f038fb-9c1c-5494-b79d-509936c7f01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 x}{y^{2} - 2}" :db/id #edb/ref 17592186711316} {:answer/id #uuid "fc172e96-506a-5a22-9eb2-8086d513f24f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{2 y}" :db/id #edb/ref 17592186711318}] :answer-field/correct {:answer/id #uuid "229078fd-2cda-58cc-8689-caaa27e6f09d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{2 y + 2}" :db/id #edb/ref 17592186711287} :answer-field/id #uuid "5f3ddf06-ea14-5f1a-b3c7-fea5d11279f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711297}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35a2539a-1934-59c8-99c4-149327db82c3" :question/problem "Given that $y^{2} + 2 y-(- 4 x)=2$, calculate $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "Differentiate both sides with respect to $x$, treating $y$ as a function $y(x)$.\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(y^{2} + 2 y\\right)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(2 - 4 x\\right)\\\\\n2 y\\frac{\\mathrm{d}y}{\\mathrm{d}x}+2\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=-4\n\\end{aligned}\n$$\n\nCollect the terms containing $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$, factor, and solve:\n\n$$\n\\begin{aligned}\n\\left(2 y + 2\\right)\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=-4\\\\\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=-\\frac{4}{2 y + 2}\n\\end{aligned}\n$$\n\nThis formula applies on real branches where $2 y + 2\\ne 0$."}] [{:db/id #edb/ref 17592186711296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d1f71ed-72f3-565f-96a2-b1aff4c47ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4 x}{y^{2} - 2}" :db/id #edb/ref 17592186711294} {:answer/id #uuid "738835de-d427-5fd3-93da-10fdd6a2dd69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{2 y + 2}" :db/id #edb/ref 17592186711299} {:answer/id #uuid "a35813e3-198d-5e2b-a35f-9e698031484a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{2 y + 2}" :db/id #edb/ref 17592186711304} {:answer/id #uuid "c2d10695-6aa2-58cb-a2f9-2ebe1762315d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{2 y}" :db/id #edb/ref 17592186711311} {:answer/id #uuid "cdec03b0-c0cc-5448-99a1-6a795212b88a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{2 y}" :db/id #edb/ref 17592186711312}] :answer-field/correct {:answer/id #uuid "a35813e3-198d-5e2b-a35f-9e698031484a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{2 y + 2}" :db/id #edb/ref 17592186711304} :answer-field/id #uuid "23b01852-0499-5c90-9c5a-d3d1b30cb17e" :answer-field/key "selection" :answer-field/type {:db/id #