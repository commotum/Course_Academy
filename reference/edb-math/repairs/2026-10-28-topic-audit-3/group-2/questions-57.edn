\\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x-{e}^{y}}{x{e}^{y}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} {:answer/id #uuid "4fa8641b-f12e-5282-8639-b287c9ca081d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6x-xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336764} {:answer/id #uuid "778b8f44-4e6f-5e84-b5d0-3856a65b2fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186337107} {:answer/id #uuid "8e0a7e37-7922-5237-be4e-0d4daf2edd15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x-2y}{{x}^{2}+4}" :db/id #edb/ref 17592186337313} {:answer/id #uuid "d8ffdd28-a653-5368-a470-1763333eed55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x+2xy}{{x}^{2}-4}" :db/id #edb/ref 17592186337920}] :answer-field/correct {:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} :answer-field/id #uuid "f8ea9a9d-1024-53db-ae2f-47b539ab86b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338714}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3b84d5b9-93df-56c4-be18-4346c8b72764" :question/math-academy-id "q-72260" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}y+4y=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}y+4y & =2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y+4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y)+\\frac{\\text{d}}{\\text{d}x}(4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 2x]+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x}({x}^{2}+4) & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-2xy}{{x}^{2}+4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117e7337-fc4b-5d81-9acc-f80a3311abe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+y}{3x-6{y}^{2}}" :db/id #edb/ref 17592186336196} {:answer/id #uuid "8e5effcf-ab54-5764-a7ac-3bceda9c35b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{x+3{y}^{2}}" :db/id #edb/ref 17592186337314} {:answer/id #uuid "92972b35-13d6-5480-a629-1c54e4e63a44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{2x+12{y}^{2}}" :db/id #edb/ref 17592186337367} {:answer/id #uuid "9ac58d09-239e-549a-a447-88485ff4d1f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2y}{x+12{y}^{2}}" :db/id #edb/ref 17592186337436} {:answer/id #uuid "f9987e20-7613-5a49-a604-bd92f8ec44f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{x+6{y}^{2}}" :db/id #edb/ref 17592186338219}] :answer-field/correct {:answer/id #uuid "f9987e20-7613-5a49-a604-bd92f8ec44f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{x+6{y}^{2}}" :db/id #edb/ref 17592186338219} :answer-field/id #uuid "73206142-4c94-5223-ae50-cad45a811d99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338473}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44970693-ec6f-5946-af75-60ea2f8aac31" :question/math-academy-id "q-72262" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $2xy+4{y}^{3}={x}^{2}-1.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $2xy$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}2xy+4{y}^{3} & ={x}^{2}-1 \\\\ \\frac{\\text{d}}{\\text{d}x}(2xy+4{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-1) \\\\ \\frac{\\text{d}}{\\text{d}x}(2xy)+\\frac{\\text{d}}{\\text{d}x}(4{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-1) \\\\ [2x\\frac{\\text{d}y}{\\text{d}x}+2y]+12{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x \\\\ 2x\\frac{\\text{d}y}{\\text{d}x}+2y+12{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}2x\\frac{\\text{d}y}{\\text{d}x}+12{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x-2y \\\\ \\frac{\\text{d}y}{\\text{d}x}(2x+12{y}^{2}) & =2x-2y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x-2y}{2x+12{y}^{2}} \\\\  & =\\frac{x-y}{x+6{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "700e737f-010a-5472-aabe-6b01a6fb174a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-6{x}^{2}y}{2{x}^{3}+4y}" :db/id #edb/ref 17592186337026} {:answer/id #uuid "8cc7b687-c9fe-5eea-a3e6-70cc3cd2a0ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-3xy}{2{x}^{3}+4y}" :db/id #edb/ref 17592186337305} {:answer/id #uuid "93438aab-9819-5208-ae86-f7b90ecf3615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-6xy}{2{x}^{2}+4y}" :db/id #edb/ref 17592186337374} {:answer/id #uuid "939b14ef-0a44-5a7b-b9d2-4617ac582f88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-6xy}{2{x}^{3}+4y}" :db/id #edb/ref 17592186337379} {:answer/id #uuid "d3ee61af-4d6e-527c-adb3-7166a770e9a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x+6xy}{2{x}^{3}-4y}" :db/id #edb/ref 17592186337884}] :answer-field/correct {:answer/id #uuid "700e737f-010a-5472-aabe-6b01a6fb174a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-6{x}^{2}y}{2{x}^{3}+4y}" :db/id #edb/ref 17592186337026} :answer-field/id #uuid "83d3e1c9-fc15-5b1a-99e9-fa037e3f37a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338513}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aab477a4-f346-5f01-8540-295d060c38b4" :question/math-academy-id "q-72263" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $2{x}^{3}y+2{y}^{2}=4{x}^{2}+6.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $2{x}^{3}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}2{x}^{3}y+2{y}^{2} & =4{x}^{2}+6 \\\\ \\frac{\\text{d}}{\\text{d}x}(2{x}^{3}y+2{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+6) \\\\ \\frac{\\text{d}}{\\text{d}x}(2{x}^{3}y)+\\frac{\\text{d}}{\\text{d}x}(2{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+6) \\\\ [2{x}^{3}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 6{x}^{2}]+4y\\frac{\\text{d}y}{\\text{d}x} & =8x \\\\ 2{x}^{3}\\frac{\\text{d}y}{\\text{d}x}+6{x}^{2}y+4y\\frac{\\text{d}y}{\\text{d}x} & =8x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}2{x}^{3}\\frac{\\text{d}y}{\\text{d}x}+4y\\frac{\\text{d}y}{\\text{d}x} & =8x-6{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x}(2{x}^{3}+4y) & =8x-6{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{8x-6{x}^{2}y}{2{x}^{3}+4y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186710815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09454508-896c-5542-a01b-cbd6619e7ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x-y}{x+2y}" :db/id #edb/ref 17592186710808} {:answer/id #uuid "1693e2c6-435c-5caf-ac5c-70627a4eb9c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x-y}{2y}" :db/id #edb/ref 17592186710809} {:answer/id #uuid "3b2b0382-220d-53f2-b055-aa7dc94903d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+y}{x+2y}" :db/id #edb/ref 17592186710814} {:answer/id #uuid "c2211d0c-6e8a-5cd1-91da-5d2ba30506e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x}{x+2y}" :db/id #edb/ref 17592186710819} {:answer/id #uuid "fac253d3-d11a-5646-930c-e6c362c2c8af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x-y}{x+2}" :db/id #edb/ref 17592186710827}] :answer-field/correct {:answer/id #uuid "09454508-896c-5542-a01b-cbd6619e7ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x-y}{x+2y}" :db/id #edb/ref 17592186710808} :answer-field/id #uuid "05aee5a6-14a6-54c6-bafa-1837095301db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710807}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5da798c0-eff7-5dba-adf8-d976d10d73c3" :question/problem "Calculate $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$ for $xy+y^2=2x^2+1.$" :question/worked-solution "Treat $y$ as a function of $x$ and write $y'=\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$. Differentiate both sides with respect to $x$. The product rule gives $(xy)'=y+xy'$, and the chain rule gives $(y^2)'=2yy'$.\n\n$$\n\\begin{aligned}\ny+xy'+2yy'&=4x\\\\\nxy'+2yy'&=4x-y\\\\\n(x+2y)y'&=4x-y.\n\\end{aligned}\n$$\n\nDividing by the coefficient of $y'$ gives\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{4x-y}{x+2y},\\qquad x+2y\\ne0.\n$$"}] [{:db/id #edb/ref 17592186710816 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2895efb3-bce5-5104-9f58-06289ccaef72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^y+2x\\sin y}{x^2\\cos y+2y-xe^y}" :db/id #edb/ref 17592186710811} {:answer/id #uuid "3424812a-525c-5b18-849e-79fa6e24fc36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^y-2x\\sin y}{x^2\\cos y+2y-xe^y}" :db/id #edb/ref 17592186710813} {:answer/id #uuid "beaa6e5f-91ab-5496-9075-1c5d55eea00a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2x\\sin y}{x^2\\cos y+2y-xe^y}" :db/id #edb/ref 17592186710818} {:answer/id #uuid "cba1b032-2ecc-5bbe-a2f4-a4d2e68be84f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^y+xe^y-2x\\sin y}{x^2\\cos y+2y}" :db/id #edb/ref 17592186710821} {:answer/id #uuid "d13b43a3-a41d-56c2-b477-10d4235ff430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^y-2x\\sin y}{x^2\\cos y+2y+xe^y}" :db/id #edb/ref 17592186710823}] :answer-field/correct {:answer/id #uuid "3424812a-525c-5b18-849e-79fa6e24fc36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^y-2x\\sin y}{x^2\\cos y+2y-xe^y}" :db/id #edb/ref 17592186710813} :answer-field/id #uuid "33f5dd76-dbf2-5184-b8ca-5a9eeece939e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710812}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8e608f41-f7b0-5fa0-8ef4-bed7e273d142" :question/problem "Calculate $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$ for $x^2\\sin y+y^2=xe^y+1.$" :question/worked-solution "Treat $y$ as a function of $x$ and write $y'=\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$. Both sides contain a product. Differentiate each product, retaining the chain-rule factor $y'$ when differentiating $\\sin y$ or $e^y$:\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(x^2\\sin y)&=2x\\sin y+x^2\\cos y\\,y',\\\\\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(xe^y)&=e^y+xe^y y'.\n\\end{aligned}\n$$\n\nDifferentiate the equation, then move every term containing $y'$ to the left and the other terms to the right:\n\n$$\n\\begin{aligned}\n2x\\sin y+x^2\\cos y\\,y'+2yy'&=e^y+xe^y y'\\\\\nx^2\\cos y\\,y'+2yy'-xe^y y'&=e^y-2x\\sin y\\\\\n(x^2\\cos y+2y-xe^y)y'&=e^y-2x\\sin y.\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{e^y-2x\\sin y}{x^2\\cos y+2y-xe^y}.\n$$\n\nThis formula applies where $x^2\\cos y+2y-xe^y\\ne0$."}] [{:db/id #edb/ref 17592186710822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6dfce6-a271-528e-940f-484e97f94304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^2-\\sin y-x\\cos y}{2y}" :db/id #edb/ref 17592186710810} {:answer/id #uuid "9cec35d5-98ad-5817-9e3a-a9a4088c0f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^2-\\sin y}{x\\cos y+2y}" :db/id #edb/ref 17592186710817} {:answer/id #uuid "c84b466d-e918-5035-a44c-127ac2a08b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^2+\\sin y}{x\\cos y+2y}" :db/id #edb/ref 17592186710820} {:answer/id #uuid "f326601d-39c8-50b9-8985-6de451cd7237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^2}{x\\cos y+2y}" :db/id #edb/ref 17592186710825} {:answer/id #uuid "fa604ea6-3b02-5e74-ad1c-ac74c3e59e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^2-\\sin y}{x\\sin y+2y}" :db/id #edb/ref 17592186710826}] :answer-field/correct {:answer/id #uuid "9cec35d5-98ad-5817-9e3a-a9a4088c0f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^2-\\sin y}{x\\cos y+2y}" :db/id #edb/ref 17592186710817} :answer-field/id #uuid "dac289c2-2d9e-5940-ab2c-485bdc3c2001" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710824}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf25af3d-9878-567e-91a7-d51ce920ad85" :question/problem "Calculate $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$ for $x\\sin y+y^2=x^3+1.$" :question/worked-solution "Treat $y$ as a function of $x$ and write $y'=\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$. Apply the product rule to $x\\sin y$ and the chain rule to each function of $y$:\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(x\\sin y)&=\\sin y+x\\cos y\\,y',\\\\\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(y^2)&=2yy'.\n\\end{aligned}\n$$\n\nDifferentiating the equation and collecting the terms containing $y'$ gives\n\n$$\n\\begin{aligned}\n\\sin y+x\\cos y\\,y'+2yy'&=3x^2\\\\\nx\\cos y\\,y'+2yy'&=3x^2-\\sin y\\\\\n(x\\cos y+2y)y'&=3x^2-\\sin y.\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{3x^2-\\sin y}{x\\cos y+2y},\\qquad x\\cos y+2y\\ne0.\n$$"}] [{:db/id #edb/ref 17592186710910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07fb47f2-153d-504d-9a92-f306b9bcc19c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{y+1}" :db/id #edb/ref 17592186710908} {:answer/id #uuid "618f06cd-5ae4-5d3e-9090-7f8869e83d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2y}" :db/id #edb/ref 17592186710914} {:answer/id #uuid "8af2482d-2fb3-5d57-86e3-cb5f67232de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2y+1}" :db/id #edb/ref 17592186710920} {:answer/id #uuid "a14164fe-24c6-54e2-b90b-f1025f62bf31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2y+1}" :db/id #edb/ref 17592186710922} {:answer/id #uuid "c1c77a34-a265-5896-b30b-f4dd58b81f46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2y+1}{3}" :db/id #edb/ref 17592186710923}] :answer-field/correct {:answer/id #uuid "a14164fe-24c6-54e2-b90b-f1025f62bf31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2y+1}" :db/id #edb/ref 17592186710922} :answer-field/id #uuid "3ec0f682-9dfc-588c-8cee-e8dc7e250d98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710912}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2984bf32-2567-5b2e-b294-6e69e5cdd26e" :question/problem "Given that $y^2-3x+y=1$, calculate $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "Differentiate both sides with respect to $x$, treating $y$ as a function $y(x)$. The chain rule gives $\\frac{\\mathrm{d}}{\\mathrm{d}x}(y^2)=2y\\frac{\\mathrm{d}y}{\\mathrm{d}x}$.\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(y^2-3x+y)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}(1)\\\\\n2y\\frac{\\mathrm{d}y}{\\mathrm{d}x}-3+\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=0\n\\end{aligned}\n$$\n\nCollect the terms containing $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$, factor, and divide:\n\n$$\n\\begin{aligned}\n2y\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=3\\\\\n(2y+1)\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=3\\\\\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=\\frac{3}{2y+1}.\n\\end{aligned}\n$$\n\nThis formula applies where $2y+1\\ne 0$."}] [{:db/id #edb/ref 17592186710915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0487110f-bec9-5d5e-b038-378f42555a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{2^y-1}" :db/id #edb/ref 17592186710907} {:answer/id #uuid "74b807a3-b9c0-521a-a9aa-81763b2e2eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{2^y\\ln(2)}" :db/id #edb/ref 17592186710916} {:answer/id #uuid "792c1b71-9761-5eab-8780-f92851f900b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{2^y\\ln(2)-1}" :db/id #edb/ref 17592186710917} {:answer/id #uuid "8b650d8c-95b0-5e27-933e-589263fa9e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^y\\ln(2)-1}{2x}" :db/id #edb/ref 17592186710921} {:answer/id #uuid "efcbf51a-12ea-5b93-9cd5-0b50e769c287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x}{2^y\\ln(2)-1}" :db/id #edb/ref 17592186710927}] :answer-field/correct {:answer/id #uuid "792c1b71-9761-5eab-8780-f92851f900b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{2^y\\ln(2)-1}" :db/id #edb/ref 17592186710917} :answer-field/id #uuid "d23f8010-cd2c-5c2a-868e-bace22784425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710924}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6f1bcac1-7671-548e-9f90-d7ed9245d85d" :question/problem "Given that $2^y-y=x^2+1$, calculate $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "Differentiate both sides with respect to $x$, treating $y$ as a function $y(x)$. For the exponential term, use the general-base rule together with the chain rule:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(2^y)=2^y\\ln(2)\\frac{\\mathrm{d}y}{\\mathrm{d}x}.\n$$\n\nThus,\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(2^y-y)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}(x^2+1)\\\\\n2^y\\ln(2)\\frac{\\mathrm{d}y}{\\mathrm{d}x}-\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=2x.\n\\end{aligned}\n$$\n\nFactor out $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$ and solve:\n\n$$\n\\begin{aligned}\n(2^y\\ln(2)-1)\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=2x\\\\\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=\\frac{2x}{2^y\\ln(2)-1}.\n\\end{aligned}\n$$\n\nThis formula applies where $2^y\\ln(2)-1\\ne 0$."}] [{:db/id #edb/ref 17592186710918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26daaa9d-fd0f-55c8-8a75-8459acacf596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+\\sin(y)}{3y^2}" :db/id #edb/ref 17592186710909} {:answer/id #uuid "316de2d3-ecc3-5264-bedc-8fff641c9ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{3y^2-\\sin(y)}" :db/id #edb/ref 17592186710911} {:answer/id #uuid "5094c33c-b19a-54ba-8dfd-a4b3e56436a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x}{3y^2-\\sin(y)}" :db/id #edb/ref 17592186710913} {:answer/id #uuid "87fb9929-ff9a-5237-9ecc-3429e941b14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{3y^2+\\sin(y)}" :db/id #edb/ref 17592186710919} {:answer/id #uuid "de75ae96-c4c2-5011-b2ce-9372541d2974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{3y^2+\\cos(y)}" :db/id #edb/ref 17592186710925}] :answer-field/correct {:answer/id #uuid "316de2d3-ecc3-5264-bedc-8fff641c9ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{3y^2-\\sin(y)}" :db/id #edb/ref 17592186710911} :answer-field/id #uuid "ed07d944-55ec-5757-ab4a-f12962ff4f0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710926}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c519aff-3b88-5ec5-ac50-6662be88074b" :question/problem "Given that $y^3+\\cos(y)-x^2=2$, calculate $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "Differentiate both sides with respect to $x$, treating $y$ as a function $y(x)$. Both $y^3$ and $\\cos(y)$ require a factor of $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$ from the chain rule.\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(y^3+\\cos(y)-x^2)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}(2)\\\\\n3y^2\\frac{\\mathrm{d}y}{\\mathrm{d}x}-\\sin(y)\\frac{\\mathrm{d}y}{\\mathrm{d}x}-2x&=0\n\\end{aligned}\n$$\n\nCollect and factor the terms containing $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$:\n\n$$\n\\begin{aligned}\n3y^2\\frac{\\mathrm{d}y}{\\mathrm{d}x}-\\sin(y)\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=2x\\\\\n(3y^2-\\sin(y))\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=2x\\\\\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=\\frac{2x}{3y^2-\\sin(y)}.\n\\end{aligned}\n$$\n\nThis formula applies where $3y^2-\\sin(y)\\ne 0$."}] [{:db/id #edb/ref 17592186711006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "982d979f-fd77-5d81-8be8-b6d0512239ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2e}{e+2}" :db/id #edb/ref 17592186711012}] :answer-field/correct {:answer/id #uuid "982d979f-fd77-5d81-8be8-b6d0512239ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2e}{e+2}" :db/id #edb/ref 17592186711012} :answer-field/id #uuid "c91fbee6-bf26-5a6f-b676-e3e891671683" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711016}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2fb02dfe-1197-5eea-8e09-14662f8ce8e4" :question/problem "Find the slope $m$ of the tangent at the point $(1,1)$ for the curve $xe^{xy}+y^2=e+1.$ Give an exact answer.\n\n$m=$\n{{field-1}}" :question/worked-solution "Treat $y$ as a function of $x$. The term $xe^{xy}$ needs the product rule. Inside the exponential, $xy$ also needs the product rule:\n\n$$\n\\frac{d}{dx}(xy)=y+x\\frac{dy}{dx},\\qquad\n\\frac{d}{dx}(e^{xy})=e^{xy}\\left(y+x\\frac{dy}{dx}\\right).\n$$\n\nDifferentiate the curve and collect all terms containing $\\dfrac{dy}{dx}$:\n\n$$\n\\begin{aligned}\n\\frac{d}{dx}(xe^{xy}+y^2)&=\\frac{d}{dx}(e+1)\\\\\ne^{xy}+xe^{xy}\\left(y+x\\frac{dy}{dx}\\right)+2y\\frac{dy}{dx}&=0\\\\\ne^{xy}+xye^{xy}+x^2e^{xy}\\frac{dy}{dx}+2y\\frac{dy}{dx}&=0\\\\\n(x^2e^{xy}+2y)\\frac{dy}{dx}&=-e^{xy}(1+xy)\\\\\n\\frac{dy}{dx}&=-\\frac{e^{xy}(1+xy)}{x^2e^{xy}+2y}.\n\\end{aligned}\n$$\n\nAt $(1,1)$, $e^{xy}=e$ and the denominator $e+2$ is positive. Therefore,\n\n$$\n\\begin{aligned}\nm&=\\left.\\frac{dy}{dx}\\right|_{(1,1)}\\\\\n&=-\\frac{e(1+1)}{e+2}\\\\\n&=-\\frac{2e}{e+2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9479dd1b-e360-58a0-a15d-fd85436a5618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186711011}] :answer-field/correct {:answer/id #uuid "9479dd1b-e360-58a0-a15d-fd85436a5618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186711011} :answer-field/id #uuid "a9bb4651-a493-58f5-94b5-9e459ea69e3a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711013}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c736a06-45ed-5fb2-ade2-54c9bca88d73" :question/problem "Find the slope $m$ of the tangent at the point $(2,1)$ for the curve $xy+y^2=x^2-1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "Differentiate both sides with respect to $x$, treating $y$ as a function of $x$. Use the product rule on $xy$ and the chain rule on $y^2$.\n\n$$\n\\begin{aligned}\n\\frac{d}{dx}(xy+y^2)&=\\frac{d}{dx}(x^2-1)\\\\\nx\\frac{dy}{dx}+y+2y\\frac{dy}{dx}&=2x\\\\\n(x+2y)\\frac{dy}{dx}&=2x-y\\\\\n\\frac{dy}{dx}&=\\frac{2x-y}{x+2y}.\n\\end{aligned}\n$$\n\nAt $(2,1)$, the denominator is $2+2(1)=4$, so the slope is finite. Substituting gives\n\n$$\n\\begin{aligned}\nm&=\\left.\\frac{dy}{dx}\\right|_{(2,1)}\\\\\n&=\\frac{2(2)-1}{2+2(1)}\\\\\n&=\\frac{3}{4}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186711015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f82113c-05dc-5b1d-bc22-45cf7400843b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186711004} {:answer/id #uuid "1a492d10-725e-5e31-ad14-d182beb47cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186711005} {:answer/id #uuid "800be21f-e102-572c-b9a8-46648386aed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186711008} {:answer/id #uuid "90309fe8-1c70-5843-8165-6132054b2d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186711010} {:answer/id #uuid "b7016e6e-cde6-5faa-b1f3-187b23bec898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186711014}] :answer-field/correct {:answer/id #uuid "0f82113c-05dc-5b1d-bc22-45cf7400843b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186711004} :answer-field/id #uuid "73608975-e624-5e35-b8a9-20dedf648391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711007}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c28848f1-0f0e-5f71-af80-24cc5f2fd9a4" :question/problem "Find the slope of the tangent at the point $(1,2)$ for the curve $3x^2+2y^3=19.$" :question/worked-solution "To find the slope at a point, differentiate the curve implicitly with respect to $x$, treating $y$ as a function of $x$. The chain rule supplies a factor of $\\dfrac{dy}{dx}$ when differentiating $y^3$.\n\n$$\n\\begin{aligned}\n\\frac{d}{dx}(3x^2+2y^3)&=\\frac{d}{dx}(19)\\\\\n6x+6y^2\\frac{dy}{dx}&=0\\\\\n6y^2\\frac{dy}{dx}&=-6x\\\\\n\\frac{dy}{dx}&=-\\frac{x}{y^2}.\n\\end{aligned}\n$$\n\nNow evaluate the derivative at $(1,2)$:\n\n$$\nm=\\left.\\frac{dy}{dx}\\right|_{(1,2)}=-\\frac{1}{2^2}=-\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186711063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "170025e4-1ff1-5339-aaff-2ca308d2dcf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{25}{4})" :db/id #edb/ref 17592186711065} {:answer/id #uuid "6848d39a-e195-50e7-9d30-692e28d6ba01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{25}{4})" :db/id #edb/ref 17592186711071} {:answer/id #uuid "8cc630a9-56f7-511b-abfc-d3f012c6d61d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186711075} {:answer/id #uuid "96627440-41aa-59a9-8975-f9d4692df309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{7}{4})" :db/id #edb/ref 17592186711076} {:answer/id #uuid "a0b80f5d-d877-5d89-b2bc-4d457114223e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{25}{3})" :db/id #edb/ref 17592186711078}] :answer-field/correct {:answer/id #uuid "6848d39a-e195-50e7-9d30-692e28d6ba01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{25}{4})" :db/id #edb/ref 17592186711071} :answer-field/id #uuid "74734c96-0296-5da0-a3e6-6d98a80fc95b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711074}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "05d3989d-1da3-57a6-ac84-893d2cb998a4" :question/problem "The circle $x^2+y^2=25$ has a tangent at $(3,4)$ that meets the $y$-axis at $P$.\n\n![Circle with the tangent through (3,4) meeting the y-axis at P.](images/3b/3b7add027c857979a54396568b0c0a6928060f97b1af2e2a6b8520bebb025ec0.png)\n\nImplicit differentiation has been started for you:\n\n$$\n2x+2y\\frac{dy}{dx}=0.\n$$\n\nFind the coordinates of $P$. Use the tangent slope in $y-4=m(x-3)$, and remember that $x=0$ on the $y$-axis." :question/worked-solution "Solve the given differentiated equation for the tangent slope:\n\n$$\n\\frac{dy}{dx}=-\\frac{x}{y}.\n$$\n\nAt $(3,4)$, the tangent slope is $m=-\\frac{3}{4}$. The tangent line is therefore\n\n$$\n\\begin{aligned}\ny-4&=-\\frac{3}{4}(x-3) \\\\\ny&=-\\frac{3}{4}x+\\frac{25}{4}.\n\\end{aligned}\n$$\n\nSet $x=0$ to find its intersection with the $y$-axis. This gives $y=\\frac{25}{4}$, so\n\n$$\nP=\\left(0,\\frac{25}{4}\\right).\n$$"}] [{:db/id #edb/ref 17592186711064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3e4da2-1d67-5df6-9465-9ac9c18ca756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711066}] :answer-field/correct {:answer/id #uuid "1b3e4da2-1d67-5df6-9465-9ac9c18ca756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711066} :answer-field/id #uuid "1d8b4abb-df83-5648-97eb-90889aa70195" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711067} {:answer-field/choices [{:answer/id #uuid "e0731e5e-2128-5c9b-b953-dd1683000205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186711080}] :answer-field/correct {:answer/id #uuid "e0731e5e-2128-5c9b-b953-dd1683000205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186711080} :answer-field/id #uuid "6e1bfd71-b7d8-525f-84a8-8550f8bf2799" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711072}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "165cab38-1881-53f3-a3cb-8f15ce43eb31" :question/problem "The equation of a curve is $xy+y^2=6$. The normal line at $(1,2)$ on the curve intersects the $y$-axis at $P$. Find the coordinates of $P$. Give exact values.\n\nThe coordinates of $P$ are $(${{field-1}}$,$ {{field-2}}$)$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as a function of $x$. The product rule gives $\\frac{d}{dx}(xy)=y+x\\frac{dy}{dx}$, so\n\n$$\n\\begin{aligned}\ny+x\\frac{dy}{dx}+2y\\frac{dy}{dx}&=0 \\\\\n(x+2y)\\frac{dy}{dx}&=-y \\\\\n\\frac{dy}{dx}&=-\\frac{y}{x+2y}.\n\\end{aligned}\n$$\n\nThe tangent slope at $(1,2)$ is\n\n$$\nm_{\\mathrm{t}}=-\\frac{2}{1+2(2)}=-\\frac{2}{5}.\n$$\n\nThe normal slope is its negative reciprocal:\n\n$$\nm_{\\mathrm{n}}=-\\frac{1}{m_{\\mathrm{t}}}=\\frac{5}{2}.\n$$\n\nThe normal through $(1,2)$ has equation\n\n$$\n\\begin{aligned}\ny-2&=\\frac{5}{2}(x-1) \\\\\ny&=\\frac{5}{2}x-\\frac{1}{2}.\n\\end{aligned}\n$$\n\nSet $x=0$ for the $y$-axis intersection. Then $y=-\\frac{1}{2}$, giving\n\n$$\nP=\\left(0,-\\frac{1}{2}\\right).\n$$"}] [{:db/id #edb/ref 17592186711079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "449ae0dc-5697-5716-84ec-8b78d5783865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{13}{3},0)" :db/id #edb/ref 17592186711069} {:answer/id #uuid "5c4fbffa-7098-5b82-9581-4d83d58bc71e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186711070} {:answer/id #uuid "7233556c-6227-5f02-9efa-f76bc8c1dbf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{17}{3},0)" :db/id #edb/ref 17592186711073} {:answer/id #uuid "9cef1c15-052b-5ccb-850b-59d512ca7d22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3},0)" :db/id #edb/ref 17592186711077} {:answer/id #uuid "ef8b7ca0-1eb6-5f5e-a4cd-22a986a653df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{2},0)" :db/id #edb/ref 17592186711081}] :answer-field/correct {:answer/id #uuid "7233556c-6227-5f02-9efa-f76bc8c1dbf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{17}{3},0)" :db/id #edb/ref 17592186711073} :answer-field/id #uuid "2dff832f-8aca-5114-8bee-c82a1fb36aed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711068}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6f083a2-570c-57a8-867f-0b7b90a54481" :question/problem "The equation $x^2+2y^2=17$ represents an ellipse. The tangent line at $(3,2)$ on the ellipse intersects the $x$-axis at $P$. What are the coordinates of $P$?\n\n![Ellipse with the tangent through (3,2) meeting the x-axis at P.](images/d3/d3a242f9c327e1ff42e8c6bb36b13a02ddf41ef4382851f53ae4805fb8deaa96.png)" :question/worked-solution "Treat $y$ as a function of $x$ and differentiate implicitly:\n\n$$\n\\begin{aligned}\n2x+4y\\frac{dy}{dx}&=0 \\\\\n\\frac{dy}{dx}&=-\\frac{x}{2y}.\n\\end{aligned}\n$$\n\nAt $(3,2)$, the tangent slope is $m=-\\frac{3}{4}$. Using this slope and the given point gives\n\n$$\n\\begin{aligned}\ny-2&=-\\frac{3}{4}(x-3) \\\\\ny&=-\\frac{3}{4}x+\\frac{17}{4}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$. Hence\n\n$$\n\\begin{aligned}\n0&=-\\frac{3}{4}x+\\frac{17}{4} \\\\\n3x&=17 \\\\\nx&=\\frac{17}{3}.\n\\end{aligned}\n$$\n\nTherefore $P=\\left(\\frac{17}{3},0\\right)$."}] [{:db/id #edb/ref 17592186711252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26586b1f-8c31-51df-934b-8b918da94d1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2} - 6 x e^{y}}{3 x^{2} e^{y} + 2 y^{2}}" :db/id #edb/ref 17592186711253} {:answer/id #uuid "40a5e807-baa8-5c2a-8a51-f5463db1ea0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2}}{3 x^{2} e^{y} + 2 y^{2}}" :db/id #edb/ref 17592186711257} {:answer/id #uuid "42d3b989-8f06-5445-9b9d-95b6686f0ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2} - 6 x e^{y}}{3 x^{2} e^{y} + 2 y}" :db/id #edb/ref 17592186711258} {:answer/id #uuid "5c851280-e188-5b89-b154-000267e29734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2}}{3 x^{2} e^{y} + 2 y}" :db/id #edb/ref 17592186711260} {:answer/id #uuid "e20b53f2-3b38-5e12-aa38-db88be14347c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2} + 6 x e^{y}}{2 y}" :db/id #edb/ref 17592186711274}] :answer-field/correct {:answer/id #uuid "42d3b989-8f06-5445-9b9d-95b6686f0ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2} - 6 x e^{y}}{3 x^{2} e^{y} + 2 y}" :db/id #edb/ref 17592186711258} :answer-field/id #uuid "e691ee3f-0262-567d-be57-391b5e5c59f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711275}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "190be9b2-e8f2-5380-9e02-1b4e3b8862dd" :question/problem "Calculate $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$ for $3 x^{2} e^{y} + y^{2}=x^{3} - 1$." :question/worked-solution "Treat $y$ as a function of $x$ and write $y'=\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$. Use the **product rule** for each mixed product, including the chain-rule factor $y^{\\prime}$ when differentiating a function of $y$.\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(3 x^{2} e^{y}\\right)&=3 x^{2} y' e^{y} + 6 x e^{y}\n\\end{aligned}\n$$\n\nDifferentiate the equation, collect all terms containing $y^{\\prime}$, and factor:\n\n$$\n\\begin{aligned}\n6 x e^{y} + y' \\left(3 x^{2} e^{y} + 2 y\\right)&=3 x^{2}\\\\\n\\left(3 x^{2} e^{y} + 2 y\\right)y^{\\prime}&=3 x^{2} - 6 x e^{y}\n\\end{aligned}\n$$\n\nDivide by the coefficient of $y^{\\prime}$:\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{3 x^{2} - 6 x e^{y}}{3 x^{2} e^{y} + 2 y}\n$$\n\nThis formula applies where $3 x^{2} e^{y} + 2 y\\ne0$."}] [{:db/id #edb/ref 17592186711276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169f4248-fa03-578b-b3c0-e4073aa8ab39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 x}{- 9 y^{2}}" :db/id #edb/ref 17592186711251} {:answer/id #uuid "3bd36847-44bc-5121-9bee-1fcf16e38c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 x^{2} \\cos{\\left(y \\right)} + 4 x}{- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{3}}" :db/id #edb/ref 17592186711256} {:answer/id #uuid "63a0ef01-a34e-5c41-b3b6-6b621325e9bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 x^{2} \\cos{\\left(y \\right)} + 4 x}{- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{2}}" :db/id #edb/ref 17592186711261} {:answer/id #uuid "b3e9cffb-b249-5ed5-9c9c-7f742260378f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 9 x^{2} \\cos{\\left(y \\right)} + 4 x}{- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{3}}" :db/id #edb/ref 17592186711268} {:answer/id #uuid "fa5c37c1-37b1-5711-b3f8-ffb47d2713ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 9 x^{2} \\cos{\\left(y \\right)} + 4 x}{- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{2}}" :db/id #edb/ref 17592186711279}] :answer-field/correct {:answer/id #uuid "fa5c37c1-37b1-5711-b3f8-ffb47d2713ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 9 x^{2} \\cos{\\left(y \\right)} + 4 x}{- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{2}}" :db/id #edb/ref 17592186711279} :answer-field/id #uuid "10791cd6-2313-5e0b-b6de-6363b9e2f28f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711249}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e78a8a7c-b555-5121-a176-65ca1c555cb7" :question/problem "Calculate $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$ for $3 x^{3} \\cos{\\left(y \\right)} - 3 y^{3}=2 x^{2} - 1$." :question/worked-solution "Treat $y$ as a function of $x$ and write $y'=\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$. Use the **product rule** for each mixed product, including the chain-rule factor $y^{\\prime}$ when differentiating a function of $y$.\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(3 x^{3} \\cos{\\left(y \\right)}\\right)&=- 3 x^{3} y' \\sin{\\left(y \\right)} + 9 x^{2} \\cos{\\left(y \\right)}\n\\end{aligned}\n$$\n\nDifferentiate the equation, collect all terms containing $y^{\\prime}$, and factor:\n\n$$\n\\begin{aligned}\n9 x^{2} \\cos{\\left(y \\right)} + y' \\left(- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{2}\\right)&=4 x\\\\\n\\left(- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{2}\\right)y^{\\prime}&=- 9 x^{2} \\cos{\\left(y \\right)} + 4 x\n\\end{aligned}\n$$\n\nDivide by the coefficient of $y^{\\prime}$:\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{- 9 x^{2} \\cos{\\left(y \\right)} + 4 x}{- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{2}}\n$$\n\nThis formula applies where $- 3 x^{3} \\sin{\\left(y \\right)} - 9 y^{2}\\ne0$."}] [{:db/id #edb/ref 17592186711277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "113728f4-ca96-5515-863e-c8efa688afe7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 x}{\\frac{2 x}{y} - 3}" :db/id #edb/ref 17592186711250} {:answer/id #uuid "596a7bf8-5461-5843-9e8c-fec040e1f1f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 x}{-3}" :db/id #edb/ref 17592186711259} {:answer/id #uuid "b0c39d20-9b23-5863-be44-3c83bb830d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 x + 2 \\ln{\\left(y \\right)}}{\\frac{2 x}{y} - 3 y}" :db/id #edb/ref 17592186711267} {:answer/id #uuid "b9cb89dc-b1e6-5d72-bab8-d4a320565a44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 x - 2 \\ln{\\left(y \\right)}}{-3}" :db/id #edb/ref 17592186711271} {:answer/id #uuid "c042a485-f133-5922-aadd-9e1ad594e7ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 x - 2 \\ln{\\left(y \\right)}}{\\frac{2 x}{y} - 3}" :db/id #edb/ref 17592186711273}] :answer-field/correct {:answer/id #uuid "c042a485-f133-5922-aadd-9e1ad594e7ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 x - 2 \\ln{\\left(y \\right)}}{\\frac{2 x}{y} - 3}" :db/id #edb/ref 17592186711273} :answer-field/id #uuid "7b838116-7ab1-51cc-99d1-851decaf90f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186711264}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e975bbcb-e69a-5175-833f-4cd1af47f214" :question/problem "Calculate $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$ for $2 x \\ln{\\left(y \\right)} - 3 y=x^{2}$. This relation requires $y>0$." :question/worked-solution "Treat $y$ as a function of $x$ and write $y'=\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}$. Use the **product rule** for each mixed product, including the chain-rule factor $y^{\\prime}$ when differentiating a function of $y$.\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(2 x \\ln{\\left(y \\right)}\\right)&=\\frac{2 x y'}{y} + 2 \\ln{\\left(y \\right)}\n\\end{aligned}\n$$\n\nDifferentiate the equation, collect all terms containing $y^{\\prime}$, and factor:\n\n$$\n\\begin{aligned}\ny' \\left(\\frac{2 x}{y} - 3\\right) + 2 \\ln{\\left(y \\right)}&=2 x\\\\\n\\left(\\frac{2 x}{y} - 3\\right)y^{\\prime}&=2 x - 2 \\ln{\\left(y \\right)}\n\\end{aligned}\n$$\n\nDivide by the coefficient of $y^{\\prime}$:\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{2 x - 2 \\ln{\\left(y \\right)}}{\\frac{2 x}{y} - 3}\n$$\n\nThis formula applies where $\\frac{2 x}{y} - 3\\ne0$. This relation requires $y>0$."}] [{:db/id #edb/ref 17592186711280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e183d4-0a74-5c57-93dc-49c1dc0ee7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 x^{2} - 4 x \\sin{\\left(y \\right)}}{3 y^{2}}" :db/id #edb/ref 17592186711255} {:answer/id #uuid "71bf8b2c-5631-5279-8483-58264971287e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/va