 =6 \\\\ (x-\\frac{1}{3})^{2}+(y-8)^{2} & =(\\sqrt{6})^{2}.\\end{aligned}\n$$\n\nWe see that $a=\\frac{1}{3},$ $b=8,$ and $r=\\sqrt{6}.$ \n\nTherefore, the circle is centered at $(\\frac{1}{3},8)$ and its radius is $\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186554938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6de55eaf-17ee-5180-b536-6e70231ca83e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(9,- \\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554944} {:answer/id #uuid "830a7024-2eb6-5534-ae40-8621397df894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-9,\\frac{5}{3})$ and radius is $2$" :db/id #edb/ref 17592186554950} {:answer/id #uuid "967b10dc-6bc5-53bb-a955-2d5fc10046b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(9,\\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554958} {:answer/id #uuid "a5998cb0-7798-5743-86e8-d75dcf141c69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-9,\\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554960} {:answer/id #uuid "aea6b0ba-0f0a-5feb-9aab-4d96970899bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-9,- \\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554962}] :answer-field/correct {:answer/id #uuid "a5998cb0-7798-5743-86e8-d75dcf141c69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-9,\\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554960} :answer-field/id #uuid "5a5970ab-7ec8-5afc-a44d-1b9799c0fd60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554935}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e262cf1-9959-5c00-9241-8356b237b6d0" :question/problem "What is the center and radius of the circle with equation $(x+9)^{2}+(y-\\frac{5}{3})^{2}=2?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+9)^{2}+(y-\\frac{5}{3})^{2} & =2 \\\\ (x-(-9))^{2}+(y-\\frac{5}{3})^{2} & =(\\sqrt{2})^{2}.\\end{aligned}\n$$\n\nWe see that $a=-9,$ $b=\\frac{5}{3},$ and $r=\\sqrt{2}.$ \n\nTherefore, the circle is centered at $(-9,\\frac{5}{3})$ and its radius is $\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186554939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a869629-3129-5a48-b814-3ca9009f93a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $75$" :db/id #edb/ref 17592186554929} {:answer/id #uuid "5363a872-00c2-59dc-9aef-c1861b33c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{3}{2},- \\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554933} {:answer/id #uuid "694d2ebd-518e-56b2-91e5-b162c47dfcdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},- \\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554942} {:answer/id #uuid "7039e8d1-5a0b-5709-9a54-16e8324253c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554945} {:answer/id #uuid "7a590015-345d-55cf-902a-d501711e512c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554948}] :answer-field/correct {:answer/id #uuid "7039e8d1-5a0b-5709-9a54-16e8324253c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554945} :answer-field/id #uuid "c5c87030-ce63-5b8f-a2fb-928bbcbfc368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554969}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "61a667fa-1c17-504b-b910-d39cb45f95f5" :question/problem "What is the center and radius of the circle with equation $$\n\\displaystyle (x+\\frac{3}{2})^{2}+(y-\\frac{1}{2})^{2}=75?\n$$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+\\frac{3}{2})^{2}+(y-\\frac{1}{2})^{2} & =75 \\\\ (x-\\left(- \\frac{3}{2}\\right))^{2}+(y-\\frac{1}{2})^{2} & =(5 \\sqrt{3})^{2}.\\end{aligned}\n$$\n\nThe radius is the positive square root of the right-hand side:\n\n$$\nr=\\sqrt{75}=\\sqrt{25\\cdot 3}=5 \\sqrt{3}.\n$$\n\nWe see that $a=- \\frac{3}{2},$ $b=\\frac{1}{2},$ and $r=5 \\sqrt{3}.$ \n\nTherefore, the circle is centered at $(- \\frac{3}{2},\\frac{1}{2})$ and its radius is $5 \\sqrt{3}.$"}] [{:db/id #edb/ref 17592186554941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14bf130e-5183-5004-9744-fe22eba9aa52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},\\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554921} {:answer/id #uuid "5a3b6c09-e3df-5465-b189-6b05b4e444b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},- \\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554934} {:answer/id #uuid "5c664509-2dac-5ad9-95fa-1d73576ad5c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},- \\frac{1}{3})$ and radius is $12$" :db/id #edb/ref 17592186554937} {:answer/id #uuid "c54cdb2d-ed97-56f8-bc85-c3ce69c7f983" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{9}{2},- \\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554968} {:answer/id #uuid "ec7cfa1e-3234-5e46-afc4-96a4b57d942b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{9}{2},\\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554977}] :answer-field/correct {:answer/id #uuid "5a3b6c09-e3df-5465-b189-6b05b4e444b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},- \\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554934} :answer-field/id #uuid "f96f4672-1e36-5de0-9612-5b0f7789c726" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554983}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "622d38f7-0ff2-5ba3-916c-fd8be20f31cd" :question/problem "What is the center and radius of the circle with equation $$\n\\displaystyle (x+\\frac{9}{2})^{2}+(y+\\frac{1}{3})^{2}=12?\n$$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+\\frac{9}{2})^{2}+(y+\\frac{1}{3})^{2} & =12 \\\\ (x-\\left(- \\frac{9}{2}\\right))^{2}+(y-\\left(- \\frac{1}{3}\\right))^{2} & =(2 \\sqrt{3})^{2}.\\end{aligned}\n$$\n\nThe radius is the positive square root of the right-hand side:\n\n$$\nr=\\sqrt{12}=\\sqrt{4\\cdot 3}=2 \\sqrt{3}.\n$$\n\nWe see that $a=- \\frac{9}{2},$ $b=- \\frac{1}{3},$ and $r=2 \\sqrt{3}.$ \n\nTherefore, the circle is centered at $(- \\frac{9}{2},- \\frac{1}{3})$ and its radius is $2 \\sqrt{3}.$"}] [{:db/id #edb/ref 17592186554943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112cf927-0220-54f4-a54e-025b846b3990" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},1)$ and radius is $\\sqrt{7}$" :db/id #edb/ref 17592186554920} {:answer/id #uuid "b67bc386-aa35-511c-9c25-2b8fcd11882e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{9}{2},-1)$ and radius is $\\sqrt{7}$" :db/id #edb/ref 17592186554965} {:answer/id #uuid "b6e33098-66e1-5b5f-88b7-0fbd06a4983f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},1)$ and radius is $7$" :db/id #edb/ref 17592186554966} {:answer/id #uuid "c696482b-c7fa-5e91-a0bd-2cac3b4af572" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{9}{2},1)$ and radius is $\\sqrt{7}$" :db/id #edb/ref 17592186554970} {:answer/id #uuid "f55cace1-0447-5da2-a569-223e42c722dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},-1)$ and radius is $\\sqrt{7}$" :db/id #edb/ref 17592186554980}] :answer-field/correct {:answer/id #uuid "112cf927-0220-54f4-a54e-025b846b3990" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},1)$ and radius is $\\sqrt{7}$" :db/id #edb/ref 17592186554920} :answer-field/id #uuid 