{5}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554954} {:answer/id #uuid "b2698ac5-037d-5bc4-9c33-57f0ce4c7f0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{5}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554964}] :answer-field/correct {:answer/id #uuid "9390e2b4-6cc6-55ef-b439-8dad57b99c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{3}{2},\\frac{5}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554954} :answer-field/id #uuid "e76a6772-8b58-5aa6-8d55-cf35e58d8475" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554975}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7115d9fc-4c78-544f-a79f-572b76b143c2" :question/problem "What is the center and radius of the circle with equation $$\n\\displaystyle (x-\\frac{3}{2})^{2}+(y-\\frac{5}{3})^{2}=12?\n$$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-\\frac{3}{2})^{2}+(y-\\frac{5}{3})^{2} & =12 \\\\ (x-\\frac{3}{2})^{2}+(y-\\frac{5}{3})^{2} & =(2 \\sqrt{3})^{2}.\\end{aligned}\n$$\n\nThe radius is the positive square root of the right-hand side:\n\n$$\nr=\\sqrt{12}=\\sqrt{4\\cdot 3}=2 \\sqrt{3}.\n$$\n\nWe see that $a=\\frac{3}{2},$ $b=\\frac{5}{3},$ and $r=2 \\sqrt{3}.$ \n\nTherefore, the circle is centered at $(\\frac{3}{2},\\frac{5}{3})$ and its radius is $2 \\sqrt{3}.$"}] [{:db/id #edb/ref 17592186554947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05deb54f-1278-5d90-a4df-cb11ac5345fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(3,- \\frac{3}{2})$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554916} {:answer/id #uuid "0f911ec9-43c1-57c5-8bc3-386823389a77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(3,\\frac{3}{2})$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554919} {:answer/id #uuid "1cd20098-d6fa-5aac-a27d-dfb6dd53ec8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-3,- \\frac{3}{2})$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554925} {:answer/id #uuid "4f47e046-6d0e-59a0-9491-42bc567168bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(3,- \\frac{3}{2})$ and radius is $6$" :db/id #edb/ref 17592186554931} {:answer/id #uuid "e326265a-ef5b-5fa5-a1d8-70164b421f43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-3,\\frac{3}{2})$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554974}] :answer-field/correct {:answer/id #uuid "05deb54f-1278-5d90-a4df-cb11ac5345fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(3,- \\frac{3}{2})$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554916} :answer-field/id #uuid "5a6a6ce4-7edc-5db9-9755-1bc6927c7c7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554936}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "73554832-d205-5c91-af0d-110fdbd01485" :question/problem "What is the center and radius of the circle with equation $(x-3)^{2}+(y+\\frac{3}{2})^{2}=6?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-3)^{2}+(y+\\frac{3}{2})^{2} & =6 \\\\ (x-3)^{2}+(y-\\left(- \\frac{3}{2}\\right))^{2} & =(\\sqrt{6})^{2}.\\end{aligned}\n$$\n\nWe see that $a=3,$ $b=- \\frac{3}{2},$ and $r=\\sqrt{6}.$ \n\nTherefore, the circle is centered at $(3,- \\frac{3}{2})$ and its radius is $\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186554953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41eb3881-27fe-5aa3-9e5e-d8094356821e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{5}{3},\\frac{7}{2})$ and radius is $6 \\sqrt{2}$" :db/id #edb/ref 17592186554928} {:answer/id #uuid "9eb35869-a632-5bb5-bc7a-4c4f84e3cca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{5}{3},- \\frac{7}{2})$ and radius is $6 \\sqrt{2}$" :db/id #edb/ref 17592186554959} {:answer/id #uuid "ca282382-0037-5a62-9b81-40739d2aa75f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{5}{3},\\frac{7}{2})$ and radius is $6 \\sqrt{2}$" :db/id #edb/ref 17592186554972} {:answer/id #uuid "f1954577-1420-5f95-b0fd-4b51291d3078" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{5}{3},- \\frac{7}{2})$ and radius is $6 \\sqrt{2}$" :db/id #edb/ref 17592186554979} {:answer/id #uuid "fc9211b3-e46e-5cf6-b678-fafa2ce94c9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{5}{3},- \\frac{7}{2})$ and radius is $72$" :db/id #edb/ref 17592186554984}] :answer-field/correct {:answer/id #uuid "f1954577-1420-5f95-b0fd-4b51291d3078" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{5}{3},- \\frac{7}{2})$ and radius is $6 \\sqrt{2}$" :db/id #edb/ref 17592186554979} :answer-field/id #uuid "c699ae23-4ea3-52d8-bcad-f2bd30023082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554971}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "915cc9d8-786e-5928-932b-d3b73bca3d09" :question/problem "What is the center and radius of the circle with equation $$\n\\displaystyle (x-\\frac{5}{3})^{2}+(y+\\frac{7}{2})^{2}=72?\n$$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-\\frac{5}{3})^{2}+(y+\\frac{7}{2})^{2} & =72 \\\\ (x-\\frac{5}{3})^{2}+(y-\\left(- \\frac{7}{2}\\right))^{2} & =(6 \\sqrt{2})^{2}.\\end{aligned}\n$$\n\nThe radius is the positive square root of the right-hand side:\n\n$$\nr=\\sqrt{72}=\\sqrt{36\\cdot 2}=6 \\sqrt{2}.\n$$\n\nWe see that $a=\\frac{5}{3},$ $b=- \\frac{7}{2},$ and $r=6 \\sqrt{2}.$ \n\nTherefore, the circle is centered at $(\\frac{5}{3},- \\frac{7}{2})$ and its radius is $6 \\sqrt{2}.$"}] [{:db/id #edb/ref 17592186554963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09d3843f-6b83-505c-b623-f51c4214dc75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{1}{3},\\frac{7}{3})$ and radius is $2 \\sqrt{5}$" :db/id #edb/ref 17592186554918} {:answer/id #uuid "eb9451fd-0ea2-5e54-b213-2b3500c56201" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},\\frac{7}{3})$ and radius is $2 \\sqrt{5}$" :db/id #edb/ref 17592186554976} {:answer/id #uuid "f0c687de-42a7-5622-98df-6b35e7e4ad90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},- \\frac{7}{3})$ and radius is $2 \\sqrt{5}$" :db/id #edb/ref 17592186554978} {:answer/id #uuid "f7999c13-8d99-5291-9b75-88dd03d9af89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{1}{3},- \\frac{7}{3})$ and radius is $2 \\sqrt{5}$" :db/id #edb/ref 17592186554981} {:answer/id #uuid "f7c2c980-6d61-5471-9327-751651a4182a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},\\frac{7}{3})$ and radius is $20$" :db/id #edb/ref 17592186554982}] :answer-field/correct {:answer/id #uuid "eb9451fd-0ea2-5e54-b213-2b3500c56201" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},\\frac{7}{3})$ and radius is $2 \\sqrt{5}$" :db/id #edb/ref 17592186554976} :answer-field/id #uuid "bb1ea1bf-8fee-5641-8e03-a3649f5ca6b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554967}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "af757fd8-e86e-58cb-bf47-46e4051962b1" :question/problem "What is the center and radius of the circle with equation $$\n\\displaystyle (x-\\frac{1}{3})^{2}+(y-\\frac{7}{3})^{2}=20?\n$$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-\\frac{1}{3})^{2}+(y-\\frac{7}{3})^{2} & =20 \\\\ (x-\\frac{1}{3})^{2}+(y-\\frac{7}{3})^{2} & =(2 \\sqrt{5})^{2}.\\end{aligned}\n$$\n\nThe radius is the positive square root of the right-hand side:\n\n$$\nr=\\sqrt{20}=\\sqrt{4\\cdot 5}=2 \\sqrt{5}.\n$$\n\nWe see that $a=\\frac{1}{3},$ $b=\\frac{7}{3},$ and $r=2 \\sqrt{5}.$ \n\nTherefore, the circle is centered at $(\\frac{1}{3},\\frac{7}{3})$ and its radius is $2 \\sqrt{5}.$"}] [{:db/id #edb/ref 175921865614