_1+y_2}{2})=(\\frac{0+0}{2},\\frac{-4+4}{2})=(0,0)\n$$\n\nSo our circle has radius $r=4$ and center $(a,b)=(0,0),$ and therefore it is represented by the following equation:\n\n$$\n\\begin{aligned}(x-a)^2+(y-b)^2 & =r^2 \\\\ (x-0)^{2}+(y-0)^{2} & =(4)^2 \\\\ {x}^{2}+{y}^{2} & =16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "294de1e0-df17-5790-8526-741804107d47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=64" :db/id #edb/ref 17592186519680} {:answer/id #uuid "30e03e58-9723-53bc-8602-1ba18cff8fde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+(y-8)^{2}=64" :db/id #edb/ref 17592186519686} {:answer/id #uuid "661e3a68-f3e0-5e0e-bbe3-d0eb2b937889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+(y+8)^{2}=64" :db/id #edb/ref 17592186519704} {:answer/id #uuid "756b9ce5-8320-5c58-af78-93478cd41aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=256" :db/id #edb/ref 17592186519707} {:answer/id #uuid "e2666db6-2efb-5fe7-9d45-09d1690ffd96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=8" :db/id #edb/ref 17592186519723}] :answer-field/correct {:answer/id #uuid "294de1e0-df17-5790-8526-741804107d47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=64" :db/id #edb/ref 17592186519680} :answer-field/id #uuid "28787899-aad1-54a0-b2cb-f9d4320ec70b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519679}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8cc7e9d5-ea1d-5e48-81ee-0a8128ff7c92" :question/problem "![](images/ba/ba4e8d2e873670ae8e941879bd54d1331af8c542b192