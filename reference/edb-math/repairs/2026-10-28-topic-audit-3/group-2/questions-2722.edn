\\sqrt{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-4{t}^{1/2}) \\\\  & =1-4\\cdot \\frac{1}{2}\\cdot {t}^{-1/2} \\\\  & =1-2{t}^{-1/2}\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1-2{t}^{-1/2}) \\\\  & =0-2\\cdot \\left(-\\frac{1}{2}\\right)\\cdot {t}^{-3/2} \\\\  & ={t}^{-3/2} \\\\  & =\\frac{1}{t\\sqrt{t}}\\end{aligned}\n$$\n\nTherefore, the force in Newtons is\n\n$$\n\\begin{aligned}F & =ma \\\\  & =5\\cdot \\left(\\frac{1}{t\\sqrt{t}}\\right) \\\\  & =\\frac{5}{t\\sqrt{t}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f71959-8d41-523d-b9d7-93d001f87eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=7\\,\\text{s}" :db/id #edb/ref 17592186266447} {:answer/id #uuid "36496745-d2cc-583e-88b4-a3329c05dd1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4\\,\\text{s}" :db/id #edb/ref 17592186266613} {:answer/id #uuid "8fbe0220-a729-5a1f-bb7a-135e47887334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=8\\,\\text{s}" :db/id #edb/ref 17592186267424} {:answer/id #uuid "a5a02478-d94a-52aa-9f4d-fb3e70582dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186267640} {:answer/id #uuid "effa1ca4-3d47-5139-9be4-ea17379cf1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186268279}] :answer-field/correct {:answer/id #uuid "36496745-d2cc-583e-88b4-a3329c05dd1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4\\,\\text{s}" :db/id #edb/ref 17592186266613} :answer-field/id #uuid "eb19bcbc-c5eb-5f34-9726-4b1416d2df57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268815}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1d91aed-e74e-5f69-8b3f-717dfe2eedd1" :question/math-academy-id "q-138910" :question/problem "A body of mass $7\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the velocity of the body is given by $v(t)=2{t}^{2}-16t+5$ meters per second.\nCalculate the time at which the force acting on the body has zero magnitude." :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the force, $m$ is the mass, and $a$ is the acceleration. \n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}-16t+5) \\\\  & =4t-16\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t-16 & =0 \\\\ 4t & =16 \\\\ t & =4\\end{aligned}\n$$\n\nTherefore, the force has zero magnitude at $t=4\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186269191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c4de6d4-c103-5122-a6c9-0d1498597655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186266258} {:answer/id #uuid "53db7ef8-ba66-5906-ab02-dcb011a1e66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186266893} {:answer/id #uuid "714ae157-c7e0-5cfb-ad81-3f42997d137f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186267139} {:answer/id #uuid "74fd1c45-cf45-5709-8e49-f229220cf534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4\\,\\text{s}" :db/id #edb/ref 17592186267172} {:answer/id #uuid "a548584a-68e8-5b4d-a3e3-249696969741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5\\,\\text{s}" :db/id #edb/ref 17592186267635}] :answer-field/correct {:answer/id #uuid "74fd1c45-cf45-5709-8e49-f229220cf534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4\\,\\text{s}" :db/id #edb/ref 17592186267172} :answer-field/id #uuid "fba86cce-1c74-5dec-bd32-80e26d0db2bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268849}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "060dcb6c-1cca-56c6-a412-40178ff6c26e" :question/math-academy-id "q-138911" :question/problem "A body of mass $5\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the velocity of the body is given by $v(t)={t}^{3}-3{t}^{2}-24t+8$ meters per second.\nCalculate the time at which the force acting on the body has zero magnitude." :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the force, $m$ is the mass, and $a$ is the acceleration. \n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3{t}^{2}-24t+8) \\\\  & =3{t}^{2}-6t-24\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}3{t}^{2}-6t-24 & =0 \\\\ {t}^{2}-2t-8 & =0 \\\\ (t+2)(t-4) & =0 \\\\ t & =-2,\\,4\\end{aligned}\n$$\n\nSince $t\\ge 0,$ we disregard the negative solution. \n\nTherefore, the force has zero magnitude at $t=4\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186269192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "370173d6-b0c5-53ff-ac3f-c0c962f3fb10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186266618} {:answer/id #uuid "c5009928-f14d-5334-a1aa-ecda199421a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186267907} {:answer/id #uuid "cc510d0c-d8d6-53b2-a134-96b0e345edd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186267974} {:answer/id #uuid "d56e15b2-b6d5-5610-993a-58e8bf180ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=10\\,\\text{s}" :db/id #edb/ref 17592186268046} {:answer/id #uuid "e7ba744c-c635-589b-b387-bc087259570c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=8\\,\\text{s}" :db/id #edb/ref 17592186268199}] :answer-field/correct {:answer/id #uuid "c5009928-f14d-5334-a1aa-ecda199421a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186267907} :answer-field/id #uuid "b33a0ea1-4eab-5945-92dd-5eb7ab4531c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268725}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "29d26542-2f18-53b4-83de-dd8ee7531587" :question/math-academy-id "q-138912" :question/problem "A body of mass $2\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the velocity of the body is given by $v(t)=6{t}^{3}-9{t}^{2}-36t+2$ meters per second.\nCalculate the time at which the force acting on the body has zero magnitude." :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the force, $m$ is the mass, and $a$ is the acceleration. \n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{3}-9{t}^{2}-36t+2) \\\\  & =18{t}^{2}-18t-36\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}18{t}^{2}-18t-36 & =0 \\\\ {t}^{2}-t-2 & =0 \\\\ (t+1)(t-2) & =0 \\\\ t & =-1,\\,2\\end{aligned}\n$$\n\nSince $t\\ge 0,$ we disregard the negative solution. \n\nTherefore, the force has zero magnitude at $t=2\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186269193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b19097a-142f-5978-b408-094c4c326e34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4\\,\\text{s}" :db/id #edb/ref 17592186267229} {:answer/id #uuid "7fd688f9-7c66-550b-9d88-748edf50c655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5\\,\\text{s}" :db/id #edb/ref 17592186267271} {:answer/id #uuid "bab7bf20-de00-52dc-9aff-245de70d891e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=10\\,\\text{s}" :db/id #edb/ref 17592186267819} {:answer/id #uuid "de90ae65-7077-5cb9-be34-adda3883214c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=8\\,\\text{s}" :db/id #edb/ref 17592186268112} {:answer/id #uuid "f6eca129-1bee-506d-9cb3-d849bb422f52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186268332}] :answer-field/correct {:answer/id #uuid "7fd688f9-7c66-550b-9d88-748edf50c655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5\\,\\text{s}" :db/id #edb/ref 17592186267271} :answer-field/id #uuid "df1444fb-b3bd-5b3c-bc52-5355647c2c02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268800}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97081d70-71f2-57bc-b330-ba202033fd6a" :question/math-academy-id "q-138913" :question/problem "A body of mass $9\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the velocity of the body is given by $v(t)=(t-4){e}^{-t}$ meters per second.\nCalculate the time at which the force acting on the body has zero magnitude." :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the force, $m$ is the mass, and $a$ is the acceleration. \n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}((t-4){e}^{-t}) \\\\  & ={e}^{-t}+(t-4)(-{e}^{-t}) \\\\  & =(5-t){e}^{-t}\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}(5-t){e}^{-t} & =0 \\\\ 5-t & =0 \\\\ t & =5\\end{aligned}\n$$\n\nTherefore, the force has zero magnitude at $t=5\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186269194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "666c66b7-2a6b-5928-91c9-27010d3ccb34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5\\,\\text{s}" :db/id #edb/ref 17592186267053} {:answer/id #uuid "adbe3465-1d82-59c2-8d02-09106eb9b75c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=8\\,\\text{s}" :db/id #edb/ref 17592186267715} {:answer/id #uuid "cd1ec9e2-b368-5943-acec-4769f497140c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186267979} {:answer/id #uuid "e587b8a0-4e92-5064-9621-01f66bcf4ca3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186268173} {:answer/id #uuid "e8e3f011-fc8f-5b8d-824c-43014f251a23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186268212}] :answer-field/correct {:answer/id #uuid "666c66b7-2a6b-5928-91c9-27010d3ccb34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5\\,\\text{s}" :db/id #edb/ref 17592186267053} :answer-field/id #uuid "4ac12c6c-d9b5-5ee6-837b-afd0a3416608" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268532}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "eb76d076-2892-598b-932c-7f56dc7516a7" :question/math-academy-id "q-138916" :question/problem "A body of mass $5\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the position of the body is given by $s(t)={t}^{4}-150{t}^{2}+8$ meters.\nCalculate the time at which the force acting on the body has zero magnitude." :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the force, $m$ is the mass, and $a$ is the acceleration. \n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}-150{t}^{2}+8) \\\\  & =4{t}^{3}-300t\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-300t) \\\\  & =12{t}^{2}-300\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}12{t}^{2}-300 & =0 \\\\ 12{t}^{2} & =300 \\\\ {t}^{2} & =25 \\\\ t & =\\pm 5\\end{aligned}\n$$\n\nSince $t\\ge 0,$ we disregard the negative solution. \n\nTherefore, the force has zero magnitude at $t=5\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186297425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dee3d248-f1dc-58b6-a0c7-41b1a55fd325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16t+12\\operatorname{cos}t" :db/id #edb/ref 17592186296448}] :answer-field/correct {:answer/id #uuid "dee3d248-f1dc-58b6-a0c7-41b1a55fd325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16t+12\\operatorname{cos}t" :db/id #edb/ref 17592186296448} :answer-field/id #uuid "512d534c-d58c-5ab1-8871-0b72ffcefd92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296792}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86ce7450-af50-5572-9488-6859cae3ad95" :question/math-academy-id "q-315648" :question/problem "A body of mass $4\\,\\text{kg}$ moves along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the velocity of the body is given by $v(t)=2{t}^{2}+3\\operatorname{sin}⁡t$ meters per second.  Find an expression for the force acting on the particle at time $t.$\n\n$F(t)=$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+3\\operatorname{sin}⁡t) \\\\  & =4t+3\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =4\\cdot (4t+3\\operatorname{cos}⁡t) \\\\  & =16t+12\\operatorname{cos}⁡t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc9e862a-fda4-556e-b421-592a2ee2c83b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296438}] :answer-field/correct {:answer/id #uuid "dc9e862a-fda4-556e-b421-592a2ee2c83b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296438} :answer-field/id #uuid "a45999b9-6b7f-5cd4-bc67-53f760c95ae0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296982}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ce341729-3a59-5798-9fad-f886c34df302" :question/math-academy-id "q-315735" :question/problem "A body of mass $2\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons $(\\text{N}).$  At time $t>0$ seconds, the position of the body is given by $s(t)={t}^{2}+4\\operatorname{ln}⁡t$ meters.\n\nCalculate the magnitude of the force at time $t=2$ seconds. Do not round the answer.\n\nThe magnitude of the force equals\n{{field-1}} $\\text{N}.$" :question/worked-solution "According to Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+4\\operatorname{ln}⁡t) \\\\  & =2t+\\frac{4}{t}\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t+\\frac{4}{t}) \\\\  & =2-\\frac{4}{{t}^{2}}\\end{aligned}\n$$\n\nAs a result, the acceleration at $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}a(2) & =2-\\frac{4}{{2}^{2}} \\\\  & =2-1 \\\\  & =1\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$\n\nTherefore, the force in Newtons is\n\n$$\n\\begin{aligned}F(2) & =ma(2) \\\\  & =2\\cdot 1 \\\\  & =2.\\end{aligned}\n$$\n\nFinally, the magnitude of the force is\n\n$$\n|F(2)|=|2|=2\\,\\text{N}.\n$$"}] [{:db/id #edb/ref 17592186318987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "934ea273-071d-5618-92aa-e65b1ca0b400" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t}{{t}^{2}+3}" :db/id #edb/ref 17592186318067}] :answer-field/correct {:answer/id #uuid "934ea273-071d-5618-92aa-e65b1ca0b400" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t}{{t}^{2}+3}" :db/id #edb/ref 17592186318067} :answer-field/id #uuid "ff736fb3-a7d5-5524-87c3-6474758c63ba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318959}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b0082ca9-a2f5-5fb4-a736-3c702acf07b6" :question/math-academy-id "q-345206" :question/problem "A body of mass $1\\,\\text{kg}$ moves along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the velocity of the body is given by $v(t)=\\operatorname{ln}⁡({t}^{2}+3)$ meters per second.  Find an expression for the force acting on the particle at time $t.$\n\n$F(t)=$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}+3)) \\\\  & =\\frac{2t}{{t}^{2}+3}\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =1\\cdot \\frac{2t}{{t}^{2}+3} \\\\  & =\\frac{2t}{{t}^{2}+3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad1f1e6-67f7-5ceb-83fb-9d36d123d761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8t}{\\sqrt{1-{t}^{2}}}" :db/id #edb/ref 17592186317811}] :answer-field/correct {:answer/id #uuid "4ad1f1e6-67f7-5ceb-83fb-9d36d123d761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8t}{\\sqrt{1-{t}^{2}}}" :db/id #edb/ref 17592186317811} :answer-field/id #uuid "5ed89474-bb5f-531d-8b05-a7fbc3018b85" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318628}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f5d86cb2-121f-5b07-970b-849f480d7ea2" :question/math-academy-id "q-345207" :question/problem "A body of mass $8\\,\\text{kg}$ moves along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the velocity of the body is given by $v(t)=t\\operatorname{arcsin}⁡(t)$ meters per second.  Find an expression for the force acting on the particle at time $t.$\n\n$F(t)=8\\operatorname{arcsin}⁡(t)\\,+$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{arcsin}⁡(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\cdot \\operatorname{arcsin}⁡(t)+t\\cdot \\frac{\\text{d}}{\\text{d}t}(\\operatorname{arcsin}⁡(t)) \\\\  & =1\\cdot \\operatorname{arcsin}⁡(t)+t\\cdot \\frac{1}{\\sqrt{1-{t}^{2}}} \\\\  & =\\operatorname{arcsin}⁡(t)+\\frac{t}{\\sqrt{1-{t}^{2}}}\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =8\\cdot (\\operatorname{arcsin}⁡(t)+\\frac{t}{\\sqrt{1-{t}^{2}}}) \\\\  & =8\\operatorname{arcsin}⁡(t)+\\frac{8t}{\\sqrt{1-{t}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2027e8f-3ab1-55e1-ba62-88b5cc29451c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-54{e}^{2t}\\operatorname{sin}({e}^{2t})" :db/id #edb/ref 17592186318260}] :answer-field/correct {:answer/id #uuid "d2027e8f-3ab1-55e1-ba62-88b5cc29451c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-54{e}^{2t}\\operatorname{sin}({e}^{2t})" :db/id #edb/ref 17592186318260} :answer-field/id #uuid "f4f1773c-8bc0-5d16-b14f-45524f1a5e76" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318931}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bbcdde8a-39f6-5e49-8b19-cc84bb2be24b" :question/math-academy-id "q-345208" :question/problem "A body of mass $9\\,\\text{kg}$ moves along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the velocity of the body is given by $v(t)=3\\operatorname{cos}⁡({e}^{2t})$ meters per second.  Find an expression for the force acting on the particle at time $t.$\n\n$F(t)=$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}[3\\operatorname{cos}⁡({e}^{2t})] \\\\  & =-3\\operatorname{sin}⁡({e}^{2t})\\cdot \\frac{\\text{d}}{\\text{d}t}({e}^{2t}) \\\\  & =-3\\operatorname{sin}⁡({e}^{2t})\\cdot 2{e}^{2t} \\\\  & =-6{e}^{2t}\\operatorname{sin}⁡({e}^{2t}).\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =9\\cdot [-6{e}^{2t}\\operatorname{sin}⁡({e}^{2t})] \\\\  & =-54{e}^{2t}\\operatorname{sin}⁡({e}^{2t}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a5bdeb-b514-5d0e-aaf0-7bec315700a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(t+1)^{2}}" :db/id #edb/ref 17592186317637}] :answer-field/correct {:answer/id #uuid "16a5bdeb-b514-5d0e-aaf0-7bec315700a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(t+1)^{2}}" :db/id #edb/ref 17592186317637} :answer-field/id #uuid "8dad6dfd-8e84-57dc-8946-f16fcfd476e8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8020a70a-eeac-5c07-988e-4b374888b493" :question/math-academy-id "q-345209" :question/problem "A body of mass $\\frac{1}{2}\\,\\text{kg}$ moves along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the velocity of the body is given by $v(t)=\\frac{2t}{t+1}$ meters per second.  Find an expression for the force acting on the particle at time $t.$\n\n$F(t)=$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{2t}{t+1}\\right) \\\\  & =\\frac{(t+1)\\cdot (2t)^{′}-2t\\cdot (t+1)^{′}}{(t+1)^{2}} \\\\  & =\\frac{2(t+1)-2t(1)}{(t+1)^{2}} \\\\  & =\\frac{(2t+2)-2t}{(t+1)^{2}} \\\\  & =\\frac{2}{(t+1)^{2}}\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{(t+1)^{2}} \\\\  & =\\frac{1}{(t+1)^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "300e195c-ddeb-57cf-a4bf-c0e974317b20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317710}] :answer-field/correct {:answer/id #uuid "300e195c-ddeb-57cf-a4bf-c0e974317b20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317710} :answer-field/id #uuid "3b62001e-c670-5582-880c-5e2e4169c1ea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318546}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "71f329b9-d17b-5f51-b752-6c65f97ea24c" :question/math-academy-id "q-345223" :question/problem "A body of mass $\\sqrt{2}\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons $(\\text{N}).$  At time $t$ seconds, the velocity of the body is given by $v(t)=\\operatorname{sec}⁡t$ meters per second. \n\nCalculate the magnitude of the force at time $t=\\frac{\\pi }{4}$ seconds. Do not round the answer.\n\nThe magnitude of the force equals\n{{field-1}} $\\text{N}.$" :question/worked-solution "According to Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sec}⁡t) \\\\  & =\\operatorname{sec}⁡t\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\nAs a result, the acceleration at $t=\\frac{\\pi }{4}\\,\\text{s}$ is\n\n$$\n\\begin{aligned}a\\left(\\frac{\\pi }{4}\\right) & =\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\sqrt{2}\\cdot 1 \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F\\left(\\frac{\\pi }{4}\\right) & =ma\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\sqrt{2}\\cdot \\sqrt{2} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, the magnitude of the force is\n\n$$\n|F\\left(\\frac{\\pi }{4}\\right)|=|2|=2\\,\\text{N}.\n$$"}] [{:db/id #edb/ref 17592186318992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8bdc11e-4e47-568b-a6a9-f883903c5a7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186318225}] :answer-field/correct {:answer/id #uuid "c8bdc11e-4e47-568b-a6a9-f883903c5a7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186318225} :answer-field/id #uuid "d88f9314-ffc3-5618-ba48-e7fd767b49c9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318884}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d70a9d0d-47bd-5a88-b909-b1c15e29fe59" :question/math-academy-id "q-345227" :question/problem "A body of mass $\\frac{1}{6}\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons $(\\text{N}).$  At time $t$ seconds, the velocity of the body is given by $v(t)=4{e}^{\\frac{t}{2}}$ meters per second. \n\nCalculate the magnitude of the force at time $t=2\\operatorname{ln}⁡3$ seconds. Do not round the answer.\n\nThe magnitude of the force equals\n{{field-1}} $\\text{N}.$" :question/worked-solution "According to Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{e}^{\\frac{t}{2}}) \\\\  & =4\\cdot \\frac{\\text{d}}{\\text{d}t}({e}^{\\frac{t}{2}}) \\\\  & =4\\cdot \\frac{1}{2}{e}^{\\frac{t}{2}} \\\\  & =2{e}^{\\frac{t}{2}}.\\end{aligned}\n$$\n\nAs a result, the acceleration at $t=2\\operatorname{ln}⁡3\\,\\text{s}$ is\n\n$$\n\\begin{aligned}a(2\\operatorname{ln}⁡3) & =2{e}^{\\frac{2\\operatorname{ln}⁡3}{2}} \\\\  & =2{e}^{\\operatorname{ln}⁡3} \\\\  & =2(3) \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(2\\operatorname{ln}⁡3) & =ma(2\\operatorname{ln}⁡3) \\\\  & =\\frac{1}{6}\\cdot 6 \\\\  & =1.\\end{aligned}\n$$\n\nFinally, the magnitude of the force is\n\n$$\n|F(2\\operatorname{ln}⁡3)|=|1|=1\\,\\text{N}.\n$$"}] [{:db/id #edb/ref 17592186319006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d49fe588-c744-5a63-91c5-499a8981ae72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}t" :db/id #edb/ref 17592186318273}] :answer-field/correct {:answer/id #uuid "d49fe588-c744-5a63-91c5-499a8981ae72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}t" :db/id #edb/ref 17592186318273} :answer-field/id #uuid "baeff6fc-96f0-58ac-b625-5c03bda65e09" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318831}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "631ab220-78bb-571b-a8c8-ae85d27d38d6" :question/math-academy-id "q-345338" :question/problem "A body of mass $2\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the position of the particle is given by $s(t)=-\\operatorname{ln}⁡|\\operatorname{cos}⁡t|$ meters.  Find the expression for the force acting on the particle at time $t.$\n\n$F(t)=$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{ln}⁡|\\operatorname{cos}⁡t|) \\\\  & =-\\frac{(-\\operatorname{sin}⁡t)}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\operatorname{tan}⁡t\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t) \\\\  & ={sec}^{2}⁡t\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =2\\cdot {sec}^{2}⁡t \\\\  & =2{sec}^{2}⁡t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d85e7d41-ec18-5c63-b1af-5af87ded570b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}t-t\\operatorname{sin}t" :db/id #edb/ref 17592186318285}] :answer-field/correct {:answer/id #uuid "d85e7d41-ec18-5c63-b1af-5af87ded570b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}t-t\\operatorname{sin}t" :db/id #edb/ref 17592186318285} :answer-field/id #uuid "921c85d0-35ae-5029-b8ac-532dad99dd13" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318743}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8f894f8-195c-59e0-8b11-05cf91764fb4" :question/math-academy-id "q-345339" :question/problem "A body of mass $1\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the position of the particle is given by $s(t)=t\\operatorname{sin}⁡t$ meters.  Find the expression for the force acting on the particle at time $t.$\n\n$F(t)=$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\cdot \\operatorname{sin}⁡t+t\\cdot \\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t) \\\\  & =1\\cdot \\operatorname{sin}⁡t+t\\cdot \\operatorname{cos}⁡t \\\\  & =\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t) \\\\  & =\\operatorname{cos}⁡t+\\frac{\\text{d}}{\\text{d}t}(t)\\cdot \\operatorname{cos}⁡t+t\\cdot \\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t) \\\\  & =\\operatorname{cos}⁡t+1\\cdot \\operatorname{cos}⁡t+t\\cdot (-\\operatorname{sin}⁡t) \\\\  & =\\operatorname{cos}⁡t+\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t \\\\  & =2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =1\\cdot (2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ee21fdb-4f31-5662-8173-652df2970035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t}{{({t}^{2}+1)}^{2}}" :db/id #edb/ref 17592186317766}] :answer-field/correct {:answer/id #uuid "3ee21fdb-4f31-5662-8173-652df2970035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t}{{({t}^{2}+1)}^{2}}" :db/id #edb/ref 17592186317766} :answer-field/id #uuid "43d3cb79-dfa8-57a8-8ad1-d8a7c894979b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318569}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a5942b5-b345-55e9-98fa-6a0c078bad31" :question/math-academy-id "q-345340" :question/problem "A body of mass $\\frac{1}{2}\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.  At time $t$ seconds, the position of the particle is given by $s(t)=\\operatorname{arctan}⁡(t)$ meters.  Find the expression for the force acting on the particle at time $t.$\n\n$F(t)=$\n\n{{field-1}}" :question/worked-solution "By Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}⁡(t)) \\\\  & =\\frac{1}{{t}^{2}+1}\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{{t}^{2}+1}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}t}[{({t}^{2}+1)}^{-1}] \\\\  & =-{({t}^{2}+1)}^{-2}\\cdot \\frac{\\text{d}}{\\text{d}t}({t}^{2}+1) \\\\  & =-\\frac{1}{{({t}^{2}+1)}^{2}}\\cdot 2t \\\\  & =-\\frac{2t}{{({t}^{2}+1)}^{2}}\\end{aligned}\n$$\n\nTherefore, the force, in Newtons, is\n\n$$\n\\begin{aligned}F(t) & =ma(t) \\\\  & =\\frac{1}{2}\\cdot [-\\frac{2t}{{({t}^{2}+1)}^{2}}] \\\\  & =-\\frac{t}{{({t}^{2}+1)}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577ed63e-50e9-50c2-818c-9a561b957b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317857}] :answer-field/correct {:answer/id #uuid "577ed63e-50e9-50c2-818c-9a561b957b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317857} :answer-field/id #uuid "28e87773-9014-5f2c-99af-a75467a94c91" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318507}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bc207cc0-1ae7-5ed9-9b6c-a4cf1fe5e4d1" :question/math-academy-id "q-345345" :question/problem "A body of mass $\\frac{1}{4}\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons $(\\text{N}).$  At time $t>0$ seconds, the position of the body is given by $s(t)={e}^{2t}$ meters.\n\nCalculate the magnitude of the force at time $t=\\operatorname{ln}⁡\\sqrt{2}$ seconds. Do not round the answer.\n\nThe magnitude of the force equals\n{{field-1}} $\\text{N}.$" :question/worked-solution "According to Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t}) \\\\  & =2{e}^{2t}\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{e}^{2t}) \\\\  & =2\\cdot 2{e}^{2t} \\\\  & =4{e}^{2t}\\end{aligned}\n$$\n\nAs a result, the acceleration at $t=\\operatorname{ln}⁡\\sqrt{2}\\,\\text{s}$ is\n\n$$\n\\begin{aligned}a(\\operatorname{ln}⁡\\sqrt{2}) & =4{e}^{2\\cdot \\operatorname{ln}⁡\\sqrt{2}} \\\\  & =4{e}^{\\operatorname{ln}⁡[{(\\sqrt{2})}^{2}]} \\\\  & =4{e}^{\\operatorname{ln}⁡2} \\\\  & =4\\cdot 2 \\\\  & =8\\end{aligned}\n$$\n\nTherefore, the force in Newtons is\n\n$$\n\\begin{aligned}F(\\operatorname{ln}⁡\\sqrt{2}) & =ma(\\operatorname{ln}⁡\\sqrt{2}) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$\n\nFinally, the magnitude of the force is\n\n$$\n|F(2)|=|2|=2\\,\\text{N}.\n$$"}] [{:db/id #edb/ref 17592186319012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e2d87a7-d2fa-5498-bf33-ce150d8c90ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317823}] :answer-field/correct {:answer/id #uuid "4e2d87a7-d2fa-5498-bf33-ce150d8c90ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317823} :answer-field/id #uuid "34d1abfd-cd09-5972-9ceb-09e2aeb99b48" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318534}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f7a6b52-3478-5ae0-b5cf-e85d41d024b9" :question/math-academy-id "q-345382" :question/problem "A body of mass $1\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the velocity of the body is given by $v(t)=\\frac{2}{3}{t}^{3}-8t$ meters per second.\n\nCalculate the time ${t}_{∗}$ at which the force acting on the body has zero magnitude. Do not round the answer.\n\n${t}_{∗}=$\n\n{{field-1}}  $\\text{s}$" :question/worked-solution "According to Newton’s second law\n\n$$\nF(t)=ma(t),\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration. \n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{3}{t}^{3}-8t) \\\\  & =2{t}^{2}-8\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}2{t}^{2}-8 & =0 \\\\ 2{t}^{2} & =8 \\\\ {t}^{2} & =4 \\\\ t & =\\pm 2\\end{aligned}\n$$\n\nSince $t\\ge 0,$ we disregard the negative solution. \n\nTherefore, the force has zero magnitude at ${t}_{∗}=2\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186319014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e538e9f8-9c5e-53da-8174-fd069874809f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186318330}] :answer-field/correct {:answer/id #uuid "e538e9f8-9c5e-53da-8174-fd069874809f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186318330} :answer-field/id #uuid "997035ca-c303-5ec4-915f-1c3d930ab103" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318762}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4ca153e4-be3b-5464-8d35-cfd52b62cce4" :question/math-academy-id "q-345388" :question/problem "A body of mass $2\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the velocity of the body is given by $v(t)=(2t-9){e}^{-2t}$ meters per second.\n\nCalculate the time ${t}_{∗}$ at which the force acting on the body has zero magnitude. Do not round the answer.\n\n${t}_{∗}=$\n\n{{field-1}}  $\\text{s}$" :question/worked-solution "According to Newton’s second law\n\n$$\nF(t)=ma(t),\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration. \n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}[(2t-9){e}^{-2t}] \\\\  & =(2t-9)\\cdot \\frac{\\text{d}}{\\text{d}t}({e}^{-2t})+{e}^{-2t}\\cdot \\frac{\\text{d}}{\\text{d}t}(2t-9) \\\\  & =(2t-9)(-2{e}^{-2t})+2{e}^{-2t} \\\\  & =(-4t+18){e}^{-2t}+2{e}^{-2t} \\\\  & =(-4t+20){e}^{-2t}\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}(-4t+20){e}^{-2t} & =0 \\\\ -4t+20 & =0 \\\\ -4t & =-20 \\\\ t & =5\\end{aligned}\n$$\n\nTherefore, the force has zero magnitude at ${t}_{∗}=5\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186319015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3329f0b0-6f0b-5b91-bc5b-b7ecd36e2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186317728}] :answer-field/correct {:answer/id #uuid "3329f0b0-6f0b-5b91-bc5b-b7ecd36e2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186317728} :answer-field/id #uuid "890b7d50-4786-5164-a728-76ca2c53251a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318724}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1f53bff2-b6cd-53cb-af8f-3a936c1a2ec6" :question/math-academy-id "q-345390" :question/problem "A body of mass $3\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons. At time $t\\ge 0$ seconds, the position of the body is given by $s(t)=4{t}^{3}-6{t}^{2}+12t+24$ meters.\n\nCalculate the time ${t}_{∗}$ at which the force acting on the body has zero magnitude. Do not round the answer.\n\n${t}_{∗}=$\n\n{{field-1}} $\\text{s}$" :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration. \n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(4{t}^{3}-6{t}^{2}+12t+24) \\\\  & =12{t}^{2}-12t+12\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(12{t}^{2}-12t+12) \\\\  & =24t-12\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}24t-12 & =0 \\\\ 24t & =12 \\\\ t & =\\frac{12}{24} \\\\ t & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the force has zero magnitude at ${t}_{∗}=\\frac{1}{2}\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186319016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35c42a8d-9700-5030-b556-07be6636569c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317736}] :answer-field/correct {:answer/id #uuid "35c42a8d-9700-5030-b556-07be6636569c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317736} :answer-field/id #uuid "6cb13732-f7e1-5a3d-b046-62e986b68617" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318659}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cf0fa979-937b-587d-a91b-d1227e9d68bc" :question/math-academy-id "q-345391" :question/problem "A body of mass $2\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons. At time $t\\ge 0$ seconds, the position of the body is given by $$\n\\displaystyle s(t)=\\frac{1}{12}{t}^{4}+\\frac{1}{6}{t}^{3}-3{t}^{2}+6t+12\n$$ meters.\n\nCalculate the time ${t}_{∗}$ at which the force acting on the body has zero magnitude. Do not round the answer.\n\n${t}_{∗}=$\n\n{{field-1}} $\\text{s}$" :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration. \n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(\\frac{1}{12}{t}^{4}+\\frac{1}{6}{t}^{3}-3{t}^{2}+6t+12) \\\\  & =\\frac{1}{3}{t}^{3}+\\frac{1}{2}{t}^{2}-6t+6\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(\\frac{1}{3}{t}^{3}+\\frac{1}{2}{t}^{2}-6t+6) \\\\  & ={t}^{2}+t-6\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}{t}^{2}+t-6 & =0 \\\\ (t-2)(t+3) & =0 \\\\ t & =-3,2\\end{aligned}\n$$\n\nSince $t\\ge 0,$ we disregard the negative solution. \n\nTherefore, the force has zero magnitude at ${t}_{∗}=2\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186368376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77e39a9e-abd6-5f6e-b019-f49fbb5fdab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368378}] :answer-field/correct {:answer/id #uuid "77e39a9e-abd6-5f6e-b019-f49fbb5fdab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368378} :answer-field/id #uuid "77b85336-61e4-5c1d-9e88-11a55fea4b1e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368377}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9ba5a4b9-764b-53b1-bfb9-bdc883b69f52" :question/math-academy-id "q-345374" :question/problem "A body of mass $64\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons $(\\text{N}).$  At time $t>0$ seconds, the position of the body is given by $s(t)=\\sqrt{t}$ meters.\n\nCalculate the magnitude of the force at time $t=4$ seconds. Do not round the answer.\n\nThe magnitude of the force equals\n{{field-1}} $\\text{N}.$" :question/worked-solution "According to Newton’s second law,\n\n$$\nF(t)=ma(t),\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{1/2}) \\\\  & =\\frac{1}{2}{t}^{-1/2}\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}{t}^{-1/2}) \\\\  & =-\\frac{1}{4}{t}^{-3/2} \\\\  & =-\\frac{1}{4{(\\sqrt{t})}^{3}}\\end{aligned}\n$$\n\nAs a result, the acceleration at $t=4\\,\\text{s}$ is\n\n$$\n\\begin{aligned}a(4) & =-\\frac{1}{4{(\\sqrt{4})}^{3}} \\\\  & =-\\frac{1}{4({2}^{3})} \\\\  & =-\\frac{1}{4\\cdot 8} \\\\  & =-\\frac{1}{32}\\end{aligned}\n$$\n\nTherefore, the force in Newtons is\n\n$$\n\\begin{aligned}F(4) & =ma(4) \\\\  & =64\\cdot -\\frac{1}{32} \\\\  & =-2.\\end{aligned}\n$$\n\nFinally, the magnitude of the force is\n\n$$\n|F(4)|=|-2|=2\\,\\text{N}.\n$$"}] [{:db/id #edb/ref 17592186368379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e066ddd-42c6-5fe6-b40c-17a26331f73c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186368381}] :answer-field/correct {:answer/id #uuid "7e066ddd-42c6-5fe6-b40c-17a26331f73c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186368381} :answer-field/id #uuid "4f0f029a-597f-5006-8cb2-9c7f0e31abcb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368380}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "588cda9c-3ac2-5ed9-a29e-46a4cf5ca1dc" :question/math-academy-id "q-345383" :question/problem "A body of mass $2\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t\\ge 0$ seconds, the velocity of the body is given by $v(t)=4{t}^{2}-32t+64$ meters per second.\n\nCalculate the time ${t}_{∗}$ at which the force acting on the body has zero magnitude. Do not round the answer.\n\n${t}_{∗}=$\n\n{{field-1}}  $\\text{s}$" :question/worked-solution "According to Newton’s second law\n\n$$\nF(t)=ma(t),\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration. \n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}-32t+64) \\\\  & =8t-32\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}8t-32 & =0 \\\\ 8t & =32 \\\\ t & =4\\end{aligned}\n$$\n\nTherefore, the force has zero magnitude at ${t}_{∗}=4\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186368382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403599fd-bf05-5e7f-a558-554e465cee45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186368384}] :answer-field/correct {:answer/id #uuid "403599fd-bf05-5e7f-a558-554e465cee45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186368384} :answer-field/id #uuid "ec03c53b-fea7-5fbd-9b3b-6edaf174ad7a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368383}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f1a79434-99bb-53b8-8094-f70a16654e2f" :question/math-academy-id "q-345392" :question/problem "A body of mass $4\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons. At time $t\\ge 0$ seconds, the position of the body is given by $$\n\\displaystyle s(t)=\\frac{1}{3}{t}^{4}-\\frac{1}{2}{t}^{2}\n$$ meters.\n\nCalculate the time ${t}_{∗}$ at which the force acting on the body has zero magnitude. Do not round the answer.\n\n${t}_{∗}=$\n\n{{field-1}} $\\text{s}$" :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration. \n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(\\frac{1}{3}{t}^{4}-\\frac{1}{2}{t}^{2}) \\\\  & =\\frac{4}{3}{t}^{3}-t\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(\\frac{4}{3}{t}^{3}-t) \\\\  & =4{t}^{2}-1\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}4{t}^{2}-1 & =0 \\\\ 4{t}^{2} & =1 \\\\ {t}^{2} & =\\frac{1}{4} \\\\ t & =\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nSince $t\\ge 0,$ we disregard the negative solution. \n\nTherefore, the force has zero magnitude at ${t}_{∗}=\\frac{1}{2}\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186368385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9ed1c7c-9225-541b-a4e1-7e79d29d0697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368387}] :answer-field/correct {:answer/id #uuid "f9ed1c7c-9225-541b-a4e1-7e79d29d0697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368387} :answer-field/id #uuid "9fb94801-0f86-51ab-8ea0-d007ab0a24bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368386}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b3458543-a878-501d-b389-3a5dcb32f5d4" :question/math-academy-id "q-345396" :question/problem "A body of mass $2\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons. At time $t\\ge 0$ seconds, the position of the body is given by $s(t)=\\frac{1}{8}{e}^{-2t}(2{t}^{2}+8t-9)$ meters.\n\nCalculate the time ${t}_{∗}$ at which the force acting on the body has zero magnitude. Do not round the answer.\n\n${t}_{∗}=$\n\n{{field-1}} $\\text{s}$" :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F(t)$ is the force, $m$ is the mass, and $a(t)$ is the acceleration. \n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,[\\frac{1}{8}{e}^{-2t}(2{t}^{2}+8t-9)] \\\\  & =\\frac{1}{8}[{e}^{-2t}\\cdot \\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+8t-9)+\\frac{\\text{d}}{\\text{d}t}({e}^{-2t})\\cdot (2{t}^{2}+8t-9)] \\\\  & =\\frac{1}{8}[{e}^{-2t}(4t+8)-2{e}^{-2t}(2{t}^{2}+8t-9)] \\\\  & =\\frac{1}{8}{e}^{-2t}[4t+8-2(2{t}^{2}+8t-9)] \\\\  & =\\frac{1}{8}{e}^{-2t}(4t+8-4{t}^{2}-16t+18) \\\\  & =\\frac{1}{8}{e}^{-2t}(-4{t}^{2}-12t+26) \\\\  & =\\frac{1}{8}{e}^{-2t}\\cdot 2(13-6t-2{t}^{2}) \\\\  & =\\frac{1}{4}{e}^{-2t}(13-6t-2{t}^{2})\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,[\\frac{1}{4}{e}^{-2t}(13-6t-2{t}^{2})] \\\\  & =\\frac{1}{4}[{e}^{-2t}\\cdot \\frac{\\text{d}}{\\text{d}t}(13-6t-2{t}^{2})+\\frac{\\text{d}}{\\text{d}t}({e}^{-2t})\\cdot (13-6t-2{t}^{2})] \\\\  & =\\frac{1}{4}[{e}^{-2t}(-6-4t)-2{e}^{-2t}(13-6t-2{t}^{2})] \\\\  & =\\frac{1}{4}{e}^{-2t}(-6-4t-26+12t+4{t}^{2}) \\\\  & =\\frac{1}{4}{e}^{-2t}(4{t}^{2}+8t-32) \\\\  & ={e}^{-2t}({t}^{2}+2t-8)\\end{aligned}\n$$\n\nSince the mass is always positive, the force has zero magnitude when the acceleration equals zero. So, we set $a(t)=0$ and solve for $t:$\n\n$$\n\\begin{aligned}{e}^{-2t}({t}^{2}+2t-8) & =0 \\\\ {t}^{2}+2t-8 & =0 \\\\ (t+4)(t-2) & =0 \\\\ t & =-4,2\\end{aligned}\n$$\n\nSince $t\\ge 0,$ we disregard the negative solution. \n\nTherefore, the force has zero magnitude at ${t}_{∗}=2\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186388573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e832d755-6425-5e23-a801-5dac72430034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{N}" :db/id #edb/ref 17592186388575} {:answer/id #uuid "6b716dc2-593b-5bc6-a037-c1a786fc9c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,\\text{N}" :db/id #edb/ref 17592186388576} {:answer/id #uuid "22b06121-c4d8-591e-8632-a3a5bc44e889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{N}" :db/id #edb/ref 17592186388577} {:answer/id #uuid "b954d17a-3142-5408-a5ec-32a2dc97c165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{N}" :db/id #edb/ref 17592186388578} {:answer/id #uuid "c7d7eb06-cb3d-5eda-a52f-8bdd6ac02ab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{N}" :db/id #edb/ref 17592186388579}] :answer-field/correct {:answer/id #uuid "6b716dc2-593b-5bc6-a037-c1a786fc9c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,\\text{N}" :db/id #edb/ref 17592186388576} :answer-field/id #uuid "779112e5-9b9b-5805-ab6f-c0178d6766a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388574}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "aff0d900-0d16-5502-bd82-5d0e6f780ecd" :question/math-academy-id "q-138907" :question/problem "A body of mass $4\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons $(\\text{N}).$\nAt time $t$ seconds, the position of the body is given by $s(t)=2{t}^{2}+{e}^{5-t}$ meters.\nCalculate the magnitude of the force at time $t=5$ seconds." :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the force, $m$ is the mass, and $a$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+{e}^{5-t}) \\\\  & =4t-{e}^{5-t}\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4t-{e}^{5-t}) \\\\  & =4-(-{e}^{5-t}) \\\\  & =4+{e}^{5-t}\\end{aligned}\n$$\n\nAs a result, the acceleration at $t=5\\,\\text{s}$ is\n\n$$\n\\begin{aligned}a & =4+{e}^{5-5} \\\\  & =4+1 \\\\  & =5\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$\n\nTherefore, the force in Newtons is\n\n$$\n\\begin{aligned}F & =ma \\\\  & =4\\cdot (5) \\\\  & =20.\\end{aligned}\n$$\n\nFinally, the magnitude of the force is\n\n$$\n|F|=|20|=20\\,\\text{N}.\n$$"}]}
