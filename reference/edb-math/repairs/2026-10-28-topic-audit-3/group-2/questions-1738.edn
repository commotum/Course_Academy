matrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}- 2 \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ - e^{- t^{2} - 2 t - 2} \\\\ 4 t^{2} + 8 t + 8\\end{bmatrix}\\cdot \\left(- 2 t - 2\\right) \\\\  & =\\begin{bmatrix}\\left(4 t + 4\\right) \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ 2 \\left(t + 1\\right) e^{- t^{2} - 2 t - 2} \\\\ - 8 \\left(t + 1\\right) \\left(t^{2} + 2 t + 2\\right)\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6961168f-8962-5d6b-b667-08e7ea815bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 4 \\left(t + 1\\right) e^{t^{2} + 2 t + 1} \\\\ - 4 \\left(t + 1\\right) \\left(t^{2} + 2 t + 1\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552709} {:answer/id #uuid "8aca49b6-75ff-5ca6-94f4-43c7f2d4e406" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ 2 e^{u} \\\\ - 2 u\\end{bmatrix}" :db/id #edb/ref 17592186552715} {:answer/id #uuid "a14e5ab9-b89c-5d93-9482-61e8df54f34e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 e^{t^{2} + 2 t + 1} \\\\ - 2 t^{2} - 4 t - 2\\end{bmatrix}" :db/id #edb/ref 17592186552721} {:answer/id #uuid "cc6980e6-f8d5-58d0-ae35-05bb1bbb5041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 e^{t^{2} + 2 t + 1} \\\\ - 2 t^{2} - 4 t - 2\\end{bmatrix}" :db/id #edb/ref 17592186552730} {:answer/id #uuid "e4aabe13-90aa-58f1-a182-9326ea0fff3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right)^{2} \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 \\left(2 t + 2\\right)^{2} e^{t^{2} + 2 t + 1} \\\\ \\left(2 t + 2\\right)^{2} \\left(- 2 t^{2} - 4 t - 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552738}] :answer-field/correct {:answer/id #uuid "6961168f-8962-5d6b-b667-08e7ea815bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 4 \\left(t + 1\\right) e^{t^{2} + 2 t + 1} \\\\ - 4 \\left(t + 1\\right) \\left(t^{2} + 2 t + 1\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552709} :answer-field/id #uuid "e5865662-f353-5c7d-b42d-d8dd39e013c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552739}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "db256af9-5b21-546d-b1d7-f812a8380522" :question/problem "If $f(u)=\\begin{bmatrix}\\sin{\\left(u \\right)} \\\\ 2 e^{u} \\\\ - u^{2}\\end{bmatrix}$ and $u(t)=t^{2} + 2 t + 1$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}f^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\left(\\sin{\\left(u \\right)}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(2 e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ 2 e^{u} \\\\ - 2 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(t^{2} + 2 t + 1\\right)=2 t + 2\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}\\cos{\\left(u(t) \\right)} \\\\ 2 e^{u(t)} \\\\ - 2 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}\\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 e^{t^{2} + 2 t + 1} \\\\ - 2 t^{2} - 4 t - 2\\end{bmatrix}\\cdot \\left(2 t + 2\\right) \\\\  & =\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 4 \\left(t + 1\\right) e^{t^{2} + 2 t + 1} \\\\ - 4 \\left(t + 1\\right) \\left(t^{2} + 2 t + 1\\right)\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01033309-8cd5-5564-9b85-b8ad716d732d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\cos{\\left(u \\right)} \\\\ e^{u} \\\\ - 4 u\\end{bmatrix}" :db/id #edb/ref 17592186552680} {:answer/id #uuid "28ace170-6fd7-58dc-a331-6505d0f7c033" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ e^{- t^{2} + 2 t - 2} \\\\ 4 t^{2} - 8 t + 8\\end{bmatrix}" :db/id #edb/ref 17592186552693} {:answer/id #uuid "43d877d3-6c07-5d5e-8615-c314b5f89e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ 2 \\left(1 - t\\right) e^{- t^{2} + 2 t - 2} \\\\ - 8 \\left(t - 1\\right) \\left(t^{2} - 2 t + 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552700} {:answer/id #uuid "8fd0e059-e8ac-5742-953f-57d50b1b8851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ e^{- t^{2} + 2 t - 2} \\\\ 4 t^{2} - 8 t + 8\\end{bmatrix}" :db/id #edb/ref 17592186552716} {:answer/id #uuid "cd0ccd77-a0b6-5684-a613-066cc806f35b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\left(2 - 2 t\\right)^{2} \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ \\left(2 - 2 t\\right)^{2} e^{- t^{2} + 2 t - 2} \\\\ \\left(2 - 2 t\\right)^{2} \\left(4 t^{2} - 8 t + 8\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552731}] :answer-field/correct {:answer/id #uuid "43d877d3-6c07-5d5e-8615-c314b5f89e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ 2 \\left(1 - t\\right) e^{- t^{2} + 2 t - 2} \\\\ - 8 \\left(t - 1\\right) \\left(t^{2} - 2 t + 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552700} :answer-field/id #uuid "5a2d3d02-f001-51c7-af88-4009d17b71e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552705}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f1640721-8544-52da-b867-ddbed4f7a20c" :question/problem "If $f(u)=\\begin{bmatrix}2 \\sin{\\left(u \\right)} \\\\ e^{u} \\\\ - 2 u^{2}\\end{bmatrix}$ and $u(t)=- t^{2} + 2 t - 2$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}f^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\left(2 \\sin{\\left(u \\right)}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- 2 u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}2 \\cos{\\left(u \\right)} \\\\ e^{u} \\\\ - 4 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(- t^{2} + 2 t - 2\\right)=2 - 2 t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}2 \\cos{\\left(u(t) \\right)} \\\\ e^{u(t)} \\\\ - 4 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}2 \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ e^{- t^{2} + 2 t - 2} \\\\ 4 t^{2} - 8 t + 8\\end{bmatrix}\\cdot \\left(2 - 2 t\\right) \\\\  & =\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ 2 \\left(1 - t\\right) e^{- t^{2} + 2 t - 2} \\\\ - 8 \\left(t - 1\\right) \\left(t^{2} - 2 t + 2\\right)\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186722859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c758eeb-bb54-52c3-b3f0-7e12ff7187d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 2t+2,\\,3-4t,\\,4\\rangle" :db/id #edb/ref 17592186722854} {:answer/id #uuid "2cfc24e7-ae03-539d-a399-920784626b03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 2t+2,\\,3+4t,\\,4\\rangle" :db/id #edb/ref 17592186722858} {:answer/id #uuid "747437e3-13ab-58c1-b893-bd972f33ac78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 2t+1,\\,3-2t,\\,2\\rangle" :db/id #edb/ref 17592186722861} {:answer/id #uuid "a61616df-83b7-5849-b890-328c55fd448b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 2t+2,\\,3-4t,\\,4t\\rangle" :db/id #edb/ref 17592186722866} {:answer/id #uuid "fe25d272-ee1f-5850-af77-82eaeba51610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 2t+2,\\,3-4t,\\,0\\rangle" :db/id #edb/ref 17592186722874}] :answer-field/correct {:answer/id #uuid "0c758eeb-bb54-52c3-b3f0-7e12ff7187d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 2t+2,\\,3-4t,\\,4\\rangle" :db/id #edb/ref 17592186722854} :answer-field/id #uuid "26c42c78-1163-5c60-b2c1-a825588b274f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722857}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5850785d-7b94-556c-954e-4b028dfae68b" :question/problem "Differentiate $\\mathbf f(t)+2\\mathbf g(t)$ with respect to $t$, where\n\n$$\n\\begin{aligned}\n\\mathbf f(t)&=\\langle t^2,\\,3t-2,\\,4\\rangle \\\\ \\mathbf g(t)&=\\langle t,\\,1-t^2,\\,2t\\rangle\n\\end{aligned}\n$$" :question/worked-solution "The sum and constant multiple rules give\n\n$$\n(\\mathbf f+2\\mathbf g)\\prime(t)=\\mathbf f\\prime(t)+2\\mathbf g\\prime(t).\n$$\n\nDifferentiate each component:\n\n$$\n\\begin{aligned}\n\\mathbf f\\prime(t)&=\\langle 2t,\\,3,\\,0\\rangle \\\\ \\mathbf g\\prime(t)&=\\langle 1,\\,-2t,\\,2\\rangle\n\\end{aligned}\n$$\n\nMultiply every component of $\\mathbf g\\prime(t)$ by $2$, then add corresponding components:\n\n$$\n\\begin{aligned}\n(\\mathbf f+2\\mathbf g)\\prime(t)&=\\langle 2t,\\,3,\\,0\\rangle+2\\langle 1,\\,-2t,\\,2\\rangle \\\\ &=\\langle 2t+2,\\,3-4t,\\,4\\rangle.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186722862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6b2cb3-0953-5e99-95be-7f2e3934e3c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle \\frac{1}{\\sqrt{t+1}}+\\frac{1}{(t+1)^2},\\,\\frac{2}{t+1}-2e^{2t},\\,-2\\sin(2t)-\\cos(2t)\\rangle" :db/id #edb/ref 17592186722855} {:answer/id #uuid "58979c92-b2f5-538f-b4fe-588be7a90ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle \\frac{1}{\\sqrt{t+1}}-\\frac{1}{(t+1)^2},\\,\\frac{2}{t+1}-2e^{2t},\\,-4\\sin(2t)-2\\cos(2t)\\rangle" :db/id #edb/ref 17592186722860} {:answer/id #uuid "88847e9f-a422-57a9-8b73-226199df0502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle \\frac{1}{\\sqrt{t+1}}+\\frac{1}{(t+1)^2},\\,\\frac{2}{t+1}-2e^{2t},\\,-4\\sin(2t)+2\\cos(2t)\\rangle" :db/id #edb/ref 17592186722863} {:answer/id #uuid "ab3f9aaf-3f27-59c2-a3d6-fb20b479677f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle \\frac{1}{\\sqrt{t+1}}+\\frac{1}{(t+1)^2},\\,\\frac{2}{t+1}-e^{2t},\\,-4\\sin(2t)-2\\cos(2t)\\rangle" :db/id #edb/ref 17592186722867} {:answer/id #uuid "b3d6a4b0-2759-50be-913c-14168089897e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle \\frac{1}{\\sqrt{t+1}}+\\frac{1}{(t+1)^2},\\,\\frac{2}{t+1}-2e^{2t},\\,-4\\sin(2t)-2\\cos(2t)\\rangle" :db/id #edb/ref 17592186722868}] :answer-field/correct {:answer/id #uuid "b3d6a4b0-2759-50be-913c-14168089897e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle \\frac{1}{\\sqrt{t+1}}+\\frac{1}{(t+1)^2},\\,\\frac{2}{t+1}-2e^{2t},\\,-4\\sin(2t)-2\\cos(2t)\\rangle" :db/id #edb/ref 17592186722868} :answer-field/id #uuid "c7d6cfd6-1cb8-54ba-b98c-27b5ac880619" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722870}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87c2dd6b-a359-5e66-9212-aad50d85ddce" :question/problem "For $t>-1$, find $(2\\mathbf f-\\mathbf g)\\prime(t)$ in component form, where\n\n$$\n\\begin{aligned}\n\\mathbf f(t)&=\\langle \\sqrt{t+1},\\,\\ln(t+1),\\,\\cos(2t)\\rangle \\\\ \\mathbf g(t)&=\\langle \\frac{1}{t+1},\\,e^{2t},\\,\\sin(2t)\\rangle\n\\end{aligned}\n$$" :question/worked-solution "Keep the constant coefficients while differentiating:\n\n$$\n(2\\mathbf f-\\mathbf g)\\prime(t)=2\\mathbf f\\prime(t)-\\mathbf g\\prime(t).\n$$\n\nThe component derivatives are\n\n$$\n\\begin{aligned}\n\\mathbf f\\prime(t)&=\\langle \\frac{1}{2\\sqrt{t+1}},\\,\\frac{1}{t+1},\\,-2\\sin(2t)\\rangle \\\\ \\mathbf g\\prime(t)&=\\langle -\\frac{1}{(t+1)^2},\\,2e^{2t},\\,2\\cos(2t)\\rangle\n\\end{aligned}\n$$\n\nThe factors of $2$ in the exponential and trigonometric derivatives come from differentiating their inner argument $2t$. Now scale and subtract component by component:\n\n$$\n\\begin{aligned}\n2\\mathbf f\\prime(t)&=\\langle \\frac{1}{\\sqrt{t+1}},\\,\\frac{2}{t+1},\\,-4\\sin(2t)\\rangle\n\\end{aligned}\n$$\n\nSubtracting $\\mathbf g\\prime(t)$ gives $(2\\mathbf f-\\mathbf g)\\prime(t)$ as\n\n$$\n\\begin{bmatrix}\\frac{1}{\\sqrt{t+1}}+\\frac{1}{(t+1)^2} \\\\ \\frac{2}{t+1}-2e^{2t} \\\\ -4\\sin(2t)-2\\cos(2t)\\end{bmatrix}.\n$$\n\nThe first component contains a plus sign because the reciprocal derivative is negative and is being subtracted. The stated domain keeps both the logarithm and all derivative components defined."}] [{:db/id #edb/ref 17592186722864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "231223e3-091c-5864-9ca9-3900abd8a3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186722856} {:answer/id #uuid "a471d73d-1088-55ed-b012-ff1d3167eb06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186722865} {:answer/id #uuid "bc9137ee-cae6-54c3-a984-1dbdc072ac8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186722869} {:answer/id #uuid "c8010746-37a3-52e4-8803-7c76fa3aaf76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186722871} {:answer/id #uuid "e0b4a3c7-01ee-54b1-8afc-20203102c10b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186722872}] :answer-field/correct {:answer/id #uuid "231223e3-091c-5864-9ca9-3900abd8a3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186722856} :answer-field/id #uuid "efb76e6f-ea0a-584b-979a-9bf0140f34ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722873}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9a66a99a-37ab-5e7d-b05e-676bc586234b" :question/problem "Find $(2\\mathbf f-\\mathbf g)\\prime(1)$, where, for $t>0$,\n\n$$\n\\begin{aligned}\n\\mathbf f(t)&=\\begin{bmatrix}2\\sqrt{t+3} \\\\ \\cos(t-1) \\\\ \\ln t\\end{bmatrix} \\\\ \\mathbf g(t)&=\\begin{bmatrix}t^2 \\\\ t^3 \\\\ e^{t-1}\\end{bmatrix}\n\\end{aligned}\n$$" :question/worked-solution "Differentiate before substituting the evaluation point. The sum and constant multiple rules give\n\n$$\n(2\\mathbf f-\\mathbf g)\\prime(t)=2\\mathbf f\\prime(t)-\\mathbf g\\prime(t).\n$$\n\nComponent by component,\n\n$$\n\\begin{aligned}\n\\mathbf f\\prime(t)&=\\begin{bmatrix}\\frac{1}{\\sqrt{t+3}} \\\\ -\\sin(t-1) \\\\ \\frac{1}{t}\\end{bmatrix} \\\\ \\mathbf g\\prime(t)&=\\begin{bmatrix}2t \\\\ 3t^2 \\\\ e^{t-1}\\end{bmatrix}\n\\end{aligned}\n$$\n\nEvaluating at $t=1$ gives\n\n$$\n\\begin{aligned}\n\\mathbf f\\prime(1)&=\\begin{bmatrix}\\frac12 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\mathbf g\\prime(1)&=\\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix}\n\\end{aligned}\n$$\n\nCombine the derivative values:\n\n$$\n\\begin{aligned}\n(2\\mathbf f-\\mathbf g)\\prime(1)&=2\\begin{bmatrix}\\frac12 \\\\ 0 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix} \\\\ &=\\begin{bmatrix}1-2 \\\\ 0-3 \\\\ 2-1\\end{bmatrix} \\\\ &=\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186722980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef07645-a1bb-5020-9494-1f20f4a7c628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos{\\left(2 t \\right)} \\\\ 0 \\\\ - \\left(\\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t}\\end{bmatrix}" :db/id #edb/ref 17592186722974} {:answer/id #uuid "188b9abb-61ba-5366-82ef-f3f0bbcfa631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos^{2}{\\left(t \\right)} \\\\ - \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} \\\\ - e^{t} \\cos{\\left(t \\right)}\\end{bmatrix}" :db/id #edb/ref 17592186722976} {:answer/id #uuid "30887dfe-da52-545d-8d8e-8ecf784dee38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos{\\left(2 t \\right)} \\\\ - \\sin{\\left(2 t \\right)} \\\\ - \\left(\\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t}\\end{bmatrix}" :db/id #edb/ref 17592186722978} {:answer/id #uuid "68112bc7-f352-551d-b4b1-3afdf5b7dbf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos{\\left(2 t \\right)} \\\\ - \\sin{\\left(2 t \\right)} \\\\ \\left(\\sin{\\left(t \\right)} - \\cos{\\left(t \\right)}\\right) e^{t}\\end{bmatrix}" :db/id #edb/ref 17592186722985} {:answer/id #uuid "aa0f1e51-67b5-5867-b2e0-cdee8d22cdbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos{\\left(2 t \\right)} \\\\ \\sin{\\left(2 t \\right)} \\\\ - \\left(\\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t}\\end{bmatrix}" :db/id #edb/ref 17592186722989}] :answer-field/correct {:answer/id #uuid "30887dfe-da52-545d-8d8e-8ecf784dee38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos{\\left(2 t \\right)} \\\\ - \\sin{\\left(2 t \\right)} \\\\ - \\left(\\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t}\\end{bmatrix}" :db/id #edb/ref 17592186722978} :answer-field/id #uuid "e829553b-4099-572d-a6da-924fcbbc73ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722993}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35965478-f53a-5fac-81aa-ae163d831cd1" :question/problem "Find $\\big(u(t)\\mathbf f(t)\\big)^{\\prime}$, where\n\n$$\nu(t)=- \\sin{\\left(t \\right)},\\qquad \\mathbf f(t)=\\begin{bmatrix}\\cos{\\left(t \\right)} \\\\ \\sin{\\left(t \\right)} \\\\ e^{t}\\end{bmatrix}.\n$$" :question/worked-solution "Use the scalar function multiple rule:\n\n$$\n\\big(u(t)\\mathbf f(t)\\big)^{\\prime}=u^{\\prime}(t)\\mathbf f(t)+u(t)\\mathbf f^{\\prime}(t).\n$$\n\nDifferentiate the scalar and each vector component:\n\n$$\nu^{\\prime}(t)=-\\cos t.\n$$\n\n\n\n$$\n\\mathbf f^{\\prime}(t)=\\begin{bmatrix}- \\sin{\\left(t \\right)} \\\\ \\cos{\\left(t \\right)} \\\\ e^{t}\\end{bmatrix}.\n$$\n\nSubstitute both terms and add corresponding components:\n\n$$\n\\begin{aligned}\\big(u(t)\\mathbf f(t)\\big)^{\\prime}&=\\big(-\\cos t\\big)\\begin{bmatrix}\\cos{\\left(t \\right)} \\\\ \\sin{\\left(t \\right)} \\\\ e^{t}\\end{bmatrix}\\\\&\\quad+\\big(- \\sin{\\left(t \\right)}\\big)\\begin{bmatrix}- \\sin{\\left(t \\right)} \\\\ \\cos{\\left(t \\right)} \\\\ e^{t}\\end{bmatrix}\\\\&=\\begin{bmatrix}- \\cos{\\left(2 t \\right)} \\\\ - \\sin{\\left(2 t \\right)} \\\\ - \\left(\\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t}\\end{bmatrix}.\\end{aligned}\n$$\n\nHere $\\sin^2t-\\cos^2t=-\\cos(2t)$ and $-2\\sin t\\cos t=-\\sin(2t)$. Both negative contributions remain in the third component."}] [{:db/id #edb/ref 17592186722984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b4d920a-c959-5893-a463-a799005206ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t \\\\ t^{2} \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186722982} {:answer/id #uuid "89791138-361d-57bb-8b3a-40aea22adf0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 t + 1 \\\\ 3 t^{2} + 2 t \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186722987} {:answer/id #uuid "e36cc21a-ded4-5bb3-89fc-e30b3e9ba1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 t + 1 \\\\ 2 t^{2} + 2 t \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186722991} {:answer/id #uuid "e596b624-bf14-5519-8a94-ae838183ee46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t + 1 \\\\ 2 t^{2} + 2 t \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186722992} {:answer/id #uuid "fb5b650e-9140-57ba-82f8-66d6adc4c41d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 t + 1 \\\\ 3 t^{2} + 2 t \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186722994}] :answer-field/correct {:answer/id #uuid "fb5b650e-9140-57ba-82f8-66d6adc4c41d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 t + 1 \\\\ 3 t^{2} + 2 t \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186722994} :answer-field/id #uuid "c4286d77-35fc-546f-a2cb-4945c5c3b15b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722990}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e6ae2f7-19a6-5a4a-a37d-235308b84ccd" :question/problem "Find $\\big(u(t)\\mathbf f(t)\\big)^{\\prime}$, where\n\n$$\nu(t)=t + 1,\\qquad \\mathbf f(t)=\\begin{bmatrix}t \\\\ t^{2} \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "Use the scalar function multiple rule:\n\n$$\n\\big(u(t)\\mathbf f(t)\\big)^{\\prime}=u^{\\prime}(t)\\mathbf f(t)+u(t)\\mathbf f^{\\prime}(t).\n$$\n\nDifferentiate the scalar and each vector component:\n\n$$\nu^{\\prime}(t)=1.\n$$\n\n\n\n$$\n\\mathbf f^{\\prime}(t)=\\begin{bmatrix}1 \\\\ 2 t \\\\ 0\\end{bmatrix}.\n$$\n\nSubstitute both terms and add corresponding components:\n\n$$\n\\begin{aligned}\\big(u(t)\\mathbf f(t)\\big)^{\\prime}&=\\big(1\\big)\\begin{bmatrix}t \\\\ t^{2} \\\\ 2\\end{bmatrix}\\\\&\\quad+\\big(t + 1\\big)\\begin{bmatrix}1 \\\\ 2 t \\\\ 0\\end{bmatrix}\\\\&=\\begin{bmatrix}2 t + 1 \\\\ 3 t^{2} + 2 t \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186722988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e64393d-079a-575d-a586-871fb8f37723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t^{2} \\left(3 \\ln{\\left(t \\right)} + 1\\right) \\\\ \\left(\\left(t + 1\\right) \\ln{\\left(t \\right)} + 1\\right) e^{t} \\\\ \\frac{1}{t}\\end{bmatrix}" :db/id #edb/ref 17592186722977} {:answer/id #uuid "358b4fc7-498c-5061-88dd-888001f98bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t^{2} \\left(3 \\ln{\\left(t \\right)} + 1\\right) \\\\ \\left(t \\ln{\\left(t \\right)} + 1\\right) e^{t} \\\\ \\frac{1}{t}\\end{bmatrix}" :db/id #edb/ref 17592186722979} {:answer/id #uuid "38aac34d-6544-5fc4-977a-0b4804b16205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t^{2} \\left(3 \\ln{\\left(t \\right)} + 1\\right) \\\\ \\left(\\left(t + 1\\right) \\ln{\\left(t \\right)} + 1\\right) e^{t} \\\\ \\frac{\\ln{\\left(t \\right)}}{t}\\end{bmatrix}" :db/id #edb/ref 17592186722981} {:answer/id #uuid "512d1b79-3558-5dac-b4ab-a2de3038caba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t^{2} \\left(1 - \\ln{\\left(t \\right)}\\right) \\\\ \\left(\\left(1 - t\\right) \\ln{\\left(t \\right)} + 1\\right) e^{t} \\\\ \\frac{2 \\ln{\\left(t \\right)} + 1}{t}\\end{bmatrix}" :db/id #edb/ref 17592186722983} {:answer/id #uuid "6ab186c7-73db-5dcf-8020-ebdddb994109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 t^{2} \\ln{\\left(t \\right)} \\\\ \\left(t + 1\\right) e^{t} \\ln{\\left(t \\right)} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186722986}] :answer-field/correct {:answer/id #uuid "2e64393d-079a-575d-a586-871fb8f37723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}t^{2} \\left(3 \\ln{\\left(t \\right)} + 1\\right) \\\\ \\left(\\left(t + 1\\right) \\ln{\\left(t \\right)} + 1\\right) e^{t} \\\\ \\frac{1}{t}\\end{bmatrix}" :db/id #edb/ref 17592186722977} :answer-field/id #uuid "1207e0c4-4006-5fc8-b8c5-7e3566ef8a8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186722975}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "97c145f1-410d-5b44-8ef5-8d31acd301e1" :question/problem "Find $\\big(u(t)\\mathbf f(t)\\big)^{\\prime}$, where\n\n$$\nu(t)=t \\ln{\\left(t \\right)},\\qquad \\mathbf f(t)=\\begin{bmatrix}t^{2} \\\\ e^{t} \\\\ \\frac{1}{t}\\end{bmatrix}.\n$$\n\nAssume $t>0$." :question/worked-solution "Use the scalar function multiple rule:\n\n$$\n\\big(u(t)\\mathbf f(t)\\big)^{\\prime}=u^{\\prime}(t)\\mathbf f(t)+u(t)\\mathbf f^{\\prime}(t).\n$$\n\nThe scalar is itself a product. Differentiate both factors:\n\n$$\nu^{\\prime}(t)=1\\cdot\\ln t+t\\cdot\\frac{1}{t}=\\ln t+1.\n$$\n\n\n\n$$\n\\mathbf f^{\\prime}(t)=\\begin{bmatrix}2 t \\\\ e^{t} \\\\ - \\frac{1}{t^{2}}\\end{bmatrix}.\n$$\n\nSubstitute both terms and add corresponding components:\n\n$$\n\\begin{aligned}\\big(u(t)\\mathbf f(t)\\big)^{\\prime}&=\\big(\\ln t+1\\big)\\begin{bmatrix}t^{2} \\\\ e^{t} \\\\ \\frac{1}{t}\\end{bmatrix}\\\\&\\quad+\\big(t \\ln{\\left(t \\right)}\\big)\\begin{bmatrix}2 t \\\\ e^{t} \\\\ - \\frac{1}{t^{2}}\\end{bmatrix}\\\\&=\\begin{bmatrix}t^{2} \\left(3 \\ln{\\left(t \\right)} + 1\\right) \\\\ \\left(\\left(t + 1\\right) \\ln{\\left(t \\right)} + 1\\right) e^{t} \\\\ \\frac{1}{t}\\end{bmatrix}.\\end{aligned}\n$$\n\nIn the third component, the two logarithmic terms cancel:\n\n$$\n\\frac{\\ln t+1}{t}-\\frac{\\ln t}{t}=\\frac{1}{t}.\n$$"}] [{:db/id #edb/ref 17592186723081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc1a0a8b-5844-548f-9028-83bea55b846e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t}{(1+t^2)^{3/2}}" :db/id #edb/ref 17592186723098}] :answer-field/correct {:answer/id #uuid "cc1a0a8b-5844-548f-9028-83bea55b846e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t}{(1+t^2)^{3/2}}" :db/id #edb/ref 17592186723098} :answer-field/id #uuid "0cb0dcbf-199b-5848-9d26-4d77473609ec" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186723083} {:answer-field/choices [{:answer/id #uuid "4aa63a64-c9d1-5383-9fc4-51c28d684bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t}{1+t^2}" :db/id #edb/ref 17592186723088}] :answer-field/correct {:answer/id #uuid "4aa63a64-c9d1-5383-9fc4-51c28d684bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t}{1+t^2}" :db/id #edb/ref 17592186723088} :answer-field/id #uuid "22eb6225-4144-5ea1-bae0-e97ed71e4032" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186723084} {:answer-field/choices [{:answer/id #uuid "cd15286e-5ae2-5dcc-a98a-97cdd7e4bc5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186723099}] :answer-field/correct {:answer/id #uuid "cd15286e-5ae2-5dcc-a98a-97cdd7e4bc5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186723099} :answer-field/id #uuid "e014e672-4d9f-5b6c-b361-9911c5edfff0" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186723100}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0454f514-e0b9-5c05-a760-abe18a9fdfa5" :question/problem "Let $\\mathbf g(u)=\\begin{bmatrix}\\ln u \\\\ u^2 \\\\ 1/u\\end{bmatrix}$ and $u(t)=\\sqrt{1+t^2}$. Find all three components of $(\\mathbf g\\circ u)'(t)$ as functions of $t$.\n\nWrite\n\n$$\n(\\mathbf g\\circ u)'(t)=\\begin{bmatrix}A(t) \\\\ B(t) \\\\ C(t)\\end{bmatrix}.\n$$\n\n$A(t)=$ {{A}}\n\n$B(t)=$ {{B}}\n\n$C(t)=$ {{C}}" :question/worked-solution "The inner function is itself a composition. Differentiate the square root and its input $1+t^2$:\n\n$$\nu'(t)=\\frac{1}{2\\sqrt{1+t^2}}\\cdot2t=\\frac{t}{\\sqrt{1+t^2}}.\n$$\n\nThe outer vector derivative is\n\n$$\n\\mathbf g'(u)=\\begin{bmatrix}1/u \\\\ 2u \\\\ -1/u^2\\end{bmatrix}.\n$$\n\nNow substitute the inner input and multiply all three components by the inner derivative:\n\n$$\n\\begin{aligned}\n(\\mathbf g\\circ u)'(t)&=\\mathbf g'(u(t))u'(t) \\\\\n&=\\begin{bmatrix}\\dfrac{1}{\\sqrt{1+t^2}} \\\\ 2\\sqrt{1+t^2} \\\\ -\\dfrac{1}{1+t^2}\\end{bmatrix}\\cdot\\frac{t}{\\sqrt{1+t^2}} \\\\\n&=\\begin{bmatrix}\\dfrac{t}{1+t^2} \\\\ 2t \\\\ -\\dfrac{t}{(1+t^2)^{3/2}}\\end{bmatrix}.\n\\end{aligned}\n$$\n\nThus $A(t)=t/(1+t^2)$, $B(t)=2t$, and $C(t)=-t/(1+t^2)^{3/2}$. These formulas hold for every real $t$, since $u(t)\\geq1$."}] [{:db/id #edb/ref 17592186723089 :question/answer-fields [{:answer-field/choices [{:answer/feedback "This is $\\mathbf g^{\\prime}(1/2)$. It still needs the multiplier $u^{\\prime}(\\ln 2)=-1/2$." :answer/id #uuid "2fe2a2fe-0f41-5f53-a3f9-454d549fc42b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186723085} {:answer/feedback "The reciprocal derivative is negative, and $u^{\\prime}(\\ln 2)$ is also negative. Their product is positive." :answer/id #uuid "68ca2403-830e-53f6-b357-4d9d8bf0acb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1/2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186723090} {:answer/feedback "Evaluate the outer derivative at $u(\\ln 2)=1/2$, then multiply every component by $-1/2$." :answer/id #uuid "71b6e28e-8710-5388-917f-3b2bfc13f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1/2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186723091} {:answer/feedback "The inner derivative is $-e^{-t}$, so the common multiplier is $-1/2$, not $1/2$." :answer/id #uuid "88ce7d6d-0e0f-5d43-bffd-2c8c65b54b1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 1/2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186723094} {:answer/feedback "The second component is $2(1/2)(-1/2)=-1/2$." :answer/id #uuid "a51a79e1-a877-5521-adf7-7435bdc3cec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186723096}] :answer-field/correct {:answer/feedback "Evaluate the outer derivative at $u(\\ln 2)=1/2$, then multiply every component by $-1/2$." :answer/id #uuid "71b6e28e-8710-5388-917f-3b2bfc13f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1/2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186723091} :answer-field/id #uuid "31c8e142-07b9-5716-9343-e6d09af20b0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723086}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54431f49-d58a-56d2-a215-6850fe5a1307" :question/problem "Let $\\mathbf g(u)=\\begin{bmatrix}\\ln u \\\\ u^2 \\\\ 1/u\\end{bmatrix}$ and $u(t)=e^{-t}$. Find $(\\mathbf g\\circ u)'(\\ln 2)$." :question/worked-solution "First find the two derivatives:\n\n$$\n\\mathbf g'(u)=\\begin{bmatrix}1/u \\\\ 2u \\\\ -1/u^2\\end{bmatrix},\\qquad u'(t)=-e^{-t}.\n$$\n\nAt $t=\\ln 2$, the input to $\\mathbf g'$ is $u(\\ln 2)=e^{-\\ln 2}=1/2$, while the scalar multiplier is $u'(\\ln 2)=-1/2$. These are different roles in the chain rule:\n\n$$\n\\begin{aligned}\n(\\mathbf g\\circ u)'(\\ln 2)&=\\mathbf g'(u(\\ln 2))u'(\\ln 2) \\\\\n&=\\mathbf g'(1/2)\\cdot(-1/2) \\\\\n&=\\begin{bmatrix}2 \\\\ 1 \\\\ -4\\end{bmatrix}\\cdot(-1/2) \\\\\n&=\\begin{bmatrix}-1 \\\\ -1/2 \\\\ 2\\end{bmatrix}.\n\\end{aligned}\n$$\n\nThe third component is positive because both the reciprocal derivative and the inner derivative are negative."}] [{:db/id #edb/ref 17592186723093 :question/answer-fields [{:answer-field/choices [{:answer/feedback "This is $\\mathbf f^{\\prime}(u(t))$. Multiply all components by $u^{\\prime}(t)=2$." :answer/id #uuid "0acbb7ce-b399-50d8-939b-9bb9804ffa4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 4t-2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186723082} {:answer/feedback "The derivative of the constant third component is $0$." :answer/id #uuid "3ea37d3a-229a-547f-8bb9-fe90ca96232f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 8t-4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186723087} {:answer/feedback "Each component is differentiated, evaluated at $2t-1$, and multiplied by $2$." :answer/id #uuid "9cdf4899-ac70-5b54-b1b9-555976175a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 8t-4 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186723095} {:answer/feedback "The inner input is $2t-1$, so the second component is $2(2t-1)\\cdot2=8t-4$." :answer/id #uuid "bed327f6-5c61-5063-90a1-652bcd056d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 8t \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186723097} {:answer/feedback "The second component also needs the factor $u^{\\prime}(t)=2$." :answer/id #uuid "f34ddbcc-9367-520b-86a2-d1c349f2c9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 4t-2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186723101}] :answer-field/correct {:answer/feedback "Each component is differentiated, evaluated at $2t-1$, and multiplied by $2$." :answer/id #uuid "9cdf4899-ac70-5b54-b1b9-555976175a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 8t-4 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186723095} :answer-field/id #uuid "733acf0b-7669-540c-abf8-1f6b5917a542" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723092}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "840642f5-aa27-520e-8f78-3aca046b81b4" :question/problem "Let $\\mathbf f(u)=\\begin{bmatrix}3u \\\\ u^2 \\\\ 5\\end{bmatrix}$ and $u(t)=2t-1$. Find $(\\mathbf f\\circ u)^{\\prime}(t)$." :question/worked-solution "Differentiate the vector component by component with respect to $u$, and differentiate the inner function with respect to $t$:\n\n$$\n\\mathbf f'(u)=\\begin{bmatrix}3 \\\\ 2u \\\\ 0\\end{bmatrix},\\qquad u'(t)=2.\n$$\n\nThe chain rule multiplies every component of $\\mathbf f'(u(t))$ by the same scalar $u'(t)$:\n\n$$\n\\begin{aligned}\n(\\mathbf f\\circ u)'(t)&=\\mathbf f'(u(t))u'(t) \\\\\n&=\\begin{bmatrix}3 \\\\ 2(2t-1) \\\\ 0\\end{bmatrix}\\cdot 2 \\\\\n&=\\begin{bmatrix}6 \\\\ 8t-4 \\\\ 0\\end{bmatrix}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186723289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f5848b-5ce9-5812-86dd-4350364cb440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 i \\sin{\\left(t \\right)} + 18 j \\sin{\\left(t \\right)} - 5 k \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186723294} {:answer/id #uuid "6d0299f1-0ef0-5979-9b72-5e71e4cc6e29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 i \\sin{\\left(t \\right)} + 18 j \\sin{\\left(t \\right)} - 8 k \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186723298} {:answer/id #uuid "7a2f96e8-a74a-5297-9d4b-c3da70bca314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 i \\sin{\\left(t \\right)} + 12 j \\sin{\\left(t \\right)} - 8 k \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186723299} {:answer/id #uuid "7e4ac374-7b3c-51d0-9d17-7a114e3208fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 i \\sin{\\left(t \\right)} + 14 j \\sin{\\left(t \\right)} - 7 k \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186723300} {:answer/id #uuid "b36d038b-e4fa-5a4e-a992-d8143400781c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 i \\sin{\\left(t \\right)} + 12 j \\sin{\\left(t \\right)} - 5 k \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186723309}] :answer-field/correct {:answer/id #uuid "46f5848b-5ce9-5812-86dd-4350364cb440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 i \\sin{\\left(t \\right)} + 18 j \\sin{\\left(t \\right)} - 5 k \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186723294} :answer-field/id #uuid "0ca08612-c78f-5ce9-bfbc-eaec648ab2e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723284}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c8892ed-0638-5c39-b66a-7099d2aee893" :question/problem "Find $(2f(t)+3g(t))^{\\prime}$, where $t\\in\\mathbb R$ and\n\n$$\n\\begin{aligned}f(t)&=- 3 i \\cos{\\left(t \\right)} - 6 j \\cos{\\left(t \\right)} - 4 k \\sin{\\left(t \\right)} \\\\ g(t)&=- 2 i - 2 j \\cos{\\left(t \\right)} + k \\sin{\\left(t \\right)} - 5 k\\end{aligned}\n$$" :question/worked-solution "Apply the **sum and constant multiple rules**:\n\n$$\n(2f(t)+3g(t))^{\\prime}=2f^{\\prime}(t)+3g^{\\prime}(t).\n$$\n\nDifferentiate each component:\n\n$$\n\\begin{aligned}f^{\\prime}(t)&=3 i \\sin{\\left(t \\right)} + 6 j \\sin{\\left(t \\right)} - 4 k \\cos{\\left(t \\right)} \\\\ g^{\\prime}(t)&=2 j \\sin{\\left(t \\right)} + k \\cos{\\left(t \\right)}\\end{aligned}\n$$\n\nScale every component by its constant multiplier:\n\n$$\n\\begin{aligned}2f^{\\prime}(t)&=6 i \\sin{\\left(t \\right)} + 12 j \\sin{\\left(t \\right)} - 8 k \\cos{\\left(t \\right)} \\\\ 3g^{\\prime}(t)&=6 j \\sin{\\left(t \\right)} + 3 k \\cos{\\left(t \\right)}\\end{aligned}\n$$\n\nAdd corresponding components and combine like terms:\n\n$$\n(2f(t)+3g(t))^{\\prime}=6 i \\sin{\\left(t \\right)} + 18 j \\sin{\\left(t \\right)} - 5 k \\cos{\\left(t \\right)}.\n$$\n\nKeep the displayed inner arguments when applying the scalar derivative rules; any nonunit inner derivative multiplies its component."}] [{:db/id #edb/ref 17592186723301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a987d9d-cad1-5f88-abdd-d2ae4e5fdc92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 12 t + 2,\\,0,\\,6 t + 2\\rangle" :db/id #edb/ref 17592186723283} {:answer/id #uuid "0d526bc4-ac3f-57ec-a87a-d05d60fe1095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 12 t - 2,\\,0,\\,6 t - 2\\rangle" :db/id #edb/ref 17592186723285} {:answer/id #uuid "aaaaba17-eb93-5a78-90c5-e634e0b2004c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 t^{2} - 2,\\,0,\\,3 t^{2} - 2\\rangle" :db/id #edb/ref 17592186723306} {:answer/id #uuid "cccde53b-2e05-5167-ad6c-7a8faccb8df4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 12 t - 2,\\,0,\\,-2\\rangle" :db/id #edb/ref 17592186723312} {:answer/id #uuid "f65cbc04-352d-5369-af38-29d6ed4935d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 12 t - 2,\\,0,\\,6 t\\rangle" :db/id #edb/ref 17592186723315}] :answer-field/correct {:answer/id #uuid "0d526bc4-ac3f-57ec-a87a-d05d60fe1095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 12 t - 2,\\,0,\\,6 t - 2\\rangle" :db/id #edb/ref 17592186723285} :answer-field/id #uuid "ef01c729-3575-546e-be9a-ef27625ce177" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723314}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d13edae-25ea-5a13-a57b-fe9d60d24688" :question/problem "Find $(-f(t)-g(t)+3h(t))^{\\prime}$, where $t\\in\\mathbb R$ and\n\n$$\n\\begin{aligned}f(t)&=\\langle -1,\\,0,\\,-1\\rangle \\\\ g(t)&=\\langle 2 t,\\,0,\\,2 t\\rangle \\\\ h(t)&=\\langle 2 t^{2},\\,0,\\,t^{2}\\rangle\\end{aligned}\n$$" :question/worked-solution "Apply the **sum and constant multiple rules**:\n\n$$\n(-f(t)-g(t)+3h(t))^{\\prime}=-f^{\\prime}(t)-g^{\\prime}(t)+3h^{\\prime}(t).\n$$\n\nDifferentiate each component:\n\n$$\n\\begin{aligned}f^{\\prime}(t)&=\\langle 0,\\,0,\\,0\\rangle \\\\ g^{\\prime}(t)&=\\langle 2,\\,0,\\,2\\rangle \\\\ h^{\\prime}(t)&=\\langle 4 t,\\,0,\\,2 t\\rangle\\end{aligned}\n$$\n\nScale every component by its constant multiplier:\n\n$$\n\\begin{aligned}-1f^{\\prime}(t)&=\\langle 0,\\,0,\\,0\\rangle \\\\ -1g^{\\prime}(t)&=\\langle -2,\\,0,\\,-2\\rangle \\\\ 3h^{\\prime}(t)&=\\langle 12 t,\\,0,\\,6 t\\rangle\\end{aligned}\n$$\n\nAdd corresponding components and combine like terms:\n\n$$\n(-f(t)-g(t)+3h(t))^{\\prime}=\\langle 12 t - 2,\\,0,\\,6 t - 2\\rangle.\n$$"}] [{:db/id #edb/ref 17592186723302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c456658-2280-54f4-af3d-fe6007e88c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle - 12 t - 6,\\,24,\\,12 t + 9\\rangle" :db/id #edb/ref 17592186723288} {:answer/id #uuid "32af575b-ca18-5dcb-804c-2e84a003385c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 12 t - 6,\\,18,\\,9 - 12 t\\rangle" :db/id #edb/ref 17592186723290} {:answer/id #uuid "ad702721-dfc2-5466-8a86-c5815b1ae403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 - 12 t,\\,-18,\\,12 t - 9\\rangle" :db/id #edb/ref 17592186723307} {:answer/id #uuid "ae7da84f-7a72-5420-bf29-439c8397f560" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle -6,\\,24,\\,12 t + 9\\rangle" :db/id #edb/ref 17592186723308} {:answer/id #uuid "f680515c-c564-5793-8fe0-30b2d484edaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle - 12 t,\\,3,\\,12 t\\rangle" :db/id #edb/ref 17592186723316}] :answer-field/correct {:answer/id #uuid "2c456658-2280-54f4-af3d-fe6007e88c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle - 12 t - 6,\\,24,\\,12 t + 9\\rangle" :db/id #edb/ref 17592186723288} :answer-field/id #uuid "472a9465-ec53-547b-9811-4cc94ce013ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723295}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "919c2324-0632-5c30-a96d-8ced046f7ce4" :question/problem "Find $(3f(t)-3g(t))^{\\prime}$, where $t\\in\\mathbb R$ and\n\n$$\n\\begin{aligned}f(t)&=\\langle 12 - 2 t,\\,7 t,\\,3 t - 1\\rangle \\\\ g(t)&=\\langle 2 t^{2} - 2,\\,- t,\\,- 2 t^{2}\\rangle\\end{aligned}\n$$" :question/worked-solution "Apply the **sum and constant multiple rules**:\n\n$$\n(3f(t)-3g(t))^{\\prime}=3f^{\\prime}(t)-3g^{\\prime}(t).\n$$\n\nDifferentiate each component:\n\n$$\n\\begin{aligned}f^{\\prime}(t)&=\\langle -2,\\,7,\\,3\\rangle \\\\ g^{\\prime}(t)&=\\langle 4 t,\\,-1,\\,- 4 t\\rangle\\end{aligned}\n$$\n\nScale every component by its constant multiplier:\n\n$$\n\\begin{aligned}3f^{\\prime}(t)&=\\langle -6,\\,21,\\,9\\rangle \\\\ -3g^{\\prime}(t)&=\\langle - 12 t,\\,3,\\,12 t\\rangle\\end{aligned}\n$$\n\nAdd corresponding components and combine like terms:\n\n$$\n(3f(t)-3g(t))^{\\prime}=\\langle - 12 t - 6,\\,24,\\,12 t + 9\\rangle.\n$$"}] [{:db/id #edb/ref 17592186723303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37e10f12-083c-5075-829a-9db125e1ddd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{t} - \\frac{2}{t^{2}} \\\\ 2 - \\frac{1}{2 \\sqrt{t}} \\\\ - 8 t^{3}\\end{bmatrix}" :db/id #edb/ref 17592186723292} {:answer/id #uuid "5cd6c45b-a570-5f5b-a4f2-e261d16f71af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{4}{t} - \\frac{2}{t^{2}} \\\\ \\frac{1}{\\sqrt{t}} \\\\ - 8 t^{3}\\end{bmatrix}" :db/id #edb/ref 17592186723296} {:answer/id #uuid "62d40435-750b-588d-93e2-8997c5d3f306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{4}{t} - \\frac{2}{t^{2}} \\\\ 2 + \\frac{1}{\\sqrt{t}} \\\\ - 8 t^{3}\\end{bmatrix}" :db/id #edb/ref 17592186723297} {:answer/id #uuid "a2f52776-4fc7-5ce1-ac63-c574c3d68d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{2}{t^{2}} \\\\ 2 \\\\ - 8 t^{3}\\end{bmatrix}" :db/id #edb/ref 17592186723304} {:answer/id #uuid "d53ee1ca-f2f4-5f26-955c-af6adef695b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{t} - \\frac{2}{t^{2}} \\\\ 2 - \\frac{1}{\\sqrt{t}} \\\\ - 8 t^{3}\\end{bmatrix}" :db/id #edb/ref 17592186723313}] :answer-field/correct {:answer/id #uuid "62d40435-750b-588d-93e2-8997c5d3f306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{4}{t} - \\frac{2}{t^{2}} \\\\ 2 + \\frac{1}{\\sqrt{t}} \\\\ - 8 t^{3}\\end{bmatrix}" :db/id #edb/ref 17592186723297} :answer-field/id #uuid "2900406f-26b5-53ac-8caf-c15568680bbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723287}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e40f0b5-5444-5da2-9108-2f086904e21f" :question/problem "Find $(-2f(t)-2g(t))^{\\prime}$, where $t>0$ and\n\n$$\n\\begin{aligned}f(t)&=\\begin{bmatrix}2 \\ln{\\left(t \\right)} \\\\ - \\sqrt{t} \\\\ 2\\end{bmatrix} \\\\ g(t)&=\\begin{bmatrix}- \\frac{1}{t} \\\\ - t \\\\ t^{4}\\end{bmatrix}\\end{aligned}\n$$" :question/worked-solution "Apply the **sum and constant multiple rules**:\n\n$$\n(-2f(t)-2g(t))^{\\prime}=-2f^{\\prime}(t)-2g^{\\prime}(t).\n$$\n\nDifferentiate each component:\n\n$$\n\\begin{aligned}f^{\\prime}(t)&=\\begin{bmatrix}\\frac{2}{t} \\\\ - \\frac{1}{2 \\sqrt{t}} \\\\ 0\\end{bmatrix} \\\\ g^{\\prime}(t)&=\\begin{bmatrix}\\frac{1}{t^{2}} \\\\ -1 \\\\ 4 t^{3}\\end{bmatrix}\\end{aligned}\n$$\n\nScale every component by its constant multiplier:\n\n$$\n\\begin{aligned}-2f^{\\prime}(t)&=\\begin{bmatrix}- \\frac{4}{t} \\\\ \\frac{1}{\\sqrt{t}} \\\\ 0\\end{bmatrix} \\\\ -2g^{\\prime}(t)&=\\begin{bmatrix}- \\frac{2}{t^{2}} \\\\ 2 \\\\ - 8 t^{3}\\end{bmatrix}\\end{aligned}\n$$\n\nAdd corresponding components and combine like terms:\n\n$$\n(-2f(t)-2g(t))^{\\prime}=\\begin{bmatrix}- \\frac{4}{t} - \\frac{2}{t^{2}} \\\\ 2 + \\frac{1}{\\sqrt{t}} \\\\ - 8 t^{3}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186723310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d9491f-8437-5c06-80e2-36fe3ceccd26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 \\sin{\\left(t \\right)} + 6 \\cos{\\left(t \\right)},\\,3,\\,6 t\\rangle" :db/id #edb/ref 17592186723282} {:answer/id #uuid "2169f147-359a-5605-87ab-f98c6f230552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 \\sin{\\left(t \\right)} + 6 \\cos{\\left(t \\right)},\\,-15,\\,6 t\\rangle" :db/id #edb/ref 17592186723286} {:answer/id #uuid "34e44aea-c59d-56d1-9b2d-e72b899946fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 \\cos{\\left(t \\right)},\\,3,\\,0\\rangle" :db/id #edb/ref 17592186723291} {:answer/id #uuid "3c8c9149-89a4-5cb0-b65c-39bd8325ab50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 \\sin{\\left(t \\right)} + 6 \\cos{\\left(t \\right)},\\,-15,\\,0\\rangle" :db/id #edb/ref 17592186723293} {:answer/id #uuid "cc923bd8-f46f-5173-901c-8282eddc32ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 \\sin{\\left(t \\right)} + 6 \\cos{\\left(t \\right)},\\,-15,\\,- 6 t\\rangle" :db/id #edb/ref 17592186723311}] :answer-field/correct {:answer/id #uuid "2169f147-359a-5605-87ab-f98c6f230552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 6 \\sin{\\left(t \\right)} + 6 \\cos{\\left(t \\right)},\\,-15,\\,6 t\\rangle" :db/id #edb/ref 17592186723286} :answer-field/id #uuid "a6b3e543-5e7e-50dc-9333-480557f7f02d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723305}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "be340d25-8f49-5174-a132-d0fadf2e9571" :question/problem "Find $(-3g(t)+3h(t))^{\\prime}$, where $t\\in\\mathbb R$ and\n\n$$\n\\begin{aligned}g(t)&=\\langle 2 \\cos{\\left(t \\right)},\\,6 t - 6,\\,- t^{2}\\rangle \\\\ h(t)&=\\langle 2 \\sin{\\left(t \\right)},\\,t,\\,4\\rangle\\end{aligned}\n$$" :question/worked-solution "Apply the **sum and constant multiple rules**:\n\n$$\n(-3g(t)+3h(t))^{\\prime}=-3g^{\\prime}(t)+3h^{\\prime}(t).\n$$\n\nDifferentiate each component:\n\n$$\n\\begin{aligned}g^{\\prime}(t)&=\\langle - 2 \\sin{\\left(t \\right)},\\,6,\\,- 2 t\\rangle \\\\ h^{\\prime}(t)&=\\langle 2 \\cos{\\left(t \\right)},\\,1,\\,0\\rangle\\end{aligned}\n$$\n\nScale every component by its constant multiplier:\n\n$$\n\\begin{aligned}-3g^{\\prime}(t)&=\\langle 6 \\sin{\\left(t \\right)},\\,-18,\\,6 t\\rangle \\\\ 3h^{\\prime}(t)&=\\langle 6 \\cos{\\left(t \\right)},\\,3,\\,0\\rangle\\end{aligned}\n$$\n\nAdd corresponding components and combine like terms:\n\n$$\n(-3g(t)+3h(t))^{\\prime}=\\langle 6 \\sin{\\left(t \\right)} + 6 \\cos{\\left(t \\right)},\\,-15,\\,6 t\\rangle.\n$$\n\nKeep the displayed inner arguments when applying the scalar derivative rules; any nonunit inner derivative multiplies its component."}] [{:db/id #edb/ref 17592186723346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58f7e997-bfe0-5468-8c21-37223068d017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 t + 8 \\\\ -2 \\\\ 5 t^{3} + 12 t^{2}\\end{bmatrix}" :db/id #edb/ref 17592186723350} {:answer/id #uuid "5bbb6270-2a1b-5b99-ab60-31af644b000d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 t + 4 \\\\ 4 \\\\ 5 t^{3} + 6 t^{2}\\end{bmatrix}" :db/id #edb/ref 17592186723352} {:answer/id #uuid "a2ebc2b6-83c3-5bd7-8bf7-0a771850bd58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 t + 4 \\\\ 2 \\\\ 4 t^{3} + 6 t^{2}\\end{bmatrix}" :db/id #edb/ref 17592186723360} {:answer/id #uuid "f65725e9-7e9a-5990-8f60-d798f40cc476" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 t + 8 \\\\ 0 \\\\ 6 t^{3} + 12 t^{2}\\end{bmatrix}" :db/id #edb/ref 17592186723370} {:answer/id #uuid "fa9bf16e-d205-502c-b9ec-1119029e88c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 t - 4 \\\\ 4 \\\\ - t^{3} - 6 t^{2}\\end{bmatrix}" :db/id #edb/ref 17592186723371}] :answer-field/correct {:answer/id #uuid "a2ebc2b6-83c3-5bd7-8bf7-0a771850bd58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 t + 4 \\\\ 2 \\\\ 4 t^{3} + 6 t^{2}\\end{bmatrix}" :db/id #edb/ref 17592186723360} :answer-field/id #uuid "5b3c7877-fd59-5051-a8b5-71cc07d0eaec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186723351}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3dbef7c9-71bc-560f-b39d-151c810cb463" :question/problem "Find $\\big(u(t)\\mathbf f(t)\\big)^{\\prime}$, where\n\n$$\nu(t)=t + 2,\\qquad \\mathbf f(t)=\\begin{bmatrix}2 t \\\\ 2 \\\\ t^{3}\\end{bmatrix}.\n$$" :question/worked-solution "Use the scalar function multiple rule:\n\n$$\n\\big(u(t)\\mathbf f(t)\\big)^{\\prime}=u^{\\prime}(t)\\mathbf f(t)+u(t)\\mathbf f^{\\prime}(t).\n$$\n\nDifferentiate the scalar and each vector component.\n\n$$\nu^{\\prime}(t)=1.\n$$\n\n\n\n$$\n\\mathbf f^{\\prime}(t)=\\begin{bmatrix}2 \\\\ 0 \\\\ 3 t^{2}\\end{bmatrix}.\n$$\n\nSubstitute both contributions and add corresponding components:\n\n$$\n\\begin{aligned}\\big(u(t)\\mathbf f(t)\\big)^{\\prime}&=\\big(1\\big)\\begin{bmatrix}2 t \\\\ 2 \\\\ t^{3}\\end{bmatrix}\\\\&\\quad+\\big(t + 2\\big)\\begin{bmatrix}2 \\\\ 0 \\\\ 3 t^{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nWrite $\\mathbf h(t)=u(t)\\mathbf f(t)$. For each component, the two terms are:\n\n$$\n\\begin{aligned}h_{1}^{\\prime}(t)&=\\big(2 t\\big)\\\\&\\quad+\\big(2 t + 4\\big)\\\\&=4 t + 4\\\\h_{2}^{\\prime}(t)&=\\big(2\\big)\\\\&\\quad+\\big(0\\big)\\\\&=2\\\\h_{3}^{\\prime}(t)&=\\big(t^{3}\\big)\\\\&\\quad+\\big(3 t^{2} \\left(t + 2\\right)\\big)\\\\&=4 t^{3} + 6 t^{2}.\\end{aligned}\n$$\n\n Therefore,\n\n$$\n\\big(u(t)\\mathbf f(t)\\big)^{\\prime}=\\begin{bmatrix}4 t + 4 \\\\ 2 \\\\ 4 t^{3} + 6 t^{2}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186723347 :