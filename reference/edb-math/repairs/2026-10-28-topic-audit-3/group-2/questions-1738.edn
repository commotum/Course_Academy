ext{d}u}\\left(2 e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- 2 u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}2 \\cos{\\left(u \\right)} \\\\ 2 e^{u} \\\\ - 4 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(- 2 t^{2} + t + 2\\right)=1 - 4 t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}2 \\cos{\\left(u(t) \\right)} \\\\ 2 e^{u(t)} \\\\ - 4 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}2 \\cos{\\left(- 2 t^{2} + t + 2 \\right)} \\\\ 2 e^{- 2 t^{2} + t + 2} \\\\ 8 t^{2} - 4 t - 8\\end{bmatrix}\\cdot \\left(1 - 4 t\\right) \\\\  & =\\begin{bmatrix}\\left(2 - 8 t\\right) \\cos{\\left(- 2 t^{2} + t + 2 \\right)} \\\\ \\left(2 - 8 t\\right) e^{- 2 t^{2} + t + 2} \\\\ 4 \\left(4 t - 1\\right) \\left(- 2 t^{2} + t + 2\\right)\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129d4e56-a176-5a8e-888b-6f4c0aeb3e14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos{\\left(u \\right)} \\\\ - 2 e^{u} \\\\ - 2 u\\end{bmatrix}" :db/id #edb/ref 17592186552687} {:answer/id #uuid "169349e3-0f9b-5795-a7f0-f78523955e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(6 t^{2} + 3\\right) \\cos{\\left(2 t^{3} + 3 t - 2 \\right)} \\\\ - 2 e^{- 2 t^{3} - 3 t + 2} \\\\ 4 t^{3} + 6 t - 4\\end{bmatrix}" :db/id #edb/ref 17592186552689} {:answer/id #uuid "ad1ba4b0-8977-5878-aeae-c6be46c9f2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(6 t^{2} + 3\\right) \\cos{\\left(2 t^{3} + 3 t - 2 \\right)} \\\\ \\left(12 t^{2} + 6\\right) e^{- 2 t^{3} - 3 t + 2} \\\\ - 24 t^{5} - 48 t^{3} + 24 t^{2} - 18 t + 12\\end{bmatrix}" :db/id #edb/ref 17592186552723} {:answer/id #uuid "f1979c53-491b-5e44-a5da-ebc8d0238150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\left(- 6 t^{2} - 3\\right)^{2} \\cos{\\left(2 t^{3} + 3 t - 2 \\right)} \\\\ - 2 \\left(- 6 t^{2} - 3\\right)^{2} e^{- 2 t^{3} - 3 t + 2} \\\\ 144 t^{7} + 360 t^{5} - 144 t^{4} + 252 t^{3} - 144 t^{2} + 54 t - 36\\end{bmatrix}" :db/id #edb/ref 17592186552744} {:answer/id #uuid "ff1c3d62-ab99-56af-a06d-69cc22bc8374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\cos{\\left(2 t^{3} + 3 t - 2 \\right)} \\\\ - 2 e^{- 2 t^{3} - 3 t + 2} \\\\ 4 t^{3} + 6 t - 4\\end{bmatrix}" :db/id #edb/ref 17592186552749}] :answer-field/correct {:answer/id #uuid "ad1ba4b0-8977-5878-aeae-c6be46c9f2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(6 t^{2} + 3\\right) \\cos{\\left(2 t^{3} + 3 t - 2 \\right)} \\\\ \\left(12 t^{2} + 6\\right) e^{- 2 t^{3} - 3 t + 2} \\\\ - 24 t^{5} - 48 t^{3} + 24 t^{2} - 18 t + 12\\end{bmatrix}" :db/id #edb/ref 17592186552723} :answer-field/id #uuid "91a8313c-d9bf-52b1-81e0-c6d72fd94b80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552718}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9806ea1e-4f8d-50b0-adf7-1348650b793b" :question/problem "If $f(u)=\\begin{bmatrix}- \\sin{\\left(u \\right)} \\\\ - 2 e^{u} \\\\ - u^{2}\\end{bmatrix}$ and $u(t)=- 2 t^{3} - 3 t + 2$, then $(f∘u)^{′}(t)=$ Write the polynomial component in expanded form." :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}f^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\left(- \\sin{\\left(u \\right)}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- 2 e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}- \\cos{\\left(u \\right)} \\\\ - 2 e^{u} \\\\ - 2 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(- 2 t^{3} - 3 t + 2\\right)=- 6 t^{2} - 3\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}- \\cos{\\left(u(t) \\right)} \\\\ - 2 e^{u(t)} \\\\ - 2 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}- \\cos{\\left(2 t^{3} + 3 t - 2 \\right)} \\\\ - 2 e^{- 2 t^{3} - 3 t + 2} \\\\ 4 t^{3} + 6 t - 4\\end{bmatrix}\\cdot \\left(- 6 t^{2} - 3\\right) \\\\  & =\\begin{bmatrix}\\left(6 t^{2} + 3\\right) \\cos{\\left(2 t^{3} + 3 t - 2 \\right)} \\\\ \\left(12 t^{2} + 6\\right) e^{- 2 t^{3} - 3 t + 2} \\\\ - 24 t^{5} - 48 t^{3} + 24 t^{2} - 18 t + 12\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "269685a9-7498-5d2f-af47-f4e001ad5345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ e^{- 2 t^{2} - 2 t + 1} \\\\ 8 t^{2} + 8 t - 4\\end{bmatrix}" :db/id #edb/ref 17592186552690} {:answer/id #uuid "5989b541-2424-535e-be0f-7649ab6dfcae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(- 4 t - 2\\right) \\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ e^{- 2 t^{2} - 2 t + 1} \\\\ 8 t^{2} + 8 t - 4\\end{bmatrix}" :db/id #edb/ref 17592186552703} {:answer/id #uuid "59a4aba6-d2b2-5a2e-8ab6-bacd58b786ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ e^{u} \\\\ - 4 u\\end{bmatrix}" :db/id #edb/ref 17592186552704} {:answer/id #uuid "863cc186-e569-59ce-b2c7-2137d64ff8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(- 4 t -