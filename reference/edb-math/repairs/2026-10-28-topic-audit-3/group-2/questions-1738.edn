{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}\\cos{\\left(u(t) \\right)} \\\\ - 2 e^{u(t)} \\\\ - 6 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}\\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ - 2 e^{2 t^{3} - 3 t - 1} \\\\ - 12 t^{3} + 18 t + 6\\end{bmatrix}\\cdot \\left(6 t^{2} - 3\\right) \\\\  & =\\begin{bmatrix}\\left(6 t^{2} - 3\\right) \\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ \\left(6 - 12 t^{2}\\right) e^{2 t^{3} - 3 t - 1} \\\\ - 72 t^{5} + 144 t^{3} + 36 t^{2} - 54 t - 18\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0d7356-3f98-5128-8aec-d10d76eaf0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 t + 4\\right) \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ 2 \\left(t + 1\\right) e^{- t^{2} - 2 t - 2} \\\\ - 8 \\left(t + 1\\right) \\left(t^{2} + 2 t + 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552694} {:answer/id #uuid "61b72935-9347-5802-8cb0-e458460e44a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- 2 \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ - e^{- t^{2} - 2 t - 2} \\\\ 4 t^{2} + 8 t + 8\\end{bmatrix}" :db/id #edb/ref 17592186552707} {:answer/id #uuid "7d0b5060-590f-53e4-8868-83ce89b64d4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- 2 \\cos{\\left(u \\right)} \\\\ - e^{u} \\\\ - 4 u\\end{bmatrix}" :db/id #edb/ref 17592186552712} {:answer/id #uuid "ca216969-31a6-5ab4-a3ab-52fad4ab3dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- 2 \\left(- 2 t - 2\\right)^{2} \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ - \\left(- 2 t - 2\\right)^{2} e^{- t^{2} - 2 t - 2} \\\\ \\left(- 2 t - 2\\right)^{2} \\left(4 t^{2} + 8 t + 8\\right)\\end{bmatrix}" :db/id #edb/ref 175