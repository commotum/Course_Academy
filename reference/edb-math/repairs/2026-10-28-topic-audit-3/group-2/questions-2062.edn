pe {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252723}] :answer-field/correct {:answer/id #uuid "d5f0adbe-2e89-5266-86ad-6f1c9bc6aa57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186252448} :answer-field/id #uuid "99b98dc1-ba24-523d-91c1-39b60d314bc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253073}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7867732e-c747-51f4-a678-9910706e6d84" :question/math-academy-id "q-117574" :question/problem "What is the amplitude of the function $f(x)=-7\\operatorname{cos}⁡(3x+1)?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}⁡(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=-7,$ we have that the amplitude is $|A|=|-7|=7.$"}] [{:db/id #edb/ref 17592186253368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aadff32-d8e0-5eea-8f1f-2f63a134c39f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186250649} {:answer/id #uuid "3acd747a-676c-53ac-a0b1-66a6584544d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186251041} {:answer/id #uuid "535dc4a7-779d-5aa4-84ff-894b2006269b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186251232} {:answer/id #uuid "dfcaf382-661a-5eed-a5ae-ca4d55214483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186252528} {:answer/id #uuid "e0d7f858-fa72-532e-b037-12bd5a63a44f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186252533}] :answer-field/correct {:answer/id #uuid "535dc4a7-779d-5aa4-84ff-894b2006269b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186251232} :answer-field/id #uuid "367782f4-ca15-5206-b0f9-015103d3f79a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252895}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86dec134-c288-5f12-9971-6b0570d7076d" :question/math-academy-id "q-117576" :question/problem "What is the amplitude of the function $f(x)=\\frac{3-9\\operatorname{sin}⁡x}{5}?$" :question/worked-solution "First, notice that we can rewrite the function as follows:\n\n$$\nf(x)=\\frac{3-9\\operatorname{sin}⁡x}{5}=-\\frac{9}{5}\\cdot \\operatorname{sin}⁡x+\\frac{3}{5}\n$$\n\nNow, given a function in the form $f(x)=A\\operatorname{sin}⁡(Bx+C)+D,$ the amplitude is $|A|.$\n\nIn our case, we have that $A=-\\frac{9}{5}.$ Therefore, the amplitude is $|A|=|-\\frac{9}{5}|=\\frac{9}{5}.$"}] [{:db/id #edb/ref 17592186253369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4161544d-5503-509c-a919-47b75546d693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186251094} {:answer/id #uuid "ab0b8f2d-8bf9-5548-96dd-fe899f5d298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186252036} {:answer/id #uuid "ba23df8f-a679-5d5c-bde8-2b7238d24224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186252191} {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} {:answer/id #uuid "f25fe0b5-3a2d-5c1e-b5a3-425fbf7a30c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186252674}] :answer-field/correct {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} :answer-field/id #uuid "918ffa31-2155-56a2-9928-59d9d880148e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253057}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "53685d44-d788-5019-bc63-97c441bd2453" :question/math-academy-id "q-117578" :question/problem "What is the period of the function $$\n\\displaystyle f(x)=-3\\operatorname{sin}⁡(\\frac{3x}{4}+\\frac{\\pi }{3})?\n$$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{3}{4}.$ Therefore, the period is $$\n\\displaystyle \\frac{2\\pi }{\\left(\\frac{3}{4}\\right)}=\\frac{8\\pi }{3}.\n$$"}] [{:db/id #edb/ref 17592186253370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71fbeca3-4760-5d6a-856c-a573ea317eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{300}^{∘}" :db/id #edb/ref 17592186251486} {:answer/id #uuid "9229fa93-9ffb-5473-9b2e-ff4e454a6679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{270}^{∘}" :db/id #edb/ref 17592186251803} {:answer/id #uuid "ca888844-ac33-5b63-a641-8bce7947f0cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{480}^{∘}" :db/id #edb/ref 17592186252347} {:answer/id #uuid "f2fdabb1-db44-594d-8452-62e77cc9289f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186252685} {:answer/id #uuid "fc9b6765-ab75-54b3-a097-f8617bfd508d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186252768}] :answer-field/correct {:answer/id #uuid "9229fa93-9ffb-5473-9b2e-ff4e454a6679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{270}^{∘}" :db/id #edb/ref 17592186251803} :answer-field/id #uuid "bf475618-9da6-5ade-89c7-309940393d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253135}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e0d5cec2-04d5-542c-903e-28cdf3f5b313" :question/math-academy-id "q-117579" :question/problem "What is the period of the function $f(x)=-4\\operatorname{sin}⁡(\\frac{4x}{3}-{45}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{{360}^{∘}}{B}.$\n\nIn our case, we have that $B=\\frac{4}{3}.$ Therefore, the period is $$\n\\displaystyle \\frac{{360}^{∘}}{\\left(\\frac{4}{3}\\right)}={270}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186290474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd40bfd-062b-544e-82e4-2ec772085df7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10" :db/id #edb/ref 17592186288466} {:answer/id #uuid "8e5e3c1c-7364-5f79-b142-fdd7f16b88c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186288985} {:answer/id #uuid "8ea149b8-4046-5f9a-86fb-993d32d1547b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288986} {:answer/id #uuid "b95d738d-433a-5a37-9962-7b7f42af9eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186289257} {:answer/id #uuid "c589d6c6-0ea0-572a-8640-cb03b9f272b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289341}] :answer-field/correct {:answer/id #uuid "8ea149b8-4046-5f9a-86fb-993d32d1547b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288986} :answer-field/id #uuid "93e769bf-84dc-5265-92dd-ad238215d9bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290060}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b9b62cc-429e-52b2-9f37-7f9e4fb21a23" :question/math-academy-id "q-236890" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $2$ and a maximum value of $10.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{2+10}{2} \\\\  & =\\frac{12}{2} \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the midline is $y=6.$"}] [{:db/id #edb/ref 17592186290475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b0d2e17-b1cc-53d6-a590-29ca48abe4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186288441} {:answer/id #uuid "4a00572c-39f3-51f2-908d-92627f661500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186288544} {:answer/id #uuid "a37b2fb0-553a-530f-99ca-b90f84cdee3f" :answer/type {:db/id #edb/ref 175921860454