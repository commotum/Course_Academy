db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186717650} {:answer/id #uuid "6f01d451-efbe-5f04-aaa3-54e567d55d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-12" :db/id #edb/ref 17592186717668} {:answer/id #uuid "7dcb7108-b19c-5e4a-b4bb-720facda4a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186717670} {:answer/id #uuid "938cb6de-bbe8-5a4a-b06d-d786624cf895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186717676} {:answer/id #uuid "a9c647b4-c6ca-5c7c-9a07-d2bcb5e2de44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-14" :db/id #edb/ref 17592186717678}] :answer-field/correct {:answer/id #uuid "938cb6de-bbe8-5a4a-b06d-d786624cf895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186717676} :answer-field/id #uuid "1d98c477-1891-556a-b951-5c4b606f5ca3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717657}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24c009ef-18db-54ff-9e3d-bb3e393cdf73" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-12$ and a maximum value of $-2$." :question/worked-solution "The midline is the horizontal line halfway between the minimum and maximum values. Average their heights:\n\n$$\n\\begin{aligned}\ny &= \\frac{y_{\\text{min}}+y_{\\text{max}}}{2} \\\\\n&= \\frac{-12+(-2)}{2} \\\\\n&= -7.\n\\end{aligned}\n$$\n\nTherefore, the midline is $y=-7$. The half-range $5$ is the amplitude, rather than the vertical shift."}] [{:db/id #edb/ref 17592186717665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1751452a-3cda-5088-a504-d3061daccb21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186717654} {:answer/id #uuid "5a96bb4f-8b70-52a0-8b0f-d4acad096465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186717664} {:answer/id #uuid "65ef4289-021b-5249-ba42-aa8ce8e98bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186717667} {:answer/id #uuid "889d0ad1-9d8b-5d05-a298-ca6183bbc00c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186717672} {:answer/id #uuid "ba3b9f63-5397-5f93-b443-4dfae0ddfe17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186717681}] :answer-field/correct {:answer/id #uuid "ba3b9f63-5397-5f93-b443-4dfae0ddfe17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186717681} :answer-field/id #uuid "8ded706a-2fa8-5efa-8f67-f9471a8c2f63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717673}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e9fe17a-6a2b-5d1c-be79-7b89bb809d8f" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-4$ and a maximum value of $4$." :question/worked-solution "The midline is the horizontal line halfway between the minimum and maximum values. Average their heights:\n\n$$\n\\begin{aligned}\ny &= \\frac{y_{\\text{min}}+y_{\\text{max}}}{2} \\\\\n&= \\frac{-4+4}{2} \\\\\n&= 0.\n\\end{aligned}\n$$\n\nTherefore, the midline is $y=0$. The half-range $4$ is the amplitude, rather than the vertical shift."}] [{:db/id #edb/ref 17592186717669 :question/answer-fields [{:answer-field/choices [{:answe