edb/ref 17592186045485} :question/id #uuid "e75d8d10-c324-5254-9274-399accd8d76f" :question/problem "What is the amplitude of the function $f(x)=\\frac{9}{2}\\cos(5x+2)?$" :question/worked-solution "Given a function in the form $f(x)=A\\cos(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=\\frac{9}{2},$ we have that the amplitude is $|A|=|\\frac{9}{2}|=\\frac{9}{2}.$"}] [{:db/id #edb/ref 17592186583011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351086c4-bb04-562b-a413-033516ee4658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-3,1]" :db/id #edb/ref 17592186582583} {:answer/id #uuid "6dc6b190-61b1-5a97-b10e-036abbfd9a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-3,-1]" :db/id #edb/ref 17592186582664} {:answer/id #uuid "7aaf9302-2009-5a01-bd55-51efbdf8e29c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186582691} {:answer/id #uuid "b18536a8-96ff-592f-8a99-db702968b037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-5,-3]" :db/id #edb/ref 17592186582789} {:answer/id #uuid "ef64d684-f2a8-5f63-ba9b-f2e7ade17eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [0,2\\pi ]" :db/id #edb/ref 17592186582870}] :answer-field/correct {:answer/id #uuid "6dc6b190-61b1-5a97-b10e-036abbfd9a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-3,-1]" :db/id #edb/ref 17592186582664} :answer-field/id #uuid "3b8ea5ab-a758-56ff-bb02-3587cbb57856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19f1e925-f390-5948-9059-b77a2d240579" :question/math-academy-id "q-25513" :question/problem "What is the range of the function $f(x)=-\\operatorname{sin}⁡(4x+\\pi )-2?$" :question/worked-solution "The range of $\\operatorname{sin}⁡x$ is\n\n$$\n-1\\le \\operatorname{sin}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}⁡(4x+\\pi )\\le 1.\n$$\n\nMultiplying the above inequality by $-1$ and then subtracting $2$, we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}⁡(4x+\\pi )\\le 1 \\\\  & 1\\ge -\\operatorname{sin}⁡(4x+\\pi )\\ge -1 \\\\  & -1\\ge \\operatorname{sin}⁡(4x+\\pi )-2\\ge -3 \\\\  & -3\\le f(x)\\le -1.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-3,-1].$"}] [{:db/id #edb/ref 17592186583037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1559412f-7bcc-50ba-a4da-6f4ea6226c89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186582521} {:answer/id #uuid "5b0c4821-17d6-5ba6-ae1e-405a4f6c1af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186582632} {:answer/id #uuid "8f90ce90-7b8d-5e1b-9766-6ec916c1a6d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186582729} {:answer/id #uuid "a61a94e1-2676-55c6-9cd4-f96f6ac2b82f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186582769} {:answer/id #uuid "df5e9a98-8fe9-5628-8ef2-7a5c642968a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186582851}] :answer-field/correct {:answer/id #uuid "5b0c4821-17d6-5ba6-ae1e-405a4f6c1af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186582632} :answer-field/id #uuid "d7593a40-c1fa-5a81-9c20-56af70f46fb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582978}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a43e6b6-5512-53d1-b032-03f28416a804" :question/math-academy-id "q-81512" :question/problem "What is the amplitude of the function $f(x)=-2\\pi \\operatorname{cos}⁡(\\frac{\\pi }{2}x-1)?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}⁡(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=-2\\pi ,$ we have that the amplitude is $|A|=|-2\\pi |=2\\pi .$"}] [{:db/id #edb/ref 17592186583038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a97797-7c34-52ad-a1bd-42b6f83f120a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-2,3]" :db/id #edb/ref 17592186582588} {:answer/id #uuid "736762e4-f385-525b-ad9c-82aced5fe3c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-5,-1]" :db/id #edb/ref 17592186582671} {:answer/id #uuid "81e04db4-971d-5277-a9db-5100aa9c2608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-4,0]" :db/id #edb/ref 17592186582706} {:answer/id #uuid "a503d255-d18d-5d86-a0b4-5ac34fefe661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-3,3]" :db/id #edb/ref 17592186582767} {:answer/id #uuid "d452ad35-e348-533f-9e69-8595d29bf5ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-2,-2]" :db/id #edb/ref 17592186582836}] :answer-field/correct {:answer/id #uuid "736762e4-f385-525b-ad9c-82aced5fe3c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-5,-1]" :db/id #edb/ref 17592186582671} :answer-field/id #uuid "43edbf96-e824-5aa2-9ff6-937e32bfadfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582924}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5fb346bf-942f-57e9-8a3b-0526b872b592" :question/math-academy-id "q-40967" :question/problem "Find the range of the function $f(x)=2\\operatorname{cos}⁡(x-\\frac{\\pi }{4})-3.$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(x-\\frac{\\pi }{4})\\le 1.\n$$\n\nMultiplying the above inequality by $2$ and then subtracting $3,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{cos}⁡(x-\\frac{\\pi }{4})\\le 1 \\\\  & -2\\le 2\\operatorname{cos}⁡(x-\\frac{\\pi }{4})\\le 2 \\\\  & -5\\le 2\\operatorname{cos}⁡(x-\\frac{\\pi }{4})-3\\le -1 \\\\  & -5\\le f(x)\\le -1.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-5,-1].$"}] [{:db/id #edb/ref 17592186583051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1481f901-53b8-5be5-9330-0c74291478ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-6,6]" :db/id #edb/ref 17592186582520} {:answer/id #uuid "250a5eed-ec37-5731-8491-ac40d080c747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in (-6,6)" :db/id #edb/ref 17592186582549} {:answer/id #uuid "265f0a11-b693-5abe-b60f-964ae907c941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-1,1]" :db/id #edb/ref 17592186582552} {:answer/id #uuid "fd205b80-9aa7-5e8f-9d95-e176526ba47d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [0,6]" :db/id #edb/ref 17592186582891} {:answer/id #uuid "ff015b2b-9db3-5b52-aa67-64ecfc975586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186582896}] :answer-field/correct {:answer/id #uuid "1481f901-53b8-5be5-9330-0c74291478ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-6,6]" :db/id #edb/ref 17592186582520} :answer-field/id #uuid "73e9ec2d-cb1f-59a1-804e-9baa059ab6e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582939}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "78fb970b-1904-59d8-bdde-90d8ecfc1cd7" :question/math-academy-id "q-24916" :question/problem "Find the range of the function $y=6\\operatorname{cos}⁡(2x).$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(2x)\\le 1.\n$$\n\nMultiplying the above inequality by $6,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{cos}⁡(2x)\\le 1 \\\\  & -6\\le 6\\operatorname{cos}⁡(2x)\\le 6 \\\\  & -6\\le y\\le 6.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [-6,6].$"}] [{:db/id #edb/ref 17592186583083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0301eaec-24af-5027-9582-6f2cbcf1172c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{630}^{∘}" :db/id #edb/ref 17592186582492} {:answer/id #uuid "3eae09e3-3ea3-5e52-a2ba-5f0ecb9e1621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{455}^{∘}" :db/id #edb/ref 17592186582596} {:answer/id #uuid "a4f4a5e0-579c-532c-b7ea-904596aa2bc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{760}^{∘}" :db/id #edb/ref 17592186582766} {:answer/id #uuid "dda32b6a-cb78-5ac2-ba6b-5e813b64d920" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{520}^{∘}" :db/id #edb/ref 17592186582848} {:answer/id #uuid "eef74b46-9a9e-50b1-93bb-420c5e58084a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{395}^{∘}" :db/id #edb/ref 17592186582869}] :answer-field/correct {:answer/id #uuid "0301eaec-24af-5027-9582-6f2cbcf1172c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{630}^{∘}" :db/id #edb/ref 17592186582492} :answer-field/id #uuid "fc1b91a1-7f23-5fff-a2e5-61a26128d7fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582996}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2e89257-c187-56d5-921c-62533d1cff56" :question/math-academy-id "q-43412" :question/problem "What is the period of the function $f(x)=\\operatorname{cos}⁡(\\frac{4x}{7}-{32}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}⁡(Bx+C)+D,$ the period is $\\frac{{360}^{∘}}{B}.$\n\nIn our case, we have that $B=\\frac{4}{7}.$ Therefore, the period is $$\n\\displaystyle \\frac{{360}^{∘}}{\\left(\\frac{4}{7}\\right)}={630}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186583087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0293355c-d52c-5ec0-a4ac-09ba3fc83b47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186582490} {:answer/id #uuid "2019a5ad-cc8b-5a93-b1ee-9e3149550695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186582536} {:answer/id #uuid "8c822c6a-cef4-50b4-ad4d-8372afc2cb08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186582726} {:answer/id #uuid "da6dfb57-7d43-51dc-93e9-05be3e19bfb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186582844} {:answer/id #uuid "ffb00e6f-0d7e-56fc-baed-6524b8f5c4dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186582897}] :answer-field/correct {:answer/id #uuid "8c822c6a-cef4-50b4-ad4d-8372afc2cb08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186582726} :answer-field/id #uuid "0aeefd47-824e-5df3-a89c-1137ddbb51bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582902}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd575496-3e51-5d55-95e8-6967d72b5129" :question/math-academy-id "q-43403" :question/problem "What is the period of the function $f(x)=4\\operatorname{sin}⁡(3x+\\frac{\\pi }{3})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=3.$ Therefore, the period is $\\frac{2\\pi }{3}.$"}] [{:db/id #edb/ref 17592186583091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a11eaa-969c-549e-a7a5-f3a535a1d7d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186582488} {:answer/id #uuid "51140db1-f736-5fb8-b448-b6095ecf8cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186582615} {:answer/id #uuid "b19620ec-62af-5c23-8a2e-ccbba0ea23a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186582790} {:answer/id #uuid "d709e80e-e931-5640-b26f-02b8adee279c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-8" :db/id #edb/ref 17592186582839} {:answer/id #uuid "f18336df-5bc1-550d-8621-3b36c17ad632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-6" :db/id #edb/ref 17592186582875}] :answer-field/correct {:answer/id #uuid "b19620ec-62af-5c23-8a2e-ccbba0ea23a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186582790} :answer-field/id #uuid "581a1038-da63-57c0-b688-c4e74b10844e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186582932}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eec7b431-8df5-58f2-91c8-fa24c9e968a7" :question/math-academy-id "q-236902" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-13$ and a maximum value of $-1.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-13+(-1)}{2} \\\\  & =\\frac{-14}{2} \\\\  & =-7.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-7.$"}] [{:db/id #edb/ref 17592186617805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac04354-5d4c-59de-9f11-e051e50b5f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186617266} {:answer/id #uuid "3187a959-0fa3-545e-a0e4-efa3eb279bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{35}^{∘}" :db/id #edb/ref 17592186617341} {:answer/id #uuid "55bd4a01-d454-5dc3-9e46-373688058a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{50}^{∘}" :db/id #edb/ref 17592186617405} {:answer/id #uuid "7b67f57e-5165-5f14-8d53-9b1a3fef2c14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{65}^{∘}" :db/id #edb/ref 17592186617451} {:answer/id #uuid "b27f2bb5-3d3f-551d-9b24-fb2a140cab7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186617539}] :answer-field/correct {:answer/id #uuid "b27f2bb5-3d3f-551d-9b24-fb2a140cab7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186617539} :answer-field/id #uuid "10a79cbc-5cb2-5889-a748-a459e78bc5e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186617672}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4851a756-0bff-5da4-b5af-2f3ab439405d" :question/math-academy-id "q-117577" :question/problem "What is the period of the function $f(x)=3\\operatorname{cos}⁡(8x+{30}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}⁡(Bx+C)+D,$ the period is $\\frac{{360}^{∘}}{B}.$\n\nIn our case, we have that $B=8.$ Therefore, the period is $\\frac{{360}^{∘}}{8}={45}^{∘}.$"}] [{:db/id #edb/ref 17592186717139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b68ee3b-ad6f-5333-ac05-6db45c10b7f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717142} {:answer/id #uuid "a2610233-7a97-52a9-a653-b24c2cd1e06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186717148} {:answer/id #uuid "ad769c1d-ad66-557f-baaa-bf1a95566f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186717149} {:answer/id #uuid "cf50d42c-2c2d-567f-85fc-76f04cca52e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186717151} {:answer/id #uuid "fc4d6bdc-9c4e-5202-9d3b-42d45b9a8199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186717154}] :answer-field/correct {:answer/id #uuid "ad769c1d-ad66-557f-baaa-bf1a95566f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186717149} :answer-field/id #uuid "57778a3f-793a-5c78-a8f5-60eee3a7127c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717140}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "46c26bf3-72e5-552a-8de6-0e1c5a58b28b" :question/problem "What is the amplitude of the function $f(x)=\\frac{2-3\\sin x}{4}$?" :question/worked-solution "First, rewrite the function to identify the coefficient of sine:\n\n$$\nf(x)=\\frac{2-3\\sin x}{4}=-\\frac{3}{4}\\sin x+\\frac{1}{2}.\n$$\n\nGiven a function in the form $f(x)=A\\sin(Bx+C)+D$, the amplitude is $|A|$.\n\nHere, $A=-\\frac{3}{4}$, so the amplitude is $\\left|-\\frac{3}{4}\\right|=\\frac{3}{4}$. The vertical shift $\\frac{1}{2}$ does not change the amplitude."}] [{:db/id #edb/ref 17592186717147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d91e4d-4f66-5884-952a-f7a0036e1bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186717134} {:answer/id #uuid "0fb8620c-1f93-53ef-a0a2-09796d25d684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186717135} {:answer/id #uuid "2829d5ee-31ac-5719-b3f6-535c36b303dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186717137} {:answer/id #uuid "63f8de7b-4af6-5eb5-953f-3613ca3f4841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717141} {:answer/id #uuid "86806ab7-1157-5d38-9d42-915a4dbe723a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186717144}] :answer-field/correct {:answer/id #uuid "2829d5ee-31ac-5719-b3f6-535c36b303dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186717137} :answer-field/id #uuid "f1c005ab-daed-566a-9c34-8298732f7319" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717153}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9fada92a-4d5b-5b14-a6ae-547b40c489fd" :question/problem "What is the amplitude of the function\n\n$$\nf(x)=-2\\left(\\frac{1-3\\cos\\left(2x-\\frac{\\pi}{3}\\right)}{4}\\right)+1?\n$$" :question/worked-solution "First, distribute the outer factor and collect the constant terms:\n\n$$\n\\begin{aligned}\nf(x)&=\\frac{-2+6\\cos\\left(2x-\\frac{\\pi}{3}\\right)}{4}+1\\\\\n&=\\frac{3}{2}\\cos\\left(2x-\\frac{\\pi}{3}\\right)-\\frac{1}{2}+1\\\\\n&=\\frac{3}{2}\\cos\\left(2x-\\frac{\\pi}{3}\\right)+\\frac{1}{2}.\n\\end{aligned}\n$$\n\nGiven a function in the form $f(x)=A\\cos(Bx+C)+D$, the amplitude is $|A|$.\n\nThe coefficient of cosine is $A=\\frac{(-2)(-3)}{4}=\\frac{3}{2}$, so the amplitude is $\\left|\\frac{3}{2}\\right|=\\frac{3}{2}$. Both vertical scale factors contribute; the constant terms and the transformations inside the cosine do not change the amplitude."}] [{:db/id #edb/ref 17592186717152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2613d8e8-7f75-5edf-9520-2ad087343dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717136} {:answer/id #uuid "2ea84262-4053-5a80-90bd-9344adb418b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717138} {:answer/id #uuid "7b56fc3e-c793-57c0-88df-d07198f4e836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186717143} {:answer/id #uuid "88dd1fb6-16f8-5ace-885a-fe9898e6168f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186717145} {:answer/id #uuid "cab30b8c-5a3d-51ff-86e1-dac9831b48b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186717150}] :answer-field/correct {:answer/id #uuid "2ea84262-4053-5a80-90bd-9344adb418b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717138} :answer-field/id #uuid "9a3ddafc-2cdb-5f44-b9ac-48b54950b52e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd1d6477-9b48-5b33-ad5e-e9b6803b3779" :question/problem "What is the amplitude of the function $f(x)=3\\cos(2x+1)$?" :question/worked-solution "Given a function in the form $f(x)=A\\cos(Bx+C)+D$, the amplitude is $|A|$.\n\nHere, $A=3$, so the amplitude is $|3|=3$. The constants inside the cosine affect horizontal transformations, not the amplitude."}] [{:db/id #edb/ref 17592186717216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0997cf70-9bd4-5321-a2f4-6be55b85f2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{5}" :db/id #edb/ref 17592186717214} {:answer/id #uuid "19ec09b3-289e-53e4-9523-cb974db99e48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\pi" :db/id #edb/ref 17592186717215} {:answer/id #uuid "33f4d01e-2003-553d-92a8-187e666d8456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi}{5}" :db/id #edb/ref 17592186717219} {:answer/id #uuid "a0fdc898-053b-562a-aa72-c2649ece1697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi}{3}" :db/id #edb/ref 17592186717228} {:answer/id #uuid "a5494544-e7ae-5b0c-bdd8-51c1c50f6c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186717229}] :answer-field/correct {:answer/id #uuid "33f4d01e-2003-553d-92a8-187e666d8456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi}{5}" :db/id #edb/ref 17592186717219} :answer-field/id #uuid "05d63f6c-3389-5b03-a434-b0898fda61df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717213}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "25c6f907-f9a8-57c3-84ea-5d2e3bfdb8fb" :question/problem "Calculate the period of the function $f(x)=-3\\cos\\left(5x+\\frac{\\pi}{6}\\right)+2.$" :question/worked-solution "For a function of the form $f(x)=A\\cos(Bx+C)+D$, the period is\n\n$$\nT=\\frac{2\\pi}{|B|}.\n$$\n\nHere the coefficient of $x$ inside the cosine is $B=5$. The outside factor $-3$ and the shifts do not change the period.\n\n$$\nT=\\frac{2\\pi}{5}.\n$$"}] [{:db/id #edb/ref 17592186717218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3edb244e-a6de-5454-a24c-8ee6ff4acfbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\pi" :db/id #edb/ref 17592186717221} {:answer/id #uuid "53c03638-ee2a-5298-8840-0b66a81d054d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi" :db/id #edb/ref 17592186717222} {:answer/id #uuid "5a808afb-0326-5892-9d26-1cd216acb043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi" :db/id #edb/ref 17592186717224} {:answer/id #uuid "8091d6e7-35a4-5c3d-b07a-b54c2a18f791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186717227} {:answer/id #uuid "d3cd0e40-30c4-5a93-bdc3-1ce33bc3f9ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi" :db/id #edb/ref 17592186717232}] :answer-field/correct {:answer/id #uuid "5a808afb-0326-5892-9d26-1cd216acb043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi" :db/id #edb/ref 17592186717224} :answer-field/id #uuid "6eaa360f-37ae-52e8-8693-f0bffee12803" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717226}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3308dd07-d8ab-58f8-b4c0-58def5f9da3d" :question/problem "Calculate the period of the function\n\n$$\nf(x)=3\\sin\\left(\\frac{\\pi-2x}{3}+\\frac{x}{2}\\right)-4.\n$$" :question/worked-solution "Combine the $x$ terms inside the sine before applying the period formula:\n\n$$\n\\begin{aligned}\n\\frac{\\pi-2x}{3}+\\frac{x}{2}\n&=\\frac{\\pi}{3}-\\frac{2x}{3}+\\frac{x}{2}\\\\\n&=\\frac{\\pi}{3}+\\left(-\\frac{4}{6}+\\frac{3}{6}\\right)x\\\\\n&=-\\frac{x}{6}+\\frac{\\pi}{3}.\n\\end{aligned}\n$$\n\nThe coefficient is $B=-\\frac{1}{6}$. A negative input coefficient reverses the direction of a cycle; the period is a positive length, so use $|B|$:\n\n$$\nT=\\frac{2\\pi}{|B|}=\\frac{2\\pi}{\\frac{1}{6}}=12\\pi.\n$$\n\nUsing only one of the two original $x$ terms would miss their combined effect. The outside factor $3$ and vertical shift $-4$ do not affect the period."}] [{:db/id #edb/ref 17592186717231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26617095-e3d4-5e02-b391-1da36bf3cbc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120^{\\circ}" :db/id #edb/ref 17592186717217} {:answer/id #uuid "34036d7c-4179-5116-aa7f-bc5626b32fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "240^{\\circ}" :db/id #edb/ref 17592186717220} {:answer/id #uuid "5a36bce3-d7a1-5275-ae59-273a26e222e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "540^{\\circ}" :db/id #edb/ref 17592186717223} {:answer/id #uuid "5c5b74e2-9e25-5711-b9c3-b3c004cdef97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60^{\\circ}" :db/id #edb/ref 17592186717225} {:answer/id #uuid "f93f9b4b-1bba-5fed-8219-78d11784cf9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180^{\\circ}" :db/id #edb/ref 17592186717233}] :answer-field/correct {:answer/id #uuid "34036d7c-4179-5116-aa7f-bc5626b32fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "240^{\\circ}" :db/id #edb/ref 17592186717220} :answer-field/id #uuid "aa2c36c5-e46d-5fea-9be8-aa637a94c6fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717230}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ae18bc12-5543-5207-adf2-555a013f582a" :question/problem "Calculate the period of the function\n\n$$\nf(x)=-2\\cos\\left(\\frac{3x-60^{\\circ}}{2}\\right)+4.\n$$\n\nAngles are measured in degrees." :question/worked-solution "First rewrite the entire cosine argument to identify the coefficient of $x$:\n\n$$\n\\frac{3x-60^{\\circ}}{2}=\\frac{3}{2}x-30^{\\circ}.\n$$\n\nThus $B=\\frac{3}{2}$, rather than $3$. In degree measure the period is $T=\\frac{360^{\\circ}}{|B|}$, so\n\n$$\nT=\\frac{360^{\\circ}}{\\frac{3}{2}}=360^{\\circ}\\cdot\\frac{2}{3}=240^{\\circ}.\n$$\n\nThe factor $-2$ outside the cosine and the horizontal and vertical shifts do not change the period."}] [{:db/id #edb/ref 17592186717253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12554939-3fdb-5f44-b013-879120aff676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186717249} {:answer/id #uuid "4e8a4013-490e-5871-8e3d-b0bfadf5ce5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186717255} {:answer/id #uuid "7cd72c98-5071-5992-a101-3ff362bb6cb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186717258} {:answer/id #uuid "a55efc5c-65b1-543f-a9a3-284e2e116c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186717261} {:answer/id #uuid "dea960b4-a44f-5f5a-b850-d82c92802325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186717267}] :answer-field/correct {:answer/id #uuid "7cd72c98-5071-5992-a101-3ff362bb6cb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186717258} :answer-field/id #uuid "86a0adfc-4b4d-584f-bc3d-a7247719494e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717259}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "43766f3b-8cd1-5685-a4cb-a60801bb8133" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-4$ and a maximum value of $8$." :question/worked-solution "The midline is the horizontal line halfway between the minimum and maximum values. Its height is their average:\n\n$$\n\\begin{aligned}\ny &= \\frac{y_{\\text{min}}+y_{\\text{max}}}{2} \\\\\n  &= \\frac{-4+8}{2} \\\\\n  &= \\frac{4}{2} \\\\\n  &= 2.\n\\end{aligned}\n$$\n\nTherefore, the midline is $y=2$. The quantity $\\frac{8-(-4)}{2}=6$ is the amplitude, not the height of the midline."}] [{:db/id #edb/ref 17592186717256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48e5c287-11bb-5295-bdf0-26244fe0a078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186717254} {:answer/id #uuid "9182b76c-2e47-5a92-b671-224e1e1537cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186717260} {:answer/id #uuid "c3a6e577-be17-5007-a942-756cfeba1cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186717263} {:answer/id #uuid "c4ac5989-5fe5-5ed1-9ffc-6d84aa98b7e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186717264} {:answer/id #uuid "d904739c-90cd-5e63-b8c2-3c9474dc1415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186717266}] :answer-field/correct {:answer/id #uuid "9182b76c-2e47-5a92-b671-224e1e1537cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186717260} :answer-field/id #uuid "73415142-73f8-5045-beff-bf98febcda87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717257}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "52d3751c-8e06-5a22-af0c-0f54057545c4" :question/problem "The graph below shows a transformed cosine function. Find the equation of its midline.\n\n![Graph of a sinusoidal function on coordinate axes.](images/d3/d33b35c70cf649d4281e2daa297da3c2918da553e2f93b80e484f357f94cb124.png)" :question/worked-solution "Read the vertical values at a crest and a trough: the maximum is $3$ and the minimum is $-5$. The horizontal coordinates of these points are not needed.\n\nThe midline lies halfway between these two heights:\n\n$$\n\\begin{aligned}\ny &= \\frac{y_{\\text{min}}+y_{\\text{max}}}{2} \\\\\n  &= \\frac{-5+3}{2} \\\\\n  &= -1.\n\\end{aligned}\n$$\n\nTherefore, the midline is $y=-1$. It is $4$ units below each crest and $4$ units above each trough. The $x$-axis is not the midline of this graph."}] [{:db/id #edb/ref 17592186717265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15532ca9-db7a-5004-8099-b725724a073e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186717250} {:answer/id #uuid "1a04c2c3-e9e7-506b-8456-6995a65cf70d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186717251} {:answer/id #uuid "1e1c67d4-6cbe-5e3d-a2aa-f02d79c3b689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-8" :db/id #edb/ref 17592186717252} {:answer/id #uuid "b10f4876-b33e-5fc3-ad01-97721a93b289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186717262} {:answer/id #uuid "ee130e0d-8bbf-5118-9dab-b2844bae23d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186717268}] :answer-field/correct {:answer/id #uuid "1a04c2c3-e9e7-506b-8456-6995a65cf70d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186717251} :answer-field/id #uuid "f281aa0d-bce1-5c80-b933-9c668b39e1aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717269}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d818e201-6367-5af1-8174-188afc79c555" :question/problem "Find the equation of the midline of the function\n\n$$\nf(x)=3-2\\left[\\cos\\left(3x-\\frac{\\pi}{4}\\right)+4\\right].\n$$" :question/worked-solution "The expression is not yet in the form $A\\cos(Bx+C)+D$. Distribute the factor $-2$ to both terms inside the square brackets:\n\n$$\n\\begin{aligned}\nf(x) &= 3-2\\cos\\left(3x-\\frac{\\pi}{4}\\right)-8 \\\\\n     &= -2\\cos\\left(3x-\\frac{\\pi}{4}\\right)-5.\n\\end{aligned}\n$$\n\nNow the vertical shift is $D=-5$, so the midline is $y=-5$. The $-\\frac{\\pi}{4}$ inside the cosine affects horizontal position, not the height of the midline.\n\nTo check using extrema, the cosine term ranges from $-1$ to $1$, so the function ranges from $-7$ to $-3$. Their average is\n\n$$\n\\frac{-7+(-3)}{2}=-5,\n$$\n\nwhich gives the same midline."}] [{:db/id #edb/ref 17592186717389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a24b9a1-0109-5468-8325-0b4ab08f8356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-5,7]" :db/id #edb/ref 17592186717390} {:answer/id #uuid "b97da829-47b7-5041-81ab-96ee9e1d4785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-1,3]" :db/id #edb/ref 17592186717398} {:answer/id #uuid "cf3bf10b-9083-5200-966c-6c34a6aa4913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[0,2]" :db/id #edb/ref 17592186717401} {:answer/id #uuid "dc926e93-0a5f-56ca-a272-8f5c789f0ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in(-1,3)" :db/id #edb/ref 17592186717406} {:answer/id #uuid "ed74f9bb-2861-5ef5-a76e-b0b1ff6e3af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-2,2]" :db/id #edb/ref 17592186717407}] :answer-field/correct {:answer/id #uuid "b97da829-47b7-5041-81ab-96ee9e1d4785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-1,3]" :db/id #edb/ref 17592186717398} :answer-field/id #uuid "d6dc814e-286a-56a6-bf5f-4cecfd069d66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717404}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3335eca0-ac07-5e2e-bf3a-c4b853e66778" :question/problem "Find the range of $f(x)=2\\sin\\left(3x+\\frac{\\pi}{6}\\right)+1$ for all real $x$." :question/worked-solution "The sine function takes every value from $-1$ to $1$, including both endpoints. Horizontal shifts and stretches do not change this range when $x$ can be any real number. Thus,\n\n$$\n-1\\le \\sin\\left(3x+\\frac{\\pi}{6}\\right)\\le 1.\n$$\n\nMultiply by $2$, then add $1$:\n\n$$\n\\begin{aligned}\n-2&\\le 2\\sin\\left(3x+\\frac{\\pi}{6}\\right)\\le 2 \\\\\n-1&\\le 2\\sin\\left(3x+\\frac{\\pi}{6}\\right)+1\\le 3.\n\\end{aligned}\n$$\n\nBoth endpoints are attained, and every value between them is attained. Therefore, the range is $f(x)\\in[-1,3]$."}] [{:db/id #edb/ref 17592186717394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cdfd86e-64ac-5247-9e66-ee2110d281ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-2,4]" :db/id #edb/ref 17592186717387} {:answer/id #uuid "5d68daaa-32d5-5f7e-a1ed-1a63c8a0a9f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-7,5]" :db/id #edb/ref 17592186717393} {:answer/id #uuid "779ff05d-b3a1-5875-9715-816b32ec34b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-3,3]" :db/id #edb/ref 17592186717395} {:answer/id #uuid "d4cf998f-066d-57f0-b8c1-bc2e4759d338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-4,2]" :db/id #edb/ref 17592186717403} {:answer/id #uuid "d709edc6-eb04-5f10-a9eb-e3b4807eb0b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-4,-1]" :db/id #edb/ref 17592186717405}] :answer-field/correct {:answer/id #uuid "d4cf998f-066d-57f0-b8c1-bc2e4759d338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-4,2]" :db/id #edb/ref 17592186717403} :answer-field/id #uuid "9f5d7ca9-cb38-584c-b768-6f3f17ebb997" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717397}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "68bdbc63-7a1d-576c-8887-242f3b2a75f9" :question/problem "Find the range of $f(x)=-3\\cos\\left(2x-\\frac{\\pi}{4}\\right)-1$ for all real $x$." :question/worked-solution "Horizontal shifts and stretches do not change the range of cosine over all real inputs, so\n\n$$\n-1\\le \\cos\\left(2x-\\frac{\\pi}{4}\\right)\\le 1.\n$$\n\nMultiplying by $-3$ reverses both inequality signs. Then subtract $1$:\n\n$$\n\\begin{aligned}\n3&\\ge -3\\cos\\left(2x-\\frac{\\pi}{4}\\right)\\ge -3 \\\\\n2&\\ge -3\\cos\\left(2x-\\frac{\\pi}{4}\\right)-1\\ge -4.\n\\end{aligned}\n$$\n\nWriting the smaller endpoint first gives $-4\\le f(x)\\le 2$. Cosine attains both $1$ and $-1$ and all values between them, so the range is $f(x)\\in[-4,2]$."}] [{:db/id #edb/ref 17592186717399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21ade7f0-c062-5252-84e6-9b69a204ed7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-5,-1]" :db/id #edb/ref 17592186717388} {:answer/id #uuid "3afbfab6-e43d-5680-ac5c-0c7e617dc9ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-3,1]" :db/id #edb/ref 17592186717391} {:answer/id #uuid "4507d460-4457-5283-9412-c9930af0048c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-9,3]" :db/id #edb/ref 17592186717392} {:answer/id #uuid "975711ec-01be-59ab-b0b7-54dad4c9a765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-5,-1)" :db/id #edb/ref 17592186717396} {:answer/id #uuid "c6145bcc-2223-5fbf-9a3c-119e99e49a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-1,3]" :db/id #edb/ref 17592186717400}] :answer-field/correct {:answer/id #uuid "21ade7f0-c062-5252-84e6-9b69a204ed7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-5,-1]" :db/id #edb/ref 17592186717388} :answer-field/id #uuid "d2531734-cfc4-53c6-a051-cb6670a4b4dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717402}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c57b5360-bc34-5163-a91e-b827e6d4af93" :question/problem "Find the range of $f(x)=1-2\\left(2-\\cos\\left(3x+\\frac{\\pi}{4}\\right)\\right)$ for all real $x$." :question/worked-solution "First simplify the vertical transformations. The factor $-2$ multiplies both terms inside the outer parentheses:\n\n$$\n\\begin{aligned}\nf(x)&=1-4+2\\cos\\left(3x+\\frac{\\pi}{4}\\right) \\\\\n&=2\\cos\\left(3x+\\frac{\\pi}{4}\\right)-3.\n\\end{aligned}\n$$\n\nThe effective vertical shift is $-3$, and the amplitude is $2$. Horizontal shifts and stretches do not change the range over all real inputs. Starting from the cosine bounds, multiply by $2$ and subtract $3$:\n\n$$\n\\begin{aligned}\n-1&\\le \\cos\\left(3x+\\frac{\\pi}{4}\\right)\\le 1 \\\\\n-2&\\le 2\\cos\\left(3x+\\frac{\\pi}{4}\\right)\\le 2 \\\\\n-5&\\le 2\\cos\\left(3x+\\frac{\\pi}{4}\\right)-3\\le -1.\n\\end{aligned}\n$$\n\nCosine attains every value in $[-1,1]$, so every value between these transformed endpoints, including the endpoints, is attained. Therefore, the range is $f(x)\\in[-5,-1]$."}] [{:db/id #edb/ref 17592186717533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274d3844-0a2c-5c26-8577-37559f28b5f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186717527} {:answer/id #uuid "37cd5f52-19dd-5ef7-84d1-f1c57a2797bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186717529} {:answer/id #uuid "3e8c9f77-aa09-5388-931c-cefe1b2c24b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186717532} {:answer/id #uuid "c55b61cc-12b6-5bb7-8cf7-6c6298a2e634" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186717550} {:answer/id #uuid "f4d9d948-3d71-51dc-ab42-7f5a76bcf9a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717553}] :answer-field/correct {:answer/id #uuid "3e8c9f77-aa09-5388-931c-cefe1b2c24b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186717532} :answer-field/id #uuid "41976654-3a7a-5032-ba1c-5deaa4d77b57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717534}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f713e3f-05c6-5556-85eb-8f71a3f6fac5" :question/problem "What is the amplitude of the function $f(x)=\\frac{-6\\sin\\left(x\\right)-2}{5}$?" :question/worked-solution "First, rewrite the function to identify the whole coefficient:\n\n$$\n\\begin{aligned}f(x)&=\\frac{-6\\sin\\left(x\\right)-2}{5} \\\\ &=-\\frac{6}{5}\\sin\\left(x\\right)-\\frac{2}{5}\\end{aligned}\n$$\n\nFor a function in the form $f(x)=A\\sin(Bx+C)+D$, the amplitude is $|A|$.\n\nHere, $A=-\\frac{6}{5}$, so the amplitude is $\\left|-\\frac{6}{5}\\right|=\\frac{6}{5}$. Horizontal transformations and additive constants do not change the amplitude."}] [{:db/id #edb/ref 17592186717538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0758a54a-3cf7-5a54-969e-d04cb7e8e1ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186717521} {:answer/id #uuid "108bd16b-7569-5fa4-bed2-a2ab1decca52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717524} {:answer/id #uuid "38af7aa7-439c-5e37-8e26-c023fae240bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186717530} {:answer/id #uuid "653ea984-6473-57e9-bfb7-86a68d5d4f1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186717539} {:answer/id #uuid "76b58dd2-d143-546c-97f3-9f6aedd1d764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186717542}] :answer-field/correct {:answer/id #uuid "653ea984-6473-57e9-bfb7-86a68d5d4f1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186717539} :answer-field/id #uuid "04d649ab-0b3a-5e31-bb87-e93732d1344e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717520}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6257877c-d8db-50b9-9446-07e16dddd2a6" :question/problem "What is the amplitude of the function $f(x)=\\frac{-6\\sin\\left(x\\right)+2}{6}$?" :question/worked-solution "First