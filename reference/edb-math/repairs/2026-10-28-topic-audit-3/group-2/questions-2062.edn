#{[{:db/id #edb/ref 17592186128877 :question/id #uuid "e2e5002a-d3ae-5831-b405-41618960aee4" :question/math-academy-id "e-15609" :question/problem "What is the amplitude of the function $f(x) = -2\\sin\\left(x-\\dfrac\\pi 3\\right) + 1?$" :question/worked-solution "Given a function in the form $f(x)= A\\sin(Bx +C) + D,$ the amplitude is $|A|.$\n\nIn our case, we have that $A=-2.$ Therefore, the amplitude is $|A|=2.$"}] [{:db/id #edb/ref 17592186128878 :question/id #uuid "7f6626c7-c3d3-5f4e-b2c7-1e9bf07e883c" :question/math-academy-id "e-15610" :question/problem "Calculate the period of the function $y=\\cos(2x).$" :question/worked-solution "Given a function in the form $y = A\\cos(Bx +C) + D,$ the period is $\\dfrac{2\\pi}{B}.$\n\nIn our case, we have that $B=2.$ Therefore, the period is $\\dfrac{2\\pi}{\\left(2\\right)}=\\pi.$"}] [{:db/id #edb/ref 17592186128879 :question/id #uuid "61b6821f-3ee5-5dd8-b8a3-ee1859645237" :question/math-academy-id "e-15611" :question/problem "What is the range of the function $f(x) = -4\\cos(3x)-2?$" :question/worked-solution "The range of $\\cos x$ is\n\n$$\n-1 \\leq \\cos x \\leq 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\leq\\cos\\left(3x \\right) \\leq 1.\n$$\n\nMultiplying the above inequality by $-4$ and then subtracting $2,$ we get\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡(3x)\\le 1 \\\\ 4 & \\ge -4\\operatorname{cos}⁡(3x)\\ge -4 \\\\ 2 & \\ge -4\\operatorname{cos}⁡(3x)-2\\ge -6 \\\\ -6 & \\le f(x)\\le 2.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-6,2].$"}] [{:db/id #edb/ref 17592186128880 :question/id #uuid "bfa446cd-c215-59c2-b84d-35d7897e9e34" :question/math-academy-id "e-15615" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-6$ and a maximum value of $8.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny = \\dfrac{y_{\\textrm{min}}+y_{\\textrm{max}}}{2},\n$$\n\nwhere $y_{\\textrm{min}}$ and $y_{\\textrm{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-6+8}{2} \\\\  & =\\frac{2}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the midline is $y=1.$"}] [{:db/id #edb/ref 17592186129402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa4dfa97-3f07-5567-8750-354f30d3bb6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y ∈ [- 7,-1]" :db/id #edb/ref 17592186125913} {:answer/id #uuid "0762c47c-21fb-5163-a406-96a9be3d58cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y ∈ [- 3, 3]" :db/id #edb/ref 17592186125914} {:answer/id #uuid "2a6936e4-5181-5162-bdd9-123c1faeca22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y ∈ [- 1, 1]" :db/id #edb/ref 17592186125915} {:answer/id #uuid "2fbbf1f8-d357-55ff-a29c-402606b30540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y ∈ [- 7, 1]" :db/id #edb/ref 17592186125916} {:answer/id #uuid "6ae56e90-9f1d-5606-9be5-28722497106f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y ∈ [- 4, 4]" :db/id #edb/ref 17592186125917}] :answer-field/id #uuid "63d1fe39-af31-57a3-bd68-bea4f64dce00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186125912}] :question/id #uuid "e4da1620-07d2-569d-b915-84247670b54c" :question/math-academy-id "q-10249" :question/problem "Find the range of the function $y = 3\\sin (2x + 1) - 4$."}] [{:db/id #edb/ref 17592186129561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4da8725-8550-5cf7-8104-83fb6f684917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-4" :db/id #edb/ref 17592186126844} {:answer/id #uuid "f94a10a6-5ab7-569e-8472-996b9cbd50c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-9" :db/id #edb/ref 17592186126845} {:answer/id #uuid "10dbf042-1fb5-5a2a-9c60-88dc1897734a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 1" :db/id #edb/ref 17592186126846} {:answer/id #uuid "2a9ea6b3-85d6-5c26-8e00-91d959c6ea53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 5" :db/id #edb/ref 17592186126847} {:answer/id #uuid "35140d77-6bc7-522e-a4b6-6b2d9d5e7dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-5" :db/id #edb/ref 17592186126848}] :answer-field/id #uuid "4ca55e4f-7957-562a-bb00-f3b76b1ea9e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126843}] :question/id #uuid "411be2a6-219d-561e-9f5e-b4e6962a294f" :question/math-academy-id "q-236750" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-9$ and a maximum value of $1$."}] [{:db/id #edb/ref 17592186129562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffe8c2d-22ae-5a74-9fb5-b44fdb8cce26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7" :db/id #edb/ref 17592186288150} {:answer/id #uuid "3f9156c5-37a7-56f3-b8d3-991ed27e42a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186288465} {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} {:answer/id #uuid "d650ff67-6889-5b78-bc90-d9ce4271c33c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186289456} {:answer/id #uuid "d7360b5c-2ef2-52b6-a3be-6f516c9b4151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186289463}] :answer-field/correct {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} :answer-field/id #uuid "b0fa4e38-53cb-50b5-ba34-1bae28b400d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290121}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "723b13df-bde4-592d-ade7-17cdd1dad568" :question/math-academy-id "q-236896" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-5$ and a maximum value of $9.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-5+9}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"}] [{:db/id #edb/ref 17592186129768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0ef8c22-f84b-5450-ba53-f513cd2e8d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186128090} {:answer/id #uuid "f39f7275-b997-50eb-