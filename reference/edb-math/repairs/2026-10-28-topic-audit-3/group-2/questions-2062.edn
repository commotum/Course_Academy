/value "y=7" :db/id #edb/ref 17592186288200} {:answer/id #uuid "1dffc632-f16c-55e1-9b97-d1c5aeae6758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186288222} {:answer/id #uuid "8543a8fe-b744-523c-b7fb-7c470ba81d14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288931} {:answer/id #uuid "bb0a5dd6-d308-583b-b134-199f67a9d04b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186289267} {:answer/id #uuid "ffd48777-993d-5f12-a8f2-e3af62e80d7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10" :db/id #edb/ref 17592186289727}] :answer-field/correct {:answer/id #uuid "bb0a5dd6-d308-583b-b134-199f67a9d04b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186289267} :answer-field/id #uuid "2687fc32-533f-593d-8d64-483ed7bd132f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289820}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19d7902b-1be6-510b-930b-715d7217e72b" :question/math-academy-id "q-236899" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $6$ and a maximum value of $10.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{6+10}{2} \\\\  & =\\frac{16}{2} \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, the midline is $y=8.$"}] [{:db/id #edb/ref 17592186290477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f675d33-9792-5f53-b7b9-f9536f49fb90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186288142} {:answer/id #uuid "18eea2d3-d7aa-5ce2-95b1-3436a75fdf6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=12" :db/id #edb/ref 17592186288192} {:answer/id #uuid "46157afd-69d5-5ce4-ad51-f9464b541346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288511} {:answer/id #uuid "80c01211-152d-5bc4-83af-258dcbd2d63b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=15" :db/id #edb/ref 17592186288900} {:answer/id #uuid "cf212491-b8c6-5480-a89e-4b6471b10f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186289414}] :answer-field/correct {:answer/id #uuid "cf212491-b8c6-5480-a89e-4b6471b10f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186289414} :answer-field/id #uuid "f7defb23-ecb8-5959-b191-fd609b6b1d79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290242}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0c4be84-8850-5ae2-a033-a27a5aa083d4" :question/math-academy-id "q-236901" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $3$ and a maximum value of $15.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{3+15}{2} \\\\  & =\\frac{18}{2} \\\\  & =9.\\end{aligned}\n$$\n\nTherefore, the midline is $y=9.$"}] [{:db/id #edb/ref 17592186326892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46dbfb94-8f7e-52b5-a0bc-216cfa3f3688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-1,5]" :db/id #edb/ref 17592186324540} {:answer/id #uuid "761814c1-8f36-5a1f-a9c3-df54f177de2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-6,1]" :db/id #edb/ref 17592186324952} {:answer/id #uuid "8d0d2ae8-7e42-557f-930a-2314bd90d992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [0,4]" :db/id #edb/ref 17592186325169} {:answer/id #uuid "b06eafb2-11d2-56a5-ab67-ec95fe6b25ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-3,3]" :db/id #edb/ref 17592186325476} {:answer/id #uuid "b37f5dc8-1fd1-5b76-b5e2-0cd483be88a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-4,0]" :db/id #edb/ref 17592186325510}] :answer-field/correct {:answer/id #uuid "46dbfb94-8f7e-52b5-a0bc-216cfa3f3688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in [-1,5]" :db/id #edb/ref 17592186324540} :answer-field/id #uuid "19ba0b8e-1c6b-5fd4-a9f9-80b8a5cf11c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326269}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d95e69c-d8b6-504a-9a9e-0e0569042175" :question/math-academy-id "q-40903" :question/problem "What is the range of $f(x)=3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})+2?$" :question/worked-solution "The range of $\\operatorname{sin}⁡x$ is\n\n$$\n-1\\le \\operatorname{sin}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 1.\n$$\n\nMultiplying the above inequality by $3$ and then adding $2$, we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 1 \\\\  & -3\\le 3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 3 \\\\  & -1\\le 3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})+2\\le 5 \\\\  & -1\\le f(x)\\le 5.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-1,5].$"}] [{:db/id #edb/ref 17592186326912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d1c4191-fab1-56ef-9a9e-5df4f5a37573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [4,6]" :db/id #edb/ref 17592186324871} {:answer/id #uuid "705447cb-ac85-5790-aadf-544a4a2ca55d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-2,6]" :db/id #edb/ref 17592186324896} {:answer/id #uuid "c37b50d3-93b0-5e4b-a2f6-ad5ca8b620b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [3,6]" :db/id #edb/ref 17592186325652} {:answer/id #uuid "d9fbb5f9-1876-576d-956d-164f993762da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [2,4]" :db/id #edb/ref 17592186325870} {:answer/id #uuid "e3d1017a-3133-56bf-ad84-e9bd0f77a8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [2,6]" :db/id #edb/ref 17592186325976}] :answer-field/correct {:answer/id #uuid "e3d1017a-3133-56bf-ad84-e9bd0f77a8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [2,6]" :db/id #edb/ref 17592186325976} :answer-field/id #uuid "5600e685-5275-5ef3-a75f-13f121192c83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326367}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8be6063d-ee1d-5aea-9fe3-f1f6572dff56" :question/math-academy-id "q-41840" :question/problem "What is the range of the function $y=-2\\operatorname{sin}⁡(x+{30}^{∘})+4?$" :question/worked-solution "The range of $\\operatorname{sin}⁡x$ is\n\n$$\n-1\\le \\operatorname{sin}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}⁡(x+{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $-2$ and then adding $4$, we get\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡(x+{30}^{∘})\\le 1 \\\\ 2 & \\ge -2\\operatorname{sin}⁡(x+{30}^{∘})\\ge -2 \\\\ 6 & \\ge -2\\operatorname{sin}⁡(x+{30}^{∘})+4\\ge 2 \\\\ 2 & \\le y\\le 6.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [2,6].$"}] [{:db/id #edb/ref 17592186326917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04840a88-e955-54d7-9016-ac6fea11fba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-5,3]" :db/id #edb/ref 17592186324015} {:answer/id #uuid "38292c02-f847-53f2-a45b-6862fdc0c0e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-5,4]" :db/id #edb/ref 17592186324427} {:answer/id #uuid "6ac3ca11-8380-5948-90cd-da2a9257a2a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-1,5]" :db/id #edb/ref 17592186324863} {:answer/id #uuid "a6982aa2-f584-5158-bc82-602dcb0974ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [0,2]" :db/id #edb/ref 17592186325391} {:answer/id #uuid "f6deb213-4583-5f6b-81ae-fc1650ade5aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-3,5]" :db/id #edb/ref 17592186326145}] :answer-field/correct {:answer/id #uuid "f6deb213-4583-5f6b-81ae-fc1650ade5aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-3,5]" :db/id #edb/ref 17592186326145} :answer-field/id #uuid "fd64b16d-a8fc-5173-a59f-621cbfcddda1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326667}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "87e222c7-c912-54d0-9c4f-f1a9126f53ea" :question/math-academy-id "q-41964" :question/problem "What is the range of the function $y=-4\\operatorname{cos}⁡(x-{30}^{∘})+1?$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(x-{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $-4$ and then adding $1,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{cos}⁡(x-{30}^{∘})\\le 1 \\\\  & 4\\ge -4\\operatorname{cos}⁡(x-{30}^{∘})\\ge -4 \\\\  & 5\\ge -4\\operatorname{cos}⁡(x-{30}^{∘})+1\\ge -3 \\\\  & -3\\le y\\le 5.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [-3,5].$"}] [{:db/id #edb/ref 17592186329723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f720e8d-bb1b-59ca-9ab6-dc161291bf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186327071} {:answer/id #uuid "5fc7ca04-3dfc-5466-a866-a199437da7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186327775} {:answer/id #uuid "7851f496-18f4-5ce9-b27a-0a6147c6176e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327963} {:answer/id #uuid "85974f52-6385-50ae-a81b-e8bc2b19d899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186328085} {:answer/id #uuid "dfb14292-bdff-5641-bc24-4dffec7b4e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{75}^{∘}" :db/id #edb/ref 17592186328894}] :answer-field/correct {:answer/id #uuid "7851f496-18f4-5ce9-b27a-0a6147c6176e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327963} :answer-field/id #uuid "c2a5f161-27b6-5dd4-aa10-c1cb6123c7a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329527}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "72d5418e-aa83-5e26-b56d-9365871c6a6c" :question/math-academy-id "q-43411" :question/problem "What is the period of the function $f(x)=\\operatorname{cos}⁡(8x+{90}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}⁡(Bx+C)+D,$ the period is ${360}^{∘}.$\n\nIn our case, we have that $B=8.$ Therefore, the period is $\\frac{{360}^{∘}}{8}={45}^{∘}.$"}] [{:db/id #edb/ref 17592186332896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e616922-3cb9-5d0d-adb4-d5f2e9937e8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186330503} {:answer/id #uuid "49dad8f8-1906-5970-a75a-02b096c82478" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186330613} {:answer/id #uuid "516a2115-a7cd-5bc8-a211-941eb2a6c091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186330685} {:answer/id #uuid "806611f0-40df-5c8d-9ad4-4c05dfff9ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186331086} {:answer/id #uuid "becedc42-47cd-5039-8a91-00d39f0721ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331640}] :answer-field/correct {:answer/id #uuid "becedc42-47cd-5039-8a91-00d39f0721ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331640} :answer-field/id #uuid "676bbfa2-424e-564f-8cd6-1aa8c4be8621" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332393}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "149ae65f-0d63-59f5-9ea2-35fcac7e5bad" :question/math-academy-id "q-53428" :question/problem "What is the amplitude of the function $$\n\\displaystyle f(x)=\\operatorname{cos}⁡(\\frac{1}{2}x+\\frac{1}{3})?\n$$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}⁡(Bx+C)+D,$ the amplitude is $|A|.$ \n\nSince $A=1,$ we have that the amplitude is $|A|=|1|=1.$"}] [{:db/id #edb/ref 17592186335863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049dd516-6944-5edb-9121-db6169976ff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186333026} {:answer/id #uuid "0a8d3b55-d51c-51d5-bd6a-0541774185bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333086} {:answer/id #uuid "1a966c12-73ac-529e-b12c-6d9225d16bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333234} {:answer/id #uuid "62773bc4-d26b-5f61-9e63-bc7fe7b85b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186333884} {:answer/id #uuid "680b922e-06f1-58c6-a230-4f635170ac17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186333942}] :answer-field/correct {:answer/id #uuid "1a966c12-73ac-529e-b12c-6d9225d16bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333234} :answer-field/id #uuid "10ca3b69-16be-55a0-a521-16c8667ae7c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335272}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "df79444b-bf13-5349-9442-8567f87e370a" :question/math-academy-id "q-65928" :question/problem "What is the minimum value of $f(x)=-\\operatorname{cos}⁡(3x+\\pi )-4?$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(3x+\\pi )\\le 1.\n$$\n\nMultiplying the above inequality by $-1$ and then subtracting $4,$ we get\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡(3x+\\pi )\\le 1 \\\\ 1 & \\ge -\\operatorname{cos}⁡(3x+\\pi )\\ge -1 \\\\ -3 & \\ge -\\operatorname{cos}⁡(3x+\\pi )-4\\ge -5 \\\\ -5 & \\le f(x)\\le -3.\\end{aligned}\n$$\n\nTherefore, the minimum value is $-5.$"}] [{:db/id #edb/ref 17592186351316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72d4ed76-78bc-5009-903d-4c9fc40a448d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186349504} {:answer/id #uuid "a38b821d-90c3-530e-a124-7a5086347c8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186349906} {:answer/id #uuid "d33a0364-2eca-59d6-9d4a-aef2fd2d1463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186350301} {:answer/id #uuid "f68a4f0c-5fe8-5709-a481-0a2835088a4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{75}^{∘}" :db/id #edb/ref 17592186350605} {:answer/id #uuid "ff872ef7-82ca-59b4-af18-91ac052fdbd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186350701}] :answer-field/correct {:answer/id #uuid "ff872ef7-82ca-59b4-af18-91ac052fdbd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186350701} :answer-field/id #uuid "0c1ac7ab-74ba-5764-8f62-f311748dbee5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350729}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e356a361-0054-56e0-9326-4eab7969f279" :question/math-academy-id "q-81513" :question/problem "What is the period of the function $f(x)=-2\\operatorname{sin}⁡(9x-{1}^{∘})?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{{360}^{∘}}{B}.$\n\nIn our case, we have that $B=9.$ Therefore, the period is $\\frac{{360}^{∘}}{9}={40}^{∘}.$"}] [{:db/id #edb/ref 17592186528230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c63b7807-924b-5cd9-9269-93f593f3341b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186528272} {:answer/id #uuid "da263cbe-0dd7-52a5-8958-6f7496aa29f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{5}{2}" :db/id #edb/ref 17592186528278} {:answer/id #uuid "de0d2613-ae21-5aac-8e90-d0ed7a5c8e08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186528280} {:answer/id #uuid "e6f69cc9-5c7d-56f7-a740-78a0f411305f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}" :db/id #edb/ref 17592186528287} {:answer/id #uuid "fecfeb46-cc9d-5999-97b7-d56cfe3ee18f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186528294}] :answer-field/correct {:answer/id #uuid "da263cbe-0dd7-52a5-8958-6f7496aa29f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{5}{2}" :db/id #edb/ref 17592186528278} :answer-field/id #uuid "a5ea9b3d-257a-5149-9d24-2262e22f6c0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528258}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "188341e5-176c-56d0-9b0d-166eb3649470" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-5$ and a maximum value of $0.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-5+0}{2} \\\\  & =\\frac{-5}{2} \\\\  & =- \\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the midline is $y=- \\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186528231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e737ad3-d23f-5c4a-979e-92c7ebff2c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{27}{4}" :db/id #edb/ref 17592186528226} {:answer/id #uuid "43094c1b-fef5-50c0-bab4-6a06c912bc51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{65}{12}" :db/id #edb/ref 17592186528236} {:answer/id #uuid "4fdd4134-1e6f-5637-be0c-cea4675f472a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{73}{6}" :db/id #edb/ref 17592186528238} {:answer/id #uuid "5d222829-3d88-542f-9b44-d16102881059" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{65}{6}" :db/id #edb/ref 17592186528239} {:answer/id #uuid "e61488c5-1a68-54cb-a681-7dbc653f65d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{4}{3}" :db/id #edb/ref 17592186528285}] :answer-field/correct {:answer/id #uuid "43094c1b-fef5-50c0-bab4-6a06c912bc51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{65}{12}" :db/id #edb/ref 17592186528236} :answer-field/id #uuid "efe30463-63d2-5c51-8373-d8d06f9ee9b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528291}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1c754a8c-5407-5f48-b620-3d3480f792f3" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $- \\frac{4}{3}$ and a maximum value of $\\frac{73}{6}.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{- \\frac{4}{3}+\\frac{73}{6}}{2} \\\\  & =\\frac{\\frac{-8}{6}+\\frac{73}{6}}{2} \\\\  & =\\frac{\\frac{65}{6}}{2} \\\\  & =\\frac{65}{12}.\\end{aligned}\n$$\n\nTherefore, the midline is $y=\\frac{65}{12}.$"}] [{:db/id #edb/ref 17592186528234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1083d58c-448b-539e-9593-9c6642b24a16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{127}{12}" :db/id #edb/ref 17592186528228} {:answer/id #uuid "2df58d44-1900-5c2d-8173-0f3854632cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}" :db/id #edb/ref 17592186528232} {:answer/id #uuid "30b48674-4d11-5712-9e40-4fba8c2970b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{4}" :db/id #edb/ref 17592186528235} {:answer/id #uuid "ae473724-21de-568e-ba83-6d4b6b620767" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{71}{6}" :db/id #edb/ref 17592186528264} {:answer/id #uuid "d68ed4ec-7094-5836-8b3a-717639242e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{28}{3}" :db/id #edb/ref 17592186528277}] :answer-field/correct {:answer/id #uuid "30b48674-4d11-5712-9e40-4fba8c2970b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{4}" :db/id #edb/ref 17592186528235} :answer-field/id #uuid "67ee54bd-58b8-5fb7-b04a-f0b86667fb92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528241}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2ecfdb1f-34ef-50bc-8ad5-f3356c941231" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $- \\frac{28}{3}$ and a maximum value of $\\frac{71}{6}.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{- \\frac{28}{3}+\\frac{71}{6}}{2} \\\\  & =\\frac{\\frac{-56}{6}+\\frac{71}{6}}{2} \\\\  & =\\frac{\\frac{5}{2}}{2} \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$\n\nTherefore, the midline is $y=\\frac{5}{4}.$"}] [{:db/id #edb/ref 17592186528248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1004cf-f1a7-5a75-aa2e-f8a74a5cc4fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{16}{3}" :db/id #edb/ref 17592186528225} {:answer/id #uuid "0eed6da0-7414-590e-98f5-47e456941a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{19}{2}" :db/id #edb/ref 17592186528227} {:answer/id #uuid "acd0278b-8356-534d-8e9a-4248804e05f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{73}{6}" :db/id #edb/ref 17592186528263} {:answer/id #uuid "e76e52db-d395-5de5-8d94-b12e3267d4f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{89}{6}" :db/id #edb/ref 17592186528288} {:answer/id #uuid "f1bab62c-1b29-58b7-b906-ecf0979709a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{8}{3}" :db/id #edb/ref 17592186528292}] :answer-field/correct {:answer/id #uuid "f1bab62c-1b29-58b7-b906-ecf0979709a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{8}{3}" :db/id #edb/ref 17592186528292} :answer-field/id #uuid "e78645c7-9ee1-53ff-a775-374d3f1b82a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528289}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "88c6b85b-48c7-5106-9d1d-a28235135006" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $- \\frac{89}{6}$ and a maximum value of $\\frac{19}{2}.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{- \\frac{89}{6}+\\frac{19}{2}}{2} \\\\  & =\\frac{\\frac{-89}{6}+\\frac{57}{6}}{2} \\\\  & =\\frac{- \\frac{16}{3}}{2} \\\\  & =- \\frac{8}{3}.\\end{aligned}\n$$\n\nTherefore, the midline is $y=- \\frac{8}{3}.$"}] [{:db/id #edb/ref 17592186528249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4df6ecc5-21d7-5002-a6b2-237217ed1e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186528237} {:answer/id #uuid "791f58b1-cade-5b4d-8175-ca928214a472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186528244} {:answer/id #uuid "92b45187-9e0c-55b3-aaa3-5df7bd1882ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{1}{2}" :db/id #edb/ref 17592186528250} {:answer/id #uuid "9504b12f-77d7-57b0-94f2-e7107be1309f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{9}{2}" :db/id #edb/ref 17592186528253} {:answer/id #uuid "976e393c-9f46-5167-93b8-e75ad65c7eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186528254}] :answer-field/correct {:answer/id #uuid "92b45187-9e0c-55b3-aaa3-5df7bd1882ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- \\frac{1}{2}" :db/id #edb/ref 17592186528250} :answer-field/id #uuid "f792c656-7069-5b49-ba32-c22216033a3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528293}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "90faa74d-85c8-5992-b843-f857e8de677b" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-5$ and a maximum value of $4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-5+4}{2} \\\\  & =\\frac{-1}{2} \\\\  & =- \\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the midline is $y=- \\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186528260 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5df05cd7-4538-5c67-98b1-774e67f1917b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186528240} {:answer/id #uuid "9937ce2c-a927-5af7-ba3f-b6dfccf29570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186528255} {:answer/id #