/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d4575cc-fccf-5c70-b167-7a343adba348" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186717656} {:answer/id #uuid "4f5fbfac-87a7-5d99-8f79-fc0c5a94d3b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-8" :db/id #edb/ref 17592186717661} {:answer/id #uuid "888b5cce-daa2-5969-a098-932026381586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186717671} {:answer/id #uuid "8f794790-bcb0-58dd-b095-25cc47ecfede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186717675} {:answer/id #uuid "acbec2b1-2f00-5718-b725-5661d925dfc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186717679}] :answer-field/correct {:answer/id #uuid "888b5cce-daa2-5969-a098-932026381586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186717671} :answer-field/id #uuid "27c617d4-0f76-5508-8aa7-0d5792b56bc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717659}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8e291862-3e91-5eda-885f-21b1fbeffad9" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $0$ and a maximum value of $8$." :question/worked-solution "The midline is the horizontal line halfway between the minimum and maximum values. Average their heights:\n\n$$\n\\begin{aligned}\ny &= \\frac{y_{\\text{min}}+y_{\\text{max}}}{2} \\\\\n&= \\frac{0+8}{2} \\\\\n&= 4.\n\\end{aligned}\n$$\n\nTherefore, the midline is $y=4$. The half-range $4$ is the amplitude. Here the amplitude and midline height happen to have the same numerical value."}] [{:db/id #edb/ref 17592186717680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1395f189-8806-57da-b811-2c0324adeb73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186717653} {:answer/id #uuid "1ac690cc-f54a-5233-a057-53a45a634593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186717655} {:answer/id #uuid "57f7ab9a-3918-5890-b141-3b09627cd926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186717663} {:answer/id #uuid "c117cbcf-845d-521c-8558-04ea2532aee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186717682} {:answer/id #uuid "de188328-a69f-5cf9-9cb3-6de313009d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-6" :db/id #edb/ref 17592186717683}] :answer-field/correct {:answer/id #uuid "57f7ab9a-3918-5890-b141-3b09627cd926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186717663} :answer-field/id #uuid "2ca09b7b-6c42-5e23-829e-bcda9a36aca6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717660}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b11aa276-78ac-5b4b-8d39-5842672eff17" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-1$ and a maximum value of $7$." :question/worked-solution "The midline is the horizontal line halfway between the minimum and maximum values. Average their heights:\n\n$$\n\\begin{aligned}\ny &= \\frac{y_{\\text{min}}+y_{\\text{max}}}{2} \\\\\n&= \\frac{-1+7}{2} \\\\\n&= 3.\n\\end{aligned}\n$$\n\nTherefore, the midline is $y=3$. The half-range $4$ is the amplitude, rather than the vertical shift."}] [{:db/id #edb/ref 17592186717814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0765e57a-5e18-59b9-b311-1f3360392354" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-3,1]" :db/id #edb/ref 17592186717812} {:answer/id #uuid "0a5314e5-8800-5cd4-86d8-75792eea78f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-3,5]" :db/id #edb/ref 17592186717813} {:answer/id #uuid "65aa1f43-2fd9-5afd-b749-421cc12a8e0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-1,3]" :db/id #edb/ref 17592186717825} {:answer/id #uuid "a6897f10-dafd-55cb-a5a0-e5cab80f0dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[1,5]" :db/id #edb/ref 17592186717833} {:answer/id #uuid "af6fda1a-84a6-54a9-891c-84829325d4f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-5,3]" :db/id #edb/ref 17592186717835}] :answer-field/correct {:answer/id #uuid "0a5314e5-8800-5cd4-86d8-75792eea78f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-3,5]" :db/id #edb/ref 17592186717813} :answer-field/id #uuid "72e0dae1-9694-547d-8e7e-e5e7c5ab8840" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717829}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11bf814f-5f3f-5cb3-993f-44149cea43ce" :question/problem "Find the range of $f(x)=-4\\sin\\left(-4x\\right)+1$ for all real $x$." :question/worked-solution "A nonzero horizontal scale and any horizontal shift preserve the full sine or cosine range over all real inputs. Start with\n\n$$\n\\begin{aligned}\n-1&\\le \\sin\\left(-4x\\right)\\le 1\n\\end{aligned}\n$$\n\nMultiply by $-4$, reversing both inequalities. Then add $1$.\n\n$$\n\\begin{aligned}\n4&\\ge -4\\sin\\left(-4x\\right)\\ge -4 \\\\5&\\ge -4\\sin\\left(-4x\\right)+1\\ge -3 \\\\-3&\\le f(x)\\le 5\n\\end{aligned}\n$$\n\nBoth endpoint values and every value between them are attained. Therefore, the range is $f(x)\\in[-3,5]$."}] [{:db/id #edb/ref 17592186717819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15702475-5807-55e6-819f-3a3f1bb63cf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-7,-1]" :db/id #edb/ref 17592186717815} {:answer/id #uuid "4c4536c9-a82a-5964-a466-2eeedd021600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-13,5]" :db/id #edb/ref 17592186717822} {:answer/id #uuid "54660c3e-992b-5e27-be9c-0956611293ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-4,-1]" :db/id #edb/ref 17592186717823} {:answer/id #uuid "a9f16bbd-0473-546c-950b-9e19efcad4c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-3,3]" :db/id #edb/ref 17592186717834} {:answer/id #uuid "f3ddc30f-fe36-5859-bc4f-01b83536e124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-\\frac{11}{2},-\\frac{5}{2}]" :db/id #edb/ref 17592186717843}] :answer-field/correct {:answer/id #uuid "15702475-5807-55e6-819f-3a3f1bb63cf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in[-7,-1]" :db/id #edb/ref 17592186717815} :answer-field/id #uuid "35f6753c-2f74-5487-a04f-b0002ad592ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717818}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4055c52f-56f2-5a1d-8f85-6f7a06f50c46" :question/problem "Find the range of $f(x)=-