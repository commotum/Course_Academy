-fields [{:answer-field/choices [{:answer/id #uuid "1db175ad-694b-5bb9-959a-3d6e0b2057a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\pi }{5}" :db/id #edb/ref 17592186327192} {:answer/id #uuid "287568e1-57a3-5493-8522-6c1936081561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186327277} {:answer/id #uuid "6b8dcb34-da39-5684-9e5c-886c63a6cb4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186327859} {:answer/id #uuid "6bcad715-2c41-5c6c-a271-14ddd1312559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186327863} {:answer/id #uuid "94944c92-3dbf-5f11-9056-1700eb82c373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186328233}] :answer-field/correct {:answer/id #uuid "1db175ad-694b-5bb9-959a-3d6e0b2057a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\pi }{5}" :db/id #edb/ref 17592186327192} :answer-field/id #uuid "e2a75f1b-46ee-5473-b6c7-6d7a730ef92a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329577}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4126b1b4-8e8d-506d-b0ce-d7e1e1256bf6" :question/math-academy-id "q-43404" :question/problem "Calculate the period of the function $$\n\\displaystyle f(x)=\\frac{1}{6}\\operatorname{sin}⁡(\\frac{5x}{3}-\\frac{\\pi }{2}).\n$$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{sin}⁡(Bx+C)+D,$ the period $T$ is given by $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{5}{3}.$ Therefore, the period is $$\n\\displaystyle \\frac{2\\pi }{\\left(\\frac{5}{3}\\right)}=\\frac{6\\pi }{5}.\n$$"}] [{:db/id #edb/ref 17592186129817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8df7410f-c004-5fdc-8775-8ae956245c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}π" :db/id #edb/ref 17592186128384} {:answer/id #uuid "c26a5f91-454c-5d0b-b99c-3ffa6db0e095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3π" :db/id #edb/ref 17592186128385} {:answer/id #uuid "fb095275-19d1-5778-9232-aa71d9f1a890" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "π" :db/id #edb/ref 17592186128386} {:answer/id #uuid "39937636-fe2a-507d-9af7-f505086060de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2π" :db/id #edb/ref 17592186128387} {:answer/id #uuid "78edb559-cb2f-5d0d-be91-0a49601aa637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6π" :db/id #edb/ref 17592186128388}] :answer-field/id #uuid "fcd88061-9c0f-538f-9503-8d54e8dc89ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128383}] :question/id #uuid "e1939ec4-08c8-5e9a-b224-be207716cfa8" :question/math-academy-id "q-53457" :question/problem "Calculate the period of the function $y = \\frac{1}{2}\\cos (\\frac{1}{3}x)$."}] [{:db/id #edb/ref 17592186233245 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "77e5cfb9-2245-53c5-a15b-0c6488ea21f2" :question/math-academy-id "q-117568" :question/problem "What is the amplitude of the function $f(x)=\\frac{3}{2}\\operatorname{cos}(2x-1)?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=\\frac{3}{2},$ we have that the amplitude is $|A|=|\\frac{3}{2}|=\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186233246 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da12d3f2-5ddd-5fcc-9597-5632a2ead5f3" :question/math-academy-id "q-117575" :question/problem "What is the amplitude of the function $f(x)=-5\\operatorname{sin}(3x-\\pi )-3?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{sin}(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=-5,$ we have that the amplitude is $|A|=|-5|=5.$"}] [{:db/id #edb/ref 17592186233247 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2af4088-8783-5a40-8f00-4eee6fee36d7" :question/math-academy-id "q-117580" :question/problem "Calculate the period of the function $y=\\operatorname{cos}(12x-\\frac{\\pi }{6}).$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=12.$ Therefore, the period is $\\frac{2\\pi }{12}=\\frac{\\pi }{6}.$"}] [{:db/id #edb/ref 17592186233248 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7b1e99d2-4571-5eb0-b1cd-3cfd5a30a159" :question/math-academy-id "q-117583" :question/problem "What is the period of the function $f(x)=\\operatorname{sin}(\\frac{8x}{3}+{20}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}(Bx+C)+D,$ the period is $\\frac{{360}^{∘}}{B}.$\n\nIn our case, we have that $B=\\frac{8}{3}.$ Therefore, the period is $$\n\\displaystyle \\frac{{360}^{∘}}{\\left(\\frac{8}{3}\\right)}={135}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186233657 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c0ba785-82d4-51d4-ba62-9a6ddfc19813" :question/math-academy-id "q-236892" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $0$ and a maximum value of $4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{0+4}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"}] [{:db/id #edb/ref 17592186233658 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e065fd0c-2f57-53e6-b566-95ea17332857" :question/math-academy-id "q-236903" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-14$ and a maximum value of $-4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-14+(-4)}{2} \\\\  & =\\frac{-18}{2} \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-9.$"}] [{:db/id #edb/ref 17592186233683 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "efc3b489-6805-58cd-9ffd-9dce88f3406c" :question/math-academy-id "q-25512" :question/problem "Find the range of the function $f(x)=-2\\operatorname{sin}(3x)+1.$" :question/worked-solution "The range of $\\operatorname{sin}x$ is\n\n$$\n-1\\le \\operatorname{sin}x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}(3x)\\le 1.\n$$\n\nMultiplying the above inequality by $-2$ and then adding $1$, we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}(3x)\\le 1 \\\\  & 2\\ge -2\\operatorname{sin}(2x)\\ge -2 \\\\  & 3\\ge -2\\operatorname{sin}(2x)+1\\ge -1 \\\\  & -1\\le f(x)\\le 3.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-1,3].$"}] [{:db/id #edb/ref 17592186234034 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35cc2bef-7c45-5174-b681-8a4353622923" :question/math-academy-id "q-40908" :question/problem "What is the range of the function $f(x)=4\\operatorname{sin}(x+{30}^{∘})-2?$" :question/worked-solution "The range of $\\operatorname{sin}x$ is\n\n$$\n-1\\le \\operatorname{sin}x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}(x+{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $4$ and then subtracting $2,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}(x+{30}^{∘})\\le 1 \\\\  & -4\\le 4\\operatorname{sin}(x+{30}^{∘})\\le 4 \\\\  & -6\\le 4\\operatorname{sin}(x+{30}^{∘})-2\\le 2 \\\\  & -6\\le f(x)\\le 2.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-6,2].$"}] [{:db/id #edb/ref 17592186238052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bee8a09-1b10-5d3b-a3e0-53f487269fbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in (-4,0)" :db/id #edb/ref 17592186236092} {:answer/id #uuid "3ae5f17b-6d77-50aa-9f3e-7b11978d9ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-4,0]" :db/id #edb/ref 17592186236187} {:answer/id #uuid "6e51c3bd-ccb5-5657-a12f-be75f9b7421d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in (-4,0]" :db/id #edb/ref 17592186236517} {:answer/id #uuid "8af5fbbe-fd48-522b-bd11-fcef14c27e77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-4,0)" :db/id #edb/ref 17592186236685} {:answer/id #uuid "c5deb01d-4513-5f86-8831-7f209ca52bc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186237069}] :answer-field/correct {:answer/id #uuid "3ae5f17b-6d77-50aa-9f3e-7b11978d9ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-4,0]" :db/id #edb/ref 17592186236187} :answer-field/id #uuid "823dc40d-4f4d-5208-b833-113087963ad8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237612}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9b3308de-6d92-5bb6-a7a9-50e3ea31e7e7" :question/math-academy-id "q-10379" :question/problem "Find the range of the function $y=2\\operatorname{cos}⁡(4x)-2.$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(4x)\\le 1.\n$$\n\nMultiplying the above inequality by $2$ and then subtracting $2,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{cos}⁡(4x)\\le 1 \\\\  & -2\\le 2\\operatorname{cos}⁡(4x)\\le 2 \\\\  & -4\\le 2\\operatorname{cos}⁡(4x)-2\\le 0 \\\\  & -4\\le y\\le 0.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [-4,0].$"}] [{:db/id #edb/ref 17592186253364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43205661-f460-56f1-adb1-c7d5bd58eadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186251116} {:answer/id #uuid "72935ca7-a8c2-5ce6-aa26-184f0bd6b12c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186251495} {:answer/id #uuid "ac96fb00-96df-5ad0-90c8-7963646933e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 1759218625205