                                  \n                                \n                                    \n                                        \n$m\\,=\\,$\n\n                                    \n                                \n                                    \n                            \n{{field-1}}" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(3,-2)$ and $({x}_{2},{y}_{2})=(1,4),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-(-2)}{1-3} \\\\  & =\\frac{6}{-2} \\\\  & =-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d02e444-7565-5de9-a078-504b2191fcd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186490624} {:answer/id #uuid "902f202c-a83c-5fd8-9fbf-f740c2241181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186490802} {:answer/id #uuid "ada2b6cc-8e62-59e3-9964-b9408db65b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490856} {:answer/id #uuid "e9b48d10-0c79-5e16-b619-e90a392edcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186490954} {:answer/id #uuid "fce35e1b-eeb8-5c7a-8c3c-c04d0f68ee8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186490990}] :answer-field/correct {:answer/id #uuid "fce35e1b-eeb8-5c7a-8c3c-c04d0f68ee8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186490990} :answer-field/id #uuid "09a3abf4-2ea3-5b6b-beac-3b3760d7c5cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491004}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "07e2ee89-2122-51d1-b017-410fc7074e1d" :question/math-academy-id "q-44612" :question/problem "Calculate the slope of the line that passes through the points $(-2,-4)$ and $(-8,-6).$" :question/worked-solution "We let $({x}_{1},{y}_{1})=(-2,-4)$ and $({x}_{2},{y}_{2})=(-8,-6),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-6-(-4)}{-8-(-2)} \\\\  & =\\frac{-2}{-6} \\\\  & =\\frac{1}{3}\\end{aligned}\\end{aligned}\n$$\n\nThus, the slope is $m=\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186491125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02420fbe-3c97-56a5-b26e-c4b3420da8ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186490514} {:answer/id #uuid "4e3c669b-fd16-507a-8753-c9a78a89b458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The slope is undefined" :db/id #edb/ref 17592186490661} {:answer/id #uuid "830b8338-c9a8-50f5-84b5-3b0ebf331f16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490774} {:answer/id #uuid "af521050-df45-5b93-9d69-6f7e64cf6c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186490858} {:answer/id #uuid "e076817c-79b0-5d75-9117-a1ace3095de2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186490935}] :answer-field/correct {:answer/id #uuid "af521050-df45-5b93-9d69-6f7e64cf6c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186490858} 