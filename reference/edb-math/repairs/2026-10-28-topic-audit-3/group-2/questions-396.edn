er.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186490679} :answer-field/id #uuid "c81a4e80-6d0f-54c9-a9b1-a145d88b8558" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491083}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2aed86e1-b290-5c0a-9731-7ce89e296450" :question/math-academy-id "q-12633" :question/problem "What is the slope of a line that passes through the points $(0,3)$ and $(5,6)?$" :question/worked-solution "We let $({x}_{1},{y}_{1})=(0,3)$ and $({x}_{2},{y}_{2})=(5,6),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{6-3}{5-0} \\\\  & =\\frac{3}{5}\\end{aligned}\\end{aligned}\n$$\n\nThus, the slope is $m=\\frac{3}{5}.$"}] [{:db/id #edb/ref 17592186491141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104d41c3-0e85-52e1-9ce5-444595605652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186490543} {:answer/id #uuid "4f3bc186-d96f-5413-afa5-401d93963056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186490663} {:answer/id #uuid "8f66d13c-71b8-57c5-923e-237f1dcc96ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186490800} {:answer/id #uuid "c534aa13-e3d3-5556-960f-588b6885f1a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186490890} {:answer/id #uuid "f2e31773-4151-5e13-b6f5-e20c2e64929c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186490975}] :answer-field/correct {:answer/id #uuid "8f66d13c-71b8-57c5-923e-237f1dcc96ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186490800} :answer-field/id #uuid "61012383-9b90-523d-b36d-7d0e995b871e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "46266ffe-395d-5bff-927f-737b6f2fbdfc" :question/math-academy-id "q-26714" :question/problem "![](images/10/10f79e3e129891e51ee47ecd595ab666053cd048688c4a63e8f7edd66cdae6da.png)\n\nGiven that the line above passes through the point $(-4,-1)$ and intersects the $x$-axis when $x=4,$ find the slope of the line." :question/worked-solution "Note that the line passes through the points $(-4,-1)$ and $(4,0).$ So, we let $({x}_{1},{y}_{1})=(-4,-1)$ and $({x}_{2},{y}_{2})=(4,0),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-(-1)}{4-(-4)} \\\\  & =\\frac{1}{8}\\end{aligned}\n$$\n\nTherefore, the slope of the line is $m=\\frac{1}{8}.$"}] [{:db/id #edb/ref 17592186491143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "842ac371-2eeb-5148-8ae5-f593956e4698" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186490779} {:answer/id #uuid "8e1719d7-b4ab-5927-a94f-934e56782bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Zero" :db/id #edb/ref 17592186490795} {:answer/id #uuid "9c97bf79-0d82-5511-9989-907c444ecd74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Positive" :db/id #edb/ref 17592186490834} {:answer/id #uuid "ad5c83d4-ee9d-5dea-bfb8-e87d6918b756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information" :db/id #edb/ref 17592186490854} {:answer/id #uuid "c