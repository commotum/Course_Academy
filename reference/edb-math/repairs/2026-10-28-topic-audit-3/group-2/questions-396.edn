uid "4b675aa5-7ca8-5a20-8b98-50a672fad62c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{5}" :db/id #edb/ref 17592186494469} {:answer/id #uuid "6c973c76-cd0c-5576-8885-0c465bab546c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186494541} {:answer/id #uuid "b734c1fc-7b80-5cc1-bb58-37307d83cd9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{7}" :db/id #edb/ref 17592186494745} {:answer/id #uuid "b78ba8a4-7052-5d26-92c7-8724b2179bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186494746} {:answer/id #uuid "e729bea2-1620-507c-a9ae-744cc39dcf39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186494865}] :answer-field/correct {:answer/id #uuid "b734c1fc-7b80-5cc1-bb58-37307d83cd9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{7}" :db/id #edb/ref 17592186494745} :answer-field/id #uuid "c796a5cc-7470-555e-8c4a-e7fb39dc2c3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495010}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e554ee9f-50e5-5692-8b77-359b451c2bbf" :question/math-academy-id "q-26721" :question/problem "![](images/20/2026a71a7cb647e7a5d844e9c5259f73321d7fd8097255245dc99f87dfc60a92.png)\n\nThe straight line shown above intersects the $y$-axis when $y=5$ and intersects the $x$-axis when $x=7.$ Find its slope." :question/worked-solution "Note that the line passes through the points $(0,5)$ and $(7,0).$ So, we let $({x}_{1},{y}_{1})=(0,5)$ and $({x}_{2},{y}_{2})=(7,0),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-5}{7-0} \\\\  & =\\frac{-5}{7} \\\\  & =-\\frac{5}{7}\\end{aligned}\n$$\n\nTherefore, the slope of the line is $-\\frac{5}{7}.$"}] [{:db/id #edb/ref 17592186503744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c58c900-8ec1-5326-9ef6-6af62d605164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186503093}] :answer-field/correct {:answer/id #uuid "3c58c900-8ec1-5326-9ef6-6af62d605164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186503093} :answer-field/id #uuid "cb014479-3c70-5164-8727-0d40fa526e4e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503616}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d59c0884-c058-5785-9ee6-42436f91acb4" :question/math-academy-id "q-166754" :question/problem "The slope of the line is $m\\,=\\,${{field-1}}." :question/worked-solution "Note that the line passes through the points $(0,960)$ and $(16,0).$ So, we let $({x}_{1},{y}_{1})=(0,960)$ and $({x}_{2},{y}_{2})=(16,0),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-960}{16-0} \\\\  & =\\frac{-960}{16} \\\\  & =-60\\end{aligned}\n$$\n\nTherefore, the slope of the line is $m=-60.$"}] [{:db/id #edb/ref 17592186518135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc78b909-0880-5440-888c-d28056945b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186517844}] :answer-field/correct {:answer/id #uuid "bc78b909-0880-5440-888c-d28056945b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186517844} :answer-field/id #uuid "e63b5122-3053-56d2-9da4-5e85f3949a91" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518083}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5064a9ef-4f8e-5fbe-8d7d-2164ebe22645" :question/math-academy-id "q-131252" :question/problem "${f}^{″}(4)=${{field-1}}" :question/worked-solution "Recall that\n\n$$\n{f}^{″}(x)=({f}^{′}(x))^{′}.\n$$\n\n \n\nNotice that $4\\in [3,6],$ where the graph of $y={f}^{′}(x)$ is represented by a straight line segment. So, ${f}^{″}(4)$ is just the slope of this segment.\n\nSince this segment passes through the points $({x}_{1},{y}_{1})=(3,0)$ and $({x}_{2},{y}_{2})=(6,-4),$ we can compute its slope as follows:\n\n$$\n\\begin{aligned}\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} & =\\frac{-4-0}{6-3} \\\\  & =\\frac{-4}{3} \\\\  & =-\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, ${f}^{″}(4)=-\\frac{4}{3}.$"}] [{:db/id #edb/ref 17592186524019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be143ce-02c5-529c-91e7-30b4b109ab46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186523342}] :answer-field/correct {:answer/id #uuid "2be143ce-02c5-529c-91e7-30b4b109ab46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186523342} :answer-field/id #uuid "2740cd2d-d984-544c-8909-67c29a2952fd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523807}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "db023775-f57a-5eec-8870-ad9e9767c00a" :question/math-academy-id "q-167070" :question/problem "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(-2,3)$ and $({x}_{2},{y}_{2})=(4,1),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-3}{4-(-2)} \\\\  & =\\frac{-2}{6} \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f478c66-e19e-5b0e-988a-f1798fa62614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186536448}] :answer-field/correct {:answer/id #uuid "5f478c66-e19e-5b0e-988a-f1798fa62614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186536448} :answer-field/id #uuid "d7a1716a-c549-52bd-a06d-10dc75251cb9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536791}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d3a5d6c-af68-5a0e-b08b-800ce9329d6f" :question/math-academy-id "q-129769" :question/problem "Find the value of ${f}^{′}(0).$\n\n${f}^{′}(0)\\,=\\,$\n{{field-1}}" :question/worked-solution "Recall that ${f}^{′}(0)$ is just the slope of the tangent line to the graph of $y=f(x)$ at the point where $x=0.$\n\nNotice that our tangent line passes through the points $({x}_{1},{y}_{1})=(4,0)$ and $({x}_{2},{y}_{2})=(0,2).$ Therefore, we can compute its slope as follows:\n\n$$\n\\begin{aligned}\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} & =\\frac{2-0}{0-4} \\\\  & =\\frac{2}{-4} \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(0)=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186551293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186551042}] :answer-field/correct {:answer/id #uuid "fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186551042} :answer-field/id #uuid "bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551179}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/math-academy-id "q-167100" :question/problem "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-(-3)}{1-4} \\\\  & =\\frac{6}{-3} \\\\  & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186599803 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c871c94-70a3-513b-add9-51d3c3542c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186599357}] :answer-field/correct {:answer/id #uuid "0c871c94-70a3-513b-add9-51d3c3542c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186599357} :answer-field/id #uuid "20abc47f-055b-5250-99fe-6e175cbf7785" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186599687}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "796d08db-8321-55dc-9554-4cd443856c16" :question/math-academy-id "q-167821" :question/problem "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(1,-4)$ and $({x}_{2},{y}_{2})=(3,2),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-4-2}{1-3} \\\\  & =\\frac{-6}{-2} \\\\  & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186615386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa5e90f6-ee37-5264-a92b-8d37023ec256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186615189}] :answer-field/correct {:answer/id #uuid "fa5e90f6-ee37-5264-a92b-8d37023ec256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186615189} :answer-field/id #uuid "2b4c8171-fea0-56fc-9b00-7ccd8d109900" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186615226}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a24b345-b2f1-5195-a0f4-d08d3f24b3cd" :question/math-academy-id "q-135284" :question/problem "The slope of the line is $m\\,=\\,${{field-1}}." :question/worked-solution "Note that the line passes through the points $(0,960)$ and $(16,0).$ So, we let $({x}_{1},{y}_{1})=(0,960)$ and $({x}_{2},{y}_{2})=(16,0),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-960}{16-0} \\\\  & =\\frac{-960}{16} \\\\  & =-60\\end{aligned}\n$$\n\nTherefore, the slope of the line is $m=-60.$"}]}
