86045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{cos}⁡t" :db/id #edb/ref 17592186273355} :answer-field/id #uuid "9d9a02e6-9233-504e-ac0e-73a7b2aaaed8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274910}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d820f8e1-5858-5b82-b3dd-c312fda5c92f" :question/math-academy-id "q-149688" :question/problem "The closed curve $C$ is defined as $r(t)=9\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j$ for $t\\in [0,2\\pi ).$ The outward-pointing unit normal vector for $C$ can be expressed as\n\n$$\nn=\\frac{a(t)\\,i+b(t)\\,j}{||{r}^{′}(t)||}.\n$$\n\nFind the function $b(t).$\n\n*Hint: Observe that $C$ is traversed clockwise.*" :question/worked-solution "For convenience, we express $r(t)$ in column vector notation:\n\n$$\nr(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\begin{bmatrix}9\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{bmatrix}\n$$\n\nTo calculate the outward normal vector of a closed, *negatively* oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${r}^{′}(t).$\n\nDifferentiating the expression for $r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\begin{bmatrix}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{bmatrix}=\\begin{bmatrix}9\\operatorname{cos}⁡t \\\\ -4\\operatorname{sin}⁡t\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented clockwise, we rotate ${r}^{′}(t)$ by ${90}^{∘}$ *counterclockwise* to obtain an outward normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ counterclockwise rotation is\n\n$$\n\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nRotating the vector ${r}^{′}(t)$ by ${90}^{∘}$ counterclockwise, we get\n\n$$\n\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}9\\operatorname{cos}⁡t \\\\ -4\\operatorname{sin}⁡t\\end{bmatrix}=\\begin{bmatrix}4\\operatorname{sin}⁡t \\\\ 9\\operatorname{cos}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${r}^{′}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}\\begin{bmatrix}4\\operatorname{sin}⁡t \\\\ 9\\operatorname{cos}⁡t\\end{bmatrix}=\\frac{4\\operatorname{sin}⁡t\\,i+9\\operatorname{cos}⁡t\\,j}{||{r}^{′}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $b(t)=9\\operatorname{cos}⁡t.$"}] [{:db/id #edb/ref 17592186362489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71948d5e-02be-51dc-b11c-503e671f7d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x/3" :db/id #edb/ref 17592186362491}] :answer-field/correct {:answer/id #uuid "71948d5e-02be-51dc-b11c-503e671f7d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x/3" :db/id #edb/ref 17592186362491} :answer-field/id #uuid "1b017a4d-e67e-5487-80c5-eb76509d584e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362490} {:answer-field/choices [{:answer/id #uuid "307fd8a5-abeb-553b-a401-f90d8d28581a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362493}] :answer-field/correct {:answer/id #uuid "307fd8a5-abeb-553b-a401-f90d8d28581a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362493} :answer-field/id #uuid "d2a44b4a-6420-526a-8932-c62fb58e471c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362492} {:answer-field/choices [{:answer/id #uuid "220d31f3-2b87-5137-986e-02a43c004603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y/3" :db/id #edb/ref 17592186362495}] :answer-field/correct {:answer/id #uuid "220d31f3-2b87-5137-986e-02a43c004603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y/3" :db/id #edb/ref 17592186362495} :answer-field/id #uuid "fb8df416-9cb6-541c-aa33-a5474ab16ffe" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ed75dd18-34d6-5d52-a9e6-519946daa110" :question/math-academy-id "q-167888" :question/problem "A heating element $E$ lies on the intersection of the cylindrical heater and the plane $z=2.$ Use your answer to part 4 to find an outward-pointing unit normal vector $n(x,y)$ to $E$ that lies within this plane. Express your answer in terms of $x$ and $y.$\n\n*Hint: The matrix ${R}_{z}(ϕ)$ representing a counterclockwise rotation of $ϕ$ radians about the $z$-axis is given by*\n\n$$\n{R}_{z}(ϕ)=\\begin{bmatrix}\\operatorname{cos}⁡ϕ & -\\operatorname{sin}⁡ϕ & 0 \\\\ \\operatorname{sin}⁡ϕ & \\operatorname{cos}⁡ϕ & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n$n(x,y)=\\,$\n\n                                    \n                                \n                                    \n                            \n{{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,i+\\,$\n\n                                    \n                                \n                                    \n                            \n{{field-2}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,j\\,+$\n\n                                    \n                                \n                                    \n                            \n{{field-3}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,k$" :question/worked-solution "We found that a parametrization of the cylinder is given by\n\n$$\nf(\\theta ,z)=⟨3\\operatorname{cos}⁡\\theta ,3\\operatorname{sin}⁡\\theta ,z⟩\\,(\\theta ,z)\\in C.\n$$\n\nRestricting the parametrization of the cylinder to $z=2,$ we get a parametrization $r(\\theta )$ for the heating element:\n\n$$\nr(\\theta )=f(\\theta ,2)=⟨3\\operatorname{cos}⁡\\theta ,3\\operatorname{sin}⁡\\theta ,2⟩\n$$\n\nFor convenience, we express $r(\\theta )$ in column vector column:\n\n$$\nr(\\theta )=\\begin{bmatrix}x(\\theta ) \\\\ y(\\theta ) \\\\ z(\\theta )\\end{bmatrix}=\\begin{bmatrix}3\\operatorname{cos}⁡\\theta  \\\\ 3\\operatorname{sin}⁡\\theta  \\\\ 2\\end{bmatrix}\n$$\n\n \nNotice that this curve is traversed *counterclockwise* when viewed from above.\n\nTo calculate the outward-pointing unit normal vector to this curve, we follow three steps:\n\n**Step 1:** We compute the tangent vector ${r}^{′}(\\theta ).$\n\nDifferentiating the expression for $r(\\theta ),$ we get\n\n$$\n{r}^{′}(\\theta )=\\begin{bmatrix}{x}^{′}(\\theta ) \\\\ {y}^{′}(\\theta ) \\\\ {z}^{′}(\\theta )\\end{bmatrix}=\\begin{bmatrix}-3\\operatorname{sin}⁡\\theta  \\\\ 3\\operatorname{cos}⁡\\theta  \\\\ 0\\end{bmatrix}.\n$$\n\n**Step 2:** Since $C$ is traversed counterclockwise, we rotate ${r}^{′}(\\theta )$ by $\\frac{\\pi }{2}$ radians clockwise $(ϕ=-\\frac{\\pi }{2})$ to obtain an outward-pointing normal vector.\n\nUsing the hint, the rotation matrix corresponding to a $ϕ=-\\frac{\\pi }{2}$ counterclockwise rotation about the $z$-axis is\n\n$$\n{R}_{z}(\\theta )=\\begin{bmatrix}0 & 1 & 0 \\\\ -1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$\n\nRotating the vector ${r}^{′}(\\theta )$ by $-\\frac{\\pi }{2}$ counterclockwise, we get\n\n$$\n\\overset{~}{n}=\\begin{bmatrix}0 & 1 & 0 \\\\ -1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-3\\operatorname{sin}⁡\\theta  \\\\ 3\\operatorname{cos}⁡\\theta  \\\\ 0\\end{bmatrix}=\\begin{bmatrix}3\\operatorname{cos}⁡\\theta  \\\\ 3\\operatorname{sin}⁡\\theta  \\\\ 0\\end{bmatrix}\n$$\n\n**Step 3:** Finally, we normalize the vector found in Step 2:\n\n$$\n\\begin{aligned}||\\overset{~}{n}|| & =\\sqrt{(3\\operatorname{cos}⁡\\theta )^{2}+(3\\operatorname{sin}⁡\\theta )^{2}+{0}^{2}} \\\\  & =\\sqrt{9({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{||\\overset{~}{n}||} \\\\  & =\\frac{1}{3}\\begin{bmatrix}3\\operatorname{cos}⁡\\theta  \\\\ 3\\operatorname{sin}⁡\\theta  \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}x(\\theta ) \\\\ y(\\theta ) \\\\ 0\\end{bmatrix} \\\\  & =\\frac{x}{3}\\,i+\\frac{y}{3}\\,j+0\\,k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70efccd7-a4ec-51be-bc8c-eb43d5f222fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186387756} {:answer/id #uuid "96372565-ba69-5c28-8a4c-9b6fe589c9f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}-x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186387757} {:answer/id #uuid "3ae2f33e-2d17-55f9-a4c0-3b66e6a17f71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4x \\\\ 4y\\end{bmatrix}" :db/id #edb/ref 17592186387758} {:answer/id #uuid "9c0546af-1dba-55cb-8fd2-f11d650496c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186387759} {:answer/id #uuid "7b433770-bc6f-5296-8bf1-d6c00fb0124d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}y \\\\ -x\\end{bmatrix}" :db/id #edb/ref 17592186387760}] :answer-field/correct {:answer/id #uuid "70efccd7-a4ec-51be-bc8c-eb43d5f222fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186387756} :answer-field/id #uuid "95039db2-a6d4-5d92-b575-f7c5188c2109" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387755}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "568e518b-6dee-5582-961d-6548648b3418" :question/math-academy-id "q-126918" :question/problem "The closed curve $C$ is defined as ${x}^{2}+{y}^{2}=16.$ Find the outward-pointing unit normal vector on $C.$" :question/worked-solution "We can parameterize $C$ as follows:\n\n$$\nr(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\begin{bmatrix}4\\operatorname{cos}⁡t \\\\ 4\\operatorname{sin}⁡t\\end{bmatrix},\\,t\\in [0,2\\pi )\n$$\n\nTo calculate the outward-pointing normal vector of a closed, positively oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${r}^{′}(t).$\n\nDifferentiating the expression for $r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\begin{bmatrix}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{bmatrix}=\\begin{bmatrix}-4\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented counterclockwise, we rotate ${r}^{′}(t)$ by ${90}^{∘}$ *clockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ clockwise rotation is\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\n$$\n\nRotating the vector ${r}^{′}(t)$ by ${90}^{∘}$ clockwise, we get\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}-4\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{bmatrix}=\\begin{bmatrix}4\\operatorname{cos}⁡t \\\\ 4\\operatorname{sin}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${r}^{′}(t)$ (since they differ only by a rotation).\n\nNow, since \n\n$$\n||{r}^{′}(t)||=\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(4\\operatorname{cos}⁡t)^{2}}=4,\n$$\n\nand since for our curve $x(t)=4\\operatorname{cos}⁡t$ and $y(t)=4\\operatorname{sin}⁡t,$ it follows that\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}\\begin{bmatrix}4\\operatorname{cos}⁡t \\\\ 4\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}4\\operatorname{cos}⁡t \\\\ 4\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f3fadd5-40a4-54fd-9df7-8c9527e439eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}y \\\\ -x\\end{bmatrix}" :db/id #edb/ref 17592186388934} {:answer/id #uuid "d624fdfa-6c18-5c32-9f83-6d774d9afeed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{7}}\\begin{bmatrix}-x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186388935} {:answer/id #uuid "b49d27a8-69ed-556a-b313-79132cf2bc07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\begin{bmatrix}x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186388936} {:answer/id #uuid "af39217a-9741-57f5-a8af-aad29611cfab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{7}}\\begin{bmatrix}x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186388937} {:answer/id #uuid "b73f5a3b-756e-5218-8d30-c5f269f48922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186388938}] :answer-field/correct {:answer/id #uuid "af39217a-9741-57f5-a8af-aad29611cfab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{7}}\\begin{bmatrix}x \\\\ y\\end{bmatrix}" :db/id #edb/ref 17592186388937} :answer-field/id #uuid "ef20f3c6-4187-5468-a4ad-e478b5888820" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388933}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c996f89f-de6d-5978-856b-5758e6e8d01b" :question/math-academy-id "q-149682" :question/problem "The closed curve $C$ is defined as ${x}^{2}+{y}^{2}=7.$ Find the outward-pointing unit normal vector on $C.$" :question/worked-solution "We can parameterize $C$ as follows:\n\n$$\nr(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\begin{bmatrix}\\sqrt{7}\\operatorname{cos}⁡t \\\\ \\sqrt{7}\\operatorname{sin}⁡t\\end{bmatrix},\\,t\\in [0,2\\pi )\n$$\n\nTo calculate the outward-pointing normal vector of a closed, positively oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${r}^{′}(t).$\n\nDifferentiating the expression for $r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\begin{bmatrix}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{bmatrix}=\\begin{bmatrix}-\\sqrt{7}\\operatorname{sin}⁡t \\\\ \\sqrt{7}\\operatorname{cos}⁡t\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented counterclockwise, we rotate ${r}^{′}(t)$ by ${90}^{∘}$ *clockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ clockwise rotation is\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\n$$\n\nRotating the vector ${r}^{′}(t)$ by ${90}^{∘}$ clockwise, we get\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}-\\sqrt{7}\\operatorname{sin}⁡t \\\\ \\sqrt{7}\\operatorname{cos}⁡t\\end{bmatrix}=\\begin{bmatrix}\\sqrt{7}\\operatorname{cos}⁡t \\\\ \\sqrt{7}\\operatorname{sin}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${r}^{′}(t)$ (since they differ only by a rotation).\n\nNow, since \n\n$$\n||{r}^{′}(t)||=\\sqrt{(-\\sqrt{7}\\operatorname{sin}⁡t)^{2}+(\\sqrt{7}\\operatorname{cos}⁡t)^{2}}=\\sqrt{7},\n$$\n\nand since for our curve $x(t)=\\sqrt{7}\\operatorname{cos}⁡t$ and $y(t)=\\sqrt{7}\\operatorname{sin}⁡t,$ it follows that\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}\\begin{bmatrix}\\sqrt{7}\\operatorname{cos}⁡t \\\\ \\sqrt{7}\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{7}}\\begin{bmatrix}\\sqrt{7}\\operatorname{cos}⁡t \\\\ \\sqrt{7}\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{7}}\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186420301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4273bc0b-c236-5aef-b7ab-73105db3d922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10\\operatorname{cos}⁡t" :db/id #edb/ref 17592186420283} {:answer/id #uuid "77b52dfd-4977-5787-b514-fbe4937870e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\operatorname{sin}⁡t" :db/id #edb/ref 17592186420289} {:answer/id #uuid "a164f912-bf55-5a5b-ae4c-d8d627540a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10\\operatorname{sin}⁡t" :db/id #edb/ref 17592186420291} {:answer/id #uuid "d905a5f3-7922-5213-884e-760e5bcf3649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{cos}⁡t" :db/id #edb/ref 17592186420293} {:answer/id #uuid "f0b60cba-f8e0-5442-8c96-6db838819306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{sin}⁡t" :db/id #edb/ref 17592186420294}] :answer-field/correct {:answer/id #uuid "d905a5f3-7922-5213-884e-760e5bcf3649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{cos}⁡t" :db/id #edb/ref 17592186420293} :answer-field/id #uuid "6d5ad3f1-9a81-57d1-9a87-dc11af7a74bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420300}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f0ef420-2cbc-5713-b114-6ede5820bdae" :question/math-academy-id "q-126924" :question/problem "The closed, positively oriented curve $C$ is defined as $r(t)=10\\operatorname{cos}⁡t\\,i+10\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$ The outward-pointing unit normal vector on $C$ can be expressed as\n\n$$\nn=\\frac{a(t)\\,i+b(t)\\,j}{||{r}^{′}(t)||}.\n$$\n\nFind the function $a(t).$" :question/worked-solution "For convenience, we express $r(t)$ in column vector notation:\n\n$$\nr(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\begin{bmatrix}10\\operatorname{cos}⁡t \\\\ 10\\operatorname{sin}⁡t\\end{bmatrix}\n$$\n\nTo calculate the outward-pointing normal vector of a closed, positively oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${r}^{′}(t).$\n\nDifferentiating the expression for $r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\begin{bmatrix}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{bmatrix}=\\begin{bmatrix}-10\\operatorname{sin}⁡t \\\\ 10\\operatorname{cos}⁡t\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented counterclockwise, we rotate ${r}^{′}(t)$ by ${90}^{∘}$ *clockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ clockwise rotation is\n\n$$\nR=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\n$$\n\nRotating the vector ${r}^{′}(t)$ by ${90}^{∘}$ clockwise, we get\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}-10\\operatorname{sin}⁡t \\\\ 10\\operatorname{cos}⁡t\\end{bmatrix}=\\begin{bmatrix}10\\operatorname{cos}⁡t \\\\ 10\\operatorname{sin}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${r}^{′}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}\\begin{bmatrix}10\\operatorname{cos}⁡t \\\\ 10\\operatorname{sin}⁡t\\end{bmatrix}=\\frac{10\\operatorname{cos}⁡t\\,i+10\\operatorname{sin}⁡t\\,j}{||{r}^{′}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $a(t)=10\\operatorname{cos}⁡t.$"}] [{:db/id #edb/ref 17592186420302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0437d5f4-9256-56dd-87fb-59350017483d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{cos}⁡t" :db/id #edb/ref 17592186420277} {:answer/id #uuid "16e038fe-7a43-52bb-9c39-90c0889e7847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10\\operatorname{cos}⁡t" :db/id #edb/ref 17592186420279} {:answer/id #uuid "439e9a02-8366-5fd0-88a4-aac15fafa034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{cos}⁡t" :db/id #edb/ref 17592186420284} {:answer/id #uuid "5e1f89cf-