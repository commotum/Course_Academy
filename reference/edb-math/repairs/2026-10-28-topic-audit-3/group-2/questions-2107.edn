t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{3 t^{2}}{2}\\right)\\,k \\\\  & =(2)\\,i+(2 t)\\,j+(3 t)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2)^2+(2 t)^2+(3 t)^2} \\\\  & =\\sqrt{13 t^{2} + 4}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{2 y + 2 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(2)[(t^{2})+\\left(\\frac{3 t^{2}}{2}\\right)]}{2 t} \\\\  & =\\frac{(5)t^2}{(2)t} \\\\  & =\\frac{5 t}{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{\\sqrt{2}}^{\\sqrt{3}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{\\sqrt{3}}\\left(\\frac{5 t}{2}\\right)(\\sqrt{13 t^{2} + 4})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=13 t^{2} + 4$, $\\text{d}u=(26 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{\\sqrt{3}}\\frac{5 t \\sqrt{13 t^{2} + 4}}{2}\\,\\text{d}t & ={\\int }_{30}^{43}\\sqrt{u}\\cdot \\frac{5}{52}\\,\\text{d}u \\\\  & =\\frac{5}{52}{\\int }_{30}^{43}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{5}{52}\\cdot\\frac{2}{3}u^{3/2}\\big|_{30}^{43} \\\\  & =\\frac{5}{78}[(43)^{3/2}-(30)^{3/2}] \\\\  & =\\frac{5}{78}[(43 \\sqrt{43})-(30 \\sqrt{30})] \\\\  & =\\left(\\frac{215 \\sqrt{43}}{78}\\right)-\\left(\\frac{25 \\sqrt{30}}{13}\\right) \\\\  & =- \\frac{25 \\sqrt{30}}{13} + \\frac{215 \\sqrt{43}}{78}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5117585f-11b3-58c4-a2ed-93bfe6a37773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536189} {:answer/id #uuid "83e9d980-388d-545d-aea1-9c61f2ded7ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}" :db/id #edb/ref 17592186536204} {:answer/id #uuid "89459d10-f9bc-56f1-8dfa-8495b9630dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{5}{2} + \\frac{\\sqrt{41}}{2}" :db/id #edb/ref 17592186536208} {:answer/id #uuid "8be88d4f-cace-5fd8-b578-2774c746c989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}" :db/id #edb/ref 17592186536209} {:answer/id #uuid "d0cf66d8-37ef-5803-bb94-f6ef1e86c800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1000}{3} + \\frac{328 \\sqrt{41}}{3}" :db/id #edb/ref 17592186536223}] :answer-field/correct {:answer/id #uuid "83e9d980-388d-545d-aea1-9c61f2ded7ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}" :db/id #edb/ref 17592186536204} :answer-field/id #uuid "f83931f4-8222-5091-a3ba-b17f6d5b10e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536240}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "660f6c2f-13cf-5ed3-95da-d564af1963e0" :question/problem "Evaluate the line integral of the function $f(x,y,z)=\\frac{6 y + 6 z}{x}$ along the curve parametrized by $r(t)=\\langle 3 t,t^{2},t^{2}\\rangle$ for $t\\in [\\sqrt{2},2].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 t)\\,i+(t^{2})\\,j+(t^{2})\\,k$, then along the curve we have $x=3 t$, $y=t^{2}$, $z=t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(3)\\,i+(2 t)\\,j+(2 t)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(3)^2+(2 t)^2+(2 t)^2} \\\\  & =\\sqrt{8 t^{2} + 9}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{6 y + 6 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(6)[(t^{2})+(t^{2})]}{3 t} \\\\  & =\\frac{(12)t^2}{(3)t} \\\\  & =4 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{\\sqrt{2}}^{2}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{2}(4 t)(\\sqrt{8 t^{2} + 9})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=8 t^{2} + 9$, $\\text{d}u=(16 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{2}4 t \\sqrt{8 t^{2} + 9}\\,\\text{d}t & ={\\int }_{25}^{41}\\sqrt{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{25}^{41}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot\\frac{2}{3}u^{3/2}\\big|_{25}^{41} \\\\  & =\\frac{1}{6}[(41)^{3/2}-(25)^{3/2}] \\\\  & =\\frac{1}{6}[(41 \\sqrt{41})-(125)] \\\\  & =\\left(\\frac{41 \\sqrt{41}}{6}\\right)-\\left(\\frac{125}{6}\\right) \\\\  & =- \\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c3f34f-1c70-50e1-b7bf-ff41e0ef0902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186536176} {:answer/id #uuid "6e1da80c-59bf-589c-a938-df19a1306cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{860}{3}" :db/id #edb/ref 17592186536200} {:answer/id #uuid "b9ed84e8-6f14-5594-a806-33a9e9aa364c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2280" :db/id #edb/ref 17592186536218} {:answer/id #uuid "d56a59cf-94dd-52d7-a8c9-3ae73263f82d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "285" :db/id #edb/ref 17592186536228} {:answer/id #uuid "f23229f8-4fcb-51b5-b69a-bfdcbeacb7c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186536239}] :answer-field/correct {:answer/id #uuid "d56a59cf-94dd-52d7-a8c9-3ae73263f82d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "285" :db/id #edb/ref 17592186536228} :answer-field/id #uuid "5f40dc3b-86d8-585e-98f4-9b2f3c029b58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536193}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc131f90-387e-54b0-bfab-a8eb22f2797f" :question/problem "Evaluate the line integral of the function $f(x,y)=10 y$ along the curve parametrized by $r(t)=\\langle t^{2},t\\rangle$ for $t\\in [0,2 \\sqrt{3}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t^{2})\\,i+(t)\\,j$, then along the curve we have $x=t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(2 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=10 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(10)(t) \\\\  & =10 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{2 \\sqrt{3}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{2 \\sqrt{3}}(10 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2 \\sqrt{3}}10 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{49}\\frac{5}{4}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{5}{4}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{49} \\\\  & =\\frac{5}{6}[(49)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{5}{6}[(343)-(1)] \\\\  & =\\left(\\frac{1715}{6}\\right)-\\left(\\frac{5}{6}\\right) \\\\  & =285\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c94afe4-cdcf-5f7f-ad7d-644f56ba78be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 \\sqrt{5}" :db/id #edb/ref 17592186536181} {:answer/id #uuid "6bcf5482-d032-5cb5-832a-7e160c6f0b28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{5} \\sin{\\left(\\frac{\\sqrt{3} \\sqrt{\\pi}}{6} \\right)}" :db/id #edb/ref 17592186536199} {:answer/id #uuid "7c80f3d4-abe2-593e-a0b6-9a8763440675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186536203} {:answer/id #uuid "8c2b1f95-0ba2-57cf-818a-fede800a91f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{5} \\left(-1 + \\frac{\\sqrt{3}}{2}\\right)" :db/id #edb/ref 17592186536210} {:answer/id #uuid "d4abf743-e772-522d-adfb-5c4592283ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{5}}{2}" :db/id #edb/ref 17592186536226}] :answer-field/correct {:answer/id #uuid "d4abf743-e772-522d-adfb-5c4592283ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{5}}{2}" :db/id #edb/ref 17592186536226} :answer-field/id #uuid "87810930-e74a-5f50-8241-46263ccebad7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536207}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c2ce718e-45c4-5f03-8361-b5c8663f79aa" :question/problem "Evaluate the line integral of the function $f(x,y)=3 \\cos{\\left(x \\right)}$ along the curve parametrized by $r(t)=\\langle 2 t^{2},- 4 t^{2}\\rangle$ for $t\\in [0,\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(2 t^{2})\\,i+(- 4 t^{2})\\,j$, then along the curve we have $x=2 t^{2}$, $y=- 4 t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(- 4 t^{2})\\,j \\\\  & =(4 t)\\,i+(- 8 t)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(4 t)^2+(- 8 t)^2} \\\\  & =\\sqrt{80 t^{2}} \\\\  & =4 \\sqrt{5}|t| \\\\  & =4 \\sqrt{5} t\\end{aligned}\n$$\n\nNotice that $|t|=t$ because $t\\geq0$ along the path of $C.$\n\nNow, since $f(x,y)=3 \\cos{\\left(x \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3 \\cos{\\left(2 t^{2} \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}}(3 \\cos{\\left(2 t^{2} \\right)})(4 \\sqrt{5} t)\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2 t^{2}$, $\\text{d}u=(4 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{\\sqrt{3} \\sqrt{\\pi}}{6}}12 \\sqrt{5} t \\cos{\\left(2 t^{2} \\right)}\\,\\text{d}t & ={\\int }_{0}^{\\frac{\\pi}{6}}3 \\sqrt{5}\\cdot \\cos u\\,\\text{d}u \\\\  & =3 \\sqrt{5}\\sin u\\big|_{0}^{\\frac{\\pi}{6}} \\\\  & =3 \\sqrt{5}[\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin(0)] \\\\  & =3 \\sqrt{5}[\\left(\\frac{1}{2}\\right)-(0)] \\\\  & =\\left(\\frac{3 \\sqrt{5}}{2}\\right)-(0) \\\\  & =\\frac{3 \\sqrt{5}}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32401b01-66d1-582d-8f93-fdd0495d51ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{992}{3}" :db/id #edb/ref 17592186536182} {:answer/id #uuid "8f7db02d-15e7-5e26-b9ba-c564c254f76d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536212} {:answer/id #uuid "9e8a9183-5730-550b-80d7-41a03b8fc3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186536213} {:answer/id #uuid "a6d9fc85-6374-5f2f-8f41-47ba6361411d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186536215} {:answer/id #uuid "d3d96dc4-fa03-5034-bac5-1b848d99d4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{124}{3}" :db/id #edb/ref 17592186536225}] :answer-field/correct {:answer/id #uuid "d3d96dc4-fa03-5034-bac5-1b848d99d4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{124}{3}" :db/id #edb/ref 17592186536225} :answer-field/id #uuid "ad468d44-fb68-5a19-a5ba-ce398186f0b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536216}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c45dcc44-5b16-5bcb-8c40-42484661e768" :question/problem "Evaluate the line integral of the function $f(x,y)=4 y$ along the curve parametrized by $r(t)=\\langle t^{2},t\\rangle$ for $t\\in [0,\\sqrt{6}].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t^{2})\\,i+(t)\\,j$, then along the curve we have $x=t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(2 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=4 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(4)(t) \\\\  & =4 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{6}}(4 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{6}}4 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{25}\\frac{1}{2}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{25} \\\\  & =\\frac{1}{3}[(25)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{1}{3}[(125)-(1)] \\\\  & =\\left(\\frac{125}{3}\\right)-\\left(\\frac{1}{3}\\right) \\\\  & =\\frac{124}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1da427-cfa7-5281-8204-d21535a2e929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{3}{2}}\\sqrt{4 t^{2} + 13} \\left(6 t^{3} - 24 t^{2} - 18 t - 3\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539136} {:answer/id #uuid "35771a76-e706-5927-92ab-462e6d1f85c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{3}{2}}6 t^{3} - 24 t^{2} - 18 t - 3\\,\\mathrm{d}t" :db/id #edb/ref 17592186539138} {:answer/id #uuid "3f2e2937-ae52-5040-b66a-a5c64838d0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{3}{2}}- 3 \\left(4 t^{2} + 13\\right) \\left(- 2 t^{3} + 8 t^{2} + 6 t + 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539142} {:answer/id #uuid "4a9e8407-ee17-513a-9905-7a045102dae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{3}{2}}3 \\sqrt{4 t^{2} + 13} \\left(t^{2} \\left(2 t + 1\\right) + \\left(3 t + 1\\right)^{2}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539147} {:answer/id #uuid "8353a5ce-5ec8-58d9-82a4-deeedafa3521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{3}{2}}\\frac{3 \\left(2 t^{3} - 8 t^{2} - 6 t - 1\\right)}{\\sqrt{4 t^{2} + 13}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539169}] :answer-field/correct {:answer/id #uuid "2f1da427-cfa7-5281-8204-d21535a2e929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{3}{2}}\\sqrt{4 t^{2} + 13} \\left(6 t^{3} - 24 t^{2} - 18 t - 3\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539136} :answer-field/id #uuid "5d63b3a0-c096-5219-817e-9b3bad04d2cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539153}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "021666da-2b39-563b-b7fb-5efa8b86fda8" :question/problem "Which of the following is equivalent to $$\n\\displaystyle \\int_C 3 x y - 3 z^{2}\\,\\mathrm{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=\\langle t^{2}, 2 t + 1, 3 t + 1\\rangle$ for $\\frac{1}{2}\\le t\\le \\frac{3}{2}$?" :question/worked-solution "Since $r(t)=\\langle t^{2}, 2 t + 1, 3 t + 1\\rangle,$ then along the curve we have $x=t^{2}$, $y=2 t + 1$, $z=3 t + 1$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 1)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 t + 1)k \\\\ &= (2 t)\\,i+(2)\\,j+(3)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\right)^2} \\\\ &= \\sqrt{(2 t)^2+(2)^2+(3)^2} \\\\ &= \\sqrt{4 t^{2} + 13}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=3 x y - 3 z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=3\\left((t^{2})(2 t + 1)-(3 t + 1)^2\\right) \\\\ &= 3\\left(2t^3+(1)t^2-\\left(9t^2+(6)t+1\\right)\\right) \\\\ &= 6 t^{3} - 24 t^{2} - 18 t - 3.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{\\frac{1}{2}}^{\\frac{3}{2}} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{\\frac{1}{2}}^{\\frac{3}{2}}(6 t^{3} - 24 t^{2} - 18 t - 3)(\\sqrt{4 t^{2} + 13})\\,\\mathrm{d}t \\\\ &= \\int_{\\frac{1}{2}}^{\\frac{3}{2}}\\sqrt{4 t^{2} + 13} \\left(6 t^{3} - 24 t^{2} - 18 t - 3\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bbf45e-712a-50fc-9c7f-3db24fc3f7da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}\\frac{2 \\left(- t^{3} + 7 t^{2} + 4 t + 1\\right)}{\\sqrt{4 t^{2} + 5}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539127} {:answer/id #uuid "4b8011db-7762-523b-8d12-4da85216dfd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}- 2 t^{3} + 14 t^{2} + 8 t + 2\\,\\mathrm{d}t" :db/id #edb/ref 17592186539149} {:answer/id #uuid "a46660c1-17ae-5ef0-8a37-70323fa5fabb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}2 \\sqrt{4 t^{2} + 5} \\left(- t^{3} - t^{2} - 4 t - 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539175} {:answer/id #uuid "ad8ff517-6e7d-547d-aa23-f428cf620502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}2 \\left(4 t^{2} + 5\\right) \\left(- t^{3} + 7 t^{2} + 4 t + 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539179} {:answer/id #uuid "dfc8dcdb-9950-52f1-b6f2-4fb28f2f94be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}2 \\sqrt{4 t^{2} + 5} \\left(- t^{3} + 7 t^{2} + 4 t + 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539193}] :answer-field/correct {:answer/id #uuid "dfc8dcdb-9950-52f1-b6f2-4fb28f2f94be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}2 \\sqrt{4 t^{2} + 5} \\left(- t^{3} + 7 t^{2} + 4 t + 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539193} :answer-field/id #uuid "69673806-2d1a-558a-87aa-962b7675aa65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539159}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "19471cdf-9ea5-5c33-ad36-e0767c3ac883" :question/problem "Which of the following is equivalent to $$\n\\displaystyle \\int_C - 2 x y + 2 z^{2}\\,\\mathrm{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=\\langle t^{2}, t - 3, 2 t + 1\\rangle$ for $1\\le t\\le \\frac{3}{2}$?" :question/worked-solution "Since $r(t)=\\langle t^{2}, t - 3, 2 t + 1\\rangle,$ then along the curve we have $x=t^{2}$, $y=t - 3$, $z=2 t + 1$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t - 3)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 1)k \\\\ &= (2 t)\\,i+(1)\\,j+(2)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\right)^2} \\\\ &= \\sqrt{(2 t)^2+(1)^2+(2)^2} \\\\ &= \\sqrt{4 t^{2} + 5}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=- 2 x y + 2 z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=-2\\left((t^{2})(t - 3)-(2 t + 1)^2\\right) \\\\ &= -2\\left(1t^3+(-3)t^2-\\left(4t^2+(4)t+1\\right)\\right) \\\\ &= - 2 t^{3} + 14 t^{2} + 8 t + 2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{1}^{\\frac{3}{2}} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{1}^{\\frac{3}{2}}(- 2 t^{3} + 14 t^{2} + 8 t + 2)(\\sqrt{4 t^{2} + 5})\\,\\mathrm{d}t \\\\ &= \\int_{1}^{\\frac{3}{2}}2 \\sqrt{4 t^{2} + 5} \\left(- t^{3} + 7 t^{2} + 4 t + 1\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36c637e7-9d1d-5a19-bf0e-0dfdcc062824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\frac{4 t^{3} - 5 t^{2} - 6 t - 1}{\\sqrt{16 t^{2} + 13}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539139} {:answer/id #uuid "5aa6780b-c1c7-5d0f-bc04-322cd3efb4a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}4 t^{3} - 5 t^{2} - 6 t - 1\\,\\mathrm{d}t" :db/id #edb/ref 17592186539152} {:answer/id #uuid "805163b1-91d9-5657-84ba-f0adcd279e39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}- \\left(16 t^{2} + 13\\right) \\left(- 4 t^{3} + 5 t^{2} + 6 t + 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539167} {:answer/id #uuid "c792bb24-aaaf-56f9-a31e-683b56a1218d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{16 t^{2} + 13} \\left(4 t^{2} \\left(t + 1\\right) + \\left(3 t + 1\\right)^{2}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539186} {:answer/id #uuid "d82355ef-7111-535b-bc6f-528e24822529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{16 t^{2} + 13} \\left(4 t^{3} - 5 t^{2} - 6 t - 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539191}] :answer-field/correct {:answer/id #uuid "d82355ef-7111-535b-bc6f-528e24822529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{16 t^{2} + 13} \\left(4 t^{3} - 5 t^{2} - 6 t - 1\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539191} :answer-field/id #uuid "507606cb-45d1-5506-805d-8a68afcce084" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539150}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1b6b1bd1-88e4-5d2e-9dfb-33372f16d858" :question/problem "Which of the following is equivalent to $$\n\\displaystyle \\int_C x y - z^{2}\\,\\mathrm{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=\\langle 2 t^{2}, 2 t + 2, 3 t + 1\\rangle$ for $0\\le t\\le 2$?" :question/worked-solution "Since $r(t)=\\langle 2 t^{2}, 2 t + 2, 3 t + 1\\rangle,$ then along the curve we have $x=2 t^{2}$, $y=2 t + 2$, $z=3 t + 1$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 2)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 t + 1)k \\\\ &= (4 t)\\,i+(2)\\,j+(3)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\right)^2} \\\\ &= \\sqrt{(4 t)^2+(2)^2+(3)^2} \\\\ &= \\sqrt{16 t^{2} + 13}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=x y - z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=(2 t^{2})(2 t + 2)-(3 t + 1)^2 \\\\ &= 4t^3+(4)t^2-\\left(9t^2+(6)t+1\\right) \\\\ &= 4 t^{3} - 5 t^{2} - 6 t - 1.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{0}^{2} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{0}^{2}(4 t^{3} - 5 t^{2} - 6 t - 1)(\\sqrt{16 t^{2} + 13})\\,\\mathrm{d}t \\\\ &= \\int_{0}^{2}\\sqrt{16 t^{2} + 13} \\left(4 t^{3} - 5 t^{2} - 6 t - 1\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a182349-c6b0-5892-a095-c61253000a65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{5}\\frac{2 t}{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539151} {:answer/id #uuid "808a5bee-fd16-5441-99c5-68b38ff67c63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{5}2 t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539168} {:answer/id #uuid "9950a772-8737-542f-989a-2f5006693b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{5}\\frac{2 t}{\\left(4 t^{2} + 1\\right)^{\\frac{3}{2}}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539173} {:answer/id #uuid "a5a1d7be-903b-525d-a61b-b6fd648c3cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{5}\\frac{2 t^{2}}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539177} {:answer/id #uuid "e8983d55-5bea-5b37-b969-63bf075c738a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{5}\\frac{2 t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539199}] :answer-field/correct {:answer/id #uuid "e8983d55-5bea-5b37-b969-63bf075c738a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{5}\\frac{2 t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539199} :answer-field/id #uuid "e7d2f535-cd02-5984-8b38-b25fd712257c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539198}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "629bb41a-481a-5fce-89d8-1176b4e371da" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}2\\left(\\frac{x}{4y+1}\\right)\\text{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=t\\,i+{t}^{2}\\,j\\,$ for $0\\le t\\le 5?$" :question/worked-solution "Since $r(t)=t\\,i+{t}^{2}\\,j,$ then along the curve we have $x=t$ and $y={t}^{2}.$ \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =i+2tj \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=2\\left(\\frac{x}{4y+1}\\right)$, then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =2\\left(\\frac{t}{4{t}^{2}+1}\\right).\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}2\\left(\\frac{x}{4y+1}\\right)\\text{d}s & ={\\int }_{0}^{5}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t  \\\\    & =2\\left({\\int }_{0}^{5}\\left(\\frac{t}{4{t}^{2}+1}\\right)\\cdot \\sqrt{4{t}^{2}+1}\\cdot \\text{d}t\\right) \\\\    & =2\\left({\\int }_{0}^{5}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278b3e92-0930-54df-8b78-9d1eb2eb134a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}\\sqrt{2} t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539133} {:answer/id #uuid "27d15098-9f4d-5025-b663-55253273ac10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}\\frac{\\sqrt{2} t \\cos{\\left(2 t \\right)}}{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539134} {:answer/id #uuid "e3e304d5-2e98-55e6-88b1-e67c5a9ca1c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539194} {:answer/id #uuid "e45f8e18-3e75-5cb3-8aee-472302b82414" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}\\sqrt{2} t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539195} {:answer/id #uuid "fe1b2043-64b1-5186-9ca4-d5be02457609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}2 t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539205}] :answer-field/correct {:answer/id #uuid "e45f8e18-3e75-5cb3-8aee-472302b82414" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}\\sqrt{2} t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539195} :answer-field/id #uuid "d1b51734-7cf3-59d4-b15c-c37a8d472ced" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539189}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "77c0932d-edde-5a3d-a95b-c9e88ef0198f" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}z({x}^{2}-{y}^{2})\\,\\text{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k$ for $\\,\\frac{\\pi}{12}\\le t\\le \\frac{\\pi}{2}?$" :question/worked-solution "Since $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k,$ then along the curve we have $x=\\operatorname{cos}⁡t,$ $y=\\operatorname{sin}⁡t,$ and $z=t.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j+\\frac{\\text{d}}{\\text{d}t}(t)k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+{1}^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\n  \n\nNow, if $f(x,y,z)=z({x}^{2}-{y}^{2})$, then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =t((\\operatorname{cos}⁡t)^{2}-(\\operatorname{sin}⁡t)^{2}) \\\\  & =t({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\  & =t\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as  \n\n$$\n\\begin{aligned}{\\int }_{C}z({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}t\\operatorname{cos}⁡2t\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =\\sqrt{2}{\\int }_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}t\\operatorname{cos}⁡2t\\,\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bbf7d63-fae5-55c0-b85a-adf23a9e249f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{2}^{\\frac{11}{2}}\\frac{2 t^{2}}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539130} {:answer/id #uuid "45af7fa4-3c7f-5937-a136-75ca8b278b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{2}^{\\frac{11}{2}}2 t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539144} {:answer/id #uuid "b21d5ca9-b166-5274-a50b-458ef7c02100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{2}^{\\frac{11}{2}}\\frac{2 t}{\\left(4 t^{2} + 1\\right)^{\\frac{3}{2}}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539181} {:answer/id #uuid "c9985de4-28ed-5456-ad68-a38e965bae9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{2}^{\\frac{11}{2}}\\frac{2 t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539187} {:answer/id #uuid "e55bbb40-be6b-5a87-aca7-130550b420f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{2}^{\\frac{