text{d}t\\right) \\\\    & =2\\left({\\int }_{2}^{\\frac{11}{2}}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ddac435-f4c5-5790-a848-0d7fd8aecc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}10 t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539131} {:answer/id #uuid "49e747ab-2e87-5b28-b3b1-52bfbfa14251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 \\sqrt{2} t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539145} {:answer/id #uuid "4a119ce1-666c-589c-913e-71a12513c765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}\\frac{5 \\sqrt{2} t \\cos{\\left(2 t \\right)}}{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539146} {:answer/id #uuid "7f1d6599-ceb5-5eed-83dc-ed06fd4e1d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 \\sqrt{2} t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539165} {:answer/id #uuid "804f7a7d-ca0c-5b72-99dd-1e2bd2065c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539166}] :answer-field/correct {:answer/id #uuid "49e747ab-2e87-5b28-b3b1-52bfbfa14251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 \\sqrt{2} t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539145} :answer-field/id #uuid "e4985361-8dc5-544a-a26a-fb6bff95a3f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539196}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "88d1c090-6bb7-523f-a9f3-d7ec7807cd7a" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}5\\left(z({x}^{2}-{y}^{2})\\right)\\,\\text{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k$ for $\\,0\\le t\\le \\frac{\\pi}{6}?$" :question/worked-solution "Since $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k,$ then along the curve we have $x=\\operatorname{cos}⁡t,$ $y=\\operatorname{sin}⁡t,$ and $z=t.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j+\\frac{\\text{d}}{\\text{d}t}(t)k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+{1}^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\n  \n\nNow, if $f(x,y,z)=5\\left(z({x}^{2}-{y}^{2})\\right)$, then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =5\\left(t((\\operatorname{cos}⁡t)^{2}-(\\operatorname{sin}⁡t)^{2})\\right) \\\\    & =5\\left(t({cos}^{2}⁡t-{sin}^{2}⁡t)\\right) \\\\    & =5\\left(t\\operatorname{cos}⁡2t\\right).\\end{aligned}\n$$\n\nTherefore, we can write the integral as  \n\n$$\n\\begin{aligned}{\\int }_{C}5\\left(z({x}^{2}-{y}^{2})\\right)\\,\\text{d}s & ={\\int }_{0}^{\\frac{\\pi}{6}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t  \\\\    & =5\\left({\\int }_{0}^{\\frac{\\pi}{6}}t\\operatorname{cos}⁡2t\\cdot \\sqrt{2}\\cdot \\text{d}t\\right) \\\\    & =5\\left(\\sqrt{2}{\\int }_{0}^{\\frac{\\pi}{6}}t\\operatorname{cos}⁡2t\\,\\text{d}t\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ec66b2-9271-5a86-bba6-39b76534dbf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539124} {:answer/id #uuid "39eb83de-83c7-5476-b2e1-42b4fe358621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}5 t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539140} {:answer/id #uuid "3a918622-26b5-5fae-b7b9-05af71744ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{\\left(4 t^{2} + 1\\right)^{\\frac{3}{2}}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539141} {:answer/id #uuid "60aab06d-1253-59b6-b9bd-40fdc6f9eb1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539156} {:answer/id #uuid "7b390292-66dd-5f10-a384-8ca7ed8cf17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t^{2}}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539162}] :answer-field/correct {:answer/id #uuid "60aab06d-1253-59b6-b9bd-40fdc6f9eb1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539156} :answer-field/id #uuid "af41d808-87d0-52a5-979b-295e732e80de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539180}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a17cfaab-14e7-5c09-ade5-3176e170f53b" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}5\\left(\\frac{x}{4y+1}\\right)\\text{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=t\\,i+{t}^{2}\\,j\\,$ for $\\frac{1}{2}\\le t\\le \\frac{7}{3}?$" :question/worked-solution "Since $r(t)=t\\,i+{t}^{2}\\,j,$ then along the curve we have $x=t$ and $y={t}^{2}.$ \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =i+2tj \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=5\\left(\\frac{x}{4y+1}\\right)$, then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =5\\left(\\frac{t}{4{t}^{2}+1}\\right).\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}5\\left(\\frac{x}{4y+1}\\right)\\text{d}s & ={\\int }_{\\frac{1}{2}}^{\\frac{7}{3}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t  \\\\    & =5\\left({\\int }_{\\frac{1}{2}}^{\\frac{7}{3}}\\left(\\frac{t}{4{t}^{2}+1}\\right)\\cdot \\sqrt{4{t}^{2}+1}\\cdot \\text{d}t\\right) \\\\    & =5\\left({\\int }_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6007b4c8-5fd7-5182-b9b1-b8ab65716cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}\\sqrt{36 t^{2} + 5} \\left(- 6 t^{3} - 10 t^{2} + 16 t + 8\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539155} {:answer/id #uuid "c10d389c-0aa7-5b23-82b4-246c7ac9ce69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}- 2 \\left(36 t^{2} + 5\\right) \\left(3 t^{3} + 5 t^{2} - 8 t - 4\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539184} {:answer/id #uuid "d7c7ac66-9df2-5528-8428-8ab1dc9902f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}\\frac{2 \\left(- 3 t^{3} - 5 t^{2} + 8 t + 4\\right)}{\\sqrt{36 t^{2} + 5}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539190} {:answer/id #uuid "df5c3f33-dfe4-50f6-8249-42490daafec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}- 6 t^{3} - 10 t^{2} + 16 t + 8\\,\\mathrm{d}t" :db/id #edb/ref 17592186539192} {:answer/id #uuid "f5a7e9b2-2d21-55ba-a040-b5b1c6d8da08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}2 \\sqrt{36 t^{2} + 5} \\left(- 3 t^{2} \\left(t + 3\\right) - 4 \\left(t + 1\\right)^{2}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539203}] :answer-field/correct {:answer/id #uuid "6007b4c8-5fd7-5182-b9b1-b8ab65716cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}\\sqrt{36 t^{2} + 5} \\left(- 6 t^{3} - 10 t^{2} + 16 t + 8\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539155} :answer-field/id #uuid "66661945-6b6a-5b27-bb7a-9979aec89f63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539158}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a908ad08-fd2d-5338-a3b2-fa3636e47ff4" :question/problem "Which of the following is equivalent to $$\n\\displaystyle \\int_C - 2 x y + 2 z^{2}\\,\\mathrm{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=\\langle 3 t^{2}, t + 3, 2 t + 2\\rangle$ for $0\\le t\\le \\frac{5}{2}$?" :question/worked-solution "Since $r(t)=\\langle 3 t^{2}, t + 3, 2 t + 2\\rangle,$ then along the curve we have $x=3 t^{2}$, $y=t + 3$, $z=2 t + 2$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(3 t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t + 3)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 2)k \\\\ &= (6 t)\\,i+(1)\\,j+(2)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\right)^2} \\\\ &= \\sqrt{(6 t)^2+(1)^2+(2)^2} \\\\ &= \\sqrt{36 t^{2} + 5}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=- 2 x y + 2 z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=-2\\left((3 t^{2})(t + 3)-(2 t + 2)^2\\right) \\\\ &= -2\\left(3t^3+(9)t^2-\\left(4t^2+(8)t+4\\right)\\right) \\\\ &= - 6 t^{3} - 10 t^{2} + 16 t + 8.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{0}^{\\frac{5}{2}} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{0}^{\\frac{5}{2}}(- 6 t^{3} - 10 t^{2} + 16 t + 8)(\\sqrt{36 t^{2} + 5})\\,\\mathrm{d}t \\\\ &= \\int_{0}^{\\frac{5}{2}}\\sqrt{36 t^{2} + 5} \\left(- 6 t^{3} - 10 t^{2} + 16 t + 8\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d55e55-4da0-5e7e-b523-3a71c34060d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539135} {:answer/id #uuid "7b5b324f-dc6f-5f53-96c6-b0679ba8cf94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t^{2}}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539163} {:answer/id #uuid "8698b24c-571c-586d-9aa9-791ca92cca74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{\\left(4 t^{2} + 1\\right)^{\\frac{3}{2}}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539170} {:answer/id #uuid "b26b07de-bd8f-5b41-9dc8-2063df8ca6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539182} {:answer/id #uuid "d04b5623-2bff-542f-8d52-93366f70ddc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539188}] :answer-field/correct {:answer/id #uuid "d04b5623-2bff-542f-8d52-93366f70ddc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539188} :answer-field/id #uuid "06daf866-2151-53ab-a697-9d6282e0ae9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539125}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f04c0a98-4a6c-5873-883f-948e18d8b72b" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}\\frac{x}{4y+1}\\text{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=t\\,i+{t}^{2}\\,j\\,$ for $1\\le t\\le \\frac{4}{3}?$" :question/worked-solution "Since $r(t)=t\\,i+{t}^{2}\\,j,$ then along the curve we have $x=t$ and $y={t}^{2}.$ \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =i+2tj \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=\\frac{x}{4y+1}$, then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{t}{4{t}^{2}+1}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{4y+1}\\text{d}s & ={\\int }_{1}^{\\frac{4}{3}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{\\frac{4}{3}}\\left(\\frac{t}{4{t}^{2}+1}\\right)\\cdot \\sqrt{4{t}^{2}+1}\\cdot \\text{d}t \\\\  & ={\\int }_{1}^{\\frac{4}{3}}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0228b294-5832-5825-ad8a-3bc0a9bdbe23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}\\frac{2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)}{5}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539123} {:answer/id #uuid "0f75487c-a5f1-5e36-86b8-989567defbd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}80 t^{3} + 10 t - 20\\,\\mathrm{d}t" :db/id #edb/ref 17592186539126} {:answer/id #uuid "7dea96ab-5a7e-592e-944f-a693c36c797b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}16 t^{3} + 2 t - 4\\,\\mathrm{d}t" :db/id #edb/ref 17592186539164} {:answer/id #uuid "c6680a8a-cce7-55d0-b883-50e0e3ba2e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} - t + 2\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539185} {:answer/id #uuid "f38f729c-48d5-5112-b120-4a7a2e085fed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)\\,\\mathrm{d}t$." :db/id #edb/ref 17592186539201}] :answer-field/correct {:answer/id #uuid "f38f729c-48d5-5112-b120-4a7a2e085fed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)\\,\\mathrm{d}t$." :db/id #edb/ref 17592186539201} :answer-field/id #uuid "b97f8f35-3ac8-510f-857f-73a5203bed44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539183}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f515b153-b2d5-5f07-b698-2b223e35049e" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle \\int_C2\\left((x^{3} - y)\\right)ds,\n$$ where the curve $C$ is parametrized by $r(t) = 2ti + (2 - t)j$ for $- \\frac{3}{2}\\le t\\le 2$?" :question/worked-solution "Since $r(t)=\\langle 2 t, 2 - t\\rangle,$ then along the curve we have $x=2 t$, $y=2 - t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 - t)j \\\\ &= (2)\\,i+(-1)\\,j \\\\ \\|r'(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\ &= \\sqrt{(2)^2+(-1)^2} \\\\ &= \\sqrt{5}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2 x^{3} - 2 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left((2 t)^3-(2 - t)\\right) \\\\ &= 2\\left(8t^3-2+t\\right) \\\\ &= 16 t^{3} + 2 t - 4.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm{d}s&=\\int_{- \\frac{3}{2}}^{2} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{- \\frac{3}{2}}^{2}(16 t^{3} + 2 t - 4)(\\sqrt{5})\\,\\mathrm{d}t \\\\ &= \\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30338bca-6ca0-51af-8f2f-96eb86969268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}12 t^{3} + 3 t^{2} - 18 t - 27\\,\\mathrm{d}t" :db/id #edb/ref 17592186539137} {:answer/id #uuid "4a9fac12-ab2b-5bd8-ac50-2e5e3c1a9b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539148} {:answer/id #uuid "5d90c9ff-4b45-5a51-ad47-6931f43284f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(2 t^{2} \\left(2 t + 1\\right) + \\left(t + 3\\right)^{2}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539154} {:answer/id #uuid "741d6ee7-19d1-5aef-a755-d8ed6ebfa877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}\\frac{3 \\left(4 t^{3} + t^{2} - 6 t - 9\\right)}{\\sqrt{16 t^{2} + 5}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539160} {:answer/id #uuid "a543efd7-e7a5-5a36-9b77-3946d717a988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\left(16 t^{2} + 5\\right) \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539176}] :answer-field/correct {:answer/id #uuid "4a9fac12-ab2b-5bd8-ac50-2e5e3c1a9b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539148} :answer-field/id #uuid "4103d898-eeb8-573e-bb32-54b6347b1152" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539143}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fcd80b68-90ad-5381-82bb-4a395bb5f45b" :question/problem "Which of the following is equivalent to $$\n\\displaystyle \\int_C 3 x y - 3 z^{2}\\,\\mathrm{d}s,\n$$ where the curve $C$ is parametrized by $r(t)=\\langle 2 t^{2}, 2 t + 1, t + 3\\rangle$ for $1\\le t\\le \\frac{3}{2}$?" :question/worked-solution "Since $r(t)=\\langle 2 t^{2}, 2 t + 1, t + 3\\rangle,$ then along the curve we have $x=2 t^{2}$, $y=2 t + 1$, $z=t + 3$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 1)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t + 3)k \\\\ &= (4 t)\\,i+(2)\\,j+(1)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\right)^2} \\\\ &= \\sqrt{(4 t)^2+(2)^2+(1)^2} \\\\ &= \\sqrt{16 t^{2} + 5}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=3 x y - 3 z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=3\\left((2 t^{2})(2 t + 1)-(t + 3)^2\\right) \\\\ &= 3\\left(4t^3+(2)t^2-\\left(1t^2+(6)t+9\\right)\\right) \\\\ &= 12 t^{3} + 3 t^{2} - 18 t - 27.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{1}^{\\frac{3}{2}} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{1}^{\\frac{3}{2}}(12 t^{3} + 3 t^{2} - 18 t - 27)(\\sqrt{16 t^{2} + 5})\\,\\mathrm{d}t \\\\ &= \\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186700688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87256819-2e49-5e9c-89f5-72825a02e536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2\\sqrt2" :db/id #edb/ref 17592186700692} {:answer/id #uuid "adeb24cd-d6e0-5d44-a9ff-a7be9c840c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac32" :db/id #edb/ref 17592186700697} {:answer/id #uuid "cde1b3a3-e76c-503b-850d-8bd31b548cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt2-1" :db/id #edb/ref 17592186700702} {:answer/id #uuid "e8eb8386-e3b0-5810-96be-3621c2fa7e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac23(2\\sqrt2-1)" :db/id #edb/ref 17592186700705} {:answer/id #uuid "f2894531-86b8-5027-a00f-ab1a76c8f98b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt2" :db/id #edb/ref 17592186700707}] :answer-field/correct {:answer/id #uuid "cde1b3a3-e76c-503b-850d-8bd31b548cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt2-1" :db/id #edb/ref 17592186700702} :answer-field/id #uuid "f19ea2ac-b621-56d8-bd99-b79d832a9765" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700706}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "56e093a1-badc-5734-b16b-054c37904e43" :question/problem "Evaluate the line integral\n\n$$\n\\int_C 3yz\\cos x\\,\\mathrm ds,\n$$\n\nwhere\n\n$$\n\\mathbf r(t)=\\langle t,\\sin t,1\\rangle,\\qquad 0\\le t\\le\\frac\\pi2.\n$$\n\nGive the exact value." :question/worked-solution "Use the scalar line integral formula\n\n$$\n\\int_C f\\,\\mathrm ds=\\int_a^b f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm dt.\n$$\n\nAlong the curve, $x=t$, $y=\\sin t$, and $z=1$. Hence\n\n$$\nf(\\mathbf r(t))=3\\sin t\\cos t.\n$$\n\nDifferentiate all three coordinates and compute the speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 1,\\cos t,0\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{1+\\cos^2t}.\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\int_C 3yz\\cos x\\,\\mathrm ds\n=\\int_0^{\\pi/2}3\\sin t\\cos t\\sqrt{1+\\cos^2t}\\,\\mathrm dt.\n$$\n\nChoose $u=1+\\cos^2t$. Then $\\mathrm du=-2\\sin t\\cos t\\,\\mathrm dt$. The limits reverse:\n\n| $t$ | $0$ | $\\frac\\pi2$ |\n| --- | --- | --- |\n| $u$ | $2$ | $1$ |\n\nSo\n\n$$\n\\begin{aligned}\n\\int_C 3yz\\cos x\\,\\mathrm ds\n&=-\\frac32\\int_2^1 u^{1/2}\\,\\mathrm du\\\\\n&=\\frac32\\int_1^2 u^{1/2}\\,\\mathrm du\\\\\n&=\\left[u^{3/2}\\right]_1^2\\\\\n&=2\\sqrt2-1.\n\\end{aligned}\n$$\n\nThe integrand is nonnegative on this interval, which also checks the sign."}] [{:db/id #edb/ref 17592186700698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "470fd09c-2842-5207-903a-32f6c2c8d5a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186700687} {:answer/id #uuid "759b8130-52ab-5356-8d16-c80951fb2b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32-3\\sqrt6}{5}" :db/id #edb/ref 17592186700690} {:answer/id #uuid "a6d1f8c6-0c06-53aa-ba95-3d037136b925" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac32" :db/id #edb/ref 17592186700695} {:answer/id #uuid "aa31bef7-4b10-5b0a-bfad-bb01518bd542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\sqrt2" :db/id #edb/ref 17592186700696} {:answer/id #uuid "c4187bd4-b094-50c6-9d6b-0208e95835a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32-3\\sqrt6" :db/id #edb/ref 17592186700701}] :answer-field/correct {:answer/id #uuid "759b8130-52ab-5356-8d16-c80951fb2b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32-3\\sqrt6}{5}" :db/id #edb/ref 17592186700690} :answer-field/id #uuid "b5c2c7f4-339d-5a6b-a4dd-1e042be81dc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700699}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b0411044-fc20-574c-a3d2-b78307b21dd1" :question/problem "Evaluate the line integral\n\n$$\n\\int_C\\frac{y+z}{x}\\,\\mathrm ds,\n$$\n\nwhere\n\n$$\n\\mathbf r(t)=\\left\\langle t,\\frac{t^2}{2},t^2\\right\\rangle,\\qquad 1\\le t\\le\\sqrt3.\n$$\n\nGive the exact value." :question/worked-solution "For a scalar function in three variables,\n\n$$\n\\int_C f\\,\\mathrm ds=\\int_a^b f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm dt.\n$$\n\nHere $x=t$, $y=t^2/2$, and $z=t^2$. Since $t\\ge1$, the denominator is nonzero, and\n\n$$\nf(\\mathbf r(t))=\\frac{t^2/2+t^2}{t}=\\frac32t.\n$$\n\nAll three derivative components contribute to arc length:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 1,t,2t\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{1^2+t^2+(2t)^2}=\\sqrt{1+5t^2}.\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\int_C\\frac{y+z}{x}\\,\\mathrm ds\n=\\int_1^{\\sqrt3}\\frac32t\\sqrt{1+5t^2}\\,\\mathrm dt.\n$$\n\nChoose $u=1+5t^2$, so $\\mathrm du=10t\\,\\mathrm dt$ and $\\frac32t\\,\\mathrm dt=\\frac3{20}\\,\\mathrm du$. The transformed limits are\n\n| $t$ | $1$ | $\\sqrt3$ |\n| --- | --- | --- |\n| $u$ | $6$ | $16$ |\n\nIt follows that\n\n$$\n\\begin{aligned}\n\\int_C\\frac{y+z}{x}\\,\\mathrm ds\n&=\\frac3{20}\\int_6^{16}u^{1/2}\\,\\mathrm du\\\\\n&=\\frac1{10}\\left[u^{3/2}\\right]_6^{16}\\\\\n&=\\frac{64-6\\sqrt6}{10}\\\\\n&=\\frac{32-3\\sqrt6}{5}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186700700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "673ee373-4257-5e1b-98e4-e28ae6539e00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(5\\sqrt5-1)" :db/id #edb/ref 17592186700689} {:answer/id #uuid "7e9dbede-9e49-5313-83e3-c1898bb46155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5}{2}" :db/id #edb/ref 17592186700691} {:answer/id #uuid "8e10081f-1d09-5341-80c8-fc705707a900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186700693} {:answer/id #uuid "9c9c8ad1-56c5-54e6-a286-4fc2e4b820e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5-1}{2}" :db/id #edb/ref 17592186700694} {:answer/id #uuid "e70037de-5b4c-50ec-956d-b0441e1e0034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt5-1}{2}" :db/id #edb/ref 17592186700704}] :answer-field/correct {:answer/id #uuid "9c9c8ad1-56c5-54e6-a286-4fc2e4b820e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5-1}{2}" :db/id #edb/ref 17592186700694} :answer-field/id #uuid "d26120d5-a2cc-5919-8cc1-c929341f09a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700703}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c3fd95d9-ac39-5143-ab7b-7b87094db6e4" :question/problem "Evaluate the line integral of $f(x,y)=6y$ along the curve\n\n$$\n\\mathbf r(t)=\\langle t^2,t\\rangle,\\qquad 0\\le t\\le 1.\n$$\n\nUse\n\n$$\n\\int_C f\\,\\mathrm ds=\\int_a^b f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm dt.\n$$\n\nFor this curve, $\\|\\mathbf r'(t)\\|=\\sqrt{4t^2+1}$. Use the substitution $u=4t^2+1$ and give the exact value." :question/worked-solution "Along the curve, $x=t^2$ and $y=t$, so $f(\\mathbf r(t))=6t$. The supplied speed follows from\n\n$$\n\\mathbf r'(t)=\\langle 2t,1\\rangle,\\qquad\n\\|\\mathbf r'(t)\\|=\\sqrt{(2t)^2+1^2}=\\sqrt{4t^2+1}.\n$$\n\nThus\n\n$$\n\\int_C 6y\\,\\mathrm ds=\\int_0^1 6t\\sqrt{4t^2+1}\\,\\mathrm dt.\n$$\n\nWith $u=4t^2+1$, we have $\\mathrm du=8t\\,\\mathrm dt$ and $6t\\,\\mathrm dt=\\frac34\\,\\mathrm du$. Change both limits:\n\n| $t$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $5$ |\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int_C 6y\\,\\mathrm ds\n&=\\frac34\\int_1^5 u^{1/2}\\,\\mathrm du\\\\\n&=\\frac12\\left[u^{3/2}\\right]_1^5\\\\\n&=\\frac{5\\sqrt5-1}{2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186700866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ba3421-5461-5ad5-aed1-3835dc48143c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-2}^{-1}(t^4+t^2-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186700860} {:answer/id #uuid "1c566ac0-c2ee-539f-b2a4-e5292104a01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}\\int_{-2}^{-1}t(t^4+t^2-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186700863} {:answer/id #uuid "9f576d1e-33ca-5b1c-98bc-1d2e113b15e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\int_{-2}^{-1}t(t^4+t^2-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186700873} {:answer/id #uuid "b26db3b4-966c-5bdf-b444-88c21a6a564a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}\\int_{-2}^{-1}t(t^4+t^2+1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186700874} {:answer/id #uuid "fa4c5236-1dc1-5053-9bf0-37d2e2b29656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}\\int_{-2}^{-1}t(t^4+t^2-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186700879}] :answer-field/correct {:answer/id #uuid "1c566ac0-c2ee-539f-b2a4-e5292104a01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}\\int_{-2}^{-1}t(t^4+t^2-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186700863} :answer-field/id #uuid "2920feb6-7547-59c4-af18-c7b65a33b375" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700864}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3833b230-50ff-50f5-aafe-196ea6a0ebb6" :question/problem "Which of the following is equivalent to\n\n$$\n\\int_C (xy+z)\\,\\mathrm{d}s,\n$$\nwhere $\\mathbf r(t)=\\langle t^2+1,t^2-1,t^2\\rangle$ for $-2\\le t\\le-1$?" :question/worked-solution "Along the curve, $x=t^2+1$, $y=t^2-1$, and $z=t^2$. Compute the derivative and speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle2t,2t,2t\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(2t)^2+(2t)^2+(2t)^2}\\\\\n&=\\sqrt{12t^2}=2\\sqrt{3}\\,|t|.\n\\end{aligned}\n$$\n\nEvery $t$ in $[-2,-1]$ is negative, so $|t|=-t$. Therefore the speed is $-2\\sqrt{3}\\,t$, which is positive on this interval.\n\nSubstitute into the scalar function, keeping the product grouped:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=(t^2+1)(t^2-1)+t^2\\\\\n&=t^4-1+t^2\\\\\n&=t^4+t^2-1.\n\\end{aligned}\n$$\n\nUse the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nCombining these expressions, with the original parameter bounds, gives\n\n$$\n\\begin{aligned}\n\\int_C (xy+z)\\,\\mathrm{d}s\n&=\\int_{-2}^{-1}(t^4+t^2-1)(-2\\sqrt{3}\\,t)\\,\\mathrm{d}t\\\\\n&=-2\\sqrt{3}\\int_{-2}^{-1}t(t^4+t^2-1)\\,\\mathrm{d}t.\n\\end{aligned}\n$$\n\nUsing $2\\sqrt{3}\\,t$ as the speed would give a negative speed and the wrong sign for the integral."}] [{:db/id #edb/ref 17592186700869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f06d3f-91e4-53dc-af68-8e1751904e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\int_0^1\\sqrt{4t^2+2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186700859} {:answer/id #uuid "329c0242-6d23-5e4f-a724-425eaddd53a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\int_0^1(4t^2+2)\\,\\mathrm{d}t" :db/id #edb/ref 17592186700865} {:answer/id #uuid "ba3706fd-9b3e-55ec-9df4-771340f15f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\int_0^1\\sqrt{4t^2+2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186700875} {:answer/id #uuid "bc3f85ce-9ecd-5b81-a718-45de336d886b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\int_0^1\\mathrm{d}t" :db/id #edb/ref 17592186700876} {:answer/id #uuid "cf65701a-9308-5fc5-b118-ca90da41376d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\int_0^1\\sqrt{4t^2+1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186700877}] :answer-field/correct {:answer/id #uuid "ba3706fd-9b3e-55ec-9df4-771340f15f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\int_0^1\\sqrt{4t^2+2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186700875} :answer-field/id #uuid "180e4e45-cc66-5568-8021-5f934360f53f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700862}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a9d928f-f06f-558c-9a68-5d4e8e5e9470" :question/problem "Which of the following is equivalent to\n\n$$\n\\int_C (2x-y^2-z^2)\\,\\mathrm{d}s,\n$$\nwhere $\\mathbf r(t)=\\langle t^2,t-2,t+2\\rangle$ for $0\\le t\\le1$?" :question/worked-solution "Here, $x=t^2$, $y=t-2$, and $z=t+2$.\n\nFirst compute the derivative and speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle2t,1,1\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(2t)^2+1^2+1^2}=\\sqrt{4t^2+2}.\n\\end{aligned}\n$$\n\nSubstitute all three coordinates into the scalar function:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=2t^2-(t-2)^2-(t+2)^2\\\\\n&=2t^2-(t^2-4t+4)-(t^2+4t+4)\\\\\n&=-8.\n\\end{aligned}\n$$\n\nBoth squares are subtracted, including their constant terms. The scalar function is negative on the whole path, even though speed is nonnegative.\n\nUse the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nCombining the substituted function with the speed gives\n\n$$\n\\int_C (2x-y^2-z^2)\\,\\mathrm{d}s=-8\\int_0^1\\sqrt{4t^2+2}\\,\\mathrm{d}t.\n$$"}] [{:db/id #edb/ref 17592186700872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1704d51b-e067-5b47-92d9-c1e35e40529a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_0^{\\pi/2}\\sin^2 t\\cos t\\,\\mathrm{d}t" :db/id #edb/ref 17592186700861} {:answer/id #uuid "5b7cea17-e379-5462-ac0d-8d345866f5a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\int_0^{\\pi/2}\\sin^2 t\\cos t\\,\\mathrm{d}t" :db/id #edb/ref 17592186700868} {:answer/id #uuid "7c044f35-c068-573c-baca-e4dfb574ec18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_0^{\\pi/2}\\sin t\\cos t\\,\\mathrm{d}t" :db/id #edb/ref 17592186700870} {:answer/id #uuid "883c8002-9ea4-54c0-a573-9fd5a223bc80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\int_0^{\\pi/2}\\sin^2 t\\cos t\\,\\mathrm{d}t" :db/id #edb/ref 17592186700871} {:answer/id #uuid "d0bd54c5-6b5b-510c-a685-ab89a8b203c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_0^{\\pi/2}\\cos^2 t\\,\\mathrm{d}t" :db/id #edb/ref 17592186700878}] :answer-field/correct {:answer/id #uuid "1704d51b-e067-5b47-92d9-c1e35e40529a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_0^{\\pi/2}\\sin^2 t\\cos t\\,\\mathrm{d}t" :db/id #edb/ref 17592186700861} :answer-field/id #uuid "5746a14b-0a07-516e-b7a2-21706a386ed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700867}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "89c0b778-f700-554c-b612-899ba7501514" :question/problem "Which of the following is equivalent to\n\n$$\n\\int_C xy^2\\,\\mathrm{d}s,\n$$\nwhere $\\mathbf r(t)=\\langle\\cos t,\\sin t\\rangle$ for $0\\le t\\le\\pi/2$?" :question/worked-solution "![](images/f5/f53d78debfec5f8c50e0f3a5947d2a36126e18c073d7b0cc4c59d506753059b3.png)\n\nThe path is the quarter circle shown above. Along the curve, $x=\\cos t$ and $y=\\sin t$, so\n\n$$\nf(\\mathbf r(t))=\\cos t\\,(\\sin t)^2=\\sin^2 t\\cos t.\n$$\n\nDifferentiating the coordinates gives\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle-\\sin t,\\cos t\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(-\\sin t)^2+\\cos^2 t}=1.\n\\end{aligned}\n$$\n\nUse the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nThus the equivalent definite integral is\n\n$$\n\\int_C xy^2\\,\\mathrm{d}s=\\int_0^{\\pi/2}\\sin^2 t\\cos t\\,\\mathrm{d}t.\n$$\n\nThe speed is $1$; no additional factor is needed."}] [{:db/id #edb/ref 17592186701016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8924c8-9e70-57df-95c6-a15d2b53d042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi" :db/id #edb/ref 17592186701013} {:answer/id #uuid "3f0838be-349e-5cd5-8642-dfcfa7c74913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186701014} {:answer/id #uuid "4a78bccb-49ae-5b25-b5a0-c9ecbf60146a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186701017} {:answer/id #uuid "c2b0d656-b30a-53ee-bc5d-22e33ddfddac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186701026} {:answer/id #uuid "e0c74084-99a8-5d03-8a63-ef7c51bc9385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi-2" :db/id #edb/ref 17592186701031}] :answer-field/correct {:answer/id #uuid "4a78bccb-49ae-5b25-b5a0-c9ecbf60146a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186701017} :answer-field/id #uuid "e035e029-78ed-5e96-b2a0-4ba4b9d28cd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701030}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4516f39d-68f0-5716-8ede-e93051a2c2f1" :question/problem "Evaluate the integral\n\n$$\n\\int_C y^2\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is parametrized by\n\n$$\n\\mathbf r(t)=\\langle 2\\cos t,2\\sin t\\rangle,\\qquad 0\\le t\\le \\frac{\\pi}{2}.\n$$" :question/worked-solution "For a scalar line integral with respect to arc length, use\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nThe path is the quarter circle of radius $2$ shown below.\n\n![Quarter circle of radius 2 from (2,0) to (0,2), traversed counterclockwise.](images/6d/6d933c280ebb530aefaadc1b5ef927e39603635960348255045c138ee9bab366.png)\n\nAlong the curve, $x=2\\cos t$ and $y=2\\sin t$. Compute\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle -2\\sin t,2\\cos t\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{4\\sin^2t+4\\cos^2t}=2,\\\\\nf(\\mathbf r(t))&=(2\\sin t)^2=4\\sin^2t.\n\\end{aligned}\n$$\n\nThe integral involves $\\sin^2t$, so use the identity $\\sin^2t=(1-\\cos 2t)/2$:\n\n$$\n\\begin{aligned}\n\\int_C y^2\\,\\mathrm{d}s\n&=8\\int_0^{\\pi/2}\\sin^2t\\,\\mathrm{d}t\\\\\n&=4\\int_0^{\\pi/2}(1-\\cos 2t)\\,\\mathrm{d}t\\\\\n&=4\\left[t-\\frac{\\sin 2t}{2}\\right]_0^{\\pi/2}\\\\\n&=4\\left(\\frac{\\pi}{2}-0\\right)=2\\pi.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4455e5f7-3a97-584c-85b5-34740dc314c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{88}{15}" :db/id #edb/ref 17592186701015} {:answer/id #uuid "4c58360f-224a-5f46-bae8-a7bef98d1c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186701018} {:answer/id #uuid "61f9040e-7248-5cd2-8cc5-e894e2e3e33b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186701021} {:answer/id #uuid "66199aeb-c943-5c33-b9d4-012253e48a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186701023} {:answer/id #uuid "cf38f399-3880-5942-ab12-7131047508d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186701029}] :answer-field/correct {:answer/id #uuid "4c58360f-224a-5f46-bae8-a7bef98d1c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186701018} :answer-field/id #uuid "cef54a04-3850-5b33-9148-77a2c9d4aa3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701028}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "be380b6c-755b-569a-a14f-a2be4a5b58b5" :question/problem "Evaluate the integral\n\n$$\n\\int_C (x^2+y^2-2)\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is parametrized by\n\n$$\n\\mathbf r(t)=\\langle 2(\\cos t+t\\sin t),2(\\sin t-t\\cos t)\\rangle.\n$$\n\nfor $0\\le t\\le 1$." :question/worked-solution "For a scalar line integral with respect to arc length, use\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nUse the product rule in both components. The terms without a factor of $t$ cancel:\n\n$$\n\\begin{aligned}\nx'(t)&=2(-\\sin t+\\sin t+t\\cos t)=2t\\cos t,\\\\\ny'(t)&=2(\\cos t-\\cos t+t\\sin t)=2t\\sin t,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{4t^2\\cos^2t+4t^2\\sin^2t}\\\\\n&=2|t|=2t.\n\\end{aligned}\n$$\n\nHere $|t|=t$ because $0\\le t\\le 1$. The speed is zero only at the starting endpoint.\n\nNext, substitute both coordinates. Expanding the squares cancels the mixed terms:\n\n$$\n\\begin{aligned}\nx(t)^2+y(t)^2\n&=4\\bigl[(\\cos t+t\\sin t)^2+(\\sin t-t\\cos t)^2\\bigr]\\\\\n&=4\\bigl[\\cos^2t+2t\\sin t\\cos t+t^2\\sin^2t\\\\\n&\\qquad+\\sin^2t-2t\\sin t\\cos t+t^2\\cos^2t\\bigr]\\\\\n&=4(1+t^2).\n\\end{aligned}\n$$\n\nThus $f(\\mathbf r(t))=4(1+t^2)-2=2+4t^2$. Multiply this by the variable speed and integrate each term:\n\n$$\n\\begin{aligned}\n\\int_C (x^2+y^2-2)\\,\\mathrm{d}s\n&=\\int_0^1 (2+4t^2)\\,2t\\,\\mathrm{d}t\\\\\n&=\\int_0^1 (4t+8t^3)\\,\\mathrm{d}t\\\\\n&=\\left[2t^2+2t^4\\right]_0^1\\\\\n&=2+2=4.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ccee15c-4c95-5473-bab1-daf90ee30f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186701012} {:answer/id #uuid "5cfb2277-6565-5b69-a5ef-c0f4ca6507f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sqrt{2}" :db/id #edb/ref 17592186701019} {:answer/id #uuid "61cfffa1-1be3-5f25-9208-12e42acfd915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186701020} {:answer/id #uuid "8d906e4b-2a01-5987-9042-cdb4a0bc90e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186701024} {:answer/id #uuid "c5ee6cd6-fccb-58b2-994e-ae3e1d59e2a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt{2}" :db/id #edb/ref 17592186701027}] :answer-field/correct {:answer/id #uuid "61cfffa1-1be3-5f25-9208-12e42acfd915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186701020} :answer-field/id #uuid "654b2f5c-e675-581c-84df-882d32baf2ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701022}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2676d43-e5c8-5ee6-b6cc-45040488fa1b" :question/problem "Evaluate the line integral of $f(x,y)=x+y$ along the curve $C$ parametrized by\n\n$$\n\\mathbf r(t)=\\langle 2t,1+2t\\rangle,\\qquad 0\\le t\\le 1.\n$$" :question/worked-solution "For a scalar line integral with respect to arc length, use\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nAlong the curve, $x=2t$ and $y=1+2t$. Differentiate the path and compute its speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 2,2\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{2^2+2^2}=2\\sqrt{2}.\n\\end{aligned}\n$$\n\nSubstitute the coordinates into the scalar function:\n\n$$\nf(\\mathbf r(t))=2t+(1+2t)=1+4t.\n$$\n\nMultiply by the speed before integrating:\n\n$$\n\\begin{aligned}\n\\int_C (x+y)\\,\\mathrm{d}s\n&=\\int_0^1 (1+4t)\\,2\\sqrt{2}\\,\\mathrm{d}t\\\\\n&=2\\sqrt{2}\\left[t+2t^2\\right]_0^1\\\\\n&=2\\sqrt{2}(1+2)=6\\sqrt{2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c21b08c-6569-5a70-9eab-5ab764295e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{108}" :db/id #edb/ref 17592186701105} {:answer/id #uuid "43020db3-5943-5475-9919-0d602f443458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186701106} {:answer/id #uuid "80ae634d-389d-5b49-8bbf-e00839bfb9ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{10 \\sqrt{3}}{3}" :db/id #edb/ref 17592186701115} {:answer/id #uuid "8ea070e5-5022-53a7-8782-c4c0a56f7b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{120}" :db/id #edb/ref 17592186701118} {:answer/id #uuid "b19ffb40-1a41-577e-b157-d65d7caa5566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{18}" :db/id #edb/ref 17592186701123}] :answer-field/correct {:answer/id #uuid "43020db3-5943-5475-9919-0d602f443458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186701106} :answer-field/id #uuid "79c8b8d8-6162-596d-9a0c-1809a555fa8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701112}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00b17c43-8b90-5d56-be0c-96bcd18391ca" :question/problem "Evaluate the line integral of $f(x,y)=- 2 \\cos{\\left(x \\right)}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 t^{2},- t^{2}\\rangle,\\qquad 0\\le t\\le \\sqrt{\\frac{\\pi}{9}}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 t^{2})\\,i+(- t^{2})\\,j$, then along the curve we have $x=3 t^{2}$, $y=- t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(- t^{2})\\,j \\\\  & =(6 t)\\,i+(- 2 t)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(6 t)^2+(- 2 t)^2} \\\\  & =\\sqrt{40 t^{2}} \\\\  & =2 \\sqrt{10}|t| \\\\  & =2 \\sqrt{10} t\\end{aligned}\n$$\n\nNotice that $|t|=t$ because $t\\geq0$ along the path of $C.$\n\nNow, since $f(x,y)=- 2 \\cos{\\left(x \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =- 2 \\cos{\\left(3 t^{2} \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\sqrt{\\frac{\\pi}{9}}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{\\frac{\\pi}{9}}}(- 2 \\cos{\\left(3 t^{2} \\right)})(2 \\sqrt{10} t)\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=3 t^{2}$, $\\text{d}u=(6 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{0}^{\\frac{\\pi}{3}}- \\frac{2 \\sqrt{10}}{3}\\cdot \\cos u\\,\\text{d}u \\\\  & =- \\frac{2 \\sqrt{10}}{3}\\sin u\\big|_{0}^{\\frac{\\pi}{3}} \\\\  & =- \\frac{2 \\sqrt{10}}{3}[\\sin\\left(\\frac{\\pi}{3}\\right)-\\sin(0)] \\\\  & =- \\frac{2 \\sqrt{10}}{3}[\\left(\\frac{\\sqrt{3}}{2}\\right)-(0)] \\\\  & =\\left(- \\frac{\\sqrt{30}}{3}\\right)-(0) \\\\  & =- \\frac{\\sqrt{30}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd13bde-6d9e-5c3e-a4e5-cbd2a122ea69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{72}" :db/id #edb/ref 17592186701102} {:answer/id #uuid "54b220d4-3608-58cb-9d7f-6065d629f80a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{72}" :db/id #edb/ref 17592186701108} {:answer/id #uuid "8567bcad-90d3-51dd-ad8a-5da667384e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{24}" :db/id #edb/ref 17592186701117} {:answer/id #uuid "9f0f8bf8-39e8-514b-a0ba-920b358a7e31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3125}{72}" :db/id #edb/ref 17592186701120} {:answer/id #uuid "ba61f66e-7d07-534c-a9db-793099510320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{625}{72}" :db/id #edb/ref 17592186701125}] :answer-field/correct {:answer/id #uuid "0fd13bde-6d9e-5c3e-a4e5-cbd2a122ea69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{72}" :db/id #edb/ref 17592186701102} :answer-field/id #uuid "0e8991dd-c0bc-5bd8-8dde-990f2b621f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701101}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4b2c3d27-3ea7-5c92-afe5-8617224ddffe" :question/problem "Evaluate the line integral of $f(x,y)=\\frac{x^{2}}{3} + \\frac{y^{2}}{3}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 \\sin{\\left(t \\right)},- 4 \\sin{\\left(t \\right)}\\rangle,\\qquad 0\\le t\\le \\frac{\\pi}{6}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 \\sin{\\left(t \\right)})\\,i+(- 4 \\sin{\\left(t \\right)})\\,j$, then along the curve we have $x=3 \\sin{\\left(t \\right)}$, $y=- 4 \\sin{\\left(t \\right)}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 \\sin{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(- 4 \\sin{\\left(t \\right)})\\,j \\\\  & =(3 \\cos{\\left(t \\right)})\\,i+(- 4 \\cos{\\left(t \\right)})\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(3 \\cos{\\left(t \\right)})^2+(- 4 \\cos{\\left(t \\right)})^2} \\\\  & =\\sqrt{9\\cos^2 t+16\\cos^2 t} \\\\  & =\\sqrt{25 \\cos^{2}{\\left(t \\right)}} \\\\  & =5|\\cos t| \\\\  & =5 \\cos{\\left(t \\right)}\\end{aligned}\n$$\n\nNotice that $|\\cos t|=\\cos t$ because $\\cos t\\geq0$ along this interval.\n\nNow, since $f(x,y)=\\frac{x^{2}}{3} + \\frac{y^{2}}{3}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(3 \\sin{\\left(t \\right)})^2+(- 4 \\sin{\\left(t \\right)})^2}{3} \\\\  & =\\frac{9\\sin^2 t+16\\sin^2 t}{3} \\\\  & =\\frac{25 \\sin^{2}{\\left(t \\right)}}{3}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}\\left(\\frac{25 \\sin^{2}{\\left(t \\right)}}{3}\\right)(5 \\cos{\\left(t \\right)})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}\\frac{125 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)}}{3}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\sin{\\left(t \\right)}$, $\\text{d}u=(\\cos{\\left(t \\right)})\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{0}^{\\frac{1}{2}}\\frac{125}{3}\\cdot u^2\\,\\text{d}u \\\\  & =\\frac{125}{3}\\cdot\\frac{u^3}{3}\\big|_{0}^{\\frac{1}{2}} \\\\  & =\\frac{125}{3}[\\frac{\\left(\\frac{1}{2}\\right)^3}{3}-\\frac{(0)^3}{3}] \\\\  & =\\frac{125}{3}[\\left(\\frac{1}{24}\\right)-(0)] \\\\  & =\\left(\\frac{125}{72}\\right)-(0) \\\\  & =\\frac{125}{72}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06158c03-ef05-5409-9ac8-f73d9749fbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8 + 40 \\sqrt{5}" :db/id #edb/ref 17592186701099} {:answer/id #uuid "0b0ce4d1-90ce-5db7-8997-b8bd971a4bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1 + 5 \\sqrt{5}" :db/id #edb/ref 17592186701100} {:answer/id #uuid "6577e98f-c01f-5036-9610-cf43ba099268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3 + 3 \\sqrt{5}" :db/id #edb/ref 17592186701109} {:answer/id #uuid "a444553b-54ec-5e76-8cfe-9a028678e08c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 \\sqrt{5}" :db/id #edb/ref 17592186701121} {:answer/id #uuid "ae67a166-2f28-5b07-9daa-8225ac05f162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 \\sqrt{5} - 1" :db/id #edb/ref 17592186701122}] :answer-field/correct {:answer/id #uuid "0b0ce4d1-90ce-5db7-8997-b8bd971a4bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1 + 5 \\sqrt{5}" :db/id #edb/ref 17592186701100} :answer-field/id #uuid "6b32729f-62f7-5c6a-9f09-f07262bf1480" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701111}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ebba8f89-10fd-53f6-ae01-20f0665c8bb8" :question/problem "Evaluate the line integral of $f(x,y,z)=6 y z \\cos{\\left(x \\right)}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle t,2 \\sin{\\left(t \\right)},1\\rangle,\\qquad 0\\le t\\le \\frac{\\pi}{2}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t)\\,i+(2 \\sin{\\left(t \\right)})\\,j+(1)\\,k$, then along the curve we have $x=t$, $y=2 \\sin{\\left(t \\right)}$, $z=1$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2 \\sin{\\left(t \\right)})\\,j+\\frac{\\text{d}}{\\text{d}t}(1)\\,k \\\\  & =(1)\\,i+(2 \\cos{\\left(t \\right)})\\,j+(0)\\,k \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(1)^2+(2 \\cos{\\left(t \\right)})^2+(0)^2} \\\\  & =\\sqrt{4 \\cos^{2}{\\left(t \\right)} + 1}\\end{aligned}\n$$\n\nThe substitution decreases from $5$ to $1$; its differential includes the negative sign.\n\nNow, since $f(x,y,z)=6 y z \\cos{\\left(x \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(6)(2 \\sin{\\left(t \\right)})(1)\\cos(t) \\\\  & =12 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}(12 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})(\\sqrt{4 \\cos^{2}{\\left(t \\right)} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 \\cos^{2}{\\left(t \\right)} + 1$, $\\text{d}u=(- 8 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)})\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{5}^{1}- \\frac{3}{2}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =- \\frac{3}{2}\\cdot\\frac{2}{3}u^{3/2}\\big|_{5}^{1} \\\\  & =-1[(1)^{3/2}-(5)^{3/2}] \\\\  & =-1[(1)-(5 \\sqrt{5})] \\\\  & =(-1)-(- 5 \\sqrt{5}) \\\\  & =-1 + 5 \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68403796-d86c-5756-ad00-929997713088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{392}{3}" :db/id #edb/ref 17592186701110} {:answer/id #uuid "84eda34b-9b85-5fa2-b2e6-4c6b33d30b5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{18}" :db/id #edb/ref 17592186701116} {:answer/id #uuid "8edd16a1-f539-5afd-b612-572481bfe3b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{8}" :db/id #edb/ref 17592186701119} {:answer/id #uuid "b496069c-ddfe-57c4-bdc7-82e9f83ea52d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{12}" :db/id #edb/ref 17592186701124} {:answer/id #uuid "e4e80ddc-b3f7-5452-a220-2aa58dacfa2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{384}" :db/id #edb/ref 17592186701128}] :answer-field/correct {:answer/id #uuid "b496069c-ddfe-57c4-bdc7-82e9f83ea52d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{12}" :db/id #edb/ref 17592186701124} :answer-field/id #uuid "e23be7fa-2880-5455-8c9c-47e6675e9a26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701127}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f47d5754-f9f9-5af1-bf49-5dbec9336f19" :question/problem "Evaluate the line integral of $f(x,y)=\\frac{x}{y}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 2 t^{2},t\\rangle,\\qquad \\frac{\\sqrt{2}}{2}\\le t\\le \\frac{\\sqrt{6}}{2}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(2 t^{2})\\,i+(t)\\,j$, then along the curve we have $x=2 t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2 t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(4 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(4 t)^2+(1)^2} \\\\  & =\\sqrt{16 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{x}{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{1(2 t^{2})}{(t)-(0)} \\\\  & =\\frac{2t^2}{t} \\\\  & =2 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{\\frac{\\sqrt{2}}{2}}^{\\frac{\\sqrt{6}}{2}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\frac{\\sqrt{2}}{2}}^{\\frac{\\sqrt{6}}{2}}(2 t)(\\sqrt{16 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=16 t^{2} + 1$, $\\text{d}u=(32 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{9}^{25}\\frac{1}{16}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{16}\\cdot\\frac{2}{3}u^{3/2}\\big|_{9}^{25} \\\\  & =\\frac{1}{24}[(25)^{3/2}-(9)^{3/2}] \\\\  & =\\frac{1}{24}[(125)-(27)] \\\\  & =\\left(\\frac{125}{24}\\right)-\\left(\\frac{9}{8}\\right) \\\\  & =\\frac{49}{12}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01009da4-370b-5ce5-8ccc-74197a1dff1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15 + 30 \\sqrt{2}" :db/id #edb/ref 17592186701098} {:answer/id #uuid "1aae5798-19c4-5aaf-a6bc-46c03e97ed98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60 + 120 \\sqrt{2}" :db/id #edb/ref 17592186701103} {:answer/id #uuid "319c08a0-75b5-59bc-85b4-981834b86e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45 + 45 \\sqrt{2}" :db/id #edb/ref 17592186701104} {:answer/id #uuid "7b89ca8b-294a-500b-a972-43919c50fac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30 \\sqrt{2}" :db/id #edb/ref 17592186701113} {:answer/id #uuid "7dbe161f-d8b6-52c0-aef3-1ff05ee5c560" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15 + 30 \\sqrt{2}" :db/id #edb/ref 17592186701114}] :answer-field/correct {:answer/id #uuid "01009da4-370b-5ce5-8ccc-74197a1dff1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15 + 30 \\sqrt{2}" :db/id #edb/ref 17592186701098} :answer-field/id #uuid "c5280cd8-53ba-59ac-b0c8-0114bf4aec72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701126}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fa78e628-a7ee-5030-809b-cc919281c9c1" :question/problem "Evaluate the line integral of $f(x,y)=x^{3} + 3 y$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 t,t^{3}\\rangle,\\qquad 0\\le t\\le 1.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 t)\\,i+(t^{3})\\,j$, then along the curve we have $x=3 t$, $y=t^{3}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{3})\\,j \\\\  & =(3)\\,i+(3 t^{2})\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(3)^2+(3 t^{2})^2} \\\\  & =\\sqrt{9 t^{4} + 9} \\\\  & =3 \\sqrt{t^{4} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x^{3} + 3 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(3 t)^3+(3)(t^{3}) \\\\  & =27t^3+3t^3 \\\\  & =30 t^{3}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{1}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(30 t^{3})(3 \\sqrt{t^{4} + 1})\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}90 t^{3} \\sqrt{t^{4} + 1}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=t^{4} + 1$, $\\text{d}u=(4 t^{3})\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{1}^{2}\\frac{45}{2}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{45}{2}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{2} \\\\  & =15[(2)^{3/2}-(1)^{3/2}] \\\\  & =15[(2 \\sqrt{2})-(1)] \\\\  & =(30 \\sqrt{2})-(15) \\\\  & =-15 + 30 \\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50353aaf-1d2d-5e34-876a-04c046254a47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}- 2 t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right) \\sqrt{\\sin^{2}{\\left(t \\right)} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701144} {:answer/id #uuid "61d9d043-0828-580d-a163-581de3791b11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}- \\sqrt{5} \\left(- \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) \\left(\\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701147} {:answer/id #uuid "6b626c50-2a3a-5339-b6f8-e48d23b16df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}- 10 t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701148} {:answer/id #uuid "7167ff2e-3275-5c6e-beb1-12745dd4c0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}2 \\sqrt{5} t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701152} {:answer/id #uuid "8545d34d-fd29-5791-bba6-218df07d93a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}- 2 \\sqrt{5} t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701155}] :answer-field/correct {:answer/id #uuid "8545d34d-fd29-5791-bba6-218df07d93a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}- 2 \\sqrt{5} t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701155} :answer-field/id #uuid "b738fe8d-3cd1-5d86-9fe6-8c0129f909ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701159}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "06cef0e0-6c87-53c8-bad9-536d5e6224f4" :question/problem "Which of the following is equivalent to $\\int_C f\\,\\mathrm{d}s$, where $f(x,y,z)=- z \\left(x^{2} - y^{2}\\right)$ and\n\n$$\n\\mathbf r(t)=\\langle \\cos{\\left(t \\right)}, \\sin{\\left(t \\right)}, 2 t\\rangle,\\qquad \\frac{\\pi}{6}\\le t\\le \\frac{\\pi}{3}.\n$$\n\nDo not evaluate the integral." :question/worked-solution "Differentiate each coordinate and compute the speed:\n\n$$\n\\begin{aligned}\\mathbf r'(t)&=\\langle - \\sin{\\left(t \\right)}, \\cos{\\left(t \\right)}, 2\\rangle \\\\ \\|\\mathbf r'(t)\\|&=\\sqrt{(- \\sin{\\left(t \\right)})^2+(\\cos{\\left(t \\right)})^2+(2)^2}=\\sqrt{5}\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the scalar function:\n\n$$\n\\begin{aligned}f(\\mathbf r(t))&=- 2 t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right)\\end{aligned}\n$$\n\nMultiply by speed and retain the parameter bounds:\n\n$$\n\\begin{aligned}\\int_C f\\,\\mathrm{d}s&=\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}(- 2 t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right))(\\sqrt{5})\\,\\mathrm{d}t \\\\ &=\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}- 2 \\sqrt{5} t \\left(- \\sin^{2}{\\left(t \\right)} + \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2986c895-77c7-5b80-ac73-87ff1f1e9c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{2} \\sqrt{2 t^{2} + 1} \\left(2 t^{2} + 6 t + 3\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701140} {:answer/id #uuid "3c0f2905-ea03-5965-96ef-91cffe4fe0d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{2} \\left(4 t^{2} + 12 t + 6\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701142} {:answer/id #uuid "40c45621-bded-55fc-a183-a4feacc6b4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\frac{4 t^{2} + 12 t + 6}{\\sqrt{4 t^{2} + 2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701143} {:answer/id #uuid "6bab3647-37fa-5aee-921d-d07e8ab60ca3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}4 \\sqrt{2} \\sqrt{2 t^{2} + 1} \\left(2 t^{2} + 6 t + 3\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701149} {:answer/id #uuid "d462e50a-ffc9-5be3-834f-d93627e17f86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}2 \\sqrt{2} \\sqrt{2 t^{2} + 1} \\left(2 t^{2} + 6 t + 3\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701161}] :answer-field/correct {:answer/id #uuid "d462e50a-ffc9-5be3-834f-d93627e17f86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}2 \\sqrt{2} \\sqrt{2 t^{2} + 1} \\left(2 t^{2} + 6 t + 3\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701161} :answer-field/id #uuid "6d29e5b3-41d9-5b4c-b067-28d9535cba79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701151}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1879b8cc-5a5e-508f-be16-9d5510805331" :question/problem "Which of the following is equivalent to $\\int_C f\\,\\mathrm{d}s$, where $f(x,y,z)=4 x - 2 y^{2} + 2 z^{2}$ and\n\n$$\n\\mathbf r(t)=\\langle t^{2}, t - 1, t + 2\\rangle,\\qquad 0\\le t\\le 2.\n$$\n\nDo not evaluate the integral." :question/worked-solution "Differentiate each coordinate and compute the speed:\n\n$$\n\\begin{aligned}\\mathbf r'(t)&=\\langle 2 t, 1, 1\\rangle \\\\ \\|\\mathbf r'(t)\\|&=\\sqrt{(2 t)^2+(1)^2+(1)^2}=\\sqrt{4 t^{2} + 2}\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the scalar function:\n\n$$\n\\begin{aligned}f(\\mathbf r(t))&=4 t^{2} - 2 \\left(t - 1\\right)^{2} + 2 \\left(t + 2\\right)^{2} \\\\ &=4 t^{2} + 12 t + 6\\end{aligned}\n$$\n\nMultiply by speed and retain the parameter bounds:\n\n$$\n\\begin{aligned}\\int_C f\\,\\mathrm{d}s&=\\int_{0}^{2}f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{2}(4 t^{2} + 12 t + 6)(\\sqrt{4 t^{2} + 2})\\,\\mathrm{d}t \\\\ &=\\int_{0}^{2}2 \\sqrt{2} \\sqrt{2 t^{2} + 1} \\left(2 t^{2} + 6 t + 3\\right)\\,\\mathrm{d}t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077aa32a-31c5-57ba-a95b-ed5bff9d13d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 2 \\sqrt{3} t \\left(t^{2} + 4\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701134} {:answer/id #uuid "0ea504f6-6ca4-5497-a0fe-b0c9f1ebd9aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 \\sqrt{3} t^{3}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701135} {:answer/id #uuid "3785e427-f438-5221-9599-355d3230d8b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 \\sqrt{3} t \\left(- 3 t^{2} - 4\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701141} {:answer/id #uuid "5de3181f-2900-560f-a49d-fe31a895736e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 4 \\sqrt{3} t\\,\\mathrm{d}t" :db/id #edb/ref 17592186701145} {:answer/id #uuid "de647d1c-c534-5d4e-a438-9f2c47b062fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 \\sqrt{3} t \\left(t^{2} + 4\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701163}] :answer-field/correct {:answer/id #uuid "077aa32a-31c5-57ba-a95b-ed5bff9d13d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 2 \\sqrt{3} t \\left(t^{2} + 4\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186701134} :answer-field/id #uuid "89f5d64a-6733-5cf0-824f-9b67d864a528" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701156}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1aefc51e-f08b-50b1-9cae-5aa95c2197d9" :question/problem "Which of the following is equivalent to $\\int_C f\\,\\mathrm{d}s$, where $f(x,y,z)=- x + y - z$ and\n\n$$\n\\mathbf r(t)=\\langle t^{2} + 2, t^{2} - 2, t^{2}\\rangle,\\qquad 1\\le t\\le 3.\n$$\n\nDo not evaluate the integral." :question/worked-solution "Differentiate each coordinate and compute the speed:\n\n$$\n\\begin{aligned}\\mathbf r'(t)&=\\langle 2 t, 2 t, 2 t\\rangle \\\\ \\|\\mathbf r'(t)\\|&=\\sqrt{(2 t)^2+(2 t)^2+(2 t)^2}=2 \\sqrt{3} \\left|{t}\\right|=2 \\sqrt{3} t\\end{aligned}\n$$\n\nSince $t\\ge0$ on this interval, $|t|=t$.\n\nSubstitute the coordinates into the scalar function:\n\n$$\n\\begin{aligned}f(\\mathbf r(t))&=- t^{2} - 4\\end{aligned}\n$$\n\nMultiply by speed and retain the parameter bounds:\n\n$$\n\\begin{aligned}\\int_C f\\,\\mathrm{d}s&=\\int_{1}^{3}f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}(- t^{2} - 4)(2 \\sqrt{3} t)\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}- 2 \\sqrt{3} t \\left(t^{2} + 4\\right)\\,\\mathrm{d}t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11578966-dad8-55fd-a7c8-b3580f83a4a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}4 t^{2} \\sqrt{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701136} {:answer/id #uuid "5fe30986-9361-5b19-a7d1-e6952b890d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}0\\,\\mathrm{d}t" :db/id #edb/ref 17592186701146} {:answer/id #uuid "7f20b52b-ea1f-5ba5-9dec-f422493a98a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}4 \\sqrt{2} t^{2} \\sqrt{2 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701153} {:answer/id #uuid "956ba843-b679-5ccd-b5fd-e1729db61ed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 4 \\sqrt{2} t^{2} \\sqrt{2 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701158} {:answer/id #uuid "c59ec794-752c-5ccf-816b-4e289ebce786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 \\sqrt{2} t^{2} \\sqrt{2 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701160}] :answer-field/correct {:answer/id #uuid "7f20b52b-ea1f-5ba5-9dec-f422493a98a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}4 \\sqrt{2} t^{2} \\sqrt{2 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701153} :answer-field/id #uuid "f4f04940-df48-5773-a7dd-3756eed66d2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701166}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f18930a8-1dc1-5601-aab8-e288833c0a7f" :question/problem "Which of the following is equivalent to $\\int_C f\\,\\mathrm{d}s$, where $f(x,y,z)=4 x - 2 y^{2} + 2 z^{2}$ and\n\n$$\n\\mathbf r(t)=\\langle t^{2}, t - 1, t - 1\\rangle,\\qquad 1\\le t\\le 3.\n$$\n\nDo not evaluate the integral." :question/worked-solution "Differentiate each coordinate and compute the speed:\n\n$$\n\\begin{aligned}\\mathbf r'(t)&=\\langle 2 t, 1, 1\\rangle \\\\ \\|\\mathbf r'(t)\\|&=\\sqrt{(2 t)^2+(1)^2+(1)^2}=\\sqrt{4 t^{2} + 2}\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the scalar function:\n\n$$\n\\begin{aligned}f(\\mathbf r(t))&=4 t^{2}\\end{aligned}\n$$\n\nMultiply by speed and retain the parameter bounds:\n\n$$\n\\begin{aligned}\\int_C f\\,\\mathrm{d}s&=\\int_{1}^{3}f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}(4 t^{2})(\\sqrt{4 t^{2} + 2})\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}4 \\sqrt{2} t^{2} \\sqrt{2 t^{2} + 1}\\,\\mathrm{d}t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f2d200-408d-5fd6-a711-709f9dd912a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- \\frac{2 \\sqrt{2} t^{2}}{\\sqrt{8 t^{2} + 2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701138} {:answer/id #uuid "6c3d6672-2b5f-5af7-9cbb-f8e96a6b6cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 2 \\sqrt{2} t^{2} \\sqrt{4 t^{2} + 4 t + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701150} {:answer/id #uuid "838b426a-ef61-58ca-942d-e2e62239773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 4 t^{2} \\sqrt{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701154} {:answer/id #uuid "8c26a017-1d31-5db0-ab58-36ad2ec6acb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 2 \\sqrt{2} t^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701157} {:answer/id #uuid "ef2ba5af-b285-533c-9a89-495bb94aa5ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}4 t^{2} \\sqrt{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701164}] :answer-field/correct {:answer/id #uuid "838b426a-ef61-58ca-942d-e2e62239773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}- 4 t^{2} \\sqrt{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186701154} :answer-field/id #uuid "da2d23f0-54af-5b6a-a440-ce5f1280661c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701162}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9c50a56-1f64-5c9c-b90b-5315a107bf76" :question/problem "Which of the following is equivalent to $\\int_C f\\,\\mathrm{d}s$, where $f(x,y)=- \\sqrt{2} \\left(x + y\\right)$ and\n\n$$\n\\mathbf r(t)=\\langle t^{2} + t, t^{2} - t\\rangle,\\qquad 1\\le t\\le 3.\n$$\n\nDo not evaluate the integral." :question/worked-solution "Differentiate each coordinate and compute the speed:\n\n$$\n\\begin{aligned}\\mathbf r'(t)&=\\langle 2 t + 1, 2 t - 1\\rangle \\\\ \\|\\mathbf r'(t)\\|&=\\sqrt{(2 t + 1)^2+(2 t - 1)^2}=\\sqrt{8 t^{2} + 2}\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the scalar function:\n\n$$\n\\begin{aligned}f(\\mathbf r(t))&=- 2 \\sqrt{2} t^{2}\\end{aligned}\n$$\n\nMultiply by speed and retain the parameter bounds:\n\n$$\n\\begin{aligned}\\int_C f\\,\\mathrm{d}s&=\\int_{1}^{3}f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}(- 2 \\sqrt{2} t^{2})(\\sqrt{8 t^{2} + 2})\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}- 4 t^{2} \\sqrt{4 t^{2} + 1}\\,\\mathrm{d}t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0253f9a9-1999-5d2d-9cd7-a95e9c30065c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\sqrt{2}" :db/id #edb/ref 17592186701228} {:answer/id #uuid "9b1045b0-2267-59ca-8d9a-fc4e25901316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 \\sqrt{2}" :db/id #edb/ref 17592186701250} {:answer/id #uuid "b200726c-d268-599c-adff-f0dc84bfa192" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 \\sqrt{2}" :db/id #edb/ref 17592186701252} {:answer/id #uuid "e4133d2e-b597-58b5-8656-6be43cf8d20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186701256} {:answer/id #uuid "fd96ca14-604d-5666-8e84-2536196e1993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\sqrt{2}" :db/id #edb/ref 17592186701260}] :answer-field/correct {:answer/id #uuid "e4133d2e-b597-58b5-8656-6be43cf8d20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186701256} :answer-field/id #uuid "513597aa-1f84-57c5-9881-471ea261f161" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701237}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f8f7a1c-9176-5eaf-8c93-3a57b1efcfbe" :question/problem "Evaluate the line integral\n\n$$\n\\int_C (- x - y)\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is parametrized by\n\n$$\n\\mathbf r(t)=\\langle t, t - 2\\rangle.\n$$\n\nThe parameter interval is $0\\leq t\\leq 2$." :question/worked-solution "Use the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nDifferentiate both coordinates and compute the speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 1, 1\\rangle \\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(1)^2+(1)^2} \\\\\n&=\\sqrt{2}\n\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the density:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=(-1)\\left((t)+(t - 2)\\right) \\\\\n&=2 - 2 t\n\\end{aligned}\n$$\n\nMultiply by the speed and integrate, subtracting the lower endpoint:\n\n$$\n\\begin{aligned}\n\\int_C f\\,\\mathrm{d}s&=\\int_{0}^{2} (2 - 2 t)\\cdot (\\sqrt{2})\\,\\mathrm{d}t \\\\\n&=\\int_{0}^{2} - 2 \\sqrt{2} t + 2 \\sqrt{2}\\,\\mathrm{d}t \\\\\n&=\\left[- \\sqrt{2} t^{2} + 2 \\sqrt{2} t\\right]_{0}^{2} \\\\\n&=(0)-(0) \\\\\n&=0\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0234f1b2-7341-5d16-82b0-94c236a82a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186701227} {:answer/id #uuid "2219f01b-b18f-5a82-a0ed-94ce9e73db52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{2}" :db/id #edb/ref 17592186701231} {:answer/id #uuid "506ff0a4-8ab7-5ce1-aca4-e45fc58b7fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "700" :db/id #edb/ref 17592186701236} {:answer/id #uuid "5e5d3ea5-6fba-5961-bcbb-43811b21bc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186701240} {:answer/id #uuid "eca721d3-f0a2-5277-aaba-777affb55d1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "140" :db/id #edb/ref 17592186701257}] :answer-field/correct {:answer/id #uuid "eca721d3-f0a2-5277-aaba-777affb55d1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "140" :db/id #edb/ref 17592186701257} :answer-field/id #uuid "99813db2-b389-5c79-a9f3-4eb0eff3c908" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701249}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5a5f6284-da0d-5d68-855c-e63320e30895" :question/problem "Evaluate the line integral\n\n$$\n\\int_C (x y)\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is parametrized by\n\n$$\n\\mathbf r(t)=\\langle 3 t, 4 t\\rangle.\n$$\n\nThe parameter interval is $1\\leq t\\leq 2$." :question/worked-solution "Use the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nDifferentiate both coordinates and compute the speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 3, 4\\rangle \\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(3)^2+(4)^2} \\\\\n&=5\n\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the density:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=(1)(3 t)(4 t) \\\\\n&=12 t^{2}\n\\end{aligned}\n$$\n\nMultiply by the speed and integrate, subtracting the lower endpoint:\n\n$$\n\\begin{aligned}\n\\int_C f\\,\\mathrm{d}s&=\\int_{1}^{2} (12 t^{2})\\cdot (5)\\,\\mathrm{d}t \\\\\n&=\\int_{1}^{2} 60 t^{2}\\,\\mathrm{d}t \\\\\n&=\\left[20 t^{3}\\right]_{1}^{2} \\\\\n&=(160)-(20) \\\\\n&=140\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009d74e4-131a-5e80-855d-dc55d31c518d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186701226} {:answer/id #uuid "042abb56-6cda-5bd0-b2fb-9c84391184d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-100" :db/id #edb/ref 17592186701229} {:answer/id #uuid "240d53c1-4cf2-5353-b9ec-32cdc394f492" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186701232} {:answer/id #uuid "3015e7da-8b4d-5657-a755-1e5462949d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186701234} {:answer/id #uuid "5e855ec7-6fe7-507c-b9bd-4fc01100720f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186701241}] :answer-field/correct {:answer/id #uuid "3015e7da-8b4d-5657-a755-1e5462949d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186701234} :answer-field/id #uuid "2a07e499-2f5f-55ed-82d9-590b37f74080" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701233}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5b1ea91e-9d88-58b0-bec1-2304e482a0d9" :question/problem "Evaluate the line integral\n\n$$\n\\int_C (x y)\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is parametrized by\n\n$$\n\\mathbf r(t)=\\langle 4 t, - 3 t\\rangle.\n$$\n\nThe parameter interval is $-1\\leq t\\leq 0$." :question/worked-solution "Use the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nDifferentiate both coordinates and compute the speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 4, -3\\rangle \\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(4)^2+(-3)^2} \\\\\n&=5\n\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the density:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=(1)(4 t)(- 3 t) \\\\\n&=- 12 t^{2}\n\\end{aligned}\n$$\n\nMultiply by the speed and integrate, subtracting the lower endpoint:\n\n$$\n\\begin{aligned}\n\\int_C f\\,\\mathrm{d}s&=\\int_{-1}^{0} (- 12 t^{2})\\cdot (5)\\,\\mathrm{d}t \\\\\n&=\\int_{-1}^{0} - 60 t^{2}\\,\\mathrm{d}t \\\\\n&=\\left[- 20 t^{3}\\right]_{-1}^{0} \\\\\n&=(0)-(20) \\\\\n&=-20\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f043e73-c321-5139-bd14-1cea125561b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\sqrt{2}" :db/id #edb/ref 17592186701235} {:answer/id #uuid "755d38ff-5fa3-530f-a7fc-6e31bb96bcb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186701244} {:answer/id #uuid "80146906-48d2-51bd-a3e2-985fee2b8ed4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186701246} {:answer/id #uuid "88b9cc6b-4488-5219-b8a9-791f8491f44e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\sqrt{2}" :db/id #edb/ref 17592186701247} {:answer/id #uuid "e390d171-4b23-59ab-be2a-4de6b906b34f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 \\sqrt{2}" :db/id #edb/ref 17592186701255}] :answer-field/correct {:answer/id #uuid "88b9cc6b-4488-5219-b8a9-791f8491f44e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\sqrt{2}" :db/id #edb/ref 17592186701247} :answer-field/id #uuid "97d91aee-14df-567c-b34a-f22495870ec7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701248}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "624e330f-d314-5f54-b5ec-8ef7b5a37d32" :question/problem "Evaluate the line integral\n\n$$\n\\int_C \\left(\\frac{2}{- x + y}\\right)\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is parametrized by\n\n$$\n\\mathbf r(t)=\\langle - t, - t - 2\\rangle.\n$$\n\nThe parameter interval is $1\\leq t\\leq 2$." :question/worked-solution "Use the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nDifferentiate both coordinates and compute the speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle -1, -1\\rangle \\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(-1)^2+(-1)^2} \\\\\n&=\\sqrt{2}\n\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the density:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=\\frac{2}{(- t - 2)-(- t)} \\\\\n&=\\frac{2}{-2}=-1\n\\end{aligned}\n$$\n\nMultiply by the speed and integrate, subtracting the lower endpoint:\n\n$$\n\\begin{aligned}\n\\int_C f\\,\\mathrm{d}s&=\\int_{1}^{2} (-1)\\cdot (\\sqrt{2})\\,\\mathrm{d}t \\\\\n&=\\int_{1}^{2} - \\sqrt{2}\\,\\mathrm{d}t \\\\\n&=\\left[- \\sqrt{2} t\\right]_{1}^{2} \\\\\n&=(- 2 \\sqrt{2})-(- \\sqrt{2}) \\\\\n&=- \\sqrt{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186701259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6701f7b5-6e06-5d46-99ef-f9da80d8c5e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186701243} {:answer/id #uuid "7b665255-5de0-50e5-b3b3-b6f83b50b3c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3}{4}" :db/id #edb/ref 17592186701245} {:answer/id #uuid "b101feba-24a0-5bb8-a768-4c1fec158d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186701251} {:answer/id #uuid "bc7ac308-f685-5b73-ae77-c66a563d7c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 24 \\sqrt{2}" :db/id #edb/ref 17592186701253} {:answer/id #uuid "da884269-c984-5725-8fa2-c456120dfb3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186701254}] :answer-field/correct {:answer/id #uuid "b101feba-24a0-5bb8-a768-4c1fec158d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186701251} :answer-field/id #uuid "edceef6a-f3a8-5d96-a4c9-d8d978da989e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701258}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f999aab5-a72a-5db8-a33d-e57d346d525e" :question/problem "Evaluate the line integral\n\n$$\n\\int_C \\left(\\frac{1}{- x + y}\\right)\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is parametrized by\n\n$$\n\\mathbf r(t)=\\langle - 2 t, - 2 t - 4\\rangle.\n$$\n\nThe parameter interval is $1\\leq t\\leq 4$." :question/worked-solution "Use the scalar line-integral formula\n\n$$\n\\int_C f\\,\\mathrm{d}s=\\int_a^b f(\\mathbf r(t))\\,\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nDifferentiate both coordinates and compute the speed:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle -2, -2\\rangle \\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{(-2)^2+(-2)^2} \\\\\n&=2 \\sqrt{2}\n\\end{aligned}\n$$\n\n\n\nSubstitute the coordinates into the density:\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))&=\\frac{1}{(- 2 t - 4)-(- 2 t)} \\\\\n&=\\frac{1}{-4}=- \\frac{1}{4}\n\\end{aligned}\n$$\n\nMultiply by the speed and integrate, subtracting the lower endpoint:\n\n$$\n\\begin{aligned}\n\\int_C f\\,\\mathrm{d}s&=\\int_{1}^{4} \\left(- \\frac{1}{4}\\right)\\cdot (2 \\sqrt{2})\\,\\mathrm{d}t \\\\\n&=\\int_{1}^{4} - \\frac{\\sqrt{2}}{2}\\,\\mathrm{d}t \\\\\n&=\\left[- \\frac{\\sqrt{2} t}{2}\\right]_{1}^{4} \\\\\n&=(- 2 \\sqrt{2})-\\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\\n&=- \\frac{3 \\sqrt{2}}{2}\n\\end{aligned}\n$$"}]}
