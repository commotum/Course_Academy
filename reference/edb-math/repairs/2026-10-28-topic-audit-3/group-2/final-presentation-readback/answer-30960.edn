17592186717697}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186717699}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186717700}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186717701}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186717704}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186717705}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186717706}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186717708}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186717709}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186717711}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186717715}] [{:answer/feedback "This side has a horizontal normal. Use the $\\mathbf i$ component rather than the $\\mathbf j$ component." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-xy" :db/id #edb/ref 17592186717790}] [{:answer/feedback "This uses the inward normal $\\mathbf i.$ The outward normal on the left side is $-\\mathbf i.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^2+y" :db/id #edb/ref 17592186717791}] [{:answer/feedback "The normal is $-\\mathbf i,$ so negate the entire $\\mathbf i$ component: $-(x^2+y)=-x^2-y.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^2-y" :db/id #edb/ref 17592186717794}] [{:answer/feedback "Check $C_4.$ Its outward normal is $-\\mathbf j,$ giving $g_4=-(x-y)=y-x.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(xy,\\ x-y,\\ -xy,\\ x-y\\right)" :db/id #edb/ref 17592186717795}] [{:answer/feedback "The two component products are $2x^2y$ and $-x^2y,$ which sum to $x^2y.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^2y" :db/id #edb/ref 17592186717796}] [{:answer/feedback "The second component is negative: the contributions are $2x^2y$ and $-x^2y.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x^2y" :db/id #edb/ref 17592186717797}] [{:answer/feedback "The $\\mathbf j$ component is tangent to the left side; its dot product with the horizontal normal is zero." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xy" :db/id #edb/ref 17592186717798}] [{:answer/feedback "The four normals are $\\mathbf i,\\mathbf j,-\\mathbf i,-\\mathbf j,$ in the stated order." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(xy,\\ x-y,\\ -xy,\\ y-x\\right)" :db/id #edb/ref 17592186717800}] [{:answer/feedback "Multiply the first component by $x/2$ and the second by $y/2$; the unit normal varies around the circle." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2xy-x^2" :db/id #edb/ref 17592186717801}] [{:answer/feedback "The left outward unit normal is $-\\mathbf i,$ so the dot product is $-(x^2+y).$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x^2-y" :db/id #edb/ref 17592186717802}] [{:answer/feedback "The second product is $(-2x^2)(y/2)=-x^2y.$ Do not interchange the roles of $x$ and $y.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x^2y-xy^2" :db/id #edb/ref 17592186717803}] [{:answer/feedback "Check $C_3.$ Its outward normal is $-\\mathbf i,$ giving $g_3=-xy.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(xy,\\ x-y,\\ xy,\\ y-x\\right)" :db/id #edb/ref 17592186717805}] [{:answer/feedback "Check $C_2.$ Its outward normal is $\\mathbf j,$ giving $g_2=x-y.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(xy,\\ y-x,\\ -xy,\\ y-x\\right)" :db/id #edb/ref 17592186717806}] [{:answer/feedback "Check $C_1.$ Its outward normal is $\\mathbf i,$ giving $g_1=xy.$" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(-xy,\\ x-y,\\ -xy,\\ y-x\\right)" :db/id #edb/ref 17592186717807}] [{:answer/feedback "Adding the components of the field alone does not give flux density. Take the dot product with the unit normal." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4xy-2x^2" :db/id #edb/ref 17592186717808}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[0,3]" :db/id #edb/ref 17592186717809}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-1,3]" :db/id #edb/ref 17592186717811}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-3,1]" :db/id #edb/ref 17592186717812}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-3,5]" :db/id #edb/ref 17592186717813}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-7,-1]" :db/id #edb/ref 17592186717815}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-12,-6]" :db/id #edb/ref 17592186717816}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-5,3]" :db/id #edb/ref 17592186717821}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-13,5]" :db/id #edb/ref 17592186717822}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-4,-1]" :db/id #edb/ref 17592186717823}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-2,2]" :db/id #edb/ref 17592186717824}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-1,3]" :db/id #edb/ref 17592186717825}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)\\in[-4,4]" :db/id #edb/ref 17592186717826}]}
