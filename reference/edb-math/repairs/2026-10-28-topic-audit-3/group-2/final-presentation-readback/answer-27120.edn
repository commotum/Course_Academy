499} :answer/value "true" :db/id #edb/ref 17592186699696}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186699700}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186699702}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186699704}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186699705}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186699706}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186699707}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186699711}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186699712}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186699713}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186699714}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186699716}] [{:answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186699717}] [{:answer/feedback "This gives only $Q_x$; also subtract $P_y=x$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2xy" :db/id #edb/ref 17592186699811}] [{:answer/feedback "This is $Q_y-P_x$. Scalar curl uses $Q_x-P_y$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^2+3y^2-2x-y" :db/id #edb/ref 17592186699812}] [{:answer/feedback "Each product derivative has two terms: $Q_x=\\ln 2+\\frac12$ and $P_y=e+e$ at $(1,1)$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac12-e" :db/id #edb/ref 17592186699813}] [{:answer/feedback "This evaluates $Q_x$ alone; subtract $P_y=2\\pi$ as well." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\pi" :db/id #edb/ref 17592186699815}] [{:answer/feedback "Correct: subtract $P_y=2e$ from $Q_x=\\ln 2+\\frac12$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 2+\\frac12-2e" :db/id #edb/ref 17592186699817}] [{:answer/feedback "Subtract $P_y=x$ from $Q_x=2xy$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2xy+x" :db/id #edb/ref 17592186699818}] [{:answer/feedback "The chain-rule term $Q_x=\\pi\\cos\\pi=-\\pi$ is nonzero." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\pi" :db/id #edb/ref 17592186699819}] [{:answer/feedback "Correct: $Q_x=2xy$ and $P_y=x$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2xy-x" :db/id #edb/ref 17592186699820}] [{:answer/feedback "The product rule gives $Q_x=\\ln(x+y)+x/(x+y)$; retain the $\\ln 2$ term." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac12-2e" :db/id #edb/ref 17592186699822}] [{:answer/feedback "This reverses the subtraction. Scalar curl is $Q_x-P_y$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pi" :db/id #edb/ref 17592186699824}] [{:answer/feedback "The product rule gives $P_y=e^{xy}+xy e^{xy}$, which is $2e$ at $(1,1)$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 2+\\frac12-e" :db/id #edb/ref 17592186699825}] [{:answer/feedback "Correct: $\\pi\\cos\\pi-2\\pi=-3\\pi$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\pi" :db/id #edb/ref 17592186699826}] [{:answer/feedback "Use $\\cos\\pi=-1$, so $\\pi\\cos\\pi-2\\pi=-3\\pi$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi" :db/id #edb/ref 17592186699827}] [{:answer/feedback "This is $P_y-Q_x$. Reverse the subtraction to obtain the scalar curl." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e-\\ln 2-\\frac12" :db/id #edb/ref 17592186699828}] [{:answer/feedback "This reverses the subtraction. Scalar curl is $Q_x-P_y$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2xy" :db/id #edb/ref 17592186699830}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/dc/dca5659208c862497f2052ddbd5d7672d6336d154c818900cc4fccec425dfec9.png" :db/id #edb/ref 17592186699895}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4c/4c86c3ffe220532d2e61d7d3eb43328131849ba0551aa197ab5c45e503c3ed5f.png" :db/id #edb/ref 17592186699896}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/fb/fb6f667089062d7c406a208dd2377f9941ce1d39e4206f78f7425f93c7252153.png" :db/id #edb/ref 17592186699897}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/47/47d19b0ab827362425b410fbb97374b1ff1e5fb615598893489b2c5cc7f61a65.png" :db/id #edb/ref 17592186699898}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e1/e1d69cfb0de2d24a16d10426d5632cb7d84bddb31628ae84336619cb0cdff9da.png" :db/id #edb/ref 17592186699902}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/59/59bf4b515e94e726d3af8a991cfdfd54927e994e664d87a757534bb430ed92c5.png" :db/id #edb/ref 17592186699903}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/aa/aa18b272c87bb5222ba7e66adc7524fc1c517892ba4342fef7a02d565f26c31c.png" :db/id #edb/ref 17592186699904}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/80/80baba867a547b0c71a308ecf0a051d10ec74e494731d00aac1bd42ea25e8a98.png" :db/id #edb/ref 17592186699907}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6d/6d9c8a73be1513468cd478684f4e81bd6a058ca847c023245004bdca47704bfd.png" :db/id #edb/ref 17592186699908}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c1/c1b4d360b19d0239c82bf7c4f03ddcfeb572c896ca9b86e06f2d58576bf6d58f.png" :db/id #edb/ref 17592186699910}] [{:answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3d/3dc1cb0a1fc04e960aa082f3519d346f2eb1229106ed76353cb95fbe4f91deb0.png" :db/id #edb/ref 17592186699912}] [{:answer/type {:db/id #edb/ref 17592186045497} :an