6}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac12" :db/id #edb/ref 17592186719897}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt5}{3}" :db/id #edb/ref 17592186719898}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186719902}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186719903}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186719908}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186719909}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186719910}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186719912}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186719913}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186719914}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186719915}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186719916}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186719918}] [{:answer/feedback "The scalar function $xy$ becomes $t e^t$, including the factor $t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719919}] [{:answer/feedback "The magnitude uses both coordinate derivatives: $\\sqrt{1+(2t)^2}$, not just $2t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}2t^3\\,\\mathrm{d}t" :db/id #edb/ref 17592186719920}] [{:answer/feedback "This substitutes $xy$ but omits the arc-length factor." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}t e^t\\,\\mathrm{d}t" :db/id #edb/ref 17592186719921}] [{:answer/feedback "Multiply the substituted scalar function by $\\sqrt{1+4t^2/(1+t^2)^2}$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\,\\mathrm{d}t" :db/id #edb/ref 17592186719922}] [{:answer/feedback "The limits must be $x$-values, so solve the two intersection equations on $x>0$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\ln 2}^{\\ln 5}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719924}] [{:answer/feedback "The $x$-bounds are $0$ and $1$, the scalar is $t e^t$, and the speed is $\\sqrt{1+e^{2t}}$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}t e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719926}] [{:answer/feedback "The arc-length factor uses the derivative $2t$, not the coordinate $t^2$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}t^2\\sqrt{1+t^4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719927}] [{:answer/feedback "The derivative of $\\ln(1+t^2)$ is $2t/(1+t^2)$; include the chain-rule numerator before squaring." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{1}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719929}] [{:answer/feedback "Square $y\\,\\!{}^{\\prime}(t)=e^t$ inside the speed: $(e^t)^2=e^{2t}$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}t e^t\\sqrt{1+e^t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719930}] [{:answer/feedback "Here $y=t^2$ and $\\mathrm{d}s=\\sqrt{1+4t^2}\\,\\mathrm{d}t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}t^2\\sqrt{1+4t^2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719932}] [{:answer/feedback "The term $-y$ becomes $-\\ln(1+t^2)$, not $-t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-t\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719933}] [{:answer/feedback "Include the arc-length factor $\\|\\mathbf r\\,\\!{}^{\\prime}(t)\\|=\\sqrt{1+4t^2}$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}t^2\\,\\mathrm{d}t" :db/id #edb/ref 17592186719935}] [{:answer/feedback "For $t=x$, solve $e^x=1$ and $e^x=e$; the limits are $0$ and $1$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{e}t e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719936}] [{:answer/feedback "The scalar function is $y=t^2$, not $x=t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{0}^{1}t\\sqrt{1+4t^2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719938}] [{:answer/feedback "The bounds, substituted scalar function, and chain-rule arc-length factor all agree." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719939}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "48 e^{12}" :db/id #edb/ref 17592186719940}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186719941}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 \\pi + 4 \\pi^{2}" :db/id #edb/ref 17592186719943}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186719945}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "36 e^{12}" :db/id #edb/ref 17592186719946}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{12}{e^{2}}" :db/id #edb/ref 17592186719947}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186719948}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186719950}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 8 \\pi + 4 \\pi^{2}" :db/id #edb/ref 17592186719951}] [{:an