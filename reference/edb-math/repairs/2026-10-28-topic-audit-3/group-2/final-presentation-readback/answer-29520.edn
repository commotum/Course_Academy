f 17592186708989}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186708990}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186708991}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186708992}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186708994}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186708995}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9}{2}" :db/id #edb/ref 17592186708999}] [{:answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186709000}] [{:answer/feedback "The supplied parameterization reaches $A$ at $u=2$. The interval $[0,1]$ covers only half the segment." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt2\\int_0^1(u^2-7u+8)\\,\\mathrm{d}u" :db/id #edb/ref 17592186709001}] [{:answer/feedback "The arc-length factor $\\sqrt2$ is missing." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^2(u^2-7u+8)\\,\\mathrm{d}u" :db/id #edb/ref 17592186709003}] [{:answer/feedback "This substitutes $x^2+y$ instead of $x^2-y$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt5\\int_0^1(4t^2-5t+3)\\,\\mathrm{d}t" :db/id #edb/ref 17592186709004}] [{:answer/feedback "This exchanges the roles of $x$ and $y$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt5\\int_0^1(t^2-6t+5)\\,\\mathrm{d}t" :db/id #edb/ref 17592186709006}] [{:answer/feedback "The interval is $[0,2]$, the speed is $\\sqrt2$, and scalar arc-length integration is unchanged by reversal." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt2\\int_0^2(u^2-7u+8)\\,\\mathrm{d}u" :db/id #edb/ref 17592186709007}] [{:answer/feedback "Substitute $x=3-u$ and $y=1+u$ into $x^2-y$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt2\\int_0^2(u^2+u+2)\\,\\mathrm{d}u" :db/id #edb/ref 17592186709008}] [{:answer/feedback "Here $x=2$, $y=2t$, and $\\mathrm{d}s=2\\,\\mathrm{d}t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_0^1(2+\\sin(2t))\\,\\mathrm{d}t" :db/id #edb/ref 17592186709009}] [{:answer/feedback "This drops the initial $x$-coordinate: $x=-1+2t$, not $2t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt5\\int_0^1(4t^2+t-2)\\,\\mathrm{d}t" :db/id #edb/ref 17592186709011}] [{:answer/feedback "The displacement is $(2,-1)$, the speed is $\\sqrt5$, and the substituted function is $4t^2-3t-1$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt5\\int_0^1(4t^2-3t-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186709012}] [{:answer/feedback "Reversing traversal does not negate an integral with respect to arc length; the speed remains positive." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt2\\int_0^2(u^2-7u+8)\\,\\mathrm{d}u" :db/id #edb/ref 17592186709014}] [{:answer/feedback "The substitution is correct, but the arc-length factor is missing." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_0^1(2+\\sin(2t))\\,\\mathrm{d}t" :db/id #edb/ref 17592186709016}] [{:answer/feedback "The coordinate $y=2t$ must also be substituted inside the sine." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_0^1(2+\\sin t)\\,\\mathrm{d}t" :db/id #edb/ref 17592186709017}] [{:answer/feedback "The speed is $\\sqrt5$, not $5$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\int_0^1(4t^2-3t-1)\\,\\mathrm{d}t" :db/id #edb/ref 17592186709018}] [{:answer/feedback "The speed is $2$, not its square $4$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\int_0^1(2+\\sin(2t))\\,\\mathrm{d}t" :db/id #edb/ref 17592186709019}] [{:answer/feedback "The coordinate $x$ stays at $2$; it does not equal $2t$." :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\int_0^1(2t+\