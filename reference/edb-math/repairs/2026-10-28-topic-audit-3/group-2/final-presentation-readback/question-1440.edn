orname{cos}t\\end{bmatrix}=\\frac{7\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+15\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}}{||{\\mathbf{r}}^{'}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $b(t)=15\\operatorname{cos}⁡t.$"}] [{:db/id #edb/ref 17592186262674 :question/problem "The closed curve $C$ is defined as $\\mathbf{r}(t)=\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$ The outward-pointing unit normal vector for $C$ can be expressed as\n\n$$\n\\mathbf{n}=\\frac{a(t)\\hspace{0.167em}\\mathbf{i}+b(t)\\hspace{0.167em}\\mathbf{j}}{||{\\mathbf{r}}^{'}(t)||}.\n$$\n\nFind the function $b(t).$\n\n*Hint: Observe that $C$ is traversed clockwise.*" :question/worked-solution "For convenience, we express $\\mathbf{r}(t)$ in column vector notation:\n\n$$\n\\mathbf{r}(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\begin{bmatrix}\\operatorname{sin}t \\\\ 2\\operatorname{cos}t\\end{bmatrix}\n$$\n\nTo calculate the outward-pointing normal vector of a closed, *negatively* oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${\\mathbf{r}}^{'}(t).$\n\nDifferentiating the expression for $\\mathbf{r}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\begin{bmatrix}{x}^{'}(t) \\\\ {y}^{'}(t)\\end{bmatrix}=\\begin{bmatrix}\\operatorname{cos}t \\\\ -2\\operatorname{sin}t\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented clockwise, we rotate ${\\mathbf{r}}^{'}(t)$ by ${90}^{∘}$ *counterclockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ counterclockwise rotation is\n\n$$\nR=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nRotating the vector ${\\mathbf{r}}^{'}(t)$ by ${90}^{∘}$ counterclockwise, we get\n\n$$\n\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}\\operatorname{cos}⁡t \\\\ -2\\operatorname{sin}⁡t\\end{bmatrix}=\\begin{bmatrix}2\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${\\mathbf{r}}^{'}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}\\mathbf{n} & =\\frac{1}{||{\\mathbf{r}}^{'}(t)||}\\begin{bmatrix}2\\operatorname{sin}t \\\\ \\operatorname{cos}t\\end{bmatrix}=\\frac{2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}}{||{\\mathbf{r}}^{'}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $b(t)=\\operatorname{cos}⁡t.$"}] [{:db/id #edb/ref 17592186262675 :question/problem "The closed curve $C$ is defined as $\\mathbf{r}(t)=4\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+8\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$ The outward-pointing unit normal vector for $C$ can be expressed as\n\n$$\n\\mathbf{n}=\\frac{a(t)\\hspace{0.167em}\\mathbf{i}+b(t)\\hspace{0.167em}\\mathbf{j}}{||{\\mathbf{r}}^{'}(t)||}.\n$$\n\nFind the function $a(t).$\n\n*Hint: Observe that $C$ is traversed clockwise.*" :question/worked-solution "For convenience, we express $\\mathbf{r}(t)$ in column vector notation:\n\n$$\n\\mathbf{r}(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\begin{bmatrix}4\\operatorname{sin}t \\\\ 8\\operatorname{cos}t\\end{bmatrix}\n$$\n\nTo calculate the outward-pointing normal vector of a closed, *negatively* oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${\\mathbf{r}}^{'}(t).$\n\nDifferentiating the expression for $\\mathbf{r}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\begin{bmatrix}{x}^{'}(t) \\\\ {y}^{'}(t)\\end{bmatrix}=\\begin{bmatrix}4\\operatorname{cos}t \\\\ -8\\operatorname{sin}t\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented clockwise, we rotate ${\\mathbf{r}}^{'}(t)$ by ${90}^{∘}$ *counterclockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ counterclockwise rotation is\n\n$$\nR=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nRotating the vector ${\\mathbf{r}}^{'}(t)$ by ${90}^{∘}$ counterclockwise, we get\n\n$$\n\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}4\\operatorname{cos}⁡t \\\\ -8\\operatorname{sin}⁡t\\end{bmatrix}=\\begin{bmatrix}8\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${\\mathbf{r}}^{'}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}\\mathbf{n} & =\\frac{1}{||{\\mathbf{r}}^{'}(t)||}\\begin{bmatrix}8\\operatorname{sin}t \\\\ 4\\operatorname{cos}t\\end{bmatrix}=\\frac{8\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+4\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}}{||{\\mathbf{r}}^{'}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $a(t)=8\\operatorname{sin}⁡t.$"}] [{:db/id #edb/ref 17592186262676 :question/problem "The closed curve $C$ is defined as $\\mathbf{r}(t)=3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$ The outward-pointing unit normal vector for $C$ can be expressed as\n\n$$\n\\mathbf{n}=\\frac{a(t)\\hspace{0.167em}\\mathbf{i}+b(t)\\hspace{0.167em}\\mathbf{j}}{||{\\mathbf{r}}^{'}(t)||}.\n$$\n\nFind the function $b(t).$\n\n*Hint: Observe that $C$ is traversed clockwise.*" :question/worked-solution "For convenience, we express $\\mathbf{r}(t)$ in column vector notation:\n\n$$\n\\mathbf{r}(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\begin{bmatrix}3\\operatorname{sin}t \\\\ 3\\operatorname{cos}t\\end{bmatrix}\n$$\n\nTo calculate the outward-pointing normal vector of a closed, *negatively* oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${\\mathbf{r}}^{'}(t).$\n\nDifferentiating the expression for $\\mathbf{r}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\begin{bmatrix}{x}^{'}(t) \\\\ {y}^{'}(t)\\end{bmatrix}=\\begin{bmatrix}3\\operatorname{cos}t \\\\ -3\\operatorname{sin}t\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented clockwise, we rotate ${\\mathbf{r}}^{'}(t)$ by ${90}^{∘}$ *counterclockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ counterclockwise rotation is\n\n$$\nR=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nRotating the vector ${\\mathbf{r}}^{'}(t)$ by ${90}^{∘}$ counterclockwise, we get\n\n$$\n\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}3\\operatorname{cos}⁡t \\\\ -3\\operatorname{sin}⁡t\\end{bmatrix}=\\begin{bmatrix}3\\operatorname{sin}⁡t \\\\ 3\\operatorname{cos}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${\\mathbf{r}}^{'}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}\\mathbf{n} & =\\frac{1}{||{\\mathbf{r}}^{'}(t)||}\\begin{bmatrix}3\\operatorname{sin}t \\\\ 3\\operatorname{cos}t\\end{bmatrix}=\\frac{3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}}{||{\\mathbf{r}}^{'}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $b(t)=3\\operatorname{cos}⁡t.$"}] [{:db/id #edb/ref 17592186262687 :question/problem "![](images/95/95e7e2df02e4694d85be868f348bb65fb6a7bf2c646b89000b9af655f937a12f.png)\n\nConsider the ellipse $S$ and vector field $\\mathbf{F}$ shown above. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $\\mathbf{F}$ represents a stream of flowing water. The flux of $\\mathbf{F}$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $\\mathbf{F}$ across $C$ is positive” is true, while statement “The flux of $\\mathbf{F}$ across $C$ is zero” is false. From the diagram below it's clear that there is a net flow *out* through $C.$ \n\n![](images/bf/bfd6a4f3d368bc5920e1c79eed913f4ef21fcdf8b9eb42bbc5ce3f5c2ba7d36b.png)\n\nTherefore, the flux is positive, and we must have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s>0.\n$$\n\n- Statement “The flux of $\\mathbf{F}$ across $-C$ is negative” is false. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/78/789b387e512c53895b0cfa499c70547046318a29da6d9af7f556a07bcac830ed.png)\n\nSo, the flux of $\\mathbf{F}$ across $-C$ is positive, and we must have\n\n$$\n{∮}_{-C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s>0.\n$$\n\nTherefore, the correct answer is “The flux of $\\mathbf{F}$ across $C$ is positive” only."}] [{:db/id #edb/ref 17592186262688 :question/problem "![](images/06/06c6dd24948a95d08850455d273c3456076850a47c980a086f06813b96bfd6ed.png)\n\nConsider the circle $S$ and vector field $\\mathbf{F}$ shown above. Let $C$ be any path where $S$ is traversed once in the clockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $\\mathbf{F}$ represents a stream of flowing water. The flux of $\\mathbf{F}$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $\\mathbf{F}$ across $C$ is negative” is false, while statement “The flux of $\\mathbf{F}$ across $C$ is zero” is true. From the diagram below we see that $\\mathbf{F}$ acts perpendicular to $\\mathbf{n}$ at every point on $C.$ Therefore, there is no net flow of $\\mathbf{F}$ through $C.$\n\n![](images/29/29f144d6f3ce8233a034025fe933bc57dbea5476c50a259853a98bd2a2b3a47b.png)\n\nSo, the flux of $\\mathbf{F}$ across $C$ is zero, and we must have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=0.\n$$\n\n- Statement “The flux of $\\mathbf{F}$ across $-C$ is positive” is false. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/d7/d7a469a331a3cda238fcefb9e7163743483975c4ecc7b962d6d5f8d79736693c.png)\n\nSo, the flux of $\\mathbf{F}$ across $-C$ is zero, and we must have\n\n$$\n{∮}_{-C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=0.\n$$\n\nTherefore, the correct answer is “The flux of $\\mathbf{F}$ across $C$ is zero” only."}] [{:db/id #edb/ref 17592186262690 :question/problem "![](images/65/6504ab3dde96670102e5046887707416495895dc3b85a514b5bbe7b526b4fa42.png)\n\nConsider the ellipse $S$ and vector field $\\mathbf{F}$ shown above. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $\\mathbf{F}$ represents a stream of flowing water. The flux of $\\mathbf{F}$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $\\mathbf{F}$ across $C$ is zero” is true, while statement “The flux of $\\mathbf{F}$ across $C$ is positive” is false. Note that the flux $\\mathbf{F}$ that flows in through $C$ is the same that flows out through $C.$ Therefore, there is no net flow of $\\mathbf{F}$ through $C.$\n\n![](images/9a/9af12f28947e46810074574dad9f6b9a8b572f116456807bf9c478d12da19ec2.png)\n\nSo, the flux of $\\mathbf{F}$ across $C$ is zero, and we must have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=0.\n$$\n\n- Statement “The flux of $\\mathbf{F}$ across $-C$ is zero” is true. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/c4/c4402595afc4ce12937794f0755a446ae738d3b47d7e9f4978b6344f9ef8909a.png)\n\nSo, the flux of $\\mathbf{F}$ across $-C$ is zero, and we must have\n\n$$\n{∮}_{-C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=0.\n$$\n\nTherefore, the correct answer is “The flux of $\\mathbf{F}$ across $C$ is zero”; “The flux of $\\mathbf{F}$ across $-C$ is zero” only."}] [{:db/id #edb/ref 17592186262691 :question/problem "![](images/45/453633f6309b9f1d2a3f7a8d4266ff10f571823cffd705d0bc93b930dce63d8f.png)\n\nConsider the ellipse $S$ and vector field $\\mathbf{F}$ shown above. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\nTo understand the flux intuitively, we imagine that $\\mathbf{F}$ represents a stream of flowing water. The flux of $\\mathbf{F}$ across $C$ represents the net flow of water escaping the region bounded by $C:$ \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/a7/a72dc9866562a42a49590fd169424307675b2c14b36833bd729026f46b677eec.png)\n\n- If the net flow through $C$ is zero then the flux equals zero.\n\n![](images/3a/3a6ac8656b2e0b5cc482a16eb3a4fab57cb681c9a40cf634da47f9a4323d9fdf.png)\n\nFor an arbitrary closed curve, the outward-pointing unit normal vector tells us which direction is \"out.\"\n\nWith that in mind, let's check each statement.\n\n- Statement “The flux of $\\mathbf{F}$ across $C$ is negative” is false, while statement “The flux of $\\mathbf{F}$ across $C$ is zero” is true. From the diagram below we see that $\\mathbf{F}$ acts perpendicular to $\\mathbf{n}$ at every point on $C.$ Therefore, there is no net flow of $\\mathbf{F}$ through $C.$\n\n![](images/84/844d5e5574571ae221a86f541820a4b215766451031f4eea678cee46a1b83e41.png)\n\nSo, the flux of $\\mathbf{F}$ across $C$ is zero, and we must have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=0.\n$$\n\n- Statement “The flux of $\\mathbf{F}$ across $-C$ is zero” is true. When measuring flux through a closed curve, the orientation of the curve does not matter because the outward-pointing unit normal vector is the same at each point on $C$ in either case.\n\n![](images/b8/b8b31d46646db2d88d8a3f5658ee876383795ad5ba9aa55eb9959d5f95c02dbe.png)\n\nSo, the flux of $\\mathbf{F}$ across $-C$ is zero, and we must have\n\n$$\n{∮}_{-C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=0.\n$$\n\nTherefore, the correct answer is “The flux of $\\mathbf{F}$ across $C$ is zero”; “The flux of $\\mathbf{F}$ across $-C$ is zero” only."}] [{:db/id #edb/ref 17592186262697 :question/problem "Consider the vector field $\\mathbf{F}(x,y)=2{x}^{2}\\hspace{0.167em}\\mathbf{i}+2{y}^{2}\\hspace{0.167em}\\mathbf{j}$ and the circle $C$ given by ${x}^{2}+{y}^{2}=4.$ If the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\boxed{}\\,\\text{d}s,\n$$\n\nwhat is the missing expression?\n\n*Hint: The outward-pointing unit normal vector to $C$ is $\\mathbf{n}=\\frac{x}{2}\\hspace{0.167em}\\mathbf{i}+\\frac{y}{2}\\hspace{0.167em}\\mathbf{j}.$*" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\n![](images/ff/ff84680c55f5349431cf3d70066eeaba2c680569faa3b2210e5d14ef63ccd99e.png)\n\nIn our case, we have\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}(2{x}^{2}\\hspace{0.167em}\\mathbf{i}+2{y}^{2}\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{x}{2}\\mathbf{i}+\\frac{y}{2}\\hspace{0.167em}\\mathbf{j})\\text{d}s \\\\  & ={∮}_{C}{x}^{3}+{y}^{3}\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nTherefore, the missing expression is ${x}^{3}+{y}^{3}.$"}] [{:db/id #edb/ref 17592186262698 :question/problem "![](images/4f/4f8af75aece2346ffbf7a09e1ee90b6e0270f5661dd74e068abb2b2a848e5b97.png)\n\nConsider the vector field $\\mathbf{F}(x,y)={x}^{3}\\hspace{0.167em}\\mathbf{i}+3{y}^{2}\\hspace{0.167em}\\mathbf{j}$ and the square $C$ with side length $4$ centered at $O,$ shown above. If the flux of $\\mathbf{F}$ across the side ${C}_{2}$ is given by\n\n$$\n{\\int }_{{C}_{2}}\\boxed{}\\,\\text{d}s,\n$$\n\nwhat is the missing expression?" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\nIn our case, we need to find an expression for the flux across only the part ${C}_{2}$ of the closed curve $C.$ Since this side is perpendicular to the $y$-axis and we require an outward-pointing unit normal vector, we must have $\\mathbf{n}=\\mathbf{j}.$ \n\n![](images/a8/a83c3476bbe2ed2872ed8938dda59c5d0e6d58d05ecaf662748e7a184a4994a4.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{2}}({x}^{3}\\hspace{0.167em}\\mathbf{i}+3{y}^{2}\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{j}\\hspace{0.222em}\\text{d}s \\\\  & ={\\int }_{{C}_{2}}3{y}^{2}\\hspace{0.167em}\\text{d}s\\end{aligned}\n$$\n\nTherefore, the missing expression is $3{y}^{2}.$"}] [{:db/id #edb/ref 17592186262699 :question/problem "![](images/4d/4d9663a0a40f3c3860cce0712e9e9aab41d55251ea15fca33ec663515af57d10.png)\n\nConsider the vector field $\\mathbf{F}(x,y)={x}^{3}y\\hspace{0.167em}\\mathbf{i}-x{y}^{2}\\hspace{0.167em}\\mathbf{j}$ and the rectangle $C,$ shown above. If the flux of $\\mathbf{F}$ across the side ${C}_{3}$ is given by\n\n$$\n{\\int }_{{C}_{3}}\\boxed{}\\,\\text{d}s,\n$$\n\nwhat is the missing expression?" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\nIn our case, we need to find an expression for the flux across only the part ${C}_{3}$ of the closed curve $C.$ Since this side is perpendicular to the $x$-axis and we require an outward-pointing unit normal vector, we must have $\\mathbf{n}=-\\mathbf{i}.$\n\n![](images/c6/c6dd493e02633854184be1be0f38246e1e9dce2949f9cc1aa93b943c91d1e44c.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{3}}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{3}}({x}^{3}y\\hspace{0.167em}\\mathbf{i}-x{y}^{2}\\hspace{0.167em}\\mathbf{j})\\cdot (-\\mathbf{i})\\hspace{0.222em}\\text{d}s \\\\  & ={\\int }_{{C}_{3}}-{x}^{3}y\\hspace{0.167em}\\text{d}s\\end{aligned}\n$$\n\nTherefore, the missing expression is $-{x}^{3}y.$"}] [{:db/id #edb/ref 17592186262700 :question/problem "Consider the vector field $\\mathbf{F}(x,y)=15xy\\hspace{0.167em}\\mathbf{i}+5{x}^{2}\\hspace{0.167em}\\mathbf{j}$ and the circle $C$ given by ${x}^{2}+{y}^{2}=25.$ If the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\boxed{}\\,\\text{d}s,\n$$\n\nwhat is the missing expression?\n\n*Hint: The outward-pointing unit normal vector to $C$ is $\\mathbf{n}=\\frac{x}{5}\\hspace{0.167em}\\mathbf{i}+\\frac{y}{5}\\hspace{0.167em}\\mathbf{j}.$*" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\n![](images/d3/d3d68329d81150c4a975bae4963d4e480cefaef0f2a0a29a0648c3793e9fb462.png)\n\nIn our case, we have\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}(15xy\\hspace{0.167em}\\mathbf{i}+5{x}^{2}\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{x}{5}\\hspace{0.167em}\\mathbf{i}+\\frac{y}{5}\\hspace{0.167em}\\mathbf{j})\\text{d}s \\\\  & ={∮}_{C}3{x}^{2}y+{x}^{2}y\\hspace{0.222em}\\text{d}s \\\\  & ={∮}_{C}4{x}^{2}y\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nTherefore, the missing expression is $4{x}^{2}y.$"}] [{:db/id #edb/ref 17592186262701 :question/problem "Consider the vector field $\\mathbf{F}(x,y)=4{x}^{2}{y}^{2}\\hspace{0.167em}\\mathbf{i}+2{x}^{3}y\\hspace{0.167em}\\mathbf{j}$ and the circle $C$ given by ${x}^{2}+{y}^{2}=4.$ If the flux of $\\mathbf{F}$ across $C$ is given by  \n\n$$\n{∮}_{C}\\boxed{}\\,\\text{d}s,\n$$\n\nwhat is the missing expression?\n\n*Hint: The outward-pointing unit normal vector to $C$ is $\\mathbf{n}=\\frac{x}{2}\\hspace{0.167em}\\mathbf{i}+\\frac{y}{2}\\hspace{0.167em}\\mathbf{j}.$*" :question/worked-solution "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$\n\n![](images/ff/ff84680c55f5349431cf3d70066eeaba2c680569faa3b2210e5d14ef63ccd99e.png)\n\nIn our case, we have\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}(4{x}^{2}{y}^{2}\\hspace{0.167em}\\mathbf{i}+2{x}^{3}y\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{x}{2}\\mathbf{i}+\\frac{y}{2}\\hspace{0.167em}\\mathbf{j})\\text{d}s \\\\  & ={∮}_{C}2{x}^{3}{y}^{2}+{x}^{3}{y}^{2}\\hspace{0.222em}\\text{d}s \\\\  & ={∮}_{C}3{x}^{3}{y}^{2}\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nTherefore, the missing expression is $3{x}^{3}{y}^{2}.$"}] [{:db/id #edb/ref 17592186262702 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=xy\\hspace{0.167em}\\mathbf{i}+{x}^{2}\\hspace{0.167em}\\mathbf{j}$ across the closed curve $C$ given by $\\mathbf{r}(t)=2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =xy=4\\operatorname{sin}t\\operatorname{cos}t, \\\\ Q(x,y) & ={x}^{2}=4{\\operatorname{cos}}^{2}t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)=-2\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{cos}⁡t,\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{sin}t\\operatorname{cos}t)\\cdot (2\\operatorname{cos}t)-(4{\\operatorname{cos}}^{2}t)\\cdot (-2\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }8\\operatorname{sin}t{\\operatorname{cos}}^{2}t+8\\operatorname{sin}t{\\operatorname{cos}}^{2}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{sin}t{\\operatorname{cos}}^{2}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{1}^{1}-16{u}^{2}\\hspace{0.222em}\\text{d}u \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262706 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=x\\hspace{0.167em}\\mathbf{i}+y\\hspace{0.167em}\\mathbf{j}$ across the closed curve $C$ given by $\\mathbf{r}(t)=5\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+6\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=5\\operatorname{cos}⁡t,\\,y=6\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x=5\\operatorname{cos}⁡t, \\\\ Q(x,y) & =y=6\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5\\operatorname{cos}⁡t)=-5\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t)=6\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(5\\operatorname{cos}t)\\cdot (6\\operatorname{cos}t)-(6\\operatorname{sin}t)\\cdot (-5\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & =30{\\int }_{0}^{2\\pi }({\\operatorname{cos}}^{2}t+{\\operatorname{sin}}^{2}t)\\hspace{0.222em}\\text{d}t \\\\  & =30{\\int }_{0}^{2\\pi }1\\hspace{0.222em}\\text{d}t \\\\  & =30(2\\pi -0) \\\\  & =60\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262708 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=3x\\hspace{0.167em}\\mathbf{i}+3y\\hspace{0.167em}\\mathbf{j}$ across the ellipse $C$ with equation $4{x}^{2}+16{y}^{2}=64.$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $4$ and $2,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=4\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =3x=12\\operatorname{cos}⁡t, \\\\ Q(x,y) & =3y=6\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(12\\operatorname{cos}t)\\cdot (2\\operatorname{cos}t)-(6\\operatorname{sin}t)\\cdot (-4\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }24{\\operatorname{cos}}^{2}t+24{\\operatorname{sin}}^{2}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }24\\hspace{0.222em}\\text{d}t \\\\  & =24t\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =24(2\\pi -0) \\\\  & =48\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262710 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=(x-16y)\\hspace{0.167em}\\mathbf{i}+(x+y)\\hspace{0.167em}\\mathbf{j}$ across the ellipse $C$ with equation ${x}^{2}+16{y}^{2}=16.$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{1}^{2}}=1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $4$ and $1,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=4\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x-16y=4\\operatorname{cos}⁡t-16\\operatorname{sin}⁡t, \\\\ Q(x,y) & =x+y=4\\operatorname{cos}⁡t+\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{cos}t-16\\operatorname{sin}t)\\cdot (\\operatorname{cos}t)-(4\\operatorname{cos}t+\\operatorname{sin}t)\\cdot (-4\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4{\\operatorname{cos}}^{2}t-16\\operatorname{sin}t\\operatorname{cos}t+16\\operatorname{sin}t\\operatorname{cos}t+4{\\operatorname{sin}}^{2}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\hspace{0.222em}\\text{d}t \\\\  & =4t\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =4(2\\pi -0) \\\\  & =8\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262711 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=y\\hspace{0.167em}\\mathbf{i}+9{x}^{3}\\hspace{0.167em}\\mathbf{j}$ across the closed curve $C$ given by $\\mathbf{r}(t)=\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y=3\\operatorname{sin}t, \\\\ Q(x,y) & =9{x}^{3}=9{\\operatorname{cos}}^{3}t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $\\operatorname{cos}⁡t=u,du=-\\operatorname{sin}⁡t\\,dt,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}t)\\cdot (3\\operatorname{cos}t)-(9{\\operatorname{cos}}^{3}t)\\cdot (-\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }(\\operatorname{sin}t\\operatorname{cos}t+\\operatorname{sin}t{\\operatorname{cos}}^{3}t)\\hspace{0.222em}\\text{d}t \\\\  & =-9{\\int }_{1}^{1}(u+{u}^{3})\\hspace{0.222em}\\text{d}u \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262713 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)={x}^{2}\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}$ across the closed curve $C$ given by $\\mathbf{r}(t)=7\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=7\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & ={x}^{2}=49{\\operatorname{cos}}^{2}t, \\\\ Q(x,y) & =1.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(7\\operatorname{cos}⁡t)=-7\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $\\operatorname{sin}⁡t=u,du=\\operatorname{cos}⁡t\\,dt,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(49{\\operatorname{cos}}^{2}t)\\cdot (2\\operatorname{cos}t)-(1)\\cdot (-7\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }98{\\operatorname{cos}}^{3}t+7\\operatorname{sin}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }98{\\operatorname{cos}}^{2}t\\cdot \\operatorname{cos}t+7\\operatorname{sin}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }98(1-{\\operatorname{sin}}^{2}t)\\operatorname{cos}t+7\\operatorname{sin}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }98(\\operatorname{cos}t-{\\operatorname{sin}}^{2}t\\operatorname{cos}t)+7\\operatorname{sin}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }98\\operatorname{cos}t+7\\operatorname{sin}t\\hspace{0.222em}\\text{d}t+{\\int }_{0}^{2\\pi }-98{\\operatorname{sin}}^{2}t\\operatorname{cos}t\\hspace{0.167em}\\mathrm{d}t \\\\  & ={\\int }_{0}^{2\\pi }98\\operatorname{cos}t+7\\operatorname{sin}t\\hspace{0.222em}\\text{d}t+{\\int }_{0}^{0}-98{u}^{2}\\hspace{0.167em}\\mathrm{d}u \\\\  & =(98\\operatorname{sin}t-7\\operatorname{cos}t){|}_{0}^{2\\pi }+0 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262714 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=4x\\hspace{0.167em}\\mathbf{i}+4y\\hspace{0.167em}\\mathbf{j}$ across the closed curve $C$ given by $\\mathbf{r}(t)=8\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+6\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=8\\operatorname{cos}⁡t,\\,y=6\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =4x=4(8\\operatorname{cos}⁡t)=32\\operatorname{cos}⁡t, \\\\ Q(x,y) & =4y=4(6\\operatorname{sin}⁡t)=24\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(8\\operatorname{cos}⁡t)=-8\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t)=6\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(32\\operatorname{cos}t)\\cdot (6\\operatorname{cos}t)-(24\\operatorname{sin}t)\\cdot (-8\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }192({\\operatorname{cos}}^{2}t+{\\operatorname{sin}}^{2}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }192\\hspace{0.222em}\\text{d}t \\\\  & =192t{|}_{0}^{2\\pi } \\\\  & =192(2\\pi -0) \\\\  & =384\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262715 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=7\\hspace{0.167em}\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=36.$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nThe closed curve $C$ is a circle centered at the origin with the radius $6.$ It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=6\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+6\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=6\\operatorname{cos}⁡t,\\,y=6\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =7, \\\\ Q(x,y) & =2.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{cos}⁡t)=-6\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t)=6\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(7)\\cdot (6\\operatorname{cos}t)-(2)\\cdot (-6\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }42\\operatorname{cos}t+12\\operatorname{sin}t\\hspace{0.222em}\\text{d}t \\\\  & =(42\\operatorname{sin}t-12\\operatorname{cos}t)\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =(0-12)-(0-12) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262716 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)={y}^{3}\\hspace{0.167em}\\mathbf{i}+{x}^{3}\\hspace{0.167em}\\mathbf{j}$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=1$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={1}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $1.$ It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & ={y}^{3}={\\operatorname{sin}}^{3}t, \\\\ Q(x,y) & ={x}^{3}={\\operatorname{cos}}^{3}t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({\\operatorname{sin}}^{3}t)\\cdot (\\operatorname{cos}t)-({\\operatorname{cos}}^{3}t)\\cdot (-\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }{\\operatorname{sin}}^{3}t\\operatorname{cos}t+\\operatorname{sin}t{\\operatorname{cos}}^{3}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}t\\operatorname{cos}t({sin}^{2}+{\\operatorname{cos}}^{2}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}t\\operatorname{cos}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{0}u\\hspace{0.222em}\\text{d}u \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262717 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=(y-x)\\hspace{0.167em}\\mathbf{i}-(x+y)\\hspace{0.167em}\\mathbf{j}$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=9$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={3}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $1.$ It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+3\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y-x=3\\operatorname{sin}⁡t-3\\operatorname{cos}⁡t, \\\\ Q(x,y) & =-(x+y)=-3\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}t-3\\operatorname{cos}t)\\cdot (3\\operatorname{cos}t)-(-3\\operatorname{cos}t-3\\operatorname{sin}t)\\cdot (-3\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }(\\operatorname{sin}t\\operatorname{cos}t-{\\operatorname{cos}}^{2}t-\\operatorname{sin}t\\operatorname{cos}t-{\\operatorname{sin}}^{2}t)\\hspace{0.222em}\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }-({\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t)\\hspace{0.222em}\\text{d}t \\\\  & =-9{\\int }_{0}^{2\\pi }\\hspace{0.222em}\\text{d}t \\\\  & =-9t\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =-9(2\\pi -0) \\\\  & =-18\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262718 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=y\\hspace{0.167em}\\mathbf{i}-2x\\hspace{0.167em}\\mathbf{j}$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=16.$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={4}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $4.$ It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=4\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+4\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=4\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y=4\\operatorname{sin}⁡t, \\\\ Q(x,y) & =-2x=-8\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{sin}t)\\cdot (4\\operatorname{cos}t)-(-8\\operatorname{cos}t)\\cdot (-4\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-16\\operatorname{sin}t\\operatorname{cos}t)\\hspace{0.222em}\\text{d}t \\\\  & =-16{\\int }_{0}^{0}u\\hspace{0.222em}\\text{d}u \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262719 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=(1-x)\\hspace{0.167em}\\mathbf{i}+(x-y)\\hspace{0.167em}\\mathbf{j}$ across the ellipse $C$ with equation $16{x}^{2}+9{y}^{2}=144.$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{4}^{2}}=1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $3$ and $4,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+4\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=4\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =1-x=1-3\\operatorname{cos}⁡t, \\\\ Q(x,y) & =x-y=3\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(1-3\\operatorname{cos}t)\\cdot (4\\operatorname{cos}t)-(3\\operatorname{cos}t-4\\operatorname{sin}t)\\cdot (-3\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cos}t-12{\\operatorname{cos}}^{2}t+9\\operatorname{sin}t\\operatorname{cos}t-12{\\operatorname{sin}}^{2}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cos}t\\hspace{0.222em}\\text{d}t+9{\\int }_{0}^{2\\pi }\\operatorname{sin}t\\operatorname{cos}t\\hspace{0.222em}\\text{d}t-12{\\int }_{0}^{2\\pi }\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cos}t\\hspace{0.222em}\\text{d}t+9{\\int }_{0}^{0}u\\hspace{0.222em}\\text{d}u-12{\\int }_{0}^{2\\pi }\\hspace{0.222em}\\text{d}t \\\\  & =4\\operatorname{sin}t{|}_{0}^{2\\pi }+0-12t\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =4(0-0)-12(2\\pi -0) \\\\  & =-24\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262720 :question/problem "Calculate the flux of the vector field $\\mathbf{F}(x,y)=8\\hspace{0.167em}\\mathbf{i}-(x+3)\\hspace{0.167em}\\mathbf{j}$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=4.$" :question/worked-solution "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={2}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $2.$ It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =8, \\\\ Q(x,y) & =x+3=2\\operatorname{cos}⁡t+3.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)=-2\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the double-angle formula for sine, as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(8)\\cdot (2\\operatorname{cos}t)-(-2\\operatorname{cos}t-3)\\cdot (-2\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{cos}t-4\\operatorname{sin}t\\operatorname{cos}t-6\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{cos}t-2\\operatorname{sin}2t-6\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & =(16\\operatorname{sin}t-\\operatorname{cos}2t-6\\operatorname{cos}t)\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =0\\end{aligned}\n$$"}]}
