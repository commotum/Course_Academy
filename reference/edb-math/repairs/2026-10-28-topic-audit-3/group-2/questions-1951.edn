k:\n\n$$\n\\begin{aligned}\nf_x&=- 2 x y - y^{2} - y e^{x y},\\\\\nf_y&=- x^{2} - 2 x y - x e^{x y}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186713151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f79cbb-1ffe-59c1-9d49-9274c2558545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}f(x,y)&=- 2 x^{2} y - 2 x^{2} - 2 x y^{2}\\\\&- 2 \\sin{\\left(x + y \\right)} + \\cos{\\left(y \\right)}+C\\end{aligned}" :db/id #edb/ref 17592186713143} {:answer/id #uuid "3202b0cb-2f91-5ebc-80e4-70ee86aaecb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}f(x,y)&=2 x^{2} y + 2 x^{2} + 2 x y^{2}\\\\&+2 \\sin{\\left(x + y \\right)}+C\\end{aligned}" :db/id #edb/ref 17592186713147} {:answer/id #uuid "3d3108a9-0a01-5395-84fc-098b65c8dadf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}f(x,y)&=2 x^{2} y - 2 x^{2} - 2 x y^{2}\\\\&+2 \\sin{\\left(x + y \\right)} + \\cos{\\left(y \\right)}+C\\end{aligned}" :db/id #edb/ref 17592186713148} {:answer/id #uuid "bfe9d316-f017-5735-af47-79564fdcfa51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}f(x,y)&=- 2 x^{2} y - 2 x^{2} + 2 x y^{2}\\\\&- 2 \\sin{\\left(x + y \\right)} + \\cos{\\left(y \\right)}+C\\end{aligned}" :db/id #edb/ref 17592186713163} {:answer/id #uuid "c6295cae-cb57-5076-b01c-45e5e3631ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}f(x,y)&=2 x^{2} y + 2 x^{2} - 2 x y^{2}\\\\&+2 \\sin{\\left(x + y \\right)} + \\cos{\\left(y \\right)}+C\\end{aligned}" :db/id #edb/ref 17592186713164}] :answer-field/correct {:answer/id #uuid "bfe9d316-f017-5735-af47-79564fdcfa51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}f(x,y)&=- 2 x^{2} y - 2 x^{2} + 2 x y^{2}\\\\&- 2 \\sin{\\le