t(3 \\sqrt{2} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\sin{\\left(3 t \\right)}\\right)\\,i+\\frac{\\text{d}}{\\text{d}t}\\left(\\cos{\\left(3 t \\right)}\\right)\\,j \\\\  & =\\left(3 \\cos{\\left(3 t \\right)}\\right)\\,i+\\left(- 3 \\sin{\\left(3 t \\right)}\\right)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =\\left(\\left(2 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right)\\,i+\\left(3 \\sqrt{2} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right)\\,j\\right)\\cdot \\left(\\left(3 \\cos{\\left(3 t \\right)}\\right)\\,i+\\left(- 3 \\sin{\\left(3 t \\right)}\\right)\\,j\\right) \\\\  & =\\left(2 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right)\\cdot \\left(3 \\cos{\\left(3 t \\right)}\\right)+\\left(3 \\sqrt{2} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right)\\cdot \\left(- 3 \\sin{\\left(3 t \\right)}\\right) \\\\  & =\\left(6 \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + 9 \\cos^{2}{\\left(3 t \\right)}\\right)+\\left(- 9 \\sqrt{2} \\sin{\\left(3 t \\right)} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right) \\\\  & =\\frac{3 \\left(- \\sin{\\left(6 t \\right)} + 6 \\cos{\\left(6 t \\right)}\\right)}{2}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi}{12},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))]\\Big|_{t=\\frac{\\pi}{12}} & =\\frac{3 \\left(- \\sin{\\left(6 t \\right)} + 6 \\cos{\\left(6 t \\right)}\\right)}{2}\\Big|_{t=\\frac{\\pi}{12}} \\\\  & =\\left(\\frac{15}{2}\\right)+\\left(-9\\right) \\\\  & =- \\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3afb55b6-58da-5083-8efe-0e950b1fe6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186552633} {:answer/id #uuid "4e87b6f7-cacc-52c1-b617-45f56eff44bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186552636} {:answer/id #uuid "61c675af-c261-51a8-9450-abb8a1cd2f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186552641} {:answer/id #uuid "9e5e5473-86e1-52aa-9afa-24ecbdf49308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{11}{2}" :db/id #edb/ref 17592186552657} {:answer/id #uuid "eceb2536-3f4c-505c-b0c2-aaa2edc91168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186552676}] :answer-field/correct {:answer/id #uuid "3afb55b6-58da-5083-8efe-0e950b1fe6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186552633} :answer-field/id #uuid "76b7448b-1d21-50e7-b745-7464f80e2c80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552644}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "943bf81d-cdbe-5da6-99af-48b90c465f34" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\frac{5 \\pi}{4}$ given that $∇f(x,y)=\\left(2 x + 3 y\\right)\\,i+\\left(3 x + 3 y\\right)\\,j$ and $r(t)=\\left(\\sin{\\left(t \\right)}\\right)\\,i+\\left(\\cos{\\left(t \\right)}\\right)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\left(2 x + 3 y\\right)\\,i+\\left(3 x + 3 y\\right)\\,j.\n$$\n\nFirst, we substitute $x=\\sin{\\left(t \\right)}$ and $y=\\cos{\\left(t \\right)}$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\left(2 x + 3 y\\right)\\,i+\\left(3 x + 3 y\\right)\\,j\\Big|_{x=\\sin{\\left(t \\right)},\\,y=\\cos{\\left(t \\right)}} \\\\  & =\\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right)\\,i+\\left(3 \\sqrt{2} \\sin{\\left(t + \\frac{\\pi}{4} \\right)}\\right)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\sin{\\left(t \\right)}\\right)\\,i+\\frac{\\text{d}}{\\text{d}t}\\left(\\cos{\\left(t \\right)}\\right)\\,j \\\\  & =\\left(\\cos{\\left(t \\right)}\\right)\\,i+\\left(- \\sin{\\left(t \\right)}\\right)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =\\left(\\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right)\\,i+\\left(3 \\sqrt{2} \\sin{\\left(t + \\frac{\\pi}{4} \\right)}\\right)\\,j\\right)\\cdot \\left(\\left(\\cos{\\left(t \\right)}\\right)\\,i+\\left(- \\sin{\\left(t \\right)}\\right)\\,j\\right) \\\\  & =\\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right)\\cdot \\left(\\cos{\\left(t \\right)}\\right)+\\left(3 \\sqrt{2} \\sin{\\left(t + \\frac{\\pi}{4} \\right)}\\right)\\cdot \\left(- \\sin{\\left(t \\right)}\\right) \\\\  & =\\left(2 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 3 \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\sqrt{2} \\sin{\\left(t \\right)} \\sin{\\left(t + \\frac{\\pi}{4} \\right)}\\right) \\\\  & =\\frac{- \\sin{\\left(2 t \\right)} + 6 \\cos{\\left(2 t \\right)}}{2}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{5 \\pi}{4},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))]\\Big|_{t=\\frac{5 \\pi}{4}} & =\\frac{- \\sin{\\left(2 t \\right)} + 6 \\cos{\\left(2 t \\right)}}{2}\\Big|_{t=\\frac{5 \\pi}{4}} \\\\  & =\\left(\\frac{5}{2}\\right)+\\left(-3\\right) \\\\  & =- \\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c70a8dd-384f-5b15-893b-0052b7a82d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186552623} {:answer/id #uuid "156c94d0-349d-5758-a7bb-1c91c2eeaf6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 + 3 \\pi}{2}" :db/id #edb/ref 17592186552626} {:answer/id #uuid "80a98200-56a1-59ad-ad24-30ad2a8898fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 + 3 \\pi + 3 \\pi e^{\\frac{3 \\pi}{4}}}{2}" :db/id #edb/ref 17592186552648} {:answer/id #uuid "83384d10-0b4b-5cbd-9268-cde8685ebf71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\left(4 + 3 \\pi\\right) e^{\\frac{3 \\pi}{4}}}{2}" :db/id #edb/ref 17592186552649} {:answer/id #uuid "e3312459-bfed-559d-be8d-41c9ca255ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 \\left(1 + \\pi\\right) e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186552673}] :answer-field/correct {:answer/id #uuid "83384d10-0b4b-5cbd-9268-cde8685ebf71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\left(4 + 3 \\pi\\right) e^{\\frac{3 \\pi}{4}}}{2}" :db/id #edb/ref 17592186552649} :answer-field/id #uuid "3bf7d5dc-f308-51b7-b769-338509bd0a2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552634}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "95468fa8-6f6f-5652-bd74-709b5bf83349" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\frac{\\pi}{4}$ given that $∇f(x,y)=\\left(2 y \\left(\\ln{\\left(x \\right)} + 1\\right)\\right)\\,i+\\left(2 x \\ln{\\left(x \\right)}\\right)\\,j$ and $r(t)=\\left(e^{3 t}\\right)\\,i+\\left(\\sin{\\left(2 t \\right)}\\right)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\left(2 y \\left(\\ln{\\left(x \\right)} + 1\\right)\\right)\\,i+\\left(2 x \\ln{\\left(x \\right)}\\right)\\,j.\n$$\n\nFirst, we substitute $x=e^{3 t}$ and $y=\\sin{\\left(2 t \\right)}$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\left(2 y \\left(\\ln{\\left(x \\right)} + 1\\right)\\right)\\,i+\\left(2 x \\ln{\\left(x \\right)}\\right)\\,j\\Big|_{x=e^{3 t},\\,y=\\sin{\\left(2 t \\right)}} \\\\  & =\\left(2 \\left(3 t + 1\\right) \\sin{\\left(2 t \\right)}\\right)\\,i+\\left(6 t e^{3 t}\\right)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(e^{3 t}\\right)\\,i+\\frac{\\text{d}}{\\text{d}t}\\left(\\sin{\\left(2 t \\right)}\\right)\\,j \\\\  & =\\left(3 e^{3 t}\\right)\\,i+\\left(2 \\cos{\\left(2 t \\right)}\\right)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =\\left(\\left(2 \\left(3 t + 1\\right) \\sin{\\left(2 t \\right)}\\right)\\,i+\\left(6 t e^{3 t}\\right)\\,j\\right)\\cdot \\left(\\left(3 e^{3 t}\\right)\\,i+\\left(2 \\cos{\\left(2 t \\right)}\\right)\\,j\\right) \\\\  & =\\left(2 \\left(3 t + 1\\right) \\sin{\\left(2 t \\right)}\\right)\\cdot \\left(3 e^{3 t}\\right)+\\left(6 t e^{3 t}\\right)\\cdot \\left(2 \\cos{\\left(2 t \\right)}\\right) \\\\  & =\\left(18 t e^{3 t} \\sin{\\left(2 t \\right)} + 6 e^{3 t} \\sin{\\left(2 t \\right)}\\right)+\\left(12 t e^{3 t} \\cos{\\left(2 t \\right)}\\right) \\\\  & =6 \\left(3 t \\sin{\\left(2 t \\right)} + 2 t \\cos{\\left(2 t \\right)} + \\sin{\\left(2 t \\right)}\\right) e^{3 t}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi}{4},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))]\\Big|_{t=\\frac{\\pi}{4}} & =6 \\left(3 t \\sin{\\left(2 t \\right)} + 2 t \\cos{\\left(2 t \\right)} + \\sin{\\left(2 t \\right)}\\right) e^{3 t}\\Big|_{t=\\frac{\\pi}{4}} \\\\  & =\\left(\\frac{3 \\left(4 + 3 \\pi\\right) e^{\\frac{3 \\pi}{4}}}{2}\\right)+\\left(0\\right) \\\\  & =\\frac{3 \\left(4 + 3 \\pi\\right) e^{\\frac{3 \\pi}{4}}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf578ad-3f94-50a2-9016-75ff8028bd39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(17 + 3 e^{3}\\right)" :db/id #edb/ref 17592186552625} {:answer/id #uuid "345d4a3a-1aa8-5aee-a62f-175c2d3a88d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12 \\left(3 + e^{3}\\right)" :db/id #edb/ref 17592186552631} {:answer/id #uuid "5805784a-6f1f-5c25-baeb-0322d47ca628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(19 + 9 e^{3}\\right)" :db/id #edb/ref 17592186552638} {:answer/id #uuid "853e158f-9b51-59f3-b5da-f37fb2d40d39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\left(17 + 3 e^{3}\\right)" :db/id #edb/ref 17592186552650} {:answer/id #uuid "9402439e-8c43-5d43-80a2-865dcf9498df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(1 + 3 e^{3}\\right)" :db/id #edb/ref 17592186552652}] :answer-field/correct {:answer/id #uuid "5805784a-6f1f-5c25-baeb-0322d47ca628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(19 + 9 e^{3}\\right)" :db/id #edb/ref 17592186552638} :answer-field/id #uuid "aad771bc-7c36-5340-82dc-806251dc0d1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552662}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b20a26f4-0181-5ea7-9b9f-5299d07e54b9" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=1$ given that $∇f(x,y)=\\left(2 x + 2 y e^{x y}\\right)\\,i+\\left(2 x e^{x y} + 2 y\\right)\\,j$ and $r(t)=\\left(3 t^{2}\\right)\\,i+\\left(t\\right)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\left(2 x + 2 y e^{x y}\\right)\\,i+\\left(2 x e^{x y} + 2 y\\right)\\,j.\n$$\n\nFirst, we substitute $x=3 t^{2}$ and $y=t$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\left(2 x + 2 y e^{x y}\\right)\\,i+\\left(2 x e^{x y} + 2 y\\right)\\,j\\Big|_{x=3 t^{2},\\,y=t} \\\\  & =\\left(2 t \\left(3 t + e^{3 t^{3}}\\right)\\right)\\,i+\\left(2 t \\left(3 t e^{3 t^{3}} + 1\\right)\\right)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(3 t^{2}\\right)\\,i+\\frac{\\text{d}}{\\text{d}t}\\left(t\\right)\\,j \\\\  & =\\left(6 t\\right)\\,i+\\left(1\\right)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =\\left(\\left(2 t \\left(3 t + e^{3 t^{3}}\\right)\\right)\\,i+\\left(2 t \\left(3 t e^{3 t^{3}} + 1\\right)\\right)\\,j\\right)\\cdot \\left(\\left(6 t\\right)\\,i+\\left(1\\right)\\,j\\right) \\\\  & =\\left(2 t \\left(3 t + e^{3 t^{3}}\\right)\\right)\\cdot \\left(6 t\\right)+\\left(2 t \\left(3 t e^{3 t^{3}} + 1\\right)\\right)\\cdot \\left(1\\right) \\\\  & =\\left(36 t^{3} + 12 t^{2} e^{3 t^{3}}\\right)+\\left(6 t^{2} e^{3 t^{3}} + 2 t\\right) \\\\  & =2 t \\left(18 t^{2} + 9 t e^{3 t^{3}} + 1\\right).\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))]\\Big|_{t=1} & =2 t \\left(18 t^{2} + 9 t e^{3 t^{3}} + 1\\right)\\Big|_{t=1} \\\\  & =\\left(12 \\left(3 + e^{3}\\right)\\right)+\\left(2 \\left(1 + 3 e^{3}\\right)\\right) \\\\  & =2 \\left(19 + 9 e^{3}\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1edc479b-6e25-50dc-b248-691e00d9627d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186552627} {:answer/id #uuid "34b482bf-b077-548c-93e4-d19e18da3190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{2}" :db/id #edb/ref 17592186552632} {:answer/id #uuid "78fbddbc-e0d4-5800-9538-0a4fe5ab2c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186552645} {:answer/id #uuid "9f2efdef-8a62-52bb-8129-ce032079ea29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186552658} {:answer/id #uuid "d58354cd-5c87-58bc-90ac-c351d37f935a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{81}{2}" :db/id #edb/ref 17592186552667}] :answer-field/correct {:answer/id #uuid "78fbddbc-e0d4-5800-9538-0a4fe5ab2c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186552645} :answer-field/id #uuid "2b8674a2-cf9c-53e4-9e15-1b86944e440d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552628}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c242202b-b10a-5403-baab-ca1f5eb48188" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\frac{5 \\pi}{12}$ given that $∇f(x,y)=\\left(3 x + 2 y\\right)\\,i+\\left(2 x + 2 y\\right)\\,j$ and $r(t)=\\left(\\sin{\\left(3 t \\right)}\\right)\\,i+\\left(\\cos{\\left(3 t \\right)}\\right)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\left(3 x + 2 y\\right)\\,i+\\left(2 x + 2 y\\right)\\,j.\n$$\n\nFirst, we substitute $x=\\sin{\\left(3 t \\right)}$ and $y=\\cos{\\left(3 t \\right)}$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\left(3 x + 2 y\\right)\\,i+\\left(2 x + 2 y\\right)\\,j\\Big|_{x=\\sin{\\left(3 t \\right)},\\,y=\\cos{\\left(3 t \\right)}} \\\\  & =\\left(3 \\sin{\\left(3 t \\right)} + 2 \\cos{\\left(3 t \\right)}\\right)\\,i+\\left(2 \\sqrt{2} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\sin{\\left(3 t \\right)}\\right)\\,i+\\frac{\\text{d}}{\\text{d}t}\\left(\\cos{\\left(3 t \\right)}\\right)\\,j \\\\  & =\\left(3 \\cos{\\left(3 t \\right)}\\right)\\,i+\\left(- 3 \\sin{\\left(3 t \\right)}\\right)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =\\left(\\left(3 \\sin{\\left(3 t \\right)} + 2 \\cos{\\left(3 t \\right)}\\right)\\,i+\\left(2 \\sqrt{2} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right)\\,j\\right)\\cdot \\left(\\left(3 \\cos{\\left(3 t \\right)}\\right)\\,i+\\left(- 3 \\sin{\\left(3 t \\right)}\\right)\\,j\\right) \\\\  & =\\left(3 \\sin{\\left(3 t \\right)} + 2 \\cos{\\left(3 t \\right)}\\right)\\cdot \\left(3 \\cos{\\left(3 t \\right)}\\right)+\\left(2 \\sqrt{2} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right)\\cdot \\left(- 3 \\sin{\\left(3 t \\right)}\\right) \\\\  & =\\left(9 \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + 6 \\cos^{2}{\\left(3 t \\right)}\\right)+\\left(- 6 \\sqrt{2} \\sin{\\left(3 t \\right)} \\sin{\\left(3 t + \\frac{\\pi}{4} \\right)}\\right) \\\\  & =\\frac{3 \\left(\\sin{\\left(6 t \\right)} + 4 \\cos{\\left(6 t \\right)}\\right)}{2}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{5 \\pi}{12},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))]\\Big|_{t=\\frac{5 \\pi}{12}} & =\\frac{3 \\left(\\sin{\\left(6 t \\right)} + 4 \\cos{\\left(6 t \\right)}\\right)}{2}\\Big|_{t=\\frac{5 \\pi}{12}} \\\\  & =\\left(\\frac{15}{2}\\right)+\\left(-6\\right) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7240358f-092d-582a-934f-8a6ef16ec7e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(3 + 2 \\pi + 2 \\pi e^{\\frac{2 \\pi}{3}}\\right)}{3}" :db/id #edb/ref 17592186552642} {:answer/id #uuid "95318b33-083b-5c10-8bd8-5e075124ca89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 e^{\\frac{2 \\pi}{3}}" :db/id #edb/ref 17592186552654} {:answer/id #uuid "9c78769d-eab7-54ac-b82e-021367a14f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 \\left(3 + 2 \\pi\\right) e^{\\frac{2 \\pi}{3}}}{3}" :db/id #edb/ref 17592186552656} {:answer/id #uuid "a1ac5a68-d289-5c5d-b8cb-a5732df04564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(6 + 5 \\pi\\right) e^{\\frac{2 \\pi}{3}}}{3}" :db/id #edb/ref 17592186552660} {:answer/id #uuid "c73611b4-8e3c-5d41-bc0d-b49481b09578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(3 + 2 \\pi\\right)}{3}" :db/id #edb/ref 17592186552666}] :answer-field/correct {:answer/id #uuid "9c78769d-eab7-54ac-b82e-021367a14f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 \\left(3 + 2 \\pi\\right) e^{\\frac{2 \\pi}{3}}}{3}" :db/id #edb/ref 17592186552656} :answer-field/id #uuid "a23aeca6-4243-53cb-8db9-40059a115d31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552661}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d9e3c91e-480f-5fba-8afa-cd22cb97e18b" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\frac{\\pi}{6}$ given that $∇f(x,y)=\\left(2 y \\left(\\ln{\\left(x \\right)} + 1\\right)\\right)\\,i+\\left(2 x \\ln{\\left(x \\right)}\\right)\\,j$ and $r(t)=\\left(e^{4 t}\\right)\\,i+\\left(\\sin{\\left(3 t \\right)}\\right)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\left(2 y \\left(\\ln{\\left(x \\right)} + 1\\right)\\right)\\,i+\\left(2 x \\ln{\\left(x \\right)}\\right)\\,j.\n$$\n\nFirst, we substitute $x=e^{4 t}$ and $y=\\sin{\\left(3 t \\right)}$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\left(2 y \\left(\\ln{\\left(x \\right)} + 1\\right)\\right)\\,i+\\left(2 x \\ln{\\left(x \\right)}\\right)\\,j\\Big|_{x=e^{4 t},\\,y=\\sin{\\left(3 t \\right)}} \\\\  & =\\left(2 \\left(4 t + 1\\right) \\sin{\\left(3 t \\right)}\\right)\\,i+\\left(8 t e^{4 t}\\right)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(e^{4 t}\\right)\\,i+\\frac{\\text{d}}{\\text{d}t}\\left(\\sin{\\left(3 t \\right)}\\right)\\,j \\\\  & =\\left(4 e^{4 t}\\right)\\,i+\\left(3 \\cos{\\left(3 t \\right)}\\right)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =\\left(\\left(2 \\left(4 t + 1\\right) \\sin{\\left(3 t \\right)}\\right)\\,i+\\left(8 t e^{4 t}\\right)\\,j\\right)\\cdot \\left(\\left(4 e^{4 t}\\right)\\,i+\\left(3 \\cos{\\left(3 t \\right)}\\right)\\,j\\right) \\\\  & =\\left(2 \\left(4 t + 1\\right) \\sin{\\left(3 t \\right)}\\right)\\cdot \\left(4 e^{4 t}\\right)+\\left(8 t e^{4 t}\\right)\\cdot \\left(3 \\cos{\\left(3 t \\right)}\\right) \\\\  & =\\left(32 t e^{4 t} \\sin{\\left(3 t \\right)} + 8 e^{4 t} \\sin{\\left(3 t \\right)}\\right)+\\left(24 t e^{4 t} \\cos{\\left(3 t \\right)}\\right) \\\\  & =8 \\left(4 t \\sin{\\left(3 t \\right)} + 3 t \\cos{\\left(3 t \\right)} + \\sin{\\left(3 t \\right)}\\right) e^{4 t}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi}{6},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))]\\Big|_{t=\\frac{\\pi}{6}} & =8 \\left(4 t \\sin{\\left(3 t \\right)} + 3 t \\cos{\\left(3 t \\right)} + \\sin{\\left(3 t \\right)}\\right) e^{4 t}\\Big|_{t=\\frac{\\pi}{6}} \\\\  & =\\left(\\frac{8 \\left(3 + 2 \\pi\\right) e^{\\frac{2 \\pi}{3}}}{3}\\right)+\\left(0\\right) \\\\  & =\\frac{8 \\left(3 + 2 \\pi\\right) e^{\\frac{2 \\pi}{3}}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "326ed290-c2d9-50d2-88c8-74db06917de4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- t \\left(t + 1\\right)" :db/id #edb/ref 17592186555967} {:answer/id #uuid "336c3865-f674-544a-82cb-712e32c64648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (6 t + 1)" :db/id #edb/ref 17592186555969} {:answer/id #uuid "4db710c0-beac-5a6e-854d-7b7866f60c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (2 t + 1)" :db/id #edb/ref 17592186555973} {:answer/id #uuid "56a00959-2111-50b5-b5fe-ba2f85d7c3bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 t - 1" :db/id #edb/ref 17592186555977} {:answer/id #uuid "a9e4f8f2-4f25-544c-a9ba-33e2472e1343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 t" :db/id #edb/ref 17592186555996}] :answer-field/correct {:answer/id #uuid "4db710c0-beac-5a6e-854d-7b7866f60c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (2 t + 1)" :db/id #edb/ref 17592186555973} :answer-field/id #uuid "32e468ca-2d16-55b6-a084-1a0ff8b6f7f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555968}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11cc55a9-a3be-504c-b916-0f019947db61" :question/problem "If $f(x,y,z)=- x - 3 y + 2 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t^{2})\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(- x - 3 y + 2 z)\\,i+\\frac{∂}{∂y}(- x - 3 y + 2 z)\\,j+\\frac{∂}{∂z}(- x - 3 y + 2 z)\\,k \\\\  & =(-1)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(-1)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(2 t)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((-1)\\,i+(-3)\\,j+(2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(2 t)\\,k) \\\\  & =(-1)\\cdot (1)+(-3)\\cdot (2 t)+(2)\\cdot (2 t) \\\\  & =(-1)+(- 6 t)+(4 t) \\\\  & =- (2 t + 1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8edcc7-83f3-51eb-a02a-f98f35085a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 10 t" :db/id #edb/ref 17592186555966} {:answer/id #uuid "69f314a2-61a8-53f2-b0ac-eb90c1a11c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (10 t + 3)" :db/id #edb/ref 17592186555981} {:answer/id #uuid "7a0b14be-60a6-545a-ac09-803a1de56af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 \\left(2 t + 1\\right)" :db/id #edb/ref 17592186555986} {:answer/id #uuid "7ad1d7fe-61c1-5328-9f74-34705da6c672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (4 t + 3)" :db/id #edb/ref 17592186555987} {:answer/id #uuid "99bcbeaa-ab4e-516c-bbf9-8ff846ba257b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- t \\left(5 t + 3\\right)" :db/id #edb/ref 17592186555993}] :answer-field/correct {:answer/id #uuid "69f314a2-61a8-53f2-b0ac-eb90c1a11c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (10 t + 3)" :db/id #edb/ref 17592186555981} :answer-field/id #uuid "5c278396-ed1e-50e5-a1d5-838e5e5875f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555978}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "216d3edd-79b6-5b78-9d7a-c69bb1f635e7" :question/problem "If $f(x,y,z)=- 3 x - 2 y - 3 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t^{2})\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(- 3 x - 2 y - 3 z)\\,i+\\frac{∂}{∂y}(- 3 x - 2 y - 3 z)\\,j+\\frac{∂}{∂z}(- 3 x - 2 y - 3 z)\\,k \\\\  & =(-3)\\,i+(-2)\\,j+(-3)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(-3)\\,i+(-2)\\,j+(-3)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(2 t)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((-3)\\,i+(-2)\\,j+(-3)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(2 t)\\,k) \\\\  & =(-3)\\cdot (1)+(-2)\\cdot (2 t)+(-3)\\cdot (2 t) \\\\  & =(-3)+(- 4 t)+(- 6 t) \\\\  & =- (10 t + 3).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a17b40b-479d-5751-b0e3-83bf67df5a76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- t \\left(3 t + 1\\right)" :db/id #edb/ref 17592186555972} {:answer/id #uuid "6377a370-44ec-5cec-9bc0-51c381fef7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186555980} {:answer/id #uuid "72871cc2-889b-515a-9b90-c36e695dffa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\left(3 t + 1\\right)" :db/id #edb/ref 17592186555984} {:answer/id #uuid "7f26a776-36f8-56ac-8203-f0bde320ccfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (6 t + 1)" :db/id #edb/ref 17592186555988} {:answer/id #uui