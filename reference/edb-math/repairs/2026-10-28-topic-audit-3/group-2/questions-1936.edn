\\cos{\\left(2 t \\right)}\\right)\\,j \\\\  & =\\left(2 \\cos{\\left(2 t \\right)}\\right)\\,i+\\left(- 2 \\sin{\\left(2 t \\right)}\\right)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =\\left(\\left(2 \\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right)\\,i+\\left(3 \\sqrt{2} \\sin{\\left(2 t + \\frac{\\pi}{4} \\right)}\\right)\\,j\\right)\\cdot \\left(\\left(2 \\cos{\\left(2 t \\right)}\\right)\\,i+\\left(- 2 \\sin{\\left(2 t \\right)}\\right)\\,j\\right) \\\\  & =\\left(2 \\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right)\\cdot \\left(2 \\cos{\\left(2 t \\right)}\\right)+\\left(3 \\sqrt{2} \\sin{\\left(2 t + \\frac{\\pi}{4} \\right)}\\right)\\cdot \\left(- 2 \\sin{\\left(2 t \\right)}\\right) \\\\  & =\\left(4 \\sin{\\left(2 t \\right)} \\cos{\\left(2 t \\right)} + 6 \\cos^{2}{\\left(2 t \\right)}\\right)+\\left(- 6 \\sqrt{2} \\sin{\\left(2 t \\right)} \\sin{\\left(2 t + \\frac{\\pi}{4} \\right)}\\right) \\\\  & =- \\sin{\\left(4 t \\right)} + 12 \\cos^{2}{\\left(2 t \\right)} - 6.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi}{8},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))]\\Big|_{t=\\frac{\\pi}{8}} & =- \\sin{\\left(4 t \\right)} + 12 \\cos^{2}{\\left(2 t \\right)} - 6\\Big|_{t=\\frac{\\pi}{8}} \\\\  & =\\left(5\\right)+\\left(-6\\right) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc1cc5c-e1dd-5953-b7f5-350905b76471" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186552624} {:answer/id #uuid "5e6f8c29-1da3-56bc-96c5-b8c840c683db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{99}{2}" :db/id #edb/ref 17592186552640} {:answer/id #uuid "88b2c5c5-e1e9-52ab-9