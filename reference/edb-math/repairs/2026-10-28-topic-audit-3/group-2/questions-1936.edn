1{y}^{2}+x2y\\cdot 0)}{1+16{x}^{2}{y}^{4}}\\,i+\\frac{4(0{y}^{2}+x2y\\cdot 1)}{1+16{x}^{2}{y}^{4}}\\,j \\\\  & =\\frac{4{y}^{2}}{1+16{x}^{2}{y}^{4}}\\,i+\\frac{8xy}{1+16{x}^{2}{y}^{4}}\\,j\\end{aligned}\n$$\n\nNext, we substitute $x={e}^{4t}$ and $y=\\operatorname{sin}⁡5t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{4(\\operatorname{sin}⁡5t)^{2}}{1+16({e}^{4t})^{2}(\\operatorname{sin}⁡5t)^{4}}\\,i+\\frac{8({e}^{4t})(\\operatorname{sin}⁡5t)}{1+16({e}^{4t})^{2}(\\operatorname{sin}⁡5t)^{4}}\\,j \\\\  & =\\frac{4\\sin^{2}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,i+\\frac{8{e}^{4t}\\operatorname{sin}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{4t})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡5t)\\,j \\\\  & =4{e}^{4t}\\,i+5\\operatorname{cos}⁡5t\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{4\\sin^{2}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,i+\\frac{8{e}^{4t}\\operatorname{sin}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}\\,j)\\cdot (4{e}^{4t}\\,i+5\\operatorname{cos}⁡5t\\,j) \\\\  & =\\frac{16{e}^{4t}\\sin^{2}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t}+\\frac{40{e}^{4t}\\operatorname{sin}⁡5t\\operatorname{cos}⁡5t}{1+16{e}^{8t}\\sin^{4}⁡5t} \\\\  & =\\frac{4{e}^{4t}(4\\sin^{2}⁡5t+10\\operatorname{sin}⁡5t\\operatorname{cos}⁡5t)}{1+16{e}^{8t}\\sin^{4}⁡5t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e4a664-828b-5860-8931-3f7a67e771ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(2 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536113} {:answer/id #uuid "43863874-ca72-58e4-99b6-b2310513b7d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4 \\left(4 t e^{2 t} \\ln{\\left(t \\right)} - 2 e^{2 t} - \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536119} {:answer/id #uuid "4f9ceac7-621c-54b7-b41f-8994e3294d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\left(2 e^{2 t} + 2 e^{t} \\ln{\\left(t \\right)} + \\ln{\\left(t \\right)}\\right)" :db/id #edb/ref 17592186536123} {:answer/id #uuid "af473d8e-16e9-570c-81d8-5f12c2cd647c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(4 t e^{2 t} \\ln{\\left(t \\right)} + 2 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536155} {:answer/id #uuid "c2579dd5-b29d-546c-85ee-76fc7fc743a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 \\left(2 t e^{2 t} + t \\ln{\\left(t \\right)} + \\ln{\\left(t \\right)}\\right) e^{t}}{t}" :db/id #edb/ref 17592186536161}] :answer-field/correct {:answer/id #uuid "af473d8e-16e9-570c-81d8-5f12c2cd647c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(4 t e^{2 t} \\ln{\\left(t \\right)} + 2 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" :db/id #edb/ref 17592186536155} :answer-field/id #uuid "7d12e6ff-94be-5dcd-84cc-d93391333c27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536141}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8e3d3273-ab0d-559d-b480-c40a8896fe51" :question/problem "If $f(x,y)=2 x^{2} + 2 x y^{2}$ and $r(t)=\\ln{\\left(t \\right)}\\,i+2 e^{t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(2 x^{2} + 2 x y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} + 2 x y^{2})\\,j \\\\  & =(4 x + 2 y^{2})\\,i+4 x y\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\ln{\\left(t \\right)}$ and $y=2 e^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(4(\\ln{\\left(t \\right)})+2(2 e^{t})^{2})\\,i+4(\\ln{\\left(t \\right)})(2 e^{t})\\,j \\\\  & =(8 e^{2 t} + 4 \\ln{\\left(t \\right)})\\,i+8 e^{t} \\ln{\\left(t \\right)}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\ln{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(2 e^{t})\\,j \\\\  & =\\frac{1}{t}\\,i+2 e^{t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((8 e^{2 t} + 4 \\ln{\\left(t \\right)})\\,i+8 e^{t} \\ln{\\left(t \\right)}\\,j)\\cdot (\\frac{1}{t}\\,i+2 e^{t}\\,j) \\\\  & =((8 e^{2 t} + 4 \\ln{\\left(t \\right)}))\\left(\\frac{1}{t}\\right)+(8 e^{t} \\ln{\\left(t \\right)})(2 e^{t}) \\\\  & =\\frac{4 \\ln{\\left(t \\right)}}{t}+\\frac{8 e^{2 t}}{t}+16 e^{2 t} \\ln{\\left(t \\right)} \\\\  & =16 e^{2 t} \\ln{\\left(t \\right)} + \\frac{8 e^{2 t}}{t} + \\frac{4 \\ln{\\left(t \\right)}}{t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536163 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fcbb94e-faef-5525-9470-4b6ce168bca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(2 e^{3 t} + \\sin{\\left(2 t \\right)}\\right) \\sin{\\left(2 t \\right)}}{4 e^{6 t} \\sin^{4}{\\left(2 t \\right)} + 1}" :db/id #edb/ref 17592186536124} {:answer/id #uuid "554fc290-ebd5-56da-99e2-35b578477e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{2 \\left(- 3 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\right) e^{3 t} \\sin{\\left(2 t \\right)}}{4 e^{6 t}