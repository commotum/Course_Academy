t - 2)})\\,k) \\\\  & =-2(t - 2){e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2})+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2})\\cdot {e}^{(t - 2)}+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2})\\cdot {e}^{(t - 2)} \\\\  & =-2(t - 2){e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2})+2{e}^{2(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}) \\\\  & =2{e}^{2(t - 2)}(\\operatorname{cos}⁡({(t - 2)}^{2})-(t - 2)\\operatorname{sin}⁡({(t - 2)}^{2})).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c54f7b-0460-5650-8e11-7dbfff0c05e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(2 t + 1\\right)" :db/id #edb/ref 17592186555958} {:answer/id #uuid "6add913c-9635-5380-9dd3-082d19b4c8e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(1 - 3 t\\right)" :db/id #edb/ref 17592186555982} {:answer/id #uuid "a5a53ab2-3b2d-511f-8d27-0c2e3593b2a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 t" :db/id #edb/ref 17592186555995} {:answer/id #uuid "ba0ce4fb-faf2-545c-813c-92335b2551d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t \\left(2 - t\\right)" :db/id #edb/ref 17592186556000} {:answer/id #uuid "cc2d2ded-87cd-520a-9927-cc57f85daf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(1 - t\\right)" :db/id #edb/ref 17592186556001}] :answer-field/correct {:answer/id #uuid "cc2d2ded-87cd-520a-9927-cc57f85daf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(1 - t\\right)" :db/id #edb/ref 17592186556001} :answer-field/id #uuid "4ea5389a-261a-518e-b827-bc0fb8107846" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555974}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b831457d-f088-5348-bc3d-27f5556d6376" :question/problem "If $f(x,y,z)=2 x - 3 y + 2 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t^{2})\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(2 x - 3 y + 2 z)\\,i+\\frac{∂}{∂y}(2 x - 3 y + 2 z)\\,j+\\frac{∂}{∂z}(2 x - 3 y + 2 z)\\,k \\\\  & =(2)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(2 t)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((2)\\,i+(-3)\\,j+(2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(2 t)\\,k) \\\\  & =(2)\\cdot (1)+(-3)\\cdot (2 t)+(2)\\cdot (2 t) \\\\  & =(2)+(- 6 t)+(4 t) \\\\  & =2 \\left(1 - t\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186556006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0508161d-0559-5c9c-94b0-dabbf30c8892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 t - 1" :db/id #edb/ref 17592186555959} {:answer/id #uuid "09f295d9-03a2-5561-bbef-04c9bb89034c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186555962} {:answer/id #uuid "78c86cc8-66c7-50dd-9fc4-ded5ae059599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 t + 1" :db/id #edb/ref 17592186555985} {:answer/id #uuid "d334b550-3042-553b-b847-e1e7fe52d626" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(t - 1\\right)" :db/id #edb/ref 17592186556002} {:answer/id #uuid "d9187c94-57be-571f-b824-8290c0c50c00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t \\left(t - 1\\right)" :db/id #edb/ref 17592186556003}] :answer-field/correct {:answer/id #uuid "0508161d-0559-5c9c-94b0-dabbf30c8892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 t - 1" :db/id #edb/ref 17592186555959} :answer-field/id #uuid "844dfb74-8a60-5fe0-bb44-50294978c57a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555989}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbb4e13f-d8a8-5c5d-b9d1-448311f2dde4" :question/problem "If $f(x,y,z)=x + y - 2 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t)\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(x + y - 2 z)\\,i+\\frac{∂}{∂y}(x + y - 2 z)\\,j+\\frac{∂}{∂z}(x + y - 2 z)\\,k \\\\  & =(1)\\,i+(1)\\,j+(-2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(1)\\,i+(1)\\,j+(-2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(1)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((1)\\,i+(1)\\,j+(-2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(1)\\,k) \\\\  & =(1)\\cdot (1)+(1)\\cdot (2 t)+(-2)\\cdot (1) \\\\  & =(1)+(2 t)+(-2) \\\\  & =2 t - 1.\\end{aligned}\n$$"}]}
