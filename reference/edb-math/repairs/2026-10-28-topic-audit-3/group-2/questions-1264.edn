(2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(4 x^{4} y - 8 x^{3} y^{2} + 2 x^{3} - 4 x^{2} y^{3} - 2 x^{2} y + 8 x y^{4} - 2 x y^{2} + 4 y^{5})\\cdot (\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\,\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1} (4 x^{4} y - 8 x^{3} y^{2} + 2 x^{3} - 4 x^{2} y^{3} - 2 x^{2} y + 8 x y^{4} - 2 x y^{2} + 4 y^{5})\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c42430-1fc9-5ab1-b3e4-e64439a50882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 4 x^{3} - 2 x^{2} y - 4 x y^{2}) \\sqrt{(x + 4 y)^{2} + (4 x + y)^{2} + 1}" :db/id #edb/ref 17592186530660} {:answer/id #uuid "22488b4b-6eaa-54e6-9321-a65255989526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 4 x^{3} - 2 x^{2} y - 4 x y^{2}) ((x + 4 y)^{2} + (4 x + y)^{2} + 1)" :db/id #edb/ref 17592186530670} {:answer/id #uuid "8cc0684f-705b-5fb6-b62c-6f0630074787" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 4 x^{3} - 2 x^{2} y - 4 x y^{2}}{\\sqrt{(x + 4 y)^{2} + (4 x + y)^{2} + 1}}" :db/id #edb/ref 17592186530702} {:answer/id #uuid "eb7631c1-1fd4-5d83-97c5-482b17777c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 x^{3} - 2 x^{2} y - 4 x y^{2}" :db/id #edb/ref 17592186530727} {:answer/id #uuid "f7f0d205-7805-51c7-989c-6e86453e59c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(x + 4 y)^{2} + (4 x + y)^{2}} (- 4 x^{3} - 2 x^{2} y - 4 x y^{2})" :db/id #edb/ref 17592186530733}] :answer-field/correct {:answer/id #uuid "00c42430-1fc9-5ab1-b3e4-e64439a50882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 4 x^{3} - 2 x^{2} y - 4 x y^{2}) \\sqrt{(x