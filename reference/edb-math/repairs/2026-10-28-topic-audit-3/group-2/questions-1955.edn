85c9b-7316-5f24-9730-29ffe68bc43f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186531755} {:answer/id #uuid "72e6360f-cc66-5448-8d12-5f58319b536c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186531765} {:answer/id #uuid "77cc9ca5-7acb-56e5-bc75-c54cce8f4921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-78" :db/id #edb/ref 17592186531769} {:answer/id #uuid "86370954-0165-5b77-9084-1afc211cb722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{141}{2}" :db/id #edb/ref 17592186531773}] :answer-field/correct {:answer/id #uuid "256c689b-c454-5525-8358-ac15ab2196c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{147}{2}" :db/id #edb/ref 17592186531740} :answer-field/id #uuid "75ddc911-bb66-5faa-bcc6-bda8bcf585b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531766}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fb25f684-725c-58f3-8f3d-89177734553d" :question/problem "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $x=-3.$ Given that the point $P(-3,4,4)$ lies on $C,$ and that $f_y = \\dfrac{2x}y - 2x^2y$, find the slope of the tangent to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=-3.$ Hence, the slope of the tangent to the curve $C$ at the point $P(-3,4,4)$ will be given by the partial derivative ${f}_{y}(-3,4).$\n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(-3,4):$\n\n$$\n\\begin{aligned}{f}_{y}(-3,4) & =\\frac{2(-3)}{(4)}-2(-3)^2(4) \\\\  & =\\left(- \\frac{3}{2}\\right)+(-72) \\\\  & =- \\frac{147}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186556105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fcaa4c-cdc7-55cc-9fbc-bf020baece7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,0,-1⟩" :db/id #edb/ref 17592186556104} {:answer/id #uuid "3aaf0daf-4db1-56a4-85c0-b9d13bb393d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,0,1⟩" :db/id #edb/ref 17592186556117} {:answer/id #uuid "89d7a47f-5ffb-5fb7-8773-673d0bdca988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,1,0⟩" :db/id #edb/ref 17592186556142} {:answer/id #uuid "f703c35e-0bb7-5ae6-ac28-2ef517196952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,-4⟩" :db/id #edb/ref 17592186556167} {:answer/id #uuid "fee29037-72b8-57de-8e34-703bacf1d7c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,4⟩" :db/id #edb/ref 17592186556169}] :answer-field/correct {:answer/id #uuid "fee29037-72b8-57de-8e34-703bacf1d7c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,4⟩" :db/id #edb/ref 17592186556169} :answer-field/id #uuid "778574b8-fa99-5187-b7ff-a835f64fafed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556134}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "055263bb-00e6-5ecd-9052-3f0991382dda" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=2.$ Given that the point $P(-2,2,0)$ lies on $C$, and that ${f}_{x}=(-2)x$, which of the following gives a tangent vector to $C$ at $P?$" :question/worked-solution "The curve $C$ is the intersection of the surface with the plane $y=2.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{x}(-2,2).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(-2,2):$\n\n$$\n\\begin{aligned}{f}_{x}(-2,2) & =(-2)(-2)=4\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(-2,2) & ={f}_{x}(-2,2)(x-(-2)) \\\\ z-(0) & =(4)(x-(-2)) \\\\ z-(0) & =4 x + 8 \\\\ z & =4 x + 8\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(-2,2,0)$ can be given as the intersection of two planes:\n\n$$\n\\begin{aligned}\\{y=2 \\\\ z=4 x + 8\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $y=2,$ a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $z=4 x + 8$ (or $4 x - z + 8=0$), a normal vector to the plane is ${n}_{2}=⟨4,0,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨0,1,0⟩\\times ⟨4,0,-1⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ 0 & 1 & 0 \\\\ 4 & 0 & -1\\end{vmatrix} \\\\  & =- i - 4 k \\\\  & =⟨-1,0,-4⟩\\end{aligned}\n$$\n\nFinally, since $⟨-1,0,-4⟩$ is parallel to the tangent line, then $-(⟨-1,0,-4⟩)=⟨1,0,4⟩$ is also parallel to it."}] [{:db/id #edb/ref 17592186556111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3e1e95-6abb-5b2d-b333-2c9928f10fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,0,1⟩" :db/id #edb/ref 17592186556107} {:answer/id #uuid "5e3dd612-7efb-572c-98e3-50b684d7a1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,0,-1⟩" :db/id #edb/ref 17592186556126} {:answer/id #uuid "7f9ce72c-9b00-57d7-ab95-a6ee0fc09ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,3⟩" :db/id #edb/ref 17592186556138} {:answer/id #uuid "ac5fd2fc-a327-5afc-af0f-ecca1c720272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,-3⟩" :db/id #edb/ref 17592186556150} {:answer/id #uuid "b298ee27-0c63-5917-9d3e-0528f700c1b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,1,0⟩" :db/id #edb/ref 17592186556152}] :answer-field/correct {:answer/id #uuid "7f9ce72c-9b00-57d7-ab95-a6ee0fc09ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,3⟩" :db/id #edb/ref 17592186556138} :answer-field/id #uuid "7f426c50-eced-5e9c-a349-73aa145929b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556137}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24dbd77f-2590-58ef-821c-6bd1e8a62bdc" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=4.$ Given that the point $P(-2,4,-4)$ lies on $C$, and that ${f}_{x}=3$, which of the following gives a tangent vector to $C$ at $P?$" :question/worked-solution "The curve $C$ is the intersection of the surface with the plane $y=4.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{x}(-2,4).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(-2,4):$\n\n$$\n\\begin{aligned}{f}_{x}(-2,4) & =3\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(-2,4) & ={f}_{x}(-2,4)(x-(-2)) \\\\ z-(-4) & =(3)(x-(-2)) \\\\ z-(-4) & =3 x + 6 \\\\ z & =3 x + 2\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(-2,4,-4)$ can be given as the intersection of two planes:\n\n$$\n\\begin{aligned}\\{y=4 \\\\ z=3 x + 2\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $y=4,$ a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $z=3 x + 2$ (or $3 x - z + 2=0$), a normal vector to the plane is ${n}_{2}=⟨3,0,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨0,1,0⟩\\times ⟨3,0,-1⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ 0 & 1 & 0 \\\\ 3 & 0 & -1\\end{vmatrix} \\\\  & =- i - 3 k \\\\  & =⟨-1,0,-3⟩\\end{aligned}\n$$\n\nFinally, since $⟨-1,0,-3⟩$ is parallel to the tangent line, then $-(⟨-1,0,-3⟩)=⟨1,0,3⟩$ is also parallel to it."}] [{:db/id #edb/ref 17592186556113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015bc2bf-13ce-5c4f-8f0c-a4a74231f0c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-6,1⟩" :db/id #edb/ref 17592186556102} {:answer/id #uuid "58d0c333-0126-5eb6-89df-cfb21a2d9ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-6,-1⟩" :db/id #edb/ref 17592186556124} {:answer/id #uuid "9afc3218-bbc9-5554-9630-980dd247d59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,1,-6⟩" :db/id #edb/ref 17592186556146} {:answer/id #uuid "cbc46a02-9995-525c-8cb6-ea5098fa7457" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,1,6⟩" :db/id #edb/ref 17592186556157} {:answer/id #uuid "ff84763e-3842-594a-98b1-79f342d9e445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,0⟩" :db/id #edb/ref 17592186556171}] :answer-field/correct {:answer/id #uuid "9afc3218-bbc9-5554-9630-980dd247d59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,1,-6⟩" :db/id #edb/ref 17592186556146} :answer-field/id #uuid "646eda7e-2147-525c-aef1-fd3fda68bebd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556129}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "322047e2-3976-5636-bcd1-e92ee6b570c4" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $x=3.$ Given that the point $P(3,3,-3)$ lies on $C$, and that ${f}_{y}=(-2)y$, which of the following gives a tangent vector to $C$ at $P?$" :question/worked-solution "The curve $C$ is the intersection of the surface with the plane $x=3.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{y}(3,3).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(3,3):$\n\n$$\n\\begin{aligned}{f}_{y}(3,3) & =(-2)(3)=-6\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(3,3) & ={f}_{y}(3,3)(y-(3)) \\\\ z-(-3) & =(-6)(y-(3)) \\\\ z-(-3) & =18 - 6 y \\\\ z & =15 - 6 y\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(3,3,-3)$ can be given as the intersection of two planes:\n\n$$\n\\begin{aligned}\\{x=3 \\\\ z=15 - 6 y\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $x=3,$ a normal vector to the plane is ${n}_{1}=⟨1,0,0⟩.$\n\n- For the plane $z=15 - 6 y$ (or $- 6 y - z + 15=0$), a normal vector to the plane is ${n}_{2}=⟨0,-6,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,0,0⟩\\times ⟨0,-6,-1⟩ \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 0 \\\\ 0 & -6 & -1\\end{vmatrix} \\\\  & =j - 6 k \\\\  & =⟨0,1,-6⟩\\end{aligned}\n$$\n\nTherefore, a tangent vector to $C$ at $P$ is $⟨0,1,-6⟩.$"}] [{:db/id #edb/ref 17592186556118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ba9c0a-1858-5d2b-ae82-2126392ec58e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,1,-2⟩" :db/id #edb/ref 17592186556108} {:answer/id #uuid "4e3b10f7-1ab2-5dd0-bdc2-2c023a53bdc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,1,2⟩" :db/id #