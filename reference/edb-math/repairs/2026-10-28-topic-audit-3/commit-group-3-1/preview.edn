ac{1}{{x}^{2}{y}^{2}{z}^{2}+1}\\,j+\\frac{1}{{x}^{2}{y}^{2}{z}^{2}+1}\\,k" 13194139543374 17592186576411 false] [17592186382999 1074 "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & =2xz+{y}^{3} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & =3x{y}^{2}-{z}^{4} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & ={x}^{2}-4y{z}^{3}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y,z) & ={f}_{x}(x,y,z)\\hspace{0.167em}\\mathbf{i}+{f}_{y}(x,y,z)\\hspace{0.167em}\\mathbf{j}+{f}_{z}(x,y,z)\\hspace{0.167em}\\mathbf{k} \\\\  & =(2xz+{y}^{3})\\hspace{0.167em}\\mathbf{i}+(3x{y}^{2}-{z}^{4})\\hspace{0.167em}\\mathbf{j}+({x}^{2}-4y{z}^{3})\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$" 13194139543374 17592186576411 true] [17592186382999 1074 "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & =2xz+{y}^{3} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & =3x{y}^{2}-{z}^{4} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & ={x}^{2}-4y{z}^{3}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =(2xz+{y}^{3})\\,i+(3x{y}^{2}-{z}^{4})\\,j+({x}^{2}-4y{z}^{3})\\,k.\\end{aligned}\n$$" 13194139543374 17592186576411 false] [17592186383001 1080 "(2xz+{y}^{3})\\,\\mathbf{i}+(6x{y}^{2}+{z}^{4})\\,\\mathbf{j}+(x-4y{z}^{3})\\,\\mathbf{k}" 13194139543374 17592186576411 true] [17592186383001 1080 "(2xz+{y}^{3})\\,i+(6x{y}^{2}+{z}^{4})\\,j+(x-4y{z}^{3})\\,k" 13194139543374 17592186576411 false] [17592186383002 1080 "(xz+{y}^{3})\\,\\mathbf{i}+(3{y}^{2}-{z}^{4})\\,\\mathbf{j}+({x}^{2}-4{z}^{3})\\,\\mathbf{k}" 13194139543374 17592186576411 true] [17592186383002 1080 "(xz+{y}^{3})\\,i+(3{y}^{2}-{z}^{4})\\,j+({x}^{2}-4{z}^{3})\\,k" 13194139543374 17592186576411 false] [17592186383003 1080 "(2xz+{y}^{3})\\,\\mathbf{i}+(3x{y}^{2}-{z}^{4})\\,\\mathbf{j}+({x}^{2}-4y{z}^{3})\\,\\mathbf{k}" 13194139543374 17592186576411 true] [17592186383003 1080 "(2xz+{y}^{3})\\,i+(3x{y}^{2}-{z}^{4})\\,j+({x}^{2}-4y{z}^{3})\\,k" 13194139543374 17592186576411 false] [17592186383004 1080 "(2xz+{y}^{2})\\,\\mathbf{i}+(6xy-{z}^{4})\\,\\mathbf{j}+({x}^{2}-8{y}^{3})\\,\\mathbf{k}" 13194139543374 17592186576411 true] [17592186383004 1080 "(2xz+{y}^{2})\\,i+(6xy-{z}^{4})\\,j+({x}^{2}-8{y}^{3})\\,k" 13194139543374 17592186576411 false] [17592186383005 1080 "(2x+{y}^{2})\\,\\mathbf{i}+(3xy-{z}^{4})\\,\\mathbf{j}+({x}^{2}-8y{z}^{2})\\,\\mathbf{k}" 13194139543374 17592186576411 true] [17592186383005 1080 "(2x+{y}^{2})\\,i+(3xy-{z}^{4})\\,j+({x}^{2}-8y{z}^{2})\\,k" 13194139543374 17592186576411 false] [17592186383006 1074 "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}\\left(\\frac{{x}^{2}-{y}^{2}}{2}\\right) \\\\  & =x \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}\\left(\\frac{{x}^{2}-{y}^{2}}{2}\\right) \\\\  & =-y\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y) & ={f}_{x}(x,y)\\hspace{0.167em}\\mathbf{i}+{f}_{y}(x,y)\\hspace{0.167em}\\mathbf{j} \\\\  & =x\\hspace{0.167em}\\mathbf{i}-y\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-2,1),$ $(1,1),$ and $(2,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-2,1) & =(-2)\\,i-j=-2\\,i-j \\\\ ∇f(1,1) & =i-j \\\\ ∇f(2,-1) & =2\\,i-(-1)\\,j=2i+j\\end{aligned}\n$$\n\n \n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](images/fd/fdcd6cebad2e9aef26daf2987b2890a1b05ceeab5f8e803b631cdb4a6a4598c4.png)" 13194139543374 17592186576411 true] [17592186383006 1074 "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}\\left(\\frac{{x}^{2}-{y}^{2}}{2}\\right) \\\\  & =x \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}\\left(\\frac{{x}^{2}-{y}^{2}}{2}\\right) \\\\  & =-y\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =x\\,i-y\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-2,1),$ $(1,1),$ and $(2,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-2,1) & =(-2)\\,i-j=-2\\,i-j \\\\ ∇f(1,1) & =i-j \\\\ ∇f(2,-1) & =2\\,i-(-1)\\,j=2i+j\\end{aligned}\n$$\n\n \n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](images/fd/fdcd6cebad2e9aef26daf2987b2890a1b05ceeab5f8e803b631cdb4a6a4598c4.png)" 13194139543374 17592186576411 false] [17592186383013 1074 "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{2}^{x}}{\\operatorname{ln}⁡(2)}+{y}^{2}) \\\\  & ={2}^{x} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{{2}^{x}}{\\operatorname{ln}⁡(2)}+{y}^{2}) \\\\  & =2y\\end{aligned}\n$$\n\n \n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y) & ={f}_{x}(x,y)\\hspace{0.167em}\\mathbf{i}+{f}_{y}(x,y)\\hspace{0.167em}\\mathbf{j} \\\\  & ={2}^{x}\\hspace{0.167em}\\mathbf{i}+2y\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-2,1),$ $(0,1),$ and $(2,-1).$\n\