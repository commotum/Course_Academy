(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${\\mathbf{T}}^{-1}.$ So, we compute the Jacobian determinant of $\\mathbf{T}$ as follows:\n\n- First, we compute $\\frac{∂(u,v,w)}{∂(x,y,z)},$ the Jacobian determinant of ${\\mathbf{T}}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $\\mathbf{T}$ using the relation\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={\\left(\\frac{∂(u,v,w)}{∂(x,y,z)}\\right)}^{-1}.\n$$\n\nHere, we have \n\n$$\nu(x,y,z)=y{z}^{2},\\,v(x,y,z)=z{x}^{2},\\,w(x,y,z)=x{y}^{2}.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =0 & \\,\\frac{∂u}{∂y} & ={z}^{2} & \\,\\frac{∂u}{∂z} & =2yz \\\\ \\frac{∂v}{∂x} & =2xz & \\,\\frac{∂v}{∂y} & =0 & \\,\\frac{∂v}{∂z} & ={x}^{2} \\\\ \\frac{∂w}{∂x} & ={y}^{2} & \\,\\frac{∂w}{∂y} & =2xy & \\,\\frac{∂w}{∂z} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant of ${\\mathbf{T}}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & {z}^{2} & 2yz \\\\ 2xz & 0 & {x}^{2} \\\\ {y}^{2} & 2xy & 0\\end{vmatrix} \\\\  & =-{z}^{2}\\begin{vmatrix}2xy & {x}^{2} \\\\ {y}^{2} & 0\\end{vmatrix}+2yz\\begin{vmatrix}2xz & 0 \\\\ {y}^{2} & 2xy\\end{vmatrix} \\\\  & =-{z}^{2}(0-{x}^{2}{y}^{2})+2yz(4{x}^{2}yz-0) \\\\  & ={x}^{2}{y}^{2}{z}^{2}+8{x}^{2}{y}^{2}{z}^{2} \\\\  & =9{x}^{2}{y}^{2}{z}^{2}.\\end{aligned}\n$$\n\nWriting down $\\frac{∂(u,v,w)}{∂(x,y,z)}$ in terms of $u,$ $v,$ and $w,$ we obtain\n\n$$\n\\begin{aligned}9{x}^{2}{y}^{2}{z}^{2} & =9{({x}^{3}{y}^{3}{z}^{3})}^{2/3} \\\\  & =9{(y{z}^{2}\\cdot z{x}^{2}\\cdot x{y}^{2})}^{2/3} \\\\  & =9(uvw)^{2/3}.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & ={\\left(\\frac{∂(u,v,w)}{∂(x,y,z)}\\right)}^{-1} \\\\  & =\\frac{1}{9(uvw)^{2/3}}\\end{aligned}\n$$"] [17592186281338 "For a transformation \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $\\mathbf{T},$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=uv,\\,y(u,v,w)=u+v,\\,z(u,v,w)=w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =u & \\,\\frac{∂x}{∂w} & =0 \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =1 & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =0 & \\,\\frac{∂z}{∂v} & =0 & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}v & u & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}v & u \\\\ 1 & 1\\end{vmatrix} \\\\  & =v-u.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ v-u & =0.\\end{aligned}\n$$\n\nThe equation $v-u=0$ defines the plane $v=u..$"] [17592186281339 "For a transformation \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $\\mathbf{T},$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u,\\,y(u,v,w)={v}^{3}+{w}^{3},\\,z(u,v,w)=v+w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =3{v}^{2} & \\,\\frac{∂y}{∂w} & =3{w}^{2} \\\\ \\frac{∂z}{∂u} & =0 & \\,\\frac{∂z}{∂v} & =1 & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}1 & 0 & 0 \\\\ 0 & 3{v}^{2} & 3{w}^{2} \\\\ 0 & 1 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}3{v}^{2} & 3{w}^{2} \\\\ 1 & 1\\end{vmatrix} \\\\  & =1(3{v}^{2}-3{w}^{2}) \\\\  & =3({v}^{2}-{w}^{2}).\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ 3({v}^{2}-{w}^{2}) & =0 \\\\ {v}^{2}-{w}^{2} & =0.\\end{aligned}\n$$\n\nThe equation ${v}^{2}-{w}^{2}=0$ defines a pair of intersecting planes $v=w$ and $v=-w.$"] [17592186281340 "For a transformation \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $\\mathbf{T},$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=\\sqrt{u},\\,y(u,v,w)=vw,\\,z(u,v,w)=u+w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =\\frac{1}{2\\sqrt{u}} & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =w & \\,\\frac{∂y}{∂w} & =v \\\\ \\frac{∂z}{∂u} & =1 & \\,\\frac{∂z}{∂v} & =0 & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{1}{2\\sqrt{u}} & 0 & 0 \\\\ 0 & w & v \\\\ 1 & 0 & 1\\end{vmatrix} \\\\  & =\\frac{1}{2\\sqrt{u}}\\begin{vmatrix}w & v \\\\ 0 & 1\\end{vmatrix}+1\\begin{vmatrix}0 & 0 \\\\ w & v\\end{vmatrix} \\\\  & =\\frac{1}{2\\sqrt{u}}(w-0)+0 \\\\  & =\\frac{w}{2\\sqrt{u}}.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ \\frac{w}{2\\sqrt{u}} & =0 \\\\ w & =0.\\end{aligned}\n$$\n\nThe equation $w=0$ defines the plane $w=0,$ i.e., $uv$-plane."] [17592186281341 "For a transformation \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $\\mathbf{T},$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u,\\,y(u,v,w)=v{e}^{w},\\,z(u,v,w)=2u+v+3w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & ={e}^{w} & \\,\\frac{∂y}{∂w} & =v{e}^{w} \\\\ \\frac{∂z}{∂u} & =2 & \\,\\frac{∂z}{∂v} & =1 & \\,\\frac{∂z}{∂w} & =3\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}1 & 0 & 0 \\\\ 0 & {e}^{w} & v{e}^{w} \\\\ 2 & 1 & 3\\end{vmatrix} \\\\  & =1\\begin{vmatrix}{e}^{w} & v{e}^{w} \\\\ 1 & 3\\end{vmatrix} \\\\  & =1(3{e}^{w}-v{e}^{w}) \\\\  & ={e}^{w}(3-v).\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ {e}^{w}(3-v) & =0 \\\\ 3-v & =0.\\end{aligned}\n$$\n\nThe equation $3-v=0$ defines the plane $v=3.$"] [17592186281342 "For a transformation \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $\\mathbf{T},$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u+3w,\\,y(u,v,w)=v+2w,\\,z(u,v,w)={v}^{2}-u.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =3 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =1 & \\,\\frac{∂y}{∂w} & =2 \\\\ \\frac{∂z}{∂u} & =-1 & \\,\\frac{∂z}{∂v} & =2v & \\,\\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}1 & 0 & 3 \\\\ 0 & 1 & 2 \\\\ -1 & 2v & 0\\end{vmatrix} \\\\  & =1\\begin{vmatrix}1 & 2 \\\\ 2v & 0\\end{vmatrix}+3\\begin{vmatrix}0 & 1 \\\\ -1 & 2v\\end{vmatrix} \\\\  & =1(0-4v)+3(0+1) \\\\  & =3-4v.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ 3-4v & =0.\\end{aligned}\n$$\n\nThe equation $3-4v=0$ defines the plane $v=\\frac{3}{4}.$"] [17592186281352 "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u+v \\\\ {u}^{2}+{v}^{2}\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 \\\\ 2u & 2v\\end{vmatrix} \\\\  & =1\\cdot (2v)-(2u)\\cdot 1 \\\\  & =2v-2u.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}2v-2u & <0 \\\\ 2v & <2u \\\\ v & <u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=u\n$$\n\ndefines a straight line, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/83/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png)"] [17592186281353 "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{3}-\\frac{1}{2}{v}^{2} \\\\ u-\\frac{1}{3}v\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}3{u}^{2} & -v \\\\ 1 & -\\frac{1}{3}\\end{vmatrix} \\\\  & =(3{u}^{2})\\cdot \\left(-\\frac{1}{3}\\right)-(1)\\cdot (-v) \\\\  & =v-{u}^{2}.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}v-{u}^{2} & <0 \\\\ v & <{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv={u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/13/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png)"] [17592186281354 "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}4u+{v}^{2} \\\\ v-{u}^{2}\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}4 & 2v \\\\ -2u & 1\\end{vmatrix} \\\\  & =4\\cdot 1-(-2u)\\cdot (2v) \\\\  & =4+4uv.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}4+4uv & >0 \\\\ 4uv & >-4 \\\\ uv & >-1\\end{aligned}\n$$\n\n \n\nThis gives the solution $v>-\\frac{1}{u}$ for $u>0$ and $v<-\\frac{1}{u}$ for $u<0.$\n\nNotice that the equation \n\n$$\nv=-\\frac{1}{u}\n$$\n\ndefines a hyperbola, and the coordinates of, say, $(1,1)$ and $(-1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n  \n\n![](images/c5/c501e7e341af57e86f18d73871314800d453f79572e16ccf2477335352d4dcdc.png)"] [17592186281360 "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{e}^{uv} \\\\ {u}^{2}+v\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}v{e}^{uv} & u{e}^{uv} \\\\ 2u & 1\\end{vmatrix} \\\\  & =v{e}^{uv}\\cdot (1)-(2u)\\cdot u{e}^{uv} \\\\  & ={e}^{uv}(v-2{u}^{2}).\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}{e}^{uv}(v-2{u}^{2}) & >0 \\\\ v-2{u}^{2} & >0 \\\\ v & >2{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=2{u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(0,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/61/613e83ce5ad6154905ec9001ece078309e396561e251e85455ff261bb4cd61a0.png)"] [17592186281416 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡t,\\,y=\\operatorname{cos}⁡t,\\,z=2\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{j} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j})\\cdot (\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\operatorname{cos}t\\cdot \\operatorname{cos}t+\\operatorname{sin}t\\cdot (-\\operatorname{sin}t)+0\\cdot 2\\operatorname{cos}t \\\\  & ={\\operatorname{cos}}^{2}t-{\\operatorname{sin}}^{2}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({\\operatorname{cos}}^{2}t-{\\operatorname{sin}}^{2}t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}(2t)\\hspace{0.278em}\\text{d}t \\\\  & =[\\frac{\\operatorname{sin}(2t)}{2}]_{0}^{2\\pi } \\\\  & =0\\end{aligned}\n$$"] [17592186281421 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡(t),\\,y=\\operatorname{cos}⁡(t),\\,z={t}^{2}.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}-x\\hspace{0.167em}\\mathbf{j}+z\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+{t}^{2}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(t))\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(t))\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+{t}^{2}\\hspace{0.167em}\\mathbf{k})\\cdot (\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\operatorname{cos}(t)\\cdot \\operatorname{cos}(t)+(-\\operatorname{sin}(t))\\cdot (-\\operatorname{sin}(t))+{t}^{2}\\cdot 2t \\\\  & ={\\operatorname{cos}}^{2}(\\pi t)+{\\operatorname{sin}}^{2}(t)+2{t}^{3} \\\\  & =1+2{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{-\\pi }^{\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(1+2{t}^{3})\\hspace{0.278em}\\text{d}t \\\\  & ={[t+\\frac{{t}^{4}}{2}]}_{-\\pi }^{\\pi } \\\\  & =((\\pi -(-\\pi ))+\\frac{{\\pi }^{4}-(-\\pi )^{4}}{2}) \\\\  & =2\\pi \\end{aligned}\n$$"] [17592186281422 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=1-{t}^{2},\\,y={t}^{2},\\,z=\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =(x+y)\\hspace{0.167em}\\mathbf{i}-z\\hspace{0.167em}\\mathbf{k} \\\\  & =(1-{t}^{2}+{t}^{2})\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\mathbf{i}-\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{k} \\\\  & =-2t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\mathbf{i}-\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k})\\cdot (-2t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}) \\\\  & =1\\cdot (-2t)+0\\cdot 2t+\\operatorname{sin}(\\pi t)\\cdot \\pi \\operatorname{cos}(\\pi t) \\\\  & =-2t+\\frac{\\pi }{2}\\operatorname{sin}(2\\pi t).\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-2t+\\frac{\\pi }{2}\\operatorname{sin}(2\\pi t))\\hspace{0.278em}\\text{d}t \\\\  & ={[-{t}^{2}-\\frac{\\operatorname{cos}(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =(-1-\\frac{1}{4})-(-1-\\frac{1}{4}) \\\\  & =0\\end{aligned}\n$$"] [17592186281424 "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡t,\\,y=\\operatorname{cos}⁡t,\\,z=\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =-z\\hspace{0.167em}\\mathbf{j}+y\\hspace{0.167em}\\mathbf{k} \\\\  & =-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k})\\cdot (\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}) \\\\  & =0\\cdot \\operatorname{cos}t+(-\\operatorname{sin}t)\\cdot (-\\operatorname{sin}t)+\\operatorname{cos}t\\cdot \\operatorname{cos}t \\\\  & ={\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t. \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }1\\hspace{0.278em}\\text{d}t \\\\  & =[t]_{0}^{2\\pi } \\\\  & =2\\pi \\end{aligned}\n$$"] [17592186281436 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2{t}^{3}-2t,\\,y=3{t}^{2}+3t,\\,z={t}^{3}-t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =z\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{k} \\\\  & =({t}^{3}-t)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+3t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-2t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}+3t)\\hspace{0.167em}\\mathbf{j}-\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\hspace{0.167em}\\mathbf{k} \\\\  & =(6{t}^{2}-2)\\hspace{0.167em}\\mathbf{i}+(6t+3)\\hspace{0.167em}\\mathbf{j}+(3{t}^{2}-1)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(({t}^{3}-t)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+3t)\\hspace{0.167em}\\mathbf{k})\\cdot ((6{t}^{2}-2)\\hspace{0.167em}\\mathbf{i}+(6t+3)\\hspace{0.167em}\\mathbf{j}+(3{t}^{2}-1)\\hspace{0.167em}\\mathbf{k}) \\\\  & =({t}^{3}-t)\\cdot (6{t}^{2}-2)+0\\cdot (6t+3)+(3{t}^{2}+3t)\\cdot (3{t}^{2}-1) \\\\  & =6{t}^{5}+9{t}^{4}+{t}^{3}-3{t}^{2}-t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{0}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{0}(6{t}^{5}+9{t}^{4}+{t}^{3}-3{t}^{2}-t)\\hspace{0.222em}\\text{d}t \\\\  & ={[{t}^{6}+\\frac{9{t}^{5}}{5}+\\frac{{t}^{4}}{4}-{t}^{3}-\\frac{{t}^{2}}{2}]}_{-1}^{0} \\\\  & =0-(1-\\frac{9}{5}+\\frac{1}{4}+1-\\frac{1}{2}) \\\\  & =\\frac{1}{20}\\end{aligned}\n$$"] [17592186281438 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=\\operatorname{cos}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(\\pi t))\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(\\pi t))\\hspace{0.167em}\\mathbf{k} \\\\  & =-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k})\\cdot (-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\operatorname{sin}(\\pi t)\\cdot (-\\pi \\operatorname{sin}(\\pi t))+0\\cdot \\pi \\operatorname{cos}(\\pi t)+\\operatorname{cos}(\\pi t)\\cdot (-\\pi \\operatorname{sin}(\\pi t)) \\\\  & =-\\pi \\operatorname{sin}(\\pi t)\\operatorname{cos}(\\pi t)-\\pi {\\operatorname{sin}}^{2}(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-\\pi \\operatorname{sin}(\\pi t)\\operatorname{cos}(\\pi t)-\\pi {\\operatorname{sin}}^{2}(\\pi t))\\hspace{0.222em}\\text{d}t \\\\  & =-{\\int }_{-1}^{1}(\\pi \\operatorname{sin}(\\pi t)\\operatorname{cos}(\\pi t)+\\frac{\\pi }{2}(1-\\operatorname{cos}(2\\pi t)))\\hspace{0.222em}\\text{d}t \\\\  & =-{[\\frac{{\\operatorname{sin}}^{2}(\\pi t)}{2}+\\frac{\\pi t}{2}-\\frac{\\operatorname{sin}(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =-[0+\\frac{\\pi }{2}+0-(0-\\frac{\\pi }{2}+0)] \\\\  & =-\\pi \\end{aligned}\n$$"] [17592186281453 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z=1+{x}^{2}+2{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)=1+{x}^{2}+2{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(1+{x}^{2}+2{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(1+{x}^{2}+2{y}^{2})=4y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\hspace{0.167em}\\mathbf{F}:$\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}{|}_{z=g(x,y)} & =⟨y,\\hspace{0.222em}-x,\\hspace{0.222em}1⟩{|}_{z=1+{x}^{2}+2{y}^{2}} \\\\  & =⟨y,\\hspace{0.222em}-x,\\hspace{0.222em}1⟩ \\\\  & =⟨\\underbrace{y}_{P},\\hspace{0.222em}\\underbrace{-x}_{Q},\\hspace{0.222em}\\underbrace{1}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (2x)-(-x)\\cdot (4y)+1)\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}(2xy+1)\\hspace{0.222em}\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/d8/d84b3ecc79c58a128d2f7ea262692d9f66dd9882ff244fb7c3dadd2b2571b550.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(2xy+1)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{x-1}^{0}\\,2xy+1\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"] [17592186281454 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=4.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=4.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4)=0 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\hspace{0.167em}\\mathbf{F}:$\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}{|}_{z=g(x,y)} & =⟨-x{e}^{z},\\hspace{0.222em}0,\\hspace{0.222em}{e}^{z}⟩{|}_{z=4} \\\\  & =⟨\\underbrace{-x{e}^{4}}_{P},\\hspace{0.222em}\\underbrace{0}_{Q},\\hspace{0.222em}\\underbrace{{e}^{4}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot (-x{e}^{4})-0\\cdot 0+{e}^{4})\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}{e}^{4}\\hspace{0.222em}\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=4$ with radius $2$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{4}\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{e}^{4}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={e}^{4}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\cdot {\\int }_{0}^{2}r\\,\\text{d}r \\\\  & ={e}^{4}[\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot {[\\frac{{r}^{2}}{2}]}_{r=0}^{r=2} \\\\  & ={e}^{4}(2\\pi -0)\\cdot (2-0) \\\\  & =4\\pi {e}^{4}.\\end{aligned}\n$$"] [17592186281457 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=x.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=x.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\hspace{0.167em}\\mathbf{F}:$\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}{|}_{z=g(x,y)} & =⟨0,\\hspace{0.222em}z,\\hspace{0.222em}x⟩{|}_{z=x} \\\\  & =⟨\\underbrace{0}_{P},\\hspace{0.222em}\\underbrace{x}_{Q},\\hspace{0.222em}\\underbrace{x}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot 1-x\\cdot 0+x))\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}x\\hspace{0.222em}\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}x\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }r\\operatorname{cos}⁡\\theta \\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{[{r}^{2}\\operatorname{sin}⁡\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & =0.\\end{aligned}\n$$"] [17592186281554 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2}+t,\\,y={t}^{3}+{t}^{2},\\,z=2{t}^{2}+2t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+z\\hspace{0.167em}\\mathbf{j}+x\\hspace{0.167em}\\mathbf{k} \\\\  & =({t}^{3}+{t}^{2})\\hspace{0.167em}\\mathbf{i}+(2{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+({t}^{2}+t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+2t)\\hspace{0.167em}\\mathbf{k} \\\\  & =(2t+1)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+(4t+2)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(({t}^{3}+{t}^{2})\\hspace{0.167em}\\mathbf{i}+(2{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+({t}^{2}+t)\\hspace{0.167em}\\mathbf{k})\\cdot ((2t+1)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+(4t+2)\\hspace{0.167em}\\mathbf{k}) \\\\  & =({t}^{3}+{t}^{2})(2t+1)+(2{t}^{2}+2t)(3{t}^{2}+2t)+({t}^{2}+t)(4t+2) \\\\  & =2t+11{t}^{2}+17{t}^{3}+8{t}^{4}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{0}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{0}(2t+11{t}^{2}+17{t}^{3}+8{t}^{4})\\hspace{0.222em}\\text{d}t \\\\  & ={[{t}^{2}+\\frac{11}{3}{t}^{3}+\\frac{17}{4}{t}^{4}+\\frac{8}{5}{t}^{5}]}_{-1}^{0} \\\\  & =0-(1-\\frac{11}{3}+\\frac{17}{4}-\\frac{8}{5}) \\\\  & =\\frac{1}{60}\\end{aligned}\n$$"] [17592186281555 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{3}-t,\\,y=2{t}^{2}+1,\\,z={t}^{2}-1.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+yz\\hspace{0.167em}\\mathbf{k} \\\\  & =(2{t}^{2}+1)\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+(2{t}^{2}+1)({t}^{2}-1)\\hspace{0.167em}\\mathbf{k} \\\\  & =(2{t}^{2}+1)\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+(2{t}^{4}-{t}^{2}-1)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+1)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\hspace{0.167em}\\mathbf{k} \\\\  & =(3{t}^{2}-1)\\hspace{0.167em}\\mathbf{i}+4t\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =((2{t}^{2}+1)\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+(2{t}^{4}-{t}^{2}-1)\\hspace{0.167em}\\mathbf{k})\\cdot ((3{t}^{2}-1)\\hspace{0.167em}\\mathbf{i}+4t\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}) \\\\  & =(2{t}^{2}+1)(3{t}^{2}-1)+3(4t)+(2{t}^{4}-{t}^{2}-1)(2t) \\\\  & =-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5})\\hspace{0.222em}\\text{d}t \\\\  & ={[-t+5{t}^{2}+\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{4}+\\frac{6}{5}{t}^{5}+\\frac{2}{3}{t}^{6}]}_{-1}^{1} \\\\  & =(-1+5+\\frac{1}{3}-\\frac{1}{2}+\\frac{6}{5}+\\frac{2}{3})-(1+5-\\frac{1}{3}-\\frac{1}{2}-\\frac{6}{5}+\\frac{2}{3}) \\\\  & =-2+\\frac{2}{3}+\\frac{12}{5} \\\\  & =\\frac{16}{15}\\end{aligned}\n$$"] [17592186281556 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=2\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =2y\\hspace{0.167em}\\mathbf{i}-2x\\hspace{0.167em}\\mathbf{j}+{e}^{z-2y}\\hspace{0.167em}\\mathbf{k} \\\\  & =2\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}-2\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+{e}^{2\\operatorname{sin}(\\pi t)-2\\operatorname{sin}(\\pi t)}\\hspace{0.167em}\\mathbf{k} \\\\  & =2\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}-2\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(\\pi t))\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{k} \\\\  & =-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+2\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(2\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}-2\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+\\mathbf{k})\\cdot (-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+2\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}) \\\\  & =2\\operatorname{sin}(\\pi t)\\cdot (-\\pi \\operatorname{sin}(\\pi t))-2\\operatorname{cos}(\\pi t)\\cdot \\pi \\operatorname{cos}(\\pi t)+1\\cdot 2\\pi \\operatorname{cos}(\\pi t) \\\\  & =-2\\pi {\\operatorname{sin}}^{2}(\\pi t)-2\\pi {\\operatorname{cos}}^{2}(\\pi t)+2\\pi \\operatorname{cos}(\\pi t) \\\\  & =-2\\pi +2\\pi \\operatorname{cos}(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-2\\pi +2\\pi \\operatorname{cos}(\\pi t))\\hspace{0.222em}\\text{d}t \\\\  & =[-2\\pi t+2\\operatorname{sin}(\\pi t)]_{-1}^{1} \\\\  & =(-2\\pi (1)+0)-(-2\\pi (-1)+0) \\\\  & =-4\\pi \\end{aligned}\n$$"] [17592186287850 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{d}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{-2\\cdot 4+0\\cdot (-1)+0\\cdot 0}{\\sqrt{{4}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =-\\frac{8}{\\sqrt{17}}.\\end{aligned}\n$$"] [17592186287886 "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{r}\\times \\mathbf{t} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & -2 & 3 \\\\ 0 & 1 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 3 \\\\ 1 & -2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 3 \\\\ 0 & -2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & -2 \\\\ 0 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot (-2)-3\\cdot 1)\\mathbf{i}-(1\\cdot (-2)-3\\cdot 0)\\mathbf{j}+(1\\cdot 1-(-2)\\cdot 0)\\mathbf{k} \\\\  & =\\mathbf{i}+2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{r}\\times \\mathbf{t}\\hspace{0.167em}| \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{6}}{2}.\n$$"] [17592186287887 "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(2\\mathbf{i}+\\mathbf{j}+\\mathbf{k})-\\mathbf{k} \\\\  & =2\\mathbf{i}+\\mathbf{j} \\\\  & =⟨2,1,0⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(3\\mathbf{i}+\\mathbf{j}+\\mathbf{k})-\\mathbf{k} \\\\  & =3\\mathbf{i}+\\mathbf{j} \\\\  & =⟨3,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 1 & 0 \\\\ 3 & 1 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 0 \\\\ 1 & 0\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 0 \\\\ 3 & 0\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 1 \\\\ 3 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot 0-0\\cdot 1)\\mathbf{i}-(2\\cdot 0-0\\cdot 3)\\mathbf{j}+(2\\cdot 1-1\\cdot 3)\\mathbf{k} \\\\  & =-\\mathbf{k} \\\\  & =⟨0,0,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{0}^{2}+{0}^{2}+(-1)^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{1}{2}.\n$$"] [17592186287909 "We know that $\\mathbf{g}⊥\\mathbf{h}$ ($\\mathbf{g}$ and $\\mathbf{h}$ are perpendicular) if and only if $\\mathbf{g}\\cdot \\mathbf{h}=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}\\mathbf{g}\\cdot \\mathbf{h} & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}\\mathbf{g}\\cdot \\mathbf{h} & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$"] [17592186287928 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"] [17592186287929 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{q}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$"] [17592186287930 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+1\\cdot 4+(-1)\\cdot 2}{\\sqrt{{1}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{21}}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{\\mathbf{b}\\cdot \\mathbf{a}}{|\\hspace{0.167em}\\mathbf{a}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{4}{\\sqrt{21}}-\\frac{4}{\\sqrt{6}} \\\\  & =\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}.\\end{aligned}\n$$"] [17592186287931 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{d}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{c}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}-{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d} & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$"] [17592186287932 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{\\mathbf{b}\\cdot \\mathbf{a}}{|\\hspace{0.167em}\\mathbf{a}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$"] [17592186287933 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{q}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{p}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}+{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q} & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"] [17592186287968 "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{u}\\times \\mathbf{v} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 1 & -1 \\\\ 1 & 2 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 2 & 0\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -1 \\\\ 1 & 0\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 1 \\\\ 1 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot 0-2\\cdot (-1))\\mathbf{i}-(2\\cdot 0-1\\cdot (-1))\\mathbf{j}+(2\\cdot 2-1\\cdot 1)\\mathbf{k} \\\\  & =2\\mathbf{i}-\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,-1,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{u}\\times \\mathbf{v}\\hspace{0.167em}| \\\\  & =\\sqrt{{2}^{2}+(-1)^{2}+{3}^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$"] [17592186287969 "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{f}\\times \\mathbf{g} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 1 & -2 \\\\ 3 & 2 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -2 \\\\ 2 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & -2 \\\\ 3 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 1 \\\\ 3 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot 1-2\\cdot (-2))\\mathbf{i}-(1\\cdot 1-3\\cdot (-2))\\mathbf{j}+(1\\cdot 2-3\\cdot 1)\\mathbf{k} \\\\  & =5\\mathbf{i}-7\\mathbf{j}-\\mathbf{k} \\\\  & =⟨5,-7,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{f}\\times \\mathbf{g}\\hspace{0.167em}| \\\\  & =\\sqrt{{5}^{2}+(-7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{75} \\\\  & =5\\sqrt{3}.\\end{aligned}\n$$"] [17592186287970 "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{h}\\times \\mathbf{l} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 0 & 3 \\\\ 4 & 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 3 \\\\ 1 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 3 \\\\ 4 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 0 \\\\ 4 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(0\\cdot 3-1\\cdot 3)\\mathbf{i}-(2\\cdot 3-4\\cdot 3)\\mathbf{j}+(2\\cdot 1-4\\cdot 0)\\mathbf{k} \\\\  & =-3\\mathbf{i}+6\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨-3,6,2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{h}\\times \\mathbf{l}\\hspace{0.167em}| \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"] [17592186287971 "First, we find the vectors $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =\\mathbf{s}-\\mathbf{r} \\\\  & =(2\\mathbf{i}-2\\mathbf{j}+2\\mathbf{k})-(3\\mathbf{i}-2\\mathbf{j}+\\mathbf{k}) \\\\  & =-\\mathbf{i}+\\mathbf{k} \\\\  & =⟨-1,0,1⟩ \\\\ \\overset{\\to }{RT} & =\\mathbf{t}-\\mathbf{r} \\\\  & =(\\mathbf{i}-3\\mathbf{j}+3\\mathbf{k})-(3\\mathbf{i}-2\\mathbf{j}+\\mathbf{k}) \\\\  & =-2\\mathbf{i}-\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨-2,-1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{RS}\\times \\overset{\\to }{RT} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -1 & 0 & 1 \\\\ -2 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 1 \\\\ -1 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-1 & 1 \\\\ -2 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-1 & 0 \\\\ -2 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =(0\\cdot 2-(-1)\\cdot 1)\\mathbf{i}-((-1)\\cdot 2-(-2)\\cdot 1)\\mathbf{j}+((-1)\\cdot (-1)-(-2)\\cdot 0)\\mathbf{k} \\\\  & =\\mathbf{i}+\\mathbf{k} \\\\  & =⟨1,0,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{RS}\\times \\overset{\\to }{RT}| \\\\  & =\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,RST$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$"] [17592186290429 "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${\\mathbf{n}}_{i}$ are shown below.\n\n![](images/0b/0b753318ebad9270c3fc8788d0e3949ffb29a800eb3f8dd6fb67cb271be68033.png)\n\nFirst, consider the side ${C}_{1}.$ We have that ${\\mathbf{n}}_{1}=\\mathbf{i},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{1}}(2x\\hspace{0.167em}\\mathbf{i}+2y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{i}\\hspace{0.222em}\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=4\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-4,4].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s & =2{\\int }_{-4}^{4}4\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =8{\\int }_{-4}^{4}\\text{d}t \\\\  & =8(4-(-4)) \\\\  & =8\\cdot 8 \\\\  & =64.\\end{aligned}\n$$\n\nBy symmetry, the flux integrals over the sides ${C}_{2},{C}_{3},$ and ${C}_{4}$ must be the same. Therefore,\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=4\\cdot 64=256.\n$$"]}
