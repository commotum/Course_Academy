#{[{:db/id #edb/ref 17592186566196 :multistep/context "A company produces two types of products, type A and type B. The revenue function of the company, in thousands of dollars, is given by $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=2{x}^{4}+8{x}^{2}{y}^{2}-8{x}^{2}+6{y}^{2}-1,\n$$\n\nwhere $$\n\\displaystyle x={\\begin{bmatrix}\\,x & y\\,\\end{bmatrix}}^{T},\n$$ $x$ is the price (in thousands of dollars) per unit of product A, and $y$ is the price (in thousands of dollars) per unit of product B. The company can adjust the prices per unit for both types of products by adding or removing certain features." :multistep/id #uuid "d9a60175-ea7e-5ff5-a696-1e759f0e8e78" :multistep/steps [{:db/id #edb/ref 17592186566278 :step/content {:db/id #edb/ref 17592186566225}} {:db/id #edb/ref 17592186566281 :step/content {:db/id #edb/ref 17592186566270}} {:db/id #edb/ref 17592186566288 :step/content {:db/id #edb/ref 17592186566263}} {:db/id #edb/ref 17592186566293 :step/content {:db/id #edb/ref 17592186566206}} {:db/id #edb/ref 17592186566298 :step/content {:db/id #edb/ref 17592186566204}} {:db/id #edb/ref 17592186566303 :step/content {:db/id #edb/ref 17592186566244}} {:db/id #edb/ref 17592186566311 :step/content {:db/id #edb/ref 17592186566217}}]}] [{:db/id #edb/ref 17592186578790 :multistep/context "Consider the following functions: \n\n$$\nf(x)=2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x,\\,g(x)=2{x}^{2}+4x+1,\\,h(x)={e}^{2x}\n$$" :multistep/id #uuid "28c2b9d3-d453-55d6-bb8e-a0699c2d9716" :multistep/steps [{:db/id #edb/ref 17592186578887 :step/content {:db/id #edb/ref 17592186578842}} {:db/id #edb/ref 17592186578889 :step/content {:db/id #edb/ref 17592186578819}} {:db/id #edb/ref 17592186578898 :step/content {:db/id #edb/ref 17592186578796}} {:db/id #edb/ref 17592186578905 :step/content {:db/id #edb/ref 17592186578837}} {:db/id #edb/ref 17592186578908 :step/content {:db/id #edb/ref 17592186578806}} {:db/id #edb/ref 17592186578940 :step/content {:db/id #edb/ref 17592186578870}} {