k}, & \\hspace{2em}\\mathbf{j}\\times \\mathbf{i}=-\\mathbf{k}, \\\\ \\mathbf{j}\\times \\mathbf{k}=\\mathbf{i}, & \\hspace{2em}\\mathbf{k}\\times \\mathbf{j}=-\\mathbf{i}, \\\\ \\mathbf{k}\\times \\mathbf{i}=\\mathbf{j}, & \\hspace{2em}\\mathbf{i}\\times \\mathbf{k}=-\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =({a}_{1}\\cdot {b}_{1})\\underbrace{\\mathbf{i}\\times \\mathbf{i}}_{=\\mathbf{0}}+({a}_{1}\\cdot {b}_{2})\\underbrace{\\mathbf{i}\\times \\mathbf{j}}_{=\\mathbf{k}}+({a}_{1}\\cdot {b}_{3})\\underbrace{\\mathbf{i}\\times \\mathbf{k}}_{=-\\mathbf{j}} \\\\  & +({a}_{2}\\cdot {b}_{1})\\underbrace{\\mathbf{j}\\times \\mathbf{i}}_{=-\\mathbf{k}}+({a}_{2}\\cdot {b}_{2})\\underbrace{\\mathbf{j}\\times \\mathbf{j}}_{=\\mathbf{0}}+({a}_{2}\\cdot {b}_{3})\\underbrace{\\mathbf{j}\\times \\mathbf{k}}_{=\\mathbf{i}} \\\\  & +({a}_{3}\\cdot {b}_{1})\\underbrace{\\mathbf{k}\\times \\mathbf{i}}_{=\\mathbf{j}}+({a}_{3}\\cdot {b}_{2})\\underbrace{\\mathbf{k}\\times \\mathbf{j}}_{=-\\mathbf{i}}+({a}_{3}\\cdot {b}_{3})\\underbrace{\\mathbf{k}\\times \\mathbf{k}}_{=\\mathbf{0}} \\\\  & =({a}_{2}{b}_{3}-{a}_{3}{b}_{2})\\mathbf{i}-({a}_{1}{b}_{3}-{a}_{3}{b}_{1})\\mathbf{j}+({a}_{1}{b}_{2}-{a}_{2}{b}_{1})\\mathbf{k}.\\end{aligned}\n$$\n\nThe expression above is equal to the formula given for the cross product of two general vectors using the determinant." 13194139543369 17592186576411 true] [17592186060923 1064 "We have been using the following formula to compute the cross product of two vectors:\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{a}_{2} & {a}_{3} \\\\ {b}_{2} & {b}_{3}\\end{vmatrix}i-\\begin{vmatrix}{a}_{1} & {a}_{3} \\\\ {b}_{1} & {b}_{3}\\end{vmatrix}j+\\begin{vmatrix}{a}_{1} & {a}_{2} \\\\ {b}_{1} & {b}_{2}\\end{vmatrix}k \\\\  & =({a}_{2}{b}_{3}-{a}_{3}{b}_{2})i-({a}_{1}{b}_{3}-{a}_{3}{b}_{1})j+({a}_{1}{b}_{2}-{a}_{2}{b}_{1})k\\end{aligned}\n$$\n\nBut where does this formula come from? Let's find out.\n\nSuppose we want to find the cross product $\\mathbf{a} \\times \\mathbf{b}$ for $\\mathbf{a}=a_1\\mathbf{i}+a_2\\mathbf{j}+a_3\\mathbf{k}$ and $\\mathbf{b}=b_1\\mathbf{i}+b_2\\mathbf{j}+b_3\\mathbf{k}.$ Using properties of the cross product, we obtain\n\n$$\n\\begin{aligned}a\\times b & =({a}_{1}i+{a}_{2}j+{a}_{3}k)\\times ({b}_{1}i+{b}_{2}j+{b}_{3}k) \\\\  & =({a}_{1}\\cdot {b}_{1})i\\times i+({a}_{1}\\cdot {b}_{2})i\\times j+({a}_{1}\\cdot {b}_{3})i\\times k \\\\  & +({a}_{2}\\cdot {b}_{1})j\\times i+({a}_{2}\\cdot {b}_{2})j\\times j+({a}_{2}\\cdot {b}_{3})j\\times k \\\\  & +({a}_{3}\\cdot {b}_{1})k\\times i+({a}_{3}\\cdot {b}_{2})k\\times j+({a}_{3}\\cdot {b}_{3})k\\times k.\\end{aligned}\n$$\n\nSince the cross product of two parallel (collinear) vectors is equal to $\\mathbf 0,$ we have\n\n$$\n\\mathbf{i}\\times\\mathbf{i} = \\mathbf{j}\\times\\mathbf{j} = \\mathbf{k}\\times\\mathbf{k} = \\mathbf 0.\n$$\n\nAlso, using the definition of the cross product we obtain\n\n$$\n\\begin{aligned}i\\times j=k, & \\,j\\times i=-k, \\\\ j\\times k=i, & \\,k\\times j=-i, \\\\ k\\times i=j, & \\,i\\times k=-j.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}a\\times b & =({a}_{1}\\cdot {b}_{1})\\underbrace{i\\times i}_{=0}+({a}_{1}\\cdot {b}_{2})\\underbrace{i\\times j}_{=k}+({a}_{1}\\cdot {b}_{3})\\underbrace{i\\times k}_{=-j} \\\\  & +({a}_{2}\\cdot {b}_{1})\\underbrace{j\\times i}_{=-k}+({a}_{2}\\cdot {b}_{2})\\underbrace{j\\times j}_{=0}+({a}_{2}\\cdot {b}_{3})\\underbrace{j\\times k}_{=i} \\\\  & +({a}_{3}\\cdot {b}_{1})\\underbrace{k\\times i}_{=j}+({a}_{3}\\cdot {b}_{2})\\underbrace{k\\times j}_{=-i}+({a}_{3}\\cdot {b}_{3})\\underbrace{k\\times k}_{=0} \\\\  & =({a}_{2}{b}_{3}-{a}_{3}{b}_{2})i-({a}_{1}{b}_{3}-{a}_{3}{b}_{1})j+({a}_{1}{b}_{2}-{a}_{2}{b}_{1})k.\\end{aligned}\n$$\n\nThe expression above is equal to the formula given for the cross product of two general vectors using the determinant." 13194139543369 17592186576411 false] [17592186062329 1078 #edb/ref 17592186062334 13194139543369 17592186576411 true] [17592186062341 1078 #edb/ref 17592186062344 13194139543369 17592186576411 true] [17592186063174 1078 #edb/ref 17592186063177 13194139543369 17592186576411 true] [17592186063186 1078 #edb/ref 17592186063190 13194139543369 17592186576411 true] [17592186064712 1074 "An antiderivative of $x^3$ is $x^4/4$. Thus\n$$\\int_{-2}^{2}x^3\\,dx=\\left[\\frac{x^4}{4}\\right]_{-2}^{2}=4-4=0.$$" 13194139543369 17592186576411 true] [17592186064714 1074 "Since $x\\ge0$ on the interval, $\\sqrt{x^5}=x^{5/2}$. Hence\n$$\\int_0^4\\sqrt{x^5}\\,dx=\\left[\\frac27x^{7/2}\\right]_0^4=\\frac27(128)=\\frac{256}{7}.$$" 13194139543369 17592186576411 true] [17592186064853 1074 "Apply the power rule:\n$$\\int_1^2x^{-4}\\,dx=\\left[-\\frac1{3x^3}\\right]_1^2=-\\frac1{24}+\\frac13=\\frac7{24}.$$" 13194139543369 17592186576411 true] [17592186064855 1074 "On this nonnegative interval, the integrand is $x^{3/5}$. Thus\n$$\\int_0^1\\sqrt[5]{x^3}\\,dx=\\left[\\frac58x^{8/5}\\right]_0^1=\\frac58.$$" 13194139543369 17592186576411 true] [17592186065411 1064 "Consider the function $f(x) = x^2.$ The **definite integral** **of** $\\mathbf f(x)$ **between** $\\mathbf{x=1}$ and $\\mathbf{x=2}$ is denoted\n\n$$\n\\int_1^2 x^2 \\, \\textrm d x.\n$$\n\nGeometrically, this definite integral can be interpreted as the **signed area** bounded between the curve $y=f(x),$ the lines $x=1$ and $x=2,$ and the $x$-axis, as shown below.\n\n![](images/fd/fdff7865deed3d5329495bac5dfe045fefca9c09c6fccb7cd02b73d40de8bf69.png)\n\nThe area is taken as positive (with a plus sign) if the corresponding region lies above the $x$-axis and as negative (with a minus sign) if the region lies below the $x$-axis. \n\nTo calculate this area, we use a theorem known as the **fundamental theorem of calculus**, which states the following:\n\n> *If $f(x)$ is a function that's continuous on an interval $[a,b]$, and there exists a function $F(x)$ such that $F'(x) = f(x)$ on $[a,b]$, then*\n\n$$\n\\int_a^b f(x)\\,\\textrm{d}x = F(b) - F(a).\n$$\n\nSo how do we use this to calculate our definite integral $$\n\\displaystyle \\int_1^2 x^2\\,\\textrm{d}x?\n$$ We just need to follow a few steps:\n\n **Step 1**: Find the *indefinite* integral (also known as the antiderivative) of the function using the power rule. We can ignore the constant of integration.\n\n$$\n\\int x^2 \\, \\textrm d x = \\dfrac{x^3}{3}\n$$\n\n \n\n**Step 2**: Write the lower and upper limit next to the result.\n\n$$\n\\int_1^2 x^2 \\, \\textrm d x = \\dfrac{x^3}{3}\\Bigg|_{\\color{red}1}^{\\color{blue}2}\n$$\n\n \n\n**Step 3**: Evaluate the antiderivative between the upper and lower limit, and subtract them.\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x & =\\frac{(2)^{3}}{3}-\\frac{(1)^{3}}{3} \\\\  & =\\frac{8}{3}-\\frac{1}{3} \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\int_1^2 f(x)\\,\\textrm{d}x = \\dfrac73.\n$$" 13194139543369 17592186576411 false] [17592186065411 1064 "Consider the function $f(x) = x^2.$ The **definite integral** **of** $\\mathbf f(x)$ **between** $\\mathbf{x=1}$ and $\\mathbf{x=2}$ is denoted\n\n$$\n\\int_1^2 x^2 \\, \\textrm d x.\n$$\n\nGeometrically, this definite integral can be interpreted as the **signed area** bounded between the curve $y=f(x),$ the lines $x=1$ and $x=2,$ and the $x$-axis, as shown below.\n\n![](images/fd/fdff7865deed3d5329495bac5dfe045fefca9c09c6fccb7cd02b73d40de8bf69.png)\n\nThe area is taken as positive (with a plus sign) if the corresponding region lies above the $x$-axis and as negative (with a minus sign) if the region lies below the $x$-axis. \n\nTo calculate this area, we use a theorem known as the **fundamental theorem of calculus**, which states the following:\n\n> *If $f(x)$ is a function that's continuous on an interval $[a,b]$, and there exists a function $F(x)$ such that $F'(x) = f(x)$ on $[a,b]$, then*\n\n$$\n\\int_a^b f(x)\\,\\textrm{d}x = F(b) - F(a).\n$$\n\nSo how do we use this to calculate our definite integral $$\n\\displaystyle \\int_1^2 x^2\\,\\textrm{d}x?\n$$ We just need to follow a few steps:\n\n **Step 1**: Find the *indefinite* integral (also known as the antiderivative) of the function using the power rule. We can ignore the constant of integration.\n\n$$\n\\int x^2 \\, \\textrm d x = \\dfrac{x^3}{3}\n$$\n\n \n\n**Step 2**: Write the lower and upper limit next to the result.\n\n$$\n\\int_1^2 x^2 \\, \\textrm d x = \\dfrac{x^3}{3}\\Bigg|_{\\color{red}1}^{\\color{blue}2}\n$$\n\n \n\n**Step 3**: Evaluate the antiderivative between the upper and lower limit, and subtract them.\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{2}\\hspace{0.167em}\\text{d}x & =\\frac{({\\color{blue}2})^{3}}{3}-\\frac{({\\color{red}1})^{3}}{3} \\\\  & =\\frac{8}{3}-\\frac{1}{3} \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\int_1^2 f(x)\\,\\textrm{d}x = \\dfrac73.\n$$" 13194139543369 17592186576411 true] [17592186080165 1078 #edb/ref 17592186080170 13194139543369 17592186576411 true] [17592186080747 1078 #edb/ref 17592186080748 13194139543369 17592186576411 true] [17592186082409 1078 #edb/ref 17592186082412 13194139543369 17592186576411 true] [17592186083545 1074 "At $t=-1$, the point is $(0,1)$, while $x'(t)=4t^3+1=-3$ and $y'(t)=2t=-2$. The tangent slope is $2/3$, so the normal slope is $-3/2$. The normal is $y=1-3x/2$; setting $y=0$ gives $x=2/3$." 13194139543369 17592186576411 true] [17592186083547 1074 "First, we find the coordinates of the point $C$ by substituting $t=\\frac{\\pi }{2}$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =\\operatorname{ln}⁡[\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)]=\\operatorname{ln}⁡1=0, \\\\ y & =\\frac{1}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}=1\\end{aligned}\n$$\n\nSo we're looking to find the equation of the normal at the point $(0,1).$ For this, we need to find $\\frac{\\text{d}y}{\\text{d}x},$ which means we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{'}(t)=\\frac{\\operatorname{cos}t}{\\operatorname{sin}t},\\hspace{2em}{y}^{'}(t)=-\\frac{\\operatorname{cos}t}{{\\operatorname{sin}}^{2}t}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =\\frac{{y}^{'}(t)}{{x}^{'}(t)} \\\\  & =-\\frac{\\operatorname{cos}t}{{\\operatorname{sin}}^{2}t}\\cdot \\frac{\\operatorname{sin}t}{\\operatorname{cos}t} \\\\  & =-\\frac{1}{\\operatorname{sin}t}.\\end{aligned}\n$$\n\nAt the point where $t=\\frac{\\pi }{2},$  the slope $m$ of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=\\pi /2} & =-\\frac{1}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}=-1.\\end{aligned}\n$$\n\nTo find the slope ${m}_{n}$ of the normal line, we take the negative reciprocal of $m$:\n\n$$\n{m}_{n}=-\\frac{1}{m}=-\\frac{1}{\\,(-1)\\,}=1\n$$\n\nTo calculate the equation of the normal, we use point-slope form with the point $({x}_{1},{y}_{1})=(0,1)$ and the slope ${m}_{n}=1.$ We get\n\n$$\n\\begin{aligned}y-1 & =1\\cdot (x-0) \\\\ y & =x+1.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186083547 1074 "First, we find the coordinates of the point $C$ by substituting $t=\\frac{\\pi }{2}$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =\\operatorname{ln}⁡[\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)]=\\operatorname{ln}⁡1=0, \\\\ y & =\\frac{1}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}=1\\end{aligned}\n$$\n\nSo we're looking to find the equation of the normal at the point $(0,1).$ For this, we need to find $\\frac{\\text{d}y}{\\text{d}x},$ which means we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t},\\,{y}^{′}(t)=-\\frac{\\operatorname{cos}⁡t}{{sin}^{2}⁡t}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =-\\frac{\\operatorname{cos}⁡t}{{sin}^{2}⁡t}\\cdot \\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =-\\frac{1}{\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nAt the point where $t=\\frac{\\pi }{2},$  the slope $m$ of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=\\pi /2} & =-\\frac{1}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}=-1.\\end{aligned}\n$$\n\nTo find the slope ${m}_{n}$ of the normal line, we take the negative reciprocal of $m$:\n\n$$\n{m}_{n}=-\\frac{1}{m}=-\\frac{1}{\\,(-1)\\,}=1\n$$\n\nTo calculate the equation of the normal, we use point-slope form with the point $({x}_{1},{y}_{1})=(0,1)$ and the slope ${m}_{n}=1.$ We get\n\n$$\n\\begin{aligned}y-1 & =1\\cdot (x-0) \\\\ y & =x+1.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186083614 1074 "Since $dx/dt=1$ and $dy/dt=3t^2$, we have $dy/dx=3t^2$. A horizontal tangent requires $dy/dx=0$, which gives $t=0$." 13194139543369 17592186576411 true] [17592186083913 1074 "At $t=-1$ the point is $(3,-1)$. The tangent slope is\n$$\\frac{dy}{dx}=\\frac{5t^4}{2t-2}=-\\frac54.$$\nHence its equation is $y+1=-\\frac54(x-3)$." 13194139543369 17592186576411 true] [17592186084854 1078 #edb/ref 17592186084855 13194139543369 17592186576411 true] [17592186084860 1078 #edb/ref 17592186084865 13194139543369 17592186576411 true] [17592186084866 1078 #edb/ref 17592186084869 13194139543369 17592186576411 true] [17592186084914 1078 #edb/ref 17592186084915 13194139543369 17592186576411 true] [17592186084920 1078 #edb/ref 17592186084922 13194139543369 17592186576411 true] [17592186086268 1078 #edb/ref 17592186086272 13194139543369 17592186576411 true] [17592186086340 1078 #edb/ref 17592186086344 13194139543369 17592186576411 true] [17592186086783 1078 #edb/ref 17592186086785 13194139543369 17592186576411 true] [17592186086861 1078 #edb/ref 17592186086864 13194139543369 17592186576411 true] [17592186088020 1074 "Eliminating the parameter gives\n$$(x+3)^2+(y-5)^2=9^2(\\cos^2t+\\sin^2t)=81.$$\nThis is a circle centered at $(-3,5)$ with radius $9$." 13194139543369 17592186576411 true] [17592186088021 1074 "The standard counterclockwise circle of radius $8$ about the origin is $x=8\\cos t$, $y=8\\sin t$. At $t=0$ it starts at $(8,0)$, and its initial velocity points upward as required." 13194139543369 17592186576411 true] [17592186088022 1074 "The parametrization $x=6\\cos t$, $y=6\\sin t$ satisfies $x^2+y^2=36$, giving the circle of radius $6$ about the origin." 13194139543369 17592186576411 true] [17592186088030 1074 "The square root requires $t\\ge0$. Therefore $y=\\sqrt t\\ge0$ and $x=t(t+6)\\ge0$, so the curve lies in the first quadrant together with the origin." 13194139543369 17592186576411 true] [17592186088031 1074 "Complete the square:\n$$x=t^2-4t=(t-2)^2-4\\ge-4.$$\nThe lower bound is attained at $t=2$." 13194139543369 17592186576411 true] [17592186088269 1074 "Substitute the indicated parameter values: $a=(-2)^2+(-2)=2$, $b=0^2-0=0$, and $c=3^2+3=12$. Thus $a+b+c=14$." 13194139543369 17592186576411 true] [17592186088270 1071 "For the parametric curve\n\n$$\nx={t}^{2}-4,\\,\\,\\,y=\\frac{5}{2}-\\frac{t}{2},\\,-1\\le t\\le 5,\n$$\n\nconsider the following table of values:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$5$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$a$</td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$21$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\frac{5}{2}$</td>\n<td data-cell-align=\"center\">$b$</td>\n<td data-cell-align=\"center\">$\\frac{3}{2}$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$\\frac{1}{2}$</td>\n<td data-cell-align=\"center\">$c$</td>\n</tr>\n</tbody></table></div>\n\n\n$$\n\n$$\n\nFind the value of $a-b+c.$" 13194139543369 17592186576411 false] [17592186088270 1071 "For the parametric curve\n\n$$\nx={t}^{2}-4,\\,\\,\\,y=\\frac{5}{2}-\\frac{t}{2},\\,-1\\le t\\le 5,\n$$\n\nconsider the following table of values:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$5$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">${\\color{blue}a}$</td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$21$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\frac{5}{2}$</td>\n<td data-cell-align=\"center\">${\\color{blue}b}$</td>\n<td data-cell-align=\"center\">$\\frac{3}{2}$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$\\frac{1}{2}$</td>\n<td data-cell-align=\"center\">${\\color{blue}c}$</td>\n</tr>\n</tbody></table></div>\n\n\n$$\n\n$$\n\nFind the value of $a-b+c.$" 13194139543369 17592186576411 true] [17592186088272 1074 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =3\\operatorname{cos}\\theta  \\\\ {x}^{2} & =(3\\operatorname{cos}\\theta )^{2} \\\\  & =9{\\operatorname{cos}}^{2}\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =3\\operatorname{sin}\\theta  \\\\ {y}^{2} & =(3\\operatorname{sin}\\theta )^{2} \\\\  & =9{\\operatorname{sin}}^{2}\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =9{\\operatorname{cos}}^{2}\\theta +9{\\operatorname{sin}}^{2}\\theta  \\\\  & =9({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta ) \\\\  & =9(1) \\\\  & =9.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=9.$" 13194139543369 17592186576411 true] [17592186088272 1074 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =3\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & =(3\\operatorname{cos}⁡\\theta )^{2} \\\\  & =9{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =3\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & =(3\\operatorname{sin}⁡\\theta )^{2} \\\\  & =9{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =9{cos}^{2}⁡\\theta +9{sin}^{2}⁡\\theta  \\\\  & =9({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =9(1) \\\\  & =9.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=9.$" 13194139543369 17592186576411 false] [17592186088281 1074 "Using $-1\\le\\cos\\theta,\\sin\\theta\\le1$, we obtain $-4\\le x\\le2$ and $0\\le y\\le4$." 13194139543369 17592186576411 true] [17592186088355 1074 "Translate the standard radius-$2$ circle to center $(-1,2)$:\n$$x=2\\cos t-1,\\qquad y=2\\sin t+2.$$\nAt $t=0$ it starts at $(1,2)$ and moves counterclockwise." 13194139543369 17592186576411 true] [17592186088368 1074 "The displayed arc lies in the third quadrant, from $(-4,0)$ to $(0,-4)$. In $x=4\\cos\\theta$, $y=4\\sin\\theta$, these endpoints occur at $\\theta=\\pi$ and $\\theta=3\\pi/2$, respectively. Use $\\pi\\le\\theta\\le3\\pi/2$." 13194139543369 17592186576411 true] [17592186088961 1064 "To convert the parametric equations of a circle to a Cartesian equation, we can eliminate the parameter $\\theta$ using the Pythagorean identity:\n\n$$\n\\cos^2 \\theta + \\sin^2 \\theta = 1\n$$\n\nTo demonstrate, consider the circle defined parametrically as\n\n$$\nx=5\\cos\\theta,\\quad y=5\\sin\\theta, \\quad 0\\leq\\theta\\lt 2\\pi.\n$$\n\nBy isolating the $\\cos\\theta$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x}{5} & =\\operatorname{cos}\\theta  \\\\ \\frac{{x}^{2}}{{5}^{2}} & ={\\operatorname{cos}}^{2}\\theta  \\\\ \\frac{{x}^{2}}{25} & ={\\operatorname{cos}}^{2}\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\sin\\theta$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y}{5} & =\\operatorname{sin}\\theta  \\\\ \\frac{{y}^{2}}{{5}^{2}} & ={\\operatorname{sin}}^{2}\\theta  \\\\ \\frac{{y}^{2}}{25} & ={\\operatorname{sin}}^{2}\\theta .\\end{aligned}\n$$\n\nSubstituting these values into the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}{\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta  & =1 \\\\ \\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{25} & =1 \\\\ {x}^{2}+{y}^{2} & =25.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $x^2+y^2 = 25.$" 13194139543369 17592186576411 true] [17592186088961 1064 "To convert the parametric equations of a circle to a Cartesian equation, we can eliminate the parameter $\\theta$ using the Pythagorean identity:\n\n$$\n\\cos^2 \\theta + \\sin^2 \\theta = 1\n$$\n\nTo demonstrate, consider the circle defined parametrically as\n\n$$\nx=5\\cos\\theta,\\quad y=5\\sin\\theta, \\quad 0\\leq\\theta\\lt 2\\pi.\n$$\n\nBy isolating the $\\cos\\theta$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x}{5} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{5}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{25} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\sin\\theta$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y}{5} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{5}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{25} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSubstituting these values into the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  & =1 \\\\ \\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{25} & =1 \\\\ {x}^{2}+{y}^{2} & =25.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $x^2+y^2 = 25.$" 13194139543369 17592186576411 false] [17592186098595 1078 #edb/ref 17592186098600 13194139543369 17592186576411 true] [17592186101208 1074 "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{sin}⁡t-1\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x+1}{2} \\\\ y=5\\operatorname{cos}⁡t+4\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{y-4}{5}.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t=1$, we get\n\n$$\n\\begin{aligned}{\\left(\\frac{x+1}{2}\\right)}^{2}+{\\left(\\frac{y-4}{5}\\right)}^{2}=1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $$\n\\displaystyle {\\left(\\frac{x+1}{2}\\right)}^{2}+{\\left(\\frac{y-4}{5}\\right)}^{2}=1.\n$$" 13194139543369 17592186576411 true] [17592186101208 1074 "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{sin}⁡t-1\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x+1}{2} \\\\ y=5\\operatorname{cos}⁡t+4\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{y-4}{5}.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}{\\left(\\frac{x+1}{2}\\right)}^{2}+{\\left(\\frac{y-4}{5}\\right)}^{2}=1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $$\n\\displaystyle {\\left(\\frac{x+1}{2}\\right)}^{2}+{\\left(\\frac{y-4}{5}\\right)}^{2}=1.\n$$" 13194139543369 17592186576411 false] [17592186101209 1074 "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{2} \\\\ y=3\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{y}{3}.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t=1,$ we get\n\n$$\n\\begin{aligned}{\\left(\\frac{y}{3}\\right)}^{2}+{\\left(\\frac{x}{2}\\right)}^{2}=1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $$\n\\displaystyle {\\left(\\frac{y}{3}\\right)}^{2}+{\\left(\\frac{x}{2}\\right)}^{2}=1.\n$$" 13194139543369 17592186576411 true] [17592186101209 1074 "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{2} \\\\ y=3\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{y}{3}.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1,$ we get\n\n$$\n\\begin{aligned}{\\left(\\frac{y}{3}\\right)}^{2}+{\\left(\\frac{x}{2}\\right)}^{2}=1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $$\n\\displaystyle {\\left(\\frac{y}{3}\\right)}^{2}+{\\left(\\frac{x}{2}\\right)}^{2}=1.\n$$" 13194139543369 17592186576411 false] [17592186101210 1074 "From $x=t-2$ we have $t=x+2$. Substitution into $y=t^2$ gives $y=(x+2)^2$, with no restriction on real $x$." 13194139543369 17592186576411 true] [17592186102632 1078 #edb/ref 17592186102635 13194139543369 17592186576411 true] [17592186102638 1078 #edb/ref 17592186102643 13194139543369 17592186576411 true] [17592186106126 1071 "Let $\\mathbf{a}=⟨3,1,-3⟩$, $\\mathbf{b}=⟨2,6,-2⟩$ and $\\mathbf{c}=⟨0,1,-4⟩$. Find $\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c})$." 13194139543369 17592186576411 true] [17592186106126 1071 "Let $a = ⟨3, 1,-3⟩$, $b = ⟨2, 6,-2⟩$ and $c = ⟨0, 1,-4⟩$. Find $a \\cdot (b \\cdot c)$." 13194139543369 17592186576411 false] [17592186106126 1074 "The source asks for $\\mathbf a\\cdot(\\mathbf b\\times\\mathbf c)$. Compute\n$$\\mathbf b\\times\\mathbf c=\\langle-22,8,2\\rangle,$$\nthen $\\langle3,1,-3\\rangle\\cdot\\langle-22,8,2\\rangle=-66+8-6=-64$." 13194139543369 17592186576411 true] [17592186106127 1068 #edb/ref 17592186102638 13194139543369 17592186576411 false] [17592186106127 1071 "Let $\\mathbf{p}=⟨2,-1,0⟩$, $\\mathbf{q}=⟨3,-3,2⟩$ and $\\mathbf{r}=⟨1,-4,1⟩.$ Find $\\mathbf{r}\\cdot (\\mathbf{q}\\times \\mathbf{p}).$" 13194139543369 17592186576411 true] [17592186106127 1071 "Let $p=⟨2,-1,0⟩$, $q=⟨3,-3,2⟩$ and $r=⟨1,-4,1⟩.$ Find $r\\cdot (q\\times p).$" 13194139543369 17592186576411 false] [17592186106127 1074 "Remember that the scalar triple product $\\mathbf{r}\\cdot (\\mathbf{q}\\times \\mathbf{p})$ is just the determinant of the matrix whose rows are given by $\\mathbf{r},$ $\\mathbf{q},$ and $\\mathbf{p}.$\n\nSo, we have\n\n$$\n\\begin{aligned}\\mathbf{r}\\cdot (\\mathbf{q}\\times \\mathbf{p}) & =\\begin{vmatrix}1 & -4 & 1 \\\\ 3 & -3 & 2 \\\\ 2 & -1 & 0\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-3 & 2 \\\\ -1 & 0\\end{vmatrix}-(-4)\\cdot \\begin{vmatrix}3 & 2 \\\\ 2 & 0\\end{vmatrix}+1\\cdot \\begin{vmatrix}3 & -3 \\\\ 2 & -1\\end{vmatrix} \\\\  & =((-3)\\cdot 0-(-1)\\cdot 2)+4(3\\cdot 0-2\\cdot 2)+(3\\cdot (-1)-2\\cdot (-3)) \\\\  & =2-16+3 \\\\  & =-11.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186106127 1074 "Remember that the scalar triple product $r\\cdot (q\\times p)$ is just the determinant of the matrix whose rows are given by $r,$ $q,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}r\\cdot (q\\times p) & =\\begin{vmatrix}1 & -4 & 1 \\\\ 3 & -3 & 2 \\\\ 2 & -1 & 0\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-3 & 2 \\\\ -1 & 0\\end{vmatrix}-(-4)\\cdot \\begin{vmatrix}3 & 2 \\\\ 2 & 0\\end{vmatrix}+1\\cdot \\begin{vmatrix}3 & -3 \\\\ 2 & -1\\end{vmatrix} \\\\  & =((-3)\\cdot 0-(-1)\\cdot 2)+4(3\\cdot 0-2\\cdot 2)+(3\\cdot (-1)-2\\cdot (-3)) \\\\  & =2-16+3 \\\\  & =-11.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186106128 1071 "Find $\\mathbf{b}\\cdot (\\mathbf{c}\\times \\mathbf{a})$, if $-\\mathbf{a}\\cdot (3\\mathbf{b}\\times (-2\\mathbf{c}))=24.$" 13194139543369 17592186576411 true] [17592186106128 1071 "Find $b\\cdot (c\\times a)$, if $-a\\cdot (3b\\times (-2c))=24.$" 13194139543369 17592186576411 false] [17592186106128 1074 "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-\\mathbf{a}\\cdot (3\\mathbf{b}\\times (-2\\mathbf{c})) & =24 \\\\ (-1)\\cdot 3\\cdot (-2)\\cdot [\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c})] & =24 \\\\ \\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =4.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\n\\begin{aligned}\\mathbf{b}\\cdot (\\mathbf{a}\\times \\mathbf{c}) & =-4,\\end{aligned}\n$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}\\mathbf{b}\\cdot (\\mathbf{c}\\times \\mathbf{a}) & =4.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186106128 1074 "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-a\\cdot (3b\\times (-2c)) & =24 \\\\ (-1)\\cdot 3\\cdot (-2)\\cdot [a\\cdot (b\\times c)] & =24 \\\\ a\\cdot (b\\times c) & =4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =-4,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =4.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186106129 1071 "Find $\\mathbf{c}\\cdot (\\mathbf{b}\\times \\mathbf{a})$, if $\\mathbf{b}\\times \\mathbf{c}=⟨2,3,0⟩$ and $\\mathbf{a}=⟨1,-2,2⟩.$" 13194139543369 17592186576411 true] [17592186106129 1071 "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨2,3,0⟩$ and $a=⟨1,-2,2⟩.$" 13194139543369 17592186576411 false] [17592186106129 1074 "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =⟨1,-2,2⟩\\cdot ⟨2,3,0⟩ \\\\  & =1\\cdot 2+(-2)\\cdot 3+2\\cdot 0 \\\\  & =2-6+0 \\\\  & =-4.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}\\mathbf{c}\\cdot (\\mathbf{b}\\times \\mathbf{a}) &=4.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186106129 1074 "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,-2,2⟩\\cdot ⟨2,3,0⟩ \\\\  & =1\\cdot 2+(-2)\\cdot 3+2\\cdot 0 \\\\  & =2-6+0 \\\\  & =-4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=4.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186106130 1071 "Find $\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c})$ given that $\\mathbf{a}=⟨1,0,2⟩$ and $\\mathbf{b}\\times \\mathbf{c}=⟨-2,1,8⟩.$" 13194139543369 17592186576411 true] [17592186106130 1071 "Find $a\\cdot (b\\times c)$ given that $a=⟨1,0,2⟩$ and $b\\times c=⟨-2,1,8⟩.$" 13194139543369 17592186576411 false] [17592186106130 1074 "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =⟨1,0,2⟩\\cdot ⟨-2,1,8⟩ \\\\  & =1\\cdot (-2)+0\\cdot 1+2\\cdot 8 \\\\  & =14.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186106130 1074 "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,0,2⟩\\cdot ⟨-2,1,8⟩ \\\\  & =1\\cdot (-2)+0\\cdot 1+2\\cdot 8 \\\\  & =14.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186106131 1071 "Given that $\\mathbf{a}=⟨0,-2,3⟩,$ $\\mathbf{b}=⟨4,-2,1⟩,$ and $\\mathbf{c}=⟨3,-1,2⟩,$ find $\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c})$ using the definition of the scalar triple product." 13194139543369 17592186576411 true] [17592186106131 1071 "Given that $a=⟨0,-2,3⟩,$ $b=⟨4,-2,1⟩,$ and $c=⟨3,-1,2⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." 13194139543369 17592186576411 false] [17592186106131 1074 "First, we find the cross product:\n\n$$\n\\begin{aligned}\\mathbf{b}\\times \\mathbf{c} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 4 & -2 & 1 \\\\ 3 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ -1 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}4 & 1 \\\\ 3 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}4 & -2 \\\\ 3 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot 2-1\\cdot (-1))\\mathbf{i}-(4\\cdot 2-1\\cdot 3)\\mathbf{j}+(4\\cdot (-1)-(-2)\\cdot 3)\\mathbf{k} \\\\  & =-3\\mathbf{i}-5\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨-3,-5,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =⟨0,-2,3⟩\\cdot ⟨-3,-5,2⟩ \\\\  & =0\\cdot (-3)+(-2)\\cdot (-5)+3\\cdot 2 \\\\  & =16.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186106131 1074 "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =\\begin{vmatrix}i & j & k \\\\ 4 & -2 & 1 \\\\ 3 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ -1 & 2\\end{vmatrix}i-\\begin{vmatrix}4 & 1 \\\\ 3 & 2\\end{vmatrix}j+\\begin{vmatrix}4 & -2 \\\\ 3 & -1\\end{vmatrix}k \\\\  & =((-2)\\cdot 2-1\\cdot (-1))i-(4\\cdot 2-1\\cdot 3)j+(4\\cdot (-1)-(-2)\\cdot 3)k \\\\  & =-3i-5j+2k \\\\  & =⟨-3,-5,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨0,-2,3⟩\\cdot ⟨-3,-5,2⟩ \\\\  & =0\\cdot (-3)+(-2)\\cdot (-5)+3\\cdot 2 \\\\  & =16.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186107074 1064 "The **scalar triple product** of three vectors $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}$ is defined as $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$\n\nFor example, suppose we have three vectors $\\mathbf{a} = \\langle -1,2,1 \\rangle,$ $\\mathbf{b} = \\langle 1,1,-2 \\rangle,$ and $\\mathbf{c} = \\langle 0,3,1 \\rangle.$ Let's compute their scalar triple product, $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$\n\nFirst, we find the cross product:\n\n$$\n\\begin{aligned}\\mathbf{b}\\times \\mathbf{c} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 1 & -2 \\\\ 0 & 3 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -2 \\\\ 3 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & -2 \\\\ 0 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 1 \\\\ 0 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot 1-(-2)\\cdot 3)\\mathbf{i}-(1\\cdot 1-(-2)\\cdot 0)\\mathbf{j}+(1\\cdot 3-1\\cdot 0)\\mathbf{k} \\\\  & =7\\mathbf{i}-\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨7,-1,3⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =⟨-1,2,1⟩\\cdot ⟨7,-1,3⟩ \\\\  & =(-1)\\cdot 7+2\\cdot (-1)+1\\cdot 3 \\\\  & =-6\\end{aligned}\n$$\n\n**Note:** The scalar triple product takes its name from the fact that it multiplies three vectors together and always results in a scalar.\n\nLater, we will learn some geometric intuition behind the scalar triple product. But for now, we will focus on computing the scalar triple product." 13194139543369 17592186576411 true] [17592186107074 1064 "The **scalar triple product** of three vectors $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}$ is defined as $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$\n\nFor example, suppose we have three vectors $\\mathbf{a} = \\langle -1,2,1 \\rangle,$ $\\mathbf{b} = \\langle 1,1,-2 \\rangle,$ and $\\mathbf{c} = \\langle 0,3,1 \\rangle.$ Let's compute their scalar triple product, $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$\n\nFirst, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =\\begin{vmatrix}i & j & k \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & 1 & -2 \\\\ 0 & 3 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -2 \\\\ 3 & 1\\end{vmatrix}i-\\begin{vmatrix}1 & -2 \\\\ 0 & 1\\end{vmatrix}j+\\begin{vmatrix}1 & 1 \\\\ 0 & 3\\end{vmatrix}k \\\\  & =(1\\cdot 1-(-2)\\cdot 3)i-(1\\cdot 1-(-2)\\cdot 0)j+(1\\cdot 3-1\\cdot 0)k \\\\  & =7i-j+3k \\\\  & =⟨7,-1,3⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,2,1⟩\\cdot ⟨7,-1,3⟩ \\\\  & =(-1)\\cdot 7+2\\cdot (-1)+1\\cdot 3 \\\\  & =-6\\end{aligned}\n$$\n\n**Note:** The scalar triple product takes its name from the fact that it multiplies three vectors together and always results in a scalar.\n\nLater, we will learn some geometric intuition behind the scalar triple product. But for now, we will focus on computing the scalar triple product." 13194139543369 17592186576411 false] [17592186107075 1064 "It turns out that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nThat is to say, if $\\mathbf{a} = \\langle a_1,a_2,a_3 \\rangle,$ $\\mathbf{b} = \\langle b_1,b_2,b_3 \\rangle,$ and $\\mathbf{c} = \\langle c_1,c_2,c_3 \\rangle,$ then\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c})=\\begin{vmatrix}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix}.\\end{aligned}\n$$\n\nA proof of this result will be given at the end of the lesson. But for now, let's focus on computing the scalar triple product using the determinant above." 13194139543369 17592186576411 true] [17592186107075 1064 "It turns out that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nThat is to say, if $\\mathbf{a} = \\langle a_1,a_2,a_3 \\rangle,$ $\\mathbf{b} = \\langle b_1,b_2,b_3 \\rangle,$ and $\\mathbf{c} = \\langle c_1,c_2,c_3 \\rangle,$ then\n\n$$\n\\begin{aligned}a\\cdot (b\\times c)=\\begin{vmatrix}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix}.\\end{aligned}\n$$\n\nA proof of this result will be given at the end of the lesson. But for now, let's focus on computing the scalar triple product using the determinant above." 13194139543369 17592186576411 false] [17592186107076 1064 "The scalar triple product has two important properties.\n\nFirst, scalars can be factored out of the product. For example,\n\n$$\n({\\color{red}2}\\mathbf{a}) \\cdot (\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot ({\\color{red}2}\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot (\\mathbf{b} \\times {\\color{red}2}\\mathbf{c}) = {\\color{red}2}\\left[ \\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})\\right].\n$$\n\nSecond, if we swap exactly two vectors in the scalar triple product, the result changes sign. For example, swapping $\\mathbf{a}$ and $\\mathbf{b},$ we have\n\n$$\n{\\color{red}\\mathbf{a}} \\cdot ( {\\color{blue}\\mathbf{b}} \\times \\mathbf{c}) = - {\\color{blue}\\mathbf{b}} \\cdot ( {\\color{red}\\mathbf{a}} \\times \\mathbf{c}).\n$$\n\nNote that if we swap twice, then the result remains the same, because the negatives cancel out. For example, swapping $\\color{red}\\mathbf{a}$ and $\\color{blue}\\mathbf{b}$ and then swapping $\\color{red}\\mathbf{a}$ and $\\mathbf{c},$ we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =-b\\cdot (a\\times c) \\\\  & =-(-b\\cdot (c\\times a)) \\\\  & =b\\cdot (c\\times a).\\end{aligned}\n$$\n\nThese properties arise naturally from the fact that the scalar triple product can be computed as a determinant.\n\n1\\. If we multiply a row of the matrix by a number, then the determinant is multiplied by that number:\n  $$\n{\\left| \\begin{array}{ccc}{\\color{red}2} {a}_{1} & {\\color{red}2} {a}_{2} & {\\color{red}2} {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|} = {\\color{red}2} {\\left| \\begin{array}{ccc}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|}\n$$\n\n2\\. If we swap two rows, then the determinant changes sign:\n  $$\n{\\left| \\begin{array}{ccc}{\\color{red}{a}_{1}} & {\\color{red}{a}_{2}} & {\\color{red}{a}_{3}} \\\\ {\\color{blue}{b}_{1}} & {\\color{blue}{b}_{2}} & {\\color{blue}{b}_{3}} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|} = -  {\\left| \\begin{array}{ccc}{\\color{blue}{b}_{1}} & {\\color{blue}{b}_{2}} & {\\color{blue}{b}_{3}} \\\\ {\\color{red}{a}_{1}} & {\\color{red}{a}_{2}} & {\\color{red}{a}_{3}} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|}\n$$" 13194139543369 17592186576411 false] [17592186107076 1064 "The scalar triple product has two important properties.\n\nFirst, scalars can be factored out of the product. For example,\n\n$$\n({\\color{red}2}\\mathbf{a}) \\cdot (\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot ({\\color{red}2}\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot (\\mathbf{b} \\times {\\color{red}2}\\mathbf{c}) = {\\color{red}2}\\left[ \\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})\\right].\n$$\n\nSecond, if we swap exactly two vectors in the scalar triple product, the result changes sign. For example, swapping $\\mathbf{a}$ and $\\mathbf{b},$ we have\n\n$$\n{\\color{red}\\mathbf{a}} \\cdot ( {\\color{blue}\\mathbf{b}} \\times \\mathbf{c}) = - {\\color{blue}\\mathbf{b}} \\cdot ( {\\color{red}\\mathbf{a}} \\times \\mathbf{c}).\n$$\n\nNote that if we swap twice, then the result remains the same, because the negatives cancel out. For example, swapping $\\color{red}\\mathbf{a}$ and $\\color{blue}\\mathbf{b}$ and then swapping $\\color{red}\\mathbf{a}$ and $\\mathbf{c},$ we get\n\n$$\n\\begin{aligned}{\\color{red}\\mathbf{a}}\\cdot ({\\color{blue}\\mathbf{b}}\\times \\mathbf{c}) & =-{\\color{blue}\\mathbf{b}}\\cdot ({\\color{red}\\mathbf{a}}\\times \\mathbf{c}) \\\\  & =-(-{\\color{blue}\\mathbf{b}}\\cdot (\\mathbf{c}\\times {\\color{red}\\mathbf{a}})) \\\\  & ={\\color{blue}\\mathbf{b}}\\cdot (\\mathbf{c}\\times {\\color{red}\\mathbf{a}}).\\end{aligned}\n$$\n\nThese properties arise naturally from the fact that the scalar triple product can be computed as a determinant.\n\n1\\. If we multiply a row of the matrix by a number, then the determinant is multiplied by that number:\n  $$\n{\\left| \\begin{array}{ccc}{\\color{red}2} {a}_{1} & {\\color{red}2} {a}_{2} & {\\color{red}2} {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|} = {\\color{red}2} {\\left| \\begin{array}{ccc}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|}\n$$\n\n2\\. If we swap two rows, then the determinant changes sign:\n  $$\n{\\left| \\begin{array}{ccc}{\\color{red}{a}_{1}} & {\\color{red}{a}_{2}} & {\\color{red}{a}_{3}} \\\\ {\\color{blue}{b}_{1}} & {\\color{blue}{b}_{2}} & {\\color{blue}{b}_{3}} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|} = -  {\\left| \\begin{array}{ccc}{\\color{blue}{b}_{1}} & {\\color{blue}{b}_{2}} & {\\color{blue}{b}_{3}} \\\\ {\\color{red}{a}_{1}} & {\\color{red}{a}_{2}} & {\\color{red}{a}_{3}} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{array} \\right|}\n$$" 13194139543369 17592186576411 true] [17592186107077 1064 "We have been using the fact for three vectors $\\mathbf{a} = \\langle a_1,a_2,a_3 \\rangle,$ $\\mathbf{b} = \\langle b_1,b_2,b_3 \\rangle,$ and $\\mathbf{c} = \\langle c_1,c_2,c_3 \\rangle,$ the scalar triple product can be computed as\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c})=\\begin{vmatrix}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix}.\\end{aligned}\n$$\n\nBut why is this true? To understand where this result comes from, first notice that in the formula for the triple product, the cross product can be expressed as follows:\n\n$$\n\\begin{aligned}\\mathbf{b}\\times \\mathbf{c} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{vmatrix}\\mathbf{k}\\end{aligned}\n$$\n\nNow, when we take the dot product with $\\mathbf{a},$ we get an expression that is just the cofactor expansion across the first row of the matrix:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =({a}_{1}\\mathbf{i}+{a}_{2}\\mathbf{j}+{a}_{3}\\mathbf{k})\\cdot (\\begin{vmatrix}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{vmatrix}\\mathbf{k}) \\\\  & ={a}_{1}\\begin{vmatrix}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{vmatrix}-{a}_{2}\\begin{vmatrix}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{vmatrix}+{a}_{3}\\begin{vmatrix}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix}\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186107077 1064 "We have been using the fact for three vectors $\\mathbf{a} = \\langle a_1,a_2,a_3 \\rangle,$ $\\mathbf{b} = \\langle b_1,b_2,b_3 \\rangle,$ and $\\mathbf{c} = \\langle c_1,c_2,c_3 \\rangle,$ the scalar triple product can be computed as\n\n$$\n\\begin{aligned}a\\cdot (b\\times c)=\\begin{vmatrix}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix}.\\end{aligned}\n$$\n\nBut why is this true? To understand where this result comes from, first notice that in the formula for the triple product, the cross product can be expressed as follows:\n\n$$\n\\begin{aligned}b\\times c & =\\begin{vmatrix}i & j & k \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{vmatrix}i-\\begin{vmatrix}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{vmatrix}j+\\begin{vmatrix}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{vmatrix}k\\end{aligned}\n$$\n\nNow, when we take the dot product with $\\mathbf{a},$ we get an expression that is just the cofactor expansion across the first row of the matrix:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =({a}_{1}i+{a}_{2}j+{a}_{3}k)\\cdot (\\begin{vmatrix}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{vmatrix}i-\\begin{vmatrix}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{vmatrix}j+\\begin{vmatrix}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{vmatrix}k) \\\\  & ={a}_{1}\\begin{vmatrix}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{vmatrix}-{a}_{2}\\begin{vmatrix}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{vmatrix}+{a}_{3}\\begin{vmatrix}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{vmatrix}\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186117771 1078 #edb/ref 17592186117773 13194139543369 17592186576411 true] [17592186117783 1078 #edb/ref 17592186117788 13194139543369 17592186576411 true] [17592186120272 1068 #edb/ref 17592186117771 13194139543369 17592186576411 false] [17592186120272 1071 "![](images/d1/d162245ac19c3ef9ae63d602fb4e188ddfd241a1a604304f6c272c3902ce1e93.png)\n\nWhich integral expression gives the arc length of the curve $\\mathbf{g}(t)=⟨\\operatorname{sin}2t,\\hspace{0.222em}\\operatorname{cos}3t⟩$ from $t=0$ to $t=\\pi ?$" 13194139543369 17592186576411 true] [17592186120272 1071 "![](images/d1/d162245ac19c3ef9ae63d602fb4e188ddfd241a1a604304f6c272c3902ce1e93.png)\n\nWhich integral expression gives the arc length of the curve $g(t)=⟨\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡3t⟩$ from $t=0$ to $t=\\pi ?$" 13194139543369 17592186576411 false] [17592186120272 1074 "First, we find ${\\mathbf{g}}^{'}(t)$ and $‖{\\mathbf{g}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{g}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}2t),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}3t)⟩ \\\\  & =⟨2\\operatorname{cos}2t,\\hspace{0.222em}-3\\operatorname{sin}3t⟩ \\\\ ‖{\\mathbf{g}}^{'}(t)‖ & =\\sqrt{(2\\operatorname{cos}2t)^{2}+(-3\\operatorname{sin}3t)^{2}} \\\\  & =\\sqrt{4{\\operatorname{cos}}^{2}2t+9{\\operatorname{sin}}^{2}3t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi }‖{\\mathbf{g}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{\\operatorname{cos}}^{2}2t+9{\