{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivatives of ${\\mathbf{r}}_{1}(t)$ and ${\\mathbf{r}}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\hspace{1em} & {\\mathbf{r}}_{1}^{'}(t)=4{t}^{3}\\hspace{0.222em}\\mathbf{i}+3{t}^{2}\\hspace{0.222em}\\mathbf{j} \\\\ {C}_{2}:\\hspace{1em} & {\\mathbf{r}}_{2}^{'}(t)=-\\mathbf{j}\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={∮}_{{C}_{1}\\cup {C}_{2}}y\\,dx \\\\  & ={∮}_{{C}_{1}}y\\,dx+{∮}_{{C}_{2}}y\\,dx \\\\  & ={\\int }_{-1}^{1}{t}^{3}\\cdot 4{t}^{3}\\,\\text{d}t+{\\int }_{-1}^{1}(-t)\\cdot 0\\,\\text{d}t \\\\  & =4{\\int }_{-1}^{1}{t}^{6}\\,\\text{d}t-0 \\\\  & =4[\\frac{{t}^{7}}{7}]_{-1}^{1} \\\\  & =4\\cdot \\frac{2}{7} \\\\  & =\\frac{8}{7}.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186561027 1074 "First, let $P(x,y)=-y$ and $Q(x,y)=0.$ \n\nOur simple, piecewise-smooth, closed path $C$ is negatively oriented, and   \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivatives of ${r}_{1}(t)$ and ${r}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=4{t}^{3}\\,i+3{t}^{2}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=-j\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={∮}_{{C}_{1}\\cup {C}_{2}}y\\,dx \\\\  & ={∮}_{{C}_{1}}y\\,dx+{∮}_{{C}_{2}}y\\,dx \\\\  & ={\\int }_{-1}^{1}{t}^{3}\\cdot 4{t}^{3}\\,\\text{d}t+{\\int }_{-1}^{1}(-t)\\cdot 0\\,\\text{d}t \\\\  & =4{\\int }_{-1}^{1}{t}^{6}\\,\\text{d}t-0 \\\\  & =4[\\frac{{t}^{7}}{7}]_{-1}^{1} \\\\  & =4\\cdot \\frac{2}{7} \\\\  & =\\frac{8}{7}.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186561062 1071 "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)={e}^{y}$ and $Q(x,y)={e}^{x}$\n\nII. $P(x,y)=\\operatorname{arctan}⁡y$ and $Q(x,y)=y$\n\nIII. $P(x,y)=-y$ and $Q(x,y)=y$" 13194139543369 17592186576411 false] [17592186561062 1071 "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${\\mathbb{R}}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)={e}^{y}$ and $Q(x,y)={e}^{x}$\n\nII. $P(x,y)=\\operatorname{arctan}⁡y$ and $Q(x,y)=y$\n\nIII. $P(x,y)=-y$ and $Q(x,y)=y$" 13194139543369 17592186576411 true] [17592186561063 1071 "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)=y$ and $Q(x,y)=x$\n\nII. $P(x,y)=-y$ and $Q(x,y)=0$\n\nIII. $P(x,y)=y+{e}^{x}$ and $Q(x,y)=\\frac{y}{3}$" 13194139543369 17592186576411 false] [17592186561063 1071 "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${\\mathbb{R}}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)=y$ and $Q(x,y)=x$\n\nII. $P(x,y)=-y$ and $Q(x,y)=0$\n\nIII. $P(x,y)=y+{e}^{x}$ and $Q(x,y)=\\frac{y}{3}$" 13194139543369 17592186576411 true] [17592186565439 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/2f/2f36451290eda3db5221e1a5fdbc1647bbedafa97cd47e22d5523d457c4cb83e.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,-2)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{{x}^{2}+{y}^{2}}=r.$\n\nWith that in mind, let's now write the ${x}^{2}+(y+2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2} & =4 \\\\ (r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta +2)^{2} & =4 \\\\ {r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta +4r\\operatorname{sin}\\theta +4 & =4 \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )+4r\\operatorname{sin}\\theta  & =0 \\\\ {r}^{2}+4r\\operatorname{sin}\\theta  & =0 \\\\ r(r+4\\operatorname{sin}\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-4\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -4\\operatorname{sin}⁡\\theta ,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,0\\le z\\le r\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}z({x}^{2}-{y}^{2})\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}z({(r\\operatorname{cos}\\theta )}^{2}-{(r\\operatorname{sin}\\theta )}^{2})\\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}{r}^{3}z({\\operatorname{cos}}^{2}\\theta -{\\operatorname{sin}}^{2}\\theta )\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\pi /2}}}^{2\\pi }{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}-4\\operatorname{sin}\\theta }}}{\\int }_{0}^{r}\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{3}z\\operatorname{cos}2\\theta }}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186565439 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/2f/2f36451290eda3db5221e1a5fdbc1647bbedafa97cd47e22d5523d457c4cb83e.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,-2)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{{x}^{2}+{y}^{2}}=r.$\n\nWith that in mind, let's now write the ${x}^{2}+(y+2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta +2)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +4r\\operatorname{sin}⁡\\theta +4 & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+4\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-4\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -4\\operatorname{sin}⁡\\theta ,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,0\\le z\\le r\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V & ={∭}_{Δ}z({(r\\operatorname{cos}⁡\\theta )}^{2}-{(r\\operatorname{sin}⁡\\theta )}^{2})\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}{r}^{3}z({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186565440 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/35/350b2dc98a09957c17f1ab629e21021c30fcccd9443068c722fe7565f04dcbfe.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+9={r}^{2}+9.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le z\\le {r}^{2}+9\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186565440 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/35/350b2dc98a09957c17f1ab629e21021c30fcccd9443068c722fe7565f04dcbfe.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+9={r}^{2}+9.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le z\\le {r}^{2}+9\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}\\frac{1}{\\sqrt{(r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2}+1}}\\cdot r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}\\frac{r}{\\sqrt{{r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta +1}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={∭}_{\\mathrm{Δ}}\\frac{r}{\\sqrt{{r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )+1}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{\\bbox[Gainsboro, 2pt]{{\\color{blue}\\pi }}}^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}+9}}}\\bbox[Gainsboro, 2pt]{{\\color{blue}\\frac{r}{\\sqrt{{r}^{2}+1}}}}\\hspace{0.222em}\\mathrm{d}z\\hspace{0.222em}\\text{d}r\\hspace{0.222em}\\text{d}\\theta .\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186573262 1071 "If $\\mathbf{a}=3\\mathbf{i}-5\\mathbf{j}$ and $\\mathbf{b}=-4\\mathbf{i}+7\\mathbf{j},$ then $\\mathbf{a}-\\mathbf{b}=${{field-1}} $\\mathbf{i}\\hspace{0.167em}\\hspace{0.167em}-$\n{{field-2}} $\\mathbf{j}.$" 13194139543369 17592186576411 true] [17592186573262 1071 "If $a=3i-5j$ and $b=-4i+7j,$ then $a-b=${{field-1}} $i\\,\\,-$\n{{field-2}} $j.$" 13194139543369 17592186576411 false] [17592186573262 1074 "To compute $\\mathbf{a}-\\mathbf{b},$ we just need to compute all of the $\\mathbf{i}$'s and $\\mathbf{j}$'s, as follows:\n\n$$\n\\begin{aligned}\\mathbf{a}-\\mathbf{b} & =(3\\mathbf{i}-5\\mathbf{j})-(-4\\mathbf{i}+7\\mathbf{j}) \\\\  & =3\\mathbf{i}-5\\mathbf{j}+4\\mathbf{i}-7\\mathbf{j} \\\\  & =(3\\mathbf{i}+4\\mathbf{i})+(-5\\mathbf{j}-7\\mathbf{j}) \\\\  & =7\\mathbf{i}-12\\mathbf{j}\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186573262 1074 "To compute $a-b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}a-b & =(3i-5j)-(-4i+7j) \\\\  & =3i-5j+4i-7j \\\\  & =(3i+4i)+(-5j-7j) \\\\  & =7i-12j\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186573264 1071 "If $\\mathbf{a}=⟨2,-1⟩$ and $\\mathbf{b}=⟨-1,2⟩$, then $\\mathbf{a}-\\mathbf{b}=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" 13194139543369 17592186576411 true] [17592186573264 1071 "If $a=⟨2,-1⟩$ and $b=⟨-1,2⟩$, then $a-b=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" 13194139543369 17592186576411 false] [17592186573264 1074 "To compute $\\mathbf{a}-\\mathbf{b},$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\mathbf{a}-\\mathbf{b} & =⟨2,-1⟩-⟨-1,2⟩ \\\\  & =⟨2-(-1),-1-2⟩ \\\\  & =⟨3,-3⟩\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186573264 1074 "To compute $a-b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-b & =⟨2,-1⟩-⟨-1,2⟩ \\\\  & =⟨2-(-1),-1-2⟩ \\\\  & =⟨3,-3⟩\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186573275 1071 "Let $\\mathbf{a}=\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}$, $\\mathbf{b}=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}$ and $\\mathbf{c}=\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}.$ Find $2\\mathbf{b}+(-3\\mathbf{a}+\\mathbf{c}).$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$2\\mathbf{b}+(-3\\mathbf{a}+\\mathbf{c})=\\hspace{0.167em}\\hspace{0.167em}=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" 13194139543369 17592186576411 true] [17592186573275 1071 "Let $a=\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}$, $b=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}$ and $c=\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}.$ Find $2b+(-3a+c).$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$2b+(-3a+c)=\\,\\,$</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n</tbody></table>" 13194139543369 17592186576411 false] [17592186573275 1074 "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2\\mathbf{b}+(-3\\mathbf{a}+\\mathbf{c}) & =2\\hspace{-0.167em}\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}+(-3\\hspace{-0.167em}\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+(\\begin{bmatrix}12 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+\\begin{bmatrix}10 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186573275 1074 "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2b+(-3a+c) & =2\\,\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}+(-3\\,\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+(\\begin{bmatrix}12 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+\\begin{bmatrix}10 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186573294 1071 "Let $\\mathbf{u}=⟨7,4⟩$ and $\\mathbf{v}=⟨9,11⟩.$ Find $-2\\mathbf{u}+\\mathbf{v}.$" 13194139543369 17592186576411 true] [17592186573294 1071 "Let $u=⟨7,4⟩$ and $v=⟨9,11⟩.$ Find $-2u+v.$" 13194139543369 17592186576411 false] [17592186573294 1074 "To compute $-2\\mathbf{u}+\\mathbf{v},$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}-2\\mathbf{u}+\\mathbf{v} & =-2\\cdot ⟨7,4⟩+⟨9,11⟩ \\\\  & =⟨-14,-8⟩+⟨9,11⟩ \\\\  & =⟨-5,3⟩\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186573294 1074 "To compute $-2u+v,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}-2u+v & =-2\\cdot ⟨7,4⟩+⟨9,11⟩ \\\\  & =⟨-14,-8⟩+⟨9,11⟩ \\\\  & =⟨-5,3⟩\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186573298 1071 "If $\\mathbf{a}=5\\mathbf{i}-3\\mathbf{j}$ and $\\mathbf{b}=-\\mathbf{i}+5\\mathbf{j},$ then $\\mathbf{a}+\\mathbf{b}=${{field-1}}$\\mathbf{i}\\hspace{0.167em}\\hspace{0.167em}+$\n{{field-2}}$\\mathbf{j}.$" 13194139543369 17592186576411 true] [17592186573298 1071 "If $a=5i-3j$ and $b=-i+5j,$ then $a+b=${{field-1}}$i\\,\\,+$\n{{field-2}}$j.$" 13194139543369 17592186576411 false] [17592186573298 1074 "To compute $\\mathbf{a}+\\mathbf{b},$ we just need to compute all of the $\\mathbf{i}$'s and $\\mathbf{j}$'s, as follows:\n\n$$\n\\begin{aligned}\\mathbf{a}+\\mathbf{b} & =(5\\mathbf{i}-3\\mathbf{j})+(-\\mathbf{i}+5\\mathbf{j}) \\\\  & =5\\mathbf{i}-3\\mathbf{j}-\\mathbf{i}+5\\mathbf{j} \\\\  & =(5\\mathbf{i}-\\mathbf{i})+(-3\\mathbf{j}+5\\mathbf{j}) \\\\  & =4\\mathbf{i}+2\\mathbf{j}\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186573298 1074 "To compute $a+b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}a+b & =(5i-3j)+(-i+5j) \\\\  & =5i-3j-i+5j \\\\  & =(5i-i)+(-3j+5j) \\\\  & =4i+2j\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186573312 1071 "Let $\\mathbf{a}=\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}$, $\\mathbf{b}=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}$ and $\\mathbf{c}=\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}.$ Find $\\hspace{0.167em}4\\mathbf{a}-(3\\mathbf{b}-2\\mathbf{c}).$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$4\\mathbf{a}-(3\\mathbf{b}-2\\mathbf{c})=\\hspace{0.167em}\\hspace{0.167em}=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" 13194139543369 17592186576411 true] [17592186573312 1071 "Let $a=\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}$, $b=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}$ and $c=\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}.$ Find $\\,4a-(3b-2c).$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$4a-(3b-2c)=\\,\\,$</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n</tbody></table>" 13194139543369 17592186576411 false] [17592186573312 1074 "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}4\\mathbf{a}-(3\\mathbf{b}-2\\mathbf{c}) & =4\\hspace{-0.167em}\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}-(3\\hspace{-0.167em}\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}-2\\hspace{-0.167em}\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 12\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}8 \\\\ -24\\end{bmatrix} \\\\  & =\\begin{bmatrix}-28 \\\\ 36\\end{bmatrix}.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186573312 1074 "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}4a-(3b-2c) & =4\\,\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}-(3\\,\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}-2\\,\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 12\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}8 \\\\ -24\\end{bmatrix} \\\\  & =\\begin{bmatrix}-28 \\\\ 36\\end{bmatrix}.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186573319 1071 "If $\\mathbf{a}=⟨-4,6⟩$ and $\\mathbf{b}=⟨3,-5⟩$, then $\\mathbf{a}-\\mathbf{b}=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" 13194139543369 17592186576411 true] [17592186573319 1071 "If $a=⟨-4,6⟩$ and $b=⟨3,-5⟩$, then $a-b=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" 13194139543369 17592186576411 false] [17592186578877 1071 "For the parametric curve \n\n$$\nx={\\operatorname{sec}}^{2}t,\\hspace{1em}y={\\operatorname{csc}}^{3}t,\\hspace{2em}0<t<\\frac{\\pi }{2},\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{4}.$" 13194139543369 17592186576411 true] [17592186578877 1071 "For the parametric curve \n\n$$\nx={sec}^{2}⁡t,\\,y={csc}^{3}⁡t,\\,0<t<\\frac{\\pi }{2},\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{4}.$" 13194139543369 17592186576411 false] [17592186585088 1074 "Since $\\sqrt[6]{x}={x}^{1/6}$, we can apply the power rule with $n=\\frac{1}{6}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/6}\\,\\text{d}x & =\\frac{{x}^{1/6+1}}{(\\frac{1}{6}+1)}+C \\\\  & =\\frac{{x}^{7/6}}{\\left(\\frac{7}{6}\\right)}+C \\\\  & =\\frac{6{x}^{7/6}}{7}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{7/6}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{6{x}^{7/6}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{6}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/6})+0 \\\\ &= \\frac{6}{7}\\cdot \\frac{7}{6}{x}^{7/6-1} \\\\ &= {x}^{1/6}\\,✓\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186585088 1074 "Since $\\sqrt[6]{x}={x}^{1/6}$, we can apply the power rule with $n=\\frac{1}{6}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/6}\\,\\text{d}x & =\\frac{{x}^{1/6+1}}{(\\frac{1}{6}+1)}+C \\\\  & =\\frac{{x}^{7/6}}{\\left(\\frac{7}{6}\\right)}+C \\\\  & =\\frac{6{x}^{7/6}}{7}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{7/6}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{6{x}^{7/6}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{6}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/6})+0 \\\\ &= \\frac{6}{7}\\cdot \\frac{7}{6}{x}^{7/6-1} \\\\ &= {x}^{1/6}\\hspace{1em}{\\color{green}✓}\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186587304 1074 "Since $\\sqrt[4]{x}={x}^{1/4}$, we can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating: \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{5/4}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 \\\\ &= \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} \\\\ &= {x}^{1/4}\\,✓\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186587304 1074 "Since $\\sqrt[4]{x}={x}^{1/4}$, we can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating: \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{5/4}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 \\\\ &= \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} \\\\ &= {x}^{1/4}\\hspace{1em}{\\color{green}✓}\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186592302 1074 "First, we rewrite the second term using the definition of $\\operatorname{tan}⁡x.$ This gives:\n\n$$\n\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\n$$\n\nNext, we put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}x}{1+\\operatorname{sin}x}+\\frac{\\operatorname{sin}x}{\\operatorname{cos}x} & =\\frac{\\operatorname{cos}x\\cdot \\operatorname{cos}x}{\\operatorname{cos}x(1+\\operatorname{sin}x)}+\\frac{\\operatorname{sin}x\\cdot (1+\\operatorname{sin}x)}{\\operatorname{cos}x(1+\\operatorname{sin}x)} \\\\  & =\\frac{{\\operatorname{cos}}^{2}x+\\operatorname{sin}x(1+\\operatorname{sin}x)}{\\operatorname{cos}x(1+\\operatorname{sin}x)}\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{\\operatorname{cos}}^{2}x+\\operatorname{sin}x(1+\\operatorname{sin}x)}{\\operatorname{cos}x(1+\\operatorname{sin}x)} & =\\frac{{\\operatorname{cos}}^{2}x+\\operatorname{sin}x+{\\operatorname{sin}}^{2}x}{\\operatorname{cos}x(1+\\operatorname{sin}x)} \\\\  & =\\frac{\\operatorname{sin}x+({\\operatorname{cos}}^{2}x+{\\operatorname{sin}}^{2}x)}{\\operatorname{cos}x(1+\\operatorname{sin}x)} \\\\  & =\\frac{\\operatorname{sin}x+1}{\\operatorname{cos}x(1+\\operatorname{sin}x)} \\\\  & =\\frac{1}{\\operatorname{cos}x} \\\\  & =\\operatorname{sec}x.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\operatorname{sec}⁡x.\n$$" 13194139543369 17592186576411 true] [17592186592302 1074 "First, we rewrite the second term using the definition of $\\operatorname{tan}⁡x.$ This gives:\n\n$$\n\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\n$$\n\nNext, we put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x} & =\\frac{\\operatorname{cos}⁡x\\cdot \\operatorname{cos}⁡x}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)}+\\frac{\\operatorname{sin}⁡x\\cdot (1+\\operatorname{sin}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)}\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x+{sin}^{2}⁡x}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{\\operatorname{sin}⁡x+({cos}^{2}⁡x+{sin}^{2}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{\\operatorname{sin}⁡x+1}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\operatorname{sec}⁡x.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\operatorname{sec}⁡x.\n$$" 13194139543369 17592186576411 false] [17592186593223 1071 "$$\n\\displaystyle {cos}^{2}⁡x(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{1}{\\operatorname{cos}⁡x}+1)=\n$$" 13194139543369 17592186576411 false] [17592186593223 1071 "$$\n{\\operatorname{cos}}^{2}x(\\frac{{\\operatorname{sin}}^{2}x}{{\\operatorname{cos}}^{2}x}+\\frac{1}{\\operatorname{cos}x}+1)=\n$$" 13194139543369 17592186576411 true] [17592186593223 1074 "First, we expand the parentheses:\n\n$$\n\\begin{aligned}{\\operatorname{cos}}^{2}x(\\frac{{\\operatorname{sin}}^{2}x}{{\\operatorname{cos}}^{2}x}+\\frac{1}{\\operatorname{cos}x}+1) & ={\\operatorname{cos}}^{2}x\\cdot \\frac{{\\operatorname{sin}}^{2}x}{{\\operatorname{cos}}^{2}x}+{\\operatorname{cos}}^{2}x\\cdot \\frac{1}{\\operatorname{cos}x}+{\\operatorname{cos}}^{2}x \\\\  & =\\frac{{\\operatorname{cos}}^{2}x{\\operatorname{sin}}^{2}x}{{\\operatorname{cos}}^{2}x}+\\frac{{\\operatorname{cos}}^{2}x}{\\operatorname{cos}x}+{\\operatorname{cos}}^{2}x \\\\  & =\\frac{\\enclose{updiagonalstrike}{{\\operatorname{cos}}^{2}x}{\\operatorname{sin}}^{2}x}{\\enclose{updiagonalstrike}{{\\operatorname{cos}}^{2}x}}+\\frac{\\enclose{updiagonalstrike}{\\operatorname{cos}x}\\operatorname{cos}x}{\\enclose{updiagonalstrike}{\\operatorname{cos}x}}+{\\operatorname{cos}}^{2}x \\\\  & ={\\operatorname{sin}}^{2}x+\\operatorname{cos}x+{\\operatorname{cos}}^{2}x \\\\  & =({\\operatorname{sin}}^{2}x+{\\operatorname{cos}}^{2}x)+\\operatorname{cos}x \\\\  & =1+\\operatorname{cos}x\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${\\operatorname{cos}}^{2}x+{\\operatorname{sin}}^{2}x=1.$ \n\nTherefore, we conclude that\n\n$$\n{\\operatorname{cos}}^{2}x(\\frac{{\\operatorname{sin}}^{2}x}{{\\operatorname{cos}}^{2}x}+\\frac{1}{\\operatorname{cos}x}+1)=1+\\operatorname{cos}x.\n$$" 13194139543369 17592186576411 true] [17592186593223 1074 "First, we expand the parentheses:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{1}{\\operatorname{cos}⁡x}+1) & ={cos}^{2}⁡x\\cdot \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+{cos}^{2}⁡x\\cdot \\frac{1}{\\operatorname{cos}⁡x}+{cos}^{2}⁡x \\\\  & =\\frac{{cos}^{2}⁡x{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{{cos}^{2}⁡x}{\\operatorname{cos}⁡x}+{cos}^{2}⁡x \\\\  & =\\frac{\\cancel{{cos}^{2}⁡x}{sin}^{2}⁡x}{\\cancel{{cos}^{2}⁡x}}+\\frac{\\cancel{\\operatorname{cos}⁡x}\\operatorname{cos}⁡x}{\\cancel{\\operatorname{cos}⁡x}}+{cos}^{2}⁡x \\\\  & ={sin}^{2}⁡x+\\operatorname{cos}⁡x+{cos}^{2}⁡x \\\\  & =({sin}^{2}⁡x+{cos}^{2}⁡x)+\\operatorname{cos}⁡x \\\\  & =1+\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${cos}^{2}⁡x+{sin}^{2}⁡x=1.$ \n\nTherefore, we conclude that\n\n$$\n{cos}^{2}⁡x(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{1}{\\operatorname{cos}⁡x}+1)=1+\\operatorname{cos}⁡x.\n$$" 13194139543369 17592186576411 false] [17592186593227 1071 "Simplify the trigonometric expression $\\frac{2{\\operatorname{cos}}^{4}x+2{\\operatorname{cos}}^{2}x{\\operatorname{sin}}^{2}x-1}{{\\operatorname{sin}}^{2}x}.$" 13194139543369 17592186576411 true] [17592186593227 1071 "Simplify the trigonometric expression $\\frac{2{cos}^{4}⁡x+2{cos}^{2}⁡x{sin}^{2}⁡x-1}{{sin}^{2}⁡x}.$" 13194139543369 17592186576411 false] [17592186593227 1074 "First, we factor $2{\\operatorname{cos}}^{2}x$ from the first two terms:\n\n$$\n\\frac{2{\\operatorname{cos}}^{4}x+2{\\operatorname{cos}}^{2}x{\\operatorname{sin}}^{2}x-1}{{\\operatorname{sin}}^{2}x}=\\frac{2{\\operatorname{cos}}^{2}x({\\operatorname{cos}}^{2}x+{\\operatorname{sin}}^{2}x)-1}{{\\operatorname{sin}}^{2}x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{2{\\operatorname{cos}}^{2}x({\\operatorname{cos}}^{2}x+{\\operatorname{sin}}^{2}x)-1}{{\\operatorname{sin}}^{2}x} & =\\frac{2{\\operatorname{cos}}^{2}x-1}{{\\operatorname{sin}}^{2}x} \\\\  & =\\frac{2{\\operatorname{cos}}^{2}x-({\\operatorname{cos}}^{2}x+{\\operatorname{sin}}^{2}x)}{{\\operatorname{sin}}^{2}x} \\\\  & =\\frac{2{\\operatorname{cos}}^{2}x-{\\operatorname{cos}}^{2}x-{\\operatorname{sin}}^{2}x}{{\\operatorname{sin}}^{2}x} \\\\  & =\\frac{{\\operatorname{cos}}^{2}x-{\\operatorname{sin}}^{2}x}{{\\operatorname{sin}}^{2}x} \\\\  & =\\frac{{\\operatorname{cos}}^{2}x}{{\\operatorname{sin}}^{2}x}-\\frac{{\\operatorname{sin}}^{2}x}{{\\operatorname{sin}}^{2}x} \\\\  & ={\\operatorname{cot}}^{2}x-1\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\frac{2{\\operatorname{cos}}^{4}x+2{\\operatorname{cos}}^{2}x{\\operatorname{sin}}^{2}x-1}{{\\operatorname{sin}}^{2}x}={\\operatorname{cot}}^{2}x-1\n$$" 13194139543369 17592186576411 true] [17592186593227 1074 "First, we factor $2{cos}^{2}⁡x$ from the first two terms:\n\n$$\n\\frac{2{cos}^{4}⁡x+2{cos}^{2}⁡x{sin}^{2}⁡x-1}{{sin}^{2}⁡x}=\\frac{2{cos}^{2}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)-1}{{sin}^{2}⁡x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{2{cos}^{2}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)-1}{{sin}^{2}⁡x} & =\\frac{2{cos}^{2}⁡x-1}{{sin}^{2}⁡x} \\\\  & =\\frac{2{cos}^{2}⁡x-({cos}^{2}⁡x+{sin}^{2}⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{2{cos}^{2}⁡x-{cos}^{2}⁡x-{sin}^{2}⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x}-\\frac{{sin}^{2}⁡x}{{sin}^{2}⁡x} \\\\  & ={cot}^{2}⁡x-1\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\frac{2{cos}^{4}⁡x+2{cos}^{2}⁡x{sin}^{2}⁡x-1}{{sin}^{2}⁡x}={cot}^{2}⁡x-1\n$$" 13194139543369 17592186576411 false] [17592186600830 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/27/27a82956e22b5b2e2de2c02d9d93fb7b7ce57a2b581b88458964eda465e8bebd.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $1$ whose axis passes through the point $(-1,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=x=r\\operatorname{cos}⁡\\theta ,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+1={r}^{2}+1.$\n\nWith that in mind, let's now write the $(x+1)^{2}+{y}^{2}=1$ in polar coordinates:\n\n$$\n\\begin{aligned}(x+1)^{2}+{y}^{2} & =1 \\\\ (r\\operatorname{cos}\\theta +1)^{2}+(r\\operatorname{sin}\\theta )^{2} & =1 \\\\ {r}^{2}{\\operatorname{cos}}^{2}\\theta +2r\\operatorname{cos}\\theta +1+{r}^{2}{\\operatorname{sin}}^{2}\\theta  & =1 \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )+2r\\operatorname{cos}\\theta  & =0 \\\\ {r}^{2}+2r\\operatorname{cos}\\theta  & =0 \\\\ r(r+2\\operatorname{cos}\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-2\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -2\\operatorname{cos}⁡\\theta ,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2},\\,r\\operatorname{cos}⁡\\theta \\le z\\le {r}^{2}+1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}-{y}^{2}\\hspace{0.222em}\\text{d}V & ={∭}_{\\mathrm{Δ}}((r\\operatorname{cos}\\theta )^{2}-(r\\operatorname{sin}\\theta )^{2})\\hspace{0.222em}r\\hspace{0.222em}\\mathrm{d}z\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{\\pi }^{\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\pi /2}}}{\\int }_{0}^{-2\\operatorname{cos}\\theta }{\\int }_{r\\operatorname{cos}\\theta }^{\\bbox[Gainsboro, 2pt]{{\\color{blue}{r}^{2}+1}}}\\bbox[Gainsboro, 2pt]{{\\color