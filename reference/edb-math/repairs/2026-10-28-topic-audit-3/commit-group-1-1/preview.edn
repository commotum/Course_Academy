y}^{'}(t))}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}.\\end{aligned}\n$$\n\nAlso, using $x=t$ and $y=t^2,$ we have\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) &=\\frac{y}{x}=\\frac{{t}^{2}}{t}=t.\\end{aligned}\n$$\n\nTherefore, we can express the line integral in terms of $t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{y}{x}\\hspace{0.167em}\\text{d}s & ={\\int }_{a}^{b}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\hspace{0.167em}\\sqrt{1+4{t}^{2}}\\hspace{0.167em}\\text{d}t\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186153354 1064 "To calculate the line integral of a function $f(x,y)$ along a curve $C,$ we use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ must be parametrized by the vector function $\\mathbf r(t)$ to apply this formula.\n\nNow suppose we want to evaluate the line integral\n\n$$\n\\displaystyle \\int \\limits_{C} \\dfrac{y}{x} \\,\\textrm ds,\n$$\n\nwhere $C$ is the section of the curve $y = x^2$ between the points $(0,0)$ and $(1,1).$\n\n![](images/a8/a8a3fe6c05479258f84aa074398e92a8a849fa4d015feb450aeef6a6066a870e.png)\n\nTo reduce the calculation of the line integral to a parametric case, we must first parametrize the curve.\n\nNotice that the curve $C$ is of the form $y = y(x).$ Therefore, by setting $x=t,$ we have $y = y(t) =  t^2.$ This gives the following parametrization for $C\\mathbin{:}$ \n\n$$\n\\mathbf{r}(t) = \\left\\langle t, t^2 \\right\\rangle, \\qquad 0 \\le t \\le 1.\n$$\n\nComputing $\\| \\mathbf{r}'(t) \\|,$ we get\n\n$$\n\\begin{aligned}‖{r}^{'}(t)‖ & =\\sqrt{{({x}^{'}(t))}^{2}+{({y}^{'}(t))}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}.\\end{aligned}\n$$\n\nAlso, using $x=t$ and $y=t^2,$ we have\n\n$$\n\\begin{aligned}f(r(t))=\\frac{y}{x}=\\frac{{t}^{2}}{t}=t.\\end{aligned}\n$$\n\nTherefore, we can express the line integral in terms of $t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{y}{x}\\,\\text{d}s & ={\\int }_{a}^{b}f(r(t))\\,‖{r}^{'}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\,\\sqrt{1+4{t}^{2}}\\,\\text{d}t\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186155949 1078 #edb/ref 17592186155954 13194139543369 17592186576411 true] [17592186156009 1078 #edb/ref 17592186156011 13194139543369 17592186576411 true] [17592186157616 1074 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents the annulus between the disks of radii $2$ and $3$ centered at the origin. \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=4,$ we obtain $r=2.$\n\n- For ${x}^{2}+{y}^{2}=9,$ we obtain $r=3.$\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta )\\hspace{0.222em}:\\hspace{0.222em}2\\le r\\le 3,\\hspace{0.222em}0\\le \\theta <2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{({x}^{2}+{y}^{2})^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{1}{((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{2}^{3}\\frac{1}{{r}^{4}}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{2}^{3}\\frac{1}{{r}^{3}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[-\\frac{1}{2{r}^{2}}]}_{2}^{3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(\\frac{1}{8}-\\frac{1}{18})\\,\\text{d}\\theta  \\\\  & =\\frac{5}{72}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{5}{72}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{5}{72}\\cdot 2\\pi  \\\\  & =\\frac{5\\pi }{36}.\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186157616 1074 "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents the annulus between the disks of radii $2$ and $3$ centered at the origin. \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=4,$ we obtain $r=2.$\n\n- For ${x}^{2}+{y}^{2}=9,$ we obtain $r=3.$\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,2\\le r\\le 3,\\,0\\le \\theta <2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{({x}^{2}+{y}^{2})^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{1}{((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{2}^{3}\\frac{1}{{r}^{4}}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{2}^{3}\\frac{1}{{r}^{3}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[-\\frac{1}{2{r}^{2}}]}_{2}^{3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(\\frac{1}{8}-\\frac{1}{18})\\,\\text{d}\\theta  \\\\  & =\\frac{5}{72}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{5}{72}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{5}{72}\\cdot 2\\pi  \\\\  & =\\frac{5\\pi }{36}.\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186157838 1074 "The annulus has $1\\le r\\le3$ and $0\\le\\theta\\le2\\pi$. Multiplication by the polar Jacobian gives $(1-r^2)r$, so use\n$$\\int_0^{2\\pi}\\int_1^3r(1-r^2)\\,dr\\,d\\theta.$$" 13194139543369 17592186576411 true] [17592186157848 1068 #edb/ref 17592186156009 13194139543369 17592186576411 false] [17592186157848 1074 "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $1$ and $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\n\\mathrm{Δ}=\\{(r,\\theta )\\hspace{0.222em}:\\hspace{0.222em}1\\le r\\le 2,\\hspace{0.222em}0\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}(x-y)\\,\\text{d}x\\text{d}y & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{1}^{2}r(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{1}^{2}{r}^{2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139543369 17592186576411 true] [17592186157848 1074 "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $1$ and $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,1\\le r\\le 2,\\,0\\le \\theta \\le \\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}(x-y)\\,\\text{d}x\\text{d}y & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{1}^{2}r(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{1}^{2}{r}^{2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139543369 17592186576411 false] [17592186158486 1064 "Suppose we want to compute the double integral \n\n$$\n\\displaystyle \\iint\\limits_{D}{{\\sqrt{x^2 + y^2}\\,\\mathrm d A}},\n$$\n\n \n\nwhere $D$ is a washer enclosed between two circles centered at $(0,0)$ with radii $1$ and $2,$ respectively, as shown below.\n\n![](images/47/4752982aaf806b9e3b9c4d28d7a92bd01c3ff6a68afcca4235061a01b2fbc86f.png)\n\nThe easiest way to solve this problem is to convert it to polar coordinates. Let's define a transformation $\\mathbf T$ as\n\n$$\nx=r\\cos\\theta, \\qquad y = r\\sin\\theta.\n$$\n\nThe preimage of $D$ under the action of $\\mathbf T$ is the rectangular region $\\Delta,$ given by \n\n$$\n\\Delta = \\big\\{ (r,\\theta) \\: : \\: 1 \\leq r \\leq 2, \\: 0 \\leq \\theta \\leq 2\\pi \\big\\}.\n$$\n\nThe region $D$ and its preimage $\\Delta$ are shown below.\n\n![](images/e0/e0cc6c7f92704365c3ce15b91d85f703330b767a01f1f773b014cf61620563a3.png)\n\n             \n\nThe change of variables formula for polar coordinates states \n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,dA & ={∬}_{Δ}\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,r\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}\\sqrt{{r}^{2}}\\cdot r\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{2}\\,dr\\,d\\theta .\\end{aligned}\n$$\n\nEvaluating this integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{2}\\,dr\\,d\\theta  & ={\\int }_{0}^{2\\pi }d\\theta {\\int }_{0}^{2}{r}^{2}\\,dr \\\\  & =2\\pi {\\int }_{1}^{2}{r}^{2}\\,dr \\\\  & =2\\pi \\cdot {[\\frac{1}{3}{r}^{3}]}_{1}^{2} \\\\  & =\\frac{2}{3}\\pi \\cdot [{2}^{3}-{1}^{3}] \\\\  & =\\frac{2}{3}\\pi \\cdot 7 \\\\  & =\\frac{14\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\iint\\limits_{D}{{\\sqrt{x^2 + y^2}\\,\\mathrm d A}} = \\dfrac{14\\pi}{3}.\n$$" 13194139543369 17592186576411 false] [17592186158486 1064 "Suppose we want to compute the double integral \n\n$$\n\\displaystyle \\iint\\limits_{D}{{\\sqrt{x^2 + y^2}\\,\\mathrm d A}},\n$$\n\n \n\nwhere $D$ is a washer enclosed between two circles centered at $(0,0)$ with radii $1$ and $2,$ respectively, as shown below.\n\n![](images/47/4752982aaf806b9e3b9c4d28d7a92bd01c3ff6a68afcca4235061a01b2fbc86f.png)\n\nThe easiest way to solve this problem is to convert it to polar coordinates. Let's define a transformation $\\mathbf T$ as\n\n$$\nx=r\\cos\\theta, \\qquad y = r\\sin\\theta.\n$$\n\nThe preimage of $D$ under the action of $\\mathbf T$ is the rectangular region $\\Delta,$ given by \n\n$$\n\\Delta = \\big\\{ (r,\\theta) \\: : \\: 1 \\leq r \\leq 2, \\: 0 \\leq \\theta \\leq 2\\pi \\big\\}.\n$$\n\nThe region $D$ and its preimage $\\Delta$ are shown below.\n\n![](images/e0/e0cc6c7f92704365c3ce15b91d85f703330b767a01f1f773b014cf61620563a3.png)\n\n             \n\nThe change of variables formula for polar coordinates states \n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\hspace{0.167em}\\mathrm{d}A & ={∬}_{\\mathrm{Δ}}\\sqrt{(r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta )^{2}}\\hspace{0.222em}r\\hspace{0.167em}\\text{d}r\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}\\sqrt{{r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )}\\hspace{0.222em}r\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}\\sqrt{{r}^{2}}\\cdot r\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{2}\\hspace{0.167em}\\mathrm{d}r\\hspace{0.167em}\\mathrm{d}\\theta .\\end{aligned}\n$$\n\nEvaluating this integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{2}\\,dr\\,d\\theta  & ={\\int }_{0}^{2\\pi }d\\theta {\\int }_{0}^{2}{r}^{2}\\,dr \\\\  & =2\\pi {\\int }_{1}^{2}{r}^{2}\\,dr \\\\  & =2\\pi \\cdot {[\\frac{1}{3}{r}^{3}]}_{1}^{2} \\\\  & =\\frac{2}{3}\\pi \\cdot [{2}^{3}-{1}^{3}] \\\\  & =\\frac{2}{3}\\pi \\cdot 7 \\\\  & =\\frac{14\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\iint\\limits_{D}{{\\sqrt{x^2 + y^2}\\,\\mathrm d A}} = \\dfrac{14\\pi}{3}.\n$$" 13194139543369 17592186576411 true] [17592186158487 1064 "Let's get some more practice at expressing regions in polar coordinates. \n\nConsider the region enclosed by the curve $x^2+(y-2)^2=4$ and the line $y=2,$ as shown below.\n\n![](images/df/dffcd94cc96c33d173704a63cb03fb0f0098bc67d6c66a855c16f59694bde8e1.png)\n\nThis region represents a portion of the disk of radius $2$ centered at $(0,2).$\n\nFirst, we recall the usual transformations from polar to Cartesian coordinates:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nLet's now use the above formulas to write the functions that bound our region in polar coordinates:\n\n- For $x^2+(y-2)^2 = 4,$  we obtain \n\n$$\n\\begin{aligned}{x}^{2}+(y-2)^{2} & =4 \\\\ (r\\operatorname{cos}\\theta )^{2}+(r\\operatorname{sin}\\theta -2)^{2} & =4 \\\\ ({r}^{2}{\\operatorname{cos}}^{2}\\theta +{r}^{2}{\\operatorname{sin}}^{2}\\theta -4r\\operatorname{sin}\\theta +4 & =4 \\\\ {r}^{2}({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )-4r\\operatorname{sin}\\theta  & =0 \\\\ {r}^{2}-4r\\operatorname{sin}\\theta  & =0 \\\\ r(r-4\\operatorname{sin}\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r = 4\\sin\\theta.$\n\n- For $y=2,$ we get\n\n$$\n\\begin{aligned}y & =2 \\\\ r\\operatorname{sin}⁡\\theta  & =2 \\\\ r & =\\frac{2}{\\operatorname{sin}⁡\\theta } \\\\ r & =2\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's determine the limits for $r$ and $\\theta.$ \n\nFirst of all, note that if we draw an arrow through the region from the origin, it enters the region via the curve $r=2\\csc\\theta$ and exits via $r=4\\sin\\theta \\mathbin{:}$  \n\n![](images/b0/b09ab4e4e08dfb056964947dc866b965940b761d70c945faf001446c1df7869f.png)\n\nSecondly, our curves intersect at the points $(-2,2)$ and $(2,2).$ So, the entire region $D$ lies between the polar lines $\\theta=\\dfrac{\\pi}{4}$ and $\\theta=\\dfrac{3\\pi}{4},$ as depicted below.  \n\n![](images/6a/6a132d5f8c58ce60c794595ee80c57c5b9b02e630004808cd53a7677efd022e7.png)\n\nTherefore, in polar coordinates $(r, \\theta),$ the region can be expressed as follows:\n\n$$\n\\Delta = \\Big\\{ (r,\\theta) \\: : \\: 2\\csc\\theta \\leq r \\leq 4\\sin\\theta, \\: \\dfrac{\\pi}{4} \\leq \\theta \\leq \\dfrac{3\\pi}{4} \\Big\\}\n$$" 13194139543369 17592186576411 true] [17592186158487 1064 "Let's get some more practice at