\\theta  \\\\ {y}^{2} & =(6\\operatorname{sin}\\theta )^{2} \\\\  & =36{\\operatorname{sin}}^{2}\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =36{\\operatorname{cos}}^{2}\\theta +36{\\operatorname{sin}}^{2}\\theta  \\\\  & =36({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta ) \\\\  & =36(1) \\\\  & =36.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=36.$" 13194139543369 17592186576411 true] [17592186617022 1074 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =6\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & =(6\\operatorname{cos}⁡\\theta )^{2} \\\\  & =36{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =6\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & =(6\\operatorname{sin}⁡\\theta )^{2} \\\\  & =36{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =36{cos}^{2}⁡\\theta +36{sin}^{2}⁡\\theta  \\\\  & =36({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =36(1) \\\\  & =36.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=36.$" 13194139543369 17592186576411 false] [17592186620824 1071 "Let $\\mathbf{a}=⟨2,0,x⟩$, $\\mathbf{b}=⟨3,2,x⟩$ and $|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}|=\\sqrt{61}.$ Find $x.$" 13194139543369 17592186576411 true] [17592186620824 1071 "Let $a=⟨2,0,x⟩$, $b=⟨3,2,x⟩$ and $|\\,a\\times b\\,|=\\sqrt{61}.$ Find $x.$" 13194139543369 17592186576411 false] [17592186620824 1074 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 0 & x \\\\ 3 & 2 & x\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & x \\\\ 2 & x\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & x \\\\ 3 & x\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 0 \\\\ 3 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(0-2x)\\mathbf{i}-(2x-3x)\\mathbf{j}+(4-0)\\mathbf{k} \\\\  & =⟨-2x,x,4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{(-2x)^{2}+{x}^{2}+{4}^{2}} \\\\  & =\\sqrt{4{x}^{2}+{x}^{2}+16} \\\\  & =\\sqrt{5{x}^{2}+16}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| & =\\sqrt{61} \\\\ \\sqrt{5{x}^{2}+16} & =\\sqrt{61} \\\\ 5{x}^{2}+16 & =61 \\\\ 5{x}^{2} & =45 \\\\ {x}^{2} & =9.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 3.$" 13194139543369 17592186576411 true] [17592186620824 1074 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 2 & 0 & x \\\\ 3 & 2 & x\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & x \\\\ 2 & x\\end{vmatrix}i-\\begin{vmatrix}2 & x \\\\ 3 & x\\end{vmatrix}j+\\begin{vmatrix}2 & 0 \\\\ 3 & 2\\end{vmatrix}k \\\\  & =(0-2x)i-(2x-3x)j+(4-0)k \\\\  & =⟨-2x,x,4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-2x)^{2}+{x}^{2}+{4}^{2}} \\\\  & =\\sqrt{4{x}^{2}+{x}^{2}+16} \\\\  & =\\sqrt{5{x}^{2}+16}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{61} \\\\ \\sqrt{5{x}^{2}+16} & =\\sqrt{61} \\\\ 5{x}^{2}+16 & =61 \\\\ 5{x}^{2} & =45 \\\\ {x}^{2} & =9.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 3.$" 13194139543369 17592186576411 false] [17592186620854 1071 "Let $\\mathbf{a}=⟨x,3,6⟩,$ $\\mathbf{b}=⟨2,1,2⟩$ and $|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em