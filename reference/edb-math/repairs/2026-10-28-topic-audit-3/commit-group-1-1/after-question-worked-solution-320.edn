torname{sin}}^{2}2t+{t}^{2})} \\\\  & =2\\sqrt{1+{t}^{2}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{\\mathbf{f}}^{'}(t)‖\\hspace{0.167em}\\text{d}t={\\int }_{0}^{1}2\\sqrt{1+{t}^{2}}\\hspace{0.167em}\\text{d}t\\end{aligned}\n$$"] [17592186323976 "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}(2\\theta )}r\\hspace{0.167em}\\text{d}r\\hspace{0.167em}\\text{d}\\theta  & ={\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}(2\\theta )}r\\hspace{0.167em}\\text{d}r\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}{[\\frac{{r}^{2}}{2}]}_{0}^{2\\operatorname{cos}(2\\theta )}\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}(\\frac{(2\\operatorname{cos}(2\\theta ))^{2}}{2}-0)\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}2{\\operatorname{cos}}^{2}(2\\theta )\\hspace{0.167em}\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}2{\\operatorname{cos}}^{2}(2\\theta )\\hspace{0.167em}\\text{d}\\theta  & ={\\int }_{-\\pi /2}^{\\pi /2}(1+\\operatorname{cos}(4\\theta ))\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={[\\theta +\\frac{1}{4}\\operatorname{sin}(4\\theta )]}_{-\\pi /2}^{\\pi /2} \\\\  & =(\\frac{\\pi }{2}+\\frac{\\pi }{2})+\\frac{1}{4}(\\operatorname{sin}(2\\pi )-\\operatorname{sin}(-2\\pi )) \\\\  & =\\pi \\end{aligned}\n$$"] [17592186329713 "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{cos}\\theta \\operatorname{sin}\\theta (\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta }+\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }) & =\\operatorname{cos}\\theta \\operatorname{sin}\\theta \\cdot \\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta }+\\operatorname{cos}\\theta \\operatorname{sin}\\theta \\cdot \\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta } \\\\  & =\\frac{\\operatorname{sin}\\theta {\\operatorname{cos}}^{2}\\theta }{\\operatorname{sin}\\theta }+\\frac{{\\operatorname{sin}}^{2}\\theta \\operatorname{cos}\\theta }{\\operatorname{cos}\\theta } \\\\  & =\\frac{\\enclose{updiagonalstrike}{\\operatorname{sin}\\theta }{\\operatorname{cos}}^{2}\\theta }{\\enclose{updiagonalstrike}{\\operatorname{sin}\\theta }}+\\frac{{\\operatorname{sin}}^{2}\\theta \\enclose{updiagonalstrike}{\\operatorname{cos}\\theta }}{\\enclose{updiagonalstrike}{\\operatorname{cos}\\theta }} \\\\  & ={\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta  \\\\  & =1\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta =1.$ \n\nTherefore, we conclude that\n\n$$\n\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta })=1.\n$$"] [17592186329714 "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}\\theta }{1-\\operatorname{sin}\\theta }+\\frac{1-\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta } & =\\frac{\\operatorname{cos}\\theta \\operatorname{cos}\\theta }{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta }+\\frac{(1-\\operatorname{sin}\\theta )(1-\\operatorname{sin}\\theta )}{\\operatorname{cos}\\theta (1-\\operatorname{sin}\\theta )} \\\\  & =\\frac{{\\operatorname{cos}}^{2}\\theta +{(1-\\operatorname{sin}\\theta )}^{2}}{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta }\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{\\operatorname{cos}}^{2}\\theta +{(1-\\operatorname{sin}\\theta )}^{2}}{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta } & =\\frac{{\\operatorname{cos}}^{2}\\theta +1-2\\operatorname{sin}\\theta +{\\operatorname{sin}}^{2}\\theta }{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta } \\\\  & =\\frac{({\\operatorname{sin}}^{2}\\theta +{\\operatorname{cos}}^{2}\\theta )+1-2\\operatorname{sin}\\theta }{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta } \\\\  & =\\frac{1+1-2\\operatorname{sin}\\theta }{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta } \\\\  & =\\frac{2-2\\operatorname{sin}\\theta }{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta } \\\\  & =\\frac{2(1-\\operatorname{sin}\\theta )}{(1-\\operatorname{sin}\\theta )\\operatorname{cos}\\theta } \\\\  & =\\frac{2}{\\operatorname{cos}\\theta } \\\\  & =2\\operatorname{sec}\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡\\theta }{1-\\operatorname{sin}⁡\\theta }+\\frac{1-\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }=2\\operatorname{sec}⁡\\theta .\n$$"] [17592186329716 "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{sin}\\theta }({\\operatorname{sin}}^{3}\\theta +{\\operatorname{cos}}^{2}\\theta \\operatorname{sin}\\theta ) & =\\frac{1}{\\operatorname{sin}\\theta }\\cdot {\\operatorname{sin}}^{3}\\theta +\\frac{1}{\\operatorname{sin}\\theta }\\cdot {\\operatorname{cos}}^{2}\\theta \\operatorname{sin}\\theta  \\\\  & =\\frac{{\\operatorname{sin}}^{3}\\theta }{\\operatorname{sin}\\theta }+\\frac{{\\operatorname{cos}}^{2}\\theta \\operatorname{sin}\\theta }{\\operatorname{sin}\\theta } \\\\  & =\\frac{{\\operatorname{sin}}^{2}\\theta \\cdot \\enclose{updiagonalstrike}{\\operatorname{sin}\\theta }}{\\enclose{updiagonalstrike}{\\operatorname{sin}\\theta }}+\\frac{{\\operatorname{cos}}^{2}\\theta \\enclose{updiagonalstrike}{\\operatorname{sin}\\theta }}{\\enclose{updiagonalstrike}{\\operatorname{sin}\\theta }} \\\\  & ={\\operatorname{sin}}^{2}\\theta +{\\operatorname{cos}}^{2}\\theta  \\\\  & =1\\end{aligned}\n$$