 }_{0}^{2}{r}^{3}\\hspace{0.167em}\\text{d}r\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }[\\frac{{r}^{4}}{4}]_{0}^{2}\\hspace{0.167em}\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }4\\hspace{0.167em}\\text{d}\\theta  \\\\  & =4[\\theta ]_{0}^{2\\pi } \\\\  & =4(2\\pi -0) \\\\  & =8\\pi .\\end{aligned}\n$$"] [17592186262702 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =xy=4\\operatorname{sin}t\\operatorname{cos}t, \\\\ Q(x,y) & ={x}^{2}=4{\\operatorname{cos}}^{2}t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)=-2\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{cos}⁡t,\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{sin}t\\operatorname{cos}t)\\cdot (2\\operatorname{cos}t)-(4{\\operatorname{cos}}^{2}t)\\cdot (-2\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  &