}\\text{d}t \\\\  & =-16{\\int }_{0}^{0}u\\hspace{0.222em}\\text{d}u \\\\  & =0\\end{aligned}\n$$"] [17592186262719 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{4}^{2}}=1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $3$ and $4,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=3\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+4\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=4\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =1-x=1-3\\operatorname{cos}⁡t, \\\\ Q(x,y) & =x-y=3\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(1-3\\operatorname{cos}t)\\cdot (4\\operatorname{cos}t)-(3\\operatorname{cos}t-4\\operatorname{sin}t)\\cdot (-3\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cos}t-12{\\operatorname{cos}}^{2}t+9\\operatorname{sin}t\\operatorname{cos}t-12{\\operatorname{sin}}^{2}t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cos}t\\hspace{0.222em}\\text{d}t+9{\\int }_{0}^{2\\pi }\\operatorname{sin}t\\operatorname{cos}t\\hspace{0.222em}\\text{d}t-12{\\int }_{0}^{2\\pi }\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cos}t\\hspace{0.222em}\\text{d}t+9{\\int }_{0}^{0}u\\hspace{0.222em}\\text{d}u-12{\\int }_{0}^{2\\pi }\\hspace{0.222em}\\text{d}t \\\\  & =4\\operatorname{sin}t{|}_{0}^{2\\pi }+0-12t\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =4(0-0)-12(2\\pi -0) \\\\  & =-24\\pi \\end{aligned}\n$$"] [17592186262720 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={2}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $2.$ It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =8, \\\\ Q(x,y) & =x+3=2\\operatorname{cos}⁡t+3.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)=-2\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the double-angle formula for sine, as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(8)\\cdot (2\\operatorname{cos}t)-(-2\\operatorname{cos}t-3)\\cdot (-2\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{cos}t-4\\operatorname{sin}t\\operatorname{cos}t-6\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{cos}t-2\\operatorname{sin}2t-6\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & =(16\\operatorname{sin}t-\\operatorname{cos}2t-6\\operatorname{cos}t)\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =0\\end{aligned}\n$$"] [17592186262721 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={∮}_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={5}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $5.$ It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t)=5\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+5\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},\\hspace{2em}0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=5\\operatorname{cos}⁡t,\\,y=5\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x=5\\operatorname{cos}⁡t, \\\\ Q(x,y) & =-5.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5\\operatorname{cos}⁡t)=-5\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5\\operatorname{sin}⁡t)=5\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the double-angle formula for cosine, as follows:\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={∮}_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(5\\operatorname{cos}t)\\cdot (5\\operatorname{cos}t)-(-5)\\cdot (-5\\operatorname{sin}t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }25{\\operatorname{cos}}^{2}t-25\\operatorname{sin}t\\hspace{0.222em}\\text{d}t \\\\  & =25{\\int }_{0}^{2\\pi }\\frac{\\operatorname{cos}(2t)+1}{2}-\\operatorname{sin}t\\hspace{0.222em}\\text{d}t \\\\  & =25(\\frac{\\operatorname{sin}(2t)}{4}+\\frac{1}{2}t+\\operatorname{cos}t)\\hspace{0.167em}{|}_{0}^{2\\pi } \\\\  & =25(0+\\pi +1)-(0+1) \\\\  & =25\\pi \\end{aligned}\n$$"] [17592186262722 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nIn this case, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula. \n\n![](images/59/59e503e0c4d950f030891bbaeb7ed890426ef470a1e1dae89d27eabb8dd591a6.png)\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2},\\,y=t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =4y=4t, \\\\ Q(x,y) & =2x-1=2{t}^{2}-1.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{1}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}(4t)\\cdot (1)-(2{t}^{2}-1)\\cdot (2t)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{1}4t-4{t}^{3}+2t\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{1}6t-4{t}^{3}\\hspace{0.222em}\\text{d}t \\\\  & =3{t}^{2}-{t}^{4}{|}_{0}^{1} \\\\  & =(3-1)-(0-0){|}_{0}^{1} \\\\  & =2\\end{aligned}\n$$"] [17592186262723 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nIn this case, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula. \n\n![](images/d4/d432857e3350dfcb70a2a00b66ad9b86bc207382edd277c2169be0834c1710e0.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=\\frac{1}{t},\\,y=t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x=\\frac{1}{t}, \\\\ Q(x,y) & ={y}^{2}={t}^{2}.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)=-\\frac{1}{{t}^{2}}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{1/2}^{2}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1/2}^{2}\\left(\\frac{1}{t}\\right)\\cdot (1)-({t}^{2})\\cdot \\left(-\\frac{1}{{t}^{2}}\\right)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{1/2}^{2}\\frac{1}{t}+1\\hspace{0.222em}\\text{d}t \\\\  & =(\\operatorname{ln}t+t){|}_{1/2}^{2} \\\\  & =(\\operatorname{ln}2+2)-(\\operatorname{ln}\\frac{1}{2}+\\frac{1}{2}) \\\\  & =2\\operatorname{ln}2+\\frac{3}{2}\\end{aligned}\n$$"] [17592186262728 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/98/98d7da0c7cd1e1f1006c1db74ae1a1e1f198d9066df6585745ee36548f0b8d96.png)\n\nWe have that $P(x,y)=y+2{x}^{2}y$ and $Q(x,y)={x}^{2}-x{y}^{2}.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=4xy,\\,\\frac{∂Q}{∂y} & =-2xy.\\end{aligned}\n$$\n\nTherefore, applying the flux form of Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(4xy+(-2xy))\\,\\text{d}A \\\\  & ={∬}_{D}2xy\\,\\text{d}A.\\end{aligned}\n$$\n\nHence, $f(x,y)=2xy.$"] [17592186262734 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nIn this case, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula. \n\n![](images/11/11376e6ef18b151a6dd1a02dd09f20b72bce3160c718f4095b4f08b23721ff1f.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=\\frac{t}{2},\\,y=\\frac{1}{2t}.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =4, \\\\ Q(x,y) & =2.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{t}{2}\\right)=\\frac{1}{2}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{2t}\\right)=-\\frac{1}{2{t}^{2}}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{1/2}^{2}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1/2}^{2}(4)\\cdot \\left(-\\frac{1}{2{t}^{2}}\\right)-(2)\\cdot \\left(\\frac{1}{2}\\right)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{1/2}^{2}-\\frac{2}{{t}^{2}}-1\\hspace{0.222em}\\text{d}t \\\\  & =(\\frac{2}{t}-t){|}_{1/2}^{2} \\\\  & =(1-2)-(4-\\frac{1}{2}) \\\\  & =-\\frac{9}{2}\\end{aligned}\n$$"] [17592186262735 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nIn this case, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula. \n\n![](images/55/559bbc20aa7d47eaad47a8975f80c8efb91bd03bc816357bc6047675dc755c9b.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{ln}⁡t,\\,y=t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =5{e}^{-x}=5{e}^{-\\operatorname{ln}⁡t}=\\frac{5}{t}, \\\\ Q(x,y) & =4.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)=\\frac{1}{t}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{1}^{e}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1}^{e}\\left(\\frac{5}{t}\\right)\\cdot (1)-(4)\\cdot \\left(\\frac{1}{t}\\right)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{1}^{e}\\frac{1}{t}\\hspace{0.222em}\\text{d}t \\\\  & =\\operatorname{ln}t{|}_{1}^{e} \\\\  & =1\\end{aligned}\n$$"] [17592186262736 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/fa/fa98f3db31860a463d0a551d5297895e61a6c041d852c04de04c44a194510961.png)\n\nWe have that $P(x,y)=3x{y}^{3}$ and $Q(x,y)=6x{y}^{4}.$ So, \n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{y}^{3},\\,\\frac{∂Q}{∂y} & =24x{y}^{3}.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):-1\\le x\\le 1,\\,0\\le y\\le 2\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{y}^{3}+24x{y}^{3})\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"] [17592186262737 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/54/5497f23e51d1e745fef1cf39d6c1a8ada22b25e8c9c7b87f5d5338e85a941739.png)\n\nWe have that $P(x,y)=y{x}^{2}+{y}^{3}x$ and $Q(x,y)=-{y}^{2}x+{y}^{4}.$ So, \n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2yx+{y}^{3},\\,\\frac{∂Q}{∂y} & =-2yx+4{y}^{3}.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):-3\\le x\\le -1,\\,-1\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2yx+{y}^{3})+(-2yx+4{y}^{3})\\,\\text{d}A \\\\  & ={\\int }_{-3}^{-1}{\\int }_{-1}^{1}5{y}^{3}\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"] [17592186262738 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nIn this case, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula. \n\n![](images/0e/0e751adb9f44d24ba89af318fe5f063b1be146bbae45d05fc2dd9a99bef259f2.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=t,\\,y=t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =3xy=3{t}^{2}, \\\\ Q(x,y) & =2x+1=2t+1.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{1}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}(3{t}^{2})(1)-(2t+1)(1)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{1}3{t}^{2}-2t-1\\hspace{0.222em}\\text{d}t \\\\  & =({t}^{3}-{t}^{2}-t){|}_{0}^{1} \\\\  & =(1-1-1)-(0-0-0) \\\\  & =-1\\end{aligned}\n$$"] [17592186262739 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nParameterizing the curve $C,$ we have\n\n$$\nx=t,\\,y={t}^{3},\\,t\\in [0,1].\n$$\n\n \n\nThis parameterization traverses the curve from the point $(0,0)$ to the point $(1,1).$ Therefore, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula for the flux. \n\n![](images/1d/1d54fe3c07f04a7d05567942e3eea6efaf1cb516070a5d7cc31ef726c0ddb423.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =-3{x}^{2}=-3{t}^{2}, \\\\ Q(x,y) & =1.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})=3{t}^{2}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{1}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}(-3{t}^{2})\\cdot (3{t}^{2})-(1)\\cdot (1)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{1}-9{t}^{4}-1\\hspace{0.222em}\\text{d}t \\\\  & =(-\\frac{9{t}^{5}}{5}-t){|}_{0}^{1} \\\\  & =(-\\frac{9}{5}-1)-0 \\\\  & =-\\frac{14}{5}\\end{aligned}\n$$"] [17592186262740 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nParameterizing the curve $C,$ we have\n\n$$\nx=t,\\,y=1-t,\\,t\\in [0,1].\n$$\n\n \n\nThis parameterization traverses the curve from the point $(0,1)$ to the point $(1,0).$ Therefore, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula for the flux. \n\n![](images/e2/e288ed1095be61e4645fb63c22b7fd2cb605d34795c30557e84afb31b7ec8721.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =1, \\\\ Q(x,y) & =1.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-t)=-1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{0}^{1}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}(1)\\cdot (-1)-(1)\\cdot (1)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{0}^{1}-2\\hspace{0.222em}\\text{d}t \\\\  & =(-2t){|}_{0}^{1} \\\\  & =-2-0 \\\\  & =-2\\end{aligned}\n$$"] [17592186262741 "If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j}$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf{F}$ across $C$ measured with respect to a unit normal vector $\\mathbf{n}$ on $C$ is given by\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{C}P\\hspace{0.167em}\\text{d}y-Q\\hspace{0.167em}\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf{r}(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf{n}$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $\\mathbf{T}(t).$\n\nParameterizing the curve $C,$ we have\n\n$$\nx=-\\operatorname{ln}⁡t\\,y=t,\\,t\\in [\\frac{1}{e},1].\n$$\n\n \n\nThis parameterization traverses the curve from the point $(1,\\frac{1}{e})$ to the point $(0,1).$ Therefore, $\\mathbf{n}$ is indeed a ${90}^{∘}$ clockwise rotation of $\\mathbf{T},$ so we can apply the above formula for the flux. \n\n![](images/08/08fc4561a322b690da7bd28a9e69a91c687256e8a902ec7690dda5e6a1c689a6.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =0, \\\\ Q(x,y) & =2{y}^{2}=2{t}^{2}.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{ln}⁡t)=-\\frac{1}{t}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s & ={\\int }_{C}P\\hspace{0.222em}\\text{d}y-Q\\hspace{0.222em}\\text{d}x \\\\  & ={\\int }_{1/e}^{1}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1/e}^{1}(0)\\cdot (1)-(2{t}^{2})\\cdot \\left(-\\frac{1}{t}\\right)\\hspace{0.222em}\\text{d}t \\\\  & ={\\int }_{1/e}^{1}2t\\hspace{0.222em}\\text{d}t \\\\  & =({t}^{2}){|}_{1/e}^{1} \\\\  & =1-\\frac{1}{{e}^{2}}\\end{aligned}\n$$"] [17592186262752 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/35/35e378bca35f4b0822c713556065415d59b5c566ec8fcc8e3124256aac7b7f14.png)\n\nWe have that $P(x,y)=\\operatorname{sin}⁡y+2x$ and $Q(x,y)={x}^{5}-3y.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2,\\,\\frac{∂Q}{∂y} & =-3.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):-1\\le x\\le 1,\\hspace{0.167em}-1\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2-3)\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{-1}^{1}(-1)\\hspace{0.167em}\\text{d}x\\hspace{0.167em}\\text{d}y \\\\  & =-{\\int }_{-1}^{1}x\\hspace{0.167em}{|}_{-1}^{1}\\hspace{0.167em}\\mathrm{d}y \\\\  & =-{\\int }_{-1}^{1}(1-(-1))\\hspace{0.167em}\\mathrm{d}y \\\\  & =-2{\\int }_{-1}^{1}\\hspace{0.167em}\\mathrm{d}y \\\\  & =-2y\\hspace{0.167em}{|}_{-1}^{1} \\\\  & =-4.\\end{aligned}\n$$"] [17592186262753 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/26/2696cdadd3cb020cfbe343b9c372893ac18b63f3548ff71003b7328b19de39d5.png)\n\nWe have that $P(x,y)=\\operatorname{cos}⁡y-3{x}^{3}$ and $Q(x,y)=x{e}^{x}-4x{y}^{3}.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-9{x}^{2},\\,\\frac{∂Q}{∂y} & =-12x{y}^{2}.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):-1\\le x\\le 1,\\hspace{0.167em}0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(-9{x}^{2}-12x{y}^{2})\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}(-9{x}^{2}-12x{y}^{2})\\hspace{0.167em}\\text{d}x\\hspace{0.167em}\\text{d}y \\\\  & ={\\int }_{0}^{1}[-3{x}^{3}-6{x}^{2}{y}^{2}]_{-1}^{1}\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{1}[(-3(1)^{3}-6(1)^{2}{y}^{2})-(-3(-1)^{3}-6(-1)^{2}{y}^{2})]\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{1}(-6)\\hspace{0.167em}\\mathrm{d}y \\\\  & =-6y\\hspace{0.167em}{|}_{0}^{1} \\\\  & =-6.\\end{aligned}\n$$"] [17592186262754 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/f6/f6e80e3010ec7c40d3f59dbb1da4e77c985c889a720b6f954177d8ad83a01351.png)\n\nWe have that $P(x,y)=6y{x}^{2}+{e}^{y}$ and $Q(x,y)=3{y}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=12yx,\\,\\frac{∂Q}{∂y} & =6y.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 2,\\,0\\le y\\le \\sqrt{x}\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(12yx+6y)\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{x}}(12yx+6y)\\hspace{0.167em}\\text{d}y\\hspace{0.167em}\\text{d}x \\\\  & ={\\int }_{0}^{2}(6{y}^{2}x+3{y}^{2})\\hspace{0.167em}{|}_{0}^{\\sqrt{x}}\\hspace{0.167em}\\mathrm{d}x \\\\  & ={\\int }_{0}^{2}(6{x}^{2}+3x)\\hspace{0.167em}\\mathrm{d}x \\\\  & =(2{x}^{3}+\\frac{3{x}^{2}}{2})\\hspace{0.167em}{|}_{0}^{2} \\\\  & =22-0 \\\\  & =22.\\end{aligned}\n$$"] [17592186262755 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/c4/c4dd4d03bdfcf6c3d597e2fdef8681e4f3316b3f276cb9967933b61b0dc90976.png)\n\nWe have that $P(x,y)=x-\\sqrt{y}$ and $Q(x,y)=y-\\sqrt{x}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=1,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\operatorname{sin}⁡x\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(1+1)\\hspace{0.167em}\\text{d}A \\\\  & =2{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}x}\\hspace{0.167em}\\text{d}y\\hspace{0.167em}\\text{d}x \\\\  & =2{\\int }_{0}^{\\pi /2}y\\hspace{0.167em}{|}_{0}^{\\operatorname{sin}x}\\hspace{0.167em}\\mathrm{d}x \\\\  & =2{\\int }_{0}^{\\pi /2}\\operatorname{sin}x\\hspace{0.167em}\\mathrm{d}x \\\\  & =2(-\\operatorname{cos}x)\\hspace{0.167em}{|}_{0}^{\\pi /2} \\\\  & =2(0-(-1)) \\\\  & =2.\\end{aligned}\n$$"] [17592186262757 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/ea/ea6c25e40b6683d9ff4a4884dbbda708fd79dbd79d0b50730f9ad6e165d2eb58.png)\n\nWe have that $P(x,y)=\\sqrt[3]{y}+x$ and $Q(x,y)=\\operatorname{sin}⁡x-3{x}^{2}{y}^{2}.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=1,\\,\\frac{∂Q}{∂y} & =-6{x}^{2}y.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 2,\\,0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(1-6{x}^{2}y)\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}(1-6{x}^{2}y)\\hspace{0.167em}\\text{d}x\\hspace{0.167em}\\text{d}y \\\\  & ={\\int }_{0}^{1}(x-2{x}^{3}y)\\hspace{0.167em}{|}_{0}^{2}\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{1}[(2-2(2)^{3}y)-0]\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{1}(2-16y)\\hspace{0.167em}\\mathrm{d}y \\\\  & =[2y-8{y}^{2}]_{0}^{1} \\\\  & =(2(1)-8(1)^{2})-0 \\\\  & =-6.\\end{aligned}\n$$"] [17592186262758 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/3a/3ad0a876fe801980a2c3724a639fc6c379db750635c0278a10a5094e2d64c34a.png)\n\nWe have that $P(x,y)=6{x}^{2}+2y$ and $Q(x,y)=-10y-\\operatorname{arctan}⁡x.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=12x,\\,\\frac{∂Q}{∂y} & =-10.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD=\\{(x,y):-2y\\le x\\le 2y,\\,0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(12x-10)\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-2y}^{2y}(12x-10)\\hspace{0.167em}\\text{d}x\\hspace{0.167em}\\text{d}y \\\\  & ={\\int }_{0}^{1}[6{x}^{2}-10x]_{-2y}^{2y}\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{1}(24{y}^{2}-20y)-(24{y}^{2}+20y)\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{1}(-40y)\\hspace{0.167em}\\mathrm{d}y \\\\  & =-40{[\\frac{{y}^{2}}{2}]}_{0}^{1} \\\\  & =-40(\\frac{1}{2}-0) \\\\  & =-20.\\end{aligned}\n$$"] [17592186262759 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/34/3497b3bbc834879026235f97468f5feb26e91a2b73a4de3da87597bf422ecd33.png)\n\nWe have that $P(x,y)=\\operatorname{sin}⁡(2y)-y{x}^{2}$ and $Q(x,y)=\\operatorname{cos}⁡(2x)+2xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-2xy,\\,\\frac{∂Q}{∂y} & =2x.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 1,\\,-1\\le y\\le 0\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(-2xy+2x)\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}(2x-2xy)\\hspace{0.167em}\\text{d}x\\hspace{0.167em}\\text{d}y \\\\  & ={\\int }_{-1}^{0}({x}^{2}-{x}^{2}y)\\hspace{0.167em}{|}_{0}^{1}\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{-1}^{0}[(1-y)-0]\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{-1}^{0}(1-y)\\hspace{0.167em}\\mathrm{d}y \\\\  & =[y-\\frac{{y}^{2}}{2}]_{-1}^{0} \\\\  & =0-((-1)-\\frac{(-1)^{2}}{2}) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"] [17592186262760 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/00/006d80a7dbe4d03b78cc5fb1a642405e3fdfdd69ec9d80014ee8e0355ad1ae73.png)\n\nWe have that $P(x,y)=xy-\\sqrt{{y}^{2}+1}$ and $Q(x,y)={x}^{3}+y.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=y,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD=\\{(x,y):-\\frac{y}{2}\\le x\\le \\frac{y}{2},\\,0\\le y\\le 2\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(y+1)\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-y/2}^{y/2}(y+1)\\hspace{0.167em}\\text{d}x\\hspace{0.167em}\\text{d}y \\\\  & ={\\int }_{0}^{2}(y+1)[x]_{-y/2}^{y/2}\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{2}(y+1)[\\frac{y}{2}-\\left(-\\frac{y}{2}\\right)]\\hspace{0.167em}\\mathrm{d}y \\\\  & ={\\int }_{0}^{2}({y}^{2}+y)\\hspace{0.167em}\\mathrm{d}y \\\\  & ={[\\frac{{y}^{3}}{3}+\\frac{{y}^{2}}{2}]}_{0}^{2} \\\\  & =(\\frac{8}{3}+\\frac{4}{2})-0 \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$"] [17592186262762 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf{F}=P\\hspace{0.167em}\\mathbf{i}+Q\\hspace{0.167em}\\mathbf{j},$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s={∬}_{D}\\text{div}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/24/24369439bc62cf06084a43d97dff0cee4e4089fd103511ef73d9dd5af1256ebb.png)\n\nWe have that $P(x,y)=30xy$ and $Q(x,y)=15{y}^{2}-\\operatorname{sin}⁡x.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=30y,\\,\\frac{∂Q}{∂y} & =30y.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD=\\{(x,y):\\sqrt{y}\\le x\\le y,\\hspace{0.167em}0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s & ={∮}_{C}P\\hspace{0.167em}\\mathrm{d}y-Q\\hspace{0.167em}\\mathrm{d}x \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(30y+30y)\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-\\sqrt{y}}^{y}60y\\hspace{0.167em}\\text{d}x\\hspace{0.167em}\\text{d}y \\\\  & =60{\\int }_{0}^{1}y[x]_{-\\sqrt{y}}^{y}\\hspace{0.167em}\\mathrm{d}y \\\\  & =60{\\int }_{0}^{1}y(y+\\sqrt{y})\\hspace{0.167em}\\mathrm{d}y \\\\  & =60{\\int }_{0}^{1}({y}^{2}+{y}^{3/2})\\hspace{0.167em}\\mathrm{d}y \\\\  & =60{[\\frac{{y}^{3}}{3}+\\frac{2{y}^{5/2}}{5}]}_{0}^{1} \\\\  & =60(\\frac{1}{3}+\\frac{2}{5})-0 \\\\  & =44.\\end{aligned}\n$$"] [17592186262772 "First, we find ${\\mathbf{f}}^{'}(t)$ and $‖{\\mathbf{f}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}t)⟩ \\\\  & =⟨-4\\operatorname{sin}t,\\hspace{0.167em}3\\operatorname{cos}t,\\hspace{0.167em}4\\operatorname{cos}t⟩ \\\\ ‖{\\mathbf{f}}^{'}(t)‖ & =\\sqrt{(-4\\operatorname{sin}t)^{2}+(3\\operatorname{cos}t)^{2}+(4\\operatorname{cos}t)^{2}} \\\\  & =\\sqrt{16{\\operatorname{sin}}^{2}t+9{\\operatorname{cos}}^{2}t+16{\\operatorname{cos}}^{2}t} \\\\  & =\\sqrt{16({\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t)+9{\\operatorname{cos}}^{2}t} \\\\  & =\\sqrt{9{\\operatorname{cos}}^{2}t+16}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{\\pi /6}^{\\pi /4}‖{\\mathbf{f}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{\\operatorname{cos}}^{2}t+16}\\hspace{0.167em}\\text{d}t.\\end{aligned}\n$$"] [17592186262773 "First, we find ${\\mathbf{f}}^{'}(t)$ and $‖{\\mathbf{f}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t+\\operatorname{sin}t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t-\\operatorname{cos}t)⟩ \\\\  & =⟨\\operatorname{cos}t-\\operatorname{sin}t,\\hspace{0.167em}{e}^{t},\\hspace{0.167em}\\operatorname{cos}t+\\operatorname{sin}t⟩ \\\\ ‖{\\mathbf{f}}^{'}(t)‖ & =\\sqrt{{(\\operatorname{cos}t-\\operatorname{sin}t)}^{2}+({e}^{t})^{2}+{(\\operatorname{cos}t+\\operatorname{sin}t)}^{2}} \\\\  & =\\sqrt{{\\operatorname{cos}}^{2}t-2\\operatorname{cos}t\\operatorname{sin}t+{\\operatorname{sin}}^{2}t+{e}^{2t}+{\\operatorname{cos}}^{2}t+2\\operatorname{cos}t\\operatorname{sin}t+{\\operatorname{sin}}^{2}t} \\\\  & =\\sqrt{{e}^{2t}+2({\\operatorname{cos}}^{2}t+{\\operatorname{sin}}^{2}t)} \\\\  & =\\sqrt{{e}^{2t}+2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{\\mathbf{f}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\hspace{0.167em}\\text{d}t.\\end{aligned}\n$$"] [17592186262794 "First, we find ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{cos}t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}t)⟩ \\\\  & =⟨{e}^{t}(\\operatorname{cos}t-\\operatorname{sin}t),\\hspace{0.167em}{e}^{t}(\\operatorname{cos}t+\\operatorname{sin}t)⟩ \\\\  & ={e}^{t}⟨\\operatorname{cos}t-\\operatorname{sin}t,\\hspace{0.167em}\\operatorname{cos}t+\\operatorname{sin}t⟩ \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =|{e}^{t}|\\sqrt{{(\\operatorname{cos}t-\\operatorname{sin}t)}^{2}+{(\\operatorname{cos}t+\\operatorname{sin}t)}^{2}} \\\\  & ={e}^{t}\\sqrt{{\\operatorname{cos}}^{2}t-2\\operatorname{cos}t\\operatorname{sin}t+{\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t+2\\operatorname{cos}t\\operatorname{sin}t+{\\operatorname{sin}}^{2}t} \\\\  & ={e}^{t}\\sqrt{2({\\operatorname{cos}}^{2}t+{\\operatorname{sin}}^{2}t)} \\\\  & =\\sqrt{2}{e}^{t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /2}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2}{e}^{t}\\hspace{0.167em}\\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi /2}{e}^{t}\\hspace{0.167em}\\text{d}t \\\\  & =\\sqrt{2}{e}^{t}\\hspace{0.167em}{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{2}({e}^{\\pi /2}-{e}^{0}) \\\\  & =\\sqrt{2}({e}^{\\pi /2}-1).\\end{aligned}\n$$"] [17592186262798 "First, we find ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3t-{t}^{3}),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩ \\\\  & =⟨3-3{t}^{2},\\hspace{0.167em}6t⟩ \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{(3-3{t}^{2})}^{2}+{(6t)}^{2}} \\\\  & =\\sqrt{9-18{t}^{2}+9{t}^{4}+36{t}^{2}} \\\\  & =\\sqrt{9{t}^{4}+18{t}^{2}+9} \\\\  & =3\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =3\\sqrt{({t}^{2}+1)^{2}} \\\\  & =3({t}^{2}+1)\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}3({t}^{2}+1)\\hspace{0.167em}\\text{d}t \\\\  & =3{\\int }_{-1}^{1}({t}^{2}+1)\\hspace{0.167em}\\text{d}t \\\\  & =3(\\frac{{t}^{3}}{3}+t){|}_{-1}^{1} \\\\  & =3(\\frac{{1}^{3}}{3}+1-[\\frac{(-1)^{3}}{3}+(-1)]) \\\\  & =3(\\frac{1}{3}+1+\\frac{1}{3}+1) \\\\  & =3\\left(\\frac{8}{3}\\right) \\\\  & =8\\end{aligned}\n$$"] [17592186262801 "First, we find ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}({t}^{2}+2)^{3/2})⟩ \\\\  & =⟨1,\\hspace{0.167em}t\\sqrt{{t}^{2}+2}⟩ \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{1}^{2}+{(t\\sqrt{{t}^{2}+2})}^{2}} \\\\  & =\\sqrt{1+{t}^{2}({t}^{2}+2)} \\\\  & =\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =\\sqrt{({t}^{2}+1)^{2}} \\\\  & ={t}^{2}+1\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{2}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{-1}^{2}({t}^{2}+1)\\text{d}t \\\\  & =(\\frac{{t}^{3}}{3}+t){|}_{-1}^{2} \\\\  & =(\\frac{{2}^{3}}{3}+2)-(\\frac{(-1)^{3}}{3}+(-1)) \\\\  & =\\frac{8}{3}+2+\\frac{1}{3}+1 \\\\  & =6.\\end{aligned}\n$$"] [17592186262810 "First, we find ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖:$\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}),\\hspace{0.167em}\\frac{\\text{d}}{\\text{d}t}({t}^{2}))⟩ \\\\  & =⟨2,\\hspace{0.167em}{t}^{2},\\hspace{0.167em}2t⟩ \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{(2)}^{2}+{({t}^{2})}^{2}+{(2t)}^{2}} \\\\  & =\\sqrt{{t}^{4}+4{t}^{2}+4} \\\\  & =\\sqrt{({t}^{2}+2)^{2}} \\\\  & ={t}^{2}+2\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{0}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{-1}^{0}({t}^{2}+2)\\hspace{0.167em}\\text{d}t \\\\  & =(\\frac{1}{3}{t}^{3}+2t){|}_{-1}^{0} \\\\  & =(\\frac{{0}^{3}}{3}+2(0))-(\\frac{(-1)^{3}}{3}+2(-1)) \\\\  & =\\frac{1}{3}+2 \\\\  & =\\frac{7}{3}\\end{aligned}\n$$"]}
