cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -4 & \\le 4\\operatorname{cos}⁡\\theta \\le 4 \\\\ -4+1 & \\le 4\\operatorname{cos}⁡\\theta +1\\le 4+1 \\\\ -3 & \\le x\\le 5.\\end{aligned}\n$$\n\nSo, we can conclude that $-3\\le x\\le 5.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ \nwe have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ \\frac{7}{2} & \\text{ }\\ge -\\frac{7}{2}\\operatorname{sin}⁡\\theta \\text{ }\\ge -\\frac{7}{2} \\\\ -\\frac{7}{2} & \\le -\\frac{7}{2}\\operatorname{sin}⁡\\theta \\le \\frac{7}{2} \\\\ -\\frac{7}{2} & \\le y\\le \\frac{7}{2}.\\end{aligned}\n$$\n\nSo, we can conclude that $-\\frac{7}{2}\\le y\\le \\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186302370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e53605c5-4363-5d5f-b627-9bba58dd0c48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{29}{6}" :db/id #edb/ref 17592186301099}] :answer-field/correct {:answer/id #uuid "e53605c5-4363-5d5f-b627-9bba58dd0c48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{29}{6}" :db/id #edb/ref 17592186301099} :answer-field/id #uuid "086d7618-2535-5345-9129-765eb6f7c1c8" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301247} {:answer-field/choices [{:answer/id #uuid "9fa32927-57bc-54aa-b114-9579aa439c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186300768}] :answer-field/correct {:answer/id #uuid "9fa32927-57bc-54aa-b114-9579aa439c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186300768} :answer-field/id #uuid "405f7999-f2