#{[{:db/id #edb/ref 17592186302272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2f74f3-79cd-574f-9238-6fcdf77522bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186299987}] :answer-field/correct {:answer/id #uuid "0b2f74f3-79cd-574f-9238-6fcdf77522bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186299987} :answer-field/id #uuid "27b250f4-4f05-544b-8ebc-03ff71447626" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301351} {:answer-field/choices [{:answer/id #uuid "bf5af01e-616b-5c46-a431-35738aad2c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186300920}] :answer-field/correct {:answer/id #uuid "bf5af01e-616b-5c46-a431-35738aad2c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186300920} :answer-field/id #uuid "cf8b63ee-6e28-54cd-8eb2-72e238c6f9eb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301894} {:answer-field/choices [{:answer/id #uuid "521f8156-1852-5b70-b978-7d31f5f9d99c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{2}" :db/id #edb/ref 17592186300388}] :answer-field/correct {:answer/id #uuid "521f8156-1852-5b70-b978-7d31f5f9d99c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{2}" :db/id #edb/ref 17592186300388} :answer-field/id #uuid "ec5a0f5f-9550-5151-a6a5-e2b91e74b30c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301978}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8c7b5c0-57d6-5e10-9424-b187294f0724" :question/math-academy-id "q-326250" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\frac{1}{2}{t}^{3}-2,\\,y=\\frac{t-1}{t+1},\\,0\\le t\\le 5.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-2$ | $-\\frac{3}{2}$ | $2$ | $\\frac{23}{2}$ | $30$ | {{field-1}} |\n| $y$ | $-1$ | $0$ | {{field-2}} | $\\frac{1}{2}$ | $\\frac{3}{5}$ | {{field-3}} |" :question/worked-solution "- To find the value of $x(5),$ we substitute $t=5$ into $x=\\frac{1}{2}{t}^{3}-2.$ This gives\n\n$$\nx(5)=\\frac{1}{2}(5)^{3}-2=\\frac{125}{2}-\\frac{4}{2}=\\frac{121}{2}.\n$$\n\n- To find the value of $y(2),$ we substitute $t=2$ into $y=\\frac{t-1}{t+1}.$ This gives\n\n$$\ny(2)=\\frac{2-1}{2+1}=\\frac{1}{3}.\n$$\n\n- To find the value of $y(5),$ we substitute $t=5$ into $y=\\frac{t-1}{t+1}.$ This gives\n\n$$\ny(0)=\\frac{5-1}{5+1}=\\frac{4}{6}=\\frac{2}{3}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-2$ | $-\\frac{3}{2}$ | $2$ | $\\frac{23}{2}$ | $30$ | $\\frac{121}{2}$ |\n| $y$ | $-1$ | $0$ | $\\frac{1}{3}$ | $\\frac{1}{2}$ | $\\frac{3}{5}$ | $\\frac{2}{3}$ |"}] [{:db/id #edb/ref 17592186302273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dea4c418-a2a3-5eb1-914f-abfb1e44f530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186301065}] :answer-field/correct {:answer/id #uuid "dea4c418-a2a3-5eb1-914f-abfb1e44f530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186301065} :answer-field/id #uuid "0f6a1cf6-f1e9-5324-a0cd-8de8748825b8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301277} {:answer-field/choices [{:answer/id #uuid "42ca4294-13f5-564a-9c61-bfe51e2f5894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300288}] :answer-field/correct {:answer/id #uuid "42ca4294-13f5-564a-9c61-bfe51e2f5894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300288} :answer-field/id #uuid "af402e53-ece3-5170-871d-14635b65690e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301800} {:answer-field/choices [{:answer/id #uuid "3dbec592-362f-5cb8-838b-38b868c54f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300263}] :answer-field/correct {:answer/id #uuid "3dbec592-362f-5cb8-838b-38b868c54f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300263} :answer-field/id #uuid "d785ba22-7770-5336-8681-5b6890e427ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9505d474-040a-5e78-97f1-c782cc218ed5" :question/math-academy-id "q-326251" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\sqrt{\\,t+4\\,},\\,y=\\frac{3}{2}{t}^{2}-t,\\,-3\\le t\\le 2.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | {{field-1}} | $\\sqrt{2}$ | $\\sqrt{3}$ | $2$ | $\\sqrt{5}$ | $\\sqrt{6}$ |\n| $y$ | $\\frac{33}{2}$ | $8$ | {{field-2}} | $0$ | $\\frac{1}{2}$ | {{field-3}} |" :question/worked-solution "- To find the value of $x(-3),$ we substitute $t=-3$ into $x=\\sqrt{\\,t+4\\,}.$ This gives\n\n$$\nx(-3)=\\sqrt{-3+4}=\\sqrt{1}=1.\n$$\n\n- To find the value of $y(-1),$ we substitute $t=-1$ into $y=\\frac{3}{2}{t}^{2}-t.$ This gives\n\n$$\ny(-1)=\\frac{3}{2}(-1)^{2}-(-1)=\\frac{3}{2}+1=\\frac{3}{2}+\\frac{2}{2}=\\frac{5}{2}.\n$$\n\n- To find the value of $y(2),$ we substitute $t=2$ into $y=\\frac{3}{2}{t}^{2}-t.$ This gives\n\n$$\ny(2)=\\frac{3}{2}(2)^{2}-(2)=6-2=4.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $\\sqrt{2}$ | $\\sqrt{3}$ | $2$ | $\\sqrt{5}$ | $\\sqrt{6}$ |\n| $y$ | $\\frac{33}{2}$ | $8$ | $\\frac{5}{2}$ | $0$ | $\\frac{1}{2}$ | $4$ |"}] [{:db/id #edb/ref 17592186302274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503204c2-5202-5eb6-9c99-1d89a4256bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300382}] :answer-field/correct {:answer/id #uuid "503204c2-5202-5eb6-9c99-1d89a4256bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300382} :answer-field/id #uuid "775ffea0-6f09-507b-ba4a-f5929a9c5ece" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301596} {:answer-field/choices [{:answer/id #uuid "20d2ae08-199c-5474-adf2-cfd379ea5346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186300115}] :answer-field/correct {:answer/id #uuid "20d2ae08-199c-5474-adf2-cfd379ea5346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186300115} :answer-field/id #uuid "9fdb03f8-a8af-5dff-897a-1a48b028739f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301740} {:answer-field/choices [{:answer/id #uuid "8236cfbf-50c1-52a1-9051-6e2573a692b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300611}] :answer-field/correct {:answer/id #uuid "8236cfbf-50c1-52a1-9051-6e2573a692b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300611} :answer-field/id #uuid "be04d349-7486-598b-9dcd-fc83d123cadf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301846}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cefa32c2-7378-5ecb-a3a0-9b87e829889e" :question/math-academy-id "q-326255" :question/problem "Consider the curve with parametric equations\n\n$$\nx=cos\\,\\left(\\frac{\\pi t}{4}\\right),\\,y=sin\\,\\left(\\frac{\\pi t}{6}\\right),\\,0\\le t\\le 5.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $\\frac{\\sqrt{2}}{2}$ | {{field-1}} | $-\\frac{\\sqrt{2}}{2}$ | $-1$ | $-\\frac{\\sqrt{2}}{2}$ |\n| $y$ | $0$ | $\\frac{1}{2}$ | $\\frac{\\sqrt{3}}{2}$ | {{field-2}} | {{field-3}} | $\\frac{1}{2}$ |" :question/worked-solution "- To find the value of $x(2),$ we substitute $t=2$ into $x=cos\\,\\left(\\frac{\\pi t}{4}\\right).$ This gives\n\n$$\nx(2)=cos\\,\\left(\\frac{\\pi (2)}{4}\\right)=cos\\,\\left(\\frac{\\pi }{2}\\right)=0.\n$$\n\n- To find the value of $y(3),$ we substitute $t=3$ into $y=sin\\,\\left(\\frac{\\pi t}{6}\\right).$ This gives\n\n$$\ny(3)=sin\\,\\left(\\frac{\\pi (3)}{6}\\right)=sin\\,\\left(\\frac{\\pi }{2}\\right)=1.\n$$\n\n- To find the value of $y(4),$ we substitute $t=4$ into $y=sin\\,\\left(\\frac{\\pi t}{6}\\right).$ This gives\n\n$$\ny(1)=sin\\,\\left(\\frac{\\pi (4)}{6}\\right)=sin\\,\\left(\\frac{2\\pi }{3}\\right)=\\frac{\\sqrt{3}}{2}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $\\frac{\\sqrt{2}}{2}$ | $0$ | $-\\frac{\\sqrt{2}}{2}$ | $-1$ | $-\\frac{\\sqrt{2}}{2}$ |\n| $y$ | $0$ | $\\frac{1}{2}$ | $\\frac{\\sqrt{3}}{2}$ | $1$ | $\\frac{\\sqrt{3}}{2}$ | $\\frac{1}{2}$ |"}] [{:db/id #edb/ref 17592186302275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cda53e7-8da8-5d86-a98c-5728719bc41b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186300000}] :answer-field/correct {:answer/id #uuid "0cda53e7-8da8-5d86-a98c-5728719bc41b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186300000} :answer-field/id #uuid "926f273e-d8b0-5e4d-9631-40e611c24ed3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301693} {:answer-field/choices [{:answer/id #uuid "25f796a4-f9bc-52c2-95c4-861c28462e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300143}] :answer-field/correct {:answer/id #uuid "25f796a4-f9bc-52c2-95c4-861c28462e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300143} :answer-field/id #uuid "d4c15bfd-ddd4-56df-9248-59fef4cfb8ff" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301912} {:answer-field/choices [{:answer/id #uuid "011fae4e-c40e-5543-bf07-c0c1656584a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186299934}] :answer-field/correct {:answer/id #uuid "011fae4e-c40e-5543-bf07-c0c1656584a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186299934} :answer-field/id #uuid "da7a0f49-5d74-598d-9cc7-a44f9d26dfa4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301928}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9040c3c-4511-5ef7-a719-36ef3ae85af2" :question/math-academy-id "q-326256" :question/problem "Consider the curve with parametric equations\n\n$$\nx=cos\\,\\left(\\frac{\\pi t}{2}\\right),\\,y=tan\\,\\left(\\frac{\\pi t}{3}\\right),\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | {{field-1}} | $0$ | {{field-2}} | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | {{field-3}} | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |" :question/worked-solution "- To find the value of $x(0),$ we substitute $t=0$ into $x=cos\\,\\left(\\frac{\\pi t}{2}\\right).$ This gives\n\n$$\nx(0)=cos\\,\\left(\\frac{\\pi (0)}{2}\\right)=\\operatorname{cos}⁡(0)=1.\n$$\n\n- To find the value of $y(1),$ we substitute $t=1$ into $y=tan\\,\\left(\\frac{\\pi t}{3}\\right).$ This gives\n\n$$\ny(1)=tan\\,\\left(\\frac{\\pi (1)}{3}\\right)=tan\\,\\left(\\frac{\\pi }{3}\\right)=\\sqrt{3}.\n$$\n\n- To find the value of $x(2),$ we substitute $t=2$ into $x=cos\\,\\left(\\frac{\\pi t}{2}\\right).$ This gives\n\n$$\nx(2)=cos\\,\\left(\\frac{\\pi (2)}{2}\\right)=\\operatorname{cos}⁡(\\pi )=-1.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $1$ | $0$ | $-1$ | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |"}] [{:db/id #edb/ref 17592