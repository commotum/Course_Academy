er.type/math} :answer/value "x^{-7} + C" :db/id #edb/ref 17592186062338} {:answer/id #uuid "5d542b13-81e1-5fbb-a906-4a70b720de9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{4/3}}{3} + C" :db/id #edb/ref 17592186062339} {:answer/id #uuid "5e4520ae-938b-5eb0-b58c-c3d7e164cf98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{7} + C" :db/id #edb/ref 17592186062340}] :answer-field/correct {:answer/id #uuid "a28cfe9c-9cdf-5268-9479-19d8fc77278a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^{4/3}}{4} + C" :db/id #edb/ref 17592186062336} :answer-field/id #uuid "cb8ddff3-6382-5212-b6d5-a416c8499d35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062335}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "176b300c-1630-58d7-aef2-06d5bc498dd1" :question/math-academy-id "q-29635" :question/problem "Find the antiderivative of $x^{1/3}$." :question/worked-solution "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int \\sqrt[3]{x}\\,\\mathrm{d}x=\\frac{3x^{4/3}}{4} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{3 x^{\\frac{4}{3}}}{4}+C\\right)=\\sqrt[3]{x}.\n$$"}] [{:db/id #edb/ref 17592186064714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82de502e-7f04-50eb-b76a-0ad3e0f152c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186062342} {:answer/id #uuid "daccb465-7117-5834-9c72-4aff3067b584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{256}" :db/id #edb/ref 17592186062343} {:answ