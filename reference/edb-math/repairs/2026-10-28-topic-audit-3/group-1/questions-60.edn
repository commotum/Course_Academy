orrect {:answer/id #uuid "7306755f-204c-5784-9675-85e4c40d4fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186295896} :answer-field/id #uuid "29935fac-8196-589a-b966-f9c10dd6483e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ea9ad4a-c4e1-5eef-bc95-8f5cd98ebf22" :question/math-academy-id "q-29744" :question/problem "Evaluate  $$\n\\displaystyle {\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x.\n$$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x & =\\frac{{x}^{2+1}}{2+1}{|}_{-5}^{4} \\\\  & =\\frac{{x}^{3}}{3}{|}_{-5}^{4} \\\\  & =\\frac{{4}^{3}}{3}-\\frac{(-5)^{3}}{3} \\\\  & =\\frac{64}{3}+\\frac{125}{3} \\\\  & =63.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6a907ad-e7e6-5e6b-abb5-c41f16606605" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2/3} + C" :db/id #edb/ref 17592186062390} {:answer/id #uuid "dc6a8d1e-0787-5cc4-88df-ddf958e1c1d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x^{-1/3} + C" :db/id #edb/ref 17592186062391} {:answer/id #uuid "16cba4e2-5699-54d0-b0af-01f1431acd0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}x^{5/3} + C" :db/id #edb/ref 17592186062392} {:answer/id #uuid "1b2e4389-0b1c-5925-9f9f-a24ca4b82e65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x^{1/3} + C" :db/id #edb/ref 17592186062393} {:answer/id #uuid "70c4a8d8-2ed6-56b1-a746-7e1fc22b8346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}x^{-1/3} + C" :db/id #edb/ref 17592186062394}] :answer-field/correct {:answer/id #uuid "1b2e4389-0b1c-5925-9f9f-a24ca4b82e65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x^{1/3} + C" :db/id #edb/ref 17592186062393} :answer-field/id #uuid "29757ce8-69c0-518a-9094-1478bb25152b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062389}] :question/id #uuid "35560944-ec26-532a-8ab4-c27135900127" :question/math-academy-id "q-29987" :question/problem "Given that $f(x) = x^{-2/3}$ and that $F^{′}(x) = f(x)$, calculate $F(x)$." :question/worked-solution "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int \\frac{1}{x^{\\frac{2}{3}}}\\,\\mathrm{d}x=3x^{1/3} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(3 \\sqrt[3]{x}+C\\right)=\\frac{1}{x^{\\frac{2}{3}}}.\n$$"}] [{:db/id #edb/ref 17592186064723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af3857a5-22ad-5617-8dd5-fe36c075509e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}x^{3/2} + C" :db/id #edb/ref 17592186062396} {:answer/id #uuid "dc2aaad4-968f-574b-842f-23871805d75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{2/5} + C" :db/id #edb/ref 17592186062397} {:answer/id #uuid "35a1e4d4-ceef-5bb3-8381-e67a3cd0b1b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}x^{5/2} + C" :db/id #edb/ref 17592186062398} {:answer/id #uuid "40c5bb75-6c13-5d38-b5c4-d450f209706c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}x^{2/5} + C" :db/id #edb/ref 17592186062399} {:answer/id #uuid "5eb175d1-16eb-5478-ba97-5cb4d5899d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}x^{2/5} + C" :db/id #edb/ref 17592186062400}] :answer-field/correct {:answer/id #uuid "5eb175d1-16eb-5478-ba97-5cb4d5899d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}x^{2/5} + C" :db/id #edb/ref 17592186062400} :answer-field/id #uuid "4af9582e-4d65-5832-94c1-0ccba896c739" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062395}] :question/id #uuid "4f854a01-0859-5bcc-add9-c9a801f5da45" :question/math-academy-id "q-29989" :question/problem "Given that $f(x) = \\frac{1}{x^{3/5}}$ and that $F^{′}(x) = f(x)$, calculate $F(x)$." :question/worked-solution "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int \\frac{1}{x^{\\frac{3}{5}}}\\,\\mathrm{d}x=\\frac{5}{2}x^{2/5} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{5 x^{\\frac{2}{5}}}{2}+C\\right)=\\frac{1}{x^{\\frac{3}{5}}}.\n$$"}] [{:db/id #edb/ref 17592186064853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6b34ecc-9f61-58a0-8ab5-4d8489f2d734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186063175} {:answer/id #uuid "aa0654d5-83f3-543b-915b-7c6d76ca59c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{96}" :db/id #edb/ref 17592186063176} {:answer/id #uuid "fb0d0fac-71dc-5dd8-b401-ae9a9e7ab5d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186063177} {:answer/id #uuid "2df16ea1-cf65-553c-8c15-010816db6754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{12}" :db/id #edb/ref 17592186063178} {:answer/id #uuid "5e6eb11b-7d07-5e0d-ab5a-8c94acad8ff3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{24}" :db/id #edb/ref 17592186063179}] :answer-field/id #uuid "32caded2-e2dc-5be6-a342-db917828010d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063174}] :question/id #uuid "3139ca36-804e-5e32-966d-d506d33b26b0" :question/math-academy-id "q-49222" :question/problem "What is $$\n\\displaystyle \\int_{1}^{2}\\frac{1}{x^{4}}dx\n$$?"}] [{:db/id #edb/ref 17592186064854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040129f5-5860-5e28-96c3-25abc0be81bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{5}" :db/id #edb/ref 17592186329994} {:answer/id #uuid "11d3a4d3-46d5-5dc7-b02a-bb396b52c2ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{63}{5}" :db/id #edb/ref 17592186330104} {:answer/id #uuid "21ad2cbc-89b6-5aee-80e2-4e034c5fbcea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{5}" :db/id #edb/ref 17592186330237} {:answer/id #uuid "4b8adc42-3352-5c8f-b4ad-24cebaaa370d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{5}" :db/id #edb/ref 17592186330636} {:answer/id #uuid "72a75a15-405b-5dc9-b8f1-252d7e8d3998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{31}{5}" :db/id #edb/ref 17592186330980}] :answer-field/correct {:answer/id #uuid "21ad2cbc-89b6-5aee-80e2-4e034c5fbcea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{5}" :db/id #edb/ref 17592186330237} :answer-field/id #uuid "9369ea04-e34c-540f-b10d-70b9b61cf13d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc083430-0372-5595-9726-2b131aee6b50" :question/math-academy-id "q-49224" :question/problem "Evaluate $$\n\\displaystyle {\\int }_{1/2}^{1}\\frac{1}{{x}^{6}}\\,\\text{d}x.\n$$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{1}\\frac{1}{{x}^{6}}\\,\\text{d}x & ={\\int }_{1/2}^{1}{x}^{-6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-6+1}}{-6+1}{|}_{1/2}^{1} \\\\  & =\\frac{{x}^{-5}}{(-5)}{|}_{1/2}^{1} \\\\  & =-\\frac{1}{5{x}^{5}}{|}_{1/2}^{1} \\\\  & =-\\frac{1}{5}(\\frac{1}{{1}^{5}}-\\frac{1}{{(1/2)}^{5}}) \\\\  & =-\\frac{1}{5}(1-{2}^{5}) \\\\  & =-\\frac{1}{5}(1-32) \\\\  & =\\frac{31}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b31c17dd-24fc-5e67-a120-ad9e45d973c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186063187} {:answer/id #uuid "b73dffef-58fa-5f98-880f-c399356c63b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186063188} {:answer/id #uuid "389b99f1-ec64-51f3-838c-7cda250e09d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186063189} {:answer/id #uuid "40c3aa21-6c88-596a-a489-071e7609f2af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186063190} {:answer/id #uuid "44acc893-d346-5296-a668-0577c4cefcd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186063191}] :answer-field/id #uuid "8f908d35-3e25-561b-ace8-0e7f0f7ee0c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063186}] :question/id #uuid "8e10cbdf-1dbb-522a-8708-e39c28d2c7a8" :question/math-academy-id "q-49228" :question/problem "What is $$\n\\displaystyle \\int_{0}^{1}\\sqrt[5]{x^{3}}dx\n$$?"}] [{:db/id #edb/ref 17592186083054 :question/id #uuid "15c029df-b002-51cc-87db-a94d40a02771" :question/math-academy-id "e-595" :question/problem "For the parametric curve \n\n$$\nx=\\cos{t}, \\quad y=\\sin{t}, \\qquad  0\\leq t<2\\pi,\n$$\n\n calculate $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}.$\n\n![](images/2e/2ec95dd061fa6b7f09c9f899a1f6483b4ea7d5127372ddd6eefb74d6ed10c14c.png)" :question/worked-solution "We will use the formula\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\dfrac{y'(t)}{x'(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\nx'(t) = -\\sin{t}, \\qquad y'(t)=\\cos{t}.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\dfrac{\\cos t}{-\\sin t} = -\\cot t.\n$$"}] [{:db/id #edb/ref 17592186083055 :question/id #uuid "148e5378-9177-59ba-9b1e-3633c940babd" :question/math-academy-id "e-596" :question/problem "For the parametric curve \n\n$$\nx=te^t, \\quad y=e^{-t}, \\qquad -\\infty < t <\\infty,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\dfrac{y'(t)}{x'(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\nx'(t) = e^t + te^t = (1+t)e^t, \\qquad y'(t)=-e^{-t}.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{-{e}^{-t}}{(1+t){e}^{t}} \\\\  & =-\\frac{1}{(1+t){e}^{2t}}.\\end{aligned}\n$$\n\nTherefore, when $t=1,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}{\\frac{dy}{dx}|}_{t=1} & =-\\frac{1}{{e}^{2(1)}(1+1)} \\\\  & =-\\frac{1}{2{e}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083056 :question/id #uuid "879e41c3-7d67-5821-81dc-f6d3fc664ffd" :question/math-academy-id "e-597" :question/problem "Suppose that we have a curve defined by the parametric equations \n\n$$\nx=2t+3, \\quad y=t^3-4t, \\qquad -\\infty < t <\\infty.\n$$\n\nWhat is the equation of the tangent line to the curve at the point where $t=-1?$" :question/worked-solution "First, we find the coordinates of the point by substituting $t=-1$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =2(-1)+3=1, \\\\ y & =(-1)^{3}-4(-1)=-1+4=3.\\end{aligned}\n$$\n\nSo we're looking to find the equation of the tangent line to the curve at the point $(1,3).$ The plot below shows the curve and the tangent line at this point.\n\n![](images/0f/0fa3fc12e83e2a581499680145df9229917c7426e6a3d12c51d88e115a42033e.png)\n\nTo find the slope of the tangent line, we need to find $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}.$ To compute it, we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\nx'(t) = 2, \\qquad y'(t) = 3t^2-4 .\n$$\n\nSo, we have\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\dfrac{y'(t)}{x'(t)} = \\dfrac{3t^2-4}{2}.\n$$\n\nAt the point where $t=-1,$ the slope of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=-1} & =\\frac{3(-1)^{2}-4}{2}=-\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally, to calculate the equation of the tangent line, we use point-slope form with the point $(x_1,y_1) = (1,3)$ and the slope $m=-\\dfrac{1}{2}.$ We get\n\n$$\ny - 3 = -\\frac{1}{2}\\left(x-1\\right).\n$$"}] [{:db/id #edb/ref 17592186083057 :question/id #uuid "db8c5a47-27b8-548d-8bd7-65289cff06da" :question/math-academy-id "e-598" :question/problem "![](images/9d/9dcc4c97bd296ef4627b02b6cfafcdb643f475cd8dacd36a820db760bd6fb045.png)\n\nThe following parametric equations define the curve shown above:\n\n$$\nx=2\\cos{t} +\\sin{2t},\\quad y=\\cos{t} - 2\\sin{2t},\\qquad 0\\leq t<2\\pi\n$$\n\nCalculate the equation of the normal to the curve at the point where $t=\\dfrac{\\pi}{4}$ (shown as a dashed line in the plot above)." :question/worked-solution "First, we find the coordinates of the point by substituting $t=\\dfrac{\\pi}{4}$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =2\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)+\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =2\\cdot \\frac{\\sqrt{2}}{2}+\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =\\sqrt{2}+1, \\\\  \\\\ y & =\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)-2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}-2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =\\frac{\\sqrt{2}}{2}-2(1) \\\\  & =\\frac{\\sqrt{2}}{2}-2.\\end{aligned}\n$$\n\nSo we're looking to find the equation of the normal at the point $\\left(\\sqrt{2}+1,\\dfrac{\\sqrt{2}}{2} -2\\right).$ For this, we need to find $\\dfrac{\\textrm{d}y}{\\textrm{d}x},$ which means we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\nx'(t) = -2\\sin t + 2\\cos 2t, \\qquad y'(t) = -\\sin t - 4 \\cos 2t .\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =\\frac{-\\operatorname{sin}⁡t-4\\operatorname{cos}⁡2t}{-2\\operatorname{sin}⁡t+2\\operatorname{cos}⁡2t} \\\\  & =-\\frac{\\operatorname{sin}⁡t+4\\operatorname{cos}⁡2t}{2(\\operatorname{cos}⁡2t-\\operatorname{sin}⁡t)}.\\end{aligned}\n$$\n\nAt the point where $t=\\dfrac{\\pi}{4},$ the slope $m$ of the tangent line is given by \n\n$$\n\\begin{aligned}m & ={\\frac{dy}{dx}|}_{t=\\pi /4} \\\\  & =-\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)+4\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)}{2(\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right))} \\\\  & =-\\frac{\\frac{1}{2}\\sqrt{2}+4(0)}{2(0-\\frac{1}{2}\\sqrt{2})} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTo find the slope $m_n$ of the normal line, we take the negative reciprocal of $m$:\n\n$$\nm_n = -\\dfrac{1}{m} = -\\dfrac{1}{\\left(\\dfrac{1}{2}\\right)} = -2\n$$\n\nFinally, to calculate the equation of the normal line, we use the point-slope form \n\n$$\ny - y_1 = m_n(x-x_1),\n$$\n\nwith\n\n$$\n(x_1,y_1) = \\left(\\sqrt{2}+1,\\dfrac{\\sqrt{2}}{2} -2\\right), \\qquad m_n=-2,\n$$\n\nand we get\n\n$$\n\\begin{aligned}y-(\\frac{\\sqrt{2}}{2}-2) & =-2(x-(\\sqrt{2}+1)) \\\\ y-\\frac{\\sqrt{2}}{2}+2 & =-2x+2\\sqrt{2}+2 \\\\ y+2x & =\\frac{5\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083074 :question/id #uuid "72076ddb-4a3a-530f-854c-7b1400cd9859" :question/math-academy-id "e-6240" :question/problem "A curve is defined by the parametric equations \n\n$$\nx=t^2+3, \\quad y=-t+1, \\qquad -\\infty <     t <    \\infty.\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is vertical." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm = \\dfrac{y'(t)}{x'(t)}.\n$$\n\nThe tangent line is vertical if $x'(t)=0$ while $y'(t) \\neq 0 .$\n\nSo, we first find the derivatives of $x$ and $y\\mathbin{:}$\n\n$$\nx'(t) = 2t, \\qquad y'(t) = -1 .\n$$\n\nSolving $x'(t) = 0$ gives\n\n$$\n2t=0\\quad\\Longrightarrow\\quad t=0.\n$$\n\nNote that $y'(0) = -1\\neq 0.$ Therefore, we conclude that when $t = 0,$ the tangent to the curve is vertical."}] [{:db/id #edb/ref 17592186083075 :question/id #uuid "b2f8d797-75e8-5ac8-82e7-1c5a9788e6e3" :question/math-academy-id "e-6252" :question/problem "A curve is defined by the parametric equations \n\n$$\nx=2t^3-1,\\quad y=t^2-t+1,\\qquad-\\infty < t <\\infty.\n$$\n\nDetermine the values of $t$ at which the **normal** to the curve is horizontal." :question/worked-solution "The normal is horizontal if the tangent is vertical. Therefore, we require $x'(t)=0$ while $y'(t) \\neq 0.$\n\nSo, we first find the derivatives of $x$ and $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{′}(t)=6{t}^{2},\\,{y}^{′}(t)=2t-1.\\end{aligned}\n$$\n\nSolving $x'(t) = 0$ gives\n\n$$\n6t^2 = 0 \\quad\\Longrightarrow\\quad t = 0.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{y}^{′}(0) & =2\\cdot 0-1=-1\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed horizontal when $t = 0.$"}] [{:db/id #edb/ref 17592186083545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aa64069-1206-5421-8a4f-a6e818653412" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{5}, 0)" :db/id #edb/ref 17592186080166} {:answer/id #uuid "25e79155-ec81-5750-8024-8b85f305474b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{7}{12}, 0)" :db/id #edb/ref 17592186080167} {:answer/id #uuid "287cb0ff-c745-5fe1-847e-2f4eb5158055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{8}, 0)" :db/id #edb/ref 17592186080168} {:answer/id #uuid "52f88dfd-78ed-5cbe-9062-4303b028313d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{4}{7}, 0)" :db/id #edb/ref 17592186080169} {:answer/id #uuid "571c9ee7-eb34-5dec-8694-3d455d4bf27e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{3}, 0)" :db/id #edb/ref 17592186080170}] :answer-field/id #uuid "c1c73154-e807-5407-a20e-cfe049bc0a94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080165}] :question/id #uuid "8def6986-b021-50a6-91db-c2da4068ed38" :question/math-academy-id "q-15558" :question/problem "![](images/d4/d40bd1a54762b360dc590f014d1df9731168f8620df07ee8f0294bd078fc8da5.png)\n\nThe curve shown above is defined by the parametric equations\n$$\n\\displaystyle x = t^{4} + t, y = t^{2}, - ∞ < t < ∞.\n$$\n\nLet $C$ be the point that corresponds to $t =-1$ on the curve. Determine the point at which the normal to the curve at $C$ crosses the $x$-axis."}] [{:db/id #edb/ref 17592186083547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1129c14f-0c46-52c4-9b9a-b4200ce4b285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+1" :db/id #edb/ref 17592186272542} {:answer/id #uuid "5e5faf98-bf15-5a2b-9fdc-09a9a727c6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+2" :db/id #edb/ref 17592186273199} {:answer/id #uuid "5f37ca8d-3ea5-5dc1-85e2-3a3270cb4ca0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186273206} {:answer/id #uuid "7e745226-ecb3-5bd0-91a4-532e194cf6a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+1" :db/id #edb/ref 17592186273471} {:answer/id #uuid "818af87a-0a7b-5074-95df-e9381f58f773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+3" :db/id #edb/ref 17592186273496}] :answer-field/correct {:answer/id #uuid "1129c14f-0c46-52c4-9b9a-b4200ce4b285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+1" :db/id #edb/ref 17592186272542} :answer-field/id #uuid "bb3ec910-ef36-5928-896c-acb859df3e11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274961}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbab7bcf-6a8b-5a33-ae85-61d0acf13fd7" :question/math-academy-id "q-15570" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=\\operatorname{ln}⁡(\\operatorname{sin}⁡t),\\,y=\\frac{1}{\\operatorname{sin}⁡t}\\,,\\,t\\in (0,\\pi ).\n$$\n\nLet $C$ be the point that corresponds to $t=\\frac{\\pi }{2}$ on the curve. Find the equation of the normal to the curve at $C.$" :question/worked-solution "First, we find the coordinates of the point $C$ by substituting $t=\\frac{\\pi }{2}$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =\\operatorname{ln}⁡[\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)]=\\operatorname{ln}⁡1=0, \\\\ y & =\\frac{1}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}=1\\end{aligned}\n$$\n\nSo we're looking to find the equation of the normal at the point $(0,1).$ For this, we need to find $\\frac{\\text{d}y}{\\text{d}x},$ which means we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t},\\,{y}^{′}(t)=-\\frac{\\operatorname{cos}⁡t}{{sin}^{2}⁡t}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =-\\frac{\\operatorname{cos}⁡t}{{sin}^{2}⁡t}\\cdot \\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =-\\frac{1}{\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nAt the point where $t=\\frac{\\pi }{2},$  the slope $m$ of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=\\pi /2} & =-\\frac{1}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}=-1.\\end{aligned}\n$$\n\nTo find the slope ${m}_{n}$ of the normal line, we take the negative reciprocal of $m$:\n\n$$\n{m}_{n}=-\\frac{1}{m}=-\\frac{1}{\\,(-1)\\,}=1\n$$\n\nTo calculate the equation of the normal, we use point-slope form with the point $({x}_{1},{y}_{1})=(0,1)$ and the slope ${m}_{n}=1.$ We get\n\n$$\n\\begin{aligned}y-1 & =1\\cdot (x-0) \\\\ y & =x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04488a59-6ffe-5356-ac3f-e74eeb54d1e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{e}^{5}}{\\sqrt{3}}" :db/id #edb/ref 17592186288061} {:answer/id #uuid "2a8997e3-1fe3-58c6-8171-ece7ebae387b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{5{e}^{4}}{\\sqrt{6}}" :db/id #edb/ref 17592186288312} {:answer/id #uuid "7ed485ea-7355-5812-b046-45c3a1d3e1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{4{e}^{5}}{\\sqrt{2}}" :db/id #edb/ref 17592186288892} {:answer/id #uuid "d60a4cd8-4221-5930-822d-5407abdc3f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}}{\\sqrt{5}}" :db/id #edb/ref 17592186289452} {:answer/id #uuid "f7f5de57-f5aa-5c96-938a-b8c5217f9660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{8{e}^{5}}{\\sqrt{5}}" :db/id #edb/ref 17592186289665}] :answer-field/correct {:answer/id #uuid "f7f5de57-f5aa-5c96-938a-b8c5217f9660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{8{e}^{5}}{\\sqrt{5}}" :db/id #edb/ref 17592186289665} :answer-field/id #uuid "d7251d58-9b9c-5089-ac38-6e385106aa2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290193}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f252b1a9-57b3-57ad-97f5-a61e75b56356" :question/math-academy-id "q-20991" :question/problem "For the parametric curve \n\n$$\nx=\\frac{1}{2\\sqrt{t}},\\,y=\\frac{{e}^{t}}{2t},\\,-\\infty <t<\\infty ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=5.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=-\\frac{1}{4}{t}^{-3/2},\\,{y}^{′}(t)=\\frac{2t{e}^{t}-2{e}^{t}}{4{t}^{2}}=\\frac{{e}^{t}(t-1)}{2{t}^{2}}.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{e}^{t}(t-1)}{2{t}^{2}}\\cdot (-4{t}^{3/2}) \\\\  & =-\\frac{2{e}^{t}(t-1)}{\\sqrt{t}}.\\end{aligned}\n$$\n\nTherefore, when $t=5,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{2{e}^{5}(5-1)}{\\sqrt{5}} \\\\  & =-\\,\\frac{2{e}^{5}\\cdot 4}{\\sqrt{5}} \\\\  & =-\\,\\frac{8{e}^{5}}{\\sqrt{5}}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0735403-c4cc-5f1c-b3f3-f20e814b4e0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439583} {:answer/id #uuid "18c5b8fc-dc2a-5f66-aba9-2fb2139b0e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439584}] :answer-field/correct {:answer/id #uuid "18c5b8fc-dc2a-5f66-aba9-2fb2139b0e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439584} :answer-field/id #uuid "45f84d85-7a93-543f-94bb-a475c80511cd" :answer-field/key "$t=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440149} {:answer-field/choices [{:answer/id #uuid "7325a515-140f-5d60-bed7-46dc88237008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439585} {:answer/id #uuid "76c0b0ff-3576-50aa-ae9a-450fb61d13ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439586}] :answer-field/correct {:answer/id #uuid "76c0b0ff-3576-50aa-ae9a-450fb61d13ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439586} :answer-field/id #uuid "23d3ed3a-04d8-5745-91e6-80f3e4c230a7" :answer-field/key "$t=\\frac{\\pi}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440150} {:answer-field/choices [{:answer/id #uuid "8a631b20-d142-5c85-8a98-edc055f0d25f" :answer/type {:db/id #edb/ref 17592186045499 :