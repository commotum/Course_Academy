f 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439595} {:answer/id #uuid "918a434e-157b-5abc-b419-459e4df7763a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439596}] :answer-field/correct {:answer/id #uuid "918a434e-157b-5abc-b419-459e4df7763a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439596} :answer-field/id #uuid "1bb46a2e-4942-58e0-82e0-10cc738e4275" :answer-field/key "$t=\\frac{3 \\pi}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440155}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbd878d8-e318-5109-beb9-89ecefca7f9d" :question/math-academy-id "q-21081" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=4\\operatorname{sin}⁡t+7,\\,y=4\\operatorname{cos}⁡t+10,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is vertical if ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=4\\operatorname{cos}⁡t,\\,{y}^{′}(t)=-4\\operatorname{sin}⁡t.\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n4\\operatorname{cos}⁡t=0\\,⟹\\,t=\\frac{\\pi }{2},\\frac{3\\pi }{2}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{y}^{′}\\left(\\frac{\\pi }{2}\\right) & =-4\\ne 0, \\\\ {y}^{′}\\left(\\frac{3\\pi }{2}\\right) & =4\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the tangent to the curve is indeed vertical when $t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}.$"}] [{:db/id #edb/ref 17592186083614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ecc25d-c92a-5600-9145-4a0ef2f4de03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 0" :db/id #edb/ref 17592186080748} {:answer/id #uuid "9a1abc77-9bfa-5b8c-b83e-648cc0c2209d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 1" :db/id #edb/ref 17592186080749} {:answer/id #uuid "ce8a2573-0097-5b71-8d97-b01308919ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t =-3" :db/id #edb/ref 17592186080750} {:answer/id #uuid "3790a990-007e-51c6-ac63-c8e6c774c409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t =-1" :db/id #edb/ref 17592186080751} {:answer/id #uuid "54fd89e0-a522-5183-9571-f9c76c9a09ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 3" :db/id #edb/ref 17592186080752}] :answer-field/id #uuid "f7a95819-b401-5a37-808b-da72270a670b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080747}] :question/id #uuid "5d756ec3-8e62-5cb5-9a5c-591a8f7912fb" :question/math-academy-id "q-21206" :question/problem "A curve is defined by the parametric equations\n$$\n\\displaystyle x = t - 1, y = t^{3} - 2, - ∞ < t < ∞.\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is horizontal."}] [{:db/id #edb/ref 17592186083615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0deb773d-8fd3-5717-8d81-b036329021ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186288130} {:answer/id #uuid "2b9ee4d4-6360-5ed2-836d-031b9471868c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{3}" :db/id #edb/ref 17592186288317} {:answer/id #uuid "cebe0140-f0cc-5ccb-ac3d-d23a3bad85d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186289412} {:answer/id #uuid "d5e4345a-11f1-5c37-a93b-12a41d947a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2}" :db/id #edb/ref 17592186289450} {:answer/id #uuid "e4544b18-b948-5075-9873-247a5ee72340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186289547}] :answer-field/correct {:answer/id #uuid "e4544b18-b948-5075-9873-247a5ee72340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186289547} :answer-field/id #uuid "ad14c4bb-1d4a-5d58-9bcb-70314b824013" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad8de0d6-0fb0-5332-a3cd-f5bf44efff31" :question/math-academy-id "q-21207" :question/problem "A curve is defined by the parametric equations\n\n$$\nx={e}^{2t},\\,y={t}^{2},\\,0\\le t\\le 2.\n$$\n\nDetermine the value of the parameter $t$ at which the normal line to the curve is vertical." :question/worked-solution "The normal line is vertical when the tangent to the curve is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=2{e}^{2t},\\,{y}^{′}(t)=2t\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n2t=0\\,⟹\\,t=0.\n$$\n\nNow, we note that\n\n$$\n{x}^{′}(0)=2{e}^{0}=2\\ne 0,\\,\\,\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=0.$"}] [{:db/id #edb/ref 17592186083909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021b2e51-7b32-5d61-854c-fc1a9ef58def" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{5}{3}\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186333007} {:answer/id #uuid "28e9726e-00db-5f34-87d4-9a487ff7e73f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{5}{3}\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186333367} {:answer/id #uuid "580f0635-8c83-5156-8568-562dba7b5e7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{5}{3}\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186333793} {:answer/id #uuid "7d7d169b-2f30-53ff-b665-0cd112f09889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{3}{5}\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186334109} {:answer/id #uuid "b2a39baa-5e77-52ef-9085-55292ea23958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{3}{5}\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186334558}] :answer-field/correct {:answer/id #uuid "021b2e51-7b32-5d61-854c-fc1a9ef58def" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{5}{3}\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186333007} :answer-field/id #uuid "2e1d36e2-933d-5160-bd71-41a68070fc12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e23a09c-558b-5f22-8055-2a530503094c" :question/math-academy-id "q-6731" :question/problem "For the parametric curve \n\n$$\nx=3\\operatorname{sin}⁡\\theta ,\\,y=5\\operatorname{cos}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\n calculate $\\frac{dy}{dx}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(\\theta )=3\\operatorname{cos}⁡\\theta ,\\,{y}^{′}(\\theta )=-5\\operatorname{sin}⁡\\theta .\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{-5\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡\\theta }=-\\frac{5}{3}\\operatorname{tan}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186083910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16dfb55b-8af4-596f-a315-353765522560" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186333194} {:answer/id #uuid "c16a839e-1b3e-54f0-9222-740ef19de000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{2}{3}" :db/id #edb/ref 17592186334665} {:answer/id #uuid "c7d5d8b0-70e4-5f14-b80f-590b782f7d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{2}" :db/id #edb/ref 17592186334729} {:answer/id #uuid "ce913bb5-7127-5bc9-acac-45bf128689d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{3}{\\sqrt{2}}" :db/id #edb/ref 17592186334790} {:answer/id #uuid "e422dcc5-4234-593b-8da3-2f0fe52681a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{3}{2}" :db/id #edb/ref 17592186334976}] :answer-field/correct {:answer/id #uuid "e422dcc5-4234-593b-8da3-2f0fe52681a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{3}{2}" :db/id #edb/ref 17592186334976} :answer-field/id #uuid "7b1e0065-d183-5d46-90dd-110f8b159fa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335474}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a73a45f9-70e6-5c98-9255-49149400966d" :question/math-academy-id "q-6808" :question/problem "![](images/17/1739317bf1b1c567f74dccf5b24a1b1dde8eb101d20ceec9652f604dc6f84543.png)\n\nFor the parametric curve \n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡2t,\\,0\\le t<2\\pi ,\n$$\n\nshown above, calculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{6}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=-4\\operatorname{sin}⁡t,\\,{y}^{′}(t)=6\\operatorname{cos}⁡2t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{6\\operatorname{cos}⁡2t}{-4\\operatorname{sin}⁡t} \\\\  & =-\\frac{3}{2}\\frac{\\operatorname{cos}⁡2t}{\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{6},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}{\\frac{dy}{dx}|}_{t=\\pi /6} & =-\\frac{3}{2}\\frac{\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{6})}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)} \\\\  & =-\\frac{3}{2}\\frac{\\operatorname{cos}⁡\\left(\\frac{\\pi }{3}\\right)}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)} \\\\  & =-\\frac{3}{2}\\frac{\\left(\\frac{1}{2}\\right)}{\\left(\\frac{1}{2}\\right)} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9090bad5-bdc1-57ce-827a-037fa0e55484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot {e}^{5}" :db/id #edb/ref 17592186368636} {:answer/id #uuid "2ad2b68d-5bdb-5b61-8dff-cbfbe61dd5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cdot {e}^{2}" :db/id #edb/ref 17592186368637} {:answer/id #uuid "2cd1dcda-4ea5-5915-b0b1-9f263ce60838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\cdot {e}^{5}" :db/id #edb/ref 17592186368638} {:answer/id #uuid "cd1120e6-0b07-5e9b-9743-a1f6a530953a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{{e}^{5}}" :db/id #edb/ref 17592186368639} {:answer/id #uuid "ece13b9b-8337-58e5-b3c1-7806c09c8d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{{e}^{2}}" :db/id #edb/ref 17592186368640}] :answer-field/correct {:answer/id #uuid "cd1120e6-0b07-5e9b-9743-a1f6a530953a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{{e}^{5}}" :db/id #edb/ref 17592186368639} :answer-field/id #uuid "d7ffb1e1-b6d4-5298-80bc-bfbfec0cbcd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368635}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a00aae7-ab0b-5d69-8218-d506362c55ab" :question/math-academy-id "q-6809" :question/problem "For the parametric curve \n\n$$\nx={e}^{t},\\,y=2{t}^{2},\\,-\\infty <t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=5.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)={e}^{t},\\,{y}^{′}(t)=4t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{4t}{{e}^{t}}.\n$$\n\nAt the point where $t=5$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{4\\cdot 5}{{e}^{5}} \\\\  & =\\frac{20}{{e}^{5}}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f6a1fb9-a35a-5b64-913e-c9df98bccbff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{24}{11}\\,x+\\frac{2}{11}" :db/id #edb/ref 17592186333430} {:answer/id #uuid "53eed6ee-9b5a-505e-be78-f6bb4c4f4050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+2=(x+1)" :db/id #edb/ref 17592186333753} {:answer/id #uuid "7ece2cb0-9b4f-5f1c-8dff-02cde62728ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+2=2(x+1)" :db/id #edb/ref 17592186334120} {:answer/id #uuid "95bef049-706d-5788-8e10-cb68b22507f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+2=2(x+2)" :db/id #edb/ref 17592186334321} {:answer/id #uuid "a6894270-0960-537c-a6f0-979b8b3809d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+2=(x+2)" :db/id #edb/ref 17592186334448}] :answer-field/correct {:answer/id #uuid "7ece2cb0-9b4f-5f1c-8dff-02cde62728ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+2=2(x+1)" :db/id #edb/ref 17592186334120} :answer-field/id #uuid "6ac34767-b922-5f65-a668-1c1e1e6c8f45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335447}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b94e72be-f23a-535e-b719-cf664553611b" :question/math-academy-id "q-6857" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=2{t}^{3}-3t,\\,y=3{t}^{2}-5,\\,-\\infty <t<\\infty .\n$$\n\nCalculate the equation of the tangent to the curve at the point where $t=1.$" :question/requires-calculator true :question/worked-solution "First, we find the coordinates of the point by substituting $t=1$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =2(1)^{3}-3(1)=2-3=-1, \\\\ y & =3(1)^{2}-5=3-5=-2\\,.\\end{aligned}\n$$\n\nSo we're looking to find the equation of the tangent at the point $(-1,-2).$ \n\nTo find the equation of the tangent line, we need to find $\\frac{dy}{dx}.$ To compute it, we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=6{t}^{2}-3,\\,{y}^{′}(t)=6t.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =\\frac{6t}{6{t}^{2}-3}\\,.\\end{aligned}\n$$\n\nAt the point where $t=1,$ the slope of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=1} & =\\frac{6\\cdot 1}{6\\cdot (1)^{2}-3} \\\\  & =\\frac{6}{6-3} \\\\  & =2\\,.\\end{aligned}\n$$\n\nFinally, to calculate the equation of the tangent line, we use point-slope form with the point $({x}_{1},{y}_{1})=(-1,-2)$ and the slope $m=2.$ We get\n\n$$\n\\begin{aligned}y+2 & =2(x+1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f56a41ed-59a1-5429-9c88-30a68cc3b4dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y - 1 =-\\frac{3}{4}(x - 3)" :db/id #edb/ref 17592186082410} {:answer/id #uuid "0a46d561-b2f3-58d4-94a4-01099db3bb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y + 1 =-\\frac{5}{4}(x + 3)" :db/id #edb/ref 17592186082411} {:answer/id #uuid "1068a7ae-c66e-5103-a69c-cd043a388acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y + 1 =-\\frac{5}{4}(x - 3)" :db/id #edb/ref 17592186082412} {:answer/id #uuid "383e37b1-7785-5316-993d-06f2ecc4bf50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y - 1 =-\\frac{5}{2}(x - 3)" :db/id #edb/ref 17592186082413} {:answer/id #uuid "3a3d43fe-583d-5c3c-b161-e97547fb6627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y + 1 = \\frac{5}{4}(x - 3)" :db/id #edb/ref 17592186082414}] :answer-field/id #uuid "dce6874e-77a5-5de0-abb5-e4403a900937" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082409}] :question/id #uuid "c6d49020-9a4a-5e6f-8526-58e27d438cd8" :question/math-academy-id "q-6862" :question/problem "A curve is defined by the parametric equations\n$$\n\\displaystyle x = t^{2} - 2t, y = t^{5}, - ∞ < t < ∞.\n$$\n\nCalculate the equation of the tangent to the curve at the point where $t =-1$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186087518 :question/id #uuid "53ce2176-ae44-578d-8fba-35c5018d4162" :question/math-academy-id "e-5075" :question/problem "For the parametric curve\n\n$$\nx=3t, \\,\\,\\, y=t^3, \\quad -3\\leq t \\leq 3,\n$$\n\nfill in the following table of values.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n" :question/worked-solution "First, we work out the $x$-values using the formula $x=3t.$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$-9$</td>\n<td data-cell-align=\"center\">$-6$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$9$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n\nNow, we work out the $y$-values using $y=t^3.$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$-9$</td>\n<td data-cell-align=\"center\">$-6$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$9$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$-27$</td>\n<td data-cell-align=\"center\">$-8$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$8$</td>\n<td data-cell-align=\"center\">$27$</td>\n</tr>\n</tbody></table></div>\n\n"}] [{:db/id #edb/ref 17592186087522 :question/id #uuid "b322617c-ab21-5ce8-997f-2f10813b4280" :question/math-academy-id "e-5098" :question/problem "Plot the graph of the parametrically defined curve\n\n$$\nx=t(t-6), \\,\\,\\, y=t^3, \\quad -2\\leq t \\leq 2.\n$$" :question/worked-solution "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=t(t-6).$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$16$</td>\n<td data-cell-align=\"center\">$7$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$-5$</td>\n<td data-cell-align=\"center\">$-8$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n\nNow, we work out the $y$ values using $y=t^3.$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$16$</td>\n<td data-cell-align=\"center\">$7$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$-5$</td>\n<td data-cell-align=\"center\">$-8$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$-8$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$8$</td>\n</tr>\n</tbody></table></div>\n\n\nPlotting these points, we obtain the following curve:\n\n![](images/f1/f15f25af0c4804dc811a0ab231ba2ef3ecce2ecd12501a1f2d8b9e34b71a505b.png)"}] [{:db/id #edb/ref 17592186087523 :question/id #uuid "a792fa16-e1fd-5f30-a128-bbc49a285429" :question/math-academy-id "e-5099" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=t^2-6t, \\,\\,\\, y=t^4+4, \\quad t \\in (-\\infty , \\infty),\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}-6t \\\\  & ={(t-3)}^{2}-(3)^{2} \\\\  & ={(t-3)}^{2}-9\\end{aligned}\n$$\n\nSince $\\left( t-3\\right)^2 \\geq 0,$ we can conclude that $x \\geq -9.$\n\n- To find the range of $y=t^4+4,$ notice that $t^4 \\geq 0,$ and consequently $y \\geq 4.$\n\nTherefore, the ranges are $x \\geq -9$ and $y \\geq 4.$"}]}
