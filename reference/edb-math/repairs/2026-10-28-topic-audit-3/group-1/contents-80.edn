dinates"}] [{:db/id #edb/ref 17592186129267 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128844} :knowledge-point/id #uuid "f3688ce9-ceff-524b-ac44-0224526c861b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049084} {:db/id #edb/ref 17592186049694}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186556351} :knowledge-point/questions [{:db/id #edb/ref 17592186129516} {:db/id #edb/ref 17592186129739} {:db/id #edb/ref 17592186367659} {:db/id #edb/ref 17592186367666} {:db/id #edb/ref 17592186367673} {:db/id #edb/ref 17592186367680} {:db/id #edb/ref 17592186427901} {:db/id #edb/ref 17592186427902} {:db/id #edb/ref 17592186555770} {:db/id #edb/ref 17592186555819} {:db/id #edb/ref 17592186555841} {:db/id #edb/ref 17592186556292} {:db/id #edb/ref 17592186556296} {:db/id #edb/ref 17592186556300} {:db/id #edb/ref 17592186556301} {:db/id #edb/ref 17592186556306} {:db/id #edb/ref 17592186556308} {:db/id #edb/ref 17592186556317} {:db/id #edb/ref 17592186556346} {:db/id #edb/ref 17592186556350} {:db/id #edb/ref 17592186565440}] :knowledge-point/title "Rewriting a Triple Integral Defined Over a Cylindrical Solid"}] [{:db/id #edb/ref 17592186129268 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128845} :knowledge-point/id #uuid "aea71b56-dd09-564e-a2bf-5606233e2819" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186537081} :knowledge-point/questions [{:db/id #edb/ref 17592186129517} {:db/id #edb/ref 17592186129519} {:db/id #edb/ref 17592186367722} {:db/id #edb/ref 17592186367729} {:db/id #edb/ref 17592186427905} {:db/id #edb/ref 17592186427906} {:db/id #edb/ref 17592186536983} {:db/id #edb/ref 17592186537003} {:db/id #edb/ref 17592186537006} {:db/id #edb/ref 17592186537019} {:db/id #edb/ref 17592186537025} {:db/id #edb/ref 17592186537027} {:db/id #edb/ref 17592186537040} {:db/id #edb/ref 17592186537047} {:db/id #edb/ref 17592186537048} {:db/id #edb/ref 17592186537052} {:db/id #edb/ref 17592186537058} {:db/id #edb/ref 17592186537064} {:db/id #edb/ref 17592186537066} {:db/id #edb/ref 17592186537072} {:db/id #edb/ref 17592186555773} {:db/id #edb/ref 17592186555811} {:db/id #edb/ref 17592186565439} {:db/id #edb/ref 17592186600830}] :knowledge-point/title "Rewriting a Triple Integral Defined Over a Shifted Cylindrical Solid"}] [{:db/id #edb/ref 17592186129275 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128853} :knowledge-point/id #uuid "de1091c5-d81a-565f-a281-b2fb0d00c973" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186707261} :knowledge-point/questions [{:db/id #edb/ref 17592186129513} {:db/id #edb/ref 17592186129628} {:db/id #edb/ref 17592186278369} {:db/id #edb/ref 17592186278370} {:db/id #edb/ref 17592186278371} {:db/id #edb/ref 17592186351514} {:db/id #edb/ref 17592186394504} {:db/id #edb/ref 17592186394545} {:db/id #edb/ref 17592186394552} {:db/id #edb/ref 17592186436974} {:db/id #edb/ref 17592186543680} {:db/id #edb/ref 17592186543704} {:db/id #edb/ref 17592186543707} {:db/id #edb/ref 17592186543716} {:db/id #edb/ref 17592186543720} {:db/id #edb/ref 17592186543721} {:db/id #edb/ref 17592186543726} {:db/id #edb/ref 17592186706862} {:db/id #edb/ref 17592186706868} {:db/id #edb/ref 17592186706873} {:db/id #edb/ref 17592186707230} {:db/id #edb/ref 17592186707240} {:db/id #edb/ref 17592186707248} {:db/id #edb/ref 17592186707253} {:db/id #edb/ref 17592186707260}] :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Not Centered at the Origin"}] [{:db/id #edb/ref 17592186129278 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128856} :knowledge-point/id #uuid "6ff4534b-6798-5f33-9823-643705229080" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186542431} :knowledge-point/questions [{:db/id #edb/ref 17592186129518} {:db/id #edb/ref 17592186129767} {:db/id #edb/ref 17592186367687} {:db/id #edb/ref 17592186367694} {:db/id #edb/ref 17592186367701} {:db/id #edb/ref 17592186367708} {:db/id #edb/ref 17592186367715} {:db/id #edb/ref 17592186411857} {:db/id #edb/ref 17592186427903} {:db/id #edb/ref 17592186427904} {:db/id #edb/ref 17592186542375} {:db/id #edb/ref 17592186542378} {:db/id #edb/ref 17592186542381} {:db/id #edb/ref 17592186542388} {:db/id #edb/ref 17592186542389} {:db/id #edb/ref 17592186542392} {:db/id #edb/ref 17592186542404} {:db/id #edb/ref 17592186542409} {:db/id #edb/ref 17592186542430} {:db/id #edb/ref 17592186600788}] :knowledge-point/title "Evaluating a Triple Integral by Converting to Cylindrical Coordinates"}] [{:db/id #edb/ref 17592186130404 :tutorial/content "Evaluating double integrals by changing the variables to polar coordinates is often easier than using Cartesian coordinates.\n\nFor example, suppose we want to evaluate the double integral \n\n$$\n\\displaystyle \\iint\\limits_{D}{{\\left( {x^2 + y^2} \\right)\\,\\mathrm d A}},\n$$\n\n \n\nwhere $D$ is the disk with center $(0,0)$ and radius $2,$ shown below.\n\n![](images/94/945f3881b5348fffb922d7b57fb42a6262eb03861fb5aa2411b947a16dcb3b59.png)\n\nThis is a challenging integral to evaluate as it currently stands. However, we should recognize that the problem naturally lends itself to plane polar coordinates because\n\n- the domain $D$ is a disc of radius $2$ centered at $O,$ which has a simple polar representation, and\n\n- the integrand $f(x,y) = x^2+y^2$ can also be expressed simply in polar coordinates.\n\nSo, let's transform the entire problem to polar coordinates using the transformation $\\mathbf T,$ defined by\n\n$$\nx=r\\cos\\theta, \\quad y=r\\sin\\theta.\n$$\n\nThe preimage of $D$ under the action of $\\mathbf T$ is the rectangular region $\\Delta,$ given by \n\n$$\n\\Delta = \\big\\{ (r,\\theta) \\: : \\: 0 \\leq r \\leq 2, \\: 0 \\leq \\theta \\leq 2\\pi \\big\\}.\n$$\n\nThe region $D$ and its preimage $\\Delta$ are shown below.\n\n![](images/99/9901b20d218bef2935dba64612495874d08388dc6d7ae21f8a1de596296bc276.png)\n\n             \n\nTo express our integral in terms of polar coordinates, we will use the **change of variables formula,** given by\n\n$$\n\\iint\\limits_{D} f(x,y) \\, {{\\color{black}{\\mathrm d A}}} = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  {{\\color{black}{r \\ \\mathrm d r \\mathrm d \\theta}}}.\n$$\n\nWhen expressing our integral in polar coordinates, we must write \n\n$$\n{\\color{black}{\\textrm d A}} = {\\color{black}{r\\,\\textrm d r\\textrm d \\theta}}.\n$$\n\nIt's important not to forget the extra factor of $r.$\n\nNow, applying the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}+{y}^{2})\\,dA & ={∬}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}\\,dr\\,d\\theta .\\end{aligned}\n$$\n\nEvaluating the integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}\\,dr\\,d\\theta  & ={\\int }_{0}^{2\\pi }\\text{d}\\theta {\\int }_{0}^{2}{r}^{3}\\,dr \\\\  & =2\\pi \\cdot {\\int }_{0}^{2}{r}^{3}\\,dr \\\\  & =2\\pi \\cdot 4 \\\\  & =8\\pi .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\displaystyle \\iint\\limits_{D}{{\\left( {x^2 + y^2} \\right)\\,\\mathrm d A}} = 8\\pi.\n$$\n\nIn terms of transformations, the change of variables formula maps the non-rectangular integration domain $D$ to the rectangular domain $\\Delta,$ making the integral much easier to evaluate." :tutorial/id #uuid "075c6789-1ae6-51fa-a4f4-f4a2d7ea1459" :tutorial/math-academy-id 4433 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186130406 :tutorial/content "Let's get a little more practice at writing regions in polar coordinates.\n\nConsider the semicircular disc of radius $1$ centered $(1,0)$ in the first quadrant, shown below. The equation of the curve is $y=\\sqrt{2x-x^2}.$\n\n![](images/0f/0f4aec039a0de31d8f5ea24dc9db8c83f236dfd66e9f181768dae45ab0fd6b07.png)\n\nFirst, we recall that the following equations relate Cartesian and polar coordinates:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nLet's now use the above formulas to write the function $y=\\sqrt{2x-x^2}$ in polar coordinates:\n\n$$\n\\begin{aligned}y & =\\sqrt{2x-{x}^{2}} \\\\ {y}^{2} & =2x-{x}^{2} \\\\ {x}^{2}+{y}^{2} & =2x \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r = 2\\cos\\theta.$\n\nNow, let's determine the limits for $r$ and $\\theta.$ First of all, $r$ can vary from $r=0$ (at the origin) to $r=2\\cos\\theta$ (at the boundary of the region): \n\n![](images/35/3584d2f0d9ee2c0ce469bfc117c67c1efd1f4fd08c96c7beef00198624977d06.png)\n\nSecondly, $\\theta$ can vary between $\\theta=0$ (the positive $x$-axis) and $\\theta=\\dfrac{\\pi}{2}$ (the positive $y$-axis):\n\n![](images/2c/2c5731478941621db03e8949eac217dcdfc604b3efd0312b56c59b9874d6be98.png)\n\nTherefore, in polar coordinates $(r, \\theta),$ the region can be expressed as \n\n$$\n\\Delta = \\Big\\{ (r,\\theta) \\: : \\: 0 \\leq r \\leq 2\\cos\\theta, \\: 0 \\leq \\theta \\leq \\dfrac{\\pi}{2} \\Big\\}.\n$$" :tutorial/id #uuid "04773792-9fe9-5ca8-8434-752f43db5fd7" :tutorial/math-academy-id 4454 :tutorial/title "Writing More Complex Regions in Polar Coordinates"}] [{:db/id #edb/ref 17592186130456 :tutorial/content "We can evaluate triple integrals by changing the variables to cylindrical polar coordinates.\n\nFor example, suppose we want to evaluate the triple integral\n\n$$\n\\displaystyle \\iiint\\limits_R x^2 + y^2 \\:\\textrm{d}V\n$$\n\nwhere $R$ is the finite region enclosed between the surfaces $z =0$ and $z = 1 - x^2 - y^2,$ as shown below.\n\n![](images/a6/a63e349d2776fe07077379b9d603e32ad2ff264cfa8005a226422b44f7e100fe.png)\n\n \n\nThis is a challenging integral to evaluate as it currently stands. However, we should recognize that the problem naturally lends itself to cylindrical polar coordinates.\n\nRecall that if $(r, \\theta, z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx = r\\cos\\theta, \\qquad\ny = r\\sin\\theta, \\qquad \nz = z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/b2/b2f8a6fe7f21b062eec294522e411c1e471b564eae68763d4767f917d65b54b0.png)\n\nNotice that the region $R$ is\n\n- bounded below by $z = 0,$ and\n\n- bounded above by $z = 1 - x^2 - y^2 = 1 - r^2.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\Delta = \\left\\{ (r,\\theta,z) \\, : \\, 0 \\leq r \\leq 1, \\: 0 \\leq \\theta \\lt 2\\pi, \\: 0 \\leq z \\leq 1-r^2 \\right\\}.\n$$\n\n![](images/da/dae76df462a695e655ffdde01559d19bf245aa6d601100fb8c7bc1024106a4c8.png)\n\n \n\nTo express our integral in terms of cylindrical polar coordinates, we will use the change of variables formula, given by\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\, {\\color{blue}\\mathrm{d}V} = \n\\iiint\\limits_{\\Delta} \\, f(r \\cos\\theta, r\\sin\\theta, z) \\:  {\\color{blue}r \\: \\mathrm{d}z \\, \\mathrm{d}r \\, \\mathrm{d}\\theta}.\n$$\n\nWhen expressing our integral in cylindrical polar coordinates, we must write \n\n$$\n{\\color{blue}{\\textrm{d}V}} = {\\color{blue}r \\: \\mathrm{d}z \\, \\mathrm{d}r \\, \\mathrm{d}\\theta}.\n$$\n\nIt's important not to forget the extra factor of ${\\color{blue}{r}}.$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{\\int }_{0}^{1-{r}^{2}}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nEvaluating this integral using the usual methods, we get\n\n$$\n\\int_{0}^{2\\pi} \\int_{0}^{\\bbox[2pt,white]{\\color{black}1}} \\int_{0}^{\\bbox[2pt,white]{\\color{black}1 - r^2 }} \\bbox[2pt,white]{\\color{black} r^3} \\: \\mathrm{d}z \\: \\textrm{d}r \\: \\textrm{d}\\theta\n=\n\\dfrac{\\pi}{6}\n$$\n\nTherefore, we conclude that\n\n$$\n\\displaystyle \\iiint\\limits_R x^2 + y^2 \\:\\textrm{d}V = \\dfrac{\\pi}{6}.\n$$" :tutorial/id #uuid "c6d9a5c4-532b-53e1-9689-7b5dbc30ec98" :tutorial/math-academy-id 7193 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186130470 :tutorial/content "Let's now build some intuition behind the meaning of the volume element $\\textrm d V.$ This will help us to understand the change of variables formula in cylindrical polar coordinates. We start by considering the usual rectangular coordinate system.\n\nSuppose we have a point $P$ and a neighboring point $Q$ in the Cartesian $xyz$-space, as shown below. \n\n![](images/25/2535744585beb7fed89d760c0290a04f54d0a08c8f7e564b17c8e42432da031e.png)\n\n \n\nImagine moving from $P$ to $Q$ as follows:\n\n- First, we move a distance $\\textrm d x$ parallel to the $x$-axis so that the new point $P'$ has the same $x$-coordinate as $Q.$\n\n- Then, we move a distance $\\textrm d y$ parallel to the $y$-axis so that the new point $P''$ has the same $y$-coordinate as $Q.$\n\n- Finally, we move a distance $\\textrm d z$ parallel to the $z$-axis to land to $Q.$\n\nThese movements span the rectangular solid shown above. The volume of this solid, denoted $\\textrm d V,$ is given by\n\n$$\n\\mathrm{d}V = \\mathrm{d}x \\, \\mathrm{d}y \\, \\mathrm{d}z.\n$$\n\nThus, the element $\\textrm d V$ represents the volume generated by moving from the point $P$ to the point $Q$ in this coordinate system." :tutorial/id #uuid "82dc2175-bfda-5b86-bba2-acb36d6cd7ef" :tutorial/math-academy-id 7731 :tutorial/title "Deriving the Volume Element in Cartesian Coordinates"}] [{:db/id #edb/ref 17592186130473 :tutorial/content "Let's now repeat this process for a cylindrical polar system. Consider the points $P$ and $Q$ shown below.\n\n![](images/24/243d720546357a33eac3f96b84755cf6aeebafdef3a3672a3d29989147f134c2.png)\n\n \n\nImagine moving from $P$ to $Q$ as follows:\n\n- First, we move a distance $\\textrm d r$ so that the new point $P'$ has the same $r$-coordinate as $Q.$\n\n- Then, we sweep through an angle $\\textrm d \\theta$ so that the new point $P''$ has the same $\\theta$-coordinate as $Q.$ The arc length traced out by this movement approximately equals $r\\,\\textrm d \\theta.$\n\n- Finally, we move a distance $\\textrm d z$ vertically to land on $Q.$\n\nThese three movements trace out a solid that's approximately rectangular, and so the approximate volume of this solid is given by\n\n$$\n\\mathrm{d}V = \\mathrm{d}r \\cdot r\\,\\mathrm{d}\\theta \\cdot \\mathrm{d}z=  r\\,\\mathrm{d}z\\,\\mathrm{d}r \\, \\mathrm{d}\\theta.\n$$" :tutorial/id #uuid "0a132073-0472-5027-b85c-8d1bed6673d3" :tutorial/math-academy-id 7772 :tutorial/title "Deriving the Volume Element in Cylindrical Polar Coordinates"}] [{:db/id #edb/ref 17592186133876 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133692} :knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707} {:db/id #edb/ref 17592186048954}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186721111} :knowledge-point/questions [{:db/id #edb/ref 17592186134066} {:db/id #edb/ref 17592186134368} {:db/id #edb/ref 17592186235522} {:db/id #edb/ref 17592186235529} {:db/id #edb/ref 17592186241078} {:db/id #edb/ref 17592186259485} {:db/id #edb/ref 17592186266054} {:db/id #edb/ref 17592186266055} {:db/id #edb/ref 17592186362533} {:db/id #edb/ref 17592186383034} {:db/id #edb/ref 17592186383244} {:db/id #edb/ref 17592186383251} {:db/id #edb/ref 17592186424226} {:db/id #edb/ref 17592186424229} {:db/id #edb/ref 17592186519739} {:db/id #edb/ref 17592186519742} {:db/id #edb/ref 17592186519747} {:db/id #edb/ref 17592186519751} {:db/id #edb/ref 17592186519754} {:db/id #edb/ref 17592186519760} {:db/id #edb/ref 17592186720486} {:db/id #edb/ref 17592186720491} {:db/id #edb/ref 17592186720497} {:db/id #edb/ref 17592186721082} {:db/id #edb/ref 17592186721083} {:db/id #edb/ref 17592186721088} {:db/id #edb/ref 17592186721093} {:db/id #edb/ref 17592186721098}] :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] [{:db/id #edb/ref 17592186133877 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133693} :knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707} {:db/id #edb/ref 17592186049132}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186703980} :knowledge-point/questions [{:db/id #edb/ref 17592186134370} {:db/id #edb/ref 17592186134371} {:db/id #edb/ref 17592186235539} {:db/id #edb/ref 17592186241107} {:db/id #edb/ref 17592186241111} {:db/id #edb/ref 17592186266075} {:db/id #edb/ref 17592186382847} {:db/id #edb/ref 17592186383258} {:db/id #edb/ref 17592186383265} {:db/id #edb/ref 17592186383272} {:db/id #edb/ref 17592186385913} {:db/id #edb/ref 17592186535415} {:db/id #edb/ref 17592186535416} {:db/id #edb/ref 17592186699606} {:db/id #edb/ref 17592186699610} {:db/id #edb/ref 17592186699615} {:db/id #edb/ref 17592186699941} {:db/id #edb/ref 17592186699942} {:db/id #edb/ref 17592186699955} {:db/id #edb/ref 17592186699958} {:db/id #edb/ref 17592186699961} {:db/id #edb/ref 17592186703952} {:db/id #edb/ref 17592186703956} {:db/id #edb/ref 17592186703962} {:db/id #edb/ref 17592186703967}] :knowledge-point/title "Calculating the Curl of a Vector Field"}] [{:db/id #edb/ref 17592186133880 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133696} :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048917}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186720862} :knowledge-point/questions [{:db/id #edb/ref 17592186134061} {:db/id #edb/ref 17592186134067} {:db/id #edb/ref 17592186240974} {:db/id #edb/ref 17592186241079} {:db/id #edb/ref 17592186241080} {:db/id #edb/ref 17592186241081} {:db/id #edb/ref 17592186241082} {:db/id #edb/ref 17592186259500} {:db/id #edb/ref 17592186266062} {:db/id #edb/ref 17592186266063} {:db/id #edb/ref 17592186382826} {:db/id #edb/ref 17592186407631} {:db/id #edb/ref 17592186424227} {:db/id #edb/ref 17592186424228} {:db/id #edb/ref 17592186483360} {:db/id #edb/ref 17592186483395} {:db/id #edb/ref 17592186720811} {:db/id #edb/ref 17592186720820} {:db/id #edb/ref 17592186720821} {:db/id #edb/ref 17592186720846} {:db/id #edb/ref 17592186720850} {:db/id #edb/ref 17592186720866}] :knowledge-point/title "Interpreting Divergence"}]}
