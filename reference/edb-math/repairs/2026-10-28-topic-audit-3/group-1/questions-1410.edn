0447-5a17-bf21-48715365e680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186526237}] :answer-field/correct {:answer/id #uuid "25ed0f43-0447-5a17-bf21-48715365e680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186526237} :answer-field/id #uuid "e516f195-da67-5121-a29d-657d6b1f9add" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186526288} {:answer-field/choices [{:answer/id #uuid "305b10fa-f803-573a-bba3-75366dbe949a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186526242}] :answer-field/correct {:answer/id #uuid "305b10fa-f803-573a-bba3-75366dbe949a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186526242} :answer-field/id #uuid "f7d76b33-a9f1-5ee2-9b71-3cea4684cb9c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186526290}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7d660fed-4267-5819-940b-873cd45ce332" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=-\\frac{1}{4}\\operatorname{cos}\\theta +\\frac{7}{3},\\,y=-\\frac{1}{3}\\operatorname{sin}\\theta -\\frac{5}{3},\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$\n\nThe range of $x$ is {{field-1}}{{field-2}}$x\\le ${{field-3}}.\n\nThe range of $y$ is {{field-4}}$\\le y${{field-5}}{{field-6}}." :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi,$ we have $-1\\le \\operatorname{cos}\\theta\\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}\\theta \\le 1 \\\\ \\frac{1}{4} & \\text{ }\\ge -\\frac{1}{4}\\operatorname{cos}\\theta \\text{ }\\ge -\\frac{1}{4} \\\\ -\\frac{1}{4} & \\le -\\frac{1}{4}\\operatorname{cos}\\theta \\le \\frac{1}{4} \\\\ -\\frac{1}{4}+\\frac{7}{3} & \\le -\\frac{1}{4}\\operatorname{cos}\\theta +\\frac{7}{3}\\le \\frac{1}{4}+\\frac{7}{3} \\\\ \\frac{25}{12} & \\le x\\le \\frac{31}{12}.\\end{aligned}\n$$\n\nSo, we can conclude that $\\frac{25}{12}\\le x\\le \\frac{31}{12}.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi,$ we have $-1\\le \\operatorname{sin}\\theta\\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}\\theta \\le 1 \\\\ \\frac{1}{3} & \\text{ }\\ge -\\frac{1}{3}\\operatorname{sin}\\theta \\text{ }\\ge -\\frac{1}{3} \\\\ -\\frac{1}{3} & \\le -\\frac{1}{3}\\operatorname{sin}\\theta \\le \\frac{1}{3} \\\\ -\\frac{1}{3}-\\frac{5}{3} & \\le -\\frac{1}{3}\\operatorname{sin}\\theta -\\frac{5}{3}\\le \\frac{1}{3}-\\frac{5}{3} \\\\ -2 & \\le y\\le -\\frac{4}{3}.\\end{aligned}\n$$\n\nSo, we can conclude that $-2\\le y\\le -\\frac{4}{3}.$"}]}
