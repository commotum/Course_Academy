i }{4})\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n4\\operatorname{cos}⁡(t-\\frac{\\pi }{4})=0\\,⟹\\,t=\\frac{3\\pi }{4},\\frac{7\\pi }{4}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{3\\pi }{4}\\right) & =-5\\ne 0, \\\\ {x}^{′}\\left(\\frac{7\\pi }{4}\\right) & =5\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\frac{3\\pi }{4}$ and $t=\\frac{7\\pi }{4}.$"}] [{:db/id #edb/ref 17592186523079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8fb29d2-3496-55af-83fd-601b30be6313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{3}" :db/id #edb/ref 17592186523082}] :answer-field/correct {:answer/id #uuid "d8fb29d2-3496-55af-83fd-601b30be6313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{3}" :db/id #edb/ref 17592186523082} :answer-field/id #uuid "64162304-9344-5df1-b9e3-4a3a21b55152" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523043} {:answer-field/choices [{:answer/id #uuid "b0dc50dc-6e5f-5e29-b38d-35a18468bf05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\pi}{3}" :db/id #edb/ref 17592186523066}] :answer-field/correct {:answer/id #uuid "b0dc50dc-6e5f-5e29-b38d-35a18468bf05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\pi}{3}" :db/id #edb/ref 17592186523066} :answer-field/id #uuid "755a7257-06aa-5732-848d-a011d573f0af" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523047} {:answer-field/choices [{:answer/id #uuid "c8f1623e-d926-53e5-a41f-078d76bb481e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\pi}{6}" :db/id #edb/ref 17592186523075}] :answer-field/correct {:answer/id #uuid "c8f1623e-d926-53e5-a41f-078d76bb481e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\pi}{6}" :db/id #edb/ref 17592186523075} :answer-field/id #uuid "be0fe85f-e4cc-5de6-a4f4-7cd49e1580b3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523070} {:answer-field/choices [{:answer/id #uuid "70d934a4-6ab3-58c9-b769-31b2a21b7404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{6}" :db/id #edb/ref 17592186523045}] :answer-field/correct {:answer/id #uuid "70d934a4-6ab3-58c9-b769-31b2a21b7404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{6}" :db/id #edb/ref 17592186523045} :answer-field/id #uuid "d6fae7dc-2035-5c36-a249-17ced611b26c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523081}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cc496cc2-5b68-5fb6-ab6a-0e20b6873203" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=2\\cos(2t-\\frac{\\pi}{6})-10,\\,y=1\\sin(2t-\\frac{\\pi}{6})+0,\\,\\frac{3\\pi}{2}\\le t<\\frac{7\\pi}{2}.\n$$\n\nDetermine the values of $t$ at which the normal to the curve is vertical. Give exact answers in ascending order.\n\n$t=$\n{{field-1}}, $t=$\n{{field-2}}, $t=$\n{{field-3}}, $t=$\n{{field-4}}." :question/worked-solution "The normal is vertical if the tangent is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=-4\\sin(2t-\\frac{\\pi}{6}),\\,{y}^{′}(t)=2\\cos(2t-\\frac{\\pi}{6})\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n2\\cos(2t-\\frac{\\pi}{6})=0\\,⟹\\,t=\\frac{11\\pi}{6}, \\frac{7\\pi}{3}, \\frac{17\\pi}{6}, \\frac{10\\pi}{3}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{11\\pi}{6}\\right) & =4\\ne 0, \\\\ {x}^{′}\\left(\\frac{7\\pi}{3}\\right) & =-4\\ne 0, \\\\ {x}^{′}\\left(\\frac{17\\pi}{6}\\right) & =4\\ne 0, \\\\ {x}^{′}\\left(\\frac{10\\pi}{3}\\right) & =-4\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $$\n\\displaystyle t=\\frac{11\\pi}{6}, \\frac{7\\pi}{3}, \\frac{17\\pi}{6}, \\frac{10\\pi}{3}.\n$$"}] [{:db/id #edb/ref 17592186523083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d66d1357-e0d7-58c9-a48f-bd62562836f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186523080}] :answer-field/correct {:answer/id #uuid "d66d1357-e0d7-58c9-a48f-bd62562836f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186523080} :answer-field/id #uuid "20ef8185-3b01-5cc2-a040-a6ce07a57c3b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523027} {:answer-field/choices [{:answer/id #uuid "396284fb-66e1-5043-b407-7357db7c21ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186523036}] :answer-field/correct {:answer/id #uuid "396284fb-66e1-5043-b407-7357db7c21ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186523036} :answer-field/id #uuid "4e4eda86-0324-54cf-b300-9a498fb8794e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da8bb941-6503-5014-b798-77c51b79d5e5" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=6\\operatorname{cos}⁡(t-\\frac{\\pi }{6})+11,\\,y=6\\operatorname{sin}⁡(t-\\frac{\\pi }{6})-1,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the normal to the curve is vertical. Give exact answers.\n\nIn **ascending order**, the normal to the curve is vertical at $t=$\n{{field-1}}\nand $t=$\n{{field-2}}." :question/worked-solution "The normal is vertical if the tangent is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=-6\\operatorname{sin}⁡(t-\\frac{\\pi }{6}),\\,{y}^{′}(t)=6\\operatorname{cos}⁡(t-\\frac{\\pi }{6})\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n6\\operatorname{cos}⁡(t-\\frac{\\pi }{6})=0\\,⟹\\,t=\\frac{2\\pi }{3},\\frac{5\\pi }{3}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{x}^{′}\\left(\\frac{2\\pi }{3}\\right) & =-6\\ne 0, \\\\ {x}^{′}\\left(\\frac{5\\pi }{3}\\right) & =6\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\frac{2\\pi }{3}$ and $t=\\frac{5\\pi }{3}.$"}] [{:db/id #edb/ref 17592186523089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d337060-1e09-500e-a725-817b12e948cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\sqrt{2}" :db/id #edb/ref 17592186523023} {:answer/id #uuid "4c24db76-c425-5c85-8ebb-d6b5749020ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186523040} {:answer/id #uuid "a7936598-9d1f-55c4-9dd9-7abc95040343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{4}" :db/id #edb/ref 17592186523060} {:answer/id #uuid "bb44dca9-460c-5f8e-a9be-d5ddfc0acf26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-1" :db/id #edb/ref 17592186523068} {:answer/id #uuid "c509673f-074a-50e2-8f60-18ed364b8a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186523074}] :answer-field/correct {:answer/id #uuid "c509673f-074a-50e2-8f60-18ed364b8a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186523074} :answer-field/id #uuid "afcde732-d4fd-5d99-bec4-a5da89e670fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523065}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee8bc31a-d21a-5520-b1c9-d397836ee8dd" :question/problem "A curve is defined by the parametric equations\n\n$$\nx={e}^{5t},\\,y=4{t}^{2}-8t,\\,0\\le t\\le 2.\n$$\n\nDetermine the value of the parameter $t$ at which the normal line to the curve is vertical." :question/worked-solution "The normal line is vertical when the tangent to the curve is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=5{e}^{5t},\\,{y}^{′}(t)=8t-8\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n8t-8=0\\,⟹\\,t=1.\n$$\n\nNow, we note that\n\n$$\n{x}^{′}(1)=5{e}^{5}=5 e^{5}\\ne 0,\\,\\,\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=1.$"}] [{:db/id #edb/ref 17592186524983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc8d190d-9c67-5acd-8583-f14a36220ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524684}] :answer-field/correct {:answer/id #uuid "bc8d190d-9c67-5acd-8583-f14a36220ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524684} :answer-field/id #uuid "f05471f2-c115-5266-86b4-2c4bebd70c45" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45936e93-e188-5489-9cc9-795dad15e0d6" :question/math-academy-id "q-342792" :question/problem "The slope of the tangent to the curve $y=\\sqrt{3{x}^{2}+2x}$ at the point where $x=-1$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+2x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x+2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (6x+2) \\\\  & =\\frac{6x+2}{2\\sqrt{3{x}^{2}+2x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-1,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} & ={\\left(\\frac{6x+2}{2\\sqrt{3{x}^{2}+2x}}\\right)|}_{x=-1} \\\\  & =\\frac{6(-1)+2}{2\\sqrt{3(-1)^{2}+2(-1)}} \\\\  & =\\frac{-4}{2\\sqrt{1}} \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e53a687-845e-5e38-b650-cd7d2e960b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "192" :db/id #edb/ref 17592186524465} {:answer/id #uuid "4c87e60d-6195-503b-b8b0-645b9615d373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "384" :db/id #edb/ref 17592186524511} {:answer/id #uuid "92b0203b-17bf-5bcc-b180-500fc847f62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3,072" :db/id #edb/ref 17592186524613} {:answer/id #uuid "ca95a77f-004b-588b-8c88-365d7dedd455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "768" :db/id #edb/ref 17592186524712} {:answer/id #uuid "de1da834-e484-5065-82b1-ac2bfe5f309a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "758" :db/id #edb/ref 17592186524761}] :answer-field/correct {:answer/id #uuid "4c87e60d-6195-503b-b8b0-645b9615d373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "384" :db/id #edb/ref 17592186524511} :answer-field/id #uuid "4a15449d-4ef5-5450-8663-fb7daf5af1c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524872}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a24feddb-3c6c-5b5d-be09-ecb6ef41d845" :question/math-academy-id "q-48622" :question/problem "Given that $f(x)=(3{x}^{2}-10)^{4},$ find the slope at the point $(2,16).$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{4},\\,g=3{x}^{2}-10\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4{g}^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=6x.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4{g}^{3}\\cdot (6x) \\\\  & =24x(3{x}^{2}-10)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=2} & ={24x{(3{x}^{2}-10)}^{3}|}_{x=2} \\\\  & =24(2){(3(2)^{2}-10)}^{3} \\\\  & =384.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d03176f-6a68-5c3e-819d-54b936231531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186526259}] :answer-field/correct {:answer/id #uuid "7d03176f-6a68-5c3e-819d-54b936231531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186526259} :answer-field/id #uuid "0da4c880-98a1-5c55-908d-0a45fe479fee" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186526231} {:answer-field/choices [{:answer/id #uuid "06cff5da-b7ec-5b7e-9a40-a2efbc4700ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{21}{4}" :db/id #edb/ref 17592186526230}] :answer-field/correct {:answer/id #uuid "06cff5da-b7ec-5b7e-9a40-a2efbc4700ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{21}{4}" :db/id #edb/ref 17592186526230} :answer-field/id #uuid "297979ad-5ff2-5f98-9eb9-7273ab6e6d0f" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186526238} {:answer-field/choices [{:answer/id #uuid "29cd1796-9ae0-59d4-98d8-bed4892ecf3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186526239}] :answer-field/correct {:answer/id #uuid "29cd1796-9ae0-59d4-98d8-bed4892ecf3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186526239} :answer-field/id #uuid "32bc20ce-ced4-51b1-b750-6273578695fb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/b