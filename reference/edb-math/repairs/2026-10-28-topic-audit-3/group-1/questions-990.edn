#{[{:db/id #edb/ref 17592186375881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a1587c4-9d0f-5874-b597-b96e8fe422bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186375883} {:answer/id #uuid "c40050eb-c24c-5426-9ca1-fc5cf33f5a48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186375884} {:answer/id #uuid "307bfac9-d7ec-5af2-b921-9ec97d829389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186375885} {:answer/id #uuid "e3b67dcf-ab20-5272-abc3-398f83959743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186375886} {:answer/id #uuid "86c30e13-f1bc-52ce-8f61-25eb3725018a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186375887}] :answer-field/correct {:answer/id #uuid "e3b67dcf-ab20-5272-abc3-398f83959743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186375886} :answer-field/id #uuid "15067215-9cdf-53aa-a3e5-7a5786a9ef37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375882}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24624711-0ccb-53fa-a9ec-57cc06e73cae" :question/math-academy-id "q-128349" :question/problem "Find $c\\cdot (b\\times a),$ if $2a\\cdot ((-3b)\\times c)=10.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot ((-3b)\\times c) & =10 \\\\ 2\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =10 \\\\ a\\cdot (b\\times c) & =-\\frac{5}{3}.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =\\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33526b37-cab0-5457-9e07-446f0c05aa08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}(x-9)(x-3)" :db/id #edb/ref 17592186377042}] :answer-field/correct {:answer/id #uuid "33526b37-cab0-5457-9e07-446f0c05aa08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}(x-9)(x-3)" :db/id #edb/ref 17592186377042} :answer-field/id #uuid "e36531d7-495c-5197-b612-e0e22cd3b3b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22eb775d-0ea8-57a9-a014-0d8618741de6" :question/math-academy-id "q-276278" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=2t+5,\\,\\,\\,y=(t-2)(t+1),\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=2t+5\\,⇒\\,t=\\frac{x-5}{2}\\end{aligned}\n$$\n\nNow, substituting $t=\\frac{x-5}{2}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =(\\frac{x-5}{2}-2)(\\frac{x-5}{2}+1) \\\\  & =\\left(\\frac{x-5-4}{2}\\right)\\left(\\frac{x-5+2}{2}\\right) \\\\  & =\\left(\\frac{x-9}{2}\\right)\\left(\\frac{x-3}{2}\\right) \\\\  & =\\frac{1}{4}(x-9)(x-3).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bd440d4-c275-536e-bec5-a4b90d66bc1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186377078}] :answer-field/correct {:answer/id #uuid "0bd440d4-c275-536e-bec5-a4b90d66bc1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186377078} :answer-field/id #uuid "d1fb31f8-7ebd-50f5-9d92-ee287a39ccbe" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77a13127-37ab-53ba-baec-4cca7e404b6d" :question/math-academy-id "q-317321" :question/problem "Let $a=⟨0,2,1⟩$, $b=⟨2,0,3⟩$ and $c=⟨1,4,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}0 & 2 & 1 \\\\ 2 & 0 & 3 \\\\ 1 & 4 & 5\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}0 & 3 \\\\ 4 & 5\\end{vmatrix}\\,-\\,2\\cdot \\begin{vmatrix}2 & 3 \\\\ 1 & 5\\end{vmatrix}\\,+\\,1\\cdot \\begin{vmatrix}2 & 0 \\\\ 1 & 4\\end{vmatrix} \\\\  & =0\\,(0\\cdot 5-3\\cdot 4)\\,-\\,2\\,(2\\cdot 5-3\\cdot 1)\\,+\\,1\\,(2\\cdot 4-0\\cdot 1) \\\\  & =0(-12)\\,-\\,2\\,(7)\\,+\\,1\\,(8) \\\\  & =0-14+8 \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0070937c-5409-5c36-8ffd-87f8467c86bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186377081}] :answer-field/correct {:answer/id #uuid "0070937c-5409-5c36-8ffd-87f8467c86bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186377081} :answer-field/id #uuid "d48f364f-43df-59e1-834a-2f878b9a055a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e27b4a37-63ac-546c-b079-a486976f0966" :question/math-academy-id "q-317332" :question/problem "Find $a\\cdot (c\\times b)$, if $-3a\\cdot ((-2b)\\times (7c))=168.$\n\n$a\\cdot (c\\times b)=$\n{{field-1}}" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-3a\\cdot ((-2b)\\times (7c)) & =168 \\\\ (-3)\\cdot (-2)\\cdot 7\\cdot [a\\cdot (b\\times c)] & =168 \\\\ 42[a\\cdot (b\\times c)] & =168 \\\\ a\\cdot (b\\times c) & =4.\\end{aligned}\n$$\n\nThen, we swap $b$ and $c$ to get\n\n$$\na\\cdot (c\\times b)\\,=\\,-4.\n$$"}] [{:db/id #edb/ref 17592186377082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444c47c5-f6ff-5993-9810-f2a59d46e7f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{x}^{2}+(y-4)^{2}" :db/id #edb/ref 17592186377084}] :answer-field/correct {:answer/id #uuid "444c47c5-f6ff-5993-9810-f2a59d46e7f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{x}^{2}+(y-4)^{2}" :db/id #edb/ref 17592186377084} :answer-field/id #uuid "505822d3-763e-5bdd-b961-64b75dcd3eb1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377083}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c9558ce-37ee-554b-ae06-97c014ed01c5" :question/math-academy-id "q-319828" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=2\\operatorname{cos}⁡t,\\,\\,\\,y=\\operatorname{sin}⁡t+4,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n{{field-1}}$=1.$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{2} \\\\ y=\\operatorname{sin}⁡t+4\\, & ⇒\\,\\operatorname{sin}⁡t=y-4\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}(y-4)^{2}+{\\left(\\frac{x}{2}\\right)}^{2} & =1 \\\\ \\frac{1}{4}{x}^{2}+(y-4)^{2} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e76ec15d-4235-56b9-b033-fb60f2aa5631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}(x+16)(x-5)" :db/id #edb/ref 17592186377087}] :answer-field/correct {:answer/id #uuid "e76ec15d-4235-56b9-b033-fb60f2aa5631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}(x+16)(x-5)" :db/id #edb/ref 17592186377087} :answer-field/id #uuid "d4e1d208-e4d2-5915-83c1-b4b15806c88a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377086}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "081bb8fa-7465-5289-83b2-398e18ea3051" :question/math-academy-id "q-320878" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=3t-1,\\,\\,\\,y=(t+5)(t-2),\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=3t-1\\,⇒\\,t=\\frac{x+1}{3}\\end{aligned}\n$$\n\nNow, substituting $t=\\frac{x+1}{3}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =(\\frac{x+1}{3}+5)(\\frac{x+1}{3}-2) \\\\  & =\\left(\\frac{x+1+15}{3}\\right)\\left(\\frac{x+1-6}{3}\\right) \\\\  & =\\left(\\frac{x+16}{3}\\right)\\left(\\frac{x-5}{3}\\right) \\\\  & =\\frac{1}{9}(x+16)(x-5).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfd39e46-6e10-5277-9820-57dd084b55b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{8}-3" :db/id #edb/ref 17592186377090}] :answer-field/correct {:answer/id #uuid "dfd39e46-6e10-5277-9820-57dd084b55b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{8}-3" :db/id #edb/ref 17592186377090} :answer-field/id #uuid "3733f8ba-81a2-59af-8065-3da7adf791ea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377089}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0deecc2-15f7-5c26-991c-e45282132b63" :question/math-academy-id "q-321315" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=-4\\operatorname{cos}⁡t,\\,\\,\\,y=3\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=-4\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=-\\frac{x}{4} \\\\ y=3\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{3}.\\end{aligned}\n$$\n\nNow, using the double-angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=-\\frac{x}{4}$ and $\\operatorname{cos}⁡2t=\\frac{y}{3}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{3} & =2{\\left(-\\frac{x}{4}\\right)}^{2}-1 \\\\ \\frac{y}{3} & =\\frac{2{x}^{2}}{16}-1 \\\\ y & =3(\\frac{{x}^{2}}{8}-1) \\\\ y & =\\frac{3{x}^{2}}{8}-3\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{3{x}^{2}}{8}-3.$"}] [{:db/id #edb/ref 17592186377091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c99283b5-3b7a-5fc6-a4f3-9fb25f6b4ff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+\\frac{{x}^{2}}{9}}" :db/id #edb/ref 17592186377093}] :answer-field/correct {:answer/id #uuid "c99283b5-3b7a-5fc6-a4f3-9fb25f6b4ff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+\\frac{{x}^{2}}{9}}" :db/id #edb/ref 17592186377093} :answer-field/id #uuid "f7e25b52-ed40-5d5d-a435-71863801ad29" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377092}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f647799-4d25-58ea-a46d-69aef277766e" :question/math-academy-id "q-321400" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=3\\operatorname{cot}⁡t,\\,\\,\\,y=2\\operatorname{csc}⁡t,\\,0<t<\\frac{\\pi }{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=3\\operatorname{cot}⁡t\\, & ⇒\\,\\operatorname{cot}⁡t=\\frac{x}{3} \\\\ y=2\\operatorname{csc}⁡t\\, & ⇒\\,\\operatorname{csc}⁡t=\\frac{y}{2}\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${csc}^{2}⁡t=1+{cot}^{2}⁡t$, we get\n\n$$\n\\begin{aligned}{csc}^{2}⁡t & =1+{cot}^{2}⁡t \\\\ \\frac{{y}^{2}}{4} & =1+\\frac{{x}^{2}}{9}.\\end{aligned}\n$$\n\nWe used here that $\\operatorname{csc}⁡t>0$ and $\\operatorname{cot}⁡t>0$ in the range $0<t<\\frac{\\pi }{2}.$\n\nNow, solving for $y$, we obtain\n\n$$\ny=2\\sqrt{\\,1+\\frac{{x}^{2}}{9}\\,}.\n$$\n\nSo, the Cartesian equation of the given curve is \n$y=2\\sqrt{\\,1+\\frac{{x}^{2}}{9}\\,}.$"}] [{:db/id #edb/ref 17592186378038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6c7ed61-be76-5c28-943e-73d839de469b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{t}" :db/id #edb/ref 17592186378040} {:answer/id #uuid "9a2c7131-1236-565f-820c-71d0c9d6461f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186378041} {:answer/id #uuid "81e6772a-0701-5fba-976e-107b1b9bdbb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2({e}^{2s}-{e}^{-2s})}{{e}^{2s}+{e}^{-2s}}" :db/id #edb/ref 17592186378042} {:answer/id #uuid "96f1087d-82ca-53f2-b58c-87296e971578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2s}+{e}^{-2s}}{2({e}^{2s}-{e}^{-2s})}" :db/id #edb/ref 17592186378043} {:answer/id #uuid "99ca07b6-ae62-53fa-8034-91167ff2ab00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{4}{{t}^{2}}" :db/id #edb/ref 17592186378044}] :answer-field/correct {:answer/id #uuid "a6c7ed61-be76-5c28-943e-73d839de469b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{t}" :db/id #edb/ref 17592186378040} :answer-field/id #uuid "a12f54b9-7bd3-5a99-bf1e-a42a31564b96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378039}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3b3dcc80-0abe-5373-bdc1-9e25975b2bb3" :question/math-academy-id "q-94751" :question/problem "Let $f(x,y)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}),$ where $x=t{e}^{s}$ and $y=t{e}^{-s}.$ Calculate $\\frac{∂f}{∂t}.$" :question/worked-solution "![](images/11/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{2x}{{x}^{2}+{y}^{2}},\\,\\frac{∂f}{∂y}=\\frac{2y}{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{2(t{e}^{s})}{(t{e}^{s})^{2}+(t{e}^{-s})^{2}}=\\frac{2{e}^{s}}{t({e}^{2s}+{e}^{-2s})}, \\\\ \\frac{∂f}{∂y} & =\\frac{2(t{e}^{-s})}{(t{e}^{s})^{2}+(t{e}^{-s})^{2}}=\\frac{2{e}^{-s}}{t({e}^{2s}+{e}^{-2s})}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & ={e}^{s}, \\\\ \\frac{∂y}{∂t} & ={e}^{-s}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =\\frac{2{e}^{s}}{t({e}^{2s}+{e}^{-2s})}\\cdot {e}^{s}+\\frac{2{e}^{-s}}{t({e}^{2s}+{e}^{-2s})}\\cdot {e}^{-s} \\\\  & =\\frac{2{e}^{2s}}{t({e}^{2s}+{e}^{-2s})}+\\frac{2{e}^{-2s}}{t({e}^{2s}+{e}^{-2s})} \\\\  & =\\frac{2({e}^{2s}+{e}^{-2s})}{t({e}^{2s}+{e}^{-2s})} \\\\  & =\\frac{2}{t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a54c10a5-9ef4-586a-8955-c8ef90f8bd0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+{y}^{2}=1" :db/id #edb/ref 17592186378554} {:answer/id #uuid "3e62eedc-e697-557e-a7eb-17e16f14ea94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=3" :db/id #edb/ref 17592186378555} {:answer/id #uuid "9b7ce305-e6ff-5ce3-8a7a-084edafec71e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=1" :db/id #edb/ref 17592186378556} {:answer/id #uuid "1b55e37c-193c-5283-9221-71aafd335783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=4" :db/id #edb/ref 17592186378557} {:answer/id #uuid "14db4b6d-e265-54a1-97c8-5f4f9c459c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2{y}^{2}=2" :db/id #edb/ref 17592186378558}] :answer-field/correct {:answer/id #uuid "9b7ce305-e6ff-5ce3-8a7a-084edafec71e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=1" :db/id #edb/ref 17592186378556} :answer-field/id #uuid "9f45af6a-ee19-5560-9c17-22c9bcaae7c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "adad43ad-f556-54b5-872d-89fc29158b9b" :question/math-academy-id "q-128445" :question/problem "Determine the equation of the level curve that passes through the point $P(1,0)$ for the function $f(x,y)=\\frac{1}{{x}^{2}+{y}^{2}+1}.$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(1,0) & =\\frac{1}{{1}^{2}+{0}^{2}+1} \\\\  & =\\frac{1}{1+0+1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nHence, the level curve that passes through $P(1,0)$ is the $\\frac{1}{2}$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=\\frac{1}{2}.$ So, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{1}{{x}^{2}+{y}^{2}+1} & =\\frac{1}{2} \\\\ 2 & ={x}^{2}+{y}^{2}+1 \\\\ {x}^{2}+{y}^{2} & =1\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $P(1,0)$ is the circle ${x}^{2}+{y}^{2}=1.$"}] [{:db/id #edb/ref 17592186378559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "995200e2-5e10-52e1-90be-fc815f544450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1-y" :db/id #edb/ref 17592186378561} {:answer/id #uuid "ae5d37a2-e3f4-52f8-88c7-9baa4e8494ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2{y}^{2}+1" :db/id #edb/ref 17592186378562} {:answer/id #uuid "09235770-a24c-5100-9f0f-3f63222ce061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={y}^{2}-1" :db/id #edb/ref 17592186378563} {:answer/id #uuid "c24e2c48-252f-55d1-b420-84ec94b43128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2y-1" :db/id #edb/ref 17592186378564} {:answer/id #uuid "d9ffc8e1-87ad-5ae1-a981-54948903b3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={y}^{2}-2" :db/id #edb/ref 17592186378565}] :answer-field/correct {:answer/id #uuid "ae5d37a2-e3f4-52f8-88c7-9baa4e8494ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2{y}^{2}+1" :db/id #edb/ref 17592186378562} :answer-field/id #uuid "4491bbbe-7549-50e8-ad8a-aca200ce17e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378560}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f75e12b-5e13-5df3-af5b-158f6f119451" :question/math-academy-id "q-128446" :question/problem "What is the equation of the level curve that passes through the point $P(3,-1)$ for the function $f(x,y)=\\frac{x}{2{y}^{2}+1}?$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(3,-1) & =\\frac{3}{2(-1)^{2}+1} \\\\  & =\\frac{3}{2+1} \\\\  & =1\\end{aligned}\n$$\n\nHence, the level curve that passes through $P(3,-1)$ is the $1$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=1.$ So, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{x}{2{y}^{2}+1} & =1 \\\\ x & =2{y}^{2}+1\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $P(3,-1)$ is the parabola $x=2{y}^{2}+1.$"}] [{:db/id #edb/ref 17592186379766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5582e4fd-2c1b-5d7e-8c00-e97e06814dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471447} {:answer/id #uuid "a3eb097d-ca23-5819-ac10-dc59c55d7b1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471448}] :answer-field/correct {:answer/id #uuid "a3eb097d-ca23-5819-ac10-dc59c55d7b1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471448} :answer-field/id #uuid "d03efb8d-a67e-5194-9397-44b10a9fe206" :answer-field/key "$c=-1$ gives a line" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472229} {:answer-field/choices [{:answer/id #uuid "398cb7dd-8121-5f92-b1f8-3cb5dfa077bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471449} {:answer/id #uuid "835ea12a-0dec-59ad-8c9d-1e2c535804ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471450}] :answer-field/correct {:answer/id #uuid "398cb7dd-8121-5f92-b1f8-3cb5dfa077bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471449} :answer-field/id #uuid "671dd875-2b17-5bf5-8cd4-e539f182cfa9" :answer-field/key "$c=0$ gives the axes $x=0$ and $y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472230} {:answer-field/choices [{:answer/id #uuid "c761f2b5-ba81-5508-8846-69bc0e2a0948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471451} {:answer/id #uuid "e051646c-5725-58cc-bba2-10290a7faee3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471452}] :answer-field/correct {:answer/id #uuid "c761f2b5-ba81-5508-8846-69bc0e2a0948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471451} :answer-field/id #uuid "ac6ae07c-0a83-5d77-ab7d-cfed78b60de1" :answer-field/key "$c=2$ gives a parabola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472231}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "036af2f8-8d3f-5a9f-9714-c21bb558dc15" :question/math-academy-id "q-35538" :question/problem "The level curves of the function $f(x,y)=4x-3y-1$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}4x-3y-1 & =c \\\\ 4x-3y-(c+1) & =0 \\\\ y & =\\frac{4}{3}x-\\frac{c+1}{3}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1$ then the level curve is $y=\\frac{4}{3}x,$ which is a line.\n\n- If $c=0$ then the level curve is $y=\\frac{4}{3}x-\\frac{1}{3},$ which is a line different to the axes $x=0$ and $y=0.$\n\n- If $c=2$ then the level curve is $y=\\frac{4}{3}x-1,$ which is not a parabola.\n\nSo, only statement “$c=-1$ gives a line” is true."}] [{:db/id #edb/ref 17592186379889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1fe7f12-1aba-53b8-84a6-c65a5b3db079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1+{y}^{2}" :db/id #edb/ref 17592186379891} {:answer/id #uuid "757f29e0-0793-5816-a02a-c5609b14f555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2+{x}^{2}" :db/id #edb/ref 17592186379892} {:answer/id #uuid "03d173bd-9735-589b-ae2b-0f0a570f3cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1+{x}^{2}" :db/id #edb/ref 17592186379893} {:answer/id #uuid "2e380ecf-c597-530c-bacd-d038a0e62d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1+2{y}^{2}" :db/id #edb/ref 17592186379894} {:answer/id #uuid "3eeebbe3-4754-5082-87d4-a82c718991e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2-{y}^{2}" :db/id #edb/ref 17592186379895}] :answer-field/correct {:answer/id #uuid "b1fe7f12-1aba-53b8-84a6-c65a5b3db079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1+{y}^{2}" :db/id #edb/ref 17592186379891} :answer-field/id #uuid "5829d29b-d41b-548e-a76a-f71d52e87bf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379890}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae2ee110-6028-560b-b154-cea2add1f458" :question/math-academy-id "q-71193" :question/problem "Find the equation of the level curve that passes through the point $T(2,1)$ for the function $f(x,y)=\\frac{1}{x-{y}^{2}}.$" :question/worked-solution "First, we find the value of the function at $T$:\n\n$$\n\\begin{aligned}f(2,1) & =\\frac{1}{2-{1}^{2}}=1\\end{aligned}\n$$\n\nHence, the level curve that passes through $T(2,1)$ is the $1$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=1.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{1}{x-{y}^{2}} & =1 \\\\ 1 & =x-{y}^{2} \\\\ x & =1+{y}^{2}\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $T(2,1)$ is the parabola $x=1+{y}^{2}.$"}] [{:db/id #edb/ref 17592186379896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a86f79f-60fc-5217-9c6b-a03f33f604de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}-2{y}^{2}=20" :db/id #edb/ref 17592186379898} {:answer/id #uuid "908be2b8-6e9b-571a-8f86-e456deb80232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+\\frac{{y}^{2}}{2}=20" :db/id #edb/ref 17592186379899} {:answer/id #uuid "8cd8e1a5-58ec-5407-b39e-0663ce69ce38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2{y}^{2}=20" :db/id #edb/ref 17592186379900} {:answer/id #uuid "475201b1-53d3-5bd4-b0f0-119e6038ce74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-\\frac{{y}^{2}}{2}=20" :db/id #edb/ref 17592186379901} {:answer/id #uuid "94ca828d-54b6-5990-afc7-c4497e745042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2{y}^{2}=20" :db/id #edb/ref 17592186379902}] :answer-field/correct {:answer/id #uuid "94ca828d-54b6-5990-afc7-c4497e745042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2{y}^{2}=20" :db/id #edb/ref 17592186379902} :answer-field/id #uuid "bc0fc72b-f01f-5a55-9f63-17e0f1879f6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379897}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "769b357f-4fb6-5958-a803-d881c01aed36" :question/math-academy-id "q-71201" :question/problem "Find the equation of the level curve that passes through the point $M(2,3)$ for the function $f(x,y)=\\frac{{x}^{2}}{2}+2{y}^{2}-15.$" :question/worked-solution "First, we find the value of the function at $M$:\n\n$$\n\\begin{aligned}f(2,3) & =\\frac{{2}^{2}}{2}+2(3)^{2}-15=5\\end{aligned}\n$$\n\nHence, the level curve that passes through $M(2,3)$ is the $5$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=5.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{{x}^{2}}{2}+2{y}^{2}-15 & =5 \\\\ \\frac{{x}^{2}}{2}+2{y}^{2} & =20\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $M(2,3)$ is the ellipse $\\frac{{x}^{2}}{2}+2{y}^{2}=20.$"}] [{:db/id #edb/ref 17592186379903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d046747a-b317-586d-8d55-5c90d106b70d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471459} {:answer/id #uuid "d0ae2f16-5c4b-5f1c-bc31-c6238c4fb198" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471460}] :answer-field/correct {:answer/id #uuid "d046747a-b317-586d-8d55-5c90d106b70d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471459} :answer-field/id #uuid "e01cb9ca-cfef-5a04-b8e8-faaa3c67d474" :answer-field/key "$c=0$ gives a circle" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472235} {:answer-field/choices [{:answer/id #uuid "0c5c8627-87dd-5f0d-836a-c310a9c4ed71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471461} {:answer/id #uuid "6bf51cce-838b-5461-8589-29027a79ad48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471462}] :answer-field/correct {:answer/id #uuid "0c5c8627-87dd-5f0d-836a-c310a9c4ed71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471461} :answer-field/id #uuid "9af77a4f-7777-5db4-b47d-afe23125eeb7" :answer-field/key "$c=1$ gives a hyperbola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472236} {:answer-field/choices [{:answer/id #uuid "5aadc0f6-aa90-5bee-94bc-57244da99e51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471463} {:answer/id #uuid "46907805-5ba1-518e-903b-c1d4d29ff9d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471464}] :answer-field/correct {:answer/id #uuid "46907805-5ba1-518e-903b-c1d4d29ff9d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471464} :answer-field/id #uuid "af943ca9-e995-586e-81d8-b5176e4f024d" :answer-field/key "$c=2$ gives a parabola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3aaf864-2fae-5bdc-a851-6e2a3303364c" :question/math-academy-id "q-71398" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}+2y}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}+2y} & =c \\\\ {x}^{2}+2y & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0$ then the level curve is $y=-\\frac{{x}^{2}}{2},$ which is not a circle.\n\n- If $c=1$ then the level curve is $y=\\frac{1}{2}-\\frac{{x}^{2}}{2},$ which is not a hyperbola.\n\n- If $c=2$ then the level curve is $y=2-\\frac{{x}^{2}}{2},$ which is a parabola.\n\nSo, only statement “$c=2$ gives a parabola” is true."}] [{:db/id #edb/ref 17592186379910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f17d518-60b8-544c-92f5-2cf0aab0557b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/65/6521da99a82e38a68a5aa87a0c7c88eacf4ed7b78351af594ec309fa2cb7f57b.png" :db/id #edb/ref 17592186379912} {:answer/id #uuid "6196a8f6-ab71-5465-a24f-af55f550e44b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/cccaa6d7f554076b3a79364e1f2c4c061ae7cd86f7f0064e3861ba3b035b6a3e.png" :db/id #edb/ref 17592186379913} {:answer/id #uuid "0f21dd87-4625-5c1a-ad37-6386c8fedd7d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c4530dc74747fc0bdae0ca4c8608a72dbf03ca413d4479c8a4b9224246ac01f.png" :db/id #edb/ref 17592186379914} {:answer/id #uuid "fcc62c66-3d50-525b-b466-4341bcf3773b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png" :db/id #edb/ref 17592186379915} {:answer/id #uuid "32bd84ff-54ed-577c-bae9-a5c917d68e95" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1b/1b1cd5983d4a19990cc5e82726bb8cd8101dbab0f2dc7c9934a64c45e6126ee4.png" :db/id #edb/ref 17592186379916}] :answer-field/correct {:answer/id #uuid "6196a8f6-ab71-5465-a24f-af55f550e44b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/cccaa6d7f554076b3a79364e1f2c4c061ae7cd86f7f0064e3861ba3b035b6a3e.png" :db/id #edb/ref 17592186379913} :answer-field/id #uuid "15955093-e5c1-50f6-b2be-d700cd4f9e99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379911}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94f47fe3-89d1-5943-be21-5cabcd5b8b5e" :question/math-academy-id "q-71409" :question/problem "Which of the following represents the level curves of $f(x,y)=\\sqrt{3{x}^{2}+2{y}^{2}}?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nNotice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only level curves for $c\\ge 0.$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\sqrt{3{x}^{2}+2{y}^{2}} & =c \\\\ 3{x}^{2}+2{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nThe equation above gives us a family of ellipses centered at the origin. Therefore, the correct graph is as follows:\n\n$$\n\n$$\n\n![](images/cc/cccaa6d7f554076b3a79364e1f2c4c061ae7cd86f7f0064e3861ba3b035b6a3e.png)"}] [{:db/id #edb/ref 17592186379917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edb9e29c-19c1-512b-b67b-3c63363893cd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d573fdc38a90793a5290862e6cfa5943d982f33ee98800199e04e7200067224d.png" :db/id #edb/ref 17592186379919} {:answer/id #uuid "2e884e6f-f213-5463-adf6-1016dc564801" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/da7c5bc006ec489e9283fcf062f07e2dcc01e72793098bda3f36c2b9bc03fd90.png" :db/id #edb/ref 17592186379920} {:answer/id #uuid "646fdab8-0f60-50f2-ae58-70ccadbb47ed" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c7/c759002d1e72c53e719ed43326ba6564b435ae7e9a80d29f4614e51f354714fc.png" :db/id #edb/ref 17592186379921} {:answer/id #uuid "9e4b569d-919d-5cf9-b068-8191ca16e923" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6b425704394d6fcd3090b54a3767b031b728cf4dbc44f9ac9446defe1cdb05aa.png" :db/id #edb/ref 17592186379922} {:answer/id #uuid "0a6f9f97-28b2-5b81-9f8c-367ea37c7b39" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b79c75fb4de77313ff9ae17938eeabc8b55cca395e6516c09abf6742f9b6a23b.png" :db/id #edb/ref 17592186379923}] :answer-field/correct {:answer/id #uuid "9e4b569d-919d-5cf9-b068-8191ca16e923" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6b425704394d6fcd3090b54a3767b031b728cf4dbc44f9ac9446defe1cdb05aa.png" :db/id #edb/ref 17592186379922} :answer-field/id #uuid "92bec405-4b97-5b51-967a-b30418a002b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379918}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dd87390-11b1-5a52-bff2-7394eae160c7" :question/math-academy-id "q-71410" :question/problem "Which of the following represents the level curves of $f(x,y)=\\sqrt{y+2{x}^{2}}?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nNotice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only $c$-level curves for $c\\ge 0.$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\sqrt{y+2{x}^{2}} & =c \\\\ y+2{x}^{2} & ={c}^{2} \\\\ y & ={c}^{2}-2{x}^{2}\\end{aligned}\n$$\n\nThe equation above gives us a family of parabolas with the vertex at $(0,{c}^{2}).$ Therefore, the correct graph is as follows:\n\n$$\n\n$$\n\n![](images/6b/6b425704394d6fcd3090b54a3767b031b728cf4dbc44f9ac9446defe1cdb05aa.png)"}] [{:db/id #edb/ref 17592186379924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6119211c-9460-5205-91bf-6632457578b6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5d/5d02a08781a848cf603b1a1d7cae1e3674ae1faafa1ec09097c273ee98633e6e.png" :db/id #edb/ref 17592186379926} {:answer/id #uuid "6d775fea-4bb7-59be-8dd5-2e78893daa18" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3b9d09b3b5630401089fa4cc3feedc5ac2229bb6bb047d49080d53e5c324a66.png" :db/id #edb/ref 17592186379927} {:answer/id #uuid "bf6746bf-0b94-5c07-8ecc-b541466bdc89" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9f243d14e996f643e746a2c20c4e606df94420355d7da6211770265af2883619.png" :db/id #edb/ref 17592186379928} {:answer/id #uuid "cf9664db-a17b-5cad-be59-b0b634b2b206" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png" :db/id #edb/ref 17592186379929} {:answer/id #uuid "f88efe51-ed65-546f-94a6-764382e08792" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/408a028814088bbb85e20e52e9482a0ddfd0b21fcf70470196049c6b5f37a208.png" :db/id #edb/ref 17592186379930}] :answer-field/correct {:answer/id #uuid "bf6746bf-0b94-5c07-8ecc-b541466bdc89" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9f243d14e996f643e746a2c20c4e606df94420355d7da6211770265af2883619.png" :db/id #edb/ref 17592186379928} :answer-field/id #uuid "904d8f28-930c-5efc-9ce7-182888897b77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379925}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5f669334-e7bc-58b4-bc46-7fea306fb463" :question/math-academy-id "q-71412" :question/problem "![](images/a3/a3e1daa4db558edc65d65f6bfe25d848de6499fa47695011fa3fb7afda326c2e.png)\n\nWhich of the following could represent the level curves of the surface $z=\\frac{{y}^{2}}{2}$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only $c$-level curves for $c\\ge 0.$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{{y}^{2}}{2} & =c \\\\ y & =\\pm \\sqrt{2c}\\end{aligned}\n$$\n\nNotice that in the equations $y=\\pm \\sqrt{2c}$ do not depend on $x.$ So, for a given $c\\ge 0$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n$$\n\n$$\n\n![](images/9f/9f243d14e996f643e746a2c20c4e606df94420355d7da6211770265af2883619.png)"}] [{:db/id #edb/ref 17592186380657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "162499c9-d211-5946-8b2e-c019541c3034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437606} {:answer/id #uuid "96e0faf2-fb61-5450-8ad0-ff90febe7fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437607}] :answer-field/correct {:answer/id #uuid "96e0faf2-fb61-5450-8ad0-ff90febe7fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437607} :answer-field/id #uuid "428e492b-b338-505d-b794-6840361998af" :answer-field/key "$G(x,y)={x}^{2}\\,i+\\operatorname{sin}⁡y\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438832} {:answer-field/choices [{:answer/id #uuid "4078c42f-287d-5b03-8583-af065de039c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437608} {:answer/id #uuid "b2eb56cf-3f62-5c54-b952-b89ebe56b894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437609}] :answer-field/correct {:answer/id #uuid "4078c42f-287d-5b03-8583-af065de039c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437608} :answer-field/id #uuid "bc0a8721-d4c0-531c-850b-a28514d4f48c" :answer-field/key "$H(t)=\\sqrt{t}\\,i+t{e}^{t}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438833} {:answer-field/choices [{:answer/id #uuid "24149d6d-29cf-587b-9c73-d17502c56d1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437610} {:answer/id #uuid "642982e1-2a9a-5105-be2e-a1a9730e6358" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437611}] :answer-field/correct {:answer/id #uuid "24149d6d-29cf-587b-9c73-d17502c56d1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437610} :answer-field/id #uuid "571b08b4-5fa1-5191-8779-09ec9667116b" :answer-field/key "$K(x,y,z)=2x\\,i+y\\,j-3z\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1de1af2b-64e8-50cf-80c9-f414743fe7ca" :question/math-academy-id "q-122641" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $G(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $H(t)$ is *not* a vector field on ${R}^{2}.$  It assigns points in $R$ (not ${R}^{2}$) to vectors in ${R}^{2}.$\n\n- The function $K(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\nTherefore, the correct answer is $G(x,y)={x}^{2}\\,i+\\operatorname{sin}⁡y\\,j$ only."}] [{:db/id #edb/ref 17592186380664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1447082-f4e8-5788-a80e-d8c2f8b82522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437630} {:answer/id #uuid "747beaa6-cbb1-5ab8-b6f0-aac6db2ca380" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437631}] :answer-field/correct {:answer/id #uuid "d1447082-f4e8-5788-a80e-d8c2f8b82522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437630} :answer-field/id #uuid "89920c46-71c7-5175-8718-e990046088f6" :answer-field/key "$M(x,y)$ $=⟨y-{x}^{2},3x+{y}^{2},\\frac{1}{x+y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438844} {:answer-field/choices [{:answer/id #uuid "5963b314-2add-567a-b457-6f81885a3dad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437632} {:answer/id #uuid "0a97ce34-6fad-5a23-a913-7a8c54c9939c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437633}] :answer-field/correct {:answer/id #uuid "0a97ce34-6fad-5a23-a913-7a8c54c9939c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437633} :answer-field/id #uuid "121c69dd-36e1-570a-bd6d-c832cafb4cd4" :answer-field/key "$N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438845} {:answer-field/choices [{:answer/id #uuid "2852e063-18c2-5c27-805a-899fefe85cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437634} {:answer/id #uuid "2d47eb09-37b1-5b48-8d81-6237d57c3ab0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437635}] :answer-field/correct {:answer/id #uuid "2852e063-18c2-5c27-805a-899fefe85cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437634} :answer-field/id #uuid "c6caeebf-8412-599a-8bb3-625ed3e2bddb" :answer-field/key "$P(t)=⟨{t}^{3},\\sqrt{1-t}\\,⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438846}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "502cb71c-02d6-5e14-a31b-2cee28a0a5ef" :question/math-academy-id "q-122656" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $M(x,y)$ is *not* a vector field on ${R}^{2}.$ It assigns points in  ${R}^{2}$ to vectors in ${R}^{3}$ (not in ${R}^{2}$).\n\n- The function $N(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $P(t)$ is *not* a vector field on ${R}^{2}.$ It assigns points in  $R$ \n(not ${R}^{2}$) to vectors in ${R}^{2}.$\n\nTherefore, the correct answer is $N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$ only."}] [{:db/id #edb/ref 17592186380671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8cc3763-c596-539c-84ff-fc43a34ca838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}<4,\\,x\\ne 1}" :db/id #edb/ref 17592186380673} {:answer/id #uuid "e393beba-f44d-54af-a58f-f17495b74529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4}" :db/id #edb/ref 17592186380674} {:answer/id #uuid "d5a628af-d843-5691-850a-a01497b612f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4,\\,x\\ne 1}" :db/id #edb/ref 17592186380675} {:answer/id #uuid "5ea6c947-7540-5f8e-9661-c097d1519263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}<4}" :db/id #edb/ref 17592186380676} {:answer/id #uuid "6105c7e2-8e73-526d-b477-10f7ed9a3aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>4}" :db/id #edb/ref 17592186380677}] :answer-field/correct {:answer/id #uuid "d5a628af-d843-5691-850a-a01497b612f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4,\\,x\\ne 1}" :db/id #edb/ref 17592186380675} :answer-field/id #uuid "5ced28f1-8592-507f-b2f3-ca4edef0e463" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380672}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76ab55a5-b7ae-513b-bef2-54d7a5d78561" :question/math-academy-id "q-122660" :question/problem "Determine the domain of the vector field $F$ on ${R}^{2},$ given by\n\n$$\nF(x,y)=\\operatorname{arctan}⁡\\left(\\frac{1}{{x}^{2}+{y}^{2}-4}\\right)\\,i+\\frac{xy}{x-1}\\,j\\,.\n$$" :question/worked-solution "The function $F$ can be expressed in terms of its components $P(x,y)$ and $Q(x,y)$ as\n\n$$\nF(x,y)=P(x,y)\\,i+Q(x,y)\\,j,\n$$\n\nwhere\n\n$$\nP(x,y)=\\operatorname{arctan}⁡\\left(\\frac{1}{{x}^{2}+{y}^{2}-4}\\right),\\,Q(x,y)=\\frac{xy}{x-1}.\n$$\n\nWe first find the domain of each component function. Then, we compute their intersection to find the domain of $F:$\n\n- The function $P(x,y)$ is defined everywhere other than when the denominator vanishes. To find where the denominator vanishes, we set it equal to zero and solve:\n\n$$\n{x}^{2}+{y}^{2}-4=0\\,⟹\\,{x}^{2}+{y}^{2}=4.\n$$\n\nTherefore, the domain of $P$ is given by\n\n$$\n{D}_{1}={(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4}.\n$$\n\n- The function $Q(x,y)$ is defined everywhere other than when the denominator vanishes. To find where the denominator vanishes, we set it equal to zero and solve:\n\n$$\nx-1=0\\,⟹\\,x=1\n$$\n\nTherefore, the domain of $Q$ is given by\n\n$$\n{D}_{2}={(x,y)\\in {R}^{2}\\,|\\,x\\ne 1}.\n$$\n\nFinally, the domain $D$ of $F$ is given by\n\n$$\nD={D}_{1}\\cap {D}_{2}={(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4,\\,x\\ne 1}\\,.\n$$"}] [{:db/id #edb/ref 17592186380678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acbf2816-9f71-5351-b1d8-a801bf30542d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437636} {:answer/id #uuid "308d0f3d-2e87-5cc6-b65f-2f83e5267801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437637}] :answer-field/correct {:answer/id #uuid "308d0f3d-2e87-5cc6-b65f-2f83e5267801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437637} :answer-field/id #uuid "bbe68175-15ca-5f31-9cf5-5f03083fe4fb" :answer-field/key "$C(x,y)=⟨\\frac{1}{x+y},{x}^{2}{e}^{y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438847} {:answer-field/choices [{:answer/id #uuid "0725d6f3-2622-5e9f-9c94-bfc7b72d7402" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437638} {:answer/id #uuid "81503c2a-ae1a-5a4d-882d-f15bf57c0190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437639}] :answer-field/correct {:answer/id #uuid "81503c2a-ae1a-5a4d-882d-f15bf57c0190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437639} :answer-field/id #uuid "920a7af7-aee4-545a-b604-ad8eca5e6e88" :answer-field/key "$D(x,y)=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y)⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438848} {:answer-field/choices [{:answer/id #uuid "ceb42624-bc8c-5336-8d28-af87d45d5914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437640} {:answer/id #uuid "fc8e9ded-65e6-530c-8fb7-a0624c962138" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437641}] :answer-field/correct {:answer/id #uuid "ceb42624-bc8c-5336-8d28-af87d45d5914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437640} :answer-field/id #uuid "2a744e92-3f60-596f-918f-2e9f6b8fc76b" :answer-field/key "$E(x,y)=⟨x+1,y+2,x-y⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438849}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b352a16-fe6f-5946-bac9-7b334007947a" :question/math-academy-id "q-122675" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $C(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,x+y\\ne 0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $D(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $E(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It assigns points in ${R}^{2}$ to vectors in ${R}^{3}$ (not ${R}^{2}$).\n\nTherefore, the correct answer is $C(x,y)=⟨\\frac{1}{x+y},{x}^{2}{e}^{y}⟩$; $D(x,y)=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y)⟩$ only."}] [{:db/id #edb/ref 17592186380685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ac4dc2b-7925-5bb6-a8d7-26be528ca51e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/59/59ec29347dea9437c8217a208bde0a8b200e37fcbce9c223d0358011a0685297.png" :db/id #edb/ref 17592186380687} {:answer/id #uuid "de160c2f-72c8-5594-b423-821d641cf29b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/27/27f151bdd3d619de0988b786e6b7517a7f7586844f9a7a35bf651063e7a7dfd1.png" :db/id #edb/ref 17592186380688} {:answer/id #uuid "fc0e97a0-e2b2-5364-a798-7ba629c78a40" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fadd7ae69d155ebf23586b88369da8f6624b1919942dad543917592f2d3c195c.png" :db/id #edb/ref 17592186380689} {:answer/id #uuid "7de70ea1-561a-5260-a36d-8f1436c265b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cb/cb10aa8f4d930ec7422da7dedfa0650244dceb01afe7cc849ed2bb16ffd3e44d.png" :db/id #edb/ref 17592186380690} {:answer/id #uuid "72aa0994-f928-5da5-8344-fae3471548d6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a1ee85bca08b21494e6f1f47de3abcbd71d2d01117795ef91d8ee3e038b36271.png" :db/id #edb/ref 17592186380691}] :answer-field/correct {:answer/id #uuid "de160c2f-72c8-5594-b423-821d641cf29b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/27/27f151bdd3d619de0988b786e6b7517a7f7586844f9a7a35bf651063e7a7dfd1.png" :db/id #edb/ref 17592186380688} :answer-field/id #uuid "ab0fa5e8-8931-50fe-a99e-b67ba6230eec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380686}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e932ad34-5aaf-594d-8943-da2547f2acb1" :question/math-academy-id "q-122677" :question/problem "Determine which of the following shaded regions depicts the domain of the vector field $F$ on ${R}^{2},$ given by\n\n$$\nF(x,y)=\\frac{1}{\\sqrt{y-x}}\\,i+\\sqrt{2-{x}^{2}-{y}^{2}}\\,j\\,.\n$$" :question/worked-solution "The function $F$ can be expressed in terms of its components $P(x,y)$ and $Q(x,y)$ as\n\n$$\nF(x,y)=P(x,y)\\,i+Q(x,y)\\,j,\n$$\n\nwhere\n\n$$\nP(x,y)=\\frac{1}{\\sqrt{y-x}},\\,Q(x,y)=\\sqrt{2-{x}^{2}-{y}^{2}}.\n$$\n\nWe first find the domain of each component function. Then, we compute their intersection to find the domain of $F:$\n\n- The function $P(x,y)$ is defined when the expression under the radical is positive. So, to find the domain, we solve the following inequality:\n\n$$\ny-x>0\\,⟹\\,y>x.\n$$\n\nThis defines the region ${D}_{1},$ shown below:\n\n![](images/c7/c78759bc8f9926159065129e00c1fc8b4341ab83ad40cc87e67a2e82b3e6b089.png)\n\n- The function $Q(x,y)$ is defined when the expression under the radical is positive or equal to zero. So, to find the domain, we solve the following inequality:\n\n$$\n2-{x}^{2}-{y}^{2}\\ge 0\\,⟹\\,{x}^{2}+{y}^{2}\\le 2.\n$$\n\nThis defines the region ${D}_{2},$ which is a circle of radius $\\sqrt{2},$ as shown below:\n\n![](images/bd/bdf02ff330f256327d0c9f1147c388b25184610b36ea7ab77bb2c570ec3be19a.png)\n\nFinally, the domain $D$ of $F$ is given by ${D}_{1}\\cap {D}_{2},$ shown below.\n\n![](images/0d/0d3180a60e33c05e904c8fc00fdec4197510198fef3de3fa8c7b3549609205f6.png)"}] [{:db/id #edb/ref 17592186380692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa463bcd-c692-5b2e-81fb-6edd382301d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437654} {:answer/id #uuid "0f0c189c-4360-5311-8733-688846ac83f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437655}] :answer-field/correct {:answer/id #uuid "fa463bcd-c692-5b2e-81fb-6edd382301d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437654} :answer-field/id #uuid "eec2a251-816b-560e-984e-218cc993a24b" :answer-field/key "$P(x,y)=\\frac{1}{{x}^{2}}\\,i+(x+y)^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438856} {:answer-field/choices [{:answer/id #uuid "4e7e53ee-c545-556b-8c01-71673e0ac9c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437656} {:answer/id #uuid "133f3ccd-0846-5c2f-8e29-aac997ab0c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437657}] :answer-field/correct {:answer/id #uuid "133f3ccd-0846-5c2f-8e29-aac997ab0c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437657} :answer-field/id #uuid "1e2fd0e0-3c93-53a1-8f8a-f97251928fc1" :answer-field/key "$Q(x,y,z)$ $=\\operatorname{sin}⁡y\\,i$ $-\\frac{x}{y}\\,j$ $+\\frac{1}{z+1}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438857} {:answer-field/choices [{:answer/id #uuid "22acadb3-7ca8-5abe-ad3c-4d0f8a82b17b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437658} {:answer/id #uuid "bafa02fd-27b6-50a3-b21c-bc14c4e05eaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437659}] :answer-field/correct {:answer/id #uuid "22acadb3-7ca8-5abe-ad3c-4d0f8a82b17b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437658} :answer-field/id #uuid "a898dd6a-8e9a-579f-bcba-72e40817966d" :answer-field/key "$R(t)=\\frac{1}{t+1}\\,i-(3t-1)\\,j+\\frac{1}{{t}^{2}}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438858}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b17979a9-57b7-5c2d-8065-c277267e307e" :question/math-academy-id "q-122686" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $P(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,z\\ne -1,\\,y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $R(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\nTherefore, the correct answer is $Q(x,y,z)$ $=\\operatorname{sin}⁡y\\,i$ $-\\frac{x}{y}\\,j$ $+\\frac{1}{z+1}\\,k$ only."}] [{:db/id #edb/ref 17592186380699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91acbdcb-0819-512d-8f3a-8f5b18843d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437678} {:answer/id #uuid "c042a6b6-5fe6-5670-9ac7-c7152c415d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437679}] :answer-field/correct {:answer/id #uuid "c042a6b6-5fe6-5670-9ac7-c7152c415d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437679} :answer-field/id #uuid "78ff1394-a615-59ad-bb26-46d4946b7591" :answer-field/key "$M(x,y,z)$ $=⟨z-{x}^{2},3x+{z}^{2},\\frac{1}{x+y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438868} {:answer-field/choices [{:answer/id #uuid "77a73f89-d276-53da-ba0d-e39074166f8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437680} {:answer/id #uuid "83b30725-25b3-5535-9453-a881c12cb3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437681}] :answer-field/correct {:answer/id #uuid "77a73f89-d276-53da-ba0d-e39074166f8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437680} :answer-field/id #uuid "2a11b4f3-6da8-5671-9b65-64280b7f35aa" :answer-field/key "$N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438869} {:answer-field/choices [{:answer/id #uuid "2c27113d-a2f3-54dd-a0fe-40e814f8066c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437682} {:answer/id #uuid "88e9a9b2-4f69-57eb-9973-f4cc63d15d74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437683}] :answer-field/correct {:answer/id #uuid "2c27113d-a2f3-54dd-a0fe-40e814f8066c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437682} :answer-field/id #uuid "e6f83e16-f061-5b3d-ae8a-955bb9e63305" :answer-field/key "$P(t)=⟨{t}^{3},\\sqrt{1-t}\\,⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438870}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "438dc864-2346-5ec7-8b61-791bfb4d3c82" :question/math-academy-id "q-122695" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $M(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x+y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\nTherefore, the correct answer is $M(x,y,z)$ $=⟨z-{x}^{2},3x+{z}^{2},\\frac{1}{x+y}⟩$ only."}] [{:db/id #edb/ref 17592186382682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89279b6a-4252-5259-b05c-c3d2ef4f194f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382684} {:answer/id #uuid "7ae9b086-4ca3-5355-af06-586613fd1dc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xy}{{y}^{2}+1}\\,i-\\operatorname{ln}⁡({y}^{2}+1)\\,j" :db/id #edb/ref 17592186382685} {:answer/id #uuid "fa1ed37a-ed72-5634-8413-f5aedf5da794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2xy}{{y}^{2}+1}\\,i+\\operatorname{ln}⁡({y}^{2}+1)\\,j" :db/id #edb/ref 17592186382686} {:answer/id #uuid "6d47ca13-b171-5cc5-9de1-aa1e0daf4499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i-\\frac{xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382687} {:answer/id #uuid "5b384027-61ed-5223-9ea6-1b096f29bda4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382688}] :answer-field/correct {:answer/id #uuid "5b384027-61ed-5223-9ea6-1b096f29bda4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382688} :answer-field/id #uuid "5323b306-b747-5d4a-8438-95e5a038dfe5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382683}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7a92703b-4103-5d43-a169-46ae386c0c50" :question/math-academy-id "q-104400" :question/problem "For which of the following vector fields is $f(x,y)=x\\operatorname{ln}⁡({y}^{2}+1)$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j \\\\  & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡({y}^{2}+1))\\,i+\\frac{∂}{∂y}(x\\operatorname{ln}⁡({y}^{2}+1))\\,j \\\\  & =\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j.\n$$"}] [{:db/id #edb/ref 17592186382689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7109fa2b-c389-5fc6-b0c4-b41d4d74bf4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x\\,i-y\\,j-4z\\,k" :db/id #edb/ref 17592186382691} {:answer/id #uuid "e9db5c91-f335-58aa-97c3-99952996d70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\,i-2y\\,j-2z\\,k" :db/id #edb/ref 17592186382692} {:answer/id #uuid "0631570a-280c-5f08-a196-767cab352a76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x\\,i-2y\\,j-4z\\,k" :db/id #edb/ref 17592186382693} {:answer/id #uuid "fc7f9857-e151-5110-9b90-a5c8c453d023" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x\\,i+2y\\,j+4z\\,k" :db/id #edb/ref 17592186382694} {:answer/id #uuid "8dc25693-095f-5e5b-8994-90d409ec8817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x\\,i-y\\,j-2z\\,k" :db/id #edb/ref 17592186382695}] :answer-field/correct {:answer/id #uuid "0631570a-280c-5f08-a196-767cab352a76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x\\,i-2y\\,j-4z\\,k" :db/id #edb/ref 17592186382693} :answer-field/id #uuid "777faee0-1b4e-5ed3-9d6b-efa0173e6d16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382690}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99ded14c-42f7-5e12-a882-b682276e471b" :question/math-academy-id "q-104402" :question/problem "For which of the following vector fields is $f(x,y,z)=3{x}^{2}-{y}^{2}-2{z}^{2}$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k \\\\  & =\\frac{∂}{∂x}(3{x}^{2}-{y}^{2}-2{z}^{2})\\,i+\\frac{∂}{∂y}(3{x}^{2}-{y}^{2}-2{z}^{2})\\,j+\\frac{∂}{∂z}(3{x}^{2}-{y}^{2}-2{z}^{2})\\,k \\\\  & =6x\\,i-2y\\,j-4z\\,k \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=6x\\,i-2y\\,j-4z\\,k.\n$$"}] [{:db/id #edb/ref 17592186382696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7a94cea-936d-5e4d-ae19-8ad4604dbaa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡(xy-z)\\,i+y\\operatorname{cos}⁡(xy-z)\\,j-z\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382698} {:answer/id #uuid "e3feb8c8-b6b5-5b0c-979a-fa204c7f4e38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382699} {:answer/id #uuid "115abe44-c0ca-57da-b518-6f2d0f2c33ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{sin}⁡(xy-z)\\,i-x\\operatorname{cos}⁡(xy-z)\\,j+\\operatorname{sin}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382700} {:answer/id #uuid "45dbde3e-c0f4-522e-8450-38dd964b2722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡(xy-z)\\,i-y\\operatorname{cos}⁡(xy-z)\\,j+\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382701} {:answer/id #uuid "d4a258a7-72bb-5a84-a2bc-356a3c11b847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{sin}⁡(xy-z)\\,j-\\operatorname{sin}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382702}] :answer-field/correct {:answer/id #uuid "e3feb8c8-b6b5-5b0c-979a-fa204c7f4e38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382699} :answer-field/id #uuid "52aae08c-2f4f-5759-bdb7-0ce12352bc22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382697}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92017542-0c54-511c-9493-08cbabacf96f" :question/math-academy-id "q-104403" :question/problem "For which of the following vector fields is $f(x,y,z)=\\operatorname{sin}⁡(xy-z)$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k \\\\  & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy-z))\\,i+\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy-z))\\,j+\\frac{∂}{∂z}(\\operatorname{sin}⁡(xy-z))\\,k \\\\  & =y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k.\n$$"}] [{:db/id #edb/ref 17592186382703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4316cd9b-1517-5a38-89bb-fe261972cb80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+j+k" :db/id #edb/ref 17592186382705} {:answer/id #uuid "c74231a7-4c08-5c80-aad4-2f6813ba5103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i-j-k" :db/id #edb/ref 17592186382706} {:answer/id #uuid "e4527c6a-2fc5-5c2f-b8da-1f12673c53d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x-y-z}\\,i+{e}^{2x-y-z}\\,j+{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382707} {:answer/id #uuid "822aa67f-98a4-57c6-8772-9ee5aa70cf3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382708} {:answer/id #uuid "22eacead-e6b0-5320-9bdc-0ffab1b473ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382709}] :answer-field/correct {:answer/id #uuid "822aa67f-98a4-57c6-8772-9ee5aa70cf3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382708} :answer-field/id #uuid "98bee3aa-ab3e-511a-89b6-caa042a74ebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382704}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d18a5537-9a57-5262-bad7-d34e0ce877ea" :question/math-academy-id "q-104404" :question/problem "For which of the following vector fields is $f(x,y,z)={e}^{2x-y-z}$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k \\\\  & =\\frac{∂}{∂x}({e}^{2x-y-z})\\,i+\\frac{∂}{∂y}({e}^{2x-y-z})\\,j+\\frac{∂}{∂z}({e}^{2x-y-z})\\,k \\\\  & =2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k.\n$$"}] [{:db/id #edb/ref 17592186382826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67a23b89-2744-50f5-80ee-0e41d4401774" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437438} {:answer/id #uuid "1e5e0906-c5a6-5260-a5c9-800e874c6cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437439}] :answer-field/correct {:answer/id #uuid "1e5e0906-c5a6-5260-a5c9-800e874c6cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437439} :answer-field/id #uuid "1ef5597b-7d44-55ff-944c-918cec802871" :answer-field/key "$\\text{div}\\,F=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} 