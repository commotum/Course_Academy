answer/value "2" :db/id #edb/ref 17592186698218}] :answer-field/correct {:answer/id #uuid "289c39fc-e0bc-584f-890d-50f8830e1b02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698218} :answer-field/id #uuid "2d62c329-d6f1-5943-92c5-5c1fd35cb85a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698220} {:answer-field/choices [{:answer/id #uuid "a926ca61-68de-581a-91c6-ea9ae885b7a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186698247}] :answer-field/correct {:answer/id #uuid "a926ca61-68de-581a-91c6-ea9ae885b7a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186698247} :answer-field/id #uuid "36f24247-97ae-5c32-b43d-b2fa5999b850" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698222} {:answer-field/choices [{:answer/id #uuid "19266755-9b43-5a85-8306-f5886ca9fb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186698211}] :answer-field/correct {:answer/id #uuid "19266755-9b43-5a85-8306-f5886ca9fb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186698211} :answer-field/id #uuid "680608f0-6553-547c-8e2a-1b025cd38d56" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698233} {:answer-field/choices [{:answer/id #uuid "d0abc128-d26e-51de-808e-7e52e5193b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698258}] :answer-field/correct {:answer/id #uuid "d0abc128-d26e-51de-808e-7e52e5193b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698258} :answer-field/id #uuid "781a8ee5-2e11-5364-b824-e33c88a22fa7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698236} {:answer-field/choices [{:answer/id #uuid "b9ab8590-7cb2-5e99-9247-cdc42e135d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698253}] :answer-field/correct {:answer/id #uuid "b9ab8590-7cb2-5e99-9247-cdc42e135d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698253} :answer-field/id #uuid "e31d7123-9282-5508-add7-ab9b940dcbaf" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698261} {:answer-field/choices [{:answer/id #uuid "a3659a41-6278-5295-abb8-8687c252f662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186698246}] :answer-field/correct {:answer/id #uuid "a3659a41-6278-5295-abb8-8687c252f662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186698246} :answer-field/id #uuid "e697811e-4a3f-5144-a05e-7398249d05d7" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698264}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "406c7ad1-7d78-5626-ac50-63adda31fea9" :question/problem "Given that a curve is defined parametrically as\n\n$$\n\\begin{gathered}\nx=-4\\cos\\theta-2,\\qquad y=5\\sin\\theta-2,\\\\\n0\\le \\theta<2\\pi,\n\\end{gathered}\n$$\n\nwhat are the ranges of $x$ and $y$?\n\nThe range of $x$ is {{field-1}} {{field-2}} $x\\le$ {{field-3}}.\n\nThe range of $y$ is {{field-4}} $\\le y$ {{field-5}} {{field-6}}." :question/worked-solution "Consider each coordinate separately.\n\nFor $x$:\n\nOver the full turn, $\\cos\\theta$ attains both $-1$ and $1$, including at permitted parameter values.\n\nMultiplying by $-4$ reverses both comparisons; translate by $-2$, then write the bounds in increasing order.\n\n$$\n\\begin{aligned}\n-1 &\\le \\cos\\theta\\le 1 \\\\\n4 &\\ge-4\\cos\\theta\\ge-4 \\\\\n2 &\\ge-4\\cos\\theta-2\\ge-6 \\\\\n-6 &\\le x\\le 2.\n\\end{aligned}\n$$\n\nThus $-6\\le x\\le 2$.\n\nFor $y$:\n\nOver the full turn, $\\sin\\theta$ attains both $-1$ and $1$, including at permitted parameter values.\n\nMultiply by $5$ and translate by $-2$.\n\n$$\n\\begin{aligned}\n-1 &\\le \\sin\\theta\\le 1 \\\\\n-5 &\\le 5\\sin\\theta\\le 5 \\\\\n-7 &\\le 5\\sin\\theta-2\\le 3 \\\\\n-7 &\\le y\\le 3.\n\\end{aligned}\n$$\n\nThus $-7\\le y\\le 3$.\n\nContinuity gives every value between the stated bounds. The coordinate extrema need not occur at the same parameter value."}] [{:db/id #edb/ref 17592186698228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14113110-05d1-5f96-a7db-692340001397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698209}] :answer-field/correct {:answer/id #uuid "14113110-05d1-5f96-a7db-692340001397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698209} :answer-field/id #uuid "1fb9aaf8-bd67-5dd5-aa5d-feec81cbf17b" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698216} {:answer-field/choices [{:answer/id #uuid "596c8c80-7e6b-555d-849b-42f26fd50b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186698229}] :answer-field/correct {:answer/id #uuid "596c8c80-7e6b-555d-