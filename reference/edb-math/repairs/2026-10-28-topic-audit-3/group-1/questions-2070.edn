#{[{:db/id #edb/ref 17592186697926 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Multiplication by $-2$ reverses the inequality, so $x$ decreases as $t$ increases." :answer/id #uuid "1969ae88-530d-5474-9986-2a5824242faf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 2" :db/id #edb/ref 17592186697912} {:answer/feedback "$x=2$ occurs at $t=1$, and every smaller value is attained." :answer/id #uuid "31cb0908-dcc1-50f1-b369-f048bc05f69d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 2" :db/id #edb/ref 17592186697913} {:answer/feedback "$t=0$ is outside the parameter domain; the largest allowed value of $x$ occurs at $t=1$." :answer/id #uuid "b22be577-bd88-50e0-9525-13a148521ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 4" :db/id #edb/ref 17592186697920} {:answer/feedback "The allowed parameter $t=1$ gives $x=2$, so equality must be included." :answer/id #uuid "cbaff8af-eaa9-5d07-a0ea-eb49afaf4a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2" :db/id #edb/ref 17592186697921} {:answer/feedback "$2$ is the maximum, but larger values of $t$ produce every smaller value of $x$." :answer/id #uuid "d1131d1a-0885-54dc-a155-ec41f37b9437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186697923}] :answer-field/correct {:answer/feedback "$x=2$ occurs at $t=1$, and every smaller value is attained." :answer/id #uuid "31cb0908-dcc1-50f1-b369-f048bc05f69d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 2" :db/id #edb/ref 17592186697913} :answer-field/id #uuid "a96a175d-4d83-5b26-a9cf-ae9c9434eb35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186697919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8fe94e2-a021-5fc4-a910-6c60b0f92f91" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=4-2t,\\quad y=t^2+1,\\quad t\\ge 1,\n$$\n\nwhat is the range of $x$?" :question/worked-solution "Since $t\\ge 1$, multiplying by $-2$ reverses the inequality:\n\n$$\n\\begin{aligned}\nt &\\ge 1 \\\\\n-2t &\\le -2 \\\\\n4-2t &\\le 2.\n\\end{aligned}\n$$\n\nThe value $x=2$ is attained at $t=1$. As $t$ increases without bound, $x$ decreases without bound. Every value below $2$ occurs: for any $x\\le 2$, the parameter $t=(4-x)/2$ satisfies $t\\ge 1$.\n\nTherefore, the range is $x\\le 2$."}] [{:db/id #edb/ref 17592186698030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67691eaf-b00e-54c2-89e3-3418966ba0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 15 \\left(9 - 5 x\\right)^{2}" :db/id #edb/ref 17592186698035} {:answer/id #uuid "68a16847-1298-5640-8682-a4d63c941720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9 \\left(9 - 10 x\\right)^{2}" :db/id #edb/ref 17592186698036} {:answer/id #uuid "69eb4219-ab76-5d58-8b39-4d279478a2b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 \\left(9 - 5 x\\right)^{2}" :db/id #edb/ref 17592186698037} {:answer/id #uuid "8c9947f1-2ef7-5b37-940d-bf81932542cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 15 \\left(9 - 10 x\\right)^{2}" :db/id #edb/ref 17592186698043} {:answer/id #uuid "8da642bf-0aa8-5867-b10e-d9b97d74f7e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9 \\left(9 - 5 x\\right)^{2}" :db/id #edb/ref 17592186698044}] :answer-field/correct {:answer/id #uuid "67691eaf-b00e-54c2-89e3-3418966ba0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 15 \\left(9 - 5 x\\right)^{2}" :db/id #edb/ref 17592186698035} :answer-field/id #uuid "120d00f6-258d-53b5-ba58-fc5c76a41e66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186698025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f3f583e-3609-5938-ab2c-9679cf2c703c" :question/problem "Given that $f(x)=\\left(9 - 5 x\\right)^{3}$, find $f^{\\prime}(x).$" :question/worked-solution "Let $g(x)=9 - 5 x$ and $F(g)=g^{3}$, so $f(x)=F(g(x))$.\n\nDifferentiating, we have\n\n$$\n\\begin{aligned} F^{\\prime}(g)&=3 g^{2}, \\\\ g^{\\prime}(x)&=-5.\\end{aligned}\n$$\n\nThen, using the chain rule,\n\n$$\n\\begin{aligned} f^{\\prime}(x)&=F^{\\prime}(g(x))\\cdot g^{\\prime}(x) \\\\ &=\\left(3 \\left(9 - 5 x\\right)^{2}\\right)\\cdot\\left(-5\\right) \\\\ &=- 15 \\left(9 - 5 x\\right)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f43c25-25a1-5f15-be5e-fa7272043524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(54 \\left(9 x - 11\\right)^{5})" :db/id #edb/ref 17592186698024} {:answer/id #uuid "cead8dc0-12a5-59dc-811f-f07341ac0cac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54 \\left(9 x - 11\\right)^{5}" :db/id #edb/ref 17592186698048}] :answer-field/correct {:answer/id #uuid "cead8dc0-12a5-59dc-811f-f07341ac0cac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54 \\left(9 x - 11\\right)^{5}" :db/id #edb/ref 17592186698048} :answer-field/id #uuid "6db4dc76-49a1-51b1-bcca-38814b4c5021" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698038}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d9ef932-f18f-5be6-97ae-cb72686349cc" :question/problem "Given that $f(x)=\\left(9 x - 11\\right)^{6}$, find $f^{\\prime}(x).$\n\n$f^{\\prime}(x)=$\n{{field-1}}" :question/worked-solution "Let $g(x)=9 x - 11$ and $F(g)=g^{6}$, so $f(x)=F(g(x))$.\n\nDifferentiating, we have\n\n$$\n\\begin{aligned} F^{\\prime}(g)&=6 g^{5}, \\\\ g^{\\prime}(x)&=9.\\end{aligned}\n$$\n\nThen, using the chain rule,\n\n$$\n\\begin{aligned} f^{\\prime}(x)&=F^{\\prime}(g(x))\\cdot g^{\\prime}(x) \\\\ &=\\left(6 \\left(9 x - 11\\right)^{5}\\right)\\cdot\\left(9\\right) \\\\ &=54 \\left(9 x - 11\\right)^{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078ac3ae-f526-5351-b317-b05f60c2f99f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 \\left(1 - 5 x\\right)^{7}" :db/id #edb/ref 17592186698023} {:answer/id #uuid "60dfa102-7a8e-57dc-b906-5558374df8b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 13 \\left(1 - 5 x\\right)^{7}" :db/id #edb/ref 17592186698034} {:answer/id #uuid "6e8b73ec-cd60-595a-99ce-bc10d2174f42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 45 \\left(1 - 5 x\\right)^{7}" :db/id #edb/ref 17592186698039} {:answer/id #uuid "a8c0e603-0498-55e3-aa47-5361a6335d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 40 \\left(1 - 5 x\\right)^{7}" :db/id #edb/ref 17592186698046} {:answer/id #uuid "c9c0fb2f-9630-572a-8cc2-1907f2de1da6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 39 \\left(1 - 5 x\\right)^{7}" :db/id #edb/ref 17592186698047}] :answer-field/correct {:answer/id #uuid "a8c0e603-0498-55e3-aa47-5361a6335d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 40 \\left(1 - 5 x\\right)^{7}" :db/id #edb/ref 17592186698046} :answer-field/id #uuid "59d3d389-b546-51cd-92db-e0f9d95220c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186698032}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f492990-8d20-538e-b5c5-63a967568bd4" :question/problem "Given that $f(x)=\\left(1 - 5 x\\right)^{8}$, find $f^{\\prime}(x).$" :question/worked-solution "Let $g(x)=1 - 5 x$ and $F(g)=g^{8}$, so $f(x)=F(g(x))$.\n\nDifferentiating, we have\n\n$$\n\\begin{aligned} F^{\\prime}(g)&=8 g^{7}, \\\\ g^{\\prime}(x)&=-5.\\end{aligned}\n$$\n\nThen, using the chain rule,\n\n$$\n\\begin{aligned} f^{\\prime}(x)&=F^{\\prime}(g(x))\\cdot g^{\\prime}(x) \\\\ &=\\left(8 \\left(1 - 5 x\\right)^{7}\\right)\\cdot\\left(-5\\right) \\\\ &=- 40 \\left(1 - 5 x\\right)^{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5db149b3-9250-5cc6-8ee0-8cdaf81c7ee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 30 \\left(8 - 6 x\\right)^{4})" :db/id #edb/ref 17592186698033} {:answer/id #uuid "9b97600c-ca9f-570c-a1b2-d54332bf6521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 30 \\left(8 - 6 x\\right)^{4}" :db/id #edb/ref 17592186698045}] :answer-field/correct {:answer/id #uuid "9b97600c-ca9f-570c-a1b2-d54332bf6521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 30 \\left(8 - 6 x\\right)^{4}" :db/id #edb/ref 17592186698045} :answer-field/id #uuid "833c8ba4-4ad9-521b-95b3-7b36fc66c363" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c466867-7e45-5195-8c17-0cb61679673c" :question/problem "Given that $f(x)=\\left(8 - 6 x\\right)^{5}$, find $f^{\\prime}(x).$\n\n$f^{\\prime}(x)=$\n{{field-1}}" :question/worked-solution "Let $g(x)=8 - 6 x$ and $F(g)=g^{5}$, so $f(x)=F(g(x))$.\n\nDifferentiating, we have\n\n$$\n\\begin{aligned} F^{\\prime}(g)&=5 g^{4}, \\\\ g^{\\prime}(x)&=-6.\\end{aligned}\n$$\n\nThen, using the chain rule,\n\n$$\n\\begin{aligned} f^{\\prime}(x)&=F^{\\prime}(g(x))\\cdot g^{\\prime}(x) \\\\ &=\\left(5 \\left(8 - 6 x\\right)^{4}\\right)\\cdot\\left(-6\\right) \\\\ &=- 30 \\left(8 - 6 x\\right)^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ecca7a-0ca6-50a8-8215-c0b2e7d792f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 \\left(- 2 x - 2\\right)^{7}" :db/id #edb/ref 17592186698022} {:answer/id #uuid "1661f7cb-a47c-5177-b0e9-cfd39fe0900b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 16 \\left(- 2 x - 2\\right)^{7}" :db/id #edb/ref 17592186698026} {:answer/id #uuid "17d63a17-5737-5b1b-bac5-56d57f676a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 14 \\left(- 2 x - 2\\right)^{7}" :db/id #edb/ref 17592186698027} {:answer/id #uuid "2477220f-fa13-533d-9869-05e65d9ee658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 17 \\left(- 2 x - 2\\right)^{7}" :db/id #edb/ref 17592186698029} {:answer/id #uuid "da30ae38-a63c-5d6b-90d4-51ad8e4f5340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\left(- 2 x - 2\\right)^{7}" :db/id #edb/ref 17592186698049}] :answer-field/correct {:answer/id #uuid "1661f7cb-a47c-5177-b0e9-cfd39fe0900b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 16 \\left(- 2 x - 2\\right)^{7}" :db/id #edb/ref 17592186698026} :answer-field/id #uuid "1bb14453-3255-52fe-9245-b137f7000c50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186698028}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e38650e7-313f-5ee5-8a23-5355ea2ec56b" :question/problem "Given that $f(x)=\\left(- 2 x - 2\\right)^{8}$, find $f^{\\prime}(x).$" :question/worked-solution "Let $g(x)=- 2 x - 2$ and $F(g)=g^{8}$, so $f(x)=F(g(x))$.\n\nDifferentiating, we have\n\n$$\n\\begin{aligned} F^{\\prime}(g)&=8 g^{7}, \\\\ g^{\\prime}(x)&=-2.\\end{aligned}\n$$\n\nThen, using the chain rule,\n\n$$\n\\begin{aligned} f^{\\prime}(x)&=F^{\\prime}(g(x))\\cdot g^{\\prime}(x) \\\\ &=\\left(8 \\left(- 2 x - 2\\right)^{7}\\right)\\cdot\\left(-2\\right) \\\\ &=- 16 \\left(- 2 x - 2\\right)^{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186698065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6884502-f500-5d93-bf3f-92ae0c495ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698080}] :answer-field/correct {:answer/id #uuid "d6884502-f500-5d93-bf3f-92ae0c495ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698080} :answer-field/id #uuid "06473d97-a7d7-564d-aa7e-8763299388ab" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698054} {:answer-field/choices [{:answer/id #uuid "741fe4c2-7dd8-5052-ba30-2f2546e42bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186698066}] :answer-field/correct {:answer/id #uuid "741fe4c2-7dd8-5052-ba30-2f2546e42bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186698066} :answer-field/id #uuid "2c4de