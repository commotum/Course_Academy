pe/blank} :db/id #edb/ref 17592186698071} {:answer-field/choices [{:answer/id #uuid "027ae5f1-6672-59fa-8f0f-307a2eb6acf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698052}] :answer-field/correct {:answer/id #uuid "027ae5f1-6672-59fa-8f0f-307a2eb6acf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698052} :answer-field/id #uuid "e2083eb0-a087-5b94-b273-fcecd2480411" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698082}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72d3f4c9-33bf-5f30-b80b-da478efa9772" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=2-3\\cos\\theta,\\qquad y=2\\sin\\theta-4,\\qquad 0\\le\\theta<2\\pi,\n$$\n\nwhat are the ranges of $x$ and $y$?\n\nThe range of $x$ is {{field-1}} {{field-2}} $x\\le$ {{field-3}}.\n\nThe range of $y$ is {{field-4}} $\\le y$ {{field-5}} {{field-6}}." :question/worked-solution "Consider each coordinate separately. On $0\\le\\theta<2\\pi$, both sine and cosine attain every value from $-1$ to $1$.\n\nFor $x$, multiplying by $-3$ reverses the inequalities. Add $2$, then write the bounds in increasing order:\n\n$$\n\\begin{aligned}\n-1 &\\le \\cos\\theta \\le 1 \\\\\n3 &\\ge -3\\cos\\theta \\ge -3 \\\\\n5 &\\ge 2-3\\cos\\theta \\ge -1 \\\\\n-1 &\\le x\\le 5.\n\\end{aligned}\n$$\n\nFor $y$, multiply by $2$ and subtract $4$:\n\n$$\n\\begin{aligned}\n-1 &\\le \\sin\\theta \\le 1 \\\\\n-2 &\\le 2\\sin\\theta \\le 2 \\\\\n-6 &\\le 2\\sin\\theta-4 \\le -2 \\\\\n-6 &\\le y\\le -2.\n\\end{aligned}\n$$\n\nBoth endpoints of each range are attained. Therefore, $-1\\le x\\le 5$ and $-6\\le y\\le -2$."}] [{:db/id #edb/ref 17592186698070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "332df4cf-1aa7-5def-ac81-18090e8754b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698059}] :answer-field/correct {:answer/id #uuid "332df4cf-1aa7-5def-ac81-18090e8754b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698059} :answer-field/id #uuid "1de877d1-e3e8-5f4d-9f56-8fe66484e09e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698055} {:answer-field/choices [{:answer/id #uuid "421418e5-8044-5ed8-83be-e1f753eaa97e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186698060}] :answer-field/correct {:answer/id #uuid "421418e5-8044-5ed8-83be-e1f753eaa97e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186698060} :answer-field/id #uuid "7ed68c0d-c744-54c2-9465-cac942949c37" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698068} {:answer-field/choices [{:answer/id #uuid "5bb5b357-556a-5593-91ff-68eae0c62790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186698063}] :answer-field/correct {:answer/id #uuid "5bb5b357-556a-5593-91ff-68eae0c62790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186698063} :answer-field/id #uuid "94417408-44d9-5515-9187-e00e5d1d1e7a" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698073} {:answer-field/choices [{:answer/id #uuid "672234a8-c686-5cfa-81ef-cb5ab6360d3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186698064}] :answer-field/correct {:answer/id #uuid "672234a8-c686-5cfa-81ef-cb5ab6360d3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186698064} :answer-field/id #uuid "b568fbde-dc32-5318-a730-67ed930ee6ca" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698076} {:answer-field/choices [{:answer/id #uuid "b5985019-521b-5cf1-a91d-acd27c39e1c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698077}] :answer-field/correct {:answer/id #uuid "b5985019-521b-5cf1-a91d-acd27c39e1c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698077} :answer-field/id #uuid "ca456ea8-28ea-59dc-9b2a-3890cba95d01" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698079} {:answer-field/choices [{:answer/id #uuid "5b20220b-c18f-5293-9b0a-959eb0e5216b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698062}] :answer-field/correct {:answer/id #uuid "5b20220b-c18f-5293-9b0a-959eb0e5216b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698062} :answer-field/id #uuid "fc171f86-7773-50ca-a5d5-38e36972745c" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698084}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8714e1c8-2824-5d74-a7c0-997378cd464d" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=1-2\\cos\\theta,\\qquad y=3\\sin\\theta-1,\\qquad 0<\\theta\\le\\frac{3\\pi}{2},\n$$\n\nwhat are the ranges of $x$ and $y$? Use $<$ or $\\le$ as appropriate in each comparison blank.\n\nThe range of $x$ is {{field-1}} {{field-2}} $x\\le$ {{field-3}}.\n\nThe range of $y$ is {{field-4}} $\\le y$ {{field-5}} {{field-6}}." :question/worked-solution "The parameter interval does not cover a full turn. Check the sine and cosine extrema within the interval, as well as the excluded and included endpoints.\n\nFor $x$, cosine reaches $-1$ at $\\theta=\\pi$. It approaches $1$ as $\\theta$ approaches $0$ from above, but never equals $1$ on the given interval. Thus $-1\\le\\cos\\theta<1$. Multiplying by $-2$ reverses the comparisons, including the strict one:\n\n$$\n\\begin{aligned}\n-1 &\\le \\cos\\theta <1 \\\\\n2 &\\ge -2\\cos\\theta >-2 \\\\\n3 &\\ge 1-2\\cos\\theta >-1 \\\\\n-1 &<x\\le 3.\n\\end{aligned}\n$$\n\nThe upper bound $3$ occurs at $\\theta=\\pi$; the lower bound $-1$ is not attained.\n\nFor $y$, sine reaches $1$ at the interior point $\\theta=\\pi/2$ and $-1$ at the included endpoint $\\theta=3\\pi/2$. Therefore,\n\n$$\n\\begin{aligned}\n-1 &\\le \\sin\\theta \\le 1 \\\\\n-3 &\\le 3\\sin\\theta \\le 3 \\\\\n-4 &\\le 3\\sin\\theta-1 \\le 2 \\\\\n-4 &\\le y\\le 2.\n\\end{aligned}\n$$\n\nThe ranges are $-1<x\\le 3$ and $-4\\le y\\le 2$. Sine attains both extremes even though $\\theta=0$ is excluded. Continuity ensures that all values between the stated bounds occur. The coordinate ranges are considered separately; their extremes need not occur at the same parameter value."}] [{:db/id #edb/ref 17592186698072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eb9e4e9-9834-5dc1-a83a-29d6cc66c85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le x\\le 3,\\quad 0\\le y\\le 5" :db/id #edb/ref 17592186698058} {:answer/id #uuid "7cb55ae9-9283-592a-a55c-f34216a124ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\le x\\le 1,\\quad -1\\le y\\le 1" :db/id #edb/ref 17592186698067} {:answer/id #uuid "9e5b6e1d-9658-59c8-b343-a5bc0a08a6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\le x\\le 6,\\quad -10\\le y\\le 10" :db/id #edb/ref 17592186698074} {:answer/id #uuid "be72512f-a3fe-5797-bf53-c018e08c0794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le x\\le 3,\\quad -5\\le y\\le 5" :db/id #edb/ref 17592186698078} {:answer/id #uuid "e24f7af4-f995-5553-9cc0-f102ae3b4206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\le x\\le 5,\\quad -3\\le y\\le 3" :db/id #edb/ref 17592186698083}] :answer-field/correct {:answer/id #uuid "be72512f-a3fe-5797-bf53-c018e08c0794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le x\\le 3,\\quad -5\\le y\\le 5" :db/id #edb/ref 17592186698078} :answer-field/id #uuid "0420dcfb-cdde-55fd-bd1f-1a24131299f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186698053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91f69afd-c235-591f-ab3c-fc8cc28f1ac7" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3\\cos\\theta,\\qquad y=5\\sin\\theta,\\qquad 0\\le\\theta<2\\pi,\n$$\n\nwhat are the ranges of $x$ and $y$?" :question/worked-solution "Consider each coordinate separately. On $0\\le\\theta<2\\pi$, both sine and cosine attain every value from $-1$ to $1$.\n\nFor $x$, multiply the cosine bounds by $3$:\n\n$$\n\\begin{aligned}\n-1 &\\le \\cos\\theta \\le 1 \\\\\n-3 &\\le 3\\cos\\theta \\le 3 \\\\\n-3 &\\le x \\le 3.\n\\end{aligned}\n$$\n\nFor $y$, multiply the sine bounds by $5$:\n\n$$\n\\begin{aligned}\n-1 &\\le \\sin\\theta \\le 1 \\\\\n-5 &\\le 5\\sin\\theta \\le 5 \\\\\n-5 &\\le y \\le 5.\n\\end{aligned}\n$$\n\nThus the ranges are $-3\\le x\\le 3$ and $-5\\le y\\le 5$. All four bounds are attained within the parameter interval; excluding $2\\pi$ does not remove any coordinate bound."}] [{:db/id #edb/ref 17592186698121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95080386-ba52-5508-83c3-b56c1665d28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698126}] :answer-field/correct {:answer/id #uuid "95080386-ba52-5508-83c3-b56c1665d28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698126} :answer-field/id #uuid "aaeba00c-d120-5e96-9059-a314382c774e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698130} {:answer-field/choices [{:answer/id #uuid "9d9c76bd-b0e8-51bc-8963-f6991f6f5009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186698127}] :answer-field/correct {:answer/id #uuid "9d9c76bd-b0e8-51bc-8963-f6991f6f5009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186698127} :answer-field/id #uuid "ca74996f-a9e1-588f-822c-8a43fe4b66cb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698135} {:answer-field/choices [{:answer/id #uuid "941c8040-96d6-5850-af56-8af967babfbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186698125}] :answer-field/correct {:answer/id #uuid "941c8040-96d6-5850-af56-8af967babfbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186698125} :answer-field/id #uuid "d271a935-7a01-5a55-b8ee-31c44c8d02dd" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6eb50d16-40b6-5dfc-b62f-e9e8d896c408" :question/problem "Consider the curve with parametric equations\n\n$$\nx=- 2 t - 1,\\qquad y=- t^{2} - 1,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=- 2 \\left(-2\\right) - 1=3$.\n\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $3$ | {{field-2}} | $-1$ | $-3$ | $-5$ |\n| $y$ | $-5$ | $-2$ | {{field-1}} | $-2$ | {{field-3}} |" :question/worked-solution "The missing entry is in the $y$-row under $t=0$. Substitute into $y=- t^{2} - 1$:\n\n$$\n\\begin{aligned}y(0) &=- \\left(0\\right)^{2} - 1 \\\\ &=-1\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=- 2 t - 1$:\n\n$$\n\\begin{aligned}x(-1) &=- 2 \\left(-1\\right) - 1 \\\\ &=1\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t^{2} - 1$:\n\n$$\n\\begin{aligned}y(2) &=- \\left(2\\right)^{2} - 1 \\\\ &=-5\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $3$ | $1$ | $-1$ | $-3$ | $-5$ |\n| $y$ | $-5$ | $-2$ | $-1$ | $-2$ | $-5$ |"}] [{:db/id #edb/ref 17592186698122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ab3f1ae-28b2-5f8c-993e-34643d52a9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698114}] :answer-field/correct {:answer/id #uuid "3ab3f1ae-28b2-5f8c-993e-34643d52a9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698114} :answer-field/id #uuid "a3cb7f62-fc37-5436-ad36-35291c3bd9d5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698128} {:answer-field/choices [{:answer/id #uuid "3685ab30-02fd-52d8-8b72-935c9467a6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186698112}] :answer-field/correct {:answer/id #uuid "3685ab30-02fd-52d8-8b72-935c9467a6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186698112} :answer-field/id #uuid "e1558c42-7ae1-57f5-ac82-b5bab4db30ec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698138} {:answer-field/choices [{:answer/id #uuid "2e575b9a-1adc-5e76-83bf-a687525b0013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698110}] :answer-field/correct {:answer/id #uuid "2e575b9a-1adc-5e76-83bf-a687525b0013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698110} :answer-field/id #uuid "ebb09eae-223f-5d30-9183-b5e9215b9107" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698139}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "714507d9-4ce5-52aa-b483-53ba86dda909" :question/problem "Consider the curve with parametric equations\n\n$$\nx=1 - t,\\qquad y=2 - t^{2},\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=1 - \\left(-2\\right)=3$.\n\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $3$ | {{field-2}} | $1$ | $0$ | $-1$ |\n| $y$ | $-2$ | $1$ | {{field-3}} | {{field-1}} | $-2$ |" :question/worked-solution "The missing entry is in the $y$-row under $t=1$. Substitute into $y=2 - t^{2}$:\n\n$$\n\\begin{aligned}y(1) &=2 - \\left(1\\right)^{2} \\\\ &=1\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=1 - t$:\n\n$$\n\\begin{aligned}x(-1) &=1 - \\left(-1\\right) \\\\ &=2\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=2 - t^{2}$:\n\n$$\n\\begin{aligned}y(0) &=2 - \\left(0\\right)^{2} \\\\ &=2\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $3$ | $2$ | $1$ | $0$ | $-1$ |\n| $y$ | $-2$ | $1$ | $2$ | $1$ | $-2$ |"}] [{:db/id #edb/ref 17592186698133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc8abf18-1dad-5023-998f-ee754e335050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186698136}] :answer-field/correct {:answer/id #uuid "cc8abf18-1dad-5023-998f-ee754e335050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186698136} :answer-field/id #uuid "136e6231-d339-54ec-89cd-db326348eb00" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698107} {:answer-field/choices [{:answer/id #uuid "61ea9d23-23b8-52d0-9f63-b7e54a8e249b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698119}] :answer-field/correct {:answer/id #uuid "61ea9d23-23b8-52d0-9f63-b7e54a8e249b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186698119} :answer-field/id #uuid "42f5cb7a-f946-5338-af4d-cec632603cb1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb