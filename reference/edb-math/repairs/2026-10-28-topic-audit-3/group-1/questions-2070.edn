answer.type/math} :answer/value "3" :db/id #edb/ref 17592186698171} :answer-field/id #uuid "c32f8387-5a2f-5199-b6fc-06c3727b00ee" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aeaa24bc-4369-5201-97b7-ded344b5f202" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=-\\sqrt{- t}+4,\\quad y=-2\\sqrt{3 - t},\\quad t\\le -1 ,\n$$\n\ndetermine the ranges of $x$ and $y$.\n\n$x$ {{field-1}}{{field-2}}\n\n$y$ {{field-3}}{{field-4}}" :question/worked-solution "Consider each coordinate separately.\n\nFor $x$:\n\n$$\n\\begin{aligned}\nx &=-\\sqrt{- t}+4\n\\end{aligned}\n$$\n\nThe radicand starts at $1$ and increases without bound along the allowed half-line. The square root is increasing, and its exterior coefficient is $-1$. The boundary $t=-1$ gives $x=3$ and is included. The coordinate is continuous on the domain and unbounded below, so every value on the stated side of the bound occurs. Thus $x\\le 3$.\n\nFor $y$:\n\n$$\n\\begin{aligned}\ny &=-2\\sqrt{3 - t}\n\\end{aligned}\n$$\n\nThe radicand starts at $4$ and increases without bound along the allowed half-line. The square root is increasing, and its exterior coefficient is $-2$. The boundary $t=-1$ gives $y=-4$ and is included. The coordinate is continuous on the domain and unbounded below, so every value on the stated side of the bound occurs. Thus $y\\le -4$.\n\nTherefore, $x\\le 3,\\,y\\le -4$."}] [{:db/id #edb/ref 17592186698193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c38ea5-1642-5917-bf16-4dc22eaf76fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186698182}] :answer-field/correct {:answer/id #uuid "62c38ea5-1642-5917-bf16-4dc22eaf76fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186698182} :answer-field/id #uuid "1f98f5b5-ffda-58c0-82b2-258d082d28f2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698170} {:answer-field/choices [{:answer/id #uuid "c658976a-cf7c-52c6-835a-8bf06fd8eb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698197}] :answer-field/correct {:answer/id #uuid "c658976a-cf7c-52c6-835a-8bf06fd8eb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186698197} :answer-field/id #uuid "2e864ec2-5835-50f0-88b9-3238eb75877b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698173} {:answer-field/choices [{:answer/id #uuid "ba4f9039-980a-52c7-b150-91e1d35a1ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186698194}] :answer-field/correct {:answer/id #uuid "ba4f9039-980a-52c7-b150-91e1d35a1ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186698194} :answer-field/id #uuid "9e6a6f13-eba1-54df-ac11-1d3214ccd5a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698189} {:answer-field/choices [{:answer/id #uuid "f71dc8f1-71a5-5204-bb9b-f5e84847a181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698202}] :answer-field/correct {:answer/id #uuid "f71dc8f1-71a5-5204-bb9b-f5e84847a181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186698202} :answer-field/id #uuid "b06eb7fd-57ae-588a-a9af-70a8443ef3f6" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186698192}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3fd42af-52b6-5190-bc05-87f886a099bb" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=t^{2} + 3,\\quad y=- 2 t - 2,\\quad t\\ge -2 ,\n$$\n\ndetermine the ranges of $x$ and $y$.\n\n$x$ {{field-1}}{{field-2}}\n\n$y$ {{field-3}}{{field-4}}" :question/worked-solution "Consider each coordinate separately.\n\nFor $x$:\n\n$$\n\\begin{aligned}\nx &=t^{2} + 3 \\\\ &=t^{2} + 3\n\\end{aligned}\n$$\n\nThe vertex parameter $t=0$ is inside the domain, so its value $3$ is attained even if the parameter boundary is excluded. The coordinate is continuous on the domain and unbounded above, so every value on the stated side of the bound occurs. Thus $x\\ge 3$.\n\nFor $y$:\n\n$$\n\\begin{aligned}\ny &=- 2 t - 2\n\\end{aligned}\n$$\n\nThe affine coefficient is $-2$. The boundary $t=-2$ gives $y=2$ and is included. The coordinate is continuous on the domain and unbounded below, so every value on the stated side of the bound occurs. Thus $y\\le 2$.\n\nTherefore, $x\\ge 3,\\,y\\le 2$."}] [{:db/id #edb/ref 17592186698198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c11b5f3-abc3-5979-813d-2cdfce64e78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -6,\\,y\\ge -2" :db/id #edb/ref 17592186698165} {:answer/id #uuid "3b832de8-1d5f-50f0-9698-bb386da2e368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -2,\\,y\\le -2" :db/id #edb/ref 17592186698177} {:answer/id #uuid "5d551028-5a75-5c24-9883-53846da65e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -2,\\,y\\le 6" :db/id #edb/ref 17592186698181} {:answer/id #uuid "7bd811e9-a1cc-5b4b-98fe-f605