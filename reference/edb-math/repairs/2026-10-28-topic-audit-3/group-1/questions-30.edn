ields [{:answer-field/choices [{:answer/id #uuid "84e39638-07a3-50d9-bfe6-b9af29e98dc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x^{4/3}}{3} + C" :db/id #edb/ref 17592186061538} {:answer/id #uuid "cc5c2097-f7f5-52e3-93b2-0e2d1df16d31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x^{5/3}}{3} + C" :db/id #edb/ref 17592186061539} {:answer/id #uuid "267a13d7-f608-57fd-b791-75b0ac04fdbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{5/3}" :db/id #edb/ref 17592186061540} {:answer/id #uuid "74062014-ff92-54e2-84b6-a0ecdfafcc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^{5/3}}{5} + C" :db/id #edb/ref 17592186061541} {:answer/id #uuid "7d652c0c-6ec0-53ed-9aeb-8cd0cb05022e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^{4/3}}{4} + C" :db/id #edb/ref 17592186061542}] :answer-field/correct {:answer/id #uuid "74062014-ff92-54e2-84b6-a0ecdfafcc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^{5/3}}{5} + C" :db/id #edb/ref 17592186061541} :answer-field/id #uuid "4372205a-8138-530c-99c4-421ebef58c8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061537}] :question/id #uuid "cb61c7fc-a0d3-5742-be73-cb3d6f6a29fa" :question/math-academy-id "q-2023" :question/problem "Find the antiderivative of $\\sqrt[3]{x^{2}}$." :question/worked-solution "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int x^{\\frac{2}{3}}\\,\\mathrm{d}x=\\frac{3x^{5/3}}{5} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{3 x^{\\frac{5}{3}}}{5}+C\\right)=x^{\\frac{2}{3}}.\n$$"}]}
