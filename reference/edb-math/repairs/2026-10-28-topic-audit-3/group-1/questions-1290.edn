}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{11/5}}{11}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{11}\\frac{\\text{d}}{\\text{d}x}({x}^{11/5})+0 \\\\ &= \\frac{5}{11}\\cdot \\frac{11}{5}{x}^{11/5-1} \\\\ &= {x}^{6/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b264e9f-1b95-5da0-8a5d-53d43f387515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{14/5}}{14}" :db/id #edb/ref 17592186503898}] :answer-field/correct {:answer/id #uuid "9b264e9f-1b95-5da0-8a5d-53d43f387515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{14/5}}{14}" :db/id #edb/ref 17592186503898} :answer-field/id #uuid "7639bdc5-e09a-59de-9a6d-7760ce0dd6a5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503891}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a04ec978-e44a-5fc0-941a-3437fa7bf03c" :question/problem "Find the antiderivative of $\\sqrt[5]{{x}^{9}}.$\n\nWork on $x>0$.\n\nThe antiderivative is {{field-1}} $+C$. Enter only the term before $+C$, with no additive constant." :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{9}}={x}^{9/5}.$ So, we can apply the power rule with $n=\\frac{9}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{9}}\\,\\text{d}x & =\\int {x}^{9/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{9/5+1}}{(\\frac{9}{5}+1)}+C \\\\  & =\\frac{{x}^{14/5}}{\\left(\\frac{14}{5}\\right)}+C \\\\  & =\\frac{5{x}^{14/5}}{14}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{14/5}}{14}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{14/5}}{14}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{14}\\frac{\\text{d}}{\\text{d}x}({x}^{14/5})+0 \\\\ &= \\frac{5}{14}\\cdot \\frac{14}{5}{x}^{14/5-1} \\\\ &= {x}^{9/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a07fc94f-5b6d-5ea9-93c2-7e82f2229b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{13/5}}{13}" :db/id #edb/ref 17592186503901}] :answer-field/correct {:answer/id #uuid "a07fc94f-5b6d-5ea9-93c2-7e82f2229b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{13/5}}{13}" :db/id #edb/ref 17592186503901} :answer-field/id #uuid "cfe4c120-0640-5e64-a81c-759b876005de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503911}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a26b65ff-d0b9-55fd-88b5-aeb6bb366617" :question/problem "Find the antiderivative of $\\sqrt[5]{{x}^{8}}.$\n\nWork on $x>0$.\n\nThe antiderivative is {{field-1}} $+C$. Enter only the term before $+C$, with no additive constant." :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{8}}={x}^{8/5}.$ So, we can apply the power rule with $n=\\frac{8}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{8}}\\,\\text{d}x & =\\int {x}^{8/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{8/5+1}}{(\\frac{8}{5}+1)}+C \\\\  & =\\frac{{x}^{13/5}}{\\left(\\frac{13}{5}\\right)}+C \\\\  & =\\frac{5{x}^{13/5}}{13}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{13/5}}{13}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{13/5}}{13}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{13}\\frac{\\text{d}}{\\text{d}x}({x}^{13/5})+0 \\\\ &= \\frac{5}{13}\\cdot \\frac{13}{5}{x}^{13/5-1} \\\\ &= {x}^{8/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9b9a59b-1b30-5f5a-96ca-ff44ec806088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{9/5}}{9}" :db/id #edb/ref 17592186503915}] :answer-field/correct {:answer/id #uuid "f9b9a59b-1b30-5f5a-96ca-ff44ec806088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{9/5}}{9}" :db/id #edb/ref 17592186503915} :answer-field/id #uuid "63f7164e-c9db-55ed-a2c8-afeccd4f032f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503889}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3c79b12-9c14-5549-a389-57292bb076aa" :question/problem "Find the antiderivative of $\\sqrt[5]{{x}^{4}}.$\n\nWork on $x>0$.\n\nThe antiderivative is {{field-1}} $+C$. Enter only the term before $+C$, with no additive constant." :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{4}}={x}^{4/5}.$ So, we can apply the power rule with $n=\\frac{4}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{4}}\\,\\text{d}x & =\\int {x}^{4/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}+C \\\\  & =\\frac{{x}^{9/5}}{\\left(\\frac{9}{5}\\right)}+C \\\\  & =\\frac{5{x}^{9/5}}{9}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{9/5}}{9}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/5})+0 \\\\ &= \\frac{5}{9}\\cdot \\frac{9}{5}{x}^{9/5-1} \\\\ &= {x}^{4/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d457834a-752e-5c58-903b