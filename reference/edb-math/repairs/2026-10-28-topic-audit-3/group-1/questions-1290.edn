pe/math} :answer/value "-\\frac{7}{6}x^{-13/6} + C" :db/id #edb/ref 17592186502871} {:answer/id #uuid "3b1a5dcb-9685-581b-a29b-34e5194a8426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-1/6} + C" :db/id #edb/ref 17592186502892} {:answer/id #uuid "532e1430-d266-59be-bcd5-73f6c2edc0c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x^{-1/6} + C" :db/id #edb/ref 17592186502909} {:answer/id #uuid "a0474aa2-d95c-5f73-a568-2f603fd609c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-7/6} + C" :db/id #edb/ref 17592186502934} {:answer/id #uuid "b62fcefc-fd59-5b42-856a-3cdec3b5280a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-1/6} + C" :db/id #edb/ref 17592186502941}] :answer-field/correct {:answer/id #uuid "3b1a5dcb-9685-581b-a29b-34e5194a8426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-1/6} + C" :db/id #edb/ref 17592186502892} :answer-field/id #uuid "4062f5dc-238e-55a5-899a-9aca06dee35f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502899}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cc7d7a47-ab4b-5a3b-8ff4-ed432aa440ba" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[6]{{x}^{7}}}$. Assume $x>0$." :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt[6]{{x}^{7}}}=\\frac{1}{{x}^{7/6}}={x}^{-7/6}.\n$$ So, we can use the power rule with $n=-\\frac{7}{6}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[6]{{x}^{7}}}\\,\\text{d}x & =\\int {x}^{-7/6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-7/6+1}}{-\\frac{7}{6}+1}+C \\\\  & =-6{x}^{-1/6}+C \\\\  & =-\\frac{6}{{x}^{1/6}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34391ca3-ad98-50ce-8e1e-44cb8eade4a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502886} {:answer/id #uuid "401ae6af-30db-5402-a6f2-7d26f4d47d36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-14/5} + C" :db/id #edb/ref 17592186502897} {:answer/id #uuid "5b7281c4-4d4b-5557-8aaa-96752cd38280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/5} + C" :db/id #edb/ref 17592186502910} {:answer/id #uuid "c4952ea7-4ee5-5ad8-9fff-3d99d83b3d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-4/5} + C" :db/id #edb/ref 17592186502947} {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949}] :answer-field/correct {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949} :answer-field/id #uuid "71958d00-8def-5201-b349-02ba63662a31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502918}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de2aa536-e15f-5af4-b511-e0e4c9d378a1" :question/problem "Given that $f(x)=\\frac{1}{{x}^{9/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{9/5}}={x}^{-9/5}.$ So, we can use the power rule with $n=-\\frac{9}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-9/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-9/5+1}}{(-\\frac{9}{5}+1)}+C \\\\  & =\\frac{{x}^{-4/5}}{\\left(-\\frac{4}{5}\\right)}+C \\\\  & =-\\frac{5}{4}{x}^{-4/5}+C \\\\  & =-\\frac{5}{4{x}^{4/5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6ad986-0c26-5cd6-9cd3-04a7be56d694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{7}+C" :db/id #edb/ref 17592186503846} {:answer/id #uuid "4ec8b324-f032-547f-97d9-6c73f80f4440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{7}+C" :db/id #edb/ref 17592186503850} {:answer/id #uuid "7fe67df0-46d1-5acd-abf6-e732a8688e8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186503855} {:answer/id #uuid "b8b1f0d3-bec7-598d-ba2e-a3f438f06ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7x^{7}+C" :db/id #edb/ref 17592186503868} {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875}] :answer-field/correct {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875} :answer-field/id #uuid "b67f2104-8e47-50cd-b752-fad1aa17e5ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4194dc2e-82ad-5109-91f4-d383eed4b18e" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{6}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=6$, and we get\n\n$$\n\\int {x}^{6}\\,\\text{d}x=\\frac{{x}^{6+1}}{6+1}+C=\\frac{{x}^{7}}{7}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{7}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{7}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7})+0 \\\\ &= \\frac{1}{7}\\cdot 7{x}^{6} \\\\ &= {x}^{6}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} {:answer/id #uuid "0b7b7de0-eaf8-57d9-8475-c23f72194dd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{8}" :db/id #edb/ref 17592186503844} {:answer/id #uuid "a5bb73e6-3ec8-51dd-ad3b-1cd6d6243b7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 + C" :db/id #edb/ref 17592186503862} {:answer/id #uuid "b52194ac-60ec-5ec7-91b2-c8a58426c3e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}" :db/id #edb/ref 17592186503866} {:answer/id #uuid "f1d839d9-d182-5a2a-8ca4-8961f79ffaae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{8} + C" :db/id #edb/ref 17592186503874}] :answer-field/correct {:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} :answer-field/id #uuid "88eaa69f-9171-51b9-9926-45e937a2ad36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fc55d29-07c8-58f3-8bc8-d1223d0589d0" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{7}\\,\\text{d}x.\n$$ Include the arbitrary constant of integration." :question/worked-solution "We apply the power rule with $n=7$, and we get\n\n$$\n\\int {x}^{7}\\,\\text{d}x=\\frac{{x}^{7+1}}{7+1}+C=\\frac{{x}^{8}}{8}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{8}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{8}}{8}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{8}\\frac{\\text{d}}{\\text{d}x}({x}^{8})+0 \\\\ &= \\frac{1}{8}\\cdot 8{x}^{7} \\\\ &= {x}^{7}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081fa2f5-42b3-5c04-80c9-10a003c271a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x^{4} + C" :db/id #edb/ref 17592186503843} {:answer/id #uuid "4a21e63a-5ffd-51d5-a90e-548e77d4bab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6} + C" :db/id #edb/ref 17592186503849} {:answer/id #uuid "7015537d-a311-57e0-815f-dece8e7c2eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{6} + C" :db/id #edb/ref 17592186503853} {:answer/id #uuid "84bc4aa5-c9e8-54dc-9352-f633e5591d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5} + C" :db/id #edb/ref 17592186503857} {:answer/id #uuid "dd56a3a8-a755-5234-b43f-e287021340e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{4} + C" :db/id #edb/ref 17592186503870}] :answer-field/correct {:answer/id #uuid "4a21e63a-5ffd-51d5-a90e-548e77d4bab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6} + C" :db/id #edb/ref 17592186503849} :answer-field/id #uuid "51200684-dca8-5045-9aea-e16255caa7bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503852}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "74bb6151-9d7e-5db4-9d07-e87c336986aa" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{5}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=5$, and we get\n\n$$\n\\int {x}^{5}\\,\\text{d}x=\\frac{{x}^{5+1}}{5+1}+C=\\frac{{x}^{6}}{6}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{6}}{6}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{6}}{6}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{6}\\frac{\\text{d}}{\\text{d}x}({x}^{6})+0 \\\\ &= \\frac{1}{6}\\cdot 6{x}^{5} \\\\ &= {x}^{5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19401952-b969-5a9f-9750-1720c3ea9602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9} + C" :db/id #edb/ref 17592186503845} {:answer/id #uuid "3d942c43-21e5-5ec4-b609-785240316ce4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{7} + C" :db/id #edb/ref 17592186503847} {:answer/id #uuid "7ff916ab-3641-575c-b8ab-d8ce83a4174b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{9} + C" :db/id #edb/ref 17592186503856} {:answer/id #uuid "90147ce6-5ad4-56fc-aa26-0fc98c813215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/