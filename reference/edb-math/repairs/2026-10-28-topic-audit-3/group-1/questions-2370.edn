id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186718562}] :answer-field/correct {:answer/id #uuid "88c18244-a39c-5a88-8fa3-9fdcc3ee3a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186718562} :answer-field/id #uuid "f82a635b-38bd-5c33-a58d-69e101ad8c81" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186718586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "15c05e8b-32b7-5b8f-ab72-09c9631e2af6" :question/problem "Which of the following vector fields are conservative on $\\mathbb R^2$? Select all that apply." :question/worked-solution "All components have continuous first partial derivatives on $\\mathbb R^2$. Polynomial, exponential, trigonometric and arctangent functions are smooth here; any logarithm has positive argument and any denominator is strictly positive. Thus $\\mathbf V=P\\,\\mathbf i+Q\\,\\mathbf j$ is **conservative** exactly when $P_y=Q_x$ everywhere.\n\nFor $\\mathbf F$, differentiate each component with respect to the indicated variable:\n\n$$\n\\begin{aligned}P&=\\cos{\\left(x + y \\right)} - 1,\\\\Q&=\\cos{\\left(x + y \\right)} + 1,\\\\P_y&=- \\sin{\\left(x + y \\right)},\\\\Q_x&=- \\sin{\\left(x + y \\right)}.\\end{aligned}\n$$\n\n$P_y=Q_x$ is an identity, so $\\mathbf F$ is conservative.\n\nFor $\\mathbf G$, differentiate each component with respect to the indicated variable:\n\n$$\n\\begin{aligned}P&=2 x \\ln{\\left(y^{2} + 1 \\right)} - x,\\\\Q&=- \\frac{3 x^{2} y}{y^{2} + 1} - y - 1,\\\\P_y&=\\frac{4 x y}{y^{2} + 1},\\\\Q_x&=- \\frac{6 x y}{y^{2} + 1}.\\end{aligned}\n$$\n\nThe derivatives are not equal everywhere, so $\\mathbf G$ is not conservative. At $(1,1)$, the difference is $5\\ne0$.\n\nFor $\\mathbf H$, differentiate each component with respect to the indicated variable:\n\n$$\n\\begin{aligned}P&=2 e^{x - 2 y} - 1,\\\\Q&=1 - 4 e^{x - 2 y},\\\\P_y&=- 4 e^{x - 2 y},\\\\Q_x&=- 4 e^{x - 2 y}.\\end{aligned}\n$$\n\n$P_y=Q_x$ is an identity, so $\\mathbf H$ is conservative.\n\nSelect $\\mathbf F$, $\\mathbf H$."}] [{:db/id #edb/ref 17592186718540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79535288-5fc4-5b3e-b344-1558d2907d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186718558} {:answer/id #uuid "9e39051b-fb2a-5990-9d85-52266eec503b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186718567}] :answer-field/correct {:answer/id #uuid "79535288-5fc4-5b3e-b344-1558d2907d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186718558} :answer-field/id #uuid "042a16b9-d3fa-52bb-966c-fe851c72d558" :answer-field/key "$\\mathbf H=$ $\\left(2 \\cos{\\left(2 x + y \\right)} + 1\\right)\\,\\mathbf i$ $+\\left(3 \\cos{\\left(2 x + y \\right)}\\right)\\,\\mathbf j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186718526} {:answer-field/choices [{:answer/id #uuid "5f75d952-4bd4-595b-a4b9-92accc60692b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186718549} {:answer/id #uuid "abb57554-2587-5a3a-b5b0-4f2f9587b673" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186718569}] :answer-field/correct {:answer/id #uuid "abb57554-2587-5a3a-b5b0-4f2f9587b673" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186718569} :answer-field/id #uuid "361b8fc6-1264-5c7a-9acb-22daf6db64d6" :answer-field/key "None of the above" :answer-field/type {:db