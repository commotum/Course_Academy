186503914} {:db/id #edb/ref 17592186514388} {:db/id #edb/ref 17592186514390} {:db/id #edb/ref 17592186541073} {:db/id #edb/ref 17592186541115} {:db/id #edb/ref 17592186585088} {:db/id #edb/ref 17592186587304} {:db/id #edb/ref 17592186632107} {:db/id #edb/ref 17592186632110} {:db/id #edb/ref 17592186632112} {:db/id #edb/ref 17592186632114} {:db/id #edb/ref 17592186632119}] :knowledge-point/title "Finding the Antiderivative of a Radical Function"}] [{:db/id #edb/ref 17592186064169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064040} :knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725828} :knowledge-point/questions [{:db/id #edb/ref 17592186064722} {:db/id #edb/ref 17592186064723} {:db/id #edb/ref 17592186233179} {:db/id #edb/ref 17592186233751} {:db/id #edb/ref 17592186233752} {:db/id #edb/ref 17592186234299} {:db/id #edb/ref 17592186502863} {:db/id #edb/ref 17592186502872} {:db/id #edb/ref 17592186502876} {:db/id #edb/ref 17592186502879} {:db/id #edb/ref 17592186502887} {:db/id #edb/ref 17592186502891} {:db/id #edb/ref 17592186502900} {:db/id #edb/ref 17592186502914} {:db/id #edb/ref 17592186502920} {:db/id #edb/ref 17592186502921} {:db/id #edb/ref 17592186502927} {:db/id #edb/ref 17592186502931} {:db/id #edb/ref 17592186502938} {:db/id #edb/ref 17592186502948} {:db/id #edb/ref 17592186502954} {:db/id #edb/ref 17592186514383} {:db/id #edb/ref 17592186514391} {:db/id #edb/ref 17592186541140} {:db/id #edb/ref 17592186632818} {:db/id #edb/ref 17592186632820} {:db/id #edb/ref 17592186632821} {:db/id #edb/ref 17592186632827} {:db/id #edb/ref 17592186632847}] :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] [{:db/id #edb/ref 17592186064196 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064068} :knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049481}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/questions [{:db/id #edb/ref 17592186064712} {:db/id #edb/ref 17592186064716} {:db/id #edb/ref 17592186233753} {:db/id #edb/ref 17592186233949} {:db/id #edb/ref 17592186297245} {:db/id #edb/ref 17592186297435} {:db/id #edb/ref 17592186317475} {:db/id #edb/ref 17592186341925} {:db/id #edb/ref 17592186536821} {:db/id #edb/ref 17592186541063}] :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] [{:db/id #edb/ref 17592186064197 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064069} :knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186064853} {:db/id #edb/ref 17592186064854} {:db/id #edb/ref 17592186233950} {:db/id #edb/ref 17592186233951} {:db/id #edb/ref 17592186250147} {:db/id #edb/ref 17592186297246} {:db/id #edb/ref 17592186297436} {:db/id #edb/ref 17592186332679} {:db/id #edb/ref 17592186332680}] :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] [{:db/id #edb/ref 17592186064198 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064070} :knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186064714} {:db/id #edb/ref 17592186064855} {:db/id #edb/ref 17592186233754} {:db/id #edb/ref 17592186233804} {:db/id #edb/ref 17592186233952} {:db/id #edb/ref 17592186297239} {:db/id #edb/ref 17592186297240} {:db/id #edb/ref 17592186317484} {:db/id #edb/ref 17592186317485} {:db/id #edb/ref 17592186317507}] :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] [{:db/id #edb/ref 17592186065372 :tutorial/content "To compute the integral of any power function $x^n,$ where $n \\neq -1,$ we can use the **power rule for integration**. The power rule for integration states that\n\n$$\n\\int x^n\\, \\textrm{d}x = \\dfrac {x^{n + 1}}{n + 1} + C,\n$$\n\nwhere $C$ is any constant and $n\\neq -1.$ For example, in the case of $n=3,$ we have\n\n$$\n\\begin{aligned}\\int {x}^{3}\\,\\text{d}x & =\\frac{{x}^{3+1}}{3+1}+C \\\\  & =\\frac{{x}^{4}}{4}+C.\\end{aligned}\n$$\n\nSo the **antiderivative** of $f'(x) = x^3$ is $f(x) = \\dfrac {x^{4}}{4}+C .$ \n\nWe can check that this is the correct answer by taking the derivative of $f(x)$ and seeing that it is indeed equal to $x^3\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{4}}{4}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{4}}{4}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{4}(\\frac{\\text{d}}{\\text{d}x}{x}^{4})+0 \\\\ &= \\frac{1}{4}\\cdot 4{x}^{4-1} \\\\ &= {x}^{3}\\hspace{1em}{\\color{green}✓}\\end{aligned}\n$$\n\nNotice that the constant $C$ disappeared when we differentiated because the derivative of any constant is zero. We always add $+C$ whenever we find the antiderivative of a function because we know that it will disappear when we differentiate.\n\n**Note:** The power rule for integration is just the power rule for differentiation in reverse!\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x} \\left( x^{n+1} \\right) = (n+1)x^n \\quad \\Leftrightarrow \\quad \\displaystyle \\int x^n \\, \\textrm dx = \\dfrac{x^{n+1}}{n+1}\n$$" :tutorial/id #uuid "9f08a264-7a79-50c1-afb0-903bb2a256f1" :tutorial/math-academy-id 3852 :tutorial/title "The Power Rule for Integration"}] [{:db/id #edb/ref 17592186065405 :tutorial/content "An **antiderivative** is the *opposite* of a derivative. For example:\n\n- Using the power rule, we know that the *derivative* of $\\color{blue}x^2$ is ${\\color{red}2x}.$\n\n- Going in the *opposite* direction, we say that an **antiderivative** of $\\color{red}2x$ is ${\\color{blue}x^2}.$\n\nFor any given function, there are infinitely many antiderivatives. For example:\n\n- The derivative of $\\color{blue}x^2$ is ${\\color{red}2x},$ so an *antiderivative* of $\\color{red}2x$ is ${\\color{blue}x^2}.$\n\n- The derivative of $\\color{blue}x^2+1$ is ${\\color{red}2x},$ so another *antiderivative* of $\\color{red}2x$ is ${\\color{blue}x^2+1}.$\n\n- The derivative of $\\color{blue}x^2+2$ is ${\\color{red}2x},$ so another *antiderivative* of $\\color{red}2x$ is ${\\color{blue}x^2+2}.$\n\n- ...\n\nIn general, all the antiderivatives of $\\color{red}2x$ can be written in the form ${\\color{blue}x^2+C},$ where $C$ is a constant.\n\nTo represent the antiderivative symbolically, we use a special symbol $\\displaystyle \\int$ called the **integral** symbol. So, using **integral notation**, we can write\n\n$$\n\\int 2x \\, \\textrm d x = x^2 + C\n$$\n\nwhere $C$ represents an arbitrary constant and is called the **constant of integration**.\n\nIn words, $$\n\\displaystyle \\int 2x \\, \\textrm d x\n$$ is said as “the integral of $2x$ with respect to $x$” or “the antiderivative of $2x$.” Integrals like this are called **indefinite integrals**, and the function being **integrated** ($2x$ in this case) is called the **integrand**." :tutorial/id #uuid "a31b3485-463c-59da-8118-836cf7949efc" :tutorial/math-academy-id 691 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186065406 :tutorial/content "Let's recap the main points:\n\n- Integrals like $$\n\\displaystyle \\int x^3\\,\\textrm d x\n$$ are called **indefinite integrals**.\n\n- Whenever we calculate an indefinite integral, we must always remember to add an **arbitrary constant** $+C.$\n\n- To integrate power functions, we can use the **power rule for integration**, which states that\n\n$$\n\\int x^n\\,\\textrm d x = \\dfrac{x^{n+1}}{n+1} + C,\n$$\n\nprovided that $n \\neq -1.$ To emphasize, the power rule does *not* work when $n=-1.$ So we cannot use the above formula to work out $$\n\\displaystyle \\int \\dfrac{1}{x}\\,\\textrm d x.\n$$ Integrals like this need to be handled differently, and you'll find out how soon." :tutorial/id #uuid "a0806909-50b1-5a35-9ff6-fa9e18aa5c23" :tutorial/math-academy-id 697 :tutorial/title "Some Final Notes on Indefinite Integrals and Constants"}] [{:db/id #edb/ref 17592186065411 :tutorial/content "Consider the function $f(x) = x^2.$ The **definite integral** **of** $\\mathbf f(x)$ **between** $\\mathbf{x=1}$ and $\\mathbf{x=2}$ is denoted\n\n$$\n\\int_1^2 x^2 \\, \\textrm d x.\n$$\n\nGeometrically, this definite integral can be interpreted as the **signed area** bounded between the curve $y=f(x),$ the lines $x=1$ and $x=2,$ and the $x$-axis, as shown below.\n\n![](images/fd/fdff7865deed3d5329495bac5dfe045fefca9c09c6fccb7cd02b73d40de8bf69.png)\n\nThe area is taken as positive (with a plus sign) if the corresponding region lies above the $x$-axis and as negative (with a minus sign) if the region lies below the $x$-axis. \n\nTo calculate this area, we use a theorem known as the **fundamental theorem of calculus**, which states the following:\n\n> *If $f(x)$ is a function that's continuous on an interval $[a,b]$, and there exists a function $F(x)$ such that $F'(x) = f(x)$ on $[a,b]$, then*\n\n$$\n\\int_a^b f(x)\\,\\textrm{d}x = F(b) - F(a).\n$$\n\nSo how do we use this to calculate our definite integral $$\n\\displaystyle \\int_1^2 x^2\\,\\textrm{d}x?\n$$ We just need to follow a few steps:\n\n **Step 1**: Find the *indefinite* integral (also known as the antiderivative) of the function using the power rule. We can ignore the constant of integration.\n\n$$\n\\int x^2 \\, \\textrm d x = \\dfrac{x^3}{3}\n$$\n\n \n\n**Step 2**: Write the lower and upper limit next to the result.\n\n$$\n\\int_1^2 x^2 \\, \\textrm d x = \\dfrac{x^3}{3}\\Bigg|_{\\color{red}1}^{\\color{blue}2}\n$$\n\n \n\n**Step 3**: Evaluate the antiderivative between the upper and lower limit, and subtract them.\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x & =\\frac{(2)^{3}}{3}-\\frac{(1)^{3}}{3} \\\\  & =\\frac{8}{3}-\\frac{1}{3} \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\int_1^2 f(x)\\,\\textrm{d}x = \\dfrac73.\n$$" :tutorial/id #uuid "f56a418c-ec4e-53fe-a09f-f086cc850717" :tutorial/math-academy-id 766 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186083240 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083054} :knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048191} {:db/id #edb/ref 17592186048293} {:db/id #edb/ref 17592186051084}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186676102} :knowledge-point/questions [{:db/id #edb/ref 17592186083909} {:db/id #edb/ref 17592186083911} {:db/id #edb/ref 17592186290260} {:db/id #edb/ref 17592186321110} {:db/id #edb/ref 17592186321111} {:db/id #edb/ref 17592186321112} {:db/id #edb/ref 17592186321113} {:db/id #edb/ref 17592186321114} {:db/id #edb/ref 17592186321115} {:db/id #edb/ref 17592186335950} {:db/id #edb/ref 17592186335953} {:db/id #edb/ref 17592186335963} {:db/id #edb/ref 17592186368467} {:db/id #edb/ref 17592186395776} {:db/id #edb/ref 17592186401840} {:db/id #edb/ref 17592186401853} {:db/id #edb/ref 17592186403272} {:db/id #edb/ref 17592186403279} {:db/id #edb/ref 17592186522901} {:db/id #edb/ref 17592186522908} {:db/id #edb/ref 17592186522915} {:db/id #edb/ref 17592186522916} {:db/id #edb/ref 17592186522919} {:db/id #edb/ref 17592186522920} {:db/id #edb/ref 17592186541058} {:db/id #edb/ref 17592186578802} {:db/id #edb/ref 17592186578804} {:db/id #edb/ref 17592186578844} {:db/id #edb/ref 17592186616136} {:db/id #edb/ref 17592186639425} {:db/id #edb/ref 17592186639426} {:db/id #edb/ref 17592186639432} {:db/id #edb/ref 17592186639439} {:db/id #edb/ref 17592186639442}] :knowledge-p