#{[{:db/id #edb/ref 17592186573310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "564f131c-8153-5250-b192-4b9c01928dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,4⟩" :db/id #edb/ref 17592186572924} {:answer/id #uuid "6a83b317-aff4-5937-af17-51947b81c9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,-2⟩" :db/id #edb/ref 17592186572955} {:answer/id #uuid "9583fb5a-80a8-59d4-8f69-e42a4c690518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,-6⟩" :db/id #edb/ref 17592186573020} {:answer/id #uuid "b3488a28-3a50-53c3-80e7-a44957ccecfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-4⟩" :db/id #edb/ref 17592186573053} {:answer/id #uuid "e7674bcd-8b37-50a7-9442-93d15edfb14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,-6⟩" :db/id #edb/ref 17592186573120}] :answer-field/correct {:answer/id #uuid "b3488a28-3a50-53c3-80e7-a44957ccecfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-4⟩" :db/id #edb/ref 17592186573053} :answer-field/id #uuid "dbdfce8f-abfe-53cb-9705-5a4369c47f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d424dcb1-177c-5053-898f-bbc5de5cd766" :question/math-academy-id "q-125100" :question/problem "If $\\overset{\\to }{u}=⟨4,-3⟩$ and $\\overset{\\to }{v}=⟨-1,2⟩$, then $2\\overset{\\to }{u}+\\overset{\\to }{v}=$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2\\overset{\\to }{u}+\\overset{\\to }{v} & =2\\cdot ⟨4,-3⟩+⟨-1,2⟩ \\\\  & =⟨8,-6⟩+⟨-1,2⟩ \\\\  & =⟨8+(-1),-6+2⟩ \\\\  & =⟨8-1,-6+2⟩ \\\\  & =⟨7,-4⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56b0dd0c-9d63-5a70-95a6-dd376b0a0954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186572926}] :answer-field/correct {:answer/id #uuid "56b0dd0c-9d63-5a70-95a6-dd376b0a0954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186572926} :answer-field/id #uuid "b37d9201-7dcf-5a89-a52b-32dccf01ca00" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573214} {:answer-field/choices [{:answer/id #uuid "83567ae1-8427-57f7-8486-981e82916dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186572994}] :answer-field/correct {:answer/id #uuid "83567ae1-8427-57f7-8486-981e82916dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186572994} :answer-field/id #uuid "beab0d67-6115-58a0-9692-4c292e4251e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df07f0e4-b8c0-55c8-a0ad-afd25f375b3a" :question/math-academy-id "q-318154" :question/problem "Let $a=\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}$, $b=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}$ and $c=\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}.$ Find $\\,4a-(3b-2c).$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$4a-(3b-2c)=\\,\\,$</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}4a-(3b-2c) & =4\\,\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}-(3\\,\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}-2\\,\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 12\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}8 \\\\ -24\\end{bmatrix} \\\\  & =\\begin{bmatrix}-28 \\\\ 36\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43933ff3-b395-51e7-8924-620a4c146889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186572907}] :answer-field/correct {:answer/id #uuid "43933ff3-b395-51e7-8924-620a4c146889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186572907} :answer-field/id #uuid "b1fda064-c5be-50c8-a2f2-f2d149b07722" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573212} {:answer-field/choices [{:answer/id #uuid "9c8fa3e0-6c1a-5d67-b34a-c41929e26ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186573027}] :answer-field/correct {:answer/id #uuid "9c8fa3e0-6c1a-5d67-b34a-c41929e26ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186573027} :answer-field/id #uuid "dbc685a7-f84f-5c19-84d2-5848ae5fa567" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573232}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e78eae91-aaf3-5f8b-9296-2cbaa295070f" :question/math-academy-id "q-318160" :question/problem "If $\\overset{\\to }{m}=⟨-6,2⟩$ and $\\overset{\\to }{n}=⟨5,-8⟩$, then $\\overset{\\to }{m}-\\overset{\\to }{n}=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{m}-\\overset{\\to }{n} & =⟨-6,2⟩-⟨5,-8⟩ \\\\  & =⟨-6-5,\\,2-(-8)⟩ \\\\  & =⟨-11,10⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573319 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3290ffd6-cd8a-5db9-a4bc-56849cc44a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186572878}] :answer-field/correct {:answer/id #uuid "3290ffd6-cd8a-5db9-a4bc-56849cc44a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186572878} :answer-field/id #uuid "4c125323-8ab4-59de-9fc3-25accadfde30" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573177} {:answer-field/choices [{:answer/id #uuid "47784222-c406-5602-89f9-166ab8dbf072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186572912}] :answer-field/correct {:answer/id #uuid "47784222-c406-5602-89f9-166ab8dbf072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186572912} :answer-field/id #uuid "84c301b6-7fb7-52a7-ae5e-3c748146d665" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573198}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee2b51f4-f377-5233-82c8-37f171607ed7" :question/math-academy-id "q-318128" :question/problem "If $a=⟨-4,6⟩$ and $b=⟨3,-5⟩$, then $a-b=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" :question/worked-solution "To compute $a-b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-b & =⟨-4,6⟩-⟨3,-5⟩ \\\\  & =⟨-4-3,6-(-5)⟩ \\\\  & =⟨-7,11⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4238841a-e6fd-5b61-9bb7-9b81cecfd441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186578380} {:answer/id #uuid "58c5d980-f308-55bb-b6dc-33f198a88f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186578414} {:answer/id #uuid "6098c79c-346b-5248-8398-6ba51720d41a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186578431} {:answer/id #uuid "d226f22a-73aa-5bd5-8ffb-659b107ef567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186578600} {:answer/id #uuid "f869162a-a3a8-5474-8b17-6aeb207f63c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186578669}] :answer-field/correct {:answer/id #uuid "f869162a-a3a8-5474-8b17-6aeb207f63c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186578669} :answer-field/id #uuid "a897637f-a103-5c3f-81b6-65711f8a97e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578753}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08b30b3b-db11-543f-b5eb-089393bd6bb2" :question/math-academy-id "q-15470" :question/problem "For the parametric curve \n\n$$\nx={e}^{t}-{e}^{-t},\\,y=t{e}^{t},\\,-\\infty <t<\\infty ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=0.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)={e}^{t}+{e}^{-t},\\,{y}^{′}(t)=(t+1){e}^{t}.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{(t+1){e}^{t}}{{e}^{t}+{e}^{-t}} \\\\  & =\\frac{1+t}{1+{e}^{-2t}}.\\end{aligned}\n$$\n\nTherefore, when $t=0,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1+0}{1+{e}^{-0}} \\\\  & =\\frac{1}{2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "389a5696-c840-56e0-8558-733de5240472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186578361} {:answer/id #uuid "4017febd-50d6-5503-af7a-ff948aace873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186578378} {:answer/id #uuid "98cc3f2f-f840-5de8-acdb-83f201a4880d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186578515} {:answer/id #uuid "aaab6afb-3ab3-5a9f-849c-a2ad0e12fb8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186578543} {:answer/id #uuid "f37683f8-f240-5221-9235-386d2ba6e331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186578662}] :answer-field/correct {:answer/id #uuid "389a5696-c840-56e0-8558-733de5240472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186578361} :answer-field/id #uuid "ce157c42-a9a4-5ec7-af0b-682ed5561091" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20010f38-3e5e-5e3e-a89d-c3c51d40861a" :question/math-academy-id "q-20989" :question/problem "![](images/0b/0bd043f0ff9b6cc575d7912776bd0aaa41dc161b32304115cf6c8dedba86f81a.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=3\\operatorname{sin}⁡2t,\\,y=4\\operatorname{cos}⁡2t,\\,0\\le t<2\\pi ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=\\frac{\\pi }{8}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=6\\operatorname{cos}⁡2t,\\,{y}^{′}(t)=-8\\operatorname{sin}⁡2t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{-8\\operatorname{sin}⁡2t}{6\\operatorname{cos}⁡2t}=-\\frac{4}{3}\\operatorname{tan}⁡2t.\n$$\n\nAt the point where $t=\\frac{\\pi }{8}$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{4}{3}\\cdot \\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =-\\,\\frac{4}{3}\\cdot \\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =-\\,\\frac{4}{3}\\cdot 1 \\\\  & =-\\,\\frac{4}{3}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e9c511-8886-5f56-8ee7-6556baca60f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186578309} {:answer/id #uuid "2ef85eba-7368-57c1-8685-8d542b3d4d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{\\pi +1}" :db/id #edb/ref 17592186578345} {:answer/id #uuid "9f3946a4-4840-5c17-bc49-b6cd5ef2faaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{3\\pi +1}" :db/id #edb/ref 17592186578524} {:answer/id #uuid "e0c0fa7e-1c3b-5c73-8f6c-dd538719b8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186578631} {:answer/id #uuid "f30dcc98-6482-51c6-8828-44cf84a10887" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{3}{\\pi }" :db/id #edb/ref 17592186578659}] :answer-field/correct {:answer/id #uuid "e0c0fa7e-1c3b-5c73-8f6c-dd538719b8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186578631} :answer-field/id #uuid "3bfbeb97-b5a7-5edb-811c-c6fd832edf47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21abfc2b-1c65-57da-8fcf-53cc0cb791f0" :question/math-academy-id "q-6840" :question/problem "For the parametric curve \n\n$$\nx=t\\operatorname{sin}⁡t,\\,y=3\\operatorname{cos}⁡t,\\,-\\infty <t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=\\frac{\\pi }{2}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,{y}^{′}(t)=-3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{-3\\operatorname{sin}⁡t}{t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}=-\\frac{3}{t\\operatorname{cot}⁡t+1}.\n$$\n\nAt the point where $t=\\frac{\\pi }{2}$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{3}{\\left(\\frac{\\pi }{2}\\right)\\operatorname{cot}⁡\\frac{\\pi }{2}+1} \\\\  & =-\\,\\frac{3}{\\left(\\frac{\\pi }{2}\\right)\\cdot 0+1} \\\\  & =-\\,3\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2ee053-4ac9-5907-8967-107610ee1cf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186578318} {:answer/id #uuid "3cf9859f-7190-5b4a-9b1c-0d332479daeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186578368} {:answer/id #uuid "5f5471cf-39c9-57da-8b25-92ea610ee7b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186578426} {:answer/id #uuid "8f46d6ae-1324-5217-a00b-81747e796c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{13}" :db/id #edb/ref 17592186578504} {:answer/id #uuid "c7633560-8973-5686-88cd-7be9b7f74ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{11}" :db/id #edb/ref 17592186578580}] :answer-field/correct {:answer/id #uuid "8f46d6ae-1324-5217-a00b-81747e796c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{13}" :db/id #edb/ref 17592186578504} :answer-field/id #uuid "4988bf56-303b-59a6-9f79-eb24f4974217" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c906060-00dc-59ed-b471-aa166bd736b1" :question/math-academy-id "q-20987" :question/problem "![](images/b1/b165889c6169a417f4d56f544aec8a049685693ff2b01ea13d51a9f4d841be4c.png)\n\nFor the parametric curve (shown above)\n\n$$\nx={t}^{3}-t,\\,y={t}^{2}-4,\\,-\\infty <t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=3.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=3{t}^{2}-1,\\,{y}^{′}(t)=2t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{2t}{3{t}^{2}-1}.\n$$\n\nAt the point where $t=3$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{2\\cdot 3}{3({3}^{2})-1} \\\\  & =\\frac{6}{27-1} \\\\  & =\\frac{3}{13}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f8b02c-3c71-509f-93de-e4a3c2bb07cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186578646}] :answer-field/correct {:answer/id #uuid "e9f8b02c-3c71-509f-93de-e4a3c2bb07cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186578646} :answer-field/id #uuid "8b9a1810-6a6d-5eb5-883e-8d03107298a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df476431-ab3a-5147-98f8-ef5f1e16d04c" :question/math-academy-id "q-353353" :question/problem "![](images/85/853358cc3207d3f2738ecc3bd2ee6391d62b1a51735c43e16f37a2b83414800e.png)\n\nFor the parametric curve \n\n$$\nx=\\operatorname{ln}⁡(3t+1),\\,y=t{e}^{t},\\,-\\frac{1}{3}<t<\\infty ,\n$$\n\nshown above, calculate the slope $m$ of the tangent to the curve at the point where $t=0.$ Do not round the answer.\n\n$m=$ \n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\frac{3}{3t+1},\\,{y}^{′}(t)=(t+1){e}^{t}.\n$$\n\n \n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{(t+1){e}^{t}}{\\left(\\frac{3}{3t+1}\\right)} \\\\  & =\\frac{(t+1)(3t+1){e}^{t}}{3}.\\end{aligned}\n$$\n\nTherefore, when $t=0,$ the slope $m$ of the tangent to the curve is\n\n$$\n\\begin{aligned}m=\\frac{dy}{dx}\\,{|}_{t\\,=\\,0} & =\\frac{(0+1)(0+1){e}^{0}}{3} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0825b7a7-74a7-5935-86cd-1b0bba712bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186578285} {:answer/id #uuid "5348801e-a631-5d23-93d5-012769dd8d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186578403} {:answer/id #uuid "600a5309-7bc1-513f-8449-5d85d2a64fd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186578428} {:answer/id #uuid "b432d866-9d8e-5893-a7c9-658ab974d99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186578554} {:answer/id #uuid "d843b8af-69d9-5879-a337-8dde5a272ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186578610}] :answer-field/correct {:answer/id #uuid "b432d866-9d8e-5893-a7c9-658ab974d99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186578554} :answer-field/id #uuid "940ee680-1c54-57c6-9fe1-a296cc68c0ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578743}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ef5ed0c9-8fa3-5025-804c-fe51ae9e2b6d" :question/math-academy-id "q-15477" :question/problem "For the parametric curve \n\n$$\nx={sec}^{2}⁡t,\\,y={csc}^{3}⁡t,\\,0<t<\\frac{\\pi }{2},\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{4}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2{sec}^{2}⁡t\\operatorname{tan}⁡t,\\,{y}^{′}(t)=-3{csc}^{3}⁡t\\operatorname{cot}⁡t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{-3{csc}^{3}⁡t\\operatorname{cot}⁡t}{2{sec}^{2}⁡t\\operatorname{tan}⁡t} \\\\  & =-3{csc}^{3}⁡t\\operatorname{cot}⁡t\\left(\\frac{{cos}^{2}⁡t\\operatorname{cot}⁡t}{2}\\right) \\\\  & =-\\frac{3}{2}\\,{csc}^{3}⁡t{cot}^{2}⁡t{cos}^{2}⁡t \\\\  & =-\\frac{3}{2}\\left(\\frac{1}{{sin}^{3}⁡t}\\right)\\left(\\frac{{cos}^{2}⁡t}{{sin}^{2}⁡t}\\right){cos}^{2}⁡t \\\\  & =-\\frac{3}{2}\\left(\\frac{{cos}^{4}⁡t}{{sin}^{5}⁡t}\\right) \\\\  & =-\\frac{3}{2}\\,\\operatorname{csc}⁡t{cot}^{4}⁡t\\,.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{4},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\frac{3}{2}\\,\\operatorname{csc}⁡\\left(\\frac{\\pi }{4}\\right){cot}^{4}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =-\\frac{3}{2}\\cdot \\sqrt{2}\\cdot 1 \\\\  & =-\\frac{3}{\\sqrt{2}}\\, \\\\  & =-\\frac{3\\sqrt{2}}{2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186585050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0012df66-6c3a-56e7-97f9-81c911e4f8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186584509} {:answer/id #uuid "315bcdfa-609f-5ea8-a49d-f1f681058e2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186584587} {:answer/id #uuid "35005662-9637-57d8-bf50-f9cc645046e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186584595} {:answer/id #uuid "7cb16e21-2088-5cac-b812-f5d40618ed91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186584695} {:answer/id #uuid "dd0fe9cc-c568-59dc-89ad-d4f105afbefb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186584854}] :answer-field/correct {:answer/id #uuid "0012df66-6c3a-56e7-97f9-81c911e4f8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186584509} :answer-field/id #uuid "53c4d569-b552-58bd-9b8f-60dd65158d7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4171e45c-1d76-5083-ab47-db9029aa8919" :question/math-academy-id "q-129060" :question/problem "The level curves of the function $f(x,y)=x{y}^{2}-{x}^{2}y$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=-1$ gives a parabola\n\nII. $c=0$ gives the $y$-axis, the $x$-axis and the line $y=x$\n\nIII. $c=1$ gives the line $y=2x$" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}x{y}^{2}-{x}^{2}y & =c \\\\ xy(y-x) & =c\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1,$ the level curve is $xy(y-x)=-1,$ which is not a parabola. So, I is false.\n\n- If $c=0,$ the level curve is $xy(y-x)=0,$ which gives the $y$-axis, the $x$-axis and the line $y=x.$ So, II is true.\n\n- If $c=1,$ the level curve is $xy(y-x)=1,$ which is not the line $y=2x.$ So, III is false.\n\nSo, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186585088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517}] :answer-field/correct {:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517} :answer-field/id #uuid "d2400e32-0626-57f4-aa86-36f297e53f28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585001}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94477f44-1be5-5969-98a4-26af9184571a" :question/math-academy-id "q-167646" :question/problem "The antiderivative of $\\sqrt[6]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[6]{x}={x}^{1/6}$, we can apply the power rule with $n=\\frac{1}{6}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/6}\\,\\text{d}x & =\\frac{{x}^{1/6+1}}{(\\frac{1}{6}+1)}+C \\\\  & =\\frac{{x}^{7/6}}{\\left(\\frac{7}{6}\\right)}+C \\\\  & =\\frac{6{x}^{7/6}}{7}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{7/6}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{6{x}^{7/6}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{6}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/6})+0 \\\\ &= \\frac{6}{7}\\cdot \\frac{7}{6}{x}^{7/6-1} \\\\ &= {x}^{1/6}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733}] :answer-field/correct {:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733} :answer-field/id #uuid "3d10d539-8c5e-514d-8877-3d19db95faab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587183}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efb6512-0e32-57d7-9bcc-102471dd5cbb" :question/math-academy-id "q-167541" :question/problem "The antiderivative of $\\sqrt[4]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[4]{x}={x}^{1/4}$, we can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating: \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{5/4}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 \\\\ &= \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} \\\\ &= {x}^{1/4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186590066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60983a3b-640e-5929-9231-408eaeffb73f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2}" :db/id #edb/ref 17592186589462} {:answer/id #uuid "6deafb26-8a2b-56fa-b018-a1064b792c87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186589489} {:answer/id #uuid "a6eb7e37-e62f-56fc-aaf6-2dfa78349065" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186589607} {:answer/id #uuid "e5c7c37a-f49d-58e3-9ee2-364d62709dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2}" :db/id #edb/ref 17592186589738} {:answer/id #uuid "f6dab76e-3ea7-5f1d-8494-a4ced94a7c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186589780}] :answer-field/correct {:answer/id #uuid "a6eb7e37-e62f-56fc-aaf6-2dfa78349065" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186589607} :answer-field/id #uuid "ff6d8f8b-f38e-585c-afa9-53a4052ca6f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186589970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e494bcd2-c935-5682-9b4b-f7adb27c6c12" :question/math-academy-id "q-75270" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=5{e}^{3t},\\,y=6{t}^{2}-9,\\,0\\le t\\le 2.\n$$\n\nDetermine the value of the parameter $t$ at which the normal line to the curve is vertical." :question/worked-solution "The normal line is vertical when the tangent to the curve is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=15{e}^{3t},\\,{y}^{′}(t)=12t\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n12t=0\\,⟹\\,t=0.\n$$\n\nNow, we note that\n\n$$\n{x}^{′}(0)=15{e}^{3\\cdot 0}=15\\ne 0,\\,\\,\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=0.$"}] [{:db/id #edb/ref 17592186592241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec04919-851c-5f1c-955b-e2ff97fdf5f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186591815} {:answer/id #uuid "179118cd-8436-5fb0-9d7f-dcce778b3766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186591825} {:answer/id #uuid "83672e87-80c5-5786-a4c9-02556e774a35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186591969} {:answer/id #uuid "e4fef352-25c1-5611-b453-4c7c29fa7623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186592108} {:answer/id #uuid "e6683a70-94fb-5b5c-9555-12c8a50c3815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186592110}] :answer-field/correct {:answer/id #uuid "179118cd-8436-5fb0-9d7f-dcce778b3766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186591825} :answer-field/id #uuid "0de6d142-7706-50b2-ae89-6ca03ca1279e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186592155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1de59b11-3c24-56b4-ab0a-82d3c06932c8" :question/math-academy-id "q-69658" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-v & 5 \\\\ 4 & 3\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=4$, what is the value of $v?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}-v & 5 \\\\ 4 & 3\\end{vmatrix} \\\\  & =-v\\cdot 3-5\\cdot 4 \\\\  & =-3v-20\\end{aligned}\n$$\n\nSince $det(U)=4$, we get:\n\n$$\n\\begin{aligned}det(U) & =4 \\\\ -3v-20 & =4 \\\\ -3v & =4+20 \\\\ -3v & =24 \\\\ v & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad091e5c-707a-518d-9b21-5e4622f2cd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186592035}] :answer-field/correct {:answer/id #uuid "ad091e5c-707a-518d-9b21-5e4622f2cd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186592035} :answer-field/id #uuid "2a53609f-6339-5056-99fc-1faddb53d517" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186592167}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e824411-1e03-5958-a98d-c29104d4627e" :question/math-academy-id "q-317341" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}7 & 2 \\\\ 5 & 4\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & 2 \\\\ 5 & 4\\end{vmatrix} & =7\\cdot 4-2\\cdot 5 \\\\  & =28-10 \\\\  & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4a224e-44a8-51a0-b051-0bb30d5b7162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\sqrt{3}" :db/id #edb/ref 17592186591816}] :answer-field/correct {:answer/id #uuid "0f4a224e-44a8-51a0-b051-0bb30d5b7162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\sqrt{3}" :db/id #edb/ref 17592186591816} :answer-field/id #uuid "b6df6735-8419-5b2f-a9d4-bfe1d4b061e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186592211}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5711e1a6-e6b6-576f-bfa5-52e1edd7ede4" :question/math-academy-id "q-317369" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}-\\sqrt{3} & 4 \\\\ \\sqrt{3} & 1\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}-\\sqrt{3} & 4 \\\\ \\sqrt{3} & 1\\end{vmatrix} & =-\\sqrt{3}\\cdot 1-4\\cdot \\sqrt{3} \\\\  & =-\\sqrt{3}-4\\sqrt{3} \\\\  & =-5\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5220f649-c738-5122-9599-d9f859321690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186591903} {:answer/id #uuid "80de4d31-9aa8-5e7b-88f9-e0000d031070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186591965} {:answer/id #uuid "947a0df3-49f3-5c04-a318-f69823764ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186591993} {:answer/id #uuid "9f359a0a-cb67-582c-8d5f-8ac128bee997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186592008} {:answer/id #uuid "b209ffb8-293b-588e-a783-135c4e560ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186592038}] :answer-field/correct {:answer/id #uuid "b209ffb8-293b-588e-a783-135c4e560ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186592038} :answer-field/id #uuid "8e0bfcb5-87e5-5485-85b2-fb6a1bc3e040" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186592201}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d247b8c0-327a-5c2e-bca9-c1e451471450" :question/math-academy-id "q-1071" :question/problem "$$\n\\displaystyle \\begin{vmatrix}6 & 3 \\\\ 2 & 1\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}6 & 3 \\\\ 2 & 1\\end{vmatrix} & =6\\cdot 1-3\\cdot 2 \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2896ac37-aca2-57d5-9362-ba96357e22cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186591847} {:answer/id #uuid "701950c6-91eb-5988-b732-4e4176830959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186591951} {:answer/id #uuid "b9d55046-0003-5a5d-9e29-9963f22d3be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186592049} {:answer/id #uuid "e71d9d02-ef2d-5f3e-bb32-c822aab4ef2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡x" :db/id #edb/ref 17592186592113} {:answer/id #uuid "fe1c38b1-51c0-58a4-8d28-836332d1c45e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186592146}] :answer-field/correct {:answer/id #uuid "b9d55046-0003-5a5d-9e29-9963f22d3be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186592049} :answer-field/id #uuid "d665c360-257a-5313-b1ef-8e07dad8de31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186592222}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fcc29c07-89bb-5c20-b368-951a52748e3e" :question/math-academy-id "q-65251" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle \\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x.\n$$" :question/worked-solution "First, we rewrite the second term using the definition of $\\operatorname{tan}⁡x.$ This gives:\n\n$$\n\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\n$$\n\nNext, we put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x} & =\\frac{\\operatorname{cos}⁡x\\cdot \\operatorname{cos}⁡x}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)}+\\frac{\\operatorname{sin}⁡x\\cdot (1+\\operatorname{sin}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)}\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x+{sin}^{2}⁡x}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{\\operatorname{sin}⁡x+({cos}^{2}⁡x+{sin}^{2}⁡x)}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{\\operatorname{sin}⁡x+1}{\\operatorname{cos}⁡x(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\operatorname{sec}⁡x.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\operatorname{sec}⁡x.\n$$"}] [{:db/id #edb/ref 17592186593223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "330e3ad4-1446-5351-a92d-5f9b7edc67cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186592482} {:answer/id #uuid "3c95cafc-5e06-546e-ae6f-63ec7efaa126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186592510} {:answer/id #uuid "b8d8ac4a-0193-5b2b-8ee2-06e0a93e9173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186592826} {:answer/id #uuid "df59b484-e0e2-5470-80ed-7bb87527e8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186592941} {:answer/id #uuid "e86d60b6-6527-5842-ac9e-6553a9d929d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186592961}] :answer-field/correct {:answer/id #uuid "3c95cafc-5e06-546e-ae6f-63ec7efaa126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186592510} :answer-field/id #uuid "89659c69-56af-5410-8870-92c90eb6655f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e21ca5a-e277-545f-9950-6900f2acc236" :question/math-academy-id "q-65228" :question/problem "$$\n\\displaystyle {cos}^{2}⁡x(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{1}{\\operatorname{cos}⁡x}+1)=\n$$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{1}{\\operatorname{cos}⁡x}+1) & ={cos}^{2}⁡x\\cdot \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+{cos}^{2}⁡x\\cdot \\frac{1}{\\operatorname{cos}⁡x}+{cos}^{2}⁡x \\\\  & =\\frac{{cos}^{2}⁡x{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{{cos}^{2}⁡x}{\\operatorname{cos}⁡x}+{cos}^{2}⁡x \\\\  & =\\frac{\\cancel{{cos}^{2}⁡x}{sin}^{2}⁡x}{\\cancel{{cos}^{2}⁡x}}+\\frac{\\cancel{\\operatorname{cos}⁡x}\\operatorname{cos}⁡x}{\\cancel{\\operatorname{cos}⁡x}}+{cos}^{2}⁡x \\\\  & ={sin}^{2}⁡x+\\operatorname{cos}⁡x+{cos}^{2}⁡x \\\\  & =({sin}^{2}⁡x+{cos}^{2}⁡x)+\\operatorname{cos}⁡x \\\\  & =1+\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${cos}^{2}⁡x+{sin}^{2}⁡x=1.$ \n\nTherefore, we conclude that\n\n$$\n{cos}^{2}⁡x(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}+\\frac{1}{\\operatorname{cos}⁡x}+1)=1+\\operatorname{cos}⁡x.\n$$"}] [{:db/id #edb/ref 17592186593227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34f473e9-410b-5f00-b6dd-8741e10607cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{2}⁡x-1" :db/id #edb/ref 17592186592485} {:answer/id #uuid "4cf93dd7-4842-5669-b20f-fe992ed10a20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{cot}^{2}⁡x-1" :db/id #edb/ref 17592186592552} {:answer/id #uuid "4f296ec7-cf10-58bc-9020-8cb79a4d0968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x-2" :db/id #edb/ref 17592186592558} {:answer/id #uuid "b1d35296-435c-5b8f-96cd-d073fad19fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x-1" :db/id #edb/ref 17592186592808} {:answer/id #uuid "c90522d2-e0d8-5ec2-8112-182db8acb98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{csc}^{2}⁡x-3" :db/id #edb/ref 17592186592887}] :answer-field/correct {:answer/id #uuid "b1d35296-435c-5b8f-96cd-d073fad19fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x-1" :db/id #edb/ref 17592186592808} :answer-field/id #uuid "0630206e-2344-5c95-a2e0-6378ef11b54a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186593018}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "26501261-436d-5cb3-8593-f2a3508eedb5" :question/math-academy-id "q-72713" :question/problem "Simplify the trigonometric expression $\\frac{2{cos}^{4}⁡x+2{cos}^{2}⁡x{sin}^{2}⁡x-1}{{sin}^{2}⁡x}.$" :question/worked-solution "First, we factor $2{cos}^{2}⁡x$ from the first two terms:\n\n$$\n\\frac{2{cos}^{4}⁡x+2{cos}^{2}⁡x{sin}^{2}⁡x-1}{{sin}^{2}⁡x}=\\frac{2{cos}^{2}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)-1}{{sin}^{2}⁡x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{2{cos}^{2}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)-1}{{sin}^{2}⁡x} & =\\frac{2{cos}^{2}⁡x-1}{{sin}^{2}⁡x} \\\\  & =\\frac{2{cos}^{2}⁡x-({cos}^{2}⁡x+{sin}^{2}⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{2{cos}^{2}⁡x-{cos}^{2}⁡x-{sin}^{2}⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x}-\\frac{{sin}^{2}⁡x}{{sin}^{2}⁡x} \\\\  & ={cot}^{2}⁡x-1\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\frac{2{cos}^{4}⁡x+2{cos}^{2}⁡x{sin}^{2}⁡x-1}{{sin}^{2}⁡x}={cot}^{2}⁡x-1\n$$"}] [{:db/id #edb/ref 17592186594665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c14e8a2-231e-520a-9373-a71e0dd19e6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4t(t^2+3)" :db/id #edb/ref 17592186594381}] :answer-field/correct {:answer/id #uuid "2c14e8a2-231e-520a-9373-a71e0dd19e6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4t(t^2+3)" :db/id #edb/ref 17592186594381} :answer-field/id #uuid "ec6431b2-e799-5371-92fe-40e4255fa0c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186594657}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "016c901a-a8ed-57f7-ace0-713928705ac4" :question/math-academy-id "q-132770" :question/problem "$\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+3)^{2}]=\\,${{field-1}}" :question/worked-solution "First, let's define a function $h(t):$\n\n$$\nh(t)=({t}^{2}+3)^{2}\n$$\n\nTo differentiate this function, we use the chain rule. Let \n\n$$\ng(t)={t}^{2}+3,\\,h(g(t))=g(t)^{2}.\n$$\n\nDifferentiating our functions, we have\n\n$$\n\\begin{aligned}{g}^{′}(t) & =({t}^{2}+3)^{′}=2t, \\\\ {h}^{′}(g(t)) & =({g}^{2})^{′}=2g.\\end{aligned}\n$$\n\nThen, using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+3)^{2}] & ={h}^{′}(t) \\\\  & ={h}^{′}(g(t))\\cdot {g}^{′}(t) \\\\  & =2g\\cdot 2t \\\\  & =4t({t}^{2}+3).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186597617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9590648e-813f-5f78-bbce-a306642395c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186597161} {:answer/id #uuid "6ec0b583-0f37-437e-9f53-f9413682363f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186670961} {:answer/id #uuid "3be4d8a6-13d1-4307-8666-5cca126d0f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac35" :db/id #edb/ref 17592186670962}] :answer-field/correct {:answer/id #uuid "9590648e-813f-5f78-bbce-a306642395c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186597161} :answer-field/id #uuid "4a09aa38-da73-5206-b879-af0b3659206a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186597437}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb1316e2-9fcc-5550-830c-f3a945a647f2" :question/math-academy-id "q-342787" :question/problem "The slope of the tangent to the curve $y=\\sqrt{6x+1}$ at the point where $x=4$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=6x+1.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 6 \\\\  & =\\frac{6}{2\\sqrt{6x+1}}.\\end{aligned}\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & ={\\left(\\frac{6}{2\\sqrt{6x+1}}\\right)|}_{x=4} \\\\  & =\\frac{6}{2\\sqrt{6(4)+1}} \\\\  & =\\frac{6}{2\\sqrt{25}} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600788 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36f72df8-7124-53a7-ab76-370ca768df66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160\\pi" :db/id #edb/ref 17592186600548} {:answer/id #uuid "7ae4401e-9ee4-5992-893b-88cf97017713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{110\\pi }{3}" :db/id #edb/ref 17592186600602} {:answer/id #uuid "896a5b55-bb5d-5d56-ba59-07140aec6eec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120\\pi" :db/id #edb/ref 17592186600613} {:answer/id #uuid "ccaa25b7-9fa1-5846-9464-5f80de21a083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80\\pi" :db/id #edb/ref 17592186600663} {:answer/id #uuid "e272e84a-44aa-51e6-9fcd-33b552085bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64\\pi }{3}" :db/id #edb/ref 17592186600682}] :answer-field/correct {:answer/id #uuid "36f72df8-7124-53a7-ab76-370ca768df66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160\\pi" :db/id #edb/ref 17592186600548} :answer-field/id #uuid "2eb87e00-beeb-5587-a1f1-505875fd3ef6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600717}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "25c98032-408f-5408-8e78-6c18047997c6" :question/math-academy-id "q-161616" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder ${x}^{2}+{y}^{2}=16$ and between the surfaces $z=0$ and $z=10-x-y.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/5d/5d8a94cd0df8095c78aec955c3d0f062e38410326399104644b24e981eb1db9a.png)\n\nThe region $R$ is a right vertical cylinder of radius $4$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=10-x-y=10-r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 4,\\,0\\le \\theta <2\\pi ,\\,0\\le z\\le 10-r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\,\\text{d}V & ={∭}_{Δ}\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\int }_{0}^{10-r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta }r\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}r[z]_{z=0}^{z=10-r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}r(10-r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}10r-{r}^{2}\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[5{r}^{2}-\\frac{1}{3}{r}^{3}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )]}_{r=0}^{r=4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }5(4)^{2}-\\frac{1}{3}(4)^{3}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }80-\\frac{64}{3}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & ={[80\\theta -\\frac{64}{3}(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )]}_{\\theta =0}^{\\theta =2\\pi } \\\\  & =80(2\\pi -0)-\\frac{64}{3}(0-1-0+1) \\\\  & =160\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c0fc71-469e-590c-ba8b-284e07e9d56f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{{r}^{2}+1}{r}^{3}\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta" :db/id #edb/ref 17592186600512} {:answer/id #uuid "49003dc7-d1f6-5706-9ec6-4e81c0fa6b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{{r}^{2}+1}{r}^{2}\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta" :db/id #edb/ref 17592186600563} {:answer/id #uuid "4ada50cc-a17f-524a-b317-1e1efb616136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{r+1}{r}^{3}\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta" :db/id #edb/ref 17592186600567} {:answer/id #uuid "c950dfc3-14f5-582e-8ccb-600b02b54ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{r+1}{r}^{2}\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta" :db/id #edb/ref 17592186600660} {:answer/id #uuid "e49f8e80-604e-5e97-939f-664f1887cc80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{{r}^{2}+1}{r}^{3}\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta" :db/id #edb/ref 17592186600684}] :answer-field/correct {:answer/id #uuid "e49f8e80-604e-5e97-939f-664f1887cc80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{{r}^{2}+1}{r}^{3}\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta" :db/id #edb/ref 17592186600684} :answer-field/id #uuid "69082d16-ac02-5957-841e-63c1d5f5e644" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186600738}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ce2ff483-7446-5ef4-9532-e3d923aa91d7" :question/math-academy-id "q-161634" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x+1)^{2}+{y}^{2}\\le 1,\\,y\\le 0,\\,x\\le z\\le {x}^{2}+{y}^{2}+1\\},\n$$\n\nthen $$\n\\displaystyle {∭}_{R}{x}^{2}-{y}^{2}\\,\\text{d}V=\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/27/27a82956e22b5b2e2de2c02d9d93fb7b7ce57a2b581b88458964eda465e8bebd.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $1$ whose axis passes through the point $(-1,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=x=r\\operatorname{cos}⁡\\theta ,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+1={r}^{2}+1.$\n\nWith that in mind, let's now write the $(x+1)^{2}+{y}^{2}=1$ in polar coordinates:\n\n$$\n\\begin{aligned}(x+1)^{2}+{y}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta +1)^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta +2r\\operatorname{cos}⁡\\theta +1+{r}^{2}{sin}^{2}⁡\\theta  & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+2r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}+2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r+2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-2\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -2\\operatorname{cos}⁡\\theta ,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2},\\,r\\operatorname{cos}⁡\\theta \\le z\\le {r}^{2}+1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}-{y}^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}-(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{{r}^{2}+1}{r}^{3}\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186601935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55139606-5928-55a4-b814-22a969ada28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6t(t^2+1)^2" :db/id #edb/ref 17592186601654}] :answer-field/correct {:answer/id #uuid "55139606-5928-55a4-b814-22a969ada28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6t(t^2+1)^2" :db/id #edb/ref 17592186601654} :answer-field/id #uuid "cc71457a-ed2e-5826-8272-b8f37053afd2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186601872}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c125870a-b46c-59e0-a9be-37ea8a9a1d43" :question/math-academy-id "q-132994" :question/problem "$\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+1)^{3}]=\\,${{field-1}}" :question/worked-solution "First, let's define a function $h(t):$\n\n$$\nh(t)=({t}^{2}+1)^{3}\n$$\n\nTo differentiate this function, we use the chain rule. Let \n\n$$\ng(t)={t}^{2}+1,\\,h(g(t))=g(t)^{3}.\n$$\n\nDifferentiating our functions, we have\n\n$$\n\\begin{aligned}{g}^{′}(t) & =({t}^{2}+1)^{′}=2t, \\\\ {h}^{′}(g(t)) & =({g}^{3})^{′}=3{g}^{2}.\\end{aligned}\n$$\n\nThen, using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+1)^{3}] & ={h}^{′}(t) \\\\  & ={h}^{′}(g(t))\\cdot {g}^{′}(t) \\\\  & =3{g}^{2}\\cdot 2t \\\\  & =6t({t}^{2}+1)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186604621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "151b711e-e29d-52cf-841c-6cfda6e14fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186604225} {:answer/id #uuid "26619873-fe0a-5e4d-8245-c64fd1ea25d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186604247} {:answer/id #uuid "45ffad93-3115-558a-8bd5-c94952a8e3de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186604289} {:answer/id #uuid "76bf3c12-04de-52fc-8033-86da1ce3d0ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186604345} {:answer/id #uuid "ee65e78d-bc86-5e28-b514-8a70ab191cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186604456}] :answer-field/correct {:answer/id #uuid "45ffad93-3115-558a-8bd5-c94952a8e3de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186604289} :answer-field/id #uuid "e872cae2-4f21-5ba5-9698-ef9d0a263b2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186604552}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e173d2b2-736c-5e63-8058-7e4d5bcfe573" :question/math-academy-id "q-127312" :question/problem "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨3x-\\operatorname{cos}⁡y,\\,{x}^{7}+y⟩\n$$\n\nthrough the boundary of the region enclosed by the curve $y={x}^{5}$ and the lines $y=0$ and $x=1.$" :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/00/00bceda1bdf4f515646b3a1e8476f1eadde721aa52dbc9be9c7e866bcab99d3b.png)\n\nWe have that $P(x,y)=3x-\\operatorname{cos}⁡y$ and $Q(x,y)={x}^{7}+y.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 1,\\,0\\le y\\le {x}^{5}\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3+1)\\,\\text{d}A \\\\  & =4{\\int }_{0}^{1}{\\int }_{0}^{{x}^{5}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}y\\,{|}_{0}^{{x}^{5}}\\,dx \\\\  & =4{\\int }_{0}^{1}{x}^{5}\\,dx \\\\  & =4\\left(\\frac{{x}^{6}}{6}\\right){|}_{0}^{1} \\\\  & =\\frac{2}{3}-0 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2637e49a-0781-515c-9a84-f689805a94ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 x - 7" :db/id #edb/ref 17592186611691}] :answer-field/correct {:answer/id #uuid "2637e49a-0781-515c-9a84-f689805a94ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 x - 7" :db/id #edb/ref 17592186611691} :answer-field/id #uuid "e573b0d0-2df3-5439-93d8-68fb45052de8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611696}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6d431469-04a8-5431-a8f2-30fe91513752" :question/problem "Given that $f(x)=(1+2x)^{4},$ the equation of the tangent at the point $(-1,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(1+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=-1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=-1} &=[8(1+2x)^{3}]|_{x=-1} \\\\  &=8(1+2(-1))^{3} \\\\  &=-8.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(-1,1)$ is $m=-8.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=-8(x-(-1)) \\\\ y &=- 8 x - 8+1 \\\\ y &=- 8 x - 7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec2cf140-cbdf-5a26-a3b0-eb6b8b2c84f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80 - 64 x" :db/id #edb/ref 17592186611697}] :answer-field/correct {:answer/id #uuid "ec2cf140-cbdf-5a26-a3b0-eb6b8b2c84f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80 - 64 x" :db/id #edb/ref 17592186611697} :answer-field/id #uuid "0f1d28df-dabb-5bf7-8e72-27b57ca20785" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611690}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "90d7ca00-a943-5f90-be7d-b4fa402d7fc3" :question/problem "Given that $f(x)=(-4+2x)^{4},$ the equation of the tangent at the point $(1,16)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=-4+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(-4+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=1} &=[8(-4+2x)^{3}]|_{x=1} \\\\  &=8(-4+2(1))^{3} \\\\  &=-64.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,16)$ is $m=-64.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(16) &=-64(x-(1)) \\\\ y &=64 - 64 x+16 \\\\ y &=80 - 64 x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f389ac9f-9185-59ca-813f-7320e8f73331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12 x + 1" :db/id #edb/ref 17592186611698}] :answer-field/correct {:answer/id #uuid "f389ac9f-9185-59ca-813f-7320e8f73331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12 x + 1" :db/id #edb/ref 17592186611698} :answer-field/id #uuid "576ad759-6f77-5ac1-a36e-2ea6c5dd47da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611692}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c482bf94-14dc-5d26-9e9f-475518535fcc" :question/problem "Given that $f(x)=(1+3x)^{4},$ the equation of the tangent at the point $(0,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (3) \\\\  &=12(1+3x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=0$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=0} &=[12(1+3x)^{3}]|_{x=0} \\\\  &=12(1+3(0))^{3} \\\\  &=12.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(0,1)$ is $m=12.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=12(x-(0)) \\\\ y &=12 x+1 \\\\ y &=12 x + 1\\end{aligned}\n$$"}]}
