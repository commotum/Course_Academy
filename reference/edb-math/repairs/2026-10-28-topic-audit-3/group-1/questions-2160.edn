ck another point to distinguish the lines."}] [{:db/id #edb/ref 17592186702901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d4da211-8421-57e6-afa8-6e09d94333a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,4)" :db/id #edb/ref 17592186702916}] :answer-field/correct {:answer/id #uuid "3d4da211-8421-57e6-afa8-6e09d94333a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,4)" :db/id #edb/ref 17592186702916} :answer-field/id #uuid "ac0a4cb6-bf46-5b42-94a9-4abf90ec772e" :answer-field/key "point-second" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186702937} {:answer-field/choices [{:answer/id #uuid "6690574e-9613-5886-b80c-e5114ddc3e4f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4bbcfcaf2b07874f1e4480d3a0cb1571c2b9dae5e2651b8646eac4f5a21c28d7.png" :db/id #edb/ref 17592186702924} {:answer/id #uuid "8369f6f2-b3cd-548a-aa81-79659b18bcc2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1f/1f485f883bb45d4eb8f88846dadc64b5b97c923ab990f1c14e3f6122ddc779db.png" :db/id #edb/ref 17592186702930} {:answer/id #uuid "8bc7a08d-ff29-5531-bb05-743eda8a2ba5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/88/88f3274e669b5256758247ef1f5ec00082d9c26fdaeafcc026d0b91f0af754b1.png" :db/id #edb/ref 17592186702931} {:answer/id #uuid "b48c7606-1572-569c-89a6-a4cf43b136f5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a6/a606aab4d7579937d4c6f121fe506eddf1642073d848ac7e77d36fafc088fc66.png" :db/id #edb/ref 17592186702939} {:answer/id #uuid "b9792048-5d41-5759-bf15-4fae308b970e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d9aa24d423a53853a992fdc06f6550722f55e6bc50f48391