{3}3{x}^{2}\\,\\text{d}x\\cdot {\\int }_{2}^{3}2y\\,\\text{d}y\\cdot {\\int }_{2}^{4}\\text{d}z \\\\  & =[{x}^{3}]_{x=2}^{x=3}\\cdot [{y}^{2}]_{y=2}^{y=3}\\cdot (4-2) \\\\  & =(27-8)\\cdot (9-4)\\cdot 2 \\\\  & =190.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186560121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c29a741-00a0-515e-911a-eeee07458659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "168" :db/id #edb/ref 17592186560079} {:answer/id #uuid "8c4c8cc6-0565-52b9-b9f7-f6addd5c4f89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186560087} {:answer/id #uuid "c14d9583-f641-5ba8-a269-37856b6aa647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186560101} {:answer/id #uuid "e80972f0-e878-59aa-825c-1374c6505972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-168" :db/id #edb/ref 17592186560114} {:answer/id #uuid "eddb07c6-dc79-58ec-b504-1a50cd4dcb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186560120}] :answer-field/correct {:answer/id #uuid "5c29a741-00a0-515e-911a-eeee07458659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "168" :db/id #edb/ref 17592186560079} :answer-field/id #uuid "e367539d-d01a-537d-bede-325402aa1114" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560113}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5492797-50b7-5ddf-a85b-d01aab96103c" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0$, $x=4$, $y=0$, $y=3$, $z=0$, $z=2$. Given that the surface $S$ is positively (outward) oriented and $F=(7x+1)\\,i+3z\\,j+xy\\,k$, find the flux of $F$ across $S$." :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(7 x + 1)+\\frac{∂}{∂y}(3z)+\\frac{∂}{∂z}(xy) \\\\  & =7+0+0 \\\\  & =7.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}7\\,\\text{d}V \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{3}{\\int }_{0}^{2}7\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{4}7\\,\\text{d}x\\cdot {\\int }_{0}^{3}\\text{d}y\\cdot {\\int }_{0}^{2}\\text{d}z \\\\  & =[7x]_{x=0}^{x=4}\\cdot (3-0)\\cdot (2-0) \\\\  & =(28-0)\\cdot 3\\cdot 2 \\\\  & =168.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186560124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f64c501-23ad-5895-bb85-cd421ce0e391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-320" :db/id #edb/ref 17592186560063} {:answer/id #uuid "2b4b73ce-7f0f-5fcd-afe5-4c852f86ffec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186560065} {:answer/id #uuid "4f85cd44-af17-57ec-b3e1-4a6bfc979738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186560075} {:answer/id #uuid "7a3d8850-b97a-5c6c-9fc9-5e352cc63c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186560085} {:answer/id #uuid "fdcca4b7-8539-5240-929a-cb57e96a526b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186560127}] :answer-field/correct {:answer/id #uuid "7a3d8850-b97a-5c6c-9fc9-5e352cc63c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186560085} :answer-field/id #uuid "a368137c-3c2a-5f3a-bc0b-411f8e37fd7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560091}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb1a5424-5e52-51f6-a33b-f2eedeb4f7d7" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0$, $x=2$, $y=0$, $y=4$, $z=0$, $z=5$. Given that the surface $S$ is positively (outward) oriented and $F=(8x+1)\\,i+3z\\,j+xy\\,k$, find the flux of $F$ across $S$." :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(8 x + 1)+\\frac{∂}{∂y}(3z)+\\frac{∂}{∂z}(xy) \\\\  & =8+0+0 \\\\  & =8.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}8\\,\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{4}{\\int }_{0}^{5}8\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}8\\,\\text{d}x\\cdot {\\int }_{0}^{4}\\text{d}y\\cdot {\\int }_{0}^{5}\\text{d}z \\\\  & =[8x]_{x=0}^{x=2}\\cdot (4-0)\\cdot (5-0) \\\\  & =(16-0)\\cdot 4\\cdot 5 \\\\  & =320.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186560984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd6483d-ff42-5dc9-bf60-d49b491388dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186560464} {:answer/id #uuid "5000cc2e-e84a-572e-94b0-98de14def1b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560539} {:answer/id #uuid "683ef1d0-3a45-5daf-a0c7-cf2a0f6be250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560583} {:answer/id #uuid "be4e7b49-1ac4-5e2f-92d1-d5c217fc797f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186560741} {:answer/id #uuid "dd5e01ff-4835-5778-92d5-2ea89a8203bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186560799}] :answer-field/correct {:answer/id #uuid "2cd6483d-ff42-5dc9-bf60-d49b491388dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186560464} :answer-field/id #uuid "ea3760f2-d10c-5617-a3f3-b8335b0f89d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d6a46ea-e810-5ed6-9d15-12e3845c1e76" :question/math-academy-id "q-126572" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}F\\cdot \\text{d}r\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the vector field $F(x,y)?$\n\nI. $F(x,y)=⟨{e}^{y}-y,\\,x{e}^{y}⟩$\n\nII. $F(x,y)=⟨{e}^{y},\\,0⟩$\n\nIII. $$\n\\displaystyle F(x,y)=⟨-\\frac{y}{5}+{x}^{7},\\,\\frac{6x}{5}⟩\n$$" :question/worked-solution "According to Green's theorem, if $F(x,y)=⟨P(x,y),\\,Q(x,y)⟩,$ where\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y \\\\  & ={∮}_{C}F\\cdot \\text{d}r\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Vector field I give the required area. In this case,\n$\\frac{∂P}{∂y}={e}^{y}-1$\nand\n$\\frac{∂Q}{∂x}={e}^{y},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Vector field II does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=-{e}^{y}$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}={e}^{y}\\ne 1.\n$$\n\n- Vector field III does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=-\\frac{1}{5}$\nand\n$\\frac{∂Q}{∂x}=\\frac{6}{5},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=\\frac{7}{5}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186561018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fdc301-b9e6-5380-b576-f756ad837d6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186560422} {:answer/id #uuid "48d9075b-21bf-518c-85e4-b52a39ca48c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560525} {:answer/id #uuid "71000db5-1bfa-5f19-88d0-bfac331f25f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560605} {:answer/id #uuid "79fb9fa0-3c09-5639-8f51-38fc29793534" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186560625} {:answer/id #uuid "aee8fb2f-93bf-5e56-b3ef-5f91d5ed3421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186560716}] :answer-field/correct {:answer/id #uuid "48d9075b-21bf-518c-85e4-b52a39ca48c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560525} :answer-field/id #uuid "8b9b5f42-303d-5796-888d-e11c20c8cac2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560921}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7d76f5fb-ba28-5b32-904d-cbb78731c152" :question/math-academy-id "q-126570" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)=-\\frac{y}{3}$ and $Q(x,y)=\\frac{x}{3}$\n\nII. $P(x,y)=y\\operatorname{sin}⁡x$ and $Q(x,y)=x-\\operatorname{cos}⁡x$\n\nIII. $P(x,y)={y}^{2}$ and $Q(x,y)={x}^{2}$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=-\\frac{1}{3}$\nand\n$\\frac{∂Q}{∂x}=\\frac{1}{3},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=\\frac{2}{3}\\ne 1.\n$$\n\n- Pair II gives the required area. Notice that\n$\\frac{∂P}{∂y}=\\operatorname{sin}⁡x$\nand\n$\\frac{∂Q}{∂x}=1+\\operatorname{sin}⁡x$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Pair III does *not* give the required area. Notice that \n$\\frac{∂P}{∂y}=2y$\nand\n$\\frac{∂Q}{∂x}=2x,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2x-2y\\ne 1.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186561027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3670e0fc-6d65-5c69-a28a-c92456932444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186560485} {:answer/id #uuid "39c3f228-f440-590e-ba1b-1c90c3c03432" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186560493} {:answer/id #uuid "7521cafa-fe34-5822-be40-921e53636206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186560614} {:answer/id #uuid "9ca6978e-a4e1-5484-ba5d-364891771b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186560684} {:answer/id #uuid "b4d3daaf-a309-5e5e-a768-d106755411ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{7}" :db/id #edb/ref 17592186560729}] :answer-field/correct {:answer/id #uuid "b4d3daaf-a309-5e5e-a768-d106755411ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{7}" :db/id #edb/ref 17592186560729} :answer-field/id #uuid "75e5af1d-ea30-5a37-83f7-6f329a1a3e3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560913}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8d510a6d-f96b-598f-8f2e-31efe6a6d012" :question/math-academy-id "q-126869" :question/problem "![](images/c5/c5eb703c2812d82848bb5a1639c2840c4abf9318b988087e2216d9881137da72.png)\n\nConsider the region $D$ enclosed by the curve $C={C}_{1}\\cup {C}_{2},$ where \n\n- ${C}_{1}$ is parametrized by ${r}_{1}(t)={t}^{4}\\,i+{t}^{3}\\,j$ for $t\\in [-1,1],$ and\n\n- ${C}_{2}$ is parametrized by ${r}_{2}(t)=\\,i-t\\,j$ for $t\\in [-1,1].$\n\nUse Green's theorem to find the area of the region." :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$ \n\nOur simple, piecewise-smooth, closed path $C$ is negatively oriented, and   \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivatives of ${r}_{1}(t)$ and ${r}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=4{t}^{3}\\,i+3{t}^{2}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=-j\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={∮}_{{C}_{1}\\cup {C}_{2}}y\\,dx \\\\  & ={∮}_{{C}_{1}}y\\,dx+{∮}_{{C}_{2}}y\\,dx \\\\  & ={\\int }_{-1}^{1}{t}^{3}\\cdot 4{t}^{3}\\,\\text{d}t+{\\int }_{-1}^{1}(-t)\\cdot 0\\,\\text{d}t \\\\  & =4{\\int }_{-1}^{1}{t}^{6}\\,\\text{d}t-0 \\\\  & =4[\\frac{{t}^{7}}{7}]_{-1}^{1} \\\\  & =4\\cdot \\frac{2}{7} \\\\  & =\\frac{8}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186561062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5caa2745-f258-5524-bce2-0cee34f7a871" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186560562} {:answer/id #uuid "7484861d-d825-59f3-b995-2fbd5e8a6934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560612} {:answer/id #uuid "81e94b1a-bd75-573d-86e7-53f24a85af34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186560639} {:answer/id #uuid "8ccdd078-e1bf-5bbc-be52-fd411e22349d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560656} {:answer/id #uuid "fbcde265-3bb2-5d78-a137-ab8cf1e73dcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186560859}] :answer-field/correct {:answer/id #uuid "8ccdd078-e1bf-5bbc-be52-fd411e22349d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560656} :answer-field/id #uuid "041132e8-077c-5837-a79f-29852017427b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f61d70b2-c968-54d9-b087-2ae80ef01b89" :question/math-academy-id "q-126561" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)={e}^{y}$ and $Q(x,y)={e}^{x}$\n\nII. $P(x,y)=\\operatorname{arctan}⁡y$ and $Q(x,y)=y$\n\nIII. $P(x,y)=-y$ and $Q(x,y)=y$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}={e}^{y}$\nand\n$\\frac{∂Q}{∂x}={e}^{x},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}={e}^{x}-{e}^{y}\\ne 1.\n$$\n\n- Pair II does *not* give the required area.  Notice that \n$\\frac{∂P}{∂y}=\\frac{1}{1+{y}^{2}}$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-\\frac{1}{1+{y}^{2}}\\ne 1.\n$$\n\n- Pair III gives the required area. Notice that\n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186561063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "536431fa-077c-5c63-8e52-e720d5f25ad5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186560546} {:answer/id #uuid "57095cd5-869a-52ea-98e5-ae49745a6cf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186560553} {:answer/id #uuid "58122a63-9d7f-591f-b933-aa93158e184f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186560555} {:answer/id #uuid "629d2292-4c54-5f88-aab2-977463ff11a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560573} {:answer/id #uuid "88b89e38-2d3c-57a2-ad5a-0be2309918a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560646}] :answer-field/correct {:answer/id #uuid "629d2292-4c54-5f88-aab2-977463ff11a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560573} :answer-field/id #uuid "5bca7dbd-ffdc-5cb7-822a-009c4eccd416" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560901}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f892a9d1-561b-51b8-a283-3b892f8dc787" :question/math-academy-id "q-126559" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)=y$ and $Q(x,y)=x$\n\nII. $P(x,y)=-y$ and $Q(x,y)=0$\n\nIII. $P(x,y)=y+{e}^{x}$ and $Q(x,y)=\\frac{y}{3}$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=1$\nand\n$\\frac{∂Q}{∂x}=1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0\\ne 1.\n$$\n\n- Pair II gives the required area. Notice that\n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Pair III does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-1\\ne 1.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186561273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f095421-4eb7-5ea2-bb40-6f8eab7c9244" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{8} + \\frac{\\pi}{12}" :db/id #edb/ref 17592186561270} {:answer/id #uuid "50e6ac1d-86b6-55d3-8bb3-54ede029e824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2} + \\frac{\\pi}{3}" :db/id #edb/ref 17592186561284} {:answer/id #uuid "9f55bc3e-6963-5fa2-a551-7d6fe2d56a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{6} - \\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186561295} {:answer/id #uuid "bac92365-b494-5840-afdc-098f66ee52c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{9}" :db/id #edb/ref 17592186561299} {:answer/id #uuid "d37d1246-b0a1-5b46-966a-737ac55ada39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4} + \\frac{\\pi}{6}" :db/id #edb/ref 17592186561302}] :answer-field/correct {:answer/id #uuid "d37d1246-b0a1-5b46-966a-737ac55ada39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4} + \\frac{\\pi}{6}" :db/id #edb/ref 17592186561302} :answer-field/id #uuid "ca07c4a4-cf13-5b88-93c7-0238e693af51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561301}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2c6baa40-7c4d-5d92-bf70-a91f0dc92cbe" :question/problem "Evaluate $$\n\\displaystyle \\int_{0}^{\\frac{\\pi}{12}} \\int_{0}^{2 \\cos{\\left(2 \\theta \\right)}} 2 r\\,\\mathrm d r\\,\\mathrm d \\theta.\n$$" :question/worked-solution "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}\n\\int_{0}^{\\frac{\\pi}{12}} \\int_{0}^{2 \\cos{\\left(2 \\theta \\right)}} 2 r\\,\\mathrm d r\\,\\mathrm d \\theta & = \\int_{0}^{\\frac{\\pi}{12}} 2 \\int_{0}^{2 \\cos{\\left(2 \\theta \\right)}} r\\,\\mathrm d r\\,\\mathrm d \\theta \\\\\n& = \\int_{0}^{\\frac{\\pi}{12}} 2 \\left[\\frac{r^{2}}{2}\\right]_{0}^{2 \\cos{\\left(2 \\theta \\right)}}\\,\\mathrm d \\theta \\\\\n& = \\int_{0}^{\\frac{\\pi}{12}} 2 \\left(\\frac{\\left(2 \\cos{\\left(2 \\theta \\right)}\\right)^{2}-\\left(0\\right)^{2}}{2}\\right)\\,\\mathrm d \\theta \\\\\n& = \\int_{0}^{\\frac{\\pi}{12}} 4 \\cos^{2}{\\left(2 \\theta \\right)}\\,\\mathrm d \\theta\n\\end{aligned}\n$$\n\nNext, we recall the double-angle formula\n\n$$\n\\cos(2x)=2\\cos^2 x-1.\n$$\n\nSubstituting $x=2\\theta$ and rearranging, we get\n\n$$\n\\cos^2\\left(2\\theta\\right)=\\frac{1}{2}\\left(1+\\cos\\left(4\\theta\\right)\\right).\n$$\n\nFinally, we can finish our integral by integrating with respect to $\\theta,$ as follows:\n\n$$\n\\begin{aligned}\n\\int_{0}^{\\frac{\\pi}{12}} 4 \\cos^{2}{\\left(2 \\theta \\right)}\\,\\mathrm d \\theta & = \\int_{0}^{\\frac{\\pi}{12}} 2\\left(1+\\cos\\left(4\\theta\\right)\\right)\\,\\mathrm d \\theta \\\\\n& = 2\\left[\\theta + \\frac{\\sin{\\left(4 \\theta \\right)}}{4}\\right]_{0}^{\\frac{\\pi}{12}} \\\\\n& = 2\\left(\\left(\\frac{\\pi}{12}+\\frac{1}{4}\\sin\\left(\\frac{\\pi}{3}\\right)\\right)-\\left(0+\\frac{1}{4}\\sin\\left(0\\right)\\right)\\right) \\\\\n& = 2\\left(\\left(\\frac{\\pi}{12}+\\frac{1}{4} \\left(\\frac{\\sqrt{3}}{2}\\right)\\right)-\\left(0+\\frac{1}{4} \\left(0\\right)\\right)\\right) \\\\\n& = 2\\left(\\left(\\frac{\\pi}{12}\\right)+\\frac{1}{4}\\left(\\frac{\\sqrt{3}}{2}\\right)\\right) \\\\\n& = \\frac{\\sqrt{3}}{4} + \\frac{\\pi}{6}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186561290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13dfb5ec-6677-5544-a923-1388141c6808" :answer/