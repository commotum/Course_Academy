&=\\sqrt{3} t \\\\ \\|\\mathbf r'(t)\\|^2&=\\left(t \\sin{\\left(t \\right)}\\right)^2 \\\\ &\\quad+\\left(- t \\cos{\\left(t \\right)}\\right)^2+\\left(\\sqrt{3} t\\right)^2 \\\\ &=4 t^{2} \\\\ \\|\\mathbf r'(t)\\|&=\\sqrt{4 t^{2}} \\\\ &=2|t| \\\\ &=- 2 t\\end{aligned}\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L&=\\int_{-3}^{-1}\\|\\mathbf r'(t)\\|\\,\\mathrm dt \\\\ &=\\int_{-3}^{-1}(- 2 t)\\,\\mathrm dt \\\\ &=\\left[- t^{2}\\right]_{-3}^{-1} \\\\ &=\\left(-1\\right)-\\left(-9\\right) \\\\ &=8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186712781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f467ded-7c1e-5fe9-ae80-8ffaed9fe633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186712778} {:answer/id #uuid "8f9456db-b4cd-5060-b719-3300434f104d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{78}}{3}" :db/id #edb/ref 17592186712786} {:answer/id #uuid "c14dd8f4-bc08-55fc-9fd5-5257d62da9ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186712791} {:answer/id #uuid "c90cb912-fec2-5e6f-b90c-3ac76ed20a28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186712793} {:answer/id #uuid "cb7f2c23-60f0-52c4-9759-b5254659edb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186712794}] :answer-field/correct {:answer/id #uuid "4f467ded-7c1e-5fe9-ae80-8ffaed9fe633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186712778} :answer-field/id #uuid "1fe8e77d-a443-55e8-8f0e-2f867be551c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712775}] :question/difficulty {:db/id #