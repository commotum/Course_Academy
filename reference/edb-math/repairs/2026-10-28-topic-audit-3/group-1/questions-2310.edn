#{[{:db/id #edb/ref 17592186712762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83420346-9b88-5993-b1ca-22a84ee88df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{2}" :db/id #edb/ref 17592186712754} {:answer/id #uuid "c6a47c9c-4890-539e-9a01-9e2e8bbb3b6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{2}" :db/id #edb/ref 17592186712764} {:answer/id #uuid "f6bae6ef-602a-559c-ab7c-c83966aaf20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{183}}{3}" :db/id #edb/ref 17592186712768} {:answer/id #uuid "f9c6a3bb-f1b4-5599-b80b-22cfd3f304df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186712769} {:answer/id #uuid "ff75bcae-db98-5939-9d61-0c8f39f14587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186712770}] :answer-field/correct {:answer/id #uuid "c6a47c9c-4890-539e-9a01-9e2e8bbb3b6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{2}" :db/id #edb/ref 17592186712764} :answer-field/id #uuid "9cccfbce-76f8-5906-be42-172360fc9064" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712761}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a80ab110-5590-5b65-aa2c-70a2dd52354f" :question/problem "Find the arc length of the curve with coordinate functions\n\n$$\n\\begin{aligned}x(t)&=2 t \\cos{\\left(2 t \\right)} - \\sin{\\left(2 t \\right)} \\\\ y(t)&=\\frac{3 t^{2}}{2} - 2 \\\\ z(t)&=- 2 t \\sin{\\left(2 t \\right)} - \\cos{\\left(2 t \\right)}\\end{aligned}\n$$\n\nfrom $t=4$ to $t=5$." :question/worked-solution "Differentiate the coordinates and simplify the speed. Since $t\\ge 0$ on this interval, $|t|=t$. Use $\\sin^2(\\theta)+\\cos^2(\\theta)=1$.\n\n$$\n\\begin{aligned}x'(t)&=\\left(2\\cos(2t)-4t\\sin(2t)-2\\cos(2t)\\right) \\\\ &=- 4 t \\sin{\\left(2 t \\right)} \\\\ y'(t)&=3 t \\\\ z'(t)&=-1\\left(2\\sin(2t)+4t\\cos(2t)-2\\sin(2t)\\right) \\\\ &=- 4 t \\cos{\\left(2 t \\right)} \\\\ \\|\\mathbf r'(t)\\|^2&=\\left(- 4 t \\sin{\\left(2 t \\right)}\\right)^2 \\\\ &\\quad+\\left(3 t\\right)^2+\\left(- 4 t \\cos{\\left(2 t \\right)}\\right)^2 \\\\ &=25 t^{2} \\\\ \\|\\mathbf r'(t)\\|&=\\sqrt{25 t^{2}} \\\\ &=5|t| \\\\ &=5 t\\end{aligned}\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L&=\\int_{4}^{5}\\|\\mathbf r'(t)\\|\\,\\mathrm dt \\\\ &=\\int_{4}^{5}(5 t)\\,\\mathrm dt \\\\ &=\\left[\\frac{5 t^{2}}{2}\\right]_{4}^{5} \\\\ &=\\left(\\frac{125}{2}\\right)-\\left(40\\right) \\\\ &=\\frac{45}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186712765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3637b01e-b0eb-5c23-9fd6-84e2b36bb8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186712748} {:answer/id #uuid "48cef674-bf95-5823-9723-9818acb76f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "240" :db/id #edb/ref 17592186712751} {:answer/id #uuid "51084329-0957-570b-9bc7-78d1228f7942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186712753} {:answer/id #uuid "8f759e33-2d86-5a77-a328-2a59413b495c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186712758} {:answer/id #uuid "f3b1e48c-3a10-5902-bd90-7492a822dfb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186712767}] :answer-field/correct {:answer/id #uuid "f3b1e48c-3a10-5902-bd90-7492a822dfb9" :answer/type {:db/id #edb/ref 17