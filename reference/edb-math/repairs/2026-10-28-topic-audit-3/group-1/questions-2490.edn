r/id #uuid "f15486ee-f57a-55cb-bb9a-ebcd7f07bd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186721567}] :answer-field/correct {:answer/id #uuid "f15486ee-f57a-55cb-bb9a-ebcd7f07bd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186721567} :answer-field/id #uuid "06dbef11-4917-5295-9df5-fc3f1beebb25" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186721540} {:answer-field/choices [{:answer/id #uuid "5ffdc653-06d9-50e5-a04d-8ef12faf7f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186721549}] :answer-field/correct {:answer/id #uuid "5ffdc653-06d9-50e5-a04d-8ef12faf7f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186721549} :answer-field/id #uuid "322ffb2d-751b-5487-b8e0-98e78a34ebed" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186721543}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "785a091f-c5fc-5ccd-8f11-5134da5e4c46" :question/problem "If $\\overset{\\to }{m} = ⟨6, -2⟩$ and $\\overset{\\to }{n} = ⟨1,-1⟩$, then\n\n$\\overset{\\to }{m} - \\overset{\\to }{n} =$ $\\langle$ {{field-1}} $,$ {{field-2}} $\\rangle$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{m} - \\overset{\\to }{n} &= ⟨6,-2⟩ - ⟨1,-1⟩ \\\\ &= ⟨6-1,-2-(-1)⟩ \\\\ &= ⟨5,-1⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b43253ce-31be-531a-a6b6-14580e786877" :answer/type {:db/id #edb/ref 1759218