0d-5979-b26d-4cdce4e826c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186721554} :answer-field/id #uuid "39ecb0d0-3b31-5447-a7aa-61d3560495d2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186721545} {:answer-field/choices [{:answer/id #uuid "fd63eada-857b-5ef5-a7ab-e2f1445335a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186721568}] :answer-field/correct {:answer/id #uuid "fd63eada-857b-5ef5-a7ab-e2f1445335a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186721568} :answer-field/id #uuid "8eca7496-dac3-5152-bc93-f086e1a272dd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186721555}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "acc441a0-288c-5428-9048-d1d77c54a112" :question/problem "If $\\overset{\\to }{p} = ⟨5,-3⟩$, then\n\n$4\\overset{\\to }{p} =$ $\\langle$ {{field-1}} $,$ {{field-2}} $\\rangle$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}4\\overset{\\to }{p} &= 4\\cdot ⟨5,-3⟩ \\\\ &= ⟨4\\cdot 5,4\\cdot (-3)⟩ \\\\ &= ⟨20,-12⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c0c8e5-6d9f-5d9b-9ab6-e8a561e22e20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,-4⟩" :db/id #edb/ref 17592186721607} {:answer/id #uuid "37e1afe3-e408-518a-aa20-755d8dbf324e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-6,-1⟩" :db/id #edb/ref 17592186721614} {:answer/id #uuid "441618f0-9b89-57b3-b3d3-99dca24b8b81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-11,-3⟩" :db/id #edb/ref 17592186721615} {:answer/id #uuid "76df070a-b6b6-5020-9545-731e39c3117b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-10,0⟩" :db/id #edb/ref 17592186721621} {:answer/id #uuid "c59753ff-fcc6-5d06-9538-6229fb2fdd65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,-2⟩" :db/id #edb/ref 17592186721626}] :answer-field/correct {:answer/id #uuid "06c0c8e5-6d9f-5d9b-9ab6-e8a561e22e20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,-4⟩" :db/id #edb/ref 17592186721607} :answer-field/id #uuid "95b3e643-8cef-596a-a092-0ca2447b5665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721622}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0315f4f4-71da-5331-ba44-d3c1902423b0" :question/problem "The vectors $\\overset{\\to }{a}$ and $\\overset{\\to }{b}$ are shown below. Each grid square has side length $1$.\n\n![Two vectors on a unit coordinate grid](images/2a/2af567064376869502ff35c96442d80bb92d0ee46deaf41514fdcbd71afca41f.png)\n\nFind the coordinates of $-2\\overset{\\to }{a}+\\overset{\\to }{b}$." :question/worked-solution "Both arrows start at the origin. Read their signed horizontal and vertical components:\n\n$$\n\\overset{\\to }{a}=⟨1,4⟩,\\qquad \\overset{\\to }{b}=⟨-3,4⟩.\n$$\n\nScale each required vector, then combine corresponding components:\n\n$$\n\\begin{aligned}-2\\overset{\\to }{a}+\\overset{\\to }{b} &=(-2)\\cdot ⟨1,4⟩+1\\cdot ⟨-3,4⟩ \\\\ &=⟨-2,-8⟩+⟨-3,4⟩ \\\\ &=⟨-2+(-3),-8+4⟩ \\\\ &=⟨-5,-4⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17eb135d-164f-582a-aed0-532b16a45bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-4⟩" :db/id #edb/ref 17592186721611} {:answer/id #uuid "22f9813b-7fac-5633-8d1e-647a991acd3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,-3⟩" :db/id #edb/ref 17592186721613} {:answer/id #uuid "467083b4-14c6-5df0-ba8f-dda0e679a2db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,-6⟩" :db/id #edb/ref 17592186721616} {:answer/id #uuid "6463d01f-2da7-5456-a09c-346d2062bc87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,-9⟩" :db/id #edb/ref 17592186721618} {:answer/id #uuid "d40bf687-e0d3-556b-bf64-494efbeab37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,-8⟩" :db/id #edb/ref 17592186721629}] :answer-field/correct {:answer/id #uuid "d40bf687-e0d3-556b-bf64-494efbeab37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,-8⟩" :db/id #edb/ref 17592186721629} :answer-field/id #uuid "11d1ab63-2d2f-524f-a40a-4311ac0e2f25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e93d178-37a5-5415-a2ce-ccbffb08bfae" :question/problem "The vectors $\\overset{\\to }{a}$ and $\\overset{\\to }{b}$ are shown below. Each grid square has side length $1$.\n\n![Two vectors on a unit coordinate grid](images/90/909ddd4e0fc719bf71686ef44dc01c200ce56227cdb4081822596fdc37309ae8.png)\n\nFind the coordinates of $\\overset{\\to }{a}-2\\overset{\\to }{b}$." :question/worked-solution "Both arrows start at the origin. Read their signed horizontal and vertical components:\n\n$$\n\\overset{\\to }{a}=⟨4,-2⟩,\\qquad \\overset{\\to }{b}=⟨3,3⟩.\n$$\n\