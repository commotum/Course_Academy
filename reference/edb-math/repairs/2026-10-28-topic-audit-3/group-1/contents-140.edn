/id #edb/ref 17592186546113} {:db/id #edb/ref 17592186546116} {:db/id #edb/ref 17592186546118} {:db/id #edb/ref 17592186718219} {:db/id #edb/ref 17592186718231} {:db/id #edb/ref 17592186718234} {:db/id #edb/ref 17592186718821} {:db/id #edb/ref 17592186718822} {:db/id #edb/ref 17592186718824} {:db/id #edb/ref 17592186718830} {:db/id #edb/ref 17592186718833}] :knowledge-point/title "Calculating the Derivative of a Function of Three Intermediate Variables and Two Independent Variables"}] [{:db/id #edb/ref 17592186166846 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166696} :knowledge-point/id #uuid "cd281121-21d3-5dc4-8537-af248d0fdf46" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050885}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186687815} :knowledge-point/questions [{:db/id #edb/ref 17592186167049} {:db/id #edb/ref 17592186167541} {:db/id #edb/ref 17592186240865} {:db/id #edb/ref 17592186240866} {:db/id #edb/ref 17592186240867} {:db/id #edb/ref 17592186382682} {:db/id #edb/ref 17592186382689} {:db/id #edb/ref 17592186382696} {:db/id #edb/ref 17592186382703} {:db/id #edb/ref 17592186567386} {:db/id #edb/ref 17592186567396} {:db/id #edb/ref 17592186567398} {:db/id #edb/ref 17592186567402} {:db/id #edb/ref 17592186567415} {:db/id #edb/ref 17592186687392} {:db/id #edb/ref 17592186687393} {:db/id #edb/ref 17592186687408} {:db/id #edb/ref 17592186687810} {:db/id #edb/ref 17592186687811} {:db/id #edb/ref 17592186687828} {:db/id #edb/ref 17592186687833} {:db/id #edb/ref 17592186687834} {:db/id #edb/ref 17592186687836}] :knowledge-point/title "Identifying the Vector Field Corresponding to a Given Potential Function"}] [{:db/id #edb/ref 17592186166863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166716} :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186718588} :knowledge-point/questions [{:db/id #edb/ref 17592186167051} {:db/id #edb/ref 17592186167319} {:db/id #edb/ref 17592186240898} {:db/id #edb/ref 17592186240901} {:db/id #edb/ref 17592186259580} {:db/id #edb/ref 17592186351310} {:db/id #edb/ref 17592186351360} {:db/id #edb/ref 17592186351361} {:db/id #edb/ref 17592186383048} {:db/id #edb/ref 17592186410575} {:db/id #edb/ref 17592186410576} {:db/id #edb/ref 17592186718314} {:db/id #edb/ref 17592186718319} {:db/id #edb/ref 17592186718321} {:db/id #edb/ref 17592186718523} {:db/id #edb/ref 17592186718531} {:db/id #edb/ref 17592186718540} {:db/id #edb/ref 17592186718544} {:db/id #edb/ref 17592186718550} {:db/id #edb/ref 17592186718663} {:db/id #edb/ref 17592186718666} {:db/id #edb/ref 17592186718681} {:db/id #edb/ref 17592186718690} {:db/id #edb/ref 17592186718717} {:db/id #edb/ref 17592186718718} {:db/id #edb/ref 17592186718739} {:db/id #edb/ref 17592186718750}] :knowledge-point/title "Identifying Conservative Vector Fields"}] [{:db/id #edb/ref 17592186166864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166717} :knowledge-point/id #uuid "d8d73fd7-cdeb-59f1-a84c-aab6defb3aa3" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/question-generator {:db/id #edb/ref 17592186718935} :knowledge-point/questions [{:db/id #edb/ref 17592186167050} {:db/id #edb/ref 17592186167090} {:db/id #edb/ref 17592186235528} {:db/id #edb/ref 17592186240870} {:db/id #edb/ref 17592186240872} {:db/id #edb/ref 17592186259581} {:db/id #edb/ref 17592186259582} {:db/id #edb/ref 17592186259583} {:db/id #edb/ref 17592186362333} {:db/id #edb/ref 17592186383055} {:db/id #edb/ref 17592186718356} {:db/id #edb/ref 17592186718361} {:db/id #edb/ref 17592186718372} {:db/id #edb/ref 17592186718902} {:db/id #edb/ref 17592186718908} {:db/id #edb/ref 17592186718919} {:db/id #edb/ref 17592186718924} {:db/id #edb/ref 17592186718925} {:db/id #edb/ref 17592186718992} {:db/id #edb/ref 17592186719002} {:db/id #edb/ref 17592186719003} {:db/id #edb/ref 17592186719008} {:db/id #edb/ref 17592186719054} {:db/id #edb/ref 17592186719057} {:db/id #edb/ref 17592186719058} {:db/id #edb/ref 17592186719063}] :knowledge-point/title "Finding a Parameter in a Given Conservative Vector Field"}] [{:db/id #edb/ref 17592186168061 :tutorial/content "The chain rule for single variable functions $f=f(x)$ and $x=x(t)$ states that\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}t} = \\dfrac{\\textrm{d}f}{\\textrm{d}x} \\cdot \\dfrac{\\textrm{d}x}{\\textrm{d}t}.\n$$\n\nLet's now suppose that $f = f(x,y),$ where $x=x(t)$ and $y=y(t)$ are single-variable functions. How do we find $\\dfrac{\\textrm d f}{\\textrm d t}$ in this case?\n\nThe functions $x(t)$ and $y(t)$ are known as **intermediate variables.** They are independent variables for the function $f(x,y),$ but are themselves dependent on the variable $t.$\n\nOne way to consider how $f(x,y)$ depends on $t$ is to draw a tree diagram.\n\nStarting with $f(x,y),$ we draw a branch for each intermediate variable. Then, we draw a branch for both $x=x(t)$ and $y=y(t),$ which are both dependent on the variable $t.$\n\n![](images/cd/cdc47e038ecaba62ae612a0ac0bc07067af232353fc4fc169bf4be57b3abbd1f.png)\n\nWe then label each branch with the derivative describing how the function changes due to a change in the variable. \n\n![](images/ec/ece6012e358b5b6920395df88acd8d7037a7b15bed1add1220365ba72bd24cbd.png)\n\nThen, traversing each branch, we compute the product of the derivatives along each branch and place the result at the end of the branch.\n\n![](images/f0/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nFinally, to find $\\dfrac{\\textrm{d}f}{\\textrm{d}t},$ we sum the results for each branch:\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}t}\n = \\dfrac{\\partial f}{\\partial x} \\cdot \\dfrac{\\textrm{d}x}{\\textrm{d}t} + \\dfrac{\\partial f}{\\partial y} \\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}t}\n$$\n\nThis result is called the **multivariable chain rule**." :tutorial/id #uuid "80ad8a26-7d43-52d6-b0ba-e1d04283e5ad" :tutorial/math-academy-id 4957 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186168062 :tutorial/content "How do we apply the multivariable chain rule if the intermediate variables are also dependent on two variables? \n\nFor example, suppose we have\n\n$$\nf = f(x,y), \\qquad x=g(s,t), \\qquad y=h(s,t).\n$$\n\nHow do we compute $\\dfrac{\\partial f}{\\partial s}?$ \n\nFirst, let's construct a tree diagram.\n\n![](images/ca/ca524eda2e6be3354fcb72bed52fcaf22257073c3228d74850f8226f9ef0af6f.png)\n\nNow, since we're interested in $\\dfrac{\\partial f}{\\partial s},$ we highlight all branches that give differentiation with respect to $s:$\n\n![](images/21/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nIf we keep $t$ fixed and differentiate $f$ with respect to $s,$ then according to the chain rule for two intermediate variables and one independent variable, we obtain\n\n$$\n\\dfrac{\\partial f}{\\partial s} = \\dfrac{\\partial f}{\\partial x} \\cdot \\dfrac{\\partial x}{\\partial s} + \\dfrac{\\partial f}{\\partial y} \\cdot \\dfrac{\\partial y}{\\partial s}.\n$$\n\nSimilarly, if we wanted to compute $\\dfrac{\\partial f}{\\partial t},$ we would highlight all branches that give differentiation with respect to $t\\mathbin{:}$\n\n![](images/11/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nKeeping $s$ fixed and differentiating $f$ with respect to $t$ gives\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x} \\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y} \\cdot \\dfrac{\\partial y}{\\partial t}.\n$$" :tutorial/id #uuid "58d189b1-31fb-5b1b-bc4c-cff6be5e2f7b" :tutorial/math-academy-id 4958 :tutorial/title "The Multivariable Chain Rule With Two Independent Variables"}] [{:db/id #edb/ref 17592186168063 :tutorial/content "We can generalize the chain rule to a multivariable function containing an arbitrary number of intermediate and independent variables.\n\nConsider the multivariable function \n\n$$\nf = f(x_1,x_2, \\ldots, x_m)\n$$\n\nwith $m$ independent variables and, for each $i \\in \\{1,\\ldots, n\\},$ the variable \n\n$$\nx_i = g_i(t_1, t_2, \\ldots, t_n)\n$$\n\nis a differentiable function of $n$ independent variables. Then,\n\n$$\n\\dfrac{\\partial f}{\\partial t_j} = \\dfrac{\\partial f}{\\partial x_1} \\cdot \\dfrac{\\partial x_1}{\\partial t_j} + \\dfrac{\\partial f}{\\partial x_2} \\cdot \\dfrac{\\partial x_2}{\\partial t_j} + \\dots + \\dfrac{\\partial f}{\\partial x_m} \\cdot \\dfrac{\\partial x_m}{\\partial t_j}\n$$\n\nfor $j \\in \\{1,2,\\ldots, n\\}.$" :tutorial/id #uuid "1ba7d2a4-05a6-5e62-8035-2610239633c3" :tutorial/math-academy-id 4959 :tutorial/title "The Generalized Multivariable Chain Rule"}] [{:db/id #edb/ref 17592186168082 :tutorial/content "A vector field $\\mathbf F$ is **conservative** if there exists a scalar function $f$ such that \n\n$$\n\\mathbf{F} = \\nabla \\! f.\n$$\n\nIf such a function $f$ exists, it is called a **potential function** for $\\mathbf F.$\n\nFor example, consider the vector field $\\mathbf F,$ given by\n\n$$\n\\mathbf F(x,y) = 2x\\,\\mathbf i + 2y\\,\\mathbf j.\n$$\n\nThe function $f(x,y) = x^2 + y^2$ is a potential function for $\\mathbf F$ because\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\,j \\\\  & =2x\\,i+2y\\,j \\\\  & =F.\\end{aligned}\n$$\n\nNot all vector fields are conservative. However, conservative vector fields have many interesting and useful properties, as we'll soon discover." :tutorial/id #uuid "b1462096-7305-5fe4-ae99-253541521cba" :tutorial/math-academy-id 5152 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186168088 :tutorial/content "There is a special case of the multivariable chain rule when $f=f(x,y)$ and $y=g(x).$ \n\nNotice that $x$ is an independent variable here. Therefore, the chain rule becomes\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{∂f}{∂x}\\cdot \\underbrace{\\frac{\\text{d}x}{\\text{d}x}}_{1}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\\end{aligned}\n$$" :tutorial/id #uuid "44effd03-02e7-5eb1-8732-ee1522afa147" :tutorial/math-academy-id 5184 :tutorial/title "A Special Case of the Multivariable Chain Rule"}] [{:db/id #edb/ref 17592186168124 :tutorial/content "Let $\\mathbf F(x,y) = P(x,y)\\,\\mathbf i+ Q(x,y)\\,\\mathbf j$ be a vector field with domain $D = \\mathbb R^2,$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$\\mathbf F$ *is conservative if and only if $$\n\\displaystyle \\dfrac{\\partial P}{\\partial y} = \\dfrac{\\partial Q}{\\partial x}\n$$ everywhere on $D.$*\n\nNote that this is equivalent to saying that the scalar curl is zero everywhere on $D,$ i.e.,\n\n$$\\dfrac{\\partial Q}{\\partial x} - \\dfrac{\\partial P}{\\partial y} = 0.$$\n\nIf $D\\neq\\mathbb R^2,$ then the situation gets a little trickier. We'll consider this case in a separate lesson." :tutorial/id #uuid "9a5b26c9-caa5-579e-a57c-c42b07eebafe" :tutorial/math-academy-id 5806 :tutorial/title "A Test to Determine Whether a Given Vector Field is Conservative"}] [{:db/id #edb/ref 17592186172054 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171860} :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048916}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186172299} {:db/id #edb/ref 17592186172300} {:db/id #edb/ref 17592186259847} {:db/id #edb/ref 17592186259853} {:db/id #edb/ref 17592186259861} {:db/id #edb/