&= \\begin{bmatrix}16 \\\\ -12\\end{bmatrix}-\\begin{bmatrix}-21 \\\\ 0\\end{bmatrix} \\\\\n&= \\begin{bmatrix}37 \\\\ -12\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "804b8c09-443d-5054-8205-f07496838c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186637636}] :answer-field/correct {:answer/id #uuid "804b8c09-443d-5054-8205-f07496838c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186637636} :answer-field/id #uuid "489325a7-f891-5884-a767-ffa5bf529be6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637630} {:answer-field/choices [{:answer/id #uuid "0ebfe1c4-028e-590e-9465-f1c4df8692c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186637624}] :answer-field/correct {:answer/id #uuid "0ebfe1c4-028e-590e-9465-f1c4df8692c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186637624} :answer-field/id #uuid "9342abc5-0364-510b-b0c6-164dca0f8c75" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637638}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73a80838-de98-5e1a-989c-ed679185e024" :question/problem "Let the column vectors be\n\n<div class=\"matrix-operands\">\n<div>$a=\\begin{bmatrix}-1 \\\\ -6\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-4 \\\\ 8\\end{bmatrix}$</div>\n<div>$c=\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}$</div>\n</div>\n\nFind $b + (3a - 3c)$.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$b + (3a - 3c)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\nb + (3a - 3c) &= \\begin{bmatrix}-4 \\\\ 8\\end{bmatrix}+(3\\cdot \\begin{bmatrix}-1 \\\\ -6\\end{bmatrix}-3\\cdot \\begin{bmatrix}2 \\\\ 6\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}-4 \\\\ 8\\end{bmatrix}+(\\begin{bmatrix}-3 \\\\ -18\\end{bmatrix}-\\begin{bmatrix}6 \\\\ 18\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}-4 \\\\ 8\\end{bmatrix}+\\begin{bmatrix}-9 \\\\ -36\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-13 \\\\ -28\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccc03e82-b240-5175-86ae-b6fe94dcdef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186637644}] :answer-field/correct {:answer/id #uuid "ccc03e82-b240-5175-86ae-b6fe94dcdef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186637644} :answer-field/id #uuid "998b4df4-11e2-5d66-9bcf-033f23bece56" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637640} {:answer-field/choices [{:answer/id #uuid "dac9db0a-4478-5c14-954d-3d14ca5183dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186637647}] :answer-field/correct {:answer/id #uuid "dac9db0a-4478-5c14-954d-3d14ca5183dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186637647} :answer-field/id #uuid "b984397b-aada-5f4d-8490-94538c2df97a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637641}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d037862d-ae1e-5b60-93ea-f6bf59ea876e" :question/problem "Let the column vectors be\n\n<div class=\"matrix-operands\">\n<div>$a=\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}$</div>\n<div>$c=\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}$</div>\n</div>\n\nFind $4b - (c - 2a)$.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$4b - (c - 2a)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n4b - (c - 2a) &= 4\\cdot \\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}-(\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}-2\\cdot \\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}-12 \\\\ 8\\end{bmatrix}-(\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ -4\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}-12 \\\\ 8\\end{bmatrix}-\\begin{bmatrix}4 \\\\ 11\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-16 \\\\ -3\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d0db60-2113-5589-904c-a3d5aa97379e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 \\\\ -17\\end{bmatrix}" :db/id #edb/ref 17592186637625} {:answer/id #uuid "4df57d4d-5121-54a6-9412-a901a9a9bb90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-45 \\\\ 32\\end{bmatrix}" :db/id #edb/ref 17592186637631} {:answer/id #uuid "6e84776d-55f0-5ad4-806b-dd194787e2b8" :answer/type {:db/id #