\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-8 \\\\ -3\\end{bmatrix}$</div>\n<div>$c=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}$</div>\n</div>\n\nFind $2c - (2a - 5b)$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n2c - (2a - 5b) &= 2\\cdot \\begin{bmatrix}4 \\\\ 3\\end{bmatrix}-(2\\cdot \\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}-5\\cdot \\begin{bmatrix}-8 \\\\ -3\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}8 \\\\ 6\\end{bmatrix}-(\\begin{bmatrix}-2 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}-40 \\\\ -15\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}8 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}38 \\\\ 27\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-30 \\\\ -21\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ffb014-a19e-5186-88f1-ecaf37893ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51" :db/id #edb/ref 17592186637663} {:answer/id #uuid "648ce248-63f0-5833-ae5a-478a0e07fda8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637675} {:answer/id #uuid "68661bde-1659-5365-813a-1a8433361496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-49" :db/id #edb/ref 17592186637677} {:answer/id #uuid "d9eb3d58-90df-5fb7-be2d-0dfeb3ae4cad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186637689} {:answer/id #uuid "dc68555d-aac6-56e7-acb6-d4f91757e1ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186637690}] :answer-field/correct {:answer/id #uuid "648ce248-63f0-5833-ae5a-478a0e07fda8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637675} :answer-field/id #u