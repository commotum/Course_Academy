8cffc25e2cce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703035} {:answer-field/choices [{:answer/id #uuid "5b0e41dd-6dba-5d7c-9b31-88f4fd9dbb55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186703025}] :answer-field/correct {:answer/id #uuid "5b0e41dd-6dba-5d7c-9b31-88f4fd9dbb55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186703025} :answer-field/id #uuid "b43ab255-8ae2-5fb7-8d3b-10b4432e5e81" :answer-field/key "point-second" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703044}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "23f28e74-77e0-59c1-9fe4-d04ff5ae323d" :question/problem "Which graph shows the line $y=1-x$?\n\nFirst give the two points on this line with $x=-2$ and $x=2$. Enter each answer as an ordered pair $(x,y)$, then select the graph.\n\nPoint with $x=-2$: {{point-first}}\n\nPoint with $x=2$: {{point-second}}" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=-2.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =1-x \\\\  & =1-(-2) \\\\  & =1+2 \\\\  & =3.\\end{aligned}\n$$\n\nSo, the first point is $(-2,3).$\n\n- For the second point, we will let the $x$-coordinate be $x=2.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =1-x \\\\  & =1-(2) \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the second point is $(2,-1).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=1-x.$\n\n![](images/d2/d2f018d147362771ada1a59c98214c4df5bcac60129243ec6a7bb206794b13c9.png)\n\nAll choices have the same $y$-intercept. Check another point to distinguish the lines."}] [{:db/id #edb/ref 17592186703032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9872d773-6d2a-5a41-a8df-ebc240829ed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186703037}] :answer-field/correct {:answer/id #uuid "9872d773-6d2a-5a41-a8df-ebc240829ed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186703037} :answer-field/id #uuid "472cfa13-2424-5908-9e51-2888957966fb" :answer-field/key "point-second" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703021} {:answer-field/choices [{:answer/id #uuid "3aa9d8e9-d5f7-5ce8-a340-188c032883e1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/091bc1230b8729d0468ad940937d64dd89b04ae25d82615c8225157e1d191d18.png" :db/id #edb/ref 17592186703018} {:answer/id #uuid "5f1c2802-01de-51e1-ad4f-5f1d18329121" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4a491847b4a6b647032831e563fe7d4007e63fb5dd4b594dd825c1055a82451.png" :db/id #edb/ref 17592186703026} {:answer/id #uuid "606b24ab-7948-560e-bee9-639d49952bea" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f6c613ac31220b890d69fb2db001c126fb49d04621c3641d0848973db9954069.png" :db/id #edb/ref 17592186703027} {:answer/id #uuid "63d5d03b-ffa4-5709-a9f4-b704722cfd3a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/930ab140366898b219de63fd5acb6379891e39108eb4d4ea7a54ae4c2d4d558b.png" :db/id #edb/ref 17592186703028} {:answer/id #uuid "ae2bc681-3608-528b-be6d-9a340cbe0823" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd63a41d04a0a3729537220f26466ac69802e90af04a08058c954b3a0ffcaae6.png" :db/id #edb/ref 17592186703042}] :answer-field/correct {:answer/id #uuid "5f1c2802-01de-51e1-ad4f-5f1d18329121" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4a491847b4a6b647032831e563fe7d4007e63fb5dd4b594dd825c1055a82451.png" :db/id #edb/ref 17592186703026} :answer-field/id #uuid "96df763f-04f8-5234-a5e0-c013e247dc1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703036} {:answer-field/choices [{:answer/id #uuid "da5d04dc-ea2a-508f-9090-b713cddc95b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186703049}] :answer-field/correct {:answer/id #uuid "da5d04dc-ea2a-508f-9090-b713cddc95b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186703049} :answer-field/id #uuid "eb7b7847-0735-5ccf-a68d-5258543a9f47" :answer-field/key "point-first" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703054}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e821612-6a2c-538c-b7ed-bde6a5fe75af" :question/problem "Which graph shows the line $y=-1+\\frac{1}{3}x$?\n\nFirst give the two points on this line with $x=-3$ and $x=3$. Enter each answer as an ordered pair $(x,y)$, then select the graph.\n\nPoint with $x=-3$: {{point-first}}\n\nPoint with $x=3$: {{point-second}}" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=-3.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-1+\\frac{1}{3}x \\\\  & =-1+\\frac{1}{3}(-3) \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$\n\nSo, the first point is $(-3,-2).$\n\n- For the second point, we will let the $x$-coordinate be $x=3.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-1+\\frac{1}{3}x \\\\  & =-1+\\frac{1}{3}(3) \\\\  & =-1+1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, the second point is $(3,0).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-1+\\frac{1}{3}x.$\n\n![](images/6b/6bb16e235d5a29fb9c99c91a7af7ef7af5cdec31ed7d091167d30d993b5ff511.png)\n\nAll choices have the same $y$-intercept. Check another point to distinguish the lines."}] [{:db/id #edb/ref 17592186703045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12ddc4d7-11d0-524a-9779-73fd74ede487" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/930ab140366898b219de63fd5acb6379891e39108eb4d4ea7a54ae4c2d4d558b.png" :db/id #edb/ref 17592186703007} {:answer/id #uuid "173adfa8-6373-5f64-8e97-52b9da25b329" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4a491847b4a6b647032831e563fe7d4007e63fb5dd4b594dd825c1055a82451.png" :db/id #edb/ref 17592186703008} {:answer/id #uuid "66dfe7ae-907d-5d1c-883e-d79eafde3b11" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/50/50f053978b0028aaf7576275d783017014c7f7af0462ce4b67a6eeb82bc0fe56.png" :db/id #edb/ref 17592186703030} {:answer/id #uuid "9b8b418d-6be9-56b8-af64-bfae72249a7d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd63a41d04a0a3729537220f26466ac69802e90af04a08058c954b3a0ffcaae6.png" :db/id #edb/ref 17592186703038} {:answer/id #uuid "e2e23314-98b5-50e7-9325-5dfbaaa98dda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8c/8c353c411299420f50fef1bd9bbe6391b16dfe9cdbb61bf655becd41d8431df2.png" :db/id #edb/ref 17592186703050}] :answer-field/correct {:answer/id #uuid "66dfe7ae-907d-5d1c-883e-d79eafde3b11" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/50/50f053978b0028aaf7576275d783017014c7f7af0462ce4b67a6eeb82bc0fe56.png" :db/id #edb/ref 17592186703030} :answer-field/id #uuid "ac711ee8-3c13-54a6-995d-c12c763cc84c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703041} {:answer-field/choices [{:answer/id #uuid "ffcd649f-732a-57c5-988c-6d73d470c89a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-3)" :db/id #edb/ref 17592186703057}] :answer-field/correct {:answer/id #uuid "ffcd649f-732a-57c5-988c-6d73d470c89a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-3)" :db/id #edb/ref 17592186703057} :answer-field/id #uuid "d45d50b4-4f13-575c-9edb-2ea504967d12" :answer-field/key "point-first" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703048} {:answer-field/choices [{:answer/id #uuid "e90122a6-8999-5364-9fb8-eb255a96aece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186703052}] :answer-field/correct {:answer/id #uuid "e90122a6-8999-5364-9fb8-eb255a96aece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186703052} :answer-field/id #uuid "ea1af602-fff0-5a88-a9ed-65a422bf25a4" :answer-field/key "point-second" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703053}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b8280c26-9dee-5915-b8e6-ed0a6bc709aa" :question/problem "Which graph shows the line $y=\\frac{1}{2}x-1$?\n\nFirst give the two points on this line with $x=-4$ and $x=4$. Enter each answer as an ordered pair $(x,y)$, then select the graph.\n\nPoint with $x=-4$: {{point-first}}\n\nPoint with $x=4$: {{point-second}}" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=-4.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}x-1 \\\\  & =\\frac{1}{2}(-4)-1 \\\\  & =-2-1 \\\\  & =-3.\\end{aligned}\n$$\n\nSo, the first point is $(-4,-3).$\n\n- For the second point, we will let the $x$-coordinate be $x=4.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}x-1 \\\\  & =\\frac{1}{2}(4)-1 \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nSo, the second point is $(4,1).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=\\frac{1}{2}x-1.$\n\n![](images/ce/ce0997e42327f0ced575bb28ed6f5428efea8cd94eeef100bb98c31c3c33f4a5.png)\n\nAll choices have the same $y$-intercept. Check another point to distinguish the lines."}] [{:db/id #edb/ref 17592186703047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb3d1cb-4201-5355-8f1d-575379ea953f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186703019}] :answer-field/correct {:answer/id #uuid "3fb3d1cb-4201-5355-8f1d-575379ea953f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186703019} :answer-field/id #uuid "0fee4476-bc49-57da-8f2b-039894a73421" :answer-field/key "point-second" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703005} {:answer-field/choices [{:answer/id #uuid "a5e6e9de-339e-53a7-b11c-3fac3ba9b0df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186703039}] :answer-field/correct {:answer/id #uuid "a5e6e9de-339e-53a7-b11c-3fac3ba9b0df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186703039} :answer-field/id #uuid "2dce9ec4-1b82-5d24-aec7-97f28d5bee8f" :answer-field/key "point-first" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703011} {:answer-field/choices [{:answer/id #uuid "316252c1-6b50-5156-ba55-7d8f043ab887" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4a491847b4a6b647032831e563fe7d4007e63fb5dd4b594dd825c1055a82451.png" :db/id #edb/ref 17592186703014} {:answer/id #uuid "324826cc-6743-5fa2-8467-fedc89d3ebac" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8c/8c353c411299420f50fef1bd9bbe6391b16dfe9cdbb61bf655becd41d8431df2.png" :db/id #edb/ref 17592186703015} {:answer/id #uuid "508b6a22-4527-5364-bbf5-e1be270cacb5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/50/50f053978b0028aaf7576275d783017014c7f7af0462ce4b67a6eeb82bc0fe56.png" :db/id #edb/ref 17592186703024} {:answer/id #uuid "664c471c-eea4-5026-b93c-0a88cc70cb7f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/930ab140366898b219de63fd5acb6379891e39108eb4d4ea7a54ae4c2d4d558b.png" :db/id #edb/ref 17592186703029} {:answer/id #uuid "e7b6b4f6-43da-53f2-88d0-ca5fa60f2dc3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f6c613ac31220b890d69fb2db001c126fb49d04621c3641d0848973db9954069.png" :db/id #edb/ref 17592186703051}] :answer-field/correct {:answer/id #uuid "e7b6b4f6-43da-53f2-88d0-ca5fa60f2dc3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f6c613ac31220b890d69fb2db001c126fb49d04621c3641d0848973db9954069.png" :db/id #edb/ref 17592186703051} :answer-field/id #uuid "4d83bd6a-3561-5c35-9c75-e22bf22f79b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703023}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c2adfeb4-b21c-5450-856e-b558716cde1c" :question/problem "Which graph shows the line $y=-1+2x$?\n\nFirst give the two points on this line with $x=-1$ and $x=2$. Enter each answer as an ordered pair $(x,y)$, then select the graph.\n\nPoint with $x=-1$: {{point-first}}\n\nPoint with $x=2$: {{point-second}}" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=-1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-1+2x \\\\  & =-1+2(-1) \\\\  & =-1-2 \\\\  & =-3.\\end{aligned}\n$$\n\nSo, the first point is $(-1,-3).$\n\n- For the second point, we will let the $x$-coordinate be $x=2.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-1+2x \\\\  & =-1+2(2) \\\\  & =-1+4 \\\\  & =3.\\end{aligned}\n$$\n\nSo, the second point is $(2,3).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-1+2x.$\n\n![](images/c7/c7162c5055ef64b0b61c03df4eedf11c705ecd7bb5ae4b83abe850b03c4484cd.png)\n\nAll choices have the same $y$-intercept. Check another point to distinguish the lines."}] [{:db/id #edb/ref 17592186703068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a97a6d4-fb2f-5442-b128-08e6902c491c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186703061}] :answer-field/correct {:answer/id #uuid "1a97a6d4-fb2f-5442-b128-08e6902c491c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186703061} :answer-field/id #uuid "1f832a77-12f8-5346-9cd2-405efc87e76b" :answer-field/key "y-second" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703063} {:answer-field/choices [{:answer/id #uuid "2031f4c1-33cc-5db0-ba6b-5660872fd414" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/74/74b82c2bf64943118f673451dff1dab2faeac01db913d4f4922f9db31b95025a.png" :db/id #edb/ref 17592186703064} {:answer/id #uuid "7094af9e-ab67-5d0f-84a7-7ea43f3894bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/455754194b8dec1c9d61d25e0ad5ff0e4f7dc8b723ac46db1c5336e9463338fc.png" :db/id #edb/ref 17592186703079} {:answer/id #uuid "768f0035-ba05-5acf-8418-7300b3f83301" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e0/e051781c50e50b674ae914596db04f75d261947d984ac6a30ac949e81b0b7810.png" :db/id #edb/ref 17592186703080} {:answer/id #uuid "7d24ee5b-3f03-5a17-8b6d-58e971a3a8c0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b3/b30edfb5a5e5e1e913c072ca609c81ab429f86c6eaa2be09b2e7e8e92016de8f.png" :db/id #edb/ref 17592186703082} {:answer/id #uuid "fb1333ff-cd9a-59ac-939d-8fe7a55b230b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/56/56fa91407fcfb9bea5168fd358fe666d8c73802ac5a3600c71ec799ceb43f454.png" :db/id #edb/ref 17592186703100}] :answer-field/correct {:answer/id #uuid "2031f4c1-33cc-5db0-ba6b-5660872fd414" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/74/74b82c2bf64943118f673451dff1dab2faeac01db913d4f4922f9db31b95025a.png" :db/id #edb/ref 17592186703064} :answer-field/id #uuid "3d65c017-e378-57d7-91d9-c4e40c887d67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703070} {:answer-field/choices [{:answer/id #uuid "5d1d7db8-07e7-58e3-a167-14b8b98f8bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186703076}] :answer-field/correct {:answer/id #uuid "5d1d7db8-07e7-58e3-a167-14b8b98f8bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186703076} :answer-field/id #uuid "ba1dcd5a-9828-50e0-ad86-cc6364185d7b" :answer-field/key "y-first" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35f03679-4bb8-5415-9423-a5143dede960" :question/problem "Use two points to sketch $y=2-2x$.\n\nComplete the two $y$-coordinates, then choose the graph through both points.\n\nWhen $x=0$, $y=$ {{y-first}}.\n\nWhen $x=-1$, $y=$ {{y-second}}." :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-2x \\\\  & =2-2(0) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the first point is $(0,2).$\n\n- For the second point, we will let the $x$-coordinate be $x=-1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-2x \\\\  & =2-2(-1) \\\\  & =2+2 \\\\  & =4.\\end{aligned}\n$$\n\nSo, the second point is $(-1,4).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=2-2x.$\n\n![](images/74/740fabee46d03c5690c52e82274b31a48abffd4e3d7c576dd207cddce2180c36.png)\n\nAll choices have the same $y$-intercept. Check another point to distinguish the lines."}] [{:db/id #edb/ref 17592186703075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d914b77-86e1-5d14-bea6-1403dd2d81d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186703083