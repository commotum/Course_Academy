s have the same $y$-intercept. Check another point to distinguish the lines."}] [{:db/id #edb/ref 17592186703078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebb44b68-43b5-5535-8e66-e3a544fc9cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186703098}] :answer-field/correct {:answer/id #uuid "ebb44b68-43b5-5535-8e66-e3a544fc9cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186703098} :answer-field/id #uuid "306bcfb6-ac3c-5fa6-a186-abafadc525d9" :answer-field/key "y-second" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186703066} {:answer-field/choices [{:answer/id #uuid "34de69b2-a0f2-581d-a727-49308e7ca08f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7d/7d26d546c2587778dd7586286acd56dca818b2e340609c70f12e43c11f8b1919.png" :db/id #edb/ref 17592186703067} {:answer/id #uuid "af95198c-d41d-50ce-9b6d-519b04aadc0d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a8fd7a4ab9f7d98e1c10c7a60e643c06b35b6b59f03619b67a16e87a0b2ba9a2.png" :db/id #edb/ref 17592186703088} {:answer/id #uuid "b377bbc9-ccb1-5d48-bb43-a668e8f539c1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f53516009ae6a82e6a0136a3e79bd6aea5adfdfd49af8e78e1ba4d25eb5b7276.png" :db/id #edb/ref 17592186703089} {:answer/id #uuid "ca151959-8484-5f34-8547-0b25651d41d8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e2f5150f1daecd1a6e16c8d95212fe1c44153b637b408231ad621b8cba62b7b.png" :db/id #edb/ref 17592186703093} {:answer/id #uuid "d7967b4e-c7e6-55b6-aa74-485a72b2eb9c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a304d5c739110310ecd013bb0b