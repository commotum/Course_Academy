#{[{:db/id #edb/ref 17592186725230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fa5f3bf-be9e-5d06-a106-e4fbf5c32cc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-1" :db/id #edb/ref 17592186725227} {:answer/id #uuid "a409128e-d6f5-50d1-ba23-92712e790404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6" :db/id #edb/ref 17592186725234} {:answer/id #uuid "b2ee577f-5b7f-5dda-9d9f-0487302af7cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186725238} {:answer/id #uuid "bcbf90a4-0ace-530a-8304-4c6bb3ff29a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-5" :db/id #edb/ref 17592186725239} {:answer/id #uuid "cd95341a-8a4a-5220-8b6b-59d9e845af63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186725244}] :answer-field/correct {:answer/id #uuid "b2ee577f-5b7f-5dda-9d9f-0487302af7cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186725238} :answer-field/id #uuid "b2391a45-ba67-5f9d-bcdf-60718e7bea8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186725237}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8243761d-dde5-596c-af1c-7985e5e86494" :question/problem "A curve is defined by the parametric equations\n\n$$\n\\begin{aligned}x&=3 \\left(t - 1\\right)^{5} - 2 \\\\ y&=t - 2\\end{aligned}\n$$\n\n$$\n-\\infty<t<\\infty.\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is vertical. Give exact answers." :question/worked-solution "The parametric slope is $m=y'(t)/x'(t)$. A vertical tangent requires $x'(t)=0$ and $y'(t)\\ne0$. Differentiate both coordinates:\n\n$$\n\\begin{aligned}x'(t)&=15 \\left(t - 1\\right)^{4} \\\\ y'(t)&=1\\end{aligned}\n$$\n\nSolve $x'(t)=0$ and retain precisely the values in the stated domain:\n\n$$\n\\begin{aligned}15 \\left(t - 1\\right)^{4}&=0 \\\\ t&=1\\end{aligned}\n$$\n\nCheck the other derivative at each surviving value:\n\n$$\n\\begin{aligned}y'(1)&=1\\ne0\\end{aligned}\n$$\n\nTherefore, the tangent is vertical at $t=1$."}] [{:db/id #edb/ref 17592186725232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2941390a-9c01-5fac-8e44-2325cea57290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-4" :db/id #edb/ref 17592186725222} {:answer/id #uuid "89b002cb-a18a-5670-8b84-51604739df1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-1" :db/id #edb/ref 17592186725231} {:answer/id #uuid "a3f7bc94-61ed-571d-87df-c0fc070e89f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3" :db/id #edb/ref 17592186725233} {:answer/id #uuid "c049c166-be6d-5863-975b-504594dbd0f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-6" :db/id #edb/ref 17592186725241} {:answer/id #uuid "c4699531-99aa-5981-96b4-b674c9993ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186725243}] :answer-field/correct {:answer/id #uuid "89b002cb-a18a-5670-8b84-51604739df1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-1" :db/id #edb/ref 17592186725231} :answer-field/id #uuid "5b514155-5221-5852-90c2-11eebbbd1a77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186725226}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95a65ed5-25f9-50bc-bfaa-71e615d87367" :question/problem "A curve is defined by the parametric equations\n\n$$\n\\begin{aligned}x&=2 t - 2 \\\\ y&=2 - 2 \\left(t + 1\\right)^{5}\\end{aligned}\n$$\n\n$$\n-\\infty<t<\\infty.\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is horizontal. Give exact answers." :question/worked-solution "The parametric slope is $m=y'(t)/x'(t)$. A horizontal tangent requires $y'(t)=0$ and $x'(t)\\ne0$. Differentiate both coordinates:\n\n$$\n\\begin{aligned}x'(t)&=2 \\\\ y'(t)&=- 10 \\left(t + 1\\right)^{4}\\end{aligned}\n$$\n\nSolve $y'(t)=0$ and retain precisely the values in the stated domain:\n\n$$\n\\begin{aligned}- 10 \\left(t + 1\\right)^{4}&=0 \\\\ t&=-1\\end{aligned}\n$$\n\nCheck the other derivative at each surviving value:\n\n$$\n\\begin{aligned}x'(-1)&=2\\ne0\\end{aligned}\n$$\n\nTherefore, the tangent is horizontal at $t=-1$."}] [{:db/id #edb/ref 17592186725248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0283bafe-6809-5b45-9cde-f6b49687d2c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-4" :db/id #edb/ref 17592186725216} {:answer/id #uuid "1db7c07c-a1f1-5dd4-b6a5-88845e3099d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-6" :db/id #edb/ref 17592186725221} {:answer/id #uuid "54aca2e3-4b3e-5216-8c6a-8604460da312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-2" :db/id #edb/ref 17592186725225} {:answer/id #uuid "a42b9b68-cda1-5cc6-9beb-4fb80acc8056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6" :db/id #edb/ref 17592186725235} {:answer/id #uuid "b22fca6b-a980-5cc1-ba0c-ee2c0ad5c8b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3" :db/id #edb/ref 17592186725236}] :answer-field/correct {:answer/id #uuid "54aca2e3-4b3e-5216-8c6a-8604460da312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-2" :db/id #edb/ref 17592186725225} :answer-field/id #uuid "e0cea8d9-27cf-53a7-aeab-bd95b7845fb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186725246}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8d81906-7005-5871-bdcd-596dd53629b2" :question/problem "A curve is defined by the parametric equations\n\n$$\n\\begin{aligned}x&=2 - 2 t \\\\ y&=1 - 2 \\left(t + 2\\right)^{2}\\end{aligned}\n$$\n\n$$\n-\\infty<t<\\infty.\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is horizontal. Give exact answers." :question/worked-solution "The parametric slope is $m=y'(t)/x'(t)$. A horizontal tangent requires $y'(t)=0$ and $x'(t)\\ne0$. Differentiate both coordinates:\n\n$$\n\\begin{aligned}x'(t)&=-2 \\\\ y'(t)&=- 4 t - 8\\end{aligned}\n$$\n\nSolve $y'(t)=0$ and retain precisely the values in the stated domain:\n\n$$\n\\begin{aligned}- 4 t - 8&=0 \\\\ t&=-2\\end{aligned}\n$$\n\nCheck the other derivative at each surviving value:\n\n$$\n\\begin{aligned}x'(-2)&=-2\\ne0\\end{aligned}\n$$\n\nTherefore, the tangent is horizontal at $t=-2$."}] [{:db/id #edb/ref 17592186725250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0538934b-64bb-5bb0-91c3-d34bea2f6e8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5" :db/id #edb/ref 17592186725217} {:answer/id #uuid "1adc325e-bbe2-530f-bb6f-4a017cbd8e00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-6" :db/id #edb/ref 17592186725220} {:answer/id #uuid "66f7c30b-4d19-58de-8021-f40c30d895f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-4" :db/id #edb/ref 17592186725228} {:answer/id #uuid "7589708a-5cf8-5f75-841c-0fb2d021ad57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6" :db/id #edb/ref 17592186725229} {:answer/id #uuid "daa70eb7-aad9-59e9-905e-dfb0f47f4d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-2" :db/id #edb/ref 17592186725245}] :answer-field/correct {:answer/id #uuid "1adc325e-bbe2-530f-bb6f-4a017cbd8e00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-6" :db/id #edb/ref 17592186725220} :answer-field/id #uuid "e2e43377-e4a6-5782-adbb-45984d44db9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186725247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7fd4586-8d0d-5aa9-a75b-c6e1d15a0a43" :question/problem "A curve is defined by the parametric equations\n\n$$\n\\begin{aligned}x&=t - 3 \\\\ y&=\\left(t + 6\\right)^{5} + 2\\end{aligned}\n$$\n\n$$\n-\\infty<t<\\infty.\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is horizontal. Give exact answers." :question/worked-solution "The parametric slope is $m=y'(t)/x'(t)$. A horizontal tangent requires $y'(t)=0$ and $x'(t)\\ne0$. Differentiate both coordinates:\n\n$$\n\\begin{aligned}x'(t)&=1 \\\\ y'(t)&=5 \\left(t + 6\\right)^{4}\\end{aligned}\n$$\n\nSolve $y'(t)=0$ and retain precisely the values in the stated domain:\n\n$$\n\\begin{aligned}5 \\left(t + 6\\right)^{4}&=0 \\\\ t&=-6\\end{aligned}\n$$\n\nCheck the other derivative at each surviving value:\n\n$$\n\\begin{aligned}x'(-6)&=1\\ne0\\end{aligned}\n$$\n\nTherefore, the tangent is horizontal at $t=-6$."}]}
