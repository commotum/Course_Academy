c6ca01857c" :answer-field/key "$P(x,y)=\\frac{1}{(x+4)^{2}}\\,i+(x+y)^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30a80a69-f783-54d8-ab59-5af7c2f92b56" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $P(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS=\\{(x,y)\\in {R}^{2}\\,|\\,x\\ne -4\\}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $R(t)$ is *not* a vector field on ${R}^{2}.$ It assigns points in  $R$ (not ${R}^{2}$) to vectors in ${R}^{2}.$\n\n- The function $Q(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\nTherefore, the correct answer is $P(x,y)=\\frac{1}{(x+4)^{2}}\\,i+(x+y)^{2}\\,j$ only."}] [{:db/id #edb/ref 17592186567216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f564c027-fe6e-57d9-a714-0695c3318f28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567235} {:answer/id #uuid "f91c6a42-c1ac-5529-a9f6-7a1965c45958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567237}] :answer-field/correct {:answer/id #uuid "f564c027-fe6e-57d9-a714-0695c3318f28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567235} :answer-field/id #uuid "5ec835d2-9c51-51a2-89e9-974324e8cc7d" :answer-field/key "$V(x,y)=⟨x{e}^{y},1-y⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567203} {:answer-field/choices [{:answer/id #uuid "d5b33e90-1466-5240-a67e-a0c0e98ce9bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567225} {:answer/id #uuid "ee9fd356-b1cc-55c6-959b-beb5488e380a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567233}] :answer-field/correct {:answer/id #uuid "ee9fd356-b1cc-55c6-959b-beb5488e380a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567233} :answer-field/id #uuid "b0b57d94-202b-5646-ba11-25ee2943d2df" :answer-field/key "$W(x,y,z)=⟨x,-y,-z⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567219} {:answer-field/choices [{:answer/id #uuid "42696c72-5443-560e-83aa-8ffbba82a1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567200} {:answer/id #uuid "ee2ef185-0854-5ff5-bb45-ebf9ffcd2a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567232}] :answer-field/correct {:answer/id #uuid "ee2ef185-0854-5ff5-bb45-ebf9ffcd2a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567232} :answer-field/id #uuid "bf0b982b-2cb4-5648-b036-aebfb29a4068" :answer-field/key "$U(x,y)=⟨\\frac{1}{x-1},\\sqrt{x-y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567220}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9c84dc6d-f3c5-526f-a4f4-5ad6cd0c3bce" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $W(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\n- The function $V(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $U(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS=\\{(x,y)\\in {R}^{2}\\,|\\,x\\ne 1,\\,x-y\\ge 0\\}\n$$\n\nto a vector in ${R}^{2}.$\n\nTherefore, the correct answer is $V(x,y)=⟨x{e}^{y},1-y⟩$; $U(x,y)=⟨\\frac{1}{x-1},\\sqrt{x-y}⟩$ only."}] [{:db/id #edb/ref 17592186567229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c919761a-b785-5467-9d53-ffdebf92193b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567223} {:answer/id #uuid "f8e23ac4-649f-541d-bc51-71ecb623818b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567236}] :answer-field/correct {:answer/id #uuid "c919761a-b785-5467-9d53-ffdebf92193b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567223} :answer-field/id #uuid "18ec5692-c9ef-5f0c-a652-876b5d6fbb3f" :answer-field/key "$B(x,y,z)=⟨-2x,3{y}^{3},{z}^{5}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567192} {:answer-field/choices [{:answer/id #uuid "3e2ffb53-48eb-5a77-9716-29f4fd2040fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567199} {:answer/id #uuid "da47e72c-dc30-5c30-ae3b-d7a7f95b1d80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.t