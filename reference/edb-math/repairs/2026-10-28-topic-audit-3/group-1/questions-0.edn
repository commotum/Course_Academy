2186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439846}] :answer-field/correct {:answer/id #uuid "edec9d12-0bd4-51b1-857c-39b0d3a639e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439845} :answer-field/id #uuid "69a5e73f-3177-5c10-a5a9-440d3c78400f" :answer-field/key "$y = x + \\frac{1}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440280} {:answer-field/choices [{:answer/id #uuid "9cb663d8-de5a-51e3-bb4d-8e4f975e7db1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439847} {:answer/id #uuid "1f0202b1-3256-56a6-9f81-b5d0622b9978" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439848}] :answer-field/correct {:answer/id #uuid "1f0202b1-3256-56a6-9f81-b5d0622b9978" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439848} :answer-field/id #uuid "49e99a0a-f180-5be2-8fc7-1134f81777c9" :answer-field/key "$y = \\frac{1}{2}x + 2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440281} {:answer-field/choices [{:answer/id #uuid "27364161-b9ad-5a6e-b527-4b3e2d5b8883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439849} {:answer/id #uuid "d9e1b9e7-60c6-56f9-aca1-3d50f7fe497b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439850}] :answer-field/correct {:answer/id #uuid "27364161-b9ad-5a6e-b527-4b3e2d5b8883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439849} :answer-field/id #uuid "d8ff5166-67c3-5684-8f52-2c346e801f1d" :answer-field/key "$y = \\frac{1}{2}x + \\frac{1}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440282}] :question/id #uuid "56e71e28-d3a5-545f-bf8d-30361fbf20ae" :question/math-academy-id "q-54285" :question/problem "![](images/4c/4ce176ba6bb73da8d6af410bedad4733cf3e705c70e28f133d771b89f78130c5.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply." :question/worked-solution "The line crosses the y-axis at 2 and passes through (4,4); its slope is 1/2. Therefore y=x/2+2, statement $y = \\frac{1}{2}x + 2$."}] [{:db/id #edb/ref 17592186055369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0a3946e-4d98-5306-b4b2-f900a60e9abf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ff/ff2f94655de95a7a5099423b3d0dbbb9bb6e64f39aca105eb8cab1366f547064.png" :db/id #edb/ref 17592186053452} {:answer/id #uuid "f18a5b0b-4150-51bf-ae4a-e1621ffc7785" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8bc5f7358456a111f29f900e8148e60a0fede85ca9b951e3d752ca1e1a800e6a.png" :db/id #edb/ref 17592186053453} {:answer/id #uuid "15e16ea3-e05e-53e9-8ea7-ae8c5c48c14e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7e/7ed9a41dc38df65a985785c318e5d0407a43615cef7dfa0c60ad454099a089a9.png" :db/id #edb/ref 17592186053454} {:answer/id #uuid "2fb80dc2-f93b-5a21-82fe-a63bca5f9b7c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0c/0cfc4bba4867b40c4c38b0886c37bb5c4cd64d293530ece7c67cdb6349134013.png" :db/id #edb/ref 17592186053455} {:answer/id #uuid "3f60c829-2580-5c06-aab1-c1c58924a888" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/0678cd88949fac3a9ce58d255eee9d8a07ba8c3b91a86f90fa24d70d1510568f.png" :db/id #edb/ref 17592186053456}] :answer-field/id #uuid "c2b4ae38-d4b8-5d3e-8141-6ba4d4385b82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053451}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28feb85a-a0a4-55cd-b26b-1f144b97ee7f" :question/math-academy-id "q-54286" :question/problem "Which of the following graphs shows the line $y = 2x - 4$?"}] [{:db/id #edb/ref 17592186055370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95871ea8-427c-5d8b-b7b9-90621fa03a1e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6a/6a26ee2942f083a2edb99e9839d71577e1772bf6410e1ae4beafcde7f59c7109.png" :db/id #edb/ref 17592186053458} {:answer/id #uuid "c7240b34-1c9b-5ca5-9452-e210e669f37a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/893dba533e0afffe05f9603293355ccf38b2723fcd91608ea03fe321e26a0d5f.png" :db/id #edb/ref 17592186053459} {:answer/id #uuid "17588e8d-da64-5d6b-ab34-45af1c4a7804" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ea/eaf735f72849b82e92f7baf0d991f3e024e013b66d9813d4e0d5f3a87632c901.png" :db/id #edb/ref 17592186053460} {:answer/id #uuid "27023196-b279-5485-8ce7-7bf4dc0c7ce4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/af/afb9d602e1bff2fb643f44ed5dfa09d41833740e814739c60d5dd890a2f02270.png" :db/id #edb/ref 17592186053461} {:answer/id #uuid "2a8ce376-c015-5edf-afdd-204f6ccb159f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02f0d3d8bb1bd1e87d05e63579e2a92281de1d000fe2baa7c9942dd80b542efb.png" :db/id #edb/ref 17592186053462}] :answer-field/correct {:answer/id #uuid "c7240b34-1c9b-5ca5-9452-e210e669f37a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/893dba533e0afffe05f9603293355ccf38b2723fcd91608ea03fe321e26a0d5f.png" :db/id #edb/ref 17592186053459} :answer-field/id #uuid "1bbe1741-021b-5eb6-8d9e-91ce5412b307" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053457}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4524558d-8a83-5843-a336-69f66463c3a7" :question/math-academy-id "q-54397" :question/problem "Copy and complete the table below and use it to determine which of the following is the graph of $y=x-2.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-fill=\"#D6EAF8\">$x$</td>\n<td>$0$</td>\n<td>$1$</td>\n<td>$2$</td>\n<td>$3$</td>\n</tr>\n<tr>\n<td data-fill=\"#D6EAF8\">$y$</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n</tbody></table></div>\n\n" :question/worked-solution "First, we fill the table. Given a value of $x,$ we can find the corresponding $y$ by substituting $x$ into the formula $y=x-2.$ Therefore,\n\n- if $x=0$ then $y=(0)-2=-2,$\n\n- if $x=1$ then $y=(1)-2=-1,$\n\n- if $x=2$ then $y=(2)-2=0,$ and\n\n- if $x=3$ then $y=(3)-2=1.$\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $y$ | $-2$ | $-1$ | $0$ | $1$ |\n\nWe plot these $(x,y)$ pairs on the $xy$-plane:\n\n![](images/4f/4fc0e4386dd956c2b98c844941ce2e27cd1c9ca8578aca4cf5142e6971911831.png)\n\nFinally, connecting the points gives us a straight line. This is the graph of $y=x-2.$\n\n![](images/89/893dba533e0afffe05f9603293355ccf38b2723fcd91608ea03fe321e26a0d5f.png)"}] [{:db/id #edb/ref 17592186055429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8012f237-f895-59fa-8270-6503cec53a98" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :a