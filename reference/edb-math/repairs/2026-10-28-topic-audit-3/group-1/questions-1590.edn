#{[{:db/id #edb/ref 17592186540483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "623cb650-31d9-54b8-9bee-37213ff85818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-96,-97,83⟩" :db/id #edb/ref 17592186540463} {:answer/id #uuid "c08bfec9-3d10-5bc3-984f-9e939fddc88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,-13,-16⟩" :db/id #edb/ref 17592186540491} {:answer/id #uuid "d64868dc-1f49-5ce1-b0d7-eed1dcd1e41a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨16,1,13⟩" :db/id #edb/ref 17592186540501} {:answer/id #uuid "f5612d0c-c99c-537d-9979-f84cc01bbe92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-16,1,-13⟩" :db/id #edb/ref 17592186540507} {:answer/id #uuid "fdb8aabb-ec39-5e90-af20-eadc617b1f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-16,-1,-13⟩" :db/id #edb/ref 17592186540510}] :answer-field/correct {:answer/id #uuid "fdb8aabb-ec39-5e90-af20-eadc617b1f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-16,-1,-13⟩" :db/id #edb/ref 17592186540510} :answer-field/id #uuid "ea74f3ed-f8b5-5a09-b41e-e7dc89984dd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540505}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2d00aa1-1933-5301-9a98-c10f6c0863aa" :question/problem "Let $u=⟨-7,8,8⟩$ and $v=⟨6,-5,-7⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -7 & 8 & 8 \\\\ 6 & -5 & -7\\end{vmatrix} \\\\  & =\\begin{vmatrix}8 & 8 \\\\ -5 & -7\\end{vmatrix}i-\\begin{vmatrix}-7 & 8 \\\\ 6 & -7\\end{vmatrix}j+\\begin{vmatrix}-7 & 8 \\\\ 6 & -5\\end{vmatrix}k \\\\  & =((8)(-7)-(8)(-5))i-((-7)(-7)-(8)(6))j+((-7)(-5)-(8)(6))k \\\\  & =(-56-(-40))i-(49-(48))j+(35-(48))k \\\\  & =-16i-j-13k \\\\  & =⟨-16,-1,-13⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4af1c12e-b138-529d-9912-81429586885e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{4},-\\frac{25}{4},\\frac{7}{2}⟩" :db/id #edb/ref 17592186540461} {:answer/id #uuid "66be531f-acfc-566c-952f-5c82b25ac6f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},-\\frac{25}{4},-\\frac{7}{2}⟩" :db/id #edb/ref 17592186540465} {:answer/id #uuid "a4e38e1f-ca4e-5edd-80e9-760d59c37bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{25}{4},-\\frac{7}{2}⟩" :db/id #edb/ref 17592186540484} {:answer/id #uuid "c555375d-64f4-5eb0-baea-1a6328f3c1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{25}{4},-\\frac{7}{2},\\frac{3}{4}⟩" :db/id #edb/ref 17592186540495} {:answer/id #uuid "ecb70fa6-35b2-5b98-9141-cdcd799d17f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{13}{4},-\\frac{15}{4},\\frac{3}{2}⟩" :db/id #edb/ref 17592186540506}] :answer-field/correct {:answer/id #uuid "a4e38e1f-ca4e-5edd-80e9-760d59c37bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{25}{4},-\\frac{7}{2}⟩" :db/id #edb/ref 17592186540484} :answer-field/id #uuid "98d0eee8-8d34-5f0a-b375-50554cb9ecc1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540481}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bf9484b3-9081-5c6e-811b-eb353ca9f662" :question/problem "Let $u=⟨-1,-1,-2⟩$ and $v=⟨-\\frac{5}{2},1,\\frac{5}{4}⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -1 & -1 & -2 \\\\ -\\frac{5}{2} & 1 & \\frac{5}{4}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & -2 \\\\ 1 & \\frac{5}{4}\\end{vmatrix}i-\\begin{vmatrix}-1 & -2 \\\\ -\\frac{5}{2} & \\frac{5}{4}\\end{vmatrix}j+\\begin{vmatrix}-1 & -1 \\\\ -\\frac{5}{2} & 1\\end{vmatrix}k \\\\  & =((-1)\\left(\\frac{5}{4}\\right)-(-2)(1))i-((-1)\\left(\\frac{5}{4}\\right)-(-2)\\left(-\\frac{5}{2}\\right))j+((-1)(1)-(-1)\\left(-\\frac{5}{2}\\right))k \\\\  & =(-\\frac{5}{4}-(-2))i-(-\\frac{5}{4}-(5))j+(-1-\\left(\\frac{5}{2}\\right))k \\\\  & =\\frac{3}{4}i+\\frac{25}{4}j-\\frac{7}{2}k \\\\  & =⟨\\frac{3}{4},\\frac{25}{4},-\\frac{7}{2}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad1641c-1f9e-5a19-a1bd-de9ae95eebcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-16,-14,19⟩" :db/id #edb/ref 17592186540443} {:answer/id #uuid "18c7b2ce-0f71-5379-a623-1a6f1d78a86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨23,-40,22⟩" :db/id #edb/ref 17592186540446} {:answer/id #uuid "3edbebec-ecdd-5817-bd77-9d3637fab5ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨19,16,-14⟩" :db/id #edb/ref 17592186540457} {:answer/id #uuid "58947e43-4c02-585a-bd90-052680ac2fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-19,16,14⟩" :db/id #edb/ref 17592186540462} {:answer/id #uuid "e264bf54-01ba-5db5-b058-20590668b59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨19,-16,-14⟩" :db/id #edb/ref 17592186540503}] :answer-field/correct {:answer/id #uuid "e264bf54-01ba-5db5-b058-20590668b59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨19,-16,-14⟩" :db/id #edb/ref 17592186540503} :answer-field/id #uuid "1ad656a5-0bd6-55c3-aa8e-589d9ffff31f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540447}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c77adb70-a8ce-5278-ac35-a3c62801b336" :question/problem "Let $u=⟨4,3,2⟩$ and $v=⟨6,1,7⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 4 & 3 & 2 \\\\ 6 & 1 & 7\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 2 \\\\ 1 & 7\\end{vmatrix}i-\\begin{vmatrix}4 & 2 \\\\ 6 & 7\\end{vmatrix}j+\\begin{vmatrix}4 & 3 \\\\ 6 & 1\\end{vmatrix}k \\\\  & =((3)(7)-(2)(1))i-((4)(7)-(2)(6))j+((4)(1)-(3)(6))k \\\\  & =(21-(2))i-(28-(12))j+(4-(18))k \\\\  & =19i-16j-14k \\\\  & =⟨19,-16,-14⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84cdce99-2cbd-5246-99d6-107e6893a0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540474}] :answer-field/correct {:answer/id #uuid "84cdce99-2cbd-5246-99d6-107e6893a0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540474} :answer-field/id #uuid "269331d6-60db-5703-9390-545769dc2659" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540452} {:answer-field/choices [{:answer/id #uuid "818f4d56-b518-5b8a-8fc6-cf7c5020a3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186540470}] :answer-field/correct {:answer/id #uuid "818f4d56-b518-5b8a-8fc6-cf7c5020a3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186540470} :answer-field/id #uuid "d381ad1d-6f4c-5467-b7b4-b1487f9d214c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540500} {:answer-field/choices [{:answer/id #uuid "8bc0cd49-7383-58ed-aa44-fb8643e0805f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186540478}] :answer-field/correct {:answer/id #uuid "8bc0cd49-7383-58ed-aa44-fb8643e0805f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186540478} :answer-field/id #uuid "e2b3a723-99f1-5923-8530-c7f8cca93123" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c864978d-b324-56a0-a971-f1464ab20fb6" :question/problem "Let $u=⟨-3,2,1⟩$ and $v=⟨4,-4,8⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -3 & 2 & 1 \\\\ 4 & -4 & 8\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ -4 & 8\\end{vmatrix}i-\\begin{vmatrix}-3 & 1 \\\\ 4 & 8\\end{vmatrix}j+\\begin{vmatrix}-3 & 2 \\\\ 4 & -4\\end{vmatrix}k \\\\  & =((2)(8)-(1)(-4))i-((-3)(8)-(1)(4))j+((-3)(-4)-(2)(4))k \\\\  & =(16-(-4))i-(-24-(4))j+(12-(8))k \\\\  & =20i+28j+4k \\\\  & =⟨20,28,4⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "240d3498-fa54-5157-88f1-3818e0422e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16i-\\frac{37}{10}j+\\frac{59}{5}k" :db/id #edb/ref 17592186540450} {:answer/id #uuid "27ea1601-7690-5806-b2f8-3fec36a8db4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8i+\\frac{107}{10}j-\\frac{11}{5}k" :db/id #edb/ref 17592186540453} {:answer/id #uuid "85523c49-77fc-5c77-be0e-f3d65c058fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{10}i+\\frac{59}{5}j+16k" :db/id #edb/ref 17592186540475} {:answer/id #uuid "c8659aa4-9b80-5734-ad39-99d9e9608d60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16i-\\frac{37}{10}j-\\frac{59}{5}k" :db/id #edb/ref 17592186540498} {:answer/id #uuid "da155be7-0d97-5290-b3c8-388435680f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16i+\\frac{37}{10}j+\\frac{59}{5}k" :db/id #edb/ref 17592186540502}] :answer-field/correct {:answer/id #uuid "da155be7-0d97-5290-b3c8-388435680f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16i+\\frac{37}{10}j+\\frac{59}{5}k" :db/id #edb/ref 17592186540502} :answer-field/id #uuid "c298c57a-7dab-5682-bf12-994f4328b57a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540493}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c879baa4-8bcb-559c-9780-708721266a3e" :question/problem "Let $u=-\\frac{6}{5}i+2j+k$ and $v=-\\frac{7}{2}i-4j+6k.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ -\\frac{6}{5} & 2 & 1 \\\\ -\\frac{7}{2} & -4 & 6\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ -4 & 6\\end{vmatrix}i-\\begin{vmatrix}-\\frac{6}{5} & 1 \\\\ -\\frac{7}{2} & 6\\end{vmatrix}j+\\begin{vmatrix}-\\frac{6}{5} & 2 \\\\ -\\frac{7}{2} & -4\\end{vmatrix}k \\\\  & =((2)(6)-(1)(-4))i-(\\left(-\\frac{6}{5}\\right)(6)-(1)\\left(-\\frac{7}{2}\\right))j+(\\left(-\\frac{6}{5}\\right)(-4)-(2)\\left(-\\frac{7}{2}\\right))k \\\\  & =(12-(-4))i-(-\\frac{36}{5}-\\left(-\\frac{7}{2}\\right))j+(\\frac{24}{5}-(-7))k \\\\  & =16i+\\frac{37}{10}j+\\frac{59}{5}k \\\\  & =⟨16,\\frac{37}{10},\\frac{59}{5}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186541058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72d5bd5e-7472-57dd-bbfd-f86c424a9071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(t^2-2)(t^2+25)}{5}" :db/id #edb/ref 17592186540725}] :answer-field/correct {:answer/id #uuid "72d5bd5e-7472-57dd-bbfd-f86c424a9071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(t^2-2)(t^2+25)}{5}" :db/id #edb/ref 17592186540725} :answer-field/id #uuid "796d2edf-72cd-5edb-a250-8f0040849fed" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540991}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08e75bed-6305-557a-ac6f-4a738a0fec12" :question/math-academy-id "q-133287" :question/problem "The eagle's path traces a curve $C$ in the $xy$-plane. Suppose that the eagle is at the point $P$ on $C$ at time $t.$ Expressed in terms of $t,$ what function gives the slope of the tangent to $C$ at $P?$\n\nThe slope of the tangent to $C$ at time $t$ equals$\\,$\n{{field-1}}." :question/worked-solution "The slope of the tangent to $C$ equals $\\frac{\\text{d}y}{\\text{d}x}.$ To calculate this, we use the formula\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nIn parts 1 and 2, we found\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\\,{y}^{′}(t)={t}^{2}-2.\n$$\n\nTherefore,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{t}^{2}-2}{\\left(\\frac{5}{25+{t}^{2}}\\right)}=\\frac{1}{5}({t}^{2}-2)({t}^{2}+25).\n$$"}] [{:db/id #edb/ref 17592186541063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88892d02-3412-5492-af0a-49ebe61d9b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186540755}] :answer-field/correct {:answer/id #uuid "88892d02-3412-5492-af0a-49ebe61d9b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186540755} :answer-field/id #uuid "70887428-4f7c-590f-a390-58a8f2bf8ee3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540987}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "143c70c1-44db-5544-97bc-c449974fa03d" :question/math-academy-id "q-133292" :question/problem "The eagle's total displacement in the $y$-direction over the first $6$ seconds is given by $$\n\\displaystyle {\\int }_{0}^{6}{y}^{′}(t)\\,\\text{d}t.\n$$ Calculate this displacement.\n\nThe eagle's total displacement in the $y$-direction over the first $6$ seconds is$\\,$\n{{field-1}}\n$\\,\\text{m}.$" :question/worked-solution "In part 7, we found that the antiderivative of ${y}^{′}(t)$ is\n\n$$\ny(t)=\\frac{1}{3}{t}^{3}-2t+C.\n$$\n\nBy the fundamental theorem of calculus, we take the antiderivative and evaluate the difference at the bounds:\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}{y}^{′}(t)\\,\\text{d}t & =y(t){|}_{0}^{6} \\\\  & ={(\\frac{1}{3}{t}^{3}-2t)|}_{0}^{6} \\\\  & =(\\frac{1}{3}(6)^{3}-2(6))-(\\frac{1}{3}(0)^{3}-2(0)) \\\\  & =60-0 \\\\  & =60.\\end{aligned}\n$$\n\nThe eagle's total displacement in the $y$-direction over the first $6$ seconds is $60\\,\\text{m}.$"}] [{:db/id #edb/ref 17592186541073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c2faca-0edb-5ef8-8326-5900825078b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{3/5}}{2}{x}^{11/5}+C" :db/id #edb/ref 17592186540697} {:answer/id #uuid "73e207b9-91a9-5b1a-8a15-f29313c6b433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{12/5}}{12}+C" :db/id #edb/ref 17592186540727} {:answer/id #uuid "da7a61db-d353-5a53-b318-1be353f60fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{31}^{2/5}}{32}{x}^{7/5}+C" :db/id #edb/ref 17592186540895} {:answer/id #uuid "ed9e9b62-8e00-5346-a13f-699ec44a7450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{7}^{2/5}}{2}{x}^{7/5}+C" :db/id #edb/ref 17592186540927} {:answer/id #uuid "fbfa7707-765d-5937-8a04-fb11b50efc05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{36}^{2/5}}{72}{x}^{12/5}+C" :db/id #edb/ref 17592186540936}] :answer-field/correct {:answer/id #uuid "73e207b9-91a9-5b1a-8a15-f29313c6b433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{12/5}}{12}+C" :db/id #edb/ref 17592186540727} :answer-field/id #uuid "05367c1f-7c48-5001-bd7f-8cd94f9a1ee7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540944}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "31f8bbd7-44e6-58a8-9f8d-def7c80fe8a8" :question/math-academy-id "q-29652" :question/problem "What is the antiderivative of $\\sqrt[5]{{x}^{7}}?$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{7}}={x}^{7/5}.$ So, we can apply the power rule with $n=\\frac{7}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{7}}\\,\\text{d}x & =\\int {x}^{7/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{7/5+1}}{(\\frac{7}{5}+1)}+C \\\\  & =\\frac{{x}^{12/5}}{\\left(\\frac{12}{5}\\right)}+C \\\\  & =\\frac{5{x}^{12/5}}{12}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{12/5}}{12}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{12}\\frac{\\text{d}}{\\text{d}x}({x}^{12/5})+0 \\\\ &= \\frac{5}{12}\\cdot \\frac{12}{5}{x}^{12/5-1} \\\\ &= {x}^{7/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186541078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b291071b-8c33-51cd-93d8-3d6f97e2bee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186540826}] :answer-field/correct {:answer/id #uuid "b291071b-8c33-51cd-93d8-3d6f97e2bee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186540826} :answer-field/id #uuid "d12141e2-6a38-52ff-846b-6b7417e1ae0f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186541032}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4086d61d-9c18-5ba7-b425-e5509f913d48" :question/math-academy-id "q-133288" :question/problem "The tangent line to the eagle's flight path is horizontal at $t=${{field-1}}$\\,\\text{s}.$" :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is horizontal if ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nIn parts 1 and 2, we found\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\\,{y}^{′}(t)={t}^{2}-2.\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n{t}^{2}-2=0\\,⟹\\,t=\\pm \\sqrt{2}.\n$$\n\nNote that $-\\sqrt{2}\\notin (0,\\infty ),$ so we only consider the value $t=\\sqrt{2}.$\n\nNow, we note that\n\n$$\n{x}^{′}(\\sqrt{2})=\\frac{5}{27}\\ne 0,\n$$\n\nwhich confirms that the curve's tangent is horizontal when $t=\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186541081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42f7866a-874a-59e8-98df-e82497daf28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540642} {:answer/id #uuid "44289665-fb34-50eb-942c-684dbafac462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186540644} {:answer/id #uuid "5d52696f-f66a-5483-9d31-ad3010ca9bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186540685} {:answer/id #uuid "675393a7-a22d-52c0-8122-89d84461848c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186540704} {:answer/id #uuid "7b1a18cf-57e7-594a-bab2-ece7b5646c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186540734}] :answer-field/correct {:answer/id #uuid "7b1a18cf-57e7-594a-bab2-ece7b5646c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186540734} :answer-field/id #uuid "dcc96fea-c51a-5b5e-9f54-45e9c86734fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186541040}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "512baac6-6af2-5983-be4f-040d5e0743f6" :question/math-academy-id "q-127327" :question/problem "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨y\\operatorname{cos}⁡y+y{x}^{3},\\,\\sqrt[3]{x}+y⟩\n$$\n\nthrough the boundary of the square with vertices $(-1,0),(1,0),(1,2),$ and $(-1,2).$" :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/fa/fa98f3db31860a463d0a551d5297895e61a6c041d852c04de04c44a194510961.png)\n\nWe have that $P(x,y)=y\\operatorname{cos}⁡y+y{x}^{3}$ and $Q(x,y)=\\sqrt[3]{x}+y.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{x}^{2}y,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):-1\\le x\\le 1,\\,0\\le y\\le 2\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{x}^{2}y+1)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}(3{x}^{2}y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}({x}^{3}y+x)\\,{|}_{-1}^{1}\\,dy \\\\  & ={\\int }_{0}^{2}[((1)^{3}y+1)-((-1)^{3}y+(-1))]\\,dy \\\\  & ={\\int }_{0}^{2}(2y+2)\\,dy \\\\  & =[{y}^{2}+2y]_{0}^{2} \\\\  & =((2)^{2}+2(2))-0 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186541115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b5785c-9c86-58fa-8702-7b20eaf94717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{9/5}}{5}+C" :db/id #edb/ref 17592186540600} {:answer/id #uuid "a6d02e90-1b24-51db-a87e-21fe5d5fa85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{7/5}}{7}+C" :db/id #edb/ref 17592186540804} {:answer/id #uuid "da8619fc-53ce-586e-8d07-73efa17d3b93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{7/5}}{7}+C" :db/id #edb/ref 17592186540896} {:answer/id #uuid "de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{9/5}}{9}+C" :db/id #edb/ref 17592186540906} {:answer/id #uuid "f746d0ee-4d45-5138-a444-dd8fb7c426b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{9/5}}{9}+C" :db/id #edb/ref 17592186540933}] :answer-field/correct {:answer/id #uuid "de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{9/5}}{9}+C" :db/id #edb/ref 17592186540906} :answer-field/id #uuid "fa476148-4520-535e-8de8-c555998b437f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186541051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e0b25f6-0e44-56a6-a167-f47173302a18" :question/math-academy-id "q-113672" :question/problem "Find the antiderivative of ${x}^{4/5}.$" :question/worked-solution "We can apply the power rule with $n=\\frac{4}{5}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{4/5}\\,\\text{d}x & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}+C \\\\  & =\\frac{{x}^{9/5}}{\\left(\\frac{9}{5}\\right)}+C \\\\  & =\\frac{5{x}^{9/5}}{9}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{9/5}}{9}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/5})+0 \\\\ &= \\frac{5}{9}\\cdot \\frac{9}{5}{x}^{9/5-1} \\\\ &= {x}^{4/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186541140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c33caad-bb2f-5503-bf90-b0887fffc7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4{x}^{4}}+C" :db/id #edb/ref 17592186540549} {:answer/id #uuid "395b2c98-0606-52cd-ad1e-4a590c5bc289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4{x}^{4}}+C" :db/id #edb/ref 17592186540620} {:answer/id #uuid "58bcf515-bc8d-5c7f-a87c-e1d6836d3944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4{x}^{5}}+C" :db/id #edb/ref 17592186540678} {:answer/id #uuid "720da65f-7b8d-5025-8be5-6124aff10c66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186540724} {:answer/id #uuid "9358fcee-68fe-5474-97b4-702d3a35e3e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{{x}^{4}}+C" :db/id #edb/ref 17592186540774}] :answer-field/correct {:answer/id #uuid "0c33caad-bb2f-5503-bf90-b0887fffc7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4{x}^{4}}+C" :db/id #edb/ref 17592186540549} :answer-field/id #uuid "df1e8bd8-c60e-5022-8cc3-6497fe7a88f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186541041}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "daa61eb1-b03b-51c0-8270-14c708ae1e5c" :question/math-academy-id "q-29643" :question/problem "$$\n\\displaystyle \\int \\frac{1}{{x}^{5}}\\,\\text{d}x=\n$$" :question/worked-solution "Note that $\\frac{1}{{x}^{5}}={x}^{-5}.$ So, we can use the power rule with $n=-5$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{5}}\\,\\text{d}x & =\\int {x}^{-5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5+1}}{-5+1}+C \\\\  & =\\frac{{x}^{-4}}{-4}+C \\\\  & =-\\frac{1}{4{x}^{4}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "496974f1-cd7b-5abe-b03b-8caf3c2ef7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186541574}] :answer-field/correct {:answer/id #uuid "496974f1-cd7b-5abe-b03b-8caf3c2ef7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186541574} :answer-field/id #uuid "6df6c47b-c813-591d-800c-7da989a956a4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "316d8b52-05f5-5660-9987-6f2357a674ed" :question/math-academy-id "q-342789" :question/problem "The slope of the tangent to the curve $y=\\sqrt{-{x}^{2}+2x}$ at the point where $x=1$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=-{x}^{2}+2x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2x+2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-2x+2) \\\\  & =\\frac{-2x+2}{2\\sqrt{-{x}^{2}+2x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=1,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={\\left(\\frac{-2x+2}{2\\sqrt{-{x}^{2}+2x}}\\right)|}_{x=1} \\\\  & =\\frac{-2(1)+2}{2\\sqrt{-{1}^{2}+2(1)}} \\\\  & =\\frac{0}{2\\sqrt{1}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "365d6570-d8cb-539f-a88f-8f59a136deaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{145}{2}" :db/id #edb/ref 17592186541535} {:answer/id #uuid "a8e65a94-bc73-5511-b4e0-737b7fd4a52d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186541771} {:answer/id #uuid "ba942dc9-148d-5089-895a-5986590e89c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{289}{2}" :db/id #edb/ref 17592186541806} {:answer/id #uuid "dfa31f6a-0231-55ef-b7c1-eda435cc6895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{73}{2}" :db/id #edb/ref 17592186541897} {:answer/id #uuid "fb45a9d2-d3cd-5774-a7e6-b9653552ab14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186541949}] :answer-field/correct {:answer/id #uuid "ba942dc9-148d-5089-895a-5986590e89c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{289}{2}" :db/id #edb/ref 17592186541806} :answer-field/id #uuid "02bb9c7f-0a51-5ad4-a60d-65bfb06add50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186541965}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed421aa6-2e1d-544f-a145-c01b981f6e83" :question/math-academy-id "q-20181" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{x-3}+3{x}^{3}$ at the point where $x=4.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nLet $f(x)=\\sqrt{x-3}.$ We use the chain rule in the form\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=x-3.$ Then $f=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 1 \\\\  & =\\frac{1}{2\\sqrt{u}} \\\\  & =\\frac{1}{2\\sqrt{x-3}}.\\end{aligned}\n$$\n\nApplying the sum rule, we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2\\sqrt{x-3}}+9{x}^{2}.\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & =\\frac{1}{2\\sqrt{4-3}}+9(4)^{2} \\\\  & =\\frac{1}{2}+144 \\\\  & =\\frac{289}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e084867-80ed-5e99-995e-d2f7c3a2775a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186542396} {:answer/id #uuid "b6ca9be8-5d2e-57ab-a777-f3c7100f1c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\cdot \\pi" :db/id #edb/ref 17592186542405} {:answer/id #uuid "c0223973-2b8f-51d9-95d0-c1ac09f3ee98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\cdot \\pi" :db/id #edb/ref 17592186542408} {:answer/id #uuid "cd2021fe-3967-595c-8aa9-57ea29061bf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot \\pi" :db/id #edb/ref 17592186542412} {:answer/id #uuid "e9530bbf-c5c3-5952-9005-276940846bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot \\pi" :db/id #edb/ref 17592186542423}] :answer-field/correct {:answer/id #uuid "e9530bbf-c5c3-5952-9005-276940846bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot \\pi" :db/id #edb/ref 17592186542423} :answer-field/id #uuid "dc2c7090-300d-5bba-8d56-8e59b2ef1c31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542420}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "267fd235-ecde-531c-b2aa-2c537397b3c6" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R \\sqrt{(x)^{2}+(y)^{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=1$ and between the surfaces $z=0$ and $z=3.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/c7/c7fe69ab2583c066df73bbf6719e4c58fea1ed565e345bc62c11b7ebc779508b.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=3=3.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le 1,\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le 3\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R \\sqrt{(x)^{2}+(y)^{2}}\\,dV &=\\iiint_\\Delta (\\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}\\int_{0}^{3}(r)^{2}\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}(r)^{2}[z]_{z=0}^{z=3}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}(r)^{2}((3)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}3\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[(r)^{3}]_{r=0}^{r=1}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(((1))^{3})-(((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(1)-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}1\\,d\\theta \\\\ &=[\\theta]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(2\\cdot \\pi)-(0) \\\\ &=2\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ebd6dd6-7259-5120-97a3-66b51aeb5bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\cdot \\pi" :db/id #edb/ref 17592186542397} {:answer/id #uuid "ac6c862a-55e0-54f9-b7f6-7a2dc48c416c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+3\\cdot \\pi" :db/id #edb/ref 17592186542401} {:answer/id #uuid "b062a522-6a46-5f79-9299-18183553eb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\cdot \\pi" :db/id #edb/ref 17592186542403} {:answer/id #uuid "f9945e02-9035-5167-8318-4361e517c387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}\\cdot \\pi" :db/id #edb/ref 17592186542428} {:answer/id #uuid "fc158f8d-2987-5499-a8ed-77f033124c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\cdot \\pi" :db/id #edb/ref 17592186542429}] :answer-field/correct {:answer/id #uuid "fc158f8d-2987-5499-a8ed-77f033124c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\cdot \\pi" :db/id #edb/ref 17592186542429} :answer-field/id #uuid "14d2c317-5999-5ae3-83ba-55833a642212" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542371}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d825389-7a3e-5461-af4a-30fb0473dbe9" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R \\sqrt{(x)^{2}+(y)^{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=1$ and between the surfaces $z=0$ and $z=9-2\\cdot y.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/c7/c7fe69ab2583c066df73bbf6719e4c58fea1ed565e345bc62c11b7ebc779508b.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=9-2\\cdot y=-2\\cdot r\\cdot \\sin(\\theta)+9.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le 1,\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le -2\\cdot r\\cdot \\sin(\\theta)+9\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R \\sqrt{(x)^{2}+(y)^{2}}\\,dV &=\\iiint_\\Delta (\\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}\\int_{0}^{-2\\cdot r\\cdot \\sin(\\theta)+9}(r)^{2}\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}(r)^{2}[z]_{z=0}^{z=-2\\cdot r\\cdot \\sin(\\theta)+9}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}(r)^{2}((-2\\cdot r\\cdot \\sin(\\theta)+9)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}-2\\cdot (r)^{3}\\cdot \\sin(\\theta)+9\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[-\\frac{1}{2}\\cdot (r)^{4}\\cdot \\sin(\\theta)+3\\cdot (r)^{3}]_{r=0}^{r=1}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(-\\frac{1}{2}\\cdot ((1))^{4}\\cdot \\sin(\\theta))-(-\\frac{1}{2}\\cdot ((0))^{4}\\cdot \\sin(\\theta))+(3\\cdot ((1))^{3})-(3\\cdot ((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(-\\frac{1}{2}\\cdot \\sin(\\theta))-(0)+(3)-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}3-\\frac{1}{2}\\cdot \\sin(\\theta)\\,d\\theta \\\\ &=[3\\cdot \\theta+\\frac{1}{2}\\cdot \\cos(\\theta)]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(6\\cdot \\pi)-(0)+\\left(\\frac{1}{2}\\right)-\\left(\\frac{1}{2}\\right) \\\\ &=6\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8d660b-d1ed-54c6-80fc-e62752d00c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128\\cdot \\pi" :db/id #edb/ref 17592186542370} {:answer/id #uuid "58a3a2b3-377a-5a2e-be8b-8d442f4d4cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256\\cdot \\pi" :db/id #edb/ref 17592186542383} {:answer/id #uuid "d370d519-dcf6-5dfa-93ca-e9d88e4f6b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\cdot \\pi" :db/id #edb/ref 17592186542414} {:answer/id #uuid "da860c21-af1f-52ef-9641-88927be2a946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "384\\cdot \\pi" :db/id #edb/ref 17592186542418} {:answer/id #uuid "ee4a4819-eeb8-5c8e-b89d-52d5af9200a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\cdot \\pi" :db/id #edb/ref 17592186542425}] :answer-field/correct {:answer/id #uuid "0f8d660b-d1ed-54c6-80fc-e62752d00c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128\\cdot \\pi" :db/id #edb/ref 17592186542370} :answer-field/id #uuid "57e8e949-e40f-5a5f-a5fb-3d827a224266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542382}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5434eee3-49f9-5e43-a178-4a79f52b75aa" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R \\sqrt{(x)^{2}+(y)^{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=16$ and between the surfaces $z=0$ and $z=3.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/ce/ce06d6892ad079a03c395b9ddac5db712d0b0e1797ec63c3c27f005c2287adb5.png)\n\nThe region $R$ is a right vertical cylinder of radius $4$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=3=3.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le 4,\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le 3\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R \\sqrt{(x)^{2}+(y)^{2}}\\,dV &=\\iiint_\\Delta (\\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{4}\\int_{0}^{3}(r)^{2}\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{4}(r)^{2}[z]_{z=0}^{z=3}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{4}(r)^{2}((3)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{4}3\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[(r)^{3}]_{r=0}^{r=4}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(((4))^{3})-(((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(64)-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}64\\,d\\theta \\\\ &=[64\\cdot \\theta]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(128\\cdot \\pi)-(0) \\\\ &=128\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6333ef2c-1cae-519e-a685-58c87c26695f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72\\cdot \\pi" :db/id #edb/ref 17592186542384} {:answer/id #uuid "a3f4a2a2-bf74-5d31-bfe7-5cd3ea7de0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\cdot \\pi" :db/id #edb/ref 17592186542398} {:answer/id #uuid "c570990c-5907-5cdf-82b5-65a7360aed17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\cdot \\pi" :db/id #edb/ref 17592186542410} {:answer/id #uuid "da65e013-dd31-5b49-8080-62718daaad6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}\\cdot \\pi" :db/id #edb/ref 17592186542417} {:answer/id #uuid "f574aa17-b6bd-5157-b731-6ae70b45cf9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81\\cdot \\pi" :db/id #edb/ref 17592186542427}] :answer-field/correct {:answer/id #uuid "a3f4a2a2-bf74-5d31-bfe7-5cd3ea7de0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\cdot \\pi" :db/id #edb/ref 17592186542398} :answer-field/id #uuid "99cc235e-b8c3-5f58-9f50-751a34cdf8ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542394}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73587b1a-dcf1-5c8f-a281-fdffe625841b" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R 2\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=9$ and between the surfaces $z=0$ and $z=1.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/8e/8ee9b491452a26902c4800a006c16f1bbca31f0e800ec9aad20dfeef68eed8f4.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=1=1.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le 3,\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R 2\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,dV &=\\iiint_\\Delta (2\\cdot \\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}\\int_{0}^{1}2\\cdot (r)^{2}\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}2\\cdot (r)^{2}[z]_{z=0}^{z=1}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}2\\cdot (r)^{2}((1)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}2\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[\\frac{2}{3}\\cdot (r)^{3}]_{r=0}^{r=3}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(\\frac{2}{3}\\cdot ((3))^{3})-(\\frac{2}{3}\\cdot ((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(18)-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}18\\,d\\theta \\\\ &=[18\\cdot \\theta]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(36\\cdot \\pi)-(0) \\\\ &=36\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "237c1dc0-9a08-5feb-9f93-69378beb0d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "252\\cdot \\pi" :db/id #edb/ref 17592186542373} {:answer/id #uuid "646cbcae-95be-5a16-90c4-402ea2065742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84\\cdot \\pi" :db/id #edb/ref 17592186542385} {:answer/id #uuid "66af9ffc-ae30-5a4e-8b1b-228331e6b034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42\\cdot \\pi" :db/id #edb/ref 17592186542386} {:answer/id #uuid "bab2ee4a-610e-5302-bcd4-2e5229f07fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "168\\cdot \\pi" :db/id #edb/ref 17592186542407} {:answer/id #uuid "d68b09e5-524b-56e8-8b3e-d922ab80c8e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66\\cdot \\pi" :db/id #edb/ref 17592186542416}] :answer-field/correct {:answer/id #uuid "646cbcae-95be-5a16-90c4-402ea2065742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84\\cdot \\pi" :db/id #edb/ref 17592186542385} :answer-field/id #uuid "424213bf-d747-5c2b-8b1c-17e303286030" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542379}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "74a2b9bd-8d96-5a52-868d-e97a9b8e01c9" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R 2\\cdot z\\cdot ((x)^{2}+(y)^{2})^{-\\frac{1}{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=9$ and between the surfaces $z=0$ and $z=\\sqrt{-(x)^{2}+(y)^{2}+14}.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/8e/8ee9b491452a26902c4800a006c16f1bbca31f0e800ec9aad20dfeef68eed8f4.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=\\sqrt{-(x)^{2}+(y)^{2}+14}=\\sqrt{-(r)^{2}\\cdot \\cos(2\\cdot \\theta)+14}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le 3,\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le \\sqrt{-(r)^{2}\\cdot \\cos(2\\cdot \\theta)+14}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R 2\\cdot z\\cdot ((x)^{2}+(y)^{2})^{-\\frac{1}{2}}\\,dV &=\\iiint_\\Delta (2\\cdot \\frac{z}{\\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2}})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}\\int_{0}^{\\sqrt{-(r)^{2}\\cdot \\cos(2\\cdot \\theta)+14}}2\\cdot z\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}[(z)^{2}]_{z=0}^{z=\\sqrt{-(r)^{2}\\cdot \\cos(2\\cdot \\theta)+14}}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}(((\\sqrt{-(r)^{2}\\cdot \\cos(2\\cdot \\theta)+14}))^{2})-(((0))^{2})\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{3}-(r)^{2}\\cdot \\cos(2\\cdot \\theta)+14\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[-\\frac{1}{3}\\cdot (r)^{3}\\cdot \\cos(2\\cdot \\theta)+14\\cdot r]_{r=0}^{r=3}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(-\\frac{1}{3}\\cdot ((3))^{3}\\cdot \\cos(2\\cdot \\theta))-(-\\frac{1}{3}\\cdot ((0))^{3}\\cdot \\cos(2\\cdot \\theta))+(14\\cdot (3))-(14\\cdot (0))\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(-9\\cdot \\cos(2\\cdot \\theta))-(0)+(42)-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}42-9\\cdot \\cos(2\\cdot \\theta)\\,d\\theta \\\\ &=[42\\cdot \\theta-9\\cdot \\cos(\\theta)\\cdot \\sin(\\theta)]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(84\\cdot \\pi)-(0)+(0)-(0) \\\\ &=84\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ef0905a-bdbf-5fea-9e69-8095deb48425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{160}{3}\\cdot \\pi\\cdot \\sqrt{2}" :db/id #edb/ref 17592186542380} {:answer/id #uuid "91eb5f07-47ff-5d2d-ace1-01e291591fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{3}\\cdot \\pi\\cdot \\sqrt{2}" :db/id #edb/ref 17592186542393} {:answer/id #uuid "a951bc16-7847-5502-a4f0-fe6ba9cfffa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\cdot \\pi\\cdot \\sqrt{2}" :db/id #edb/ref 17592186542400} {:answer/id #uuid "db4ccc14-ea2a-521d-b14a-fa38d1435ac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16+\\frac{40}{3}\\cdot \\pi\\cdot \\sqrt{2}" :db/id #edb/ref 17592186542419} {:answer/id #uuid "e84ef09f-1452-5309-a150-c450366b48f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\cdot \\pi" :db/id #edb/ref 17592186542422}] :answer-field/correct {:answer/id #uuid "91eb5f07-47ff-5d2d-ace1-01e291591fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{3}\\cdot \\pi\\cdot \\sqrt{2}" :db/id #edb/ref 17592186542393} :answer-field/id #uuid "de2b82c7-fc0a-58d0-a814-18a367a7b7ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542421}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89c3ded2-ece5-51bf-a7d4-4718cdf0a70d" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R 4\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=2$ and between the surfaces $z=0$ and $z=5-2\\cdot y.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/c0/c015a0e708a8f931bc5d8857b69a734490518d79afb1f493183940f6d888ad1d.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{2}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=5-2\\cdot y=-2\\cdot r\\cdot \\sin(\\theta)+5.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le \\sqrt{2},\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le -2\\cdot r\\cdot \\sin(\\theta)+5\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R 4\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,dV &=\\iiint_\\Delta (4\\cdot \\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{\\sqrt{2}}\\int_{0}^{-2\\cdot r\\cdot \\sin(\\theta)+5}4\\cdot (r)^{2}\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{\\sqrt{2}}4\\cdot (r)^{2}[z]_{z=0}^{z=-2\\cdot r\\cdot \\sin(\\theta)+5}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{\\sqrt{2}}4\\cdot (r)^{2}((-2\\cdot r\\cdot \\sin(\\theta)+5)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{\\sqrt{2}}-8\\cdot (r)^{3}\\cdot \\sin(\\theta)+20\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[-2\\cdot (r)^{4}\\cdot \\sin(\\theta)+\\frac{20}{3}\\cdot (r)^{3}]_{r=0}^{r=\\sqrt{2}}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(-2\\cdot ((\\sqrt{2}))^{4}\\cdot \\sin(\\theta))-(-2\\cdot ((0))^{4}\\cdot \\sin(\\theta))+(\\frac{20}{3}\\cdot ((\\sqrt{2}))^{3})-(\\frac{20}{3}\\cdot ((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(-8\\cdot \\sin(\\theta))-(0)+(\\frac{40}{3}\\cdot \\sqrt{2})-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}-8\\cdot \\sin(\\theta)+\\frac{40}{3}\\cdot \\sqrt{2}\\,d\\theta \\\\ &=[\\frac{40}{3}\\cdot \\theta\\cdot \\sqrt{2}+8\\cdot \\cos(\\theta)]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(\\frac{80}{3}\\cdot \\pi\\cdot \\sqrt{2})-(0)+(8)-(8) \\\\ &=\\frac{80}{3}\\cdot \\pi\\cdot \\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a15b85a-ad02-5709-a268-9be5c6653c07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180\\cdot \\pi" :db/id #edb/ref 17592186542369} {:answer/id #uuid "7b14ef7e-3f31-57b2-8f96-effeb4b7088d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72\\cdot \\pi\\cdot \\sqrt{6}" :db/id #edb/ref 17592186542390} {:answer/id #uuid "99fc5045-61f5-50fa-a0e2-8f0003e56fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45\\cdot \\pi+200\\cdot \\sqrt{6}" :db/id #edb/ref 17592186542395} {:answer/id #uuid "ec96c562-7607-507f-9b9b-19e63a261a9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{8}\\cdot \\pi" :db/id #edb/ref 17592186542424} {:answer/id #uuid "f3b901ef-66b6-5561-805a-3f02727212c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90\\cdot \\pi" :db/id #edb/ref 17592186542426}] :answer-field/correct {:answer/id #uuid "f3b901ef-66b6-5561-805a-3f02727212c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90\\cdot \\pi" :db/id #edb/ref 17592186542426} :answer-field/id #uuid "1b4a19c6-9237-53cb-b88d-eea0421ee991" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542372}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b6019cfe-9d9c-5e37-b6df-d53d3e14ef50" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R 2\\cdot x\\cdot z\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=6$ for $y\\ge 0$ and between the surfaces $z=-x$ and $z=x+10.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/04/0472caa4e40aac437429c5f542f8c7c155d69ff1a348e1d8a4c37b4ced9b472e.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{6}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-x=-r\\cdot \\cos(\\theta),$ and\n\n- bounded above by $z=x+10=r\\cdot \\cos(\\theta)+10.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le \\sqrt{6},\\ 0\\le\\theta<\\pi,\\ -r\\cdot \\cos(\\theta)\\le z\\le r\\cdot \\cos(\\theta)+10\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R 2\\cdot x\\cdot z\\,dV &=\\iiint_\\Delta (2\\cdot z\\cdot r\\cdot \\cos(\\theta))\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\pi}\\int_0^{\\sqrt{6}}\\int_{-r\\cdot \\cos(\\theta)}^{r\\cdot \\cos(\\theta)+10}2\\cdot z\\cdot (r)^{2}\\cdot \\cos(\\theta)\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\pi}\\int_0^{\\sqrt{6}}(r)^{2}\\cdot \\cos(\\theta)[(z)^2]_{z=-r\\cdot \\cos(\\theta)}^{z=r\\cdot \\cos(\\theta)+10}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\pi}\\int_0^{\\sqrt{6}}(r)^{2}\\cdot \\cos(\\theta)((r\\cdot \\cos(\\theta)+10)^2-(-r\\cdot \\cos(\\theta))^2)\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\pi}\\int_0^{\\sqrt{6}}(r)^{2}\\cdot \\cos(\\theta)((r)^{2}\\cdot (\\cos(\\theta))^{2}+20\\cdot r\\cdot \\cos(\\theta)+100-((r)^{2}\\cdot (\\cos(\\theta))^{2}))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\pi}\\int_0^{\\sqrt{6}}20\\cdot (r)^{3}\\cdot (\\cos(\\theta))^{2}+100\\cdot (r)^{2}\\cdot \\cos(\\theta)\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\pi}[5\\cdot (r)^{4}\\cdot (\\cos(\\theta))^{2}+\\frac{100}{3}\\cdot (r)^{3}\\cdot \\cos(\\theta)]_{r=0}^{r=\\sqrt{6}}\\,d\\theta \\\\ &=\\int_{0}^{\\pi}(5\\cdot ((\\sqrt{6}))^{4}\\cdot (\\cos(\\theta))^{2})-(5\\cdot ((0))^{4}\\cdot (\\cos(\\theta))^{2})+(\\frac{100}{3}\\cdot ((\\sqrt{6}))^{3}\\cdot \\cos(\\theta))-(\\frac{100}{3}\\cdot ((0))^{3}\\cdot \\cos(\\theta))\\,d\\theta \\\\ &=\\int_{0}^{\\pi}(180\\cdot (\\cos(\\theta))^{2})-(0)+(200\\cdot \\sqrt{6}\\cdot \\cos(\\theta))-(0)\\,d\\theta \\\\ &=\\int_{0}^{\\pi}180\\cdot (\\cos(\\theta))^{2}+200\\cdot \\sqrt{6}\\cdot \\cos(\\theta)\\,d\\theta \\\\ &=\\int_{0}^{\\pi}180(\\frac{1}{2}(1+\\cos(2\\cdot \\theta)))+200\\cdot \\sqrt{6}\\cdot \\cos(\\theta)\\,d\\theta \\\\ &=\\int_{0}^{\\pi}200\\cdot \\sqrt{6}\\cdot \\cos(\\theta)+90\\cdot \\cos(2\\cdot \\theta)+90\\,d\\theta \\\\ &=[90\\cdot \\theta+200\\cdot \\sqrt{6}\\cdot \\sin(\\theta)+45\\cdot \\sin(2\\cdot \\theta)]_{\\theta=0}^{\\theta=\\pi} \\\\ &=(90\\cdot \\pi)-(0)+(0)-(0)+(0)-(0) \\\\ &=90\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08dadd38-fb68-5779-a188-b784be4a6b2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}\\cdot \\pi" :db/id #edb/ref 17592186542368} {:answer/id #uuid "6cbee069-7a87-51d0-9392-cbeec9ec586e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\cdot \\pi" :db/id #edb/ref 17592186542387} {:answer/id #uuid "7d83eaae-f8b5-538e-af6a-fa57c9f45461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}\\cdot \\pi" :db/id #edb/ref 17592186542391} {:answer/id #uuid "a91f9201-835b-5ae6-be79-7518add5a8bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\cdot \\pi" :db/id #edb/ref 17592186542399} {:answer/id #uuid "c9be48c8-ddc2-53db-874a-8450e1fe1768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{3}\\cdot \\pi" :db/id #edb/ref 17592186542411}] :answer-field/correct {:answer/id #uuid "c9be48c8-ddc2-53db-874a-8450e1fe1768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{3}\\cdot \\pi" :db/id #edb/ref 17592186542411} :answer-field/id #uuid "d30d0b97-29d6-5b4a-be3d-426bd7d15400" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0e834b8-fc6b-56b5-8146-fbd537f8a411" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R 4\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=1$ and between the surfaces $z=0$ and $z=4.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/c7/c7fe69ab2583c066df73bbf6719e4c58fea1ed565e345bc62c11b7ebc779508b.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=4=4.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le 1,\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le 4\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R 4\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,dV &=\\iiint_\\Delta (4\\cdot \\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}\\int_{0}^{4}4\\cdot (r)^{2}\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}4\\cdot (r)^{2}[z]_{z=0}^{z=4}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}4\\cdot (r)^{2}((4)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{1}16\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[\\frac{16}{3}\\cdot (r)^{3}]_{r=0}^{r=1}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(\\frac{16}{3}\\cdot ((1))^{3})-(\\frac{16}{3}\\cdot ((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\left(\\frac{16}{3}\\right)-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\frac{16}{3}\\,d\\theta \\\\ &=[\\frac{16}{3}\\cdot \\theta]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(\\frac{32}{3}\\cdot \\pi)-(0) \\\\ &=\\frac{32}{3}\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ddfd73-e817-5e19-bf8d-dd13eb09dba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{128}{3}\\cdot \\pi" :db/id #edb/ref 17592186542374} {:answer/id #uuid "2b6f9f77-1552-57ae-884a-192b803d96da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}\\cdot \\pi" :db/id #edb/ref 17592186542376} {:answer/id #uuid "3112b487-c350-57db-82e9-a721ed41fe97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\cdot \\pi" :db/id #edb/ref 17592186542377} {:answer/id #uuid "ae54fd97-3a30-519e-9ebd-e1fb979dbe8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{3}\\cdot \\pi" :db/id #edb/ref 17592186542402} {:answer/id #uuid "d4d4f8e7-781a-5b4c-827e-0040738832b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\cdot \\pi" :db/id #edb/ref 17592186542415}] :answer-field/correct {:answer/id #uuid "2b6f9f77-1552-57ae-884a-192b803d96da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}\\cdot \\pi" :db/id #edb/ref 17592186542376} :answer-field/id #uuid "b96cd23f-37b9-504c-a679-a848317b445b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542406}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ff5722e3-b420-50b2-8b72-a65be31820d3" :question/problem "Evaluate the triple integral\n\n$$\n\\iiint_R 4\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,\\mathrm{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder $x^2+y^2=4$ and between the surfaces $z=0$ and $z=1.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint_R f(x,y,z)\\,dV=\\iiint_\\Delta f(r\\cos\\theta,r\\sin\\theta,z)\\,r\\,dz\\,dr\\,d\\theta.\n$$\n\nIf $(r,\\theta,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\cos\\theta,\\quad y=r\\sin\\theta,\\quad z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/05/0505715b5e78700e63d98fc2c1db8e7d4a3074b3e06f4202de1ce5a6831f7571.png)\n\nThe region $R$ is a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0=0,$ and\n\n- bounded above by $z=1=1.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le 2,\\ 0\\le\\theta<2\\cdot \\pi,\\ 0\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R 4\\cdot \\sqrt{(x)^{2}+(y)^{2}}\\,dV &=\\iiint_\\Delta (4\\cdot \\sqrt{(r\\cdot \\cos(\\theta))^2+(r\\cdot \\sin(\\theta))^2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{2}\\int_{0}^{1}4\\cdot (r)^{2}\\,dz\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{2}4\\cdot (r)^{2}[z]_{z=0}^{z=1}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{2}4\\cdot (r)^{2}((1)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{2}4\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[\\frac{4}{3}\\cdot (r)^{3}]_{r=0}^{r=2}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(\\frac{4}{3}\\cdot ((2))^{3})-(\\frac{4}{3}\\cdot ((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\left(\\frac{32}{3}\\right)-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\frac{32}{3}\\,d\\theta \\\\ &=[\\frac{32}{3}\\cdot \\theta]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(\\frac{64}{3}\\cdot \\pi)-(0) \\\\ &=\\frac{64}{3}\\cdot \\pi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8160d239-5719-5314-9b34-25360242df8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{5}" :db/id #edb/ref 17592186542577} {:answer/id #uuid "9618b0be-10e0-54af-bddc-144790bcb25d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{2}" :db/id #edb/ref 17592186542583} {:answer/id #uuid "b72aa66a-4ae8-5eb8-a19d-10e8556f0769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186542588} {:answer/id #uuid "c98eda7f-7904-59d5-aed5-f095f55995d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{9 \\sqrt{5}}{2}" :db/id #edb/ref 17592186542592} {:answer/id #uuid "f3f6bd32-8ed5-5aec-826d-0d30d73baf91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 \\sqrt{5}}{2}" :db/id #edb/ref 17592186542594}] :answer-field/correct {:answer/id #uuid "f3f6bd32-8ed5-5aec-826d-0d30d73baf91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 \\sqrt{5}}{2}" :db/id #edb/ref 17592186542594} :answer-field/id #uuid "17a59230-cdc0-59cf-8d49-a7d059d179cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542597}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2564c8e6-dd58-5512-bb79-d13a805cc112" :question/problem "Evaluate the integral of the function $f(x,y)=x$ along the line $y=2 x,$ $\\,0\\le x\\le 3.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=2 t.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf r(t)=\\langle t,2 t\\rangle,\\qquad 0\\le t\\le 3\n$$\n\nComputing $\\mathbf r^{\\prime}(t)$ and $\\|\\mathbf r^{\\prime}(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}\\mathbf r^{\\prime}(t)&=\\frac{\\mathrm dx}{\\mathrm dt}\\mathbf i+\\frac{\\mathrm dy}{\\mathrm dt}\\mathbf j \\\\ &=\\frac{\\mathrm d}{\\mathrm dt}(t)\\mathbf i+\\frac{\\mathrm d}{\\mathrm dt}(2 t)\\mathbf j \\\\ &=\\mathbf i+(2)\\mathbf j \\\\ \\|\\mathbf r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm dx}{\\mathrm dt}\\right)^2+\\left(\\frac{\\mathrm dy}{\\mathrm dt}\\right)^2} \\\\ &=\\sqrt{1^2+(2)^2} \\\\ &=\\sqrt{5}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm ds&=\\int_{0}^{3}f(r(t))\\|\\mathbf r^{\\prime}(t)\\|\\,\\mathrm dt \\\\ &=\\int_{0}^{3}(t)(\\sqrt{5})\\,\\mathrm dt \\\\ &=\\left[\\frac{\\sqrt{5} t^{2}}{2}\\right]_{0}^{3} \\\\ &=\\frac{\\sqrt{5}}{2}\\left((3)^{2}-(0)^{2}\\right) \\\\ &=\\frac{\\sqrt{5}}{2}\\left(9-0\\right) \\\\ &=\\frac{9 \\sqrt{5}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020d5907-9b7b-5719-a1f1-4f44c5409284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{5}}{3}" :db/id #edb/ref 17592186542557} {:answer/id #uuid "33be0b46-f243-554c-9d9e-964dc5eb30b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\sqrt{5}" :db/id #edb/ref 17592186542564} {:answer/id #uuid "6c57458e-2426-55cb-b5d8-65aeae4d3130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{3}" :db/id #edb/ref 17592186542574} {:answer/id #uuid "c56967e6-dc2a-5dcc-9976-37549a83e6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186542591} {:answer/id #uuid "f8e63c2b-a619-54eb-9772-8aa7f8b9dbf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{16 \\sqrt{5}}{3}" :db/id #edb/ref 17592186542595}] :answer-field/correct {:answer/id #uuid "020d5907-9b7b-5719-a1f1-4f44c5409284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{5}}{3}" :db/id #edb/ref 17592186542557} :answer-field/id #uuid "d538b1dd-c792-572f-8c1f-8353d9802950" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2bf9d63c-b3f4-5d38-83c5-c18e8598dd9c" :question/problem "Evaluate the integral of the function $f(x,y)=x \\left(y - 1\\right)$ along the line $y=2 x + 1,$ $\\,0\\le x\\le 2.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=2 t + 1.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf r(t)=\\langle t,2 t + 1\\rangle,\\qquad 0\\le t\\le 2\n$$\n\nComputing $\\mathbf r^{\\prime}(t)$ and $\\|\\mathbf r^{\\prime}(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}\\mathbf r^{\\prime}(t)&=\\frac{\\mathrm dx}{\\mathrm dt}\\mathbf i+\\frac{\\mathrm dy}{\\mathrm dt}\\mathbf j \\\\ &=\\frac{\\mathrm d}{\\mathrm dt}(t)\\mathbf i+\\frac{\\mathrm d}{\\mathrm dt}(2 t + 1)\\mathbf j \\\\ &=\\mathbf i+(2)\\mathbf j \\\\ \\|\\mathbf r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm dx}{\\mathrm dt}\\right)^2+\\left(\\frac{\\mathrm dy}{\\mathrm dt}\\right)^2} \\\\ &=\\sqrt{1^2+(2)^2} \\\\ &=\\sqrt{5}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x \\left(y - 1\\right)$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2 t^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm ds&=\\int_{0}^{2}f(r(t))\\|\\mathbf r^{\\prime}(t)\\|\\,\\mathrm dt \\\\ &=\\int_{0}^{2}(2 t^{2})(\\sqrt{5})\\,\\mathrm dt \\\\ &=\\left[\\frac{2 \\sqrt{5} t^{3}}{3}\\right]_{0}^{2} \\\\ &=\\frac{2 \\sqrt{5}}{3}\\left((2)^{3}-(0)^{3}\\right) \\\\ &=\\frac{2 \\sqrt{5}}{3}\\left(8-0\\right) \\\\ &=\\frac{16 \\sqrt{5}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07329d51-3f5e-5e2e-8441-b2141aff317e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35 \\sqrt{37}" :db/id #edb/ref 17592186542558} {:answer/id #uuid "224fc2fd-156e-5950-be40-d81695a7789b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{245}{2}" :db/id #edb/ref 17592186542562} {:answer/id #uuid "38a9bc69-d00d-5b76-b39d-357b71605439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{245 \\sqrt{37}}{2}" :db/id #edb/ref 17592186542565} {:answer/id #uuid "7105e2b6-33c5-596d-aaf1-e33906b7e9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{245 \\sqrt{37}}{2}" :db/id #edb/ref 17592186542575} {:answer/id #uuid "f9544065-9a17-5e0c-a38b-236361697c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9065}{2}" :db/id #edb/ref 17592186542596}] :answer-field/correct {:answer/id #uuid "38a9bc69-d00d-5b76-b39d-357b71605439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{245 \\sqrt{37}}{2}" :db/id #edb/ref 17592186542565} :answer-field/id #uuid "1f81595a-0aec-5788-9a31-df107d898cd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542598}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2eade040-7c90-5638-966c-718b41cfb998" :question/problem "Evaluate the integral of the function $f(x,y)=5 x$ along the line $y=6 x,$ $\\,0\\le x\\le 7.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=6 t.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf r(t)=\\langle t,6 t\\rangle,\\qquad 0\\le t\\le 7\n$$\n\nComputing $\\mathbf r^{\\prime}(t)$ and $\\|\\mathbf r^{\\prime}(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}\\mathbf r^{\\prime}(t)&=\\frac{\\mathrm dx}{\\mathrm dt}\\mathbf i+\\frac{\\mathrm dy}{\\mathrm dt}\\mathbf j \\\\ &=\\frac{\\mathrm d}{\\mathrm dt}(t)\\mathbf i+\\frac{\\mathrm d}{\\mathrm dt}(6 t)\\mathbf j \\\\ &=\\mathbf i+(6)\\mathbf j \\\\ \\|\\mathbf r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm dx}{\\mathrm dt}\\right)^2+\\left(\\frac{\\mathrm dy}{\\mathrm dt}\\right)^2} \\\\ &=\\sqrt{1^2+(6)^2} \\\\ &=\\sqrt{37}\\end{aligned}\n$$\n\nNow, since $f(x,y)=5 x$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=5 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm ds&=\\int_{0}^{7}f(r(t))\\|\\mathbf r^{\\prime}(t)\\|\\,\\mathrm dt \\\\ &=\\int_{0}^{7}(5 t)(\\sqrt{37})\\,\\mathrm dt \\\\ &=\\left[\\frac{5 \\sqrt{37} t^{2}}{2}\\right]_{0}^{7} \\\\ &=\\frac{5 \\sqrt{37}}{2}\\left((7)^{2}-(0)^{2}\\right) \\\\ &=\\frac{5 \\sqrt{37}}{2}\\left(49-0\\right) \\\\ &=\\frac{245 \\sqrt{37}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e40f44d-615f-5865-a602-f53e98d24e9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15 \\sqrt{17}" :db/id #edb/ref 17592186542561} {:answer/id #uuid "65d7c7ed-cf67-5d74-9d2d-7d230e621f18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1275}{2}" :db/id #edb/ref 17592186542572} {:answer/id #uuid "a0e57f6d-ff24-5498-8177-a14094d5bd2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{75 \\sqrt{17}}{2}" :db/id #edb/ref 17592186542586} {:answer/id #uuid "bbc6fca7-a70d-5ad4-b81d-03df2ea33f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{75}{2}" :db/id #edb/ref 17592186542589} {:answer/id #uuid "cc301a85-6415-5f5a-a1ec-c9814b9c754e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{75 \\sqrt{17}}{2}" :db/id #edb/ref 17592186542593}] :answer-field/correct {:answer/id #uuid "a0e57f6d-ff24-5498-8177-a14094d5bd2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{75 \\sqrt{17}}{2}" :db/id #edb/ref 17592186542586} :answer-field/id #uuid "4b9afa8e-4db7-5a3a-a384-3177ceb89729" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542600}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ab95a8c-ac51-5396-919b-6a451ca13ac6" :question/problem "Evaluate the integral of the function $f(x,y)=3 x$ along the line $y=4 x,$ $\\,0\\le x\\le 5.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=4 t.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf r(t)=\\langle t,4 t\\rangle,\\qquad 0\\le t\\le 5\n$$\n\nComputing $\\mathbf r^{\\prime}(t)$ and $\\|\\mathbf r^{\\prime}(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}\\mathbf r^{\\prime}(t)&=\\frac{\\mathrm dx}{\\mathrm dt}\\mathbf i+\\frac{\\mathrm dy}{\\mathrm dt}\\mathbf j \\\\ &=\\frac{\\mathrm d}{\\mathrm dt}(t)\\mathbf i+\\frac{\\mathrm d}{\\mathrm dt}(4 t)\\mathbf j \\\\ &=\\mathbf i+(4)\\mathbf j \\\\ \\|\\mathbf r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm dx}{\\mathrm dt}\\right)^2+\\left(\\frac{\\mathrm dy}{\\mathrm dt}\\right)^2} \\\\ &=\\sqrt{1^2+(4)^2} \\\\ &=\\sqrt{17}\\end{aligned}\n$$\n\nNow, since $f(x,y)=3 x$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=3 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm ds&=\\int_{0}^{5}f(r(t))\\|\\mathbf r^{\\prime}(t)\\|\\,\\mathrm dt \\\\ &=\\int_{0}^{5}(3 t)(\\sqrt{17})\\,\\mathrm dt \\\\ &=\\left[\\frac{3 \\sqrt{17} t^{2}}{2}\\right]_{0}^{5} \\\\ &=\\frac{3 \\sqrt{17}}{2}\\left((5)^{2}-(0)^{2}\\right) \\\\ &=\\frac{3 \\sqrt{17}}{2}\\left(25-0\\right) \\\\ &=\\frac{75 \\sqrt{17}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b718af0-92d3-59c9-9229-69b2816bd3cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{38 \\sqrt{10}}{3}" :db/id #edb/ref 17592186542559} {:answer/id #uuid "53bf3405-0c98-553b-9ce6-af3d6065c7a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{38 \\sqrt{10}}{3}" :db/id #edb/ref 17592186542568} {:answer/id #uuid "5c916508-666a-5d4f-bc0e-83237918f953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{380}{3}" :db/id #edb/ref 17592186542569} {:answer/id #uuid "5fd61603-c8b6-5e98-acdd-11a2306975c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{38}{3}" :db/id #edb/ref 17592186542571} {:answer/id #uuid "9a892440-907b-5477-a7e0-478061c8676f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10 \\sqrt{10}" :db/id #edb/ref 17592186542584}] :answer-field/correct {:answer/id #uuid "53bf3405-0c98-553b-9ce6-af3d6065c7a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{38 \\sqrt{10}}{3}" :db/id #edb/ref 17592186542568} :answer-field/id #uuid "d7c75bfe-126d-5238-b88a-6cc39af08281" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542604}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "74138378-8762-53b8-ac46-3f0ace177732" :question/problem "Evaluate the integral of the function $f(x,y)=({x}^{2}+y)$ along the line $y=3x+2,$ $\\,0\\le x\\le 2.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=3t+2.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,3t+2⟩,\\,0\\le t\\le 2\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(3t+2)j \\\\  & =i+3\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{3}^{2}} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}+y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & ={t}^{2}+(3t+2)={t}^{2}+3t+2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}({t}^{2}+3t+2)\\cdot \\sqrt{10}\\cdot \\text{d}t \\\\  & =\\sqrt{10}{\\int }_{0}^{2}({t}^{2}+3t+2)\\,\\text{d}t \\\\  & =\\sqrt{10}\\,(\\frac{{t}^{3}}{3}+\\frac{3{t}^{2}}{2}+2t){|}_{0}^{2} \\\\  & =\\sqrt{10}(\\frac{8}{3}+6+4) \\\\  & =\\frac{38 \\sqrt{10}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c2c9bda-2b1c-547d-a80e-eff23e39c06d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4 \\sqrt{2}}{3} + \\frac{34 \\sqrt{17}}{3}" :db/id #edb/ref 17592186542563} {:answer/id #uuid "8b9920b7-0e21-5c1f-8111-86f228f479e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186542580} {:answer/id #uuid "8c2807fa-9092-5089-8280-849eef5d1d2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{285}{2}" :db/id #edb/ref 17592186542581} {:answer/id #uuid "9e06ccd9-0287-543d-9f3b-377e3c903179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln{\\left(18446744073709551616 \\right)}" :db/id #edb/ref 17592186542585} {:answer/id #uuid "bc780127-f10d-5f5e-8853-c61ea96f5041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{34 \\sqrt{17}}{3} + \\frac{4 \\sqrt{2}}{3}" :db/id #edb/ref 17592186542590}] :answer-field/correct {:answer/id #uuid "2c2c9bda-2b1c-547d-a80e-eff23e39c06d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4 \\sqrt{2}}{3} + \\frac{34 \\sqrt{17}}{3}" :db/id #edb/ref 17592186542563} :answer-field/id #uuid "927562b5-720d-53ed-bf92-54fcb887de44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542602}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7e94a1c8-32a5-5aeb-82a3-988f3971786f" :question/problem "Evaluate the integral of the function $f(x,y)=2{y}^{2}$ along the curve $y={e}^{x},$ $\\,0\\le x\\le \\ln{\\left(4 \\right)}.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)={e}^{t}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,{e}^{t}⟩,\\,0\\le t\\le \\ln{\\left(4 \\right)}\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})j \\\\  & =i+{e}^{t}j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{({e}^{t})}^{2}} \\\\  & =\\sqrt{1+{e}^{2t}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2({e}^{t})^{2}=2{e}^{2t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{\\ln{\\left(4 \\right)}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\ln{\\left(4 \\right)}}2{e}^{2t}\\cdot \\sqrt{1+{e}^{2t}}\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{\\ln{\\left(4 \\right)}}2{e}^{2t}\\,\\sqrt{1+{e}^{2t}}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+{e}^{2t}$, $\\text{d}u=2{e}^{2t}\\,\\text{d}t$ as follows:  \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\ln{\\left(4 \\right)}}2{e}^{2t}\\,\\sqrt{1+{e}^{2t}}\\,\\text{d}t & ={\\int }_{2}^{17}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{3}{u}^{3/2}{|}_{2}^{17} \\\\  & =\\frac{2}{3}({17}^{3/2}-{2}^{3/2}) \\\\  & =\\frac{2}{3}(17 \\sqrt{17}-2\\sqrt{2}) \\\\  & =- \\frac{4 \\sqrt{2}}{3} + \\frac{34 \\sqrt{17}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "482b716c-5732-5534-84fd-923827a99c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1872" :db/id #edb/ref 17592186542566} {:answer/id #uuid "6a75de59-ff24-5015-82fd-549b0eabf5f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 72 \\sqrt{26}" :db/id #edb/ref 17592186542573} {:answer/id #uuid "77c7a369-2abc-53dd-b2aa-5a817fb5b5bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72 \\sqrt{26}" :db/id #edb/ref 17592186542576} {:answer/id #uuid "871f3101-6660-58fb-8c35-50aad648b843" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24 \\sqrt{26}" :db/id #edb/ref 17592186542579} {:answer/id #uuid "8d989555-4656-5801-a461-47d42c1dd876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186542582}] :answer-field/correct {:answer/id #uuid "77c7a369-2abc-53dd-b2aa-5a817fb5b5bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72 \\sqrt{26}" :db/id #edb/ref 17592186542576} :answer-field/id #uuid "49a0cf1d-2ab0-543e-9e64-7b0edf5e8453" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542599}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "969d5e52-a658-5dd3-9654-fc884ce1b67b" :question/problem "Evaluate the integral of the function $f(x,y)=4 x$ along the line $y=5 x,$ $\\,0\\le x\\le 6.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=5 t.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf r(t)=\\langle t,5 t\\rangle,\\qquad 0\\le t\\le 6\n$$\n\nComputing $\\mathbf r^{\\prime}(t)$ and $\\|\\mathbf r^{\\prime}(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}\\mathbf r^{\\prime}(t)&=\\frac{\\mathrm dx}{\\mathrm dt}\\mathbf i+\\frac{\\mathrm dy}{\\mathrm dt}\\mathbf j \\\\ &=\\frac{\\mathrm d}{\\mathrm dt}(t)\\mathbf i+\\frac{\\mathrm d}{\\mathrm dt}(5 t)\\mathbf j \\\\ &=\\mathbf i+(5)\\mathbf j \\\\ \\|\\mathbf r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm dx}{\\mathrm dt}\\right)^2+\\left(\\frac{\\mathrm dy}{\\mathrm dt}\\right)^2} \\\\ &=\\sqrt{1^2+(5)^2} \\\\ &=\\sqrt{26}\\end{aligned}\n$$\n\nNow, since $f(x,y)=4 x$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=4 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm ds&=\\int_{0}^{6}f(r(t))\\|\\mathbf r^{\\prime}(t)\\|\\,\\mathrm dt \\\\ &=\\int_{0}^{6}(4 t)(\\sqrt{26})\\,\\mathrm dt \\\\ &=\\left[2 \\sqrt{26} t^{2}\\right]_{0}^{6} \\\\ &=2 \\sqrt{26}\\left((6)^{2}-(0)^{2}\\right) \\\\ &=2 \\sqrt{26}\\left(36-0\\right) \\\\ &=72 \\sqrt{26}.\\end{aligned}\n$$"}]}
