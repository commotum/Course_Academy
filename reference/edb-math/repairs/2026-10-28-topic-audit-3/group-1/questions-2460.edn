5bd9c2d5e064689baf24c6ee23cff9.png)\n\nA field is **solenoidal** exactly when its divergence is zero everywhere.\n\nThe $x$-component changes only as we move in the $y$-direction. At a fixed $y$-coordinate, opposite sides normal to the $x$-axis have matching components. The $y$-component is constant as well. All normal fluxes across opposite sides balance, even though arrow lengths vary.\n\nTherefore, $\\nabla\\cdot F=0$ everywhere, and $F$ is solenoidal.\n\nThe true statements are $\\nabla\\cdot F=0$ and $F$ is solenoidal."}] [{:db/id #edb/ref 17592186720850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60fd2f23-7784-5bf8-9ee7-415aa3cdaa6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186720819} {:answer/id #uuid "a79cd7fe-c44a-56d9-ae4a-2493d656e8e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186720837}] :answer-field/correct {:answer/id #uuid "60fd2f23-7784-5bf8-9ee7-415aa3cdaa6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186720819} :answer-field/id #uuid "39f9fce6-463f-5248-94ff-03f612253427" :answer-field/key "$\\nabla\\cdot F<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186720806} {:answer-field/choices [{:answer/id #uuid "6033f782-ac6a-5595-aa69-5986abb8af82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186720817} {:answer/id #uuid "b341e34d-4ef5-5b7a-800d-ac6905fcc9c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186720845}] :answer-field/correct {:answer/id #uuid "b341e34d-4ef5-5b7a-800d-ac6905fcc9c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186720845} :answer-field/id #uuid "a231714b-b01f-5120-8e91-19174bc78dc9" :answer-field/key "$\\nabla\\cdot F>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186720835} {:answer-field/choices [{:answer/id #uuid "25638b53-77a7-5047-9d3a-79db43a483db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186720803} {:answer/id #uuid "d108c650-a509-5a44-8771-55f1ae6b80a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186720853}] :answer-field/correct {:answer/id #uuid "d108c650-a509-5a44-8771-55f1ae6b80a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186720853} :answer-field/id #uuid "c015f82e-8cd2-584e-a521-ca766c722b39" :answer-field/key "$F$ is solenoidal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186720848} {:answer-field/choices [{:answer/id #uuid "3ec69f1d-6df4-588f-8238-24f7d0c0c4ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186720808} {:answer/id #uuid "e2619521-c464-5f97-9bae-fcbe6a201858" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186720858}] :answer-field/correct {:answer/id #uuid "e2619521-c464-5f97-9bae-fcbe6a201858" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186720858} :answer-field/id #uuid "d4803726-30b6-5b37-82e9-4c840ea30793" :answer-field/key "$\\nabla\\cdot F=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186720855}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdc486d7-3e50-5c65-94a1-de8233dab74d" :question/problem "![](images/53/534026fd3535ea15e595450b30671d48ced5fa0503e1742d7385df36c82a8ad8.png)\n\nConsider the smooth vector field $F$ shown above. The displayed pattern continues throughout the plane. All arrows use the same length scale; lengths represent speed. Which statements are true everywhere?\n\nSelect all that apply." :question/worked-solution "Recall that $\\operatorname{div} F=\\nabla\\cdot F$ denotes divergence. A local excess of outward flow means positive divergence (**source**); inward flow means negative divergence (**sink**); balanced flow means zero divergence.\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nA field is **solenoidal** exactly when its divergence is zero everywhere.\n\nThe $x$-component increases as we move in the positive $x$-direction. The $y$-component is constant, so its flux across opposite sides balances. Thus there is a local excess of outward flow everywhere.\n\nTherefore, $\\nabla\\cdot F>0$ everywhere, and $F$ is not solenoidal.\n\nThe true statements are $\\nabla\\cdot F>0$."}] [{:db/id #edb/ref 17592186720866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a87c1b2-cae5-587b-b609-e289a1f2dec4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186720865} {:answer/id #uuid "a35d3c3e-7f01-574f-8153-8ebd48a6e015" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186720867} {:answer/id #uuid "af2a519a-ac22-5154-a16d-17de12a03f0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186720868} {:answer/id #uuid "b8e49d86-215f-5530-aa68-0b02abf4b575" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186720869} {:answer/id #uuid "ebf78c3b-3b83-567c-8d2a-21796fb08d42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186720870}] :answer-field/correct {:answer/id #uuid "ebf78c3b-3b83-567c-8d2a-21796fb08d42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186720870} :answer-field/id #uuid "62382704-28a9-5949-bd6d-7cd51b78e4b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720864}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9ade02ab-0b7c-52eb-b427-20a7fd6e38c8" :question/problem "![](images/33/33b344f4c0c6d2dc9ceb0c41fd3e77bf0824318020c5bbb9ab73e56044ed1b67.png)\n\nConsider the smooth vector field $F$ shown above. The displayed pattern continues throughout the plane. All arrows use the same length scale; lengths represent speed. Which statements are true everywhere?\n\nI. $\\nabla\\cdot F=0$\n\nII. $\\nabla\\cdot F>0$\n\nIII. $\\nabla\\cdot F<0$\n\nIV. $F$ is solenoidal" :question/worked-solution "Recall that $\\operatorname{div} F=\\nabla\\cdot F$ denotes divergence. A local excess of outward flow means positive divergence (**source**); inward flow means negative divergence (**sink**); balanced flow means zero divergence.\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nA field is **solenoidal** exactly when its divergence is zero everywhere.\n\nThe $y$-component changes only as we move in the $x$-direction. At a fixed $x$-coordinate, opposite sides normal to the $y$-axis have matching components. The $x$-component is constant as well. All normal fluxes across opposite sides balance, even though arrow lengths vary.\n\nTherefore, $\\nabla\\cdot F=0$ everywhere, and $F$ is solenoidal.\n\nThe true statements are $\\nabla\\cdot F=0$ and $F$ is solenoidal."}] [{:db/id #edb/ref 17592186721082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24525ab1-c6e0-55f3-a200-7c2d81528328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 e" :db/id #edb/ref 17592186721080} {:answer/id #uuid "4e6c3171-6bd1-5150-8b5f-f07bdc11af22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e" :db/id #edb/ref 17592186721084} {:answer/id #uuid "7c766c84-028f-5b1c-a020-8869f58cec5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 e" :db/id #edb/ref 17592186721090} {:answer/id #uuid "f2ae5891-1741-55b5-a8b6-a75d19ab865a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 e" :db/id #edb/ref 17592186721105} {:answer/id #uuid "f94fe650-21f6-5152-aa52-45105ede5b60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186721108}] :answer-field/correct {:answer/id #uuid "24525ab1-c6e0-55f3-a200-7c2d81528328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 e" :db/id #edb/ref 17592186721080} :answer-field/id #uuid "1f1aa741-556e-5485-abff-d6d70da373ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "29b7447c-92dd-5fe9-b6ad-edc8a69a0285" :question/problem "Consider the vector field\n\n$$\n\\mathbf F=\\left(x e^{y}\\right)\\,\\mathbf i+\\left(2 x y e^{y}\\right)\\,\\mathbf j.\n$$\n\nEvaluate $\\nabla\\cdot\\mathbf F$ at the point $(-1,1)$." :question/worked-solution "For $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$, use $\\nabla\\cdot\\mathbf F=P_x+Q_y$. Hold the other coordinate constant in each partial derivative.\n\n$$\n\\begin{aligned}\nP_x&=\\frac{\\partial}{\\partial x}\\left(x e^{y}\\right)\\\\\n&=e^{y}\\\\\nQ_y&=\\frac{\\partial}{\\partial y}\\left(2 x y e^{y}\\right)\\\\\n&=2 x y e^{y} + 2 x e^{y}\\\\\n\\nabla\\cdot\\mathbf F&=P_x+Q_y\n\\end{aligned}\n$$\n\nEvaluate after differentiating:\n\n$$\n\\begin{aligned}\n(\\nabla\\cdot\\mathbf F)(-1,1)&=e+\\left(- 4 e\\right)\\\\\n&=- 3 e.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8b669f-d295-5f1a-9084-a026bc0aa968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7}{5}" :db/id #edb/ref 17592186721076} {:answer/id #uuid "287bb641-66f2-5b48-b1d9-9f9d524e64cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{116}{5}" :db/id #edb/ref 17592186721081} {:answer/id #uuid "5b76d94b-6f7c-53e4-a284-31e491cd5aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{109}{5}" :db/id #edb/ref 17592186721085} {:answer/id #uuid "63605666-5c7f-5ca5-b9d5-89e1889d6009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186721086} {:answer/id #uuid "f9b7acf6-a463-5c63-952a-1048735be592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{48}{5}" :db/id #edb/ref 17592186721109}] :answer-field/correct {:answer/id #uuid "0a8b669f-d295-5f1a-9084-a026bc0aa968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7}{5}" :db/id #edb/ref 17592186721076} :answer-field/id #uuid "aed0649b-010e-5c37-a2fa-734328f0939e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721094}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36bf9e22-661c-5988-8f3d-b756560647e3" :question/problem "Consider the vector field\n\n$$\n\\mathbf F=\\left(x \\sqrt{x^{2} + y^{2}}\\right)\\,\\mathbf i+\\left(- y \\sqrt{x^{2} + y^{2}}\\right)\\,\\mathbf j.\n$$\n\nEvaluate $\\nabla\\cdot\\mathbf F$ at the point $(3,4)$." :question/worked-solution "For $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$, use $\\nabla\\cdot\\mathbf F=P_x+Q_y$. Hold the other coordinate constant in each partial derivative.\n\n$$\n\\begin{aligned}\nP_x&=\\frac{\\partial}{\\partial x}\\left(x \\sqrt{x^{2} + y^{2}}\\right)\\\\\n&=\\frac{x^{2}}{\\sqrt{x^{2} + y^{2}}} + \\sqrt{x^{2} + y^{2}}\\\\\nQ_y&=\\frac{\\partial}{\\partial y}\\left(- y \\sqrt{x^{2} + y^{2}}\\right)\\\\\n&=- \\frac{y^{2}}{\\sqrt{x^{2} + y^{2}}} - \\sqrt{x^{2} + y^{2}}\\\\\n\\nabla\\cdot\\mathbf F&=P_x+Q_y\n\\end{aligned}\n$$\n\nEvaluate after differentiating:\n\n$$\n\\begin{aligned}\n(\\nabla\\cdot\\mathbf F)(3,4)&=\\frac{34}{5}+\\left(- \\frac{41}{5}\\right)\\\\\n&=- \\frac{7}{5}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18559774-ee7f-5b2e-bff1-96c52822c7b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 - \\frac{3 \\pi}{2}" :db/id #edb/ref 17592186721078} {:answer/id #uuid "7caf86b7-61ab-5be3-a17b-793325b05549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 + \\frac{3 \\pi}{2}" :db/id #edb/ref 17592186721091} {:answer/id #uuid "cf766c8e-41e5-560f-a6c8-6c9260687021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - \\frac{3 \\pi}{2}" :db/id #edb/ref 17592186721100} {:answer/id #uuid "d2b79026-6763-5dfb-bd2e-db147736af83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4 + \\frac{3 \\pi}{2}" :db/id #edb/ref 17592186721101} {:answer/id #uuid "f3cd1e8c-8d0e-559c-b79f-7ecac71fa511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186721106}] :answer-field/correct {:answer/id #uuid "7caf86b7-61ab-5be3-a17b-793325b05549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 + \\frac{3 \\pi}{2}" :db/id #edb/ref 17592186721091} :answer-field/id #uuid "d5b882e1-8c5a-56a4-8f0f-be9a737fae6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721102}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79a03524-42ec-54a2-874e-ec327283e7ac" :question/problem "Consider the vector field\n\n$$\n\\mathbf F=\\left(- 2 y^{2} \\sin{\\left(2 x \\right)}\\right)\\,\\mathbf i+\\left(- 3 x \\ln{\\left(y \\right)}\\right)\\,\\mathbf j.\n$$\n\nEvaluate $\\nabla\\cdot\\mathbf F$ at the point $(- \\frac{\\pi}{2},1)$." :question/worked-solution "For $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$, use $\\nabla\\cdot\\mathbf F=P_x+Q_y$. Hold the other coordinate constant in each partial derivative.\n\n$$\n\\begin{aligned}\nP_x&=\\frac{\\partial}{\\partial x}\\left(- 2 y^{2} \\sin{\\left(2 x \\right)}\\right)\\\\\n&=- 4 y^{2} \\cos{\\left(2 x \\right)}\\\\\nQ_y&=\\frac{\\partial}{\\partial y}\\left(- 3 x \\ln{\\left(y \\right)}\\right)\\\\\n&=- \\frac{3 x}{y}\\\\\n\\nabla\\cdot\\mathbf F&=P_x+Q_y\n\\end{aligned}\n$$\n\nThe point satisfies the domain condition $y>0$.\n\nEvaluate after differentiating:\n\n$$\n\\begin{aligned}\n(\\nabla\\cdot\\mathbf F)(- \\frac{\\pi}{2},1)&=4+\\left(\\frac{3 \\pi}{2}\\right)\\\\\n&=4 + \\frac{3 \\pi}{2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f25da19-6ace-5aa9-8701-abc5cd80779c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e" :db/id #edb/ref 17592186721077} {:answer/id #uuid "7bc7172e-2edb-578f-aa82-a8f57841ab90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 e" :db/id #edb/ref 17592186721089} {:answer/id #uuid "7d1caacc-c4c6-5994-ba14-589bdcb722b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186721092} {:answer/id #uuid "e162184e-1d5e-5a8f-9d02-bd4846feebbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 e" :db/id #edb/ref 17592186721103} {:answer/id #uuid "fa56ac6a-8906-57dc-a680-150c7d005dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 e" :db/id #edb/ref 17592186721110}] :answer-field/correct {:answer/id #uuid "e162184e-1d5e-5a8f-9d02-bd4846feebbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 e" :db/id #edb/ref 17592186721103} :answer-field/id #uuid "778dd489-8d57-58cd-86d5-c155cd8d69fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac219544-4f33-505b-b05b-2cc0ccf1e5a5" :question/problem "Consider the vector field\n\n$$\n\\mathbf F=\\left(e^{y} \\cos{\\left(x \\right)}\\right)\\,\\mathbf i+\\left(- 3 e^{y} \\sin{\\left(x \\right)}\\right)\\,\\mathbf j.\n$$\n\nEvaluate $\\nabla\\cdot\\mathbf F$ at the point $(\\frac{\\pi}{2},1)$." :question/worked-solution "For $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$, use $\\nabla\\cdot\\mathbf F=P_x+Q_y$. Hold the other coordinate constant in each partial derivative.\n\n$$\n\\begin{aligned}\nP_x&=\\frac{\\partial}{\\partial x}\\left(e^{y} \\cos{\\left(x \\right)}\\right)\\\\\n&=- e^{y} \\sin{\\left(x \\right)}\\\\\nQ_y&=\\frac{\\partial}{\\partial y}\\left(- 3 e^{y} \\sin{\\left(x \\right)}\\right)\\\\\n&=- 3 e^{y} \\sin{\\left(x \\right)}\\\\\n\\nabla\\cdot\\mathbf F&=P_x+Q_y\n\\end{aligned}\n$$\n\nEvaluate after differentiating:\n\n$$\n\\begin{aligned}\n(\\nabla\\cdot\\mathbf F)(\\frac{\\pi}{2},1)&=- e+\\left(- 3 e\\right)\\\\\n&=- 4 e.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8972aeb-997f-50d0-9774-5b8bd83b15aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{13}{3}" :db/id #edb/ref 17592186721095} {:answer/id #uuid "bfc65436-237b-5214-8509-14d6fa640dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{5}{3}" :db/id #edb/ref 17592186721097} {:answer/id #uuid "c95b9d7d-e3c0-5176-952f-30f18e460e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{11}{3}" :db/id #edb/ref 17592186721099} {:answer/id #uuid "ee1d8c2e-c7e3-5345-a5f5-9357f4f6273d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{8}{3}" :db/id #edb/ref 17592186721104} {:answer/id #uuid "f78f6edb-a969-5969-9fe1-6ad9c5cea9fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7}{3}" :db/id #edb/ref 17592186721107}] :answer-field/correct {:answer/id #uuid "bfc65436-237b-5214-8509-14d6fa640dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{5}{3}" :db/id #edb/ref 17592186721097} :answer-field/id #uuid "bf639235-5c61-5ff8-bf12-0741dfd759c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721096}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4465c54-de02-50ff-a1a8-8040a6db6675" :question/problem "Consider the vector field\n\n$$\n\\mathbf F=\\left(\\ln{\\left(x + y \\right)}\\right)\\,\\mathbf i+\\left(2 \\ln{\\left(x - y \\right)}\\right)\\,\\mathbf j.\n$$\n\nEvaluate $\\nabla\\cdot\\mathbf F$ at the point $(2,1)$." :question/worked-solution "For $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$, use $\\nabla\\cdot\\mathbf F=P_x+Q_y$. Hold the other coordinate constant in each partial derivative.\n\n$$\n\\begin{aligned}\nP_x&=\\frac{\\partial}{\\partial x}\\left(\\ln{\\left(x + y \\right)}\\right)\\\\\n&=\\frac{1}{x + y}\\\\\nQ_y&=\\frac{\\partial}{\\partial y}\\left(2 \\ln{\\left(x - y \\right)}\\right)\\\\\n&=- \\frac{2}{x - y}\\\\\n\\nabla\\cdot\\mathbf F&=P_x+Q_y\n\\end{aligned}\n$$\n\nThe point satisfies the domain condition $x+y>0\\text{ and }x-y>0$.\n\nEvaluate after differentiating:\n\n$$\n\\begin{aligned}\n(\\nabla\\cdot\\mathbf F)(2,1)&=\\frac{1}{3}+\\left(-2\\right)\\\\\n&=- \\frac{5}{3}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d5a14d6-ab0d-52b2-b4fe-39fd80fa6ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 2,4\\rangle" :db/id #edb/ref 17592186721140} {:answer/id #uuid "9b25afde-76e7-5840-80da-28c5c7ee6c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 1,2\\rangle" :db/id #edb/ref 17592186721149} {:answer/id #uuid "9ed32f9c-59c8-5960-8d8b-9fddc5ed23e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 4,1\\rangle" :db/id #edb/ref 17592186721151} {:answer/id #uuid "ceeb4fef-fb0c-50f9-a2c9-90a97cee16dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 4,5\\rangle" :db/id #edb/ref 17592186721152} {:answer/id #uuid "f66d9962-1e02-54a0-a12d-6742a8de4938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle -8,5\\rangle" :db/id #edb/ref 17592186721155}] :answer-field/correct {:answer/id #uuid "9ed32f9c-59c8-5960-8d8b-9fddc5ed23e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\langle 4,1\\rangle" :db/id #edb/ref 17592186721151} :answer-field/id #uuid "6bfe1b5b-1c4e-576f-af04-652367733032" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721147}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e0d140e-83e8-58d4-9ad0-9425a2608f90" :question/problem "The vectors $\\vec{a}$ and $\\vec{b}$ are shown below. Each grid square has side length $1$.\n\n![Two vectors on a unit coordinate grid](images/92/929f62d562401942c7ddc8b40068881a7c7babfcce48ddc6a0e0ede111b795dc.png)\n\nFind the coordinates of $\\vec{a}+2\\vec{b}$." :question/worked-solution "Read the signed components from the grid. The arrow for $\\vec{a}$ goes $2$ units left and $3$ units up; the arrow for $\\vec{b}$ goes $3$ units right and $1$ unit down. Thus\n\n$$\n\\vec{a}=\\langle -2,3\\rangle,\\qquad \\vec{b}=\\langle 3,-1\\rangle.\n$$\n\nMultiply both components of $\\vec{b}$ by $2$, then add corresponding components:\n\n$$\n\\begin{aligned}\n\\vec{a}+2\\vec{b}&=\\langle -2,3\\rangle+2\\langle 3,-1\\rangle\\\\\n&=\\langle -2,3\\rangle+\\langle 6,-2\\rangle\\\\\n&=\\langle -2+6,3+(-2)\\rangle\\\\\n&=\\langle 4,1\\rangle.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa3b89be-d292-52be-a5f6-37997bb9e457" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186721156}] :answer-field/correct {:answer/id #uuid "fa3b89be-d292-52be-a5f6-37997bb9e457" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186721156} :answer-field/id #uuid "5f5c9e5a-456c-507d-9b97-1010603d0969" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186721146} {:answer-field/choices [{:answer/id #uuid "9bb4b056-88e0-5eb3-978d-871bdb327cc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186721150}] :answer-field/correct {:answer/id #uuid "9bb4b056-88e0-5eb3-978d-871bdb327cc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186721150} :answer-field/id #uuid "eb4ed5f4-79fb-5d47-9ad7-2eeed4870627" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186721153}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8769c346-caf7-5868-a698-15e1a1970e7d" :question/problem "The vectors $\\vec{a}$ and $\\vec{b}$ are shown below. Each grid square has side length $1$.\n\n![Two vectors on a unit coordinate grid](images/d3/d367fde2b9a8820b314c93da2110593446835c89bfe499d1152b5534f359bfa3.png)\n\nFind the coordinates of $2\\vec{a}-3\\vec{b}$.\n\n$2\\vec{a}-3\\vec{b}=\\langle$ {{field-1}} $,\\,$ {{field-2}} $\\rangle$." :question/worked-solution "The arrowheads give the components because both arrows start at the origin:\n\n$$\n\\vec{a}=\\langle 3,2\\rangle,\\qquad \\vec{b}=\\langle -1,4\\rangle.\n$$\n\nFirst scale both vectors:\n\n$$\n2\\vec{a}=\\langle 6,4\\rangle,\\qquad 3\\vec{b}=\\langle -3,12\\rangle.\n$$\n\nNow subtract corresponding components. Subtracting the negative first component of $3\\vec{b}$ adds $3$:\n\n$$\n\\begin{aligned}\n2\\vec{a}-3\\vec{b}&=\\langle 6,4\\rangle-\\langle -3,12\\rangle\\\\\n&=\\langle 6-(-3),4-12\\rangle\\\\\n&=\\langle 9,-8\\rangle.\n\\end{aligned}\n$$"}]}
