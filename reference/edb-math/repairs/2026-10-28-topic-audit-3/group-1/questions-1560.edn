2-ff99-5a89-bd9a-bb2ab32a4d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36 \\pi" :db/id #edb/ref 17592186540299} {:answer/id #uuid "9e5331c0-17c1-57d8-b981-80bc93013514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 18 \\pi" :db/id #edb/ref 17592186540303} {:answer/id #uuid "c8b21cf5-b029-596f-9daa-1704136d990f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\pi" :db/id #edb/ref 17592186540307} {:answer/id #uuid "f49d5766-20e5-5f10-b5e7-ff819c91de23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18 \\pi" :db/id #edb/ref 17592186540313} {:answer/id #uuid "f8d8532e-17d1-5493-9f25-92eb498314f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 \\pi" :db/id #edb/ref 17592186540315}] :answer-field/correct {:answer/id #uuid "f49d5766-20e5-5f10-b5e7-ff819c91de23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18 \\pi" :db/id #edb/ref 17592186540313} :answer-field/id #uuid "b6a49ae3-c511-509c-a7e2-5e82cb83cd8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540304}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5a8981d-48dd-5bc9-9468-7747b7d1e093" :question/problem "Use Green's theorem to find the area of the region $D$ enclosed by the curve $C$ parametrized as $r(t)=3\\cos t\\,i+6\\sin t\\,j$ for $t\\in[0,2\\pi].$\n\n![](images/d0/d08df891c30fe6d4777fbbfd86887741d224beb3d71af7d20001521a417115a4.png)" :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, smooth, closed path $C$ is positively oriented, and\n\n$$\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}=0-(-1)=1.$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\\begin{aligned}\\text{Area}(D)&=\\iint_D\\text{d}A\\\\&=\\iint_D(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y})\\,\\text{d}A\\\\&=\\oint_C P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}$$\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\\oint_C P\\,\\text{d}x+Q\\,\\text{d}y=-\\oint_C y\\,\\text{d}x.$$\n\nThe derivative of $r(t)$ is\n\n$$r'(t)=\\langle -3\\sin t,6\\cos t\\rangle.$$\n\nTherefore, we can write our line integral as\n\n$$\\begin{aligned}-\\oint_C y\\,\\text{d}x&=-\\int_0^{2\\pi}6\\sin t\\cdot(-3\\sin t)\\,\\text{d}t\\\\&=18\\int_0^{2\\pi}\\sin^2 t\\,\\text{d}t\\\\&=18\\int_0^{2\\pi}\\frac{1-\\cos 2t}{2}\\,\\text{d}t\\\\&=\\int_0^{2\\pi}\\left(9-9\\cos 2t\\right)\\,\\text{d}t\\\\&=\\left[9t-\\frac{9}{2}\\sin 2t\\right]_0^{2\\pi}\\\\&=\\left(18 \\pi-0\\right)-\\left(0-0\\right)\\\\&=18 \\pi\\end{aligned}$$\n\nTherefore, we conclude that $\\text{Area}(D)=18 \\pi.$"}] [{:db/id #edb/ref 17592186540320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8100a83e-0fed-5bbd-83d1-25db408b39de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in\\mathbb{R}" :db/id #edb/ref 17592186540362} {:answer/id #uuid "975f5b03-8475-506f-b64a-7140761d0208" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -3" :db/id #edb/ref 17592186540367} {:answer/id #uuid "a5af8174-9b50-508f-9a57-01a6afbc7a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -3" :db/id #edb/ref 17592186540370} {:answer/id #uuid "ac77650e-897b-5e0f-a844-747b1edb701f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186540372} {:answer/id #uuid "f4be22ed-f098-52b4-a7de-489c1cb859e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-3" :db/id #edb/ref 17592186540385}] :answer-field/correct {:answer/id #uuid "a5af8174-9b50-508f-9a57-01a6afbc7a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -3" :db/id #edb/ref 17592186540370} :answer-field/id #uuid "4a0abccc-0290-55cf-9ead-0974a7aa69b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02348b24-70cd-5612-9342-2fbb2c626928" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3 t - 3,\\,y=t,\\,t\\le 0,\n$$\n\ndetermine the range of $x.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ evaluate the endpoint: $x(0)=-3$. The coefficient of $t$ is $3$, so the coordinate is monotone on the given half-line. The parameter endpoint is included. The range is $x\\le -3.$"}] [{:db/id #edb/ref 17592186540324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbebc7a-44f3-573c-a1ed-32be321747c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 4" :db/id #edb/ref 17592186540333} {:answer/id #uuid "528ce7bd-1bac-5f79-acf3-1a201c38db3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>4" :db/id #edb/ref 17592186540345} {:answer/id #uuid "722b775c-3677-50d4-b90e-b62abf5d0d39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186540355} {:answer/id #uuid "7faf7a02-0581-5269-992f-3993c984b17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in\\mathbb{R}" :db/id #edb/ref 17592186540361} {:answer/id #uuid "d195902a-1c85-5315-bb08-2754fe449b54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 4" :db/id #edb/ref 17592186540377}] :answer-field/correct {:answer/id #uuid "2bbebc7a-44f3-573c-a1ed-32be321747c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 4" :db/id #edb/ref 17592186540333} :answer-field/id #uuid "6e688deb-e4a1-5d79-b81b-737237598419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540354}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "102ffed9-7cbf-59bc-9bdf-84cde8d54ebc" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=- 2 t - 2,\\,y=t,\\,t\\le -3,\n$$\n\ndetermine the range of $x.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ evaluate the endpoint: $x(-3)=4$. The coefficient of $t$ is $-2$, so the coordinate is monotone on the given half-line. The parameter endpoint is included. The range is $x\\ge 4.$"}] [{:db/id #edb/ref 17592186540326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e5e7c25-819a-557d-b69e-a894f87316b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -4,\\,y\\ge -4" :db/id #edb/ref 17592186540337} {:answer/id #uuid "4d9055c5-80e4-5658-af89-700b2e36acb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -4,\\,y\\ge -4" :db/id #edb/ref 17592186540341} {:answer/id #uuid "6b0d173b-d9fc-5e26-9c0d-b599bfb8c32a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,y=-4" :db/id #edb/ref 17592186540352} {:answer/id #uuid "de3e48c8-79eb-5784-a70c-9051e50dde8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-4,\\,y>-4" :db/id #edb/ref 17592186540380} {:answer/id #uuid "fdba03f0-3378-5880-b80b-d35237968c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -4,\\,y\\le -4" :db/id #edb/ref 17592186540389}] :answer-field/correct {:answer/id #uuid "4d9055c5-80e4-5658-af89-700b2e36acb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -4,\\,y\\ge -4" :db/id #edb/ref 17592186540341} :answer-field/id #uuid "201e1613-65df-5570-afb2-014b3764cf0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540329}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "197e86bb-c3df-56f9-92fa-70b2e47871ac" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=- t^{2} - 2 t - 5,\\,y=t^{2} - 6 t + 5,\\,t\\le 3,\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ complete the square:\n\n$$\nx=- t^{2} - 2 t - 5=- \\left(t + 1\\right)^{2} - 4 .\n$$\n\nThe vertex parameter is $t=-1$, which is admissible. The vertex value is $-4$ and is attained. The coordinate is unbounded below. Consequently, $x\\le -4.$\n\n- To find the range of $y,$ complete the square:\n\n$$\ny=t^{2} - 6 t + 5=\\left(t - 3\\right)^{2} - 4 .\n$$\n\nThe vertex parameter is $t=3$, which is admissible. The vertex value is $-4$ and is attained. The coordinate is unbounded above. Consequently, $y\\ge -4.$"}] [{:db/id #edb/ref 17592186540328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fe4da8c-3be9-5337-9420-21f5d4825fb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 3,\\,y\\ge 9" :db/id #edb/ref 17592186540343} {:answer/id #uuid "60d649a4-321a-5de7-b156-8796ccac60ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3,\\,y\\le 9" :db/id #edb/ref 17592186540347} {:answer/id #uuid "6c3de7ea-13a1-58b7-86d9-59e54c7da592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<3,\\,y<9" :db/id #edb/ref 17592186540353} {:answer/id #uuid "7f3e8597-508e-5c3f-899c-b9e09c38dc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 3,\\,y\\le 9" :db/id #edb/ref 17592186540360} {:answer/id #uuid "f81aa9e2-4855-5d39-808d-88f3380e4dab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3,\\,y=9" :db/id #edb/ref 17592186540386}] :answer-field/correct {:answer/id #uuid "7f3e8597-508e-5c3f-899c-b9e09c38dc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 3,\\,y\\le 9" :db/id #edb/ref 17592186540360} :answer-field/id #uuid "9c452869-bca3-584c-9953-322045099a13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540369}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1fc95142-7e4a-59e3-a105-7751e7e85b4d" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=- t^{2} + 2 t + 2,\\,y=- t^{2} - 6 t,\\,t<3,\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ complete the square:\n\n$$\nx=- t^{2} + 2 t + 2=3 - \\left(t - 1\\right)^{2} .\n$$\n\nThe vertex parameter is $t=1$, which is admissible. The vertex value is $3$ and is attained. The coordinate is unbounded below. Consequently, $x\\le 3.$\n\n- To find the range of $y,$ complete the square:\n\n$$\ny=- t^{2} - 6 t=9 - \\left(t + 3\\right)^{2} .\n$$\n\nThe vertex parameter is $t=-3$, which is admissible. The vertex value is $9$ and is attained. The coordinate is unbounded below. Consequently, $y\\le 9.$"}] [{:db/id #edb/ref 17592186540334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3af21bb4-2169-5e30-b0ae-12e2f6599390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6" :db/id #edb/ref 17592186540335} {:answer/id #uuid "bed7ce11-7bc6-5ba0-ba05-c079d02a9ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<6" :db/id #edb/ref 17592186540374} {:answer/id #uuid "c37d89a9-c4b4-542e-bb1b-7795a54f7ad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 6" :db/id #edb/ref 17592186540375} {:answer/id #uuid "c8329fa5-24d9-53b0-888f-4680b51bcc41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>6" :db/id #edb/ref 17592186540376} {:answer/id #uuid "dfb66c74-469b-54db-b594-770961061056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in\\mathbb{R}" :db/id #edb/ref 17592186540381}] :answer-field/correct {:answer/id #uuid "bed7ce11-7bc6-5ba0-ba05-c079d02a9ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<6" :db/id #edb/ref 17592186540374} :answer-field/id #uuid "77d01e4e-43d3-5559-8a50-9051534e876f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540357}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2cbdfb73-c263-57fa-a9d4-320c5af8e8c6" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=2 t + 2,\\,y=t,\\,t<2,\n$$\n\ndetermine the range of $x.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ evaluate the endpoint: $x(2)=6$. The coefficient of $t$ is $2$, so the coordinate is monotone on the given half-line. The parameter endpoint is excluded. The range is $x<6.$"}] [{:db/id #edb/ref 17592186540342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04dac3c3-9cbb-530a-9a62-c678359ee51a" :answer/type {:db/id #