i) \\\\  & =19\\cdot 36\\pi \\\\  & =684\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46da7648-8673-5c97-86f3-77238d0bb3c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 21 \\pi" :db/id #edb/ref 17592186540285} {:answer/id #uuid "4e6af0f6-c61b-5aba-ad4f-45f08e34969e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42 \\pi" :db/id #edb/ref 17592186540287} {:answer/id #uuid "7bb604c3-2157-5d2e-9169-7495734d92f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21 \\pi" :db/id #edb/ref 17592186540295} {:answer/id #uuid "f8052487-9788-50be-af33-0d64b549724a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 \\pi" :db/id #edb/ref 17592186540314} {:answer/id #uuid "fb479665-4249-5b02-8faf-a5ce6e2008fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\pi" :db/id #edb/ref 17592186540317}] :answer-field/correct {:answer/id #uuid "7bb604c3-2157-5d2e-9169-7495734d92f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21 \\pi" :db/id #edb/ref 17592186540295} :answer-field/id #uuid "7fc5abd1-56ff-5eb8-8b28-6a4c03e533b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "001b4812-0777-5cfd-acd4-edb5e3c4b5a2" :question/problem "Use Green's theorem to find the area of the region $D$ enclosed by the curve $C$ parametrized as $r(t)=7\\cos t\\,i+3\\sin t\\,j$ for $t\\in[0,2\\pi].$\n\n![](images/88/88907a8e0d33f889ae4fe3723a239b904a302f41fa294fc372e9d73cb049128a.png)" :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, smooth, closed path $C$ is positively oriented, and\n\n$$\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}=0-(-1)=1.$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\\begin{aligned}\\text{Area}(D)&=\\iint_D\\text{d}A\\\\&=\\iint_D(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y})\\,\\text{d}A\\\\&=\\oint_C P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}$$\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\\oint_C P\\,\\text{d}x+Q\\,\\text{d}y=-\\oint_C y\\,\\text{d}x.$$\n\nThe derivative of $r(t)$ is\n\n$$r'(t)=\\langle -7\\sin t,3\\cos t\\rangle.$$\n\nTherefore, we can write our line integral as\n\n$$\\begin{aligned}-\\oint_C y\\,\\text{d}x&=-\\int_0^{2\\pi}3\\sin t\\cdot(-7\\sin t)\\,\\text{d}t\\\\&=21\\int_0^{2\\pi}\\sin^2 t\\,\\text{d}t\\\\&=21\\int_0^{2\\pi}\\frac{1-\\cos 2t}{2}\\,\\text{d}t\\\\&=\\int_0^{2\\pi}\\left(\\frac{21}{2}-\\frac{21}{2}\\cos 2t\\right)\\,\\text{d}t\\\\&=\\left[\\frac{21}{2}t-\\frac{21}{4}\\sin 2t\\right]_0^{2\\pi}\\\\&=\\left(21 \\pi-0\\right)-\\left(0-0\\right)\\\\&=21 \\pi\\end{aligned}$$\n\nTherefore, we conclude that $\\text{Area}(D)=21 \\pi.$"}] [{:db/id #edb/ref 17592186540286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "263ffce1-698e-508e-8873-25171957ad4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 \\pi" :db/id #edb/ref 17592186540279} {:answer/id #uuid "519536aa-01e2-580d-98bc-6634d5aa438d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60 \\pi" :db/id #edb/ref 17592186540289} {:answer/id #uuid "7efe9a4b-a744-525f-9e01-9a860ae3c7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 \\pi" :db/id #edb/ref 17592186540296} {:answer/id #uuid "87ae3b3a-947a-5634-ba17-7b4b33735361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30 \\pi" :db/id #edb/ref 17592186540300} {:answer/id #uuid "b8967a6f-2070-58af-9e24-e6adc63c0557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 30 \\pi" :db/id #edb/ref 17592186540306}] :answer-field/correct {:answer/id #uuid "87ae3b3a-947a-5634-ba17-7b4b33735361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30 \\pi" :db/id #edb/ref 17592186540300} :answer-field/id #uuid "f9fb3ea4-caed-5a83-9c02-6440b3eab456" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a32b1b6-1443-5fe5-830b-fde1a97630b5" :question/problem "Use Green's theorem to find the area of the region $D$ enclosed by the curve $C$ parametrized as $r(t)=5\\cos t\\,i+6\\sin t\\,j$ for $t\\in[0,2\\pi].$\n\n![](images/07/078f9509a08715c2a842bc9b8e12bfb3da9b9d77950275174ac684b399d06a68.png)" :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, smooth, closed path $C$ is positively oriented, and\n\n$$\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}=0-(-1)=1.$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\\begin{aligned}\\text{Area}(D)&=\\iint_D\\text{d}A\\\\&=\\iint_D(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y})\\,\\text{d}A\\\\&=\\oint_C P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}$$\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\\oint_C P\\,\\text{d}x+Q\\,\\text{d}y=-\\oint_C y\\,\\text{d}x.$$\n\nThe derivative of $r(t)$ is\n\n$$r'(t)=\\langle -5\\sin t,6\\cos t\\rangle.$$\n\nTherefore, we can write our line integral as\n\n$$\\begin{aligned}-\\oint_C y\\,\\text{d}x&=-\\int_0^{2\\pi}6\\sin t\\cdot(-5\\sin t)\\,\\text{d}t\\\\&=30\\int_0^{2\\pi}\\sin^2 t\\,\\text{d}t\\\\&=30\\int_0^{2\\pi}\\frac{1-\\cos 2t}{2}\\,\\text{d}t\\\\&=\\int_0^{2\\pi}\\left(15-15\\cos 2t\\right)\\,\\text{d}t\\\\&=\\left[15t-\\frac{15}{2}\\sin 2t\\right]_0^{2\\pi}\\\\&=\\left(30 \\pi-0\\right)-\\left(0-0\\right)\\\\&=30 \\pi\\end{aligned}$$\n\nTherefore, we conclude that $\\text{Area}(D)=30 \\pi.$"}] [{:db/id #edb/ref 17592186540298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09abfe12-73cb-58a7-8f06-0ec5d416c06d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{5}" :db/id #edb/ref 17592186540278} {:answer/id #uuid "4290ff5e-39c2-5b7c-a87c-f3899caf9ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186540283} {:answer/id #uuid "4f218fcf-9054-5c93-8b98-6c5f40e4a010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186540288} {:answer/id #uuid "79a46c85-2cce-5646-a4b6-2d01b6bc7a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{84}{5}" :db/id #edb/ref 17592186540294} {:answer/id #uuid "fcf1fccd-682b-5c51-835c-1418e3129e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{84}{5}" :db/id #edb/ref 17592186540318}] :answer-field/correct {:answer/id #uuid "fcf1fccd-682b-5c51-835c-1418e3129e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{84}{5}" :db/id #edb/ref 17592186540318} :answer-field/id #uuid "d760dac3-e871-5a8d-a57b-1c489b8ed91b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540309}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "865c8611-6d60-511d-9bf4-cbb5278c6f73" :question/problem "![](images/07/078757ceefd30bb15326569c8fdd2f58b92a1a1cf9679c0d1ea662f387cbe553.png)\n\nConsider the region $D$ enclosed by the curve $C = C_{1}∪C_{2}$, where\n\n- $C_{1}$ is parametrized by $r_{1}(t) = 7t^{2}i - 3t^{3}j$ for $t ∈ [- 1, 1]$, and\n- $C_{2}$ is parametrized by $r_{2}(t) = 7i + 3tj$ for $t ∈ [- 1, 1]$.\n\nUse Green's theorem to find the area of the region." :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, piecewise-smooth, closed path $C$ is positively oriented and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y=-{∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivatives of ${r}_{1}(t)$ and ${r}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=14t\\,i-9{t}^{2}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=3j\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}-{∮}_{C}y\\,\\text{d}x & =-{∮}_{{C}_{1}\\cup {C}_{2}}y\\,dx \\\\  & =-{∮}_{{C}_{1}}y\\,dx-{∮}_{{C}_{2}}y\\,dx \\\\  & =-{\\int }_{-1}^{1}(-3{t}^{3})\\cdot 14t\\,\\text{d}t-{\\int }_{-1}^{1}(3t)\\cdot 0\\,\\text{d}t \\\\  & =42{\\int }_{-1}^{1}{t}^{4}\\,\\text{d}t-0 \\\\  & =42[\\frac{{t}^{5}}{5}]_{-1}^{1} \\\\  & =42\\left(\\frac{1^{5}}{5}-\\frac{(-1)^{5}}{5}\\right) \\\\  & =42\\left(\\frac{1}{5}-\\left(-\\frac{1}{5}\\right)\\right) \\\\  & =42\\cdot \\frac{2}{5} \\\\  & =\\frac{84}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64d60a05-7819-56b3-b386-06f85892d2ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 14 \\pi" :db/id #edb/ref 17592186540291} {:answer/id #uuid "6f31f