b/id #edb/ref 17592186540482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7523b92-e0fa-5100-89df-7dae96eaf50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186540485}] :answer-field/correct {:answer/id #uuid "a7523b92-e0fa-5100-89df-7dae96eaf50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186540485} :answer-field/id #uuid "03642954-db1f-5b56-baba-c60918de52e5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540441} {:answer-field/choices [{:answer/id #uuid "154386c8-e60b-57cd-89b8-ad30585cdf0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186540444}] :answer-field/correct {:answer/id #uuid "154386c8-e60b-57cd-89b8-ad30585cdf0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186540444} :answer-field/id #uuid "b20ad369-865c-5616-8eee-c0227b79e977" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540488} {:answer-field/choices [{:answer/id #uuid "43b45ff0-de68-500f-ae65-ebd7d951b4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540459}] :answer-field/correct {:answer/id #uuid "43b45ff0-de68-500f-ae65-ebd7d951b4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540459} :answer-field/id #uuid "fda0061c-c650-5039-a061-eeffb1ce737c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a0e7674f-c68b-5ba3-8599-974d4b1beac2" :question/problem "Let $u=4i+2j-\\frac{4}{3}k$ and $v=-4i+4j+\\frac{1}{3}k.$ Find $u\\times v.$\n\n$u\\times v=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 4 & 2 & -\\frac{4}{3} \\\\ -4 & 4 & \\frac{1}{3}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -\\frac{4}{3} \\\\ 4 & \\frac{1}{3}\\end{vmatrix}i-\\begin{vmatrix}4 & -\\frac{4}{3} \\\\ -4 & \\frac{1}{3}\\end{vmatrix}j+\\begin{vmatrix}4 & 2 \\\\ -4 & 4\\end{vmatrix}k \\\\  & =((2)\\left(\\frac{1}{3}\\right)-\\left(-\\frac{4}{3}\\right)(4))i-((4)\\left(\\frac{1}{3}\\right)-\\left(-\\frac{4}{3}\\right)(-4))j+((4)(4)-(2)(-4))k \\\\  & =(\\frac{2}{3}-\\left(-\\frac{16}{3}\\right))i-(\\frac{4}{3}-\\left(\\frac{16}{3}\\right))j+(16-(-8))k \\\\  & =6i+4j+24k \\\\  & =⟨6,4,24⟩.\\end{aligned}\n$$"}]}
