nd{aligned}\n$$"}] [{:db/id #edb/ref 17592186720182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f5ff1f-b621-50b2-913d-aa93e56445f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186720178} {:answer/id #uuid "25ee026a-e0b2-5d07-a061-7354e75437f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186720180} {:answer/id #uuid "46a92b34-9ed0-5ad9-b2f5-5ce7d93741b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186720185} {:answer/id #uuid "52b23c5e-e392-5c42-ba6f-1cf28f5d07b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186720187} {:answer/id #uuid "e582aed4-2a32-5069-8633-6415b4940f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186720196}] :answer-field/correct {:answer/id #uuid "25ee026a-e0b2-5d07-a061-7354e75437f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186720180} :answer-field/id #uuid "14e1826e-f8e5-5b35-a5fe-749003af9a6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720176}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e7a5cc9-c2eb-5d56-ae12-89e33c6bee4c" :question/problem "Let $a=\\langle-2,3,0\\rangle$, $b=\\langle-2,0,-1\\rangle$, and $c=\\langle3,1,-1\\rangle$. Find $a\\cdot(c\\times b)$ using a determinant." :question/worked-solution "The determinant rows follow the order in $a\\cdot(c\\times b)$: $a$, $c$, $b$.\n\n$$\na\\cdot(c\\times b)=\\begin{vmatrix}-2 & 3 & 0 \\\\ 3 & 1 & -1 \\\\ -2 & 0 & -1\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=(-2)\\begin{vmatrix}1 & -1 \\\\ 0 & -1\\end{vmatrix}-3\\begin{vmatrix}3 & -1 \\\\ -2 & -1\\end{vmatrix}+0\\begin{vmatrix}3 & 1 \\\\ -2 & 0\\end{vmatrix} \\\\ &=(-2)(1\\cdot (-1)-(-1)\\cdot 0) \\\\ &\\quad -3(3\\cdot (-1)-(-1)\\cdot (-2)) \\\\ &\\quad +0(3\\cdot 0-1\\cdot (-2)) \\\\ &=(-2)(-1)-3(-5)+0(2) \\\\ &=2+15+0 \\\\ &=17.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad5a97f-4925-5a2f-97c5-e13a211dd5e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186720175}] :answer-field/correct {:answer/id #uuid "0ad5a97f-4925-5a2f-97c5-e13a211dd5e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186720175} :answer-field/id #uuid "2f72587a-79a3-5ccc-acfd-149fdd8579dd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720183}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51e70447-f155-56ba-ae3a-fb064f817dbd" :question/problem "Let $a=\\langle-2,3,2\\rangle$, $b=\\langle0,3,2\\rangle$, and $c=\\langle2,2,0\\rangle$. Find $b\\cdot(c\\times a)$ using a determinant.\n\n$b\\cdot(c\\times a)=$\n{{field-1}}" :question/worked-solution "The determinant rows follow the order in $b\\cdot(c\\times a)$: $b$, $c$, $a$.\n\n$$\nb\\cdot(c\\times a)=\\begin{vmatrix}0 & 3 & 2 \\\\ 2 & 2 & 0 \\\\ -2 & 3 & 2\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=0\\begin{vmatrix}2 & 0 \\\\ 3 & 2\\end{vmatrix}-3\\begin{vmatrix}2 & 0 \\\\ -2 & 2\\end{vmatrix}+2\\begin{vmatrix}2 & 2 \\\\ -2 & 3\\end{vmatrix} \\\\ &=0(2\\cdot 2-0\\cdot 3) \\\\ &\\quad -3(2\\cdot 2-0\\cdot (-2)) \\\\ &\\quad +2(2\\cdot 3-2\\cdot (-2)) \\\\ &=0(4)-3(4)+2(10) \\\\ &=0-12+20 \\\\ &=8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b84e4eff-7f63-50f2-b85c-ab64415ebae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186720192}] :answer-field/correct {:answer/id #uuid "b84e4eff-7f63-50f2-b85c-ab64415ebae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186720192} :answer-field/id #uuid "771bc51f-20ab-58b8-8699-8ebe170e4874" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5de3d73c-2f1c-580c-8387-c3d1708b90d1" :question/problem "Let $u=\\langle-3,-2,-1\\rangle$, $v=\\langle-3,0,1\\rangle$, and $w=\\langle3,0,-2\\rangle$. Find $w\\cdot(v\\times u)$ using a determinant.\n\n$w\\cdot(v\\times u)=$\n{{field-1}}" :question/worked-solution "The determinant rows follow the order in $w\\cdot(v\\times u)$: $w$, $v$, $u$.\n\n$$\nw\\cdot(v\\times u)=\\begin{vmatrix}3 & 0 & -2 \\\\ -3 & 0 & 1 \\\\ -3 & -2 & -1\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=3\\begin{vmatrix}0 & 1 \\\\ -2 & -1\\end{vmatrix}-0\\begin{vmatrix}-3 & 1 \\\\ -3 & -1\\end{vmatrix}+(-2)\\begin{vmatrix}-3 & 0 \\\\ -3 & -2\\end{vmatrix} \\\\ &=3(0\\cdot (-1)-1\\cdot (-2)) \\\\ &\\quad -0((-3)\\cdot (-1)-1\\cdot (-3)) \\\\ &\\quad +(-2)((-3)\\cdot (-2)-0\\cdot (-3)) \\\\ &=3(2)-0(6)+(-2)(6) \\\\ &=6+0-12 \\\\ &=-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3510870d-cfa5-5a6a-85a0-3a8872cf98a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186720184}] :answer-field/correct {:answer/id #uuid "3510870d-cfa5-5a6a-85a0-3a8872cf98a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186720184} :answer-field/id #uuid "ce5a9074-c5ab-5e6b-9dee-a12b2ae03856" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf0c0456-72ae-51f9-9bbc-57efe937cff9" :question/problem "Let $p=\\langle-3,-3,-2\\rangle$, $q=\\langle1,-3,0\\rangle$, and $r=\\langle0,2,-1\\rangle$. Find $r\\cdot(q\\times p)$ using a determinant.\n\n$r\\cdot(q\\times p)=$\n{{field-1}}" :question/worked-solution "The determinant rows follow the order in $r\\cdot(q\\times p)$: $r$, $q$, $p$.\n\n$$\nr\\cdot(q\\times p)=\\begin{vmatrix}0 & 2 & -1 \\\\ 1 & -3 & 0 \\\\ -3 & -3 & -2\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=0\\begin{vmatrix}-3 & 0 \\\\ -3 & -2\\end{vmatrix}-2\\begin{vmatrix}1 & 0 \\\\ -3 & -2\\end{vmatrix}+(-1)\\begin{vmatrix}1 & -3 \\\\ -3 & -3\\end{vmatrix} \\\\ &=0((-3)\\cdot (-2)-0\\cdot (-3)) \\\\ &\\quad -2(1\\cdot (-2)-0\\cdot (-3)) \\\\ &\\quad +(-1)(1\\cdot (-3)-(-3)\\cdot (-3)) \\\\ &=0(6)-2(-2)+(-1)(-12) \\\\ &=0+4+12 \\\\ &=16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c6b7b3-74cc-5934-93ac-a5dc049407e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186720200}] :answer-field/correct {:answer/id #uuid "10c6b7b3-74cc-5934-93ac-a5dc049407e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186720200} :answer-field/id #uuid "25e6ea40-78e7-57fe-a099-f4cdf59e5ca7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720201}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "785357fa-2f03-5c19-8a30-748c58989b42" :question/problem "Let $a=\\langle2,1,-2\\rangle$, $b=\\langle-3,1,2\\rangle$, and $c=\\langle-2,3,-3\\rangle$. Find $c\\cdot(a\\times b)$ using a determinant.\n\n$c\\cdot(a\\times b)=$\n{{field-1}}" :question/worked-solution "The determinant rows follow the order in $c\\cdot(a\\times b)$: $c$, $a$, $b$.\n\n$$\nc\\cdot(a\\times b)=\\begin{vmatrix}-2 & 3 & -3 \\\\ 2 & 1 & -2 \\\\ -3 & 1 & 2\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=(-2)\\begin{vmatrix}1 & -2 \\\\ 1 & 2\\end{vmatrix}-3\\begin{vmatrix}2 & -2 \\\\ -3 & 2\\end{vmatrix}+(-3)\\begin{vmatrix}2 & 1 \\\\ -3 & 1\\end{vmatrix} \\\\ &=(-2)(1\\cdot 2-(-2)\\cdot 1) \\\\ &\\quad -3(2\\cdot 2-(-2)\\cdot (-3)) \\\\ &\\quad +(-3)(2\\cdot 1-1\\cdot (-3)) \\\\ &=(-2)(4)-3(-2)+(-3)(5) \\\\ &=-8+6-15 \\\\ &=-17.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c35c7fd1-9ec5-5721-a411-f3e964ce530b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186720206}] :answer-field/correct {:answer/id #uuid "c35c7fd1-9ec5-5721-a411-f3e964ce530b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186720206} :answer-field/id #uuid "5468e39e-1c7d-5e16-8994-84424a752058" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720203}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7949bb0f-4de6-5ee4-9ade-95e2d82afd1e" :question/problem "Let $u=\\langle2,2,1\\rangle$, $v=\\langle3,-1,2\\rangle$, and $w=\\langle-3,3,-3\\rangle$. Find $v\\cdot(w\\times u)$ using a determinant.\n\n$v\\cdot(w\\times u)=$\n{{field-1}}" :question/worked-solution "The determinant rows follow the order in $v\\cdot(w\\times u)$: $v$, $w$, $u$.\n\n$$\nv\\cdot(w\\times u)=\\begin{vmatrix}3 & -1 & 2 \\\\ -3 & 3 & -3 \\\\ 2 & 2 & 1\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=3\\begin{vmatrix}3 & -3 \\\\ 2 & 1\\end{vmatrix}-(-1)\\begin{vmatrix}-3 & -3 \\\\ 2 & 1\\end{vmatrix}+2\\begin{vmatrix}-3 & 3 \\\\ 2 & 2\\end{vmatrix} \\\\ &=3(3\\cdot 1-(-3)\\cdot 2) \\\\ &\\quad -(-1)((-3)\\cdot 1-(-3)\\cdot 2) \\\\ &\\quad +2((-3)\\cdot 2-3\\cdot 2) \\\\ &=3(9)-(-1)(3)+2(-12) \\\\ &=27+3-24 \\\\ &=6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2654f45e-88df-5fdb-8916-f96049c07577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186720202}] :answer-field/correct {:answer/id #uuid "2654f45e-88df-5fdb-8916-f96049c07577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186720202} :answer-field/id #uuid "10a76ac8-d056-553d-b180-0d142ce5e4b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720199}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfc0ece5-c163-57b8-b377-e3d816a60f92" :question/problem "Let $u=\\langle3,-2,3\\rangle$, $v=\\langle2,-2,2\\rangle$, and $w=\\langle-1,1,-1\\rangle$. Find $u\\cdot(w\\times v)$ using a determinant.\n\n$u\\cdot(w\\times v)=$\n{{field-1}}" :question/worked-solution "The determinant rows follow the order in $u\\cdot(w\\times v)$: $u$, $w$, $v$.\n\n$$\nu\\cdot(w\\times v)=\\begin{vmatrix}3 & -2 & 3 \\\\ -1 & 1 & -1 \\\\ 2 & -2 & 2\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=3\\begin{vmatrix}1 & -1 \\\\ -2 & 2\\end{vmatrix}-(-2)\\begin{vmatrix}-1 & -1 \\\\ 2 & 2\\end{vmatrix}+3\\begin{vmatrix}-1 & 1 \\\\ 2 & -2\\end{vmatrix} \\\\ &=3(1\\cdot 2-(-1)\\cdot (-2)) \\\\ &\\quad -(-2)((-1)\\cdot 2-(-1)\\cdot 2) \\\\ &\\quad +3((-1)\\cdot (-2)-1\\cdot 2) \\\\ &=3(0)-(-2)(0)+3(0) \\\\ &=0+0+0 \\\\ &=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0810f86-3e8d-5aca-baf5-ba01eb68f751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186720209}] :answer-field/correct {:answer/id #uuid "e0810f86-3e8d-5aca-baf5-ba01eb68f751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186720209} :answer-field/id #uuid "c8078fe3-8395-58fd-915f-8ff324f6d2d5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720207}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9186854-b3a2-5f35-bfdf-84046a71bb86" :question/problem "Let $p=\\langle3,1,-1\\rangle$, $q=\\langle2,1,1\\rangle$, and $r=\\langle1,3,2\\rangle$. Find $r\\cdot(p\\times q)$ using a determinant.\n\n$r\\cdot(p\\times q)=$\n{{field-1}}" :question/worked-solution "The determinant rows follow the order in $r\\cdot(p\\times q)$: $r$, $p$, $q$.\n\n$$\nr\\cdot(p\\times q)=\\begin{vmatrix}1 & 3 & 2 \\\\ 3 & 1 & -1 \\\\ 2 & 1 & 1\\end{vmatrix}\n$$\n\nCall this determinant $D$. Expand across the first row with cofactor signs $+,-,+$:\n\n$$\n\\begin{aligned}D&=1\\begin{vmatrix}1 & -1 \\\\ 1 & 1\\end{vmatrix}-3\\begin{vmatrix}3 & -1 \\\\ 2 & 1\\end{vmatrix}+2\\begin{vmatrix}3 & 1 \\\\ 2 & 1\\end{vmatrix} \\\\ &=1(1\\cdot 1-(-1)\\cdot 1) \\\\ &\\quad -3(3\\cdot 1-(-1)\\cdot 2) \\\\ &\\quad +2(3\\cdot 1-1\\cdot 2) \\\\ &=1(2)-3(5)+2(1) \\\\ &=2-15+2 \\\\ &=-11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186720212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b5d0ecc-100a-53e2-a99b-c4239757b44c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{2}{3}" :db/id #edb/ref 17592186720218}] :answer-field/correct {:answer/id #uuid "9b5d0ecc-100a-53e2-a99b-c4239757b44c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{2}{3}" :db/id #edb/ref 17592186720218} :answer-field/id #uuid "afafb779-b0d2-5f9e-bd96-a3ee3589f3ee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720220}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22443f90-dbb1-5da7-ab4f-0543d37b58ad" :question/problem "Find $\\mathbf{c}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{a}\\bigr)$, given $(\\sqrt{2}\\mathbf{a})\\cdot\\bigl(\\mathbf{b}\\times (3\\mathbf{c})\\bigr)=2 \\sqrt{2}$.\n\n$\\mathbf{c}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{a}\\bigr)=$ {{field-1}}" :question/worked-solution "Factor out the supplied scalar multipliers:\n\n$$\n\\begin{aligned}\n(\\sqrt{2}\\mathbf{a})\\cdot\\bigl(\\mathbf{b}\\times (3\\mathbf{c})\\bigr)&=2 \\sqrt{2} \\\\\n3 \\sqrt{2}\\bigl[\\mathbf{a}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{c}\\bigr)\\bigr]&=2 \\sqrt{2} \\\\\n\\mathbf{a}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{c}\\bigr)&=\\frac{2}{3}\n\\end{aligned}\n$$\n\nSwap $\\mathbf{a}$ and $\\mathbf{c}$; one swap reverses the sign:\n\n$$\n\\begin{aligned}\n\\mathbf{c}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{a}\\bigr)&=- \\frac{2}{3}\n\\end{aligned}\n$$\n\nThe requested scalar is $- \\frac{2}{3}$."}] [{:db/id #edb/ref 17592186720214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40fb536a-55b6-57cf-b921-2ad4e85ef1bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186720215}] :answer-field/correct {:answer/id #uuid "40fb536a-55b6-57cf-b921-2ad4e85ef1bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186720215} :answer-field/id #uuid "d61fd658-7032-5768-9115-1858a812bfad" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720222}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d9f3213-a21f-5bc8-935a-97bf919eb50d" :question/problem "Find $\\mathbf{b}\\cdot\\bigl(\\mathbf{a}\\times \\mathbf{c}\\bigr)$, given $(3\\mathbf{b})\\cdot\\bigl((-3\\mathbf{c})\\times (-3\\mathbf{a})\\bigr)=- \\frac{81}{2}$.\n\n$\\mathbf{b}\\cdot\\bigl(\\mathbf{a}\\times \\mathbf{c}\\bigr)=$ {{field-1}}" :question/worked-solution "Factor out the supplied scalar multipliers:\n\n$$\n\\begin{aligned}\n(3\\mathbf{b})\\cdot\\bigl((-3\\mathbf{c})\\times (-3\\mathbf{a})\\bigr)&=- \\frac{81}{2} \\\\\n27\\bigl[\\mathbf{b}\\cdot\\bigl(\\mathbf{c}\\times \\mathbf{a}\\bigr)\\bigr]&=- \\frac{81}{2} \\\\\n\\mathbf{b}\\cdot\\bigl(\\mathbf{c}\\times \\mathbf{a}\\bigr)&=- \\frac{3}{2}\n\\end{aligned}\n$$\n\nSwap $\\mathbf{c}$ and $\\mathbf{a}$; one swap reverses the sign:\n\n$$\n\\begin{aligned}\n\\mathbf{b}\\cdot\\bigl(\\mathbf{a}\\times \\mathbf{c}\\bigr)&=\\frac{3}{2}\n\\end{aligned}\n$$\n\nThe requested scalar is $\\frac{3}{2}$."}] [{:db/id #edb/ref 17592186720219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21cf3460-b040-5453-8dfd-2769fd45a078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186720211}] :answer-field/correct {:answer/id #uuid "21cf3460-b040-5453-8dfd-2769fd45a078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186720211} :answer-field/id #uuid "f148ee1d-a7ff-5722-b863-d3fd9ecb4d8b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720225}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a579d13a-3d54-55f0-9ef6-5795b849614e" :question/problem "Find $\\mathbf{b}\\cdot\\bigl(\\mathbf{c}\\times \\mathbf{a}\\bigr)$, given $(\\sqrt{2}\\mathbf{a})\\cdot\\bigl((-3\\mathbf{b})\\times \\mathbf{c}\\bigr)=- 9 \\sqrt{2}$.\n\n$\\mathbf{b}\\cdot\\bigl(\\mathbf{c}\\times \\mathbf{a}\\bigr)=$ {{field-1}}" :question/worked-solution "Factor out the supplied scalar multipliers:\n\n$$\n\\begin{aligned}\n(\\sqrt{2}\\mathbf{a})\\cdot\\bigl((-3\\mathbf{b})\\times \\mathbf{c}\\bigr)&=- 9 \\sqrt{2} \\\\\n- 3 \\sqrt{2}\\bigl[\\mathbf{a}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{c}\\bigr)\\bigr]&=- 9 \\sqrt{2} \\\\\n\\mathbf{a}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{c}\\bigr)&=3\n\\end{aligned}\n$$\n\nSwap $\\mathbf{a}$ and $\\mathbf{b}$; one swap reverses the sign:\n\n$$\n\\begin{aligned}\n\\mathbf{b}\\cdot\\bigl(\\mathbf{a}\\times \\mathbf{c}\\bigr)&=-3\n\\end{aligned}\n$$\n\nSwap $\\mathbf{a}$ and $\\mathbf{c}$; one swap reverses the sign:\n\n$$\n\\begin{aligned}\n\\mathbf{b}\\cdot\\bigl(\\mathbf{c}\\times \\mathbf{a}\\bigr)&=3\n\\end{aligned}\n$$\n\nThe requested scalar is $3$."}] [{:db/id #edb/ref 17592186720221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72b7ca6b-c209-54fb-9a9f-18aa57641c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186720216}] :answer-field/correct {:answer/id #uuid "72b7ca6b-c209-54fb-9a9f-18aa57641c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186720216} :answer-field/id #uuid "8777e1e6-7529-5ffc-9bf1-b946e986ade6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186720217}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3856a7f-000a-5303-8d5b-0d0fbe4199af" :question/problem "Suppose $\\mathbf{a}\\times \\mathbf{c}=\\langle -3,1,-4\\rangle$ and $\\mathbf{b}=\\langle 4,0,-2\\rangle$. Find $\\mathbf{c}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{a}\\bigr)$.\n\n$\\mathbf{c}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{a}\\bigr)=$ {{field-1}}" :question/worked-solution "First take the dot product with the remaining vector:\n\n$$\n\\begin{aligned}\n\\mathbf{b}\\cdot\\bigl(\\mathbf{a}\\times \\mathbf{c}\\bigr)&=\\langle 4,0,-2\\rangle\\cdot \\langle -3,1,-4\\rangle \\\\\n&=(4)\\cdot (-3)+(0)\\cdot (1)+(-2)\\cdot (-4) \\\\\n&=-4\n\\end{aligned}\n$$\n\nSwap $\\mathbf{b}$ and $\\mathbf{c}$; one swap reverses the sign:\n\n$$\n\\begin{aligned}\n\\mathbf{c}\\cdot\\bigl(\\mathbf{a}\\times \\mathbf{b}\\bigr)&=4\n\\end{aligned}\n$$\n\nSwap $\\mathbf{a}$ and $\\mathbf{b}$; one swap reverses the sign:\n\n$$\n\\begin{aligned}\n\\mathbf{c}\\cdot\\bigl(\\mathbf{b}\\times \\mathbf{a}\\bigr)&=-4\n\\end{aligned}\n$$\n\nThe requested scalar is $-4$."}]}
