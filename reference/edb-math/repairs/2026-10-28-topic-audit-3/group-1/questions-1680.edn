\sin \\theta \\cos \\theta - 5\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin \\theta(-8\\cos \\theta-5\\sin \\theta)-5\\cos^{2}\\theta = - 8 \\sin \\theta \\cos \\theta - 5.\n$$"}] [{:db/id #edb/ref 17592186556272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40b2bcf4-8bd7-5990-ac41-9d5442bc2b47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\sin^{2} x + 3 \\sin x \\cos x" :db/id #edb/ref 17592186556230} {:answer/id #uuid "72bea4c0-6f9f-5735-8ae6-e9701463acc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 \\sin x \\cos x - 2" :db/id #edb/ref 17592186556245} {:answer/id #uuid "a9038db8-656c-518e-a09f-f11ce349c120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sin x \\cos x + 2" :db/id #edb/ref 17592186556263} {:answer/id #uuid "ad1f31ad-9470-5bf4-a6e3-8df6339bf303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sin x \\cos x - 2" :db/id #edb/ref 17592186556266} {:answer/id #uuid "f900d442-55ca-5895-a040-548a963f8e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sin x \\cos x" :db/id #edb/ref 17592186556284}] :answer-field/correct {:answer/id #uuid "ad1f31ad-9470-5bf4-a6e3-8df6339bf303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sin x \\cos x - 2" :db/id #edb/ref 17592186556266} :answer-field/id #uuid "08c28f62-d1b0-5abf-9f86-c88664bc0796" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556211}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7cf30a6-2877-50f8-adda-e54fc976fd04" :question/problem "Simplify the trigonometric expression $\\sin x(3\\cos x-2\\sin x)-2\\cos^{2}x.$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\sin x(3\\cos x-2\\sin x)-2\\cos^{2}x = 3\\sin x\\cos x-2\\sin^{2}x-2\\cos^{2}x\n$$\n\nNext, we group the $\\sin^2 x$ and $\\cos^2 x$ terms.\n\n$$\n3\\sin x\\cos x-2\\sin^{2}x-2\\cos^{2}x = 3\\sin x\\cos x-2(\\sin^{2}x+\\cos^{2}x)\n$$\n\nThen, we use $\\sin^2{x}+\\cos^2{x}=1$ to simplify the expression in the parentheses:\n\n$$\n3\\sin x\\cos x-2(\\sin^{2}x+\\cos^{2}x) = 3 \\sin x \\cos x - 2\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin x(3\\cos x-2\\sin x)-2\\cos^{2}x = 3 \\sin x \\cos x - 2.\n$$"}] [{:db/id #edb/ref 17592186556280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e60b2d5-2bdb-536b-8bb5-09c967f533bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\sin \\theta \\cos \\theta - 3" :db/id #edb/ref 17592186556217} {:answer/id #uuid "2811975e-fe0a-5d37-97e7-f5af63a254e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 \\sin \\theta \\cos \\theta - 3" :db/id #edb/ref 17592186556221} {:answer/id #uuid "48470319-586c-5a21-8a06-d157208022fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 \\sin^{2} \\theta + 8 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556234} {:answer/id #uuid "568b15e2-19da-5c3f-a20b-5f2b69318ecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556238} {:answer/id #uuid "87190a69-181a-5cc5-aa3e-72359beeff9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\sin \\theta \\cos \\theta + 3" :db/id #edb/ref 17592186556251}] :answer-field/correct {:answer/id #uuid "1e60b2d5-2bdb-536b-8bb5-09c967f533bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\sin \\theta \\cos \\theta - 3" :db/id #edb/ref 17592186556217} :answer-field/id #uuid "72bdf20f-4f77-502a-b624-a3f