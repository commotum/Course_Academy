ition."}] [{:db/id #edb/ref 17592186719058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3342ec10-d221-5bf4-b2ef-b2c7e77d34c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186719046} {:answer/id #uuid "54705e99-9c90-52fe-aab3-8be7b2eceb4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186719051} {:answer/id #uuid "5af7256d-3273-532b-aec1-2312c9889983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186719052} {:answer/id #uuid "d43a0096-b21f-5d5a-a131-8e324f335e1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186719062} {:answer/id #uuid "fc749959-1748-5d98-a087-8fc047b4299a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186719067}] :answer-field/correct {:answer/id #uuid "5af7256d-3273-532b-aec1-2312c9889983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186719052} :answer-field/id #uuid "474c6079-3210-5163-9c06-b1486c75b594" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719050}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2a090b6-4ceb-51c5-beb2-ec8c6aa47478" :question/problem "Consider the vector field\n$$\n\\begin{aligned}\\mathbf F&=\\bigl(a^{2} x y^{2}\\bigr)\\,\\mathbf i \\\\ &{}+\\bigl(9 x^{2} y\\bigr)\\,\\mathbf j\\end{aligned}\n$$\non $\\mathbb R^2$, where $a$ is a negative constant. Given that $\\mathbf F$ is conservative, find $a$." :question/worked-solution "Write $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$. Both components have continuous first partial derivatives on $\\mathbb R^2$. On this domain, the conservative-field test is $P_y=Q_x$ everywhere.\n\nThe required partial derivatives are\n$$\n\\begin{aligned}P_y&=2 a^{2} x y \\\\ Q_x&=18 x y\\end{aligned}\n$$\n\nThe derivative equality must hold everywhere, including points where $xy\\ne0$. Hence\n$$\n\\begin{aligned}a^{2}&=9 \\\\ a^2&=9 \\\\ a&=-3\\quad\\text{or}\\quad a=3\\end{aligned}\n$$\nThe prompt requires $a$ to be negative, so $a=-3$.\n\nAt $a=-3$, the two displayed partial derivatives agree everywhere, so this value satisfies the conservative-field condition."}] [{:db/id #edb/ref 17592186719063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07886627-409e-57e1-93c2-d13500676b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186719043} {:answer/id #uuid "4531bc0c-13db-510e-949b-5553096adcfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3}{4}" :db/id #edb/ref 17592186719049} {:answer/id #uuid "ea50bad6-7099-59ab-b208-7356af3e7a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186719064} {:answer/id #uuid "f28456eb-4fd5-5099-a86a-8fcbcf8aae43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186719066} {:answer/id #uuid "ff9f3508-79db-5626-b7ea-b413ee25d509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186719068}] :answer-field/correct {:answer/id #uuid "ff9f3508-79db-5626-b7ea-b413ee25d509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186719068} :answer-field/id #uuid "98ba49b1-2894-55f5-8c4d-a14d9fc12945" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719055}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e3089f7c-54e5-5739-86c0-de5951005615" :question/problem "Consider the vector field\n$$\n\\begin{aligned}\\mathbf F&=\\bigl(4 a^{2} x y^{2}\\bigr)\\,\\mathbf i \\\\ &{}+\\bigl(9 x^{2} y\\bigr)\\,\\mathbf j\\end{aligned}\n$$\non $\\mathbb R^2$, where $a$ is a negative constant. Given that $\\mathbf F$ is conservative, find $a$." :question/worked-solution "Write $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$. Both components have continuous first partial derivatives on $\\mathbb R^2$. On this domain, the conservative-field test is $P_y=Q_x$ everywhere.\n\nThe required partial derivatives are\n$$\n\\begin{aligned}P_y&=8 a^{2} x y \\\\ Q_x&=18 x y\\end{aligned}\n$$\n\nThe derivative equality must hold everywhere, including points where $xy\\ne0$. Hence\n$$\n\\begin{aligned}4 a^{2}&=9 \\\\ a^2&=\\frac{9}{4} \\\\ a&=- \\frac{3}{2}\\quad\\text{or}\\quad a=\\frac{3}{2}\\end{aligned}\n$$\nThe prompt requires $a$ to be negative, so $a=- \\frac{3}{2}$.\n\nAt $a=- \\frac{3}{2}$, the two displayed partial derivatives agree everywhere, so this value satisfies the conservative-field condition."}] [{:db/id #edb/ref 17592186719885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "125cb1d1-0876-564a-a10d-8ef0e921b2c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt5}{3}" :db/id #edb/ref 17592186719880} {:answer/id #uuid "7607e56d-8968-5f0c-b63e-a8146bd86e36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac73" :db/id #edb/ref 17592186719886} {:answer/id #uuid "88f78746-ea77-5875-816b-236c9be048f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt2}{3}" :db/id #edb/ref 17592186719889} {:answer/id #uuid "a0c998b8-a5f8-589e-9251-80dea3a8721d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt5" :db/id #edb/ref 17592186719891} {:answer/id #uuid "e919b0d3-8d52-5b12-87f3-743d12581c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5}{3}" :db/id #edb/ref 17592186719898}] :answer-field/correct {:answer/id #uuid "125cb1d1-0876-564a-a10d-8ef0e921b2c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt5}{3}" :db/id #edb/ref 17592186719880} :answer-field/id #uuid "b46cd4b3-59f5-50ac-9172-d9359f9a5f86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719894}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75baea9c-071b-5682-9626-7ed4209b85b9" :question/problem "Evaluate the scalar line integral\n\n$$\n\\int_C (x^2+y)\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is given by $y=2x+1$ for $0\\le x\\le 1$." :question/worked-solution "Set $x=t$ and substitute the line equation:\n\n$$\n\\mathbf r(t)=\\langle t,2t+1\\rangle,\\qquad 0\\le t\\le 1.\n$$\n\nThen\n\n$$\n\\mathbf r'(t)=\\langle 1,2\\rangle,\\qquad \\|\\mathbf r'(t)\\|=\\sqrt{1+4}=\\sqrt5.\n$$\n\nSubstitute both coordinates into the scalar function:\n\n$$\nf(\\mathbf r(t))=t^2+(2t+1)=t^2+2t+1.\n$$\n\nMultiply by the speed and integrate each term:\n\n$$\n\\begin{aligned}\n\\int_C (x^2+y)\\,\\mathrm{d}s\n&=\\int_0^1 f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t\\\\\n&=\\sqrt5\\int_0^1(t^2+2t+1)\\,\\mathrm{d}t\\\\\n&=\\sqrt5\\left[\\frac{t^3}{3}+t^2+t\\right]_0^1\\\\\n&=\\sqrt5\\left(\\frac13+1+1\\right)\\\\\n&=\\frac{7\\sqrt5}{3}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4383d66a-a7ea-5d69-939f-bdf597b21f2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac52" :db/id #edb/ref 17592186719883} {:answer/id #uuid "5328144c-ded3-524b-b6d9-3867b37d71f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt5}{2}" :db/id #edb/ref 17592186719884} {:answer/id #uuid "a22fabe7-42d4-5231-a35b-eb88e7457f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186719892} {:answer/id #uuid "c9a4c228-1bbf-591f-a858-79ebd17f5735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt5" :db/id #edb/ref 17592186719896} {:answer/id #uuid "cd6da0dc-ad7b-582a-a1d9-92b854386942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac12" :db/id #edb/ref 17592186719897}] :answer-field/correct {:answer/id #uuid "5328144c-ded3-524b-b6d9-3867b37d71f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt5}{2}" :db/id #edb/ref 17592186719884} :answer-field/id #uuid "3ba0b7d7-2010-517f-9848-61358856a692" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7211eba-f216-5dc1-a857-f32df58755da" :question/problem "Evaluate the scalar line integral\n\n$$\n\\int_C x\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is given by $y=2x$ for $0\\le x\\le 1$." :question/worked-solution "Set $x=t$. The explicit equation gives\n\n$$\n\\mathbf r(t)=\\langle t,2t\\rangle,\\qquad 0\\le t\\le 1.\n$$\n\nDifferentiate the curve and compute its speed:\n\n$$\n\\mathbf r'(t)=\\langle 1,2\\rangle,\\qquad \\|\\mathbf r'(t)\\|=\\sqrt{1^2+2^2}=\\sqrt5.\n$$\n\nThe scalar function is $f(x,y)=x$, so $f(\\mathbf r(t))=t$. Include the speed factor when replacing $\\mathrm{d}s$:\n\n$$\n\\begin{aligned}\n\\int_C x\\,\\mathrm{d}s\n&=\\int_0^1 f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t\\\\\n&=\\sqrt5\\int_0^1 t\\,\\mathrm{d}t\\\\\n&=\\sqrt5\\left[\\frac{t^2}{2}\\right]_0^1\\\\\n&=\\frac{\\sqrt5}{2}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8a9084-886c-5e81-ad3f-58be42f086e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt5-4\\sqrt2" :db/id #edb/ref 17592186719879} {:answer/id #uuid "3a2e1bc5-58cc-556f-9ada-3cc3b10fcbfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt5-2\\sqrt2}{3}" :db/id #edb/ref 17592186719881} {:answer/id #uuid "7a0c7629-f0fc-59ac-b31b-8226aa94e992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186719887} {:answer/id #uuid "83631dc4-2cbb-5b67-a448-4ed6f3521c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt5-4\\sqrt2}{3}" :db/id #edb/ref 17592186719888} {:answer/id #uuid "a6a577b7-0301-50e7-b76a-ea26859f48d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt5}{3}" :db/id #edb/ref 17592186719893}] :answer-field/correct {:answer/id #uuid "83631dc4-2cbb-5b67-a448-4ed6f3521c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt5-4\\sqrt2}{3}" :db/id #edb/ref 17592186719888} :answer-field/id #uuid "9aad02a5-8f1a-5be2-856f-8563195e3d24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719890}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fbd2130a-9472-58f9-b37a-dd6952bd36a9" :question/problem "Evaluate the scalar line integral\n\n$$\n\\int_C 2y^2\\,\\mathrm{d}s,\n$$\n\nwhere $C$ is given by $y=e^x$ for $0\\le x\\le\\ln 2$." :question/worked-solution "Use the explicit curve to set\n\n$$\n\\mathbf r(t)=\\langle t,e^t\\rangle,\\qquad 0\\le t\\le\\ln2.\n$$\n\nThe speed is now variable:\n\n$$\n\\mathbf r'(t)=\\langle1,e^t\\rangle,\\qquad \\|\\mathbf r'(t)\\|=\\sqrt{1+e^{2t}}.\n$$\n\nSince $f(\\mathbf r(t))=2e^{2t}$, the line integral becomes\n\n$$\n\\int_C 2y^2\\,\\mathrm{d}s=\\int_0^{\\ln2}2e^{2t}\\sqrt{1+e^{2t}}\\,\\mathrm{d}t.\n$$\n\nChoose $u=1+e^{2t}$, so $\\mathrm{d}u=2e^{2t}\\,\\mathrm{d}t$. The bounds change from $t=0$ and $t=\\ln2$ to $u=2$ and $u=5$:\n\n$$\n\\begin{aligned}\n\\int_C 2y^2\\,\\mathrm{d}s\n&=\\int_2^5 u^{1/2}\\,\\mathrm{d}u\\\\\n&=\\left[\\frac23u^{3/2}\\right]_2^5\\\\\n&=\\frac23(5\\sqrt5-2\\sqrt2)\\\\\n&=\\frac{10\\sqrt5-4\\sqrt2}{3}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b6446b-361e-5090-9a35-a16b43f3719b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186719903}] :answer-field/correct {:answer/id #uuid "04b6446b-361e-5090-9a35-a16b43f3719b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186719903} :answer-field/id #uuid "0b13527b-95a3-5e28-b70c-a3104cf04dfb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719904}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "256b8078-d1b6-54e1-973b-d6bf90b2c2a2" :question/problem "Let $\\mathbf{a}=\\langle1,-2,1\\rangle$, $\\mathbf{b}=\\langle2,1,-1\\rangle$, and $\\mathbf{c}=\\langle-1,2,3\\rangle$. Find $\\mathbf{c}\\cdot(\\mathbf{b}\\times\\mathbf{a})$ using the definition of the scalar triple product.\n\n$\\mathbf{c}\\cdot(\\mathbf{b}\\times\\mathbf{a})=$\n{{field-1}}" :question/worked-solution "The requested cross product is $\\mathbf{b}\\times\\mathbf{a}$, and the vector outside the dot product is $\\mathbf{c}$.\n\nFirst, compute the cross product in the requested order:\n\n$$\n\\begin{aligned}\n\\mathbf{b}\\times\\mathbf{a}\n&=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\2&1&-1\\\\1&-2&1\\end{vmatrix}\\\\\n&=\\begin{vmatrix}1&-1\\\\-2&1\\end{vmatrix}\\mathbf{i}\n-\\begin{vmatrix}2&-1\\\\1&1\\end{vmatrix}\\mathbf{j}\n+\\begin{vmatrix}2&1\\\\1&-2\\end{vmatrix}\\mathbf{k}\\\\\n&=(1(1)-(-1)(-2))\\mathbf{i}\\\\\n&\\quad -(2(1)-(-1)(1))\\mathbf{j}\\\\\n&\\quad +(2(-2)-1(1))\\mathbf{k}\\\\\n&=-\\mathbf{i}-3\\mathbf{j}-5\\mathbf{k}\\\\\n&=\\langle-1,-3,-5\\rangle.\n\\end{aligned}\n$$\n\nThen take the dot product with $\\mathbf{c}$:\n\n$$\n\\begin{aligned}\n\\mathbf{c}\\cdot(\\mathbf{b}\\times\\mathbf{a})\n&=\\langle-1,2,3\\rangle\\cdot\\langle-1,-3,-5\\rangle\\\\\n&=(-1)(-1)+2(-3)+3(-5)\\\\\n&=1-6-15\\\\\n&=-20.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04762634-883e-5cf9-84d6-15c188c14d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186719902} {:answer/id #uuid "9cd0f91a-912a-5095-8861-44148e19b79a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186719909} {:answer/id #uuid "a088c779-100b-52fb-ad88-55f6c521eb3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186719910} {:answer/id #uuid "c96a953f-78d8-5601-b9dd-a78a09137327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186719912} {:answer/id #uuid "e0d135c5-2e75-5397-8975-61bdf2d2eba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186719914}] :answer-field/correct {:answer/id #uuid "9cd0f91a-912a-5095-8861-44148e19b79a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186719909} :answer-field/id #uuid "c80f95ed-2371-500c-b5e6-cdd607ef3770" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ea78c15-c061-587a-b07e-1c464fb3ec0b" :question/problem "Find $\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})$ given that $\\mathbf{a}=\\langle-2,0,3\\rangle$ and $\\mathbf{b}\\times\\mathbf{c}=\\langle1,-3,2\\rangle$." :question/worked-solution "The cross product is supplied, so take its dot product with $\\mathbf{a}$:\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})\n&=\\langle-2,0,3\\rangle\\cdot\\langle1,-3,2\\rangle\\\\\n&=(-2)(1)+0(-3)+3(2)\\\\\n&=-2+0+6\\\\\n&=4.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93114248-3edc-54ce-a7b9-fd48796b3818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186719908} {:answer/id #uuid "d5737c60-406c-519a-9e2f-8b53d87e6811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186719913} {:answer/id #uuid "e1abaabd-9cf0-59bf-975a-f4096212588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186719915} {:answer/id #uuid "e71b1a9d-d000-5c10-98ff-e3228344059c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186719916} {:answer/id #uuid "fc74f3be-3af6-51e8-8f44-cf2457c3fd13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186719918}] :answer-field/correct {:answer/id #uuid "e1abaabd-9cf0-59bf-975a-f4096212588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186719915} :answer-field/id #uuid "8c71902b-02f0-56ad-8937-4c0cc1d220ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb1b1be2-ba6b-50c6-b6d0-d05c3f174824" :question/problem "Given that $\\mathbf{a}=\\langle0,-1,2\\rangle$, $\\mathbf{b}=\\langle1,0,2\\rangle$, and $\\mathbf{c}=\\langle2,1,-1\\rangle$, find $\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})$ using the definition of the scalar triple product." :question/worked-solution "First, find the cross product:\n\n$$\n\\begin{aligned}\n\\mathbf{b}\\times\\mathbf{c}\n&=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\1&0&2\\\\2&1&-1\\end{vmatrix}\\\\\n&=\\begin{vmatrix}0&2\\\\1&-1\\end{vmatrix}\\mathbf{i}\n-\\begin{vmatrix}1&2\\\\2&-1\\end{vmatrix}\\mathbf{j}\n+\\begin{vmatrix}1&0\\\\2&1\\end{vmatrix}\\mathbf{k}\\\\\n&=(0(-1)-2(1))\\mathbf{i}\\\\\n&\\quad -(1(-1)-2(2))\\mathbf{j}\\\\\n&\\quad +(1(1)-0(2))\\mathbf{k}\\\\\n&=-2\\mathbf{i}+5\\mathbf{j}+\\mathbf{k}\\\\\n&=\\langle-2,5,1\\rangle.\n\\end{aligned}\n$$\n\nNow take the dot product with $\\mathbf{a}$:\n\n$$\n\\begin{aligned}\n\\mathbf{a}\\cdot(\\mathbf{b}\\times\\mathbf{c})\n&=\\langle0,-1,2\\rangle\\cdot\\langle-2,5,1\\rangle\\\\\n&=0(-2)+(-1)(5)+2(1)\\\\\n&=-5+2\\\\\n&=-3.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719923 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Multiply the substituted scalar function by $\\sqrt{1+4t^2/(1+t^2)^2}$." :answer/id #uuid "1817f82b-ed89-511b-b95f-b4f45711ded3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\,\\mathrm{d}t" :db/id #edb/ref 17592186719922} {:answer/feedback "The limits must be $x$-values, so solve the two intersection equations on $x>0$." :answer/id #uuid "31ff03b8-513e-5017-b74f-717278bc3843" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\ln 2}^{\\ln 5}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719924} {:answer/feedback "The derivative of $\\ln(1+t^2)$ is $2t/(1+t^2)$; include the chain-rule numerator before squaring." :answer/id #uuid "5b036e1c-54f1-52c5-9ab3-3fe42d44180f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{1}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719929} {:answer/feedback "The term $-y$ becomes $-\\ln(1+t^2)$, not $-t$." :answer/id #uuid "8ad73a1f-27e6-5a0a-b7fa-eb924b99b4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-t\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719933} {:answer/feedback "The bounds, substituted scalar function, and chain-rule arc-length factor all agree." :answer/id #uuid "fe1fbd3a-53ae-5464-93d4-ea7d4ac1f066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719939}] :answer-field/correct {:answer/feedback "The bounds, substituted scalar function, and chain-rule arc-length factor all agree." :answer/id #uuid "fe1fbd3a-53ae-5464-93d4-ea7d4ac1f066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{2}\\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719939} :answer-field/id #uuid "32abb9f9-7012-5acc-ae7c-2c2c4a986304" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719925}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2e3c3751-618f-50e6-9923-928dc577ad92" :question/problem "Let $C$ be the portion of $y=\\ln(1+x^2)$ with $x>0$ between its intersections with the horizontal lines $y=\\ln 2$ and $y=\\ln 5$.\n\nWhich definite integral is equivalent to\n\n$$\n\\int_C \\left(xe^y-y\\right)\\,\\mathrm{d}s\n$$\n\nusing $x=t$? Do not evaluate the integral." :question/worked-solution "Use the horizontal lines to find the endpoints. Since $x>0$,\n\n$$\n\\begin{aligned}\n\\ln(1+x^2)=\\ln 2&\\implies 1+x^2=2\\implies x=1,\\\\\n\\ln(1+x^2)=\\ln 5&\\implies 1+x^2=5\\implies x=2.\n\\end{aligned}\n$$\n\nThe positive branch is increasing, so these intersections bound one section. Parametrize it by\n\n$$\n\\mathbf r(t)=\\langle t,\\ln(1+t^2)\\rangle,\\qquad 1\\le t\\le 2.\n$$\n\nApply the chain rule before forming the arc-length factor:\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\left\\langle 1,\\frac{2t}{1+t^2}\\right\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{1+\\left(\\frac{2t}{1+t^2}\\right)^2}\n=\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}.\n\\end{aligned}\n$$\n\nSubstitute both coordinates into $f(x,y)=xe^y-y$. Using $e^{\\ln(1+t^2)}=1+t^2$ gives\n\n$$\n\\begin{aligned}\nf(\\mathbf r(t))\n&=t e^{\\ln(1+t^2)}-\\ln(1+t^2)\\\\\n&=t(1+t^2)-\\ln(1+t^2).\n\\end{aligned}\n$$\n\nFinally, multiply the scalar by the speed and use the $t=x$ bounds:\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s\n=\\int_1^2 f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t.\n$$\n\nSubstituting gives the required definite integral:\n\n$$\n\\int_1^2 \\left[t(1+t^2)-\\ln(1+t^2)\\right]\\sqrt{1+\\frac{4t^2}{(1+t^2)^2}}\\,\\mathrm{d}t.\n$$"}] [{:db/id #edb/ref 17592186719931 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The scalar function $xy$ becomes $t e^t$, including the factor $t$." :answer/id #uuid "0b7c2c1f-1ad8-5d1d-a96f-83c30156ed7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719919} {:answer/feedback "This substitutes $xy$ but omits the arc-length factor." :answer/id #uuid "11bbeb2a-1671-5b35-85cf-23626415a0a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}t e^t\\,\\mathrm{d}t" :db/id #edb/ref 17592186719921} {:answer/feedback "The $x$-bounds are $0$ and $1$, the scalar is $t e^t$, and the speed is $\\sqrt{1+e^{2t}}$." :answer/id #uuid "38e1aa11-85c7-5716-b196-b8f5d5ed748c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}t e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719926} {:answer/feedback "Square $y\\,\\!{}^{\\prime}(t)=e^t$ inside the speed: $(e^t)^2=e^{2t}$." :answer/id #uuid "630e0e3d-46a0-5a62-9ae9-6dfdbc56ab52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}t e^t\\sqrt{1+e^t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719930} {:answer/feedback "For $t=x$, solve $e^x=1$ and $e^x=e$; the limits are $0$ and $1$." :answer/id #uuid "b62da8ea-00f1-5f21-b33b-ede7fb8720de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e}t e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719936}] :answer-field/correct {:answer/feedback "The $x$-bounds are $0$ and $1$, the scalar is $t e^t$, and the speed is $\\sqrt{1+e^{2t}}$." :answer/id #uuid "38e1aa11-85c7-5716-b196-b8f5d5ed748c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}t e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186719926} :answer-field/id #uuid "46f262dc-9b17-5813-9cad-0f9a228f22a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186719928}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63ade182-b0e5-5450-99db-8320491afb4e" :question/problem "Let $C$ be the section of $y=e^x$ between its intersections with the horizontal lines $y=1$ and $y=e$.\n\nWhich definite integral is equivalent to\n\n$$\n\\int_C xy\\,\\mathrm{d}s\n$$\n\nusing $x=t$? Do not evaluate the integral." :question/worked-solution "First find the $x$-coordinates of the intersections:\n\n$$\n\\begin{aligned}\ne^x=1&\\implies x=0,\\\\\ne^x=e&\\implies x=1.\n\\end{aligned}\n$$\n\nThus $\\mathbf r(t)=\\langle t,e^t\\rangle$ for $0\\le t\\le 1$. Differentiating gives\n\n$$\n\\begin{aligned}\n\\mathbf r'(t)&=\\langle 1,e^t\\rangle,\\\\\n\\|\\mathbf r'(t)\\|&=\\sqrt{1+(e^t)^2}=\\sqrt{1+e^{2t}}.\n\\end{aligned}\n$$\n\nSubstitute both coordinates into $f(x,y)=xy$:\n\n$$\nf(\\mathbf r(t))=t e^t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int_C xy\\,\\mathrm{d}s\n&=\\int_0^1 f(\\mathbf r(t))\\|\\mathbf r'(t)\\|\\,\\mathrm{d}t\\\\\n&=\\int_0^1 t e^t\\sqrt{1+e^{2t}}\\,\\mathrm{d}t.\n\\end{aligned}\n$$\n\nThe horizontal lines supply $y$-values; they are not the limits when $t=x$."}]}
