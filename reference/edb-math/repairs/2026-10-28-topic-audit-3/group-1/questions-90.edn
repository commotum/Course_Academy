ype/math} :answer/value "x > 6" :db/id #edb/ref 17592186084924} {:answer/id #uuid "78cddf61-66f0-5dd7-acbe-c9eb4b6a1bd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x \\le - 4" :db/id #edb/ref 17592186084925}] :answer-field/id #uuid "f4214e40-b614-5435-bc11-5fb80952a34c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084920}] :question/id #uuid "105e48e2-d41e-5a20-8724-87cae30a3d12" :question/math-academy-id "q-16205" :question/problem "Given that a curve is defined parametrically as\n$$\n\\displaystyle x = t^{2} - 4t, y = t^{2}, t ∈ (- ∞, ∞),\n$$\ndetermine the range of $x$."}] [{:db/id #edb/ref 17592186088269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5c9c6f1-88a9-5814-8d7f-824388fe769d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186086269} {:answer/id #uuid "c95ef482-a715-5d27-8322-272d06aefa28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186086270} {:answer/id #uuid "dd13ebf0-fcc4-5780-a2ef-c58a92669901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186086271} {:answer/id #uuid "3ae5b9a5-e0be-5b47-b2de-3e04a707aebe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186086272} {:answer/id #uuid "70b93ffd-0a6c-5e4b-a149-c7a58e10d173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186086273}] :answer-field/id #uuid "155c89c2-1972-5fdf-8d50-c32635afc935" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086268}] :question/id #uuid "5cc3bc31-0264-5908-8539-6e444261bf21" :question/math-academy-id "q-6827" :question/problem "For the parametric curve\n$$\n\\displaystyle x = t^{2} + t, y = t^{2} - t,-4 \\le t \\le 4,\n$$\nconsider the following table of values:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$a$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$c$</td>\n<td data-cell-align=\"center\">$20$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$20$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$b$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$12$</td>\n</tr>\n</tbody></table></div>\n\n\nFind the value of $a + b + c$."}] [{:db/id #edb/ref 17592186088270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c987a4c-ef82-50f8-9c2f-24369b52299f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333562} {:answer/id #uuid "448c0861-60dc-5277-abf0-6324c4313b9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186333623} {:answer/id #uuid "4ec62518-f2da-54a6-b78e-7803c2af25ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333712} {:answer/id #uuid "4f618bb1-1a30-5478-b04d-5d8c290174ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333716} {:answer/id #uuid "cc14822b-2861-53db-8d57-7b85cd391a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186334768}] :answer-field/correct {:answer/id #uuid "3c987a4c-ef82-50f8-9c2f-24369b52299f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333562} :answer-field/id #uuid "e19de855-513e-569d-b86d-f599dde05f25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2efd117e-aa4e-5314-8b1b-8bd86f2a35c1" :question/math-academy-id "q-6834" :question/problem "For the parametric curve\n\n$$\nx={t}^{2}-4,\\,\\,\\,y=\\frac{5}{2}-\\frac{t}{2},\\,-1\\le t\\le 5,\n$$\n\nconsider the following table of values:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$5$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$a$</td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$21$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\frac{5}{2}$</td>\n<td data-cell-align=\"center\">$b$</td>\n<td data-cell-align=\"center\">$\\frac{3}{2}$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$\\frac{1}{2}$</td>\n<td data-cell-align=\"center\">$c$</td>\n</tr>\n</tbody></table></div>\n\n\n$$\n\n$$\n\nFind the value of $a-b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-1$ into $x={t}^{2}-4.$ This gives\n\n$$\na=(-1)^{2}-4=1-4=-3.\n$$\n\n- To find the value of $b,$ we substitute $t=1$ into $y=\\frac{5}{2}-\\frac{t}{2}.$ This gives\n\n$$\nb=\\frac{5}{2}-\\frac{1}{2}=\\frac{4}{2}=2.\n$$\n\n- To find the value of $c,$ we substitute $t=5$ into $y=\\frac{5}{2}-\\frac{t}{2}.$ This gives\n\n$$\nc=\\frac{5}{2}-\\frac{5}{2}=0.\n$$\n\nFinally, we have\n\n$$\na-b+c=-3-2+0=-5.\n$$"}] [{:db/id #edb/ref 17592186088272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4e3ff7-0f56-5670-968d-942fa26f266b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=9" :db/id #edb/ref 17592186333116} {:answer/id #uuid "57b7ce5d-ec6b-5250-87a2-d5986283a00b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=3" :db/id #edb/ref 17592186333790} {:answer/id #uuid "743a1c09-f9a8-5517-b74f-0ae55c1bb3ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{3}" :db/id #edb/ref 17592186334038} {:answer/id #uuid "85baee00-733f-595d-aeb8-248060ee0eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=3" :db/id #edb/ref 17592186334179} {:answer/id #uuid "a77f4060-9ba3-5f34-8f8a-5b05fd704d8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=9" :db/id #edb/ref 17592186334457}] :answer-field/correct {:answer/id #uuid "a77f4060-9ba3-5f34-8f8a-5b05fd704d8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=9" :db/id #edb/ref 17592186334457} :answer-field/id #uuid "cd786231-9ee2-54a9-ac19-aa1cf56c5c9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335616}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0e86c521-0742-549b-8e0a-9a85599dcb9d" :question/math-academy-id "q-6879" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =3\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & =(3\\operatorname{cos}⁡\\theta )^{2} \\\\  & =9{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =3\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & =(3\\operatorname{sin}⁡\\theta )^{2} \\\\  & =9{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =9{cos}^{2}⁡\\theta +9{sin}^{2}⁡\\theta  \\\\  & =9({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =9(1) \\\\  & =9.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=9.$"}] [{:db/id #edb/ref 17592186088281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86dadee3-7d6d-5185-ab3b-b85a361a52e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0 \\le x \\le 4, 2 \\le y \\le 4" :db/id #edb/ref 17592186086341} {:answer/id #uuid "d5399094-f398-56ed-9f79-a44406253676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4 \\le x \\le - 2,-4 \\le y \\le 0" :db/id #edb/ref 17592186086342} {:answer/id #uuid "45d78f20-324c-515d-a7d7-5a8cca623062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4 \\le x \\le 0,-2 \\le y \\le 4" :db/id #edb/ref 17592186086343} {:answer/id #uuid "49999e5c-859b-52f5-9853-47952d52774d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4 \\le x \\le 2, 0 \\le y \\le 4" :db/id #edb/ref 17592186086344} {:answer/id #uuid "6f7a3f21-dc25-5a43-bc94-3ffe87b345a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\le x \\le 4, 0 \\le y \\le 4" :db/id #edb/ref 17592186086345}] :answer-field/id #uuid "5333b62b-8f5a-5314-ac5f-0d3282feeb1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086340}] :question/id #uuid "355799f7-9ac6-525e-ab74-a660990999e5" :question/math-academy-id "q-70341" :question/problem "Given that a curve is defined parametrically as\n$$\n\\displaystyle x = 3\\cos θ - 1, y = 2\\sin θ + 2, 0 \\le θ < 2π,\n$$\nwhat are the ranges of $x$ and $y$?"}] [{:db/id #edb/ref 17592186088354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03898ee4-2fe1-5289-89b7-d7825da9af1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta +3,\\,y=\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186345382} {:answer/id #uuid "2c19faee-7736-5b38-aaa9-fa4e748fbab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta -2,\\,y=\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186345743} {:answer/id #uuid "61b0ef17-40e8-5074-9f48-04b57cf4524a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta -3,\\,y=\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186346200} {:answer/id #uuid "ba348fb3-af04-5bb6-90e0-5a30c43dab75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta +2,\\,y=\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186346970} {:answer/id #uuid "f2399757-daba-5cac-a3ff-9b7db3fa15d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +1,\\,y=2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186347494}] :answer-field/correct {:answer/id #uuid "03898ee4-2fe1-5289-89b7-d7825da9af1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta +3,\\,y=\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186345382} :answer-field/id #uuid "93ef0cff-67a0-543a-a422-99a73bf3929a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347864}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fbe63a7d-d4cb-5598-8edc-e441310edc62" :question/math-academy-id "q-78204" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $1$ centered at the point $(3,2)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, we have a circle of radius $1$ centered at the point $(3,2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=\\operatorname{cos}⁡\\theta +3,\\,y=\\operatorname{sin}⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186088355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86fe87b2-1a29-514a-a9ac-dc3d112601b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 8\\cos θ + 2, y = 8\\sin θ - 4" :db/id #edb/ref 17592186086784} {:answer/id #uuid "c398c05e-f448-56ee-b77e-39a233b8ec93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 2\\cos θ - 1, y = 2\\sin θ + 2" :db/id #edb/ref 17592186086785} {:answer/id #uuid "f494b146-ee7b-5a88-8454-86ca6ef09d22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 2\\sin θ - 1, y = 2\\cos θ + 2" :db/id #edb/ref 17592186086786} {:answer/id #uuid "fc5ac71e-b176-5974-b918-42f96e049f19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 4\\cos θ - 1, y = 4\\sin θ + 2" :db/id #edb/ref 17592186086787} {:answer/id #uuid "1da49f45-a0a9-5fc2-bddf-eea16266efa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 4\\sin θ - 1, y = 4\\cos θ + 2" :db/id #edb/ref 17592186086788}] :answer-field/id #uuid "5ce892d5-8689-5495-aab0-0fd1245afd68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086783}] :question/id #uuid "2e73cbbe-2cd3-5191-8a77-e313eca872b8" :question/math-academy-id "q-78205" :question/problem "![](images/d6/d63963154e858da324418ef8f29aa8e4f309355b7cd6ad105a89f96506027248.png)\n\nConsider the circle of radius $2$ centered at $(-1, 2)$, as shown above. Which of the following sets of parametric equations, defined for $θ ∈ [0, 2π)$, traverse the circle once in the counterclockwise direction starting at the point $A(1, 2)$?"}] [{:db/id #edb/ref 17592186088362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa7d468-de7c-538e-9bba-c5e80bfff308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186345434} {:answer/id #uuid "c2e290fc-d418-57b7-a936-1d5bb9c090a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186347037} {:answer/id #uuid "c3e73f0f-1975-59bc-be4d-1ebab1b85f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,2\\pi )" :db/id #edb/ref 17592186347044} {:answer/id #uuid "c561f9d3-b982-54c5-9bf9-a1d1c261a046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [-\\pi ,\\pi ]" :db/id #edb/ref 17592186347063} {:answer/id #uuid "cb9bc121-8232-58b0-9c4f-7d9f5b035ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}]" :db/id #edb/ref 17592186347132}] :answer-field/correct {:answer/id #uuid "c2e290fc-d418-57b7-a936-1d5bb9c090a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186347037} :answer-field/id #uuid "9453e605-100c-5927-be9f-cb25cd1764f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347866}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9ceb55c-d1e9-5689-8032-0bd11852d402" :question/math-academy-id "q-78681" :question/problem "![](images/dd/dd128890a13c0aa79d293b70063eeb8b78e07f56dd42774699d1b2f32e43dd0d.png)\n\nThe semi-circle above is defined by the parametric equations \n\n$$\nx=7\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=7.$ So, the parametric equations of the *full* circle are \n\n$$\nx=7\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a semi-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](images/25/25503e83f9a196cab4ded2fd93b09028b1608bd7d815edd538564e1aa611ca86.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\pi ]$, we get the required semi-circle.\n\nTherefore, the parametric equations of the semi-circle are \n\n$$\nx=7\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\pi ].\n$$"}] [{:db/id #edb/ref 17592186088368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81e0a424-b736-5058-af3b-179a4f1c36fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "θ ∈ [\\frac{3π}{2}, 2π]" :db/id #edb/ref 17592186086862} {:answer/id #uuid "1f00e912-8e79-5ade-8890-89c2f9d63c60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "θ ∈ [0, \\frac{π}{2}]" :db/id #edb/ref 17592186086863} {:answer/id #uuid "2ec9172f-11d3-5964-aacb-5b847bdd3ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "θ ∈ [π, \\frac{3π}{2}]" :db/id #edb/ref 17592186086864} {:answer/id #uuid "37e81c31-d8cf-5c30-b3b1-0c7a6864c484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "θ ∈ [0, \\frac{3π}{2}]" :db/id #edb/ref 17592186086865} {:answer/id #uuid "467d6f5f-eb4e-5c70-af7f-ae8a5fe48a0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "θ ∈ [\\frac{π}{2}, \\frac{3π}{2}]" :db/id #edb/ref 17592186086866}] :answer-field/id #uuid "0ea94950-6949-5614-ae16-91372b0db7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086861}] :question/id #uuid "9f00e3dc-4130-58a7-94b7-d4a41b9720a6" :question/math-academy-id "q-79205" :question/problem "![](images/ec/ecd105502fc276297713d3a105db0eb099e8f369e3f4773a78412948ad0870c7.png)\n\nThe quarter-circle above is defined by the parametric equations\n\n$$\n\\displaystyle x = 4\\cos θ, y = 4\\sin θ.\n$$\n\nWhat is the domain of the parameter $θ$?"}] [{:db/id #edb/ref 17592186096400 :question/id #uuid "19bf8d06-cbcc-547b-b882-ac89cd39fd1a" :question/math-academy-id "e-181" :question/problem "Given that $f(x) = (3x^4+x^3)^5,$ calculate $\\dfrac {\\textrm{d}f} {\\textrm{d}x}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf = g^5, \\qquad g = 3x^4+x^3\n$$\n\nThe chain rule states that\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}x} = \\dfrac {\\textrm{d}f} {\\textrm{d}g} \\cdot \\dfrac {\\textrm{d}g} {\\textrm{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}g}  = 5g^4,\n$$\n\nand\n\n$$\n\\dfrac {\\textrm{d}g} {\\textrm{d}x} = 12x^3 + 3x^2.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =5{g}^{4}\\cdot (12{x}^{3}+3{x}^{2}) \\\\  & =5(3{x}^{4}+{x}^{3})^{4}(12{x}^{3}+3{x}^{2}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096401 :question/id #uuid "8fcdb2c8-71ca-5bfa-b7fe-49f8f2c05bbb" :question/math-academy-id "e-182" :question/problem "Given that $y = \\sqrt{1-x^2},$ find $\\dfrac{\\textrm d y}{\\textrm d x}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = \\dfrac{\\textrm d y}{\\textrm d u}\\cdot \\dfrac{\\textrm d u}{\\textrm d x}.\n$$\n\nHere, we've used $u$ instead of $g$ for the intermediate variable. \n\nLet $u=1-x^2.$ Then $y = \\sqrt u = u^{1/2}.$ Differentiating, we have\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = \\dfrac{1}{2}u^{-1/2} = \\dfrac{1}{2\\sqrt u}\n$$\n\nand\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x}  = -2x.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-2x) \\\\  & =-\\frac{2x}{2\\sqrt{u}} \\\\  & =-\\frac{x}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096402 :question/id #uuid "2c37ae73-233d-5e0d-87ff-05cacc6d078b" :question/math-academy-id "e-183" :question/problem "Given that $f(x) = \\dfrac{1}{\\sqrt{1-3x}},$ calculate $f'(x).$" :question/worked-solution "Let $g(x)=1-3x$ and $f(g(x)) = \\dfrac{1}{\\sqrt{g}} = g^{-1/2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{-1/2})^{′}=-\\frac{1}{2}{g}^{-3/2}=-\\frac{1}{2{g}^{3/2}}, \\\\ {g}^{′}(x) & =(1-3x)^{′}=-3.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =-\\frac{1}{2{g}^{3/2}}\\cdot (-3) \\\\  & =\\frac{3}{2{g}^{3/2}} \\\\  & =\\frac{3}{2(1-3x)^{3/2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd726c27-0178-5cc8-a8b6-82e60d62ac1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(15x^{4} - 8x)(3x^{5} - 4x^{2})^{2}" :db/id #edb/ref 17592186093807} {:answer/id #uuid "c477f2d6-5ad8-52b3-8fe5-92a70939ea8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(5x^{5} - 8x)(3x^{5} - 4x^{2})^{2}" :db/id #edb/ref 17592186093808} {:answer/id #uuid "060329dc-443f-5ee6-a297-ff049fb57b80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8(15x^{4} - 8x)(3x^{5} - 4x^{2})^{2}" :db/id #edb/ref 17592186093809} {:answer/id #uuid "113fc8bd-4460-5e48-a12a-43e5a61ddd92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(15x^{4} - 8x)(3x^{5} - 4x^{2})^{3}" :db/id #edb/ref 17592186093810} {:answer/id #uuid "5927f4b1-57be-52eb-ac32-2223134b64df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(5x^{4} - 8x)(3x^{5} - 4x^{2})^{2}" :db/id #edb/ref 17592186093811}] :answer-field/correct {:answer/id #uuid "bd726c27-0178-5cc8-a8b6-82e60d62ac1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(15x^{4} - 8x)(3x^{5} - 4x^{2})^{2}" :db/id #edb/ref 17592186093807} :answer-field/id #uuid "9edef6e7-9845-5317-bcbd-d2c7b7bf754e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093806}] :question/id #uuid "d119ffe6-ff07-57d9-a572-ef180eb72f6c" :question/math-academy-id "q-11414" :question/problem "Given that $f(x) = (3x^{5} - 4x^{2})^{3}$, find $f^{′}(x)$." :question/worked-solution "Let $u=3x^5-4x^2$. The chain rule gives\n\n$$\n\\begin{aligned}f^{\\prime}(x)&=3u^2u^{\\prime}\\\\&=3(3x^5-4x^2)^2(15x^4-8x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85752216-72d1-52c5-a307-1f7593bb2baa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x^{4} + 3x)(4x^{3} + 3)" :db/id #edb/ref 17592186095425} {:answer/id #uuid "bffd2b2f-d555-5e17-8756-8a754febf526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x^{4} + 3x)(4x^{3} + 3x)" :db/id #edb/ref 17592186095426} {:answer/id #uuid "eef892e3-6947-592f-9345-311b595e0536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(4x^{3})(x^{4} + 3x)" :db/id #edb/ref 17592186095427} {:answer/id #uuid "05327ffd-b783-558f-8116-edad45453171" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(4x^{3})(x^{4} + 3x)^{2}" :db/id #edb/ref 17592186095428} {:answer/id #uuid "62baa9f7-a4b9-5ff4-84f6-37fdf189f3fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x^{4} + 3x)(4x^{3} + 3)^{2}" :db/id #edb/ref 17592186095429}] :answer-field/correct {:answer/id #uuid "85752216-72d1-52c5-a307-1f7593bb2baa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x^{4} + 3x)(4x^{3} + 3)" :db/id #edb/ref 17592186095425} :answer-field/id #uuid "a72fa786-3004-51a5-a233-17a9a216dfb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095424}] :question/id #uuid "b551e489-4c37-53ea-831b-8f3ca007450b" :question/math-academy-id "q-48625" :question/problem "Find $\\frac{df}{dx}$ when $f(x) = (x^{4} + 3x)^{2}$." :question/worked-solution "With $u=x^4+3x$, we have $f=u^2$ and $u^{\\prime}=4x^3+3$. Therefore\n\n$$\nf^{\\prime}(x)=2(x^4+3x)(4x^3+3).\n$$"}] [{:db/id #edb/ref 17592186097251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "256d8104-e561-50d4-bb47-c84cda5f979d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2\\sqrt{(5x-1{)}^{3}}}" :db/id #edb/ref 17592186327259} {:answer/id #uuid "92909c43-4d9f-55c2-9367-b2903d4d10f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5x-1}" :db/id #edb/ref 17592186328210} {:answer/id #uuid "b84fdb58-69a3-5339-b857-edeff32c5507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{5x-1}}" :db/id #edb/ref 17592186328539} {:answer/id #uuid "ccdb8149-860b-5213-8db1-d92c7a922a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2\\sqrt{5x-1}}" :db/id #edb/ref 17592186328733} {:answer/id #uuid "e32be03e-6bf9-5893-a620-899e6e49abe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{(5x-1{)}^{3}}}" :db/id #edb/ref 17592186328925}] :answer-field/correct {:answer/id #uuid "256d8104-e561-50d4-bb47-c84cda5f979d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2\\sqrt{(5x-1{)}^{3}}}" :db/id #edb/ref 17592186327259} :answer-field/id #uuid "14eebaf9-3e88-5f2b-82c3-330efcb42e3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329219}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "854ec833-4bc0-54f0-9210-c708a9342fef" :question/math-academy-id "q-48730" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{5x-1}}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=5x-1.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot (5) \\\\  & =-\\frac{5}{2\\sqrt{(5x-1{)}^{3}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d468059-f4b7-51ec-a214-229418cddeaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{4x - 3}}" :db/id #edb/ref 17592186095473} {:answer/id #uuid "ce172954-02de-5948-98e6-063d373c04b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x - 3}}" :db/id #edb/ref 17592186095474} {:answer/id #uuid "dd38fa2b-33de-5df5-aa85-ed357c5eb5e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{4x + 3}}" :db/id #edb/ref 17592186095475} {:answer/id #uuid "fd120f87-d6a9-56e7-ae4f-db302afd2580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x + 3}}" :db/id #edb/ref 17592186095476} {:answer/id #uuid "7f7778bb-8979-5802-bf93-4a409e6e58b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{4x - 3}}" :db/id #edb/ref 17592186095477}] :answer-field/correct {:answer/id #uuid "ce172954-02de-5948-98e6-063d373c04b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x - 3}}" :db/id #edb/ref 17592186095474} :answer-field/id #uuid "84ab9969-a822-5aa8-beea-30e48f66c60f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095472}] :question/id #uuid "ea97309c-a67a-5e7f-aa97-023276ac6669" :question/math-academy-id "q-48846" :question/problem "Given that $y = \\sqrt{4x - 3}$, find $\\frac{dy}{dx}$." :question/worked-solution "Write $y=(4x-3)^{1/2}$ and apply the chain rule:\n\n$$\ny^{\\prime}=\\frac12(4x-3)^{-1/2}\\cdot4=\\frac2{\\sqrt{4x-3}}.\n$$\n\nThe derivative is defined for $x>3/4$."}] [{:db/id #edb/ref 17592186097259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17e908ac-775f-57c5-b411-f2580198a03b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{(8x+6)}{\\sqrt{(2{x}^{2}+3x)^{3}}}" :db/id #edb/ref 17592186524427} {:answer/id #uuid "3e8e41b2-c271-53b2-95cd-a26907947e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+3}{\\sqrt{(2{x}^{2}+3x)^{3}}}" :db/id #edb/ref 17592186524499} {:answer/id #uuid "b770c35b-70a6-5c86-ad4d-dd5c5297261a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{(4x+3)}{\\sqrt{(2{x}^{2}+3x)^{3}}}" :db/id #edb/ref 17592186524674} {:answer/id #uuid "f1844554-3506-5984-a850-e337e7d94eec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{(4x+3)}{\\sqrt[3]{(2{x}^{2}+3x)^{2}}}" :db/id #edb/ref 17592186524807} {:answer/id #uuid "f8192899-3a5d-5635-a01d-e3e96a9ce1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{(4x+3)}{2\\sqrt{(2{x}^{2}+3x)^{3}}}" :db/id #edb/ref 17592186524821}] :answer-field/correct {:answer/id #uuid "b770c35b-70a6-5c86-ad4d-dd5c5297261a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{(4x+3)}{\\sqrt{(2{x}^{2}+3x)^{3}}}" :db/id #edb/ref 17592186524674} :answer-field/id #uuid "7bd41183-7068-5455-b0e0-8cdceb8831b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095478}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2da730c2-fcbd-535d-85d1-2014785f31eb" :question/math-academy-id "q-48850" :question/problem "Find ${f}^{′}(x)$ for $f(x)=\\frac{2}{\\sqrt{2{x}^{2}+3x}}.$" :question/worked-solution "Let $g(x)=2{x}^{2}+3x$ and $f(g(x))=\\frac{2}{\\sqrt{g}}=2{g}^{-1/2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =2({g}^{-1/2})^{′}=-2\\cdot \\frac{1}{2}{g}^{-3/2}=-\\frac{1}{{g}^{3/2}}, \\\\ {g}^{′}(x) & =(2{x}^{2}+3x)^{′}=4x+3.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =-\\frac{1}{{g}^{3/2}}\\cdot (4x+3) \\\\  & =-\\frac{4x+3}{{g}^{3/2}} \\\\  & =-\\frac{4x+3}{\\sqrt{(2{x}^{2}+3x)^{3}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2e9e80-9009-5c4d-8418-53807b048413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18(4+6x{)}^{2}" :db/id #edb/ref 17592186333097} {:answer/id #uuid "2f451149-34e3-5874-ac22-67e5f7f806cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x(4+6x{)}^{2}" :db/id #edb/ref 17592186333429} {:answer/id #uuid "ac1f9842-ca0a-55db-bcb6-06735b728dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+6x{)}^{2}}{2}" :db/id #edb/ref 17592186334496} {:answer/id #uuid "b1df2cc8-3e8e-59c7-a92f-f4f573b06622" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(4+6x{)}^{2}" :db/id #edb/ref 17592186334551} {:answer/id #uuid "d848947b-033e-583b-9707-793c5c4bf6dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(4+6x{)}^{4}" :db/id #edb/ref 17592186334883}] :answer-field/correct {:answer/id #uuid "0c2e9e80-9009-5c4d-8418-53807b048413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18(4+6x{)}^{2}" :db/id #edb/ref 17592186333097} :answer-field/id #uuid "564e943b-61e3-5dd9-b71b-ad37ff586952" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335411}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0bd56a8-5c99-5166-be8e-4185bfb62ed5" :question/math-academy-id "q-666" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(4+6x{)}^{3}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{3},\\,g=4+6x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3{g}^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=6.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =3\\cdot 6\\cdot (4+6x{)}^{2} \\\\  & =18(4+6x{)}^{2}.\\end{aligned}\n$$"}]}
