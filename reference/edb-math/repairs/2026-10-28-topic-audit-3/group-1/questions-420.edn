#{[{:db/id #edb/ref 17592186253600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d7b5f91-2c37-5fae-acd3-ab851569533c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186251452} {:answer/id #uuid "af37c521-a94c-5b77-88a6-5309b210c625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{1+\\operatorname{sin}⁡\\theta }" :db/id #edb/ref 17592186252081} {:answer/id #uuid "c5e9a0ec-cc21-5425-9379-8a5af52437e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186252302} {:answer/id #uuid "d406df00-ed82-57c6-8bcb-2a684e461536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1+\\operatorname{sin}⁡\\theta }" :db/id #edb/ref 17592186252430} {:answer/id #uuid "de490b09-1c46-54be-978d-9843c9fa8296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186252509}] :answer-field/correct {:answer/id #uuid "6d7b5f91-2c37-5fae-acd3-ab851569533c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186251452} :answer-field/id #uuid "54002820-442d-5036-9f81-7a9c962e49b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "655d2fb5-3fa2-5139-a053-7e43658638e3" :question/math-academy-id "q-119773" :question/problem "$1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }=$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } & =\\frac{1}{1}+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}} \\\\  & =\\frac{1\\cdot (1+{sin}^{2}⁡\\theta )}{1\\cdot (1+{sin}^{2}⁡\\theta )}+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}} \\\\  & =\\frac{1+{sin}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } \\\\  & =\\frac{1+{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{1+{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } & =\\frac{1+1}{1+{sin}^{2}⁡\\theta } \\\\  & =\\frac{2}{1+{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }=\\frac{2}{1+{sin}^{2}⁡\\theta }.\n$$"}] [{:db/id #edb/ref 17592186253602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2853c65b-3f44-502d-a803-a0acd38f76b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186250898} {:answer/id #uuid "4b0ebc01-13f7-52d1-9ab2-4cd3a673ddd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251177} {:answer/id #uuid "a0d9a327-adec-5add-ad89-f4382522907f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251942} {:answer/id #uuid "bd3e9417-953e-5115-a9a9-ba65d6cc8801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186252225} {:answer/id #uuid "e9bf68d8-8dae-5276-becd-1ee419276ffc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+1" :db/id #edb/ref 17592186252600}] :answer-field/correct {:answer/id #uuid "bd3e9417-953e-5115-a9a9-ba65d6cc8801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186252225} :answer-field/id #uuid "5f85872d-1cc7-59c2-b228-3710cc0bc671" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252976}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a48a9a21-fe38-560f-b14b-f3224e4f215c" :question/math-academy-id "q-119775" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x}{1}-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x}-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x-{sin}^{2}⁡x-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x-({sin}^{2}⁡x+{cos}^{2}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x-1}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{-(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}=-1.\n$$"}] [{:db/id #edb/ref 17592186256685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dfdb090-b6f2-5639-aede-69a2ab60459d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437618} {:answer/id #uuid "8709f1c4-65e1-54b0-9d7e-fb1cb2bfbedf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437619}] :answer-field/correct {:answer/id #uuid "8709f1c4-65e1-54b0-9d7e-fb1cb2bfbedf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437619} :answer-field/id #uuid "e8671b01-0de0-54e6-81e3-d9dce3d551cb" :answer-field/key "$U(x,y)=⟨\\frac{1}{x+2},\\sqrt{x-y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438838} {:answer-field/choices [{:answer/id #uuid "f49f49bb-0589-51e3-8307-793ca10c0906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437620} {:answer/id #uuid "e78b01f6-8039-5eb5-a36a-b79ac0375eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437621}] :answer-field/correct {:answer/id #uuid "e78b01f6-8039-5eb5-a36a-b79ac0375eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437621} :answer-field/id #uuid "811ad6c5-2f4c-5371-a120-40ade9271191" :answer-field/key "$V(x,y)=⟨x{e}^{y},1-y⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438839} {:answer-field/choices [{:answer/id #uuid "177eaf39-4c0c-56e2-b24b-1fe2e1490f63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437622} {:answer/id #uuid "3b92af76-e3cd-572a-82c2-a86f00b68ae4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437623}] :answer-field/correct {:answer/id #uuid "177eaf39-4c0c-56e2-b24b-1fe2e1490f63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437622} :answer-field/id #uuid "1603ebdc-1768-5b01-b37c-c00c63150d1d" :answer-field/key "$W(x,y,z)=⟨x,-y,-z⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82c19ae8-c5db-5680-ac18-77dd108b7959" :question/math-academy-id "q-122650" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $U(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,x\\ne -2,\\,x-y\\ge 0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $V(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $W(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\nTherefore, the correct answer is $U(x,y)=⟨\\frac{1}{x+2},\\sqrt{x-y}⟩$; $V(x,y)=⟨x{e}^{y},1-y⟩$ only."}] [{:db/id #edb/ref 17592186256687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a345da55-40a0-58c5-bd97-11513a3c18ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437624} {:answer/id #uuid "91b6594a-7883-5a7f-8bd5-9117346c6a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437625}] :answer-field/correct {:answer/id #uuid "91b6594a-7883-5a7f-8bd5-9117346c6a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437625} :answer-field/id #uuid "b3809f3b-8813-5ce8-88cd-4a794a7f1292" :answer-field/key "$A(x,y)$ $=⟨\\operatorname{cos}⁡(x-y),\\operatorname{ln}⁡(x+y)⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438841} {:answer-field/choices [{:answer/id #uuid "70f0c14d-a0ab-547c-aa1b-626d40c92945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437626} {:answer/id #uuid "93e5dc0c-b8a9-51a7-b679-0830b810940c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437627}] :answer-field/correct {:answer/id #uuid "70f0c14d-a0ab-547c-aa1b-626d40c92945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437626} :answer-field/id #uuid "ecbb9997-28d7-57dd-8e3a-e4fbdf98e863" :answer-field/key "$B(x,y,z)=⟨-2x,3{y}^{3},{z}^{5}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438842} {:answer-field/choices [{:answer/id #uuid "c750739b-5adf-51bf-8122-bbc865b012bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437628} {:answer/id #uuid "16c760f1-2a00-532d-8ab5-17d51057a421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437629}] :answer-field/correct {:answer/id #uuid "c750739b-5adf-51bf-8122-bbc865b012bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437628} :answer-field/id #uuid "23d9d23a-b11c-50ab-a519-b5ea13ec3cca" :answer-field/key "$C(t)=⟨2-{t}^{2},{e}^{t-1}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438843}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "212db81f-3e39-5c00-88aa-953a8a56ffb4" :question/math-academy-id "q-122653" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $A(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,x+y>0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $B(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\n- The function $C(t)$ is *not* a vector field on ${R}^{2}.$  It assigns points in $R$ (not ${R}^{2}$) to vectors in ${R}^{2}.$\n\nTherefore, the correct answer is $A(x,y)$ $=⟨\\operatorname{cos}⁡(x-y),\\operatorname{ln}⁡(x+y)⟩$ only."}] [{:db/id #edb/ref 17592186256688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56102ac4-0111-50bf-baa1-120344804ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,x<y}" :db/id #edb/ref 17592186254425} {:answer/id #uuid "76a03f33-46e2-5d1c-8929-cfef138e411e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,x\\ne y}" :db/id #edb/ref 17592186254717} {:answer/id #uuid "c6fa9022-755b-5cfe-8215-5e56801bef47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0),\\,x\\ge y}" :db/id #edb/ref 17592186255447} {:answer/id #uuid "de3053b1-0e26-5159-83fc-ae08b0b64b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0)}" :db/id #edb/ref 17592186255641} {:answer/id #uuid "eff20b85-4c4c-5b34-8add-3733f5aa6cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,x>y}" :db/id #edb/ref 17592186255767}] :answer-field/correct {:answer/id #uuid "eff20b85-4c4c-5b34-8add-3733f5aa6cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,|\\,x>y}" :db/id #edb/ref 17592186255767} :answer-field/id #uuid "32eb6772-d2dc-5309-9bae-71a60e83b4a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256010}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d82b252-32f5-5b9f-80ce-d3ae2209d9d3" :question/math-academy-id "q-122657" :question/problem "Determine the domain of the vector field $F$ on ${R}^{2},$ given by\n\n$$\nF(x,y)=\\operatorname{ln}⁡(x-y)\\,i+\\frac{1}{{x}^{2}+{y}^{2}}\\,j\\,.\n$$" :question/worked-solution "The function $F$ can be expressed in terms of its components $P(x,y)$ and $Q(x,y)$ as\n\n$$\nF(x,y)=P(x,y)\\,i+Q(x,y)\\,j,\n$$\n\nwhere\n\n$$\nP(x,y)=\\operatorname{ln}⁡(x-y),\\,Q(x,y)=\\frac{1}{{x}^{2}+{y}^{2}}.\n$$\n\nWe first find the domain of each component function. Then, we compute their intersection to find the domain of $F:$\n\n- The function $P(x,y)$ is defined when the expression under the logarithm is positive. So, to find the domain, we solve the following inequality:\n\n$$\nx-y>0\\,⟹\\,x>y.\n$$\n\nTherefore, the domain of $P$ is given by\n\n$$\n{D}_{1}={(x,y)\\in {R}^{2}\\,|\\,x>y}.\n$$\n\n- The function $Q(x,y)$ is defined everywhere other than when the denominator vanishes. To find where the denominator vanishes, we set it equal to zero and solve:\n\n$$\n{x}^{2}+{y}^{2}=0\\,⟹\\,x=y=0\n$$\n\nTherefore, the domain of $Q$ is given by\n\n$$\n{D}_{2}={(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0)}.\n$$\n\nFinally, the domain $D$ of $F$ is given by\n\n$$\nD={D}_{1}\\cap {D}_{2}={(x,y)\\in {R}^{2}\\,|\\,x>y}\\,.\n$$"}] [{:db/id #edb/ref 17592186256691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d0def04-0c36-58a0-a01f-2ed0f1bb2044" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4a/4a15607520f8ef05913aab5d1724c8b3158457e56d455b6eb756707263494308.png" :db/id #edb/ref 17592186254070} {:answer/id #uuid "2d8a7024-c0df-5add-9db4-ef0e6d955c88" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/26/26709ab7fa3cf1962ff9dca9be510cf5c24f3568f82347a8349e77dc5095fb4c.png" :db/id #edb/ref 17592186254077} {:answer/id #uuid "3285decd-3c25-54c5-a110-1f6bbe59e735" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3884061e6c5f8b5310a8b0bcf06ac844b12b418497d9f6e5b3beced6147d964.png" :db/id #edb/ref 17592186254108} {:answer/id #uuid "5cacab87-de13-5e9a-892c-1c5b560e306c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0e/0e6843335d08bc42a95a5801aa683aeb2a043df0cd7edc03ffbc36a9385fee2a.png" :db/id #edb/ref 17592186254490} {:answer/id #uuid "f37057c0-c75a-55e4-bbb0-a9e433ba13c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/24/2469abf572b9b6fd9da28ae81951b99acdca9b97275af2bc0a96d3411d7fbea1.png" :db/id #edb/ref 17592186255803}] :answer-field/correct {:answer/id #uuid "f37057c0-c75a-55e4-bbb0-a9e433ba13c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/24/2469abf572b9b6fd9da28ae81951b99acdca9b97275af2bc0a96d3411d7fbea1.png" :db/id #edb/ref 17592186255803} :answer-field/id #uuid "cc8fcbe1-118d-5975-9f5d-fda6bda82689" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256289}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "81ef4329-ef48-5a14-8457-2a79f1d3df80" :question/math-academy-id "q-122671" :question/problem "Determine which of the following shaded regions depicts the domain of the vector field $F$ on ${R}^{2},$ given by\n\n$$\nF(x,y)=\\sqrt{1-{x}^{2}-{y}^{2}}\\,i+\\frac{{e}^{x}}{{x}^{2}+{y}^{2}}\\,j\\,.\n$$" :question/worked-solution "The function $F$ can be expressed in terms of its components $P(x,y)$ and $Q(x,y)$ as\n\n$$\nF(x,y)=P(x,y)\\,i+Q(x,y)\\,j,\n$$\n\nwhere\n\n$$\nP(x,y)=\\sqrt{1-{x}^{2}-{y}^{2}},\\,Q(x,y)=\\frac{{e}^{x}}{{x}^{2}+{y}^{2}}.\n$$\n\nWe first find the domain of each component function. Then, we compute their intersection to find the domain of $F:$\n\n- The function $P(x,y)$ is defined when the expression under the radical is positive or equal to zero. So, to find the domain, we solve the following inequality:\n\n$$\n1-{x}^{2}-{y}^{2}\\ge 0\\,⟹\\,{x}^{2}+{y}^{2}\\le 1.\n$$\n\nThis defines the region ${D}_{1},$ which is the interior of a circle of radius $1,$ as shown below:\n\n![](images/9f/9f5f11a4ca31cb796f5a95a1541aa946e24fd1b7079ab8069e5743d41d92d764.png)\n\n- The function $Q(x,y)$ is defined everywhere other than when the denominator vanishes. To find where the denominator vanishes, we set it equal to zero and solve:\n\n$$\n{x}^{2}+{y}^{2}=0\\,⟹\\,x=y=0.\n$$\n\nThis defines the region ${D}_{2},$ which is the entire plane ${R}^{2}$ with the origin removed:\n\n![](images/5b/5b77ad4e9574e94e6a05eee7680f4b57d0190d40583c37c2097acef958cab7e2.png)\n\nFinally, the domain $D$ of $F$ is given by ${D}_{1}\\cap {D}_{2},$ shown below.\n\n![](images/95/95e8d137f90135de1727451fbc96ddfcc325e9e4461054615c91743a4a9ea54a.png)"}] [{:db/id #edb/ref 17592186256693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "719148a4-d796-5d0f-bf37-0acb3355c237" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437642} {:answer/id #uuid "eba23c1d-3faf-5e1e-a91b-717c3d32e34d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437643}] :answer-field/correct {:answer/id #uuid "eba23c1d-3faf-5e1e-a91b-717c3d32e34d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437643} :answer-field/id #uuid "4df690b3-4439-5e28-93c0-aefae7e9325b" :answer-field/key "$U(x,y)=⟨(x+2){e}^{y},\\frac{{x}^{2}}{x-y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438850} {:answer-field/choices [{:answer/id #uuid "f151183d-0ec4-55fd-8ac2-5a941eb7fbb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437644} {:answer/id #uuid "c063cfd4-fff8-5a50-8d56-88acaeadffe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437645}] :answer-field/correct {:answer/id #uuid "f151183d-0ec4-55fd-8ac2-5a941eb7fbb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437644} :answer-field/id #uuid "75092fdd-a6da-542b-8e4b-55dd63863ac1" :answer-field/key "$V(x,y,z)=⟨5,{x}^{3}y,1-{y}^{3}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438851} {:answer-field/choices [{:answer/id #uuid "34a91aca-2e42-57f0-a9b8-8c67da63bfa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437646} {:answer/id #uuid "34d621d2-368f-51fa-b847-821e2249a80d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437647}] :answer-field/correct {:answer/id #uuid "34d621d2-368f-51fa-b847-821e2249a80d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437647} :answer-field/id #uuid "993bc041-4fb8-52cb-aed9-367ffe93abcb" :answer-field/key "$W(x,y)=⟨x-3{y}^{2},2-y⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438852}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f63ae22-12f3-552d-bede-acf1007c6564" :question/math-academy-id "q-122678" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $U(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,x\\ne y}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $K(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\n- The function $V(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\nTherefore, the correct answer is $U(x,y)=⟨(x+2){e}^{y},\\frac{{x}^{2}}{x-y}⟩$; $W(x,y)=⟨x-3{y}^{2},2-y⟩$ only."}] [{:db/id #edb/ref 17592186256694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b794e8c-8662-57a3-9430-d2ee2d5efdaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437648} {:answer/id #uuid "4de84e82-6689-5660-adc6-f0c83536a456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437649}] :answer-field/correct {:answer/id #uuid "4de84e82-6689-5660-adc6-f0c83536a456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437649} :answer-field/id #uuid "616c4d45-069a-5832-84ae-5f981fb6e66f" :answer-field/key "$T(x,y,z)$ $=\\operatorname{sin}⁡x\\,i$ $-\\operatorname{cos}⁡y\\,j$ $+{z}^{2}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438853} {:answer-field/choices [{:answer/id #uuid "51aecfc3-403e-5cba-b3b7-254b2d3ff5c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437650} {:answer/id #uuid "1bb91534-359e-56df-b8a5-f99a590388aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437651}] :answer-field/correct {:answer/id #uuid "51aecfc3-403e-5cba-b3b7-254b2d3ff5c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437650} :answer-field/id #uuid "f56d77cf-af96-5cc5-bb85-082f7d066b90" :answer-field/key "$U(t)=2t\\,i-{t}^{2}\\,j-\\sqrt{t}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438854} {:answer-field/choices [{:answer/id #uuid "dfa28faf-de57-551e-91ac-c5848f304f1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437652} {:answer/id #uuid "8f649c81-72a4-5b3f-9b5f-758b4d86f2bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437653}] :answer-field/correct {:answer/id #uuid "dfa28faf-de57-551e-91ac-c5848f304f1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437652} :answer-field/id #uuid "61696c65-7ecb-5a3d-a4b0-3fd29e6ec63a" :answer-field/key "$V(x,y,z)={e}^{-2z}\\sqrt{x+y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438855}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72c8972f-c700-5c53-9029-c1e143b47247" :question/math-academy-id "q-122685" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $T(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point $(x,y,z)\\in {R}^{3}$ to a vector in ${R}^{3}.$\n\n- The function $U(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $V(x,y,z)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{3}$ to functions in $R$ (not ${R}^{3}$).\n\nTherefore, the correct answer is $T(x,y,z)$ $=\\operatorname{sin}⁡x\\,i$ $-\\operatorname{cos}⁡y\\,j$ $+{z}^{2}\\,k$ only."}] [{:db/id #edb/ref 17592186256695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a596d75-c886-5b2a-91fb-fb7040912254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437660} {:answer/id #uuid "14d600f9-2df6-53a0-baaf-26570d859584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437661}] :answer-field/correct {:answer/id #uuid "14d600f9-2df6-53a0-baaf-26570d859584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437661} :answer-field/id #uuid "bdfc827e-4a82-5cd1-a5ae-5c66a06116d1" :answer-field/key "$D(x,y,z)$ $=5\\,i$ $+{z}^{2}\\,j$ $+(y+x)\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438859} {:answer-field/choices [{:answer/id #uuid "660dc541-8ade-5251-99f2-6387f6ee265f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437662} {:answer/id #uuid "7c8b8c9c-d9b9-56b4-b891-4ed17c9de49f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437663}] :answer-field/correct {:answer/id #uuid "660dc541-8ade-5251-99f2-6387f6ee265f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437662} :answer-field/id #uuid "028c2887-4e28-5453-a433-e92b6b42deee" :answer-field/key "$E(x,y)={x}^{2}\\,i-\\sqrt{y}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438860} {:answer-field/choices [{:answer/id #uuid "91914c88-1e9a-57db-9467-36862e8b8bab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437664} {:answer/id #uuid "602a7c8d-0df8-5802-a275-63a5f0ec8f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437665}] :answer-field/correct {:answer/id #uuid "602a7c8d-0df8-5802-a275-63a5f0ec8f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437665} :answer-field/id #uuid "c8a0ad93-ccff-5c53-b92c-06f494f55cfe" :answer-field/key "$G(x,y,z)$ $=x(y+1)\\,i$ $+\\operatorname{tan}⁡(y-z)\\,j$ $+{z}^{3}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09fffcb2-a27e-5da4-b160-3d4f79d02cb0" :question/math-academy-id "q-122688" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $D(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point $(x,y,z)\\in {R}^{3}$ to a vector in ${R}^{3}.$\n\n- The function $E(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $G(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,y-z\\ne \\frac{\\pi }{2}+n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $D(x,y,z)$ $=5\\,i$ $+{z}^{2}\\,j$ $+(y+x)\\,k$; $G(x,y,z)$ $=x(y+1)\\,i$ $+\\operatorname{tan}⁡(y-z)\\,j$ $+{z}^{3}\\,k$ only."}] [{:db/id #edb/ref 17592186256696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50d9f8ec-d2f4-53f4-a062-dd31da0e2d1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437666} {:answer/id #uuid "95f89107-ff18-5c78-aa80-9d8bf74cb537" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437667}] :answer-field/correct {:answer/id #uuid "50d9f8ec-d2f4-53f4-a062-dd31da0e2d1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437666} :answer-field/id #uuid "44c8354e-64c2-5521-9c4f-6fc0875dab62" :answer-field/key "$U(x,y,z)=(x+2){e}^{yz}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438862} {:answer-field/choices [{:answer/id #uuid "a67cd97f-b350-51ca-9d88-f274e517f2af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437668} {:answer/id #uuid "dd39dffa-7a6e-5361-9525-4a0eb3d64ae4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437669}] :answer-field/correct {:answer/id #uuid "dd39dffa-7a6e-5361-9525-4a0eb3d64ae4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437669} :answer-field/id #uuid "1205eb0b-9fba-5a6b-a549-686ad592c413" :answer-field/key "$V(x,y,z)=⟨5{e}^{-{z}^{2}},{x}^{3}y,1-{y}^{3}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438863} {:answer-field/choices [{:answer/id #uuid "ce5c525b-d1fc-5b97-8265-bcc663f447e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437670} {:answer/id #uuid "c9af1564-eb68-5d27-8c3d-f9f70675660d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437671}] :answer-field/correct {:answer/id #uuid "ce5c525b-d1fc-5b97-8265-bcc663f447e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437670} :answer-field/id #uuid "b7621621-f6bc-55f4-afc8-32adaf42a91d" :answer-field/key "$W(x,y)=⟨x-3{y}^{2},2-y⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438864}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d3cf160-5814-5830-a8cc-6fc64892cdce" :question/math-academy-id "q-122691" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $U(x,y,z)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{3}$ to functions in $R$ (not ${R}^{3}$).\n\n- The function $V(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point $(x,y,z)\\in {R}^{3}$ to a vector in ${R}^{3}.$\n\n- The function $W(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\nTherefore, the correct answer is $V(x,y,z)=⟨5{e}^{-{z}^{2}},{x}^{3}y,1-{y}^{3}⟩$ only."}] [{:db/id #edb/ref 17592186256698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd70e4d-6c48-57c7-9de7-29fb91ecd156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437672} {:answer/id #uuid "c8a035b0-a3e5-53be-a422-6c7151b90283" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437673}] :answer-field/correct {:answer/id #uuid "1cd70e4d-6c48-57c7-9de7-29fb91ecd156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437672} :answer-field/id #uuid "82f16859-809f-5571-9e24-04024074834c" :answer-field/key "$N(x,y)=⟨x{e}^{y},\\sqrt{x+y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438865} {:answer-field/choices [{:answer/id #uuid "84952cf5-bae9-566b-8785-0e7b44cb9f1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437674} {:answer/id #uuid "9499395a-41a6-544d-ae0b-b638a3373619" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437675}] :answer-field/correct {:answer/id #uuid "9499395a-41a6-544d-ae0b-b638a3373619" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437675} :answer-field/id #uuid "16a42706-0e2c-5b8a-a048-2ec4e31f3fbc" :answer-field/key "$P(x,y,z)$ $=⟨{e}^{x-2y},\\sqrt{3-x},3{z}^{3}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438866} {:answer-field/choices [{:answer/id #uuid "df7e1c2f-9a73-51cd-b44a-97d3a3f06124" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437676} {:answer/id #uuid "0039b744-c30f-5b87-90ae-3f6e231319ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437677}] :answer-field/correct {:answer/id #uuid "0039b744-c30f-5b87-90ae-3f6e231319ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437677} :answer-field/id #uuid "28d18e6e-3fdd-511d-adcf-4ebf4d97e428" :answer-field/key "$Q(x,y,z)$ $=⟨-1,2,\\operatorname{ln}⁡(2x-y+z)⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "659f4527-cc88-5c6b-8485-f595eee1689f" :question/math-academy-id "q-122694" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,3-x\\ge 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,2x-y+z>0}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $P(x,y,z)$ $=⟨{e}^{x-2y},\\sqrt{3-x},3{z}^{3}⟩$; $Q(x,y,z)$ $=⟨-1,2,\\operatorname{ln}⁡(2x-y+z)⟩$ only."}] [{:db/id #edb/ref 17592186256699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "381ec827-a8d9-525e-879e-9867a01781c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437684} {:answer/id #uuid "49b34905-3523-5220-8445-649a78b38000" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437685}] :answer-field/correct {:answer/id #uuid "381ec827-a8d9-525e-879e-9867a01781c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437684} :answer-field/id #uuid "18ab9680-7869-5328-9a15-6eba928afef1" :answer-field/key "$C(x,y,z)=\\frac{z}{x+y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438871} {:answer-field/choices [{:answer/id #uuid "87e56ee0-4b15-585a-b00b-9c198815d5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437686} {:answer/id #uuid "8084195c-c80f-5724-a464-b4190c772af2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437687}] :answer-field/correct {:answer/id #uuid "87e56ee0-4b15-585a-b00b-9c198815d5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437686} :answer-field/id #uuid "f57b8a4e-6326-51ba-9d83-e214db0e9062" :answer-field/key "$D(x,y)$ $=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y),7{x}^{3}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438872} {:answer-field/choices [{:answer/id #uuid "9acb7596-f53f-56d2-b363-d2432bfdfc06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437688} {:answer/id #uuid "7cff525b-7dbd-51e3-9c41-4f3a63d8b105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437689}] :answer-field/correct {:answer/id #uuid "7cff525b-7dbd-51e3-9c41-4f3a63d8b105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437689} :answer-field/id #uuid "ee64c134-4670-5bcf-b390-f48716fc96b5" :answer-field/key "$E(x,y,z)$ $=⟨\\operatorname{sin}⁡(x+z),\\operatorname{tan}⁡z,\\frac{1}{x-y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89ed8a40-4bb8-5a40-9a2c-1bf03637a8bf" :question/math-academy-id "q-122696" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $C(x,y,z)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{3}$ to functions in $R$ (not ${R}^{3}$).\n\n- The function $D(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $E(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ne y,\\,z\\ne \\frac{\\pi }{2}+n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $E(x,y,z)$ $=⟨\\operatorname{sin}⁡(x+z),\\operatorname{tan}⁡z,\\frac{1}{x-y}⟩$ only."}] [{:db/id #edb/ref 17592186256700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f2483de-bb9b-57f7-a79f-34885e11205d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{\\pi }{3})" :db/id #edb/ref 17592186253803} {:answer/id #uuid "c65aceae-e84b-5651-9ab5-ee308d3662ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{\\pi }{2})" :db/id #edb/ref 17592186255443} {:answer/id #uuid "cb258778-9d8d-556c-8e5b-b5614a8787a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\pi )" :db/id #edb/ref 17592186255476} {:answer/id #uuid "f09c891f-e284-5b41-96e4-62a818b69c4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{2\\pi }{3})" :db/id #edb/ref 17592186255773} {:answer/id #uuid "fb0c7cf4-bb80-57c1-a9c1-3db0dee8005d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{\\pi }{6})" :db/id #edb/ref 17592186255874}] :answer-field/correct {:answer/id #uuid "f09c891f-e284-5b41-96e4-62a818b69c4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{2\\pi }{3})" :db/id #edb/ref 17592186255773} :answer-field/id #uuid "54d4061c-5bca-5874-a889-0e5b0bcb0553" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256085}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "405e30d2-1994-59ac-94e7-5e7998f82913" :question/math-academy-id "q-122698" :question/problem "A curve is defined by the parametric equations\n\n$$\nx={e}^{3t}+1,\\,y={e}^{t}\\operatorname{sin}⁡(\\pi t),\\,-\\infty <t<\\infty .\n$$\n\nLet $C$ be the point that corresponds to $t=0$ on the curve. Determine the point at which the tangent to the curve at $C$ crosses the $y$-axis." :question/worked-solution "First, we find the coordinates of the point $C$ by substituting $t=0$ into the parametric equations:\n\n$$\n\\begin{aligned}x & ={e}^{3\\cdot 0}+1=1+1=2, \\\\ y & ={e}^{0}\\operatorname{sin}⁡(\\pi \\cdot 0)=0\\,.\\end{aligned}\n$$\n\nSo we're looking to find the equation of the tangent line to the curve at the point $(2,0).$ \n\nTo find the equation of the tangent line, we need to find $\\frac{dy}{dx}.$ To compute it, we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=3{e}^{3t},\\,{y}^{′}(t)={e}^{t}(\\operatorname{sin}⁡(\\pi t)+\\pi \\operatorname{cos}⁡(\\pi t)),\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =\\frac{{e}^{t}(\\operatorname{sin}⁡(\\pi t)+\\pi \\operatorname{cos}⁡(\\pi t))}{3{e}^{3t}} \\\\  & =\\frac{\\operatorname{sin}⁡(\\pi t)+\\pi \\operatorname{cos}⁡(\\pi t)}{3{e}^{2t}}.\\end{aligned}\n$$\n\nAt the point where $t=0,$ the slope of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=0} & =\\frac{\\operatorname{sin}⁡(\\pi \\cdot 0)+\\pi \\operatorname{cos}⁡(\\pi \\cdot 0)}{3{e}^{2\\cdot 0}} \\\\  & =\\frac{0+\\pi }{3} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nFinally, to calculate the equation of the tangent line, we use point-slope form with the point $({x}_{1},{y}_{1})=(2,0)$ and the slope $m=\\frac{\\pi }{3}.$ We get\n\n$$\n\\begin{aligned}y-0 & =\\frac{\\pi }{3}(x-2).\\end{aligned}\n$$\n\nThe tangent crosses the $y$-axis when $x=0.$ At this point, we have\n\n$$\n\\begin{aligned}y-0 & =\\frac{\\pi }{3}(0-2) \\\\ y & =-\\frac{2\\pi }{3}\\,.\\end{aligned}\n$$\n\nConsequently, $(0,-\\frac{2\\pi }{3})$ is the $y$-intercept."}] [{:db/id #edb/ref 17592186256704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23be673f-249f-54d5-8bba-1196cc91218d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/11/11cfd599bbfe85c9f3c7a23d5b95c6bd2b3ff199c6c0a4777429123afc74cb8c.png" :db/id #edb/ref 17592186253992} {:answer/id #uuid "2d5e44b9-db64-5b67-b712-489ffc553051" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ff/ff0774689ae7215b624ea7eb3bed8f68a673fba4bcc4ceeb73f82b9081c32d4f.png" :db/id #edb/ref 17592186254074} {:answer/id #uuid "8cf757cd-3613-5b80-9f15-fd5bdceadfc7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4a/4aeebc183f9a6676f7487fce53ec46ad0f2cc91a87847d8a230471dc638ea448.png" :db/id #edb/ref 17592186254915} {:answer/id #uuid "da8daeb9-2bcb-50c1-b44c-600775cb8bb6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/de/de222a9251e08861dd06fdee593cc10557f0be1d2c7d891395512d699b35aa63.png" :db/id #edb/ref 17592186255609} {:answer/id #uuid "e605afc3-fcef-5e1e-a9be-583c83c6dfe1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/49/49000dd6905017bc64c9a67b6d8a2ea475a684477ac6e02d6ed15c4c7dbbb3aa.png" :db/id #edb/ref 17592186255698}] :answer-field/correct {:answer/id #uuid "e605afc3-fcef-5e1e-a9be-583c83c6dfe1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/49/49000dd6905017bc64c9a67b6d8a2ea475a684477ac6e02d6ed15c4c7dbbb3aa.png" :db/id #edb/ref 17592186255698} :answer-field/id #uuid "2b83f961-43ac-5ecd-a230-9fdb901ae8cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255998}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "977dd2df-2a75-5c51-b25e-8edbacd60b15" :question/math-academy-id "q-122710" :question/problem "Determine which of the following shaded regions depicts the domain of the vector field $F$ on ${R}^{2},$ given by\n\n$$\nF(x,y)=y\\operatorname{ln}⁡(1-{x}^{2})\\,i+x\\sqrt{1-|y|}\\,j\\,.\n$$" :question/worked-solution "The function $F$ can be expressed in terms of its components $P(x,y)$ and $Q(x,y)$ as\n\n$$\nF(x,y)=P(x,y)\\,i+Q(x,y)\\,j,\n$$\n\nwhere\n\n$$\nP(x,y)=y\\operatorname{ln}⁡(1-{x}^{2}),\\,Q(x,y)=x\\sqrt{1-|y|}.\n$$\n\nWe first find the domain of each component function. Then, we compute their intersection to find the domain of $F:$\n\n- The function $P(x,y)$ is defined when the expression under the logarithm is positive. So, to find the domain, we solve the following inequality:\n\n$$\n1-{x}^{2}>0\\,⟹\\,-1<x<1.\n$$\n\nThis defines the region ${D}_{1},$ shown below:\n\n![](images/89/89c78ec587826c15c90ef4ffdfc0fd9f8af3d7b4d3d1cc099ce24b883b9842c2.png)\n\n- The function $Q(x,y)$ is defined the expression under the radical is positive or equal to zero. So, to find the domain, we solve the following inequality:\n\n$$\n1-|y|\\ge 0\\,⟹\\,-1\\le y\\le 1.\n$$\n\nThis defines the region ${D}_{2},$ shown below:\n\n![](images/ad/addd649aa739711fd34ebd3e82579c8c0100a2b9a109d5cafabde750bc94eb9a.png)\n\nFinally, the domain $D$ of $F$ is given by ${D}_{1}\\cap {D}_{2},$ shown below.\n\n![](images/49/49000dd6905017bc64c9a67b6d8a2ea475a684477ac6e02d6ed15c4c7dbbb3aa.png)"}] [{:db/id #edb/ref 17592186256706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a045771-d8ae-5cdc-84d3-b3cd816ec00c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=20" :db/id #edb/ref 17592186254044} {:answer/id #uuid "2bb229ef-4966-5f1f-9ed2-fcb9e90d768f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186254060} {:answer/id #uuid "a3b04d28-4dff-524a-8690-c15be0f1788a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=9" :db/id #edb/ref 17592186255112} {:answer/id #uuid "d162cfde-5987-5fd8-bdf5-7c6350a3be39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-1" :db/id #edb/ref 17592186255538} {:answer/id #uuid "f6d3d2d1-db33-5eba-a8dd-406ca13f50df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186255830}] :answer-field/correct {:answer/id #uuid "f6d3d2d1-db33-5eba-a8dd-406ca13f50df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186255830} :answer-field/id #uuid "a3597dd1-c872-5d2d-bc36-073975f4bf30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256216}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa6201e7-5014-5e6b-8fe5-7f2f7e237473" :question/math-academy-id "q-122726" :question/problem "A curve is defined by the parametric equations \n\n$$\nx=4{t}^{5},\\,y=9t,\\,-\\infty <t<\\infty .\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is vertical." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is vertical if ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=20{t}^{4},\\,{y}^{′}(t)=9.\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n20{t}^{4}=0\\,⟹\\,t=0.\n$$\n\nNote that ${y}^{′}(0)=9\\ne 0.$ Therefore, we conclude that when $t=0,$ the tangent to the curve is vertical."}] [{:db/id #edb/ref 17592186256744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f344a5d-f20b-5d29-bc4b-455872b79c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{3}x+2" :db/id #edb/ref 17592186254087} {:answer/id #uuid "9e617510-b480-5d70-b155-ca6d7883d5d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{4}{3}x+2" :db/id #edb/ref 17592186255062} {:answer/id #uuid "b77a05d6-9403-5a91-8f6f-1d9bf6e028b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{3}{2}x-1" :db/id #edb/ref 17592186255297} {:answer/id #uuid "cfa266e3-b7f3-5389-b0e2-d0701e510855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{3}x+1" :db/id #edb/ref 17592186255519} {:answer/id #uuid "d0067f8f-a0ec-5d6c-b01d-2fd5c88ca389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{3}x-1" :db/id #edb/ref 17592186255523}] :answer-field/correct {:answer/id #uuid "d0067f8f-a0ec-5d6c-b01d-2fd5c88ca389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{3}x-1" :db/id #edb/ref 17592186255523} :answer-field/id #uuid "38fc7afa-faeb-58be-bde2-8b46b42e1581" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45f7632b-4b69-541a-a152-af5eeab4cd2b" :question/math-academy-id "q-122898" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=\\operatorname{ln}⁡({t}^{2}),\\,y=2{t}^{3}-3t\\,,\\,t\\in (0,\\infty ).\n$$\n\nLet $C$ be the point that corresponds to $t=1$ on the curve. Find the equation of the normal to the curve at $C.$" :question/worked-solution "First, we find the coordinates of the point $C$ by substituting $t=1$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =\\operatorname{ln}⁡({1}^{2})=\\operatorname{ln}⁡1=0, \\\\ y & =2(1)^{3}-3(1)=-1\\end{aligned}\n$$\n\nSo we're looking to find the equation of the normal at the point $(0,-1).$ For this, we need to find $\\frac{\\text{d}y}{\\text{d}x},$ which means we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=\\frac{2}{t},\\,{y}^{′}(t)=6{t}^{2}-3\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =\\frac{6{t}^{2}-3}{\\frac{2}{t}} \\\\  & =\\frac{6{t}^{3}-3t}{2}.\\end{aligned}\n$$\n\nAt the point where $t=1,$  the slope $m$ of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=1} & =\\frac{6(1)^{3}-3(1)}{2}=\\frac{3}{2}.\\end{aligned}\n$$\n\nTo find the slope ${m}_{n}$ of the normal line, we take the negative reciprocal of $m$:\n\n$$\n{m}_{n}=-\\frac{1}{m}=-\\frac{1}{\\,\\left(\\frac{3}{2}\\right)\\,}=-\\frac{2}{3}\n$$\n\nTo calculate the equation of the normal, we use point-slope form with the point $({x}_{1},{y}_{1})=(0,-1)$ and the slope ${m}_{n}=-\\frac{2}{3}.$ We get\n\n$$\n\\begin{aligned}y+1 & =-\\frac{2}{3}\\cdot (x-0) \\\\ y & =-\\frac{2}{3}x-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38170285-5909-5a87-b81e-7614b331e561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm \\sqrt{2}" :db/id #edb/ref 17592186254153} {:answer/id #uuid "61b95ad1-c677-5a1d-9693-7fe23f0898f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm \\sqrt{6}" :db/id #edb/ref 17592186254545} {:answer/id #uuid "74ee3251-ef46-57f3-8565-b37dbcb4bbe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186254706} {:answer/id #uuid "9f808726-09d3-5692-a435-5070f152cddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186255075} {:answer/id #uuid "cd387a61-32a4-5106-b17f-5c138d6c2ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm \\sqrt{3}" :db/id #edb/ref 17592186255494}] :answer-field/correct {:answer/id #uuid "cd387a61-32a4-5106-b17f-5c138d6c2ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm \\sqrt{3}" :db/id #edb/ref 17592186255494} :answer-field/id #uuid "7461ea8a-3c02-5867-96b2-21f3b9f03a9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256136}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e5d7b42-493e-5694-92f6-e6ea1c2f15fb" :question/math-academy-id "q-122946" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=7(t-1),\\,y=2{t}^{3}-18t,\\,-\\infty <t<\\infty .\n$$\n\nDetermine the points at which the normal to the curve is vertical." :question/worked-solution "The normal is vertical if the tangent is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n\\begin{aligned}{x}^{′}(t)=7,\\,{y}^{′}(t)=6{t}^{2}-18.\\end{aligned}\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n6({t}^{2}-3)=0\\,⟹\\,t=\\pm \\sqrt{3}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{x}^{′}(-\\sqrt{3}) & =7\\ne 0, \\\\ {x}^{′}(\\sqrt{3}) & =7\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\pm \\sqrt{3}.$"}] [{:db/id #edb/ref 17592186256752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d597a98-c055-5f99-9bee-b68fbbdd90cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{4}" :db/id #edb/ref 17592186253785} {:answer/id #uuid "0f02ed52-8673-5cc6-908c-e93ec89237c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-\\frac{1}{4}" :db/id #edb/ref 17592186253801} {:answer/id #uuid "5bbc3b08-7caf-5e27-b46d-574424299686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-\\frac{1}{2}" :db/id #edb/ref 17592186254482} {:answer/id #uuid "80913870-a077-54f8-a853-f63a26091309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2}" :db/id #edb/ref 17592186254807} {:answer/id #uuid "e09500e3-b088-5b78-9a17-f963b264a9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{4}" :db/id #edb/ref 17592186255665}] :answer-field/correct {:answer/id #uuid "80913870-a077-54f8-a853-f63a26091309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2}" :db/id #edb/ref 17592186254807} :answer-field/id #uuid "e5601a63-8c5d-5677-8eb5-dd5f3c21d7f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "259b7265-587e-5b30-9b76-d6e0205b048e" :question/math-academy-id "q-122947" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=\\operatorname{ln}⁡(\\pi t)-2t,\\,y={e}^{2t},\\,0<t<\\infty .\n$$\n\nDetermine the value of the parameter $t$ at which the normal line to the curve is horizontal." :question/worked-solution "The normal line is horizontal when the tangent line to the curve is vertical. Therefore, we require ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=\\frac{1}{t}-2,\\,{y}^{′}(t)=2{e}^{2t}\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n\\frac{1}{t}-2=0\\,⟹\\,t=\\frac{1}{2}.\n$$\n\nNow, we note that\n\n$$\n{y}^{′}\\left(\\frac{1}{2}\\right)=2{e}^{2\\times (1/2)}=2e\\ne 0,\\,\\,\n$$\n\nwhich confirms that the normal to the curve is indeed horizontal when $t=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186259485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "422204c9-b7b4-55a6-916b-a5d0d3407fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186257369} {:answer/id #uuid "a2804747-2634-5527-96bb-b3c58af23dad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258205} {:answer/id #uuid "d3206e56-97e9-5861-9e65-b3b49d2e3d33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258627} {:answer/id #uuid "dc0f3193-274a-5d65-b2b8-1f83dbd28580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258697} {:answer/id #uuid "e098e2ca-3d83-57a6-9dae-855c6bff075f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258737}] :answer-field/correct {:answer/id #uuid "e098e2ca-3d83-57a6-9dae-855c6bff075f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258737} :answer-field/id #uuid "097f1726-9179-5df6-b366-af2e18265183" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d33d1de-f1c3-54d6-8864-08f78b7ba6b7" :question/math-academy-id "q-123173" :question/problem "Consider the vector field $F=({e}^{x}\\operatorname{sin}⁡y)\\,i-({e}^{x}\\operatorname{cos}⁡y)\\,j.$ \nEvaluate $∇\\cdot F$ at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}({e}^{x}\\operatorname{sin}⁡y)+\\frac{∂}{∂y}(-{e}^{x}\\operatorname{cos}⁡y) \\\\  & ={e}^{x}\\operatorname{sin}⁡y-{e}^{x}(-\\operatorname{sin}⁡y). \\\\  & =2{e}^{x}\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point  $(0,\\frac{\\pi }{2}),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(0,\\frac{\\pi }{2}) & =2{e}^{0}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =2\\cdot 1\\cdot 1 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40009387-47a9-502b-bd5f-f3dde55dcd0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{cos}⁡yz+xz" :db/id #edb/ref 17592186257356} {:answer/id #uuid "ae2fcf0d-78fd-5b9e-b1e2-2e872a328b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{cos}⁡yz" :db/id #edb/ref 17592186258302} {:answer/id #uuid "cdc0147c-45f9-5254-a39e-6c04b28b8428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{cos}⁡yz+xz+2" :db/id #edb/ref 17592186258563} {:answer/id #uuid "d2ed9a59-6327-5c52-a5f9-d81a53d8a6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{sin}⁡yz+xyz+2" :db/id #edb/ref 17592186258625} {:answer/id #uuid "e04475a1-0735-506c-9851-ac24e0742763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{sin}⁡yz+xz" :db/id #edb/ref 17592186258736}] :answer-field/correct {:answer/id #uuid "e04475a1-0735-506c-9851-ac24e0742763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{sin}⁡yz+xz" :db/id #edb/ref 17592186258736} :answer-field/id #uuid "930ad9a1-503e-52ed-84f2-ada7aa76796d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259291}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57e4e5b0-7fcd-59f4-9f86-aed07bc35e07" :question/math-academy-id "q-123176" :question/problem "Consider the vector field $F=⟨{e}^{x}\\operatorname{sin}⁡yz,\\,xyz,2⟩.$ Find $\\text{div}\\,F.$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}({e}^{x}\\operatorname{sin}⁡yz)+\\frac{∂}{∂y}(xyz)+\\frac{∂}{∂z}(2) \\\\  & ={e}^{x}\\operatorname{sin}⁡yz+xz.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2136e2e5-eda2-5d8c-a918-cc6e25b936c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+9y-12z" :db/id #edb/ref 17592186257054} {:answer/id #uuid "25df7a36-fb35-5a6b-a4f2-d81927845c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+6y-8z" :db/id #edb/ref 17592186257106} {:answer/id #uuid "38802d04-6400-526e-a3c7-774018ac66df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x+12y-16z" :db/id #edb/ref 17592186257281} {:answer/id #uuid "5d8c3701-5e7c-5b81-a7af-ecb760a2a77c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x+3y-4z)^{2}" :db/id #edb/ref 17592186257601} {:answer/id #uuid "a1dc10e2-998c-5132-90c3-1c176c2b128f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y-4z" :db/id #edb/ref 17592186258200}] :answer-field/correct {:answer/id #uuid "25df7a36-fb35-5a6b-a4f2-d81927845c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+6y-8z" :db/id #edb/ref 17592186257106} :answer-field/id #uuid "f5c380c2-6f7a-5fa6-a1cf-bdd2ef574b31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02dd9d18-cd94-5447-91da-e2448419b7b2" :question/math-academy-id "q-123179" :question/problem "Consider the vector field $F=(2x+3y-4z)^{2}\\,i+(2x+3y-4z)^{2}\\,j+(2x+3y-4z)^{2}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((2x+3y-4z)^{2})+\\frac{∂}{∂y}((2x+3y-4z)^{2})+\\frac{∂}{∂z}((2x+3y-4z)^{2}) \\\\  & =4(2x+3y-4z)+6(2x+3y-4z)-8(2x+3y-4z) \\\\  & =2(2x+3y-4z) \\\\  & =4x+6y-8z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71cbe9b9-abfb-59ee-9a3b-f7f689c26688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "144" :db/id #edb/ref 17592186257781} {:answer/id #uuid "88b7f1be-ad85-5371-a6af-84faa05bd3aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186257981} {:answer/id #uuid "d1c60dec-38f0-52c7-b0aa-6a4369234d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186258609} {:answer/id #uuid "d40a47e0-a307-5498-8db8-91105ba44fa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186258639} {:answer/id #uuid "edb9593d-e1cc-5ea7-ae77-b57065d0d67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186258838}] :answer-field/correct {:answer/id #uuid "d40a47e0-a307-5498-8db8-91105ba44fa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186258639} :answer-field/id #uuid "31c01b0b-506b-5b5b-95a1-7bc8278302dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259120}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "74e7bf88-8da6-528c-84d5-ded22deb1ee4" :question/math-academy-id "q-123200" :question/problem "Consider the vector field $F=(x-y)^{3}\\,i+(y+z)^{3}\\,j+(x+z)^{3}\\,k.$ Evaluate $\\text{div}\\,F$ at the point $(-2,2,2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((x-y)^{3})+\\frac{∂}{∂y}((y+z)^{3})+\\frac{∂}{∂z}((x+z)^{3}) \\\\  & =3(x-y)^{2}+3(y+z)^{2}+3(x+z)^{2}.\\end{aligned}\n$$\n\n \n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(-2,2,2),$ and obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F(-2,2,2) & =3((-2)-(2))^{2}+3((2)+(2))^{2}+3((-2)+(2))^{2} \\\\  & =3(-4)^{2}+3(4)^{2}+3(0)^{2} \\\\  & =96.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdadf6b7-b5f9-5ff7-9423-ee3c12b80906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437696} {:answer/id #uuid "7af