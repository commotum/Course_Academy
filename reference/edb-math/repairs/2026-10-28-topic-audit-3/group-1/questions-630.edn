#{[{:db/id #edb/ref 17592186281385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c74816-4778-5b3e-9b9d-61592212a8ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -1" :db/id #edb/ref 17592186278822} {:answer/id #uuid "66efcbd7-ca94-524f-8194-bf2ab8ec7909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -4" :db/id #edb/ref 17592186279524} {:answer/id #uuid "7e322087-6972-5dd3-bc74-439622637adf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 1" :db/id #edb/ref 17592186279723} {:answer/id #uuid "de555049-8982-5a84-b956-77472e9e1885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\le x\\le -2" :db/id #edb/ref 17592186280553} {:answer/id #uuid "f297fd21-f190-5d52-b646-39f42c20012e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 0" :db/id #edb/ref 17592186280704}] :answer-field/correct {:answer/id #uuid "19c74816-4778-5b3e-9b9d-61592212a8ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -1" :db/id #edb/ref 17592186278822} :answer-field/id #uuid "b4f491fa-0087-5e93-a231-d05100d4255a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281156}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97007632-9d2f-5a8a-900e-9e7bf33ec6d3" :question/math-academy-id "q-16199" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx={t}^{2}-2t,\\,\\,\\,y=3-t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the range of $x.$" :question/worked-solution "To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}-2t \\\\  & ={(t-1)}^{2}-{(1)}^{2} \\\\  & ={(t-1)}^{2}-1\\end{aligned}\n$$\n\nSince ${(t-1)}^{2}\\ge 0,$ we can conclude that $x\\ge -1.$"}] [{:db/id #edb/ref 17592186281386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15501fc5-9f05-535a-afa5-9a19654f94b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{5}{2},\\,y\\le -1" :db/id #edb/ref 17592186278781} {:answer/id #uuid "2ccf5191-8634-5b90-a807-77a0bbfed33b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 0,\\,y\\ge 0" :db/id #edb/ref 17592186278987} {:answer/id #uuid "2d91f8fb-c06a-5a6e-99ba-a8c38d385d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 5,\\,y\\ge 2" :db/id #edb/ref 17592186278993} {:answer/id #uuid "3cd9f045-3487-5be5-adc3-3d5b3edc327f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 4,\\,y\\le -2" :db/id #edb/ref 17592186279127} {:answer/id #uuid "eeef9da7-ffa6-5021-aee7-5cc4d1113afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\frac{25}{4},\\,y\\ge 0" :db/id #edb/ref 17592186280684}] :answer-field/correct {:answer/id #uuid "eeef9da7-ffa6-5021-aee7-5cc4d1113afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\frac{25}{4},\\,y\\ge 0" :db/id #edb/ref 17592186280684} :answer-field/id #uuid "43190c17-eebf-5453-8891-2414e96f88c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280947}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2dc3a2b7-620d-5940-a1aa-2a26502f43cc" :question/math-academy-id "q-16200" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=5t-{t}^{2},\\,\\,\\,y={t}^{2},\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & =5t-{t}^{2} \\\\  & =-({t}^{2}-5t) \\\\  & =-{(t-\\frac{5}{2})}^{2}+{\\left(\\frac{5}{2}\\right)}^{2} \\\\  & =-{(t-\\frac{5}{2})}^{2}+\\frac{25}{4}\\end{aligned}\n$$\n\nSince ${(t-\\frac{5}{2})}^{2}\\ge 0,$ we can conclude that $x\\le \\frac{25}{4}.$\n\n- To find the range of $y,$ notice that ${t}^{2}\\ge 0$ for all $t\\in (-\\infty ,\\infty ).$ Consequently, $y\\ge 0.$\n\nTherefore, the ranges are $x\\le \\frac{25}{4}$ and $y\\ge 0.$"}] [{:db/id #edb/ref 17592186281499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a529250-7d38-56c1-a622-ff64fed6a943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186278829} {:answer/id #uuid "2f3cea9e-711c-52bd-bf9d-eaae4c5bf127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\pi " :db/id #edb/ref 17592186279003} {:answer/id #uuid "417909d6-a428-5bad-93a3-7802edb9f815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16\\pi " :db/id #edb/ref 17592186279176} {:answer/id #uuid "520a773b-54ab-554d-965c-034440c2452d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186279338} {:answer/id #uuid "9219b018-274a-5760-bb2c-8a5c016a3ad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\pi " :db/id #edb/ref 17592186279893}] :answer-field/correct {:answer/id #uuid "2f3cea9e-711c-52bd-bf9d-eaae4c5bf127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\pi " :db/id #edb/ref 17592186279003} :answer-field/id #uuid "c807b5db-45e6-5011-a1a3-2596f4f3033b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c0ba9cf-530e-5fff-bddf-77afd0f80ef9" :question/math-academy-id "q-162569" :question/problem "![](images/58/581ac462bfcfead22a6c5ad4eb247f05adb1a677e92cac51954b0746cd083ab7.png)\n\nConsider the vector field $F=⟨x-y,\\,y+z,\\,2x-3z⟩$ and the surface $S$ defined by the bounding region of a right circular cylinder of height $3$ whose base is a circle of radius $2$ centered at the origin, as shown above. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x-y)+\\frac{∂}{∂y}(y+z)+\\frac{∂}{∂z}(2x-3z) \\\\  & =1+1+(-3) \\\\  & =-1.\\end{aligned}\n$$\n\nLet $R$ be the solid cylinder enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}-1\\,\\text{d}V \\\\  & =-{∭}_{R}\\,\\text{d}V \\\\  & =-\\text{Volume}(R) \\\\  & =-\\pi \\cdot {2}^{2}\\cdot 3 \\\\  & =-12\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d047b1e-3afb-5c5a-88f9-faeab4432ef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186279129} {:answer/id #uuid "565cbac4-9d5b-53f7-ad95-f3c76b6932d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186279384} {:answer/id #uuid "93da9f2a-8ea0-53d4-858e-491166b1dc48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186279908} {:answer/id #uuid "a5861e93-47f0-536a-a4e4-9d3f7a9b658a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186280057} {:answer/id #uuid "da4056b9-a344-5551-a7d2-55af24530e22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186280519}] :answer-field/correct {:answer/id #uuid "3d047b1e-3afb-5c5a-88f9-faeab4432ef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186279129} :answer-field/id #uuid "5b030670-12c0-5a90-a682-f7582e669ba1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280989}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c50889a1-249a-5104-a142-d8d313afba10" :question/math-academy-id "q-162572" :question/problem "![](images/aa/aac27058402f89bef73700129a7812b3cf4f971c11975fc1711a46b8d10e61fe.png)\n\nConsider the vector field $F=⟨3x+y{e}^{z},\\,xy+2,\\,1-xz⟩$ and the surface $S$ defined by the bounding region of the rectangular solid shown above in the first octant. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(3x+y{e}^{z})+\\frac{∂}{∂y}(xy+2)+\\frac{∂}{∂z}(1-xz) \\\\  & =3+x+(-x) \\\\  & =3.\\end{aligned}\n$$\n\nLet $R$ be the rectangular solid enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3\\,\\text{d}V \\\\  & =3{∭}_{R}\\,\\text{d}V \\\\  & =3\\cdot \\text{Volume}(R) \\\\  & =3\\cdot 1\\cdot 2\\cdot 3 \\\\  & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3274b94e-9050-5914-92cf-a20e7f33b9f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\pi " :db/id #edb/ref 17592186279033} {:answer/id #uuid "4021cef0-295e-5798-9f4f-2157ebca2b8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{128\\pi }{3}" :db/id #edb/ref 17592186279158} {:answer/id #uuid "59d4c631-de3a-5f80-abfd-ae0e4830d3d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{256\\pi }{3}" :db/id #edb/ref 17592186279414} {:answer/id #uuid "659a3952-f331-5c0f-9621-9a4212215836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96\\pi " :db/id #edb/ref 17592186279515} {:answer/id #uuid "a356390a-20fd-5203-b264-de87732ef03b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78\\pi " :db/id #edb/ref 17592186280042}] :answer-field/correct {:answer/id #uuid "659a3952-f331-5c0f-9621-9a4212215836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96\\pi " :db/id #edb/ref 17592186279515} :answer-field/id #uuid "4f6afff7-29bd-5084-9d8e-63605244a213" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280961}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9b12219-fd15-591a-8410-7eb56a488ff2" :question/math-academy-id "q-162578" :question/problem "Consider the positively (outward) oriented surface $S$ given by ${x}^{2}+{y}^{2}+(z-4)^{2}=4$ and the vector field $F=z\\,i+6y\\,j+(x+3z)\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(z)+\\frac{∂}{∂y}(6y)+\\frac{∂}{∂z}(x+3z) \\\\  & =0+6+3 \\\\  & =9.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $2$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}9\\,\\text{d}V \\\\  & =9{∭}_{R}\\,\\text{d}V \\\\  & =9\\cdot \\text{Volume}(R) \\\\  & =9\\cdot \\frac{4}{3}\\pi \\cdot {2}^{3} \\\\  & =96\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd0be77-03d3-5682-acf0-3a7644fad46d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186278994} {:answer/id #uuid "6d4cf883-7b99-518c-bfbc-917db8f1e538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186279587} {:answer/id #uuid "b9ca94f3-a2e6-5cf7-9f7b-6d1fec661b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32\\pi }{3}" :db/id #edb/ref 17592186280228} {:answer/id #uuid "d1b1f74d-c55b-5f6c-8668-cf5d8fcbf163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\pi " :db/id #edb/ref 17592186280442} {:answer/id #uuid "e434d311-7872-56cf-97d6-9851e8e02577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}" :db/id #edb/ref 17592186280605}] :answer-field/correct {:answer/id #uuid "e434d311-7872-56cf-97d6-9851e8e02577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}" :db/id #edb/ref 17592186280605} :answer-field/id #uuid "70df89b8-d119-5821-aca7-6b92f8aab9b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281032}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a625adb-c2bb-5fe3-8ab2-cff87a075be0" :question/math-academy-id "q-162580" :question/problem "Consider the positively (outward) oriented surface $S$ given by $(x+2)^{2}+(y-1)^{2}+{z}^{2}=1$ and the vector field $F=({y}^{2}-{x}^{2})\\,i+4y\\,j+2xz\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({y}^{2}-{x}^{2})+\\frac{∂}{∂y}(4y)+\\frac{∂}{∂z}(2xz) \\\\  & =-2x+4+2x \\\\  & =4.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $1$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}4\\,\\text{d}V \\\\  & =4{∭}_{R}\\,\\text{d}V \\\\  & =4\\cdot \\text{Volume}(R) \\\\  & =4\\cdot \\frac{4}{3}\\pi \\cdot {1}^{3} \\\\  & =\\frac{16\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100640c1-bb74-5261-b07b-162818bcec64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{y}^{{x}^{2}+y}\\,2xz\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186278736} {:answer/id #uuid "612e775d-f4d3-5491-a568-8632b1dc20b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{2y}^{2{x}^{2}+1}\\,{x}^{2}-1\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186279479} {:answer/id #uuid "a3e024e7-b5ac-5532-a30e-fcebd4a57c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{2y}^{2{x}^{2}+1}\\,y+z-2\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186280046} {:answer/id #uuid "bd3f43b4-3268-56c7-b7af-4bdd5b0709c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{y}^{{x}^{2}+y}\\,y+z-2\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186280255} {:answer/id #uuid "c001c748-078c-5145-9bb6-76a3e6bc31f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{y}^{{x}^{2}+y}\\,{x}^{2}-1\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186280282}] :answer-field/correct {:answer/id #uuid "c001c748-078c-5145-9bb6-76a3e6bc31f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{y}^{{x}^{2}+y}\\,{x}^{2}-1\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186280282} :answer-field/id #uuid "78ab3a06-7407-5d2e-b3fb-5448f190ff8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34056bf8-ebf0-50cf-86bc-5d67c31ea40b" :question/math-academy-id "q-162588" :question/problem "Let $S$ be the boundary of the finite solid region enclosed by the planes $x=0,$ $x=2,$ $y=0,$ $y=1,$ and the surfaces $z=y$ and $z={x}^{2}+y.$ Given that the surface $S$ is positively (outward) oriented and $F=(x+y)\\,i-2y\\,j+{x}^{2}z\\,k,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS=\n$$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x+y)+\\frac{∂}{∂y}(-2y)+\\frac{∂}{∂z}({x}^{2}z) \\\\  & =1+(-2)+{x}^{2} \\\\  & ={x}^{2}-1.\\end{aligned}\n$$\n\nTherefore, using the divergence theorem, we have\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}({x}^{2}-1)\\,\\text{d}V,\n$$\n\nwhere $R$ is a type I solid region that can be written as\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 1,\\,y\\le z\\le {x}^{2}+y\\}.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}-1\\,\\text{d}V & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{y}^{{x}^{2}+y}\\,{x}^{2}-1\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe9f3a4-5cf2-57da-bcd0-f2ef4cb40acb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2}\\,x+y\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186278733} {:answer/id #uuid "22082459-dc16-5814-aa58-32ad4a0572c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186278901} {:answer/id #uuid "54ac7f0f-775a-50ab-b1ab-fadfeb9bb310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,3{y}^{2}+xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186279362} {:answer/id #uuid "5e06d3d8-095d-5f06-bf6e-56940d9ad14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{2}^{{z}^{2}+{x}^{2}}\\,3{y}^{2}+xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186279452} {:answer/id #uuid "e7f6523c-8035-585f-ad29-1d759e7d0636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186280633}] :answer-field/correct {:answer/id #uuid "e7f6523c-8035-585f-ad29-1d759e7d0636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186280633} :answer-field/id #uuid "070d1c83-7b76-5bd7-a3dc-6b326edc9f9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280842}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e6de64a-d194-59f6-b620-cf3ddbd502d1" :question/math-academy-id "q-162589" :question/problem "Let $S$ be the boundary of the finite solid region enclosed by the planes $x=-1,$ $x=1,$ $z=0,$ $z=1,$ and the surfaces $y={x}^{2}+{z}^{2}$ and $y=2.$ Given that the surface $S$ is positively (outward) oriented and $F=({y}^{3}-z)\\,i+z\\,j+2xyz\\,k,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS=\n$$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({y}^{3}-z)+\\frac{∂}{∂y}(z)+\\frac{∂}{∂z}(2xyz) \\\\  & =0+0+2xy \\\\  & =2xy.\\end{aligned}\n$$\n\nTherefore, using the divergence theorem, we have\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}2xy\\,\\text{d}V,\n$$\n\nwhere $R$ is a type III solid region that can be written as\n\n$$\nR={(x,y,z)\\,:\\,-1\\le x\\le 1,\\,0\\le z\\le 1,\\,{x}^{2}+{z}^{2}\\le y\\le 2}.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}{∭}_{R}2xy\\,\\text{d}V & ={\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082e3c86-e949-5ff4-b33f-cb02c016d1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186278667} {:answer/id #uuid "149426fb-57b1-536b-9c11-dd047080a433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186278775} {:answer/id #uuid "16d8f309-fda3-575c-a9d3-a8ec0f44cdcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186278793} {:answer/id #uuid "4ae65590-f27f-55dc-9769-e7944f343866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186279261} {:answer/id #uuid "9c741780-eba9-5519-8797-113033813b77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186279984}] :answer-field/correct {:answer/id #uuid "9c741780-eba9-5519-8797-113033813b77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186279984} :answer-field/id #uuid "af809870-df22-50bf-a671-64310449b9b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281137}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e758b54-bd1f-5329-88cb-61523affaf73" :question/math-academy-id "q-162594" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=2,$ $y=0,$ $y=4,$ $z=1,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F={x}^{2}y\\,i+2z\\,j+xyz\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2}y)+\\frac{∂}{∂y}(2z)+\\frac{∂}{∂z}(xyz) \\\\  & =2xy+0+xy \\\\  & =3xy.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3xy\\,\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{4}{\\int }_{1}^{2}3xy\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\,\\text{d}x\\cdot {\\int }_{0}^{4}y\\,\\text{d}y\\cdot {\\int }_{1}^{2}3\\,\\text{d}z \\\\  & ={[\\frac{{x}^{2}}{2}]}_{x=0}^{x=2}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=0}^{y=4}\\cdot [3z]_{z=1}^{z=2} \\\\  & =(2-0)\\cdot (8-0)\\cdot (6-3) \\\\  & =48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52186257-9f4b-56fb-b960-29a2f63ea399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186279339} {:answer/id #uuid "697dee97-f93f-5355-b963-f4f2ed4536b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186279547} {:answer/id #uuid "b1c9b24c-57c8-5afa-a32e-082d761b5954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280164} {:answer/id #uuid "e0aaa464-a730-5cbb-ab6f-fdbf65421878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280578} {:answer/id #uuid "ebf8c058-83e0-502b-802f-07d67539564b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186280667}] :answer-field/correct {:answer/id #uuid "697dee97-f93f-5355-b963-f4f2ed4536b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186279547} :answer-field/id #uuid "12ac0596-1f70-519e-8661-fc2d524e2e33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dea24fde-a211-5010-b92d-b13afeca9f75" :question/math-academy-id "q-162596" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=1,$ $x=e,$ $y=0,$ $y=2,$ $z=0,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F=y\\operatorname{ln}⁡x\\,i+{z}^{2}\\,j+(x-{y}^{3})\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x)+\\frac{∂}{∂y}({z}^{2})+\\frac{∂}{∂z}(x-{y}^{3}) \\\\  & =\\frac{y}{x}+0+0 \\\\  & =\\frac{y}{x}.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}\\frac{y}{x}\\,\\text{d}V \\\\  & ={\\int }_{1}^{e}{\\int }_{0}^{2}{\\int }_{0}^{2}\\frac{y}{x}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}\\frac{1}{x}\\,\\text{d}x\\cdot {\\int }_{0}^{2}y\\,\\text{d}y\\cdot {\\int }_{0}^{2}\\text{d}z \\\\  & =[\\operatorname{ln}⁡x]_{x=1}^{x=e}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=0}^{y=2}\\cdot [z]_{z=0}^{z=2} \\\\  & =(\\operatorname{ln}⁡e-\\operatorname{ln}⁡1)\\cdot (\\frac{{2}^{2}}{2}-\\frac{{0}^{2}}{2})\\cdot (2-0) \\\\  & =(1-0)\\cdot (2-0)\\cdot (2-0) \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "453e572a-9b7a-5c8b-af0a-d4bbab3e02c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186279211} {:answer/id #uuid "719c2ade-ec2a-5fc4-81bc-42bee8f852aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279622} {:answer/id #uuid "a8b4c658-0c6e-58c5-a593-f19bdd138a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280083} {:answer/id #uuid "b7e4f34b-b03f-5102-8a05-51e7755ec9a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186280208} {:answer/id #uuid "bf7e88cc-1b76-537b-a6f1-169efb2d510e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280275}] :answer-field/correct {:answer/id #uuid "a8b4c658-0c6e-58c5-a593-f19bdd138a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280083} :answer-field/id #uuid "e81d88b2-55dd-5e26-8ccb-24f90e955d12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281246}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7cc5e4b-aa70-5d55-82a4-140961e3cc36" :question/math-academy-id "q-162599" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=1,$ $y=2,$ $z=1,$ $z=3.$ Given that the surface $S$ is positively (outward) oriented and $F={x}^{2}\\,i+2y\\,j+(x+{y}^{2})\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2})+\\frac{∂}{∂y}(2y)+\\frac{∂}{∂z}(x+{y}^{2}) \\\\  & =2x+2+0 \\\\  & =2x+2.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}(2x+2)\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{2}{\\int }_{1}^{3}(2x+2)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(2x+2)\\,\\text{d}x\\cdot {\\int }_{1}^{2}\\text{d}y\\cdot {\\int }_{1}^{3}\\text{d}z \\\\  & =[{x}^{2}+2x]_{x=0}^{x=1}\\cdot (2-1)\\cdot (3-1) \\\\  & =({1}^{2}+2(1)-0)\\cdot 1\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0828f14c-57b5-5bff-96a4-41f2ecf9c8cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278666} {:answer/id #uuid "601888a6-bae8-5265-8032-ca7466880974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186279474} {:answer/id #uuid "6f899f87-fc79-53d1-9d8b-59f00b8892d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279603} {:answer/id #uuid "ce7b1ce6-5db6-5b72-8254-8b233c23921a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186280411} {:answer/id #uuid "f34738d0-7faa-5814-82e1-6d902521196c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280717}] :answer-field/correct {:answer/id #uuid "6f899f87-fc79-53d1-9d8b-59f00b8892d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279603} :answer-field/id #uuid "22288074-59ca-5f02-9943-023604b9357b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a55db798-fcb0-54c3-9d76-3d7d1e841ffa" :question/math-academy-id "q-162600" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=1,$ $y=2,$ $z=-1,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=2y\\,i+x{y}^{2}\\,j+2xyz\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(2y)+\\frac{∂}{∂y}(x{y}^{2})+\\frac{∂}{∂z}(2xyz) \\\\  & =0+2xy+2xy \\\\  & =4xy.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}4xy\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{2}{\\int }_{-1}^{1}4xy\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}2x\\,\\text{d}x\\cdot {\\int }_{1}^{2}2y\\,\\text{d}y\\cdot {\\int }_{-1}^{1}\\text{d}z \\\\  & =[{x}^{2}]_{x=0}^{x=1}\\cdot [{y}^{2}]_{y=1}^{y=2}\\cdot (1-(-1)) \\\\  & =(1-0)\\cdot (4-1)\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "546085f7-b447-560f-8e03-5f9f83d6f2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-t\\operatorname{sin}⁡({t}^{2})" :db/id #edb/ref 17592186282406} {:answer/id #uuid "74f33be1-f6b9-527c-9c36-b38596ce0f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t)" :db/id #edb/ref 17592186282688} {:answer/id #uuid "8d6ac22c-45ee-5e02-aa23-fa2d93a62a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t)" :db/id #edb/ref 17592186282915} {:answer/id #uuid "8d8a9385-1ddd-50d1-9fa6-1227b2a8f619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2t\\operatorname{sin}⁡({t}^{2})\\operatorname{cos}⁡(t)" :db/id #edb/ref 17592186282916} {:answer/id #uuid "91107c67-4b51-563a-9b9f-7ec21682f202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)" :db/id #edb/ref 17592186282947}] :answer-field/correct {:answer/id #uuid "8d6ac22c-45ee-5e02-aa23-fa2d93a62a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t)" :db/id #edb/ref 17592186282915} :answer-field/id #uuid "db0740db-ef2c-573e-a13f-6da541dd04e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284317}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2f247252-c196-59cb-b56b-5c53685b26d2" :question/math-academy-id "q-170668" :question/problem "If $f(x,y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y,x={t}^{2},$ and $y=t,$ compute $\\frac{\\text{d}f}{\\text{d}t}.$" :question/worked-solution "![](images/f0/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x=x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}t}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\operatorname{cos}⁡x\\operatorname{cos}⁡y,\\,\\frac{∂f}{∂y}=-\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t), \\\\ \\frac{∂f}{∂y} & =-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t).\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=2t,\\,\\frac{\\text{d}y}{\\text{d}t}=1.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)\\cdot 2t+(-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t))\\cdot 1 \\\\  & =2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021a846a-8825-55bf-a7b3-1dc5c5c5ff19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+1)\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186281709} {:answer/id #uuid "49b2d0a3-8640-5928-a7d2-f8a14102a68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x(1+\\operatorname{ln}⁡({x}^{2}+1))" :db/id #edb/ref 17592186282314} {:answer/id #uuid "e8a1e1c7-9e8a-5f17-9500-4d7507d44b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x({x}^{2}+1)}{\\operatorname{ln}⁡({x}^{2}+1)}" :db/id #edb/ref 17592186283715} {:answer/id #uuid "efd819c9-60d2-5826-9266-3dba4a49aaec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{\\operatorname{ln}⁡({x}^{2}+1)}" :db/id #edb/ref 17592186283779} {:answer/id #uuid "f5de75cd-c44e-5baf-9f07-d98f3333edab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186283839}] :answer-field/correct {:answer/id #uuid "49b2d0a3-8640-5928-a7d2-f8a14102a68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x(1+\\operatorname{ln}⁡({x}^{2}+1))" :db/id #edb/ref 17592186282314} :answer-field/id #uuid "d658fcd0-7d37-5a87-a5b6-42706ffef583" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284307}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cdba7da9-8893-51f6-a38d-eccc847b176c" :question/math-academy-id "q-170670" :question/problem "If $f(x,y)=y\\operatorname{ln}⁡({x}^{2}+1)$ and $y={x}^{2}+1,$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{2xy}{{x}^{2}+1},\\,\\frac{∂f}{∂y}=\\operatorname{ln}⁡({x}^{2}+1)\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{2x({x}^{2}+1)}{{x}^{2}+1}=2x, \\\\ \\frac{∂f}{∂y} & =\\operatorname{ln}⁡({x}^{2}+1).\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2x+\\operatorname{ln}⁡({x}^{2}+1)\\cdot 2x \\\\  & =2x(1+\\operatorname{ln}⁡({x}^{2}+1)).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67fa4d19-1a26-5b2d-9556-c54c686ac534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡s\\operatorname{cos}⁡t" :db/id #edb/ref 17592186282582} {:answer/id #uuid "734e21fc-611a-5299-a426-c78cc36493b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{sin}⁡s\\operatorname{sin}⁡t" :db/id #edb/ref 17592186282676} {:answer/id #uuid "778709fb-5770-565c-b6f9-6f6b5c95ff0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{cos}⁡s\\operatorname{cos}⁡t" :db/id #edb/ref 17592186282710} {:answer/id #uuid "bcf8784d-5d98-5e83-8104-3b5974f0cfbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{cos}⁡s\\operatorname{sin}⁡t" :db/id #edb/ref 17592186283327} {:answer/id #uuid "e535fa66-984a-5f50-aa43-6100959c6fcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t" :db/id #edb/ref 17592186283689}] :answer-field/correct {:answer/id #uuid "e535fa66-984a-5f50-aa43-6100959c6fcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t" :db/id #edb/ref 17592186283689} :answer-field/id #uuid "13047c11-f65c-581c-a388-dd6cb0189624" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283972}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4ab94495-9213-5241-a548-3a7deeaeec18" :question/math-academy-id "q-170672" :question/problem "Let $f(x,y)=xy,$ where $x=\\operatorname{cos}⁡t+\\operatorname{sin}⁡s$ and $y=\\operatorname{sin}⁡t.$ Calculate $\\frac{∂f}{∂t}.$" :question/worked-solution "![](images/11/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{sin}⁡t, \\\\ \\frac{∂f}{∂y} & =\\operatorname{cos}⁡t+\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =-\\operatorname{sin}⁡t, \\\\ \\frac{∂y}{∂t} & =\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =\\operatorname{sin}⁡t(-\\operatorname{sin}⁡t)+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡s)\\cdot \\operatorname{cos}⁡t \\\\  & =-{sin}^{2}⁡t+{cos}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2954df91-e2e3-5363-9cf7-40eb665f51bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t+s}(s+t)" :db/id #edb/ref 17592186282047} {:answer/id #uuid "2bd2664d-1f59-5b44-bee4-99dfe3cb5c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t{e}^{t+s}(s-t)" :db/id #edb/ref 17592186282074} {:answer/id #uuid "80097d83-68ae-522a-8521-7188df6108f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t{e}^{t+s}(s+1)" :db/id #edb/ref 17592186282790} {:answer/id #uuid "8f85d891-1ebb-510b-809c-ca4e33750cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s{e}^{t+s}" :db/id #edb/ref 17592186282932} {:answer/id #uuid "b5f69daa-8b78-5912-b3b2-04861a1d8880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s{e}^{t+s}(t+1)" :db/id #edb/ref 17592186283268}] :answer-field/correct {:answer/id #uuid "80097d83-68ae-522a-8521-7188df6108f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t{e}^{t+s}(s+1)" :db/id #edb/ref 17592186282790} :answer-field/id #uuid "b11ef35f-87cc-5868-8479-09e0da99d040" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284242}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2f91ae07-5e1e-548f-8551-8d2cfc3e050d" :question/math-academy-id "q-170673" :question/problem "Let $f(x,y)=y{e}^{x},$ where $x=t+s$ and $y=ts.$ Calculate $\\frac{∂f}{∂s}.$" :question/worked-solution "![](images/21/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y{e}^{x},\\,\\frac{∂f}{∂y}={e}^{x}\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =ts{e}^{t+s}, \\\\ \\frac{∂f}{∂y} & ={e}^{t+s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =1, \\\\ \\frac{∂y}{∂s} & =t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =(ts{e}^{t+s})(1)+({e}^{t+s})(t) \\\\  & =t{e}^{t+s}(s+1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0846d8ac-217c-5fd0-9480-a245a8fb32df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186281757} {:answer/id #uuid "3390d758-2eee-59f2-b281-5202d0af878a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186282151} {:answer/id #uuid "ca69f0e4-75f3-50e2-9045-04b99ce39acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283458} {:answer/id #uuid "cf9a9896-fab1-5267-a73b-efbd2002049c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283500} {:answer/id #uuid "ec3a6c74-8de8-5dd3-a5c7-a7d063aa2bb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186283752}] :answer-field/correct {:answer/id #uuid "3390d758-2eee-59f2-b281-5202d0af878a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186282151} :answer-field/id #uuid "f863b767-90fc-5d51-a406-d14dbceafe99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284375}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5342e0ff-5836-5e24-9c29-40f19b250df2" :question/math-academy-id "q-170675" :question/problem "Let $f(x,y,z)=\\frac{y+z}{x},$ where $x=s+t,$ $y={s}^{2}$ and $z={t}^{2}.$ Given that\n\n$$\n\\frac{∂f}{∂t}=\\frac{{c}_{1}{s}^{2}+{c}_{2}st+{c}_{3}{t}^{2}}{(s+t)^{2}},\n$$\n\nfind the value of ${c}_{1}+{c}_{2}+{c}_{3}.$" :question/worked-solution "![](images/b5/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{y+z}{{x}^{2}},\\,\\frac{∂f}{∂y}=\\frac{1}{x},\\,\\frac{∂f}{∂z}=\\frac{1}{x}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{1}{s+t}, \\\\ \\frac{∂f}{∂z} & =\\frac{1}{s+t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =0, \\\\ \\frac{∂z}{∂t} & =2t.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}\\cdot (1)+\\frac{1}{s+t}\\cdot 0+\\frac{1}{s+t}\\cdot 2t \\\\  & =\\frac{-({s}^{2}+{t}^{2})+2t(s+t)}{(s+t)^{2}} \\\\  & =\\frac{{t}^{2}+2ts-{s}^{2}}{(s+t)^{2}}.\\end{aligned}\n$$\n\nFinally, ${c}_{1}=-1,$ ${c}_{2}=2$ and ${c}_{3}=1,$ and therefore\n\n$$\n{c}_{1}+{c}_{2}+{c}_{3}=-1+2+1=2.\n$$"}] [{:db/id #edb/ref 17592186287896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0129d731-f714-58fd-a0f4-24b3397a3c52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186284799} {:answer/id #uuid "3ca2f3ac-2d40-55c0-9878-56098109e882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186285357} {:answer/id #uuid "951be677-f285-5423-a71d-c0123993a6fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286143} {:answer/id #uuid "d8b9791c-d2f8-572f-a0d7-c0350a6e9243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186286762} {:answer/id #uuid "ec07f06e-b367-5592-af74-5dc9167e28d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286952}] :answer-field/correct {:answer/id #uuid "d8b9791c-d2f8-572f-a0d7-c0350a6e9243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186286762} :answer-field/id #uuid "1acc7786-27df-504b-ac8b-b03d343e0368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287198}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8afbd9d-433d-5de0-b2c9-a0c3ed7a6348" :question/math-academy-id "q-18657" :question/problem "Let $a=⟨-2,0,1⟩$, $b=⟨5,2,-4⟩$ and $c=⟨1,0,3⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}-2 & 0 & 1 \\\\ 5 & 2 & -4 \\\\ 1 & 0 & 3\\end{vmatrix} \\\\  & =(-2)\\cdot \\begin{vmatrix}2 & -4 \\\\ 0 & 3\\end{vmatrix}-0\\cdot \\begin{vmatrix}5 & -4 \\\\ 1 & 3\\end{vmatrix}+1\\cdot \\begin{vmatrix}5 & 2 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-2(2\\cdot 3-(-4)\\cdot 0)-0+(5\\cdot 0-2\\cdot 1) \\\\  & =-12-0-2 \\\\  & =-14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a39cb08-b579-5a48-a70b-56ed38fa7c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186285022} {:answer/id #uuid "3662dd06-672a-55c4-b8a5-1f114830ec13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186285292} {:answer/id #uuid "7d872dfb-a0b1-5bbe-85f0-77928067084a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186285942} {:answer/id #uuid "dff82d24-8d6e-5267-936b-56f9803096de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286829} {:answer/id #uuid "e05125b1-b319-55eb-a696-0b12a6d73055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286831}] :answer-field/correct {:answer/id #uuid "e05125b1-b319-55eb-a696-0b12a6d73055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286831} :answer-field/id #uuid "9fb1f5b4-15ac-5534-aeb5-ffcb51eeab93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72f9bd31-58da-5cc4-b44f-c7d388daa64d" :question/math-academy-id "q-18658" :question/problem "Find $b\\cdot (a\\times c)$, if $4a\\cdot (-b\\times c)=12.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}4a\\cdot (-b\\times c) & =12 \\\\ 4\\cdot (-1)\\cdot [a\\cdot (b\\times c)] & =12 \\\\ a\\cdot (b\\times c) & =-3.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5020a2d7-9f9e-5825-bd32-032ccbbb7eeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,6⟩" :db/id #edb/ref 17592186285530} {:answer/id #uuid "a9455fcf-bfc0-5f72-97dd-8c4e331d50d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,0,0⟩" :db/id #edb/ref 17592186286331} {:answer/id #uuid "ad434c36-e9a0-5766-b7da-a642190b4361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-10,0⟩" :db/id #edb/ref 17592186286372} {:answer/id #uuid "bb03a596-01e0-50d3-82a5-a8ee81546ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-10,0,10⟩" :db/id #edb/ref 17592186286490} {:answer/id #uuid "d6ac5ad3-a9c9-5489-aeff-561e8eaaf2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,-10⟩" :db/id #edb/ref 17592186286741}] :answer-field/correct {:answer/id #uuid "d6ac5ad3-a9c9-5489-aeff-561e8eaaf2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,-10⟩" :db/id #edb/ref 17592186286741} :answer-field/id #uuid "f2d199ca-0242-5298-b8d1-0081577a8f81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "034087b3-a93a-5e90-bae0-492e734813aa" :question/math-academy-id "q-19778" :question/problem "Let $a=⟨2,3,0⟩$ and $b=⟨6,4,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 & 0 \\\\ 6 & 4 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 0 \\\\ 4 & 0\\end{vmatrix}i-\\begin{vmatrix}2 & 0 \\\\ 6 & 0\\end{vmatrix}j+\\begin{vmatrix}2 & 3 \\\\ 6 & 4\\end{vmatrix}k \\\\  & =(3\\cdot 0-4\\cdot 0)i-(2\\cdot 0-6\\cdot 0)j+(2\\cdot 4-6\\cdot 3)k \\\\  & =(0)i-(0)j+(8-18)k \\\\  & =⟨0,0,-10⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3667975a-08ab-553b-aaa5-3e11181b33b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8i" :db/id #edb/ref 17592186285293} {:answer/id #uuid "76ce9755-8e9a-535b-b7c9-a11c10deb2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6j" :db/id #edb/ref 17592186285893} {:answer/id #uuid "78e3ab46-0643-52fc-806d-f544336547b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3k" :db/id #edb/ref 17592186285913} {:answer/id #uuid "dec73641-897d-5ca8-94a5-bd30ad1e5038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4i-2j+3k" :db/id #edb/ref 17592186286816} {:answer/id #uuid "f9b8797b-5449-567c-9675-9327a56ee50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3i+8k" :db/id #edb/ref 17592186287070}] :answer-field/correct {:answer/id #uuid "76ce9755-8e9a-535b-b7c9-a11c10deb2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6j" :db/id #edb/ref 17592186285893} :answer-field/id #uuid "baf0953c-0de9-59ad-a7d5-d92d682f01e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287535}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c7fa80b-0a29-596e-9b7c-a95cdd0f45ff" :question/math-academy-id "q-19782" :question/problem "Let $a=⟨0,0,3⟩$ and $b=⟨2,0,1⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 0 & 0 & 3 \\\\ 2 & 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 3 \\\\ 0 & 1\\end{vmatrix}i-\\begin{vmatrix}0 & 3 \\\\ 2 & 1\\end{vmatrix}j+\\begin{vmatrix}0 & 0 \\\\ 2 & 0\\end{vmatrix}k \\\\  & =((0)(1)-(0)(3))i-((0)(1)-(2)(3))j+((0)(0)-(2)(0))k \\\\  & =(0-0)i-(0-6)j+(0-0)k \\\\  & =6j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5faf31-a027-54f6-893d-fa34e1417998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,-4" :db/id #edb/ref 17592186285338} {:answer/id #uuid "493b1d43-5539-572e-ab49-36f99c567690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186285461} {:answer/id #uuid "55ef5465-6e15-524b-ae92-901d3537d994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186285578} {:answer/id #uuid "e52f12ca-7b96-5ce8-9839-d0542ceca526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 5" :db/id #edb/ref 17592186286885} {:answer/id #uuid "fdeb9f25-fa5b-5fd4-a92b-3143e29bce7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,5" :db/id #edb/ref 17592186287111}] :answer-field/correct {:answer/id #uuid "55ef5465-6e15-524b-ae92-901d3537d994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186285578} :answer-field/id #uuid "4f1a7ec0-67e0-5864-a6a8-3f8391794ca7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287324}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "421f4045-e8df-5b08-89fb-dae822bc3289" :question/math-academy-id "q-19785" :question/problem "Let $a=⟨x,2,3⟩$, $b=⟨2x,5,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{393}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ x & 2 & 3 \\\\ 2x & 5 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 3 \\\\ 5 & 2\\end{vmatrix}i-\\begin{vmatrix}x & 3 \\\\ 2x & 2\\end{vmatrix}j+\\begin{vmatrix}x & 2 \\\\ 2x & 5\\end{vmatrix}k \\\\  & =(4-15)i-(2x-6x)j+(5x-4x)k \\\\  & =⟨-11,4x,x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-11)^{2}+(4x)^{2}+{x}^{2}} \\\\  & =\\sqrt{121+16{x}^{2}+{x}^{2}} \\\\  & =\\sqrt{17{x}^{2}+121}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{393} \\\\ \\sqrt{17{x}^{2}+121} & =\\sqrt{393} \\\\ 17{x}^{2}+121 & =393 \\\\ 17{x}^{2} & =272 \\\\ {x}^{2} & =16.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 4.$"}] [{:db/id #edb/ref 17592186287960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e60b001-dfb1-5dc2-969f-1ce9bc37dbf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14i+18j+6k" :db/id #edb/ref 17592186285377} {:answer/id #uuid "4a894bf5-7c7a-597b-89fe-f229f8f83d21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8i+12j-7k" :db/id #edb/ref 17592186285479} {:answer/id #uuid "8176a14c-aca9-53e8-a862-57248dcb858e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8i+12j-17k" :db/id #edb/ref 17592186285977} {:answer/id #uuid "c5a035c5-365c-5e4b-988f-bcc32956663e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7i+8j-12k" :db/id #edb/ref 17592186286601} {:answer/id #uuid "cd29bd0c-cc6b-5f2a-8b41-1e64fd0c3938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12i+8j-7k" :db/id #edb/ref 17592186286653}] :answer-field/correct {:answer/id #uuid "cd29bd0c-cc6b-5f2a-8b41-1e64fd0c3938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12i+8j-7k" :db/id #edb/ref 17592186286653} :answer-field/id #uuid "13658426-b0c4-540a-b768-7c63884c9bb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287183}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07d09c7b-7392-52f3-9600-f879fb6f51f7" :question/math-academy-id "q-19787" :question/problem "Let $a=⟨1,5,4⟩$ and $b=⟨2,3,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 1 & 5 & 4 \\\\ 2 & 3 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & 4 \\\\ 3 & 0\\end{vmatrix}i-\\begin{vmatrix}1 & 4 \\\\ 2 & 0\\end{vmatrix}j+\\begin{vmatrix}1 & 5 \\\\ 2 & 3\\end{vmatrix}k \\\\  & =((5)(0)-(3)(4))i-((1)(0)-(2)(4))j+((1)(3)-(2)(5))k \\\\  & =(0-12)i-(0-8)j+(3-10)k \\\\  & =-12i+8j-7k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "324bb0a2-1e58-5110-85e8-223ec5c31d49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4i-6j-4k" :db/id #edb/ref 17592186285245} {:answer/id #uuid "35e5b8f3-f28f-5754-815f-37856bbdbf9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6i-4j-6k" :db/id #edb/ref 17592186285284} {:answer/id #uuid "8aab332c-d88c-5fb7-810c-e135d75d2eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6i-4j-4k" :db/id #edb/ref 17592186286057} {:answer/id #uuid "bf43c6dc-721a-570b-8689-22c13767de40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6i-6j-4k" :db/id #edb/ref 17592186286536} {:answer/id #uuid "d0ae6093-79e3-5434-86c4-c6d91adf63c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6i+6j-4k" :db/id #edb/ref 17592186286688}] :answer-field/correct {:answer/id #uuid "bf43c6dc-721a-570b-8689-22c13767de40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6i-6j-4k" :db/id #edb/ref 17592186286536} :answer-field/id #uuid "ebf08037-b52f-5949-be2b-9462e4517db4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287634}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0f6e61a-90ab-51e6-8143-08dbdea1e5a2" :question/math-academy-id "q-19789" :question/problem "Let $a=⟨-2,2,0⟩$ and $b=⟨0,2,-3⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ -2 & 2 & 0 \\\\ 0 & 2 & -3\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 0 \\\\ 2 & -3\\end{vmatrix}i-\\begin{vmatrix}-2 & 0 \\\\ 0 & -3\\end{vmatrix}j+\\begin{vmatrix}-2 & 2 \\\\ 0 & 2\\end{vmatrix}k \\\\  & =((2)(-3)-(2)(0))i-((-2)(-3)-(0)(0))j+((-2)(2)-(0)(2))k \\\\  & =(-6-0)i-(6-0)j+(-4-0)k \\\\  & =-6i-6j-4k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1868bb81-71b6-5f50-8657-a4862c1f609e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186285005} {:answer/id #uuid "2cdccd16-86aa-576c-bb76-82d6055e2720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186285184} {:answer/id #uuid "39d88586-7aa2-5d90-adfe-ac64bd3a8ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186285331} {:answer/id #uuid "a567177a-6805-5d8a-9d10-fde433c3ecd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186286298} {:answer/id #uuid "de641599-4761-523f-91dd-a114e0a85611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186286811}] :answer-field/correct {:answer/id #uuid "1868bb81-71b6-5f50-8657-a4862c1f609e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186285005} :answer-field/id #uuid "699666f7-e0ff-5c75-8d34-1ee5373ce603" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75f9d3bd-a296-5c60-a85d-8a17773b59f9" :question/math-academy-id "q-20050" :question/problem "Let $a=⟨1,3,2⟩$, $b=⟨3,4,1⟩$ and $c=⟨2,0,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}1 & 3 & 2 \\\\ 3 & 4 & 1 \\\\ 2 & 0 & 1\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}4 & 1 \\\\ 0 & 1\\end{vmatrix}-3\\cdot \\begin{vmatrix}3 & 1 \\\\ 2 & 1\\end{vmatrix}+2\\cdot \\begin{vmatrix}3 & 4 \\\\ 2 & 0\\end{vmatrix} \\\\  & =(4\\cdot 1-0\\cdot 1)-3(3\\cdot 1-2\\cdot 1)+2(3\\cdot 0-2\\cdot 4) \\\\  & =4-3-16 \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "300c21b4-1756-505c-8887-69d902ae3677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186285224} {:answer/id #uuid "8ae0a167-e7b0-520f-9327-565bd22dde8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186286063} {:answer/id #uuid "b624085b-014c-5e50-8b4b-f36fd36a52f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286450} {:answer/id #uuid "c2e671b4-92f5-5e79-bde0-a4e9c92974ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186286575} {:answer/id #uuid "fb65991f-7c1a-5dcd-bc51-9c721902f012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287082}] :answer-field/correct {:answer/id #uuid "b624085b-014c-5e50-8b4b-f36fd36a52f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286450} :answer-field/id #uuid "43229f82-3e46-5de5-bed3-19f2997ba66e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287295}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d05a20b-4c69-5e8d-bc26-f4e99fd04a4c" :question/math-academy-id "q-20054" :question/problem "Let $a=⟨1,-1,2⟩$, $b=⟨2,0,3⟩$ and $c=⟨2,4,2⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}1 & -1 & 2 \\\\ 2 & 0 & 3 \\\\ 2 & 4 & 2\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}0 & 3 \\\\ 4 & 2\\end{vmatrix}-(-1)\\cdot \\begin{vmatrix}2 & 3 \\\\ 2 & 2\\end{vmatrix}+2\\cdot \\begin{vmatrix}2 & 0 \\\\ 2 & 4\\end{vmatrix} \\\\  & =(0\\cdot 2-4\\cdot 3)+(2\\cdot 2-2\\cdot 3)+2(2\\cdot 4-2\\cdot 0) \\\\  & =-12-2+16 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a607223-785e-5cff-8277-d92c5f3d0777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186285759} {:answer/id #uuid "6e20a81c-cff1-5ff1-b73d-d10c562c1a25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186285799} {:answer/id #uuid "80342989-2647-571f-90ff-be229007da46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186285967} {:answer/id #uuid "8abc3ef5-68c1-5144-a25f-535e4971cc4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186286061} {:answer/id #uuid "c68857fa-0048-5c97-a44d-6947be333673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186286611}] :answer-field/correct {:answer/id #uuid "6e20a81c-cff1-5ff1-b73d-d10c562c1a25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186285799} :answer-field/id #uuid "7e186f66-10ed-5119-b542-02bab7058776" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287411}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "776762cc-349d-58d4-963e-1a4cb8589eee" :question/math-academy-id "q-20057" :question/problem "Find $b\\cdot (a\\times c)$, if $3a\\cdot (2b\\times (-c))=8.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (2b\\times (-c)) & =8 \\\\ 3\\cdot 2\\cdot (-1)\\cdot [a\\cdot (b\\times c)] & =8 \\\\ a\\cdot (b\\times c) & =-\\frac{4}{3}.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =\\frac{4}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343abe13-b014-58c0-913d-2fc9f7a11d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285270} {:answer/id #uuid "4c3b1e45-a9c8-5b28-b558-ec4bc793eb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186285496} {:answer/id #uuid "a878dcad-4ddf-585b-a29e-6f1bfa1aa273" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186286324} {:answer/id #uuid "c9e6bcc3-f1d7-59c6-953b-c03961aeaf47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286630} {:answer/id #uuid "fbedc400-7438-5567-8dfa-d1cfcb39be79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186287087}] :answer-field/correct {:answer/id #uuid "fbedc400-7438-5567-8dfa-d1cfcb39be79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186287087} :answer-field/id #uuid "42a770db-2d9f-5df9-858e-0db4cb77fe94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae812812-92a4-5aa7-85f9-50adcd0043cf" :question/math-academy-id "q-20059" :question/problem "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2871030f-535f-5bad-960f-2518315ab868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186285139} {:answer/id #uuid "395873e5-15bd-53dd-8303-0a9cb00704ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186285327} {:answer/id #uuid "4c9995e8-b44e-5b2b-a77c-68b604f74177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186285501} {:answer/id #uuid "c2f44045-fc84-58ca-8c0c-ea930c16cece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186286576} {:answer/id #uuid "dc4e1f02-b381-51f4-825c-11efa8be82bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286791}] :answer-field/correct {:answer/id #uuid "c2f44045-fc84-58ca-8c0c-ea930c16cece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186286576} :answer-field/id #uuid "e0ca935c-f519-5702-93c9-2f479ee86077" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2054ccd0-385b-55a1-9e4b-6c29d327d7d8" :question/math-academy-id "q-20061" :question/problem "Find $c\\cdot (b\\times a)$, if $3a\\cdot (6b\\times c)=90.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (6b\\times c) & =90 \\\\ 3\\cdot 6\\cdot [a\\cdot (b\\times c)] & =90 \\\\ a\\cdot (b\\times c) & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02788049-040e-5c76-86e2-58bb6a5bbbef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186284808} {:answer/id #uuid "5833d2bf-74d0-5ea2-94bc-f893f8489ff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-2" :db/id #edb/ref 17592186285598} {:answer/id #uuid "98173c7f-8ba4-5f06-88fe-3425d308e469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186286180} {:answer/id #uuid "ab587a99-40a5-5596-90ea-b5a5e96c6204" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3" :db/id #edb/ref 17592186286350} {:answer/id #uuid "e27e9371-7143-528d-820d-b073e0dc0b31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-1" :db/id #edb/ref 17592186286851}] :answer-field/correct {:answer/id #uuid "02788049-040e-5c76-86e2-58bb6a5bbbef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186284808} :answer-field/id #uuid "3f6ee0e5-3926-5962-8761-13aa6562ef64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287282}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6e05e4c-c6f0-521f-b67c-d81eff855827" :question/math-academy-id "q-20853" :question/problem "A curve is defined by the parametric equations \n\n$$\nx=2(t+1),\\,y=4{t}^{2},\\,-\\infty <t<\\infty .\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is horizontal." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is horizontal if ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=2,\\,{y}^{′}(t)=8t.\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n8t=0\\,⟹\\,t=0.\n$$\n\nNote that ${x}^{′}(0)=2\\ne 0.$ Therefore, we conclude that when $t=0,$ the tangent to the curve is horizontal."}]}
