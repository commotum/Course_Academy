92186045498 :db/ident :answer.type/math} :answer/value "-53" :db/id #edb/ref 17592186510592} {:answer/id #uuid "5a45335c-0747-5658-a1a1-8dcc4e6b2bec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "73" :db/id #edb/ref 17592186510598} {:answer/id #uuid "743f69db-b6d7-50e5-8be2-f54f2a9df891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186510603} {:answer/id #uuid "9f12c9fb-58fd-5159-a223-ceb280301cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53" :db/id #edb/ref 17592186510608}] :answer-field/correct {:answer/id #uuid "2ccb65b3-0b0e-53b6-8f74-22bfdac0a350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-53" :db/id #edb/ref 17592186510592} :answer-field/id #uuid "92871f7e-544d-5041-969a-893db76a52c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "68683bb5-6e50-58ec-b9cd-38db80945d39" :question/problem "What is $\\begin{vmatrix}-1 & -9 \\\\ -7 & -10\\end{vmatrix}$?" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-1 & -9 \\\\ -7 & -10\\end{vmatrix} & =-1\\cdot (-10)-(-9)\\cdot (-7) \\\\  & =10-63 \\\\  & =-53\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d3ba017-304d-5563-b51d-7e1f4f2d1a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186510596}] :answer-field/correct {:answer/id #uuid "4d3ba017-304d-5563-b51d-7e1f4f2d1a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186510596} :answer-field/id #uuid "a00250fb-51e3-5ea7-bb3a-d6728b1caebb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510609}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae33cd48-4286-533b-a46d-20551d42a300" :question/problem "Calculate $det(R)$ given that\n$$\n\\displaystyle R=\\begin{bmatrix}-8 & 14 \\\\ -7 & 13\\end{bmatrix}.\n$$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =\\begin{vmatrix}-8 & 14 \\\\ -7 & 13\\end{vmatrix} \\\\  & =(-8)(13)-(14)(-7) \\\\  & =-104+98 \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7510b5f-6370-56f3-aaeb-ffce4ec766ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186510621}] :answer-field/correct {:answer/id #uuid "f7510b5f-6370-56f3-aaeb-ffce4ec766ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186510621} :answer-field/id #uuid "d775c716-9480-511e-b2f7-a5ea4fe55174" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510618}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b02768f5-2401-5388-9659-b87f57ee6732" :question/problem "Calculate $det(A)$ given that\n$$\n\\displaystyle A=\\begin{bmatrix}7 & -12 \\\\ 7 & -15\\end{bmatrix}.\n$$\n\n$det(A)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}7 & -12 \\\\ 7 & -15\\end{vmatrix} \\\\  & =(7)(-15)-(-12)(7) \\\\  & =-105+84 \\\\  & =-21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de85e9f7-1fad-524b-bd8b-7104cec09347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186510619}] :answer-field/correct {:answer/id #uuid "de85e9f7-1fad-524b-bd8b-7104cec09347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186510619} :answer-field/id #uuid "0d20830b-2284-575f-9545-dae95ed220c7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510586}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1a64264-a586-541e-93d2-598674ef4459" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}-9 & 1 \\\\ 9 & 9\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}-9 & 1 \\\\ 9 & 9\\end{vmatrix} \\\\  & =(-9)(9)-(1)(9) \\\\  & =-81-9 \\\\  & =-90.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f538a77-e08e-5555-add4-bafa899fb543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-335" :db/id #edb/ref 17592186510589} {:answer/id #uuid "235a772b-5538-5b61-ada2-553ca7d2cfbb" :answer/type {:db/id #edb/ref 17592186045498 :