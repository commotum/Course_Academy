nswer-field/correct {:answer/id #uuid "a997286f-4db9-53ee-8849-22966e083d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{113}{280}" :db/id #edb/ref 17592186510578} :answer-field/id #uuid "aac06ef3-2984-5073-a683-edc5d64f81a8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510579}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "107b0d08-c0c2-5e3b-a247-c4238dbd6d8f" :question/problem "Calculate $det(A)$ given that\n$$\n\\displaystyle A=\\begin{bmatrix}\\frac{5}{8} & \\frac{9}{5} \\\\ -\\frac{2}{9} & -\\frac{9}{7}\\end{bmatrix}.\n$$\n\n$det(A)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(A) & =\\begin{vmatrix}\\frac{5}{8} & \\frac{9}{5} \\\\ -\\frac{2}{9} & -\\frac{9}{7}\\end{vmatrix} \\\\  & =\\frac{5}{8}\\cdot \\left(-\\frac{9}{7}\\right)-\\frac{9}{5}\\cdot \\left(-\\frac{2}{9}\\right) \\\\  & =-\\frac{45}{56}-\\left(-\\frac{2}{5}\\right) \\\\  & =-\\frac{113}{280}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e54747-95d9-5771-963b-49dcf4295948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{55}{14}" :db/id #edb/ref 17592186510574}] :answer-field/correct {:answer/id #uuid "32e54747-95d9-5771-963b-49dcf4295948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{55}{14}" :db/id #edb/ref 17592186510574} :answer-field/id #uuid "1b44817c-904a-519b-9cfd-76497778888f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 175921865105