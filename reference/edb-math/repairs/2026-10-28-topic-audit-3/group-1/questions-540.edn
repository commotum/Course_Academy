#{[{:db/id #edb/ref 17592186262806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d8c86ed-6d17-58e5-80b8-58959792fbea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186260000} {:answer/id #uuid "5da2ff79-d5ff-5f94-843d-fd01485931c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{2}{5}" :db/id #edb/ref 17592186260680} {:answer/id #uuid "63782cc1-1e3c-5b15-9b88-3f08b70112ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{1}{3}" :db/id #edb/ref 17592186260732} {:answer/id #uuid "7a8b63ad-24d0-5034-a4cd-e73692e2757c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3" :db/id #edb/ref 17592186260943} {:answer/id #uuid "c7f4b75b-8f4c-53c9-98ea-95862842547a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5" :db/id #edb/ref 17592186261645}] :answer-field/correct {:answer/id #uuid "0d8c86ed-6d17-58e5-80b8-58959792fbea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186260000} :answer-field/id #uuid "4e8c9907-19d6-5803-bfec-b352898f4520" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e03a4dd-5246-5c91-8e03-9d7ad64d917d" :question/math-academy-id "q-127608" :question/problem "If\n$$\n\\displaystyle B=\\begin{bmatrix}5-p & p \\\\ 3 & p\\end{bmatrix}\n$$\nand $det(B)=1$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(B) & =\\begin{vmatrix}5-p & p \\\\ 3 & p\\end{vmatrix} \\\\  & =(5-p)\\cdot p-p\\cdot 3 \\\\  & =-{p}^{2}+2p\\end{aligned}\n$$\n\nSince $det(B)=1$, we obtain:\n\n$$\n\\begin{aligned}det(B) & =1 \\\\ -{p}^{2}+2p & =1 \\\\ -{p}^{2}+2p-1 & =0 \\\\ {p}^{2}-2p+1 & =0 \\\\ (p-1)^{2} & =0 \\\\ p & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a37c432-ec3a-54fa-a265-be8a73e5b042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186260101} {:answer/id #uuid "570d06e5-402c-5a48-aa29-06ffa92a5243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=18" :db/id #edb/ref 17592186260619} {:answer/id #uuid "76d5eb3b-a067-51ff-b76b-ba5ac4fdd83a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186260912} {:answer/id #uuid "bd179fed-e737-5b98-9f59-7194e6703cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{9}{2}" :db/id #edb/ref 17592186261544} {:answer/id #uuid "d688ed58-3493-5fc2-84fe-15f1d55d1e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{18}{2}" :db/id #edb/ref 17592186261762}] :answer-field/correct {:answer/id #uuid "1a37c432-ec3a-54fa-a265-be8a73e5b042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186260101} :answer-field/id #uuid "a12a44ba-4364-5ba9-9b64-63befc571bbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41f9cebe-1261-5298-9d1d-10bd7138212b" :question/math-academy-id "q-127609" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3y & y \\\\ 3 & y-5\\end{bmatrix}\n$$\nand $det(A)=-27$, what is the value of $y?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3y & y \\\\ 3 & y-5\\end{vmatrix} \\\\  & =3y\\cdot (y-5)-y\\cdot 3 \\\\  & =3{y}^{2}-18y\\end{aligned}\n$$\n\nSince $det(A)=-27$, we obtain:\n\n$$\n\\begin{aligned}det(A) & =-27 \\\\ 3{y}^{2}-18y & =-27 \\\\ 3{y}^{2}-18y+27 & =0 \\\\ {y}^{2}-6y+9 & =0 \\\\ (y-3)^{2} & =0 \\\\ y & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12089a6a-a880-58fd-8015-e683d64044cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186260033} {:answer/id #uuid "2e79b9bf-496a-5b86-95db-3519ffcc1fd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260295} {:answer/id #uuid "32f21b1e-e0d3-5e8b-a4f6-207a056c3331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260335} {:answer/id #uuid "bcdb4104-831e-55b0-8287-359801a260f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186261542} {:answer/id #uuid "fcb575b0-eaae-5420-9b87-61fc65e0c4d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186262084}] :answer-field/correct {:answer/id #uuid "fcb575b0-eaae-5420-9b87-61fc65e0c4d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186262084} :answer-field/id #uuid "ce714977-afa6-5cfe-b61e-62d5fd5e4fd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262485}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6796746e-0500-559b-91cc-a530cd306e54" :question/math-academy-id "q-127635" :question/problem "Find the arc length of the curve $r(t)=⟨2t,\\,\\frac{1}{3}{t}^{3},\\,{t}^{2}⟩$ from $t=-1$ to $t=0.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}))⟩ \\\\  & =⟨2,\\,{t}^{2},\\,2t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(2)}^{2}+{({t}^{2})}^{2}+{(2t)}^{2}} \\\\  & =\\sqrt{{t}^{4}+4{t}^{2}+4} \\\\  & =\\sqrt{({t}^{2}+2)^{2}} \\\\  & ={t}^{2}+2\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{0}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{0}({t}^{2}+2)\\,\\text{d}t \\\\  & =(\\frac{1}{3}{t}^{3}+2t){|}_{-1}^{0} \\\\  & =(\\frac{{0}^{3}}{3}+2(0))-(\\frac{(-1)^{3}}{3}+2(-1)) \\\\  & =\\frac{1}{3}+2 \\\\  & =\\frac{7}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2533792b-1000-57ed-bd32-dc18c559c932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186260197} {:answer/id #uuid "3a3b313e-4d83-5f33-8d62-60d3aa43890d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186260395} {:answer/id #uuid "983ba299-7c28-5f24-a401-422168b7fb14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261195} {:answer/id #uuid "a8aa8b47-ed96-5324-a779-87eafae577e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261348} {:answer/id #uuid "ee23525d-d93f-54d4-aaea-f54545a58a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261970}] :answer-field/correct {:answer/id #uuid "ee23525d-d93f-54d4-aaea-f54545a58a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261970} :answer-field/id #uuid "8a6925d3-c72a-585b-9c71-de675fc6d995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262366}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "345911eb-d8f0-5c7f-a7bf-7219fc388144" :question/math-academy-id "q-128091" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-1,1,0⟩$ and $b\\times c=⟨6,1,7⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,1,0⟩\\cdot ⟨6,1,7⟩ \\\\  & =(-1)\\cdot 6+1\\cdot 1+0\\cdot 7 \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f004e8a-2d25-564b-bf1f-8fae2abb86df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260017} {:answer/id #uuid "82fda9c3-16c1-5806-a012-a34ae4c1bfa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186261012} {:answer/id #uuid "972f1345-e52d-58eb-ae30-3eb82ce9c45f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186261187} {:answer/id #uuid "c2590a97-ba1f-5833-ac3a-19f3da83c3e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261588} {:answer/id #uuid "d4426b8c-3067-50d4-8333-34c0e794e8f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186261745}] :answer-field/correct {:answer/id #uuid "c2590a97-ba1f-5833-ac3a-19f3da83c3e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261588} :answer-field/id #uuid "2d10b3cf-a3e7-5c1c-aafc-7abe846e273d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262203}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55c9895d-23d4-50a7-8c21-33e1b247f3b1" :question/math-academy-id "q-128107" :question/problem "Let $a=⟨0,9,3⟩,$ $b=⟨3,2,0⟩$ and $c=⟨-1,1,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =\\begin{vmatrix}0 & 9 & 3 \\\\ 3 & 2 & 0 \\\\ -1 & 1 & 1\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}2 & 0 \\\\ 1 & 1\\end{vmatrix}-9\\cdot \\begin{vmatrix}3 & 0 \\\\ -1 & 1\\end{vmatrix}+3\\cdot \\begin{vmatrix}3 & 2 \\\\ -1 & 1\\end{vmatrix} \\\\  & =0-9(3\\cdot 1-(-1)\\cdot 0)+3(3\\cdot 1-(-1)\\cdot 2) \\\\  & =0-27+15 \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92d23d47-b732-5d7c-8332-8dc173c69020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186261152} {:answer/id #uuid "940b07cd-9fd6-595b-99f0-d6cb02f36aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186261164} {:answer/id #uuid "c6b36382-f8ad-5f91-899f-3836e3f05ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186261627} {:answer/id #uuid "d7a9e1db-d3ed-569e-8606-65eccaf2dcb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186261774} {:answer/id #uuid "ee2ce41d-d7ab-5350-a6ab-4acbcdbc3754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186261973}] :answer-field/correct {:answer/id #uuid "940b07cd-9fd6-595b-99f0-d6cb02f36aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186261164} :answer-field/id #uuid "31c08a2d-91b4-53aa-a15a-039f75f68387" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262214}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6337318a-7407-5fc3-adf2-5018e289e1ee" :question/math-academy-id "q-128347" :question/problem "Let $p=⟨7,4,9⟩,$ $q=⟨1,2,-2⟩$ and $r=⟨3,0,5⟩.$ Find $q\\cdot (r\\times p).$" :question/worked-solution "Remember that the scalar triple product $q\\cdot (r\\times p)$ is just the determinant of the matrix whose rows are given by $q,$ $r,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}q\\cdot (r\\times p) & =\\begin{vmatrix}1 & 2 & -2 \\\\ 3 & 0 & 5 \\\\ 7 & 4 & 9\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}0 & 5 \\\\ 4 & 9\\end{vmatrix}-2\\cdot \\begin{vmatrix}3 & 5 \\\\ 7 & 9\\end{vmatrix}+(-2)\\cdot \\begin{vmatrix}3 & 0 \\\\ 7 & 4\\end{vmatrix} \\\\  & =(0\\cdot 9-4\\cdot 5)-2(3\\cdot 9-7\\cdot 5)-2(3\\cdot 4-7\\cdot 0) \\\\  & =-20+16-24 \\\\  & =-28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5274e2eb-d7d6-5684-a72b-358d53a9eb3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186260572} {:answer/id #uuid "542b8988-bd16-5729-a1ca-152b6d5724ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260584} {:answer/id #uuid "bba63d26-fe9b-5273-828a-e46eb3d27da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186261526} {:answer/id #uuid "bec1cfa7-c5af-58db-88b8-d8574d83c37c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186261561} {:answer/id #uuid "e9f34795-825c-5451-9286-5c90ee165438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186261926}] :answer-field/correct {:answer/id #uuid "bec1cfa7-c5af-58db-88b8-d8574d83c37c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186261561} :answer-field/id #uuid "9517a99d-a2b2-5e38-91ba-0f65e2ab7869" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "58b3ec26-2c8a-5bad-918c-8d5707ca39d2" :question/math-academy-id "q-128352" :question/problem "Find $c\\cdot (a\\times b),$ if $a\\cdot ((-3b)\\times (-7c))=7.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}a\\cdot ((-3b)\\times (-7c)) & =7 \\\\ (-3)\\cdot (-7)\\cdot [a\\cdot (b\\times c)] & =7 \\\\ a\\cdot (b\\times c) & =\\frac{1}{3}.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{1}{3},\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00affd18-7c0a-55ad-bbfd-65e2484cfa65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186259877} {:answer/id #uuid "109b3b85-5ce5-5ced-8473-2db819be328d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186260026} {:answer/id #uuid "ad7b4334-612f-579c-9bd4-8b94b2dd43b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261394} {:answer/id #uuid "adf8cdb5-9bc3-5fb3-827b-192339fc28a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186261406} {:answer/id #uuid "daaa383f-2da1-50ba-8635-d7fa83db7d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186261806}] :answer-field/correct {:answer/id #uuid "00affd18-7c0a-55ad-bbfd-65e2484cfa65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186259877} :answer-field/id #uuid "ff922298-f1c0-51e4-a2e3-b340b450e56e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eebcd40a-2228-54ae-a4fe-12554407b971" :question/math-academy-id "q-128353" :question/problem "Find $b\\cdot (a\\times c),$ if $b\\times c=⟨2,5,1⟩$ and $a=⟨6,1,-9⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨6,1,-9⟩\\cdot ⟨2,5,1⟩ \\\\  & =6\\cdot 2+1\\cdot 5+(-9)\\cdot 1 \\\\  & =12+5-9 \\\\  & =8.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac9f5fa0-b5b6-5984-816e-05ebf16c604e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261385} {:answer/id #uuid "d3e506eb-0c73-54cd-bea5-69edf125c21e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186261741} {:answer/id #uuid "daff916a-8d3a-5192-a81e-8d54ac5e6b90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186261811} {:answer/id #uuid "f263a5a4-8c23-5633-8f3f-d1dee00dda4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261994} {:answer/id #uuid "f3a8659d-0b1d-58eb-a190-a4dc181002b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186262004}] :answer-field/correct {:answer/id #uuid "f3a8659d-0b1d-58eb-a190-a4dc181002b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186262004} :answer-field/id #uuid "9d44782d-0883-5e02-9033-b08b78209c43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6324ef53-4779-5e72-aa0d-0e3d70a28579" :question/math-academy-id "q-128356" :question/problem "Find $c\\cdot (b\\times a),$ if $b\\times c=⟨6,-1,3⟩$ and $a=⟨3,5,-4⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨3,5,-4⟩\\cdot ⟨6,-1,3⟩ \\\\  & =3\\cdot 6+5\\cdot (-1)+(-4)\\cdot 3 \\\\  & =18-5-12 \\\\  & =1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "339fb7c7-d93c-5c76-b06a-d33df74cd8e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{x}" :db/id #edb/ref 17592186260344} {:answer/id #uuid "53eda4a2-dcfe-5694-b735-8055ff397ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{x}-2" :db/id #edb/ref 17592186260582} {:answer/id #uuid "6c8d85ad-26f4-5181-85d9-39dee8214b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{x}" :db/id #edb/ref 17592186260829} {:answer/id #uuid "72f7657a-8454-5b60-905f-29bf3f4da72f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+1" :db/id #edb/ref 17592186260880} {:answer/id #uuid "9d78e70d-e97e-524e-9b2e-d0102ca46970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-2" :db/id #edb/ref 17592186261239}] :answer-field/correct {:answer/id #uuid "339fb7c7-d93c-5c76-b06a-d33df74cd8e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{x}" :db/id #edb/ref 17592186260344} :answer-field/id #uuid "b68233d5-c5ee-5d1c-b4ec-7ffd1afb1202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262456}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0249deda-4187-5a10-b1cd-2d9b45fe1fc1" :question/math-academy-id "q-128447" :question/problem "Determine the equation of the level curve that passes through the point $P(1,1)$ for the function $f(x,y)=xy-2.$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(1,1) & =1(1)-2 \\\\  & =1-2 \\\\  & =-1\\end{aligned}\n$$\n\nHence, the level curve that passes through $P(1,1)$ is the $-1$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=-1.$ So, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ xy-2 & =-1 \\\\ xy & =1 \\\\ y & =\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $P(1,1)$ is the hyperbola $y=\\frac{1}{x}.$"}] [{:db/id #edb/ref 17592186262896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8646ea7a-f4c8-5ee6-bc62-64c5a7a1b87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1-2{y}^{2}" :db/id #edb/ref 17592186261042} {:answer/id #uuid "b96257d2-4ef7-5602-8e84-5605edd9c9d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={y}^{2}+5" :db/id #edb/ref 17592186261499} {:answer/id #uuid "e8c3b579-6c89-5ceb-bdc0-96620ed26992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3{y}^{2}+1" :db/id #edb/ref 17592186261914} {:answer/id #uuid "fbda96ab-d407-5585-b292-1d7ebfff7adc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3-{y}^{2}" :db/id #edb/ref 17592186262078} {:answer/id #uuid "fef2dc7f-dd8e-55a4-ac9f-c804b03046b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={y}^{2}+2" :db/id #edb/ref 17592186262110}] :answer-field/correct {:answer/id #uuid "fef2dc7f-dd8e-55a4-ac9f-c804b03046b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={y}^{2}+2" :db/id #edb/ref 17592186262110} :answer-field/id #uuid "844f56f8-0331-5bb7-a827-a75169ccaacd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262351}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9708f23-f4e9-5aa5-ac24-a704c33009ca" :question/math-academy-id "q-128451" :question/problem "Determine the equation of the level curve that passes through the point $P(2,0)$ for the function $f(x,y)=\\frac{1}{x-{y}^{2}+3}.$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(2,0) & =\\frac{1}{2-{0}^{2}+3} \\\\  & =\\frac{1}{2-0+3} \\\\  & =\\frac{1}{5}\\end{aligned}\n$$\n\nHence, the level curve that passes through $P(2,0)$ is the $\\frac{1}{5}$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=\\frac{1}{5}.$ So, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{1}{x-{y}^{2}+3} & =\\frac{1}{5} \\\\ 5 & =x-{y}^{2}+3 \\\\ x & ={y}^{2}+2\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $P(2,0)$ is the parabola $x={y}^{2}+2.$"}] [{:db/id #edb/ref 17592186262933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92ef990e-1cea-5691-add8-a9a4bd107064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448302} {:answer/id #uuid "7dc67608-1f2c-5d22-b921-920a8e4c97a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448303}] :answer-field/correct {:answer/id #uuid "92ef990e-1cea-5691-add8-a9a4bd107064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448302} :answer-field/id #uuid "bc96e470-5f69-574c-9b9e-c620bf3eb7d7" :answer-field/key "$c=-1$ gives a line" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449191} {:answer-field/choices [{:answer/id #uuid "63ddb0bf-c7e0-5bed-a309-72dc6fd5a94b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448304} {:answer/id #uuid "7f593a64-253b-5b53-be4d-93a7fd10d52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448305}] :answer-field/correct {:answer/id #uuid "7f593a64-253b-5b53-be4d-93a7fd10d52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448305} :answer-field/id #uuid "df16a0f8-d309-5196-8986-cbcb30f5ac79" :answer-field/key "$c=0$ gives a parabola, excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449192} {:answer-field/choices [{:answer/id #uuid "0f26b8f8-7a28-5ba9-a92e-f0f01da7dab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448306} {:answer/id #uuid "79cbbda2-7409-51ac-b909-8eaa54f9322b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448307}] :answer-field/correct {:answer/id #uuid "79cbbda2-7409-51ac-b909-8eaa54f9322b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448307} :answer-field/id #uuid "c942c571-9ddc-5568-9ee7-d107cf23c370" :answer-field/key "$c=1$ gives the $x$-axis, excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449193}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02aab097-5368-5094-843f-c0ac47beef5b" :question/math-academy-id "q-129058" :question/problem "The level curves of the function $f(x,y)=\\frac{x+{y}^{2}}{x}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{x+{y}^{2}}{x} & =c \\\\ x+{y}^{2} & =cx \\\\ x(1-c)+{y}^{2} & =0\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1,$ the level curve is $x=-\\frac{1}{2}{y}^{2},$ which is a parabola that opens to the left (excluding the origin). So, “$c=-1$ gives a line” is false.\n\n- If $c=0,$ the level curves is $x=-{y}^{2},$ which is a parabola that opens to the left (excluding the origin). So, “$c=0$ gives a parabola, excluding the origin” is true.\n\n- If $c=1,$ the level curve is $y=0,$ which is the $x$-axis (excluding the origin). So, “$c=1$ gives the $x$-axis, excluding the origin” is true.\n\nSo, the correct answer is “$c=0$ gives a parabola, excluding the origin”; “$c=1$ gives the $x$-axis, excluding the origin” only."}] [{:db/id #edb/ref 17592186262934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "179db532-d9e6-5e2e-91f3-aade01e0ddb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463676} {:answer/id #uuid "b3485b61-e757-5360-a24b-e5e8e1510cb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463677}] :answer-field/correct {:answer/id #uuid "179db532-d9e6-5e2e-91f3-aade01e0ddb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463676} :answer-field/id #uuid "cd745651-984a-5d60-a190-cb171692cead" :answer-field/key "$c=0$ gives a parabola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464772} {:answer-field/choices [{:answer/id #uuid "05537b17-7ec7-5fc9-bc2c-6afa58fbf701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463678} {:answer/id #uuid "503c7eee-dfea-59ab-9897-fba0a24aa061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463679}] :answer-field/correct {:answer/id #uuid "05537b17-7ec7-5fc9-bc2c-6afa58fbf701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463678} :answer-field/id #uuid "538c309f-7174-5be3-8c40-ec951dfef7f2" :answer-field/key "$c=1$ gives an ellipse" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464773} {:answer-field/choices [{:answer/id #uuid "b488c30c-d8bb-5f46-b3aa-6f3e7348f877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463680} {:answer/id #uuid "0377582f-387c-5883-9a77-bf51a5c48a80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463681}] :answer-field/correct {:answer/id #uuid "b488c30c-d8bb-5f46-b3aa-6f3e7348f877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463680} :answer-field/id #uuid "7bce9543-3652-5444-87d3-b92041c327f4" :answer-field/key "$c=2$ gives a hyperbola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464774} {:answer-field/choices [{:answer/id #uuid "020f95c1-ef74-5889-a12a-efb42904bfa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667934} {:answer/id #uuid "47c7001a-2548-5fbb-9908-60b15aab2a6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667935}] :answer-field/correct {:answer/id #uuid "47c7001a-2548-5fbb-9908-60b15aab2a6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667935} :answer-field/id #uuid "0ae56a0e-a681-54cc-afc5-93a4cfff687c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b3926e5-b3cd-5c3a-a183-ad2104ed74d9" :question/math-academy-id "q-129062" :question/problem "The level curves of the function $f(x,y)=\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}} & =c \\\\ {y}^{2} & =c({x}^{2}+{y}^{2}) \\\\ c{x}^{2}+(c-1){y}^{2} & =0\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0,$ the level curve is the line $y=0,$ which is the $x$-axis. So, “$c=0$ gives a parabola” is false.\n\n- If $c=1,$ the level curve is the line $x=0,$ which is the $y$-axis. So, “$c=1$ gives an ellipse” is false.\n\n- If $c=2,$  then we obtain \n\n$$\n\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}=2\\,⟹\\,2{x}^{2}+{y}^{2}=0.\n$$\n\nHowever, the only real solution to this equation is  $(x,y)=(0,0),$ which is not in the domain of $f(x,y)$ because it would result in division by zero. Thus, “$c=2$ gives a hyperbola” is false.\n\nSo, the correct answer is \"None of the listed\"."}] [{:db/id #edb/ref 17592186262935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c15a454d-c0ca-506d-b884-f5178778ed63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448308} {:answer/id #uuid "c32fe568-db32-54b6-8558-ab5cfc063bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448309}] :answer-field/correct {:answer/id #uuid "c15a454d-c0ca-506d-b884-f5178778ed63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448308} :answer-field/id #uuid "b5ce8677-ff71-54c3-ad56-f3412cdf488f" :answer-field/key "$c=-1$ gives a hyperbola" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449194} {:answer-field/choices [{:answer/id #uuid "aa79405f-ffc1-5234-ad9c-42a8996c0c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448310} {:answer/id #uuid "d901ccba-6ca6-5ba5-b447-d349fd2445c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448311}] :answer-field/correct {:answer/id #uuid "aa79405f-ffc1-5234-ad9c-42a8996c0c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448310} :answer-field/id #uuid "70ebaa1d-8cd6-5098-9a25-c5f76b89deb4" :answer-field/key "$c=0$ gives the $y$-axis, excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449195} {:answer-field/choices [{:answer/id #uuid "5095e664-dc44-568b-aa90-8adbb890de3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448312} {:answer/id #uuid "010f4da8-c1ee-5554-b6b8-f8cf5ae4e818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448313}] :answer-field/correct {:answer/id #uuid "010f4da8-c1ee-5554-b6b8-f8cf5ae4e818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448313} :answer-field/id #uuid "93e97ed1-eab4-543d-87b4-43be11f05919" :answer-field/key "$c=1$ gives the line $y=x,$ excluding the origin" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42b1c0f3-5dd1-53b2-92c2-3218b1cbc331" :question/math-academy-id "q-129063" :question/problem "The level curves of the function $f(x,y)=\\frac{y}{x}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{y}{x} & =c \\\\ y & =cx\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1,$ the level curve is the line $y=-x,$ excluding the origin. So, “$c=-1$ gives a hyperbola” is false.\n\n- If $c=0,$ the level curve is the line $y=0,$ which is the $x$-axis (excluding the origin). So, “$c=0$ gives the $y$-axis, excluding the origin” is false.\n\n- If $c=1,$ the level curve is the line $y=x,$ excluding the origin. So, “$c=1$ gives the line $y=x,$ excluding the origin” is true.\n\nSo, the correct answer is “$c=1$ gives the line $y=x,$ excluding the origin” only."}] [{:db/id #edb/ref 17592186262943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b8f524a-9681-5a5a-aa6a-8d21d370c6a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef27f12eb1ee6872210bf8cadb6908efd31c1bb54e9e7d34cc3456df2ee03a77.png" :db/id #edb/ref 17592186260656} {:answer/id #uuid "90a9daad-d37b-5bdf-8f0c-1e578a2870e2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" :db/id #edb/ref 17592186261134} {:answer/id #uuid "a19c1461-ef0c-529e-9726-029d4c772ce7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2c570cc9958db69a30dc400920b6ff27574e79bd26a53b35e086cb03034c5b6d.png" :db/id #edb/ref 17592186261280} {:answer/id #uuid "c30db028-ad8b-5802-9d7d-fe2ee0d636d7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png" :db/id #edb/ref 17592186261596} {:answer/id #uuid "d4894fee-b5e1-59e2-86ca-ba516e7266bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d774c444ad33c68ec5d507611324030f2005671265ba5f855f322d8db57b69b4.png" :db/id #edb/ref 17592186261746}] :answer-field/correct {:answer/id #uuid "c30db028-ad8b-5802-9d7d-fe2ee0d636d7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png" :db/id #edb/ref 17592186261596} :answer-field/id #uuid "93f1dce4-27ec-501b-8cb3-8ca95b44d739" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262388}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae6e3096-5c3b-5202-84b9-abfe5e790c65" :question/math-academy-id "q-129113" :question/problem "Which of the following represents the level curves of $f(x,y)=3\\operatorname{sin}⁡x?$" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-3,3].$ So, we will consider only $c$-level curves for $c\\in [-3,3].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 3\\operatorname{sin}⁡x & =c \\\\ x & =\\operatorname{arcsin}⁡\\frac{c}{3}+2\\pi n,\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that the equations $x=\\operatorname{arcsin}⁡\\frac{c}{3}+2\\pi n$ do not depend on $y.$ So, for a given $c\\in [-3,3]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of vertical lines, as shown below.\n\n![](images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png)"}] [{:db/id #edb/ref 17592186262944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f81b229-411e-50ec-868a-e71357c6d344" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b79c75fb4de77313ff9ae17938eeabc8b55cca395e6516c09abf6742f9b6a23b.png" :db/id #edb/ref 17592186260146} {:answer/id #uuid "2e72b69e-de1d-539b-bd7f-b17ba3bb78bc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/01/0162f31b5dbb35c6d370dff9b54257708df39b6957f6547059842cd31769669b.png" :db/id #edb/ref 17592186260294} {:answer/id #uuid "7d7ac9b2-3db3-5b9c-a04a-a8589af15779" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b4642ea9b585ac066f2ed904b1bee4df7d1ff3449ba2d09afca8364b58f1dcba.png" :db/id #edb/ref 17592186260967} {:answer/id #uuid "867c8bfd-8db7-54f2-837f-8096fc36058e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7afff53b46a661fc6e0df4df871810dc5514ff7b476294e76c70f60d4e1643f9.png" :db/id #edb/ref 17592186261045} {:answer/id #uuid "bebf2ce8-badd-5f41-86c5-5e5bb4040e73" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f82efe38e48f39aee18cf9e00cdd69f07c37cc414b08b5bc78ebc0a876c02d7e.png" :db/id #edb/ref 17592186261560}] :answer-field/correct {:answer/id #uuid "867c8bfd-8db7-54f2-837f-8096fc36058e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7afff53b46a661fc6e0df4df871810dc5514ff7b476294e76c70f60d4e1643f9.png" :db/id #edb/ref 17592186261045} :answer-field/id #uuid "12e3878f-62b0-500f-bf38-893dbf70a32f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f1a9983-9e78-5286-9a4c-31363bd01bd7" :question/math-academy-id "q-129118" :question/problem "Which of the following represents the level curves of $f(x,y)=-x-y+2?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nnotice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider $c$-level curves for any real value of $c.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -x-y+2 & =c \\\\ y & =-x+2-c.\\end{aligned}\n$$\n\nThe equation above gives us a family of lines with slope of $-1.$ Therefore, the correct graph is as follows:\n\n![](images/e2/e20175ef9ac473a621a67d524e60cacc6e9a40ba30267fe81b4e6a093c780c28.png)"}] [{:db/id #edb/ref 17592186266054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fd8b6ef-b59f-51f2-a593-a74e3c5113e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}-{x}^{2}" :db/id #edb/ref 17592186263402} {:answer/id #uuid "566e4c61-c6d3-532c-a17e-0ce406ccd91a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263746} {:answer/id #uuid "8b9f983d-c07a-58f0-b650-0ac5793162ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186264195} {:answer/id #uuid "a115c9cc-944a-5313-be2c-6a6b818c3703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4xy}{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186264372} {:answer/id #uuid "f0e44d7e-08de-533f-9742-7ba0cc548074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-{y}^{2}}{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186265114}] :answer-field/correct {:answer/id #uuid "8b9f983d-c07a-58f0-b650-0ac5793162ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186264195} :answer-field/id #uuid "bfcc4b11-5a7e-59a3-82ae-a2381a5b8490" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265581}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a1d77cd-7e5d-55c7-ad70-6eac8546452e" :question/math-academy-id "q-131170" :question/problem "Given that $$\n\\displaystyle F=\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j,\n$$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}\\left(\\frac{y}{{x}^{2}+{y}^{2}}\\right)+\\frac{∂}{∂y}\\left(\\frac{x}{{x}^{2}+{y}^{2}}\\right) \\\\  & =-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}}-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}} \\\\  & =-\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e1d86b-777c-5d78-8129-3e3154b25d8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(y+1)" :db/id #edb/ref 17592186263179} {:answer/id #uuid "5eb1e4c7-5972-54da-b483-2639d96f6b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+xy}{x}" :db/id #edb/ref 17592186263820} {:answer/id #uuid "655a10c4-f044-53a0-88f5-bbde9a25a28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+{x}^{2}}{x}" :db/id #edb/ref 17592186263877} {:answer/id #uuid "97d78aa6-ea0d-5f24-a13e-67b22e7ea07b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{xy}" :db/id #edb/ref 17592186264305} {:answer/id #uuid "cdf68194-67fc-5a2b-9be9-bb9678d7eccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186264801}] :answer-field/correct {:answer/id #uuid "655a10c4-f044-53a0-88f5-bbde9a25a28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+{x}^{2}}{x}" :db/id #edb/ref 17592186263877} :answer-field/id #uuid "9988210a-6613-557d-bea5-63cfe299e821" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265521}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14aba214-1cfb-5361-bc32-3c785d7a027e" :question/math-academy-id "q-131171" :question/problem "Given that $F=\\operatorname{ln}⁡(xy)\\,i+xy\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))+\\frac{∂}{∂y}(xy) \\\\  & =\\frac{1}{x}+x \\\\  & =\\frac{1+{x}^{2}}{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bcdd62-0b56-5da2-a50a-586faa6696b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy{z}^{2}+xz" :db/id #edb/ref 17592186263155} {:answer/id #uuid "295ca0f4-57e7-5a42-ac1c-c9565fd958a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y{z}^{2}+xy{e}^{y}" :db/id #edb/ref 17592186263355} {:answer/id #uuid "2be15acb-dbc4-5b00-98a8-38e26089e1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y{z}^{2}+x{e}^{y}" :db/id #edb/ref 17592186263371} {:answer/id #uuid "40fe9bd6-26ef-51ba-a8ee-4aa3a8d37085" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y{z}^{2}+xy+y" :db/id #edb/ref 17592186263576} {:answer/id #uuid "fe783955-ec8b-51ba-88fd-5f0cc372a593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+{e}^{y}+{z}^{2}" :db/id #edb/ref 17592186265240}] :answer-field/correct {:answer/id #uuid "2be15acb-dbc4-5b00-98a8-38e26089e1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y{z}^{2}+x{e}^{y}" :db/id #edb/ref 17592186263371} :answer-field/id #uuid "6647713f-61bd-5d5d-9904-3d926c79511c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01f7efc1-008b-5b39-b852-37db53b31085" :question/math-academy-id "q-131176" :question/problem "Consider the vector field $F=2xy{z}^{2}\\,i+x{e}^{y}\\,j+y{z}^{3}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(2xy{z}^{2})+\\frac{∂}{∂y}(x{e}^{y})+\\frac{∂}{∂z}(y{z}^{3}) \\\\  & =2y{z}^{2}+x{e}^{y}+3y{z}^{2} \\\\  & =5y{z}^{2}+x{e}^{y}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d5cf691-6752-5dc4-9355-e5e32cd7af90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186263381} {:answer/id #uuid "73066922-94a0-57b0-ad5a-47ab9c4927a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186263997} {:answer/id #uuid "93afee8e-347e-5e05-be65-1c464c2d1f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264265} {:answer/id #uuid "bf08727f-4fff-542b-8537-f96fbde04c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264665} {:answer/id #uuid "d535bc6a-edfa-521d-bf62-0df28519ae30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264855}] :answer-field/correct {:answer/id #uuid "2d5cf691-6752-5dc4-9355-e5e32cd7af90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186263381} :answer-field/id #uuid "836536a2-6d1f-5649-aacd-967f39893192" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265478}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "baf7ed03-0d49-58d2-ac15-c74b6a028957" :question/math-academy-id "q-131178" :question/problem "Consider the vector field $F=xz\\operatorname{cos}⁡y\\,i+y{x}^{2}\\,j+x{z}^{2}{e}^{y}\\,k.$ \nEvaluate $∇\\cdot F$ at the point $(1,0,-2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(xz\\operatorname{cos}⁡y)+\\frac{∂}{∂y}(y{x}^{2})+\\frac{∂}{∂z}(x{z}^{2}{e}^{y}) \\\\  & =z\\operatorname{cos}⁡y+{x}^{2}+2xz{e}^{y}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(1,0,-2),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(1,0,-2) & =(-2)\\cdot \\operatorname{cos}⁡0+{1}^{2}+2\\cdot 1\\cdot (-2)\\cdot {e}^{0} \\\\  & =-2+1-4 \\\\  & =-5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7210bc-4393-5891-b645-0416e337493e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263130} {:answer/id #uuid "57a5d39a-7a9e-5cfb-b9d8-3e21904353aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263756} {:answer/id #uuid "59856e9e-86de-5aec-8851-459d7aff7f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263769} {:answer/id #uuid "763ec751-6041-53d3-bf83-ec80b69c1986" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186264028} {:answer/id #uuid "e75e9fb8-16a8-58be-8ba5-2fa6ec19602d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186265014}] :answer-field/correct {:answer/id #uuid "e75e9fb8-16a8-58be-8ba5-2fa6ec19602d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186265014} :answer-field/id #uuid "2ba2b1d0-6260-5b94-8683-7d316171b0b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265323}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0861a93-f1e8-5e67-91e3-502d85562273" :question/math-academy-id "q-131179" :question/problem "Consider the vector field $F=x(y{e}^{z}+\\operatorname{ln}⁡y)\\,i+xy{e}^{z}\\,j+z(x+1)\\,k.$ \nEvaluate $∇\\cdot F$ at the point $(1,1,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(x(y{e}^{z}+\\operatorname{ln}⁡y))+\\frac{∂}{∂y}(xy{e}^{z})+\\frac{∂}{∂z}(z(x+1)) \\\\  & =(y{e}^{z}+\\operatorname{ln}⁡y)+x{e}^{z}+(x+1) \\\\  & =y{e}^{z}+\\operatorname{ln}⁡y+x{e}^{z}+x+1\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(1,1,0),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(1,1,0) & =1\\cdot {e}^{0}+\\operatorname{ln}⁡1+1\\cdot {e}^{0}+1+1 \\\\  & =1+0+1+1+1 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b57f211c-710e-5cdf-9dc0-86b8aefe98af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437824} {:answer/id #uuid "b929d2fd-0b41-5609-a3b0-fa86b7e1dd4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437825}] :answer-field/correct {:answer/id #uuid "b57f211c-710e-5cdf-9dc0-86b8aefe98af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437824} :answer-field/id #uuid "776c15bd-b517-5de8-bd02-bce5d321a9e0" :answer-field/key "$\\text{div}\\,F=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438941} {:answer-field/choices [{:answer/id #uuid "a7621cbc-9096-553a-84ec-b2f2f4e2f4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437826} {:answer/id #uuid "311543c2-d6ee-5d2f-a97e-a5b65483a921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437827}] :answer-field/correct {:answer/id #uuid "311543c2-d6ee-5d2f-a97e-a5b65483a921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437827} :answer-field/id #uuid "70f009df-f6c2-5904-a0e1-25a9ae42998b" :answer-field/key "$\\text{div}\\,F>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438942} {:answer-field/choices [{:answer/id #uuid "968b9198-d75a-5f15-96eb-a2deea0b5e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437828} {:answer/id #uuid "a2060c37-7ca9-58ba-a491-191632fc1573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437829}] :answer-field/correct {:answer/id #uuid "968b9198-d75a-5f15-96eb-a2deea0b5e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437828} :answer-field/id #uuid "0c5ab0f1-4f67-5325-afe4-5abf634a244d" :answer-field/key "$\\text{div}\\,F<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438943} {:answer-field/choices [{:answer/id #uuid "2879eacd-db77-5b78-ab2f-2988249602a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437830} {:answer/id #uuid "57da22cf-0696-5ee6-bc8a-520cb3a68dab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437831}] :answer-field/correct {:answer/id #uuid "2879eacd-db77-5b78-ab2f-2988249602a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437830} :answer-field/id #uuid "4ae32b58-4231-556f-87c0-2f75598b5de0" :answer-field/key "$F$ is solenoidal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438944}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48d2c508-8f65-5677-91ea-4bbc2f84d34b" :question/math-academy-id "q-131192" :question/problem "![](images/e3/e30919dc7cc107bdda9872079b4dc0e59fe8e3e5767aa2d407b9d0af392803e0.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement $\\text{div}\\,F>0$ is true, whereas statements $\\text{div}\\,F=0$ and $\\text{div}\\,F<0$ are false. Notice that the lengths of the vector's $y$-components increase as we move vertically away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement “$F$ is solenoidal” is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is $\\text{div}\\,F>0$ only."}] [{:db/id #edb/ref 17592186266063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e94a2c2-3c82-5231-8b63-336e1f39ed5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437832} {:answer/id #uuid "73f8ff38-9d88-5841-a511-f2acede95070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437833}] :answer-field/correct {:answer/id #uuid "73f8ff38-9d88-5841-a511-f2acede95070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437833} :answer-field/id #uuid "e61f3a78-17b9-5dc8-8814-0cc4b4a2ccae" :answer-field/key "$\\text{div}\\,F=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438945} {:answer-field/choices [{:answer/id #uuid "c0116b48-f34e-5dd2-be8e-b3934161f541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437834} {:answer/id #uuid "d4bdeb0c-7d25-5346-865a-0cafac7b14d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437835}] :answer-field/correct {:answer/id #uuid "c0116b48-f34e-5dd2-be8e-b3934161f541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437834} :answer-field/id #uuid "7e71969a-fcaa-5b92-84fb-70734def355c" :answer-field/key "$\\text{div}\\,F>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438946} {:answer-field/choices [{:answer/id #uuid "2f5fd46a-bab0-5a7c-95ba-10cde097fd6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437836} {:answer/id #uuid "95b4696f-fe0f-5b45-b776-8bdb7c506f5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437837}] :answer-field/correct {:answer/id #uuid "2f5fd46a-bab0-5a7c-95ba-10cde097fd6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437836} :answer-field/id #uuid "f5b8857e-16ee-534a-b0eb-3453864a2830" :answer-field/key "$\\text{div}\\,F<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438947} {:answer-field/choices [{:answer/id #uuid "f1e09cb5-c71f-5894-835a-eeacd8a45f51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437838} {:answer/id #uuid "df4757fd-166f-51c8-80cd-31f6ea0ad7ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437839}] :answer-field/correct {:answer/id #uuid "df4757fd-166f-51c8-80cd-31f6ea0ad7ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437839} :answer-field/id #uuid "67877ced-a15f-552a-9465-0ca79ff4d321" :answer-field/key "$F$ is solenoidal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438948}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4805821b-99fd-5b9d-aaa1-3579778dee2c" :question/math-academy-id "q-131193" :question/problem "![](images/24/243496443c3878c90fb67888add6c6ad6d3e69aa20ba24f42ee89d58a2742534.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement $\\text{div}\\,F=0$ is true, whereas statements $\\text{div}\\,F>0$ and $\\text{div}\\,F<0$ are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement “$F$ is solenoidal” is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is $\\text{div}\\,F=0$; “$F$ is solenoidal” only."}] [{:db/id #edb/ref 17592186266075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15bbc91c-fd98-5b6c-9665-d70f774533af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(z{e}^{yz}-y)\\,i+xy{e}^{yz}\\,j-xz{e}^{yz}\\,k" :db/id #edb/ref 17592186263203} {:answer/id #uuid "525a85d8-be7f-5e58-9de9-1e1199f1635c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-y\\,i+xy{e}^{yz}\\,j+xz{e}^{yz}\\,k" :db/id #edb/ref 17592186263710} {:answer/id #uuid "80f54f21-e7c4-5ec3-b1d5-b02fa7b3c8dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z{e}^{yz}\\,i+xy{e}^{yz}\\,j-xz{e}^{yz}\\,k" :db/id #edb/ref 17592186264109} {:answer/id #uuid "c704cdce-34fa-5e66-8fcd-a5d31c4900df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x{e}^{yz}-z)\\,i+x{e}^{yz}\\,j-xz{e}^{yz}\\,k" :db/id #edb/ref 17592186264741} {:answer/id #uuid "fd353914-244d-5acb-856d-77f4123cb4ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(z{e}^{yz}-y)\\,i+(xy{e}^{yz}-z)\\,j-{x}^{2}{e}^{yz}\\,k" :db/id #edb/ref 17592186265224}] :answer-field/correct {:answer/id #uuid "15bbc91c-fd98-5b6c-9665-d70f774533af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(z{e}^{yz}-y)\\,i+xy{e}^{yz}\\,j-xz{e}^{yz}\\,k" :db/id #edb/ref 17592186263203} :answer-field/id #uuid "bcd0b969-143e-57e9-a012-fd5218ecced7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265575}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c3cbbe9-4c45-5e2a-804f-38b6dd4503b8" :question/math-academy-id "q-131336" :question/problem "Given that $F(x,y,z)=x{e}^{yz}\\,i+yz\\,j+{e}^{yz}\\,k,$ what is $\\text{curl}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{vmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =\\begin{vmatrix}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ x{e}^{yz} & yz & {e}^{yz}\\end{vmatrix} \\\\  & =[\\frac{∂}{∂y}({e}^{yz})-\\frac{∂}{∂z}(yz)]i-[\\frac{∂}{∂x}({e}^{yz})-\\frac{∂}{∂z}(x{e}^{yz})]j+[\\frac{∂}{∂x}(yz)-\\frac{∂}{∂y}(x{e}^{yz})]k \\\\  & =(z{e}^{yz}-y)\\,i-(0-xy{e}^{yz})\\,j+(0-xz{e}^{yz})\\,k \\\\  & =(z{e}^{yz}-y)\\,i+xy{e}^{yz}\\,j-xz{e}^{yz}\\,k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dcb603b-689d-50ce-83f8-44f5250d8024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(xy)+2{y}^{2}" :db/id #edb/ref 17592186263275} {:answer/id #uuid "28606d0e-2a18-5568-9cc4-e5fe71ce5446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(xy)-2y" :db/id #edb/ref 17592186263349} {:answer/id #uuid "48bffaf6-9a7c-512d-a61a-b87966780f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)+2" :db/id #edb/ref 17592186263626} {:answer/id #uuid "6273b842-ef76-552a-bc8b-402fc78dd30d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(\\operatorname{cos}⁡(xy)-2)" :db/id #edb/ref 17592186263845} {:answer/id #uuid "a42cf267-cd93-5235-bac2-c5ef6a96f055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(\\operatorname{sin}⁡(xy)+1)" :db/id #edb/ref 17592186264400}] :answer-field/correct {:answer/id #uuid "6273b842-ef76-552a-bc8b-402fc78dd30d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(\\operatorname{cos}⁡(xy)-2)" :db/id #edb/ref 17592186263845} :answer-field/id #uuid "8a671a21-e6ba-55dc-abe6-747d123487e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265491}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e76ba6c5-d6f9-5c6d-bdbf-7e135802e67b" :question/math-academy-id "q-131344" :question/problem "Given that $F(x,y)=({y}^{2}+{e}^{x})\\,i+\\operatorname{sin}⁡(xy)\\,j,$ what is the scalar curl of $F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy))-\\frac{∂}{∂y}({y}^{2}+{e}^{x}) \\\\  & =y\\operatorname{cos}⁡(xy)-2y \\\\  & =y(\\operatorname{cos}⁡(xy)-2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "094b4e33-453c-5089-9253-e8aa4183aa51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186263087} {:answer/id #uuid "2f34bbbf-e9de-56ed-b5d5-8fd90694b1a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263397} {:answer/id #uuid "4e08ff17-d0ef-5f8f-ad8b-de16401e07eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263677} {:answer/id #uuid "91330e43-4daf-53a5-80cb-73904b06cc42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264246} {:answer/id #uuid "f949f546-1d67-5e4c-8955-0d191616d3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265181}] :answer-field/correct {:answer/id #uuid "094b4e33-453c-5089-9253-e8aa4183aa51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186263087} :answer-field/id #uuid "cbc7fc2f-2d80-546c-928f-f71b49a246d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ab1d5d9-c180-5acc-b2cc-0f6200926992" :question/math-academy-id "q-131348" :question/problem "Consider the vector field $F(x,y)=({x}^{2}+xy)\\,i+\\operatorname{ln}⁡(x+y)\\,j.$ Evaluate the scalar curl of $F$ at the point $(\\frac{1}{2},0).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+y))-\\frac{∂}{∂y}({x}^{2}+xy) \\\\  & =\\frac{1}{x+y}-x.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(\\frac{1}{2},0),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(1/2,0)} & =\\frac{1}{(\\frac{1}{2}+0)}-\\frac{1}{2} \\\\  & =2-\\frac{1}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77742b04-e958-51e3-885d-c186ce960ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437856} {:answer/id #uuid "7a46d360-0b63-59bd-8d4c-b0aa9e72d4a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437857}] :answer-field/correct {:answer/id #uuid "77742b04-e958-51e3-885d-c186ce960ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437856} :answer-field/id #uuid "24781376-5a9f-5184-b064-24b3c476bb79" :answer-field/key "$\\text{curl}\\,F=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438957} {:answer-field/choices [{:answer/id #uuid "d33cbee7-fc8b-5c3d-bfba-41b228bb82bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437858} {:answer/id #uuid "923f7469-7fef-5157-a155-0ff72c5145be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437859}] :answer-field/correct {:answer/id #uuid "923f7469-7fef-5157-a155-0ff72c5145be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437859} :answer-field/id #uuid "dfb64428-9f16-5737-8c74-c42a032a0297" :answer-field/key "$\\text{curl}\\,F\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438958} {:answer-field/choices [{:answer/id #uuid "058fa0b3-ef79-5a7a-afc6-113a760e3e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437860} {:answer/id #uuid "5292bd0e-9d53-564c-bffc-65c61607f30c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437861}] :answer-field/correct {:answer/id #uuid "5292bd0e-9d53-564c-bffc-65c61607f30c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437861} :answer-field/id #uuid "52c67e92-c96c-5d8b-b9f6-cc9263317637" :answer-field/key "$\\text{curl}\\,F$ points in the negative $z$-direction." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438959} {:answer-field/choices [{:answer/id #uuid "b6613a08-4056-5a9f-9ca6-c3c5e4078896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437862} {:answer/id #uuid "e701c30a-31e0-5846-a5ac-4931665193d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437863}] :answer-field/correct {:answer/id #uuid "b6613a08-4056-5a9f-9ca6-c3c5e4078896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437862} :answer-field/id #uuid "387cbfbf-b068-513c-93c4-71cb2f6085f2" :answer-field/key "$F$ is irrotational" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a88235e-0bbc-5c38-af1d-92f6a6eda26f" :question/math-academy-id "q-131361" :question/problem "![](images/17/1709a94b7361a1e8764d94199f9e84802ae925a09e6481250d0846b83bb6549f.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/7c/7c831425eae7afd709d546a8e05100f495adc04bba6450cfa56d370b415a28f5.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement $\\text{curl}\\,F\\ne 0$ is true, whereas statement $\\text{curl}\\,F=0$ is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate clockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement “$\\text{curl}\\,F$ points in the negative $z$-direction” is true. Using our right hand, if we wrap our fingers in the direction of rotation (clockwise), our thumb will point into the screen. Therefore, $\\text{curl}\\,F$ also points into from the screen, in the direction of decreasing $z.$\n\n- Statement “$F$ is irrotational” is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is $\\text{curl}\\,F\\ne 0$; “$\\text{curl}\\,F$ points in the negative $z$-direction” only."}] [{:db/id #edb/ref 17592186266080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "759144aa-479f-5d85-898a-3020b5e809ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437864} {:answer/id #uuid "d58a9696-938d-5e6c-99bf-4b58b6d7d42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437865}] :answer-field/correct {:answer/id #uuid "d58a9696-938d-5e6c-99bf-4b58b6d7d42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437865} :answer-field/id #uuid "0241eaa0-bc57-5fa6-a00a-6329bb64d727" :answer-field/key "$\\text{curl}\\,F=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438961} {:answer-field/choices [{:answer/id #uuid "708e20e7-d995-5c69-a88e-e75297d83f41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437866} {:answer/id #uuid "ecf7c82f-2cd4-5a1e-86ce-817f325c1c88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437867}] :answer-field/correct {:answer/id #uuid "708e20e7-d995-5c69-a88e-e75297d83f41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437866} :answer-field/id #uuid "58062d8a-4502-5ada-ad29-4c19534062ae" :answer-field/key "$\\text{curl}\\,F\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438962} {:answer-field/choices [{:answer/id #uuid "28338c89-d67a-5e71-b91f-8d1aa4c5632c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437868} {:answer/id #uuid "35b99a55-bd57-5584-83e7-24b20dcf426d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437869}] :answer-field/correct {:answer/id #uuid "35b99a55-bd57-5584-83e7-24b20dcf426d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437869} :answer-field/id #uuid "0a2d3df4-555b-5933-9b1d-284221d034cd" :answer-field/key "$F$ is irrotational" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438963} {:answer-field/choices [{:answer/id #uuid "46189e0a-937f-5303-a19e-e8e9671daedc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437870} {:answer/id #uuid "a33bbeb3-b68d-5ea0-b9c4-a6bc64ed2f6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437871}] :answer-field/correct {:answer/id #uuid "46189e0a-937f-5303-a19e-e8e9671daedc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437870} :answer-field/id #uuid "36112e37-bcb8-5a8d-a232-63977d54a9c7" :answer-field/key "$\\text{curl}\\,F$ points in the negative $z$-direction." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438964}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f317d036-e0ac-5288-a673-4543ead19ce4" :question/math-academy-id "q-131366" :question/problem "![](images/78/781a4e33b8b55762b2dcb7575d08315b5842f83d6d78a5136a1c353eefd3069d.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/97/979b63f21e56924bd7880f9487cf829089e38cf14d287e70196c7a661e41f97f.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement $\\text{curl}\\,F=0$ is true, whereas statement $\\text{curl}\\,F\\ne 0$ is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statement “$F$ is irrotational” is true. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational.\n\n- Statement “$\\text{curl}\\,F$ points in the negative $z$-direction” is false. Since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is $\\text{curl}\\,F=0$; “$F$ is irrotational” only."}] [{:db/id #edb/ref 17592186269204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42d662b8-0399-562b-8101-11b8cae7a8fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-29i+j-5k" :db/id #edb/ref 17592186266741} {:answer/id #uuid "73ba097b-3c01-5d49-90bf-db18bc3621fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11i+11j+5k" :db/id #edb/ref 17592186267161} {:answer/id #uuid "994e6d7f-bfad-5852-8fa6-548460f6cc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-29i-j+11k" :db/id #edb/ref 17592186267527} {:answer/id #uuid "a3e3f4c5-affe-5ed5-a4b8-1c352aa6c935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11i-j+5k" :db/id #edb/ref 17592186267618} {:answer/id #uuid "c78c4beb-8877-5deb-b67a-b4048ae08bba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-29i-11j+5k" :db/id #edb/ref 17592186267933}] :answer-field/correct {:answer/id #uuid "c78c4beb-8877-5deb-b67a-b4048ae08bba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-29i-11j+5k" :db/id #edb/ref 17592186267933} :answer-field/id #uuid "6fd4a83a-37bf-56ff-82cf-324caebeb675" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17b9a485-4825-5256-b837-58364fae905a" :question/math-academy-id "q-1392" :question/problem "Let $a=2i-3j+5k$ and $b=-i+4j+3k.$ Determine $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 2 & -3 & 5 \\\\ -1 & 4 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}-3 & 5 \\\\ 4 & 3\\end{vmatrix}i-\\begin{vmatrix}2 & 5 \\\\ -1 & 3\\end{vmatrix}j+\\begin{vmatrix}2 & -3 \\\\ -1 & 4\\end{vmatrix}k \\\\  & =(-3\\cdot 3-5\\cdot 4)i-(2\\cdot 3-5\\cdot (-1))j+(2\\cdot 4-(-3)\\cdot (-1))k \\\\  & =(-9-20)i-(6-(-5))j+(8-3)k \\\\  & =-29i-11j+5k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43518f77-e416-557d-8107-9b42d879435c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2j+3k" :db/id #edb/ref 17592186266745} {:answer/id #uuid "5875829d-b8d2-5df8-a591-fb2bc93a4b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2j+4k" :db/id #edb/ref 17592186266934} {:answer/id #uuid "d25232ec-6ad9-5d5f-986f-d2170f1061fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-3j+6k" :db/id #edb/ref 17592186268024} {:answer/id #uuid "e970a87e-cdda-5021-8a14-ad89f3e43a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3i+2j-4k" :db/id #edb/ref 17592186268220} {:answer/id #uuid "fec153e4-d8d3-5e71-91d9-0327ccf9dd8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-2j+4k" :db/id #edb/ref 17592186268387}] :answer-field/correct {:answer/id #uuid "5875829d-b8d2-5df8-a591-fb2bc93a4b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2j+4k" :db/id #edb/ref 17592186266934} :answer-field/id #uuid "4f4fdb06-eb4a-5a07-b8eb-90c5091d394f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268547}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1f83a16-76ac-5449-b50d-56fce3468edc" :question/math-academy-id "q-1396" :question/problem "Let $a=4i+2j-k$ and $b=2i+2j-k.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 4 & 2 & -1 \\\\ 2 & 2 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -1 \\\\ 2 & -1\\end{vmatrix}i-\\begin{vmatrix}4 & -1 \\\\ 2 & -1\\end{vmatrix}j+\\begin{vmatrix}4 & 2 \\\\ 2 & 2\\end{vmatrix}k \\\\  & =(2\\cdot (-1)-(-1)\\cdot 2)i-(4\\cdot (-1)-(-1)\\cdot 2)j+(4\\cdot 2-2\\cdot 2)k \\\\  & =(-2+2)i-(-4+2)j+(8-4)k \\\\  & =2j+4k.\\end{aligned}\n$$"}]}
