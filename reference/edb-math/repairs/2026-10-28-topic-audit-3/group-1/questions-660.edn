98 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291461} :answer-field/id #uuid "9b940c17-3920-5ba9-9e64-fea7544b7c01" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292227} {:answer-field/choices [{:answer/id #uuid "fe1e4193-5dae-59e5-9a11-ed901a28f7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186291715}] :answer-field/correct {:answer/id #uuid "fe1e4193-5dae-59e5-9a11-ed901a28f7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186291715} :answer-field/id #uuid "e309bee4-101d-5be8-8271-cb9e7e983669" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c592e38-9872-58d6-ad10-d75e6115be4c" :question/math-academy-id "q-276261" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3\\operatorname{cos}⁡\\theta -2,\\,y=-5\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$\n\nThe range of $x$ is \n{{field-1}}\n$\\le x$\n{{field-2}}{{field-3}}.\n\nThe range of $y$ is \n{{field-4}}{{field-5}}\n$y\\le $\n{{field-6}}." :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ \nwe have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -3 & \\le 3\\operatorname{cos}⁡\\theta \\le 3 \\\\ -3-2 & \\le 3\\operatorname{cos}⁡\\theta -2\\le 3-2 \\\\ -5 & \\le x\\le 1.\\end{aligned}\n$$\n\nSo, we can conclude that $-5\\le x\\le 1.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ \nwe have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ 5 & \\text{ }\\ge -5\\operatorname{sin}⁡\\theta \\text{ }\\ge -5 \\\\ -5 & \\le -5\\operatorname{sin}⁡\\theta \\le 5 \\\\ -5 & \\le y\\le 5.\\end{aligned}\n$$\n\nSo, we can conclude that $-5\\le y\\le 5.$"}] [{:db/id #edb/ref 17592186292916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f98dd494-7f2f-57dc-af90-42867eb57511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2x+5" :db/id #edb/ref 17592186291685}] :answer-field/correct {:answer/id #uuid "f98dd494-7f2f-57dc-af90-42867eb57511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2x+5" :db/id #edb/ref 17592186291685} :answer-field/id #uuid "c5c7a55c-b5a8-5ece-9653-1e4addb15710" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292338}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "adc18662-35c2-5630-b6c2-775bfa727c41" :question/math-academy-id "q-276277" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=t+1,\\,\\,\\,y={t}^{2}+4,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=t+1\\,⇒\\,t=x-1\\end{aligned}\n$$\n\nNow, substituting $t=x-1$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =(x-1)^{2}+4 \\\\ y & ={x}^{2}-2x+5\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is \n$y={x}^{2}-2x+5.$"}] [{:db/id #edb/ref 17592186292918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efebc768-607d-542f-b7b0-0c55ce311093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186291635}] :answer-field/correct {:answer/id #uuid "efebc768-607d-542f-b7b0-0c55ce311093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186291635} :answer-field/id #uuid "49ec9008-738f-5560-b1c0-bab64077c3f0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291970} {:answer-field/choices [{:answer/id #uuid "27cbd4cc-c040-570c-8981-361a2c723b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+1}{9x+2}" :db/id #edb/ref 17592186290796}] :answer-field/correct {:answer/id #uuid "27cbd4cc-c040-570c-8981-361a2c723b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+1}{9x+2}" :db/id #edb/ref 17592186290796} :answer-field/id #uuid "cd2e0a7d-9fb9-581d-bf54-ae428568db6f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292355}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3e3af460-d835-5ff0-b7d7-10fb0256d9da" :question/math-academy-id "q-276284" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=\\frac{1}{t-4},\\,\\,\\,y=\\frac{t}{2t+1},\\,t\\ne 4,\\,\\,\\,t\\ne -\\frac{1}{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}$,\\,\\,\\,x\\ne 0.$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\nx=\\frac{1}{t-4}\\,⇒\\,t=\\frac{4x+1}{x}\n$$\n\nNow, substituting $t=\\frac{4x+1}{x}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{\\left(\\frac{4x+1}{x}\\right)}{(2\\cdot \\frac{4x+1}{x}+1)} \\\\ y & =\\frac{\\left(\\frac{4x+1}{x}\\right)}{(\\frac{8x+2}{x}+1)} \\\\ y & =\\frac{\\left(\\frac{4x+1}{x}\\right)}{\\left(\\frac{9x+2}{x}\\right)} \\\\ y & =\\frac{4x+1}{\\cancel{x}}\\cdot \\frac{\\cancel{x}}{9x+2} \\\\ y & =\\frac{4x+1}{9x+2}\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{4x+1}{9x+2}.$\n\nFinally, since $t\\ne -\\frac{1}{2}$ and $x=\\frac{1}{t-4}$ has range $x\\ne 0,$ we must have \n$x\\ne -\\frac{2}{9},\\text{ }0.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{4x+1}{9x+2},\\,x\\ne -\\frac{2}{9},\\,\\,\\,x\\ne 0.\n$$"}] [{:db/id #edb/ref 17592186295036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454ab559-0463-58cc-b8f7-993681500e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186293217}] :answer-field/correct {:answer/id #uuid "454ab559-0463-58cc-b8f7-993681500e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186293217} :answer-field/id #uuid "585c6175-585c-54e6-9617-f4289923f490" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294244} {:answer-field/choices [{:answer/id #uuid "7d53cfa7-375e-515e-aa72-f7105d1e5804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293434}] :answer-field/correct {:answer/id #uuid "7d53cfa7-375e-515e-aa72-f7105d1e5804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293434} :answer-field/id #uuid "91e1cc24-43ff-5303-a05f-20b1c76dcbe7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294455} {:answer-field/choices [{:answer/id #uuid "f843b8cf-4fcb-56a0-9159-30576fdb3b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293905}] :answer-field/correct {:answer/id #uuid "f843b8cf-4fcb-56a0-9159-30576fdb3b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293905} :answer-field/id #uuid "e1617347-a2f0-5514-bfee-a6c151bc925d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294720}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "224ae113-c80c-5cf2-b0fc-e86fad377055" :question/math-academy-id "q-278837" :question/problem "Let $a=5i+2j-3k$ and $b=-2i+j+4k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,-\\,$\n{{field-2}}$\\,j\\,+\\,$\n\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 5 & 2 & -3 \\\\ -2 & 1 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -3 \\\\ 1 & 4\\end{vmatrix}i-\\begin{vmatrix}5 & -3 \\\\ -2 & 4\\end{vmatrix}j+\\begin{vmatrix}5 & 2 \\\\ -2 & 1\\end{vmatrix}k \\\\  & =(2\\cdot 4-(-3)\\cdot 1)i-(5\\cdot 4-(-3)\\cdot (-2))j+(5\\cdot 1-2\\cdot (-2))k \\\\  & =(8+3)i-(20-6)j+(5+4)k \\\\  & =11\\,i-14\\,j+9\\,k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e708bcc-57d6-5c73-b04e-955486a1bf34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293557}] :answer-field/correct {:answer/id #uuid "9e708bcc-57d6-5c73-b04e-955486a1bf34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293557} :answer-field/id #uuid "48faf064-a2f6-51ea-9045-dffbdc7bd32a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294187}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7575e8a2-e97b-54b4-80f9-81b1c7ceb471" :question/math-academy-id "q-278839" :question/problem "Let $a=⟨x,2,1⟩,$ $b=⟨2,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{20}.$ Find $x.$\n\n$\\,x=$\n{{field-1}}" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ x & 2 & 1 \\\\ 2 & 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ 0 & 1\\end{vmatrix}i-\\begin{vmatrix}x & 1 \\\\ 2 & 1\\end{vmatrix}j+\\begin{vmatrix}x & 2 \\\\ 2 & 0\\end{vmatrix}k \\\\  & =(2-0)i-(x-2)j+(0-4)k \\\\  & =⟨2,2-x,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{2}^{2}+(2-x)^{2}+(-4)^{2}} \\\\  & =\\sqrt{4+4-4x+{x}^{2}+16} \\\\  & =\\sqrt{{x}^{2}-4x+24}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{20} \\\\ \\sqrt{{x}^{2}-4x+24} & =\\sqrt{20} \\\\ {x}^{2}-4x+24 & =20 \\\\ {x}^{2}-4x+4 & =0 \\\\ (x-2)^{2} & =0 \\\\ x-2 & =0 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the solution is $x=2.$"}] [{:db/id #edb/ref 17592186295221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbab67b3-7d0f-537e-9798-0376f74dd4a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186293785}] :answer-field/correct {:answer/id #uuid "dbab67b3-7d0f-537e-9798-0376f74dd4a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186293785} :answer-field/id #uuid "008790ca-896d-5113-a160-c4684988b980" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293933} {:answer-field/choices [{:answer/id #uuid "0eccad49-bfcd-524d-9ad6-381305b4df10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186292999}] :answer-field/correct {:answer/id #uuid "0eccad49-bfcd-524d-9ad6-381305b4df10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186292999} :answer-field/id #uuid "44d723b9-c277-5700-b3eb-e0cfc5affd0c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294172} {:answer-field/choices [{:answer/id #uuid "91cd88bc-6aa7-56d5-bc7e-8591184f6832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293505}] :answer-field/correct {:answer/id #uuid "91cd88bc-6aa7-56d5-bc7e-8591184f6832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293505} :answer-field/id #uuid "dff13c51-20e9-5b9c-bd55-04ef7de01e8e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294712}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31aedb57-6eee-5721-b9e8-c3980bbe0170" :question/math-academy-id "q-281969" :question/problem "Let $u=⟨3,4,-1⟩$ and $v=⟨2,-5,2⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 3 & 4 & -1 \\\\ 2 & -5 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}4 & -1 \\\\ -5 & 2\\end{vmatrix}i-\\begin{vmatrix}3 & -1 \\\\ 2 & 2\\end{vmatrix}j+\\begin{vmatrix}3 & 4 \\\\ 2 & -5\\end{vmatrix}k \\\\  & =(4\\cdot 2-(-1)\\cdot (-5))i-(3\\cdot 2-(-1)\\cdot 2)j+(3\\cdot (-5)-4\\cdot 2)k \\\\  & =(8-5)i-(6+2)j+(-15-8)k \\\\  & =3i-8j-23k \\\\  & =⟨3,-8,-23⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c737a85-5318-5c21-8405-0341aa5eebed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293304}] :answer-field/correct {:answer/id #uuid "5c737a85-5318-5c21-8405-0341aa5eebed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293304} :answer-field/id #uuid "3293e820-ede2-5c66-b7ea-8a8a3d8ea498" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294105} {:answer-field/choices [{:answer/id #uuid "d063838b-06cc-5c68-b10f-20e5ea9ac06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186293739}] :answer-field/correct {:answer/id #uuid "d063838b-06cc-5c68-b10f-20e5ea9ac06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186293739} :answer-field/id #uuid "736033e4-bb47-5d3b-ad57-a631a9eacbd1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294337} {:answer-field/choices [{:answer/id #uuid "a6122648-dc4e-5f4c-a38e-883bd17e8d3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293586}] :answer-field/correct {:answer/id #uuid "a6122648-dc4e-5f4c-a38e-883bd17e8d3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293586} :answer-field/id #uuid "879e3549-61d9-5d6f-97bc-5184af07219d" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294415}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21cf46ef-dcff-5226-aa0a-bbfa6e2218ee" :question/math-academy-id "q-281976" :question/problem "Let $u=⟨\\sqrt{3},2,0⟩$ and $v=⟨1,0,-1⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ \\sqrt{3} & 2 & 0 \\\\ 1 & 0 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 0 \\\\ 0 & -1\\end{vmatrix}i-\\begin{vmatrix}\\sqrt{3} & 0 \\\\ 1 & -1\\end{vmatrix}j+\\begin{vmatrix}\\sqrt{3} & 2 \\\\ 1 & 0\\end{vmatrix}k \\\\  & =(2\\cdot -1-0\\cdot 0)i-(\\sqrt{3}\\cdot -1-0\\cdot 1)j+(\\sqrt{3}\\cdot 0-2\\cdot 1)k \\\\  & =-2i+\\sqrt{3}j-2k \\\\  & =⟨-2,\\sqrt{3},-2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206ed248-3cd2-539e-b50d-49612fa287d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186293070}] :answer-field/correct {:answer/id #uuid "206ed248-3cd2-539e-b50d-49612fa287d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186293070} :answer-field/id #uuid "7fa4f1cc-54f8-508d-a192-eae9487f5d08" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294378} {:answer-field/choices [{:answer/id #uuid "3914a06d-7f57-5936-b194-290d53f5ce2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293170}] :answer-field/correct {:answer/id #uuid "3914a06d-7f57-5936-b194-290d53f5ce2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293170} :answer-field/id #uuid "e1c84dcb-89ee-5e21-8ea6-ed91a4b53259" :answer-field/key "field-2" :answer-