t formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 3 & -4 & 1 \\\\ -2 & 5 & 6\\end{vmatrix} \\\\  & =\\begin{vmatrix}-4 & 1 \\\\ 5 & 6\\end{vmatrix}i-\\begin{vmatrix}3 & 1 \\\\ -2 & 6\\end{vmatrix}j+\\begin{vmatrix}3 & -4 \\\\ -2 & 5\\end{vmatrix}k \\\\  & =((-4)(6)-(1)(5))i-((3)(6)-(1)(-2))j+((3)(5)-(-4)(-2))k \\\\  & =(-24-5)i-(18+2)j+(15-8)k \\\\  & =-29\\,i-20\\,j+7\\,k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20b4abf1-83f6-5db6-8a1c-71a3d039a704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293072}] :answer-field/correct {:answer/id #uuid "20b4abf1-83f6-5db6-8a1c-71a3d039a704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293072} :answer-field/id #uuid "75fb4821-c09b-5cda-9e7f-92035716dba0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294344} {:answer-field/choices [{:answer/id #uuid "4965135f-6793-52b6-afb9-7d2821f4d6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186293234}] :answer-field/correct {:answer/id #uuid "4965135f-6793-52b6-afb9-7d2821f4d6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186293234} :answer-field/id #uuid "afb66c75-459b-55d9-9985-8158a336e7c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294558} {:answer-field/choices [{:answer/id #uuid "dcb6b898-1fb3-5a08-bbf8-7bff3cc110b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293789}] :answer-field/correct {:answer/id #uuid "dcb6b898-1fb3-5a08-bb