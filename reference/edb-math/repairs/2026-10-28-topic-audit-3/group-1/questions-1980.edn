4.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186642526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1244800c-3e24-567f-9005-b700597d5de2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186642502} {:answer/id #uuid "508eaebb-0a1d-5c44-a764-c262941bad16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186642508} {:answer/id #uuid "66f9d56f-1a77-5799-9c68-d544176a82d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186642513} {:answer/id #uuid "851356eb-e94a-539e-b869-87f1c6e12d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186642519} {:answer/id #uuid "9054abe9-2096-5f22-ae81-cb3435c7d868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186642520}] :answer-field/correct {:answer/id #uuid "66f9d56f-1a77-5799-9c68-d544176a82d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186642513} :answer-field/id #uuid "06b2663b-60eb-59e2-970d-f4bc898ac723" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642498}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cda8aad7-5e10-509d-9064-07f40ca3529c" :question/problem "Simplify the trigonometric expression $-4\\sin^{2} t\\left(1+\\frac{\\cos^{2} t}{\\sin^{2} t}\\right).$ Assume $\\sin t\\ne0$." :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\n& -4\\sin^{2} t\\left(1+\\frac{\\cos^{2} t}{\\sin^{2} t}\\right) \\\\ &= -4\\sin^{2} t \\\\ &\\quad {}-4\\sin^{2} t\\cdot\\frac{\\cos^{2} t}{\\sin^{2} t}\n\\end{aligned}\n$$\n\nNext, we group the $\\sin^2 t$ and $\\cos^2 t$ terms and simplify any matching factors.\n\n$$\n\\begin{aligned}\n& -4\\sin^{2} t \\\\ &\\quad {}-4\\sin^{2} t\\cdot\\frac{\\cos^{2} t}{\\sin^{2} t} \\\\ &= -4(\\sin^{2} t+\\cos^{2} t)\n\\end{aligned}\n$$\n\nThen, we use $\\sin^2 t+\\cos^2 t=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\n& -4(\\sin^{2} t+\\cos^{2} t) \\\\ &= -4\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\n& -4\\sin^{2} t\\left(1+\\frac{\\cos^{2} t}{\\sin^{2} t}\\right) \\\\ &= -4.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186642529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33a1745f-50e8-5baf-9bc6-deeba4519e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186642505} {:answer/id #uuid "5c8bd9c3-9a26-5786-a1b3-555803fbaee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186642510} {:answer/id #uuid "6adc45b8-d501-5835-9cc8-c398d8352c30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186642514} {:answer/id #uuid "7638e641-f38d-5a4d-bec6-cb14785fb83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186642517} {:answer/id #uuid "cdc4cb7a-3cef-567c-9c3c-9612a89a1b02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186642527}] :answer-field/correct {:answer/id #uuid "5c8bd9c3-9a26-5786-a1b3-555803fbaee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186642510} :answer-field/id #uuid "0915cbf4-e9df-5bd4-8e47-64582c4fcb41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642500}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d31ec4d9-6b95-5873-abee-338c54852ecb" :question/problem "Simplify the trigonometric expression $\\cos x(6\\cos x-10\\frac{1}{\\cos x})+6\\sin^{2} x.$ Assume $\\cos x\\ne0$." :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\n& \\cos x(6\\cos x-10\\frac{1}{\\cos x}) \\\\ &\\quad {}+6\\sin^{2} x \\\\ &= 6\\cos^{2} x \\\\ &\\quad {}+\\cos x\\cdot\\frac{-10}{\\cos x} \\\\ &\\quad {}+6\\sin^{2} x\n\\end{aligned}\n$$\n\nNext, we group the $\\sin^2 x$ and $\\cos^2 x$ terms and simplify any matching factors.\n\n$$\n\\begin{aligned}\n& 6\\cos^{2} x \\\\ &\\quad {}+\\cos x\\cdot\\frac{-10}{\\cos x} \\\\ &\\quad {}+6\\sin^{2} x \\\\ &= 6(\\cos^{2} x+\\sin^{2} x)-10\n\\end{aligned}\n$$\n\nThen, we use $\\sin^2 x+\\cos^2 x=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\n& 6(\\cos^{2} x+\\sin^{2} x)-10 \\\\ &= -4\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\n& \\cos x(6\\cos x-10\\frac{1}{\\cos x}) \\\\ &\\quad {}+6\\sin^{2} x \\\\ &= -4.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186642541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042206c8-9361-579c-9b52-4e460684fdf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-2\\cdot \\sin^{2} \\theta}{\\sin \\theta}" :db/id #edb/ref 17592186642536} {:answer/id #uuid "0bbae4b7-4ef3-5b23-ad0d-72bea7aeb9bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+2\\cdot \\sin^{2} \\theta}{\\sin \\theta}" :db/id #edb/ref 17592186642538} {:answer/id #uuid "2f0dd4e4-ea7e-5ccb-8589-ad426c0bd446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sin \\theta}" :db/id #edb/ref 17592186642543} {:answer/id #uuid "bab83435-bede-58fd-bf20-8cbf5985009e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :