7592186641764} {:answer/id #uuid "ae9403c3-77d9-5ceb-97fd-c71b48faa3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\sec t" :db/id #edb/ref 17592186641766} {:answer/id #uuid "eb4b1ebe-c061-567d-9a56-22abc8ac153f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\csc t" :db/id #edb/ref 17592186641779} {:answer/id #uuid "ee3d05cb-784c-54f5-b093-e564d93b0936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\sin t" :db/id #edb/ref 17592186641780}] :answer-field/correct {:answer/id #uuid "ee3d05cb-784c-54f5-b093-e564d93b0936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\sin t" :db/id #edb/ref 17592186641780} :answer-field/id #uuid "2515ccc9-c955-5989-bb1d-20c87861cd4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186641749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1b41b73-9540-58b9-82b4-614a11c198e7" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle \\frac{2\\,\\sin^{3} t\\,\\cos^{2} t}{\\sin^{4} t\\,\\cos^{2} t+\\sin^{2} t\\,\\cos^{4} t}.\n$$" :question/worked-solution "First, we factor the denominator:\n\n$$\n\\begin{aligned}&\\frac{2\\,\\sin^{3} t\\,\\cos^{2} t}{\\sin^{4} t\\,\\cos^{2} t+\\sin^{2} t\\,\\cos^{4} t} \\\\ &=\\frac{2\\,\\sin^{3} t\\,\\cos^{2} t}{\\sin^{2} t\\,\\cos^{2} t\\,(\\sin^{2} t+\\cos^{2} t)}\\end{aligned}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}&\\frac{2\\,\\sin^{3} t\\,\\cos^{2} t}{\\sin^{2} t\\,\\cos^{2} t\\,(\\sin^{2} t+\\cos^{2} t)} \\\\ &=\\frac{2\\,\\sin^{3} t\\,\\cos^{2} t}{\\sin^{2} t\\,\\cos^{2} t\\cdot 1} \\\\ &=\\frac{2\\,\\sin^{3} t\\,\\cos^{2} t}{\\sin^{2} t\\,\\cos^{2} t} \\\\ &=\\frac{2\\,\\cancel{\\sin^{2} t\\,\\cos^{2} t}\\,\\sin t}{\\cancel{\\sin^{2} t\\,\\cos^{2} t}} \\\\ &=\\frac{2\\,\\sin t}{1} \\\\ &=2\\,\\sin t\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\begin{aligned}&\\frac{2\\,\\sin^{3} t\\,\\cos^{2} t}{\\sin^{4} t\\,\\cos^{2} t+\\sin^{2} t\\,\\cos^{4} t} \\\\ &=2\\,\\sin t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186641777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b1c60d3-213f-589a-8596-b624971527e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\cos \\phi" :db/id #edb/ref 17592186641756} {:answer/id #uuid "6fcd45fe-8cf4-539a-ba20-46dbfbe77139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\sec \\phi" :db/id #edb/ref 17592186641759} {:answer/id #uuid "97e9b7c0-f8ec-595f-a9a9-945460926c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\sin \\phi" :db/id #edb/ref 17592186641762} {:answer/id #uuid "99b0914c-ad21-5c82-92b4-cc788012c5ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\tan \\phi" :db/id #edb/ref 17592186641763} {:answer/id #uuid "b35ec7b3-db56-531d-a147-a5783b58e167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\csc \\phi" :db/id #edb/ref 17592186641769}] :answer-field/correct {:answer/id #uuid "6b1c60d3-213f-589a-8596-b624971527e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\cos \\phi" :db/id #edb/ref 17592186641756} :answer-field/id #uuid "3edf34b7-8ae8-5b32-bc80-4971661d2c62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186641751}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc0daa88-fe19-59ad-b694-88204e229bf2" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle \\frac{3\\,\\sin \\phi\\,\\cos^{3} \\phi}{\\sin \\phi\\,\\cos^{4} \\phi+\\sin^{3} \\phi\\,\\cos^{2} \\phi}.\n$$" :question/worked-solution "First, we factor the denominator:\n\n$$\n\\begin{aligned}&\\frac{3\\,\\sin \\phi\\,\\cos^{3} \\phi}{\\sin \\phi\\,\\cos^{4} \\phi+\\sin^{3} \\phi\\,\\cos^{2} \\phi} \\\\ &=\\frac{3\\,\\sin \\phi\\,\\cos^{3} \\phi}{\\sin \\phi\\,\\cos^{2} \\phi\\,(\\sin^{2} \\phi+\\cos^{2} \\phi)}\\end{aligned}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}&\\frac{3\\,\\sin \\phi\\,\\cos^{3} \\phi}{\\sin \\phi\\,\\cos^{2} \\phi\\,(\\sin^{2} \\phi+\\cos^{2} \\phi)} \\\\ &=\\frac{3\\,\\sin \\phi\\,\\cos^{3} \\phi}{\\sin \\phi\\,\\cos^{2} \\phi\\cdot 1} \\\\ &=\\frac{3\\,\\sin \\phi\\,\\cos^{3} \\phi}{\\sin \\phi\\,\\cos^{2} \\phi} \\\\ &=\\frac{3\\,\\cancel{\\sin \\phi\\,\\cos^{2} \\phi}\\,\\cos \\phi}{\\cancel{\\sin \\phi\\,\\cos^{2} \\phi}} \\\\ &=\\frac{3\\,\\cos \\phi}{1} \\\\ &=3\\,\\cos \\phi\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\begin{aligned}&\\frac{3\\,\\sin \\phi\\,\\cos^{3} \\phi}{\\sin \\phi\\,\\cos^{4} \\phi+\\sin^{3} \\phi\\,\\cos^{2} \\phi} \\\\ &=3\\,\\cos \\phi\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186641778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6802b883-73df-5de0-8f8b-3abab4b45238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\tan \\theta" :db/id #edb/ref 17592186641755} {:answer/id #uuid "6dd20548-e7e0-58ad-bab8-e8b766cd5d56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\cot \\theta" :db/id #edb/ref 17592186641757} {:answer/id #uuid "8c04768d-96e7-5a06-85a0-20a35d426d8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\sin \\theta" :db/id #edb/ref 17592186641761} {:answer/id #uuid "c86a85db-1688-521b-9165-914e27a7b2e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\csc \\theta" :db/id #edb/ref 17592186641774} {:answer/id #uuid "d7a769b0-01e8-5984-aa58-b0fabdbb8f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\cos \\theta" :db/id #edb/ref 17592186641776}] :answer-field/correct {:answer/id #uuid "8c04768d-96e7-5a06-85a0-20a35d426d8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\sin \\theta" :db/id #edb/ref 17592186641761} :answer-field/id #uuid "b4e8e7ac-0fbc-53f4-8464-112c22c329fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186641770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc7552e9-b6fa-5d2b-98f0-c180a52b6549" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle \\frac{6\\,\\sin^{3} \\theta\\,\\cos^{3} \\theta+6\\,\\sin^{5} \\theta\\,\\cos \\theta}{\\sin^{2} \\theta\\,\\cos \\theta}.\n$$" :question/worked-solution "First, we factor the numerator:\n\n$$\n\\begin{aligned}&\\frac{6\\,\\sin^{3} \\theta\\,\\cos^{3} \\theta+6\\,\\sin^{5} \\theta\\,\\cos \\theta}{\\sin^{2} \\theta\\,\\cos \\theta} \\\\ &=\\frac{6\\,\\sin^{3} \\theta\\,\\cos \\theta\\,(\\sin^{2} \\theta+\\cos^{2} \\theta)}{\\sin^{2} \\theta\\,\\cos \\theta}\\end{aligned}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}&\\frac{6\\,\\sin^{3} \\theta\\,\\cos \\theta\\,(\\sin^{2} \\theta+\\cos^{2} \\theta)}{\\sin^{2} \\theta\\,\\cos \\theta} \\\\ &=\\frac{6\\,\\sin^{3} \\theta\\,\\cos \\theta\\cdot 1}{\\sin^{2} \\theta\\,\\cos \\theta} \\\\ &=\\frac{6\\,\\sin^{3} \\theta\\,\\cos \\theta}{\\sin^{2} \\theta\\,\\cos \\theta} \\\\ &=\\frac{6\\,\\cancel{\\sin^{2} \\theta\\,\\cos \\theta}\\,\\sin \\theta}{\\cancel{\\sin^{2} \\theta\\,\\cos \\theta}} \\\\ &=\\frac{6\\,\\sin \\theta}{1} \\\\ &=6\\,\\sin \\theta\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\begin{aligned}&\\frac{6\\,\\sin^{3} \\theta\\,\\cos^{3} \\theta+6\\,\\sin^{5} \\theta\\,\\cos \\theta}{\\sin^{2} \\theta\\,\\cos \\theta} \\\\ &=6\\,\\sin \\theta\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186642427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c6c37f9-670d-5e76-bf10-1645639ef0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{2+\\cos^{2} \\alpha}" :db/id #edb/ref 17592186642435} {:answer/id #uuid "4a088dba-8946-591e-9297-ef8f73e7d799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2+\\cos^{2} \\alpha}" :db/id #edb/ref 17592186642441} {:answer/id #uuid "65af9427-79f3-516c-aa9b-ecd99957c10d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{2+\\cos^{2} \\alpha}" :db/id #edb/ref 17592186642444} {:answer/id #uuid "6d83416c-8859-5415-aa87-3037fb585406" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2+\\cos^{2} \\alpha}" :db/id #edb/ref 17592186642445} {:answer/id #uuid "dbe49f15-38ab-51de-aa1a-1932e2eab804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2+\\cos^{2} \\alpha}" :db/id #edb/ref 17592186642458}] :answer-field/correct {:answer/id #uuid "dbe49f15-38ab-51de-aa1a-1932e2eab804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2+\\cos^{2} \\alpha}" :db/id #edb/ref 17592186642458} :answer-field/id #uuid "d0eccd59-33a2-5a8e-8550-c195abddfa96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642455}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04e98ede-0b0b-5ea3-a307-8ad39d366250" :question/problem "Simplify the trigonometric expression $1+\\frac{(1)\\cdot (\\sin^{2} \\alpha)}{2+\\cos^{2} \\alpha}.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions. Then we expand the numerator, group the squared terms, and use the Pythagorean identity:\n\n$$\n\\begin{aligned}& \\frac{(2+\\cos^{2} \\alpha)+\\sin^{2} \\alpha}{2+\\cos^{2} \\alpha} \\\\ & =\\frac{2+\\cos^{2} \\alpha+\\sin^{2} \\alpha}{2+\\cos^{2} \\alpha} \\\\ & =\\frac{2+(\\cos^{2} \\alpha+\\sin^{2} \\alpha)}{2+\\cos^{2} \\alpha} \\\\ & =\\frac{(2+1)}{2+\\cos^{2} \\alpha} \\\\ & =\\frac{3}{2+\\cos^{2} \\alpha}\\end{aligned}\n$$\n\nHere we used $\\cos^{2} \\alpha+\\sin^{2} \\alpha=1$. Therefore, the expression simplifies to $\\frac{3}{2+\\cos^{2} \\alpha}$."}] [{:db/id #edb/ref 17592186642430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f2ed4fa-8905-5003-9b64-a415c068098f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+3\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}" :db/id #edb/ref 17592186642431} {:answer/id #uuid "401322ea-9620-58b0-a31d-7027ee61c21d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-3\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}" :db/id #edb/ref 17592186642439} {:answer/id #uuid "9852c8e8-6d4c-5752-ba12-90edd42f1964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-4\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}" :db/id #edb/ref 17592186642449} {:answer/id #uuid "d76156c3-eb8f-5f6f-ba3c-b1692f030c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+4\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}" :db/id #edb/ref 17592186642456} {:answer/id #uuid "da2e156f-4530-5673-b0fa-1d1bddd1d4a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+2\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}" :db/id #edb/ref 17592186642457}] :answer-field/correct {:answer/id #uuid "9852c8e8-6d4c-5752-ba12-90edd42f1964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-4\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}" :db/id #edb/ref 17592186642449} :answer-field/id #uuid "3925102d-bfac-52ee-ace0-91049849aaa4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19e883ba-63c3-5a07-9695-7567275e7fc9" :question/problem "Simplify the trigonometric expression $2\\cdot \\cot \\theta-\\frac{4-2\\cdot \\sin \\theta}{\\cos \\theta}.$" :question/worked-solution "First, rewrite the quotient ratio as a fraction. Then put both terms over a common denominator and combine the signed numerators.\n\n$$\n\\begin{aligned}& \\frac{2\\cdot \\cos \\theta}{\\sin \\theta}-\\frac{4-2\\cdot \\sin \\theta}{\\cos \\theta} \\\\ & =\\frac{2\\cdot \\cos^{2} \\theta-4\\cdot \\sin \\theta+2\\cdot \\sin^{2} \\theta}{\\cos \\theta\\cdot \\sin \\theta} \\\\ & =\\frac{2\\cdot (\\cos^{2} \\theta+\\sin^{2} \\theta)-4\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta} \\\\ & =\\frac{2-4\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}\\end{aligned}\n$$\n\nWe used $\\cos^{2} \\theta+\\sin^{2} \\theta=1$. The simplified expression is $\\frac{2-4\\cdot \\sin \\theta}{\\cos \\theta\\cdot \\sin \\theta}$, on the domain of the original expression."}] [{:db/id #edb/ref 17592186642443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7666cc-a485-5e26-95d0-da063261f98e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-\\cos^{2} \\alpha}{\\sin \\alpha}" :db/id #edb/ref 17592186642428} {:answer/id #uuid "19388950-7a33-5dc6-a396-94da9f4c142e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sin \\alpha}" :db/id #edb/ref 17592186642429} {:answer/id #uuid "414792b1-7652-5a9f-87cd-933947e7d1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\cos^{2} \\alpha}{\\sin \\alpha}" :db/id #edb/ref 17592186642440} {:answer/id #uuid "b32b4105-3619-5380-bcf8-18c845a1b3e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sin \\alpha}" :db/id #edb/ref 17592186642452} {:answer/id #uuid "cf6b19e6-e610-5b5d-869b-f8d2402e89d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-\\cos^{2} \\alpha}{\\sin \\alpha}" :db/id #edb/ref 17592186642453}] :answer-field/correct {:answer/id #uuid "414792b1-7652-5a9f-87cd-933947e7d1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\cos^{2} \\alpha}{\\sin \\alpha}" :db/id #edb/ref 17592186642440} :answer-field/id #uuid "0242864c-9dc9-5313-9a3a-0200979b09eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ff7fdf3-ac4e-5773-a9ad-d5cbad0433c5" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle \\cos \\alpha(\\frac{4\\cdot \\sin \\alpha}{\\cos \\alpha}+\\frac{3\\cdot \\cos \\alpha}{\\sin \\alpha}).\n$$" :question/worked-solution "Expand the outer factor and combine the fractions. Cancel the shared factor, retaining the exclusions of the original denominators.\n\n$$\n\\begin{aligned}& \\frac{\\cos \\alpha(4\\cdot \\sin^{2} \\alpha+3\\cdot \\cos^{2} \\alpha)}{\\cos \\alpha\\cdot \\sin \\alpha} \\\\ & =\\frac{4\\cdot \\sin^{2} \\alpha+3\\cdot \\cos^{2} \\alpha}{\\sin \\alpha} \\\\ & =\\frac{4\\cdot (\\sin^{2} \\alpha+\\cos^{2} \\alpha)-\\cos^{2} \\alpha}{\\sin \\alpha} \\\\ & =\\frac{4-\\cos^{2} \\alpha}{\\sin \\alpha}\\end{aligned}\n$$\n\nWe used $\\cos^{2} \\alpha+\\sin^{2} \\alpha=1$. The simplified expression is $\\frac{4-\\cos^{2} \\alpha}{\\sin \\alpha}$, on the domain of the original expression."}] [{:db/id #edb/ref 17592186642454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae07a61-28dc-5560-b150-3c41a71c49af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+\\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}" :db/id #edb/ref 17592186642434} {:answer/id #uuid "324f9d34-a959-52b1-a35c-c1749ec02cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-\\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}" :db/id #edb/ref 17592186642436} {:answer/id #uuid "7422d01d-c1b0-596c-aaa8-5905a2e2498d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+4\\cdot \\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}" :db/id #edb/ref 17592186642446} {:answer/id #uuid "aaeb864a-3de2-5269-ac72-76a4f9930ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+4\\cdot \\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}" :db/id #edb/ref 17592186642450} {:answer/id #uuid "e09381c9-ec69-51e6-bdc4-dc8cfc52c38e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+3\\cdot \\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}" :db/id #edb/ref 17592186642460}] :answer-field/correct {:answer/id #uuid "7422d01d-c1b0-596c-aaa8-5905a2e2498d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+4\\cdot \\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}" :db/id #edb/ref 17592186642446} :answer-field/id #uuid "4e16da84-3c2f-5179-afa9-687c374c786a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642442}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d08e286d-7db5-5663-863c-bd17ee4871fe" :question/problem "Simplify the trigonometric expression $3\\cdot \\tan \\theta+\\frac{4+3\\cdot \\cos \\theta}{\\sin \\theta}.$" :question/worked-solution "First, rewrite the quotient ratio as a fraction. Then put both terms over a common denominator and combine the signed numerators.\n\n$$\n\\begin{aligned}& \\frac{3\\cdot \\sin \\theta}{\\cos \\theta}+\\frac{4+3\\cdot \\cos \\theta}{\\sin \\theta} \\\\ & =\\frac{3\\cdot \\sin^{2} \\theta+4\\cdot \\cos \\theta+3\\cdot \\cos^{2} \\theta}{\\sin \\theta\\cdot \\cos \\theta} \\\\ & =\\frac{3\\cdot (\\sin^{2} \\theta+\\cos^{2} \\theta)+4\\cdot \\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta} \\\\ & =\\frac{3+4\\cdot \\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}\\end{aligned}\n$$\n\nWe used $\\sin^{2} \\theta+\\cos^{2} \\theta=1$. The simplified expression is $\\frac{3+4\\cdot \\cos \\theta}{\\sin \\theta\\cdot \\cos \\theta}$, on the domain of the original expression."}] [{:db/id #edb/ref 17592186642459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20484ca5-1059-5fc6-b65d-3361a98405d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186642432} {:answer/id #uuid "21e95438-42e2-5c58-9280-494abcdffa3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+\\cos t" :db/id #edb/ref 17592186642433} {:answer/id #uuid "3bbbac60-09bf-5b7a-9241-7819955da0c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186642438} {:answer/id #uuid "7f4858f0-618a-5b58-8f12-466632ac3700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186642447} {:answer/id #uuid "b0947d8a-1c00-514d-aacc-b545f72278ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186642451}] :answer-field/correct {:answer/id #uuid "21e95438-42e2-5c58-9280-494abcdffa3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+\\cos t" :db/id #edb/ref 17592186642433} :answer-field/id #uuid "967eef36-29a1-50df-b72a-37af56390c8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642448}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd7083b4-0a4b-5ae7-8da6-7568258aad9b" :question/problem "Simplify the trigonometric expression $\\frac{-2\\cdot \\sin^{2} t}{1-\\cos t}+3\\cdot \\cos t.$" :question/worked-solution "We put both terms over a common denominator and combine the fractions. Expand the numerator, apply the Pythagorean identity, and group the common factor before cancelling.\n\n$$\n\\begin{aligned}& \\frac{-2\\cdot \\sin^{2} t+3\\cdot (\\cos t(1-\\cos t))}{1-\\cos t} \\\\ & =\\frac{-2\\cdot \\sin^{2} t+3\\cdot \\cos t-3\\cdot \\cos^{2} t}{1-\\cos t} \\\\ & =\\frac{-2+3\\cdot \\cos t-\\cos^{2} t}{1-\\cos t} \\\\ & =\\frac{-2\\cdot (1-\\cos t)+(\\cos t(1-\\cos t))}{1-\\cos t} \\\\ & =-2+\\cos t\\end{aligned}\n$$\n\nWe used $\\cos^{2} t+\\sin^{2} t=1$. The simplified expression is $-2+\\cos t$, on the domain of the original expression."}] [{:db/id #edb/ref 17592186642503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e00d2b-f2be-5709-9384-5e75c497d009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186642499} {:answer/id #uuid "3143d93e-be21-5a76-a7a6-24f00a656232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186642504} {:answer/id #uuid "5fc4f0fb-28de-53cf-8b2a-f02bfdebed91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186642511} {:answer/id #uuid "95ae71fe-5a4e-56d7-b66f-6e625d3b8fd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186642522} {:answer/id #uuid "fe722572-8cee-50cd-9305-32136934963e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186642532}] :answer-field/correct {:answer/id #uuid "95ae71fe-5a4e-56d7-b66f-6e625d3b8fd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186642522} :answer-field/id #uuid "6d142bbd-2fda-594d-b5f7-33af5414476a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642515}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "193bffbc-bd02-5e93-a9bb-c8dacc7cd3a0" :question/problem "Simplify the trigonometric expression $$\n\\displaystyle -2\\cos \\theta\\sin \\theta\\left(\\frac{\\cos \\theta}{\\sin \\theta}+\\frac{\\sin \\theta}{\\cos \\theta}\\right).\n$$ Assume $\\sin \\theta\\ne0$ and $\\cos \\theta\\ne0$." :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\n& -2\\cos \\theta\\sin \\theta\\left(\\frac{\\cos \\theta}{\\sin \\theta}+\\frac{\\sin \\theta}{\\cos \\theta}\\right) \\\\ &= -2\\cos \\theta\\sin \\theta\\cdot\\frac{\\cos \\theta}{\\sin \\theta} \\\\ &\\quad {}-2\\cos \\theta\\sin \\theta\\cdot\\frac{\\sin \\theta}{\\cos \\theta}\n\\end{aligned}\n$$\n\nNext, we group the $\\sin^2 \\theta$ and $\\cos^2 \\theta$ terms and simplify any matching factors.\n\n$$\n\\begin{aligned}\n& -2\\cos \\theta\\sin \\theta\\cdot\\frac{\\cos \\theta}{\\sin \\theta} \\\\ &\\quad {}-2\\cos \\theta\\sin \\theta\\cdot\\frac{\\sin \\theta}{\\cos \\theta} \\\\ &= -2(\\cos^{2} \\theta+\\sin^{2} \\theta)\n\\end{aligned}\n$$\n\nThen, we use $\\sin^2 \\theta+\\cos^2 \\theta=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\n& -2(\\cos^{2} \\theta+\\sin^{2} \\theta) \\\\ &= -2\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\n& -2\\cos \\theta\\sin \\theta\\left(\\frac{\\cos \\theta}{\\sin \\theta}+\\frac{\\sin \\theta}{\\cos \\theta}\\right) \\\\ &= -2.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186642521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4910559b-e60b-55f7-aca9-00c78cfbe001" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186642507} {:answer/id #uuid "53b116d2-f521-5daf-a5be-93fcd69db07b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186642509} {:answer/id #uuid "66334c90-e17e-5784-afcb-07cd8518291d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186642512} {:answer/id #uuid "a2f499f1-7469-5478-aa4e-a5c85826e498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186642525} {:answer/id #uuid "de7020d6-11bf-55b6-a506-55483ad4d25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186642530}] :answer-field/correct {:answer/id #uuid "66334c90-e17e-5784-afcb-07cd8518291d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186642512} :answer-field/id #uuid "0de295f2-67ae-50b3-8526-e67e256db3e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642501}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94129f1d-34c9-5206-a39f-388483770c93" :question/problem "Simplify the trigonometric expression $\\sin t(3\\sin t+3\\frac{1}{\\sin t})+3\\cos^{2} t.$ Assume $\\sin t\\ne0$." :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\n& \\sin t(3\\sin t+3\\frac{1}{\\sin t}) \\\\ &\\quad {}+3\\cos^{2} t \\\\ &= 3\\sin^{2} t \\\\ &\\quad {}+\\sin t\\cdot\\frac{3}{\\sin t} \\\\ &\\quad {}+3\\cos^{2} t\n\\end{aligned}\n$$\n\nNext, we group the $\\sin^2 t$ and $\\cos^2 t$ terms and simplify any matching factors.\n\n$$\n\\begin{aligned}\n& 3\\sin^{2} t \\\\ &\\quad {}+\\sin t\\cdot\\frac{3}{\\sin t} \\\\ &\\quad {}+3\\cos^{2} t \\\\ &= 3(\\sin^{2} t+\\cos^{2} t)+3\n\\end{aligned}\n$$\n\nThen, we use $\\sin^2 t+\\cos^2 t=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\n& 3(\\sin^{2} t+\\cos^{2} t)+3 \\\\ &= 6\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\n& \\sin t(3\\sin t+3\\frac{1}{\\sin t}) \\\\ &\\quad {}+3\\cos^{2} t \\\\ &= 6.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186642524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4882febe-61e3-5e56-887a-fde8186d9be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\cos \\theta + 4" :db/id #edb/ref 17592186642506} {:answer/id #uuid "747a93cf-3afb-52c8-adf9-b79175f9054c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - 2 \\cos \\theta" :db/id #edb/ref 17592186642516} {:answer/id #uuid "81963ff7-93ee-501d-85e5-d251a9378e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\cos \\theta - 4" :db/id #edb/ref 17