534} {:answer/id #uuid "61593aef-7df3-5312-af4c-cc461730c266" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\cos \\theta}" :db/id #edb/ref 17592186642549} {:answer/id #uuid "8e6af74b-3f12-55b1-8fbe-c1fabfa17b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+2\\cdot \\cos^{2} \\theta}{\\cos \\theta}" :db/id #edb/ref 17592186642551} {:answer/id #uuid "be1b969d-439c-51b4-8eb6-37e156b0bea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-2\\cdot \\cos^{2} \\theta}{\\cos \\theta}" :db/id #edb/ref 17592186642557} {:answer/id #uuid "dc46cbe5-8e01-5e1e-a7b2-f7cf5a1e09cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-\\cos^{2} \\theta}{\\cos \\theta}" :db/id #edb/ref 17592186642565}] :answer-field/correct {:answer/id #uuid "8e6af74b-3f12-55b1-8fbe-c1fabfa17b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+2\\cdot \\cos^{2} \\theta}{\\cos \\theta}" :db/id #edb/ref 17592186642551} :answer-field/id #uuid "d49d7c59-4a98-5b95-b281-24575d57d94a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642564}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a453489-4c5f-5183-9c8c-fbc80d87c281" :question/problem "Simplify the trigonometric expression $4\\cdot \\cos \\theta+\\frac{2\\cdot \\sin^{2} \\theta}{\\cos \\theta}.$" :question/worked-solution "Put both terms over the common denominator $\\cos \\theta$, and combine the fractions:\n\n$$\n\\begin{aligned}& \\frac{4\\cdot \\cos^{2} \\theta}{\\cos \\theta}+\\frac{2\\cdot \\sin^{2} \\theta}{\\cos \\theta} \\\\ & =\\frac{4\\cdot \\cos^{2} \\theta+2\\cdot \\sin^{2} \\theta}{\\cos \\theta}\\end{aligned}\n$$\n\nGroup the squared terms and use $\\sin^{2} \\theta+\\cos^{2} \\theta=1$:\n\n$$\n\\begin{aligned}& \\frac{2\\cdot (\\sin^{2} \\theta+\\cos^{2} \\theta)+2\\cdot \\cos^{2} \\theta}{\\cos \\theta} \\\\ & =\\frac{2+2\\cdot \\cos^{2} \\theta}{\\cos \\theta}\\end{aligned}\n$$\n\nThe simplified expression is $\\frac{2+2\\cdot \\cos^{2} \\theta}{\\cos \\theta}$, where $\\cos \\theta\\ne 0$."}] [{:db/id #edb/ref 17592186642554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1dcf8f-3626-5552-9a22-ffe580b1d27b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+\\sin^{2} t}{\\sin t}" :db/id #edb/ref 17592186642540} {:answer/id #uuid "4759316f-9b4e-5fc8-b037-ec5ab4d99e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-2\\cdot \\sin^{2} t}{\\sin t}" :db/id #edb/ref 17592186642545} {:answer/id #uuid "5a891a2e-a898-55f1-8714-9d33d7c6b10e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sin^{2} t}{\\sin t}" :db/id #edb/ref 17592186642548} {:answer/id #uuid "bdf8207f-2577-599d-b9f1-3eb6016f482e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sin t}" :db/id #edb/ref 17592186642556} {:answer/id #uuid "cbf4d383-3c5e-57c1-b091-107778ae8528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+2\\cdot \\sin^{2} t}{\\sin t}" :db/id #edb/ref 17592186642561}] :answer-field/correct {:answer/id #uuid "5a891a2e-a898-55f1-8714-9d33d7c6b10e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sin^{2} t}{\\sin t}" :db/id #edb/ref 17592186642548} :answer-field/id #uuid "9571bbda-e0ae-5074-aa5d-fb8469ef44e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8d38820-4c2c-5bd3-b5b1-20705f85abc7" :question/problem "Simplify the trigonometric expression $3\\cdot \\sin t+\\frac{4\\cdot \\cos^{2} t}{\\sin t}.$" :question/worked-solution "Put both terms over the common denominator $\\sin t$, and combine the fractions:\n\n$$\n\\begin{aligned}& \\frac{3\\cdot \\sin^{2} t}{\\sin t}+\\frac{4\\cdot \\cos^{2} t}{\\sin t} \\\\ & =\\frac{3\\cdot \\sin^{2} t+4\\cdot \\cos^{2} t}{\\sin t}\\end{aligned}\n$$\n\nGroup the squared terms and use $\\cos^{2} t+\\sin^{2} t=1$:\n\n$$\n\\begin{aligned}& \\frac{4\\cdot (\\cos^{2} t+\\sin^{2} t)-\\sin^{2} t}{\\sin t} \\\\ & =\\frac{4-\\sin^{2} t}{\\sin t}\\end{aligned}\n$$\n\nThe simplified expression is $\\frac{4-\\sin^{2} t}{\\sin t}$, where $\\sin t\\ne 0$."}] [{:db/id #edb/ref 17592186642560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070443bb-eaaf-57af-8f90-a3b6a21eb112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\cos^{2} x}{\\cos x}" :db/id #edb/ref 17592186642537} {:answer/id #uuid "2f0a60bd-49f0-5a96-bb82-83925f24a841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\cos x}" :db/id #edb/ref 17592186642542} {:answer/id #uuid "55056cfb-2d99-534f-8230-a385ffb4399e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\cdot \\cos^{2} x}{\\cos x}" :db/id #edb/ref 17592186642547} {:answer/id #uuid "90590701-f52c-5f97-ae29-117a17bac0f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2\\cdot \\cos^{2} x}{\\cos x}" :db/id #edb/ref 17592186642552} {:answer/id #uuid "c57763c7-6346-5835-b7f4-6f80cd10ad2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\cos^{2} x}{\\cos x}" :db/id #edb/ref 17592186642559}] :answer-field/correct {:answer/id #uuid "2f0a60bd-49f0-5a96-bb82-83925f24a841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\cos x}" :db/id #edb/ref 17592186642542} :answer-field/id #uuid "025bf92c-2ce4-5429-a7e1-2f33c38afc14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642535}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "caecdbf4-3655-5bb9-a1f7-ffcdc47b6401" :question/problem "Simplify the trigonometric expression $\\cos x+\\frac{\\sin^{2} x}{\\cos x}.$" :question/worked-solution "Put both terms over the common denominator $\\cos x$, and combine the fractions:\n\n$$\n\\begin{aligned}& \\frac{\\cos^{2} x}{\\cos x}+\\frac{\\sin^{2} x}{\\cos x} \\\\ & =\\frac{\\cos^{2} x+\\sin^{2} x}{\\cos x}\\end{aligned}\n$$\n\nGroup the squared terms and use $\\sin^{2} x+\\cos^{2} x=1$:\n\n$$\n\\begin{aligned}& \\frac{(\\sin^{2} x+\\cos^{2} x)}{\\cos x} \\\\ & =\\frac{1}{\\cos x}\\end{aligned}\n$$\n\nThe simplified expression is $\\frac{1}{\\cos x}$, where $\\cos x\\ne 0$."}] [{:db/id #edb/ref 17592186642562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a2e8914-6cc3-50a7-a04f-f47e7724686e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+2\\cdot \\cos^{2} \\alpha}{\\cos \\alpha}" :db/id #edb/ref 17592186642539} {:answer/id #uuid "82805622-fb6d-514d-b6f4-e0989fae7e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-\\cos^{2} \\alpha}{\\cos \\alpha}" :db/id #edb/ref 17592186642550} {:answer/id #uuid "bfb2477f-27eb-502a-8dc2-fd163e481eb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\cos \\alpha}" :db/id #edb/ref 17592186642558} {:answer/id #uuid "d2f62748-12ef-593f-a0b3-fceecc2c648e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-2\\cdot \\cos^{2} \\alpha}{\\cos \\alpha}" :db/id #edb/ref 17592186642563} {:answer/id #uuid "ec90b6ba-e965-50ee-8ac4-25e3fe7a7319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+\\cos^{2} \\alpha}{\\cos \\alpha}" :db/id #edb/ref 17592186642566}] :answer-field/correct {:answer/id #uuid "82805622-fb6d-514d-b6f4-e0989fae7e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-\\cos^{2} \\alpha}{\\cos \\alpha}" :db/id #edb/ref 17592186642550} :answer-field/id #uuid "ef04650e-c0e9-5c60-8355-b46f7c28240b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d28063f6-408a-57b3-af7d-5f1b374a4a22" :question/problem "Simplify the trigonometric expression $\\cos \\alpha+\\frac{2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha}.$" :question/worked-solution "Put both terms over the common denominator $\\cos \\alpha$, and combine the fractions:\n\n$$\n\\begin{aligned}& \\frac{\\cos^{2} \\alpha}{\\cos \\alpha}+\\frac{2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha} \\\\ & =\\frac{\\cos^{2} \\alpha+2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha}\\end{aligned}\n$$\n\nGroup the squared terms and use $\\sin^{2} \\alpha+\\cos^{2} \\alpha=1$:\n\n$$\n\\begin{aligned}& \\frac{2\\cdot (\\sin^{2} \\alpha+\\cos^{2} \\alpha)-\\cos^{2} \\alpha}{\\cos \\alpha} \\\\ & =\\frac{2-\\cos^{2} \\alpha}{\\cos \\alpha}\\end{aligned}\n$$\n\nThe simplified expression is $\\frac{2-\\cos^{2} \\alpha}{\\cos \\alpha}$, where $\\cos \\alpha\\ne 0$."}] [{:db/id #edb/ref 17592186642580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5abcf9a1-6480-5f77-b8a6-82650dae77ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\cos \\alpha+4-\\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}" :db/id #edb/ref 17592186642579} {:answer/id #uuid "958fec6a-5e28-50e1-a80b-720d052f2c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\cos \\alpha+4+\\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}" :db/id #edb/ref 17592186642586} {:answer/id #uuid "c128d854-9173-5f15-b797-48680537040c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\cos \\alpha+4-2\\cdot \\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}" :db/id #edb/ref 17592186642590} {:answer/id #uuid "d17fbe6a-e95d-53b1-afa4-127a44c470da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\cos \\alpha+4}{\\sin \\alpha\\cdot \\cos \\alpha}" :db/id #edb/ref 17592186642592} {:answer/id #uuid "fe954924-4e4c-531a-84b0-f93885c93c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\cos \\alpha+4+2\\cdot \\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}" :db/id #edb/ref 17592186642597}] :answer-field/correct {:answer/id #uuid "c128d854-9173-5f15-b797-48680537040c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\cos \\alpha+4-2\\cdot \\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}" :db/id #edb/ref 17592186642590} :answer-field/id #uuid "7b8d3605-20c7-5f8f-bef7-de513235f2de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642582}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5dec47e8-36e1-5629-94a5-615a8f6d8164" :question/problem "Simplify the trigonometric expression $\\frac{1+2\\cdot \\cos \\alpha}{\\sin \\alpha}+4\\cdot \\tan \\alpha.$" :question/worked-solution "First, rewrite the second term using $\\tan \\alpha=\\frac{\\sin \\alpha}{\\cos \\alpha}$:\n\n$$\n\\begin{aligned}& \\frac{1+2\\cdot \\cos \\alpha}{\\sin \\alpha}+4\\cdot \\tan \\alpha \\\\ &= \\frac{1+2\\cdot \\cos \\alpha}{\\sin \\alpha}+\\frac{4\\cdot \\sin \\alpha}{\\cos \\alpha}\\end{aligned}\n$$\n\nPut both terms over a common denominator and combine the fractions:\n\n$$\n\\begin{aligned}& \\frac{(1+2\\cdot \\cos \\alpha)\\cos \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}+\\frac{4\\cdot \\sin^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha} \\\\ &= \\frac{\\cos \\alpha+2\\cdot \\cos^{2} \\alpha+4\\cdot \\sin^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}\\end{aligned}\n$$\n\nGroup the squared terms and apply the Pythagorean identity.\n\n$$\n\\begin{aligned}& \\frac{\\cos \\alpha+4\\cdot (\\cos^{2} \\alpha+\\sin^{2} \\alpha)-2\\cdot \\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha} \\\\ &= \\frac{\\cos \\alpha+4-2\\cdot \\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha}\\end{aligned}\n$$\n\nHere we used $\\sin^{2} \\alpha+\\cos^{2} \\alpha=1$. Therefore, the simplified expression is $$\n\\displaystyle \\frac{\\cos \\alpha+4-2\\cdot \\cos^{2} \\alpha}{\\sin \\alpha\\cdot \\cos \\alpha},\n$$ on the original domain $\\sin \\alpha\\ne0, \\cos \\alpha\\ne0$."}] [{:db/id #edb/ref 17592186642585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c2e56a4-78f2-5cc2-b89f-cda00616b053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\cdot \\sin \\alpha+1-2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}" :db/id #edb/ref 17592186642577} {:answer/id #uuid "7c04d846-e5b4-5ae9-a8c8-e8cdd00008ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\cdot \\sin \\alpha+1+\\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}" :db/id #edb/ref 17592186642583} {:answer/id #uuid "d557ea2d-616a-5893-bee9-624fd04afb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\cdot \\sin \\alpha+1-\\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}" :db/id #edb/ref 17592186642593} {:answer/id #uuid "dab71032-3a4a-5670-9fa0-7781307ae7a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\cdot \\sin \\alpha+1}{\\cos \\alpha\\cdot \\sin \\alpha}" :db/id #edb/ref 17592186642594} {:answer/id #uuid "fdf0e3c0-3f1c-563c-adce-b18fa9813ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\cdot \\sin \\alpha+1+2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}" :db/id #edb/ref 17592186642596}] :answer-field/correct {:answer/id #uuid "fdf0e3c0-3f1c-563c-adce-b18fa9813ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\cdot \\sin \\alpha+1+2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}" :db/id #edb/ref 17592186642596} :answer-field/id #uuid "aa488171-e5f0-5958-ab8e-f1d1eed832da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642589}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8b37927f-715c-51a4-844c-95aa242a5a06" :question/problem "Simplify the trigonometric expression $\\frac{2+3\\cdot \\sin \\alpha}{\\cos \\alpha}+\\cot \\alpha.$" :question/worked-solution "First, rewrite the second term using $\\cot \\alpha=\\frac{\\cos \\alpha}{\\sin \\alpha}$:\n\n$$\n\\begin{aligned}& \\frac{2+3\\cdot \\sin \\alpha}{\\cos \\alpha}+\\cot \\alpha \\\\ &= \\frac{2+3\\cdot \\sin \\alpha}{\\cos \\alpha}+\\frac{\\cos \\alpha}{\\sin \\alpha}\\end{aligned}\n$$\n\nPut both terms over a common denominator and combine the fractions:\n\n$$\n\\begin{aligned}& \\frac{(2+3\\cdot \\sin \\alpha)\\sin \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}+\\frac{\\cos^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha} \\\\ &= \\frac{2\\cdot \\sin \\alpha+3\\cdot \\sin^{2} \\alpha+\\cos^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}\\end{aligned}\n$$\n\nGroup the squared terms and apply the Pythagorean identity.\n\n$$\n\\begin{aligned}& \\frac{2\\cdot \\sin \\alpha+(\\sin^{2} \\alpha+\\cos^{2} \\alpha)+2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha} \\\\ &= \\frac{2\\cdot \\sin \\alpha+1+2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha}\\end{aligned}\n$$\n\nHere we used $\\cos^{2} \\alpha+\\sin^{2} \\alpha=1$. Therefore, the simplified expression is $$\n\\displaystyle \\frac{2\\cdot \\sin \\alpha+1+2\\cdot \\sin^{2} \\alpha}{\\cos \\alpha\\cdot \\sin \\alpha},\n$$ on the original domain $\\cos \\alpha\\ne0, \\sin \\alpha\\ne0$."}]}
