tion/math-academy-id "q-105915" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $15$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=15.$ Therefore, the parametric equations of the circle are \n\n$$\nx=15\\operatorname{cos}⁡\\theta ,\\,y=15\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186241150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8423035f-a5a5-5c6b-84df-93fa66043e10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239203} {:answer/id #uuid "b001d813-7987-5c68-9466-9de6ccb68bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{\\frac{1}{2}}\\operatorname{cos}⁡\\theta ,\\,y=\\sqrt{\\frac{1}{2}}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239584} {:answer/id #uuid "c0c2d72f-f92d-59fc-8d72-ef4098955ac2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239736} {:answer/id #uuid "c597485d-f992-5ec7-957e-38171d3cdea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{4}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{4}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239793} {:answer/id #uuid "d652b090-492a-59ad-9d6c-3c66c3e3286e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239928}] :answer-field/correct {:answer/id #uuid "d652b090-492a-59ad-9d6c-3c66c3e3286e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239928} :answer-field/id #uuid "f65cb3a9-d2ec-5669-ac2a-dd0da3b31a0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240764}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c548914b-7c42-51b7-ab54-c723baf0506a" :question/math-academy-id "q-106032" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $\\frac{1}{2}$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=\\frac{1}{2}.$ Therefore, the parametric equations of the circle are \n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186241151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f64cdf3-9b85-5677-8b14-81367c40a068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{5}\\operatorname{cos}⁡\\theta ,\\,y=\\sqrt{5}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186238322} {:answer/id #uuid "489273c2-83c9-54f4-ba26-82afbaa25966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=25\\operatorname{cos}⁡\\theta ,\\,y=10\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186238687} {:answer/id #uuid "92e7072d-7355-5780-bc49-4da6f62e35fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=10\\operatorname{cos}⁡\\theta ,\\,y=10\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239322} {:answer/id #uuid "bb06b780-325a-50f0-ba32-6871816b4832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239681} {:answer/id #uuid "e7fdc4a8-effe-5937-998a-9ce97ac3638a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=25\\operatorname{cos}⁡\\theta ,\\,y=25\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186240097}] :answer-field/correct {:answer/id #uuid "bb06b780-325a-50f0-ba32-6871816b4832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239681} :answer-field/id #uuid "4d519c52-8e81-59e3-b915-21e0cfbaf8fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240465}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b342eec-db3e-5a6d-8864-9b6e71cfe671" :question/math-academy-id "q-106040" :question/problem "![](images/c3/c36411be4d4fd094d93641a71721a22d1bbc040e15deeefff158915cc68ca52a.png)\n\nConsider the circle of radius $5$ centered at the origin, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(5,0)?$" :question/worked-solution "The parametric equations of a circle  of radius $r$ centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r,0).$\n\nIn our case, the radius $r=5.$ Therefore, the parametric equations of the circle are \n\n$$\nx=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186241155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121e144a-347f-54d7-96fe-8b85ac076517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6\\operatorname{cos}⁡\\theta +3,\\,y=6\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186238206} {:answer/id #uuid "13221135-936f-5a2f-b1e3-39f461d2a5d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186238214} {:answer/id #uuid "75247533-fe54-5cf2-95e5-5167f12b35c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=12\\operatorname{cos}⁡\\theta -4,\\,y=12\\operatorname{sin}⁡\\theta +6" :db/id #edb/ref 17592186239068} {:answer/id #uuid "a67f0d22-e3bc-555f-860f-edbf921f04dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{sin}⁡\\theta +3,\\,y=3\\operatorname{cos}⁡\\theta -2" :db/id #edb/ref 17592186239497} {:answer/id #uuid "f06e7237-6a2c-50dd-b928-870a20525eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6\\operatorname{sin}⁡\\theta +3,\\,y=6\\operatorname{cos}⁡\\theta -2" :db/id #edb/ref 17592186240176}] :answer-field/correct {:answer/id #uuid "13221135-936f-5a2f-b1e3-39f461d2a5d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186238214} :answer-field/id #uuid "06eeebf9-6946-56dd-860f-d87daafd3fb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240340}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42aafb6b-2267-5aba-ac4b-bd6805fca954" :question/math-academy-id "q-106291" :question/problem "![](images/3c/3c07f3e732084327f02849cee9355a46ce7a1c5f905d509b1e1404915612c85c.png)\n\nConsider the circle of radius $3$ centered at $(3,-2)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(6,-2)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $3$ centered at the point $(3,-2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=3\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186241156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bc5b608-6398-5218-a6e0-7c76dea76f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,2\\pi )" :db/id #edb/ref 17592186238286} {:answer/id #uuid "79cba0da-2992-5a25-9a57-b20c08358750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186239105} {:answer/id #uuid "a4e3577d-6087-5d74-98fc-5964a9c084da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186239487} {:answer/id #uuid "aed9a96e-4cc8-5679-bd73-cdaf49819cd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186239577} {:answer/id #uuid "dee84901-c67c-590c-b6e7-d273b9a0d463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186240002}] :answer-field/correct {:answer/id #uuid "a4e3577d-6087-5d74-98fc-5964a9c084da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186239487} :answer-field/id #uuid "291e0baa-8ae9-582e-a70a-af1188f4b02c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f9274e1-4e93-5f35-823f-c1bb054b14a8" :question/math-academy-id "q-106294" :question/problem "![](images/eb/eb1ef0ba48e294464496a901e6c593cb5e2bc215c688862e2b7eda3621f72469.png)\n\nThe semi-circle above is defined by the parametric equations \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=3.$ So, the parametric equations of the *full* circle are \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a semi-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](images/6d/6d73d4841b5e8ca1c3996d1996732b71245f2673e0e76a50a008600b95cfaf09.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\pi ]$, we get the required semi-circle.\n\nTherefore, the parametric equations of the semi-circle are \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\pi ].\n$$"}] [{:db/id #edb/ref 17592186241157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f59f06d-b9a6-5438-a966-d3b5565735a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+{(y-2)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239446} {:answer/id #uuid "ad4e0cba-3407-5463-bc8e-cecffd5ecc85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+1)}^{2}+{(y+2)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239559} {:answer/id #uuid "b0bebb9d-7faf-5639-8545-a824ed4d0302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+2)}^{2}+{(y+1)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239592} {:answer/id #uuid "c2a220fb-a7b7-5add-a148-72170d71b738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+1)}^{2}+{(y+2)}^{2}=\\frac{3}{2}" :db/id #edb/ref 17592186239764} {:answer/id #uuid "ff94d839-5539-5e72-b58a-5e6b2133fac2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+{(y-2)}^{2}=\\frac{3}{2}" :db/id #edb/ref 17592186240322}] :answer-field/correct {:answer/id #uuid "ad4e0cba-3407-5463-bc8e-cecffd5ecc85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+1)}^{2}+{(y+2)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239559} :answer-field/id #uuid "43343ab1-d9ca-5b6d-a323-22a64344f342" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240446}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f2bc3b27-8c03-5cde-b344-2e0c55032f69" :question/math-academy-id "q-106299" :question/problem "Determine the Cartesian equation of the circle\n\n$$\nx=\\frac{3}{2}\\operatorname{cos}⁡\\theta -1,\\,y=\\frac{3}{2}\\operatorname{sin}⁡\\theta -2,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x+1 & =\\frac{3}{2}\\operatorname{cos}⁡\\theta  \\\\ \\frac{2}{3}(x+1) & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{4}{9}{(x+1)}^{2} & ={cos}^{2}⁡\\theta \\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y+2 & =\\frac{3}{2}\\operatorname{sin}⁡\\theta  \\\\ \\frac{2}{3}(y+2) & ={sin}^{2}⁡\\theta  \\\\ \\frac{4}{9}{(y+2)}^{2} & ={sin}^{2}⁡\\theta \\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{4}{9}{(x+1)}^{2}+\\frac{4}{9}{(y+2)}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ 4{(x+1)}^{2}+4{(y+2)}^{2} & =9 \\\\ {(x+1)}^{2}+{(y+2)}^{2} & =\\frac{9}{4}\\end{aligned}\n$$\n\nTherefore the Cartesian equation of the circle is ${(x+1)}^{2}+{(y+2)}^{2}=\\frac{9}{4}.$"}] [{:db/id #edb/ref 17592186241158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1179ddc8-9d2b-5f37-858d-a4af5d525038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=\\sqrt{5}" :db/id #edb/ref 17592186238199} {:answer/id #uuid "5c77ee41-eb12-5d5d-aee0-f73a63e3d59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=25" :db/id #edb/ref 17592186238864} {:answer/id #uuid "868b4972-5724-52d5-879b-b7ce9a27b554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}+{(y-\\frac{1}{2})}^{2}=5" :db/id #edb/ref 17592186239226} {:answer/id #uuid "e91810a1-61c1-5eba-91a0-ed9b1bf5ef6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}+{(y-\\frac{1}{2})}^{2}=25" :db/id #edb/ref 17592186240107} {:answer/id #uuid "fd3e3abf-1c31-5d04-ae31-72a0f1e5bc40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=5" :db/id #edb/ref 17592186240294}] :answer-field/correct {:answer/id #uuid "5c77ee41-eb12-5d5d-aee0-f73a63e3d59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=25" :db/id #edb/ref 17592186238864} :answer-field/id #uuid "2f97f707-7649-51de-a352-c860d9645f7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240416}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "85bc2cb1-6e4a-5b13-b0c1-a6335dc66a91" :question/math-academy-id "q-106300" :question/problem "Determine the Cartesian equation of the circle\n\n$$\nx=5\\operatorname{cos}⁡\\theta +\\frac{1}{2},\\,y=5\\operatorname{sin}⁡\\theta -\\frac{1}{2},\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}(x-\\frac{1}{2}) & =5\\operatorname{cos}⁡\\theta  \\\\ \\frac{1}{5}(x-\\frac{1}{2}) & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{1}{25}{(x-\\frac{1}{2})}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}(y+\\frac{1}{2}) & =5\\operatorname{sin}⁡\\theta  \\\\ \\frac{1}{5}(y+\\frac{1}{2}) & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{1}{25}{(y+\\frac{1}{2})}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{25}{(x-\\frac{1}{2})}^{2}+\\frac{1}{25}{(y+\\frac{1}{2})}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{1}{25}{(x-\\frac{1}{2})}^{2}+\\frac{1}{25}{(y+\\frac{1}{2})}^{2} & =1 \\\\ {(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2} & =25.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $$\n\\displaystyle {(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=25.\n$$"}] [{:db/id #edb/ref 17592186243921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21fb214b-4c93-5907-abd9-ebaa82181542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta -5,\\,y=3\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186241474} {:answer/id #uuid "27099955-5977-5d26-94fa-a6549688c47a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +5" :db/id #edb/ref 17592186241515} {:answer/id #uuid "43c3571b-9714-5b8b-8cdb-7bb6d59f0be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=9\\operatorname{cos}⁡\\theta +5,\\,y=9\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186241791} {:answer/id #uuid "6c81c7fc-87b1-5cf5-b0ea-e6ba443a04ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -5" :db/id #edb/ref 17592186242153} {:answer/id #uuid "f7ca378b-b792-57f4-92da-75001bcda80b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +5,\\,y=3\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186243369}] :answer-field/correct {:answer/id #uuid "f7ca378b-b792-57f4-92da-75001bcda80b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +5,\\,y=3\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186243369} :answer-field/id #uuid "c54662ad-4c83-5d78-99bf-b77c960bee4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243787}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4bff5c9a-6bfa-5bc8-99ff-8f60b509a054" :question/math-academy-id "q-106693" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $3$ centered at the point $(5,-3)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, we have a circle of radius $3$ centered at the point $(5,-3).$ Therefore, the parametric equations of the circle are\n\n$$\nx=3\\operatorname{cos}⁡\\theta +5,\\,y=3\\operatorname{sin}⁡\\theta -3,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186243923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa416b1-d5ce-5503-b94a-3e38eba55fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\frac{5}{2}" :db/id #edb/ref 17592186241276} {:answer/id #uuid "56eae8d6-2606-519e-88c0-2a4f95d5a1ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\frac{25}{4}" :db/id #edb/ref 17592186241966} {:answer/id #uuid "6b02e3f2-9739-5323-a096-d7c64f08da33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=\\frac{25}{4}" :db/id #edb/ref 17592186242140} {:answer/id #uuid "94adb393-4580-5bd9-8341-d1156639d308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=\\frac{5}{2}" :db/id #edb/ref 17592186242486} {:answer/id #uuid "c970979d-e0eb-5a39-af93-dcdfdeddae68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{\\frac{5}{2}}" :db/id #edb/ref 17592186242953}] :answer-field/correct {:answer/id #uuid "56eae8d6-2606-519e-88c0-2a4f95d5a1ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\frac{25}{4}" :db/id #edb/ref 17592186241966} :answer-field/id #uuid "c999e49c-1d23-5427-99dc-13feea41bd21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243793}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f054c8b-83ad-51a3-ac06-f9b576f40779" :question/math-academy-id "q-106696" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=\\frac{5}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{5}{2}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =\\frac{5}{2}\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & ={(\\frac{5}{2}\\operatorname{cos}⁡\\theta )}^{2} \\\\  & =\\frac{25}{4}{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =\\frac{5}{2}\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & ={(\\frac{5}{2}\\operatorname{sin}⁡\\theta )}^{2} \\\\  & =\\frac{25}{4}{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =\\frac{25}{4}{cos}^{2}⁡\\theta +\\frac{25}{4}{sin}^{2}⁡\\theta  \\\\  & =\\frac{25}{4}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =\\frac{25}{4}(1) \\\\  & =\\frac{25}{4}.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=\\frac{25}{4}.$"}] [{:db/id #edb/ref 17592186244040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27cec937-8f89-509c-89d8-cac2418dad31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12\\sqrt{3-6x}}" :db/id #edb/ref 17592186241525} {:answer/id #uuid "48530683-52e3-5b2d-b80c-52c96ea80021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186241833} {:answer/id #uuid "6ea096e1-e11d-5b2f-9a38-2f0713ebe775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186242165} {:answer/id #uuid "afef1e77-e7bb-55d4-85fd-246b46e4f2ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186242713} {:answer/id #uuid "eb52bd30-42b5-564a-b65a-5b27e7b61017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{3-6x}}" :db/id #edb/ref 17592186243264}] :answer-field/correct {:answer/id #uuid "afef1e77-e7bb-55d4-85fd-246b46e4f2ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186242713} :answer-field/id #uuid "beb44a20-d166-5fe6-a7bc-aa72ceec3cb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243776}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ce97e32-c8a9-5155-bb70-6cb7385360f5" :question/math-academy-id "q-107291" :question/problem "Given that $y=\\sqrt{3-6x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3-6x.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-6) \\\\  & =-\\frac{3}{\\sqrt{3-6x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b70de32-5fa9-5056-93ca-35a9463faadb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(3x+4{)}^{4}" :db/id #edb/ref 17592186241712} {:answer/id #uuid "3ec14f92-c87e-5787-a89f-47a342d4236d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(3x+4{)}^{5}" :db/id #edb/ref 17592186241739} {:answer/id #uuid "5d608479-e85c-5eaa-9d74-3ea2e83804de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20(3x+4{)}^{4}" :db/id #edb/ref 17592186242022} {:answer/id #uuid "8a1ebdf8-e7b7-53d7-92ca-ae1bc7bccfdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(3x+4{)}^{4}" :db/id #edb/ref 17592186242395} {:answer/id #uuid "9a91c92b-ab22-552d-a427-31624937e728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(3x+4{)}^{4}" :db/id #edb/ref 17592186242530}] :answer-field/correct {:answer/id #uuid "9a91c92b-ab22-552d-a427-31624937e728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(3x+4{)}^{4}" :db/id #edb/ref 17592186242530} :answer-field/id #uuid "2cdfb9ab-5d97-59c1-90d9-2ac765b9ee1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ffe447f-f2a2-5d58-986c-0fb23858e18e" :question/math-academy-id "q-107293" :question/problem "Given that $f(x)={(3x+4)}^{5},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=3x+4$ and $f(g(x))=g(x{)}^{5}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{5}{)}^{′}=5{g}^{4}, \\\\ {g}^{′}(x) & =(3x+4{)}^{′}=3.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =5{g}^{4}\\cdot 3 \\\\  & =15(3x+4{)}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b523831-f11c-5631-b1d0-55d429e9b570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186241281} {:answer/id #uuid "321ef9b3-dc8b-5b99-b689-dfe8d1c4cf58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186241620} {:answer/id #uuid "501d0fb0-7ccb-548e-bb3a-b18b59d46b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241894} {:answer/id #uuid "8cf3df5e-c66f-522b-838e-722473ef4ed3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186242424} {:answer/id #uuid "99c71189-09eb-555b-8519-9b447439afc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186242524}] :answer-field/correct {:answer/id #uuid "501d0fb0-7ccb-548e-bb3a-b18b59d46b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241894} :answer-field/id #uuid "19320ca1-b053-535e-b992-542e4931ff17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243482}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8b46779-d19f-5cca-987d-5f500a9de334" :question/math-academy-id "q-107360" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{1-4x}$ at the point where $x=-2.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=1-4x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-4) \\\\  & =-\\frac{2}{\\sqrt{1-4x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-2} & ={\\left(-\\frac{2}{\\sqrt{1-4x}}\\right)|}_{x=-2} \\\\  & =-\\frac{2}{\\sqrt{1-4(-2)}} \\\\  & =-\\frac{2}{3}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "089d503b-4f24-5763-9960-5ba89a429460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186241256} {:answer/id #uuid "1e118c0a-4e95-58e5-a976-91027b338e8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186241438} {:answer/id #uuid "7326fac1-3a0a-542f-ada6-d08f1f8e9903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186242201} {:answer/id #uuid "8d44a50b-e600-5db0-a6a5-f5e4f444fa6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186242426} {:answer/id #uuid "b626af1e-b5fa-55ea-8216-0d91300e2897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186242774}] :answer-field/correct {:answer/id #uuid "7326fac1-3a0a-542f-ada6-d08f1f8e9903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186242201} :answer-field/id #uuid "451243fc-f02f-57e6-b84d-3ae575f2644f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63888dba-48b5-5525-9ea0-6080e9970645" :question/math-academy-id "q-1080" :question/problem "Calculate $\\text{det}(X)$, if\n$$\n\\displaystyle X=\\begin{bmatrix}10 & -3 \\\\ 1 & 4\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(X) & =\\begin{vmatrix}10 & -3 \\\\ 1 & 4\\end{vmatrix} \\\\  & =10\\cdot 4-(-3)\\cdot 1 \\\\  & =40-(-3) \\\\  & =43\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098d3c16-b771-5cb2-8ca3-8e05e6e12a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186241263} {:answer/id #uuid "409c02b9-d9b4-55b4-bf81-e98091b0492b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186241757} {:answer/id #uuid "53b66e4c-123c-