-field/choices [{:answer/id #uuid "2bbacda8-c1e8-56e4-bbff-c57fe1ebd31b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186535162} {:answer/id #uuid "31cccad3-9563-51fa-912c-9669a387c394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186535164} {:answer/id #uuid "734de5c7-db2d-5efd-94b1-06d6249d844d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186535189} {:answer/id #uuid "b5e5db1c-29c6-5c7b-bef0-e9a5cc83b3ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186535206} {:answer/id #uuid "d8c7bbf9-5c98-5950-bb11-9af71dbc186b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186535216}] :answer-field/correct {:answer/id #uuid "734de5c7-db2d-5efd-94b1-06d6249d844d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186535189} :answer-field/id #uuid "c82e418b-65ca-5340-9b52-43c99c54f641" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535212}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a5329ad4-9065-515a-9ca0-3ada4a2d76e7" :question/problem "Find $b\\cdot (2c\\times 4a)$, if $3a\\cdot ((-5)b\\times (-3)c)=135.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot ((-5)b\\times (-3)c) & =135 \\\\ 3\\cdot (-5)\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =135 \\\\ a\\cdot (b\\times c) & =3.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =-3.\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =3.\\end{aligned}\n$$\n\nFactoring out the constants in the requested product, we get\n\n$$\n\\begin{aligned}b\\cdot (2c\\times 4a) & =2\\cdot 4[b\\cdot (c\\times a)] \\\\ & =2\\cdot 4\\cdot 3 \\\\ & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118994f9-47f7-52b6-8a6a-1e88a42e216c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186535157} {:answer/id #uuid "1ee28813-8b4f-5d36-b97f-0ce0abfed529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186535161} {:answer/id #uuid "7e753899-0951-5c2a-8b00-dbdcddee98e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186535194} {:answer/id #uuid "8bd5e7cc-869a-5e31-a302-b6c0e08495e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186535196} {:answer/id #uuid "d457fd0f-56e7-5b32-9979-3fc239f21106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186535215}] :answer-field/correct {:answer/id #uuid "8bd5e7cc-869a-5e31-a302-b6c0e08495e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186535196} :answer-field/id #uuid "4174397f-4745-562f-995e-4edeaf5774a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535173}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a6404a84-02a4-5714-818c-4cf7dd509add" :question/problem "Find $c\\cdot (2a\\times (-4)b)$, if $4a\\cdot ((-4)b\\times (-3)c)=-240.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}4a\\cdot ((-4)b\\times (-3)c) & =-240 \\\\ 4\\cdot (-4)\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =-240 \\\\ a\\cdot (b\\times c) & =-5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =5.\\end{aligned}\n$$\n\nand again we swap $b$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =-5.\\end{aligned}\n$$\n\nFactoring out the constants in the requested product, we get\n\n$$\n\\begin{aligned}c\\cdot (2a\\times (-4)b) & =2\\cdot (-4)[c\\cdot (a\\times b)] \\\\ & =2\\cdot (-4)\\cdot (-5) \\\\ & =40.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080aabc3-c827-576c-9cd0-ad92ebca357a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6a/6a02899ff0058a5724bd786531e5656722b48b586d5bbc9dc7cccd88cead0930.png" :db/id #edb/ref 17592186535225} {:answer/id #uuid "53b15d34-777b-5ec8-a9ac-2a6a2621c159" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ae/ae3f9909fc55f92e6373c249a7b50bb90a92ca0671b39948859130e682b2c75d.png" :db/id #edb/ref 17592186535246} {:answer/id #uuid "70c1c770-e86f-5b6f-999e-1372e8a64946" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/11/1105bc09a45d59a02b2b0b5399048acef8f2cb18d8862b898023e57c0d0701f7.png" :db/id #edb/ref 17592186535258} {:answer/id #uuid "72fdce1f-cad8-568c-9fdc-f02eb0c130af" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e834f808f02418480565e257d469bf2ea3661777366c3eabb4180a9e52519950.png" :db/id #edb/ref 17592186535259} {:answer/id #uuid "97c90275-6fb5-5184-a980-22696b1e8bd0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/90/90d723ca644f77d85aee8ab24cbda685c094ca274ec1e2b427b0306aa85b5170.png" :db/id #edb/ref 17592186535271}] :answer-field/correct {:answer/id #uuid "72fdce1