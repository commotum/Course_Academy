#{[{:db/id #edb/ref 17592186299598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811}] :answer-field/correct {:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811} :answer-field/id #uuid "d3a33b9b-67e3-53e5-bc18-a48957e9fa7a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb8c1aa-faf5-5b19-b22a-04f7e16807fe" :question/math-academy-id "q-317372" :question/problem "Calculate $det(D)$ given that\n$$\n\\displaystyle D=\\begin{bmatrix}3x & 2y \\\\ -5 & x\\end{bmatrix}.\n$$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}3x & 2y \\\\ -5 & x\\end{vmatrix} \\\\  & =3x\\cdot x-2y\\cdot (-5) \\\\  & =3{x}^{2}+10y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787}] :answer-field/correct {:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787} :answer-field/id #uuid "5f79e083-14ad-5456-a436-b4ade461c1f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298964}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9aa98f1a-30c2-558c-875f-c99582477892" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{vmatrix} & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479}] :answer-field/correct {:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479} :answer-field/id #uuid "154b6de9-0d77-5e77-8de1-45bf6ab48913" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298716}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e3ffcd6-7f26-5f4f-8230-33ae44d7f744" :question/math-academy-id "q-317377" :question/problem "If\n$$\n\\displaystyle D=\\begin{bmatrix}2 & m \\\\ 3 & 5\\end{bmatrix}\n$$\nand\n$\\text{det}(D)=-11,$ determine the value of $m.$\n\n$m=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}2 & m \\\\ 3 & 5\\end{vmatrix} \\\\  & =2\\cdot 5-m\\cdot 3 \\\\  & =10-3m.\\end{aligned}\n$$\n\nSince $det(D)=-11,$ we get\n\n$$\n\\begin{aligned}det(D) & =-11 \\\\ 10-3m & =-11 \\\\ -3m & =-21 \\\\ m & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524}] :answer-field/correct {:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524} :answer-field/id #uuid "ebf4f818-ea4f-5a3d-9526-388b53c60cf1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0f61095-530a-54e2-bb79-353fa0efed39" :question/math-academy-id "q-317382" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}1+r & 2-r \\\\ -5 & 4\\end{bmatrix}\n$$\nand $det(U)=-6$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =\\begin{vmatrix}1+r & 2-r \\\\ -5 & 4\\end{vmatrix} \\\\  & =(1+r)\\cdot 4-(2-r)\\cdot (-5) \\\\  & =4+4r+10-5r \\\\  & =14-r.\\end{aligned}\n$$\n\nSince $det(U)=-6,$ we get\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ 14-r & =-6 \\\\ -r & =-20 \\\\ r & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164}] :answer-field/correct {:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164} :answer-field/id #uuid "0eda0fee-f95d-5630-8031-5abef3969057" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e22859c-f056-5995-96a3-08af912796b8" :question/math-academy-id "q-317385" :question/problem "If\n$$\n\\displaystyle S=\\begin{bmatrix}3+s & 2s \\\\ -4 & 3-s\\end{bmatrix}\n$$\nand $det(S)=25,$ what is the value of $s?$\n\n$s=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}3+s & 2s \\\\ -4 & 3-s\\end{vmatrix} \\\\  & =(3+s)(3-s)-2s(-4) \\\\  & =9-{s}^{2}+8s \\\\  & =-{s}^{2}+8s+9.\\end{aligned}\n$$\n\nSince $det(S)=25,$ we get\n\n$$\n\\begin{aligned}det(S) & =25 \\\\ -{s}^{2}+8s+9 & =25 \\\\ -{s}^{2}+8s-16 & =0 \\\\ {s}^{2}-8s+16 & =0 \\\\ (s-4)^{2} & =0 \\\\ s & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a1c86cb-411d-534e-810a-79bce25d9b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+4x" :db/id #edb/ref 17592186297663}] :answer-field/correct {:answer/id #uuid "1a1c86cb-411d-534e-810a-79bce25d9b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+4x" :db/id #edb/ref 17592186297663} :answer-field/id #uuid "2c103235-e1c7-50cf-97f5-b61725f0ce9e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298789}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c26af88-186d-5e0b-b417-96d3412f3929" :question/math-academy-id "q-320871" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=t-2,\\,\\,\\,y={t}^{2}-4,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=t-2\\,⇒\\,t=x+2\\end{aligned}\n$$\n\nNow, substituting $t=x+2$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =(x+2)^{2}-4 \\\\ y & ={x}^{2}+4x\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is \n$y={x}^{2}+4x.$"}] [{:db/id #edb/ref 17592186299919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd8f4c87-04b9-5012-91a0-2fa1e73539ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-3x}{7x-2}" :db/id #edb/ref 17592186298449}] :answer-field/correct {:answer/id #uuid "cd8f4c87-04b9-5012-91a0-2fa1e73539ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-3x}{7x-2}" :db/id #edb/ref 17592186298449} :answer-field/id #uuid "d10035ab-a533-5291-9723-0bc6c8afa230" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299345} {:answer-field/choices [{:answer/id #uuid "5584afb0-f812-5610-86a2-9366973652b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186297913}] :answer-field/correct {:answer/id #uuid "5584afb0-f812-5610-86a2-9366973652b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186297913} :answer-field/id #uuid "d2071233-48c1-53b8-9e87-ce0c7ce6bb94" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299350}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "80110151-a320-56a4-96e5-9888e94599a9" :question/math-academy-id "q-320926" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=\\frac{1}{t+3},\\,\\,\\,y=\\frac{t}{-2t+1},\\,t\\ne -3,\\,\\,\\,t\\ne \\frac{1}{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}$,\\,\\,\\,x\\ne 0.$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\nx=\\frac{1}{t+3}\\,⇒\\,t=-3+\\frac{1}{x}\n$$\n\nNow, substituting $t=-3+\\frac{1}{x}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{(-3+\\frac{1}{x})}{(-2\\,(-3+\\frac{1}{x})+1)} \\\\  & =\\frac{(-3+\\frac{1}{x})}{(6-\\frac{2}{x}+1)} \\\\  & =\\frac{(-3+\\frac{1}{x})}{(7-\\frac{2}{x})} \\\\  & =\\frac{-3x+1}{\\cancel{x}}\\cdot \\frac{\\cancel{x}}{7x-2} \\\\  & =\\frac{1-3x}{7x-2}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{1-3x}{7x-2}.$\n\nFinally, since $t\\ne \\frac{1}{2}$ and $x=\\frac{1}{t+3}$ has range $x\\ne 0,$ we must have \n$x\\ne \\frac{2}{7},\\text{ }0.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{1-3x}{7x-2},\\,x\\ne \\frac{2}{7},\\,\\,\\,x\\ne 0.\n$$"}] [{:db/id #edb/ref 17592186299922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "816fa6c2-f991-5039-a41c-4fa48bc8c757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}{x}^{2}+(y+2)^{2}" :db/id #edb/ref 17592186298109}] :answer-field/correct {:answer/id #uuid "816fa6c2-f991-5039-a41c-4fa48bc8c757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}{x}^{2}+(y+2)^{2}" :db/id #edb/ref 17592186298109} :answer-field/id #uuid "059e198d-f61d-5e53-b612-06a829c8b2fd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4923000b-5c5c-55b7-9b95-5a7082500328" :question/math-academy-id "q-320946" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=3\\operatorname{sin}⁡t,\\,\\,\\,y=\\operatorname{cos}⁡t-2,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n{{field-1}}$=1.$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=3\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{3} \\\\ y=\\operatorname{cos}⁡t-2\\, & ⇒\\,\\operatorname{cos}⁡t=y+2\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}{\\left(\\frac{x}{3}\\right)}^{2}+(y+2)^{2} & =1 \\\\ \\frac{1}{9}{x}^{2}+(y+2)^{2} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52d81c8c-e7c3-5d18-9722-ffa9b4fbde0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(3x+1)(x-1)(2-3x)^{2}" :db/id #edb/ref 17592186297902}] :answer-field/correct {:answer/id #uuid "52d81c8c-e7c3-5d18-9722-ffa9b4fbde0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(3x+1)(x-1)(2-3x)^{2}" :db/id #edb/ref 17592186297902} :answer-field/id #uuid "a3f57b3d-a654-5285-ac31-3e8cdc988821" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299186}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49a7b1ee-edb5-5cfe-b0e7-c77c9612e0b8" :question/math-academy-id "q-321074" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{t+1}{3},\\,\\,\\,y=({t}^{2}-4)(1-t)^{2},\\,t\\in (-\\infty ,\\infty ).\n$$\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{t+1}{3}\\,⇒\\,t=3x-1\\end{aligned}\n$$\n\nNow, substituting $t=3x-1$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((3x-1)^{2}-4){(1-(3x-1))}^{2} \\\\  & =(9{x}^{2}-6x+1-4)(2-3x)^{2} \\\\  & =(9{x}^{2}-6x-3)(2-3x)^{2} \\\\  & =3(3{x}^{2}-2x-1)(2-3x)^{2} \\\\  & =3(3x+1)(x-1)(2-3x)^{2}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=3(3x+1)(x-1)(2-3x)^{2}.$"}] [{:db/id #edb/ref 17592186299924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6c8835-3261-554a-afbb-957028b9b565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32x(2x-1)^{3}" :db/id #edb/ref 17592186297684}] :answer-field/correct {:answer/id #uuid "1e6c8835-3261-554a-afbb-957028b9b565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32x(2x-1)^{3}" :db/id #edb/ref 17592186297684} :answer-field/id #uuid "f4679020-39ab-52d5-99d1-edaaf51fac68" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299460}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4084c354-7618-56fc-b268-f7034497a330" :question/math-academy-id "q-321075" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{1-t}{4},\\,\\,\\,y=({t}^{2}-1)(1+t)^{2},\\,t\\in (-\\infty ,\\infty ).\n$$\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{1-t}{4}\\,⇒\\,t=1-4x\\end{aligned}\n$$\n\nNow, substituting $t=1-4x$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((1-4x)^{2}-1)((1+(1-4x))^{2}) \\\\  & =(1-8x+16{x}^{2}-1)((2-4x)^{2}) \\\\  & =(-8x+16{x}^{2})(4)(1-2x)^{2} \\\\  & =8x(2x-1)(2-4x)^{2} \\\\  & =8x(2x-1)\\cdot 4(1-2x)^{2} \\\\  & =32x(2x-1)^{3}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=32x(2x-1)^{3}.$"}] [{:db/id #edb/ref 17592186299925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5593662-8d5b-547d-8bc2-6520dd120c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}-1)(5-{x}^{2})" :db/id #edb/ref 17592186298596}] :answer-field/correct {:answer/id #uuid "f5593662-8d5b-547d-8bc2-6520dd120c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}-1)(5-{x}^{2})" :db/id #edb/ref 17592186298596} :answer-field/id #uuid "baa6ee25-0549-5c84-9148-4b6a5918be3e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78ac25c2-7c10-5369-8ba8-e6189caf0a34" :question/math-academy-id "q-321084" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=\\sqrt{\\,t+1\\,},\\,\\,\\,y=t(4-t),\\,t\\ge 0.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ge 1.$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\sqrt{\\,t+1\\,}\\,⇒\\,t={x}^{2}-1\\end{aligned}\n$$\n\nNow, substituting $t={x}^{2}-1$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =({x}^{2}-1)(4-({x}^{2}-1)) \\\\  & =({x}^{2}-1)(5-{x}^{2})\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=({x}^{2}-1)(5-{x}^{2}).$\n\nFinally, since $t\\ge 0$ and $t={x}^{2}-1,$ we must have ${x}^{2}-1\\ge 0,$ i.e., $x\\ge 1.$\n\nTherefore, the complete Cartesian equation is $y=({x}^{2}-1)(5-{x}^{2}),\\,x\\ge 1.$"}] [{:db/id #edb/ref 17592186299926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d744dcd4-0a3e-511e-b60c-7b2673712e59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+27" :db/id #edb/ref 17592186298478}] :answer-field/correct {:answer/id #uuid "d744dcd4-0a3e-511e-b60c-7b2673712e59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+27" :db/id #edb/ref 17592186298478} :answer-field/id #uuid "8387e755-e4a8-5276-9d88-37aa96b73bfd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299081}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7fac9ad7-3b23-560c-8033-d32b15e29ec7" :question/math-academy-id "q-321090" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=\\sqrt{{t}^{2}-9},\\,\\,\\,y=3{t}^{2},\\,t\\ge 3.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ge 0.$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for ${t}^{2}:$\n\n$$\nx=\\sqrt{{t}^{2}-9}\\,⇒\\,{t}^{2}={x}^{2}+9\n$$\n\nNow, substituting ${t}^{2}={x}^{2}+9$ into our expression for $y,$ we get\n\n$$\ny=3({x}^{2}+9)=3{x}^{2}+27.\n$$\n\nSo, the Cartesian equation of the given curve is $y=3{x}^{2}+27.$\n\nFinally, since $t\\ge 3$ and $x=\\sqrt{{t}^{2}-9},$ we must have $x\\ge 0.$\n\nTherefore, the complete Cartesian equation is $y=3{x}^{2}+27,\\,x\\ge 0.$"}] [{:db/id #edb/ref 17592186299929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d45792f3-0a28-56c8-a67d-3d50eaf93eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298464}] :answer-field/correct {:answer/id #uuid "d45792f3-0a28-56c8-a67d-3d50eaf93eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298464} :answer-field/id #uuid "1b761f73-9699-5009-890b-c604bb787aa6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298735} {:answer-field/choices [{:answer/id #uuid "fba2eb2c-542e-5741-9da4-b68fe7825059" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1+x)^{2}}{4{x}^{2}}" :db/id #edb/ref 17592186298625}] :answer-field/correct {:answer/id #uuid "fba2eb2c-542e-5741-9da4-b68fe7825059" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1+x)^{2}}{4{x}^{2}}" :db/id #edb/ref 17592186298625} :answer-field/id #uuid "eb33573b-f770-5250-8223-d49dca5de7e1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce51648f-7c56-5fd1-a391-8983dd27aa88" :question/math-academy-id "q-321141" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=\\frac{1}{2t+1},\\,\\,\\,y=(t+1)^{2},\\,t\\ne -\\frac{1}{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\nx=\\frac{1}{2t+1}\\,⇒\\,2t+1=\\frac{1}{x}\\,⇒\\,t=\\frac{1}{2x}-\\frac{1}{2}.\n$$\n\nNow, substituting $t=\\frac{1}{2x}-\\frac{1}{2}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & ={(\\frac{1}{2x}-\\frac{1}{2}+1)}^{2} \\\\  & ={(\\frac{1}{2x}+\\frac{1}{2})}^{2} \\\\  & ={\\left(\\frac{1+x}{2x}\\right)}^{2} \\\\  & =\\frac{(1+x)^{2}}{4{x}^{2}}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{(1+x)^{2}}{4{x}^{2}}.$\n\nFinally, since $t\\ne -\\frac{1}{2}$ and $x=\\frac{1}{2t+1}$ we must have $x\\ne 0.$\n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{(1+x)^{2}}{4{x}^{2}},\\,x\\ne 0.\n$$"}] [{:db/id #edb/ref 17592186302048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c03cb41-8dae-5697-aca1-1503571603b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{2}}{25}+6" :db/id #edb/ref 17592186299993}] :answer-field/correct {:answer/id #uuid "0c03cb41-8dae-5697-aca1-1503571603b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{2}}{25}+6" :db/id #edb/ref 17592186299993} :answer-field/id #uuid "dc50beaf-4f1b-5232-ade9-c9d9974970f5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301930}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "746bed7b-e090-56a7-9ad1-4c0bfac39908" :question/math-academy-id "q-321314" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=5\\operatorname{cos}⁡t,\\,\\,\\,y=-6\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=5\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{5} \\\\ y=-6\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=-\\frac{y}{6}.\\end{aligned}\n$$\n\nNow, using the double-angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=\\frac{x}{5}$ and $\\operatorname{cos}⁡2t=-\\frac{y}{6}$ into this formula, we get\n\n$$\n\\begin{aligned}-\\frac{y}{6} & =2{\\left(\\frac{x}{5}\\right)}^{2}-1 \\\\ -\\frac{y}{6} & =\\frac{2{x}^{2}}{25}-1 \\\\ y & =-6(\\frac{2{x}^{2}}{25}-1) \\\\ y & =-\\frac{12{x}^{2}}{25}+6.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=-\\frac{12{x}^{2}}{25}+6.$"}] [{:db/id #edb/ref 17592186302049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16bbeffa-db1c-5b1d-ad63-3a7384e31729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{2}}{18}-5" :db/id #edb/ref 17592186300050}] :answer-field/correct {:answer/id #uuid "16bbeffa-db1c-5b1d-ad63-3a7384e31729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{2}}{18}-5" :db/id #edb/ref 17592186300050} :answer-field/id #uuid "34ad1466-19e3-5aaa-b651-784e21d815fe" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301394}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3eac432e-a9f4-5e40-ae91-1f28e72debdf" :question/math-academy-id "q-321318" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=6\\operatorname{cos}⁡t,\\,\\,\\,y=5\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=6\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{6} \\\\ y=5\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{5}.\\end{aligned}\n$$\n\nNow, using the double-angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=\\frac{x}{6}$ and $\\operatorname{cos}⁡2t=\\frac{y}{5}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{5} & =2{\\left(\\frac{x}{6}\\right)}^{2}-1 \\\\ \\frac{y}{5} & =2\\left(\\frac{{x}^{2}}{36}\\right)-1 \\\\ \\frac{y}{5} & =\\frac{2{x}^{2}}{36}-1 \\\\ y & =5(\\frac{{x}^{2}}{18}-1) \\\\ y & =\\frac{5{x}^{2}}{18}-5\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{5{x}^{2}}{18}-5.$"}] [{:db/id #edb/ref 17592186302062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3625268-1369-5f41-a534-a0649eceb53b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300856}] :answer-field/correct {:answer/id #uuid "b3625268-1369-5f41-a534-a0649eceb53b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300856} :answer-field/id #uuid "20d409ef-248e-5eab-a01b-2a42296f4315" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301330} {:answer-field/choices [{:answer/id #uuid "e2d9df89-b63c-55a8-bd14-62b985a73272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x-2}" :db/id #edb/ref 17592186301091}] :answer-field/correct {:answer/id #uuid "e2d9df89-b63c-55a8-bd14-62b985a73272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x-2}" :db/id #edb/ref 17592186301091} :answer-field/id #uuid "e4a0ae5c-3a22-5796-9f64-eda5a7edb186" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b94a700-bd85-58aa-bc0c-7585b2834748" :question/math-academy-id "q-321410" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=-3t+2,\\,\\,\\,y=-\\frac{1}{t},\\,t\\ne 0.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=-3t+2\\,⇒\\,t=\\frac{2-x}{3}\\end{aligned}\n$$\n\nNow, substituting $t=\\frac{2-x}{3}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =-\\frac{1}{\\left(\\frac{2-x}{3}\\right)} \\\\ y & =\\frac{3}{x-2}\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{3}{x-2}.$\n\nFinally, since $t\\ne 0$ and $x=-3t+2$ , we must have $x\\ne 2.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{3}{x-2},\\,x\\ne 2.\n$$"}] [{:db/id #edb/ref 17592186302089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e36e3afa-c12b-5dbf-b925-ce2a9ac1b821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}\\theta " :db/id #edb/ref 17592186301093} {:answer/id #uuid "ed3ddf6d-188a-5498-8ba0-131255435cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sin\\theta" :db/id #edb/ref 17592186534791}] :answer-field/correct {:answer/id #uuid "ed3ddf6d-188a-5498-8ba0-131255435cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sin\\theta" :db/id #edb/ref 17592186534791} :answer-field/id #uuid "3c007995-49ad-5e9a-b8b6-93fc43a8d698" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301419} {:answer-field/choices [{:answer/id #uuid "ff1359ca-731e-588b-ad72-8641a92033c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{cos}\\theta " :db/id #edb/ref 17592186301224} {:answer/id #uuid "8baf6eca-06ba-55ed-a1ba-7da2a1ba307c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cos\\theta" :db/id #edb/ref 17592186534567}] :answer-field/correct {:answer/id #uuid "8baf6eca-06ba-55ed-a1ba-7da2a1ba307c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cos\\theta" :db/id #edb/ref 17592186534567} :answer-field/id #uuid "401ee065-0ebf-5aa0-824b-786cf439cf76" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301438}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6149e2ab-873c-5575-a1df-2ba15ff46c49" :question/math-academy-id "q-321890" :question/problem "![](images/b5/b51c85930a5b93bcf7f3e7537cd39cf4134d93470b580c0f7276ddb58ade7297.png)\n\nConsider the circle of radius $4$ centered at the origin, as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the circle once in the counterclockwise direction starting at the point $A(4,0).$\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}$,\\,\\theta \\in [0,2\\pi )$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r,0).$\n\nIn our case, the radius is $r=4.$ Substituting $r=4$ gives\n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186302090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1857e6a4-b487-5f9a-85d3-000e57d70798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{cos}\\theta " :db/id #edb/ref 17592186300064}] :answer-field/correct {:answer/id #uuid "1857e6a4-b487-5f9a-85d3-000e57d70798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{cos}\\theta " :db/id #edb/ref 17592186300064} :answer-field/id #uuid "3617d5d9-7073-5ed0-8019-b4794c0f759d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301399} {:answer-field/choices [{:answer/id #uuid "14635aa0-9a64-5ead-8f4f-19c50118603c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{sin}\\theta " :db/id #edb/ref 17592186300043}] :answer-field/correct {:answer/id #uuid "14635aa0-9a64-5ead-8f4f-19c50118603c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{sin}\\theta " :db/id #edb/ref 17592186300043} :answer-field/id #uuid "b7bb4139-ed9c-5558-bfc3-c94208118406" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27209947-9b17-5ce0-95a6-938cd5c30020" :question/math-academy-id "q-321891" :question/problem "![](images/da/da3a33a3ade10663064516bac22c07459ccf7ce556753ba94d70ee832e947458.png)\n\nConsider the circle of radius $10$ centered at the origin, as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the circle once in the counterclockwise direction starting at the point $A(10,0).$\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}$,\\,\\theta \\in [0,2\\pi )$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r,0).$\n\nIn our case, the radius is $r=10.$ Substituting $r=10$ gives\n\n$$\nx=10\\operatorname{cos}⁡\\theta ,\\,y=10\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186302096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2148c7a5-f055-53c0-8dcf-ad01b9d5e209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{sin}\\theta +4" :db/id #edb/ref 17592186300122}] :answer-field/correct {:answer/id #uuid "2148c7a5-f055-53c0-8dcf-ad01b9d5e209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{sin}\\theta +4" :db/id #edb/ref 17592186300122} :answer-field/id #uuid "a0acfff7-97ab-5f9a-aeb4-7db9cc36cb50" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301743} {:answer-field/choices [{:answer/id #uuid "a49abe00-e44e-5f03-96ad-c502e60787f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{cos}\\theta -3" :db/id #edb/ref 17592186300791}] :answer-field/correct {:answer/id #uuid "a49abe00-e44e-5f03-96ad-c502e60787f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{cos}\\theta -3" :db/id #edb/ref 17592186300791} :answer-field/id #uuid "c54e1a1d-0697-5d9a-b2df-68c14166a055" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301868}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "390af415-dcf0-5200-af38-71372e9b2ef3" :question/math-academy-id "q-321939" :question/problem "![](images/46/460b94dd8d68c7ed7e5bab45befb9c86496291ae7f192ab022e47493807525d5.png)\n\nConsider the circle of radius $5$ centered at $(-3,4)$, as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the circle once in the counterclockwise direction starting at the point $A(2,4).$\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}$,\\,\\theta \\in [0,2\\pi )$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $5$ centered at the point $(-3,4).$ Therefore, the parametric equations of the circle are\n\n$$\nx=5\\operatorname{cos}⁡\\theta -3,\\,y=5\\operatorname{sin}⁡\\theta +4,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186302097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9199c538-6312-5fa1-b986-d5d2550a7739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{sin}\\theta -2" :db/id #edb/ref 17592186300690}] :answer-field/correct {:answer/id #uuid "9199c538-6312-5fa1-b986-d5d2550a7739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{sin}\\theta -2" :db/id #edb/ref 17592186300690} :answer-field/id #uuid "7dddbe20-e72f-50c7-969c-abae71403041" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301619} {:answer-field/choices [{:answer/id #uuid "f1820b9d-5979-56da-b577-bab09b3dab01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{cos}\\theta -5" :db/id #edb/ref 17592186301153}] :answer-field/correct {:answer/id #uuid "f1820b9d-5979-56da-b577-bab09b3dab01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{cos}\\theta -5" :db/id #edb/ref 17592186301153} :answer-field/id #uuid "8a2f6d3d-83ed-5482-a0cb-c56b051fd4f7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301663}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bce5484-c85d-583f-82f3-6100e4f480f5" :question/math-academy-id "q-321942" :question/problem "![](images/59/59cef258a1ad0e6a0f56c37e0b7020e5341c329d5655c41f49e6e78eafca8b3f.png)\n\nConsider the circle of radius $6$ centered at $(-5,-2)$, as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the circle once in the counterclockwise direction starting at the point $A(1,-2).$\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}$,\\,\\theta \\in [0,2\\pi )$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $6$ centered at the point $(-5,-2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=6\\operatorname{cos}⁡\\theta -5,\\,y=6\\operatorname{sin}⁡\\theta -2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186302098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc3655a7-f8db-5846-af3c-25460c132af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{6}" :db/id #edb/ref 17592186300983}] :answer-field/correct {:answer/id #uuid "cc3655a7-f8db-5846-af3c-25460c132af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{6}" :db/id #edb/ref 17592186300983} :answer-field/id #uuid "1cf81aff-e496-5b8c-9552-7373708bbd68" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301321} {:answer-field/choices [{:answer/id #uuid "6dc7372f-b6d1-5b9c-9751-ff4f797dc123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300514}] :answer-field/correct {:answer/id #uuid "6dc7372f-b6d1-5b9c-9751-ff4f797dc123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300514} :answer-field/id #uuid "daa2e725-2b7a-5a48-92ef-54503711ba85" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301929}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea11e213-e469-58c8-9667-84ff5e30c91a" :question/math-academy-id "q-321947" :question/problem "![](images/11/11f1e6651d86e0b00884091338029395cd6d2ff44f25b97d010ec750d13bef59.png)\n\nThe arc of a circle above is defined by the parametric equations \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$ Assume $\\theta $ is between $0$ and $2\\pi .$\n\n$\\theta \\in [${{field-1}}$,$\n{{field-2}}$]$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=4.$ So, the parametric equations of the *full* circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to the arc above, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis.\n\n![](images/2a/2a281b909e4a3577ea3774e9d75c43d97e4d4a69d0f673eed4189834e1ed1c43.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{7\\pi }{6}]$, we get the required arc of the circle.\n\nTherefore, the parametric equations of the arc of the circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{7\\pi }{6}].\n$$"}] [{:db/id #edb/ref 17592186302099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a70675-ce33-5a1b-83ef-f7af2fc8bdd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186300330}] :answer-field/correct {:answer/id #uuid "48a70675-ce33-5a1b-83ef-f7af2fc8bdd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186300330} :answer-field/id #uuid "86d87c6d-9b20-5d5e-86a2-8e5143f0b1e2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301649} {:answer-field/choices [{:answer/id #uuid "bb078694-909a-57c5-91b1-91793f4484df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300899}] :answer-field/correct {:answer/id #uuid "bb078694-909a-57c5-91b1-91793f4484df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300899} :answer-field/id #uuid "d3087335-a091-5af9-afd7-fc154d3fa50f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301907}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "849c57f2-d360-5ce8-a933-fa42e7401299" :question/math-academy-id "q-321948" :question/problem "![](images/ed/ed6f528f7e2b873812d492cbeec386ab56af626a964e98b2929824ec9075d320.png)\n\nThe quarter-circle above is defined by the parametric equations \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$ Assume $\\theta $ is between $0$ and $2\\pi .$\n\n$\\theta \\in [${{field-1}}$,$\n{{field-2}}$]$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=4.$ So, the parametric equations of the *full* circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to the arc above, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis.\n\n![](images/68/682f73ccec945de2789ecca71aa6dae650c485189c60ffc64ab7a7aa108665da.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{\\pi }{2}]$, we get the required arc of the circle.\n\nTherefore, the parametric equations of the arc of the circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{\\pi }{2}].\n$$"}] [{:db/id #edb/ref 17592186302102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5e907a2-031b-5216-92f5-5f4ff0100ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186300865}] :answer-field/correct {:answer/id #uuid "b5e907a2-031b-5216-92f5-5f4ff0100ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186300865} :answer-field/id #uuid "8ec9b74a-062d-5eb7-8cce-bb0a8247b758" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301681} {:answer-field/choices [{:answer/id #uuid "39126ced-d9b7-5da2-ad4a-fae678eab433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186300238}] :answer-field/correct {:answer/id #uuid "39126ced-d9b7-5da2-ad4a-fae678eab433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186300238} :answer-field/id #uuid "cf0ca3ae-534e-533c-86b9-d3973cf4037c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301891}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d06f28ce-407e-57f3-9468-51dcff74f6bf" :question/math-academy-id "q-321976" :question/problem "![](images/fb/fbe6faf7f14f9ce51c299f18f9596c08c650079d2ca23398180baff8ea965553.png)\n\nThe three-quarter-circle above is defined by the parametric equations \n\n$$\nx=\\operatorname{cos}⁡\\theta -1,\\,y=\\operatorname{sin}⁡\\theta +1.\n$$\n\nWhat is the domain of the parameter $\\theta ?$ Assume $\\theta $ is between $0$ and $2\\pi .$\n\n$\\theta \\in [${{field-1}}$,$\n{{field-2}}$]$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in (0,2\\pi ].\n$$\n\nIn our case, we have a circle of radius $1$ centered at the point $(-1,1).$ So, the parametric equations of the *full* circle are \n\n$$\nx=\\operatorname{cos}⁡\\theta -1,\\,y=\\operatorname{sin}⁡\\theta +1,\\,\\theta \\in (0,2\\pi ].\n$$\n\nTo restrict the parameterization to a three-quarter-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the line parallel to the $x$-axis and crossing the center of the circle. \n\n![](images/28/28d5eaee4de3a6100a92fa017b71d9860ea19cd7073284b41511dda4155ecb6d.png)\n\nWe can see that if we restrict $\\theta $ to $[\\frac{\\pi }{2},2\\pi ]$, we get the required three-quarter-circle.\n\nTherefore, the parametric equations of the three-quarter circle are \n\n$$\nx=\\operatorname{cos}⁡\\theta -1,\\,y=\\operatorname{sin}⁡\\theta +1,\\,\\theta \\in [\\frac{\\pi }{2},2\\pi ].\n$$"}] [{:db/id #edb/ref 17592186302103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b4ea447-f2d0-526c-9ddf-83da34800f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300744}] :answer-field/correct {:answer/id #uuid "9b4ea447-f2d0-526c-9ddf-83da34800f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300744} :answer-field/id #uuid "800b3d0b-20d9-50e8-a5e7-06f6f3966edc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301630} {:answer-field/choices [{:answer/id #uuid "cf960976-4b33-5d50-bb00-f55f8bea67a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300997}] :answer-field/correct {:answer/id #uuid "cf960976-4b33-5d50-bb00-f55f8bea67a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300997} :answer-field/id #uuid "e9c94416-2a0c-5eec-9d8c-84444f96eb1f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301966} {:answer-field/choices [{:answer/id #uuid "e37b2f7b-15e2-5184-bb38-7c4d0c13df3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186301094}] :answer-field/correct {:answer/id #uuid "e37b2f7b-15e2-5184-bb38-7c4d0c13df3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186301094} :answer-field/id #uuid "ec807056-656f-52ca-a946-3ed532a26982" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301979}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7267f9b7-cdd2-51d4-b411-b6d5bc974cb9" :question/math-academy-id "q-321986" :question/problem "The Cartesian equation of the circle defined by the parametric equations\n\n$$\nx=5\\operatorname{cos}⁡\\theta -3,\\,y=5\\operatorname{sin}⁡\\theta +4,\\,0\\le \\theta <2\\pi \n$$\n\nis given by\n\n$(x\\,+$\n{{field-1}}$)^{2}+(y\\,-$\n{{field-2}}$)^{2}=$\n{{field-3}}." :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x+3}{5} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x+3)^{2}}{{5}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x+3)^{2}}{25} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y-4}{5} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y-4)^{2}}{{5}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y-4)^{2}}{25} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{25}+\\frac{(y-4)^{2}}{25} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{(x+3)^{2}}{25}+\\frac{(y-4)^{2}}{25} & =1 \\\\ (x+3)^{2}+(y-4)^{2} & =25\\end{aligned}\n$$\n\nTherefore, the Cartesian equation is $(x+3)^{2}+(y-4)^{2}=25.$"}] [{:db/id #edb/ref 17592186302104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e6ce444-1a0a-53ea-9361-3aa309789684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300444}] :answer-field/correct {:answer/id #uuid "5e6ce444-1a0a-53ea-9361-3aa309789684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300444} :answer-field/id #uuid "3d5d7539-3050-5d9c-a002-ca7898373c6b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301423} {:answer-field/choices [{:answer/id #uuid "b7e39665-6d18-5f6f-94bf-1d05f78acc19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186300880}] :answer-field/correct {:answer/id #uuid "b7e39665-6d18-5f6f-94bf-1d05f78acc19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186300880} :answer-field/id #uuid "4ed4af37-3190-558e-81c6-c2e32e7a3793" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301484} {:answer-field/choices [{:answer/id #uuid "c6988236-237d-502f-890e-30939bd5123c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300955}] :answer-field/correct {:answer/id #uuid "c6988236-237d-502f-890e-30939bd5123c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300955} :answer-field/id #uuid "b810be8a-6f61-5ff8-9bad-4e3042115c6c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301829}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c298ac38-ce78-5be9-baf7-f23482f91da4" :question/math-academy-id "q-321988" :question/problem "The Cartesian equation of the circle defined by the parametric equations\n\n$$\nx=\\frac{5}{2}\\operatorname{cos}⁡\\theta -3,\\,y=\\frac{5}{2}\\operatorname{sin}⁡\\theta +1,\\,0\\le \\theta <2\\pi \n$$\n\nis given by\n\n$(x\\,+$\n{{field-1}}$)^{2}+(y\\,-$\n{{field-2}}$)^{2}=$\n{{field-3}}." :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x+3 & =\\frac{5}{2}\\operatorname{cos}⁡\\theta  \\\\ \\frac{2}{5}(x+3) & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{4}{25}{(x+3)}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y-1 & =\\frac{5}{2}\\operatorname{sin}⁡\\theta  \\\\ \\frac{2}{5}(y-1) & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{4}{25}{(y-1)}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{4}{25}{(x+3)}^{2}+\\frac{4}{25}{(y-1)}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{4}{25}{(x+3)}^{2}+\\frac{4}{25}{(y-1)}^{2} & =1 \\\\ {(x+3)}^{2}+{(y-1)}^{2} & =\\frac{25}{4}.\\end{aligned}\n$$\n\nTherefore, the Cartesian equation is ${(x+3)}^{2}+{(y-1)}^{2}=\\frac{25}{4}.$"}] [{:db/id #edb/ref 17592186302105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e4625cd-b5b3-5b8d-9670-dd9b56b8ac39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186300369}] :answer-field/correct {:answer/id #uuid "4e4625cd-b5b3-5b8d-9670-dd9b56b8ac39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186300369} :answer-field/id #uuid "4f3a6527-bf58-56ec-a72b-37753e4a00d9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301485} {:answer-field/choices [{:answer/id #uuid "3efba986-59fe-5477-a7a1-a5717686607f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186300271}] :answer-field/correct {:answer/id #uuid "3efba986-59fe-5477-a7a1-a5717686607f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186300271} :answer-field/id #uuid "d63d177c-ca19-544d-97d0-9ab8f401a7fe" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301913} {:answer-field/choices [{:answer/id #uuid "8dc15257-2218-54e8-81b4-38b448e8f019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186300679}] :answer-field/correct {:answer/id #uuid "8dc15257-2218-54e8-81b4-38b448e8f019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186300679} :answer-field/id #uuid "df06b6c6-e63e-5bfa-a5f2-b0b512067676" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301935}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "553d8835-419a-5f16-a1a2-9829041916d7" :question/math-academy-id "q-321989" :question/problem "The Cartesian equation of the circle defined by the parametric equations\n\n$$\nx=3\\operatorname{cos}⁡\\theta +\\frac{7}{2},\\,y=3\\operatorname{sin}⁡\\theta -\\frac{11}{4},\\,0\\le \\theta <2\\pi \n$$\n\nis given by\n\n$(x\\,-$\n{{field-1}}$)^{2}+(y\\,+$\n{{field-2}}$)^{2}=$\n{{field-3}}." :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x-\\frac{7}{2} & =3\\operatorname{cos}⁡\\theta  \\\\ \\frac{1}{3}(x-\\frac{7}{2}) & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{1}{9}{(x-\\frac{7}{2})}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y+\\frac{11}{4} & =3\\operatorname{sin}⁡\\theta  \\\\ \\frac{1}{3}(y+\\frac{11}{4}) & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{1}{9}{(y+\\frac{11}{4})}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{9}{(x-\\frac{7}{2})}^{2}+\\frac{1}{9}{(y+\\frac{11}{4})}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{1}{9}{(x-\\frac{7}{2})}^{2}+\\frac{1}{9}{(y+\\frac{11}{4})}^{2} & =1 \\\\ {(x-\\frac{7}{2})}^{2}+{(y+\\frac{11}{4})}^{2} & =9.\\end{aligned}\n$$\n\nTherefore, the Cartesian equation is $$\n\\displaystyle {(x-\\frac{7}{2})}^{2}+{(y+\\frac{11}{4})}^{2}=9.\n$$"}] [{:db/id #edb/ref 17592186302106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ac5b1ab-ce4b-58ec-b400-f54e30c65791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186300740}] :answer-field/correct {:answer/id #uuid "9ac5b1ab-ce4b-58ec-b400-f54e30c65791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186300740} :answer-field/id #uuid "42c7c8d4-2568-5cb9-818c-fa1a1b025b85" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301452} {:answer-field/choices [{:answer/id #uuid "6032e270-5212-5635-b7b2-6e7482fd04fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186300455}] :answer-field/correct {:answer/id #uuid "6032e270-5212-5635-b7b2-6e7482fd04fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186300455} :answer-field/id #uuid "60aa9e9f-825a-5d6f-bd0b-da172d0a0aa7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301536} {:answer-field/choices [{:answer/id #uuid "f4430592-e773-501c-a3c7-b83467548263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186301169}] :answer-field/correct {:answer/id #uuid "f4430592-e773-501c-a3c7-b83467548263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186301169} :answer-field/id #uuid "fed2c7bd-b2ec-5d9b-8a43-de0831700108" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302038}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dd0e867b-d505-5af8-8b82-05070f856f71" :question/math-academy-id "q-321991" :question/problem "The Cartesian equation of the circle defined by the parametric equations\n\n$$\nx=7\\operatorname{cos}⁡\\theta -5,\\,y=7\\operatorname{sin}⁡\\theta +13,\\,0\\le \\theta <2\\pi \n$$\n\nis given by\n\n$(x\\,+$\n{{field-1}}$)^{2}+(y\\,-$\n{{field-2}}$)^{2}=$\n{{field-3}}." :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x+5 & =7\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x+5)^{2}}{{7}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{(x+5)}^{2}}{49} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y-13 & =7\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y-13)^{2}}{{7}^{2}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{(y-13)}^{2}}{49} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{(x+5)}^{2}}{49}+\\frac{{(y-13)}^{2}}{49} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{{(x+5)}^{2}}{49}+\\frac{{(y-13)}^{2}}{49} & =1 \\\\ {(x+5)}^{2}+{(y-13)}^{2} & =49.\\end{aligned}\n$$\n\nTherefore, the Cartesian equation is ${(x+5)}^{2}+{(y-13)}^{2}=49.$"}] [{:db/id #edb/ref 17592186302269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf11f1c2-7e84-52d0-82eb-f0bec75d951c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186300917}] :answer-field/correct {:answer/id #uuid "bf11f1c2-7e84-52d0-82eb-f0bec75d951c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186300917} :answer-field/id #uuid "909ca647-782d-5026-97c2-4f69d2dbc2de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301688} {:answer-field/choices [{:answer/id #uuid "ca352a99-e4be-5a50-b2d8-376ac2cbd696" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186300970}] :answer-field/correct {:answer/id #uuid "ca352a99-e4be-5a50-b2d8-376ac2cbd696" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186300970} :answer-field/id #uuid "be23546a-6789-50c1-b0de-9f43e3206e3b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301847} {:answer-field/choices [{:answer/id #uuid "315f9757-1b3f-500e-b71c-be24341277dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186300203}] :answer-field/correct {:answer/id #uuid "315f9757-1b3f-500e-b71c-be24341277dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186300203} :answer-field/id #uuid "cdc547cb-e485-57de-acc6-c64ddfd515ba" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301887}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97abe29c-aa1a-5961-b330-faf07c8841b1" :question/math-academy-id "q-326242" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\frac{3}{2}t+1,\\,y=-\\frac{5}{4}t+2,\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | {{field-1}} | $1$ | $\\frac{5}{2}$ | $4$ | {{field-2}} | $7$ |\n| $y$ | {{field-3}} | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |" :question/worked-solution "- To find the value of $x(-1),$ we substitute $t=-1$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(-1)=\\frac{3}{2}(-1)+1=-\\frac{3}{2}+\\frac{2}{2}=-\\frac{1}{2}.\n$$\n\n- To find the value of $y(-1),$ we substitute $t=-1$ into $y=-\\frac{5}{4}t+2.$ This gives\n\n$$\ny(-1)=-\\frac{5}{4}(-1)+2=\\frac{5}{4}+\\frac{8}{4}=\\frac{13}{4}.\n$$\n\n- To find the value of $x(3),$ we substitute $t=3$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(2)=\\frac{3}{2}(3)+1=\\frac{9}{2}+\\frac{2}{2}=\\frac{11}{2}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-\\frac{1}{2}$ | $1$ | $\\frac{5}{2}$ | $4$ | $\\frac{11}{2}$ | $7$ |\n| $y$ | $\\frac{13}{4}$ | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |"}] [{:db/id #edb/ref 17592186302270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43263775-6a23-5d97-906a-a6f79d7a0456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186300292}] :answer-field/correct {:answer/id #uuid "43263775-6a23-5d97-906a-a6f79d7a0456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186300292} :answer-field/id #uuid "32519836-bf08-5075-8849-e308dea3e240" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301387} {:answer-field/choices [{:answer/id #uuid "2d011c6c-58a6-561f-ae10-6109748dcac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186300180}] :answer-field/correct {:answer/id #uuid "2d011c6c-58a6-561f-ae10-6109748dcac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186300180} :answer-field/id #uuid "57c14b01-f4ee-5c68-bf97-0b1dcdace2d4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301512} {:answer-field/choices [{:answer/id #uuid "1466bd40-3acf-591c-b003-9c0f787e6551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300044}] :answer-field/correct {:answer/id #uuid "1466bd40-3acf-591c-b003-9c0f787e6551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300044} :answer-field/id #uuid "aeaa33c7-8e94-592c-baee-0f58e084a228" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301794}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "657285cd-f814-5fb4-ae66-64de44c5741c" :question/math-academy-id "q-326246" :question/problem "Consider the curve with parametric equations\n\n$$\nx={t}^{3}-2t,\\,y=-2t+\\frac{3}{2},\\,0\\le t\\le 5.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $-1$ | {{field-1}} | $21$ | $56$ | {{field-2}} |\n| $y$ | $\\frac{3}{2}$ | $-\\frac{1}{2}$ | $-\\frac{5}{2}$ | {{field-3}} | $-\\frac{13}{2}$ | $-\\frac{17}{2}$ |" :question/worked-solution "- To find the value of $x(2),$ we substitute $t=2$ into $x={t}^{3}-2t.$ This gives\n\n$$\nx(2)=(2)^{3}-2(2)=8-4=4.\n$$\n\n- To find the value of $y(3),$ we substitute $t=3$ into $y=-2t+\\frac{3}{2}.$ This gives\n\n$$\ny(3)=-2(3)+\\frac{3}{2}=-6+\\frac{3}{2}=-\\frac{12}{2}+\\frac{3}{2}=-\\frac{9}{2}.\n$$\n\n- To find the value of $x(5),$ we substitute $t=5$ into $x={t}^{3}-2t.$ This gives\n\n$$\nx(5)=(5)^{3}-2(5)=125-10=115.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $-1$ | $4$ | $21$ | $56$ | $115$ |\n| $y$ | $\\frac{3}{2}$ | $-\\frac{1}{2}$ | $-\\frac{5}{2}$ | $-\\frac{9}{2}$ | $-\\frac{13}{2}$ | $-\\frac{17}{2}$ |"}] [{:db/id #edb/ref 17592186302271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7d2c9b6-3f61-5b0c-8d40-7c8c3ad00a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186301036}] :answer-field/correct {:answer/id #uuid "d7d2c9b6-3f61-5b0c-8d40-7c8c3ad00a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186301036} :answer-field/id #uuid "475eb211-fdac-5ef1-a7b1-d7c876368b09" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301462} {:answer-field/choices [{:answer/id #uuid "01f65e8b-4617-531e-b590-48e7cae4c340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186299937}] :answer-field/correct {:answer/id #uuid "01f65e8b-4617-531e-b590-48e7cae4c340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186299937} :answer-field/id #uuid "56a825ae-6d12-5ca9-bc21-522636b5fc85" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301508} {:answer-field/choices [{:answer/id #uuid "d7bc2368-2d49-58ef-9f8a-804b443a1d10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186301035}] :answer-field/correct {:answer/id #uuid "d7bc2368-2d49-58ef-9f8a-804b443a1d10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186301035} :answer-field/id #uuid "ceb7fcf1-d976-5665-b741-fc69d5d0b030" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301890}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "854eb5bf-774c-5c7b-a116-76c300b05cad" :question/math-academy-id "q-326247" :question/problem "Consider the curve with parametric equations\n\n$$\nx={t}^{2}-2t+2,\\,y=2{t}^{3}-3{t}^{2}+12,\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $5$ | $2$ | {{field-1}} | $2$ | $5$ | $10$ |\n| $y$ | $7$ | $12$ | $11$ | {{field-2}} | $39$ | {{field-3}} |" :question/worked-solution "- To find the value of $x(1),$ we substitute $t=1$ into $x={t}^{2}-2t+2.$ This gives\n\n$$\nx(1)=(1)^{2}-2(1)+2=1-2+2=1.\n$$\n\n- To find the value of $y(2),$ we substitute $t=2$ into $y=2{t}^{3}-3{t}^{2}+12.$ This gives\n\n$$\ny(2)=2(2)^{3}-3(2)^{2}+12=16-12+12=16.\n$$\n\n- To find the value of $y(4),$ we substitute $t=4$ into $y=2{t}^{3}-3{t}^{2}+12.$ This gives\n\n$$\ny(4)=2(4)^{3}-3(4)^{2}+12=128-48+12=92.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $5$ | $2$ | $1$ | $2$ | $5$ | $10$ |\n| $y$ | $7$ | $12$ | $11$ | $16$ | $39$ | $92$ |"}]}
