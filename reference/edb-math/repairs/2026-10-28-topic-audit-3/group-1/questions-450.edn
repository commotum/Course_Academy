#{[{:db/id #edb/ref 17592186259561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "384f72db-1382-5e20-bf1f-b36c690e33cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le x\\le 3,\\,-2\\le y\\le 0" :db/id #edb/ref 17592186257278} {:answer/id #uuid "801fd8d9-9053-54df-9ced-8c85c3bdf98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\le x\\le 4,\\,-2\\le y\\le 0" :db/id #edb/ref 17592186257921} {:answer/id #uuid "8c14b075-1888-5849-bc15-60accafaa842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\le x\\le -2,\\,0\\le y\\le 2" :db/id #edb/ref 17592186258010} {:answer/id #uuid "e2d3bd46-7af0-528b-a6fd-981273814a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le x\\le 3,\\,-1\\le y\\le 1" :db/id #edb/ref 17592186258756} {:answer/id #uuid "f26d173c-5784-55a7-aa52-c3e3759de69c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\le x\\le 4,\\,-1\\le y\\le 1" :db/id #edb/ref 17592186258893}] :answer-field/correct {:answer/id #uuid "801fd8d9-9053-54df-9ced-8c85c3bdf98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\le x\\le 4,\\,-2\\le y\\le 0" :db/id #edb/ref 17592186257921} :answer-field/id #uuid "069877ab-6f59-5111-82b1-30e0cd6529a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39f52df2-f7c2-52ca-a128-fe39a8ac5d3e" :question/math-academy-id "q-123777" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\operatorname{cos}⁡\\theta +3,\\,y=\\operatorname{sin}⁡\\theta -1,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -1+3 & \\le \\operatorname{cos}⁡\\theta +3\\le 1+3 \\\\ 2 & \\le x\\le 4.\\end{aligned}\n$$\n\nSo, we can conclude that $2\\le x\\le 4.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -1-1 & \\le \\operatorname{sin}⁡\\theta -1\\le 1-1 \\\\ -2 & \\le y\\le 0.\\end{aligned}\n$$\n\nSo, we can conclude that $-2\\le y\\le 0.$\n\nTherefore, the ranges are $2\\le x\\le 4$ and $-2\\le y\\le 0.$"}] [{:db/id #edb/ref 17592186259562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0533b388-aaff-54e5-984c-f3ee20038849" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/ccdac60d2d9e7820ea4053977be2b71c4ffa18a8683c3bc9ef0752e806c0ffcd.png" :db/id #edb/ref 17592186256830} {:answer/id #uuid "456ec123-3e59-5576-9436-163bb4b301be" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f65b8e725f7e4a81050d299b4edb8ade15ce5408a16d0d9849c4fa49c0c75985.png" :db/id #edb/ref 17592186257389} {:answer/id #uuid "537b0f3b-5964-586b-a032-37e4b099f0bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7cca3671544acd472c82651d3406347ce7e8c24aa4312096fcf7a1014bd1cdd1.png" :db/id #edb/ref 17592186257497} {:answer/id #uuid "79ebbeb9-dd79-54ab-bc0f-e7281ae182e0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/16e0429bb738f3cdee4f20a363ecdae6457ba18526c159c20ab69244f0bf6a2e.png" :db/id #edb/ref 17592186257859} {:answer/id #uuid "ccef5970-6d79-51ac-8422-aa3e27726bc2" :ans