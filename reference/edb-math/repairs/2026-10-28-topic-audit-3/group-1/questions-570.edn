#{[{:db/id #edb/ref 17592186271969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1f8641-083e-5979-bce4-29e77b2f98b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15i-28j+32k" :db/id #edb/ref 17592186269382} {:answer/id #uuid "1c991130-1867-526a-b960-271f05839726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15i+28j+44k" :db/id #edb/ref 17592186269503} {:answer/id #uuid "34af8bd6-ec32-5567-9645-00a05534e8da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15i+28j+44k" :db/id #edb/ref 17592186269753} {:answer/id #uuid "3e1a966c-5004-5649-a390-ccaf764bed6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16i-28j+32k" :db/id #edb/ref 17592186269836} {:answer/id #uuid "a8809211-bd9c-5503-8eaf-d3f49bf867f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15i+44j-28k" :db/id #edb/ref 17592186270773}] :answer-field/correct {:answer/id #uuid "1c991130-1867-526a-b960-271f05839726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15i+28j+44k" :db/id #edb/ref 17592186269503} :answer-field/id #uuid "0bf507f9-ac3b-5b8c-ae33-917f43e4a654" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271526}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1339d8a8-d0ff-59c8-809d-c03b078ebc82" :question/math-academy-id "q-1399" :question/problem "Let $a=8i-2j+4k$ and $b=6i+4j-\\frac{1}{2}k.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 8 & -2 & 4 \\\\ 6 & 4 & -\\frac{1}{2}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 4 \\\\ 4 & -\\frac{1}{2}\\end{vmatrix}i-\\begin{vmatrix}8 & 4 \\\\ 6 & -\\frac{1}{2}\\end{vmatrix}j+\\begin{vmatrix}8 & -2 \\\\ 6 & 4\\end{vmatrix}k \\\\  & =(1-16)i-(-4-24)j+(32+12)k \\\\  & =-15i+28j+44k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44163bc2-5f17-57aa-b984-7f8efd19cf22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25i+25j-25k" :db/id #edb/ref 17592186269884} {:answer/id #uuid "72fd01f9-d62e-5d91-9690-aa442c42ecf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7i+17j+31k" :db/id #edb/ref 17592186270286} {:answer/id #uuid "7847b5d8-ab1a-5702-b18b-e5da7d5b8037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7i-17j-25k" :db/id #edb/ref 17592186270335} {:answer/id #uuid "bba6e560-18ea-5e21-bcc1-21ac3b0a64ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7i-17j+25k" :db/id #edb/ref 17592186270921} {:answer/id #uuid "c29a2c61-f3c6-5ad3-9130-2571c9496ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25i-17j-25k" :db/id #edb/ref 17592186270987}] :answer-field/correct {:answer/id #uuid "7847b5d8-ab1a-5702-b18b-e5da7d5b8037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7i-17j-25k" :db/id #edb/ref 17592186270335} :answer-field/id #uuid "3659f911-46ca-56aa-a3c2-aa0c80b8e3bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6632b05c-f8cc-5460-a240-32dd587ba027" :question/math-academy-id "q-1404" :question/problem "Let $u=7i+3j-4k$ and $v=-i-4j+3k.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 7 & 3 & -4 \\\\ -1 & -4 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -4 \\\\ -4 & 3\\end{vmatrix}i-\\begin{vmatrix}7 & -4 \\\\ -1 & 3\\end{vmatrix}j+\\begin{vmatrix}7 & 3 \\\\ -1 & -4\\end{vmatrix}k \\\\  & =(3\\cdot 3-(-4)\\cdot (-4))i-(7\\cdot 3-(-4)\\cdot (-1))j+(7\\cdot (-4)-(3)\\cdot (-1))k \\\\  & =(9-16)i-(21-4)j+(-28+3)k \\\\  & =-7i-17j-25k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "234b4889-3096-5340-93ad-e9abf070006b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i-11k" :db/id #edb/ref 17592186269579} {:answer/id #uuid "39457fae-b3aa-51aa-8f9a-02b388cc7fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i-11j+3k" :db/id #edb/ref 17592186269788} {:answer/id #uuid "3ab09640-e186-569c-9441-4f617e31082f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7i-11j+3k" :db/id #edb/ref 17592186269802} {:answer/id #uuid "a20d1154-0187-5342-8607-2292c02a2817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i+11j-5k" :db/id #edb/ref 17592186270709} {:answer/id #uuid "aa703be9-c555-5ae6-a536-c4471e92390c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i+3k" :db/id #edb/ref 17592186270791}] :answer-field/correct {:answer/id #uuid "39457fae-b3aa-51aa-8f9a-02b388cc7fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i-11j+3k" :db/id #edb/ref 17592186269788} :answer-field/id #uuid "c4557017-03b3-5a14-a19d-99498f496c2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271866}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55f94724-9237-566f-b3f0-87f89c5fdc08" :question/math-academy-id "q-1406" :question/problem "Let $u=3i-2k$ and $v=-2i+j+5k.$ Determine $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 3 & 0 & -2 \\\\ -2 & 1 & 5\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & -2 \\\\ 1 & 5\\end{vmatrix}i-\\begin{vmatrix}3 & -2 \\\\ -2 & 5\\end{vmatrix}j+\\begin{vmatrix}3 & 0 \\\\ -2 & 1\\end{vmatrix}k \\\\  & =(0\\cdot 5-(-2)\\cdot 1)i-(3\\cdot 5-(-2)\\cdot (-2))j+(3\\cdot 1-0\\cdot (-2))k \\\\  & =(0+2)i-(15-4)j+(3-0)k \\\\  & =2i-11j+3k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76e097e2-0a17-5a17-9213-09891fcbf1d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-6,0,-13⟩" :db/id #edb/ref 17592186270318} {:answer/id #uuid "9a18ed81-7e2b-51e9-9ba8-f1bce6c5deb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-6,-78,13⟩" :db/id #edb/ref 17592186270623} {:answer/id #uuid "a7987eab-ddc3-5ab9-83a2-181512d5600a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,78,-13⟩" :db/id #edb/ref 17592186270769} {:answer/id #uuid "b83f86e7-b56e-5948-9f64-3ac5e7541a35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,78,13⟩" :db/id #edb/ref 17592186270897} {:answer/id #uuid "d43ef692-bf16-5710-91b2-f351cc23d35b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-6,78,-13⟩" :db/id #edb/ref 17592186271135}] :answer-field/correct {:answer/id #uuid "a7987eab-ddc3-5ab9-83a2-181512d5600a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,78,-13⟩" :db/id #edb/ref 17592186270769} :answer-field/id #uuid "eb0dd8e2-9c8e-5161-8d46-9c73ebd4c4bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271924}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4da79104-318a-574d-9235-024232815019" :question/math-academy-id "q-1407" :question/problem "Let $a=⟨0,1,6⟩$ and $b=⟨13,0,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 0 & 1 & 6 \\\\ 13 & 0 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 6 \\\\ 0 & 0\\end{vmatrix}i-\\begin{vmatrix}0 & 6 \\\\ 13 & 0\\end{vmatrix}j+\\begin{vmatrix}0 & 1 \\\\ 13 & 0\\end{vmatrix}k \\\\  & =(1\\cdot 0-6\\cdot 0)i-(0\\cdot 0-6\\cdot 13)j+(0\\cdot 0-1\\cdot 13)k \\\\  & =(0-0)i-(0-78)j+(0-13)k \\\\  & =78j-13k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d425d1d-8c08-5032-a5c4-618cae84d141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-101,6,-34⟩" :db/id #edb/ref 17592186269673} {:answer/id #uuid "7d19b398-3e42-5e89-8684-b39b0bc27a4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-92,-6,34⟩" :db/id #edb/ref 17592186270365} {:answer/id #uuid "dccf3415-f057-540e-9f89-9b02143278d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-92,6,-34⟩" :db/id #edb/ref 17592186271205} {:answer/id #uuid "df6e5d31-a60a-5ede-aec4-29ca6f8768d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-52,6,34⟩" :db/id #edb/ref 17592186271229} {:answer/id #uuid "e8e7946d-151b-527a-b2df-42efc8bc4c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-52,-6,-34⟩" :db/id #edb/ref 17592186271305}] :answer-field/correct {:answer/id #uuid "dccf3415-f057-540e-9f89-9b02143278d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-92,6,-34⟩" :db/id #edb/ref 17592186271205} :answer-field/id #uuid "ad2efed8-cea5-57da-8e28-0a849c147447" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "612e2b54-14a1-56a4-bf3c-99da94b50e57" :question/math-academy-id "q-1409" :question/problem "Let $a=⟨-3,5,9⟩$ and $b=⟨2,8,-4⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ -3 & 5 & 9 \\\\ 2 & 8 & -4\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & 9 \\\\ 8 & -4\\end{vmatrix}i-\\begin{vmatrix}-3 & 9 \\\\ 2 & -4\\end{vmatrix}j+\\begin{vmatrix}-3 & 5 \\\\ 2 & 8\\end{vmatrix}k \\\\  & =(5\\cdot (-4)-9\\cdot 8)i-((-3)\\cdot (-4)-9\\cdot 2)j+((-3)\\cdot 8-5\\cdot 2)k \\\\  & =(-20-72)i-(12-18)j+(-24-10)k \\\\  & =-92i+6j-34k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e211782-309a-51c0-a713-d07f448fc97b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{2}{t}^{3}\\sqrt{1+{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186272656} {:answer/id #uuid "1ec024f9-21cc-53d5-bfc6-22c7fa114572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{t}^{2}\\sqrt{1+{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186272660} {:answer/id #uuid "470ecd9b-5499-5f92-990a-ed77f15a713d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{t}^{4}\\sqrt{1+9{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186272996} {:answer/id #uuid "5b4e24bc-f658-580d-b5cc-e63ebd76e5e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}t\\sqrt{9+{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186273169} {:answer/id #uuid "ffadff14-6e7e-53ec-a644-3e122db5a0ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{2}{t}^{3}\\sqrt{1+9{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186274634}] :answer-field/correct {:answer/id #uuid "470ecd9b-5499-5f92-990a-ed77f15a713d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{t}^{4}\\sqrt{1+9{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186272996} :answer-field/id #uuid "2c251c8c-b0cc-5b4c-a53d-d251d22e0a19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ed8e671-dba0-5b17-a617-026035ea0427" :question/math-academy-id "q-148206" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}xy\\,\\text{d}s,\n$$ where $C$ is the section of the curve $y={x}^{3}$ between the points $(0,0)$ and $(2,8)?$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)={t}^{3}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,{t}^{3}⟩,\\,0\\le t\\le 2\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({t}^{3})j \\\\  & =i+3{t}^{2}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{(3{t}^{2})}^{2}} \\\\  & =\\sqrt{1+9{t}^{4}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =t\\cdot {t}^{3}={t}^{4}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{t}^{4}\\sqrt{1+9{t}^{4}}\\,\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20169860-8c75-5d25-9901-ef00b1611a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}t\\sqrt{{t}^{2}+2}\\,\\text{d}t" :db/id #edb/ref 17592186272672} {:answer/id #uuid "5fb53aaf-c3cf-563c-a402-eb288f2747b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2}{t}^{2}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186273211} {:answer/id #uuid "73e1d2d9-2879-52c2-bf6b-48ca39cbca83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{t}^{4}\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186273378} {:answer/id #uuid "c85235f2-5f20-584b-a6ac-e1dc2e931af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186274127} {:answer/id #uuid "cd8ec156-aaaf-5243-aaed-999441c1ab71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2}t\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186274175}] :answer-field/correct {:answer/id #uuid "c85235f2-5f20-584b-a6ac-e1dc2e931af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186274127} :answer-field/id #uuid "ab418e3a-3935-5c69-8117-e9ddcea28c4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "536389f6-596b-5b8f-aeb8-156ffc2d65a0" :question/math-academy-id "q-148208" :question/problem "Which of the following is equivalent to the integral $$\n\\displaystyle {\\int }_{C}2{x}^{3}y\\,\\text{d}s,\n$$ where $C$ is the section of the curve $y=\\frac{1}{x}$ between the points $(1,1)$ and $(2,\\frac{1}{2})?$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=\\frac{1}{t}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\frac{1}{t}⟩,\\,1\\le t\\le 2\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)j \\\\  & =i-\\frac{1}{{t}^{2}}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{\\left(-\\frac{1}{{t}^{2}}\\right)}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{{t}^{4}}} \\\\  & =\\frac{\\sqrt{{t}^{4}+1}}{{t}^{2}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2{x}^{3}y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2\\cdot {t}^{3}\\cdot \\frac{1}{t}=2{t}^{2}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{1}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}2{t}^{2}\\cdot \\frac{\\sqrt{{t}^{4}+1}}{{t}^{2}}\\cdot \\text{d}t \\\\  & =2{\\int }_{1}^{2}\\sqrt{{t}^{4}+1}\\,\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1789b93e-e90d-51e6-86cd-985dcd4c2ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186272592} {:answer/id #uuid "7e646a2c-1e40-5435-9dcf-64c1e220e31c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186273469} {:answer/id #uuid "93a7c64c-5182-542e-b0fc-91eb0d61f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186273673} {:answer/id #uuid "c7199719-0890-571a-9338-3d297facad42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186274116} {:answer/id #uuid "cdab7799-003c-5d60-89a7-3513310a8ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186274177}] :answer-field/correct {:answer/id #uuid "cdab7799-003c-5d60-89a7-3513310a8ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186274177} :answer-field/id #uuid "b59ab03d-3465-5b29-9e7b-a4f6a51317aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274950}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "42825c99-640f-50c0-a09a-bfc117ceeb27" :question/math-academy-id "q-148215" :question/problem "Evaluate the integral of the function $f(x,y)=2xy$ along the curve $y=\\sqrt{4-{x}^{2}},$ $\\,0\\le x\\le 2.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=\\sqrt{4-{t}^{2}}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,\\sqrt{4-{t}^{2}}⟩,\\,0\\le t\\le 2\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(\\sqrt{4-{t}^{2}})j \\\\  & =i-\\frac{t}{\\sqrt{4-{t}^{2}}}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{\\left(-\\frac{t}{\\sqrt{4-{t}^{2}}}\\right)}^{2}} \\\\  & =\\sqrt{1+\\frac{{t}^{2}}{4-{t}^{2}}} \\\\  & =\\frac{2}{\\sqrt{4-{t}^{2}}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2t\\sqrt{4-{t}^{2}}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}2t\\sqrt{4-{t}^{2}}\\cdot \\frac{2}{\\sqrt{4-{t}^{2}}}\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2}t\\,\\text{d}t \\\\  & =2{t}^{2}\\,{|}_{0}^{2} \\\\  & =2({2}^{2}-{0}^{2}) \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0008a7ab-2b00-5ba5-82d0-3f2e6b8bdaa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186272388} {:answer/id #uuid "17e48ee3-60bc-5378-96bd-24895594a042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186272596} {:answer/id #uuid "4ec1aa77-4fa6-5d21-87e6-58f157cb48ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186273050} {:answer/id #uuid "51233414-b60c-52f0-9294-6615ffa1a531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186273078} {:answer/id #uuid "969f01e3-5935-5175-9bab-003ea3ffc27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{9}" :db/id #edb/ref 17592186273690}] :answer-field/correct {:answer/id #uuid "0008a7ab-2b00-5ba5-82d0-3f2e6b8bdaa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186272388} :answer-field/id #uuid "ad4ad789-849d-5b1e-a803-15e978d32631" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "433c5408-32dd-5664-8e15-0cc00f55a35f" :question/math-academy-id "q-148216" :question/problem "Evaluate the integral of the function $f(x,y)=x+y$ along the line $y=x,$ $\\,0\\le x\\le 3.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=t.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,t⟩,\\,0\\le t\\le 3\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =i+\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =t+t=2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}2t\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =2\\sqrt{2}{\\int }_{0}^{3}t\\,\\text{d}t \\\\  & =\\sqrt{2}\\,{t}^{2}{|}_{0}^{3} \\\\  & =\\sqrt{2}({3}^{2}-{0}^{2}) \\\\  & =9\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34291103-4a5e-5f9d-8144-2820b64dc232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{6}" :db/id #edb/ref 17592186272851} {:answer/id #uuid "3b1ac0a8-d747-5642-84bf-d3bedb0860b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186272901} {:answer/id #uuid "41fc5647-a796-5301-9030-d502b60a9abc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13\\sqrt{10}" :db/id #edb/ref 17592186272948} {:answer/id #uuid "d25ab67d-86b3-5cbb-9152-9babdc82e835" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{3}" :db/id #edb/ref 17592186274227} {:answer/id #uuid "db13e736-05fd-5a35-b7d3-84b47c65b56d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23\\sqrt{10}}{6}" :db/id #edb/ref 17592186274303}] :answer-field/correct {:answer/id #uuid "db13e736-05fd-5a35-b7d3-84b47c65b56d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23\\sqrt{10}}{6}" :db/id #edb/ref 17592186274303} :answer-field/id #uuid "906d2ea1-bc54-585c-a9b0-7daff68f61ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274879}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43f73019-6edc-5de1-83b9-c96af73e24f3" :question/math-academy-id "q-148218" :question/problem "Evaluate the integral of the function $f(x,y)=({x}^{2}+y)$ along the line $y=3x+2,$ $\\,0\\le x\\le 1.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=3t+2.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,3t+2⟩,\\,0\\le t\\le 1\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(3t+2)j \\\\  & =i+3\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{3}^{2}} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}+y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & ={t}^{2}+(3t+2)={t}^{2}+3t+2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{2}+3t+2)\\cdot \\sqrt{10}\\cdot \\text{d}t \\\\  & =\\sqrt{10}{\\int }_{0}^{1}({t}^{2}+3t+2)\\,\\text{d}t \\\\  & =\\sqrt{10}\\,(\\frac{{t}^{3}}{3}+\\frac{3{t}^{2}}{2}+2t){|}_{0}^{1} \\\\  & =\\sqrt{10}(\\frac{1}{3}+\\frac{3}{2}+2) \\\\  & =\\frac{23\\sqrt{10}}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dec25eb-c4e4-5dd8-8858-a2052e0e7cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186273192} {:answer/id #uuid "941af366-6fdf-509f-b872-9d3472fbbf0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186273675} {:answer/id #uuid "9e572a0b-0165-5642-9463-9a75cb4f7d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273754} {:answer/id #uuid "ccd85e82-26c3-57a0-b7b4-34dcbb7eb698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186274169} {:answer/id #uuid "f43d85f4-5fca-5864-b495-5e0b60a2529d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186274545}] :answer-field/correct {:answer/id #uuid "941af366-6fdf-509f-b872-9d3472fbbf0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186273675} :answer-field/id #uuid "e0c951af-26dd-5fa2-96f0-6a3db91ee272" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9a58d761-ea89-5d38-aaa2-f03aa1143709" :question/math-academy-id "q-148219" :question/problem "Evaluate the integral of the function $f(x,y)=\\frac{1}{x-y}$ along the line $y=x-4,$ $\\,0\\le x\\le 2.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=t-4.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,t-4⟩,\\,0\\le t\\le 2\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(t-4)j \\\\  & =i+\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{1}{x-y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{1}{t-(t-4))}=\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\frac{1}{4}\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =\\frac{\\sqrt{2}}{4}{\\int }_{0}^{2}\\,\\text{d}t \\\\  & =\\frac{\\sqrt{2}}{4}\\,t\\,{|}_{0}^{2} \\\\  & =\\frac{\\sqrt{2}}{4}(2-0) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fb0b4b-0bf1-5c76-8696-c067c4ad8969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186272604} {:answer/id #uuid "6347253c-9fd4-5926-94fe-94155ab5318b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{2}" :db/id #edb/ref 17592186273242} {:answer/id #uuid "722f7007-9e15-5b79-bcc7-366580ece601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186273367} {:answer/id #uuid "880d64e6-f8cb-55ff-8d8e-f7e554ac9ca4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\sqrt{3}" :db/id #edb/ref 17592186273554} {:answer/id #uuid "aa9c124b-193b-5381-9981-884d4b7bd866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186273862}] :answer-field/correct {:answer/id #uuid "722f7007-9e15-5b79-bcc7-366580ece601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186273367} :answer-field/id #uuid "e5e582ec-54ef-57eb-ade9-5e1ede765e24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d08529b-8573-5553-9a9b-ff64d66c71ec" :question/math-academy-id "q-15457" :question/problem "For the parametric curve \n\n$$\nx=\\operatorname{sin}⁡(2t),\\,y={cos}^{2}⁡(t),\\,0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{6}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2\\operatorname{cos}⁡(2t),\\,{y}^{′}(t)=-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t=-\\operatorname{sin}⁡(2t).\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{-\\operatorname{sin}⁡(2t)}{2\\operatorname{cos}⁡(2t)} \\\\  & =-\\frac{1}{2}\\operatorname{tan}⁡(2t).\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{6},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{1}{2}\\,\\operatorname{tan}⁡\\left(\\frac{2\\pi }{6}\\right) \\\\  & =-\\,\\frac{1}{2}\\,\\operatorname{tan}⁡\\left(\\frac{\\pi }{3}\\right) \\\\  & =-\\,\\frac{\\sqrt{3}}{2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346e81fc-49e8-5206-8118-642a76aff3bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{27e}}" :db/id #edb/ref 17592186272854} {:answer/id #uuid "848dbf29-ba73-58ac-a73a-39bdd77f8bdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{8e}{27}}" :db/id #edb/ref 17592186273525} {:answer/id #uuid "8ca28c54-4cd9-59d9-8637-13eeddcf1cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{9e}}{4}" :db/id #edb/ref 17592186273601} {:answer/id #uuid "9bf5f8f4-d801-50ab-a06f-979e93d31278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{9e}}" :db/id #edb/ref 17592186273740} {:answer/id #uuid "a64af6bb-9a4f-5bcd-ac79-4944cc823d29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{9}{8e}}" :db/id #edb/ref 17592186273827}] :answer-field/correct {:answer/id #uuid "346e81fc-49e8-5206-8118-642a76aff3bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{27e}}" :db/id #edb/ref 17592186272854} :answer-field/id #uuid "9a335fd5-65a0-5d78-ae55-0404e4850f92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274906}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2399836b-91ff-571b-9534-908c753b0355" :question/math-academy-id "q-15475" :question/problem "For the parametric curve \n\n$$\nx={e}^{1/t},\\,y=\\frac{1}{\\sqrt{{t}^{2}-1}},\\,1<t<\\infty ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=2.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=-\\frac{1}{{t}^{2}}{e}^{1/t},\\,{y}^{′}(t)=-\\frac{t}{({t}^{2}-1)^{3/2}}.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\left(-\\frac{t}{({t}^{2}-1)^{3/2}}\\right)}{(-\\frac{1}{{t}^{2}}{e}^{1/t})} \\\\  & =\\frac{{t}^{3}{e}^{-1/t}}{({t}^{2}-1)^{3/2}}.\\end{aligned}\n$$\n\nTherefore, when $t=2,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{2}^{3}{e}^{-1/2}}{({2}^{2}-1)^{3/2}} \\\\  & =\\frac{8}{{3}^{3/2}\\sqrt{e}} \\\\  & =\\frac{8}{\\sqrt{27e}}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6edb1b-f7b7-5718-8cda-0dd5a71a50be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\sqrt{\\frac{2}{3}}" :db/id #edb/ref 17592186272774} {:answer/id #uuid "2d253935-f522-5f06-9ee4-61b8bb0a1972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{\\frac{2}{3}}" :db/id #edb/ref 17592186272789} {:answer/id #uuid "2e13d3fc-0795-5608-98ad-09cff47ca45a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{\\sqrt{6}}" :db/id #edb/ref 17592186272799} {:answer/id #uuid "6a2e7d1f-a9f1-5d66-a415-8d8c4115d124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\sqrt{\\frac{3}{2}}" :db/id #edb/ref 17592186273303} {:answer/id #uuid "de45196d-d0c1-55a1-8019-f950885e3562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{\\frac{3}{2}}" :db/id #edb/ref 17592186274341}] :answer-field/correct {:answer/id #uuid "2b6edb1b-f7b7-5718-8cda-0dd5a71a50be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\sqrt{\\frac{2}{3}}" :db/id #edb/ref 17592186272774} :answer-field/id #uuid "f570cb94-97be-59e0-a398-fb3eb82d9321" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275067}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "18a41cc2-6786-5c7c-b54f-7a6c8dbb881f" :question/math-academy-id "q-15476" :question/problem "For the parametric curve \n\n$$\nx=\\sqrt{\\operatorname{sin}⁡({e}^{t})},\\,y=\\operatorname{cot}⁡({e}^{t}),\\,-\\infty <t<1,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\operatorname{ln}⁡\\left(\\frac{\\pi }{6}\\right).$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\frac{1}{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}}\\cdot \\operatorname{cos}⁡({e}^{t})\\cdot {e}^{t} \\\\  & =\\frac{{e}^{t}\\operatorname{cos}⁡({e}^{t})}{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}}, \\\\ {y}^{′}(t) & =-{e}^{t}{csc}^{2}⁡({e}^{t}).\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{-{e}^{t}{csc}^{2}⁡({e}^{t})}{\\left(\\frac{{e}^{t}\\operatorname{cos}⁡({e}^{t})}{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}}\\right)} \\\\  & =-\\,\\frac{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}}{{sin}^{2}⁡({e}^{t})\\operatorname{cos}⁡({e}^{t})} \\\\  & =-\\,\\frac{2}{{sin}^{3/2}⁡({e}^{t})\\operatorname{cos}⁡({e}^{t})}\\,.\\end{aligned}\n$$\n\nTherefore, when $t=\\operatorname{ln}⁡\\left(\\frac{\\pi }{6}\\right),$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{2}{{sin}^{3/2}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)} \\\\  & =-\\,\\frac{2}{{\\left(\\frac{1}{2}\\right)}^{3/2}\\left(\\frac{\\sqrt{3}}{2}\\right)} \\\\  & =-2\\cdot {2}^{3/2}\\,\\frac{2}{\\sqrt{3}} \\\\  & =-8\\sqrt{\\frac{2}{3}}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "072d7761-9781-53c7-9bbc-78084d322e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{9},\\,0)" :db/id #edb/ref 17592186272450} {:answer/id #uuid "3dffbfb9-f270-5fee-bafd-93e2af0b9661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3},\\,0)" :db/id #edb/ref 17592186272918} {:answer/id #uuid "5d3a5947-d436-56d5-880b-0465859f1964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{7},\\,0)" :db/id #edb/ref 17592186273188} {:answer/id #uuid "80184777-1859-51fd-907f-4bb3c159a4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{5},\\,0)" :db/id #edb/ref 17592186273486} {:answer/id #uuid "e955007e-17f7-5db4-9fbf-cecc47ec6559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{4},\\,0)" :db/id #edb/ref 17592186274451}] :answer-field/correct {:answer/id #uuid "3dffbfb9-f270-5fee-bafd-93e2af0b9661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3},\\,0)" :db/id #edb/ref 17592186272918} :answer-field/id #uuid "affbb4e4-fcfc-5f64-b6b5-e473fd4f7c9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274941}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "51cd744a-a0db-52ff-b937-07f4a84310d9" :question/math-academy-id "q-15564" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=\\operatorname{sin}⁡t+\\operatorname{cos}⁡t+\\frac{1}{3},\\,y=\\operatorname{cos}⁡t+1,\\,-\\infty <t<\\infty .\n$$\n\nLet $C$ be the point that corresponds to $t=\\frac{\\pi }{2}$ on the curve. Determine the point at which the tangent to the curve at $C$ crosses the $x$-axis." :question/worked-solution "First, we find the coordinates of the point $C$ by substituting $t=\\frac{\\pi }{2}$ into the parametric equations:\n\n$$\n\\begin{aligned}x & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+\\frac{1}{3}=1+0+\\frac{1}{3}=\\frac{4}{3}, \\\\ y & =\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+1=0+1=1\\,.\\end{aligned}\n$$\n\nSo we're looking to find the equation of the tangent line to the curve at the point $(\\frac{4}{3},1).$ \n\nTo find the equation of the tangent line, we need to find $\\frac{dy}{dx}.$ To compute it, we first need to find the derivatives of $x$ and $y,$ as follows:\n\n$$\n{x}^{′}(t)=\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,{y}^{′}(t)=-\\operatorname{sin}⁡t.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{y}^{′}(t)}{{x}^{′}(t)} \\\\  & =-\\operatorname{sin}⁡t\\left(\\frac{1}{\\operatorname{cos}⁡t-\\operatorname{sin}⁡t}\\right) \\\\  & =\\frac{\\operatorname{sin}⁡t}{\\operatorname{sin}⁡t-\\operatorname{cos}⁡t}\\,.\\end{aligned}\n$$\n\nAt the point where $t=\\frac{\\pi }{2},$ the slope of the tangent line is given by\n\n$$\n\\begin{aligned}m={\\frac{dy}{dx}|}_{t=\\pi /2} & =\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)} \\\\  & =\\frac{1}{1-0} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, to calculate the equation of the tangent line, we use point-slope form with the point $({x}_{1},{y}_{1})=(\\frac{4}{3},1)$ and the slope $m=1.$ We get\n\n$$\n\\begin{aligned}y-1 & =1\\cdot (x-\\frac{4}{3}).\\end{aligned}\n$$\n\nThe tangent crosses the $x$-axis when $y=0.$ At this point, we have\n\n$$\n\\begin{aligned}0-1 & =1\\cdot (x-\\frac{4}{3}) \\\\ -1 & =x-\\frac{4}{3} \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nConsequently, $(\\frac{1}{3},\\,0)$ is the $x$-intercept."}] [{:db/id #edb/ref 17592186275353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20505f6c-76c3-5503-9aa4-58967d3492b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5{x}^{2}+x+2,\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186272676} {:answer/id #uuid "80f54d66-49b1-5053-b817-7ebbba893a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{2}+10x-24,\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186273492} {:answer/id #uuid "be1b076f-fa12-524f-9aeb-e359af08e3c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{x}^{2}-5x-12,\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186274034} {:answer/id #uuid "db025224-4e97-5e03-8743-b73b379a2eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4{x}^{2}-2x+5,\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186274302} {:answer/id #uuid "e21deb99-1b3a-5d03-bd8b-47900ebde6d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}-10x+24,\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186274387}] :answer-field/correct {:answer/id #uuid "e21deb99-1b3a-5d03-bd8b-47900ebde6d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}-10x+24,\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186274387} :answer-field/id #uuid "1dcaa63f-4e24-5cd8-972a-532fc5338912" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "be482fdb-4246-5b2d-93fc-c680fd3bc2e4" :question/math-academy-id "q-15653" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=5-t,\\,\\,\\,y={t}^{2}-1,\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=5-t\\,⇒\\,t=5-x\\end{aligned}\n$$\n\nNow, substituting $t=5-x$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =(5-x)^{2}-1 \\\\  & =25-10x+{x}^{2}-1 \\\\  & ={x}^{2}-10x+24\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y={x}^{2}-10x+24.$\n\nFinally, since $t\\in (-\\infty ,\\infty )$ and $x=5-t,$ we must have $x\\in (-\\infty ,\\infty ).$\n\nSo, the complete Cartesian equation is\n\n$$\ny={x}^{2}-10x+24,\\,x\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186275354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20261641-fd84-5f77-86f9-34f0fa33a731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(3+{x}^{2}),\\,x\\ge 0" :db/id #edb/ref 17592186272674} {:answer/id #uuid "24a93e7a-6bb2-5462-9150-db02feafe760" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{x}^{2}(9-{x}^{2}),\\,x\\ge 0" :db/id #edb/ref 17592186272708} {:answer/id #uuid "43312442-bb1a-5f99-b317-fe4c73170b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x(9-{x}^{2}),\\,x\\ge 0" :db/id #edb/ref 17592186272963} {:answer/id #uuid "65eba75f-db0c-5c62-b886-977dc76e3ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}(9-{x}^{2}),\\,x\\ge 0" :db/id #edb/ref 17592186273260} {:answer/id #uuid "8180fde6-b73a-51b5-92cf-81508b0e34d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}(3+{x}^{2}),\\,x\\ge 0" :db/id #edb/ref 17592186273495}] :answer-field/correct {:answer/id #uuid "65eba75f-db0c-5c62-b886-977dc76e3ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}(9-{x}^{2}),\\,x\\ge 0" :db/id #edb/ref 17592186273260} :answer-field/id #uuid "5d6adaab-7830-564f-ac4c-cf11efa896cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274795}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48edb5ee-f8fa-5b2d-bf8e-0422cc536872" :question/math-academy-id "q-15654" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\sqrt{t},\\,\\,\\,y=t(9-t),\\,t\\ge 0.\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\sqrt{t}\\,⇒\\,t={x}^{2}\\end{aligned}\n$$\n\nNow, substituting $t={x}^{2}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & ={x}^{2}(9-{x}^{2})\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y={x}^{2}(9-{x}^{2}).$\n\nFinally, since $t\\ge 0$ and $x=\\sqrt{t},$ we must have $x\\ge 0.$\n\nSo, the complete Cartesian equation is\n\n$$\ny={x}^{2}(9-{x}^{2}),\\,x\\ge 0.\n$$"}] [{:db/id #edb/ref 17592186275355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43a576b4-dbc2-516f-9901-f746379954a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+{y}^{2}=1" :db/id #edb/ref 17592186272964} {:answer/id #uuid "7e316ea2-1019-55c9-a067-cecdfe63f010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+(y-3)^{2}=1" :db/id #edb/ref 17592186273467} {:answer/id #uuid "9e4cf287-d278-504a-b64e-8eeec0d74fac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+{y}^{2}=1" :db/id #edb/ref 17592186273751} {:answer/id #uuid "b89ab806-011e-5406-a808-5b128fde42c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=3" :db/id #edb/ref 17592186273987} {:answer/id #uuid "fb9cde1a-2675-5ec3-a089-6d7b9de7a6ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=3" :db/id #edb/ref 17592186274593}] :answer-field/correct {:answer/id #uuid "43a576b4-dbc2-516f-9901-f746379954a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+{y}^{2}=1" :db/id #edb/ref 17592186272964} :answer-field/id #uuid "cd871a7c-ba5a-5bd1-afa1-25df185701c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274993}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8fb649b-135a-5767-aa99-6984e334015e" :question/math-academy-id "q-15657" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t-3,\\,\\,\\,y=\\operatorname{cos}⁡t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{sin}⁡t-3\\, & ⇒\\,\\operatorname{sin}⁡t=x+3 \\\\ y=\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=y.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n(x+3)^{2}+{y}^{2}=1.\n$$\n\nSo the Cartesian equation of the given curve is $(x+3)^{2}+{y}^{2}=1.$"}] [{:db/id #edb/ref 17592186275366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d045052-a873-54a4-84e5-7bf4e6574118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3x}{1+2x},\\,x\\ne -\\frac{1}{2},\\,0" :db/id #edb/ref 17592186272644} {:answer/id #uuid "22c4e507-f7c6-5de7-b268-663b56128436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{1-x},\\,\\,x\\ne 0,\\,1" :db/id #edb/ref 17592186272694} {:answer/id #uuid "81222995-5d78-5bef-9adf-4e395c20b564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{1+x},\\,\\,x\\ne -1,\\,0" :db/id #edb/ref 17592186273494} {:answer/id #uuid "af021638-e540-5191-98d4-73961ba655c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{1-3x},\\,x\\ne 0,\\,\\frac{1}{3}" :db/id #edb/ref 17592186273899} {:answer/id #uuid "db25591c-9dfe-5ed2-9b3e-5d90e2274d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3x}{1-2x},\\,x\\ne 0,\\,\\frac{1}{2}" :db/id #edb/ref 17592186274304}] :answer-field/correct {:answer/id #uuid "af021638-e540-5191-98d4-73961ba655c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{1-3x},\\,x\\ne 0,\\,\\frac{1}{3}" :db/id #edb/ref 17592186273899} :answer-field/id #uuid "5ae43d0f-3f4e-5d8a-ae9f-f9aea258ba0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274789}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d29a5f16-5e4f-594a-98bd-3d918fb3b468" :question/math-academy-id "q-15677" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{1}{t+1},\\,\\,\\,y=\\frac{1}{t-2},\\,t\\ne -1,\\,2.\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{1}{t+1}\\,⇒\\,t=\\frac{1}{x}-1\\end{aligned}\n$$\n\nNow substituting $t=\\frac{1}{x}-1$ into our expression for $y$, we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{((\\frac{1}{x}-1)-2)} \\\\ y & =\\frac{1}{(\\frac{1}{x}-3)} \\\\ y & =\\frac{1}{\\left(\\frac{1-3x}{x}\\right)} \\\\ y & =\\frac{x}{1-3x}\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=\\frac{x}{1-3x}.$\n\nFinally, since $t\\ne -1,\\,2$ and $x=\\frac{1}{t+1},$ we must have $x\\ne 0,\\,\\frac{1}{3}.$\n\nSo, the complete Cartesian equation is\n\n$$\ny=\\frac{x}{1-3x},\\,x\\ne 0,\\,\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186275367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31312107-5d20-5059-be6e-aeb601b77635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-3)^{2}+{x}^{2}=1" :db/id #edb/ref 17592186272827} {:answer/id #uuid "57a8e77f-308a-55ad-9d7f-77cf10ab871b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2)^{2}+(x-3)^{2}=1" :db/id #edb/ref 17592186273139} {:answer/id #uuid "a651a81a-956c-5cd0-8505-74bb046a9688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-3)^{2}+(x+2)^{2}=1" :db/id #edb/ref 17592186273828} {:answer/id #uuid "bdba81d4-1945-5f2a-9580-c45dbea81055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3)^{2}+(x+2)^{2}=3" :db/id #edb/ref 17592186274030} {:answer/id #uuid "c0d63d29-beab-5500-ba21-73963177aaa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(x+3)^{2}=3" :db/id #edb/ref 17592186274059}] :answer-field/correct {:answer/id #uuid "a651a81a-956c-5cd0-8505-74bb046a9688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-3)^{2}+(x+2)^{2}=1" :db/id #edb/ref 17592186273828} :answer-field/id #uuid "eaeb2b7a-6391-5362-aa64-8478d2f2bdb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0840b2f-51f6-58d5-a7a1-bacf7531f834" :question/math-academy-id "q-15679" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{cos}⁡t-2,\\,\\,\\,y=\\operatorname{sin}⁡t+3,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{cos}⁡t-2\\, & ⇒\\,\\operatorname{cos}⁡t=x+2 \\\\ y=\\operatorname{sin}⁡t+3\\, & ⇒\\,\\operatorname{sin}⁡t=y-3.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1,$ we get\n\n$$\n(y-3)^{2}+(x+2)^{2}=1.\n$$\n\nSo the Cartesian equation of the given curve is $(y-3)^{2}+(x+2)^{2}=1.$"}] [{:db/id #edb/ref 17592186275401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0469c29d-f1ef-59a5-bfcc-782cc2ba60f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{4x}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186272424} {:answer/id #uuid "40ca55ef-caec-5749-8663-28bf0fb87145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{\\sqrt{{x}^{2}-4}}" :db/id #edb/ref 17592186272938} {:answer/id #uuid "482fbc33-6330-5256-b98a-c29f3b150952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2x}{\\sqrt{2+{x}^{2}}}" :db/id #edb/ref 17592186273002} {:answer/id #uuid "a5890c75-2ab4-532e-8278-1e895d973fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186273820} {:answer/id #uuid "fc42ea52-aaff-5a03-877a-cb2a40083453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2x}{\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186274603}] :answer-field/correct {:answer/id #uuid "a5890c75-2ab4-532e-8278-1e895d973fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186273820} :answer-field/id #uuid "8749f9b8-216b-5df1-b8f7-c2d19f3cb2f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "051f821d-0a77-5a88-85da-69a3ef815c14" :question/math-academy-id "q-15759" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t,\\,\\,\\,y=\\operatorname{tan}⁡t,\\,0<t<\\frac{\\pi }{2}.\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=x \\\\ y=\\operatorname{tan}⁡t\\, & ⇒\\,\\operatorname{tan}⁡t=y\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡t+{cos}^{2}⁡t & =1 \\\\ {cos}^{2}⁡t & =1-{sin}^{2}⁡t \\\\ \\operatorname{cos}⁡t & =\\sqrt{1-{sin}^{2}⁡t}.\\end{aligned}\n$$\n\nWe used here that $\\operatorname{cos}⁡t>0$ in the range $0<t<\\frac{\\pi }{2}.$\n\nNow, using the definition of a tangent, we obtain\n\n$$\n\\operatorname{tan}⁡t=\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}=\\frac{\\operatorname{sin}⁡t}{\\sqrt{1-{sin}^{2}⁡t}}.\n$$\n\nSubstituting $\\operatorname{sin}⁡t=x$ and $\\operatorname{tan}⁡t=y$ into this formula, we get\n\n$$\ny=\\frac{x}{\\sqrt{1-{x}^{2}}}.\n$$\n\nSo the Cartesian equation of the given curve is $y=\\frac{x}{\\sqrt{1-{x}^{2}}}.$"}] [{:db/id #edb/ref 17592186275402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acb48e3-a0f4-5f8b-bbb7-6c9d4783161d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=1+{x}^{2}" :db/id #edb/ref 17592186272487} {:answer/id #uuid "4cdf6eeb-a167-56f0-9f69-2fe01b7a765d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=1-{\\left(\\frac{x}{3}\\right)}^{2}" :db/id #edb/ref 17592186273034} {:answer/id #uuid "527417b5-ca09-55bd-8cef-9f36a0172b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=1-3{x}^{2}" :db/id #edb/ref 17592186273087} {:answer/id #uuid "7245d2d7-07cf-5143-a442-4a776b066122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=1+{\\left(\\frac{x}{3}\\right)}^{2}" :db/id #edb/ref 17592186273369} {:answer/id #uuid "dae312dd-cd12-5ee0-b6ac-2fb17d244ef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=1+{\\left(\\frac{x}{2}\\right)}^{2}" :db/id #edb/ref 17592186274300}] :answer-field/correct {:answer/id #uuid "7245d2d7-07cf-5143-a442-4a776b066122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=1+{\\left(\\frac{x}{3}\\right)}^{2}" :db/id #edb/ref 17592186273369} :answer-field/id #uuid "9b4cd8be-3670-5350-989d-e79c6c272026" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274907}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3486395c-c23b-50d0-ac86-019f33fdad15" :question/math-academy-id "q-15761" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=3\\operatorname{cot}⁡t,\\,\\,\\,y=\\operatorname{csc}⁡t,\\,t\\in (0,\\frac{\\pi }{2}).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=3\\operatorname{cot}⁡t\\, & ⇒\\,\\operatorname{cot}⁡t=\\frac{x}{3} \\\\ y=\\operatorname{csc}⁡t\\, & ⇒\\,\\operatorname{csc}⁡t=y.\\end{aligned}\n$$\n\nDividing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$ by ${sin}^{2}⁡t$, we get\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡t}{{sin}^{2}⁡t}+\\frac{{cos}^{2}⁡t}{{sin}^{2}⁡t} & =\\frac{1}{{sin}^{2}⁡t} \\\\ 1+{\\left(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}\\right)}^{2} & ={\\left(\\frac{1}{\\operatorname{sin}⁡t}\\right)}^{2} \\\\ 1+{cot}^{2}⁡t & ={csc}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cot}⁡t=\\frac{x}{3}$ and $\\operatorname{csc}⁡t=y$ into this formula, we get\n\n$$\n\\begin{aligned}1+{\\left(\\frac{x}{3}\\right)}^{2}={y}^{2}.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is ${y}^{2}=1+{\\left(\\frac{x}{3}\\right)}^{2}.$"}] [{:db/id #edb/ref 17592186275404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ba1d767-a5eb-570e-83d3-118be64e32a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=4" :db/id #edb/ref 17592186273447} {:answer/id #uuid "dc0ba066-dba6-518e-800f-bc01062cfe89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=\\sqrt{2}" :db/id #edb/ref 17592186274319} {:answer/id #uuid "df8ba9fa-4cfe-5b42-8b8c-710472617b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=8" :db/id #edb/ref 17592186274361} {:answer/id #uuid "e18d5d4d-6070-502f-bc7c-e09775e0034f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=2" :db/id #edb/ref 17592186274378} {:answer/id #uuid "ed64d68f-de54-52ff-b004-27654116e004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=16" :db/id #edb/ref 17592186274487}] :answer-field/correct {:answer/id #uuid "7ba1d767-a5eb-570e-83d3-118be64e32a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=4" :db/id #edb/ref 17592186273447} :answer-field/id #uuid "f98238ed-0fcb-5faf-a467-c183d1b64324" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275077}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2463b954-08db-52f2-9a44-620e52671ff5" :question/math-academy-id "q-15793" :question/problem "Determine the Cartesian equation of the circle\n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =2\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & =(2\\operatorname{cos}⁡\\theta )^{2} \\\\  & =4{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =2\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & =(2\\operatorname{sin}⁡\\theta )^{2} \\\\  & =4{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =4{cos}^{2}⁡\\theta +4{sin}^{2}⁡\\theta  \\\\  & =4({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =4(1) \\\\  & =4.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=4.$"}] [{:db/id #edb/ref 17592186275413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029afac2-d18a-5848-88fa-40be2073bd40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{5}\\operatorname{sin}⁡\\theta ,\\,y=\\sqrt{5}\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186272406} {:answer/id #uuid "7e23d239-5c73-5bd0-93bf-4aa63a11950b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=25\\operatorname{sin}⁡\\theta ,\\,y=25\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186273465} {:answer/id #uuid "9cbc6334-62cf-51a0-a815-9d1ecd63831c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=10\\operatorname{sin}⁡\\theta ,\\,y=10\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186273745} {:answer/id #uuid "eed9cf94-b670-50ac-a2e4-885558753fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2.5\\operatorname{sin}⁡\\theta ,\\,y=2.5\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186274500} {:answer/id #uuid "fc71e695-d170-597f-becc-d0bb93ff675a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186274607}] :answer-field/correct {:answer/id #uuid "fc71e695-d170-597f-becc-d0bb93ff675a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186274607} :answer-field/id #uuid "b1a4325d-8a77-5770-8c7d-4de85a5a9ab9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274943}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "048b125a-395b-5d91-91ff-6c54e7560b89" :question/math-academy-id "q-15802" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $5$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=5.$ Therefore, the parametric equations of the circle are \n\n$$\nx=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186278192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14ac3088-b004-5942-a759-305e66bd829a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=\\frac{1}{4}" :db/id #edb/ref 17592186275671} {:answer/id #uuid "6de4ee6e-8cf1-5e32-9477-62eec85dc8e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y-1)^{2}=\\frac{1}{2}" :db/id #edb/ref 17592186276459} {:answer/id #uuid "84c9d846-ee11-5df6-b4f3-ad301f646c61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=\\frac{1}{2}" :db/id #edb/ref 17592186276667} {:answer/id #uuid "a2132d3d-04bc-511e-8fa8-498a58febd95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y+2)^{2}=\\frac{1}{4}" :db/id #edb/ref 17592186276936} {:answer/id #uuid "e7431f1c-0e17-521f-8eb7-8db114d02b28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y+1)^{2}=2" :db/id #edb/ref 17592186277497}] :answer-field/correct {:answer/id #uuid "14ac3088-b004-5942-a759-305e66bd829a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=\\frac{1}{4}" :db/id #edb/ref 17592186275671} :answer-field/id #uuid "fb6ca943-4b04-5351-9712-89b82d0fb09b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278169}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aceee4b9-7657-5a9b-99d8-00f2a88fd80d" :question/math-academy-id "q-15845" :question/problem "Determine the Cartesian equation of the circle\n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta +1,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta +2,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x-1 & =\\frac{1}{2}\\operatorname{cos}⁡\\theta  \\\\ 2(x-1) & =\\operatorname{cos}⁡\\theta  \\\\ 4(x-1)^{2} & ={cos}^{2}⁡\\theta \\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y-2 & =\\frac{1}{2}\\operatorname{sin}⁡\\theta  \\\\ 2(y-2) & ={sin}^{2}⁡\\theta  \\\\ 4(y-2)^{2} & ={sin}^{2}⁡\\theta \\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}4(x-1)^{2}+4(y-2)^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ 4(x-1)^{2}+4(y-2)^{2} & =1 \\\\ (x-1)^{2}+(y-2)^{2} & =\\frac{1}{4}\\end{aligned}\n$$\n\nHence the Cartesian equation of the circle is $(x-1)^{2}+(y-2)^{2}=\\frac{1}{4}.$"}] [{:db/id #edb/ref 17592186278358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d298631-2765-5ac2-b97f-679ad8916a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{2}{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276009} {:answer/id #uuid "40abc3c2-e544-59b8-9c14-f0e4a01c790c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{4}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276041} {:answer/id #uuid "97eed52a-8abb-5db8-9604-798e79ac4216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{4}r{e}^{r}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276843} {:answer/id #uuid "9c39af7e-789b-5aed-9430-612b825a204f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{4}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276878} {:answer/id #uuid "b24b07d6-5486-598f-99db-263fe3587090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{2}{r}^{2}{e}^{r}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186277074}] :answer-field/correct {:answer/id #uuid "9c39af7e-789b-5aed-9430-612b825a204f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{4}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276878} :answer-field/id #uuid "4fde4879-96cb-5c11-ab63-d504fc117051" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277857}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ebe3923c-2578-5c4c-8b9f-d97199b48c08" :question/math-academy-id "q-161038" :question/problem "![](images/aa/aa5b04b98d3796656fca912d8dc1732ea7e12bab9083f8ca543ad5fd4fdb10ff.png)\n\nThe region $D$ is the quarter-circle shown above. What is $$\n\\displaystyle {∬}_{D}{e}^{{x}^{2}+{y}^{2}}\\,\\text{d}A\n$$ expressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }dr\\,d\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $4$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 4,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}{e}^{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{4}r{e}^{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{4}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "386528aa-7c36-5737-95bd-6ec28d6f21f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186275976} {:answer/id #uuid "49aae471-6334-5b21-a65c-5f8c10050325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{4}{r}^{2}\\operatorname{cos}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276128} {:answer/id #uuid "55731809-fff3-5c19-92fe-0dfc9e836434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{r}^{3}\\operatorname{cos}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276236} {:answer/id #uuid "baa1523e-3758-588f-a054-6103cf0c3a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}\\operatorname{cos}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186277133} {:answer/id #uuid "f26af378-506e-5ab0-a93f-58cf9b6e8e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186277604}] :answer-field/correct {:answer/id #uuid "baa1523e-3758-588f-a054-6103cf0c3a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}\\operatorname{cos}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186277133} :answer-field/id #uuid "6062c7cf-9d19-5d6e-882f-d009a41987c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277895}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e368e6ad-9cc6-5a3e-aa55-7ffed535a21a" :question/math-academy-id "q-161039" :question/problem "![](images/cd/cdd5f0c58228b47a0bbba77daf2b426ce0247e71259e2b5af1a4a80fa833a036.png)\n\nThe region $D$ is the circle shown above. What is $$\n\\displaystyle {∬}_{D}({x}^{2}-{y}^{2})\\,\\text{d}A\n$$ expressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\,dr\\,d\\theta .\n$$\n\nFirst, notice that the region $D$ represents the disk of radius $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}-{y}^{2})\\,\\text{d}A & ={∬}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}-(r\\operatorname{sin}⁡\\theta )^{2})r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}\\operatorname{cos}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a78120fd-44f8-51c1-b9dd-5784c7ddde90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186276989} {:answer/id #uuid "bbf96883-ff35-5cf9-b8c9-ef1449820eff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186277149} {:answer/id #uuid "c3b7cf35-e4e8-5645-988c-d9decc7eb447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277218} {:answer/id #uuid "d256a689-9115-5115-b8cc-dca87fe713d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186277332} {:answer/id #uuid "f1b78b6c-d3db-508c-85cc-e0ca239ccf20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277598}] :answer-field/correct {:answer/id #uuid "c3b7cf35-e4e8-5645-988c-d9decc7eb447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277218} :answer-field/id #uuid "2939712c-1519-5b89-99ce-fbfcd86f2f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277793}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aff73867-9b1f-5562-9960-420de4061c93" :question/math-academy-id "q-161049" :question/problem "Evaluate \n$$\n\\displaystyle {\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡\\theta }3r\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$" :question/worked-solution "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡\\theta }3r\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {\\int }_{0}^{\\operatorname{cos}⁡\\theta }r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,{[\\frac{{r}^{2}}{2}]}_{0}^{\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,(\\frac{{cos}^{2}⁡\\theta }{2}-0)\\,\\text{d}\\theta  \\\\  & =\\frac{3}{2}{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}\\frac{3}{2}{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\,\\text{d}\\theta  & =\\frac{3}{2}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta (1-{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{3}{2}{[\\operatorname{sin}⁡\\theta -\\frac{{sin}^{3}⁡\\theta }{3}]}_{0}^{\\pi /2} \\\\  & =\\frac{3}{2}[(\\operatorname{sin}⁡\\frac{\\pi }{2}-\\frac{1}{3}{sin}^{3}⁡\\frac{\\pi }{2})-(\\operatorname{sin}⁡0-\\frac{1}{3}{sin}^{3}⁡0)] \\\\  & =\\frac{3}{2}[(1-\\frac{1}{3})-0] \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e776117-b2c8-5c7a-9d16-751f765be404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275599} {:answer/id #uuid "4f9d1ae7-f6c6-570b-9ced-645ab8a2169a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276190} {:answer/id #uuid "7c016cad-a688-555e-9bb3-a399d13f0149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276608} {:answer/id #uuid "9a2b4cc3-f053-5ed5-b9d6-7f1939263729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276859} {:answer/id #uuid "faf68c35-0933-5c2f-838a-cc6c8b57001f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277676}] :answer-field/correct {:answer/id #uuid "faf68c35-0933-5c2f-838a-cc6c8b57001f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277676} :answer-field/id #uuid "0c7f3a1e-076c-5684-8e63-15c2040c9f43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277749}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9fa6b6f5-4249-530e-aeb1-5511d96e1746" :question/math-academy-id "q-161050" :question/problem "Integrate the function $f(x,y)=15{x}^{2}y$ over the disk of radius $1$ centered at the origin." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/9b/9b54b7a488a1983ba1816fdf5c55e039951eb417102c61963977b2f48b9c8d9e.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}12{x}^{2}y\\,\\text{d}A & ={∬}_{Δ}15({r}^{2}{cos}^{2}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}15{r}^{4}({cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta ){\\int }_{0}^{1}5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )\\,{[{r}^{5}]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )(1-0)\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =[-{cos}^{3}⁡\\theta ]_{0}^{2\\pi } \\\\  & =-({cos}^{3}⁡(2\\pi )-{cos}^{3}⁡(0)) \\\\  & =-(1-1) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad79092-f016-53f7-a552-da7705b0e553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+4\\pi " :db/id #edb/ref 17592186275728} {:answer/id #uuid "7636b055-40d1-5da4-992b-6cf4130c550f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\pi " :db/id #edb/ref 17592186276544} {:answer/id #uuid "bed5cbac-2b75-59e8-bf61-95fb98959df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81\\pi " :db/id #edb/ref 17592186277178} {:answer/id #uuid "ddd67c0a-3dac-561a-8db6-3731e772cb7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18+2\\pi " :db/id #edb/ref 17592186277422} {:answer/id #uuid "f22075cf-3f26-53dc-89c2-6eefbee0d8bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27\\pi " :db/id #edb/ref 17592186277603}] :answer-field/correct {:answer/id #uuid "bed5cbac-2b75-59e8-bf61-95fb98959df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81\\pi " :db/id #edb/ref 17592186277178} :answer-field/id #uuid "f825344c-a3e7-5d9c-a7f6-4fa9aa047ca6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278162}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad9dc383-588b-5128-942d-8b56b5fb2221" :question/math-academy-id "q-161052" :question/problem "Integrate the function $f(x,y)=4{y}^{2}$ over the disk of radius $3$ centered at the origin." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/0a/0a1de805051eff4ea82b4eefb7bb113c724b3d4e7304704831b6294ee4e4d674.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}4{y}^{2}\\,\\text{d}A & ={∬}_{Δ}4(r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}4{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta {\\int }_{0}^{3}4{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,{[{r}^{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta (81-0)\\text{d}\\theta  \\\\  & =81{\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =81{\\int }_{0}^{2\\pi }\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{81}{2}{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{0}^{2\\pi } \\\\  & =\\frac{81}{2}[(2\\pi -0)-\\frac{1}{2}(\\operatorname{sin}⁡4\\pi -\\operatorname{sin}⁡0)] \\\\  & =\\frac{81}{2}\\cdot 2\\pi  \\\\  & =81\\pi .\\end{aligned}\n$$"}]}
