}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =({t}^{5}\\hspace{0.167em}\\mathbf{i}+{t}^{4}\\hspace{0.167em}\\mathbf{j}+{t}^{3}\\hspace{0.167em}\\mathbf{k})\\cdot (\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}+3{t}^{2}\\hspace{0.167em}\\mathbf{k}) \\\\  & ={t}^{5}+2{t}^{5}+3{t}^{5} \\\\  & =6{t}^{5}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{1}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}6{t}^{5}\\hspace{0.167em}\\mathrm{d}t \\\\  & ={{t}^{6}|}_{0}^{1} \\\\  & =1\\end{aligned}\n$$"] [17592186134089 "The field has potential $\\phi=(x^2+y^2+z^2)/2$. At the initial point, $\\phi=1/2$; at $t=\\pi$, $\\phi=(1+4\\pi)/2$. Hence $$\\int_C F\\cdot dr=\\phi(r(\\pi))-\\phi(r(0))=2\\pi.$$ Equivalently $F(r(t))\\cdot r'(t)=2$ for $t>0$; its integral has the same finite limit at $t=0$."] [17592186134090 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}-x\\hspace{0.167em}\\mathbf{j} \\\\  & =\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\mathbf{j} \\\\  & =-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j})\\cdot (-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}) \\\\  & =-{\\operatorname{sin}}^{2}t-{\\operatorname{cos}}^{2}t \\\\  & =-1.\\end{aligned}\n$$\n\nFinally, we can write the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{\\pi }\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & =-{\\int }_{0}^{\\pi }\\mathrm{d}t\\end{aligned}\n$$"] [17592186134091 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=\\operatorname{ln}⁡t,\\,y=t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & ={e}^{x}\\hspace{0.167em}\\mathbf{i}+2y\\hspace{0.167em}\\mathbf{j} \\\\  & ={e}^{\\operatorname{ln}t}\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j} \\\\  & =t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{j} \\\\  & =\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}) \\\\  & =1+2t.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{1}^{2}\\mathbf{f}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{1}^{2}1+2t\\hspace{0.167em}\\mathrm{d}t \\\\  & ={[t+{t}^{2}]}_{1}^{2} \\\\  & =[2+4-(1+1)] \\\\  & =4\\end{aligned}\n$$"] [17592186134212 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=3t,\\,y=2+t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & ={x}^{2}y\\hspace{0.167em}\\mathbf{i}+(x+1)\\hspace{0.167em}\\mathbf{j} \\\\  & =(3t)^{2}(2+t)\\hspace{0.167em}\\mathbf{i}+(3t+1)\\hspace{0.167em}\\mathbf{j} \\\\  & =9{t}^{2}(2+t)\\hspace{0.167em}\\mathbf{i}+(3t+1)\\hspace{0.167em}\\mathbf{j} \\\\  & =(18{t}^{2}+9{t}^{3})\\hspace{0.167em}\\mathbf{i}+(3t+1)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(2+t)\\mathbf{j} \\\\  & =3\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =((18{t}^{2}+9{t}^{3})\\hspace{0.167em}\\mathbf{i}+(3t+1)\\hspace{0.167em}\\mathbf{j})\\cdot (3\\hspace{0.167em}\\mathbf{i}+\\mathbf{j}) \\\\  & =54{t}^{2}+27{t}^{3}+3t+1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{1}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}54{t}^{2}+27{t}^{3}+3t+1\\hspace{0.167em}\\mathrm{d}t \\\\  & ={[18{t}^{3}+\\frac{27}{4}{t}^{4}+\\frac{3}{2}{t}^{2}+t]}_{0}^{1} \\\\  & =(18+\\frac{27}{4}+\\frac{3}{2}+1)-0 \\\\  & =\\frac{109}{4}\\end{aligned}\n$$"] [17592186134276 "Since $\\mathbf{r}(t)=⟨{t}^{2}+t,\\hspace{0.167em}{t}^{2}-t⟩,$ then along the curve we have $x={t}^{2}+t,$ and $y={t}^{2}-t.$ \n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\mathbf{j} \\\\  & =(2t+1)\\hspace{0.167em}\\mathbf{i}+(2t-1)\\hspace{0.167em}\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2t+1)^{2}+(2t-1)^{2}} \\\\  & =\\sqrt{4{t}^{2}+4t+1+4{t}^{2}-4t+1} \\\\  & =\\sqrt{8{t}^{2}+2} \\\\  & =\\sqrt{2}\\sqrt{4{t}^{2}+1}\\end{aligned}\n$$\n\n \n\nNow, since $f(x,y)=\\sqrt{2}(x-y)$, we obtain \n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =\\sqrt{2}[({t}^{2}+t)-({t}^{2}-t)] \\\\  & =2\\sqrt{2}t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{0}^{\\sqrt{2}}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{2}}2\\sqrt{2}t\\cdot \\sqrt{2}\\sqrt{4{t}^{2}+1}\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{\\sqrt{2}}t\\sqrt{4{t}^{2}+1}\\hspace{0.167em}\\text{d}t.\\end{aligned}\n$$"] [17592186134277 "For a scalar line integral, substitute the parametrization and multiply by speed. Here $r'(t)=\\langle2\\sqrt t,t-1\\rangle$, so $\\|r'(t)\\|=\\sqrt{4t+(t-1)^2}=t+1$ on $[0,1]$. Also $3x=4t^{3/2}$. Thus $$\\int_C3x\\,ds=4\\int_0^1(t^{5/2}+t^{3/2})\\,dt=4\\left(\\frac27+\\frac25\\right)=\\frac{96}{35}.$$"] [17592186134338 "Differentiating gives $r'(t)=3t\\langle\\cos t,\\sin t\\rangle$, so the speed is $3t$ on $[0,2\\pi]$. Also $x^2+y^2=9(1+t^2)$. Hence $$\\int_C(x^2+y^2)\\,ds=27\\int_0^{2\\pi}(t+t^3)\\,dt=54\\pi^2+108\\pi^4=54\\pi^2(1+2\\pi^2).$$"] [17592186134511 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s={\\int }_{a}^{b}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t.\n$$\n\n \n\nSince $\\mathbf{r}(t)={t}^{2}\\hspace{0.167em}\\mathbf{i}+(t+1)\\hspace{0.167em}\\mathbf{j}$, then along the curve we have $x={t}^{2}$ and $y=t+1.$\n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t+1)\\hspace{0.167em}\\mathbf{j} \\\\  & =2t\\hspace{0.167em}\\mathbf{i}+\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2t)^{2}+{1}^{2}} \\\\  & =\\sqrt{4{t}^{2}+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{12x}{y-1}$, we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =\\frac{12{t}^{2}}{(t+1)-1} \\\\  & =\\frac{12{t}^{2}}{t} \\\\  & =12t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{\\sqrt{2}}^{\\sqrt{6}}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{\\sqrt{6}}12t\\sqrt{4{t}^{2}+1}\\hspace{0.167em}\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4{t}^{2}+1,$ $\\text{d}u=8t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{\\sqrt{6}}12t\\sqrt{4{t}^{2}+1}\\,\\text{d}t & ={\\int }_{9}^{25}\\frac{3}{2}{u}^{1/2}\\text{d}u \\\\  & ={u}^{3/2}{|}_{9}^{25} \\\\  & ={25}^{3/2}-{9}^{3/2} \\\\  & =125-27 \\\\  & =98\\end{aligned}\n$$"] [17592186134512 "Here $x=t$, $y=\\sin t$, and $z=1$. The speed is $\\sqrt{1+\\cos^2t}$. Thus $$\\int_C4yz\\cos x\\,ds=\\int_0^{\\pi/2}4\\sin t\\cos t\\sqrt{1+\\cos^2t}\\,dt.$$ Set $u=1+\\cos^2t$, so $du=-2\\sin t\\cos t\\,dt$. The integral becomes $$2\\int_1^2u^{1/2}\\,du=\\frac43(2\\sqrt2-1).$$ The omitted endpoints have finite limits and do not change this value."] [17592186134513 "Substitute $x=2t$, $y=2-t$ to get $x^3-y=8t^3+t-2$. The speed is $\\sqrt{2^2+(-1)^2}=\\sqrt5$. Therefore $$\\int_C(x^3-y)\\,ds=\\sqrt5\\int_{-1}^{2}(8t^3+t-2)\\,dt.$$"] [17592186152425 "Acceleration is $a(t)=v'(t)=4-6t$. At $t=2$, $a=-8\\,\\mathrm{m/s^2}$. Newton's second law gives $F=2(-8)=-16\\,\\mathrm N$, so the requested magnitude is $16\\,\\mathrm N$."] [17592186152426 "Acceleration is $v'(t)=3t^2-2e^t$. Multiply by the mass $5\\,\\mathrm{kg}$: $$F(t)=5(3t^2-2e^t)=15t^2-10e^t,$$ measured in newtons."] [17592186152428 "Differentiate position twice: $s'(t)=t^{-1/2}$ and $s''(t)=-\\tfrac12t^{-3/2}$. Thus $F(t)=8s''(t)=-4t^{-3/2}\\,\\mathrm N$. At $t=4$, the force is $-1/2\\,\\mathrm N$, whose magnitude is $1/2\\,\\mathrm N$."] [17592186162326 "A scalar line integral with respect to arc length is unchanged by reversing orientation, so statement II is true and statement I is false. Also $r_2(u)=r_1(2u)$ for $0\\le u\\le\\tfrac12$, which traverses the same curve once. Its scalar line integral is $2$, rather than $4$. Thus only II must be true."] [17592186162328 "The integral of $1$ with respect to arc length is the length of $C$. The diagram shows a quarter-circle arc of radius $2$ and its straight chord. The arc length is $2(\\pi/2)=\\pi$, and the chord length is $\\sqrt{2^2+2^2}=2\\sqrt2$. Hence $$\\int_C ds=\\pi+2\\sqrt2.$$"] [17592186162329 "The integral of $1$ with respect to arc length is the length of the curve. A semicircle of radius $3$ has length half of $2\\pi(3)$, so $$\\int_C ds=3\\pi.$$"] [17592186162330 "Scalar line integrals are independent of orientation, so I holds. Set $t=2\\theta$; as $\\theta$ runs from $0$ to $\\pi$, $t$ runs from $0$ to $2\\pi$. Both parametrizations therefore traverse the same circle once, giving the same integral $k$. Thus II holds. III does not hold for arbitrary $k$, so the statements that must be true are I and II."] [17592186167091 "The diagram is the circle $x^2+y^2=4$. Differentiating gives $2x+2yy'=0$, so $$\\frac{dy}{dx}=-\\frac{x}{y}$$ for $y\\ne0$."] [17592186167092 "The diagram gives center $(1,-1)$ and radius $3$, so $(x-1)^2+(y+1)^2=9$. Differentiating gives $2(x-1)+2(y+1)y'=0$. Therefore $$\\frac{dy}{dx}=-\\frac{x-1}{y+1}$$ for $y\\ne-1$."] [17592186167093 "The ellipse has horizontal and vertical semiaxes $3$ and $2$, so its equation is $x^2/9+y^2/4=1$. Differentiating yields $2x/9+yy'/2=0$, hence $$\\frac{dy}{dx}=-\\frac{4x}{9y}$$ for $y\\ne0$."] [17592186167095 "The right-opening parabola has vertex $(0,0)$ and passes through $(1,2)$. Its equation is $y^2=4x$. Differentiate to obtain $2yy'=4$, so $$\\frac{dy}{dx}=\\frac2y$$ for $y\\ne0$."] [17592186175820 "Recall that the ellipse $\\dfrac{x^2}{4}+\\dfrac{y^2}{16}=1$ in $xy$-plane has the parametrization\n\n$$\n\\langle x,y \\rangle = \\big\\langle 2\\cos{t}, \\: 4\\sin{t} \\big\\rangle,\n\\qquad t \\in [0,2\\pi),\n$$\n\nsince \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16} & =\\frac{(2\\operatorname{cos}⁡t)^{2}}{4}+\\frac{(4\\operatorname{sin}⁡t)^{2}}{16} \\\\  & =\\frac{4{cos}^{2}⁡t}{4}+\\frac{16{sin}^{2}⁡t}{16} \\\\  & ={cos}^{2}⁡t+{sin}^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,z) & =⟨x,y,z⟩ \\\\  & =⟨{\\color{blue}2\\operatorname{cos}t},\\hspace{0.222em}4\\operatorname{sin}t,\\hspace{0.222em}z⟩\\end{aligned}\n$$\n\nwhere $t \\in [0,2\\pi)$ and $z \\in (-\\infty,\\infty).$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{blue}2\\cos{t}}.$"] [17592186175822 "For any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(x,y) & =⟨x,y,z⟩ \\\\  & =⟨x,\\hspace{0.222em}y,\\hspace{0.222em}{\\color{blue}2{x}^{2}}⟩\\end{aligned}\n$$\n\nwhere $x \\in (-\\infty,\\infty)$ and $y \\in (-\\infty,\\infty).$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue} 2x^2}.$"] [17592186175823 "Recall that the hyperbola $\\dfrac{z^2}{4} - \\dfrac{x^2}{16} = 1$ for $z \\geq 2$ in $xz$-plane has the parametrization\n\n$$\n\\langle x , z \\rangle = \\big \\langle 4\\tan{t}, \\, 2\\sec{t} \\big\\rangle,\n\n\\qquad t \\in \\left(-\\dfrac{\\pi}{2},\\dfrac{\\pi}{2}\\right)\n$$\n\nsince \n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{4}-\\frac{{x}^{2}}{16} & =\\frac{(2\\operatorname{sec}⁡t)^{2}}{4}-\\frac{(4\\operatorname{tan}⁡t)^{2}}{16} \\\\  & =\\frac{4{sec}^{2}⁡t}{4}-\\frac{16{tan}^{2}⁡t}{16} \\\\  & ={sec}^{2}⁡t-{tan}^{2}⁡t \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}\\mathbf{f}(t,y) & =⟨x,y,z⟩ \\\\  & =⟨4\\operatorname{tan}t,\\hspace{0.167em}y,\\hspace{0.167em}{\\color{blue}2\\operatorname{sec}t}⟩\\end{aligned}\n$$\n\nwhere $$\n\\displaystyle t \\in \\left(-\\dfrac{\\pi}{2}, \\dfrac{\\pi}{2}\\right)\n$$ and $y \\in (-\\infty, \\infty).$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue}2\\sec{t}}.$"]}
