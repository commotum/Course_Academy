hbf{j}+\\frac{∂}{∂z}({x}^{4}-{y}^{4}-\\operatorname{cos}z)\\hspace{0.167em}\\mathbf{k} \\\\  & =4{x}^{3}\\hspace{0.167em}\\mathbf{i}-4{y}^{3}\\hspace{0.167em}\\mathbf{j}+\\operatorname{sin}z\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,$ $y=\\operatorname{cos}⁡t$ and $z=2t$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =4{\\operatorname{sin}}^{3}t\\hspace{0.167em}\\mathbf{i}-4{\\operatorname{cos}}^{3}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{sin}2t\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+2\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(4{\\operatorname{sin}}^{3}t\\hspace{0.167em}\\mathbf{i}-4{\\operatorname{cos}}^{3}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{sin}2t\\hspace{0.167em}\\mathbf{k})\\cdot (\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+2\\hspace{0.167em}\\mathbf{k}) \\\\  & =4{\\operatorname{sin}}^{3}t\\cdot \\operatorname{cos}t-4{\\operatorname{cos}}^{3}t\\cdot (-\\operatorname{sin}t)+\\operatorname{sin}2t\\cdot 2 \\\\  & =4{\\operatorname{sin}}^{3}t\\operatorname{cos}t+4{\\operatorname{cos}}^{3}t\\operatorname{sin}t+2\\operatorname{sin}2t \\\\  & =4\\operatorname{sin}t\\operatorname{cos}t({\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t)+2\\operatorname{sin}2t \\\\  & =4\\operatorname{sin}t\\operatorname{cos}t+2\\operatorname{sin}2t \\\\  & =2\\operatorname{sin}2t+2\\operatorname{sin}2t \\\\  & =4\\operatorname{sin}2t.\\end{aligned}\n$$"] [17592186360550 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}(xyz))\\hspace{0.167em}\\mathbf{i}+\\frac{∂}{∂y}(\\operatorname{ln}(xyz))\\hspace{0.167em}\\mathbf{j}+\\frac{∂}{∂z}(\\operatorname{ln}(xyz))\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{yz}{xyz}\\hspace{0.167em}\\mathbf{i}+\\frac{xz}{xyz}\\hspace{0.167em}\\mathbf{j}+\\frac{xy}{xyz}\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{1}{x}\\hspace{0.167em}\\mathbf{i}+\\frac{1}{y}\\hspace{0.167em}\\mathbf{j}+\\frac{1}{z}\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNext, we substitute $x=t,y={e}^{t-1},$ and $z={e}^{t}$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+\\frac{1}{{e}^{t-1}}\\hspace{0.167em}\\mathbf{j}+\\frac{1}{{e}^{t}}\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({e}^{t-1})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\hspace{0.167em}\\mathbf{k} \\\\  & =\\mathbf{i}+{e}^{t-1}\\hspace{0.167em}\\mathbf{j}+{e}^{t}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+\\frac{1}{{e}^{t-1}}\\hspace{0.167em}\\mathbf{j}+\\frac{1}{{e}^{t}}\\hspace{0.167em}\\mathbf{k})\\cdot (\\mathbf{i}+{e}^{t-1}\\hspace{0.167em}\\mathbf{j}+{e}^{t}\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\frac{1}{t}+\\frac{{e}^{t-1}}{{e}^{t-1}}+\\frac{{e}^{t}}{{e}^{t}} \\\\  & =\\frac{1}{t}+2 \\\\  & =\\frac{2t+1}{t}.\\end{aligned}\n$$"] [17592186360577 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y,z) & =\\frac{∂}{∂x}[x({y}^{2}-{z}^{2})]\\hspace{0.167em}\\mathbf{i}+\\frac{∂}{∂y}[x({y}^{2}-{z}^{2})]\\hspace{0.167em}\\mathbf{j}+\\frac{∂}{∂z}[x({y}^{2}-{z}^{2})]\\hspace{0.167em}\\mathbf{k} \\\\  & =({y}^{2}-{z}^{2})\\hspace{0.167em}\\mathbf{i}+2xy\\hspace{0.167em}\\mathbf{j}-2xz\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{ln}⁡t,$ $y=t+1$ and $z=t-1$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =[(t+1)^{2}-(t-1)^{2}]\\mathbf{i}+2\\operatorname{ln}t\\cdot (t+1)\\hspace{0.167em}\\mathbf{j}-2\\operatorname{ln}t\\cdot (t-1)\\hspace{0.167em}\\mathbf{k} \\\\  & =4t\\hspace{0.167em}\\mathbf{i}+2(t+1)\\operatorname{ln}t\\hspace{0.167em}\\mathbf{j}-2(t-1)\\operatorname{ln}t\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t+1)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(t-1)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+\\hspace{0.167em}\\mathbf{j}+\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(4t\\hspace{0.167em}\\mathbf{i}+2(t+1)\\operatorname{ln}t\\hspace{0.167em}\\mathbf{j}-2(t-1)\\operatorname{ln}t\\hspace{0.167em}\\mathbf{k})\\cdot (\\frac{1}{t}\\hspace{0.167em}\\mathbf{i}+\\hspace{0.167em}\\mathbf{j}+\\hspace{0.167em}\\mathbf{k}) \\\\  & =4t\\cdot \\frac{1}{t}+2(t+1)\\operatorname{ln}t\\cdot 1-2(t-1)\\operatorname{ln}t\\cdot 1 \\\\  & =4+2(t+1)\\operatorname{ln}t-2(t-1)\\operatorname{ln}t \\\\  & =4+4\\operatorname{ln}t \\\\  & =4(\\operatorname{ln}t+1).\\end{aligned}\n$$"] [17592186360578 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y,z) & =\\frac{∂}{∂x}(yz\\operatorname{cos}x)\\hspace{0.167em}\\mathbf{i}+\\frac{∂}{∂y}(yz\\operatorname{cos}x)\\hspace{0.167em}\\mathbf{j}+\\frac{∂}{∂z}(yz\\operatorname{cos}x)\\hspace{0.167em}\\mathbf{k} \\\\  & =-yz\\operatorname{sin}x\\hspace{0.167em}\\mathbf{i}+z\\operatorname{cos}x\\hspace{0.167em}\\mathbf{j}+y\\operatorname{cos}x\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{2},y={e}^{t},$ and $z={e}^{t}$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =-{e}^{2t}\\operatorname{sin}{t}^{2}\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\operatorname{cos}{t}^{2}\\hspace{0.167em}\\mathbf{j}+{e}^{t}\\operatorname{cos}{t}^{2}\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\hspace{0.167em}\\mathbf{k} \\\\  & =2t\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}+{e}^{t}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(-{e}^{2t}\\operatorname{sin}{t}^{2}\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\operatorname{cos}{t}^{2}\\hspace{0.167em}\\mathbf{j}+{e}^{t}\\operatorname{cos}{t}^{2}\\hspace{0.167em}\\mathbf{k})\\cdot (2t\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}+{e}^{t}\\hspace{0.167em}\\mathbf{k}) \\\\  & =-2t{e}^{2t}\\operatorname{sin}{t}^{2}+{e}^{t}\\operatorname{cos}{t}^{2}\\cdot {e}^{t}+{e}^{t}\\operatorname{cos}{t}^{2}\\cdot {e}^{t} \\\\  & =-2t{e}^{2t}\\operatorname{sin}{t}^{2}+2{e}^{2t}\\operatorname{cos}{t}^{2} \\\\  & =2{e}^{2t}(\\operatorname{cos}{t}^{2}-t\\operatorname{sin}{t}^{2}).\\end{aligned}\n$$"] [17592186360579 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}(xz)+{e}^{y})\\hspace{0.167em}\\mathbf{i}+\\frac{∂}{∂y}(\\operatorname{ln}(xz)+{e}^{y})\\hspace{0.167em}\\mathbf{j}+\\frac{∂}{∂z}(\\operatorname{ln}(xz)+{e}^{y})\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{1}{x}\\hspace{0.167em}\\mathbf{i}+{e}^{y}\\hspace{0.167em}\\mathbf{j}+\\frac{1}{z}\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,y={t}^{2},$ and $z=\\frac{1}{t}$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =\\frac{1}{\\operatorname{sin}t}\\hspace{0.167em}\\mathbf{i}+{e}^{{t}^{2}}\\hspace{0.167em}\\mathbf{j}+t\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)\\mathbf{k} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}-\\frac{1}{{t}^{2}}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(\\frac{1}{\\operatorname{sin}t}\\hspace{0.167em}\\mathbf{i}+{e}^{{t}^{2}}\\hspace{0.167em}\\mathbf{j}+t\\hspace{0.167em}\\mathbf{k})\\cdot (\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}-\\frac{1}{{t}^{2}}\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\frac{\\operatorname{cos}t}{\\operatorname{sin}t}+2t{e}^{{t}^{2}}-\\frac{t}{{t}^{2}} \\\\  & =\\operatorname{cot}t+2t{e}^{{t}^{2}}-\\frac{1}{t}.\\end{aligned}\n$$"] [17592186362486 "Recall that the circle\n\n$$\n\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{9}=1\n$$\n\nin the $xy$-plane has the parametrization\n\n$$\n⟨x,y⟩=⟨3\\operatorname{cos}⁡\\theta ,3\\operatorname{sin}⁡\\theta ⟩,\\,\\theta \\in [0,2\\pi ),\n$$\n\nsince\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{9} & =\\frac{(3\\operatorname{cos}⁡\\theta )^{2}}{9}+\\frac{(3\\operatorname{sin}⁡\\theta )^{2}}{9} \\\\  & =\\frac{9{cos}^{2}⁡\\theta }{9}+\\frac{9{sin}^{2}⁡\\theta }{9} \\\\  & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1.\\end{aligned}\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\\begin{aligned}\\mathbf{f}(\\theta ,z) & =⟨x,y,z⟩ \\\\  & =⟨\\bbox[Gainsboro, 2pt]{{\\color{blue}3\\operatorname{cos}\\theta }},\\hspace{0.167em}3\\operatorname{sin}\\theta ,\\hspace{0.167em}z⟩\\end{aligned}$$\n\nwhere $(\\theta ,z)\\in C$ and $C=[0,2\\pi )\\times [0,3].$"] [17592186362489 "We found that a parametrization of the cylinder is given by\n\n$$\n\\mathbf{f}(\\theta ,z)=⟨3\\operatorname{cos}\\theta ,3\\operatorname{sin}\\theta ,z⟩\\hspace{2em}(\\theta ,z)\\in C.\n$$\n\nRestricting the parametrization of the cylinder to $z=2,$ we get a parametrization $\\mathbf{r}(\\theta )$ for the heating element:\n\n$$\n\\mathbf{r}(\\theta )=\\mathbf{f}(\\theta ,2)=⟨3\\operatorname{cos}\\theta ,3\\operatorname{sin}\\theta ,2⟩\n$$\n\nFor convenience, we express $\\mathbf{r}(\\theta )$ in column vector column:\n\n$$\n\\mathbf{r}(\\theta )=\\begin{bmatrix}x(\\theta ) \\\\ y(\\theta ) \\\\ z(\\theta )\\end{bmatrix}=\\begin{bmatrix}3\\operatorname{cos}\\theta  \\\\ 3\\operatorname{sin}\\theta  \\\\ 2\\end{bmatrix}\n$$\n\n \nNotice that this curve is traversed *counterclockwise* when viewed from above.\n\nTo calculate the outward-pointing unit normal vector to this curve, we follow three steps:\n\n**Step 1:** We compute the tangent vector ${\\mathbf{r}}^{'}(\\theta ).$\n\nDifferentiating the expression for $\\mathbf{r}(\\theta ),$ we get\n\n$$\n{\\mathbf{r}}^{'}(\\theta )=\\begin{bmatrix}{x}^{'}(\\theta ) \\\\ {y}^{'}(\\theta ) \\\\ {z}^{'}(\\theta )\\end{bmatrix}=\\begin{bmatrix}-3\\operatorname{sin}\\theta  \\\\ 3\\operatorname{cos}\\theta  \\\\ 0\\end{bmatrix}.\n$$\n\n**Step 2:** Since $C$ is traversed counterclockwise, we rotate ${\\mathbf{r}}^{'}(\\theta )$ by $\\frac{\\pi }{2}$ radians clockwise $(ϕ=-\\frac{\\pi }{2})$ to obtain an outward-pointing normal vector.\n\nUsing the hint, the rotation matrix corresponding to a $ϕ=-\\frac{\\pi }{2}$ counterclockwise rotation about the $z$-axis is\n\n$$\n{R}_{z}(\\theta )=\\begin{bmatrix}0 & 1 & 0 \\\\ -1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$\n\nRotating the vector ${\\mathbf{r}}^{'}(\\theta )$ by $-\\frac{\\pi }{2}$ counterclockwise, we get\n\n$$\n\\overset{~}{\\mathbf{n}}=\\begin{bmatrix}0 & 1 & 0 \\\\ -1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-3\\operatorname{sin}\\theta  \\\\ 3\\operatorname{cos}\\theta  \\\\ 0\\end{bmatrix}=\\begin{bmatrix}3\\operatorname{cos}\\theta  \\\\ 3\\operatorname{sin}\\theta  \\\\ 0\\end{bmatrix}\n$$\n\n**Step 3:** Finally, we normalize the vector found in Step 2:\n\n$$\n\\begin{aligned}||\\overset{~}{\\mathbf{n}}|| & =\\sqrt{(3\\operatorname{cos}\\theta )^{2}+(3\\operatorname{sin}\\theta )^{2}+{0}^{2}} \\\\  & =\\sqrt{9({\\operatorname{cos}}^{2}\\theta +{\\operatorname{sin}}^{2}\\theta )} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{n} & =\\frac{\\overset{~}{\\mathbf{n}}}{||\\overset{~}{\\mathbf{n}}||} \\\\  & =\\frac{1}{3}\\begin{bmatrix}3\\operatorname{cos}\\theta  \\\\ 3\\operatorname{sin}\\theta  \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}x(\\theta ) \\\\ y(\\theta ) \\\\ 0\\end{bmatrix} \\\\  & =\\frac{x}{3}\\hspace{0.167em}\\mathbf{i}+\\frac{y}{3}\\hspace{0.167em}\\mathbf{j}+0\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$"] [17592186362505 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/46/4693916207540a6453c6c3775824ba577e62fea0a18b07e96f8814901d9ad80e.png)\n\nFirst, notice that we can rewrite our integral as follows:\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∮}_{C}({x}^{2}-2{y}^{2})\\hspace{0.167em}\\mathrm{d}x+(-2xy)\\hspace{0.167em}\\mathrm{d}y\n$$\n\nWe have that $P(x,y)={x}^{2}-2{y}^{2}$ and $Q(x,y)=-2xy.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-4y,\\,\\frac{∂Q}{∂x}=-2y.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 2,\\hspace{0.167em}0\\le y\\le 2\\}\n$$\n\nTherefore, by applying Green's Theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\hspace{0.167em}\\text{d}A \\\\  & ={∬}_{D}(-2y-(-4y))\\hspace{0.167em}\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}2y\\hspace{0.222em}\\mathrm{d}y\\hspace{0.167em}\\mathrm{d}x.\\end{aligned}\n$$"]}
