2}}⟩ \\\\  & =⟨0,0⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{\\mathbf{u}}^{'}(-1,1)$ is\n\n$$\n\\begin{aligned}{g}_{\\mathbf{u}}^{'}(-1,1) & =\\mathrm{∇}g(-1,1)\\cdot \\mathbf{u} \\\\  & =⟨0,0⟩\\cdot \\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩ \\\\  & =\\frac{0(1)+0(-\\sqrt{2})}{\\sqrt{3}} \\\\  & =0.\\end{aligned}\n$$" 13194139543279 17592186576411 true] [17592186265978 1074 "The rate of change of $g(x,y)$ at the point $(-1,1)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(-1,1).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{1}^{2}+(-\\sqrt{2})^{2}}=\\sqrt{3} \\\\ u & =\\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇g(x,y)$ and evaluate it at the point $(-1,1):$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{x}{y}+\\frac{y}{x}),\\,\\frac{∂}{∂y}(\\frac{x}{y}+\\frac{y}{x})⟩ \\\\  & =⟨\\frac{1}{y}-\\frac{y}{{x}^{2}},\\,\\frac{1}{x}-\\frac{x}{{y}^{2}}⟩ \\\\ ∇g(-1,1) & =⟨\\frac{1}{1}-\\frac{1}{(-1)^{2}},\\frac{1}{(-1)}-\\frac{(-1)}{{1}^{2}}⟩ \\\\  & =⟨0,0⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(-1,1)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(-1,1) & =∇g(-1,1)\\cdot u \\\\  & =⟨0,0⟩\\cdot \\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩ \\\\  & =\\frac{0(1)+0(-\\sqrt{2})}{\\sqrt{3}} \\\\  & =0.\\end{aligned}\n$$" 13194139543279 17592186576411 false] [17592186266129 1071 "Find $f(x,y)$ such that $\\mathrm{∇}f=\\mathbf{F},$ where $\\mathbf{F}(x,y)=(\\operatorname{cos}(x+y)+y)\\hspace{0.167em}\\mathbf{i}+(\\operatorname{cos}(x+y)+x)\\hspace{0.167em}\\mathbf{j}.$" 13194139543279 17592186576411 true] [17592186266129 1071 "Find $f(x,y)$ such that $∇f=F,$ where $F(x,y)=(\\operatorname{cos}⁡(x+y)+y)\\,i+(\\operatorname{cos}⁡(x+y)+x)\\,j.$" 13194139543279 17592186576411 false] [17592186266129 1074 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n\\mathrm{∇}f(x,y)=\\frac{∂f}{∂x}\\hspace{0.167em}\\mathbf{i}+\\frac{