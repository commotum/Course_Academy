m}{\\color{blue}\\sqrt{6}\\hspace{0.167em}xy(y-2x)^{2}\\hspace{0.167em}}\\hspace{0.222em}\\text{d}y\\hspace{0.222em}\\text{d}x.\\end{aligned}\n$$"] [17592186278479 "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{\\left(\\frac{∂z}{∂x}\\right)}^{2}+{\\left(\\frac{∂z}{∂y}\\right)}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(-\\sqrt{2}x-\\sqrt{2}y)=-\\sqrt{2},\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(-\\sqrt{2}x-\\sqrt{2}y)=-\\sqrt{2}.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\hspace{0.167em}\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{\\left(\\frac{∂z}{∂x}\\right)}^{2}+{\\left(\\frac{∂z}{∂y}\\right)}^{2}}\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(-\\sqrt{2})}^{2}+{(-\\sqrt{2})}^{2}}\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}\\hspace{0.167em}\\sqrt{2}xy(-\\sqrt{2}x-\\sqrt{2}y)\\sqrt{5}\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}\\hspace{0.167em}(-2{x}^{2}y-2x{y}^{2})\\sqrt{5}\\hspace{0.222em}\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}\\hspace{0.167em}{\\color{blue}-2\\sqrt{5}({x}^{2}y+x{y}^{2})\\hspace{0.167em}}\\hspace{0.222em}\\text{d}y\\hspace{0.222em}\\text{d}x.\\end{aligned}\n$$"] [17592186278481 "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{\\left(\\frac{∂z}{∂x}\\right)}^{2}+{\\left(\\frac{∂z}{∂y}\\right)}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(-{x}^{2}+2{y}^{2})=-2x,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(-{x}^{2}+2{y}^{2})=4y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\hspace{0.167em}\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{\\left(\\frac{∂z}{∂x}\\right)}^{2}+{\\left(\\frac{∂z}{∂y}\\right)}^{2}}\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(-2x)}^{2}+{(4y)}^{2}}\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}\\hspace{0.167em}{x}^{2}(-{x}^{2}+2{y}^{2})^{2}\\sqrt{1+4{x}^{2}+16{y}^{2}}\\hspace{0.222em}\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}\\hspace{0.167em}{\\color{blue}({x}^{6}-4{y}^{2}{x}^{4}+4{y}^{4}{x}^{2})\\sqrt{1+4{x}^{2}+16{y}^{2}}\\hspace{0.167em}}\\hspace{0.222em}\\text{d}y\\hspace{0.222em}\\text{d}x.\\end{aligned}\n$$"] [17592186284546 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx={e}^{t},\\,y={e}^{t},\\,z=t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =\\frac{z}{x}\\hspace{0.167em}\\mathbf{i}+\\frac{z}{y}\\hspace{0.167em}\\mathbf{j}+\\mathbf{k} \\\\  & =t{e}^{-t}\\hspace{0.167em}\\mathbf{i}+t{e}^{-t}\\hspace{0.167em}\\mathbf{j}+\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}z}{\\text{d}t}\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{k} \\\\  & ={e}^{t}\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}+\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(t{e}^{-t}\\hspace{0.167em}\\mathbf{i}+t{e}^{-t}\\hspace{0.167em}\\mathbf{j}+\\mathbf{k})\\cdot ({e}^{t}\\hspace{0.167em}\\mathbf{i}+{e}^{t}\\hspace{0.167em}\\mathbf{j}+\\mathbf{k}) \\\\  & =t+t+1 \\\\  & =2t+1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{1}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}(2t+1)\\hspace{0.167em}\\mathrm{d}t \\\\  & ={[{t}^{2}+t]}_{0}^{1} \\\\  & =2\\end{aligned}\n$$"] [17592186284547 "We will use the formula\n\n$$\n{\\int }_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t,\\,y=t,\\,z={t}^{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =\\sqrt{x}\\hspace{0.167em}\\mathbf{i}+\\sqrt{y}\\hspace{0.167em}\\mathbf{j}+z\\hspace{0.167em}\\mathbf{k} \\\\  & =\\sqrt{t}\\hspace{0.167em}\\mathbf{i}+\\sqrt{t}\\hspace{0.167em}\\mathbf{j}+{t}^{2}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get \n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}z}{\\text{d}t}\\hspace{0.167em}\\mathbf{k} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\mathbf{j} \\\\  & =\\mathbf{i}+\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\sqrt{t}\\hspace{0.167em}\\mathbf{i}+\\sqrt{t}\\hspace{0.167em}\\mathbf{j}+{t}^{2}\\hspace{0.167em}\\mathbf{k})\\cdot (\\mathbf{i}+\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\sqrt{t}+\\sqrt{t}+2{t}^{3} \\\\  & =2\\sqrt{t}+2{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\mathbf{F}(\\mathbf{r})\\cdot \\text{d}\\mathbf{r} & ={\\int }_{1}^{2}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{1}^{2}(2\\sqrt{t}+2{t}^{3})\\hspace{0.167em}\\mathrm{d}t \\\\  & ={[\\frac{4}{3}{t}^{3/2}+\\frac{{t}^{4}}{2}]}_{1}^{2} \\\\  & =\\frac{4}{3}\\cdot 2\\sqrt{2}+8-\\frac{4}{3}-\\frac{1}{2} \\\\  & =\\frac{16\\sqrt{2}+37}{6}\\end{aligned}\n$$"] [17592186284584 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(x,y,z) & =\\frac{∂}{∂x}(x{y}^{2}+y{z}^{3})\\hspace{0.167em}\\mathbf{i}+\\frac{∂}{∂y}(x{y}^{2}+y{z}^{3})\\hspace{0.167em}\\mathbf{j}+\\frac{∂}{∂z}(x{y}^{2}+y{z}^{3})\\hspace{0.167em}\\mathbf{k} \\\\  & ={y}^{2}\\hspace{0.167em}\\mathbf{i}+(2xy+{z}^{3})\\hspace{0.167em}\\mathbf{j}+3y{z}^{2}\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{3},y=1,$ and $z=t$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =\\hspace{0.167em}\\mathbf{i}+3{t}^{3}\\hspace{0.167em}\\mathbf{j}+3{t}^{2}\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(1)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(t)\\hspace{0.167em}\\mathbf{k} \\\\  & =3{t}^{2}\\mathbf{i}+(0)\\hspace{0.167em}\\mathbf{j}+\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(\\hspace{0.167em}\\mathbf{i}+3{t}^{3}\\hspace{0.167em}\\mathbf{j}+3{t}^{2}\\hspace{0.167em}\\mathbf{k})\\cdot (3{t}^{2}\\mathbf{i}+(0)\\hspace{0.167em}\\mathbf{j}+\\hspace{0.167em}\\mathbf{k}) \\\\  & =1\\cdot 3{t}^{2}+3{t}^{3}\\cdot 0+3{t}^{2}\\cdot 1 \\\\  & =3{t}^{2}+3{t}^{2} \\\\  & =6{t}^{2}.\\end{aligned}\n$$"] [17592186284585 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n\\mathrm{∇}f(x,y)=2xy\\operatorname{cos}({x}^{2})\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}({x}^{2})\\hspace{0.167em}\\mathbf{j}.\n$$\n\nFirst, we substitute $x=\\sqrt{t}$ and $y=\\frac{t}{2}$ into $∇f(x,y)$ to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & ={t}^{3/2}\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{t}{2}\\right)\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{1}{2\\sqrt{t}}\\hspace{0.167em}\\mathbf{i}+\\frac{1}{2}\\mathbf{j}.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =({t}^{3/2}\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j})\\cdot (\\frac{1}{2\\sqrt{t}}\\hspace{0.167em}\\mathbf{i}+\\frac{1}{2}\\mathbf{j}) \\\\  & ={t}^{3/2}\\operatorname{cos}(t)\\cdot \\frac{1}{2\\sqrt{t}}+\\operatorname{sin}t\\cdot \\frac{1}{2} \\\\  & =\\frac{t\\operatorname{cos}t+\\operatorname{sin}t}{2}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\pi ,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(\\pi ))] & =\\frac{\\pi \\operatorname{cos}\\pi +\\operatorname{sin}\\pi }{2} \\\\  & =\\frac{\\pi (-1)+0}{2} \\\\  & =-\\frac{\\pi }{2}.\\end{aligned}\n$$"] [17592186284586 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n\\mathrm{∇}f(x,y)=2x{e}^{{x}^{2}+y}\\hspace{0.167em}\\mathbf{i}+{e}^{{x}^{2}+y}\\hspace{0.167em}\\mathbf{j}.\n$$\n\nFirst, we substitute $x=\\operatorname{sin}⁡t$ and $y=t+{cos}^{2}⁡t$ into $∇f(x,y)$ to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =2\\operatorname{sin}t\\hspace{0.167em}{e}^{{\\operatorname{sin}}^{2}t+t+{\\operatorname{cos}}^{2}t}\\hspace{0.167em}\\mathbf{i}+{e}^{{\\operatorname{sin}}^{2}t+t+{\\operatorname{cos}}^{2}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =2{e}^{t+1}\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+{e}^{t+1}\\hspace{0.167em}\\mathbf{j}\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(t+{\\operatorname{cos}}^{2}t)\\hspace{0.167em}\\mathbf{j} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+(1-2\\operatorname{sin}t\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =(2{e}^{t+1}\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+{e}^{t+1}\\hspace{0.167em}\\mathbf{j})\\cdot (\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+(1-2\\operatorname{sin}t\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}) \\\\  & =2{e}^{t+1}\\operatorname{sin}t\\cdot \\operatorname{cos}t+{e}^{t+1}\\cdot (1-2\\operatorname{sin}t\\operatorname{cos}t) \\\\  & =2{e}^{t+1}\\operatorname{sin}t\\operatorname{cos}t+{e}^{t+1}-2{e}^{t+1}\\operatorname{sin}t\\operatorname{cos}t \\\\  & ={e}^{t+1}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=-1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(-1))] & ={e}^{-1+1}=1.\\end{aligned}\n$$"] [17592186284587 "The rate of change of $f(x,y)$ with respect to $t$ along the curve $\\mathbf{r}(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}\\left(\\frac{x}{y}\\right),\\frac{∂}{∂y}\\left(\\frac{x}{y}\\right)⟩ \\\\  & =⟨\\frac{1}{y},-\\frac{x}{{y}^{2}}⟩\\end{aligned}\n$$\n\nNext, we substitute $x=2t$ and $y=\\sqrt{t}$ into the above to find $\\mathrm{∇}f(\\mathbf{r}(t)):$\n\n$$\n\\begin{aligned}\\mathrm{∇}f(\\mathbf{r}(t)) & =⟨\\frac{1}{\\sqrt{t}},-2⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})⟩ \\\\  & =⟨2,\\frac{1}{2\\sqrt{t}}⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))] & =\\mathrm{∇}f(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) \\\\  & =⟨\\frac{1}{\\sqrt{t}},-2⟩\\cdot ⟨2,\\frac{1}{2\\sqrt{t}}⟩ \\\\  & =\\frac{1}{\\sqrt{t}}\\cdot 2-2\\cdot \\frac{1}{2\\sqrt{t}} \\\\  & =\\frac{2}{\\sqrt{t}}-\\frac{1}{\\sqrt{t}} \\\\  & =\\frac{1}{\\sqrt{t}}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $\\mathbf{r}(t)$ at $t=9$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(9))] & =\\frac{1}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"] [17592186284590 "Since $\\mathbf{r}(t)=t\\hspace{0.167em}\\mathbf{i}+{t}^{2}\\hspace{0.167em}\\mathbf{j},$ then along the curve we have $x=t$ and $y={t}^{2}.$ \n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\mathbf{j} \\\\  & =\\mathbf{i}+2t\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=\\frac{x}{4y+1}$, then we obtain \n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =\\frac{t}{4{t}^{2}+1}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{4y+1}\\text{d}s & ={\\int }_{0}^{1}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}\\left(\\frac{t}{4{t}^{2}+1}\\right)\\cdot \\sqrt{4{t}^{2}+1}\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{1}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t.\\end{aligned}\n$$"] [17592186284591 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s={\\int }_{a}^{b}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t.\n$$\n\n \n\nSince $\\mathbf{r}(t)=⟨t,\\hspace{0.222em}1+t⟩,$ then along the curve we have $x=t$ and $y=1+t.$    \n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}\\mathbf{r}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(1+t)\\mathbf{j} \\\\  & =\\hspace{0.167em}\\mathbf{i}+\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =t+(1+t)=2t+1.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{0}^{1}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}(2t+1)\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{1}2t+1\\hspace{0.167em}\\text{d}t \\\\  & =\\sqrt{2}{[{t}^{2}+t]}_{0}^{1} \\\\  & =\\sqrt{2}(1+1-0) \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$"] [17592186284592 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s={\\int }_{a}^{b}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t.\n$$\n\n \n\nSince $\\mathbf{r}(t)=3t\\hspace{0.167em}\\mathbf{i}+{t}^{3}\\hspace{0.167em}\\mathbf{j}$, then along the curve we have $x=3t$ and $y={t}^{3}.$\n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\hspace{0.167em}\\mathbf{j} \\\\  & =3\\hspace{0.167em}\\mathbf{i}+3{t}^{2}\\hspace{0.167em}\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{3}^{2}+{(3{t}^{2})}^{2}} \\\\  & =\\sqrt{9+9{t}^{4}} \\\\  & =3\\sqrt{1+{t}^{4}}\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{3}+y$, we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =(3t)^{3}+{t}^{3} \\\\  & =27{t}^{3}+{t}^{3} \\\\  & =28{t}^{3}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s & ={\\int }_{0}^{1}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}28{t}^{3}\\cdot 3\\sqrt{1+{t}^{4}}\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{1}84{t}^{3}\\sqrt{1+{t}^{4}}.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+{t}^{4},$ $\\text{d}u=4{t}^{3}\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}84{t}^{3}\\sqrt{1+{t}^{4}}\\,\\text{d}t & ={\\int }_{1}^{2}21\\cdot {u}^{1/2}\\,\\text{d}u \\\\  & =21\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{2} \\\\  & =14({2}^{3/2}-{1}^{3/2}) \\\\  & =14(2\\sqrt{2}-1)\\end{aligned}\n$$"] [17592186284593 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\hspace{0.167em}\\text{d}s={\\int }_{a}^{b}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t.\n$$\n\n \n\nSince $\\mathbf{r}(t)=4\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+4\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j},$ then along the curve we have $x=4\\operatorname{cos}⁡t$ and $y=4\\operatorname{sin}⁡t.$  \n\nComputing ${\\mathbf{r}}^{'}(t)$ and $‖{\\mathbf{r}}^{'}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}y}{\\text{d}t}\\hspace{0.167em}\\mathbf{j} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}t)\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}t)\\mathbf{j} \\\\  & =-4\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+4\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j} \\\\ ‖{\\mathbf{r}}^{'}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}t)^{2}+(4\\operatorname{cos}t)^{2}} \\\\  & =\\sqrt{16{\\operatorname{sin}}^{2}t+16{\\operatorname{cos}}^{2}t} \\\\  & =\\sqrt{16({\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t)} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\n \n\nNow, if $f(x,y)=2{x}^{2}-16$, then we obtain\n\n$$\n\\begin{aligned}f(\\mathbf{r}(t)) & =2(4\\operatorname{cos}t)^{2}-16 \\\\  & =16(2{\\operatorname{cos}}^{2}t-1) \\\\  & =16\\operatorname{cos}2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}(2{x}^{2}-16)\\hspace{0.167em}\\text{d}s & ={\\int }_{0}^{\\pi /4}f(\\mathbf{r}(t))\\hspace{0.167em}‖{\\mathbf{r}}^{'}(t)‖\\hspace{0.167em}\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}16\\operatorname{cos}2t\\cdot 4\\hspace{0.167em}\\text{d}t \\\\  & =64{\\int }_{0}^{\\pi /4}\\operatorname{cos}2t\\hspace{0.167em}\\text{d}t \\\\  & =64{[\\frac{1}{2}\\operatorname{sin}2t]}_{0}^{\\pi /4} \\\\  & =32[\\operatorname{sin}\\left(\\frac{\\pi }{2}\\right)-\\operatorname{sin}0] \\\\  & =32(1-0) \\\\  & =32.\\end{aligned}\n$$"] [17592186284783 "The formula for the area of the triangle is \n\n$$\\mathcal{A}=\\frac{1}{2}bc\\operatorname{sin}A,$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere, we have\n\n$$\n\\begin{aligned}с & =AB=26, \\\\ b & =AC=22, \\\\ m∠A & ={11}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{11}^{∘}=0.190\\,809,\n$$\n\nrounded to six decimal places,  we calculate the area as follows:\n \n\n$$\\begin{aligned}\\mathcal{A} & =\\frac{1}{2}\\cdot 22\\cdot 26\\cdot \\operatorname{sin}{11}^{∘} \\\\  & =286\\cdot (0.190\\hspace{0.167em}809) \\\\  & \\approx 54.57,\\end{aligned}$$\n\nrounded to two decimal places."] [17592186287822 "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =\\begin{vmatrix}-3 & 3 & 1 \\\\ 2 & -1 & 3 \\\\ 0 & 4 & 1\\end{vmatrix} \\\\  & =(-3)\\cdot \\begin{vmatrix}-1 & 3 \\\\ 4 & 1\\end{vmatrix}-3\\cdot \\begin{vmatrix}2 & 3 \\\\ 0 & 1\\end{vmatrix}+1\\cdot \\begin{vmatrix}2 & -1 \\\\ 0 & 4\\end{vmatrix} \\\\  & =-3((-1)\\cdot 1-4\\cdot 3)-3(2\\cdot 1-0\\cdot 3)+(2\\cdot 4-0\\cdot (-1)) \\\\  & =39-6+8 \\\\  & =41\\end{aligned}\n$$\n\n    \n\nFinally, we take the absolute value. So the volume of the corresponding parallelepiped is\n\n$$\nV=|41|=41.\n$$"] [17592186287823 "Computing the triple product, we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot (\\mathbf{q}\\times \\mathbf{r}) & =\\begin{vmatrix}0 & -1 & -{k}^{2} \\\\ 2 & 4 & 8 \\\\ -1 & -1 & 5\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}4 & 8 \\\\ -1 & 5\\end{vmatrix}-(-1)\\cdot \\begin{vmatrix}2 & 8 \\\\ -1 & 5\\end{vmatrix}+(-{k}^{2})\\cdot \\begin{vmatrix}2 & 4 \\\\ -1 & -1\\end{vmatrix} \\\\  & =0+(2\\cdot 5-(-1)\\cdot 8)-{k}^{2}(2\\cdot (-1)-(-1)\\cdot 4) \\\\  & =18-2{k}^{2}.\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot (\\mathbf{q}\\times \\mathbf{r}) & =0 \\\\ 18-2{k}^{2} & =0 \\\\ 2{k}^{2} & =18 \\\\ {k}^{2} & =9 \\\\ k & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-3$ or $k=3.$"] [17592186287979 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(3\\mathbf{i}+3\\mathbf{j}+3\\mathbf{k})-(2\\mathbf{i}+\\mathbf{j}+2\\mathbf{k}) \\\\  & =\\mathbf{i}+2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,2,1⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(-2\\mathbf{i}-\\mathbf{j}+3\\mathbf{k})-(2\\mathbf{i}+\\mathbf{j}+2\\mathbf{k}) \\\\  & =-4\\mathbf{i}-2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨-4,-2,1⟩ \\\\ \\overset{\\to }{AD} & =\\mathbf{d}-\\mathbf{a} \\\\  & =(4\\mathbf{i}+\\mathbf{j}+4\\mathbf{k})-(2\\mathbf{i}+\\mathbf{j}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+2\\mathbf{k} \\\\  & =⟨2,0,2⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}1 & 2 & 1 \\\\ -4 & -2 & 1 \\\\ 2 & 0 & 2\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}-2 & 1 \\\\ 0 & 2\\end{vmatrix}-2\\cdot \\begin{vmatrix}-4 & 1 \\\\ 2 & 2\\end{vmatrix}+1\\cdot \\begin{vmatrix}-4 & -2 \\\\ 2 & 0\\end{vmatrix} \\\\  & =((-2)\\cdot 2-0\\cdot 1)-2((-4)\\cdot 2-2\\cdot 1)+((-4)\\cdot 0-2\\cdot (-2)) \\\\  & =-4+20+4 \\\\  & =20.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|20|=20.\n$$"] [17592186292841 "Computing the triple product, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =\\begin{vmatrix}-2 & 1 & -3 \\\\ -1 & k & 2 \\\\ 3 & -2 & 4\\end{vmatrix} \\\\  & =(-2)\\cdot \\begin{vmatrix}k & 2 \\\\ -2 & 4\\end{vmatrix}-1\\cdot \\begin{vmatrix}-1 & 2 \\\\ 3 & 4\\end{vmatrix}+(-3)\\cdot \\begin{vmatrix}-1 & k \\\\ 3 & -2\\end{vmatrix} \\\\  & =-2(k\\cdot 4-(-2)\\cdot 2)-((-1)\\cdot 4-3\\cdot 2)-3((-1)\\cdot (-2)-3\\cdot k) \\\\  & =-8k-8+10-6+9k \\\\  & =k-4.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =0 \\\\ k-4 & =0 \\\\ k & =4\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=4.$"] [17592186295109 "The formula for the area of the triangle is \n\n$$\\mathcal{A}=\\frac{1}{2}ac\\operatorname{sin}B,$$\n\nwhere $∠B$ is between the sides of lengths $a$ and $b.$ \n\nHere, we have\n\n$$\n\\begin{aligned}c & =AB=4, \\\\ a & =BC=8, \\\\ m∠B & ={40}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{40}^{∘}=0.642\\,788,\n$$\n\nrounded to six decimal places,  we calculate the area as follows:\n \n\n$$\\begin{aligned}\\mathcal{A} & =\\frac{1}{2}\\cdot 8\\cdot 4\\cdot \\operatorname{sin}{40}^{∘} \\\\  & =16\\cdot (0.642\\hspace{0.167em}788) \\\\  & \\approx 10.3,\\end{aligned}$$\n\nrounded to the **nearest tenth**."] [17592186295110 "The formula for the area of the triangle is \n\n$$\\mathcal{A}=\\frac{1}{2}bc\\operatorname{sin}A,$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere, we have\n\n$$\n\\begin{aligned}с & =AB=18, \\\\ b & =AC=12, \\\\ m∠A & ={120}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{120}^{∘}=0.866\\,025,\n$$\n\nrounded to six decimal places,  we calculate the area as follows:\n \n\n$$\\begin{aligned}\\mathcal{A} & =\\frac{1}{2}\\cdot 12\\cdot 18\\cdot \\operatorname{sin}{120}^{∘} \\\\  & =108\\cdot (0.866\\hspace{0.167em}025…) \\\\  & \\approx 93.5\\hspace{0.167em}{\\text{ft}}^{2},\\end{aligned}$$\n\nrounded to the **nearest tenth**."] [17592186295111 "The diagonal $\\overset{―}{AC}$ divides the parallelogram into two congruent triangles. Therefore, the area of the parallelogram is twice the area of $△ACB$ (see the illustration below).\n\n![](images/b1/b1d0cf7c5a7c6ad7f0f52c8686239920fabcb05be57372ae0c7c9c9491838a52.png)\n\n Computing the area of $△ACB,$ we find\n \n\n$$\\begin{aligned}{\\mathcal{A}}_{ACB} & =\\frac{1}{2}(10)(6)\\operatorname{sin}{60}^{∘} \\\\  & =30\\cdot \\operatorname{sin}{60}^{∘} \\\\  & \\approx 25.981,\\end{aligned}$$\n\nrounded to three decimal places. Consequently,\n\n$$\\begin{aligned}{\\mathcal{A}}_{ABCD} & =2{\\mathcal{A}}_{ACB} \\\\  & =2\\cdot 25.981 \\\\  & =51.962.\\end{aligned}$$\n\nSo, to the **nearest integer**, the area of the parallelogram is $52.$"] [17592186295123 "The formula for the area of the triangle is \n\n$$\\mathcal{A}=\\frac{1}{2}ac\\operatorname{sin}B,$$\n\nwhere $∠B$ is between the sides of lengths $a$ and $c.$ \n\nHere, we have\n\n$$\n\\begin{aligned}c & =AB=5, \\\\ a & =BC=5, \\\\ m∠B & ={60}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{60}^{∘}=0.866\\,025,\n$$\n\nrounded to six decimal places,  we calculate the area as follows:\n \n\n$$\\begin{aligned}\\mathcal{A} & =\\frac{1}{2}\\cdot 5\\cdot 5\\cdot \\operatorname{sin}{60}^{∘} \\\\  & =12.5\\cdot (0.866\\hspace{0.167em}025) \\\\  & \\approx 10.83,\\end{aligned}$$\n\nrounded to **two decimal places**."] [17592186295125 "The formula for the area of the triangle is \n\n$$\n\\mathcal{A}=\\frac{1}{2}bc\\operatorname{sin}A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=10\\text{ cm}, \\\\ b & =AC, \\\\ m∠A & ={120}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{120}^{∘}=\\frac{\\sqrt{3}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{25\\sqrt{3}}{2} & =\\frac{1}{2}\\cdot b\\cdot 10\\cdot \\operatorname{sin}⁡{120}^{∘} \\\\ \\frac{25\\sqrt{3}}{2} & =\\frac{1}{2}\\cdot b\\cdot 10\\cdot \\left(\\frac{\\sqrt{3}}{2}\\right) \\\\ \\frac{25\\sqrt{3}}{2} & =5b\\cdot \\frac{\\sqrt{3}}{2} \\\\ 25\\cancel{\\frac{\\sqrt{3}}{2}} & =5b\\cdot \\cancel{\\frac{\\sqrt{3}}{2}} \\\\ 5b & =25 \\\\ b & =5\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=5\\,\\text{ cm}.$"] [17592186295126 "The formula for the area of the triangle is \n\n$$\n\\mathcal{A}=\\frac{1}{2}bc\\operatorname{sin}A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\sqrt{3}\\,\\text{ mm}, \\\\ b & =AC=4\\,\\text{mm}\\end{aligned}\n$$\n\nTherefore, we can calculate $m∠A$ as follows:\n\n$$\n\\begin{aligned}\\mathcal{A} & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}A \\\\ 3 & =\\frac{1}{2}\\cdot 4\\cdot \\sqrt{3}\\cdot \\operatorname{sin}A \\\\ 3 & =2\\sqrt{3}\\cdot \\operatorname{sin}A \\\\ \\frac{3}{2\\sqrt{3}} & =\\operatorname{sin}A \\\\ \\frac{\\sqrt{3}}{2} & =\\operatorname{sin}A \\\\ \\operatorname{sin}A & =\\frac{\\sqrt{3}}{2} \\\\ m\\mathrm{∠}A & ={60}^{∘}.\\end{aligned}\n$$"] [17592186295127 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(3\\mathbf{i}-2\\mathbf{j}+\\mathbf{k})-(\\mathbf{i}-2\\mathbf{k}) \\\\  & =2\\mathbf{i}-2\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,-2,3⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(-\\mathbf{i}+4\\mathbf{j}-\\mathbf{k})-(\\mathbf{i}-2\\mathbf{k}) \\\\  & =-2\\mathbf{i}+4\\mathbf{j}+\\mathbf{k} \\\\  & =⟨-2,4,1⟩ \\\\ \\overset{\\to }{AD} & =\\mathbf{d}-\\mathbf{a} \\\\  & =(2\\mathbf{i}+\\mathbf{j})-(\\mathbf{i}-2\\mathbf{k}) \\\\  & =\\mathbf{i}+\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨1,1,2⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}2 & -2 & 3 \\\\ -2 & 4 & 1 \\\\ 1 & 1 & 2\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}4 & 1 \\\\ 1 & 2\\end{vmatrix}-(-2)\\cdot \\begin{vmatrix}-2 & 1 \\\\ 1 & 2\\end{vmatrix}+3\\cdot \\begin{vmatrix}-2 & 4 \\\\ 1 & 1\\end{vmatrix} \\\\  & =2(8-1)+2(-4-1)+3(-2-4) \\\\  & =14-10-18 \\\\  & =-14.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-14|=14.\n$$"] [17592186295128 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(4\\mathbf{i}-\\mathbf{j}+5\\mathbf{k})-(\\mathbf{i}-3\\mathbf{j}+2\\mathbf{k}) \\\\  & =3\\mathbf{i}+2\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨3,2,3⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(-2\\mathbf{i}+\\mathbf{k})-(\\mathbf{i}-3\\mathbf{j}+2\\mathbf{k}) \\\\  & =-3\\mathbf{i}+3\\mathbf{j}-\\mathbf{k} \\\\  & =⟨-3,3,-1⟩ \\\\ \\overset{\\to }{AD} & =\\mathbf{d}-\\mathbf{a} \\\\  & =(3\\mathbf{i}-2\\mathbf{j}+3\\mathbf{k})-(\\mathbf{i}-3\\mathbf{j}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+\\mathbf{j}+\\mathbf{k} \\\\  & =⟨2,1,1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}3 & 2 & 3 \\\\ -3 & 3 & -1 \\\\ 2 & 1 & 1\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}3 & -1 \\\\ 1 & 1\\end{vmatrix}-2\\cdot \\begin{vmatrix}-3 & -1 \\\\ 2 & 1\\end{vmatrix}+3\\cdot \\begin{vmatrix}-3 & 3 \\\\ 2 & 1\\end{vmatrix} \\\\  & =3(3\\cdot 1-(-1)\\cdot 1)-2((-3)\\cdot 1-(-1)\\cdot 2)+3((-3)\\cdot 1-3\\cdot 2) \\\\  & =3(3+1)-2(-3+2)+3(-3-6) \\\\  & =12+2-27 \\\\  & =-13.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-13|=13.\n$$"] [17592186295164 "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}\\mathbf{x}\\cdot (\\mathbf{y}\\times \\mathbf{z}) & =\\begin{vmatrix}1 & 2 & 3 \\\\ 0 & 1 & -1 \\\\ 2 & 0 & 1\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}1 & -1 \\\\ 0 & 1\\end{vmatrix}-2\\cdot \\begin{vmatrix}0 & -1 \\\\ 2 & 1\\end{vmatrix}+3\\cdot \\begin{vmatrix}0 & 1 \\\\ 2 & 0\\end{vmatrix} \\\\  & =1(1\\cdot 1-(-1)\\cdot 0)-2(0\\cdot 1-(-1)\\cdot 2)+3(0\\cdot 0-1\\cdot 2) \\\\  & =1-4-6 \\\\  & =-9\\end{aligned}\n$$\n\n    \n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|-9|=9.\n$$"] [17592186295165 "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}\\mathbf{x}\\cdot (\\mathbf{y}\\times \\mathbf{z}) & =\\begin{vmatrix}1 & 1 & 2 \\\\ -3 & 2 & 0 \\\\ 4 & -2 & 1\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}2 & 0 \\\\ -2 & 1\\end{vmatrix}-1\\cdot \\begin{vmatrix}-3 & 0 \\\\ 4 & 1\\end{vmatrix}+2\\cdot \\begin{vmatrix}-3 & 2 \\\\ 4 & -2\\end{vmatrix} \\\\  & =1(2\\cdot 1-0\\cdot (-2))-1((-3)\\cdot 1-0\\cdot 4)+2((-3)\\cdot (-2)-2\\cdot 4) \\\\  & =2+3-4 \\\\  & =1\\end{aligned}\n$$\n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|1|=1.\n$$"] [17592186295166 "The volume of a parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =\\begin{vmatrix}1 & 2 & 3 \\\\ 0 & 5 & 0 \\\\ 4 & 0 & 6\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}5 & 0 \\\\ 0 & 6\\end{vmatrix}-2\\cdot \\begin{vmatrix}0 & 0 \\\\ 4 & 6\\end{vmatrix}+3\\cdot \\begin{vmatrix}0 & 5 \\\\ 4 & 0\\end{vmatrix} \\\\  & =1(30)-2(0)+3(-20) \\\\  & =30-0-60 \\\\  & =-30\\end{aligned}\n$$\n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|-30|=30.\n$$"] [17592186295167 "The volume of a parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}\\mathbf{x}\\cdot (\\mathbf{y}\\times \\mathbf{z}) & =\\begin{vmatrix}3 & 1 & 4 \\\\ 0 & 2 & 5 \\\\ 6 & 0 & 1\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}2 & 5 \\\\ 0 & 1\\end{vmatrix}-1\\cdot \\begin{vmatrix}0 & 5 \\\\ 6 & 1\\end{vmatrix}+4\\cdot \\begin{vmatrix}0 & 2 \\\\ 6 & 0\\end{vmatrix} \\\\  & =3(2\\cdot 1-5\\cdot 0)-(0\\cdot 1-5\\cdot 6)+4(0\\cdot 0-2\\cdot 6) \\\\  & =6+30-48 \\\\  & =-12\\end{aligned}\n$$\n\nFinally, we take the absolute value. So, the volume of the corresponding parallelepiped is \n\n$$\nV=|-12|=12.\n$$"] [17592186295168 "Computing the triple product, we get\n\n$$\n\\begin{aligned}\\mathbf{x}\\cdot (\\mathbf{y}\\times \\mathbf{z}) & =\\begin{vmatrix}2 & 0 & k \\\\ 1 & 4 & 3 \\\\ 0 & 2 & 5\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}4 & 3 \\\\ 2 & 5\\end{vmatrix}-0\\cdot \\begin{vmatrix}1 & 3 \\\\ 0 & 5\\end{vmatrix}+k\\cdot \\begin{vmatrix}1 & 4 \\\\ 0 & 2\\end{vmatrix} \\\\  & =2(4\\cdot 5-3\\cdot 2)+0+k(1\\cdot 2-4\\cdot 0) \\\\  & =2(20-6)+2k \\\\  & =28+2k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}\\mathbf{x}\\cdot (\\mathbf{y}\\times \\mathbf{z}) & =0 \\\\ 28+2k & =0 \\\\ 2k & =-28 \\\\ k & =-14\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-14.$"] [17592186295169 "Computing the triple product, we get\n\n$$\n\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c})=\\begin{vmatrix}1 & 3 & 0 \\\\ 0 & 4 & 2 \\\\ 2 & k & 5\\end{vmatrix}\n$$\n\n$$\n\\begin{aligned} & =1\\cdot \\begin{vmatrix}4 & 2 \\\\ k & 5\\end{vmatrix}-3\\cdot \\begin{vmatrix}0 & 2 \\\\ 2 & 5\\end{vmatrix}+0\\cdot \\begin{vmatrix}0 & 4 \\\\ 2 & k\\end{vmatrix} \\\\  & =(4\\cdot 5-2\\cdot k)-3(0\\cdot 5-2\\cdot 2)=(20-2k)+12 \\\\  & =32-2k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =0 \\\\ 32-2k & =0 \\\\ -2k & =-32 \\\\ k & =16\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=16.$"] [17592186295170 "Computing the triple product, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =\\begin{vmatrix}1 & k & k \\\\ 0 & 3 & 2 \\\\ 4 & 0 & 5\\end{vmatrix} \\\\  & =1\\cdot \\begin{vmatrix}3 & 2 \\\\ 0 & 5\\end{vmatrix}-k\\cdot \\begin{vmatrix}0 & 2 \\\\ 4 & 5\\end{vmatrix}+k\\cdot \\begin{vmatrix}0 & 3 \\\\ 4 & 0\\end{vmatrix} \\\\  & =1(3\\cdot 5-2\\cdot 0)-k(0\\cdot 5-2\\cdot 4)+k(0\\cdot 0-3\\cdot 4) \\\\  & =15+8k-12k \\\\  & =15-4k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =0 \\\\ 15-4k & =0 \\\\ 4k & =15 \\\\ k & =\\frac{15}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=\\frac{15}{4}.$"] [17592186295171 "Computing the triple product, we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot (\\mathbf{b}\\times \\mathbf{c}) & =\\begin{vmatrix}4 & {k}^{2} & 2 \\\\ 1 & 5 & 3 \\\\ 2 & 1 & 0\\end{vmatrix} \\\\  & =4\\cdot \\begin{vmatrix}5 & 3 \\\\ 1 & 0\\end{vmatrix}-{k}^{2}\\cdot \\begin{vmatrix}1 & 3 \\\\ 2 & 0\\end{vmatrix}+2\\cdot \\begin{vmatrix}1 & 5 \\\\ 2 & 1\\end{vmatrix} \\\\  & =4(5\\cdot 0-3\\cdot 1)-{k}^{2}(1\\cdot 0-3\\cdot 2)+2(1\\cdot 1-5\\cdot 2) \\\\  & =4(-3)-{k}^{2}(0-6)+2(1-10) \\\\  & =-12+6{k}^{2}-18 \\\\  & =6{k}^{2}-30\\end{aligned}\n$$\n\nSet the triple product equal to 0:\n\n$$\n\\begin{aligned}6{k}^{2}-30 & =0 \\\\ 6{k}^{2} & =30 \\\\ {k}^{2} & =5 \\\\ k & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if \n$k=-\\sqrt{5}$ or $k=\\sqrt{5}.$"] [17592186295173 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(3\\mathbf{i}+4\\mathbf{j}+5\\mathbf{k})-(\\mathbf{i}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+4\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,4,3⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(6\\mathbf{i}+2\\mathbf{j}+4\\mathbf{k})-(\\mathbf{i}+2\\mathbf{k}) \\\\  & =5\\mathbf{i}+2\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨5,2,2⟩ \\\\ \\overset{\\to }{AD} & =\\mathbf{d}-\\mathbf{a} \\\\  & =(5\\mathbf{i}+3\\mathbf{j}+6\\mathbf{k})-(\\mathbf{i}+2\\mathbf{k}) \\\\  & =4\\mathbf{i}+3\\mathbf{j}+4\\mathbf{k} \\\\  & =⟨4,3,4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}2 & 4 & 3 \\\\ 5 & 2 & 2 \\\\ 4 & 3 & 4\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}2 & 2 \\\\ 3 & 4\\end{vmatrix}-4\\cdot \\begin{vmatrix}5 & 2 \\\\ 4 & 4\\end{vmatrix}+3\\cdot \\begin{vmatrix}5 & 2 \\\\ 4 & 3\\end{vmatrix} \\\\  & =2(2\\cdot 4-2\\cdot 3)-4(5\\cdot 4-2\\cdot 4)+3(5\\cdot 3-2\\cdot 4) \\\\  & =2(8-6)-4(20-8)+3(15-8) \\\\  & =4-48+21 \\\\  & =-23.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-23|=23.\n$$"] [17592186295174 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(5\\mathbf{i}+1\\mathbf{j}+3\\mathbf{k})-(3\\mathbf{i}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+\\mathbf{j}+\\mathbf{k} \\\\  & =⟨2,1,1⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(4\\mathbf{i}+3\\mathbf{j}+5\\mathbf{k})-(3\\mathbf{i}+2\\mathbf{k}) \\\\  & =\\mathbf{i}+3\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨1,3,3⟩ \\\\ \\overset{\\to }{AD} & =\\mathbf{d}-\\mathbf{a} \\\\  & =(3\\mathbf{i}+5\\mathbf{k})-(3\\mathbf{i}+2\\mathbf{k}) \\\\  & =3\\mathbf{k} \\\\  & =⟨0,0,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}2 & 1 & 1 \\\\ 1 & 3 & 3 \\\\ 0 & 0 & 3\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}3 & 3 \\\\ 0 & 3\\end{vmatrix}-1\\cdot \\begin{vmatrix}1 & 3 \\\\ 0 & 3\\end{vmatrix}+1\\cdot \\begin{vmatrix}1 & 3 \\\\ 0 & 0\\end{vmatrix} \\\\  & =2(3\\cdot 3-3\\cdot 0)-1(1\\cdot 3-3\\cdot 0)+1(1\\cdot 0-3\\cdot 0) \\\\  & =2(9)-1(3)+1(0) \\\\  & =18-3+0 \\\\  & =15.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|15|=15.\n$$"] [17592186295175 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(5\\mathbf{j}+5\\mathbf{k})-(1\\mathbf{j}+3\\mathbf{k}) \\\\  & =4\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨0,4,2⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(3\\mathbf{i}+4\\mathbf{j}+5\\mathbf{k})-(1\\mathbf{j}+3\\mathbf{k}) \\\\  & =3\\mathbf{i}+3\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨3,3,2⟩ \\\\ \\overset{\\to }{AD} & =\\mathbf{d}-\\mathbf{a} \\\\  & =(2\\mathbf{i}+2\\mathbf{k})-(1\\mathbf{j}+3\\mathbf{k}) \\\\  & =2\\mathbf{i}-1\\mathbf{j}-1\\mathbf{k} \\\\  & =⟨2,-1,-1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}0 & 4 & 2 \\\\ 3 & 3 & 2 \\\\ 2 & -1 & -1\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}3 & 2 \\\\ -1 & -1\\end{vmatrix}-4\\cdot \\begin{vmatrix}3 & 2 \\\\ 2 & -1\\end{vmatrix}+2\\cdot \\begin{vmatrix}3 & 3 \\\\ 2 & -1\\end{vmatrix} \\\\  & =-4(3\\cdot -1-2\\cdot 2)+2(3\\cdot -1-3\\cdot 2) \\\\  & =28-18 \\\\  & =10.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|10|=10.\n$$"] [17592186295176 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(2\\mathbf{i}-3\\mathbf{j}+4\\mathbf{k})-(-\\mathbf{i}+1\\mathbf{k}) \\\\  & =3\\mathbf{i}-3\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨3,-3,3⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(-2\\mathbf{i}-2\\mathbf{j}+2\\mathbf{k})-(-\\mathbf{i}+1\\mathbf{k}) \\\\  & =-\\mathbf{i}-2\\mathbf{j}+1\\mathbf{k} \\\\  & =⟨-1,-2,1⟩ \\\\ \\overset{\\to }{AD} & =\\mathbf{d}-\\mathbf{a} \\\\  & =(-\\mathbf{j}+5\\mathbf{k})-(-\\mathbf{i}+1\\mathbf{k}) \\\\  & =\\mathbf{i}-\\mathbf{j}+4\\mathbf{k} \\\\  & =⟨1,-1,4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =\\begin{vmatrix}3 & -3 & 3 \\\\ -1 & -2 & 1 \\\\ 1 & -1 & 4\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}-2 & 1 \\\\ -1 & 4\\end{vmatrix}-(-3)\\cdot \\begin{vmatrix}-1 & 1 \\\\ 1 & 4\\end{vmatrix}+3\\cdot \\begin{vmatrix}-1 & -2 \\\\ 1 & -1\\end{vmatrix} \\\\  & =3(-8+1)+3(-4-1)+3(1-(-2)) \\\\  & =-21-15+9 \\\\  & =-27.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-27|=27.\n$$"] [17592186297160 "The area of the quadrilateral $ABCD$ is the sum of the areas of the triangles $△ABD$ and $△BDC$ (see the illustration below).\n\n![](images/cd/cd9363a3cc686ae45f49c982f4b31ad75b7c7897dcf7e8af58e530dba6946e1d.png)\n\nFirst we find the area for $△ABD:$ \n \n\n$$\\begin{aligned}{\\mathcal{A}}_{ABD} & =\\frac{1}{2}\\cdot 6\\cdot 7\\cdot \\operatorname{sin}{50}^{∘} \\\\  & =21\\cdot \\operatorname{sin}{50}^{∘} \\\\  & \\approx 16.086\\hspace{0.167em}9,\\end{aligned}$$\n\nrounded to four decimal places.\n\nNow we find the area for $△BCD:$ \n \n\n$$\\begin{aligned}{\\mathcal{A}}_{BDC} & =\\frac{1}{2}\\cdot 7\\cdot 8\\cdot \\operatorname{sin}{43}^{∘} \\\\  & =28\\cdot \\operatorname{sin}{43}^{∘} \\\\  & \\approx 19.096\\hspace{0.167em}0,\\end{aligned}$$\n\nrounded to four decimal places.\n\nFinally, we add together the areas of our two triangles to determine the area of $ABCD:$\n\n$$\\begin{aligned}{\\mathcal{A}}_{ABCD} & ={\\mathcal{A}}_{ABD}+{\\mathcal{A}}_{BDC} \\\\  & \\approx 16.086\\hspace{0.167em}9+19.096\\hspace{0.167em}0 \\\\  & \\approx 35.182\\hspace{0.167em}9\\end{aligned}$$\n\nConsequently, to the **nearest tenth**, the area of the quadrilateral $ABCD$ is $35.2.$"] [17592186297161 "The diagonal $\\overset{―}{AC}$ divides the parallelogram into two congruent triangles. Therefore, the area of the parallelogram is twice the area of $△ACB$ (see the illustration below).\n\n![](images/d6/d6a654d3154ba8af8fc4f7654e62c6bacfede7017322aeed21a143e2634dcd14.png)\n\n Computing the area of $△ACB,$ we find\n \n\n$$\\begin{aligned}{\\mathcal{A}}_{ACB} & =\\frac{1}{2}(4)(8)\\operatorname{sin}{120}^{∘} \\\\  & =16\\cdot \\operatorname{sin}{120}^{∘} \\\\  & \\approx 13.856,\\end{aligned}$$\n\nrounded to three decimal places. Consequently,\n\n$$\\begin{aligned}{\\mathcal{A}}_{ABCD} & =2{\\mathcal{A}}_{ACB} \\\\  & =2\\cdot 13.856 \\\\  & =27.712.\\end{aligned}$$\n\nSo, to the **nearest integer**, the area of the parallelogram is $28.$"] [17592186297162 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 6\\cdot 4\\cdot \\operatorname{sin}{75}^{∘} \\\\  & =\\frac{1}{2}\\cdot 24\\cdot \\operatorname{sin}{75}^{∘} \\\\  & =11.591… \\\\  & \\approx 12{\\text{ cm}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =12-10 \\\\  & =2{\\text{ cm}}^{2}.\\end{aligned}$$"] [17592186297163 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 7\\cdot \\operatorname{sin}{45}^{∘} \\\\  & =\\frac{1}{2}\\cdot 28\\cdot \\operatorname{sin}{45}^{∘} \\\\  & =9.899… \\\\  & \\approx 10{\\text{ m}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =10-7 \\\\  & =3{\\text{ mm}}^{2}.\\end{aligned}$$"] [17592186297164 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 2.5\\cdot 6\\cdot \\operatorname{sin}{63}^{∘} \\\\  & =\\frac{1}{2}\\cdot 15\\cdot \\operatorname{sin}{63}^{∘} \\\\  & =6.682… \\\\  & \\approx 7{\\text{ km}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =7-5 \\\\  & =2{\\text{ km}}^{2}.\\end{aligned}$$"] [17592186297165 "Let's start by finding the area of $△ABD.$ We get \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}A \\\\  & =\\frac{1}{2}\\cdot 5\\cdot 6.5\\cdot \\operatorname{sin}{90}^{∘} \\\\  & =\\frac{1}{2}\\cdot 32.5\\cdot \\operatorname{sin}{90}^{∘} \\\\  & \\approx 16{\\text{ mi}}^{2}\\end{aligned}$$\n\nrounded to the **nearest integer**.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\\begin{aligned}{\\mathcal{A}}_{\\mathrm{△}BCD} & ={\\mathcal{A}}_{\\mathrm{△}ABD}-{\\mathcal{A}}_{ABCD} \\\\  & =16-13 \\\\  & =3{\\text{ mi}}^{2}.\\end{aligned}$$"] [17592186302170 "Using the constant multiple and the sum rules, we have\n\n$$\n(2\\mathbf{g}(t)-\\mathbf{h}(t))^{'}=2{\\mathbf{g}}^{'}(t)-{\\mathbf{h}}^{'}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{\\mathbf{g}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}\\operatorname{cos}t,\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(3t-3),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(-{t}^{2})⟩ \\\\  & =⟨-\\operatorname{sin}t,\\hspace{0.222em}3,\\hspace{0.222em}-2t⟩ \\\\ {\\mathbf{h}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}\\operatorname{sin}t,\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(-t),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}4⟩ \\\\  & =⟨\\operatorname{cos}t,\\hspace{0.222em}-1,\\hspace{0.222em}0⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(2\\mathbf{g}(t)-\\mathbf{h}(t))^{'} & =2{\\mathbf{g}}^{'}(t)-{\\mathbf{h}}^{'}(t) \\\\  & =2⟨-\\operatorname{sin}t,\\hspace{0.222em}3,\\hspace{0.222em}-2t⟩-⟨\\operatorname{cos}t,\\hspace{0.222em}-1,\\hspace{0.222em}0⟩ \\\\  & =⟨-2\\operatorname{sin}t,\\hspace{0.222em}6,\\hspace{0.222em}-4t⟩-⟨\\operatorname{cos}t,\\hspace{0.222em}-1,\\hspace{0.222em}0⟩ \\\\  & =⟨-2\\operatorname{sin}t-\\operatorname{cos}t,\\hspace{0.222em}6-(-1),\\hspace{0.222em}-4t-0⟩ \\\\  & =⟨-2\\operatorname{sin}t-\\operatorname{cos}t,\\hspace{0.222em}7,\\hspace{0.222em}-4t⟩\\end{aligned}\n$$"] [17592186302171 "Using the chain rule, we can write \n\n$$\n(\\mathbf{f}∘u)^{'}(t)={\\mathbf{f}}^{'}(u(t)){u}^{'}(t)\n$$\n\nNow, let's find the derivatives of each function.\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(u) & =\\frac{\\text{d}}{\\text{d}u}u\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}u}2u\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}3u\\hspace{0.167em}\\mathbf{k} \\\\  & =\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}+3\\hspace{0.167em}\\mathbf{k} \\\\ {u}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}) \\\\  & =2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(\\mathbf{f}∘u)^{'}(t) & =\\mathbf{f}'(u(t))u'(t) \\\\  & =(\\mathbf{i}+2\\hspace{0.167em}\\mathbf{j}+3\\hspace{0.167em}\\mathbf{k})2t \\\\  & =2t\\hspace{0.167em}\\mathbf{i}+4t\\hspace{0.167em}\\mathbf{j}+6t\\hspace{0.167em}\\mathbf{k}\\end{aligned}\n$$"] [17592186302172 "Using the sum rule, we can write\n\n$$\n(\\mathbf{f}(t)+\\mathbf{g}(t)+\\mathbf{h}(t))^{'}={\\mathbf{f}}^{'}(t)+{\\mathbf{g}}^{'}(t)+{\\mathbf{h}}^{'}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{\\mathbf{f}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-1),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(0),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(1)⟩ \\\\  & =⟨0,0,0⟩ \\\\ {\\mathbf{g}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-t),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(0),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨-1,0,1⟩ \\\\ {\\mathbf{h}}^{'}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-{t}^{2}),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}(0),\\hspace{0.222em}\\frac{\\text{d}}{\\text{d}t}({t}^{2})⟩ \\\\  & =⟨-2t,\\hspace{0.222em}0,\\hspace{0.222em}2t⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(\\mathbf{f}(t)+\\mathbf{g}(t)+\\mathbf{h}(t))^{'} & ={\\mathbf{f}}^{'}(t)+{\\mathbf{g}}^{'}(t)+{\\mathbf{h}}^{'}(t) \\\\  & =⟨0,0,0⟩+⟨-1,0,1⟩+⟨-2t,\\hspace{0.222em}0,\\hspace{0.222em}2t⟩ \\\\  & =⟨-2t-1,\\hspace{0.222em}0,\\hspace{0.222em}2t+1⟩\\end{aligned}\n$$"] [17592186302392 "Using the dot product rule, we can write:\n\n$$({\\mathbf{f}}^{'}\\cdot \\mathbf{f})^{'}(t)={\\mathbf{f}}^{''}(t)\\cdot \\mathbf{f}(t)+{\\mathbf{f}}^{'}(t)\\cdot {\\mathbf{f}}^{'}(t)$$\n\nLet's now find the first and second derivative of the function.\n\n$$\\begin{aligned}{\\mathbf{f}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})\\hspace{0.167em}\\mathbf{i}-\\frac{\\text{d}}{\\text{d}t}(2t)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(1+5{t}^{2})\\hspace{0.167em}\\mathbf{k} \\\\  & =2\\cdot 3{t}^{2}\\hspace{0.167em}\\mathbf{i}-2\\hspace{0.167em}\\mathbf{j}+5\\cdot 2t\\hspace{0.167em}\\mathbf{k} \\\\  & =6{t}^{2}\\hspace{0.167em}\\mathbf{i}-2\\hspace{0.167em}\\mathbf{j}+10t\\hspace{0.167em}\\mathbf{k} \\\\ {\\mathbf{f}}^{''}(t) & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2})\\hspace{0.167em}\\mathbf{i}-\\frac{\\text{d}}{\\text{d}t}(2)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(10t)\\hspace{0.167em}\\mathbf{k} \\\\  & =6\\cdot 2t\\hspace{0.167em}\\mathbf{i}+(0)\\mathbf{j}+(10)\\hspace{0.167em}\\mathbf{k} \\\\  & =12t\\hspace{0.167em}\\mathbf{i}+10\\hspace{0.167em}\\mathbf{k}\\end{aligned}$$\n\nTherefore, we obtain:\n\n$$\\begin{aligned}({\\mathbf{f}}^{'}\\cdot \\mathbf{f})^{'}(t) & ={\\mathbf{f}}^{''}(t)\\cdot \\mathbf{f}(t)+{\\mathbf{f}}^{'}(t)\\cdot {\\mathbf{f}}^{'}(t) \\\\  & =(12t\\hspace{0.167em}\\mathbf{i}+10\\hspace{0.167em}\\mathbf{k})\\cdot (2{t}^{3}\\hspace{0.167em}\\mathbf{i}-2t\\hspace{0.167em}\\mathbf{j}+(1+5{t}^{2})\\hspace{0.167em}\\mathbf{k})+(6{t}^{2}\\hspace{0.167em}\\mathbf{i}-2\\hspace{0.167em}\\mathbf{j}+10t\\hspace{0.167em}\\mathbf{k})\\cdot (6{t}^{2}\\hspace{0.167em}\\mathbf{i}-2\\hspace{0.167em}\\mathbf{j}+10t\\hspace{0.167em}\\mathbf{k}) \\\\  & =(12t\\cdot 2{t}^{3}+0\\cdot (-2t)+10\\cdot (1+5{t}^{2}))+((6{t}^{2})^{2}+(-2)^{2}+(10t)^{2}) \\\\  & =24{t}^{4}+0+10+50{t}^{2}+36{t}^{4}+4+100{t}^{2} \\\\  & =60{t}^{4}+150{t}^{2}+14\\end{aligned}$$"] [17592186302426 "Using the dot product rule, we can write: \n\n$$({\\mathbf{f}}^{'}\\cdot \\mathbf{f})^{'}(t)={\\mathbf{f}}^{''}(t)\\cdot \\mathbf{f}(t)+{\\mathbf{f}}^{'}(t)\\cdot {\\mathbf{f}}^{'}(t)$$\n\nLet's now fin