#{[{:db/id #edb/ref 17592186054745 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054543 :question/id #uuid "890afebc-d130-5dbc-aaf7-c2cd4db193f6" :question/math-academy-id "e-4100" :question/problem "Use a calculator to evaluate $\\log_3 (7)$ rounded to $2$ decimal places." :question/worked-solution "Let's calculate $\\log_3 (7)$ by changing the base $3$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n\\log_a X = \\dfrac {\\log_b X} {\\log_b a}\n$$\n\nIn our case, we have $a=3,$ $X =7,$ and $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{3}⁡(7) & =\\frac{{log}_{10}⁡(7)}{{log}_{10}⁡(3)} \\\\  & =\\frac{\\operatorname{log}⁡(7)}{\\operatorname{log}⁡(3)} \\\\  & ≈\\frac{0.845\\,10}{0.477\\,12} \\\\  & ≈1.77.\\end{aligned}\n$$" :task-item/_content [{:db/id #edb/ref 17592186651031}]} :knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/question-generator {:db/id #edb/ref 17592186576204 :question-generator/id #uuid "e1af09fd-36f2-5604-86b3-514e0a319ea2" :question-generator/script "generators/c5/c50e294e9eb83758384d454d26fc830c30a45c00b9380277d402f4a491e255eb/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186055135 :question/answer-fields [{:answer-field/id #uuid "72602a4a-4e53-58f7-858c-d6211ef41510" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186052164}] :question/id #uuid "659e95e5-e2c3-56ae-9772-b37de85ed34a" :question/math-academy-id "q-227376" :question/problem "Use a calculator to evaluate $\\log_{9} (24)$ rounded to $2$ decimal places.$\\log_{9} (24) \\approx$\n{{field-1}}\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true} {:db/id #edb/ref 17592186055182 :question/answer-fields [{:answer-field/id #uuid "45766e3a-77d4-5d38-9e15-22081a4f5b5d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186052383}] :que