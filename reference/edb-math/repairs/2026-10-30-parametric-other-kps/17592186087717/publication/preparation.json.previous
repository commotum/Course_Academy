5-9b57-c560114d7eda\"] [:db/add \"387fc7bd-f009-5755-9b57-c560114d7eda\" :answer/type :answer.type/math] [:db/add \"387fc7bd-f009-5755-9b57-c560114d7eda\" :answer/value \"1\"] [:db/ensure \"387fc7bd-f009-5755-9b57-c560114d7eda\" :answer/validate] [:db/add \"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/id #uuid \"c7a26bde-522f-51ad-b6be-4e4cf1093416\"] [:db/add \"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/key \"field-3\"] [:db/add \"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/type :answer-field.type/blank] [:db/add \"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/choices \"387fc7bd-f009-5755-9b57-c560114d7eda\"] [:db/add \"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/correct \"387fc7bd-f009-5755-9b57-c560114d7eda\"] [:db/ensure \"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/validate] [:db/add \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/id #uuid \"ddd79350-3c36-5a68-8e1f-be7ece233413\"] [:db/add \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=3 t,\\\\qquad y=t^{2} + 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=3 \\\\left(-2\\\\right)=-6$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-6$ | $-3$ | $0$ |\\n| $y$ | {{field-2}} | $2$ | {{field-3}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $3$ | {{field-1}} |\\n| $y$ | $2$ | $5$ |\"] [:db/add \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/worked-solution \"The missing entry is in the $x$-row under $t=2$. Substitute into $x=3 t$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=3 \\\\left(2\\\\right) \\\\\\\\ &=6\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=t^{2} + 1$:\\n\\n$$\\n\\\\begin{aligned}y(-2) &=\\\\left(-2\\\\right)^{2} + 1 \\\\\\\\ &=5\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t^{2} + 1$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\left(0\\\\right)^{2} + 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-6$ | $-3$ | $0$ |\\n| $y$ | $5$ | $2$ | $1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $3$ | $6$ |\\n| $y$ | $2$ | $5$ |\"] [:db/add \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/difficulty :question.difficulty/easy] [:db/add \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/answer-fields \"04c90db2-1857-5950-a1c1-ef2dd432e5ee\"] [:db/add \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/answer-fields \"74ef9f89-147e-5d53-85b1-f785b0ca607c\"] [:db/add \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/answer-fields \"c7a26bde-522f-51ad-b6be-4e4cf1093416\"] [:db/ensure \"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"ddd79350-3c36-5a68-8e1f-be7ece233413\"] [:db/add \"20b2318e-6dee-544c-8bf9-4ed392af2343\" :answer/id #uuid \"20b2318e-6dee-544c-8bf9-4ed392af2343\"] [:db/add \"20b2318e-6dee-544c-8bf9-4ed392af2343\" :answer/type :answer.type/math] [:db/add \"20b2318e-6dee-544c-8bf9-4ed392af2343\" :answer/value \"2\"] [:db/ensure \"20b2318e-6dee-544c-8bf9-4ed392af2343\" :answer/validate] [:db/add \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/id #uuid \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\"] [:db/add \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/key \"field-1\"] [:db/add \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/type :answer-field.type/blank] [:db/add \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/choices \"20b2318e-6dee-544c-8bf9-4ed392af2343\"] [:db/add \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/correct \"20b2318e-6dee-544c-8bf9-4ed392af2343\"] [:db/ensure \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/validate] [:db/add \"059a2954-95ef-5c80-9985-aa1f54b274fd\" :answer/id #uuid \"059a2954-95ef-5c80-9985-aa1f54b274fd\"] [:db/add \"059a2954-95ef-5c80-9985-aa1f54b274fd\" :answer/type :answer.type/math] [:db/add \"059a2954-95ef-5c80-9985-aa1f54b274fd\" :answer/value \"-6\"] [:db/ensure \"059a2954-95ef-5c80-9985-aa1f54b274fd\" :answer/validate] [:db/add \"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/id #uuid \"9eca4b51-8196-54d7-a291-d43148ce0620\"] [:db/add \"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/key \"field-2\"] [:db/add \"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/type :answer-field.type/blank] [:db/add \"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/choices \"059a2954-95ef-5c80-9985-aa1f54b274fd\"] [:db/add \"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/correct \"059a2954-95ef-5c80-9985-aa1f54b274fd\"] [:db/ensure \"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/validate] [:db/add \"3274b331-4f5b-5a6b-882c-4168c288e5ba\" :answer/id #uuid \"3274b331-4f5b-5a6b-882c-4168c288e5ba\"] [:db/add \"3274b331-4f5b-5a6b-882c-4168c288e5ba\" :answer/type :answer.type/math] [:db/add \"3274b331-4f5b-5a6b-882c-4168c288e5ba\" :answer/value \"-2\"] [:db/ensure \"3274b331-4f5b-5a6b-882c-4168c288e5ba\" :answer/validate] [:db/add \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/id #uuid \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\"] [:db/add \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/key \"field-3\"] [:db/add \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/type :answer-field.type/blank] [:db/add \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/choices \"3274b331-4f5b-5a6b-882c-4168c288e5ba\"] [:db/add \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/correct \"3274b331-4f5b-5a6b-882c-4168c288e5ba\"] [:db/ensure \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/validate] [:db/add \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/id #uuid \"90febdeb-888f-5245-a4c0-d005214c232c\"] [:db/add \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=2 - t^{2},\\\\qquad y=- 3 t - 3,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=2 - \\\\left(-2\\\\right)^{2}=-2$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-2$ | $1$ | {{field-1}} |\\n| $y$ | $3$ | $0$ | $-3$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | {{field-3}} |\\n| $y$ | {{field-2}} | $-9$ |\"] [:db/add \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/worked-solution \"The missing entry is in the $x$-row under $t=0$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(0) &=2 - \\\\left(0\\\\right)^{2} \\\\\\\\ &=2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=1$. Substitute into $y=- 3 t - 3$:\\n\\n$$\\n\\\\begin{aligned}y(1) &=- 3 \\\\left(1\\\\right) - 3 \\\\\\\\ &=-6\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=2$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=2 - \\\\left(2\\\\right)^{2} \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-2$ | $1$ | $2$ |\\n| $y$ | $3$ | $0$ | $-3$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $-2$ |\\n| $y$ | $-6$ | $-9$ |\"] [:db/add \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/difficulty :question.difficulty/easy] [:db/add \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/answer-fields \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\"] [:db/add \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/answer-fields \"9eca4b51-8196-54d7-a291-d43148ce0620\"] [:db/add \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/answer-fields \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\"] [:db/ensure \"90febdeb-888f-5245-a4c0-d005214c232c\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"90febdeb-888f-5245-a4c0-d005214c232c\"] [:db/add \"326507c0-898e-50fd-a26b-d5d81c068911\" :answer/id #uuid \"326507c0-898e-50fd-a26b-d5d81c068911\"] [:db/add \"326507c0-898e-50fd-a26b-d5d81c068911\" :answer/type :answer.type/math] [:db/add \"326507c0-898e-50fd-a26b-d5d81c068911\" :answer/value \"3\"] [:db/ensure \"326507c0-898e-50fd-a26b-d5d81c068911\" :answer/validate] [:db/add \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/id #uuid \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\"] [:db/add \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/key \"field-1\"] [:db/add \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/type :answer-field.type/blank] [:db/add \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/choices \"326507c0-898e-50fd-a26b-d5d81c068911\"] [:db/add \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/correct \"326507c0-898e-50fd-a26b-d5d81c068911\"] [:db/ensure \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/validate] [:db/add \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\" :answer/id #uuid \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\"] [:db/add \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\" :answer/type :answer.type/math] [:db/add \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\" :answer/value \"-2\"] [:db/ensure \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\" :answer/validate] [:db/add \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/id #uuid \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\"] [:db/add \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/key \"field-2\"] [:db/add \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/type :answer-field.type/blank] [:db/add \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/choices \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\"] [:db/add \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/correct \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\"] [:db/ensure \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/validate] [:db/add \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\" :answer/id #uuid \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\"] [:db/add \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\" :answer/type :answer.type/math] [:db/add \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\" :answer/value \"1\"] [:db/ensure \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\" :answer/validate] [:db/add \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/id #uuid \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\"] [:db/add \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/key \"field-3\"] [:db/add \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/type :answer-field.type/blank] [:db/add \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/choices \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\"] [:db/add \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/correct \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\"] [:db/ensure \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/validate] [:db/add \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/id #uuid \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\"] [:db/add \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=2 - t^{2},\\\\qquad y=2 t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(0)=2 - \\\\left(0\\\\right)^{2}=2$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-2}} | {{field-3}} | $2$ |\\n| $y$ | $-5$ | $-3$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $-2$ |\\n| $y$ | $1$ | {{field-1}} |\"] [:db/add \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/worked-solution \"The missing entry is in the $y$-row under $t=2$. Substitute into $y=2 t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=2 \\\\left(2\\\\right) - 1 \\\\\\\\ &=3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=2 - \\\\left(-2\\\\right)^{2} \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=2 - \\\\left(-1\\\\right)^{2} \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-2$ | $1$ | $2$ |\\n| $y$ | $-5$ | $-3$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $-2$ |\\n| $y$ | $1$ | $3$ |\"] [:db/add \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/difficulty :question.difficulty/easy] [:db/add \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/answer-fields \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\"] [:db/add \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/answer-fields \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\"] [:db/add \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/answer-fields \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\"] [:db/ensure \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\"] [:db/add \"b819a116-e504-5659-bd6b-09de617bbb38\" :answer/id #uuid \"b819a116-e504-5659-bd6b-09de617bbb38\"] [:db/add \"b819a116-e504-5659-bd6b-09de617bbb38\" :answer/type :answer.type/math] [:db/add \"b819a116-e504-5659-bd6b-09de617bbb38\" :answer/value \"-2\"] [:db/ensure \"b819a116-e504-5659-bd6b-09de617bbb38\" :answer/validate] [:db/add \"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/id #uuid \"7f551e3a-65cb-54f0-9930-03078b3b3a33\"] [:db/add \"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/key \"field-1\"] [:db/add \"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/type :answer-field.type/blank] [:db/add \"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/choices \"b819a116-e504-5659-bd6b-09de617bbb38\"] [:db/add \"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/correct \"b819a116-e504-5659-bd6b-09de617bbb38\"] [:db/ensure \"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/validate] [:db/add \"b09f99c5-b0ea-517e-9f73-1efa4902f749\" :answer/id #uuid \"b09f99c5-b0ea-517e-9f73-1efa4902f749\"] [:db/add \"b09f99c5-b0ea-517e-9f73-1efa4902f749\" :answer/type :answer.type/math] [:db/add \"b09f99c5-b0ea-517e-9f73-1efa4902f749\" :answer/value \"-3\"] [:db/ensure \"b09f99c5-b0ea-517e-9f73-1efa4902f749\" :answer/validate] [:db/add \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/id #uuid \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\"] [:db/add \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/key \"field-2\"] [:db/add \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/type :answer-field.type/blank] [:db/add \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/choices \"b09f99c5-b0ea-517e-9f73-1efa4902f749\"] [:db/add \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/correct \"b09f99c5-b0ea-517e-9f73-1efa4902f749\"] [:db/ensure \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/validate] [:db/add \"b194ab8c-7e43-562b-8587-018c40daf5aa\" :answer/id #uuid \"b194ab8c-7e43-562b-8587-018c40daf5aa\"] [:db/add \"b194ab8c-7e43-562b-8587-018c40daf5aa\" :answer/type :answer.type/math] [:db/add \"b194ab8c-7e43-562b-8587-018c40daf5aa\" :answer/value \"-5\"] [:db/ensure \"b194ab8c-7e43-562b-8587-018c40daf5aa\" :answer/validate] [:db/add \"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/id #uuid \"64ba65b8-e4f8-5e86-9594-a9aed605d124\"] [:db/add \"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/key \"field-3\"] [:db/add \"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/type :answer-field.type/blank] [:db/add \"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/choices \"b194ab8c-7e43-562b-8587-018c40daf5aa\"] [:db/add \"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/correct \"b194ab8c-7e43-562b-8587-018c40daf5aa\"] [:db/ensure \"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/validate] [:db/add \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/id #uuid \"27567bdc-9f35-5be9-8b03-2accae833e9c\"] [:db/add \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- t^{2} - 1,\\\\qquad y=- t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(0)=- \\\\left(0\\\\right)^{2} - 1=-1$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-3}} | {{field-1}} | $-1$ |\\n| $y$ | $1$ | $0$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $-5$ |\\n| $y$ | $-2$ | {{field-2}} |\"] [:db/add \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/worked-solution \"The missing entry is in the $x$-row under $t=-1$. Substitute into $x=- t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=- \\\\left(-1\\\\right)^{2} - 1 \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=- \\\\left(2\\\\right) - 1 \\\\\\\\ &=-3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=- t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=- \\\\left(-2\\\\right)^{2} - 1 \\\\\\\\ &=-5\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-5$ | $-2$ | $-1$ |\\n| $y$ | $1$ | $0$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $-5$ |\\n| $y$ | $-2$ | $-3$ |\"] [:db/add \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/difficulty :question.difficulty/easy] [:db/add \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/answer-fields \"7f551e3a-65cb-54f0-9930-03078b3b3a33\"] [:db/add \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/answer-fields \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\"] [:db/add \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/answer-fields \"64ba65b8-e4f8-5e86-9594-a9aed605d124\"] [:db/ensure \"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"27567bdc-9f35-5be9-8b03-2accae833e9c\"] [:db/add \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\" :answer/id #uuid \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\"] [:db/add \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\" :answer/type :answer.type/math] [:db/add \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\" :answer/value \"0\"] [:db/ensure \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\" :answer/validate] [:db/add \"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/id #uuid \"a13f25ae-650e-520c-a28a-2f653c201bcd\"] [:db/add \"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/key \"field-1\"] [:db/add \"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/type :answer-field.type/blank] [:db/add \"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/choices \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\"] [:db/add \"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/correct \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\"] [:db/ensure \"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/validate] [:db/add \"35ac1f29-c398-5408-a497-d44f19ed28f0\" :answer/id #uuid \"35ac1f29-c398-5408-a497-d44f19ed28f0\"] [:db/add \"35ac1f29-c398-5408-a497-d44f19ed28f0\" :answer/type :answer.type/math] [:db/add \"35ac1f29-c398-5408-a497-d44f19ed28f0\" :answer/value \"-7\"] [:db/ensure \"35ac1f29-c398-5408-a497-d44f19ed28f0\" :answer/validate] [:db/add \"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/id #uuid \"b9f42515-6266-5f99-be4c-b325c3057d63\"] [:db/add \"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/key \"field-2\"] [:db/add \"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/type :answer-field.type/blank] [:db/add \"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/choices \"35ac1f29-c398-5408-a497-d44f19ed28f0\"] [:db/add \"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/correct \"35ac1f29-c398-5408-a497-d44f19ed28f0\"] [:db/ensure \"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/validate] [:db/add \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\" :answer/id #uuid \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\"] [:db/add \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\" :answer/type :answer.type/math] [:db/add \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\" :answer/value \"3\"] [:db/ensure \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\" :answer/validate] [:db/add \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/id #uuid \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\"] [:db/add \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/key \"field-3\"] [:db/add \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/type :answer-field.type/blank] [:db/add \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/choices \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\"] [:db/add \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/correct \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\"] [:db/ensure \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/validate] [:db/add \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/id #uuid \"dd116258-ab80-55bb-94e9-3a3ddb480df7\"] [:db/add \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=3 t - 1,\\\\qquad y=t^{2} - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-1)=3 \\\\left(-1\\\\right) - 1=-4$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-2}} | $-4$ | $-1$ |\\n| $y$ | $3$ | {{field-1}} | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $2$ | $5$ |\\n| $y$ | $0$ | {{field-3}} |\"] [:db/add \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/worked-solution \"The missing entry is in the $y$-row under $t=-1$. Substitute into $y=t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}y(-1) &=\\\\left(-1\\\\right)^{2} - 1 \\\\\\\\ &=0\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=3 t - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=3 \\\\left(-2\\\\right) - 1 \\\\\\\\ &=-7\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=\\\\left(2\\\\right)^{2} - 1 \\\\\\\\ &=3\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-7$ | $-4$ | $-1$ |\\n| $y$ | $3$ | $0$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $2$ | $5$ |\\n| $y$ | $0$ | $3$ |\"] [:db/add \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/difficulty :question.difficulty/easy] [:db/add \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/answer-fields \"a13f25ae-650e-520c-a28a-2f653c201bcd\"] [:db/add \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/answer-fields \"b9f42515-6266-5f99-be4c-b325c3057d63\"] [:db/add \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/answer-fields \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\"] [:db/ensure \"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"dd116258-ab80-55bb-94e9-3a3ddb480df7\"] [:db/add \"2b814dd9-4f38-5c2d-9fae-541de879bc69\" :answer/id #uuid \"2b814dd9-4f38-5c2d-9fae-541de879bc69\"] [:db/add \"2b814dd9-4f38-5c2d-9fae-541de879bc69\" :answer/type :answer.type/math] [:db/add \"2b814dd9-4f38-5c2d-9fae-541de879bc69\" :answer/value \"\\\\sqrt{7}\"] [:db/ensure \"2b814dd9-4f38-5c2d-9fae-541de879bc69\" :answer/validate] [:db/add \"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/id #uuid \"9f08cea1-222d-5521-a1b6-f722bf34659a\"] [:db/add \"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/key \"field-1\"] [:db/add \"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/type :answer-field.type/blank] [:db/add \"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/choices \"2b814dd9-4f38-5c2d-9fae-541de879bc69\"] [:db/add \"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/correct \"2b814dd9-4f38-5c2d-9fae-541de879bc69\"] [:db/ensure \"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/validate] [:db/add \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\" :answer/id #uuid \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\"] [:db/add \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\" :answer/type :answer.type/math] [:db/add \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\" :answer/value \"3\"] [:db/ensure \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\" :answer/validate] [:db/add \"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/id #uuid \"e537d01c-3473-5cbc-af40-700bbf907716\"] [:db/add \"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/key \"field-2\"] [:db/add \"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/type :answer-field.type/blank] [:db/add \"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/choices \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\"] [:db/add \"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/correct \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\"] [:db/ensure \"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/validate] [:db/add \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\" :answer/id #uuid \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\"] [:db/add \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\" :answer/type :answer.type/math] [:db/add \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\" :answer/value \"1\"] [:db/ensure \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\" :answer/validate] [:db/add \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/id #uuid \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\"] [:db/add \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/key \"field-3\"] [:db/add \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/type :answer-field.type/blank] [:db/add \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/choices \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\"] [:db/add \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/correct \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\"] [:db/ensure \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/validate] [:db/add \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/id #uuid \"bc401fc2-0741-5e28-ac23-67f5c0316d34\"] [:db/add \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\sqrt{t + 5},\\\\qquad y=t^{2} + t + 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\sqrt{3}$ | $2$ | $\\\\sqrt{5}$ |\\n| $y$ | {{field-2}} | $1$ | {{field-3}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $\\\\sqrt{6}$ | {{field-1}} |\\n| $y$ | $3$ | $7$ |\"] [:db/add \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/worked-solution \"The missing entry is in the $x$-row under $t=2$. Substitute into $x=\\\\sqrt{t + 5}$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=\\\\sqrt{\\\\left(2\\\\right) + 5} \\\\\\\\ &=\\\\sqrt{7}\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=t^{2} + t + 1$:\\n\\n$$\\n\\\\begin{aligned}y(-2) &=\\\\left(-2\\\\right)^{2} + \\\\left(-2\\\\right) + 1 \\\\\\\\ &=3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t^{2} + t + 1$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\left(0\\\\right)^{2} + \\\\left(0\\\\right) + 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\sqrt{3}$ | $2$ | $\\\\sqrt{5}$ |\\n| $y$ | $3$ | $1$ | $1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $\\\\sqrt{6}$ | $\\\\sqrt{7}$ |\\n| $y$ | $3$ | $7$ |\"] [:db/add \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/difficulty :question.difficulty/moderate] [:db/add \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/answer-fields \"9f08cea1-222d-5521-a1b6-f722bf34659a\"] [:db/add \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/answer-fields \"e537d01c-3473-5cbc-af40-700bbf907716\"] [:db/add \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/answer-fields \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\"] [:db/ensure \"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"bc401fc2-0741-5e28-ac23-67f5c0316d34\"] [:db/add \"be8f22ce-afae-5606-b438-18f3dc59e682\" :answer/id #uuid \"be8f22ce-afae-5606-b438-18f3dc59e682\"] [:db/add \"be8f22ce-afae-5606-b438-18f3dc59e682\" :answer/type :answer.type/math] [:db/add \"be8f22ce-afae-5606-b438-18f3dc59e682\" :answer/value \"-5\"] [:db/ensure \"be8f22ce-afae-5606-b438-18f3dc59e682\" :answer/validate] [:db/add \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/id #uuid \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\"] [:db/add \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/key \"field-1\"] [:db/add \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/type :answer-field.type/blank] [:db/add \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/choices \"be8f22ce-afae-5606-b438-18f3dc59e682\"] [:db/add \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/correct \"be8f22ce-afae-5606-b438-18f3dc59e682\"] [:db/ensure \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/validate] [:db/add \"bbb22633-47e1-508a-af16-2a7918763d8c\" :answer/id #uuid \"bbb22633-47e1-508a-af16-2a7918763d8c\"] [:db/add \"bbb22633-47e1-508a-af16-2a7918763d8c\" :answer/type :answer.type/math] [:db/add \"bbb22633-47e1-508a-af16-2a7918763d8c\" :answer/value \"1\"] [:db/ensure \"bbb22633-47e1-508a-af16-2a7918763d8c\" :answer/validate] [:db/add \"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/id #uuid \"6885b268-5994-5727-8ed7-801748d29ac1\"] [:db/add \"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/key \"field-2\"] [:db/add \"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/type :answer-field.type/blank] [:db/add \"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/choices \"bbb22633-47e1-508a-af16-2a7918763d8c\"] [:db/add \"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/correct \"bbb22633-47e1-508a-af16-2a7918763d8c\"] [:db/ensure \"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/validate] [:db/add \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\" :answer/id #uuid \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\"] [:db/add \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\" :answer/type :answer.type/math] [:db/add \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\" :answer/value \"-1\"] [:db/ensure \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\" :answer/validate] [:db/add \"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/id #uuid \"4f0a4ce2-be81-567f-bf25-76cc6334194f\"] [:db/add \"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/key \"field-3\"] [:db/add \"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/type :answer-field.type/blank] [:db/add \"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/choices \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\"] [:db/add \"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/correct \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\"] [:db/ensure \"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/validate] [:db/add \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/id #uuid \"ae109e7c-040d-5915-83ac-8deca83290cb\"] [:db/add \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- t^{3} - 2 t - 2,\\\\qquad y=t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $10$ | $1$ | $-2$ |\\n| $y$ | $-3$ | $-2$ | {{field-3}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | {{field-1}} | $-14$ |\\n| $y$ | $0$ | {{field-2}} |\"] [:db/add \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/worked-solution \"The missing entry is in the $x$-row under $t=1$. Substitute into $x=- t^{3} - 2 t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(1) &=- \\\\left(1\\\\right)^{3} - 2 \\\\left(1\\\\right) - 2 \\\\\\\\ &=-5\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=\\\\left(2\\\\right) - 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\left(0\\\\right) - 1 \\\\\\\\ &=-1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $10$ | $1$ | $-2$ |\\n| $y$ | $-3$ | $-2$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-5$ | $-14$ |\\n| $y$ | $0$ | $1$ |\"] [:db/add \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/difficulty :question.difficulty/moderate] [:db/add \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/answer-fields \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\"] [:db/add \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/answer-fields \"6885b268-5994-5727-8ed7-801748d29ac1\"] [:db/add \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/answer-fields \"4f0a4ce2-be81-567f-bf25-76cc6334194f\"] [:db/ensure \"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"ae109e7c-040d-5915-83ac-8deca83290cb\"] [:db/add \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\" :answer/id #uuid \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\"] [:db/add \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\" :answer/type :answer.type/math] [:db/add \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\" :answer/value \"- \\\\sqrt{5}\"] [:db/ensure \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\" :answer/validate] [:db/add \"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/id #uuid \"e71c11b6-9ba8-5deb-b35c-ce927364c244\"] [:db/add \"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/key \"field-1\"] [:db/add \"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/type :answer-field.type/blank] [:db/add \"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/choices \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\"] [:db/add \"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/correct \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\"] [:db/ensure \"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/validate] [:db/add \"a6fa9117-0a92-5802-b33f-60ef4f297dea\" :answer/id #uuid \"a6fa9117-0a92-5802-b33f-60ef4f297dea\"] [:db/add \"a6fa9117-0a92-5802-b33f-60ef4f297dea\" :answer/type :answer.type/math] [:db/add \"a6fa9117-0a92-5802-b33f-60ef4f297dea\" :answer/value \"1\"] [:db/ensure \"a6fa9117-0a92-5802-b33f-60ef4f297dea\" :answer/validate] [:db/add \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/id #uuid \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\"] [:db/add \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/key \"field-2\"] [:db/add \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/type :answer-field.type/blank] [:db/add \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/choices \"a6fa9117-0a92-5802-b33f-60ef4f297dea\"] [:db/add \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/correct \"a6fa9117-0a92-5802-b33f-60ef4f297dea\"] [:db/ensure \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/validate] [:db/add \"e0f88b88-856f-5030-aa8d-8343fa9b372f\" :answer/id #uuid \"e0f88b88-856f-5030-aa8d-8343fa9b372f\"] [:db/add \"e0f88b88-856f-5030-aa8d-8343fa9b372f\" :answer/type :answer.type/math] [:db/add \"e0f88b88-856f-5030-aa8d-8343fa9b372f\" :answer/value \"-2\"] [:db/ensure \"e0f88b88-856f-5030-aa8d-8343fa9b372f\" :answer/validate] [:db/add \"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/id #uuid \"6c97f634-6131-5d50-86cb-2461edfb42d1\"] [:db/add \"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/key \"field-3\"] [:db/add \"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/type :answer-field.type/blank] [:db/add \"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/choices \"e0f88b88-856f-5030-aa8d-8343fa9b372f\"] [:db/add \"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/correct \"e0f88b88-856f-5030-aa8d-8343fa9b372f\"] [:db/ensure \"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/validate] [:db/add \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/id #uuid \"9041a575-6f1d-552b-b837-3cb6733640f8\"] [:db/add \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- \\\\sqrt{t + 3},\\\\qquad y=t^{2} - t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $- \\\\sqrt{2}$ | $- \\\\sqrt{3}$ |\\n| $y$ | $5$ | {{field-2}} | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | {{field-3}} | {{field-1}} |\\n| $y$ | $-1$ | $1$ |\"] [:db/add \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/worked-solution \"The missing entry is in the $x$-row under $t=2$. Substitute into $x=- \\\\sqrt{t + 3}$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=- \\\\sqrt{\\\\left(2\\\\right) + 3} \\\\\\\\ &=- \\\\sqrt{5}\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-1$. Substitute into $y=t^{2} - t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(-1) &=\\\\left(-1\\\\right)^{2} - \\\\left(-1\\\\right) - 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=1$. Substitute into $x=- \\\\sqrt{t + 3}$:\\n\\n$$\\n\\\\begin{aligned}x(1) &=- \\\\sqrt{\\\\left(1\\\\right) + 3} \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $- \\\\sqrt{2}$ | $- \\\\sqrt{3}$ |\\n| $y$ | $5$ | $1$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $- \\\\sqrt{5}$ |\\n| $y$ | $-1$ | $1$ |\"] [:db/add \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/difficulty :question.difficulty/moderate] [:db/add \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/answer-fields \"e71c11b6-9ba8-5deb-b35c-ce927364c244\"] [:db/add \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/answer-fields \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\"] [:db/add \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/answer-fields \"6c97f634-6131-5d50-86cb-2461edfb42d1\"] [:db/ensure \"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"9041a575-6f1d-552b-b837-3cb6733640f8\"] [:db/add \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\" :answer/id #uuid \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\"] [:db/add \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\" :answer/type :answer.type/math] [:db/add \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\" :answer/value \"-2\"] [:db/ensure \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\" :answer/validate] [:db/add \"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/id #uuid \"587ac7af-6290-53d2-9cec-22cb43571473\"] [:db/add \"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/key \"field-1\"] [:db/add \"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/type :answer-field.type/blank] [:db/add \"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/choices \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\"] [:db/add \"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/correct \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\"] [:db/ensure \"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/validate] [:db/add \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\" :answer/id #uuid \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\"] [:db/add \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\" :answer/type :answer.type/math] [:db/add \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\" :answer/value \"-8\"] [:db/ensure \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\" :answer/validate] [:db/add \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/id #uuid \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\"] [:db/add \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/key \"field-2\"] [:db/add \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/type :answer-field.type/blank] [:db/add \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/choices \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\"] [:db/add \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/correct \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\"] [:db/ensure \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/validate] [:db/add \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\" :answer/id #uuid \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\"] [:db/add \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\" :answer/type :answer.type/math] [:db/add \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\" :answer/value \"0\"] [:db/ensure \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\" :answer/validate] [:db/add \"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/id #uuid \"48b52033-f222-5223-9e70-d97a2e3f828f\"] [:db/add \"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/key \"field-3\"] [:db/add \"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/type :answer-field.type/blank] [:db/add \"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/choices \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\"] [:db/add \"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/correct \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\"] [:db/ensure \"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/validate] [:db/add \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/id #uuid \"38db0909-2ecc-5349-b5e3-51ee53a611f3\"] [:db/add \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- 2 t - 2,\\\\qquad y=- t^{3} + t - 2,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $2$ | {{field-3}} | $-2$ |\\n| $y$ | $4$ | $-2$ | {{field-1}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-4$ | $-6$ |\\n| $y$ | $-2$ | {{field-2}} |\"] [:db/add \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/worked-solution \"The missing entry is in the $y$-row under $t=0$. Substitute into $y=- t^{3} + t - 2$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=- \\\\left(0\\\\right)^{3} + \\\\left(0\\\\right) - 2 \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t^{3} + t - 2$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=- \\\\left(2\\\\right)^{3} + \\\\left(2\\\\right) - 2 \\\\\\\\ &=-8\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=- 2 t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=- 2 \\\\left(-1\\\\right) - 2 \\\\\\\\ &=0\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $2$ | $0$ | $-2$ |\\n| $y$ | $4$ | $-2$ | $-2$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-4$ | $-6$ |\\n| $y$ | $-2$ | $-8$ |\"] [:db/add \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/difficulty :question.difficulty/moderate] [:db/add \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/answer-fields \"587ac7af-6290-53d2-9cec-22cb43571473\"] [:db/add \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/answer-fields \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\"] [:db/add \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/answer-fields \"48b52033-f222-5223-9e70-d97a2e3f828f\"] [:db/ensure \"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"38db0909-2ecc-5349-b5e3-51ee53a611f3\"] [:db/add \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\" :answer/id #uuid \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\"] [:db/add \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\" :answer/type :answer.type/math] [:db/add \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\" :answer/value \"\\\\frac{1}{4}\"] [:db/ensure \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\" :answer/validate] [:db/add \"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/id #uuid \"7481c2c2-315a-530b-aff1-6d7af617d6d1\"] [:db/add \"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/key \"field-1\"] [:db/add \"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/type :answer-field.type/blank] [:db/add \"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/choices \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\"] [:db/add \"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/correct \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\"] [:db/ensure \"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/validate] [:db/add \"62dbfd4e-fb14-5d12-a537-635a8740ea79\" :answer/id #uuid \"62dbfd4e-fb14-5d12-a537-635a8740ea79\"] [:db/add \"62dbfd4e-fb14-5d12-a537-635a8740ea79\" :answer/type :answer.type/math] [:db/add \"62dbfd4e-fb14-5d12-a537-635a8740ea79\" :answer/value \"-2\"] [:db/ensure \"62dbfd4e-fb14-5d12-a537-635a8740ea79\" :answer/validate] [:db/add \"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/id #uuid \"9404ff17-7403-5a13-adf9-9134e85b7ab3\"] [:db/add \"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/key \"field-2\"] [:db/add \"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/type :answer-field.type/blank] [:db/add \"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/choices \"62dbfd4e-fb14-5d12-a537-635a8740ea79\"] [:db/add \"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/correct \"62dbfd4e-fb14-5d12-a537-635a8740ea79\"] [:db/ensure \"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/validate] [:db/add \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\" :answer/id #uuid \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\"] [:db/add \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\" :answer/type :answer.type/math] [:db/add \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\" :answer/value \"4\"] [:db/ensure \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\" :answer/validate] [:db/add \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/id #uuid \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\"] [:db/add \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/key \"field-3\"] [:db/add \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/type :answer-field.type/blank] [:db/add \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/choices \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\"] [:db/add \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/correct \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\"] [:db/ensure \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/validate] [:db/add \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/id #uuid \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\"] [:db/add \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=t^{2} - t - 2,\\\\qquad y=\\\\frac{t + 1}{t + 4},\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-3}} | $0$ | $-2$ |\\n| $y$ | $- \\\\frac{1}{2}$ | $0$ | {{field-1}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | {{field-2}} | $0$ |\\n| $y$ | $\\\\frac{2}{5}$ | $\\\\frac{1}{2}$ |\"] [:db/add \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/worked-solution \"The missing entry is in the $y$-row under $t=0$. Substitute into $y=\\\\frac{t + 1}{t + 4}$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\frac{\\\\left(0\\\\right) + 1}{\\\\left(0\\\\right) + 4} \\\\\\\\ &=\\\\frac{1}{4}\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=1$. Substitute into $x=t^{2} - t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(1) &=\\\\left(1\\\\right)^{2} - \\\\left(1\\\\right) - 2 \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=t^{2} - t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=\\\\left(-2\\\\right)^{2} - \\\\left(-2\\\\right) - 2 \\\\\\\\ &=4\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $4$ | $0$ | $-2$ |\\n| $y$ | $- \\\\frac{1}{2}$ | $0$ | $\\\\frac{1}{4}$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $0$ |\\n| $y$ | $\\\\frac{2}{5}$ | $\\\\frac{1}{2}$ |\"] [:db/add \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/difficulty :question.difficulty/moderate] [:db/add \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/answer-fields \"7481c2c2-315a-530b-aff1-6d7af617d6d1\"] [:db/add \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/answer-fields \"9404ff17-7403-5a13-adf9-9134e85b7ab3\"] [:db/add \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/answer-fields \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\"] [:db/ensure \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\"] [:db/add \"780bd7db-4212-5fe1-8a27-e116c11d14cf\" :answer/id #uuid \"780bd7db-4212-5fe1-8a27-e116c11d14cf\"] [:db/add \"780bd7db-4212-5fe1-8a27-e116c11d14cf\" :answer/type :answer.type/math] [:db/add \"780bd7db-4212-5fe1-8a27-e116c11d14cf\" :answer/value \"- \\\\sqrt{3} - \\\\frac{\\\\sqrt{2}}{2} + 1\"] [:db/ensure \"780bd7db-4212-5fe1-8a27-e116c11d14cf\" :answer/validate] [:db/add \"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/id #uuid \"518825eb-e534-5e92-90ce-890437b8f837\"] [:db/add \"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/key \"result\"] [:db/add \"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/type :answer-field.type/blank] [:db/add \"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/choices \"780bd7db-4212-5fe1-8a27-e116c11d14cf\"] [:db/add \"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/correct \"780bd7db-4212-5fe1-8a27-e116c11d14cf\"] [:db/ensure \"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/validate] [:db/add \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/id #uuid \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\"] [:db/add \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right),\\\\qquad y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $a$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\\n| $y$ | $b$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $c$ | $-1$ |\\n| $y$ | $0$ | $\\\\sqrt{3}$ |\\n\\nFind the exact value of $a+b+c$.\\n\\n{{result}}\"] [:db/add \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=0$. Substitute into $x=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(0\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(0\\\\right) \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $y$-row under $t=-1$. Substitute into $y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(-1\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(- \\\\frac{\\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $x$-row under $t=3$. Substitute into $x=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(3\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}a+b+c \\\\\\\\ =\\\\left(1\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =- \\\\sqrt{3} - \\\\frac{\\\\sqrt{2}}{2} + 1\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\\n| $y$ | $- \\\\sqrt{3}$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\\n| $y$ | $0$ | $\\\\sqrt{3}$ |\"] [:db/add \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/difficulty :question.difficulty/hard] [:db/add \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/answer-fields \"518825eb-e534-5e92-90ce-890437b8f837\"] [:db/ensure \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\"] [:db/add \"402dede8-3999-5fcd-943b-1b05961ef173\" :answer/id #uuid \"402dede8-3999-5fcd-943b-1b05961ef173\"] [:db/add \"402dede8-3999-5fcd-943b-1b05961ef173\" :answer/type :answer.type/math] [:db/add \"402dede8-3999-5fcd-943b-1b05961ef173\" :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\"] [:db/ensure \"402dede8-3999-5fcd-943b-1b05961ef173\" :answer/validate] [:db/add \"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/id #uuid \"b52a37f4-bafd-55a7-b936-9a3922b1f362\"] [:db/add \"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/key \"result\"] [:db/add \"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/type :answer-field.type/blank] [:db/add \"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/choices \"402dede8-3999-5fcd-943b-1b05961ef173\"] [:db/add \"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/correct \"402dede8-3999-5fcd-943b-1b05961ef173\"] [:db/ensure \"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/validate] [:db/add \"0d6985ec-3500-52de-993a-80591e452c25\" :question/id #uuid \"0d6985ec-3500-52de-993a-80591e452c25\"] [:db/add \"0d6985ec-3500-52de-993a-80591e452c25\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right),\\\\qquad y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $a$ | $-1$ | $b$ |\\n| $y$ | $-1$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $0$ | $1$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\frac{1}{2}$ |\\n| $y$ | $1$ | $c$ |\\n\\nFind the exact value of $a-b+c$.\\n\\n{{result}}\"] [:db/add \"0d6985ec-3500-52de-993a-80591e452c25\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=-4$. Substitute into $x=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\sin\\\\left(\\\\frac{\\\\pi \\\\left(-4\\\\right)}{6}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(- \\\\frac{2 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{3}}{2}\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $x$-row under $t=-2$. Substitute into $x=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\sin\\\\left(\\\\frac{\\\\pi \\\\left(-2\\\\right)}{6}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(- \\\\frac{\\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{3}}{2}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=1$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(1\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}a-b+c \\\\\\\\ =\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)-\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)+\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =\\\\frac{\\\\sqrt{2}}{2}\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $- \\\\frac{\\\\sqrt{3}}{2}$ | $-1$ | $- \\\\frac{\\\\sqrt{3}}{2}$ |\\n| $y$ | $-1$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $0$ | $1$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\frac{1}{2}$ |\\n| $y$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\"] [:db/add \"0d6985ec-3500-52de-993a-80591e452c25\" :question/difficulty :question.difficulty/hard] [:db/add \"0d6985ec-3500-52de-993a-80591e452c25\" :question/answer-fields \"b52a37f4-bafd-55a7-b936-9a3922b1f362\"] [:db/ensure \"0d6985ec-3500-52de-993a-80591e452c25\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"0d6985ec-3500-52de-993a-80591e452c25\"] [:db/add \"6ba07cc5-77ee-5689-b056-4d702d8a902b\" :answer/id #uuid \"6ba07cc5-77ee-5689-b056-4d702d8a902b\"] [:db/add \"6ba07cc5-77ee-5689-b056-4d702d8a902b\" :answer/type :answer.type/math] [:db/add \"6ba07cc5-77ee-5689-b056-4d702d8a902b\" :answer/value \"- 2 \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2}\"] [:db/ensure \"6ba07cc5-77ee-5689-b056-4d702d8a902b\" :answer/validate] [:db/add \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/id #uuid \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\"] [:db/add \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/key \"result\"] [:db/add \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/type :answer-field.type/blank] [:db/add \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/choices \"6ba07cc5-77ee-5689-b056-4d702d8a902b\"] [:db/add \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/correct \"6ba07cc5-77ee-5689-b056-4d702d8a902b\"] [:db/ensure \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/validate] [:db/add \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/id #uuid \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\"] [:db/add \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right),\\\\qquad y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $a$ | $0$ |\\n| $y$ | $c$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $2$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $-1$ |\\n| $y$ | $b$ | $\\\\sqrt{3}$ |\\n\\nFind the exact value of $-a+b+c$.\\n\\n{{result}}\"] [:db/add \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=-3$. Substitute into $x=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(-3\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(- \\\\frac{3 \\\\pi}{4}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $y$-row under $t=2$. Substitute into $y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(2\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(\\\\frac{2 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=-4$. Substitute into $y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(-4\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(- \\\\frac{4 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}-a+b+c \\\\\\\\ =-\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right) \\\\\\\\ =- 2 \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2}\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n| $y$ | $- \\\\sqrt{3}$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $2$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $-1$ |\\n| $y$ | $- \\\\sqrt{3}$ | $\\\\sqrt{3}$ |\"] [:db/add \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/difficulty :question.difficulty/hard] [:db/add \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/answer-fields \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\"] [:db/ensure \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\"] [:db/add \"93b636d5-9174-5553-b5f0-d1b76f5a8501\" :answer/id #uuid \"93b636d5-9174-5553-b5f0-d1b76f5a8501\"] [:db/add \"93b636d5-9174-5553-b5f0-d1b76f5a8501\" :answer/type :answer.type/math] [:db/add \"93b636d5-9174-5553-b5f0-d1b76f5a8501\" :answer/value \"\\\\sqrt{2}\"] [:db/ensure \"93b636d5-9174-5553-b5f0-d1b76f5a8501\" :answer/validate] [:db/add \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/id #uuid \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\"] [:db/add \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/key \"result\"] [:db/add \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/type :answer-field.type/blank] [:db/add \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/choices \"93b636d5-9174-5553-b5f0-d1b76f5a8501\"] [:db/add \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/correct \"93b636d5-9174-5553-b5f0-d1b76f5a8501\"] [:db/ensure \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/validate] [:db/add \"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/id #uuid \"dfe7f575-109f-57a8-8469-d7a292b67702\"] [:db/add \"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right),\\\\qquad y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $- \\\\frac{1}{2}$ | $a$ | $\\\\frac{1}{2}$ |\\n| $y$ | $b$ | $1$ | $c$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $\\\\frac{\\\\sqrt{3}}{2}$ |\\n| $y$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\\n\\nFind the exact value of $a+b+c$.\\n\\n{{result}}\"] [:db/add \"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=0$. Substitute into $x=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\sin\\\\left(\\\\frac{\\\\pi \\\\left(0\\\\right)}{6}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(0\\\\right) \\\\\\\\ &=0\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $y$-row under $t=-1$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(-1\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(- \\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=1$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(1\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}a+b+c \\\\\\\\ =\\\\left(0\\\\right)+\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =\\\\sqrt{2}\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $- \\\\frac{1}{2}$ | $0$ | $\\\\frac{1}{2}$ |\\n| $y$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $\\\\frac{\\\\sqrt{3}}{2}$ |\\n| $y$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\"] [:db/add \"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/difficulty :question.difficulty/hard] [:db/add \"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/answer-fields \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\"] [:db/ensure \"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"dfe7f575-109f-57a8-8469-d7a292b67702\"] [:db/add \"698216b5-6523-5bab-9afb-551bb8856438\" :answer/id #uuid \"698216b5-6523-5bab-9afb-551bb8856438\"] [:db/add \"698216b5-6523-5bab-9afb-551bb8856438\" :answer/type :answer.type/math] [:db/add \"698216b5-6523-5bab-9afb-551bb8856438\" :answer/value \"- \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2} + 1\"] [:db/ensure \"698216b5-6523-5bab-9afb-551bb8856438\" :answer/validate] [:db/add \"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/id #uuid \"913dad68-ed72-58c7-b849-508e17f78f3c\"] [:db/add \"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/key \"result\"] [:db/add \"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/type :answer-field.type/blank] [:db/add \"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/choices \"698216b5-6523-5bab-9afb-551bb8856438\"] [:db/add \"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/correct \"698216b5-6523-5bab-9afb-551bb8856438\"] [:db/ensure \"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/validate] [:db/add \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/id #uuid \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\"] [:db/add \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right),\\\\qquad y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ | $b$ |\\n| $y$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ |\\n| $y$ | $c$ | $a$ |\\n\\nFind the exact value of $-a+b-c$.\\n\\n{{result}}\"] [:db/add \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/worked-solution \"The $a$ entry is in the $y$-row under $t=4$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(4\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\pi\\\\right) \\\\\\\\ &=-1\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $x$-row under $t=2$. Substitute into $x=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(2\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(\\\\frac{2 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=3$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(3\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}-a+b-c \\\\\\\\ =-\\\\left(-1\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right)-\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =- \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2} + 1\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ | $- \\\\sqrt{3}$ |\\n| $y$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ |\\n| $y$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\"] [:db/add \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/difficulty :question.difficulty/hard] [:db/add \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/answer-fields \"913dad68-ed72-58c7-b849-508e17f78f3c\"] [:db/ensure \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/validate] [:db/add 17592186087717 :knowledge-point/questions \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\"] [:db/add \"generator\" :question-generator/id #uuid \"664ecab0-2bbb-5e3a-a04b-78471ee297e1\"] [:db/add \"generator\" :question-generator/script \"generators/4c/4c9fe9749cdac4cfc8fd9d4b82afb05541e87580c19d1e80c9d1e81ae916d9de/generator.py\"] [:db/add 17592186087717 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186087717 :knowledge-point/validate]] \"assertions\" [[\"ef6d78ba-7545-5a5d-a094-56fe38d11dd6\" :answer/id #uuid \"ef6d78ba-7545-5a5d-a094-56fe38d11dd6\"] [\"ef6d78ba-7545-5a5d-a094-56fe38d11dd6\" :answer/type :answer.type/math] [\"ef6d78ba-7545-5a5d-a094-56fe38d11dd6\" :answer/value \"6\"] [\"04c90db2-1857-5950-a1c1-ef2dd432e5ee\" :answer-field/id #uuid \"04c90db2-1857-5950-a1c1-ef2dd432e5ee\"] [\"04c90db2-1857-5950-a1c1-ef2dd432e5ee\" :answer-field/key \"field-1\"] [\"04c90db2-1857-5950-a1c1-ef2dd432e5ee\" :answer-field/type :answer-field.type/blank] [\"04c90db2-1857-5950-a1c1-ef2dd432e5ee\" :answer-field/choices \"ef6d78ba-7545-5a5d-a094-56fe38d11dd6\"] [\"04c90db2-1857-5950-a1c1-ef2dd432e5ee\" :answer-field/correct \"ef6d78ba-7545-5a5d-a094-56fe38d11dd6\"] [\"52c8d0b2-9b1e-5975-8c25-c32b93121251\" :answer/id #uuid \"52c8d0b2-9b1e-5975-8c25-c32b93121251\"] [\"52c8d0b2-9b1e-5975-8c25-c32b93121251\" :answer/type :answer.type/math] [\"52c8d0b2-9b1e-5975-8c25-c32b93121251\" :answer/value \"5\"] [\"74ef9f89-147e-5d53-85b1-f785b0ca607c\" :answer-field/id #uuid \"74ef9f89-147e-5d53-85b1-f785b0ca607c\"] [\"74ef9f89-147e-5d53-85b1-f785b0ca607c\" :answer-field/key \"field-2\"] [\"74ef9f89-147e-5d53-85b1-f785b0ca607c\" :answer-field/type :answer-field.type/blank] [\"74ef9f89-147e-5d53-85b1-f785b0ca607c\" :answer-field/choices \"52c8d0b2-9b1e-5975-8c25-c32b93121251\"] [\"74ef9f89-147e-5d53-85b1-f785b0ca607c\" :answer-field/correct \"52c8d0b2-9b1e-5975-8c25-c32b93121251\"] [\"387fc7bd-f009-5755-9b57-c560114d7eda\" :answer/id #uuid \"387fc7bd-f009-5755-9b57-c560114d7eda\"] [\"387fc7bd-f009-5755-9b57-c560114d7eda\" :answer/type :answer.type/math] [\"387fc7bd-f009-5755-9b57-c560114d7eda\" :answer/value \"1\"] [\"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/id #uuid \"c7a26bde-522f-51ad-b6be-4e4cf1093416\"] [\"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/key \"field-3\"] [\"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/type :answer-field.type/blank] [\"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/choices \"387fc7bd-f009-5755-9b57-c560114d7eda\"] [\"c7a26bde-522f-51ad-b6be-4e4cf1093416\" :answer-field/correct \"387fc7bd-f009-5755-9b57-c560114d7eda\"] [\"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/id #uuid \"ddd79350-3c36-5a68-8e1f-be7ece233413\"] [\"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=3 t,\\\\qquad y=t^{2} + 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=3 \\\\left(-2\\\\right)=-6$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-6$ | $-3$ | $0$ |\\n| $y$ | {{field-2}} | $2$ | {{field-3}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $3$ | {{field-1}} |\\n| $y$ | $2$ | $5$ |\"] [\"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/worked-solution \"The missing entry is in the $x$-row under $t=2$. Substitute into $x=3 t$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=3 \\\\left(2\\\\right) \\\\\\\\ &=6\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=t^{2} + 1$:\\n\\n$$\\n\\\\begin{aligned}y(-2) &=\\\\left(-2\\\\right)^{2} + 1 \\\\\\\\ &=5\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t^{2} + 1$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\left(0\\\\right)^{2} + 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-6$ | $-3$ | $0$ |\\n| $y$ | $5$ | $2$ | $1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $3$ | $6$ |\\n| $y$ | $2$ | $5$ |\"] [\"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/difficulty :question.difficulty/easy] [\"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/answer-fields \"04c90db2-1857-5950-a1c1-ef2dd432e5ee\"] [\"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/answer-fields \"74ef9f89-147e-5d53-85b1-f785b0ca607c\"] [\"ddd79350-3c36-5a68-8e1f-be7ece233413\" :question/answer-fields \"c7a26bde-522f-51ad-b6be-4e4cf1093416\"] [17592186087717 :knowledge-point/questions \"ddd79350-3c36-5a68-8e1f-be7ece233413\"] [\"20b2318e-6dee-544c-8bf9-4ed392af2343\" :answer/id #uuid \"20b2318e-6dee-544c-8bf9-4ed392af2343\"] [\"20b2318e-6dee-544c-8bf9-4ed392af2343\" :answer/type :answer.type/math] [\"20b2318e-6dee-544c-8bf9-4ed392af2343\" :answer/value \"2\"] [\"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/id #uuid \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\"] [\"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/key \"field-1\"] [\"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/type :answer-field.type/blank] [\"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/choices \"20b2318e-6dee-544c-8bf9-4ed392af2343\"] [\"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\" :answer-field/correct \"20b2318e-6dee-544c-8bf9-4ed392af2343\"] [\"059a2954-95ef-5c80-9985-aa1f54b274fd\" :answer/id #uuid \"059a2954-95ef-5c80-9985-aa1f54b274fd\"] [\"059a2954-95ef-5c80-9985-aa1f54b274fd\" :answer/type :answer.type/math] [\"059a2954-95ef-5c80-9985-aa1f54b274fd\" :answer/value \"-6\"] [\"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/id #uuid \"9eca4b51-8196-54d7-a291-d43148ce0620\"] [\"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/key \"field-2\"] [\"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/type :answer-field.type/blank] [\"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/choices \"059a2954-95ef-5c80-9985-aa1f54b274fd\"] [\"9eca4b51-8196-54d7-a291-d43148ce0620\" :answer-field/correct \"059a2954-95ef-5c80-9985-aa1f54b274fd\"] [\"3274b331-4f5b-5a6b-882c-4168c288e5ba\" :answer/id #uuid \"3274b331-4f5b-5a6b-882c-4168c288e5ba\"] [\"3274b331-4f5b-5a6b-882c-4168c288e5ba\" :answer/type :answer.type/math] [\"3274b331-4f5b-5a6b-882c-4168c288e5ba\" :answer/value \"-2\"] [\"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/id #uuid \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\"] [\"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/key \"field-3\"] [\"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/type :answer-field.type/blank] [\"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/choices \"3274b331-4f5b-5a6b-882c-4168c288e5ba\"] [\"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\" :answer-field/correct \"3274b331-4f5b-5a6b-882c-4168c288e5ba\"] [\"90febdeb-888f-5245-a4c0-d005214c232c\" :question/id #uuid \"90febdeb-888f-5245-a4c0-d005214c232c\"] [\"90febdeb-888f-5245-a4c0-d005214c232c\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=2 - t^{2},\\\\qquad y=- 3 t - 3,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=2 - \\\\left(-2\\\\right)^{2}=-2$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-2$ | $1$ | {{field-1}} |\\n| $y$ | $3$ | $0$ | $-3$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | {{field-3}} |\\n| $y$ | {{field-2}} | $-9$ |\"] [\"90febdeb-888f-5245-a4c0-d005214c232c\" :question/worked-solution \"The missing entry is in the $x$-row under $t=0$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(0) &=2 - \\\\left(0\\\\right)^{2} \\\\\\\\ &=2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=1$. Substitute into $y=- 3 t - 3$:\\n\\n$$\\n\\\\begin{aligned}y(1) &=- 3 \\\\left(1\\\\right) - 3 \\\\\\\\ &=-6\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=2$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=2 - \\\\left(2\\\\right)^{2} \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-2$ | $1$ | $2$ |\\n| $y$ | $3$ | $0$ | $-3$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $-2$ |\\n| $y$ | $-6$ | $-9$ |\"] [\"90febdeb-888f-5245-a4c0-d005214c232c\" :question/difficulty :question.difficulty/easy] [\"90febdeb-888f-5245-a4c0-d005214c232c\" :question/answer-fields \"c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8\"] [\"90febdeb-888f-5245-a4c0-d005214c232c\" :question/answer-fields \"9eca4b51-8196-54d7-a291-d43148ce0620\"] [\"90febdeb-888f-5245-a4c0-d005214c232c\" :question/answer-fields \"b99b699a-d05b-59a1-aacb-30c5a2baa9ff\"] [17592186087717 :knowledge-point/questions \"90febdeb-888f-5245-a4c0-d005214c232c\"] [\"326507c0-898e-50fd-a26b-d5d81c068911\" :answer/id #uuid \"326507c0-898e-50fd-a26b-d5d81c068911\"] [\"326507c0-898e-50fd-a26b-d5d81c068911\" :answer/type :answer.type/math] [\"326507c0-898e-50fd-a26b-d5d81c068911\" :answer/value \"3\"] [\"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/id #uuid \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\"] [\"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/key \"field-1\"] [\"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/type :answer-field.type/blank] [\"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/choices \"326507c0-898e-50fd-a26b-d5d81c068911\"] [\"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\" :answer-field/correct \"326507c0-898e-50fd-a26b-d5d81c068911\"] [\"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\" :answer/id #uuid \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\"] [\"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\" :answer/type :answer.type/math] [\"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\" :answer/value \"-2\"] [\"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/id #uuid \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\"] [\"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/key \"field-2\"] [\"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/type :answer-field.type/blank] [\"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/choices \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\"] [\"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\" :answer-field/correct \"19c8f93b-9c4b-5c3c-bddc-b11bb26ed4c2\"] [\"6b62cf95-aa03-5efa-b46d-4a18e0c65146\" :answer/id #uuid \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\"] [\"6b62cf95-aa03-5efa-b46d-4a18e0c65146\" :answer/type :answer.type/math] [\"6b62cf95-aa03-5efa-b46d-4a18e0c65146\" :answer/value \"1\"] [\"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/id #uuid \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\"] [\"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/key \"field-3\"] [\"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/type :answer-field.type/blank] [\"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/choices \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\"] [\"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\" :answer-field/correct \"6b62cf95-aa03-5efa-b46d-4a18e0c65146\"] [\"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/id #uuid \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\"] [\"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=2 - t^{2},\\\\qquad y=2 t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(0)=2 - \\\\left(0\\\\right)^{2}=2$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-2}} | {{field-3}} | $2$ |\\n| $y$ | $-5$ | $-3$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $-2$ |\\n| $y$ | $1$ | {{field-1}} |\"] [\"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/worked-solution \"The missing entry is in the $y$-row under $t=2$. Substitute into $y=2 t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=2 \\\\left(2\\\\right) - 1 \\\\\\\\ &=3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=2 - \\\\left(-2\\\\right)^{2} \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=2 - \\\\left(-1\\\\right)^{2} \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-2$ | $1$ | $2$ |\\n| $y$ | $-5$ | $-3$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $-2$ |\\n| $y$ | $1$ | $3$ |\"] [\"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/difficulty :question.difficulty/easy] [\"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/answer-fields \"0d807bd0-4401-50f7-b76c-5b3f96b67bb8\"] [\"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/answer-fields \"e325fcc5-acb5-5ce1-872e-9b3aa8b65159\"] [\"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\" :question/answer-fields \"9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0\"] [17592186087717 :knowledge-point/questions \"edb55b8b-7b58-5dc2-81a0-8a36280b22b0\"] [\"b819a116-e504-5659-bd6b-09de617bbb38\" :answer/id #uuid \"b819a116-e504-5659-bd6b-09de617bbb38\"] [\"b819a116-e504-5659-bd6b-09de617bbb38\" :answer/type :answer.type/math] [\"b819a116-e504-5659-bd6b-09de617bbb38\" :answer/value \"-2\"] [\"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/id #uuid \"7f551e3a-65cb-54f0-9930-03078b3b3a33\"] [\"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/key \"field-1\"] [\"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/type :answer-field.type/blank] [\"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/choices \"b819a116-e504-5659-bd6b-09de617bbb38\"] [\"7f551e3a-65cb-54f0-9930-03078b3b3a33\" :answer-field/correct \"b819a116-e504-5659-bd6b-09de617bbb38\"] [\"b09f99c5-b0ea-517e-9f73-1efa4902f749\" :answer/id #uuid \"b09f99c5-b0ea-517e-9f73-1efa4902f749\"] [\"b09f99c5-b0ea-517e-9f73-1efa4902f749\" :answer/type :answer.type/math] [\"b09f99c5-b0ea-517e-9f73-1efa4902f749\" :answer/value \"-3\"] [\"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/id #uuid \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\"] [\"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/key \"field-2\"] [\"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/type :answer-field.type/blank] [\"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/choices \"b09f99c5-b0ea-517e-9f73-1efa4902f749\"] [\"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\" :answer-field/correct \"b09f99c5-b0ea-517e-9f73-1efa4902f749\"] [\"b194ab8c-7e43-562b-8587-018c40daf5aa\" :answer/id #uuid \"b194ab8c-7e43-562b-8587-018c40daf5aa\"] [\"b194ab8c-7e43-562b-8587-018c40daf5aa\" :answer/type :answer.type/math] [\"b194ab8c-7e43-562b-8587-018c40daf5aa\" :answer/value \"-5\"] [\"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/id #uuid \"64ba65b8-e4f8-5e86-9594-a9aed605d124\"] [\"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/key \"field-3\"] [\"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/type :answer-field.type/blank] [\"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/choices \"b194ab8c-7e43-562b-8587-018c40daf5aa\"] [\"64ba65b8-e4f8-5e86-9594-a9aed605d124\" :answer-field/correct \"b194ab8c-7e43-562b-8587-018c40daf5aa\"] [\"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/id #uuid \"27567bdc-9f35-5be9-8b03-2accae833e9c\"] [\"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- t^{2} - 1,\\\\qquad y=- t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(0)=- \\\\left(0\\\\right)^{2} - 1=-1$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-3}} | {{field-1}} | $-1$ |\\n| $y$ | $1$ | $0$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $-5$ |\\n| $y$ | $-2$ | {{field-2}} |\"] [\"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/worked-solution \"The missing entry is in the $x$-row under $t=-1$. Substitute into $x=- t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=- \\\\left(-1\\\\right)^{2} - 1 \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=- \\\\left(2\\\\right) - 1 \\\\\\\\ &=-3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=- t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=- \\\\left(-2\\\\right)^{2} - 1 \\\\\\\\ &=-5\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-5$ | $-2$ | $-1$ |\\n| $y$ | $1$ | $0$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $-5$ |\\n| $y$ | $-2$ | $-3$ |\"] [\"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/difficulty :question.difficulty/easy] [\"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/answer-fields \"7f551e3a-65cb-54f0-9930-03078b3b3a33\"] [\"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/answer-fields \"e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab\"] [\"27567bdc-9f35-5be9-8b03-2accae833e9c\" :question/answer-fields \"64ba65b8-e4f8-5e86-9594-a9aed605d124\"] [17592186087717 :knowledge-point/questions \"27567bdc-9f35-5be9-8b03-2accae833e9c\"] [\"5f1be70c-83dd-54f9-bb42-98edc42c6afe\" :answer/id #uuid \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\"] [\"5f1be70c-83dd-54f9-bb42-98edc42c6afe\" :answer/type :answer.type/math] [\"5f1be70c-83dd-54f9-bb42-98edc42c6afe\" :answer/value \"0\"] [\"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/id #uuid \"a13f25ae-650e-520c-a28a-2f653c201bcd\"] [\"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/key \"field-1\"] [\"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/type :answer-field.type/blank] [\"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/choices \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\"] [\"a13f25ae-650e-520c-a28a-2f653c201bcd\" :answer-field/correct \"5f1be70c-83dd-54f9-bb42-98edc42c6afe\"] [\"35ac1f29-c398-5408-a497-d44f19ed28f0\" :answer/id #uuid \"35ac1f29-c398-5408-a497-d44f19ed28f0\"] [\"35ac1f29-c398-5408-a497-d44f19ed28f0\" :answer/type :answer.type/math] [\"35ac1f29-c398-5408-a497-d44f19ed28f0\" :answer/value \"-7\"] [\"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/id #uuid \"b9f42515-6266-5f99-be4c-b325c3057d63\"] [\"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/key \"field-2\"] [\"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/type :answer-field.type/blank] [\"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/choices \"35ac1f29-c398-5408-a497-d44f19ed28f0\"] [\"b9f42515-6266-5f99-be4c-b325c3057d63\" :answer-field/correct \"35ac1f29-c398-5408-a497-d44f19ed28f0\"] [\"e8633867-6898-5cdb-a8fe-85a0efd7ca04\" :answer/id #uuid \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\"] [\"e8633867-6898-5cdb-a8fe-85a0efd7ca04\" :answer/type :answer.type/math] [\"e8633867-6898-5cdb-a8fe-85a0efd7ca04\" :answer/value \"3\"] [\"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/id #uuid \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\"] [\"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/key \"field-3\"] [\"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/type :answer-field.type/blank] [\"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/choices \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\"] [\"5b396ae2-4c0f-565b-8f45-e0e8038306cb\" :answer-field/correct \"e8633867-6898-5cdb-a8fe-85a0efd7ca04\"] [\"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/id #uuid \"dd116258-ab80-55bb-94e9-3a3ddb480df7\"] [\"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=3 t - 1,\\\\qquad y=t^{2} - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-1)=3 \\\\left(-1\\\\right) - 1=-4$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-2}} | $-4$ | $-1$ |\\n| $y$ | $3$ | {{field-1}} | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $2$ | $5$ |\\n| $y$ | $0$ | {{field-3}} |\"] [\"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/worked-solution \"The missing entry is in the $y$-row under $t=-1$. Substitute into $y=t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}y(-1) &=\\\\left(-1\\\\right)^{2} - 1 \\\\\\\\ &=0\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=3 t - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=3 \\\\left(-2\\\\right) - 1 \\\\\\\\ &=-7\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=\\\\left(2\\\\right)^{2} - 1 \\\\\\\\ &=3\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-7$ | $-4$ | $-1$ |\\n| $y$ | $3$ | $0$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $2$ | $5$ |\\n| $y$ | $0$ | $3$ |\"] [\"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/difficulty :question.difficulty/easy] [\"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/answer-fields \"a13f25ae-650e-520c-a28a-2f653c201bcd\"] [\"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/answer-fields \"b9f42515-6266-5f99-be4c-b325c3057d63\"] [\"dd116258-ab80-55bb-94e9-3a3ddb480df7\" :question/answer-fields \"5b396ae2-4c0f-565b-8f45-e0e8038306cb\"] [17592186087717 :knowledge-point/questions \"dd116258-ab80-55bb-94e9-3a3ddb480df7\"] [\"2b814dd9-4f38-5c2d-9fae-541de879bc69\" :answer/id #uuid \"2b814dd9-4f38-5c2d-9fae-541de879bc69\"] [\"2b814dd9-4f38-5c2d-9fae-541de879bc69\" :answer/type :answer.type/math] [\"2b814dd9-4f38-5c2d-9fae-541de879bc69\" :answer/value \"\\\\sqrt{7}\"] [\"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/id #uuid \"9f08cea1-222d-5521-a1b6-f722bf34659a\"] [\"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/key \"field-1\"] [\"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/type :answer-field.type/blank] [\"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/choices \"2b814dd9-4f38-5c2d-9fae-541de879bc69\"] [\"9f08cea1-222d-5521-a1b6-f722bf34659a\" :answer-field/correct \"2b814dd9-4f38-5c2d-9fae-541de879bc69\"] [\"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\" :answer/id #uuid \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\"] [\"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\" :answer/type :answer.type/math] [\"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\" :answer/value \"3\"] [\"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/id #uuid \"e537d01c-3473-5cbc-af40-700bbf907716\"] [\"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/key \"field-2\"] [\"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/type :answer-field.type/blank] [\"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/choices \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\"] [\"e537d01c-3473-5cbc-af40-700bbf907716\" :answer-field/correct \"9d3eb889-ae32-59ac-9ec2-8ea336cffb37\"] [\"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\" :answer/id #uuid \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\"] [\"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\" :answer/type :answer.type/math] [\"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\" :answer/value \"1\"] [\"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/id #uuid \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\"] [\"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/key \"field-3\"] [\"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/type :answer-field.type/blank] [\"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/choices \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\"] [\"4410f63b-e4a7-5fe2-8743-46b92bd2436b\" :answer-field/correct \"2cd7955e-c25b-5fc1-81fe-d267d9ec4e11\"] [\"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/id #uuid \"bc401fc2-0741-5e28-ac23-67f5c0316d34\"] [\"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\sqrt{t + 5},\\\\qquad y=t^{2} + t + 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\sqrt{3}$ | $2$ | $\\\\sqrt{5}$ |\\n| $y$ | {{field-2}} | $1$ | {{field-3}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $\\\\sqrt{6}$ | {{field-1}} |\\n| $y$ | $3$ | $7$ |\"] [\"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/worked-solution \"The missing entry is in the $x$-row under $t=2$. Substitute into $x=\\\\sqrt{t + 5}$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=\\\\sqrt{\\\\left(2\\\\right) + 5} \\\\\\\\ &=\\\\sqrt{7}\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=t^{2} + t + 1$:\\n\\n$$\\n\\\\begin{aligned}y(-2) &=\\\\left(-2\\\\right)^{2} + \\\\left(-2\\\\right) + 1 \\\\\\\\ &=3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t^{2} + t + 1$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\left(0\\\\right)^{2} + \\\\left(0\\\\right) + 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\sqrt{3}$ | $2$ | $\\\\sqrt{5}$ |\\n| $y$ | $3$ | $1$ | $1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $\\\\sqrt{6}$ | $\\\\sqrt{7}$ |\\n| $y$ | $3$ | $7$ |\"] [\"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/difficulty :question.difficulty/moderate] [\"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/answer-fields \"9f08cea1-222d-5521-a1b6-f722bf34659a\"] [\"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/answer-fields \"e537d01c-3473-5cbc-af40-700bbf907716\"] [\"bc401fc2-0741-5e28-ac23-67f5c0316d34\" :question/answer-fields \"4410f63b-e4a7-5fe2-8743-46b92bd2436b\"] [17592186087717 :knowledge-point/questions \"bc401fc2-0741-5e28-ac23-67f5c0316d34\"] [\"be8f22ce-afae-5606-b438-18f3dc59e682\" :answer/id #uuid \"be8f22ce-afae-5606-b438-18f3dc59e682\"] [\"be8f22ce-afae-5606-b438-18f3dc59e682\" :answer/type :answer.type/math] [\"be8f22ce-afae-5606-b438-18f3dc59e682\" :answer/value \"-5\"] [\"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/id #uuid \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\"] [\"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/key \"field-1\"] [\"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/type :answer-field.type/blank] [\"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/choices \"be8f22ce-afae-5606-b438-18f3dc59e682\"] [\"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\" :answer-field/correct \"be8f22ce-afae-5606-b438-18f3dc59e682\"] [\"bbb22633-47e1-508a-af16-2a7918763d8c\" :answer/id #uuid \"bbb22633-47e1-508a-af16-2a7918763d8c\"] [\"bbb22633-47e1-508a-af16-2a7918763d8c\" :answer/type :answer.type/math] [\"bbb22633-47e1-508a-af16-2a7918763d8c\" :answer/value \"1\"] [\"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/id #uuid \"6885b268-5994-5727-8ed7-801748d29ac1\"] [\"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/key \"field-2\"] [\"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/type :answer-field.type/blank] [\"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/choices \"bbb22633-47e1-508a-af16-2a7918763d8c\"] [\"6885b268-5994-5727-8ed7-801748d29ac1\" :answer-field/correct \"bbb22633-47e1-508a-af16-2a7918763d8c\"] [\"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\" :answer/id #uuid \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\"] [\"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\" :answer/type :answer.type/math] [\"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\" :answer/value \"-1\"] [\"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/id #uuid \"4f0a4ce2-be81-567f-bf25-76cc6334194f\"] [\"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/key \"field-3\"] [\"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/type :answer-field.type/blank] [\"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/choices \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\"] [\"4f0a4ce2-be81-567f-bf25-76cc6334194f\" :answer-field/correct \"0f8e75c4-5bea-5057-ab52-8a3f83d535d3\"] [\"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/id #uuid \"ae109e7c-040d-5915-83ac-8deca83290cb\"] [\"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- t^{3} - 2 t - 2,\\\\qquad y=t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $10$ | $1$ | $-2$ |\\n| $y$ | $-3$ | $-2$ | {{field-3}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | {{field-1}} | $-14$ |\\n| $y$ | $0$ | {{field-2}} |\"] [\"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/worked-solution \"The missing entry is in the $x$-row under $t=1$. Substitute into $x=- t^{3} - 2 t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(1) &=- \\\\left(1\\\\right)^{3} - 2 \\\\left(1\\\\right) - 2 \\\\\\\\ &=-5\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=\\\\left(2\\\\right) - 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\left(0\\\\right) - 1 \\\\\\\\ &=-1\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $10$ | $1$ | $-2$ |\\n| $y$ | $-3$ | $-2$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-5$ | $-14$ |\\n| $y$ | $0$ | $1$ |\"] [\"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/difficulty :question.difficulty/moderate] [\"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/answer-fields \"5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b\"] [\"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/answer-fields \"6885b268-5994-5727-8ed7-801748d29ac1\"] [\"ae109e7c-040d-5915-83ac-8deca83290cb\" :question/answer-fields \"4f0a4ce2-be81-567f-bf25-76cc6334194f\"] [17592186087717 :knowledge-point/questions \"ae109e7c-040d-5915-83ac-8deca83290cb\"] [\"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\" :answer/id #uuid \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\"] [\"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\" :answer/type :answer.type/math] [\"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\" :answer/value \"- \\\\sqrt{5}\"] [\"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/id #uuid \"e71c11b6-9ba8-5deb-b35c-ce927364c244\"] [\"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/key \"field-1\"] [\"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/type :answer-field.type/blank] [\"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/choices \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\"] [\"e71c11b6-9ba8-5deb-b35c-ce927364c244\" :answer-field/correct \"8383308f-2a71-5ad9-ab48-2d8bb50b4cbc\"] [\"a6fa9117-0a92-5802-b33f-60ef4f297dea\" :answer/id #uuid \"a6fa9117-0a92-5802-b33f-60ef4f297dea\"] [\"a6fa9117-0a92-5802-b33f-60ef4f297dea\" :answer/type :answer.type/math] [\"a6fa9117-0a92-5802-b33f-60ef4f297dea\" :answer/value \"1\"] [\"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/id #uuid \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\"] [\"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/key \"field-2\"] [\"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/type :answer-field.type/blank] [\"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/choices \"a6fa9117-0a92-5802-b33f-60ef4f297dea\"] [\"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\" :answer-field/correct \"a6fa9117-0a92-5802-b33f-60ef4f297dea\"] [\"e0f88b88-856f-5030-aa8d-8343fa9b372f\" :answer/id #uuid \"e0f88b88-856f-5030-aa8d-8343fa9b372f\"] [\"e0f88b88-856f-5030-aa8d-8343fa9b372f\" :answer/type :answer.type/math] [\"e0f88b88-856f-5030-aa8d-8343fa9b372f\" :answer/value \"-2\"] [\"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/id #uuid \"6c97f634-6131-5d50-86cb-2461edfb42d1\"] [\"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/key \"field-3\"] [\"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/type :answer-field.type/blank] [\"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/choices \"e0f88b88-856f-5030-aa8d-8343fa9b372f\"] [\"6c97f634-6131-5d50-86cb-2461edfb42d1\" :answer-field/correct \"e0f88b88-856f-5030-aa8d-8343fa9b372f\"] [\"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/id #uuid \"9041a575-6f1d-552b-b837-3cb6733640f8\"] [\"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- \\\\sqrt{t + 3},\\\\qquad y=t^{2} - t - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $- \\\\sqrt{2}$ | $- \\\\sqrt{3}$ |\\n| $y$ | $5$ | {{field-2}} | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | {{field-3}} | {{field-1}} |\\n| $y$ | $-1$ | $1$ |\"] [\"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/worked-solution \"The missing entry is in the $x$-row under $t=2$. Substitute into $x=- \\\\sqrt{t + 3}$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=- \\\\sqrt{\\\\left(2\\\\right) + 3} \\\\\\\\ &=- \\\\sqrt{5}\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-1$. Substitute into $y=t^{2} - t - 1$:\\n\\n$$\\n\\\\begin{aligned}y(-1) &=\\\\left(-1\\\\right)^{2} - \\\\left(-1\\\\right) - 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=1$. Substitute into $x=- \\\\sqrt{t + 3}$:\\n\\n$$\\n\\\\begin{aligned}x(1) &=- \\\\sqrt{\\\\left(1\\\\right) + 3} \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $- \\\\sqrt{2}$ | $- \\\\sqrt{3}$ |\\n| $y$ | $5$ | $1$ | $-1$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $- \\\\sqrt{5}$ |\\n| $y$ | $-1$ | $1$ |\"] [\"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/difficulty :question.difficulty/moderate] [\"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/answer-fields \"e71c11b6-9ba8-5deb-b35c-ce927364c244\"] [\"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/answer-fields \"bd590515-b2c6-5c5e-a17e-ec5180a44b0c\"] [\"9041a575-6f1d-552b-b837-3cb6733640f8\" :question/answer-fields \"6c97f634-6131-5d50-86cb-2461edfb42d1\"] [17592186087717 :knowledge-point/questions \"9041a575-6f1d-552b-b837-3cb6733640f8\"] [\"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\" :answer/id #uuid \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\"] [\"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\" :answer/type :answer.type/math] [\"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\" :answer/value \"-2\"] [\"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/id #uuid \"587ac7af-6290-53d2-9cec-22cb43571473\"] [\"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/key \"field-1\"] [\"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/type :answer-field.type/blank] [\"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/choices \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\"] [\"587ac7af-6290-53d2-9cec-22cb43571473\" :answer-field/correct \"4e72e13d-f7ca-5f77-a1b5-3af62dc3130b\"] [\"fa348710-c1b6-5a01-93a4-e62f3bf60f86\" :answer/id #uuid \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\"] [\"fa348710-c1b6-5a01-93a4-e62f3bf60f86\" :answer/type :answer.type/math] [\"fa348710-c1b6-5a01-93a4-e62f3bf60f86\" :answer/value \"-8\"] [\"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/id #uuid \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\"] [\"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/key \"field-2\"] [\"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/type :answer-field.type/blank] [\"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/choices \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\"] [\"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\" :answer-field/correct \"fa348710-c1b6-5a01-93a4-e62f3bf60f86\"] [\"9f7fc073-afc7-58e9-86b1-c5e2fec20943\" :answer/id #uuid \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\"] [\"9f7fc073-afc7-58e9-86b1-c5e2fec20943\" :answer/type :answer.type/math] [\"9f7fc073-afc7-58e9-86b1-c5e2fec20943\" :answer/value \"0\"] [\"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/id #uuid \"48b52033-f222-5223-9e70-d97a2e3f828f\"] [\"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/key \"field-3\"] [\"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/type :answer-field.type/blank] [\"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/choices \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\"] [\"48b52033-f222-5223-9e70-d97a2e3f828f\" :answer-field/correct \"9f7fc073-afc7-58e9-86b1-c5e2fec20943\"] [\"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/id #uuid \"38db0909-2ecc-5349-b5e3-51ee53a611f3\"] [\"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- 2 t - 2,\\\\qquad y=- t^{3} + t - 2,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $2$ | {{field-3}} | $-2$ |\\n| $y$ | $4$ | $-2$ | {{field-1}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-4$ | $-6$ |\\n| $y$ | $-2$ | {{field-2}} |\"] [\"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/worked-solution \"The missing entry is in the $y$-row under $t=0$. Substitute into $y=- t^{3} + t - 2$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=- \\\\left(0\\\\right)^{3} + \\\\left(0\\\\right) - 2 \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t^{3} + t - 2$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=- \\\\left(2\\\\right)^{3} + \\\\left(2\\\\right) - 2 \\\\\\\\ &=-8\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=- 2 t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=- 2 \\\\left(-1\\\\right) - 2 \\\\\\\\ &=0\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $2$ | $0$ | $-2$ |\\n| $y$ | $4$ | $-2$ | $-2$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-4$ | $-6$ |\\n| $y$ | $-2$ | $-8$ |\"] [\"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/difficulty :question.difficulty/moderate] [\"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/answer-fields \"587ac7af-6290-53d2-9cec-22cb43571473\"] [\"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/answer-fields \"06c0e3ce-fbb6-525f-9217-47f47f17c3e1\"] [\"38db0909-2ecc-5349-b5e3-51ee53a611f3\" :question/answer-fields \"48b52033-f222-5223-9e70-d97a2e3f828f\"] [17592186087717 :knowledge-point/questions \"38db0909-2ecc-5349-b5e3-51ee53a611f3\"] [\"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\" :answer/id #uuid \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\"] [\"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\" :answer/type :answer.type/math] [\"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\" :answer/value \"\\\\frac{1}{4}\"] [\"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/id #uuid \"7481c2c2-315a-530b-aff1-6d7af617d6d1\"] [\"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/key \"field-1\"] [\"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/type :answer-field.type/blank] [\"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/choices \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\"] [\"7481c2c2-315a-530b-aff1-6d7af617d6d1\" :answer-field/correct \"41db06be-b9b8-5a8d-8ee9-feb50c48f2f6\"] [\"62dbfd4e-fb14-5d12-a537-635a8740ea79\" :answer/id #uuid \"62dbfd4e-fb14-5d12-a537-635a8740ea79\"] [\"62dbfd4e-fb14-5d12-a537-635a8740ea79\" :answer/type :answer.type/math] [\"62dbfd4e-fb14-5d12-a537-635a8740ea79\" :answer/value \"-2\"] [\"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/id #uuid \"9404ff17-7403-5a13-adf9-9134e85b7ab3\"] [\"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/key \"field-2\"] [\"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/type :answer-field.type/blank] [\"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/choices \"62dbfd4e-fb14-5d12-a537-635a8740ea79\"] [\"9404ff17-7403-5a13-adf9-9134e85b7ab3\" :answer-field/correct \"62dbfd4e-fb14-5d12-a537-635a8740ea79\"] [\"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\" :answer/id #uuid \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\"] [\"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\" :answer/type :answer.type/math] [\"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\" :answer/value \"4\"] [\"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/id #uuid \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\"] [\"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/key \"field-3\"] [\"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/type :answer-field.type/blank] [\"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/choices \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\"] [\"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\" :answer-field/correct \"29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748\"] [\"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/id #uuid \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\"] [\"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=t^{2} - t - 2,\\\\qquad y=\\\\frac{t + 1}{t + 4},\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | {{field-3}} | $0$ | $-2$ |\\n| $y$ | $- \\\\frac{1}{2}$ | $0$ | {{field-1}} |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | {{field-2}} | $0$ |\\n| $y$ | $\\\\frac{2}{5}$ | $\\\\frac{1}{2}$ |\"] [\"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/worked-solution \"The missing entry is in the $y$-row under $t=0$. Substitute into $y=\\\\frac{t + 1}{t + 4}$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=\\\\frac{\\\\left(0\\\\right) + 1}{\\\\left(0\\\\right) + 4} \\\\\\\\ &=\\\\frac{1}{4}\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=1$. Substitute into $x=t^{2} - t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(1) &=\\\\left(1\\\\right)^{2} - \\\\left(1\\\\right) - 2 \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=t^{2} - t - 2$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=\\\\left(-2\\\\right)^{2} - \\\\left(-2\\\\right) - 2 \\\\\\\\ &=4\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- |\\n| $x$ | $4$ | $0$ | $-2$ |\\n| $y$ | $- \\\\frac{1}{2}$ | $0$ | $\\\\frac{1}{4}$ |\\n\\n| **$t$** | $1$ | $2$ |\\n| --- | --- | --- |\\n| $x$ | $-2$ | $0$ |\\n| $y$ | $\\\\frac{2}{5}$ | $\\\\frac{1}{2}$ |\"] [\"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/difficulty :question.difficulty/moderate] [\"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/answer-fields \"7481c2c2-315a-530b-aff1-6d7af617d6d1\"] [\"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/answer-fields \"9404ff17-7403-5a13-adf9-9134e85b7ab3\"] [\"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\" :question/answer-fields \"e94f0b2f-fd79-58b5-b922-d88b8a4e1627\"] [17592186087717 :knowledge-point/questions \"7ffd2df9-6212-5ff4-bae5-4c049e9f941a\"] [\"780bd7db-4212-5fe1-8a27-e116c11d14cf\" :answer/id #uuid \"780bd7db-4212-5fe1-8a27-e116c11d14cf\"] [\"780bd7db-4212-5fe1-8a27-e116c11d14cf\" :answer/type :answer.type/math] [\"780bd7db-4212-5fe1-8a27-e116c11d14cf\" :answer/value \"- \\\\sqrt{3} - \\\\frac{\\\\sqrt{2}}{2} + 1\"] [\"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/id #uuid \"518825eb-e534-5e92-90ce-890437b8f837\"] [\"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/key \"result\"] [\"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/type :answer-field.type/blank] [\"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/choices \"780bd7db-4212-5fe1-8a27-e116c11d14cf\"] [\"518825eb-e534-5e92-90ce-890437b8f837\" :answer-field/correct \"780bd7db-4212-5fe1-8a27-e116c11d14cf\"] [\"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/id #uuid \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\"] [\"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right),\\\\qquad y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $a$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\\n| $y$ | $b$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $c$ | $-1$ |\\n| $y$ | $0$ | $\\\\sqrt{3}$ |\\n\\nFind the exact value of $a+b+c$.\\n\\n{{result}}\"] [\"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=0$. Substitute into $x=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(0\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(0\\\\right) \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $y$-row under $t=-1$. Substitute into $y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(-1\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(- \\\\frac{\\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $x$-row under $t=3$. Substitute into $x=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(3\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}a+b+c \\\\\\\\ =\\\\left(1\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =- \\\\sqrt{3} - \\\\frac{\\\\sqrt{2}}{2} + 1\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\\n| $y$ | $- \\\\sqrt{3}$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\\n| $y$ | $0$ | $\\\\sqrt{3}$ |\"] [\"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/difficulty :question.difficulty/hard] [\"e5caf562-27b3-5cd5-86ff-a3aac67391d6\" :question/answer-fields \"518825eb-e534-5e92-90ce-890437b8f837\"] [17592186087717 :knowledge-point/questions \"e5caf562-27b3-5cd5-86ff-a3aac67391d6\"] [\"402dede8-3999-5fcd-943b-1b05961ef173\" :answer/id #uuid \"402dede8-3999-5fcd-943b-1b05961ef173\"] [\"402dede8-3999-5fcd-943b-1b05961ef173\" :answer/type :answer.type/math] [\"402dede8-3999-5fcd-943b-1b05961ef173\" :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\"] [\"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/id #uuid \"b52a37f4-bafd-55a7-b936-9a3922b1f362\"] [\"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/key \"result\"] [\"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/type :answer-field.type/blank] [\"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/choices \"402dede8-3999-5fcd-943b-1b05961ef173\"] [\"b52a37f4-bafd-55a7-b936-9a3922b1f362\" :answer-field/correct \"402dede8-3999-5fcd-943b-1b05961ef173\"] [\"0d6985ec-3500-52de-993a-80591e452c25\" :question/id #uuid \"0d6985ec-3500-52de-993a-80591e452c25\"] [\"0d6985ec-3500-52de-993a-80591e452c25\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right),\\\\qquad y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $a$ | $-1$ | $b$ |\\n| $y$ | $-1$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $0$ | $1$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\frac{1}{2}$ |\\n| $y$ | $1$ | $c$ |\\n\\nFind the exact value of $a-b+c$.\\n\\n{{result}}\"] [\"0d6985ec-3500-52de-993a-80591e452c25\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=-4$. Substitute into $x=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\sin\\\\left(\\\\frac{\\\\pi \\\\left(-4\\\\right)}{6}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(- \\\\frac{2 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{3}}{2}\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $x$-row under $t=-2$. Substitute into $x=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\sin\\\\left(\\\\frac{\\\\pi \\\\left(-2\\\\right)}{6}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(- \\\\frac{\\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{3}}{2}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=1$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(1\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}a-b+c \\\\\\\\ =\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)-\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)+\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =\\\\frac{\\\\sqrt{2}}{2}\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $- \\\\frac{\\\\sqrt{3}}{2}$ | $-1$ | $- \\\\frac{\\\\sqrt{3}}{2}$ |\\n| $y$ | $-1$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $0$ | $1$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\frac{1}{2}$ |\\n| $y$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\"] [\"0d6985ec-3500-52de-993a-80591e452c25\" :question/difficulty :question.difficulty/hard] [\"0d6985ec-3500-52de-993a-80591e452c25\" :question/answer-fields \"b52a37f4-bafd-55a7-b936-9a3922b1f362\"] [17592186087717 :knowledge-point/questions \"0d6985ec-3500-52de-993a-80591e452c25\"] [\"6ba07cc5-77ee-5689-b056-4d702d8a902b\" :answer/id #uuid \"6ba07cc5-77ee-5689-b056-4d702d8a902b\"] [\"6ba07cc5-77ee-5689-b056-4d702d8a902b\" :answer/type :answer.type/math] [\"6ba07cc5-77ee-5689-b056-4d702d8a902b\" :answer/value \"- 2 \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2}\"] [\"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/id #uuid \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\"] [\"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/key \"result\"] [\"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/type :answer-field.type/blank] [\"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/choices \"6ba07cc5-77ee-5689-b056-4d702d8a902b\"] [\"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\" :answer-field/correct \"6ba07cc5-77ee-5689-b056-4d702d8a902b\"] [\"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/id #uuid \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\"] [\"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right),\\\\qquad y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $a$ | $0$ |\\n| $y$ | $c$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $2$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $-1$ |\\n| $y$ | $b$ | $\\\\sqrt{3}$ |\\n\\nFind the exact value of $-a+b+c$.\\n\\n{{result}}\"] [\"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=-3$. Substitute into $x=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(-3\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(- \\\\frac{3 \\\\pi}{4}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $y$-row under $t=2$. Substitute into $y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(2\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(\\\\frac{2 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=-4$. Substitute into $y=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(-4\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(- \\\\frac{4 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}-a+b+c \\\\\\\\ =-\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right) \\\\\\\\ =- 2 \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2}\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-4$ | $-3$ | $-2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $-1$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n| $y$ | $- \\\\sqrt{3}$ | $0$ | $\\\\sqrt{3}$ |\\n\\n| **$t$** | $2$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $-1$ |\\n| $y$ | $- \\\\sqrt{3}$ | $\\\\sqrt{3}$ |\"] [\"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/difficulty :question.difficulty/hard] [\"a5aff6c4-59a0-5be6-97f1-a12599feaff8\" :question/answer-fields \"510cc6fd-ef1b-5e32-9e56-a75c8a60d652\"] [17592186087717 :knowledge-point/questions \"a5aff6c4-59a0-5be6-97f1-a12599feaff8\"] [\"93b636d5-9174-5553-b5f0-d1b76f5a8501\" :answer/id #uuid \"93b636d5-9174-5553-b5f0-d1b76f5a8501\"] [\"93b636d5-9174-5553-b5f0-d1b76f5a8501\" :answer/type :answer.type/math] [\"93b636d5-9174-5553-b5f0-d1b76f5a8501\" :answer/value \"\\\\sqrt{2}\"] [\"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/id #uuid \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\"] [\"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/key \"result\"] [\"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/type :answer-field.type/blank] [\"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/choices \"93b636d5-9174-5553-b5f0-d1b76f5a8501\"] [\"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\" :answer-field/correct \"93b636d5-9174-5553-b5f0-d1b76f5a8501\"] [\"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/id #uuid \"dfe7f575-109f-57a8-8469-d7a292b67702\"] [\"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right),\\\\qquad y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $- \\\\frac{1}{2}$ | $a$ | $\\\\frac{1}{2}$ |\\n| $y$ | $b$ | $1$ | $c$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $\\\\frac{\\\\sqrt{3}}{2}$ |\\n| $y$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\\n\\nFind the exact value of $a+b+c$.\\n\\n{{result}}\"] [\"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/worked-solution \"The $a$ entry is in the $x$-row under $t=0$. Substitute into $x=\\\\sin\\\\left(\\\\frac{\\\\pi t}{6}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\sin\\\\left(\\\\frac{\\\\pi \\\\left(0\\\\right)}{6}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(0\\\\right) \\\\\\\\ &=0\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $y$-row under $t=-1$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(-1\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(- \\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=1$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(1\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}a+b+c \\\\\\\\ =\\\\left(0\\\\right)+\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =\\\\sqrt{2}\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-1$ | $0$ | $1$ |\\n| --- | --- | --- | --- |\\n| $x$ | $- \\\\frac{1}{2}$ | $0$ | $\\\\frac{1}{2}$ |\\n| $y$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $1$ | $\\\\frac{\\\\sqrt{3}}{2}$ |\\n| $y$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\"] [\"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/difficulty :question.difficulty/hard] [\"dfe7f575-109f-57a8-8469-d7a292b67702\" :question/answer-fields \"6c74dd7e-7831-5ab2-bc56-8b230011dc4f\"] [17592186087717 :knowledge-point/questions \"dfe7f575-109f-57a8-8469-d7a292b67702\"] [\"698216b5-6523-5bab-9afb-551bb8856438\" :answer/id #uuid \"698216b5-6523-5bab-9afb-551bb8856438\"] [\"698216b5-6523-5bab-9afb-551bb8856438\" :answer/type :answer.type/math] [\"698216b5-6523-5bab-9afb-551bb8856438\" :answer/value \"- \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2} + 1\"] [\"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/id #uuid \"913dad68-ed72-58c7-b849-508e17f78f3c\"] [\"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/key \"result\"] [\"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/type :answer-field.type/blank] [\"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/choices \"698216b5-6523-5bab-9afb-551bb8856438\"] [\"913dad68-ed72-58c7-b849-508e17f78f3c\" :answer-field/correct \"698216b5-6523-5bab-9afb-551bb8856438\"] [\"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/id #uuid \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\"] [\"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right),\\\\qquad y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right).\\n$$\\n\\nConsider the following table of values. Angles are in radians.\\n\\n| **$t$** | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ | $b$ |\\n| $y$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ |\\n| $y$ | $c$ | $a$ |\\n\\nFind the exact value of $-a+b-c$.\\n\\n{{result}}\"] [\"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/worked-solution \"The $a$ entry is in the $y$-row under $t=4$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}a &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(4\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\pi\\\\right) \\\\\\\\ &=-1\\\\end{aligned}\\n$$\\n\\nThe $b$ entry is in the $x$-row under $t=2$. Substitute into $x=\\\\tan\\\\left(\\\\frac{\\\\pi t}{3}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}b &=\\\\tan\\\\left(\\\\frac{\\\\pi \\\\left(2\\\\right)}{3}\\\\right) \\\\\\\\ &=\\\\tan\\\\left(\\\\frac{2 \\\\pi}{3}\\\\right) \\\\\\\\ &=- \\\\sqrt{3}\\\\end{aligned}\\n$$\\n\\nThe $c$ entry is in the $y$-row under $t=3$. Substitute into $y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{4}\\\\right)$:\\n\\n$$\\n\\\\begin{aligned}c &=\\\\cos\\\\left(\\\\frac{\\\\pi \\\\left(3\\\\right)}{4}\\\\right) \\\\\\\\ &=\\\\cos\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right) \\\\\\\\ &=- \\\\frac{\\\\sqrt{2}}{2}\\\\end{aligned}\\n$$\\n\\nSubstitute the three entries with the signs in the requested expression:\\n\\n$$\\n\\\\begin{gathered}-a+b-c \\\\\\\\ =-\\\\left(-1\\\\right)+\\\\left(- \\\\sqrt{3}\\\\right)-\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ =- \\\\sqrt{3} + \\\\frac{\\\\sqrt{2}}{2} + 1\\\\end{gathered}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ | $- \\\\sqrt{3}$ |\\n| $y$ | $1$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n\\n| **$t$** | $3$ | $4$ |\\n| --- | --- | --- |\\n| $x$ | $0$ | $\\\\sqrt{3}$ |\\n| $y$ | $- \\\\frac{\\\\sqrt{2}}{2}$ | $-1$ |\"] [\"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/difficulty :question.difficulty/hard] [\"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\" :question/answer-fields \"913dad68-ed72-58c7-b849-508e17f78f3c\"] [17592186087717 :knowledge-point/questions \"6b1e8ea8-15aa-5d3b-9214-bdd6c5764764\"] [\"generator\" :question-generator/id #uuid \"664ecab0-2bbb-5e3a-a04b-78471ee297e1\"] [\"generator\" :question-generator/script \"generators/4c/4c9fe9749cdac4cfc8fd9d4b82afb05541e87580c19d1e80c9d1e81ae916d9de/generator.py\"] [17592186087717 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186087717 :knowledge-point/question-generator 17592186698142]]}",
