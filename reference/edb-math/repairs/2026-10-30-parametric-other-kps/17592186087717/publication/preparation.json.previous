81}{4}\\\\right)=\\\\frac{69}{4}.\\n$$\\n\\n- To find the value of $x(4),$ we substitute $t=4$ into $$\\n\\\\displaystyle x=\\\\frac{t^{3}}{4} - \\\\frac{4 t^{2}}{3} + 2.\\n$$ This gives\\n\\n$$\\nx(4)=\\\\frac{(4)^{3}}{4} - \\\\frac{4 (4)^{2}}{3} + 2=(2)+\\\\left(- \\\\frac{64}{3}\\\\right)+(16)=- \\\\frac{10}{3}.\\n$$\\n\\nThen the table is\\n\\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\\n| --- | --- | --- | --- | --- | --- | --- |\\n| $x$ | $2$ | $\\\\frac{11}{12}$ | $- \\\\frac{4}{3}$ | $- \\\\frac{13}{4}$ | $- \\\\frac{10}{3}$ | $- \\\\frac{1}{12}$ |\\n| $y$ | $3$ | $\\\\frac{37}{12}$ | $\\\\frac{19}{3}$ | $\\\\frac{69}{4}$ | $\\\\frac{121}{3}$ | $\\\\frac{961}{12}$ |\"} {:db/id 17592186557680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"480406b6-e969-5e42-b1ca-fb8ba80d3eb8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{49}{3}\" :db/id 17592186557645}] :answer-field/correct {:answer/id #uuid \"480406b6-e969-5e42-b1ca-fb8ba80d3eb8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{49}{3}\" :db/id 17592186557645} :answer-field/id #uuid \"bae13d25-f70b-5e61-a566-6bf1e1e81a4e\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557679} {:answer-field/choices [{:answer/id #uuid \"2595a398-b533-553d-9bf4-9bc67715bd84\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{69}{4}\" :db/id 17592186557638}] :answer-field/correct {:answer/id #uuid \"2595a398-b533-553d-9bf4-9bc67715bd84\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{69}{4}\" :db/id 17592186557638} :answer-field/id #uuid \"db9425c1-2ee6-5925-9e52-a12ed9c085de\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557690} {:answer-field/choices [{:answer/id #uuid \"2579612f-833f-55d0-895a-07ac3adba31a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{20}{3}\" :db/id 17592186557637}] :answer-field/correct {:answer/id #uuid \"2579612f-833f-55d0-895a-07ac3adba31a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{20}{3}\" :db/id 17592186557637} :answer-field/id #uuid \"ee675df7-97cc-50e5-856a-aff922b73bb6\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557693}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"bb4157ae-f026-5afc-89b8-0d9a90c170cf\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- \\\\frac{3 t^{2}}{4} - \\\\frac{t}{3} - 3,\\\\,y=\\\\frac{5 t^{2}}{4} + \\\\frac{4 t}{3} + 2,\\\\,0\\\\le t\\\\le 5.\\n$$\\n\\nFill in the blanks in the following table of values:\\n\\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\\n| --- | --- | --- | --- | --- | --- | --- |\\n| $x$ | $-3$ | $- \\\\frac{49}{12}$ | {{field-1}} | $- \\\\frac{43}{4}$ | {{field-3}} | $- \\\\frac{281}{12}$ |\\n| $y$ | $2$ | $\\\\frac{55}{12}$ | $\\\\frac{29}{3}$ | {{field-2}} | $\\\\frac{82}{3}$ | $\\\\frac{479}{12}$ |\" :question/worked-solution \"- To find the value of $x(2),$ we substitute $t=2$ into $$\\n\\\\displaystyle x=- \\\\frac{3 t^{2}}{4} - \\\\frac{t}{3} - 3.\\n$$ This gives\\n\\n$$\\nx(2)=- \\\\frac{3 (2)^{2}}{4} - \\\\frac{(2)}{3} - 3=(-3)+(-3)+\\\\left(- \\\\frac{2}{3}\\\\right)=- \\\\frac{20}{3}.\\n$$\\n\\n- To find the value of $y(3),$ we substitute $t=3$ into $$\\n\\\\displaystyle y=\\\\frac{5 t^{2}}{4} + \\\\frac{4 t}{3} + 2.\\n$$ This gives\\n\\n$$\\ny(3)=\\\\frac{5 (3)^{2}}{4} + \\\\frac{4 (3)}{3} + 2=(2)+(4)+\\\\left(\\\\frac{45}{4}\\\\right)=\\\\frac{69}{4}.\\n$$\\n\\n- To find the value of $x(4),$ we substitute $t=4$ into $$\\n\\\\displaystyle x=- \\\\frac{3 t^{2}}{4} - \\\\frac{t}{3} - 3.\\n$$ This gives\\n\\n$$\\nx(4)=- \\\\frac{3 (4)^{2}}{4} - \\\\frac{(4)}{3} - 3=(-3)+(-12)+\\\\left(- \\\\frac{4}{3}\\\\right)=- \\\\frac{49}{3}.\\n$$\\n\\nThen the table is\\n\\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\\n| --- | --- | --- | --- | --- | --- | --- |\\n| $x$ | $-3$ | $- \\\\frac{49}{12}$ | $- \\\\frac{20}{3}$ | $- \\\\frac{43}{4}$ | $- \\\\frac{49}{3}$ | $- \\\\frac{281}{12}$ |\\n| $y$ | $2$ | $\\\\frac{55}{12}$ | $\\\\frac{29}{3}$ | $\\\\frac{69}{4}$ | $\\\\frac{82}{3}$ | $\\\\frac{479}{12}$ |\"} {:db/id 17592186557691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a4f8f4b6-ada0-5154-9f40-d3aff5103b0b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{322}{3}\" :db/id 17592186557672} {:answer/id #uuid \"bf14cb3f-585e-4422-9b8c-53bed131e9e7\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{322}{3}\" :db/id 17592186747031}] :answer-field/correct {:answer/id #uuid \"a4f8f4b6-ada0-5154-9f40-d3aff5103b0b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{322}{3}\" :db/id 17592186557672} :answer-field/id #uuid \"5247a865-f473-556a-aad4-a2a99ac9144a\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557650} {:answer-field/choices [{:answer/id #uuid \"37bd07eb-49fa-5662-9c38-01ef69ab6260\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{64}{3}\" :db/id 17592186557640} {:answer/id #uuid \"5cd3fbc1-d532-47e2-9db9-1a91b87254e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{64}{3}\" :db/id 17592186747032}] :answer-field/correct {:answer/id #uuid \"37bd07eb-49fa-5662-9c38-01ef69ab6260\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{64}{3}\" :db/id 17592186557640} :answer-field/id #uuid \"58e24cfc-78c6-5888-9f28-4a000bf35364\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557653} {:answer-field/choices [{:answer/id #uuid \"be2e1ab8-84d3-52b0-a459-8725d6684bf0\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{69}{4}\" :db/id 17592186557682} {:answer/id #uuid \"15a98a23-5293-4e34-a3db-1104779f7159\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{69}{4}\" :db/id 17592186747033}] :answer-field/correct {:answer/id #uuid \"be2e1ab8-84d3-52b0-a459-8725d6684bf0\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{69}{4}\" :db/id 17592186557682} :answer-field/id #uuid \"75a963ed-b28a-5f2e-97ea-01f367ccb0bf\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557661}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e75a3bd4-87cd-57e1-92c7-5db72a5b0538\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- \\\\frac{5 t^{3}}{4} - \\\\frac{4 t^{2}}{3} - 6,\\\\,y=- \\\\frac{3 t^{3}}{4} - \\\\frac{t^{2}}{3} + 6,\\\\,0\\\\le t\\\\le 5.\\n$$\\n\\nFill in the blanks in the following table of values:\\n\\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\\n| --- | --- | --- | --- | --- | --- | --- |\\n| $x$ | $-6$ | $- \\\\frac{103}{12}$ | {{field-1}} | $- \\\\frac{207}{4}$ | {{field-3}} | $- \\\\frac{2347}{12}$ |\\n| $y$ | $6$ | $\\\\frac{59}{12}$ | $- \\\\frac{4}{3}$ | {{field-2}} | $- \\\\frac{142}{3}$ | $- \\\\frac{1153}{12}$ |\" :question/worked-solution \"- To find the value of $x(2),$ we substitute $t=2$ into $$\\n\\\\displaystyle x=- \\\\frac{5 t^{3}}{4} - \\\\frac{4 t^{2}}{3} - 6.\\n$$ This gives\\n\\n$$\\nx(2)=- \\\\frac{5 (2)^{3}}{4} - \\\\frac{4 (2)^{2}}{3} - 6=(-6)+(-10)+\\\\left(- \\\\frac{16}{3}\\\\right)=- \\\\frac{64}{3}.\\n$$\\n\\n- To find the value of $y(3),$ we substitute $t=3$ into $$\\n\\\\displaystyle y=- \\\\frac{3 t^{3}}{4} - \\\\frac{t^{2}}{3} + 6.\\n$$ This gives\\n\\n$$\\ny(3)=- \\\\frac{3 (3)^{3}}{4} - \\\\frac{(3)^{2}}{3} + 6=(6)+\\\\left(- \\\\frac{81}{4}\\\\right)+(-3)=- \\\\frac{69}{4}.\\n$$\\n\\n- To find the value of $x(4),$ we substitute $t=4$ into $$\\n\\\\displaystyle x=- \\\\frac{5 t^{3}}{4} - \\\\frac{4 t^{2}}{3} - 6.\\n$$ This gives\\n\\n$$\\nx(4)=- \\\\frac{5 (4)^{3}}{4} - \\\\frac{4 (4)^{2}}{3} - 6=(-6)+(-80)+\\\\left(- \\\\frac{64}{3}\\\\right)=- \\\\frac{322}{3}.\\n$$\\n\\nThen the table is\\n\\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\\n| --- | --- | --- | --- | --- | --- | --- |\\n| $x$ | $-6$ | $- \\\\frac{103}{12}$ | $- \\\\frac{64}{3}$ | $- \\\\frac{207}{4}$ | $- \\\\frac{322}{3}$ | $- \\\\frac{2347}{12}$ |\\n| $y$ | $6$ | $\\\\frac{59}{12}$ | $- \\\\frac{4}{3}$ | $- \\\\frac{69}{4}$ | $- \\\\frac{142}{3}$ | $- \\\\frac{1153}{12}$ |\"} {:db/id 17592186557694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7f7d7106-b364-5ae1-a659-af8358da8677\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\" :db/id 17592186557663}] :answer-field/correct {:answer/id #uuid \"7f7d7106-b364-5ae1-a659-af8358da8677\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\" :db/id 17592186557663} :answer-field/id #uuid \"5b620d2d-fa44-52d1-b2b5-1f2658dac4e9\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557655} {:answer-field/choices [{:answer/id #uuid \"4c1fcab0-b87b-507f-8336-9a8d3bccef44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{31}{4}\" :db/id 17592186557646}] :answer-field/correct {:answer/id #uuid \"4c1fcab0-b87b-507f-8336-9a8d3bccef44\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{31}{4}\" :db/id 17592186557646} :answer-field/id #uuid \"69f8fe79-5778-5d0d-89df-696693ee1622\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557659} {:answer-field/choices [{:answer/id #uuid \"17c4d7f8-49ea-5d8e-b99f-d50781db35a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\" :db/id 17592186557630}] :answer-field/correct {:answer/id #uuid \"17c4d7f8-49ea-5d8e-b99f-d50781db35a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\" :db/id 17592186557630} :answer-field/id #uuid \"b240e7d2-d15d-5e54-9892-1f853f797a82\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186557677}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f4540669-0fed-52c3-9737-1d7b58fc3315\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=\\\\frac{t^{2}}{4} - \\\\frac{4 t}{3} + 2,\\\\,y=\\\\frac{3 t^{2}}{4} - \\\\frac{2 t}{3} + 3,\\\\,0\\\\le t\\\\le 5.\\n$$\\n\\nFill in the blanks in the following table of values:\\n\\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\\n| --- | --- | --- | --- | --- | --- | --- |\\n| $x$ | $2$ | $\\\\frac{11}{12}$ | {{field-1}} | $\\\\frac{1}{4}$ | {{field-3}} | $\\\\frac{19}{12}$ |\\n| $y$ | $3$ | $\\\\frac{37}{12}$ | $\\\\frac{14}{3}$ | {{field-2}} | $\\\\frac{37}{3}$ | $\\\\frac{221}{12}$ |\" :question/worked-solution \"- To find the value of $x(2),$ we substitute $t=2$ into $x=\\\\frac{t^{2}}{4} - \\\\frac{4 t}{3} + 2.$ This gives\\n\\n$$\\nx(2)=\\\\frac{(2)^{2}}{4} - \\\\frac{4 (2)}{3} + 2=(2)+\\\\left(- \\\\frac{8}{3}\\\\right)+(1)=\\\\frac{1}{3}.\\n$$\\n\\n- To find the value of $y(3),$ we substitute $t=3$ into $$\\n\\\\displaystyle y=\\\\frac{3 t^{2}}{4} - \\\\frac{2 t}{3} + 3.\\n$$ This gives\\n\\n$$\\ny(3)=\\\\frac{3 (3)^{2}}{4} - \\\\frac{2 (3)}{3} + 3=(3)+(-2)+\\\\left(\\\\frac{27}{4}\\\\right)=\\\\frac{31}{4}.\\n$$\\n\\n- To find the value of $x(4),$ we substitute $t=4$ into $x=\\\\frac{t^{2}}{4} - \\\\frac{4 t}{3} + 2.$ This gives\\n\\n$$\\nx(4)=\\\\frac{(4)^{2}}{4} - \\\\frac{4 (4)}{3} + 2=(2)+\\\\left(- \\\\frac{16}{3}\\\\right)+(4)=\\\\frac{2}{3}.\\n$$\\n\\nThen the table is\\n\\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\\n| --- | --- | --- | --- | --- | --- | --- |\\n| $x$ | $2$ | $\\\\frac{11}{12}$ | $\\\\frac{1}{3}$ | $\\\\frac{1}{4}$ | $\\\\frac{2}{3}$ | $\\\\frac{19}{12}$ |\\n| $y$ | $3$ | $\\\\frac{37}{12}$ | $\\\\frac{14}{3}$ | $\\\\frac{31}{4}$ | $\\\\frac{37}{3}$ | $\\\\frac{221}{12}$ |\"} {:db/id 17592186697642 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1ac25246-3153-5bc7-9c7a-e1323ff4efcc\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\" :db/id 17592186697637}] :answer-field/correct {:answer/id #uuid \"1ac25246-3153-5bc7-9c7a-e1323ff4efcc\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\" :db/id 17592186697637} :answer-field/id #uuid \"29dd3737-7889-5d0d-aee8-9285c4931e86\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186697638} {:answer-field/choices [{:answer/id #uuid \"c79a8f1f-cb00-506d-bd4b-a3fb8ef0e424\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\" :db/id 17592186697650}] :answer-field/correct {:answer/id #uuid \"c79a8f1f-cb00-506d-bd4b-a3fb8ef0e424\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\" :db/id 17592186697650} :answer-field/id #uuid \"6b9ac73b-7b7d-5e34-bbe8-45b0c4d75776\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186697643} {:answer-field/choices [{:answer/id #uuid \"9ac8f7f0-05b6-55ff-a51f-14433d0c00a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\" :db/id 17592186697648}] :answer-field/correct {:answer/id #uuid \"9ac8f7f0-05b6-55ff-a51f-14433d0c00a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\" :db/id 17592186697648} :answer-field/id #uuid \"f5a1377a-b174-5967-b4e3-0492fec907ed\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186697652}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"68ea139d-8f83-5ecb-b070-c337ebdf0983\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=2t-1,\\\\qquad y=t^2+1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks. Use the value of $t$ at the top of each column in the formula for that row. For example, the first entry in the $x$-row is $x(-2)=2(-2)-1=-5$.\\n\\n| $t$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $-5$ | {{field-1}} | $-1$ | $1$ | {{field-2}} |\\n| $y$ | {{field-3}} | $2$ | $1$ | $2$ | $5$ |\" :question/worked-solution \"The row tells us which formula to use, and the column tells us the value of $t$.\\n\\nFor the $x$-entry under $t=-1$, substitute $-1$ into $x=2t-1$:\\n\\n$$\\nx(-1)=2(-1)-1=-2-1=-3.\\n$$\\n\\nFor the $x$-entry under $t=2$, use the same formula:\\n\\n$$\\nx(2)=2(2)-1=4-1=3.\\n$$\\n\\nFor the $y$-entry under $t=-2$, use $y=t^2+1$. Square the entire negative number:\\n\\n$$\\ny(-2)=(-2)^2+1=4+1=5.\\n$$\\n\\nThe completed table is\\n\\n| $t$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $-5$ | $-3$ | $-1$ | $1$ | $3$ |\\n| $y$ | $5$ | $2$ | $1$ | $2$ | $5$ |\"} {:db/id 17592186697645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0aa20801-08a2-5e2d-950e-e3cc94ff6da5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}-2}{2}\" :db/id 17592186697633} {:answer/id #uuid \"33dd7ec4-0126-5adf-812f-11166227af2c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}-\\\\sqrt{2}-1}{2}\" :db/id 17592186697639} {:answer/id #uuid \"4612bcf9-ddbe-577d-8ecf-f5c64ae4b720\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}+\\\\sqrt{2}-1}{2}\" :db/id 17592186697640} {:answer/id #uuid \"620e6851-0bd2-5bf8-b300-14d8ebc4ddda\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186697641} {:answer/id #uuid \"8fe19e41-701e-5fe0-b25b-dd12d35b61a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}-\\\\sqrt{2}+1}{2}\" :db/id 17592186697647}] :answer-field/correct {:answer/id #uuid \"33dd7ec4-0126-5adf-812f-11166227af2c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}-\\\\sqrt{2}-1}{2}\" :db/id 17592186697639} :answer-field/id #uuid \"b429b33e-f0af-50a0-b280-3a1a49ca466d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186697649}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"86dd7dd4-5849-554c-9e2d-91445aacb13c\" :question/problem \"For the parametric curve\\n\\n$$\\nx=\\\\sin\\\\left(\\\\frac{\\\\pi t}{4}\\\\right),\\\\qquad y=\\\\cos\\\\left(\\\\frac{\\\\pi t}{6}\\\\right),\\\\qquad -3\\\\le t\\\\le 4,\\n$$\\n\\nconsider the following table of values. Angles are in radians.\\n\\n| $t$ | $-3$ | $-2$ | $0$ | $1$ | $4$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $a$ | $-1$ | $0$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n| $y$ | $0$ | $b$ | $1$ | $c$ | $-\\\\frac{1}{2}$ |\\n\\nFind the exact value of $a-b+c$.\" :question/worked-solution \"Read each letter's row and column before substituting.\\n\\nThe entry $a$ is an $x$-value at $t=-3$:\\n\\n$$\\na=\\\\sin\\\\left(\\\\frac{\\\\pi(-3)}{4}\\\\right)=\\\\sin\\\\left(-\\\\frac{3\\\\pi}{4}\\\\right)=-\\\\frac{\\\\sqrt{2}}{2}.\\n$$\\n\\nHere $\\\\sin(-\\\\theta)=-\\\\sin\\\\theta$ and $\\\\sin(3\\\\pi/4)=\\\\sqrt{2}/2$.\\n\\nThe entry $b$ is a $y$-value at $t=-2$:\\n\\n$$\\nb=\\\\cos\\\\left(\\\\frac{\\\\pi(-2)}{6}\\\\right)=\\\\cos\\\\left(-\\\\frac{\\\\pi}{3}\\\\right)=\\\\frac{1}{2}.\\n$$\\n\\nCosine is even, so $\\\\cos(-\\\\pi/3)=\\\\cos(\\\\pi/3)$.\\n\\nThe entry $c$ is a $y$-value at $t=1$:\\n\\n$$\\nc=\\\\cos\\\\left(\\\\frac{\\\\pi(1)}{6}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)=\\\\frac{\\\\sqrt{3}}{2}.\\n$$\\n\\nFinally, substitute these three entries into the requested expression, keeping the subtraction before $b$:\\n\\n$$\\na-b+c=-\\\\frac{\\\\sqrt{2}}{2}-\\\\frac{1}{2}+\\\\frac{\\\\sqrt{3}}{2}=\\\\frac{\\\\sqrt{3}-\\\\sqrt{2}-1}{2}.\\n$$\\n\\nThe completed table is\\n\\n| $t$ | $-3$ | $-2$ | $0$ | $1$ | $4$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $-\\\\frac{\\\\sqrt{2}}{2}$ | $-1$ | $0$ | $\\\\frac{\\\\sqrt{2}}{2}$ | $0$ |\\n| $y$ | $0$ | $\\\\frac{1}{2}$ | $1$ | $\\\\frac{\\\\sqrt{3}}{2}$ | $-\\\\frac{1}{2}$ |\"} {:db/id 17592186697653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e3f6cd6f-feb8-5fe8-8a90-33632f5509a9\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186697651}] :answer-field/correct {:answer/id #uuid \"e3f6cd6f-feb8-5fe8-8a90-33632f5509a9\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186697651} :answer-field/id #uuid \"0d405c02-fc58-51d3-b300-ae1c90f40fc4\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186697634} {:answer-field/choices [{:answer/id #uuid \"1160877a-343d-5fc8-aac7-64b1af59bba7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186697635}] :answer-field/correct {:answer/id #uuid \"1160877a-343d-5fc8-aac7-64b1af59bba7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186697635} :answer-field/id #uuid \"12a46afb-ed30-514f-a742-c43b99568561\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186697636} {:answer-field/choices [{:answer/id #uuid \"8bcf4e3f-6edb-5253-90d7-a2b123cbc029\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\" :db/id 17592186697646}] :answer-field/correct {:answer/id #uuid \"8bcf4e3f-6edb-5253-90d7-a2b123cbc029\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\" :db/id 17592186697646} :answer-field/id #uuid \"80b84a21-8b7e-5c23-91e4-90c00658f335\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186697644}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"fca75a6f-ed74-5c52-b7db-81a5147488d0\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=t^2-t,\\\\qquad y=\\\\frac{t+1}{t-1},\\\\qquad -3\\\\le t\\\\le 0.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\n| $t$ | $-3$ | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- | --- |\\n| $x$ | $12$ | {{field-1}} | $2$ | $0$ |\\n| $y$ | {{field-2}} | $\\\\frac{1}{3}$ | $0$ | {{field-3}} |\" :question/worked-solution \"The missing $x$-entry is in the column $t=-2$. Substitute into $x=t^2-t$:\\n\\n$$\\nx(-2)=(-2)^2-(-2)=4+2=6.\\n$$\\n\\nFor the missing $y$-entries, substitute the column's parameter into both the numerator and the denominator of $y=\\\\frac{t+1}{t-1}$:\\n\\n$$\\ny(-3)=\\\\frac{-3+1}{-3-1}=\\\\frac{-2}{-4}=\\\\frac{1}{2},\\n$$\\n\\n$$\\ny(0)=\\\\frac{0+1}{0-1}=\\\\frac{1}{-1}=-1.\\n$$\\n\\nThe denominators are nonzero at all the listed parameter values. The completed table is\\n\\n| $t$ | $-3$ | $-2$ | $-1$ | $0$ |\\n| --- | --- | --- | --- | --- |\\n| $x$ | $12$ | $6$ | $2$ | $0$ |\\n| $y$ | $\\\\frac{1}{2}$ | $\\\\frac{1}{3}$ | $0$ | $-1$ |\"} {:db/id 17592186698121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"95080386-ba52-5508-83c3-b56c1665d28b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186698126}] :answer-field/correct {:answer/id #uuid \"95080386-ba52-5508-83c3-b56c1665d28b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186698126} :answer-field/id #uuid \"aaeba00c-d120-5e96-9059-a314382c774e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698130} {:answer-field/choices [{:answer/id #uuid \"9d9c76bd-b0e8-51bc-8963-f6991f6f5009\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186698127}] :answer-field/correct {:answer/id #uuid \"9d9c76bd-b0e8-51bc-8963-f6991f6f5009\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186698127} :answer-field/id #uuid \"ca74996f-a9e1-588f-822c-8a43fe4b66cb\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698135} {:answer-field/choices [{:answer/id #uuid \"941c8040-96d6-5850-af56-8af967babfbd\" :answer/type {:db/ident :answer.type/math} :answer/value \"-5\" :db/id 17592186698125}] :answer-field/correct {:answer/id #uuid \"941c8040-96d6-5850-af56-8af967babfbd\" :answer/type {:db/ident :answer.type/math} :answer/value \"-5\" :db/id 17592186698125} :answer-field/id #uuid \"d271a935-7a01-5a55-b8ee-31c44c8d02dd\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698137}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"6eb50d16-40b6-5dfc-b62f-e9e8d896c408\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- 2 t - 1,\\\\qquad y=- t^{2} - 1,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=- 2 \\\\left(-2\\\\right) - 1=3$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $3$ | {{field-2}} | $-1$ | $-3$ | $-5$ |\\n| $y$ | $-5$ | $-2$ | {{field-1}} | $-2$ | {{field-3}} |\" :question/worked-solution \"The missing entry is in the $y$-row under $t=0$. Substitute into $y=- t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=- \\\\left(0\\\\right)^{2} - 1 \\\\\\\\ &=-1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=- 2 t - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=- 2 \\\\left(-1\\\\right) - 1 \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t^{2} - 1$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=- \\\\left(2\\\\right)^{2} - 1 \\\\\\\\ &=-5\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $3$ | $1$ | $-1$ | $-3$ | $-5$ |\\n| $y$ | $-5$ | $-2$ | $-1$ | $-2$ | $-5$ |\"} {:db/id 17592186698122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3ab3f1ae-28b2-5f8c-993e-34643d52a9eb\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186698114}] :answer-field/correct {:answer/id #uuid \"3ab3f1ae-28b2-5f8c-993e-34643d52a9eb\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186698114} :answer-field/id #uuid \"a3cb7f62-fc37-5436-ad36-35291c3bd9d5\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698128} {:answer-field/choices [{:answer/id #uuid \"3685ab30-02fd-52d8-8b72-935c9467a6e6\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186698112}] :answer-field/correct {:answer/id #uuid \"3685ab30-02fd-52d8-8b72-935c9467a6e6\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186698112} :answer-field/id #uuid \"e1558c42-7ae1-57f5-ac82-b5bab4db30ec\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698138} {:answer-field/choices [{:answer/id #uuid \"2e575b9a-1adc-5e76-83bf-a687525b0013\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186698110}] :answer-field/correct {:answer/id #uuid \"2e575b9a-1adc-5e76-83bf-a687525b0013\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186698110} :answer-field/id #uuid \"ebb09eae-223f-5d30-9183-b5e9215b9107\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698139}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"714507d9-4ce5-52aa-b483-53ba86dda909\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=1 - t,\\\\qquad y=2 - t^{2},\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=1 - \\\\left(-2\\\\right)=3$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $3$ | {{field-2}} | $1$ | $0$ | $-1$ |\\n| $y$ | $-2$ | $1$ | {{field-3}} | {{field-1}} | $-2$ |\" :question/worked-solution \"The missing entry is in the $y$-row under $t=1$. Substitute into $y=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}y(1) &=2 - \\\\left(1\\\\right)^{2} \\\\\\\\ &=1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=1 - t$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=1 - \\\\left(-1\\\\right) \\\\\\\\ &=2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=2 - t^{2}$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=2 - \\\\left(0\\\\right)^{2} \\\\\\\\ &=2\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $3$ | $2$ | $1$ | $0$ | $-1$ |\\n| $y$ | $-2$ | $1$ | $2$ | $1$ | $-2$ |\"} {:db/id 17592186698133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"cc8abf18-1dad-5023-998f-ee754e335050\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\" :db/id 17592186698136}] :answer-field/correct {:answer/id #uuid \"cc8abf18-1dad-5023-998f-ee754e335050\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\" :db/id 17592186698136} :answer-field/id #uuid \"136e6231-d339-54ec-89cd-db326348eb00\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698107} {:answer-field/choices [{:answer/id #uuid \"61ea9d23-23b8-52d0-9f63-b7e54a8e249b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186698119}] :answer-field/correct {:answer/id #uuid \"61ea9d23-23b8-52d0-9f63-b7e54a8e249b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186698119} :answer-field/id #uuid \"42f5cb7a-f946-5338-af4d-cec632603cb1\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698116} {:answer-field/choices [{:answer/id #uuid \"3ffcee8f-b660-5909-9d6b-1706297249eb\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186698115}] :answer-field/correct {:answer/id #uuid \"3ffcee8f-b660-5909-9d6b-1706297249eb\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\" :db/id 17592186698115} :answer-field/id #uuid \"66a32878-70f2-5074-b9d0-a40eb88244f2\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698120}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b58c8abe-2f94-54d5-96d8-ac84c9817dff\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=t^{2} - 2,\\\\qquad y=3 t + 3,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=\\\\left(-2\\\\right)^{2} - 2=2$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $2$ | {{field-1}} | $-2$ | $-1$ | {{field-3}} |\\n| $y$ | {{field-2}} | $0$ | $3$ | $6$ | $9$ |\" :question/worked-solution \"The missing entry is in the $x$-row under $t=-1$. Substitute into $x=t^{2} - 2$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=\\\\left(-1\\\\right)^{2} - 2 \\\\\\\\ &=-1\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=3 t + 3$:\\n\\n$$\\n\\\\begin{aligned}y(-2) &=3 \\\\left(-2\\\\right) + 3 \\\\\\\\ &=-3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=2$. Substitute into $x=t^{2} - 2$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=\\\\left(2\\\\right)^{2} - 2 \\\\\\\\ &=2\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $2$ | $-1$ | $-2$ | $-1$ | $2$ |\\n| $y$ | $-3$ | $0$ | $3$ | $6$ | $9$ |\"} {:db/id 17592186698140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"764e1e16-b9b5-5e51-9f35-1d0ddee4c232\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\" :db/id 17592186698124}] :answer-field/correct {:answer/id #uuid \"764e1e16-b9b5-5e51-9f35-1d0ddee4c232\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\" :db/id 17592186698124} :answer-field/id #uuid \"2f1faedd-0bee-57d0-b3b8-51b2904f51bc\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698111} {:answer-field/choices [{:answer/id #uuid \"a934d031-fb2b-58ec-9e86-a18e325d3d9d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-6\" :db/id 17592186698129}] :answer-field/correct {:answer/id #uuid \"a934d031-fb2b-58ec-9e86-a18e325d3d9d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-6\" :db/id 17592186698129} :answer-field/id #uuid \"39314eb8-e399-5546-8673-a418f7b4eb67\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698113} {:answer-field/choices [{:answer/id #uuid \"1a563dad-edcc-5f5f-8fb3-7e77cbcd139d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-7\" :db/id 17592186698108}] :answer-field/correct {:answer/id #uuid \"1a563dad-edcc-5f5f-8fb3-7e77cbcd139d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-7\" :db/id 17592186698108} :answer-field/id #uuid \"bf83c4af-598a-5a64-984f-14664cdfb9b3\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698134}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"f00473b1-3cdf-546b-8785-e2f69f16700e\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=- t^{2} - 2,\\\\qquad y=2 t - 3,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=- \\\\left(-2\\\\right)^{2} - 2=-6$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $-6$ | {{field-1}} | $-2$ | $-3$ | {{field-3}} |\\n| $y$ | {{field-2}} | $-5$ | $-3$ | $-1$ | $1$ |\" :question/worked-solution \"The missing entry is in the $x$-row under $t=-1$. Substitute into $x=- t^{2} - 2$:\\n\\n$$\\n\\\\begin{aligned}x(-1) &=- \\\\left(-1\\\\right)^{2} - 2 \\\\\\\\ &=-3\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=2 t - 3$:\\n\\n$$\\n\\\\begin{aligned}y(-2) &=2 \\\\left(-2\\\\right) - 3 \\\\\\\\ &=-7\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=2$. Substitute into $x=- t^{2} - 2$:\\n\\n$$\\n\\\\begin{aligned}x(2) &=- \\\\left(2\\\\right)^{2} - 2 \\\\\\\\ &=-6\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $-6$ | $-3$ | $-2$ | $-3$ | $-6$ |\\n| $y$ | $-7$ | $-5$ | $-3$ | $-1$ | $1$ |\"} {:db/id 17592186698141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"20038365-556a-554d-832f-8de617ae3321\" :answer/type {:db/ident :answer.type/math} :answer/value \"-7\" :db/id 17592186698109}] :answer-field/correct {:answer/id #uuid \"20038365-556a-554d-832f-8de617ae3321\" :answer/type {:db/ident :answer.type/math} :answer/value \"-7\" :db/id 17592186698109} :answer-field/id #uuid \"5b65411e-d709-50f1-a8e3-6991f23a4f06\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698117} {:answer-field/choices [{:answer/id #uuid \"b17fbbd2-22ba-59d7-b46d-a44d71fd87b3\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\" :db/id 17592186698132}] :answer-field/correct {:answer/id #uuid \"b17fbbd2-22ba-59d7-b46d-a44d71fd87b3\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\" :db/id 17592186698132} :answer-field/id #uuid \"5e1c7517-803a-5992-837a-97f2924d48ee\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698118} {:answer-field/choices [{:answer/id #uuid \"73ff40ea-ec30-5b41-bc55-ff735c2859ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"-6\" :db/id 17592186698123}] :answer-field/correct {:answer/id #uuid \"73ff40ea-ec30-5b41-bc55-ff735c2859ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"-6\" :db/id 17592186698123} :answer-field/id #uuid \"ae672d7b-70e0-5702-b631-fbbc15772c9e\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186698131}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"fd565012-a3a9-5a51-b22a-e588daee81a8\" :question/problem \"Consider the curve with parametric equations\\n\\n$$\\nx=3 t - 1,\\\\qquad y=- t^{2} - 2,\\\\qquad -2\\\\le t\\\\le 2.\\n$$\\n\\nFill in the three blanks in the table. Give exact values.\\n\\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-1)=3 \\\\left(-1\\\\right) - 1=-4$.\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | {{field-3}} | $-4$ | $-1$ | $2$ | $5$ |\\n| $y$ | $-6$ | $-3$ | {{field-1}} | $-3$ | {{field-2}} |\" :question/worked-solution \"The missing entry is in the $y$-row under $t=0$. Substitute into $y=- t^{2} - 2$:\\n\\n$$\\n\\\\begin{aligned}y(0) &=- \\\\left(0\\\\right)^{2} - 2 \\\\\\\\ &=-2\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t^{2} - 2$:\\n\\n$$\\n\\\\begin{aligned}y(2) &=- \\\\left(2\\\\right)^{2} - 2 \\\\\\\\ &=-6\\\\end{aligned}\\n$$\\n\\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=3 t - 1$:\\n\\n$$\\n\\\\begin{aligned}x(-2) &=3 \\\\left(-2\\\\right) - 1 \\\\\\\\ &=-7\\\\end{aligned}\\n$$\\n\\nThe completed table is\\n\\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\\n| --- | --- | --- | --- | --- | --- |\\n| $x$ | $-7$ | $-4$ | $-1$ | $2$ | $5$ |\\n| $y$ | $-6$ | $-3$ | $-2$ | $-3$ | $-6$ |\"}] :knowledge-point/title \"Filling a Table of Values for a Parametric Curve\"}",
