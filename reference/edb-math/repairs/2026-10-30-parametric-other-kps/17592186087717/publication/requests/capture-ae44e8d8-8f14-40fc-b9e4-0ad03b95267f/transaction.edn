ddb480df7"] [:db/add "dd116258-ab80-55bb-94e9-3a3ddb480df7" :question/problem "Consider the curve with parametric equations\n\n$$\nx=3 t - 1,\\qquad y=t^{2} - 1,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-1)=3 \\left(-1\\right) - 1=-4$.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | {{field-2}} | $-4$ | $-1$ |\n| $y$ | $3$ | {{field-1}} | $-1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $2$ | $5$ |\n| $y$ | $0$ | {{field-3}} |"] [:db/add "dd116258-ab80-55bb-94e9-3a3ddb480df7" :question/worked-solution "The missing entry is in the $y$-row under $t=-1$. Substitute into $y=t^{2} - 1$:\n\n$$\n\\begin{aligned}y(-1) &=\\left(-1\\right)^{2} - 1 \\\\ &=0\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=3 t - 1$:\n\n$$\n\\begin{aligned}x(-2) &=3 \\left(-2\\right) - 1 \\\\ &=-7\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=t^{2} - 1$:\n\n$$\n\\begin{aligned}y(2) &=\\left(2\\right)^{2} - 1 \\\\ &=3\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $-7$ | $-4$ | $-1$ |\n| $y$ | $3$ | $0$ | $-1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $2$ | $5$ |\n| $y$ | $0$ | $3$ |"] [:db/add "dd116258-ab80-55bb-94e9-3a3ddb480df7" :question/difficulty :question.difficulty/easy] [:db/add "dd116258-ab80-55bb-94e9-3a3ddb480df7" :question/answer-fields "a13f25ae-650e-520c-a28a-2f653c201bcd"] [:db/add "dd116258-ab80-55bb-94e9-3a3ddb480df7" :question/answer-fields "b9f42515-6266-5f99-be4c-b325c3057d63"] [:db/add "dd116258-ab80-55bb-94e9-3a3ddb480df7" :question/answer-fields "5b396ae2-4c0f-565b-8f45-e0e8038306cb"] [:db/ensure "dd116258-ab80-55bb-94e9-3a3ddb480df7" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "dd116258-ab80-55bb-94e9-3a3ddb480df7"] [:db/add "2b814dd9-4f38-5c2d-9fae-541de879bc69" :answer/id #uuid "2b814dd9-4f38-5c2d-9fae-541de879bc69"] [:db/add "2b814dd9-4f38-5c2d-9fae-541de879bc69" :answer/type :answer.type/math] [:db/add "2b814dd9-4f38-5c2d-9fae-541de879bc69" :answer/value "\\sqrt{7}"] [:db/ensure "2b814dd9-4f38-5c2d-9fae-541de879bc69" :answer/validate] [:db/add "9f08cea1-222d-5521-a1b6-f722bf34659a" :answer-field/id #uuid "9f08cea1-222d-5521-a1b6-f722bf34659a"] [:db/add "9f08cea1-222d-5521-a1b6-f722bf34659a" :answer-field/key "field-1"] [:db/add "9f08cea1-222d-5521-a1b6-f722bf34659a" :answer-field/type :answer-field.type/blank] [:db/add "9f08cea1-222d-5521-a1b6-f722bf34659a" :answer-field/choices "2b814dd9-4f38-5c2d-9fae-541de879bc69"] [:db/add "9f08cea1-222d-5521-a1b6-f722bf34659a" :answer-field/correct "2b814dd9-4f38-5c2d-9fae-541de879bc69"] [:db/ensure "9f08cea1-222d-5521-a1b6-f722bf34659a" :answer-field/validate] [:db/add "9d3eb889-ae32-59ac-9ec2-8ea336cffb37" :answer/id #uuid "9d3eb889-ae32-59ac-9ec2-8ea336cffb37"] [:db/add "9d3eb889-ae32-59ac-9ec2-8ea336cffb37" :answer/type :answer.type/math] [:db/add "9d3eb889-ae32-59ac-9ec2-8ea336cffb37" :answer/value "3"] [:db/ensure "9d3eb889-ae32-59ac-9ec2-8ea336cffb37" :answer/validate] [:db/add "e537d01c-3473-5cbc-af40-700bbf907716" :answer-field/id #uuid "e537d01c-3473-5cbc-af40-700bbf907716"] [:db/add "e537d01c-3473-5cbc-af40-700bbf907716" :answer-field/key "field-2"] [:db/add "e537d01c-3473-5cbc-af40-700bbf907716" :answer-field/type :answer-field.type/blank] [:db/add "e537d01c-3473-5cbc-af40-700bbf907716" :answer-field/choices "9d3eb889-ae32-59ac-9ec2-8ea336cffb37"] [:db/add "e537d01c-3473-5cbc-af40-700bbf907716" :answer-field/correct "9d3eb889-ae32-59ac-9ec2-8ea336cffb37"] [:db/ensure "e537d01c-3473-5cbc-af40-700bbf907716" :answer-field/validate] [:db/add "2cd7955e-c25b-5fc1-81fe-d267d9ec4e11" :answer/id #uuid "2cd7955e-c25b-5fc1-81fe-d267d9ec4e11"] [:db/add "2cd7955e-c25b-5fc1-81fe-d267d9ec4e11" :answer/type :answer.type/math] [:db/add "2cd7955e-c25b-5fc1-81fe-d267d9ec4e11" :answer/value "1"] [:db/ensure "2cd7955e-c25b-5fc1-81fe-d267d9ec4e11" :answer/validate] [:db/add "4410f63b-e4a7-5fe2-8743-46b92bd2436b" :answer-field/id #uuid "4410f63b-e4a7-5fe2-8743-46b92bd2436b"] [:db/add "4410f63b-e4a7-5fe2-8743-46b92bd2436b" :answer-field/key "field-3"] [:db/add "4410f63b-e4a7-5fe2-8743-46b92bd2436b" :answer-field/type :answer-field.type/blank] [:db/add "4410f63b-e4a7-5fe2-8743-46b92bd2436b" :answer-field/choices "2cd7955e-c25b-5fc1-81fe-d267d9ec4e11"] [:db/add "4410f63b-e4a7-5fe2-8743-46b92bd2436b" :answer-field/correct "2cd7955e-c25b-5fc1-81fe-d267d9ec4e11"] [:db/ensure "4410f63b-e4a7-5fe2-8743-46b92bd2436b" :answer-field/validate] [:db/add "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/id #uuid "bc401fc2-0741-5e28-ac23-67f5c0316d34"] [:db/add "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\sqrt{t + 5},\\qquad y=t^{2} + t + 1,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $\\sqrt{3}$ | $2$ | $\\sqrt{5}$ |\n| $y$ | {{field-2}} | $1$ | {{field-3}} |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $\\sqrt{6}$ | {{field-1}} |\n| $y$ | $3$ | $7$ |"] [:db/add "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/worked-solution "The missing entry is in the $x$-row under $t=2$. Substitute into $x=\\sqrt{t + 5}$:\n\n$$\n\\begin{aligned}x(2) &=\\sqrt{\\left(2\\right) + 5} \\\\ &=\\sqrt{7}\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=t^{2} + t + 1$:\n\n$$\n\\begin{aligned}y(-2) &=\\left(-2\\right)^{2} + \\left(-2\\right) + 1 \\\\ &=3\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t^{2} + t + 1$:\n\n$$\n\\begin{aligned}y(0) &=\\left(0\\right)^{2} + \\left(0\\right) + 1 \\\\ &=1\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $\\sqrt{3}$ | $2$ | $\\sqrt{5}$ |\n| $y$ | $3$ | $1$ | $1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $\\sqrt{6}$ | $\\sqrt{7}$ |\n| $y$ | $3$ | $7$ |"] [:db/add "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/difficulty :question.difficulty/moderate] [:db/add "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/answer-fields "9f08cea1-222d-5521-a1b6-f722bf34659a"] [:db/add "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/answer-fields "e537d01c-3473-5cbc-af40-700bbf907716"] [:db/add "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/answer-fields "4410f63b-e4a7-5fe2-8743-46b92bd2436b"] [:db/ensure "bc401fc2-0741-5e28-ac23-67f5c0316d34" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "bc401fc2-0741-5e28-ac23-67f5c0316d34"] [:db/add "be8f22ce-afae-5606-b438-18f3dc59e682" :answer/id #uuid "be8f22ce-afae-5606-b438-18f3dc59e682"] [:db/add "be8f22ce-afae-5606-b438-18f3dc59e682" :answer/type :answer.type/math] [:db/add "be8f22ce-afae-5606-b438-18f3dc59e682" :answer/value "-5"] [:db/ensure "be8f22ce-afae-5606-b438-18f3dc59e682" :answer/validate] [:db/add "5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b" :answer-field/id #uuid "5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b"] [:db/add "5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b" :answer-field/key "field-1"] [:db/add "5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b" :answer-field/type :answer-field.type/blank] [:db/add "5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b" :answer-field/choices "be8f22ce-afae-5606-b438-18f3dc59e682"] [:db/add "5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b" :answer-field/correct "be8f22ce-afae-5606-b438-18f3dc59e682"] [:db/ensure "5aa2d4a5-ddb4-5194-bbf6-8c3545f0e56b" :answer-field/validate] [:db/add "bbb22633-47e1-508a-af16-2a7918763d8c" :answer/id #uuid "bbb22633-47e1-508a-af16-2a7918763d8c"] [:db/add "bbb22633-47e1-508a-af16-2a7918763d8c" :answer/type :answer.type/math] [:db/add "bbb22633-47e1-508a-af16-2a7918763d8c" :answer/value "1"] [:db/ensure "bbb22633-47e1-5