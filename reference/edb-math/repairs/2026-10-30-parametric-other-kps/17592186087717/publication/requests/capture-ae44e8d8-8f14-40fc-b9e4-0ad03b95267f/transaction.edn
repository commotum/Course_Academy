wer-field/correct "fa348710-c1b6-5a01-93a4-e62f3bf60f86"] [:db/ensure "06c0e3ce-fbb6-525f-9217-47f47f17c3e1" :answer-field/validate] [:db/add "9f7fc073-afc7-58e9-86b1-c5e2fec20943" :answer/id #uuid "9f7fc073-afc7-58e9-86b1-c5e2fec20943"] [:db/add "9f7fc073-afc7-58e9-86b1-c5e2fec20943" :answer/type :answer.type/math] [:db/add "9f7fc073-afc7-58e9-86b1-c5e2fec20943" :answer/value "0"] [:db/ensure "9f7fc073-afc7-58e9-86b1-c5e2fec20943" :answer/validate] [:db/add "48b52033-f222-5223-9e70-d97a2e3f828f" :answer-field/id #uuid "48b52033-f222-5223-9e70-d97a2e3f828f"] [:db/add "48b52033-f222-5223-9e70-d97a2e3f828f" :answer-field/key "field-3"] [:db/add "48b52033-f222-5223-9e70-d97a2e3f828f" :answer-field/type :answer-field.type/blank] [:db/add "48b52033-f222-5223-9e70-d97a2e3f828f" :answer-field/choices "9f7fc073-afc7-58e9-86b1-c5e2fec20943"] [:db/add "48b52033-f222-5223-9e70-d97a2e3f828f" :answer-field/correct "9f7fc073-afc7-58e9-86b1-c5e2fec20943"] [:db/ensure "48b52033-f222-5223-9e70-d97a2e3f828f" :answer-field/validate] [:db/add "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/id #uuid "38db0909-2ecc-5349-b5e3-51ee53a611f3"] [:db/add "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/problem "Consider the curve with parametric equations\n\n$$\nx=- 2 t - 2,\\qquad y=- t^{3} + t - 2,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $2$ | {{field-3}} | $-2$ |\n| $y$ | $4$ | $-2$ | {{field-1}} |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $-4$ | $-6$ |\n| $y$ | $-2$ | {{field-2}} |"] [:db/add "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/worked-solution "The missing entry is in the $y$-row under $t=0$. Substitute into $y=- t^{3} + t - 2$:\n\n$$\n\\begin{aligned}y(0) &=- \\left(0\\right)^{3} + \\left(0\\right) - 2 \\\\ &=-2\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t^{3} + t - 2$:\n\n$$\n\\begin{aligned}y(2) &=- \\left(2\\right)^{3} + \\left(2\\right) - 2 \\\\ &=-8\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=- 2 t - 2$:\n\n$$\n\\begin{aligned}x(-1) &=- 2 \\left(-1\\right) - 2 \\\\ &=0\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $2$ | $0$ | $-2$ |\n| $y$ | $4$ | $-2$ | $-2$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $-4$ | $-6$ |\n| $y$ | $-2$ | $-8$ |"] [:db/add "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/difficulty :question.difficulty/moderate] [:db/add "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/answer-fields "587ac7af-6290-53d2-9cec-22cb43571473"] [:db/add "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/answer-fields "06c0e3ce-fbb6-525f-9217-47f47f17c3e1"] [:db/add "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/answer-fields "48b52033-f222-5223-9e70-d97a2e3f828f"] [:db/ensure "38db0909-2ecc-5349-b5e3-51ee53a611f3" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "38db0909-2ecc-5349-b5e3-51ee53a611f3"] [:db/add "41db06be-b9b8-5a8d-8ee9-feb50c48f2f6" :answer/id #uuid "41db06be-b9b8-5a8d-8ee9-feb50c48f2f6"] [:db/add "41db06be-b9b8-5a8d-8ee9-feb50c48f2f6" :answer/type :answer.type/math] [:db/add "41db06be-b9b8-5a8d-8ee9-feb50c48f2f6" :answer/value "\\frac{1}{4}"] [:db/ensure "41db06be-b9b8-5a8d-8ee9-feb50c48f2f6" :answer/validate] [:db/add "7481c2c2-315a-530b-aff1-6d7af617d6d1" :answer-field/id #uuid "7481c2c2-315a-530b-aff1-6d7af617d6d1"] [:db/add "7481c2c2-315a-530b-aff1-6d7af617d6d1" :answer-field/key "field-1"] [:db/add "7481c2c2-315a-530b-aff1-6d7af617d6d1" :answer-field/type :answer-field.type/blank] [:db/add "7481c2c2-315a-530b-aff1-6d7af617d6d1" :answer-field/choices "41db06be-b9b8-5a8d-8ee9-feb50c48f2f6"] [:db/add "7481c2c2-315a-530b-aff1-6d7af617d6d1" :answer-field/correct "41db06be-b9b8-5a8d-8ee9-feb50c48f2f6"] [:db/ensure "7481c2c2-315a-530b-aff1-6d7af617d6d1" :answer-field/validate] [:db/add "62dbfd4e-fb14-5d12-a537-635a8740ea79" :answer/id #uuid "62dbfd4e-fb14-5d12-a537-635a8740ea79"] [:db/add "62dbfd4e-fb14-5d12-a537-635a8740ea79" :answer/type :answer.type/math] [:db/add "62dbfd4e-fb14-5d12-a537-635a8740ea79" :answer/value "-2"] [:db/ensure "62dbfd4e-fb14-5d12-a537-635a8740ea79" :answer/validate] [:db/add "9404ff17-7403-5a13-adf9-9134e85b7ab3" :answer-field/id #uuid "9404ff17-7403-5a13-adf9-9134e85b7ab3"] [:db/add "9404ff17-7403-5a13-adf9-9134e85b7ab3" :answer-field/key "field-2"] [:db/add "9404ff17-7403-5a13-adf9-9134e85b7ab3" :answer-field/type :answer-field.type/blank] [:db/add "9404ff17-7403-5a13-adf9-9134e85b7ab3" :answer-field/choices "62dbfd4e-fb14-5d12-a537-635a8740ea79"] [:db/add "9404ff17-7403-5a13-adf9-9134e85b7ab3" :answer-field/correct "62dbfd4e-fb14-5d12-a537-635a8740ea79"] [:db/ensure "9404ff17-7403-5a13-adf9-9134e85b7ab3" :answer-field/validate] [:db/add "29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748" :answer/id #uuid "29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748"] [:db/add "29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748" :answer/type :answer.type/math] [:db/add "29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748" :answer/value "4"] [:db/ensure "29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748" :answer/validate] [:db/add "e94f0b2f-fd79-58b5-b922-d88b8a4e1627" :answer-field/id #uuid "e94f0b2f-fd79-58b5-b922-d88b8a4e1627"] [:db/add "e94f0b2f-fd79-58b5-b922-d88b8a4e1627" :answer-field/key "field-3"] [:db/add "e94f0b2f-fd79-58b5-b922-d88b8a4e1627" :answer-field/type :answer-field.type/blank] [:db/add "e94f0b2f-fd79-58b5-b922-d88b8a4e1627" :answer-field/choices "29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748"] [:db/add "e94f0b2f-fd79-58b5-b922-d88b8a4e1627" :answer-field/correct "29c08af3-c3d0-5ee9-b4ee-a4f9a6df4748"] [:db/ensure "e94f0b2f-fd79-58b5-b922-d88b8a4e1627" :answer-field/validate] [:db/add "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/id #uuid "7ffd2df9-6212-5ff4-bae5-4c049e9f941a"] [:db/add "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/problem "Consider the curve with parametric equations\n\n$$\nx=t^{2} - t - 2,\\qquad y=\\frac{t + 1}{t + 4},\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | {{field-3}} | $0$ | $-2$ |\n| $y$ | $- \\frac{1}{2}$ | $0$ | {{field-1}} |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | {{field-2}} | $0$ |\n| $y$ | $\\frac{2}{5}$ | $\\frac{1}{2}$ |"] [:db/add "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/worked-solution "The missing entry is in the $y$-row under $t=0$. Substitute into $y=\\frac{t + 1}{t + 4}$:\n\n$$\n\\begin{aligned}y(0) &=\\frac{\\left(0\\right) + 1}{\\left(0\\right) + 4} \\\\ &=\\frac{1}{4}\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=1$. Substitute into $x=t^{2} - t - 2$:\n\n$$\n\\begin{aligned}x(1) &=\\left(1\\right)^{2} - \\left(1\\right) - 2 \\\\ &=-2\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=t^{2} - t - 2$:\n\n$$\n\\begin{aligned}x(-2) &=\\left(-2\\right)^{2} - \\left(-2\\right) - 2 \\\\ &=4\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $4$ | $0$ | $-2$ |\n| $y$ | $- \\frac{1}{2}$ | $0$ | $\\frac{1}{4}$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $-2$ | $0$ |\n| $y$ | $\\frac{2}{5}$ | $\\frac{1}{2}$ |"] [:db/add "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/difficulty :question.difficulty/moderate] [:db/add "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/answer-fields "7481c2c2-315a-530b-aff1-6d7af617d6d1"] [:db/add "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/answer-fields "9404ff17-7403-5a13-adf9-9134e85b7ab3"] [:db/add "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/answer-fields "e94f0b2f-fd79-58b5-b922-d88b8a4e1627"] [:db/ensure "7ffd2df9-6212-5ff4-bae5-4c049e9f941a" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "7ffd2df9-6212-5ff4-bae5-4c049e9f941a"] [:db/add "780bd7db-4212-5fe1-8a27-e116c11d14cf" :answer/id #uuid "780bd7db-4212-5fe1-8a27-e116c11d14cf"] [:db/add "780bd7db-4212-5fe1-8a27-e116c11d14cf" :answer/type :answer.type/math] [:db/add "780bd7db-4212-5fe1-8a27-e116c11d14cf" :answer/value "- \\sqrt{3} - \\frac{\\sqrt{2}}{2} + 1"] [:db/ensure "780bd7db-4212-5fe1-8a27-e116c11d14cf" :answer/validate] [:db/add "518825eb-e534-5e92-90ce-890437b8f837" :answer-field/id #uuid "518825eb-e534-5e92-90ce-890437b8f837"] [:db/add "518825eb-e534-5e92-90ce-890437b8f837" :answer-field/key "result"] [:db/add "518825eb-e534-5e92-90ce-890437b8f837" :answer-field/type :answer-field.type/blank] [:db/add "518825eb-e534-5e92-90ce-890437b8f837" :answer-field/choices "780bd7db-4212-5fe1-8a27-e116c11d14cf"] [:db/add "518825eb-e534-5e92-90ce-890437b8f837" :answer-field/correct "780bd7db-4212-5fe1-8a27-e116c11d14cf"] [:db/ensure "518825eb-e534-5e92-90ce-890437b8f837" :answer-field/validate] [:db/add "e5caf562-27b3-5cd5-86ff-a3aac67391d6" :question/id #uuid "e5caf562-27b3-5cd5-86ff-a3aac67391d6"] [:db/add "e5caf562-27b3-5cd5-86ff-a3aac67391d6" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\cos\\left(\\frac{\\pi t}{4}\\right),\\qquad y=\\tan\\left(\\frac{\\pi t}{3}\\right).\n$$\n\nConsider the following table of values. Angles are in radians.\n\n| **$t$** | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- |\n| $x$ | $\\frac{\\sqrt{2}}{2}$ | $a$ | $\\frac{\\sqrt{2}}{2}$ |\n| $y$ | $b$ | $0$ | $\\sqrt{3}$ |\n\n| **$t$** | $3$ | $4$ |\n| --- | --- | --- |\n| $x$ | $c$ | $-1$ |\n| $y$ | $0$ | $\\sqrt{3}$ |\n\nFind the exact value of $a+b+c$.\n\n{{result}}"] [:db/add "e5caf562-27b3-5cd5-86ff-a3aac67391d6" :question/worked-solution "The $a$ entry is in the $x$-row under $t=0$. Substitute into $x=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}a &=\\cos\\left(\\frac{\\pi \\left(0\\right)}{4}\\right) \\\\ &=\\cos\\left(0\\right) \\\\ &=1\\end{aligned}\n$$\n\nThe $b$ entry is in the $y$-row under $t=-1$. Substitute into $y=\\tan\\left(\\frac{\\pi t}{3}\\right)$:\n\n$$\n\\begin{aligned}b &=\\tan\\left(\\frac{\\pi \\left(-1\\right)}{3}\\right) \\\\ &=\\tan\\left(- \\frac{\\pi}{3}\\right) \\\\ &=- \\sqrt{3}\\end{aligned}\n$$\n\nThe $c$ entry is in the $x$-row under $t=3$. Substitute into $x=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}c &=\\cos\\left(\\frac{\\pi \\left(3\\right)}{4}\\right) \\\\ &=\\cos\\left(\\frac{3 \\pi}{4}\\right) \\\\ &=- \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSubstitute the three entries with the signs in the requested expression:\n\n$$\n\\begin{gathered}a+b+c \\\\ =\\left(1\\right)+\\left(- \\sqrt{3}\\right)+\\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ =- \\sqrt{3} - \\frac{\\sqrt{2}}{2} + 1\\end{gathered}\n$$\n\nThe completed table is\n\n| **$t$** | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- |\n| $x$ | $\\frac{\\sqrt{2}}{2}$ | $1$ | $\\frac{\\sqrt{2}}{2}$ |\n| $y$ | $- \\sqrt{3}$ | $0$ | $\\sqrt{3}$ |\n\n| **$t$** | $3$ | $4$ |\n| --- | --- | --- |\n| $x$ | $- \\frac{\\sqrt{2}}{2}$ | $-1$ |\n| $y$ | $0$ | $\\sqrt{3}$ |"] [:db/add "e5caf562-27b3-5cd5-86ff-a3aac67391d6" :question/difficulty :question.difficulty/hard] [:db/add "e5caf562-27b3-5cd5-86ff-a3aac67391d6" :question/answer-fields "518825eb-e534-5e92-90ce-890437b8f837"] [:db/ensure "e5caf562-27b3-5cd5-86ff-a3aac67391d6" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "e5caf562-27b3-5cd5-86ff-a3aac67391d6"] [:db/add "402dede8-3999-5fcd-943b-1b05961ef173" :answer/id #uuid "402dede8-3999-5fcd-943b-1b05961ef173"] [:db/add "402dede8-3999-5fcd-943b-1b05961ef173" :answer/type :answer.type/math] [:db/add "402dede8-3999-5fcd-943b-1b05961ef173" :answer/value "\\frac{\\sqrt{2}}{2}"] [:db/ensure "402dede8-3999-5fcd-943b-1b05961ef173" :answer/validate] [:db/add "b52a37f4-bafd-55a7-b936-9a3922b1f362" :answer-field/id #uuid "b52a37f4-bafd-55a7-b936-9a3922b1f362"] [:db/add "b52a37f4-bafd-55a7-b936-9a3922b1f362" :answer-field/key "result"] [:db/add "b52a37f4-bafd-55a7-b936-9a3922b1f362" :answer-field/type :answer-field.type/blank] [:db/add "b52a37f4-bafd-55a7-b936-9a3922b1f362" :answer-field/choices "402dede8-3999-5fcd-943b-1b05961ef173"] [:db/add "b52a37f4-bafd-55a7-b936-9a3922b1f362" :answer-field/correct "402dede8-3999-5fcd-943b-1b05961ef173"] [:db/ensure "b52a37f4-bafd-55a7-b936-9a3922b1f362" :answer-field/validate] [:db/add "0d6985ec-3500-52de-993a-80591e452c25" :question/id #uuid "0d6985ec-3500-52de-993a-80591e452c25"] [:db/add "0d6985ec-3500-52de-993a-80591e452c25" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\sin\\left(\\frac{\\pi t}{6}\\right),\\qquad y=\\cos\\left(\\frac{\\pi t}{4}\\right).\n$$\n\nConsider the following table of values. Angles are in radians.\n\n| **$t$** | $-4$ | $-3$ | $-2$ |\n| --- | --- | --- | --- |\n| $x$ | $a$ | $-1$ | $b$ |\n| $y$ | $-1$ | $- \\frac{\\sqrt{2}}{2}$ | $0$ |\n\n| **$t$** | $0$ | $1$ |\n| --- | --- | --- |\n| $x$ | $0$ | $\\frac{1}{2}$ |\n| $y$ | $1$ | $c$ |\n\nFind the exact value of $a-b+c$.\n\n{{result}}"] [:db/add "0d6985ec-3500-52de-993a-80591e452c25" :question/worked-solution "The $a$ entry is in the $x$-row under $t=-4$. Substitute into $x=\\sin\\left(\\frac{\\pi t}{6}\\right)$:\n\n$$\n\\begin{aligned}a &=\\sin\\left(\\frac{\\pi \\left(-4\\right)}{6}\\right) \\\\ &=\\sin\\left(- \\frac{2 \\pi}{3}\\right) \\\\ &=- \\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nThe $b$ entry is in the $x$-row under $t=-2$. Substitute into $x=\\sin\\left(\\frac{\\pi t}{6}\\right)$:\n\n$$\n\\begin{aligned}b &=\\sin\\left(\\frac{\\pi \\left(-2\\right)}{6}\\right) \\\\ &=\\sin\\left(- \\frac{\\pi}{3}\\right) \\\\ &=- \\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nThe $c$ entry is in the $y$-row under $t=1$. Substitute into $y=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}c &=\\cos\\left(\\frac{\\pi \\left(1\\right)}{4}\\right) \\\\ &=\\cos\\left(\\frac{\\pi}{4}\\right) \\\\ &=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSubstitute the three entries with the signs in the requested expression:\n\n$$\n\\begin{gathered}a-b+c \\\\ =\\left(- \\frac{\\sqrt{3}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)+\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\ =\\frac{\\sqrt{2}}{2}\\end{gathered}\n$$\n\nThe completed table is\n\n| **$t$** | $-4$ | $-3$ | $-2$ |\n| --- | --- | --- | --- |\n| $x$ | $- \\frac{\\sqrt{3}}{2}$ | $-1$ | $- \\frac{\\sqrt{3}}{2}$ |\n| $y$ | $-1$ | $- \\frac{\\sqrt{2}}{2}$ | $0$ |\n\n| **$t$** | $0$ | $1$ |\n| --- | --- | --- |\n| $x$ | $0$ | $\\frac{1}{2}$ |\n| $y$ | $1$ | $\\frac{\\sqrt{2}}{2}$ |"] [:db/add "0d6985ec-3500-52de-993a-80591e452c25" :question/difficulty :question.difficulty/hard] [:db/add "0d6985ec-3500-52de-993a-80591e452c25" :question/answer-fields "b52a37f4-bafd-55a7-b936-9a3922b1f362"] [:db/ensure "0d6985ec-3500-52de-993a-80591e452c25" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "0d6985ec-3500-52de-993a-80591e452c25"] [:db/add "6ba07cc5-77ee-5689-b056-4d702d8a902b" :answer/id #uuid "6ba07cc5-77ee-5689-b056-4d702d8a902b"] [:db/add "6ba07cc5-77ee-5689-b056-4d702d8a902b" :answer/type :answer.type/math] [:db/add "6ba07cc5-77ee-5689-b056-4d702d8a902b" :answer/value "- 2 \\sqrt{3} + \\frac{\\sqrt{2}}{2}"] [:db/ensure "6ba07cc5-77ee-5689-b056-4d702d8a902b" :answer/validate] [:db/add "510cc6fd-ef1b-5e32-9e56-a75c8a60d652" :answer-field/id #uuid "510cc6fd-ef1b-5e32-9e56-a75c8a60d652"] [:db/add "510cc6fd-ef1b-5e32-9e56-a75c8a60d652" :answer-field/key "result"] [:db/add "510cc6fd-ef1b-5e32-9e56-a75c8a60d652" :answer-field/type :answer-field.type/blank] [:db/add "510cc6fd-ef1b-5e32-9e56-a75c8a60d652" :answer-field/choices "6ba07cc5-77ee-5689-b056-4d702d8a902b"] [:db/add "510cc6fd-ef1b-5e32-9e56-a75c8a60d652" :answer-field/correct "6ba07cc5-77ee-5689-b056-4d702d8a902b"] [:db/ensure "510cc6fd-ef1b-5e32-9e56-a75c8a60d652" :answer-field/validate] [:db/add "a5aff6c4-59a0-5be6-97f1-a12599feaff8" :question/id #uuid "a5aff6c4-59a0-5be6-97f1-a12599feaff8"] [:db/add "a5aff6c4-59a0-5be6-97f1-a12599feaff8" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\cos\\left(\\frac{\\pi t}{4}\\right),\\qquad y=\\tan\\left(\\frac{\\pi t}{3}\\right).\n$$\n\nConsider the following table of values. Angles are in radians.\n\n| **$t$** | $-4$ | $-3$ | $-2$ |\n| --- | --- | --- | --- |\n| $x$ | $-1$ | $a$ | $0$ |\n| $y$ | $c$ | $0$ | $\\sqrt{3}$ |\n\n| **$t$** | $2$ | $4$ |\n| --- | --- | --- |\n| $x$ | $0$ | $-1$ |\n| $y$ | $b$ | $\\sqrt{3}$ |\n\nFind the exact value of $-a+b+c$.\n\n{{result}}"] [:db/add "a5aff6c4-59a0-5be6-97f1-a12599feaff8" :question/worked-solution "The $a$ entry is in the $x$-row under $t=-3$. Substitute into $x=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}a &=\\cos\\left(\\frac{\\pi \\left(-3\\right)}{4}\\right) \\\\ &=\\cos\\left(- \\frac{3 \\pi}{4}\\right) \\\\ &=- \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nThe $b$ entry is in the $y$-row under $t=2$. Substitute into $y=\\tan\\left(\\frac{\\pi t}{3}\\right)$:\n\n$$\n\\begin{aligned}b &=\\tan\\left(\\frac{\\pi \\left(2\\right)}{3}\\right) \\\\ &=\\tan\\left(\\frac{2 \\pi}{3}\\right) \\\\ &=- \\sqrt{3}\\end{aligned}\n$$\n\nThe $c$ entry is in the $y$-row under $t=-4$. Substitute into $y=\\tan\\left(\\frac{\\pi t}{3}\\right)$:\n\n$$\n\\begin{aligned}c &=\\tan\\left(\\frac{\\pi \\left(-4\\right)}{3}\\right) \\\\ &=\\tan\\left(- \\frac{4 \\pi}{3}\\right) \\\\ &=- \\sqrt{3}\\end{aligned}\n$$\n\nSubstitute the three entries with the signs in the requested expression:\n\n$$\n\\begin{gathered}-a+b+c \\\\ =-\\left(- \\frac{\\sqrt{2}}{2}\\right)+\\left(- \\sqrt{3}\\right)+\\left(- \\sqrt{3}\\right) \\\\ =- 2 \\sqrt{3} + \\frac{\\sqrt{2}}{2}\\end{gathered}\n$$\n\nThe completed table is\n\n| **$t$** | $-4$ | $-3$ | $-2$ |\n| --- | --- | --- | --- |\n| $x$ | $-1$ | $- \\frac{\\sqrt{2}}{2}$ | $0$ |\n| $y$ | $- \\sqrt{3}$ | $0$ | $\\sqrt{3}$ |\n\n| **$t$** | $2$ | $4$ |\n| --- | --- | --- |\n| $x$ | $0$ | $-1$ |\n| $y$ | $- \\sqrt{3}$ | $\\sqrt{3}$ |"] [:db/add "a5aff6c4-59a0-5be6-97f1-a12599feaff8" :question/difficulty :question.difficulty/hard] [:db/add "a5aff6c4-59a0-5be6-97f1-a12599feaff8" :question/answer-fields "510cc6fd-ef1b-5e32-9e56-a75c8a60d652"] [:db/ensure "a5aff6c4-59a0-5be6-97f1-a12599feaff8" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "a5aff6c4-59a0-5be6-97f1-a12599feaff8"] [:db/add "93b636d5-9174-5553-b5f0-d1b76f5a8501" :answer/id #uuid "93b636d5-9174-5553-b5f0-d1b76f5a8501"] [:db/add "93b636d5-9174-5553-b5f0-d1b76f5a8501" :answer/type :answer.type/math] [:db/add "93b636d5-9174-5553-b5f0-d1b76f5a8501" :answer/value "\\sqrt{2}"] [:db/ensure "93b636d5-9174-5553-b5f0-d1b76f5a8501" :answer/validate] [:db/add "6c74dd7e-7831-5ab2-bc56-8b230011dc4f" :answer-field/id #uuid "6c74dd7e-7831-5ab2-bc56-8b230011dc4f"] [:db/add "6c74dd7e-7831-5ab2-bc56-8b230011dc4f" :answer-field/key "result"] [:db/add "6c74dd7e-7831-5ab2-bc56-8b230011dc4f" :answer-field/type :answer-field.type/blank] [:db/add "6c74dd7e-7831-5ab2-bc56-8b230011dc4f" :answer-field/choices "93b636d5-9174-5553-b5f0-d1b76f5a8501"] [:db/add "6c74dd7e-7831-5ab2-bc56-8b230011dc4f" :answer-field/correct "93b636d5-9174-5553-b5f0-d1b76f5a8501"] [:db/ensure "6c74dd7e-7831-5ab2-bc56-8b230011dc4f" :answer-field/validate] [:db/add "dfe7f575-109f-57a8-8469-d7a292b67702" :question/id #uuid "dfe7f575-109f-57a8-8469-d7a292b67702"] [:db/add "dfe7f575-109f-57a8-8469-d7a292b67702" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\sin\\left(\\frac{\\pi t}{6}\\right),\\qquad y=\\cos\\left(\\frac{\\pi t}{4}\\right).\n$$\n\nConsider the following table of values. Angles are in radians.\n\n| **$t$** | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- |\n| $x$ | $- \\frac{1}{2}$ | $a$ | $\\frac{1}{2}$ |\n| $y$ | $b$ | $1$ | $c$ |\n\n| **$t$** | $3$ | $4$ |\n| --- | --- | --- |\n| $x$ | $1$ | $\\frac{\\sqrt{3}}{2}$ |\n| $y$ | $- \\frac{\\sqrt{2}}{2}$ | $-1$ |\n\nFind the exact value of $a+b+c$.\n\n{{result}}"] [:db/add "dfe7f575-109f-57a8-8469-d7a292b67702" :question/worked-solution "The $a$ entry is in the $x$-row under $t=0$. Substitute into $x=\\sin\\left(\\frac{\\pi t}{6}\\right)$:\n\n$$\n\\begin{aligned}a &=\\sin\\left(\\frac{\\pi \\left(0\\right)}{6}\\right) \\\\ &=\\sin\\left(0\\right) \\\\ &=0\\end{aligned}\n$$\n\nThe $b$ entry is in the $y$-row under $t=-1$. Substitute into $y=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}b &=\\cos\\left(\\frac{\\pi \\left(-1\\right)}{4}\\right) \\\\ &=\\cos\\left(- \\frac{\\pi}{4}\\right) \\\\ &=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nThe $c$ entry is in the $y$-row under $t=1$. Substitute into $y=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}c &=\\cos\\left(\\frac{\\pi \\left(1\\right)}{4}\\right) \\\\ &=\\cos\\left(\\frac{\\pi}{4}\\right) \\\\ &=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSubstitute the three entries with the signs in the requested expression:\n\n$$\n\\begin{gathered}a+b+c \\\\ =\\left(0\\right)+\\left(\\frac{\\sqrt{2}}{2}\\right)+\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\ =\\sqrt{2}\\end{gathered}\n$$\n\nThe completed table is\n\n| **$t$** | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- |\n| $x$ | $- \\frac{1}{2}$ | $0$ | $\\frac{1}{2}$ |\n| $y$ | $\\frac{\\sqrt{2}}{2}$ | $1$ | $\\frac{\\sqrt{2}}{2}$ |\n\n| **$t$** | $3$ | $4$ |\n| --- | --- | --- |\n| $x$ | $1$ | $\\frac{\\sqrt{3}}{2}$ |\n| $y$ | $- \\frac{\\sqrt{2}}{2}$ | $-1$ |"] [:db/add "dfe7f575-109f-57a8-8469-d7a292b67702" :question/difficulty :question.difficulty/hard] [:db/add "dfe7f575-109f-57a8-8469-d7a292b67702" :question/answer-fields "6c74dd7e-7831-5ab2-bc56-8b230011dc4f"] [:db/ensure "dfe7f575-109f-57a8-8469-d7a292b67702" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "dfe7f575-109f-57a8-8469-d7a292b67702"] [:db/add "698216b5-6523-5bab-9afb-551bb8856438" :answer/id #uuid "698216b5-6523-5bab-9afb-551bb8856438"] [:db/add "698216b5-6523-5bab-9afb-551bb8856438" :answer/type :answer.type/math] [:db/add "698216b5-6523-5bab-9afb-551bb8856438" :answer/value "- \\sqrt{3} + \\frac{\\sqrt{2}}{2} + 1"] [:db/ensure "698216b5-6523-5bab-9afb-551bb8856438" :answer/validate] [:db/add "913dad68-ed72-58c7-b849-508e17f78f3c" :answer-field/id #uuid "913dad68-ed72-58c7-b849-508e17f78f3c"] [:db/add "913dad68-ed72-58c7-b849-508e17f78f3c" :answer-field/key "result"] [:db/add "913dad68-ed72-58c7-b849-508e17f78f3c" :answer-field/type :answer-field.type/blank] [:db/add "913dad68-ed72-58c7-b849-508e17f78f3c" :answer-field/choices "698216b5-6523-5bab-9afb-551bb8856438"] [:db/add "913dad68-ed72-58c7-b849-508e17f78f3c" :answer-field/correct "698216b5-6523-5bab-9afb-551bb8856438"] [:db/ensure "913dad68-ed72-58c7-b849-508e17f78f3c" :answer-field/validate] [:db/add "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764" :question/id #uuid "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764"] [:db/add "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\tan\\left(\\frac{\\pi t}{3}\\right),\\qquad y=\\cos\\left(\\frac{\\pi t}{4}\\right).\n$$\n\nConsider the following table of values. Angles are in radians.\n\n| **$t$** | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $x$ | $0$ | $\\sqrt{3}$ | $b$ |\n| $y$ | $1$ | $\\frac{\\sqrt{2}}{2}$ | $0$ |\n\n| **$t$** | $3$ | $4$ |\n| --- | --- | --- |\n| $x$ | $0$ | $\\sqrt{3}$ |\n| $y$ | $c$ | $a$ |\n\nFind the exact value of $-a+b-c$.\n\n{{result}}"] [:db/add "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764" :question/worked-solution "The $a$ entry is in the $y$-row under $t=4$. Substitute into $y=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}a &=\\cos\\left(\\frac{\\pi \\left(4\\right)}{4}\\right) \\\\ &=\\cos\\left(\\pi\\right) \\\\ &=-1\\end{aligned}\n$$\n\nThe $b$ entry is in the $x$-row under $t=2$. Substitute into $x=\\tan\\left(\\frac{\\pi t}{3}\\right)$:\n\n$$\n\\begin{aligned}b &=\\tan\\left(\\frac{\\pi \\left(2\\right)}{3}\\right) \\\\ &=\\tan\\left(\\frac{2 \\pi}{3}\\right) \\\\ &=- \\sqrt{3}\\end{aligned}\n$$\n\nThe $c$ entry is in the $y$-row under $t=3$. Substitute into $y=\\cos\\left(\\frac{\\pi t}{4}\\right)$:\n\n$$\n\\begin{aligned}c &=\\cos\\left(\\frac{\\pi \\left(3\\right)}{4}\\right) \\\\ &=\\cos\\left(\\frac{3 \\pi}{4}\\right) \\\\ &=- \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSubstitute the three entries with the signs in the requested expression:\n\n$$\n\\begin{gathered}-a+b-c \\\\ =-\\left(-1\\right)+\\left(- \\sqrt{3}\\right)-\\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ =- \\sqrt{3} + \\frac{\\sqrt{2}}{2} + 1\\end{gathered}\n$$\n\nThe completed table is\n\n| **$t$** | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $x$ | $0$ | $\\sqrt{3}$ | $- \\sqrt{3}$ |\n| $y$ | $1$ | $\\frac{\\sqrt{2}}{2}$ | $0$ |\n\n| **$t$** | $3$ | $4$ |\n| --- | --- | --- |\n| $x$ | $0$ | $\\sqrt{3}$ |\n| $y$ | $- \\frac{\\sqrt{2}}{2}$ | $-1$ |"] [:db/add "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764" :question/difficulty :question.difficulty/hard] [:db/add "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764" :question/answer-fields "913dad68-ed72-58c7-b849-508e17f78f3c"] [:db/ensure "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "6b1e8ea8-15aa-5d3b-9214-bdd6c5764764"] [:db/add "generator" :question-generator/id #uuid "664ecab0-2bbb-5e3a-a04b-78471ee297e1"] [:db/add "generator" :question-generator/script "generators/4c/4c9fe9749cdac4cfc8fd9d4b82afb05541e87580c19d1e80c9d1e81ae916d9de/generator.py"] [:db/add 17592186087717 :knowledge-point/question-generator "generator"] [:db/ensure 17592186087717 :knowledge-point/validate] [:db/cas 17592186557627 :question/retired nil true] [:db/cas 17592186557631 :question/retired nil true] [:db/cas 17592186557649 :question/retired nil true] [:db/cas 17592186557664 :question/retired nil true] [:db/cas 17592186557666 :question/retired nil true] [:db/cas 17592186557670 :question/retired nil true] [:db/cas 17592186557674 :question/retired nil true] [:db/cas 17592186557680 :question/retired nil true] [:db/cas 17592186557694 :question/retired nil true] [:db/cas 17592186697642 :questio