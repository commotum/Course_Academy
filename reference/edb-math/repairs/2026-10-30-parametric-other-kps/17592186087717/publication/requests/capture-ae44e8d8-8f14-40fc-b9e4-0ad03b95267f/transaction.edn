9-6df6-5cab-bb7e-a5b97e5b4ae0" :answer-field/choices "6b62cf95-aa03-5efa-b46d-4a18e0c65146"] [:db/add "9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0" :answer-field/correct "6b62cf95-aa03-5efa-b46d-4a18e0c65146"] [:db/ensure "9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0" :answer-field/validate] [:db/add "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/id #uuid "edb55b8b-7b58-5dc2-81a0-8a36280b22b0"] [:db/add "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/problem "Consider the curve with parametric equations\n\n$$\nx=2 - t^{2},\\qquad y=2 t - 1,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(0)=2 - \\left(0\\right)^{2}=2$.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | {{field-2}} | {{field-3}} | $2$ |\n| $y$ | $-5$ | $-3$ | $-1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $1$ | $-2$ |\n| $y$ | $1$ | {{field-1}} |"] [:db/add "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/worked-solution "The missing entry is in the $y$-row under $t=2$. Substitute into $y=2 t - 1$:\n\n$$\n\\begin{aligned}y(2) &=2 \\left(2\\right) - 1 \\\\ &=3\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=2 - t^{2}$:\n\n$$\n\\begin{aligned}x(-2) &=2 - \\left(-2\\right)^{2} \\\\ &=-2\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-1$. Substitute into $x=2 - t^{2}$:\n\n$$\n\\begin{aligned}x(-1) &=2 - \\left(-1\\right)^{2} \\\\ &=1\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $-2$ | $1$ | $2$ |\n| $y$ | $-5$ | $-3$ | $-1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $1$ | $-2$ |\n| $y$ | $1$ | $3$ |"] [:db/add "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/difficulty :question.difficulty/easy] [:db/add "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/answer-fields "0d807bd0-4401-50f7-b76c-5b3f96b67bb8"] [:db/add "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/answer-fields "e325fcc5-acb5-5ce1-872e-9b3aa8b65159"] [:db/add "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/answer-fields "9f032b59-6df6-5cab-bb7e-a5b97e5b4ae0"] [:db/ensure "edb55b8b-7b58-5dc2-81a0-8a36280b22b0" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "edb55b8b-7b58-5dc2-81a0-8a36280b22b0"] [:db/add "b819a116-e504-5659-bd6b-09de617bbb38" :answer/id #uuid "b819a116-e504-5659-bd6b-09de617bbb38"] [:db/add "b819a116-e504-5659-bd6b-09de617bbb38" :answer/type :answer.type/math] [:db/add "b819a116-e504-5659-bd6b-09de617bbb38" :answer/value "-2"] [:db/ensure "b819a116-e504-5659-bd6b-09de617bbb38" :answer/validate] [:db/add "7f551e3a-65cb-54f0-9930-03078b3b3a33" :answer-field/id #uuid "7f551e3a-65cb-54f0-9930-03078b3b3a33"] [:db/add "7f551e3a-65cb-54f0-9930-03078b3b3a33" :answer-field/key "field-1"] [:db/add "7f551e3a-65cb-54f0-9930-03078b3b3a33" :answer-field/type :answer-field.type/blank] [:db/add "7f551e3a-65cb-54f0-9930-03078b3b3a33" :answer-field/choices "b819a116-e504-5659-bd6b-09de617bbb38"] [:db/add "7f551e3a-65cb-54f0-9930-03078b3b3a33" :answer-field/correct "b819a116-e504-5659-bd6b-09de617bbb38"] [:db/ensure "7f551e3a-65cb-54f0-9930-03078b3b3a33" :answer-field/validate] [:db/add "b09f99c5-b0ea-517e-9f73-1efa4902f749" :answer/id #uuid "b09f99c5-b0ea-517e-9f73-1efa4902f749"] [:db/add "b09f99c5-b0ea-517e-9f73-1efa4902f749" :answer/type :answer.type/math] [:db/add "b09f99c5-b0ea-517e-9f73-1efa4902f749" :answer/value "-3"] [:db/ensure "b09f99c5-b0ea-517e-9f73-1efa4902f749" :answer/validate] [:db/add "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab" :answer-field/id #uuid "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab"] [:db/add "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab" :answer-field/key "field-2"] [:db/add "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab" :answer-field/type :answer-field.type/blank] [:db/add "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab" :answer-field/choices "b09f99c5-b0ea-517e-9f73-1efa4902f749"] [:db/add "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab" :answer-field/correct "b09f99c5-b0ea-517e-9f73-1efa4902f749"] [:db/ensure "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab" :answer-field/validate] [:db/add "b194ab8c-7e43-562b-8587-018c40daf5aa" :answer/id #uuid "b194ab8c-7e43-562b-8587-018c40daf5aa"] [:db/add "b194ab8c-7e43-562b-8587-018c40daf5aa" :answer/type :answer.type/math] [:db/add "b194ab8c-7e43-562b-8587-018c40daf5aa" :answer/value "-5"] [:db/ensure "b194ab8c-7e43-562b-8587-018c40daf5aa" :answer/validate] [:db/add "64ba65b8-e4f8-5e86-9594-a9aed605d124" :answer-field/id #uuid "64ba65b8-e4f8-5e86-9594-a9aed605d124"] [:db/add "64ba65b8-e4f8-5e86-9594-a9aed605d124" :answer-field/key "field-3"] [:db/add "64ba65b8-e4f8-5e86-9594-a9aed605d124" :answer-field/type :answer-field.type/blank] [:db/add "64ba65b8-e4f8-5e86-9594-a9aed605d124" :answer-field/choices "b194ab8c-7e43-562b-8587-018c40daf5aa"] [:db/add "64ba65b8-e4f8-5e86-9594-a9aed605d124" :answer-field/correct "b194ab8c-7e43-562b-8587-018c40daf5aa"] [:db/ensure "64ba65b8-e4f8-5e86-9594-a9aed605d124" :answer-field/validate] [:db/add "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/id #uuid "27567bdc-9f35-5be9-8b03-2accae833e9c"] [:db/add "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/problem "Consider the curve with parametric equations\n\n$$\nx=- t^{2} - 1,\\qquad y=- t - 1,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(0)=- \\left(0\\right)^{2} - 1=-1$.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | {{field-3}} | {{field-1}} | $-1$ |\n| $y$ | $1$ | $0$ | $-1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $-2$ | $-5$ |\n| $y$ | $-2$ | {{field-2}} |"] [:db/add "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/worked-solution "The missing entry is in the $x$-row under $t=-1$. Substitute into $x=- t^{2} - 1$:\n\n$$\n\\begin{aligned}x(-1) &=- \\left(-1\\right)^{2} - 1 \\\\ &=-2\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=2$. Substitute into $y=- t - 1$:\n\n$$\n\\begin{aligned}y(2) &=- \\left(2\\right) - 1 \\\\ &=-3\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=-2$. Substitute into $x=- t^{2} - 1$:\n\n$$\n\\begin{aligned}x(-2) &=- \\left(-2\\right)^{2} - 1 \\\\ &=-5\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $-5$ | $-2$ | $-1$ |\n| $y$ | $1$ | $0$ | $-1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $-2$ | $-5$ |\n| $y$ | $-2$ | $-3$ |"] [:db/add "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/difficulty :question.difficulty/easy] [:db/add "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/answer-fields "7f551e3a-65cb-54f0-9930-03078b3b3a33"] [:db/add "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/answer-fields "e9f7cd2b-a90e-5100-8e1c-8a8aa03bebab"] [:db/add "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/answer-fields "64ba65b8-e4f8-5e86-9594-a9aed605d124"] [:db/ensure "27567bdc-9f35-5be9-8b03-2accae833e9c" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "27567bdc-9f35-5be9-8b03-2accae833e9c"] [:db/add "5f1be70c-83dd-54f9-bb42-98edc42c6afe" :answer/id #uuid "5f1be70c-83dd-54f9-bb42-98edc42c6afe"] [:db/add "5f1be70c-83dd-54f9-bb42-98edc42c6afe" :answer/type :answer.type/math] [:db/add "5f1be70c-83dd-54f9-bb42-98edc42c6afe" :answer/value "0"] [:db/ensure "5f1be70c-83dd-54f9-bb42-98edc42c6afe" :answer/validate] [:db/add "a13f25ae-650e-520c-a28a-2f653c201bcd" :answer-field/id #uuid "a13f25ae-650e-520c-a28a-2f653c201bcd"] [:db/add "a13f25ae-650e-520c-a28a-2f653c201bcd" :answer-field/key "field-1"] [:db/add "a13f25ae-650e-520c-a28a-2f653c201bcd" :answer-field/type :answer-field.type/blank] [:db/add "a13f25ae-650e-520c-a28a-2f653c201bcd" :answer-field/choices "5f1be70c-83dd-54f9-bb42-98edc42c6afe"] [:db/add "a13f25ae-650e-520c-a28a-2f653c201bcd" :answer-field/correct "5f1b