009-5755-9b57-c560114d7eda" :answer/value "1"] [:db/ensure "387fc7bd-f009-5755-9b57-c560114d7eda" :answer/validate] [:db/add "c7a26bde-522f-51ad-b6be-4e4cf1093416" :answer-field/id #uuid "c7a26bde-522f-51ad-b6be-4e4cf1093416"] [:db/add "c7a26bde-522f-51ad-b6be-4e4cf1093416" :answer-field/key "field-3"] [:db/add "c7a26bde-522f-51ad-b6be-4e4cf1093416" :answer-field/type :answer-field.type/blank] [:db/add "c7a26bde-522f-51ad-b6be-4e4cf1093416" :answer-field/choices "387fc7bd-f009-5755-9b57-c560114d7eda"] [:db/add "c7a26bde-522f-51ad-b6be-4e4cf1093416" :answer-field/correct "387fc7bd-f009-5755-9b57-c560114d7eda"] [:db/ensure "c7a26bde-522f-51ad-b6be-4e4cf1093416" :answer-field/validate] [:db/add "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/id #uuid "ddd79350-3c36-5a68-8e1f-be7ece233413"] [:db/add "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/problem "Consider the curve with parametric equations\n\n$$\nx=3 t,\\qquad y=t^{2} + 1,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=3 \\left(-2\\right)=-6$.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $-6$ | $-3$ | $0$ |\n| $y$ | {{field-2}} | $2$ | {{field-3}} |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $3$ | {{field-1}} |\n| $y$ | $2$ | $5$ |"] [:db/add "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/worked-solution "The missing entry is in the $x$-row under $t=2$. Substitute into $x=3 t$:\n\n$$\n\\begin{aligned}x(2) &=3 \\left(2\\right) \\\\ &=6\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=-2$. Substitute into $y=t^{2} + 1$:\n\n$$\n\\begin{aligned}y(-2) &=\\left(-2\\right)^{2} + 1 \\\\ &=5\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=0$. Substitute into $y=t^{2} + 1$:\n\n$$\n\\begin{aligned}y(0) &=\\left(0\\right)^{2} + 1 \\\\ &=1\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $-6$ | $-3$ | $0$ |\n| $y$ | $5$ | $2$ | $1$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $3$ | $6$ |\n| $y$ | $2$ | $5$ |"] [:db/add "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/difficulty :question.difficulty/easy] [:db/add "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/answer-fields "04c90db2-1857-5950-a1c1-ef2dd432e5ee"] [:db/add "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/answer-fields "74ef9f89-147e-5d53-85b1-f785b0ca607c"] [:db/add "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/answer-fields "c7a26bde-522f-51ad-b6be-4e4cf1093416"] [:db/ensure "ddd79350-3c36-5a68-8e1f-be7ece233413" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "ddd79350-3c36-5a68-8e1f-be7ece233413"] [:db/add "20b2318e-6dee-544c-8bf9-4ed392af2343" :answer/id #uuid "20b2318e-6dee-544c-8bf9-4ed392af2343"] [:db/add "20b2318e-6dee-544c-8bf9-4ed392af2343" :answer/type :answer.type/math] [:db/add "20b2318e-6dee-544c-8bf9-4ed392af2343" :answer/value "2"] [:db/ensure "20b2318e-6dee-544c-8bf9-4ed392af2343" :answer/validate] [:db/add "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8" :answer-field/id #uuid "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8"] [:db/add "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8" :answer-field/key "field-1"] [:db/add "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8" :answer-field/type :answer-field.type/blank] [:db/add "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8" :answer-field/choices "20b2318e-6dee-544c-8bf9-4ed392af2343"] [:db/add "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8" :answer-field/correct "20b2318e-6dee-544c-8bf9-4ed392af2343"] [:db/ensure "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8" :answer-field/validate] [:db/add "059a2954-95ef-5c80-9985-aa1f54b274fd" :answer/id #uuid "059a2954-95ef-5c80-9985-aa1f54b274fd"] [:db/add "059a2954-95ef-5c80-9985-aa1f54b274fd" :answer/type :answer.type/math] [:db/add "059a2954-95ef-5c80-9985-aa1f54b274fd" :answer/value "-6"] [:db/ensure "059a2954-95ef-5c80-9985-aa1f54b274fd" :answer/validate] [:db/add "9eca4b51-8196-54d7-a291-d43148ce0620" :answer-field/id #uuid "9eca4b51-8196-54d7-a291-d43148ce0620"] [:db/add "9eca4b51-8196-54d7-a291-d43148ce0620" :answer-field/key "field-2"] [:db/add "9eca4b51-8196-54d7-a291-d43148ce0620" :answer-field/type :answer-field.type/blank] [:db/add "9eca4b51-8196-54d7-a291-d43148ce0620" :answer-field/choices "059a2954-95ef-5c80-9985-aa1f54b274fd"] [:db/add "9eca4b51-8196-54d7-a291-d43148ce0620" :answer-field/correct "059a2954-95ef-5c80-9985-aa1f54b274fd"] [:db/ensure "9eca4b51-8196-54d7-a291-d43148ce0620" :answer-field/validate] [:db/add "3274b331-4f5b-5a6b-882c-4168c288e5ba" :answer/id #uuid "3274b331-4f5b-5a6b-882c-4168c288e5ba"] [:db/add "3274b331-4f5b-5a6b-882c-4168c288e5ba" :answer/type :answer.type/math] [:db/add "3274b331-4f5b-5a6b-882c-4168c288e5ba" :answer/value "-2"] [:db/ensure "3274b331-4f5b-5a6b-882c-4168c288e5ba" :answer/validate] [:db/add "b99b699a-d05b-59a1-aacb-30c5a2baa9ff" :answer-field/id #uuid "b99b699a-d05b-59a1-aacb-30c5a2baa9ff"] [:db/add "b99b699a-d05b-59a1-aacb-30c5a2baa9ff" :answer-field/key "field-3"] [:db/add "b99b699a-d05b-59a1-aacb-30c5a2baa9ff" :answer-field/type :answer-field.type/blank] [:db/add "b99b699a-d05b-59a1-aacb-30c5a2baa9ff" :answer-field/choices "3274b331-4f5b-5a6b-882c-4168c288e5ba"] [:db/add "b99b699a-d05b-59a1-aacb-30c5a2baa9ff" :answer-field/correct "3274b331-4f5b-5a6b-882c-4168c288e5ba"] [:db/ensure "b99b699a-d05b-59a1-aacb-30c5a2baa9ff" :answer-field/validate] [:db/add "90febdeb-888f-5245-a4c0-d005214c232c" :question/id #uuid "90febdeb-888f-5245-a4c0-d005214c232c"] [:db/add "90febdeb-888f-5245-a4c0-d005214c232c" :question/problem "Consider the curve with parametric equations\n\n$$\nx=2 - t^{2},\\qquad y=- 3 t - 3,\\qquad -2\\le t\\le 2.\n$$\n\nFill in the three blanks in the table. Give exact values.\n\nUse the value of $t$ at the top of each column in the formula for that row. For example, $x(-2)=2 - \\left(-2\\right)^{2}=-2$.\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $-2$ | $1$ | {{field-1}} |\n| $y$ | $3$ | $0$ | $-3$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $1$ | {{field-3}} |\n| $y$ | {{field-2}} | $-9$ |"] [:db/add "90febdeb-888f-5245-a4c0-d005214c232c" :question/worked-solution "The missing entry is in the $x$-row under $t=0$. Substitute into $x=2 - t^{2}$:\n\n$$\n\\begin{aligned}x(0) &=2 - \\left(0\\right)^{2} \\\\ &=2\\end{aligned}\n$$\n\nThe missing entry is in the $y$-row under $t=1$. Substitute into $y=- 3 t - 3$:\n\n$$\n\\begin{aligned}y(1) &=- 3 \\left(1\\right) - 3 \\\\ &=-6\\end{aligned}\n$$\n\nThe missing entry is in the $x$-row under $t=2$. Substitute into $x=2 - t^{2}$:\n\n$$\n\\begin{aligned}x(2) &=2 - \\left(2\\right)^{2} \\\\ &=-2\\end{aligned}\n$$\n\nThe completed table is\n\n| **$t$** | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- |\n| $x$ | $-2$ | $1$ | $2$ |\n| $y$ | $3$ | $0$ | $-3$ |\n\n| **$t$** | $1$ | $2$ |\n| --- | --- | --- |\n| $x$ | $1$ | $-2$ |\n| $y$ | $-6$ | $-9$ |"] [:db/add "90febdeb-888f-5245-a4c0-d005214c232c" :question/difficulty :question.difficulty/easy] [:db/add "90febdeb-888f-5245-a4c0-d005214c232c" :question/answer-fields "c3f96d29-0b6c-5d5b-98a3-51f4ff8cbbd8"] [:db/add "90febdeb-888f-5245-a4c0-d005214c232c" :question/answer-fields "9eca4b51-8196-54d7-a291-d43148ce0620"] [:db/add "90febdeb-888f-5245-a4c0-d005214c232c" :question/answer-fields "b99b699a-d05b-59a1-aacb-30c5a2baa9ff"] [:db/ensure "90febdeb-888f-5245-a4c0-d005214c232c" :question/validate] [:db/add 17592186087717 :knowledge-point/questions "90febdeb-888f-5245-a4c0-d005214c232c"] [:db/add "326507c0-898e-50fd-a26b-d5d81c068911" :answer/id #uuid "326507c0-898e-50fd-a26b-d5d81c068911"] [:db/add "326507c0-898e-50fd-a26b-d5d81c068911" :answer/type :answer.type/math] [:db/add "326507c0-898e-50fd-a26b-d5d81c068911" :answer/value "3"] [:db/ensure "326507c0-898e-50fd-a26b-d5d81c068911" :answer/validate] [:db/add "0d807bd0-4401-50f7-b76c-5b3f96b67bb8" :answer-field/id #uuid "0d807bd0-4401-50f7-b7