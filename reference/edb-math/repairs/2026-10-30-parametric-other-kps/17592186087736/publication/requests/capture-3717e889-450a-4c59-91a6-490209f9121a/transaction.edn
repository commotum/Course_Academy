3af9ace18afb"] [:db/ensure "ee97febb-c69d-51f1-ba23-30f83a219651" :answer-field/validate] [:db/add "1427f528-ea2b-526a-92a8-3bd7ab9086bd" :answer/id #uuid "1427f528-ea2b-526a-92a8-3bd7ab9086bd"] [:db/add "1427f528-ea2b-526a-92a8-3bd7ab9086bd" :answer/type :answer.type/math] [:db/add "1427f528-ea2b-526a-92a8-3bd7ab9086bd" :answer/value "8"] [:db/ensure "1427f528-ea2b-526a-92a8-3bd7ab9086bd" :answer/validate] [:db/add "8a7e131e-dca1-5ee0-af35-663e3214e5e8" :answer-field/id #uuid "8a7e131e-dca1-5ee0-af35-663e3214e5e8"] [:db/add "8a7e131e-dca1-5ee0-af35-663e3214e5e8" :answer-field/key "field-8"] [:db/add "8a7e131e-dca1-5ee0-af35-663e3214e5e8" :answer-field/type :answer-field.type/blank] [:db/add "8a7e131e-dca1-5ee0-af35-663e3214e5e8" :answer-field/choices "1427f528-ea2b-526a-92a8-3bd7ab9086bd"] [:db/add "8a7e131e-dca1-5ee0-af35-663e3214e5e8" :answer-field/correct "1427f528-ea2b-526a-92a8-3bd7ab9086bd"] [:db/ensure "8a7e131e-dca1-5ee0-af35-663e3214e5e8" :answer-field/validate] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/id #uuid "06418a1e-a69a-5340-82ce-0ac7735c356c"] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=4\\sin\\theta-2\n$$\n\n$$\ny=-5\\cos\\theta+3\n$$\n\n$$\n\\frac{3\\pi}{2}<\\theta\\le 3\\pi\n$$\n\nwhat are the ranges of $x$ and $y$? Use $<$ or $\\le$ in the comparison blanks.\n\nThe range of $x$ is:\n\n{{field-1}} {{field-2}} $x$ {{field-3}} {{field-4}}.\n\nThe range of $y$ is:\n\n{{field-5}} {{field-6}} $y$ {{field-7}} {{field-8}}."] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/worked-solution "Consider each coordinate separately.\n\nFor $x$:\n\nCheck the quarter-turn points in the parameter interval and its endpoint limits: $\\theta=\\frac{3\\pi}{2}$ gives $\\sin\\theta=-1$ (excluded endpoint); $\\theta=2\\pi$ gives $\\sin\\theta=0$ (included); $\\theta=\\frac{5\\pi}{2}$ gives $\\sin\\theta=1$ (included); $\\theta=3\\pi$ gives $\\sin\\theta=0$ (included).\n\nThe value $-1$ is approached at an excluded endpoint and is not attained elsewhere in the interval.\n\nThe value $1$ is attained at $\\theta=\\frac{5\\pi}{2}$.\n\nMultiply by $4$ and translate by $-2$.\n\n$$\n\\begin{aligned}\n-1 &<\\sin\\theta\\le 1 \\\\\n-4 &<4\\sin\\theta\\le 4 \\\\\n-6 &<4\\sin\\theta-2\\le 2 \\\\\n-6 &<x\\le 2.\n\\end{aligned}\n$$\n\nThus $-6<x\\le 2$.\n\nFor $y$:\n\nCheck the quarter-turn points in the parameter interval and its endpoint limits: $\\theta=\\frac{3\\pi}{2}$ gives $\\cos\\theta=0$ (excluded endpoint); $\\theta=2\\pi$ gives $\\cos\\theta=1$ (included); $\\theta=\\frac{5\\pi}{2}$ gives $\\cos\\theta=0$ (included); $\\theta=3\\pi$ gives $\\cos\\theta=-1$ (included).\n\nThe value $-1$ is attained at $\\theta=3\\pi$.\n\nThe value $1$ is attained at $\\theta=2\\pi$.\n\nMultiplying by $-5$ reverses both comparisons; translate by $3$, then write the bounds in increasing order.\n\n$$\n\\begin{aligned}\n-1 &\\le \\cos\\theta\\le 1 \\\\\n5 &\\ge-5\\cos\\theta\\ge-5 \\\\\n8 &\\ge-5\\cos\\theta+3\\ge-2 \\\\\n-2 &\\le y\\le 8.\n\\end{aligned}\n$$\n\nThus $-2\\le y\\le 8$.\n\nContinuity gives every value between the stated bounds. The coordinate extrema need not occur at the same parameter value."] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/difficulty :question.difficulty/hard] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/answer-fields "319e4b0c-846c-59c6-983f-8028ca9dfb9c"] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/answer-fields "7587de98-6a16-51ee-8964-ed339d145fe8"] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/answer-fields "ea50b212-4850-5a9b-a3d4-086c508f3c43"] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/answer-fields "4fd57581-bd12-5c83-8771-eee55d12f480"] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/answer-fields "66c9d90e-eadd-5bd1-9d3b-964e5de0405e"] [:db/add "06418a1e-a69a-5340-82ce-0ac7735c356c" :question/answer-fields "4c87f429-a5c1-56b9-baa5-f