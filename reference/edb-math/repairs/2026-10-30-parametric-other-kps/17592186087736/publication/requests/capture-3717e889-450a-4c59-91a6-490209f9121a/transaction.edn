swer.type/math] [:db/add "5cd3d8bf-75f1-548c-bdb3-963a6dab92ad" :answer/value "3"] [:db/ensure "5cd3d8bf-75f1-548c-bdb3-963a6dab92ad" :answer/validate] [:db/add "c2593446-87ef-5dc3-b725-84689c85bc62" :answer-field/id #uuid "c2593446-87ef-5dc3-b725-84689c85bc62"] [:db/add "c2593446-87ef-5dc3-b725-84689c85bc62" :answer-field/key "field-6"] [:db/add "c2593446-87ef-5dc3-b725-84689c85bc62" :answer-field/type :answer-field.type/blank] [:db/add "c2593446-87ef-5dc3-b725-84689c85bc62" :answer-field/choices "5cd3d8bf-75f1-548c-bdb3-963a6dab92ad"] [:db/add "c2593446-87ef-5dc3-b725-84689c85bc62" :answer-field/correct "5cd3d8bf-75f1-548c-bdb3-963a6dab92ad"] [:db/ensure "c2593446-87ef-5dc3-b725-84689c85bc62" :answer-field/validate] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/id #uuid "f261983c-ec0f-583f-8d88-403ffd3f96a9"] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=-2\\cos\\theta\n$$\n\n$$\ny=-3\\sin\\theta\n$$\n\n$$\n0\\le \\theta<2\\pi\n$$\n\nwhat are the ranges of $x$ and $y$?\n\nThe range of $x$ is:\n\n{{field-1}} {{field-2}} $x\\le$ {{field-3}}.\n\nThe range of $y$ is:\n\n{{field-4}} $\\le y$ {{field-5}} {{field-6}}."] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/worked-solution "Consider each coordinate separately.\n\nFor $x$:\n\nOver the full turn, $\\cos\\theta$ attains both $-1$ and $1$, including at permitted parameter values.\n\nMultiplying by $-2$ reverses both comparisons; translate by $0$, then write the bounds in increasing order.\n\n$$\n\\begin{aligned}\n-1 &\\le \\cos\\theta\\le 1 \\\\\n2 &\\ge-2\\cos\\theta\\ge-2 \\\\\n-2 &\\le x\\le 2.\n\\end{aligned}\n$$\n\nThus $-2\\le x\\le 2$.\n\nFor $y$:\n\nOver the full turn, $\\sin\\theta$ attains both $-1$ and $1$, including at permitted parameter values.\n\nMultiplying by $-3$ reverses both comparisons; translate by $0$, then write the bounds in increasing order.\n\n$$\n\\begin{aligned}\n-1 &\\le \\sin\\theta\\le 1 \\\\\n3 &\\ge-3\\sin\\theta\\ge-3 \\\\\n-3 &\\le y\\le 3.\n\\end{aligned}\n$$\n\nThus $-3\\le y\\le 3$.\n\nContinuity gives every value between the stated bounds. The coordinate extrema need not occur at the same parameter value."] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/difficulty :question.difficulty/easy] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/answer-fields "dea6e07c-4bb9-51a7-8c20-d4e928225d80"] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/answer-fields "46e41882-36af-55b5-835e-372837a56397"] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/answer-fields "a40824d9-c379-5e53-8ed6-51c75da1f01b"] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/answer-fields "849dc7c2-53dc-52a1-aae8-a594e12bf65e"] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/answer-fields "6733379e-4da1-5f33-97f5-90ab7f350818"] [:db/add "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/answer-fields "c2593446-87ef-5dc3-b725-84689c85bc62"] [:db/ensure "f261983c-ec0f-583f-8d88-403ffd3f96a9" :question/validate] [:db/add 17592186087736 :knowledge-point/questions "f261983c-ec0f-583f-8d88-403ffd3f96a9"] [:db/add "5e5fc31d-7202-580b-9bdc-b0a246027b61" :answer/id #uuid "5e5fc31d-7202-580b-9bdc-b0a246027b61"] [:db/add "5e5fc31d-7202-580b-9bdc-b0a246027b61" :answer/type :answer.type/math] [:db/add "5e5fc31d-7202-580b-9bdc-b0a246027b61" :answer/value "-4"] [:db/ensure "5e5fc31d-7202-580b-9bdc-b0a246027b61" :answer/validate] [:db/add "9851e670-fd51-5716-8047-a0541d9d21d5" :answer-field/id #uuid "9851e670-fd51-5716-8047-a0541d9d21d5"] [:db/add "9851e670-fd51-5716-8047-a0541d9d21d5" :answer-field/key "field-1"] [:db/add "9851e670-fd51-5716-8047-a0541d9d21d5" :answer-field/type :answer-field.type/blank] [:db/add "9851e670-fd51-5716-8047-a0541d9d21d5" :answer-field/choices "5e5fc31d-7202-580b-9bdc-b0a246027b61"] [:db/add "9851e670-fd51-5716-8047-a0541d9d21d5" :answer-field/correct "5e5fc31d-7202-580b-9bdc-b0a246027b61"] [:db/ensure 