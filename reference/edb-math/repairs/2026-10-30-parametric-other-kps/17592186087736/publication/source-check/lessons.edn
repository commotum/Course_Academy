#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186088554} :activity/id #uuid "08de5d22-7723-5283-ac76-b0a9c54b4ea9" :activity/scope {:db/id #edb/ref 17592186048293} :activity/steps [{:db/id #edb/ref 17592186088554 :step/content {:db/id #edb/ref 17592186088904 :tutorial/content "We can draw a curve by defining a relationship between $x$ and $y$ using a third parameter $t.$ For example, suppose we have \n\n$$\nx=2t, \\,\\,\\, y=t^2, \\quad -3\\leq t\\leq 3.\n$$\n\nThese are the **parametric equations** of the curve.\n\nFirst, let's create a table for some values of $t\\mathbin{:}$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x= 2t$</td>\n<td data-cell-align=\"center\">$-6$</td>\n<td data-cell-align=\"center\">$-4$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$6$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y=t^2$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$9$</td>\n</tr>\n</tbody></table></div>\n\n\nPlotting these points, we get the following curve:\n\n![](images/f7/f716e12c79731f363ace05965809bfc1963a6c3a231e1c4a96eaf3dbb62c848e.png)\n\nThe curve is actually a parabola.\nA curve defined by parametric equations is called a **parametric curve** and is said to be \"defined parametrically\"." :tutorial/id #uuid "f1327a56-c215-50cb-a30e-e43369078a3c" :tutorial/math-academy-id 3349 :tutorial/title "Introduction"} :step/id #uuid "218377cb-122a-56d3-9bc2-df2b7ebad88e" :step/math-academy-id 18547 :step/next {:db/id #edb/ref 17592186088555}} {:db/id #edb/ref 17592186088555 :step/content {:db/id #edb/ref 17592186087717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087518 :question/id #uuid "53ce2176-ae44-578d-8fba-35c5018d4162" :question/math-academy-id "e-5075" :question/problem "For the parametric curve\n\n$$\nx=3t, \\,\\,\\, y=t^3, \\quad -3\\leq t \\leq 3,\n$$\n\nfill in the following table of values.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n" :question/worked-solution "First, we work out the $x$-values using the formula $x=3t.$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$-9$</td>\n<td data-cell-align=\"center\">$-6$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$9$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n\nNow, we work out the $y$-values using $y=t^3.$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$-9$</td>\n<td data-cell-align=\"center\">$-6$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$9$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$-27$</td>\n<td data-cell-align=\"center\">$-8$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$8$</td>\n<td data-cell-align=\"center\">$27$</td>\n</tr>\n</tbody></table></div>\n\n"} :knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050790}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/question-generator {:db/id #edb/ref 17592186747302} :knowledge-point/questions [{:db/id #edb/ref 17592186088269} {:db/id #edb/ref 17592186088270} {:db/id #edb/ref 17592186233325} {:db/id #edb/ref 17592186233831} {:db/id #edb/ref 17592186234248} {:db/id #edb/ref 17592186234256} {:db/id #edb/ref 17592186259554} {:db/id #edb/ref 17592186259555} {:db/id #edb/ref 17592186302269} {:db/id #edb/ref 17592186302270} {:db/id #edb/ref 17592186302271} {:db/id #edb/ref 17592186302272} {:db/id #edb/ref 17592186302273} {:db/id #edb/ref 17592186302274} {:db/id #edb/ref 17592186302275} {:db/id #edb/ref 17592186335928} {:db/id #edb/ref 17592186335959} {:db/id #edb/ref 17592186336019} {:db/id #edb/ref 17592186557627} {:db/id #edb/ref 17592186557631} {:db/id #edb/ref 17592186557649} {:db/id #edb/ref 17592186557664} {:db/id #edb/ref 17592186557666} {:db/id #edb/ref 17592186557670} {:db/id #edb/ref 17592186557674} {:db/id #edb/ref 17592186557680} {:db/id #edb/ref 17592186557691} {:db/id #edb/ref 17592186557694} {:db/id #edb/ref 17592186697642} {:db/id #edb/ref 17592186697645} {:db/id #edb/ref 17592186697653} {:db/id #edb/ref 17592186698121} {:db/id #edb/ref 17592186698122} {:db/id #edb/ref 17592186698133} {:db/id #edb/ref 17592186698140} {:db/id #edb/ref 17592186698141} {:db/id #edb/ref 17592186747220} {:db/id #edb/ref 17592186747225} {:db/id #edb/ref 17592186747233} {:db/id #edb/ref 17592186747251} {:db/id #edb/ref 17592186747260} {:db/id #edb/ref 17592186747262} {:db/id #edb/ref 17592186747263} {:db/id #edb/ref 17592186747273} {:db/id #edb/ref 17592186747275} {:db/id #edb/ref 17592186747283} {:db/id #edb/ref 17592186747288} {:db/id #edb/ref 17592186747289} {:db/id #edb/ref 17592186747290} {:db/id #edb/ref 17592186747294} {:db/id #edb/ref 17592186747299}] :knowledge-point/title "Filling a Table of Values for a Parametric Curve"} :step/id #uuid "100ba475-df33-5ce4-9f19-dc90b51a15ac" :step/math-academy-id 18548 :step/next {:db/id #edb/ref 17592186088560}} {:db/id #edb/ref 17592186088560 :step/content {:db/id #edb/ref 17592186087721 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087522 :question/id #uuid "b322617c-ab21-5ce8-997f-2f10813b4280" :question/math-academy-id "e-5098" :question/problem "Plot the graph of the parametrically defined curve\n\n$$\nx=t(t-6), \\,\\,\\, y=t^3, \\quad -2\\leq t \\leq 2.\n$$" :question/worked-solution "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=t(t-6).$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$16$</td>\n<td data-cell-align=\"center\">$7$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$-5$</td>\n<td data-cell-align=\"center\">$-8$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n\nNow, we work out the $y$ values using $y=t^3.$ This gives\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$t$</strong></td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$16$</td>\n<td data-cell-align=\"center\">$7$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$-5$</td>\n<td data-cell-align=\"center\">$-8$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$-8$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$8$</td>\n</tr>\n</tbody></table></div>\n\n\nPlotting these points, we obtain the following curve:\n\n![](images/f1/f15f25af0c4804dc811a0ab231ba2ef3ecce2ecd12501a1f2d8b9e34b71a505b.png)"} :knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049072}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/question-generator {:db/id #edb/ref 17592186747180} :knowledge-point/questions [{:db/id #edb/ref 17592186088027} {:db/id #edb/ref 17592186088028} {:db/id #edb/ref 17592186259562} {:db/id #edb/ref 17592186259563} {:db/id #edb/ref 17592186259564} {:db/id #edb/ref 17592186259565} {:db/id #edb/ref 17592186281298} {:db/id #edb/ref 17592186281377} {:db/id #edb/ref 17592186281382} {:db/id #edb/ref 17592186281384} {:db/id #edb/ref 17592186387437} {:db/id #edb/ref 17592186387444} {:db/id #edb/ref 17592186389223} {:db/id #edb/ref 17592186389236} {:db/id #edb/ref 17592186389243} {:db/id #edb/ref 17592186393320} {:db/id #edb/ref 17592186535253} {:db/id #edb/ref 17592186535255} {:db/id #edb/ref 17592186535257} {:db/id #edb/ref 17592186535260} {:db/id #edb/ref 17592186535263} {:db/id #edb/ref 17592186535268} {:db/id #edb/ref 17592186535273} {:db/id #edb/ref 17592186535279} {:db/id #edb/ref 17592186535287} {:db/id #edb/ref 17592186535294} {:db/id #edb/ref 17592186697893} {:db/id #edb/ref 17592186697894} {:db/id #edb/ref 17592186697897} {:db/id #edb/ref 17592186698403} {:db/id #edb/ref 17592186698404} {:db/id #edb/ref 17592186698408} {:db/id #edb/ref 17592186698430} {:db/id #edb/ref 17592186698431} {:db/id #edb/ref 17592186747075} {:db/id #edb/ref 17592186747088} {:db/id #edb/ref 17592186747098} {:db/id #edb/ref 17592186747104} {:db/id #edb/ref 17592186747115} {:db/id #edb/ref 17592186747119} {:db/id #edb/ref 17592186747125} {:db/id #edb/ref 17592186747130} {:db/id #edb/ref 17592186747135} {:db/id #edb/ref 17592186747136} {:db/id #edb/ref 17592186747145} {:db/id #edb/ref 17592186747157} {:db/id #edb/ref 17592186747159} {:db/id #edb/ref 17592186747167} {:db/id #edb/ref 17592186747170}] :knowledge-point/title "Graphing a Curve Defined Parametrically"} :step/id #uuid "5621dae4-d9c7-5199-b4f0-2ee503009aa1" :step/math-academy-id 18603 :step/next {:db/id #edb/ref 17592186088561}} {:db/id #edb/ref 17592186088561 :step/content {:db/id #edb/ref 17592186087722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087523 :question/id #uuid "a792fa16-e1fd-5f30-a128-bbc49a285429" :question/math-academy-id "e-5099" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=t^2-6t, \\,\\,\\, y=t^4+4, \\quad t \\in (-\\infty , \\infty),\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}-6t \\\\  & ={(t-3)}^{2}-(3)^{2} \\\\  & ={(t-3)}^{2}-9\\end{aligned}\n$$\n\nSince $\\left( t-3\\right)^2 \\geq 0,$ we can conclude that $x \\geq -9.$\n\n- To find the range of $y=t^4+4,$ notice that $t^4 \\geq 0,$ and consequently $y \\geq 4.$\n\nTherefore, the ranges are $x \\geq -9$ and $y \\geq 4.$"} :knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050372} {:db/id #edb/ref 17592186050580} {:db/id #edb/ref 17592186050642}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186698203} :knowledge-point/questions [{:db/id #edb/ref 17592186088030} {:db/id #edb/ref 17592186088031} {:db/id #edb/ref 17592186233539} {:db/id #edb/ref 17592186234355} {:db/id #edb/ref 17592186259556} {:db/id #edb/ref 17592186259557} {:db/id #edb/ref 17592186259558} {:db/id #edb/ref 17592186259559} {:db/id #edb/ref 17592186259560} {:db/id #edb/ref 17592186281385} {:db/id #edb/ref 17592186281386} {:db/id #edb/ref 17592186292914} {:db/id #edb/ref 17592186302276} {:db/id #edb/ref 17592186302278} {:db/id #edb/ref 17592186302285} {:db/id #edb/ref 17592186302286} {:db/id #edb/ref 17592186302287} {:db/id #edb/ref 17592186302337} {:db/id #edb/ref 17592186302362} {:db/id #edb/ref 17592186302363} {:db/id #edb/ref 17592186342036} {:db/id #edb/ref 17592186400114} {:db/id #edb/ref 17592186403675} {:db/id #edb/ref 17592186540320} {:db/id #edb/ref 17592186540324} {:db/id #edb/ref 17592186540326} {:db/id #edb/ref 17592186540328} {:db/id #edb/ref 17592186540334} {:db/id #edb/ref 17592186540342} {:db/id #edb/ref 17592186540344} {:db/id #edb/ref 17592186540364} {:db/id #edb/ref 17592186540366} {:db/id #edb/ref 17592186540388} {:db/id #edb/ref 17592186697915} {:db/id #edb/ref 17592186697918} {:db/id #edb/ref 17592186697926} {:db/id #edb/ref 17592186698167} {:db/id #edb/ref 17592186698175} {:db/id #edb/ref 17592186698191} {:db/id #edb/ref 17592186698193} {:db/id #edb/ref 17592186698198}] :knowledge-point/title "Determining the Range of a Parametric Equation"} :step/id #uuid "a2b6d468-dc59-53d1-b89f-9fdbc94f428b" :step/math-academy-id 18604 :step/next {:db/id #edb/ref 17592186088562}} {:db/id #edb/ref 17592186088562 :step/content {:db/id #edb/ref 17592186088906 :tutorial/content "We often see parametric curves defined in terms of the parameter $t,$ such as the parametric curve given below:\n\n$$\nx=2 \\cos t, \\,\\,\\, y=3 \\sin t, \\quad 0 \\leq t < 2 \\pi\n$$\n\nHowever, we can also define parametric curves in terms of other variables. Another commonly used variable is $\\theta.$ So, in terms of $\\theta,$ the above parametric equation is expressed as\n\n$$\nx=2 \\cos \\theta, \\,\\,\\, y=3 \\sin \\theta, \\quad 0 \\leq \\theta < 2 \\pi .\n$$\n\nWe often use $\\theta$ when the bounds are $0 \\leq \\theta < 2\\pi,$ because this implies that the parameter $\\theta$ might be interpreted as an angle." :tutorial/id #uuid "5a132530-6b5f-59d1-bd02-6ac362b558a7" :tutorial/math-academy-id 3370 :tutorial/title "Defining Parametric Curves Using Other Parameters"} :step/id #uuid "35535a0b-1ada-5085-afad-0de6b32bfb5b" :step/math-academy-id 18844 :step/next {:db/id #edb/ref 17592186088588}} {:db/id #edb/ref 17592186088588 :step/content {:db/id #edb/ref 17592186087736 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087542 :question/id #uuid "25ab094c-a35e-5507-a6df-459361ff6fcd" :question/math-academy-id "e-5292" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx = 4\\cos\\theta, \\,\\,\\, y = 2\\sin\\theta, \\quad 0\\leq \\theta <     2\\pi,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\leq\\theta <  2\\pi,$ we have $-1 \\leq \\cos{\\theta} \\leq 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -4 & \\le 4\\operatorname{cos}⁡\\theta \\le 4 \\\\ -4 & \\le x\\le 4.\\end{aligned}\n$$\n\nSo, we can conclude that $-4 \\leq x \\leq 4.$\n\n- To find the range of $y,$ notice that for $0\\leq\\theta <  2\\pi,$ we have $-1 \\leq \\sin{\\theta} \\leq 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -2 & \\le 2\\operatorname{sin}⁡\\theta \\le 2 \\\\ -2 & \\le y\\le 2.\\end{aligned}\n$$\n\nSo, we can conclude that $-2 \\leq y \\leq 2.$\n\nTherefore, the ranges are $-4 \\leq x \\leq 4$ and $-2 \\leq y \\leq 2.$"} :knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049872}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186698269} :knowledge-point/questions [{:db/id #edb/ref 17592186088029} {:db/id #edb/ref 17592186088281} {:db/id #edb/ref 17592186233713} {:db/id #edb/ref 17592186233838} {:db/id #edb/ref 17592186259561} {:db/id #edb/ref 17592186292915} {:db/id #edb/ref 17592186302364} {:db/id #edb/ref 17592186302365} {:db/id #edb/ref 17592186302367} {:db/id #edb/ref 17592186302369} {:db/id #edb/ref 17592186302370} {:db/id #edb/ref 17592186338790} {:db/id #edb/ref 17592186342038} {:db/id #edb/ref 17592186342042} {:db/id #edb/ref 17592186400121} {:db/id #edb/ref 17592186400128} {:db/id #edb/ref 17592186526245} {:db/id #edb/ref 17592186526250} {:db/id #edb/ref 17592186526255} {:db/id #edb/ref 17592186526260} {:db/id #edb/ref 17592186526264} {:db/id #edb/ref 17592186698065} {:db/id #edb/ref 17592186698070} {:db/id #edb/ref 17592186698072} {:db/id #edb/ref 17592186698224} {:db/id #edb/ref 17592186698228} {:db/id #edb/ref 17592186698230} {:db/id #edb/ref 17592186698242} {:db/id #edb/ref 17592186698254}] :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"} :step/id #uuid "a097ab21-0ae3-5fba-a879-051b3ab0e156" :step/math-academy-id 19530}] :activity/title "Graphing Curves Defined Parametrically" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186087892}]}
