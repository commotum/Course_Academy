edb/ref 17592186755746} {:answer/id #uuid "079218f5-e963-5141-9196-aefababe086a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755747}] :answer-field/correct {:answer/id #uuid "4fe9cad6-e923-580c-8231-305568e095e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755746} :answer-field/id #uuid "2b502565-9479-5327-98c5-d51943c30c22" :answer-field/key "${y}^{″}+xy-2x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755745}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7830240-8585-5e21-ba7a-c44cace370a2" :question/math-academy-id "q-337919" :question/problem "Select all homogeneous second-order linear differential equations.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n\\operatorname{sin}⁡(x){y}^{″}-x{y}^{′}+y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}+2{y}^{′}+y=2\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=2,$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}+xy-2x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}+xy=2x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=2x,$ which is different from zero."}] [17592186152572 {:db/id #edb/ref 17592186152572 :knowledge-point/_questions [{:db/id #edb/ref 17592186152274}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38c119f8-87a8-5e89-883c-2e545edee1a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755749} {:answer/id #uuid "43fe3b14-c65d-5964-aab8-9b342ccfcf4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755750}] :answer-field/correct {:answer/id #uuid "43fe3b14-c65d-5964-aab8-9b342ccfcf4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755750} :answer-field/id #uuid "d3472571-49c5-53bf-8140-7f8e6ac3e9d8" :answer-field/key "${x}^{2}{y}^{″}+3x{y}^{′}-y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755748} {:answer-field/choices [{:answer/id #uuid "8e85ac65-0f39-509b-a3cc-a3b56168ff10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755752} {:answer/id #uuid "4d9b1025-387b-5897-acc6-a136d8432ba7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755753}] :answer-field/correct {:answer/id #uuid "8e85ac65-0f39-509b-a3cc-a3b56168ff10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755752} :answer-field/id #uuid "4e25eeca-5c2d-52ee-9ddc-cdbc305e2c66" :answer-field/key "${y}^{″}-{y}^{′}+y={e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755751} {:answer-field/choices [{:answer/id #uuid "608d3316-2cf3-5c08-9485-171725600c0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755755} {:answer/id #uuid "de0b6529-d2bd-505e-8c9b-451b89e2d8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755756}] :answer-field/correct {:answer/id #uuid "608d3316-2cf3-5c08-9485-171725600c0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755755} :answer-field/id #uuid "d55bb1b8-4c53-5802-b84b-7bc89bb4c704" :answer-field/key "${y}^{″}+{x}^{2}y+x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755754}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e93ecbe-42b9-5aed-a2ce-1b2b418237f4" :question/math-academy-id "q-337990" :question/problem "Select all homogeneous second-order linear differential equations.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n{x}^{2}{y}^{″}+3x{y}^{′}-y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}-{y}^{′}+y={e}^{x}\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)={e}^{x},$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}+{x}^{2}y+x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}+{x}^{2}y=-x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-x,$ which is different from zero."}] [17592186311903 {:db/id #edb/ref 17592186311903 :knowledge-point/_questions [{:db/id #edb/ref 17592186152274}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8acbb98-2a4d-5203-99d2-be4abc6a7848" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755758} {:answer/id #uuid "ec33ec02-afae-5b20-8d84-fcbb3427c98e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755759}] :answer-field/correct {:answer/id #uuid "a8acbb98-2a4d-5203-99d2-be4abc6a7848" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755758} :answer-field/id #uuid "cd1fc782-b07e-5932-99e9-05a2c3204147" :answer-field/key "${y}^{″}+5{y}^{′}+6y=7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755757} {:answer-field/choices [{:answer/id #uuid "ffae9ce5-8cc3-566d-b1af-7d7546f31911" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755761} {:answer/id #uuid "8d108623-7585-5ac4-ae68-6c29a4bdd931" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755762}] :answer-field/correct {:answer/id #uuid "8d108623-7585-5ac4-ae68-6c29a4bdd931" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755762} :answer-field/id #uuid "7135fed3-ee7a-56f5-86d0-5f188c9b587d" :answer-field/key "$\\operatorname{ln}⁡(x){y}^{″}+(1-x){y}^{′}-4y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755760} {:answer-field/choices [{:answer/id #uuid "8be7acb1-ac2f-5e66-a056-bb6e493ade6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755764} {:answer/id #uuid "aec0fa71-df2e-5d77-a08d-7782e071e911" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755765}] :answer-field/correct {:answer/id #uuid "8be7acb1-ac2f-5e66-a056-bb6e493ade6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755764} :answer-field/id #uuid "b45d5c50-4b5d-5240-9710-41b2b9db9bf1" :answer-field/key "${y}^{″}+xy+{x}^{3}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755763}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d738a1f-befb-5d33-811f-bc5d7b9e6626" :question/math-academy-id "q-337996" :question/problem "Select all homogeneous second-order linear differential equations.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n{y}^{″}+5{y}^{′}+6y=7\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=7,$ which is different from zero.\n\n- The equation\n\n$$\n\\operatorname{ln}⁡(x){y}^{″}+(1-x){y}^{′}-4y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- Writing the equation\n\n$$\n{y}^{″}+xy+{x}^{3}=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}+xy=-{x}^{3}.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-{x}^{3},$ which is different from zero."}] [17592186311905 {:db/id #edb/ref 17592186311905 :knowledge-point/_questions [{:db/id #edb/ref 17592186152274}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30dc4c1c-53ea-5e83-ade5-bdb23b31c573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755776} {:answer/id #uuid "f7fdc313-69b7-5a8e-a9df-e67dbc66fbef" :answer/type {:db/i