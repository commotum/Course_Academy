from zero."} {:db/id #edb/ref 17592186397097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f14af8af-5806-5342-acc3-45f3c5f3dad9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755767} {:answer/id #uuid "2f5bf1eb-28eb-5a44-9dd0-7b13e50f5ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755768}] :answer-field/correct {:answer/id #uuid "2f5bf1eb-28eb-5a44-9dd0-7b13e50f5ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755768} :answer-field/id #uuid "edebfcf6-8a44-52a9-9d58-0b395090d784" :answer-field/key "$\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755766} {:answer-field/choices [{:answer/id #uuid "6240e0e5-6564-540e-9c4b-dfce1245c6ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755770} {:answer/id #uuid "751b6ce6-dafa-5a22-bb84-85bb0be36cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755771}] :answer-field/correct {:answer/id #uuid "6240e0e5-6564-540e-9c4b-dfce1245c6ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755770} :answer-field/id #uuid "1cc8e66e-b5e7-57da-ae09-cdf15853acb5" :answer-field/key "${y}^{″}+3{y}^{′}=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755769} {:answer-field/choices [{:answer/id #uuid "f90e140a-c1af-5297-9393-f5f1546f071f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755773} {:answer/id #uuid "328fdd7b-9b76-5795-9b0d-0754f5d46d42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755774}] :answer-field/correct {:answer/id #uuid "f90e140a-c1af-5297-9393-f5f1546f071f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755773} :answer-field/id #uuid "aabaaeee-0cdb-509c-a1c9-b909c583f28c" :answer-field/key "${y}^{″}-xy+4x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755772}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8da06f22-6a38-578e-b590-3e2d4a9025f6" :question/math-academy-id "q-338004" :question/problem "Select all homogeneous second-order linear differential equations.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}+3{y}^{′}=x\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=x,$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}-xy+4x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}-xy=-4x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-4x,$ which is different from zero."} {:db/id #edb/ref 17592186397107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b08425c2-a62a-59a0-8d61-2be0c43d1bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755794} {:answer/id #uuid "b1e83836-5039-5c26-b254-f0b9ac803ab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755795}] :answer-field/correct {:answer/id #uuid "b08425c2-a62a-59a0-8d61-2be0c43d1bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755794} :answer-field/id #uuid "e4c87c84-9c19-5e01-98e7-3216d34337f0" :answer-field/key "${y}^{″}+2y=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755793} {:answer-field/choices [{:answer/id #uuid "0c2b6982-ae03-5ccd-8333-82ce10c73f1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755797} {:answer/id #uuid "fb1cd29a-2c74-5d0f-9b03-e55e99764d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755798}] :answer-field/correct {:answer/id #uuid "fb1cd29a-2c74-5d0f-9b03-e55e99764d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755798} :answer-field/id #uuid "5253b071-4f14-5118-8a5d-78122d58e646" :answer-field/key "$\\operatorname{tan}⁡(x){y}^{″}+{y}^{′}-6y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755796} {:answer-field/choices [{:answer/id #uuid "85ee9fbd-d4d8-551b-b592-e505d97cd355" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755800} {:answer/id #uuid "ea1fbee0-fdc7-5ee3-ad2d-02b56e6d421b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186755801}] :answer-field/correct {:answer/id #uuid "85ee9fbd-d4d8-551b-b592-e505d97cd355" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186755800} :answer-field/id #uuid "763ea887-1956-5711-977e-a06d65fc4e89" :answer-field/key "${y}^{″}-(x+2)y+5x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186755799}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8b12875-ae8a-5464-b1d4-8be3ec87c5f9" :question/math-academy-id "q-338082" :question/problem "Select all homogeneous second-order linear differential equations.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n{y}^{″}+2y=x\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=x,$ which is different from zero.\n\n- The equation\n\n$$\n\\operatorname{tan}⁡(x){y}^{″}+{y}^{′}-6y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- Writing the equation\n\n$$\n{y}^{″}-(x+2)y+5x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}-(x+2)y=-5x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-5x,$ which is different from zero."}] :knowledge-point/title "Identifying Second-Order Homogeneous ODEs"} {:db/id #edb/ref 17592186152275 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151963 :question/id #uuid "4f4f4539-466a-5cc0-9470-8b94d6221093" :question/math-academy-id "e-6568" :question/problem "For the differential equation $2xy'' +y' - y = \\cos x,$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x)y'' + b(x)y' + c(x) y = f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x)y'' + b(x)y' + c(x) y = 0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\n2xy'' +y' - y = 0.\n$$"} :knowledge-point/id #uuid "66ec8603-ae96-5212-88e1-4571d7face6b" :knowledge-point/questions [{:db/id #edb/ref 17592186152629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37430288-694f-5588-94f3-bc322d1989cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+\\frac{{y}^{′}}{x}+\\frac{y}{{x}^{2}}=x" :db/id #edb/ref 17592186333496} {:answer/id #uuid "3abc5462-0692-5fd1-860f-2aa744636263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}+y={x}^{3}" :db/id #edb/ref 17592186333541} {:answer/id #uuid "c75de19e-5813-5b7c-b671-1a1b35737315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{″}+x{y}^{′}=0" :db/id #edb/ref 17592186334720} {:answer/id #uuid "c9af4842-e155-54ee-9774-3e3aaca57396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{″}+x{y}^{′}+y=0" :db/id #edb/ref 17592186334744} {:answer/id #uuid "ebfa9237-42bd-53e4-bfe5-ed3e73fad0f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}+1=0" :db/id #edb/ref 17592186335056}] :answer-field/correct {:answer/id #uuid "c9af4842-e155-54ee-9774-3e3aaca57396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{″}+x{y}^{′}+y=0" :db/id #edb/ref 17592186334744} :answer-field/id #uuid "b9ee9a38-955e-5d37-87e5-e364f111f8b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "392fa1c6-b529-58c2-a651-f4ff011c9161" :question/math-academy-id "q-64963" :question/problem "For the differential equation ${x}^{2}{y}^{″}+x{y}^{′}+y={x}^{3},$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\n{x}^{2}{y}^{″}+x{y}^{′}+y=0.\n$$"} {:db/id #edb/ref 17592186152633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1280a081-0951-59c9-a197-2b75a498c7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{″}-{y}^{′}=0" :db/id #edb/ref 17592186333154} {:answer/id #uuid "2a54d55d-9c63-5841-b345-d2df6869a953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}-{y}^{′}+3y=0" :db/id #edb/ref 17592186333386} {:answer/id #uuid "bb6ade23-34a6-50a1-9b71-f379f9656827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}-\\frac{{y}^{′}}{{x}^{2}}+\\frac{3y}{{x}^{2}}=\\frac{{e}^{x}}{{x}^{2}}" :db/id #edb/ref 17592186334624} {:answer/id #uuid "c1af7ecd-6762-51ef-9586-1c359c6aea74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{″}-{y}^{′}+3y=1" :db/id #edb/ref 17592186334670} {:answer/id #uuid "e3733f5c-9040-5712-98aa-e71ca63e883c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{″}-{y}^{′}+3y=0" :db/id #edb/ref 17592186334970}] :answer-field/correct {:answer/id #uuid "e3733f5c-9040-5712-98aa-e71ca63e883c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{″}-{y}^{′}+3y=0" :db/id #edb/ref 17592186334970} :answer-field/id #uuid "1fe3342f-65ec-5c91-a8cd-5dc8371abefd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335298}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "131a8593-ee2e-5d10-85e8-bff07e98bf94" :question/math-academy-id "q-65017" :question/problem "For the differential equation ${x}^{2}{y}^{″}-{y}^{′}+3y={e}^{x},$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\n{x}^{2}{y}^{″}-{y}^{′}+3y=0.\n$$"} {:db/id #edb/ref 17592186266027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ef0909-f69a-5f5b-90ba-5d1656877464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}-3{y}^{′}+y=0" :db/id #edb/ref 17592186263093} {:answer/id #uuid "399ddaaa-7528-52c8-9cc9-ef797420b8f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}-3{y}^{′}+xy=0" :db/id #edb/ref 17592186263513} {:answer/id #uuid "6e432603-b1f1-515d-9740-47604da9b3c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}{y}^{″}-\\frac{3}{x}y+y=\\frac{2{e}^{2x}}{x}" :db/id #edb/ref 17592186263954} {:answer/id #uuid "a5e27377-aa26-5249-a3f1-46211697f285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}{y}^{″}-3{e}^{-2x}+y=2" :db/id #edb/ref 17592186264420} {:answer/id #uuid "a67aa7a2-1883-5f9a-bcd7-61eec314f944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}-3{y}^{′}-2{e}^{2x}y=0" :db/id #edb/ref 17592186264425}] :answer-field/correct {:answer/id #uuid "399ddaaa-7528-52c8-9cc9-ef797420b8f5" :answer/type