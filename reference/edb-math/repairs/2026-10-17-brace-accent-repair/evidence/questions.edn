b/id 17592186443397} {:answer-field/choices [{:answer/id #uuid "279e25d8-a35a-51f3-909a-d3da6f6525dc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186443329} {:answer/id #uuid "a52fec95-a2f3-5ebd-8882-c1f68cbdff88" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id 17592186443360} {:answer/id #uuid "c2cfde41-79c8-5d5c-914a-bb91867ffd68" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{10}}" :db/id 17592186443366} {:answer/id #uuid "d430873f-a576-5e14-a8f1-aadcafaac029" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186443371}] :answer-field/correct {:answer/id #uuid "d430873f-a576-5e14-a8f1-aadcafaac029" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186443371} :answer-field/id #uuid "ad304818-0973-5ffa-a52d-ed57c5f78953" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186443399} {:answer-field/choices [{:answer/id #uuid "09d46260-ae76-5595-885c-d19b632acbfa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id 17592186443319} {:answer/id #uuid "80df9fd6-ebb0-583f-b02f-12ccf9bc0fd5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186443355} {:answer/id #uuid "d2e2068e-3525-5b2c-a846-1daee1cd5c15" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{10}}" :db/id 17592186443370} {:answer/id #uuid "e9dc424f-27f0-53d2-b13f-870a32506acb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186443382}] :answer-field/correct {:answer/id #uuid "80df9fd6-ebb0-583f-b02f-12ccf9bc0fd5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186443355} :answer-field/id #uuid "be97c530-ef15-5632-922e-68f2e8ce47c0" :answer-field/key "field-6" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186443402} {:answer-field/choices [{:answer/id #uuid "4bf70411-1f19-53a2-a3b8-9a1b12b5ec70" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id 17592186443338} {:answer/id #uuid "da239506-5511-599b-8ddb-c93e5896ff1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{10}}" :db/id 17592186443374} {:answer/id #uuid "e151374e-b181-5980-8595-359e1cd1cb3f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186443378} {:answer/id #uuid "f00b04be-c45d-5315-b8e3-7fe8b852f7a9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{10}}" :db/id 17592186443384}] :answer-field/correct {:answer/id #uuid "da239506-5511-599b-8ddb-c93e5896ff1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{10}}" :db/id 17592186443374} :answer-field/id #uuid "e2ce7fcb-cc48-5f67-a313-8284ed75ba4a" :answer-field/key "field-9" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186443405}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd93c01d-3a4b-5e26-802f-bf34131bc696" :question/math-academy-id "q-363664" :question/problem "$$\nA=\\begin{bmatrix}0 & 0 \\\\ 1 & 1 \\\\ 3 & 3\\end{bmatrix},\\,Σ=\\begin{bmatrix}2\\sqrt{5} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=2\\sqrt{5}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-2}} |  |  |\n|  |  | $\\frac{3}{\\sqrt{10}}$ |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{1}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-5}} |  |  |\n|  |  | ${x}_{3}$ |  |  |\n\nthat we can rewrite as\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ -3{x}_{3} \\\\ {x}_{3}\\end{bmatrix}={x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}.\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-6}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-7}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-8}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\frac{1}{\\sqrt{10}}$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{5}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{5}}\\begin{bmatrix}0 & 0 \\\\ 1 & 1 \\\\ 3 & 3\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{2\\sqrt{5}}\\begin{bmatrix}0 \\\\ \\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{10}}{x}_{2}+\\frac{3}{\\sqrt{10}}{x}_{3}=0\\,⟹\\,{x}_{2}+3{x}_{3}=0,\n$$\n\nwe get the general solution \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ -3{x}_{3} \\\\ {x}_{3}\\end{bmatrix}={x}_{1}{{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{3}{{\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{1}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\,{u}_{3}=\\begin{bmatrix}0 \\\\ -\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{bmatrix}\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=\\begin{bmatrix}0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{10}} & 0 & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & 0 & \\frac{1}{\\sqrt{10}}\\end{bmatrix}\n$$"} {:db/id 17592186444618 :knowledge-point/_questions [{:db/id 17592186166882 :knowledge-point/id #uuid "f9a62365-4278-557f-ba76-caa31abe7869" :knowledge-point/title "Computing the Flux of a Vector Field Through a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23676b92-59ce-549e-bb44-0ce2c22aff60" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186444601} {:answer/id #uuid "30a14e60-74d3-59a0-9d7c-8bfb0dc4a3c2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id 17592186444603} {:answer/id #uuid "8c7915a4-09c6-54d8-8b86-d3abcf6997b3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id 17592186444607} {:answer/id #uuid "ca06b212-b30b-58a7-bceb-f7e5db8c00f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id 17592186444612} {:answer/id #uuid "f6e593f7-c2c1-5fc5-8a3d-c699694f0c1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id 17592186444614}] :answer-field/correct {:answer/id #uuid "f6e593f7-c2c1-5fc5-8a3d-c699694f0c1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id 17592186444614} :answer-field/id #uuid "6ac4cbf3-d6da-5e60-8eb4-cf067330135d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186444617}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2ae7b222-1017-5e06-9f85-8323117b3184" :question/math-academy-id "q-162158" :question/problem "Consider the vector field $F(x,y,z)=⟨z+5,\\,x-2y,\\,3x-2y⟩$ and a finite region $S$ of the plane $z=x+2y+1$ such that $\\text{Area}(S)=\\sqrt{2}.$ Calculate the flux of $F$ through $S$ with respect to the *downward*-pointing unit normal vector $n.$" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=x+2y+1$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-1,\\,-2,\\,1⟩}_{⏟}}_{\\overset{~}{n}}=1,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨1,\\,2,\\,-1⟩}_{⏟}}_{-\\overset{~}{n}}=-1.\n$$\n\nSince we require a downward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is negative. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨1,\\,2,\\,-1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨1,\\,2,\\,-1⟩}{\\sqrt{{1}^{2}+{2}^{2}+(-1)^{2}}} \\\\  & =\\frac{1}{\\sqrt{6}}⟨1,\\,2,\\,-1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=x+2y+1$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z+5,\\,x-2y,\\,3x-2y⟩\\cdot \\frac{1}{\\sqrt{6}}⟨1,\\,2,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨x+2y+6,\\,x-2y,\\,3x-2y⟩\\cdot ⟨1,\\,2,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{6}}((x+2y+6)+2(x-2y)-(3x-2y)) \\\\  & =\\frac{1}{\\sqrt{6}}(x+2y+6+2x-4y-3x+2y) \\\\  & =\\frac{6}{\\sqrt{6}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\sqrt{6}\\,\\text{d}S \\\\  & =\\sqrt{6}{∬}_{S}\\,\\text{d}S \\\\  & =\\sqrt{6}\\cdot \\text{Area}(S) \\\\  & =\\sqrt{6}\\cdot \\sqrt{2} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$"} {:db/id 17592186444619 :knowledge-point/_questions [{:db/id 17592186166882 :knowledge-point/id #uuid "f9a62365-4278-557f-ba76-caa31abe7869" :knowledge-point/title "Computing the Flux of a Vector Field Through a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e7ca8ec-891f-5ccc-985b-4e4a85531ac2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186444602} {:answer/id #uuid "3ccaaf5e-0e10-5c99-a0bc-d8a834cb86f3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id 17592186444604} {:answer/id #uuid "a5039a5b-f9d4-5a06-b32c-4be440d0e059" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186444609} {:answer/id #uuid "c73e0516-826a-57fd-99ad-0e6ddc957f95" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186444611} {:answer/id #uuid "f817a54c-d2b8-5a8f-9b28-dbefeb579916" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id 17592186444615}] :answer-field/correct {:answer/id #uuid "c73e0516-826a-57fd-99ad-0e6ddc957f95" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186444611} :answer-field/id #uuid "5c6a2aa9-7d14-5b93-966f-5ef76762e118" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186444616}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "627a222e-9363-5b8b-b1ec-0730c89cfcbe" :question/math-academy-id "q-161193" :question/problem "Consider the vector field $F(x,y,z)=⟨z,\\,y,\\,x⟩$ and the surface $S$ defined in Cartesian coordinates as $z=x+y$ for $0\\le x\\le 3$ and $0\\le y\\le 1.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$\n\n*Hint: You're given that the fundamental vector product of $S$ with respect to its canonical parametrization is $||{r}_{x}\\times {r}_{y}||=\\sqrt{3}.$*" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=x+y$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-1,\\,-1,\\,1⟩}_{⏟}}_{\\overset{~}{n}}=0,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨1,\\,1,\\,-1⟩}_{⏟}}_{-\\overset{~}{n}}=0.\n$$\n\nSince we require an upward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is positive. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨-1,\\,-1,\\,1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨-1,\\,-1,\\,1⟩}{\\sqrt{(-1)^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{1}{\\sqrt{3}}⟨-1,\\,-1,\\,1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=x+y$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,y,\\,x⟩\\cdot \\frac{1}{\\sqrt{3}}⟨-1,\\,-1,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{3}}⟨x+y,\\,y,\\,x⟩\\cdot ⟨-1,\\,-1,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{3}}(-(x+y)-y+x) \\\\  & =\\frac{1}{\\sqrt{3}}(-2y) \\\\  & =-\\frac{2}{\\sqrt{3}}\\,y.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}(-\\frac{2}{\\sqrt{3}}\\,y)\\,\\text{d}S \\\\  & ={∬}_{D}(-\\frac{2}{\\sqrt{3}}\\,y)\\cdot ||{r}_{x}\\times {r}_{y}||\\,\\text{d}A \\\\  & ={∬}_{D}-\\frac{2}{\\sqrt{3}}y\\cdot \\sqrt{3}\\,\\text{d}A \\\\  & ={∬}_{D}-\\frac{2}{\\cancel{\\sqrt{3}}}y\\cdot \\cancel{\\sqrt{3}}\\,\\text{d}A \\\\  & ={∬}_{D}-2y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}-2y\\,\\text{d}x\\,\\text{d}y \\\\  & =-{\\int }_{0}^{1}2y\\,\\text{d}y\\cdot {\\int }_{0}^{3}\\,\\text{d}x \\\\  & =-[{y}^{2}]_{0}^{1}\\cdot [x]_{0}^{3} \\\\  & =-1\\cdot 3 \\\\  & =-3\\end{aligned}\n$$"} {:db/id 17592186445316 :knowledge-point/_questions [{:db/id 17592186138340 :knowledge-point/id #uuid "1c331171-b536-55c6-92d9-6d22b9200a05" :knowledge-point/title "Multiplying a Decimal by a Whole Number: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb55442-b865-5577-b007-562ca745e516" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "52.20" :db/id 17592186445301}] :answer-field/correct {:answer/id #uuid "5bb55442-b865-5577-b007-562ca745e516" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "52.20" :db/id 17592186445301} :answer-field/id #uuid "702a575b-0f02-5112-9f67-849c6e333818" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186445310}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43e5a6a2-9436-51e4-a444-4829716961e6" :question/math-academy-id "q-166772" :question/problem "Carmen, an experienced seamstress, bought $15\\,\\text{m}$ of drill fabric. The total she paid, expressed as a **decimal number**, was $$${{field-1}}." :question/worked-solution "To find out the amount of money that Carmen must pay, we need to multiply $15$ by $3.48.$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  &  & \\,\\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{4}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere are $2$ decimal places in $3.48.$ \nTherefore, the product will also have $2$ decimal places.\n\nSo, we take our value of $5220$ and add a decimal point to make a number with $2$ decimal places.\n\n$$\n52\\,\\overset{↓}{.}\\,\\,\\,{{20}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, Carmen must pay $$3.48\\times 15=$52.20.$"} {:db/id 17592186445532 :knowledge-point/_questions [{:db/id 17592186054791 :knowledge-point/id #uuid "d7162d23-7674-5319-9f00-ca1a37ecccd3" :knowledge-point/title "Collecting Groups of Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33cba437-e760-5519-bdf4-d21f5c0e761d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3a+b" :db/id 17592186445494} {:answer/id #uuid "5e816e39-d02c-5db5-bb2d-047453d59b2b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3a-b" :db/id 17592186445500} {:answer/id #uuid "a5fa73f6-4a68-5c06-b024-6dc3081af760" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "b" :db/id 17592186445511} {:answer/id #uuid "ef7757a9-ae0e-5f4b-a0b3-c610d16948b7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3a+3b" :db/id 17592186445515} {:answer/id #uuid "fc2716f5-2b1d-5514-a35d-147757e3e939" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3b" :db/id 17592186445516}] :answer-field/correct {:answer/id #uuid "33cba437-e760-5519-bdf4-d21f5c0e761d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3a+b" :db/id 17592186445494} :answer-field/id #uuid "78285ed0-6178-5d34-a498-f63bd57059fe" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186445522}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59eaa740-2224-50f3-a29a-b209a5484302" :question/math-academy-id "q-690" :question/problem "$a+2b+2a-b=$" :question/worked-solution "First, we group the like terms.\n\n$$\n\\begin{aligned}a+2b+2a-b & = \\\\ {{a+2a}_{⏟}}_{a\\text{ terms}}+{{2b-b}_{⏟}}_{b\\text{ terms}} & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}{a+2a}_{⏟}+{2b-b}_{⏟} & = \\\\ (1+2)a+(2-1)b & = \\\\ 3a+b\\end{aligned}\n$$"} {:db/id 17592186445534 :knowledge-point/_questions [{:db/id 17592186054790 :knowledge-point/id #uuid "342e8283-f3a1-5923-8788-1a489ae058c5" :knowledge-point/title "Rearranging an Expression Before Collecting Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bc47146-c30b-53b8-852a-cdd2ce11f06a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186445497}] :answer-field/correct {:answer/id #uuid "4bc47146-c30b-53b8-852a-cdd2ce11f06a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186445497} :answer-field/id #uuid "b2dadc67-3c27-538b-8057-178462eed39d" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186445526} {:answer-field/choices [{:answer/id #uuid "03020098-2f04-5972-97b6-5ee20b95ec3b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id 17592186445489}] :answer-field/correct {:answer/id #uuid "03020098-2f04-5972-97b6-5ee20b95ec3b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id 17592186445489} :answer-field/id #uuid "c581f3b2-e175-5b06-baa8-94ffb33fd775" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186445528}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77366c00-a15b-5f37-b0cb-471f787df0a0" :question/math-academy-id "q-173710" :question/problem "$8a+3b+11a=${{field-1}}\n$a\\,+$\n{{field-2}}\n$b$" :question/worked-solution "We rearrange the terms so that the like terms, $8a$ and $11a$, are together.\n\n$$\n\\begin{aligned}8a+3b+11a & = \\\\ {{8a+11a}_{⏟}}_{a\\text{ terms}}+3b & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}{8a+11a}_{⏟}\\,+\\,3b & = \\\\ (8+11)a+3b & = \\\\ 19\\,a+3\\,b\\end{aligned}\n$$"} {:db/id 17592186445535 :knowledge-point/_questions [{:db/id 17592186054791 :knowledge-point/id #uuid "d7162d23-7674-5319-9f00-ca1a37ecccd3" :knowledge-point/title "Collecting Groups of Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a80ec14-c5c5-55c2-80b1-e3b7562ca1d3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186445508}] :answer-field/correct {:answer/id #uuid "9a80ec14-c5c5-55c2-80b1-e3b7562ca1d3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186445508} :answer-field/id #uuid "62a0af8f-8e02-5c6b-a1a7-8d23d275c577" :answer-field/key "field-3" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186445519} {:answer-field/choices [{:answer/id #uuid "b8b32b6f-8de9-5ca4-ad9b-1ec1a629ac7c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186445512}] :answer-field/correct {:answer/id #uuid "b8b32b6f-8de9-5ca4-ad9b-1ec1a629ac7c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186445512} :answer-field/id #uuid "6f9efb7c-58a6-5777-ab43-e926be9df661" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186445520} {:answer-field/choices [{:answer/id #uuid "e0586283-fcd6-5baf-8084-46357138e444" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186445514}] :answer-field/correct {:answer/id #uuid "e0586283-fcd6-5baf-8084-46357138e444" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186445514} :answer-field/id #uuid "d1e2f42c-3c82-55ed-9f00-993769813d0d" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186445529}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7905141b-131b-5e75-9f8a-02832316e158" :question/math-academy-id "q-178261" :question/problem "$2x+4y+5x-2y-4=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y\\,-$\n{{field-3}}" :question/worked-solution "First, we group the like terms.\n\n$$\n\\begin{aligned}2x+4y+5x-2y-4 & = \\\\ {{2x+5x}_{⏟}}_{x\\text{ terms}}+{{4y-2y}_{⏟}}_{y\\text{ terms}}-4 & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}{2x+5x}_{⏟}\\,+\\,{4y-2y}_{⏟}\\,-\\,4 & = \\\\ (2+5)x+(4-2)y-4 & = \\\\ 7\\,x+2\\,y-4 & \\end{aligned}\n$$"} {:db/id 17592186446984 :knowledge-point/_questions [{:db/id 17592186142780 :knowledge-point/id #uuid "34ea56b4-2066-5aaf-aea9-08515803fc0b" :knowledge-point/title "Evaluating an Expression With Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bdcad11-7d8a-5421-ab94-72922785ccc2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186446969}] :answer-field/correct {:answer/id #uuid "8bdcad11-7d8a-5421-ab94-72922785ccc2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186446969} :answer-field/id #uuid "4e040745-c5bf-5561-ae45-d4994de16a35" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186446977}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c9c8087-b061-507e-9fec-13a0e9bcaffe" :question/math-academy-id "q-134224" :question/problem "Maria, Esther, and Albert each bought $1$ pound of canary seed and $3$ pounds of sunflower seeds. In total, they bought{{field-1}}\n pounds of seeds." :question/worked-solution "We must write and evaluate an expression representing the total number of pounds of seeds.\n\nSince each of them bought a pound of canary seed and $3$ pounds of sunflower seeds, the number of pounds each person bought is:\n\n$$\n{{1}_{⏟}}_{\\text{canary seeds}}+{{3}_{⏟}}_{\\text{sunflower seeds}}\n$$\n\nSince *each* person purchased this amount of seeds, and there are $3$ people, we must multiply the number of pounds of seeds by $3.$ Therefore, the total amount of seeds is:\n\n$$\n{{(1+3)}_{⏟}}_{\\text{each person}}\\times {{3}_{⏟}}_{\\text{people}}\n$$\n\nTo evaluate the expression, we follow the order of operations with parentheses.\n\nFirst, we perform the operations inside the parentheses:\n\n$$\n\\begin{aligned}(1+3)\\times 3 & =(1+3)\\times 3 \\\\  & =4\\times 3.\\end{aligned}\n$$\n\nNow, we multiply:\n\n$$\n4\\times 3=12\n$$"} {:db/id 17592186459287 :knowledge-point/_questions [{:db/id 17592186101024 :knowledge-point/id #uuid "cd9167b4-572f-589f-9b94-b62ba57eb28f" :knowledge-point/title "Finding the Average Value of a Function Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da595137-9f37-5a27-a95e-0bbab8d76644" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id 17592186459011}] :answer-field/correct {:answer/id #uuid "da595137-9f37-5a27-a95e-0bbab8d76644" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id 17592186459011} :answer-field/id #uuid "63fd8625-d5b1-5940-80d0-afc4cdf67f3a" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186459127}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdb68157-b846-5747-a6b0-cb5c936a1bd6" :question/math-academy-id "q-344714" :question/problem "![](images/9d/9d12008688f8cded02aff352773323ce6b4b8a978746b720ebcba319b7b71598.png)\n\nThe graph of the function $f(x),$ which is defined on $[-5,5],$ is shown above. It consists of line segments.\n\nFind the average value ${f}_{\\text{avg}}$ of $f(x)$ on $[-4,4].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" :question/worked-solution "The average value of a function on a given interval $[a,b]$ is \n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{-4}^{4}f(x)\\,\\text{d}x={{{\\int }_{-4}^{0}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{1}}+{{{\\int }_{0}^{4}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-4,0].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{-4}^{0}f(x)\\,\\text{d}x=-{A}_{1}=-4.\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [0,4].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 3 \\\\  & =6.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{0}^{4}f(x)\\,\\text{d}x=-{A}_{2}=-6.\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-4}^{4}f(x)\\,\\text{d}x & =-{A}_{1}-{A}_{2} \\\\  & =-4-6 \\\\  & =-10.\\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{4-(-4)}\\cdot (-10) \\\\  & =-\\frac{10}{8} \\\\  & =-\\frac{5}{4}.\\end{aligned}\n$$"} {:db/id 17592186459291 :knowledge-point/_questions [{:db/id 17592186101024 :knowledge-point/id #uuid "cd9167b4-572f-589f-9b94-b62ba57eb28f" :knowledge-point/title "Finding the Average Value of a Function Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ecb5918-3d7d-5d46-aea0-d35f67d99fae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186458650} {:answer/id #uuid "29ae6d76-d2c2-5b42-944d-501a1cafa8d7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186458709} {:answer/id #uuid "7958ae5e-bfba-588f-b79a-c87119da97f9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186458844} {:answer/id #uuid "d06d36be-6e65-539b-8210-637fe9bacd84" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186458990} {:answer/id #uuid "e7861b90-a5d1-521a-ba77-33defd93a904" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186459032}] :answer-field/correct {:answer/id #uuid "7958ae5e-bfba-588f-b79a-c87119da97f9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186458844} :answer-field/id #uuid "3a9c7ed5-2f6c-5ddc-a8f5-9cd3c9b0398b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186459115}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4039708-ee8a-57dd-b312-f84f190dda62" :question/math-academy-id "q-18135" :question/problem "![](images/cc/cc31e5e85263f5a08a10c73c76cf5ba5eec2c27195159da31ef96a614efba7ed.png)\n\nThe graph of the function $f(x),$ which is defined on $[-2,4],$ is shown above. It consists of three line segments. Find the average value of $f(x)$ on $[-2,4].$" :question/worked-solution "The average value of a function on a given interval $[a,b]$ is\n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{-2}^{4}f(x)\\,\\text{d}x={{{\\int }_{-2}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{1}^{4}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,1].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 3\\cdot 2 \\\\  & =3.\\end{aligned}\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,4].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 3\\cdot 2 \\\\  & =3.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{1}^{4}f(x)\\,\\text{d}x=-{A}_{2}=-3.\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{4}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2} \\\\  & =3-3 \\\\  & =0.\\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{4-(-2)}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"} {:db/id 17592186475917 :knowledge-point/_questions [{:db/id 17592186133739 :knowledge-point/id #uuid "4cb81a65-ae88-591a-bb87-0ecb7124b154" :knowledge-point/title "Calculating the Cube of a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32ef51bc-955a-5135-8645-81cf0166440e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-64000" :db/id 17592186475511}] :answer-field/correct {:answer/id #uuid "32ef51bc-955a-5135-8645-81cf0166440e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-64000" :db/id 17592186475511} :answer-field/id #uuid "57aa9dd1-408d-5e08-ba80-bbf97617e764" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186475860}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11153da4-48d0-5e46-974b-c9f9e9d4e7ed" :question/math-academy-id "q-186262" :question/problem "${(-40)}^{3}=${{field-1}}" :question/worked-solution "To work out ${(-40)}^{3},$ we multiply $-40$ by itself and then multiply the result by $-40$ again:\n\n$$\n\\begin{aligned}(-40)^{3} & =\\overset{1\\,600}{\\overset{⏞}{(-40)\\cdot (-40)}}\\cdot (-40) \\\\  & =1\\,600\\cdot (-40) \\\\  & =-64\\,000\\end{aligned}\n$$"} {:db/id 17592186475936 :knowledge-point/_questions [{:db/id 17592186133739 :knowledge-point/id #uuid "4cb81a65-ae88-591a-bb87-0ecb7124b154" :knowledge-point/title "Calculating the Cube of a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39347fe7-7745-59cc-af83-c15236c6751d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,000" :db/id 17592186475521} {:answer/id #uuid "3d661792-8abd-5cd9-ac93-6f6eaad62326" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,000" :db/id 17592186475529} {:answer/id #uuid "6b27e888-6af5-537a-b724-07bce5c7a7b3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-16\\,000" :db/id 17592186475598} {:answer/id #uuid "74023d65-eba9-5f2c-9d76-47d2a1b8b818" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,000" :db/id 17592186475609} {:answer/id #uuid "95e00ac1-efcc-578e-aa97-3b40172b16ea" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\,000" :db/id 17592186475666}] :answer-field/correct {:answer/id #uuid "74023d65-eba9-5f2c-9d76-47d2a1b8b818" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,000" :db/id 17592186475609} :answer-field/id #uuid "b6bf6f2e-a197-5159-a8ee-37250a584257" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186475881}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b7f00c3-bb1b-59ab-b7ad-729a50e10070" :question/math-academy-id "q-99897" :question/problem "${(-20)}^{3}=$" :question/worked-solution "To work out ${(-20)}^{3},$ we multiply $-20$ by itself and then multiply the result by $-20$ again:\n\n$$\n\\begin{aligned}(-20)^{3} & =\\overset{400}{\\overset{⏞}{(-20)\\cdot (-20)}}\\cdot (-20) \\\\  & =400\\cdot (-20) \\\\  & =-8\\,000\\end{aligned}\n$$"} {:db/id 17592186475940 :knowledge-point/_questions [{:db/id 17592186054842 :knowledge-point/id #uuid "40e41bd9-1eee-552d-8507-e8cdf50ddfa4" :knowledge-point/title "Expressing a Product Using an Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295d7cb2-c41d-5562-9627-6496a886b48e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{8}{3})}^{4}" :db/id 17592186475497} {:answer/id #uuid "3d55582d-c167-5af8-9b20-b189409d9555" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{12}{24})}^{4}" :db/id 17592186475528} {:answer/id #uuid "8e02d7ce-4d35-5d10-8941-b9e49476be78" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{8})" :db/id 17592186475657} {:answer/id #uuid "ea43961e-5665-55b5-af85-109b62d090bb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{9}{64})}^{4}" :db/id 17592186475803} {:answer/id #uuid "f5295237-0532-5388-98f4-1f1ab70a871a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{3}{8})}^{4}" :db/id 17592186475818}] :answer-field/correct {:answer/id #uuid "f5295237-0532-5388-98f4-1f1ab70a871a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{3}{8})}^{4}" :db/id 17592186475818} :answer-field/id #uuid "5872048b-a786-5fc6-96af-eb26baac894e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186475861}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6455f903-95ba-56a7-8ef0-339948a725c9" :question/math-academy-id "q-75533" :question/problem "$(-\\frac{3}{8})\\times (-\\frac{3}{8})\\times (-\\frac{3}{8})\\times (-\\frac{3}{8})=$" :question/worked-solution "The number $(-\\frac{3}{8})$ is multiplied 