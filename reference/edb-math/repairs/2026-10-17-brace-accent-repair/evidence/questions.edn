 {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495680}] :answer-field/correct {:answer/id #uuid "12345e4a-d887-537f-b77e-dad11466435e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186495551} :answer-field/id #uuid "1c280642-33c4-5bed-b4d3-b3f46ad0d1a8" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186496087} {:answer-field/choices [{:answer/id #uuid "493e6d2e-e984-5db7-8e87-4c3e03dcd6c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186495678} {:answer/id #uuid "91f2d60f-5b20-5249-b392-f82fcb256770" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495831}] :answer-field/correct {:answer/id #uuid "91f2d60f-5b20-5249-b392-f82fcb256770" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495831} :answer-field/id #uuid "55ff92d9-197d-537e-a612-7fa2b44af8b2" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186496118} {:answer-field/choices [{:answer/id #uuid "84f1d02d-fab2-534e-ac78-73d235fea8dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186495797} {:answer/id #uuid "bcaa3233-b273-5d33-96e5-df8a354675a8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495926}] :answer-field/correct {:answer/id #uuid "84f1d02d-fab2-534e-ac78-73d235fea8dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186495797} :answer-field/id #uuid "d153c1d9-5604-5d8d-a941-1ffa64d648ba" :answer-field/key "field-3" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186496185}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbfbaab7-10b5-57a8-a26d-3c15f79b1087" :question/math-academy-id "q-175930" :question/problem "$$\n{{\\overset{P}{\\overset{⏞}{\\{1,2\\}\\cup \\{2\\}=\\{1,2\\}}}\\,\\overset{∨}{\\overset{⏞}{\\text{or}}}\\,\\overset{Q}{\\overset{⏞}{11\\text{ is prime}}}}_{⏟}}_{P\\,∨\\,Q}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{2\\text{ is a perfect square}}_{⏟}}_{R}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $P∨Q$ is {{field-1}},\n$\\,$ $R$ is {{field-2}},\n$\\,$ $(P∨Q)∧R$ is {{field-3}}." :question/worked-solution "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $P$ is true, $Q$ is true, and $R$ is false. Therefore, $P∨Q$ is true, but the result is false:\n\n$$\n\\begin{aligned}(P∨Q)∧R & ≡\\overset{\\text{true}}{\\overset{⏞}{(\\text{true}∨\\text{true})}}∧\\text{false} \\\\  & ≡\\text{true}∧\\text{false} \\\\  & ≡\\text{false}\\end{aligned}\n$$"} {:db/id 17592186496309 :knowledge-point/_questions [{:db/id 17592186054643 :knowledge-point/id #uuid "49ab93ca-16ca-5e57-835f-036b59f25d63" :knowledge-point/title "Finding Truth Values of Compound Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "437c25a0-ffe2-5cb2-ab86-2abe4f8570ca" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495664} {:answer/id #uuid "835af782-c34f-5315-831c-d2d73ce3599a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186495792}] :answer-field/correct {:answer/id #uuid "437c25a0-ffe2-5cb2-ab86-2abe4f8570ca" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495664} :answer-field/id #uuid "5c291b0e-f8c9-5939-a96e-0401075ed43c" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186496120} {:answer-field/choices [{:answer/id #uuid "0363b271-e803-5571-b53d-239e604590f1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495519} {:answer/id #uuid "cc4cb860-21b2-51d4-b70c-b8f24038b22b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186495953}] :answer-field/correct {:answer/id #uuid "0363b271-e803-5571-b53d-239e604590f1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495519} :answer-field/id #uuid "a5302458-71fb-5afb-a950-a7024e57aebf" :answer-field/key "field-3" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186496156} {:answer-field/choices [{:answer/id #uuid "2ea973ca-4c0d-5900-a76d-4213928289f8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186495618} {:answer/id #uuid "374c1b92-a065-5d73-84bd-e768c04e2423" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495639}] :answer-field/correct {:answer/id #uuid "374c1b92-a065-5d73-84bd-e768c04e2423" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186495639} :answer-field/id #uuid "c45c4194-12b2-5fe5-9c77-c08f6af56cd8" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186496174}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c586014f-8b0b-5087-a740-57029ea9f0d3" :question/math-academy-id "q-175666" :question/problem "$$\n{{5\\text{ is odd}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{-5\\in Z}_{⏟}}_{B}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $A$ is {{field-1}},\n$\\,$ $B$ is {{field-2}},\n$\\,$ $A∨B$ is {{field-3}}." :question/worked-solution "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $A$ is true, and $B$ is true. Therefore, the result is true:\n\n$$\n\\begin{aligned}{{5\\text{ is odd}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{-5\\in Z}_{⏟}}_{B} & \\,\\,≡\\,\\text{true}∨\\text{true}≡\\text{true}\\end{aligned}\n$$"} {:db/id 17592186496313 :knowledge-point/_questions [{:db/id 17592186054641 :knowledge-point/id #uuid "93bc0caa-2352-5d02-9ccf-7267dff4be2c" :knowledge-point/title "Expressing Compound Statements in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88911721-9caf-5241-b5ba-5af57e949852" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "P" :db/id 17592186495805} {:answer/id #uuid "901c3b3b-9f68-5e41-9761-d7d73ac85dfb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "∧" :db/id 17592186495827} {:answer/id #uuid "dd760021-393c-59e1-b51e-32da763bff33" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "∨" :db/id 17592186495999}] :answer-field/correct {:answer/id #uuid "88911721-9caf-5241-b5ba-5af57e949852" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "P" :db/id 17592186495805} :answer-field/id #uuid "2c15a5ea-6fbb-5554-b167-3feb951f48f5" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186496093} {:answer-field/choices [{:answer/id #uuid "1e748ae9-9a3f-5614-b6bc-f2ee460795e4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "P" :db/id 17592186495576} {:answer/id #uuid "767dfd7f-44cf-5e87-a8e7-1723c4a3b904" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} 