math} :answer/value "-" :db/id 17592186289561}] :answer-field/correct {:answer/id #uuid "e65c882c-052a-58d9-bb18-2f752e467ea1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id 17592186289561} :answer-field/id #uuid "9aac0553-9dc7-5d7b-9738-5324975debc4" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186290074} {:answer-field/choices [{:answer/id #uuid "8ee12462-0d20-5f7b-8b0b-25f83043c1d0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3p}{2},4q" :db/id 17592186288988}] :answer-field/correct {:answer/id #uuid "8ee12462-0d20-5f7b-8b0b-25f83043c1d0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3p}{2},4q" :db/id 17592186288988} :answer-field/id #uuid "f35b1d49-ca69-5dca-b695-33de82de5b09" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186290235}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bc624a1f-1b58-5a12-9756-1a40ebf6c70a" :question/math-academy-id "q-216936" :question/problem "The midpoint of the line segment with endpoints $(-9p,3q)$ and $(6p,5q)$\n is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(-9p,3q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(6p,5q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-9p+6p}{2},\\frac{3q+5q}{2}) \\\\  & =(\\frac{-3p}{2},\\frac{8q}{2}) \\\\  & =(-\\frac{3p}{2},4q)\\end{aligned}\n$$"} {:db/id 17592186290350 :knowledge-point/_questions [{:db/id 17592186073714 :knowledge-point/id #uuid "58e2e40e-209b-5bc7-98df-11841c2bbcc3" :knowledge-point/title "Finding the Midpoint of a Segment With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62d860d4-9969-5b3f-a5f8-05df5bab25cc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4p" :db/id 17592186288723}] :answer-field/correct {:answer/id #uuid "62d860d4-9969-5b3f-a5f8-05df5bab25cc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4p" :db/id 17592186288723} :answer-field/id #uuid "54505da0-7d85-511d-9082-6005dc121606" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186289910} {:answer-field/choices [{:answer/id #uuid "8907f96d-60b6-565b-9452-eefecd8a5cb5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9q}{2}" :db/id 17592186288955}] :answer-field/correct {:answer/id #uuid "8907f96d-60b6-565b-9452-eefecd8a5cb5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9q}{2}" :db/id 17592186288955} :answer-field/id #uuid "a9a598c6-6c8b-5d41-b174-97a44daeeddc" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186290107}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3ec4ca5d-eff6-5bd3-b9ef-6440c83a0ef0" :question/math-academy-id "q-216937" :question/problem "The midpoint of the line segment with endpoints $(4p,2q)$ and $(-12p,7q)$\n is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(4p,2q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-12p,7q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{4p+(-12p)}{2},\\frac{2q+7q}{2}) \\\\  & =(\\frac{-8p}{2},\\frac{9q}{2}) \\\\  & =(-4p,\\frac{9q}{2})\\end{aligned}\n$$"} {:db/id 17592186292612 :knowledge-point/_questions [{:db/id 17592186073813 :knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bd86069-1b4a-5b24-b9f7-2433cb83b2af" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186291228}] :answer-field/correct {:answer/id #uuid "8bd86069-1b4a-5b24-b9f7-2433cb83b2af" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186291228} :answer-field/id #uuid "aff9074e-63a9-5156-8b4a-cba9e66096fd" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186292281}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea8b80f5-5852-58eb-a9f5-87a9a29aa672" :question/math-academy-id "q-262213" :question/problem "The distance between the points $A(-1,4,-1)$ and $B(2,6,5)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(-1,4,-1)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(2,6,5)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(2-(-1){)}^{2}+(6-4{)}^{2}+(5-(-1){)}^{2}} \\\\  & =\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}} \\\\  & =\\sqrt{9+4+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"} {:db/id 17592186292613 :knowledge-point/_questions [{:db/id 17592186073813 :knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f915bfe-4a2c-54ce-8b1c-681017d22c8f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186291326}] :answer-field/correct {:answer/id #uuid "9f915bfe-4a2c-54ce-8b1c-681017d22c8f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186291326} :answer-field/id #uuid "484c534d-c8af-5196-86a2-ebd86bbf6ec8" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186291966}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c45e8a35-554d-5362-9dc0-c76aa841bc0c" :question/math-academy-id "q-262216" :question/problem "The distance between the points $A(5,-2,-3)$ and $B(2,2,-3)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(5,-2,-3)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(2,2,-3)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(2-5{)}^{2}+(2-(-2){)}^{2}+(-3-(-3){)}^{2}} \\\\  & =\\sqrt{(-3{)}^{2}+{4}^{2}+{0}^{2}} \\\\  & =\\sqrt{9+16+0} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"} {:db/id 17592186292614 :knowledge-point/_questions [{:db/id 17592186073813 :knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a51c24-9e48-5dd8-a285-6a6c64b8aaac" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id 17592186290865}] :answer-field/correct {:answer/id #uuid "38a51c24-9e48-5dd8-a285-6a6c64b8aaac" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id 17592186290865} :answer-field/id #uuid "3245847b-5278-5299-8f8d-bfaabbe9342c" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186291903}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e16c5fb0-60f5-53f8-bf40-4b5cf72b5d57" :question/math-academy-id "q-262221" :question/problem "The distance between the points $A(3,1,2)$ and $B(5,-3,4)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nIn this case, we have $A{{(3,1,2)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(5,-3,4)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(5-3)^{2}+(-3-1)^{2}+(4-2)^{2}} \\\\  & =\\sqrt{{2}^{2}+(-4)^{2}+{2}^{2}} \\\\  & =\\sqrt{4+16+4} \\\\  & =\\sqrt{24} \\\\  & =2\\sqrt{6}.\\end{aligned}\n$$"} {:db/id 17592186292615 :knowledge-point/_questions [{:db/id 17592186073813 :knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b117b5c6-f1c2-5ef7-a45b-f5d8047463c5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id 17592186291403}] :answer-field/correct {:answer/id #uuid "b117b5c6-f1c2-5ef7-a45b-f5d8047463c5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id 17592186291403} :answer-field/id #uuid "74c64785-f0ae-58c8-8778-11cce9425723" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186292096}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36c96529-7715-55dd-9853-b5f7e1d65f9a" :question/math-academy-id "q-262223" :question/problem "The distance between the points $A(4,-2,-2)$ and $B(3,-4,2)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(4,-2,-2)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(3,-4,2)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(3-4{)}^{2}+(-4-(-2){)}^{2}+(2-(-2){)}^{2}} \\\\  & =\\sqrt{(-1{)}^{2}+(-2{)}^{2}+{4}^{2}} \\\\  & =\\sqrt{1+4+16} \\\\  & =\\sqrt{21}.\\end{aligned}\n$$"} {:db/id 17592186292718 :knowledge-point/_questions [{:db/id 17592186054805 :knowledge-point/id #uuid "cd03f31e-360e-5cc1-9118-f71f813d572e" :knowledge-point/title "Factoring a Quartic Polynomial With Only Two Real Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8727f0f6-ab35-52da-a633-a22f01cc6e94" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-3x+8" :db/id 17592186291209}] :answer-field/correct {:answer/id #uuid "8727f0f6-ab35-52da-a633-a22f01cc6e94" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-3x+8" :db/id 17592186291209} :answer-field/id #uuid "817f7429-6163-58c5-814c-211579740270" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186292134}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fd39389-dd69-52d2-8d61-181abc3b2657" :question/math-academy-id "q-270972" :question/problem "Find the polynomial $P(x)$ given that $2{x}^{4}-7{x}^{3}-34{x}^{2}+56x-192=(x+4)(x-6)P(x).$\n\n$P(x)=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2{x}^{4}-7{x}^{3}-34{x}^{2}+56x-192.$ We know that $(x+4)$ and $(x-6)$ are factors of $f(x),$ and we need to find its other factors.\n\nBecause $(x+4)$ is a factor of $f(x),$ we know that $(x+4)$ divides $f(x)$ with no remainder. So, to begin factoring $f(x),$ we can divide it by $(x+4)$ using synthetic division:\n\n|  | ${x}^{4}$ | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- | --- |\n| $-4$ | $2$ | $-7$ | $-34$ | $56$ | $-192$ |\n|  | $↓$ | $-8$ | $60$ | $-104$ | $192$ |\n|  | $2$ | $-15$ | $26$ | $-48$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{2{x}^{4}-7{x}^{3}-34{x}^{2}+56x-192}{x+4}=2{x}^{3}-15{x}^{2}+26x-48,\n$$\n\nwhich means that\n\n$$\n2{x}^{4}-7{x}^{3}-34{x}^{2}+56x-192=(x+4)(2{x}^{3}-15{x}^{2}+26x-48).\n$$\n\nNow, because $(x-6)$ is also a factor of $f(x),$ it must be a factor of the quotient $(2{x}^{3}-15{x}^{2}+26x-48).$ So, we divide this quotient by $(x-6)$ using synthetic division once more:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $6$ | $2$ | $-15$ | $26$ | $-48$ |\n|  | $↓$ | $12$ | $-18$ | $48$ |\n|  | $2$ | $-3$ | $8$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{2{x}^{3}-15{x}^{2}+26x-48}{x-6}=2{x}^{2}-3x+8,\n$$\n\nwhich means that\n\n$$\n\\begin{aligned}2{x}^{4}-7{x}^{3}-34{x}^{2}+56x-192 & =(x+4)(x-6)(2{x}^{2}-3x+8)\\end{aligned}\n$$\n\nTo see whether the quadratic polynomial $2{x}^{2}-3x+8$ can be factored any further, we calculate its discriminant:\n\n$$\n{b}^{2}-4ac=(-3)^{2}-4(2)(8)=-55<0\n$$\n\nSo, the quadratic polynomial $2{x}^{2}-3x+8$ cannot be factored over the real numbers since its discriminant is negative. \n\nTherefore, the full factorization of $f(x)$ over the real numbers is given by \n\n$$\n2{x}^{4}-7{x}^{3}-34{x}^{2}+56x-192=(x+4)(x-6){{(2{x}^{2}-3x+8)}_{⏟}}_{P(x)}.\n$$\n\nFinally, $P(x)=2{x}^{2}-3x+8.$"} {:db/id 17592186297449 :knowledge-point/_questions [{:db/id 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9953dc9-2c7d-5852-ad69-5e764720a070" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id 17592186296241}] :answer-field/correct {:answer/id #uuid "b9953dc9-2c7d-5852-ad69-5e764720a070" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id 17592186296241} :answer-field/id #uuid "ee27c5da-d51f-54b3-b216-3b6dbb4ee380" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186297123}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6302582-812c-5f14-9dac-2aabed1d56fa" :question/math-academy-id "q-316122" :question/problem "![](images/64/64ce1ae5f198ce41e55414d853b1bd99e73d747cddb80412b30246bfdb13a907.png)\n\nThe graph of $y=f(x),$ shown above, consists of two line segments. Then,\n\n${\\int }_{-3}^{4}f(x)\\,\\text{d}x=$\n{{field-1}}." :question/worked-solution "The graph consists of two parts: the line segment for $x\\in [-3,1)$ and the line segment for $x\\in (1,4].$ Therefore, we can write the required integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{4}f(x)\\,\\text{d}x\\,= & {\\int }_{-3}^{1}f(x)\\,\\text{d}x\\,+{\\int }_{1}^{1}f(x)\\,\\text{d}x\\,+\\,{\\int }_{1}^{4}f(x)\\,\\text{d}x \\\\ {\\int }_{-3}^{4}f(x)\\,\\text{d}x\\,= & \\,{{{\\int }_{-3}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}\\,+\\,{{{\\int }_{1}^{4}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}\\end{aligned}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,1).$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}\\,bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 4 \\\\  & =8.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in (1,4].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\,bh \\\\  & =\\frac{1}{2}\\cdot 3\\cdot 4 \\\\  & =6.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-3}^{4}f(x)\\,\\text{d}x\\, & =\\,{A}_{1}+{A}_{2} \\\\  & =\\,8+6 \\\\  & =\\,14.\\end{aligned}\n$$"} {:db/id 17592186297451 :knowledge-point/_questions [{:db/id 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89600ee-2da7-5468-ad6a-bf2909f0e8eb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id 17592186296233}] :answer-field/correct {:answer/id #uuid "b89600ee-2da7-5468-ad6a-bf2909f0e8eb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id 17592186296233} :answer-field/id #uuid "ae4e0025-0a6f-572e-8335-324e6ee2568a" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186297001}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbb60ffa-14d6-5751-913f-1131a36b5e4d" :question/math-academy-id "q-316132" :question/problem "![](images/b8/b871a949beaac0319d77364c43aa261bda8c28642f8bfc80a80f974fd7323cf3.png)\n\nThe graph $y=f(x),$ shown above, consists of two line segments. Then,\n\n${\\int }_{-2}^{3}f(x)\\,\\text{d}x=$\n{{field-1}}." :question/worked-solution "We divide the interval of integration into $3$ regions: the line segment for $x\\in [-2,-1],$ the line segment for $x\\in [-1,1),$ and the line segment for $x\\in [1,3].$ Therefore, we can write the required integral as follows:\n\n$$\n{\\int }_{-2}^{3}f(x)\\,\\text{d}x={{{\\int }_{-2}^{-1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{-1}^{1}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{2}}+{{{\\int }_{1}^{3}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{3}}.\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,-1].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(1\\cdot 1) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-1,1).$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{-1}^{1}f(x)\\,\\text{d}x=-{A}_{2}=-2.\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,3].$ The corresponding region is a square, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & ={s}^{2} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}+{A}_{3} \\\\  & =\\frac{1}{2}-2+4 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} {:db/id 17592186297456 :knowledge-point/_questions [{:db/id 17592186064320 :knowledge-point/id #uuid "9a8be4bb-bbfe-5a5d-872c-91b4d67edc2f" :knowledge-point/title "Applications of Accumulation Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caef1662-b802-571e-94e7-2100591edec6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "180+0.5{t}^{2}+3t" :db/id 17592186296330}] :answer-field/correct {:answer/id #uuid "caef1662-b802-571e-94e7-2100591edec6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "180+0.5{t}^{2}+3t" :db/id 17592186296330} :answer-field/id #uuid "d5a317d8-cf34-5d96-bff6-63043ecb3677" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186297078}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8f85d18-c70d-5c3e-acb8-1dd6b68eae84" :question/math-academy-id "q-316254" :question/problem "In $2005$, a group of scientists started tracking the population of sea turtles in a coastal sanctuary. The initial population was $180,$ and the birth and death rates are given by $4+1.5t$ and $1+0.5t,$ respectively, where $t$ is the number of years since $2005.$  \n\nFind an expression for the population $P(t)$ of sea turtles in the sanctuary at any time $t>0.$\n\n$P(t)=$\n{{field-1}}" :question/worked-solution "Let $p(t)$ be the rate of change of the population. According to the given information,\n\n$$\np(t)={{4+1.5t}_{⏟}}_{\\text{population increase}}-{{(1+0.5t)}_{⏟}}_{\\text{population decrease}}=t+3.\n$$\n\nLet $P(T)$ represent the population of turtles $T$ years after $2005.$ By the accumulation of change formula, we have\n\n$$\nP(T)=P(0)+{\\int }_{0}^{T}p(t)\\,\\text{d}t.\n$$\n\nSubstituting the known information and carrying out the necessary integration gives\n\n$$\n\\begin{aligned}P(T) & =P(0)+{\\int }_{0}^{T}p(t)\\,\\text{d}t \\\\  & =180+{\\int }_{0}^{T}(t+3)\\,\\text{d}t \\\\  & =180+(\\frac{1}{2}{t}^{2}+3t){|}_{0}^{T} \\\\  & =180+\\frac{1}{2}{T}^{2}+3T.\\end{aligned}\n$$\n\nFinally, let's rewrite our final answer in terms of the original variable  $t.$ We get \n\n$$\nP(t)=180+\\frac{1}{2}{t}^{2}+3t.\n$$"} {:db/id 17592186297457 :knowledge-point/_questions [{:db/id 17592186078599 :knowledge-point/id #uuid "fb30dbbf-4f83-59d0-b712-f0e592aafb27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Curved Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b5c61b-9655-552f-ac09-7fc05f32384f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi +9}{2}" :db/id 17592186295505}] :answer-field/correct {:answer/id #uuid "29b5c61b-9655-552f-ac09-7fc05f32384f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi +9}{2}" :db/id 17592186295505} :answer-field/id #uuid "a9d42887-bd7b-5093-9106-9460fec8d94a" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186296993}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53c80807-8464-558f-b4e9-61601f18a79a" :question/math-academy-id "q-316261" :question/problem "![](images/d3/d36f2859865da58d226a738d8338f726df950db75b7421b604bb692c9049d54a.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n${\\int }_{-4}^{1}f(x)\\,\\text{d}x=$\n{{field-1}}." :question/worked-solution "The graph consists of $2$ parts: the arc of the semi-circle for $x\\in [-4,-2]$ and the line segment for $x\\in (-2,1].$ So, we can use the additive property of integrals to get\n\n$$\n\\begin{aligned}{\\int }_{-4}^{1}f(x)\\,\\text{d}x={{{\\int }_{-4}^{-2}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{-2}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}.\\end{aligned}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-4,-2].$ The corresponding region is a semi-circle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot (1)^{2} \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in (-2,1].$ The corresponding region is a trapezoid, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(a+b)h \\\\  & =\\frac{1}{2}(2+1)\\cdot 3 \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-4}^{1}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =\\frac{\\pi }{2}+\\frac{9}{2} \\\\  & =\\frac{\\pi +9}{2}.\\end{aligned}\n$$"} {:db/id 17592186297462 :knowledge-point/_questions [{:db/id 17592186101024 :knowledge-point/id #uuid "cd9167b4-572f-589f-9b94-b62ba57eb28f" :knowledge-point/title "Finding the Average Value of a Function Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4f22f82-3f4c-56a7-8fca-b1699296b03b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi -4}{16}" :db/id 17592186296486}] :answer-field/correct {:answer/id #uuid "e4f22f82-3f4c-56a7-8fca-b1699296b03b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi -4}{16}" :db/id 17592186296486} :answer-field/id #uuid "f5ebfc2e-32f9-5714-a71a-21c80776c9ec" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186297137}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e5a2c9b-15eb-580e-9b48-bc6a0c515d66" :question/math-academy-id "q-316309" :question/problem "![](images/1c/1c69b5a43e445861a728fcd8faed9e89b3bcb61141ad35d99e60f2a43983244d.png)\n\nThe graph of the function $f(x),$ which is defined on $[-2,9],$ is shown above. It consists of three line segments and the arc of the semi-circle centered at $(5,0)$ with radius $3.$ \n\nFind the average value ${f}_{\\text{avg}}$ of $f(x)$ on $[0,8].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" :question/worked-solution "The average value of a function on a given interval $[a,b]$ is \n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{0}^{8}f(x)\\,\\text{d}x={{{\\int }_{0}^{2}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{1}}+{{{\\int }_{2}^{8}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [0,2].$ The corresponding region is a right triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{0}^{2}f(x)\\,\\text{d}x=-{A}_{1}=-2.\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [2,8].$ The corresponding region is a semi-circle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot {3}^{2} \\\\  & =\\frac{9\\pi }{2}.\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{8}f(x)\\,\\text{d}x & =-{A}_{1}+{A}_{2} \\\\  & =-2+\\frac{9\\pi }{2}.\\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{8-0}\\cdot (-2+\\frac{9\\pi }{2}) \\\\  & =-\\frac{1}{4}+\\frac{9\\pi }{16} \\\\  & =\\frac{-4+9\\pi }{16} \\\\  & =\\frac{9\\pi -4}{16}.\\end{aligned}\n$$"} {:db/id 17592186299672 :knowledge-point/_questions [{:db/id 17592186100850 :knowledge-point/id #uuid "3f41b2bd-0c1d-5267-b91d-7aba35ea7efd" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff8083fc-1c95-550c-ba02-c4f9d8d8cea2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id 17592186298644}] :answer-field/correct {:answer/id #uuid "ff8083fc-1c95-550c-ba02-c4f9d8d8cea2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id 17592186298644} :answer-field/id #uuid "b1adf289-d217-5847-bd5d-b2d7420e8453" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186299239}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f931cf9f-2dac-54ec-8d65-3efbaae6ccc0" :question/math-academy-id "q-318223" :question/problem "![](images/55/551c38c3bedd56d8fc1c4fef9f1fcc15b9fbf6fa83af81253b7a4d2296aaeb38.png)\n\nConsider the graph of the function $y=f(x),$ shown above. It consists of five line segments. Find the value of \n${\\int }_{-4}^{6}f(x)\\,\\text{d}x.$\n\n${\\int }_{-4}^{6}f(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "The graph consists of $3$ parts: the line segment for $x\\in [-4,-1]$, the line segment for $x\\in [-1,1]$, the three line segments for $x\\in [1,6].$ Therefore, we can write the integral as follows:\n\n$$\n{\\int }_{-4}^{6}f(x)\\,\\text{d}x={{{\\int }_{-4}^{-1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{-1}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}+{{{\\int }_{1}^{6}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{3}}\n$$\n\nThe $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-4,-1].$ The corresponding region is a trapezoid, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(a+b)\\cdot h \\\\  & =\\frac{1}{2}(1+3)\\cdot 3 \\\\  & =6.\\end{aligned}\n$$\n\nThe $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-1,1].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}2\\cdot 3 \\\\  & =3.\\end{aligned}\n$$\n\nThe $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,6].$ The corresponding region is a trapezoid, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}(a+b)\\cdot h \\\\  & =\\frac{1}{2}(5+2)\\cdot 2 \\\\  & =7.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-4}^{6}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2}+{A}_{3} \\\\  & =6+3+7 \\\\  & =16.\\end{aligned}\n$$"} {:db/id 17592186299673 :knowledge-point/_questions [{:db/id 17592186100851 :knowledge-point/id #uuid "75f1ac34-ae96-53af-b8ae-d465af28f75d" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Nonlinear Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67fff17b-e32b-5109-899d-e0a14de50aee" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2+2\\pi " :db/id 17592186297999}] :answer-field/correct {:answer/id #uuid "67fff17b-e32b-5109-899d-e0a14de50aee" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2+2\\pi " :db/id 17592186297999} :answer-field/id #uuid "a18e3e97-a4e0-5e84-b042-7a032d5dcbfb" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186299173}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c349db8f-5b7a-5939-87f5-078e4758e4b6" :question/math-academy-id "q-318225" :question/problem "![](images/95/95e601203c55e93922554e4eb56a9742f4a84466ac387e3358484baaf9287e08.png)\n\nConsider the graph of the function $f(x),$ shown above. It consists of a line segment and an arc of a semi-circle centered at $(4,0)$ with radius $2.$ Find the value of \n${\\int }_{-2}^{6}f(x)\\,\\text{d}x.$\n\n${\\int }_{-2}^{6}f(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "The graph consists of $2$ parts: the line segment for $x\\in [-2,2]$ and the arc of a semi-circle for $x\\in [2,6].$ Therefore, we can write the integral as follows:\n\n$$\n{\\int }_{-2}^{6}f(x)\\,\\text{d}x={{{\\int }_{-2}^{2}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{2}^{6}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}\n$$\n\nThe $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,2].$ The corresponding region is a triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 1\\cdot 4 \\\\  & =2.\\end{aligned}\n$$\n\nThe $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [2,6].$ The corresponding region is a semi-circle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot {2}^{2} \\\\  & =2\\pi .\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{6}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =2+2\\pi .\\end{aligned}\n$$"} {:db/id 17592186302202 :knowledge-point/_questions [{:db/id 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0432df21-0cbf-5310-b63d-d6d35b252ad8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186299948} {:answer/id #uuid "0e624142-c08f-57f0-ac81-3c8acbe9f224" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id 17592186300009} {:answer/id #uuid "934f2563-3041-51a5-be22-78f3bc46ae92" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id 17592186300701} {:answer/id #uuid "ac425112-4037-539d-b950-dc90094cf5b2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186300823} {:answer/id #uuid "b1c403d6-3218-5d7c-bb7b-d08ac835de9a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186300849}] :answer-field/correct {:answer/id #uuid "0e624142-c08f-57f0-ac81-3c8acbe9f224" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id 17592186300009} :answer-field/id #uuid "b0579342-0bba-5c5a-a576-6b032097c4cf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301806}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "912ad134-e874-55d5-a192-6e414d5ad134" :question/math-academy-id "q-32533" :question/problem "Given that\n$A=\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -3 & 1 \\\\ 0 & -1 & 2\\end{bmatrix}$\nhas the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -3 & 1 \\\\ 0 & -1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & -1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-0.5){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.5 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.5 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.5 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0.5 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.5,{u}_{33}=1,$ and ${l}_{32}\\cdot {u}_{33}=0.5.$"} {:db/id 17592186302217 :knowledge-point/_questions [{:db/id 17592186119792 :knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44acbd5f-b359-597c-af07-f4df8077e41b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id 17592186300303} {:answer/id #uuid "5fbb74af-0781-5c0d-a3b0-d192d46a427a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186300451} {:answer/id #uuid "c3c014cd-34e6-5174-8a6c-ca3b5fd6d05c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186300941} {:answer/id #uuid "d732659e-73b0-5b52-a39b-ff82b321e875" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186301032} {:answer/id #uuid "ddd631f2-7bb7-575a-aaaa-d8c9a58a508e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186301061}] :answer-field/correct {:answer/id #uuid "d732659e-73b0-5b52-a39b-ff82b321e875" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186301032} :answer-field/id #uuid "8b767a95-e4b2-5302-bbb4-fdf21380f70a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301667}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "883a308b-5dbc-5683-ad84-c19d4f942e32" :question/math-academy-id "q-32548" :question/problem "Given that $A=\\begin{bmatrix}-3 & 1 \\\\ -9 & 4\\end{bmatrix}$ has the LU decomposition $A=LU$, then ${l}_{21}\\cdot {u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-3 & 1 \\\\ -9 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-3 & 1 \\\\ 0 & 1\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-3 & 1 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=3,{u}_{22}=1,$ and ${l}_{21}\\cdot {u}_{22}=3.$"} {:db/id 17592186302218 :knowledge-point/_questions [{:db/id 17592186119799 :knowledge-point/id #uuid "7634b3ac-f9e6-514e-87ba-e78590c9fa53" :knowledge-point/title "Solving a 2x2 Linear System Using LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be1af41-0c7e-535a-9a86-a5c82122dcdb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186300250} {:answer/id #uuid "89b9efd6-ce79-56d0-af07-0e42c41ffec0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186300659} {:answer/id #uuid "98709d57-b5d1-505c-a13b-2435f487b4d9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id 17592186300728} {:answer/id #uuid "b5fc1198-c5b8-53d4-8b4a-c8b8adf38ad5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186300866} {:answer/id #uuid "b65d5146-dbe1-5221-b3af-8171d063039f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186300871}] :answer-field/correct {:answer/id #uuid "98709d57-b5d1-505c-a13b-2435f487b4d9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id 17592186300728} :answer-field/id #uuid "3ff87f9e-a211-5118-b7af-25e270840e47" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301437}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "74c73bef-8f9e-5d05-b33f-448bad8fb053" :question/math-academy-id "q-32570" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-4 & -6 \\\\ 0 & -3\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}-4 \\\\ -6\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${y}_{1}+3{x}_{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}-4 \\\\ -6\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-4 \\\\ 2{y}_{1}+{y}_{2} &=-6.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=-4$ and ${y}_{2}=2.$ Therefore, \n\n$$\ny=\\begin{bmatrix}-4 \\\\ 2\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}-4 & -6 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}-4 \\\\ 2\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}-4{x}_{1}-6{x}_{2} &=-4 \\\\ -3{x}_{2} &=2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=-\\frac{2}{3}$ and ${x}_{1}=2.$ Therefore, \n\n$$\nx=\\begin{bmatrix}2 \\\\ -\\frac{2}{3}\\end{bmatrix}.\n$$\n\nFinally, ${y}_{1}+3{x}_{2}=-4+3(-\\frac{2}{3})=-6.$"} {:db/id 17592186302221 :knowledge-point/_questions [{:db/id 17592186119794 :knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4710777-4113-5e2f-942d-646f4e53a9cd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{bmatrix}" :db/id 17592186300860} {:answer/id #uuid "b49d7ad9-3cc8-57cb-be15-19370075ff70" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}" :db/id 17592186300861} {:answer/id #uuid "c7b054fd-c776-5b51-8723-7b7aaccfda90" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{bmatrix}" :db/id 17592186300961} {:answer/id #uuid "f9cabe7f-0c93-5428-b6ba-a289c1bad4c4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id 17592186301195} {:answer/id #uuid "fe295108-2b0f-575e-9cfd-8654adb62aa3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 0 & 0 \\\\ -4 & 6 & 0 \\\\ -1 & 2 & -9\\end{bmatrix}" :db/id 17592186301219}] :answer-field/correct {:answer/id #uuid "f9cabe7f-0c93-5428-b6ba-a289c1bad4c4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id 17592186301195} :answer-field/id #uuid "b3e791e8-fb69-5daf-a127-f8937694643d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301811}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8e3eee9-0aa0-52fc-bec7-7606d20a727c" :question/math-academy-id "q-32581" :question/problem "Given that\n$A=\\begin{bmatrix}-3 & -4 & -1 \\\\ 0 & 6 & 2 \\\\ 12 & 16 & -5\\end{bmatrix}$\nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-3 & -4 & -1 \\\\ 0 & 6 & 2 \\\\ 12 & 16 & -5\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-3 & -4 & -1 \\\\ 0 & 6 & 2 \\\\ 0 & 0 & -9\\end{bmatrix} \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-3 & -4 & -1 \\\\ 0 & 6 & 2 \\\\ 0 & 0 & -9\\end{bmatrix}}_{⏟}}_{U}.\\end{aligned}\n$$"} {:db/id 17592186302246 :knowledge-point/_questions [{:db/id 17592186119793 :knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313f7f73-ae71-5493-992f-4e48bea91c88" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186300201} {:answer/id #uuid "31938138-7d2c-5bed-930a-21cc179190f2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id 17592186300205} {:answer/id #uuid "b073af7e-07ec-5fcd-bbd1-bcce7e503f63" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186300842} {:answer/id #uuid "c1d443bc-9fc8-52e6-ab7c-4ece0d4276c6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186300937} {:answer/id #uuid "eea969a6-a2e5-502c-8add-7b9d6854171a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186301144}] :answer-field/correct {:answer/id #uuid "c1d443bc-9fc8-52e6-ab7c-4ece0d4276c6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186300937} :answer-field/id #uuid "bb7be8c1-9dd6-5e40-801c-bb8c984dfe84" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301841}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54aa3fc3-c0fb-5a79-b3e0-2e2c9dd3e2c8" :question/math-academy-id "q-32597" :question/problem "Given that \n$A=\\begin{bmatrix}1 & 3 \\\\ -2 & -6\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "We need to reduce the matrix to the row echelon form. For every elementary row operation we also write the equivalent notation in terms of multiplication by the corresponding elementary matrix:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 3 \\\\ -2 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & 3 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 3 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-2,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-2.$"} {:db/id 17592186302247 :knowledge-point/_questions [{:db/id 17592186119792 :knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d223293-daf7-5ae0-8b58-c8aedf7d5f8f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186300364} {:answer/id #uuid "5f7b83a9-fc50-5523-9213-c5c55335f7c3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186300448} {:answer/id #uuid "6be9bb45-cb39-515d-9e76-50406807757d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186300506} {:answer/id #uuid "8c9a021e-530d-5a1b-bbbc-f93201721114" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186300671} {:answer/id #uuid "9f0b30d6-e077-5ae5-9c6c-d0df1cb8c001" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186300765}] :answer-field/correct {:answer/id #uuid "9f0b30d6-e077-5ae5-9c6c-d0df1cb8c001" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186300765} :answer-field/id #uuid "107612e4-db9b-5cdc-9b16-c8ff3e069e6f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301280}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85e17ab0-6cd0-5554-bbc1-74b553196159" :question/math-academy-id "q-32598" :question/problem "Given that\n$A=\\begin{bmatrix}9 & -1 \\\\ -9 & 5\\end{bmatrix}$ has the LU decomposition $A=LU$, then ${l}_{21}\\cdot {u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}9 & -1 \\\\ -9 & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}9 & -1 \\\\ 0 & 4\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization: \n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}9 & -1 \\\\ 0 & 4\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-1,{u}_{22}=4,$ and ${l}_{21}\\cdot {u}_{22}=-4.$"} {:db/id 17592186302266 :knowledge-point/_questions [{:db/id 17592186119792 :knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4374f2ca-d187-5c74-a8e5-694af7f1a10f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id 17592186300294} {:answer/id #uuid "4a359ac0-f626-5fc9-b0c1-01e620a91911" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id 17592186300341} {:answer/id #uuid "7a50d87f-d58a-5c34-a7a5-6614e8291acf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}" :db/id 17592186300564} {:answer/id #uuid "c3a1b26d-8ffa-5c97-9580-8122a3e8e4fe" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id 17592186300940} {:answer/id #uuid "d92efac6-01ae-5b2e-8354-9a9f798d247d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186301039}] :answer-field/correct {:answer/id #uuid "4a359ac0-f626-5fc9-b0c1-01e620a91911" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id 17592186300341} :answer-field/id #uuid "62bd16e6-f4e0-5d3c-b02e-ace76daef0c0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301543}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "468d9e20-789c-5294-9d35-e95d404e4f0e" :question/math-academy-id "q-32617" :question/problem "Given that \n$B=\\begin{bmatrix}3 & 9 \\\\ 7 & 20\\end{bmatrix}$ \nhas the LU decomposition $B=LU$, then ${l}_{21}\\cdot {u}_{12}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $B$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $B$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}3 & 9 \\\\ 7 & 20\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{7}{3}){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -\\frac{7}{3} & 1\\end{bmatrix}}}\\cdot B \\\\  & ∼\\begin{bmatrix}3 & 9 \\\\ 0 & -1\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}B=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}B & =U \\\\ B & ={E}_{1}^{-1}U \\\\ B & ={\\begin{bmatrix}1 & 0 \\\\ -\\frac{7}{3} & 1\\end{bmatrix}}^{-1}U \\\\ B & ={{\\begin{bmatrix}1 & 0 \\\\ \\frac{7}{3} & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & 9 \\\\ 0 & -1\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=\\frac{7}{3},{u}_{12}=9,$ and ${l}_{21}\\cdot {u}_{12}=21.$"} {:db/id 17592186302304 :knowledge-point/_questions [{:db/id 17592186119886 :knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a" :knowledge-point/title "Finding the Solution of an Intermediate System Using the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a584a4-1cb3-5a39-965f-bd37797a14dc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}" :db/id 17592186300207} {:answer/id #uuid "5667e7ae-d6bd-5c1f-ad1e-aae452fb72f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}" :db/id 17592186300413} {:answer/id #uuid "8b7176ae-1c26-5712-bc49-4af26749cfe3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}" :db/id 17592186300668} {:answer/id #uuid "eba296dc-899c-5301-ae53-afe3e0bf711e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}" :db/id 17592186301129} {:answer/id #uuid "f7f7fdf2-1c9e-50a6-8a62-a3a05cd4b6ab" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}" :db/id 17592186301187}] :answer-field/correct {:answer/id #uuid "eba296dc-899c-5301-ae53-afe3e0bf711e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}" :db/id 17592186301129} :answer-field/id #uuid "c89816ba-4cb7-5469-8836-98801e44c13c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301874}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e67ea89-60e8-5377-8f1d-5084c5f474ac" :question/math-academy-id "q-32647" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=2 \\\\ -4{y}_{1}+{y}_{2} &=-2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=2$ and ${y}_{2}=6.$ \n\nTherefore, $y=\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}.$"} {:db/id 17592186302308 :knowledge-point/_questions [{:db/id 17592186119800 :knowledge-point/id #uuid "9fa9fbb8-b2bc-5c93-bb07-bc8c7ef7c115" :knowledge-point/title "Finding the Solution of an Intermediate System Using the LU Factorization of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "227f8924-c424-5ace-a60e-ec0f75170bac" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ -11 \\\\ 27\\end{bmatrix}" :db/id 17592186300127} {:answer/id #uuid "92f848fa-5e70-5e9d-b0b2-39d1279bf9a6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 11 \\\\ -27\\end{bmatrix}" :db/id 17592186300699} {:answer/id #uuid "b6dd3cfd-0739-55c3-a7db-96724115278a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 1 \\\\ -27\\end{bmatrix}" :db/id 17592186300873} {:answer/id #uuid "c66ecfa0-d3ff-5035-878c-474ec658c5bf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 0 \\\\ 11\\end{bmatrix}" :db/id 17592186300953} {:answer/id #uuid "ea19420c-93c3-5e7a-bd37-4cf627ed744e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 11 \\\\ -7\\end{bmatrix}" :db/id 17592186301121}] :answer-field/correct {:answer/id #uuid "92f848fa-5e70-5e9d-b0b2-39d1279bf9a6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 11 \\\\ -27\\end{bmatrix}" :db/id 17592186300699} :answer-field/id #uuid "9e3c053a-931d-5e1f-b30f-402efc4920cf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301736}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6904caba-1f35-5875-862d-7c3f71474ab1" :question/math-academy-id "q-32671" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 3 & 2 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -1 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 3 & 2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}3 \\\\ -1 \\\\ 4\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=3 \\\\ -4{y}_{1}+{y}_{2} &=-1 \\\\ 3{y}_{1}+2{y}_{2}+{y}_{3} &=4.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =3, \\\\ {y}_{2} & =-1+4{y}_{1} \\\\  & =-1+4(3) \\\\  & =11, \\\\ {y}_{3} & =4-3{y}_{1}-2{y}_{2} \\\\  & =4-3(3)-2(11) \\\\  & =-27.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}3 \\\\ 11 \\\\ -27\\end{bmatrix}.$"} {:db/id 17592186302309 :knowledge-point/_questions [{:db/id 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f2ebc4b-5389-54bf-a2fa-d9bfc4a8f26e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id 17592186300018} {:answer/id #uuid "2c9153f4-2e30-5c37-8b1e-09ae03d171c3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id 17592186300179} {:answer/id #uuid "432fa160-28fe-59c0-b329-f317a7313416" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & -3 & 1\\end{bmatrix}" :db/id 17592186300293} {:answer/id #uuid "4acc2614-a841-5f02-8de0-c500389e0674" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id 17592186300346} {:answer/id #uuid "7907818c-57cc-5eaf-9979-1133fc70f621" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 3 & 1\\end{bmatrix}" :db/id 17592186300558}] :answer-field/correct {:answer/id #uuid "4acc2614-a841-5f02-8de0-c500389e0674" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id 17592186300346} :answer-field/id #uuid "174c33e3-c3b7-56d0-872e-43efb4f0dfa2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301304}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "142d0252-9564-5605-b794-3e443fd3c338" :question/math-academy-id "q-32685" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-3{R}_{1},\\,{R}_{3}:={R}_{3}+3{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+3\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{2}}\\cdot {{\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ C & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix})U \\\\ C & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"} {:db/id 17592186302328 :knowledge-point/_questions [{:db/id 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47fe83a0-e9d5-50a3-9940-fe6aa5b2fca5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id 17592186300325} {:answer/id #uuid "86d51352-51ec-57c4-9bf2-275890748404" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0.75" :db/id 17592186300638} {:answer/id #uuid "c5cdd5e8-4939-5ef4-9d9c-85d5d69186c4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-0.25" :db/id 17592186300947} {:answer/id #uuid "ce4ba015-2615-5951-9a18-719c2ec77b4d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186300991} {:answer/id #uuid "f8ed7e67-5b4b-58b7-81f7-0658fc92406c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-0.75" :db/id 17592186301190}] :answer-field/correct {:answer/id #uuid "f8ed7e67-5b4b-58b7-81f7-0658fc92406c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-0.75" :db/id 17592186301190} :answer-field/id #uuid "b775ffec-3e99-500c-b43f-7235402bf13f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301826}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07c6f264-146a-54ea-b4f6-d999ec6ba735" :question/math-academy-id "q-32720" :question/problem "Given that\n$B=\\begin{bmatrix}1 & 1 & 1 \\\\ 1 & 5 & 1 \\\\ 0 & 1 & -3\\end{bmatrix}$\nhas the LU decomposition $B=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $B$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $B$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & 1 & 1 \\\\ 1 & 5 & 1 \\\\ 0 & 1 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot B \\\\  & ∼\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 1 & -3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-0.25){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.25 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot B \\\\  & ∼\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}B=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}B & =U \\\\ {E}_{1}B & ={E}_{2}^{-1}U \\\\ B & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ B & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.25 & 1\\end{bmatrix}}^{-1}U \\\\ B & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{bmatrix})U \\\\ B & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.25,{u}_{33}=-3,$ and ${l}_{32}\\cdot {u}_{33}=-0.75.$"} {:db/id 17592186302329 :knowledge-point/_questions [{:db/id 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08da2c73-b3f3-5f9e-bdca-1b5b280e8ca5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}" :db/id 17592186299976} {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id 17592186300075} {:answer/id #uuid "19c8433d-ce31-55b1-ace0-59e14900aabb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}" :db/id 17592186300076} {:answer/id #uuid "7190b1cb-7787-5bdb-9600-71dbc81662e1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id 17592186300527} {:answer/id #uuid "c9f2b7f6-5083-5e02-a198-e7a6dbb7f6c6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id 17592186300969}] :answer-field/correct {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id 17592186300075} :answer-field/id #uuid "1a4a2fa1-bb43-517d-8181-7f72736b0a79" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301310}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1cd1efa-f609-59d5-a15c-c2a561c4fae4" :question/math-academy-id "q-32722" :question/problem "Given that\n$K=\\begin{bmatrix}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{bmatrix}$\nhas the LU decomposition $K=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $K$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $K$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}K & =\\begin{bmatrix}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{7}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot K \\\\  & ∼\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 7 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot K \\\\  & ∼\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}K=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}K & =U \\\\ {E}_{1}K & ={E}_{2}^{-1}U \\\\ K & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ K & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}^{-1}U \\\\ K & =(\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix})U \\\\ K & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id 17592186304790 :knowledge-point/_questions [{:db/id 17592186054805 :knowledge-point/id #uuid "cd03f31e-360e-5cc1-9118-f71f813d572e" :knowledge-point/title "Factoring a Quartic Polynomial With Only Two Real Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0382a5ea-db99-589b-81d2-d5c436068601" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-x+5" :db/id 17592186302478}] :answer-field/correct {:answer/id #uuid "0382a5ea-db99-589b-81d2-d5c436068601" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-x+5" :db/id 17592186302478} :answer-field/id #uuid "a733200a-8113-59aa-ab5f-2b6d94152d94" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186304535}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b6781c6-fbc9-5b3d-86e2-c16bb96fea3c" :question/math-academy-id "q-328607" :question/problem "Find the polynomial $P(x)$ given that $-3{x}^{4}+4{x}^{3}+30{x}^{2}-7x+60=-(x+3)(x-4)P(x).$\n\n$P(x)=$\n{{field-1}}" :question/worked-solution "Let $f(x)=-3{x}^{4}+4{x}^{3}+30{x}^{2}-7x+60.$ We know that $(x+3)$ and $(x-4)$ are factors of $f(x),$ and we need to find its other factors.  \n\nBecause $(x+3)$ is a factor of $f(x),$ we know that $(x+3)$ divides $f(x)$ with no remainder. So, to begin factoring $f(x),$ we can divide it by $(x+3)$ using synthetic division:  \n\n|  | ${x}^{4}$ | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- | --- |\n| $-3$ | $-3$ | $4$ | $30$ | $-7$ | $60$ |\n|  | $↓$ | $9$ | $-39$ | $27$ | $-60$ |\n|  | $-3$ | $13$ | $-9$ | $20$ | $0$ |\n\nTherefore,  \n\n$$\n\\frac{-3{x}^{4}+4{x}^{3}+30{x}^{2}-7x+60}{x+3}=-3{x}^{3}+13{x}^{2}-9x+20,\n$$\n\nwhich means that  \n\n$$\n-3{x}^{4}+4{x}^{3}+30{x}^{2}-7x+60=(x+3)(-3{x}^{3}+13{x}^{2}-9x+20).\n$$\n\nNow, because $(x-4)$ is also a factor of $f(x),$ it must be a factor of the quotient $(-3{x}^{3}+13{x}^{2}-9x+20).$ So, we divide this quotient by $(x-4)$ using synthetic division once more:  \n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $4$ | $-3$ | $13$ | $-9$ | $20$ |\n|  | $↓$ | $-12$ | $4$ | $-20$ |\n|  | $-3$ | $1$ | $-5$ | $0$ |\n\nTherefore,  \n\n$$\n\\frac{-3{x}^{3}+13{x}^{2}-9x+20}{x-4}=-3{x}^{2}+x-5,\n$$\n\nwhich means that  \n\n$$\n\\begin{aligned}-3{x}^{4}+4{x}^{3}+30{x}^{2}-7x+60 & =(x+3)(x-4)(-3{x}^{2}+x-5) \\\\  & =-(x+3)(x-4)(3{x}^{2}-x+5).\\end{aligned}\n$$\n\nTo see whether the quadratic polynomial $3{x}^{2}-x+5$ can be factored any further, we calculate its discriminant:  \n\n$$\n{b}^{2}-4ac=(-1)^{2}-4(3)(5)=-59<0.\n$$\n\nSo, the quadratic polynomial $3{x}^{2}-x+5$ cannot be factored over the real numbers since its discriminant is negative.  \n\nTherefore, the full factorization of $f(x)$ over the real numbers is given by  \n\n$$\n-3{x}^{4}+4{x}^{3}+30{x}^{2}-7x+60=-(x+3)(x-4){{(3{x}^{2}-x+5)}_{⏟}}_{P(x)}.\n$$\n\nFinally, $P(x)=3{x}^{2}-x+5.$"} {:db/id 17592186304809 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04215ae4-e362-5179-aa16-f64611cab85b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465981} {:answer/id #uuid "8a73ae01-e668-533a-8ee7-c6b89930becc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465982}] :answer-field/correct {:answer/id #uuid "8a73ae01-e668-533a-8ee7-c6b89930becc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465982} :answer-field/id #uuid "128db81a-f678-5e76-9297-f5984c2d1de0" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466834} {:answer-field/choices [{:answer/id #uuid "7817a577-c492-5b10-ad8a-ada69e8ae0a2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465983} {:answer/id #uuid "5babd41a-b59c-5662-9f2a-5f8f64060536" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465984}] :answer-field/correct {:answer/id #uuid "7817a577-c492-5b10-ad8a-ada69e8ae0a2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465983} :answer-field/id #uuid "89355e5f-a26a-594a-b62a-a9482525ec6a" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466835} {:answer-field/choices [{:answer/id #uuid "2d5bc8dc-1011-53d6-be83-2431da52de28" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465985} {:answer/id #uuid "fe7d5874-299d-503e-a6ec-50df4a134464" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465986}] :answer-field/correct {:answer/id #uuid "2d5bc8dc-1011-53d6-be83-2431da52de28" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465985} :answer-field/id #uuid "e260212c-56c8-5314-9942-156986da6d6c" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466836}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f297359-1573-550c-acfb-39ada6af0bec" :question/math-academy-id "q-330297" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** $2\\cdot {x}_{1}(t)+{x}_{2}(t)+{x}_{p}(t)$\n- **II.** $-5\\cdot {x}_{1}(t)-{x}_{p}(t)$\n- **III.** $3\\cdot {x}_{1}(t)-2\\cdot {x}_{2}(t)+3\\cdot {x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=2\\cdot {x}_{1}(t)+1\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{2\\cdot {x}_{1}(t)+{x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II might be *not* a solution to the inhomogeneous system. Notice that $-5\\cdot {x}_{1}(t)-{x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $-1$ next to the particular solution ${x}_{p}(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that $3\\cdot {x}_{1}(t)-2\\cdot {x}_{2}(t)+3\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $3$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"I only\"."} {:db/id 17592186304810 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64305698-5cb7-58a3-8920-f8133086baec" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465987} {:answer/id #uuid "93983b0e-a4d4-570e-8786-0a61bc2fd5b6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465988}] :answer-field/correct {:answer/id #uuid "64305698-5cb7-58a3-8920-f8133086baec" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465987} :answer-field/id #uuid "d13ae99c-18aa-528c-8e92-0fd5ffbda546" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466837} {:answer-field/choices [{:answer/id #uuid "ec6982d1-8cca-5341-aea5-71833a39636c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465989} {:answer/id #uuid "1316fcb8-1c1c-5c1e-aff7-431370a66725" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465990}] :answer-field/correct {:answer/id #uuid "ec6982d1-8cca-5341-aea5-71833a39636c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465989} :answer-field/id #uuid "500f98c1-f39c-5a8d-aed2-f064abe90437" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466838} {:answer-field/choices [{:answer/id #uuid "304a041e-9f96-5db9-822e-e1fdc87c43c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465991} {:answer/id #uuid "490bed6d-5c68-5a93-8919-dff31036af0a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465992}] :answer-field/correct {:answer/id #uuid "490bed6d-5c68-5a93-8919-dff31036af0a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186465992} :answer-field/id #uuid "38a38067-a95d-55de-aa07-a74dade22f01" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466839}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78db71f4-3fc9-53f6-9a4c-5f66663f6749" :question/math-academy-id "q-330298" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** $-2\\cdot {x}_{1}(t)+4\\cdot {x}_{p}(t)$\n- **II.** ${x}_{2}(t)-{x}_{1}(t)+2\\cdot {x}_{p}(t)$\n- **III.** $-7\\cdot {x}_{2}(t)+{x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I might be *not* a solution to the inhomogeneous system. Notice that $-2\\cdot {x}_{1}(t)+4\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $4$ next to the particular solution ${x}_{p}(t).$\n\n- Option II might be *not* a solution to the inhomogeneous system. Notice that ${x}_{2}(t)-{x}_{1}(t)+2\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $2$ next to the particular solution ${x}_{p}(t).$\n\n- Option III is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-7\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{-7\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is \"III only\"."} {:db/id 17592186304812 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed00e399-1ffb-5322-a233-0ae88949f98d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186465999} {:answer/id #uuid "2557342b-e85e-5a80-b3fa-69cbbedd5ecd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466000}] :answer-field/correct {:answer/id #uuid "2557342b-e85e-5a80-b3fa-69cbbedd5ecd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466000} :answer-field/id #uuid "633728be-6b0e-5675-bb30-87e26f4d918e" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466843} {:answer-field/choices [{:answer/id #uuid "24ff92e7-67c7-5547-bed0-850897cd7252" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466001} {:answer/id #uuid "a5992b59-7848-5b0f-a3b4-3c48f56cb8d5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466002}] :answer-field/correct {:answer/id #uuid "a5992b59-7848-5b0f-a3b4-3c48f56cb8d5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466002} :answer-field/id #uuid "9207871d-4ce6-5020-9be8-d953e8b91116" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466844} {:answer-field/choices [{:answer/id #uuid "66f0526a-67e7-5227-931a-6aacd9525023" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466003} {:answer/id #uuid "7791d5f0-de01-531c-8421-69d34d448c34" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466004}] :answer-field/correct {:answer/id #uuid "7791d5f0-de01-531c-8421-69d34d448c34" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466004} :answer-field/id #uuid "e59b0e28-290f-520f-94d6-4f353375a321" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466845}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6d8d0be-fe4e-5e1a-948d-b8eb21d680a7" :question/math-academy-id "q-330302" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** ${x}_{1}(t)+{x}_{p}(t)$\n- **II.** $-3\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- **III.** $7\\cdot {x}_{1}(t)-5\\cdot {x}_{2}(t)+{x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)={x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{{x}_{1}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-3\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{-3\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=7\\cdot {x}_{1}(t)-5\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{7\\cdot {x}_{1}(t)-5\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is \"I, II and III\"."} {:db/id 17592186304813 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6b5959-7e82-580f-8ce3-986e9d787885" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466005} {:answer/id #uuid "10b79adc-acdf-52b8-bb24-cf229ef3e9ba" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466006}] :answer-field/correct {:answer/id #uuid "10b79adc-acdf-52b8-bb24-cf229ef3e9ba" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466006} :answer-field/id #uuid "71ca3d40-0366-5608-a056-4c63873a3687" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466846} {:answer-field/choices [{:answer/id #uuid "aee7e526-5079-566b-b43f-55449205d8f8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466007} {:answer/id #uuid "3d3b92e9-33ac-5f2f-bd3b-e25b6e845f04" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466008}] :answer-field/correct {:answer/id #uuid "3d3b92e9-33ac-5f2f-bd3b-e25b6e845f04" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466008} :answer-field/id #uuid "7e6580e8-268c-5643-9eeb-68f96909e1a0" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466847} {:answer-field/choices [{:answer/id #uuid "4b8627b9-3e1e-52d5-99b3-46674a6b9203" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466009} {:answer/id #uuid "9f16a7a2-4bda-563c-b9d2-49cc6156f0bf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466010}] :answer-field/correct {:answer/id #uuid "4b8627b9-3e1e-52d5-99b3-46674a6b9203" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466009} :answer-field/id #uuid "d8bdf9e9-39fa-5c00-9b52-2a29ea64ca07" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466848}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63b3f264-c6f0-527c-811d-3ed89e69129d" :question/math-academy-id "q-330305" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** $4\\cdot {x}_{1}(t)+{x}_{p}(t)$\n- **II.** $-2\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- **III.** ${x}_{1}(t)+3\\cdot {x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=4\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{4\\cdot {x}_{1}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-2\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{-2\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)+3\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $3$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id 17592186304814 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c88b0e4e-5a3e-5079-8b0d-dfcc622ee62e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466011} {:answer/id #uuid "08086d2f-8b6f-5681-8f08-bde20907f6ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466012}] :answer-field/correct {:answer/id #uuid "08086d2f-8b6f-5681-8f08-bde20907f6ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466012} :answer-field/id #uuid "797d260f-5ec6-56eb-bc36-d7cda55f4895" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466849} {:answer-field/choices [{:answer/id #uuid "89c338ab-2af4-57e2-ab5f-5093a76750d0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466013} {:answer/id #uuid "76aa5d3b-359b-560f-bc95-487efa372d25" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466014}] :answer-field/correct {:answer/id #uuid "89c338ab-2af4-57e2-ab5f-5093a76750d0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466013} :answer-field/id #uuid "71ccbeb8-7023-5d38-8c4a-7e73be5751bf" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466850} {:answer-field/choices [{:answer/id #uuid "b37164e3-6c13-55ea-af30-b7e5107db181" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466015} {:answer/id #uuid "8be1a8f6-5899-561d-9625-51d49bd0dabc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466016}] :answer-field/correct {:answer/id #uuid "b37164e3-6c13-55ea-af30-b7e5107db181" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466015} :answer-field/id #uuid "589c079d-5042-5aa9-a7fb-bf8c5b6dbfec" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466851}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed465271-2eba-5278-8938-505251fa9eb3" :question/math-academy-id "q-330308" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\nI. $2\\cdot {x}_{1}(t)+{x}_{p}(t)$\n\nII. ${x}_{1}(t)-{x}_{2}(t)$\n\nIII. $3\\cdot {x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=2\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{2\\cdot {x}_{1}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)-{x}_{2}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because it lacks the particular solution term ${x}_{p}(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that $3\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $3$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"I only\"."} {:db/id 17592186304815 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c8a81a9-aee0-56a4-b68f-2a2e79bd4516" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466017} {:answer/id #uuid "345d3f7c-1e64-52cb-b627-5780060ae9c4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466018}] :answer-field/correct {:answer/id #uuid "345d3f7c-1e64-52cb-b627-5780060ae9c4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466018} :answer-field/id #uuid "a12e1ec7-d047-568a-af4b-b20de2971566" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466852} {:answer-field/choices [{:answer/id #uuid "4d802e20-8c04-5766-bd86-0f77748b6c92" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466019} {:answer/id #uuid "987c28c3-8e1a-579e-8d11-c523886be91c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466020}] :answer-field/correct {:answer/id #uuid "987c28c3-8e1a-579e-8d11-c523886be91c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466020} :answer-field/id #uuid "805d2c07-a9de-52b8-a22a-e1e4e8b45e36" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466853} {:answer-field/choices [{:answer/id #uuid "987acaa7-0bbf-55e8-a5ab-af5abd891933" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186466021} {:answer/id #uuid "fb503b45-96ed-575b-b767-59b553927311" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466022}] :answer-field/correct {:answer/id #uuid "fb503b45-96ed-575b-b767-59b553927311" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186466022} :answer-field/id #uuid "5754b775-f9a5-55de-9c6f-c8ca3b1a0f41" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186466854}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7119481-1ac5-5669-b8e8-7afd953dbdf9" :question/math-academy-id "q-330309" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** $-5\\cdot {x}_{1}(t)+{x}_{p}(t)$\n- **II.** $2\\cdot {x}_{1}(t)-7\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- **III.** ${x}_{2}(t)+{x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-5\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{-5\\cdot {x}_{1}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=2\\cdot {x}_{1}(t)-7\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{2\\cdot {x}_{1}(t)-7\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)={x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{{x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is \"I, II and III\"."} {:db/id 17592186308380 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b1859e-d928-56d5-8e71-47afe1cae923" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}" :db/id 17592186305305} {:answer/id #uuid "12800d6f-8d68-537c-96d5-bd7225473a3c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-{y}_{\\text{new}}+y-0.25{y}^{2}" :db/id 17592186305313} {:answer/id #uuid "27977427-3d40-516a-b81f-13bd75b2cea8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id 17592186305522} {:answer/id #uuid "f1c832ff-12d7-5a60-8d9b-46c88965b97b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}-{y}_{\\text{new}}+0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id 17592186307376} {:answer/id #uuid "f551d69f-aa3e-50b9-9da5-90b5b25f84e7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25{y}^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id 17592186307422}] :answer-field/correct {:answer/id #uuid "27977427-3d40-516a-b81f-13bd75b2cea8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id 17592186305522} :answer-field/id #uuid "096a5fe3-b5c8-5575-9621-3bfe10920d20" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307556}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee872a11-c24d-55e1-9549-15a9aadbfbd5" :question/math-academy-id "q-333098" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x\\,y-{y}^{2},\\,y(0)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=0.25,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =({x}_{\\text{new}}\\,{y}_{\\text{new}}-({y}_{\\text{new}})^{2})\\cdot 0.25 \\\\  & =0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2} \\\\ {{0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.25$ is\n\n$$\ng({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y.\n$$"} {:db/id 17592186308381 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c567737-e000-5bfd-8c08-8137a8b55d84" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-y+0.5\\,{x}_{\\text{new}}" :db/id 17592186305573} {:answer/id #uuid "8552bd71-2751-58ba-9daa-3400fac32ae0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25{y}^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}" :db/id 17592186306422} {:answer/id #uuid "c825e8c3-dddc-5bca-b705-8b3817f37d60" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}" :db/id 17592186307009} {:answer/id #uuid "cd768c27-d512-5219-8d7b-9cfceb7de710" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,{y}_{\\text{new}}+y+0.25\\,{x}_{\\text{new}}-0.25{y}^{2}" :db/id 17592186307054} {:answer/id #uuid "f8b5773b-fea6-5649-b47b-1ce4f200389f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y+0.25\\,{x}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}" :db/id 17592186307452}] :answer-field/correct {:answer/id #uuid "c825e8c3-dddc-5bca-b705-8b3817f37d60" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}" :db/id 17592186307009} :answer-field/id #uuid "423d28be-8dcb-5543-b664-72165a688fb0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307726}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0391ddab-83ad-5a6c-910a-189b80201c1f" :question/math-academy-id "q-333102" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x+{y}^{2},\\,y(0)=3\n$$\n\nUsing the implicit Euler method with step size $Δx=0.25,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =({x}_{\\text{new}}+({y}_{\\text{new}})^{2})\\cdot 0.25 \\\\  & =0.25\\,{x}_{\\text{new}}+0.25({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.25\\,{x}_{\\text{new}}+0.25({y}_{\\text{new}})^{2} \\\\ {{-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.25$ is\n\n$$\ng({y}_{\\text{new}})=-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}.\n$$"} {:db/id 17592186308382 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267cec7e-4cd3-5750-990e-500f696b49bb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-{y}_{\\text{new}}+y-0.5({x}_{\\text{new}})^{2}" :db/id 17592186305510} {:answer/id #uuid "2901ddcb-afed-501a-b3e7-d0356e15337a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,y-0.5{y}^{2}" :db/id 17592186305537} {:answer/id #uuid "501b6f48-2a5f-5f39-b756-bf5c8f1d256a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,y-0.5({x}_{\\text{new}})^{2}" :db/id 17592186305932} {:answer/id #uuid "b21eb925-c73a-5357-87a9-61e92376b659" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-{y}_{\\text{new}}-0.5({x}_{\\text{new}})^{2}" :db/id 17592186306826} {:answer/id #uuid "d143f2e9-c8ad-5075-b8c7-568c90915ca1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-0.5({x}_{\\text{new}})^{2}" :db/id 17592186307088}] :answer-field/correct {:answer/id #uuid "501b6f48-2a5f-5f39-b756-bf5c8f1d256a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,y-0.5({x}_{\\text{new}})^{2}" :db/id 17592186305932} :answer-field/id #uuid "ba956aa8-9469-5770-ac8b-fbd9f328316d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186308112}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b416e150-2c65-550a-a50c-8ec6ef536841" :question/math-academy-id "q-333105" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={x}^{2}+2y,\\,y(0)=0\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({x}_{\\text{new}})^{2}+2{y}_{\\text{new}})\\cdot 0.5 \\\\  & =0.5({x}_{\\text{new}})^{2}+{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5({x}_{\\text{new}})^{2}+{y}_{\\text{new}} \\\\ {{{y}_{\\text{new}}-y-0.5({x}_{\\text{new}})^{2}-{y}_{\\text{new}}}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})=-\\,y-0.5({x}_{\\text{new}})^{2}.\n$$"} {:db/id 17592186308383 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6861fbd2-fc06-57ed-ae66-c7d3ddbaaff4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}-{y}_{\\text{new}}+2.25{x}_{\\text{new}}-y" :db/id 17592186306147} {:answer/id #uuid "73e5a46f-8b50-58c8-85da-368b7abc9ad7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}" :db/id 17592186306253} {:answer/id #uuid "87f5b887-79ac-5fb1-80b2-e15ea6a32c0a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75{y}^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}" :db/id 17592186306450} {:answer/id #uuid "bfda0631-8087-5f34-85cb-b6c62df80589" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-2.25{x}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}" :db/id 17592186306940} {:answer/id #uuid "c71818e8-36ad-5ce8-9646-30ce5b2ce541" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-{y}_{\\text{new}}+y+2.25{x}_{\\text{new}}-0.75{y}^{2}" :db/id 17592186307004}] :answer-field/correct {:answer/id #uuid "73e5a46f-8b50-58c8-85da-368b7abc9ad7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}" :db/id 17592186306253} :answer-field/id #uuid "492e8811-57e2-5ed2-981d-a4370a65e861" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307752}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f173cd08-22bb-5ca3-9127-e35896086f3a" :question/math-academy-id "q-333106" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=3x-{y}^{2},\\,y(0)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=0.75,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(3{x}_{\\text{new}}-({y}_{\\text{new}})^{2})\\cdot 0.75 \\\\  & =2.25{x}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+2.25{x}_{\\text{new}}-0.75({y}_{\\text{new}})^{2} \\\\ {{0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.75$ is\n\n$$\ng({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}.\n$$"} {:db/id 17592186308384 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b258dc9-5e5e-5575-9639-fa6d3d88a1e3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-3" :db/id 17592186305403} {:answer/id #uuid "992a1530-db12-5cdd-861b-04d1f3faeb5a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{2}+{y}_{\\text{new}}+3" :db/id 17592186306582} {:answer/id #uuid "a28a36de-accf-5d39-82a0-a713b5f75b8f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-{x}_{\\text{new}}" :db/id 17592186306679} {:answer/id #uuid "ac2d5a74-496e-5511-b7f7-e9955f0ea7f6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-3" :db/id 17592186306776} {:answer/id #uuid "d3d6eaed-ad9b-54fb-bff5-557b924bb66c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}+3" :db/id 17592186307111}] :answer-field/correct {:answer/id #uuid "1b258dc9-5e5e-5575-9639-fa6d3d88a1e3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-3" :db/id 17592186305403} :answer-field/id #uuid "e50eff7a-3d2c-5830-9ec0-be4335d66236" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186308243}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1794ba8-6c42-5082-bb61-41365c6b4043" :question/math-academy-id "q-333114" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={y}^{2}+x,\\,y(0)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({y}_{\\text{new}})^{2}+{x}_{\\text{new}})\\cdot 1 \\\\  & =({y}_{\\text{new}})^{2}+{x}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+({y}_{\\text{new}})^{2}+{x}_{\\text{new}} \\\\ {{{y}_{\\text{new}}-({y}_{\\text{new}})^{2}-y-{x}_{\\text{new}}}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-y-{x}_{\\text{new}}.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=x+Δx=0+1=1.$ Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & ={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-2-1 \\\\  & ={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-3.\\end{aligned}\n$$"} {:db/id 17592186308385 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c697bd5-7e72-5285-bfc1-1b0b028ff4f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}+0.875" :db/id 17592186305575} {:answer/id #uuid "566aadf4-d34a-59e3-9f6f-34686ae7eafb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-0.875" :db/id 17592186305985} {:answer/id #uuid "dc1ae1ba-c460-53a9-b3dd-36fb7ed1c5b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-0.875" :db/id 17592186307190} {:answer/id #uuid "eb0ff62f-f640-5b7a-a4e3-42fe0f5f1787" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-0.875" :db/id 17592186307314} {:answer/id #uuid "f259509f-933d-5419-b928-9fc8131aab27" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-2" :db/id 17592186307384}] :answer-field/correct {:answer/id #uuid "eb0ff62f-f640-5b7a-a4e3-42fe0f5f1787" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-0.875" :db/id 17592186307314} :answer-field/id #uuid "7c7b3cc2-0946-53f6-b52d-50acb6ab13f0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307914}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce59c975-ea6f-5396-9262-02f983d682d6" :question/math-academy-id "q-333115" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={y}^{2}-{x}^{2},\\,y(1)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({y}_{\\text{new}})^{2}-({x}_{\\text{new}})^{2})\\cdot 0.5 \\\\  & =0.5({y}_{\\text{new}})^{2}-0.5({x}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5({y}_{\\text{new}})^{2}-0.5({x}_{\\text{new}})^{2} \\\\ {{{y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-y+0.5({x}_{\\text{new}})^{2}}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of $g$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-y+0.5({x}_{\\text{new}})^{2}.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=1+0.5=1.5.$ Therefore, the function used in the first step is\n\nThus,\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & ={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-2+0.5(1.5)^{2} \\\\  & ={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-2+1.125 \\\\  & ={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-0.875.\\end{aligned}\n$$"} {:db/id 17592186308386 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54ac79fb-7fee-51ce-8b1d-91d3d1f0d02c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-1" :db/id 17592186305971} {:answer/id #uuid "a1d01b53-018c-51ca-897e-3a987524894d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}-1.5{y}_{\\text{new}}+1" :db/id 17592186306667} {:answer/id #uuid "a4c6cb26-d796-5c36-adac-4f333e833c70" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}+1" :db/id 17592186306702} {:answer/id #uuid "f57234d9-c1d9-5e5d-b503-d383847d9930" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}-1.5{y}_{\\text{new}}-1" :db/id 17592186307424} {:answer/id #uuid "ff446e02-3732-54d8-8325-26fc27326d98" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-{x}_{\\text{new}}" :db/id 17592186307506}] :answer-field/correct {:answer/id #uuid "54ac79fb-7fee-51ce-8b1d-91d3d1f0d02c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-1" :db/id 17592186305971} :answer-field/id #uuid "ed272575-3d43-5a0c-88a5-06b169e42ec6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186308265}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9a47ae6-ee59-581c-a76f-f2251d0aa676" :question/math-academy-id "q-333118" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x\\,{y}^{2}-y,\\,y(1)=1\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =({x}_{\\text{new}}({y}_{\\text{new}})^{2}-{y}_{\\text{new}})\\cdot 0.5 \\\\  & =0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-0.5{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-0.5{y}_{\\text{new}} \\\\ {{1.5{y}_{\\text{new}}-0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-y}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-y.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=x+Δx=1+0.5=1.5.$ Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & =1.5{y}_{\\text{new}}-0.5\\cdot 1.5\\,({y}_{\\text{new}})^{2}-1 \\\\  & =1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-1.\\end{aligned}\n$$"} {:db/id 17592186308387 :knowledge-point/_questions [{:db/id 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c352701-baf3-50c9-be83-52c7a97115f3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-3" :db/id 17592186305256} {:answer/id #uuid "549f39f3-3bd0-5dc8-8732-f1f1a2058bd5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id 17592186305970} {:answer/id #uuid "79af5d53-f61e-5093-bbc4-0243631cf631" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id 17592186306311} {:answer/id #uuid "d0f168ea-96c3-50e3-91f4-8a9e2fe8248a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}+3" :db/id 17592186307084} {:answer/id #uuid "f3e31565-0070-525a-9f9a-5f991d0a720a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id 17592186307409}] :answer-field/correct {:answer/id #uuid "79af5d53-f61e-5093-bbc4-0243631cf631" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id 17592186306311} :answer-field/id #uuid "03b2b73b-444b-554c-8851-bb3c9c5485d9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307530}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae3b87bc-68e4-5606-a94b-221bbad8f4e1" :question/math-academy-id "q-333119" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={x}^{2}y-{y}^{3},\\,y(1)=3\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({x}_{\\text{new}})^{2}{y}_{\\text{new}}-({y}_{\\text{new}})^{3})\\cdot 0.5 \\\\  & =0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-0.5({y}_{\\text{new}})^{3}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-0.5({y}_{\\text{new}})^{3} \\\\ {{0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=x+Δx=1+0.5=1.5.$ Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & =0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-0.5\\cdot (1.5)^{2}{y}_{\\text{new}}-3 \\\\  & =0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-1.125{y}_{\\text{new}}-3 \\\\  & =0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3.\\end{aligned}\n$$"} {:db/id 17592186308547 :knowledge-point/_questions [{:db/id 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d44c04f-a0a8-57c1-acde-240e5804349c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" :db/id 17592186305423} {:answer/id #uuid "2e2060f4-f260-5a0e-9344-1014813644b8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-2{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-2x\\sqrt{y}" :db/id 17592186305592} {:answer/id #uuid "6b35983e-90e9-58cf-b562-3ce070af8556" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-{x}_{\\text{new}}\\sqrt{y}" :db/id 17592186306176} {:answer/id #uuid "a6591279-48bc-5836-b1b7-97a233a064ae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}{y}_{\\text{new}}-y-x\\sqrt{y}" :db/id 17592186306717} {:answer/id #uuid "c1247dd6-e5be-5753-b222-3d441ec8eae5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" :db/id 17592186306953}] :answer-field/correct {:answer/id #uuid "1d44c04f-a0a8-57c1-acde-240e5804349c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" :db/id 17592186305423} :answer-field/id #uuid "58a9d311-00c5-569d-b6f1-261948280da3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307795}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3f3b808-fce2-5df3-9a0a-894ad2ad09f4" :question/math-academy-id "q-334061" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x\\sqrt{y},\\,y(0)=3\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(2x\\sqrt{y}+2{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}})\\cdot 1 \\\\  & =x\\sqrt{y}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+x\\sqrt{y}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}.\n$$"} {:db/id 17592186308550 :knowledge-point/_questions [{:db/id 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13dff8a4-01fa-5c80-ab72-846940300d5e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}" :db/id 17592186305322} {:answer/id #uuid "2d56b3b9-5b33-54e3-a9df-7aa74c3e6dde" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{2}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{2}{x}^{3}\\sqrt{y}" :db/id 17592186305583} {:answer/id #uuid "880e5983-a550-56d6-b155-236d2e618523" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}" :db/id 17592186306452} {:answer/id #uuid "da37edee-b510-59b4-b5f4-1d303fe78e12" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}" :db/id 17592186307171} {:answer/id #uuid "fe83ac2a-c91d-5467-a147-b270f7d8b339" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{y}" :db/id 17592186307500}] :answer-field/correct {: