}_{\\text{new}}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}.\n$$"} {:db/id 17592186308551 :knowledge-point/_questions [{:db/id 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b9978b-5659-551a-b1e7-073570eb7dd6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}^{2}-y-{x}^{2}y" :db/id 17592186305222} {:answer/id #uuid "1db000ba-0ec5-5ebb-b315-0da8395b504d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-({x}_{\\text{new}})^{2}y" :db/id 17592186305431} {:answer/id #uuid "2a5f2caa-2477-5356-83a3-6f9d3be52977" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y" :db/id 17592186305555} {:answer/id #uuid "2e83309d-176c-5b09-a0ed-78a351fca0e1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y" :db/id 17592186305594} {:answer/id #uuid "67084b6a-4622-50d7-9b32-7e1396743053" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-2({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-2{x}^{2}y" :db/id 17592186306134}] :answer-field/correct {:answer/id #uuid "2a5f2caa-2477-5356-83a3-6f9d3be52977" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y" :db/id 17592186305555} :answer-field/id #uuid "50dd8b65-1f5e-540c-bc65-e9abf47e99d2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307770}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db67b0bf-a448-5e18-b9c2-88a56fe2b75e" :question/math-academy-id "q-334069" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=4{x}^{2}y,\\,y(0)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(4{x}^{2}y+4({x}_{\\text{new}})^{2}{y}_{\\text{new}})\\cdot 0.5 \\\\  & ={x}^{2}y+({x}_{\\text{new}})^{2}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+{x}^{2}y+({x}_{\\text{new}})^{2}{y}_{\\text{new}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y.\n$$"} {:db/id 17592186308552 :knowledge-point/_questions [{:db/id 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ccb4ae4-2645-577b-b2c3-c4a076d2a116" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y" :db/id 17592186305262} {:answer/id #uuid "4d17bb5c-87aa-5516-ac49-431c18a84116" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{2}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{2}{x}^{3}y" :db/id 17592186305898} {:answer/id #uuid "5340e35d-182d-5a24-a953-ed8aa1aee1d1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}({x}_{\\text{new}})^{3}y" :db/id 17592186305956} {:answer/id #uuid "91d873de-f728-530f-b8c4-4378b3a78c77" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y" :db/id 17592186306532} {:answer/id #uuid "be7e4cd8-1010-5398-bb8c-1a480836d425" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}^{2}-y-\\frac{5}{4}{x}^{3}y" :db/id 17592186306927}] :answer-field/correct {:answer/id #uuid "91d873de-f728-530f-b8c4-4378b3a78c77" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y" :db/id 17592186306532} :answer-field/id #uuid "556d70f3-4f1f-533a-bdf2-e3220bfdae3a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307781}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f055e80-81ea-55eb-ae51-846a4bd0843f" :question/math-academy-id "q-334070" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=5{x}^{3}y,\\,y(0)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(5{x}^{3}y+5({x}_{\\text{new}})^{3}{y}_{\\text{new}})\\cdot 0.5 \\\\  & =\\frac{5}{4}{x}^{3}y+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{5}{4}{x}^{3}y+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y.\n$$"} {:db/id 17592186308553 :knowledge-point/_questions [{:db/id 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cd05e14-396b-5be5-bff6-ac19aef37eec" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}" :db/id 17592186306044} {:answer/id #uuid "7048bffb-2ca4-5d55-9281-28de38e47fc5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{3}-y-3\\sqrt{x}\\,{y}^{2}" :db/id 17592186306221} {:answer/id #uuid "abfd2ce3-b7f2-51dc-9222-398dfa8745df" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}" :db/id 17592186306773} {:answer/id #uuid "c23aef71-58d9-5960-9b6c-4c7f96828b41" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-6\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-6\\sqrt{x}\\,{y}^{2}" :db/id 17592186306963} {:answer/id #uuid "d168eb42-e316-5d51-868a-e6a69bdab79c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{{x}_{\\text{new}}}\\,{y}^{2}" :db/id 17592186307089}] :answer-field/correct {:answer/id #uuid "abfd2ce3-b7f2-51dc-9222-398dfa8745df" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}" :db/id 17592186306773} :answer-field/id #uuid "85885c05-b84b-5026-9703-2f6893461fad" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186307937}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "113a0a61-21ac-5c28-bc2b-027553b8fdc6" :question/math-academy-id "q-334072" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=6\\sqrt{x}\\,{y}^{2},\\,y(1)=2\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(6\\sqrt{x}\\,{y}^{2}+6\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2})\\cdot 1 \\\\  & =3\\sqrt{x}\\,{y}^{2}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+3\\sqrt{x}\\,{y}^{2}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}.\n$$"} {:db/id 17592186308688 :knowledge-point/_questions [{:db/id 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4bfced-4c23-541f-b242-4c2ea02d35eb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3t}" :db/id 17592186306347} {:answer/id #uuid "72e16707-4ff3-5dfd-9eed-366cbfa6fe18" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id 17592186479531}] :answer-field/correct {:answer/id #uuid "72e16707-4ff3-5dfd-9eed-366cbfa6fe18" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id 17592186479531} :answer-field/id #uuid "52d98b8a-0ce9-5cfa-a498-ed17c16b2e6d" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307772} {:answer-field/choices [{:answer/id #uuid "f1c22720-1aa8-597e-9b76-8432cec4de4e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3t}" :db/id 17592186307375} {:answer/id #uuid "27dc7621-01eb-5ac6-8247-fe730465d634" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id 17592186479418}] :answer-field/correct {:answer/id #uuid "27dc7621-01eb-5ac6-8247-fe730465d634" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id 17592186479418} :answer-field/id #uuid "cba95706-4eaf-526e-986f-73babc57c464" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186308154}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "001f1d7b-e465-5a31-aa71-fce5efbdd939" :question/math-academy-id "q-334824" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{3t}\\end{bmatrix},\\,x(0)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix},$ where $A=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$(t-s){e}^{3t}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{3t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{bmatrix}\\begin{bmatrix}0 \\\\ {e}^{3s}\\end{bmatrix} \\\\  & =\\begin{bmatrix}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}{e}^{3t} \\\\ 0\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"} {:db/id 17592186308692 :knowledge-point/_questions [{:db/id 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "237ca5ab-34cd-58e7-9713-b55a6e87c11b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5t}" :db/id 17592186305489}] :answer-field/correct {:answer/id #uuid "237ca5ab-34cd-58e7-9713-b55a6e87c11b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5t}" :db/id 17592186305489} :answer-field/id #uuid "1dd60399-b452-5b9e-ab6f-1b2c49d47ce4" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307619} {:answer-field/choices [{:answer/id #uuid "752cf0f7-34a2-5108-a051-4523e28c9195" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{5(t-1)}" :db/id 17592186306265}] :answer-field/correct {:answer/id #uuid "752cf0f7-34a2-5108-a051-4523e28c9195" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{5(t-1)}" :db/id 17592186306265} :answer-field/id #uuid "92d548ec-0d73-5a36-8fa4-84091d6ec494" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307985}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc8319e7-c74a-546c-ac46-138a893fec53" :question/math-academy-id "q-334848" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}x+\\begin{bmatrix}{e}^{5t} \\\\ 0\\end{bmatrix},\\,x(1)=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix},$ where $A=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.$*\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+{\\int }_{1}^{t}\\,\\,$ |  | {{field-2}} |  | $\\,\\,\\text{d}s$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $0$ |  |  | $0$ |  |  |  |  |" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =\\begin{bmatrix}{e}^{5(t-1)} & (t-1){e}^{5(t-1)} \\\\ 0 & {e}^{5(t-1)}\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{e}^{5(t-1)} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}\\begin{bmatrix}{e}^{5s} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{5t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}2{e}^{5(t-1)} \\\\ 0\\end{bmatrix}+{\\int }_{1}^{t}\\begin{bmatrix}{e}^{5t} \\\\ 0\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"} {:db/id 17592186308695 :knowledge-point/_questions [{:db/id 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160b514e-c7a9-5db1-8962-33d86d078fb4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2(t-s))" :db/id 17592186305342}] :answer-field/correct {:answer/id #uuid "160b514e-c7a9-5db1-8962-33d86d078fb4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2(t-s))" :db/id 17592186305342} :answer-field/id #uuid "63437be9-2066-5dad-a01a-a0e02722c169" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307836} {:answer-field/choices [{:answer/id #uuid "05184db4-a95b-5878-863f-1aa2b4e40630" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}(2t)" :db/id 17592186305198}] :answer-field/correct {:answer/id #uuid "05184db4-a95b-5878-863f-1aa2b4e40630" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}(2t)" :db/id 17592186305198} :answer-field/id #uuid "f1530c65-7d45-5311-814a-529b693ace24" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186308286}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7aef4d9e-5adf-5d9d-be87-6231a093c423" :question/math-academy-id "q-334855" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}x+\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,x(0)=\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$*\n\n| $x(t)=\\,\\,$ |  | $3\\operatorname{sin}⁡(2t)$ |  | $\\,\\,+{\\int }_{0}^{t}\\,\\,$ |  | {{field-1}} |  | $\\,\\,\\text{d}s$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} |  |  | $-\\operatorname{sin}⁡(2(t-s))$ |  |  |  |  |" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\operatorname{sin}⁡(2t) \\\\ 3\\operatorname{cos}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}3\\operatorname{sin}⁡(2t) \\\\ 3\\operatorname{cos}⁡(2t)\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s))\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"} {:db/id 17592186308696 :knowledge-point/_questions [{:db/id 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b12c1e03-c805-5e36-aea2-b6d121e73478" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4(t-s))" :db/id 17592186306815} {:answer/id #uuid "74474233-2fa8-51ba-9cb4-da5296695f41" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos(4(t-s))" :db/id 17592186479536}] :answer-field/correct {:answer/id #uuid "74474233-2fa8-51ba-9cb4-da5296695f41" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos(4(t-s))" :db/id 17592186479536} :answer-field/id #uuid "13f5abdf-75a7-5b21-afa3-653d497c5d41" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307584} {:answer-field/choices [{:answer/id #uuid "ab25cf3f-5e10-5e03-b9ec-f148d948ee64" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{cos}(4t)" :db/id 17592186306768} {:answer/id #uuid "677ff288-ab7f-56c0-a677-5f7330959d63" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cos(4t)" :db/id 17592186479513}] :answer-field/correct {:answer/id #uuid "677ff288-ab7f-56c0-a677-5f7330959d63" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cos(4t)" :db/id 17592186479513} :answer-field/id #uuid "1f9d3c90-4891-5e53-85e9-0abe74fcc6f2" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307623}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3b7f24-1005-522b-87d6-a7afb67ecc23" :question/math-academy-id "q-334858" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}x+\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,x(0)=\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$5\\operatorname{sin}⁡(4t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$-\\operatorname{sin}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}\\begin{bmatrix}0 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}5\\operatorname{sin}⁡(4t) \\\\ 5\\operatorname{cos}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}5\\operatorname{sin}⁡(4t) \\\\ 5\\operatorname{cos}⁡(4t)\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"} {:db/id 17592186308718 :knowledge-point/_questions [{:db/id 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c139fc5d-402e-5c97-b048-caf60e14b36c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}(2t)-\\operatorname{cos}(2t)+3" :db/id 17592186306955} {:answer/id #uuid "6963f53e-90b3-59a4-b3ac-6bc885da9965" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\cos(2t)+2\\sin(2t)" :db/id 17592186494533}] :answer-field/correct {:answer/id #uuid "6963f53e-90b3-59a4-b3ac-6bc885da9965" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\cos(2t)+2\\sin(2t)" :db/id 17592186494533} :answer-field/id #uuid "8b933995-aeb2-5960-92c8-2edb1a0843a3" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307958}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03656a1f-f3fa-5cdf-b35f-3b5febfaad49" :question/math-academy-id "q-335054" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=2y(t) \\\\ {y}^{′}(t) &=-2x(t)+3,\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\frac{1}{2}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"180px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\operatorname{sin}⁡(2(t-s)) \\\\ 3\\operatorname{cos}⁡(2(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}3\\operatorname{sin}⁡(2(t-s)) \\\\ 3\\operatorname{cos}⁡(2(t-s))\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}\\frac{3}{2}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\frac{3}{2}\\operatorname{sin}⁡(2(t-s))\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\frac{1}{2}\\begin{bmatrix}3-3\\operatorname{cos}⁡(2t) \\\\ 3\\operatorname{sin}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(2t)\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}3-3\\operatorname{cos}⁡(2t) \\\\ 3\\operatorname{sin}⁡(2t)\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2\\operatorname{sin}⁡(2t)-\\operatorname{cos}⁡(2t)+3 \\\\ \\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2\\operatorname{sin}⁡(2t)-\\operatorname{cos}⁡(2t)+3 \\\\ \\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186308719 :knowledge-point/_questions [{:db/id 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9104f75-3823-5343-b10e-35210deee4b1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4t)" :db/id 17592186307163}] :answer-field/correct {:answer/id #uuid "d9104f75-3823-5343-b10e-35210deee4b1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4t)" :db/id 17592186307163} :answer-field/id #uuid "0de54400-c651-59cf-a2eb-bab2e9e63b82" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307571}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "411e1067-1bf2-5810-9a74-3f6443bfc23e" :question/math-academy-id "q-335058" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=4y(t)-4 \\\\ {y}^{′}(t) &=-4x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$*\n\n| $\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | $1-\\operatorname{sin}⁡(4t)$ |  |  |" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}-4 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4t)+\\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\operatorname{cos}⁡(4(t-s)) \\\\ 4\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}-4\\operatorname{cos}⁡(4(t-s)) \\\\ 4\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-\\operatorname{sin}⁡(4(t-s)) \\\\ \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}-\\operatorname{sin}⁡(4t) \\\\ 1-\\operatorname{cos}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}\\operatorname{cos}⁡(4t)+\\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t)\\end{bmatrix}+\\begin{bmatrix}-\\operatorname{sin}⁡(4t) \\\\ 1-\\operatorname{cos}⁡(4t)\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4t) \\\\ 1-\\operatorname{sin}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186308723 :knowledge-point/_questions [{:db/id 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29953a21-209b-586e-a213-f4a4fa9d67d3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{-t}" :db/id 17592186305546}] :answer-field/correct {:answer/id #uuid "29953a21-209b-586e-a213-f4a4fa9d67d3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{-t}" :db/id 17592186305546} :answer-field/id #uuid "af02c77a-cb82-5db7-8040-47a534b70764" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186308078}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47fdaa8b-a137-5a55-9e2b-f6799e375b7a" :question/math-academy-id "q-335081" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=-x(t)+y(t)+1 \\\\ {y}^{′}(t) &=-y(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix},$ where $A=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}.$*\n\n| $\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | $0$ |  |  |" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{-(t-s)} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}{e}^{-(t-s)} \\\\ 0\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-{e}^{-(t-s)} \\\\ 0\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}1-{e}^{-t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}1-{e}^{-t} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-{e}^{-t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186308724 :knowledge-point/_questions [{:db/id 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8e79b01-2389-5a91-bd1b-47d545c124e0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5t}-1" :db/id 17592186307021} {:answer/id #uuid "06fe7ba9-e60a-5a45-b758-fa0196ee521e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "e^{5t}-1" :db/id 17592186479370}] :answer-field/correct {:answer/id #uuid "06fe7ba9-e60a-5a45-b758-fa0196ee521e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "e^{5t}-1" :db/id 17592186479370} :answer-field/id #uuid "2c1add94-bde4-538a-ae6f-d06b8a3019c5" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186307659}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19468931-2ce6-5bd0-af7b-5212e5297c87" :question/math-academy-id "q-335085" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=5x(t)+y(t)+1 \\\\ {y}^{′}(t) &=5y(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix},$ where $A=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\frac{1}{5}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{5(t-s)} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}{e}^{5(t-s)} \\\\ 0\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-\\frac{1}{5}{e}^{5(t-s)} \\\\ 0\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}{e}^{5t}-1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186308736 :knowledge-point/_questions [{:db/id 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f2cc77d-908e-5975-babf-c7e95d32af6b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(t)" :db/id 17592186306066} {:answer/id #uuid "6d657aec-32ba-5cf6-9bf5-c39f0c00dc78" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cosh}⁡(t)" :db/id 17592186306197} {:answer/id #uuid "851c1af3-2a69-5a9e-aeb2-bdc919879a73" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(t)" :db/id 17592186306419} {:answer/id #uuid "b970e691-2738-5a66-b02c-0fc82876b459" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡(t)" :db/id 17592186306880}] :answer-field/correct {:answer/id #uuid "5f2cc77d-908e-5975-babf-c7e95d32af6b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(t)" :db/id 17592186306066} :answer-field/id #uuid "99185d97-eb59-509d-8409-76c2030ce0cc" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186308005}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d6b9f30-3747-520a-a2bd-7bc874e4c993" :question/math-academy-id "q-335127" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=y(t)+1 \\\\ {y}^{′}(t) &=x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(t) & \\operatorname{sinh}⁡(t) \\\\ \\operatorname{sinh}⁡(t) & \\operatorname{cosh}⁡(t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{cosh}⁡(t)-1$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(t) & \\operatorname{sinh}⁡(t) \\\\ \\operatorname{sinh}⁡(t) & \\operatorname{cosh}⁡(t)\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(t) & \\operatorname{sinh}⁡(t) \\\\ \\operatorname{sinh}⁡(t) & \\operatorname{cosh}⁡(t)\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) & \\operatorname{sinh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s) & \\operatorname{cosh}⁡(t-s)\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) & \\operatorname{sinh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s) & \\operatorname{cosh}⁡(t-s)\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s)\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s)\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-\\operatorname{sinh}⁡(t-s) \\\\ -\\operatorname{cosh}⁡(t-s)\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}\\operatorname{sinh}⁡(t) \\\\ \\operatorname{cosh}⁡(t)-1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}\\operatorname{sinh}⁡(t) \\\\ \\operatorname{cosh}⁡(t)-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{sinh}⁡(t) \\\\ \\operatorname{cosh}⁡(t)-1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186311579 :knowledge-point/_questions [{:db/id 17592186157454 :knowledge-point/id #uuid "ffe4292f-7653-5486-975e-c206acae734e" :knowledge-point/title "Applying Properties of Big-O"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc96a6c-1b5c-596d-a55b-44a85cb939a0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186308831} {:answer/id #uuid "39484591-d743-5b44-82f7-59b55da76c53" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186309183} {:answer/id #uuid "4582fef9-a1f8-5f84-b672-d3dc49fdabab" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186309278} {:answer/id #uuid "87b97dd1-23ad-519f-841e-616a1cfa6ddf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id 17592186309815} {:answer/id #uuid "d1510fae-b5c1-516c-a249-ed9a5614f5cf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the transitive property" :db/id 17592186310428} {:answer/id #uuid "e7077ac1-4ba4-5dbd-8a81-bae7c79add62" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the transitive property" :db/id 17592186310583}] :answer-field/correct {:answer/id #uuid "d1510fae-b5c1-516c-a249-ed9a5614f5cf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the transitive property" :db/id 17592186310428} :answer-field/id #uuid "15b6a791-4a64-5bac-87f2-d69ef99004fc" :answer-field/key "field-5" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186310850} {:answer-field/choices [{:answer/id #uuid "702413ff-025f-553d-98cb-d9d2eaf7edae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{L2}$ and $\\text{L3}$" :db/id 17592186309615} {:answer/id #uuid "725966d1-6efe-5c08-8687-9c0f98a59d4a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L2}$" :db/id 17592186309635} {:answer/id #uuid "92c8c0aa-b946-5988-907a-fadfa8a747f1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L1}$ and $\\text{L2}" :db/id 17592186309922}] :answer-field/correct {:answer/id #uuid "92c8c0aa-b946-5988-907a-fadfa8a747f1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L1}$ and $\\text{L2}" :db/id 17592186309922} :answer-field/id #uuid "2d33668a-5000-528e-b78f-75aa4b1439ef" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186310910} {:answer-field/choices [{:answer/id #uuid "3dbb46f2-f6ce-5fd4-9165-956a10dd24b7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186309217} {:answer/id #uuid "5c67c65c-e450-555f-b668-cccb5f1bf987" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186309441} {:answer/id #uuid "9a608db6-cabb-52af-bbf2-20f8e0bf5a59" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the transitive property" :db/id 17592186309992} {:answer/id #uuid "b9863cfc-9ca7-5a80-86de-fa7f88e0d12e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the absorption property" :db/id 17592186310255} {:answer/id #uuid "c588907a-23dc-5e04-b672-1b60d23ba8b7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186310333} {:answer/id #uuid "e80a9562-4678-5dd7-8406-ffaa3ddd9242" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id 17592186310589}] :answer-field/correct {:answer/id #uuid "b9863cfc-9ca7-5a80-86de-fa7f88e0d12e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the absorption property" :db/id 17592186310255} :answer-field/id #uuid "593b990f-0917-5a0a-9583-6abf66430a1f" :answer-field/key "field-3" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311027} {:answer-field/choices [{:answer/id #uuid "28801ee7-4094-546f-80f1-323ab0a686c4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the reflexive property" :db/id 17592186309056} {:answer/id #uuid "936148be-c895-512e-a8b4-453974a921cc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id 17592186309927} {:answer/id #uuid "b1417f52-3430-53a8-89df-f2088b841205" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186310181} {:answer/id #uuid "b950e995-a80a-5abd-92df-e7f7d0acd62a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186310252} {:answer/id #uuid "d97fb2d7-a4f9-51c7-9e27-fd188021b12e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the transitive property" :db/id 17592186310498} {:answer/id #uuid "dc5916c2-7281-5d14-af22-17ed86e13bfe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186310514}] :answer-field/correct {:answer/id #uuid "28801ee7-4094-546f-80f1-323ab0a686c4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the reflexive property" :db/id 17592186309056} :answer-field/id #uuid "a8a6cb35-9607-5233-b317-7d1b4f617bba" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311283} {:answer-field/choices [{:answer/id #uuid "1615e325-2155-58bc-8224-1e266a097c9a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{L3}$ and $\\text{L4}$" :db/id 17592186308911} {:answer/id #uuid "9add62ef-516b-580e-83a4-1a29c85b07fc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L3}$ and $\\text{L4}" :db/id 17592186310000} {:answer/id #uuid "f4afa95d-fe0a-593f-bd7e-eadd38e090f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L2}$" :db/id 17592186310693}] :answer-field/correct {:answer/id #uuid "9add62ef-516b-580e-83a4-1a29c85b07fc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L3}$ and $\\text{L4}" :db/id 17592186310000} :answer-field/id #uuid "cf12da8d-9d68-5094-80cc-6cb07a044b47" :answer-field/key "field-4" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311395}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96c6b0d2-9e5e-5dae-9ba3-c5858d13dffd" :question/math-academy-id "q-335372" :question/problem "Consider the following statement. \n\nIf $f(x)={x}^{2}+3{x}^{3},$ then $f=O(x)$ as $x\\to 0.$\n\nA proof of the statement is given below.\n\n$\\text{L1}:\\,f=O({x}^{2}+3{x}^{3})$\n\n$\\text{L2}:\\,3{x}^{3}=O({x}^{2})$ as $x\\to 0$ \n\n$\\text{L3}:\\,f=O({x}^{2})$ as $x\\to 0$ \n\n$\\text{L4}:\\,{x}^{2}=O(x)$ as $x\\to 0$ \n\n$\\text{L5}:\\,f=O(x)$  as $x\\to 0$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L1}$ follows from {{field-1}}.\n\n$\\,$ Line $\\text{L3}$ follows from lines \n{{field-2}} and \n{{field-3}}.\n\n$\\,$ Line $\\text{L5}$ follows from lines {{field-4}}  and \n{{field-5}}." :question/worked-solution "Suppose $f(x),g(x),h(x)$ and $k(x)$ are functions and $c$ is a nonzero constant. Then, we have the following properties of Big-O notation. \n\n- The sum and product properties. If\n\n$$\nf=O(h)\\,\\text{and}\\,g=O(k)\\,\\text{as}\\,x\\to a\n$$\n\nthen\n\n$$\nf+g=O(h+k)\\,\\text{and}\\,fg=O(hk)\\,\\text{as}\\,x\\to a.\n$$\n\n- The constant multiple property. If\n\n$$\nf=O(cg)\\,\\text{as}\\,x\\to a,\n$$\n\nthen\n\n$$\nf=O(g)\\,\\text{as}\\,x\\to a.\n$$\n\n- The reflexive property.\n\n$$\nf=O(f)\\,\\text{as}\\,x\\to a.\n$$\n\n- The transitive property. If\n\n$$\nf=O(g)\\,\\text{and}\\,g=O(h)\\,\\text{as}\\,x\\to a,\n$$\n\nthen\n\n$$\nf=O(h)\\,\\text{as}\\,x\\to a.\n$$\n\n- The absorption property. If\n\n$$\nf=O(g+h)\\,\\text{and}\\,g=O(h)\\,\\text{as}\\,x\\to a,\n$$\n\nthen\n\n$$\nf=O(h)\\,\\text{as}\\,x\\to a.\n$$\n\nWith that in mind, let us justify each of the selected steps.\n\n- We first consider line $\\text{L1},$ which states that\n\n$$\nf=O({{{x}^{2}+3{x}^{3}}_{⏟}}_{f}).\n$$\n\nThis is true by $\\text{the reflexive property}.$\n\n- Next, we consider line $\\text{L3}.$ From line $\\text{L1}$ we have\n\n$$\nf=O({x}^{2}+3{x}^{3}),\n$$\n\nand from line $\\text{L2}$ we have\n\n$$\n3{x}^{3}=O({x}^{2})\\,\\text{as}\\,x\\to 0.\n$$\n\nThus, by lines $\\text{L1 and L2}$ and the $\\text{absorption property},$ we obtain\n\n$$\nf=O({x}^{2})\\,\\text{as}\\,x\\to 0.\n$$\n\n- Finally, we consider line $\\text{L5}.$ From line  $\\text{L3},$   we have\n\n$$\nf=O({x}^{2})\\,\\text{as}\\,x\\to 0,\n$$\n\nand from line  $\\text{L4},$   we have\n\n$$\n{x}^{2}=O(x)\\,\\text{as}\\,x\\to 0.\n$$\n\nThus, by lines $\\text{L3 and L4}$ and by $\\text{the transitive property},$  we conclude that\n\n$$\nf=O(x)\\,\\text{as}\\,x\\to 0.\n$$"} {:db/id 17592186311603 :knowledge-point/_questions [{:db/id 17592186157454 :knowledge-point/id #uuid "ffe4292f-7653-5486-975e-c206acae734e" :knowledge-point/title "Applying Properties of Big-O"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143783ba-f667-5508-b07b-b9fa079bbea9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186308897} {:answer/id #uuid "1c468251-7329-5d23-9077-e19b8e8726bf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id 17592186308967} {:answer/id #uuid "60059968-1161-56a5-a638-36fd6b700958" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the constant multiple property" :db/id 17592186309471} {:answer/id #uuid "608c36e3-b013-5cae-8a3d-d4b915200e1c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the transitive property" :db/id 17592186309481} {:answer/id #uuid "89337a20-49e6-5768-9a11-333a7f53f3dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186309826} {:answer/id #uuid "eef5ead3-fd02-5d0d-9d2c-f712b842ae71" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186310652}] :answer-field/correct {:answer/id #uuid "60059968-1161-56a5-a638-36fd6b700958" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the constant multiple property" :db/id 17592186309471} :answer-field/id #uuid "2338e512-f871-5a2b-96b3-b7edd9a12e71" :answer-field/key "field-5" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186310882} {:answer-field/choices [{:answer/id #uuid "10e0c284-dfa9-586a-859d-cb374ab6c810" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186308866} {:answer/id #uuid "6e340c18-83d4-5caa-9d42-631a793b81af" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the transitive property" :db/id 17592186309598} {:answer/id #uuid "7f07cd69-d846-5e83-ba64-32721887763f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186309740} {:answer/id #uuid "8193a9dc-0afb-50e9-97dc-85ae7e807bdf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186309766} {:answer/id #uuid "988c3458-7e4e-594f-be59-872df11e8345" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the reflexive property" :db/id 17592186309976} {:answer/id #uuid "da84f4f9-6862-5911-87b9-37216f79d0fe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id 17592186310502}] :answer-field/correct {:answer/id #uuid "988c3458-7e4e-594f-be59-872df11e8345" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the reflexive property" :db/id 17592186309976} :answer-field/id #uuid "7abcfe4d-7d0f-568e-8961-8711dde754ca" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311127} {:answer-field/choices [{:answer/id #uuid "1eb80ae0-4475-53b0-b767-6539e00085a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186308982} {:answer/id #uuid "1ef56c7f-e6d4-5e0b-aa1c-be0db62947a2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the absorption property" :db/id 17592186308983} {:answer/id #uuid "27392e2f-3b61-5656-8be3-d99f2dfdc877" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186309041} {:answer/id #uuid "4e86256e-8dd6-5869-bff0-345eb7c43c05" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id 17592186309344} {:answer/id #uuid "53baddac-f332-5936-a986-ae4bfd061ce8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the transitive property" :db/id 17592186309384} {:answer/id #uuid "98263ff2-83bf-5aad-9003-1ffa9ffc22c7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186309971}] :answer-field/correct {:answer/id #uuid "1ef56c7f-e6d4-5e0b-aa1c-be0db62947a2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "the absorption property" :db/id 17592186308983} :answer-field/id #uuid "7d4a9262-8976-5f35-9725-43cb6bdeb4ad" :answer-field/key "field-3" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311134} {:answer-field/choices [{:answer/id #uuid "0a6814f5-e866-5fe5-878e-c7235eb166cf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L3}" :db/id 17592186308823} {:answer/id #uuid "64ee81db-16fa-5644-b095-3e4632fbe782" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L4}" :db/id 17592186309526} {:answer/id #uuid "90e015c4-a1c7-56c9-8433-71b3bce91c89" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L2}" :db/id 17592186309904}] :answer-field/correct {:answer/id #uuid "64ee81db-16fa-5644-b095-3e4632fbe782" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L4}" :db/id 17592186309526} :answer-field/id #uuid "c157cf82-f9c9-50e6-a2b6-44c93ac64447" :answer-field/key "field-4" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311350} {:answer-field/choices [{:answer/id #uuid "4a42022f-7c55-5341-8a71-56f0670cab7c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L1}$ and $\\text{L3}" :db/id 17592186309316} {:answer/id #uuid "b444a702-e48d-504b-b675-4af0291e43e4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L3}$" :db/id 17592186310205} {:answer/id #uuid "eb9fc32d-7c39-5620-8ef0-261050236004" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{L2}$ and $\\text{L3}$" :db/id 17592186310622}] :answer-field/correct {:answer/id #uuid "4a42022f-7c55-5341-8a71-56f0670cab7c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L1}$ and $\\text{L3}" :db/id 17592186309316} :answer-field/id #uuid "ed276b83-ff95-5f0d-bc21-ce63f9f8c15f" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311484}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6ca3d19-1c03-5a3f-9e6d-713b90d2c7f4" :question/math-academy-id "q-335474" :question/problem "Consider the following statement. \n\nIf $f(x)=4{x}^{2}-x+5,$ then $f=O(1)$ as $x\\to 0.$\n\nA proof of the statement is given below.\n\n$\\text{L1}:\\,f=O(4{x}^{2}-x+5)$\n\n$\\text{L2}:\\,{lim}_{x\\to 0}(\\frac{4{x}^{2}-x}{5})=0$  \n\n$\\text{L3}:\\,4{x}^{2}-x=O(5)$  as $x\\to 0$ \n\n$\\text{L4}:\\,f=O(5)$  as $x\\to 0$   \n\n$\\text{L5}:\\,f=O(1)$  as $x\\to 0$ \n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L1}$ follows from  \n{{field-1}}.\n\n$\\,$ Line $\\text{L4}$ follows from lines  \n{{field-2}}  \nand  \n{{field-3}}.\n\n$\\,$ Line $\\text{L5}$ follows from line  \n{{field-4}}  \nand  \n{{field-5}}." :question/worked-solution "Suppose $f(x),g(x),h(x)$ and $k(x)$ are functions and $c$ is a nonzero constant. Then, we have the following properties of Big-O notation.\n\n- The sum and product properties. If\n\n$$\nf=O(h)\\,\\text{and}\\,g=O(k)\\,\\text{as}\\,x\\to a,\n$$\n\nthen\n\n$$\nf+g=O(h+k)\\,\\text{and}\\,fg=O(hk)\\,\\text{as}\\,x\\to a.\n$$\n\n- The constant multiple property. If\n\n$$\nf=O(cg)\\,\\text{as}\\,x\\to a,\n$$\n\nthen\n\n$$\nf=O(g)\\,\\text{as}\\,x\\to a.\n$$\n\n- The reflexive property.\n\n$$\nf=O(f)\\,\\text{as}\\,x\\to a.\n$$\n\n- The transitive property. If\n\n$$\nf=O(g)\\,\\text{and}\\,g=O(h)\\,\\text{as}\\,x\\to a,\n$$\n\nthen\n\n$$\nf=O(h)\\,\\text{as}\\,x\\to a.\n$$\n\n- The absorption property. If\n\n$$\nf=O(g+h)\\,\\text{and}\\,g=O(h)\\,\\text{as}\\,x\\to a,\n$$\n\nthen\n\n$$\nf=O(h)\\,\\text{as}\\,x\\to a.\n$$\n\nWith that in mind, let us justify each selected step.\n\n- We first consider line $\\text{L1},$ which states that\n\n$$\nf=O({{4{x}^{2}-x+5}_{⏟}}_{f}).\n$$\n\nThis is true by $\\text{the reflexive property}.$\n\n- Next, we consider line $\\text{L4}.$ From line $\\text{L1}$ we have\n\n$$\nf=O(4{x}^{2}-x+5),\n$$\n\nand from line $\\text{L3}$ we have\n\n$$\n4{x}^{2}-x=O(5)\\,\\text{as}\\,x\\to 0.\n$$\n\nThus, by lines $\\text{L1 and L3}$ and $\\text{the absorption property},$ we obtain\n\n$$\nf=O(5)\\,\\text{as}\\,x\\to 0.\n$$\n\n- Finally, we consider line $\\text{L5}.$ From line $\\text{L4}$ we have\n\n$$\nf=O(5)\\,\\text{as}\\,x\\to 0.\n$$\n\nSince $5$ is just a constant multiple of $1,$ it follows by $\\text{the constant multiple property}$ that\n\n$$\nf=O(1)\\,\\text{as}\\,x\\to 0.\n$$"} {:db/id 17592186311737 :knowledge-point/_questions [{:db/id 17592186166937 :knowledge-point/id #uuid "7d23f2a1-55fa-5398-9016-dc6fbc55c97b" :knowledge-point/title "Finding the Particular Solution of an Inhomogeneous System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03391546-51e2-592b-b33e-96a0e7dadad4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186308770}] :answer-field/correct {:answer/id #uuid "03391546-51e2-592b-b33e-96a0e7dadad4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186308770} :answer-field/id #uuid "a4cc6a92-1dbb-533a-bde1-5f5375f2fb88" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186311269} {:answer-field/choices [{:answer/id #uuid "c40bb4a2-ee82-5c62-8098-95674097c15b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{-3t}" :db/id 17592186310321}] :answer-field/correct {:answer/id #uuid "c40bb4a2-ee82-5c62-8098-95674097c15b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{-3t}" :db/id 17592186310321} :answer-field/id #uuid "fa3b02da-876b-5e0a-8cf7-c53cb24cd812" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186311526}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ea97844-39dd-5c98-b9ff-e503c4be0f51" :question/math-academy-id "q-336699" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}1 & 2 \\\\ 0 & 3\\end{bmatrix}x(t)+\\overset{f(t)}{\\overset{⏞}{\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}}},\\,Φ=\\begin{bmatrix}{e}^{t} & {e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n| ${Φ}^{-1}\\,f(t)=\\,\\,$ |  | $5{e}^{-t}$ |  | $\\,,\\,$ | ${x}_{p}(t)=\\,\\,$ |  | $-4$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} |  |  | {{field-2}} |  |  |  |  |  |" :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}{e}^{t} & {e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{t}\\cdot {e}^{3t}-({e}^{3t})\\cdot 0}\\begin{bmatrix}{e}^{3t} & -{e}^{3t} \\\\ 0 & {e}^{t}\\end{bmatrix} \\\\  & ={e}^{-4t}\\begin{bmatrix}{e}^{3t} & -{e}^{3t} \\\\ 0 & {e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{-t} & -{e}^{-t} \\\\ 0 & {e}^{-3t}\\end{bmatrix} \\\\ {Φ}^{-1}\\,f(t) & =\\begin{bmatrix}{e}^{-t} & -{e}^{-t} \\\\ 0 & {e}^{-3t}\\end{bmatrix}\\begin{bmatrix}2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{e}^{-t} \\\\ -3{e}^{-3t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}5{e}^{-t} \\\\ -3{e}^{-3t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int 5{e}^{-t}\\,\\text{d}t \\\\ \\int -3{e}^{-3t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5{e}^{-t} \\\\ {e}^{-3t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}{e}^{t} & {e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}\\begin{bmatrix}-5{e}^{-t} \\\\ {e}^{-3t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186311821 :knowledge-point/_questions [{:db/id 17592186166937 :knowledge-point/id #uuid "7d23f2a1-55fa-5398-9016-dc6fbc55c97b" :knowledge-point/title "Finding the Particular Solution of an Inhomogeneous System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d66787-66e5-569a-91da-fb16e858ec7d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{-4t}" :db/id 17592186309980}] :answer-field/correct {:answer/id #uuid "98d66787-66e5-569a-91da-fb16e858ec7d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{-4t}" :db/id 17592186309980} :answer-field/id #uuid "33380138-39c7-5cc1-be02-40c0352385d9" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186310928} {:answer-field/choices [{:answer/id #uuid "57fa1d40-985b-5dc8-bff3-11325100380c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186309411}] :answer-field/correct {:answer/id #uuid "57fa1d40-985b-5dc8-bff3-11325100380c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186309411} :answer-field/id #uuid "74228cec-035c-567c-bcee-7a90efcf66d3" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186311105}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c98926c-5044-5e94-be2a-fc638fdc3f93" :question/math-academy-id "q-337230" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}1 & 0 \\\\ 0 & 4\\end{bmatrix}x(t)+\\overset{f(t)}{\\overset{⏞}{\\begin{bmatrix}2 \\\\ -8\\end{bmatrix}}},\\,Φ=\\begin{bmatrix}{e}^{t} & 0 \\\\ 0 & {e}^{4t}\\end{bmatrix}\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n| ${Φ}^{-1}\\,f(t)=\\,\\,$ |  | $2{e}^{-t}$ |  | $\\,,\\,$ | ${x}_{p}(t)=\\,\\,$ |  | $-2$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} |  |  | {{field-2}} |  |  |  |  |  |" :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}{e}^{t} & 0 \\\\ 0 & {e}^{4t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}2 \\\\ -8\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{t}\\cdot {e}^{4t}-0\\cdot 0}\\begin{bmatrix}{e}^{4t} & 0 \\\\ 0 & {e}^{t}\\end{bmatrix} \\\\  & ={e}^{-5t}\\begin{bmatrix}{e}^{4t} & 0 \\\\ 0 & {e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{-t} & 0 \\\\ 0 & {e}^{-4t}\\end{bmatrix}. \\\\ {Φ}^{-1}\\,f(t) & =\\begin{bmatrix}{e}^{-t} & 0 \\\\ 0 & {e}^{-4t}\\end{bmatrix}\\begin{bmatrix}2 \\\\ -8\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{e}^{-t} \\\\ -8{e}^{-4t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}2{e}^{-t} \\\\ -8{e}^{-4t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int 2{e}^{-t}\\,\\text{d}t \\\\ \\int -8{e}^{-4t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2{e}^{-t} \\\\ 2{e}^{-4t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}{e}^{t} & 0 \\\\ 0 & {e}^{4t}\\end{bmatrix}\\begin{bmatrix}-2{e}^{-t} \\\\ 2{e}^{-4t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186311828 :knowledge-point/_questions [{:db/id 17592186166937 :knowledge-point/id #uuid "7d23f2a1-55fa-5398-9016-dc6fbc55c97b" :knowledge-point/title "Finding the Particular Solution of an Inhomogeneous System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e50ee6-2518-5d34-a3e2-4799e3d17703" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{2t}" :db/id 17592186309180}] :answer-field/correct {:answer/id #uuid "38e50ee6-2518-5d34-a3e2-4799e3d17703" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{2t}" :db/id 17592186309180} :answer-field/id #uuid "573e1e64-9846-5e0e-bb82-38a0518ddaaf" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186311021} {:answer-field/choices [{:answer/id #uuid "7781a288-b83b-5516-8d03-ce94842577fc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-1}{3}" :db/id 17592186309684}] :answer-field/correct {:answer/id #uuid "7781a288-b83b-5516-8d03-ce94842577fc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-1}{3}" :db/id 17592186309684} :answer-field/id #uuid "7a42318d-7765-5b03-b495-8b35312f578c" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186311126}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ac8d1ba-163b-54eb-addd-dba5b1956964" :question/math-academy-id "q-337280" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}4 & 0 \\\\ -5 & -1\\end{bmatrix}x(t)+\\overset{f(t)}{\\overset{⏞}{\\begin{bmatrix}{e}^{t} \\\\ 4{e}^{t}\\end{bmatrix}}},\\,Φ=\\begin{bmatrix}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{bmatrix}\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n| ${Φ}^{-1}\\,f(t)=\\,\\,$ |  | {{field-1}} |  | $\\,,\\,$ | ${x}_{p}(t)={e}^{t}\\,\\,$ |  | {{field-2}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $\\frac{1}{3}{e}^{-3t}$ |  |  | $\\frac{17}{6}$ |  |  |  |  |  |" :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}{e}^{t} \\\\ 4{e}^{t}\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-3{e}^{4t})-3{e}^{4t}\\cdot {e}^{-t}}\\begin{bmatrix}-3{e}^{4t} & -3{e}^{4t} \\\\ -{e}^{-t} & 0\\end{bmatrix} \\\\  & =-\\frac{{e}^{-3t}}{3}\\begin{bmatrix}-3{e}^{4t} & -3{e}^{4t} \\\\ -{e}^{-t} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ \\frac{1}{3}{e}^{-4t} & 0\\end{bmatrix} \\\\ {Φ}^{-1}\\,f(t) & =\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ \\frac{1}{3}{e}^{-4t} & 0\\end{bmatrix}\\begin{bmatrix}{e}^{t} \\\\ 4{e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{e}^{2t} \\\\ \\frac{1}{3}{e}^{-3t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}5{e}^{2t} \\\\ \\frac{1}{3}{e}^{-3t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int 5{e}^{2t}\\,\\text{d}t \\\\ \\int \\frac{1}{3}{e}^{-3t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{2}{e}^{2t} \\\\ -\\frac{1}{9}{e}^{-3t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{bmatrix}\\begin{bmatrix}\\frac{5}{2}{e}^{2t} \\\\ -\\frac{1}{9}{e}^{-3t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{3}{e}^{t} \\\\ \\frac{17}{6}{e}^{t}\\end{bmatrix} \\\\  & ={e}^{t}\\begin{bmatrix}-\\frac{1}{3} \\\\ \\frac{17}{6}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186311829 :knowledge-point/_questions [{:db/id 17592186166937 :knowledge-point/id #uuid "7d23f2a1-55fa-5398-9016-dc6fbc55c97b" :knowledge-point/title "Finding the Particular Solution of an Inhomogeneous System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "849dc5ee-b92a-5d12-862e-038289763703" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "22\\frac{{e}^{-t}}{5}" :db/id 17592186309779} {:answer/id #uuid "69172624-3326-54b0-b3c7-c380d2de2937" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22}{5}e^{-t}" :db/id 17592186482994}] :answer-field/correct {:answer/id #uuid "69172624-3326-54b0-b3c7-c380d2de2937" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22}{5}e^{-t}" :db/id 17592186482994} :answer-field/id #uuid "b2ec8789-f8e2-5bcb-a05b-12d156ee8c7e" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186311313} {:answer-field/choices [{:answer/id #uuid "64f9f8a0-0df1-5b62-8c16-587f7c825e12" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id 17592186309527}] :answer-field/correct {:answer/id #uuid "64f9f8a0-0df1-5b62-8c16-587f7c825e12" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id 17592186309527} :answer-field/id #uuid "ccc76a66-e26b-5e7b-8d53-6b7b589d9a0c" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186311389}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a91efb90-d803-5dba-81eb-b92f394b29e5" :question/math-academy-id "q-337281" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}-3 & 0 \\\\ 4 & 2\\end{bmatrix}x(t)+\\overset{f(t)}{\\overset{⏞}{\\begin{bmatrix}3{e}^{t} \\\\ 2{e}^{t}\\end{bmatrix}}},\\,Φ=\\begin{bmatrix}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{bmatrix}\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${Φ}^{-1}\\,f(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,,\\,$</td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${x}_{p}(t)={e}^{t}\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"60px\" width=\"5px\"></td>\n<td align=\"center\">$\\frac{3}{5}{e}^{4t}$</td>\n<td align=\"center\"></td>\n<td height=\"60px\" width=\"5px\"></td>\n<td align=\"center\">$-5$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}3{e}^{t} \\\\ 2{e}^{t}\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-4{e}^{-3t})-5{e}^{-3t}\\cdot {e}^{2t}}\\begin{bmatrix}-4{e}^{-3t} & -5{e}^{-3t} \\\\ -{e}^{2t} & 0\\end{bmatrix} \\\\  & =-\\frac{{e}^{t}}{5}\\begin{bmatrix}-4{e}^{-3t} & -5{e}^{-3t} \\\\ -{e}^{2t} & 0\\end{bmatrix} \\\\  & =-\\frac{1}{5}\\begin{bmatrix}-4{e}^{-2t} & -5{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{bmatrix} \\\\ {Φ}^{-1}\\,f(t) & =-\\frac{1}{5}\\begin{bmatrix}-4{e}^{-2t} & -5{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{bmatrix}\\begin{bmatrix}3{e}^{t} \\\\ 2{e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{5}{e}^{4t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{5}{e}^{4t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int \\frac{22}{5}{e}^{-t}\\,\\text{d}t \\\\ \\int \\frac{3}{5}{e}^{4t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{20}{e}^{4t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{bmatrix}\\begin{bmatrix}-\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{20}{e}^{4t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{3}{4}{e}^{t} \\\\ -5{e}^{t}\\end{bmatrix} \\\\  & ={e}^{t}\\begin{bmatrix}\\frac{3}{4} \\\\ -5\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186311858 :knowledge-point/_questions [{:db/id 17592186229140 :knowledge-point/id #uuid "b165305b-42f4-584a-9f8f-9455e5a05a9e" :knowledge-point/title "Solving a Differential Equation Whose Characteristic Equation Has Real Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f063173-e6fe-5d2a-99b7-378065d2b1d1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+\\frac{3x}{7}){e}^{-4x}" :db/id 17592186308984} {:answer/id #uuid "40cef204-8013-5a17-b8d9-ae936e8062e3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+\\frac{2x}{5}){e}^{-4x}" :db/id 17592186309242} {:answer/id #uuid "6700055d-6c65-5ea7-bc2b-4856d3527804" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+\\frac{2x}{7}){e}^{-4x}" :db/id 17592186309538} {:answer/id #uuid "67a87526-29fc-5bf6-8e12-907f098b41ff" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+\\frac{x}{7}){e}^{-4x}" :db/id 17592186309542} {:answer/id #uuid "8a51098b-f1b1-5736-8996-e4133727d23f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+\\frac{x}{3}){e}^{-4x}" :db/id 17592186309834}] :answer-field/correct {:answer/id #uuid "6700055d-6c65-5ea7-bc2b-4856d3527804" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+\\frac{2x}{7}){e}^{-4x}" :db/id 17592186309538} :answer-field/id #uuid "b5b23d5d-5883-57bd-8005-c893ed0c9ce4" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186311319}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0163f286-fc30-51ed-907e-500011ffd762" :question/math-academy-id "q-337541" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{″}+{y}^{′}-12y=14x{e}^{-4x}\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)=A{e}^{-4x}+B{e}^{3x}+g(x),\n$$\n\nwhere $A$ and $B$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method. You may also wish to make use of the following result (integration constants omitted):*\n\n$$\n\\int x{e}^{-7x}\\,\\text{d}x=-\\frac{1}{49}(7x+1){e}^{-7x}\n$$" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFirst, we note that the forcing term is $f(x)=14x{e}^{-4x}.$\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)=A{e}^{-4x}+B{e}^{3x}.\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)={e}^{-4x},\\,{y}_{2}(x)={e}^{3x}.\n$$\n\nWe can use the method of variation of parameters if these solutions are independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =({e}^{-4x})({e}^{3x})^{′}-({e}^{-4x})^{′}({e}^{3x}) \\\\  & =({e}^{-4x})(3{e}^{3x})-(-4{e}^{-4x})({e}^{3x}) \\\\  & =3{e}^{-x}+4{e}^{-x} \\\\  & =7{e}^{-x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent. \n\nLet's compute ${u}_{1}(x)$ and ${u}_{2}(x)$:\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{14x{e}^{-4x}\\cdot {e}^{3x}}{7{e}^{-x}}\\,\\text{d}x \\\\  & =-2\\int x\\,\\text{d}x \\\\  & =-{x}^{2} \\\\ {u}_{2}(x) & =\\int \\frac{14x{e}^{-4x}\\cdot {e}^{-4x}}{7{e}^{-x}}\\,\\text{d}x \\\\  & =2\\int x{e}^{-7x}\\,\\text{d}x \\\\  & =-\\frac{2}{49}(7x+1){e}^{-7x}\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(-{x}^{2})({e}^{-4x})+[-\\frac{2}{49}(7x+1){e}^{-7x}]({e}^{3x}) \\\\  & =-{x}^{2}{e}^{-4x}-\\frac{2}{49}(7x+1){e}^{-4x} \\\\  & =(-{x}^{2}-\\frac{2x}{7}-\\frac{2}{49}){e}^{-4x}.\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{e}^{-4x}+B{e}^{3x}+(-{x}^{2}-\\frac{2x}{7}-\\frac{2}{49}){e}^{-4x} \\\\  & =(A-\\frac{2}{49}){e}^{-4x}+B{e}^{3x}-({x}^{2}+\\frac{2x}{7}){e}^{-4x}\\end{aligned}\n$$\n\nIf we redefine the arbitrary constant $A$ as\n\n$$\nA:=(A-\\frac{2}{49})\n$$\n\nour general solution becomes\n\n$$\n\\begin{aligned}y & =A{e}^{-4x}+B{e}^{3x}{{-({x}^{2}+\\frac{2x}{7}){e}^{-4x}}_{⏟}}_{g(x)}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)=-({x}^{2}+\\frac{2x}{7}){e}^{-4x}.\n$$"} {:db/id 17592186311859 :knowledge-point/_questions [{:db/id 17592186229140 :knowledge-point/id #uuid "b165305b-42f4-584a-9f8f-9455e5a05a9e" :knowledge-point/title "Solving a Differential Equation Whose Characteristic Equation Has Real Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171820f6-30ed-5588-9d9f-ae89ea64bf9f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-(2{x}^{2}+2x){e}^{2x}" :db/id 17592186308926} {:answer/id #uuid "2ae72169-4c78-54cf-8b3e-2be5025f1f7c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+4x){e}^{2x}" :db/id 17592186309068} {:answer/id #uuid "34b70d06-be1f-59e2-9c02-d9b514336497" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-(2{x}^{2}+4x){e}^{2x}" :db/id 17592186309148} {:answer/id #uuid "6209ddcb-6a48-51fd-8dfb-891016dbc9cb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+2x){e}^{2x}" :db/id 17592186309492} {:answer/id #uuid "7fec3179-09de-5daa-bae5-95bf70d07b7c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{3}+2x){e}^{2x}" :db/id 17592186309749}] :answer-field/correct {:answer/id #uuid "6209ddcb-6a48-51fd-8dfb-891016dbc9cb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-({x}^{2}+2x){e}^{2x}" :db/id 17592186309492} :answer-field/id #uuid "a2ff2b65-d0aa-53cb-b248-127485889b15" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186311266}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e73f606-8353-55fe-86c8-a1f3dc9ab5eb" :question/math-academy-id "q-337542" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{″}-5{y}^{′}+6y=2x{e}^{2x}\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)=A{e}^{2x}+B{e}^{3x}+g(x),\n$$\n\nwhere $A$ and $B$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method. You may also wish to make use of the following result (integration constants omitted):*\n\n$$\n\\int x{e}^{-x}dx=-(x+1){e}^{-x}\n$$" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFirst, we note that the forcing term is $f(x)=2x{e}^{2x}.$\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)=A{e}^{2x}+B{e}^{3x}.\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)={e}^{2x},\\,{y}_{2}(x)={e}^{3x}.\n$$\n\nWe can use the method of variation of parameters if these solutions are independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =({e}^{2x})({e}^{3x})^{′}-({e}^{2x})^{′}({e}^{3x}) \\\\  & =({e}^{2x})(3{e}^{3x})-(2{e}^{2x})({e}^{3x}) \\\\  & =3{e}^{5x}-2{e}^{5x} \\\\  & ={e}^{5x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent. \n\nLet's compute ${u}_{1}(x)$ and ${u}_{2}(x)$:\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{2x{e}^{2x}\\cdot {e}^{3x}}{{e}^{5x}}\\,\\text{d}x \\\\  & =-\\int 2x\\,\\text{d}x \\\\  & =-{x}^{2} \\\\ {u}_{2}(x) & =\\int \\frac{2x{e}^{2x}\\cdot {e}^{2x}}{{e}^{5x}}\\,\\text{d}x \\\\  & =2\\int x{e}^{-x}\\text{ }\\,\\text{d}x \\\\  & =-2(x+1){e}^{-x}\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(-{x}^{2})({e}^{2x})+[-2(x+1){e}^{-x}({e}^{3x})] \\\\  & =-{x}^{2}{e}^{2x}-2(x+1){e}^{2x} \\\\  & =-({x}^{2}+2x+2){e}^{2x}.\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{e}^{2x}+B{e}^{3x}-({x}^{2}+2x+2){e}^{2x} \\\\  & =(A-2){e}^{2x}+B{e}^{3x}-({x}^{2}+2x){e}^{2x}\\end{aligned}\n$$\n\nIf we redefine the arbitrary constant $A$ as\n\n$$\nA:=(A-2)\n$$\n\nour general solution becomes\n\n$$\n\\begin{aligned}y & =A{e}^{2x}+B{e}^{3x}\\,{{-\\,({x}^{2}+2x){e}^{2x}}_{⏟}}_{g(x)}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)=-({x}^{2}+2x){e}^{2x}.\n$$"} {:db/id 17592186311860 :knowledge-point/_questions [{:db/id 17592186229140 :knowledge-point/id #uuid "b165305b-42f4-584a-9f8f-9455e5a05a9e" :knowledge-point/title "Solving a Differential Equation Whose Characteristic Equation Has Real Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e5abb6f-5e08-56e9-914b-9e552004de67" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{2x}\\operatorname{ln}⁡|x|" :db/id 17592186309343} {:answer/id #uuid "9c061ea9-9f13-52cb-98a8-ba50801a69d1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-x{e}^{2x}\\operatorname{ln}⁡|x|" :db/id 17592186310009} {:answer/id #uuid "ab28e6b5-91dd-5722-bf96-b9c08de9b1e2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4{e}^{2x}\\operatorname{ln}⁡|x|" :db/id 17592186310133} {:answer/id #uuid "b24de0d4-ef39-5e91-8eb7-4502575f46de" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2x{e}^{2x}\\operatorname{ln}⁡|x|" :db/id 17592186310189} {:answer/id #uuid "dde19e16-0392-5e2e-ade5-eca93831d4f4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{2x}\\operatorname{ln}⁡|x|" :db/id 17592186310527}] :answer-field/correct {:answer/id #uuid "dde19e16-0392-5e2e-ade5-eca93831d4f4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{2x}\\operatorname{ln}⁡|x|" :db/id 17592186310527} :answer-field/id #uuid "6dc6fe2c-ab12-5155-b3c2-977ab6f2f2fb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186311083}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6341a1d8-e09a-59b9-84dc-d4331496dbcb" :question/math-academy-id "q-337547" :question/problem "Consider the following differential equation\n\n$$\n{y}^{″}-4{y}^{′}+4y=\\frac{{e}^{2x}}{{x}^{2}}.\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)=A{e}^{2x}+Bx{e}^{2x}+g(x),\n$$\n\nwhere $A$ and $B$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method.*" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)=A{e}^{2x}+Bx{e}^{2x}.\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)={e}^{2x},\\,{y}_{2}(x)=x{e}^{2x}.\n$$\n\nWe can use the method of variation of parameters if these solutions are independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =({e}^{2x})(x{e}^{2x})^{′}-({e}^{2x})^{′}(x{e}^{2x}) \\\\  & =({e}^{2x})({e}^{2x}+2x{e}^{2x})-(2{e}^{2x})(x{e}^{2x}) \\\\  & ={e}^{4x}+2x{e}^{4x}-2x{e}^{4x} \\\\  & ={e}^{4x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent. \n\nLet's compute ${u}_{1}(x)$ and ${u}_{2}(x):$\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{{e}^{2x}\\cdot x{e}^{2x}}{{x}^{2}{e}^{4x}}\\,\\text{d}x \\\\  & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\operatorname{ln}⁡|x| \\\\ {u}_{2}(x) & =\\int \\frac{{e}^{2x}\\cdot {e}^{2x}}{{x}^{2}{e}^{4x}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =-\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(-\\operatorname{ln}⁡|x|)({e}^{2x})+(-\\frac{1}{x})(x{e}^{2x}) \\\\  & =-{e}^{2x}(\\operatorname{ln}⁡|x|+1).\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{e}^{2x}+Bx{e}^{2x}-{e}^{2x}(\\operatorname{ln}⁡|x|+1) \\\\  & =(A-1){e}^{2x}+Bx{e}^{2x}-{e}^{2x}\\operatorname{ln}⁡|x|\\end{aligned}\n$$\n\nIf we redefine the arbitrary constant $A$ as\n\n$$\nA:=(A-1)\n$$\n\nour general solution becomes\n\n$$\n\\begin{aligned}y & =A{e}^{2x}+Bx{e}^{2x}{{\\,-\\,{e}^{2x}\\operatorname{ln}⁡|x|}_{⏟}}_{g(x)}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)=-{e}^{2x}\\operatorname{ln}⁡|x|.\n$$"} {:db/id 17592186311861 :knowledge-point/_questions [{:db/id 17592186229140 :knowledge-point/id #uuid "b165305b-42f4-584a-9f8f-9455e5a05a9e" :knowledge-point/title "Solving a Differential Equation Whose Characteristic Equation Has Real Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49cfa1a5-d955-5830-8e0f-67dba30d0ad0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{4{x}^{2}}" :db/id 17592186309312} {:answer/id #uuid "697c3eac-9905-5459-b6f5-4386fe61c9be" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{{x}^{2}}" :db/id 17592186309565} {:answer/id #uuid "77cc720c-1b84-519a-8d85-b5fb90614e1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{2x}" :db/id 17592186309688} {:answer/id #uuid "8e8951e1-1553-59dc-b7ed-9ee06f0591da" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{4x}" :db/id 17592186309883} {:answer/id #uuid "dec14dcd-f50b-57c7-a3f9-c7865ab0e38c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{x}" :db/id 17592186310537}] :answer-field/correct {:answer/id #uuid "77cc720c-1b84-519a-8d85-b5fb90614e1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{2x}" :db/id 17592186309688} :answer-field/id #uuid "4e1074fc-b51f-50f9-a46d-dbca7d5b9a33" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186310998}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93b3e0e9-58f0-5e42-bcb7-8d7fbdbe1863" :question/math-academy-id "q-337548" :question/problem "Consider the following differential equation\n\n$$\n{y}^{″}+2{y}^{′}+y=\\frac{{e}^{-x}}{{x}^{3}}.\n$$\n\nThe general solution to this equation can be written as\n\n$$\ny(x)=A{e}^{-x}+Bx{e}^{-x}+g(x),\n$$\n\nwhere $A$ and $B$ are constants. Which of the following could be the function $g(x)?$\n\n*Hint: Use the variation of parameters method.*" :question/worked-solution "Suppose we have a second-order linear differential equation with linearly independent fundamental solutions ${y}_{1}(x)$ and ${y}_{2}(x).$ Then, according to the method of variation of parameters, we can seek a particular solution ${y}_{p}$ using the ansatz\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x),\\end{aligned}\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ satisfy the following system:\n\n$$\n\\left\\{\\begin{aligned}{u}_{1}^{′}{y}_{1}^{′}+{u}_{2}^{′}{y}_{2}^{′} &=f(x) \\\\ {u}_{1}^{′}{y}_{1}+{u}_{2}^{′}{y}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe solution to this system is\n\n$$\n{u}_{1}(x)=-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x,\\,{u}_{2}(x)=\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x\n$$\n\nwhere $W({y}_{1},{y}_{2})$ is the Wronskian.\n\nFrom the given information, we see that the complementary solution is\n\n$$\n{y}_{c}(x)=A{e}^{-x}+Bx{e}^{-x}.\n$$\n\nTherefore, the fundamental solutions to the corresponding homogeneous equation are\n\n$$\n{y}_{1}(x)={e}^{-x},\\,{y}_{2}(x)=x{e}^{-x}.\n$$\n\nWe can use the method of variation of parameters if these solutions are independent. So, let's first compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =({e}^{-x})(x{e}^{-x})^{′}-({e}^{-x})^{′}(x{e}^{-x}) \\\\  & =({e}^{-x})({e}^{-x}-x{e}^{-x})-(-{e}^{-x})(x{e}^{-x}) \\\\  & ={e}^{-2x}-x{e}^{-2x}+x{e}^{-2x} \\\\  & ={e}^{-2x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent.\n\nLet's compute ${u}_{1}(x)$ and ${u}_{2}(x):$\n\n$$\n\\begin{aligned}{u}_{1}(x) & =-\\int \\frac{{e}^{-x}\\cdot x{e}^{-x}}{{x}^{3}{e}^{-2x}}\\,\\text{d}x \\\\  & =-\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{x} \\\\ {u}_{2}(x) & =\\int \\frac{{e}^{-x}\\cdot {e}^{-x}}{{x}^{3}{e}^{-2x}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{1}{2{x}^{2}}\\end{aligned}\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={u}_{1}{y}_{1}+{u}_{2}{y}_{2} \\\\  & =(\\frac{1}{x}){e}^{-x}+(-\\frac{1}{2{x}^{2}})x{e}^{-x} \\\\  & =\\frac{{e}^{-x}}{x}-\\frac{{e}^{-x}}{2x} \\\\  & =\\frac{{e}^{-x}}{2x}.\\end{aligned}\n$$\n\nThe general solution is the sum of the complementary and particular solutions, and can be written as follows:\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{e}^{-x}+Bx{e}^{-x}+{{\\frac{{e}^{-x}}{2x}}_{⏟}}_{g(x)}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\ng(x)=\\frac{{e}^{-x}}{2x}.\n$$"} {:db/id 17592186311864 :knowledge-point/_questions [{:db/id 17592186217250 :knowledge-point/id #uuid "1a016197-61af-57f3-9c3a-05410db1374d" :knowledge-point/title "Solving Inexact Differential Equations Using Integrating Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04dd3513-0642-5de4-be16-d4bc511b2663" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id 17592186308782} {:answer/id #uuid "40109527-2da6-5399-9922-7e9d518987c1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id 17592186309237} {:answer/id #uuid "609d8f66-0ba6-5f9a-8e8f-b8027b9814d1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id 17592186309483} {:answer/id #uuid "e126aa57-9a75-5745-b52d-fda7d4fa7971" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id 17592186310549}] :answer-field/correct {:answer/id #uuid "40109527-2da6-5399-9922-7e9d518987c1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id 17592186309237} :answer-field/id #uuid "878292fb-d89c-5d5b-a679-78ab004bc741" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311177} {:answer-field/choices [{:answer/id #uuid "63bad373-7338-58aa-906e-eb34efc7bf4f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+y=c" :db/id 17592186309513} {:answer/id #uuid "a9003b3f-7a31-5040-b685-09977b462248" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{1}{3}{x}^{3}{y}^{3}+2y=c" :db/id 17592186310114} {:answer/id #uuid "d0fcd743-a7be-56d3-bd31-82e8db685454" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y=c" :db/id 17592186310427} {:answer/id #uuid "d22db97e-e112-5d17-a5e0-7ec914407346" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{2}+{x}^{3}{y}^{3}+y=c" :db/id 17592186310439}] :answer-field/correct {:answer/id #uuid "d0fcd743-a7be-56d3-bd31-82e8db685454" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y=c" :db/id 17592186310427} :answer-field/id #uuid "df51da9d-27f4-5dcc-802f-21eb4fe9d87a" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311441}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24f77cc5-eae7-5d74-9490-65584fc368cc" :question/math-academy-id "q-337637" :question/problem "Consider the inexact differential equation\n\n$$\n(\\frac{5{y}^{2}}{x}+2{y}^{3})\\,\\text{d}x+(5y+2x{y}^{2}+\\frac{2}{{x}^{2}})\\,\\text{d}y=0.\n$$\n\nIt is known that \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=\\frac{2}{x}\n$$\n\nwhere the functions $P$ and $Q$ are given by \n\n$$\nP(x,y)=\\frac{5{y}^{2}}{x}+2{y}^{3},\\,Q(x,y)=5y+2x{y}^{2}+\\frac{2}{{x}^{2}}.\n$$\n\nUse this information to find a suitable integrating factor $I(x)$ and hence find the general solution to the equation.$\\,$ A suitable integrating factor is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is {{field-2}}, where $c$ is a constant." :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)=\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x)\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nWe are given that \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=\\frac{2}{x}.\n$$\n\nSince $\\frac{2}{x}$ is a function of $x$ only, we can conclude that the integrating factor for the equation is \n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int 2{x}^{-1}\\text{ }\\text{d}x} \\\\  & ={e}^{2\\operatorname{ln}⁡x} \\\\  & ={x}^{2}.\\end{aligned}\n$$\n\nMultiplying our equation by the integrating factor, we arrive at the following exact differential equation:\n\n$$\n\\begin{aligned}{x}^{2}[(\\frac{5{y}^{2}}{x}+2{y}^{3})\\,\\text{d}x+(5y+2x{y}^{2}+\\frac{2}{{x}^{2}})\\,\\text{d}y] & =0 \\\\ {{(5x{y}^{2}+2{x}^{2}{y}^{3})}_{⏟}}_{\\overset{~}{P}}\\,\\text{d}x+{{(5{x}^{2}y+2{x}^{3}{y}^{2}+2)}_{⏟}}_{\\overset{~}{Q}}\\,\\text{d}y & =0.\\end{aligned}\n$$\n\nFor this exact equation, we have\n\n$$\n\\overset{~}{P}(x,y)=5x{y}^{2}+2{x}^{2}{y}^{3},\\,\\overset{~}{Q}(x,y)=5{x}^{2}y+2{x}^{3}{y}^{2}+2.\n$$\n\nTo solve the equation, let's first integrate $\\overset{~}{P}(x,y)$ with respect to $x.$\nThe result should include an arbitrary function of $y,$ which we'll call $F(y):$\n\n$$\n\\begin{aligned}u(x,y) & =\\int \\overset{~}{P}(x,y)\\,\\text{d}x+F(y) \\\\  & =\\int (5x{y}^{2}+2{x}^{2}{y}^{3})\\,\\text{d}x+F(y) \\\\  & =\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+F(y)\\end{aligned}\n$$\n\nNext, let's integrate $\\overset{~}{Q}(x,y)$ with respect to $y.$\nThe result should include an arbitrary function of $x,$ which we'll call $G(x):$\n\n$$\n\\begin{aligned}u(x,y) & =\\int \\overset{~}{Q}(x,y)\\,\\text{d}y+G(x) \\\\  & =\\int (5{x}^{2}y+2{x}^{3}{y}^{2}+2)\\,\\text{d}y+G(x) \\\\  & =\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y+G(x)\\end{aligned}\n$$\n\nComparing the two expressions, we must have\n\n$$\nF(y)=2y,\\,G(x)=0.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y=c.\n$$"} {:db/id 17592186311878 :knowledge-point/_questions [{:db/id 17592186147487 :knowledge-point/id #uuid "5e92641d-b0bf-579b-960b-d6024d4b99b7" :knowledge-point/title "Finding a VOP Equation by Substituting the Ansatz into the Original ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ecec61c-d426-5881-aad6-5ecee8bf6f81" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}{e}^{-4x}+{u}_{2}{e}^{-5x}" :db/id 17592186309346} {:answer/id #uuid "873ebbc5-fc13-5b75-a367-ff788b1a507d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}({e}^{-4x})^{′}+{u}_{2}({e}^{-5x})^{′}" :db/id 17592186309808} {:answer/id #uuid "e13d81f8-328f-596c-9737-544997b76879" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}({e}^{-4x})^{′}+{u}_{2}^{′}({e}^{-5x})^{′}" :db/id 17592186310550} {:answer/id #uuid "ecc0045b-5170-5e4f-8fd5-8cf3afe0fb36" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}{e}^{-4x}+{u}_{2}^{′}{e}^{-5x}" :db/id 17592186310629}] :answer-field/correct {:answer/id #uuid "873ebbc5-fc13-5b75-a367-ff788b1a507d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}({e}^{-4x})^{′}+{u}_{2}({e}^{-5x})^{′}" :db/id 17592186309808} :answer-field/id #uuid "8b9aa772-8fbc-5daf-9700-c4e7b8d89110" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311190} {:answer-field/choices [{:answer/id #uuid "3b7659db-0642-573b-a9f3-43c7bfe7c255" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}({e}^{-4x})^{′}+{u}_{2}({e}^{-5x})^{′}" :db/id 17592186309206} {:answer/id #uuid "5c134cc7-8d9d-51ce-8f4e-29804f929864" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}{e}^{-4x}+{u}_{2}{e}^{-5x}" :db/id 17592186309440} {:answer/id #uuid "7db9f387-8440-5d23-862c-5a14f7b3ede4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}({e}^{-4x})^{′}+{u}_{2}^{′}({e}^{-5x})^{′}" :db/id 17592186309731} {:answer/id #uuid "8df7c654-79d9-57b4-8f33-0a397dd00395" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}{e}^{-4x}+{u}_{2}^{′}{e}^{-5x}" :db/id 17592186309876}] :answer-field/correct {:answer/id #uuid "5c134cc7-8d9d-51ce-8f4e-29804f929864" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}{e}^{-4x}+{u}_{2}{e}^{-5x}" :db/id 17592186309440} :answer-field/id #uuid "abe27f9b-d867-5824-93a2-18480b2c00b0" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311289} {:answer-field/choices [{:answer/id #uuid "370aadfe-0c25-537f-865a-94d783015545" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4{u}_{1}^{′}{e}^{-4x}-5{u}_{2}^{′}{e}^{-5x}={h}^{′}(x)" :db/id 17592186309167} {:answer/id #uuid "472045fd-4bc7-54b9-975d-ff7bb4deef03" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}{e}^{-4x}+{u}_{2}^{′}{e}^{-5x}={h}^{′}(x)" :db/id 17592186309292} {:answer/id #uuid "9b9e6318-4dba-52d1-8ff0-0a55a6731118" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4{u}_{1}^{′}{e}^{-4x}-5{u}_{2}^{′}{e}^{-5x}=h(x)" :db/id 17592186310006} {:answer/id #uuid "b0ba1814-02e5-5825-8c84-c192560f6b61" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}{e}^{-4x}+{u}_{2}^{′}{e}^{-5x}=h(x)" :db/id 17592186310177}] :answer-field/correct {:answer/id #uuid "9b9e6318-4dba-52d1-8ff0-0a55a6731118" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4{u}_{1}^{′}{e}^{-4x}-5{u}_{2}^{′}{e}^{-5x}=h(x)" :db/id 17592186310006} :answer-field/id #uuid "bd7ae3b4-faac-584a-9744-4335aae6dc68" :answer-field/key "field-3" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186311332}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f1b043c-6b75-5f90-a31c-65bd3554d2c0" :question/math-academy-id "q-337736" :question/problem "Consider the differential equation \n\n$$\n{y}^{″}+9{y}^{′}+20y=h(x).\n$$\n\nThe corresponding homogeneous equation has the fundamental solutions ${y}_{1}(x)={e}^{-4x}$ and ${y}_{2}(x)={e}^{-5x}:$According to the method of variation of parameters, we seek a particular solution of the form\n\n$$\n{y}_{p}(x)={{field-1}}\n$$\n\nwhere ${u}_{1}={u}_{1}(x),{u}_{2}={u}_{2}(x),$ that satisfies the constraint\n\n$$\n{y}_{p}^{′}(x)={{field-2}}.\n$$\n\nSubstituting the expressions $y={y}_{p}$ and ${y}^{′}={y}_{p}^{′}$ into the differential equation yields the following relationship between ${u}_{1}^{′},{u}_{2}^{′},$ and $h(x):$\n\n$$\n{{field-3}}\n$$" :question/worked-solution "Given a second-order linear inhomogeneous differential equation, the variation of parameters method requires that we seek a particular solution of the form\n\n$$\n{y}_{p}(x)={u}_{1}(x){y}_{1}(x)+{u}_{2}(x){y}_{2}(x)\n$$\n\nthat satisfies the constraint\n\n$$\n{y}_{p}^{′}={u}_{1}{y}_{1}^{′}+{u}_{2}{y}_{2}^{′}.\n$$\n\nHere, ${y}_{1}$ and ${y}_{2}$ are linearly independent solutions of the corresponding homogeneous equation, and ${u}_{1}$ and ${u}_{2}$ are functions to be determined.\n\nIn this case, we're told that the fundamental solutions are\n\n$$\n{y}_{1}={e}^{-4x},\\,{y}_{2}={e}^{-5x}.\n$$\n\nSubstituting the fundamental solutions into our expression for ${y}_{p},$ we get\n\n$$\n{y}_{p}={u}_{1}{e}^{-4x}+{u}_{2}{e}^{-5x}.\n$$\n\nSubstituting the fundamental solutions into our constraint equation for ${y}_{p}^{′},$ we get\n\n$$\n{y}_{p}^{′}={u}_{1}({e}^{-4x})^{′}+{u}_{2}({e}^{-5x})^{′}.\n$$\n\nNext, we substitute $y={y}_{p}$ and ${y}^{′}={y}_{p}^{′}$ into the differential equation, as follows:\n\n$$\n\\begin{aligned}{y}^{″}+9{y}^{′}+20y & =h(x) \\\\ ({y}_{p}^{′})^{′}+9{y}_{p}^{′}+20{y}_{p} & =h(x)\\end{aligned}\n$$\n\nUsing our expressions for ${y}_{p}$ and ${y}_{p}^{′},$ we have:\n\n$$\n\\begin{aligned}{({u}_{1}({e}^{-4x})^{′}+{u}_{2}({e}^{-5x})^{′})}^{′}+9({u}_{1}({e}^{-4x})^{′}+{u}_{2}({e}^{-5x})^{′})+20({u}_{1}{e}^{-4x}+{u}_{2}{e}^{-5x}) & =h(x) \\\\ {(-4{u}_{1}{e}^{-4x}-5{u}_{2}{e}^{-5x})}^{′}-36{u}_{1}{e}^{-4x}-45{u}_{2}{e}^{-5x}+20{u}_{1}{e}^{-4x}+20{u}_{2}{e}^{-5x} & =h(x) \\\\ -4{u}_{1}^{′}{e}^{-4x}+16{u}_{1}{e}^{-4x}-5{u}_{2}^{′}{e}^{-5x}+25{u}_{2}{e}^{-5x}-36{u}_{1}{e}^{-4x}-45{u}_{2}{e}^{-5x}+20{u}_{1}{e}^{-4x}+20{u}_{2}{e}^{-5x} & =h(x)\\end{aligned}\n$$\n\nNext, we group all terms proportional to ${u}_{1}$ and ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{1}{{(16{e}^{-4x}-36{e}^{-4x}+20{e}^{-4x})}_{⏟}}_{0}+{u}_{2}{{(25{e}^{-5x}-45{e}^{-5x}+20{e}^{-5x})}_{⏟}}_{0}-4{u}_{1}^{′}{e}^{-4x}-5{u}_{2}^{′}{e}^{-5x}=h(x)\\end{aligned}\n$$\n\nNote that the expressions in parentheses are both zero. Therefore, the equation reduces to\n\n$$\n-4{u}_{1}^{′}{e}^{-4x}-5{u}_{2}^{′}{e}^{-5x}=h(x).\n$$"} {:db/id 17592186311879 :knowledge-point/_questions [{:db/id 17592186147487 :knowledge-point/id #uuid "5e92641d-b0bf-579b-960b-d6024d4b99b7" :knowledge-point/title "Finding a VOP Equation by Substituting the Ansatz into the Original ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d043ece-795f-53b4-badf-a88ae45b09c0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}({e}^{-3x})^{′}+{u}_{2}^{′}({e}^{-4x})^{′}" :db/id 17592186309334} {:answer/id #uuid "c615c6de-cfc5-5588-8a80-fb95fdb9cf14" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}^{′}{e}^{-3x}+{u}_{2}^{′}{e}^{-4x}" :db/id 17592186310340} {:answer/id #uuid "edfbca41-ec27-5bf3-9335-58c3015e6a0d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}({e}^{-3x})^{′}+{u}_{2}({e}^{-4x})^{′}" :db/id 17592186310643} {:answer/id #uuid "f8ce647f-df35-5a3d-8385-26a54646b597" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}{e}^{-3x}+{u}_{2}{e}^{-4x}" :db/id 17592186310732}] :answer-field/correct {:answer/id #uuid "edfbca41-ec27-5bf3-9335-58c3015e6a0d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{u}_{1}({e}^{-3x})^{′}+{u}_{2}({e}^{-4x})^{′}" :db/id 