 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"} {:db/id 17592186243967 :knowledge-point/_questions [{:db/id 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cb4e22-4527-5cdf-a246-1015081dac6c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186241398} {:answer/id #uuid "45ff70ac-0687-5b4f-8a03-e3801fde7dde" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id 17592186241811} {:answer/id #uuid "c2e14ccb-77c2-5ea4-bf3e-93ea6b71314d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186242893} {:answer/id #uuid "c7019515-4ac5-5e22-b2ba-750fda287b5c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186242938} {:answer/id #uuid "f01bc462-8fff-5df6-8acb-52fca6d667fb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186243312}] :answer-field/correct {:answer/id #uuid "f01bc462-8fff-5df6-8acb-52fca6d667fb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186243312} :answer-field/id #uuid "3d43a551-8858-5c8b-93c4-57c4ba597de0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243556}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54845a6f-21d5-55bc-a564-7e1e09132e6f" :question/math-academy-id "q-106855" :question/problem "Given that \n$A=\\begin{bmatrix}-1 & 0 & 2 \\\\ 5 & 1 & -8 \\\\ -4 & 0 & 3\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{31}\\cdot {u}_{23}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 0 & 2 \\\\ 5 & 1 & -8 \\\\ -4 & 0 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ -4 & 0 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -5\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -5\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{31}=4,{u}_{23}=2,$ and ${l}_{31}\\cdot {u}_{23}=8.$"} {:db/id 17592186243968 :knowledge-point/_questions [{:db/id 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0103ed51-38eb-56e1-b5b6-506ac5114dcb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186241194} {:answer/id #uuid "28f58628-e349-51a5-9381-2a6c3f3e63d5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186241538} {:answer/id #uuid "362edb3b-c2c6-5e35-b27f-a4726544a314" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id 17592186241655} {:answer/id #uuid "88c00484-3dac-50cd-9b40-2f30d2fe5429" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186242384} {:answer/id #uuid "d8290906-4330-5010-8b90-d9121d42fcb3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id 17592186243101}] :answer-field/correct {:answer/id #uuid "d8290906-4330-5010-8b90-d9121d42fcb3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id 17592186243101} :answer-field/id #uuid "97841af7-3445-571b-82d4-01c790eeec83" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243720}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "715f2529-cb8e-5152-b727-a6588c23a27e" :question/math-academy-id "q-106856" :question/problem "Given that \n$A=\\begin{bmatrix}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ -3 & 0 & -5\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & -6 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -3 & -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-2,$ ${u}_{33}=3,$ and ${l}_{32}\\cdot {u}_{33}=-6.$"} {:db/id 17592186243969 :knowledge-point/_questions [{:db/id 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "006f8bad-4488-5247-b030-e69c65d69aa9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id 17592186241189} {:answer/id #uuid "5c0029bc-5dd1-5f3b-a321-0734ae89305c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186242011} {:answer/id #uuid "c5338b5d-9d5a-53f8-8757-89e53bce6a9b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186242918} {:answer/id #uuid "cb3972a3-507c-51c5-a785-eebe4b438e06" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186242969} {:answer/id #uuid "de80bb7f-5c83-554e-90e1-3ead07f6bbb3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186243158}] :answer-field/correct {:answer/id #uuid "5c0029bc-5dd1-5f3b-a321-0734ae89305c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186242011} :answer-field/id #uuid "27b176de-565d-5931-ae28-b4d1ef631a50" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243509}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b30a7824-ca9d-5133-93d0-3fa15525aa26" :question/math-academy-id "q-106858" :question/problem "Given that \n$A=\\begin{bmatrix}3 & -2 & -3 \\\\ -3 & -1 & 3 \\\\ 9 & 0 & -5\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{21}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & -2 & -3 \\\\ -3 & -1 & 3 \\\\ 9 & 0 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 9 & 0 & -5\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 0 & 6 & 4\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 4\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 3 & -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-1,$ ${u}_{33}=4,$ and ${l}_{21}\\cdot {u}_{33}=-4.$"} {:db/id 17592186243989 :knowledge-point/_questions [{:db/id 17592186119884 :knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414" :knowledge-point/title "Finding Missing Numbers in the Matrix U of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0964ec38-3e97-5abe-b786-55a661c9de30" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,3,\\,-4" :db/id 17592186241261} {:answer/id #uuid "131e5aa6-45e3-55cd-9b1c-cc3ea29f46f3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,3,\\,-6" :db/id 17592186241343} {:answer/id #uuid "4e0a1b1d-4be9-5a67-800c-38fc3e86bd09" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-3,\\,4" :db/id 17592186241882} {:answer/id #uuid "529fb83f-2093-5ea7-9893-75d2d958c782" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-4,\\,3" :db/id 17592186241916} {:answer/id #uuid "d9a73994-a661-5e5e-bbe0-a2e755731694" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-4,\\,-5" :db/id 17592186243118}] :answer-field/correct {:answer/id #uuid "0964ec38-3e97-5abe-b786-55a661c9de30" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,3,\\,-4" :db/id 17592186241261} :answer-field/id #uuid "54403d1d-3e8f-5d4c-893c-ac0e2772d22d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243604}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18168df9-7c4c-59e5-8faf-0d6fc1c59cb4" :question/math-academy-id "q-106959" :question/problem "$$\n{{\\begin{bmatrix}7 & 0 & -1 \\\\ 7 & 3 & -5 \\\\ 63 & -3 & 1\\end{bmatrix}}_{⏟}}_{A}={{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 9 & -1 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}7 & 0 & -1 \\\\ \\boxed{} & \\boxed{} & \\boxed{} \\\\ 0 & 0 & 6\\end{bmatrix}}_{⏟}}_{U}.\n$$\n\nConsider the LU factorization of the matrix $A$ above. From left to right, what are the missing elements from the second row of the matrix $U?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make $0$ at the position ${a}_{21}$ of the matrix $A,$ we proceed as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}7 & 0 & -1 \\\\ 7 & 3 & -5 \\\\ 63 & -3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}7 & 0 & -1 \\\\ 0 & 3 & -4 \\\\ 63 & -3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, from left to right, the elements from the second row of $U$ are $0,3,$ and $-4.$"} {:db/id 17592186243990 :knowledge-point/_questions [{:db/id 17592186119884 :knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414" :knowledge-point/title "Finding Missing Numbers in the Matrix U of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13be7f6f-d225-58d8-9cec-eb94ce2c29d3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186241346} {:answer/id #uuid "2fd6d480-5c5c-59ae-9eef-3bd6a91204fd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-26" :db/id 17592186241608} {:answer/id #uuid "abf79c81-05d7-5f65-b0ca-38ecf53deb96" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186242682} {:answer/id #uuid "d75989b3-aacb-51c9-98be-7b9645d3781a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186243091} {:answer/id #uuid "e71e2cc2-701c-5ab8-95a5-2edd70f48b3b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id 17592186243228}] :answer-field/correct {:answer/id #uuid "abf79c81-05d7-5f65-b0ca-38ecf53deb96" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186242682} :answer-field/id #uuid "f133647f-bdd5-5d17-8ee4-e98f69a19da4" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243854}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0b2eb758-b817-50ae-a571-89f30f2f0315" :question/math-academy-id "q-106963" :question/problem "$$\n{{\\begin{bmatrix}1 & 0 & 1 \\\\ -3 & 2 & -6 \\\\ 7 & 18 & -19\\end{bmatrix}}_{⏟}}_{A}={{\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 7 & 9 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 0 & 0 & \\boxed{}\\end{bmatrix}}_{⏟}}_{U}.\n$$\n\nConsider the LU factorization of the matrix $A$ above. What is the value of ${u}_{33}$ in the matrix $U?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make zeros below the main diagonal, we proceed as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 0 & 1 \\\\ -3 & 2 & -6 \\\\ 7 & 18 & -19\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 7 & 18 & -19\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-7){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 0 & 18 & -26\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-9){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, ${u}_{33}=1.$"} {:db/id 17592186243991 :knowledge-point/_questions [{:db/id 17592186119798 :knowledge-point/id #uuid "d216cc0e-58a7-5fab-b5fe-60c7656338cc" :knowledge-point/title "Finding Missing Numbers in the Matrix L of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02255a18-fb20-5055-8197-923373dfe842" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186241203} {:answer/id #uuid "1ecf332b-cfc9-5c92-9985-fae0a152015b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186241449} {:answer/id #uuid "37fc7b21-53e3-5770-ba73-6aea472604bc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186241678} {:answer/id #uuid "fb4ee43c-3368-5f56-bdba-f4ef3c6e4c7f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186243397} {:answer/id #uuid "fcee3ad9-e443-5489-a72e-3afad27fc33b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186243410}] :answer-field/correct {:answer/id #uuid "fcee3ad9-e443-5489-a72e-3afad27fc33b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186243410} :answer-field/id #uuid "73afb1d5-55d2-5ae6-b68d-b66600e188a9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243666}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "def7b9dd-c00d-5f8f-b46f-c722adda75d3" :question/math-academy-id "q-106966" :question/problem "$$\n{{\\begin{bmatrix}-6 & 1 & 0 \\\\ 18 & -1 & 3 \\\\ -6 & 1 & 1\\end{bmatrix}}_{⏟}}_{A}={{\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ \\boxed{} & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}-6 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{U}\n$$\n\nConsider the LU factorization of the matrix $A$ above. What is the value of the entry ${l}_{31}$ in the matrix $L?$" :question/worked-solution "We want to make $0$ at the position ${a}_{31}$ using Gaussian elimination. To do this, we take the $3$rd row of $A,$ and we add the $1$st row of $A$ multiplied by $-1:$\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-6 & 1 & 0 \\\\ 18 & -1 & 3 \\\\ -6 & 1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 1 & 0 \\\\ 18 & -1 & 3 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nThe entry ${l}_{31}$ of the matrix $L$ is the factor next to ${R}_{1},$ taken with the opposite sign:\n\n$$\n{l}_{31}=-(-1)=1.\n$$"} {:db/id 17592186243992 :knowledge-point/_questions [{:db/id 17592186119798 :knowledge-point/id #uuid "d216cc0e-58a7-5fab-b5fe-60c7656338cc" :knowledge-point/title "Finding Missing Numbers in the Matrix L of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010f200e-3b77-577b-800d-6b3842f56322" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186241195} {:answer/id #uuid "1b552304-e1f3-5d1d-a506-1d1518d17ffb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186241416} {:answer/id #uuid "339213e3-b2af-5020-a2f1-e664af0a1b3b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186241635} {:answer/id #uuid "44c6d4e3-206e-5fb8-b3ec-5d601224d09d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186241801} {:answer/id #uuid "5e93a494-0a5a-5ead-9150-533614178f0e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186242030}] :answer-field/correct {:answer/id #uuid "1b552304-e1f3-5d1d-a506-1d1518d17ffb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186241416} :answer-field/id #uuid "1ca419e6-1e9a-5f1b-ad7a-d6c09f59000f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243494}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "656fd206-3946-51f7-a5b6-8c655403f048" :question/math-academy-id "q-106968" :question/problem "$$\n{{\\begin{bmatrix}4 & 0 & 3 \\\\ -12 & -8 & -4 \\\\ 36 & -32 & 46\\end{bmatrix}}_{⏟}}_{A}={{\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 9 & \\boxed{} & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}4 & 0 & 3 \\\\ 0 & -8 & 5 \\\\ 0 & 0 & -1\\end{bmatrix}}_{⏟}}_{U}\n$$\n\nConsider the LU factorization of the matrix $A$ above. What is the value of the entry ${l}_{32}$ in the matrix $L?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make zeros below the main diagonal, we proceed as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 0 & 3 \\\\ -12 & -8 & -4 \\\\ 36 & -32 & 46\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 0 & 3 \\\\ 0 & -8 & 5 \\\\ 36 & -32 & 46\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-9){R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 0 & 3 \\\\ 0 & -8 & 5 \\\\ 0 & -32 & 19\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we want to make $0$ at the position ${a}_{32}$ using Gaussian elimination. To do this, we take the $3$rd row of $A,$ and we add the $2$nd row of $A$ multiplied by $-4:$\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}4 & 0 & 3 \\\\ 0 & -8 & 5 \\\\ 0 & -32 & 19\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼\\begin{bmatrix}4 & 0 & 3 \\\\ 0 & -8 & 5 \\\\ 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe entry ${l}_{32}$ of the matrix $L$ is the factor next to ${R}_{2},$ taken with the opposite sign:\n\n$$\n{l}_{32}=-(-4)=4.\n$$"} {:db/id 17592186244037 :knowledge-point/_questions [{:db/id 17592186119886 :knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a" :knowledge-point/title "Finding the Solution of an Intermediate System Using the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427af4b2-096b-5dbf-8f00-52882f2904b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ 33\\end{bmatrix}" :db/id 17592186241778} {:answer/id #uuid "565699cb-5aa4-56e7-8959-bd5585b64c79" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}" :db/id 17592186241960} {:answer/id #uuid "9561d87e-a040-5eb9-9f47-8c4ea9835a94" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ -7\\end{bmatrix}" :db/id 17592186242492} {:answer/id #uuid "b51413cc-3563-5af6-ac17-74e0247a8a5a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}" :db/id 17592186242763} {:answer/id #uuid "cf0370c3-16bd-5ef9-95a0-be7a53155a4e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ -7\\end{bmatrix}" :db/id 17592186243005}] :answer-field/correct {:answer/id #uuid "427af4b2-096b-5dbf-8f00-52882f2904b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ 33\\end{bmatrix}" :db/id 17592186241778} :answer-field/id #uuid "029bf18c-8249-5883-8d70-894701f6abe7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243440}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9df65e2-b577-593b-b89c-fc5d55ad0bf6" :question/math-academy-id "q-107171" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ -7 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ -7 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=5 \\\\ -7{y}_{1}+{y}_{2} &=-2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=5$ and ${y}_{2}=33.$ \n\nTherefore, $y=\\begin{bmatrix}5 \\\\ 33\\end{bmatrix}.$"} {:db/id 17592186244038 :knowledge-point/_questions [{:db/id 17592186119886 :knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a" :knowledge-point/title "Finding the Solution of an Intermediate System Using the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56a516b1-0e57-5c35-a875-627c080854a2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ -6\\end{bmatrix}" :db/id 17592186241961} {:answer/id #uuid "e9c6a2a3-37f8-522c-86b8-339400effadd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}" :db/id 17592186243247} {:answer/id #uuid "f5179545-dd33-5b3c-b9e0-1db909686ed7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 6\\end{bmatrix}" :db/id 17592186243346} {:answer/id #uuid "fb403ca5-2870-5829-8af2-577957b21df2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}" :db/id 17592186243396} {:answer/id #uuid "ff6b94c4-efd2-561d-9f88-d211ffff7b82" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}0 \\\\ -6\\end{bmatrix}" :db/id 17592186243427}] :answer-field/correct {:answer/id #uuid "e9c6a2a3-37f8-522c-86b8-339400effadd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}" :db/id 17592186243247} :answer-field/id #uuid "db179df0-4c85-5c99-a59c-aef4c3152fe2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243818}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5770113-6f9c-5ba4-9bdf-028a637220e4" :question/math-academy-id "q-107172" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ -6 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ -6 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=0 \\\\ -6{y}_{1}+{y}_{2} &=4.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=0$ and ${y}_{2}=4.$ \n\nTherefore, $y=\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}.$"} {:db/id 17592186244039 :knowledge-point/_questions [{:db/id 17592186119800 :knowledge-point/id #uuid "9fa9fbb8-b2bc-5c93-bb07-bc8c7ef7c115" :knowledge-point/title "Finding the Solution of an Intermediate System Using the LU Factorization of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09248362-0210-5bd3-9cba-3c7c0ba0af77" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 3 \\\\ -2\\end{bmatrix}" :db/id 17592186241259} {:answer/id #uuid "36d321ce-53d8-56e9-9dbe-82fc9adca483" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id 17592186241662} {:answer/id #uuid "50683a47-c6a2-5f5a-bb9e-8475b2b4d6a6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}" :db/id 17592186241898} {:answer/id #uuid "62e293f9-4c73-554b-a3cb-8ff34f004cd4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 1 \\\\ -1\\end{bmatrix}" :db/id 17592186242067} {:answer/id #uuid "f215d89c-a23c-52b9-bf36-dbbb01a12a7b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id 17592186243328}] :answer-field/correct {:answer/id #uuid "62e293f9-4c73-554b-a3cb-8ff34f004cd4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 1 \\\\ -1\\end{bmatrix}" :db/id 17592186242067} :answer-field/id #uuid "f398d1c3-32a7-528a-a4fa-123d34b4e86f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186243860}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60c2acb2-475e-5d8e-b68c-bf34a8ead470" :question/math-academy-id "q-107174" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -1 & -4 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ -1 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -1 & -4 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ -1 \\\\ -3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-2 \\\\ {y}_{1}+{y}_{2} &=-1 \\\\ -{y}_{1}-4{y}_{2}+{y}_{3} &=-3.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =-2, \\\\ {y}_{2} & =-1-{y}_{1} \\\\  & =-1-(-2) \\\\  & =1, \\\\ {y}_{3} & =-3+4{y}_{2}+{y}_{1} \\\\  & =-3+4(1)+(-2) \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}-2 \\\\ 1 \\\\ -1\\end{bmatrix}.$"} {:db/id 17592186244298 :knowledge-point/_questions [{:db/id 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3138bb3b-2240-5c6f-8e4f-f5b183ab1ca7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461557} {:answer/id #uuid "5f4cb01f-fd3b-5e22-8f85-d6d31e4e2aa8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461558}] :answer-field/correct {:answer/id #uuid "5f4cb01f-fd3b-5e22-8f85-d6d31e4e2aa8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461558} :answer-field/id #uuid "3325f4bf-863d-54b9-b3e2-675ef37d6a4e" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462532} {:answer-field/choices [{:answer/id #uuid "5ec37e8f-a3b6-58e1-8ac0-ebf42f83c9f1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461559} {:answer/id #uuid "cf1643b0-dcf4-51e2-9dee-978dbc5d77dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461560}] :answer-field/correct {:answer/id #uuid "5ec37e8f-a3b6-58e1-8ac0-ebf42f83c9f1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461559} :answer-field/id #uuid "2c9d2262-c721-59fd-8663-dd7f70aa108c" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462533} {:answer-field/choices [{:answer/id #uuid "7f3e9e53-b6e3-52c5-a18d-90e354f3cdd8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461561} {:answer/id #uuid "167030fc-d98f-5d1e-b38a-bf7f33db7ba2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461562}] :answer-field/correct {:answer/id #uuid "167030fc-d98f-5d1e-b38a-bf7f33db7ba2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461562} :answer-field/id #uuid "3a39b7c6-5e57-56c4-b90a-de587ab18cd6" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462534}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f8f24d7-923f-567b-b949-576aeecc58aa" :question/math-academy-id "q-109506" :question/problem "$$\nA=\\begin{bmatrix}3 & 0 \\\\ -2 & 3\\end{bmatrix},\\,v=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nIII. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine out statements.\n\nFirst, we compute $A-3I:$\n\n$$\nA-3I=\\begin{bmatrix}3 & 0 \\\\ -2 & 3\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ -2 & 0\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-3I:$\n\n$$\n(A-3I)v=\\begin{bmatrix}0 & 0 \\\\ -2 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n{{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{\\,A-3I\\,\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\n \n\nHere, we see that $A-3I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =3$ of $A.$*\n\nSo, the correct answer is \"I and III only.\""} {:db/id 17592186246999 :knowledge-point/_questions [{:db/id 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac09a573-a23e-5936-81e2-8a4dc7b2d72e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461563} {:answer/id #uuid "6798f96f-447f-5faa-919e-de921ef0dc73" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461564}] :answer-field/correct {:answer/id #uuid "ac09a573-a23e-5936-81e2-8a4dc7b2d72e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461563} :answer-field/id #uuid "da7b9358-fa9d-5ba7-99fd-16418a38ed31" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462535} {:answer-field/choices [{:answer/id #uuid "7f221f89-d270-5c37-a24e-41b0d1f210f1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461565} {:answer/id #uuid "0368ad04-181d-5ae0-9f04-bf071ac6075f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461566}] :answer-field/correct {:answer/id #uuid "0368ad04-181d-5ae0-9f04-bf071ac6075f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461566} :answer-field/id #uuid "2918a440-120a-5271-b310-15bc39163202" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462536} {:answer-field/choices [{:answer/id #uuid "1eeeb0c6-e947-5a46-853c-7fd461e4302f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461567} {:answer/id #uuid "4a60962c-815b-574f-a2b5-bd3d0be1a5dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461568}] :answer-field/correct {:answer/id #uuid "1eeeb0c6-e947-5a46-853c-7fd461e4302f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461567} :answer-field/id #uuid "3ce4146e-cec5-5999-9d67-968a8eaa2ccc" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462537}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c9bad97-e078-5fd9-8cb8-6324032501fd" :question/math-academy-id "q-109508" :question/problem "$$\nA=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+4I:$\n\n$$\nA+4I=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix}+4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+4I:$\n\n$$\n(A+4I)v=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}={{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+4I:$\n\n$$\n(A+4I)w=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{⏟}}_{v}\\overset{A+4I\\,}{\\to }{{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{⏟}}_{w}\\overset{A+4I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A+4I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A.$*\n\nSo, the correct answer is \"II only.\""} {:db/id 17592186247000 :knowledge-point/_questions [{:db/id 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea90c8f5-d8b6-530a-bd3a-55a8a95477ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461569} {:answer/id #uuid "7f02e0f9-4218-50d0-8f74-b3bbce2ccd63" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461570}] :answer-field/correct {:answer/id #uuid "7f02e0f9-4218-50d0-8f74-b3bbce2ccd63" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461570} :answer-field/id #uuid "f3f48a61-a618-59bf-8258-975fc6843f3b" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462538} {:answer-field/choices [{:answer/id #uuid "268560d4-b12d-5c37-99f7-f084e893cfe6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461571} {:answer/id #uuid "ce284464-387a-52cf-9b51-1039384e97be" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461572}] :answer-field/correct {:answer/id #uuid "268560d4-b12d-5c37-99f7-f084e893cfe6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461571} :answer-field/id #uuid "3c3c14b8-856f-5418-9438-2d823e014acb" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462539} {:answer-field/choices [{:answer/id #uuid "a846bae0-2fb9-5cb8-9fae-ae7d4b22827f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461573} {:answer/id #uuid "7746f0e1-4798-5728-b7c7-4ff377910040" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461574}] :answer-field/correct {:answer/id #uuid "7746f0e1-4798-5728-b7c7-4ff377910040" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461574} :answer-field/id #uuid "c835039c-460a-5ea4-ab26-b6657a44f5dc" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462540}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a35e1aa3-c186-545a-9105-317f752c0d95" :question/math-academy-id "q-109517" :question/problem "$$\nA=\\begin{bmatrix}12 & -1 \\\\ 4 & 8\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =10$ of $A$\n- **II.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =10$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =10$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-10I:$\n\n$$\nA-10I=\\begin{bmatrix}12 & -1 \\\\ 4 & 8\\end{bmatrix}-10\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-10I:$\n\n$$\n(A-10I)v=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n{{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}}_{⏟}}_{v}\\overset{\\,A-10I\\,\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\n \n\nHere, we see that $A-10I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =10$ of $A.$*\n\nSo, the correct answer is \"I and III only.\""} {:db/id 17592186247001 :knowledge-point/_questions [{:db/id 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a25c4edf-bc28-5a6d-bce8-dc691f40f46d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461575} {:answer/id #uuid "b25784ef-0104-536a-b0f5-9202aac0e151" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461576}] :answer-field/correct {:answer/id #uuid "a25c4edf-bc28-5a6d-bce8-dc691f40f46d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461575} :answer-field/id #uuid "a1cae5fa-1b6c-55f0-b295-ad6fed3c38ae" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462541} {:answer-field/choices [{:answer/id #uuid "858d8067-b0de-598a-b606-236eb811c558" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461577} {:answer/id #uuid "4852a013-cee8-55ea-a31e-65f55bad1029" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461578}] :answer-field/correct {:answer/id #uuid "4852a013-cee8-55ea-a31e-65f55bad1029" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461578} :answer-field/id #uuid "35ccb795-d8ad-55c8-a867-52adde8a804d" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462542} {:answer-field/choices [{:answer/id #uuid "f6f3d6d1-2d3e-5256-8645-40f5fb25a5a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461579} {:answer/id #uuid "ef647bd5-b2da-51b9-8380-c98b65a2a02a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186461580}] :answer-field/correct {:answer/id #uuid "f6f3d6d1-2d3e-5256-8645-40f5fb25a5a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186461579} :answer-field/id #uuid "ed24b2ea-7eb1-5ee6-99ae-1a38c15df738" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186462543}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a65ad08d-f6cf-551f-aa17-5ecb903998d1" :question/math-academy-id "q-109524" :question/problem "$$\nA=\\begin{bmatrix}4 & -1 & 2 \\\\ 4 & 0 & -1 \\\\ 0 & 0 & 1\\end{bmatrix},\\,v=\\begin{bmatrix}2 \\\\ 3 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n- **II.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}4 & -1 & 2 \\\\ 4 & 0 & -1 \\\\ 0 & 0 & 1\\end{bmatrix}-2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 & 2 \\\\ 4 & -2 & -1 \\\\ 0 & 0 & -1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}2 & -1 & 2 \\\\ 4 & -2 & -1 \\\\ 0 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3 \\\\ 0\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=\\begin{bmatrix}2 & -1 & 2 \\\\ 4 & -2 & -1 \\\\ 0 & 0 & -1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}2 \\\\ 3 \\\\ 0\\end{bmatrix}}_{⏟}}_{v}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}}_{⏟}}_{w}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"II only.\""} {:db/id 17592186247002 :knowledge-point/_questions [{:db/id 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b486bce2-fa4e-513e-b610-7ee71b9233d0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db