039}] :answer-field/correct {:answer/id #uuid "82b6f0c5-d3a1-5080-8a06-2f2297b8b049" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id 17592186379038} :answer-field/id #uuid "6b5dca88-9f31-5d96-9eb5-b0a3a32a71b5" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186379036}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47a7a928-8818-5470-bb61-8110f7ce659e" :question/math-academy-id "q-177347" :question/problem "$6$ is a composite number **and** $2$ is negative.\n\nConsider the compound statement above and the following notations:\n\n- $R:6\\text{ is a composite number}$\n\n- $S:2\\text{ is negative}$\n\nExpressed in symbolic form, our statement can be written as\n{{field-1}}{{field-2}}{{field-3}}." :question/worked-solution "The word \"and\" is represented by the symbol \"$∧$\".\n\nSo, the sentence reads\n\n$$\n{{6\\text{ is a composite number}}_{⏟}}_{R}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{2\\text{ is negative}}_{⏟}}_{S},\n$$\n\nthat is, $R∧S.$"} {:db/id 17592186379040 :knowledge-point/_questions [{:db/id 17592186054641 :knowledge-point/id #uuid "93bc0caa-2352-5d02-9ccf-7267dff4be2c" :knowledge-point/title "Expressing Compound Statements in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b57a5555-038a-5d89-8b11-f972685407bd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "∧" :db/id 17592186379042} {:answer/id #uuid "c6cb4ea1-7329-56af-8054-7e856b6fdea8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id 17592186379043} {:answer/id #uuid "001201b7-8bff-54d6-8526-13278eca46be" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "P" :db/id 17592186379044} {:answer/id #uuid "0a462791-9f71-502d-a79c-a4d0003857f2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answe