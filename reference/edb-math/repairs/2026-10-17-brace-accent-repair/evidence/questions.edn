/math} :answer/value "2" :db/id 17592186117279} {:answer/id #uuid "133d29b3-ba83-5073-9fb5-ae8a15891606" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186117280} {:answer/id #uuid "17eb303e-e00d-5d84-a4f8-d39cb49ec3da" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186117281} {:answer/id #uuid "3695b530-f752-5009-8f87-09a944b9b94a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186117282}] :answer-field/correct {:answer/id #uuid "17eb303e-e00d-5d84-a4f8-d39cb49ec3da" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186117281} :answer-field/id #uuid "5d9216ff-8580-5238-a204-fb582eb42893" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186117277}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b3dcff6-15d4-5f3c-96ab-e4b3e7d4e9fd" :question/math-academy-id "q-32545" :question/problem "Given that\n$A=\\begin{bmatrix}3 & 2 \\\\ -6 & -4\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 2 \\\\ -6 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & 2 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & 2 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-2,$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-2.$"} {:db/id 17592186120187 :knowledge-point/_questions [{:db/id 17592186119792 :knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e33624-2f76-52f5-a0ac-d0e5456b3125" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}" :db/id 17592186300612} {:answer/id #uuid "afeeae29-79a8-50e4-b07c-0adaeb315d06" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -16 & 1\\end{bmatrix}" :db/id 17592186300839} {:answer/id #uuid "ca7c54ac-bd1f-58b8-9af9-dde01fa69a93" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 \\\\ 2 & 5\\end{bmatrix}" :db/id 17592186300972} {:answer/id #uuid "e0f94f4e-5030-56b8-be1a-60bbcb85999a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}" :db/id 17592186301082} {:answer/id #uuid "e6ed2340-48a3-593b-b7eb-7fa4a5012121" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id 17592186301105}] :answer-field/correct {:answer/id #uuid "82e33624-2f76-52f5-a0ac-d0e5456b3125" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}" :db/id 17592186300612} :answer-field/id #uuid "165c63bf-c24f-5bde-9084-b5df798dcb03" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301299}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "363a3b99-7f36-55a2-ab26-35e7a3af8462" :question/math-academy-id "q-32549" :question/problem "Given that \n$A=\\begin{bmatrix}4 & 2 \\\\ -16 & -3\\end{bmatrix}$ \nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 2 \\\\ -16 & -3\\end{bmatrix} & \\,{R}_{2} & :={R}_{2}+4{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}4 & 2 \\\\ 0 & 5\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}4 & 2 \\\\ 0 & 5\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id 17592186120188 :knowledge-point/_questions [{:db/id 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252ce171-0755-52d0-8ca8-2eb206da07f4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477215} {:answer/id #uuid "c64c0d42-e243-5c96-a744-1ef7c6890992" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477216}] :answer-field/correct {:answer/id #uuid "252ce171-0755-52d0-8ca8-2eb206da07f4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477215} :answer-field/id #uuid "9df02e3d-de8c-5154-9f5d-c1801992c64b" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186477577} {:answer-field/choices [{:answer/id #uuid "f7ab7a70-5a28-59e2-955b-0681d218bfef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477217} {:answer/id #uuid "a4aa48c4-2113-52f8-984d-4a71a2c2ff9c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477218}] :answer-field/correct {:answer/id #uuid "f7ab7a70-5a28-59e2-955b-0681d218bfef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477217} :answer-field/id #uuid "b0c08f72-5093-5b6b-bc41-a096269ec2aa" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186477578} {:answer-field/choices [{:answer/id #uuid "a3fb7b08-d488-58e2-980c-afd54977ad4d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477219} {:answer/id #uuid "ada4624e-8ffe-5859-8294-a52aec7585c6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477220}] :answer-field/correct {:answer/id #uuid "ada4624e-8ffe-5859-8294-a52aec7585c6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477220} :answer-field/id #uuid "f2ab1b30-8062-5c91-b5bc-ff9c735581fc" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186477579}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85de5a76-468b-557f-8cba-f675615513a3" :question/math-academy-id "q-32551" :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\nI. $A=\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}2 & 5 \\\\ 1 & 0\\end{bmatrix}$\n\nII. $A=\\begin{bmatrix}2 & 5 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}$\n\nIII. $A=\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}2 & 5 \\\\ 0 & 1\\end{bmatrix}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nA=\\overset{L}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}}\\cdot \\overset{U}{\\overset{⏞}{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal.\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}2 & 5 \\\\ 1 & 0\\end{bmatrix}\\,\\times \n$$\n\n- The second product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nA=\\begin{bmatrix}2 & 5 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}2 & 5 \\\\ 0 & 1\\end{bmatrix}\\,✓\n$$\n\nTherefore, the correct answer is \"III only\"."} {:db/id 17592186120190 :knowledge-point/_questions [{:db/id 17592186119794 :knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7abb7a-38b8-51e1-aca2-0d2b5391e4f5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id 17592186402049} {:answer/id #uuid "1602c8f1-24ac-5bc4-886f-c23bd7016636" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}" :db/id 17592186402050} {:answer/id #uuid "9cc39e06-17c8-5b75-b657-4b4e1555cf14" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 2 & 1\\end{bmatrix}" :db/id 17592186402051} {:answer/id #uuid "c3f664b1-8db7-5e54-b116-e1469468f127" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 5 & 0 & 1\\end{bmatrix}" :db/id 17592186402052} {:answer/id #uuid "a602201c-06fb-5598-8925-dcc674ce2b17" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id 17592186402053}] :answer-field/correct {:answer/id #uuid "a602201c-06fb-5598-8925-dcc674ce2b17" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id 17592186402053} :answer-field/id #uuid "b453da57-6eef-5d7a-9c79-162c447ab3b0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186402048}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10430503-ea48-51a6-b4f8-6c1fb5c683b2" :question/math-academy-id "q-32569" :question/problem "Given that \n$A=\\begin{bmatrix}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{bmatrix}$\nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 4\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 4\\end{bmatrix}}_{⏟}}_{U}.\\end{aligned}\n$$"} {:db/id 17592186120193 :knowledge-point/_questions [{:db/id 17592186119794 :knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3fb138a-dbb9-5bca-a0c0-cb9833348318" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id 17592186117320} {:answer/id #uuid "b23b5e53-2fad-53e7-b91f-acc5facebb03" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id 17592186117321} {:answer/id #uuid "f891ce3d-dab2-52d1-bd10-b64e7b66b3f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id 17592186117322} {:answer/id #uuid "24bac7cf-a2c0-5b28-8178-f63bc015eeb2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id 17592186117323} {:answer/id #uuid "5e35b5b4-a128-5aaa-9073-3fcd24901fa8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id 17592186117324}] :answer-field/correct {:answer/id #uuid "b23b5e53-2fad-53e7-b91f-acc5facebb03" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id 17592186117321} :answer-field/id #uuid "996c4b7e-e3a3-51a4-b248-a60b56f90cef" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186117319}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7eb0065-e372-5f47-afb0-364ee5325cfa" :question/math-academy-id "q-32587" :question/problem "Given that\n$A=[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 5 & 10 & 9\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then ${l}_{31}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 5 & 10 & 9\\end{aligned}] & {R}_{3} & :={R}_{3}+(-5){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 0 & 0 & -6\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 5 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 0 & 0 & -6\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{31}=5,{u}_{33}=-6,$ and ${l}_{31}\\cdot {u}_{33}=-30.$"} {:db/id 17592186120200 :knowledge-point/_questions [{:db/id 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44316460-f62f-5f2e-8461-32899b0a3bb4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id 17592186300298} {:answer/id #uuid "9e536b51-8864-5fa0-90f7-a389dd700360" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id 17592186300761} {:answer/id #uuid "aa03edf1-60b8-5e08-86a6-3adb47c71dd3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}" :db/id 17592186300814} {:answer/id #uuid "d33fcfad-0616-55e9-b637-ad961007ce65" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id 17592186301013} {:answer/id #uuid "f85f7da9-72c8-543b-aff8-74d9cd3dfab1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 1 & 1\\end{bmatrix}" :db/id 17592186301188}] :answer-field/correct {:answer/id #uuid "9e536b51-8864-5fa0-90f7-a389dd700360" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id 17592186300761} :answer-field/id #uuid "be381ffe-abf4-5da2-90cf-f936e2c2f43b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301848}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80727ea8-1d37-5678-9a50-5d7e94ac9250" :question/math-academy-id "q-32684" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-{R}_{1},\\,{R}_{3}:={R}_{3}+4{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+4\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{2}}\\cdot {{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ C & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix})U \\\\ C & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"} {:db/id 17592186120205 :knowledge-point/_questions [{:db/id 17592186119798 :knowledge-point/id #uuid "d216cc0e-58a7-5fab-b5fe-60c7656338cc" :knowledge-point/title "Finding Missing Numbers in the Matrix L of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cb17b9d-b11b-549c-87b8-82942781a4d6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186300257} {:answer/id #uuid "52092866-39a5-553d-b6b4-11e18d32527a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186300387} {:answer/id #uuid "95871270-c6c0-56f4-bde9-217af9c3df17" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186300714} {:answer/id #uuid "d078c1ef-cc55-577e-9beb-a7ec52e71522" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186301002} {:answer/id #uuid "e1c432b9-0169-50ac-91ca-3af202efc9d2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186301084}] :answer-field/correct {:answer/id #uuid "95871270-c6c0-56f4-bde9-217af9c3df17" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186300714} :answer-field/id #uuid "139d7c0e-9a4e-5489-91cf-2ac5a9cdbb5c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186301290}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c73c5e5c-bfc4-535b-9252-57ea10b20141" :question/math-academy-id "q-32726" :question/problem "$$\n{{\\begin{bmatrix}1 & 2 & -3 \\\\ 1 & -2 & 0 \\\\ 2 & 4 & 2\\end{bmatrix}}_{⏟}}_{A}={{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ \\boxed{} & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}1 & 2 & -3 \\\\ 0 & -4 & 3 \\\\ 0 & 0 & 8\\end{bmatrix}}_{⏟}}_{U}\n$$\n\nConsider the LU factorization of the matrix $A$ above. What is the value of the entry ${l}_{31}$ in the matrix $L?$" :question/worked-solution "We want to make $0$ at the position ${a}_{31}$ using Gaussian elimination. To do this, we take the $3$rd row of $A,$ and we add the $1$st row of $A$ multiplied by $-2:$\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 2 & -3 \\\\ 1 & -2 & 0 \\\\ 2 & 4 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -3 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nThe entry ${l}_{31}$ of the matrix $L$ is the factor next to ${R}_{1},$ taken with the opposite sign:\n\n$$\n{l}_{31}=-(-2)=2.\n$$"} {:db/id 17592186120206 :knowledge-point/_questions [{:db/id 17592186119884 :knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414" :knowledge-point/title "Finding Missing Numbers in the Matrix U of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24743710-ccae-5ce6-b9bd-ec3e3a56e15a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-2,\\,3" :db/id 17592186402062} {:answer/id #uuid "d50d3f79-94d2-5665-9a7d-33432a11e564" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,3" :db/id 17592186402063} {:answer/id #uuid "aa28f05d-2582-5b23-a7d7-5ac2da1040ef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,1" :db/id 17592186402064} {:answer/id #uuid "7167e25c-1100-59e0-8e73-47c13073ebe0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,4" :db/id 17592186402065} {:answer/id #uuid "4746c90f-6d0d-57b3-b8bf-7604a4ec6128" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-2,\\,4" :db/id 17592186402066}] :answer-field/correct {:answer/id #uuid "7167e25c-1100-59e0-8e73-47c13073ebe0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,4" :db/id 17592186402065} :answer-field/id #uuid "a81fb830-b280-555b-983a-34f12dd2e101" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186402061}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce5c7307-c449-5fe7-8928-1317176c796c" :question/math-academy-id "q-32772" :question/problem "$$\n{{\\begin{bmatrix}2 & 3 & -1 \\\\ 6 & 4 & 1 \\\\ 4 & 6 & -4\\end{bmatrix}}_{⏟}}_{A}={{\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}2 & 3 & -1 \\\\ \\boxed{} & \\boxed{} & \\boxed{} \\\\ 0 & 0 & -2\\end{bmatrix}}_{⏟}}_{U}.\n$$\n\nConsider the LU factorization of the matrix $A$ above. From left to right, what are the missing elements from the second row of the matrix $U?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make $0$ at the position ${a}_{21}$ of the matrix $A,$ we proceed as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 3 & -1 \\\\ 6 & 4 & 1 \\\\ 4 & 6 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & -1 \\\\ 0 & -5 & 4 \\\\ 4 & 6 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, from left to right, the elements from the second row of $U$ are $0,-5,$ and $4.$"} {:db/id 17592186120208 :knowledge-point/_questions [{:db/id 17592186119798 :knowledge-point/id #uuid "d216cc0e-58a7-5fab-b5fe-60c7656338cc" :knowledge-point/title "Finding Missing Numbers in the Matrix L of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84e2ddec-f20e-53a0-8f48-3a2e7c640f72" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186117410} {:answer/id #uuid "ad0b2ad4-5008-5a28-9baf-78629788dc19" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186117411} {:answer/id #uuid "29d44870-1bac-5f1d-b5ed-9cc388140037" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186117412} {:answer/id #uuid "429de2de-d947-585a-9e51-c40146bf674e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186117413} {:answer/id #uuid "7c1729d1-5eec-5401-bc05-8749723a55ef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186117414}] :answer-field/correct {:answer/id #uuid "ad0b2ad4-5008-5a28-9baf-78629788dc19" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186117411} :answer-field/id #uuid "95a8e23f-3ba8-5417-b280-b1146cb19862" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186117409}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9544c436-69ea-5799-a310-14a5c40ac4f4" :question/math-academy-id "q-32805" :question/problem "$$\n{{\\begin{bmatrix}3 & 2 & -5 \\\\ 12 & 9 & 0 \\\\ 9 & 7 & -12\\end{bmatrix}}_{⏟}}_{A}={{\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 3 & \\boxed{} & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 0 & -17\\end{bmatrix}}_{⏟}}_{U}\n$$\n\nConsider the LU factorization of the matrix $A$ above. What is the value of the entry ${l}_{32}$ in the matrix $L?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make zeros below the main diagonal, we proceed as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 2 & -5 \\\\ 12 & 9 & 0 \\\\ 9 & 7 & -12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 9 & 7 & -12\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we want to make $0$ at the position ${a}_{32}$ using Gaussian elimination. To do this, we take the $3$rd row of $A,$ and we add the $2$nd row of $A$ multiplied by $-1:$\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 1 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 0 & -17\\end{bmatrix}\\end{aligned}\n$$\n\nThe entry ${l}_{32}$ of the matrix $L$ is the factor next to ${R}_{2},$ taken with the opposite sign:\n\n$$\n{l}_{32}=-(-1)=1.\n$$"} {:db/id 17592186120247 :knowledge-point/_questions [{:db/id 17592186119831 :knowledge-point/id #uuid "45cdbb0d-2986-5c05-8d23-dce29363051b" :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Straight Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72c2e5ca-f263-54ef-924a-e167ca91f89b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-2,2,0⟩=⟨-4,6,2⟩" :db/id 17592186363753} {:answer/id #uuid "32d8e4c3-ddfe-54ee-ae03-e8de00c5efb9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-2,2,0⟩=20" :db/id 17592186363754} {:answer/id #uuid "730f759e-812a-532c-8ba9-65f2916ee485" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=20" :db/id 17592186363755} {:answer/id #uuid "9471d411-f775-5f03-a79f-1eb639079ffa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=0" :db/id 17592186363756} {:answer/id #uuid "1f6058f7-7b71-5d3e-a88e-644aa57521b7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=⟨-2,2,0⟩" :db/id 17592186363757}] :answer-field/correct {:answer/id #uuid "730f759e-812a-532c-8ba9-65f2916ee485" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=20" :db/id 17592186363755} :answer-field/id #uuid "12ab60fb-0ccd-54c4-b8b9-1cf65f373926" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186363752}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8a0ae68a-8650-5549-af6c-052d2786d395" :question/math-academy-id "q-33316" :question/problem "Find an equation of the plane that passes through the point $Q(-2,2,0)$ and is perpendicular to the line \n\n$$\n\\left\\{\\begin{aligned}x &=3-4t \\\\ y &=1+6t \\\\ z &=-1+2t.\\end{aligned}\\right.\n$$" :question/worked-solution "Note that the position vector of $Q$ is $q=⟨-2,2,0⟩.$ Converting the parametric equations of the line to vector form, we get\n\n$$\n\\left\\{\\begin{aligned}x &=3-4t \\\\ y &=1+6t \\\\ z &=-1+2t\\end{aligned}\\right.\\,⟹\\,⟨x,y,z⟩=⟨3,1,-1⟩+t\\text{ }{{⟨-4,6,2⟩}_{⏟}}_{v}.\n$$\n\n \n\nThe direction vector of the line is $v=⟨-4,6,2⟩,$ so a normal vector to the plane is \n\n$$\nn=v=⟨-4,6,2⟩.\n$$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨-4,6,2⟩ & =⟨-2,2,0⟩\\cdot ⟨-4,6,2⟩ \\\\ r\\cdot ⟨-4,6,2⟩ & =20.\\end{aligned}\n$$"} {:db/id 17592186120379 :knowledge-point/_questions [{:db/id 17592186119820 :knowledge-point/id #uuid "6e4f1675-9146-5279-9b64-07a63a9bed99" :knowledge-point/title "Finding a Vector Given Its Coordinates Relative To a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2513b831-2bda-5222-a175-9dbc2cbe0fa3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-21 \\\\ 11 \\\\ -12\\end{bmatrix}" :db/id 17592186430711} {:answer/id #uuid "29376ce5-1709-5e3d-9b46-93794cef8b6b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 11 \\\\ 12\\end{bmatrix}" :db/id 17592186430712} {:answer/id #uuid "54390e6e-dcb1-5dd3-95c7-15b36777dc0f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 \\\\ -12 \\\\ 21\\end{bmatrix}" :db/id 17592186430714} {:answer/id #uuid "916a198b-9533-5031-bb1d-8a1a6d13d6a1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 \\\\ 12 \\\\ 11\\end{bmatrix}" :db/id 17592186430719} {:answer/id #uuid "d3e2768b-1c0b-587c-8548-9c3d0f3aae84" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 21 \\\\ 11\\end{bmatrix}" :db/id 17592186430723}] :answer-field/correct {:answer/id #uuid "d3e2768b-1c0b-587c-8548-9c3d0f3aae84" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 21 \\\\ 11\\end{bmatrix}" :db/id 17592186430723} :answer-field/id #uuid "d5940cf3-d0a0-564c-9b31-70b2bd92b22b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186118388}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd151813-8e78-53b9-b9c5-57f0cca18b33" :question/math-academy-id "q-35232" :question/problem "Find the vector $x$, if $B=\\{{b}_{1},{b}_{2}\\}$ is a basis of $\\text{Span}\\{{b}_{1},{b}_{2}\\},$ and \n\n$$\n{b}_{1}=\\begin{bmatrix}3 \\\\ -2 \\\\ 3\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}5 \\\\ 3 \\\\ 4\\end{bmatrix},\\,[x]_{B}=\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}.\n$$" :question/worked-solution "We know that any vector in  $\\text{Span}\\{{b}_{1},{b}_{2}\\}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ -2 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}5 \\\\ 3 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix},$ we obtain\n\n$$\n\\begin{aligned}x & ={{(\\,-3\\,)}_{⏟}}_{{x}_{1}}\\begin{bmatrix}3 \\\\ -2 \\\\ 3\\end{bmatrix}+{{(\\,5\\,)}_{⏟}}_{{x}_{2}}\\begin{bmatrix}5 \\\\ 3 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 \\\\ 6 \\\\ -9\\end{bmatrix}+\\begin{bmatrix}25 \\\\ 15 \\\\ 20\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 \\\\ 21 \\\\ 11\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186120435 :knowledge-point/_questions [{:db/id 17592186119780 :knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fcef5e-b3e2-5ccd-ad74-3f0f2bf5215e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186327159} {:answer/id #uuid "8ef0a0f8-a3e1-5867-a44d-53d8501860b3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186328178} {:answer/id #uuid "9b76b2b0-7b79-5bed-b323-bb17d564fb79" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id 17592186328279} {:answer/id #uuid "c5b548cb-6708-57bd-8aac-098ad056ea48" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id 17592186328668} {:answer/id #uuid "e9942f7d-5789-519b-8b26-e8f47afefdff" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id 17592186328982}] :answer-field/correct {:answer/id #uuid "19fcef5e-b3e2-5ccd-ad74-3f0f2bf5215e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186327159} :answer-field/id #uuid "e1c7dcea-54be-5b44-9e93-100efe093b8e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186329575}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b66a6d15-0b61-5b61-a152-b57545d60ac8" :question/math-academy-id "q-42581" :question/problem "Given that \n$|\\begin{aligned}a+3 & -5 \\\\ b & 6\\end{aligned}|=-7$,\nfind \n$|\\begin{aligned}a+2 & -5 \\\\ b+4 & 6\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a+2 & -5 \\\\ b+4 & 6\\end{aligned}| & =|\\begin{aligned}(a+3)-1 & -5 \\\\ b+4 & 6\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}(a+3)-1 & -5 \\\\ b+4 & 6\\end{aligned}| & ={{|\\begin{aligned}a+3 & -5 \\\\ b & 6\\end{aligned}|}_{⏟}}_{-7}+|\\begin{aligned}-1 & -5 \\\\ 4 & 6\\end{aligned}| \\\\  & =-7+(-6+20) \\\\  & =7.\\end{aligned}\n$$"} {:db/id 17592186120519 :knowledge-point/_questions [{:db/id 17592186119793 :knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39980026-393f-53ea-96db-18546c54f0ef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186399004} {:answer/id #uuid "464b6f7e-c173-51c1-b8b9-0696fe3717dd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186399005} {:answer/id #uuid "ca4c369b-196d-5064-b6ae-30dbe1fb3ef8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186399006} {:answer/id #uuid "5f99f5bf-c4dc-5243-9e20-a60473d43cdf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186399007} {:answer/id #uuid "322571b5-cff6-5af1-8ffc-3d69d30c42af" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186399008}] :answer-field/correct {:answer/id #uuid "39980026-393f-53ea-96db-18546c54f0ef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186399004} :answer-field/id #uuid "cbf795c1-51c1-5c95-aceb-7374460b2805" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186399003}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b5fd0b7-3607-5c20-a6b8-4820e0b30df7" :question/math-academy-id "q-74799" :question/problem "Given that \n$A=\\begin{bmatrix}1 & 5 \\\\ 2 & 10\\end{bmatrix},$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 5 \\\\ 2 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & 5 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 5 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=2,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=2.$"} {:db/id 17592186120524 :knowledge-point/_questions [{:db/id 17592186119858 :knowledge-point/id #uuid "b72ed196-a73b-59ab-a7c3-5173249cf7e5" :knowledge-point/title "Determining Whether a Given Set Is a Basis of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a085452-508a-5b7b-9027-923aa9e0f3a7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186342717} {:answer/id #uuid "44c231fb-66cf-5e07-b090-8170edcc6e4d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186342805} {:answer/id #uuid "549f247b-4a7b-5159-af5c-a77231e6302a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186342943} {:answer/id #uuid "58afd2ab-2082-5e68-a07f-2b6c97c362d7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186342981} {:answer/id #uuid "931fbf19-90fd-5095-9ed2-228296291e7d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is not a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}$" :db/id 17592186429761}] :answer-field/correct {:answer/id #uuid "3a085452-508a-5b7b-9027-923aa9e0f3a7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186342717} :answer-field/id #uuid "46b7a3a7-df12-5d1d-b338-4bd967eaa038" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186344612}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1c72b3a4-9e18-57da-90d5-8d38d6a9dad9" :question/math-academy-id "q-75588" :question/problem "The vectors ${a}_{1},$ ${a}_{2},$ ${a}_{3},$ and ${a}_{4}$ are given below. Determine whether $B=\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}.$ If that is the case, find ${x}_{1}+{x}_{2}+{x}_{3},$ where ${a}_{4}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 3 \\\\ -5\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}1 \\\\ -2 \\\\ 6\\end{bmatrix},\\,{a}_{4}=\\begin{bmatrix}-1 \\\\ 2 \\\\ 2\\end{bmatrix}\n$$" :question/worked-solution "We want to determine if $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}.$ So, we want to find ${x}_{1},{x}_{2},{x}_{3}\\in R$ such that \n\n$$\n{x}_{1}{{\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}}_{⏟}}_{{a}_{1}}+{x}_{2}{{\\begin{bmatrix}-1 \\\\ 3 \\\\ -5\\end{bmatrix}}_{⏟}}_{{a}_{2}}+{x}_{3}{{\\begin{bmatrix}1 \\\\ -2 \\\\ 6\\end{bmatrix}}_{⏟}}_{{a}_{3}}={{\\begin{bmatrix}-1 \\\\ 2 \\\\ 2\\end{bmatrix}}_{⏟}}_{{a}_{4}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3} &=-1 \\\\ -2{x}_{1}+3{x}_{2}-2{x}_{3} &=2 \\\\ 5{x}_{1}-5{x}_{2}+6{x}_{3} &=2\\end{aligned}\\right.\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}1 & -1 & 1 & -1 \\\\ -2 & 3 & -2 & 2 \\\\ 5 & -5 & 6 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 & -1 \\\\ 0 & 1 & 0 & 0 \\\\ 5 & -5 & 6 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 & -1 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 7\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -8 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 7\\end{bmatrix} & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -8 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the reduced matrix above, we see that the pivot columns are the $1$st, $2$nd, and $3$rd columns. So,  $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}.$\nAlso, the matrix tells us that ${x}_{1}=-8,$ ${x}_{2}=0,$ and ${x}_{3}=7,$ meaning that\n\n$$\n(-8)\\cdot {{\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}}_{⏟}}_{{a}_{1}}+0\\cdot {{\\begin{bmatrix}-1 \\\\ 3 \\\\ -5\\end{bmatrix}}_{⏟}}_{{a}_{2}}+7\\cdot {{\\begin{bmatrix}1 \\\\ -2 \\\\ 6\\end{bmatrix}}_{⏟}}_{{a}_{3}}={{\\begin{bmatrix}-1 \\\\ 2 \\\\ 2\\end{bmatrix}}_{⏟}}_{{a}_{4}}.\n$$\n\nTherefore, ${x}_{1}+{x}_{2}+{x}_{3}=-8+0+7=-1.$"} {:db/id 17592186120525 :knowledge-point/_questions [{:db/id 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f5fc79-efcf-5beb-8f44-6c5bbee2e205" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/id 17592186416934} {:answer/id #uuid "460c227b-da50-5240-a61b-5d7158cbefb0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186416935} {:answer/id #uuid "b96e7099-61f5-552d-a37f-75ea4d0acd7b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186416938} {:answer/id #uuid "c28d8b2c-0794-5b52-be1a-1a5068c24206" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186416939} {:answer/id #uuid "ca59db9a-208c-56e6-9d14-d390aecd3368" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186416941}] :answer-field/correct {:answer/id #uuid "460c227b-da50-5240-a61b-5d7158cbefb0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186416935} :answer-field/id #uuid "c652bfa5-8e6a-53fc-ad6f-da352c6f194d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186416945}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93dd069a-4710-5057-b8fe-736d3ab4c0dc" :question/math-academy-id "q-75844" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}0 \\\\ -4 \\\\ 2\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{\\begin{bmatrix}0 \\\\ -4 \\\\ 2\\end{bmatrix}}_{⏟}}_{x}={{(\\,2\\,)}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{{(\\,-4\\,)}_{⏟}}_{{x}_{2}}\\cdot {{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=2\\cdot {b}_{1}+(-4)\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}.\n$$\n\nFinally, we have that ${x}_{2}=-4.$"} {:db/id 17592186124359 :knowledge-point/_canonical-example [{:db/id 17592186124550 :knowledge-point/id #uuid "f5e23379-0f5d-5691-b10f-5125325ffa70" :knowledge-point/title "Finding a Transformed Square Root Function Given Some Properties"}] :question/id #uuid "cdb0a166-a880-5efb-a747-ac8f940ff50b" :question/math-academy-id "e-5878" :question/problem "Let $f(x)=a\\sqrt{b-x}+c.$ Now consider the following properties of $f(x)\\mathbin{:}$\n\n- The domain of $f(x)$ is $x \\in (-\\infty, 2].$\n\n- The range  is $f(x) \\in [2, \\infty).$\n\n- The point $(1,4)$ lies on the graph of $y=f(x).$\n\nFind the value of $a+b+c.$" :question/worked-solution "Let's consider each property in turn.\n\n- The domain of $f(x)=a\\sqrt{b-x}+c\\,$ is determined by the following inequality:\n\n$$\n\\begin{aligned}b-x & \\ge 0 \\\\ x & \\le b\\end{aligned}\n$$\n\nWe are given that the domain is $x\\in \\left(-\\infty, 2\\right],$ which is equivalent to $x\\le 2.$ Hence, we obtain\n\n$$\nb=2.\n$$\n\n- Since the range is unbounded on the right-hand side, we know that $a>0.$ Furthermore, since we are given that the lowest point in the range is $2,$ we must have\n\n$$\n\\begin{aligned}{{a\\sqrt{2-x}}_{⏟}}_{\\ge 0}+c\\ge 2.\\end{aligned}\n$$\n\nThis means that $c=2.$\n\n- Finally, since the point $(1,4)$ lies on the graph of $y=f(x),$ we have\n\n$$\n\\begin{aligned}f(1) & =a\\sqrt{2-1}+2 \\\\ 4 & =a+2 \\\\ a & =2.\\end{aligned}\n$$\n\nTherefore, our function is $f(x)=2\\sqrt{2-x}+2,$ and \n\n$$\na+b+c = 2 + 2 + 2 = 6.\n$$"} {:db/id 17592186125045 :knowledge-point/_questions [{:db/id 17592186124530 :knowledge-point/id #uuid "634729e9-7633-52d8-99fa-b00fc9cbe96a" :knowledge-point/title "Raising a Matrix to a Large Power Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67758f6f-0bf0-51fc-87c0-90fd9ee00d97" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} & 0 \\\\ 0 & -\\frac{1}{2}\\end{bmatrix}" :db/id 17592186321953} {:answer/id #uuid "967675ed-4e19-57c8-99ea-021237893dad" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -2 \\\\ 0 & -1\\end{bmatrix}" :db/id 17592186322346} {:answer/id #uuid "adc0e8ef-12e7-5f5e-becc-f92a32cdaebd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 1\\end{bmatrix}" :db/id 17592186322510} {:answer/id #uuid "beab62c6-eabf-50ec-9210-1f331a3c0fca" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}100 & 0 \\\\ 0 & 100\\end{bmatrix}" :db/id 17592186322632} {:answer/id #uuid "ddc12535-e7f5-5390-8e16-a0d91cccf389" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id 17592186322880}] :answer-field/correct {:answer/id #uuid "967675ed-4e19-57c8-99ea-021237893dad" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -2 \\\\ 0 & -1\\end{bmatrix}" :db/id 17592186322346} :answer-field/id #uuid "b46b2ed8-bb1b-55ea-a099-3b79ebaba1ec" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186323520}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6af12003-3389-5965-bc72-a49e9c3974b5" :question/math-academy-id "q-37257" :question/problem "Find ${A}^{101},$ where\n\n$$\nA=\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, notice that\n\n$$\n{\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}}^{-1}=\\begin{bmatrix}\\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 1\\end{bmatrix}=\\frac{1}{2}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix}.\n$$\n\nSo, we have been given the following diagonalization of $A:$\n\n$$\nA={{\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{P}{{\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}}_{⏟}}_{D}{{{\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSince $A=PD{P}^{-1}$, we can compute ${A}^{k}$ by using the formula \n\n$$\n{A}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{A}^{101} & =P{D}^{101}{P}^{-1} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}{\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}}^{101}(\\frac{1}{2}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix}) \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{1}^{101} & 0 \\\\ 0 & (-1)^{101}\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -1 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 0 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id 17592186125046 :knowledge-point/_questions [{:db/id 17592186124531 :knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5" :knowledge-point/title "Finding the Eigenvalues and Eigenvectors of a Matrix Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026fb663-6db7-5640-8875-dad772aa751c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}$" :db/id 17592186321169} {:answer/id #uuid "6f28b14d-e5b8-564e-bbdb-2793afb1935e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$" :db/id 17592186322007} {:answer/id #uuid "89891add-72a4-5d41-91be-cc15a2df53bb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$" :db/id 17592186322244} {:answer/id #uuid "a87f6a24-49a8-5233-9b6b-d0de2fabdee2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}$ and $\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}$" :db/id 17592186322467} {:answer/id #uuid "c403344f-4c0e-599e-b311-7109a932bd5f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}$" :db/id 17592186322669}] :answer-field/correct {:answer/id #uuid "89891add-72a4-5d41-91be-cc15a2df53bb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$" :db/id 17592186322244} :answer-field/id #uuid "b35eefc0-286f-5dc2-b481-7d578529add5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186323517}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3186ab9d-e1b7-5f08-9515-496d883e1032" :question/math-academy-id "q-37270" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $B$ given that \n\n$$\nB\\begin{bmatrix}1 & 2 \\\\ 2 & -1\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the matrix $\\begin{bmatrix}1 & 2 \\\\ 2 & -1\\end{bmatrix}$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $B:$\n\n$$\nB={{\\begin{bmatrix}1 & 2 \\\\ 2 & -1\\end{bmatrix}}_{⏟}}_{P}{{\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}}_{⏟}}_{D}{{{\\begin{bmatrix}1 & 2 \\\\ 2 & -1\\end{bmatrix}}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $B$ is diagonalizable. The eigenvalues of $B$ are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3$ and the corresponding eigenvectors are the columns of the matrix $P:$\n\n$\\,$ ${v}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\,$ and $\\,{v}_{2}=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$"} {:db/id 17592186125047 :knowledge-point/_questions [{:db/id 17592186124572 :knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e" :knowledge-point/title "Restoring a Matrix Given Its Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0160f5a3-2ea1-5858-b954-3348e5f89bc6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 3 \\\\ -2 & 5\\end{bmatrix}" :db/id 17592186321162} {:answer/id #uuid "02754f47-bdf7-52a7-926f-faa704f8c1c8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 \\\\ 2 & 11\\end{bmatrix}" :db/id 17592186321171} {:answer/id #uuid "58f54d69-961e-58e6-8bf8-7c203ba49701" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 3 \\\\ -1 & 11\\end{bmatrix}" :db/id 17592186321847} {:answer/id #uuid "6f0a589e-53b0-51b6-a7aa-ab1776d86608" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -1 \\\\ -2 & 0\\end{bmatrix}" :db/id 17592186322006} {:answer/id #uuid "b6eff625-fb6f-5013-b9cc-cca3da5bfac1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 3 \\\\ -2 & 11\\end{bmatrix}" :db/id 17592186322571}] :answer-field/correct {:answer/id #uuid "b6eff625-fb6f-5013-b9cc-cca3da5bfac1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 3 \\\\ -2 & 11\\end{bmatrix}" :db/id 17592186322571} :answer-field/id #uuid "5700a7c9-a32d-554d-943b-5562d53a985c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186323337}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97605f63-4e2b-5abe-a9b2-c8a3d46a4bac" :question/math-academy-id "q-37271" :question/problem "Find a $2\\times 2$ matrix $C$ that has eigenvalues ${\\lambda }_{1}=10$ and ${\\lambda }_{2}=5,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $C,$ then $C$ must be diagonalizable.\n\nSo, we can write $C=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $C,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nC={{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}_{⏟}}_{P}{{\\begin{bmatrix}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{bmatrix}}_{⏟}}_{D}{{{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=\\begin{bmatrix}1 & 3 \\\\ 2 & 1\\end{bmatrix}.$ Then,\n\n$$\n\\begin{aligned}{P}^{-1} & ={\\begin{bmatrix}1 & 3 \\\\ 2 & 1\\end{bmatrix}}^{-1}=-\\frac{1}{5}\\begin{bmatrix}1 & -3 \\\\ -2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}1 & 3 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}10 & 0 \\\\ 0 & 5\\end{bmatrix}(-\\frac{1}{5}\\begin{bmatrix}1 & -3 \\\\ -2 & 1\\end{bmatrix}) \\\\  & =-\\frac{1}{5}\\begin{bmatrix}10 & 15 \\\\ 20 & 5\\end{bmatrix}\\begin{bmatrix}1 & -3 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 3 \\\\ -2 & 11\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186125048 :knowledge-point/_questions [{:db/id 17592186124531 :knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5" :knowledge-point/title "Finding the Eigenvalues and Eigenvectors of a Matrix Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c505c34a-6210-52dc-9732-f2260baedfa9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}$ and $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$" :db/id 17592186402531} {:answer/id #uuid "ed8d32cf-4089-536a-8796-e014322aa487" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}$ and $\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}$" :db/id 17592186402532} {:answer/id #uuid "7d507227-6d48-5cfc-b4f5-d6930a1040f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$" :db/id 17592186402533} {:answer/id #uuid "b30be1cb-84db-582c-9ee4-b5cbb0b9b4d1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$" :db/id 17592186402534} {:answer/id #uuid "2e0b88f1-c1f3-5ac7-ae96-efd7c30d9a2b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ and $\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$" :db/id 17592186402535}] :answer-field/correct {:answer/id #uuid "7d507227-6d48-5cfc-b4f5-d6930a1040f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$" :db/id 17592186402533} :answer-field/id #uuid "a009d7d9-b93b-5ca2-863d-de3e1855e0a2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186402530}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "18390ea4-94e2-564d-880f-13ae6fda894d" :question/math-academy-id "q-37272" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $E$ given that \n\n$$\n\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}E=\\begin{bmatrix}2 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the matrix $\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $E:$\n\n$$\nE={{{\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}}^{-1}}_{⏟}}_{P}{{\\begin{bmatrix}2 & 0 \\\\ 0 & -1\\end{bmatrix}}_{⏟}}_{D}{{\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $E$ is diagonalizable. The eigenvalues of $E$ are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-1$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}}^{-1}=\\frac{1}{-1}\\begin{bmatrix}1 & -1 \\\\ -3 & 2\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ 3 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}\\,$ and $\\,{v}_{2}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$"} {:db/id 17592186125058 :knowledge-point/_questions [{:db/id 17592186124572 :knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e" :knowledge-point/title "Restoring a Matrix Given Its Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afdd57a1-0170-5f78-b9f3-7d133a214662" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 & -30 \\\\ 24 & 28\\end{bmatrix}" :db/id 17592186392083} {:answer/id #uuid "a6c22fe6-7a29-5d53-bf1e-dcb01618c82b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-17 & -30 \\\\ 24 & 21\\end{bmatrix}" :db/id 17592186392084} {:answer/id #uuid "c648c211-0d7a-5426-9417-4c8a14e61fa5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-25 & -30 \\\\ 24 & 27\\end{bmatrix}" :db/id 17592186392085} {:answer/id #uuid "18b5d9da-81e5-5e43-a23d-2cbb8e906e9a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & -3 \\\\ 4 & 8\\end{bmatrix}" :db/id 17592186392086} {:answer/id #uuid "dee154fe-92ae-598d-97c7-e844548af75e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 & -20 \\\\ 20 & 28\\end{bmatrix}" :db/id 17592186392087}] :answer-field/correct {:answer/id #uuid "afdd57a1-0170-5f78-b9f3-7d133a214662" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 & -30 \\\\ 24 & 28\\end{bmatrix}" :db/id 17592186392083} :answer-field/id #uuid "f6b268bf-a60e-5b96-96c4-82721f1bf955" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186392082}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b5330de-42e9-59fc-85b7-be3de824baa9" :question/math-academy-id "q-37314" :question/problem "Find a $2\\times 2$ matrix $F$ that has eigenvalues ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-2,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}5 \\\\ -4\\end{bmatrix}\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $F,$ then $F$ must be diagonalizable.\n\nSo, we can write $F=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $F,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nF={{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}_{⏟}}_{P}{{\\begin{bmatrix}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{bmatrix}}_{⏟}}_{D}{{{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=\\begin{bmatrix}-1 & 5 \\\\ 1 & -4\\end{bmatrix}.$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={\\begin{bmatrix}-1 & 5 \\\\ 1 & -4\\end{bmatrix}}^{-1}=\\frac{1}{-1}\\begin{bmatrix}-4 & -5 \\\\ -1 & -1\\end{bmatrix}=\\begin{bmatrix}4 & 5 \\\\ 1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}F & =\\begin{bmatrix}-1 & 5 \\\\ 1 & -4\\end{bmatrix}\\begin{bmatrix}4 & 0 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}4 & 5 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & -10 \\\\ 4 & 8\\end{bmatrix}\\begin{bmatrix}4 & 5 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-26 & -30 \\\\ 24 & 28\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186125085 :knowledge-point/_questions [{:db/id 17592186124530 :knowledge-point/id #uuid "634729e9-7633-52d8-99fa-b00fc9cbe96a" :knowledge-point/title "Raising a Matrix to a Large Power Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5f0e3f-05e4-5b32-8e42-33db9fecfeec" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{2} \\\\ -1 & 0\\end{bmatrix}" :db/id 17592186392116} {:answer/id #uuid "afc41b45-077b-59fa-a6a2-e28ef564d7c3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id 17592186392117} {:answer/id #uuid "e32ce8d9-f253-5c0c-9791-88ffd609ec43" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id 17592186392118} {:answer/id #uuid "d874ecd1-ed8a-514f-b148-263bd1e5349a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}97 & 0 \\\\ 0 & -97\\end{bmatrix}" :db/id 17592186392119} {:answer/id #uuid "cd20040e-34e4-5440-afc8-b39be1193ca2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} & 0 \\\\ 0 & -\\frac{1}{2}\\end{bmatrix}" :db/id 17592186392120}] :answer-field/correct {:answer/id #uuid "e32ce8d9-f253-5c0c-9791-88ffd609ec43" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id 17592186392118} :answer-field/id #uuid "f73eb74f-7d8e-56f2-a6c1-4e42926c09f2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186392115}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7259ad7-f6a1-5f38-87c9-86ba246db7b9" :question/math-academy-id "q-37597" :question/problem "Find ${A}^{97},$ where\n\n$$\nA=\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}{\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}}^{-1}.\n$$" :question/worked-solution "We have been given the following diagonalization of $A.$\n\n$$\nA={{\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}}_{⏟}}_{P}{{\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{D}{{{\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSo, since $A=PD{P}^{-1}$, we can compute ${A}^{k}$ by using the formula \n\n$$\n{A}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nFirst, we find the inverse of the matrix $P.$ We get\n\n$$\n{\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}}^{-1}=\\frac{1}{-2}\\begin{bmatrix}2 & 0 \\\\ -1 & -1\\end{bmatrix}=-\\frac{1}{2}\\begin{bmatrix}2 & 0 \\\\ -1 & -1\\end{bmatrix}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{A}^{97} & =P{D}^{97}{P}^{-1} \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}{\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}}^{97}{\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}}^{-1} \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}(-1)^{97} & 0 \\\\ 0 & {1}^{97}\\end{bmatrix}(-\\frac{1}{2}\\begin{bmatrix}2 & 0 \\\\ -1 & -1\\end{bmatrix}) \\\\  & =-\\frac{1}{2}\\begin{bmatrix}-1 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ -1 & -1\\end{bmatrix} \\\\  & =-\\frac{1}{2}\\begin{bmatrix}1 & 0 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 2 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id 17592186125149 :knowledge-point/_questions [{:db/id 17592186124550 :knowledge-point/id #uuid "f5e23379-0f5d-5691-b10f-5125325ffa70" :knowledge-point/title "Finding a Transformed Square Root Function Given Some Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9fddb3a-fdaf-54be-90bc-3832f297ecbc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186123495} {:answer/id #uuid "2e3cfb12-b53a-5c56-a062-f2e81b982bbe" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186123496} {:answer/id #uuid "4957773d-db22-5420-a308-9be4e177a3a6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186123497} {:answer/id #uuid "5a955389-14d7-50fb-bc2e-0a597c3065de" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186123498} {:answer/id #uuid "5b780b4c-c044-5f38-abac-68cc0fd0d816" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186123499}] :answer-field/correct {:answer/id #uuid "4957773d-db22-5420-a308-9be4e177a3a6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186123497} :answer-field/id #uuid "cbd9fe82-3cd6-5cc9-9a59-44ad6798b172" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186123494}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4c25a94d-aa0f-5265-8f93-b727f1f1fa1d" :question/math-academy-id "q-39533" :question/problem "Let $f(x)=a\\sqrt{x+b}+c.$ Now consider the following properties of $f(x):$\n\n- The domain of $f(x)$ is $x\\in [1,\\infty ).$\n\n- The range is $f(x)\\in [2,\\infty ).$\n\n- The point $(5,4)$ lies on the graph of $y=f(x).$\n\nFind the value of $a+b+c.$" :question/worked-solution "Let's consider each property in turn.\n\n- The domain of $f(x)=a\\sqrt{x+b}+c\\,$ is determined by the following inequality:\n\n$$\n\\begin{aligned}x+b & \\ge 0 \\\\ x & \\ge -b\\end{aligned}\n$$\n\nWe are given that the domain is $x\\in [1,\\infty ),$ which is equivalent to $x\\ge 1.$ Hence, we obtain\n\n$$\n-b=1\\,⟹\\,b=-1.\n$$\n\n- Since the range is unbounded on the right-hand side, we know that $a>0.$ Furthermore, since we are given that the lowest point in the range is $2,$ we must have\n\n$$\n\\begin{aligned}{{a\\sqrt{x-1}}_{⏟}}_{\\ge 0}+c\\ge 2.\\end{aligned}\n$$\n\nThis means that $c=2.$\n\n- Finally, since the point $(5,4)$ lies on the graph of $y=f(x),$ we have\n\n$$\n\\begin{aligned}f(5) & =a\\sqrt{5-1}+2 \\\\ 4 & =2a+2 \\\\ 2a & =2 \\\\ a & =1.\\end{aligned}\n$$\n\nTherefore, our function is $f(x)=\\sqrt{x-1}+2$ and \n\n$$\na+b+c=1+(-1)+2=2.\n$$"} {:db/id 17592186128943 :knowledge-point/_canonical-example [{:db/id 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/id #uuid "6bba4758-678a-5bf6-b9df-cdc2662ab306" :question/math-academy-id "e-5525" :question/problem "If ![](images/9e/9e1718bbf8790a9cc89d7cc1c6dd7879f8e222f348e5a9a56fec83a1b033250d.png) and ![](images/e9/e99949f7e98aee85a040f698b15822927d7aabea1e688337d209c8e1d08850d6.png) are the real and imaginary parts of the matrix ![](images/64/642f01152b6a1717300120241f788a24098413648cd70e8d0399629f11be2254.png) then what is the value of $ad+eh?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2-3\\text{i} & -5-7\\text{i} \\\\ 1-6\\text{i} & 5-9\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 & -5 \\\\ 1 & 5\\end{bmatrix}}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{\\begin{bmatrix}-3 & -7 \\\\ -6 & -9\\end{bmatrix}}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $a=2,d=5,e=-3$ and $h=-9.$ Therefore,\n\n$$\nad+eh=2 \\cdot 5 + (-3) \\cdot (-9) = 37.\n$$"} {:db/id 17592186128945 :knowledge-point/_canonical-example [{:db/id 17592186129134 :knowledge-point/id #uuid "b049dea4-5045-57ec-ad6a-c49f30e5da1f" :knowledge-point/title "Converting a Matrix to Rotation-Scaling Form Given Multiple Parts of the Decomposition"}] :question/id #uuid "1b13d9bb-9bcf-50be-a58d-39e82d99b9bf" :question/math-academy-id "e-5530" :question/problem "![](images/5f/5f3cd6aeb514ee0a59d1f3534342f85e1c00743d9e7c7004b8aaf8ccfbe353f9.png)\nConsider the vector $\\mathbf{v}$ and the rotation-scaling matrix $C$ shown above. Given that $\\mathbf{v}$ is an eigenvector of a $2 \\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda=-1-4\\textrm{i},$ find a matrix $P$ such that $A=PCP^{-1}.$" :question/worked-solution "Recall that for any $2 \\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PCP^{-1},$ where \n\n![](images/9f/9fb15e52a1df912c9e5fb4238f45d705cd0a56fb7190620c0f0fd597f9a2b8c0.png)\n\nand $\\mathbf{v}$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda.$\n\nFirst, notice that \n\n![](images/80/80bd36915851e6ebeb67befe8af41e5496fa5491b9d87c294d8b937eb586319f.png)\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}1 \\\\ 1+2\\text{i}\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P\\mathbin{:}$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 1 & 2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id 17592186129033 :knowledge-point/_canonical-example [{:db/id 17592186129214 :knowledge-point/id #uuid "88f3ba21-6407-503e-aec0-fa4462a69e73" :knowledge-point/title "Converting a Matrix to Rotation-Scaling Form Using the Complex Conjugate"}] :question/id #uuid "e0469305-b1d9-5430-9911-2f0c209b3264" :question/math-academy-id "e-8734" :question/problem "![](images/f4/f4a051da70308d92a5530fca3ba9c214cff919a6072e0e4d863f5aad10f405ee.png)\nConsider the vector $\\mathbf{v}$ and the rotation-scaling matrix $C$ shown above. Given that $\\mathbf{v}$ is an eigenvector of a $2 \\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda=2+4\\textrm{i},$ find a matrix $P$ such that $A=PCP^{-1}.$" :question/worked-solution "Recall that for any $2 \\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PCP^{-1},$ where \n\n![](images/4a/4a53548a17d9b4fd870ce70285bfc2c57cf6c8d352f75149e5aa7511ef4af853.png)\n\nand $\\mathbf{v}$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda.$\n\nFirst, notice that \n\n![](images/aa/aa5738b600440bf8327670fc21cd8005c660def232119b2b4808237d988367bd.png)\n\nwhile\n\n![](images/fc/fc91fcabd47720075061e670f62be9ea9b636070a05cba70752bb7060608b764.png)\n\nSo, our rotation-scaling matrix $C$ corresponds to the eigenvalue $\\overline{\\lambda}=2-4\\textrm{i},$ \n the complex conjugate of $\\lambda.$ Hence, to construct the matrix $P,$ we use the eigenvector $\\overline{\\mathbf{v}},$ the complex conjugate of $\\mathbf{v}.$\n\nNext, we find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}\\overset{―}{v} & =\\begin{bmatrix}2\\text{i} \\\\ 7\\end{bmatrix}={{\\begin{bmatrix}0 \\\\ 7\\end{bmatrix}}_{⏟}}_{\\text{Re}(\\overset{―}{v})}+\\text{i}{{\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(\\overset{―}{v})}\\end{aligned}\n$$\n\nFinally, we can now construct $P\\mathbin{:}$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(\\overset{―}{v}) & \\text{Im}(\\overset{―}{v}) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}0 & 2 \\\\ 7 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186129525 :knowledge-point/_questions [{:db/id 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67d825c3-216a-5856-b88f-5964ed0cf6ef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,\\delta A" :db/id 17592186383530} {:answer/id #uuid "817eea6b-4bcd-50a0-bd01-e9c9361a4607" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "26\\,\\delta A" :db/id 17592186383531} {:answer/id #uuid "7b00f634-9599-5965-8f40-9e6474ab0791" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id 17592186383532} {:answer/id #uuid "f38e3aba-b47f-541c-aa66-da66bf8d1540" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\delta A" :db/id 17592186383533} {:answer/id #uuid "cfcbe347-2504-5975-baa3-b1307425330b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,\\delta A" :db/id 17592186383534}] :answer-field/correct {:answer/id #uuid "817eea6b-4bcd-50a0-bd01-e9c9361a4607" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "26\\,\\delta A" :db/id 17592186383531} :answer-field/id #uuid "ae626fe0-3107-5566-bc20-cde6cc1edd64" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383529}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fff1ef63-7fa2-5e33-aa47-b4df6f56d662" :question/math-academy-id "q-161788" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{2}+v \\\\ 2u-{v}^{3}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & 1 \\\\ 2 & -3{v}^{2}\\end{aligned}| \\\\  & =2u\\cdot (-3{v}^{2})-1\\cdot 2 \\\\  & =-6u{v}^{2}-2 \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(1,2)} & =(-6u{v}^{2}-2)\\,{|}_{u=1\\,v=2} \\\\  & =-6(1)(2)^{2}-2 \\\\  & =-26\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-26|\\cdot \\delta A \\\\  & =26\\,\\delta A.\\end{aligned}\n$$"} {:db/id 17592186129527 :knowledge-point/_questions [{:db/id 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34dc7b2d-483b-5c21-bc52-af09b2738d49" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id 17592186279050} {:answer/id #uuid "c1a09ab6-33e6-5ece-a662-897c11c5ccd4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\delta A" :db/id 17592186280292} {:answer/id #uuid "d69096ab-d2da-522b-a9e8-43b1733cab55" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,\\delta A" :db/id 17592186280486} {:answer/id #uuid "da3fef5b-3c5a-5bb3-87f5-3ea6a20ec484" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\delta A" :db/id 17592186280518} {:answer/id #uuid "fed38294-cb1c-52e8-92ca-723bf52e3cde" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id 17592186280820}] :answer-field/correct {:answer/id #uuid "34dc7b2d-483b-5c21-bc52-af09b2738d49" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id 17592186279050} :answer-field/id #uuid "41f8b0d5-fe40-59fc-a296-062330e0b4a9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186280944}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c116e20c-7c3c-5121-8057-e62b04b89e02" :question/math-academy-id "q-161832" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,5)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\operatorname{ln}⁡(uv) \\\\ u{v}^{2}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{1}{u} & \\frac{1}{v} \\\\ {v}^{2} & 2uv\\end{aligned}| \\\\  & =\\frac{1}{u}\\cdot 2uv-\\frac{1}{v}\\cdot {v}^{2} \\\\  & =2v-v \\\\  & =v \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(1,5)} & =v\\,{|}_{u=1\\,v=5} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|5|\\cdot \\delta A \\\\  & =5\\,\\delta A.\\end{aligned}\n$$"} {:db/id 17592186129644 :knowledge-point/_questions [{:db/id 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00008a5f-46bf-51bc-bc71-7e6e5690142d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id 17592186323977} {:answer/id #uuid "2c5b2488-9ab3-548c-80ae-f75f363bb6fe" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186324326} {:answer/id #uuid "815389d0-4463-50e5-9fcf-811457001c0e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-27" :db/id 17592186325053} {:answer/id #uuid "e0dd3c78-5e8a-5ed7-839d-dae521761678" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186325937} {:answer/id #uuid "e190012e-28d4-5fdf-9b10-a20e357f90b5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186325947}] :answer-field/correct {:answer/id #uuid "815389d0-4463-50e5-9fcf-811457001c0e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-27" :db/id 17592186325053} :answer-field/id #uuid "c5f94cf5-6618-5739-99be-1e4a49e61a75" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326581}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0690f108-2c65-5ee6-a18d-8fe454db1d74" :question/math-academy-id "q-38390" :question/problem "If $\\,\\text{Re}(x)=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\,$ and $\\,\\text{Im}(x)=\\begin{bmatrix}e & f \\\\ g & h\\end{bmatrix}\\,$ are the real and imaginary parts of the matrix $A=\\begin{bmatrix}3+5\\text{i} & -2-4\\text{i} \\\\ 2-3\\text{i} & 1-6\\text{i}\\end{bmatrix}\\,$ then what is the value of $ad+eh?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3+5\\text{i} & -2-4\\text{i} \\\\ 2-3\\text{i} & 1-6\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}3 & -2 \\\\ 2 & 1\\end{bmatrix}}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{\\begin{bmatrix}5 & -4 \\\\ -3 & -6\\end{bmatrix}}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $a=3,d=1,e=5$ and $h=-6.$ Therefore,\n\n$$\nad+eh=3\\cdot 1+5\\cdot (-6)=-27.\n$$"} {:db/id 17592186129648 :knowledge-point/_questions [{:db/id 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c79d92a-9e2c-559f-9222-6c0b2ec5131a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ -7 & -9\\end{bmatrix}" :db/id 17592186324461} {:answer/id #uuid "6ad37e67-df1f-5bf6-acc9-1a9ccdcb786c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -7 \\\\ 4 & -9\\end{bmatrix}" :db/id 17592186324864} {:answer/id #uuid "7c422197-e1b3-55bf-a2e1-87e24b986d94" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -5 \\\\ 4 & -9\\end{bmatrix}" :db/id 17592186325017} {:answer/id #uuid "83b44667-017b-5980-9e5e-1de342bffb0f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -5 \\\\ 6 & 4\\end{bmatrix}" :db/id 17592186325079} {:answer/id #uuid "e8ee69d6-9383-5cd9-879f-03bee2f2c946" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 3 \\\\ 5 & 2\\end{bmatrix}" :db/id 17592186326021}] :answer-field/correct {:answer/id #uuid "83b44667-017b-5980-9e5e-1de342bffb0f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -5 \\\\ 6 & 4\\end{bmatrix}" :db/id 17592186325079} :answer-field/id #uuid "60d74a9d-8adc-59b6-b717-5f7087d9108a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326387}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd10f116-420a-5abf-b912-c6a791dc88fd" :question/math-academy-id "q-38397" :question/problem "Find the real part of the matrix $A=\\begin{bmatrix}-2+3\\text{i} & -5+2\\text{i} \\\\ 6-7\\text{i} & 4-9\\text{i}\\end{bmatrix}.$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-2+3\\text{i} & -5+2\\text{i} \\\\ 6-7\\text{i} & 4-9\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-2 & -5 \\\\ 6 & 4\\end{bmatrix}}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{\\begin{bmatrix}3 & 2 \\\\ -7 & -9\\end{bmatrix}}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Re}(A)=\\begin{bmatrix}-2 & -5 \\\\ 6 & 4\\end{bmatrix}.$"} {:db/id 17592186129662 :knowledge-point/_questions [{:db/id 17592186129134 :knowledge-point/id #uuid "b049dea4-5045-57ec-ad6a-c49f30e5da1f" :knowledge-point/title "Converting a Matrix to Rotation-Scaling Form Given Multiple Parts of the Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "759cb3d1-4fd4-57fd-844b-d403ba0481c8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id 17592186324947} {:answer/id #uuid "796c6bac-6d8d-550a-a75a-5f92e47919c1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix}" :db/id 17592186324983} {:answer/id #uuid "7af1e329-8609-5f4a-8e5e-4244568929ce" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id 17592186325002} {:answer/id #uuid "b7920c46-2a16-5664-ad36-5cc0669a6d90" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}" :db/id 17592186325545} {:answer/id #uuid "c7e60701-4ad6-55b4-ad0d-8c5364d13882" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}" :db/id 17592186325703}] :answer-field/correct {:answer/id #uuid "b7920c46-2a16-5664-ad36-5cc0669a6d90" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}" :db/id 17592186325545} :answer-field/id #uuid "3177b407-9bba-58a0-8ce8-54e30ce98d1d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326309}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31a3b63f-4053-528b-a2b8-f0ec571660f1" :question/math-academy-id "q-38557" :question/problem "$$\nv=\\begin{bmatrix}-\\text{i} \\\\ 1\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 4 \\\\ -4 & 3\\end{bmatrix}\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =3+4\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" :question/worked-solution "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}3 & 4 \\\\ -4 & 3\\end{bmatrix}=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}-\\text{i} \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186129666 :knowledge-point/_questions [{:db/id 17592186129134 :knowledge-point/id #uuid "b049dea4-5045-57ec-ad6a-c49f30e5da1f" :knowledge-point/title "Converting a Matrix to Rotation-Scaling Form Given Multiple Parts of the Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ce9065-737f-5539-9ccc-e2b738124790" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 1 \\\\ 3 & 0\\end{bmatrix}" :db/id 17592186410831} {:answer/id #uuid "1b240860-8981-5813-8afb-56eb81d9d5f3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ 3 & -2\\end{bmatrix}" :db/id 17592186410835} {:answer/id #uuid "d4ea0660-35e1-50a9-b795-bedb0a6fec90" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ 0 & 3\\end{bmatrix}" :db/id 17592186410847} {:answer/id #uuid "dd8d4b33-9126-5017-a544-498f72884d7e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}" :db/id 17592186410848} {:answer/id #uuid "ed49cec1-2e8a-5d58-9643-ab871cbaf80d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 0\\end{bmatrix}" :db/id 17592186410849}] :answer-field/correct {:answer/id #uuid "dd8d4b33-9126-5017-a544-498f72884d7e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}" :db/id 17592186410848} :answer-field/id #uuid "ca3e15c9-c3c6-56d5-be44-2ff142682b75" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186410854}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dce754c8-5be0-5c82-8349-b2f897b46d75" :question/math-academy-id "q-38571" :question/problem "$$\nv=\\begin{bmatrix}1+2\\text{i} \\\\ 3\\end{bmatrix},\\,C=\\begin{bmatrix}-7 & -6 \\\\ 6 & -7\\end{bmatrix}\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =-7-6\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" :question/worked-solution "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}-7 & -6 \\\\ 6 & -7\\end{bmatrix}=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}1+2\\text{i} \\\\ 3\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186129717 :knowledge-point/_questions [{:db/id 17592186129214 :knowledge-point/id #uuid "88f3ba21-6407-503e-aec0-fa4462a69e73" :knowledge-point/title "Converting a Matrix to Rotation-Scaling Form Using the Complex Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f96ed3-70f8-5ddc-acb6-71587e72f101" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 2 & -3\\end{bmatrix}" :db/id 17592186324543} {:answer/id #uuid "71e88fc2-600f-5365-8aff-acc2b54dc6a1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -3 & 2\\end{bmatrix}" :db/id 17592186324914} {:answer/id #uuid "90374c3c-03f1-5264-a569-174dfb35f325" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ 2 & 3\\end{bmatrix}" :db/id 17592186325196} {:answer/id #uuid "aa418aef-76d7-5108-ab92-460aa075c2f9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 3 & 2\\end{bmatrix}" :db/id 17592186325420} {:answer/id #uuid "f69e55ee-410c-52db-978f-37052ef96cd8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}" :db/id 17592186326143}] :answer-field/correct {:answer/id #uuid "46f96ed3-70f8-5ddc-acb6-71587e72f101" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 2 & -3\\end{bmatrix}" :db/id 17592186324543} :answer-field/id #uuid "05c656fc-b22b-5e23-846d-595499735480" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326233}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "53d94693-fca2-5635-a557-72030e989666" :question/math-academy-id "q-39161" :question/problem "$$\nv=\\begin{bmatrix}-\\text{i} \\\\ 2+3\\text{i}\\end{bmatrix},\\,C=\\begin{bmatrix}1 & -6 \\\\ 6 & 1\\end{bmatrix}\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =1+6\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" :question/worked-solution "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}1 & 6 \\\\ -6 & 1\\end{bmatrix}\\ne C,\n$$\n\nwhile\n\n$$\n\\begin{bmatrix}\\text{Re}(\\overset{―}{\\lambda }) & \\text{Im}(\\overset{―}{\\lambda }) \\\\ -\\text{Im}(\\overset{―}{\\lambda }) & \\text{Re}(\\overset{―}{\\lambda })\\end{bmatrix}=\\begin{bmatrix}1 & -6 \\\\ 6 & 1\\end{bmatrix}=C.\n$$\n\nSo, our rotation-scaling matrix $C$ corresponds to the eigenvalue $\\overset{―}{\\lambda }=1-6\\text{i},$ \n the complex conjugate of $\\lambda .$ Hence, to construct the matrix $P,$ we use the eigenvector $\\overset{―}{v},$ the complex conjugate of $v.$\n\nNext, we find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}\\overset{―}{v} & =\\begin{bmatrix}\\text{i} \\\\ 2-3\\text{i}\\end{bmatrix}={{\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}}_{⏟}}_{\\text{Re}(\\overset{―}{v})}+\\text{i}{{\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}}_{⏟}}_{\\text{Im}(\\overset{―}{v})}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(\\overset{―}{v}) & \\text{Im}(\\overset{―}{v}) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}0 & 1 \\\\ 2 & -3\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186133487 :knowledge-point/_canonical-example [{:db/id 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/id #uuid "87c9cf21-797c-5893-a81b-580685331739" :question/math-academy-id "e-12422" :question/problem "Use Stokes' theorem to evaluate \n\n$$\n\\displaystyle{\\oint\\limits_{C}\\mathbf{F}\\cdot\\mathrm{d}\\mathbf{r}},\n$$\n\nwhere $\\textrm{curl}\\,\\mathbf{F} = \\langle -xz, \\: -yz, \\: x+z^2 \\rangle,$ and $C$ is the intersection of the paraboloid $z=x^2+y^2$ and the plane $z=1.$ The curve $C$ is oriented counter-clockwise when viewed from above." :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n\\oint\\limits_{C} \\mathbf{F}\\cdot\\mathrm{d}\\mathbf{r}\n= \\iint\\limits_S \\textrm{curl}\\,\\mathbf{F} \\cdot \\textrm{d}\\mathbf{S}.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z=x^2+y^2$ and the plane $z=1.$ One such surface would be the plane $S$ with the equation \n\n$$\nz = g(x,y) = 1.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y){:}$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(1)=0 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(1)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\textrm{curl}\\,\\mathbf{F}{:}$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨-xz,\\,-yz,\\,{z}^{2}+x⟩{|}_{z=1} \\\\  & =⟨{{-x}_{⏟}}_{P},\\,{{-y}_{⏟}}_{Q},\\,{{1+x}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(-x)\\cdot 0-(-y)\\cdot 0+1+x)\\,\\text{d}A \\\\  & ={∬}_{D}(1+x)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNow, note that the projection of $C$ onto the $xy$-plane is the circle $x^2+y^2=1$ of radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx = r \\cos\\theta, \\qquad\ny = r \\sin\\theta, \\qquad\n\\textrm{d}A = r \\, \\textrm{d}r \\textrm{d}\\theta,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}(1+x)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }(1+r\\operatorname{cos}⁡\\theta )\\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }r+{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{[r\\theta +{r}^{2}\\operatorname{sin}⁡\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & ={\\int }_{0}^{1}2\\pi r\\,\\text{d}r \\\\  & =\\pi [{r}^{2}]_{0}^{1} \\\\  & =\\pi .\\end{aligned}\n$$"} {:db/id 17592186133512 :knowledge-point/_canonical-example [{:db/id 17592186133739 :knowledge-point/id #uuid "4cb81a65-ae88-591a-bb87-0ecb7124b154" :knowledge-point/title "Calculating the Cube of a Negative Number"}] :question/id #uuid "02fa99aa-811e-5d0a-b278-24ec7697a038" :question/math-academy-id "e-13249" :question/problem "Calculate the value of $\\left(-13\\right)^3.$" :question/worked-solution "To work out $\\left(-13\\right)^3,$ we multiply $-13$ by itself and then multiply the result by $-13$ again:\n\n$$\n\\begin{aligned}(-13)^{3} & =\\overset{169}{\\overset{⏞}{(-13)\\cdot (-13)}}\\cdot (-13) \\\\  & =169\\cdot (-13) \\\\  & =-2\\,197\\end{aligned}\n$$"} {:db/id 17592186133514 :knowledge-point/_canonical-example [{:db/id 17592186133741 :knowledge-point/id #uuid "09de45b3-1a35-55e3-9886-2e0533f237d6" :knowledge-point/title "Calculating the Cube of a Decimal"}] :question/id #uuid "ba7b4d05-42b6-58a5-9607-b30742991005" :question/math-academy-id "e-13253" :question/problem "What is the cube of $(-0.5)?$" :question/worked-solution "To work out $\\left(-0.5\\right)^3,$ we multiply $-0.5$ by itself and then multiply the result by $-0.5$ once more:\n\n$$\n\\begin{aligned}(-0.5)^{3} & =\\overset{0.25}{\\overset{⏞}{(-0.5)\\cdot (-0.5)}}\\cdot (-0.5) \\\\  & =0.25\\cdot (-0.5) \\\\  & =-0.125\\end{aligned}\n$$"} {:db/id 17592186133612 :knowledge-point/_canonical-example [{:db/id 17592186133803 :knowledge-point/id #uuid "d177b305-cdd1-5f91-b9d5-90623e52ad10" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given a QR Factorization"}] :question/id #uuid "5fb2571c-2ab9-5fe5-9454-f9d7b0e89854" :question/math-academy-id "e-5592" :question/problem "Given the QR decomposition $A=QR,$ find the least-squares solution to $A\\mathbf{x}=\\mathbf{b},$ where\n![](images/e0/e0a49a8ee02f2bcc10900dcaaa30969d4ab610dd703135ad4418c78272ebbca0.svg)" :question/worked-solution "The least-squares solution of $A\\mathbf{x}=\\mathbf{b}$ satisfies the corresponding normal equation:\n\n$$\nA^T A\\mathbf{x} = A^T\\mathbf{b}\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, it satisfies $Q^T Q = I,$ and we get\n\n$$\nR^T R \\mathbf{x} = R^T \\! Q^T \\mathbf{b}.\n$$\n\nFinally, since $R^T$ is invertible, pre-multiplying by $(R^T)^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nNow, substituting our matrices, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{7}\\begin{bmatrix}7 & -3 \\\\ 0 & 2\\end{bmatrix}}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{7}\\begin{bmatrix}3 & 6 & 2 \\\\ -6 & 2 & 3\\end{bmatrix}}}\\overset{b}{\\overset{⏞}{\\begin{bmatrix}0 \\\\ 4 \\\\ 2\\end{bmatrix}}} \\\\ \\begin{bmatrix}7 & -3 \\\\ 0 & 2\\end{bmatrix}x & =\\begin{bmatrix}28 \\\\ 14\\end{bmatrix},\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\left\\{\\begin{aligned}7{x}_{1}-3{x}_{2} &=28 \\\\ 2{x}_{2} &=14.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $x_2=7.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}7{x}_{1}-3(7) & =28 \\\\ 7{x}_{1} & =49 \\\\ {x}_{1} & =7.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $A\\mathbf{x}=\\mathbf{b}$ is ![](images/c3/c3f08e2cdc175b34030857c03d0301e5b734975355d09b2016559b4f28b6f5e4.svg)"} {:db/id 17592186133613 :knowledge-point/_canonical-example [{:db/id 17592186133804 :knowledge-point/id #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b" :knowledge-point/title "Finding a Least-Squares Regression Line"}] :question/id #uuid "251ec7c6-a050-5deb-8f13-d81f5de4b5c9" :question/math-academy-id "e-5610" :question/problem "| $x$ | **$-3$** | **$-1$** | **$0$** | **$4$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $10$ | $8$ | $6$ | $3$ |\n\nFind the line of the form $y=\\beta_0 + \\beta_1 x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n![](images/ba/ba4b73a8acd1ede70da8d25a67159c74420ac2fd11d15c830a460071d881ff42.png)\n*where $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -3 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}10 \\\\ 8 \\\\ 6 \\\\ 3\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector.\n\nPre-multiplying this equation by $X^T,$ we obtain the corresponding normal equation\n\n$$\nX^T \\! X {\\hat{\\boldsymbol{\\beta}}} = X^T \\mathbf{y}.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X^T}X$ is invertible and \n\n$$\n{\\hat{\\boldsymbol{\\beta}}} = (X^T \\! X )^{-1} X^T \\mathbf{y}.\n$$\n\nSubstituting the given values of $({X^T} X )^{-1}$ and $X^T \\mathbf{y}$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{104}\\begin{bmatrix}26 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}27 \\\\ -26\\end{bmatrix} \\\\  & =\\begin{bmatrix}6.75 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y = 6.75 - x.$"} {:db/id 17592186133614 :knowledge-point/_canonical-example [{:db/id 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/id #uuid "a763a84a-0727-58a3-b524-04afa5735706" :question/math-academy-id "e-5611" :question/problem "An experiment consists of measuring how much a spring stretches (in inches) when one end of the spring is attached to the ceiling while a mass of $x$ ounces hangs from the other end. This data is shown below.\n\n| Mass $(x)$ | **$1$** | **$2$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- |\n| Stretch $(y)$ | $0.8$ | $1.8$ | $3.2$ | $4.2$ |\n\nFind the line of the form $y=\\beta_0 + \\beta_1 x$ that best fits the data above. According to the model, how much will the spring stretch if we use an $8$-ounce mass, assuming that the trend continues?  \n\n*Hint: You can use the fact that* \n![](images/40/400621e90f0419646dcd9e2b2e1bc31bc3cc280bef2be6c3d330c8b69308429c.png)\n*where $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system  \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 1 \\\\ 1 & 2 \\\\ 1 & 4 \\\\ 1 & 5\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}0.8 \\\\ 1.8 \\\\ 3.2 \\\\ 4.2\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector.\n\nPre-multiplying this equation by $X^T,$ we obtain the corresponding normal equation\n\n$$\nX^T \\! X {\\hat{\\boldsymbol{\\beta}}} = X^T \\mathbf{y}.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X^T}X$ is invertible and \n\n$$\n{\\hat{\\boldsymbol{\\beta}}} = (X^T \\! X )^{-1} X^T \\mathbf{y}.\n$$\n\nSubstituting the given values of $({X^T} X )^{-1}$ and $X^T \\mathbf{y}$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{20}\\begin{bmatrix}23 & -6 \\\\ -6 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}10 \\\\ 38.2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.04 \\\\ 0.82\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y = 0.04+ 0.82x.$\n\nFinally, to predict how much the spring will stretch if an $8$-ounce mass is hung from it,  we substitute $x=8$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =0.04+0.82(8) \\\\  & =6.6\\end{aligned}\n$$\n\nThus, according to the model, if an $8$ ounce mass is hung on the spring, the spring will stretch $6.6$ inches. \n\n**Note**: Since we're extrapolating ($x=8$ is not within the range of the original set of $x$-values), our result *may* be unreliable."} {:db/id 17592186133615 :knowledge-point/_canonical-example [{:db/id 17592186133806 :knowledge-point/id #uuid "7b2c90d8-0f2e-5f84-bf67-7620d6f1d308" :knowledge-point/title "Identifying the Design Matrix When the Regression Curve Contains Zero Coefficients"}] :question/id #uuid "98ec57bb-04f5-559a-9057-854de19eda7f" :question/math-academy-id "e-5612" :question/problem "| $x$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $6$ | $3$ | $2$ | $4$ | $6$ |\n\nThe vector of coefficients of the curve $y = \\beta_0 + \\beta_2 x^2 + \\beta_3 x^3$ that best fits the data above can be found using polynomial regression as\n\n![](images/fe/fe5d2bbb69e110d08d3231d486af483dc05d995e30907a5f9a62cf46743e81d7.png)\n\nwhere $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector. Find $X$ and $\\mathbf{y}$ in this context." :question/worked-solution "| $x$ | **$\\color{blue}1$** | **$\\color{blue}2$** | **$\\color{blue}3$** | **$\\color{blue}4$** | **$\\color{blue}5$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $\\color{red}6$ | $\\color{red}3$ | $\\color{red}2$ | $\\color{red}4$ | $\\color{red}6$ |\n\nThe coefficients of the curve\n\n$$\ny = \\beta_0 + \\beta_2 x^2 + \\beta_3 x^3\n$$\n\nthat best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system\n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & {1}^{2} & {1}^{3} \\\\ 1 & {2}^{2} & {2}^{3} \\\\ 1 & {3}^{2} & {3}^{3} \\\\ 1 & {4}^{2} & {4}^{3} \\\\ 1 & {5}^{2} & {5}^{3}\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}6 \\\\ 3 \\\\ 2 \\\\ 4 \\\\ 6\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta$ is the parameter vector, and $\\mathbf{y}$ is the observation vector."} {:db/id 17592186133617 :knowledge-point/_canonical-example [{:db/id 17592186133808 :knowledge-point/id #uuid "75e33c97-0499-5829-9886-be30b00989ae" :knowledge-point/title "Identifying Elements of a Multiple Linear Regression"}] :question/id #uuid "18e10da5-f3e1-52d2-b2c6-2a69a1bf1947" :question/math-academy-id "e-5614" :question/problem "| $x_1$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| $x_2$ | **$7$** | **$6.5$** | **$6$** | **$5$** | **$3$** |\n| $y$ | $1$ | $2$ | $5$ | $9$ | $15$ |\n\nThe vector of coefficients of the plane $y=\\beta_0 + \\beta_1 x_1 + \\beta_2 x_2$ that best fits the data above can be found using multiple linear regression as \n\n![](images/9d/9da2a49a4bab645fa1b8ea3f98e6aa6135b191e121d0cc78a73b517fbc510fc0.png)\n\nwhere $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector. Find  $X$ and $\\mathbf{y}$ in this context." :question/worked-solution "| $x_1$ | **$\\color{blue}1$** | **$\\color{blue}2$** | **$\\color{blue}3$** | **$\\color{blue}4$** | **$\\color{blue}5$** |\n| --- | --- | --- | --- | --- | --- |\n| $x_2$ | **$\\color{purple}7$** | **$\\color{purple}6.5$** | **$\\color{purple}6$** | **$\\color{purple}5$** | **$\\color{purple}3$** |\n| $y$ | $\\color{red}1$ | $\\color{red}2$ | $\\color{red}5$ | $\\color{red}9$ | $\\color{red}15$ |\n\nThe coefficients of the plane \n\n$$\ny=\\beta_0 + \\beta_1 x_1 + \\beta_2 x_2\n$$\n\nthat best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 1 & 7 \\\\ 1 & 2 & 6.5 \\\\ 1 & 3 & 6 \\\\ 1 & 4 & 5 \\\\ 1 & 5 & 3\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 2 \\\\ 5 \\\\ 9 \\\\ 15\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector.\n\nThus, we have\n![](images/b5/b5302251a49a45514a55d2987289548e2a55917884ff4c240be081ba512a970e.png)"} {:db/id 17592186133618 :knowledge-point/_canonical-example [{:db/id 17592186133809 :knowledge-point/id #uuid "5eaee4e9-7be5-5c35-bc88-89697a15d75a" :knowledge-point/title "Identifying Elements of a Multiple Linear Regression That Passes Through the Origin"}] :question/id #uuid "ab93579a-f7a1-5cfe-85ce-5a4d5722e7b7" :question/math-academy-id "e-5615" :question/problem "| $x_1$ | **$1$** | **$2$** | **$3$** | **$4$** |\n| --- | --- | --- | --- | --- |\n| $x_2$ | **$-8$** | **$-2$** | **$6$** | **$15$** |\n| $x_3$ | **$8$** | **$6$** | **$4$** | **$2$** |\n| $y$ | $10$ | $20$ | $40$ | $60$ |\n\nThe vector of coefficients of the hyperplane $y = \\beta_1 x_1 + \\beta_2 x_2 +\\beta_3 x_3$ that best fits the data above can be found using multiple linear regression as \n\n![](images/3f/3f86f03e3a32ede2ac18d6c39f62de5686a74d4050b8c1d7aa2a6fc3e2cdddbb.png)\n\nwhere $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector. Find  $X$ and $\\mathbf{y}$ in this context." :question/worked-solution "| $x_1$ | **$\\color{blue}1$** | **$\\color{blue}2$** | **$\\color{blue}3$** | **$\\color{blue}4$** |\n| --- | --- | --- | --- | --- |\n| $x_2$ | **$\\color{purple}-8$** | **$\\color{purple}-2$** | **$\\color{purple}6$** | **$\\color{purple}15$** |\n| $x_3$ | **$\\color{green}8$** | **$\\color{green}6$** | **$\\color{green}4$** | **$\\color{green}2$** |\n| $y$ | $\\color{red}10$ | $\\color{red}20$ | $\\color{red}40$ | $\\color{red}60$ |\n\n \n\nThe coefficients of the hyperplane  \n\n$$\ny= \\beta_1 x_1 + \\beta_2 x_2 +\\beta_3 x_3\n$$\n\nthat best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -8 & 8 \\\\ 2 & -2 & 6 \\\\ 3 & 6 & 4 \\\\ 4 & 15 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}10 \\\\ 20 \\\\ 40 \\\\ 60\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector.\n\nThus, we have \n\n![](images/c8/c83d300d9e6e1c1bd61fc49c4e849ab373d902beb3cd12ef501461a86bd1a08c.png)"} {:db/id 17592186133635 :knowledge-point/_canonical-example [{:db/id 17592186133823 :knowledge-point/id #uuid "aa5bf185-de29-5185-ba57-c64250332dfa" :knowledge-point/title "Identifying the Elements of a Polynomial Regression Model"}] :question/id #uuid "75c0086b-db74-5f01-8d66-f023dd7b575d" :question/math-academy-id "e-6094" :question/problem "| $x$ | **$2$** | **$3$** | **$4$** | **$5$** | **$6$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $40$ | $70$ | $120$ | $100$ | $80$ |\n\nThe vector of coefficients of the curve $y = \\beta_0 + \\beta_1 x + \\beta_2 x^2 + \\beta_3 x^3$ that best fits the data above can be found using polynomial regression as\n\n![](images/93/93a2e368924ac5d892ce203e2b2c2ee0007ebb30bb71476272385d5b26695113.png)\n\nwhere $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector. Find $X$ and $\\mathbf{y}$ in this context." :question/worked-solution "| $x$ | **$\\color{blue}2$** | **$\\color{blue}3$** | **$\\color{blue}4$** | **$\\color{blue}5$** | **$\\color{blue}6$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $\\color{red}40$ | $\\color{red}70$ | $\\color{red}120$ | $\\color{red}100$ | $\\color{red}80$ |\n\nThe coefficients of the curve\n\n$$\ny = \\beta_0 + \\beta_1 x + \\beta_2 x^2 + \\beta_3 x^3\n$$\n\nthat best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system\n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 2 & {2}^{2} & {2}^{3} \\\\ 1 & 3 & {3}^{2} & {3}^{3} \\\\ 1 & 4 & {4}^{2} & {4}^{3} \\\\ 1 & 5 & {5}^{2} & {5}^{3} \\\\ 1 & 6 & {6}^{2} & {6}^{3}\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}40 \\\\ 70 \\\\ 120 \\\\ 100 \\\\ 80\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta$ is the parameter vector, and $\\mathbf{y}$ is the observation vector."} {:db/id 17592186133663 :knowledge-point/_canonical-example [{:db/id 17592186133848 :knowledge-point/id #uuid "5924037a-ddc3-5f50-b4b0-1bd813cef255" :knowledge-point/title "Finding the Distance Between a Vector to a Subspace of Solutions of a Linear System"}] :question/id #uuid "af2b3f92-fed5-5a50-b662-eaadd9b7adbc" :question/math-academy-id "e-7429" :question/problem "Consider the system $A\\mathbf{x}=\\mathbf{b}$, where the matrix $A$ and the vector $\\mathbf{b}$ are given below. Given that the columns of $A$ are linearly independent, find the minimum value of $\\Vert A\\mathbf{x} - \\mathbf{b} \\Vert.$\n![](images/3e/3e5e0da0f8e23d412833c26dc9967e443fdccb98d347eaa0481f94294093341b.svg)" :question/worked-solution "First of all, we write the given system in the form $A \\mathbf{x} = \\mathbf{b}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 1 \\\\ 1 & 0 \\\\ -1 & 0 \\\\ -1 & -1\\end{bmatrix}}}\\overset{x}{\\overset{⏞}{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}}} & =\\overset{b}{\\overset{⏞}{\\begin{bmatrix}22 \\\\ 0 \\\\ 0 \\\\ 2\\end{bmatrix}}} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution ${\\hat{\\mathbf{x}}}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by $A^T\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix $A^T \\! A$ is invertible. Therefore, multiplying by $(A^T \\! A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}1 & 1 & -1 & -1 \\\\ 1 & 0 & 0 & -1\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 1 & 0 \\\\ -1 & 0 \\\\ -1 & -1\\end{bmatrix})}^{-1}\\,\\,\\,\\,\\begin{bmatrix}1 & 1 & -1 & -1 \\\\ 1 & 0 & 0 & -1\\end{bmatrix}\\begin{bmatrix}22 \\\\ 0 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\  & ={\\begin{bmatrix}4 & 2 \\\\ 2 & 2\\end{bmatrix}}^{-1}\\begin{bmatrix}20 \\\\ 20\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}2 & -2 \\\\ -2 & 4\\end{bmatrix}\\begin{bmatrix}20 \\\\ 20\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & -1 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}20 \\\\ 20\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 10\\end{bmatrix}.\\end{aligned}\n$$\n\nThe minimum value of $\\Vert A\\mathbf{x} - \\mathbf{b} \\Vert$ is attained when $\\mathbf{x}={\\hat{\\mathbf{x}}},$ which is the least-squares solution of the system $A\\mathbf{x}=\\mathbf{b}.$\n\nIn this case, $A{\\hat{\\mathbf{x}}}$ represents the orthogonal projection of $\\mathbf{b}$ onto the column space of $A,$ and $\\Vert A{\\hat{\\mathbf{x}}} - \\mathbf{b} \\Vert$ is the distance between the vector $\\mathbf{b}$ and the column space.\n\nTherefore,\n\n$$\n\\begin{aligned}A\\hat{x}-b & =\\begin{bmatrix}1 & 1 \\\\ 1 & 0 \\\\ -1 & 0 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 10\\end{bmatrix}-\\begin{bmatrix}22 \\\\ 0 \\\\ 0 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}-12 \\\\ 0 \\\\ 0 \\\\ -12\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\Vert A{\\hat{\\mathbf{x}}}-\\mathbf{b}\\Vert =\\sqrt{(-12)^2+0^2+(-12)^2+0^2}=12\\sqrt{2}.\n$$"} {:db/id 17592186133718 :knowledge-point/_canonical-example [{:db/id 17592186133905 :knowledge-point/id #uuid "6acfe386-f7e4-54b1-9701-6ff5905b4536" :knowledge-point/title "Identifying Elements of a Regression Line in Terms of Matrices and Vectors"}] :question/id #uuid "29b2a4d7-7e88-5f7a-9a84-ff5315c38f92" :question/math-academy-id "e-9914" :question/problem "| $x$ | **$-6$** | **$-3$** | **$-1$** | **$0$** | **$4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-7$ | $-4$ | $2$ | $8$ | $10$ |\n\nThe vector of coefficients  of the line $y=\\beta_0 + \\beta_1 x$ that best fits the data above can be found using linear regression as \n\n![](images/80/8002d38943a0f0b72e5c9cef2e3a455915479ca86c53ebe403b60a6b49f268a4.png)\n\nwhere $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector. Which are the design matrix $X$ and the observation vector $\\mathbf{y}$ in this context?" :question/worked-solution "| $x$ | **$\\color{blue}-6$** | **$\\color{blue}-3$** | **$\\color{blue}-1$** | **$\\color{blue}0$** | **$\\color{blue}4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $\\color{red}-7$ | $\\color{red}-4$ | $\\color{red}2$ | $\\color{red}8$ | $\\color{red}10$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -6 \\\\ 1 & -3 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-7 \\\\ -4 \\\\ 2 \\\\ 8 \\\\ 10\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector."} {:db/id 17592186134072 :knowledge-point/_questions [{:db/id 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07509797-308b-5e51-8c0b-7ce937096e54" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}(A)" :db/id 17592186380519} {:answer/id #uuid "5d46aa8d-aee6-5949-9319-7a6d7d0087f3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(A)" :db/id 17592186380520} {:answer/id #uuid "3c7884a2-0ad2-55ac-be08-5ec6f1269e25" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({A}^{T})" :db/id 17592186380521} {:answer/id #uuid "072d89d9-d407-530a-8155-7168cdaab68b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id 17592186380522} {:answer/id #uuid "726d2de0-3519-5e23-aed7-7964192a471f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186380523}] :answer-field/correct {:answer/id #uuid "072d89d9-d407-530a-8155-7168cdaab68b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id 17592186380522} :answer-field/id #uuid "3f23184f-d234-52a0-baf0-4d7dec1d4f26" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380518}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6e9167d-9cc2-5340-981b-f78b8d297972" :question/math-academy-id "q-108917" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Col}(A)$ under the action of ${A}^{T}?$" :question/worked-solution "First,  notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nNow, pre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+⋯+{x}_{m}\\begin{bmatrix}| \\\\ {a}_{m}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the column space of ${A}^{T},$ or equivalently, the row space of $A.$\n\nFurthermore, since $\\text{Null}({A}^{T})$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}(({A}^{T})^{T})=\\text{Col}(A)$ must be $\\text{Col}({A}^{T}).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/8c/8ca8508d05e28e4c91b5a7f3c65826ce68b5dacd382bfb1a76f09c09d1d004bf.png)"} {:db/id 17592186134073 :knowledge-point/_questions [{:db/id 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afbd7451-74c6-566c-a867-fcf356a99a4b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "R^{m}" :db/id 17592186130595} {:answer/id #uuid "b6da7862-8b4f-5be2-8b9b-be84e5946e90" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186130596} {:answer/id #uuid "c38260cd-73ff-5df7-ab80-c6758fb6a49d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "R^{n}" :db/id 17592186130597} {:answer/id #uuid "c7e729bc-2ee2-5d03-86f6-f61d84ed58ff" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "Null(A)" :db/id 17592186130598} {:answer/id #uuid "3affadd2-5331-51ec-a5a8-4662d62cc494" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "Col(A)" :db/id 17592186130599}] :answer-field/id #uuid "fc290a71-acb0-5b8d-990a-a0372d1ad9dd" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130594} {:answer-field/choices [{:answer/id #uuid "997b117c-6043-5bde-84a7-173fff6b3502" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}(A)" :db/id 17592186397892} {:answer/id #uuid "852b30a5-50ad-5fdf-b509-9e641d3f9f41" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{m}" :db/id 17592186397893} {:answer/id #uuid "f97f4600-e963-5af1-a6e4-9a40da7069c9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(A)" :db/id 17592186397894} {:answer/id #uuid "053995d9-9d5a-572e-a184-b3f175a52101" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186397895} {:answer/id #uuid "19b02b38-e01b-595f-bf4f-ccb340e83dfa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{n}" :db/id 17592186397896}] :answer-field/correct {:answer/id #uuid "f97f4600-e963-5af1-a6e4-9a40da7069c9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(A)" :db/id 17592186397894} :answer-field/id #uuid "0208d090-3523-510e-b360-0ef37adf0826" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186397891}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba1ee846-cfe9-595c-9803-25afded75ec1" :question/math-academy-id "q-108921" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of ${R}^{n}$ under the action of $A?$" :question/worked-solution "Pre-multiplying a vector $x\\in {R}^{n}$ by $A$ gives a linear combination of the columns of $A:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {a}_{1} & {a}_{2} & ⋯ & {a}_{n} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2} \\\\ |\\end{bmatrix}+⋯+{x}_{n}\\begin{bmatrix}| \\\\ {a}_{n} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $A$ must be $\\text{Col}(A),$ the column space of $A.$"} {:db/id 17592186134106 :knowledge-point/_questions [{:db/id 17592186133905 :knowledge-point/id #uuid "6acfe386-f7e4-54b1-9701-6ff5905b4536" :knowledge-point/title "Identifying Elements of a Regression Line in Terms of Matrices and Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42f36ce8-abaa-5341-9ce7-36023c59f115" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -1 \\\\ 0 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id 17592186400758} {:answer/id #uuid "da4f77a0-7473-5225-8669-46210814431f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 & 0 & 1 & 2\\end{bmatrix}" :db/id 17592186400759} {:answer/id #uuid "417fc55a-2009-510a-bab5-565815a9b746" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & -5 & -1 & 1 & 1\\end{bmatrix}" :db/id 17592186400760} {:answer/id #uuid "0d357aa1-84b3-5747-9e58-2031587733f7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id 17592186400761} {:answer/id #uuid "16b4b488-c57d-56fe-8fb4-7e5235fe25dc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 & 1 & 1 & 1\\end{bmatrix}" :db/id 17592186400762}] :answer-field/correct {:answer/id #uuid "0d357aa1-84b3-5747-9e58-2031587733f7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id 17592186400761} :answer-field/id #uuid "f811ff69-c763-5e0d-915e-d75553a1c0c8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186400757}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07c1a1e5-eac4-585d-8460-669cc1e39819" :question/math-academy-id "q-139517" :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-5$ | $-1$ | $1$ | $1$ |\n\nThe vector of coefficients  of the line $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above can be found using linear regression as \n\n$$\n\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the observation vector $y$ in this context?" :question/worked-solution "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-5$ | $-1$ | $1$ | $1$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."} {:db/id 17592186134108 :knowledge-point/_questions [{:db/id 17592186133804 :knowledge-point/id #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b" :knowledge-point/title "Finding a Least-Squares Regression Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a2edf9f-25b1-5fd5-948c-237e6c5948da" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.7-6x" :db/id 17592186270211} {:answer/id #uuid "897239e6-c3c2-5611-8c33-8bafe39cfda1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=6-1.7x" :db/id 17592186270454} {:answer/id #uuid "b26d58d6-c973-5c1f-91c9-981d64dedc48" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=-6+1.7x" :db/id 17592186270863} {:answer/id #uuid "bd862383-7cfa-5c21-a439-ce2690a7f88e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.7+6x" :db/id 17592186270940} {:answer/id #uuid "e8d0e162-e5b3-5659-ba89-d415deaf13c8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.7-6x" :db/id 17592186271303}] :answer-field/correct {:answer/id #uuid "897239e6-c3c2-5611-8c33-8bafe39cfda1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "y=6-1.7x" :db/id 17592186270454} :answer-field/id #uuid "860792a7-ff74-5496-9949-a0199174c0c4" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186271744}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72cc6e31-5631-5692-b09e-242241827364" :question/math-academy-id "q-139618" :question/problem "| $x$ | **$0$** | **$1$** | **$2$** | **$3$** | **$4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $6$ | $4$ | $3$ | $1$ | $-1$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}6 & -2 \\\\ -2 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}13 \\\\ 9\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/requires-calculator true :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}6 \\\\ 4 \\\\ 3 \\\\ 1 \\\\ -1\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}6 & -2 \\\\ -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}13 \\\\ 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ -1.7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=6-1.7x.$"} {:db/id 17592186134111 :knowledge-point/_questions [{:db/id 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c12a9093-8b33-506e-8833-5f1ad6a9261f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$9.5$ feet" :db/id 17592186400834} {:answer/id #uuid "032b222d-40e4-532e-af62-dfdc2dcc37e3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ feet" :db/id 17592186400835} {:answer/id #uuid "9ce327d5-8771-5e11-b6ab-ff3533542dc1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$8.5$ feet" :db/id 17592186400836} {:answer/id #uuid "e7d9746c-39bb-5726-8a32-8963780d412e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$7.5$ feet" :db/id 17592186400837} {:answer/id #uuid "a99677dd-5b51-522d-a3d5-8b761133f62a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ feet" :db/id 17592186400838}] :answer-field/correct {:answer/id #uuid "032b222d-40e4-532e-af62-dfdc2dcc37e3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ feet" :db/id 17592186400835} :answer-field/id #uuid "fc15713a-b900-5d20-8415-c6b1dd1f9e84" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186400833}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f426df0-1f38-5a2e-b701-5e427a0357ac" :question/math-academy-id "q-139750" :question/problem "A biologist has recorded data on a pine tree's age (in years) and height (in feet). This data is shown below. \n\n| Age $(x)$ | **$1$** | **$2$** | **$3$** | **$4$** |\n| --- | --- | --- | --- | --- |\n| Height $(y)$ | $1.2$ | $2.5$ | $3.6$ | $4.5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what will be the tree's height after $8$ years, assuming the trend continues?\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}15 & -5 \\\\ -5 & 2\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}11.8 \\\\ 35\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/requires-calculator true :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1.2 \\\\ 2.5 \\\\ 3.6 \\\\ 4.5\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}15 & -5 \\\\ -5 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}11.8 \\\\ 35\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.2 \\\\ 1.1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=0.2+1.1x.$\n\nFinally, to predict the  height after $8$ years, we substitute $x=8$ into the equation of the line: \n\n$$\n\\begin{aligned}y & =0.2+1.1(8) \\\\  & =9\\end{aligned}\n$$\n\n \n\nSo, according to the model, the height of a pine tree that is $8$ years old will be $9$ feet. \n\n**Note**: Since we're extrapolating ($x=8$ is not within the range of the original set of $x$-values), our result *may* be unreliable."} {:db/id 17592186134114 :knowledge-point/_questions [{:db/id 17592186133809 :knowledge-point/id #uuid "5eaee4e9-7be5-5c35-bc88-89697a15d75a" :knowledge-point/title "Identifying Elements of a Multiple Linear Regression That Passes Through the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066258b8-15e6-594c-9957-bef407a3a66f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -10 \\\\ 2 & 4 & -8 \\\\ 4 & 6 & -5 \\\\ 8 & 8 & -1 \\\\ 16 & 10 & 2\\end{aligned}]" :db/id 17592186557883} {:answer/id #uuid "2845ed2a-37d5-5090-83dd-454cf30d1240" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 10 \\\\ 16 \\\\ 22 \\\\ 30\\end{aligned}]" :db/id 17592186557947} {:answer/id #uuid "882efe69-415d-52e7-90f5-e0920947df5b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 2 & 4 \\\\ 4 & 6 \\\\ 8 & 8 \\\\ 16 & 10\\end{aligned}]" :db/id 17592186558134} {:answer/id #uuid "dca2cf6f-1869-5c13-97ce-b8ae8e71eb8a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 5 \\\\ 2 & 4 & 10 \\\\ 4 & 6 & 16 \\\\ 8 & 8 & 22 \\\\ 16 & 10 & 30\\end{aligned}]" :db/id 17592186558303} {:answer/id #uuid "e141f47e-2de6-5ce4-9612-e71f3d7fadc8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 2 & -10 \\\\ 1 & 2 & 4 & -8 \\\\ 1 & 4 & 6 & -5 \\\\ 1 & 8 & 8 & -1 \\\\ 1 & 16 & 10 & 2\\end{aligned}]" :db/id 17592186558313}] :answer-field/correct {:answer/id #uuid "066258b8-15e6-594c-9957-bef407a3a66f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -10 \\\\ 2 & 4 & -8 \\\\ 4 & 6 & -5 \\\\ 8 & 8 & -1 \\\\ 16 & 10 & 2\\end{aligned}]" :db/id 17592186557883} :answer-field/id #uuid "cba59baf-234c-541c-bccf-8a885cebd27b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130840}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb487cc5-1cc1-5a9c-9d5a-d24c4773692c" :question/math-academy-id "q-139935" :question/problem "| ${x}_{1}$ | **$1$** | **$2$** | **$4$** | **$8$** | **$16$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$2$** | **$4$** | **$6$** | **$8$** | **$10$** |\n| ${x}_{3}$ | **$-10$** | **$-8$** | **$-5$** | **$-1$** | **$2$** |\n| $y$ | $5$ | $10$ | $16$ | $22$ | $30$ |\n\nThe vector of coefficients of the hyperplane $y={\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}+{\\beta }_{3}{x}_{3}$ that best fits the data above can be found using multi linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the design matrix $X$ in this context?" :question/worked-solution "| ${x}_{1}$ | **$1$** | **$2$** | **$4$** | **$8$** | **$16$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$2$** | **$4$** | **$6$** | **$8$** | **$10$** |\n| ${x}_{3}$ | **$-10$** | **$-8$** | **$-5$** | **$-1$** | **$2$** |\n| $y$ | $5$ | $10$ | $16$ | $22$ | $30$ |\n\n \n\nThe coefficients of the hyperplane \n\n$$\ny={\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}+{\\beta }_{3}{x}_{3}\n$$\n\nthat best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 2 & -10 \\\\ 2 & 4 & -8 \\\\ 4 & 6 & -5 \\\\ 8 & 8 & -1 \\\\ 16 & 10 & 2\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}5 \\\\ 10 \\\\ 16 \\\\ 22 \\\\ 30\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."} {:db/id 17592186134125 :knowledge-point/_questions [{:db/id 17592186133819 :knowledge-point/id #uuid "7dcc1bf5-5eea-5615-8b16-b8ced5de7984" :knowledge-point/title "Describing Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c8096b0-1715-5108-8f75-4e56db160c4e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186448460} {:answer/id #uuid "dcf68ced-40ed-5fe2-820d-75e442987fc1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186448461}] :answer-field/correct {:answer/id #uuid "dcf68ced-40ed-5fe2-820d-75e442987fc1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186448461} :answer-field/id #uuid "5995326b-2b70-5c8b-9ace-a096b2d0b4c9" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186449270} {:answer-field/choices [{:answer/id #uuid "d0774033-2bb7-5fbf-9296-dacd9a281a38" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186448462} {:answer/id #uuid "ac3bf2ea-6b3a-54e4-98c1-2f823c2faf71" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186448463}] :answer-field/correct {:answer/id #uuid "d0774033-2bb7-5fbf-9296-dacd9a281a38" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186448462} :answer-field/id #uuid "5448f508-6dc1-5d61-b740-467fd7ae08fc" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186449271} {:answer-field/choices [{:answer/id #uuid "a8ca1a17-b6c4-54e3-b990-dbb40731f226" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186448464} {:answer/id #uuid "a9f88189-0f3a-50f2-90b7-29c7d5a94194" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186448465}] :answer-field/correct {:answer/id #uuid "a8ca1a17-b6c4-54e3-b990-dbb40731f226" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186448464} :answer-field/id #uuid "5b5d374c-058d-5ca3-935f-654544c93c85" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186449272}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34378ce6-ab69-512f-b1fe-41e79c6115fe" :question/math-academy-id "q-160965" :question/problem "The region $R$ is bounded between the elliptic paraboloid $x={y}^{2}+{z}^{2}$ and the plane $x=2y.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,a\\le y\\le b,\\,{g}_{1}(y)\\le z\\le {g}_{2}(y),\\,{f}_{1}(y,z)\\le x\\le {f}_{2}(y,z)}\n$$\n\n \nas a type II region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}_{1}(y,z)={y}^{2}+{z}^{2}$ and ${f}_{2}(y,z)=2y$\n- **II.** ${g}_{1}(y)=0$ and ${g}_{2}(y)=1-{y}^{2}$\n- **III.** $a=-1$ and $b=1$" :question/worked-solution "A typical three-dimensional region of type II can be visualized schematically, as shown below.\n\n![](images/e4/e4c9cbbad2f13e9cc125ddbb89125ed2d734eee3f80737125961f4af1846a972.png)\n\n \n\nLet's find a type II representation of our region.\n\n**Step 1.** We start by finding the surfaces ${f}_{1}(y,z)$ and ${f}_{2}(y,z).$ Since all $x$ in the region are bounded *below* by $x={y}^{2}+{z}^{2}$ and *above* by $x=2y,$ we have\n\n$$\n{{{y}^{2}+{z}^{2}}_{⏟}}_{{f}_{1}(y,z)}\\le x\\le {{2y}_{⏟}}_{{f}_{2}(y,z)}.\n$$\n\nSo, statement I is true.\n\n**Step 2.** We find the projection of the intersection between the elliptic paraboloid $x={y}^{2}+{z}^{2}$ and the plane $x=2y$ onto the $yz$-plane.\n\nNotice that the equation of the plane is already solved for $x.$ Substituting this expression for $x$ into the equation of the paraboloid, we obtain: \n\n$$\n\\begin{aligned}2y & ={y}^{2}+{z}^{2} \\\\ {y}^{2}-2y+{z}^{2} & =0 \\\\ ({y}^{2}-2y+1)+{z}^{2} & =1 \\\\ (y-1)^{2}+{z}^{2} & =1\\end{aligned}\n$$\n\n \n\nSo, the projection of the intersection is the circle $(y-1)^{2}+{z}^{2}=1$ centered at $(1,0)$ in the $yz$-plane. \n\n![](images/01/01cb7f25e98c8607258f673a5c5be6a1e55869b379c4484c05a04cebbe5dc5f6.png)\n\nThe region is bounded *below* by $z=-\\sqrt{1-(y-1)^{2}}$ and bounded *above* by $z=\\sqrt{1-(y-1)^{2}}.$ Therefore,\n\n$$\n{{-\\sqrt{1-(y-1)^{2}}}_{⏟}}_{{g}_{1}(y)}\\le z\\le {{\\sqrt{1-(y-1)^{2}}}_{⏟}}_{{g}_{2}(y)}.\n$$\n\nSo, statement II is false.\n\n**Step 3.** We find the bounds for $y.$ From the diagram, $y$ is bounded *below* by $y=0$ and bounded *above* by $y=2.$ Therefore,\n\n$$\n{{0}_{⏟}}_{a}\\le y\\le {{2}_{⏟}}_{b}.\n$$\n\nSo, statement III is false.\n\nFinally, the correct answer is \"I only.\""} {:db/id 17592186134130 :knowledge-point/_questions [{:db/id 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c97d45ae-ae12-5c14-924c-d56fbb9046f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186130939} {:answer/id #uuid "685918e6-ec50-5f06-acad-83ff00e3c712" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id 17592186521000} {:answer/id #uuid "6cfe55e2-32b3-566f-a4fb-ac15bcefa97e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id 17592186521012} {:answer/id #uuid "7903ed28-5d25-5da8-85e5-0a207c57c64f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id 17592186521035} {:answer/id #uuid "c351ba7c-4c6f-5399-9980-cd006f2d48fe" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id 17592186521199}] :answer-field/correct {:answer/id #uuid "c97d45ae-ae12-5c14-924c-d56fbb9046f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186130939} :answer-field/id #uuid "0b2becff-6366-549e-8db3-182572eab4ad" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130936}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee52e831-6d2f-5771-b93b-7f7fa07dc36b" :question/math-academy-id "q-161926" :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨0,\\,0,\\,-2y⟩,$ and $C$ is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=4-x-2y.$ The curve $C$ is oriented counter-clockwise when viewed from above." :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=4-x-2y.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=4-x-2y.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4-x-2y)=-1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4-x-2y)=-2\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨0,\\,0,\\,-2y⟩{|}_{z=4-x-2y} \\\\  & =⟨{{0}_{⏟}}_{P},\\,{{0}_{⏟}}_{Q},\\,{{-2y}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot (-1)-0\\cdot (-2)+(-2y))\\,\\text{d}A \\\\  & ={∬}_{D}-2y\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-palne is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}-2y\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}-2r\\operatorname{sin}⁡\\theta \\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta \\cdot {\\int }_{0}^{1}2r\\cdot r\\,\\text{d}r \\\\  & =[\\operatorname{cos}⁡\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot [{r}^{2}]_{r=0}^{r=1} \\\\  & =(1-1)\\cdot (1-0) \\\\  & =0.\\end{aligned}\n$$"} {:db/id 17592186134131 :knowledge-point/_questions [{:db/id 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89def526-2f68-5214-92a5-30cfa9986621" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{1}4 x 3 + 4 x y 2 - 40 xdydx" :db/id 17592186130943} {:answer/id #uuid "b93aa029-cebb-504c-9cf0-03532112bd4e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{1 - x}4 x 3 + 4 x y 2 - 40 xdydx" :db/id 17592186130944} {:answer/id #uuid "eeea64cd-f2a9-50a4-92af-3714133868f5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{x}20 - 4 x 2 + 4 y 2dydx" :db/id 17592186130945} {:answer/id #uuid "2b0fd797-ddad-5d2d-8cb6-6b915ac256d6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{1}20 - 4 x 2 + 4 y 2dydx" :db/id 17592186130946} {:answer/id #uuid "72429bbc-4c1f-5953-af68-a72527d62038" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{1 - x}20 - 4 x 2 + 4 y 2dydx" :db/id 17592186130947}] :answer-field/id #uuid "1b4f178d-ab86-5fbd-b750-5b059091e2bb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130942} {:answer-field/choices [{:answer/id #uuid "a96e8d31-77ad-5052-9b6a-9faf559523d5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{x}\\,20-4{x}^{2}+4{y}^{2}\\,\\text{d}y\\,\\text{d}x" :db/id 17592186389231} {:answer/id #uuid "eb0e733a-0b54-50ae-a405-756c459c5edb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1-x}\\,4{x}^{3}+4x{y}^{2}-40x\\,\\text{d}y\\,\\text{d}x" :db/id 17592186389232} {:answer/id #uuid "615d7f91-8451-58fb-9b50-6912a6fa4329" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1-x}\\,20-4{x}^{2}+4{y}^{2}\\,\\text{d}y\\,\\text{d}x" :db/id 17592186389233} {:answer/id #uuid "2375212a-a45b-5bd5-94fc-2601931c58e2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}\\,4{x}^{3}+4x{y}^{2}-40x\\,\\text{d}y\\,\\text{d}x" :db/id 17592186389234} {:answer/id #uuid "41c2840c-096c-53fe-8ab2-a18813e80463" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}\\,20-4{x}^{2}+4{y}^{2}\\,\\text{d}y\\,\\text{d}x" :db/id 17592186389235}] :answer-field/correct {:answer/id #uuid "eb0e733a-0b54-50ae-a405-756c459c5edb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1-x}\\,4{x}^{3}+4x{y}^{2}-40x\\,\\text{d}y\\,\\text{d}x" :db/id 17592186389232} :answer-field/id #uuid "8986131b-decf-5b3d-8f27-aafe80a954f8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186389230}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d82e0bcb-c8b4-5aa2-9f3c-8a84246a499f" :question/math-academy-id "q-161927" :question/problem "Let $C$ be the intersection of the paraboloid $z=10-{x}^{2}-{y}^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x+y=1,$ $x=0,$ and $y=0.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨-2z,\\,0,\\,0⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z=10-{x}^{2}-{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)=10-{x}^{2}-{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(10-{x}^{2}-{y}^{2})=-2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(10-{x}^{2}-{y}^{2})=-2y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨-2z,\\,0,\\,0⟩{|}_{z=10-{x}^{2}-{y}^{2}} \\\\  & =⟨-2(10-{x}^{2}-{y}^{2}),\\,0,\\,0⟩ \\\\  & =⟨{{2{x}^{2}+2{y}^{2}-20}_{⏟}}_{P},\\,{{0}_{⏟}}_{Q},\\,{{0}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(2{x}^{2}+2{y}^{2}-20)\\cdot (-2x)-0\\cdot (-2y)+0)\\,\\text{d}A \\\\  & ={∬}_{D}(4{x}^{3}+4x{y}^{2}-40x)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/c1/c181e209cca01a1d6e372caa7f7810a5fa4aa9f177595bd92f937a7cba8b8a75.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(4{x}^{3}+4x{y}^{2}-40x)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{1-x}\\,4{x}^{3}+4x{y}^{2}-40x\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id 17592186134213 :knowledge-point/_questions [{:db/id 17592186133879 :knowledge-point/id #uuid "e8a1d966-b4a8-5af8-8b10-063cacea6526" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals When the Potential Function Is Not Given"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69c13dff-cd6b-59c8-8afc-6e8f8eabf8f5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(2+\\operatorname{ln}⁡2)" :db/id 17592186324856} {:answer/id #uuid "7e0e1662-5531-5797-9a2d-180d1aefa39b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(1+{ln}^{2}⁡2)" :db/id 17592186325032} {:answer/id #uuid "b060de89-9a07-5c08-8a5a-902923743941" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(4)" :db/id 17592186325474} {:answer/id #uuid "df7d018d-9bcc-56b5-9a57-3f93a49339b0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(2)" :db/id 17592186325922} {:answer/id #uuid "fba1ed0a-e6ae-5b81-9e9c-40ba51cc6012" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(2+{ln}^{2}⁡2)" :db/id 17592186326186}] :answer-field/correct {:answer/id #uuid "fba1ed0a-e6ae-5b81-9e9c-40ba51cc6012" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(2+{ln}^{2}⁡2)" :db/id 17592186326186} :answer-field/id #uuid "aa5eacfc-70b8-5d6e-b1f9-f5af4734a6b5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326529}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "73c892c9-a1e1-5820-84c2-50c996c14b02" :question/math-academy-id "q-39349" :question/problem "Consider the vector field $F,$ defined as\n\n$$\nF(x,y)=\\frac{x}{1+{x}^{2}+{y}^{2}}\\,i+\\frac{y}{1+{x}^{2}+{y}^{2}}\\,j.\n$$\n\nEvaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $C$ is the curve $y={x}^{2}\\operatorname{ln}⁡(x+1)$ for $x\\in [0,1].$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nFirst, we define $P(x,y)$ and $Q(x,y)$ as follows:\n\n$$\nF(x,y)={{\\frac{x}{1+{x}^{2}+{y}^{2}}}_{⏟}}_{P(x,y)}\\,i+{{\\frac{y}{1+{x}^{2}+{y}^{2}}}_{⏟}}_{Q(x,y)}\\,j.\n$$\n\nTo apply the fundamental theorem for line integrals, we must first find a potential function $f$ (if it exists) such that $F=∇f.$ Notice that the domain of $F$ is ${R}^{2},$ and\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=-\\frac{2xy}{(1+{x}^{2}+{y}^{2})^{2}}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ there exists a potential function $f$ such that $F=∇f,$ and we must have\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{x}{1+{x}^{2}+{y}^{2}}, \\\\ {f}_{y}(x,y) & =\\frac{y}{1+{x}^{2}+{y}^{2}}.\\end{aligned}\n$$\n\nReconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf(x,y)=\\frac{1}{2}\\operatorname{ln}⁡(1+{x}^{2}+{y}^{2}).\n$$\n\nNote that we set $C=0$ for the arbitrary constant since we can use any function $f$ that satisfies $∇f=F.$\n\nWe're now ready to apply the fundamental theorem for line integrals. A suitable parametrization of the curve $C$ is given by\n\n$$\nr(t)=⟨t,{t}^{2}\\operatorname{ln}⁡(t+1)⟩,\\,t\\in [0,1].\n$$\n\nThe position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩, \\\\ r(1) & =⟨1,\\operatorname{ln}⁡2⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0)$ and $(1,\\operatorname{ln}⁡2).$\n\nFinally, applying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{C}∇f\\cdot \\text{d}r \\\\  & =f(1,\\operatorname{ln}⁡2)-f(0,0) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(1+{1}^{2}+{ln}^{2}⁡2)-\\frac{1}{2}\\operatorname{ln}⁡(1+{0}^{2}+{0}^{2}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(2+{ln}^{2}⁡2)-0 \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(2+{ln}^{2}⁡2).\\end{aligned}\n$$"} {:db/id 17592186134324 :knowledge-point/_questions [{:db/id 17592186133798 :knowledge-point/id #uuid "19ae0632-68ac-5da9-8adf-cf71d5ecbc7c" :knowledge-point/title "Finding the QR Factorization of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbcea61a-f7c5-5e90-95bf-e30e97fb1c5c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id 17592186392397} {:answer/id #uuid "87a540ed-333f-527d-82f8-aa109a53d564" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id 17592186392398} {:answer/id #uuid "10193a27-2949-56aa-bfb7-aac130ca8727" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id 17592186392399} {:answer/id #uuid "2ce7f102-17d8-5df4-8505-ab11eafbcb85" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id 17592186392400} {:answer/id #uuid "5f83a4ce-78d8-5078-bb57-e6fcb33b7384" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id 17592186392401}] :answer-field/correct {:answer/id #uuid "10193a27-2949-56aa-bfb7-aac130ca8727" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id 17592186392399} :answer-field/id #uuid "ac78dc7d-8434-5df2-894a-caad12e5602a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186392396}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77f48d85-1f2c-59c8-b53a-85db3bc9d5a4" :question/math-academy-id "q-40838" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{22}\\cdot {r}_{12}.$" :question/worked-solution "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**. We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}3 \\\\ -3 \\\\ -3\\end{bmatrix}-(-\\frac{12}{6})\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -3 \\\\ -3\\end{bmatrix}+2\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{6}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}} & \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}}\\end{bmatrix}\\begin{bmatrix}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{6} & -2\\sqrt{6} \\\\ 0 & \\sqrt{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}-\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{6}} & -\\frac{1}{\\sqrt{3}} \\\\ \\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{3}}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}\\sqrt{6} & -2\\sqrt{6} \\\\ 0 & \\sqrt{3}\\end{bmatrix}}}.\n$$\n\nFinally, ${q}_{22}\\cdot {r}_{12}=(-\\frac{1}{\\sqrt{3}})\\cdot (-2\\sqrt{6})=2\\sqrt{2}.$"} {:db/id 17592186134326 :knowledge-point/_questions [{:db/id 17592186133798 :knowledge-point/id #uuid "19ae0632-68ac-5da9-8adf-cf71d5ecbc7c" :knowledge-point/title "Finding the QR Factorization of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145087dc-06f8-558a-b8f8-2208b84355c7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id 17592186364160} {:answer/id #uuid "ff44fb5d-5784-50a2-8670-9d33e2a5aacc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id 17592186364161} {:answer/id #uuid "b69119fb-822b-5880-80ae-95eff4fed6cc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186364162} {:answer/id #uuid "2e7ca4a4-511e-50ee-bf48-b7280e7b04b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id 17592186364163} {:answer/id #uuid "6986252e-a34a-52a9-8eb9-deea8952c9f7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186364164}] :answer-field/correct {:answer/id #uuid "2e7ca4a4-511e-50ee-bf48-b7280e7b04b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id 17592186364163} :answer-field/id #uuid "14335add-728c-5e2f-bb76-9b14164c8f1a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186364159}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba99e80b-ab29-52f3-91a8-3caa3a6f75d7" :question/math-academy-id "q-40845" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{12}\\cdot {r}_{12}.$" :question/worked-solution "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**. We We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}\\,{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}1 \\\\ -5 \\\\ -1\\end{bmatrix}-(-\\frac{9}{9})\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -5 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -4 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{3}\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{3\\sqrt{2}}\\begin{bmatrix}-1 \\\\ -4 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}-\\frac{2}{3} & \\frac{1}{3} & \\frac{2}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & -\\frac{4}{3\\sqrt{2}} & \\frac{1}{3\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -3 \\\\ 0 & 3\\sqrt{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}-\\frac{2}{3} & -\\frac{1}{3\\sqrt{2}} \\\\ \\frac{1}{3} & -\\frac{4}{3\\sqrt{2}} \\\\ \\frac{2}{3} & \\frac{1}{3\\sqrt{2}}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}3 & -3 \\\\ 0 & 3\\sqrt{2}\\end{bmatrix}}}.\n$$\n\nFinally, ${q}_{12}\\cdot {r}_{12}=(-\\frac{1}{3\\sqrt{2}})\\cdot (-3)=\\frac{1}{\\sqrt{2}}.$"} {:db/id 17592186134329 :knowledge-point/_questions [{:db/id 17592186133800 :knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c29b82-3f5f-5c8e-a125-2cbdd6417d8f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} \\\\ 1 \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id 17592186420936} {:answer/id #uuid "47817a63-5bbe-52d7-9d9c-c60e2ec34597" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{8} \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id 17592186420937} {:answer/id #uuid "9e0ce33d-1a7a-5210-8d79-aac72efd95ba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id 17592186420938} {:answer/id #uuid "b36fb759-7e61-5dc6-b202-80ff8e6277b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id 17592186420939} {:answer/id #uuid "be2d6e42-5df1-5c0e-95a9-7be627821491" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix}" :db/id 17592186420940}] :answer-field/correct {:answer/id #uuid "b36fb759-7e61-5dc6-b202-80ff8e6277b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id 17592186420939} :answer-field/id #uuid "ad861459-e1a0-5990-87eb-f4e42696a99f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186132013}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0b5754c-fcd1-5841-875b-00aa65f001b9" :question/math-academy-id "q-40891" :question/problem "Given that the columns of $A$ are linearly independent, find the least-squares solution of $Ax=b$, where \n\n$\\,$ $A=\\begin{bmatrix}2 & 0 & 4 \\\\ 2 & -2 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 2 & -2\\end{bmatrix}\\,$ and $\\,b=\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{\\begin{bmatrix}2 & 0 & 4 \\\\ 2 & -2 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 2 & -2\\end{bmatrix}}}\\overset{x}{\\overset{⏞}{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}}} & =\\overset{b}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix}}}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}2 & 2 & 2 & 2 \\\\ 0 & -2 & 0 & 2 \\\\ 4 & -2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}2 & 0 & 4 \\\\ 2 & -2 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 2 & -2\\end{bmatrix})}^{-1}\\begin{bmatrix}2 & 2 & 2 & 2 \\\\ 0 & -2 & 0 & 2 \\\\ 4 & -2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & ={\\begin{bmatrix}16 & 0 & 0 \\\\ 0 & 8 & 0 \\\\ 0 & 0 & 24\\end{bmatrix}}^{-1}\\begin{bmatrix}8 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{48}\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}8 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2} \\\\ 0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186134330 :knowledge-point/_questions [{:db/id 17592186133800 :knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3afc1c8f-522d-5293-b5bc-fb0af445ea57" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id 17592186552990} {:answer/id #uuid "59f72235-cc0c-51ea-bfd1-ac4741215017" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ \\frac{2}{3}\\end{aligned}]" :db/id 17592186553062} {:answer/id #uuid "89f34cb4-3eca-51a1-a9e5-56975ac20a39" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4}{3} \\\\ 1\\end{aligned}]" :db/id 17592186553145} {:answer/id #uuid "cf1b3757-35af-5e86-bd6c-bce2d443f2e6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ \\frac{4}{3}\\end{aligned}]" :db/id 17592186553282} {:answer/id #uuid "d58ff5f3-672a-5500-87ee-68ad8d33e95d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ \\frac{4}{3}\\end{aligned}]" :db/id 17592186553297}] :answer-field/correct {:answer/id #uuid "89f34cb4-3eca-51a1-a9e5-56975ac20a39" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4}{3} \\\\ 1\\end{aligned}]" :db/id 17592186553145} :answer-field/id #uuid "15282714-ca78-5daf-8840-109d81c6e157" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186132019}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c069118-41f8-5f1c-bae8-57e084a8f67d" :question/math-academy-id "q-40892" :question/problem "Given that the columns of $A$ are linearly independent, find the least-squares solution of $Ax=b$, where \n\n$\\,$ $A=[\\begin{aligned}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{aligned}]\\,$ and $\\,b=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}].$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{aligned}]}}\\overset{x}{\\overset{⏞}{[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]}} & =\\overset{b}{\\overset{⏞}{[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]}}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{aligned}])}^{-1}[\\begin{aligned}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & ={[\\begin{aligned}6 & -3 \\\\ -3 & 2\\end{aligned}]}^{-1}[\\begin{aligned}5 \\\\ -2\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}2 & 3 \\\\ 3 & 6\\end{aligned}][\\begin{aligned}5 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{4}{3} \\\\ 1\\end{aligned}].\\end{aligned}\n$$"} {:db/id 17592186134335 :knowledge-point/_questions [{:db/id 17592186133803 :knowledge-point/id #uuid "d177b305-cdd1-5f91-b9d5-90623e52ad10" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given a QR Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d46557-efc0-5b1f-b0cb-9ea0e4d7c336" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}" :db/id 17592186364166} {:answer/id #uuid "99e87bdd-90c7-547f-a690-eb1dc0906218" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id 17592186364167} {:answer/id #uuid "640f33de-bb11-591d-9bc5-a84caeeac919" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id 17592186364168} {:answer/id #uuid "eefc7790-93f0-510e-bff2-8f7969dd6515" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id 17592186364169} {:answer/id #uuid "fdde5622-ac42-590a-829e-96e9f5354af8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}" :db/id 17592186364170}] :answer-field/correct {:answer/id #uuid "eefc7790-93f0-510e-bff2-8f7969dd6515" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id 17592186364169} :answer-field/id #uuid "5dd921fc-3c97-516f-9a03-871bc9707815" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186364165}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4301112-7fd0-50d7-aa18-2663613551d4" :question/math-academy-id "q-40982" :question/problem "Given the QR decomposition $A=QR,$ find the least-squares solution to $Ax=b,$ where\n\n$$\nQ=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix},\\,R=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 7 \\\\ 0 & 5\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.\n$$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ is orthogonal, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}\\,{Q}^{T}b.\n$$\n\nFinally, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nNow, substituting our matrices, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 7 \\\\ 0 & 5\\end{bmatrix}}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}}}\\overset{b}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}} \\\\ \\begin{bmatrix}1 & 7 \\\\ 0 & 5\\end{bmatrix}x & =\\begin{bmatrix}5 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+7{x}_{2} &=5 \\\\ 5{x}_{2} &=5.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}{x}_{1}+7(1) & =5 \\\\ {x}_{1} & =-2.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.$"} {:db/id 17592186134352 :knowledge-point/_questions [{:db/id 17592186133821 :knowledge-point/id #uuid "cd18abf3-b551-55d6-a573-690745a65b3e" :knowledge-point/title "Finding a QR Factorization of a Matrix Given an Orthogonal Basis in Terms of the Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f68f4b1-032c-586b-a36d-fc805b96dfee" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186379824} {:answer/id #uuid "98233510-2aa1-59df-8104-73b9ce088a12" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id 17592186379825} {:answer/id #uuid "aaf28906-45b4-583d-9cb2-7ecf5f6587a3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186379826} {:answer/id #uuid "ea1a2d8d-138a-5868-84f1-904300ef6336" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186379827} {:answer/id #uuid "bc4bf897-5a8d-5780-adc6-fd6269527019" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186379828}] :answer-field/correct {:answer/id #uuid "98233510-2aa1-59df-8104-73b9ce088a12" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id 17592186379825} :answer-field/id #uuid "f3588995-8c6c-57f9-9ecb-afb3ad54a3b8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379823}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "772d3a4c-3877-5b96-a25a-b75eff00d425" :question/math-academy-id "q-41415" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. You're given that the system of equations given below connects the columns of $Q$ and the columns of $A.$  \n\n$$\n\\left\\{\\begin{aligned}{q}_{1} &=\\frac{1}{2}{a}_{1} \\\\ {q}_{2} &=\\frac{1}{4}{a}_{2}+2{q}_{1} \\\\ {q}_{3} &=\\frac{1}{6}{a}_{3}-4{q}_{1}+{q}_{2}\\end{aligned}\\right.\n$$\n\nWhat is the value of ${r}_{12}+{r}_{22}+{r}_{23}?$" :question/worked-solution "Let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\left\\{\\begin{aligned}{q}_{1} &=\\frac{1}{2}{a}_{1} \\\\ {q}_{2} &=\\frac{1}{4}{a}_{2}+2{q}_{1} \\\\ {q}_{3} &=\\frac{1}{6}{a}_{3}-4{q}_{1}+{q}_{2}\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{a}_{1} &=2{q}_{1} \\\\ {a}_{2} &=-8{q}_{1}+4{q}_{2} \\\\ {a}_{3} &=24{q}_{1}-6{q}_{2}+6{q}_{3}.\\end{aligned}\\right.\n$$\n\nTherefore, this system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}2 & -8 & 24 \\\\ 0 & 4 & -6 \\\\ 0 & 0 & 6\\end{bmatrix}}}\n$$\n\nTherefore, \n\n$$\n{r}_{12}+{r}_{22}+{r}_{23}=-8+4+(-6)=-10.\n$$"} {:db/id 17592186134354 :knowledge-point/_questions [{:db/id 17592186133821 :knowledge-point/id #uuid "cd18abf3-b551-55d6-a573-690745a65b3e" :knowledge-point/title "Finding a QR Factorization of a Matrix Given an Orthogonal Basis in Terms of the Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5efe4aae-2768-528f-a3cc-4c9b9a907391" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186379830} {:answer/id #uuid "a5705d08-f2bc-5a4f-b1ab-65641a5b0ae3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id 17592186379831} {:answer/id #uuid "bf62a0e5-63e3-5e42-889b-986f2738de40" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id 17592186379832} {:answer/id #uuid "e87b5762-481c-57bd-ba1b-c18fef4d4c0f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186379833} {:answer/id #uuid "411c482c-f2e8-5cb9-b82c-84752b240dce" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186379834}] :answer-field/correct {:answer/id #uuid "a5705d08-f2bc-5a4f-b1ab-65641a5b0ae3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id 17592186379831} :answer-field/id #uuid "a20ad309-608a-5c10-aca7-0636d5c13dac" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379829}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fc92fc5-cd9a-5882-b3a5-3c9b7ba00cb3" :question/math-academy-id "q-41417" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ \\frac{{v}_{1}}{‖{v}_{1}‖} & \\frac{{v}_{2}}{‖{v}_{2}‖} & \\frac{{v}_{3}}{‖{v}_{3}‖} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above, where $\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set of vectors. You're given that $‖{v}_{1}‖=4,$ $‖{v}_{2}‖=2,$ $‖{v}_{3}‖=6,$ and that the system of equations below describes the relationship between the columns of $Q$ and the columns of $A.$ \n\n$$\n\\left\\{\\begin{aligned}{v}_{1} &={a}_{1} \\\\ {v}_{2} &={a}_{2}-2{v}_{1} \\\\ {v}_{3} &={a}_{3}-4{v}_{1}+3{v}_{2}\\end{aligned}\\right.\n$$\n\nWhat is the value of ${r}_{11}+{r}_{13}+{r}_{33}?$" :question/worked-solution "First, we normalize the vectors ${v}_{1},{v}_{2},{v}_{3}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{{v}_{1}}{4}\\,⟹\\,{v}_{1}=4{q}_{1} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{{v}_{2}}{2}\\,⟹\\,{v}_{2}=2{q}_{2} \\\\ {q}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{{v}_{3}}{6}\\,⟹\\,{v}_{3}=6{q}_{3}.\\end{aligned}\n$$\n\nNow, the set $\\{{q}_{1},{q}_{2},{q}_{3}\\}$ will be both orthogonal and normalized.\n\nNext, let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\left\\{\\begin{aligned}{v}_{1} &={a}_{1} \\\\ {v}_{2} &={a}_{2}-2{v}_{1} \\\\ {v}_{3} &={a}_{3}-4{v}_{1}+3{v}_{2}\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{a}_{1} &={v}_{1}=4{q}_{1} \\\\ {a}_{2} &=2{v}_{1}+{v}_{2}=8{q}_{1}+2{q}_{2} \\\\ {a}_{3} &=4{v}_{1}-3{v}_{2}+{v}_{3}=16{q}_{1}-6{q}_{2}+6{q}_{3}\\end{aligned}\\right.\n$$\n\nThe final system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}4 & 8 & 16 \\\\ 0 & 2 & -6 \\\\ 0 & 0 & 6\\end{bmatrix}}}\n$$\n\nTherefore, \n\n$$\n{r}_{11}+{r}_{13}+{r}_{33}=4+16+6=26.\n$$"} {:db/id 17592186134356 :knowledge-point/_questions [{:db/id 17592186133863 :knowledge-point/id #uuid "1ed5119c-5ce8-52dc-bd57-f9439ea199e6" :knowledge-point/title "Finding a QR Factorization of a Matrix Given a Matrix With Orthogonal Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3242e45-8dfe-5fe6-82af-0059d6bebf2b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14}" :db/id 17592186132176} {:answer/id #uuid "c3a90b7c-3d63-53f3-854c-41377ac17b2f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id 17592186132177} {:answer/id #uuid "cb68c06b-ba5a-5c65-98ed-312912d7168d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186132178} {:answer/id #uuid "1c47712f-eea4-599f-b333-6824af8370c9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186132179} {:answer/id #uuid "54f799fc-07e7-5466-9e13-83b88c2a6351" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{14}}" :db/id 17592186132180}] :answer-field/correct {:answer/id #uuid "1c47712f-eea4-599f-b333-6824af8370c9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186132179} :answer-field/id #uuid "e90bc570-39fe-5864-8811-4ee9e80d5e1d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186132175}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fad5b7f6-f745-5d1b-8800-91f91ba131b6" :question/math-academy-id "q-41419" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 2 \\\\ -2 & 1 \\\\ 3 & 0\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${a}_{1},{a}_{2}$ of $A$ are orthogonal, and that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained by normalizing the columns of $A,$ what is the value of ${q}_{12}\\cdot {r}_{12}?$" :question/worked-solution "Since the columns of $A$ are already orthogonal, to construct an orthogonal matrix $Q,$ we simply normalize ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{a}_{1}}{‖{a}_{1}‖}=\\frac{1}{\\sqrt{14}}\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{a}_{2}}{‖{a}_{2}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of $A=QR$ by ${Q}^{T},$ we obtain\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{14}} & -\\frac{2}{\\sqrt{14}} & \\frac{3}{\\sqrt{14}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -2 & 1 \\\\ 3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{14} & 0 \\\\ 0 & \\sqrt{5}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 2 \\\\ -2 & 1 \\\\ 3 & 0\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}\\frac{1}{\\sqrt{14}} & \\frac{2}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{14}} & \\frac{1}{\\sqrt{5}} \\\\ \\frac{3}{\\sqrt{14}} & 0\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}\\sqrt{14} & 0 \\\\ 0 & \\sqrt{5}\\end{bmatrix}}}\n$$\n\nFinally, ${q}_{12}\\cdot {r}_{12}=\\frac{2}{\\sqrt{5}}\\cdot 0=0.$"} {:db/id 17592186134362 :knowledge-point/_questions [{:db/id 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9949e4b7-78dc-54e1-b1e2-6cc17d5fdb53" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$9200$" :db/id 17592186132212} {:answer/id #uuid "bdfe35c5-c31d-517c-8491-ee60cd035209" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$10400$" :db/id 17592186132213} {:answer/id #uuid "ed8de521-183c-5b4c-8a34-a2af3d37fe8c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$12200$" :db/id 17592186132214} {:answer/id #uuid "0e37fc32-c14e-5987-8701-bf2b47456c68" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$11500$" :db/id 17592186132215} {:answer/id #uuid "3f07dfd0-be79-5868-bcec-3c18ae2a9bd8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$11300$" :db/id 17592186132216}] :answer-field/id #uuid "891df652-ad00-5c9b-a50d-52740ac80a98" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186132211} {:answer-field/choices [{:answer/id #uuid "481e34c4-8e23-5638-8364-a626e241a934" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$10\\,400$" :db/id 17592186370921} {:answer/id #uuid "f52f14f2-3d6a-50fd-9ea7-988fb8ad0119" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$12\\,200$" :db/id 17592186370922} {:answer/id #uuid "bedb7f6d-404b-5d77-ac8f-a59e15f52f92" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$11\\,500$" :db/id 17592186370923} {:answer/id #uuid "d21b58ed-a896-595c-927e-75a0413683ba" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$9\\,200$" :db/id 17592186370924} {:answer/id #uuid "e75bad89-4049-573b-b220-b46d90025c2c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$11\\,300$" :db/id 17592186370925}] :answer-field/correct {:answer/id #uuid "e75bad89-4049-573b-b220-b46d90025c2c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$11\\,300$" :db/id 17592186370925} :answer-field/id #uuid "f5153227-95be-5d76-8614-6897e17ccc0a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186370920}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "378d2a03-3c23-5c86-9c0e-a7a3f421ff89" :question/math-academy-id "q-41742" :question/problem "A store collected data about its profits (in thousands of dollars) for the first five months since opening. This data is shown below.\n\n| Month $(x)$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| Profit $(y)$ | $8.3$ | $5.1$ | $10.9$ | $10.7$ | $9.5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what will be the profit in the $6$th month, assuming that the trend continues?\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}11 & -3 \\\\ -3 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}44.5 \\\\ 141.5\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/requires-calculator true :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4 \\\\ 1 & 5\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}8.3 \\\\ 5.1 \\\\ 10.9 \\\\ 10.7 \\\\ 9.5\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}11 & -3 \\\\ -3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}44.5 \\\\ 141.5\\end{bmatrix} \\\\  & =\\begin{bmatrix}6.5 \\\\ 0.8\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=6.5+0.8x.$\n\nFinally, to predict the profit in the $6$th month, we substitute $x=6$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =6.5+0.8(6) \\\\  & =11.3\\end{aligned}\n$$\n\nSo, according to the model, the profit in the $6$th month will be $$11\\,300.$\n\n**Note**: Since we're extrapolating ($x=6$ is not within the range of the original set of $x$-values), our result *may* be unreliable."} {:db/id 17592186134363 :knowledge-point/_questions [{:db/id 17592186133799 :knowledge-point/id #uuid "74efec6b-6e5f-5761-a116-5c94e3fb4326" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b22d729-cc0d-54fa-9864-c8d4080046cc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 4 \\\\ 0\\end{bmatrix}" :db/id 17592186324200} {:answer/id #uuid "9f17fb7a-58e4-5d4f-958d-026570090fb1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -4 \\\\ 0\\end{bmatrix}" :db/id 17592186325319} {:answer/id #uuid "ec9c2e86-282e-5662-8cd7-42b9fb93d405" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 \\\\ 2 \\\\ 0\\end{bmatrix}" :db/id 17592186326053} {:answer/id #uuid "ee0d9ad7-a396-5711-bf79-bcf07da297d2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -2 \\\\ 0\\end{bmatrix}" :db/id 17592186326068} {:answer/id #uuid "f967f9c1-953a-54c8-a8ce-01011a989f00" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id 17592186326166}] :answer-field/correct {:answer/id #uuid "1b22d729-cc0d-54fa-9864-c8d4080046cc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 4 \\\\ 0\\end{bmatrix}" :db/id 17592186324200} :answer-field/id #uuid "1200dc9e-5093-525d-82aa-0d957f5fb83d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326254}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72ebe648-c9aa-5496-8f25-29cd029ad4fa" :question/math-academy-id "q-41775" :question/problem "Find the least-squares solution to the system of linear equations given below. You're given that the columns of the corresponding coefficient matrix are linearly independent.\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}+{x}_{3} &=18 \\\\ {x}_{1}-3{x}_{2} &=0 \\\\ {x}_{1}+2{x}_{2}-{x}_{3} &=18 \\\\ {x}_{1}-{x}_{2} &=0\\end{aligned}\\right.\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 1 & 2 & -1 \\\\ 1 & -1 & 0\\end{bmatrix}}}\\overset{x}{\\overset{⏞}{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}}} & =\\overset{b}{\\overset{⏞}{\\begin{bmatrix}18 \\\\ 0 \\\\ 18 \\\\ 0\\end{bmatrix}}}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}1 & 1 & 1 & 1 \\\\ 2 & -3 & 2 & -1 \\\\ 1 & 0 & -1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 1 & 2 & -1 \\\\ 1 & -1 & 0\\end{bmatrix})}^{-1}\\,\\,\\begin{bmatrix}1 & 1 & 1 & 1 \\\\ 2 & -3 & 2 & -1 \\\\ 1 & 0 & -1 & 0\\end{bmatrix}\\begin{bmatrix}18 \\\\ 0 \\\\ 18 \\\\ 0\\end{bmatrix} \\\\  & ={\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 18 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}}^{-1}\\begin{bmatrix}36 \\\\ 72 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{36}\\begin{bmatrix}9 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 18\\end{bmatrix}\\begin{bmatrix}36 \\\\ 72 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 \\\\ 4 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186134364 :knowledge-point/_questions [{:db/id 17592186133799 :knowledge-point/id #uuid "74efec6b-6e5f-5761-a116-5c94e3fb4326" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aab1554b-fae0-5335-a6a7-77698df741dc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id 17592186382112} {:answer/id #uuid "2009b66f-003d-5c80-8e48-abab88cb1420" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 3\\end{bmatrix}" :db/id 17592186382113} {:answer/id #uuid "1487b100-1c31-5209-b048-3058cc674fa0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ \\frac{2}{7}\\end{bmatrix}" :db/id 17592186382114} {:answer/id #uuid "433d99e6-601f-5df8-b751-d495ed88d741" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{5} \\\\ 2\\end{bmatrix}" :db/id 17592186382115} {:answer/id #uuid "449cd155-31c2-5512-84f6-8af243475ed5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}" :db/id 17592186382116}] :answer-field/correct {:answer/id #uuid "aab1554b-fae0-5335-a6a7-77698df741dc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id 17592186382112} :answer-field/id #uuid "141813b9-42f5-5cea-9859-9368a52e5ca4" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382111}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2525e60a-78e9-5925-88e7-cb75c790f3bc" :question/math-academy-id "q-41777" :question/problem "Find the least-squares solution to the system of linear equations given below. You're given that the columns of the corresponding coefficient matrix are linearly independent.\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+{x}_{2} &=5 \\\\ {x}_{1}-{x}_{2} &=2 \\\\ -3{x}_{1}-2{x}_{2} &=4\\end{aligned}\\right.\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{\\begin{bmatrix}2 & 1 \\\\ 1 & -1 \\\\ -3 & -2\\end{bmatrix}}}\\overset{x}{\\overset{⏞}{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}} & =\\overset{b}{\\overset{⏞}{\\begin{bmatrix}5 \\\\ 2 \\\\ 4\\end{bmatrix}}}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}2 & 1 & -3 \\\\ 1 & -1 & -2\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ 1 & -1 \\\\ -3 & -2\\end{bmatrix})}^{-1}\\begin{bmatrix}2 & 1 & -3 \\\\ 1 & -1 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ 2 \\\\ 4\\end{bmatrix} \\\\  & ={\\begin{bmatrix}14 & 7 \\\\ 7 & 6\\end{bmatrix}}^{-1}\\begin{bmatrix}0 \\\\ -5\\end{bmatrix} \\\\  & =\\frac{1}{35}\\begin{bmatrix}6 & -7 \\\\ -7 & 14\\end{bmatrix}\\begin{bmatrix}0 \\\\ -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186134366 :knowledge-point/_questions [{:db/id 17592186133848 :knowledge-point/id #uuid "5924037a-ddc3-5f50-b4b0-1bd813cef255" :knowledge-point/title "Finding the Distance Between a Vector to a Subspace of Solutions of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "658beb98-3dec-5060-92ae-f81e81cef82c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id 17592186324813} {:answer/id #uuid "c7b3af8e-c327-5243-9a41-4f0e70b5283a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{30}" :db/id 17592186325699} {:answer/id #uuid "cd67a364-cf1d-549d-9c49-d92077883fea" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{7}" :db/id 17592186325753} {:answer/id #uuid "e488479d-4656-57fe-b02c-b4b13ff83f38" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{70}" :db/id 17592186325984} {:answer/id #uuid "f9070d26-2226-56f7-82c9-3899a1ad224d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id 17592186326165}] :answer-field/correct {:answer/id #uuid "c7b3af8e-c327-5243-9a41-4f0e70b5283a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{30}" :db/id 17592186325699} :answer-field/id #uuid "9ebcfdce-3c7b-5e93-9fbd-164c8c843efc" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326505}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85fd6f83-baf3-5731-972e-5511c5fc2e85" :question/math-academy-id "q-41783" :question/problem "Consider the system $Ax=b$, where the matrix $A$ and the vector $b$ are given below. Given that the columns of $A$ are linearly independent, find the minimum value of $‖Ax-b‖.$\n\n$$\nA=\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ -1 & 1 \\\\ 0 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-10 \\\\ 5 \\\\ 0 \\\\ -5\\end{bmatrix}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ -1 & 1 \\\\ 0 & 1\\end{bmatrix}}}\\overset{x}{\\overset{⏞}{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}}} & =\\overset{b}{\\overset{⏞}{\\begin{bmatrix}-10 \\\\ 5 \\\\ 0 \\\\ -5\\end{bmatrix}}} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}1 & 2 & -1 & 0 \\\\ 1 & -1 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ -1 & 1 \\\\ 0 & 1\\end{bmatrix})}^{-1}\\begin{bmatrix}1 & 2 & -1 & 0 \\\\ 1 & -1 & 1 & 1\\end{bmatrix}\\begin{bmatrix}-10 \\\\ 5 \\\\ 0 \\\\ -5\\end{bmatrix} \\\\  & ={\\begin{bmatrix}6 & -2 \\\\ -2 & 4\\end{bmatrix}}^{-1}\\begin{bmatrix}0 \\\\ -20\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}2 & 1 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}0 \\\\ -20\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$\n\nThe minimum value of $‖Ax-b‖$ is attained when $x=\\hat{x},$ which is the least-squares solution of the system $Ax=b.$ In this case, $A\\hat{x}$ represents the orthogonal projection of $b$ onto the column space of $A,$ and $‖A\\hat{x}-b‖$ is the distance between the vector $b$ and the column space. Therefore,\n\n$$\n\\begin{aligned}A\\hat{x}-b & =\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ -1 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -6\\end{bmatrix}-\\begin{bmatrix}-10 \\\\ 5 \\\\ 0 \\\\ -5\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -3 \\\\ -4 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n‖A\\hat{x}-b‖=\\sqrt{{2}^{2}+(-3)^{2}+(-4)^{2}+(-1)^{2}}=\\sqrt{30}.\n$$"} {:db/id 17592186134387 :knowledge-point/_questions [{:db/id 17592186133809 :knowledge-point/id #uuid "5eaee4e9-7be5-5c35-bc88-89697a15d75a" :knowledge-point/title "Identifying Elements of a Multiple Linear Regression That Passes Through the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "603e20fb-5fe2-5ee6-a1ec-6a40034bec5f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 10 \\\\ 2 & 25 \\\\ 3 & 32 \\\\ 4 & 42 \\\\ 5 & 15\\end{aligned}]" :db/id 17592186551898} {:answer/id #uuid "a6fc93be-036b-5b3e-bc66-6cf227beda4f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 10 & 0 \\\\ 2 & 25 & -5 \\\\ 3 & 32 & -2 \\\\ 4 & 42 & 2 \\\\ 5 & 15 & 7\\end{aligned}]" :db/id 17592186552066} {:answer/id #uuid "b8e540cd-3c04-55e6-a37b-b458bf640947" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 10 \\\\ 1 & 2 & 25 \\\\ 1 & 3 & 32 \\\\ 1 & 4 & 42 \\\\ 1 & 5 & 15\\end{aligned}]" :db/id 17592186552111} {:answer/id #uuid "bb2cea96-c7d9-5a98-9f05-cc71f90c9189" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ -5 \\\\ -2 \\\\ 2 \\\\ 7\\end{aligned}]" :db/id 17592186552114} {:answer/id #uuid "ff3e0dd1-2a05-50c1-b114-ba517fd9603a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 3 \\\\ 4 \\\\ 5\\end{aligned}]" :db/id 17592186552254}] :answer-field/correct {:answer/id #uuid "603e20fb-5fe2-5ee6-a1ec-6a40034bec5f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 10 \\\\ 2 & 25 \\\\ 3 & 32 \\\\ 4 & 42 \\\\ 5 & 15\\end{aligned}]" :db/id 17592186551898} :answer-field/id #uuid "69e5f672-7f5d-5b04-9df7-06332705d41d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186132361}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32203128-d23c-5cb0-ab0f-cdb995f482b7" :question/math-academy-id "q-42300" :question/problem "| ${x}_{1}$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$10$** | **$25$** | **$32$** | **$42$** | **$15$** |\n| $y$ | $0$ | $-5$ | $-2$ | $2$ | $7$ |\n\nThe vector of coefficients of the plane $y={\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}$ that best fits the data above can be found using multiple linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{1} \\\\ {\\beta }_{2}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the design matrix $X$ in this context?" :question/worked-solution "| ${x}_{1}$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$10$** | **$25$** | **$32$** | **$42$** | **$15$** |\n| $y$ | $0$ | $-5$ | $-2$ | $2$ | $7$ |\n\nThe coefficients of the plane \n\n$$\ny={\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}\n$$\n\nthat best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 10 \\\\ 2 & 25 \\\\ 3 & 32 \\\\ 4 & 42 \\\\ 5 & 15\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{1} \\\\ {\\beta }_{2}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}0 \\\\ -5 \\\\ -2 \\\\ 2 \\\\ 7\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."} {:db/id 17592186134389 :knowledge-point/_questions [{:db/id 17592186133823 :knowledge-point/id #uuid "aa5bf185-de29-5185-ba57-c64250332dfa" :knowledge-point/title "Identifying the Elements of a Polynomial Regression Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ab6240c-a811-5ed5-a876-ef55a74dd515" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 \\\\ 1 & -2 \\\\ 1 & -1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]" :db/id 17592186550473} {:answer/id #uuid "8f5c471a-3743-58fa-b032-6489b39478a8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & {1}^{2} & {1}^{3} \\\\ 1 & 2 & {2}^{2} & {2}^{3} \\\\ 1 & 3 & {3}^{2} & {3}^{3} \\\\ 1 & 4 & {4}^{2} & {4}^{3} \\\\ 1 & 5 & {5}^{2} & {5}^{3}\\end{aligned}]" :db/id 17592186550732} {:answer/id #uuid "aec9c374-1a4f-55d4-a0d4-1da3da5ab4af" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4 \\\\ 1 & 5\\end{aligned}]" :db/id 17592186550844} {:answer/id #uuid "dfd58429-3797-5a27-8e39-d9edfc6a019f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -2 \\\\ -1 \\\\ 1 \\\\ -1\\end{aligned}]" :db/id 17592186550979} {:answer/id #uuid "f6744f4c-62ff-5cd6-b5e9-04b41d3ac340" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\