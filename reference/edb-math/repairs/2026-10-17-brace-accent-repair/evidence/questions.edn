-84af-516b-8507-8c799b952b2c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id 17592186422520} {:answer/id #uuid "5cfbc41e-74ce-5263-a336-b42e1565ad9b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2a+1" :db/id 17592186422562}] :answer-field/correct {:answer/id #uuid "5cfbc41e-74ce-5263-a336-b42e1565ad9b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2a+1" :db/id 17592186422562} :answer-field/id #uuid "b6549ab4-cf9a-5b39-9d10-307c907bf94d" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186422721}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15ce914f-28d4-58cf-a9d9-4237499cad54" :question/math-academy-id "q-184242" :question/problem "Prove that if $n$ is odd, then $15n+3$ is even.\n\nIf $n$ is odd, then $n=\\,${{field-1}} for {{field-2}}.\n\nTherefore, \n\n$$\n\\begin{aligned}15n+3 & ={{field-3}}.\\end{aligned}\n$$\n\nLet $b=$ {{field-4}}. Since $a$ is {{field-5}}, we have that $b$ is {{field-6}}.\n\nTherefore, we have\n\n$$\n\\begin{aligned}15n+3 & ={{field-7}}\\end{aligned}\n$$\n\nwhich is a multiple of $2.$ Therefore, $15n+3$ is {{field-8}}." :question/worked-solution "Recall the following:\n\n- If an integer $n$ is even, then there exists an integer $p$ such that $n=2p.$\n\n- If an integer $n$ is odd, then there exists an integer $q$ such that $n=2q+1.$\n\nIn this case, we need to prove the following:\n\n$$\nn\\text{ is odd}\\,⇒\\,15n+3\\text{ is even}\n$$\n\nWe start by using the fact that $n$ is odd.\n\nIf $n$ is odd, then $n=2a+1$ for some integer $a.$\n\nThe idea is to substitute $n=2a+1$ into the expression $15n+3$ and show it is even by writing it as a multiple of $2.$\n\nTherefore, \n\n$$\n\\begin{aligned}15n+3 & =15(2a+1)+3 \\\\  & =30a+15+3 \\\\  & =30a+18 \\\\  & =2{{(15a+9)}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNow, if we define another integer $b=15a+9$ (highlighted above), we have that $15n+3=2b,$ which shows that $15n+3$ is indeed a multiple of $2.$\n\nLet $b=15a+9.$ Since $a$ is an integer, we have that $b$ is an integer. \n\nTherefore, we have\n\n$$\n\\begin{aligned}15n-3 & =2{{(15a+9)}_{⏟}}_{b} \\\\  & =2b\\end{aligned}\n$$\n\nwhich is a multiple of $2.$\n\nFinally, we write our conclusion.\n\nTherefore, $15n-3$ is even."} {:db/id 17592186422739 :knowledge-point/_questions [{:db/id 17592186157256 :knowledge-point/id #uuid "02a1ebb1-37f3-5305-99b5-cf6ddc62e037" :knowledge-point/title "Proving the Parity of a Nonlinear Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9abac9a7-4bc1-5b4a-b0ef-25c359e9e66b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2b+1" :db/id 17592186422602} {:answer/id #uuid "9c3ca755-3710-5fe9-b102-89aa4ef7fa92" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2b-1" :db/id 17592186422605} {:answer/id #uuid "b5d55c4e-7794-5f43-9ce0-4127ff3baf95" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2a+1" :db/id 17592186422622} {:answer/id #uuid "e83c0517-df33-56a4-abd5-74e112fc4d77" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2b" :db/id 17592186422668} {:answer/id #uuid "fe5da349-2e57-5a40-b240-54ab6e23ba19" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id 17592186422683}] :answer-field/correct {:answer/id #uuid "9abac9a7-4bc1-5b4a-b0ef-25c359e9e66b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2b+1" :db/id 17592186422602} :answer-field/id #uuid "07ac89ac-d480-5f09-9c89-2320aa157bdd" :answer-field/key "field-6" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186422687} {:answer-field/choices [{:answer/id #uuid "029923eb-1887-521d-b691-06f7a68cb1c5" :answer/type {:db/id 17592186045498 :