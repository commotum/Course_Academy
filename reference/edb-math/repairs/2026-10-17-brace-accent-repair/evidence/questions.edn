3}-{v}_{1}-2{v}_{2}\\end{aligned}\\right.\n$$\n\nWhat is the value of ${r}_{12}+{r}_{22}+{r}_{23}?$" :question/worked-solution "First, we normalize the vectors ${v}_{1},{v}_{2},{v}_{3}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{{v}_{1}}{1}\\,⟹\\,{v}_{1}={q}_{1} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{{v}_{2}}{3}\\,⟹\\,{v}_{2}=3{q}_{2} \\\\ {q}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{{v}_{3}}{2}\\,⟹\\,{v}_{3}=2{q}_{3}.\\end{aligned}\n$$\n\nNow, the set ${{q}_{1},{q}_{2},{q}_{3}}$ will be both orthogonal and normalized.\n\nNext, let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\left\\{\\begin{aligned}{v}_{1} &={a}_{1} \\\\ {v}_{2} &={a}_{2}-3{v}_{1} \\\\ {v}_{3} &={a}_{3}-{v}_{1}-2{v}_{2}\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{a}_{1} &={v}_{1}={q}_{1} \\\\ {a}_{2} &=3{v}_{1}+{v}_{2}=3{q}_{1}+3{q}_{2} \\\\ {a}_{3} &={v}_{1}+2{v}_{2}+{v}_{3}={q}_{1}+6{q}_{2}+2{q}_{3}\\end{aligned}\\right.\n$$\n\nThe final system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}1 & 3 & 1 \\\\ 0 & 3 & 6 \\\\ 0 & 0 & 2\\end{bmatrix}}}\n$$\n\nTherefore, \n\n$$\n{r}_{12}+{r}_{22}+{r}_{23}=3+3+6=12.\n$$"} {:db/id 17592186364606 :knowledge-point/_questions [{:db/id 17592186133821 :knowledge-point/id #uuid "cd18abf3-b551-55d6-a573-690745a65b3e" :knowledge-point/title "Finding a QR Factorization of a Matrix Given an Orthogonal Basis in Terms of the Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6009f42f-b38d-5096-b2c7-dd563efd77c2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id 17592186364608} {:answer/id #uuid "1