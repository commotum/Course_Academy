498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id 17592186423795} {:answer/id #uuid "ff7e7380-513a-5b76-bdda-1674458cd91c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id 17592186423821}] :answer-field/correct {:answer/id #uuid "ff7e7380-513a-5b76-bdda-1674458cd91c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id 17592186423821} :answer-field/id #uuid "ff39d58c-9bc1-5098-8c5c-72c6dcef5e04" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186423856} {:answer-field/choices [{:answer/id #uuid "21723135-63f3-5a05-b574-7edf8844e623" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186423697} {:answer/id #uuid "4c3d17bd-d47b-52b3-8ed1-2de99ff86980" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186423713} {:answer/id #uuid "51c4f3cd-2606-5c74-b80f-b6abf7dd62e3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186423717} {:answer/id #uuid "88f8d560-f646-5bd6-b441-ba4e9d5643a4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186423753}] :answer-field/correct {:answer/id #uuid "88f8d560-f646-5bd6-b441-ba4e9d5643a4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186423753} :answer-field/id #uuid "ffe72c59-ed60-54e2-85be-79849b5fc382" :answer-field/key "field-7" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186423857}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c55065d-263c-577d-a3d6-fb804f092192" :question/math-academy-id "q-363845" :question/problem "$$\nA=\\begin{bmatrix}2 & 0 \\\\ 2 & 0 \\\\ 1 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | $\\frac{2}{3}$ |  |  |\n|  |  | {{field-2}} |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{1}$ and ${x}_{2}$ as free variables, the general solution is given by:\n\n|  |  | ${x}_{1}$ |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-4}} |  |  |\n|  |  | {{field-5}} |  |  |\n\nthat we can rewrite as:\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ -2{x}_{1}-2{x}_{2}\\end{bmatrix}={x}_{1}{{\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{2}{{\\begin{bmatrix}0 \\\\ 1 \\\\ -2\\end{bmatrix}}_{⏟}}_{{b}_{2}}.\n$$\n\nNext, we orthogonalize ${b}_{1}$ and ${b}_{2}$ using the Gram-Schmidt process to get the corresponding orthogonal vectors ${c}_{1}$ and ${c}_{2}.$\n\nLet ${c}_{1}={b}_{1},$ then:\n\n|  |  | $-4$ |  |  |\n| --- | --- | --- | --- | --- |\n| ${c}_{2}=\\frac{1}{5}\\,\\,$ |  | {{field-6}} |  |  |\n|  |  | {{field-7}} |  |  |\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                $\\frac{1}{\\sqrt{5}}$\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-8}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-10}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-11}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                $-\\frac{2}{3\\sqrt{5}}$\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & 0 \\\\ 2 & 0 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 \\\\ 2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}\\end{aligned}\n$$\n\n  \n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{2}{3}{x}_{1}+\\frac{2}{3}{x}_{2}+\\frac{1}{3}{x}_{3}=0\\,⟹\\,2{x}_{1}+2{x}_{2}+{x}_{3}=0,\n$$\n\nwe get the general solution \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ -2{x}_{1}-2{x}_{2}\\end{bmatrix}={x}_{1}{{\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{2}{{\\begin{bmatrix}0 \\\\ 1 \\\\ -2\\end{bmatrix}}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are free variables. \n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are *not* mutually orthogonal. Therefore, we have to orthogonalize them using the Gram-Schmidt process. So, let \n\n$$\n{c}_{1}={b}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}.\n$$\n\nThen,\n\n$$\n\\begin{aligned}{c}_{2} & ={b}_{2}-\\frac{{b}_{2}\\cdot {c}_{1}}{{c}_{1}\\cdot {c}_{1}}{c}_{1}=\\begin{bmatrix}0 \\\\ 1 \\\\ -2\\end{bmatrix}-\\frac{4}{5}\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}=\\frac{1}{5}\\begin{bmatrix}-4 \\\\ 5 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n$$\n{u}_{2}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ 0 \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}-\\frac{4}{3\\sqrt{5}} \\\\ \\frac{5}{3\\sqrt{5}} \\\\ -\\frac{2}{3\\sqrt{5}}\\end{bmatrix}\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=\\begin{bmatrix}\\frac{2}{3} & \\frac{1}{\\sqrt{5}} & -\\frac{4}{3\\sqrt{5}} \\\\ \\frac{2}{3} & 0 & \\frac{5}{3\\sqrt{5}} \\\\ \\frac{1}{3} & -\\frac{2}{\\sqrt{5}} & -\\frac{2}{3\\sqrt{5}}\\end{bmatrix}\n$$"} {:db/id 17592186423861 :knowledge-point/_questions [{:db/id 17592186162045 :knowledge-point/id #uuid "566bda0f-f62d-581d-936d-baa8ae474e50" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix: Cases Requiring Orthogonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f973130-cfab-5d6d-a185-231103a52f59" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{30}}" :db/id 17592186423714} {:answer/id #uuid "6a731e09-3213-5f7e-82b3-d3ce153d3deb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{30}}" :db/id 17592186423735} {:answer/id #uuid "a91f5189-f245-55bf-b486-81db711d916f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{30}}" :db/id 17592186423771} {:answer/id #uuid "d2ba7b6b-dff0-500a-8ed6-befe209d17ef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{30}}" :db/id 17592186423798}] :answer-field/correct {:answer/id #uuid "4f973130-cfab-5d6d-a185-231103a52f59" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{30}}" :db/id 17592186423714} :answer-field/id #uuid "0e5a83d3-b68d-5e34-9093-7873a4a49b6f" :answer-field/key "field-11" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186423823} {:answer-field/choices [{:answer/id #uuid "8df64d98-ce84-522