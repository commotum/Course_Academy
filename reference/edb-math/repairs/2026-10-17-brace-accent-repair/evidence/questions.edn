}^{3} \\\\ 1 & 5 & {5}^{2} & {5}^{3}\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}3 \\\\ -2 \\\\ -1 \\\\ 1 \\\\ -1\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."} {:db/id 17592186134390 :knowledge-point/_questions [{:db/id 17592186133806 :knowledge-point/id #uuid "7b2c90d8-0f2e-5f84-bf67-7620d6f1d308" :knowledge-point/title "Identifying the Design Matrix When the Regression Curve Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b4568e0-b00c-5003-af24-68e63638d6b1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4 \\\\ 1 & 5\\end{bmatrix}" :db/id 17592186132380} {:answer/id #uuid "a19aaa0b-7584-5062-831b-659dcccf6bf7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 1 & -2 \\\\ 1 & -1 \\\\ 1 & 1 \\\\ 1 & -1\\end{bmatrix}" :db/id 17592186132381} {:answer/id #uuid "a6bb7cb9-8bde-5122-9d04-c81fc049592b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 & 1^{2} \\\\ 1 & 2 & 2^{2} \\\\ 1 & 3 & 3^{2} \\\\ 1 & 4 & 4^{2} \\\\ 1 & 5 & 5^{2}\\end{bmatrix}" :db/id 17592186132382} {:answer/id #uuid "05230233-b745-5fc9-8a2a-918ccdfc664f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1^{2} & 3 \\\\ 1 & 2^{2} & -2 \\\\ 1 & 3^{2} & -1 \\\\ 1 & 4^{2} & 1 \\\\ 1 & 5^{2} & -1\\end{bmatrix}" :db/id 17592186132383} {:answer/id #uuid "7230da6b-22a9-5b7f-8aab-b8b4764213b8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1^{2} \\\\ 1 & 2^{2} \\\\ 1 & 3^{2} \\\\ 1 & 4^{2} \\\\ 1 & 5^{2}\\end{bmatrix}" :