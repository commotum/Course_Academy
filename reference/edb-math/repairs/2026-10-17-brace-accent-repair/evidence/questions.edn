ncel{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nTherefore, ${15}^{4}=50,625.$"} {:db/id 17592186430708 :knowledge-point/_questions [{:db/id 17592186171954 :knowledge-point/id #uuid "5178592b-14ed-520a-a375-e95219ba8fa3" :knowledge-point/title "Squaring Numbers Ending in Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e22584d-3050-5603-88da-5ecc5679e6e1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "490000" :db/id 17592186430684}] :answer-field/correct {:answer/id #uuid "5e22584d-3050-5603-88da-5ecc5679e6e1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "490000" :db/id 17592186430684} :answer-field/id #uuid "3854e34a-bad6-5250-b016-0e9032322e89" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186430701}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6078b88-7674-57bc-95ac-a34e18c2f27b" :question/math-academy-id "q-224264" :question/problem "${700}^{2}=${{field-1}}" :question/worked-solution "To evaluate ${700}^{2},$ we start by writing it out with a multiplication sign:\n\n$$\n{700}^{2}={{700\\times 700}_{⏟}}_{2\\text{ times}}\n$$\n\nThen, we work out $700\\times 700.$\n\nFirst, we figure out the non-zero part and the block of zeros for both numbers:\n\n$$\n\\begin{aligned}700 & \\,⟶\\,700 \\\\ 700 & \\,⟶\\,700\\end{aligned}\n$$\n\nWe can see that there are $4$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n7\\times 7=49\n$$\n\nFinally, we join the above with the block of zeros: \n\n$$\n490000=490,000\n$$\n\nTherefore, ${700}^{2}=490,000.$"} {:db/id 17592186430709 :knowledge-point/_questions [{:db/id 17592186171953 :knowledge-point/id #uuid "3ccf09f0-c76d-5133-be05-1fdfa61b23ad" :knowledge-point/title "Squaring Two-Digit Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2180c52-0c69-5616-9e0e-538f8bf11655" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "196" :db/id 17592186430695}] :answer-field/correct {:answer/id #uuid "d2180c52-0c69-5616-9e0e-538f8bf11655" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "196" :db/id 17592186430695} :answer-field/id #uuid "6ced82ff-6330-5b2d-9d1d-4a8a84518b30" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186430702}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e43445a0-0d82-5a10-9128-a6bbc70f2fb7" :question/math-academy-id "q-224170" :question/problem "${14}^{2}=${{field-1}}" :question/worked-solution "To evaluate ${14}^{2},$ we start by writing it out with a multiplication sign:\n\n$$\n{14}^{2}={{14\\times 14}_{⏟}}_{2\\text{ times}}\n$$\n\nThen, we work out $14\\times 14.$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned} & \\end{aligned}\n$$\n\nTherefore, ${14}^{2}=196.$"} {:db/id 17592186430710 :knowledge-point/_questions [{:db/id 17592186171955 :knowledge-point/id #uuid "b5c8e2ab-4da7-5e43-a61f-b1dbf76d99ef" :knowledge-point/title "Raising Numbers to Larger Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a1fe2e9-3215-56ff-844d-809607dfee80" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "456,976" :db/id 17592186430681} {:answer/id #uuid "210645d8-4956-5453-83b8-3f0cd0d18de8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "546,796" :db/id 17592186430682} {:answer/id #uuid "2f293bda-663a-5011-a208-7a934bda6945" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "262,626" :db/id 17592186430683} {:answer/id #uuid "cc334405-0655-5d39-b908-539af151fd5c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "45,676" :db/id 17592186430693} {:answer/id #uuid "d47068e5-5d78-5c8f-913c-edd528905913" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "46,766" :db/id 17592186430696}] :answer-field/correct {:answer/id #uuid "1a1fe2e9-3215-56ff-844d-809607dfee80" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "456,976" :db/id 17592186430681} :answer-field/id #uuid "73ad5707-2679-50c7-b949-eced3d654331" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186430703}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f2152ba3-455d-5581-bc1a-a5346e3a471a" :question/math-academy-id "q-224334" :question/problem "Given that ${26}^{2}=676,$ evaluate ${26}^{4}.$" :question/worked-solution "To evaluate ${26}^{4},$ we start by writing it out with multiplication signs:\n\n$$\n{26}^{4}={{26\\times 26\\times 26\\times 26}_{⏟}}_{4\\text{ times}}\n$$\n\nSince ${26}^{2}=26\\times 26=676,$ we have\n\n$$\n{{26\\times 26}_{⏟}}_{676}\\times {{26\\times 26}_{⏟}}_{676}=676\\times 676.\n$$\n\nFinally, we work out $676\\times 676.$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  &  & \\,\\,\\,\\,\\begin{aligned}4 \\\\ \\cancel{5} \\\\ \\cancel{4}\\end{aligned}\\,\\,\\,\\, & \\,\\,\\,\\,\\begin{aligned}3 \\\\ \\cancel{4} \\\\ \\cancel{3}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  &  & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nTherefore, ${26}^{2}=456,976.$"} {:db/id 17592186430732 :knowledge-point/_questions [{:db/id 17592186119820 :knowledge-point/id #uuid "6e4f1675-9146-5279-9b64-07a63a9bed99" :knowledge-point/title "Finding a Vector Given Its Coordinates Relative To a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce43d07-7d46-5c98-b744-3a88ad395201" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -16 \\\\ 12\\end{bmatrix}" :db/id 17592186430713} {:answer/id #uuid "b1937a48-91af-551c-9a98-39c8335585e6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ -36 \\\\ 0\\end{bmatrix}" :db/id 17592186430721} {:answer/id #uuid "d52b898d-8b0d-5322-b32b-d790188a0c69" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -3 \\\\ 1\\end{bmatrix}" :db/id 17592186430724} {:answer/id #uuid "e60504c0-156d-5be5-b8b0-a6c50751ba29" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-23 \\\\ -16 \\\\ 5\\end{bmatrix}" :db/id 17592186430726} {:answer/id #uuid "f9aaf9bb-e91f-5b1b-81ad-71ec2b8c9df5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 6 \\\\ 3\\end{bmatrix}" :db/id 17592186430728}] :answer-field/correct {:answer/id #uuid "b1937a48-91af-551c-9a98-39c8335585e6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ -36 \\\\ 0\\end{bmatrix}" :db/id 17592186430721} :answer-field/id #uuid "0e865a75-dfdd-5a58-b928-640a4073b739" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186430729}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8a5b5cd1-19ba-524a-960c-18e8a17d885d" :question/math-academy-id "q-112202" :question/problem "Find the vector $x$, if $B=\\{{b}_{1},{b}_{2}\\}$ is a basis of $\\text{Span}\\{{b}_{1},{b}_{2}\\},$ and \n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -8 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}2 \\\\ 4 \\\\ 1\\end{bmatrix},\\,[x]_{B}=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}.\n$$" :question/worked-solution "We know that any vector in  $\\text{Span}\\{{b}_{1},{b}_{2}\\}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -8 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 4 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix},$ we obtain\n\n$$\n\\begin{aligned}x & ={{(\\,3\\,)}_{⏟}}_{{x}_{1}}\\begin{bmatrix}1 \\\\ -8 \\\\ 1\\end{bmatrix}+{{(\\,-3\\,)}_{⏟}}_{{x}_{2}}\\begin{bmatrix}2 \\\\ 4 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -24 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}-6 \\\\ -12 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ -36 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186431184 :knowledge-point/_questions [{:db/id 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f86a33-c575-56fe-bdb7-9730885ac9ec" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186431147} {:answer/id #uuid "20c46104-aaee-5f81-87c8-e9c611ae6afd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\pi " :db/id 17592186431151} {:answer/id #uuid "54da2db0-1ce1-5f93-af27-c7663a8c8354" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\pi " :db/id 17592186431155} {:answer/id #uuid "c8614eac-4ce9-50b5-a743-5b04a0329efb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id 17592186431170} {:answer/id #uuid "fe3f8a13-dd60-5d9d-81be-3575b6037de6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id 17592186431176}] :answer-field/correct {:answer/id #uuid "20c46104-aaee-5f81-87c8-e9c611ae6afd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\pi " :db/id 17592186431151} :answer-field/id #uuid "257fc3b0-4eee-568e-ab48-ba72ee13cf19" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186431177}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f7d4767-ad54-585a-81f3-9a4a8f681379" :question/math-academy-id "q-162373" :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨x+y,\\,-x+y,\\,-2z⟩,$ and $C$ is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the paraboloid $z=(x-1)^{2}+(y+1)^{2}.$ The curve $C$ is oriented counter-clockwise when viewed from above." :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the paraboloid $z=(x-1)^{2}+(y+1)^{2}.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=(x-1)^{2}+(y+1)^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}((x-1)^{2}+(y+1)^{2})=2(x-1) \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}((x-1)^{2}+(y+1)^{2})=2(y+1)\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨x+y,\\,-x+y,\\,-2z⟩{|}_{z=(x-1)^{2}+(y+1)^{2}} \\\\  & =⟨{{x+y}_{⏟}}_{P},\\,{{-x+y}_{⏟}}_{Q},\\,{{-2(x-1)^{2}-2(y+1)^{2}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(x+y)\\cdot 2(x-1)-(-x+y)\\cdot 2(y+1)-2((x-1)^{2}+(y+1)^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}2((x+y)(1-x)+(x-y)(y+1)-(x-1)^{2}-(y+1)^{2})\\,\\text{d}A \\\\  & ={∬}_{D}4(-{x}^{2}-{y}^{2}+2x-y-1)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}4(-{x}^{2}-{y}^{2}+2x-y-1)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }4(-{r}^{2}+2r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta -1)\\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}{\\int }_{0}^{2\\pi }(-{r}^{3}+2{r}^{2}\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡\\theta -r)\\,\\text{d}\\theta \\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}{[-{r}^{3}\\theta +2{r}^{2}\\operatorname{cos}⁡\\theta +{r}^{2}\\operatorname{cos}⁡\\theta -r\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}(-2\\pi {r}^{3}-2\\pi r)\\,\\text{d}r \\\\  & =-8\\pi {[-\\frac{{r}^{4}}{4}-\\frac{{r}^{2}}{2}]}_{0}^{1} \\\\  & =-8\\pi (-\\frac{1}{4}-\\frac{1}{2}) \\\\  & =-6\\pi .\\end{aligned}\n$$"} {:db/id 17592186431187 :knowledge-point/_questions [{:db/id 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce41f48-3cd0-5535-a296-5747f3b20333" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1+x}\\,y({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id 17592186431150} {:answer/id #uuid "3859679f-08da-5297-b35b-fcbd0703da61" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1+x}\\,{x}^{2}+{y}^{2}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id 17592186431153} {:answer/id #uuid "83932af9-e25e-5cce-b094-ca4fbc00e243" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1}\\,y({x}^{2}+{y}^{2})^{3}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id 17592186431158} {:answer/id #uuid "aeb9b526-feac-52a5-810d-3cdfe908fcdf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1}\\,\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id 17592186431166} {:answer/id #uuid "da95a228-ca5c-59a2-aafd-0aafd2625911" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1+x}\\,({x}^{2}+{y}^{2})^{2}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id 17592186431172}] :answer-field/correct {:answer/id #uuid "1ce41f48-3cd0-5535-a296-5747f3b20333" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1+x}\\,y({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id 17592186431150} :answer-field/id #uuid "f3c5fce6-36d3-5f8a-948a-98bad40e6ffb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186431182}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9aea1d19-f86f-5208-99cb-c76a6a49c45e" :question/math-academy-id "q-162364" :question/problem "Let $C$ be the intersection of the half-cone $z=\\sqrt{{x}^{2}+{y}^{2}}$ and the boundary of the infinite vertical column enclosed by the planes $y=1+x,$ $x=0,$ and $y=0.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨0,\\,-{z}^{3},\\,0⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the half-cone $z=\\sqrt{{x}^{2}+{y}^{2}}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}\\sqrt{{x}^{2}+{y}^{2}}=\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}\\sqrt{{x}^{2}+{y}^{2}}=\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨0\\,-{z}^{3},\\,0⟩{|}_{z=\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =⟨0,\\,-({x}^{2}+{y}^{2})^{3/2},\\,0⟩ \\\\  & =⟨{{0}_{⏟}}_{P},\\,{{-({x}^{2}+{y}^{2})^{3/2}}_{⏟}}_{Q},\\,{{0}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot \\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}+({x}^{2}+{y}^{2})^{3/2}\\cdot \\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}+0)\\,\\text{d}A \\\\  & ={∬}_{D}y({x}^{2}+{y}^{2})\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/ab/ab155520a21d38483e8b0978a04972e1a96c8d273d23ca7aa36bb1846189b4c8.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}y({x}^{2}+{y}^{2})\\,\\text{d}A & ={\\int }_{-1}^{0}{\\int }_{0}^{1+x}\\,y({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id 17592186432326 :knowledge-point/_questions [{:db/id 17592186133821 :knowledge-point/id #uuid "cd18abf3-b551-55d6-a573-690745a65b3e" :knowledge-point/title "Finding a QR Factorization of a Matrix Given an Orthogonal Basis in Terms of the Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003af35e-f600-5607-8b84-03a3fd662edc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id 17592186432272} {:answer/id #uuid "061380b4-8fa4-5c94-aa1d-0aa7eefd118f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id 17592186432275} {:answer/id #uuid "49b4d1d7-f1c4-5298-a995-47dd049adbd4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id 17592186432287} {:answer/id #uuid "70fe47a0-cdd1-5db7-baec-800ac5639ef7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id 17592186432298} {:answer/id #uuid "cfb5e98f-f826-54b9-8c31-84bb424125fc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186432310}] :answer-field/correct {:answer/id #uuid "cfb5e98f-f826-54b9-8c31-84bb424125fc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186432310} :answer-field/id #uuid "bcc7880c-e1d9-51f3-9d82-55e1eee95989" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432324}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a08d141-4335-56a2-8562-7ce4a6f3683b" :question/math-academy-id "q-41484" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. You're given that the system of equations given below connects the columns of $Q$ and the columns of $A.$  \n\n$$\n\\left\\{\\begin{aligned}{q}_{1} &=\\frac{1}{3}{a}_{1} \\\\ {q}_{2} &=\\frac{1}{5}{a}_{2}+6{q}_{1} \\\\ {q}_{3} &=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned}\\right.\n$$\n\nWhat is the value of ${r}_{11}+{r}_{13}+{r}_{23}?$" :question/worked-solution "Let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\left\\{\\begin{aligned}{q}_{1} &=\\frac{1}{3}{a}_{1} \\\\ {q}_{2} &=\\frac{1}{5}{a}_{2}+6{q}_{1} \\\\ {q}_{3} &=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{a}_{1} &=3{q}_{1} \\\\ {a}_{2} &=-30{q}_{1}+5{q}_{2} \\\\ {a}_{3} &=8{q}_{1}-4{q}_{2}+4{q}_{3}.\\end{aligned}\\right.\n$$\n\nTherefore, this system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}3 & -30 & 8 \\\\ 0 & 5 & -4 \\\\ 0 & 0 & 4\\end{bmatrix}.}}\n$$\n\nTherefore, \n\n$$\n{r}_{11}+{r}_{13}+{r}_{23}=3+8+(-4)=7.\n$$"} {:db/id 17592186432329 :knowledge-point/_questions [{:db/id 17592186133798 :knowledge-point/id #uuid "19ae0632-68ac-5da9-8adf-cf71d5ecbc7c" :knowledge-point/title "Finding the QR Factorization of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f67c12-f06d-5443-9c63-0e245edcb8a5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id 17592186432281} {:answer/id #uuid "6baa4982-1a24-5642-9737-70e53742cc5e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186432296} {:answer/id #uuid "8dbb6cf7-0fa9-5dca-bc3c-da7fadfea2d6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id 17592186432301} {:answer/id #uuid "a86a94a2-9208-5170-9e77-a036ff3be9fc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186432305} {:answer/id #uuid "d63bd3dc-77da-5863-8a02-ddc20391b233" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id 17592186432311}] :answer-field/correct {:answer/id #uuid "8dbb6cf7-0fa9-5dca-bc3c-da7fadfea2d6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id 17592186432301} :answer-field/id #uuid "7ebc4500-ebb6-58bb-9b74-0082d64a7b1e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432322}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8825d6b3-93be-5a03-9cc7-5000a40034aa" :question/math-academy-id "q-41421" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-2 & 4 \\\\ 1 & 7 \\\\ -2 & 4\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{22}\\cdot {r}_{11}.$" :question/worked-solution "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-2 \\\\ 1 \\\\ -2\\end{bmatrix}.$\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}4 \\\\ 7 \\\\ 4\\end{bmatrix}-(-\\frac{9}{9})\\begin{bmatrix}-2 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 7 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 8 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{3}\\begin{bmatrix}-2 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{6\\sqrt{2}}\\begin{bmatrix}2 \\\\ 8 \\\\ 2\\end{bmatrix}=\\frac{1}{3\\sqrt{2}}\\begin{bmatrix}1 \\\\ 4 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}A \\\\  & =\\begin{bmatrix}-\\frac{2}{3} & \\frac{1}{3} & -\\frac{2}{3} \\\\ \\frac{1}{3\\sqrt{2}} & \\frac{4}{3\\sqrt{2}} & \\frac{1}{3\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}-2 & 4 \\\\ 1 & 7 \\\\ -2 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -3 \\\\ 0 & 6\\sqrt{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-2 & 4 \\\\ 1 & 7 \\\\ -2 & 4\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}-\\frac{2}{3} & \\frac{1}{3\\sqrt{2}} \\\\ \\frac{1}{3} & \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{2}{3} & \\frac{1}{3\\sqrt{2}}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}3 & -3 \\\\ 0 & 6\\sqrt{2}\\end{bmatrix}}}.\n$$\n\nFinally, ${q}_{22}\\cdot {r}_{11}=(\\frac{4}{3\\sqrt{2}})\\cdot (3)=\\frac{4}{\\sqrt{2}}=2\\sqrt{2}.$"} {:db/id 17592186432330 :knowledge-point/_questions [{:db/id 17592186133863 :knowledge-point/id #uuid "1ed5119c-5ce8-52dc-bd57-f9439ea199e6" :knowledge-point/title "Finding a QR Factorization of a Matrix Given a Matrix With Orthogonal Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4900a2e7-4ec1-5045-a690-39e44e6c099b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id 17592186432286} {:answer/id #uuid "4ed122b1-a8ef-54bc-a477-491273558134" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186432288} {:answer/id #uuid "4edcb67b-0b50-5e1a-880f-c692e26158f7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186432289} {:answer/id #uuid "988c19f4-4b4b-5658-b6a9-5508c8ebffd9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186432303} {:answer/id #uuid "a409649e-ea5b-5f5d-997d-61959f000b9a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186432304}] :answer-field/correct {:answer/id #uuid "988c19f4-4b4b-5658-b6a9-5508c8ebffd9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186432303} :answer-field/id #uuid "039c8e12-c757-5b90-a48b-67f394056d16" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432317}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "946d71c0-c7c2-59d9-aaa7-5ecb48201289" :question/math-academy-id "q-96015" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & -3 \\\\ 1 & 2 \\\\ 1 & 1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${a}_{1},{a}_{2}$ of $A$ are orthogonal, and that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained by normalizing the columns of $A,$ what is the value of ${q}_{21}\\cdot {r}_{11}?$" :question/worked-solution "Since the columns of $A$ are already orthogonal, to construct an orthogonal matrix $Q,$ we simply normalize ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{a}_{1}}{‖{a}_{1}‖}=\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{a}_{2}}{‖{a}_{2}‖}=\\frac{1}{\\sqrt{14}}\\begin{bmatrix}-3 \\\\ 2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of $A=QR$ by ${Q}^{T},$ we obtain\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ -\\frac{3}{\\sqrt{14}} & \\frac{2}{\\sqrt{14}} & \\frac{1}{\\sqrt{14}}\\end{bmatrix}\\begin{bmatrix}1 & -3 \\\\ 1 & 2 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{3} & 0 \\\\ 0 & \\sqrt{14}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & -3 \\\\ 1 & 2 \\\\ 1 & 1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & -\\frac{3}{\\sqrt{14}} \\\\ \\frac{1}{\\sqrt{3}} & \\frac{2}{\\sqrt{14}} \\\\ \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{14}}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}\\sqrt{3} & 0 \\\\ 0 & \\sqrt{14}\\end{bmatrix}}}\n$$\n\nFinally, ${q}_{21}\\cdot {r}_{11}=\\frac{1}{\\sqrt{3}}\\cdot \\sqrt{3}=1.$"} {:db/id 17592186432334 :knowledge-point/_questions [{:db/id 17592186133821 :knowledge-point/id #uuid "cd18abf3-b551-55d6-a573-690745a65b3e" :knowledge-point/title "Finding a QR Factorization of a Matrix Given an Orthogonal Basis in Terms of the Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f77c16-15f2-5876-91ea-1f42c2f49146" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186432273} {:answer/id #uuid "040cb4ad-6adb-5b45-a356-8c24b8b87c5f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186432274} {:answer/id #uuid "589b7138-e564-53cf-b058-e2dd1efd855b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186432290} {:answer/id #uuid "6d46eee3-4e02-5798-955c-810b16c0b207" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186432297} {:answer/id #uuid "e88e24de-26c6-5e79-8da5-47c1a175c8d5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186432312}] :answer-field/correct {:answer/id #uuid "040cb4ad-6adb-5b45-a356-8c24b8b87c5f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186432274} :answer-field/id #uuid "ed11c1c1-5852-58e2-a3f1-e49b2bb10b4b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432325}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5f7e59e-edf4-549f-aea0-27ed8989142e" :question/math-academy-id "q-140901" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ \\frac{{v}_{1}}{‖{v}_{1}‖} & \\frac{{v}_{2}}{‖{v}_{2}‖} & \\frac{{v}_{3}}{‖{v}_{3}‖} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above, where $\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set of vectors. You're given that $‖{v}_{1}‖=1,$ $‖{v}_{2}‖=2,$ $‖{v}_{3}‖=3,$ and that the system of equations below describes the relationship between the columns of $Q$ and the columns of $A.$ \n\n$$\n\\left\\{\\begin{aligned}{v}_{1} &={a}_{1} \\\\ {v}_{2} &={a}_{2}-{v}_{1} \\\\ {v}_{3} &={a}_{3}-2{v}_{2}+{v}_{1}\\end{aligned}\\right.\n$$\n\nWhat is the value of ${r}_{11}+{r}_{13}+{r}_{33}?$" :question/worked-solution "First, we normalize the vectors ${v}_{1},{v}_{2},{v}_{3}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{{v}_{1}}{1}\\,⟹\\,{v}_{1}={q}_{1} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{{v}_{2}}{2}\\,⟹\\,{v}_{2}=2{q}_{2} \\\\ {q}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{{v}_{3}}{3}\\,⟹\\,{v}_{3}=3{q}_{3}.\\end{aligned}\n$$\n\nNow, the set $\\{{q}_{1},{q}_{2},{q}_{3}\\}$ will be both orthogonal and normalized.\n\nNext, let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\left\\{\\begin{aligned}{v}_{1} &={a}_{1} \\\\ {v}_{2} &={a}_{2}-{v}_{1} \\\\ {v}_{3} &={a}_{3}-2{v}_{2}+{v}_{1}\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{a}_{1} &={v}_{1}={q}_{1} \\\\ {a}_{2} &={v}_{1}+{v}_{2}={q}_{1}+2{q}_{2} \\\\ {a}_{3} &=-{v}_{1}+2{v}_{2}+{v}_{3}=-{q}_{1}+4{q}_{2}+3{q}_{3}\\end{aligned}\\right.\n$$\n\nThe final system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}1 & 1 & -1 \\\\ 0 & 2 & 4 \\\\ 0 & 0 & 3\\end{bmatrix}}}\n$$\n\nTherefore, \n\n$$\n{r}_{11}+{r}_{13}+{r}_{33}=1+(-1)+3=3.\n$$"} {:db/id 17592186432370 :knowledge-point/_questions [{:db/id 17592186198434 :knowledge-point/id #uuid "e74c46c7-7f57-5adc-8acb-ea91958d8725" :knowledge-point/title "Finding a Quadratic Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0bff6f-0cba-576c-986b-08ab8bbdc390" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id 17592186432335} {:answer/id #uuid "0da91aa6-2f40-536a-ae00-3ee7ffd4d87d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id 17592186432336} {:answer/id #uuid "17de138d-5e8b-560d-a4fa-4ed404c20064" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186432339} {:answer/id #uuid "b80b9899-ed0c-5836-8d4e-76d835d659d5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186432357} {:answer/id #uuid "f54a1bd4-2b10-5f30-98be-179b2644a368" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id 17592186432362}] :answer-field/correct {:answer/id #uuid "f54a1bd4-2b10-5f30-98be-179b2644a368" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id 17592186432362} :answer-field/id #uuid "2d4a3f01-2b0d-5796-9a90-ab6144e4423d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432365}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "046315b8-b9f7-5255-a5f6-6b97504a6e58" :question/math-academy-id "q-163094" :question/problem "For the function of two variables \n$f(x,y)=2\\sqrt{x+y+1},$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=2+ax+by-\\frac{1}{4}{x}^{2}+cxy-\\frac{1}{4}{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =2.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{1}{\\sqrt{x+y+1}}, & \\,{f}_{y}(x,y) & =\\frac{1}{\\sqrt{x+y+1}} \\\\ {f}_{x}(0,0) & =1, & \\,{f}_{y}(0,0) & =1\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =-\\frac{1}{2\\sqrt{(x+y+1)^{3}}}, & \\,{f}_{xx}(0,0) & =-\\frac{1}{2} \\\\ {f}_{xy}(x,y) & =-\\frac{1}{2\\sqrt{(x+y+1)^{3}}}, & \\,{f}_{xy}(0,0) & =-\\frac{1}{2} \\\\ {f}_{yy}(x,y) & =-\\frac{1}{2\\sqrt{(x+y+1)^{3}}}, & \\,{f}_{yy}(0,0) & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈2+1\\cdot x+1\\cdot y+\\frac{1}{2}(-\\frac{1}{2}\\cdot {x}^{2}+2(-\\frac{1}{2})\\cdot xy+(-\\frac{1}{2})\\cdot {y}^{2}) \\\\  & =2+1x+1y-\\frac{1}{4}{x}^{2}+(-\\frac{1}{2})xy-\\frac{1}{4}{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=1+1-\\frac{1}{2}=\\frac{3}{2}.\n$$"} {:db/id 17592186432374 :knowledge-point/_questions [{:db/id 17592186198434 :knowledge-point/id #uuid "e74c46c7-7f57-5adc-8acb-ea91958d8725" :knowledge-point/title "Finding a Quadratic Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b8dc7b-9ca0-57e4-95cf-ce295303bd77" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186432337} {:answer/id #uuid "426ee39a-6753-5cfc-b697-f79544216277" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186432344} {:answer/id #uuid "614bbaef-7919-554f-80d5-216b1c9e41ad" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186432349} {:answer/id #uuid "976864ab-946d-5ed5-a93b-3f163e2eea69" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186432352} {:answer/id #uuid "f88f206b-7ef5-5e41-82c9-dd42ea25469f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186432363}] :answer-field/correct {:answer/id #uuid "f88f206b-7ef5-5e41-82c9-dd42ea25469f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186432363} :answer-field/id #uuid "d6d73795-71d5-5b5f-aef4-f1f6186ed7de" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432369}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f2c36de6-e7f2-52de-808d-79c266cdf722" :question/math-academy-id "q-163109" :question/problem "For the function of two variables \n$f(x,y)=\\frac{1}{x+y+1},$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=1+ax-y+{x}^{2}+bxy+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =-\\frac{1}{(x+y+1)^{2}}, & \\,{f}_{y}(x,y) & =-\\frac{1}{(x+y+1)^{2}} \\\\ {f}_{x}(0,0) & =-1, & \\,{f}_{y}(0,0) & =-1\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =\\frac{2}{(x+y+1)^{3}}, & \\,{f}_{xx}(0,0) & =2 \\\\ {f}_{xy}(x,y) & =\\frac{2}{(x+y+1)^{3}}, & \\,{f}_{xy}(0,0) & =2 \\\\ {f}_{yy}(x,y) & =\\frac{2}{(x+y+1)^{3}}, & \\,{f}_{yy}(0,0) & =2\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+(-1)\\cdot x+(-1)\\cdot y+\\frac{1}{2}(2\\cdot {x}^{2}+2(2)\\cdot xy+2\\cdot {y}^{2}) \\\\  & =1+(-1)x-y+{x}^{2}+2xy+1{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=-1+2+1=2.\n$$"} {:db/id 17592186433715 :knowledge-point/_questions [{:db/id 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3776bd7-7901-5119-8781-5fa760852de9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186474248} {:answer/id #uuid "34be4cdd-980d-5cf7-afb5-69444aae9cf2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186474249}] :answer-field/correct {:answer/id #uuid "b3776bd7-7901-5119-8781-5fa760852de9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186474248} :answer-field/id #uuid "6957b9f5-0c7f-5370-ba38-a21eb5e797aa" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186475050} {:answer-field/choices [{:answer/id #uuid "3467e4a5-c790-515b-90e9-e9524b6b5643" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186474250} {:answer/id #uuid "b70cee36-191b-582b-b0d3-c85411adf943" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186474251}] :answer-field/correct {:answer/id #uuid "3467e4a5-c790-515b-90e9-e9524b6b5643" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186474250} :answer-field/id #uuid "d6d9e9f8-9da1-55b6-8112-a9793448ac85" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186475051} {:answer-field/choices [{:answer/id #uuid "95bccbcb-3a47-5abe-9fa0-82e49506d42a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186474252} {:answer/id #uuid "270c3557-fa11-5a21-934d-4213ed1483bd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186474253}] :answer-field/correct {:answer/id #uuid "270c3557-fa11-5a21-934d-4213ed1483bd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186474253} :answer-field/id #uuid "0801da56-074b-503c-9458-9eeace399eb8" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186475052}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72a34fdf-b3e5-500c-96f3-76e3e66d1191" :question/math-academy-id "q-109572" :question/problem "$$\nA=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{bmatrix}-2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}={{\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}}_{⏟}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A-2I:$\n\n$$\n(A-2I)x=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{⏟}}_{w}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}}_{⏟}}_{x}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"III only.\""} {:db/id 17592186433716 :knowledge-point/_questions [{:db/id 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a59325-3ce6-5d72-900a-a6549e6f35ac" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453270} {:answer/id #uuid "63399f97-f600-5b4d-9277-9004f25d5b6c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453271}] :answer-field/correct {:answer/id #uuid "63399f97-f600-5b4d-9277-9004f25d5b6c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453271} :answer-field/id #uuid "fb03ed9d-b3dd-5132-bfbe-ccb2df04fee2" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454385} {:answer-field/choices [{:answer/id #uuid "e287c0dd-d035-550b-872f-c7e895e3bec9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453272} {:answer/id #uuid "1b26befe-fc8e-5235-b353-9ac88f6dbda5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453273}] :answer-field/correct {:answer/id #uuid "e287c0dd-d035-550b-872f-c7e895e3bec9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453272} :answer-field/id #uuid "fa43db2a-05ff-5509-a48a-142c9a76be13" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454386} {:answer-field/choices [{:answer/id #uuid "8d868348-18f3-58da-a6ed-45e73067cd1f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453274} {:answer/id #uuid "3e88ff03-d431-5fab-aefd-9a60f1450262" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453275}] :answer-field/correct {:answer/id #uuid "8d868348-18f3-58da-a6ed-45e73067cd1f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453274} :answer-field/id #uuid "78734bd9-b0b4-5000-8278-6ecd43210da2" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454387}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93f4dbff-c62f-571f-9c49-e5503854925a" :question/math-academy-id "q-109518" :question/problem "$$\nA=\\begin{bmatrix}3 & -1 \\\\ 4 & -1\\end{bmatrix},\\,v=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\n- **II.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\n- **III.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =1$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-I:$\n\n$$\nA-I=\\begin{bmatrix}3 & -1 \\\\ 4 & -1\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-I:$\n\n$$\n(A-I)v=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-I:$\n\n$$\n(A-I)w=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{A-I\\,}{\\to }{{\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}}_{⏟}}_{w}\\overset{A-I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A-I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A.$*\n\nSo, the correct answer is \"I only.\""} {:db/id 17592186433717 :knowledge-point/_questions [{:db/id 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f449b2-97f3-5186-9bd0-39c537f7db13" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453258} {:answer/id #uuid "54696726-fb68-57c0-87f4-c1694ab455cd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453259}] :answer-field/correct {:answer/id #uuid "18f449b2-97f3-5186-9bd0-39c537f7db13" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453258} :answer-field/id #uuid "bd1d85c6-553b-53a4-ae23-7dde028774d2" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454379} {:answer-field/choices [{:answer/id #uuid "7e95d9b3-3929-5758-b2da-baceb16ae7ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453260} {:answer/id #uuid "17170d1b-c8fc-5d71-914c-a2fc83b964c9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453261}] :answer-field/correct {:answer/id #uuid "17170d1b-c8fc-5d71-914c-a2fc83b964c9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453261} :answer-field/id #uuid "383e95fb-9e75-52f9-b9dc-633a9fc9d7e7" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454380} {:answer-field/choices [{:answer/id #uuid "1da26d3c-84b5-5484-b149-e445d8e96bd6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453262} {:answer/id #uuid "7d6fbae8-8f80-5d45-a5a9-59b416b697f4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453263}] :answer-field/correct {:answer/id #uuid "1da26d3c-84b5-5484-b149-e445d8e96bd6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453262} :answer-field/id #uuid "f5175e83-6e25-5458-92b9-9cb792d53159" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454381}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3d67809-78b0-59dc-9828-ea082eca69bb" :question/math-academy-id "q-109476" :question/problem "$$\nA=\\begin{bmatrix}-2 & 1 \\\\ -1 & 0\\end{bmatrix},\\,v=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **II.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **III.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=\\begin{bmatrix}-2 & 1 \\\\ -1 & 0\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{A+I\\,}{\\to }{{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{⏟}}_{w}\\overset{A+I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is \"II only.\""} {:db/id 17592186433718 :knowledge-point/_questions [{:db/id 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41150d82-d7e7-5d1b-9511-2a172cd9b18f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453264} {:answer/id #uuid "b718a973-f38a-5035-869e-48e4b419ff1a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453265}] :answer-field/correct {:answer/id #uuid "b718a973-f38a-5035-869e-48e4b419ff1a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453265} :answer-field/id #uuid "ae0413b7-8327-5a24-870c-2079b9d12010" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454382} {:answer-field/choices [{:answer/id #uuid "4f23e036-9539-557b-a5b3-9d3a82621232" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453266} {:answer/id #uuid "41f4de42-fb54-53fa-9a8d-2338942ae501" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453267}] :answer-field/correct {:answer/id #uuid "4f23e036-9539-557b-a5b3-9d3a82621232" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453266} :answer-field/id #uuid "f297c7e5-5df0-59e8-9f0a-749e59ee56d6" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454383} {:answer-field/choices [{:answer/id #uuid "0bb3db82-5aae-5e9e-9a87-27b9cef5d582" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453268} {:answer/id #uuid "7ae4e359-d368-5e98-b9be-49032667862f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186453269}] :answer-field/correct {:answer/id #uuid "0bb3db82-5aae-5e9e-9a87-27b9cef5d582" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186453268} :answer-field/id #uuid "ddde4964-61ba-58e1-b946-d0bdaa59754b" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186454384}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab77c5c3-a1c5-5710-a08d-82e66f9fdecd" :question/math-academy-id "q-109488" :question/problem "$$\nA=\\begin{bmatrix}3 & -8 \\\\ 2 & -5\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **II.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **III.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=\\begin{bmatrix}3 & -8 \\\\ 2 & -5\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}4 & -8 \\\\ 2 & -4\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=\\begin{bmatrix}4 & -8 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}={{\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=\\begin{bmatrix}4 & -8 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}}_{⏟}}_{v}\\overset{A+I\\,}{\\to }{{\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}}_{⏟}}_{w}\\overset{A+I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is \"I only.\""} {:db/id 17592186435082 :knowledge-point/_questions [{:db/id 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec2e130-ad0b-5d90-874b-cafee34e58c7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186435066} {:answer/id #uuid "6bf5a0c1-0205-502f-9cbc-8cd0d9139fcc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id 17592186435067} {:answer/id #uuid "a0d4331d-d76a-550e-af61-65f77866dcfa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186435069} {:answer/id #uuid "d090baef-9223-53ba-b7a5-e64a993a1878" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id 17592186435074} {:answer/id #uuid "dcc4abca-dbd0-5a8c-8460-f14372be7eed" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186435075}] :answer-field/correct {:answer/id #uuid "a0d4331d-d76a-550e-af61-65f77866dcfa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186435069} :answer-field/id #uuid "3d3eb90b-b341-501f-a49e-f9c67d7e1ee8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435078}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fba38d94-94f1-5e40-9342-c81f8eabc355" :question/math-academy-id "q-124296" :question/problem "The matrix form of the affine transformation\n\n$$\nx=6u+4v+2,\\,y=5v-1\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6 & a \\\\ 0 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6u+4v+2 \\\\ 5v-1\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}6u+4v+2 \\\\ 5v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6u+4v \\\\ 5v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}6 & 4 \\\\ 0 & 5\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=4+5+(-1)=8.\n$$"} {:db/id 17592186435169 :knowledge-point/_questions [{:db/id 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c225a4-fa6b-5ff4-a3be-9440301a14e4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186435157} {:answer/id #uuid "99696a64-81b6-56b3-ae94-3cf2f2bf032d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186435159} {:answer/id #uuid "b2f12e59-3811-5fbe-a8bd-eda4370e2e83" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186435161} {:answer/id #uuid "c4beb685-88bd-5864-8597-0ef45eddb0b6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186435162} {:answer/id #uuid "d78bfad4-b673-5a93-bb2a-0e0334cd3321" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186435164}] :answer-field/correct {:answer/id #uuid "b2f12e59-3811-5fbe-a8bd-eda4370e2e83" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186435161} :answer-field/id #uuid "29e8d3c2-d32c-5baa-954b-7b5d1efc7457" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435166}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f1617b1-29a0-58b4-80d3-cf8ca8d2090f" :question/math-academy-id "q-124288" :question/problem "The matrix form of the affine transformation\n\n$$\nx=2u+5v,\\,y=u-3v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2 & 5 \\\\ a & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 & 5 \\\\ 1 & -3\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+(-3)+0=-2.\n$$"} {:db/id 17592186435170 :knowledge-point/_questions [{:db/id 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e78d75-7cc9-5f8f-a311-f9561d084ef0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186435151} {:answer/id #uuid "5cbd50d4-87c1-52b7-9640-b711a0fd95b4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186435153} {:answer/id #uuid "66027fe1-2bba-5e05-8206-4ca92bebfb97" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186435155} {:answer/id #uuid "7df97388-6b5d-5314-a0e2-f9db5b72c685" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186435156} {:answer/id #uuid "9e8c9a39-bea2-5dc9-ae9f-054f40df79f8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186435160}] :answer-field/correct {:answer/id #uuid "66027fe1-2bba-5e05-8206-4ca92bebfb97" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186435155} :answer-field/id #uuid "9adca1c4-5980-5cfc-b795-52fbb2b1c569" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435168}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "924019d9-3882-5c74-a8d2-1e7c35a68ea0" :question/math-academy-id "q-124260" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+a,\\,y=6u+bv+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 & 0 \\\\ 6 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}4 & 0 \\\\ 6 & 2\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}4u \\\\ 6u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u \\\\ 6u+2v-1\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+0,\\,y=6u+2v+(-1)\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+2+(-1)=1.\n$$"} {:db/id 17592186435171 :knowledge-point/_questions [{:db/id 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5023974e-65e9-50b5-9103-6472584bc9df" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186435152} {:answer/id #uuid "606c1e22-4819-56b5-82a2-48e43550b035" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186435154} {:answer/id #uuid "88148730-01ef-5f8f-8698-d5c0f9002897" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id 17592186435158} {:answer/id #uuid "d60c5735-4076-5c3e-b98e-aa72880ddf6c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186435163} {:answer/id #uuid "eeb2f54f-b084-5556-a569-1423fbe14b78" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186435165}] :answer-field/correct {:answer/id #uuid "606c1e22-4819-56b5-82a2-48e43550b035" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186435154} :answer-field/id #uuid "8859ffa2-d430-5120-8081-1bbcdaf58a41" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435167}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abc616ba-5b7e-5285-91c7-65fdcb2a91f9" :question/math-academy-id "q-124299" :question/problem "The matrix form of the affine transformation\n\n$$\nx=v-7u,\\,y=2v-u\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & 1 \\\\ -1 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}c \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}v-7u \\\\ 2v-u\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v-7u \\\\ 2v-u\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7u+v \\\\ -u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-7 & 1 \\\\ -1 & 2\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-7+2+0=-5.\n$$"} {:db/id 17592186435356 :knowledge-point/_questions [{:db/id 17592186152156 :knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57" :knowledge-point/title "Determining Whether a Given Set Is a Basis of the Column Space of a Matrix With Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b8e580-edc8-57a8-b01e-01e177a8c4eb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{{}{q}_{1},{q}_{2}\\text{}}$ is not a basis of $\\text{Col}(Q)$" :db/id 17592186435339} {:answer/id #uuid "800a48a9-9c02-5438-b96a-f2934f0e64ff" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186435343} {:answer/id #uuid "a5f24190-96d7-56af-99e3-7da09662cbef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186435345} {:answer/id #uuid "b957c467-48e4-50a9-8e67-62d1cba44eb0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186435346} {:answer/id #uuid "d03aa2b6-723a-580d-96c6-6d6143f5eed1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186435349}] :answer-field/correct {:answer/id #uuid "d03aa2b6-723a-580d-96c6-6d6143f5eed1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186435349} :answer-field/id #uuid "cb94596e-e304-53f4-bc22-e71a468af9b5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435355}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60c7ad14-43d6-5b2c-81c2-60bb8c562302" :question/math-academy-id "q-75086" :question/problem "The matrix $Q$ is given below. Let ${q}_{1}$, ${q}_{2}$, and ${q}_{3}$ be the respective columns of $Q.$ Determine if $B=\\text{{}{q}_{1},{q}_{2}\\text{}}$ is a basis of $\\text{Col}(Q).$ If that is the case, find ${x}_{1}\\cdot {x}_{2}$, where ${q}_{3}={x}_{1}{q}_{1}+{x}_{2}{q}_{2}.$\n\n$$\nQ=\\begin{bmatrix}1 & 2 & 8 \\\\ -3 & 2 & 0\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $Q$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}Q & =\\begin{bmatrix}1 & 2 & 8 \\\\ -3 & 2 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 8 \\\\ 0 & 8 & 24\\end{bmatrix} & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 8 \\\\ 0 & 1 & 3\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(Q)$ is $\\{{q}_{1},{q}_{2}\\},$ that is to say,\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ -3\\end{bmatrix},\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}\\}.\n$$\n\nNow, since the $3$rd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${q}_{3}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n{{\\begin{bmatrix}8 \\\\ 0\\end{bmatrix}}_{⏟}}_{{q}_{3}}={{(2)}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}}_{⏟}}_{{q}_{1}}+{{(3)}_{⏟}}_{{x}_{2}}\\cdot {{\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}}_{⏟}}_{{q}_{2}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{2}=2\\cdot 3=6.$"} {:db/id 17592186435357 :knowledge-point/_questions [{:db/id 17592186152157 :knowledge-point/id #uuid "c3bf9ea3-d57f-53f6-aa3c-eddffe1a8cfa" :knowledge-point/title "Determining Whether a Given Set Is a Basis of the Column Space of a Matrix For a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "315c6787-f3bc-5e6e-bdcb-6d78095bb123" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186435338} {:answer/id #uuid "612c5c3b-95fd-52c6-a151-811571010141" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186435340} {:answer/id #uuid "94c3ca60-1353-5c71-9bd6-ef45000aa252" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{{}{q}_{1},{q}_{2}\\text{}}$ is not a basis of $\\text{Col}(Q)$" :db/id 17592186435344} {:answer/id #uuid "cf51753e-b6ac-559a-ad9c-66039a8a9add" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id 17592186435348} {:answer/id #uuid "eea40607-ee99-56d6-947f-6682803c1995" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id 17592186435351}] :answer-field/correct {:answer/id #uuid "cf51753e-b6ac-559a-ad9c-66039a8a9add" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id 17592186435348} :answer-field/id #uuid "b907d018-142f-5462-80e8-8d2315836224" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435354}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8e2ef874-d6ff-53a7-81b2-d096ed751911" :question/math-academy-id "q-75090" :question/problem "The matrix $Q$ is given below. Let ${q}_{1}$, ${q}_{2}$,  ${q}_{3}$, and ${q}_{4}$ be the respective columns of $Q.$ Determine if $B=\\text{{}{q}_{1},{q}_{2}\\text{}}$ is a basis of $\\text{Col}(Q).$ If that is the case, find ${x}_{1}\\cdot {x}_{2}$, where ${q}_{4}={x}_{1}{q}_{1}+{x}_{2}{q}_{2}.$\n\n$$\nQ=\\begin{bmatrix}4 & 1 & -2 & 4 \\\\ 0 & 4 & 2 & 4 \\\\ 0 & 2 & 1 & 2\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $Q$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}Q & =\\begin{bmatrix}4 & 1 & -2 & 4 \\\\ 0 & 4 & 2 & 4 \\\\ 0 & 2 & 1 & 2\\end{bmatrix} & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼\\begin{bmatrix}4 & 1 & -2 & 4 \\\\ 0 & 1 & \\frac{1}{2} & 1 \\\\ 0 & 2 & 1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}4 & 1 & -2 & 4 \\\\ 0 & 1 & \\frac{1}{2} & 1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}4 & 0 & -\\frac{5}{2} & 3 \\\\ 0 & 1 & \\frac{1}{2} & 1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & -\\frac{5}{8} & \\frac{3}{4} \\\\ 0 & 1 & \\frac{1}{2} & 1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(Q)$ is $\\{{q}_{1},{q}_{2}\\},$ that is to say,\n\n$$\nB=\\{\\begin{bmatrix}4 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}\\}.\n$$\n\nNow, since the $4$th column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${q}_{4}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n{{\\begin{bmatrix}4 \\\\ 4 \\\\ 2\\end{bmatrix}}_{⏟}}_{{q}_{4}}={{(\\frac{3}{4})}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}4 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{{q}_{1}}+{{(1)}_{⏟}}_{{x}_{2}}\\cdot {{\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}}_{⏟}}_{{q}_{2}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{2}=\\frac{3}{4}\\cdot 1=\\frac{3}{4}.$"} {:db/id 17592186435358 :knowledge-point/_questions [{:db/id 17592186152156 :knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57" :knowledge-point/title "Determining Whether a Given Set Is a Basis of the Column Space of a Matrix With Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b6ec014-b8b5-54e4-afed-992fa3dc7a1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186435341} {:answer/id #uuid "6e1b53c1-ec77-5c04-b63c-840ca6b8f47c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186435342} {:answer/id #uuid "c8fea29c-c9e0-5b67-ad2c-4468094390b0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186435347} {:answer/id #uuid "d5ca56d3-8b84-5db8-bf22-dfca5d0b2dc8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186435350} {:answer/id #uuid "fcbd9c6b-04ff-51f2-a5d9-53f32e994e70" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{{}{w}_{1},{w}_{3}\\text{}}$ is not a basis of $\\text{Col}(W)$" :db/id 17592186435352}] :answer-field/correct {:answer/id #uuid "6b6ec014-b8b5-54e4-afed-992fa3dc7a1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186435341} :answer-field/id #uuid "04e36a7f-df04-5cc4-ac8b-3bafab471a3b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435353}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa6c549b-f344-52f9-9015-63f22befbecb" :question/math-academy-id "q-111501" :question/problem "The matrix $W$ is given below. Let ${w}_{1}$, ${w}_{2}$, and ${w}_{3}$ be the respective columns of $W.$\nDetermine if $B=\\text{{}{w}_{1},{w}_{3}\\text{}}$ is a basis of $\\text{Col}(W).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{3}$, where ${w}_{2}={x}_{1}{w}_{1}+{x}_{3}{w}_{3}.$\n\n$$\nW=\\begin{bmatrix}3 & -9 & 6 \\\\ -5 & 15 & 10\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $W$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}W & =\\begin{bmatrix}3 & -9 & 6 \\\\ -5 & 15 & 10\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ -5 & 15 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 20\\end{bmatrix} & {R}_{2} & :=\\frac{1}{20}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $3$rd columns. So, a basis of $\\text{Col}(W)$ is $\\{{w}_{1},{w}_{3}\\},$ that is to say,\n\n$$\nB=\\{\\begin{bmatrix}3 \\\\ -5\\end{bmatrix},\\begin{bmatrix}6 \\\\ 10\\end{bmatrix}\\}.\n$$\n\nNow, since the $2$nd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${w}_{2}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n{{\\begin{bmatrix}-9 \\\\ 15\\end{bmatrix}}_{⏟}}_{{w}_{2}}={{(-3)}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}3 \\\\ -5\\end{bmatrix}}_{⏟}}_{{w}_{1}}+{{(0)}_{⏟}}_{{x}_{3}}\\cdot {{\\begin{bmatrix}6 \\\\ 10\\end{bmatrix}}_{⏟}}_{{w}_{3}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{3}=(-3)\\cdot 0=0.$"} {:db/id 17592186435393 :knowledge-point/_questions [{:db/id 17592186157423 :knowledge-point/id #uuid "74c4234a-3aa1-5b6b-b68b-48e6aa2b0dfb" :knowledge-point/title "Finding the Second Derivative of a Function Given Its First Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eed068e-354b-5c24-8218-ac1367acc3ab" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\operatorname{sin}⁡x & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id 17592186435376} {:answer/id #uuid "35addae1-944d-5e96-bf7b-9d53283e50fa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\operatorname{cos}⁡x & y \\\\ y & 0\\end{bmatrix}" :db/id 17592186435378} {:answer/id #uuid "428be636-82c8-5886-b28a-43069f19e0f2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\operatorname{sin}⁡x & 1 \\\\ 1 & 2-\\operatorname{cos}⁡x\\end{bmatrix}" :db/id 17592186435380} {:answer/id #uuid "8923009c-c530-5063-8998-6977d181f503" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\operatorname{cos}⁡x & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id 17592186435384} {:answer/id #uuid "986935ae-ac9e-5393-98ba-0d529a02cf04" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\operatorname{sin}⁡x & 1 \\\\ 1 & 2\\end{bmatrix}" :db/id 17592186435385}] :answer-field/correct {:answer/id #uuid "986935ae-ac9e-5393-98ba-0d529a02cf04" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\operatorname{sin}⁡x & 1 \\\\ 1 & 2\\end{bmatrix}" :db/id 17592186435385} :answer-field/id #uuid "1e2c894b-e18f-5a60-9da4-9f38bca23df7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435391}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a68b0724-2e6f-5527-bb88-98de4c797f20" :question/math-academy-id "q-81010" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)$ given that\n${f}^{′}(x,y)=\\begin{bmatrix}y-\\operatorname{cos}⁡x & x+2y\\end{bmatrix}$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=\\begin{bmatrix}y-\\operatorname{cos}⁡x & x+2y\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=y-\\operatorname{cos}⁡x,\\,\\frac{∂f}{∂y}=x+2y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(y-\\operatorname{cos}⁡x)=\\operatorname{sin}⁡x\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(x+2y)=1 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(y-\\operatorname{cos}⁡x)=1\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(x+2y)=2\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\operatorname{sin}⁡x & 1 \\\\ 1 & 2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186435394 :knowledge-point/_questions [{:db/id 17592186157423 :knowledge-point/id #uuid "74c4234a-3aa1-5b6b-b68b-48e6aa2b0dfb" :knowledge-point/title "Finding the Second Derivative of a Function Given Its First Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5dbce3-5eeb-5299-a81b-71b95b40a702" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & -2 \\\\ -2 & 2\\end{bmatrix}" :db/id 17592186435379} {:answer/id #uuid "533319f1-cf66-5e55-a50b-27c89a39ea11" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -2 \\\\ -2 & 2\\end{bmatrix}" :db/id 17592186435382} {:answer/id #uuid "afde4582-cdac-5bc3-b210-1397789ef534" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -4 \\\\ -4 & 2\\end{bmatrix}" :db/id 17592186435386} {:answer/id #uuid "ef6b5589-dee3-5358-89b2-bb7e5109233c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -2 \\\\ -2 & 2\\end{bmatrix}" :db/id 17592186435388} {:answer/id #uuid "f224da51-5558-5714-9c8e-ab71238f6195" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 4 \\\\ 4 & 2\\end{bmatrix}" :db/id 17592186435389}] :answer-field/correct {:answer/id #uuid "afde4582-cdac-5bc3-b210-1397789ef534" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -4 \\\\ -4 & 2\\end{bmatrix}" :db/id 17592186435386} :answer-field/id #uuid "0e0eb9da-e4d5-55d6-ad33-7db8760cccce" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435390}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d48bb18b-a23a-5640-ba69-c0db05f527bc" :question/math-academy-id "q-102452" :question/problem "Find ${f}^{″}(2,1)$ for the function $f(x,y)$ given that\n${f}^{′}(x,y)=\\begin{bmatrix}-2xy & 2y-{x}^{2}\\end{bmatrix}$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=\\begin{bmatrix}-2xy & 2y-{x}^{2}\\end{bmatrix},$ \n we must have\n\n$$\n\\frac{∂f}{∂x}=-2xy,\\,\\frac{∂f}{∂y}=2y-{x}^{2}.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(-2xy)=-2y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y-{x}^{2})=-2x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(-2xy)=-2x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y-{x}^{2})=2\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}-2y & -2x \\\\ -2x & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(2,1).$ This gives\n\n$$\n{f}^{″}(2,1)=\\begin{bmatrix}-2 & -4 \\\\ -4 & 2\\end{bmatrix}.\n$$"} {:db/id 17592186435395 :knowledge-point/_questions [{:db/id 17592186157424 :knowledge-point/id #uuid "037ff08b-3246-5eed-870b-b4951f319c96" :knowledge-point/title "Evaluating a Hessian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012e8862-6d84-5ca3-808d-e580b5b68412" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id 17592186435375} {:answer/id #uuid "1d97894b-06e8-5458-afce-3b6280583bcd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id 17592186435377} {:answer/id #uuid "49af7f88-d313-53b2-a836-26eef4f823e6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id 17592186435381} {:answer/id #uuid "6341ade3-f46e-594c-b2db-483df7d6f5cd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186435383} {:answer/id #uuid "e9393f5b-f485-5c2a-b52d-4ac15221029b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186435387}] :answer-field/correct {:answer/id #uuid "012e8862-6d84-5ca3-808d-e580b5b68412" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id 17592186435375} :answer-field/id #uuid "835cf471-5984-50ad-ac7a-5c92395f40c6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435392}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e525b492-a29a-585f-8c96-2055a51f2341" :question/math-academy-id "q-102686" :question/problem "Given that \n${f}^{′}(x,y)=\\begin{bmatrix}2x{y}^{2} & 2y{x}^{2}-1\\end{bmatrix},$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(1,-1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=\\begin{bmatrix}2x{y}^{2} & 2y{x}^{2}-1\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=2x{y}^{2},\\,\\frac{∂f}{∂y}=2y{x}^{2}-1.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y{x}^{2}-1)=4xy \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{y}^{2})=4xy\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y{x}^{2}-1)=2{x}^{2}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}2{y}^{2} & 4xy \\\\ 4xy & 2{x}^{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(1,-1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,-1)=\\begin{bmatrix}2 & -4 \\\\ -4 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(1,-1)=2\\cdot 2-(-4)\\cdot (-4)=-12.\n$$"} {:db/id 17592186435768 :knowledge-point/_questions [{:db/id 17592186119780 :knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74feda84-0372-5ba8-a03f-6504fdd43cb8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186435751} {:answer/id #uuid "81e999d9-b74a-531e-b396-75bcda8940a5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id 17592186435752} {:answer/id #uuid "a5465cc4-707e-5513-9c9b-2c4ccb77d7a1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id 17592186435754} {:answer/id #uuid "aee93a59-f631-5538-b707-3dbdac3a5bb0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id 17592186435757} {:answer/id #uuid "c2c0bd69-0ae8-5c67-b00c-53d8d88f988d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186435758}] :answer-field/correct {:answer/id #uuid "81e999d9-b74a-531e-b396-75bcda8940a5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id 17592186435752} :answer-field/id #uuid "ea1881ff-14ad-5797-8c35-e1990ea0829e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435766}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "788f9347-638e-5e07-bc97-727179291d72" :question/math-academy-id "q-130780" :question/problem "Given that \n$|\\begin{aligned}a & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|=3,$\nfind \n$|\\begin{aligned}a-2 & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a-2 & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| & =|\\begin{aligned}a-2 & b+0 & c+0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants and expanding the second determinant across the $1$st row, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}a-2 & b+0 & c+0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| & ={{|\\begin{aligned}a & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|}_{⏟}}_{3}+|\\begin{aligned}-2 & 0 & 0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =3-2(-1)^{1+1}|\\begin{aligned}5 & -1 \\\\ 1 & 1\\end{aligned}| \\\\  & =3-2\\cdot (5+1) \\\\  & =-9.\\end{aligned}\n$$"} {:db/id 17592186440392 :knowledge-point/_questions [{:db/id 17592186142780 :knowledge-point/id #uuid "34ea56b4-2066-5aaf-aea9-08515803fc0b" :knowledge-point/title "Evaluating an Expression With Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48840b8b-45fc-5af4-9eaf-3b0433653b29" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id 17592186440379}] :answer-field/correct {:answer/id #uuid "48840b8b-45fc-5af4-9eaf-3b0433653b29" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id 17592186440379} :answer-field/id #uuid "5349a1c7-9dd6-5f93-9b66-8b75dd18d825" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186440386}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02df687b-3c38-56ea-bcbb-7b6992abb8b8" :question/math-academy-id "q-134231" :question/problem "Matt and Andrea each bought $6$ ounces of salted peanuts and $4$ ounces of unsalted peanuts. In total, they bought$\\,${{field-1}}\n$\\,$ounces of peanuts." :question/worked-solution "We must write and evaluate an expression representing the total amount of peanuts.\n\nSince each of them bought $6$ ounces of salted peanuts and $4$ ounces of unsalted peanuts, the amount of peanuts they purchased, in ounces, is:\n\n$$\n{{6}_{⏟}}_{\\text{salted peanuts}}+{{4}_{⏟}}_{\\text{unsalted peanuts}}\n$$\n\nSince *each* person purchased this amount of peanuts, and there are $2$ people, we must multiply the amount of peanuts by $2.$ Therefore, the total amount of peanuts is:\n\n$$\n{{(6+4)}_{⏟}}_{\\text{each person}}\\times {{2}_{⏟}}_{\\text{people}}\n$$\n\nTo evaluate the expression, we follow the order of operations with parentheses.\n\nFirst, we perform the operations inside the parentheses:\n\n$$\n\\begin{aligned}(6+4)\\times 2 & =(6+4)\\times 2 \\\\  & =10\\times 2.\\end{aligned}\n$$\n\nNow, we multiply:\n\n$$\n10\\times 2=20\n$$"} {:db/id 17592186441352 :knowledge-point/_questions [{:db/id 17592186119793 :knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb42e2c-aa24-5f95-88b6-df41338ccd5f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186441322} {:answer/id #uuid "91f3cfba-511f-5a32-b5ed-37b88de9cce4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186441337} {:answer/id #uuid "94171c94-68a7-5ef2-aaba-7694ee1ad0d9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id 17592186441338} {:answer/id #uuid "c55e82fd-3868-524e-a176-4ae0eb02d2d1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186441343} {:answer/id #uuid "ef91d311-f5cd-5c1f-8b87-7a75202de12a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186441346}] :answer-field/correct {:answer/id #uuid "c55e82fd-3868-524e-a176-4ae0eb02d2d1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186441343} :answer-field/id #uuid "29b866c9-e8f1-5844-9f9f-7ff1d2ebf13b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186441347}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07a8a0f6-ff41-525d-a016-8184036d8c7d" :question/math-academy-id "q-32619" :question/problem "Given that $A=\\begin{bmatrix}2 & -3 \\\\ 8 & -12\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & -3 \\\\ 8 & -12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}.\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=4,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=4.$"} {:db/id 17592186441353 :knowledge-point/_questions [{:db/id 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f68716-0281-55f6-adea-b682838ac2b7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186441330} {:answer/id #uuid "73eed6d2-2a7a-5586-96c3-b4b57d716ee8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186441335} {:answer/id #uuid "85f1cd67-ccaa-5df2-b149-878d29a40002" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186441336} {:answer/id #uuid "95e30625-bcfc-5d55-98a0-5886f8f651fb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186441339} {:answer/id #uuid "a96911ae-7ad9-5ac1-b6d0-ca8ccdeddc8e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186441340}] :answer-field/correct {:answer/id #uuid "59f68716-0281-55f6-adea-b682838ac2b7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186441330} :answer-field/id #uuid "99b3cb96-646b-5a28-8673-dce2e304d7b9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186441350}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d565601-7981-50a3-bc57-df1008cb679e" :question/math-academy-id "q-106752" :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\nI. $A=\\begin{bmatrix}2 & -1 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}$\n\nII. $A=\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & -1\\end{bmatrix}$\n\nIII. $A=\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ 4 & 3\\end{bmatrix}$" :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nA=\\overset{L}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}}\\cdot \\overset{U}{\\overset{⏞}{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nA=\\begin{bmatrix}2 & -1 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}\\,\\times \n$$\n\n- The second product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & -1\\end{bmatrix}\\,✓\n$$\n\n- The third product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal.\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ 4 & 3\\end{bmatrix}\\,\\times \n$$\n\nTherefore, the correct answer is \"II only\"."} {:db/id 17592186441354 :knowledge-point/_questions [{:db/id 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f014fff-e379-5421-b2b4-49d5a54f23a1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186441326} {:answer/id #uuid "48377761-7467-51b7-97c9-f6247717ea78" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186441327} {:answer/id #uuid "5cd73843-fd8e-5e43-8c1d-d6377ae8623a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186441331} {:answer/id #uuid "6a875e35-4a03-5b66-9640-19be64465b55" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186441333} {:answer/id #uuid "bffe5c32-5854-51db-b8f4-05b3f68585e1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186441342}] :answer-field/correct {:answer/id #uuid "bffe5c32-5854-51db-b8f4-05b3f68585e1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186441342} :answer-field/id #uuid "5a6784eb-df62-5231-a320-70204c921944" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186441349}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73ab53ad-67cd-53a7-b27f-c766bd840711" :question/math-academy-id "q-75115" :question/problem "Which of the following products is the LU factorization of a matrix $B?$\n\nI. $B=\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}2 & 5 \\\\ 1 & 0\\end{bmatrix}$\n\nII. $B=\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}10 & 20 \\\\ 0 & 10\\end{bmatrix}$\n\nIII. $B=\\begin{bmatrix}3 & 3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}$" :question/worked-solution "Remember that in the LU factorization of a matrix $B,$ we write $B=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nB=\\overset{L}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}}\\cdot \\overset{U}{\\overset{⏞}{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal.\n\n$$\nB=\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}2 & 5 \\\\ 1 & 0\\end{bmatrix}\\,\\times \n$$\n\n- The second product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nB=\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}10 & 20 \\\\ 0 & 10\\end{bmatrix}\\,✓\n$$\n\n- The third product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nB=\\begin{bmatrix}3 & 3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}\\,\\times \n$$\n\nTherefore, the correct answer is \"II only\"."} {:db/id 17592186441355 :knowledge-point/_questions [{:db/id 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "289d8b11-5b33-5df3-83e4-bfbab449cfa4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186441324} {:answer/id #uuid "374fcecf-456e-59e1-810b-f5c42633df35" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186441325} {:answer/id #uuid "55cc3f2d-2c9d-518f-83cf-c0d0c9b25d1f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186441329} {:answer/id #uuid "64d9eef5-56f0-5943-8389-0af8adc56d25" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186441332} {:answer/id #uuid "d54070f0-d20a-5ea6-aa9b-5964baf98a82" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186441345}] :answer-field/correct {:answer/id #uuid "d54070f0-d20a-5ea6-aa9b-5964baf98a82" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186441345} :answer-field/id #uuid "407f9dd1-cf10-5a35-8a2f-095674048c4c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186441348}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cd9aa05-4a21-5975-bf09-f09975b43169" :question/math-academy-id "q-32611" :question/problem "Which of the following products is the LU factorization of a matrix $B?$\n\nI. $B=\\begin{bmatrix}12 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}11 & 17 \\\\ 0 & 1\\end{bmatrix}$\n\nII. $B=\\begin{bmatrix}1 & 0 \\\\ 12 & 1\\end{bmatrix}\\begin{bmatrix}11 & 17 \\\\ 0 & 1\\end{bmatrix}$\n\nIII. $B=\\begin{bmatrix}11 & 17 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}$" :question/worked-solution "Remember that in the LU factorization of a matrix $B,$ we write $B=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nB=\\overset{L}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ ∗ & 1\\end{bmatrix}}}\\cdot \\overset{U}{\\overset{⏞}{\\begin{bmatrix}∗ & ∗ \\\\ 0 & ∗\\end{bmatrix}}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form because  the matrix on the left is not a unit lower triangular matrix, as its main diagonal contains numbers different from $1.$\n\n$$\nB=\\begin{bmatrix}12 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}11 & 17 \\\\ 0 & 1\\end{bmatrix}\\,\\times \n$$\n\n- The second product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nB=\\begin{bmatrix}1 & 0 \\\\ 12 & 1\\end{bmatrix}\\begin{bmatrix}11 & 17 \\\\ 0 & 1\\end{bmatrix}\\,✓\n$$\n\n- The third product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nB=\\begin{bmatrix}11 & 17 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\,\\times \n$$\n\nTherefore, the correct answer is \"II only\"."} {:db/id 17592186441356 :knowledge-point/_questions [{:db/id 17592186119793 :knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "238ca86a-9d68-5724-a14e-22dd68af5c77" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id 17592186441323} {:answer/id #uuid "4c31da62-609b-5d8a-8854-0a6fa3314fc7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186441328} {:answer/id #uuid "6c9c5aa7-a098-5b4d-b132-40b681368c9f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186441334} {:answer/id #uuid "af51841d-a19a-5772-9383-ea7b8a9aa1a3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186441341} {:answer/id #uuid "d4df948f-38dc-5e81-b2b2-2938f23c6e53" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186441344}] :answer-field/correct {:answer/id #uuid "af51841d-a19a-5772-9383-ea7b8a9aa1a3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186441341} :answer-field/id #uuid "a0f52f38-93c1-5335-86f8-ba552718ba99" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186441351}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a069a9c2-f0e9-5f4e-8079-7e889bf03a9b" :question/math-academy-id "q-106772" :question/problem "Given that\n$A=\\begin{bmatrix}-4 & 3 \\\\ -20 & 15\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-4 & 3 \\\\ -20 & 15\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-4 & 3 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-4 & 3 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=5,$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=5.$"} {:db/id 17592186442429 :knowledge-point/_questions [{:db/id 17592186179822 :knowledge-point/id #uuid "33b32ea7-dd7d-5e41-8fdb-142ec9da82c8" :knowledge-point/title "Multiplying More Than Two Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e443749-9fc2-55d4-a4b3-eb59dab7d012" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id 17592186442350} {:answer/id #uuid "48e1cf8a-c4c1-5ebf-a916-45d3165108d4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id 17592186442358} {:answer/id #uuid "8545a06a-880d-5689-9044-af9bc5073062" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-56" :db/id 17592186442376} {:answer/id #uuid "b52153ff-27d6-5b68-a81b-2318ec4e584f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id 17592186442387} {:answer/id #uuid "dc282516-03cd-5932-ae69-514d6b2db858" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id 17592186442398}] :answer-field/correct {:answer/id #uuid "b52153ff-27d6-5b68-a81b-2318ec4e584f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id 17592186442387} :answer-field/id #uuid "f054c62e-b0dc-5a66-8acb-82dc871f9540" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186442421}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "515d2e58-90d5-54f6-8477-014fb0487556" :question/math-academy-id "q-128412" :question/problem "$(-6)\\cdot (-4)\\cdot 2=$" :question/worked-solution "Let's start by multiplying the first two numbers. We have the product of two negatives, which gives a positive:\n\n$$\n(-6)\\cdot (-4)=24\n$$\n\nSo we now have\n\n$$\n{{(-6)\\cdot (-4)}_{⏟}}_{24}\\cdot 2=24\\cdot 2.\n$$\n\nThen, we work out this remaining product using the fact that the product of two positives gives a positive:\n\n$$\n24\\cdot 2=48\n$$"} {:db/id 17592186442430 :knowledge-point/_questions [{:db/id 17592186179822 :knowledge-point/id #uuid "33b32ea7-dd7d-5e41-8fdb-142ec9da82c8" :knowledge-point/title "Multiplying More Than Two Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090f426b-ae78-587e-a752-bdabbff21ce4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id 17592186442334} {:answer/id #uuid "1978eb85-167c-5cc9-b3a3-98ca1a3c6746" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-70" :db/id 17592186442344} {:answer/id #uuid "71c2204c-464f-548a-a3c3-ae84cc6b12aa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-63" :db/id 17592186442371} {:answer/id #uuid "aa95cecf-7fab-557f-8f17-1b63b55d7331" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id 17592186442385} {:answer/id #uuid "d65c5775-e478-5e7d-852f-ce3df408057d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id 17592186442395}] :answer-field/correct {:answer/id #uuid "d65c5775-e478-5e7d-852f-ce3df408057d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id 17592186442395} :answer-field/id #uuid "21db98eb-ad0a-55fe-820a-349262b09ab3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186442410}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6db7b1f8-571b-596f-b937-087002cb4535" :question/math-academy-id "q-128409" :question/problem "$7\\cdot (-2)\\cdot (-5)=$" :question/worked-solution "Let's start by multiplying the first two numbers. We have the product of a positive and a negative, which gives a negative:\n\n$$\n7\\cdot (-2)=-14\n$$\n\nSo we now have\n\n$$\n{{7\\cdot (-2)}_{⏟}}_{-14}\\cdot (-5)=(-14)\\cdot (-5).\n$$\n\nThen, we work out this remaining product using the fact that the product of two negatives gives a positive:\n\n$$\n(-14)\\cdot (-5)=14\\cdot 5=70\n$$"} {:db/id 17592186442433 :knowledge-point/_questions [{:db/id 17592186179822 :knowledge-point/id #uuid "33b32ea7-dd7d-5e41-8fdb-142ec9da82c8" :knowledge-point/title "Multiplying More Than Two Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10cd0a1e-11f0-5bc2-8366-6203933d47f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id 17592186442339} {:answer/id #uuid "5083f7bf-df41-587b-967c-42e1fa756e82" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id 17592186442359} {:answer/id #uuid "614ab88a-cd2f-5011-8f76-563a637a2741" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186442368} {:answer/id #uuid "bc76fb2d-cb03-56ca-b2ba-28ebb4acbde3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id 17592186442390} {:answer/id #uuid "e2948de2-127f-5c4c-82da-7533dc3ebd0d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id 17592186442400}] :answer-field/correct {:answer/id #uuid "bc76fb2d-cb03-56ca-b2ba-28ebb4acbde3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id 17592186442390} :answer-field/id #uuid "98f26073-ab1f-5930-abda-9fc24621408f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186442416}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd957b0c-87c0-5c1c-877a-535c72909197" :question/math-academy-id "q-2131" :question/problem "$(-3)\\cdot 4\\cdot (-2)=$" :question/worked-solution "Let's start by multiplying the first two numbers. We have the product of a negative and a positive, which gives a negative:\n\n$$\n(-3)\\cdot 4=-12\n$$\n\nSo we now have\n\n$$\n{{(-3)\\cdot 4}_{⏟}}_{-12}\\cdot (-2)=(-12)\\cdot (-2).\n$$\n\nThen, we work out this remaining product using the fact that the product of two negatives gives a positive:\n\n$$\n(-12)\\cdot (-2)=12\\cdot 2=24\n$$"} {:db/id 17592186442438 :knowledge-point/_questions [{:db/id 17592186179822 :knowledge-point/id #uuid "33b32ea7-dd7d-5e41-8fdb-142ec9da82c8" :knowledge-point/title "Multiplying More Than Two Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89885175-c33d-5da4-b6fe-cd6ae9106f95" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id 17592186442377}] :answer-field/correct {:answer/id #uuid "89885175-c33d-5da4-b6fe-cd6ae9106f95" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id 17592186442377} :answer-field/id #uuid "92c9e5d8-5254-543b-ac0a-863303bc5920" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186442415}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dcae9997-c063-556b-b99d-bfc224ab7e6d" :question/math-academy-id "q-180551" :question/problem "$5\\cdot (-3)\\cdot 2=${{field-1}}" :question/worked-solution "Let's start by multiplying the first two numbers. We have the product of a positive and a negative, which gives a negative:\n\n$$\n5\\cdot (-3)=-15\n$$\n\nSo we now have\n\n$$\n{{5\\cdot (-3)}_{⏟}}_{-15}\\cdot 2=(-15)\\cdot 2.\n$$\n\nThen, we work out this remaining product using the fact that a negative times a positive gives a negative:\n\n$$\n(-15)\\cdot 2=-(15\\cdot 2)=-30\n$$"} {:db/id 17592186442439 :knowledge-point/_questions [{:db/id 17592186179822 :knowledge-point/id #uuid "33b32ea7-dd7d-5e41-8fdb-142ec9da82c8" :knowledge-point/title "Multiplying More Than Two Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c234924-49eb-58c0-9bd7-f4577d3acd85" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id 17592186442336} {:answer/id #uuid "5a09c649-99db-5f27-a92d-cf443b9bbb5a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id 17592186442364} {:answer/id #uuid "a63c048f-7df0-5ce1-9cad-c027c81e7ac5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id 17592186442383} {:answer/id #uuid "b571edf9-6056-5cc0-8192-4ad3edfcb952" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id 17592186442388} {:answer/id #uuid "e30b65b8-9ebd-5059-9550-81fbbb55e2bf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id 17592186442401}] :answer-field/correct {:answer/id #uuid "b571edf9-6056-5cc0-8192-4ad3edfcb952" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id 17592186442388} :answer-field/id #uuid "a3a193d6-5af2-544d-aafe-ac5491d5b1b1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186442417}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "edd9589d-5442-58a3-84f8-fb0a90d9d945" :question/math-academy-id "q-128408" :question/problem "$(-4)\\cdot (-4)\\cdot (-3)=$" :question/worked-solution "Let's start by multiplying the first two numbers. We have the product of two negatives, which gives a positive: \n\n$$\n(-4)\\cdot (-4)=16\n$$\n\nSo we now have\n\n$$\n{{(-4)\\cdot (-4)}_{⏟}}_{16}\\cdot (-3)=16\\cdot (-3).\n$$\n\nThen, we work out this remaining product using the fact that a positive times a negative gives a negative:\n\n$$\n16\\cdot (-3)=-(16\\cdot 3)=-48\n$$"} {:db/id 17592186442810 :knowledge-point/_questions [{:db/id 17592186133798 :knowledge-point/id #uuid "19ae0632-68ac-5da9-8adf-cf71d5ecbc7c" :knowledge-point/title "Finding the QR Factorization of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3529dcc2-d908-58eb-8e99-7d1d828d18b3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186442804} {:answer/id #uuid "387b9ac5-2487-5c7a-a0c7-85adba10d944" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186442805} {:answer/id #uuid "af55c525-fcb4-5409-9a04-32dc1d2a0e2e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id 17592186442806} {:answer/id #uuid "bf0166a7-27f9-57f1-b2b0-ed7ed1491514" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id 17592186442807} {:answer/id #uuid "c403d147-73fe-5fb4-8186-c08fd069f494" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}" :db/id 17592186442808}] :answer-field/correct {:answer/id #uuid "bf0166a7-27f9-57f1-b2b0-ed7ed1491514" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id 17592186442807} :answer-field/id #uuid "b927eac4-98a6-5bd4-97b1-9da46ea6a1a1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186442809}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "71405c00-ca6f-5d4e-8940-325d2e48014e" :question/math-academy-id "q-40841" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 3 \\\\ 1 & 0 \\\\ 1 & 3\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{32}\\cdot {r}_{12}.$" :question/worked-solution "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}.$\n\n**Step 2**. We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}3 \\\\ 0 \\\\ 3\\end{bmatrix}-\\frac{6}{3}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 0 \\\\ 3\\end{bmatrix}-2\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{6}}\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}A \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{6}} & -\\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}}\\end{bmatrix}\\begin{bmatrix}1 & 3 \\\\ 1 & 0 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{3} & 2\\sqrt{3} \\\\ 0 & \\sqrt{6}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 3 \\\\ 1 & 0 \\\\ 1 & 3\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{6}}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}\\sqrt{3} & 2\\sqrt{3} \\\\ 0 & \\sqrt{6}\\end{bmatrix}}}.\n$$\n\nFinally, ${q}_{32}\\cdot {r}_{12}=(\\frac{1}{\\sqrt{6}})\\cdot (2\\sqrt{3})=\\sqrt{2}.$"} {:db/id 17592186442958 :knowledge-point/_questions [{:db/id 17592186184196 :knowledge-point/id #uuid "8d9b62ae-7545-5d65-bcf7-74ab0e8662ec" :knowledge-point/title "Identifying Sets That Are Not Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42ef8948-2af5-570c-9086-ec884dd8b607" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\cdot (x,y)\\ne (x,y)$ for some $(x,y)\\in P$" :db/id 17592186442943} {:answer/id #uuid "6a2c8125-7050-51a6-849e-7893b298fda5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "there exists an ordered pair $(x,y)\\in P$ such that $(x,y)+({x}^{′},{y}^{′})\\ne (0,0)$ for any $({x}^{′},{y}^{′})\\in P$" :db/id 17592186442944} {:answer/id #uuid "a00c70d5-ced0-52ad-b2b1-04b1b14b6676" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "addition of ordered pairs in $P$ is not closed" :db/id 17592186442946} {:answer/id #uuid "cc589644-69c0-5cf3-a95d-7450d4d2431d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "multiplication by a scalar is not closed" :db/id 17592186442950} {:answer/id #uuid "d2e42310-8e15-5635-82fb-c6e17cfba1a0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ does not contain the zero element" :db/id 17592186442953}] :answer-field/correct {:answer/id #uuid "a00c70d5-ced0-52ad-b2b1-04b1b14b6676" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "addition of ordered pairs in $P$ is not closed" :db/id 17592186442946} :answer-field/id #uuid "657d2f5e-8283-512c-8736-a6b6bb9a9cf9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186442954}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d3e3740-f421-5f05-912d-ea42f86d4dd7" :question/math-academy-id "q-106816" :question/problem "Let $P$ be the set of all ordered pairs $(x,y)\\in {R}^{2}$ such that $xy=0.$ Complete the following sentence:\n\n*$P$ is **not** a vector space (with respect to the usual component-wise addition and scalar multiplication in ${R}^{2}$) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$P$ is **not** a vector space (with respect to the usual component-wise addition and scalar multiplication in ${R}^{2}$) because **addition of ordered pairs in $P$ is not closed.** *  \n\nFor example, $(1,0)\\in P$ because $1\\cdot 0=0$ and $(0,1)\\in P$ because $0\\cdot 1=0.$ However, if we add the two pairs component-wise, we get\n\n$$\n(1,0)+(0,1)=(1+0,0+1)=(1,1).\n$$\n\nThe product of the components of this pair is $1\\cdot 1=1\\ne 0.$ So, $(1,0)+(0,1)\\notin P.$\n\nOn the other hand:\n\n- Multiplication of $(x,y)\\in P$ by a scalar is closed. Indeed, if $\\alpha \\in R,$ then \n\n$$\n\\alpha \\cdot (x,y)=(\\alpha x,\\alpha y)\\in P\n$$\n\nsince $(\\alpha x)\\cdot (\\alpha y)={\\alpha }^{2}{{(xy)}_{⏟}}_{=0}=0.$\n$\\,✓$\n\n- The zero element in $P$ is $(0,0).$ $✓$\n\n- For an ordered pair $(x,y)\\in P,$ the ordered pair $-(x,y)=(-x,-y)$ is also an element of $P$ since $(-x)\\cdot (-y)=xy=0.$\n$\\,✓$\n\n- $1\\cdot (x,y)=(x,y)$ for all $(x,y)\\in P.$ $\\,✓$"} {:db/id 17592186443075 :knowledge-point/_questions [{:db/id 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2447b23c-518a-583f-94a7-4b1dc6ebfd02" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "10.24" :db/id 17592186443000} {:answer/id #uuid "64f6dd86-cc7d-5d80-b8e5-879b012c649d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6.4" :db/id 17592186443015} {:answer/id #uuid "7fe427d5-a320-59d9-867c-71f5d00edbef" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-10.24" :db/id 17592186443022} {:answer/id #uuid "85877040-083d-56d8-9695-f3c5224bf53b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-10.04" :db/id 17592186443026} {:answer/id #uuid "9e740911-a953-5ae2-bda7-47f9775a596a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-6.4" :db/id 17592186443034}] :answer-field/correct {:answer/id #uuid "2447b23c-518a-583f-94a7-4b1dc6ebfd02" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "10.24" :db/id 17592186443000} :answer-field/id #uuid "7efa277c-8af9-5a93-b5aa-5d04f07f829a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186443064}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "28d7dd84-346e-5b73-9ead-af1c62abb54d" :question/math-academy-id "q-104534" :question/problem "$(-3.2)^{2}=$" :question/worked-solution "We need to calculate the product of $-3.2$ with itself:\n\n$$\n(-3.2)^{2}=(-3.2)\\cdot (-3.2)=(3.2)\\cdot (3.2)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $32\\times 32=1\\,024.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($3.2$) and $1$ decimal place in the second factor ($3.2$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $1\\,024$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n10\\,\\overset{↓}{.}\\,\\,\\,{{24}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${3.2}^{2}=10.24.$"} {:db/id 17592186443078 :knowledge-point/_questions [{:db/id 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bf41ab3-6854-52f9-af7b-9e645e613508" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1.96" :db/id 17592186443002}] :answer-field/correct {:answer/id #uuid "2bf41ab3-6854-52f9-af7b-9e645e613508" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1.96" :db/id 17592186443002} :answer-field/id #uuid "7c7bab6b-4259-5022-a929-b79ac90b204a" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186443063}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "58bd0ac9-9ea6-5ce8-9fc3-fc8a73b17344" :question/math-academy-id "q-171165" :question/problem "Expressed as a decimal in its simplest form, $(-1.4)^{2}=${{field-1}}." :question/worked-solution "We need to calculate the product of $(-1.4)$ with itself:\n\n$$\n(-1.4)^{2}=(-1.4)\\cdot (-1.4)=(1.4)\\cdot (1.4)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $14\\times 14=196.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($1.4$) and $1$ decimal place in the second factor ($1.4$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $196$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n1\\,\\overset{↓}{.}\\,\\,\\,{{96}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, $(-1.4)^{2}=1.96\\,.$"} {:db/id 17592186443086 :knowledge-point/_questions [{:db/id 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebb2e927-316a-5479-8921-68cb685d1107" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "28.09" :db/id 17592186443048}] :answer-field/correct {:answer/id #uuid "ebb2e927-316a-5479-8921-68cb685d1107" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "28.09" :db/id 17592186443048} :answer-field/id #uuid "9d0c6a72-5c4b-569d-8557-e438dfaa81e8" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186443067}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5bedd10-8ffa-5ad9-bdb2-5aa9ca8ef32b" :question/math-academy-id "q-185204" :question/problem "Expressed as a decimal in its simplest form, $(5.3)^{2}=${{field-1}}." :question/worked-solution "We need to calculate the product of $5.3$ with itself:\n\n$$\n{5.3}^{2}=(5.3)\\cdot (5.3)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $53\\times 53=2\\,809.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($5.3$) and $1$ decimal place in the second factor ($5.3$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $2\\,809$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n28\\,\\overset{↓}{.}\\,\\,\\,{{09}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${5.3}^{2}=28.09\\,.$"} {:db/id 17592186443087 :knowledge-point/_questions [{:db/id 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "382ab701-ec1b-571c-9078-66310f103b5f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0.09" :db/id 17592186443003}] :answer-field/correct {:answer/id #uuid "382ab701-ec1b-571c-9078-66310f103b5f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0.09" :db/id 17592186443003} :answer-field/id #uuid "c316753b-96b3-5e65-8e5d-5fdec3bbcfd0" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186443070}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e04ccdd3-f28d-58f9-a502-15fb5e93205e" :question/math-academy-id "q-185196" :question/problem "Expressed as a decimal in its simplest form, $(-0.3)^{2}=${{field-1}}." :question/worked-solution "We need to calculate the product of $-0.3$ with itself:\n\n$$\n(-0.3)^{2}=(-0.3)\\cdot (-0.3)=(0.3)\\cdot (0.3)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n3\\times 3=9.\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($0.3$) and $1$ decimal place in the second factor ($0.3$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $9$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n0\\,\\overset{↓}{.}\\,\\,\\,{{09}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, $(-0.3)^{2}=0.09\\,.$"} {:db/id 17592186443089 :knowledge-point/_questions [{:db/id 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "646f6c14-3b9e-545a-b130-288d60986d5d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3.02" :db/id 17592186443014} {:answer/id #uuid "820db4f9-0272-5520-8ff5-1246c0642b95" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2.84" :db/id 17592186443025} {:answer/id #uuid "9883503f-c186-5adb-8b1a-3be60665a2a1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3.14" :db/id 17592186443032} {:answer/id #uuid "b840462d-8d97-5643-baa8-700fcff510ba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2.56" :db/id 17592186443040} {:answer/id #uuid "e8b00607-3d6c-5a89-bdc6-d6456d75846e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2.42" :db/id 17592186443046}] :answer-field/correct {:answer/id #uuid "b840462d-8d97-5643-baa8-700fcff510ba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2.56" :db/id 17592186443040} :answer-field/id #uuid "8fcffc96-726d-51dd-89e9-859a58d88bc6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186443066}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f176b794-be06-5dbc-b5c3-35aaeec4668c" :question/math-academy-id "q-69409" :question/problem "${1.6}^{2}=$" :question/worked-solution "We need to calculate the product of $1.6$ with itself:\n\n$$\n{1.6}^{2}=(1.6)\\cdot (1.6)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{3}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $16\\times 16=256.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($1.6$) and $1$ decimal place in the second factor ($1.6$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $256$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n2\\,\\overset{↓}{.}\\,\\,\\,{{56}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${1.6}^{2}=2.56\\,.$"} {:db/id 17592186443407 :knowledge-point/_questions [{:db/id 17592186162042 :knowledge-point/id #uuid "a6732620-fad1-5dd3-98c5-07ba59d0b286" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "521d6dc6-c306-5eff-a662-c8d5ca209cac" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{2}" :db/id 17592186443340} {:answer/id #uuid "5a1282dd-cff4-5d9d-aea1-997f77fae849" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{2}" :db/id 17592186443343} {:answer/id #uuid "e6ac364e-730c-5977-844b-64abc957eff9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{2}" :db/id 17592186443381}] :answer-field/correct {:answer/id #uuid "5a1282dd-cff4-5d9d-aea1-997f77fae849" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{2}" :db/id 17592186443343} :answer-field/id #uuid "01393794-e39b-5872-af64-efa4c600b9fc" :answer-field/key "field-4" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186443388} {:answer-field/choices [{:answer/id #uuid "123f6db1-a64c-5351-af4f-43d4b9d652f0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id 17592186443324} {:answer/id #uuid "37473ba7-f727-5d13-a1f4-d0e0252ed8b5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186443335} {:answer/id #uuid "482a2476-04ad-5ed6-a93d-a4c282bcffdf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{5}}" :db/id 17592186443336} {:answer/id #uuid "b0772e32-b9f7-5716-b91d-a2a4ae968b35" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{5}}" :db/id 17592186443362}