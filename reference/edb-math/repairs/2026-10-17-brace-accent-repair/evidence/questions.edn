bmatrix}\\,$ we have that\n\n$$\n\\begin{aligned}x & =\\begin{bmatrix}-4+9\\text{i} \\\\ 1+8\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{\\begin{bmatrix}9 \\\\ 8\\end{bmatrix}}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=-4,b=1,c=9$ and $d=8$, which implies that \n\n$$\nbc-ad=1\\cdot 9-(-4)\\cdot 8=41.\n$$"} {:db/id 17592186345163 :knowledge-point/_questions [{:db/id 17592186152168 :knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bbb921d-f6f4-5480-bfbf-c6d90fe64647" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-23" :db/id 17592186342862} {:answer/id #uuid "50b5dc8d-7e77-5191-97c8-29fe680f3d1f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id 17592186342906} {:answer/id #uuid "92681936-d9cd-5044-b0fa-03426cefa6cf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186343516} {:answer/id #uuid "d5e79586-dfc4-5a38-b455-7f21a76e52eb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id 17592186344110} {:answer/id #uuid "f73494d8-9f5d-5cac-850f-97428a0e3f15" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id 17592186344415}] :answer-field/correct {:answer/id #uuid "d5e79586-dfc4-5a38-b455-7f21a76e52eb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id 17592186344110} :answer-field/id #uuid "6f2ed79a-afc0-55dd-b367-a5beca302e47" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186344693}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "092a46e1-ab30-51e7-8a06-0f91ed1c7242" :question/math-academy-id "q-76050" :question/problem "If $\\,\\text{Re}(x)=\\begin{bmatrix}a \\\\ b\\end{bmatrix}\\,$ and $\\,\\text{Im}(x)=\\begin{bmatrix}c \\\\ d\\end{bmatrix}\\,$ are the real and imaginary parts of the vector $\\,x=\\begin{bmatrix}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{bmatrix}\\,$ then what is the value of $ad+bc?$" :question/worked-solution "For the given vector $\\,x=\\begin{bmatrix}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{bmatrix}\\,$ we have that\n\n$$\n\\begin{aligned}x & =\\begin{bmatrix}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-6 \\\\ 1\\end{bmatrix}}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{\\begin{bmatrix}7 \\\\ -6\\end{bmatrix}}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=-6,b=1,c=7$ and $d=-6$, which implies that \n\n$$\nad+bc=(-6)\\cdot (-6)+1\\cdot 7=43.\n$$"} {:db/id 17592186345164 :knowledge-point/_questions [{:db/id 17592186152168 :knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406dbc4a-e01a-5357-9b25-3e8fa07a3099" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=\\begin{bmatrix}5 \\\\ -8\\end{bmatrix}\\," :db/id 17592186342769} {:answer/id #uuid "a726f01a-8105-5643-a890-6bb474e773ae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=\\begin{bmatrix}4 \\\\ -8\\end{bmatrix}\\," :db/id 17592186343709} {:answer/id #uuid "af1ac8b1-e1d6-5550-93a2-33a03b62c5a0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\\," :db/id 17592186343778} {:answer/id #uuid "d33b19d8-5839-51d0-b3bf-10f8a808ef87" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=\\begin{bmatrix}4 \\\\ -3\\end{