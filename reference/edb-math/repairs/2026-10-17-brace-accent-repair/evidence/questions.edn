answer/id #uuid "77aeb5c1-86da-560c-a6f5-708a960accad" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "|n|>-1" :db/id 17592186384679} :answer-field/id #uuid "a717f922-9653-51cb-8959-1d54dace7d97" :answer-field/key "field-4" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186384678} {:answer-field/choices [{:answer/id #uuid "fab5f2d3-d268-51b4-9949-1fc3bf775a06" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "|n|>-1" :db/id 17592186384682} {:answer/id #uuid "c1cf8796-56f7-5fd9-883d-ddd6d035579a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "n\\text{ is even}" :db/id 17592186384683}] :answer-field/correct {:answer/id #uuid "fab5f2d3-d268-51b4-9949-1fc3bf775a06" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "|n|>-1" :db/id 17592186384682} :answer-field/id #uuid "495e25a6-f246-57d4-8818-c2b56ac1eb5f" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186384681}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d27a0cc1-7692-5dc4-a225-ff6e45a34e18" :question/math-academy-id "q-215022" :question/problem "Let $n\\in Z.$ Prove that if $n$ is even, then $|n|>-1.$" :question/worked-solution "We say that an implication has a *trivial proof* if the consequent is always true:\n\n$$\nP\\,⇒\\overset{\\text{Always true}}{\\overset{⏞}{Q}}\n$$\n\nIt does not matter whether the antecedent is true or false. \n\nWith that in mind, we proceed as follows:\n\nThe theorem can be written as the implication \n\n$$\nn\\text{ is even}\\,⇒\\,|n|>-1.\n$$\n\nNow, since $|n|$ is non-negative for all $n\\in Z,$ we have the following fact:\n\nThe consequent $|n|>-1$ of our implication is always true.\n\nFinally, we can make the following conclusion:\n\nTherefore, the theorem is trivially true."} {:db/id 17592186157752 :knowledge-point/_questions [{:db/id 17592186157454 :knowledge-point/id #uuid "ffe4292f-7653-5486-975e-c206acae734e" :knowledge-point/title "Applying Properties of Big-O"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "971de907-aa22-5e54-86e1-730856500bc3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186155351} {:answer/id #uuid "adeb3a38-8e02-56f1-833f-d049b423ba2b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186155352} {:answer/id #uuid "b4d323a2-e647-521b-99a9-c99cacd126af" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186155353} {:answer/id #uuid "b7ad2711-3588-50f5-80fa-45a5f56319fb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the transitive property" :db/id 17592186155354} {:answer/id #uuid "38fa238c-1f65-57b3-9eaa-dde23ccc163d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id 17592186155355}] :answer-field/id #uuid "5c3ccbab-e46c-5e80-aa80-cb21b6d4a36f" :answer-field/key "field-5" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186155350} {:answer-field/choices [{:answer/id #uuid "9d4ebb7c-62d1-58fa-a8c9-d2e9996cdea3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id 17592186155360} {:answer/id #uuid "ded68a95-0a78-59ea-bb21-e9cfc20deb9d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id 17592186155361} {:answer/id #uuid "0dceb9f9-6fe6-5e84-be8b-c8b97a20a7e9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id 17592186155362} {:answer/id #uuid "3e78c090-60be-5986-9ec9-f7914a293d12" :answer/type {:db/id 17592