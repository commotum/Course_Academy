lways true. $\\,\\times $\n\n- Statement III is always false. $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""} {:db/id 17592186384691 :knowledge-point/_questions [{:db/id 17592186157232 :knowledge-point/id #uuid "fb4d348b-1703-51a1-be05-2e66295cacaa" :knowledge-point/title "Completing Trivial Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf9e4aa9-8e45-51b3-b3b8-086dc158a25a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186471317} {:answer/id #uuid "1dec0be7-4806-59e3-98b0-14968d4a61d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186471318}] :answer-field/correct {:answer/id #uuid "bf9e4aa9-8e45-51b3-b3b8-086dc158a25a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186471317} :answer-field/id #uuid "848d2e24-735f-5301-9b27-a19033fd2df7" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186472164} {:answer-field/choices [{:answer/id #uuid "1c955bf8-730b-5d76-a57b-8e87b63787ad" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186471319} {:answer/id #uuid "ae2d9626-802f-5ad4-ba44-11f523f067d0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186471320}] :answer-field/correct {:answer/id #uuid "ae2d9626-802f-5ad4-ba44-11f523f067d0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186471320} :answer-field/id #uuid "f74f6912-6c8b-56fe-a2d2-b4e096630c6c" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186472165} {:answer-field/choices [{:answer/id #uuid "c54f76f8-6e8d-5829-92cc-9f289a4f3310" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 1759218