-9c27-c8d173b28036" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=\\begin{bmatrix}-4 \\\\ 3\\end{bmatrix}" :db/id 17592186342465} {:answer/id #uuid "4689eef9-d893-5fd3-ab4c-d948213d9844" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=\\begin{bmatrix}0 \\\\ -4\\end{bmatrix}" :db/id 17592186342820} {:answer/id #uuid "6f976300-b408-5998-81f3-d99f702fa355" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=\\begin{bmatrix}0 \\\\ 7\\end{bmatrix}" :db/id 17592186343198} {:answer/id #uuid "e9453c21-0e8a-5b5a-b3d0-e5f810eb92d5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=\\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}" :db/id 17592186344279}] :answer-field/correct {:answer/id #uuid "08c8127b-dc32-5d32-b6c5-1d8268cbbaa2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}" :db/id 17592186342310} :answer-field/id #uuid "716450b5-6a2d-560b-9d2e-23518d3edae8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186344697}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07da44c0-ec24-5a2d-94d4-9974eaf9fe8a" :question/math-academy-id "q-76053" :question/problem "Find the real part of the vector $v=\\begin{bmatrix}3 \\\\ 7\\text{i}-4\\end{bmatrix}.$" :question/worked-solution "For the given vector $\\,v=\\begin{bmatrix}3 \\\\ 7\\text{i}-4\\end{bmatrix}\\,$ we have that\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}3 \\\\ 7\\text{i}-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3+0\\text{i} \\\\ -4+7\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}\\,{{\\begin{bmatrix}0 \\\\ 7\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}.\\end{aligned}\n$$"} {:db/id 17592186345189 :knowledge-point/_questions [{:db/id 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "716ff2dc-03ac-570a-8aa9-28a4626815b9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id 17592186343216} {:answer/id #uuid "96518f81-fb54-5f04-a4ae-8960a7c07211" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id 17592186343553} {:answer/id #uuid "b97b3a69-a7b5-53c4-a895-95108994cce6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186343869} {:answer/id #uuid "ba77d513-f598-56df-8a60-c5edb5242faa" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186343873} {:answer/id #uuid "fdaa3609-2791-558c-8f6f-72219588c963" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186344470}] :answer-field/correct {:answer/id #uuid "fdaa3609-2791-558c-8f6f-72219588c963" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186344470} :answer-field/id #uuid "08aecc92-e4b5-5ca9-8fb4-146825476a4a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186344510}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd4340c5-cc43-5fc5-a905-42e6c2bd59d0" :question/math-academy-id "q-76201" :question/problem "If $\\,\\text{Re}(x)=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\,$ and $\\,\\text{Im}(x)=\\begin{bmatrix}e & f \\\\ g & h\\end{bmatrix}\\,$ are the real and imaginary parts of the matrix $A=\\begin{bmatrix}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{bmatrix}\\,$ then what is the value of $cd+gh?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 0+5\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{\\begin{bmatrix}-3 & -1 \\\\ 1 & 5\\end{bmatrix}}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $c=1,d=0,g=1$ and $h=5.$ Therefore,\n\n$$\ncd+gh=1\\cdot 0+1\\cdot 5=5.\n$$"} {:db/id 17592186345190 :knowledge-point/_questions [{:db/id 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cb83ee8-78fa-5239-9550-de25613c2868" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186343168} {:answer/id #uuid "ae510664-9774-55c8-90a3-96f3e91bfa67" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186343770} {:answer/id #uuid "c24640c3-d1c5-5a6c-ad11-0cd6b06e2094" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186343945} {:answer/id #uuid "dd2ebade-b2ee-5903-9841-dca9603bd601" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id 17592186344180} {:answer/id #uuid "ff235be0-6fc6-5e04-9c08-ef0b91ed801a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186344485}] :answer-field/correct {:answer/id #uuid "c24640c3-d1c5-5a6c-ad11-0cd6b06e2094" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186343945} :answer-field/id #uuid "473141a1-d726-51b8-b1c3-33a83754c8bf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186344613}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7450ea4-ef6e-5340-ac53-138f6702e426" :question/math-academy-id "q-76202" :question/problem "If $\\,\\text{Re}(x)=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\,$ and $\\,\\text{Im}(x)=\\begin{bmatrix}e & f \\\\ g & h\\end{bmatrix}\\,$ are the real and imaginary parts of the matrix $A=\\begin{bmatrix}8 & 1-6\\text{i} \\\\ 3+\\text{i} & 4+2\\text{i}\\end{bmatrix}\\,$ then what is the value of $bc+eg?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}8 & 1-6\\text{i} \\\\ 3+\\text{i} & 4+2\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}8+0\\text{i} & 1-6\\text{i} \\\\ 3+\\text{i} & 4+2\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}8 & 1 \\\\ 3 & 4\\end{bmatrix}}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{\\begin{bmatrix}0 & -6 \\\\ 1 & 2\\end{bmatrix}}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $b=1,c=3,e=0$ and $g=1.$ Therefore,\n\n$$\nbc+eg=1\\cdot 3+0\\cdot 1=3.\n$$"} {:db/id 17592186345191 :knowledge-point/_questions [{:db/id 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "504d2b32-4184-5dcd-becb-dd145229ab0d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id 17592186342903} {:answer/id #uuid "78f37c8f-5e5d-5a35-9335-be78340c647c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186343284} {:answer/id #uuid "90cadb7e-a939-5cc2-8497-018dc70ed109" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id 17592186343504} {:answer/id #uuid "b7027eac-2319-52a1-84f4-d072b9f1e5ae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value 