ct {:answer/id #uuid "c01d9932-6392-5aed-a3f5-54df1c9bb425" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id 17592186379053} :answer-field/id #uuid "1ce3254a-71e1-5f80-9aef-3bb712ffd9ab" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186379051}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c27a913-ac84-5254-83a3-c584e091113c" :question/math-academy-id "q-177356" :question/problem "$7$ is prime **or** $2$ is less than $5.$\n\nConsider the compound statement above and the following notations:\n\n- $R:7\\text{ is prime}$\n\n- $P:2\\text{ is less than }5$\n\nExpressed in symbolic form, our statement can be written as\n{{field-1}}{{field-2}}{{field-3}}." :question/worked-solution "The word \"or\" is represented by the symbol \"$∨$\".\n\nSo, the sentence reads\n\n$$\n{{7\\text{ is prime}}_{⏟}}_{R}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{2\\text{ is less than }5}_{⏟}}_{P},\n$$\n\nthat is, $R∨P.$"} {:db/id 17592186379055 :knowledge-point/_questions [{:db/id 17592186054641 :knowledge-point/id #uuid "93bc0caa-2352-5d02-9ccf-7267dff4be2c" :knowledge-point/title "Expressing Compound Statements in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6c070f7-2fd1-5a15-8afb-51d119b6a553" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "∧" :db/id 17592186379057} {:answer/id #uuid "930d6108-e96c-56ba-a25a-b69aa35bd453" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id 17592186379058} {:answer/id #uuid "92c8bc63-24d3-5ae9-b466-384ede8fe63b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "S" :db/id 17592186379059} {:answer/id #uuid "820025a9-9338-5553-8705-640d59b6c726" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "∨" :db/id 17592186379060}] :answer-field/correc