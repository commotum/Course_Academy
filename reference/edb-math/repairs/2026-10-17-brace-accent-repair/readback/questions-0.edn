a5d51dfb-7628-540e-af90-f9bf236e3118" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186379110}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ad496fd-331b-5aca-a430-4747522132a6" :question/math-academy-id "q-181714" :question/problem "$$\n\\underbrace{2\\text{ is prime}}_{R}\\,\\underbrace{\\text{or}}_{∨}\\,\\underbrace{\\overbrace{7\\,|\\,14}^{S}\\,\\overbrace{\\text{and}}^{∧}\\,\\overbrace{5\\,|\\,14}^{T}}_{S\\,∧\\,T}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $R$ is {{field-1}},\n$\\,$ $S∧T$ is {{field-2}},\n$\\,$ $R∨(S∧T)$ is {{field-3}}." :question/worked-solution "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $R$ is true, $S$ is true, and $T$ is false. Therefore, $S∧T$ is false, but the result is true:\n\n$$\n\\begin{aligned}R∨(S∧T) & ≡\\text{true}∨\\overbrace{(\\text{true}∧\\text{false})}^{\\text{false}} \\\\  & ≡\\text{true}∨\\text{false} \\\\  & ≡\\text{true}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055097 :knowledge-point/_questions [{:db/id #edb/ref 17592186054842 :knowledge-point/id #uuid "40e41bd9-1eee-552d-8507-e8cdf50ddfa4" :knowledge-point/title "Expressing a Product Using an Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ffa82b-453a-50d5-8260-6229f41d027d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "279" :db/id #edb/ref 17592186052022} {:answer/id #uuid "25c3e96b-98d9-5c5d-a9e5-e296b925358c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186052023} {:answer/id #uuid "5dae0c28-2645-5052-bd66-ef31adb84f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{6}" :db/id #edb/ref 17592186475580} {:answer/id #uuid "776ce7ef-78b8-5cae-a1f8-d41fa38d6943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{5}" :db/id #edb/ref 17592186475615} {:answer/id #uuid "7f7a28f4-ac5e-50d5-986e-510c2a81dba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{4}" :db/id #edb/ref 17592186475631}] :answer-field/correct {:answer/id #uuid "776ce7ef-78b8-5cae-a1f8-d41fa38d6943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{5}" :db/id #edb/ref 17592186475615} :answer-field/id #uuid "9f0c68d2-2c71-51f2-99d2-94e7f50289b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32ed6c57-e38f-563f-ad32-4eac3ae02fef" :question/math-academy-id "q-1985" :question/problem "$3\\times 3\\times 3\\times 3\\times 3=$" :question/worked-solution "The number $3$ is multiplied by itself $5$ times, so we have\n\n$$\n\\underbrace{3\\times 3\\times 3\\times 3\\times 3}_{5\\text{ copies of }3}={3}^{5}.\n$$\n\nTherefore, the answer is ${3}^{5}.$"}] [{:db/id #edb/ref 17592186055275 :knowledge-point/_questions [{:db/id #edb/ref 17592186054842 :knowledge-point/id #uuid "40e41bd9-1eee-552d-8507-e8cdf50ddfa4" :knowledge-point/title "Expressing a Product Using an Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "745105fd-229b-5e6f-ae8b-71fea9c217e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{2}{3})}^{4}" :db/id #edb/ref 17592186475610} {:answer/id #uuid "bee6716e-b700-549b-8677-746084d632a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{3}{2})}^{4}" :db/id #edb/ref 17592186475732} {:answer/id #uuid "d0e04115-2836-5f04-ba3d-8b76ed0dbce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times (-\\frac{2}{3})" :db/id #edb/ref 17592186475756} {:answer/id #uuid "d188df72-cda6-547b-bb15-98f82fd40b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{2}{3})}^{1}" :db/id #edb/ref 17592186475760} {:answer/id #uuid "e1a93604-093c-5b39-84c1-09c6a701ee0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{-2/3}" :db/id #edb/ref 17592186475789}] :answer-field/correct {:answer/id #uuid "745105fd-229b-5e6f-ae8b-71fea9c217e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{2}{3})}^{4}" :db/id #edb/ref 17592186475610} :answer-field/id #uuid "c6fa84fd-db20-5004-b031-c1e7e0a4b212" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052887}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d895c26-f8e3-5adb-bbd3-a7c7c3d0ff8b" :question/math-academy-id "q-43207" :question/problem "$(-\\frac{2}{3})\\times (-\\frac{2}{3})\\times (-\\frac{2}{3})\\times (-\\frac{2}{3})=$" :question/worked-solution "The number $(-\\frac{2}{3})$ is multiplied by itself $4$ times, so we have\n\n$$\n\\underbrace{(-\\frac{2}{3})\\times (-\\frac{2}{3})\\times (-\\frac{2}{3})\\times (-\\frac{2}{3})}_{4\\text{ copies of }(-\\frac{2}{3})}={(-\\frac{2}{3})}^{4}.\n$$\n\nTherefore, the answer is ${(-\\frac{2}{3})}^{4}.$"}] [{:db/id #edb/ref 17592186055381 :knowledge-point/_questions [{:db/id #edb/ref 17592186054790 :knowledge-point/id #uuid "342e8283-f3a1-5923-8788-1a489ae058c5" :knowledge-point/title "Rearranging an Expression Before Collecting Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cb076d1-905e-50e2-a396-6f6ef860a604" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x+2y-1" :db/id #edb/ref 17592186445495} {:answer/id #uuid "53d0bab1-9c5e-56e7-acb5-a6ed89ec296e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13x-2y-1" :db/id #edb/ref 17592186445499} {:answer/id #uuid "81a6251e-ccc5-59a9-b49b-305692f48306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11x+5y+1" :db/id #edb/ref 17592186445505} {:answer/id #uuid "9204982f-c56c-5cf6-8e73-46bede6e1f21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x-2y+1" :db/id #edb/ref 17592186445506} {:answer/id #uuid "fd9aa503-96ed-5b4e-86cc-b96db3e214bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x-2y+1" :db/id #edb/ref 17592186445517}] :answer-field/correct {:answer/id #uuid "fd9aa503-96ed-5b4e-86cc-b96db3e214bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x-2y+1" :db/id #edb/ref 17592186445517} :answer-field/id #uuid "0524c63d-c5cd-5b8d-80be-75cddeeee83b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a35d688d-c263-50c4-b62e-c79c29a24f63" :question/math-academy-id "q-563" :question/problem "$13x-2y+5x+1=$" :question/worked-solution "We rearrange the terms so that the like terms, $13x$ and $5x$, are together.\n\n$$\n\\begin{aligned}13x-2y+5x+1 & = \\\\ \\underbrace{13x+5x}_{x\\text{ terms}}-2y+1 & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}\\underbrace{13x+5x}-2y+1 & = \\\\ (13+5)x-2y+1 & = \\\\ 18x-2y+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064081 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064210 :knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f" :knowledge-point/title "Calculating Indefinite Integrals of Algebraic Functions Using Substitution"}] :question/id #uuid "a40f6e7e-f4d3-5f3e-bf9d-99c640e36274" :question/math-academy-id "e-458" :question/problem "Calculate $\\displaystyle \\int x^3\\sqrt{x^2 + 1}\\, \\textrm{d}x.$" :question/worked-solution "Let $u = x^2+1.$ Then, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can now solve the integral in terms of $u,$ and then express our final answer in terms of $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\int {x}^{3}\\sqrt{{x}^{2}+1}\\,\\text{d}x & =\\int {x}^{2}\\cdot x\\sqrt{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\int {x}^{2}\\sqrt{{x}^{2}+1}\\,\\cdot x\\,\\text{d}x \\\\  & =\\int \\overbrace{{x}^{2}}^{u-1}\\sqrt{{x}^{2}+1}\\cdot \\overbrace{x\\,\\text{d}x}^{\\frac{1}{2}\\text{d}u} \\\\  & =\\int (u-1)\\sqrt{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int (u-1){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int ({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & =\\frac{1}{2}(\\frac{2}{5}{u}^{5/2}-\\frac{2}{3}{u}^{3/2})+C \\\\  & =\\frac{1}{5}({x}^{2}+1)^{5/2}-\\frac{1}{3}({x}^{2}+1)^{3/2}+C \\\\  & =\\frac{1}{5}\\sqrt{({x}^{2}+1)^{5}}-\\frac{1}{3}\\sqrt{({x}^{2}+1)^{3}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064102 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/id #uuid "6e148f32-5352-5368-a08a-6da278a6068d" :question/math-academy-id "e-5124" :question/problem "Given that $\\dfrac{6y − 1}{3} = ay + b,$  what are the values of $a$ and $b?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\eqalign{\n\t\t\\dfrac{6y − 1}{3} &= \\\n\t\t\\dfrac{6y}{3} - \\dfrac 1 3 &= \\\n\t\t\\dfrac{6}{3} \\cdot y - \\dfrac 1 3 &= \\\t\n\t\t2 \\cdot y - \\dfrac 1 3 &= \\\t\t\n\t\t2y - \\dfrac 1 3 &.\n\t}\n$$\n\nWriting the above in the form $ay+b,$ we get\n\n$$\n\\begin{aligned}\\underbrace{(2)}_{a}y+\\underbrace{(-\\frac{1}{3})}_{b}.\\end{aligned}\n$$\n\nTherefore, $a=2$ and $b=-\\dfrac{1}{3}.$"}] [{:db/id #edb/ref 17592186064103 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/id #uuid "41294f0b-dc6a-5a84-a7f8-7c2370b5733c" :question/math-academy-id "e-5125" :question/problem "Given that $\\dfrac{1 − 2a + 16b}{4} = p + qa + rb,$ what are the values of $p,$ $q,$ and $r?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\eqalign{\n\t\t\\dfrac{1 − 2a + 16b}{4} &= \\\n\t\t\\dfrac 1 4 − \\dfrac {2a} {4} + \\dfrac {16b}{4} &= \\\n\t\t\\dfrac 1 4 − \\dfrac {2} {4} \\cdot a + \\dfrac {16}{4} \\cdot b &= \\\n\t\t\\dfrac 1 4 − \\dfrac {1} {2} \\cdot a + 4 \\cdot b &= \\\t\t\n\t\t\\dfrac 1 4 − \\dfrac {a} {2} + 4b &= \\\n                \\dfrac{1}{4} - \\dfrac{1}{2}a + 4b &.\n\t}\n$$\n\nWriting the above in the form $p+qa+rb,$ we get\n\n$$\n\\begin{aligned}\\underbrace{(\\frac{1}{4})}_{p}+\\underbrace{(-\\frac{1}{2})}_{q}a+\\underbrace{(4)}_{r}b.\\end{aligned}\n$$\n\nTherefore, $p=\\dfrac{1}{4},$ $q=-\\dfrac{1}{2},$ and $r=4.$"}] [{:db/id #edb/ref 17592186064516 :knowledge-point/_questions [{:db/id #edb/ref 17592186064321 :knowledge-point/id #uuid "639c3818-9c51-5dc5-abd5-c833fec45ac1" :knowledge-point/title "Evaluating an Accumulation Function Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096f365b-bdb1-5f11-bcdd-f63749f97888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186272467} {:answer/id #uuid "5f33f682-4fa1-5d09-b5bb-eaf8639e4dbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186273205} {:answer/id #uuid "d6a30fa7-8a9b-5067-9f3c-0b3c73d20b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186274264} {:answer/id #uuid "ec84d78e-b1f8-5bf4-ac21-7924711e737f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186274475} {:answer/id #uuid "ef10ea7c-c608-5b93-b717-de2b78d32b5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186274502}] :answer-field/correct {:answer/id #uuid "d6a30fa7-8a9b-5067-9f3c-0b3c73d20b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186274264} :answer-field/id #uuid "82226fee-1448-560d-b85e-5e96cf0bd3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274857}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "95e7c02f-cf4f-50e1-895d-228e0f024189" :question/math-academy-id "q-155717" :question/problem "![](images/21/21c86a5542f6bac4cd53c9d64d7c24a90ea6e901bd58e0204f38a91c2835e3aa.png)\n\nThe graph of the function $y=f(x)$ is shown above. Given $g(t)={\\int }_{-3}^{t}f(x)\\,\\text{d}x,$ determine the value of $g(3).$" :question/worked-solution "Evaluating $g(t)$ at $t=3,$ we get the following definite integral:\n\n$$\ng(3)={\\int }_{-3}^{3}f(x)\\,\\text{d}x\n$$\n\nThis integral gives the signed area between the curve and the $x$-axis shown below.\n\n![](images/b1/b14fbfe336923b44e4e4f3660bef7c6be97ada82ea07c4523a3f25f2905f4fd6.png)\n\nNote that the graph above consists of $2$ parts:\n\n- $x\\in [-3,0],$ for which the region between the curve and the $x$-axis is a triangle. This corresponds to the area ${A}_{1}.$\n\n- $x\\in [0,3],$  for which the region between the curve and the $x$-axis is a square.  This corresponds to the area ${A}_{2}.$\n\nTherefore, we can write the integral as follows:\n\n$$\ng(3)={\\int }_{-3}^{3}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-3}^{0}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{0}^{3}f(x)\\,\\text{d}x}_{{A}_{2}}\n$$\n\nNow, let's compute these integrals:\n\n- To find the first integral where $x\\in [-3,0],$ we compute the area ${A}_{1}$ of the triangle as follows:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}\\cdot 3\\cdot 3 \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\n- To find the second integral where $x\\in [0,3],$ we compute the area ${A}_{2}$ of the triangle as follows:\n\n$$\n\\begin{aligned}{A}_{2} & ={3}^{2} \\\\  & =9\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}g(3) & ={\\int }_{-3}^{3}f(x)\\,\\text{d}x={A}_{1}+{A}_{2}=\\frac{9}{2}+9=\\frac{27}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064517 :knowledge-point/_questions [{:db/id #edb/ref 17592186064321 :knowledge-point/id #uuid "639c3818-9c51-5dc5-abd5-c833fec45ac1" :knowledge-point/title "Evaluating an Accumulation Function Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2998fcd2-319a-5576-8d38-48016ce28606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17-\\frac{3}{2}\\pi " :db/id #edb/ref 17592186272757} {:answer/id #uuid "564c1758-4814-54c7-b4ec-6c09b6aeb928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18-\\frac{3}{2}\\pi " :db/id #edb/ref 17592186273121} {:answer/id #uuid "58e845d7-6e9f-5a20-9cb3-00d6d59295c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15-\\frac{9}{2}\\pi " :db/id #edb/ref 17592186273148} {:answer/id #uuid "79cbbd07-05f3-5b26-b56b-2e5c156b29a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16-\\frac{9}{4}\\pi " :db/id #edb/ref 17592186273434} {:answer/id #uuid "f4a81b9a-6184-5c07-b9b7-3776ebdd135d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18-\\frac{9}{4}\\pi " :db/id #edb/ref 17592186274548}] :answer-field/correct {:answer/id #uuid "79cbbd07-05f3-5b26-b56b-2e5c156b29a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16-\\frac{9}{4}\\pi " :db/id #edb/ref 17592186273434} :answer-field/id #uuid "a58832ef-928d-5526-a036-f79a9bc5c32f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274925}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "69bdc4f2-1ce2-56ea-a305-35d352a03390" :question/math-academy-id "q-155948" :question/problem "![](images/d4/d41d681a2f0e7a32400d863e60294efc9864ff6245de0e36515986da656ddbd2.png)\n\nThe graph of the function $y=f(x)$ is shown above. It consists of two lines and the arc of a quarter-circle of radius $3.$ Given $g(t)={\\int }_{0}^{t}f(x)\\,\\text{d}x,$ determine the value of $g(5).$" :question/worked-solution "Evaluating $g(t)$ at $t=5,$ we get the following definite integral:\n\n$$\ng(5)={\\int }_{0}^{5}f(x)\\,\\text{d}x\n$$\n\nThis integral gives the signed area between the curve and the $x$-axis shown below.\n\n![](images/7d/7db30a3be837d9303ce4fca0b5a95466a74fe53f1ce81e6fa0febe2ef00625b5.png)\n\nNote that the graph above consists of $2$ parts:\n\n- $x\\in [0,2],$ for which the region between the curve and the $x$-axis is a triangle. This corresponds to the area ${A}_{1}.$\n\n- $x\\in [2,5],$ for which the region between the curve and the $x$-axis is a quarter-circle cut out of a rectangle. This corresponds to the area ${A}_{2}.$\n\nTherefore, we can write the integral as follows:\n\n$$\ng(5)={\\int }_{0}^{5}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{0}^{2}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{2}^{5}f(x)\\,\\text{d}x}_{{A}_{2}}\n$$\n\nNow, let's compute these integrals:\n\n- To find the first integral where $x\\in [0,2],$ we compute the area ${A}_{1}$ of the triangle as follows:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 4 \\\\  & =4\\end{aligned}\n$$\n\n- To find the second integral where $x\\in [2,5],$ we compute the area ${A}_{2}$ of the quarter-circle cut out of a rectangle as follows:\n\n$$\n\\begin{aligned}{A}_{2} & =bh-\\frac{1}{4}\\pi {r}^{2} \\\\  & =3\\cdot 4-\\frac{1}{4}\\pi \\cdot {3}^{2} \\\\  & =12-\\frac{9}{4}\\pi \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}g(5) & ={\\int }_{0}^{5}f(x)\\,\\text{d}x \\\\  & ={A}_{1}+{A}_{2} \\\\  & =4+(12-\\frac{9}{4}\\pi ) \\\\  & =16-\\frac{9}{4}\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069298 :knowledge-point/_questions [{:db/id #edb/ref 17592186068720 :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/title "Determining the Length of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb02b8c2-6052-5344-bd63-76a305de6ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186066959} {:answer/id #uuid "1ed8914b-2c33-5cd7-b590-24eb9cc510af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186066960} {:answer/id #uuid "31364172-3f62-5555-8a11-471d0ccd8975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186066961} {:answer/id #uuid "3642a4f3-446d-56be-adcc-079047c7073c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186066962} {:answer/id #uuid "63cd08d2-1c61-50aa-9bc5-af6124683d74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186066963}] :answer-field/correct {:answer/id #uuid "cb02b8c2-6052-5344-bd63-76a305de6ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186066959} :answer-field/id #uuid "696fc38f-3bfd-5221-8c8a-f75c6758af31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066958}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c3f5ab6-4dad-5406-88ac-0eb7720cb5c9" :question/math-academy-id "q-3701" :question/problem "![](images/9a/9a2fe4ad55bbc2853ce6f0507780292ae01616df0a2595ff108e674eb91b2557.png)\n\nWhat is the length of $\\overset{―}{AB}?$" :question/worked-solution "From the figure, we note that the points $A$ and $B$ have coordinates $\\underbrace{(4,2)}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and $\\underbrace{(8,3)}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively. \n\nTo find the distance $AB,$ we can use the distance formula:\n\n$$\n\\begin{aligned}AB & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(8-4)^{2}+(3-2)^{2}} \\\\  & =\\sqrt{{4}^{2}+{1}^{2}} \\\\  & =\\sqrt{16+1} \\\\  & =\\sqrt{17}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069299 :knowledge-point/_questions [{:db/id #edb/ref 17592186068721 :knowledge-point/id #uuid "bdded031-fd95-5a7f-92d4-c0d6713ba64d" :knowledge-point/title "Calculating the Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84f9576b-3c49-58d5-b0cf-3be799853487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{27}" :db/id #edb/ref 17592186066965} {:answer/id #uuid "ed906fd7-c616-5b92-98ac-8e345f436178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186066966} {:answer/id #uuid "fbe93849-2cb6-5c4b-92d9-24a564948aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{7}" :db/id #edb/ref 17592186066967} {:answer/id #uuid "4adb34e7-c885-5b78-aaa4-9bed521b95d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186066968} {:answer/id #uuid "6dfd6889-eff1-5096-802f-6ddf0679ad20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{11}" :db/id #edb/ref 17592186066969}] :answer-field/correct {:answer/id #uuid "4adb34e7-c885-5b78-aaa4-9bed521b95d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186066968} :answer-field/id #uuid "b5f61f9a-7bb2-5f98-b5a6-d1d9290326b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066964}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e35e59e-36bb-5c2e-8441-bc45ce18079d" :question/math-academy-id "q-3702" :question/problem "What is the distance between the points $(-9,2)$ and $(-12,-4)?$" :question/worked-solution "In this case, we have $\\underbrace{(-9,2)}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and $\\underbrace{(-12,-4)}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(-12-(-9))^{2}+(-4-2)^{2}} \\\\  & =\\sqrt{(-3)^{2}+(-6)^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069301 :knowledge-point/_questions [{:db/id #edb/ref 17592186068720 :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/title "Determining the Length of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88eabd55-766f-573b-8305-9db9fb46fea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186066977} {:answer/id #uuid "b827aac1-596d-54de-9317-02f420f5b264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186066978} {:answer/id #uuid "dc9efbb1-7d26-572a-8d2c-c509a6d4a218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{13}" :db/id #edb/ref 17592186066979} {:answer/id #uuid "f4a39913-c29c-5674-8ad9-5afeccfbe7b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{3}" :db/id #edb/ref 17592186066980} {:answer/id #uuid "4e1c13fe-164d-597b-9a55-f85afdd238b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{65}" :db/id #edb/ref 17592186066981}] :answer-field/correct {:answer/id #uuid "4e1c13fe-164d-597b-9a55-f85afdd238b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{65}" :db/id #edb/ref 17592186066981} :answer-field/id #uuid "3f04668a-3df1-560e-950f-53985118bf87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066976}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94652e83-5bd0-5884-9087-2e26389b0cf2" :question/math-academy-id "q-3717" :question/problem "![](images/cd/cd878559d6be37faa60bdb33cbebe2f124d09744aa4df7dae40372499116f239.png)\n\nWhat is the length of $\\overset{―}{CD}?$" :question/worked-solution "From the figure, we note that the points $C$ and $D$ have coordinates $\\underbrace{(-5,3)}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and $\\underbrace{(2,-1)}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively.\n\nTo find the length of $\\overset{―}{CD},$ we use the distance formula:\n\n$$\n\\begin{aligned}CD & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-5))^{2}+(-1-3)^{2}} \\\\  & =\\sqrt{(7)^{2}+(-4)^{2}} \\\\  & =\\sqrt{49+16} \\\\  & =\\sqrt{65}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186074071 :knowledge-point/_questions [{:db/id #edb/ref 17592186073714 :knowledge-point/id #uuid "58e2e40e-209b-5bc7-98df-11841c2bbcc3" :knowledge-point/title "Finding the Midpoint of a Segment With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf240b6-f61f-518a-b330-8c680ccea02f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a" :db/id #edb/ref 17592186514933}] :answer-field/correct {:answer/id #uuid "1bf240b6-f61f-518a-b330-8c680ccea02f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a" :db/id #edb/ref 17592186514933} :answer-field/id #uuid "eee5b7ab-c133-57eb-9614-aeff1522c54c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186070332} {:answer-field/choices [{:answer/id #uuid "b7cf5be2-d878-5497-9973-b2239ae30dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9b}{2}" :db/id #edb/ref 17592186515261}] :answer-field/correct {:answer/id #uuid "b7cf5be2-d878-5497-9973-b2239ae30dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9b}{2}" :db/id #edb/ref 17592186515261} :answer-field/id #uuid "5e65decf-258e-5566-95ef-5b3bd98f8cc1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186070333}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "da9fefdc-bf24-5050-9662-b6463d7dc33f" :question/math-academy-id "q-216932" :question/problem "The midpoint of the line segment with endpoints $(a,2b)$ and $(5a,7b)$\n is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between $\\underbrace{(p,-3q)}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and $\\underbrace{(-p,7q)}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{a+5a}{2},\\frac{2b+7b}{2}) \\\\  & =(\\frac{6a}{2},\\frac{9b}{2}) \\\\  & =(3a,\\frac{9b}{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186074139 :knowledge-point/_questions [{:db/id #edb/ref 17592186073813 :knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46bc5913-03ca-59ff-878f-3350f942df73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186290923}] :answer-field/correct {:answer/id #uuid "46bc5913-03ca-59ff-878f-3350f942df73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186290923} :answer-field/id #uuid "7852caf8-ac75-5b37-806d-66b7aa1053fe" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "be6f8905-1467-503f-ba88-c62f8817fc60" :question/math-academy-id "q-262211" :question/problem "The distance between the points $A(3,5,-1)$ and $B(4,3,1)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nIn this case, we have $A\\underbrace{(3,5,-1)}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B\\underbrace{(4,3,1)}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(4-3)^{2}+(3-5)^{2}+(1-(-1))^{2}} \\\\  & =\\sqrt{{1}^{2}+(-2)^{2}+{2}^{2}} \\\\  & =\\sqrt{1+4+4} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186074527 :knowledge-point/_questions [{:db/id #edb/ref 17592186073814 :knowledge-point/id #uuid "d4e178c7-bdb4-5139-a20c-3e17de51ee11" :knowledge-point/title "Calculating the Distance Between Two Points With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d07dc9-5ddb-5165-8be1-3c6fdcc74538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186361132} {:answer/id #uuid "62f3cd10-a056-516c-9d92-dd46cb177f7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 5" :db/id #edb/ref 17592186361282} {:answer/id #uuid "be602886-38c0-5bce-875d-2a4515ea540d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186361691} {:answer/id #uuid "f6ecbdf4-0396-5a02-895e-7d0163f303ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186361941} {:answer/id #uuid "f6ed503d-7c82-53ff-a8db-6bdab1efbcf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3" :db/id #edb/ref 17592186361942}] :answer-field/correct {:answer/id #uuid "f6ed503d-7c82-53ff-a8db-6bdab1efbcf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3" :db/id #edb/ref 17592186361942} :answer-field/id #uuid "c83cccd4-1777-5bee-b802-ffb71dec0d6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362164}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "80fbb873-e940-547c-85d1-534e3310a7c5" :question/math-academy-id "q-97794" :question/problem "Consider the points $A(p,2p,3p)$ and $B(p,-2p,6p).$ Given that the distance between $A$ and $B$ is $15,$ find the possible values of $p.$" :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A\\underbrace{(p,2p,3p)}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B\\underbrace{(p,-2p,6p)}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(p-p{)}^{2}+(-2p-2p{)}^{2}+(6p-3p{)}^{2}} \\\\  & =\\sqrt{{0}^{2}+(-4p{)}^{2}+(3p{)}^{2}} \\\\  & =\\sqrt{16{p}^{2}+9{p}^{2}} \\\\  & =\\sqrt{25{p}^{2}} \\\\  & =5\\,|p|.\\end{aligned}\n$$\n\nFinally, since $d=15,$ we get\n\n$$\n\\begin{aligned}5\\,|p| & =15 \\\\ |p| & =3 \\\\ p & =\\pm 3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078311 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078599 :knowledge-point/id #uuid "fb30dbbf-4f83-59d0-b712-f0e592aafb27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Curved Function Given Its Graph"}] :question/id #uuid "189d4a9a-fb2c-57b2-b9f6-9bec14fa1062" :question/math-academy-id "e-434" :question/problem "![](images/36/36c6a1c84e0b0c32a5fd35fd422645f60340da6d205dd8cc31054cd558c2f5f9.png)\n\nGiven the graph of $y=f(x)$ above, find the value of $\\displaystyle \\int_{-4}^4 f(x) \\,\\textrm{d}x.$" :question/worked-solution "The graph consists of four parts: the arc of a semi-circle for $x\\in [-4,0],$ a line segment for $x\\in (0,2),$ a line segment for $x\\in (2,4],$ and the point at $x=2.$ So, we can use the additive property of integrals to get\n\n$$\n\\begin{aligned}{\\int }_{-4}^{4}f(x)\\,\\text{d}x & ={\\int }_{-4}^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{4}f(x)\\,\\text{d}x \\\\  & =\\underbrace{{\\int }_{-4}^{0}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{0}^{2}f(x)\\,\\text{d}x}_{-{A}_{2}}+0+\\underbrace{{\\int }_{2}^{4}f(x)\\,\\text{d}x}_{{A}_{3}}.\\end{aligned}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x \\in [-4,0].$ The corresponding region is a semi-circle with a radius of $2,$ so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\cdot \\pi \\cdot {2}^{2} \\\\  & =2\\pi .\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x \\in (0,2).$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n\\int_{0}^{2} f(x)\\: \\textrm{d}x = -A_2 = -2.\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x \\in (2,4].$  The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\int }_{-4}^{4}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}+{A}_{3} \\\\  & =2\\pi -2+2 \\\\  & =2\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078326 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078476 :knowledge-point/id #uuid "f34dff99-e52d-5d41-921b-f481c03f945b" :knowledge-point/title "Calculating the Time It Takes a Particle to Travel a Given Distance"}] :question/id #uuid "a996189e-632a-5b6c-b61a-b1a8eb7928e5" :question/math-academy-id "e-570" :question/problem "The velocity of a particle, in meters per second, is given by $v(t) = 12-3t^2$, where $t>0$ is the time in seconds. Calculate the time taken for the particle to travel $32\\,\\textrm m$." :question/worked-solution "To find the total distance traveled, we first need to find the points where the particle changes its direction, which can only occur when the velocity is zero. Solving $v(t) = 0$, we get\n\n$$\n\\begin{aligned}\n12 - 3t^{2} &= 0 \\\\\n- 3(t^{2} - 4) &= 0 \\\\\nt &= ± 2\n\\end{aligned}\n$$\n\nA sketch of $v(t)$ is shown below:\n\n![](images/ca/caea9bf724b2d9f6abc7434bebe401e28170d669390216e0b4998cf1c5d0481d.png)\n\nNotice that in the interval\n\n$$\n0\\leq t\\leq T\n$$\n\nfor $T > 2$, the curve $v(t)$ crosses the $t$-axis at $t=2$. Therefore, we need to split up the distance integral between the intervals\n\n$$\n0\\leq t\\leq 2\n$$\n\nand\n\n$$\n2\\leq t\\leq T\n$$\n\nIn the interval\n\n$$\n0\\leq t\\leq 2\n$$\n\nwe have $v(t) > 0$. Therefore,\n\n$$\n\\mid v(t) \\mid = v(t) =12-3t^2\n$$\n\nWe can work out the total distance traveled in the interval $0 < t < 2$ as follows:\n\n$$\n\\begin{aligned}\nd &= \\int_{0}^{2} \\mid v(t) \\mid dt \\\\\n&= \\int_{0}^{2}(12 - 3t^{2})dt \\\\\n&= \\left.(12t - t^{3})\\right|_{0}^{2} \\\\\n&= 12(2) - 2^{3} \\\\\n&= 16\n\\end{aligned}\n$$\n\nSince $16 < 32$, the time taken for the particle to travel $32\\,\\textrm{m}$ is greater than $2$ seconds.\n\nNow, in the interval\n\n$$\n2\\leq t\\leq T\n$$\n\nfor $T>2$, we have $v(t)<0$. Therefore,\n\n$$\n\\mid v(t) \\mid =-v(t) = 3t^2-12\n$$\n\nTherefore, an expression for the total distance $d$ traveled between $t=0$ and $t=T$ for $T >2$ is given by\n\n$$\n\\begin{aligned}d(T) & ={\\int }_{0}^{T}|v(t)|\\,\\text{d}t \\\\  & =\\underbrace{{\\int }_{0}^{2}|v(t)|\\,\\text{d}t}_{16}+{\\int }_{2}^{T}|v(t)|\\,\\text{d}t \\\\\n&= 16 + \\int_{2}^{T}(3t^{2} - 12)dt \\\\\n&= 16 + \\left.(t^{3} - 12t)\\right|_{2}^{T} \\\\\n&= 16 + [(T^{3} - 12T) - ((2)^{3} - 12(2)] \\\\\n&= 16 + T^{3} - 12T - (-16) \\\\\n&= T^{3} - 12T + 32\n\\end{aligned}\n$$\n\nFinally, the particle travels $32\\,\\textrm{m}$ when $d = 32$. So, we can solve for $T$ as follows:\n\n$$\n\\begin{aligned}\nT^{3} - 12T + 32 &= 32 \\\\\nT^{3} - 12T &= 0 \\\\\nT(T^{2} - 12) &= 0\n\\end{aligned}\n$$\n\nThe solutions are $T=0$ and\n\n$$\nT=\\pm 2\\sqrt 3\n$$\n\nSince we require $T> 2$, the only valid solution is\n\n$$\nT=2\\sqrt 3\n$$\n\nTherefore, we conclude that it takes $2\\sqrt 3$ seconds for the particle to travel a total of $32\\,\\textrm{m}$."}] [{:db/id #edb/ref 17592186078742 :knowledge-point/_questions [{:db/id #edb/ref 17592186078599 :knowledge-point/id #uuid "fb30dbbf-4f83-59d0-b712-f0e592aafb27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Curved Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04be3474-c461-553c-9ea3-6322350b3471" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}-\\frac{5}{2}" :db/id #edb/ref 17592186272429} {:answer/id #uuid "066edf54-8477-5e26-9de1-41b8ffcadf87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}-\\frac{11}{2}" :db/id #edb/ref 17592186272445} {:answer/id #uuid "0e1f885e-7af3-560f-aaa7-fd942152bc4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+\\frac{11}{2}" :db/id #edb/ref 17592186272512} {:answer/id #uuid "84c845ff-71a2-5e7e-aa00-11268580a694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi +\\frac{5}{2}" :db/id #edb/ref 17592186273526} {:answer/id #uuid "dc24b407-c8ff-50c0-a2e8-0c63ff23e16b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -\\frac{11}{2}" :db/id #edb/ref 17592186274321}] :answer-field/correct {:answer/id #uuid "066edf54-8477-5e26-9de1-41b8ffcadf87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}-\\frac{11}{2}" :db/id #edb/ref 17592186272445} :answer-field/id #uuid "8162b54d-db61-5580-ac50-3a0b4ec28032" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274856}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6d92bae-c31c-5150-ab78-b947f40806f3" :question/math-academy-id "q-14785" :question/problem "![](images/82/824f039d5f015a2cd2165cfd469c44e7f3e5a0cda6416964ec91d57de4ca06eb.png)\n\nGiven the graph of $y=f(x)$ above, find the value of \n${\\int }_{-3}^{4}f(x)\\,\\text{d}x.$" :question/worked-solution "The graph consists of $3$ parts: the line segment for $x\\in [-3,1),$ the arc of the semi-circle for $x\\in [1,3],$ and the line segment for $x\\in [3,4].$ So, we can use the additive property of integrals to get\n\n$$\n{\\int }_{-3}^{4}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-3}^{1}f(x)\\,\\text{d}x}_{-{A}_{1}}+\\underbrace{{\\int }_{1}^{3}f(x)\\,\\text{d}x}_{{A}_{2}}+\\underbrace{{\\int }_{3}^{4}f(x)\\,\\text{d}x}_{-{A}_{3}}.\n$$\n\nThe $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,1).$ The corresponding region is a rectangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =b\\cdot h \\\\  & =4\\cdot 1 \\\\  & =4.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{-3}^{1}f(x)\\,\\text{d}x=-{A}_{1}=-4.\n$$\n\nThe $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,3].$ The corresponding region is a semi-circle of radius of $1,$ so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot {1}^{2} \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThe $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in [3,4].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 1\\cdot 3 \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{3}^{4}f(x)\\,\\text{d}x=-{A}_{3}=-\\frac{3}{2}.\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-3}^{4}f(x)\\,\\text{d}x & =-{A}_{1}+{A}_{2}-{A}_{3} \\\\  & =-4+\\frac{\\pi }{2}-\\frac{3}{2} \\\\  & =\\frac{\\pi }{2}-\\frac{11}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186079028 :knowledge-point/_questions [{:db/id #edb/ref 17592186078599 :knowledge-point/id #uuid "fb30dbbf-4f83-59d0-b712-f0e592aafb27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Curved Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047d0dae-ba32-5084-8a62-636cb99a85ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10+\\pi " :db/id #edb/ref 17592186329997} {:answer/id #uuid "2251ad24-93f5-541c-94c1-e5f45666d8e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10+\\frac{3\\pi }{4}" :db/id #edb/ref 17592186330245} {:answer/id #uuid "350ec92b-3b33-550e-98ae-c6388a1e7dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10+\\frac{\\pi }{2}" :db/id #edb/ref 17592186330418} {:answer/id #uuid "8e082862-545d-5ee7-a848-b21af124a208" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5+\\frac{\\pi }{2}" :db/id #edb/ref 17592186331209} {:answer/id #uuid "d541f91b-3243-57ac-bebb-7f090b35a0f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5+\\pi " :db/id #edb/ref 17592186331840}] :answer-field/correct {:answer/id #uuid "350ec92b-3b33-550e-98ae-c6388a1e7dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10+\\frac{\\pi }{2}" :db/id #edb/ref 17592186330418} :answer-field/id #uuid "f2bc983b-7068-5e46-9cca-27e93d979147" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332629}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b82eafa4-95ed-5313-a838-9f9ba69b6d8c" :question/math-academy-id "q-49176" :question/problem "![](images/83/83b23d8138091a931d14854b197752d25d8149ee8914a70b8db73b6c2369c888.png)\n\nGiven the graph of $y=f(x)$ above, find the value of \n${\\int }_{-2}^{5}f(x)\\,\\text{d}x.$" :question/worked-solution "The graph consists of $2$ parts: the line segment for $x\\in [-2,3)$ and the arc of the semi-circle for $x\\in [3,5].$ So, we can use the additive property of integrals to get\n\n$$\n{\\int }_{-2}^{5}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-2}^{3}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{3}^{5}f(x)\\,\\text{d}x}_{{A}_{2}}.\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,3).$ The corresponding region is a rectangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =b\\cdot h \\\\  & =5\\cdot 2 \\\\  & =10.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [3,5].$ The corresponding region is a semi-circle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot (1)^{2} \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-1}^{4}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =10+\\frac{\\pi }{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186079031 :knowledge-point/_questions [{:db/id #edb/ref 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6da09971-d18a-517e-837a-1ae929a36450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186330931} {:answer/id #uuid "6f8d478a-1ba6-5f62-b143-f7f72432d5d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186330952} {:answer/id #uuid "a0853054-a923-5bfe-a4dc-1adbf736f782" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186331393} {:answer/id #uuid "c3bca575-9417-563a-aa89-0c141860499e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186331689} {:answer/id #uuid "d1c7db8b-1197-535c-93e6-79f664700fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186331809}] :answer-field/correct {:answer/id #uuid "d1c7db8b-1197-535c-93e6-79f664700fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186331809} :answer-field/id #uuid "290eee76-ccd7-5913-b3ef-8e50f7a1aa22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "52eaba02-6281-525d-9a0d-b8e586eda5f3" :question/math-academy-id "q-49212" :question/problem "![](images/69/69669250982a974c17cba2d70f27077f9c523ef184ff3f09650ea8d439428589.png)\n\nThe graph of $y=f(x),$ shown above, consists of two line segments. Find the value of ${\\int }_{-3}^{3}f(x)\\,\\text{d}x.$" :question/worked-solution "We divide the interval of integration into $3$ regions: the line segment for $x\\in [-3,-1],$ the line segment for $x\\in [-1,0),$ and the line segment for $x\\in [0,3].$ Therefore, we write the required integral as follows:\n\n$$\n{\\int }_{-3}^{3}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-3}^{-1}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{-1}^{0}f(x)\\,\\text{d}x}_{-{A}_{2}}+\\underbrace{{\\int }_{0}^{3}f(x)\\,\\text{d}x}_{{A}_{3}}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,-1].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-1,0).$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(1\\cdot 1) \\\\  & =0.5.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{-1}^{0}f(x)\\,\\text{d}x=-{A}_{2}=-0.5.\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in [0,3].$ The corresponding region is a trapezoid, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}(a+b)h \\\\  & =\\frac{1}{2}(1+2)(3) \\\\  & =4.5.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-3}^{3}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}+{A}_{3} \\\\  & =2-0.5+4.5 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087484 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087676 :knowledge-point/id #uuid "b39e0fa6-1cff-518b-886d-6a8295554faf" :knowledge-point/title "Finding Exact Values of Advanced Trigonometric Expressions Using the Double-Angle Formula"}] :question/id #uuid "2621b992-c4ff-5fc5-b3c1-cd148069a8de" :question/math-academy-id "e-3679" :question/problem "Simplify $\\dfrac {3\\tan 35^\\circ}{2 - \\sec^2 35^\\circ}$." :question/worked-solution "First, we simplify the given expression using the identity\n\n$$\n\\sec^2 x = 1 + \\tan^2 x\n$$\n\n$$\n\\begin{aligned}\n\\frac{3\\tan 35^{∘}}{2 - \\sec^{2} 35^{∘}} &= (3\\tan 35^{∘})/(2 - (1 + \\tan^{2} 35^{∘})) \\\\\n&= \\frac{3\\tan 35^{∘}}{1 - \\tan^{2} 35^{∘}}\n\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for tangent:\n\n$$\n\\dfrac {2\\tan x}{1 - \\tan^2 x} = \\tan 2x\n$$\n\nSubstituting $x=35^\\circ$ in the above, we get\n\n$$\n\\begin{aligned}\n\\frac{2\\tan 35^{∘}}{1 - \\tan^{2} 35^{∘}} &= \\tan (2 \\cdot 35^{∘}) = \\tan 70^{∘}\n\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\n\\frac{3\\tan 35^{∘}}{1 - \\tan^{2} 35^{∘}} &= \\frac{3}{2} \\cdot \\underbrace{[\\frac{2\\tan 35^{∘}}{1 - \\tan^{2} 35^{∘}}]}_{\\tan {70}^{∘}} = \\frac{3}{2}\\tan 70^{∘}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087599 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087866 :knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/id #uuid "dc93ac2d-3588-5dc4-9cf8-3df1f17c353d" :question/math-academy-id "e-6599" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\dfrac {\\textrm{d}y} {\\textrm{d}x}\n+\ny\\sin x\n-\n\\cos x\n=0\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\dfrac {\\textrm{d}y} {\\textrm{d}x}\n+\nP(x)y\n=\nQ(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}+y\\operatorname{sin}⁡x-\\operatorname{cos}⁡x & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x}+y\\operatorname{sin}⁡x & =\\operatorname{cos}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(\\operatorname{sin}⁡x)}_{P(x)}y & =\\underbrace{\\operatorname{cos}⁡x}_{Q(x)}\\,.\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=\\sin x$ and $Q(x) = \\cos x.$"}] [{:db/id #edb/ref 17592186088032 :knowledge-point/_questions [{:db/id #edb/ref 17592186087866 :knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab721a7c-ebb0-5452-b247-5d3816198bf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (4\\sin x)y = 1 + 3\\cos x" :db/id #edb/ref 17592186084927} {:answer/id #uuid "b319152d-c291-5494-a461-4791daa6c062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (4\\cos x)y = 1 + 3\\sin x" :db/id #edb/ref 17592186084928} {:answer/id #uuid "c17d0099-f48a-51bc-b6bf-feeec39e8bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (2\\sin x)y = \\frac{1 + 3\\cos x}{2}" :db/id #edb/ref 17592186084929} {:answer/id #uuid "2a507547-4026-5e0f-ae6c-972cd79efc1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + \\frac{1 + 3\\cos x}{2} = (2\\sin x)y" :db/id #edb/ref 17592186084930} {:answer/id #uuid "606289fa-36e0-57ab-b7c2-57b9dbbb4540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (2\\sin x)y = 1 + \\frac{3}{2}\\cos x" :db/id #edb/ref 17592186084931}] :answer-field/id #uuid "2e534d32-a3b5-5b67-a30a-d8fb0702e472" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084926} {:answer-field/choices [{:answer/id #uuid "c4bcf009-6fca-5110-8ae8-643678b3cb9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(2\\operatorname{sin}⁡x)y=\\frac{1+3\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186401434 :task-item/_responses [{:db/id #edb/ref 17592186409291}]} {:answer/id #uuid "eb82a4b2-58af-556c-a366-f92624768704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(4\\operatorname{sin}⁡x)y=1+3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186401435} {:answer/id #uuid "f4a26a57-987c-5668-b531-e2f3db2b75bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(2\\operatorname{sin}⁡x)y=1+\\frac{3}{2}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186401436} {:answer/id #uuid "b6972414-a235-5987-855e-567ba571b605" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(4\\operatorname{cos}⁡x)y=1+3\\operatorname{sin}⁡x" :db/id #edb/ref 17592186401437} {:answer/id #uuid "e08cc03c-cea4-583d-b68b-e5c8622f76e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+\\frac{1+3\\operatorname{cos}⁡x}{2}=(2\\operatorname{sin}⁡x)y" :db/id #edb/ref 17592186401438}] :answer-field/correct {:answer/id #uuid "c4bcf009-6fca-5110-8ae8-643678b3cb9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(2\\operatorname{sin}⁡x)y=\\frac{1+3\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186401434} :answer-field/id #uuid "ef647b19-79e2-5b54-b8df-1bf5fe9db9b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5c269fd-ead8-50e4-b16e-9d9e9b4a244c" :question/math-academy-id "q-16400" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n2\\frac{\\text{d}y}{\\text{d}x}-3\\operatorname{cos}⁡x=1-4y\\operatorname{sin}⁡x\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}2\\frac{\\text{d}y}{\\text{d}x}-3\\operatorname{cos}⁡x & =1-4y\\operatorname{sin}⁡x \\\\ 2\\frac{\\text{d}y}{\\text{d}x}+4y\\operatorname{sin}⁡x & =1+3\\operatorname{cos}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(2\\operatorname{sin}⁡x)}_{P(x)}y & =\\underbrace{\\frac{1+3\\operatorname{cos}⁡x}{2}}_{Q(x)}.\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=2\\operatorname{sin}⁡x$ and $Q(x)=\\frac{1+3\\operatorname{cos}⁡x}{2}.$"}] [{:db/id #edb/ref 17592186088219 :knowledge-point/_questions [{:db/id #edb/ref 17592186087709 :knowledge-point/id #uuid "8e2458e5-8061-5f3f-9b4f-4d0bdd0ec641" :knowledge-point/title "Identifying Equations Written in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef77e145-5232-5daf-8b5f-0fb282cf9be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186085969} {:answer/id #uuid "31d269e4-a2d4-5b5c-85aa-76e93abcc2d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186085970} {:answer/id #uuid "3551a33d-6664-58b2-9a9b-881dde1b9a0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186085971} {:answer/id #uuid "4b0896f6-a2c8-565f-b6c2-08b572b5a62b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186085972} {:answer/id #uuid "6e44c0d4-a88e-511b-a1ea-ce56e6698eb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186085973}] :answer-field/correct {:answer/id #uuid "6e44c0d4-a88e-511b-a1ea-ce56e6698eb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186085973} :answer-field/id #uuid "7f2db0c7-16fd-5c37-b274-a36499dcdd56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085968}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "079b3242-4c32-569f-b103-9bf2414bbafc" :question/math-academy-id "q-59668" :question/problem "Consider the equations of the following lines.\n\nI. $2x=3$\n\nII. $-x+2y=3$\n\nIII. $x-2y=0$\n\nWhich of these lines is written in standard form?" :question/worked-solution "The *standard form* equation of a line is \n\n$$\nax+by=c,\n$$\n\nwhere\n\n- $a,b,$ and $c$ are all integers,\n\n- $a\\ge 0,$ and\n\n- $a,b,$ and $c$ have no common factors greater than $1.$\n\nWith that in mind, let's examine our equations.\n\n- Equation I is in standard form. Indeed, the variables are on the left-hand side, while the constant term is on the right-hand side:\n\n$$\n\\underbrace{2x}_{\\text{variables}}\\,=\\underbrace{3}_{\\text{constant}}\n$$\n\n \nAll coefficients are integers (namely, $2$ and $3$) and don't have common factors greater than $1.$ Also, the coefficient of $x$ is positive ($2$).\n\n- Equation II is *not* in standard form because the coefficient of $x$ is negative ($-1$).\n\n- Equation III is in standard form. Indeed, the variables are on the left-hand side, while the constant term is on the right-hand side:\n\n$$\n\\underbrace{x-2y}_{\\text{variables}}\\,=\\underbrace{0}_{\\text{constant}}\n$$\n\n \nAll coefficients are integers (namely, $1,$ $-2,$ and $0$) and don't have common factors greater than $1.$ Also, the coefficient of $x$ is positive ($1$).\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186088420 :knowledge-point/_questions [{:db/id #edb/ref 17592186087866 :knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d56ade3-8c2b-558b-8dee-d6c16408ae98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x-x\\frac{\\text{d}y}{\\text{d}x}" :db/id #edb/ref 17592186348562} {:answer/id #uuid "19d75fc4-d565-5247-a3d2-0dd1d71481b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+\\frac{1}{x}y-2=0" :db/id #edb/ref 17592186348663} {:answer/id #uuid "33f582cb-d125-5a7e-bc13-6fd636ea22e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\frac{\\text{d}y}{\\text{d}x}+y=2x" :db/id #edb/ref 17592186348913} {:answer/id #uuid "a15aa42d-fc0c-537c-988d-61613c47dc74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{x}y+2" :db/id #edb/ref 17592186349879} {:answer/id #uuid "e907ba10-aa76-5dbf-bb32-8f9829e3aeb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+\\frac{1}{x}y=2" :db/id #edb/ref 17592186350489 :task-item/_responses [{:db/id #edb/ref 17592186409292}]}] :answer-field/correct {:answer/id #uuid "e907ba10-aa76-5dbf-bb32-8f9829e3aeb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+\\frac{1}{x}y=2" :db/id #edb/ref 17592186350489} :answer-field/id #uuid "57ee4a69-5c37-5b5b-9d83-fd6eb1f2f193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9fbd67f9-88e1-5554-8625-84ac1e940645" :question/math-academy-id "q-8359" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2x-y}{x}\\,.\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x-y}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x}{x}-\\frac{y}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & +\\frac{y}{x}=\\frac{2x}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & +\\underbrace{\\frac{1}{x}}_{P(x)}y=\\underbrace{2}_{Q(x)}\\,.\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=\\frac{1}{x}$ and $Q(x)=2.$"}] [{:db/id #edb/ref 17592186091949 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092190 :knowledge-point/id #uuid "b83c640f-c7fd-5adc-94b8-b129d357b140" :knowledge-point/title "Proving Polynomial Inequalities"}] :question/id #uuid "6b8b1014-56bf-51c0-be9e-a194181a0d99" :question/math-academy-id "e-13225" :question/problem "Use mathematical induction to prove that $n^2 > 2n+2$ for all $n \\geq 3, n\\in \\mathbb N.$" :question/worked-solution "The principle of induction states the following: Suppose we have a sequence of mathematical statements $P(1), P(2), P(3),\\ldots,$ where\n\n- $P(1)$ is true, and\n\n- $P(k)\\Rightarrow P(k+1)$ for every $k\\in\\mathbb N.$\n\nThen, $P(n)$ is true for every $n\\in\\mathbb N.$\n\nIn this case, the general statement $P(n)$ we're required to prove is the following:\n\n$$\nn^2 > 2n+2 \\quad\\text{for}\\quad n \\geq 3.\n$$\n\nWe start by proving the so-called base case. Since we are required to prove the statement for $n \\geq 3,$ the base case is $P(3).$ So, we substitute $n=3$ into both the left-hand side and right-hand side and show that the left-hand side is greater than the right-hand side:\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove our statement is true for the base case $n=3.$\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{3}^{2}=9,\\end{aligned}\n$$\n\nand for the right-hand side, we have\n\n$$\n\\begin{aligned}2(3)+2=8,\\end{aligned}\n$$\n\nThus, our statement is true for $n=3.$\n\nNext, we state our inductive hypothesis. Here, we assume that the given statement is true for some $n=k\\geq 3.$ \n\n**Inductive Hypothesis**: We assume that for some $n=k\\geq 3,$ we have\n\n$$\nk^2 > 2k+2.\n$$\n\nWe must show that $P(k)\\Rightarrow P(k+1).$ Let's start by writing down $P(k+1).$ This is the first part of the so-called **inductive step**.\n\n**Inductive Step**: We're required to prove that\n\n$$\n(k+1)^2 > 2(k+1)+2 . \\qquad\\qquad (\\ast)\n$$\n\nThe idea is to rewrite the left-hand side of $(\\ast)$ *using the inductive hypothesis* and apply algebraic techniques to show that this is greater than the right-hand side. We do this as follows:\n\nWe write\n\n$$\n\\begin{aligned}(k+1)^{2} & ={k}^{2}+2k+1.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}{k}^{2}+2k+1 & =\\underbrace{({k}^{2})}_{>2k+2}+2k+1 \\\\  & >2k+2+2k+1 \\\\  & =2k+2+\\underbrace{2k}_{>1}+1 \\\\  & >2(k+1)+2,\\end{aligned}\n$$\n\nas required.\n\nSince we've shown that the left-hand side of $(\\ast)$ is greater than the right-hand side, our proof is complete. So, let's write down our conclusion. \n\nTherefore, by the principle of induction, $n^2 > 2n+2$ for all $n \\geq 3.$"}] [{:db/id #edb/ref 17592186091950 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092191 :knowledge-point/id #uuid "82830730-a9bc-57bd-9114-d0d50473ea63" :knowledge-point/title "Proving Other Inequalities"}] :question/id #uuid "f5d8d9e3-d45c-5ad9-aae7-7933e6f4fade" :question/math-academy-id "e-13227" :question/problem "Use mathematical induction to prove that $2^n +1 \\leq 3^n$ for $n\\in\\mathbb N.$" :question/worked-solution "The principle of induction states the following: Suppose we have a sequence of mathematical statements $P(1), P(2), P(3), \\ldots,$ where\n\n- $P(1)$ is true, and\n\n- $P(k) \\Rightarrow P(k+1)$ for every $k \\in \\mathbb N.$\n\nThen, $P(n)$ is true for every $n\\in\\mathbb N.$\n\nIn this case, the general statement $P(n)$ we're required to prove is the following:\n\n$$\n2^n +1 \\leq 3^n \\quad\\text{for} \\quad n \\geq 1.\n$$\n\nWe start by proving the so-called base case, $P(1).$ To do this, we substitute $n = 1$ into both the left-hand side and right-hand side and show that the left-hand side is less than or equal to the right-hand side:\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove our statement is true for the base case $n = 1.$\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{2}^{1}+1=3,\\end{aligned}\n$$\n\nand for the right-hand side, we have\n\n$$\n\\begin{aligned}{3}^{1}=3,\\end{aligned}\n$$\n\nThus, our statement is true for $n = 1.$\n\nNext, we state our inductive hypothesis. Here, we assume that the given statement is true for some $n = k \\geq 1.$ \n\n**Inductive Hypothesis**: We assume that for some $n = k \\geq 1,$ we have\n\n$$\n2^k +1 \\leq 3^k.\n$$\n\nWe must show that $P(k) \\Rightarrow P(k+1).$ Let's start by writing down $P(k+1).$ This is the first part of the so-called **inductive step**.\n\n**Inductive Step**: We're required to prove that\n\n$$\n2^{k+1} + 1\\leq 3^{k+1}. \\qquad\\qquad (\\ast)\n$$\n\nThe idea is to rewrite the left-hand side of $(\\ast)$ *using the inductive hypothesis* and apply algebraic techniques to show that this is less than or equal to the right-hand side. We do this as follows:\n\nWe write\n\n$$\n\\begin{aligned}{2}^{k+1}+1 & ={2}^{k}\\cdot {2}^{1}+1 \\\\  & =2({2}^{k})+1 \\\\  & ={2}^{k}+{2}^{k}+1.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}{2}^{k}+\\underbrace{{2}^{k}+1}_{\\le {3}^{k}} & \\le {2}^{k}+{3}^{k} \\\\  & =\\underbrace{{2}^{k}}_{<{3}^{k}<2\\cdot {3}^{k}}+{3}^{k} \\\\  & <2\\cdot {3}^{k}+{3}^{k} \\\\  & =3\\cdot {3}^{k} \\\\  & ={3}^{k+1},\\end{aligned}\n$$\n\nas required.\n\nSince we've shown that the left-hand side of $(\\ast)$ is less than or equal to the right-hand side, our proof is complete. So, let's write down our conclusion. \n\nTherefore, by the principle of induction, $2^n +1 \\leq 3^n$ for all $n \\geq 1.$"}] [{:db/id #edb/ref 17592186092038 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092198 :knowledge-point/id #uuid "a6ac1d74-c724-5001-86af-96dfd00a41c4" :knowledge-point/title "Writing a Power of Cosine as a Sum of Cosines of Multiple Angles"}] :question/id #uuid "f191d00a-e53f-5bd6-aeff-14d8240ddc1d" :question/math-academy-id "e-5275" :question/problem "Find the value of the constant $B$ in the trigonometric identity $\\cos^3\\theta = A\\cos3\\theta + B\\cos\\theta$." :question/worked-solution "Let\n\n$$\nz = \\cos\\theta + \\textrm{i}\\sin\\theta\n$$\n\nWe start with the following identities:\n\n$$\nz + \\frac{1}{z} = 2\\cos θ, z^{n} + \\frac{1}{z^{n}} = 2\\cos nθ\n$$\n\nRaising both sides to the power $3$ in the first identity, we get\n\n$$\n\\left(z + \\dfrac{1}{z}\\right)^3 = (2\\cos\\theta)^3 =8\\cos^3\\theta\n$$\n\nNow, we expand the binomial using the binomial theorem and simplify the result using our identities, as follows:\n\n$$\n\\begin{aligned}\n(z + \\frac{1}{z})^{3} &= z^{3} + 3z^{2}(\\frac{1}{z}) + 3z(\\frac{1}{z})^{2} + (\\frac{1}{z})^{3} \\\\\n&= z^{3} + 3z + 3(\\frac{1}{z}) + \\frac{1}{z^{3}} \\\\\n&= \\underbrace{(z^{3} + \\frac{1}{z^{3}})}_{2\\cos 3\\theta } + 3\\underbrace{(z + \\frac{1}{z})}_{2\\cos \\theta } \\\\\n&= 2\\cos 3θ + 3(2\\cos θ) \\\\\n&= 2\\cos 3θ + 6\\cos θ\n\\end{aligned}\n$$\n\nSo, by equating $8\\cos^3\\theta$ with the above, we get\n\n$$\n8\\cos^3\\theta = 2\\cos3\\theta + 6\\cos\\theta\n$$\n\nFinally, we divide both sides of the equation by $8$, which gives\n\n$$\n\\cos^3\\theta = \\frac{1}{4}\\cos3\\theta + \\frac{3}{4}\\cos\\theta\n$$\n\nTherefore,\n\n$$\nB=\\dfrac{3}{4}\n$$"}] [{:db/id #edb/ref 17592186092039 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092199 :knowledge-point/id #uuid "9db1a5f8-5a2b-59d2-b9d4-23b56f231480" :knowledge-point/title "Writing an Even Power of Sine as a Sum of Cosines of Multiple Angles"}] :question/id #uuid "912e6b0d-c38b-5401-8529-18c574ac99ca" :question/math-academy-id "e-5276" :question/problem "Given the trigonometric identity\n$\\sin^4\\theta=A\\cos4\\theta + B\\cos2\\theta+C$\nwhere $A, B$ and $C$ are constants, find the value of $A$." :question/worked-solution "Let\n\n$$\nz = \\cos\\theta + \\textrm{i}\\sin\\theta\n$$\n\nWe start with the following identities:\n\n$$\n(z - \\frac{1}{z}) = 2\\textrm{i}\\sin θ(z^{n} + \\frac{1}{z^{n}}) = 2\\cos nθ\n$$\n\nRaising both sides to the power $4$ in the first identity, we get\n\n$$\n\\left(z - \\frac{1}{z}\\right)^4 \n= (2\\textrm{i}\\sin\\theta)^4\n\n=16\\sin^4\\theta .\n$$\n\nNow, we expand the binomial using the binomial theorem and simplify the result using our identities, as follows:\n\n$$\n\\begin{aligned}\n(z - \\frac{1}{z})^{4} &= z^{4} - 4z^{3}(\\frac{1}{z}) + 6z^{2}(\\frac{1}{z})^{2} - 4z(\\frac{1}{z})^{3} + (\\frac{1}{z})^{4} \\\\\n&= z^{4} - 4z^{2} + 6 - \\frac{4}{z^{2}} + \\frac{1}{z^{4}} \\\\\n&= \\underbrace{(z^{4} + \\frac{1}{z^{4}})}_{2\\cos 4\\theta } - 4\\underbrace{(z^{2} + \\frac{1}{z^{2}})}_{2\\cos 2\\theta } + 6 \\\\\n&= 2\\cos 4θ - 4(2\\cos 2θ) + 6 \\\\\n&= 2\\cos 4θ - 8\\cos 2θ + 6\n\\end{aligned}\n$$\n\nBy equating $16 \\sin^4 \\theta$ with the above, we get\n\n$$\n16\\sin^4\\theta = 2\\cos4\\theta - 8\\cos2\\theta+6\n$$\n\nFinally, we divide both sides of the equation by $16$, which gives\n\n$$\n\\sin^4\\theta = \\frac{1}{8}\\cos4\\theta - \\frac{1}{2}\\cos2\\theta+\\frac{3}{8}\n$$\n\nTherefore,\n\n$$\nA=\\dfrac{1}{8}\n$$"}] [{:db/id #edb/ref 17592186092141 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092294 :knowledge-point/id #uuid "d79266c9-bcfe-5d17-8515-aeabf113b638" :knowledge-point/title "Writing an Odd Power of Sine as a Sum of Sines of Multiple Angles"}] :question/id #uuid "1d22bfff-d44d-5ff1-9717-fab908564ed3" :question/math-academy-id "e-9214" :question/problem "Find the value of the constant $A$ in the trigonometric identity $\\sin^5\\theta = A\\sin5\\theta + B\\sin3\\theta + C\\sin\\theta$." :question/worked-solution "Let\n\n$$\nz = \\cos\\theta + \\textrm{i}\\sin\\theta\n$$\n\nWe start with the following identities:\n\n$$\n(z - \\frac{1}{z}) = 2\\textrm{i}\\sin θ(z^{n} - \\frac{1}{z^{n}}) = 2\\textrm{i}\\sin nθ\n$$\n\nRaising both sides to the power $5$ in the first identity, we get\n\n$$\n\\left(z - \\dfrac{1}{z}\\right)^5 \n= (2\\textrm{i}\\sin\\theta)^5\n\n=32\\textrm{i}\\sin^5\\theta \\,.\n$$\n\nNow, we expand the binomial using the binomial theorem and simplify the result using our identities, as follows:\n\n$$\n\\begin{aligned}\n(z - \\frac{1}{z})^{5} &= z^{5} - 5z^{4}(\\frac{1}{z}) + 10z^{3}(\\frac{1}{z})^{2} - 10z^{2}(\\frac{1}{z})^{3} + 5z(\\frac{1}{z})^{4} - (\\frac{1}{z})^{5} \\\\\n&= z^{5} - 5z^{3} + 10z - \\frac{10}{z} + \\frac{5}{z^{3}} - \\frac{1}{z^{5}} \\\\\n&= \\underbrace{(z^{5} - \\frac{1}{z^{5}})}_{2\\text{i}\\sin 5\\theta } - 5\\underbrace{(z^{3} - \\frac{1}{z^{3}})}_{2\\text{i}\\sin 3\\theta } + 10\\underbrace{(z - \\frac{1}{z})}_{2\\text{i}\\sin \\theta } \\\\\n&= 2\\textrm{i}\\sin 5θ - 5(2\\textrm{i}\\sin 3θ) + 10(2\\textrm{i}\\sin θ) \\\\\n&= 2\\textrm{i}\\sin 5θ - 10\\textrm{i}\\sin 3θ + 20\\textrm{i}\\sin θ\n\\end{aligned}\n$$\n\nBy equating $32\\textrm{i} \\sin^5 \\theta$ with the above, we get\n\n$$\n32\\textrm{i}\\sin^5\\theta = 2\\textrm{i}\\sin5\\theta - 10\\textrm{i}\\sin3\\theta + 20\\textrm{i}\\sin\\theta\n$$\n\nFinally, we divide both sides of the equation by $32\\textrm{i}$, which gives\n\n$$\n\\sin^5\\theta = \\dfrac{1}{16}\\sin5\\theta - \\dfrac{5}{16}\\sin3\\theta+\\dfrac{5}{8}\\sin\\theta\n$$\n\nTherefore,\n\n$$\nA=\\dfrac{1}{16}\n$$"}] [{:db/id #edb/ref 17592186092616 :knowledge-point/_questions [{:db/id #edb/ref 17592186092190 :knowledge-point/id #uuid "b83c640f-c7fd-5adc-94b8-b129d357b140" :knowledge-point/title "Proving Polynomial Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99ebb4a8-9428-5176-87d5-0323e4e2ca13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186089968} {:answer/id #uuid "083ceab8-7b48-5ad2-a20a-a3e419b8063e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186089969}] :answer-field/correct {:answer/id #uuid "083ceab8-7b48-5ad2-a20a-a3e419b8063e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186089969} :answer-field/id #uuid "ae45a31e-7f58-5b7b-990d-8bd5b559d995" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186089967} {:answer-field/choices [{:answer/id #uuid "a2a479cf-57b7-588c-ab4e-c6d460c4dc23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(3)" :db/id #edb/ref 17592186089971} {:answer/id #uuid "0de84a96-bbe2-5f23-a28d-110ed31a2f8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(3+1)" :db/id #edb/ref 17592186418786} {:answer/id #uuid "cb3cb1aa-3859-506e-8f7b-8fd2ebb70a48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{2}" :db/id #edb/ref 17592186418901}] :answer-field/correct {:answer/id #uuid "0de84a96-bbe2-5f23-a28d-110ed31a2f8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(3+1)" :db/id #edb/ref 17592186418786} :answer-field/id #uuid "dd1f267e-4dfd-5c4c-82f9-ca25deeabef7" :answer-field/key "field-2" :answer-field/type