45498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186426636} {:answer/id #uuid "f05ee912-848c-5303-b644-caf61efacdbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186426662}] :answer-field/correct {:answer/id #uuid "a6da0a8b-70bc-5245-8ea4-4a73b8b02822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186426636} :answer-field/id #uuid "cc69f3b3-b3cb-55bc-aad1-0a1dfe2e49ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426677}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8355da6-03a6-5e08-ab99-a085bc17f501" :question/math-academy-id "q-137254" :question/problem "$\\frac{7}{3}\\times 15=$" :question/worked-solution "Interpreting the fraction as division, we can write our expression as:\n\n$$\n7÷3\\times 15\n$$\n\nWe can write an equivalent expression by swapping the $÷3$ and the $\\times 15:$\n\n$$\n7\\times 15÷3\n$$\n\nExpressing the division as a fraction, we arrive at:\n\n$$\n7\\times \\frac{15}{3}\n$$\n\nWe now solve:\n\n$$\n7\\times \\underbrace{\\frac{15}{3}}_{5}=7\\times 5=35\n$$"}] [{:db/id #edb/ref 17592186426839 :knowledge-point/_questions [{:db/id #edb/ref 17592186198253 :knowledge-point/id #uuid "ce659c55-ca26-52c6-b15e-ec317013d856" :knowledge-point/title "Expressing a Nested Compound Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fe9774-58ed-565f-9cbb-223d3c49f77e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(X∨Y)∨Z" :db/id #edb/ref 17592186426814} {:answer/id #uuid "975840e4-95b6-570a-bca6-50be4fce0c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(X∨Y)∧Z" :db/id #edb/ref 17592186426824} {:answer/id #uuid "bda4b648-d128-5a9f-af66-b574da891c6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨(Y∧Z)" :db/id #edb/ref 17592186426830} {:answer/id #uuid "c69e7e45-595b-57f9-9f1e-7da09afbdb28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(X∧Y)∨Z" :db/id #edb/ref 17592186426832} {:answer/id #uuid "f8d36d58-81e3-5ce6-a949-0b1fb3544fff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧(Y∧Z)" :db/id #edb/ref 17592186426833}] :answer-field/correct {:answer/id #uuid "975840e4-95b6-570a-bca6-50be4fce0c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(X∨Y)∧Z" :db/id #edb/ref 17592186426824} :answer-field/id #uuid "cb8b0f6c-4a71-5c9b-bc62-54e3ad24cf0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426835}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17d0f2d8-abc7-53ff-a964-9b193b159c69" :question/math-academy-id "q-170742" :question/problem "$n$ is less than $10$ **or** $13$, **and** $n$ is an integer\n\nExpress the compound predicate above in symbolic form given the following notations:\n\n- $X(n):$ $n$ is less than $10$\n\n- $Y(n):$ $n$ is less than $13$\n\n- $Z(n):$ $n$ is an integer" :question/worked-solution "The word \"and\" is represented by the symbol \"$∧,$\" while the word \"or\" is represented by the symbol \"$∨.$\"\n\nNote that this sentence consists of two parts:  \n\n- **Part 1:** $n$ is less than $10$ or $13.$ This corresponds to\n\n$$\n\\underbrace{n\\text{ is less than }10}_{X}\\,\\underbrace{\\text{or}}_{∨}\\,\\underbrace{n\\text{ is less than }13}_{Y},\n$$\n\nthat is, $X∨Y.$\n\n- **Part 2:** $n$ is an integer. This corresponds to $Z.$\n\nSo, we can express the sentence as\n\n$$\n\\underbrace{n\\text{ is less than }10\\text{ or }13}_{X∨Y}\\,\\underbrace{\\text{and}}_{∧}\\,\\underbrace{n\\text{ is an integer}}_{Z},\n$$\n\nthat is, $(X∨Y)∧Z.$"}] [{:db/id #edb/ref 17592186427560 :knowledge-point/_questions [{:db/id #edb/ref 17592186119858 :knowledge-point/id #uuid "b72ed196-a73b-59ab-a7c3-5173249cf7e5" :knowledge-point/title "Determining Whether a Given Set Is a Basis of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f11080-8e79-55d1-814d-39c81b12ba97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\{{a}_{1},{a}_{2}\\}$ is not a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$" :db/id #edb/ref 17592186427542} {:answer/id #uuid "15dddeb9-e2d3-55d4-9c4e-ed6b802b40f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186427543} {:answer/id #uuid "399d1ce8-2eb3-525d-b9b3-45ffc5c60921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186427544} {:answer/id #uuid "c6bc1d3c-02a8-5212-85ed-899170ed9e00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186427550} {:answer/id #uuid "cca65a09-cc23-5ec7-990f-956f30407ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186427551}] :answer-field/correct {:answer/id #uuid "c6bc1d3c-02a8-5212-85ed-899170ed9e00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186427550} :answer-field/id #uuid "c01e595b-9131-553f-970b-e23a7aab76e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427558}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7ffe635-df11-5df3-b5e3-505ac6562519" :question/math-academy-id "q-110895" :question/problem "The vectors ${a}_{1},$ ${a}_{2},$ and ${a}_{3}$ are given below. Determine whether $B=\\{{a}_{1},{a}_{2}\\}$ is a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ If that is the case, find ${x}_{1}\\cdot {x}_{2},$ where ${a}_{3}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 5\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}3 \\\\ 7\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}5 \\\\ 17\\end{bmatrix}\n$$" :question/worked-solution "We want to determine if $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ So, we want to find ${x}_{1},{x}_{2}\\in R$ such that \n\n$$\n{x}_{1}\\underbrace{\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}}_{{a}_{1}}+{x}_{2}\\underbrace{\\begin{bmatrix}3 \\\\ 7\\end{bmatrix}}_{{a}_{2}}=\\underbrace{\\begin{bmatrix}5 \\\\ 17\\end{bmatrix}}_{{a}_{3}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=5 \\\\ 5{x}_{1}+5{x}_{2} &=17\\end{aligned}\\right.\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}1 & 3 & 5 \\\\ 5 & 7 & 17\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & -8 & -8\\end{bmatrix} & {R}_{2} & :=-\\frac{1}{8}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 1 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the RREF matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So,  $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\nAlso, the matrix tells us that ${x}_{1}=2$ and ${x}_{2}=1,$ meaning that\n\n$$\n2\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}}_{{a}_{1}}+1\\cdot \\underbrace{\\begin{bmatrix}3 \\\\ 7\\end{bmatrix}}_{{a}_{2}}=\\underbrace{\\begin{bmatrix}5 \\\\ 17\\end{bmatrix}}_{{a}_{3}}.\n$$\n\nTherefore, ${x}_{1}\\cdot {x}_{2}=2\\cdot 1=2.$"}] [{:db/id #edb/ref 17592186427863 :knowledge-point/_questions [{:db/id #edb/ref 17592186124572 :knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e" :knowledge-point/title "Restoring a Matrix Given Its Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271153a7-e008-5233-9e22-3f12deb489c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -5 \\\\ 4 & -5\\end{bmatrix}" :db/id #edb/ref 17592186427852} {:answer/id #uuid "57dd64ab-9583-5552-b2ec-3be32f9e1309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}56 & -54 \\\\ 49 & -51\\end{bmatrix}" :db/id #edb/ref 17592186427854} {:answer/id #uuid "5e3acd5e-d728-5511-ba7b-b5202ac2ddfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -6 \\\\ 9 & -1\\end{bmatrix}" :db/id #edb/ref 17592186427855} {:answer/id #uuid "63ef4572-30b7-56ef-8f5a-ac03a89540d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}54 & -56 \\\\ 49 & -51\\end{bmatrix}" :db/id #edb/ref 17592186427856} {:answer/id #uuid "7154f91d-3460-5bf3-bea9-dc1e61a7a77f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}54 & -56 \\\\ 51 & -49\\end{bmatrix}" :db/id #edb/ref 17592186427858}] :answer-field/correct {:answer/id #uuid "63ef4572-30b7-56ef-8f5a-ac03a89540d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}54 & -56 \\\\ 49 & -51\\end{bmatrix}" :db/id #edb/ref 17592186427856} :answer-field/id #uuid "6a4b5644-3578-5ae2-81ef-1e895ed96291" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "403fa166-7921-5239-b399-2bac8767c7a0" :question/math-academy-id "q-86678" :question/problem "Find a $2\\times 2$ matrix $S$ that has eigenvalues ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-2,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=\\begin{bmatrix}8 \\\\ 7\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "Since $B=\\{{v}_{1},{v}_{2}\\}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $S,$ then $S$ must be diagonalizable.\n\nSo, we can write $S=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $S,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nS=\\underbrace{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}_{P}\\underbrace{\\begin{bmatrix}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{bmatrix}}_{D}\\underbrace{{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}^{-1}}_{{P}^{-1}}\n$$\n\nLet $P=\\begin{bmatrix}8 & 1 \\\\ 7 & 1\\end{bmatrix}.$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={\\begin{bmatrix}8 & 1 \\\\ 7 & 1\\end{bmatrix}}^{-1}=\\frac{1}{1}\\begin{bmatrix}1 & -1 \\\\ -7 & 8\\end{bmatrix}=\\begin{bmatrix}1 & -1 \\\\ -7 & 8\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}S & =\\begin{bmatrix}8 & 1 \\\\ 7 & 1\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ -7 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}40 & -2 \\\\ 35 & -2\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ -7 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}54 & -56 \\\\ 49 & -51\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186427864 :knowledge-point/_questions [{:db/id #edb/ref 17592186124531 :knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5" :knowledge-point/title "Finding the Eigenvalues and Eigenvectors of a Matrix Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a52f5c-fb5a-567f-a05c-b4a3377da12a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}$ and $\\begin{bmatrix}-1 \\\\ 4\\end{bmatrix}$" :db/id #edb/ref 17592186427851} {:answer/id #uuid "349ea5d5-1623-5b94-b22b-a5a6bd4fb201" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}$ and $\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}$" :db/id #edb/ref 17592186427853} {:answer/id #uuid "65b8a476-fed9-5e7d-acb6-3aec390dd318" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}$" :db/id #edb/ref 17592186427857} {:answer/id #uuid "b20dbe0a-b3d3-556e-baa9-349554260ed9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}$ and $\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}$" :db/id #edb/ref 17592186427859} {:answer/id #uuid "f3482122-1b23-51b6-bab9-0274990d6acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}$" :db/id #edb/ref 17592186427860}] :answer-field/correct {:answer/id #uuid "f3482122-1b23-51b6-bab9-0274990d6acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}$" :db/id #edb/ref 17592186427860} :answer-field/id #uuid "ef6614e3-dc36-51f8-9c16-862fd38745d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427862}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "44ed4b4e-a305-51c9-9d7d-957ba67e3cad" :question/math-academy-id "q-37605" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $B$ given that \n\n$$\n\\begin{bmatrix}4 & 1 \\\\ 5 & 1\\end{bmatrix}B=\\begin{bmatrix}3 & 0 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}4 & 1 \\\\ 5 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the matrix $\\begin{bmatrix}4 & 1 \\\\ 5 & 1\\end{bmatrix}$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $B:$ \n\n$$\nB=\\underbrace{{\\begin{bmatrix}4 & 1 \\\\ 5 & 1\\end{bmatrix}}^{-1}}_{P}\\underbrace{\\begin{bmatrix}3 & 0 \\\\ 0 & -2\\end{bmatrix}}_{D}\\underbrace{\\begin{bmatrix}4 & 1 \\\\ 5 & 1\\end{bmatrix}}_{{P}^{-1}}\n$$\n\nTherefore, $B$ is diagonalizable. The eigenvalues of $B$ are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=-2$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={\\begin{bmatrix}4 & 1 \\\\ 5 & 1\\end{bmatrix}}^{-1}=\\frac{1}{-1}\\begin{bmatrix}1 & -1 \\\\ -5 & 4\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ 5 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}\\,$ and $\\,{v}_{2}=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186429769 :knowledge-point/_questions [{:db/id #edb/ref 17592186119815 :knowledge-point/id #uuid "f892805c-2c2c-5105-91ba-353aefe7b7f2" :knowledge-point/title "Finding a Basis of the Space Spanned by a Set of Vectors Using Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad3f32a-699b-5f19-8537-5ee75cb30b47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186429751} {:answer/id #uuid "5065bce1-b0d9-5de9-83b0-c30228b25991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186429756} {:answer/id #uuid "77805aee-b005-52d0-a725-17ced8ae5682" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186429758} {:answer/id #uuid "9d88a0d5-9800-59a9-a10a-33be5d1d8e49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}\\}" :db/id #edb/ref 17592186429762} {:answer/id #uuid "acf57914-2b95-5f27-9687-899336a28991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}\\}" :db/id #edb/ref 17592186429765}] :answer-field/correct {:answer/id #uuid "5065bce1-b0d9-5de9-83b0-c30228b25991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186429756} :answer-field/id #uuid "9ccdc12a-fbdf-5044-b512-ae9ee21b3e92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186429768}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "293eb96a-a168-5847-97d0-8739c8726172" :question/math-academy-id "q-74977" :question/problem "Consider the vectors ${a}_{1}=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix},{a}_{2}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},$ and ${a}_{3}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.$ Find a basis of $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ by inspection." :question/worked-solution "Remember that a basis of $S$ is a set of linearly independent vectors that spans $S.$\n\nFrom the given vectors, we can see that ${a}_{1}$ is a linear combination of vectors ${a}_{2}$ and ${a}_{3}:$\n\n$$\n{a}_{1}=1\\cdot {a}_{2}+1\\cdot {a}_{3}\n$$\n\nConsequently, the vector ${a}_{1}$ can be removed from $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ without changing the span. So $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is spanned by just $\\{{a}_{2},{a}_{3}\\}.$ \n\nLastly, note that ${a}_{2}$ and ${a}_{3}$ are linearly independent since they are not parallel. So the set $\\{{a}_{2},{a}_{3}\\}$ is a linearly independent set that spans $S.$\n\nTherefore, a basis of $S$ is $\\{{a}_{2},{a}_{3}\\},$ that is to say,\n\n$$\nB=\\{\\underbrace{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}}_{{a}_{2}},\\underbrace{\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}}_{{a}_{3}}\\}.\n$$"}] [{:db/id #edb/ref 17592186429890 :knowledge-point/_questions [{:db/id #edb/ref 17592186138404 :knowledge-point/id #uuid "70a364f5-5384-5ba6-8142-5740aa51f4bc" :knowledge-point/title "Raising Zero or One to a Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ac74b16-98e0-5c26-8269-feae86314c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186429844}] :answer-field/correct {:answer/id #uuid "6ac74b16-98e0-5c26-8269-feae86314c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186429844} :answer-field/id #uuid "7515804c-1645-5107-b3dc-557942dfbb1a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186429880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "055bced7-1256-505d-bf41-0147f8e143ed" :question/math-academy-id "q-224158" :question/problem "${1}^{7}=${{field-1}}" :question/worked-solution "Here, ${1}^{7}$ is in exponent form. The base is $1$ and the exponent is $7.$ \n\nThis means that $1$ is taken as a factor $7$ times. Therefore,\n\n$$\n{1}^{7}=\\underbrace{1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1}_{7\\text{ times}}=1.\n$$"}] [{:db/id #edb/ref 17592186429892 :knowledge-point/_questions [{:db/id #edb/ref 17592186138402 :knowledge-point/id #uuid "fc1a0e6d-ed51-5797-8ab7-305e861d1109" :knowledge-point/title "Cubing a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0f287a-82ae-555f-a79b-907b97a0e817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "343" :db/id #edb/ref 17592186429822}] :answer-field/correct {:answer/id #uuid "0c0f287a-82ae-555f-a79b-907b97a0e817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "343" :db/id #edb/ref 17592186429822} :answer-field/id #uuid "f8ce7983-e8cb-5229-8377-65cc977e0ee9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186429889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b68262c-4f64-5130-a6e1-d1cb3e865a03" :question/math-academy-id "q-224035" :question/problem "What is the value of $7$ raised to the power of $3?$\n\n$7$ raised to the power of $3$ is\n{{field-1}}." :question/worked-solution "We need to evaluate ${7}^{3}.$\n\nTo evaluate ${7}^{3},$ we start by writing it out with multiplication signs:\n\n$$\n{7}^{3}=\\underbrace{7\\times 7\\times 7}_{3\\text{ times}}\n$$\n\nNow, we compute the product. Since $7\\times 7=49,$ we have\n\n$$\n\\underbrace{7\\times 7}_{49}\\times 7=49\\times 7.\n$$\n\nFinally, we work out $49\\times 7.$\n\n$$\n\\begin{aligned}\\begin{aligned} &  & \\,\\,\\,\\,{}_{6}\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, &  &  & \\,\\,\\,\\,7\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\,\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nSince $49\\times 7=343,$ we have ${7}^{3}=343.$"}] [{:db/id #edb/ref 17592186429894 :knowledge-point/_questions [{:db/id #edb/ref 17592186138404 :knowledge-point/id #uuid "70a364f5-5384-5ba6-8142-5740aa51f4bc" :knowledge-point/title "Raising Zero or One to a Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4fa67ab-62df-5af3-889a-0e76e67f9c5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186429856}] :answer-field/correct {:answer/id #uuid "a4fa67ab-62df-5af3-889a-0e76e67f9c5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186429856} :answer-field/id #uuid "9f86dc9e-f417-5acd-8efa-e57867fbb112" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186429881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47a275b6-8ed5-5b82-b1e3-8feb36ab37f8" :question/math-academy-id "q-172532" :question/problem "${1}^{12}=${{field-1}}" :question/worked-solution "Here, ${1}^{12}$ is in exponent form. The base is $1$ and the exponent is $12.$ \n\nThis means that $1$ is taken as a factor $12$ times. Therefore,\n\n$$\n{1}^{12}=\\underbrace{1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1}_{12\\text{ times}}=1.\n$$"}] [{:db/id #edb/ref 17592186429896 :knowledge-point/_questions [{:db/id #edb/ref 17592186138401 :knowledge-point/id #uuid "9c336cc3-c89e-5af2-b170-1fc6d9cf8307" :knowledge-point/title "Squaring a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca49e0b4-682d-513d-b481-352b0f1e7624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186429862}] :answer-field/correct {:answer/id #uuid "ca49e0b4-682d-513d-b481-352b0f1e7624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186429862} :answer-field/id #uuid "5f4bc28e-f642-5ec2-b8a8-5fe052b6282e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186429875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55110545-b3e1-5cf7-8175-0d77be4e9f01" :question/math-academy-id "q-224152" :question/problem "What is the square of $3?$\n\nThe square of $3$ is\n{{field-1}}." :question/worked-solution "The square of $3$ is the same as ${3}^{2}.$\n\nTo evaluate ${3}^{2},$ we write it out with multiplication signs and then compute the product:\n\n$$\n\\begin{aligned}{3}^{2}=\\underbrace{3\\times 3}_{2\\text{ times}}=9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186429897 :knowledge-point/_questions [{:db/id #edb/ref 17592186138402 :knowledge-point/id #uuid "fc1a0e6d-ed51-5797-8ab7-305e861d1109" :knowledge-point/title "Cubing a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18041424-7e1f-5d6e-be15-3870a03e5c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186429825} {:answer/id #uuid "49e664f1-f0e5-51f0-b485-e375c7890a45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "999" :db/id #edb/ref 17592186429837} {:answer/id #uuid "8b28324e-c5bd-519d-b0e7-b9bad2e7917f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "93" :db/id #edb/ref 17592186429851} {:answer/id #uuid "97721b92-93f3-5c95-850a-66712f9d0497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186429852} {:answer/id #uuid "ce5b4677-1bee-590e-b106-43f64807b3ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "729" :db/id #edb/ref 17592186429863}] :answer-field/correct {:answer/id #uuid "ce5b4677-1bee-590e-b106-43f64807b3ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "729" :db/id #edb/ref 17592186429863} :answer-field/id #uuid "735a999b-8273-5ba0-b1f3-8563ca74e9aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186429877}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "67f4609a-bf5e-5370-a6dc-848f8c2f3fef" :question/math-academy-id "q-55034" :question/problem "What is the value of $9$ raised to the power of $3?$" :question/worked-solution "Here, $9$ raised to the power of $3$ means ${9}^{3}.$\n\nTo compute this power, we start by writing it out with multiplication signs:\n\n$$\n{9}^{3}=\\underbrace{9\\times 9\\times 9}_{3\\text{ times}}\n$$\n\nNow, we compute the product. Since $9\\times 9=81,$ we have\n\n$$\n\\begin{aligned}\\underbrace{9\\times 9}_{81}\\times 9 & =81\\times 9.\\end{aligned}\n$$\n\nFinally, we work out $81\\times 9.$\n\n$$\n\\begin{aligned}\\begin{aligned} &  & \\,\\,\\,\\,{}_{}\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, &  & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nSince $81\\times 9=729,$ then ${9}^{3}=729.$"}] [{:db/id #edb/ref 17592186429899 :knowledge-point/_questions [{:db/id #edb/ref 17592186138401 :knowledge-point/id #uuid "9c336cc3-c89e-5af2-b170-1fc6d9cf8307" :knowledge-point/title "Squaring a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07edbe8b-8b99-5551-8907-2d61816753eb" :answer/type {:db/id #edb/ref 175921860