177c4aa4fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472846} {:answer/id #uuid "fe3806ef-2d1e-54e7-a983-2f853e1f75da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472847}] :answer-field/correct {:answer/id #uuid "fe3806ef-2d1e-54e7-a983-2f853e1f75da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472847} :answer-field/id #uuid "8a96ae20-3158-56a5-8c42-beb8f31d27c2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473818} {:answer-field/choices [{:answer/id #uuid "b21044ff-3035-50a3-b828-93a4ae2dde70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472848} {:answer/id #uuid "25db3510-d2ea-59b7-a47b-63dc65eb24c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472849}] :answer-field/correct {:answer/id #uuid "b21044ff-3035-50a3-b828-93a4ae2dde70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472848} :answer-field/id #uuid "e06faf13-f34b-5712-a464-83a6b07e81f1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473819}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "085a10d3-7324-5921-95c5-eaa8f395984a" :question/math-academy-id "q-183620" :question/problem "$$\n∀{k}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in (0,1),\\,{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}+{k}^{2}\\ge {k}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\n$$\n\nWhich occurrences of the variables in the expression above are free?\n\nSelect all that apply." :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $k$ is *bound* since it's placed right next to the quantifier $∀:$\n\n$$\n∀{k}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (0,1),\\,n+{k}^{2}\\ge k\n$$\n\n- Occurrence II of the variable $n$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $n.$\n\n- Occurrence III of the variable $k$ is *bound* since it lies within the scope of the quantifier $∀k$ that uses $k:$\n\n$$\n∀k\\in (0,1),\\,\\overbrace{n+{k}^{2}\\ge {k}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}}^{\\text{scope of }∀k}\n$$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n∀\\,{k}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (0,1),\\,{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}+{k}^{2}\\ge {k}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\n$$\n\nTherefore, the free occurrence is \"II only.\""}] [{:db/id #edb/ref 17592186407133 :knowledge-point/_questions [{:db/id #edb/ref 17592186152089 :knowledge-point/id #uuid "6927f03c-aa7a-56ac-8cd0-c036a11aadc9" :knowledge-point/title "Finding the Truth Value of a Statement Involving Nested Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49953372-6786-55fd-b957-4551684db7d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453670} {:answer/id #uuid "eb694d2a-846a-5113-a363-79bb2236c246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453671}] :answer-field/correct {:answer/id #uuid "eb694d2a-846a-5113-a363-79bb2236c246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453671} :answer-field/id #uuid "75840e40-2cca-58f4-a515-e9cfdb46f959" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454585} {:answer-field/choices [{:answer/id #uuid "57c979c3-fafa-584e-abe1-50aaafd5442e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453672} {:answer/id #uuid "374d893b-950f-54cb-a1f5-2cd335ae552b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453673}] :answer-field/correct {:answer/id #uuid "57c979c3-fafa-584e-abe1-50aaafd5442e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453672} :answer-field/id #uuid "726bad40-3e61-5e83-b318-93789e8c9f1e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454586} {:answer-field/choices [{:answer/id #uuid "8d9be598-49fa-52b8-a352-44784bf90317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453674} {:answer/id #uuid "e6cb932f-f971-54a3-ad09-1463e1bb7456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453675}] :answer-field/correct {:answer/id #uuid "e6cb932f-f971-54a3-ad09-1463e1bb7456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453675} :answer-field/id #uuid "9963ef57-4cea-572c-8d46-02df8158a551" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454587}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a806540-0634-5e11-9ba2-ff988650a653" :question/math-academy-id "q-183877" :question/problem "Let $p\\in Q$ and $q\\in Q.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $∃\\,p\\in Q,\\,2p=-1.$\n- **II.** The truth set of the predicate $(\\,∃\\,p\\in Q,\\,p\\cdot q=-1\\,)$ is $Q.$\n- **III.** $∃\\,q,p\\in Q,\\,p\\cdot q=-1.$" :question/worked-solution "First, notice that the statement \n\n$$\n∃\\,q,p\\in Q,\\,p\\cdot q=-1\n$$\n\nfrom option III reads as follows:\n\n$\\,$ There exist rationals $q$ and $p,$ such that $p\\cdot q=-1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true, $2p=-1$ for some rational number $p$ (e.g., for $p=-\\frac{1}{2}$).\n\n- Statement II is false. For the predicate\n\n$$\nP(q):\\,∃\\,p\\in Q,\\,p\\cdot q=-1\n$$\n\nwe note that $P(q)$ is true for some $q\\in Q$ and false for others. For example, \n\n$$\nP(0):\\,∃\\,p\\in Q,\\,p\\cdot 0=-1\n$$\n\nis false. However, \n\n$$\nP(1):\\,∃\\,p\\in Q,\\,p\\cdot 1=-1\n$$\n\nis true, since we can take $p=-1.$\n\n- Statement III is true. The sentence \n\n$$\n(\\,∃\\,q,p\\in Q,\\,p\\cdot q=-1\\,)\n$$\n\n \ncan be written as\n\n$$\n∃q\\in Q\\,(\\,\\underbrace{∃p\\in Q,\\,p\\cdot q=-1}_{P(q)}\\,)\n$$\n\nwhich is true whenever the inner predicate $P(q)$ has a nonempty truth set. And according to the discussion in statement II, this is the case.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186407134 :knowledge-point/_questions [{:db/id #edb/ref 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "579250e5-9a15-54a1-9aef-61843d7e73bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472850} {:answer/id #uuid "bac29f65-92c2-5c70-9ac1-938b9b7c9f19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472851}] :answer-field/correct {:answer/id #uuid "579250e5-9a15-54a1-9aef-61843d7e73bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472850} :answer-field/id #uuid "da4eca5f-8cd7-542e-9644-037ddfda06a8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473820} {:answer-field/choices [{:answer/id #uuid "4a3dc152-a2ec-569a-8cdb-75853d4eab7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472852} {:answer/id #uuid "46ef506f-4104-5a21-ad5f-afc0dd168aa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472853}] :answer-field/correct {:answer/id #uuid "46ef506f-4104-5a21-ad5f-afc0dd168aa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472853} :answer-field/id #uuid "905f7199-6958-58e0-ad1d-a6857970bc53" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473821} {:answer-field/choices [{:answer/id #uuid "f281ae76-653f-5d18-a0eb-0fe9727b9b1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472854} {:answer/id #uuid "6040f888-8437-5a2a-ad58-c9c0b0b28a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472855}] :answer-field/correct {:answer/id #uuid "f281ae76-653f-5d18-a0eb-0fe9727b9b1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472854} :answer-field/id #uuid "b9b222a4-df9e-5d6c-8b68-583b11d65aa7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473822}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39d9d2c3-0d6e-5d14-b069-fbe9f014d46f" :question/math-academy-id "q-183674" :question/problem "$$\n(\\,∀{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in R,\\,0<x<1\\,)⇒(\\,∃y\\in R,\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}=\\operatorname{sin}⁡{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\\,)\n$$\n\nWhich occurrences of the variables in the expression above are free?\n\nSelect all that apply." :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $x$ is *bound* since it is placed right next to the quantifier $∀:$\n\n$$\n(\\,∀{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,0<x<1\\,)⇒(\\,∃y\\in R,\\,x=\\operatorname{sin}⁡y\\,)\n$$\n\n- Occurrence II of the variable $x$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $x.$\n\n- Occurrence III of the variable $y$ is *bound* since it lies within the scope of the quantifier $∃y$ that uses $y:$\n\n$$\n(\\,∀x\\in R,\\,0<x<1\\,)⇒(\\,∃y\\in R,\\,\\overbrace{x=\\operatorname{sin}⁡{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}}^{\\text{scope of }∃y})\n$$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n(\\,∀{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,0<{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}<1\\,)⇒(\\,∃{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}=\\operatorname{sin}⁡{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\,)\n$$\n\nTherefore, the free occurrence is \"II only.\""}] [{:db/id #edb/ref 17592186407245 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad86372-161b-56b5-b9b3-67cb9855544f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186407216} {:answer/id #uuid "3e4b4700-8836-57b3-a254-6685beac57ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186407217} {:answer/id #uuid "65001b28-0435-5b9d-91ec-614c84c822e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{n}" :db/id #edb/ref 17592186407221} {:answer/id #uuid "bf467989-30ff-5c80-94cc-972d1936e437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186407228} {:answer/id #uuid "d63461e1-95f1-5efd-aec4-a9f50c64386c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{m}" :db/id #edb/ref 17592186407232}] :answer-field/correct {:answer/id #uuid "bf467989-30ff-5c80-94cc-972d1936e437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186407228} :answer-field/id #uuid "32cd5975-d7c1-5dd8-91de-4834a553c50c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407239}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9c49e80-5070-56aa-b070-99b1fa2fdff3" :question/math-academy-id "q-109848" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of ${R}^{m}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n\\underbrace{\\begin{bmatrix}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{{A}^{T}}\\cdot \\underbrace{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{bmatrix}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+⋯+{x}_{m}\\begin{bmatrix}| \\\\ {a}_{m}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$"}] [{:db/id #edb/ref 17592186407247 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3a4ec2-bd1c-569f-bc25-a735fbf6e8f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186407213} {:answer/id #uuid "4624e774-8f8e-50d7-922a-9f2511cb84dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}(AB)" :db/id #edb/ref 17592186407218} {:answer/id #uuid "ab8461c5-2db5-555b-98b8-ef3d5aadb4ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({B}^{T}{A}^{T})" :db/id #edb/ref 17592186407225} {:answer/id #uuid "ca1a752d-a1b9-5c75-a6eb-005f23fda936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({B}^{T}{A}^{T})" :db/id #edb/ref 17592186407230} {:answer/id #uuid "cafe991c-8437-5728-ad05-fe57c0cef2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(AB)" :db/id #edb/ref 17592186407231}] :answer-field/correct {:answer/id #uuid "cafe991c-8437-5728-ad05-fe57c0cef2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(AB)" :db/id #edb/ref 17592186407231} :answer-field/id #uuid "a14d9fc2-b7d8-5af8-b07b-319f63dc6ba1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407241}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "de769de3-3ab7-5536-ae28-2dcbd744b48f" :question/math-academy-id "q-109861" :question/problem "Let $A$ and $B$ be $m\\times p$ and $p\\times n$ matrices, respectively. What is the image of $\\text{Col}({B}^{T}\\,{A}^{T})$ under the action of $AB?$" :question/worked-solution "Pre-multiplying a vector $x\\in {R}^{n}$ by $AB$ gives a linear combination of the columns of $AB:$\n\n$$\n\\underbrace{\\begin{bmatrix}| & | & ⋯ & | \\\\ (ab)_{1} & (ab)_{2} & ⋯ & (ab)_{n} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{AB}\\cdot \\underbrace{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ (ab)_{1} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ (ab)_{2} \\\\ |\\end{bmatrix}+⋯+{x}_{n}\\begin{bmatrix}| \\\\ (ab)_{n} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $AB$ must be $\\text{Col}(AB),$ the column space of $AB.$\n\nFurthermore, since $\\text{Null}(AB)$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}((AB)^{T})=\\text{Col}({B}^{T}\\,{A}^{T})$ must be $\\text{Col}(AB).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/88/885bf8a3061f93ad400897a7273ffe4157d22dee20b8e4ee7ebb982b1c4319bb.png)"}] [{:db/id #edb/ref 17592186407737 :knowledge-point/_questions [{:db/id #edb/ref 17592186152164 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025eeed5-68d4-5570-b021-0adf7e52b725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186407677} {:answer/id #uuid "2d8581dd-1da5-594c-aeff-a22bc96cc24d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186407684} {:answer/id #uuid "a2432a68-e348-5010-853a-902531c483c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186407710} {:answer/id #uuid "c37191bc-1638-5bbe-a72d-998e1f87afae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186407716} {:answer/id #uuid "fcf4c5e6-37cd-56a4-81e4-9f40fbfa5399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186407725}] :answer-field/correct {:answer/id #uuid "c37191bc-1638-5bbe-a72d-998e1f87afae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186407716} :answer-field/id #uuid "c589018b-3bd0-5b95-aacd-b5a22d703944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407736}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "314ddabc-5058-598a-91b1-40efd4d045ae" :question/math-academy-id "q-79911" :question/problem "Let $a=49$ and $n=3.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n.$ Then, $q=$" :question/worked-solution "Dividing $49$ by $3$ using integer division, we notice that\n\n$$\n16<49÷3<17.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=16.$\n\nNext, we find the remainder $r$ by computing $r=a-qn.$ This gives\n\n$$\nr=49-(16)(3)=1.\n$$\n\nTherefore, we can write $49=qn+r$ as follows:\n\n$$\n\\begin{aligned}49=\\underbrace{16}_{q}\\cdot 3+\\underbrace{1}_{r}\\end{aligned}\n$$\n\nTherefore, $q=16.$"}] [{:db/id #edb/ref 17592186407738 :knowledge-point/_questions [{:db/id #edb/ref 17592186152165 :knowledge-point/id #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" :knowledge-point/title "The Division Algorithm For Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c22ada9-f64d-509b-b2e8-df15592edeb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186407690} {:answer/id #uuid "83821279-d8d3-51d9-9a43-2782f4edd5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186407705} {:answer/id #uuid "a6180fa8-0703-57e2-a5b9-761b0f67a8b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186407712} {:answer/id #uuid "c8e8dd3e-339b-5884-a542-57e73851c11d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186407719} {:answer/id #uuid "f195f921-8863-5f8f-9158-d7857046fe76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407724}] :answer-field/correct {:answer/id #uuid "c8e8dd3e-339b-5884-a542-57e73851c11d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186407719} :answer-field/id #uuid "2a9de8f2-e083-554c-a90d-6a3a06ab6f0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407728}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "411dd7b8-effc-5fa5-873f-f9e9d66680ce" :question/math-academy-id "q-103288" :question/problem "Let $a=-53$ and $n=7.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n.$ Then, $r=$" :question/worked-solution "Dividing $-53$ by $7$ using integer division, we notice that\n\n$$\n-8<-53÷7<-7.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=-8.$\n\nNext, we find the remainder $r$ by solving $r=a-qn.$ This gives\n\n$$\nr=-53-(-8)(7)=3.\n$$\n\nTherefore, we can write $-53=qn+r$ as follows:\n\n$$\n\\begin{aligned}-53=\\underbrace{(-8)}_{q}\\cdot 7+\\underbrace{3}_{r}\\end{aligned}\n$$\n\nTherefore, $r=3.$"}] [{:db/id #edb/ref 17592186407739 :knowledge-point/_questions [{:db/id #edb/ref 17592186152164 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36317481-1088-5e8c-b158-b7dcd8b8b247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186407688} {:answer/id #uuid "7b9fa351-8ded-5346-be31-b4ff2b2b4c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186407702} {:answer/id #uuid "8bd19f6f-413a-5e4e-8d62-fbfad83beb5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186407706} {:answer/id #uuid "c3fe947f-b82a-57f4-b35e-9a3dce8041f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186407717} {:answer/id #uuid "e7b9af20-0a99-555f-b6b6-cfee6fdc21ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186407722}] :answer-field/correct {:answer/id #uuid "e7b9af20-0a99-555f-b6b6-cfee6fdc21ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186407722} :answer-field/id #uuid "c18fdade-b31d-500c-9ac3-fe7da34b2f8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407735}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4190f22f-14a3-5ec1-bdc7-02c4f951d26e" :question/math-academy-id "q-79910" :question/problem "Let $a=96$ and $n=7.$ Find positive integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $96$ by $7$ using integer division, we notice that\n\n$$\n13<96÷7<14.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=13.$\n\nNext, we find the remainder $r$ by computing $r=a-qn.$ This gives\n\n$$\nr=96-(13)(7)=5.\n$$\n\nTherefore, we can write $96=qn+r$ as follows:\n\n$$\n\\begin{aligned}96=\\underbrace{13}_{q}\\cdot 7+\\underbrace{5}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r=13\\cdot 5=65.$"}] [{:db/id #edb/ref 17592186407740 :knowledge-point/_questions [{:db/id #edb/ref 17592186152164 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108a39ab-f87b-50a6-bd2a-df176eaa91f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186407679} {:answer/id #uuid "2bd1092c-c879-5e8f-a150-beff870efc7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407682} {:answer/id #uuid "3f8346d4-10aa-59d3-a624-ab3398e64fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186407691} {:answer/id #uuid "61a6b5fc-520c-544f-b5a0-5a2af2aba89a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186407699} {:answer/id #uuid "cb55b271-f2db-511c-b8fb-64cf9ea21e2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186407720}] :answer-field/correct {:answer/id #uuid "3f8346d4-10aa-59d3-a624-ab3398e64fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186407691} :answer-field/id #uuid "b3b4c7e9-1870-5f70-860c-7faf1e577ebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b3d670b-6c15-5f96-828d-2a33d12d5846" :question/math-academy-id "q-79907" :question/problem "Let $a=83$ and $n=6.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n.$ Then, $r=$" :question/worked-solution "Dividing $83$ by $6$ using integer division, we notice that\n\n$$\n13<83÷6<14.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=13.$\n\nNext, we find the remainder $r$ by computing $r=a-qn.$ This gives\n\n$$\nr=83-(13)(6)=5.\n$$\n\nTherefore, we can write $83=qn+r$ as follows:\n\n$$\n\\begin{aligned}83=\\underbrace{13}_{q}\\cdot 6+\\underbrace{5}_{r}\\end{aligned}\n$$\n\nTherefore, $r=5.$"}] [{:db/id #edb/ref 17592186407741 :knowledge-point/_questions [{:db/id #edb/ref 17592186152165 :knowledge-point/id #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" :knowledge-point/title "The Division Algorithm For Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3023cfd3-4c7f-56e6-a490-a108ba8f4a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186407686} {:answer/id #uuid "5fe218bc-d3e1-52b4-b584-fec32700636e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407698} {:answer/id #uuid "7fba60ac-1f50-5dfe-a109-e5bc6d216850" :answer/type {:db/id #edb/ref 17592186