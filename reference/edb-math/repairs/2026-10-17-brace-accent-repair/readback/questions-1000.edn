#uuid "1f42ed49-0e4f-50d7-b2dc-b6a989999e04" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186430700}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25c765b2-1047-5099-8c3e-89ccf0cb03b6" :question/math-academy-id "q-224272" :question/problem "${160}^{2}=${{field-1}}" :question/worked-solution "To evaluate ${160}^{2},$ we start by writing it out with a multiplication sign:\n\n$$\n{160}^{2}=\\underbrace{160\\times 160}_{2\\text{ times}}\n$$\n\nThen, we work out $160\\times 160.$\n\nFirst, we figure out the non-zero part and the block of zeros for both numbers:\n\n$$\n\\begin{aligned}160 & \\,⟶\\,160 \\\\ 160 & \\,⟶\\,160\\end{aligned}\n$$\n\nWe can see that there are $2$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{3}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} & \\end{aligned}\n$$\n\nFinally, we join the above with the block of zeros: \n\n$$\n25600=25,600\n$$\n\nTherefore, ${160}^{2}=25,600.$"}] [{:db/id #edb/ref 17592186430706 :knowledge-point/_questions [{:db/id #edb/ref 17592186171953 :knowledge-point/id #uuid "3ccf09f0-c76d-5133-be05-1fdfa61b23ad" :knowledge-point/title "Squaring Two-Digit Numbers"}] :qu