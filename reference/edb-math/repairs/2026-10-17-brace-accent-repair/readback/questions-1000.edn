3e-8ddecdc3b714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k" :db/id #edb/ref 17592186418894} {:answer/id #uuid "cae16caf-e494-5242-bf98-42fad2dcd788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186418900}] :answer-field/correct {:answer/id #uuid "cae16caf-e494-5242-bf98-42fad2dcd788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186418900} :answer-field/id #uuid "fff2f547-9756-58c3-a5cc-c52c8137a0aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186418991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea263a27-2e68-51ff-b5e7-5e8c84ebe1bc" :question/math-academy-id "q-182453" :question/problem "Use mathematical induction to prove that ${n}^{3}+{n}^{2}\\ge 2n$ for $n\\in N.$\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove that our statement is true for the base case $n=\\,${{field-1}}.\n\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{{field-2}}={{field-3}}\\end{aligned}\n$$\n\nwhich is\n{{field-4}}\nthe right-hand side.\nThus, our statement is {{field-5}} for $n=1.$\n\n**Inductive Hypothesis**: We assume that for some $n=$ {{field-6}}, we have\n\n$$\n{{field-7}}\\ge {{field-8}}.\n$$\n\n**Inductive Step**: To prove $P(k+1),$ we write\n\n$$\n\\begin{aligned}(k+1)^{3}+(k+1)^{2} & ={{field-9}}.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}{k}^{3}+{k}^{2}+3{k}^{2}+5k+2 & \\ge {{field-10}} \\\\  & ={{field-11}},\\end{aligned}\n$$\n\n$$\n\\begin{aligned} & \\ge {{field-12}},\\end{aligned}\n$$\n\nas required.\n\nTherefore, by the principle of induction, ${n}^{3}+{n}^{2}\\ge 2n$ is true for all\n{{field-13}}." :question/worked-solution "The principle of induction states the following: Suppose we have a sequence of mathematical statements $P(1),P(2),P(3),…,$ where\n\n- $P(1)$ is true, and\n\n- $P(k)⇒P(k+1)$ for every $k\\in N.$\n\nThen, $P(n)$ is true for every $n\\in N.$\n\nIn this case, the general statement $P(n)$ we're required to prove is the following:\n\n$$\n{n}^{3}+{n}^{2}\\ge 2n\\,\\text{for}\\,n\\ge 1.\n$$\n\nWe start by proving the so-called base case, $P(1).$ To do this, we substitute $n=1$ into both the left-hand side and right-hand side and show that the left-hand side is greater than or equal to the right-hand side:\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove our statement is true for the base case $n=1.$\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{1}^{3}+{1}^{2}=2,\\end{aligned}\n$$\n\nand for the right-hand side, we have\n\n$$\n\\begin{aligned}2(1)=2,\\end{aligned}\n$$\n\nThus, our statement is true for $n=1.$\n\nNext, we state our inductive hypothesis. Here, we assume that the given statement is true for some $n=k\\ge 1.$ \n\n**Inductive Hypothesis**: We assume that for some $n=k\\ge 1,$ we have\n\n$$\n{k}^{3}+{k}^{2}\\ge 2k.\n$$\n\nWe must show that $P(k)⇒P(k+1).$ Let's start by writing down $P(k+1).$ This is the first part of the so-called **inductive step**.\n\n**Inductive Step**: We're required to prove that\n\n$$\n(k+1)^{3}+(k+1)^{2}\\ge 2(k+1).\\,\\,(∗)\n$$\n\nThe idea is to rewrite the left-hand side of $(∗)$ *using the inductive hypothesis* and apply algebraic techniques to show that this is greater than or equal to the right-hand side. We do this as follows:\n\nWe write\n\n$$\n\\begin{aligned}(k+1)^{3}+(k+1)^{2} & =({k}^{3}+3{k}^{2}+3k+1)+({k}^{2}+2k+1) \\\\  & ={k}^{3}+{k}^{2}+3{k}^{2}+5k+2.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}\\underbrace{{k}^{3}+{k}^{2}}_{\\ge 2k}+\\underbrace{3{k}^{2}+5k}_{\\ge 0}+2 & \\ge 2k+2=2(k+1),\\end{aligned}\n$$\n\nas required.\n\nSince we've shown that the left-hand side of $(∗)$ is greater than or equal to the right-hand side, our proof is complete. So, let's write down our conclusion. \n\nTherefore, by the principle of induction, ${n}^{3}+{n}^{2}\\ge 2n$ for all $n\\ge 1.$"}] [{:db/id #edb/ref 17592186419394 :knowledge-point/_questions [{:db/id #edb/ref 17592186203934 :knowledge-point/id #uuid "0394e4c4-97f7-556c-a7c1-ddf4cde28237" :knowledge-point/title "Disproving Divisibility Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b56fba-1fe8-5018-a849-c9135a952109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15∤6a" :db/id #edb/ref 17592186419244} {:answer/id #uuid "26df9e56-60bd-55d3-9930-e723ca75ed69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15∤a" :db/id #edb/ref 17592186419253} {:answer/id #uuid "92199c1a-c4ca-54d1-9352-05d4480730a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15∣a" :db/id #edb/ref 17592186419297}] :answer-field/correct {:answer/id #uuid "26df9e56-60bd-55d3-9930-e723ca75ed69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15∤a" :db/id #edb/ref 17592186419253} :answer-field/id #uuid "3936e0ea-927d-5098-a33d-5088fa2ab3ba" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186419355} {:answer-field/choices [{:answer/id #uuid "31c8ff3d-3b64-521f-b7d7-d365d141660b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186419258} {:answer/id #uuid "7f4550a1-26e7-505b-8162-a6d92f5410e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186419289} {:answer/id #uuid "c62e1094-5091-509b-a8cb-4dcb3c3162b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186419321} {:an