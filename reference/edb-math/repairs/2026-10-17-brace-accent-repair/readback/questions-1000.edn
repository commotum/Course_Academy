1c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186407073} {:answer-field/choices [{:answer/id #uuid "d52db73b-f696-576b-aae7-dbf8af2e3f23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186407052} {:answer/id #uuid "de067941-98f6-523c-814d-b88b811d38ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186407055}] :answer-field/correct {:answer/id #uuid "de067941-98f6-523c-814d-b88b811d38ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186407055} :answer-field/id #uuid "599fafaf-53b4-566d-b85e-61784accfaa7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186407079}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2dfcbd6d-7083-5b50-9b60-a0306b88077d" :question/math-academy-id "q-184000" :question/problem "Suppose $n=6p+10q+3,$ where $p,q\\in Z.$ Complete the following argument.\n\nThe number $n$ is {{field-1}} since \n\n$$\n\\begin{aligned}n & =6p+10q+3 \\\\  & =2(3p+{{field-2}})+1 \\\\  & ={{field-3}},\\end{aligned}\n$$\n\nwhere $a=${{field-4}}." :question/worked-solution "An integer is *odd* if it can be written as $2a+1,$ where $a$ is an integer.\n\nNow, note the following regarding the expression $6p+10q+3:$\n\n- All terms, apart from the constant term, have a common factor of $2.$\n\n- The constant term can be written as $3=2+1.$\n\nTherefore, we complete our argument as follows:\n\nThe number $n$ is $\\text{odd}$ since\n\n$$\n\\begin{aligned}n & =6p+10q+3 \\\\  & =(6p+10q+2)+1 \\\\  & =2(\\underbrace{3p+5q+1}_{a})+1 \\\\  & =2a+1,\\end{aligned}\n$$\n\nwhere $a=3p+5q+1\\in Z.$"}] [{:db/id #edb/ref 17592186407093 :knowled