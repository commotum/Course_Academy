 "b98b7aa5-35d3-5366-a665-a1a10789344c" :question/math-academy-id "q-137256" :question/problem "$\\frac{5}{8}\\times 16=$" :question/worked-solution "Interpreting the fraction as division, we can write our expression as:\n\n$$\n5÷8\\times 16\n$$\n\nWe can write an equivalent expression by swapping the $÷8$ and the $\\times 16:$\n\n$$\n5\\times 16÷8\n$$\n\nExpressing the division as a fraction, we arrive at:\n\n$$\n5\\times \\frac{16}{8}\n$$\n\nWe now solve:\n\n$$\n5\\times \\underbrace{\\frac{16}{8}}_{2}=5\\times 2=10\n$$"}] [{:db/id #edb/ref 17592186426695 :knowledge-point/_questions [{:db/id #edb/ref 17592186147460 :knowledge-point/id #uuid "5726ea5c-ba64-51c2-b5ac-0915853fd080" :knowledge-point/title "Evaluating an Expression by Interpreting a Fraction as Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117a31dc-d077-5050-9e41-473833111022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186426581} {:answer/id #uuid "2cc2a4c8-4f63-5f43-a9de-a382a4ceebcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186426592} {:answer/id #uuid "58041abc-1eca-50ab-88ae-ed4b241e3dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186426611} {:answer/id #uuid "b8947f17-edb2-54c0-b669-4ac1a2fdf51f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186426644} {:answer/id #uuid "fc91bd1c-b67f-51c2-a185-b127ea50c528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186426664}] :answer-field/correct {:answer/id #uuid "117a31dc-d077-5050-9e41-473833111022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186426581} :answer-field/id #uuid "03bdddef-b8dc-5b6b-84cb-3792b40