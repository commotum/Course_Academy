-648d523d80f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c1651a7-19c3-5fc6-882f-8612e069dc1b" :question/math-academy-id "q-161831" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-1,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}v{e}^{u} \\\\ u{e}^{v}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot \\underbrace{\\text{Area}(Δ)}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v{e}^{u} & {e}^{u} \\\\ {e}^{v} & u{e}^{v}\\end{aligned}| \\\\  & =v{e}^{u}\\cdot u{e}^{v}-{e}^{v}\\cdot {e}^{u} \\\\  & =uv{e}^{u+v}-{e}^{u+v} \\\\  & =(uv-1){e}^{u+v} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(-1,1)} & =(uv-1){e}^{u+v}\\,{|}_{u=-1\\,v=1} \\\\  & =(-1\\cdot 1-1){e}^{-1+1} \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-2|\\cdot \\delta A \\\\  & =2\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281366 :knowledge-point/_questions [{:db/id #edb/ref 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a27b376-f76e-5224-bd14-dcd0f58ef17d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,\\delta A" :db/id #edb/ref 17592186279419} {:answer/id #uuid "6df88852-e281-540b-9be8-5da79ff04db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279592} {:answer/id #uuid "e29c7966-53cc-5a98-a45d-f216ac316386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186280594} {:answer/id #uuid "e5bf82bf-7ae4-51b0-8078-b62137d694c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\delta A" :db/id #edb/ref 17592186280619} {:answer/id #uuid "f2ae113f-b190-5e88-a500-9aa18217b4af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id #edb/ref 17592186280706}] :answer-field/correct {:answer/id #uuid "6df88852-e281-540b-9be8-5da79ff04db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279592} :answer-field/id #uuid "150f9199-b68c-5aef-8efe-e079ecbd49f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ee4cd0d-00ad-5fb0-be36-91eca3f6f7a9" :question/math-academy-id "q-161873" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\frac{1}{u}-v \\\\ {u}^{2}v\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot \\underbrace{\\text{Area}(Δ)}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\frac{1}{{u}^{2}} & -1 \\\\ 2uv & {u}^{2}\\end{aligned}| \\\\  & =(-\\frac{1}{{u}^{2}})\\cdot ({u}^{2})-2uv\\cdot (-1) \\\\  & =-1+2uv \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(2,2)} & =(-1+2uv)\\,{|}_{u=2\\,v=2} \\\\  & =-1+2(2)(2) \\\\  & =7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|7|\\cdot \\delta A \\\\  & =7\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281367 :knowledge-point/_questions [{:db/id #edb/ref 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d9515a0-7aca-5bd0-93c2-b5138c7c3052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,\\delta A" :db/id #edb/ref 17592186279294} {:answer/id #uuid "62fb6c42-d7b5-5116-b4d8-c608240b0020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279491} {:answer/id #uuid "65e00832-3370-516f-bf0e-931f9e463a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\,\\delta A" :db/id #edb/ref 17592186279521} {:answer/id #uuid "c042a147-a78a-546c-adff-8d9859d6b5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :a