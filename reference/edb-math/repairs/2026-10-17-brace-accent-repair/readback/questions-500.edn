a93-8919-dff31036af0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465992}] :answer-field/correct {:answer/id #uuid "490bed6d-5c68-5a93-8919-dff31036af0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465992} :answer-field/id #uuid "38a38067-a95d-55de-aa07-a74dade22f01" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466839}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78db71f4-3fc9-53f6-9a4c-5f66663f6749" :question/math-academy-id "q-330298" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** $-2\\cdot {x}_{1}(t)+4\\cdot {x}_{p}(t)$\n- **II.** ${x}_{2}(t)-{x}_{1}(t)+2\\cdot {x}_{p}(t)$\n- **III.** $-7\\cdot {x}_{2}(t)+{x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I might be *not* a solution to the inhomogeneous system. Notice that $-2\\cdot {x}_{1}(t)+4\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $4$ next to the particular solution ${x}_{p}(t).$\n\n- Option II might be *not* a solution to the inhomogeneous system. Notice that ${x}_{2}(t)-{x}_{1}(t)+2\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $2$ next to the particular solution ${x}_{p}(t).$\n\n- Option III is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-7\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{-7\\cdot {x}_{2}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186304812 :knowledge-point/_questions [{:db/id #edb/ref 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed00e399-1ffb-5322-a233-0ae88949f98d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465999} {:answer/id #uuid "2557342b-e85e-5a80-b3fa-69cbbedd5ecd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466000}] :answer-field/correct {:answer/id #uuid "2557342b-e85e-5a80-b3fa-69cbbedd5ecd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466000} :answer-field/id #uuid "633728be-6b0e-5675-bb30-87e26f4d918e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466843} {:answer-field/choices [{:answer/id #uuid "24ff92e7-67c7-5547-bed0-850897cd7252" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466001} {:answer/id #uuid "a5992b59-7848-5b0f-a3b4-3c48f56cb8d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466002}] :answer-field/correct {:answer/id #uuid "a5992b59-7848-5b0f-a3b4-3c48f56cb8d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466002} :answer-field/id #uuid "9207871d-4ce6-5020-9be8-d953e8b91116" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466844} {:answer-field/choices [{:answer/id #uuid "66f0526a-67e7-5227-931a-6aacd9525023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466003} {:answer/id #uuid "7791d5f0-de01-531c-8421-69d34d448c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466004}] :answer-field/correct {:answer/id #uuid "7791d5f0-de01-531c-8421-69d34d448c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466004} :answer-field/id #uuid "e59b0e28-290f-520f-94d6-4f353375a321" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466845}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6d8d0be-fe4e-5e1a-948d-b8eb21d680a7" :question/math-academy-id "q-330302" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** ${x}_{1}(t)+{x}_{p}(t)$\n- **II.** $-3\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- **III.** $7\\cdot {x}_{1}(t)-5\\cdot {x}_{2}(t)+{x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)={x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{{x}_{1}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-3\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{-3\\cdot {x}_{2}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=7\\cdot {x}_{1}(t)-5\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{7\\cdot {x}_{1}(t)-5\\cdot {x}_{2}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is \"I, II and III\"."}] [{:db/id #edb/ref 17592186304813 :knowledge-point/_questions [{:db/id #edb/ref 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6b5959-7e82-580f-8ce3-986e9d787885" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466005} {:answer/id #uuid "10b79adc-acdf-52b8-bb24-cf229ef3e9ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466006}] :answer-field/correct {:answer/id #uuid "10b79adc-acdf-52b8-bb24-cf229ef3e9ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466006} :answer-field/id #uuid "71ca3d40-0366-5608-a056-4c63873a3687" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466846} {:answer-field/choices [{:answer/id #uuid "aee7e526-5079-566b-b43f-55449205d8f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466007} {:answer/id #uuid "3d3b92e9-33ac-5f2f-bd3b-e25b6e845f04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466008}] :answer-field/correct {:answer/id #uuid "3d3b92e9-33ac-5f2f-bd3b-e25b6e845f04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466008} :answer-field/id #uuid "7e6580e8-268c-5643-9eeb-68f96909e1a0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466847} {:answer-field/choices [{:answer/id #uuid "4b8627b9-3e1e-52d5-99b3-46674a6b9203" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466009} {:answer/id #uuid "9f16a7a2-4bda-563c-b9d2-49cc6156f0bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466010}] :answer-field/correct {:answer/id #uuid "4b8627b9-3e1e-52d5-99b3-46674a6b9203" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466009} :answer-field/id #uuid "d8bdf9e9-39fa-5c00-9b52-2a29ea64ca07" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466848}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63b3f264-c6f0-527c-811d-3ed89e69129d" :question/math-academy-id "q-330305" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** $4\\cdot {x}_{1}(t)+{x}_{p}(t)$\n- **II.** $-2\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- **III.** ${x}_{1}(t)+3\\cdot {x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=4\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{4\\cdot {x}_{1}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-2\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{-2\\cdot {x}_{2}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)+3\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $3$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186304814 :knowledge-point/_questions [{:db/id #edb/ref 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c88b0e4e-5a3e-5079-8b0d-dfcc622ee62e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466011} {:answer/id #uuid "08086d2f-8b6f-5681-8f08-bde20907f6ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466012}] :answer-field/correct {:answer/id #uuid "08086d2f-8b6f-5681-8f08-bde20907f6ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466012} :answer-field/id #uuid "797d260f-5ec6-56eb-bc36-d7cda55f4895" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466849} {:answer-field/choices [{:answer/id #uuid "89c338ab-2af4-57e2-ab5f-5093a76750d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466013} {:answer/id #uuid "76aa5d3b-359b-560f-bc95-487efa372d25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466014}] :answer-field/correct {:answer/id #uuid "89c338ab-2af4-57e2-ab5f-5093a76750d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466013} :answer-field/id #uuid "71ccbeb8-7023-5d38-8c4a-7e73be5751bf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466850} {:answer-field/choices [{:answer/id #uuid "b37164e3-6c13-55ea-af30-b7e5107db181" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466015} {:answer/id #uuid "8be1a8f6-5899-561d-9625-51d49bd0dabc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466016}] :answer-field/correct {:answer/id #uuid "b37164e3-6c13-55ea-af30-b7e5107db181" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466015} :answer-field/id #uuid "589c079d-5042-5aa9-a7fb-bf8c5b6dbfec" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466851}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed465271-2eba-5278-8938-505251fa9eb3" :question/math-academy-id "q-330308" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\nI. $2\\cdot {x}_{1}(t)+{x}_{p}(t)$\n\nII. ${x}_{1}(t)-{x}_{2}(t)$\n\nIII. $3\\cdot {x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=2\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{2\\cdot {x}_{1}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)-{x}_{2}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because it lacks the particular solution term ${x}_{p}(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that $3\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $3$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186304815 :knowledge-point/_questions [{:db/id #edb/ref 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c8a81a9-aee0-56a4-b68f-2a2e79bd4516" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466017} {:answer/id #uuid "345d3f7c-1e64-52cb-b627-5780060ae9c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466018}] :answer-field/correct {:answer/id #uuid "345d3f7c-1e64-52cb-b627-5780060ae9c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466018} :answer-field/id #uuid "a12e1ec7-d047-568a-af4b-b20de2971566" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466852} {:answer-field/choices [{:answer/id #uuid "4d802e20-8c04-5766-bd86-0f77748b6c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466019} {:answer/id #uuid "987c28c3-8e1a-579e-8d11-c523886be91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466020}] :answer-field/correct {:answer/id #uuid "987c28c3-8e1a-579e-8d11-c523886be91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466020} :answer-field/id #uuid "805d2c07-a9de-52b8-a22a-e1e4e8b45e36" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466853} {:answer-field/choices [{:answer/id #uuid "987acaa7-0bbf-55e8-a5ab-af5abd891933" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466021} {:answer/id #uuid "fb503b45-96ed-575b-b767-59b553927311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466022}] :answer-field/correct {:answer/id #uuid "fb503b45-96ed-575b-b767-59b553927311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466022} :answer-field/id #uuid "5754b775-f9a5-55de-9c6f-c8ca3b1a0f41" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7119481-1ac5-5669-b8e8-7afd953dbdf9" :question/math-academy-id "q-330309" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n- **I.** $-5\\cdot {x}_{1}(t)+{x}_{p}(t)$\n- **II.** $2\\cdot {x}_{1}(t)-7\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- **III.** ${x}_{2}(t)+{x}_{p}(t)$\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-5\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{-5\\cdot {x}_{1}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=2\\cdot {x}_{1}(t)-7\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{2\\cdot {x}_{1}(t)-7\\cdot {x}_{2}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)={x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{{x}_{2}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is \"I, II and III\"."}] [{:db/id #edb/ref 17592186308380 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b1859e-d928-56d5-8e71-47afe1cae923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}" :db/id #edb/ref 17592186305305} {:answer/id #uuid "12800d6f-8d68-537c-96d5-bd7225473a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-{y}_{\\text{new}}+y-0.25{y}^{2}" :db/id #edb/ref 17592186305313} {:answer/id #uuid "27977427-3d40-516a-b81f-13bd75b2cea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id #edb/ref 17592186305522} {:answer/id #uuid "f1c832ff-12d7-5a60-8d9b-46c88965b97b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}-{y}_{\\text{new}}+0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id #edb/ref 17592186307376} {:answer/id #uuid "f551d69f-aa3e-50b9-9da5-90b5b25f84e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25{y}^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id #edb/ref 17592186307422}] :answer-field/correct {:answer/id #uuid "27977427-3d40-516a-b81f-13bd75b2cea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" :db/id #edb/ref 17592186305522} :answer-field/id #uuid "096a5fe3-b5c8-5575-9621-3bfe10920d20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307556}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee872a11-c24d-55e1-9549-15a9aadbfbd5" :question/math-academy-id "q-333098" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x\\,y-{y}^{2},\\,y(0)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=0.25,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =({x}_{\\text{new}}\\,{y}_{\\text{new}}-({y}_{\\text{new}})^{2})\\cdot 0.25 \\\\  & =0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2} \\\\ \\underbrace{0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.25$ is\n\n$$\ng({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y.\n$$"}] [{:db/id #edb/ref 17592186308381 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c567737-e000-5bfd-8c08-8137a8b55d84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-y+0.5\\,{x}_{\\text{new}}" :db/id #edb/ref 17592186305573} {:answer/id #uuid "8552bd71-2751-58ba-9daa-3400fac32ae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.25{y}^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}" :db/id #edb/ref 17592186306422} {:answer/id #uuid "c825e8c3-dddc-5bca-b705-8b3817f37d60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}" :db/id #edb/ref 17592186307009} {:answer/id #uuid "cd768c27-d512-5219-8d7b-9cfceb7de710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,{y}_{\\text{new}}+y+0.25\\,{x}_{\\text{new}}-0.25{y}^{2}" :db/id #edb/ref 17592186307054} {:answer/id #uuid "f8b5773b-fea6-5649-b47b-1ce4f200389f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y+0.25\\,{x}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}" :db/id #edb/ref 17592186307452}] :answer-field/correct {:answer/id #uuid "c825e8c3-dddc-5bca-b705-8b3817f37d60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}" :db/id #edb/ref 17592186307009} :answer-field/id #uuid "423d28be-8dcb-5543-b664-72165a688fb0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0391ddab-83ad-5a6c-910a-189b80201c1f" :question/math-academy-id "q-333102" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x+{y}^{2},\\,y(0)=3\n$$\n\nUsing the implicit Euler method with step size $Δx=0.25,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =({x}_{\\text{new}}+({y}_{\\text{new}})^{2})\\cdot 0.25 \\\\  & =0.25\\,{x}_{\\text{new}}+0.25({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.25\\,{x}_{\\text{new}}+0.25({y}_{\\text{new}})^{2} \\\\ \\underbrace{-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.25$ is\n\n$$\ng({y}_{\\text{new}})=-0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}.\n$$"}] [{:db/id #edb/ref 17592186308382 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267cec7e-4cd3-5750-990e-500f696b49bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-{y}_{\\text{new}}+y-0.5({x}_{\\text{new}})^{2}" :db/id #edb/ref 17592186305510} {:answer/id #uuid "2901ddcb-afed-501a-b3e7-d0356e15337a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,y-0.5{y}^{2}" :db/id #edb/ref 17592186305537} {:answer/id #uuid "501b6f48-2a5f-5f39-b756-bf5c8f1d256a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,y-0.5({x}_{\\text{new}})^{2}" :db/id #edb/ref 17592186305932} {:answer/id #uuid "b21eb925-c73a-5357-87a9-61e92376b659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-{y}_{\\text{new}}-0.5({x}_{\\text{new}})^{2}" :db/id #edb/ref 17592186306826} {:answer/id #uuid "d143f2e9-c8ad-5075-b8c7-568c90915ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-0.5({x}_{\\text{new}})^{2}" :db/id #edb/ref 17592186307088}] :answer-field/correct {:answer/id #uuid "501b6f48-2a5f-5f39-b756-bf5c8f1d256a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-\\,y-0.5({x}_{\\text{new}})^{2}" :db/id #edb/ref 17592186305932} :answer-field/id #uuid "ba956aa8-9469-5770-ac8b-fbd9f328316d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b416e150-2c65-550a-a50c-8ec6ef536841" :question/math-academy-id "q-333105" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={x}^{2}+2y,\\,y(0)=0\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({x}_{\\text{new}})^{2}+2{y}_{\\text{new}})\\cdot 0.5 \\\\  & =0.5({x}_{\\text{new}})^{2}+{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5({x}_{\\text{new}})^{2}+{y}_{\\text{new}} \\\\ \\underbrace{{y}_{\\text{new}}-y-0.5({x}_{\\text{new}})^{2}-{y}_{\\text{new}}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})=-\\,y-0.5({x}_{\\text{new}})^{2}.\n$$"}] [{:db/id #edb/ref 17592186308383 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6861fbd2-fc06-57ed-ae66-c7d3ddbaaff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}-{y}_{\\text{new}}+2.25{x}_{\\text{new}}-y" :db/id #edb/ref 17592186306147} {:answer/id #uuid "73e5a46f-8b50-58c8-85da-368b7abc9ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}" :db/id #edb/ref 17592186306253} {:answer/id #uuid "87f5b887-79ac-5fb1-80b2-e15ea6a32c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75{y}^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}" :db/id #edb/ref 17592186306450} {:answer/id #uuid "bfda0631-8087-5f34-85cb-b6c62df80589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-y-2.25{x}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}" :db/id #edb/ref 17592186306940} {:answer/id #uuid "c71818e8-36ad-5ce8-9646-30ce5b2ce541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-{y}_{\\text{new}}+y+2.25{x}_{\\text{new}}-0.75{y}^{2}" :db/id #edb/ref 17592186307004}] :answer-field/correct {:answer/id #uuid "73e5a46f-8b50-58c8-85da-368b7abc9ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}" :db/id #edb/ref 17592186306253} :answer-field/id #uuid "492e8811-57e2-5ed2-981d-a4370a65e861" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307752}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f173cd08-22bb-5ca3-9127-e35896086f3a" :question/math-academy-id "q-333106" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=3x-{y}^{2},\\,y(0)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=0.75,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current value $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(3{x}_{\\text{new}}-({y}_{\\text{new}})^{2})\\cdot 0.75 \\\\  & =2.25{x}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+2.25{x}_{\\text{new}}-0.75({y}_{\\text{new}})^{2} \\\\ \\underbrace{0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.75$ is\n\n$$\ng({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-y-2.25{x}_{\\text{new}}.\n$$"}] [{:db/id #edb/ref 17592186308384 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b258dc9-5e5e-5575-9639-fa6d3d88a1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-3" :db/id #edb/ref 17592186305403} {:answer/id #uuid "992a1530-db12-5cdd-861b-04d1f3faeb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{2}+{y}_{\\text{new}}+3" :db/id #edb/ref 17592186306582} {:answer/id #uuid "a28a36de-accf-5d39-82a0-a713b5f75b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-{x}_{\\text{new}}" :db/id #edb/ref 17592186306679} {:answer/id #uuid "ac2d5a74-496e-5511-b7f7-e9955f0ea7f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-3" :db/id #edb/ref 17592186306776} {:answer/id #uuid "d3d6eaed-ad9b-54fb-bff5-557b924bb66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}+3" :db/id #edb/ref 17592186307111}] :answer-field/correct {:answer/id #uuid "1b258dc9-5e5e-5575-9639-fa6d3d88a1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-3" :db/id #edb/ref 17592186305403} :answer-field/id #uuid "e50eff7a-3d2c-5830-9ec0-be4335d66236" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1794ba8-6c42-5082-bb61-41365c6b4043" :question/math-academy-id "q-333114" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={y}^{2}+x,\\,y(0)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({y}_{\\text{new}})^{2}+{x}_{\\text{new}})\\cdot 1 \\\\  & =({y}_{\\text{new}})^{2}+{x}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+({y}_{\\text{new}})^{2}+{x}_{\\text{new}} \\\\ \\underbrace{{y}_{\\text{new}}-({y}_{\\text{new}})^{2}-y-{x}_{\\text{new}}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-y-{x}_{\\text{new}}.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=x+Δx=0+1=1.$ Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & ={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-2-1 \\\\  & ={y}_{\\text{new}}-({y}_{\\text{new}})^{2}-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308385 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c697bd5-7e72-5285-bfc1-1b0b028ff4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}+0.875" :db/id #edb/ref 17592186305575} {:answer/id #uuid "566aadf4-d34a-59e3-9f6f-34686ae7eafb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-0.875" :db/id #edb/ref 17592186305985} {:answer/id #uuid "dc1ae1ba-c460-53a9-b3dd-36fb7ed1c5b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{2}-{y}_{\\text{new}}-0.875" :db/id #edb/ref 17592186307190} {:answer/id #uuid "eb0ff62f-f640-5b7a-a4e3-42fe0f5f1787" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-0.875" :db/id #edb/ref 17592186307314} {:answer/id #uuid "f259509f-933d-5419-b928-9fc8131aab27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-2" :db/id #edb/ref 17592186307384}] :answer-field/correct {:answer/id #uuid "eb0ff62f-f640-5b7a-a4e3-42fe0f5f1787" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-0.875" :db/id #edb/ref 17592186307314} :answer-field/id #uuid "7c7b3cc2-0946-53f6-b52d-50acb6ab13f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce59c975-ea6f-5396-9262-02f983d682d6" :question/math-academy-id "q-333115" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={y}^{2}-{x}^{2},\\,y(1)=2\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({y}_{\\text{new}})^{2}-({x}_{\\text{new}})^{2})\\cdot 0.5 \\\\  & =0.5({y}_{\\text{new}})^{2}-0.5({x}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5({y}_{\\text{new}})^{2}-0.5({x}_{\\text{new}})^{2} \\\\ \\underbrace{{y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-y+0.5({x}_{\\text{new}})^{2}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of $g$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-y+0.5({x}_{\\text{new}})^{2}.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=1+0.5=1.5.$ Therefore, the function used in the first step is\n\nThus,\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & ={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-2+0.5(1.5)^{2} \\\\  & ={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-2+1.125 \\\\  & ={y}_{\\text{new}}-0.5({y}_{\\text{new}})^{2}-0.875.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308386 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54ac79fb-7fee-51ce-8b1d-91d3d1f0d02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-1" :db/id #edb/ref 17592186305971} {:answer/id #uuid "a1d01b53-018c-51ca-897e-3a987524894d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}-1.5{y}_{\\text{new}}+1" :db/id #edb/ref 17592186306667} {:answer/id #uuid "a4c6cb26-d796-5c36-adac-4f333e833c70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}+1" :db/id #edb/ref 17592186306702} {:answer/id #uuid "f57234d9-c1d9-5e5d-b503-d383847d9930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.75({y}_{\\text{new}})^{2}-1.5{y}_{\\text{new}}-1" :db/id #edb/ref 17592186307424} {:answer/id #uuid "ff446e02-3732-54d8-8325-26fc27326d98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-{x}_{\\text{new}}" :db/id #edb/ref 17592186307506}] :answer-field/correct {:answer/id #uuid "54ac79fb-7fee-51ce-8b1d-91d3d1f0d02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-1" :db/id #edb/ref 17592186305971} :answer-field/id #uuid "ed272575-3d43-5a0c-88a5-06b169e42ec6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9a47ae6-ee59-581c-a76f-f2251d0aa676" :question/math-academy-id "q-333118" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x\\,{y}^{2}-y,\\,y(1)=1\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =({x}_{\\text{new}}({y}_{\\text{new}})^{2}-{y}_{\\text{new}})\\cdot 0.5 \\\\  & =0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-0.5{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-0.5{y}_{\\text{new}} \\\\ \\underbrace{1.5{y}_{\\text{new}}-0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-y}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})=1.5{y}_{\\text{new}}-0.5{x}_{\\text{new}}({y}_{\\text{new}})^{2}-y.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=x+Δx=1+0.5=1.5.$ Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & =1.5{y}_{\\text{new}}-0.5\\cdot 1.5\\,({y}_{\\text{new}})^{2}-1 \\\\  & =1.5{y}_{\\text{new}}-0.75({y}_{\\text{new}})^{2}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308387 :knowledge-point/_questions [{:db/id #edb/ref 17592186229154 :knowledge-point/id #uuid "6329ab32-968f-5041-b2e3-12dde408968a" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Implicit Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c352701-baf3-50c9-be83-52c7a97115f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-3" :db/id #edb/ref 17592186305256} {:answer/id #uuid "549f39f3-3bd0-5dc8-8732-f1f1a2058bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=-0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id #edb/ref 17592186305970} {:answer/id #uuid "79af5d53-f61e-5093-bbc4-0243631cf631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id #edb/ref 17592186306311} {:answer/id #uuid "d0f168ea-96c3-50e3-91f4-8a9e2fe8248a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}+3" :db/id #edb/ref 17592186307084} {:answer/id #uuid "f3e31565-0070-525a-9f9a-5f991d0a720a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id #edb/ref 17592186307409}] :answer-field/correct {:answer/id #uuid "79af5d53-f61e-5093-bbc4-0243631cf631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3" :db/id #edb/ref 17592186306311} :answer-field/id #uuid "03b2b73b-444b-554c-8851-bb3c9c5485d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae3b87bc-68e4-5606-a94b-221bbad8f4e1" :question/math-academy-id "q-333119" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={x}^{2}y-{y}^{3},\\,y(1)=3\n$$\n\nUsing the implicit Euler method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step.\nWhich of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(({x}_{\\text{new}})^{2}{y}_{\\text{new}}-({y}_{\\text{new}})^{3})\\cdot 0.5 \\\\  & =0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-0.5({y}_{\\text{new}})^{3}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side and define the resulting expression as $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-0.5({y}_{\\text{new}})^{3} \\\\ \\underbrace{0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nSo, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-0.5({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y.\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=x+Δx=1+0.5=1.5.$ Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & =0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-0.5\\cdot (1.5)^{2}{y}_{\\text{new}}-3 \\\\  & =0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-1.125{y}_{\\text{new}}-3 \\\\  & =0.5({y}_{\\text{new}})^{3}-0.125{y}_{\\text{new}}-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308547 :knowledge-point/_questions [{:db/id #edb/ref 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d44c04f-a0a8-57c1-acde-240e5804349c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" :db/id #edb/ref 17592186305423} {:answer/id #uuid "2e2060f4-f260-5a0e-9344-1014813644b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-2{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-2x\\sqrt{y}" :db/id #edb/ref 17592186305592} {:answer/id #uuid "6b35983e-90e9-58cf-b562-3ce070af8556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-{x}_{\\text{new}}\\sqrt{y}" :db/id #edb/ref 17592186306176} {:answer/id #uuid "a6591279-48bc-5836-b1b7-97a233a064ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}{y}_{\\text{new}}-y-x\\sqrt{y}" :db/id #edb/ref 17592186306717} {:answer/id #uuid "c1247dd6-e5be-5753-b222-3d441ec8eae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" :db/id #edb/ref 17592186306953}] :answer-field/correct {:answer/id #uuid "1d44c04f-a0a8-57c1-acde-240e5804349c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" :db/id #edb/ref 17592186305423} :answer-field/id #uuid "58a9d311-00c5-569d-b6f1-261948280da3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307795}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3f3b808-fce2-5df3-9a0a-894ad2ad09f4" :question/math-academy-id "q-334061" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x\\sqrt{y},\\,y(0)=3\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(2x\\sqrt{y}+2{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}})\\cdot 1 \\\\  & =x\\sqrt{y}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+x\\sqrt{y}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n\\underbrace{{y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}.\n$$"}] [{:db/id #edb/ref 17592186308550 :knowledge-point/_questions [{:db/id #edb/ref 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13dff8a4-01fa-5c80-ab72-846940300d5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}" :db/id #edb/ref 17592186305322} {:answer/id #uuid "2d56b3b9-5b33-54e3-a9df-7aa74c3e6dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{2}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{2}{x}^{3}\\sqrt{y}" :db/id #edb/ref 17592186305583} {:answer/id #uuid "880e5983-a550-56d6-b155-236d2e618523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}" :db/id #edb/ref 17592186306452} {:answer/id #uuid "da37edee-b510-59b4-b5f4-1d303fe78e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}" :db/id #edb/ref 17592186307171} {:answer/id #uuid "fe83ac2a-c91d-5467-a147-b270f7d8b339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{y}" :db/id #edb/ref 17592186307500}] :answer-field/correct {:answer/id #uuid "13dff8a4-01fa-5c80-ab72-846940300d5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}" :db/id #edb/ref 17592186305322} :answer-field/id #uuid "1fd86487-c529-5735-bb2f-27389a63477e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307626}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78bc7144-1726-5ca4-ad6e-1b32173dde50" :question/math-academy-id "q-334067" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=3{x}^{3}\\sqrt{y},\\,y(0)=4\n$$\n\nUsing the trapezoidal method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(3{x}^{3}\\sqrt{y}+3({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}})\\cdot 0.5 \\\\  & =\\frac{3}{4}{x}^{3}\\sqrt{y}+\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{3}{4}{x}^{3}\\sqrt{y}+\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n\\underbrace{{y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{3}{4}({x}_{\\text{new}})^{3}\\sqrt{{y}_{\\text{new}}}-y-\\frac{3}{4}{x}^{3}\\sqrt{y}.\n$$"}] [{:db/id #edb/ref 17592186308551 :knowledge-point/_questions [{:db/id #edb/ref 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b9978b-5659-551a-b1e7-073570eb7dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}^{2}-y-{x}^{2}y" :db/id #edb/ref 17592186305222} {:answer/id #uuid "1db000ba-0ec5-5ebb-b315-0da8395b504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-({x}_{\\text{new}})^{2}y" :db/id #edb/ref 17592186305431} {:answer/id #uuid "2a5f2caa-2477-5356-83a3-6f9d3be52977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y" :db/id #edb/ref 17592186305555} {:answer/id #uuid "2e83309d-176c-5b09-a0ed-78a351fca0e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y" :db/id #edb/ref 17592186305594} {:answer/id #uuid "67084b6a-4622-50d7-9b32-7e1396743053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-2({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-2{x}^{2}y" :db/id #edb/ref 17592186306134}] :answer-field/correct {:answer/id #uuid "2a5f2caa-2477-5356-83a3-6f9d3be52977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y" :db/id #edb/ref 17592186305555} :answer-field/id #uuid "50dd8b65-1f5e-540c-bc65-e9abf47e99d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db67b0bf-a448-5e18-b9c2-88a56fe2b75e" :question/math-academy-id "q-334069" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=4{x}^{2}y,\\,y(0)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(4{x}^{2}y+4({x}_{\\text{new}})^{2}{y}_{\\text{new}})\\cdot 0.5 \\\\  & ={x}^{2}y+({x}_{\\text{new}})^{2}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+{x}^{2}y+({x}_{\\text{new}})^{2}{y}_{\\text{new}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n\\underbrace{{y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y.\n$$"}] [{:db/id #edb/ref 17592186308552 :knowledge-point/_questions [{:db/id #edb/ref 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ccb4ae4-2645-577b-b2c3-c4a076d2a116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y" :db/id #edb/ref 17592186305262} {:answer/id #uuid "4d17bb5c-87aa-5516-ac49-431c18a84116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{2}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{2}{x}^{3}y" :db/id #edb/ref 17592186305898} {:answer/id #uuid "5340e35d-182d-5a24-a953-ed8aa1aee1d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}({x}_{\\text{new}})^{3}y" :db/id #edb/ref 17592186305956} {:answer/id #uuid "91d873de-f728-530f-b8c4-4378b3a78c77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y" :db/id #edb/ref 17592186306532} {:answer/id #uuid "be7e4cd8-1010-5398-bb8c-1a480836d425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}^{2}-y-\\frac{5}{4}{x}^{3}y" :db/id #edb/ref 17592186306927}] :answer-field/correct {:answer/id #uuid "91d873de-f728-530f-b8c4-4378b3a78c77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y" :db/id #edb/ref 17592186306532} :answer-field/id #uuid "556d70f3-4f1f-533a-bdf2-e3220bfdae3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307781}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f055e80-81ea-55eb-ae51-846a4bd0843f" :question/math-academy-id "q-334070" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=5{x}^{3}y,\\,y(0)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(5{x}^{3}y+5({x}_{\\text{new}})^{3}{y}_{\\text{new}})\\cdot 0.5 \\\\  & =\\frac{5}{4}{x}^{3}y+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{5}{4}{x}^{3}y+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n\\underbrace{{y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y.\n$$"}] [{:db/id #edb/ref 17592186308553 :knowledge-point/_questions [{:db/id #edb/ref 17592186229156 :knowledge-point/id #uuid "05af3055-c035-5e11-8946-8791c21a18ac" :knowledge-point/title "Determining the Function on Which to Apply a Root-Finding Method When Applying the Trapezoidal Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cd05e14-396b-5be5-bff6-ac19aef37eec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}" :db/id #edb/ref 17592186306044} {:answer/id #uuid "7048bffb-2ca4-5d55-9281-28de38e47fc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{3}-y-3\\sqrt{x}\\,{y}^{2}" :db/id #edb/ref 17592186306221} {:answer/id #uuid "abfd2ce3-b7f2-51dc-9222-398dfa8745df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}" :db/id #edb/ref 17592186306773} {:answer/id #uuid "c23aef71-58d9-5960-9b6c-4c7f96828b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-6\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-6\\sqrt{x}\\,{y}^{2}" :db/id #edb/ref 17592186306963} {:answer/id #uuid "d168eb42-e316-5d51-868a-e6a69bdab79c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{{x}_{\\text{new}}}\\,{y}^{2}" :db/id #edb/ref 17592186307089}] :answer-field/correct {:answer/id #uuid "abfd2ce3-b7f2-51dc-9222-398dfa8745df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}" :db/id #edb/ref 17592186306773} :answer-field/id #uuid "85885c05-b84b-5026-9703-2f6893461fad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "113a0a61-21ac-5c28-bc2b-027553b8fdc6" :question/math-academy-id "q-334072" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=6\\sqrt{x}\\,{y}^{2},\\,y(1)=2\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(6\\sqrt{x}\\,{y}^{2}+6\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2})\\cdot 1 \\\\  & =3\\sqrt{x}\\,{y}^{2}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+3\\sqrt{x}\\,{y}^{2}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n\\underbrace{{y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}.\n$$"}] [{:db/id #edb/ref 17592186308688 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4bfced-4c23-541f-b242-4c2ea02d35eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3t}" :db/id #edb/ref 17592186306347} {:answer/id #uuid "72e16707-4ff3-5dfd-9eed-366cbfa6fe18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id #edb/ref 17592186479531}] :answer-field/correct {:answer/id #uuid "72e16707-4ff3-5dfd-9eed-366cbfa6fe18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id #edb/ref 17592186479531} :answer-field/id #uuid "52d98b8a-0ce9-5cfa-a498-ed17c16b2e6d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307772} {:answer-field/choices [{:answer/id #uuid "f1c22720-1aa8-597e-9b76-8432cec4de4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3t}" :db/id #edb/ref 17592186307375} {:answer/id #uuid "27dc7621-01eb-5ac6-8247-fe730465d634" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id #edb/ref 17592186479418}] :answer-field/correct {:answer/id #uuid "27dc7621-01eb-5ac6-8247-fe730465d634" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3t}" :db/id #edb/ref 17592186479418} :answer-field/id #uuid "cba95706-4eaf-526e-986f-73babc57c464" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "001f1d7b-e465-5a31-aa71-fce5efbdd939" :question/math-academy-id "q-334824" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{3t}\\end{bmatrix},\\,x(0)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix},$ where $A=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$(t-s){e}^{3t}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{3t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{bmatrix}\\begin{bmatrix}0 \\\\ {e}^{3s}\\end{bmatrix} \\\\  & =\\begin{bmatrix}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}{e}^{3t} \\\\ 0\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308692 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "237ca5ab-34cd-58e7-9713-b55a6e87c11b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5t}" :db/id #edb/ref 17592186305489}] :answer-field/correct {:answer/id #uuid "237ca5ab-34cd-58e7-9713-b55a6e87c11b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5t}" :db/id #edb/ref 17592186305489} :answer-field/id #uuid "1dd60399-b452-5b9e-ab6f-1b2c49d47ce4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307619} {:answer-field/choices [{:answer/id #uuid "752cf0f7-34a2-5108-a051-4523e28c9195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{5(t-1)}" :db/id #edb/ref 17592186306265}] :answer-field/correct {:answer/id #uuid "752cf0f7-34a2-5108-a051-4523e28c9195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{5(t-1)}" :db/id #edb/ref 17592186306265} :answer-field/id #uuid "92d548ec-0d73-5a36-8fa4-84091d6ec494" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307985}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc8319e7-c74a-546c-ac46-138a893fec53" :question/math-academy-id "q-334848" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}x+\\begin{bmatrix}{e}^{5t} \\\\ 0\\end{bmatrix},\\,x(1)=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix},$ where $A=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.$*\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+{\\int }_{1}^{t}\\,\\,$ |  | {{field-2}} |  | $\\,\\,\\text{d}s$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $0$ |  |  | $0$ |  |  |  |  |" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =\\begin{bmatrix}{e}^{5(t-1)} & (t-1){e}^{5(t-1)} \\\\ 0 & {e}^{5(t-1)}\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{e}^{5(t-1)} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}\\begin{bmatrix}{e}^{5s} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{5t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}2{e}^{5(t-1)} \\\\ 0\\end{bmatrix}+{\\int }_{1}^{t}\\begin{bmatrix}{e}^{5t} \\\\ 0\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308695 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160b514e-c7a9-5db1-8962-33d86d078fb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2(t-s))" :db/id #edb/ref 17592186305342}] :answer-field/correct {:answer/id #uuid "160b514e-c7a9-5db1-8962-33d86d078fb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2(t-s))" :db/id #edb/ref 17592186305342} :answer-field/id #uuid "63437be9-2066-5dad-a01a-a0e02722c169" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307836} {:answer-field/choices [{:answer/id #uuid "05184db4-a95b-5878-863f-1aa2b4e40630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}(2t)" :db/id #edb/ref 17592186305198}] :answer-field/correct {:answer/id #uuid "05184db4-a95b-5878-863f-1aa2b4e40630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}(2t)" :db/id #edb/ref 17592186305198} :answer-field/id #uuid "f1530c65-7d45-5311-814a-529b693ace24" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308286}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7aef4d9e-5adf-5d9d-be87-6231a093c423" :question/math-academy-id "q-334855" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}x+\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,x(0)=\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$*\n\n| $x(t)=\\,\\,$ |  | $3\\operatorname{sin}⁡(2t)$ |  | $\\,\\,+{\\int }_{0}^{t}\\,\\,$ |  | {{field-1}} |  | $\\,\\,\\text{d}s$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} |  |  | $-\\operatorname{sin}⁡(2(t-s))$ |  |  |  |  |" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\operatorname{sin}⁡(2t) \\\\ 3\\operatorname{cos}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}3\\operatorname{sin}⁡(2t) \\\\ 3\\operatorname{cos}⁡(2t)\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s))\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308696 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b12c1e03-c805-5e36-aea2-b6d121e73478" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4(t-s))" :db/id #edb/ref 17592186306815} {:answer/id #uuid "74474233-2fa8-51ba-9cb4-da5296695f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos(4(t-s))" :db/id #edb/ref 17592186479536}] :answer-field/correct {:answer/id #uuid "74474233-2fa8-51ba-9cb4-da5296695f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos(4(t-s))" :db/id #edb/ref 17592186479536} :answer-field/id #uuid "13f5abdf-75a7-5b21-afa3-653d497c5d41" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307584} {:answer-field/choices [{:answer/id #uuid "ab25cf3f-5e10-5e03-b9ec-f148d948ee64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{cos}(4t)" :db/id #edb/ref 17592186306768} {:answer/id #uuid "677ff288-ab7f-56c0-a677-5f7330959d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cos(4t)" :db/id #edb/ref 17592186479513}] :answer-field/correct {:answer/id #uuid "677ff288-ab7f-56c0-a677-5f7330959d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cos(4t)" :db/id #edb/ref 17592186479513} :answer-field/id #uuid "1f9d3c90-4891-5e53-85e9-0abe74fcc6f2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307623}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3b7f24-1005-522b-87d6-a7afb67ecc23" :question/math-academy-id "q-334858" :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}x+\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,x(0)=\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$5\\operatorname{sin}⁡(4t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$-\\operatorname{sin}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}\\begin{bmatrix}0 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}5\\operatorname{sin}⁡(4t) \\\\ 5\\operatorname{cos}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}5\\operatorname{sin}⁡(4t) \\\\ 5\\operatorname{cos}⁡(4t)\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308718 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c139fc5d-402e-5c97-b048-caf60e14b36c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}(2t)-\\operatorname{cos}(2t)+3" :db/id #edb/ref 17592186306955} {:answer/id #uuid "6963f53e-90b3-59a4-b3ac-6bc885da9965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\cos(2t)+2\\sin(2t)" :db/id #edb/ref 17592186494533}] :answer-field/correct {:answer/id #uuid "6963f53e-90b3-59a4-b3ac-6bc885da9965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\cos(2t)+2\\sin(2t)" :db/id #edb/ref 17592186494533} :answer-field/id #uuid "8b933995-aeb2-5960-92c8-2edb1a0843a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307958}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03656a1f-f3fa-5cdf-b35f-3b5febfaad49" :question/math-academy-id "q-335054" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=2y(t) \\\\ {y}^{′}(t) &=-2x(t)+3,\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\frac{1}{2}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"180px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{bmatrix}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\operatorname{sin}⁡(2(t-s)) \\\\ 3\\operatorname{cos}⁡(2(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}3\\operatorname{sin}⁡(2(t-s)) \\\\ 3\\operatorname{cos}⁡(2(t-s))\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}\\frac{3}{2}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\frac{3}{2}\\operatorname{sin}⁡(2(t-s))\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\frac{1}{2}\\begin{bmatrix}3-3\\operatorname{cos}⁡(2t) \\\\ 3\\operatorname{sin}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(2t)\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}3-3\\operatorname{cos}⁡(2t) \\\\ 3\\operatorname{sin}⁡(2t)\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2\\operatorname{sin}⁡(2t)-\\operatorname{cos}⁡(2t)+3 \\\\ \\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2\\operatorname{sin}⁡(2t)-\\operatorname{cos}⁡(2t)+3 \\\\ \\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308719 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9104f75-3823-5343-b10e-35210deee4b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4t)" :db/id #edb/ref 17592186307163}] :answer-field/correct {:answer/id #uuid "d9104f75-3823-5343-b10e-35210deee4b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4t)" :db/id #edb/ref 17592186307163} :answer-field/id #uuid "0de54400-c651-59cf-a2eb-bab2e9e63b82" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307571}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "411e1067-1bf2-5810-9a74-3f6443bfc23e" :question/math-academy-id "q-335058" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=4y(t)-4 \\\\ {y}^{′}(t) &=-4x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$*\n\n| $\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | $1-\\operatorname{sin}⁡(4t)$ |  |  |" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}-4 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4t)+\\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\operatorname{cos}⁡(4(t-s)) \\\\ 4\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}-4\\operatorname{cos}⁡(4(t-s)) \\\\ 4\\operatorname{sin}⁡(4(t-s))\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-\\operatorname{sin}⁡(4(t-s)) \\\\ \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}-\\operatorname{sin}⁡(4t) \\\\ 1-\\operatorname{cos}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}\\operatorname{cos}⁡(4t)+\\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t)\\end{bmatrix}+\\begin{bmatrix}-\\operatorname{sin}⁡(4t) \\\\ 1-\\operatorname{cos}⁡(4t)\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(4t) \\\\ 1-\\operatorname{sin}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308723 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29953a21-209b-586e-a213-f4a4fa9d67d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{-t}" :db/id #edb/ref 17592186305546}] :answer-field/correct {:answer/id #uuid "29953a21-209b-586e-a213-f4a4fa9d67d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{-t}" :db/id #edb/ref 17592186305546} :answer-field/id #uuid "af02c77a-cb82-5db7-8040-47a534b70764" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308078}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47fdaa8b-a137-5a55-9e2b-f6799e375b7a" :question/math-academy-id "q-335081" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=-x(t)+y(t)+1 \\\\ {y}^{′}(t) &=-y(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix},$ where $A=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}.$*\n\n| $\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | $0$ |  |  |" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{-(t-s)} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}{e}^{-(t-s)} \\\\ 0\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-{e}^{-(t-s)} \\\\ 0\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}1-{e}^{-t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}1-{e}^{-t} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-{e}^{-t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308724 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8e79b01-2389-5a91-bd1b-47d545c124e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5t}-1" :db/id #edb/ref 17592186307021} {:answer/id #uuid "06fe7ba9-e60a-5a45-b758-fa0196ee521e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{5t}-1" :db/id #edb/ref 17592186479370}] :answer-field/correct {:answer/id #uuid "06fe7ba9-e60a-5a45-b758-fa0196ee521e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{5t}-1" :db/id #edb/ref 17592186479370} :answer-field/id #uuid "2c1add94-bde4-538a-ae6f-d06b8a3019c5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307659}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19468931-2ce6-5bd0-af7b-5212e5297c87" :question/math-academy-id "q-335085" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=5x(t)+y(t)+1 \\\\ {y}^{′}(t) &=5y(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix},$ where $A=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\frac{1}{5}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{5(t-s)} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{5(t-s)} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}{e}^{5(t-s)} \\\\ 0\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-\\frac{1}{5}{e}^{5(t-s)} \\\\ 0\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}{e}^{5t}-1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308736 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f2cc77d-908e-5975-babf-c7e95d32af6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(t)" :db/id #edb/ref 17592186306066} {:answer/id #uuid "6d657aec-32ba-5cf6-9bf5-c39f0c00dc78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cosh}⁡(t)" :db/id #edb/ref 17592186306197} {:answer/id #uuid "851c1af3-2a69-5a9e-aeb2-bdc919879a73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(t)" :db/id #edb/ref 17592186306419} {:answer/id #uuid "b970e691-2738-5a66-b02c-0fc82876b459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡(t)" :db/id #edb/ref 17592186306880}] :answer-field/correct {:answer/id #uuid "5f2cc77d-908e-5975-babf-c7e95d32af6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(t)" :db/id #edb/ref 17592186306066} :answer-field/id #uuid "99185d97-eb59-509d-8409-76c2030ce0cc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186308005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d6b9f30-3747-520a-a2bd-7bc874e4c993" :question/math-academy-id "q-335127" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=y(t)+1 \\\\ {y}^{′}(t) &=x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(t) & \\operatorname{sinh}⁡(t) \\\\ \\operatorname{sinh}⁡(t) & \\operatorname{cosh}⁡(t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{cosh}⁡(t)-1$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)=\\underbrace{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{\\text{homogeneous part}}+\\underbrace{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(t) & \\operatorname{sinh}⁡(t) \\\\ \\operatorname{sinh}⁡(t) & \\operatorname{cosh}⁡(t)\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(t) & \\operatorname{sinh}⁡(t) \\\\ \\operatorname{sinh}⁡(t) & \\operatorname{cosh}⁡(t)\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) & \\operatorname{sinh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s) & \\operatorname{cosh}⁡(t-s)\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) & \\operatorname{sinh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s) & \\operatorname{cosh}⁡(t-s)\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s)\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}\\begin{bmatrix}\\operatorname{cosh}⁡(t-s) \\\\ \\operatorname{sinh}⁡(t-s)\\end{bmatrix}\\text{d}s \\\\  & ={\\begin{bmatrix}-\\operatorname{sinh}⁡(t-s) \\\\ -\\operatorname{cosh}⁡(t-s)\\end{bmatrix}}_{s=0}^{s=t} \\\\  & =\\begin{bmatrix}\\operatorname{sinh}⁡(t) \\\\ \\operatorname{cosh}⁡(t)-1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}\\operatorname{sinh}⁡(t) \\\\ \\operatorname{cosh}⁡(t)-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{sinh}⁡(t) \\\\ \\operatorname{cosh}⁡(t)-1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311579 :knowledge-point/_questions [{:db/id #edb/ref 17592186157454 :knowledge-point/id #uuid "ffe4292f-7653-5486-975e-c206acae734e" :knowledge-point/title "Applying Properties of Big-O"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc96a6c-1b5c-596d-a55b-44a85cb939a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the reflexive property" :db/id #edb/ref 17592186308831} {:answer/id #uuid "39484591-d743-5b44-82f7-59b55da76c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the sum property" :db/id #edb/ref 17592186309183} {:answer/id #uuid "4582fef9-a1f8-5f84-b672-d3dc49fdabab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id #edb/ref 17592186309278} {:answer/id #uuid "87b97dd1-23ad-519f-841e-616a1cfa6ddf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id #edb/ref 17592186309815} {:answer/id #uuid "d1510fae-b5c1-516c-a249-ed9a5614f5cf" :answer/type {:db/id #edb/ref 17592186045498 :db/i