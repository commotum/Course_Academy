}^{2} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(4,2)} & ={\\frac{1}{2}\\sqrt{u}-2{v}^{2}\\,|}_{u=4\\,v=2} \\\\  & =\\frac{1}{2}\\sqrt{4}-2(2)^{2} \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-7|\\cdot \\delta A \\\\  & =7\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281368 :knowledge-point/_questions [{:db/id #edb/ref 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018385f7-7519-5922-8545-718d1e4443e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186278597} {:answer/id #uuid "09f72da4-93f7-5f6e-8f5c-7adf97a2d87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186278688} {:answer/id #uuid "42229dfb-92db-527f-98d4-81e464debdce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,\\delta A" :db/id #edb/ref 17592186279182} {:answer/id #uuid "5806f5cb-b442-516d-a7af-f295ed7a67a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\delta A" :db/id #edb/ref 17592186279401} {:answer/id #uuid "b63f49ff-6805-5e3d-9a84-bb5bf0cb46d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186280191}] :answer-field/correct {:answer/id #uuid "09f72da4-93f7-5f6e-8f5c-7adf97a2d87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186278688} :answer-field/id #uuid "30341de0-d7c9-531a-935d-0764a34a14a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280923}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8a571cf4-d621-5149-95d3-896e62b990d5" :question/math-academy-id "q-161875" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(0,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\operatorname{cos}⁡u-{v}^{2} \\\\ u+v\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot \\underbrace{\\text{Area}(Δ)}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\operatorname{sin}⁡u & -2v \\\\ 1 & 1\\end{aligned}| \\\\  & =(-\\operatorname{sin}⁡u)\\cdot 1-1\\cdot (-2v) \\\\  & =-\\operatorname{sin}⁡u+2v \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(0,3)} & =(-\\operatorname{sin}⁡u+2v)\\,{|}_{u=0\\,v=3} \\\\  & =-\\operatorname{sin}⁡0+2(3) \\\\  & =6\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|6|\\cdot \\delta A \\\\  & =6\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281371 :knowledge-point/_questions [{:db/id #edb/ref 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6868218d-e1cc-5d50-a993-c991f43b1d4f" :answer/type {:db/id #edb/ref 17592186045498 :db/id