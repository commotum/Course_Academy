0-3\\text{i} & 0+5\\text{i} \\\\ -4+0\\text{i} & 5+0\\text{i}\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}0 & 0 \\\\ -4 & 5\\end{bmatrix}}_{\\text{Re}(A)}+\\text{i}\\underbrace{\\begin{bmatrix}-3 & 5 \\\\ 0 & 0\\end{bmatrix}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $a=0,c=-4,f=5$ and $h=0.$ Therefore,\n\n$$\nah-cf=0\\cdot 0-(-4)\\cdot 5=20.\n$$"}] [{:db/id #edb/ref 17592186345192 :knowledge-point/_questions [{:db/id #edb/ref 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41d289b1-173b-5941-a82a-cd3eb177ca1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186342778} {:answer/id #uuid "5590b136-2148-5765-ba42-4872df4f3a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186342949} {:answer/id #uuid "b7b63991-e097-507e-8d58-bb1825341d01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186343849} {:answer/id #uuid "bddcd176-e192-5da2-98c9-8a41a86d4f96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186343909} {:answer/id #uuid "c13c6f25-efb1-5263-8ada-3dc3f47c23f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 9 & 1\\end{bmatrix}" :db/id #edb/ref 17592186343935}] :answer-field/correct {:answer/id #uuid "41d289b1-173b-5941-a82a-cd3eb177ca1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186342778} :answer-field/id #uuid "f4ad0e08-50c7-5ef0-a697-128f90e1eea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344921}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee75bb73-f205-5858-a7b6-5d0fd3c5399e" :question/math-academy-id "q-76207" :question/problem "Find the imaginary part of the matrix $A=\\begin{bmatrix}8+\\text{i} & 3-4\\text{i} \\\\ 9 & \\text{i}\\end{bmatrix}.$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}8+\\text{i} & 3-4\\text{i} \\\\ 9 & \\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}8+\\text{i} & 3-4\\text{i} \\\\ 9+0\\text{i} & 0+\\text{i}\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}8 & 3 \\\\ 9 & 0\\end{bmatrix}}_{\\text{Re}(A)}+\\text{i}\\underbrace{\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Im}(A)=\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}.$"}] [{:db/id #edb/ref 17592186345206 :knowledge-point/_questions [{:db/id #edb/ref 17592186119858 :knowledge-point/id #uuid "b72ed196-a73b-59ab-a7c3-5173249cf7e5" :knowledge-point/title "Determining Whether a Given Set Is a Basis of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197bd366-c81c-5437-b024-3f9d9bfd5aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186342460} {:answer/id #uuid "59e05b25-5ac5-5d45-ae93-9b733bcc76c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186342992} {:answer/id #uuid "5d257bf3-941e-554d-8180-8794daa7ac3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186343020} {:answer/id #uuid "d66cf36f-294b-5f58-921a-852e39d8f27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186344117} {:answer/id #uuid "e2ca80bb-1258-550a-aa42-b3394f1d777b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${{a}_{1},{a}_{2}}$ is not a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$" :db/id #edb/ref 17592186344232}] :answer-field/correct {:answer/id #uuid "5d257bf3-941e-554d-8180-8794daa7ac3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186343020} :answer-field/id #uuid "326d46d2-1179-5751-b87a-d1f30eaecfc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22366352-9de1-515d-ad32-c51e7aed6aa3" :question/math-academy-id "q-76322" :question/problem "The vectors ${a}_{1},$ ${a}_{2},$ and ${a}_{3}$ are given below. Determine whether $B={{a}_{1},{a}_{2}}$ is a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ If that is the case, find ${x}_{1}\\cdot {x}_{2},$ where ${a}_{3}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 6\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}8 \\\\ 12\\end{bmatrix}\n$$" :question/worked-solution "We want to determine if $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ So, we want to find ${x}_{1},{x}_{2}\\in R$ such that \n\n$$\n{x}_{1}\\underbrace{\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}}_{{a}_{1}}+{x}_{2}\\underbrace{\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}}_{{a}_{2}}=\\underbrace{\\begin{bmatrix}8 \\\\ 12\\end{bmatrix}}_{{a}_{3}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=8 \\\\ -3{x}_{1}+6{x}_{2} &=12\\end{aligned}\\right.\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}1 & 2 & 8 \\\\ -3 & 6 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 8 \\\\ 0 & 12 & 36\\end{bmatrix} & {R}_{2} & :=\\frac{1}{12}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 8 \\\\ 0 & 1 & 3\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the RREF matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So,  $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$\nAlso, the matrix tells us that ${x}_{1}=2$ and ${x}_{2}=3,$ meaning that\n\n$$\n2\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}}_{{a}_{1}}+3\\cdot \\underbrace{\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}}_{{a}_{2}}=\\underbrace{\\begin{bmatrix}8 \\\\ 12\\end{bmatrix}}_{{a}_{3}}.\n$$\n\nTherefore, ${x}_{1}\\cdot {x}_{2}=2\\cdot 3=6.$"}] [{:db/id #edb/ref 17592186345207 :knowledge-point/_questions [{:db/id #edb/ref 17592186119858 :knowledge-point/id #uuid "b72ed196-a73b-59ab-a7c3-5173249cf7e5" :knowledge-point/title "Determining Whether a Given Set Is a Basis of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95f36be6-cd64-5615-8d16-39562702c1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186343548} {:answer/id #uuid "a08e0041-2623-5213-93f8-af7c8a4a59c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186343654} {:answer/id #uuid "cab5fefa-ef95-5879-810f-a84973f144fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186344022} {:answer/id #uuid "f42281b7-bdfc-55bb-ad9e-2dd4c13364eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186344387} {:answer/id #uuid "8d2d9553-3fcc-5436-9ae5-e9313490ab61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\{{a}_{1},{a}_{2}\\}$ is not a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$" :db/id #edb/ref 17592186429760}] :answer-field/correct {:answer/id #uuid "cab5fefa-ef95-5879-810f-a84973f144fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186344022} :answer-field/id #uuid "6d12dcd5-966c-540d-9792-0af9d3cf5c37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344690}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40af98fe-8e4f-539d-b55b-52163dd7e4ff" :question/math-academy-id "q-76327" :question/problem "The vectors ${a}_{1},$ ${a}_{2},$ and ${a}_{3}$ are given below. Determine whether $B=\\{{a}_{1},{a}_{2}\\}$ is a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ If that is the case, find ${x}_{1}\\cdot {x}_{2},$ where ${a}_{3}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-6 \\\\ -10\\end{bmatrix}\n$$" :question/worked-solution "We want to determine if $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ So, we want to find ${x}_{1},{x}_{2}\\in R$ such that \n\n$$\n{x}_{1}\\underbrace{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{{a}_{1}}+{x}_{2}\\underbrace{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}}_{{a}_{2}}=\\underbrace{\\begin{bmatrix}-6 \\\\ -10\\end{bmatrix}}_{{a}_{3}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2} &=-6 \\\\ {x}_{1}+2{x}_{2} &=-10\\end{aligned}\\right.\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}1 & 1 & -6 \\\\ 1 & 2 & -10\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -6 \\\\ 0 & 1 & -4\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 1 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the RREF matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So,  $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\nAlso, the matrix tells us that ${x}_{1}=-2$ and ${x}_{2}=-4,$ meaning that\n\n$$\n(-2)\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{{a}_{1}}+(-4)\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}}_{{a}_{2}}=\\underbrace{\\begin{bmatrix}-6 \\\\ -10\\end{bmatrix}}_{{a}_{3}}.\n$$\n\nTherefore, ${x}_{1}\\cdot {x}_{2}=(-2)\\cdot (-4)=8.$"}] [{:db/id #edb/ref 17592186348260 :knowledge-point/_questions [{:db/id #edb/ref 17592186087866 :knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0646fdce-fd3c-56a7-8137-632d215be116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-xy=2x" :db/id #edb/ref 17592186345404} {:answer/id #uuid "5a9afd84-fe8c-56a0-89e1-00f6ac764479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-(1+x)y=0" :db/id #edb/ref 17592186346123} {:answer/id #uuid "71040d28-62bb-5d78-b4e6-2a190574112e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-xy={x}^{2}" :db/id #edb/ref 17592186346349} {:answer/id #uuid "d204e6a5-02d7-5404-bddf-a96974b0383d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-y=-{x}^{2}" :db/id #edb/ref 17592186347190} {:answer/id #uuid "d895b1af-8150-5cb7-9f48-017f2ef90f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+xy=\\frac{1}{x}" :db/id #edb/ref 17592186347259}] :answer-field/correct {:answer/id #uuid "71040d28-62bb-5d78-b4e6-2a190574112e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-xy={x}^{2}" :db/id #edb/ref 17592186346349} :answer-field/id #uuid "74ddf3aa-733e-5972-8973-46d76ff540e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f284d9d4-47c8-54c3-aa2b-11e7ba22d40f" :question/math-academy-id "q-79697" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n(\\frac{1}{{x}^{2}})\\frac{\\text{d}y}{\\text{d}x}=\\frac{x+y}{x}\\,.\n$$" :question/worked-solution "A first order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\\,,\n$$\n\nwhere $P(x)$ and $Q(x)$ do not depend on $y.$\n\n$$\n\n$$\n\nWe have\n\n$$\n\\begin{aligned}(\\frac{1}{{x}^{2}})\\frac{\\text{d}y}{\\text{d}x} & =\\frac{x+y}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={x}^{2}(\\frac{x+y}{x}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =x(x+y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={x}^{2}+xy \\\\ \\frac{\\text{d}y}{\\text{d}x}\\,+\\underbrace{(-x)}_{P(x)}y & =\\underbrace{{x}^{2}}_{Q(x)} \\\\ \\frac{\\text{d}y}{\\text{d}x}-xy & ={x}^{2}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=-x$ and $Q(x)={x}^{2}.$"}] [{:db/id #edb/ref 17592186348261 :knowledge-point/_questions [{:db/id #edb/ref 17592186087866 :knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049ae29b-8ef2-515e-817d-95125832b9ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}\\,-5{e}^{x}y=-{e}^{x}" :db/id #edb/ref 17592186345388} {:answer/id #uuid "139be62e-1605-5f69-b8d1-6b7a2554416d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}\\,+5y=-{e}^{x}" :db/id #edb/ref 17592186345521} {:answer/id #uuid "3e94f02d-431a-5153-8655-00b4a87c74f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}\\,-5{e}^{x}y=x" :db/id #edb/ref 17592186345883} {:answer/id #uuid "4ef9fe74-cdac-5d6d-8da5-effef6765981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}\\,+5{e}^{-x}y={e}^{-x}" :db/id #edb/ref 17592186346026} {:answer/id #uuid "50906fb5-5aea-54da-a635-e0e0c3771435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-5xy=-{e}^{-x}" :db/id #edb/ref 17592186346040}] :answer-field/correct {:answer/id #uuid "049ae29b-8ef2-515e-817d-95125832b9ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}\\,-5{e}^{x}y=-{e}^{x}" :db/id #edb/ref 17592186345388} :answer-field/id #uuid "92ad19c6-417f-54a2-8eac-d9c3b03caa0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a5eea4d-3d1c-5658-8171-517491bf7c77" :question/math-academy-id "q-79699" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n5{y}^{2}-y{e}^{-x}\\frac{\\text{d}y}{\\text{d}x}=y,\\,y\\ne 0.\n$$" :question/worked-solution "A first order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\\,,\n$$\n\nwhere $P(x)$ and $Q(x)$ do not depend on $y.$\n\n$$\n\n$$\n\nWe have\n\n$$\n\\begin{aligned}5{y}^{2}-y{e}^{-x}\\frac{\\text{d}y}{\\text{d}x} & =y \\\\ -y{e}^{-x}\\frac{\\text{d}y}{\\text{d}x}+5{y}^{2}-y & =0 \\\\ -y({e}^{-x}\\frac{\\text{d}y}{\\text{d}x}-5y+1) & =0 \\\\ {e}^{-x}\\frac{\\text{d}y}{\\text{d}x}-5y+1 & =0 \\\\ {e}^{x}({e}^{-x}\\frac{\\text{d}y}{\\text{d}x}-5y+1) & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x}-5y{e}^{x}+{e}^{x} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x}\\,+\\underbrace{(-5{e}^{x})}_{P(x)}y & =\\underbrace{-{e}^{x}}_{Q(x)} \\\\ \\frac{\\text{d}y}{\\text{d}x}-5{e}^{x}y & =-{e}^{x}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=-5{e}^{x}$ and $Q(x)=-{e}^{x}.$"}] [{:db/id #edb/ref 17592186351196 :knowledge-point/_questions [{:db/id #edb/ref 17592186157424 :knowledge-point/id #uuid "037ff08b-3246-5eed-870b-b4951f319c96" :knowledge-point/title "Evaluating a Hessian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a863fee-48cb-518a-94c7-332f0d5dfb90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186348671} {:answer/id #uuid "236352e1-e284-5137-93e8-01d0c0b82dd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186348749} {:answer/id #uuid "cd6da9cd-0b80-5391-a066-ff87ff441cbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186350254} {:answer/id #uuid "d5b5d5ad-403a-5e9b-b47e-9495ed54eecd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350322} {:answer/id #uuid "da828216-6cb2-53d2-9a0c-74a4b4c5a870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186350365}] :answer-field/correct {:answer/id #uuid "da828216-6cb2-53d2-9a0c-74a4b4c5a870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186350365} :answer-field/id #uuid "0f56bbbf-1a13-5c6d-a2d7-69c5469daa32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350734}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0dab700a-fa4f-5675-9473-37a2b428ee20" :question/math-academy-id "q-81023" :question/problem "Given that \n${f}^{′}(x,y)=\\begin{bmatrix}2(x-1){y}^{2} & 2(x-1)^{2}y\\end{bmatrix},$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(0,1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:\\underbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=\\begin{bmatrix}2(x-1){y}^{2} & 2(x-1)^{2}y\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=2(x-1){y}^{2},\\,\\frac{∂f}{∂y}=2(x-1)^{2}y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2(x-1){y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2(x-1)^{2}y)=4(x-1)y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2(x-1){y}^{2})=4(x-1)y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2(x-1)^{2}y)=2(x-1)^{2}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}2{y}^{2} & 4(x-1)y \\\\ 4(x-1)y & 2(x-1)^{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(0,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,1)=\\begin{bmatrix}2 & -4 \\\\ -4 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(0,1)=2\\cdot 2-(-4)\\cdot (-4)=-12.\n$$"}] [{:db/id #edb/ref 17592186351224 :knowledge-point/_questions [{:db/id #edb/ref 17592186157423 :knowledge-point/id #uuid "74c4234a-3aa1-5b6b-b68b-48e6aa2b0dfb" :knowledge-point/title "Finding the Second Derivative of a Function Given Its First Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "425c4600-816d-5d3d-a9f5-610a8c6f6b97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-{e}^{2} & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186349049} {:answer/id #uuid "5b410b83-b065-5e13-9b2d-6ef4baf10829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{2-x} & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186349287} {:answer/id #uuid "cb7db402-a450-5d26-b53a-3c303da293b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-{e}^{2-x} & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186350237} {:answer/id #uuid "fb980d82-64ab-5a6d-bc31-3b09443b34e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{-x} & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186350666} {:answer/id #uuid "ffa20bb0-a35b-5276-af26-5bf35fc36a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}e & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186350703}] :answer-field/correct {:answer/id #uuid "5b410b83-b065-5e13-9b2d-6ef4baf10829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{2-x} & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186349287} :answer-field/id #uuid "92d68f61-fe7f-5864-9dfe-8847dee23855" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350956}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5fc8ae5c-d352-5fd3-ae18-630a629fa87e" :question/math-academy-id "q-81110" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)$ given that\n${f}^{′}(x,y)=\\begin{bmatrix}e-{e}^{2-x} & 2y\\end{bmatrix}$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:\\underbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=\\begin{bmatrix}e-{e}^{2-x} & 2y\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=e-{e}^{2-x},\\,\\frac{∂f}{∂y}=2y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(e-{e}^{2-x})={e}^{2-x}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y)=0 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(e-{e}^{2-x})=0\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y)=2\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}{e}^{2-x} & 0 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351225 :knowledge-point/_questions [{:db/id #edb/ref 17592186157425 :knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92" :knowledge-point/title "Finding the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f668f1-6f0e-5f03-b24f-252b61525c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{{x}^{2}+{y}^{2}} & 2{e}^{{x}^{2}+{y}^{2}} \\\\ 2{e}^{{x}^{2}+{y}^{2}} & {e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}" :db/id #edb/ref 17592186348618} {:answer/id #uuid "1add0944-c518-57ff-ac8e-03b370a5e1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 0 \\\\ 0 & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}" :db/id #edb/ref 17592186348676} {:answer/id #uuid "a1a2227e-48bd-56c9-81ed-74c049e159a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 4xy{e}^{{x}^{2}+{y}^{2}} \\\\ 4xy{e}^{{x}^{2}+{y}^{2}} & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}" :db/id #edb/ref 17592186349885} {:answer/id #uuid "d1a8889f-460d-579b-bd13-17b7e4dee99e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 2{e}^{{x}^{2}+{y}^{2}} \\\\ 2{e}^{{x}^{2}+{y}^{2}} & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}" :db/id #edb/ref 17592186350287} {:answer/id #uuid "e4ff04a1-b040-539e-b8a9-e7c0a5de4c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}(2+4x){e}^{{x}^{2}+{y}^{2}} & 2{e}^{{x}^{2}+{y}^{2}} \\\\ 2{e}^{{x}^{2}+{y}^{2}} & (2+4y){e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}" :db/id #edb/ref 17592186350455}] :answer-field/correct {:answer/id #uuid "a1a2227e-48bd-56c9-81ed-74c049e159a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 4xy{e}^{{x}^{2}+{y}^{2}} \\\\ 4xy{e}^{{x}^{2}+{y}^{2}} & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}" :db/id #edb/ref 17592186349885} :answer-field/id #uuid "f5510882-92e2-5e9a-b981-503b92ddedf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351139}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e5fb489-dfa6-50c2-a270-dc2d65f25d4f" :question/math-academy-id "q-81111" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)={e}^{{x}^{2}+{y}^{2}}.$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:\\underbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂x}({e}^{{x}^{2}+{y}^{2}}) & \\frac{∂}{∂y}({e}^{{x}^{2}+{y}^{2}})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x{e}^{{x}^{2}+{y}^{2}} & 2y{e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives: \n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{e}^{{x}^{2}+{y}^{2}})=(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y{e}^{{x}^{2}+{y}^{2}})=4xy{e}^{{x}^{2}+{y}^{2}} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{e}^{{x}^{2}+{y}^{2}})=4xy{e}^{{x}^{2}+{y}^{2}}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y{e}^{{x}^{2}+{y}^{2}})=(2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\n  \n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 4xy{e}^{{x}^{2}+{y}^{2}} \\\\ 4xy{e}^{{x}^{2}+{y}^{2}} & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351229 :knowledge-point/_questions [{:db/id #edb/ref 17592186157425 :knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92" :knowledge-point/title "Finding the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0379a8f3-5c08-5a0e-9aa9-ee7247f5bb7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2y & 2x \\\\ 2x & 2({x}^{2}-1)\\end{bmatrix}" :db/id #edb/ref 17592186348479} {:answer/id #uuid "0f2c18f5-f6c6-5cb7-9bd3-ef891a719882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2y & 0 \\\\ 0 & 2({x}^{2}-1)\\end{bmatrix}" :db/id #edb/ref 17592186348580} {:answer/id #uuid "235323a0-a480-5c75-9639-2308eb39664a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2y & 2xy \\\\ 2xy & 2({x}^{2}-1)\\end{bmatrix}" :db/id #edb/ref 17592186348748} {:answer/id #uuid "3438c329-ab2c-5701-840d-707e4cfa738f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2y \\\\ 2y & 2({x}^{2}-1)\\end{bmatrix}" :db/id #edb/ref 17592186348915} {:answer/id #uuid "703d071f-0017-59ad-ade4-9601ec2c639e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{bmatrix}" :db/id #edb/ref 17592186349481}] :answer-field/correct {:answer/id #uuid "703d071f-0017-59ad-ade4-9601ec2c639e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{bmatrix}" :db/id #edb/ref 17592186349481} :answer-field/id #uuid "1892be87-58b9-5f45-a8a1-451663b051c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "235e87ab-40f0-5bca-9e1d-4479ce5e2de8" :question/math-academy-id "q-81119" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)={y}^{2}({x}^{2}-1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:\\underbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂x}({y}^{2}({x}^{2}-1)) & \\frac{∂}{∂y}({y}^{2}({x}^{2}-1))\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x{y}^{2} & 2y({x}^{2}-1)\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives: \n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y({x}^{2}-1))=4xy \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{y}^{2})=4xy\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y({x}^{2}-1))=2({x}^{2}-1)\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351230 :knowledge-point/_questions [{:db/id #edb/ref 17592186157425 :knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92" :knowledge-point/title "Finding the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c42b794-72d6-514f-85b6-40ef2b7dcd98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 \\\\ 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186348690} {:answer/id #uuid "3454730a-5aab-57e6-8c0f-17209a604055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186348916} {:answer/id #uuid "7b479b77-d903-5f0c-8f7d-530e7863b915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186349579} {:answer/id #uuid "f6f41cb7-2e5a-5303-bc84-7130dab8c440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186350611} {:answer/id #uuid "fb35d3bb-cccc-50cf-84a5-4d39d7149a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -2 \\\\ -2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186350661}] :answer-field/correct {:answer/id #uuid "fb35d3bb-cccc-50cf-84a5-4d39d7149a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -2 \\\\ -2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186350661} :answer-field/id #uuid "bb30829b-8d9a-5a87-b3fc-44d8886af1ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351029}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0469958-83f9-5c79-aae7-bbff4a96354f" :question/math-academy-id "q-81123" :question/problem "Find ${f}^{″}(-1,2)$ for the function $f(x,y)=(y-1)({x}^{2}-1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:\\underbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂x}((y-1)({x}^{2}-1)) & \\frac{∂}{∂y}((y-1)({x}^{2}-1))\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x(y-1) & {x}^{2}-1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x(y-1))=2(y-1)\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({x}^{2}-1)=2x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x(y-1))=2x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({x}^{2}-1)=0\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}2(y-1) & 2x \\\\ 2x & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(-1,2).$ This gives\n\n$$\n\\begin{aligned}{f}^{″}(-1,2)=\\begin{bmatrix}2 & -2 \\\\ -2 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351262 :knowledge-point/_questions [{:db/id #edb/ref 17592186124572 :knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e" :knowledge-point/title "Restoring a Matrix Given Its Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "768e3afb-bb09-5e8d-afce-24265c595101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -2 \\\\ -4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186349537} {:answer/id #uuid "8b60cf77-97aa-5202-8d4e-811565f0e808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186349708} {:answer/id #uuid "8ea6050c-f1c9-5dd1-b2f0-9331f4c3eb90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186349731} {:answer/id #uuid "dd99276d-af91-5354-a572-a9a70ed58f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 3 \\\\ -8 & 10\\end{bmatrix}" :db/id #edb/ref 17592186350384} {:answer/id #uuid "f3e335fc-583e-509e-ace9-504cc6b7c779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 3 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186350581}] :answer-field/correct {:answer/id #uuid "dd99276d-af91-5354-a572-a9a70ed58f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 3 \\\\ -8 & 10\\end{bmatrix}" :db/id #edb/ref 17592186350384} :answer-field/id #uuid "91c9727d-1213-5c42-9fe0-34caddae9641" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c93e7214-d507-511f-96e2-a29d77beb762" :question/math-academy-id "q-81210" :question/problem "Find a $2\\times 2$ matrix $E$ that has eigenvalues ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=6,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=\\begin{bmatrix}3 \\\\ 4\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $E,$ then $E$ must be diagonalizable.\n\nSo, we can write $E=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $E,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nE=\\underbrace{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}_{P}\\underbrace{\\begin{bmatrix}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{bmatrix}}_{D}\\underbrace{{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}^{-1}}_{{P}^{-1}}\n$$\n\nLet $P=\\begin{bmatrix}3 & 2 \\\\ 4 & 4\\end{bmatrix}.$ Then,\n\n$$\n\\begin{aligned}{P}^{-1} & ={\\begin{bmatrix}3 & 2 \\\\ 4 & 4\\end{bmatrix}}^{-1}=\\frac{1}{4}\\begin{bmatrix}4 & -2 \\\\ -4 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}E & =\\begin{bmatrix}3 & 2 \\\\ 4 & 4\\end{bmatrix}\\begin{bmatrix}4 & 0 \\\\ 0 & 6\\end{bmatrix}(\\frac{1}{4}\\begin{bmatrix}4 & -2 \\\\ -4 & 3\\end{bmatrix}) \\\\  & =\\frac{1}{4}\\begin{bmatrix}12 & 12 \\\\ 16 & 24\\end{bmatrix}\\begin{bmatrix}4 & -2 \\\\ -4 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 3 \\\\ -8 & 10\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351264 :knowledge-point/_questions [{:db/id #edb/ref 17592186124572 :knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e" :knowledge-point/title "Restoring a Matrix Given Its Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7579ab44-bd79-5efe-b0c2-f284657c4cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 & 4 \\\\ 15 & 4\\end{bmatrix}" :db/id #edb/ref 17592186349527} {:answer/id #uuid "8e42582e-5cb4-5323-a399-3b20a65879bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}13 & -12 \\\\ 10 & -9\\end{bmatrix}" :db/id #edb/ref 17592186349729} {:answer/id #uuid "bb84f3e0-0aaf-50c7-8d43-3326b2bff35b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 4 \\\\ 5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186350116} {:answer/id #uuid "e07ef508-ba37-54d5-9f11-5ede72a99e7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -4 \\\\ -5 & 6\\end{bmatrix}" :db/id #edb/ref 17592186350419} {:answer/id #uuid "e861d1eb-9875-5c71-862e-3da22156c169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & -13 \\\\ 9 & 10\\end{bmatrix}" :db/id #edb/ref 17592186350480}] :answer-field/correct {:answer/id #uuid "8e42582e-5cb4-5323-a399-3b20a65879bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}13 & -12 \\\\ 10 & -9\\end{bmatrix}" :db/id #edb/ref 17592186349729} :answer-field/id #uuid "7b0b11ff-0df6-52af-aa76-996c6a221114" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "725672f2-a45d-5f52-bf51-6290d583f846" :question/math-academy-id "q-81215" :question/problem "Find a $2\\times 2$ matrix $S$ that has eigenvalues ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=1,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=\\begin{bmatrix}6 \\\\ 5\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $S,$ then $S$ must be diagonalizable.\n\nSo, we can write $S=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $S,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nS=\\underbrace{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}_{P}\\underbrace{\\begin{bmatrix}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{bmatrix}}_{D}\\underbrace{{\\begin{bmatrix}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{bmatrix}}^{-1}}_{{P}^{-1}}\n$$\n\nLet $P=\\begin{bmatrix}6 & 1 \\\\ 5 & 1\\end{bmatrix}.$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={\\begin{bmatrix}6 & 1 \\\\ 5 & 1\\end{bmatrix}}^{-1}=\\frac{1}{1}\\begin{bmatrix}1 & -1 \\\\ -5 & 6\\end{bmatrix}=\\begin{bmatrix}1 & -1 \\\\ -5 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}S & =\\begin{bmatrix}6 & 1 \\\\ 5 & 1\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ -5 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}18 & 1 \\\\ 15 & 1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ -5 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}13 & -12 \\\\ 10 & -9\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351511 :knowledge-point/_questions [{:db/id #edb/ref 17592186054683 :knowledge-point/id #uuid "d418552d-d147-5736-8acd-5ba237a90e07" :knowledge-point/title "Finding the General Term for the Derivative of a Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c9a982e-789e-57ee-9313-d961168981dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{(x+2)^{n+1}}{(n-1)!}" :db/id #edb/ref 17592186348694} {:answer/id #uuid "2591d7dd-e5ac-526d-b029-e19dd18733ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=(n+1)(x+2)^{n}" :db/id #edb/ref 17592186348770} {:answer/id #uuid "370122c6-0175-5269-be0f-7443f6c20c3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{(n+1)(x+2)^{n}}{n}" :db/id #edb/ref 17592186348942} {:answer/id #uuid "38611bce-0eda-5c55-9458-cd66822817fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{(n+1)(x+2)^{n+1}}{n}" :db/id #edb/ref 17592186348957} {:answer/id #uuid "f96a6180-de48-52ee-bbac-e0f6f2b37a33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{(n+1)(x+2)^{n}}{n!}" :db/id #edb/ref 17592186350638}] :answer-field/correct {:answer/id #uuid "f96a6180-de48-52ee-bbac-e0f6f2b37a33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{(n+1)(x+2)^{n}}{n!}" :db/id #edb/ref 17592186350638} :answer-field/id #uuid "fed5e4b2-7bc2-5e3c-934d-74d159ac03ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351153}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3cb83323-0582-536b-82c9-36fd3324b5dc" :question/math-academy-id "q-83461" :question/problem "The Taylor series for the function $f(x)$ about $x=-2$ is given by\n\n$$\nf(x)={\\sum }_{n=1}^{\\infty }(-1)^{n}\\frac{(x+2)^{n+1}}{n!}.\n$$\n\nFind ${a}_{n},$ given that\n\n$$\n{f}^{′}(x)={\\sum }_{n=1}^{\\infty }(-1)^{n}{a}_{n}.\n$$" :question/worked-solution "Writing the terms of the series explicitly, we have\n\n$$\n\\begin{aligned}f(x) & =-(x+2)^{2}+\\frac{1}{2!}(x+2)^{3}-⋯+\\underbrace{(-1)^{n}\\frac{(x+2)^{n+1}}{n!}}_{\\text{the }n\\text{th term}}+⋯.\\end{aligned}\n$$\n\nDifferentiating the above series term-by-term gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-2(x+2)+\\frac{3}{2!}(x+2)^{2}-⋯+\\underbrace{(-1)^{n}\\frac{(n+1)(x+2)^{n}}{n!}}_{\\text{the }n\\text{th term}}+⋯.\\end{aligned}\n$$\n\nWe can now write the Taylor series for ${f}^{′}(x)$ using the sigma notation as follows:\n\n$$\n{f}^{′}(x)={\\sum }_{n=1}^{\\infty }(-1)^{n}\\frac{(n+1)(x+2)^{n}}{n!}\n$$\n\nComparing the series above with the given series, we can deduce that\n\n$$\n{a}_{n}=\\frac{(n+1)(x+2)^{n}}{n!}.\n$$"}] [{:db/id #edb/ref 17592186351512 :knowledge-point/_questions [{:db/id #edb/ref 17592186054683 :knowledge-point/id #uuid "d418552d-d147-5736-8acd-5ba237a90e07" :knowledge-point/title "Finding the General Term for the Derivative of a Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14efd8da-92d9-56ca-87f0-7b9c109fd645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{{n}^{2}(x-3)^{n-1}}{n+3}" :db/id #edb/ref 17592186348624} {:answer/id #uuid "2d12e31b-4e0d-5cbf-b3f5-530c47674393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{n(x-3)^{n-1}}{n+3}" :db/id #edb/ref 17592186348843} {:answer/id #uuid "74c8d362-fff4-5ad6-a29f-ddb61e16e9c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{{n}^{2}(x-3)^{n}}{n+3}" :db/id #edb/ref 17592186349520} {:answer/id #uuid "a4f48129-9fe7-5698-ad6a-8a09d7e036b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{(x-3)^{n-1}}{n+3}" :db/id #edb/ref 17592186349919} {:answer/id #uuid "e1e5bc7a-a560-5d6d-b4ad-5f19f818004a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{n(x-3)^{n}}{n+3}" :db/id #edb/ref 17592186350435}] :answer-field/correct {:answer/id #uuid "14efd8da-92d9-56ca-87f0-7b9c109fd645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{{n}^{2}(x-3)^{n-1}}{n+3}" :db/id #edb/ref 17592186348624} :answer-field/id #uuid "dd8be60f-8890-5517-8355-b858e2ff7c0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351093}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3072a41e-55dc-5057-8605-bd6994ecfa75" :question/math-academy-id "q-83463" :question/problem "The Taylor series for the function $f(x)$ about $x=3$ is given by\n\n$$\nf(x)={\\sum }_{n=1}^{\\infty }(-1)^{n+1}\\frac{n(x-3)^{n}}{n+3}.\n$$\n\nFind ${a}_{n},$ given that\n\n$$\n{f}^{′}(x)={\\sum }_{n=1}^{\\infty }(-1)^{n+1}{a}_{n}.\n$$" :question/worked-solution "Writing the terms of the series explicitly, we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{4}(x-3)-\\frac{2}{5}(x-3)^{2}+⋯+\\underbrace{(-1)^{n+1}\\frac{n(x-3)^{n}}{n+3}}_{\\text{the }n\\text{th term}}+⋯.\\end{aligned}\n$$\n\nDifferentiating the above series term-by-term gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{1}{4}-\\frac{4}{5}(x-3)+⋯+\\underbrace{(-1)^{n+1}\\frac{{n}^{2}(x-3)^{n-1}}{n+3}}_{\\text{the }n\\text{th term}}+⋯.\\end{aligned}\n$$\n\nWe can now write the Taylor series for ${f}^{′}(x)$ using the sigma notation as follows:\n\n$$\n{f}^{′}(x)={\\sum }_{n=1}^{\\infty }(-1)^{n+1}\\frac{{n}^{2}(x-3)^{n-1}}{n+3}\n$$\n\nComparing the series above with the given series, we can deduce that\n\n$$\n{a}_{n}=\\frac{{n}^{2}(x-3)^{n-1}}{n+3}.\n$$"}] [{:db/id #edb/ref 17592186354408 :knowledge-point/_questions [{:db/id #edb/ref 17592186133848 :knowledge-point/id #uuid "5924037a-ddc3-5f50-b4b0-1bd813cef255" :knowledge-point/title "Finding the Distance Between a Vector to a Subspace of Solutions of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a65464-7728-54f8-82e5-5a2139643a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{141}" :db/id #edb/ref 17592186352091} {:answer/id #uuid "82393b05-c41a-5547-a882-b804e6c62041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186352700} {:answer/id #uuid "aacaaba4-ab74-5368-89bd-bd264c67aed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186353013} {:answer/id #uuid "ca2b6dc7-09dd-5774-8bb3-21a78e74780b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{111}" :db/id #edb/ref 17592186353324} {:answer/id #uuid "e4c12ebd-3d57-549f-806e-0c3911d9efbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{114}" :db/id #edb/ref 17592186353565}] :answer-field/correct {:answer/id #uuid "e4c12ebd-3d57-549f-806e-0c3911d9efbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{114}" :db/id #edb/ref 17592186353565} :answer-field/id #uuid "4c5b6c7d-97a2-5520-a2b8-341edc162192" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "476850d6-1065-514f-9c2e-38a6ce482b21" :question/math-academy-id "q-85278" :question/problem "Consider the system $Ax=b$, where the matrix $A$ and the vector $b$ are given below. Given that the columns of $A$ are linearly independent, find the minimum value of $‖Ax-b‖.$\n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ -1 & 1 \\\\ 1 & -1\\end{bmatrix},\\,b=\\begin{bmatrix}6 \\\\ 0 \\\\ 9 \\\\ 6\\end{bmatrix}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overbrace{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ -1 & 1 \\\\ 1 & -1\\end{bmatrix}}^{A}\\overbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}}^{x} & =\\overbrace{\\begin{bmatrix}6 \\\\ 0 \\\\ 9 \\\\ 6\\end{bmatrix}}^{b} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}1 & 1 & -1 & 1 \\\\ -2 & -1 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ -1 & 1 \\\\ 1 & -1\\end{bmatrix})}^{-1}\\begin{bmatrix}1 & 1 & -1 & 1 \\\\ -2 & -1 & 1 & -1\\end{bmatrix}\\begin{bmatrix}6 \\\\ 0 \\\\ 9 \\\\ 6\\end{bmatrix} \\\\  & ={\\begin{bmatrix}4 & -5 \\\\ -5 & 7\\end{bmatrix}}^{-1}\\begin{bmatrix}3 \\\\ -9\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}7 & 5 \\\\ 5 & 4\\end{bmatrix}\\begin{bmatrix}3 \\\\ -9\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nThe minimum value of $‖Ax-b‖$ is attained when $x=\\hat{x},$ which is the least-squares solution of the system $Ax=b.$ In this case, $A\\hat{x}$ represents the orthogonal projection of $b$ onto the column space of $A,$ and $‖A\\hat{x}-b‖$ is the distance between the vector $b$ and the column space. Therefore,\n\n$$\n\\begin{aligned}A\\hat{x}-b & =\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ -1 & 1 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}-8 \\\\ -7\\end{bmatrix}-\\begin{bmatrix}6 \\\\ 0 \\\\ 9 \\\\ 6\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1 \\\\ -8 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n‖A\\hat{x}-b‖=\\sqrt{{0}^{2}+(-1)^{2}+(-8)^{2}+(-7)^{2}}=\\sqrt{114}.\n$$"}] [{:db/id #edb/ref 17592186354409 :knowledge-point/_questions [{:db/id #edb/ref 17592186133848 :knowledge-point/id #uuid "5924037a-ddc3-5f50-b4b0-1bd813cef255" :knowledge-point/title "Finding the Distance Between a Vector to a Subspace of Solutions of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb3bac9-cce7-5665-8498-a91231b362d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186351693} {:answer/id #uuid "2b1a3d3a-a796-5667-954c-1ac273943f89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{17}" :db/id #edb/ref 17592186351958} {:answer/id #uuid "37274342-d16b-5dbb-b2ca-57ddd587c88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{71}" :db/id #edb/ref 17592186352080} {:answer/id #uuid "8bca07bf-2a3f-5acc-bea4-d63eb68cd5f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{71}" :db/id #edb/ref 17592186352786} {:answer/id #uuid "b7338b51-8139-5d2f-8cea-d81f922627ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186353134}] :answer-field/correct {:answer/id #uuid "37274342-d16b-5dbb-b2ca-57ddd587c88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{71}" :db/id #edb/ref 17592186352080} :answer-field/id #uuid "a221e58d-1676-5cff-be01-420fdcdb8b0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354097}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c34a906-4ce9-5f9d-848e-084be407b879" :question/math-academy-id "q-85280" :question/problem "Consider the system $Ax=b$, where the matrix $A$ and the vector $b$ are given below. Given that the columns of $A$ are linearly independent, find the minimum value of $‖Ax-b‖.$\n\n$$\nA=\\begin{bmatrix}2 & -1 \\\\ 0 & 1 \\\\ -2 & 0 \\\\ 0 & 2\\end{bmatrix},\\,b=\\begin{bmatrix}10 \\\\ 20 \\\\ -1 \\\\ 17\\end{bmatrix}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overbrace{\\begin{bmatrix}2 & -1 \\\\ 0 & 1 \\\\ -2 & 0 \\\\ 0 & 2\\end{bmatrix}}^{A}\\overbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}}^{x} & =\\overbrace{\\begin{bmatrix}10 \\\\ 20 \\\\ -1 \\\\ 17\\end{bmatrix}}^{b} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}2 & 0 & -2 & 0 \\\\ -1 & 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 0 & 1 \\\\ -2 & 0 \\\\ 0 & 2\\end{bmatrix})}^{-1}\\begin{bmatrix}2 & 0 & -2 & 0 \\\\ -1 & 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}10 \\\\ 20 \\\\ -1 \\\\ 17\\end{bmatrix} \\\\  & ={\\begin{bmatrix}8 & -2 \\\\ -2 & 6\\end{bmatrix}}^{-1}\\begin{bmatrix}22 \\\\ 44\\end{bmatrix} \\\\  & =\\frac{1}{22}\\begin{bmatrix}3 & 1 \\\\ 1 & 4\\end{bmatrix}\\begin{bmatrix}22 \\\\ 44\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$\n\nThe minimum value of $‖Ax-b‖$ is attained when $x=\\hat{x},$ which is the least-squares solution of the system $Ax=b.$ In this case, $A\\hat{x}$ represents the orthogonal projection of $b$ onto the column space of $A,$ and $‖A\\hat{x}-b‖$ is the distance between the vector $b$ and the column space. Therefore,\n\n$$\n\\begin{aligned}A\\hat{x}-b & =\\begin{bmatrix}2 & -1 \\\\ 0 & 1 \\\\ -2 & 0 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}-\\begin{bmatrix}10 \\\\ 20 \\\\ -1 \\\\ 17\\end{bmatrix}=\\begin{bmatrix}-9 \\\\ -11 \\\\ -9 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n‖A\\hat{x}-b‖=\\sqrt{(-9)^{2}+(-11)^{2}+(-9)^{2}+{1}^{2}}=2\\sqrt{71}.\n$$"}] [{:db/id #edb/ref 17592186354410 :knowledge-point/_questions [{:db/id #edb/ref 17592186133848 :knowledge-point/id #uuid "5924037a-ddc3-5f50-b4b0-1bd813cef255" :knowledge-point/title "Finding the Distance Between a Vector to a Subspace of Solutions of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59881df0-2ac6-532e-8fb9-91b698aa746f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186352356} {:answer/id #uuid "6136a078-6ec6-579a-809a-d2077533b6a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186352433} {:answer/id #uuid "76500562-20f2-5c7e-bdb3-4992adaf7d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{111}" :db/id #edb/ref 17592186352607} {:answer/id #uuid "7917c258-2cdc-5cb9-a21d-ebdf986ccad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{101}" :db/id #edb/ref 17592186352623} {:answer/id #uuid "7cb29578-9f41-5fba-9274-bad7f34afe91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{110}" :db/id #edb/ref 17592186352661}] :answer-field/correct {:answer/id #uuid "7cb29578-9f41-5fba-9274-bad7f34afe91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{110}" :db/id #edb/ref 17592186352661} :answer-field/id #uuid "7e227d03-ecbf-552f-86b6-2f39084c0aba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354049}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "22b88813-fc85-5da7-b050-31934e04cdb3" :question/math-academy-id "q-85284" :question/problem "Consider the system $Ax=b$, where the matrix $A$ and the vector $b$ are shown below. Given that the columns of $A$ are linearly independent, find the minimum value of $‖Ax-b‖.$\n\n$$\nA=\\begin{bmatrix}1 & 1 \\\\ 0 & -1 \\\\ 1 & 1 \\\\ 1 & 0 \\\\ -1 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 1 \\\\ 14 \\\\ 1 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overbrace{\\begin{bmatrix}1 & 1 \\\\ 0 & -1 \\\\ 1 & 1 \\\\ 1 & 0 \\\\ -1 & 1\\end{bmatrix}}^{A}\\overbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}}^{x} & =\\overbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ 14 \\\\ 1 \\\\ 1\\end{bmatrix}}^{b} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}1 & 0 & 1 & 1 & -1 \\\\ 1 & -1 & 1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 0 & -1 \\\\ 1 & 1 \\\\ 1 & 0 \\\\ -1 & 1\\end{bmatrix})}^{-1}\\,\\,\\begin{bmatrix}1 & 0 & 1 & 1 & -1 \\\\ 1 & -1 & 1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 14 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & ={\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix}}^{-1}\\begin{bmatrix}15 \\\\ 15\\end{bmatrix} \\\\  & =\\frac{1}{15}\\begin{bmatrix}4 & -1 \\\\ -1 & 4\\end{bmatrix}\\begin{bmatrix}15 \\\\ 15\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe minimum value of $‖Ax-b‖$ is attained when $x=\\hat{x},$ which is the least-squares solution of the system $Ax=b.$ In this case, $A\\hat{x}$ represents the orthogonal projection of $b$ onto the column space of $A,$ and $‖A\\hat{x}-b‖$ is the distance between the vector $b$ and the column space. Therefore,\n\n$$\n\\begin{aligned}A\\hat{x}-b & =\\begin{bmatrix}1 & 1 \\\\ 0 & -1 \\\\ 1 & 1 \\\\ 1 & 0 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 1 \\\\ 14 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}5 \\\\ -4 \\\\ -8 \\\\ 2 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n‖A\\hat{x}-b‖=\\sqrt{{5}^{2}+(-4)^{2}+(-8)^{2}+{2}^{2}+(-1)^{2}}=\\sqrt{110}.\n$$"}] [{:db/id #edb/ref 17592186354425 :knowledge-point/_questions [{:db/id #edb/ref 17592186092180 :knowledge-point/id #uuid "bec73486-156f-5124-97b4-58f65ea8430d" :knowledge-point/title "Using the Trapezoidal Rule With Irregular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58b5467d-b3c5-5fa1-8dd8-e7968657a579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{2}" :db/id #edb/ref 17592186352347} {:answer/id #uuid "8710d42d-7935-5a34-a159-c3d52b9c79f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186352747} {:answer/id #uuid "b7f6acc7-b014-57e3-a7f0-774f0d026721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{75}{4}" :db/id #edb/ref 17592186353144} {:answer/id #uuid "ee21e249-28f2-5619-971e-832911f96ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186353641} {:answer/id #uuid "f92703f1-8b0a-55f6-8313-c3424a334bd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{39}{2}" :db/id #edb/ref 17592186353743}] :answer-field/correct {:answer/id #uuid "f92703f1-8b0a-55f6-8313-c3424a334bd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{39}{2}" :db/id #edb/ref 17592186353743} :answer-field/id #uuid "de862061-c08e-53ba-9c58-6b2f598b2524" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c8ccca6-4e29-5faa-987e-8624611baf62" :question/math-academy-id "q-85683" :question/problem "Using the trapezoidal rule with the partition\n\n$$\n[-1,2]=[-1,0]\\cup [0,2],\n$$\n\napproximate the area under the curve of the function $y=\\frac{10}{1+{x}^{2}}.$" :question/worked-solution "Let $f(x)=\\frac{10}{1+{x}^{2}}.$ Let's plot this function:\n\n![](images/c4/c4c9aa8e615747199462e0597f4cb7be82031efdb5b2f6585e3fb9c0b652ee78.png)\n\nWe've drawn some trapezoids to help calculate our trapezoidal rule sum. By calculating the area of each trapezoid, we obtain the following approximation for our area $A:$\n\n$$\nA≈\\overbrace{[\\,\\frac{\\overbrace{f(-1)+f(0)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{1}}_{\\text{height}}\\,]}^{1\\text{st trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(0)+f(2)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{2}}_{\\text{height}}\\,]}^{2\\text{nd trapezoid}}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{5+10}{2}\\cdot (0-(-1))+\\frac{10+2}{2}\\cdot (2-0) \\\\  & =\\frac{15}{2}\\cdot 1+\\frac{12}{2}\\cdot 2 \\\\  & =\\frac{15}{2}+12 \\\\  & =\\frac{39}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354431 :knowledge-point/_questions [{:db/id #edb/ref 17592186092180 :knowledge-point/id #uuid "bec73486-156f-5124-97b4-58f65ea8430d" :knowledge-point/title "Using the Trapezoidal Rule With Irregular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20c33d56-02a5-55a1-987b-f18618f02ab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{51}{4}" :db/id #edb/ref 17592186351859} {:answer/id #uuid "56c3feda-01c0-54f6-9ead-50588c1e134c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{59}{4}" :db/id #edb/ref 17592186352332} {:answer/id #uuid "6fee69a4-9d15-57e5-9494-bb3b8ffd602f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{29}{2}" :db/id #edb/ref 17592186352550} {:answer/id #uuid "b8126dbd-926a-548c-ae76-4a7fc73ef299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186353145} {:answer/id #uuid "c5ed98eb-c41a-50d8-a21b-e1b53145334b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186353283}] :answer-field/correct {:answer/id #uuid "6fee69a4-9d15-57e5-9494-bb3b8ffd602f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{29}{2}" :db/id #edb/ref 17592186352550} :answer-field/id #uuid "07c262c8-b003-5f0c-b3d2-74d61bf1d3cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353830}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ca2808a-5bb5-5c46-a46a-d74fa247deba" :question/math-academy-id "q-85725" :question/problem "Using the trapezoidal rule with the partition\n\n$$\n[-1,4]=[-1,0]\\cup [0,3]\\cup [3,4],\n$$\n\napproximate the area under the curve of the continuous function $y=f(x)$ whose data is given in the table below.\n\n| $x$ | $-1$ | $0$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $0$ | $2$ | $4$ | $5$ |" :question/worked-solution "Let's plot what this function might look like, using the values given in the table.\n\n![](images/48/48212ed7c5cf3d8b6e523a98b91634320b8684c889e55d62ce4043f082f83cde.png)\n\nWe've drawn some trapezoids to help calculate our trapezoidal rule sum. By calculating the area of each trapezoid, we obtain the following approximation for our area $A:$\n\n$$\nA≈\\overbrace{[\\,\\frac{\\overbrace{f(-1)+f(0)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{1}}_{\\text{height}}\\,]}^{1\\text{st trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(0)+f(3)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{2}}_{\\text{height}}\\,]}^{2\\text{nd trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(3)+f(4)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{3}}_{\\text{height}}\\,]}^{3\\text{rd trapezoid}}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{0+2}{2}\\cdot (0-(-1))+\\frac{2+4}{2}\\cdot (3-0)+\\frac{4+5}{2}\\cdot (4-3) \\\\  & =1\\cdot 1+3\\cdot 3+\\frac{9}{2}\\cdot 1 \\\\  & =1+9+\\frac{9}{2} \\\\  & =\\frac{29}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354432 :knowledge-point/_questions [{:db/id #edb/ref 17592186092180 :knowledge-point/id #uuid "bec73486-156f-5124-97b4-58f65ea8430d" :knowledge-point/title "Using the Trapezoidal Rule With Irregular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66866db0-87c2-53a2-889d-76a9fbcb702d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186352471} {:answer/id #uuid "73e18a41-8ed8-533b-8dbe-522231f48baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186352582} {:answer/id #uuid "966717c0-09db-5b27-8cab-82ac8885b55d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186352869} {:answer/id #uuid "ba6cc7d2-ebd5-5064-84cf-a03a3771dfb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{39}{2}" :db/id #edb/ref 17592186353153} {:answer/id #uuid "de01fdae-30a5-586f-af19-2e23b6aa2c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186353495}] :answer-field/correct {:answer/id #uuid "de01fdae-30a5-586f-af19-2e23b6aa2c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186353495} :answer-field/id #uuid "17f73283-19af-5ff4-92be-7a3948c24901" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353855}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "014601a5-7d03-5a59-9fc6-b409b517a1e1" :question/math-academy-id "q-85726" :question/problem "Using the trapezoidal rule with the partition\n\n$$\n[-3,3]=[-3,-2]\\cup [-2,0]\\cup [0,3],\n$$\n\napproximate the area under the curve of the continuous function $y=f(x)$ whose data is given in the table below.\n\n| $x$ | $-3$ | $-2$ | $0$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $6$ | $4$ | $3$ | $1$ |" :question/worked-solution "Let's plot what this function might look like, using the values given in the table.\n\n![](images/3a/3a9a6a7a340299c0b1f3fa349ad705c34079b74b0d3d1d1c3205d12ed9ef485d.png)\n\nWe've drawn some trapezoids to help calculate our trapezoidal rule sum. By calculating the area of each trapezoid, we obtain the following approximation for our area $A:$\n\n$$\nA≈\\overbrace{[\\,\\frac{\\overbrace{f(-3)+f(-2)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{1}}_{\\text{height}}\\,]}^{1\\text{st trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(-2)+f(0)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{2}}_{\\text{height}}\\,]}^{2\\text{nd trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(0)+f(3)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{3}}_{\\text{height}}\\,]}^{3\\text{rd trapezoid}}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{6+4}{2}\\cdot (-2-(-3))+\\frac{4+3}{2}\\cdot (0-(-2))+\\frac{3+1}{2}\\cdot (3-0) \\\\  & =5\\cdot 1+\\frac{7}{2}\\cdot 2+2\\cdot 3 \\\\  & =5+7+6 \\\\  & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354438 :knowledge-point/_questions [{:db/id #edb/ref 17592186133800 :knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34c4d3c3-0803-5e7d-9345-96fb67a5c902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186352058} {:answer/id #uuid "80911abe-21e9-5140-8653-0d040661f186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186352689} {:answer/id #uuid "bbef92f5-bc23-5fdc-a91b-960a4232941f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186353164} {:answer/id #uuid "e1942471-0602-51ba-8547-44bd01d58aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186353523} {:answer/id #uuid "ec065dfd-7d91-51b7-91a4-a6cd26c12915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186353623}] :answer-field/correct {:answer/id #uuid "e1942471-0602-51ba-8547-44bd01d58aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186353523} :answer-field/id #uuid "a8d7592d-5151-5ba8-a5b7-bd3172011f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354110}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5a3f449-8731-5956-af27-4aa8fe25fa80" :question/math-academy-id "q-85892" :question/problem "Given that the columns of $A$ are linearly independent, find the least-squares solution of $Ax=b$, where \n\n$\\,$ $A=\\begin{bmatrix}1 & 0 \\\\ -1 & 1 \\\\ 2 & -1\\end{bmatrix}\\,$ and $\\,b=\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overbrace{\\begin{bmatrix}1 & 0 \\\\ -1 & 1 \\\\ 2 & -1\\end{bmatrix}}^{A}\\overbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}}^{x} & =\\overbrace{\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}}^{b}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 1 \\\\ 2 & -1\\end{bmatrix})}^{-1}\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix} \\\\  & ={\\begin{bmatrix}6 & -3 \\\\ -3 & 2\\end{bmatrix}}^{-1}\\begin{bmatrix}6 \\\\ -3\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & 3 \\\\ 3 & 6\\end{bmatrix}\\begin{bmatrix}6 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354439 :knowledge-point/_questions [{:db/id #edb/ref 17592186133800 :knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f733f4-12f3-5c07-8f4b-304b44459b9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 1 \\\\ \\frac{3}{2}\\end{bmatrix}" :db/id #edb/ref 17592186352230} {:answer/id #uuid "8e2c331c-8cc2-5e5e-b4b6-de1a54f34fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186352806} {:answer/id #uuid "c7ad2f12-4695-596d-8cec-b7f38fb28a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ \\frac{3}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186353297} {:answer/id #uuid "d2a56cfe-ee7f-5cca-9b65-eb74bde205f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ \\frac{3}{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186353390} {:answer/id #uuid "e9c8975d-a61b-537d-897c-5fdec1b16da4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} \\\\ 3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186353601}] :answer-field/correct {:answer/id #uuid "d2a56cfe-ee7f-5cca-9b65-eb74bde205f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ \\frac{3}{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186353390} :answer-field/id #uuid "cda82a11-1d36-50fa-8ecc-f1dd1a7dc6ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354171}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48fc2839-660f-57b5-b91c-b2fcd5bae103" :question/math-academy-id "q-85899" :question/problem "Given that the columns of $A$ are linearly independent, find the least-squares solution of $Ax=b$, where \n\n$\\,$ $A=\\begin{bmatrix}2 & 0 & 4 \\\\ 2 & -4 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 4 & -2\\end{bmatrix}\\,$ and $\\,b=\\begin{bmatrix}12 \\\\ 0 \\\\ 0 \\\\ 12\\end{bmatrix}.$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overbrace{\\begin{bmatrix}2 & 0 & 4 \\\\ 2 & -4 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 4 & -2\\end{bmatrix}}^{A}\\overbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}}^{x} & =\\overbrace{\\begin{bmatrix}12 \\\\ 0 \\\\ 0 \\\\ 12\\end{bmatrix}}^{b}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}2 & 2 & 2 & 2 \\\\ 0 & -4 & 0 & 4 \\\\ 4 & -2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}2 & 0 & 4 \\\\ 2 & -4 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 4 & -2\\end{bmatrix})}^{-1}\\begin{bmatrix}2 & 2 & 2 & 2 \\\\ 0 & -4 & 0 & 4 \\\\ 4 & -2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}12 \\\\ 0 \\\\ 0 \\\\ 12\\end{bmatrix} \\\\  & ={\\begin{bmatrix}16 & 0 & 0 \\\\ 0 & 32 & 0 \\\\ 0 & 0 & 24\\end{bmatrix}}^{-1}\\begin{bmatrix}48 \\\\ 48 \\\\ 24\\end{bmatrix} \\\\  & =\\frac{1}{96}\\begin{bmatrix}6 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}48 \\\\ 48 \\\\ 24\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ \\frac{3}{2} \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354440 :knowledge-point/_questions [{:db/id #edb/ref 17592186133848 :knowledge-point/id #uuid "5924037a-ddc3-5f50-b4b0-1bd813cef255" :knowledge-point/title "Finding the Distance Between a Vector to a Subspace of Solutions of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15daec31-7862-5263-80db-2090dc8fbbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186351758} {:answer/id #uuid "40225e20-962a-5ae3-8315-535b48344c65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186352161} {:answer/id #uuid "46ff8bf7-6336-5516-8b73-cfe228faf760" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186352223} {:answer/id #uuid "c842ab27-883d-524b-b73e-ecdeb8f933ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186353309} {:answer/id #uuid "e98a1f81-e483-53e1-8bae-170bf4fa1ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186353600}] :answer-field/correct {:answer/id #uuid "c842ab27-883d-524b-b73e-ecdeb8f933ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186353309} :answer-field/id #uuid "478d5745-16e4-5393-ada0-6f0f2aa4b32a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353942}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8fe94dab-ed8a-5caf-8874-c5b5c72bebb6" :question/math-academy-id "q-85909" :question/problem "Consider the system $Ax=b$, where the matrix $A$ and the vector $b$ are given below. Given that the columns of $A$ are linearly independent, find the minimum value of $‖Ax-b‖.$\n\n$$\nA=\\begin{bmatrix}-1 & -2 \\\\ 0 & 1 \\\\ -1 & 0 \\\\ -1 & -1\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 3\\end{bmatrix}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overbrace{\\begin{bmatrix}-1 & -2 \\\\ 0 & 1 \\\\ -1 & 0 \\\\ -1 & -1\\end{bmatrix}}^{A}\\overbrace{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}}^{x} & =\\overbrace{\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 3\\end{bmatrix}}^{b} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\hat{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\hat{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\hat{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={(\\begin{bmatrix}-1 & 0 & -1 & -1 \\\\ -2 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}-1 & -2 \\\\ 0 & 1 \\\\ -1 & 0 \\\\ -1 & -1\\end{bmatrix})}^{-1}\\begin{bmatrix}-1 & 0 & -1 & -1 \\\\ -2 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & ={\\begin{bmatrix}3 & 3 \\\\ 3 & 6\\end{bmatrix}}^{-1}\\begin{bmatrix}-6 \\\\ -6\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}-6 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe minimum value of $‖Ax-b‖$ is attained when $x=\\hat{x},$ which is the least-squares solution of the system $Ax=b.$ In this case, $A\\hat{x}$ represents the orthogonal projection of $b$ onto the column space of $A,$ and $‖A\\hat{x}-b‖$ is the distance between the vector $b$ and the column space. Therefore,\n\n$$\n\\begin{aligned}A\\hat{x}-b & =\\begin{bmatrix}-1 & -2 \\\\ 0 & 1 \\\\ -1 & 0 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n‖A\\hat{x}-b‖=\\sqrt{{0}^{2}+(-1)^{2}+{1}^{2}+(-1)^{2}}=\\sqrt{3}.\n$$"}] [{:db/id #edb/ref 17592186354455 :knowledge-point/_questions [{:db/id #edb/ref 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "518a1e9d-4fc4-54c2-88f9-b4bece17e9a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186352301} {:answer/id #uuid "6fb1865f-2880-5084-a8c5-8740d51e1638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186352549} {:answer/id #uuid "86b563d9-c591-5329-8785-c1a4b5184185" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186352743} {:answer/id #uuid "cffd7977-8275-5edc-b765-fdc3aaa55f58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186353366} {:answer/id #uuid "f979b1f2-b550-5ba4-9afa-1d30662d03af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186353746}] :answer-field/correct {:answer/id #uuid "f979b1f2-b550-5ba4-9afa-1d30662d03af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186353746} :answer-field/id #uuid "92fe539f-0edb-5b5c-8b90-21ac128322d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354076}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eafbc70a-7fe6-568d-a054-e25ba5f557b5" :question/math-academy-id "q-86167" :question/problem "![](images/ba/bac953cd2389ef36b415dcdce87730f244958ef0fe2f67911878c5cb3bfcafc6.png)\n\nThe graph of $y=f(x),$ shown above, consists of two line segments. Find the value of ${\\int }_{-4}^{6}f(x)\\,\\text{d}x.$" :question/worked-solution "We divide the interval of integration into $3$ regions: the line segment for $x\\in [-4,0],$ the line segment for $x\\in (0,4],$ and the line segment for $x\\in [4,6].$ Therefore, we can write the required integral as follows:\n\n$$\n{\\int }_{-4}^{6}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-4}^{0}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{0}^{4}f(x)\\,\\text{d}x}_{{A}_{2}}+\\underbrace{{\\int }_{4}^{6}f(x)\\,\\text{d}x}_{-{A}_{3}}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-4,0].$ The corresponding region is a trapezoid, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(a+b)h \\\\  & =\\frac{1}{2}(1+3)(4) \\\\  & =8.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in (0,4].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in [4,6].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 1 \\\\  & =1.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{4}^{6}f(x)\\,\\text{d}x=-{A}_{3}=-1.\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-4}^{6}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2}-{A}_{3} \\\\  & =8+4-1 \\\\  & =11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354456 :knowledge-point/_questions [{:db/id #edb/ref 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc0a57f-68f8-5052-acd6-9fe8f1132818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186351677} {:answer/id #uuid "4193aeeb-8b5a-55ca-9758-44520f74d67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186352172} {:answer/id #uuid "943cdf43-5e78-575c-a6d6-6d9075798804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186352851} {:answer/id #uuid "af9b379e-acc2-5073-afed-61fd29ad6b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186353063} {:answer/id #uuid "b4645403-897e-5ff6-9e8e-c816d30d009c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186353110}] :answer-field/correct {:answer/id #uuid "af9b379e-acc2-5073-afed-61fd29ad6b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186353063} :answer-field/id #uuid "fb4bfbbe-d621-5831-bcf0-492fb3da13f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354254}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d1e9774-81f1-5594-9769-363e35f6c2db" :question/math-academy-id "q-86168" :question/problem "![](images/e9/e9e1ba80436256409381b9d1c1762696156abe1cbfb516f03cfb4837ae2330b2.png)\n\nThe graph of $y=f(x),$ shown above, consists of two line segments. Find the value of ${\\int }_{-2}^{4}f(x)\\,\\text{d}x.$" :question/worked-solution "The graph consists of two parts: the line segment for $x\\in [-2,0)$ and the line segment for $x\\in (0,4].$ Therefore, we can write the required integral as follows:\n\n$$\n{\\int }_{-2}^{4}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-2}^{0}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{0}^{4}f(x)\\,\\text{d}x}_{{A}_{2}}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,0).$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 4 \\\\  & =4.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in (0,4].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{4}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =4+4 \\\\  & =8.\\end{aligned}\n$$"}]}
