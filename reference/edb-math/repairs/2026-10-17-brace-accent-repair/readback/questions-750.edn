:answer-field/id #uuid "fa3b09fe-6ba9-5625-9ccb-be0c318bab25" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e845f2cc-dfb4-5e80-9c1e-ef0b2c43bf19" :question/math-academy-id "q-216029" :question/problem "Let $n\\in Z.$ Consider the following statement:\n\n$\\,$ If $\\frac{n}{2}\\in Z,$ then $______.$\n\nWhich of the following could be placed into the blank space above to create a statement whose proof is trivial?\n- **I.** $n$ is even\n- **II.** $1-{n}^{2}<2$\n- **III.** $1<n<2$\n\nSelect all that apply." :question/worked-solution "We say that an implication has a *trivial proof* if the consequent is always true:\n\n$$\nP\\,⇒\\overbrace{Q}^{\\text{Always true}}\n$$\n\nIt does not matter whether the antecedent is true or false.\n\nWith that in mind, let's examine our consequents in turn.\n\n- Predicate I, defined for $n\\in Z,$ is *not* always true. $\\,\\times $\n\n- Predicate II, defined for $n\\in Z,$ is always true. $\\,✓$\n\n- Predicate III, defined for $n\\in Z,$ is always false. $\\,\\times $\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186384698 :knowledge-point/_questions [{:db/id #edb/ref 17592186157232 :knowledge-point/id #uuid "fb4d348b-1703-51a1-be05-2e66295cacaa" :knowledge-point/title "Completing Trivial Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fb3905-55df-5307-b742-1b5ee71becee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471323} {:answer/id #uuid "687a1f83-58ae-59c6-980d-748e61017f57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471324}] :answer-field/correct {:answer/id #uuid "687a1f83-58ae-59c6-980d-748e61017f57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471324} :answer-field/id #uuid "e83dfcb0-1487-55a7-8777-e4c33fed1869" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472167} {:answer-field/choices [{:answer/id #uuid "94dcd398-9bb3-5c23-96f9-4f66db4bc936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471325} {:answer/id #uuid "1f3f307c-9cc7-5489-9c08-b3829f93e87c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471326}] :answer-field/correct {:answer/id #uuid "94dcd398-9bb3-5c23-96f9-4f66db4bc936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471325} :answer-field/id #uuid "e360c1f4-9aa4-5f8d-995e-c5dae8c3dccf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472168} {:answer-field/choices [{:answer/id #uuid "7a60a4bc-ff1b-5642-b8ce-d94e871ade4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471327} {:answer/id #uuid "91c7bc32-ec83-550e-b184-be712e2fd199" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471328}] :answer-field/correct {:answer/id #uuid "7a60a4bc-ff1b-5642-b8ce-d94e871ade4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471327} :answer-field/id #uuid "07987a83-6f45-5147-a121-27bc2d71e9c2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472169}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7628b9b-2926-5b1b-a6ec-eba49d9a9a32" :question/math-academy-id "q-216030" :question/problem "Let $x\\in Q.$ Consider the following statement:\n\n$\\,$ If ${x}^{-1}<1,$ then $______.$\n\nWhich of the following could be placed into the blank space above to create a statement whose proof is trivial?\n- **I.** $1-|x|\\in Q$\n- **II.** ${2}^{-1}<0$\n- **III.** $x>1$\n\nSelect all that apply." :question/worked-solution "We say that an implication has a *trivial proof* if the consequent is always true:\n\n$$\nP\\,⇒\\overbrace{Q}^{\\text{Always true}}\n$$\n\nIt does not matter whether the antecedent is true or false.\n\nWith that in mind, let's examine our consequents in turn.\n\n- Predicate I, defined for $x\\in Q,$ is always true. $\\,✓$\n\n- Statement II is always false. $\\,\\times $\n\n- Predicate III, defined for $x\\in Q,$ is *not* always true. $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186384705 :knowledge-point/_questions [{:db/id #edb/ref 17592186157233 :knowledge-point/id #uuid "45f828cb-c8b1-5da4-9711-15ace712dffa" :knowledge-point/title "Completing Vacuous Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a0c713-82a0-5e54-9195-49999007aaeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471329} {:answer/id #uuid "3bae32ae-2fcf-5066-b6d8-5261a2ca782c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471330}] :answer-field/correct {:answer/id #uuid "34a0c713-82a0-5e54-9195-49999007aaeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471329} :answer-field/id #uuid "717c53c5-7f91-58f1-9901-986694b231d1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/i