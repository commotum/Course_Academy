∧" :db/id #edb/ref 17592186495870} {:answer/id #uuid "d8c8cf17-f57a-5da7-bb5f-19cdf520914f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186495988}] :answer-field/correct {:answer/id #uuid "22666030-8f00-5aee-9b8d-82246f1b7de9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186495584} :answer-field/id #uuid "c8ae1b07-0aba-5c33-b3be-6170360b0fa8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186496177}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86cefea1-4583-5e59-84d3-54626f201af0" :question/math-academy-id "q-177355" :question/problem "$2+3$ equals $5$ **or** $\\pi $ is rational.\n\nConsider the compound statement above and the following notations:\n\n- $A:2+3\\text{ equals }5$\n\n- $B:\\pi \\text{ is rational}$\n\nExpressed in symbolic form, our statement can be written as\n{{field-1}}{{field-2}}{{field-3}}." :question/worked-solution "The word \"or\" is represented by the symbol \"$∨$\".\n\nSo, the sentence reads\n\n$$\n\\underbrace{2+3\\text{ equals }5}_{A}\\,\\underbrace{\\text{or}}_{∨}\\,\\underbrace{\\pi \\text{ is rational}}_{B},\n$$\n\nthat is, $A∨B.$"}] [{:db/id #edb/ref 17592186496303 :knowledge-point/_questions [{:db/id #edb/ref 17592186054644 :knowledge-point/id #uuid "2c15e521-f848-5d9c-ba06-00550277b8cb" :knowledge-point/title "Finding Truth Values of Complex Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12345e4a-d887-537f-b77e-dad11466435e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186495551} {:answer/id #uuid "4a2de7e6-e549-5c70-96e5-8a3192abc611" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/r