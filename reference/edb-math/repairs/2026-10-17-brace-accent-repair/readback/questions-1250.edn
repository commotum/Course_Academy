ed}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}^{\\beta } & =\\overbrace{[\\begin{aligned}-7 \\\\ -4 \\\\ 2 \\\\ 5 \\\\ 10\\end{aligned}]}^{y},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."}] [{:db/id #edb/ref 17592186552410 :knowledge-point/_questions [{:db/id #edb/ref 17592186133808 :knowledge-point/id #uuid "75e33c97-0499-5829-9886-be30b00989ae" :knowledge-point/title "Identifying Elements of a Multiple Linear Regression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171d39d2-f9c0-5f9d-9940-4380ac18309c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 30 & 2 \\\\ 1 & 2 & 25 & 6 \\\\ 1 & 3 & 20 & 12 \\\\ 1 & 4 & 15 & 20 \\\\ 1 & 5 & 12 & 30\\end{aligned}]" :db/id #edb/ref 17592186551715} {:answer/id #uuid "26be7c23-e5d2-5edf-9cc2-3fa6547cc11d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 30 \\\\ 1 & 2 & 15 \\\\ 1 & 3 & 20 \\\\ 1 & 4 & 15 \\\\ 1 & 5 & 12\\end{aligned}]" :db/id #edb/ref 17592186551752} {:answer/id #uuid "522010ad-aac1-5f6c-867a-baa584b9158b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-10 & 30 \\\\ -6 & 15 \\\\ 0 & 20 \\\\ 4 & 15 \\\\ 10 & 12\\end{aligned}]" :db/id #edb/ref 17592186551857} {:answer/id #uuid "563f8c1a-f589-5801-b789-fe57fe020422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 6 \\\\ 12 \\\\ 20 \\\\ 30\\end{aligned}]" :db/id #edb/ref 17592186551871} {:answer/id #uuid "dc9f9f60-d416-5d1b-9056-fcaf606e3ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-10 \\\\ -6 \\\\ 0 \\\\ 4 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186552183}] :answer-field/correct {:answer/id #uuid "dc9f9f60-d416-5d1b-9056-fcaf606e3ae4" :ans