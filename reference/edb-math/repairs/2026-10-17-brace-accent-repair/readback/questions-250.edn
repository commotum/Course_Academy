#{[{:db/id #edb/ref 17592186180086 :knowledge-point/_questions [{:db/id #edb/ref 17592186179773 :knowledge-point/id #uuid "1577f765-f98c-5020-8e45-8da2c5f092e6" :knowledge-point/title "Determining the Area Scale Factor of an Affine Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fb882db-732a-5483-ac99-b04e8df958eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186278730} {:answer/id #uuid "28977fa2-da01-505c-8f16-93bbe5d18d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186278953} {:answer/id #uuid "69f0468f-7044-547a-8fc3-bca92e912400" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279549} {:answer/id #uuid "a93ec374-5b3c-53d9-bf26-af26e0e1bc0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186280093} {:answer/id #uuid "c32d4cdb-a75a-5454-ac5d-3eba7d0a00f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186280305}] :answer-field/correct {:answer/id #uuid "c32d4cdb-a75a-5454-ac5d-3eba7d0a00f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186280305} :answer-field/id #uuid "598f153e-1b92-57a2-a76c-7a9ae5ff1816" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23554130-d2fa-542b-a17b-f4f9de21608d" :question/math-academy-id "q-162141" :question/problem "Consider the affine transformation $T,$ defined as\n\n$$\nx=v-u,\\,y=u+v-1.\n$$\n\nWhat is the area scale factor of the transformation?" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v-u \\\\ u+v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-u+v \\\\ u+v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}-1 & 1 \\\\ 1 & 1\\end{vmatrix}=1\\cdot (-1)-1\\cdot 1=-2.\n$$\n\nSo, the area scale factor of the transformation is\n\n$$\n|det(A)|=|-2|=2.\n$$"}] [{:db/id #edb/ref 17592186188216 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188281 :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"}] :question/id #uuid "91885df0-9f1d-5c18-acf1-70259cf7f4d9" :question/math-academy-id "e-9987" :question/problem "Find $\\text{nullity}(\\mathbf{T})$ given that $\\mathbf{T}:\\mathbb{R}^3\\to\\mathbb{R}^3$ and $\\textrm{Im}(\\mathbf{T})=\\{ [ x, y, z ]^T \\, : \\, x=y=z\\}.$" :question/worked-solution "Any vector from $\\textrm{Im}(\\mathbf{T})$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ x \\\\ x\\end{bmatrix}=x\\underbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{\\mathbf{v}_1\\}.$ Therefore, $\\textrm{rank}(\\mathbf{T})=1.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188547 :knowledge-point/_questions [{:db/id #edb/ref 17592186188295 :knowledge-point/id #uuid "70824c34-6527-5fe5-a86f-2ca683231f75" :knowledge-point/title "Determining Whether Two Continuous Random Variables are Independent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fe78ca8-334b-531b-a512-a341ac492a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186185563} {:answer/id #uuid "c4be7868-6891-5064-82ca-d0abcd776c47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186185564} {:answer/id #uuid "fcbd88c7-a64d-54bd-9593-2d1a47d427e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186185565} {:answer/id #uuid "2262bddb-2ca0-514c-9db6-75b84a2dfe4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186185566} {:answer/id #uuid "7afee5a8-f42b-5860-a3d2-673f5458e48c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186185567}] :answer-field/correct {:answer/id #uuid "c4be7868-6891-5064-82ca-d0abcd776c47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186185564} :answer-field/id #uuid "b9a62c9a-789e-53e7-a2b4-febcf8bd0baf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186185562}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e49ff8a6-6b90-594a-be32-eb49510ed619" :question/math-academy-id "q-136864" :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{2}({x}^{2}+{y}^{2}),\\, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{X}(x)=\\frac{3}{2}{x}^{2}+\\frac{1}{2}$ for $x\\in [0,1]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}\\frac{3}{2}({x}^{2}+{y}^{2})\\,\\text{d}y \\\\  & =\\frac{3}{2}{[{x}^{2}y+\\frac{1}{3}{y}^{3}]}_{y=0}^{y=1} \\\\  & =\\frac{3}{2}{x}^{2}+\\frac{1}{2},\\end{aligned}\n$$\n\n \nwhere $x\\in [0,1].$\n\n- Statement II is false. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{0}^{1}\\frac{3}{2}({x}^{2}+{y}^{2})\\,\\text{d}x \\\\  & =\\frac{3}{2}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=1} \\\\  & =\\frac{3}{2}{y}^{2}+\\frac{1}{2},\\end{aligned}\n$$\n\n \nwhere $y\\in [0,1].$ So, when $x\\in [0,1]$ and $y\\in [0,1],$ we obtain that \n\n$$\n\\underbrace{\\frac{3}{2}({x}^{2}+{y}^{2})}_{f(x,y)}\\ne \\underbrace{(\\frac{3}{2}{x}^{2}+\\frac{1}{2})}_{{f}_{X}(x)}\\cdot \\underbrace{(\\frac{3}{2}{y}^{2}+\\frac{1}{2})}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is false. Since statement II is *not* true, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186188563 :knowledge-point/_questions [{:db/id #edb/ref 17592186188295 :knowledge-point/id #uuid "70824c34-6527-5fe5-a86f-2ca683231f75" :knowledge-point/title "Determining Whether Two Continuous Random Variables are Independent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95f313db-cd02-59f4-aa9c-cb2b1e94ddf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186185659} {:answer/id #uuid "993dafd1-cd1f-5129-b778-e3d2650159e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186185660} {:answer/id #uuid "fbed530d-6837-5d0b-b58e-2aa223dedb02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186185661} {:answer/id #uuid "3512c16c-3729-51fc-a4e5-efb4b1b9d5aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186185662} {:answer/id #uuid "6dc005ec-f9c6-5f8a-a03a-55519f377e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186185663}] :answer-field/correct {:answer/id #uuid "3512c16c-3729-51fc-a4e5-efb4b1b9d5aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186185662} :answer-field/id #uuid "665dc965-8c73-559b-83c8-3ab6995229d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186185658}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af8d6c3e-9622-5721-91e2-327a3d421c31" :question/math-academy-id "q-143384" :question/problem "The joint probability density function for the continuous random variables  $X$ and $Y$ is given by\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{3}x{y}^{3},\\, & 2\\le x\\le 4,\\,0\\le y\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. ${f}_{X}(x)=2x$ for $x\\in [2,4]$\n\nII. $f(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two continuous random variables $X$ and $Y$ with a joint probability density function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability density functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Computing the marginal density function for $X,$ we get\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{0}^{1}\\frac{2}{3}x{y}^{3}\\,\\text{d}y \\\\  & =\\frac{2}{3}x{[\\frac{{y}^{4}}{4}]}_{0}^{1} \\\\  & =\\frac{1}{6}x,\\end{aligned}\n$$\n\n \nwhere $x\\in [2,4].$\n\n- Statement II is true. Computing the marginal density function for $Y,$ we get\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{2}^{4}\\frac{2}{3}x{y}^{3}\\,\\text{d}x \\\\  & =\\frac{2}{3}{y}^{3}{[\\frac{{x}^{2}}{2}]}_{2}^{4} \\\\  & =\\frac{2}{3}{y}^{3}(8-2) \\\\  & =4{y}^{3},\\end{aligned}\n$$\n\n \nwhere $y\\in [0,1].$ So, when $x\\in [2,4]$ and $y\\in [0,1],$ we obtain that \n\n$$\n\\underbrace{\\frac{2}{3}x{y}^{3}}_{f(x,y)}=\\underbrace{(\\frac{1}{6}x)}_{{f}_{X}(x)}\\cdot \\underbrace{(4{y}^{3})}_{{f}_{Y}(y)}.\n$$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ are independent.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186188924 :knowledge-point/_questions [{:db/id #edb/ref 17592186188281 :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61e472bd-ec33-5a3e-8b54-62a2891a9c10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information." :db/id #edb/ref 17592186366147} {:answer/id #uuid "a5dc371b-1396-5e61-a5b7-e3d432e28bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366148} {:answer/id #uuid "eca1d3e3-4905-5d15-ac5c-4cc6e7addee7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366149} {:answer/id #uuid "dc4ff1b0-90ec-51f1-9adc-f5e7ecc391d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366150} {:answer/id #uuid "f218d39c-ce4c-5b79-8c33-1b7543b0b540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366151}] :answer-field/correct {:answer/id #uuid "dc4ff1b0-90ec-51f1-9adc-f5e7ecc391d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366150} :answer-field/id #uuid "319ca848-ea15-555c-8b75-4d09284cc695" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366146}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09a30319-539f-5865-a29f-fd523154b963" :question/math-academy-id "q-47468" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and \n\n$$\n\\text{Im}(T)=\\{[x,y,z]^{T}\\,:\\,-x+z=0\\}.\n$$" :question/worked-solution "Solving $-x+z=0$ for $z,$ we get $z=x.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ x\\end{bmatrix}=x\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{{v}_{1}}+y\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188925 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140e8026-dca4-518e-b2e3-6a5204699c9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448696} {:answer/id #uuid "91598bc4-014d-5d6b-96f5-a46fe7a19ef6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448697}] :answer-field/correct {:answer/id #uuid "91598bc4-014d-5d6b-96f5-a46fe7a19ef6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448697} :answer-field/id #uuid "b185c70a-936c-56ce-a09e-491c0f5906d5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449388} {:answer-field/choices [{:answer/id #uuid "5f7fce4d-3fa7-56db-8465-e02eebbb3df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448698} {:answer/id #uuid "973d8243-55d9-5ba6-9a8d-9dc8eca9d0e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448699}] :answer-field/correct {:answer/id #uuid "5f7fce4d-3fa7-56db-8465-e02eebbb3df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448698} :answer-field/id #uuid "6276cdd8-8c2d-5458-9242-9db53bf98878" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449389} {:answer-field/choices [{:answer/id #uuid "8433f050-2198-5d04-bcdc-9660fdcf23e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448700} {:answer/id #uuid "3c8ade48-b616-5c30-ace3-11755e23e2b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448701}] :answer-field/correct {:answer/id #uuid "8433f050-2198-5d04-bcdc-9660fdcf23e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448700} :answer-field/id #uuid "9bfb10db-820c-5886-b42e-f40a5038d34d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449390}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1b3a8f74-a4d2-5020-9ea6-4077acac1b2e" :question/math-academy-id "q-47524" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,3x+2y-z=0}$ then $\\text{nullity}(T)=1$\n- **II.** If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T}$ then $T$ is invertible\n- **III.** If ${v}_{1},$ ${v}_{2},$ and ${v}_{3}$ are the columns of $T$ and ${v}_{3}={v}_{1}+2{v}_{2}$, then $\\text{Ker}(T)={0}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Solving $3x+2y-z=0$ for $z,$ we get $z=3x+2y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ 3x+2y\\end{bmatrix}=x\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}}_{{v}_{1}}+y\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement II is false. If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T},$ then \n\n$$\nT{v}_{1}=T{v}_{2}\\,⟹\\,T({v}_{1}-{v}_{2})=0,\n$$\n\nwhere ${v}_{1}-{v}_{2}$ is a non-zero vector. This means that $\\text{Ker}(T)=\\text{Null}(T)\\ne {0}$ and, according to the invertible matrix theorem, $T$ can't be invertible.\n\n- Statement III is false. If the columns of $T$ are such that ${v}_{3}={v}_{1}+2{v}_{2},$ then the set of vectors ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly dependent and therefore $\\text{Im}(T)=\\text{Col}(T)\\ne {R}^{3}.$ Now, according to the matrix invertible theorem, we obtain that $\\text{Ker}(T)\\ne {0}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186188982 :knowledge-point/_questions [{:db/id #edb/ref 17592186188281 :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92c91297-c7c0-5bdc-b9d9-a9a52ae806c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186187969} {:answer/id #uuid "99b215f4-c062-59cc-b003-ea6ef57c1e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186187970} {:answer/id #uuid "b7165ef5-c1ee-52e1-97ed-92ea885bd55a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186187971} {:answer/id #uuid "0874d691-cb56-565c-9d14-cf75209b28ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186187972} {:answer/id #uuid "22fb8de2-7841-5738-b5c1-945f57d8818f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186187973}] :answer-field/correct {:answer/id #uuid "b7165ef5-c1ee-52e1-97ed-92ea885bd55a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186187971} :answer-field/id #uuid "f7e4fdbb-a7f0-534a-a976-d0c43448ef20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186187968}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f05e62e2-1597-5312-8f1a-20a85ca4f47f" :question/math-academy-id "q-84059" :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{4}\\to {R}^{4}$ and \n\n$$\n\\text{Ker}(T)=\\{[x,y,z,w]^{T}\\,:\\,x+y+z=0,\\,2x-y-w=0\\}.\n$$" :question/worked-solution "Solving $x+y+z=0$ for $z,$ we get $z=-x-y.$ Solving $2x-y-w=0$ for $w,$ we get $w=2x-y.$  Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ 2x-y \\\\ -x-y\\end{bmatrix}=x\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 2 \\\\ -1\\end{bmatrix}}_{{v}_{1}}+y\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{nullity}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =4-\\text{nullity}(T) \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192979 :knowledge-point/_questions [{:db/id #edb/ref 17592186192682 :knowledge-point/id #uuid "7813df9e-9641-58a3-8537-e672e5fd079c" :knowledge-point/title "Finding Confidence Intervals for Intercept Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b4ae633-d836-59a7-8030-002829769a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\pm 3.0" :db/id #edb/ref 17592186553976} {:answer/id #uuid "a18bd7cb-4599-5047-a357-7726837ec776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\pm 1.2" :db/id #edb/ref 17592186554226} {:answer/id #uuid "a9cd2e1a-8327-5ae8-8f04-0b0a204554bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\pm 2.8" :db/id #edb/ref 17592186554248} {:answer/id #uuid "ede2b151-7a0f-5a99-a1ae-0b5aa02441f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\pm 2.5" :db/id #edb/ref 17592186554389} {:answer/id #uuid "f48cd6d6-78c5-50fe-84ac-c81348f46ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\pm 1.2" :db/id #edb/ref 17592186554398}] :answer-field/correct {:answer/id #uuid "a9cd2e1a-8327-5ae8-8f04-0b0a204554bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\pm 2.8" :db/id #edb/ref 17592186554248} :answer-field/id #uuid "2f9df6ed-4f2d-5912-b30b-a8d79df169ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186189760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68d56eaf-9e11-54bc-9fcb-5131b64bc995" :question/math-academy-id "q-143256" :question/problem "Let $\\overset{^}{\\,y}={\\overset{^}{\\,\\beta }}_{0}+{\\overset{^}{\\,\\beta }}_{1}x=3.5+5x$ be the regression line fitted using a sample $({x}_{1},{y}_{1}),\\,…,\\,({x}_{20},{y}_{20})$ of $n=20$ paired observations. Assuming that all conditions for the simple regression model are satisfied, $\\overset{―}{x}=2,$ the mean square error of the model is $8,$ and ${S}_{xx}={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}=24,$ find a $95%$ confidence interval for the $y$-intercept of the regression line.\n\n*Hint: Use the fact that $P(T>2.101)=0.025,$ where $T$ has a student's $t$-distribution with $18$ degrees of freedom. Also, the standard error for ${\\overset{^}{\\,\\beta }}_{0}$ is given by \n\n$$\n\\text{SE}[{\\overset{^}{\\,\\beta }}_{0}\\,]=\\sqrt{\\text{MSE}\\cdot (\\frac{1}{n}+\\frac{{\\overset{―}{x}}^{2}}{{S}_{xx}})}\n$$\n\n*" :question/requires-calculator true :question/worked-solution "We use the following notations:\n\n- $y={\\beta }_{0}+{\\beta }_{1}x$ is the regression line that best fits the population, and\n\n- $\\overset{^}{\\,y}={\\overset{^}{\\,\\beta }}_{0}+{\\overset{^}{\\,\\beta }}_{1}x$ is the estimate of the \"true\" regression line given by the data in our sample.\n\nIn this case, we have that  \n\n$$\n\\overset{^}{\\,y}={\\overset{^}{\\,\\beta }}_{0}+{\\overset{^}{\\,\\beta }}_{1}x=3.5+5x.\n$$\n\nWe are told that all assumptions for a simple regression model are held. So, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the $y$-intercept ${\\beta }_{0}$ of our model can be written as\n\n$$\n\\underbrace{{\\overset{^}{\\,\\beta }}_{0}}_{\\,\\,\\text{point}\\,\\text{estimate}}\\,\\pm \\,\\overbrace{{t}_{n-2,\\alpha /2}\\cdot \\text{SE}[{\\overset{^}{\\,\\beta }}_{0}\\,]}^{\\text{margin of error}}.\n$$\n\nNote the following:\n\n- $\\,{\\overset{^}{\\,\\beta }}_{0}$ is our point estimate for the intercept, computed using the data points from our sample.\n\n- $P(T>{t}_{n-2,\\alpha /2})=\\frac{\\alpha }{2},$ where $T$ has a student's $t$-distribution with $n-2$ degrees of freedom.\n\n- $\\text{SE}[{\\overset{^}{\\,\\beta }}_{0}\\,]$ is the standard error of ${\\overset{^}{\\,\\beta }}_{0},$ given by\n\n$$\n\\text{SE}[{\\overset{^}{\\,\\beta }}_{0}\\,]=\\sqrt{\\text{MSE}\\cdot (\\frac{1}{n}+\\frac{{\\overset{―}{x}}^{2}}{{S}_{xx}})}\n$$\n\nwhere we have:\n\n- $\\text{MSE}$ is the mean squared error of the model:\n\n$$\n\\text{MSE}=\\frac{1}{n-2}{\\sum }_{i=1}^{n}({y}_{i}-{\\overset{^}{\\,y}}_{i})^{2}\n$$\n\nwhere ${\\overset{^}{\\,y}}_{i}$ is the estimate of ${y}_{i}$ given by our regression model.\n\n- ${S}_{xx}$ is the usual sum of squares formula:\n\n$$\n{S}_{xx}={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}\n$$\n\nTo construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate. From the regression equation $\\overset{^}{\\,y}=3.5+5x,$ our point estimate is\n\n$$\n{\\overset{^}{\\,\\beta }}_{0}=3.5.\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $95%$ confidence interval, we have \n\n$$\n\\alpha =1-0.95=0.05\\,⟹\\,\\frac{\\alpha }{2}=0.025.\n$$\n\nWe are given that $P(T>2.101)=0.025.$ As a result, \n\n$$\n{t}_{n-2,\\alpha /2}={t}_{18,0.025}=2.101.\n$$\n\nNow, we can compute the margin of error:\n\n$$\n{t}_{n-2,\\alpha /2}\\cdot \\text{SE}[{\\overset{^}{\\,\\beta }}_{0}\\,]=2.101\\cdot \\sqrt{8\\cdot (\\frac{1}{20}+\\frac{{2}^{2}}{24})}≈2.8\n$$\n\n- **Step 3.** Determine the limits of the confidence interval:\n\n$$\n{\\overset{^}{\\,\\beta }}_{0}\\,\\pm \\,{t}_{n-2,\\alpha /2}\\cdot \\text{SE}[{\\overset{^}{\\,\\beta }}_{0}\\,]=3.5\\pm 2.8\n$$"}] [{:db/id #edb/ref 17592186193027 :knowledge-point/_questions [{:db/id #edb/ref 17592186192702 :knowledge-point/id #uuid "a9946876-7435-589a-a18d-c89c3d790754" :knowledge-point/title "Determining Whether a Riemann Sum Gives an Overestimate or an Underestimate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87f7157d-9ee6-5b05-9ef8-654c1987e877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186190049} {:answer/id #uuid "b36c179e-6374-5bb0-8b12-b5bd9f9953b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186190050} {:answer/id #uuid "d278bfce-4eb5-553f-8225-33457823e6d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186190051} {:answer/id #uuid "1309590e-1bde-5aa8-8965-b5de6255f2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements must be true." :db/id #edb/ref 17592186190052} {:answer/id #uuid "7bfc40b4-1eb7-5831-886c-c91fce39b4d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186190053}] :answer-field/correct {:answer/id #uuid "7bfc40b4-1eb7-5831-886c-c91fce39b4d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186190053} :answer-field/id #uuid "277d264b-fac7-5d04-a619-a104e80d1d5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186190048}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fbf952c0-e985-5c40-a219-a70a8e942eb9" :question/math-academy-id "q-148766" :question/problem "Let $f(x)$ be positive and strictly increasing for $x\\in [1,4],$ and differentiable for $x\\in (1,4).$ Suppose we approximate the area under the curve $y=g(x)=x\\cdot f(x)$ over the interval $[1,4]$ using a left Riemann sum. Given that $g(x)>0,$ which of the following statements must be true?\n\nI. ${f}^{′}(x)>0$\n\nII. ${g}^{′}(x)>0$\n\nIII. The Riemann sum underestimates the true area." :question/worked-solution "We're given that $g(x)=x\\cdot f(x)>0.$ Now, recall the following:\n\n- If $g(x)$ is strictly increasing, the left Riemann sum gives an *underestimate* of the area under the curve $y=g(x).$\n\n- If $g(x)$ is strictly decreasing, the left Riemann sum gives an *overestimate* of the area under the curve $y=g(x).$\n\nLet's now consider each statement in turn:\n\n- Statement I is true. Since $f(x)$ is strictly increasing, we have ${f}^{′}(x)>0.$\n\n- Statement II is true. Differentiating $g(x)=x\\cdot f(x),$ we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =(x)^{′}\\cdot f(x)+x\\cdot {f}^{′}(x) \\\\  & =f(x)+x\\cdot {f}^{′}(x).\\end{aligned}\n$$\n\nNow, since $f(x)$ is positive and strictly increasing over the interval $(1,4),$ we have \n\n$$\nx>0,\\,f(x)>0,\\,{f}^{′}(x)>0.\n$$\n\nHence, we obtain\n\n$$\n{g}^{′}(x)=\\underbrace{f(x)}_{>0}+\\underbrace{x}_{>0}\\cdot \\underbrace{{f}^{′}(x)}_{>0}=\\underbrace{f(x)}_{>0}+\\underbrace{x\\cdot {f}^{′}(x)}_{>0}>0.\n$$\n\n- Statement III is true. Since ${g}^{′}(x)>0,$ the function $g(x)$ is strictly increasing. Therefore, the left Riemann sum gives an *underestimate* of the area under the curve $y=x\\cdot f(x).$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186198021 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198379 :knowledge-point/id #uuid "aaa6b152-86d3-5f96-8a94-57f86a17a84d" :knowledge-point/title "Evaluating Flux Over a Surface"}] :question/id #uuid "2a32501f-d0f2-5e59-b7cc-a6b459269f6a" :question/math-academy-id "e-12357" :question/problem "Calculate the flux of the vector field\n\n$$\n\\mathbf F(x, y, z) = \\left\\langle -y, \\: x, \\: z+2 \\right\\rangle,\n$$\n\nwhere the surface $S$ is defined by $z=x^2+y^2$ for $0 \\leq x \\leq 1$ and $0 \\leq y \\leq 1.$" :question/worked-solution "For a surface $S$ given by $z = g(x,y)$ for $(x,y) \\in D,$ the flux of a vector field $\\mathbf{F}(x,y,z) = \\left\\langle P,\\: Q,\\: R \\right\\rangle$ over $S$ is given by\n\n$$\n\\iint\\limits_S \\mathbf{F} \\cdot \\textrm{d}\\mathbf{S}\n=\n\\iint\\limits_D \\left( -P\\dfrac{\\partial g}{\\partial x} - Q\\dfrac{\\partial g}{\\partial y} + R \\right) \\textrm{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y){:}$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({x}^{2}+{y}^{2})=2y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $\\mathbf F(x,y,z){:}$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨-y,\\,x,\\,z+2⟩{|}_{z={x}^{2}+{y}^{2}} \\\\  & =⟨\\underbrace{-y}_{P},\\,\\underbrace{x}_{Q},\\,\\underbrace{{x}^{2}+{y}^{2}+2}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨-y,\\,x,\\,z+2⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(-y)\\cdot (2x)-(x)\\cdot (2y)+{x}^{2}+{y}^{2}+2)\\,\\text{d}A \\\\  & ={∬}_{D}(2xy-2xy+{x}^{2}+{y}^{2}+2)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}({x}^{2}+{y}^{2}+2)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[{x}^{2}y+\\frac{{y}^{3}}{3}+2y]}_{0}^{1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{2}+\\frac{1}{3}+2)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{2}+\\frac{7}{3})\\,\\text{d}x \\\\  & ={[\\frac{{x}^{3}}{3}+\\frac{7x}{3}]}_{0}^{1} \\\\  & =\\frac{1}{3}+\\frac{7}{3} \\\\  & =\\frac{8}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198076 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198434 :knowledge-point/id #uuid "e74c46c7-7f57-5adc-8acb-ea91958d8725" :knowledge-point/title "Finding a Quadratic Taylor Polynomial"}] :question/id #uuid "6c5e3d93-e244-52da-845b-365bb94bd19d" :question/math-academy-id "e-12562" :question/problem "Determine the quadratic Taylor polynomial for the function of two variables \n$f(x,y) = \\cos(x+y)$\nabout the point $(0,0).$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y) = (0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overbrace{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}^{\\text{Linear approximation}} \\\\  & \\,\\,+\\underbrace{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =-\\operatorname{sin}⁡(x+y), & \\,{f}_{y}(x,y) & =-\\operatorname{sin}⁡(x+y) \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =0\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =-\\operatorname{cos}⁡(x\\,+\\,y), & \\,{f}_{xx}(0,0) & =-1 \\\\ {f}_{xy}(x,y) & =-\\operatorname{cos}⁡(x\\,+\\,y), & \\,{f}_{xy}(0,0) & =-1 \\\\ {f}_{yy}(x,y) & =-\\operatorname{cos}⁡(x\\,+\\,y), & \\,{f}_{yy}(0,0) & =-1\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+0\\cdot x+0\\cdot y+\\frac{1}{2}((-1)\\cdot {x}^{2}+2(-1)\\cdot xy+(-1)\\cdot {y}^{2}) \\\\  & =1-\\frac{1}{2}{x}^{2}-xy-\\frac{1}{2}{y}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198201 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198328 :knowledge-point/id #uuid "731faeca-a780-5b30-8408-cb8a751dafda" :knowledge-point/title "Proving an Expression Is Odd"}] :question/id #uuid "2efc4d4c-a5fa-54dc-aac6-3ef3db165d3f" :question/math-academy-id "e-13315" :question/problem "Show that if $m\\in\\mathbb Z$ is odd and $n\\in\\mathbb Z$ is even, then $m - n$ is odd." :question/worked-solution "Recall the following:\n\n- If an integer $n$ is even, then there exists an integer $p$ such that $n=2p$.\n- If an integer $n$ is odd, then there exists an integer $q$ such that $n=2q+1$.\n\nIn this case, we need to show the following:\n\n$$\nm \\textrm{is odd and} n \\textrm{is even} \\Rightarrow m - n \\textrm{is odd}\n$$\n\nWe start by using the fact that $m$ is odd and $n$ is even.\n\n> Let $m$ and $n$ be integers, where $m$ is odd and $n$ is even. Then, $m=2a+1$ and $n=2b$ for some integers $a$ and $b$.\n\n**Watch Out**! We must use two *different* integers to represent the oddness of $m$ and the evenness of $n$. In this case, we use $a$ and $b$.\n\nThe idea is to substitute\n\n$$\nm=2a+1\n$$\n\nand $n=2b$ into our expression $m - n$ and show it is odd by writing it as a multiple of $2$, plus $1$.\n\n> Therefore, we obtain\n> $m - n|= (2a + 1) - (2b); = 2a + 1 - 2b; = (2a - 2b) + 1; = 2\\underbrace{(a - b)}_{c} + 1$.\n\nNow, if we define another integer $c=a - b$ (highlighted above), we have that\n\n$$\nm - n = 2c+1\n$$\n\nwhich shows that $m - n$ is indeed one more than a multiple of $2$.\n\n> Let $c=a - b$. Since $a$ and $b$ are integers, $c$ is an integer.\n> Therefore,\n> $m - n|= 2\\underbrace{(a - b)}_{c} + 1; = 2c + 1$\n> which is one more than a multiple of $2$.\n\nFinally, we write our conclusion:\n\n> Therefore, we conclude that $m - n$ is odd."}] [{:db/id #edb/ref 17592186198213 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198335 :knowledge-point/id #uuid "82254264-4e8f-5123-b89c-5ed3549889ec" :knowledge-point/title "Proving Parity Statements by Cases"}] :question/id #uuid "384b71db-aa13-58e7-9f51-cf5e5c78d9f7" :question/math-academy-id "e-13331" :question/problem "Let $m$ and $n$ be integers. Prove that $(m-1)n^2$ is odd only if $m$ is even and $n$ is odd." :question/worked-solution "Recall the following:\n\n- If an integer $n$ is even, then there exists an integer $p$ such that $n=2p$.\n- If an integer $n$ is odd, then there exists an integer $q$ such that $n=2q+1$.\n\nIn this case, we need to prove the following:\n\n$$\n(m-1)n^2 \\text{is odd} \\quad\\Rightarrow\\quad m \\text{is even and} n \\text{is odd}\n$$\n\nTo prove $P \\Rightarrow Q$, it suffices to prove the contrapositive\n\n$$\n\\neg Q \\Rightarrow \\neg P\n$$\n\n$$\n\\neg\\left(m \\textrm{is even and} n \\textrm{is odd} \\right) \\Rightarrow \\neg\\left((m-1)n^2\\textrm{is odd}\\right)\n$$\n\nNegating the right-hand-side of our implication is straightforward:\n\n$$\n\\neg\\left(m \\textrm{is even and} n \\textrm{is odd} \\right) \\Rightarrow (m-1)n^2 \\textrm{is even}\n$$\n\nTo negate the statement \"$m$ is even and $n$ is odd\", we use De Morgan's law for conjunctions:\n\n$$\n\\begin{aligned}\n¬(mis even andnis odd) &= ¬(mis even∧nis odd) \\\\\n&= ¬(mis even)∨¬(nis odd) \\\\\n&= mis odd∨nis even \\\\\n&= mis odd ornis even\n\\end{aligned}\n$$\n\nNow, let's write down the contrapositive of our statement.\n\n> The contrapositive form of the given statement is as follows:\n> $m \\text{is odd or} n \\text{is even} \\quad\\Rightarrow\\quad (m-1)n^2 \\text{is even}$\n> We'll prove this statement instead of the original one.\n\nNow, we have two cases: $m$ is odd, or $n$ is even.\n\n- First, we consider the case when $m$ is odd.\n\n> **Case 1**. If $m$ is odd, then $m=2a+1$ for some integer $a$.\n> As a result, we obtain\n> $(m - 1)n^{2}|= (2a + 1 - 1)n^{2}; = 2an^{2}; = 2\\underbrace{(an^{2})}_{b}$.\n> Let $b=an^2$. Since $a$ and $n$ are integers, we have that $b$ is an integer.\n> Therefore, we have\n> $(m - 1)n^{2}|= 2\\underbrace{(an^{2})}_{b}; = 2b$,\n> which is a multiple of $2$. Hence, $(m-1)n^2$ is even.\n\n- Now, we consider the case when $n$ is even.\n\n> **Case 2**. If $n$ is even, then $n=2a$ for some integer $a$.\n> As a result, we obtain\n> $(m - 1)n^{2}|= (m - 1)(2a)^{2}; = 4(m - 1)a^{2}; = 2\\underbrace{(2(m - 1)a^{2})}_{b}$.\n> Let $b = 2(m-1)a^2$. Since $a$ and $m$ are integers, we have that $b$ is an integer.\n> Therefore, we have\n> $(m - 1)n^{2}|= 2\\underbrace{(2(m - 1)a^{2})}_{b}; = 2b$,\n> which is a multiple of $2$. Hence, $(m-1)n^2$ is even.\n\nFinally, we write our conclusion.\n\n> Therefore, combining the cases above, we conclude that $(m-1)n^2$ is odd only if $m$ is even and $n$ is odd."}] [{:db/id #edb/ref 17592186198232 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198327 :knowledge-point/id #uuid "f25e4c3f-11ae-5a0f-997e-f0a175b903e5" :knowledge-point/title "Proving an Expression Is Even"}] :question/id #uuid "8b458572-b433-53b1-827b-8c0a2a4a2c5a" :question/math-academy-id "e-6878" :question/problem "Prove that if $m\\in\\mathbb Z$ is even and $n\\in\\mathbb Z$ is odd, then $mn$ is even." :question/worked-solution "Recall the following:\n\n- If an integer $n$ is even, then there exists an integer $p$ such that $n=2p$.\n- If an integer $n$ is odd, then there exists an integer $q$ such that $n=2q+1$.\n\nIn this case, we need to show the following:\n\n$$\nm \\text{is even and} n \\text{is odd} \\quad\\Rightarrow\\quad mn \\text{is even}\n$$\n\nWe start by using the fact that $m$ is even and $n$ is odd.\n\n> Let $m$ and $n$ be integers, where $m$ is even and $n$ is odd. Then, $m=2a$ and $n=2b+1$ for some integers $a$ and $b$.\n\n**Watch Out**! We must use two *different* integers to represent the evenness of $m$ and the oddness of $n$. In this case, we use $a$ and $b$.\n\nThe idea is to substitute $m=2a$ and\n\n$$\nn=2b+1\n$$\n\ninto our expression $mn$ and show it is even by writing it as a multiple of $2$.\n\n> Therefore, we have\n> $mn|= (2a) \\cdot (2b + 1); = 4ab + 2a; = 2\\underbrace{(2ab + a)}_{c}$.\n\nNow, if we define another integer\n\n$$\nc=2ab+a\n$$\n\n(highlighted above), we have that $mn = 2c$, which shows that $mn$ is indeed a multiple of $2$.\n\n> Let $c=2ab+a$. Since $a$ and $b$ are integers, $c$ is an integer.\n> Therefore,\n> $mn|= 2\\underbrace{(2ab + a)}_{c}; = 2c$\n> which is a multiple of $2$.\n\nFinally, we write our conclusion:\n\n> Therefore, we conclude that $mn$ is even."}] [{:db/id #edb/ref 17592186198233 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198333 :knowledge-point/id #uuid "8cbcaa81-c33e-5f52-921d-5dc9bfe15953" :knowledge-point/title "Proving Parity Statements"}] :question/id #uuid "60ec2cc1-7b2c-5fba-8c0c-54fdecf29080" :question/math-academy-id "e-6902" :question/problem "Let $m$ and $n$ be integers. Prove that if $mn$ is odd, then $m$ is odd or $n$ is odd." :question/worked-solution "Recall the following:\n\n- If an integer $n$ is even, then there exists an integer $p$ such that $n=2p$.\n- If an integer $n$ is odd, then there exists an integer $q$ such that $n=2q+1$.\n\nIn this case, we need to prove the following:\n\n$$\nmn \\text{is odd} \\quad\\Rightarrow\\quad m \\text{is odd or} n \\text{is odd}\n$$\n\nTo prove $P \\Rightarrow Q$, it suffices to prove the contrapositive\n\n$$\n\\neg Q \\Rightarrow \\neg P\n$$\n\n$$\n\\neg\\left(m \\text{is odd or} n \\text{is odd}\\right) \\quad\\Rightarrow\\quad \\neg\\left(mn \\text{is odd}\\right)\n$$\n\nNegating the right-hand-side of our implication is straightforward:\n\n$$\n\\neg\\left(m \\text{is odd or} n \\text{is odd}\\right) \\quad\\Rightarrow\\quad mn\\text{is even}\n$$\n\nTo negate the statement \"$m$ is odd or $n$ is odd\", we use De Morgan's law for disjunctions.\n\n$$\n¬(mis odd ornis odd) \\mid ⇔¬(mis odd∨nis odd); ⇔¬(mis odd)∧¬(nis odd); ⇔mis even∧nis even; ⇔mis even andnis even\n$$\n\nSo, let's write down the contrapositive of our original statement.\n\n> The contrapositive form of the given statement is as follows:\n> $m \\text{is even and} n \\text{is even} \\quad\\Rightarrow\\quad mn \\text{is even}$\n> We'll prove this statement instead of the original one.\n\nWe start by using the fact that $m$ and $n$ are even.\n\n> If $m$ and $n$ are even, then\n> $m = 2a \\quad\\text{and}\\quad n = 2b$,\n> where $a$ and $b$ are integers.\n\nWe substitute $m=2a$ and $n=2b$ into the expression $mn$ and show it is even by writing it as a multiple of $2$.\n\n> Therefore,\n> $mn|= (2a)(2b); = 4ab; = 2\\underbrace{(2ab)}_{c}$.\n\nNow, if we define another integer $c=2ab$ (highlighted above), we have that $mn= 2c$, which shows that $mn$ is indeed a multiple of $2$.\n\n> Let $c=2ab$. Since $a$ and $b$ are integers, we have that $c$ is an integer.\n> Therefore, we have\n> $mn|= 2\\underbrace{(2ab)}_{c}; = 2c$,\n> which is a multiple of $2$.\n\nFinally, we write our conclusion.\n\n> Therefore, $mn$ is even."}] [{:db/id #edb/ref 17592186198594 :knowledge-point/_questions [{:db/id #edb/ref 17592186198379 :knowledge-point/id #uuid "aaa6b152-86d3-5f96-8a94-57f86a17a84d" :knowledge-point/title "Evaluating Flux Over a Surface"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45e4ed7d-32e1-561d-a22f-6872ac0c11d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276093} {:answer/id #uuid "79d3f9e1-b09d-5da0-9956-625389bb5691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276584} {:answer/id #uuid "7fce5fdb-d2d4-56fd-b48c-ac35d9caf62f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186276636} {:answer/id #uuid "dba9155e-47c3-5323-95b0-44b98e26ea32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277400} {:answer/id #uuid "eed29fd5-8470-5433-bc50-626d03bc72f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186277575}] :answer-field/correct {:answer/id #uuid "45e4ed7d-32e1-561d-a22f-6872ac0c11d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276093} :answer-field/id #uuid "826fd7b3-ffdf-520e-95fa-e603158a44c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277954}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd29749c-bfb5-5726-8ec7-04f9f714fe37" :question/math-academy-id "q-160888" :question/problem "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨z+y,\\,2y+z,\\,xy⟩\\cdot \\text{d}S\n$$\n\nwhere the surface $S$ is defined by $z=x-y$ for $0\\le x\\le 1$ and $0\\le y\\le 2.$" :question/worked-solution "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x-y)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x-y)=-1\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨z+y,\\,2y+z,\\,xy⟩{|}_{z=x-y} \\\\  & =⟨(x-y)+y,\\,2y+(x-y),\\,xy⟩ \\\\  & =⟨\\underbrace{x}_{P},\\,\\underbrace{x+y}_{Q},\\,\\underbrace{xy}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨z+y,\\,2y+z,\\,xy⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(x)\\cdot 1-(x+y)\\cdot (-1)+xy)\\,\\text{d}A \\\\  & ={∬}_{D}(-x+x+y+xy)\\,\\text{d}A \\\\  & ={∬}_{D}(y+xy)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}(y+xy)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{2}{y}^{2}+\\frac{1}{2}x{y}^{2}]}_{y=0}^{y=2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(2+2x)\\,\\text{d}x \\\\  & =[2x+{x}^{2}]_{0}^{1} \\\\  & =(2(1)+{1}^{2})-0 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198615 :knowledge-point/_questions [{:db/id #edb/ref 17592186198379 :knowledge-point/id #uuid "aaa6b152-86d3-5f96-8a94-57f86a17a84d" :knowledge-point/title "Evaluating Flux Over a Surface"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06423401-c4cb-59a0-9bd6-7e1a82b5b0ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e-2" :db/id #edb/ref 17592186275534} {:answer/id #uuid "0ce5551e-7454-5d22-ae6a-ac13e583b0e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-3" :db/id #edb/ref 17592186275587} {:answer/id #uuid "1481a58c-6133-58f7-a21d-cabc8d7625ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-2" :db/id #edb/ref 17592186275668} {:answer/id #uuid "7671f819-6d07-506b-b49f-13d0ef633588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-3" :db/id #edb/ref 17592186276546} {:answer/id #uuid "8ab9fbd0-cdfd-51f8-ab82-86979d2a493d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-2" :db/id #edb/ref 17592186276735}] :answer-field/correct {:answer/id #uuid "1481a58c-6133-58f7-a21d-cabc8d7625ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-2" :db/id #edb/ref 17592186275668} :answer-field/id #uuid "ed331e7d-c8f9-522c-8244-24e655efebee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278141}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "56a2b4c8-31ce-51dd-93f5-6f1083f199f3" :question/math-academy-id "q-161553" :question/problem "Calculate the flux of the vector field\n\n$$\nF(x,y,z)=⟨{e}^{x},\\,{e}^{y},\\,z+1⟩,\n$$\n\nwhere the surface $S$ is defined by $z=-x-y$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$" :question/worked-solution "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(-x-y)=-1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(-x-y)=-1\\end{aligned}\n$$\n\nIn this case, the flux of $F$ through $S$ is given by \n\n$$\n{∬}_{S}⟨{e}^{x},\\,{e}^{y},\\,z+1⟩\\cdot \\text{d}S\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨{e}^{x},\\,{e}^{y},\\,z+1⟩{|}_{z=-x-y} \\\\  & =⟨\\underbrace{{e}^{x}}_{P},\\,\\underbrace{{e}^{y}}_{Q},\\,\\underbrace{1-x-y}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨{e}^{x},\\,{e}^{y},\\,z+1⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-({e}^{x})\\cdot (-1)-({e}^{y})\\cdot (-1)+1-x-y)\\,\\text{d}A \\\\  & ={∬}_{D}({e}^{x}+{e}^{y}+1-x-y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}({e}^{x}+{e}^{y}+1-x-y)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[{e}^{x}y+{e}^{y}+y-xy-\\frac{{y}^{2}}{2}]}_{0}^{1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({e}^{x}+e+1-x-\\frac{1}{2}-1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({e}^{x}-x-\\frac{1}{2}+e)\\,\\text{d}x \\\\  & ={[{e}^{x}-\\frac{{x}^{2}}{2}-\\frac{x}{2}+ex]}_{0}^{1} \\\\  & =e-\\frac{1}{2}-\\frac{1}{2}+e-1 \\\\  & =2e-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198645 :knowledge-point/_questions [{:db/id #edb/ref 17592186198434 :knowledge-point/id #uuid "e74c46c7-7f57-5adc-8acb-ea91958d8725" :knowledge-point/title "Finding a Quadratic Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e54e1c9-205f-5069-a26e-144f61699b11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186278873} {:answer/id #uuid "53a1bca1-f8d6-5bc4-914c-05bf62ee4e7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279353} {:answer/id #uuid "5ae60956-68d4-52a5-a560-be8be1ee1d39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186279431} {:answer/id #uuid "ea4c4625-0875-5288-88dc-8eec11112601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186280648} {:answer/id #uuid "fd2d11b4-8aaf-5097-aa76-39368cc3df6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280808}] :answer-field/correct {:answer/id #uuid "1e54e1c9-205f-5069-a26e-144f61699b11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186278873} :answer-field/id #uuid "b152db49-e069-50cf-bae6-a47ce8602ca1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281146}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a23d317-8ce9-5c6e-8d7d-b18f5386617b" :question/math-academy-id "q-162992" :question/problem "For the function of two variables \n$f(x,y)={e}^{x-2y},$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=1+x+a\\,y+\\frac{1}{2}{x}^{2}+bxy+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overbrace{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}^{\\text{Linear approximation}} \\\\  & \\,\\,+\\underbrace{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & ={e}^{x-2y}, & \\,{f}_{y}(x,y) & =-2{e}^{x-2y} \\\\ {f}_{x}(0,0) & =1, & \\,{f}_{y}(0,0) & =-2\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & ={e}^{x-2y}, & \\,{f}_{xx}(0,0) & =1 \\\\ {f}_{xy}(x,y) & =-2{e}^{x-2y}, & \\,{f}_{xy}(0,0) & =-2 \\\\ {f}_{yy}(x,y) & =4{e}^{x-2y}, & \\,{f}_{yy}(0,0) & =4\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+1\\cdot x+(-2)\\cdot y+\\frac{1}{2}(1\\cdot {x}^{2}+2(-2)\\cdot xy+4\\cdot {y}^{2}) \\\\  & =1+x+(-2)y+\\frac{1}{2}{x}^{2}+(-2)xy+2{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=(-2)+(-2)+2=-2.\n$$"}] [{:db/id #edb/ref 17592186198655 :knowledge-point/_questions [{:db/id #edb/ref 17592186198434 :knowledge-point/id #uuid "e74c46c7-7f57-5adc-8acb-ea91958d8725" :knowledge-point/title "Finding a Quadratic Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02574b50-c710-5a8f-8229-9eaa00044a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278603} {:answer/id #uuid "10420ffa-1165-5942-a0ff-b3580c576eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186278737} {:answer/id #uuid "3c91efce-0927-5416-b18a-4ba2ceaf7a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279126} {:answer/id #uuid "908df91a-4453-5800-be38-08e07668caab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186279879} {:answer/id #uuid "e37ae8eb-1e3b-558b-bcf1-ab48ef85e453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186280599}] :answer-field/correct {:answer/id #uuid "908df91a-4453-5800-be38-08e07668caab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186279879} :answer-field/id #uuid "71592c6a-fdb5-5942-ae34-39eaef90dabf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281033}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e6d1ba4-7501-5c84-a8cd-0bbe2d40c544" :question/math-academy-id "q-163113" :question/problem "For the function of two variables \n$f(x,y)=\\operatorname{cos}⁡(x-2y),$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=1+a{x}^{2}+bxy+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overbrace{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}^{\\text{Linear approximation}} \\\\  & \\,\\,+\\underbrace{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =-\\operatorname{sin}⁡(x-2y), & \\,{f}_{y}(x,y) & =2\\operatorname{sin}⁡(x-2y) \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =0\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =-\\operatorname{cos}⁡(x-2y), & \\,{f}_{xx}(0,0) & =-1 \\\\ {f}_{xy}(x,y) & =2\\operatorname{cos}⁡(x-2y), & \\,{f}_{xy}(0,0) & =2 \\\\ {f}_{yy}(x,y) & =-4\\operatorname{cos}⁡(x-2y), & \\,{f}_{yy}(0,0) & =-4\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+0\\cdot x+0\\cdot y+\\frac{1}{2}(-1\\cdot {x}^{2}+2(2)\\cdot xy+(-4)\\cdot {y}^{2}) \\\\  & =1+(-\\frac{1}{2}){x}^{2}+2xy+(-2){y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=(-\\frac{1}{2})+2+(-2)=-\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186198689 :knowledge-point/_questions [{:db/id #edb/ref 17592186198252 :knowledge-point/id #uuid "2993b4ab-e45b-579a-8a11-b5e9ee107d5b" :knowledge-point/title "Expressing a Compound Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41dde3e3-6092-50d7-a3e3-9b03129714b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧P" :db/id #edb/ref 17592186381363} {:answer/id #uuid "ab38e2e3-7aa0-5681-bd79-b716a1f5ebfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨(P∧Q)" :db/id #edb/ref 17592186381364} {:answer/id #uuid "765bffbf-d84a-5ff5-a5f8-870a92ad58fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧Q" :db/id #edb/ref 17592186381365} {:answer/id #uuid "63cf5e8f-593a-5960-b49a-27fd32e7eff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧(Q∨P)" :db/id #edb/ref 17592186381366} {:answer/id #uuid "1b83a791-8241-5cd5-855b-476449665c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186381367}] :answer-field/correct {:answer/id #uuid "1b83a791-8241-5cd5-855b-476449665c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186381367} :answer-field/id #uuid "b22e7a73-f4cf-5a91-83ba-e94d101da87b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381362}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ff7b2b7-dfb5-55b1-bfd4-172f42c8239c" :question/math-academy-id "q-170725" :question/problem "$x$ is even **or** odd.\n\nExpress the compound predicate above in symbolic form given the following notations:\n\n- $P(x):$ $x$ is even\n\n- $Q(x):$ $x$ is odd" :question/worked-solution "The word \"or\" is represented by the symbol \"$∨$\".\n\nSo, the sentence reads\n\n$$\n\\underbrace{x\\text{ is even}}_{P}\\,\\underbrace{\\text{or}}_{∨}\\,\\underbrace{x\\text{ is odd}}_{Q},\n$$\n\nthat is, $P∨Q.$"}] [{:db/id #edb/ref 17592186198690 :knowledge-point/_questions [{:db/id #edb/ref 17592186198252 :knowledge-point/id #uuid "2993b4ab-e45b-579a-8a11-b5e9ee107d5b" :knowledge-point/title "Expressing a Compound Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97cff51c-983b-575b-903d-5584a034d8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧(X∨Y)" :db/id #edb/ref 17592186194767} {:answer/id #uuid "a36f4955-9124-5d3e-951e-14bff55aa415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧Y" :db/id #edb/ref 17592186194768} {:answer/id #uuid "1dd56525-f827-53a8-80f9-7e651a4723aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧X" :db/id #edb/ref 17592186194769} {:answer/id #uuid "6f2cb83b-5882-5ba4-9ab3-c7280979e296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨(X∧Y)" :db/id #edb/ref 17592186194770} {:answer/id #uuid "6f7ea01c-40f7-5ccb-91dd-5e78b4d506fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨Y" :db/id #edb/ref 17592186194771}] :answer-field/id #uuid "566d0526-499b-5110-8861-4629d5abb30d" :answer-field/key "selection" :answe