ix}25 \\\\ 28\\end{bmatrix} \\\\  & =\\begin{bmatrix}6.25 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y=6.25+2x.$"}] [{:db/id #edb/ref 17592186271959 :knowledge-point/_questions [{:db/id #edb/ref 17592186133823 :knowledge-point/id #uuid "aa5bf185-de29-5185-ba57-c64250332dfa" :knowledge-point/title "Identifying the Elements of a Polynomial Regression Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20f29bc9-3fb9-5b1f-95f2-06e419d52b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -3 & (-3)^{2} \\\\ 1 & -1 & (-1)^{2} \\\\ 1 & 1 & {1}^{2} \\\\ 1 & 3 & {3}^{2} \\\\ 1 & 5 & {5}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186269548} {:answer/id #uuid "45bc85b9-1bbc-5455-b4ef-39d06e01f444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -5 & (-5)^{2} \\\\ -1 & -25 & (-25)^{2} \\\\ 1 & 5 & {5}^{2} \\\\ 3 & 20 & {20}^{2} \\\\ 5 & 35 & {35}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186269906} {:answer/id #uuid "62c0d48b-a22d-51c0-8b74-18a56d7642b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -5 & (-5)^{2} \\\\ 1 & -25 & (-25)^{2} \\\\ 1 & 5 & {5}^{2} \\\\ 1 & 20 & {20}^{2} \\\\ 1 & 35 & {35}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186270141} {:answer/id #uuid "67191128-f2a6-5531-a9fb-e2374ffabe5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & -3 & (-3)^{2} \\\\ -25 & -1 & (-1)^{2} \\\\ 5 & 1 & {1}^{2} \\\\ 20 & 3 & {3}^{2} \\\\ 35 & 5 & {5}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186270188} {:answer/id #uuid "6a601d96-342c-5bf8-a396-3eefe2c18dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 & {1}^{2} \\\\ -1 & 1 & {1}^{2} \\\\ 1 & 1 & {1}^{2} \\\\ 3 & 1 & {1}^{2} \\\\ 5 & 1 & {1}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186270213}] 