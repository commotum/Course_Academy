}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{L}\\underbrace{\\begin{bmatrix}3 & 2 & -1 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & -1\\end{bmatrix}}_{U}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243965 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f20815-d3c9-5266-a9ea-efd0b9f40481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186241507} {:answer/id #uuid "2a100052-8c46-523f-bb66-e7fb58725152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 9 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186241553} {:answer/id #uuid "87c84f1b-05b2-5fb4-86d5-ac25913dcef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186242370} {:answer/id #uuid "b8332ebc-6831-5216-9726-52979fa52de5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -9 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186242797} {:answer/id #uuid "fa11afd4-5218-5cf8-a73f-47d278eaf0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186243382}] :answer-field/correct {:answer/id #uuid "87c84f1b-05b2-5fb4-86d5-ac25913dcef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186242370} :answer-field/id #uuid "56764b89-1d6b-5b0e-a256-bd88b558bbc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243611}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bcf5266-c07e-506f-ad28-ce8fd193bd74" :question/math-academy-id "q-106843" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}+{R}_{1},\\,{R}_{3}:={R}_{3}+9{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+1\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+9\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix}}_{{E}_{2}}\\cdot \\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ C & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix})U \\\\ C & =\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243966 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3344b786-674b-5fd2-9d29-837e625aa501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186241632} {:answer/id #uuid "80dafbab-27c8-576b-b2ce-69b8b080bf51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -9 & 1 & 0 \\\\ 6 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186242309} {:answer/id #uuid "83bafad9-1114-5e06-bd66-d793c74a86bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -9 & 6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186242334} {:answer/id #uuid "9bd15dac-4809-5f03-aa6a-8f97384065ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ -6 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186242541} {:answer/id #uuid "e7d50e5f-77de-5893-ac67-36ccb6d71066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186243232}] :answer-field/correct {:answer/id #uuid "3344b786-674b-5fd2-9d29-837e625aa501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186241632} :answer-field/id #uuid "e1d9cab6-19c0-5041-aea3-43b5bddd5c25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cebd24b5-6f02-5782-b81d-34bb40c98fb3" :question/math-academy-id "q-106850" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-6{R}_{1},\\,{R}_{3}:={R}_{3}+9{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-6)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+9\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix}}_{{E}_{2}}\\cdot \\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ C & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix})U \\\\ C & =\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243967 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cb4e22-4527-5cdf-a246-1015081dac6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 175921