/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461604} :answer-field/id #uuid "dfa287d1-edf5-5f1b-a9c9-98b1433d7624" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462555}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6ee1784f-5074-5474-b955-50f16f51c21c" :question/math-academy-id "q-109626" :question/problem "$$\nA=\\begin{bmatrix}-2 & 0 & 0 \\\\ 1 & -5 & 1 \\\\ 4 & -9 & 1\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-2$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-2$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-2$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A+2I:$\n\n$$\nA+2I=\\begin{bmatrix}-2 & 0 & 0 \\\\ 1 & -5 & 1 \\\\ 4 & -9 & 1\\end{bmatrix}+2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & -3 & 1 \\\\ 4 & -9 & 3\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+2I:$\n\n$$\n(A+2I)v=\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & -3 & 1 \\\\ 4 & -9 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}=\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 4\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A+2I:$\n\n$$\n(A+2I)w=\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & -3 & 1 \\\\ 4 & -9 & 3\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 4\\end{bmatrix}=\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 3\\end{bmatrix}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A+2I:$\n\n$$\n(A+2I)x=\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & -3 & 1 \\\\ 4 & -9 & 3\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{v}\\overset{A+2I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 4\\end{bmatrix}}_{w}\\overset{A+2I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 3\\end{bmatrix}}_{x}\\overset{A+2I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A+2I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-2$ of $A.$*\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186247016 :knowledge-point/_questions [{:db/id #edb/ref 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1cd008-4fbf-50fc-9e43-bc6b7e21f011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461605} {:answer/id #uuid "1912e2b9-28ee-5c97-8288-1089044dd3d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461606}] :answer-field/correct {:answer/id #uuid "3e1cd008-4fbf-50fc-9e43-bc6b7e21f011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461605} :answer-field/id #uuid "4307f5cf-d0aa-5fb8-b7b7-d67a11c1f175" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462556} {:answer-field/choices [{:answer/id #uuid "39a5a3d4-6d1a-5629-b7b1-6f8ec7b3cad3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461607} {:answer/id #uuid "01e67c93-8273-5547-baa2-346b02e1be44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461608}] :answer-field/correct {:answer/id #uuid "39a5a3d4-6d1a-5629-b7b1-6f8ec7b3cad3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461607} :answer-field/id #uuid "9b78fde5-c14f-557d-8822-beab3bfcb7a5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462557} {:answer-field/choices [{:answer/id #uuid "e34478a7-ae4f-5812-b252-95716506507b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461609} {:answer/id #uuid "90ea6604-ce8c-5eff-9548-1b53c84aafc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461610}] :answer-field/correct {:answer/id #uuid "e34478a7-ae4f-5812-b252-95716506507b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461609} :answer-field/id #uuid "8d3b0db8-22db-57a0-a1c9-2f3066587f31" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462558}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "73154a72-4618-59f1-ab95-d4b82ca2da71" :question/math-academy-id "q-109632" :question/problem "$$\nA=\\begin{bmatrix}2 & 2 & 1 \\\\ 0 & 3 & 0 \\\\ -1 & 3 & 4\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-3I:$\n\n$$\nA-3I=\\begin{bmatrix}2 & 2 & 1 \\\\ 0 & 3 & 0 \\\\ -1 & 3 & 4\\end{bmatrix}-3\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 2 & 1 \\\\ 0 & 0 & 0 \\\\ -1 & 3 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-3I:$\n\n$$\n(A-3I)v=\\begin{bmatrix}-1 & 2 & 1 \\\\ 0 & 0 & 0 \\\\ -1 & 3 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A-3I:$\n\n$$\n(A-3I)w=\\begin{bmatrix}-1 & 2 & 1 \\\\ 0 & 0 & 0 \\\\ -1 & 3 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}=\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A-3I:$\n\n$$\n(A-3I)x=\\begin{bmatrix}-1 & 2 & 1 \\\\ 0 & 0 & 0 \\\\ -1 & 3 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}_{v}\\overset{A-3I\\,}{\\to }\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}}_{w}\\overset{A-3I\\,}{\\to }\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{x}\\overset{A-3I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A-3I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =3$ of $A.$*\n\nSo, the correct answer is \"None of the statements are true.\""}] [{:db/id #edb/ref 17592186247170 :knowledge-point/_questions [{:db/id #edb/ref 17592186119815 :knowledge-point/id #uuid "f892805c-2c2c-5105-91ba-353aefe7b7f2" :knowledge-point/title "Finding a Basis of the Space Spanned by a Set of Vectors Using Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3302cac0-c190-588a-bf1e-1dcf4b11b461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186429753} {:answer/id #uuid "36398b63-dad4-5688-8a66-fe0da922b660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-4 \\\\ -4\\end{bmatrix},\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186429754} {:answer/id #uuid "432a4bca-b02b-564d-8440-b892a8cece98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}0 \\\\ -4\\end{bmatrix}\\}" :db/id #edb/ref 17592186429755} {:answer/id #uuid "892d14b4-33ce-5d53-88a8-6c11d10a6e6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}0 \\\\ -4\\end{bmatrix},\\begin{bmatrix}4 \\\\ 4\\end{bmatrix},\\begin{bmatrix}-4 \\\\ -4\\end{bmatrix}\\}" :db/id #edb/ref 17592186429759} {:answer/id #uuid "c96b69bc-01bd-5856-808f-355764eb3024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}0 \\\\ -4\\end{bmatrix},\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186429766}] :answer-field/correct {:answer/id #uuid "c96b69bc-01bd-5856-808f-355764eb3024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}0 \\\\ -4\\end{bmatrix},\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186429766} :answer-field/id #uuid "aa023706-5551-57d6-a234-fed6508928d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a861accd-0de4-505d-8847-8b30f8b4e546" :question/math-academy-id "q-110850" :question/problem "Consider the vectors ${a}_{1}=\\begin{bmatrix}0 \\\\ -4\\end{bmatrix},{a}_{2}=\\begin{bmatrix}4 \\\\ 4\\end{bmatrix},$ and ${a}_{3}=\\begin{bmatrix}-4 \\\\ -4\\end{bmatrix}.$ Find a basis of $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$  by inspection." :question/worked-solution "Remember that a basis of $S$ is a set of linearly independent vectors that spans $S.$\n\nFrom the given vectors, we can see that ${a}_{3}$ is a linear combination of vectors ${a}_{1}$ and ${a}_{2}:$\n\n$$\n{a}_{3}=0\\cdot {a}_{1}+(-1)\\cdot {a}_{2}\n$$\n\nConsequently, the vector ${a}_{3}$ can be removed from $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ without changing the span. So $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is spanned by just $\\{{a}_{1},{a}_{2}\\}.$ \n\nLastly, note that ${a}_{1}$ and ${a}_{2}$ are linearly independent since they are not parallel. So the set $\\{{a}_{1},{a}_{2}\\}$ is a linearly independent set that spans $S.$\n\nTherefore, a basis of $S$ is $\\{{a}_{1},{a}_{2}\\},$ that is to say,\n\n$$\nB=\\{\\underbrace{\\begin{bmatrix}0 \\\\ -4\\end{bmatrix}}_{{a}_{1}},\\underbrace{\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}}_{{a}_{2}}\\}.\n$$"}] [{:db/id #edb/ref 17592186247183 :knowledge-point/_questions [{:db/id #edb/ref 17592186119810 :knowledge-point/id #uuid "5c8e217c-252d-529f-a810-84787e2ee886" :knowledge-point/title "Determining if a Vector is in the Column Space of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64681709-1170-5f03-bea9-39e2b3e08575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186245196} {:answer/id #uuid "a0926f48-6f17-50d3-9063-207c796ae337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186245743} {:answer/id #uuid "ce6ac71b-167b-59ce-a9a5-a3eba31e72bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186246158} {:answer/id #uuid "d22a5c7d-7f39-58dc-99f7-e2e02fb8f361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Col}(M)" :db/id #edb/ref 17592186246183} {:answer/id #uuid "e4fc31d7-a002-5bb5-984c-f7279ca052e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186246344}] :answer-field/correct {:answer/id #uuid "a0926f48-6f17-50d3-9063-207c796ae337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186245743} :answer-field/id #uuid "7ab43adf-8d8a-5661-838f-2a606959c5c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e29736ad-5a46-5b75-954a-5f47e0d7b1bc" :question/math-academy-id "q-110955" :question/problem "The matrix $M$ and the vector $b$ are given below. Determine if $b\\in \\text{Col}(M).$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2},$ where ${x}_{1}$ and ${x}_{2}$ are real numbers such that $b={x}_{1}{m}_{1}+{x}_{2}{m}_{2},$ and ${m}_{1},$  ${m}_{2}$ are the respective columns of $M.$ \n\n$$\nM=\\begin{bmatrix}1 & 3 \\\\ 1 & -1 \\\\ -1 & -1\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 8 \\\\ -4\\end{bmatrix}\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(M),$ we need to check if the equation $Mx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[M\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[M\\,|\\,b] & =\\begin{bmatrix}1 & 3 & 0 \\\\ 1 & -1 & 8 \\\\ -1 & -1 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & -4 & 8 \\\\ -1 & -1 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & -4 & 8 \\\\ 0 & 2 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & -4 & 8 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=0 \\\\ -4{x}_{2} &=8 \\\\ 0 &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation we get ${x}_{2}=-2.$ Substituting into the first equation gives  ${x}_{1}=6.$  \n\nSince we have a solution, the equation $Mx=b$ is consistent, which implies that $b\\in \\text{Col}(M).$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${m}_{1}$ and ${m}_{2}:$\n\n$$\n\\underbrace{\\begin{bmatrix}0 \\\\ 8 \\\\ -4\\end{bmatrix}}_{b}=6\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}}_{{m}_{1}}+(-2)\\cdot \\underbrace{\\begin{bmatrix}3 \\\\ -1 \\\\ -1\\end{bmatrix}}_{{m}_{2}}\n$$\n\n \n\nFinally, we get ${x}_{1}\\cdot {x}_{2}=6(-2)=-12.$"}] [{:db/id #edb/ref 17592186247186 :knowledge-point/_questions [{:db/id #edb/ref 17592186119858 :knowledge-point/id #uuid "b72ed196-a73b-59ab-a7c3-5173249cf7e5" :knowledge-point/title "Determining Whether a Given Set Is a Basis of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033e49db-c9d2-5b07-8897-0a4bd99e26ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186244337} {:answer/id #uuid "2d130ad5-782d-524d-b31f-3f3c552e7760" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${{a}_{1},{a}_{2},{a}_{3}}$ is not a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}$" :db/id #edb/ref 17592186244719} {:answer/id #uuid "5d6b5774-4554-5a55-95f0-290cd2754c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245140} {:answer/id #uuid "aafb0663-a194-5ece-b553-6d5258d4281c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245840} {:answer/id #uuid "fbc8a320-650d-598f-9177-752d0f8c20a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186246521}] :answer-field/correct {:answer/id #uuid "fbc8a320-650d-598f-9177-752d0f8c20a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186246521} :answer-field/id #uuid "581e042d-203f-58ac-b772-18f562dc056b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246703}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "596db895-6072-51ec-b248-ca9f56bec30c" :question/math-academy-id "q-110972" :question/problem "The vectors ${a}_{1},$ ${a}_{2},$ ${a}_{3},$ and ${a}_{4}$ are given below. Determine whether $B={{a}_{1},{a}_{2},{a}_{3}}$ is a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$ If that is the case, find ${x}_{1}+{x}_{2}+{x}_{3},$ where ${a}_{4}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 6 \\\\ -1\\end{bmatrix},\\,{a}_{4}=\\begin{bmatrix}-9 \\\\ -29 \\\\ 6\\end{bmatrix}\n$$" :question/worked-solution "We want to determine if $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$ So, we want to find ${x}_{1},{x}_{2},{x}_{3}\\in R$ such that \n\n$$\n{x}_{1}\\underbrace{\\begin{bmatrix}1 \\\\ 3 \\\\ -1\\end{bmatrix}}_{{a}_{1}}+{x}_{2}\\underbrace{\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}}_{{a}_{2}}+{x}_{3}\\underbrace{\\begin{bmatrix}2 \\\\ 6 \\\\ -1\\end{bmatrix}}_{{a}_{3}}=\\underbrace{\\begin{bmatrix}-9 \\\\ -29 \\\\ 6\\end{bmatrix}}_{{a}_{4}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+2{x}_{3} &=-9 \\\\ 3{x}_{1}+4{x}_{2}+6{x}_{3} &=-29 \\\\ -{x}_{1}-{x}_{2}-{x}_{3} &=6\\end{aligned}\\right.\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}1 & 1 & 2 & -9 \\\\ 3 & 4 & 6 & -29 \\\\ -1 & -1 & -1 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 & -9 \\\\ 0 & 1 & 0 & -2 \\\\ -1 & -1 & -1 & 6\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 & -9 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & -3\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & -3 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & -3\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the reduced matrix above, we see that the pivot columns are the $1$st, $2$nd, and $3$rd columns. So,  $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$\nAlso, the matrix tells us that ${x}_{1}=-1,$ ${x}_{2}=-2,$ and ${x}_{3}=-3,$ meaning that\n\n$$\n(-1)\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 3 \\\\ -1\\end{bmatrix}}_{{a}_{1}}+(-2)\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}}_{{a}_{2}}+(-3)\\cdot \\underbrace{\\begin{bmatrix}2 \\\\ 6 \\\\ -1\\end{bmatrix}}_{{a}_{3}}=\\underbrace{\\begin{bmatrix}-9 \\\\ -29 \\\\ 6\\end{bmatrix}}_{{a}_{4}}.\n$$\n\nTherefore, ${x}_{1}+{x}_{2}+{x}_{3}=(-1)+(-2)+(-3)=-6.$"}] [{:db/id #edb/ref 17592186247191 :knowledge-point/_questions [{:db/id #edb/ref 17592186119811 :knowledge-point/id #uuid "87dc8398-fb5c-564b-a796-db15ff30d72c" :knowledge-point/title "Determining if a Vector Is in the Column Space of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05dd1857-2985-546b-9aba-fc98eb855d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186244360} {:answer/id #uuid "20acb5fc-d805-5850-bfb0-2f0f05d25203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244601} {:answer/id #uuid "2c4cd3b2-1f4e-53be-932d-e0f8f8127322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186244706} {:answer/id #uuid "3940ebec-c39e-553c-b6aa-55bd069457ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186244821} {:answer/id #uuid "7d7b3c15-cef9-5072-800b-26138a27eae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186245415}] :answer-field/correct {:answer/id #uuid "2c4cd3b2-1f4e-53be-932d-e0f8f8127322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186244706} :answer-field/id #uuid "2ca7504e-b5bc-5c05-8761-5692c93d71f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246619}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b861c0c2-25f8-5f54-84a3-3dea6f60c30d" :question/math-academy-id "q-110982" :question/problem "The matrix $C$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(C).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${x}_{1},{x}_{2}$ and ${x}_{3}$ are real numbers such that $b={x}_{1}{c}_{1}+{x}_{2}{c}_{2}+{x}_{3}{c}_{3},$ and ${c}_{1}$, ${c}_{2}$, and ${c}_{3}$ are the respective columns of $C.$\n\n$$\nC=\\begin{bmatrix}1 & 3 & 3 \\\\ 0 & 2 & -1 \\\\ -1 & 1 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}-8 \\\\ -12 \\\\ -6\\end{bmatrix}\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(C),$ we need to check if the equation $Cx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[C\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[C\\,|\\,b] & =\\begin{bmatrix}1 & 3 & 3 & -8 \\\\ 0 & 2 & -1 & -12 \\\\ -1 & 1 & 0 & -6\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 3 & -8 \\\\ 0 & 2 & -1 & -12 \\\\ 0 & 4 & 3 & -14\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 3 & -8 \\\\ 0 & 2 & -1 & -12 \\\\ 0 & 0 & 5 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2}+3{x}_{3} &=-8 \\\\ 2{x}_{2}-{x}_{3} &=-12 \\\\ 5{x}_{3} &=10.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting it into the second equation gives \n\n$$\n\\begin{aligned}2{x}_{2}-(2) & =-12 \\\\ {x}_{2} & =-5.\\end{aligned}\n$$\n\nFinally, from the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1} & =-8-3{x}_{2}-3{x}_{3} \\\\  & =-8-3(-5)-3(2) \\\\  & =1.\\end{aligned}\n$$\n\nSince we have a solution, the equation $Cx=b$ is consistent, which implies that $b\\in \\text{Col}(C).$ \n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${c}_{1},$ ${c}_{2},$ and ${c}_{3}:$\n\n$$\n\\underbrace{\\begin{bmatrix}-8 \\\\ -12 \\\\ -6\\end{bmatrix}}_{b}=1\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}}_{{c}_{1}}+(-5)\\cdot \\underbrace{\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}}_{{c}_{2}}+2\\cdot \\underbrace{\\begin{bmatrix}3 \\\\ -1 \\\\ 0\\end{bmatrix}}_{{c}_{3}}\n$$\n\nFinally, we get ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=1\\cdot (-5)\\cdot 2=-10.$"}] [{:db/id #edb/ref 17592186247192 :knowledge-point/_questions [{:db/id #edb/ref 17592186119811 :knowledge-point/id #uuid "87dc8398-fb5c-564b-a796-db15ff30d72c" :knowledge-point/title "Determining if a Vector Is in the Column Space of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002a439c-2842-5d1e-810b-2b542db359a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186244300} {:answer/id #uuid "4a011f6f-d375-50d7-836f-0e8d861b17ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186244972} {:answer/id #uuid "9c0862b1-6730-52c0-8a62-ebdf2153695c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186245696} {:answer/id #uuid "d9c7d7ac-06eb-5406-babb-1ac034337f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186246251} {:answer/id #uuid "f85aa94a-4629-5d8f-91a0-d23d6462a022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186246499}] :answer-field/correct {:answer/id #uuid "9c0862b1-6730-52c0-8a62-ebdf2153695c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186245696} :answer-field/id #uuid "48377fc5-ae90-5f13-8b71-0384837c02f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246664}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85af463a-fe91-5600-aaed-1c1e9aea31cb" :question/math-academy-id "q-110983" :question/problem "The matrix $M$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(M).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${x}_{1},{x}_{2}$ and ${x}_{3}$ are real numbers such that $b={x}_{1}{m}_{1}+{x}_{2}{m}_{2}+{x}_{3}{m}_{3},$ and ${m}_{1}$, ${m}_{2}$, and ${m}_{3}$ are the respective columns of $M.$\n\n$$\nM=\\begin{bmatrix}1 & 1 & 0 \\\\ 2 & -2 & 4 \\\\ 0 & 1 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ -6 \\\\ 8\\end{bmatrix}\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(M),$ we need to check if the equation $Mx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[M\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[M\\,|\\,b] & =\\begin{bmatrix}1 & 1 & 0 & 9 \\\\ 2 & -2 & 4 & -6 \\\\ 0 & 1 & 0 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 9 \\\\ 0 & -4 & 4 & -24 \\\\ 0 & 1 & 0 & 8\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 9 \\\\ 0 & 1 & 0 & 8 \\\\ 0 & -4 & 4 & -24\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 9 \\\\ 0 & 1 & 0 & 8 \\\\ 0 & 0 & 4 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2} &=9 \\\\ {x}_{2} &=8 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\nFinally, from the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}+(8) & =9 \\\\ {x}_{1} & =1.\\end{aligned}\n$$\n\n \n\nSince we have a solution, the equation $Mx=b$ is consistent, which implies that $b\\in \\text{Col}(M).$ \n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${m}_{1},$ ${m}_{2},$ and ${m}_{3}:$\n\n$$\n\\underbrace{\\begin{bmatrix}9 \\\\ -6 \\\\ 8\\end{bmatrix}}_{b}=1\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}}_{{m}_{1}}+8\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}}_{{m}_{2}}+2\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}}_{{m}_{3}}\n$$\n\nFinally, we get ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=1\\cdot 8\\cdot 2=16.$"}] [{:db/id #edb/ref 17592186247221 :knowledge-point/_questions [{:db/id #edb/ref 17592186152156 :knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57" :knowledge-point/title "Determining Whether a Given Set Is a Basis of the Column Space of a Matrix With Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1640f98f-b934-544d-b764-303053864f27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186244517} {:answer/id #uuid "1f7e1df3-4580-5975-b457-6c0295c1f461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186244591} {:answer/id #uuid "53145b12-05ac-544a-99da-924b20f9b963" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245047} {:answer/id #uuid "5891d6a5-5899-58e5-aad9-238b06855faa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{{}{d}_{1},{d}_{3}\\text{}}$ is not a basis of $\\text{Col}(D)$" :db/id #edb/ref 17592186245097} {:answer/id #uuid "ecfbaa5c-8266-5fb2-9b94-fdf08e2337ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186246409}] :answer-field/correct {:answer/id #uuid "ecfbaa5c-8266-5fb2-9b94-fdf08e2337ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186246409} :answer-field/id #uuid "18d39719-9109-5df8-9dbf-ca0c2b5cad6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246589}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1560ce17-f00a-5fcc-81e8-d48fb2971bfa" :question/math-academy-id "q-111468" :question/problem "The matrix $D$ is given below. Let ${d}_{1}$, ${d}_{2}$, and ${d}_{3}$ be the respective columns of $D.$ Determine if $B=\\text{{}{d}_{1},{d}_{3}\\text{}}$ is a basis of $\\text{Col}(D).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{3}$, where ${d}_{2}={x}_{1}{d}_{1}+{x}_{3}{d}_{3}.$ \n\n$$\nD=\\begin{bmatrix}1 & -6 & 2 \\\\ -4 & 24 & 8\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}1 & -6 & 2 \\\\ -4 & 24 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -6 & 2 \\\\ 0 & 0 & 16\\end{bmatrix} & {R}_{2} & :=\\frac{1}{16}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -6 & 2 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -6 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $3$rd columns. So, a basis of $\\text{Col}(D)$ is $\\{{d}_{1},{d}_{3}\\},$ that is to say,\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ -4\\end{bmatrix},\\begin{bmatrix}2 \\\\ 8\\end{bmatrix}\\}.\n$$\n\nNow, since the $2$nd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${d}_{2}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n\\underbrace{\\begin{bmatrix}-6 \\\\ 24\\end{bmatrix}}_{{d}_{2}}=\\underbrace{(-6)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}}_{{d}_{1}}+\\underbrace{(0)}_{{x}_{3}}\\cdot \\underbrace{\\begin{bmatrix}2 \\\\ 8\\end{bmatrix}}_{{d}_{3}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{3}=-6\\cdot 0=0.$"}] [{:db/id #edb/ref 17592186247222 :knowledge-point/_questions [{:db/id #edb/ref 17592186152156 :knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57" :knowledge-point/title "Determining Whether a Given Set Is a Basis of the Column Space of a Matrix With Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "371452ac-26e7-5bbb-be3e-be70bc3df79b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186244801} {:answer/id #uuid "831b82b6-a95a-507f-b04a-17c64953170f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{{}{t}_{1},{t}_{2}\\text{}}$ is not a basis of $\\text{Col}(T)$" :db/id #edb/ref 17592186245466} {:answer/id #uuid "9830ad1c-031c-5b34-ad1e-52591549abb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186245662} {:answer/id #uuid "dee16ecf-5692-51b1-9f0c-32a06e1d78ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186246289} {:answer/id #uuid "edc0cfe0-6da6-52ee-a471-969a03e0a91f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186246414}] :answer-field/correct {:answer/id #uuid "dee16ecf-5692-51b1-9f0c-32a06e1d78ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186246289} :answer-field/id #uuid "bbbf08a4-78f1-5874-ae97-b9c03d837426" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dc6d34c-bae9-5213-a501-60bff181fa06" :question/math-academy-id "q-111502" :question/problem "The matrix $T$ is given below. Let ${t}_{1}$, ${t}_{2}$, and ${t}_{3}$ be the respective columns of $T.$ Determine if $B=\\text{{}{t}_{1},{t}_{2}\\text{}}$ is a basis of $\\text{Col}(T).$ If that is the case, find ${x}_{1}\\cdot {x}_{2}$, where ${t}_{3}={x}_{1}{t}_{1}+{x}_{2}{t}_{2}.$\n\n$$\nT=\\begin{bmatrix}1 & 2 & 8 \\\\ 3 & 8 & 30\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $T$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}1 & 2 & 8 \\\\ 3 & 8 & 30\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 8 \\\\ 0 & 2 & 6\\end{bmatrix} & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 8 \\\\ 0 & 1 & 3\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(T)$ is ${{t}_{1},{t}_{2}},$ that is to say,\n\n$$\nB={\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\begin{bmatrix}2 \\\\ 8\\end{bmatrix}}.\n$$\n\nNow, since the $3$rd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${t}_{3}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n\\underbrace{\\begin{bmatrix}8 \\\\ 30\\end{bmatrix}}_{{t}_{3}}=\\underbrace{(2)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{{t}_{1}}+\\underbrace{(3)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}2 \\\\ 8\\end{bmatrix}}_{{t}_{2}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{2}=2\\cdot 3=6.$"}] [{:db/id #edb/ref 17592186247227 :knowledge-point/_questions [{:db/id #edb/ref 17592186152157 :knowledge-point/id #uuid "c3bf9ea3-d57f-53f6-aa3c-eddffe1a8cfa" :knowledge-point/title "Determining Whether a Given Set Is a Basis of the Column Space of a Matrix For a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20472f46-7b35-5af4-bfc8-ec5caa02d79d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186244599} {:answer/id #uuid "3984d68c-fbf8-5e5b-b17a-f60f741e298b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186244823} {:answer/id #uuid "91dc3791-fbb0-58fc-8996-7caa1a749a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245584} {:answer/id #uuid "a2ec493e-2751-54f6-8e50-a28c12be23aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186245769} {:answer/id #uuid "e9271a88-7c05-5e7c-8fde-c4bd4934178e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{{}{c}_{1},{c}_{2}\\text{}}$ is not a basis of $\\text{Col}(C)$" :db/id #edb/ref 17592186246379}] :answer-field/correct {:answer/id #uuid "a2ec493e-2751-54f6-8e50-a28c12be23aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186245769} :answer-field/id #uuid "ece770f6-1100-5fc9-b657-fa1005c33ce5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246971}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a52283aa-8e43-5623-8f72-5c841a8ea5a0" :question/math-academy-id "q-111514" :question/problem "The matrix $C$ is given below. Let ${c}_{1}$, ${c}_{2}$,  ${c}_{3}$, and ${c}_{4}$ be the respective columns of $C.$ Determine if $B=\\text{{}{c}_{1},{c}_{2}\\text{}}$ is a basis of $\\text{Col}(C).$ If that is the case, find ${x}_{1}\\cdot {x}_{2}$, where ${c}_{4}={x}_{1}{c}_{1}+{x}_{2}{c}_{2}.$\n\n$$\nC=\\begin{bmatrix}1 & 0 & 1 & 4 \\\\ 1 & -4 & -3 & -8 \\\\ 3 & -4 & -1 & 0\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $C$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}1 & 0 & 1 & 4 \\\\ 1 & -4 & -3 & -8 \\\\ 3 & -4 & -1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 4 \\\\ 0 & -4 & -4 & -12 \\\\ 3 & -4 & -1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 4 \\\\ 0 & -4 & -4 & -12 \\\\ 0 & -4 & -4 & -12\\end{bmatrix} & {R}_{2} & :=(-\\frac{1}{4}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 4 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & -4 & -4 & -12\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 4 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(C)$ is $\\{{c}_{1},{c}_{2}\\},$ that is to say,\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 1 \\\\ 3\\end{bmatrix},\\begin{bmatrix}0 \\\\ -4 \\\\ -4\\end{bmatrix}\\}.\n$$\n\nNow, since the $4$th column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${c}_{4}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n\\underbrace{\\begin{bmatrix}4 \\\\ -8 \\\\ 0\\end{bmatrix}}_{{c}_{4}}=\\underbrace{(4)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ 3\\end{bmatrix}}_{{c}_{1}}+\\underbrace{(3)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ -4 \\\\ -4\\end{bmatrix}}_{{c}_{2}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{2}=4\\cdot 3=12.$"}] [{:db/id #edb/ref 17592186247247 :knowledge-point/_questions [{:db/id #edb/ref 17592186119820 :knowledge-point/id #uuid "6e4f1675-9146-5279-9b64-07a63a9bed99" :knowledge-point/title "Finding a Vector Given Its Coordinates Relative To a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8da9f7-a617-53ed-93da-635b0c735336" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -3 \\\\ 11\\end{bmatrix}" :db/id #edb/ref 17592186244723} {:answer/id #uuid "3d7cb8fb-5c42-533f-97a6-780ef416c8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 \\\\ -9 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186244854} {:answer/id #uuid "696befb2-5c49-5e77-812a-439254fdcd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -9 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186245247} {:answer/id #uuid "71ed24ea-daf5-543a-a6d8-080a7122db0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 3 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186245328} {:answer/id #uuid "c0a1c0d2-aa19-516b-b44c-3b76eeadc3eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 \\\\ -9 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186246032}] :answer-field/correct {:answer/id #uuid "3d7cb8fb-5c42-533f-97a6-780ef416c8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 \\\\ -9 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186244854} :answer-field/id #uuid "1b545292-a01f-5403-8501-901b5b52bc83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246595}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4a567cc-00f9-5ef3-a682-d76360618a8f" :question/math-academy-id "q-112197" :question/problem "Find the vector $x$, if $B={{b}_{1},{b}_{2}}$ is a basis of $\\text{Span}{{b}_{1},{b}_{2}},$ and \n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -5 \\\\ -3\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}2 \\\\ -3 \\\\ -1\\end{bmatrix},\\,[x]_{B}=\\begin{bmatrix}6 \\\\ -7\\end{bmatrix}.\n$$" :question/worked-solution "We know that any vector in  $\\text{Span}{{b}_{1},{b}_{2}}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -5 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -3 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=\\begin{bmatrix}6 \\\\ -7\\end{bmatrix},$ we obtain\n\n$$\n\\begin{aligned}x & =\\underbrace{(\\,6\\,)}_{{x}_{1}}\\begin{bmatrix}1 \\\\ -5 \\\\ -3\\end{bmatrix}+\\underbrace{(\\,-7\\,)}_{{x}_{2}}\\begin{bmatrix}2 \\\\ -3 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ -30 \\\\ -18\\end{bmatrix}+\\begin{bmatrix}-14 \\\\ 21 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8 \\\\ -9 \\\\ -11\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247248 :knowledge-point/_questions [{:db/id #edb/ref 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41cb02b9-13f3-5f1d-bb94-34c18d18a3a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186244889} {:answer/id #uuid "6bdc01cf-2d88-5f1d-918a-b6b8c908df28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245269} {:answer/id #uuid "7ddf9142-c44c-55fc-9780-62e19815fce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245422} {:answer/id #uuid "f2a4d81c-2941-5f57-a05a-cf24897f52ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186246455} {:answer/id #uuid "b24cff0c-453c-54bf-b5a0-92ed0ff4ac54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186426850}] :answer-field/correct {:answer/id #uuid "6bdc01cf-2d88-5f1d-918a-b6b8c908df28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245269} :answer-field/id #uuid "306483a6-036f-5c40-8757-606ab6fe2509" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246624}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df51ea15-f830-55ce-a2e9-e42267e5f4de" :question/math-academy-id "q-112203" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}0 \\\\ 8 \\\\ 3\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n\\underbrace{\\begin{bmatrix}0 \\\\ 8 \\\\ 3\\end{bmatrix}}_{x}=\\underbrace{(\\,3\\,)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{{b}_{1}}+\\underbrace{(\\,8\\,)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=3\\cdot {b}_{1}+8\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}.\n$$\n\nFinally, we have that ${x}_{1}=3.$"}] [{:db/id #edb/ref 17592186247249 :knowledge-point/_questions [{:db/id #edb/ref 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "084c18f2-f67b-5e04-b240-8825360f865a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186244379} {:answer/id #uuid "08c8915f-4f30-5fbd-b8da-620ab2515c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186244383} {:answer/id #uuid "36c8a039-cae1-5573-aa38-c3b8d5035d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244798} {:answer/id #uuid "747f4e6a-3787-5256-9ec2-519b2042c307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245350} {:answer/id #uuid "bfacd98f-ad15-5b3d-b121-7e7590e5c9f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186246021}] :answer-field/correct {:answer/id #uuid "36c8a039-cae1-5573-aa38-c3b8d5035d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244798} :answer-field/id #uuid "3961e0da-79bd-5af2-b292-f3270d3bc83c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1636206a-9151-5198-a421-3985f6d14532" :question/math-academy-id "q-112204" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where \n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n\\underbrace{\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}}_{x}=\\underbrace{(\\,4\\,)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{{b}_{1}}+\\underbrace{(\\,0\\,)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{b}_{2}}+\\underbrace{(\\,5\\,)}_{{x}_{3}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{{b}_{3}}\n$$\n\nwhich means that\n\n$$\nx=4\\cdot {b}_{1}+0\\cdot {b}_{2}+5\\cdot {b}_{3}\n$$\n\nand therefore \n\n$$\n[x]_{B}=\\begin{bmatrix}4 \\\\ 0 \\\\ 5\\end{bmatrix},\n$$\n\nFinally, ${x}_{1}=4.$"}] [{:db/id #edb/ref 17592186247250 :knowledge-point/_questions [{:db/id #edb/ref 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6641cc50-250b-56ad-b14a-c1124ec8c662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245216} {:answer/id #uuid "6fd41642-b280-5a7c-b432-e2ff0d315b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186245311} {:answer/id #uuid "a10427df-c462-55bc-928a-4193f572fa44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245747} {:answer/id #uuid "c751a88a-3aa0-5648-a5b6-305258fb0889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186246079} {:answer/id #uuid "dbad1c26-6ccc-544d-abe3-93664ba57768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/id #edb/ref 17592186430725}] :answer-field/correct {:answer/id #uuid "a10427df-c462-55bc-928a-4193f572fa44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245747} :answer-field/id #uuid "6ec8a63e-d3c0-5582-b9c7-8a8870cbc79b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "438d91ee-b10a-5c27-8e0b-9fc621fd3a05" :question/math-academy-id "q-112208" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ 2 \\\\ 3\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n\\underbrace{\\begin{bmatrix}6 \\\\ 2 \\\\ 3\\end{bmatrix}}_{x}=\\underbrace{(\\,2\\,)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{b}_{1}}+\\underbrace{(\\,3\\,)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{{b}_{2}}+\\underbrace{(\\,6\\,)}_{{x}_{3}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{{b}_{3}}\n$$\n\nwhich means that\n\n$$\nx=2\\cdot {b}_{1}+3\\cdot {b}_{2}+6\\cdot {b}_{3}\n$$\n\nand therefore \n\n$$\n[x]_{B}=\\begin{bmatrix}2 \\\\ 3 \\\\ 6\\end{bmatrix},\n$$\n\nFinally, ${x}_{2}=3.$"}] [{:db/id #edb/ref 17592186247254 :knowledge-point/_questions [{:db/id #edb/ref 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c4aa29-25a2-5420-aaaa-474634177ffc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448004} {:answer/id #uuid "6239020d-aaf4-5fe4-a820-c620ab71e99a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448005}] :answer-field/correct {:answer/id #uuid "97c4aa29-25a2-5420-aaaa-474634177ffc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448004} :answer-field/id #uuid "ef24bf57-2f01-5432-9ac4-0d48397c5756" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449042} {:answer-field/choices [{:answer/id #uuid "08f95c68-b61f-5133-b49d-6adac9b4640c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448006} {:answer/id #uuid "1be585ce-f404-5d77-bc35-25a343b2c635" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448007}] :answer-field/correct {:answer/id #uuid "08f95c68-b61f-5133-b49d-6adac9b4640c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448006} :answer-field/id #uuid "b996260e-b2d2-5f6f-a512-3f34a15eb2bf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449043} {:answer-field/choices [{:answer/id #uuid "d65f7c26-d93c-564a-b50c-12755d1b153e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448008} {:answer/id #uuid "758f8f50-5658-5025-8870-c168848da070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448009}] :answer-field/correct {:answer/id #uuid "758f8f50-5658-5025-8870-c168848da070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448009} :answer-field/id #uuid "baeae7a3-137e-50fe-b6e4-63f32aa365c4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eeced2e5-384e-5308-b21f-d88eb6c697e3" :question/math-academy-id "q-112252" :question/problem "$$\nA=\\begin{bmatrix}3 & 1 & 1 \\\\ 2 & 6 & -2 \\\\ -1 & 1 & 5\\end{bmatrix},\\,v=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =4$ of $A$\n- **II.** $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =4$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =4$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-4I:$\n\n$$\nA-4I=\\begin{bmatrix}3 & 1 & 1 \\\\ 2 & 6 & -2 \\\\ -1 & 1 & 5\\end{bmatrix}-4\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 & 1 \\\\ 2 & 2 & -2 \\\\ -1 & 1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-4I:$\n\n$$\n(A-4I)v=\\begin{bmatrix}-1 & 1 & 1 \\\\ 2 & 2 & -2 \\\\ -1 & 1 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}=\\underbrace{\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-4I:$\n\n$$\n(A-4I)w=\\begin{bmatrix}-1 & 1 & 1 \\\\ 2 & 2 & -2 \\\\ -1 & 1 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}}_{v}\\overset{A-4I\\,}{\\to }\\underbrace{\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{w}\\overset{A-4I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A-4I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =4$ of $A.$*\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186247297 :knowledge-point/_questions [{:db/id #edb/ref 17592186054803 :knowledge-point/id #uuid "c2e897cc-b3fe-5d2f-8b47-3afdfe276bcf" :knowledge-point/title "Factoring a Quartic Polynomial Given Two Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140a15bc-fcf1-5cd5-bb3c-e84afc03fb52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4x-1)(x-1)" :db/id #edb/ref 17592186244496} {:answer/id #uuid "29f5e660-86ea-5256-8c05-d4e7429d46d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x+1)(x-2)" :db/id #edb/ref 17592186244687} {:answer/id #uuid "4978aa35-7d7f-5b59-8af9-843564a32b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x+1)(x+2)" :db/id #edb/ref 17592186244967} {:answer/id #uuid "bc5f3ae5-6893-5186-b94f-2e8294ab9c51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-1)(x+2)" :db/id #edb/ref 17592186245994} {:answer/id #uuid "bce4f31e-2daa-5469-ae29-c4736cf33aa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x-1)(x-2)" :db/id #edb/ref 17592186245999}] :answer-field/correct {:answer/id #uuid "bce4f31e-2daa-5469-ae29-c4736cf33aa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x-1)(x-2)" :db/id #edb/ref 17592186245999} :answer-field/id #uuid "9d5d1fe0-66e0-5072-aedc-5e9a7b18459a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246822}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "904dff05-ecb6-51b3-917d-26bcf8537c87" :question/math-academy-id "q-112615" :question/problem "Find the polynomial $P(x)$ given that\n\n$$\n3{x}^{4}-13{x}^{3}+7{x}^{2}+17x-6=(x-3)(x+1)P(x).\n$$" :question/worked-solution "Let $f(x)=3{x}^{4}-13{x}^{3}+7{x}^{2}+17x-6.$ We know that $(x-3)$ and $(x+1)$ are factors of $f(x),$ and we need to find its other factors.\n\nBecause $(x-3)$ is a factor of $f(x),$ we know that $(x-3)$ divides $f(x)$ with no remainder. So, to begin factoring $f(x),$ we can divide it by $(x-3)$ using synthetic division:\n\n|  | ${x}^{4}$ | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- | --- |\n| $3$ | $3$ | $-13$ | $7$ | $17$ | $-6$ |\n|  | $↓$ | $9$ | $-12$ | $-15$ | $6$ |\n|  | $3$ | $-4$ | $-5$ | $2$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{3{x}^{4}-13{x}^{3}+7{x}^{2}+17x-6}{x-3}=3{x}^{3}-4{x}^{2}-5x+2,\n$$\n\nwhich means that\n\n$$\n3{x}^{4}-13{x}^{3}+7{x}^{2}+17x-6=(x-3)(3{x}^{3}-4{x}^{2}-5x+2).\n$$\n\nNow, because $(x+1)$ is also a factor of $f(x),$ it must be a factor of the quotient $(3{x}^{3}-4{x}^{2}-5x+2).$ So, we divide this quotient by $(x+1)$ using synthetic division once more:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-1$ | $3$ | $-4$ | $-5$ | $2$ |\n|  | $↓$ | $-3$ | $7$ | $-2$ |\n|  | $3$ | $-7$ | $2$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{3{x}^{3}-4{x}^{2}-5x+2}{x+1}=3{x}^{2}-7x+2,\n$$\n\nwhich means that\n\n$$\n3{x}^{4}-13{x}^{3}+7{x}^{2}+17x-6=(x-3)(x+1)(3{x}^{2}-7x+2).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n3{x}^{4}-13{x}^{3}+7{x}^{2}+17x-6=(x-3)(x+1)\\underbrace{(3x-1)(x-2)}_{P(x)}.\n$$\n\nTherefore, $P(x)=(3x-1)(x-2).$"}] [{:db/id #edb/ref 17592186247298 :knowledge-point/_questions [{:db/id #edb/ref 17592186054803 :knowledge-point/id #uuid "c2e897cc-b3fe-5d2f-8b47-3afdfe276bcf" :knowledge-point/title "Factoring a Quartic Polynomial Given Two Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b24578e-481e-553a-a83a-dc64b6635d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x+3)(x-1)" :db/id #edb/ref 17592186244416} {:answer/id #uuid "39f82396-0c2d-56e1-b9fd-de4a09dd64c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x-2)(x+1)" :db/id #edb/ref 17592186244827} {:answer/id #uuid "4dcb12f3-3780-53db-adc2-7c2e38923858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-3)(x-1)" :db/id #edb/ref 17592186245004} {:answer/id #uuid "b902a4ce-fd1e-5700-be25-6073ff3196a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x+2)(x+1)" :db/id #edb/ref 17592186245966} {:answer/id #uuid "eeb9253d-1f88-5f8c-9b58-b795ed407dcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4x-3)(x+2)" :db/id #edb/ref 17592186246426}] :answer-field/correct {:answer/id #uuid "39f82396-0c2d-56e1-b9fd-de4a09dd64c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x-2)(x+1)" :db/id #edb/ref 17592186244827} :answer-field/id #uuid "14ae9a65-2c31-50dc-9b0c-6b6e3de50ea9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246584}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4055097-e27e-5747-8711-3ff850d11a98" :question/math-academy-id "q-112617" :question/problem "Find the polynomial $P(x)$ given that\n\n$$\n3{x}^{4}+4{x}^{3}-37{x}^{2}-14x+24=(x-3)(x+4)P(x).\n$$" :question/worked-solution "Let $f(x)=3{x}^{4}+4{x}^{3}-37{x}^{2}-14x+24.$ We know that $(x-3)$ and $(x+4)$ are factors of $f(x),$ and we need to find its other factors.\n\nBecause $(x-3)$ is a factor of $f(x),$ we know that $(x-3)$ divides $f(x)$ with no remainder. So, to begin factoring $f(x),$ we can divide it by $(x-3)$ using synthetic division:\n\n|  | ${x}^{4}$ | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- | --- |\n| $3$ | $3$ | $4$ | $-37$ | $-14$ | $24$ |\n|  | $↓$ | $9$ | $39$ | $6$ | $-24$ |\n|  | $3$ | $13$ | $2$ | $-8$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{3{x}^{4}+4{x}^{3}-37{x}^{2}-14x+24}{x-3}=3{x}^{3}+13{x}^{2}+2x-8,\n$$\n\nwhich means that\n\n$$\n3{x}^{4}+4{x}^{3}-37{x}^{2}-14x+24=(x-3)(3{x}^{3}+13{x}^{2}+2x-8).\n$$\n\nNow, because $(x+4)$ is also a factor of $f(x),$ it must be a factor of the quotient $(3{x}^{3}+13{x}^{2}+2x-8).$ So, we divide this quotient by $(x+4)$ using synthetic division once more:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-4$ | $3$ | $13$ | $2$ | $-8$ |\n|  | $↓$ | $-12$ | $-4$ | $8$ |\n|  | $3$ | $1$ | $-2$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{3{x}^{3}+13{x}^{2}+2x-8}{x+4}=3{x}^{2}+x-2,\n$$\n\nwhich means that\n\n$$\n3{x}^{4}+4{x}^{3}-37{x}^{2}-14x+24=(x-3)(x+4)(3{x}^{2}+x-2).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n3{x}^{4}+4{x}^{3}-37{x}^{2}-14x+24=(x-3)(x+4)\\underbrace{(3x-2)(x+1)}_{P(x)}.\n$$\n\nTherefore, $P(x)=(3x-2)(x+1).$"}] [{:db/id #edb/ref 17592186247300 :knowledge-point/_questions [{:db/id #edb/ref 17592186054803 :knowledge-point/id #uuid "c2e897cc-b3fe-5d2f-8b47-3afdfe276bcf" :knowledge-point/title "Factoring a Quartic Polynomial Given Two Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "292959fc-5935-574c-9f04-13e8671cf522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-7)(x+1)" :db/id #edb/ref 17592186244674} {:answer/id #uuid "36ddaff0-33e2-5585-b7bd-e8cc98dc6e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)(x+7)" :db/id #edb/ref 17592186244800} {:answer/id #uuid "45503d60-7034-5dc8-94fc-0693fe24418a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)(5-x)" :db/id #edb/ref 17592186244928} {:answer/id #uuid "cbbc7b91-18d2-5c35-b07b-b9f5fa63305c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2-x)(x+1)" :db/id #edb/ref 17592186246129} {:answer/id #uuid "f620a82c-3ecf-57d2-9154-b09ad9b1016b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5)(x+7)" :db/id #edb/ref 17592186246487}] :answer-field/correct {:answer/id #uuid "36ddaff0-33e2-5585-b7bd-e8cc98dc6e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)(x+7)" :db/id #edb/ref 17592186244800} :answer-field/id #uuid "31c5333b-8831-529d-9a73-a9a967c8862b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246629}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c8eab9f-7b10-5db7-a80e-51f13f149526" :question/math-academy-id "q-112626" :question/problem "Find the polynomial $P(x)$ given that \n\n$$\n{x}^{4}+2{x}^{3}-36{x}^{2}-2x+35=(x-5)(x+1)P(x).\n$$" :question/worked-solution "Let $f(x)={x}^{4}+2{x}^{3}-36{x}^{2}-2x+35.$ We know that $(x-5)$ and $(x+1)$ are factors of $f(x),$ and we need to find its other factors.\n\nBecause $(x-5)$ is a factor of $f(x),$ we know that $(x-5)$ divides $f(x)$ with no remainder. So, to begin factoring $f(x),$ we can divide it by $(x-5)$ using synthetic division:\n\n\\\n\n|  | ${x}^{4}$ | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- | --- |\n| $5$ | $1$ | $2$ | $-36$ | $-2$ | $35$ |\n|  | $↓$ | $5$ | $35$ | $-5$ | $-35$ |\n|  | $1$ | $7$ | $-1$ | $-7$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{{x}^{4}+2{x}^{3}-36{x}^{2}-2x+35}{x-5}={x}^{3}+7{x}^{2}-x-7,\n$$\n\nwhich means that\n\n$$\n{x}^{4}+2{x}^{3}-36{x}^{2}-2x+35=(x-5)({x}^{3}+7{x}^{2}-x-7).\n$$\n\nNow, because $(x+1)$ is also a factor of $f(x),$ it must be a factor of the quotient $({x}^{3}+7{x}^{2}-x-7).$ So, we divide this quotient by $(x+1)$ using synthetic division once more:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-1$ | $1$ | $7$ | $-1$ | $-7$ |\n|  | $↓$ | $-1$ | $-6$ | $7$ |\n|  | $1$ | $6$ | $-7$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{{x}^{3}+7{x}^{2}-x-7}{x+1}={x}^{2}+6x-7,\n$$\n\nwhich means that\n\n$$\n{x}^{4}+2{x}^{3}-36{x}^{2}-2x+35=(x-5)(x+1)({x}^{2}+6x-7).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n{x}^{4}+2{x}^{3}-36{x}^{2}-2x+35=(x-5)(x+1)\\underbrace{(x-1)(x+7)}_{P(x)}.\n$$\n\nTherefore, $P(x)=(x-1)(x+7).$"}] [{:db/id #edb/ref 17592186247304 :knowledge-point/_questions [{:db/id #edb/ref 17592186054805 :knowledge-point/id #uuid "cd03f31e-360e-5cc1-9118-f71f813d572e" :knowledge-point/title "Factoring a Quartic Polynomial With Only Two Real Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cc03a46-7ee7-5044-bc6c-15b04b553d83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+3" :db/id #edb/ref 17592186245000} {:answer/id #uuid "6778c431-aecb-5824-ae18-f2903888b501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-3x+9" :db/id #edb/ref 17592186245227} {:answer/id #uuid "7c401869-61c9-5f98-b591-a1b15a5fa6e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2" :db/id #edb/ref 17592186245402} {:answer/id #uuid "c7e5aff8-0f5f-5aa1-9508-d57be3a886f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+9" :db/id #edb/ref 17592186246082} {:answer/id #uuid "fe6415d9-fe44-549e-abbd-56d31571b9ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4x+6" :db/id #edb/ref 17592186246539}] :answer-field/correct {:answer/id #uuid "c7e5aff8-0f5f-5aa1-9508-d57be3a886f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+9" :db/id #edb/ref 17592186246082} :answer-field/id #uuid "4e32de81-be70-568b-9d15-3f31aa94abf6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246679}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f55a3ca-a0b4-5d8c-bbcd-107aea903d99" :question/math-academy-id "q-112651" :question/problem "Find the polynomial $P(x)$ given that \n\n$$\n{x}^{4}-10{x}^{3}+34{x}^{2}-90x+225=(x-5)^{2}P(x).\n$$" :question/worked-solution "Let $f(x)={x}^{4}-10{x}^{3}+34{x}^{2}-90x+225.$ We know that $(x-5)^{2}$ is a factor of $f(x),$ and we need to find its other factors.\n\nBecause $(x-5)$ is a factor of $f(x),$ we know that $(x-5)$ divides $f(x)$ with no remainder. So, to begin factoring $f(x),$ we can divide it by $(x-5)$ using synthetic division:\n\n|  | ${x}^{4}$ | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- | --- |\n| $5$ | $1$ | $-10$ | $34$ | $-90$ | $225$ |\n|  | $↓$ | $5$ | $-25$ | $45$ | $-225$ |\n|  | $1$ | $-5$ | $9$ | $-45$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{{x}^{4}-10{x}^{3}+34{x}^{2}-90x+225}{x-5}={x}^{3}-5{x}^{2}+9x-45,\n$$\n\nwhich means that\n\n$$\n{x}^{4}-10{x}^{3}+34{x}^{2}-90x+225=(x-5)({x}^{3}-5{x}^{2}+9x-45).\n$$\n\nNow, because $(x-5)^{2}$ is a factor of $f(x),$ $(x-5)$ must be also a factor of the quotient $({x}^{3}-5{x}^{2}+9x-45).$ So, we divide this quotient by $(x-5)$ using synthetic division once more:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $5$ | $1$ | $-5$ | $9$ | $-45$ |\n|  | $↓$ | $5$ | $0$ | $45$ |\n|  | $1$ | $0$ | $9$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{{x}^{3}-5{x}^{2}+9x-45}{x-2}={x}^{2}+9,\n$$\n\nwhich means that\n\n$$\n{x}^{4}-10{x}^{3}+34{x}^{2}-90x+225=(x-5)^{2}({x}^{2}+9).\n$$\n\nTo see whether the quadratic polynomial ${x}^{2}+9$ can be factored any further, we calculate its discriminant:\n\n$$\n{b}^{2}-4ac={0}^{2}-4(1)(9)=-36<0\n$$\n\nSo, the quadratic polynomial ${x}^{2}+9$ cannot be factored over the real numbers since its discriminant is negative. \n\nTherefore, the full factorization of $f(x)$ over the real numbers is given by \n\n$$\n{x}^{4}-10{x}^{3}+34{x}^{2}-90x+225=(x-5)^{2}\\underbrace{({x}^{2}+9)}_{P(x)}.\n$$\n\nFinally, $P(x)={x}^{2}+9.$"}] [{:db/id #edb/ref 17592186250475 :knowledge-point/_questions [{:db/id #edb/ref 17592186105814 :knowledge-point/id #uuid "01fe05cd-8acc-5676-9328-7a26362a77d0" :knowledge-point/title "Solving for an Unknown Given the Value of a Right Riemann Sum With Regular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ed3778-353a-597c-a757-38a9149b75bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186247632} {:answer/id #uuid "2b7f7a56-c2fa-563d-86f3-153dc9a559ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247812} {:answer/id #uuid "6fb0ca6a-6e7d-5be2-a296-00215305046a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186248408} {:answer/id #uuid "80233ca3-002f-55a0-8bdc-2b037d6b344a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248550} {:answer/id #uuid "e1388f6d-652b-5848-82fd-8d5d7cf3f744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186249418}] :answer-field/correct {:answer/id #uuid "80233ca3-002f-55a0-8bdc-2b037d6b344a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248550} :answer-field/id #uuid "e8314377-9458-51fc-a186-1aac2e5c4562" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250072}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3db867c0-86fb-5b36-917d-09a549290c15" :question/math-academy-id "q-115736" :question/problem "The table below gives some values of a continuous function $f(x)$ on the closed interval $[-2,4].$ The right Riemann sum approximation to the area under the curve $y=f(x)$ with $3$ equal subintervals has a value of $22.$ What must be the value of $k?$\n\n| $x$ | $-2$ | $0$ | $2$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $3$ | $k$ | $5$ | $3$ |" :question/worked-solution "The area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overbrace{f(0)+f(2)+f(4)}^{\\text{heights}})\\cdot \\underbrace{Δx}_{\\text{width}}.\n$$\n\nLet's set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $k$ | $5$ | $3$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(k+5+3)\\cdot 2 \\\\  & =(k+8)\\cdot 2 \\\\  & =2k+16\\end{aligned}\n$$\n\nSince we are given that $A$ must be $22$, we obtain\n\n$$\n\\begin{aligned}2k+16 & =22 \\\\ 2k & =22-16 \\\\ k & =\\frac{6}{2} \\\\ k & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250476 :knowledge-point/_questions [{:db/id #edb/ref 17592186105814 :knowledge-point/id #uuid "01fe05cd-8acc-5676-9328-7a26362a77d0" :knowledge-point/title "Solving for an Unknown Given the Value of a Right Riemann Sum With Regular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4eeb850b-ff58-5266-ae1c-48acfae95b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248135} {:answer/id #uuid "65dffb96-2224-5586-b2d2-27be7c76ba68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186248341} {:answer/id #uuid "69d22ef8-d552-5bb1-9945-87d7159e72fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248369} {:answer/id #uuid "83265f7b-7dd9-5922-94c6-7cd88bf882ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186248584} {:answer/id #uuid "e77f3a13-cd75-5980-98ff-9e9ea80c2a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186249467}] :answer-field/correct {:answer/id #uuid "83265f7b-7dd9-5922-94c6-7cd88bf882ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186248584} :answer-field/id #uuid "63e12e2d-c268-57c6-8f72-8ce0f004bbc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249848}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da83e2f0-858c-5c9b-8c7c-d0635d7e101a" :question/math-academy-id "q-115737" :question/problem "The table below gives some values of a continuous function $f(x)$ on the closed interval $[-6,3].$ The right Riemann sum approximation to the area under the curve $y=f(x)$ with $3$ equal subintervals has a value of $6.$ What must be the value of $k?$\n\n| $x$ | $-6$ | $-3$ | $0$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $7$ | $5$ | $-2$ | $k$ |" :question/worked-solution "The area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overbrace{f(-3)+f(0)+f(3)}^{\\text{heights}})\\cdot \\underbrace{Δx}_{\\text{width}}.\n$$\n\nLet's set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $-3$ | $0$ | $3$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $5$ | $-2$ | $k$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(5+(-2)+k)\\cdot 3 \\\\  & =(k+3)\\cdot 3 \\\\  & =3k+9\\end{aligned}\n$$\n\nSince we are given that $A$ must be $6$, we obtain\n\n$$\n\\begin{aligned}3k+9 & =6 \\\\ 3k & =6-9 \\\\ k & =\\frac{-3}{3} \\\\ k & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253254 :knowledge-point/_questions [{:db/id #edb/ref 17592186092180 :knowledge-point/id #uuid "bec73486-156f-5124-97b4-58f65ea8430d" :knowledge-point/title "Using the Trapezoidal Rule With Irregular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c68d3b3-bfa0-555e-9fc6-8b730c50fe32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186251443} {:answer/id #uuid "7bf7f06a-9b53-512b-b8c5-0df50416db91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186251586} {:answer/id #uuid "a83cbc29-6959-534c-8462-e8290b065b10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186252006} {:answer/id #uuid "da65b8c8-95da-52e8-bb16-41f74f364106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186252471} {:answer/id #uuid "dac0614e-6504-5379-bcfb-b3e716fa8777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186252476}] :answer-field/correct {:answer/id #uuid "7bf7f06a-9b53-512b-b8c5-0df50416db91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186251586} :answer-field/id #uuid "211439b1-9068-5be0-80c4-19cfce9bdea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252864}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dab1908a-ed96-5f67-a8b2-41493fe7dc98" :question/math-academy-id "q-116296" :question/problem "Using the trapezoidal rule with the partition\n\n$$\n[1,5]=[1,2]\\cup [2,5],\n$$\n\napproximate the area under the curve of the continuous function $y=f(x)$ whose data is given in the table below.\n\n| $x$ | $1$ | $2$ | $5$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $1$ | $3$ | $7$ |" :question/worked-solution "Let's plot what this function might look like, using the values given in the table.\n\n![](images/8f/8fe84e0056eaa8320b4824740a259226b1a18ff1b64ba648d8740d6cac8703fc.png)\n\nWe've drawn some trapezoids to help calculate our trapezoidal rule sum. By calculating the area of each trapezoid, we obtain the following approximation for our area $A:$\n\n$$\nA≈\\overbrace{[\\,\\frac{\\overbrace{f(1)+f(2)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{1}}_{\\text{height}}\\,]}^{1\\text{st trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(2)+f(5)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{2}}_{\\text{height}}\\,]}^{2\\text{nd trapezoid}}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{1+3}{2}\\cdot (2-1)+\\frac{3+7}{2}\\cdot (5-2) \\\\  & =2\\cdot 1+5\\cdot 3 \\\\  & =2+15 \\\\  & =17.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253255 :knowledge-point/_questions [{:db/id #edb/ref 17592186092180 :knowledge-point/id #uuid "bec73486-156f-5124-97b4-58f65ea8430d" :knowledge-point/title "Using the Trapezoidal Rule With Irregular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "735748ee-a8f4-5955-aec8-129869926ccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186251503} {:answer/id #uuid "96039b1d-86e0-535a-af86-b71cbf7de115" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186251841} {:answer/id #uuid "b3aa686a-3313-54ed-b39d-439cefa4f903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186252129} {:answer/id #uuid "bbac8a44-c6c3-53c8-99e6-61569aea30f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186252204} {:answer/id #uuid "fb596aa9-597f-5870-80b0-3ef5bbe6d687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186252758}] :answer-field/correct {:answer/id #uuid "fb596aa9-597f-5870-80b0-3ef5bbe6d687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186252758} :answer-field/id #uuid "30e03666-5a92-5627-a4e9-d4f579effe33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6215941f-91c2-5319-8cbc-f79483d60df8" :question/math-academy-id "q-116300" :question/problem "Using the trapezoidal rule with the partition\n\n$$\n[-3,2]=[-3,-1]\\cup [-1,0]\\cup [0,2],\n$$\n\napproximate the area under the curve of the continuous function $y=f(x)$ whose data is given in the table below.\n\n| $x$ | $-3$ | $-1$ | $0$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $2$ | $4$ | $8$ | $6$ |" :question/worked-solution "Let's plot what this function might look like, using the values given in the table.\n\n![](images/25/25dc419eb5711b0d990909c611a6eacb2754285fb45dc0d969207e63dc09ba12.png)\n\nWe've drawn some trapezoids to help calculate our trapezoidal rule sum. By calculating the area of each trapezoid, we obtain the following approximation for our area $A:$\n\n$$\nA≈\\overbrace{[\\,\\frac{\\overbrace{f(-3)+f(-1)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{1}}_{\\text{height}}\\,]}^{1\\text{st trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(-1)+f(0)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{2}}_{\\text{height}}\\,]}^{2\\text{nd trapezoid}}+\\overbrace{[\\,\\frac{\\overbrace{f(0)+f(2)}^{\\text{bases}}}{2}\\,\\cdot \\,\\underbrace{Δ{x}_{3}}_{\\text{height}}\\,]}^{3\\text{rd trapezoid}}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{2+4}{2}\\cdot (-1-(-3))+\\frac{4+8}{2}\\cdot (0-(-1))+\\frac{8+6}{2}\\cdot (2-0) \\\\  & =3\\cdot 2+6\\cdot 1+7\\cdot 2 \\\\  & =6+6+14 \\\\  & =26\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253354 :knowledge-point/_questions [{:db/id #edb/ref 17592186100815 :knowledge-point/id #uuid "90a673b6-4025-5075-9a8a-120b90bc4f45" :knowledge-point/title "The Shortest Distance Between a Point and a Perpendicular Bisector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05263274-8a30-5b9e-99c8-bc4632800973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{7}{2},6)" :db/id #edb/ref 17592186250593} {:answer/id #uuid "26c93fc6-e7c9-527e-b808-8e8ae2deae84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186250886} {:answer/id #uuid "622a263a-6ba2-5b98-88d5-099953d3f597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,3)" :db/id #edb/ref 17592186251350} {:answer/id #uuid "8e5a5357-7eb2-5b78-bbad-edc691df5fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,\\frac{7}{2})" :db/id #edb/ref 17592186251758} {:answer/id #uuid "fd9086da-236a-59d4-9d03-b14bbfe51a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,\\frac{7}{2})" :db/id #edb/ref 17592186252777}] :answer-field/correct {:answer/id #uuid "fd9086da-236a-59d4-9d03-b14bbfe51a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,\\frac{7}{2})" :db/id #edb/ref 17592186252777} :answer-field/id #uuid "49dfe913-70a3-528c-b8ca-29e7f976f6c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252935}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8647f1c-5367-5a91-bc69-e78441ce9412" :question/math-academy-id "q-117463" :question/problem "Use calculus to find the closest point to $P(6,7)$ that is equidistant to the points $A(0,1)$ and $B(0,6).$" :question/worked-solution "Let's sketch the situation.\n\n![](images/c4/c4fd419e12879af4910e5d8364426c14342c3dadb970d8bbc43d31213a6ff947.png)\n\nNote the following:\n\n- The dotted line is the *perpendicular bisector* of the segment $\\overset{―}{AB}.$\n\n- All the points on this perpendicular bisector are equidistant to $A$ and $B.$\n\n- Our task is to find the point $Q$ on this line that's closest to $P.$\n\nFirst, we create a function $S$ which represents the *squared* distance between the point $P(6,7)$ and a general point $Q(x,y),$ as follows:\n\n$$\n\\begin{aligned}S(x,y) & =(x-6)^{2}+(y-7)^{2} \\\\  & ={x}^{2}+{y}^{2}-12x-14y+85\\end{aligned}\n$$\n\nThe required point $Q(x,y)$ is equidistant to the points $A(0,1)$ and $B(0,6).$ So, by writing down $(QA)^{2}=(QB)^{2},$ we have the following constraint equation:\n\n$$\n\\begin{aligned}\\underbrace{(x-0)^{2}+(y-1)^{2}}_{(QA)^{2}} & =\\underbrace{(x-0)^{2}+(y-6)^{2}}_{(QB)^{2}}\\end{aligned}\n$$\n\nWe make $y$ the subject in the constraint equation, as follows:\n\n$$\n\\begin{aligned}(x-0)^{2}+(y-1)^{2} & =(x-0)^{2}+(y-6)^{2} \\\\ {x}^{2}+{y}^{2}-2y+1 & ={x}^{2}+{y}^{2}-12y+36 \\\\ \\cancel{{x}^{2}}+\\cancel{{y}^{2}}-2y+1 & =\\cancel{{x}^{2}}+\\cancel{{y}^{2}}-12y+36 \\\\ 10y & =35 \\\\ y & =\\frac{7}{2}\\end{aligned}\n$$\n\nSubstituting the above into our expression for $S(x,y),$ we get\n\n$$\n\\begin{aligned}S(x) & ={x}^{2}+{y}^{2}-12x-14y+85 \\\\  & ={x}^{2}+{(\\frac{7}{2})}^{2}-12x-14(\\frac{7}{2})+85 \\\\  & ={x}^{2}-12x+\\frac{193}{4}.\\end{aligned}\n$$\n\nNow, we calculate the first derivative,\n\n$$\n\\begin{aligned}{S}^{′}(x) & =2x-12,\\end{aligned}\n$$\n\nand solve ${S}^{′}(x)=0$ to find the stationary point:\n\n$$\n\\begin{aligned}{S}^{′}(x) & =0 \\\\ 2x-12 & =0 \\\\ x & =6\\end{aligned}\n$$\n\nLet's verify that this stationary point is a minimum. Taking the second derivative, we find\n\n$$\n{S}^{″}(6)=2>0.\n$$\n\nWe conclude that the stationary point $x=6$ indeed minimizes the squared distance. \n\nFinally, the $y$-coordinate is\n\n$$\ny=\\frac{7}{2}.\n$$\n\nTherefore, the required point is $(6,\\frac{7}{2}).$"}] [{:db/id #edb/ref 17592186253393 :knowledge-point/_questions [{:db/id #edb/ref 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0d8c40-e836-501a-b0ba-42204041609f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186250674} {:answer/id #uuid "3e78795f-9f75-5123-ba79-d9d777165f60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186251072} {:answer/id #uuid "3ef48980-1a2f-5135-983c-8e5caa025c90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186251077} {:answer/id #uuid "b432cfe4-c9ad-53a6-a90c-5db1630f768f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186252134} {:answer/id #uuid "e695ae04-da14-58bc-b2c0-069f67bfa9c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186252571}] :answer-field/correct {:answer/id #uuid "e695ae04-da14-58bc-b2c0-069f67bfa9c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186252571} :answer-field/id #uuid "d6e50084-82f6-5f66-b808-7821227c488f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253174}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "485c2fdf-7dde-569e-8977-e58d8f5860bf" :question/math-academy-id "q-117680" :question/problem "![](images/a4/a433e9e9f2018c1f964f13b0ef248f72253f99f071f44e029c928598e9d04a32.png)\n\nThe graph of $y=f(x),$ shown above, consists of two line segments. Find the value of ${\\int }_{-4}^{2}f(x)\\,\\text{d}x.$" :question/worked-solution "The graph consists of two parts: the line segment for $x\\in [-4,0)$ and the line segment for $x\\in [0,2].$ Therefore, we can write the required integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-4}^{2}f(x)\\,\\text{d}x & ={\\int }_{-4}^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & =\\underbrace{{\\int }_{-4}^{0}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{0}^{2}f(x)\\,\\text{d}x}_{{A}_{2}}\\end{aligned}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-4,0).$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(4\\cdot 4) \\\\  & =8.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [0,2].$ The corresponding region is a square, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & ={s}^{2} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-4}^{2}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =8+4 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253401 :knowledge-point/_questions [{:db/id #edb/ref 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01eb53d6-55a8-542f-8163-5afe82f78270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186250571} {:answer/id #uuid "508d017e-b033-5327-85e5-ab0274ce911f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186251213} {:answer/id #uuid "a05ad30a-1ed4-55d8-8378-b7dbf575700d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186251936} {:answer/id #uuid "bbf1fd11-1928-5041-b1c9-06fb7edc1519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186252212} {:answer/id #uuid "bcc73ce0-d6f2-58f7-9cee-512addcd38fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252220}] :answer-field/correct {:answer/id #uuid "bbf1fd11-1928-5041-b1c9-06fb7edc1519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186252212} :answer-field/id #uuid "fc56aa86-a6fb-55a8-8dfc-3acc8e9fec8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d647eaf0-9519-521e-a229-1bff754ddbe0" :question/math-academy-id "q-117702" :question/problem "![](images/f7/f725b571954587b7b88426a254d7a6fc05f09b63ab2cc94b81303a510e8c1798.png)\n\nThe graph of $y=f(x),$ shown above, consists of two line segments. Find the value of ${\\int }_{-2}^{3}f(x)\\,\\text{d}x.$" :question/worked-solution "We divide the interval of integration into $3$ regions: the line segment for $x\\in [-2,0],$ the line segment for $x\\in [0,2),$ and the line segment for $x\\in [2,3].$ Therefore, we can write the required integral as follows:\n\n$$\n{\\int }_{-2}^{3}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-2}^{0}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{0}^{2}f(x)\\,\\text{d}x}_{-{A}_{2}}+\\underbrace{{\\int }_{2}^{3}f(x)\\,\\text{d}x}_{{A}_{3}}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,0].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [0,2).$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{0}^{2}f(x)\\,\\text{d}x=-{A}_{2}=-2.\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in [2,3].$ The corresponding region is a rectangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =bh \\\\  & =1\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}+{A}_{3} \\\\  & =2-2+2 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253405 :knowledge-point/_questions [{:db/id #edb/ref 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a25b06-d824-5579-bf60-2d2c4e45d9a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186250556} {:answer/id #uuid "7e767a49-c1bd-5566-8a4d-80d682dab01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186251615} {:answer/id #uuid "97a511f7-2a8d-5737-948b-58070b8fd816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251856} {:answer/id #uuid "b356ac98-e823-5f19-b0ba-a27840a19fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.5" :db/id #edb/ref 17592186252123} {:answer/id #uuid "dcfb57c0-e3ea-50c7-b3dc-b1dba4050fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186252499}] :answer-field/correct {:answer/id #uuid "00a25b06-d824-5579-bf60-2d2c4e45d9a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186250556} :answer-field/id #uuid "5a13fb81-d7bb-5742-9e3c-de58bdbfcea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b8467112-b8ce-58b8-acef-c1b741ea25db" :question/math-academy-id "q-117712" :question/problem "![](images/45/45e506d3b6d3a2ca1a9b16a061f5c081e10b8c578796d7d4a1dfab6e6f793520.png)\n\nThe graph of $y=f(x),$ shown above, consists of three line segments. Find the value of ${\\int }_{-5}^{4}f(x)\\,\\text{d}x.$" :question/worked-solution "We divide the interval of integration into $4$ regions: the line segment for $x\\in [-5,-3],$ the line segment for $x\\in [-3,-1],$ the line segment for $x\\in (-1,1),$ and the line segment for $x\\in [1,4].$ Therefore, we can write the required integral as follows:\n\n$$\n{\\int }_{-5}^{4}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-5}^{-3}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{-3}^{-1}f(x)\\,\\text{d}x}_{-{A}_{2}}+\\underbrace{{\\int }_{-1}^{1}f(x)\\,\\text{d}x}_{{A}_{3}}+\\underbrace{{\\int }_{1}^{4}f(x)\\,\\text{d}x}_{-{A}_{4}}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-5,-3].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,-1].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{-4}^{-1}f(x)\\,\\text{d}x=-{A}_{2}=-2.\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in (-1,1).$ The corresponding region is a square, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & ={s}^{2} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\n- The $4$th integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,4].$ The corresponding region is a triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{4} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(3\\cdot 3) \\\\  & =4.5.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{1}^{4}f(x)\\,\\text{d}x=-{A}_{4}=-4.5.\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-5}^{4}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}+{A}_{3}-{A}_{4} \\\\  & =2-2+4-4.5 \\\\  & =-0.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253439 :knowledge-point/_questions [{:db/id #edb/ref 17592186078599 :knowledge-point/id #uuid "fb30dbbf-4f83-59d0-b712-f0e592aafb27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Curved Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "721512bb-2bde-57bb-b932-24e128f60f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\pi " :db/id #edb/ref 17592186251488} {:answer/id #uuid "8f49171f-aea5-5a6a-9c38-96d14b4ad811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-2\\pi " :db/id #edb/ref 17592186251767} {:answer/id #uuid "969639cd-aaa2-5c67-8dcd-2100c64d522a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-2\\pi " :db/id #edb/ref 17592186251844} {:answer/id #uuid "9f698edf-4ba1-5146-b2d0-014a1755d461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186251926} {:answer/id #uuid "ead1ee20-fcf9-5f35-999b-d0ef32a9970c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186252609}] :answer-field/correct {:answer/id #uuid "8f49171f-aea5-5a6a-9c38-96d14b4ad811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-2\\pi " :db/id #edb/ref 17592186251767} :answer-field/id #uuid "a03e472b-d2c2-5eeb-99f6-37d934951c2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253088}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82d0e533-71c5-5fce-ba0e-f6b94cbcf3f4" :question/math-academy-id "q-117985" :question/problem "![](images/03/03a826b548db2731a6854327d6e11dcc5147d5c21db93f0b17b6b131e5163efc.png)\n\nGiven the graph of $y=f(x)$ above, find the value of \n${\\int }_{-5}^{5}f(x)\\,\\text{d}x.$" :question/worked-solution "The graph consists of $3$ parts: the line segment for $x\\in [-5,-1],$ the arc of the semi-circle for $x\\in [-1,3],$ and the line segment for $x\\in (3,5].$ So, we can use the additive property of integrals to get\n\n$$\n{\\int }_{-5}^{5}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-5}^{-1}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{-1}^{3}f(x)\\,\\text{d}x}_{-{A}_{2}}+\\underbrace{{\\int }_{3}^{5}f(x)\\,\\text{d}x}_{-{A}_{3}}.\n$$\n\nThe $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-5,-1].$ The corresponding region is a triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(4\\cdot 4) \\\\  & =8.\\end{aligned}\n$$\n\nThe $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-1,3].$ The corresponding region is a semi-circle of radius of $2,$ so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot {2}^{2} \\\\  & =2\\pi .\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{-1}^{3}f(x)\\,\\text{d}x=-{A}_{2}=-2\\pi .\n$$\n\nThe $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in (3,5].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{3}^{5}f(x)\\,\\text{d}x=-{A}_{3}=-2.\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-5}^{5}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}-{A}_{3} \\\\  & =8-2\\pi -2 \\\\  & =6-2\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253527 :knowledge-point/_questions [{:db/id #edb/ref 17592186073814 :knowledge-point/id #uuid "d4e178c7-bdb4-5139-a20c-3e17de51ee11" :knowledge-point/title "Calculating the Distance Between Two Points With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "182fce35-90f9-5b64-8131-1ce2dd077c7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186250765} {:answer/id #uuid "7804f14a-b954-5757-9be5-01960535cd99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 9" :db/id #edb/ref 17592186251546} {:answer/id #uuid "81adba09-f017-5ae0-9087-0a28870ff4a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 6" :db/id #edb/ref 17592186251646} {:answer/id #uuid "c27a54a9-3be4-5d2c-bf2e-5d7caabd09a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3" :db/id #edb/ref 17592186252270} {:answer/id #uuid "d79bbf5c-a41e-5fea-bb6c-c8a94c3cd56c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186252464}] :answer-field/correct {:answer/id #uuid "7804f14a-b954-5757-9be5-01960535cd99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 9" :db/id #edb/ref 17592186251546} :answer-field/id #uuid "7a6a000c-da7c-5c21-8009-bffa0d6fef74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253017}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59b25335-7529-5e36-aa78-a4fb3b713907" :question/math-academy-id "q-118944" :question/problem "Consider the points $A(-3s,-4s,7s)$ and $B(s,-6s,3s).$ Given that the distance between $A$ and $B$ is $54,$ find the possible values of $s.$" :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nIn this case, we have $A\\underbrace{(-3s,-4s,7s)}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B\\underbrace{(s,-6s,3s)}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(s-(-3s))^{2}+(-6s-(-4s))^{2}+(3s-7s)^{2}} \\\\  & =\\sqrt{(4s)^{2}+(-2s)^{2}+(-4s)^{2}} \\\\  & =\\sqrt{16{s}^{2}+4{s}^{2}+16{s}^{2}} \\\\  & =\\sqrt{36{s}^{2}} \\\\  & =6\\,|s|.\\end{aligned}\n$$\n\nFinally, since $d=54,$ we get\n\n$$\n\\begin{aligned}6\\,|s| & =54 \\\\ |s| & =9 \\\\ s & =\\pm 9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259598 :knowledge-point/_questions [{:db/id #edb/ref 17592186179767 :knowledge-point/id #uuid "8ba09dd1-d219-5df2-adfa-d88d7b9fc481" :knowledge-point/title "Finding the Image of a Point or Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a247570-99dc-5085-836a-45a5b7044959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-5)" :db/id #edb/ref 17592186256873} {:answer/id #uuid "0cca350b-7424-5703-b097-455a85de0f96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186256906} {:answer/id #uuid "4ecd2b3c-21b4-54d4-a622-d1ce8a4744ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-5)" :db/id #edb/ref 17592186257457} {:answer/id #uuid "502d5162-dc5b-5752-a4c7-ab2fb4a833a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,4)" :db/id #edb/ref 17592186257468} {:answer/id #uuid "fe8917fb-9a45-5e60-9e72-5bd3e93adf32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,5)" :db/id #edb/ref 17592186259015}] :answer-field/correct {:answer/id #uuid "502d5162-dc5b-5752-a4c7-ab2fb4a833a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,4)" :db/id #edb/ref 17592186257468} :answer-field/id #uuid "d77e0cc2-f0a5-50f9-bcfe-54ea8d613140" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259411}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1f2af36-2cc7-54c9-8c5f-1fbb3c54f92a" :question/math-academy-id "q-124144" :question/problem "Consider the transformation $T$ defined as\n\n$$\nx=-v+u+2,\\,y=u+v-1.\n$$\n\nLet $P(4,1)$ be a point in the $uv$-plane. Suppose that the image of $P$ under the action of $T$ is the point ${P}^{′}$ in the $xy$-plane. What are the coordinates of ${P}^{′}?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}-v+u+2 \\\\ u+v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}u-v \\\\ u+v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nNow, to find the image of $P$ under the action of $T,$ we first create a column vector $u$ containing the coordinates of $P:$\n\n$$\nu=\\begin{bmatrix}4 \\\\ 1\\end{bmatrix}.\n$$\n\nApplying $T$ to $u,$ we get\n\n$$\n\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}.\n$$\n\nTherefore, the coordinates of ${P}^{′}$ are $(5,4).$"}] [{:db/id #edb/ref 17592186259599 :knowledge-point/_questions [{:db/id #edb/ref 17592186179767 :knowledge-point/id #uuid "8ba09dd1-d219-5df2-adfa-d88d7b9fc481" :knowledge-point/title "Finding the Image of a Point or Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55580105-2405-5804-bb67-aab56c22114f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/ac6a03b4ef408f0f8b5cd6945ffa606eb948962330e5efd9005ff9fe199ad465.png" :db/id #edb/ref 17592186257513} {:answer/id #uuid "713c9840-2c73-537f-8c55-a6743f6ca6e2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/38a060b98b529dbf687f9aab45d94545e7d83533fe73027b543cb7a88d914d72.png" :db/id #edb/ref 17592186257777} {:answer/id #uuid "97cab163-5be6-5bf4-84a6-2e29ebfe3a9d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e4/e4bea3edd3fcde575e68e36e08fc4186863b12450802eb0ee37c841975983486.png" :db/id #edb/ref 17592186258120} {:answer/id #uuid "9dfe2ca4-26da-5bac-ab48-ff93c1e4770f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/37ba7b2e9b6f84d4a928cb18c5fb9c7a2cbaf6a564cc17b0c9cf8656e6970bf7.png" :db/id #edb/ref 17592186258171} {:answer/id #uuid "fe351807-7527-533e-8959-57e109008cfe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/ca23324a1f9e69156fd2752d599ef4d1331dd61ec81f61a44434f778b918fd1d.png" :db/id #edb/ref 17592186259010}] :answer-field/correct {:answer/id #uuid "97cab163-5be6-5bf4-84a6-2e29ebfe3a9d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e4/e4bea3edd3fcde575e68e36e08fc4186863b12450802eb0ee37c841975983486.png" :db/id #edb/ref 17592186258120} :answer-field/id #uuid "f6013fdd-9e1d-5922-a473-e3b9ba3a3cc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259464}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02e13286-8600-5387-b2b8-d8f440c7b1cc" :question/math-academy-id "q-124151" :question/problem "![](images/33/33f7326ffe8318fca915e8cc7e02a2a4c280dd9377066f1870f3bb8067b22eb0.png)\n\nConsider the segment $\\overset{―}{PQ}$ above, and the transformation $T$ defined as\n\n$$\nx=2u+3v+2,\\,y=v-2u.\n$$\n\nThe image of $\\overset{―}{PQ}$ under the action of $T$ is the segment $\\overset{―}{{P}^{′}{Q}^{′}}$ in the $xy$-plane. Which of the following diagrams shows $\\overset{―}{{P}^{′}{Q}^{′}}?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that we can express the given transformation as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u+3v+2 \\\\ v-2u\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\,2u+3v \\\\ -2u+v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}2 & 3 \\\\ -2 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nThe transformation $T$ maps the endpoints of $\\overset{―}{PQ}$ to the endpoints of $\\overset{―}{{P}^{′}{Q}^{′}}.$ So, to find the image of $\\overset{―}{PQ},$ we find the images of each endpoint.\n\nTo quickly carry out this calculation, we set up the following matrices:\n\n- The matrix $U$ containing the endpoints of our segment:\n\n$$\nU=\\begin{bmatrix}-2 & 1 \\\\ -1 & 2\\end{bmatrix}\n$$\n\n- The matrix $B$ that has the same shape as $U$ and with the vector $b$ in each column:\n\n$$\nB=\\begin{bmatrix}2 & 2 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nThe image of $u$ under $T$ is given by $Au+b.$ So, by applying $T$ to $U,$ we get\n\n$$\n\\begin{aligned}AU+B & =\\begin{bmatrix}2 & 3 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ -1 & 2\\end{bmatrix}+\\begin{bmatrix}2 & 2 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7 & 8 \\\\ 3 & 0\\end{bmatrix}+\\begin{bmatrix}2 & 2 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 10 \\\\ 3 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the endpoints of the image in the $xy$-plane are $(-5,3)$ and $(10,0).$\n\nDrawing this segment in the $xy$-plane, we get the following: \n\n![](images/e4/e4bea3edd3fcde575e68e36e08fc4186863b12450802eb0ee37c841975983486.png)"}] [{:db/id #edb/ref 17592186259600 :knowledge-point/_questions [{:db/id #edb/ref 17592186179767 :knowledge-point/id #uuid "8ba09dd1-d219-5df2-adfa-d88d7b9fc481" :knowledge-point/title "Finding the Image of a Point or Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34be3046-e720-5a4a-8add-c1b8f1e7331b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11,17)" :db/id #edb/ref 17592186257247} {:answer/id #uuid "4d399ccd-e053-57f7-b31a-15fbe99e1c1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-7)" :db/id #edb/ref 17592186257445} {:answer/id #uuid "647275f4-8f37-507d-bbd7-49a146debf1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,23)" :db/id #edb/ref 17592186257664} {:answer/id #uuid "a02a8b98-e576-5f8d-8a06-fc80683c0ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-17)" :db/id #edb/ref 17592186258187} {:answer/id #uuid "d55d986a-819e-5b89-ac89-876d4415d5f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11,-23)" :db/id #edb/ref 17592186258652}] :answer-field/correct {:answer/id #uuid "a02a8b98-e576-5f8d-8a06-fc80683c0ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-17)" :db/id #edb/ref 17592186258187} :answer-field/id #uuid "0446696b-4614-5099-bcb1-87357c45d586" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5dd167d-b815-5ffc-9ae4-cf52473638b6" :question/math-academy-id "q-124156" :question/problem "Consider the transformation $T$ defined as\n\n$$\nx=3v+u,\\,y=u-6v+3.\n$$\n\nLet $P(-2,3)$ be a point in the $uv$-plane. Suppose that the image of $P$ under the action of $T$ is the point ${P}^{′}$ in the $xy$-plane. What are the coordinates of ${P}^{′}?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}3v+u \\\\ u-6v+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+3v \\\\ u-6v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & 3 \\\\ 1 & -6\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nNow, to find the image of $P$ under the action of $T,$ we first create a column vector $u$ containing the coordinates of $P:$\n\n$$\nu=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.\n$$\n\nApplying $T$ to $u,$ we get\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 1 & -6\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}7 \\\\ -17\\end{bmatrix}.\n$$\n\nTherefore, the coordinates of ${P}^{′}$ are $(7,-17).$"}] [{:db/id #edb/ref 17592186259607 :knowledge-point/_questions [{:db/id #edb/ref 17592186179767 :knowledge-point/id #uuid "8ba09dd1-d219-5df2-adfa-d88d7b9fc481" :knowledge-point/title "Finding the Image of a Point or Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2075e4c0-3759-51c4-95ee-65cc67eda3bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e57b4d47ef3c6ad1b1d70a97126aa865c4481ee67e16eaf4e79c09e3146b30d.png" :db/id #edb/ref 17592186257044} {:answer/id #uuid "60afae15-64c5-5264-9c02-100950694994" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/43f482344220e14c9633691ca880da0b310ece86779841ad4bac909c230dafa3.png" :db/id #edb/ref 17592186257631} {:answer/id #uuid "7cb08404-1a9c-50ff-be4e-1e61af0d0ce8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/44/449acd0aaaf07a8116faf0fee0936751bd375dd7eb270fd7c4adee3e381c8641.png" :db/id #edb/ref 17592186257881} {:answer/id #uuid "dc95d36b-dde6-50b5-8386-1eff524fc3b1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/94/947907e5a3581626420616f119cc126c08718a7d4c9323032fa3e1774dcc9537.png" :db/id #edb/ref 17592186258704} {:answer/id #uuid "e479deed-9e77-594e-9b45-31059e53f9f8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/29/299dcfa34c32c5e51c78b585514308806dab67fd3c9f5d3d80e492b3e424960d.png" :db/id #edb/ref 17592186258766}] :answer-field/correct {:answer/id #uuid "2075e4c0-3759-51c4-95ee-65cc67eda3bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e57b4d47ef3c6ad1b1d70a97126aa865c4481ee67e16eaf4e79c09e3146b30d.png" :db/id #edb/ref 17592186257044} :answer-field/id #uuid "11b3908c-5a30-50b8-93ef-03d1bdb67e7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259064}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e89e4f1-f018-5737-8c5b-79e211b0f9fe" :question/math-academy-id "q-124178" :question/problem "![](images/af/afc9e81f3294803794ba0d62773958913cf7475a0718e77052212a149050aecf.png)\n\nConsider the segment $\\overset{―}{PQ}$ above, and the transformation $T$ defined as\n\n$$\nx=2u+2v-2,\\,y=v-u+2.\n$$\n\nThe image of $\\overset{―}{PQ}$ under the action of $T$ is the segment $\\overset{―}{{P}^{′}{Q}^{′}}$ in the $xy$-plane. Which of the following diagrams shows $\\overset{―}{{P}^{′}{Q}^{′}}?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that we can express the given transformation as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u+2v-2 \\\\ v-u+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u+2v \\\\ -u+v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}2 & 2 \\\\ -1 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nThe transformation $T$ maps the endpoints of $\\overset{―}{PQ}$ to the endpoints of $\\overset{―}{{P}^{′}{Q}^{′}}.$ So, to find the image of $\\overset{―}{PQ},$ we find the images of each endpoint.\n\nTo quickly carry out this calculation, we set up the following matrices:\n\n- The matrix $U$ containing the endpoints of our segment:\n\n$$\nU=\\begin{bmatrix}-1 & 3 \\\\ -1 & 2\\end{bmatrix}\n$$\n\n- The matrix $B$ that has the same shape as $U$ and with the vector $b$ in each column:\n\n$$\nB=\\begin{bmatrix}-2 & -2 \\\\ 2 & 2\\end{bmatrix}\n$$\n\nThe image of $u$ under $T$ is given by $Au+b.$ So, by applying $T$ to $U,$ we get\n\n$$\n\\begin{aligned}AU+B & =\\begin{bmatrix}2 & 2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}-1 & 3 \\\\ -1 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & -2 \\\\ 2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 10 \\\\ 0 & -1\\end{bmatrix}+\\begin{bmatrix}-2 & -2 \\\\ 2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 8 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the endpoints of the image in the $xy$-plane are $(-6,2)$ and $(8,1).$\n\nDrawing this segment in the $xy$-plane, we get the following:\n\n![](images/8e/8e57b4d47ef3c6ad1b1d70a97126aa865c4481ee67e16eaf4e79c09e3146b30d.png)"}] [{:db/id #edb/ref 17592186259616 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c59e1d-3aed-5da5-920b-29c76019c43a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448116} {:answer/id #uuid "65846218-0157-5d80-8b43-2067671bbc03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448117}] :answer-field/correct {:answer/id #uuid "54c59e1d-3aed-5da5-920b-29c76019c43a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448116} :answer-field/id #uuid "0fa076dd-8abf-59ea-9d79-6e4ebe730fb3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449098} {:answer-field/choices [{:answer/id #uuid "156e6ee8-01e7-5772-b147-fd55c7d3c214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448118} {:answer/id #uuid "51c116a2-fae9-567e-95e7-40ff22cbaba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448119}] :answer-field/correct {:answer/id #uuid "51c116a2-fae9-567e-95e7-40ff22cbaba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448119} :answer-field/id #uuid "edd5c395-ce4f-5039-81bb-88e680e6bc71" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449099} {:answer-field/choices [{:answer/id #uuid "d725b57b-1d7c-5344-ba8b-e298e326a6c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448120} {:answer/id #uuid "4043b8e8-4044-5bab-95d2-94eb0591fd0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448121}] :answer-field/correct {:answer/id #uuid "d725b57b-1d7c-5344-ba8b-e298e326a6c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448120} :answer-field/id #uuid "27bc06ab-a2f6-5b10-9434-da9802d98339" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449100}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0a1ba57-9eac-5d49-9cdd-f7f25fec8c92" :question/math-academy-id "q-124192" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=2v+u+1,\\,y=u-v-2.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A=\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}$\n- **II.** $det(A)=-3$\n- **III.** The transformation $T$ is orientation-preserving" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2v+u+1 \\\\ u-v-2\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+2v \\\\ u-v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}.$\n\n- Statement II is true. Indeed, computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}1 & 2 \\\\ 1 & -1\\end{vmatrix}=1\\cdot (-1)-2\\cdot 1=-3.\n$$\n\n- Statement III is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186259618 :knowledge-point/_questions [{:db/id #edb/ref 17592186179770 :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/title "Identifying Invertible Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "339e8e64-9356-52e6-b8e5-4bc0a3bef99d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257238} {:answer/id #uuid "64e1df3e-a7f1-5dc7-a307-f5d4104c7ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186257667} {:answer/id #uuid "83389cc9-94ff-5bc4-b38c-6f000223c647" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257943} {:answer/id #uuid "b2fc735b-362f-5cbb-b6ef-45b3c94f8a9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186258339} {:answer/id #uuid "cde11d91-78bf-5001-82d0-1c36acaf93ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ only" :db/id #edb/ref 17592186258565}] :answer-field/correct {:answer/id #uuid "64e1df3e-a7f1-5dc7-a307-f5d4104c7ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186257667} :answer-field/id #uuid "d2ce2651-e7b5-5d4c-82da-81b59ed6577a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72479cb8-eb92-5b20-8e4e-e8b5aa32f2b9" :question/math-academy-id "q-124210" :question/problem "Which of the following affine transformations are invertible?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}5u-2v-5 \\\\ 10u-4v+1\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u-v-4 \\\\ u+5v+7\\end{bmatrix}$\n- ${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}2u+4v-2 \\\\ 3u+6v+3\\end{bmatrix}$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nThe transformation is invertible if the matrix $A$ is invertible. That is, if $det(A)\\ne 0.$\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is not invertible. Notice that ${T}_{1}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}5u-2v-5 \\\\ 10u-4v+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5u-2v \\\\ 10u-4v\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}5 & -2 \\\\ 10 & -4\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nComputing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}5 & -2 \\\\ 10 & -4\\end{vmatrix}=-4\\cdot 5-(-2)\\cdot 10=0.\n$$\n\nSince the determinant is zero, ${T}_{1}$ is *not* invertible.\n\n- Transformation ${T}_{2}$ is invertible. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u-v-4 \\\\ u+5v+7\\end{bmatrix} \\\\  & =\\begin{bmatrix}u-v \\\\ u+5v\\end{bmatrix}+\\begin{bmatrix}-4 \\\\ 7\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & -1 \\\\ 1 & 5\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-4 \\\\ 7\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nComputing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}1 & -1 \\\\ 1 & 5\\end{vmatrix}=5\\cdot 1-(-1)\\cdot 1=6\\ne 0.\n$$\n\nSince the determinant is nonzero, ${T}_{2}$ is invertible.\n\n- Transformation ${T}_{3}$ is not invertible. Notice that ${T}_{3}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u+4v-2 \\\\ 3u+6v+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u+4v \\\\ 3u+6v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}2 & 4 \\\\ 3 & 6\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nComputing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}2 & 4 \\\\ 3 & 6\\end{vmatrix}=6\\cdot 2-4\\cdot 3=0.\n$$\n\nSince the determinant is zero, ${T}_{3}$ is *not* invertible.\n\nTherefore, the correct answer is \"${T}_{2}$ only.\""}] [{:db/id #edb/ref 17592186259620 :knowledge-point/_questions [{:db/id #edb/ref 17592186179770 :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/title "Identifying Invertible Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34bfe153-da06-5e91-af3f-09f4545070dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448128} {:answer/id #uuid "3edad985-cc26-5a5e-af3e-6700e60c71ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448129}] :answer-field/correct {:answer/id #uuid "34bfe153-da06-5e91-af3f-09f4545070dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448128} :answer-field/id #uuid "eadb4e27-873a-5521-888f-69f05d97b5e2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449104} {:answer-field/choices [{:answer/id #uuid "2ba40652-c044-55c4-8a94-35b541239ded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448130} {:answer/id #uuid "947b203f-00c8-5eca-95c1-efce409088a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448131}] :answer-field/correct {:answer/id #uuid "947b203f-00c8-5eca-95c1-efce409088a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448131} :answer-field/id #uuid "00944724-9959-5392-a192-85f20e1ec85e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449105} {:answer-field/choices [{:answer/id #uuid "20afd0a3-b0c0-5791-b565-fc7e5b831524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448132} {:answer/id #uuid "9dda385e-2665-5c6a-93bd-f8b119850f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448133}] :answer-field/correct {:answer/id #uuid "9dda385e-2665-5c6a-93bd-f8b119850f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448133} :answer-field/id #uuid "36adaa95-128f-5bfd-b7a0-fecb70c1d1da" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3230d0ef-3334-5e9c-bc28-426c4388c6b0" :question/math-academy-id "q-124213" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=2u-6v-2,\\,y=5v-u+9.\n$$\n\nSuppose that $A$ is the matrix that represents the linear transformation associated with $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A=\\begin{bmatrix}2 & -6 \\\\ 5 & -1\\end{bmatrix}$\n- **II.** $det(A)=4$\n- **III.** The transformation is invertible" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. The given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u-6v-2 \\\\ 5v-u+9\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u-6v \\\\ -u+5v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 9\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}2 & -6 \\\\ -1 & 5\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ 9\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=\\begin{bmatrix}2 & -6 \\\\ -1 & 5\\end{bmatrix}\\ne \\begin{bmatrix}2 & -6 \\\\ 5 & -1\\end{bmatrix}.\n$$\n\n- Statement II is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}2 & -6 \\\\ -1 & 5\\end{vmatrix}=5\\cdot 2-(-6)\\cdot (-1)=4\\ne 0.\n$$\n\n- Statement III is true. Since $det(A)\\ne 0,$ the affine transformation is invertible.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186259621 :knowledge-point/_questions [{:db/id #edb/ref 17592186179770 :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/title "Identifying Invertible Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1daaab98-cbe8-5352-bacb-b5473639f7d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448134} {:answer/id #uuid "61d8fcde-639e-51e8-ad9a-369bc099832e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448135}] :answer-field/correct {:answer/id #uuid "61d8fcde-639e-51e8-ad9a-369bc099832e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448135} :answer-field/id #uuid "e8bf1e46-3b2c-510e-8fc9-4a0cac9760b0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449107} {:answer-field/choices [{:answer/id #uuid "441c54c9-8ecc-5a18-9ccb-3f4010752b83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448136} {:answer/id #uuid "6a4e6a4b-8eb3-565f-a9a9-d81923448b30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448137}] :answer-field/correct {:answer/id #uuid "441c54c9-8ecc-5a18-9ccb-3f4010752b83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448136} :answer-field/id #uuid "3cf33e0a-cba5-5662-8a21-99a57c476012" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449108} {:answer-field/choices [{:answer/id #uuid "eb140b7e-c87d-5f72-9d09-3e36fca1601a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448138} {:answer/id #uuid "e8389ee7-d6c3-5f91-8889-ed2eee89b8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448139}] :answer-field/correct {:answer/id #uuid "eb140b7e-c87d-5f72-9d09-3e36fca1601a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448138} :answer-field/id #uuid "eb21737e-2666-5ebe-87e7-f10521798b5a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449109}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67b5699e-cde1-5170-92cc-4d8a2c62f657" :question/math-academy-id "q-124215" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=8u-6v+2,\\,y=4u-3v-1.\n$$\n\nSuppose that $A$ is the matrix that represents the linear transformation associated with $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A=\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}$\n- **II.** $det(A)=1$\n- **III.** The transformation is invertible" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is true. The given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}8u-6v+2 \\\\ 4u-3v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8u-6v \\\\ 4u-3v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}.\n$$\n\n- Statement II is false. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}8 & -6 \\\\ 4 & -3\\end{vmatrix}=(-3)\\cdot 8-(-6)\\cdot 4=0.\n$$\n\n- Statement III is false. Since $det(A)=0,$ the affine transformation is *not* invertible.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186259623 :knowledge-point/_questions [{:db/id #edb/ref 17592186179770 :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/title "Identifying Invertible Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d8644aa-30c8-5f84-95f8-591ae101f520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448140} {:answer/id #uuid "7d56c5c8-75e5-5ea5-96ad-cda45dad43a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448141}] :answer-field/correct {:answer/id #uuid "8d8644aa-30c8-5f84-95f8-591ae101f520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448140} :answer-field/id #uuid "2e36209e-566c-514f-b7e4-aaee36041867" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449110} {:answer-field/choices [{:answer/id #uuid "ea2f9e42-7bf6-5f40-9368-3dda1b852ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448142} {:answer/id #uuid "73d58032-ea3b-55f4-8461-e52c44559040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448143}] :answer-field/correct {:answer/id #uuid "73d58032-ea3b-55f4-8461-e52c44559040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448143} :answer-field/id #uuid "29e9de89-bea2-5bee-8fc7-7e275041411e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449111} {:answer-field/choices [{:answer/id #uuid "c502c020-a561-562e-9709-4015d249e451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448144} {:answer/id #uuid "e3628c3d-6abc-5c9d-9e38-4a53a7f3c693" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448145}] :answer-field/correct {:answer/id #uuid "c502c020-a561-562e-9709-4015d249e451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448144} :answer-field/id #uuid "c90de5ac-5ad0-5d21-bc0b-30dee157da82" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8f35619-da30-55db-920a-269c9cc6d2af" :question/math-academy-id "q-124219" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=4u+2v-5,\\,y=2u+v+6.\n$$\n\nSuppose that $A$ is the matrix that represents the linear transformation associated with $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A=\\begin{bmatrix}4 & -5 \\\\ 2 & 6\\end{bmatrix}$\n- **II.** $det(A)=0$\n- **III.** The transformation is invertible" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. The given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4u+2v-5 \\\\ 2u+v+6\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u+2v \\\\ 2u+v\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 6\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-5 \\\\ 6\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\\ne \\begin{bmatrix}4 & -5 \\\\ 2 & 6\\end{bmatrix}.\n$$\n\n- Statement II is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}4 & 2 \\\\ 2 & 1\\end{vmatrix}=1\\cdot 4-2\\cdot 2=0.\n$$\n\n- Statement III is false. Since $det(A)=0,$ the affine transformation is *not* invertible.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186259625 :knowledge-point/_questions [{:db/id #edb/ref 17592186179771 :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "709e3e28-43f0-5774-9967-f2a77296b518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186257772} {:answer/id #uuid "7a5307ee-7945-53c6-8b5c-e3c7b40d7f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257864} {:answer/id #uuid "d4a72ca3-839f-596e-9ba3-db4dee4a50f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186258642} {:answer/id #uuid "deb6b58c-00ac-51db-9e70-4039e8ace72e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258721} {:answer/id #uuid "e7ff2522-63f2-5ecd-8947-0cdfd4cb6b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186258792}] :answer-field/correct {:answer/id #uuid "deb6b58c-00ac-51db-9e70-4039e8ace72e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258721} :answer-field/id #uuid "fed49f22-b423-5b9a-b990-ba7eb27d6825" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c388fe2c-958c-51fb-bcca-cd64f6bc965e" :question/math-academy-id "q-124224" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-9 & 2 \\\\ 4 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}5 \\\\ 0\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}-1 & -2 \\\\ a & b\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}5 \\\\ c\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n\\underbrace{\\begin{bmatrix}-9 & 2 \\\\ 4 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}5 \\\\ 0\\end{bmatrix}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-1\\cdot (-9)-2\\cdot 4}\\begin{bmatrix}-1 & -2 \\\\ -4 & -9\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -2 \\\\ -4 & -9\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}-1 & -2 \\\\ -4 & -9\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}5 \\\\ 0\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}-1 & -2 \\\\ -4 & -9\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-1 & -2 \\\\ -4 & -9\\end{bmatrix}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -2 \\\\ -4 & -9\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-5 \\\\ -20\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -2 \\\\ -4 & -9\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}5 \\\\ 20\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-4+(-9)+20=7.\n$$"}] [{:db/id #edb/ref 17592186259626 :knowledge-point/_questions [{:db/id #edb/ref 17592186179771 :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a8b2e4c-71f4-525e-882c-30ff8c65e625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186257299} {:answer/id #uuid "6713e9ff-c15a-5839-bf29-fa79fff395dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186257695} {:answer/id #uuid "6d6d52a8-e329-53f2-9470-69f201f764c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257744} {:answer/id #uuid "db338955-c82e-5393-9733-8fbd662c8303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186258696} {:answer/id #uuid "dc799e2e-0aae-57e8-a311-8b305ba143a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186258703}] :answer-field/correct {:answer/id #uuid "6d6d52a8-e329-53f2-9470-69f201f764c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257744} :answer-field/id #uuid "837832a8-e75c-560a-ae2c-b1843afa6adc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51a6b16d-03c2-54f1-bf60-c27ba81220b5" :question/math-academy-id "q-124228" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 & -2 \\\\ -4 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & -2 \\\\ -4 & b\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}4 \\\\ c\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n\\underbrace{\\begin{bmatrix}1 & -2 \\\\ -4 & 7\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{7\\cdot 1-(-2)\\cdot (-4)}\\begin{bmatrix}7 & 2 \\\\ 4 & 1\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}7 & 2 \\\\ 4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7 & -2 \\\\ -4 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}-7 & -2 \\\\ -4 & -1\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}-7 & -2 \\\\ -4 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-7 & -2 \\\\ -4 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7 & -2 \\\\ -4 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-4 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7 & -2 \\\\ -4 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-7+(-1)+3=-5.\n$$"}] [{:db/id #edb/ref 17592186259627 :knowledge-point/_questions [{:db/id #edb/ref 17592186179771 :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "230f2aa5-5999-5f94-81da-ff99e017fcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186257075} {:answer/id #uuid "a7f5d663-08ba-529e-a9b0-b20649579658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258246} {:answer/id #uuid "aa6d8cde-1750-5619-92e0-27d3fb736abc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186258270} {:answer/id #uuid "c8dcd804-627c-578e-97b8-8c35bf749494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186258532} {:answer/id #uuid "cd39fdab-66f5-547e-a48b-b4bd6e8c2f26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258558}] :answer-field/correct {:answer/id #uuid "aa6d8cde-1750-5619-92e0-27d3fb736abc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186258270} :answer-field/id #uuid "2d04550f-6b5c-54b1-be4f-ac4b968f5edf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b78a55d2-3785-51af-884f-94f7cfac3449" :question/math-academy-id "q-124233" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4 & 2 \\\\ -5 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & -1 \\\\ b & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ c\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n\\underbrace{\\begin{bmatrix}-4 & 2 \\\\ -5 & 2\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot (-4)-2\\cdot (-5)}\\begin{bmatrix}2 & -2 \\\\ 5 & -4\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -2 \\\\ 5 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ \\frac{5}{2} & -2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}1 & -1 \\\\ \\frac{5}{2} & -2\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}1 & -1 \\\\ \\frac{5}{2} & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}1 & -1 \\\\ \\frac{5}{2} & -2\\end{bmatrix}\\begin{bmatrix}0 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ \\frac{5}{2} & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ \\frac{5}{2} & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+\\frac{5}{2}+(-2)=\\frac{3}{2}.\n$$"}] [{:db/id #edb/ref 17592186259629 :knowledge-point/_questions [{:db/id #edb/ref 17592186179771 :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6347f5f0-9e16-5206-aff9-2c2763ded762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257657} {:answer/id #uuid "945359d7-fb4c-5dc5-b2a6-bb81fdb84705" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258090} {:answer/id #uuid "c91b887a-085e-55d3-a82d-f0f2a9ebbd18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186258534} {:answer/id #uuid "cb0c3b3c-a63e-56f7-adf1-6c30a48415eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258544} {:answer/id #uuid "df8ff073-69ba-50cc-bc91-0935eff1238a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258729}] :answer-field/correct {:answer/id #uuid "6347f5f0-9e16-5206-aff9-2c2763ded762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257657} :answer-field/id #uuid "32802996-0705-5f7c-88e9-ff4e636541d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259124}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5caf03b-dafd-5e12-a099-434c9d099a24" :question/math-academy-id "q-124235" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 & 2 \\\\ 4 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-4 \\\\ 7\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ a & b\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ c\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n\\underbrace{\\begin{bmatrix}-3 & 2 \\\\ 4 & -2\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-4 \\\\ 7\\end{bmatrix}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-2\\cdot (-3)-2\\cdot 4}\\begin{bmatrix}-2 & -2 \\\\ -4 & -3\\end{bmatrix} \\\\  & =\\frac{1}{-2}\\begin{bmatrix}-2 & -2 \\\\ -4 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & \\frac{3}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}1 & 1 \\\\ 2 & \\frac{3}{2}\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}-4 \\\\ 7\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & \\frac{3}{2}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}1 & 1 \\\\ 2 & \\frac{3}{2}\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & \\frac{3}{2}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}3 \\\\ \\frac{5}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & \\frac{3}{2}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ -\\frac{5}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+\\frac{3}{2}+(-\\frac{5}{2})=1.\n$$"}] [{:db/id #edb/ref 17592186259630 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f3b4ff8-e9b0-521b-a9c7-8ce613488d5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257459} {:answer/id #uuid "81a82df1-73ea-5ee2-b9f4-cd8efef245d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257935} {:answer/id #uuid "971b265b-627d-584c-8bd5-b975e9552229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{3}$ only" :db/id #edb/ref 17592186258115} {:answer/id #uuid "a4ffc45a-0a6d-5af5-aff4-9edb51326307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186258220} {:answer/id #uuid "b7fd1e66-1022-5d36-99e4-76b9bc2be555" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ only" :db/id #edb/ref 17592186258391}] :answer-field/correct {:answer/id #uuid "971b265b-627d-584c-8bd5-b975e9552229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{3}$ only" :db/id #edb/ref 17592186258115} :answer-field/id #uuid "3fd515da-2bfd-5ed1-b4e6-947a8a071af9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259147}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd962593-19ff-5124-a324-851d683c9d53" :question/math-academy-id "q-124236" :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u+v \\\\ \\sqrt{v}\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u+1 \\\\ {v}^{3}\\end{bmatrix}$\n- ${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}3u-2 \\\\ 8-v\\end{bmatrix}$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is not affine since it contains the term $\\sqrt{v}.$\n\n- Transformation ${T}_{2}$ is not affine since it contains the cubic term ${v}^{3}.$\n\n- Transformation ${T}_{3}$ is affine. Notice that ${T}_{3}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}3u-2 \\\\ 8-v\\end{bmatrix} \\\\  & =\\begin{bmatrix}3u \\\\ -v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 8\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ 8\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"${T}_{3}$ only.\""}] [{:db/id #edb/ref 17592186259631 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3af05d3e-30eb-5918-91db-aa8c3a197237" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257304} {:answer/id #uuid "3e616a32-d29b-5f08-93ed-071ac16b3da9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186257342} {:answer/id #uuid "7dce96d6-a180-5c14-a0e1-d3830ccaa2d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1},$ ${T}_{2},$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257895} {:answer/id #uuid "c144722c-9c7d-5454-80ab-16bbb5e3cf27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186258472} {:answer/id #uuid "f753729a-b8ab-5b2d-bbfc-716c8a2bfb27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ only" :db/id #edb/ref 17592186258949}] :answer-field/correct {:answer/id #uuid "3e616a32-d29b-5f08-93ed-071ac16b3da9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186257342} :answer-field/id #uuid "c5d330ca-85d9-55ae-bc23-193deb6c6d8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259376}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61d7ee8c-7043-59bf-884d-8cfd140d0d17" :question/math-academy-id "q-124237" :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}v-6u+7 \\\\ 4u+3v-5\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}-7u-2v \\\\ 5u+v\\end{bmatrix}$\n- ${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}2u+v \\\\ uv+1\\end{bmatrix}$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is affine. Notice that ${T}_{1}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v-6u+7 \\\\ 4u+3v-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6u+v \\\\ 4u+3v\\end{bmatrix}+\\begin{bmatrix}7 \\\\ -5\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-6 & 1 \\\\ 4 & 3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}7 \\\\ -5\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\n- Transformation ${T}_{2}$ is affine. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}-7u-2v \\\\ 5u+v\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7u-2v \\\\ 5u+v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-7 & -2 \\\\ 5 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nIn fact, the transformation ${T}_{2}$ is a linear transformation.\n\n- Transformation ${T}_{3}$ is not affine since it contains the cross term $uv.$\n\nTherefore, the correct answer is \"${T}_{1}$ and ${T}_{2}$ only.\""}] [{:db/id #edb/ref 17592186259632 :knowledge-point/_questions [{:db/id #edb/ref 17592186179771 :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e100c0-d6ff-5136-87d3-6d7c4cb5f7a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256869} {:answer/id #uuid "4115a4dc-a26c-5fa3-9586-57c831ab287a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257360} {:answer/id #uuid "777f54f7-5bed-5e04-a701-aa0d0d8361f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257840} {:answer/id #uuid "907c2819-9860-5a07-9077-f754b8f1532c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258051} {:answer/id #uuid "aa493f4d-9eda-598d-987d-713420f94752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258267}] :answer-field/correct {:answer/id #uuid "09e100c0-d6ff-5136-87d3-6d7c4cb5f7a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256869} :answer-field/id #uuid "d89e1981-b198-5567-8250-810bdc62696a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259413}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d10dbe8c-a132-5e08-bb9b-f3f11298186b" :question/math-academy-id "q-124238" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-5 & -9 \\\\ 3 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & -3 \\\\ 1 & b\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}0 \\\\ c\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n\\underbrace{\\begin{bmatrix}-5 & -9 \\\\ 3 & 6\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot (-5)-(-9)\\cdot 3}\\begin{bmatrix}6 & 9 \\\\ -3 & -5\\end{bmatrix} \\\\  & =\\frac{1}{-3}\\begin{bmatrix}6 & 9 \\\\ -3 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}0 \\\\ -\\frac{1}{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}0 \\\\ \\frac{1}{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-2+\\frac{5}{3}+\\frac{1}{3}=0.\n$$"}] [{:db/id #edb/ref 17592186259633 :knowledge-point/_questions [{:db/id #edb/ref 17592186179771 :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c52d4e-2631-53e7-8a00-72ab68871a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186257401} {:answer/id #uuid "746b1cdb-7c35-5efe-a92c-2cd06400438a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257801} {:answer/id #uuid "a34beb49-2bb7-5107-84ce-cae801ce1c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258211} {:answer/id #uuid "ef2b02b6-f203-59a0-ab8f-6e907c4aac2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258857} {:answer/id #uuid "f75572fb-3d5c-57c1-b45a-ea11a4c996bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258950}] :answer-field/correct {:answer/id #uuid "746b1cdb-7c35-5efe-a92c-2cd06400438a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257801} :answer-field/id #uuid "99e69744-50ea-5409-9359-8197e1464b98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08a12b2e-6f73-5fc0-987c-f4d58e5bc21f" :question/math-academy-id "q-124241" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}8 & 9 \\\\ 4 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & b \\\\ -1 & c\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n\\underbrace{\\begin{bmatrix}8 & 9 \\\\ 4 & 5\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 8-9\\cdot 4}\\begin{bmatrix}5 & -9 \\\\ -4 & 8\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}5 & -9 \\\\ -4 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}6 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=\\frac{5}{4}+(-\\frac{9}{4})+2=1.\n$$"}] [{:db/id #edb/ref 17592186259634 :knowledge-point/_questions [{:db/id #edb/ref 17592186179771 :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4892ddc7-1f21-5fb6-9203-29d772bde8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257419} {:answer/id #uuid "92a426f4-8720-57e6-a1e8-ad581c1828da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186258075} {:answer/id #uuid "9f843863-e410-57ac-ad2a-c4d41c982c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186258183} {:answer/id #uuid "a1613b31-d49f-5ba6-a356-2221335e1c8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186258196} {:answer/id #uuid "b9fab22d-ecf7-5ea8-a60c-5286e5e43015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258411}] :answer-field/correct {:answer/id #uuid "b9fab22d-ecf7-5ea8-a60c-5286e5e43015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258411} :answer-field/id #uuid "da74548d-3633-5796-b2bf-ea07c5e41132" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b41b10b-145c-5e96-a5f6-3186f40b3311" :question/math-academy-id "q-124244" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2 & 5 \\\\ -1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & 5 \\\\ b & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}c \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n\\underbrace{\\begin{bmatrix}-2 & 5 \\\\ -1 & 3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot (-2)-5\\cdot (-1)}\\begin{bmatrix}3 & -5 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}3 & -5 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}6 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-8 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}8 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-3+(-1)+8=4.\n$$"}] [{:db/id #edb/ref 17592186259635 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4de0082d-50c4-5d80-b063-91bd017a1545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257451} {:answer/id #uuid "5d087fdf-6d61-58c5-b78e-6d419b6ee799" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1},$ ${T}_{2},$ and ${T}_{3}$" :db/id #edb/ref 17592186257591} {:answer/id #uuid "739355b8-4721-5999-8150-50c1a6ed20d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186257795} {:answer/id #uuid "bdbd9f1e-6203-5220-b685-f660d3c02c7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186258436} {:answer/id #uuid "f2e1ae10-e87c-57e1-a5df-1f35cce54260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186258899}] :answer-field/correct {:answer/id #uuid "5d087fdf-6d61-58c5-b78e-6d419b6ee799" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1},$ ${T}_{2},$ and ${T}_{3}$" :db/id #edb/ref 17592186257591} :answer-field/id #uuid "513f8367-607c-5e96-9439-18e4d01f3c9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259175}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a803158d-6736-5561-9888-f16b39fbcde9" :question/math-academy-id "q-124245" :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}7u-v+6 \\\\ -7\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}8v-9u \\\\ 4u-v\\end{bmatrix}$\n- ${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u-5 \\\\ 8u\\end{bmatrix}$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is affine. Notice that ${T}_{1}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}7u-v+6 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}7u-v \\\\ 0\\end{bmatrix}+\\begin{bmatrix}6 \\\\ -7\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}7 & -1 \\\\ 0 & 0\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}6 \\\\ -7\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\n- Transformation ${T}_{2}$ is affine. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}8v-9u \\\\ 4u-v\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9u+8v \\\\ 4u-v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-9 & 8 \\\\ 4 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nIn fact, the transformation ${T}_{2}$ is a linear transformation.\n\n- Transformation ${T}_{3}$ is affine. Notice that ${T}_{3}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u-5 \\\\ 8u\\end{bmatrix} \\\\  & =\\begin{bmatrix}u \\\\ 8u\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & 0 \\\\ 8 & 0\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-5 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"${T}_{1},$ ${T}_{2},$ and ${T}_{3}.$\""}] [{:db/id #edb/ref 17592186259636 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2cf13d-a183-5e14-a4b5-462bfd278b09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186257166} {:answer/id #uuid "4f6a73e3-8d6c-5cde-8f8b-f62b5997fb77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186257463} {:answer/id #uuid "a8cfc09f-e2ab-5d00-aa5b-f5e739273487" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ only" :db/id #edb/ref 17592186258254} {:answer/id #uuid "cb15038f-1ec4-5f28-aec7-ea630c2ddb0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{3}$ only" :db/id #edb/ref 17592186258545} {:answer/id #uuid "f0be6935-9d30-5bdd-83ef-ea913d0881f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186258877}] :answer-field/correct {:answer/id #uuid "a8cfc09f-e2ab-5d00-aa5b-f5e739273487" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ only" :db/id #edb/ref 17592186258254} :answer-field/id #uuid "604b8e22-70c6-57af-b395-f873faa084c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259196}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f56913d5-4faa-5365-a00a-436d31c63ba7" :question/math-academy-id "q-124247" :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}9u+v \\\\ 2u+8v\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u \\\\ 1-{v}^{3}\\end{bmatrix}$\n- ${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u(v-1) \\\\ u-1\\end{bmatrix}$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is affine. Notice that ${T}_{1}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}9u+v \\\\ 2u+8v\\end{bmatrix} \\\\  & =\\begin{bmatrix}9u+v \\\\ 2u+8v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}9 & 1 \\\\ 2 & 8\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nIn fact, the transformation ${T}_{1}$ is a linear transformation.\n\n- Transformation ${T}_{2}$ is not affine since it contains the cubic term ${v}^{3}.$\n\n- Transformation ${T}_{3}$ is not affine since it contains the cross term $uv.$\n\nTherefore, the correct answer is \"${T}_{1}$ only.\""}] [{:db/id #edb/ref 17592186259637 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b02e3f-baf3-57d3-a076-ab452fdeef0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186256799} {:answer/id #uuid "22814352-2c48-5958-9dee-a9a29d563b86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257066} {:answer/id #uuid "27a5552d-e286-524b-8546-cef93fa80826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1},$ ${T}_{2},$ and ${T}_{3}$" :db/id #edb/ref 17592186257133} {:answer/id #uuid "2f4661b6-b14e-5456-9974-00d318903de3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257199} {:answer/id #uuid "f916b4e3-4292-594a-9059-6b10083c974a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186258968}] :answer-field/correct {:answer/id #uuid "22814352-2c48-5958-9dee-a9a29d563b86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257066} :answer-field/id #uuid "206fb4ee-adb0-528a-87ee-8ada6b197a84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259089}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13d7af34-5a26-56da-8335-dcbefb3a99a7" :question/math-academy-id "q-124251" :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{2}-{v}^{2} \\\\ v-u\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}6v-4u \\\\ 3u+3v\\end{bmatrix}$\n- ${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u+v+9 \\\\ v-9\\end{bmatrix}$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is not affine since it contains the quadratic terms ${u}^{2}$ and ${v}^{2}.$\n\n- Transformation ${T}_{2}$ is affine. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}6v-4u \\\\ 3u+3v\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4u+6v \\\\ 3u+3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-4 & 6 \\\\ 3 & 3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nIn fact, the transformation ${T}_{2}$ is a linear transformation.\n\n- Transformation ${T}_{3}$ is affine. Notice that ${T}_{3}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u+v+9 \\\\ v-9\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+v \\\\ v\\end{bmatrix}+\\begin{bmatrix}9 \\\\ -9\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}9 \\\\ -9\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"${T}_{2}$ and ${T}_{3}$ only.\""}] [{:db/id #edb/ref 17592186259638 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "256fbf73-68d8-56cd-99d4-6ab220700234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186257100} {:answer/id #uuid "3df03890-7218-544f-a1c1-3ad95cf59941" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186257334} {:answer/id #uuid "5e8dddff-e30a-5e35-99d4-ea31f8bef8de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257613} {:answer/id #uuid "ad08e75f-d6b2-5f74-b630-c7824215bf61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ only" :db/id #edb/ref 17592186258294} {:answer/id #uuid "fce36429-baf1-517b-9f7f-64595779152d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{3}$ only" :db/id #edb/ref 17592186258992}] :answer-field/correct {:answer/id #uuid "256fbf73-68d8-56cd-99d4-6ab220700234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186257100} :answer-field/id #uuid "63e916b1-34bb-5434-90d1-69e05a02c05b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259205}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d494b59f-56bb-56d7-a682-8c7f88848b2e" :question/math-academy-id "q-124253" :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u-1 \\\\ {e}^{v}\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}8u+2v+2 \\\\ u-2v+4\\end{bmatrix}$\n- ${T}_{3}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u+v \\\\ \\operatorname{ln}⁡(u+v)\\end{bmatrix}$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is not affine since it contains the exponential term ${e}^{v}.$\n\n- Transformation ${T}_{2}$ is affine. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}8u+2v+2 \\\\ u-2v+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}8u+2v \\\\ u-2v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}8 & 2 \\\\ 1 & -2\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\n- Transformation ${T}_{3}$ is not affine since it contains the term $\\operatorname{ln}⁡(u+v).$\n\nTherefore, the correct answer is \"${T}_{2}$ only.\""}] [{:db/id #edb/ref 17592186259639 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "227340af-71d1-5d08-ace5-1c9258c8fcf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186257065} {:answer/id #uuid "30bb3807-55a5-5cda-b326-fdec9c047352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257211} {:answer/id #uuid "41438c81-cf63-57d7-afc0-35b56a8a92f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257363} {:answer/id #uuid "eeb37718-f272-5547-a58a-87b172f20251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258850} {:answer/id #uuid "ffd38fa9-a703-5a9b-9e62-e43d804d84e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259031}] :answer-field/correct {:answer/id #uuid "eeb37718-f272-5547-a58a-87b172f20251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258850} :answer-field/id #uuid "e68f436c-5c06-5c77-ab1f-cbf71cb2e171" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259435}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "248bc276-68c1-5b41-9594-c7af8b2e1b35" :question/math-academy-id "q-124259" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+bv+3,\\,y=-9u+cv+4\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -9 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}1 & 0 \\\\ -9 & 4\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}u \\\\ -9u+4v\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+3 \\\\ -9u+4v+4\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=1u+0v+3,\\,y=-9u+4v+4\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+0+4=5.\n$$"}] [{:db/id #edb/ref 17592186259640 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e740d3a-5c03-5dd2-816a-487643106091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186257194} {:answer/id #uuid "33a79aaa-17fe-5ec0-9815-f48d8949b65f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186257239} {:answer/id #uuid "73970941-5456-5fe8-906f-5e233465ae16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186257796} {:answer/id #uuid "9158f20d-6a83-542a-9c54-77af73ba69ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258067} {:answer/id #uuid "ce7c1236-c621-5444-b1e2-cd41e1db1cdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186258575}] :answer-field/correct {:answer/id #uuid "ce7c1236-c621-5444-b1e2-cd41e1db1cdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186258575} :answer-field/id #uuid "671307a9-23d3-54b5-988a-ecf7a2f8a2ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ded880b4-9f04-5275-85c1-4486642a0a7d" :question/math-academy-id "q-124261" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+bv-2,\\,y=u+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6 & 8 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}6 & 8 \\\\ 1 & 0\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}6u+8v \\\\ u\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}6u+8v-2 \\\\ u+5\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=6u+8v-2,\\,y=u+5\n$$\n\nTherefore, we have\n\n$$\na+b+c=6+8+5=19.\n$$"}] [{:db/id #edb/ref 17592186259641 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe1c6ee-1822-5943-a4ab-95e2e8729c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257204} {:answer/id #uuid "42afdead-f7ba-55b9-837b-58a7ebcab735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257371} {:answer/id #uuid "5b54affb-22be-504f-9fc3-75ecc52418c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186257578} {:answer/id #uuid "d4002265-2697-5e13-a97a-e4de62345ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186258638} {:answer/id #uuid "f3d00b3d-b50a-5be5-8ad2-4acce9512f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258912}] :answer-field/correct {:answer/id #uuid "f3d00b3d-b50a-5be5-8ad2-4acce9512f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258912} :answer-field/id #uuid "0d42c87d-8e24-585c-849a-f00efbd599ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18f13e13-3246-593c-9da3-b608f58de1b5" :question/math-academy-id "q-124262" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+v,\\,y=bu+cv\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2 & 1 \\\\ 9 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}-2 & 1 \\\\ 9 & 3\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}-2u+v \\\\ 9u+3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2u+v \\\\ 9u+3v\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-2u+v,\\,y=9u+3v\n$$\n\nTherefore, we have\n\n$$\na+b+c=-2+9+3=10.\n$$"}] [{:db/id #edb/ref 17592186259642 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e5d8b9-aa23-509f-9d82-cbc0a58b88aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257118} {:answer/id #uuid "523c5ff0-288c-54a6-8984-dab86593561a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257483} {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} {:answer/id #uuid "de5a4cff-b039-5894-8b6c-7aad63c636fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258717} {:answer/id #uuid "fb952160-6ec2-5819-80f3-0686d4603494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186258981}] :answer-field/correct {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} :answer-field/id #uuid "514ff102-c238-5181-bd9a-4ee63292ed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259176}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "569ad093-da2b-5144-992e-0f84b411665b" :question/math-academy-id "q-124263" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+av-2,\\,y=bu+cv-3\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 & -1 \\\\ 9 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}4 & -1 \\\\ 9 & 5\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}4u-v \\\\ 9u+5v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u-v-2 \\\\ 9u+5v-3\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+(-1)v-2,\\,y=9u+5v-3\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+9+5=13.\n$$"}] [{:db/id #edb/ref 17592186259643 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "506f9d2d-d08a-56f9-98e6-3535609b1da4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257470} {:answer/id #uuid "76cc7d25-0d63-5fa5-9287-8cd0b7cf87ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257829} {:answer/id #uuid "bbf5d7a0-0461-5380-8b1d-7aa6631a5d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258425} {:answer/id #uuid "c14197eb-d474-53b1-b351-f8738ddeafd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258471} {:answer/id #uuid "e94689f3-f817-50df-9027-5eb925d967a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258804}] :answer-field/correct {:answer/id #uuid "e94689f3-f817-50df-9027-5eb925d967a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258804} :answer-field/id #uuid "ea132969-c4fb-52c6-aa2f-d42f10a0b35d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e491209f-8e14-5a51-846e-3087f73ab2f3" :question/math-academy-id "q-124265" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+6v+b,\\,y=cu-4v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 & 6 \\\\ 3 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}1 & 6 \\\\ 3 & -4\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}u+6v \\\\ 3u-4v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+6v \\\\ 3u-4v\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=1u+6v+0,\\,y=3u-4v\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+0+3=4.\n$$"}] [{:db/id #edb/ref 17592186259644 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bc5571-4143-5aae-96cf-6f2be18ea704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186256958} {:answer/id #uuid "2b6e7a59-7e19-5f06-994d-4e3590c3b8bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257171} {:answer/id #uuid "c64c4347-213c-5d26-b1fc-9c4dcd0170a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258516} {:answer/id #uuid "d59fa816-e9ed-5fd9-bd9c-9869013fe1c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258655} {:answer/id #uuid "f8f07afd-8b4a-5912-b02f-c853e792c6e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258967}] :answer-field/correct {:answer/id #uuid "f8f07afd-8b4a-5912-b02f-c853e792c6e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258967} :answer-field/id #uuid "611144f2-0911-5d73-99aa-6da505f8fa68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259197}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cc9e110-657b-5c50-af6f-2ba6688d538a" :question/math-academy-id "q-124267" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au-2v+b,\\,y=4u+cv-2\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-6 & -2 \\\\ 4 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overbrace{\\begin{bmatrix}-6 & -2 \\\\ 4 & 7\\end{bmatrix}}^{A}\\cdot \\overbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}^{u}+\\overbrace{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}}^{b} \\\\  & =\\begin{bmatrix}-6u-2v \\\\ 4u+7v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6u-2v+1 \\\\ 4u+7v-2\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-6u-2v+1,\\,y=4u+7v-2\n$$\n\nTherefore, we have\n\n$$\na+b+c=-6+1+7=2.\n$$"}] [{:db/id #edb/ref 17592186259647 :knowledge-point/_questions [{:db/id #edb/ref 17592186179772 :knowledge-point/id #uuid "b99071b9-d463-5e3e-9a0d-71711af836cb" :knowledge-point/title "Inverting Affine Transformations Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5221f3d2-3945-59bf-8f2a-8074c4d35eac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186257481} {:answer/id #uuid "6335888e-8880-5dda-bb22-cb264ba5e045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257656} {:answer/id #uuid "65be3f91-2307-5b7c-a45f-3cfedff40838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257678} {:answer/id #uuid "90189be9-60a0-5430-b1cf-cb0e4429164f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258050} {:answer/id #uuid "cf076746-fa92-51fc-a391-045e00ab93d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258581}] :answer-field/correct {:answer/id #uuid "cf076746-fa92-51fc-a391-045e00ab93d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258581} :answer-field/id #uuid "ddb82f61-7d4c-5474-a0b0-ba491f22517e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259422}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4865ae47-4fd4-593e-a597-ec2a2d5aa88e" :question/math-academy-id "q-124276" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=4u+7v+2,\\,y=u+2v+1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-7y+3,\\,v=by+cx-2,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4u+7v+2 \\\\ u+2v+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u+7v \\\\ u+2v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}4 & 7 \\\\ 1 & 2\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 4-7\\cdot 1}\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}\\begin{bmatrix}x-2 \\\\ y-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (x-2)+(-7)\\cdot (y-1) \\\\ (-1)\\cdot (x-2)+4\\cdot (y-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x-7y+3 \\\\ 4y-x-2\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x-7y+3,\\,v=4y+(-1)x-2.\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+4+(-1)=5.\n$$"}] [{:db/id #edb/ref 17592186259649 :knowledge-point/_questions [{:db/id #edb/ref 17592186179772 :knowledge-point/id #uuid "b99071b9-d463-5e3e-9a0d-71711af836cb" :knowledge-point/title "Inverting Affine Transformations Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bed1340-8927-5ff0-ba69-b2b93cdd78e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186256896} {:answer/id #uuid "81fb632e-14da-5038-b6f9-74ec0da963a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257937} {:answer/id #uuid "82d7f633-617d-5497-a90c-a0550510c2f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257941} {:answer/id #uuid "d5507f11-f2dc-54ed-aa00-8c211067e5e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186258649} {:answer/id #uuid "e3817db8-3192-5a2c-ad51-eb7cb8e7b55c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258760}] :answer-field/correct {:answer/id #uuid "d5507f11-f2dc-54ed-aa00-8c211067e5e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186258649} :answer-field/id #uuid "fa29d767-9911-5a05-a828-3b3c81faca3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259473}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f20eb077-8cae-5138-ae0e-248f60ff9fb8" :question/math-academy-id "q-124280" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2-u-v,\\,y=3u+4v-1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=7+ax-y,\\,v=bx+y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2-u-v \\\\ 3u+4v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-u-v \\\\ 3u+4v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-1 & -1 \\\\ 3 & 4\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot (-1)-(-1)\\cdot 3}\\begin{bmatrix}4 & 1 \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}4 & 1 \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & -1 \\\\ 3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}-4 & -1 \\\\ 3 & 1\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}-4 & -1 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}x-2 \\\\ y+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\cdot (x-2)+(-1)\\cdot (y+1) \\\\ 3\\cdot (x-2)+1\\cdot (y+1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-4x-y \\\\ 3x+y-5\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=7+(-4)x-y,\\,v=3x+y+(-5).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-4+3+(-5)=-6.\n$$"}] [{:db/id #edb/ref 17592186259651 :knowledge-point/_questions [{:db/id #edb/ref 17592186179772 :knowledge-point/id #uuid "b99071b9-d463-5e3e-9a0d-71711af836cb" :knowledge-point/title "Inverting Affine Transformations Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04abb601-17e0-5fec-b990-97706ac5a596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186256822} {:answer/id #uuid "20b7769d-6be5-53ae-a10f-0d9f4c90d0a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186257049} {:answer/id #uuid "525f19b0-d029-5095-845b-fc54069a98b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186257485} {:answer/id #uuid "6ffe1822-1c33-543b-8781-69059dae9e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186257765} {:answer/id #uuid "97f74daa-bcde-5c29-bc67-733be230ca01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186258121}] :answer-field/correct {:answer/id #uuid "20b7769d-6be5-53ae-a10f-0d9f4c90d0a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186257049} :answer-field/id #uuid "a412914a-2d2e-597f-8fb0-48dccc9cd9de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259321}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ab7706f1-5139-5e95-9482-c097bef51185" :question/math-academy-id "q-124282" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2u-v+1,\\,y=9u-4v+3.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=y-4x+a,\\,v=by+cx+3,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u-v+1 \\\\ 9u-4v+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u-v \\\\ 9u-4v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 3\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}2 & -1 \\\\ 9 & -4\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-4\\cdot 2-(-1)\\cdot 9}\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u} & =\\underbrace{\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix}}_{{A}^{-1}}\\cdot (\\underbrace{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{x}-\\underbrace{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{b}) \\\\  & =\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix}\\begin{bmatrix}x-1 \\\\ y-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\cdot (x-1)+1\\cdot (y-3) \\\\ -9\\cdot (x-1)+2\\cdot (y-3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}y-4x+1 \\\\ 2y-9x+3\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=y-4x+1,\\,v=2y+(-9)x+3.\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+2+(-9)=-6.\n$$"}] [{:db/id #edb/ref 17592186259652 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343b2207-66d5-57bb-87f6-c4c790c690d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257244} {:answer/id #uuid "ab7ec3bd-0bf2-5983-a44c-e00a3fdf0ceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258277} {:answer/id #uuid "b0e42a09-6baf-5d36-87f3-f42986684931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258323} {:answer/id #uuid "f23f4bbb-43d3-539b-a8e2-405d7732b7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258890} {:answer/id #uuid "f6097032-0646-54a4-8dab-1221f0240b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186258930}] :answer-field/correct {:answer/id #uuid "ab7ec3bd-0bf2-5983-a44c-e00a3fdf0ceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258277} :answer-field/id #uuid "ca41ba6d-3943-5258-9ae3-5aaa5c4554e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31239ffb-2521-5f24-adb5-1bf7dc8cd57c" :question/math-academy-id "q-124284" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4v-u,\\,y=3v-7\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & b \\\\ 0 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}c \\\\ -7\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4v-u \\\\ 3v-7\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4v-u \\\\ 3v-7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-u+4v \\\\ 3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -7\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-1 & 4 \\\\ 0 & 3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ -7\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+4+0=3.\n$$"}] [{:db/id #edb/ref 17592186259653 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca5b200-1e86-5077-aeb8-b67c50a6c8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256904} {:answer/id #uuid "10c3ff93-d73d-554e-87b3-0212fbed198e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186256936} {:answer/id #uuid "27911809-e171-5b95-b3fb-a9b7e21c7cab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257131} {:answer/id #uuid "9e61dc6e-2df8-5438-a1de-0bda0036241d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258175} {:answer/id #uuid "fb1e43fe-6e46-581d-8dc9-be67f6e9cca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258980}] :answer-field/correct {:answer/id #uuid "9e61dc6e-2df8-5438-a1de-0bda0036241d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258175} :answer-field/id #uuid "a9a47780-a23d-5f51-9883-7dae72cf3277" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259331}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79c75f5d-7fe0-5715-9bd2-b2946e30a081" :question/math-academy-id "q-124285" :question/problem "The matrix form of the affine transformation\n\n$$\nx=5u-3v-2,\\,y=2u+v+7\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5 & -3 \\\\ a & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}c \\\\ 7\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5u-3v-2 \\\\ 2u+v+7\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}5u-3v-2 \\\\ 2u+v+7\\end{bmatrix} \\\\  & =\\begin{bmatrix}5u-3v \\\\ 2u+v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}5 & -3 \\\\ 2 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+1+(-2)=1.\n$$"}] [{:db/id #edb/ref 17592186259655 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01350874-c575-5e87-9942-b73d549773cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186256793} {:answer/id #uuid "58d4a7a7-b300-54be-b8b9-e942e97ed67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257553} {:answer/id #uuid "5cf8de9f-1c39-50e9-ba1a-5b22b73cacee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257590} {:answer/id #uuid "b7e5fa5c-635b-5a31-a047-dcc83173e338" :answer/type {:db/id #edb/ref 175921860454