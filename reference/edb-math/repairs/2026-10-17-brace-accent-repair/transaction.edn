bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -\\frac{1}{2} & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix})U \\\\ A & =\\underbrace{\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{bmatrix}}_{L}\\underbrace{\\begin{bmatrix}2 & -6 & 4 \\\\ 0 & 3 & -8 \\\\ 0 & 0 & -11\\end{bmatrix}}_{U}\\end{aligned}\n$$"]
