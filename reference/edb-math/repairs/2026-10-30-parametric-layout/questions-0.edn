3}$ | $\\pi $ | $\\frac{4\\pi }{3}$ | $\\frac{5\\pi }{3}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $7$ | $\\frac{7\\sqrt{3}}{2}$ | $\\frac{7}{2}$ | $-\\frac{7}{2}$ | $-7$ | $-\\frac{7}{2}$ | $\\frac{7}{2}$ |\n| $y$ | $0$ | $\\frac{5}{2}$ | $\\frac{5\\sqrt{3}}{2}$ | $\\frac{5\\sqrt{3}}{2}$ | $0$ | $-\\frac{5\\sqrt{3}}{2}$ | $-\\frac{5\\sqrt{3}}{2}$ |\n\n$$\n\n$$\n\nPlotting these points, we obtain the following curve:\n\n![](images/de/debf9475589e7e242df986d1fffb8a97834d6ce550279fc82b0428001b661eaa.png)"}] [{:db/id #edb/ref 17592186281385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c74816-4778-5b3e-9b9d-61592212a8ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -1" :db/id #edb/ref 17592186278822} {:answer/id #uuid "66efcbd7-ca94-524f-8194-bf2ab8ec7909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -4" :db/id #edb/ref 17592186279524} {:answer/id #uuid "7e322087-6972-5dd3-bc74-439622637adf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x\\le 1" :db/id #edb/ref 17592186279723} {:answer/id #uuid "de555049-8982-5a84-b956-77472e9e1885" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\le x\\le -2" :db/id #edb/ref 17592186280553} {:answer/id #uuid "f297fd21-f190-5d52-b646-39f42c20012e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 0" :db/id #edb/ref 17592186280704}] :answer-field/correct {:db/id #edb/ref 17592186278822} :answer-field/id #uuid "b4f491fa-0087-5e93-a231-d05100d4255a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281156}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97007632-9d2f-5a8a-900e-9e7bf33ec6d3" :question/math-academy-id "q-16199" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx={t}^{2}-2t,\\,\\,\\,y=3-t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the range of $x.$" :question/worked-solution "To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}-2t \\\\  & ={(t-1)}^{2}-{(1)}^{2} \\\\  & ={(t-1)}^{2}-1\\end{aligned}\n$$\n\nSince ${(t-1)}^{2}\\ge 0,$ we can conclude that $x\\ge -1.$"}] [{:db/id #edb/ref 17592186281386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15501fc5-9f05-535a-afa5-9a19654f94b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge \\frac{5}{2},\\,y\\le -1" :db/id #edb/ref 17592186278781} {:answer/id #uuid "2ccf5191-8634-5b90-a807-77a0bbfed33b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 0,\\,y\\ge 0" :db/id #edb/ref 17592186278987} {:answer/id #uuid "2d91f8fb-c06a-5a6e-99ba-a8c38d385d08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 5,\\,y\\ge 2" :db/id #edb/ref 17592186278993} {:answer/id #uuid "3cd9f045-3487-5be5-adc3-3d5b3edc327f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 4,\\,y\\le -2" :db/id #edb/ref 17592186279127} {:answer/id #uuid "eeef9da7-ffa6-5021-aee7-5cc4d1113afc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le \\frac{25}{4},\\,y\\ge 0" :db/id #edb/ref 17592186280684}] :answer-field/correct {:db/id #edb/ref 17592186280684} :answer-field/id #uuid "43190c17-eebf-5453-8891-2414e96f88c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280947}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2dc3a2b7-620d-5940-a1aa-2a26502f43cc" :question/math-academy-id "q-16200" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=5t-{t}^{2},\\,\\,\\,y={t}^{2},\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & =5t-{t}^{2} \\\\  & =-({t}^{2}-5t) \\\\  & =-{(t-\\frac{5}{2})}^{2}+{\\left(\\frac{5}{2}\\right)}^{2} \\\\  & =-{(t-\\frac{5}{2})}^{2}+\\frac{25}{4}\\end{aligned}\n$$\n\nSince ${(t-\\frac{5}{2})}^{2}\\ge 0,$ we can conclude that $x\\le \\frac{25}{4}.$\n\n- To find the range of $y,$ notice that ${t}^{2}\\ge 0$ for all $t\\in (-\\infty ,\\infty ).$ Consequently, $y\\ge 0.$\n\nTherefore, the ranges are $x\\le \\frac{25}{4}$ and $y\\ge 0.$"}] [{:db/id #edb/ref 17592186292914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8605aaa0-1b98-56eb-a570-a43a2a70d923" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186291204}] :answer-field/correct {:db/id #edb/ref 17592186291204} :answer-field/id #uuid "0a6ce4b8-3146-5a15-914e-728e1ea47524" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291775} {:answer-field/choices [{:answer/id #uuid "951222c4-e5b5-5571-9a2a-d0eb2efb77b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186291278}] :answer-field/correct {:db/id #edb/ref 17592186291278} :answer-field/id #uuid "4bb5b0ed-47e4-542c-9624-f45a9ae12fb8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291974} {:answer-field/choices [{:answer/id #uuid "c3904da6-dc56-5079-9dea-00671367b5a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186291471}] :answer-field/correct {:db/id #edb/ref 17592186291471} :answer-field/id #uuid "69dce617-2d0a-5338-ac15-f289ffb850c5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292057} {:answer-field/choices [{:answer/id #uuid "202c5215-8f3f-596e-a440-8907945c8a91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186290768}] :answer-field/correct {:db/id #edb/ref 17592186290768} :answer-field/id #uuid "f0b94bb1-0aab-5a9f-85cc-3defdfc1d265" :answer-field/key "field