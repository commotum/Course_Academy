/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259034}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "808ba9b8-7fbd-5187-9780-5105c365918f" :question/math-academy-id "q-123764" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3t-7,\\,\\,\\,y=1-t,\\,t\\ge 1,\n$$\n\nwhat is the range of $x?$" :question/worked-solution "To find the range of $x,$ note that $x=3t-7\\ge -4$ for all $t\\ge 1.$ \n\nConsequently, the range of $x$ is $x\\ge -4.$"}] [{:db/id #edb/ref 17592186259558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414d124a-b508-5583-9956-c5dd472cc643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le -2" :db/id #edb/ref 17592186257365} {:answer/id #uuid "7aa68b07-b1f2-565e-b4ac-83291c10fccc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 1" :db/id #edb/ref 17592186257867} {:answer/id #uuid "7aaca65e-e0c9-519f-971d-f0ecaa4e670d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -4" :db/id #edb/ref 17592186257868} {:answer/id #uuid "91e40084-cac8-5469-9d49-d3b40442470e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 1" :db/id #edb/ref 17592186258070} {:answer/id #uuid "a2c1f09b-b855-5ca5-b0cd-fd5174673129" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 0" :db/id #edb/ref 17592186258206}] :answer-field/correct {:db/id #edb/ref 17592186257867} :answer-field/id #uuid "cdbbffe9-ed9c-55ae-a19e-6378fc084daf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259395}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a66d510-dc6f-5140-8b85-a40c213c087f" :question/math-academy-id "q-123765" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=1-4t,\\,\\,\\,y={t}^{2}-1,\\,t\\le 0,\n$$\n\nwhat is the range of $x?$" :question/worked-solution "To find the range of $x,$ note that $x=1-4t\\ge 1$ for all $t\\le 0.$ \n\nConsequently, the range of $x$ is $x\\ge 1.$"}] [{:db/id #edb/ref 17592186259559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57959764-9802-5ef3-8b00-3327faeca318" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-1" :db/id #edb/ref 17592186257540} {:answer/id #uuid "76c60e0e-888b-5e46-bff5-a091c4db3489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>1" :db/id #edb/ref 17592186257827} {:answer/id #uuid "d2fa9caf-b742-5141-ae4b-8c323bcbd79a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<1" :db/id #edb/ref 17592186258626} {:answer/id #uuid "d5f447c9-14b2-5616-aa2e-66db0623d59e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<-1" :db/id #edb/ref 17592186258659} {:answer/id #uuid "e0d23f6a-63fa-5c20-8abf-cbcdad542e1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>0" :db/id #edb/ref 17592186258738}] :answer-field/correct {:db/id #edb/ref 17592186258626} :answer-field/id #uuid "22e2dff1-984b-5475-ad74-e36b169f6786" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259094}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e3ca4cd3-a2f5-5cf2-84dd-64e7db9e1269" :question/math-academy-id "q-123767" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\frac{1}{t},\\,\\,\\,y=1-t,\\,t>0,\n$$\n\nwhat is the range of $y?$" :question/worked-solution "To find the range of $y,$ note that $y=1-t<1$ for all $t>0.$ \n\nConsequently, the range of $y$ is $y<1.$"}] [{:db/id #edb/ref 17592186259560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5586351b-05a5-5c12-89a0-57da129bbb08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\le 4" :db/id #edb/ref 17592186257516} {:answer/id #uuid "7e8040da-eb5f-5ce6-af63-5068e99c6fe2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\ge 4" :db/id #edb/ref 17592186257906} {:answer/id #uuid "80b9b8d7-c622-5ed6-b24e-c884987e0279" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\ge -1" :db/id #edb/ref 17592186257924} {:answer/id #uuid "a1824591-9403-50ad-a66e-f09ddacb2fcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\le -1" :db/id #edb/ref 17592186258197} {:answer/id #uuid "f3621797-2cb3-585f-b920-bad67edab357" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\ge 1" :db/id #edb/ref 17592186258904}] :answer-field/correct {:db/id #edb/ref 17592186257924} :answer-field/id #uuid "dc729384-3ae4-5369-9a7a-b0b69c373721" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259420}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1475dc3-badf-5eaf-85a3-fd70878f8785" :question/math-academy-id "q-123768" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3t+2,\\,\\,\\,y=4\\sqrt{t}-1,\\,t\\ge 0,\n$$\n\nwhat is the range of $y?$" :question/worked-solution "To find the range of $y,$ note that $4\\sqrt{t}\\ge 0$ for all $t\\ge 0.$ Consequently, $y=4\\sqrt{t}-1\\ge -1.$\n\nTherefore, we can conclude that $y\\ge -1.$"}] [{:db/id #edb/ref 17592186259561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "384f72db-1382-5e20-bf1f-b36c690e33cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\le x\\le 3,\\,-2\\le y\\le 0" :db/id #edb/ref 17592186257278} {:answer/id #uuid "801fd8d9-9053-54df-9ced-8c85c3bdf98c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\le x\\le 4,\\,-2\\le y\\le 0" :db/id #edb/ref 17592186257921} {:answer/id #uuid "8c14b075-1888-5849-bc15-60accafaa842" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\le x\\le -2,\\,0\\le y\\le 2" :db/id #edb/ref 17592186258010} {:answer/id #uuid "e2d3bd46-7af0-528b-a6fd-981273814a13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\le x\\le 3,\\,-1\\le y\\le 1" :db/id #edb/ref 17592186258756} {:answer/id #uuid "f26d173c-5784-55a7-aa52-c3e3759de69c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\le x\\le 4,\\,-1\\le y\\le 1" :db/id #edb/ref 17592186258893}] :answer-field/correct {:db/id #edb/ref 17592186257921} :answer-field/id #uuid "069877ab-6f59-5111-82b1-30e0cd6529a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259045}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "39f52df2-f7c2-52ca-a128-fe39a8ac5d3e" :question/math-academy-id "q-123777" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\operatorname{cos}⁡\\theta +3,\\,y=\\operatorname{sin}⁡\\theta -1,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -1+3 & \\le \\operatorname{cos}⁡\\theta +3\\le 1+3 \\\\ 2 & \\le x\\le 4.\\end{aligned}\n$$\n\nSo, we can conclude that $2\\le x\\le 4.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -1-1 & \\le \\operatorname{sin}⁡\\theta -1\\le 1-1 \\\\ -2 & \\le y\\le 0.\\end{aligned}\n$$\n\nSo, we can conclude that $-2\\le y\\le 0.$\n\nTherefore, the ranges are $2\\le x\\le 4$ and $-2\\le y\\le 0.$"}] [{:db/id #edb/ref 17592186259562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0533b388-aaff-54e5-984c-f3ee20038849" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/cc/ccdac60d2d9e7820ea4053977be2b71c4ffa18a8683c3bc9ef0752e806c0ffcd.png" :db/id #edb/ref 17592186256830} {:answer/id #uuid "456ec123-3e59-5576-9436-163bb4b301be" :ans