ef 17592186045498} :answer/value "x\\ge \\frac{5}{2},\\,y>4" :db/id #edb/ref 17592186540356} {:answer/id #uuid "8809df57-8c37-5023-bc33-262b767089d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le \\frac{5}{2},\\,y<4" :db/id #edb/ref 17592186540363} {:answer/id #uuid "abe91d82-658b-5b20-ac12-53f7c0a01f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{5}{2},\\,y=4" :db/id #edb/ref 17592186540371}] :answer-field/correct {:db/id #edb/ref 17592186540346} :answer-field/id #uuid "068b709a-b75b-59ef-9da3-f65183f42816" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540322}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "50b6c465-a48b-5670-bf04-569c56432b66" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=- 2 t^{2} + 6 t - 2,\\,y=t^{2} + 2 t + 1,\\,t>1,\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ complete the square:\n\n$$\nx=- 2 t^{2} + 6 t - 2=\\frac{5}{2} - 2 \\left(t - \\frac{3}{2}\\right)^{2} .\n$$\n\nThe vertex parameter is $t=\\frac{3}{2}$, which is admissible. The vertex value is $\\frac{5}{2}$ and is attained. The coordinate is unbounded below. Consequently, $x\\le \\frac{5}{2}.$\n\n- To find the range of $y,$ complete the square:\n\n$$\ny=t^{2} + 2 t + 1=\\left(t + 1\\right)^{2} .\n$$\n\nThe vertex parameter is $t=-1$, which is outside the given domain. On the given half-line the endpoint value is $4$, and the endpoint is excluded. The coordinate is unbounded above. Consequently, $y>4.$"}] [{:db/id #edb/ref 17592186540364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5cb103-e2a6-55dd-88b4-ff951035454a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=4,\\,y=-9" :db/id #edb/ref 17592186540323} {:answer/id #uuid "241da18c-4f54-5fdb-83a6-d4aebd28f761" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 4,\\,y\\ge -9" :db/id #edb/ref 17592186540331} {:answer/id #uuid "4a3a878f-e656-5812-b166-5fe192c2113d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 4,\\,y\\ge -9" :db/id #edb/ref 17592186540340} {:answer/id #uuid "6624af64-32b4-5f0d-9f8f-7024a71f8688" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 4,\\,y\\le -9" :db/id #edb/ref 17592186540349} {:answer/id #uuid "edb1276f-e5da-5e57-8127-c419090d77fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>4,\\,y>-9" :db/id #edb/ref 17592186540383}] :answer-field/correct {:db/id #edb/ref 17592186540340} :answer-field/id #uuid "657d489d-712a-511d-98b9-58b6832dfb26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540348}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8ae8b975-365c-5028-a76a-4fbbd7e53014" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=2 t^{2} + 2 t,\\,y=t^{2} + 4 t - 5,\\,t\\le -2,\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ complete the square:\n\n$$\nx=2 t^{2} + 2 t=2 \\left(t + \\frac{1}{2}\\right)^{2} - \\frac{1}{2} .\n$$\n\nThe vertex parameter is $t=- \\frac{1}{2}$, which is outside the given domain. On the given half-line the endpoint value is $4$, and the endpoint is included. The coordinate is unbounded above. Consequently, $x\\ge 4.$\n\n- To find the range of $y,$ complete the square:\n\n$$\ny=t^{2} + 4 t - 5=\\left(t + 2\\right)^{2} - 9 .\n$$\n\nThe vertex parameter is $t=-2$, which is admissible. The vertex value is $-9$ and is attained. The coordinate is unbounded above. Consequently, $y\\ge -9.$"}] [{:db/id #edb/ref 17592186540366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4932ea-c763-57bf-bad2-c7101a0f7441" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x