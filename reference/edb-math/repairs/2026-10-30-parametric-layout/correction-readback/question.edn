#{[{:db/id #edb/ref 17592186335959 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06ea7064-8984-5ac6-91ea-ed8921bbc138" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333056} {:answer/id #uuid "827b89fe-a572-54cd-b9cb-dcc0569b217e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186334153} {:answer/id #uuid "c8f91035-840a-59fe-a14a-8ded740896f0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186334736} {:answer/id #uuid "d3a7c0bf-869c-5788-8888-00b2ca3dcdac" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334846} {:answer/id #uuid "ed2e747f-c905-58fc-9adb-fb9c26ba7608" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186335069}] :answer-field/correct {:answer/id #uuid "827b89fe-a572-54cd-b9cb-dcc0569b217e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186334153} :answer-field/id #uuid "4a546347-737e-5d85-bf73-af24c4b5c1f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335386}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f35c183e-5200-5f54-ad21-69984c940bed" :question/math-academy-id "q-6825" :question/problem "For the parametric curve\n\n$$\nx=3t-2,\\,\\,\\,y=\\frac{10}{{t}^{2}+1},\\,-3\\le t\\le 3,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | ${\\color{blue}a}$ | $-8$ | $-5$ | $-2$ | $1$ | $4$ | ${\\color{blue}c}$ |\n| $y$ | $1$ | ${\\color{blue}b}$ | $5$ | $10$ | $5$ | $2$ | $1$ |\n\n\n\nFind the value of $a+b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-3$ into $x=3t-2.$ This gives\n\n$$\na=3(-3)-2=-9-2=-11.\n$$\n\n- To find the value of $b,$ we substitute $t=-2$ into $y=\\frac{10}{{t}^{2}+1}.$ This gives\n\n$$\nb=\\frac{10}{(-2)^{2}+1}=\\frac{10}{5}=2.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $x=3t-2.$ This gives\n\n$$\nc=3(3)-2=9-2=7.\n$$\n\nFinally, we have\n\n$$\na+b+c=-11+2+7=-2.\n$$"}]}
