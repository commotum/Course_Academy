t/_questions [{:knowledge-point/id #uuid "3626bdd2-ec13-5d74-a570-ec65ba682723" :knowledge-point/title "Finding Part of a Number Given a Whole and a Percentage"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfaf78ba-56ea-5dbc-bf0f-d1fb29590063" :answer/type {:db/ident :answer.type/text} :answer/value "$$12$" :db/id #edb/ref 17592186144855} {:answer/id #uuid "40134deb-7389-5d68-97b3-20daad4c3816" :answer/type {:db/ident :answer.type/text} :answer/value "$$15$" :db/id #edb/ref 17592186144856} {:answer/id #uuid "4177f036-3101-5274-94c5-0432db971310" :answer/type {:db/ident :answer.type/text} :answer/value "$$9$" :db/id #edb/ref 17592186144857} {:answer/id #uuid "49127b0f-1888-5371-bc26-5a32fc6aa407" :answer/type {:db/ident :answer.type/text} :answer/value "$$6$" :db/id #edb/ref 17592186144858} {:answer/id #uuid "6165c10f-dd7b-5cc9-a196-5ed39588b90b" :answer/type {:db/ident :answer.type/text} :answer/value "$$8$" :db/id #edb/ref 17592186144859}] :answer-field/correct {:answer/id #uuid "4177f036-3101-5274-94c5-0432db971310" :answer/type {:db/ident :answer.type/text} :answer/value "$$9$" :db/id #edb/ref 17592186144857} :answer-field/id #uuid "23f38b3d-16bd-57d3-bbbf-61126981b5ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186144854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12ea6424-b692-5183-972b-43b6ca16c730" :question/math-academy-id "q-60947" :question/problem "The original price of a toy robot in a department store was $\\$75.$ The store manager decides to reduce the price by $12\\%.$ How much of a discount has the manager given?" :question/worked-solution "To find the discount, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the old price, which is $\\$75.$ The percentage is $12\\%,$ and the part is the discount in dollars.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n12\\%=12÷100=0.12\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =12\\%\\times 75 \\\\  & =0.12\\times 75 \\\\  & =9\\end{aligned}\n$$\n\nTherefore, $12\\%$ of $75$ is $9.$ So, the discount is $\\$9.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n\\displaystyle \n12\\%=\\frac{12}{100}=\\frac{12÷4}{100÷4}=\\frac{3}{25}\n\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =12\\%\\times 75 \\\\  & =\\frac{3}{25}\\times 75 \\\\  & =3\\times \\frac{75}{25} \\\\  & =3\\times 3 \\\\  & =9\\end{aligned}\n$$\n\nTherefore, $12\\%$ of $75$ is $9.$ So, the discount is $\\$9.$"}] [{:db/id #edb/ref 17592186147871 :knowledge-point/_questions [{:knowledge-point/id #uuid "163d387b-3fd7-5f95-8245-5fb0184b371b" :knowledge-point/title "Finding Part of a Number Given a Whole and a Decimal Percentage"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1f2eafc-911f-5f49-837b-aa3afc5a8973" :answer/type {:db/ident :answer.type/text} :answer/value "$$354$" :db/id #edb/ref 17592186144981} {:answer/id #uuid "ef182a04-7dc6-578c-a576-01bfe5d27e45" :answer/type {:db/ident :answer.type/text} :answer/value "$$328$" :db/id #edb/ref 17592186144982} {:answer/id #uuid "38d78784-9f89-56ca-9107-9e18be3b6b4f" :answer/type {:db/ident :answer.type/text} :answer/value "$$320$" :db/id #edb/ref 17592186144983} {:answer/id #uuid "648df517-6a96-5b5f-8a09-7a5f9c7c59eb" :answer/type {:db/ident :answer.type/text} :answer/value "$$344$" :db/id #edb/ref 17592186144984} {:answer/id #uuid "6a9d6e97-d35b-5fd6-9681-ce82098a882c" :answer/type {:db/ident :answer.type/text} :answer/value "$$336$" :db/id #edb/ref 17592186144985}] :answer-field/correct {:answer/id #uuid "6a9d6e97-d35b-5fd6-9681-ce82098a882c" :answer/type {:db/ident :answer.type/text} :answer/value "$$336$" :db/id #edb/ref 17592186144985} :answer-field/id #uuid "0a7645bd-eabc-5e8e-aff9-db3aafaa3899" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186144980}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c3a72639-beef-5250-b0ef-e90a2b793cba" :question/math-academy-id "q-61177" :question/problem "Margaret has $\\$1,500$ saved. Of this amount, she decides to spend $22.4\\%$ to buy some supplies for her farm. How much money does Margret plan to spend?" :question/worked-solution "To solve this problem, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the amount of money Margaret has saved, which is $\\$1,500.$ The percentage is $22.4\\%,$ and the part is the amount of money that she decides to spend.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n22.4\\%=22.4÷100=0.224\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =22.4\\%\\times 1,500 \\\\  & =0.224\\times 1,500 \\\\  & =336\\end{aligned}\n$$\n\nTherefore, $22.4\\%$ of $1,500$ is $336.$ Thus, Margaret plans to spend $\\$336.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n22.4\\%=\\frac{22.4}{100}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =22.4\\%\\times 1,500 \\\\  & =\\frac{22.4}{100}\\times 1,500 \\\\  & =22.4\\times \\frac{1,500}{100} \\\\  & =22.4\\times 15 \\\\  & =336\\end{aligned}\n$$\n\nTherefore, $22.4\\%$ of $1,500$ is $336.$ Thus, Margaret plans to spend $\\$336.$"}] [{:db/id #edb/ref 17592186147881 :knowledge-point/_questions [{:knowledge-point/id #uuid "1670b7f6-fdee-5358-b145-9254e2a4ba50" :knowledge-point/title "Finding a Total Given a Part and a Percentage: Word Problems"}] :question/answer-fields [{:answer-