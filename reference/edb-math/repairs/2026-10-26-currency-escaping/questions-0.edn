cfb6c8f-22a9-50b3-a22c-91a50b2c3b34" :answer/type {:db/ident :answer.type/text} :answer/value "$$4\\,606$" :db/id #edb/ref 17592186508438} :answer-field/id #uuid "5fc3b38a-8bc4-538c-ac92-84c7786b2644" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058494}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8ea4e5bf-c78f-5012-a71e-1e6ffea002af" :question/math-academy-id "q-61792" :question/problem "A car was purchased for $\\$7\\,500$ and its value depreciated (decreased) by $15\\%$ per year. To the nearest dollar, what was the value of the car after $3$ years?" :question/worked-solution "The number $15\\%$ (expressed as a decimal) is equal to $0.15.$ Therefore, a decrease of $15\\%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.15=0.85\n$$\n\nTherefore:\n\n- After $1$ year, the car's value was $7\\,500\\cdot (0.85)$ dollars.\n\n- After $2$ years, the car's value was $7\\,500\\cdot (0.85)^{2}$ dollars.\n\n- After $3$ years, the car's value was $7\\,500\\cdot (0.85)^{3}$ dollars.\n\nEvaluating the last expression gives\n\n$$\n7\\,500\\cdot (0.85)^{3}≈4\\,606.\n$$\n\nSo the car was worth $\\$4\\,606$ (to the nearest dollar) after $3$ years."}] [{:db/id #edb/ref 17592186064907 :knowledge-point/_questions [{:knowledge-point/id #uuid "d20bb661-d55b-5db1-a353-a6d088ed3f86" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e20d1a6-cbb9-5108-aa84-4f967d9abf90" :answer/type {:db/ident :answer.type/text} :answer/value "$$4.20$" :db/id #edb/ref 17592186063499} {:answer/id #uuid "d4381c01-0ab9-5eef-98e4-6c6b636bd0ec" :answer/type {:db/ident :answer.type/text} :answer/value "$$3.10$" :db/id #edb/ref 17592186063500} {:answer/id #uuid "e221a6ea-01d2-5729-b0ab-19ebe3379b52" :answer/type {:db/ident :answer.type/text} :answer/value "$$3.20$" :db/id #edb/ref 17592186063501} {:answer/id #uuid "e89