#{[{:db/id #edb/ref 17592186092260 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092116 :question/id #uuid "c986ab8f-a8a6-5721-bc8d-ba7ec19b95ea" :question/math-academy-id "e-727" :question/problem "Calculate $f'(x)$ if $f(x) = e^{5x +4}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf = e^u, \\qquad u=5x+4.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = e^u,\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 5 \\\\  & =5{e}^{u} \\\\  & =5{e}^{5x+4}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048749 :topic/difficulty 0.6467073363985405 :topic/id #uuid "bad8d582-b827-501b-8a06-58b93e5ecdb0" :topic/knowledge-points [{:db/id #edb/ref 17592186096610} {:db/id #edb/ref 17592186096611} {:db/id #edb/ref 17592186096612}] :topic/math-academy-id 1114 :topic/next [{:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050690}] :topic/title "Differentiating Exponential Functions"} {:db/id #edb/ref 17592186051084 :topic/difficulty 1.4416972363891276 :topic/id #uuid "7fcc3a06-676a-55a2-9979-d3726053babe" :topic/knowledge-points [{:db/id #edb/ref 17592186096841} {:db/id #edb/ref 17592186096842} {:db/id #edb/ref 17592186096843}] :topic/math-academy-id 1108 :topic/next [{:db/id #edb/ref 17592186049332} {:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050628} {:db/id #edb/ref 17592186050789}] :topic/title "The Chain Rule for Differentiation"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725847 :question-generator/id #uuid "3e59f49b-c97d-5d47-a70a-c65028cffb94" :question-generator/script "generators/1f/1fdaabe12ec56ad89a9f3c0b07ef68f93e715be9c4ea7901890809b26f68e1da/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186092512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6fe2c4c-f454-5aca-a824-b3a7d3b7906a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{3x}}{3}" :db/id #edb/ref 17592186089244} {:answer/id #uuid "fd2c856f-0818-5870-a81c-c09468b81451" :answer/type {:db/ident :answer.type/math} :answer/value "xe^{3x}" :db/id #edb/ref 17592186089245} {:answer/id #uuid "33420c54-a5e9-5e50-8d8a-2b748db05ce4" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{3x}" :db/id #edb/ref 17592186089246} {:answer/id #uuid "43e58a07-4775-5ba0-87bf-4177453776ee" :answer/type {:db/ident :answer.type/math} :answer/value "3xe^{3x}" :db/id #edb/ref 17592186089247} {:answer/id #uuid "62505802-48e7-5721-a94d-ba4a709ec693" :answer/type {:db/ident :answer.type/math} :answer/value "e^{3x}" :db/id #edb/ref 17592186089248}] :answer-field/correct {:answer/id #uuid "33420c54-a5e9-5e50-8d8a-2b748db05ce4" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{3x}" :db/id #edb/ref 17592186089246} :answer-field/id #uuid "c07e8ff0-97b2-55ed-aa61-6034627f1aa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089243}] :question/id #uuid "2b5accbf-e263-55a8-aa47-3d5a01076c05" :question/math-academy-id "q-11816" :question/problem "Given that $f(x) = e^{3x}$, find $\\frac{df}{dx}$." :question/worked-solution "The chain rule gives\n\n$$\n\\frac{\\mathrm df}{\\mathrm dx}=e^{3x}\\frac{\\mathrm d}{\\mathrm dx}(3x)=3e^{3x}.\n$$"} {:db/id #edb/ref 17592186092513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4726f486-296b-54df-b7de-616f90a2a430" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2x+5}" :db/id #edb/ref 17592186524505} {:answer/id #uuid "8de0ee3e-9434-591e-863f-19dc03481eb0" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{2x+5}" :db/id #edb/ref 17592186524606} {:answer/id #uuid "ac9861ac-ab1f-5a28-b691-91302c31566a" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2x+5}" :db/id #edb/ref 17592186524659} {:answer/id #uuid "cafdcf0f-5e0a-5f8f-978e-3e3f2f8dc403" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x+5}}{2}" :db/id #edb/ref 17592186524715} {:answer/id #uuid "fc809e37-d2bf-588c-ad7b-ff6395a75916" :answer/type {:db/ident :answer.type/math} :answer/value "(2x+5){e}^{2x+5}" :db/id #edb/ref 17592186524836}] :answer-field/correct {:answer/id #uuid "ac9861ac-ab1f-5a28-b691-91302c31566a" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2x+5}" :db/id #edb/ref 17592186524659} :answer-field/id #uuid "aa7337e6-4d8a-5b6d-9fd4-37daba6415d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089249}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b27b93f8-5f19-566f-95e3-f0a0b21ec684" :question/math-academy-id "q-11817" :question/problem "Given that $f(x)={e}^{2x+5},$ find $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=2x+5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 2 \\\\  & =2{e}^{u} \\\\  & =2{e}^{2x+5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233098 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f95fdc58-1eb7-5580-ab34-aae2969c5c74" :question/math-academy-id "q-107420" :question/problem "Calculate ${f}^{'}(x)$ if $f(x)={x}^{3}-{e}^{1-3x}.$" :question/worked-solution "First, we express $y={e}^{1-3x}$ as the composite function\n\n$$\ny={e}^{u},\\,u=1-3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{1-3x}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}-{e}^{1-3x}) \\\\  & =3{x}^{2}-(-3{e}^{1-3x}) \\\\  & =3({x}^{2}+{e}^{1-3x}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234086 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f33e1827-8673-5c93-87ec-142118255194" :question/math-academy-id "q-48003" :question/problem "Given that $y=-3{e}^{5-x},$ find $\\frac{\\text{d}y}{\\text{d}x}$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-3{e}^{u},\\,u=5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot (-1) \\\\  & =3{e}^{u} \\\\  & =3{e}^{5-x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0cfd52e-1fc1-51eb-85e5-32d9d3dc6090" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{-3x+5}+8" :db/id #edb/ref 17592186313486} {:answer/id #uuid "f37132fc-0cae-54dc-850c-42a615eac8ec" :answer/type {:db/ident :answer.type/math} :answer/value "8-3e^{-3x+5}" :db/id #edb/ref 17592186524810}] :answer-field/correct {:answer/id #uuid "f37132fc-0cae-54dc-850c-42a615eac8ec" :answer/type {:db/ident :answer.type/math} :answer/value "8-3e^{-3x+5}" :db/id #edb/ref 17592186524810} :answer-field/id #uuid "7fd73eaf-0df8-5718-b843-1cd77b6090a3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314351}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8593de99-5055-5455-bd33-e38ccd6c9851" :question/math-academy-id "q-340496" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=8x+{e}^{-3x+5}.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "First, we express $y={e}^{-3x+5}$ as the composite function\n\n$$\ny={e}^{u},\\,u=-3x+5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{-3x+5}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8x+{e}^{-3x+5}) \\\\  & =8-3{e}^{-3x+5} \\\\  & =-3{e}^{-3x+5}+8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "970e1936-ac2b-534a-8ed4-97d799d35e63" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186313177}] :answer-field/correct {:answer/id #uuid "970e1936-ac2b-534a-8ed4-97d799d35e63" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186313177} :answer-field/id #uuid "f6a75775-f14f-5a3f-b4e1-1d6d0f134ccc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314681}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8caad42a-7778-5faa-ba43-6f75823507a3" :question/math-academy-id "q-340497" :question/problem "Find the slope $m$ of the tangent to the curve $y=-4{e}^{2-x}$ at the point where $x=2-ln⁡(3).$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-4{e}^{u},\\,u=2-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-4{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4{e}^{u}\\cdot (-1) \\\\  & =4{e}^{u} \\\\  & =4{e}^{2-x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=2-ln⁡(3)$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows\n\n$$\n\\begin{aligned}m=\\frac{\\text{d}y}{\\text{d}x}{|}_{x=2-ln⁡(3)} & =4{e}^{2-(2-ln⁡(3))} \\\\  & =4{e}^{ln⁡(3)} \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016b59fa-7dd1-5430-8a0d-9d17b256b87e" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}+3" :db/id #edb/ref 17592186326950} {:answer/id #uuid "1a09b33b-87d5-53a9-afee-f8e02962d4c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{4x-1}" :db/id #edb/ref 17592186327160} {:answer/id #uuid "35f572ac-b945-560e-89f5-d45ed6858e1a" :answer/type {:db/ident :answer.type/math} :answer/value "8{e}^{4x-1}+3" :db/id #edb/ref 17592186327403} {:answer/id #uuid "bab77687-86e3-5b97-960a-d832566921c3" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-2}" :db/id #edb/ref 17592186328563} {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611}] :answer-field/correct {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611} :answer-field/id #uuid "a2f4dd66-f6d3-5f50-8ce9-b004c416733f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329462}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd0c521a-06b7-559f-8b78-1152ec8cbcd7" :question/math-academy-id "q-48007" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-2{e}^{4x-1}+3.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-2{e}^{u}+3,\\,u=4x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 4 \\\\  & =-8{e}^{u} \\\\  & =-8{e}^{4x-1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a9f96f-82fe-597d-8f9c-ec74365b138f" :answer/type {:db/ident :answer.type/math} :answer/value "y=20ex\\cdot ln⁡(5)" :db/id #edb/ref 17592186327093} {:answer/id #uuid "341d8922-42cf-54fa-9393-c8b46d49f2db" :answer/type {:db/ident :answer.type/math} :answer/value "y=5ex" :db/id #edb/ref 17592186327386} {:answer/id #uuid "388c97a7-d581-5bec-9e47-92d37546c27d" :answer/type {:db/ident :answer.type/math} :answer/value "y=ex" :db/id #edb/ref 17592186327428} {:answer/id #uuid "569457c0-25f6-5141-b92a-2099597b16ef" :answer/type {:db/ident :answer.type/math} :answer/value "y=4ex" :db/id #edb/ref 17592186327685} {:answer/id #uuid "ae9ebfb2-3fe0-510b-bcbc-62f5f335f2b0" :answer/type {:db/ident :answer.type/math} :answer/value "y=20ex" :db/id #edb/ref 17592186328449}] :answer-field/correct {:answer/id #uuid "ae9ebfb2-3fe0-510b-bcbc-62f5f335f2b0" :answer/type {:db/ident :answer.type/math} :answer/value "y=20ex" :db/id #edb/ref 17592186328449} :answer-field/id #uuid "40293d79-60e8-50ac-8ded-e02ee37fe2cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329311}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b6722d36-cd26-5e84-89df-067b2a93b540" :question/math-academy-id "q-48657" :question/problem "Find the equation of the tangent to the curve $y=5{e}^{4x}$ at the point where $x=\\frac{1}{4}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=5{e}^{u},\\,u=4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=5{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =5{e}^{u}\\cdot 4 \\\\  & =20{e}^{u} \\\\  & =20{e}^{4x}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=\\frac{1}{4}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1/4} & ={(20{e}^{4x})|}_{x=1/4} \\\\  & =20{e}^{4(1/4)} \\\\  & =20e\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x={x}_{1}=\\frac{1}{4}$ is\n\n$$\n\\begin{aligned}{y}_{1} & ={(5{e}^{4x})|}_{x=1/4} \\\\  & =5{e}^{4(1/4)} \\\\  & =5e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5e & =20e(x-\\frac{1}{4}) \\\\ y-5e & =20ex-5e \\\\ y & =20ex\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3844e08c-6f9d-5cf6-a14e-cc030d9a01b0" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{5}" :db/id #edb/ref 17592186327425} {:answer/id #uuid "a89f0a93-4737-553c-9bbe-0034bad64d50" :answer/type {:db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186328394} {:answer/id #uuid "adef63ee-5bd4-5b53-b409-c9e308d93260" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328445} {:answer/id #uuid "c199d559-8e1d-58ab-8615-2d150595957a" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186328624} {:answer/id #uuid "d557a2be-477a-515d-91b2-d30108f2cab4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328801}] :answer-field/correct {:answer/id #uuid "adef63ee-5bd4-5b53-b409-c9e308d93260" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328445} :answer-field/id #uuid "d0d50368-ac7e-5bb9-86d5-22e01e5b4791" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329554}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fbf43982-c74c-540d-95a5-32f181ac4ea6" :question/math-academy-id "q-48658" :question/problem "Find the slope of the tangent to the curve $y=-3{e}^{5-x}$ at the point where $x=5-ln⁡(2).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-3{e}^{u},\\,u=5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot (-1) \\\\  & =3{e}^{u} \\\\  & =3{e}^{5-x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=5-ln⁡(2)$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=5-ln⁡(2)} & =3{e}^{5-(5-ln⁡(2))} \\\\  & =3{e}^{ln⁡(2)} \\\\  & =3\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b11bbd0f-79e3-5617-9dc5-99fa2d76e8bc" :answer/type {:db/ident :answer.type/math} :answer/value "4 e^{- x - 5}" :db/id #edb/ref 17592186546057}] :answer-field/correct {:answer/id #uuid "b11bbd0f-79e3-5617-9dc5-99fa2d76e8bc" :answer/type {:db/ident :answer.type/math} :answer/value "4 e^{- x - 5}" :db/id #edb/ref 17592186546057} :answer-field/id #uuid "dd651fe4-1b43-5b99-8d28-0d5282dfb011" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546070}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "05c06d18-760a-55d8-8f2d-5ce452eb9a43" :question/problem "Given that $y=-4{e}^{-5-x},$ find $\\frac{\\text{d}y}{\\text{d}x}$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-4{e}^{u},\\,u=-5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-4{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4{e}^{u}\\cdot (-1) \\\\  & =4{e}^{u} \\\\  & =4{e}^{-5-x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7367a804-a6e2-5743-81c8-c134ab3e3d40" :answer/type {:db/ident :answer.type/math} :answer/value "5 x^{4} + 5 e^{4 - 5 x}" :db/id #edb/ref 17592186546044}] :answer-field/correct {:answer/id #uuid "7367a804-a6e2-5743-81c8-c134ab3e3d40" :answer/type {:db/ident :answer.type/math} :answer/value "5 x^{4} + 5 e^{4 - 5 x}" :db/id #edb/ref 17592186546044} :answer-field/id #uuid "05118342-1d20-597e-be23-0e46a68395ca" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546024}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3b4c3b4f-ee6c-5156-ab65-2225d5039897" :question/problem "Calculate ${f}^{'}(x)$ if $f(x)={x}^{5}-{e}^{4-5x}.$\n{{field-1}}" :question/worked-solution "First, we express $y={e}^{4-5x}$ as the composite function\n\n$$\ny={e}^{u},\\,u=4-5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-5) \\\\  & =-5{e}^{u} \\\\  & =-5{e}^{4-5x}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}-{e}^{4-5x}) \\\\  & =5{x}^{4}-(-5{e}^{4-5x}) \\\\  & =5({x}^{4}+{e}^{4-5x}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5884aa2-d5ab-5f93-8897-89214c01b41a" :answer/type {:db/ident :answer.type/math} :answer/value "4 e^{4 x - 6} + 2" :db/id #edb/ref 17592186546074}] :answer-field/correct {:answer/id #uuid "e5884aa2-d5ab-5f93-8897-89214c01b41a" :answer/type {:db/ident :answer.type/math} :answer/value "4 e^{4 x - 6} + 2" :db/id #edb/ref 17592186546074} :answer-field/id #uuid "0222a237-315c-536e-ad55-3c45f766115e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546023}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "46c70445-c7fa-5e96-b9db-24423c65d9d2" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=2x+{e}^{4x-6}.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "First, we express $y={e}^{4x-6}$ as the composite function\n\n$$\ny={e}^{u},\\,u=4x-6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 4 \\\\  & =4{e}^{u} \\\\  & =4{e}^{4x-6}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+{e}^{4x-6}) \\\\  & =2+4{e}^{4x-6} \\\\  & =4{e}^{4x-6}+2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f3b1be-7698-59e3-aef0-38dd300bf844" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e x + 6 + 3 e" :db/id #edb/ref 17592186546026} {:answer/id #uuid "15a35f43-a4b7-584e-b180-d26a6e86a916" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e \\left(x + \\frac{7}{4}\\right) + 3 e" :db/id #edb/ref 17592186546028} {:answer/id #uuid "631a33cb-a6bf-5512-a0f9-90d28f159483" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e x - 18 e + 6" :db/id #edb/ref 17592186546042} {:answer/id #uuid "a9fdf460-843a-56b3-b956-5712f66fb700" :answer/type {:db/ident :answer.type/math} :answer/value "y=3 e \\left(x + \\frac{7}{4}\\right) + 6 + 3 e" :db/id #edb/ref 17592186546055} {:answer/id #uuid "d18d0448-5ee2-554a-b226-5c667ed7dbe9" :answer/type {:db/ident :answer.type/math} :answer/value "y=12 e \\left(x + \\frac{7}{4}\\right) + 6 + 3 e" :db/id #edb/ref 17592186546064}] :answer-field/correct {:answer/id #uuid "631a33cb-a6bf-5512-a0f9-90d28f159483" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e x - 18 e + 6" :db/id #edb/ref 17592186546042} :answer-field/id #uuid "e7fdb164-208e-53f2-a5fb-7d65ea9753b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546076}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "52a84e58-ee14-59cb-b2fc-5dc806f58a59" :question/problem "Find the equation of the tangent to the curve $y=3{e}^{-4x-6}+6$ at the point where $x=- \\frac{7}{4}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3{e}^{u}+6,\\,u=-4x-6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3{e}^{u}\\cdot (-4) \\\\  & =-12{e}^{u} \\\\  & =-12{e}^{-4x-6}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=- \\frac{7}{4}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=- \\frac{7}{4}} & =-12{e}^{-4x-6}{|}_{x=- \\frac{7}{4}} \\\\ & =-12{e}^{(-4)\\left(- \\frac{7}{4}\\right)-6} \\\\ & =- 12 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=- \\frac{7}{4}$ is\n\n$$\n\\begin{aligned}y_1 & =(3{e}^{-4x-6}+6){|}_{x=- \\frac{7}{4}} \\\\ & =3{e}^{(-4)\\left(- \\frac{7}{4}\\right)-6}+6 \\\\ & =6 + 3 e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(6 + 3 e) & =(- 12 e)(x-\\left(- \\frac{7}{4}\\right)) \\\\ y-(6 + 3 e) & =- 12 e x-(21 e) \\\\ y & =- 12 e x - 18 e + 6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00fd1e00-d8ad-53a1-a4ce-5e09d463daa6" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 2 e \\left(x - \\frac{1}{3}\\right) - 2 e + 3" :db/id #edb/ref 17592186546022} {:answer/id #uuid "0d3a07ef-c7b6-5bda-8a5f-02f36078cba2" :answer/type {:db/ident :answer.type/math} :answer/value "y=6 e x - 4 e + 3" :db/id #edb/ref 17592186546027} {:answer/id #uuid "386252c4-f73b-5706-99ea-15795c9c3a0c" :answer/type {:db/ident :answer.type/math} :answer/value "y=6 e \\left(x - \\frac{1}{3}\\right) - 2 e" :db/id #edb/ref 17592186546031} {:answer/id #uuid "9237bc66-6da2-5b5f-af2c-8e5ce3b5744d" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 6 e \\left(x - \\frac{1}{3}\\right) - 2 e + 3" :db/id #edb/ref 17592186546049} {:answer/id #uuid "d0bc922d-bb0e-5a70-b6c9-97af108437ea" :answer/type {:db/ident :answer.type/math} :answer/value "y=6 e x - 2 e + 3" :db/id #edb/ref 17592186546063}] :answer-field/correct {:answer/id #uuid "0d3a07ef-c7b6-5bda-8a5f-02f36078cba2" :answer/type {:db/ident :answer.type/math} :answer/value "y=6 e x - 4 e + 3" :db/id #edb/ref 17592186546027} :answer-field/id #uuid "b0779349-01a1-5902-a3ac-f744fc1c935b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546056}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7fd12a30-30af-5a77-a4c8-bf313d7546d2" :question/problem "Find the equation of the tangent to the curve $y=-2{e}^{-3x+2}+3$ at the point where $x=\\frac{1}{3}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-2{e}^{u}+3,\\,u=-3x+2.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot (-3) \\\\  & =6{e}^{u} \\\\  & =6{e}^{-3x+2}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=\\frac{1}{3}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=\\frac{1}{3}} & =6{e}^{-3x+2}{|}_{x=\\frac{1}{3}} \\\\ & =6{e}^{(-3)\\left(\\frac{1}{3}\\right)+2} \\\\ & =6 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=\\frac{1}{3}$ is\n\n$$\n\\begin{aligned}y_1 & =(-2{e}^{-3x+2}+3){|}_{x=\\frac{1}{3}} \\\\ & =-2{e}^{(-3)\\left(\\frac{1}{3}\\right)+2}+3 \\\\ & =3 - 2 e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(3 - 2 e) & =(6 e)(x-\\left(\\frac{1}{3}\\right)) \\\\ y-(3 - 2 e) & =6 e x-(2 e) \\\\ y & =6 e x - 4 e + 3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e2c2b01-8349-508f-bf8e-50f3ae9bc58a" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 e^{- 4 x}" :db/id #edb/ref 17592186546029} {:answer/id #uuid "5c1ee9ed-13be-5d25-80da-1864c503d155" :answer/type {:db/ident :answer.type/math} :answer/value "e^{- 4 x}" :db/id #edb/ref 17592186546041} {:answer/id #uuid "944f0d6a-3b60-545c-b2e8-97b3032ade29" :answer/type {:db/ident :answer.type/math} :answer/value "x e^{- 4 x}" :db/id #edb/ref 17592186546050} {:answer/id #uuid "d7f84086-3f8f-549a-8676-8413302b70c8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{e^{- 4 x}}{4}" :db/id #edb/ref 17592186546067} {:answer/id #uuid "f21accce-80c4-5fb5-9b8e-0ed03436a5cc" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 x e^{- 4 x}" :db/id #edb/ref 17592186546078}] :answer-field/correct {:answer/id #uuid "2e2c2b01-8349-508f-bf8e-50f3ae9bc58a" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 e^{- 4 x}" :db/id #edb/ref 17592186546029} :answer-field/id #uuid "31ba4f18-563e-5f43-91f8-a07770c36c56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546030}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9f144a62-dd63-5191-a104-7945db3746f9" :question/problem "Given that $f(x) = e^{-4x}$, find $\\frac{df}{dx}$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={e}^{u},\\,u=-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-4) \\\\  & =-4{e}^{u} \\\\  & =-4{e}^{-4x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b20bc36-ce98-5edb-9e51-7375356be643" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 30 e \\left(x - \\frac{5}{6}\\right) + 1 + 5 e" :db/id #edb/ref 17592186546032} {:answer/id #uuid "3bfaf069-a4d6-5131-a87d-a208594f2c61" :answer/type {:db/ident :answer.type/math} :answer/value "y=30 e x + 1 + 5 e" :db/id #edb/ref 17592186546034} {:answer/id #uuid "72048a0c-73ca-54b2-aa19-72248fb1e5b6" :answer/type {:db/ident :answer.type/math} :answer/value "y=5 e \\left(x - \\frac{5}{6}\\right) + 1 + 5 e" :db/id #edb/ref 17592186546043} {:answer/id #uuid "750cf673-67dd-5803-97c5-520a46254372" :answer/type {:db/ident :answer.type/math} :answer/value "y=30 e \\left(x - \\frac{5}{6}\\right) + 5 e" :db/id #edb/ref 17592186546045} {:answer/id #uuid "eb9790a2-417d-5f52-a1e3-b34bb0797907" :answer/type {:db/ident :answer.type/math} :answer/value "y=30 e x - 20 e + 1" :db/id #edb/ref 17592186546077}] :answer-field/correct {:answer/id #uuid "eb9790a2-417d-5f52-a1e3-b34bb0797907" :answer/type {:db/ident :answer.type/math} :answer/value "y=30 e x - 20 e + 1" :db/id #edb/ref 17592186546077} :answer-field/id #uuid "4506d1a2-b6f8-5a68-becb-87dba57a7620" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546036}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b32ededd-4f82-5701-b090-5a6b3fd40512" :question/problem "Find the equation of the tangent to the curve $y=5{e}^{6x-4}+1$ at the point where $x=\\frac{5}{6}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=5{e}^{u}+1,\\,u=6x-4.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=5{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=6.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =5{e}^{u}\\cdot 6 \\\\  & =30{e}^{u} \\\\  & =30{e}^{6x-4}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=\\frac{5}{6}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=\\frac{5}{6}} & =30{e}^{6x-4}{|}_{x=\\frac{5}{6}} \\\\ & =30{e}^{(6)\\left(\\frac{5}{6}\\right)-4} \\\\ & =30 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=\\frac{5}{6}$ is\n\n$$\n\\begin{aligned}y_1 & =(5{e}^{6x-4}+1){|}_{x=\\frac{5}{6}} \\\\ & =5{e}^{(6)\\left(\\frac{5}{6}\\right)-4}+1 \\\\ & =1 + 5 e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(1 + 5 e) & =(30 e)(x-\\left(\\frac{5}{6}\\right)) \\\\ y-(1 + 5 e) & =30 e x-(25 e) \\\\ y & =30 e x - 20 e + 1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4401eafb-fa33-5c95-b049-85b630f2f47d" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e x - 4 e - 3" :db/id #edb/ref 17592186546035} {:answer/id #uuid "97abff75-225b-5630-aa11-86faced36582" :answer/type {:db/ident :answer.type/math} :answer/value "y=12 e \\left(x - 2\\right) - 4 e - 3" :db/id #edb/ref 17592186546051} {:answer/id #uuid "bffd7f70-58d6-5df1-9b3d-3f23c0d090b6" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e x - 3 + 20 e" :db/id #edb/ref 17592186546060} {:answer/id #uuid "d3230802-1784-5568-9bac-fcc769b517fc" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e \\left(x - 2\\right) - 4 e" :db/id #edb/ref 17592186546065} {:answer/id #uuid "e5850b7d-6ef6-55a7-b9dc-7cf2a4da7531" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 4 e \\left(x - 2\\right) - 4 e - 3" :db/id #edb/ref 17592186546073}] :answer-field/correct {:answer/id #uuid "bffd7f70-58d6-5df1-9b3d-3f23c0d090b6" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 e x - 3 + 20 e" :db/id #edb/ref 17592186546060} :answer-field/id #uuid "c0fece4a-a8bb-548d-abc6-f90d6ed2350c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546061}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c6bcf79b-eac1-52f9-ad10-1945c83effb0" :question/problem "Find the equation of the tangent to the curve $y=-4{e}^{3x-5}-3$ at the point where $x=2.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-4{e}^{u}-3,\\,u=3x-5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-4{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4{e}^{u}\\cdot 3 \\\\  & =-12{e}^{u} \\\\  & =-12{e}^{3x-5}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=2} & =-12{e}^{3x-5}{|}_{x=2} \\\\ & =-12{e}^{(3)(2)-5} \\\\ & =- 12 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=2$ is\n\n$$\n\\begin{aligned}y_1 & =(-4{e}^{3x-5}-3){|}_{x=2} \\\\ & =-4{e}^{(3)(2)-5}-3 \\\\ & =- 4 e - 3.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(- 4 e - 3) & =(- 12 e)(x-(2)) \\\\ y-(- 4 e - 3) & =- 12 e x-(- 24 e) \\\\ y & =- 12 e x - 3 + 20 e.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c3f86e4-f000-591a-af10-3b0f2e76f24a" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 2 e \\left(x - 3\\right) - 2 e - 3" :db/id #edb/ref 17592186546046} {:answer/id #uuid "a136be05-5ae5-5cba-ba24-898cc2845c42" :answer/type {:db/ident :answer.type/math} :answer/value "y=4 e \\left(x - 3\\right) - 2 e - 3" :db/id #edb/ref 17592186546053} {:answer/id #uuid "b98c737b-5fe4-5f99-b515-19aeda98c743" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 4 e x - 2 e - 3" :db/id #edb/ref 17592186546059} {:answer/id #uuid "dbf426b4-1cd9-558c-9feb-975ace11ad79" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 4 e x - 3 + 10 e" :db/id #edb/ref 17592186546069} {:answer/id #uuid "fe9ac606-867e-5fe4-86a8-ece4d77edd4c" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 4 e \\left(x - 3\\right) - 2 e" :db/id #edb/ref 17592186546079}] :answer-field/correct {:answer/id #uuid "dbf426b4-1cd9-558c-9feb-975ace11ad79" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 4 e x - 3 + 10 e" :db/id #edb/ref 17592186546069} :answer-field/id #uuid "df16da41-2070-5b0b-a923-30c6662c499b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546071}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d323abf4-feef-5783-8c9c-89b3cff14f40" :question/problem "Find the equation of the tangent to the curve $y=-2{e}^{2x-5}-3$ at the point where $x=3.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-2{e}^{u}-3,\\,u=2x-5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 2 \\\\  & =-4{e}^{u} \\\\  & =-4{e}^{2x-5}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=3$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=3} & =-4{e}^{2x-5}{|}_{x=3} \\\\ & =-4{e}^{(2)(3)-5} \\\\ & =- 4 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=3$ is\n\n$$\n\\begin{aligned}y_1 & =(-2{e}^{2x-5}-3){|}_{x=3} \\\\ & =-2{e}^{(2)(3)-5}-3 \\\\ & =- 2 e - 3.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(- 2 e - 3) & =(- 4 e)(x-(3)) \\\\ y-(- 2 e - 3) & =- 4 e x-(- 12 e) \\\\ y & =- 4 e x - 3 + 10 e.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f3504cb-45f2-555b-80a1-81a0a0f42939" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4 x + 7\\right) e^{4 x + 7}" :db/id #edb/ref 17592186546038} {:answer/id #uuid "576283f7-d522-5cbc-8f21-65c4b15b8858" :answer/type {:db/ident :answer.type/math} :answer/value "4 x e^{4 x + 7}" :db/id #edb/ref 17592186546040} {:answer/id #uuid "8fe2cbd2-f59b-5b92-9bbb-c00d3642dbdd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{4 x + 7}}{4}" :db/id #edb/ref 17592186546048} {:answer/id #uuid "a34e7884-71c6-53d5-84dd-7dca5dc3d217" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4 x + 7}" :db/id #edb/ref 17592186546054} {:answer/id #uuid "e7c99c8a-3c47-5367-bb23-9f844b5ea84a" :answer/type {:db/ident :answer.type/math} :answer/value "4 e^{4 x + 7}" :db/id #edb/ref 17592186546075}] :answer-field/correct {:answer/id #uuid "e7c99c8a-3c47-5367-bb23-9f844b5ea84a" :answer/type {:db/ident :answer.type/math} :answer/value "4 e^{4 x + 7}" :db/id #edb/ref 17592186546075} :answer-field/id #uuid "d88ed9d7-c7fa-5b42-a090-ad8da7bf1370" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546068}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e1a53e4b-cb95-5fd7-83e2-0c854f6893c1" :question/problem "Given that $f(x) = e^{4x + 7}$, find $\\frac{df}{dx}$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={e}^{u},\\,u=4x+7.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 4 \\\\  & =4{e}^{u} \\\\  & =4{e}^{4x+7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186610438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6156880b-52c6-5bdc-9c2e-214c28010017" :answer/type {:db/ident :answer.type/math} :answer/value "- 10 e^{- 6 x - 4}" :db/id #edb/ref 17592186610448} {:answer/id #uuid "85f39285-5979-5f26-9c13-6279224ea917" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 e^{- 6 x - 4}" :db/id #edb/ref 17592186610453} {:answer/id #uuid "d54d8ce4-0272-5122-8b5f-d147266f1933" :answer/type {:db/ident :answer.type/math} :answer/value "6 e^{- 6 x - 4}" :db/id #edb/ref 17592186610464} {:answer/id #uuid "ee874359-fc83-5033-bc87-1079cd37b759" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 e^{- 6 x - 4}" :db/id #edb/ref 17592186610467} {:answer/id #uuid "f1580a99-076a-5df3-9a20-6df72ad588ec" :answer/type {:db/ident :answer.type/math} :answer/value "12 e^{- 6 x - 4}" :db/id #edb/ref 17592186610468}] :answer-field/correct {:answer/id #uuid "f1580a99-076a-5df3-9a20-6df72ad588ec" :answer/type {:db/ident :answer.type/math} :answer/value "12 e^{- 6 x - 4}" :db/id #edb/ref 17592186610468} :answer-field/id #uuid "a1261795-f79c-5f9c-9108-fe798e6e4bd1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610457}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0864cf01-5370-55e0-a300-a4fb8f259792" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-2{e}^{-6x-4}+2.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-2{e}^{u}+2,\\,u=-6x-4.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-6.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot (-6) \\\\  & =12{e}^{u} \\\\  & =12{e}^{-6x-4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186610441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43c5e447-89e7-5391-a098-c71461de5b95" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 e^{2 x - 4}" :db/id #edb/ref 17592186610445} {:answer/id #uuid "84c8ec94-a775-5f7e-b54a-2ea5e7208145" :answer/type {:db/ident :answer.type/math} :answer/value "- 12 e^{2 x - 4}" :db/id #edb/ref 17592186610452} {:answer/id #uuid "b46d18df-a44a-5341-a49a-344afbfe2174" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 e^{2 x - 4}" :db/id #edb/ref 17592186610459} {:answer/id #uuid "bfb30be3-47ae-5546-979f-4e0f2b801fc4" :answer/type {:db/ident :answer.type/math} :answer/value "18 e^{2 x - 4}" :db/id #edb/ref 17592186610461} {:answer/id #uuid "e751ff94-b294-52bd-9fa4-915e8d14a319" :answer/type {:db/ident :answer.type/math} :answer/value "9 e^{2 x - 4}" :db/id #edb/ref 17592186610466}] :answer-field/correct {:answer/id #uuid "b46d18df-a44a-5341-a49a-344afbfe2174" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 e^{2 x - 4}" :db/id #edb/ref 17592186610459} :answer-field/id #uuid "01612884-385b-5594-af4f-0fd4fdfd5daa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610437}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "222af1dd-8c2b-5df0-87c0-f198b956462a" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-3{e}^{2x-4}+8.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-3{e}^{u}+8,\\,u=2x-4.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot 2 \\\\  & =-6{e}^{u} \\\\  & =-6{e}^{2x-4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186610444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f4e93c-5746-5e9a-bc0a-47985096bbf7" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 e^{- 6 x}" :db/id #edb/ref 17592186610443} {:answer/id #uuid "7826582c-cdbb-5dac-ade4-dea0796046a8" :answer/type {:db/ident :answer.type/math} :answer/value "6 e^{- 6 x}" :db/id #edb/ref 17592186610450} {:answer/id #uuid "b6b23144-1d29-51a6-8624-78b3844d0519" :answer/type {:db/ident :answer.type/math} :answer/value "3 e^{- 6 x}" :db/id #edb/ref 17592186610460} {:answer/id #uuid "c50414ae-8214-5c23-b8c3-97ae02589b66" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 e^{- 6 x}" :db/id #edb/ref 17592186610462} {:answer/id #uuid "cacead59-6fff-5ec7-a1d4-924e70f89b03" :answer/type {:db/ident :answer.type/math} :answer/value "- 5 e^{- 6 x}" :db/id #edb/ref 17592186610463}] :answer-field/correct {:answer/id #uuid "c50414ae-8214-5c23-b8c3-97ae02589b66" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 e^{- 6 x}" :db/id #edb/ref 17592186610462} :answer-field/id #uuid "7ca2ad56-f6b1-52d7-a702-5b7f78ac4a46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610451}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3984c43d-d49f-5ec1-b311-63a873f8cbb8" :question/problem "Given that $f(x) = e^{-6x}$, find $\\frac{df}{dx}$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={e}^{u},\\,u=-6x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-6.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\t