^{u} \\\\  & =12{e}^{-6x-3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186610469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc3dde6-2d5b-5f3e-a882-4087153f2d1b" :answer/type {:db/ident :answer.type/math} :answer/value "3 e^{6 x + 7}" :db/id #edb/ref 17592186610439} {:answer/id #uuid "94ba8c80-ad2a-502e-8e68-45416cbb1afb" :answer/type {:db/ident :answer.type/math} :answer/value "6 e^{6 x + 7}" :db/id #edb/ref 17592186610455} {:answer/id #uuid "b326d70d-11d8-57e7-93b7-54c25aebf384" :answer/type {:db/ident :answer.type/math} :answer/value "4 e^{6 x + 7}" :db/id #edb/ref 17592186610458} {:answer/id #uuid "d57faefe-8540-5211-8242-819b10e7989f" :answer/type {:db/ident :answer.type/math} :answer/value "2 e^{6 x + 7}" :db/id #edb/ref 17592186610465} {:answer/id #uuid "f5bbc0e5-922f-50ff-a74e-2e2d55bb53a9" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 e^{6 x + 7}" :db/id #edb/ref 17592186610470}] :answer-field/correct {:answer/id #uuid "94ba8c80-ad2a-502e-8e68-45416cbb1afb" :answer/type {:db/ident :answer.type/math} :answer/value "6 e^{6 x + 7}" :db/id #edb/ref 17592186610455} :answer-field/id #uuid "485fe0e0-0492-5f0a-9c96-8383391a20d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610446}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f4ca25e8-79e5-5523-a975-f95345c4c6b4" :question/problem "Given that $f(x)={e}^{6x+7},$ find $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=6x+7.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=6.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 6 \\\\  & =6{e}^{u} \\\\  & =6{e}^{6x+7}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}]}
