e{\\left(\\frac{x - 7}{4 x}\\right)}_{P(x)}y=\\underbrace{\\frac{6 x + 7}{4 x}}_{Q(x)}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=\\frac{x - 7}{4 x}$ and $Q(x)=\\frac{6 x + 7}{4 x}.$"}] [{:db/id #edb/ref 17592186693253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39069046-e53c-5c06-a960-3a76bf1371ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (6 x - 4)}{8 x}=\\frac{x + 7}{8 x}" :db/id #edb/ref 17592186693241} {:answer/id #uuid "3b736b82-0b6a-50eb-8c40-7c056a6c11fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (4 x - 6)}{8 x}=\\frac{x + 7}{8 x}" :db/id #edb/ref 17592186693243} {:answer/id #uuid "7cc4e03f-763a-5340-ba05-c4f1ca2745f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (x - 2)}{8 x}=\\frac{x + 7}{8 x}" :db/id #edb/ref 17592186693244} {:answer/id #uuid "94aff677-45f9-586d-a949-7e75b9b9bdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (7 x - 5)}{8 x}=\\frac{x + 7}{8 x}" :db/id #edb/ref 17592186693246} {:answer/id #uuid "d110ec04-40fa-5e34-8314-3b21bedef877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (8 x - 3)}{8 x}=\\frac{x + 7}{8 x}" :db/id #edb/ref 17592186693257}] :answer-field/correct {:answer/id #uuid "39069046-e53c-5c06-a960-3a76bf1371ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (6 x - 4)}{8 x}=\\frac{x + 7}{8 x}" :db/id #edb/ref 17592186693241} :answer-field/id #uuid "38092400-bfcc-50be-a61a-e54d74f90ed4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693240}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bec649f3-3092-5468-a1d1-092d56ad44a2" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n8 x\\frac{\\text{d}y}{\\text{d}x}+6 x y-x=7+4 y\\,.\n$$\n\nAssume $x\\ne 0$." :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}&8 x\\frac{\\text{d}y}{\\text{d}x}+6 x y-x=7+4 y \\\\ &8 x\\frac{\\text{d}y}{\\text{d}x}+(6 x-4)y=7+x \\\\ &\\frac{\\text{d}y}{\\text{d}x}+\\underbrace{\\left(\\frac{6 x - 4}{8 x}\\right)}_{P(x)}y=\\underbrace{\\frac{x + 7}{8 x}}_{Q(x)}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=\\frac{6 x - 4}{8 x}$ and $Q(x)=\\frac{x + 7}{8 x}.$"}] [{:db/id #edb/ref 17592186693255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4b4273-5736-5764-97dc-4f8c5a1e8785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (5 x - 5)}{5 x}=\\frac{3 x + 2}{5 x}" :db/id #edb/ref 17592186693235} {:answer/id #uuid "1215eed0-440b-509e-b3ed-f1756559af99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (2 x - 4)}{5 x}=\\frac{3 x + 2}{5 x}" :db/id #edb/ref 17592186693236} {:answer/id #uuid "bfc79838-cec7-5333-bca4-33a0b5d14e29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (6 x - 2)}{5 x}=\\frac{3 x + 2}{5 x}" :db/id #edb/ref 17592186693254} {:answer/id #uuid "ced68bea-ad80-5624-be02-267e94fd9393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (4 x - 8)}{5 x}=\\frac{3 x + 2}{5 x}" :db/id #edb/ref 17592186693256} {:answer/id #uuid "fcef5da3-23d4-5d09-abdb-a407e918b3fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (7 x - 3)}{5 x}=\\frac{3 x + 2}{5 x}" :db/id #edb/ref 17592186693261}] :answer-field/correct {:answer/id #uuid "0d4b4273-5736-5764-97dc-4f8c5a1e8785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (5 x - 5)}{5 x}=\\frac{3 x + 2}{5 x}" :db/id #edb/ref 17592186693235} :answer-field/id #uuid "0352cd86-cae7-5f23-a003-cf00d3f50057" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693234}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c50b9ede-9083-5da0-9379-b94344807bef" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n5 x\\frac{\\text{d}y}{\\text{d}x}+5 x y-3 x=2+5 y\\,.\n$$\n\nAssume $x\\ne 0$." :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}&5 x\\frac{\\text{d}y}{\\text{d}x}+5 x y-3 x=2+5 y \\\\ &5 x\\frac{\\text{d}y}{\\text{d}x}+(5 x-5)y=2+3 x \\\\ &\\frac{\\text{d}y}{\\text{d}x}+\\underbrace{\\left(\\frac{5 x - 5}{5 x}\\right)}_{P(x)}y=\\underbrace{\\frac{3 x + 2}{5 x}}_{Q(x)}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=\\frac{5 x - 5}{5 x}$ and $Q(x)=\\frac{3 x + 2}{5 x}.$"}] [{:db/id #edb/ref 17592186693467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f9454ca-1588-59f0-bd0f-81864e279071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})(3)=(x^{2})((\\cos(x))y)" :db/id #edb/ref 17592186693470} {:answer/id #uuid "73098901-f65c-5ae2-a0d9-8c406eda9ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\cos(x))y)=(x^{2})(\\ln(x))" :db/id #edb/ref 17592186693480} {:answer/id #uuid "bd9fa415-9fef-5406-bc39-b8d7ed97904c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((e^{x})\\sqrt{y})=(x^{2})(2)" :db/id #edb/ref 17592186693484} {:answer/id #uuid "e4536e57-e65f-5177-ba99-4bd0af1ca62c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\sin(x))y)=(x^{2})(\\ln(x))" :db/id #edb/ref 17592186693494} {:answer/id #uuid "feac1a08-764e-50d8-a18b-6fbeffdccc25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})(\\ln(x))=(x^{2})((2)y)" :db/id #edb/ref 17592186693500}] :answer-field/correct {:answer/id #uuid "bd9fa415-9fef-5406-bc39-b8d7ed97904c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((e^{x})\\sqrt{y})=(x^{2})(2)" :db/id #edb/ref 17592186693484} :answer-field/id #uuid "6bbf0a57-daf9-51da-8836-daaee21f5ada" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693476}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0c1e2ab9-3568-5281-9ef2-e10ee886fc1f" :question/problem "Which of the following is **NOT** a first-order linear ordinary differential equation?\n\nClassify on local intervals where the expressions are defined and $x>0$." :question/worked-solution "A first-order linear ODE can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((e^{x})\\sqrt{y})&=(x^{2})(2) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(e^{x})\\sqrt{y}&=2 \\\\ \\frac{\\text{d}y}{\\text{d}x}&=2-((e^{x})\\sqrt{y})\\end{aligned}\n$$\n\nAfter collecting terms, a square root of $y$ remains. The right-hand side is not of the form $Q(x)-P(x)y$, so this is not a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\cos(x))y)&=(x^{2})(\\ln(x)) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(\\cos(x))y&=\\ln(x)\\end{aligned}\n$$\n\nThis is standard form with $P(x)=\\cos(x)$ and $Q(x)=\\ln(x)$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\sin(x))y)&=(x^{2})(\\ln(x)) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(\\sin(x))y&=\\ln(x)\\end{aligned}\n$$\n\nThis is standard form with $P(x)=\\sin(x)$ and $Q(x)=\\ln(x)$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})(\\ln(x))&=(x^{2})((2)y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\ln(x)&=(2)y \\\\ \\frac{\\text{d}y}{\\text{d}x}-(2)y&=-(\\ln(x))\\end{aligned}\n$$\n\nThis is standard form with $P(x)=-(2)$ and $Q(x)=-(\\ln(x))$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})(3)&=(x^{2})((\\cos(x))y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+3&=(\\cos(x))y \\\\ \\frac{\\text{d}y}{\\text{d}x}-(\\cos(x))y&=-(3)\\end{aligned}\n$$\n\nThis is standard form with $P(x)=-(\\cos(x))$ and $Q(x)=-(3)$, both depending only on $x$. It is a first-order linear ODE.\n\nTherefore select\n\n$$\n(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((e^{x})\\sqrt{y})=(x^{2})(2)\n$$"}] [{:db/id #edb/ref 17592186693468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "597df24b-9e0f-5624-a6da-654e9808551b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((2)y)=(2)((x)y)" :db/id #edb/ref 17592186693473} {:answer/id #uuid "71c5b6be-e9bf-5f22-a9d5-c2cd17b36430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)(3x)=(2)((x)y)" :db/id #edb/ref 17592186693479} {:answer/id #uuid "7b827c91-4313-5fa4-b56e-3d63f23de72d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)(3x)=(2)((\\ln(x))y)" :db/id #edb/ref 17592186693481} {:answer/id #uuid "c8cd2174-32a7-5e06-9adc-f16e62fc1236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((x)\\ln(xy))=(2)(\\sin(x))" :db/id #edb/ref 17592186693485} {:answer/id #uuid "ea6559f8-ceee-5bae-a2b1-1a5bd6853fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((\\sin(x))y)=(2)(e^{x})" :db/id #edb/ref 17592186693496}] :answer-field/correct {:answer/id #uuid "c8cd2174-32a7-5e06-9adc-f16e62fc1236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((x)\\ln(xy))=(2)(\\sin(x))" :db/id #edb/ref 17592186693485} :answer-field/id #uuid "6ee295bf-4faa-52a3-a483-dd8142171644" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693478}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d88d270-333a-5436-8b27-c3044587b5c0" :question/problem "Which of the following is **NOT** a first-order linear ordinary differential equation?\n\nClassify on local intervals where the expressions are defined and $x>0$." :question/worked-solution "A first-order linear ODE can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\n$$\n\\begin{aligned}(2)\\frac{\\text{d}y}{\\text{d}x}+(2)(3x)&=(2)((x)y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+3x&=(x)y \\\\ \\frac{\\text{d}y}{\\text{d}x}-(x)y&=-(3x)\\end{aligned}\n$$\n\nThis is standard form with $P(x)=-(x)$ and $Q(x)=-(3x)$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((x)\\ln(xy))&=(2)(\\sin(x)) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(x)\\ln(xy)&=\\sin(x) \\\\ \\frac{\\text{d}y}{\\text{d}x}&=\\sin(x)-((x)\\ln(xy))\\end{aligned}\n$$\n\nAfter collecting terms, a logarithm depending on $y$ remains. The right-hand side is not of the form $Q(x)-P(x)y$, so this is not a first-order linear ODE.\n\n$$\n\\begin{aligned}(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((2)y)&=(2)((x)y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(2)y&=(x)y \\\\ \\frac{\\text{d}y}{\\text{d}x}+(2-x)y&=0\\end{aligned}\n$$\n\nThis is standard form with $P(x)=(2)-(x)$ and $Q(x)=0$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((\\sin(x))y)&=(2)(e^{x}) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(\\sin(x))y&=e^{x}\\end{aligned}\n$$\n\nThis is standard form with $P(x)=\\sin(x)$ and $Q(x)=e^{x}$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(2)\\frac{\\text{d}y}{\\text{d}x}+(2)(3x)&=(2)((\\ln(x))y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+3x&=(\\ln(x))y \\\\ \\frac{\\text{d}y}{\\text{d}x}-(\\ln(x))y&=-(3x)\\end{aligned}\n$$\n\nThis is standard form with $P(x)=-(\\ln(x))$ and $Q(x)=-(3x)$, both depending only on $x$. It is a first-order linear ODE.\n\nTherefore select\n\n$$\n(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((x)\\ln(xy))=(2)(\\sin(x))\n$$"}] [{:db/id #edb/ref 17592186693472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a490a3-d2c6-5e21-aa28-9f031baf2437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((x)y^{2})=(x)(3x)" :db/id #edb/ref 17592186693469} {:answer/id #uuid "48060afe-f3e4-57a9-967d-6cea08dd8ae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((\\ln(x))y)=(x)(3)" :db/id #edb/ref 17592186693471} {:answer/id #uuid "695087ef-2614-5d46-98bc-a43c47815209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((3)y)=(x)(2x)" :db/id #edb/ref 17592186693475} {:answer/id #uuid "8c6ef35c-7740-5743-aca3-ee2541eb5f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x)\\frac{\\text{d}y}{\\text{d}x}+(x)(2)=(x)((x^{2})y)" :db/id #edb/ref 17592186693482} {:answer/id #uuid "e230af04-c786-54ab-a11b-2efac04bdec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((x^{2})y)=(x)((\\ln(x))y)" :db/id #edb/ref 17592186693493}] :answer-field/correct {:answer/id #uuid "21a490a3-d2c6-5e21-aa28-9f031baf2437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((x)y^{2})=(x)(3x)" :db/id #edb/ref 17592186693469} :answer-field/id #uuid "df57e840-2ba6-53e8-a7bb-70e01dde0992" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693492}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5894c859-5218-52ff-8c5b-10fea7c6c05a" :question/problem "Which of the following is **NOT** a first-order linear ordinary differential equation?\n\nClassify on local intervals where the expressions are defined and $x>0$." :question/worked-solution "A first-order linear ODE can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\n$$\n\\begin{aligned}(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((\\ln(x))y)&=(x)(3) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(\\ln(x))y&=3\\end{aligned}\n$$\n\nThis is standard form with $P(x)=\\ln(x)$ and $Q(x)=3$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x)\\frac{\\text{d}y}{\\text{d}x}+(x)(2)&=(x)((x^{2})y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+2&=(x^{2})y \\\\ \\frac{\\text{d}y}{\\text{d}x}-(x^{2})y&=-(2)\\end{aligned}\n$$\n\nThis is standard form with $P(x)=-(x^{2})$ and $Q(x)=-(2)$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((x^{2})y)&=(x)((\\ln(x))y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(x^{2})y&=(\\ln(x))y \\\\ \\frac{\\text{d}y}{\\text{d}x}+(x^{2}-\\ln(x))y&=0\\end{aligned}\n$$\n\nThis is standard form with $P(x)=(x^{2})-(\\ln(x))$ and $Q(x)=0$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((3)y)&=(x)(2x) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(3)y&=2x\\end{aligned}\n$$\n\nThis is standard form with $P(x)=3$ and $Q(x)=2x$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((x)y^{2})&=(x)(3x) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(x)y^{2}&=3x \\\\ \\frac{\\text{d}y}{\\text{d}x}&=3x-((x)y^{2})\\end{aligned}\n$$\n\nAfter collecting terms, a quadratic term remains. The right-hand side is not of the form $Q(x)-P(x)y$, so this is not a first-order linear ODE.\n\nTherefore select\n\n$$\n(x)\\frac{\\text{d}y}{\\text{d}x}+(x)((x)y^{2})=(x)(3x)\n$$"}] [{:db/id #edb/ref 17592186693483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62918806-e639-5e72-8541-d756470d2957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((x)y)=(x^{2})((2x)y)" :db/id #edb/ref 17592186693474} {:answer/id #uuid "6d5093f3-e9f4-539f-9020-1559d773ab3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\ln(x))y)=(x^{2})(e^{x})" :db/id #edb/ref 17592186693477} {:answer/id #uuid "ce27cc52-4bfc-5781-afc0-44543d2a0d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\ln(x))y)=(x^{2})(\\sin(x))" :db/id #edb/ref 17592186693486} {:answer/id #uuid "ce3d2d36-29b9-5858-83fe-a33be0eed016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((x)\\sin(y))=(x^{2})(2)" :db/id #edb/ref 17592186693487} {:answer/id #uuid "fa23a28e-b096-5458-bf73-eff75090d9bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((2x)y)=(x^{2})((\\sin(x))y)" :db/id #edb/ref 17592186693498}] :answer-field/correct {:answer/id #uuid "ce3d2d36-29b9-5858-83fe-a33be0eed016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((x)\\sin(y))=(x^{2})(2)" :db/id #edb/ref 17592186693487} :answer-field/id #uuid "ea19ce81-9a82-528a-82b7-8ae74ad59bc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693495}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa4f970a-06d4-5fce-8dec-566d3655f6da" :question/problem "Which of the following is **NOT** a first-order linear ordinary differential equation?\n\nClassify on local intervals where the expressions are defined and $x>0$." :question/worked-solution "A first-order linear ODE can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((x)\\sin(y))&=(x^{2})(2) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(x)\\sin(y)&=2 \\\\ \\frac{\\text{d}y}{\\text{d}x}&=2-((x)\\sin(y))\\end{aligned}\n$$\n\nAfter collecting terms, a sine of $y$ remains. The right-hand side is not of the form $Q(x)-P(x)y$, so this is not a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((2x)y)&=(x^{2})((\\sin(x))y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(2x)y&=(\\sin(x))y \\\\ \\frac{\\text{d}y}{\\text{d}x}+(2x-\\sin(x))y&=0\\end{aligned}\n$$\n\nThis is standard form with $P(x)=(2x)-(\\sin(x))$ and $Q(x)=0$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((x)y)&=(x^{2})((2x)y) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(x)y&=(2x)y \\\\ \\frac{\\text{d}y}{\\text{d}x}+(x-2x)y&=0\\end{aligned}\n$$\n\nThis is standard form with $P(x)=(x)-(2x)$ and $Q(x)=0$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\ln(x))y)&=(x^{2})(e^{x}) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(\\ln(x))y&=e^{x}\\end{aligned}\n$$\n\nThis is standard form with $P(x)=\\ln(x)$ and $Q(x)=e^{x}$, both depending only on $x$. It is a first-order linear ODE.\n\n$$\n\\begin{aligned}(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((\\ln(x))y)&=(x^{2})(\\sin(x)) \\\\ \\frac{\\text{d}y}{\\text{d}x}+(\\ln(x))y&=\\sin(x)\\end{aligned}\n$$\n\nThis is standard form with $P(x)=\\ln(x)$ and $Q(x)=\\sin(x)$, both depending only on $x$. It is a first-order linear ODE.\n\nTherefore select\n\n$$\n(x^{2})\\frac{\\text{d}y}{\\text{d}x}+(x^{2})((x)\\sin(y))=(x^{2})(2)\n$$"}] [{:db/id #edb/ref 17592186693491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0211e49d-33bb-55f7-a62e-72a655ea6637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((2)y)=(2)(\\ln(x))" :db/id #edb/ref 17592186693466} {:answer/id #uuid "d30e7d1e-22d0-56d1-a314-b7ebcab58100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)\\frac{\\text{d}y}{\\text{d}x}+(2)((\\ln(x))y)=(2)(\\sin(x))" :db/id #edb/ref 17592186693488} {:answer/id #uuid "dde544fd-ab5d-5604-a7fb-116ca1e2e311" :answer/type {:db/id #edb/ref 175