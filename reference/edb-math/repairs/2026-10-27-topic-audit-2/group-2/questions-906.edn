 #uuid "97ce91ec-57ab-58d6-a70d-3b5dd8cad439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 5 y \\tan{(6 x )}=- 12 \\sin{(6 x )}" :db/id #edb/ref 17592186670744} {:answer/id #uuid "ab19ae44-9d58-55e7-b811-2122760db6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 2 y \\tan{(6 x )}=- 16 \\sin{(6 x )}" :db/id #edb/ref 17592186670746}] :answer-field/correct {:answer/id #uuid "17208af5-6a7d-5c6f-af89-2d091f5fbb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 6 y \\tan{(6 x )}=- 8 \\sin{(6 x )}" :db/id #edb/ref 17592186670729} :answer-field/id #uuid "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670759}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "90279bae-a817-5170-8c2a-84168513553a" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x} \\cos{(6 x )} + 6 y \\sin{(6 x )} + 4 \\sin{(12 x )}=0\\,.\n$$\n\nAssume $\\cos{(6 x )}\\ne 0$." :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{gathered}\\frac{\\text{d}y}{\\text{d}x} \\cos{(6 x )} + 6 y \\sin{(6 x )} + 4 \\sin{(12 x )}=0 \\\\ \\frac{\\text{d}y}{\\text{d}x} \\cos{(6 x )} + 6 y \\sin{(6 x )}=- 4 \\sin{(12 x )} \\\\ \\frac{\\text{d}y}{\\text{d}x} + \\frac{6 y \\sin{(6 x )}}{\\cos{(6 x )}}=- \\frac{4 \\sin{(12 x )}}{\\cos{(6 x )}} \\\\ \\frac{\\text{d}y}{\\text{d}x} + 6 y \\tan{(6 x )}=\\frac{- 8 \\sin{(6 x )}\\cos{(6 x )}}{\\cos{(6 x )}} \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(6 \\tan{(6 x )})}_{P(x)}y=\\underbrace{- 8 \\sin{(6 x )}}_{Q(x)}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=6 \\tan{(6 x )}$ and $Q(x)=- 8 \\sin{(6 x )}.$"}] [{:db/id #edb/ref 17592186670745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0897b3b2-91af-5ead-86ad-53a74af25290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 6 x y=- 8 x^{2}" :db/id #edb/ref 17592186670726} {:answer/id #uuid "878cca54-7f5d-58c4-bee3-c51799ce383a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 8 x y=- 6 x^{2}" :db/id #edb/ref 17592186670740} {:answer/id #uuid "b7a08845-2f23-5672-a741-af3649d4cd58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 7 x^{2}" :db/id #edb/ref 17592186670749} {:answer/id #uuid "d3c50cbf-15a8-50fa-a40a-e9338f50a145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 5 x y=- 4 x^{2}" :db/id #edb/ref 17592186670753} {:answer/id #uuid "d98d84b7-87a3-5a5a-bea4-c8f35276027f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 2 x y=- 2 x^{2}" :db/id #edb/ref 17592186670754}] :answer-field/correct {:answer/id #uuid "b7a08845-2f23-5672-a741-af3649d4cd58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 7 x^{2}" :db/id #edb/ref 17592186670749} :answer-field/id #uuid "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670731}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a9aa3ffa-4834-541b-babc-7d728ab4346e" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\left(\\frac{1}{x^{2}}\\right)\\frac{\\text{d}y}{\\text{d}x}=\\frac{- 7 x - 3 y}{x}\\,.\n$$\n\nAssume $x\\ne 0$." :question/worked-solution "A first order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\\,,\n$$\n\nwhere $P(x)$ and $Q(x)$ do not depend on $y.$\n\nWe have\n\n$$\n\\begin{gathered}\\left(\\frac{1}{x^{2}}\\right)\\frac{\\text{d}y}{\\text{d}x}=\\frac{- 7 x - 3 y}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x}=x^{2}\\left(\\frac{- 7 x - 3 y}{x}\\right) \\\\ \\frac{\\text{d}y}{\\text{d}x}=x (- 7 x - 3 y) \\\\ \\frac{\\text{d}y}{\\text{d}x}=- 7 x^{2} - 3 x y \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(3 x)}_{P(x)}y=\\underbrace{- 7 x^{2}}_{Q(x)} \\\\ \\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 7 x^{2}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=3 x$ and $Q(x)=- 7 x^{2}.$"}] [{:db/id #edb/ref 17592186670747 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10367d2c-ff74-56dd-803d-d14273cb6ee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + x y=- 3 x^{2}" :db/id #edb/ref 17592186670727} {:answer/id #uuid "7ac72dde-6f9d-5d06-868f-0e4f50ab6370" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 8 x y=- 7 x^{2}" :db/id #edb/ref 17592186670737} {:answer/id #uuid "94bbae5a-5c35-5193-8952-f4496b15cf35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 6 x^{2}" :db/id #edb/ref 17592186670743} {:answer/id #uuid "b6359046-12c0-58dc-8f12-74a984edaed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 6 x y=- 4 x^{2}" :db/id #edb/ref 17592186670748} {:answer/id #uuid "ca591e24-d59c-51c4-a500-165195f0aa99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 5 x y=- 2 x^{2}" :db/id #edb/ref 17592186670751}] :answer-field/correct {:answer/id #uuid "94bbae5a-5c35-5193-8952-f4496b15cf35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 6 x^{2}" :db/id #edb/ref 17592186670743} :answer-field/id #uuid "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670732}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af3535bf-626a-5961-8a1e-6a3e608fbdff" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x} y + 6 x^{2} y=- 3 x y^{2}\\,.\n$$\n\nAssume $y\\ne 0$." :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\\,,\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{gathered}\\frac{\\text{d}y}{\\text{d}x} y + 6 x^{2} y=- 3 x y^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} y + 6 x^{2} y + 3 x y^{2}=0 \\\\ y (\\frac{\\text{d}y}{\\text{d}x} + 6 x^{2} + 3 x y)=0 \\\\ \\frac{\\text{d}y}{\\text{d}x} + 6 x^{2} + 3 x y=0 \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(3 x)}_{P(x)}y=\\underbrace{- 6 x^{2}}_{Q(x)} \\\\ \\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 6 x^{2}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=3 x$ and $Q(x)=- 6 x^{2}.$"}] [{:db/id #edb/ref 17592186670758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4810508c-2449-5b67-a5b9-d70a867e0383" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 2 y e^{- 5 x}=- x e^{- 10 x}" :db/id #edb/ref 17592186670733} {:answer/id #uuid "7f470d72-c1fb-5ec3-8493-11bf5b11a73a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 7 y e^{- 5 x}=- 3 x e^{- 10 x}" :db/id #edb/ref 17592186670738} {:answer/id #uuid "c02d6db2-de0e-5ab4-8c0a-4228e71dd3f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 6 y e^{- 5 x}=- 5 x e^{- 10 x}" :db/id #edb/ref 17592186670750} {:answer/id #uuid "e116c84b-8db8-58f6-91a0-af61616586e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 3 y e^{- 5 x}=- 7 x e^{- 10 x}" :db/id #edb/ref 17592186670757} {:answer/id #uuid "f9177a5d-58a0-52dd-bdf2-8a523a7167e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 8 y e^{- 5 x}=- 8 x e^{- 10 x}" :db/id #edb/ref 17592186670760}] :answer-field/correct {:answer/id #uuid "e116c84b-8db8-58f6-91a0-af61616586e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 3 y e^{- 5 x}=- 7 x e^{- 10 x}" :db/id #edb/ref 17592186670757} :answer-field/id #uuid "878777a7-c1ab-58a6-b992-c2ef8406bd2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670739}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e87f0e4c-26c4-59c6-b25c-b7b850da4670" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x} e^{10 x} + 7 x - 3 y e^{5 x}=0\\,.\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{gathered}\\frac{\\text{d}y}{\\text{d}x} e^{10 x} + 7 x - 3 y e^{5 x}=0 \\\\ \\frac{\\text{d}y}{\\text{d}x} e^{10 x} - 3 y e^{5 x}=- 7 x \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(- 3 e^{- 5 x})}_{P(x)}y=\\underbrace{- 7 x e^{- 10 x}}_{Q(x)}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=- 3 e^{- 5 x}$ and $Q(x)=- 7 x e^{- 10 x}.$"}] [{:db/id #edb/ref 17592186670809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eea5aa8-c67d-5ad3-911c-0f9b71c1f33e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670812} {:answer/id #uuid "95d22fdd-50a8-58bc-ba28-8ea3cc513275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670824}] :answer-field/correct {:answer/id #uuid "95d22fdd-50a8-58bc-ba28-8ea3cc513275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670824} :answer-field/id #uuid "a916be7d-2c5c-5232-b92b-9d597b7061e7" :answer-field/key "${y}^{′}+4xy={x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670826} {:answer-field/choices [{:answer/id #uuid "062d8748-bc07-5aa6-9588-2b82d547067c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670798} {:answer/id #uuid "c12ed845-7c03-5f67-804f-523fa748afa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670829}] :answer-field/correct {:answer/id #uuid "c12ed845-7c03-5f67-804f-523fa748afa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670829} :answer-field/id #uuid "c970d060-b960-5030-b61d-6b1ddad40818" :answer-field/key "${y}^{′}+4xy=3x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670833} {:answer-field/choices [{:answer/id #uuid "1a45a63b-566f-5c4c-940b-0a8f8df66a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670804} {:answer/id #uuid "2d6fd131-4d4b-5c1d-87bc-fd9d9eee9504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670808}] :answer-field/correct {:answer/id #uuid "2d6fd131-4d4b-5c1d-87bc-fd9d9eee9504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670808} :answer-field/id #uuid "df3928d3-9553-5b66-b88b-336095f3c563" :answer-field/key "${y}^{′}+4xy=2y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670843}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+4xy=2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+4xy & =2y \\\\ {y}^{′}+4xy-2y & =0 \\\\ {y}^{′}+(4x-2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+4xy=3x.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=3x$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+4xy={x}^{3}.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)={x}^{3}$ is not identically zero. Therefore, this equation is inhomogeneous.\n\nTherefore, the correct answer is ${y}^{′}+4xy=2y$ only."}] [{:db/id #edb/ref 17592186670817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce96936f-8d93-5d74-84f7-cba7f5c9d74b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670834} {:answer/id #uuid "e7142a29-9310-5bc9-9b7b-532824bb0e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670844}] :answer-field/correct {:answer/id #uuid "e7142a29-9310-5bc9-9b7b-532824bb0e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670844} :answer-field/id #uuid "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/key "${y}^{′}+{x}^{3}y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670810} {:answer-field/choices [{:answer/id #uuid "687d2052-ac77-5d7c-a136-f6f8c22b92d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670818} {:answer/id #uuid "9cde3418-92ae-5e09-8723-e8ae6a876edc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670825}] :answer-field/correct {:answer/id #uuid "687d2052-ac77-5d7c-a136-f6f8c22b92d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670818} :answer-field/id #uuid "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/key "${y}^{′}+{x}^{3}y=-2y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670816} {:answer-field/choices [{:answer/id #uuid "09e9dea5-b7d0-57c3-9af6-d37ced5b1167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670800} {:answer/id #uuid "c959746e-3371-5185-af4b-5cb2e865cf30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670832}] :answer-field/correct {:answer/id #uuid "c959746e-3371-5185-af4b-5cb2e865cf30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670832} :answer-field/id #uuid "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/key "${y}^{′}+{x}^{3}y=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670842}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=2.\n$$\n\nThe presence of the constant term $2$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=-2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{3}y & =-2y \\\\ {y}^{′}+{x}^{3}y+2y & =0 \\\\ {y}^{′}+({x}^{3}+2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is ${y}^{′}+{x}^{3}y=0$; ${y}^{′}+{x}^{3}y=-2y$ only."}] [{:db/id #edb/ref 17592186670823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d59ec5fa-9d13-5fc4-8c6d-4334df2e5574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670837} {:answer/id #uuid "f9763a24-d037-571b-9f03-46dc3f319384" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670846}] :answer-field/correct {:answer/id #uuid "f9763a24-d037-571b-9f03-46dc3f319384" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670846} :answer-field/id #uuid "552f7559-74ed-50e1-8505-9c756f346ad2" :answer-field/key "${y}^{′}+8{x}^{3}y=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670814} {:answer-field/choices [{:answer/id #uuid "95337301-0306-5473-a840-a3665a504b75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670822} {:answer/id #uuid "c27b9007-5b5b-5a6f-b4cf-fe3bd9a381dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670830}] :answer-field/correct {:answer/id #uuid "95337301-0306-5473-a840-a3665a504b75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670822} :answer-field/id #uuid "bf285f5d-b22c-5312-bf34-858cc56e87cb" :answer-field/key "${y}^{′}+8{x}^{3}y=-5y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670828} {:answer-field/choices [{:answer/id #uuid "362509b0-7f13-5268-9882-b7458181febd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670811} {:answer/id #uuid "d330c53d-36a0-5743-9be6-dd2c47e5129a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670836}] :answer-field/correct {:answer/id #uuid "362509b0-7f13-5268-9882-b7458181febd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670811} :answer-field/id #uuid "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/key "${y}^{′}+8{x}^{3}y=4y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670840}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "95870580-b5cf-5914-9a93-1e8255bc81ca" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+8{x}^{3}y=4y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+8{x}^{3}y & =4y \\\\ {y}^{′}+8{x}^{3}y-4y & =0 \\\\ {y}^{′}+(8{x}^{3}-4)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+8{x}^{3}y=-5y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+8{x}^{3}y & =-5y \\\\ {y}^{′}+8{x}^{3}y+5y & =0 \\\\ {y}^{′}+(8{x}^{3}+5)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+8{x}^{3}y=-3.\n$$\n\nThe presence of the constant term $-3$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\nTherefore, the correct answer is ${y}^{′}+8{x}^{3}y=4y$; ${y}^{′}+8{x}^{3}y=-5y$ only."}] [{:db/id #edb/ref 17592186670845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a514407-d3f3-575f-b9fa-d8b32140637f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670813} {:answer/id #uuid "d97c0712-5fce-5698-9472-de0d852a558a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670841}] :answer-field/correct {:answer/id #uuid "4a514407-d3f3-575f-b9fa-d8b32140637f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670813} :answer-field/id #uuid "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/key "${y}^{′}+{x}^{3}y=y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670806} {:answer-field/choices [{:answer/id #uuid "09311cc0-a9e1-5e64-bf4b-40e0a4d78186" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670799} {:answer/id #uuid "5687bd00-e31f-585f-b5c6-ef839794e52e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670815}] :answer-field/correct {:answer/id #uuid "5687bd00-e31f-585f-b5c6-ef839794e52e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670815} :answer-field/id #uuid "80dc1c91-c0e8-5a0e-9813-9a770574905c" :answer-field/key "${y}^{′}+{x}^{3}y=2y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670819} {:answer-field/choices [{:answer/id #uuid "16487eca-6999-56b0-bb66-0b337dab9a14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670802} {:answer/id #uuid "ac19d693-0584-57d9-8388-b68867ed895f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670827}] :answer-field/correct {:answer/id #uuid "ac19d693-0584-57d9-8388-b68867ed895f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670827} :answer-field/id #uuid "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/key "${y}^{′}+{x}^{3}y=-4x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670838}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ea086a0d-6281-50e8-9859-feb937690d11" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{3}y & =2y \\\\ {y}^{′}+{x}^{3}y-2y & =0 \\\\ {y}^{′}+({x}^{3}-2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{3}y & =y \\\\ {y}^{′}+{x}^{3}y-y & =0 \\\\ {y}^{′}+({x}^{3}-1)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=-4x.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-4x$ is not identically zero. Therefore, this equation is inhomogeneous.\n\nTherefore, the correct answer is ${y}^{′}+{x}^{3}y=2y$; ${y}^{′}+{x}^{3}y=y$ only."}] [{:db/id #edb/ref 17592186670847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "885f97b2-8116-577a-b4c8-2fb47506a1a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670820} {:answer/id #uuid "930d61a1-63ff-581c-8958-e9e1eb4da95b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670821}] :answer-field/correct {:answer/id #uuid "930d61a1-63ff-581c-8958-e9e1eb4da95b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670821} :answer-field/id #uuid "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/key "${y}^{′}+2{x}^{2}y=-4y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670803} {:answer-field/choices [{:answer/id #uuid "1d186eeb-24d9-5746-81b4-03bdfbb3946c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670805} {:answer/id #uuid "c7dd9cd2-9a9a-53b4-84ad-b91d884d609f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670831}] :answer-field/correct {:answer/id #uuid "1d186eeb-24d9-5746-81b4-03bdfbb3946c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670805} :answer-field/id #uuid "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/key "${y}^{′}+2{x}^{2}y=-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670807} {:answer-field/choices [{:answer/id #uuid "0f60f433-4104-544d-ba20-53ce8d39c651" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670801} {:answer/id #uuid "d140c08d-bd6c-5e13-8631-f0e85f27c412" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186670835}] :answer-field/correct {:answer/id #uuid "0f60f433-4104-544d-ba20-53ce8d39c651" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186670801} :answer-field/id #uuid "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/key "${y}^{′}+2{x}^{2}y=3y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186670839}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa221a93-5c26-51e7-9d03-310306b15d77" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+2{x}^{2}y=-5.\n$$\n\nThe presence of the constant term $-5$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+2{x}^{2}y=3y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+2{x}^{2}y & =3y \\\\ {y}^{′}+2{x}^{2}y-3y & =0 \\\\ {y}^{′}+(2{x}^{2}-3)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+2{x}^{2}y=-4y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+2{x}^{2}y & =-4y \\\\ {y}^{′}+2{x}^{2}y+4y & =0 \\\\ {y}^{′}+(2{x}^{2}+4)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is ${y}^{′}+2{x}^{2}y=3y$; ${y}^{′}+2{x}^{2}y=-4y$ only."}] [{:db/id #edb/ref 17592186679673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64e63f50-d0ba-515b-b0f0-9293a7f9b2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679692} {:answer/id #uuid "b730118d-ae75-53af-9db4-fef74aea0592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679708}] :answer-field/correct {:answer/id #uuid "64e63f50-d0ba-515b-b0f0-9293a7f9b2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679692} :answer-field/id #uuid "647ee326-2d50-5943-8a49-7bc5df07773a" :answer-field/key "${y}^{′}+4{x}^{2}y=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679691} {:answer-field/choices [{:answer/id #uuid "26cc0cf9-5146-5c9a-86eb-09f6e14522e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679677} {:answer/id #uuid "f86ceea5-d4d2-5ada-9647-89738e1b79ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679719}] :answer-field/correct {:answer/id #uuid "26cc0cf9-5146-5c9a-86eb-09f6e14522e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679677} :answer-field/id #uuid "bb2433b2-9a6a-576b-aa4e-d2bbe72ee81e" :answer-field/key "${y}^{′}+4{x}^{2}y=-9{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679709} {:answer-field/choices [{:answer/id #uuid "0fd40fc7-bcf5-545a-8c3d-a6bc3c830a70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679671} {:answer/id #uuid "e2e31295-72b5-5e69-8304-2a92e74155c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679716}] :answer-field/correct {:answer/id #uuid "0fd40fc7-bcf5-545a-8c3d-a6bc3c830a70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679671} :answer-field/id #uuid "fe5bfc2f-b502-577f-bdc2-068191cbd9d3" :answer-field/key "${y}^{′}+4{x}^{2}y=2y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679720}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "14ffe406-ce84-5ef6-9832-6a40f37b756f" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+4{x}^{2}y=-9{x}^{2}.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-9{x}^{2}$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+4{x}^{2}y=-4.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-4$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+4{x}^{2}y=2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+4{x}^{2}y & =2y \\\\ {y}^{′}+4{x}^{2}y-2y & =0 \\\\ {y}^{′}+(4{x}^{2}-2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is ${y}^{′}+4{x}^{2}y=-9{x}^{2}$; ${y}^{′}+4{x}^{2}y=-4$ only."}] [{:db/id #edb/ref 17592186679676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5171d266-9877-540b-9ce5-8e254ce993c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679684} {:answer/id #uuid "83fac3f4-c7c9-5fbe-83ea-8b89eddeadb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679696}] :answer-field/correct {:answer/id #uuid "5171d266-9877-540b-9ce5-8e254ce993c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679684} :answer-field/id #uuid "5bc8906a-85fb-5e8d-ac7b-2c4c8c8a3a8d" :answer-field/key "${y}^{′}-3y=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679687} {:answer-field/choices [{:answer/id #uuid "5c2e9c9a-5b01-57ca-92d4-0e4af641c259" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679688} {:answer/id #uuid "960525fb-edf2-5ade-add4-4b1ce9348538" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679702}] :answer-field/correct {:answer/id #uuid "960525fb-edf2-5ade-add4-4b1ce9348538" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679702} :answer-field/id #uuid "5eca6047-7ec9-5578-894f-50e1e89bba18" :answer-field/key "${y}^{′}-3y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679689} {:answer-field/choices [{:answer/id #uuid "31940d62-5b76-5d3f-bea5-e4eee7ba77b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679680} {:answer/id #uuid "991ed32f-980d-567c-9c76-ecfbe62632e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679704}] :answer-field/correct {:answer/id #uuid "991ed32f-980d-567c-9c76-ecfbe62632e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679704} :answer-field/id #uuid "c94cecd9-d3d9-59fb-b21b-24c6a928c2d2" :answer-field/key "${y}^{′}-3y=-4y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679712}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "234d2d2a-2603-5b0c-be54-c0fe5ec9a575" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}-3y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}-3y=-4y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}-3y & =-4y \\\\ {y}^{′}-3y+4y & =0 \\\\ {y}^{′}+y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}-3y=4.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=4$ is not identically zero. Therefore, this equation is inhomogeneous.\n\nTherefore, the correct answer is ${y}^{′}-3y=4$ only."}] [{:db/id #edb/ref 17592186679679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdc6e99-60e4-5584-9a2a-9cbcfe3d38d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679672} {:answer/id #uuid "c357aa36-7dc3-545f-a748-897203d28c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679710}] :answer-field/correct {:answer/id #uuid "0fdc6e99-60e4-5584-9a2a-9cbcfe3d38d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679672} :answer-field/id #uuid "1a0f0437-6d59-576c-a92a-daec774dfb83" :answer-field/key "${y}^{′}+6y=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679674} {:answer-field/choices [{:answer/id #uuid "57b29130-cf7b-5e19-bb59-39c2e7eed10e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679686} {:answer/id #uuid "96226267-f472-57be-a08d-3ba6c96ffbd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679703}] :answer-field/correct {:answer/id #uuid "96226267-f472-57be-a08d-3ba6c96ffbd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679703} :answer-field/id #uuid "b0d75031-c8b8-58fb-abe8-531fc62198c7" :answer-field/key "${y}^{′}+6y=-y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679706} {:answer-field/choices [{:answer/id #uuid "43de0255-6089-50b6-8d13-1b3a597c4833" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679681} {:answer/id #uuid "568dbe93-7646-5032-981a-ebd34cdc7faa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679685}] :answer-field/correct {:answer/id #uuid "43de0255-6089-50b6-8d13-1b3a597c4833" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679681} :answer-field/id #uuid "df89df85-8ba6-53ce-9c3e-c911899403b5" :answer-field/key "${y}^{′}+6y=-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679715}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2f12a298-1e73-5a05-9a7a-06edf1b6b030" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+6y=-x.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-x$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+6y=-y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+6y & =-y \\\\ {y}^{′}+6y+y & =0 \\\\ {y}^{′}+7y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+6y=4.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=4$ is not identically zero. Therefore, this equation is inhomogeneous.\n\nTherefore, the correct answer is ${y}^{′}+6y=-x$; ${y}^{′}+6y=4$ only."}] [{:db/id #edb/ref 17592186679682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac97dd60-174d-511d-bc2b-d0012234bbd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679705} {:answer/id #uuid "b26156e2-59e6-5ee2-91ce-ef7a01069039" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679707}] :answer-field/correct {:answer/id #uuid "b26156e2-59e6-5ee2-91ce-ef7a01069039" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679707} :answer-field/id #uuid "91e26b30-c81d-53e6-bdc6-829d49286059" :answer-field/key "${y}^{′}-8y=7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679701} {:answer-field/choices [{:answer/id #uuid "20f7574e-34ca-5409-abe9-160c6da14e0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679675} {:answer/id #uuid "911acd3b-7474-525e-8b71-eb1c5eed1ada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679699}] :answer-field/correct {:answer/id #uuid "911acd3b-7474-525e-8b71-eb1c5eed1ada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679699} :answer-field/id #uuid "f2b76bdf-0984-5b72-97f8-2ceccf6ec1e7" :answer-field/key "${y}^{′}-8y=-4y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679717} {:answer-field/choices [{:answer/id #uuid "6a38fab0-ef0b-5802-94eb-af126ad1b009" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679693} {:answer/id #uuid "8d2048be-06b0-52e0-9591-5e90f8e06d9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679697}] :answer-field/correct {:answer/id #uuid "8d2048be-06b0-52e0-9591-5e90f8e06d9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679697} :answer-field/id #uuid "f35a1400-688c-53a7-9673-943cd6f567fd" :answer-field/key "${y}^{′}-8y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679718}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49c4296f-a71e-54dc-9dc6-59c7470adecc" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}-8y=7.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=7$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}-8y=-4y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}-8y & =-4y \\\\ {y}^{′}-8y+4y & =0 \\\\ {y}^{′}-4y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}-8y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is ${y}^{′}-8y=7$ only."}] [{:db/id #edb/ref 17592186679714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eeb532a-9715-5c99-9c0e-87f48be5b603" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679678} {:answer/id #uuid "da4d0c4f-7da3-596a-85d0-2a73f043971c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679713}] :answer-field/correct {:answer/id #uuid "2eeb532a-9715-5c99-9c0e-87f48be5b603" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679678} :answer-field/id #uuid "4aa41486-921f-53cc-9f7d-c39a0a966af1" :answer-field/key "${y}^{′}+{x}^{3}y=3y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679683} {:answer-field/choices [{:answer/id #uuid "7c44b3c4-4a74-589d-8c40-d60085537c0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679695} {:answer/id #uuid "9030220f-9c80-556f-978b-74f6d74a273e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679698}] :answer-field/correct {:answer/id #uuid "9030220f-9c80-556f-978b-74f6d74a273e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679698} :answer-field/id #uuid "61fbfcef-6ebc-5715-b45c-9befa74ad78f" :answer-field/key "${y}^{′}+{x}^{3}y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679690} {:answer-field/choices [{:answer/id #uuid "919668d3-fb49-55cd-9b7b-85c9b01ff877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679700} {:answer/id #uuid "c4a8e5d7-9998-530f-81ac-cd0b2474d7ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186679711}] :answer-field/correct {:answer/id #uuid "919668d3-fb49-55cd-9b7b-85c9b01ff877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186679700} :answer-field/id #uuid "6e13e5f3-164a-5370-898f-81f45e75555d" :answer-field/key "${y}^{′}+{x}^{3}y=-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186679694}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd6e8945-51c1-52e8-9839-0943bd6b6e4b" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=-5.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-5$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=3y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{3}y & =3y \\\\ {y}^{′}+{x}^{3}y-3y & =0 \\\\ {y}^{′}+({x}^{3}-3)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is ${y}^{′}+{x}^{3}y=-5$ only."}] [{:db/id #edb/ref 17592186681208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3162d531-8dc6-54df-9711-15910ae7f8ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+3xy=e^x" :db/id #edb/ref 17592186681205} {:answer/id #uuid "405899c3-505d-5191-9820-25f4b1ddeedc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+3xy=-e^x" :db/id #edb/ref 17592186681206} {:answer/id #uuid "8047a0fe-1767-53d8-b2c9-0c37ad5fd845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}=e^x-3xy" :db/id #edb/ref 17592186681215} {:answer/id #uuid "ed219600-bdef-5c26-9a61-b8761077997b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+3x=e^x y" :db/id #edb/ref 17592186681220} {:answer/id #uuid "f83ccfe8-1336-5405-866b-08f883af3ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}-3xy=e^x" :db/id #edb/ref 17592186681223}] :answer-field/correct {:answer/id #uuid "3162d531-8dc6-54df-9711-15910ae7f8ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+3xy=e^x" :db/id #edb/ref 17592186681205} :answer-field/id #uuid "7f9b4e66-4cf7-52ce-bfa9-50df3c5cb40e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186681214}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f9889d7-10cc-5fc0-b858-861aa83d3d88" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}+3xy-e^x=0\n$$" :question/worked-solution "A first-order linear ODE is in standard form when written as\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}+P(x)y=Q(x).\n$$\n\nMove the term that does not contain $y$ to the right. The coefficient of the derivative is already $1$.\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}+3xy-e^x&=0\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}+3xy&=e^x\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\underbrace{3x}_{P(x)}y&=\\underbrace{e^x}_{Q(x)}.\\end{aligned}\n$$\n\nThus $P(x)=3x$ and $Q(x)=e^x$. The equivalent equation $\\frac{\\mathrm{d}y}{\\mathrm{d}x}=e^x-3xy$ has not yet been arranged in standard form."}] [{:db/id #edb/ref 17592186681209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "639f9120-616a-5315-bf9d-ff0c0bc9e026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}-(\\sin^2 x)y=1" :db/id #edb/ref 17592186681212} {:answer/id #uuid "6e1372ae-a62a-517e-9f3e-840cd8bd77ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}-2(\\sin x)y=0" :db/id #edb/ref 17592186681213} {:answer/id #uuid "89f348cf-84ff-5990-a77a-2d8961462c1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}-2(\\sin x)y=1" :db/id #edb/ref 17592186681216} {:answer/id #uuid "f1f955a3-b7de-584a-8091-b4df9e90722c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+(\\sin x)y=1" :db/id #edb/ref 17592186681221} {:answer/id #uuid "f923a6b3-ad9c-56de-9604-ff42e4c071b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+2(\\sin x)y=1" :db/id #edb/ref 17592186681224}] :answer-field/correct {:answer/id #uuid "89f348cf-84ff-5990-a77a-2d8961462c1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}-2(\\sin x)y=1" :db/id #edb/ref 17592186681216} :answer-field/id #uuid "b36d04d7-1ee5-51f1-b003-370553fa1fac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186681218}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5994136f-3dc7-55fb-85f8-2f301467685c" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}+y^2\\sin^2 x=(1+y\\sin x)^2\n$$" :question/worked-solution "A first-order linear ODE is in standard form when written as\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}+P(x)y=Q(x).\n$$\n\nExpand the square before deciding which terms survive. The quadratic terms cancel; the cross term remains.\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}+y^2\\sin^2 x&=(1+y\\sin x)^2\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}+y^2\\sin^2 x&=1+2y\\sin x+y^2\\sin^2 x\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=1+2y\\sin x\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}-2(\\sin x)y&=1\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\underbrace{(-2\\sin x)}_{P(x)}y&=\\underbrace{1}_{Q(x)}.\\end{aligned}\n$$\n\nThus $P(x)=-2\\sin x$ and $Q(x)=1$. The initial appearance of $y^2$ does not prevent this equation from being linear after simplification."}] [{:db/id #edb/ref 17592186681210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b98e2e6-e89a-5e93-8d8b-75cf36feb2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\frac{1}{x+1}y=x^2" :db/id #edb/ref 17592186681204} {:answer/id #uuid "486b29fc-5c61-5edf-9b75-ade4fad63abd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}-\\frac{1}{x+1}y=\\frac{x^2}{x+1}" :db/id #edb/ref 17592186681207} {:answer/id #uuid "5e9b2d34-de6e-5d76-9c70-e85b5a07763c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\frac{3}{x+1}y=\\frac{x^2}{x+1}" :db/id #edb/ref 17592186681211} {:answer/id #uuid "aef0f3e9-f691-53e5-b72d-8a602031d9a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)\\frac{\\mathrm{d}y}{\\mathrm{d}x}+y=x^2" :db/id #edb/ref 17592186681217} {:answer/id #uuid "f5957207-5bf9-57ab-b6bb-40f1810cd390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\frac{1}{x+1}y=\\frac{x^2}{x+1}" :db/id #edb/ref 17592186681222}] :answer-field/correct {:answer/id #uuid "f5957207-5bf9-57ab-b6bb-40f1810cd390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\frac{1}{x+1}y=\\frac{x^2}{x+1}" :db/id #edb/ref 17592186681222} :answer-field/id #uuid "c3e3ed44-20c5-5097-b232-0256d292f8e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186681219}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a6bf5d5-970b-57e8-99a1-41b166933c1e" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n(x+1)\\frac{\\mathrm{d}y}{\\mathrm{d}x}+2y=x^2+y,\\qquad x>-1\n$$" :question/worked-solution "A first-order linear ODE is in standard form when written as\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}+P(x)y=Q(x).\n$$\n\nFirst collect the terms involving $y$ on the left. Then divide every term by $x+1$, which is nonzero on the given domain.\n\n$$\n\\begin{aligned}(x+1)\\frac{\\mathrm{d}y}{\\mathrm{d}x}+2y&=x^2+y\\\\(x+1)\\frac{\\mathrm{d}y}{\\mathrm{d}x}+y&=x^2\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\frac{1}{x+1}y&=\\frac{x^2}{x+1}\\\\\\frac{\\mathrm{d}y}{\\mathrm{d}x}+\\underbrace{\\frac{1}{x+1}}_{P(x)}y&=\\underbrace{\\frac{x^2}{x+1}}_{Q(x)}.\\end{aligned}\n$$\n\nThus $P(x)=\\frac{1}{x+1}$ and $Q(x)=\\frac{x^2}{x+1}$. Leaving the derivative coefficient as $x+1$ gives an equivalent equation, but not standard form."}] [{:db/id #edb/ref 17592186681903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56f93215-c276-5300-a720-1b1d121cb00c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 4 y \\cos{(2 x )}=4" :db/id #edb/ref 17592186681909} {:answer/id #uuid "9edea90f-56b9-588d-9fa4-c0cf1b93486b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 8 y \\cos{(2 x )}=4" :db/id #edb/ref 17592186681917} {:answer/id #uuid "c824387f-75e6-5f44-8284-fed47fbc166e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 12 y \\cos{(2 x )}=4" :db/id #edb/ref 17592186681919} {:answer/id #uuid "d00f8141-522d-5d88-844c-d16f3c323290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 12 y \\cos{(2 x )}=4" :db/id #edb/ref 17592186681921} {:answer/id #uuid "ecc1b96c-9b7b-54d2-a140-5b60b6b1b97a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 8 y \\cos{(2 x )}=4" :db/id #edb/ref 17592186681922}] :answer-field/correct {:answer/id #uuid "9edea90f-56b9-588d-9fa4-c0cf1b93486b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 8 y \\cos{(2 x )}=4" :db/id #edb/ref 17592186681917} :answer-field/id #uuid "2217c196-1888-5704-8f19-ee036949901c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186681905}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0ff05245-d9b5-5b70-96ff-a9d4a948be0a" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+4{y}^{2}(\\cos{(2 x )})^{2}=(2-(2)y\\cos{(2 x )})^{2}\\,.\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\small \\begin{aligned}&\\frac{\\text{d}y}{\\text{d}x}+4{y}^{2}(\\cos{(2 x )})^{2}=(2-(2)y\\cos{(2 x )})^{2} \\\\ &\\frac{\\text{d}y}{\\text{d}x}+4{y}^{2}(\\cos{(2 x )})^{2}=4+4{y}^{2}(\\cos{(2 x )})^{2}-8 y \\cos{(2 x )} \\\\ &\\frac{\\text{d}y}{\\text{d}x}=4-8 y \\cos{(2 x )} \\\\ &\\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(8 \\cos{(2 x )})}_{P(x)}y=\\underbrace{4}_{Q(x)}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=8 \\cos{(2 x )}$ and $Q(x)=4.$"}] [{:db/id #edb/ref 17592186681911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10631e69-ea4d-55cb-87fd-aaf6810f1c48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 24 y \\cos{(4 x )}=36" :db/id #edb/ref 17592186681904} {:answer/id #uuid "3f5d28b7-876f-50e6-9ac2-3fc551fa4260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 36 y \\cos{(4 x )}=36" :db/id #edb/ref 17592186681907} {:answer/id #uuid "8976cd88-3e21-50cd-99ca-21d005d3551c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 36 y \\cos{(4 x )}=36" :db/id #edb/ref 17592186681913} {:answer/id #uuid "9c3f1696-aec5-50b2-8997-263c033782d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 12 y \\cos{(4 x )}=36" :db/id #edb/ref 17592186681916} {:answer/id #uuid "a8e0fa5d-30b3-57cd-80ef-7995f84ea67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 12 y \\cos{(4 x )}=36" :db/id #edb/ref 17592186681918}] :answer-field/correct {:answer/id #uuid "8976cd88-3e21-50cd-99ca-21d005d3551c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 36 y \\cos{(4 x )}=36" :db/id #edb/ref 17592186681913} :answer-field/id #uuid "6a40268b-c7c0-5709-a719-9701f0634d83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186681910}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6e1e80ed-5ec3-5bb5-9620-4ead95943632" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+9{y}^{2}(\\cos{(4 x )})^{2}=(6+(3)y\\cos{(4 x )})^{2}\\,.\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\small \\begin{aligned}&\\frac{\\text{d}y}{\\text{d}x}+9{y}^{2}(\\cos{(4 x )})^{2}=(6+(3)y\\cos{(4 x )})^{2} \\\\ &\\frac{\\text{d}y}{\\text{d}x}+9{y}^{2}(\\cos{(4 x )})^{2}=36+9{y}^{2}(\\cos{(4 x )})^{2}+36 y \\cos{(4 x )} \\\\ &\\frac{\\text{d}y}{\\text{d}x}=36+36 y \\cos{(4 x )} \\\\ &\\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(- 36 \\cos{(4 x )})}_{P(x)}y=\\underbrace{36}_{Q(x)}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=- 36 \\cos{(4 x )}$ and $Q(x)=36.$"}] [{:db/id #edb/ref 17592186681923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "361ec3a7-c16c-5ff9-a4b4-6726ed7e96ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 36 y \\cos{(x )}=36" :db/id #edb/ref 17592186681906} {:answer/id #uuid "4a08c646-d8cf-594e-aa4e-3397cb36c521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 48 y \\cos{(x )}=36" :db/id #edb/ref 17592186681908} {:answer/id #uuid "73e86482-7d80-5656-8a01-51e400f0d276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 24 y \\cos{(x )}=36" :db/id #edb/ref 17592186681912} {:answer/id #uuid "8edcb9e4-2160-5e67-9191-f127e334b18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 24 y \\cos{(x )}=36" :db/id #edb/ref 17592186681915} {:answer/id #uuid "cc14d661-ebf9-58b6-8a34-7d2a5ddd3e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 48 y \\cos{(x )}=36" :db/id #edb/ref 17592186681920}] :answer-field/correct {:answer/id #uuid "4a08c646-d8cf-594e-aa4e-3397cb36c521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 48 y \\cos{(x )}=36" :db/id #edb/ref 17592186681908} :answer-field/id #uuid "8aab0e1f-ce14-5a61-bbce-a192755e21ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186681914}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fe91e88c-30b7-5a74-a827-f5a17d1caf6e" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+16{y}^{2}(\\cos{(x )})^{2}=(6-(4)y\\cos{(x )})^{2}\\,.\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\small \\begin{aligned}&\\frac{\\text{d}y}{\\text{d}x}+16{y}^{2}(\\cos{(x )})^{2}=(6-(4)y\\cos{(x )})^{2} \\\\ &\\frac{\\text{d}y}{\\text{d}x}+16{y}^{2}(\\cos{(x )})^{2}=36+16{y}^{2}(\\cos{(x )})^{2}-48 y \\cos{(x )} \\\\ &\\frac{\\text{d}y}{\\text{d}x}=36-48 y \\cos{(x )} \\\\ &\\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(48 \\cos{(x )})}_{P(x)}y=\\underbrace{36}_{Q(x)}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=48 \\cos{(x )}$ and $Q(x)=36.$"}] [{:db/id #edb/ref 17592186692236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "985e0e5f-589a-5e5d-beed-4e7862c5172e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692230} {:answer/id #uuid "9c8b7c8a-185f-5d7f-9535-942aba0068ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692232}] :answer-field/correct {:answer/id #uuid "9c8b7c8a-185f-5d7f-9535-942aba0068ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692232} :answer-field/id #uuid "08ddeb21-746d-5878-9658-b8645045fe40" :answer-field/key "$xy'+(x+1)y+x^2=y+x(x+1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692210} {:answer-field/choices [{:answer/id #uuid "363551bc-f792-525c-a811-cd083327acd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692219} {:answer/id #uuid "625a33df-ebcb-5cee-8425-68d8abd0d698" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692223}] :answer-field/correct {:answer/id #uuid "363551bc-f792-525c-a811-cd083327acd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692219} :answer-field/id #uuid "8ff7a66d-2741-56a5-97fd-e950eea4404f" :answer-field/key "$xy'+(x+1)y+x^2=y+x^2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692229} {:answer-field/choices [{:answer/id #uuid "27aec9bb-ecac-5c44-8be0-89045063e5b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692216} {:answer/id #uuid "2c55e04b-72ec-5ae6-a592-a6814c2b4495" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692217}] :answer-field/correct {:answer/id #uuid "27aec9bb-ecac-5c44-8be0-89045063e5b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692216} :answer-field/id #uuid "98e703f7-a64d-5d0a-83df-01e994308d48" :answer-field/key "$(x+1)y'+x(y+1)=xy+x+x^2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692231}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c0449f84-c89f-5114-b80a-1d29e21315f1" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nConsider each equation on the interval $x>0$.\n\nSelect all that apply." :question/worked-solution "A first-order linear ODE is homogeneous when its standard form $y'+P(x)y=Q(x)$ has $Q(x)=0$ for every $x$ in the interval. It is inhomogeneous when $Q$ is not identically zero.\n\nFirst collect all $y$-terms on the left and all terms involving only $x$ on the right. Then normalize the coefficient of $y'$. Since $x>0$, both $x$ and $x+1$ are nonzero.\n\nFor the first equation, expand $x(x+1)$:\n\n$$\n\\begin{aligned}\nxy'+(x+1)y+x^2&=y+x^2+x\\\\\nxy'+xy&=x\\\\\ny'+y&=1.\n\\end{aligned}\n$$\n\nThe $x^2$-terms cancel but the extra $x$ remains. Thus $Q(x)=1$, so the first equation is inhomogeneous.\n\nFor the second equation, the terms involving only $x$ cancel completely:\n\n$$\n\\begin{aligned}\nxy'+(x+1)y+x^2&=y+x^2\\\\\nxy'+xy&=0\\\\\ny'+y&=0.\n\\end{aligned}\n$$\n\nThus $Q(x)=0$, so the second equation is homogeneous despite the $x^2$ on its original right-hand side.\n\nFor the third equation, expand $x(y+1)$:\n\n$$\n\\begin{aligned}\n(x+1)y'+xy+x&=xy+x+x^2\\\\\n(x+1)y'&=x^2\\\\\ny'+0y&=\\frac{x^2}{x+1}.\n\\end{aligned}\n$$\n\nHere $P(x)=0$ is allowed, while $Q(x)=\\frac{x^2}{x+1}$ is not identically zero on $x>0$. The third equation is inhomogeneous.\n\nSelect the first and third equations: $xy'+(x+1)y+x^2=y+x(x+1)$ and $(x+1)y'+x(y+1)=xy+x+x^2$."}] [{:db/id #edb/ref 17592186692238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4eafbb-fa9f-5ead-b4e3-ea808f0f5e37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692211} {:answer/id #uuid "229b782f-8265-573c-adc0-47ef0b6766e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692215}] :answer-field/correct {:answer/id #uuid "229b782f-8265-573c-adc0-47ef0b6766e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692215} :answer-field/id #uuid "11fcc902-0506-543c-946e-a85da77d9ecc" :answer-field/key "$y'+3xy=x^2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692212} {:answer-field/choices [{:answer/id #uuid "1a8d9324-82d6-54b3-94aa-27631db752df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692213} {:answer/id #uuid "4735677c-550f-58c1-983e-b99ef8e33b9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692221}] :answer-field/correct {:answer/id #uuid "1a8d9324-82d6-54b3-94aa-27631db752df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692213} :answer-field/id #uuid "43bf0850-94c6-5589-adb1-efb300cd0937" :answer-field/key "$y'+3xy=y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692220} {:answer-field/choices [{:answer/id #uuid "75f8cc7c-1bcf-5193-8728-28a4a6ec3611" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692227} {:answer/id #uuid "b4a9699a-62c4-57c5-9bce-99e4ad254a61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692235}] :answer-field/correct {:answer/id #uuid "b4a9699a-62c4-57c5-9bce-99e4ad254a61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692235} :answer-field/id #uuid "a3d9ce14-f78f-55f8-a187-bf43a9cd2d1b" :answer-field/key "$y'+3xy=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692233}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd566fa0-9c50-5400-9f1d-9bf3328b1abb" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear ODE is homogeneous when its standard form $y'+P(x)y=Q(x)$ has $Q(x)=0$ for every $x$ in the interval. It is inhomogeneous when $Q$ is not identically zero.\n\nFor the first equation, move $y$ to the left:\n\n$$\n\\begin{aligned}\ny'+3xy&=y\\\\\ny'+(3x-1)y&=0.\n\\end{aligned}\n$$\n\nThus $Q(x)=0$, so the first equation is homogeneous even though its original right-hand side is $y$.\n\nThe second equation is already in standard form with $Q(x)=x^2$. This function is zero at $x=0$, but is not identically zero. The second equation is inhomogeneous.\n\nThe third equation is already in standard form with $Q(x)=0$, so it is homogeneous.\n\nSelect the first and third equations: $y'+3xy=y$ and $y'+3xy=0$."}] [{:db/id #edb/ref 17592186692239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e0a6859-0611-5a85-b183-5ca41ad9e8f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692226} {:answer/id #uuid "773c757b-deb7-583e-8195-a4dcad844c01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692228}] :answer-field/correct {:answer/id #uuid "6e0a6859-0611-5a85-b183-5ca41ad9e8f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692226} :answer-field/id #uuid "1ef5b934-f917-5857-8870-dfca83d811f0" :answer-field/key "$y'+xy=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692214} {:answer-field/choices [{:answer/id #uuid "63900b4a-b6a1-58cc-b0b2-cb605e6bd411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692224} {:answer/id #uuid "a71703e5-d118-542d-a698-b1438863dc6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692234}] :answer-field/correct {:answer/id #uuid "a71703e5-d118-542d-a698-b1438863dc6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692234} :answer-field/id #uuid "65b2905a-0714-57d7-99de-74b9c6e729c9" :answer-field/key "$y'+xy=y+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692225} {:answer-field/choices [{:answer/id #uuid "2f0a686c-5255-584c-af51-f93e1916759a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692218} {:answer/id #uuid "49377d36-8ece-5f4b-ac46-327c39d9436c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692222}] :answer-field/correct {:answer/id #uuid "2f0a686c-5255-584c-af51-f93e1916759a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692218} :answer-field/id #uuid "c41c0ed3-c456-5823-a2c2-1b0e5131a152" :answer-field/key "$2y'+(x+1)y=y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692237}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f23e805b-25db-579b-a6f2-f841d8e83df8" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear ODE is homogeneous when its standard form $y'+P(x)y=Q(x)$ has $Q(x)=0$ for every $x$ in the interval. It is inhomogeneous when $Q$ is not identically zero.\n\nIn the first equation, separate the term involving $y$ from the term involving only $x$:\n\n$$\n\\begin{aligned}\ny'+xy&=y+x\\\\\ny'+(x-1)y&=x.\n\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=x$, which is not identically zero. The first equation is inhomogeneous.\n\nFor the second equation, collect the $y$-terms and divide by $2$:\n\n$$\n\\begin{aligned}\n2y'+(x+1)y&=y\\\\\n2y'+xy&=0\\\\\ny'+\\frac{x}{2}y&=0.\n\\end{aligned}\n$$\n\nHere $Q(x)=0$, so the second equation is homogeneous. A nonzero coefficient of $y'$ does not create a forcing term.\n\nThe third equation is already in standard form with $Q(x)=0$, so it is homogeneous.\n\nSelect only $y'+xy=y+x$."}] [{:db/id #edb/ref 17592186692428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a8f941-c95d-5b69-9955-252a873a01f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692430} {:answer/id #uuid "f36ec41f-f621-5d3e-9034-820c02670f80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692472}] :answer-field/correct {:answer/id #uuid "13a8f941-c95d-5b69-9955-252a873a01f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692430} :answer-field/id #uuid "18a8539c-4176-5d1f-af31-3a54bb7ad759" :answer-field/key "$3{y}^{′}+xy-{x}^{3}=-y-2{x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692433} {:answer-field/choices [{:answer/id #uuid "15e9ded3-5c78-5494-9f77-4b413607be77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692431} {:answer/id #uuid "541dc570-7f1c-5697-a84d-be10c6d79ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692441}] :answer-field/correct {:answer/id #uuid "15e9ded3-5c78-5494-9f77-4b413607be77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692431} :answer-field/id #uuid "1c136001-ac73-5067-ba1e-9c114ea5a2be" :answer-field/key "$1{y}^{′}+4{x}^{2}y+4x=-y+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692435} {:answer-field/choices [{:answer/id #uuid "e3d98ecd-7a89-5f82-978c-b0c35558c434" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692470} {:answer/id #uuid "f245aa1d-51d6-5973-8231-93c2df092d44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692471}] :answer-field/correct {:answer/id #uuid "f245aa1d-51d6-5973-8231-93c2df092d44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692471} :answer-field/id #uuid "bee8ff22-13aa-5393-951e-3d128171486d" :answer-field/key "$3{y}^{′}-4{x}^{2}y-{x}^{2}=2y-{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692462}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "05b690d4-3df2-52cd-9cf7-be2f1309ec27" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo classify the equations, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n3{y}^{′}+xy-{x}^{3}=-y-2{x}^{3}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $3$:\n\n$$\n\\begin{aligned}3{y}^{′}+xy-{x}^{3} & =-y-2{x}^{3} \\\\ 3{y}^{′}+xy+y-{x}^{3} & =-2{x}^{3} \\\\ 3{y}^{′}+(x+1)y & =-{x}^{3} \\\\ {y}^{′}+\\frac{x+1}{3}y & =\\frac{-{x}^{3}}{3}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{-{x}^{3}}{3}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n1{y}^{′}+4{x}^{2}y+4x=-y+x.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $1$:\n\n$$\n\\begin{aligned}1{y}^{′}+4{x}^{2}y+4x & =-y+x \\\\ 1{y}^{′}+4{x}^{2}y+y+4x & =x \\\\ 1{y}^{′}+(4{x}^{2}+1)y & =-3x \\\\ {y}^{′}+\\frac{4{x}^{2}+1}{1}y & =\\frac{-3x}{1}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{-3x}{1}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n3{y}^{′}-4{x}^{2}y-{x}^{2}=2y-{x}^{2}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $3$:\n\n$$\n\\begin{aligned}3{y}^{′}-4{x}^{2}y-{x}^{2} & =2y-{x}^{2} \\\\ 3{y}^{′}-4{x}^{2}y-2y-{x}^{2} & =-{x}^{2} \\\\ 3{y}^{′}+(-4{x}^{2}-2)y & =0 \\\\ {y}^{′}+\\frac{-4{x}^{2}-2}{3}y & =0.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=0$, which is identically zero. Therefore, this equation is homogeneous.\n\nSelect $3{y}^{′}-4{x}^{2}y-{x}^{2}=2y-{x}^{2}$."}] [{:db/id #edb/ref 17592186692432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a929a59a-132e-5a27-b796-07bd89846467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692458} {:answer/id #uuid "dbecc5bb-f6fa-5e30-918e-dfeaaf04ccfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692468}] :answer-field/correct {:answer/id #uuid "dbecc5bb-f6fa-5e30-918e-dfeaaf04ccfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692468} :answer-field/id #uuid "79e506ae-7915-561c-93b0-b0db9f3f9a82" :answer-field/key "$1{y}^{′}+2xy+{x}^{3}=-y-2{x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692447} {:answer-field/choices [{:answer/id #uuid "02a4d77d-11e7-5a1f-ae38-83223a0b452a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692427} {:answer/id #uuid "a7812136-6fa6-5df2-9dce-566d87000981" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692456}] :answer-field/correct {:answer/id #uuid "a7812136-6fa6-5df2-9dce-566d87000981" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692456} :answer-field/id #uuid "8689740d-ebec-567c-b70c-847aeebd6c24" :answer-field/key "$1{y}^{′}+xy+3x=-2y-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692451} {:answer-field/choices [{:answer/id #uuid "52939ef5-ca6d-5f08-94d5-12a759120aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692439} {:answer/id #uuid "b7325e9e-576b-5e42-8ed1-f56041d6c455" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692459}] :answer-field/correct {:answer/id #uuid "52939ef5-ca6d-5f08-94d5-12a759120aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692439} :answer-field/id #uuid "c3276d2b-f97d-5716-9420-1318065b2a27" :answer-field/key "$1{y}^{′}-3{x}^{2}y-x=-y+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692464}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "16c45614-69b9-5639-94eb-8578b9828409" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo classify the equations, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n1{y}^{′}+xy+3x=-2y-x.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $1$:\n\n$$\n\\begin{aligned}1{y}^{′}+xy+3x & =-2y-x \\\\ 1{y}^{′}+xy+2y+3x & =-x \\\\ 1{y}^{′}+(x+2)y & =-4x \\\\ {y}^{′}+\\frac{x+2}{1}y & =\\frac{-4x}{1}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{-4x}{1}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n1{y}^{′}+2xy+{x}^{3}=-y-2{x}^{3}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $1$:\n\n$$\n\\begin{aligned}1{y}^{′}+2xy+{x}^{3} & =-y-2{x}^{3} \\\\ 1{y}^{′}+2xy+y+{x}^{3} & =-2{x}^{3} \\\\ 1{y}^{′}+(2x+1)y & =-3{x}^{3} \\\\ {y}^{′}+\\frac{2x+1}{1}y & =\\frac{-3{x}^{3}}{1}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{-3{x}^{3}}{1}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n1{y}^{′}-3{x}^{2}y-x=-y+x.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $1$:\n\n$$\n\\begin{aligned}1{y}^{′}-3{x}^{2}y-x & =-y+x \\\\ 1{y}^{′}-3{x}^{2}y+y-x & =x \\\\ 1{y}^{′}+(-3{x}^{2}+1)y & =2x \\\\ {y}^{′}+\\frac{-3{x}^{2}+1}{1}y & =\\frac{2x}{1}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{2x}{1}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\nSelect $1{y}^{′}+xy+3x=-2y-x$; $1{y}^{′}+2xy+{x}^{3}=-y-2{x}^{3}$; $1{y}^{′}-3{x}^{2}y-x=-y+x$."}] [{:db/id #edb/ref 17592186692446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9236b06-5e34-59ac-a7f6-98923f5e6146" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692460} {:answer/id #uuid "c4142dd4-becd-527a-afc6-c0c1fe74b157" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692465}] :answer-field/correct {:answer/id #uuid "b9236b06-5e34-59ac-a7f6-98923f5e6146" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692460} :answer-field/id #uuid "613cbea8-84ae-5515-9fca-2fd18ffbb231" :answer-field/key "$1{y}^{′}-{x}^{2}y+2{x}^{3}=y+2{x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692442} {:answer-field/choices [{:answer/id #uuid "6d3b570a-5ec0-57f8-9ebd-c45dc925282c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692444} {:answer/id #uuid "f93fdf75-55e6-5acb-b9a1-ebba80a83b17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692475}] :answer-field/correct {:answer/id #uuid "6d3b570a-5ec0-57f8-9ebd-c45dc925282c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692444} :answer-field/id #uuid "c4b0b1e5-10fc-5921-b826-3fc412243b05" :answer-field/key "$2{y}^{′}+1y-4x=2y-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692466} {:answer-field/choices [{:answer/id #uuid "8f56243c-1603-5d1d-9cf8-efbf192ac090" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692453} {:answer/id #uuid "d60dbd3d-294b-5c28-937e-c8d66f7f3134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692467}] :answer-field/correct {:answer/id #uuid "d60dbd3d-294b-5c28-937e-c8d66f7f3134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692467} :answer-field/id #uuid "f98a0cb1-8ce7-5e4a-94f1-6793fa024d5c" :answer-field/key "$1{y}^{′}+2xy-{x}^{2}=4y-{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692476}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "728e0cd5-14a2-5fb0-b499-e41865a3c569" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo classify the equations, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n1{y}^{′}-{x}^{2}y+2{x}^{3}=y+2{x}^{3}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $1$:\n\n$$\n\\begin{aligned}1{y}^{′}-{x}^{2}y+2{x}^{3} & =y+2{x}^{3} \\\\ 1{y}^{′}-{x}^{2}y-y+2{x}^{3} & =2{x}^{3} \\\\ 1{y}^{′}+(-{x}^{2}-1)y & =0 \\\\ {y}^{′}+\\frac{-{x}^{2}-1}{1}y & =0.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=0$, which is identically zero. Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n1{y}^{′}+2xy-{x}^{2}=4y-{x}^{2}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $1$:\n\n$$\n\\begin{aligned}1{y}^{′}+2xy-{x}^{2} & =4y-{x}^{2} \\\\ 1{y}^{′}+2xy-4y-{x}^{2} & =-{x}^{2} \\\\ 1{y}^{′}+(2x-4)y & =0 \\\\ {y}^{′}+\\frac{2x-4}{1}y & =0.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=0$, which is identically zero. Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n2{y}^{′}+1y-4x=2y-x.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $2$:\n\n$$\n\\begin{aligned}2{y}^{′}+1y-4x & =2y-x \\\\ 2{y}^{′}+1y-2y-4x & =-x \\\\ 2{y}^{′}+(1-2)y & =3x \\\\ {y}^{′}+\\frac{1-2}{2}y & =\\frac{3x}{2}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{3x}{2}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\nSelect $2{y}^{′}+1y-4x=2y-x$."}] [{:db/id #edb/ref 17592186692461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2848b66e-6214-526c-ae1d-cd5488ad2ef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692436} {:answer/id #uuid "a80ed162-8355-5fe3-bfcd-5ac23d31e2b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692457}] :answer-field/correct {:answer/id #uuid "a80ed162-8355-5fe3-bfcd-5ac23d31e2b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692457} :answer-field/id #uuid "5386a0f8-0fd7-558c-8441-1867486bfe5a" :answer-field/key "$3{y}^{′}+2xy-2x=4y+3x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692440} {:answer-field/choices [{:answer/id #uuid "45ada541-3a7f-59b4-aa24-92363b1ed3bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692438} {:answer/id #uuid "7a034263-9a81-55ad-a910-ebe824bcc829" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692448}] :answer-field/correct {:answer/id #uuid "7a034263-9a81-55ad-a910-ebe824bcc829" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692448} :answer-field/id #uuid "700d0281-059c-5fad-863c-301f99c58cff" :answer-field/key "$3{y}^{′}+xy-{x}^{2}=3y-4{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692445} {:answer-field/choices [{:answer/id #uuid "1a577d61-1a88-5d74-816b-d368e47fef7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692434} {:answer/id #uuid "7eacc63e-f381-544a-b2c7-fe4d09b71b02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692449}] :answer-field/correct {:answer/id #uuid "1a577d61-1a88-5d74-816b-d368e47fef7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692434} :answer-field/id #uuid "e0a464cc-a03c-562f-aec9-5ad909d7c60a" :answer-field/key "$2{y}^{′}+1y+{x}^{2}=4y+{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692469}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "be5dd3ef-58f6-5db9-8f3e-032628b35094" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo classify the equations, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n2{y}^{′}+1y+{x}^{2}=4y+{x}^{2}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $2$:\n\n$$\n\\begin{aligned}2{y}^{′}+1y+{x}^{2} & =4y+{x}^{2} \\\\ 2{y}^{′}+1y-4y+{x}^{2} & ={x}^{2} \\\\ 2{y}^{′}+(1-4)y & =0 \\\\ {y}^{′}+\\frac{1-4}{2}y & =0.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=0$, which is identically zero. Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n3{y}^{′}+xy-{x}^{2}=3y-4{x}^{2}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $3$:\n\n$$\n\\begin{aligned}3{y}^{′}+xy-{x}^{2} & =3y-4{x}^{2} \\\\ 3{y}^{′}+xy-3y-{x}^{2} & =-4{x}^{2} \\\\ 3{y}^{′}+(x-3)y & =-3{x}^{2} \\\\ {y}^{′}+\\frac{x-3}{3}y & =\\frac{-3{x}^{2}}{3}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{-3{x}^{2}}{3}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n3{y}^{′}+2xy-2x=4y+3x.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $3$:\n\n$$\n\\begin{aligned}3{y}^{′}+2xy-2x & =4y+3x \\\\ 3{y}^{′}+2xy-4y-2x & =3x \\\\ 3{y}^{′}+(2x-4)y & =5x \\\\ {y}^{′}+\\frac{2x-4}{3}y & =\\frac{5x}{3}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{5x}{3}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\nSelect $2{y}^{′}+1y+{x}^{2}=4y+{x}^{2}$."}] [{:db/id #edb/ref 17592186692473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122ab25d-7107-5cb6-8ae3-d0bfce2e9a89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692429} {:answer/id #uuid "6952ceb8-9a05-5fbd-a9b3-bee5c9a3f9fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692443}] :answer-field/correct {:answer/id #uuid "122ab25d-7107-5cb6-8ae3-d0bfce2e9a89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692429} :answer-field/id #uuid "30232c84-8649-5344-8fd3-48c5be529765" :answer-field/key "$3{y}^{′}+xy+x=2y+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692437} {:answer-field/choices [{:answer/id #uuid "8bf09f9c-3f5f-5512-8cbc-6b390316bdf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692452} {:answer/id #uuid "f6b7eab2-6b93-5ff5-ae57-53a5f98bc272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692474}] :answer-field/correct {:answer/id #uuid "f6b7eab2-6b93-5ff5-ae57-53a5f98bc272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692474} :answer-field/id #uuid "a387d2f1-c0cf-5871-9bca-5a3c0119c521" :answer-field/key "$3{y}^{′}-3xy+{x}^{3}=2y+{x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692455} {:answer-field/choices [{:answer/id #uuid "80e1b726-56f2-5492-834b-971fcfec2194" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186692450} {:answer/id #uuid "93425768-c77a-5953-803e-4850818ab4e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692454}] :answer-field/correct {:answer/id #uuid "93425768-c77a-5953-803e-4850818ab4e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186692454} :answer-field/id #uuid "bfe55b74-a95b-5b95-bba0-6f237c64d3dc" :answer-field/key "$2{y}^{′}+3{x}^{2}y+x=3y+2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186692463}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f4463981-e549-5cc4-9051-b784d2dfd412" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo classify the equations, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n3{y}^{′}-3xy+{x}^{3}=2y+{x}^{3}.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $3$:\n\n$$\n\\begin{aligned}3{y}^{′}-3xy+{x}^{3} & =2y+{x}^{3} \\\\ 3{y}^{′}-3xy-2y+{x}^{3} & ={x}^{3} \\\\ 3{y}^{′}+(-3x-2)y & =0 \\\\ {y}^{′}+\\frac{-3x-2}{3}y & =0.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=0$, which is identically zero. Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n2{y}^{′}+3{x}^{2}y+x=3y+2x.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $2$:\n\n$$\n\\begin{aligned}2{y}^{′}+3{x}^{2}y+x & =3y+2x \\\\ 2{y}^{′}+3{x}^{2}y-3y+x & =2x \\\\ 2{y}^{′}+(3{x}^{2}-3)y & =x \\\\ {y}^{′}+\\frac{3{x}^{2}-3}{2}y & =\\frac{x}{2}.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=\\frac{x}{2}$, which is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n3{y}^{′}+xy+x=2y+x.\n$$\n\nWe collect the $y$-terms on the left side and the terms involving only $x$ on the right side, then divide through by $3$:\n\n$$\n\\begin{aligned}3{y}^{′}+xy+x & =2y+x \\\\ 3{y}^{′}+xy-2y+x & =x \\\\ 3{y}^{′}+(x-2)y & =0 \\\\ {y}^{′}+\\frac{x-2}{3}y & =0.\\end{aligned}\n$$\n\nThe forcing function is $Q(x)=0$, which is identically zero. Therefore, this equation is homogeneous.\n\nSelect $3{y}^{′}-3xy+{x}^{3}=2y+{x}^{3}$; $3{y}^{′}+xy+x=2y+x$."}] [{:db/id #edb/ref 17592186693209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42daa9ff-365b-5fb6-9e1b-e9b882191586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (x - 6)}{2 x}=\\frac{7 x + 4}{2 x}" :db/id #edb/ref 17592186693211} {:answer/id #uuid "ae702991-6506-5389-bf65-0726fe5260c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (5 x - 8)}{2 x}=\\frac{7 x + 4}{2 x}" :db/id #edb/ref 17592186693223} {:answer/id #uuid "c29e1381-ef02-5bac-9284-e067106dae0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (7 x - 5)}{2 x}=\\frac{7 x + 4}{2 x}" :db/id #edb/ref 17592186693225} {:answer/id #uuid "c4207c0f-6712-53d2-bb92-a13ee76a26d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (8 x - 4)}{2 x}=\\frac{7 x + 4}{2 x}" :db/id #edb/ref 17592186693226} {:answer/id #uuid "e019b9c1-21dc-5054-b910-d22a4e4406d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (6 x - 3)}{2 x}=\\frac{7 x + 4}{2 x}" :db/id #edb/ref 17592186693229}] :answer-field/correct {:answer/id #uuid "c29e1381-ef02-5bac-9284-e067106dae0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (7 x - 5)}{2 x}=\\frac{7 x + 4}{2 x}" :db/id #edb/ref 17592186693225} :answer-field/id #uuid "8d55341d-36fe-5acf-a8c4-7daea7154284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693217}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3abd5222-d563-5c17-a02d-6135bece3aeb" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n2 x\\frac{\\text{d}y}{\\text{d}x}+7 x y-7 x=4+5 y\\,.\n$$\n\nAssume $x\\ne 0$." :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}&2 x\\frac{\\text{d}y}{\\text{d}x}+7 x y-7 x=4+5 y \\\\ &2 x\\frac{\\text{d}y}{\\text{d}x}+(7 x-5)y=4+7 x \\\\ &\\frac{\\text{d}y}{\\text{d}x}+\\underbrace{\\left(\\frac{7 x - 5}{2 x}\\right)}_{P(x)}y=\\underbrace{\\frac{7 x + 4}{2 x}}_{Q(x)}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=\\frac{7 x - 5}{2 x}$ and $Q(x)=\\frac{7 x + 4}{2 x}.$"}] [{:db/id #edb/ref 17592186693213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "685bc6f9-da37-51c1-a549-06c2f45b3ee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (5 x - 6)}{3 x}=\\frac{x + 3}{3 x}" :db/id #edb/ref 17592186693214} {:answer/id #uuid "8d94cb5a-bfc2-5114-9081-eafc4ab69283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (4 x - 8)}{3 x}=\\frac{x + 3}{3 x}" :db/id #edb/ref 17592186693218} {:answer/id #uuid "9df6962a-e9d4-51fb-a5d8-d6169fcd7fc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (x - 3)}{3 x}=\\frac{x + 3}{3 x}" :db/id #edb/ref 17592186693222} {:answer/id #uuid "e8625933-0c2a-54f8-b618-ba0af04a84ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (6 x - 2)}{3 x}=\\frac{x + 3}{3 x}" :db/id #edb/ref 17592186693230} {:answer/id #uuid "fe50e298-31dc-5455-a6d1-82adabb62eae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y (3 x - 7)}{3 x}=\\frac{x + 3}{3 x}" :db/id #edb/ref 17592186693233}] :answer-field/correct {:answer/id #uuid "8d94cb5a-bfc2-5114-9081-eafc4ab69283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident